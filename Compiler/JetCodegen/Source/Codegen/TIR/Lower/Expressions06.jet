// Private fragments of the canonical Expressions.lower_expr_inner dispatch.
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:7367
fn lower_expr_inner_field(receiver: Expr, member: String, span: Span, cx: Cx, env: &LowerEnv) -> TExpr {
    in_own_frame(fn() -> TExpr {
        if cx.checked_const_ref_sites.get((span.start, span.end)) == Val((key, ty)) -> {
            return TExpr{ty: ~ty, kind: TExprKind.ConstRef(~key)}
        }
        if core_module_path_from_receiver(receiver, cx, env) == Val("core.math") -> {
            value :: if member == {
                "pi" -> Val(Float.PI)
                "e" -> Val(Float.E)
                "tau" -> Val(Float.TAU)
                "infinity" -> Val(Float.INFINITY)
                "nan" -> Val(Float.NAN)
                else -> None
            }
            if value == Val(v) -> return TExpr{ty: Type.Float, kind: TExprKind.FloatLit(v)}
        }
        // A derive's local type fact and reflected list-index carriers use the same projection.
        compiler_fact_receiver :: if receiver == {
            .Ident(name, _) -> name.chars().next().is_some_and(fn(c) { c.is_uppercase() }) || env.ty_of(name).is_some_and(fn(ty) {
                if ty == .Named(n) -> ["FieldInfo", "MethodInfo", "TypeParamInfo"].contains(n) else -> false
            })
            .Field(_, name, _) -> name.chars().next().is_some_and(fn(c) { c.is_uppercase() })
            else -> false
        }
        fact_member :: Syntax.compiler_fact_member(member).is_some() || Registry.fact_read(member).is_some()
        reflected_fact_receiver :: declared_field_ty(receiver, cx, env).is_some_and(fn(ty) {
            if ty.without_user_tags() == .Named(n) -> ["TypeInfo", "FunctionInfo", "MethodInfo", "FieldInfo", "TypeParamInfo", "FactInfo", "FactValue"].contains(n) else -> false
        })
        if fact_member && (compiler_fact_receiver || reflected_fact_receiver) -> {
            return in_own_frame(fn() -> TExpr {
                recv :: lower_expr(receiver, cx, env)
                TExpr{ty: compiler_fact_type(member), kind: TExprKind.Field{recv: ^recv, field: ~member, boxed: false}}
            })
        }
        if grouped_enum_unit_variant(cx, receiver, member, fn(name) { env.ty_of(name).is_some() }) == Val((enum_type, variant)) -> {
            return in_own_frame(fn() -> TExpr {
                TExpr{ty: Type.Named(~enum_type), kind: TExprKind.EnumLit{enum_type: ^enum_type, variant: ^variant, payload: TEnumPayload.Unit}}
            })
        }
        if receiver == .Ident(enum_name, _) -> {
            resolved_enum :: cx.core_qualified_rust_type_name(enum_name) ?? enum_name
            if env.ty_of(enum_name).is_none() && ["Overflow", "FailurePolicy", "DispatchState", "HookPolicy", "HookDecision", "HookOutcome"].contains(enum_name) -> {
                return in_own_frame(fn() -> TExpr {
                    ty :: if env.ret_ty == {
                        Val(.Apply(name, args)) if name == enum_name -> Type.Apply(~name, ~args)
                        else -> Type.Named(~enum_name)
                    }
                    TExpr{ty: ^ty, kind: TExprKind.EnumLit{enum_type: ~enum_name, variant: ~member, payload: TEnumPayload.Unit}}
                })
            }
            if env.ty_of(enum_name).is_none() && enum_name == "DataEvent" && ["Null", "ArrayStart", "ArrayEnd", "ObjectStart", "ObjectEnd"].contains(member) -> {
                return in_own_frame(fn() -> TExpr {
                    TExpr{ty: Type.Named("DataEvent"), kind: TExprKind.EnumLit{enum_type: "DataEvent", variant: ~member, payload: TEnumPayload.Unit}}
                })
            }
            if enum_name == Syntax.TYPE_REMOVE_BY && ["Val", "Slot"].contains(member) -> {
                return in_own_frame(fn() -> TExpr {
                    TExpr{ty: Type.Named(Syntax.TYPE_REMOVE_BY), kind: TExprKind.EnumLit{enum_type: Syntax.TYPE_REMOVE_BY, variant: ~member, payload: TEnumPayload.Unit}}
                })
            }
            if enum_name == "EncodingErrorKind" && ["Syntax", "Truncated", "Unsupported", "Limit", "IO", "State"].contains(member) -> {
                return in_own_frame(fn() -> TExpr {
                    TExpr{ty: Type.Named(~enum_name), kind: TExprKind.EnumLit{enum_type: ~enum_name, variant: ~member, payload: TEnumPayload.Unit}}
                })
            }
            if enum_name == "EncodingFormat" && ["JSON", "JSONL", "CSV", "TOML", "YAML", "XML", "CBOR"].contains(member) -> {
                return in_own_frame(fn() -> TExpr {
                    TExpr{ty: Type.Named(~enum_name), kind: TExprKind.EnumLit{enum_type: ~enum_name, variant: ~member, payload: TEnumPayload.Unit}}
                })
            }
            if env.ty_of(enum_name).is_none() && ["SMTPSecurity", "RecipientPolicy", "SMTPAuth", "TLSTrust"].contains(resolved_enum) &&
                ((resolved_enum == "SMTPSecurity" && ["StartTLS", "TLS"].contains(member)) ||
                 (resolved_enum == "RecipientPolicy" && ["RequireAll", "DeliverAccepted"].contains(member)) ||
                 (resolved_enum == "SMTPAuth" && member == "None") || (resolved_enum == "TLSTrust" && member == "System")) -> {
                return in_own_frame(fn() -> TExpr {
                    TExpr{ty: Type.Named(~resolved_enum), kind: TExprKind.EnumLit{enum_type: ~resolved_enum, variant: ~member, payload: TEnumPayload.Unit}}
                })
            }
            if env.ty_of(enum_name).is_none() &&
                ((resolved_enum == "NetReadyInterest" && ["Read", "Write", "ReadWrite"].contains(member)) ||
                 (resolved_enum == "NetShutdown" && ["Read", "Write", "Both"].contains(member))) -> {
                return in_own_frame(fn() -> TExpr {
                    TExpr{ty: Type.Named(~resolved_enum), kind: TExprKind.EnumLit{enum_type: ~resolved_enum, variant: ~member, payload: TEnumPayload.Unit}}
                })
            }
            if env.ty_of(enum_name).is_none() && cx.variant_owner.get(member) == Val(enum_name) -> {
                return in_own_frame(fn() -> TExpr {
                    TExpr{ty: Type.Named(~enum_name), kind: TExprKind.EnumLit{enum_type: ~enum_name, variant: ~member, payload: TEnumPayload.Unit}}
                })
            }
            if env.ty_of(enum_name).is_none() -> {
                if cx.variant_owner.get(member).filter(fn(owner) { owner.rsplit("::").next() == Val(enum_name) }) == Val(owner) -> {
                    return in_own_frame(fn() -> TExpr {
                        TExpr{ty: Type.Named(~owner), kind: TExprKind.EnumLit{enum_type: ~owner, variant: ~member, payload: TEnumPayload.Unit}}
                    })
                }
            }
            if env.ty_of(enum_name).is_none() && is_json_type_name(enum_name) && member == "Null" -> {
                return in_own_frame(fn() -> TExpr {
                    TExpr{ty: Type.Named(Syntax.TYPE_DATA), kind: TExprKind.JSONLit{variant: "Null", arg: None}}
                })
            }
            if env.ty_of(enum_name).is_none() && is_db_value_type_name(enum_name) && member == "Null" -> {
                return in_own_frame(fn() -> TExpr {
                    TExpr{ty: Type.Named(Syntax.TYPE_DB_VALUE), kind: TExprKind.DBValueLit{variant: "Null", arg: None}}
                })
            }
            if env.ty_of(enum_name).is_none() -> {
                if numeric_type_from_name(enum_name) == Val(nt) && is_numeric_bounds_const(member) -> {
                    return in_own_frame(fn() -> TExpr {
                        TExpr{ty: ~nt, kind: TExprKind.HostCall(THostCall.NumericBounds{ty: ~nt, member: ~member})}
                    })
                }
            }
            if env.ty_of(enum_name).is_none() && enum_name.chars().next().is_some_and(fn(c) { c.is_uppercase() }) && member.chars().next().is_some_and(fn(c) { c.is_uppercase() }) -> {
                return in_own_frame(fn() -> TExpr {
                    TExpr{ty: Type.Named(~resolved_enum), kind: TExprKind.EnumLit{enum_type: ~resolved_enum, variant: ~member, payload: TEnumPayload.Unit}}
                })
            }
        }
        // A fused column read never gathers the whole struct; computed fields fall through.
        if receiver == .Index(base, index, index_span, kind) && kind == IndexKind.List -> {
            base_t :: lower_expr(base, cx, env)
            if base_t.ty == .List(elem) && cx.columnar_list_type(elem).is_some() -> {
                if elem == .Named(elem_name) -> {
                    if cx.columnar_column_index(elem_name, member) == Val(column) -> {
                        if struct_field_type(cx, elem, member) == Val(field_ty) -> {
                            index_t :: lower_expr(index, cx, env)
                            line :: cx.src_line_col(index_span.start).0
                            return TExpr{ty: ^field_ty, kind: TExprKind.ColumnarColumnRead{owner: ~elem_name, base: ^base_t, index: ^index_t, field: ~member, column: column, line: line}}
                        }
                    }
                }
            }
        }
        recv := lower_expr(receiver, cx, env)
        if recv.ty == .Result(ok, _) && struct_field_type(cx, ok, member).is_some() -> {
            (line, column) :: cx.src_line_col(span.start)
            recv = TExpr{ty: ~ok, kind: TExprKind.Try{inner: ^recv, note: None, convert: TTryConvert.None, file: escape_rust_str(cx.file), line: line, column: column, fn_name: escape_rust_str(env.fn_name)}}
        }
        if shared_guard_value_field(~recv, member) == Val(guard_value) -> return in_own_frame(fn() -> TExpr { ^guard_value })
        if member == "path" && cx.core_imports.values().any(fn(module) { module == "core.files" }) -> {
            if recv.ty == .Named(type_name) -> {
                op :: if cx.local_type_names.contains(type_name) -> None else -> {
                    if core_file_handle_dispatch_name(type_name) == {
                        Val("FileReader") -> Val(THandleOp.FileReaderPath)
                        Val("FileWriter") -> Val(THandleOp.FileWriterPath)
                        else -> None
                    }
                }
                if op == Val(handle_op) -> return TExpr{ty: Type.String, kind: TExprKind.HandleMethod{recv: ^recv, op: handle_op, args: []}}
            }
        }
        field_owner :: if receiver == .Ident(n, _) && n == Syntax.KW_SELF -> env.self_owner else -> {
            if recv.ty == .Named(type_name) -> Val(type_name) else -> None
        }
        if field_owner == Val(type_name) && cx.computed_fields.get(type_name).is_some_and(fn(c) { c.contains(member) }) -> {
            field_ty :: struct_field_type(cx, Type.Named(type_name), member) ?? Type.Int
            call :: TExpr{ty: Type.Result(~field_ty, Type.Named(Syntax.TYPE_ERR)), kind: TExprKind.MethodCall{recv: ^recv, method: TMethodRef.inherent(member), type_args: [], args: [], source_first_string_literal: None, operator_line: None}}
            (line, column) :: cx.src_line_col(span.start)
            convert :: if env.raw_protocol_return -> TTryConvert.ProtocolExit else -> TTryConvert.None
            return TExpr{ty: ^field_ty, kind: TExprKind.Try{inner: ^call, note: None, convert: convert, file: escape_rust_str(cx.file), line: line, column: column, fn_name: escape_rust_str(env.fn_name)}}
        }
        if recv.ty == .Named(type_name) && is_swizzleable_math_type(type_name) && !cx.struct_fields.contains_key(type_name) -> {
            if parse_swizzle_member(member, type_name) == SwizzleParse.Ok(lanes) -> {
                lanes_u8 :: lanes.map(fn(i) { i as U8 })
                return TExpr{ty: swizzle_read_type(type_name, lanes.len()), kind: TExprKind.MathSwizzleRead{type_name: ~type_name, recv: ^recv, lanes: ^lanes_u8}}
            }
        }
        // Int is only the original impossible-shape last resort, not a checked field default.
        field_ty :: struct_field_type(cx, recv.ty, member) ?? Type.Int
        // GATE #4499: composite boxed-edge keys retain canonical equality/hash.
        boxed :: if recv.ty == .Named(n) -> cx.boxed_edges.contains((n, member)) else -> false
        TExpr{ty: ^field_ty, kind: TExprKind.Field{recv: ^recv, field: ~member, boxed: boxed}}
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:7946
fn lower_expr_inner_enum_lit(type_name: String, variant: String, args: [EnumLitArg], leading_dot: Bool, span: Span, cx: Cx, env: &LowerEnv) -> TExpr {
    // Preserve the early Option shape and payload identity in the worklist cache.
    if type_name.is_empty() && variant == Syntax.LIT_VALUE && args == [.Positional(inner)] -> return in_own_frame(fn() -> TExpr { lower_present(inner, cx, env) })
    if type_name.is_empty() && variant == Syntax.LIT_NULL && args.is_empty() -> return lower_expr(Expr.Absent(span), cx, env)
    contextual_type := None
    selected_type := type_name
    if leading_dot && type_name.is_empty() -> {
        if in_own_frame(fn() { lower_raw_contextual_result_variant(variant, args, span, cx, env) }) == Val(lowered) -> return ^lowered
        contextual_type = raw_contextual_return_enum(variant, cx, env)
        selected_type = contextual_type ?? type_name
    }
    in_own_frame(fn() -> TExpr {
        resolved_type :: cx.local_type_identities.get(selected_type) ?? cx.core_qualified_rust_type_name(selected_type) ?? selected_type
        payload :: in_own_frame(fn() -> TEnumPayload {
            if args.is_empty() -> TEnumPayload.Unit
            else if args.all(fn(a) { if a == .Positional(_) -> true else -> false }) -> {
                pos := []
                loop a in args -> {
                    if a == .Positional(e) -> &pos.push(lower_enum_arg(resolved_type, variant, variant, e, cx, env))
                    else -> panic("all positional in this branch")
                }
                TEnumPayload.Positional(^pos)
            } else -> {
                named := []
                loop a in args -> {
                    if a == {
                        .Named{label, expr} -> {
                            edge :: "{variant}.{label}"
                            &named.push((~label, lower_enum_arg(resolved_type, variant, edge, expr, cx, env)))
                        }
                        .Positional(e) -> &named.push(("", lower_enum_arg(resolved_type, variant, variant, e, cx, env)))
                    }
                }
                TEnumPayload.Named(^named)
            }
        })
        ty :: if env.ret_ty == {
            Val(.Apply(name, type_args)) if name == selected_type || name == resolved_type -> Type.Apply(~name, ~type_args)
            else -> Type.Named(~resolved_type)
        }
        TExpr{ty: ^ty, kind: TExprKind.EnumLit{enum_type: ~resolved_type, variant: ~variant, payload: ^payload}}
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:8058
// Expr.ListLit routes directly to canonical lower_list_lit; there is no additional arm body.

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:8065
fn lower_expr_inner_tuple_lit(lit_fields: [(String, Expr)], ty: Type?, cx: Cx, env: &LowerEnv) -> TExpr {
    in_own_frame(fn() -> TExpr {
        canonical :: if ty == Val(.Tuple(fs)) -> tuple_fields_plain(fs) else -> []
        struct_name :: tuple_struct_name(canonical)
        value_of := [String:Expr]{}
        loop (n, e) in lit_fields -> &value_of.insert(n, e)
        fields := [(String, TExpr)]{}
        loop (n, fty) in canonical -> {
            v :: if value_of.get(n) == Val(e) -> lower_expr(e, cx, env) else -> TExpr{ty: ~fty, kind: TExprKind.IntLit(0, None)}
            &fields.push((~n, ^v))
        }
        TExpr{ty: ty ?? Type.Tuple([]), kind: TExprKind.TupleLit{struct_name: ^struct_name, fields: ^fields}}
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:8106
fn lower_expr_inner_map_lit(entries: [(Expr, Expr)], cx: Cx, env: &LowerEnv) -> TExpr {
    in_own_frame(fn() -> TExpr {
        tentries := [(TExpr, TExpr)]{}
        loop (k, v) in entries -> &tentries.push((lower_expr(k, cx, env), lower_expr(v, cx, env)))
        (kt, vt) :: if tentries.first() == Val((k, v)) -> (~k.ty, ~v.ty) else -> (Type.String, Type.Int)
        TExpr{ty: Type.Map{key: ^kt, key_span: None, value: ^vt}, kind: TExprKind.MapLit(^tentries)}
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:8130
fn lower_expr_inner_index(base: Expr, index: Expr, span: Span, kind: IndexKind, cx: Cx, env: &LowerEnv) -> TExpr {
    in_own_frame(fn() -> TExpr {
        base_t :: lower_expr(base, cx, env)
        index_t :: lower_expr(index, cx, env)
        inferred_kind :: if kind == IndexKind.Unknown -> resolve_unknown_index_kind(base_t, index_t, index, cx) else -> None
        selected_kind :: inferred_kind ?? kind
        if selected_kind == IndexKind.Unknown -> {
            message :: "sema-to-TIR handoff violated: unresolved index kind; file={cx.file}; function={cx.current_fn.borrow()}; span={span.start}..{span.end}; base={base_t.ty:?}; index={index_t.ty:?}"
            debug_assert(false, message)
            return invariant_violation_expr(span, message)
        }
        if selected_kind == .LayoutField(field_name) -> {
            layout_field_ty :: Type.Named(Syntax.TYPE_LAYOUT_FIELD)
            line :: cx.src_line_col(span.start).0
            fields :: TExpr{ty: Type.List(~layout_field_ty), kind: TExprKind.Field{recv: ~base_t, field: "fields", boxed: false}}
            field_param :: TExpr{ty: ~layout_field_ty, kind: TExprKind.Local(TLocal.user("layout_field").through_ref())}
            predicate_body :: TExpr{ty: Type.Bool, kind: TExprKind.Binary{op: BinOp.Eq, overflow: false, line: line as U32,
                lhs: TExpr{ty: Type.String, kind: TExprKind.Field{recv: ^field_param, field: "name", boxed: false}},
                rhs: TExpr{ty: Type.String, kind: TExprKind.StrLit([TStrPart.Lit(~field_name)])}}}
            callback :: TExpr{ty: Type.Fn{params: [~layout_field_ty], ret: Val(Type.Bool), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None},
                kind: TExprKind.Lambda(TLambda{source_params: ["layout_field"], param_types: [~layout_field_ty], ret: Val(Type.Bool),
                    failure_carrier: TFailureCarrier.Infallible, executable: TLambdaBody.Expr(^predicate_body), source_span: span,
                    frame_schedule: None, frame_schedule_derivation: None, capture_facts: TCaptureFacts.default(), host_param_conventions: None,
                    effects: TEffectFacts.default(), jit_name: "", is_move: true, boxed: false, rc: false, arc: false, captures: [],
                    capture_origins: [:], materialized_captures: [], frozen_captures: [], uses_stack_sentry: false})}
            found :: TExpr{ty: Type.Option(~layout_field_ty), kind: TExprKind.ClosureMethod{recv: ^fields, op: TClosureOp.Find, args: [^callback]}}
            return TExpr{ty: ^layout_field_ty, kind: TExprKind.HostCall(THostCall.OptionProbe{inner: ^found, kind: TOptionProbe.Unwrap})}
        }
        base_ty :: base_t.ty.without_user_tags()
        line :: cx.src_line_col(span.start).0
        if selected_kind == IndexKind.Range -> return in_own_frame(fn() -> TExpr {
            zero :: fn() -> TExpr { TExpr{ty: Type.Int, kind: TExprKind.IntLit(0, None)} }
            TExpr{ty: ~base_t.ty, kind: TExprKind.Slice{base: ^base_t, start: zero(), end: zero(), range: Val(^index_t), line: line}}
        })
        if selected_kind == .Lane(lane_ty) -> return in_own_frame(fn() -> TExpr {
            TExpr{ty: math_scalar_ty(lane_ty), kind: TExprKind.MathLaneIndex{lane_ty: ~lane_ty, base: ^base_t, index: ^index_t, line: line as U32}}
        })
        if selected_kind == .User(type_name) -> return in_own_frame(fn() -> TExpr {
            value_ty :: cx.index_hooks.get(type_name).map(fn(h) { ~h.value_type }) ?? Type.Int
            TExpr{ty: ^value_ty, kind: TExprKind.IndexHook{type_name: ~type_name, base: ^base_t, index: ^index_t, line: line}}
        })
        if selected_kind == IndexKind.Pool -> {
            elem_ty :: if base_ty == .Apply(name, args) && name == "Pool" && !args.is_empty() -> ~args[0] else -> Type.Int
            src_line :: cx.src_line_text(line).to_string()
            return TExpr{ty: ^elem_ty, kind: TExprKind.PoolSlot{pool: ^base_t, id: ^index_t, mutable: false, field: None, line: line, src_line: ^src_line}}
        }
        if selected_kind == IndexKind.FixedListProof -> {
            elem_ty :: if base_ty == .FixedList{elem, ..} -> ~elem else -> Type.Int
            return TExpr{ty: ^elem_ty, kind: TExprKind.HostCall(THostCall.FixedListIndex{base: ^base_t, index: ^index_t, line: line as U32})}
        }
        result_ty :: if base_ty == {
            .List(elem) | .Map{value: elem, ..} | .FixedList{elem, ..} -> ~elem
            .Apply(name, args) if ["View", "ViewMut", "ComputeViewMut"].contains(name) && args.len() == 1 -> ~args[0]
            else -> Type.Int
        }
        if base_ty == .List(elem) && cx.columnar_list_type(elem).is_some() -> return in_own_frame(fn() -> TExpr {
            TExpr{ty: ^result_ty, kind: TExprKind.ColumnarGather{base: ^base_t, index: ^index_t, line: line}}
        })
        uninit_fixed :: if base == .Ident(name, _) -> env.is_uninit_fixed(name) else -> false
        TExpr{ty: ^result_ty, kind: TExprKind.Index{base: ^base_t, index: ^index_t, is_map: selected_kind == IndexKind.Map, uninit_fixed: uninit_fixed, line: line}}
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:8387
fn lower_expr_inner_slice(base: Expr, start: Expr, end: Expr, range: Expr?, span: Span, cx: Cx, env: &LowerEnv) -> TExpr {
    in_own_frame(fn() -> TExpr {
        base_t :: lower_expr(base, cx, env)
        start_t :: lower_expr(start, cx, env)
        end_t :: lower_expr(end, cx, env)
        range_t :: range.map(fn(r) { lower_expr(r, cx, env) })
        result_ty :: ~base_t.ty
        line :: cx.src_line_col(span.start).0
        TExpr{ty: ^result_ty, kind: TExprKind.Slice{base: ^base_t, start: ^start_t, end: ^end_t, range: ^range_t, line: line}}
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:8416
// Expr.Tainted(inner, _, _) routes to lower_expr(inner, cx, env); value-fact tags erase.
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:8417
// Expr.Present(inner, _) routes to in_own_frame(fn() { lower_present(inner, cx, env) }).
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:8421
