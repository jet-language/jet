// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:8445
fn lower_expr_inner_ok(inner: Expr, cx: Cx, env: &LowerEnv) -> TExpr {
    in_own_frame(fn() -> TExpr {
        t := lower_owned_expr(inner, cx, env)
        if env.ret_ty == Val(t.ty) -> return ^t
        if env.ret_ty == Val(.Result(ok, _)) -> {
            if t.kind == TExprKind.Absent && ok == .Option(_) -> t.ty = ~ok
            t = preserve_typed_list_shape(^t, ok, cx)
            t = maybe_widen_expr_to_union(^t, ok)
        }
        err_ty :: if env.ret_ty == Val(.Result(_, err)) -> ~err else -> Type.Named(Syntax.TYPE_ERR)
        TExpr{ty: Type.Result(~t.ty, ^err_ty), kind: TExprKind.Ok(^t)}
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:8478
fn lower_expr_inner_err(inner: Expr, cx: Cx, env: &LowerEnv) -> TExpr {
    in_own_frame(fn() -> TExpr {
        t := lower_owned_expr(inner, cx, env)
        ok_ty :: if env.ret_ty == Val(.Result(ok, _)) -> ~ok else -> Type.Int
        if env.ret_ty == Val(.Result(_, err)) -> {
            t = preserve_typed_list_shape(^t, err, cx)
            t = maybe_widen_expr_to_union(^t, err)
        }
        TExpr{ty: Type.Result(^ok_ty, ~t.ty), kind: TExprKind.Err(^t, None)}
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:8500
fn lower_expr_inner_try(inner: Expr, span: Span, convert: TryConvert, note: Expr?, cx: Cx, env: &LowerEnv) -> TExpr {
    in_own_frame(fn() -> TExpr {
        inner_t :: do {
            // GATE #4494: ExprCacheScope retains scoped TLS cache cleanup on all exits.
            try_subject_cache_scope :: ExprCacheScope.enter()
            fallback_subject :: env.fallback_subject
            env.fallback_subject = true
            t :: lower_expr(inner, cx, env)
            env.fallback_subject = fallback_subject
            ^t
        }
        if inner_t.ty == .Named(name) && name == Syntax.TYPE_NEVER -> return ^inner_t
        note_t :: note.map(fn(n) { lower_expr(n, cx, env) })
        result_ty :: if inner_t.ty == { .Result(ok, _) | .Option(ok) -> ~ok; other -> ~other }
        tconvert :: if convert == {
            .None -> TTryConvert.None
            .Never -> TTryConvert.Never
            .DefaultErr -> TTryConvert.DefaultErr
            .Typed{fn_name, source, target} -> TTryConvert.Typed{fn_name: ~fn_name, source: ~source, target: ~target}
            .WidenUnion{enum_name, tag} -> TTryConvert.WidenUnion{enum_name: ~enum_name, tag: ~tag}
        }
        (line, column) :: cx.src_line_col(span.start)
        TExpr{ty: ^result_ty, kind: TExprKind.Try{inner: ^inner_t, note: ^note_t, convert: ^tconvert, file: escape_rust_str(cx.file), line: line, column: column, fn_name: escape_rust_str(env.fn_name)}}
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:8564
// Expr.OrFallback(value, fallback, ..) routes directly to lower_or_fallback(value, fallback, cx, env).
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:8570
fn lower_expr_inner_opt_field(base: Expr, member: String, flatten: Bool, cx: Cx, env: &LowerEnv) -> TExpr {
    in_own_frame(fn() -> TExpr {
        base_t :: lower_expr(base, cx, env)
        ty :: if base_t.ty == .Option(payload_ty) -> {
            struct_field_type(cx, payload_ty, member).map(fn(field_ty) {
                if flatten -> {
                    if field_ty == .Option(inner) -> Type.Option(^inner) else -> Type.Option(^field_ty)
                } else -> Type.Option(^field_ty)
            }) ?? ~base_t.ty
        } else -> ~base_t.ty
        TExpr{ty: ^ty, kind: TExprKind.OptField{base: ^base_t, member: ~member, flatten: flatten}}
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:8606
fn lower_expr_inner_lambda(lam: jet_foundation.Lambda, cx: Cx, env: &LowerEnv) -> TExpr {
    in_own_frame(fn() -> TExpr {
        tl :: lower_lambda(lam, cx, env)
        params :: ~tl.param_types
        ret :: ~tl.ret
        TExpr{ty: Type.Fn{params: ^params, ret: ^ret, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: ~lam.meta.return_view_provenance}, kind: TExprKind.Lambda(^tl)}
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:8626
fn lower_expr_inner_ptr_from_addr(elem: Type, addr: Expr, cx: Cx, env: &LowerEnv) -> TExpr {
    in_own_frame(fn() -> TExpr {
        taddr :: lower_expr(addr, cx, env)
        TExpr{ty: ptr_type(~elem), kind: TExprKind.PtrFromAddr{elem: ~elem, addr: ^taddr}}
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:8639
// Direct invariant routes: StrMatchLit -> "StrMatchLit", BinMatchLit -> "BinMatchLit",
// MemberSpread -> "MemberSpread", Spread -> "Spread", ReduceMarker -> "ReduceMarker".
// Each routes its exact span to invariant_violation_expr; Paren lowers the inner unchanged.
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:8650
fn lower_expr_inner_unit_lit(e: Expr, suffix: String, span: Span, cx: Cx, env: &LowerEnv) -> TExpr {
    if unit_lit_elaborated(e, cx) == Val(rewritten) -> lower_temporary_expr(rewritten, cx, env)
    else -> invariant_violation_expr(span, "UnitLit `{suffix}`")
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:8660
fn lower_expr_inner_typed_lit(head: Type?, body: TypedLitBody, span: Span, cx: Cx, env: &LowerEnv) -> TExpr {
    in_own_frame(fn() -> TExpr {
        checked_head :: head ?? return invariant_violation_expr(span, "TypedLit without head")
        if checked_head == .Named(type_name) -> {
            if lower_boundary_typed_lit(type_name, body, cx, env) == Val(lowered) -> return ^lowered
        }
        if checked_head == Type.Named(Syntax.TYPE_REGEX) && body == .Value(pattern) -> {
            return in_own_frame(fn() -> TExpr { core_call_expr(checked_head, "core.regex", "literal", [lower_expr(pattern, cx, env)], span, [false]) })
        }
        rewritten :: if (checked_head, body) == {
            (.List(_) | .FixedList{..}, .Empty) -> Expr.ListLit([], span)
            (.List(_) | .FixedList{..}, .Elements(elems)) -> Expr.ListLit(~elems, span)
            (.List(_) | .FixedList{..}, .ByteText(parts)) -> {
                elems :: byte_text_exprs(parts, span) ?? return invariant_violation_expr(span, "TypedLit byte text")
                Expr.ListLit(^elems, span)
            }
            (.List(_) | .FixedList{..}, .Value(inner)) -> Expr.ListLit([~inner], span)
            (.Map{..}, .Empty) -> Expr.MapLit([], span)
            (.Map{..}, .Entries(entries)) -> Expr.MapLit(~entries, span)
            (.Named(name), .Fields(fields)) -> Expr.StructLit{type_name: ~name, type_args: [], import_ns: None, as_trait: None, fields: ~fields, inferred: false, span: span}
            (.Apply(name, args), .Fields(fields)) -> Expr.StructLit{type_name: ~name, type_args: ~args, import_ns: None, as_trait: None, fields: ~fields, inferred: false, span: span}
            (.Named(name), .Empty) -> Expr.StructLit{type_name: ~name, type_args: [], import_ns: None, as_trait: None, fields: [], inferred: false, span: span}
            (.Apply(name, args), .Empty) -> Expr.StructLit{type_name: ~name, type_args: ~args, import_ns: None, as_trait: None, fields: [], inferred: false, span: span}
            (_, .Value(inner)) -> {
                t := lower_temporary_expr(inner, cx, env)
                if t.kind == TExprKind.Absent && checked_head == .Option(_) -> { t.ty = ~checked_head; return ^t }
                retag_numeric_width(&t, checked_head, cx.src_line_col(span.start).0 as U32)
                return ^t
            }
            (_, .Elements(elems)) if elems.len() == 1 -> {
                t := lower_temporary_expr(elems[0], cx, env)
                retag_numeric_width(&t, checked_head, cx.src_line_col(span.start).0 as U32)
                return ^t
            }
            else -> return invariant_violation_expr(span, "typed literal body vs head `{checked_head.name()}`")
        }
        in_own_frame(fn() -> TExpr {
            t := lower_temporary_expr(rewritten, cx, env)
            // Stored function types use effective carriers, not the source head spelling.
            if checked_head == .List(_) | .FixedList{..} | .Map{..} | .Named(_) | .Apply(..) | .Int | .IntN{..} | .InlineRange{..} | .Float | .Float32 -> t.ty = checked_head.with_effective_fn_returns()
            if checked_head == .List(elem) | .FixedList{elem, ..} -> {
                if elem == .IntN{signed, bits} && t.kind == .ListLit(elems) -> {
                    loop el in &elems -> {
                        if el.kind == .IntLit(_, width) -> { width = Val((signed, bits)); el.ty = ~elem }
                    }
                }
                if (elem == Type.Float || elem == Type.Float32) && t.kind == .ListLit(elems) -> {
                    line :: cx.src_line_col(span.start).0 as U32
                    loop el in &elems -> retag_numeric_width(&el, elem, line)
                }
                if elem == .Option(_) && t.kind == .ListLit(elems) -> {
                    loop el in &elems -> { if el.kind == TExprKind.Absent -> el.ty = ~elem }
                }
            }
            ^t
        })
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:8833
fn lower_expr_inner_pattern_test(e: Expr, subject: Expr, pattern: Pattern, cx: Cx, env: &LowerEnv) -> TExpr {
    if pattern == .Variant{bindings, ..} && bindings.is_empty() -> return lower_binding_free_variant_pattern_test(subject, pattern, cx, env)
    if pattern.has_nested_pattern() || pattern_binds_nothing(pattern) -> {
        subj :: lower_expr(subject, cx, env)
        enum_type :: if pattern == .Variant{..} | .Or(..) -> resolved_enum_subject_type(cx, subj.ty).ok() else -> None
        return TExpr{ty: Type.Bool, kind: TExprKind.PatternMatches{subj: ^subj, pattern: TPattern.from_ast(~pattern, ^enum_type, TPatternPosition.Arm, false, false)}}
    }
    if pattern == .Ok{binding, ..} | .Err{binding, ..} && (binding.is_empty() || binding == "_") -> {
        return TExpr{ty: Type.Bool, kind: TExprKind.PatternMatches{subj: lower_expr(subject, cx, env), pattern: TPattern.from_ast(~pattern, None, TPatternPosition.Arm, false, false)}}
    }
    if pattern == .Absent(_) -> {
        lowered_subject :: lower_expr(subject, cx, env)
        present :: TExpr{ty: Type.Bool, kind: TExprKind.HostCall(THostCall.OptionProbe{inner: ^lowered_subject, kind: TOptionProbe.IsSome})}
        return TExpr{ty: Type.Bool, kind: TExprKind.Unary{op: UnOp.Not, operand: ^present}}
    }
    if pattern == .BinMatch{..} -> {
        lowered_subject :: lower_expr(subject, cx, env)
        return bin_match_pattern_cond_expr(pattern, ^lowered_subject, cx)
    }
    if pattern == .StrMatch{..} -> {
        lowered_subject :: lower_expr(subject, cx, env)
        return str_match_pattern_cond_expr(pattern, ^lowered_subject, cx)
    }
    // Value-position bindings live only within the generated condition, not its caller.
    (cond, _bindings, then_body) :: lower_if_cond(e, cx, env)
    canonicalize_pre_tier_expr(TExpr{ty: Type.Bool, kind: TExprKind.IfExpr{cond: ^cond, then_body: ^then_body,
        then_value: TExpr{ty: Type.Bool, kind: TExprKind.BoolLit(true)}, else_body: [], else_value: TExpr{ty: Type.Bool, kind: TExprKind.BoolLit(false)}}})
}

