use jet_codegen.TIR.[LowerEnv, TExpr, TExprKind, TEnumPayload, THostCall, TTryConvert, THandleOp, TMethodRef, TLocal, TStrPart, TLambda, TLambdaBody, TFailureCarrier, TCaptureFacts, TEffectFacts, TClosureOp, TOptionProbe, TPattern, TPatternPosition, lower_enum_arg, struct_field_type, shared_guard_value_field, declared_field_ty, is_numeric_bounds_const, preserve_typed_list_shape, maybe_widen_expr_to_union, lower_lambda, unit_type, canonicalize_pre_tier_expr]
use jet_codegen.TIR.Lower.Expressions.[in_own_frame, lower_expr, lower_owned_expr, lower_list_lit, lower_present, lower_raw_contextual_result_variant, raw_contextual_return_enum, grouped_enum_unit_variant, compiler_fact_type, core_module_path_from_receiver, resolve_unknown_index_kind, invariant_violation_expr, ExprCacheScope, lower_or_fallback, lower_temporary_expr, unit_lit_elaborated, lower_boundary_typed_lit, byte_text_exprs, retag_numeric_width, core_call_expr, pattern_binds_nothing, lower_binding_free_variant_pattern_test]
