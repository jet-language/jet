// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:30
fn cov_line(cx: Cx, offset: USize) -> USize { cx.src_line_col(offset).0 }

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:40
fn method_semantic_key(module: String, owner: Type, trait_name: String?, operator_rhs: Type?, method: String) -> String {
    owner_name :: owner.name()
    method_name :: if trait_name == {
        Val(trait_name) -> {
            if trait_name == Syntax.TRAIT_ADD || trait_name == Syntax.TRAIT_SUB || trait_name == Syntax.TRAIT_MUL || trait_name == Syntax.TRAIT_DIV || trait_name == Syntax.TRAIT_EQUATABLE || trait_name == Syntax.TRAIT_COMPARABLE {
                Traits.operator_method_identity(owner_name, trait_name, method, operator_rhs ?? owner)
            } else { "{owner_name}::{trait_name}::{method}" }
        }
        None -> "{owner_name}::{method}"
    }
    if !module.is_empty() && method_name.starts_with("{module}::") { method_name }
    else { function_semantic_key(module, method_name) }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:77
fn generic_params_from(type_params: [TypeParam]) -> [TGenericParam] {
    loop param in type_params -> TGenericParam{name: param.name.clone(), bounds: param.bounds.clone()}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:87
fn type_param_names(f: Func) -> [String] { loop param in f.type_params -> param.name.clone() }

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:94
fn default_target_applicability() -> TTargetApplicability {
    TTargetApplicability{rust_aot: true, cranelift: true, interpreter: true, web: true}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:103
fn sentries_enabled_for_function(f: Func, cx: Cx) -> Bool {
    declarations :: cx.policy_declarations.iter().filter(fn(declaration) {
        declaration.key == Policy.PolicyKey.Sentries && (
            (if declaration.scope == { Organization | Package | Module -> true _ -> false }) || declaration.target == Val(f.span))
    }).cloned()
    Policy.resolve(Policy.PolicyKey.Sentries, declarations).ok().flatten().is_none_or(fn(policy) { policy.value == Policy.PolicyValue.On })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:123
fn unsafe_gate(f: Func, cx: Cx, enabled: Bool) -> TUnsafeGate? {
    if !f.is_unsafe { return None }
    span :: f.unsafe_span ?? f.span
    Val(TUnsafeGate{file: cx.file.clone(), line: cov_line(cx, span.start) as U32,
        reason: f.unsafe_reason.clone() ?? "", enabled: enabled, fenced: cx.dependency_fenced})
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:136
fn bind_resource_param(source_name: String, ty: Type, convention: AccessConvention, cx: Cx, mut env: LowerEnv, mut guards: [TStmt], ordinary_slot: TLocal) {
    resource :: convention == AccessConvention.Move && (if ty == {
        Named(name) | Apply{name: name, ..} -> cx.has_close_type(name)
        _ -> false
    })
    if !resource {
        local_ty :: if ty == {
            Apply{name: name, ..} -> {
                if name == Syntax.TYPE_SHARED_GUARD {
                    Type.Tagged{marker: TagMarker.Internal(if convention == AccessConvention.Write { InternalTag.SharedGuardEdit } else { InternalTag.SharedGuardRead }), inner: ty.clone()}
                } else { ty.clone() }
            }
            _ -> ty.clone()
        }
        &env.bind(source_name, ordinary_slot, Val(local_ty))
        return
    }
    guard_name :: mangle_generated("resource_param_{source_name}")
    &guards.push(TStmt.Let{name: guard_name.clone(), kw: "let mut", let_ty: TLetTy.resource(ty.clone()),
        init: TExpr{ty: ty.clone(), kind: TExprKind.ResourceNew(TExpr{ty: ty.clone(), kind: TExprKind.Move(TExpr{ty: ty.clone(), kind: TExprKind.Local(TLocal.user(source_name))})})},
        gc_promotion: None, gc_transferred: false})
    &env.bind(source_name, TLocal.user(guard_name).through_ref(), Val(ty.clone()))
    &env.mark_resource(source_name)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:205
fn lower_func(f: Func, cx: Cx) -> TFunc { lower_func_with_web_boundary(f, cx, false) }

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:209
fn lower_error_conv(conversion: ErrorConvDef, cx: Cx) -> TFunc { lower_error_conv_inner(conversion, cx) }

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:213
fn lower_error_conv_inner(conversion: ErrorConvDef, cx: Cx) -> TFunc {
    name :: Sema.error_conv_fn_name(conversion.from_ty, conversion.to_ty)
    from_ty :: Type.Named(conversion.from_ty.clone())
    to_ty :: Type.Named(conversion.to_ty.clone())
    env := LowerEnv.new(name.clone())
    env.sentries_fenced = cx.dependency_fenced
    env.ret_ty = Val(to_ty.clone())
    &env.bind(Syntax.KW_SELF, TLocal.user(Syntax.KW_SELF), Val(from_ty.clone()))
    prepare_interrupt_callback_locals(conversion.body, cx, &env)
    body :: lower_value_block(conversion.body, cx, &env)
    note_stack_sentry_in_tir(body, env)
    TFunc{name: name.clone(), module: cx.module_identity.clone(), key: function_semantic_key(cx.module_identity, name),
        source_file: cx.file.clone(), source_span: conversion.from_span,
        failure_carrier: TFailureCarrier.from_checked_type(to_ty), effects: TEffectFacts.default(), target_applicability: default_target_applicability(),
        web_bucket: None, web_marker: None, visibility: TVisibility.Private, foreign: None,
        params: [(Syntax.KW_SELF.to_string(), from_ty, AccessConvention.Move)], web_param_reconstructions: [], ret: Val(to_ty),
        gc_return: false, gc_scope: false, return_view_provenance: None, generic_params: [], clone_types: [], is_main: false,
        line: cov_line(cx, conversion.from_span.start), synthetic: false, is_unsafe: false, unsafe_gate: None,
        is_pure: true, memo_bound: None, is_reactive: false, reactive_upgrades: [], is_inline: false, is_inline_always: false,
        is_scalar: false, kernel_proof: None, memo_field: None, uses_stack_sentry: env.stack_sentry_needed(), body: body, kind: TFuncKind.TopLevel}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:276
fn lower_web_func(f: Func, cx: Cx) -> TFunc {
    lower_func_with_web_boundary(f, cx, f.web_marker == Val(Syntax.WebPartitionMarker.WasmExport))
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:284
fn lower_func_with_web_boundary(f: Func, cx: Cx, reconstruct_web_params: Bool) -> TFunc {
    // Stream<T> retains its executable yield protocol rather than a failure carrier.
    return_type :: f.return_type.filter(fn(ty) {
        if ty == { Apply{name: name, args: args} -> name == Syntax.TYPE_STREAM && args.len() == 1 _ -> false }
    }).cloned() ?? f.effective_return_type()
    type_params :: type_param_names(f)
    return_type :: cx.canonicalize_checked_type(return_type, type_params)
    env := LowerEnv.new(f.name.clone())
    env.sentries_enabled = sentries_enabled_for_function(f, cx)
    env.sentries_fenced = cx.dependency_fenced
    env.gc_return = f.gc_return
    env.ret_ty = Val(return_type.clone())
    params := [(String, Type, AccessConvention)]{}
    resource_param_guards := [TStmt]{}
    web_param_reconstructions := [TWebParamReconstruction]{}
    loop p in f.params {
        rust_name :: p.name.clone()
        declared_param_ty :: if p.variadic { Type.List(p.ty.clone()) } else { p.ty.clone() }
        effective_param_ty :: cx.expand_type_aliases(declared_param_ty).with_effective_fn_returns()
        param_ty :: cx.canonicalize_checked_type(effective_param_ty, type_params)
        if reconstruct_web_params {
            if param_ty == {
                Named(type_name) -> {
                    if cx.struct_fields.get(type_name) == {
                        Val(fields) -> {
                            if !fields.is_empty() && fields.iter().all(fn(pair) { if pair.1 == { Int | IntN{..} | InlineRange{..} -> true _ -> false } }) {
                                flat_fields :: loop (field, ty) in fields -> (field.to_string(), "{p.name}_{field}", ty.clone())
                                &env.bind(p.name, TLocal.user(p.name), Val(param_ty.clone()))
                                &params.push((rust_name.clone(), param_ty.clone(), p.convention))
                                &web_param_reconstructions.push(TWebParamReconstruction{local: TLocal.user(p.name), ty: Type.Named(type_name.to_string()), fields: flat_fields})
                                continue
                            }
                        }
                        None -> {}
                    }
                }
                _ -> {}
            }
        }
        slot_param := p.clone()
        slot_param.ty = param_ty.clone()
        convention :: effective_generic_convention(slot_param, f.type_params)
        slot_param.convention = convention
        place :: param_place_generic(p.name, slot_param, f.type_params)
        bind_resource_param(p.name, param_ty, convention, cx, &env, &resource_param_guards, place)
        &params.push((rust_name, param_ty, convention))
    }
    body := resource_param_guards
    prepare_interrupt_callback_locals(f.body, cx, &env)
    lowered_body :: if return_type_has_value(return_type) { lower_value_block(f.body, cx, &env) } else { lower_stmts(f.body, cx, &env) }
    &body.extend(lowered_body)
    clone_types := env.cloned_types.borrow().clone()
    loop param in f.params { collect_signature_clone_types(param.ty, cx, &clone_types) }
    collect_signature_clone_types(return_type, cx, &clone_types)
    body :: wrap_contract_scope(f, body, None, Val(return_type.clone()), env.stack_sentry_needed, cx)
    note_stack_sentry_in_tir(body, env)
    uses_stack_sentry :: env.stack_sentry_needed()
    // An empty failure set unwraps its success, except Never Never! remains a carrier.
    plain_return :: if function_has_plain_return(f) {
        if return_type == { Result{ok: ok, err: err} -> if err.is_never() && !ok.is_never() { Val(ok.clone()) } else { None } _ -> None }
    } else { None }
    failure_carrier :: if plain_return == {
        Val(Type.Option(value)) -> TFailureCarrier.Optional{value: value.clone()}
        Val(_) -> TFailureCarrier.Infallible
        None -> function_failure_carrier(f)
    }
    TFunc{name: f.name.clone(), module: cx.module_identity.clone(), key: function_semantic_key(cx.module_identity, f.name),
        source_file: cx.file.clone(), source_span: f.span, failure_carrier: failure_carrier,
        effects: function_effect_facts(f), target_applicability: function_target_applicability(f), web_bucket: None, web_marker: f.web_marker.clone(),
        visibility: function_visibility(f), foreign: function_foreign_provenance(f), params: params, web_param_reconstructions: web_param_reconstructions,
        ret: Val(plain_return ?? return_type), gc_return: f.gc_return, gc_scope: f.gc_scope, return_view_provenance: f.return_view_provenance.clone(),
        generic_params: generic_params_from(f.type_params), clone_types: clone_types, is_main: false, line: cov_line(cx, f.name_span.start), synthetic: f.compiler_generated,
        is_unsafe: f.is_unsafe, unsafe_gate: unsafe_gate(f, cx, env.sentries_enabled), is_pure: f.is_pure, memo_bound: memo_bound_from_markers(f.markers),
        is_reactive: f.is_reactive, reactive_upgrades: f.reactive_upgrades.clone(), is_inline: f.is_inline, is_inline_always: f.is_inline_always,
        is_scalar: f.markers.iter().any(fn(marker) { marker.name == Syntax.MARKER_SCALAR }), kernel_proof: f.kernel.and_then(fn(marker) { marker.proof }),
        memo_field: None, uses_stack_sentry: uses_stack_sentry, body: body, kind: TFuncKind.TopLevel}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:468
fn lower_contract_cond(f: Func, cond: Expr, result_binding: (String, Type)?, owner_type: String?, stack_sentry_needed: Rc<Cell<Bool>>, cx: Cx) -> TExpr {
    env := LowerEnv.new(f.name.clone())
    env.sentries_enabled = sentries_enabled_for_function(f, cx)
    env.sentries_fenced = cx.dependency_fenced
    env.gc_return = f.gc_return
    names :: type_param_names(f)
    loop p in f.params {
        param_ty := if p.variadic { Type.List(p.ty.clone()) } else { p.ty.clone() }
        if owner_type == { Val(owner) -> { param_ty = resolve_self_ty(param_ty, owner) } None -> {} }
        param_ty :: cx.canonicalize_checked_type(param_ty, names)
        slot_param := p.clone()
        slot_param.ty = param_ty.clone()
        place :: if owner_type.is_some() && p.name == Syntax.KW_SELF {
            if p.convention == AccessConvention.Write { TLocal.generated(Syntax.KW_SELF).through_ref() }
            else if p.convention == AccessConvention.Read { TLocal.generated(Syntax.KW_SELF).with_address_lifetime(TAddressLifetime.Borrowed) }
            else { TLocal.generated(Syntax.KW_SELF) }
        } else { param_place_generic(p.name, slot_param, f.type_params) }
        &env.bind(p.name, place, Val(param_ty))
    }
    if result_binding == {
        Val((rust_name, ty)) -> &env.bind("result", TLocal.generated(rust_name), Val(cx.canonicalize_checked_type(ty, names)))
        None -> {}
    }
    env.stack_sentry_needed = stack_sentry_needed.clone()
    lower_expr(cond, cx, &env)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:518
fn contract_interval(expr: Expr, bindings: [String:Type], cx: Cx) -> (I64, I64)? {
    if expr == {
        Int(value, ..) -> Val((value, value))
        Ident(name, _) -> {
            ty :: bindings.get(name) ?? return None
            if ty == {
                Named(type_name) -> cx.distinct_ranges.get(type_name).copied()
                Tagged{inner: inner, ..} -> if inner == { Named(type_name) -> cx.distinct_ranges.get(type_name).copied() _ -> None }
                _ -> None
            }
        }
        MethodCall{receiver: receiver, method: method, ..} -> if method == "raw" { contract_interval(receiver, bindings, cx) } else { None }
        _ -> None
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:539
fn interval_comparison(op: BinOp, left: (I64, I64), right: (I64, I64)) -> Bool {
    (left_lo, left_hi) :: left
    (right_lo, right_hi) :: right
    if op == {
        Eq -> left_lo == left_hi && left == right
        Ne -> left_hi < right_lo || right_hi < left_lo
        Lt -> left_hi < right_lo
        Gt -> left_lo > right_hi
        Le -> left_hi <= right_lo
        Ge -> left_lo >= right_hi
        _ -> false
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:556
fn contract_expr_proven(expr: Expr, bindings: [String:Type], cx: Cx) -> Bool {
    if expr == {
        Bool(value, _) -> value
        Binary(BinOp.And, left, right, _) -> contract_expr_proven(left, bindings, cx) && contract_expr_proven(right, bindings, cx)
        Binary(BinOp.Or, left, right, _) -> contract_expr_proven(left, bindings, cx) || contract_expr_proven(right, bindings, cx)
        Binary(op, left, right, _) -> {
            if !op.is_comparison() { return false }
            if (contract_interval(left, bindings, cx), contract_interval(right, bindings, cx)) == {
                (Val(left), Val(right)) -> interval_comparison(op, left, right)
                _ -> false
            }
        }
        CompareChain{operands: operands, ops: ops, ..} -> {
            operands.windows(2).zip(ops).all(fn(pair_op) {
                (pair, op) :: pair_op
                if (contract_interval(pair[0], bindings, cx), contract_interval(pair[1], bindings, cx)) == {
                    (Val(left), Val(right)) -> interval_comparison(op, left, right)
                    _ -> false
                }
            })
        }
        _ -> false
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:589
fn contract_fact_bindings(f: Func, result_binding: (String, Type)?, owner_type: String?, cx: Cx) -> [String:Type] {
    bindings := [String:Type]{}
    names :: type_param_names(f)
    loop param in f.params {
        ty := if param.variadic { Type.List(param.ty.clone()) } else { param.ty.clone() }
        if owner_type == { Val(owner) -> { ty = resolve_self_ty(ty, owner) } None -> {} }
        ty :: cx.canonicalize_checked_type(ty, names)
        &bindings.insert(param.name.clone(), ty)
    }
    if result_binding == {
        Val((name, ty)) -> {
            ty :: cx.canonicalize_checked_type(ty, names)
            &bindings.insert(name.to_string(), ty.clone())
            &bindings.insert("result", ty)
        }
        None -> {}
    }
    bindings
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:617
fn lower_contract_clause(f: Func, clause: ContractClause, result_binding: (String, Type)?, kind: TContractKind, owner_type: String?, stack_sentry_needed: Rc<Cell<Bool>>, cx: Cx) -> TContract {
    (_, line, _) :: tir_src_line_at(cx.src, cx.src_lines(), clause.span.start)
    bindings :: contract_fact_bindings(f, result_binding, owner_type, cx)
    TContract{kind: kind, condition: lower_contract_cond(f, clause.cond, result_binding, owner_type, stack_sentry_needed, cx),
        message: lower_contract_cond(f, clause.message_expr, result_binding, owner_type, stack_sentry_needed, cx), file: cx.file.clone(), line: line, span: clause.span,
        disposition: if contract_expr_proven(clause.cond, bindings, cx) { TContractDisposition.Proven } else { TContractDisposition.Check }}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:658
fn contract_result_mode(carrier_ty: Type, binding_ty: Type) -> TContractResultMode {
    if carrier_ty == binding_ty { return TContractResultMode.Direct }
    if carrier_ty == {
        Result{..} -> TContractResultMode.ResultPayload
        Option(_) -> TContractResultMode.OptionPayload
        Tagged{inner: inner, ..} -> contract_result_mode(inner, binding_ty)
        other -> {
            debug_assert_eq(other, binding_ty, "contract result binding must match a non-carrier return type")
            TContractResultMode.Direct
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:676
fn contract_result_for_scope(f: Func, owner_type: String?, ret: Type?, cx: Cx) -> TContractResult {
    names :: type_param_names(f)
    declared :: f.return_type.clone() ?? Type.Named(Syntax.INTERNAL_UNIT_TYPE.to_string())
    declared :: owner_type.map(fn(owner) { resolve_self_ty(declared, owner) }) ?? declared
    binding_ty :: canonical_owner_type(cx, cx.canonicalize_checked_type(declared, names))
    carrier_ty :: ret.map(fn(ty) { cx.canonicalize_checked_type(ty, names) }).map(fn(ty) { canonical_owner_type(cx, ty) }) ?? Type.Named(Syntax.INTERNAL_UNIT_TYPE.to_string())
    mode :: contract_result_mode(carrier_ty, binding_ty)
    binding_local :: TLocal.generated("result")
    carrier_local :: if mode == { Direct -> binding_local.clone() ResultPayload | OptionPayload -> TLocal.generated("result_carrier") }
    TContractResult{carrier_ty: carrier_ty, binding_ty: binding_ty, carrier_local: carrier_local, binding_local: binding_local, mode: mode}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:715
fn lower_post_contracts_for_owner(f: Func, owner_type: String?, result: TContractResult, stack_sentry_needed: Rc<Cell<Bool>>, cx: Cx) -> [TContract] {
    loop clause in f.post -> lower_contract_clause(f, clause, Val((result.binding_local.name, result.binding_ty)), TContractKind.Post, owner_type, stack_sentry_needed, cx)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:738
fn wrap_contract_scope(f: Func, body: [TStmt], owner_type: String?, ret: Type?, stack_sentry_needed: Rc<Cell<Bool>>, cx: Cx) -> [TStmt] {
    result :: contract_result_for_scope(f, owner_type, ret, cx)
    post :: lower_post_contracts_for_owner(f, owner_type, result, stack_sentry_needed, cx)
    // Pre is a call-site node: never duplicate the check in the callee.
    if post.is_empty() { body } else { [TStmt.ContractScope{pre: [], body: body, post: post, result: result}] }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:766
fn collect_signature_clone_types(ty: Type, cx: Cx, mut out: [Type]) {
    expanded :: cx.expand_type_aliases(ty)
    if expanded == {
        Apply{name: name, args: args} -> {
            carries_clone_bound :: cx.struct_type_params.get(name).is_some_and(fn(params) { !params.is_empty() }) && cx.cloneable.contains(name)
            if carries_clone_bound { &out.extend(args.iter().cloned()) }
            loop arg in args { collect_signature_clone_types(arg, cx, &out) }
        }
        List(inner) | Option(inner) | FixedList{elem: inner, ..} | Tagged{inner: inner, ..} | Quantity{base: inner, ..} | InlineRange{base: inner, ..} -> collect_signature_clone_types(inner, cx, &out)
        Map{key: key, value: value, ..} | Result{ok: key, err: value} -> {
            collect_signature_clone_types(key, cx, &out)
            collect_signature_clone_types(value, cx, &out)
        }
        Shared(_) | Fn{..} | TraitObject(_) -> {}
        Tuple(fields) -> { loop (_, field) in fields { collect_signature_clone_types(field, cx, &out) } }
        Union(members) -> { loop member in members { collect_signature_clone_types(member, cx, &out) } }
        _ -> {}
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:814
fn effective_generic_convention(p: Param, _type_params: [TypeParam]) -> AccessConvention { p.convention }

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:826
fn param_place_generic(name: String, p: Param, _type_params: [TypeParam]) -> TLocal { param_place(name, p) }

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:837
fn canonical_owner_type(cx: Cx, ty: Type) -> Type {
    entry_local :: cx.jit_local_call_prefix.is_none()
    mapped :: ty.map_named_types(fn(name) {
        if entry_local && cx.local_type_names.contains(name) { return None }
        canonical :: canonical_enum_owner(cx, name)
        if canonical != name { Val(canonical) } else { None }
    })
    if mapped == { Apply{name: name, args: args} -> Type.Apply{name: canonical_enum_owner(cx, name), args: args} other -> other }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:855
fn canonical_owner_name(cx: Cx, name: String) -> String { canonical_enum_owner(cx, name) }

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:869
fn lower_method(f: Func, type_name: String, cx: Cx) -> TFunc {
    owner_ty :: if cx.struct_type_param_order.get(type_name) == {
        Val(params) -> if !params.is_empty() { Type.Apply{name: type_name.to_string(), args: loop param in params -> Type.Named(param.clone())} } else { Type.Named(type_name.to_string()) }
        None -> Type.Named(type_name.to_string())
    }
    lower_method_for_owner_inner(f, type_name, owner_ty, cx, false)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:882
fn lower_method_for_owner(f: Func, type_name: String, owner_ty: Type, cx: Cx, raw_protocol_return: Bool) -> TFunc {
    lower_method_for_owner_inner(f, type_name, owner_ty, cx, raw_protocol_return)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:892
fn lower_method_for_owner_inner(f: Func, type_name: String, owner_ty: Type, cx: Cx, raw_protocol_return: Bool) -> TFunc {
    owner_ty :: canonical_owner_type(cx, owner_ty)
    declared_return_type :: f.return_type.clone() ?? Type.Named(Syntax.INTERNAL_UNIT_TYPE.to_string())
    return_type :: if raw_protocol_return {
        debug_assert(f.return_type.is_some(), "state-transition methods must declare their raw return type")
        resolve_self_ty(declared_return_type, type_name)
    } else { resolve_self_ty(f.effective_return_type(), type_name) }
    previous_type_params :: cx.current_type_params.borrow().clone()
    method_type_params := previous_type_params.clone()
    if cx.struct_type_param_order.get(type_name) == { Val(owner_params) -> &method_type_params.extend(owner_params.iter().cloned()) None -> {} }
    &method_type_params.extend(f.type_params.iter().map(fn(param) { param.name.clone() }))
    _ :: cx.current_type_params.replace(method_type_params.clone())
    return_type :: canonical_owner_type(cx, cx.canonicalize_checked_type(return_type, method_type_params))
    env := LowerEnv.new(f.name.clone())
    env.sentries_fenced = cx.dependency_fenced
    env.gc_return = f.gc_return
    env.ret_ty = Val(return_type.clone())
    env.raw_protocol_return = raw_protocol_return
    env.self_owner = Val(canonical_owner_name(cx, type_name))
    params := [(String, Type, AccessConvention)]{}
    resource_param_guards := [TStmt]{}
    self_conv := None as AccessConvention?
    is_static := true
    loop p in f.params {
        if p.name == Syntax.KW_SELF {
            place :: if p.convention == AccessConvention.Write { TLocal.generated("self").through_ref() }
                else if p.convention == AccessConvention.Read { TLocal.generated("self").with_address_lifetime(TAddressLifetime.Borrowed) }
                else { TLocal.generated("self") }
            &env.bind(Syntax.KW_SELF, place, Val(owner_ty.clone()))
            if p.convention == AccessConvention.Read { &env.mark_borrowed(Syntax.KW_SELF) }
            self_conv = Val(p.convention)
            is_static = false
            continue
        }
        rust_name :: p.name.clone()
        pty := resolve_self_ty(p.ty.with_effective_fn_returns(), type_name)
        if p.variadic { pty = Type.List(pty) }
        pty = canonical_owner_type(cx, cx.canonicalize_checked_type(pty, method_type_params))
        slot_param := p.clone()
        slot_param.ty = pty.clone()
        convention :: effective_generic_convention(slot_param, f.type_params)
        slot_param.convention = convention
        place :: param_place_generic(p.name, slot_param, f.type_params)
        bind_resource_param(p.name, pty, convention, cx, &env, &resource_param_guards, place)
        &params.push((rust_name, pty, convention))
    }
    body := resource_param_guards
    prepare_interrupt_callback_locals(f.body, cx, &env)
    lowered_body :: if return_type_has_value(return_type) { lower_value_block(f.body, cx, &env) } else { lower_stmts(f.body, cx, &env) }
    &body.extend(lowered_body)
    body :: wrap_contract_scope(f, body, Val(type_name), Val(return_type.clone()), env.stack_sentry_needed, cx)
    clone_types := env.cloned_types.borrow().clone()
    collect_signature_clone_types(owner_ty, cx, &clone_types)
    loop param in f.params { collect_signature_clone_types(param.ty, cx, &clone_types) }
    collect_signature_clone_types(return_type, cx, &clone_types)
    _ :: cx.current_type_params.replace(previous_type_params)
    semantic_key :: method_semantic_key(cx.module_identity, owner_ty, None, None, f.name)
    kind :: TFuncKind.Method{self_conv: if is_static { None } else { self_conv }, owner_type: owner_ty}
    memo_field :: cx.memo_fields.get(type_name).and_then(fn(fields) { if fields.contains_key(f.name) { Val(f.name.clone()) } else { None } })
    note_stack_sentry_in_tir(body, env)
    uses_stack_sentry :: env.stack_sentry_needed()
    TFunc{name: f.name.clone(), module: cx.module_identity.clone(), key: semantic_key, source_file: cx.file.clone(), source_span: f.span,
        failure_carrier: function_failure_carrier(f), effects: function_effect_facts(f), target_applicability: function_target_applicability(f),
        web_bucket: None, web_marker: f.web_marker.clone(), visibility: function_visibility(f), foreign: function_foreign_provenance(f),
        params: params, web_param_reconstructions: [], ret: Val(return_type), gc_return: f.gc_return, gc_scope: f.gc_scope, return_view_provenance: f.return_view_provenance.clone(),
        generic_params: generic_params_from(f.type_params), clone_types: clone_types, is_main: false, line: cov_line(cx, f.name_span.start), synthetic: f.compiler_generated,
        is_unsafe: f.is_unsafe, unsafe_gate: unsafe_gate(f, cx, env.sentries_enabled), is_pure: f.is_pure, memo_bound: None,
        is_reactive: f.is_reactive, reactive_upgrades: f.reactive_upgrades.clone(), is_inline: f.is_inline, is_inline_always: f.is_inline_always,
        is_scalar: f.markers.iter().any(fn(marker) { marker.name == Syntax.MARKER_SCALAR }), kernel_proof: f.kernel.and_then(fn(marker) { marker.proof }),
        memo_field: memo_field, uses_stack_sentry: uses_stack_sentry, body: body, kind: kind}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:1078
fn lower_trait_method(f: Func, type_name: String, cx: Cx, trait_name: String, raw_protocol_return: Bool, operator_rhs: Type?) -> TFunc {
    lower_trait_method_inner(f, type_name, cx, trait_name, raw_protocol_return, operator_rhs)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:1096
fn lower_trait_method_inner(f: Func, type_name: String, cx: Cx, trait_name: String, raw_protocol_return: Bool, operator_rhs: Type?) -> TFunc {
    raw_protocol_return :: raw_protocol_return || trait_name == Generics.ENCODE || trait_name == Generics.DECODE || trait_name == Generics.DISPLAY || trait_name == Generics.DEBUG || trait_name == Generics.EQUATABLE || trait_name == Generics.COMPARABLE || trait_name == Generics.CLOSE || trait_name == Syntax.TRAIT_ROLLBACK || trait_name == Generics.ADD || trait_name == Generics.SUB || trait_name == Generics.MUL || trait_name == Generics.DIV
    declared_return_type :: f.return_type.clone() ?? Type.Named(Syntax.INTERNAL_UNIT_TYPE.to_string())
    return_type :: if raw_protocol_return {
        debug_assert(f.return_type.is_some() || trait_name == Generics.CLOSE || trait_name == Syntax.TRAIT_ROLLBACK, "protocol methods must declare their raw return type")
        resolve_self_ty(declared_return_type, type_name)
    } else { resolve_self_ty(f.effective_return_type(), type_name) }
    serde :: if trait_name == Generics.ENCODE { Val(SerdeCodec.Encode) } else if trait_name == Generics.DECODE { Val(SerdeCodec.Decode) } else { None }
    owner_ty :: numeric_type_from_name(type_name) ?? (if cx.struct_type_param_order.get(type_name) == {
        Val(params) -> if !params.is_empty() { Type.Apply{name: type_name.to_string(), args: loop param in params -> Type.Named(param.clone())} } else { Type.Named(type_name.to_string()) }
        None -> Type.Named(type_name.to_string())
    })
    owner_ty :: canonical_owner_type(cx, owner_ty)
    previous_type_params :: cx.current_type_params.borrow().clone()
    method_type_params := previous_type_params.clone()
    if cx.struct_type_param_order.get(type_name) == { Val(owner_params) -> &method_type_params.extend(owner_params.iter().cloned()) None -> {} }
    &method_type_params.extend(f.type_params.iter().map(fn(param) { param.name.clone() }))
    _ :: cx.current_type_params.replace(method_type_params.clone())
    return_type :: canonical_owner_type(cx, cx.canonicalize_checked_type(return_type, method_type_params))
    env := LowerEnv.new(f.name.clone())
    env.sentries_enabled = sentries_enabled_for_function(f, cx)
    env.sentries_fenced = cx.dependency_fenced
    env.gc_return = f.gc_return
    env.ret_ty = Val(return_type.clone())
    env.raw_protocol_return = raw_protocol_return
    env.self_owner = Val(canonical_owner_name(cx, type_name))
    params := [(String, Type, AccessConvention)]{}
    resource_param_guards := [TStmt]{}
    self_conv := None as AccessConvention?
    loop p in f.params {
        if p.name == Syntax.KW_SELF {
            self_conv = Val(p.convention)
            place :: if p.convention == AccessConvention.Write { TLocal.generated("self").through_ref() }
                else if p.convention == AccessConvention.Read { TLocal.generated("self").with_address_lifetime(TAddressLifetime.Borrowed) }
                else { TLocal.generated("self") }
            &env.bind(Syntax.KW_SELF, place, Val(owner_ty.clone()))
            if p.convention == AccessConvention.Read { &env.mark_borrowed(Syntax.KW_SELF) }
            continue
        }
        rust_name :: p.name.clone()
        // Decode rebinds its borrowed DataTree parameter to an owned local.
        place :: if serde == Val(SerdeCodec.Decode) { TLocal.user(p.name) } else { param_place(p.name, p) }
        pty :: canonical_owner_type(cx, cx.canonicalize_checked_type(resolve_self_ty(p.ty, type_name), method_type_params))
        bind_resource_param(p.name, pty, p.convention, cx, &env, &resource_param_guards, place)
        &params.push((rust_name, pty, p.convention))
    }
    body := resource_param_guards
    prepare_interrupt_callback_locals(f.body, cx, &env)
    lowered_body :: if return_type_has_value(return_type) { lower_value_block(f.body, cx, &env) } else { lower_stmts(f.body, cx, &env) }
    &body.extend(lowered_body)
    body := wrap_contract_scope(f, body, Val(type_name), Val(return_type.clone()), env.stack_sentry_needed, cx)
    if serde == Val(SerdeCodec.Encode) && cx.published_schemas.contains(type_name) {
        loop index in 0..body.len() {
            if body[index] == {
                Return(Val(value)) -> {
                    known :: ^value
                    holder :: TExpr{ty: Type.Named(Syntax.TYPE_DATA.to_string()), kind: TExprKind.Field{
                        recv: TExpr{ty: owner_ty.clone(), kind: TExprKind.Local(TLocal.generated(Syntax.KW_SELF))},
                        field: Syntax.PUBLISHED_UNKNOWN_FIELDS.to_string(), boxed: false}}
                    known_ty :: known.ty.clone()
                    kind :: if Syntax.core_call_projection("core.encoding", "__published_schema_merge", Syntax.CoreCallCoverage.TIR_SUBSET, 2) == {
                        Ok(record) -> TExprKind.CoreCall{record: record, args: [known, holder], source_span: f.span, type_args: [], widen_to_vec: [false, false], data_plan: None, fallibility: TFailureCarrier.from_checked_type(known_ty)}
                        Err(_) -> known.kind
                    }
                    body[index] = TStmt.Return(Val(TExpr{ty: known_ty, kind: kind}))
                }
                _ -> {}
            }
        }
    }
    clone_types := env.cloned_types.borrow().clone()
    collect_signature_clone_types(owner_ty, cx, &clone_types)
    loop param in f.params { collect_signature_clone_types(param.ty, cx, &clone_types) }
    collect_signature_clone_types(return_type, cx, &clone_types)
    _ :: cx.current_type_params.replace(previous_type_params)
    note_stack_sentry_in_tir(body, env)
    uses_stack_sentry :: env.stack_sentry_needed()
    TFunc{name: f.name.clone(), module: cx.module_identity.clone(), key: method_semantic_key(cx.module_identity, owner_ty, Val(trait_name), operator_rhs, f.name),
        source_file: cx.file.clone(), source_span: f.span, failure_carrier: function_failure_carrier(f), effects: function_effect_facts(f), target_applicability: function_target_applicability(f),
        web_bucket: None, web_marker: f.web_marker.clone(), visibility: function_visibility(f), foreign: function_foreign_provenance(f), params: params, web_param_reconstructions: [],
        ret: Val(return_type), gc_return: f.gc_return, gc_scope: f.gc_scope, return_view_provenance: f.return_view_provenance.clone(), generic_params: generic_params_from(f.type_params),
        clone_types: clone_types, is_main: false, line: cov_line(cx, f.name_span.start), synthetic: f.compiler_generated,
        is_unsafe: f.is_unsafe, unsafe_gate: unsafe_gate(f, cx, env.sentries_enabled), is_pure: f.is_pure, memo_bound: None,
        is_reactive: f.is_reactive, reactive_upgrades: f.reactive_upgrades.clone(), is_inline: f.is_inline, is_inline_always: f.is_inline_always,
        is_scalar: f.markers.iter().any(fn(marker) { marker.name == Syntax.MARKER_SCALAR }), kernel_proof: f.kernel.and_then(fn(marker) { marker.proof }), memo_field: None,
        uses_stack_sentry: uses_stack_sentry, body: body,
        kind: TFuncKind.TraitMethod{is_unsafe: f.is_unsafe, self_conv: self_conv, owner_type: owner_ty, trait_name: trait_name.to_string(), serde: serde}}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:1363
fn tir_covers_delegation_method(_f: Func, _field: String, _cx: Cx) -> Bool { true }

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:1372
fn lower_delegation_method(f: Func, field: String, cx: Cx) -> TFunc { lower_delegation_method_inner(f, field, cx) }

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:1376
fn lower_delegation_method_inner(f: Func, _field: String, cx: Cx) -> TFunc {
    names :: type_param_names(f)
    return_type :: cx.canonicalize_checked_type(f.effective_return_type(), names)
    owner_ty :: f.params.iter().find(fn(param) { param.name == Syntax.KW_SELF }).map(fn(param) { cx.canonicalize_checked_type(param.ty, names) }) ?? Type.Named(Syntax.KW_SELF.to_string())
    self_conv :: f.params.iter().find(fn(param) { param.name == Syntax.KW_SELF }).map(fn(param) { param.convention })
    params :: f.params.iter().filter(fn(param) { param.name != Syntax.KW_SELF }).map(fn(param) { (param.name.clone(), cx.canonicalize_checked_type(param.ty, names), param.convention) }).collect()
    TFunc{name: f.name.clone(), module: cx.module_identity.clone(), key: method_semantic_key(cx.module_identity, owner_ty, None, None, f.name),
        source_file: cx.file.clone(), source_span: f.span, failure_carrier: function_failure_carrier(f), effects: function_effect_facts(f), target_applicability: function_target_applicability(f),
        web_bucket: None, web_marker: f.web_marker.clone(), visibility: function_visibility(f), foreign: function_foreign_provenance(f), params: params, web_param_reconstructions: [],
        ret: Val(return_type), gc_return: f.gc_return, gc_scope: f.gc_scope, return_view_provenance: f.return_view_provenance.clone(), generic_params: generic_params_from(f.type_params),
        clone_types: [], is_main: false, line: cov_line(cx, f.name_span.start), synthetic: f.compiler_generated, is_unsafe: false, unsafe_gate: None, is_pure: false,
        memo_bound: None, is_reactive: false, reactive_upgrades: [], is_inline: false, is_inline_always: false, is_scalar: false, kernel_proof: None, memo_field: None,
        uses_stack_sentry: false, body: [], kind: TFuncKind.TraitMethod{is_unsafe: false, self_conv: self_conv, owner_type: owner_ty, trait_name: "", serde: None}}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs:1452
fn param_place(name: String, p: Param) -> TLocal {
    deref :: if p.convention == { Read -> !p.ty.is_scalar() Write -> true Move -> false }
    slot :: TLocal.user(name)
    if deref { slot.through_ref() } else { slot }
}
