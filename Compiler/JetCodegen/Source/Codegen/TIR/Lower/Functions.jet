//RS /// c109 Phase 12: lower a TRAIT-IMPL method of `type_name` to a `TFunc`. Mirrors
//RS /// `emit_trait_method`'s slot construction (Source/Codegen/Items.rs) EXACTLY — which
//RS /// differs from `emit_method`:
//RS ///  - the `self` slot's type is `Some(Type::Named(type_name))` (NOT `None` as in
//RS ///    `emit_method`); place `self`, no deref. This is load-bearing for overflow-trap
//RS ///    decisions that consult the self slot — though in the covered subset `self` is a
//RS ///    struct/enum (never a bare arithmetic operand), so the decision never differs.
//RS ///  - non-self params use the same deref logic, but `emit_trait_method` has no
//RS ///    `Read if scalar` short-circuit branch — it computes `deref = !p.ty.is_scalar()`
//RS ///    for `Read`, which is identical to `param_place` for `Read` (scalar → false).
//RS /// The `TraitMethod` kind drives a bare name, no `pub`, always-`&self` signature.
//RS ///
//RS /// D-SERDE2 (card #131 S1-bridge): `trait_name` selects a codec bridge when it is
//RS /// `Encode`/`Decode` — a hand `impl T.Encode`/`impl T.Decode` whose user-facing
//RS /// `encode`/`decode` verbs + Jet signatures must lower to the Rust trait's
//RS /// `jet_encode`/`jet_decode`. `Encode` is an ordinary instance method (`&self`),
//RS /// only its NAME is bridged. `Decode` is STATIC: the by-value `tree: Data` param
//RS /// binds as an owned local (a clone the emit prepends), so its place is the bare
//RS /// mangled name — no receiver, no `param_place` deref.
//RS pub(crate) fn lower_trait_method(
//RS     f: &Func,
//RS     type_name: &str,
//RS     cx: &Cx,
//RS     trait_name: &str,
//RS     raw_protocol_return: bool,
//RS     operator_rhs: Option<&Type>,
//RS ) -> TFunc {
//RS     lower_trait_method_inner(
//RS         f,
//RS         type_name,
//RS         cx,
//RS         trait_name,
//RS         raw_protocol_return,
//RS         operator_rhs,
//RS     )
//RS }
//RS 
//RS fn lower_trait_method_inner(
//RS     f: &Func,
//RS     type_name: &str,
//RS     cx: &Cx,
//RS     trait_name: &str,
//RS     raw_protocol_return: bool,
//RS     operator_rhs: Option<&Type>,
