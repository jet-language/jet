//RS /// The Rust type path a Jet enum name spells, plus whether its variants are
//RS /// spelled RAW. `true` = a Rust-defined enum (Prelude/host) whose variants are
//RS /// plain Rust identifiers; `false` = a Jet-declared enum whose variants are
//RS /// mangled.
//RS ///
//RS /// This is the ONE table. `tir_enum_lit_prefix` (enum literals and bare
//RS /// variant-path tests) and `emit_match_pattern` (match-arm heads, Statement.rs)
//RS /// both read it, so a Prelude enum can never be spelled `jet_std::WatchDomain`
//RS /// as a value and `__jet_WatchDomain` as a pattern. A second copy of this table
//RS /// is how `WatchDomain`/`WatchKind` reached rustc as E0433 in generated code
//RS /// (I2): the copy in `emit_match_pattern` had never heard of them, so every
//RS /// core enum the copy was missing mangled into a nonexistent local type.
//RS 
//RS /// The Rust variant name under a `tir_enum_rust_path` head. A raw (Rust-defined)
//RS /// variant keeps its own identifier — a mangled spelling reaching it means the
//RS /// caller carried the generated prefix, which is not part of the Rust name.
//RS 
//RS /// c109 Phase 24: the Rust enum-literal head `{prefix}::{mangle(variant)}` for a payload
//RS /// or named enum literal, reproducing `emit_enum_lit`'s `type_prefix` (Expression.rs): a
//RS /// FOREIGN (imported) enum → `{root}{mod}::__jet_<T>::__jet_<V>`, a local enum →
//RS /// `__jet_<T>::__jet_<V>`. Keyed on the ENUM name in `cx.foreign_types`, byte-for-byte.
//RS 
//RS /// c109 Phase 16: the single-payload type of `(type_name, edge)`, mirroring the AST
//RS /// `enum_variant_payload_type` (Expression.rs). `edge` is the complete VARIANT path
//RS /// for a positional arg (`Ping`, or `Net.Ping` for a grouped leaf), or
//RS /// `"Variant.label"` for a named arg — the latter is explicitly non-applicable to the
//RS /// single-payload clone decision. Missing checked owner/variant layout is an
//RS /// invariant, not a payload-less variant.
//RS pub(crate) fn enum_variant_payload_type<'a>(
//RS     cx: &'a Cx,
//RS     type_name: &str,
//RS     edge: &str,
//RS ) -> Result<Option<&'a Type>, &'static str> {
//RS     let type_name = crate::Codegen::TIR::canonical_enum_owner(cx, type_name);
//RS     let variants = cx
//RS         .enum_variants
//RS         .get(&type_name)
//RS         .ok_or("enum payload owner layout")?;
//RS     // A positional payload's edge is the complete variant path. Check that form
//RS     // before splitting on `.`: a grouped leaf such as `Net.Ping` is a variant in
//RS     // its own right, not a named field `Ping` on group `Net`.
//RS     if let Some((_, payload)) = variants.iter().find(|(variant, _)| variant == edge) {
//RS         return Ok(match payload {
//RS             VariantPayload::Single(t, _) => Some(t),
//RS             VariantPayload::Named(fs) if fs.len() == 1 => Some(&fs[0].ty),
//RS             VariantPayload::Unit => return Err("enum payload argument for unit variant"),
//RS             VariantPayload::Named(_) => return Err("enum positional payload requires one field"),
//RS         });
//RS     }
//RS     // A named payload appends its field label to the complete variant path;
//RS     // splitting from the right keeps a grouped path (`Net.Packet.bytes`) whole.
//RS     let (variant, label) = edge
//RS         .rsplit_once('.')
//RS         .ok_or("enum payload variant layout")?;
//RS     let (_, payload) = variants
//RS         .iter()
//RS         .find(|(candidate, _)| candidate == variant)
//RS         .ok_or("enum payload variant layout")?;
//RS     match payload {
//RS         VariantPayload::Named(fields) if fields.iter().any(|field| field.name == label) => Ok(None),
//RS         VariantPayload::Named(_) => Err("enum named payload field layout"),
//RS         VariantPayload::Unit | VariantPayload::Single(..) => {
//RS             Err("enum named payload variant layout")
//RS         }
//RS     }
//RS }
//RS 
//RS /// c109 Phase 16: lower one enum-literal payload arg, resolving the `clone`/`boxed`
//RS /// decisions as TOTAL facts, reproducing `emit_boxed_enum_arg` (Expression.rs)
//RS /// byte-for-byte. `edge` is the variant name (positional) or `"Variant.label"`
//RS /// (named). A non-scalar single-payload type whose arg is a borrowed-in-env ident
//RS /// gets `(…).clone()`; a recursive (`boxed_edge`) edge gets `Box::new(…)`.
//RS pub(crate) fn lower_enum_arg(
//RS     type_name: &str,
//RS     variant: &str,
//RS     edge: &str,
//RS     e: &Expr,
//RS     cx: &Cx,
