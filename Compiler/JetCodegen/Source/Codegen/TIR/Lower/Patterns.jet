// Rust: crates/jet-codegen/src/Codegen/TIR/lower/patterns.rs:33
fn lower_cursor_take_pattern(receiver: Expr, parts: [StrMatchPart], cx: Cx, mut env: LowerEnv, lowered_receiver: TExpr?) -> TExpr {
    recv_t :: lowered_receiver ?? lower_expr(receiver, cx, &env)
    canonical := [(String, Type)]{}
    loop part in parts {
        if part == {
            Hole{name: name, ty: ty, span: span} -> {
                ty :: if ty == {
                    None -> Type.String
                    Val(t) -> if t == { Int | Float | Bool | String | InlineRange{..} -> t.clone() _ -> return invariant_expr("cursor.take_pattern hole type", span, Type.Result{ok: unit_type(), err: Type.String}) }
                }
                &canonical.push((name.clone(), ty))
            }
            _ -> {}
        }
    }
    ok_ty :: if canonical.is_empty() { unit_type() } else { Type.Tuple(loop (n, t) in canonical -> (n.clone(), t.clone())) }
    TExpr{ty: Type.Result{ok: ok_ty, err: Type.String}, kind: TExprKind.HandleMethod{recv: recv_t, op: THandleOp.CursorTakePattern{parts: parts.to_vec(), canonical: canonical}, args: []}}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/patterns.rs:97
fn lower_reader_take_pattern(receiver: Expr, parts: [BinMatchPart], cx: Cx, mut env: LowerEnv, lowered_receiver: TExpr?) -> TExpr {
    recv_t :: lowered_receiver ?? lower_expr(receiver, cx, &env)
    canonical :: parts.iter().filter_map(fn(p) {
        if p == {
            Hole{name: name, spec: spec, ..} -> Val((name.clone(), if spec == { Rest -> Type.List(Type.IntN{signed: false, bits: 8}) Bits{width: width, ..} -> bin_bits_type(width) }))
            Lit(_) -> None
        }
    }).collect()
    ok_ty :: if canonical.is_empty() { unit_type() } else { Type.Tuple(loop (n, t) in canonical -> (n.clone(), t.clone())) }
    TExpr{ty: Type.Result{ok: ok_ty, err: Type.String}, kind: TExprKind.HandleMethod{recv: recv_t, op: THandleOp.ReaderTakePattern{parts: parts.to_vec(), canonical: canonical}, args: []}}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/patterns.rs:153
fn str_match_pattern_cond_expr(pattern: Pattern, subject: TExpr, _cx: Cx) -> TExpr {
    if pattern == {
        StrMatch{parts: parts, ..} -> TExpr{ty: Type.Bool, kind: TExprKind.HostCall(THostCall.StrMatchScan{subject: subject, parts: parts.clone(), probe: TMatchProbe.IsSome})}
        _ -> invariant_expr("string-match condition pattern", pattern.span(), Type.Bool)
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/patterns.rs:172
fn lower_str_match_pattern_bindings(pattern: Pattern, subject: TExpr, _cx: Cx, mut env: LowerEnv) -> [TStmt] {
    parts :: if pattern == { StrMatch{parts: parts, ..} -> parts _ -> return [TStmt.InvariantViolation{construct: "string-match binding pattern", span: pattern.span()}] }
    holes :: parts.iter().filter_map(fn(part) {
        if part == { Hole{name: name, ty: ty, ..} -> Val((name.clone(), ty.clone() ?? Type.String)) Lit(_) -> None }
    }).collect()
    if holes.is_empty() { return [] }
    tuple_local :: mangle_generated("sm_tuple")
    tuple_ty :: Type.Tuple(loop (n, t) in holes -> (n.clone(), t.clone()))
    out := [TStmt.Let{name: tuple_local.to_string(), kw: "let", let_ty: let_ty_tuple(loop (_, t) in holes -> t.clone()),
        init: TExpr{ty: tuple_ty.clone(), kind: TExprKind.HostCall(THostCall.StrMatchScan{subject: subject, parts: parts.clone(), probe: TMatchProbe.Unwrap})}, gc_promotion: None, gc_transferred: false}]
    loop (i, (name, ty)) in holes.iter().enumerate() {
        &env.bind(name, TLocal.user(name), Val(ty.clone()))
        &out.push(TStmt.Let{name: name.clone(), kw: "let", let_ty: TLetTy.plain(ty.clone()),
            init: TExpr{ty: ty.clone(), kind: TExprKind.HostCall(THostCall.TupleIndex{base: TExpr{ty: tuple_ty.clone(), kind: TExprKind.Local(TLocal.user(tuple_local))}, index: i})}, gc_promotion: None, gc_transferred: false})
    }
    out
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/patterns.rs:243
fn bin_match_pattern_cond_expr(pattern: Pattern, subject: TExpr, _cx: Cx) -> TExpr {
    if pattern == {
        BinMatch{parts: parts, ..} -> TExpr{ty: Type.Bool, kind: TExprKind.HostCall(THostCall.BinMatchScan{subject: subject, parts: parts.clone(), probe: TMatchProbe.IsSome})}
        _ -> invariant_expr("binary-match condition pattern", pattern.span(), Type.Bool)
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/patterns.rs:259
fn lower_bin_match_pattern_bindings(pattern: Pattern, subject: TExpr, _cx: Cx, mut env: LowerEnv) -> [TStmt] {
    parts :: if pattern == { BinMatch{parts: parts, ..} -> parts _ -> return [TStmt.InvariantViolation{construct: "binary-match binding pattern", span: pattern.span()}] }
    holes :: parts.iter().filter_map(fn(part) {
        if part == {
            Hole{name: name, spec: spec, ..} -> Val((name.clone(), if spec == { Rest -> Type.List(Type.IntN{signed: false, bits: 8}) Bits{width: width, ..} -> bin_bits_type(width) }))
            Lit(_) -> None
        }
    }).collect()
    if holes.is_empty() { return [] }
    tuple_local :: mangle_generated("bm_tuple")
    tuple_ty :: Type.Tuple(loop (n, t) in holes -> (n.clone(), t.clone()))
    out := [TStmt.Let{name: tuple_local.to_string(), kw: "let", let_ty: let_ty_tuple(loop (_, t) in holes -> t.clone()),
        init: TExpr{ty: tuple_ty.clone(), kind: TExprKind.HostCall(THostCall.BinMatchScan{subject: subject, parts: parts.clone(), probe: TMatchProbe.Unwrap})}, gc_promotion: None, gc_transferred: false}]
    loop (i, (name, ty)) in holes.iter().enumerate() {
        &env.bind(name, TLocal.user(name), Val(ty.clone()))
        &out.push(TStmt.Let{name: name.clone(), kw: "let", let_ty: TLetTy.plain(ty.clone()),
            init: TExpr{ty: ty.clone(), kind: TExprKind.HostCall(THostCall.TupleIndex{base: TExpr{ty: tuple_ty.clone(), kind: TExprKind.Local(TLocal.user(tuple_local))}, index: i})}, gc_promotion: None, gc_transferred: false})
    }
    out
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/patterns.rs:335
fn struct_pattern_field_type(cx: Cx, subject_ty: Type, field: String) -> Type? {
    if subject_ty == {
        Apply{name: name, ..} -> (cx.struct_fields.get(name) ?? return None).iter().find(fn(pair) { pair.0 == field }).map(fn(pair) { pair.1.clone() })
        _ -> struct_field_type(cx, subject_ty, field)
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/patterns.rs:347
fn bool_and_chain(mut tests: [TExpr]) -> TExpr {
    acc := &tests.pop() ?? return TExpr{ty: Type.Bool, kind: TExprKind.BoolLit(true)}
    loop {
        next :: &tests.pop() ?? break
        acc = TExpr{ty: Type.Bool, kind: TExprKind.Binary{op: BinOp.And, overflow: false, line: 0, lhs: next, rhs: acc}}
    }
    acc
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/patterns.rs:369
fn invariant_expr(construct: String, span: Span, ty: Type) -> TExpr { TExpr{ty: ty, kind: TExprKind.InvariantViolation{construct: construct, span: span}} }

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/patterns.rs:379
fn invariant_stmt(construct: String, span: Span) -> TStmt { TStmt.InvariantViolation{construct: construct, span: span} }

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/patterns.rs:386
fn resolved_enum_subject_type(cx: Cx, subject_ty: Type) -> String Err! {
    if subject_ty.without_user_tags() == {
        Union(members) -> if !members.is_empty() { union_enum_name(members) } else { fail "empty union enum subject" }
        Named(name) | Apply{name: name, ..} -> canonical_enum_owner(cx, name)
        _ -> fail "enum match subject is not an enum type"
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/patterns.rs:407
fn lower_fallible_match(subject: Expr, arms: [SwitchArm], else_body: [Stmt]?, cx: Cx, mut env: LowerEnv) -> LowerStmtPlan {
    subject_t := {
        cache_scope :: ExprCacheScope.enter()
        fallback_subject :: env.fallback_subject
        env.fallback_subject = true
        value :: lower_expr(subject, cx, &env)
        env.fallback_subject = fallback_subject
        value
    }
    subject_ty :: if subject_t.ty.without_user_tags() == {
        Option(_) | Result{..} -> subject_t.ty.clone()
        _ -> {
            declared :: if subject.without_parens() == { Call(call) -> call.resolved_ret MethodCall{resolved_ret: resolved_ret, ..} -> resolved_ret _ -> None }
            declared.map(fn(ty) { FailureContract.from_return_type(Val(ty)).effective_type() }).filter(fn(ty) {
                if ty.without_user_tags() == { Option(_) | Result{..} -> true _ -> false }
            }) ?? subject_t.ty.clone()
        }
    }
    if subject_t.ty != subject_ty { subject_t.ty = subject_ty.clone() }
    is_option :: if subject_ty.without_user_tags() == {
        Option(_) -> true
        Result{..} -> false
        _ -> {
            eprintln("fallible match debug: subject_ty={subject_ty:?} lowered_ty={subject_t.ty:?}")
            return LowerStmtPlan.ready(invariant_stmt("fallible match subject type", subject.span()))
        }
    }
    subject_span :: subject.span()
    (scrutinee, clone_subject) :: if subject == {
        Ident(name, _) -> {
            if env.is_borrowed(name) {
                by_value := env.local_of(name)
                by_value.deref = false
                (TExpr{ty: subject_ty.clone(), kind: TExprKind.Local(by_value)}, true)
            } else { (subject_t, false) }
        }
        _ -> (subject_t, false)
    }
    if arms.is_empty() { return LowerStmtPlan.ready(invariant_stmt("fallible match has no arms", subject_span)) }
    tarms := [TPattern].with_capacity(arms.len())
    bodies := [LowerBody].with_capacity(arms.len() + if else_body.is_some() { 1 } else { 0 })
    loop arm in arms {
        pattern :: arm_fallible_pattern(cx, arm.cond, subject) ?? return LowerStmtPlan.ready(invariant_stmt("fallible match arm pattern", arm.span))
        body_env := fork_panic(env)
        if tir_add_fallible_binding(pattern, &body_env, subject_ty) == { Err(reason) -> return LowerStmtPlan.ready(invariant_stmt(reason, pattern.span())) Ok(_) -> {} }
        tir_pattern :: if is_option { TPattern.option_binding_with_values(pattern, fn(value) { lower_expr(value, cx, &env) }) } else { TPattern.binding_with_values(pattern, fn(value) { lower_expr(value, cx, &env) }) }
        &tarms.push(tir_pattern)
        &bodies.push(LowerBody.scoped(arm.body, body_env))
    }
    has_else :: else_body.is_some()
    if else_body == { Val(body) -> &bodies.push(LowerBody.scoped(body, clone_env(env))) None -> {} }
    deferred_stmt(bodies, fn(lowered) {
        expected :: tarms.len() + if has_else { 1 } else { 0 }
        if lowered.len() != expected { return invariant_stmt("fallible match body count", subject_span) }
        lowered := lowered.into_iter()
        match_arms := [TMatchArm].with_capacity(tarms.len())
        loop pattern in tarms {
            body :: &lowered.next() ?? return invariant_stmt("fallible match body order", subject_span)
            &match_arms.push(TMatchArm{pattern: pattern, body: body})
        }
        else_lowered :: if has_else { Val(&lowered.next() ?? return invariant_stmt("fallible match else body", subject_span)) } else { None }
        if (&lowered.next()).is_some() { return invariant_stmt("fallible match extra body", subject_span) }
        TStmt.EnumMatch{scrutinee: scrutinee, clone_subject: clone_subject, arms: match_arms, else_body: else_lowered, fallthrough: !has_else}
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/patterns.rs:543
fn tir_add_fallible_binding(pattern: Pattern, mut env: LowerEnv, subject_ty: Type) -> () Err! {
    subject_ty :: subject_ty.without_user_tags()
    (binding, ty) :: if (pattern, subject_ty) == {
        (Pattern.Ok{binding: binding, ..}, Type.Result{ok: ok, ..}) -> (binding.clone(), ok.clone())
        (Pattern.Err{binding: binding, ..}, Type.Result{err: err, ..}) -> (binding.clone(), err.clone())
        (Pattern.Present{binding: binding, ..}, Type.Option(inner)) -> (binding.clone(), inner.clone())
        (Pattern.Absent(_), Type.Option(_)) -> return ()
        (Pattern.Ok{..}, _) -> fail "Ok pattern does not match fallible subject type"
        (Pattern.Err{..}, _) -> fail "Err pattern does not match fallible subject type"
        (Pattern.Present{..}, _) -> fail "present pattern does not match optional subject type"
        (Pattern.Absent(_), _) -> fail "absent pattern does not match optional subject type"
        _ -> fail "unsupported fallible binding pattern"
    }
    slot :: if ty.is_allocator_view() { TLocal.user(binding).through_ref() } else { TLocal.user(binding) }
    &env.bind(binding, slot, Val(ty))
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/patterns.rs:577
fn lower_enum_match(subject: Expr, arms: [SwitchArm], else_body: [Stmt]?, cx: Cx, mut env: LowerEnv) -> LowerStmtPlan {
    subject_span :: subject.span()
    (scrutinee, clone_subject) :: if subject == {
        Ident(name, _) -> {
            if env.is_borrowed(name) {
                slot :: env.local_of(name)
                ty :: env.ty_of(name) ?? return LowerStmtPlan.ready(invariant_stmt("enum match borrowed subject type", subject_span))
                by_value := slot.clone()
                by_value.deref = false
                (TExpr{ty: ty, kind: TExprKind.Local(by_value)}, true)
            } else { (lower_expr(subject, cx, &env), false) }
        }
        _ -> (lower_expr(subject, cx, &env), false)
    }
    subject_ty :: scrutinee.ty.clone()
    enum_type :: if resolved_enum_subject_type(cx, subject_ty) == { Ok(name) -> Val(name) Err(reason) -> return LowerStmtPlan.ready(invariant_stmt(reason, subject_span)) }
    if arms.is_empty() { return LowerStmtPlan.ready(invariant_stmt("enum match has no arms", subject_span)) }
    patterns := [TPattern].with_capacity(arms.len())
    bodies := [LowerBody].with_capacity(arms.len() + if else_body.is_some() { 1 } else { 0 })
    loop arm in arms {
        pattern :: arm_variant_pattern(cx, arm.cond, subject) ?? return LowerStmtPlan.ready(invariant_stmt("enum match arm pattern", arm.span))
        body_env := fork_panic(env)
        if tir_add_pattern_bindings(cx, pattern, &body_env, Val(subject_ty)) == { Err(reason) -> return LowerStmtPlan.ready(invariant_stmt(reason, pattern.span())) Ok(_) -> {} }
        &patterns.push(TPattern.arm_with_values(pattern, enum_type.clone(), fn(value) { lower_expr(value, cx, &env) }))
        &bodies.push(LowerBody.scoped(arm.body, body_env))
    }
    has_else :: else_body.is_some()
    if else_body == { Val(body) -> &bodies.push(LowerBody.scoped(body, clone_env(env))) None -> {} }
    deferred_stmt(bodies, fn(lowered) {
        expected :: patterns.len() + if has_else { 1 } else { 0 }
        if lowered.len() != expected { return invariant_stmt("enum match body count", subject_span) }
        lowered := lowered.into_iter()
        match_arms := [TMatchArm].with_capacity(patterns.len())
        loop pattern in patterns {
            body :: &lowered.next() ?? return invariant_stmt("enum match body order", subject_span)
            &match_arms.push(TMatchArm{pattern: pattern, body: body})
        }
        else_lowered :: if has_else { Val(&lowered.next() ?? return invariant_stmt("enum match else body", subject_span)) } else { None }
        if (&lowered.next()).is_some() { return invariant_stmt("enum match extra body", subject_span) }
        TStmt.EnumMatch{scrutinee: scrutinee, clone_subject: clone_subject, arms: match_arms, else_body: else_lowered, fallthrough: !has_else}
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/patterns.rs:674
fn lower_range_switch(subject: Expr, arms: [SwitchArm], else_body: [Stmt]?, cx: Cx, mut env: LowerEnv) -> LowerStmtPlan {
    subject_expr :: lower_expr(subject, cx, &env)
    subject_span :: subject.span()
    if !(if subject_expr.ty.without_user_tags() == { Int | InlineRange{..} | Char -> true _ -> false }) { return LowerStmtPlan.ready(invariant_stmt("range switch subject type", subject_span)) }
    if arms.is_empty() { return LowerStmtPlan.ready(invariant_stmt("range switch has no arms", subject_span)) }
    ranges := [(I64, I64)].with_capacity(arms.len())
    bodies := [LowerBody].with_capacity(arms.len() + 1)
    loop arm in arms {
        (lo, hi) :: arm_head_range(cx, arm.cond, subject) ?? return LowerStmtPlan.ready(invariant_stmt("range switch arm pattern", arm.span))
        if lo > hi { return LowerStmtPlan.ready(invariant_stmt("range switch arm bounds", arm.span)) }
        &ranges.push((lo, hi))
        &bodies.push(LowerBody.scoped(arm.body, clone_env(env)))
    }
    else_body :: else_body ?? return LowerStmtPlan.ready(invariant_stmt("range switch requires else", subject_span))
    &bodies.push(LowerBody.scoped(else_body, clone_env(env)))
    deferred_stmt(bodies, fn(lowered) {
        expected :: ranges.len() + 1
        if lowered.len() != expected { return invariant_stmt("range switch body count", subject_span) }
        lowered := lowered.into_iter()
        match_arms := [(I64, I64, [TStmt])].with_capacity(ranges.len())
        loop (lo, hi) in ranges {
            body :: &lowered.next() ?? return invariant_stmt("range switch body order", subject_span)
            &match_arms.push((lo, hi, body))
        }
        else_lowered :: &lowered.next() ?? return invariant_stmt("range switch else body", subject_span)
        if (&lowered.next()).is_some() { return invariant_stmt("range switch extra body", subject_span) }
        TStmt.RangeSwitch{subject: subject_expr, arms: match_arms, else_body: else_lowered}
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/patterns.rs:742
fn tir_add_pattern_bindings(cx: Cx, pattern: Pattern, mut env: LowerEnv, subject_ty: Type?) -> () Err! {
    if pattern == {
        Variant{variant: variant, bindings: bindings, ..} -> {
            owner :: if subject_ty == { Val(ty) -> Val(resolved_enum_subject_type(cx, ty)?) None -> None }
            is_group :: owner.is_some_and(fn(owner) { !group_leaves(cx, Val(owner), variant).is_empty() })
            if is_group {
                if bindings.is_empty() { return () }
                fail "enum group pattern cannot bind payload slots"
            }
            tys :: variant_payload_types(cx, variant, subject_ty)?
            range_slots_forbidden :: subject_ty.is_some_and(fn(ty) {
                if ty.without_user_tags() == {
                    Named(name) | Apply{name: name, ..} -> {
                        resolved :: canonical_enum_owner(cx, name)
                        is_json_type_name(name) || resolved == "DataTree" || resolved == Syntax.TYPE_KEY
                    }
                    _ -> false
                }
            })
            if bindings.len() != tys.len() { fail "enum pattern payload slot count" }
            payload :: owner.and_then(fn(owner) { (cx.enum_variants.get(owner) ?? return None).iter().find(fn(pair) { pair.0 == variant }).map(fn(pair) { pair.1 }) })
            loop (i, slot) in bindings.iter().enumerate() {
                ty :: tys.get(i) ?? fail "enum pattern payload type"
                if slot == {
                    Bind{name: name, ..} -> {
                        edge :: if payload == {
                            Val(VariantPayload.Single(..)) -> Val(variant.clone())
                            Val(VariantPayload.Named(fields)) -> {
                                field :: fields.get(i) ?? fail "enum named payload field"
                                Val("{variant}.{field.name}")
                            }
                            Val(VariantPayload.Unit) | None -> None
                        }
                        // GATE #4499: exact composite (owner, edge) key membership.
                        boxed :: owner.zip(edge).is_some_and(fn(pair) { cx.boxed_edges.contains((pair.0.clone(), pair.1.clone())) })
                        local :: if boxed { TLocal.user(name).through_ref() } else { TLocal.user(name) }
                        &env.bind(name, local, Val(ty.clone()))
                    }
                    Wildcard -> {}
                    Nested(inner) -> tir_add_nested_pattern_bindings(cx, inner, &env, ty)?
                    Range{lo: lo, hi: hi} -> {
                        if range_slots_forbidden || lo > hi || !(if ty.without_user_tags() == { Int | InlineRange{..} | Char -> true _ -> false }) { fail "enum range payload type or bounds" }
                    }
                    Named{..} | Rest(_) -> fail "unplaced named payload entry"
                }
            }
        }
        Or(alts, _) -> {
            first :: alts.first() ?? fail "empty enum or-pattern"
            tir_add_pattern_bindings(cx, first, &env, subject_ty)?
            first_names :: first.binding_names()
            expected :: loop binding in first_names -> (binding.local_name().to_string(), env.ty_of(binding.local_name()))
            loop alternative in alts.iter().skip(1) {
                alternative_env := clone_env(env)
                tir_add_pattern_bindings(cx, alternative, &alternative_env, subject_ty)?
                names :: alternative.binding_names()
                if names.len() != expected.len() { fail "enum or-pattern binding count" }
                loop (binding, (expected_name, expected_ty)) in names.iter().zip(expected) {
                    if binding.local_name() != expected_name || alternative_env.ty_of(binding.local_name()) != expected_ty { fail "enum or-pattern binding shape" }
                }
            }
        }
        _ -> fail "unsupported enum binding pattern"
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/patterns.rs:875
fn tir_add_nested_pattern_bindings(cx: Cx, pattern: Pattern, mut env: LowerEnv, subject_ty: Type) -> () Err! {
    payload_ty :: if (pattern, subject_ty.without_user_tags()) == {
        (Pattern.Present{..}, Type.Option(inner)) -> inner.clone()
        (Pattern.Ok{..}, Type.Result{ok: ok, ..}) -> ok.clone()
        (Pattern.Err{..}, Type.Result{err: err, ..}) -> err.clone()
        (Pattern.Absent(_), Type.Option(_)) -> return ()
        (Pattern.Present{..} | Pattern.Ok{..} | Pattern.Err{..} | Pattern.Absent(_), _) -> fail "nested carrier pattern does not match its payload type"
        _ -> return tir_add_pattern_bindings(cx, pattern, &env, Val(subject_ty))
    }
    if pattern == {
        Present{binding: binding, inner: inner, ..} | Ok{binding: binding, inner: inner, ..} | Err{binding: binding, inner: inner, ..} -> {
            if inner == {
                Val(inner) -> tir_add_nested_pattern_bindings(cx, inner, &env, payload_ty)?
                None -> { if !binding.is_empty() && binding != "_" { &env.bind(binding, TLocal.user(binding), Val(payload_ty)) } }
            }
        }
        _ -> {}
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/patterns.rs:913
fn variant_payload_types(cx: Cx, variant: String, subject_ty: Type?) -> [Type] Err! {
    subject_ty :: (subject_ty ?? fail "enum payload subject type").without_user_tags()
    if subject_ty == {
        Apply{name: name, args: args} -> {
            if name == Syntax.TYPE_HOOK_OUTCOME || name == Syntax.TYPE_HOOK_DECISION {
                if (name, variant) == {
                    ("HookOutcome", "Continue") | ("HookDecision", "Continue" | "Transform") -> return [(args.first() ?? fail "hook payload type").clone()]
                    ("HookOutcome", "Fail") | ("HookDecision", "Fail") -> return [(args.get(1) ?? fail "hook payload type").clone()]
                    ("HookOutcome", "Cancel") | ("HookDecision", "Cancel") -> return []
                    _ -> fail "unknown hook enum variant"
                }
            }
        }
        _ -> {}
    }
    if subject_ty == {
        Union(members) -> [(members.iter().find(fn(member) { union_member_tag(member) == variant }) ?? fail "union variant payload type").clone()]
        Named(name) | Apply{name: name, ..} -> {
            resolved :: canonical_enum_owner(cx, name)
            if (is_json_type_name(name) || resolved == "DataTree") && is_json_variant(variant) {
                return if variant == {
                    "Null" -> []
                    "Bool" -> [Type.Bool]
                    "Int" -> [Type.Int]
                    "Float" -> [Type.Float]
                    "Text" -> [Type.String]
                    "Array" -> [Type.List(Type.Named(Syntax.TYPE_DATA.to_string()))]
                    "Object" -> [Type.Map{key: Type.String, key_span: None, value: Type.Named(Syntax.TYPE_DATA.to_string())}]
                    "Number" -> [Type.String]
                    _ -> fail "unknown data enum variant"
                }
            }
            if resolved == Syntax.TYPE_KEY {
                return if variant == { "Char" | "Ctrl" -> [Type.Char] "F" -> [Type.Int] v -> if is_key_variant(v) { [] } else { fail "unknown key enum variant" } }
            }
            if resolved == "DataEvent" {
                return if variant == {
                    "Bool" -> [Type.Bool]
                    "Int" -> [Type.Int]
                    "Float" -> [Type.Float]
                    "Text" | "Key" -> [Type.String]
                    "Bytes" -> [Type.List(Type.Int)]
                    "Null" | "ArrayStart" | "ArrayEnd" | "ObjectStart" | "ObjectEnd" -> []
                    _ -> fail "unknown data-event enum variant"
                }
            }
            variant_binding_types_for_enum(cx, resolved, variant) ?? fail "enum variant payload type"
        }
        _ -> fail "enum payload subject type"
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/patterns.rs:1029
fn enum_variant_payload_type(cx: Cx, type_name: String, edge: String) -> Type? Err! {
    type_name :: canonical_enum_owner(cx, type_name)
    variants :: cx.enum_variants.get(type_name) ?? fail "enum payload owner layout"
    // Positional grouped leaf paths take precedence over splitting a field label.
    if variants.iter().find(fn(pair) { pair.0 == edge }) == {
        Val((_, payload)) -> {
            return if payload == {
                Single(t, _) -> Val(t)
                Named(fs) -> if fs.len() == 1 { Val(fs[0].ty) } else { fail "enum positional payload requires one field" }
                Unit -> fail "enum payload argument for unit variant"
            }
        }
        None -> {}
    }
    (variant, label) := edge.rsplit_once('.') ?? fail "enum payload variant layout"
    (_, payload) :: variants.iter().find(fn(pair) { pair.0 == variant }) ?? fail "enum payload variant layout"
    if payload == {
        Named(fields) -> if fields.iter().any(fn(field) { field.name == label }) { None } else { fail "enum named payload field layout" }
        Unit | Single(..) -> fail "enum named payload variant layout"
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/patterns.rs:1073
fn lower_enum_arg(type_name: String, variant: String, edge: String, e: Expr, cx: Cx, mut env: LowerEnv) -> TEnumArg {
    payload_ty :: if enum_variant_payload_type(cx, type_name, edge) == {
        Ok(payload_ty) -> payload_ty
        Err(reason) -> {
            value :: lower_expr(e, cx, &env)
            return TEnumArg{value: invariant_expr("enum payload `{type_name}.{variant}`: {reason}", e.span(), value.ty.clone()), clone: false, boxed: false}
        }
    }
    borrowed :: if e == { Ident(name, _) -> env.is_borrowed(name) _ -> false }
    clone :: payload_ty.is_some_and(fn(t) { !t.is_scalar() }) && borrowed
    // GATE #4499: preserve exact tuple-key identity.
    boxed :: cx.boxed_edges.contains((type_name.to_string(), edge.to_string()))
    mutable_view_payload :: payload_ty.is_some_and(fn(ty) { if ty == { Apply{name: name, ..} -> name == "ViewMut" || name == "ComputeViewMut" _ -> false } })
    payload_expr :: if mutable_view_payload {
        if e == { Place(inner, _, span) -> Expr.Place(inner.clone(), PlaceAccess.Write, span) Slice{span: span, ..} -> Expr.Place(e.clone(), PlaceAccess.Write, span) _ -> e }
    } else { e }
    value := lower_expr(payload_expr, cx, &env)
    if payload_ty == { Val(want) -> { value = maybe_widen_expr_to_union(value, want) } None -> {} }
    if value.kind == TExprKind.Absent {
        if enum_edge_declared_type(cx, type_name, edge) == {
            Val(want) -> { if want == { Option(_) -> { value.ty = want.clone() } _ -> {} } }
            None -> {}
        }
    }
    TEnumArg{value: value, clone: clone, boxed: boxed}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/patterns.rs:1143
fn enum_edge_declared_type(cx: Cx, type_name: String, edge: String) -> Type? {
    if enum_variant_payload_type(cx, type_name, edge) == { Ok(Val(ty)) -> return Val(ty) _ -> {} }
    (variant, label) := edge.rsplit_once('.') ?? return None
    owner :: canonical_enum_owner(cx, type_name)
    (_, payload) :: (cx.enum_variants.get(owner) ?? return None).iter().find(fn(pair) { pair.0 == variant }) ?? return None
    if payload == { Named(fields) -> fields.iter().find(fn(field) { field.name == label }).map(fn(field) { field.ty }) Unit | Single(..) -> None }
}
