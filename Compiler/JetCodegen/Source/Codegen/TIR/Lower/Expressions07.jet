// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:8960
fn pattern_binds_nothing(pattern: Pattern) -> Bool Never! {
    variants_only :: if pattern == {
        .Variant(..) -> true
        .Or(alternatives, _) -> alternatives.iter().all(fn(alternative) { alternative is .Variant(..) })
        _ -> false
    }
    variants_only && pattern.binding_names().iter().all(fn(name) { name.name == "_" })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:8974
fn retag_numeric_width(expr: &TExpr, head: Type, line: U32) -> Unit Never! {
    work := TirWorklist.new()
    work.push(&expr)
    while work.pop() == Some(expr) {
        if head is .Float | .Float32 && expr.ty is .Int | .IntN(..) {
            source_signed :: !(expr.ty is .IntN(signed: false, ..))
            source :: replace(&expr, TExpr(ty: head.clone(), kind: TExprKind.Unit))
            expr.kind = TExprKind.NumericMethod(recv: ^source,
                op: TNumericOp.CheckedIntToFloat(source_signed: source_signed, target_f32: head == Type.Float32, line: line))
            continue
        }
        source_ty :: expr.ty.without_user_tags()
        head_ty :: head.without_user_tags()
        widen_fixed :: source_ty is .IntN(..) && head_ty is .IntN(..) && source_ty != head_ty && !(expr.kind is .IntLit(..))
        if widen_fixed || (head_ty is .Int && source_ty is .IntN(..)) {
            source :: replace(&expr, TExpr(ty: head.clone(), kind: TExprKind.Unit))
            expr.kind = TExprKind.NumericMethod(recv: ^source, op: TNumericOp.CastAs(dst_rust: ""))
            continue
        }
        expr.ty = head.clone()
        if !(head is .Float | .Float32) { continue }
        // Raw Decimal.from_str tokens acquire machine-float context here.
        raw_float :: if expr.kind == {
            .PreciseBuiltin(type_name, func, args) if type_name == TYPE_DECIMAL && func == "from_str" -> {
                if args.as_slice() == {
                    [TExpr(kind: .StrLit(parts), ..)] -> if parts.as_slice() == {
                        [.Lit(raw)] -> raw.replace('_', "").parse<Float>().ok()
                        _ -> None
                    }
                    _ -> None
                }
            }
            _ -> None
        }
        if raw_float == Some(value) { expr.kind = TExprKind.FloatLit(value); continue }
        if expr.kind == {
            .Unary(operand, ..) -> { work.push(&operand) }
            .Binary(lhs, rhs, ..) -> { work.push(&rhs); work.push(&lhs) }
            .Clone(inner, _) | .ExplicitCopy(inner) | .MaterializeView(inner) | .Move(inner) -> { work.push(&inner) }
            _ -> {}
        }
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9081
// Unit-family members shadow imaginary suffixes; canonical Time needs sema facts.
fn unit_lit_elaborated(e: Expr, cx: Cx) -> Expr? Never! {
    (int, float, suffix, suffix_span, span) :: if e == {
        .UnitLit(int, float, suffix, suffix_span, span, ..) -> (int, float, suffix, suffix_span, span)
        _ -> { return None }
    }
    value :: float.unwrap_or_else(fn() { int.unwrap_or(0) as Float })
    read_arg :: fn(expr: Expr) { CallArg(convention: AccessConvention.Read, expr: ^expr, span: span,
        flags: CallArgFlags.default(), label: None, spread: false) }
    type_name :: UnitFamilyDef.type_name(suffix)
    canonical_time :: cx.unit_facts.get(type_name).is_some_and(fn(fact) { fact.family == "Time" })
    if !canonical_time && cx.distinct_types.get(type_name).is_some_and(fn(pair) { pair.1 && pair.0 == Type.Float }) {
        return Some(Expr.MethodCall(receiver: Expr.Ident(^type_name, suffix_span),
            method: numeric_conversion_method("Float").expect("Float has a canonical conversion method").to_string(),
            method_span: suffix_span, owner_type_args: [], type_args: [],
            args: [read_arg(Expr.Float(value, span, false, None))], recv_type: None, resolved_ret: None,
            operator_rhs: None, checked_widen: false))
    }
    if suffix != UNIT_SUFFIX_IMAGINARY { return None }
    Some(Expr.Call(Call(name: TYPE_COMPLEX.to_string(), name_span: suffix_span, type_args: [],
        args: [read_arg(Expr.Float(0.0, span, false, None)), read_arg(Expr.Float(value, span, false, None))],
        resolved_ret: None, range_checked: false, widen_approx: false)))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9152
fn complexize_operands(op: BinOp, lhs: TExpr, rhs: TExpr, cx: Cx) -> (TExpr, TExpr) Never! {
    if !(op is .Add | .Sub | .Mul | .Div) || cx.type_names.contains(TYPE_COMPLEX) { return (^lhs, ^rhs) }
    is_complex :: fn(ty: Type) { if ty == { .Named(name) -> name == TYPE_COMPLEX, _ -> false } }
    is_scalar :: fn(ty: Type) { ty is .Int | .IntN(..) | .Float | .Float32 }
    if (is_complex(lhs.ty), is_complex(rhs.ty)) == {
        (true, false) if is_scalar(rhs.ty) -> (^lhs, complex_from_scalar(^rhs))
        (false, true) if is_scalar(lhs.ty) -> (complex_from_scalar(^lhs), ^rhs)
        _ -> (^lhs, ^rhs)
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9175
fn complex_from_scalar(value: TExpr) -> TExpr Never! {
    real :: if value.ty is .Float { ^value } else {
        source :: value.ty.name()
        op :: resolve_numeric_conversion_op("Float", source).expect("a complex scalar is a registered numeric conversion source")
        TExpr(ty: Type.Float, kind: TExprKind.NumericMethod(recv: ^value, op: ^op))
    }
    TExpr(ty: Type.Named(TYPE_COMPLEX.to_string()), kind: TExprKind.PreciseBuiltin(
        type_name: TYPE_COMPLEX.to_string(), func: "from_parts", args: [^real, TExpr(ty: Type.Float, kind: TExprKind.FloatLit(0.0))]))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9215
fn consume_plain_helper_route(resolved_ret: Type?, name_span: Span, lowered: TExpr, cx: Cx, env: LowerEnv) -> TExpr Never! {
    if env.fallback_subject || !resolved_ret.is_some_and(fn(declared) { !declared.is_fallible() })
        || resolved_ret.is_some_and(fn(declared) { if declared == { .Apply(name, args) -> name == TYPE_STREAM && args.len() == 1, _ -> false } }) { return ^lowered }
    (ok, err) :: if lowered.ty == { .Result(ok, err) -> (ok, err), _ -> { return ^lowered } }
    convert :: if err is .Named(name) && name == TYPE_NEVER { TTryConvert.Never }
        else if env.raw_protocol_return { TTryConvert.ProtocolExit } else { TTryConvert.None }
    (line, column) :: cx.src_line_col(name_span.start)
    TExpr(ty: ok.clone(), kind: TExprKind.Try(inner: ^lowered, note: None, convert: convert,
        file: escape_rust_str(cx.file), line: line, column: column, fn_name: escape_rust_str(env.fn_name)))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9263
fn lower_present(inner: Expr, cx: Cx, env: &LowerEnv) -> TExpr Never! {
    t := lower_owned_expr(inner, cx, &env)
    if env.ret_ty == Some(.Option(want)) {
        if t.ty.without_user_tags() is .List(_) | .FixedList(..) { t = preserve_typed_list_shape(^t, want, cx) }
    }
    TExpr(ty: Type.Option(t.ty.clone()), kind: TExprKind.Present(^t))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9284
fn lower_owned_expr(e: Expr, cx: Cx, env: &LowerEnv) -> TExpr Never! {
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9285
    fn reads_borrowed_place(e: Expr, env: LowerEnv) -> Bool Never! {
        current := e
        loop {
            if current == {
                .Ident(name, _) -> { return env.is_borrowed(name) }
                .Field(base, _, _) | .Index(base, ..) | .Paren(base, _) -> { current = base }
                _ -> { return false }
            }
        }
    }
    lowered :: lower_expr(e, cx, &env)
    if e is .Ident(name, _) && env.is_resource(name) {
        TExpr(ty: ^lowered.ty, kind: TExprKind.ResourceTake(env.resource_take_place(name)))
    } else if reads_borrowed_place(e, env) && !lowered.ty.is_scalar() {
        ty :: lowered.ty.clone()
        env.note_clone(ty)
        TExpr(ty: ^ty, kind: TExprKind.Clone(^lowered, MirCopyFact.Materialize))
    } else { ^lowered }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9334
fn source_arg_order(args: [CallArg]) -> [USize]? Never! {
    has_default :: args.iter().any(fn(arg) { arg.flags.binder_slot.is_some() && arg.flags.source_index.is_none() })
    if !has_default && !args.iter().any(fn(arg) { arg.flags.source_index.is_some() }) { return None }
    slots := (0..args.len()).filter(fn(slot) { args[slot].flags.source_index.is_some() }).collect<[USize]>()
    slots.sort_by_key(fn(slot) { args[slot].flags.source_index })
    if has_default {
        defaults := (0..args.len()).filter(fn(slot) { args[slot].flags.binder_slot.is_some() && args[slot].flags.source_index.is_none() }).collect<[USize]>()
        defaults.sort_by_key(fn(slot) { args[slot].flags.binder_slot })
        slots.extend(^defaults)
    }
    Some(^slots)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9361
fn wrap_foreign_undo(lowered: TExpr, inverse: String?, site: U32, cx: Cx, env: &LowerEnv) -> TExpr Never! {
    inverse :: if inverse == { Some(inverse) -> inverse, None -> { return ^lowered } }
    handle :: if env.txn_handle.clone() == { Some(handle) -> handle, None -> { return ^lowered } }
    result_ty :: lowered.ty.clone()
    (prefix, foreign) := if lowered.kind == {
        .InlineBlock(stmts) -> {
            last :: if stmts.pop() == {
                Some(last) -> last
                None -> { return TExpr(ty: ^result_ty, kind: TExprKind.InlineBlock(^stmts)) }
            }
            if last == {
                .ExprStmt(expr) -> (^stmts, ^expr)
                last -> { stmts.push(^last); return TExpr(ty: ^result_ty, kind: TExprKind.InlineBlock(^stmts)) }
            }
        }
        kind -> ([], TExpr(ty: result_ty.clone(), kind: ^kind))
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9400
    enum Forward {
        Extern(symbol: String, c_abi: Bool)
        Module(form: TModuleCallForm, target_return: Type?, type_args: [Type])
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9411
    enum Arg { Extern(TExternArg), Module(TCallArg) }
    (forward, args) :: if foreign.kind == {
        .ExternCall(symbol, c_abi, args) -> (Forward.Extern(symbol: ^symbol, c_abi: c_abi), args.into_iter().map(Arg.Extern).collect())
        .ModuleCall(form, target_return, type_args, args) -> (Forward.Module(form: ^form, target_return: ^target_return, type_args: ^type_args), args.into_iter().map(Arg.Module).collect())
        kind -> {
            prefix.push(TStmt.ExprStmt(TExpr(ty: result_ty.clone(), kind: ^kind)))
            return TExpr(ty: ^result_ty, kind: TExprKind.InlineBlock(^prefix))
        }
    }
    if env.txn_undo_needed == Some(flag) { flag.set(true) }
    inverse_params :: cx.sigs.get(inverse).cloned().unwrap_or_default()
    forward_extern_args := [TExternArg].with_capacity(args.len())
    forward_module_args := [TCallArg].with_capacity(args.len())
    inverse_args := [TCallArg].with_capacity(args.len())
    captures := [(String, TLocal, Type)].with_capacity(args.len())
    for (index, arg) in args.into_iter().enumerate() {
        (value, module_arg, extern_mut_borrow) :: if arg == {
            .Extern(arg) -> (^arg.value, None, arg.mut_borrow)
            .Module(arg) -> (^arg.value, Some((arg.borrow, arg.mut_borrow, ^arg.fn_coerce,
                arg.widen_to_vec, ^arg.widen_to_union, ^arg.box_as_trait)), false)
        }
        temp :: "{NAME_PREFIX}undo_arg_{site}_{index}"
        ty :: value.ty.clone()
        env.note_clone(ty)
        captures.push((temp.clone(), local_place(temp), ty.clone()))
        prefix.push(TStmt.Let(name: temp.clone(), kw: "let", let_ty: TLetTy.inferred(),
            init: TExpr(ty: ty.clone(), kind: TExprKind.Clone(^value, MirCopyFact.Materialize)),
            gc_promotion: None, gc_transferred: false))
        local_for_forward :: TExpr(ty: ty.clone(), kind: TExprKind.Local(TLocal.user(temp.clone())))
        if module_arg == {
            Some((borrow, mut_borrow, fn_coerce, widen_to_vec, widen_to_union, box_as_trait)) -> {
                // Snapshot owns the value; preserve conversions without a second clone.
                forward_module_args.push(TCallArg(value: ^local_for_forward, template_items: None,
                    borrow: borrow, mut_borrow: mut_borrow, clone: false, arc_clone: false,
                    fn_coerce: ^fn_coerce, widen_to_vec: widen_to_vec, widen_to_union: ^widen_to_union, box_as_trait: ^box_as_trait))
            }
            None -> {
                forward_extern_args.push(TExternArg(value: ^local_for_forward, clone: !ty.is_scalar(), mut_borrow: extern_mut_borrow))
            }
        }
        (convention, inverse_ty) :: inverse_params.get(index).cloned().unwrap_or((AccessConvention.Read, ty.clone()))
        inverse_args.push(TCallArg(value: TExpr(ty: ty.clone(), kind: TExprKind.Local(TLocal.user(^temp))), template_items: None,
            borrow: convention == AccessConvention.Read && !inverse_ty.is_scalar(), mut_borrow: convention == AccessConvention.Write,
            clone: false, arc_clone: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None))
    }
    inverse_expr :: TExpr(ty: call_return_type(cx, inverse), kind: TExprKind.Call(name: inverse.to_string(), type_args: [], args: ^inverse_args))
    inverse_ret :: (!(inverse_expr.ty is .Named(name) && name == "Unit")).then(fn() { inverse_expr.ty.clone() })
    inverse_failure :: TFailureCarrier.from_checked_type(inverse_expr.ty)
    capture_facts := TCaptureFacts.default()
    capture_facts.escapes = true
    capture_facts.moved = captures.iter().map(fn(capture) { capture.0.clone() }).collect()
    lambda :: TLambda(executable: TLambdaBody.Expr(^inverse_expr), source_span: Span.new(site as USize, site as USize),
        frame_schedule: None, frame_schedule_derivation: None, capture_facts: ^capture_facts,
        host_param_conventions: None, failure_carrier: ^inverse_failure, effects: TEffectFacts.default(), source_params: [],
        jit_name: mangle_generated("undo_{site}"), param_types: [], ret: ^inverse_ret, is_move: true, boxed: false, rc: false, arc: false,
        captures: ^captures, capture_origins: [:], materialized_captures: [], frozen_captures: [], uses_stack_sentry: false)
    registration :: TExpr(ty: Type.Named("TransactionGuard"), kind: TExprKind.CoreClosureCall(
        kind: TCoreClosureKind.OnRollback(handle_name: handle.name.clone(), executable: ^lambda)))
    prefix.push(TStmt.ExprStmt(^registration))
    forward_kind :: if forward == {
        .Extern(symbol, c_abi) -> TExprKind.ExternCall(symbol: ^symbol, c_abi: c_abi, args: ^forward_extern_args)
        .Module(form, target_return, type_args) -> TExprKind.ModuleCall(form: ^form, target_return: ^target_return, type_args: ^type_args, args: ^forward_module_args)
    }
    prefix.push(TStmt.ExprStmt(TExpr(ty: result_ty.clone(), kind: ^forward_kind)))
    TExpr(ty: ^result_ty, kind: TExprKind.InlineBlock(^prefix))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9635
fn preserve_source_arg_order(call: TExpr, order: [USize], ast_arg_count: USize, site: U32) -> TExpr Never! {
    stmts := if call.kind == {
        .Call(args, ..) | .MethodCall(args, ..) | .StaticCall(args, ..) | .ModuleCall(args, ..)
        | .FnValue(kind: .Call(args, ..)) -> bind_arg_temporaries(&args, order, ast_arg_count, site)
        .CoreCall(args, ..) -> bind_arg_temporaries(&args, order, ast_arg_count, site)
        .ExternCall(args, ..) -> bind_arg_temporaries(&args, order, ast_arg_count, site)
        .HandleMethod(args, ..) -> bind_arg_temporaries(&args, order, ast_arg_count, site)
        _ -> { return ^call }
    }
    if stmts.is_empty() { return ^call }
    ty :: call.ty.clone()
    stmts.push(TStmt.ExprStmt(^call))
    TExpr(ty: ^ty, kind: TExprKind.InlineBlock(^stmts))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9669
trait OrderedArg {
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9670
    fn value(self) -> TExpr Never!
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9674
    fn can_bind(self) -> Bool Never! { true }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9677
    fn take_for_binding(self: &Self, replacement: TExpr) -> TExpr Never!
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9679
impl OrderedArg for TCallArg {
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9681
    fn value(self) -> TExpr Never! { self.value }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9685
    fn can_bind(self) -> Bool Never! { !self.mut_borrow && (!self.borrow || self.clone || self.arc_clone) }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9689
    fn take_for_binding(self: &Self, replacement: TExpr) -> TExpr Never! {
        replacement :: if self.fact_channel().exclusivity is .Move {
            TExpr(ty: replacement.ty.clone(), kind: TExprKind.Move(^replacement))
        } else { ^replacement }
        value := replace(&self.value, ^replacement)
        if self.clone || self.arc_clone {
            value = TExpr(ty: value.ty.clone(), kind: TExprKind.Clone(^value, call_arg_copy_fact(self.arc_clone)))
            self.clone = false; self.arc_clone = false
        }
        if self.borrow || self.mut_borrow {
            value = TExpr(ty: value.ty.clone(), kind: TExprKind.Borrow(place: ^value, mutable: self.mut_borrow))
            self.borrow = false; self.mut_borrow = false
        }
        ^value
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9731
impl OrderedArg for TExternArg {
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9733
    fn value(self) -> TExpr Never! { self.value }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9737
    fn can_bind(self) -> Bool Never! { !self.mut_borrow }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9741
    fn take_for_binding(self: &Self, replacement: TExpr) -> TExpr Never! {
        value := replace(&self.value, ^replacement)
        if self.clone {
            value = TExpr(ty: value.ty.clone(), kind: TExprKind.Clone(^value, MirCopyFact.Materialize))
            self.clone = false
        }
        if self.mut_borrow {
            value = TExpr(ty: value.ty.clone(), kind: TExprKind.Borrow(place: ^value, mutable: true))
            self.mut_borrow = false
        }
        ^value
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9763
impl OrderedArg for TExpr {
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9765
    fn value(self) -> TExpr Never! { self }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9769
    fn can_bind(self) -> Bool Never! {
        // Keep non-scalar places in Core calls; computed owning values can bind.
        self.ty.is_scalar() || self.kind is .Call(..) | .MethodCall(..) | .StaticCall(..) | .ModuleCall(..)
            | .FnValue(..) | .CoreCall(..) | .ExternCall(..) | .HostCall(_) | .InlineBlock(_)
            | .Clone(..) | .StrLit(_) | .Print(_)
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9793
    fn take_for_binding(self: &Self, replacement: TExpr) -> TExpr Never! { replace(&self, ^replacement) }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9801
fn bind_arg_temporaries<A: OrderedArg>(args: &[A], order: [USize], ast_arg_count: USize, site: U32) -> [TStmt] Never! {
    offset :: args.len().saturating_sub(ast_arg_count)
    order := order.iter().map(fn(slot) { slot + offset }).collect<[USize]>()
    if offset > 0 { order.splice(0..0, 0..offset) }
    if order.is_empty() { return [] }
    bindable :: order.into_iter().filter(fn(slot) { args.get(slot).is_some_and(OrderedArg.can_bind) }).collect<[USize]>()
    if bindable.is_empty() { return [] }
    stmts := [TStmt].with_capacity(bindable.len() + 1)
    for slot in bindable {
        arg := args.get_mut(slot).expect("binder source-order slot must have a lowered argument")
        ast_slot :: slot.saturating_sub(offset)
        temp_slot :: if offset > 0 { slot } else { ast_slot }
        temp :: "{JET_PREFIX}arg{site}_{temp_slot}"
        ty :: arg.value().ty.clone()
        bound :: arg.take_for_binding(TExpr(ty: ty.clone(), kind: TExprKind.Local(TLocal.user(temp))))
        // Boundary conversions remain on the argument; temporary keeps raw type.
        stmts.push(TStmt.Let(name: ^temp, kw: "let", let_ty: TLetTy.inferred(), init: ^bound, gc_promotion: None, gc_transferred: false))
    }
    ^stmts
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:9873
fn compiler_fact_type(fact: String) -> Type Never! {
    if fact == {
        f if f == COMPILER_FACT_NAME -> Type.String
        f if f == COMPILER_FACT_FIELDS -> Type.List(Type.Named("FieldInfo"))
        f if f == COMPILER_FACT_RANGE -> Type.Named(TYPE_RANGE.to_string())
        f if f == COMPILER_FACT_DIMENSION -> Type.Named("DimensionInfo")
        f if f == COMPILER_FACT_STATES -> Type.List(Type.Named("StateInfo"))
        f if f == COMPILER_FACT_EFFECTS -> Type.Named("EffectInfo")
        f if f == COMPILER_BUILD_FACT_PROFILE -> Type.String
        _ -> Type.Named(TYPE_LAYOUT_INFO.to_string())
    }
}
