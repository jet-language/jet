//RS /// c109 Phase 14: lower a cross-module call's arguments against the callee's import
//RS /// signature, reproducing `emit_call_args`. Each arg's borrow/clone/fn-coercion is
//RS /// resolved from the sig param convention (the same `lower_one_call_arg` used by the
//RS /// plain-call path).
//RS pub(crate) fn lower_module_args(
//RS     args: &[crate::AST::CallArg],
