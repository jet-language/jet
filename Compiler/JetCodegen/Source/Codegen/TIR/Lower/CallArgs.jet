//RS /// c109 Phase 14: lower one FFI extern-call argument. The value is wrapped in
//RS /// `(…).clone()` when the arg carries `implicit_clone`, OR when its param is a
//RS /// non-scalar `Read`-convention type and `implicit_clone` is NOT already set (the AST
//RS /// `if a.flags.implicit_clone { … } else if … } if let Some((_, ty)) = sig … if
//RS /// !ty.is_scalar() && !implicit_clone`). The Arc (`shared_auto_clone`) form is excluded
//RS /// from the subset, so it never reaches here.
//RS pub(crate) fn lower_extern_call_arg(
//RS     a: &crate::AST::CallArg,
//RS     conv: Option<(AccessConvention, Type)>,
//RS     env: &mut LowerEnv,
//RS     cx: &Cx,
//RS ) -> TExternArg {
//RS     let Some((convention, ty)) = conv.as_ref() else {
//RS         return invariant_extern_arg(a, "extern call argument has no resolved parameter");
//RS     };
//RS     // D-CABI-CALLBACK1: the C bridge is still an extern call, but its callback
//RS     // argument needs the same stable function item / lambda wrapper as a direct
//RS     // C call. Preserve sema's fact instead of re-boxing it as `dyn Fn`.
//RS     let c_callback = a.flags.c_callback_symbol && callback_fn_type(ty).is_some();
//RS     if a.flags.c_callback_symbol && !c_callback {
//RS         return invariant_extern_arg(a, "C callback argument has a non-function signature");
//RS     }
//RS     // Lower through the shared call-argument path so an owning resource move
//RS     // becomes `ResourceTake` and invalidates the source slot before the native
//RS     // close call. A plain `lower_expr` would read/clone the handle, then move
//RS     // the clone and leave the original for the drop edge.
//RS     let value = lower_call_arg_value(a, conv.clone(), env, cx);
//RS     let mut_borrow = *convention == AccessConvention::Write;
//RS     let non_scalar_param = !ty.is_scalar() && !c_callback;
//RS     // `(…).clone()` is emitted once: either the explicit implicit_clone flag, or
//RS     // the non-scalar-param clone (when implicit_clone is false). The two never stack —
//RS     // the AST applies the param clone only `&& !a.flags.implicit_clone`.
//RS     let clone = *convention == AccessConvention::Read
//RS         && !is_opaque_handle_type(ty, cx)
//RS         && (a.flags.implicit_clone || (non_scalar_param && !a.flags.implicit_clone));
//RS     TExternArg {
//RS         value,
//RS         clone,
//RS         mut_borrow,
//RS     }
