// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:146
fn template_never_expr(name: String) -> TExpr Never! {
    TExpr(ty: Type.Named(TYPE_NEVER.to_string()), kind: TExprKind.Local(TLocal.user(^name)))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:155
fn template_reference_expr(name: String, env: LowerEnv) -> TExpr Never! {
    bare_name := name.trim_start_matches('$') // #4303
    marked_name :: "${bare_name}"
    local_name :: if env.locals.contains_key(name) { name }
        else if env.locals.contains_key(bare_name) { bare_name }
        else if env.locals.contains_key(marked_name) { marked_name } else { name }
    value := template_never_expr(local_name.to_string())
    if env.ty_of(local_name) == Some(ty) {
        value.ty = ^ty
        value.kind = TExprKind.Local(env.local_of(local_name))
    }
    ^value
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:175
fn template_expr_root(expr: Expr) -> String? Never! {
    if expr == {
        .Ident(name, _) | .ComptimeName(name, ..) -> Some(name)
        .Field(base, ..) | .OptField(base, ..) -> template_expr_root(base)
        .Paren(inner, _) -> template_expr_root(inner)
        _ -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:184
fn lower_template_expr(expr: Expr, cx: Cx, env: &LowerEnv, template_vars: HashSet<String>) -> TExpr Never! {
    if expr == {
        .ComptimeName(name, ..) if cx.const_values.contains_key(name) -> lower_expr(expr, cx, &env)
        .ComptimeName(value: Some(_), ..) -> lower_expr(expr, cx, &env)
        .ComptimeName(name, ..) -> template_reference_expr(name, env)
        .Ident(name, _) if name.starts_with('$') || template_vars.contains(name) -> template_reference_expr(name, env)
        .Field(base, member, _) if member.starts_with('$') || template_expr_root(base).is_some_and(fn(name) { template_vars.contains(name.trim_start_matches('$')) }) -> {
            recv :: lower_template_expr(base, cx, &env, template_vars)
            field := member.trim_start_matches('$') // #4303
            TExpr(ty: Type.Named(TYPE_NEVER.to_string()), kind: TExprKind.Field(recv: ^recv, field: field.to_string(), boxed: false))
        }
        .Str(parts, _) -> TExpr(ty: Type.String, kind: TExprKind.StrLit(parts.iter().map(fn(part) {
            if part == {
                .Lit(text) -> TStrPart.Lit(text.clone())
                .Interp(value, format) -> TStrPart.Interp(lower_template_expr(value, cx, &env, template_vars), format.clone())
            }
        }).collect()))
        .ListLit(values, _) -> TExpr(ty: Type.List(Type.Named(TYPE_NEVER.to_string())),
            kind: TExprKind.ListLit(values.iter().map(fn(value) { lower_template_expr(value, cx, &env, template_vars) }).collect()))
        .Paren(inner, _) -> lower_template_expr(inner, cx, &env, template_vars)
        _ -> lower_expr(expr, cx, &env)
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:242
fn lower_template_loop_expr(expr: Expr, cx: Cx, env: &LowerEnv, template_vars: HashSet<String>) -> TExpr Never! {
    if expr == .ListLit(values, _) {
        items := [TExpr]()
        all_names := true
        for value in values {
            name :: if value == {
                .Ident(name, _) | .ComptimeName(name, ..) -> name
                _ -> { all_names = false; break }
            }
            bare := name.trim_start_matches('$') // #4303
            items.push(TExpr(ty: Type.String, kind: TExprKind.CtLit(CtValue.Str(bare.to_string()))))
        }
        if all_names { return TExpr(ty: Type.List(Type.String), kind: TExprKind.ListLit(^items)) }
    }
    lower_template_expr(expr, cx, &env, template_vars)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:272
struct TemplateMarker { start: USize, end: USize, value: Bool }

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:278
fn scan_template_markers(source: String, template_vars: HashSet<String>) -> [TemplateMarker] Never! {
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:282
    fn ident(byte: U8) -> Bool Never! { byte.is_ascii_alphanumeric() || byte == 95 }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:285
    fn name_context(bytes: [U8], start: USize) -> Bool Never! {
        end := start
        while end > 0 && bytes[end - 1].is_ascii_whitespace() { end -= 1 }
        if end > 0 && bytes[end - 1] == 46 { return true }
        word_end :: end
        while end > 0 && ident(bytes[end - 1]) { end -= 1 }
        from_utf8(bytes[end..word_end]).is_ok_and(fn(word) {
            word is "fn" | "impl" | "struct" | "enum" | "type" | "trait" | "module" | "const"
        })
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:304
    fn skip_quoted(bytes: [U8], at: USize, quote: U8) -> USize Never! {
        at += 1
        while at < bytes.len() {
            if bytes[at] == {
                92 -> { at = at.saturating_add(2) }
                current if current == quote -> { return at + 1 }
                _ -> { at += 1 }
            }
        }
        bytes.len()
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:315
    fn scan_code(bytes: [U8], at: USize, stop_at_brace: Bool, value_context: Bool,
        template_vars: HashSet<String>, out: &[TemplateMarker]) -> USize Never! {
        while at < bytes.len() {
            if bytes[at] == {
                47 if bytes.get(at + 1) == Some(47) -> {
                    at += 2
                    while at < bytes.len() && bytes[at] != 10 { at += 1 }
                }
                47 if bytes.get(at + 1) == Some(42) -> {
                    at += 2
                    nested := 1
                    while at < bytes.len() && nested > 0 {
                        if bytes.get(at..at + 2).is_some_and(fn(pair) { pair == [47, 42] }) {
                            nested += 1; at += 2
                        } else if bytes.get(at..at + 2).is_some_and(fn(pair) { pair == [42, 47] }) {
                            nested -= 1; at += 2
                        } else { at += 1 }
                    }
                }
                34 -> { at = scan_string(bytes, at, template_vars, &out) }
                39 -> { at = skip_quoted(bytes, at, 39) }
                123 if value_context -> { at = scan_code(bytes, at + 1, true, true, template_vars, &out) }
                123 -> { at += 1 }
                125 if stop_at_brace -> { return at + 1 }
                byte if ident(byte) -> {
                    start :: at
                    at += 1
                    while at < bytes.len() && ident(bytes[at]) { at += 1 }
                    name :: from_utf8(bytes[start..at]).ok()
                    marker_end := at
                    field_chain := false
                    if name.is_some_and(fn(name) { template_vars.contains(name) }) {
                        loop {
                            if bytes.get(marker_end) != Some(46) { break }
                            field_start :: marker_end + 1
                            first :: if bytes.get(field_start) == { Some(first) -> first, None -> { break } }
                            if first == 36 || !ident(first) { break }
                            field_end := field_start + 1
                            while field_end < bytes.len() && ident(bytes[field_end]) { field_end += 1 }
                            marker_end = field_end
                            field_chain = true
                        }
                    }
                    if name == Some(name) {
                        if template_vars.contains(name) && (marker_end != at || bytes.get(at) != Some(46)) {
                            out.push(TemplateMarker(start: start, end: marker_end, value: value_context || field_chain))
                        }
                    }
                    at = marker_end
                }
                // D-NAME-SPLICE1=B: retain only bound $name splices later.
                36 -> {
                    start :: at
                    at += 1
                    while at < bytes.len() && ident(bytes[at]) { at += 1 }
                    if at > start + 1 {
                        out.push(TemplateMarker(start: start, end: at, value: value_context || !name_context(bytes, start)))
                    }
                }
                _ -> { at += 1 }
            }
        }
        bytes.len()
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:422
    fn scan_string(bytes: [U8], at: USize, template_vars: HashSet<String>, out: &[TemplateMarker]) -> USize Never! {
        at += 1
        while at < bytes.len() {
            if bytes[at] == {
                92 -> { at = at.saturating_add(2) }
                34 -> { return at + 1 }
                123 if bytes.get(at + 1) == Some(123) -> {
                    at += 2
                    while at < bytes.len() {
                        if bytes.get(at..at + 2).is_some_and(fn(pair) { pair == [125, 125] }) { at += 2; break }
                        at += 1
                    }
                }
                123 -> { at = scan_code(bytes, at + 1, true, true, template_vars, &out) }
                _ -> { at += 1 }
            }
        }
        bytes.len()
    }
    markers := [TemplateMarker]()
    _ :: scan_code(source.as_bytes(), 0, false, false, template_vars, &markers)
    ^markers
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:463
fn template_marker_base(source: String, start: USize) -> String? Never! {
    before := source.get(..start)?.strip_suffix('.')? // #4303
    end :: before.len()
    begin :: before.char_indices().rev().find_map(fn(pair) {
        (index, character) :: pair
        (!character.is_ascii_alphanumeric() && character != '_').then_some(index + character.len_utf8())
    }).unwrap_or(0)
    (begin < end).then(fn() { before[begin..end].to_string() })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:477
fn template_path_expr(path: String, env: LowerEnv, template_vars: HashSet<String>) -> TExpr? Never! {
    segments := path.split('.')
    root_segment :: segments.next()?
    explicit_root :: root_segment.starts_with('$')
    root := root_segment.trim_start_matches('$') // #4303
    if root.is_empty() || (!explicit_root && !template_vars.contains(root)
        && !env.locals.contains_key(root) && !env.locals.contains_key("${root}")) { return None }
    root_name :: if explicit_root { "${root}" } else { root.to_string() }
    value := template_reference_expr(root_name, env)
    for field in segments {
        field := field.trim_start_matches('$') // #4303
        if field.is_empty() { return None }
        value = TExpr(ty: Type.Named(TYPE_NEVER.to_string()), kind: TExprKind.Field(recv: ^value, field: field.to_string(), boxed: false))
    }
    Some(^value)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:517
fn template_marker_expr(source: String, marker: TemplateMarker, cx: Cx, env: LowerEnv, template_vars: HashSet<String>) -> TExpr Never! {
    marker_text := source[marker.start..marker.end] // #4303
    if marker_text.contains('.') {
        if template_path_expr(marker_text, env, template_vars) == Some(value) { return ^value }
    }
    marker_name := marker_text.strip_prefix('$').unwrap_or(marker_text) // #4303
    if template_vars.contains(marker_name) { return template_reference_expr(marker_name, env) }
    if template_marker_base(source, marker.start) == Some(base) {
        marked_base :: "${base}"
        if template_vars.contains(base) || env.locals.contains_key(base) || env.locals.contains_key(marked_base) {
            return TExpr(ty: Type.Named(TYPE_NEVER.to_string()), kind: TExprKind.Field(
                recv: template_reference_expr(base, env), field: source[marker.start + 1..marker.end].to_string(), boxed: false))
        }
    }
    _ :: cx
    template_reference_expr(source[marker.start..marker.end], env)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:557
// Unbound $build and field.$name compiler facts remain verbatim source.
fn template_splice_is_bound(source: String, marker: TemplateMarker, env: LowerEnv, template_vars: HashSet<String>) -> Bool Never! {
    bare :: if source[marker.start..marker.end].strip_prefix('$') == { Some(bare) -> bare, None -> { return true } }
    bound :: fn(name: String) { template_vars.contains(name) || env.locals.contains_key(name) }
    bound(bare) && !template_marker_base(source, marker.start).is_some_and(fn(base) { bound(base) })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:571
fn template_source(span: Span, cx: Cx, env: LowerEnv, template_vars: HashSet<String>) -> TemplateSource<TExpr>? Never! {
    source :: cx.src.get(span.start..span.end)?.to_string()
    holes :: scan_template_markers(source, template_vars).into_iter()
        .filter(fn(marker) { template_splice_is_bound(source, marker, env, template_vars) })
        .map(fn(marker) { TemplateHole(start: marker.start, end: marker.end,
            expr: template_marker_expr(source, marker, cx, env, template_vars),
            kind: if marker.value { TemplateHoleKind.Value } else { TemplateHoleKind.Name },
            span: Span.new(span.start + marker.start, span.start + marker.end)) }).collect()
    Some(TemplateSource(source: ^source, holes: ^holes, span: span))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:606
fn item_span(item: Item, cx: Cx) -> Span Never! {
    if item == {
        .Func(item) | .Struct(item) | .Enum(item) | .Distinct(item) | .TypeAlias(item)
        | .UnitFamily(item) | .Trait(item) | .Tag(item) | .EffectDecl(item) | .Impl(item)
        | .Const(item) | .Test(item) | .ExternRust(item) | .Module(item) | .CModule(item)
        | .CodeModule(item) -> item.span
        .ErrorConv(item) -> {
            line_start :: cx.src.get(..item.from_span.start).and_then(fn(source) { source.rfind('\n') }).map_or(0, fn(index) { index + 1 })
            start :: cx.src.get(line_start..item.from_span.start).and_then(fn(line) { line.rfind("impl ") })
                .map_or(item.from_span.start, fn(offset) { line_start + offset })
            Span.new(start, item.body_span.end)
        }
        .Migration(item) | .ProtocolDecl(item) | .UserDerive(item) | .TemplateLoop(item)
        | .GenericModule(item) | .ModuleAlias(item) | .MarkerDecl(item) | .FactDecl(item) -> item.span
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:648
fn lower_template_stmt(statement: Stmt, cx: Cx, env: &LowerEnv, template_vars: HashSet<String>) -> [TemplateItem<TExpr>] Never! {
    if statement == {
        .Val(binding) if !binding.name.is_empty() && binding.pattern.is_none() -> {
            name :: binding.name.clone()
            value :: lower_template_expr(binding.init, cx, &env, template_vars)
            env.bind(name, TLocal.user(name.clone()), Some(value.ty.clone()))
            [TemplateItem.Statement(TemplateStatement.Binding(name: ^name, value: ^value, span: statement.span()))]
        }
        .Expr(expr) -> [TemplateItem.Statement(TemplateStatement.Expr(value: lower_template_expr(expr, cx, &env, template_vars), span: statement.span()))]
        .ComptimeIf(cond, then_body, else_body, span, selected_then, ..) -> {
            then_body :: lower_template_stmts(then_body, cx, &env, template_vars)
            else_body :: if else_body == { Some(body) -> lower_template_stmts(body, cx, &env, template_vars), None -> [] }
            [TemplateItem.If(condition: lower_template_expr(cond, cx, &env, template_vars), then_body: ^then_body,
                else_body: ^else_body, selected: selected_then, span: span)]
        }
        .ComptimeBlock(body, ..) | .Impure(body, ..) | .Unsafe(body, ..) -> lower_template_stmts(body, cx, &env, template_vars)
        _ -> [TemplateItem.Invalid(construct: "unsupported checked template statement shape", span: statement.span())]
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:706
fn lower_template_stmts(statements: [Stmt], cx: Cx, env: &LowerEnv, template_vars: HashSet<String>) -> [TemplateItem<TExpr>] Never! {
    statements.iter().flat_map(fn(statement) { lower_template_stmt(statement, cx, &env, template_vars) }).collect()
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:718
fn lower_template_items(items: [DeriveBodyItem], body_span: Span, cx: Cx, env: &LowerEnv, template_vars: HashSet<String>) -> TemplateBody<TExpr> Never! {
    lowered := [TemplateItem<TExpr>]()
    for item in items {
        if item == {
            .Item(item) -> {
                span :: item_span(item, cx)
                lowered_item :: if template_source(span, cx, env, template_vars) == {
                    Some(source) -> TemplateItem.Item(^source)
                    None -> TemplateItem.Invalid(construct: "template item source span is outside the source file", span: span)
                }
                lowered.push(^lowered_item)
            }
            .Stmt(statement) -> { lowered.extend(lower_template_stmt(statement, cx, &env, template_vars)) }
            .Loop(var, source, body, span, ..) -> {
                source :: lower_template_loop_expr(source, cx, &env, template_vars)
                element_ty :: if source.ty == { .List(inner) | .FixedList(elem: inner, ..) -> Some(inner.clone()), _ -> None }
                loop_env := clone_env(env)
                loop_env.bind(var, TLocal.user(var.clone()), ^element_ty)
                nested_vars := template_vars.clone()
                nested_vars.insert(var.clone())
                body :: lower_template_items(body, span, cx, &loop_env, nested_vars).items
                lowered.push(TemplateItem.Loop(var: var.clone(), source: ^source, body: ^body, span: span))
            }
        }
    }
    TemplateBody(items: ^lowered, span: body_span)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:778
fn is_ordering_comparator_expr(expr: Expr) -> Bool Never! {
    if expr == {
        .Paren(inner, _) -> is_ordering_comparator_expr(inner)
        .Binary(.Compare, ..) -> true
        .MethodCall(method: "compare", args, ..) if args.len() == 1 -> true
        .MethodCall(receiver, method: "then", args, ..) if args.len() == 1 -> is_ordering_comparator_expr(receiver)
        _ -> false
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:801
fn is_ordering_comparator_lambda(lam: Lambda) -> Bool Never! {
    if lam.params.len() != 2 { return false }
    tail :: if lam.body == {
        .Expr(expr) -> Some(expr)
        .Block(stmts) -> stmts.iter().rev().find_map(fn(stmt) {
            if stmt == { .Return(Some(expr), _) | .Expr(expr) -> Some(expr), _ -> None }
        })
    }
    tail.is_some_and(is_ordering_comparator_expr)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:819
fn lower_ordering_comparator_callback(lam: Lambda, cx: Cx, env: LowerEnv, params: [Type]) -> TExpr Never! {
    ordering :: Type.Named(TYPE_ORDERING.to_string())
    lowered :: lower_lambda_expecting_host_borrow_with_return(lam, cx, env, params, false, ordering)
    TExpr(ty: Type.Fn(params: params.to_vec(), ret: Some(^ordering), effect_bound: None,
        param_contract: None, call_metadata: None, return_view_provenance: None), kind: TExprKind.Lambda(^lowered))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:844
fn lower_named_collection_callback(expr: Expr, cx: Cx, env: LowerEnv, effective: Bool, params: [Type]?) -> TExpr? Never! {
    if (expr, params) == (.Lambda(lam), Some(params)) {
        if is_ordering_comparator_lambda(lam) { return Some(lower_ordering_comparator_callback(lam, cx, env, params)) }
        return None
    }
    name :: if expr == { .Ident(name, _) -> name, _ -> { return None } }
    if env.locals.contains_key(name) || cx.consts.contains_key(name) { return None }
    ty :: (if effective { cx.fn_types.get(name) } else { cx.fn_source_types.get(name) })?
    if !(ty is .Fn(..)) { return None }
    callable :: TExpr(ty: ty.clone(), kind: TExprKind.FnValue(kind: TFnValueKind.NamedFn(name: Some(name.clone()), lambda: None)))
    // Collection callbacks borrow inputs; retain one direct closure boundary.
    if params == Some(params) {
        return Some(TExpr(ty: callable.ty.clone(), kind: TExprKind.HostBorrowCallback(callable: ^callable, params: params.to_vec())))
    }
    Some(^callable)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:900
fn fixed_list_elem_compatible(actual: Type, want: Type) -> Bool Never! {
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:901
    fn canonical(ty: Type) -> Type Never! {
        if ty.erased_carrier() == { .IntN(signed: true, bits: 64) -> Type.Int, ty -> ^ty }
    }
    canonical(actual) == canonical(want)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:917
fn lambda_body_ty(lam: Lambda, cx: Cx, env: LowerEnv) -> Type Never! { lambda_body_ty_expecting(lam, cx, env, None) }
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:924
fn spawn_body_result_ty(lam: Lambda, cx: Cx, env: LowerEnv) -> Type Never! { lambda_body_ty(lam, cx, env) }
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:931
fn spawn_body_carrier_ty(lam: Lambda, cx: Cx, env: LowerEnv) -> Type Never! {
    t :: spawn_body_result_ty(lam, cx, env)
    checked_carrier :: lam.meta.fallible_carrier.or_else(fn() { if lam.meta.fallible_propagation { env.ret_ty } else { None } })
    if checked_carrier == Some(carrier) {
        return if carrier == {
            .Result(err, ..) -> Type.Result(ok: if t == { .Result(ok, ..) -> ok.clone(), other -> other.clone() }, err: err.clone())
            .Option(_) -> Type.Option(if t == { .Option(inner) -> inner.clone(), other -> other.clone() })
            other -> other.clone()
        }
    }
    if t == {
        .Result(..) | .Option(_) -> ^t
        t -> Type.Result(ok: ^t, err: Type.Named(TYPE_ERR.to_string()))
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:968
fn lambda_body_ty_expecting(lam: Lambda, cx: Cx, env: LowerEnv, expected_params: [Type]?) -> Type Never! {
    lambda_body_ty_expecting_with_return(lam, cx, env, expected_params, None)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:981
fn lambda_body_ty_expecting_with_return(lam: Lambda, cx: Cx, env: LowerEnv, expected_params: [Type]?, expected_return: Type?) -> Type Never! {
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:988
    fn bind_params(lam: Lambda, env: LowerEnv, expected_params: [Type]?, expected_return: Type?) -> LowerEnv Never! {
        lam_env := clone_env(env)
        lam_env.fallback_subject = false
        lam_env.ret_ty = expected_return.cloned().or_else(fn() { lambda_explicit_failure_carrier(lam) }).or_else(fn() { lam.meta.fallible_carrier.clone() })
        for (i, p) in lam.params.iter().enumerate() {
            ty :: p.ty.clone().or_else(fn() { expected_params.and_then(fn(ps) { ps.get(i) }).cloned() })
            lam_env.locals.insert(p.name.clone(), (TLocal.user(p.name), ^ty))
        }
        ^lam_env
    }
    // A probe must restore both callback entries and their site indexes.
    saved_spawn_lambdas :: take(&cx.jit_spawn_lambdas.borrow_mut())
    saved_spawn_sites :: cx.jit_spawn_sites.borrow().clone()
    body_ty :: with_lambda_body_expr_cache(fn() {
        if lam.body == {
            .Expr(e) -> {
                lam_env := bind_params(lam, env, expected_params, expected_return)
                lower_expr(e, cx, &lam_env).ty
            }
            .Block(stmts) -> {
                lam_env := bind_params(lam, env, expected_params, expected_return)
                if lambda_block_tail(stmts) == {
                    Some((prefix, tail)) -> {
                        _ :: lower_stmts(prefix, cx, &lam_env)
                        if tail == { .Return(Some(e), _) | .Expr(e) -> lower_expr(e, cx, &lam_env).ty, _ -> unit_type() }
                    }
                    None -> unit_type()
                }
            }
        }
    })
    cx.jit_spawn_lambdas.borrow_mut().set(^saved_spawn_lambdas)
    cx.jit_spawn_sites.borrow_mut().set(^saved_spawn_sites)
    ^body_ty
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:1049
fn lower_method_args(args: [CallArg], sig: [(AccessConvention, Type)], env: &LowerEnv, cx: Cx) -> [TCallArg] Never! {
    args.iter().enumerate().map(fn(pair) {
        (i, a) :: pair
        if sig.get(i) == {
            Some((convention, ty)) -> lower_one_call_arg(a, Some((convention, ty.clone())), &env, cx)
            None -> invariant_call_arg(a, "method call argument {i + 1} has no resolved parameter")
        }
    }).collect()
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:1078
fn lower_call_arg_value(a: CallArg, conv: (AccessConvention, Type)?, env: &LowerEnv, cx: Cx) -> TExpr Never! {
    if a.flags.c_callback_symbol && !conv.is_some_and(fn(pair) { callback_fn_type(pair.1).is_some() }) {
        return invariant_arg_value(a, "C callback argument has no function signature")
    }
    saved_binder_refs :: env.binder_refs.clone()
    if !a.flags.binder_refs.is_empty() {
        site :: if a.flags.binder_site == { Some(site) -> site, None -> { return invariant_arg_value(a, "call argument binder has no site") } }
        for (name, slot, ty) in a.flags.binder_refs {
            temp :: "{JET_PREFIX}arg{site}_{slot}"
            env.binder_refs.insert(name.clone(), (^temp, ty.clone()))
        }
    }
    arg_cache_scope :: env.fallback_subject.then(ExprCacheScope.enter)
    fallback_subject :: env.fallback_subject
    env.fallback_subject = false
    value := if (a.expr, conv) == {
        (.Ident(name, _), Some((.Move, ty))) if env.is_resource(name) -> TExpr(ty: ty.clone(), kind: TExprKind.ResourceTake(env.resource_take_place(name)))
        (.Ident(name, _), Some((_, ty))) if a.flags.c_callback_symbol && callback_fn_type(ty).is_some() -> {
            callback_key :: if a.flags.c_callback_function_key == {
                Some(key) -> key
                None -> { return invariant_arg_value(a, "named C callback has no canonical function key") }
            }
            TExpr(ty: ty.clone(), kind: TExprKind.HostCall(THostCall.FnName(callback_key.clone())))
        }
        (.Ident(name, _), Some((_, ty))) if ty is .Fn(..) && !env.locals.contains_key(name)
            && !cx.consts.contains_key(name) && cx.fn_types.get(name).is_some_and(fn(fn_ty) { fn_ty is .Fn(..) }) -> {
            TExpr(ty: ty.clone(), kind: TExprKind.FnValue(kind: TFnValueKind.NamedFn(name: Some(name.clone()), lambda: None)))
        }
        (.Lambda(lam), Some((_, ty))) if a.flags.c_callback_symbol && callback_fn_type(ty).is_some() -> {
            if callback_fn_type(ty) == {
                Some(.Fn(params, ret, ..)) -> {
                    tl :: lower_lambda_expecting(lam, cx, env, Some(params))
                    name :: mangle("c_callback_{lam.span.start}_{lam.span.end}")
                    TExpr(ty: ty.clone(), kind: TExprKind.HostCall(THostCall.CCallback(symbol: ^name, lambda: ^tl,
                        ret: ret.cloned(), managed: a.flags.c_callback_managed, plan_digest: a.flags.c_callback_plan_digest.clone(),
                        callback_identity: a.flags.c_callback_identity.clone())))
                }
                _ -> invariant_arg_value(a, "C callback argument has a non-function signature")
            }
        }
        (.Lambda(lam), Some((_, ty))) if ty is .Fn(..) -> {
            tl :: lower_lambda_expecting_callable(lam, cx, env, ty)
            TExpr(ty: ty.clone(), kind: TExprKind.Lambda(^tl))
        }
        (.Field(..) | .Index(..), Some((.Write, _))) if a.convention == AccessConvention.Write -> lower_expr_as_mut_place(a.expr, cx, &env)
        _ -> lower_expr(a.expr, cx, &env)
    }
    if value.kind is .Absent {
        if conv == Some((_, want)) { if want is .Option(_) { value.ty = want.clone() } }
    }
    env.fallback_subject = fallback_subject
    env.binder_refs = ^saved_binder_refs
    // arg_cache_scope's lexical lifetime covers the entire lowering.
    ^value
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:1199
fn lower_one_call_arg(a: CallArg, conv: (AccessConvention, Type)?, env: &LowerEnv, cx: Cx) -> TCallArg Never! {
    if a.flags.c_callback_symbol && !conv.is_some_and(fn(pair) { callback_fn_type(pair.1).is_some() }) {
        return invariant_call_arg(a, "C callback argument has no function signature")
    }
    template_items :: a.flags.template_items.map(fn(items) {
        template_cache_scope :: env.fallback_subject.then(ExprCacheScope.enter)
        template_env := clone_env(env)
        template_env.fallback_subject = false
        lower_template_items(items, a.span, cx, &template_env, HashSet<String>.new())
    })
    resource_move :: if (a.expr, conv) == { (.Ident(name, _), Some((.Move, _))) -> env.is_resource(name), _ -> false }
    // Binder defaults cannot reuse a worklist value lacking declaration-slot refs.
    value := if template_items.is_some() {
        TExpr(ty: Type.Named(INTERNAL_UNIT_TYPE.to_string()), kind: TExprKind.Unit)
    } else {
        cached :: if a.flags.binder_refs.is_empty() && !a.flags.c_callback_symbol { take_scheduled_expr(a.expr, cx) } else { None }
        cached.unwrap_or_else(fn() { lower_call_arg_value(a, conv.clone(), &env, cx) })
    }
    if (a.expr, value.kind) == (.Ident(name, _), .Local(local)) {
        ty :: env.ty_of(name).or_else(fn() {
            a.flags.binder_refs.iter().find(fn(binding) { binding.0 == name }).map(fn(binding) { binding.2.clone() })
        })
        if ty == {
            Some(ty) -> { value = TExpr(ty: ^ty, kind: TExprKind.Local(local)) }
            None -> { return invariant_call_arg(a, "call argument local has no resolved type") }
        }
    }
    // Capture fixed-list widening before contextual retagging erases the shape.
    widen_to_vec :: if (value.ty, conv.map(fn(pair) { pair.1 })) == {
        (.FixedList(elem: arg_elem, ..), Some(.List(param_elem))) -> fixed_list_elem_compatible(arg_elem, param_elem)
        _ -> false
    }
    if conv == Some((_, want)) {
        if want == {
            .List(_) if !free_type_params(want).is_empty() -> {}
            .List(_) | .FixedList(..) -> { value = preserve_typed_list_shape(^value, want, cx) }
            .Option(_) -> { value = box_present_trait_payload(^value, want, cx) }
            _ -> {}
        }
    }
    web_noncopy_int :: cx.web_wasm_noncopy_int && if value.ty == {
        .Int -> true
        .InlineRange(base, ..) -> base is .Int
        _ -> false
    }
    clone :: !resource_move && !is_opaque_handle_type(value.ty, cx) && (web_noncopy_int || a.flags.implicit_clone || if (a.expr, conv) == {
        (.Ident(name, _), None | Some((.Move, _))) -> env.is_borrowed(name) && env.ty_of(name).is_some_and(fn(ty) { !ty.is_scalar() })
        _ -> false
    })
    arc_clone :: a.flags.shared_auto_clone
    fn_coerce :: if conv == {
        Some((_, ty)) if a.flags.c_callback_symbol && callback_fn_type(ty).is_some() -> None
        Some((_, ty)) if ty is .Fn(..) -> {
            already_carrier :: ast_arg_is_named_fn_value(a.expr, cx, env)
                || if a.expr == { .Ident(name, _) -> env.ty_of(name).is_some_and(fn(t) { t is .Fn(..) }), _ -> false }
                || if value.kind == { .Lambda(lam) -> lam.boxed || lam.rc || lam.arc, _ -> false }
            Some(TFnCoerce(ty: ty.clone(), already_boxed: already_carrier))
        }
        _ -> None
    }
    widen_to_union :: if conv == {
        Some((_, want)) if want is .Union(members) && members.iter().any(fn(m) { m == value.ty }) -> Some(want.clone())
        _ -> None
    }
    box_as_trait :: if (value.ty, conv.map(fn(pair) { pair.1 })) == {
        (.TraitObject(_), _) -> None
        (.Named(concrete) | .Apply(name: concrete, ..), Some(want)) -> {
            trait_name :: if want == {
                .TraitObject(names) if names.len() == 1 -> names.first()
                .Named(name) if cx.trait_names.contains(name) -> Some(name)
                _ -> None
            }
            trait_name.filter(fn(trait_name) { trait_name != concrete }).cloned().map(fn(name) { Type.TraitObject([name]) })
        }
        _ -> None
    }
    (borrow, mut_borrow) :: if conv == {
        Some((.Read, t)) if !t.is_scalar() && !(a.flags.c_callback_symbol && callback_fn_type(t).is_some()) -> (true, false)
        Some((.Write, _)) -> (false, true)
        _ -> (false, false)
    }
    if conv is Some((.Move, _)) && !clone && !arc_clone && !(value.kind is .Move(_) | .ResourceTake(_)) {
        value = TExpr(ty: value.ty.clone(), kind: TExprKind.Move(^value))
    }
    TCallArg(value: ^value, template_items: ^template_items, borrow: borrow, mut_borrow: mut_borrow,
        clone: clone, arc_clone: arc_clone, fn_coerce: ^fn_coerce, widen_to_vec: widen_to_vec,
        widen_to_union: ^widen_to_union, box_as_trait: ^box_as_trait)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:1409
fn lower_module_args(args: [CallArg], sig: [(AccessConvention, Type)]?, env: &LowerEnv, cx: Cx) -> [TCallArg] Never! {
    sig :: if sig == {
        Some(sig) -> sig
        None -> { return args.iter().map(fn(arg) { invariant_call_arg(arg, "module call has no resolved signature") }).collect() }
    }
    args.iter().enumerate().map(fn(pair) {
        (i, a) :: pair
        if sig.get(i) == {
            Some((convention, ty)) -> lower_one_call_arg(a, Some((convention, ty.clone())), &env, cx)
            None -> invariant_call_arg(a, "module call argument {i + 1} has no resolved parameter")
        }
    }).collect()
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:1441
fn lower_extern_call_arg(a: CallArg, conv: (AccessConvention, Type)?, env: &LowerEnv, cx: Cx) -> TExternArg Never! {
    (convention, ty) :: if conv == { Some(pair) -> pair, None -> { return invariant_extern_arg(a, "extern call argument has no resolved parameter") } }
    c_callback :: a.flags.c_callback_symbol && callback_fn_type(ty).is_some()
    if a.flags.c_callback_symbol && !c_callback { return invariant_extern_arg(a, "C callback argument has a non-function signature") }
    // Shared path consumes owning resource slots before the native close call.
    value :: lower_call_arg_value(a, conv.clone(), &env, cx)
    mut_borrow :: convention == AccessConvention.Write
    non_scalar_param :: !ty.is_scalar() && !c_callback
    clone :: convention == AccessConvention.Read && !is_opaque_handle_type(ty, cx)
        && (a.flags.implicit_clone || (non_scalar_param && !a.flags.implicit_clone))
    TExternArg(value: ^value, clone: clone, mut_borrow: mut_borrow)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:1482
fn ast_arg_is_named_fn_value(e: Expr, cx: Cx, env: LowerEnv) -> Bool Never! {
    if e == .Ident(name, _) {
        if !env.locals.contains_key(name) && !cx.consts.contains_key(name) {
            return cx.fn_types.get(name).is_some_and(fn(ty) { ty is .Fn(..) })
        }
    }
    false
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:1514
// Policy-bearing compiler tags survive; ordinary fact tags erase for dispatch.
fn builtin_dispatch_ty(ty: Type) -> Type Never! {
    if ty == {
        .Tagged(marker: .Internal(.SharedGuardRead | .SharedGuardEdit | .CoreCryptoNominal), inner) -> ^ty
        .Tagged(inner, ..) -> builtin_dispatch_ty(^inner)
        .Apply(name, args) if name == TYPE_LIST && args.len() == 1 -> {
            element :: args.pop().expect("checked one-element List")
            Type.List(builtin_dispatch_ty(^element))
        }
        other -> ^other
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:1553
// Deliberately partial: callers use None for fields as a meaningful fact.
fn tir_recv_jet_ty(e: Expr, env: LowerEnv) -> Type? Never! {
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:1554
    fn literal_ty(expr: Expr) -> Type? Never! {
        if expr == {
            .Int(..) -> Some(Type.Int)
            .Float(_, _, _, _) -> Some(Type.Float)
            .Bool(_, _) -> Some(Type.Bool)
            .Char(_, _) -> Some(Type.Char)
            .Str(_, _) -> Some(Type.String)
            _ -> None
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:1565
    fn set_constructor_elem(expr: Expr, env: LowerEnv) -> Type? Never! {
        if expr == {
            .ListLit(items, _) -> items.first().and_then(literal_ty)
            .Ident(name, _) -> if env.ty_of(name) == {
                Some(.List(elem)) | Some(.FixedList(elem, ..)) -> Some(^elem)
                _ -> None
            }
            _ -> None
        }
    }
    if e == {
        .Paren(inner, _) | .Copy(inner, _) -> tir_recv_jet_ty(inner, env)
        .Binary(.Compare, _, _, _) -> Some(Type.Named(TYPE_ORDERING.to_string()))
        .Ident(name, _) -> env.ty_of(name).map(builtin_dispatch_ty)
        .ComptimeName(name, value, ..) -> env.ty_of(name).or_else(fn() { value.map(CtValue.jet_type) }).map(builtin_dispatch_ty)
        .Str(_, _) -> Some(Type.String)
        .Char(_, _) -> Some(Type.Char)
        .TupleLit(_, _, Some(ty)) -> Some(builtin_dispatch_ty(ty.clone()))
        .Try(inner, ..) -> tir_recv_jet_ty(inner, env).map(fn(ty) {
            if ty == {
                .Result(ok, ..) -> builtin_dispatch_ty(^ok)
                .Option(inner) -> builtin_dispatch_ty(^inner)
                other -> ^other
            }
        })
        .MethodCall(receiver, method, args, recv_type, resolved_ret, ..) -> {
            if recv_type == Some("SQL") {
                if method == {
                    "template" -> { return Some(Type.String) }
                    "params" -> { return Some(Type.List(Type.Named(TYPE_DB_VALUE.to_string()))) }
                    _ -> {}
                }
            }
            if recv_type == Some("HTTPResponse") {
                ret :: if method == {
                    "cookies" | "redirect_history" -> Some(Type.List(Type.String))
                    "timings" -> Some(Type.List(Type.Int))
                    _ -> None
                }
                if ret == Some(ret) { return Some(builtin_dispatch_ty(^ret)) }
            }
            if resolved_ret == Some(ty) { return Some(builtin_dispatch_ty(ty.clone())) }
            if receiver == .Ident(name, _) {
                if !env.locals.contains_key(name) && method == "from" && (name == TYPE_SET || name == TYPE_RANK) && args.len() == 1 {
                    elem :: set_constructor_elem(args[0].expr, env)?
                    return Some(Type.Apply(name: name.clone(), args: [^elem]))
                }
                if !env.locals.contains_key(name) && name == TYPE_BYTES && ((method == "new" && args.len() == 0)
                    || ((method == "from" || method == "with_capacity") && args.len() == 1)) {
                    return Some(Type.Named(TYPE_BYTES.to_string()))
                }
            }
            if tir_recv_jet_ty(receiver, env) == Some(recv_ty) {
                if builtin_method_return(recv_ty, method, args.len(), false) == Some(Some(ret)) { return Some(builtin_dispatch_ty(^ret)) }
            }
            // Checked owner facts recover Path/sketch carriers for outer dispatch.
            if recv_type == Some(handle) {
                receiver_ty :: Type.Named(handle.clone())
                if sketch_method_return(receiver_ty, method, args) == Some(Some(ret)) { return Some(builtin_dispatch_ty(^ret)) }
                if handle_method_op(handle, method, args.len()).is_some() {
                    ret :: handle_method_return_ty(handle, method, args.len(), receiver_ty, None)
                    return Some(builtin_dispatch_ty(^ret))
                }
            }
            if method == "chars" { return Some(Type.List(Type.Char)) }
            if method == METHOD_VIEW {
                if tir_recv_jet_ty(receiver, env) == Some(list_ty) {
                    elem :: if list_ty == { .List(e) -> Some(^e), .FixedList(elem, ..) -> Some(^elem), _ -> None }
                    if elem == Some(elem) { return Some(Type.Apply(name: "View", args: [^elem])) }
                }
                return None
            }
            tir_recv_jet_ty(receiver, env)
        }
        _ -> None
    }
}
