// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:27
// D-UNIONTYPE1=A: inject a member into the compiler-generated union enum.
fn maybe_widen_expr_to_union(value: TExpr, want: Type) -> TExpr Never! {
    if want == {
        .Union(members) if members.iter().any(fn(m) { m == value.ty }) && !(value.ty is .Union(_)) -> {
            TExpr(ty: want.clone(), kind: TExprKind.EnumLit(
                enum_type: union_enum_name(members), variant: union_member_tag(value.ty),
                payload: TEnumPayload.Positional([TEnumArg(value: ^value, clone: false, boxed: false)])))
        }
        _ -> ^value
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:55
// S48: retype Val(concrete) to the optional trait slot so MIR boxes once.
fn box_present_trait_payload(value: TExpr, want: Type, cx: Cx) -> TExpr Never! {
    slot :: if want == { .Option(slot) -> slot, _ -> { return ^value } }
    trait_name :: if slot == {
        .TraitObject(names) if names.len() == 1 -> names[0]
        .Named(name) if cx.trait_names.contains(name) -> name
        _ -> { return ^value }
    }
    boxes :: if value.kind == {
        .Present(payload) -> if payload.ty == {
            .Named(concrete) | .Apply(name: concrete, ..) -> concrete != trait_name && !cx.trait_names.contains(concrete)
            _ -> false
        }
        _ -> false
    }
    if boxes { value.ty = Type.Option(Type.TraitObject([trait_name.clone()])) }
    ^value
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:82
// Only the final statement can be a tail, never a call preceding a loop.
fn lambda_block_tail(stmts: [Stmt]) -> ([Stmt], Stmt)? Never! {
    last_idx :: stmts.len().checked_sub(1)?
    last :: stmts[last_idx]
    if last == {
        .Return(Some(_), _) | .Expr(_) -> Some((stmts[..last_idx], last))
        _ -> None
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:91
fn callback_fn_type(ty: Type) -> Type? Never! {
    if ty == {
        .Fn(..) -> Some(ty)
        .Tagged(marker: .Internal(.CppCallbackAbi), inner) if inner is .Fn(..) -> Some(inner)
        _ -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/call_args.rs:106
fn is_opaque_handle_type(ty: Type, cx: Cx) -> Bool Never! {
    if ty == {
        .Named(name) -> cx.opaque_handles.contains(name)
        .Tagged(inner, ..) -> is_opaque_handle_type(inner, cx)
        _ -> false
    }
}
