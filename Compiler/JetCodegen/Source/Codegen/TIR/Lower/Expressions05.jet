use jet_foundation.AST.[Expr, Call, Type, AccessConvention, BinOp, StrPart, EnumLitArg]
use jet_foundation.Diagnostics.[Span]
use jet_foundation.MIR.[MirCopyFact]
use jet_foundation.Syntax
use jet_codegen.Codegen.TIR.[TExpr, TExprKind, TFnValueKind, TCallArg, TStrPart, THostCall, TModuleCallForm, TStmt, TStructExtra, TLocal]
use jet_codegen.Codegen.Context.[Cx]
use jet_codegen.Codegen.TIR.[LowerEnv]

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:5677-6795
// Call arm of lower_expr_inner; the canonical dispatcher invokes this body.
fn lower_expr_inner_call(call: &Call, cx: &Cx, env: &LowerEnv) -> TExpr {
    in_own_frame(fn() {
        if lower_raw_ok_call(call, cx, &env) == .Val(lowered) -> return lowered
        if lower_raw_err_call(call, cx, &env) == .Val(lowered) -> return lowered
        if call.name == Syntax.BUILTIN_CHANNEL && !cx.sigs.contains_key(call.name) && !env.locals.contains_key(call.name) && call.args.len() <= 1 {
            ty := call.resolved_ret ?? return invariant_violation_expr(call.name_span, "channel constructor without a resolved return type")
            args := loop arg in call.args -> lower_expr(arg.expr, cx, &env)
            widen_to_vec := loop _ in args -> false
            method := if call.args.is_empty() -> Syntax.INTERNAL_CHANNEL_NEW_METHOD else -> Syntax.INTERNAL_CHANNEL_BOUNDED_METHOD
            return core_call_expr(ty, "core.tasks", method, args, call.name_span, widen_to_vec)
        }
        if call.name == Syntax.KW_FREEZE && !cx.sigs.contains_key(call.name) && !env.locals.contains_key(call.name) && call.args.len() == 1 {
            return in_own_frame(fn() {
                source := call.args[0].expr
                if source == .Call(inner) {
                    if inner.name == Syntax.KW_FREEZE && inner.args.len() == 1 -> return lower_expr(source, cx, &env)
                }
                operand := lower_expr(source, cx, &env)
                view_owned_ty := view_copy_owned_type(operand.ty)
                if view_owned_ty == None {
                    if source == .Ident(name, _) {
                        if env.split_view_handle(name) == .Val(ty) -> view_owned_ty = view_copy_owned_type(ty)
                    }
                }
                string_view := if source == { .Ident(name, _) -> env.is_string_view_local(name) else -> false }
                is_view := view_owned_ty != None
                ty := view_owned_ty ?? operand.ty
                kind := if is_view || string_view -> TExprKind.MaterializeView(operand)
                else if operand.ty.is_compute_tensor_family() {
                    env.note_clone(ty)
                    TExprKind.ExplicitCopy(operand)
                } else {
                    env.note_clone(ty)
                    TExprKind.Clone(operand, MirCopyFact.Explicit)
                }
                TExpr{ty: ty, kind: kind}
            })
        }
        last_arg := call.args.last()
        has_policy := if last_arg == .Val(arg) -> arg.flags.callable_policy != None else -> false
        if call.name == "apply" && !cx.sigs.contains_key(call.name) && !env.locals.contains_key(call.name) && has_policy {
            target_expr := (last_arg ?? panic("checked above")).expr
            target_name := if target_expr == {
                .Ident(name, _) -> Val(name)
                .Paren(inner, _) -> if inner == { .Ident(name, _) -> Val(name) else -> None }
                else -> None
            }
            user_policy := None
            loop argument in call.args[0..<call.args.len().saturating_sub(1)] {
                if argument.expr == .Call(policy) {
                    if jet_foundation.AST.CallablePolicyChain.is_builtin(policy.name) -> continue
                    name := target_name ?? continue
                    wrapper := jet_foundation.AST.CallablePolicyChain.user_wrapper_name(policy.name, name)
                    if cx.sigs.contains_key(wrapper) {
                        user_policy = Val((wrapper, policy))
                        break
                    }
                }
            }
            if user_policy == .Val((wrapper, policy)) {
                callee := lower_expr(target_expr, cx, &env)
                policy_sig := cx.sigs.get(wrapper) ?? panic("sema materialized the user policy wrapper")
                target_arity := if callee.ty.without_user_tags() == { .Fn(params, _, _, _) -> Val(params.len()) else -> None }
                call_slot := None
                if target_arity == .Val(arity) {
                    if policy_sig.len().checked_sub(arity + 1) == .Val(index) {
                        if policy_sig.get(index) == .Val((_, slot)) {
                            if slot.without_user_tags() == { .Fn(_, _, _, _) -> true else -> false } -> call_slot = Val(slot)
                        }
                    }
                }
                named_target := if callee.kind == { .FnValue(.NamedFn(.Val(_), None)) -> true else -> false }
                if named_target {
                    if call_slot == .Val(slot) -> callee.ty = slot
                }
                policy_args := loop (index, argument) in policy.args.iter().enumerate() -> lower_one_call_arg(argument, policy_sig.get(index), &env, cx)
                policy_conventions := loop (index, _) in policy.args.iter().enumerate() -> if policy_sig.get(index) == .Val((convention, _)) -> convention else -> AccessConvention.Read
                capture_names := Set<String>{}
                loop argument in policy.args {
                    (reads, calls) := jet_sema.expr_free_reads_and_calls(argument.expr)
                    &capture_names.extend(reads)
                    &capture_names.extend(calls)
                }
                (reads, calls) := jet_sema.expr_free_reads_and_calls(target_expr)
                &capture_names.extend(reads)
                &capture_names.extend(calls)
                sorted_names := capture_names.iter().collect()
                &sorted_names.sort()
                captures := sorted_names.iter().filter_map(fn(name) {
                    if !env.locals.contains_key(name) -> return None
                    ty := env.ty_of(name) ?? panic("checked policy capture has a type")
                    Val((name, env.local_of(name).name, ty))
                }).collect()
                fn_type := callee.ty
                return TExpr{ty: fn_type, kind: TExprKind.FnValue{kind: TFnValueKind.Policy{fn_type: fn_type, policy_args: policy_args, policy_conventions: policy_conventions, wrapper_name: Val(wrapper), captures: captures, callee: callee}}}
            }
            return lower_expr(target_expr, cx, &env)
        }
        builtin_approx := call.name == Syntax.BUILTIN_APPROX && !cx.sigs.contains_key(call.name) && !env.locals.contains_key(call.name)
        if (call.widen_approx || builtin_approx) && call.args.len() == 1 {
            return in_own_frame(fn() {
                source := lower_expr(call.args[0].expr, cx, &env)
                op := jet_codegen.Codegen.TIR.resolve_numeric_conversion_op("Float", "Int") ?? panic("Float.from_int is a registered numeric conversion")
                TExpr{ty: Type.Float, kind: TExprKind.NumericMethod{recv: source, op: op}}
            })
        }
        if call.name == "measurement" && !cx.sigs.contains_key(call.name) && !env.locals.contains_key(call.name) && call.args.len() == 2 {
            return in_own_frame(fn() {
                args := loop argument in call.args -> lower_expr(argument.expr, cx, &env)
                TExpr{ty: Type.Apply{name: Syntax.TYPE_MEASUREMENT, args: [Type]{Type.Float}}, kind: TExprKind.PreciseBuiltin{type_name: Syntax.TYPE_MEASUREMENT, func: "new", args: args}}
            })
        }
        if env.locals.contains_key(call.name) && !cx.consts.contains_key(call.name) && !cx.sigs.contains_key(call.name) {
            return in_own_frame(fn() {
                callee_ty := env.ty_of(call.name) ?? unit_type()
                callee_t := TExpr{ty: callee_ty, kind: TExprKind.Local(env.local_of(call.name))}
                callee_expr := Expr.Ident(call.name, call.name_span)
                lower_fn_value_call(Val(callee_expr), callee_t, call.args, U32.from_int(call.name_span.start), cx, &env)
            })
        }
        if call.name == Syntax.RESOURCE_CLOSE && call.args.len() == 1 {
            return in_own_frame(fn() {
                source := call.args[0].expr
                resource := if source == {
                    .Ident(name, _) -> if env.is_resource(name) -> TExpr{ty: env.ty_of(name) ?? unit_type(), kind: TExprKind.ResourceTake(env.resource_take_place(name))} else -> lower_expr(source, cx, &env)
                    else -> lower_expr(source, cx, &env)
                }
                already_moved := if resource.kind == { .Move(_) | .ResourceTake(_) -> true else -> false }
                if call.args[0].convention == AccessConvention.Move && !already_moved -> resource = TExpr{ty: resource.ty, kind: TExprKind.Move(resource)}
                TExpr{ty: unit_type(), kind: TExprKind.Close(resource)}
            })
        }
        typed_kind := Syntax.typed_head_kind(call.name)
        if typed_kind == .Val(kind) {
            if kind.is_interpolated_template() && !cx.sigs.contains_key(call.name) {
                return in_own_frame(fn() {
                    literals := [String]{}
                    holes := [TExpr]{}
                    trusted_html := [Bool]{}
                    loop (i, arg) in call.args.iter().enumerate() {
                        if i % 2 == 0 {
                            lit := if arg.expr == {
                                .Str(parts, _) -> if parts.len() == 1 -> if parts[0] == { .Lit(s) -> s else -> "" } else -> ""
                                else -> ""
                            }
                            &literals.push(lit)
                        } else {
                            hole := lower_expr(arg.expr, cx, &env)
                            trusted := arg.flags.trusted_html
                            if trusted {
                                debug_assert(kind == Syntax.TypedHeadKind.HTML)
                                hole.ty = Type.Named(Syntax.TYPE_HTML)
                            }
                            &trusted_html.push(trusted)
                            &holes.push(hole)
                        }
                    }
                    ty := Type.Named(kind.internal_type_name())
                    if kind == Syntax.TypedHeadKind.HTML && holes.is_empty() -> return TExpr{ty: ty, kind: TExprKind.StrLit([TStrPart]{TStrPart.Lit(literals.first() ?? "")})}
                    TExpr{ty: ty, kind: TExprKind.HostCall(THostCall.TypedTextInterp{kind: kind, literals: literals, holes: holes, trusted_html: trusted_html})}
                })
            }
        }
        if call.name == Syntax.TYPE_REGEX && !cx.sigs.contains_key(call.name) && call.args.len() == 1 {
            return in_own_frame(fn() { core_call_expr(Type.Named(Syntax.TYPE_REGEX), "core.regex", "literal", [TExpr]{lower_expr(call.args[0].expr, cx, &env)}, call.name_span, [Bool]{false}) })
        }
        if call.name == Syntax.BUILTIN_PRINT && !cx.sigs.contains_key(call.name) -> return in_own_frame(fn() { print_args(call.args, cx, &env, call.name_span.start) })
        if call.name == Syntax.INTERNAL_DEBUG_TRACE && call.args.len() == 2 -> return in_own_frame(fn() { lower_debug_trace(call, cx, &env) })
        if call.name == Syntax.BUILTIN_CONSUME && !cx.sigs.contains_key(call.name) && !env.locals.contains_key(call.name) {
            return in_own_frame(fn() {
                arg := lower_expr(call.args[0].expr, cx, &env)
                TExpr{ty: unit_type(), kind: TExprKind.Drop(arg)}
            })
        }
        if call.name == Syntax.BUILTIN_EXPECT && !cx.sigs.contains_key(call.name) && !env.locals.contains_key(call.name) && call.args.len() == 1 {
            return in_own_frame(fn() {
                arg := lower_expr(call.args[0].expr, cx, &env)
                TExpr{ty: arg.ty, kind: TExprKind.Clone(arg, MirCopyFact.Materialize)}
            })
        }
        if !cx.sigs.contains_key(call.name) && !env.locals.contains_key(call.name) {
            if call.name == Syntax.BUILTIN_ASSERT {
                return in_own_frame(fn() {
                    (kind, loc) := lower_require_stop(call, cx, &env)
                    TExpr{ty: unit_type(), kind: TExprKind.RequireStop{kind: kind, loc: loc, always_stops: false}}
                })
            }
            if call.name == Syntax.BUILTIN_ASSERT_EQ {
                return in_own_frame(fn() {
                    (kind, loc) := lower_require_eq_stop(call, cx, &env)
                    TExpr{ty: unit_type(), kind: TExprKind.RequireStop{kind: kind, loc: loc, always_stops: false}}
                })
            }
            if call.name == Syntax.BUILTIN_PANIC {
                return in_own_frame(fn() {
                    (kind, loc) := lower_panic_stop(call.name_span, call.args, cx, &env)
                    TExpr{ty: unit_type(), kind: TExprKind.RequireStop{kind: kind, loc: loc, always_stops: true}}
                })
            }
        }
        if call.name == Syntax.BUILTIN_INPUT && !cx.sigs.contains_key(call.name) && !env.locals.contains_key(call.name) {
            return in_own_frame(fn() {
                prompt := if call.args.first() == .Val(arg) -> Val(lower_expr(arg.expr, cx, &env)) else -> None
                TExpr{ty: Type.Result{ok: Type.String, err: Type.Named(Syntax.TYPE_IO_ERROR)}, kind: TExprKind.AmbientInput{prompt: prompt}}
            })
        }
        overflow_builtin := call.name == Syntax.BUILTIN_WRAPPING || call.name == Syntax.BUILTIN_SATURATING || call.name == Syntax.BUILTIN_CHECKED || call.name == Syntax.INTERNAL_ARITHMETIC_CHECKED
        if overflow_builtin && !cx.sigs.contains_key(call.name) && !env.locals.contains_key(call.name) {
            if call.args.first() == .Val(arg) {
                if arg.expr == .Binary(op, l, r, _) {
                    return in_own_frame(fn() {
                        op_suffix := if op == { .Add -> "add" .Sub -> "sub" .Mul -> "mul" .Div -> "div" .Pow -> "pow" else -> "add" }
                        lhs := lower_expr(l, cx, &env)
                        rhs := lower_expr(r, cx, &env)
                        line := U32.from_int(cx.src_line_col(call.name_span.start).0)
                        result_ty := if call.name == Syntax.BUILTIN_CHECKED -> Type.Option(lhs.ty) else -> lhs.ty
                        prefix := if call.name == Syntax.INTERNAL_ARITHMETIC_CHECKED -> "checked_policy" else -> call.name
                        TExpr{ty: result_ty, kind: TExprKind.OverflowOpt{prefix: prefix, op: op_suffix, line: line, policy: arg.flags.arithmetic_policy, lhs: lhs, rhs: rhs}}
                    })
                }
            }
        }
        // Foreign declarations resolve before unqualified module calls.
        if !env.locals.contains_key(call.name) {
            if cx.extern_funcs.get(call.name) == .Val(extern_fn) {
                wrapper := if extern_fn.c_abi && extern_fn.component == None && !call.name.contains("::") -> jet_sema.guest_import_wrapper_name(cx.module_alias, call.name) else -> extern_fn.wrapper
                c_abi := extern_fn.c_abi
                return in_own_frame(fn() {
                    sig := cx.sigs.get(call.name)
                    eargs := loop (i, arg) in call.args.iter().enumerate() {
                        conv := if sig == .Val(ps) -> ps.get(i) else -> None
                        lower_extern_call_arg(arg, conv, &env, cx)
                    }
                    return_type := extern_call_return_type(cx, call.name)
                    lowered := TExpr{ty: return_type, kind: TExprKind.ExternCall{symbol: cx.foreign_call_keys.get(call.name) ?? wrapper, c_abi: c_abi, args: eargs}}
                    if source_arg_order(call.args) == .Val(order) -> lowered = preserve_source_arg_order(lowered, order, call.args.len(), U32.from_int(call.name_span.start))
                    wrap_foreign_undo(lowered, cx.foreign_undos.get(call.name), U32.from_int(call.name_span.start), cx, &env)
                })
            }
            if cx.foreign_call_keys.get(call.name) == .Val(foreign_key) {
                return in_own_frame(fn() {
                    sig := cx.sigs.get(call.name)
                    eargs := loop (i, arg) in call.args.iter().enumerate() {
                        conv := if sig == .Val(ps) -> ps.get(i) else -> None
                        lower_extern_call_arg(arg, conv, &env, cx)
                    }
                    lowered := TExpr{ty: extern_call_return_type(cx, call.name), kind: TExprKind.ExternCall{symbol: foreign_key, c_abi: true, args: eargs}}
                    if source_arg_order(call.args) == .Val(order) -> lowered = preserve_source_arg_order(lowered, order, call.args.len(), U32.from_int(call.name_span.start))
                    wrap_foreign_undo(lowered, cx.foreign_undos.get(call.name), U32.from_int(call.name_span.start), cx, &env)
                })
            }
            inline_mangled := None
            if cx.inline_unqualified.get(env.fn_name) == .Val(scope) -> inline_mangled = scope.get(call.name)
            if inline_mangled == None -> inline_mangled = cx.unqualified_inline.get(call.name)
            if inline_mangled == .Val(mangled_key) {
                return in_own_frame(fn() {
                    undo := cx.foreign_undos.get(mangled_key)
                    sig := cx.sigs.get(mangled_key)
                    args := loop (i, arg) in call.args.iter().enumerate() {
                        conv := if sig == .Val(ps) -> ps.get(i) else -> None
                        lower_one_call_arg(arg, conv, &env, cx)
                    }
                    target_return := call_return_type_with_args(cx, mangled_key, call.type_args, args)
                    ret := unit_type()
                    try { ret :: module_call_source_return_type(cx, mangled_key, call.resolved_ret) } catch error { return invariant_violation_expr(call.name_span, error) }
                    mangled := demand_generic_free_function(cx, mangled_key, args, call.type_args) ?? mangled_key
                    lowered := TExpr{ty: ret, kind: TExprKind.ModuleCall{form: TModuleCallForm.InlineMangled{mangled: mangled}, target_return: Val(target_return), type_args: call.type_args, args: args}}
                    if source_arg_order(call.args) == .Val(order) -> lowered = preserve_source_arg_order(lowered, order, call.args.len(), U32.from_int(call.name_span.start))
                    wrap_foreign_undo(lowered, undo, U32.from_int(call.name_span.start), cx, &env)
                })
            }
            inline_file := None
            if cx.inline_unqualified_file.get(env.fn_name) == .Val(scope) -> inline_file = scope.get(call.name)
            if inline_file == None -> inline_file = cx.unqualified_file.get(call.name)
            if inline_file == .Val((rust_mod, fn_name)) {
                return in_own_frame(fn() {
                    undo := cx.foreign_undos.get("{rust_mod}::{fn_name}")
                    // GATE #4499: canonical tuple-key equality/hash.
                    sig := cx.import_sigs.get((call.name, fn_name))
                    args := loop (i, arg) in call.args.iter().enumerate() {
                        conv := if sig == .Val(ps) -> ps.get(i) else -> None
                        lower_one_call_arg(arg, conv, &env, cx)
                    }
                    target_return := None
                    try { target_return :: imported_module_call_target_return(cx, call.name, fn_name, call.resolved_ret) } catch error { return invariant_violation_expr(call.name_span, error) }
                    ret := unit_type()
                    try { ret :: module_call_source_return_type(cx, "{call.name}.{fn_name}", call.resolved_ret) } catch error { return invariant_violation_expr(call.name_span, error) }
                    lowered := TExpr{ty: ret, kind: TExprKind.ModuleCall{form: TModuleCallForm.Qualified{rust_mod: rust_mod, rust_fn: mangle(fn_name)}, target_return: target_return, type_args: call.type_args, args: args}}
                    if source_arg_order(call.args) == .Val(order) -> lowered = preserve_source_arg_order(lowered, order, call.args.len(), U32.from_int(call.name_span.start))
                    wrap_foreign_undo(lowered, undo, U32.from_int(call.name_span.start), cx, &env)
                })
            }
        }
        if (call.name == "zip" || call.name == "zip_short" || call.name == "zip_pad") && !cx.sigs.contains_key(call.name) && call.resolved_ret != None {
            return in_own_frame(fn() {
                is_pad := call.name == "zip_pad"
                inputs := [TExpr]{}
                fields := [String]{}
                fills := [TExpr]{}
                loop arg in call.args {
                    name := if arg.label == .Val((name, _)) -> Val(name) else -> None
                    if is_pad && (name == Val("fill") || name == Val("fills")) -> &fills.push(lower_expr(arg.expr, cx, &env))
                    else {
                        index := fields.len()
                        fallback := [String]{"a", "b", "c", "d", "e", "f"}.get(index) ?? "column_{index}"
                        &fields.push(name ?? fallback)
                        &inputs.push(lower_expr(arg.expr, cx, &env))
                    }
                }
                ret := call.resolved_ret ?? panic("zip result resolved by sema")
                if inputs.is_empty() -> return jet_codegen.Codegen.TIR.lower_empty_zip_family(ret, call.name, call.name_span)
                all := inputs.into_iter()
                first := &all.next() ?? panic("non-empty zip inputs")
                jet_codegen.Codegen.TIR.lower_zip_family(first, all.collect(), fills, fields, call.name, call.name_span, Val(ret))
            })
        }
        if !env.locals.contains_key(call.name) && call.name == Syntax.TYPE_DECIMAL && !cx.type_names.contains(call.name) {
            return in_own_frame(fn() {
                targs := loop arg in call.args -> lower_expr(arg.expr, cx, &env)
                TExpr{ty: Type.Named(call.name), kind: TExprKind.PreciseBuiltin{type_name: call.name, func: "from_str", args: targs}}
            })
        }
        if !env.locals.contains_key(call.name) && call.name == Syntax.TYPE_COMPLEX && !cx.type_names.contains(call.name) {
            return in_own_frame(fn() {
                targs := loop arg in call.args -> lower_expr(arg.expr, cx, &env)
                TExpr{ty: Type.Named(call.name), kind: TExprKind.PreciseBuiltin{type_name: call.name, func: "from_parts", args: targs}}
            })
        }
        if !env.locals.contains_key(call.name) && jet_sema.is_math_type(call.name) && !cx.type_names.contains(call.name) {
            return in_own_frame(fn() {
                targs := loop arg in call.args -> lower_expr(arg.expr, cx, &env)
                TExpr{ty: Type.Named(call.name), kind: TExprKind.MathBuiltin{type_name: call.name, func: "new", args: targs}}
            })
        }
        if call.range_checked && !env.locals.contains_key(call.name) {
            if call.args.first() == .Val(arg) {
                return in_own_frame(fn() { TExpr{ty: Type.Result{ok: Type.Named(call.name), err: Type.String}, kind: TExprKind.RangeCheckedCtor{name: call.name, arg: lower_expr(arg.expr, cx, &env)}} })
            }
        }
        if !env.locals.contains_key(call.name) {
            if cx.distinct_types.get(call.name) == .Val((base, _)) {
                if call.args.first() == .Val(arg) {
                    return in_own_frame(fn() { TExpr{ty: Type.Named(call.name), kind: TExprKind.DistinctCtor{name: call.name, arg: lower_expr(arg.expr, cx, &env), base: base}} })
                }
            }
        }
        if cx.variadic_bound_fns.get(call.name) == .Val((fixed, _bounds)) {
            return in_own_frame(fn() {
                lowered := jet_codegen.Codegen.VariadicBound.lower_variadic_bound_call(call, fixed, cx, &env)
                if source_arg_order(call.args) == .Val(order) -> preserve_source_arg_order(lowered, order, call.args.len(), U32.from_int(call.name_span.start)) else -> lowered
            })
        }
        sig := checked_direct_call_sig(call, cx)
        args := loop (i, arg) in call.args.iter().enumerate() {
            conv := if sig == .Val(ps) -> ps.get(i) else -> None
            lower_one_call_arg(arg, conv, &env, cx)
        }
        target_name := demand_generic_free_function(cx, call.name, args, call.type_args) ?? call.name
        in_own_frame(fn() {
            ret := call_return_type_with_args(cx, call.name, call.type_args, args)
            name := if cx.jit_local_call_prefix == .Val(prefix) -> "{prefix}{mangle(target_name)}" else -> target_name
            lowered := TExpr{ty: ret, kind: TExprKind.Call{name: name, type_args: call.type_args, args: args}}
            if cx.contract_sigs.get(call.name) == .Val((pre, _)) {
                if lowered.kind == .Call(callee_name, type_args, call_args) {
                    (bindings, contracts) := lower_call_pre_contracts(call, &call_args, pre, cx, &env)
                    lowered.kind = TExprKind.Call{name: callee_name, type_args: type_args, args: call_args}
                    if !contracts.is_empty() {
                        stmts := bindings
                        loop contract in contracts -> &stmts.push(TStmt.Contract{contract: contract})
                        call_ty := lowered.ty
                        &stmts.push(TStmt.ExprStmt(lowered))
