// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:55
fn lower_value_block(stmts: &[Stmt], cx: &Cx, env: &LowerEnv) -> [TStmt] Never! {
    match stmts.last() {
        Some(Stmt.Switch { .. }) | Some(Stmt.ComptimeSwitch { .. }) => {
            rewritten := stmts.to_vec()
            rewrite_function_value_tails(&rewritten)
            return lower_stmts(&rewritten, cx, env)
        }
        _ => {}
    }
    if stmts.split_last() is Some((Stmt.Expr(expr), prefix)) {
        lowered := lower_stmts(prefix, cx, env)
        lowered.push(TStmt.SourceSpan(expr.span()))
        if cx.debug_linemap { lowered.push(TStmt.LineMarker(cx.src_line_col(expr.span().start).0)) }
        lowered.push(lower_return_value(expr, cx, env))
        return ^lowered
    }
    lower_stmts(stmts, cx, env)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:78
fn rewrite_function_value_tails(body: &[Stmt]) Never! {
    if body.last() is Some(Stmt.Expr(_)) {
        if body.pop() is Some(Stmt.Expr(expr)) {
            span := expr.span()
            body.push(Stmt.Return(Some(^expr), span))
        }
        return
    }
    match body.last_mut() {
        Some(Stmt.Switch { arms, else_body, .. }) | Some(Stmt.ComptimeSwitch { arms, else_body, .. }) => {
            for arm in arms { rewrite_function_value_tails(&arm.body) }
            if else_body is Some(other) { rewrite_function_value_tails(other) }
        }
        _ => {}
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:107
fn return_type_has_value(ty: &Type) -> Bool Never! {
    match ty {
        Type.Named(name) if name == Syntax.INTERNAL_UNIT_TYPE => false
        Type.Result { ok: Type.Named(name), .. } if name == Syntax.INTERNAL_UNIT_TYPE => false
        Type.Apply { name, .. } if name == "Stream" => false
        _ => true
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:117
fn encoding_reader_item_type(name: String) -> Type? Never! {
    match name {
        "JSONReader" | "CBORReader" => Some(Type.Named("DataEvent"))
        "JSONLReader" | "XMLReader" => Some(Type.Named("DataTree"))
        "CSVReader" => Some(Type.Named("CSVRow"))
        _ => None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:126
fn encoding_reader_method(ty: &Type) -> TForInMethod? Never! {
    match ty {
        Type.Named(name) if encoding_reader_item_type(name).is_some() => Some(TForInMethod.EncodingReader { reader_type: name.clone() })
        _ => None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:137
fn static_call_type_name_lower(receiver: &Expr, env: &LowerEnv) -> String? Never! {
    if static_call_type_name_unchecked(receiver) is Some(name) {
        match receiver {
            Expr.Ident(local, _) if env.locals.contains_key(local) => return None
            Expr.Field(base, _, _) => {
                if base is Expr.Ident(prefix, _) { if env.locals.contains_key(prefix) { return None } }
            }
            _ => {}
        }
        return Some(^name)
    }
    None
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:155
fn label_name(label: &(String, Span)?) -> String? Never! { label.as_ref().map(fn(pair) { pair.0.clone() }) }
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:171
fn lower_forin_collection(collection: &Expr, cx: &Cx, env: &LowerEnv) -> (TExpr, TForInMethod?) Never! {
    if collection is Expr.MethodCall { receiver, method, .. } {
        match method {
            "chars" => return (lower_expr(receiver, cx, env), Some(TForInMethod.Chars))
            "lines" => {
                recv := lower_expr(receiver, cx, env)
                if tir_recv_jet_ty(receiver, env) is Some(Type.Named(name)) {
                    if core_file_handle_dispatch_name(name) == Some("FileReader") { return (^recv, Some(TForInMethod.LinesFile)) }
                }
                is_stdin := false
                if tir_recv_jet_ty(receiver, env) is Some(Type.Named(name)) { is_stdin = core_file_handle_dispatch_name(name) == Some("StdinHandle") }
                if receiver is Expr.MethodCall { method: "stdin", .. } { is_stdin = true }
                if is_stdin { return (^recv, Some(TForInMethod.LinesStdin)) }
                if receiver is Expr.Field(base, member, _) {
                    if member == "stdout" || member == "stderr" {
                        if tir_recv_jet_ty(base, env) is Some(Type.Named("ProcessChild")) { return (^recv, Some(TForInMethod.LinesProcessStream)) }
                    }
                }
            }
            _ => {}
        }
        coll := lower_expr(collection, cx, env)
        method := encoding_reader_method(&coll.ty)
        return (^coll, ^method)
    }
    coll := lower_expr(collection, cx, env)
    if coll.ty is Type.Apply { name, args } {
        if name == Syntax.TYPE_RECEIVER && args.len() == 1 { return (^coll, Some(TForInMethod.ChannelReceiver)) }
    }
    method := encoding_reader_method(&coll.ty)
    (^coll, ^method)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:253
fn is_binding_free_user_variant_pattern_test(pattern: &Pattern, cx: &Cx) -> Bool Never! {
    match pattern { Pattern.Variant { variant, bindings, .. } => bindings.is_empty() && cx.variant_owner.contains_key(variant), _ => false }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:266
fn binding_free_variant_owner(cx: &Cx, subject_ty: &Type, subject_enum: String?, variant: String) -> String? Never! {
    if is_data_tree_subject(cx, subject_ty) { return Some(Syntax.TYPE_DATA.to_string()) }
    if is_key_subject(cx, subject_ty) { return Some(Syntax.TYPE_KEY.to_string()) }
    subject_enum.or_else(fn() { cx.variant_owner.get(variant).cloned() })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:284
fn checked_subject_enum(cx: &Cx, subject_ty: &Type, variant: String) -> String? Never! {
    match subject_ty {
        Type.Named(name) | Type.Apply { name, .. } => {
            declares := fn(owner: String) {
                cx.enum_variants.get(owner).is_some_and(fn(variants) { variants.iter().any(fn(pair) { pair.0 == variant }) })
                || core_enum_variants(owner).is_some_and(fn(variants) { variants.contains(variant) })
            }
            resolved := cx.core_qualified_rust_type_name(name).unwrap_or(name.as_str())
            if declares(resolved) { return Some(resolved.to_string()) }
            canonical := canonical_enum_owner(cx, name)
            if declares(canonical) { return Some(^canonical) }
            None
        }
        _ => None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:303
fn lower_binding_free_variant_pattern_test(subject: &Expr, pattern: &Pattern, cx: &Cx, env: &LowerEnv) -> TExpr Never! {
    subj := lower_expr(subject, cx, env)
    variant := match pattern { Pattern.Variant { variant, .. } => variant, _ => panic("binding-free variant gate admitted non-variant") }
    subject_enum := checked_subject_enum(cx, &subj.ty, variant)
    enum_type := binding_free_variant_owner(cx, &subj.ty, ^subject_enum, variant)
    position := TPatternPosition.Arm
    if enum_type is Some(name) {
        if cx.enum_variants.get(name).is_some_and(fn(variants) { variants.iter().any(fn(pair) { pair.0 == variant }) }) { position = TPatternPosition.VariantPath }
    }
    TExpr { ty: Type.Bool, kind: TExprKind.PatternMatches { subj: ^subj, pattern: TPattern.from_ast(pattern.clone(), ^enum_type, ^position, false, false) } }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:337
fn pattern_subject_is_borrowed(subject: &Expr, env: &LowerEnv) -> Bool Never! {
    current := subject
    loop {
        match current { Expr.Ident(name, _) => return env.is_borrowed(name), Expr.Field(base, _, _) => current = base, _ => return false }
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:348
fn pattern_subject_is_owned_self(subject: &Expr, env: &LowerEnv) -> Bool Never! {
    current := subject
    loop {
        match current { Expr.Ident(name, _) => return name == Syntax.KW_SELF && !env.is_borrowed(name), Expr.Field(base, _, _) => current = base, _ => return false }
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:359
fn lower_if_let_subject(subject: &Expr, cx: &Cx, env: &LowerEnv, cached: Bool) -> TExpr Never! {
    lowered_subject := subject
    if subject is Expr.Copy(inner, copy_span) {
        if inner is Expr.Field(..) {
            if copy_span == inner.span() && pattern_subject_is_owned_self(inner, env) { lowered_subject = inner }
        }
    }
    subj := lower_if_expr(lowered_subject, cx, env, cached)
    if pattern_subject_is_borrowed(subject, env) {
        return TExpr { ty: subj.ty.clone(), kind: TExprKind.Clone(^subj, MirCopyFact.Materialize) }
    }
    ^subj
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:425
type IfBinding = (String, TLocal, Type?)
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:429
fn nested_pattern_if_bindings(cx: &Cx, env: &LowerEnv, pattern: &Pattern, subject_ty: &Type) -> [IfBinding] Never! {
    scratch := clone_env(env)
    if tir_add_nested_pattern_bindings(cx, pattern, &scratch, subject_ty).is_err() { return [] }
    pattern.binding_names().into_iter().filter(fn(binding) { binding.local_name() != "_" }).map(fn(binding) {
        name := binding.local_name()
        (name.to_owned(), scratch.local_of(name), scratch.ty_of(name))
    }).collect()
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:452
fn lower_if_expr(expr: &Expr, cx: &Cx, env: &LowerEnv, cached: Bool) -> TExpr Never! {
    if cached { lower_cached_expr(expr, cx, env) } else { lower_expr(expr, cx, env) }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:460
fn flatten_and(cond: &Expr, terms: &[&Expr]) Never! {
    work := TirWorklist.new()
    work.push(cond)
    while work.pop() is Some(current) {
        if current is Expr.Binary(BinOp.And, left, right, _) { work.push(right); work.push(left) }
        else { terms.push(current) }
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:473
fn lower_if_cond(cond: &Expr, cx: &Cx, env: &LowerEnv) -> (TIfCond, [IfBinding], [TStmt]) Never! { lower_if_cond_impl(cond, cx, env, false) }
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:481
fn lower_if_cond_atom_cached(cond: &Expr, cx: &Cx, env: &LowerEnv) -> (TIfCond, [IfBinding], [TStmt]) Never! { lower_if_cond_atom(cond, cx, env, true) }
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:489
fn lower_if_cond_impl(cond: &Expr, cx: &Cx, env: &LowerEnv, cached: Bool) -> (TIfCond, [IfBinding], [TStmt]) Never! {
    terms: [&Expr] := []
    flatten_and(cond, &terms)
    if terms.len() == 1 { return lower_if_cond_atom(cond, cx, env, cached) }
    cond_env := clone_env(env)
    lowered: [TIfCond] := []
    bindings: [IfBinding] := []
    prefixes: [TStmt] := []
    for term in terms {
        (test, binding, prefix) := lower_if_cond_atom(term, cx, &cond_env, cached)
        for (name, place, ty) in binding {
            cond_env.bind(name, place.clone(), ty.clone())
            bindings.push((^name, ^place, ^ty))
        }
        prefixes.extend(^prefix)
        lowered.push(^test)
    }
    reverse := lowered.into_iter().rev()
    combined := reverse.next().expect("conjunction has at least two terms")
    for left in reverse { combined = TIfCond.And { left: ^left, right: ^combined } }
    (^combined, ^bindings, ^prefixes)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:527
fn lower_if_cond_atom(cond: &Expr, cx: &Cx, env: &LowerEnv, cached: Bool) -> (TIfCond, [IfBinding], [TStmt]) Never! {
    if cond is Expr.PatternTest { subject, pattern, .. } {
        match pattern {
            Pattern.Absent(_) => return (TIfCond.IsNone { subj: lower_if_expr(subject, cx, env, cached) }, [], [])
            Pattern.Or(..) => {
                subj := lower_if_expr(subject, cx, env, cached)
                or_pattern_invariant := fn(reason: String) {
                    violation := TExpr { ty: Type.Named(Syntax.TYPE_NEVER.to_string()), kind: TExprKind.InvariantViolation { construct: "checked enum or-pattern: {reason}", span: pattern.span() } }
                    (TIfCond.Plain(^violation), [], [])
                }
                enum_type := match resolved_enum_subject_type(cx, &subj.ty) { Ok(owner) => owner, Err(reason) => return or_pattern_invariant(reason) }
                binding_env := clone_env(env)
                if tir_add_pattern_bindings(cx, pattern, &binding_env, Some(&subj.ty)) is Err(reason) { return or_pattern_invariant(reason) }
                bindings := pattern.binding_names().into_iter().map(fn(binding) {
                    name := binding.local_name()
                    (name.to_owned(), binding_env.local_of(name), binding_env.ty_of(name))
                }).collect()
                return (TIfCond.IfLet { pattern: TPattern.from_ast(pattern.clone(), Some(^enum_type), TPatternPosition.Binding, false, false), subj: ^subj }, ^bindings, [])
            }
            Pattern.StrMatch { .. } => {
                subject_value := lower_if_expr(subject, cx, env, cached)
                subject_ty := subject_value.ty.clone()
                temp := "{generated_prefix()}if_str_{subject.span().start}"
                local := TLocal.generated(temp)
                local_expr := fn() { TExpr { ty: subject_ty.clone(), kind: TExprKind.Local(local.clone()) } }
                condition := str_match_pattern_cond_expr(pattern, local_expr(), cx)
                prefix := lower_str_match_pattern_bindings(pattern, local_expr(), cx, env)
                (_, holes) := str_match_scan_closure(pattern, cx)
                bindings := holes.into_iter().map(fn(pair) {
                    (name, ty) := ^pair
                    place := if ty.is_allocator_view() { TLocal.user(name).through_ref() } else { TLocal.user(name) }
                    (^name, ^place, Some(^ty))
                }).collect()
                return (TIfCond.WithPrelude { prelude: [TStmt.Let { name: ^temp, kw: "let", let_ty: TLetTy.plain(^subject_ty), init: ^subject_value, gc_promotion: None, gc_transferred: false }], cond: TIfCond.Plain(^condition) }, ^bindings, ^prefix)
            }
            Pattern.BinMatch { .. } => {
                subject_value := lower_if_expr(subject, cx, env, cached)
                subject_ty := subject_value.ty.clone()
                temp := "{generated_prefix()}if_bin_{subject.span().start}"
                local := TLocal.generated(temp)
                local_expr := fn() { TExpr { ty: subject_ty.clone(), kind: TExprKind.Local(local.clone()) } }
                condition := bin_match_pattern_cond_expr(pattern, local_expr(), cx)
                prefix := lower_bin_match_pattern_bindings(pattern, local_expr(), cx, env)
                (_, holes) := bin_match_scan_closure(pattern, cx)
                bindings := holes.into_iter().map(fn(pair) { (pair.0.clone(), TLocal.user(pair.0), Some(pair.1)) }).collect()
                return (TIfCond.WithPrelude { prelude: [TStmt.Let { name: ^temp, kw: "let", let_ty: TLetTy.plain(^subject_ty), init: ^subject_value, gc_promotion: None, gc_transferred: false }], cond: TIfCond.Plain(^condition) }, ^bindings, ^prefix)
            }
            Pattern.Variant { variant, bindings, span: pat_span, .. } => {
                subj := lower_if_let_subject(subject, cx, env, cached)
                if subj.ty is Type.Named("DataEvent") {
                    enum_type := Some("DataEvent")
                    if bindings.first() is Some(PatSlot.Bind { name, .. }) {
                        if bindings.len() == 1 {
                            ty := variant_binding_types_for_enum(cx, "DataEvent", variant).and_then(fn(types) { types.into_iter().next() })
                            cloned_subj := TExpr { ty: subj.ty.clone(), kind: TExprKind.Clone(^subj, MirCopyFact.Materialize) }
                            return (TIfCond.IfLet { pattern: TPattern.arm(pattern.clone(), ^enum_type), subj: ^cloned_subj }, [(name.clone(), TLocal.user(name), ^ty)], [])
                        }
                    } else if bindings.len() == 1 && bindings.first() is Some(PatSlot.Wildcard) {
                        cloned_subj := TExpr { ty: subj.ty.clone(), kind: TExprKind.Clone(^subj, MirCopyFact.Materialize) }
                        return (TIfCond.IfLet { pattern: TPattern.arm(pattern.clone(), ^enum_type), subj: ^cloned_subj }, [], [])
                    } else if bindings.is_empty() {
                        return (TIfCond.Matches { pattern: TPattern.arm(pattern.clone(), ^enum_type), subj: ^subj }, [], [])
                    }
                }
                if subj.ty is Type.Union(members) {
                    enum_name := union_enum_name(members)
                    if bindings.first() is Some(PatSlot.Bind { name, .. }) {
                        if bindings.len() == 1 {
                            ty := members.iter().find(fn(member) { union_member_tag(member) == variant }).cloned()
                            return (TIfCond.IfLet { pattern: TPattern.arm(pattern.clone(), Some(^enum_name)), subj: ^subj }, [(name.clone(), TLocal.user(name), ^ty)], [])
                        }
                    } else if bindings.len() == 1 && bindings.first() is Some(PatSlot.Wildcard) {
                        return (TIfCond.IfLet { pattern: TPattern.arm(pattern.clone(), Some(^enum_name)), subj: ^subj }, [], [])
                    }
                }
                if is_json_variant(variant) && is_data_tree_subject(cx, &subj.ty) {
                    if bindings.is_empty() { return (TIfCond.Matches { pattern: TPattern.arm(pattern.clone(), Some(Syntax.TYPE_DATA.to_string())), subj: ^subj }, [], []) }
                    if bindings.len() == 1 && bindings.first() is Some(PatSlot.Wildcard) { return (TIfCond.IfLet { pattern: TPattern.arm(pattern.clone(), Some(Syntax.TYPE_DATA.to_string())), subj: ^subj }, [], []) }
                    if bindings.first() is Some(PatSlot.Bind { name, .. }) {
                        ty := core_json_pattern_types(variant).and_then(fn(types) { types.into_iter().next() })
                        place := TLocal.user(name)
                        if variant == "Object" {
                            obj_tmp := "{generated_prefix()}obj{pat_span.start}"
                            map_ty := ty.expect("checked DataTree Object payload type")
                            prefix := TStmt.Let { name: name.clone(), kw: "let", let_ty: TLetTy.plain(map_ty.clone()), init: TExpr { ty: map_ty.clone(), kind: TExprKind.DataEntriesToMap(TLocal.generated(obj_tmp)) }, gc_promotion: None, gc_transferred: false }
                            return (TIfCond.IfLet { pattern: TPattern.from_ast(pattern.clone(), Some(Syntax.TYPE_DATA.to_string()), TPatternPosition.DataEntries { temp: ^obj_tmp }, false, false), subj: ^subj }, [(name.clone(), ^place, Some(^map_ty))], [^prefix])
                        }
                        return (TIfCond.IfLet { pattern: TPattern.arm(pattern.clone(), Some(Syntax.TYPE_DATA.to_string())), subj: ^subj }, [(name.clone(), ^place, ^ty)], [])
                    }
                }
                if !(is_json_variant(variant) && is_data_tree_subject(cx, &subj.ty)) {
                    subject_enum := checked_subject_enum(cx, &subj.ty, variant)
                    enum_type := binding_free_variant_owner(cx, &subj.ty, ^subject_enum, variant)
                    payload_tys := enum_type.as_deref().and_then(fn(owner) { variant_binding_types_for_enum(cx, owner, variant) }).or_else(fn() { variant_binding_types(cx, variant) }).unwrap_or_default()
                    if_bindings: [IfBinding] := []
                    for (index, slot) in bindings.iter().enumerate() {
                        ty := payload_tys.get(index).cloned()
                        match slot {
                            PatSlot.Bind { name, .. } => if_bindings.push((name.clone(), TLocal.user(name), ^ty))
                            PatSlot.Nested(inner) => { if ty is Some(payload_ty) { if_bindings.extend(nested_pattern_if_bindings(cx, env, inner, &payload_ty)) } }
                            _ => {}
                        }
                    }
                    if !bindings.is_empty() { return (TIfCond.IfLet { pattern: TPattern.from_ast(pattern.clone(), ^enum_type, TPatternPosition.Binding, false, false), subj: ^subj }, ^if_bindings, []) }
                }
                subject_enum := checked_subject_enum(cx, &subj.ty, variant)
                subject_owned_unit_variant := bindings.is_empty() && subject_enum.is_some() && !is_data_tree_subject(cx, &subj.ty) && !is_key_subject(cx, &subj.ty)
                if subject_owned_unit_variant || is_binding_free_user_variant_pattern_test(pattern, cx) {
                    enum_type := binding_free_variant_owner(cx, &subj.ty, ^subject_enum, variant)
                    return (TIfCond.Matches { pattern: TPattern.arm(pattern.clone(), ^enum_type), subj: ^subj }, [], [])
                }
            }
            Pattern.Struct { fields, .. } => {
                subj := lower_if_let_subject(subject, cx, env, cached)
                subject_ty := subj.ty.clone()
                temp := "{generated_prefix()}if_struct_{subject.span().start}"
                local := TLocal.generated(temp)
                local_expr := fn() { TExpr { ty: subject_ty.clone(), kind: TExprKind.Local(local.clone()) } }
                condition := lower_struct_pattern_condition(pattern, local_expr, cx, env)
                bindings: [IfBinding] := []
                prefix: [TStmt] := []
                for field in fields {
                    if field is StructPatField.Bind { field: name, local: binding, .. } {
                        fty := struct_pattern_field_type(cx, &subject_ty, name).unwrap_or(Type.Int)
                        place := if fty.is_allocator_view() { TLocal.user(binding).through_ref() } else { TLocal.user(binding) }
                        bindings.push((binding.clone(), ^place, Some(fty.clone())))
