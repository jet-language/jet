//RS fn same_branch_subject(candidate: &Expr, subject: &Expr) -> bool {
//RS     // A classic `if` is represented as a subjectless guard with a private
//RS     // `true` subject. Generated source can give that private subject and a
//RS     // comparison operand the same synthetic span; treating the spans as an
//RS     // identity match rewrites `left < right` to `switch_subject < right` and
//RS     // leaks the guard's Bool carrier into the comparison. Only a real Bool
//RS     // dispatch uses the private subject as a comparison operand.
//RS     if matches!(subject, Expr::Bool(true, _)) {
//RS         return false;
//RS     }
//RS     candidate.span() == subject.span()
//RS         || matches!((candidate, subject), (Expr::Ident(a, _), Expr::Ident(b, _)) if a == b)
//RS }
//RS 
//RS fn equality_literal<'a>(subject: &Expr, cond: &'a Expr) -> Option<&'a Expr> {
//RS     match cond {
//RS         Expr::Binary(BinOp::Eq, left, right, _) if same_branch_subject(left, subject) => {
//RS             Some(right)
//RS         }
