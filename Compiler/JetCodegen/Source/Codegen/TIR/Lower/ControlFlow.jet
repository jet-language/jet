// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:1249
fn struct_pattern_field_expr(subject: TExpr, field: String, field_ty: Type, cx: &Cx) -> TExpr Never! {
    // GATE #4499: exact tuple-key membership, not string encoding.
    boxed := match subject.ty { Type.Named(name) => cx.boxed_edges.contains((name.clone(), field.to_string())), _ => false }
    TExpr { ty: ^field_ty, kind: TExprKind.Field { recv: ^subject, field: field.to_string(), boxed } }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:1264
fn lower_struct_pattern_condition(pattern: &Pattern, subject: fn() -> TExpr Never!, cx: &Cx, env: &LowerEnv) -> TExpr Never! {
    tests: [TExpr] := []
    if pattern is Pattern.Struct { fields, .. } {
        for entry in fields {
            if entry is StructPatField.Value { field, value, .. } {
                subject_expr := subject()
                field_ty := struct_pattern_field_type(cx, &subject_expr.ty, field).unwrap_or(Type.Int)
                lhs := struct_pattern_field_expr(^subject_expr, field, field_ty.clone(), cx)
                rhs := lower_expr(value, cx, env)
                tests.push(TExpr { ty: Type.Bool, kind: TExprKind.Binary { op: BinOp.Eq, overflow: false, line: 0, lhs: ^lhs, rhs: ^rhs } })
            }
        }
    }
    bool_and_chain(^tests)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:1298
fn lower_switch(subject: &Expr, arms: &[SwitchArm], else_body: &[Stmt]?, span: Span, cx: &Cx, env: &LowerEnv) -> LowerStmtPlan Never! {
    if is_subjectless_guard(subject, span) {
        if arms.iter().any(fn(arm) { readiness_head(&arm.cond).is_some() }) { return lower_readiness_switch(arms, else_body, cx, env) }
        return lower_guard_switch(arms, else_body, env, None)
    }
    if arms.iter().any(fn(arm) { arm_has_nested_pattern(&arm.cond) }) {
        if subject is Expr.Ident(..) { return lower_guard_switch(arms, else_body, env, Some((subject, subject.clone()))) }
        name := "{generated_prefix()}switch_subject_{subject.span().start}"
        carrier := arms.iter().any(fn(arm) { match arm.cond { Expr.PatternTest { pattern: Pattern.Ok { .. }, .. } | Expr.PatternTest { pattern: Pattern.Err { .. }, .. } => true, _ => false } })
        fallback_subject := env.fallback_subject
        env.fallback_subject = carrier || fallback_subject
        init := lower_if_let_subject(subject, cx, env, false)
        env.fallback_subject = fallback_subject
        ty := init.ty.clone()
        env.bind(name, TLocal.generated(name), Some(ty.clone()))
        local_subject := Expr.Ident(name.clone(), subject.span())
        return lower_guard_switch(arms, else_body, env, Some((subject, ^local_subject))).map_stmt(fn(stmt) {
            match stmt {
                TStmt.If { cond, then_body, else_body: other, else_is_elseif } => TStmt.If { cond: TIfCond.WithPrelude { prelude: [TStmt.Let { name: ^name, kw: "let", let_ty: TLetTy.plain(^ty), init: ^init, gc_promotion: None, gc_transferred: false }], cond: ^cond }, then_body: ^then_body, else_body: ^other, else_is_elseif }
                _ => panic("a guard table lowers to an if statement")
            }
        })
    }
    if arms.is_empty() { return lower_mixed_switch(subject, arms, else_body, classify_branch(subject, arms, cx), cx, env) }
    data_subject := match subject { Expr.Ident(name, _) => env.ty_of(name).is_none_or(fn(ty) { is_data_tree_subject(cx, &ty) }), _ => true }
    if data_subject && !arms.is_empty() && arms.iter().all(fn(arm) { arm_variant_pattern(cx, &arm.cond, subject).is_some_and(fn(pattern) { match pattern { Pattern.Variant { variant, .. } => is_json_variant(variant), _ => false } }) }) {
        return lower_guard_switch(arms, else_body, env, Some((subject, subject.clone())))
    }
    if else_body.is_some() && arms.iter().all(fn(arm) { arm_head_range(cx, &arm.cond, subject).is_some() }) { return lower_range_switch(subject, arms, else_body, cx, env) }
    if arms.iter().all(fn(arm) { arm_fallible_pattern(cx, &arm.cond, subject).is_some() }) { return lower_fallible_match(subject, arms, else_body, cx, env) }
    if else_body.is_some() && arms.iter().any(fn(arm) { arm_guarded_variant_pattern(cx, &arm.cond, subject).is_some() }) && arms.iter().all(fn(arm) { arm_variant_pattern(cx, &arm.cond, subject).is_some() || arm_guarded_variant_pattern(cx, &arm.cond, subject).is_some() }) { return lower_guard_switch(arms, else_body, env, Some((subject, subject.clone()))) }
    class := classify_branch(subject, arms, cx)
    if arms.iter().all(fn(arm) { arm_is_plain_cond(cx, &arm.cond, subject) || arm_head_range(cx, &arm.cond, subject).is_some() || arm_struct_pattern(cx, &arm.cond, subject).is_some() || arm_str_match_pattern(cx, &arm.cond, subject).is_some() || arm_bin_match_pattern(cx, &arm.cond, subject).is_some() }) { return lower_mixed_switch(subject, arms, else_body, class, cx, env) }
    if arms.iter().all(fn(arm) { arm_variant_pattern(cx, &arm.cond, subject).is_some() }) { return lower_enum_match(subject, arms, else_body, cx, env) }
    lower_mixed_switch(subject, arms, else_body, class, cx, env)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:1467
fn readiness_result_local(result_name: String, result_ty: &Type) -> TExpr Never! { TExpr { ty: result_ty.clone(), kind: TExprKind.Local(TLocal.user(result_name.to_string())) } }
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:1474
fn readiness_result_field(result_name: String, result_ty: &Type, index: USize, ty: Type) -> TExpr Never! {
    TExpr { ty: ^ty, kind: TExprKind.HostCall(THostCall.TupleIndex { base: readiness_result_local(result_name, result_ty), index }) }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:1484
fn readiness_result_value(result_name: String, result_ty: &Type, elem_ty: Type) -> TExpr Never! {
