// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:1509
// Private lifted carrier of lower_readiness_switch.
enum LoweredHead {
    Receive { binding: String, receiver: TExpr, arm: I64, elem_ty: Type }
    After { duration: TExpr, arm: I64 }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:1503
fn lower_readiness_switch(arms: &[SwitchArm], else_body: &[Stmt]?, cx: &Cx, env: &LowerEnv) -> LowerStmtPlan Never! {
    lowered_heads: [LoweredHead] := []
    receiver_count: I64 := 0
    after_count: I64 := 0
    element_ty := Type.Named("Unit")
    for arm in arms {
        if readiness_head(&arm.cond) is Some(head) {
            match head {
                ReadinessHead.Receive { binding, source } => {
                    receiver := lower_expr(source, cx, env)
                    if receiver.ty is Type.Apply { name, args } { if name == Syntax.TYPE_RECEIVER && args.len() == 1 { element_ty = args[0].clone() } }
                    lowered_heads.push(LoweredHead.Receive { binding: binding.to_string(), receiver: ^receiver, arm: receiver_count, elem_ty: element_ty.clone() })
                    receiver_count += 1
                }
                ReadinessHead.After { duration } => {
                    lowered_heads.push(LoweredHead.After { duration: lower_expr(duration, cx, env), arm: after_count })
                    after_count += 1
                }
            }
        }
    }
    builder_ty := Type.Named("__JetReadinessTable")
    builder := TExpr { ty: builder_ty.clone(), kind: TExprKind.SelectStart }
    for head in lowered_heads.iter_mut().rev() {
        match head {
            LoweredHead.Receive { receiver, .. } => {
                channel := ^receiver
                receiver = TExpr { ty: Type.Named("Unit"), kind: TExprKind.Unit }
                builder = TExpr { ty: builder_ty.clone(), kind: TExprKind.SelectRecv { builder: ^builder, channel: ^channel } }
            }
            LoweredHead.After { duration, .. } => {
                value := ^duration
                duration = TExpr { ty: Type.Named("Unit"), kind: TExprKind.Unit }
                builder = TExpr { ty: builder_ty.clone(), kind: TExprKind.SelectAfter { builder: ^builder, duration: ^value, value: None } }
            }
        }
    }
    result_ty := Type.Tuple([("arm", Type.Int), ("value", Type.Option(element_ty.clone()))])
    result_name := "__select_result"
    bodies: [LowerBody] := []
    arm_states := []
    for (arm, head) in arms.iter().zip(lowered_heads.into_iter()) {
        state := Rc.new(RefCell.new(None))
        state_for_prepare := Rc.clone(state)
        branch := clone_env(env)
        result_name_for_prepare := result_name.clone()
        result_ty_for_prepare := result_ty.clone()
        (arm_index, binding, elem_ty) := match head {
            LoweredHead.Receive { arm: index, binding, elem_ty, .. } => (index, Some(binding.clone()), Some(elem_ty.clone()))
            LoweredHead.After { arm: index, .. } => (receiver_count + index, None, None)
        }
        bodies.push(LowerBody.scoped(&arm.body, ^branch).prepare(fn(_cx, branch) {
            prefix: [TStmt] := []
            if (binding, elem_ty) is (Some(name), Some(ty)) {
                branch.bind(name, TLocal.user(name.clone()), Some(ty.clone()))
                prefix.push(TStmt.Let { name: ^name, kw: "let", let_ty: TLetTy.plain(ty.clone()), init: readiness_result_value(result_name_for_prepare, &result_ty_for_prepare, ^ty), gc_promotion: None, gc_transferred: false })
            }
            *state_for_prepare.borrow_mut() = Some((arm_index, ^prefix))
        }))
        arm_states.push(^state)
    }
    if else_body is Some(body) { bodies.push(LowerBody.scoped(body, clone_env(env))) }
    has_else := else_body.is_some()
    deferred_stmt(^bodies, fn(lowered) {
        iter := lowered.into_iter()
        dispatch_arms := []
        for state in arm_states {
            (arm_index, prefix) := state.borrow_mut().take().expect("readiness arm prepared before body")
            prefix.extend(iter.next().expect("readiness arm body was deferred"))
            condition := TExpr { ty: Type.Bool, kind: TExprKind.Binary { op: BinOp.Eq, overflow: false, line: 0, lhs: readiness_result_field(result_name, &result_ty, 0, Type.Int), rhs: TExpr { ty: Type.Int, kind: TExprKind.IntLit(arm_index, None) } } }
            dispatch_arms.push((^condition, ^prefix))
        }
        other := if has_else { Some(iter.next().expect("readiness else body was deferred")) } else { None }
        TStmt.Inline([TStmt.Let { name: result_name.clone(), kw: "let", let_ty: TLetTy.inferred(), init: TExpr { ty: result_ty.clone(), kind: TExprKind.SelectWait { builder: ^builder, nonblocking: other.is_some() } }, gc_promotion: None, gc_transferred: false }, TStmt.MixedSwitch { subject: readiness_result_field(result_name, &result_ty, 0, Type.Int), class: BranchClass.DenseInt, arms: ^dispatch_arms, else_body: ^other }])
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:1709
fn same_branch_subject(candidate: &Expr, subject: &Expr) -> Bool Never! {
    if subject is Expr.Bool(true, _) { return false }
    candidate.span() == subject.span() || match (candidate, subject) { (Expr.Ident(left, _), Expr.Ident(right, _)) => left == right, _ => false }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:1723
fn equality_literal(subject: &Expr, cond: &Expr) -> &Expr? Never! {
    match cond { Expr.Binary(BinOp.Eq, left, right, _) if same_branch_subject(left, subject) => Some(right), Expr.Bool(..) => Some(cond), _ => None }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:1734
fn switch_subject_expr(ty: Type) -> TExpr Never! { TExpr { ty: ^ty, kind: TExprKind.HostCall(THostCall.SwitchSubjectValue) } }
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:1741
fn lower_branch_condition(condition: &Expr, subject: &Expr, subject_ty: &Type, cx: &Cx, env: &LowerEnv) -> TExpr Never! {
    if condition is Expr.Bool(..) && subject_ty is Type.Bool {
        return TExpr { ty: Type.Bool, kind: TExprKind.Binary { op: BinOp.Eq, overflow: false, line: 0, lhs: switch_subject_expr(subject_ty.clone()), rhs: lower_expr(condition, cx, env) } }
    }
    if condition is Expr.Binary(op, left, right, _) {
        comparison := match op { BinOp.Eq | BinOp.Ne | BinOp.Lt | BinOp.Le | BinOp.Gt | BinOp.Ge => true, _ => false }
        if comparison && same_branch_subject(left, subject) { return TExpr { ty: Type.Bool, kind: TExprKind.Binary { op, overflow: false, line: 0, lhs: switch_subject_expr(subject_ty.clone()), rhs: lower_expr(right, cx, env) } } }
    }
    lower_expr(condition, cx, env)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:1781
fn classify_branch(subject: &Expr, arms: &[SwitchArm], cx: &Cx) -> BranchClass Never! {
    if !arms.is_empty() && arms.iter().all(fn(arm) { arm_variant_pattern(cx, &arm.cond, subject).is_some() }) { return BranchClass.Enum }
    bools: [Bool] := []
    ints: [I64] := []
    for arm in arms {
        if equality_literal(subject, &arm.cond) is Some(value) {
            match value { Expr.Bool(number, _) => bools.push(number), Expr.Int(number, ..) => ints.push(number), _ => {} }
        }
    }
    if arms.len() == 2 && bools.len() == 2 && bools[0] != bools[1] { return BranchClass.Bool2 }
    if !ints.is_empty() && ints.len() == arms.len() {
        ints.sort_unstable()
        if ints.windows(2).any(fn(pair) { pair[0] == pair[1] }) { return BranchClass.Mixed }
        span := (ints.last().unwrap().saturating_sub(ints.first().unwrap()) as USize) + 1
        return if span <= ints.len().saturating_mul(2) { BranchClass.DenseInt } else { BranchClass.SparseInt }
    }
    if arms.iter().all(fn(arm) {
        arm_head_range(cx, &arm.cond, subject).is_some() || match arm.cond { Expr.Binary(BinOp.Lt | BinOp.Le | BinOp.Gt | BinOp.Ge, _, _, _) => true, _ => false }
    }) { BranchClass.Ordered } else { BranchClass.Mixed }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:1833
fn lower_guard_switch(arms: &[SwitchArm], else_body: &[Stmt]?, env: &LowerEnv, subject_override: (&Expr, Expr)?) -> LowerStmtPlan Never! {
    arm_states := []
    bodies: [LowerBody] := []
    if else_body is Some(body) { bodies.push(LowerBody.scoped(body, clone_env(env))) }
    for arm in arms.iter().rev() {
        state := Rc.new(RefCell.new(None))
        state_for_prepare := Rc.clone(state)
        branch := fork_panic(env)
        replacement := subject_override.clone()
        bodies.push(LowerBody.scoped(&arm.body, ^branch).prepare(fn(cx, branch) {
            condition := replacement.as_ref().map(fn(pair) { replace_pattern_subject(cx, &arm.cond, pair.0, &pair.1) }).unwrap_or_else(fn() { arm.cond.clone() })
            cond: TIfCond
            bindings: [IfBinding]
            prefix: [TStmt]
            {
                scope := ExprCacheScope.enter()
                (cond, bindings, prefix) = lower_if_cond(&condition, cx, branch)
            }
            for (name, place, ty) in bindings { branch.bind(name, ^place, ^ty) }
            *state_for_prepare.borrow_mut() = Some((^cond, ^prefix))
        }))
        arm_states.push(^state)
    }
    has_else := else_body.is_some()
    deferred_stmt(^bodies, fn(lowered) {
        iter := lowered.into_iter()
        chain := if has_else { iter.next().expect("guard else body was deferred") } else { [] }
        else_is_elseif := false
        for state in arm_states {
            (cond, prefix) := state.borrow_mut().take().expect("guard condition prepared before body")
            prefix.extend(iter.next().expect("guard arm body was deferred"))
            other := if !chain.is_empty() { Some(^chain) } else { None }
            chain = [TStmt.If { cond: ^cond, then_body: ^prefix, else_body: ^other, else_is_elseif }]
            else_is_elseif = true
        }
        chain.into_iter().next().expect("guard table has at least one arm")
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:1912
fn replace_pattern_subject(cx: &Cx, condition: &Expr, subject: &Expr, replacement: &Expr) -> Expr Never! {
    match condition {
        Expr.PatternTest { subject: tested, pattern, span } if pattern_subjects_match(cx, tested, subject) => Expr.PatternTest { subject: replacement.clone(), pattern: pattern.clone(), span }
        Expr.Binary(BinOp.And, left, right, span) => Expr.Binary(BinOp.And, replace_pattern_subject(cx, left, subject, replacement), replace_pattern_subject(cx, right, subject, replacement), span)
        _ => condition.clone()
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:1934
fn range_inclusive_cond(subject_ty: &Type, lo: I64, hi: I64) -> TExpr Never! {
    ge := TExpr { ty: Type.Bool, kind: TExprKind.Binary { op: BinOp.Ge, overflow: false, line: 0, lhs: switch_subject_expr(subject_ty.clone()), rhs: TExpr { ty: Type.Int, kind: TExprKind.IntLit(lo, None) } } }
    le := TExpr { ty: Type.Bool, kind: TExprKind.Binary { op: BinOp.Le, overflow: false, line: 0, lhs: switch_subject_expr(subject_ty.clone()), rhs: TExpr { ty: Type.Int, kind: TExprKind.IntLit(hi, None) } } }
    TExpr { ty: Type.Bool, kind: TExprKind.Binary { op: BinOp.And, overflow: false, line: 0, lhs: ^ge, rhs: ^le } }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:1982
fn lower_mixed_switch(subject: &Expr, arms: &[SwitchArm], else_body: &[Stmt]?, class: BranchClass, cx: &Cx, env: &LowerEnv) -> LowerStmtPlan Never! {
    subject_expr := lower_expr(subject, cx, env)
    subject_ty := subject_expr.ty.clone()
    arm_states := []
    bodies: [LowerBody] := []
    for arm in arms {
        ty := subject_ty.clone()
        state := Rc.new(RefCell.new(None))
        state_for_prepare := Rc.clone(state)
        branch := clone_env(env)
        bodies.push(LowerBody.scoped(&arm.body, ^branch).prepare(fn(cx, branch) {
            struct_pat := arm_struct_pattern(cx, &arm.cond, subject)
            str_match_pat := arm_str_match_pattern(cx, &arm.cond, subject)
            bin_match_pat := arm_bin_match_pattern(cx, &arm.cond, subject)
            cond_expr: TExpr
            if arm_head_range(cx, &arm.cond, subject) is Some((lo, hi)) { cond_expr = range_inclusive_cond(&ty, lo, hi) }
            else if struct_pat is Some(pattern) { cond_expr = struct_pattern_cond_expr(&pattern, &ty, cx, branch) }
            else if str_match_pat is Some(pattern) { cond_expr = str_match_pattern_cond_expr(&pattern, switch_subject_expr(ty.clone()), cx) }
            else if bin_match_pat is Some(pattern) { cond_expr = bin_match_pattern_cond_expr(&pattern, switch_subject_expr(ty.clone()), cx) }
            else { cond_expr = lower_branch_condition(&arm.cond, subject, &ty, cx, branch) }
            prefix: [TStmt] := []
            if struct_pat is Some(pattern) { prefix = lower_struct_pattern_bindings(&pattern, &ty, cx, branch) }
            else if str_match_pat is Some(pattern) { prefix = lower_str_match_pattern_bindings(&pattern, switch_subject_expr(ty.clone()), cx, branch) }
            else if bin_match_pat is Some(pattern) { prefix = lower_bin_match_pattern_bindings(&pattern, switch_subject_expr(ty.clone()), cx, branch) }
            *state_for_prepare.borrow_mut() = Some((^cond_expr, ^prefix))
        }))
        arm_states.push(^state)
    }
    has_else := else_body.is_some()
    if else_body is Some(body) { bodies.push(LowerBody.scoped(body, clone_env(env))) }
    deferred_stmt(^bodies, fn(lowered) {
        iter := lowered.into_iter()
        lowered_arms := arm_states.into_iter().map(fn(state) {
            (cond, prefix) := state.borrow_mut().take().expect("mixed-switch arm prepared before body")
            prefix.extend(iter.next().expect("mixed-switch arm body was deferred"))
            (^cond, ^prefix)
        }).collect()
        other := if has_else { Some(iter.next().expect("mixed-switch else body was deferred")) } else { None }
        TStmt.MixedSwitch { subject: ^subject_expr, class, arms: ^lowered_arms, else_body: ^other }
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:2080
fn struct_pattern_cond_expr(pattern: &Pattern, subject_ty: &Type, cx: &Cx, env: &LowerEnv) -> TExpr Never! {
    tests: [TExpr] := []
    if pattern is Pattern.Struct { fields, .. } {
        for entry in fields {
            if entry is StructPatField.Value { field, value, .. } {
                fty := struct_pattern_field_type(cx, subject_ty, field).unwrap_or(Type.Int)
                lhs := TExpr { ty: fty.clone(), kind: TExprKind.HostCall(THostCall.SwitchSubjectField { field: field.clone() }) }
                rhs := lower_expr(value, cx, env)
                tests.push(TExpr { ty: Type.Bool, kind: TExprKind.Binary { op: BinOp.Eq, overflow: false, line: 0, lhs: ^lhs, rhs: ^rhs } })
            }
        }
    }
    bool_and_chain(^tests)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:2119
fn lower_struct_pattern_bindings(pattern: &Pattern, subject_ty: &Type, cx: &Cx, env: &LowerEnv) -> [TStmt] Never! {
    out: [TStmt] := []
    if pattern is Pattern.Struct { fields, .. } {
        for entry in fields {
            if entry is StructPatField.Bind { field, local, .. } {
                fty := struct_pattern_field_type(cx, subject_ty, field).unwrap_or(Type.Int)
                env.bind(local, TLocal.user(local), Some(fty.clone()))
                out.push(TStmt.Let { name: local.clone(), kw: "let", let_ty: TLetTy.plain(fty.clone()), init: TExpr { ty: fty.clone(), kind: TExprKind.Clone(TExpr { ty: ^fty, kind: TExprKind.HostCall(THostCall.SwitchSubjectField { field: field.clone() }) }, MirCopyFact.Materialize) }, gc_promotion: None, gc_transferred: false })
            }
        }
    }
    ^out
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:2168
fn str_match_scan_closure(pattern: &Pattern, cx: &Cx) -> (String, [(String, Type)]) Never! {
    if pattern is Pattern.StrMatch { parts, .. } { return str_match_scan_closure_ex(parts, cx, "{generated_prefix()}switch_subject.as_str()", true) }
    ("(|| -> Option<()> { Some(()) })()", [])
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:2192
fn str_match_scan_closure_ex(parts: &[StrMatchPart], cx: &Cx, subject_src: String, require_full_match: Bool) -> (String, [(String, Type)]) Never! {
    holes: [(String, Type)] := []
    body := String.new()
    p := generated_prefix()
    body.push_str("let mut {p}sm: &str = {subject_src};\n")
    if !require_full_match { body.push_str("let {p}sm_orig_len: usize = {p}sm.len();\n") }
    i: USize := 0
    while i < parts.len() {
        match parts[i] {
            StrMatchPart.Lit(lit) => {
                already_consumed_by_prior_hole := i > 0 && parts[i - 1] is StrMatchPart.Hole { .. }
                if !already_consumed_by_prior_hole {
                    escaped := escape_rust_str(lit)
                    body.push_str("if !{p}sm.starts_with({escaped}) {{ return None; }} {p}sm = &{p}sm[{escaped}.len()..];\n")
                }
                i += 1
            }
            StrMatchPart.Hole { name, ty, .. } => {
                var := "{p}sm_{Syntax.generated_suffix(mangle(name))}"
                match parts.get(i + 1) {
                    Some(StrMatchPart.Lit(next_lit)) => {
                        escaped := escape_rust_str(next_lit)
                        body.push_str("let {var}: &str = match {p}sm.find({escaped}) {{ Some({p}i) => {{ let {p}h = &{p}sm[..{p}i]; {p}sm = &{p}sm[{p}i + {escaped}.len()..]; {p}h }}, None => return None }};\n")
                    }
                    _ => body.push_str("let {var}: &str = {p}sm; {p}sm = \"\";\n")
                }
                bound_ty := ty.clone().unwrap_or(Type.String)
                match bound_ty {
                    Type.String => body.push_str("let {var}: String = {var}.to_string();\n")
                    Type.Int => body.push_str("let {var}: i64 = match {cx.root_prefix}jet_std::jet_int_from_str({var}.trim()) {{ Ok({p}v) => {p}v, Err(_) => return None }};\n")
                    Type.InlineRange { lo, hi, .. } => body.push_str("let {var}: i64 = match {var}.trim().parse::<i64>() {{ Ok({p}v) => match jet_inline_range_from_int({p}v, {lo}, {hi}) {{ Ok({p}v) => {p}v, Err(_) => return None }}, Err(_) => return None }};\n")
                    Type.Float => body.push_str("let {var}: f64 = match {var}.trim().parse::<f64>() {{ Ok({p}v) => {p}v, Err(_) => return None }};\n")
                    Type.Bool => body.push_str("let {var}: bool = match {var}.trim().parse::<bool>() {{ Ok({p}v) => {p}v, Err(_) => return None }};\n")
                    _ => {}
                }
                holes.push((name.clone(), ^bound_ty))
                i += 1
            }
        }
    }
    if require_full_match && parts.last() is Some(StrMatchPart.Lit(_)) { body.push_str("if !{p}sm.is_empty() {{ return None; }}\n") }
    tuple_vars := holes.iter().map(fn(pair) { mangle_generated("sm_{Syntax.generated_suffix(mangle(pair.0))}") }).collect()
    tuple_tys := holes.iter().map(fn(pair) { cx.rust_type(&pair.1) }).collect()
    if !require_full_match {
        body.push_str("let {p}consumed: usize = {p}sm_orig_len - {p}sm.len();\n")
        tuple_vars.push(mangle_generated("consumed"))
        tuple_tys.push("usize")
    }
    body.push_str("Some(({tuple_join(&tuple_vars)}))\n")
    closure := "(|| -> Option<({tuple_join(&tuple_tys)})> {{\n{body}}})()"
    (^closure, ^holes)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:2338
fn bin_match_scan_closure(pattern: &Pattern, cx: &Cx) -> (String, [(String, Type)]) Never! {
    if pattern is Pattern.BinMatch { parts, .. } { return bin_match_scan_closure_ex(parts, cx, "({generated_prefix()}switch_subject).as_slice()", true) }
    ("(|| -> Option<()> { Some(()) })()", [])
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:2354
fn bin_match_scan_closure_ex(parts: &[BinMatchPart], cx: &Cx, subject_src: String, require_full_match: Bool) -> (String, [(String, Type)]) Never! {
    holes: [(String, Type)] := []
    body := String.new()
    consume_prefix := !require_full_match
    p := generated_prefix()
    body.push_str("let {p}bm: &[u8] = {subject_src};\n")
    kernel_parts := parts.iter().map(fn(part) {
        match part {
            BinMatchPart.Lit(bytes) => {
                text := bytes.iter().map(fn(byte) { "{byte}u8" }).collect<[String]>().join(", ")
                "JetBinMatchPart::Lit(&[{text}])"
            }
            BinMatchPart.Hole { spec, .. } => match spec {
                BinSpec.Bits { width, endian } => "JetBinMatchPart::Bits {{ width: {width}usize, little: {endian == BinEndian.Little} }}"
                BinSpec.Rest => "JetBinMatchPart::Rest"
            }
        }
    }).collect<[String]>().join(", ")
    body.push_str("let ({p}bm_pos, mut {p}bm_values) = match jet_bin_match_scan({p}bm, &[{kernel_parts}], {consume_prefix}) {{ Some((pos, values)) => (pos, values.into_iter()), None => return None }};\n")
    tuple_vars: [String] := []
    for part in parts {
        if part is BinMatchPart.Hole { name, spec, .. } {
            var := "{p}bm_{Syntax.generated_suffix(mangle(name))}"
            (ty, value) := match spec {
                BinSpec.Rest => (Type.List(Type.IntN { signed: false, bits: 8 }), "Some(JetBinMatchValue::Rest(value)) => value")
                BinSpec.Bits { width, .. } => {
                    ty := bin_bits_type(width)
                    rust_ty := cx.rust_type(&ty)
                    (^ty, "Some(JetBinMatchValue::Int(value)) => value as {rust_ty}")
                }
            }
            rust_ty := cx.rust_type(&ty)
            body.push_str("let {var}: {rust_ty} = match {p}bm_values.next() {{ {value}, _ => return None }};\n")
            tuple_vars.push(^var)
            holes.push((name.clone(), ^ty))
        }
    }
    // Foundation matcher owns full/prefix consumption and whole-byte boundary checks.
    tuple_tys := holes.iter().map(fn(pair) { cx.rust_type(&pair.1) }).collect()
    if !require_full_match {
        body.push_str("let {p}consumed: usize = {p}bm_pos / 8;\n")
        tuple_vars.push(mangle_generated("consumed"))
        tuple_tys.push("usize")
    }
    body.push_str("Some(({tuple_join(&tuple_vars)}))\n")
    closure := "(|| -> Option<({tuple_join(&tuple_tys)})> {{\n{body}}})()"
    (^closure, ^holes)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:2457
fn bin_bits_type(width: U8) -> Type Never! {
    bits := if width <= 8 { 8 } else if width <= 16 { 16 } else if width <= 32 { 32 } else { 64 }
    Type.IntN { signed: false, bits }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/control_flow.rs:2475
fn tuple_join(items: &[String]) -> String Never! {
    match items.len() { 0 => String.new(), 1 => "{items[0]},", _ => items.join(", ") }
}
