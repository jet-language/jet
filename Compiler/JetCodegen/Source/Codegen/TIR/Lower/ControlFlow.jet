                local := TLocal.generated(temp)
                local_expr := fn() { TExpr { ty: subject_ty.clone(), kind: TExprKind.Local(local.clone()) } }
                ge := TExpr { ty: Type.Bool, kind: TExprKind.Binary { op: BinOp.Ge, overflow: false, line: 0, lhs: local_expr(), rhs: TExpr { ty: Type.Int, kind: TExprKind.IntLit(lo, None) } } }
                le := TExpr { ty: Type.Bool, kind: TExprKind.Binary { op: BinOp.Le, overflow: false, line: 0, lhs: local_expr(), rhs: TExpr { ty: Type.Int, kind: TExprKind.IntLit(hi, None) } } }
                test := TExpr { ty: Type.Bool, kind: TExprKind.Binary { op: BinOp.And, overflow: false, line: 0, lhs: ^ge, rhs: ^le } }
