                Pattern.Present { binding, .. } => (binding.clone(), match subj.ty { Type.Option(inner) => Some(inner.clone()), _ => None })
                Pattern.Ok { binding, .. } => (binding.clone(), match subj.ty { Type.Result { ok, .. } => Some(ok.clone()), _ => None })
