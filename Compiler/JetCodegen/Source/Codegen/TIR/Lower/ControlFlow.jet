                        if has_binding && binding != source_name { prelude.push(TStmt.Let { name: binding.clone(), kw: if mutable { "let mut" } else { "let" }, let_ty: TLetTy.inferred(), init: ^subj, gc_promotion: None, gc_transferred: false }) }
