//RS /// D-PARSESTR1: build the Rust closure body that scans the subject against a
//RS /// str-match pattern's literal anchors and holes, returning
//RS /// `Option<(T1, T2, ...)>` (`None` on any anchor miss or failed typed read).
//RS /// Holes are non-greedy and anchored: since E0147 already rejected adjacent
//RS /// holes at parse time, the next literal anchor (or end-of-string) always
//RS /// exists between/after every hole, so the scan never backtracks — each step
//RS /// is `starts_with`/`find` from the current cursor. Thin wrapper over
//RS /// `str_match_scan_closure_ex` in full-match mode (the `if == {}` shape).
//RS pub(super) fn str_match_scan_closure(pattern: &Pattern, cx: &Cx) -> (String, Vec<(String, Type)>) {
//RS     let Pattern::StrMatch { parts, .. } = pattern else {
//RS         return ("(|| -> Option<()> { Some(()) })()".to_string(), Vec::new());
//RS     };
