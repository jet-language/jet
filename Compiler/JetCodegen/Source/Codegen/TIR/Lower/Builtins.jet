//RS                 }
//RS                 other => other,
//RS             }
//RS         } else {
//RS             ty
//RS         });
//RS     }
//RS     if let Expr::MethodCall {
//RS         receiver: call_receiver,
//RS         method: call_method,
//RS         resolved_ret,
//RS         ..
//RS     } = receiver
//RS     {
//RS         // Fixed Core aliases (for example `files.read(path)`) are represented
//RS         // as MethodCall nodes. Sema intentionally leaves monomorphic fixed
//RS         // returns off that node because lowering reads the authoritative
