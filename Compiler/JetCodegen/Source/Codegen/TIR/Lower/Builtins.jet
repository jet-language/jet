//RS     loop {
//RS         match receiver {
//RS             Expr::Paren(inner, _) | Expr::Copy(inner, _) => receiver = inner,
//RS             Expr::Try(inner, ..) => {
//RS                 unwrap_carrier = true;
//RS                 receiver = inner;
//RS             }
//RS             _ => break,
//RS         }
//RS     }
//RS     if let Some(ty) = tir_recv_jet_ty(receiver, env) {
//RS         return Some(if unwrap_carrier {
//RS             match ty {
//RS                 Type::Result { ok, .. } | Type::Option(ok) => {
