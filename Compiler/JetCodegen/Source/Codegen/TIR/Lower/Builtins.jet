use jet_foundation.[Expr, IndexKind, Type, Span, CallArg, CtValue, NamedType]
use jet_codegen.Codegen.Context.[Cx]
use jet_codegen.TIR.[ListRemoveMode, LowerEnv, TBuiltinOp, TClosureOp, TExpr, TExprKind, TZipMode, TZipFillMode, lower_expr, struct_field_type, tir_recv_jet_ty, builtin_dispatch_ty]
use jet_codegen.Tuples.[tuple_struct_name]
use jet_collections.[builtin_method_return, builtin_receiver_borrow, BuiltinReceiverBorrow, is_closure_method, is_iter_type]
use jet_sema.[core_fixed_sig]
use jet_syntax as Syntax

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/builtins.rs:14
fn invariant_expr(span: Span, construct: String) -> TExpr {
    TExpr{ty: Type.Named(Syntax.TYPE_NEVER), kind: TExprKind.InvariantViolation{construct: construct, span: span}}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/builtins.rs:23
fn base_receiver_ty(ty: Type) -> Type {
    if ty == .Tagged(_, inner) -> base_receiver_ty(inner) else -> ty
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/builtins.rs:30
fn sequence_elem_ty(ty: Type) -> Type? {
    if ty == {
        .Tagged(_, inner) -> sequence_elem_ty(inner)
        .List(inner) | .FixedList(inner, _) -> Val(~inner)
        .Apply(name, args) if args.len() == 1 && (name == Syntax.TYPE_ITER || name == Syntax.TYPE_VIEW_ITER || name == "View" || name == "ViewMut" || name == "ComputeViewMut") -> Val(~args[0])
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/builtins.rs:51
fn list_receiver(ty: Type) -> Bool {
    if ty == { .Tagged(_, inner) -> list_receiver(inner); .List(_) | .FixedList(_, _) -> true; else -> false }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/builtins.rs:59
fn view_receiver(ty: Type) -> Bool {
    if base_receiver_ty(ty) == .Apply(name, args) -> args.len() == 1 && (name == "View" || name == "ViewMut" || name == "ComputeViewMut")
    else -> false
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/builtins.rs:67
fn remove_mode_variant(variant: String) -> ListRemoveMode? {
    short :: if variant == "Val" || variant == "Slot" -> variant else -> variant.strip_prefix(Syntax.GENERATED_NAME_PREFIX) ?? return None
    if short == { "Val" -> Val(ListRemoveMode.Value); "Slot" -> Val(ListRemoveMode.Slot); else -> None }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/builtins.rs:89
pub fn wrap_set_receiver_as_list(recv: TExpr, span: Span) -> TExpr {
    if recv.ty != .Apply(name, args) -> return ^recv
    if name != "Set" && name != Syntax.TYPE_RANK -> return ^recv
    if args.is_empty() -> return invariant_expr(span, "set receiver missing element type")
    if args.len() != 1 -> return invariant_expr(span, "set receiver has invalid generic arity")
    op :: if name == "Set" -> TBuiltinOp.SetToList else -> TBuiltinOp.SortedSetToList
    TExpr{ty: Type.List(~args[0]), kind: TExprKind.BuiltinMethod{recv: ^recv, op: op, args: []}}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/builtins.rs:119
fn tuple_fields(ty: Type?) -> [(String, Type)]? {
    value :: ty ?? return None
    if value == {
        .Tagged(_, inner) -> tuple_fields(Val(inner))
        .Tuple(fields) -> {
            out := [(String, Type)]{}
            loop field in fields -> &out.push((field.name, ~field.ty))
            Val(^out)
        }
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/builtins.rs:132
fn tuple_list_elem_fields(ty: Type?) -> [(String, Type)]? {
    value :: ty ?? return None
    inner :: sequence_elem_ty(value) ?? return None
    tuple_fields(Val(inner))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/builtins.rs:138
fn option_tuple_fields(ty: Type?) -> [(String, Type)]? {
    value :: ty ?? return None
    if value == { .Tagged(_, inner) -> option_tuple_fields(Val(inner)); .Option(inner) -> tuple_fields(Val(inner)); else -> None }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/builtins.rs:146
fn result_tuple_fields(ty: Type?) -> [(String, Type)]? {
    value :: ty ?? return None
    if value == { .Tagged(_, inner) -> result_tuple_fields(Val(inner)); .Result(ok, _) -> tuple_fields(Val(ok)); else -> None }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/builtins.rs:159
pub fn pool_field_ty_hint(e: Expr, cx: Cx, env: LowerEnv) -> Type? {
    if e != .Field(base, field, _) -> return None
    if base != .Index(pool_expr, _, _, IndexKind.Pool) -> return None
    pool_ty :: tir_recv_jet_ty(pool_expr, env) ?? return None
    if pool_ty != .Apply(_, args) || args.is_empty() -> return None
    struct_field_type(cx, args[0], field)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/builtins.rs:185
pub fn declared_field_ty(e: Expr, cx: Cx, env: LowerEnv) -> Type? {
    if e == {
        .Paren(inner, _) | .Copy(inner, _) -> declared_field_ty(inner, cx, env)
        .Index(base, _, _, _) -> {
            base_ty :: tir_recv_jet_ty(base, env) ?? declared_field_ty(base, cx, env) ?? return None
            if base_ty == { .List(inner) | .FixedList(inner, _) -> Val(inner); else -> None }
        }
        .Field(base, field, _) -> {
            base_ty :: tir_recv_jet_ty(base, env) ?? declared_field_ty(base, cx, env) ?? return None
            struct_field_type(cx, base_ty, field)
        }
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/builtins.rs:226
fn builtin_recv_ty(receiver: Expr, method: String, nargs: USize, cx: Cx, env: LowerEnv) -> Type? {
    current := receiver
    unwrap_carrier := false
    loop {
        if current == {
            .Paren(inner, _) | .Copy(inner, _) -> current = inner
            .Try(inner, _, _, _) -> { unwrap_carrier = true; current = inner }
            else -> break
        }
    }
    if tir_recv_jet_ty(current, env) == .Val(ty) {
        if unwrap_carrier {
            if ty == .Result(ok, _) | .Option(ok) -> return Val(builtin_dispatch_ty(ok))
        }
        return Val(ty)
    }
    if current == .MethodCall(call_receiver, call_method, _, _, _, _, _, resolved_ret, _, _) {
        if call_receiver == .Ident(alias, _) && !env.locals.contains_key(alias) {
            if cx.core_import_module_for_function(env.fn_name, alias) == .Val(module) {
                ty := resolved_ret
                if ty == None {
                    if core_fixed_sig(module, call_method) == .Val((_, ret)) -> ty = ret
                }
                if ty == .Val(value) {
                    if unwrap_carrier {
                        if value == .Result(ok, _) | .Option(ok) -> return Val(builtin_dispatch_ty(ok))
                    }
                    return Val(value)
                }
            }
        }
    }
    field_ty :: declared_field_ty(current, cx, env) ?? return None
    ty :: builtin_dispatch_ty(field_ty)
    if builtin_method_return(ty, method, nargs, false) != None -> Val(ty) else -> None
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/builtins.rs:306
pub fn lower_string_view_init(init: Expr, cx: Cx, env: &LowerEnv) -> TExpr {
    if init != .MethodCall(receiver, method, method_span, _, _, args, _, resolved_ret, _, _) -> return invariant_expr(init.span(), "string-view initializer shape")
    op :: if method == {
        "trim" -> TBuiltinOp.TrimView
        "after" -> TBuiltinOp.AfterView
        "before" -> TBuiltinOp.BeforeView
        else -> return invariant_expr(method_span, "string-view method")
    }
    row :: builtin_method_return(Type.String, method, args.len(), false) ?? return invariant_expr(method_span, "string-view signature")
    table_ret :: row ?? return invariant_expr(method_span, "string-view signature")
    if resolved_ret == .Val(ret) && ret != table_ret -> return invariant_expr(method_span, "string-view return type")
    recv :: lower_expr(receiver, cx, env)
    if recv.ty != Type.String -> return invariant_expr(method_span, "string-view receiver type")
    targs := [TExpr]{}
    loop arg in args -> &targs.push(lower_expr(arg.expr, cx, env))
    TExpr{ty: Type.Apply("View", [Type.Named("str")]), kind: TExprKind.BuiltinMethod{recv: ^recv, op: op, args: ^targs}}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/builtins.rs:362
pub fn resolve_builtin_op(receiver: Expr, method: String, method_span: Span, args: [CallArg], resolved_ret: Type?, receiver_ty: Type?, env: LowerEnv, cx: Cx) -> TBuiltinOp? {
    rty :: if receiver_ty == .Val(ty) -> builtin_dispatch_ty(~ty) else -> builtin_recv_ty(receiver, method, args.len(), cx, env) ?? return None
    if rty == .Apply(name, generic_args) && name == "Atomic" && generic_args.len() == 1 && builtin_method_return(rty, method, args.len(), false) != None -> return Val(TBuiltinOp.AtomicMethod{method: method})
    if rty == .Named(name) && name == Syntax.TYPE_ORDERING {
        return if (method, args.len()) == { ("then", 1) -> Val(TBuiltinOp.OrderingThen); ("reverse", 0) -> Val(TBuiltinOp.OrderingReverse); else -> None }
    }
    is_byte_buffer :: if rty == .Named(name) -> name == Syntax.TYPE_BYTES else -> false
    // Cursor read must precede the iterator closure-method early-out.
    if is_byte_buffer {
        op :: if (method, args.len()) == {
            ("write_u8" | "write_byte" | "write_i8" | "write_u16_le" | "write_u16_be" | "write_i16_le" | "write_i16_be" | "write_u32_le" | "write_u32_be" | "write_i32_le" | "write_i32_be" | "write_u64_le" | "write_u64_be" | "write_i64_le" | "write_i64_be" | "write_f32_le" | "write_f32_be" | "write_f64_le" | "write_f64_be" | "write_bytes" | "write", 1) -> TBuiltinOp.ByteBufferWrite{method: method}
            ("to_bytes", 0) -> TBuiltinOp.ByteBufferToBytes
            ("len" | "is_empty" | "clear" | "capacity" | "position" | "eof" | "rewind" | "flush" | "close" | "shutdown" | "get_buffer" | "buffer" | "to_string" | "string" | "trim" | "trim_start" | "trim_end" | "to_lower" | "to_upper" | "to_title" | "title" | "clone" | "copy" | "lines" | "first" | "next" | "read_byte" | "read" | "is_ascii" | "parse", 0) |
            ("get" | "seek" | "read_bytes" | "read_string" | "contains" | "starts_with" | "ends_with" | "index_of" | "last_index_of" | "split" | "partition" | "join" | "equal" | "compare" | "copy_to" | "write_to", 1) | ("replace", 2) -> TBuiltinOp.ByteBufferMethod{method: method}
            else -> return None
        }
        emitted_borrow :: if op == {
            .ByteBufferWrite(_) -> BuiltinReceiverBorrow.TwoPhaseWrite
            .ByteBufferMethod("clear" | "seek" | "rewind" | "next" | "read" | "read_byte" | "read_bytes" | "read_string" | "flush" | "close" | "shutdown" | "copy_to" | "write_to") -> BuiltinReceiverBorrow.TwoPhaseWrite
            .ByteBufferToBytes | .ByteBufferMethod(_) -> BuiltinReceiverBorrow.Read
            else -> return None
        }
        if builtin_receiver_borrow(rty, method) != emitted_borrow -> return None
        return Val(^op)
    }
    is_option :: if rty == .Option(_) -> true else -> false
    if builtin_method_return(rty, method, args.len(), false) == None && !(is_option && method == "zip" && args.len() == 1) -> return None
    is_string :: rty == Type.String
    if is_closure_method(method) && !is_string -> return None
    is_list :: list_receiver(rty)
    is_map :: if rty == .Map(_, _, _) -> true else -> false
    is_set :: if rty == .Apply(name, _) -> name == "Set" else -> false
    is_sorted_set :: if rty == .Apply(name, _) -> name == Syntax.TYPE_RANK else -> false
    is_priority_queue :: if rty == .Apply(name, _) -> name == Syntax.TYPE_PRIORITY_QUEUE else -> false
    is_lru :: if rty == .Apply(name, _) -> name == Syntax.TYPE_LRU else -> false
    is_bag :: if rty == .Apply(name, _) -> name == Syntax.TYPE_TALLY else -> false
    is_bit_set :: if rty == .Named(name) -> name == Syntax.TYPE_BITS else -> false
    is_deque :: if rty == .Apply(name, _) -> name == Syntax.TYPE_QUEUE else -> false
    is_iter :: is_iter_type(rty)
    is_float_sequence := false
    if rty == .List(elem) | .FixedList(elem, _) -> is_float_sequence = elem == Type.Float || elem == Type.Float32
    if rty == .Apply(name, generic_args) && name == Syntax.TYPE_ITER && generic_args.len() == 1 -> is_float_sequence = generic_args[0] == Type.Float || generic_args[0] == Type.Float32
    if resolved_ret == .Val(Type.Option(elem)) && (elem == Type.Float || elem == Type.Float32) -> is_float_sequence = true
    receiver_borrow :: builtin_receiver_borrow(rty, method)
    list_remove_mode := None as ListRemoveMode?
    if method == "remove" && args.len() == 1 -> list_remove_mode = Val(ListRemoveMode.Value)
    else if method == "remove" && args.len() == 2 {
        if args[1].expr == .EnumLit(_, variant, _, _, _, _) -> list_remove_mode = remove_mode_variant(variant)
        else if args[1].expr == .Ident(name, _) {
            if cx.const_values.get(name) == .Val(CtValue.Enum(type_name, variant, _)) && type_name == Syntax.TYPE_REMOVE_BY -> list_remove_mode = remove_mode_variant(variant)
            else if rty == .List(Type.Int) -> list_remove_mode = Val(ListRemoveMode.Dynamic)
        } else if rty == .List(Type.Int) -> list_remove_mode = Val(ListRemoveMode.Dynamic)
    }
    op :: if (method, args.len()) == {
        ("len", 0) -> if is_string -> TBuiltinOp.LenString else if is_bag -> TBuiltinOp.BagLen else -> TBuiltinOp.LenList
        ("is_empty", 0) -> TBuiltinOp.IsEmpty
        ("try_push", 1) if is_string -> TBuiltinOp.TryStringPush
        ("try_push", 1) if is_list -> TBuiltinOp.TryPush
        ("try_reserve", 1) if is_list -> TBuiltinOp.TryReserve
        ("try_insert", 2) if is_map -> TBuiltinOp.TryInsertMap
        ("push" | "append", 1) -> TBuiltinOp.Push
        ("pop", 0) if is_priority_queue -> TBuiltinOp.PriorityQueuePop
        ("pop", 0) -> TBuiltinOp.Pop
        ("insert", 2) -> TBuiltinOp.InsertList
        ("add", 2) if is_map -> TBuiltinOp.InsertMap
        ("add_new", 2) if is_map -> TBuiltinOp.AddNewMap
        ("setdefault", 2) if is_map -> TBuiltinOp.MapSetDefault
        ("update", 1) if is_map -> TBuiltinOp.MapUpdate
        ("merge", 1) if is_map -> TBuiltinOp.MapMerge
        ("merge", 2) if is_map -> TBuiltinOp.MapMergeWith
        ("take", 1) if is_set -> TBuiltinOp.SetPop
        ("pop", 1) if is_set -> TBuiltinOp.SetPop
        ("pop", 1) if is_map || is_lru -> TBuiltinOp.RemoveMap
        ("pop_first", 0) if is_map -> TBuiltinOp.MapPopFirst
        ("contains_value", 1) if is_map -> TBuiltinOp.MapContainsValue
        ("remove" | "discard", 1 | 2) -> {
            if is_set -> TBuiltinOp.SetRemove
            else if is_sorted_set -> TBuiltinOp.SortedSetRemove
            else if is_bit_set -> TBuiltinOp.BitSetRemove
            else if is_bag -> TBuiltinOp.BagRemove
            else if is_map || is_lru -> TBuiltinOp.RemoveMap
            else if is_priority_queue {
                mode :: list_remove_mode ?? return None
                TBuiltinOp.PriorityQueueRemove{line: cx.src_line_col(method_span.start).0, mode: mode}
            } else if is_list {
                mode :: list_remove_mode ?? return None
                TBuiltinOp.RemoveList{line: cx.src_line_col(method_span.start).0, mode: mode}
            } else -> return None
        }
        ("get", 1) -> if is_deque -> TBuiltinOp.DequeGet else if is_lru -> TBuiltinOp.LruGet else if is_map -> TBuiltinOp.GetMap else -> TBuiltinOp.GetList
        ("first", 0) if is_map -> TBuiltinOp.MapFirst
        ("first", 0) if is_set -> TBuiltinOp.SetFirst
        ("first", 0) if is_sorted_set -> TBuiltinOp.First
        ("last", 0) if is_sorted_set -> TBuiltinOp.Last
        ("first", 0) -> TBuiltinOp.First
        ("last", 0) -> TBuiltinOp.Last
        ("contains", 1) if is_deque -> TBuiltinOp.DequeContains
        ("contains", 1) -> TBuiltinOp.Contains
        ("has", 1) if is_set || is_sorted_set || is_bit_set -> TBuiltinOp.Contains
        ("index_of" | "index", 1) if is_string -> TBuiltinOp.StringIndexOf
        ("index_of" | "index", 1) -> TBuiltinOp.IndexOf
        ("reverse", 0) if is_deque -> TBuiltinOp.DequeReverse
        ("reverse", 0) if is_string -> TBuiltinOp.StringMethod{method: "reverse"}
        ("reverse", 0) -> TBuiltinOp.Reverse
        ("sort", 0) if is_set -> TBuiltinOp.SetSort
        ("sort", 0) -> TBuiltinOp.Sort
        ("sort_desc", 0) -> TBuiltinOp.SortDesc
        ("join", 1) if is_deque -> TBuiltinOp.DequeJoin
        ("join", 1) -> TBuiltinOp.JoinSep
        ("split", 1) if is_deque -> TBuiltinOp.DequeSplit
        ("split", 1) if is_string -> TBuiltinOp.Split
        ("split", 1) -> {
            fields := [(String, Type)]{}
            if resolved_ret == .Val(ret) -> fields = tuple_fields(Val(ret)) ?? return None
            else {
                elem :: sequence_elem_ty(rty) ?? return None
                list_ty :: Type.List(^elem)
                fields = [("left", ~list_ty), ("right", ^list_ty)]
            }
            TBuiltinOp.IterSplit{tuple_struct: tuple_struct_name(fields)}
        }
        ("repeat", 1) if is_string -> TBuiltinOp.Repeat
        ("repeat", 1) -> TBuiltinOp.IterRepeat
        ("cycle", 1) -> TBuiltinOp.IterCycle
        ("drop_last", 1) -> TBuiltinOp.IterDropLast
        ("next", 0) if is_iter -> TBuiltinOp.IterNext
        ("shuffle", 0) if is_set -> TBuiltinOp.SetShuffle
        ("rindex", 1) if is_string -> TBuiltinOp.StringMethod{method: "last_index_of"}
        ("last_index_of", 1) if is_string -> TBuiltinOp.StringMethod{method: "last_index_of"}
        ("last_index_of", 1) -> TBuiltinOp.IterLastIndexOf
        ("average", 0) -> TBuiltinOp.IterAverage{float: is_float_sequence}
        ("compare", 1) if is_string -> TBuiltinOp.StringMethod{method: "compare"}
        ("compare", 1) -> TBuiltinOp.IterCompare
        ("is_sorted", 0) -> TBuiltinOp.IterIsSorted
        ("shuffle", 0) -> TBuiltinOp.IterShuffle
        ("to_set", 0) if is_set -> TBuiltinOp.SetCopy
        ("to_set", 0) -> TBuiltinOp.SetFrom
        ("sum", 0) -> TBuiltinOp.Sum{float: resolved_ret == Val(Type.Float) || resolved_ret == Val(Type.Float32), f32: resolved_ret == Val(Type.Float32)}
        ("product", 0) -> TBuiltinOp.Product{float: resolved_ret == Val(Type.Float) || resolved_ret == Val(Type.Float32)}
        ("min", 0) if is_map -> TBuiltinOp.MapMin
        ("max", 0) if is_map -> TBuiltinOp.MapMax
        ("min", 0) -> TBuiltinOp.Min{float: is_float_sequence}
        ("max", 0) -> TBuiltinOp.Max{float: is_float_sequence}
        ("flatten", 0) -> TBuiltinOp.Flatten
        ("intersperse", 1) -> TBuiltinOp.Intersperse
        ("clear", 0) -> TBuiltinOp.Clear
        ("chars", 0) -> TBuiltinOp.Chars
        ("bytes" | "encode", 0) if is_string -> TBuiltinOp.Bytes{owned: false}
        ("strip" | "lstrip" | "rstrip", 0) if is_string -> TBuiltinOp.StringMethod{method: method}
        ("trim", 0) -> TBuiltinOp.Trim
        ("trim_start", 0) -> TBuiltinOp.TrimStart
        ("trim_end", 0) -> TBuiltinOp.TrimEnd
        ("lines" | "splitlines", 0) -> TBuiltinOp.Lines
        ("starts_with" | "startswith", 1) -> TBuiltinOp.StartsWith
        ("ends_with" | "endswith", 1) -> TBuiltinOp.EndsWith
        ("expandtabs", 1) if is_string -> TBuiltinOp.StringMethod{method: method}
        ("find" | "rfind" | "partition" | "rpartition", 1) if is_string -> TBuiltinOp.StringMethod{method: method}
        ("center" | "ljust" | "rjust", 2) if is_string -> TBuiltinOp.StringMethod{method: method}
        ("zfill", 1) if is_string -> TBuiltinOp.StringMethod{method: method}
        ("replace", 2) if is_string -> TBuiltinOp.StringMethod{method: "replace"}
        ("replace", 1) if is_set -> TBuiltinOp.SetReplace
        ("replace", 2) if is_map -> TBuiltinOp.InsertMap
        ("replace", 2) if is_list -> TBuiltinOp.ListReplace
        ("replace", 2) -> TBuiltinOp.Replace
        ("pad_start", 2) -> TBuiltinOp.PadStart
        ("pad_end", 2) -> TBuiltinOp.PadEnd
        ("count", 1) if is_list -> TBuiltinOp.CountList
        ("count", 1) if is_string -> TBuiltinOp.StringCount
        ("counts", 0) if is_list || is_iter -> TBuiltinOp.Counts
        ("extend", 1) if is_list -> TBuiltinOp.ExtendList
        ("concat", 1) if is_list -> TBuiltinOp.ConcatList
        ("is_alphabetic", 0) if is_string -> TBuiltinOp.StringIsAlphabetic
        ("is_numeric", 0) if is_string -> TBuiltinOp.StringIsNumeric
        ("is_whitespace", 0) if is_string -> TBuiltinOp.StringIsWhitespace
        ("is_ascii", 0) if is_string -> TBuiltinOp.StringIsAscii
        ("to_title", 0) if is_string -> TBuiltinOp.StringToTitle
        ("count_bytes" | "is_lower" | "is_upper" | "capitalize" | "swapcase" | "copy" | "normalize" | "isalnum" | "isalpha" | "isascii" | "isdecimal" | "isdigit" | "isidentifier" | "isnumeric" | "isprintable" | "isspace" | "istitle" | "islower" | "isupper" | "lower" | "upper" | "title" | "casefold", 0) if is_string -> TBuiltinOp.StringMethod{method: method}
        ("remove_prefix" | "remove_suffix" | "removeprefix" | "removesuffix" | "equal" | "rsplit" | "matches" | "match", 1) if is_string -> TBuiltinOp.StringMethod{method: method}
        ("parse" | "to_int", 0) if is_string -> TBuiltinOp.ParseInt
        ("to_float", 0) if is_string -> TBuiltinOp.ParseFloat
        ("split_once", 1) if is_string -> {
            ret := resolved_ret
            if ret == None { row :: builtin_method_return(Type.String, method, args.len(), false) ?? return None; ret = row }
            fields :: option_tuple_fields(ret) ?? return None
            TBuiltinOp.StringSplitOnce{tuple_struct: tuple_struct_name(fields)}
        }
        ("cut_last", 1) if is_string -> {
            ret := resolved_ret
            if ret == None { row :: builtin_method_return(Type.String, method, args.len(), false) ?? return None; ret = row }
            fields :: option_tuple_fields(ret) ?? return None
            TBuiltinOp.StringCutLast{tuple_struct: tuple_struct_name(fields)}
        }
        ("after", 1) -> TBuiltinOp.After
        ("before", 1) -> TBuiltinOp.Before
        ("to_upper", 0) -> TBuiltinOp.ToUpper
        ("to_lower", 0) -> TBuiltinOp.ToLower
        ("to_ascii_upper", 0) if is_string -> TBuiltinOp.ToAsciiUpper
        ("to_ascii_lower", 0) if is_string -> TBuiltinOp.ToAsciiLower
        ("slice", 2) if is_string -> TBuiltinOp.Slice{line: cx.src_line_col(receiver.span().start).0}
        ("slice", 2) -> TBuiltinOp.ListSlice
        ("slice", 1) if is_map -> TBuiltinOp.MapSliceKeys
        ("copy", 0) if is_map -> TBuiltinOp.MapCopy
        ("copy", 0) if is_set -> TBuiltinOp.SetCopy
        ("copy", 0) if is_bit_set -> TBuiltinOp.BitSetCopy
        ("copy", 0) -> TBuiltinOp.ListCopy
        ("equal", 1) if is_map -> TBuiltinOp.MapEqual
        ("equal", 1) if is_set -> TBuiltinOp.SetEqual
        ("equal", 1) -> TBuiltinOp.ListEqual
        ("binary_search", 1) -> TBuiltinOp.ListBinarySearch
        ("union", 1) if is_sorted_set -> TBuiltinOp.SortedSetUnion
        ("union", 1) if is_set -> TBuiltinOp.SetUnion
        ("union", 1) -> TBuiltinOp.ListUnion
        ("intersection", 1) if is_sorted_set -> TBuiltinOp.SortedSetIntersection
        ("intersection", 1) if is_set -> TBuiltinOp.SetIntersection
        ("intersection", 1) if is_map -> TBuiltinOp.MapIntersection
        ("intersection", 1) -> TBuiltinOp.ListIntersection
        ("difference", 1) if is_sorted_set -> TBuiltinOp.SortedSetDifference
        ("difference", 1) if is_set -> TBuiltinOp.SetDifference
        ("difference", 1) -> TBuiltinOp.ListDifference
        ("random", 0) -> TBuiltinOp.ListRandom
        ("min_max", 0) -> {
            fields := [(String, Type)]{}
            if resolved_ret == .Val(ret) -> fields = option_tuple_fields(Val(ret)) ?? return None
            else { elem :: sequence_elem_ty(rty) ?? return None; fields = [("min", ~elem), ("max", ^elem)] }
            TBuiltinOp.ListMinMax{tuple_struct: tuple_struct_name(fields)}
        }
        ("to_list" | "items", 0) if is_map -> {
            fields := [(String, Type)]{}
            if resolved_ret == .Val(ret) -> fields = tuple_list_elem_fields(Val(ret)) ?? return None
            else { if rty != .Map(key, _, value) -> return None; fields = [("key", ~key), ("value", ~value)] }
            TBuiltinOp.MapToList{tuple_struct: tuple_struct_name(fields)}
        }
        ("top_n", 1) if is_map -> {
            fields := [(String, Type)]{}
            if resolved_ret == .Val(ret) -> fields = tuple_list_elem_fields(Val(ret)) ?? return None
            else { if rty != .Map(key, _, value) -> return None; fields = [("key", ~key), ("value", ~value)] }
            TBuiltinOp.MapTopN{tuple_struct: tuple_struct_name(fields)}
        }
        ("view", 2) -> TBuiltinOp.ViewNew{line: cx.src_line_col(receiver.span().start).0}
        ("split_write", 1) -> {
            fields := [(String, Type)]{}
            if resolved_ret == .Val(ret) -> fields = result_tuple_fields(Val(ret)) ?? return None
            else {
                elem :: sequence_elem_ty(rty) ?? return None
                view :: Type.Apply("ViewMut", [^elem])
                fields = [("left", ~view), ("right", ^view)]
            }
            TBuiltinOp.SplitWrite{tuple_struct: tuple_struct_name(fields)}
        }
        ("get_disjoint_write", 1) -> TBuiltinOp.GetDisjointWrite
        ("keys", 0) if is_lru -> TBuiltinOp.LruKeys
        ("keys", 0) -> TBuiltinOp.Keys
        ("values", 0) if is_set -> TBuiltinOp.SetValues
        ("values", 0) -> TBuiltinOp.Values
        ("has_key", 1) -> TBuiltinOp.ContainsKey
        ("to_string", 0) -> TBuiltinOp.ToString
        ("take", 1) -> TBuiltinOp.Take
        ("skip", 1) -> TBuiltinOp.Skip
        ("step_by", 1) -> TBuiltinOp.StepBy
        ("dedup", 0) -> TBuiltinOp.Dedup
        ("chunks", 1) -> TBuiltinOp.Chunks
        ("windows", 1) -> TBuiltinOp.Windows
        ("indexed", 0) -> {
            fields := [(String, Type)]{}
            if resolved_ret == .Val(ret) -> fields = tuple_list_elem_fields(Val(ret)) ?? return None
            else { elem :: sequence_elem_ty(rty) ?? return None; fields = [("idx", Type.Int), ("item", ^elem)] }
            TBuiltinOp.Indexed{tuple_struct: tuple_struct_name(fields)}
        }
        ("indexes", 0) -> TBuiltinOp.Indexes
        ("zip", 1) if is_option -> {
            fields :: option_tuple_fields(resolved_ret) ?? return None
            rows := [NamedType]{}
            loop (name, ty) in fields -> &rows.push(NamedType{name: name, ty: ~ty})
            TBuiltinOp.OptionZip{tuple_struct: tuple_struct_name(fields), elem_ty: Type.Tuple(^rows)}
        }
        ("zip", 1) -> {
            fields :: tuple_list_elem_fields(resolved_ret) ?? return None
            field_types := [Type]{}
            names := [String]{}
            loop (name, ty) in fields { &field_types.push(~ty); &names.push(name) }
            TBuiltinOp.Zip{tuple_struct: tuple_struct_name(fields), mode: TZipMode.Strict, fields: ^names, flatten: false, input_count: 2, fill_mode: TZipFillMode.DefaultNone, field_types: ^field_types}
        }
        ("unzip", 0) -> {
            fields := [(String, Type)]{}
            if resolved_ret == .Val(ret) -> fields = tuple_fields(Val(ret)) ?? return None
            else {
                pair :: sequence_elem_ty(rty) ?? return None
                pair_fields :: tuple_fields(Val(pair)) ?? return None
                a_ty := None as Type?
                b_ty := None as Type?
                loop (name, ty) in pair_fields {
                    if name == "a" && a_ty == None -> a_ty = Val(~ty)
                    if name == "b" && b_ty == None -> b_ty = Val(~ty)
                }
                a :: a_ty ?? return None
                b :: b_ty ?? return None
                fields = [("a", Type.List(^a)), ("b", Type.List(^b))]
            }
            TBuiltinOp.Unzip{tuple_struct: tuple_struct_name(fields)}
        }
        ("try_collect", 0) -> TBuiltinOp.TryCollect
        ("add", 1) if is_set -> TBuiltinOp.SetInsert
        ("update", 1) if is_set -> TBuiltinOp.SetUpdate
        ("difference_update", 1) if is_set -> TBuiltinOp.SetDifferenceUpdate
        ("intersection_update", 1) if is_set -> TBuiltinOp.SetIntersectionUpdate
        ("symmetric_difference_update", 1) if is_set -> TBuiltinOp.SetSymmetricDifferenceUpdate
        ("add", 1) if is_sorted_set -> TBuiltinOp.SortedSetInsert
        ("add", 1) if is_bit_set -> TBuiltinOp.BitSetAdd
        ("add", 1) if is_bag -> TBuiltinOp.BagAdd
        ("peek", 0) if is_priority_queue -> TBuiltinOp.PriorityQueuePeek
        ("to_sorted_list", 0) if is_priority_queue -> TBuiltinOp.PriorityQueueToSortedList
        ("to_list", 0) if is_iter -> TBuiltinOp.IterToList
        ("collect", 0) if is_iter -> TBuiltinOp.IterCollect
        ("lazy", 0) if is_list -> TBuiltinOp.ListLazy
        ("to_list", 0) if is_deque -> TBuiltinOp.DequeToList
        ("to_list", 0) if is_sorted_set -> TBuiltinOp.SortedSetToList
        ("to_list", 0) if is_bit_set -> TBuiltinOp.BitSetToList
        ("to_list", 0) -> TBuiltinOp.SetToList
        ("symmetric_difference", 1) if is_sorted_set -> TBuiltinOp.SortedSetSymmetricDifference
        ("is_subset", 1) if is_sorted_set -> TBuiltinOp.SortedSetIsSubset
        ("is_superset", 1) if is_sorted_set -> TBuiltinOp.SortedSetIsSuperset
        ("is_disjoint", 1) if is_sorted_set -> TBuiltinOp.SortedSetIsDisjoint
        ("symmetric_difference", 1) if is_set -> TBuiltinOp.SetSymmetricDifference
        ("is_subset" | "issubset", 1) if is_set -> TBuiltinOp.SetIsSubset
        ("is_superset" | "issuperset", 1) if is_set -> TBuiltinOp.SetIsSuperset
        ("is_disjoint" | "isdisjoint", 1) if is_set -> TBuiltinOp.SetIsDisjoint
        ("capacity", 0) if is_set -> TBuiltinOp.SetCapacity
        ("add", 2) if is_lru -> TBuiltinOp.LruPut
        ("add_new", 2) if is_lru -> TBuiltinOp.LruAddNew
        ("capacity", 0) if is_lru -> TBuiltinOp.LruCapacity
        ("count", 0) if is_bit_set -> TBuiltinOp.BitSetCount
        ("write_u8" | "write_i8" | "write_u16_le" | "write_u16_be" | "write_i16_le" | "write_i16_be" | "write_u32_le" | "write_u32_be" | "write_i32_le" | "write_i32_be" | "write_u64_le" | "write_u64_be" | "write_i64_le" | "write_i64_be" | "write_f32_le" | "write_f32_be" | "write_f64_le" | "write_f64_be" | "write_bytes", 1) if is_byte_buffer -> TBuiltinOp.ByteBufferWrite{method: method}
        ("to_bytes", 0) if is_byte_buffer -> TBuiltinOp.ByteBufferToBytes
        ("has", 1) if is_bag -> TBuiltinOp.BagHas
        ("count", 1) if is_bag -> TBuiltinOp.BagCount
        ("push_front", 1) if is_deque -> TBuiltinOp.DequePushFront
        ("push_back", 1) if is_deque -> TBuiltinOp.DequePushBack
        ("pop_front", 0) if is_deque -> TBuiltinOp.DequePopFront
        ("pop_back", 0) if is_deque -> TBuiltinOp.DequePopBack
        ("peek_front", 0) if is_deque -> TBuiltinOp.DequePeekFront
        ("peek_back", 0) if is_deque -> TBuiltinOp.DequePeekBack
        ("capacity", 0) if is_deque -> TBuiltinOp.DequeCapacity
        ("delete", 1) if is_deque -> TBuiltinOp.DequeDelete
        else -> return None
    }
    emitted_borrow :: if op == .IterNext -> BuiltinReceiverBorrow.EagerWrite
    else if is_iter -> BuiltinReceiverBorrow.Move
    else if op == {
        .RemoveList(_, _) | .SortDesc -> BuiltinReceiverBorrow.EagerWrite
        .Push | .TryPush | .TryReserve | .TryInsertMap | .TryStringPush | .Pop | .InsertMap | .InsertList | .AddNewMap | .MapSetDefault | .MapUpdate | .RemoveMap | .MapPopFirst | .ExtendList | .Reverse | .Sort | .Clear | .SetInsert | .SetUpdate | .SetDifferenceUpdate | .SetIntersectionUpdate | .SetSymmetricDifferenceUpdate | .SetPop | .SetRemove | .SetReplace | .PriorityQueuePop | .SortedSetInsert | .SortedSetRemove | .BitSetAdd | .BitSetRemove | .BagAdd | .BagRemove | .LruPut | .LruAddNew | .LruGet | .ByteBufferWrite(_) | .DequePushFront | .DequePushBack | .DequePopFront | .DequePopBack | .DequeDelete | .DequeReverse | .DequeSplit | .SplitWrite(_) | .GetDisjointWrite -> BuiltinReceiverBorrow.TwoPhaseWrite
        else -> BuiltinReceiverBorrow.Read
    }
    if receiver_borrow != emitted_borrow -> return None
    Val(^op)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/builtins.rs:1138
pub fn resolve_closure_op(recv_ty: Type, method: String, args: [CallArg], cx: Cx, fallible_callback: Bool, callback_needs_fn_mut: Bool?, callback_param_count: USize?) -> TClosureOp? {
    base :: base_receiver_ty(recv_ty)
    elem_ty :: sequence_elem_ty(base)
    is_sequence :: elem_ty != None
    is_list :: list_receiver(base)
    is_iter :: if base == .Apply(name, generic_args) -> generic_args.len() == 1 && (name == Syntax.TYPE_ITER || name == Syntax.TYPE_VIEW_ITER) else -> false
    is_map :: if base == .Map(_, _, _) -> true else -> false
    is_option :: if base == .Option(_) -> true else -> false
    is_bag :: if base == .Apply(name, _) -> name == Syntax.TYPE_TALLY else -> false
    is_view :: view_receiver(base)
    has_args :: |count: USize| -> Bool { args.len() == count }
    op :: if method == {
        "edit_disjoint" if is_list && has_args(2) -> TClosureOp.EditDisjoint
        "map" if is_option && has_args(1) -> TClosureOp.OptionMap
        "map" if is_map && has_args(1) -> TClosureOp.MapMap
        "map" if !is_sequence || !has_args(1) -> return None
        "map" if fallible_callback -> TClosureOp.TryMap
        "map" if is_view -> TClosureOp.ViewMap
        "map" -> if callback_needs_fn_mut == { .Val(true) -> TClosureOp.MapMut; .Val(false) -> TClosureOp.Map; else -> return None }
        "filter" if is_map && has_args(1) -> TClosureOp.MapFilter
        "filter" if !is_sequence || !has_args(1) -> return None
        "filter" if fallible_callback -> TClosureOp.TryFilter
        "filter" -> TClosureOp.Filter
        "each" if is_map && has_args(1) -> TClosureOp.EachMap
        "each" if !is_sequence || !has_args(1) -> return None
        "each" if is_list && elem_ty == .Val(elem) && list_carries_trait(cx, elem) -> TClosureOp.EachRef
        "each" -> if callback_needs_fn_mut == { .Val(true) -> TClosureOp.EachMut; .Val(false) -> TClosureOp.Each; else -> return None }
        "find" if is_sequence && has_args(1) -> TClosureOp.Find
        "any" if is_bag && has_args(1) -> TClosureOp.BagAny
        "any" if is_map && has_args(1) -> TClosureOp.MapAny
        "any" if is_sequence && has_args(1) -> TClosureOp.Any
        "all" if is_map && has_args(1) -> TClosureOp.MapAll
        "all" if is_sequence && has_args(1) -> TClosureOp.All
        "count_where" if is_sequence && has_args(1) -> TClosureOp.CountWhere
        "sort_by" if !is_list || !has_args(1) -> return None
        "sort_by" -> if (callback_param_count, fallible_callback) == {
            (.Val(1), true) -> TClosureOp.TrySortBy
            (.Val(1), false) -> TClosureOp.SortBy
            (.Val(2), false) -> TClosureOp.SortByCompare
            else -> return None
        }
        "sort_by_desc" if !is_list || !has_args(1) -> return None
        "sort_by_desc" -> if (callback_param_count, fallible_callback) == {
            (.Val(1), true) -> TClosureOp.TrySortByDesc
            (.Val(1), false) -> TClosureOp.SortByDesc
            else -> return None
        }
        "reduce" if (is_list || is_iter) && has_args(2) -> TClosureOp.Reduce
        "take_while" if is_sequence && has_args(1) -> TClosureOp.TakeWhile
        "skip_while" if is_sequence && has_args(1) -> TClosureOp.SkipWhile
        "flat_map" if is_map && has_args(1) -> TClosureOp.MapFlatMap
        "flat_map" if is_sequence && has_args(1) -> TClosureOp.FlatMap
        "binary_search_by" if is_list && has_args(1) -> TClosureOp.ListBinarySearchBy
        "min_max_by" if is_list && has_args(1) -> {
            elem :: elem_ty ?? return None
            fields :: [("min", ~elem), ("max", ~elem)]
            TClosureOp.ListMinMaxBy{tuple_struct: tuple_struct_name(fields)}
        }
        "filter_map" if is_sequence && has_args(1) -> TClosureOp.FilterMap
        "para_map" if is_list && (args.len() == 1 || args.len() == 2) -> TClosureOp.ParaMap
        "para_filter" if is_list && has_args(1) -> TClosureOp.ParaFilter
        "para_fold" if is_list && has_args(3) -> TClosureOp.ParaFold
        "para_partition" if is_list && has_args(1) -> {
            elem :: elem_ty ?? return None
            list_ty :: Type.List(~elem)
            fields :: [("false_", ~list_ty), ("true_", ^list_ty)]
            TClosureOp.ParaPartition{tuple_struct: tuple_struct_name(fields)}
        }
        "scan" if is_sequence && has_args(2) -> TClosureOp.Scan
        "fold" if is_map && has_args(2) -> TClosureOp.MapFold
        "fold" if is_view && has_args(2) -> TClosureOp.ViewFold
        "fold" if (is_list || is_iter) && has_args(2) -> TClosureOp.Fold
        "position" if is_sequence && has_args(1) -> TClosureOp.Position
        "min_by" if is_sequence && has_args(1) -> TClosureOp.MinBy
        "max_by" if is_sequence && has_args(1) -> TClosureOp.MaxBy
        "group_by" if is_sequence && has_args(1) -> TClosureOp.GroupBy
        "count_by" if is_sequence && has_args(1) -> TClosureOp.CountBy
        "update_first" if is_list && has_args(2) -> TClosureOp.UpdateFirst
        "dedup_by" if is_sequence && has_args(1) -> TClosureOp.DedupBy
        "is_sorted_by" if is_sequence && has_args(1) -> TClosureOp.IsSortedBy
        "chunk_while" if is_sequence && has_args(1) -> TClosureOp.ChunkWhile
        "partition" if is_sequence && has_args(1) -> {
            elem :: elem_ty ?? return None
            list_ty :: Type.List(~elem)
            fields :: [("false_", ~list_ty), ("true_", ^list_ty)]
            TClosureOp.Partition{tuple_struct: tuple_struct_name(fields)}
        }
        else -> return None
    }
    if op == .SortBy | .SortByDesc | .TrySortBy | .TrySortByDesc | .SortByCompare {
        if builtin_receiver_borrow(base, method) != BuiltinReceiverBorrow.EagerWrite -> return None
    }
    Val(^op)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/builtins.rs:1293
pub fn list_carries_trait(cx: Cx, inner: Type) -> Bool {
    if inner == { .TraitObject(_) -> true; .Named(n) -> cx.trait_names.contains(n); else -> false }
}
