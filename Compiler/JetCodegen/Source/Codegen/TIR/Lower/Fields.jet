//RS /// Replay codegen's `operand_is_integer` (Codegen/Expression.rs) on an AST
//RS /// operand, using the lowering env for identifier types. The result MUST match
//RS /// that function bit-for-bit so the TIR's overflow-trap decision is identical to
//RS /// the AST path's. Like the original: literals/negation/nested-arithmetic-left
//RS /// resolve structurally; an `Ident` resolves via its slot type; everything else
//RS /// (notably a struct-field read) is unresolved (`None`) and so never traps.
//RS pub(crate) fn ast_operand_is_integer(e: &Expr, env: &LowerEnv) -> Option<bool> {
//RS     match e {
//RS         Expr::Int(..) => Some(true),
//RS         Expr::Float(..) => Some(false),
//RS         Expr::Unary(UnOp::Neg, inner, _) => ast_operand_is_integer(inner, env),
//RS         Expr::Binary(_, l, _, _) => ast_operand_is_integer(l, env),
//RS         // Mirror `expr_jet_ty`: only `Ident`/`Str`/`Char` resolve here. A `Field`
//RS         // (and anything else) resolves to `None` — exactly as the AST path does,
//RS         // so a field operand never enables the overflow trap.
//RS         Expr::Ident(name, _) => env.ty_of(name).map(|t| t.is_integer()),
//RS         Expr::Str(..) => Some(false),
//RS         Expr::Char(..) => Some(false),
//RS         _ => None,
//RS     }
//RS }
//RS 
//RS /// Look up a field's declared type on a resolved struct receiver type. Returns
//RS /// `None` when the receiver is not a known struct or the field is absent — both
//RS /// impossible for a covered function (sema validated the access).
//RS ///
//RS /// A stored callable uses the effective `Result` carrier, the same as a `fn`
//RS /// parameter or a list element: a named function value always returns its
//RS /// carrier, so a raw `fn(T) U` field slot would read that carrier as `U`.
//RS pub(crate) fn struct_field_type(cx: &Cx, recv_ty: &Type, field: &str) -> Option<Type> {
//RS     declared_struct_field_type(cx, recv_ty, field).map(|ty| ty.with_effective_fn_returns())
//RS }
//RS 
//RS fn declared_struct_field_type(cx: &Cx, recv_ty: &Type, field: &str) -> Option<Type> {
//RS     // D-PIN2=A / D-PIN3=A: a pin is a window onto a place, so reaching a field
//RS     // through `Pin<T>` resolves against `T`. The field's own declared type is
