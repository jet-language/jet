// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:7
fn imported_type_name(owner: String, leaf: String) -> String { "{owner}::{leaf}" }

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:11
fn imported_type_owners(bundle: ProgramBundle, module_idx: USize) -> [String] {
    if bundle.name_ledger.module_identity(module_idx) == { Val(owner) -> [owner] None -> [] }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:23
fn impl_owner_module(bundle: ProgramBundle, module_idx: USize, type_name: String) -> USize {
    if module_owned_type_names(bundle.modules[module_idx].items).contains_key(type_name) { return module_idx }
    bundle.name_ledger.namespace_siblings(module_idx).find(fn(sibling) {
        bundle.modules.get(sibling).is_some_and(fn(module) { module_owned_type_names(module.items).contains_key(type_name) })
    }) ?? module_idx
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:44
fn module_owned_type_names(items: [Item]) -> [String:Bool] {
    names := [String:Bool]{}
    // Ordering belongs to the shared runtime, not a source module.
    loop item in items {
        if item == {
            Struct(definition) -> &names.insert(definition.name.clone(), true)
            Enum(definition) -> &names.insert(definition.name.clone(), true)
            UnitFamily(family) -> { loop member in family.distinct_defs() { &names.insert(member.name.clone(), true) } }
            Distinct(definition) -> &names.insert(definition.name.clone(), true)
            _ -> {}
        }
    }
    names
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:77
fn module_has_nominal_type(items: [Item], name: String) -> Bool {
    items.any(fn(item) {
        if item == {
            Struct(definition) -> definition.name == name
            Enum(definition) -> definition.name == name
            Distinct(definition) -> definition.name == name
            UnitFamily(family) -> family.distinct_defs().any(fn(member) { member.name == name })
            _ -> false
        }
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:90
fn nominal_import_target(bundle: ProgramBundle, module_idx: USize, import: ImportDecl) -> USize? {
    if import.core_module_path() == {
        Val(module) -> return core_source_target(bundle, module).map(fn(pair) { pair.1 })
        None -> {}
    }
    bundle.name_ledger.effective_alias(module_idx, import.import_alias()).and_then(fn(alias) { alias.target_module })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:104
// GATE #4499: cycle detection preserves structural (module index, name) keys.
fn canonical_nominal_name(bundle: ProgramBundle, module_idx: USize, name: String, owned: [String:Bool], mut seen: [(USize, String):Bool]) -> String? {
    if name.contains("::") { return Val(name.to_string()) }
    key :: (module_idx, name.to_string())
    if seen.contains_key(key) { return None }
    &seen.insert(key, true)
    if owned.contains_key(name) || module_has_nominal_type(bundle.modules[module_idx].items, name) {
        return bundle.name_ledger.nominal_identity(module_idx, name)
    }
    if name.rsplit_once('.') == {
        Val((namespace, leaf)) -> {
            target :: bundle.modules[module_idx].imports.find(fn(import) { import.import_alias() == namespace })
                .and_then(fn(import) { nominal_import_target(bundle, module_idx, import) })
                ?? bundle.name_ledger.effective_alias(module_idx, namespace).and_then(fn(alias) { alias.target_module })
                ?? return None
            return canonical_nominal_name(bundle, target, leaf, [:], &seen)
        }
        None -> {}
    }
    alias :: bundle.name_ledger.effective_alias(module_idx, name) ?? return None
    target :: alias.target_module ?? return None
    leaf :: alias.target.rsplit_once('.').map(fn(pair) { pair.1 }) ?? alias.target
    canonical_nominal_name(bundle, target, leaf, [:], &seen)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:146
fn canonical_nominal_from(bundle: ProgramBundle, module_idx: USize, name: String) -> String? {
    seen := [(USize, String):Bool]{}
    canonical_nominal_name(bundle, module_idx, name, [:], &seen)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:160
fn qualify_imported_nominal_name(bundle: ProgramBundle, target: USize, name: String, owned: [String:Bool], binders: [String]) -> String {
    if binders.any(fn(binder) { binder == name }) { return name.to_string() }
    seen := [(USize, String):Bool]{}
    canonical_nominal_name(bundle, target, name, owned, &seen) ?? name.to_string()
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:174
fn rewrite_apply_heads(ty: Type, qualify: fn(String) String) -> Type {
    if ty == {
        Apply{name, args} -> Type.Apply{name: qualify(name), args: loop arg in args -> rewrite_apply_heads(arg, qualify)}
        List(inner) -> Type.List(rewrite_apply_heads(inner, qualify))
        Map{key, key_span, value} -> Type.Map{key: rewrite_apply_heads(key, qualify), key_span: key_span, value: rewrite_apply_heads(value, qualify)}
        Shared(inner) -> Type.Shared(rewrite_apply_heads(inner, qualify))
        Option(inner) -> Type.Option(rewrite_apply_heads(inner, qualify))
        Result{ok, err} -> Type.Result{ok: rewrite_apply_heads(ok, qualify), err: rewrite_apply_heads(err, qualify)}
        Fn{params, ret, effect_bound, param_contract, return_view_provenance, call_metadata} -> Type.Fn{
            params: loop param in params -> rewrite_apply_heads(param, qualify),
            ret: ret.map(fn(ret) { rewrite_apply_heads(ret, qualify) }),
            effect_bound: effect_bound.clone(), param_contract: param_contract.clone(),
            return_view_provenance: return_view_provenance.clone(), call_metadata: call_metadata.clone(),
        }
        Tuple(fields) -> Type.Tuple(loop (name, field_ty) in fields -> (name.clone(), rewrite_apply_heads(field_ty, qualify)))
        FixedList{elem, len} -> Type.FixedList{elem: rewrite_apply_heads(elem, qualify), len: len.clone()}
        Tagged{marker, inner} -> Type.Tagged{marker: marker.clone(), inner: rewrite_apply_heads(inner, qualify)}
        Union(members) -> canonicalize_union(loop member in members -> rewrite_apply_heads(member, qualify))
        Quantity{base, dimension} -> Type.Quantity{base: rewrite_apply_heads(base, qualify), dimension: dimension.clone()}
        InlineRange{base, lo, hi} -> Type.InlineRange{base: rewrite_apply_heads(base, qualify), lo: lo, hi: hi}
        _ -> ty.clone()
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:255
fn qualify_imported_type(bundle: ProgramBundle, target: USize, _owner: String, binders: [String], ty: Type) -> Type {
    owned :: module_owned_type_names(bundle.modules[target].items)
    mapped :: ty.map_named_types(fn(name) {
        qualified :: qualify_imported_nominal_name(bundle, target, name, owned, binders)
        if qualified != name { Val(qualified) } else { None }
    })
    rewrite_apply_heads(mapped, fn(name) { qualify_imported_nominal_name(bundle, target, name, owned, binders) })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:275
fn register_imported_struct_shapes(mut cx: Cx, bundle: ProgramBundle, module_idx: USize) {
    module :: bundle.modules[module_idx]
    own_type_names :: module_owned_type_names(module.items)
    imported := [(USize, String)]{}
    loop import in module.imports {
        is_c :: import.is_c_import() catch error { panic("invalid foreign import reached codegen: {error.path}") }
        if is_c { continue }
        if import.core_module_path() == {
            Val(core_module) -> {
                if core_source_target(bundle, core_module) == {
                    Val((_, target)) -> {
                        loop item in bundle.modules[target].items {
                            if item == {
                                Struct(definition) -> {
                                    if core_leaf_kind(core_module, definition.name) != None { &imported.push((target, definition.name.clone())) }
                                }
                                _ -> {}
                            }
                        }
                    }
                    None -> {}
                }
                continue
            }
            None -> {}
        }
        target :: bundle.name_ledger.import_target(module_idx, import.span) ?? continue
        loop item in bundle.modules[target].items {
            if item == {
                Struct(definition) -> {
                    if bundle.name_ledger.visible(module_idx, target, definition.name) { &imported.push((target, definition.name.clone())) }
                }
                _ -> {}
            }
        }
    }
    &imported.extend(selective_nominal_targets(bundle, module_idx))
    loop ((_, _), (rust_mod, _)) in reexport_call_map(bundle, module_idx) {
        target :: bundle.modules.position(fn(candidate) { mangle(candidate.alias) == rust_mod }) ?? continue
        loop item in bundle.modules[target].items {
            if item == {
                Struct(definition) -> {
                    if bundle.name_ledger.visible(module_idx, target, definition.name) { &imported.push((target, definition.name.clone())) }
                }
                _ -> {}
            }
        }
    }
    &imported.sort()
    &imported.dedup()
    loop (target, definition_name) in imported {
        // Bare local declarations shadow imported leaves; qualified names do not.
        if own_type_names.contains_key(definition_name) { continue }
        item :: bundle.modules[target].items.find(fn(item) {
            if item == { Struct(definition) -> definition.name == definition_name _ -> false }
        }) ?? continue
        if item == { Struct(definition) -> register_struct_shape(&cx, bundle, target, definition) _ -> {} }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:375
fn register_own_struct_shapes(mut cx: Cx, bundle: ProgramBundle, module_idx: USize) {
    loop item in bundle.modules[module_idx].items {
        if item == {
            Struct(definition) -> register_struct_shape(&cx, bundle, module_idx, definition)
            Enum(definition) -> { if definition.type_params.is_empty() { register_enum_shape(&cx, bundle, module_idx, definition) } }
            _ -> {}
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:392
fn register_enum_shape(mut cx: Cx, bundle: ProgramBundle, target: USize, definition: EnumDef) {
    owner :: bundle.name_ledger.module_identity(target) ?? panic("name ledger must contain every loaded module")
    qualified :: imported_type_name(owner, definition.name)
    binders :: loop param in definition.type_params -> param.name.clone()
    &cx.local_type_identities.insert(definition.name.clone(), qualified.clone())
    variants :: loop variant in definition.variants -> (variant.name.clone(), qualify_variant_payload(bundle, target, owner, binders, variant.payload))
    rust_mod :: mangle(bundle.modules[target].alias)
    &cx.type_names.insert(qualified.clone())
    &cx.foreign_types.insert(qualified.clone(), rust_mod)
    &cx.enum_variants.insert(qualified.clone(), variants)
    loop variant in definition.variants {
        if !cx.variant_owner.contains_key(variant.name) { &cx.variant_owner.insert(variant.name.clone(), qualified.clone()) }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:431
fn qualify_variant_payload(bundle: ProgramBundle, target: USize, owner: String, binders: [String], payload: VariantPayload) -> VariantPayload {
    if payload == {
        Unit -> VariantPayload.Unit
        Single(ty, span) -> VariantPayload.Single(qualify_imported_type(bundle, target, owner, binders, ty), span)
        Named(fields) -> VariantPayload.Named(loop field in fields {
            qualified := field.clone()
            qualified.ty = qualify_imported_type(bundle, target, owner, binders, field.ty)
            qualified
        })
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:460
fn register_struct_shape(mut cx: Cx, bundle: ProgramBundle, target: USize, definition: StructDef) {
    owner :: bundle.name_ledger.module_identity(target) ?? panic("name ledger must contain every loaded module")
    qualified :: imported_type_name(owner, definition.name)
    binders :: loop param in definition.type_params -> param.name.clone()
    &cx.local_type_identities.insert(definition.name.clone(), qualified.clone())
    rust_mod :: mangle(bundle.modules[target].alias)
    target_type_names :: module_owned_type_names(bundle.modules[target].items)
    fields :: loop field in definition.reflection_fields() -> (field.name.clone(), qualify_imported_type(bundle, target, owner, binders, field.ty))
    reflection_fields :: loop field in Reflection.fields(definition) {
        qualified_field := field
        qualified_field.ty = qualify_imported_type(bundle, target, owner, binders, qualified_field.ty)
        qualified_field
    }
    &cx.type_names.insert(qualified.clone())
    &cx.foreign_types.insert(qualified.clone(), rust_mod)
    &cx.struct_fields.insert(qualified.clone(), fields)
    computed := [String:Bool]{}
    loop field in definition.fields { if field.computed != None { &computed.insert(field.name.clone(), true) } }
    if !computed.is_empty() { &cx.computed_fields.insert(qualified.clone(), computed) }
    (memo_fields, memo_dependencies) :: memo_facts_for_struct(definition)
    if !memo_fields.is_empty() { &cx.memo_fields.insert(qualified.clone(), memo_fields) }
    if !memo_dependencies.is_empty() { &cx.memo_dependencies.insert(qualified.clone(), memo_dependencies) }
    &cx.reflection_fields.insert(qualified.clone(), reflection_fields)
    if type_is_cloneable_struct(definition, target_type_names) { &cx.cloneable.insert(qualified.clone()) }
    if !definition.type_params.is_empty() {
        params :: loop param in definition.type_params -> param.name.clone()
        param_set := [String:Bool]{}
        loop param in params { &param_set.insert(param.clone(), true) }
        &cx.struct_type_params.insert(qualified.clone(), param_set)
        &cx.struct_type_param_order.insert(qualified, params)
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:554
fn ast_operand_is_integer(e: Expr, env: LowerEnv) -> Bool? {
    if e == {
        Int(..) -> Val(true)
        Float(..) -> Val(false)
        Unary(UnOp.Neg, inner, _) -> ast_operand_is_integer(inner, env)
        Binary(_, left, _, _) -> ast_operand_is_integer(left, env)
        Ident(name, _) -> env.ty_of(name).map(fn(ty) { ty.is_integer() })
        Str(..) | Char(..) -> Val(false)
        _ -> None
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:577
fn struct_field_type(cx: Cx, recv_ty: Type, field: String) -> Type? {
    declared_struct_field_type(cx, recv_ty, field).map(fn(ty) { ty.with_effective_fn_returns() })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:581
fn declared_struct_field_type(cx: Cx, recv_ty: Type, field: String) -> Type? {
    if recv_ty == {
        Apply{name, args} -> {
            if name == Syntax.TYPE_PIN && args.len() == 1 { return struct_field_type(cx, args[0], field) }
        }
        _ -> {}
    }
    if recv_ty == {
        Named(name) -> {
            if name.strip_suffix(".Patch") == {
                Val(base_name) -> return cx.struct_fields.get(base_name).and_then(fn(fields) {
                    fields.find(fn(pair) { pair.0 == field }).map(fn(pair) { Type.Option(pair.1.clone()) })
                })
                None -> {}
            }
        }
        _ -> {}
    }
    if field == "value" {
        if recv_ty == {
            Apply{name, args} -> {
                if name == Syntax.TYPE_SHARED_GUARD && args.len() == 1 { return Val(args[0].clone()) }
            }
            Tagged{marker, inner} -> {
                internal_guard :: if marker == { Internal(InternalTag.SharedGuardRead | InternalTag.SharedGuardEdit) -> true _ -> false }
                if internal_guard {
                    if inner == {
                        Apply{name, args} -> {
                            if name == Syntax.TYPE_SHARED_GUARD && args.len() == 1 { return Val(args[0].clone()) }
                        }
                        _ -> {}
                    }
                }
            }
            _ -> {}
        }
    }
    if recv_ty == {
        Tuple(fields) -> return fields.find(fn(pair) { pair.0 == field }).map(fn(pair) { pair.1.clone() })
        _ -> {}
    }
    // User declarations win; Core identities and import spellings project to the
    // same canonical shape facts rather than a duplicated Core field ladder.
    shape_key :: fn(name: String) -> String? {
        if cx.struct_fields.contains_key(name) { return Val(name.to_string()) }
        core_source_leaf :: name.strip_prefix("<corelib>/").and_then(fn(identity) { identity.rsplit("::").next() })
            ?? name.rsplit_once("::").filter(fn(pair) { cx.core_source_modules.values().any(fn(alias) { alias == pair.0 }) }).map(fn(pair) { pair.1 })
        if core_source_leaf.filter(fn(leaf) { cx.struct_fields.contains_key(leaf) }) == {
            Val(leaf) -> return Val(leaf.to_string())
            None -> {}
        }
        cx.imported_type_metadata_name(name)
    }
    if recv_ty == {
        Apply{name, args} -> {
            if shape_key(name) == {
                Val(key) -> {
                    fields :: cx.struct_fields.get(key) ?? return None
                    field_ty :: fields.find(fn(pair) { pair.0 == field }).map(fn(pair) { pair.1.clone() }) ?? return None
                    params :: cx.struct_type_param_order.get(key) ?? return None
                    subst := [String:Type]{}
                    loop (param, arg) in params.zip(args) { &subst.insert(param.clone(), arg.clone()) }
                    return Val(substitute_type(field_ty, subst))
                }
                None -> {}
            }
            return core_struct_field_type(name, field, args)
        }
        _ -> {}
    }
    name :: if recv_ty == { Named(name) -> name _ -> return None }
    field_ty :: shape_key(name).and_then(fn(key) { cx.struct_fields.get(key) })
        .and_then(fn(fields) { fields.find(fn(pair) { pair.0 == field }) }).map(fn(pair) { pair.1.clone() })
    if field_ty == { Val(ty) -> return Val(ty) None -> {} }
    core_struct_field_type(name, field, [])
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:715
fn int_lit_type(width: (Bool, U8)?) -> Type {
    if width == { Val((signed, bits)) -> Type.IntN{signed: signed, bits: bits} None -> Type.Int }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:725
fn unit_type() -> Type { Type.Named("Unit") }

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:729
fn let_ty_for_opt(ty: Type?, is_resource: Bool, gc: Bool) -> TLetTy {
    value :: ty ?? return TLetTy.Inferred
    if is_resource { return TLetTy.resource(value.clone()) }
    if gc { return TLetTy.automatic_root(value.clone()) }
    TLetTy.plain(value.clone())
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:747
fn let_ty_tuple(types: [Type]) -> TLetTy { TLetTy.Tuple(types) }

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:755
fn lower_comptime_scalar(value: CtValue?, ty: Type?) -> TExprKind? {
    scalar :: value ?? return None
    if scalar == {
        Int(int) -> {
            width :: if ty == { Val(Type.IntN{signed, bits}) -> Val((signed, bits)) _ -> None }
            Val(TExprKind.IntLit(int, width))
        }
        BigInt(value) -> Val(TExprKind.CtLit(CtValue.BigInt(value.clone())))
        Float(float) -> Val(TExprKind.FloatLit(float.as_f64()))
        Bool(flag) -> Val(TExprKind.BoolLit(flag))
        Char(ch) -> Val(TExprKind.CharLit(ch))
        Str(text) -> Val(TExprKind.StrLit([TStrPart.Lit(text.clone())]))
        Struct{type_name, fields} -> {
            if type_name == Syntax.TYPE_FRACTION {
                fraction :: CtFraction.from_value(scalar).ok() ?? return None
                numerator :: fraction.numerator.try_i64() ?? return None
                denominator :: fraction.denominator.try_i64() ?? return None
                return Val(TExprKind.PreciseBuiltin{type_name: Syntax.TYPE_FRACTION.to_string(), func: "from_parts", args: [
                    TExpr{ty: Type.Int, kind: TExprKind.IntLit(numerator, None)},
                    TExpr{ty: Type.Int, kind: TExprKind.IntLit(denominator, None)},
                ]})
            }
            if type_name == Syntax.TYPE_COMPLEX {
                part :: fn(name: String) -> F64? {
                    fields.find(fn(pair) { pair.0 == name }).and_then(fn(pair) {
                        if pair.1 == { Int(value) -> Val(value as F64) Float(value) -> Val(value.as_f64()) _ -> None }
                    })
                }
                real :: part("real") ?? return None
                imaginary :: part("imaginary") ?? return None
                return Val(TExprKind.PreciseBuiltin{type_name: Syntax.TYPE_COMPLEX.to_string(), func: "from_parts", args: [
                    TExpr{ty: Type.Float, kind: TExprKind.FloatLit(real)},
                    TExpr{ty: Type.Float, kind: TExprKind.FloatLit(imaginary)},
                ]})
            }
            None
        }
        _ -> None
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:841
fn keeps_raw_stream_return(ty: Type) -> Bool {
    if ty == { Apply{name, args} -> name == Syntax.TYPE_STREAM && args.len() == 1 _ -> false }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:849
fn call_return_type(cx: Cx, name: String) -> Type {
    if cx.fn_types.get(name) == {
        Val(Type.Fn{ret, ..}) -> {
            declared :: ret.map(fn(ty) { cx.expand_type_aliases(ty) })
            if declared.is_some_and(fn(ty) { keeps_raw_stream_return(ty) }) {
                return declared ?? panic("stream return checked above")
            }
            FailureContract.from_return_type(declared).effective_type()
        }
        _ -> { if cx.distinct_types.contains_key(name) { Type.Named(name.to_string()) } else { unit_type() } }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:874
fn extern_call_return_type(cx: Cx, name: String) -> Type {
    if cx.fn_types.get(name) == {
        Val(Type.Fn{ret, ..}) -> ret.map(fn(ty) { cx.expand_type_aliases(ty) }) ?? unit_type()
        _ -> unit_type()
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:888
fn module_call_target_return(cx: Cx, resolved_ret: Type?) -> Type Err! {
    resolved :: resolved_ret ?? raise Err("checked module call has no resolved return type")
    expanded :: cx.expand_type_aliases(resolved)
    if keeps_raw_stream_return(expanded) { return expanded }
    FailureContract.from_return_type(Val(expanded)).effective_type()
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:912
// GATE #4499: import return lookup preserves structural (alias, method) keys.
fn imported_module_call_target_return(cx: Cx, alias: String, method: String, resolved_ret: Type?) -> Type? Err! {
    declared :: cx.import_rets.get((alias.to_string(), method.to_string()))
        ?? raise Err("checked module call `{alias}.{method}` has no import return fact")
    direct_c_function :: cx.import_mods.get(alias).is_some_and(fn(module) { cx.direct_c_functions.contains("{module}::{method}") })
    if direct_c_function { return Val(declared.clone() ?? unit_type()) }
    Val(module_call_target_return(cx, resolved_ret)?)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:939
fn module_call_source_return_type(cx: Cx, name: String, resolved_ret: Type?) -> Type Err! {
    resolved :: resolved_ret ?? raise Err("checked module call `{name}` has no resolved return type")
    cx.expand_type_aliases(resolved)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:955
fn call_return_type_with_args(cx: Cx, name: String, type_args: [Type], args: [TCallArg]) -> Type {
    substitute_call_type(cx, name, call_return_type(cx, name), type_args, args)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/fields.rs:965
fn substitute_call_type(cx: Cx, name: String, declared: Type, type_args: [Type], args: [TCallArg]) -> Type {
    params :: cx.fn_type_params.get(name) ?? return declared
    if params.is_empty() { return declared }
    order :: cx.fn_type_param_order.get(name) ?? return declared
    subst := [String:Type]{}
    loop (param, actual) in order.zip(type_args) { &subst.insert(param.clone(), cx.expand_type_aliases(actual)) }
    if cx.sigs.get(name) == {
        Val(sig) -> {
            loop ((_, template), actual) in sig.zip(args) {
                actual_ty :: if actual.widen_to_vec {
                    if actual.value.ty == { FixedList{elem, ..} -> Type.List(elem.clone()) other -> other.clone() }
                } else { actual.value.ty.clone() }
                if !bind_generic_type(template, actual_ty, params, &subst) { return declared }
            }
        }
        None -> {}
    }
    substitute_type(declared, subst)
}
