//RS /// #2252: the module that DECLARES a nominal knows it only by its local leaf,
//RS /// but its own items are lowered under the canonical owner whenever another
//RS /// context consumes them (the imported-module pass in `TIR/mod.rs` lowers
//RS /// `plan.jet`'s methods and generated codecs as `<dir>::plan.jet::ListReport::…`).
//RS /// A leaf-only shape table cannot answer that owner key, so the structural gate
//RS /// refused every such method and the default tier deopted on a method the
//RS /// program plainly declares. Registering the declaring module's own nominals
//RS /// through the same seam keeps ONE canonical qualified-shape fact per type,
//RS /// identical to the row a consumer context already holds.
//RS pub(crate) fn register_own_struct_shapes(cx: &mut Cx, bundle: &ProgramBundle, module_idx: usize) {
