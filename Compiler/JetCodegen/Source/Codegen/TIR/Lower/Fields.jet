//RS                 register_struct_shape(cx, bundle, module_idx, definition);
//RS             }
//RS             Item::Enum(definition) if definition.type_params.is_empty() => {
//RS                 register_enum_shape(cx, bundle, module_idx, definition);
//RS             }
//RS             _ => {}
//RS         }
//RS     }
//RS }
