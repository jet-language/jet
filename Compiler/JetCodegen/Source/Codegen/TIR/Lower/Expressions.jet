// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:100
// Keep recursive branch locals in their own frame at every optimization level.
#Inline(never)
pub fn in_own_frame<R>(body: fn() -> R) -> R Never! { body() }

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:106
fn math_scalar_builtin(op: BinOp, left: Type, right: Type) -> (String, String)? {
    op_name := if op == { .Mul -> "mul"; .Div -> "div"; else -> return None }
    if left == {
        .Named(ln) -> {
            if Sema.is_math_type(ln) && Sema.math_scalar_binop_result(op, ln, right).is_some() {
                return Val((ln.clone(), op_name.to_string()))
            }
        }
        else -> {}
    }
    if right == {
        .Named(rn) -> {
            if Sema.is_math_type(rn) && Sema.math_scalar_binop_result(op, rn, left).is_some() {
                return Val(("Float", "{op_name}_{rn}"))
            }
        }
        else -> {}
    }
    None
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:134
fn coerce_math_scalar_to_float(scalar: TExpr, line: U32) -> TExpr Never! {
    if scalar.ty == {
        .Float | .Float32 -> scalar
        .Named(name) -> {
            if name == Syntax.TYPE_DECIMAL || name == Syntax.TYPE_FRACTION {
                return TExpr{ty: Type.Float, kind: TExprKind.PreciseBuiltin{type_name: name.clone(), func: "to_float", args: [scalar]}}
            }
            scalar
        }
        .Int | .IntN(_, _) -> {
            source_signed := if scalar.ty == { .IntN(_, false) -> false; else -> true }
            TExpr{ty: Type.Float, kind: TExprKind.NumericMethod{recv: scalar, op: TNumericOp.CheckedIntToFloat{source_signed: source_signed, target_f32: false, line: line}}}
        }
        else -> scalar
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:170
fn lower_atomic_initializer(value: TExpr, field_ty: Type) -> TExpr Never! {
    if field_ty == {
        .Apply(name, args) -> {
            if args.len() != 1 || name != "Atomic" || !JetFoundation.Layout.atomic_scalar_type(args[0]) -> return value
            TExpr{ty: field_ty.clone(), kind: TExprKind.StaticCall{
                owner: TStaticOwner.Prelude{rooted: true, path: "JetAtomic", generics: [TPreludeArg.Jet(args[0].clone())]},
                owner_type: None, method: TMethodRef.bare("new"), type_args: [],
                args: [TCallArg{value: value, template_items: None, borrow: false, mut_borrow: false, clone: false, arc_clone: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None}]
            }}
        }
        else -> value
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:210
pub fn suppress_module_call_target_return(expr: &TExpr) -> Void Never! {
    next_ty := if &expr.kind == {
        .ModuleCall(_, _, _, target_return, _) -> target_return.take()
        .InlineBlock(stmts) -> {
            if stmts.last_mut() == {
                Val(.ExprStmt(tail)) -> { suppress_module_call_target_return(&tail); Val(tail.ty.clone()) }
                else -> None
            }
        }
        else -> None
    }
    if next_ty == { Val(ty) -> expr.ty = ty; else -> {} }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:228
fn thread_callback_ident(expr: Expr) -> String? {
    if expr == { .Ident(name, _) -> Val(name); .Paren(inner, _) -> thread_callback_ident(inner); else -> None }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:239
pub fn lower_fn_value_call(callee_expr: Expr?, callee_t: TExpr, args: [CallArg], site: U32, cx: Cx, env: &LowerEnv) -> TExpr Never! {
    ok_ty := if callee_t.ty == { .Result(ok, _) | .Option(ok) -> Val(ok); else -> None }
    if ok_ty == {
        Val(ok) -> {
            if ok == {
                .Fn(_, _, _, _, _, _) -> {
                    (line, column) := cx.src_line_col(site as USize)
                    callee_t = TExpr{ty: ok.clone(), kind: TExprKind.Try{inner: ^callee_t, note: None, convert: TTryConvert.None, file: escape_rust_str(cx.file), line: line, column: column, fn_name: escape_rust_str(env.fn_name)}}
                }
                else -> {}
            }
        }
        else -> {}
    }
    effective_callee_ty := if callee_t.ty == { .Fn(_, _, _, _, _, _) -> callee_t.ty.with_effective_fn_returns(); else -> callee_t.ty.clone() }
    (source_ret_ty, effective_ret_ty, needs_carrier) := if (callee_t.ty, effective_callee_ty) == {
        (.Fn(_, Val(source_ret), _, _, _, _), .Fn(_, Val(effective_ret), _, _, _, _)) -> {
            source_is_carrier := if source_ret == { .Result(_, _) | .Option(_) -> true; .Named(name) -> name == Syntax.TYPE_NEVER; else -> false }
            (source_ret.clone(), effective_ret.clone(), !source_is_carrier && source_ret != effective_ret)
        }
        else -> (unit_type(), unit_type(), false)
    }
    effective_params := if effective_callee_ty == { .Fn(params, _, _, _, _, _) -> Val(params); else -> None }
    conventions := if effective_callee_ty == { .Fn(_, _, _, _, Val(metadata), _) -> Val(metadata.conventions); else -> None }
    is_send := callee_expr.and_then(thread_callback_ident).is_some_and(fn(name) { env.is_send_fn(name) })
    if is_send {
        if callee_t.ty == { .Fn(_, _, _, _, _, _) -> {
            ty := callee_t.ty.clone()
            callee_t = TExpr{ty: ty, kind: TExprKind.FnValue{kind: TFnValueKind.Send{value: ^callee_t}}}
        }; else -> {} }
    }
    targs: [TCallArg] := []
    loop (index, arg) in args.enumerate() {
        conv := effective_params.and_then(fn(params) { params.get(index) }).map(fn(ty) {
            (conventions.and_then(fn(row) { row.get(index) }).unwrap_or(AccessConvention.Read), ty.clone())
        })
        targs.push(lower_one_call_arg(arg, conv, &env, cx))
    }
    call := TExpr{ty: source_ret_ty, kind: TExprKind.FnValue{kind: TFnValueKind.Call{callee: ^callee_t, args: targs}}}
    if source_arg_order(args) == { Val(order) -> call = preserve_source_arg_order(call, order, args.len(), site); else -> {} }
    if needs_carrier -> TExpr{ty: effective_ret_ty, kind: TExprKind.Ok(call)}
    else -> TExpr{ty: effective_ret_ty, kind: call.kind}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:375
fn layout_selector_name(index: Expr) -> String? {
    if index == { .Ident(name, _) | .ComptimeName(name, _) -> Syntax.layout_selector_name(name); else -> None }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:388
fn is_layout_info_expr(expr: TExpr) -> Bool Never! {
    nominal := if expr.ty.without_user_tags() == { .Named(name) -> name == Syntax.TYPE_LAYOUT_INFO; else -> false }
    nominal || if expr.kind == { .CtLit(.Struct(type_name, _)) -> type_name == Syntax.TYPE_LAYOUT_INFO; else -> false }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:403
pub fn resolve_unknown_index_kind(base_t: TExpr, index_t: TExpr, index: Expr, cx: Cx) -> IndexKind? {
    if layout_selector_name(index) == {
        Val(field) -> { if is_layout_info_expr(base_t) -> return Val(IndexKind.LayoutField(field.to_string())); return None }
        else -> {}
    }
    base_ty := base_t.ty.without_user_tags()
    index_ty := index_t.ty.without_user_tags()
    is_range := if index_ty == { .Named(name) -> name == Syntax.TYPE_RANGE; else -> false }
    if base_ty == {
        .List(_) -> Val(if is_range -> IndexKind.Range else -> IndexKind.List)
        .FixedList(_, _) -> Val(IndexKind.List)
        .Apply(name, args) -> {
            if args.len() == 1 && (name == "View" || name == "ViewMut" || name == "ComputeViewMut") -> return Val(IndexKind.List)
            if args.len() == 1 && name == "Pool" -> return Val(IndexKind.Pool)
            if base_ty.is_compute_tensor_family() && is_range -> return Val(IndexKind.Range)
            None
        }
        .Map(_, _) -> Val(IndexKind.Map)
        .Named(name) -> {
            if base_ty.is_compute_tensor_family() && is_range -> return Val(IndexKind.Range)
            if Syntax.is_simd_lane_type(name) && !cx.type_names.contains(name) -> return Val(IndexKind.Lane(name.clone()))
            if cx.index_hooks.contains_key(name) -> return Val(IndexKind.User(name.clone()))
            None
        }
        else -> { if base_ty.is_compute_tensor_family() && is_range -> Val(IndexKind.Range) else -> None }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:446
fn shared_guard_type_name(name: String) -> Bool Never! {
    leaf := name.rsplit("::").next().and_then(fn(part) { part.rsplit('.').next() }).unwrap_or(name)
    leaf == Syntax.TYPE_SHARED_GUARD
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:455
fn shared_guard_projection(ty: Type) -> (Type, Bool)? {
    if ty.without_user_tags() == {
        .Apply(name, args) -> { if shared_guard_type_name(name) && args.len() == 1 -> Val((args[0].clone(), false)) else -> None }
        .Tagged(marker, inner) -> {
            special := marker == TagMarker.Internal(InternalTag.SharedGuardRead) || marker == TagMarker.Internal(InternalTag.SharedGuardEdit)
            if special {
                if inner.without_user_tags() == {
                    .Apply(name, args) -> {
                        if shared_guard_type_name(name) && args.len() == 1 -> return Val((args[0].clone(), marker == TagMarker.Internal(InternalTag.SharedGuardEdit)))
                    }
                    else -> {}
                }
            }
            shared_guard_projection(inner)
        }
        .Shared(inner) | .Option(inner) -> shared_guard_projection(inner)
        else -> None
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:490
fn shared_guard_value_field(recv: TExpr, member: String) -> TExpr? {
    if member != "value" -> return None
    (inner, editable) :: shared_guard_projection(recv.ty) ?? return None
    Val(TExpr{ty: inner, kind: TExprKind.SharedGuardValue{guard: recv, editable: editable}})
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:504
pub fn lower_expr_as_mut_place(e: Expr, cx: Cx, env: &LowerEnv) -> TExpr Never! {
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:505
    fn pool_mut_place(pool_expr: Expr, id_expr: Expr, idx_span: Span, field: String?, cx: Cx, env: &LowerEnv) -> TExpr Never! {
        line := cx.src_line_col(idx_span.start).0
        src_line := cx.src_line_text(line).to_string()
        pool_t := lower_expr(pool_expr, cx, &env)
        id_t := lower_expr(id_expr, cx, &env)
        elem_ty := if pool_t.ty == { .Apply(_, args) -> { if !args.is_empty() -> args[0].clone() else -> Type.Int }; else -> Type.Int }
        field_ty := field.map(fn(f) { struct_field_type(cx, elem_ty, f).unwrap_or(Type.Int) }).unwrap_or(elem_ty)
        TExpr{ty: field_ty, kind: TExprKind.PoolSlot{pool: pool_t, id: id_t, mutable: true, field: field.map(fn(f) { f.to_string() }), line: line, src_line: src_line}}
    }
    if e == {
        .Index(base, index, span, kind) -> {
            if kind == IndexKind.Pool -> return pool_mut_place(base, index, span, None, cx, &env)
            base_t := lower_expr_as_mut_place(base, cx, &env)
            index_t := lower_expr(index, cx, &env)
            base_ty := base_t.ty.without_user_tags()
            is_map := if kind == {
                .Map -> true
                .List | .FixedListProof -> false
                .Unknown -> if base_ty == { .Map(_, _) -> true; else -> false }
                else -> return lower_expr(e, cx, &env)
            }
            ty := if base_ty == { .List(elem) | .FixedList(elem, _) -> elem.clone(); .Map(_, value) -> value.clone(); else -> return lower_expr(e, cx, &env) }
            uninit := if base == { .Ident(name, _) -> env.is_uninit_fixed(name); else -> false }
            TExpr{ty: ty, kind: TExprKind.Index{base: base_t, index: index_t, is_map: is_map, uninit_fixed: uninit, line: cx.src_line_col(span.start).0}}
        }
        .Field(base, field, _) -> {
            if base == {
                .Index(pool_expr, id_expr, idx_span, .Pool) -> return pool_mut_place(pool_expr, id_expr, idx_span, Val(field), cx, &env)
                else -> {}
            }
            recv := lower_expr_as_mut_place(base, cx, &env)
            if shared_guard_value_field(recv.clone(), field) == { Val(guard_value) -> return guard_value; else -> {} }
            field_ty := struct_field_type(cx, recv.ty, field).unwrap_or(Type.Int)
            boxed := if recv.ty == { .Named(n) -> cx.boxed_edges.contains((n.clone(), field.to_string())); else -> false }
            TExpr{ty: field_ty, kind: TExprKind.Field{recv: recv, field: field.to_string(), boxed: boxed}}
        }
        .Paren(inner, _) -> lower_expr_as_mut_place(inner, cx, &env)
        else -> lower_expr(e, cx, &env)
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:632
fn canonicalize_operator_method_identity(expr: &TExpr, cx: Cx) -> Void Never! {
    if &expr.kind == {
        .MethodCall(recv, method, _, _, _) -> {
            identity :: method.operator_identity.clone() ?? return
            trait_name :: method.trait_owner ?? return
            owner := if recv.ty.without_user_tags() == { .Named(name) | .Apply(name, _) -> canonical_enum_owner(cx, name); else -> return }
            marker := "::{trait_name}::"
            marker_start :: identity.find(marker) ?? return
            suffix :: identity.get(marker_start + 2..) ?? return
            if identity.starts_with("{owner}::") -> return
            method.operator_identity = Val("{owner}::{suffix}")
        }
        else -> {}
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:663
fn fallback_checked_method_return(receiver: Expr, method: String, recv_type: String?, cx: Cx, env: LowerEnv) -> Type? {
    is_root := recv_type.is_some_and(fn(name) { name == Syntax.INTERNAL_ROOT_CALL_LOCAL || name.starts_with(Syntax.INTERNAL_ROOT_CALL_IMPORT_PREFIX) || name.starts_with(Syntax.INTERNAL_ROOT_CALL_CORE_PREFIX) })
    if recv_type.and_then(fn(name) { name.strip_prefix(Syntax.INTERNAL_ROOT_CALL_CORE_PREFIX) }) == Val("core.term") && method == Syntax.BUILTIN_PRINT -> return Val(Type.Named(Syntax.INTERNAL_UNIT_TYPE.to_string()))
    if is_root {
        if cx.fn_source_types.get(method) == { Val(.Fn(_, Val(ret), _, _, _, _)) -> return Val(cx.expand_type_aliases(ret)); else -> {} }
    }
    if recv_type == Val(Syntax.TXN_HANDLE_TYPE) && (method == Syntax.TXN_ON_COMMIT || method == Syntax.TXN_ON_ROLLBACK) -> return Val(Type.Named(Syntax.INTERNAL_UNIT_TYPE.to_string()))
    if method == Syntax.MEM_ALLOC_NEW || method == "new" {
        locals := Set<String>.from(env.locals.keys())
        if solve_new_type(receiver, method, cx, locals).is_some() -> return Val(Type.Named(Syntax.SOLVER_TYPE.to_string()))
    }
    None
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:708
fn lower_method_chain(e: Expr, cx: Cx, env: &LowerEnv) -> TExpr Never! {
    calls := TirWorklist<Expr>.new()
    cursor := e
    loop {
        if cursor == { .MethodCall(receiver, _, _, _, _, _, _, _, _, _) -> { calls.push(cursor); cursor = receiver }; else -> break }
    }
    lowered_receiver: TExpr? := None
    loop {
        call :: calls.pop() ?? break
        if call == {
            .MethodCall(receiver, method, method_span, owner_type_args, type_args, args, recv_type, operator_rhs, resolved_ret_ast, checked_widen) -> {
                resolved_ret := resolved_ret_ast.clone().or_else(fn() { fallback_checked_method_return(receiver, method, recv_type, cx, env) })
                call_receiver := lowered_receiver.take()
                if call_receiver.is_none() && (method == "to_string" || method == "to_float" || method == "to_int" || ((method == "compare" || method == "equal") && args.len() == 1)) {
                    call_receiver = Val(lower_expr(receiver, cx, &env))
                }
                receiver_type := call_receiver.and_then(fn(recv) {
                    if recv.ty == {
                        .String -> Val("String")
                        .List(_) | .FixedList(_, _) -> Val("List")
                        .Named(name) -> { if name == "Decimal" || name == "Fraction" || name == "String" -> Val(name.clone()) else -> None }
                        else -> None
                    }
                })
                dispatch_recv_type := receiver_type.or_else(fn() { recv_type.clone() })
                method_sig := expr_cache_take_method_sig(call, cx)
                binary := method == "add" || method == "sub" || method == "mul" || method == "div" || method == "equal"
                decimal_zero := method == "round" || method == "floor" || method == "ceil" || method == "to_string" || method == "to_float"
                fraction_zero := method == "numerator" || method == "denominator" || method == "to_string" || method == "to_float" || method == "is_zero"
                precise_method := (dispatch_recv_type == Val("Decimal") && ((args.len() == 1 && (binary || method == "compare")) || (args.is_empty() && decimal_zero))) || (dispatch_recv_type == Val("Fraction") && ((args.len() == 1 && binary) || (args.is_empty() && fraction_zero)))
                lowered := if precise_method {
                    recv := call_receiver.take().unwrap_or_else(fn() { lower_expr(receiver, cx, &env) })
                    value_args := [recv]
                    loop arg in args { value_args.push(lower_expr(arg.expr, cx, &env)) }
                    ty := if method == {
                        "to_string" -> Type.String
                        "div" -> Type.Named("Fraction")
                        "numerator" | "denominator" -> Type.Int
                        "to_float" -> Type.Float
                        "compare" -> Type.Named(Syntax.TYPE_ORDERING.to_string())
                        "is_zero" | "equal" -> Type.Bool
                        else -> Type.Named(dispatch_recv_type.unwrap_or("Decimal").to_string())
                    }
                    TExpr{ty: resolved_ret.clone().unwrap_or(ty), kind: TExprKind.PreciseBuiltin{type_name: dispatch_recv_type.clone().unwrap_or("Decimal"), func: method.to_string(), args: value_args}}
                } else if method == "to_float" && args.is_empty() && dispatch_recv_type == Val("String") {
                    recv := call_receiver.take().unwrap_or_else(fn() { lower_expr(receiver, cx, &env) })
                    TExpr{ty: resolved_ret.clone().unwrap_or_else(fn() { Type.Result{ok: Type.Float, err: Type.Named("ParseError")} }), kind: TExprKind.BuiltinMethod{recv: recv, op: TBuiltinOp.ParseFloat, args: []}}
                } else {
                    lower_method_call_with_sig(receiver, method, method_span, owner_type_args, type_args, args, dispatch_recv_type, operator_rhs, resolved_ret, checked_widen, cx, &env, call_receiver, method_sig)
                }
                canonicalize_operator_method_identity(&lowered, cx)
                carrier := if lowered.ty == { .Result(_, _) | .Option(_) -> true; else -> false }
                if method == "check" && recv_type == Val(Syntax.TYPE_VALIDATE_BUILDER) && !carrier {
                    success := lowered.ty.clone()
                    lowered.ty = Type.Result{ok: success.clone(), err: Type.Named(Syntax.TYPE_ERR.to_string())}
                    (line, column) := cx.src_line_col(method_span.start)
                    lowered = TExpr{ty: success, kind: TExprKind.Try{inner: lowered, note: None, convert: TTryConvert.None, file: escape_rust_str(cx.file), line: line, column: column, fn_name: escape_rust_str(env.fn_name)}}
                }
                shared_payload := resolved_ret.and_then(fn(ty) { if ty == { .Shared(inner) -> Val(inner.clone()); else -> None } })
                if shared_payload == {
                    Val(payload) -> {
                        retagged := if &lowered.kind == {
                            .StaticCall(owner, _, _, _, args) -> {
                                if &owner == {
                                    .Prelude(_, path, generics) -> {
                                        if path == "jet_std::JetShared" && !generics.is_empty() {
                                            if &generics[0] == { .Jet(ty) -> ty = payload.clone(); else -> {} }
                                        }
                                    }
                                    else -> {}
                                }
                                if args.is_empty() -> false
                                else {
                                    empty := if args[0].value.kind == { .MapLit(entries) -> entries.is_empty(); .ListLit(items) -> items.is_empty(); else -> false }
                                    if empty { args[0].value.ty = payload.clone() }
                                    empty
                                }
                            }
                            else -> false
                        }
                        if retagged { lowered.ty = resolved_ret.clone().unwrap_or_else(fn() { Type.Shared(payload) }) }
                    }
                    else -> {}
                }
                if resolved_ret == {
                    Val(ret) -> {
                        if lowered.kind == {
                            .ModuleCall(_, _, _, _, form) -> { if form == { .InlineMangled(_) -> {}; else -> lowered.ty = ret.clone() } }
                            else -> {}
                        }
                    }
                    else -> {}
                }
                lowered = lower_method_pre_contracts(call, lowered, cx, env)
                lowered_receiver = Val(if source_arg_order(args) == { Val(order) -> preserve_source_arg_order(lowered, order, args.len(), method_span.start as U32); else -> lowered })
            }
            else -> panic("method chain contains only method calls")
        }
    }
    lowered_receiver.expect("method chain is non-empty")
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:944
// GATE #4499: tuple identity keys retain exact equality/hash semantics.
struct ExprWorklistCache {
    active: Bool
    values: [(USize, USize):Queue<TExpr>]
    types: [(USize, USize):Type]
    method_sigs: [(USize, USize):Queue<[(AccessConvention, Type)]>]
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:952
    pub fn default() -> ExprWorklistCache Never! {
        ExprWorklistCache{active: false, values: [:], types: [:], method_sigs: [:]}
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:962
// GATE #4494: native per-thread storage and interior mutation, not process globals.
EXPR_WORKLIST_CACHE := ThreadLocal<RefCell<ExprWorklistCache>>.new(fn() { RefCell.new(ExprWorklistCache.default()) })
EXPR_COMPTIME_CACHE_DEPTH := ThreadLocal<Cell<USize>>.new(fn() { Cell.new(0) })

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:968
fn expr_key(expr: Expr, cx: Cx) -> (USize, USize) Never! {
    // GATE #4494: stable address identity of the borrowed AST and context.
    #Unsafe("Expression memo keys are identities; pointers are never dereferenced") {
        (std.ptr.address_of(expr), std.ptr.address_of(cx))
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:972
fn strip_expr_parens(expr: Expr) -> Expr Never! {
    cursor := expr
    loop { if cursor == { .Paren(inner, _) -> cursor = inner; else -> return cursor } }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:979
fn lower_list_lit(elems: [Expr], cx: Cx, env: &LowerEnv) -> TExpr Never! {
    has_spread := elems.any(fn(e) { if e == { .Spread(_, _) -> true; else -> false } })
    if has_spread {
        parts: [ListSpreadPart] := []
        loop e in elems {
            parts.push(if e == { .Spread(inner, _) -> ListSpreadPart.Spread(lower_expr(inner, cx, &env)); else -> ListSpreadPart.Elem(lower_expr(e, cx, &env)) })
        }
        elem_ty := parts.first().map(fn(p) {
            if p == { .Elem(t) -> t.ty.clone(); .Spread(t) -> if t.ty == { .List(inner) -> inner.clone(); else -> t.ty.clone() } }
        }).unwrap_or(Type.Int)
        return TExpr{ty: Type.List(elem_ty), kind: TExprKind.ListSpread{parts: parts}}
    }
    telems: [TExpr] := []
    loop e in elems { telems.push(lower_expr(e, cx, &env)) }
    elem_ty := telems.find(fn(e) { e.kind != TExprKind.Absent }).or_else(fn() { telems.first() }).map(fn(e) { e.ty.clone() }).unwrap_or(Type.Int)
    if elem_ty == { .Option(_) -> { loop el in &telems { if el.kind == TExprKind.Absent { el.ty = elem_ty.clone() } } }; else -> {} }
    if cx.columnar_list_type(elem_ty) == {
        Val(columns_ty) -> return TExpr{ty: Type.List(elem_ty), kind: TExprKind.ColumnarListLit{columns_ty: columns_ty, elems: telems}}
        else -> {}
    }
    TExpr{ty: Type.List(elem_ty), kind: TExprKind.ListLit(telems)}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1050
fn fit_patch_field_value(value: TExpr, expected: Type) -> TExpr Never! {
    if value.kind == {
        .IfExpr(cond, then_body, then_value, else_body, else_value) -> TExpr{ty: expected.clone(), kind: TExprKind.IfExpr{cond: cond, then_body: then_body, then_value: fit_patch_field_value(then_value, expected), else_body: else_body, else_value: fit_patch_field_value(else_value, expected)}}
        .Absent -> {
            if expected == { .Option(_) -> return TExpr{ty: expected.clone(), kind: TExprKind.Absent}; else -> {} }
            value
        }
        .Present(payload) -> {
            if expected == {
                .Option(inner) -> TExpr{ty: expected.clone(), kind: TExprKind.Present(fit_patch_field_value(payload, inner))}
                else -> TExpr{ty: Type.Option(payload.ty.clone()), kind: TExprKind.Present(payload)}
            }
        }
        else -> {
            if value.ty == expected -> return value
            if expected == {
                .Option(inner) -> {
                    if value.ty == { .Option(_) -> return value; else -> {} }
                    TExpr{ty: expected.clone(), kind: TExprKind.Present(fit_patch_field_value(value, inner))}
                }
                else -> value
            }
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1114
pub fn lower_or_fallback(value: Expr, fallback: OrFallback, cx: Cx, env: &LowerEnv) -> TExpr Never! {
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1120
    fn return_value(value: TExpr, env: LowerEnv, cx: Cx) -> TExpr Never! {
        return_ty :: env.ret_ty.clone() ?? return value
        payload_ty := if return_ty == { .Result(ok, _) | .Option(ok) -> ok; else -> return_ty }
        value_carrier := if value.ty == { .Result(_, _) | .Option(_) -> true; else -> false }
        option_return := if return_ty == { .Option(_) -> true; else -> false }
        fitted := if value.kind == TExprKind.Absent && option_return -> TExpr{ty: return_ty.clone(), kind: TExprKind.Absent}
            else if value_carrier -> value
            else -> preserve_typed_list_shape(value, payload_ty, cx)
        kind := if return_ty == {
            .Result(_, _) -> { if fitted.ty == { .Result(_, _) -> return fitted; else -> TExprKind.Ok(fitted) } }
            .Option(_) -> { if fitted.ty == { .Option(_) -> return fitted; else -> TExprKind.Present(fitted) } }
            else -> return fitted
        }
        TExpr{ty: return_ty, kind: kind}
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1161
    fn fit_fallback_value(value: TExpr, result_ty: Type, cx: Cx) -> TExpr Never! {
        fitted := preserve_typed_list_shape(value, result_ty, cx)
        if result_ty == {
            .Result(_, _) -> { if fitted.ty == { .Result(_, _) -> fitted; else -> TExpr{ty: result_ty.clone(), kind: TExprKind.Ok(fitted)} } }
            .Option(_) -> { if fitted.ty == { .Option(_) -> fitted; else -> TExpr{ty: result_ty.clone(), kind: TExprKind.Present(fitted)} } }
            else -> fitted
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1179
    fn lower_fallback(fallback: OrFallback, result_ty: Type, cx: Cx, env: LowerEnv, fallback_env: &LowerEnv) -> TOrFallback Never! {
        scope := ExprCacheScope.enter()
        defer { scope.drop() }
        if fallback == {
            .Value(e) -> TOrFallback.Value(fit_fallback_value(lower_expr(e, cx, &fallback_env), result_ty, cx))
            .Block(body, value, _) -> {
                stmts := lower_stmts(body, cx, &fallback_env)
                if value == { Val(v) -> stmts.push(TStmt.ExprStmt(fit_fallback_value(lower_expr(v, cx, &fallback_env), result_ty, cx))); else -> {} }
                TOrFallback.Value(TExpr{ty: result_ty.clone(), kind: TExprKind.InlineBlock(stmts)})
            }
            .Return(None, _) -> {
                if env.ret_ty == {
                    Val(.Result(ok, _)) -> {
                        if ok == { .Named(n) -> {
                            if n == Syntax.INTERNAL_UNIT_TYPE {
                                unit := TExpr{ty: Type.Named(Syntax.INTERNAL_UNIT_TYPE.to_string()), kind: TExprKind.Unit}
                                return TOrFallback.Return(Val(TExpr{ty: env.ret_ty.expect("fallible void return"), kind: TExprKind.Ok(unit)}))
                            }
                        }; else -> {} }
                    }
                    else -> {}
                }
                TOrFallback.Return(None)
            }
            .Return(Val(e), _) -> {
                lowered := if e.without_parens() == {
                    .Call(_) -> {
                        wrapped := Expr.Try(e.clone(), e.span(), TryConvert.None, None)
                        lower_temporary_expr(wrapped, cx, &fallback_env)
                    }
                    else -> lower_expr(e, cx, &fallback_env)
                }
                TOrFallback.Return(Val(return_value(lowered, env, cx)))
            }
            .Panic(name_span, args) -> {
                (kind, loc) := lower_panic_stop(name_span, args, cx, &fallback_env)
                if kind == { .Panic(msg) -> TOrFallback.Panic{msg: msg, loc: loc}; else -> panic("unreachable") }
            }
            .Break(_) -> TOrFallback.Break
            .Continue(_) -> TOrFallback.Continue
            .BreakLabel(name, _) -> TOrFallback.BreakLabel(name.clone())
            .ContinueLabel(name, _) -> TOrFallback.ContinueLabel(name.clone())
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1254
    fn lift_value_fallback_to_option(fallback: TOrFallback, payload: Type) -> TOrFallback Never! {
        if fallback == { .Value(value) -> TOrFallback.Value(TExpr{ty: Type.Option(payload.clone()), kind: TExprKind.Present(value)}); else -> fallback }
    }
    value_t := {
        scope := ExprCacheScope.enter()
        defer { scope.drop() }
        fallback_subject := env.fallback_subject
        env.fallback_subject = true
        lowered := lower_owned_expr(value, cx, &env)
        env.fallback_subject = fallback_subject
        lowered
    }
    suppress_module_call_target_return(&value_t)
    if value_t.ty == { .Option(_) | .Result(_, _) -> {}; else -> return value_t }
    never_success := if value_t.ty == { .Result(ok, _) -> ok.is_never(); else -> false }
    if never_success {
        fallback_env := clone_env(env)
        if value_t.ty == { .Result(_, err) -> fallback_env.bind(Syntax.AMBIENT_ERR, ambient_err_local(), Val(err.clone())); else -> {} }
        if fallback == {
            .Value(e) -> {
                fallback_t := lower_expr(e, cx, &fallback_env)
                return TExpr{ty: fallback_t.ty.clone(), kind: TExprKind.OrFallback{value: value_t, fallback: TOrFallback.Value(fallback_t)}}
            }
            .Block(body, value, _) -> {
                stmts := lower_stmts(body, cx, &fallback_env)
                if value == {
                    None -> {
                        never := Type.Named(Syntax.TYPE_NEVER.to_string())
                        return TExpr{ty: never.clone(), kind: TExprKind.OrFallback{value: value_t, fallback: TOrFallback.Value(TExpr{ty: never, kind: TExprKind.InlineBlock(stmts)})}}
                    }
                    Val(v) -> {
                        fallback_t := lower_expr(v, cx, &fallback_env)
                        result_ty := fallback_t.ty.clone()
                        stmts.push(TStmt.ExprStmt(fallback_t))
                        return TExpr{ty: result_ty.clone(), kind: TExprKind.OrFallback{value: value_t, fallback: TOrFallback.Value(TExpr{ty: result_ty, kind: TExprKind.InlineBlock(stmts)})}}
                    }
                }
            }
            else -> {}
        }
    }
    mixed_payload := if value_t.ty == { .Result(.Option(inner), _) -> Val(inner.clone()); else -> None }
    if mixed_payload == {
        Val(payload) -> {
            option_ty := Type.Option(payload.clone())
            failure_env := clone_env(env)
            if value_t.ty == { .Result(_, err) -> failure_env.bind(Syntax.AMBIENT_ERR, ambient_err_local(), Val(err.clone())); else -> {} }
            failure_fallback := lift_value_fallback_to_option(lower_fallback(fallback, payload, cx, env, &failure_env), payload)
            after_result := TExpr{ty: option_ty, kind: TExprKind.OrFallback{value: value_t, fallback: failure_fallback}}
            absence_env := clone_env(env)
            absence_fallback := lower_fallback(fallback, payload, cx, env, &absence_env)
            return TExpr{ty: payload, kind: TExprKind.OrFallback{value: after_result, fallback: absence_fallback}}
        }
        else -> {}
    }
    result_ty := if value_t.ty == { .Option(inner) -> inner.clone(); .Result(ok, _) -> ok.clone(); else -> value_t.ty.clone() }
    optional_success := if value_t.ty == { .Option(_) -> true; else -> false }
    fallback_env := clone_env(env)
    if value_t.ty == { .Result(_, err) -> { if !optional_success { fallback_env.bind(Syntax.AMBIENT_ERR, ambient_err_local(), Val(err.clone())) } }; else -> {} }
    tfallback := lower_fallback(fallback, result_ty, cx, env, &fallback_env)
    TExpr{ty: result_ty, kind: TExprKind.OrFallback{value: value_t, fallback: tfallback}}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1409
fn lower_expr_node(e: Expr, cx: Cx, env: &LowerEnv) -> TExpr Never! {
    canonicalize_pre_tier_expr(if e == {
        .MethodCall(_, _, _, _, _, _, _, _, _, _) -> lower_method_chain(e, cx, &env)
        .ListLit(elems, _) -> lower_list_lit(elems, cx, &env)
        .OrFallback(value, fallback, _) -> lower_or_fallback(value, fallback, cx, &env)
        else -> lower_expr_inner(e, cx, &env)
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1425
fn lower_pre_contracts_for_args(call_span: Span, args: &[TCallArg], param_names: [String], sig: [(AccessConvention, Type)]?, clauses: [ContractClause], cx: Cx, caller_env: LowerEnv) -> ([TStmt], [TContract]) Never! {
    if clauses.is_empty() -> return ([], [])
    contract_env := LowerEnv.new(caller_env.fn_name.clone())
    contract_env.sentries_fenced = caller_env.sentries_fenced
    contract_env.stack_sentry_needed = caller_env.stack_sentry_needed.clone()
    proof_bindings: [String:Type] := [:]
    bindings: [TStmt] := []
    loop (index, arg) in &args.enumerate() {
        param_name :: param_names.get(index) ?? break
        ty := sig.and_then(fn(params) { params.get(index) }).map(fn(pair) { pair.1.clone() }).unwrap_or_else(fn() { arg.value.ty.clone() })
        temp := "{Syntax.GENERATED_NAME_PREFIX}contract_arg_{call_span.start}_{index}"
        moves_value := arg.fact_channel().exclusivity == TExclusivity.Move
        init := std.mem.replace(&arg.value, TExpr{ty: ty.clone(), kind: TExprKind.Unit})
        actual_ty := init.ty.clone()
        if arg.clone || arg.arc_clone {
            init = TExpr{ty: init.ty.clone(), kind: TExprKind.Clone(init, call_arg_copy_fact(arg.arc_clone))}
            arg.clone = false
            arg.arc_clone = false
        }
        local := if arg.borrow || arg.mut_borrow {
            init = TExpr{ty: init.ty.clone(), kind: TExprKind.Borrow{place: init, mutable: arg.mut_borrow}}
            TLocal.user(temp).through_ref()
        } else -> TLocal.user(temp)
        replacement := TExpr{ty: ty.clone(), kind: TExprKind.Local(local.clone())}
        arg.value = if moves_value -> TExpr{ty: ty.clone(), kind: TExprKind.Move(replacement)} else -> replacement
        contract_env.bind(param_name, local, Val(ty.clone()))
        proof_bindings.insert(param_name.clone(), actual_ty)
        bindings.push(TStmt.Let{name: temp, kw: "let", let_ty: TLetTy.inferred(), init: init, gc_promotion: None, gc_transferred: false})
    }
    (_, line, _) := tir_src_line_at(cx.src, cx.src_lines(), call_span.start)
    lowered: [TContract] := [TContract].with_capacity(clauses.len())
    loop clause in clauses {
        condition := lower_expr(clause.cond, cx, &contract_env)
        message := lower_expr(clause.message_expr, cx, &contract_env)
        lowered.push(TContract{kind: TContractKind.Pre, condition: condition, message: message, file: cx.file.clone(), line: line, span: call_span, disposition: if contract_expr_proven(clause.cond, proof_bindings, cx) -> TContractDisposition.Proven else -> TContractDisposition.Check})
    }
    (bindings, lowered)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1542
fn lower_call_pre_contracts(call: Call, args: &[TCallArg], clauses: [ContractClause], cx: Cx, caller_env: LowerEnv) -> ([TStmt], [TContract]) Never! {
    param_names :: cx.fn_param_names.get(call.name) ?? return ([], [])
    lower_pre_contracts_for_args(call.name_span, &args, param_names, cx.sigs.get(call.name), clauses, cx, caller_env)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1567
fn lower_method_pre_contracts(call: Expr, lowered: TExpr, cx: Cx, caller_env: LowerEnv) -> TExpr Never! {
    (method, method_span, recv_type) := if call == { .MethodCall(_, method, method_span, _, _, _, recv_type, _, _, _) -> (method, method_span, recv_type); else -> return lowered }
    source_owner := recv_type.map(fn(name) { name.rsplit_once('.').map_or(name, fn(pair) { pair.1 }) })
    key := if lowered.kind == {
        .MethodCall(_, _, _, _, _) -> { owner :: source_owner ?? return lowered; "{owner}::{method}" }
        .StaticCall(.User(owner), _, _, _, _) -> "{owner}::{method}"
        else -> return lowered
    }
    (pre, _) :: cx.contract_sigs.get(key) ?? return lowered
    names :: cx.fn_param_names.get(key) ?? return lowered
    clauses := pre.clone()
    param_names := names.clone()
    if clauses.is_empty() -> return lowered
    type_name := key.split_once("::").map_or(key, fn(pair) { pair.0 })
    (bindings, contracts) := if &lowered.kind == {
        .MethodCall(recv, _, _, _, args) -> {
            recv_value := std.mem.replace(&recv, TExpr{ty: unit_type(), kind: TExprKind.Unit})
            self_conv := cx.method_self_convs.get((type_name.to_string(), method.to_string())).unwrap_or(AccessConvention.Read)
            self_ty := recv_value.ty.clone()
            receiver := TCallArg{borrow: self_conv == AccessConvention.Read && !self_ty.is_scalar(), mut_borrow: self_conv == AccessConvention.Write, value: recv_value, template_items: None, clone: false, arc_clone: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None}
            method_sig := cx.method_sigs.get((type_name.to_string(), method.to_string()))
            sig: [(AccessConvention, Type)] := [(AccessConvention, Type)].with_capacity(method_sig.map_or(0, fn(s) { s.len() }) + 1)
            sig.push((self_conv, self_ty))
            if method_sig == { Val(s) -> sig.extend(s.clone()); else -> {} }
            all_args: [TCallArg] := [TCallArg].with_capacity(args.len() + 1)
            all_args.push(receiver)
            all_args.append(&args)
            result := lower_pre_contracts_for_args(method_span, &all_args, param_names, Val(sig), clauses, cx, caller_env)
            receiver_arg := all_args.remove(0)
            recv = receiver_arg.value
            args = all_args
            result
        }
        .StaticCall(_, _, _, _, args) -> lower_pre_contracts_for_args(method_span, &args, param_names, cx.method_sigs.get((type_name.to_string(), method.to_string())), clauses, cx, caller_env)
        else -> panic("method contract dispatch changed during lowering")
    }
    if contracts.is_empty() -> return lowered
    ty := lowered.ty.clone()
    stmts := bindings
    loop contract in contracts { stmts.push(TStmt.Contract{contract: contract}) }
    stmts.push(TStmt.ExprStmt(lowered))
    TExpr{ty: ty, kind: TExprKind.InlineBlock(stmts)}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1712
fn canonicalize_pre_tier_expr(expr: TExpr) -> TExpr Never! {
    ty := expr.ty.without_user_tags().erased_inline_ranges()
    is_range := if ty.erased_carrier() == { .Named(name) -> name == Syntax.TYPE_RANGE; else -> false }
    expr.ty = if is_range -> Type.Named(Syntax.TYPE_RANGE.to_string()) else -> ty
    expr
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1722
fn expr_cache_begin() -> Bool Never! {
    EXPR_WORKLIST_CACHE.with(fn(cell) {
        cache := cell.borrow_mut()
        if cache.active -> false
        else {
            cache.active = true
            cache.values.clear()
            cache.types.clear()
            cache.method_sigs.clear()
            true
        }
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1737
fn expr_cache_end() -> Void Never! {
    EXPR_WORKLIST_CACHE.with(fn(cell) {
        cache := cell.borrow_mut()
        cache.active = false
        cache.values.clear()
        cache.types.clear()
        cache.method_sigs.clear()
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1747
struct ExprCacheOwner { owns_cache: Bool }

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1764
// Each environment/comptime/lambda pass owns its AST-pointer memo.
pub struct ExprCacheScope {
    saved: ExprWorklistCache
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1769
    pub fn enter() -> ExprCacheScope Never! {
        ExprCacheScope{saved: EXPR_WORKLIST_CACHE.with(fn(cell) { std.mem.replace(&cell.borrow_mut(), ExprWorklistCache.default()) })}
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1777
    pub fn drop(self: &ExprCacheScope) -> Void Never! {
        saved := std.mem.replace(&self.saved, ExprWorklistCache.default())
        EXPR_WORKLIST_CACHE.with(fn(cell) { cell.replace(saved) })
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1785
pub fn with_lambda_body_expr_cache<R>(body: fn() -> R) -> R Never! {
    scope := ExprCacheScope.enter()
    defer { scope.drop() }
    body()
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1794
fn lower_temporary_expr(e: Expr, cx: Cx, env: &LowerEnv) -> TExpr Never! {
    scope := ExprCacheScope.enter()
    defer { scope.drop() }
    lower_expr(e, cx, &env)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/expressions.rs:1799
// D-CTCACHE1: comptime re-entry must not consume the runtime AST-pointer memo.
