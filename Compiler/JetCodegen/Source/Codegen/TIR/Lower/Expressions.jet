//RS 
//RS /// Run one branch body in its own stack frame.
//RS ///
//RS /// At `opt-level=0` rustc emits no `llvm.lifetime` markers, so LLVM's
//RS /// StackColoring pass never runs and one giant `match`/gate chain reserves the
//RS /// SUM of every branch's locals in a single frame instead of the maximum.
//RS /// `lower_expr` -> `lower_expr_inner` -> `lower_method_call_impl` ->
//RS /// `lower_expr` is a recursive cycle, so that sum is multiplied by source
//RS /// nesting depth and a debug-built test binary overflowed libtest's 2 MiB
//RS /// worker stack after two levels. Wrapping a branch body here keeps its locals
//RS /// in the closure's own frame, so one nesting level costs the ONE branch it
//RS /// takes rather than all of them.
//RS ///
//RS /// `#[inline(never)]` keeps the call boundary at every optimization level; at
//RS /// `opt-level=0`, where the overflow lives, the closure is a plain call.
//RS #[inline(never)]
//RS pub(crate) fn in_own_frame<R>(body: impl FnOnce() -> R) -> R {
//RS     body()
//RS }
//RS 
