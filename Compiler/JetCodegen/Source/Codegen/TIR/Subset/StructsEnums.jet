use jet_foundation.AST.[Type, VariantPayload]
use jet_foundation.[Syntax, Layout]
use jet_codegen.Codegen.Context.Cx
use jet_codegen.Codegen.TIR.[is_covered_cell_ty, is_covered_compute_ty, is_covered_distinct_ty, is_covered_fallible_ty, is_covered_foreign_value_ty, is_covered_pool_ty, is_covered_shared_guard_ty, is_covered_shared_ty, is_covered_shared_weak_ty, is_type_var_param_ty]
use jet_codegen.Codegen.[alloc_handle_rust_type, is_db_value_type_name, is_json_type_name, net_handle_rust_type]
use jet_codegen.Codegen.TIR.Subset.Types.foreign_type_module
use jet_sema.Generics.is_type_var_name
use std.collections.HashSet

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/structs_enums.rs:31
pub fn is_covered_enum_ty(ty: &Type, cx: &Cx) -> Bool {
    if ty == .Named(name) -> enum_is_covered(name, cx) else -> false
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/structs_enums.rs:38
pub fn enum_is_covered(name: String, cx: &Cx) -> Bool {
    seen := HashSet<String>.new()
    enum_is_covered_inner(name, cx, &seen)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/structs_enums.rs:47
pub fn enum_tag_is_covered(name: String, cx: &Cx) -> Bool {
    canonical_name := cx.foreign_type_identity("", name).unwrap_or_else(fn() { name.to_string() })
    is_foreign := foreign_type_module(canonical_name, cx).is_some()
    cx.enum_variants.contains_key(canonical_name) && (is_foreign || cx.cloneable.contains(name) || cx.cloneable.contains(canonical_name))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/structs_enums.rs:59
pub fn core_enum_equal_type(name: String) -> Bool {
    if name == {
        "ProcessStreamMode" | "ProcessResourceLimit" | "TerminalMode" | "EncodingFormat" | "EncodingErrorKind" | "DataEvent" | "CBORErrorKind" | "XMLReason" | "XMLEntityPolicy" | "XMLEncoding" | "XMLLexicalPolicy" | "XMLCanonicalMode" | "DataErrorKind" | "DurationUnit" | "LocalDate" | "Range" | "TLSVersion" -> true
        else -> false
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/structs_enums.rs:115
pub fn enum_is_covered_inner(name: String, cx: &Cx, seen: &HashSet<String>) -> Bool {
    if name == "DataEvent" || name == Syntax.TYPE_TASK_FAILURE -> return true
    if (is_type_var_name(name) && !cx.enum_variants.contains_key(name)) || is_json_type_name(name) || is_db_value_type_name(name) || core_enum_or_prelude(name) -> return false
    canonical_name := cx.foreign_type_identity("", name).unwrap_or_else(fn() { name.to_string() })
    is_foreign := foreign_type_module(canonical_name, cx).is_some()
    variants := cx.enum_variants.get(canonical_name) ?? return false
    carries_mutable_view := cx.type_contains_mutable_view(Type.Named(name.to_string()))
    if !seen.insert(canonical_name.clone()) -> return true
    // Recursive boxed edges are admitted under this same seen set.
    payloads_covered := variants.iter().all(fn(entry) {
        (_, payload) := entry
        if payload == {
            .Unit -> true
            .Single(t, _) -> enum_payload_ty_covered(t, cx, seen)
            .Named(fs) -> fs.iter().all(fn(f) { enum_payload_ty_covered(f.ty, cx, seen) })
        }
    })
    ok := payloads_covered && (is_foreign || cx.cloneable.contains(name) || carries_mutable_view)
    seen.remove(canonical_name)
    ok
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/structs_enums.rs:186
pub fn enum_payload_ty_covered(ty: &Type, cx: &Cx, seen: &HashSet<String>) -> Bool {
    if ty.is_scalar() || ty is .Char || ty is .String -> return true
    if ty == .Apply{name, args} {
        if (name == "View" || name == "ViewMut" || name == "ComputeViewMut" || name == Syntax.TYPE_PIN) && args.len() == 1 -> return true
    }
    if is_covered_foreign_value_ty(ty, cx) || is_covered_distinct_ty(ty, cx) -> return true
    if ty == {
        .Union(members) -> !members.is_empty() && members.iter().all(fn(member) { enum_payload_ty_covered(member, cx, seen) })
        .Named(n) -> { if cx.enum_variants.contains_key(n) -> enum_is_covered_inner(n, cx, seen) else -> is_covered_struct_ty(ty, cx) }
        .List(inner) | .Option(inner) -> enum_payload_ty_covered(inner, cx, seen)
        .Map{key, value, ..} -> enum_payload_ty_covered(key, cx, seen) && enum_payload_ty_covered(value, cx, seen)
        .Apply{..} -> is_covered_pool_ty(ty, cx) || is_covered_shared_guard_ty(ty, cx) || is_covered_shared_weak_ty(ty, cx)
        .Shared(_) -> is_covered_shared_ty(ty, cx)
        else -> false
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/structs_enums.rs:246
pub fn core_enum_or_prelude(name: String) -> Bool {
    net_handle_rust_type(name).is_some() || alloc_handle_rust_type(name).is_some()
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/structs_enums.rs:261
pub fn is_covered_struct_ty(ty: &Type, cx: &Cx) -> Bool {
    if ty != .Named(name) -> return false
    if foreign_type_module(name, cx).is_some() -> return is_covered_foreign_value_ty(ty, cx)
    seen := HashSet<String>.new()
    struct_is_covered(name, cx, &seen)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/structs_enums.rs:279
pub fn struct_lit_constructible(name: String, cx: &Cx, seen: &HashSet<String>) -> Bool {
    is_type_var := is_type_var_name(name) && !cx.struct_fields.contains_key(name)
    if cx.trait_names.contains(name) || cx.enum_variants.contains_key(name) || foreign_type_module(name, cx).is_some() || net_handle_rust_type(name).is_some() || is_type_var || struct_is_generic(name, cx) -> return false
    fields := cx.struct_fields.get(name) ?? return false
    if !seen.insert(name.to_string()) -> return true
    ok := fields.iter().all(fn(entry) {
        (fname, fty) := entry
        // GATE #4499: exact tuple-key equality for boxed-edge identity.
        if cx.boxed_edges.contains((name.to_string(), fname.clone())) -> boxed_field_payload_constructible(fty, cx, seen)
        else -> field_ty_covered(fty, cx, seen)
    })
    seen.remove(name)
    ok
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/structs_enums.rs:317
pub fn boxed_field_payload_constructible(ty: &Type, cx: &Cx, seen: &HashSet<String>) -> Bool {
    if ty == { .Option(inner) -> boxed_field_payload_constructible(inner, cx, seen); .Named(n) -> struct_lit_constructible(n, cx, seen); else -> false }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/structs_enums.rs:338
pub fn struct_is_generic(name: String, cx: &Cx) -> Bool {
    cx.struct_type_params.get(name).map(fn(params) { !params.is_empty() }).unwrap_or(false)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/structs_enums.rs:345
pub fn struct_is_covered(name: String, cx: &Cx, seen: &HashSet<String>) -> Bool {
    is_type_var := is_type_var_name(name) && !cx.struct_fields.contains_key(name)
    if cx.trait_names.contains(name) || cx.enum_variants.contains_key(name) || net_handle_rust_type(name).is_some() || is_type_var -> return false
    fields := cx.struct_fields.get(name) ?? return false
    if !seen.insert(name.to_string()) -> return true
    declared_params := cx.struct_type_params.get(name)
    ok := fields.iter().all(fn(entry) {
        (fname, fty) := entry
        // GATE #4499: preserve tuple-key equality, not string encoding.
        if cx.boxed_edges.contains((name.to_string(), fname.clone())) -> return boxed_field_payload_covered(fty, cx, seen)
        if fty == .Named(param) {
            if declared_params.is_some_and(fn(params) { params.contains(param) }) -> return true
        }
        field_ty_covered(fty, cx, seen)
    })
    seen.remove(name)
    ok
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/structs_enums.rs:391
pub fn boxed_field_payload_covered(ty: &Type, cx: &Cx, seen: &HashSet<String>) -> Bool {
    if ty == { .Option(inner) -> boxed_field_payload_covered(inner, cx, seen); .Named(n) -> struct_is_covered(n, cx, seen); else -> false }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/structs_enums.rs:401
pub fn field_ty_covered(ty: &Type, cx: &Cx, seen: &HashSet<String>) -> Bool {
    if ty.is_scalar() || ty is .Char || ty is .String -> return true
    if is_covered_compute_ty(ty) -> return true
    if ty == .Apply{name, args} {
        if (name == "View" || name == "ViewMut" || name == "ComputeViewMut" || name == Syntax.TYPE_PIN) && args.len() == 1 -> return true
    }
    if is_type_var_param_ty(ty, cx) || is_covered_foreign_value_ty(ty, cx) -> return true
    if ty == .Union(members) -> return !members.is_empty() && members.iter().all(fn(m) { field_ty_covered(m, cx, seen) })
    if is_covered_enum_ty(ty, cx) || is_covered_distinct_ty(ty, cx) || is_covered_fallible_ty(ty, cx) -> return true
    if ty is .Fn{..} -> return true
    if ty == {
        .Named(n) -> struct_is_covered(n, cx, seen)
        .List(inner) -> field_ty_covered(inner, cx, seen)
        .FixedList{elem, ..} -> field_ty_covered(elem, cx, seen)
        .Map{key, value, ..} -> field_ty_covered(key, cx, seen) && field_ty_covered(value, cx, seen)
        .Tuple(fields) -> fields.iter().all(fn(entry) { (_, field_ty) := entry; field_ty_covered(field_ty, cx, seen) })
        .Tagged{inner, ..} -> field_ty_covered(inner, cx, seen)
        .Apply{name, args} if name == "Atomic" -> args.len() == 1 && Layout.atomic_scalar_type(args[0])
        .Apply{..} -> is_covered_pool_ty(ty, cx) || is_covered_shared_guard_ty(ty, cx) || is_covered_shared_weak_ty(ty, cx) || is_covered_cell_ty(ty, cx)
        .Shared(_) -> is_covered_shared_ty(ty, cx)
        else -> false
    }
}
