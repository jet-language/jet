        .PtrFromAddr(addr: addr, ..) -> expr_in_subset(addr, cx, locals)
        .Deref(inner, _) | .RawOf(inner, _) | .Copy(inner, _) | .Place(inner, _, _) -> expr_in_subset(inner, cx, locals)
