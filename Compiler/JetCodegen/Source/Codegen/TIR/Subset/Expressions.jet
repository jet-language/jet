        .PatternTest(subject: subject, pattern: .Absent(_), ..) -> expr_in_subset(subject, cx, locals)
        .PatternTest(subject: subject, pattern: pattern, ..) if pattern.has_nested_pattern() -> expr_in_subset(subject, cx, locals)
        .PatternTest(subject: subject, pattern: .Variant(variant: variant, bindings: bindings, ..), ..) if bindings.is_empty() && cx.variant_owner.contains_key(variant) -> expr_in_subset(subject, cx, locals)
        .PatternTest(subject: subject, pattern: .BinMatch(..) | .StrMatch(..), ..) -> expr_in_subset(subject, cx, locals)
        .Binary(op, left, right, _) if fold_typed_fact_enum_equality(op, left, right) != None -> true
        .Binary(_, left, right, _) -> expr_in_subset(left, cx, locals) && expr_in_subset(right, cx, locals)
        .CompareChain(operands: operands, ..) -> operands.all(fn(operand) { expr_in_subset(operand, cx, locals) })
