}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/expressions.rs:1046
fn is_binder_ref_name(name: String) -> Bool Never! {
    rest :: name.strip_prefix(mangle_generated("binder_ref_")) ?? return false
    (site, slot) :: rest.split_once('_') ?? return false
    !site.is_empty() && !slot.is_empty() && site.chars().all(fn(ch) { ch.is_ascii_digit() }) && slot.chars().all(fn(ch) { ch.is_ascii_digit() })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/expressions.rs:1064
pub fn ident_is_named_fn_value(name: String, cx: Cx, locals: HashSet<String>) -> Bool Never! {
    !locals.contains(name) && !cx.consts.contains_key(name) && (if cx.fn_types.get(name) == { .Val(.Fn(..)) -> true else -> false })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/expressions.rs:1076
pub fn orfallback_rhs_in_subset(fallback: OrFallback, cx: Cx, locals: HashSet<String>) -> Bool Never! {
    fallback_locals := locals.clone()
    &fallback_locals.insert(Syntax.AMBIENT_ERR)
    if fallback == {
        .Value(inner) -> expr_in_subset(inner, cx, fallback_locals)
        .Block(body: body, value: value, ..) -> body.all(fn(statement) { stmt_in_subset(statement, cx, &fallback_locals) }) && value.is_none_or(fn(inner) { expr_in_subset(inner, cx, fallback_locals) })
        .Return(None, _) -> true
        .Return(.Val(inner), _) -> expr_in_subset(inner, cx, fallback_locals)
        .Panic(args: args, ..) -> args.len() == 1 && expr_in_subset(args[0].expr, cx, fallback_locals)
        .Break(_) | .Continue(_) | .BreakLabel(..) | .ContinueLabel(..) -> true
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/expressions.rs:1115
pub fn lambda_in_subset(lam: Lambda, cx: Cx, locals: HashSet<String>) -> Bool Never! {
    body_locals := locals.clone()
    loop parameter in lam.params -> &body_locals.insert(parameter.name)
    if lam.body == {
        .Expr(inner) -> expr_in_subset(inner, cx, body_locals)
        .Block(statements) -> statements.all(fn(statement) { stmt_in_subset(statement, cx, &body_locals) })
    }
}
