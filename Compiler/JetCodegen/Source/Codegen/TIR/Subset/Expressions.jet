            }
            if resolved_type == "TLSVersion" -> return args.is_empty() && (variant == "TLS12" || variant == "TLS13")
            if resolved_type == "TLSClientTrust" && (variant == "System" || variant == "SystemPlus" || variant == "CustomOnly") {
