        .ListLit(elements, _) -> elements.all(fn(inner) { expr_in_subset(inner, cx, locals) })
        .Range(start: start, end: end, ..) -> expr_in_subset(start, cx, locals) && expr_in_subset(end, cx, locals)
        .Spread(inner, _) -> expr_in_subset(inner, cx, locals)
        .TupleLit(fields, _, ty) -> (if ty == { .Val(.Tuple(_)) -> true else -> false }) && fields.all(fn(field) { expr_in_subset(field.value, cx, locals) })
