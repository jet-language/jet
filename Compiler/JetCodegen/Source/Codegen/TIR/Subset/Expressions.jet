            if type_name == Syntax.DURATION_UNIT_TYPE -> return Syntax.DURATION_UNITS.contains(variant)
            if type_name == Syntax.TYPE_REDUCE_OP -> return args.is_empty() && (if variant == { "Add" | "Mul" | "Min" | "Max" | "Avg" -> true else -> false })
            if type_name == "NetShutdown" -> return variant == "Read" || variant == "Write" || variant == "Both"
            if type_name == "NetReadyInterest" -> return variant == "Read" || variant == "Write" || variant == "ReadWrite"
            if resolved_type == "XMLCanonicalMode" -> return args.is_empty() && (variant == "Inclusive11" || variant == "Exclusive10")
            if resolved_type == "XMLEncoding" -> return args.is_empty() && (if variant == { "UTF8" | "UTF8BOM" | "UTF16LE" | "UTF16BE" -> true else -> false })
            if resolved_type == "XMLLexicalPolicy" -> return args.is_empty() && (variant == "PreserveValid" || variant == "Deterministic")
            if !enum_is_covered(resolved_type, cx) && !(core_rust_type_name(resolved_type) != None && cx.enum_variants.contains_key(resolved_type)) -> return false
            if !cx.enum_variants.get(resolved_type).is_some_and(fn(variants) { variants.any(fn(row) { row.0 == variant }) }) -> return false
            args.all(fn(arg) { if arg == { .Positional(inner) -> expr_in_subset(inner, cx, locals) .Named(expr: inner, ..) -> expr_in_subset(inner, cx, locals) } })
