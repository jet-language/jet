            if grouped_enum_unit_variant(cx, receiver, member, fn(name) { locals.contains(name) }) != None -> return true
            if receiver == .Ident(enum_name, _) {
                resolved_enum :: cx.core_qualified_rust_type_name(enum_name) ?? enum_name
                if !locals.contains(enum_name) && (
                    (resolved_enum == "SMTPSecurity" && (member == "StartTLS" || member == "TLS"))
                    || (resolved_enum == "RecipientPolicy" && (member == "RequireAll" || member == "DeliverAccepted"))
                    || (resolved_enum == "SMTPAuth" && member == "None") || (resolved_enum == "TLSTrust" && member == "System")
                    || (resolved_enum == "NetReadyInterest" && (member == "Read" || member == "Write" || member == "ReadWrite"))
                    || (resolved_enum == "NetShutdown" && (member == "Read" || member == "Write" || member == "Both"))) -> return true
                if !locals.contains(enum_name) && !cx.type_names.contains(enum_name)
                    && (resolved_enum == "FontStyle" || resolved_enum == "GlyphShaper")
                    && core_enum_variants(resolved_enum).is_some_and(fn(variants) { variants.contains(member) }) -> return true
                if enum_name == "DataEvent" && (if member == { "Null" | "ArrayStart" | "ArrayEnd" | "ObjectStart" | "ObjectEnd" -> true else -> false }) -> return true
                if (enum_name == "EncodingFormat" && (if member == { "JSON" | "JSONL" | "CSV" | "XML" | "CBOR" -> true else -> false }))
                    || (enum_name == "EncodingErrorKind" && (if member == { "Syntax" | "Truncated" | "Unsupported" | "Limit" | "IO" | "State" -> true else -> false })) -> return true
                if !locals.contains(enum_name) && (enum_is_covered(resolved_enum, cx) || core_rust_type_name(resolved_enum) != None)
                    && cx.enum_variants.get(resolved_enum).is_some_and(fn(variants) { variants.any(fn(row) { row.0 == member && row.1 == VariantPayload.Unit }) }) -> return true
                if !locals.contains(enum_name) && cx.variant_owner.get(member).is_some_and(fn(owner) { owner.rsplit("::").next() == Val(enum_name) && enum_is_covered(owner, cx) }) -> return true
                if !locals.contains(enum_name) && is_json_type_name(enum_name) && member == "Null" -> return true
                if !locals.contains(enum_name) && is_db_value_type_name(enum_name) && member == "Null" -> return true
                if !locals.contains(enum_name) && numeric_type_from_name(enum_name) != None && is_numeric_bounds_const(member) -> return true
                if !locals.contains(enum_name) && cx.consts.contains_key(enum_name) -> return true
