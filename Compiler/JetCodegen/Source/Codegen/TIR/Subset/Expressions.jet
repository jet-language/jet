        .Call(c) -> {
            if c.name == Syntax.BUILTIN_CHANNEL && !cx.sigs.contains_key(c.name) && !locals.contains(c.name) {
                return c.args.len() <= 1
                    && (if c.resolved_ret == { .Val(.Tuple(_)) -> true else -> false })
                    && c.args.all(fn(arg) { (arg.label == None || arg.label.is_some_and(fn(label) { label.name == "capacity" })) && expr_in_subset(arg.expr, cx, locals) })
