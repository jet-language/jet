            if locals.contains(c.name) && !cx.consts.contains_key(c.name) -> return c.args.all(fn(arg) { expr_in_subset(arg.expr, cx, locals) })
            is_print :: c.name == Syntax.BUILTIN_PRINT && !cx.sigs.contains_key(c.name) && !locals.contains(c.name) && !c.args.is_empty()
            is_zip_family :: (c.name == "zip" || c.name == "zip_short" || c.name == "zip_pad") && !cx.sigs.contains_key(c.name) && !locals.contains(c.name) && c.resolved_ret != None
            is_drop :: c.name == Syntax.BUILTIN_CONSUME && !cx.sigs.contains_key(c.name) && !locals.contains(c.name) && c.args.len() == 1
            is_expect :: c.name == Syntax.BUILTIN_EXPECT && !cx.sigs.contains_key(c.name) && !locals.contains(c.name) && c.args.len() == 1
            is_close :: c.name == Syntax.RESOURCE_CLOSE && !locals.contains(c.name) && c.args.len() == 1
            is_assert :: c.name == Syntax.BUILTIN_ASSERT && !cx.sigs.contains_key(c.name) && !locals.contains(c.name) && (c.args.len() == 1 || c.args.len() == 2)
            is_assert_eq :: c.name == Syntax.BUILTIN_ASSERT_EQ && !cx.sigs.contains_key(c.name) && !locals.contains(c.name) && c.args.len() == 2
            is_panic :: c.name == Syntax.BUILTIN_PANIC && !cx.sigs.contains_key(c.name) && !locals.contains(c.name) && c.args.len() == 1
            is_ambient_input :: c.name == Syntax.BUILTIN_INPUT && !cx.sigs.contains_key(c.name) && !locals.contains(c.name) && c.args.len() <= 1
            builtin_approx :: c.name == Syntax.BUILTIN_APPROX && !cx.sigs.contains_key(c.name) && !locals.contains(c.name)
            if c.widen_approx || builtin_approx -> return c.args.len() == 1 && c.args[0].label == None && expr_in_subset(c.args[0].expr, cx, locals)
            if c.name == Syntax.INTERNAL_DEBUG_TRACE -> return c.args.len() == 2 && expr_in_subset(c.args[0].expr, cx, locals)
            if (c.name == Syntax.BUILTIN_WRAPPING || c.name == Syntax.BUILTIN_SATURATING || c.name == Syntax.BUILTIN_CHECKED || c.name == Syntax.INTERNAL_ARITHMETIC_CHECKED)
                && !cx.sigs.contains_key(c.name) && !locals.contains(c.name) {
