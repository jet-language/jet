//RS         // D-VARIADIC1: list/call spread — covered when the spread operand is in-subset.
//RS         Expr::Spread(inner, _) => expr_in_subset(inner, cx, locals),
//RS         // c109 Phase 23: a named-tuple literal `(x: 1, y: 2)` (S73/D-SG7). Covered when
//RS         // sema resolved the tuple TYPE (`ty.is_some()` — the canonical field order +
//RS         // struct name come from it; an unresolved `ty` would force the AST's empty-
//RS         // canonical `0i64` default, which the TIR must not guess) and every field value
//RS         // is in-subset. The literal's values are reordered to the type's canonical field
//RS         // order at lowering, reproducing `emit_expr`'s `TupleLit` arm.
//RS         Expr::TupleLit(fields, _, ty) => {
//RS             matches!(ty, Some(Type::Tuple(_)))
//RS                 && fields.iter().all(|(_, e)| expr_in_subset(e, cx, locals))
//RS         }
//RS         // c109 Phase 5: a map literal `[k: v, …]` / `[:]`. Covered when every key
//RS         // and value is in-subset. The empty `[:]` (no entries) is always covered.
//RS         Expr::MapLit(entries, _) => entries
//RS             .iter()
//RS             .all(|(k, v)| expr_in_subset(k, cx, locals) && expr_in_subset(v, cx, locals)),
//RS         // c109 Phase 5: indexing `coll[i]`. The `IndexKind` must be sema-resolved
//RS         // (not `Unknown`) so the helper dispatch (`jet_index_map`/`jet_index_vec`)
//RS         // is a total fact carried onto the TIR. Base + index must be in-subset.
//RS         Expr::Index {
//RS             base, index, kind, ..
//RS         } => {
//RS             !matches!(kind, IndexKind::Unknown)
//RS                 && expr_in_subset(base, cx, locals)
//RS                 && expr_in_subset(index, cx, locals)
//RS         }
//RS         // c109 Phase 5: an inclusive copy slice `coll[a..b]` (lists only — the AST
//RS         // path's `jet_slice_vec` is list-specific). Base/start/end must be in-subset.
//RS         Expr::Slice {
//RS             base,
//RS             start,
//RS             end,
//RS             range,
//RS             ..
//RS         } => {
//RS             expr_in_subset(base, cx, locals)
//RS                 && range.as_deref().map_or_else(
//RS                     || expr_in_subset(start, cx, locals) && expr_in_subset(end, cx, locals),
//RS                     |range| expr_in_subset(range, cx, locals),
//RS                 )
//RS         }
//RS         // c109 Phase 6: a method call. Covered in exactly two shapes:
//RS         //   (a) the sema-inserted `.clone()` (an owning non-Copy field read /
//RS         //       borrowed value in owning position) — `(recv).clone()`;
//RS         //   (b) a user-defined instance method on a covered struct/enum type
//RS         //       (`recv_type` is `Some(T)`, `(T, method)` ∈ `method_sigs`, and the
//RS         //       method name is NOT one a core/stdlib/builtin lowering intercepts).
//RS         // Everything else (core/stdlib/collection/string/numeric methods, static
//RS         // calls — whose `recv_type` is `None` — fallible/optional, fan-out, …) stays
//RS         // on the AST path.
//RS         Expr::MethodCall {
//RS             receiver,
//RS             method,
//RS             args,
//RS             recv_type,
//RS             resolved_ret,
//RS             ..
//RS         } => method_call_in_subset(receiver, method, args, recv_type, resolved_ret, cx, locals),
//RS         // D-TAINT1: `#Tainted expr` — the tag is erased; in-subset iff the inner is.
//RS         Expr::Tainted(inner, _, _) => expr_in_subset(inner, cx, locals),
//RS         // c109 Phase 8: optional constructors `value(x)` / `null`. Covered when the
//RS         // inner value (if any) is in-subset — they lower to `Some(x)` / `None`.
//RS         Expr::Present(inner, _) => expr_in_subset(inner, cx, locals),
//RS         Expr::Absent(_) => true,
//RS         // D-REDUCE-VALUE1: a validated ReduceOp. Only appears inside `v.reduce(.Op)`; the
//RS         // method lowering consumes it (it never emits on its own), so it is in-subset.
//RS         Expr::ReduceMarker(_, _) => true,
//RS         // c109 Phase 23: a `#Todo` typed goal. Covered when sema filled the expected
//RS         // type (`expected_type.is_some()`); a `None` (sema didn't run/resolve) stays on
//RS         // the AST path so the TIR never guesses the `(unknown)` fallback.
//RS         Expr::Todo { expected_type, .. } => expected_type.is_some(),
//RS         // Card #1440: the dead end of a sema-proved exhaustive dispatch — a
//RS         // constant diverging leaf, trivially in-subset.
//RS         Expr::NoElse(_) => true,
//RS         // c109 Phase 8: fallible constructors `Ok(x)` / `Err(e)`. Covered when the
//RS         // inner value is in-subset — they lower to `Ok(x)` / `Err(e)`.
//RS         Expr::Ok(inner, _) | Expr::Err(inner, _) => expr_in_subset(inner, cx, locals),
//RS         // c109 Phase 8: the `?` propagation operator. The `TryConvert` decision is a
//RS         // total sema fact (`None`/`Typed { .. }`), reproduced verbatim. The
//RS         // inner fallible value and the lazy note must themselves be in-subset (a
//RS         // user fallible fn call, a local, an `ok`/`err` literal, or a covered
//RS         // string interpolation). A core/stdlib fallible call (e.g. `fs.read`)
//RS         // is NOT in-subset (it stays on the AST path — Phase 10), so a `?` on one is
//RS         // excluded automatically.
//RS         Expr::Try(inner, _, _, note) => {
//RS             expr_in_subset(inner, cx, locals)
//RS                 && note
//RS                     .as_deref()
//RS                     .is_none_or(|note| expr_in_subset(note, cx, locals))
//RS         }
//RS         // c109 Phase 8: the `??` fallback operator. `is_option` is total. The value
//RS         // and the fallback must be in-subset. The Panic fallback form is deferred
//RS         // (its `safe_locals_expr` reproduction is out of subset) — only Value and
//RS         // early-`return` fallbacks are covered.
//RS         Expr::OrFallback {
//RS             value, fallback, ..
//RS         } => expr_in_subset(value, cx, locals) && orfallback_rhs_in_subset(fallback, cx, locals),
//RS         // c109 Phase 8: optional chaining `base?.member`. The `flatten` fact is total
//RS         // (from sema). The base must be in-subset; the member read lowers to a plain
//RS         // `.map`/`.and_then` closure access (no further dispatch).
//RS         Expr::OptField { base, .. } => expr_in_subset(base, cx, locals),
//RS         // c109 Phase 11: a lambda/closure literal. Covered when its body is in-subset
//RS         // (lowered on the outer scope extended with the lambda's params + cloned
//RS         // captures) and every capture/escape decision is a total `Lambda.meta` fact.
//RS         Expr::Lambda(lam) => lambda_in_subset(lam, cx, locals),
//RS         // c109 Phase 13: a direct call THROUGH a fn-value (`Expr::CallValue`).
//RS         // Sema's `.call(args)` projection joins the same TIR function-value path.
//RS         // Covered when the callee is in-subset (a fn-typed local, a fn-name value, or
//RS         // a lambda) and every arg is in-subset. The AST path emits `({callee})({args})`
//RS         // with args lowered plainly (`emit_call_args(.., None, ..)`), so no convention
//RS         // facts are needed — any in-subset arg works; labels are still excluded.
//RS         Expr::CallValue { callee, args, .. }
//RS             if args.is_empty()
//RS                 && matches!(
//RS                     callee.as_ref(),
//RS                     Expr::Lambda(lam) if lam.meta.collecting_loop || lam.meta.result_loop
//RS                 ) =>
//RS         {
//RS             let Expr::Lambda(lam) = callee.as_ref() else {
//RS                 unreachable!("inline-loop guard requires a lambda")
//RS             };
//RS             lambda_in_subset(lam, cx, locals)
//RS         }
//RS         Expr::CallValue { callee, args, .. } => {
//RS             expr_in_subset(callee, cx, locals)
//RS                 && args.iter().all(|a| expr_in_subset(&a.expr, cx, locals))
//RS         }
//RS         // c109 Phase 18: `mem.Ptr<T>.from_addr(addr)` (`Expr::PtrFromAddr`, S58). The
//RS         // address expr must be in-subset. The cast itself is safe Rust (no `unsafe`); it
//RS         // is only constructible inside `use core.mem` + an `#Unsafe` region (sema
//RS         // E3101/E3102), so it never appears in a non-unsafe context. `elem` is a total
//RS         // type on the node — emit needs no inference.
//RS         Expr::PtrFromAddr { addr, .. } => expr_in_subset(addr, cx, locals),
//RS         // D-CAP9: postfix `p.*` deref and prefix `*x` raw-of. Both only appear
//RS         // inside `use core.mem` + an `#Unsafe` region (sema-gated by E0208); the
//RS         // deref/cast forms are byte-for-byte the AST path (no convention facts).
//RS         Expr::Deref(inner, _) | Expr::RawOf(inner, _) => expr_in_subset(inner, cx, locals),
//RS         // D-CAP2 (D-MEM1/S4): `copy x` — in-subset whenever `x` is.
//RS         Expr::Copy(inner, _) => expr_in_subset(inner, cx, locals),
//RS         Expr::Place(inner, _, _) => expr_in_subset(inner, cx, locals),
//RS         // D-BINPAT1 / D-SHIFT1: take_pattern literals are compile-time pattern
//RS         // trees. The handle-method gate matches them; covering the leaves here
//RS         // keeps helper uses and any future call shape from dropping `run`.
//RS         Expr::BinMatchLit(..) | Expr::StrMatchLit(..) => true,
//RS         // Everything else (tuples, …) is out.
//RS         _ => false,
//RS     }
//RS }
//RS 
