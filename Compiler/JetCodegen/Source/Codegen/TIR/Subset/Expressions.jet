// Rust: crates/jet-codegen/src/Codegen/TIR/subset/expressions.rs:29
// Record the innermost expression refusal before its enclosing nodes propagate false.
pub fn expr_in_subset(e: Expr, cx: Cx, locals: HashSet<String>) -> Bool Never! {
    if expr_in_subset_inner(e, cx, locals) -> return true
    refusal.note(refusal.EXPR, e.without_parens().span())
    false
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/expressions.rs:37
fn expr_in_subset_inner(expression: Expr, cx: Cx, locals: HashSet<String>) -> Bool Never! {
    e := expression
    loop {
        if e == { .Paren(inner, _) -> e = inner else -> break }
    }
    if e == {
        .Int(..) | .Float(..) | .Bool(..) | .Char(..) -> true
        .ComptimeName(value: value, ..) -> value != None
        .Str(parts, _) -> parts.all(fn(part) {
            if part == { .Lit(_) -> true .Interp(inner, _) -> expr_in_subset(inner, cx, locals) }
        })
        .Ident(name, _) -> (cx.consts.contains_key(name) && !locals.contains(name)) || locals.contains(name) || is_binder_ref_name(name) || ident_is_named_fn_value(name, cx, locals)
        .Unary(_, inner, _) -> expr_in_subset(inner, cx, locals)
