            visited := HashSet<String>.new()
            if !is_prelude_struct_name(type_name) && !is_covered_struct_ty(Type.Named(type_name), cx) && !struct_lit_constructible(type_name, cx, &visited) -> return false
            fields.all(fn(field) { expr_in_subset(field.value, cx, locals) })
