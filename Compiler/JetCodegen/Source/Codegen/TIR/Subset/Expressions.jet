            is_typed_text_ctor :: !locals.contains(c.name) && Syntax.typed_head_kind(c.name).is_some_and(fn(kind) { kind.is_interpolated_template() }) && !cx.type_names.contains(c.name)
            is_regex_literal_ctor :: !locals.contains(c.name) && c.name == Syntax.TYPE_REGEX && !cx.type_names.contains(c.name)
            is_measurement :: c.name == "measurement" && !cx.sigs.contains_key(c.name) && !locals.contains(c.name) && c.args.len() == 2
                && (if c.resolved_ret == { .Val(.Apply(name, args)) -> name == Syntax.TYPE_MEASUREMENT && args == [Type]{Type.Float} else -> false })
            // Extern routing precedes unqualified imports, matching lowering.
            is_extern :: !locals.contains(c.name) && cx.extern_funcs.contains_key(c.name)
            is_unqual_inline :: !locals.contains(c.name) && !cx.extern_funcs.contains_key(c.name) && (cx.unqualified_inline.contains_key(c.name) || cx.inline_import_names.contains(c.name))
            is_unqual_file :: !locals.contains(c.name) && !cx.extern_funcs.contains_key(c.name) && cx.unqualified_file.contains_key(c.name) && !cx.inline_import_names.contains(c.name)
            (is_print || is_zip_family || is_drop || is_expect || is_close || is_ambient_input || is_assert || is_assert_eq || is_panic
                || is_plain_fn || is_distinct_ctor || is_math_ctor || is_precise_ctor || is_typed_text_ctor || is_regex_literal_ctor || is_measurement || is_extern || is_unqual_inline || is_unqual_file)
                && c.args.all(fn(arg) { (!arg.flags.shared_auto_clone || !is_extern) && (is_zip_family || arg_conv_in_subset(arg)) && expr_in_subset(arg.expr, cx, locals) })
        }
        // Rust: crates/jet-codegen/src/Codegen/TIR/subset/expressions.rs:390
        .If(cond: cond, then_body: then_body, then_value: then_value, else_body: else_body, else_value: else_value, ..) -> {
            bindings :: if_cond_in_subset(cond, cx, locals) ?? return false
            then_locals := locals.clone()
            &then_locals.extend(bindings)
            if !then_body.all(fn(statement) { stmt_in_subset(statement, cx, &then_locals) }) -> return false
            if !expr_in_subset(then_value, cx, then_locals) -> return false
            else_locals := locals.clone()
            else_body.all(fn(statement) { stmt_in_subset(statement, cx, &else_locals) }) && expr_in_subset(else_value, cx, else_locals)
        }
        // Rust: crates/jet-codegen/src/Codegen/TIR/subset/expressions.rs:421
        .StructLit(type_name: type_name, type_args: type_args, import_ns: import_ns, as_trait: as_trait, fields: fields, ..) -> {
            core_email_struct :: import_ns.is_some_and(fn(alias) {
                cx.any_core_import_module(alias) == Val(Syntax.CORE_EMAIL_MODULE)
                    && (if type_name == { "RecipientReport" | "SendReport" | "Limits" | "DKIMConfig" | "SMTPConfig" -> true else -> false })
            })
            core_cbor_struct :: import_ns.is_some_and(fn(alias) { cx.any_core_import_module(alias) == Val("core.encoding.cbor") && (type_name == "CBOROptions" || type_name == "CBORError") && type_args.is_empty() })
            core_encoding_struct :: import_ns.is_some_and(fn(alias) { cx.any_core_import_module(alias) == Val("core.encoding") && (type_name == "EncodingLimits" || type_name == "EncodingCause" || type_name == "EncodingError") && type_args.is_empty() })
            core_xml_struct :: import_ns.is_some_and(fn(alias) {
                cx.any_core_import_module(alias) == Val("core.encoding.xml")
                    && (if type_name == { "XMLLimits" | "XMLParseOptions" | "XMLRenderOptions" | "XMLCanonical" | "XMLError" -> true else -> false }) && type_args.is_empty()
            })
            if as_trait == .Val(trait_name) {
                if !cx.trait_names.contains(trait_name) || import_ns != None || !type_args.is_empty()
                    || is_prelude_struct_name(type_name) || !is_covered_struct_ty(Type.Named(type_name), cx) -> return false
                return fields.all(fn(field) { expr_in_subset(field.value, cx, locals) })
            }
            if import_ns != None && !core_email_struct && !core_cbor_struct && !core_encoding_struct && !core_xml_struct {
