            }
            is_plain_fn :: !locals.contains(c.name) && cx.sigs.contains_key(c.name) && !cx.extern_funcs.contains_key(c.name)
                && !cx.unqualified_inline.contains_key(c.name) && !cx.unqualified_file.contains_key(c.name) && !cx.inline_import_names.contains(c.name)
            is_distinct_ctor :: !locals.contains(c.name) && cx.distinct_types.contains_key(c.name)
