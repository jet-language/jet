use jet_foundation.AST.[BinOp, Expr, PatSlot, Pattern, StructPatField, StrMatchPart, BinMatchPart]
use jet_codegen.Codegen.Context.Cx
use jet_codegen.Codegen.TIR.expr_in_subset
use jet_foundation.Syntax
use std.collections.HashSet

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/patterns.rs:11
pub fn arm_is_plain_cond(cx: &Cx, cond: &Expr, subject: &Expr) -> Bool {
    if arm_variant_pattern(cx, cond, subject).is_some() -> return false
    if arm_head_range(cx, cond, subject).is_some() -> return false
    if cond is .PatternTest{..} -> return false
    true
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/patterns.rs:30
pub fn arm_str_match_pattern(cx: &Cx, cond: &Expr, subject: &Expr) -> Pattern? {
    if cond == {
        .PatternTest{subject: s, pattern, ..} if pattern is .StrMatch{..} && pattern_subjects_match(cx, s, subject) -> Val(pattern.clone())
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/patterns.rs:43
pub fn arm_bin_match_pattern(cx: &Cx, cond: &Expr, subject: &Expr) -> Pattern? {
    if cond == {
        .PatternTest{subject: s, pattern, ..} if pattern is .BinMatch{..} && pattern_subjects_match(cx, s, subject) -> Val(pattern.clone())
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/patterns.rs:55
pub fn arm_struct_pattern(cx: &Cx, cond: &Expr, subject: &Expr) -> Pattern? {
    if cond == {
        .PatternTest{subject: s, pattern, ..} if pattern is .Struct{..} && pattern_subjects_match(cx, s, subject) -> Val(pattern.clone())
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/patterns.rs:73
pub fn struct_pattern_values_in_subset(pattern: &Pattern, cx: &Cx, locals: &HashSet<String>) -> Bool {
    if pattern == {
        .Struct{fields, ..} -> fields.iter().all(fn(f) {
            if f == { .Value{value, ..} -> expr_in_subset(value, cx, locals); .Bind{..} -> true }
        })
        else -> true
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/patterns.rs:90
pub fn arm_fallible_pattern(cx: &Cx, cond: &Expr, subject: &Expr) -> Pattern? {
    if cond == {
        .PatternTest{subject: s, pattern, ..} if pattern_subjects_match(cx, s, subject) -> {
            if pattern == { .Ok{..} | .Err{..} | .Present{..} | .Absent(_) -> Val(pattern.clone()); else -> None }
        }
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/patterns.rs:108
pub fn fallible_pattern_binding(pattern: &Pattern) -> String? {
    if pattern == { .Ok{binding, ..} | .Err{binding, ..} | .Present{binding, ..} -> Val(binding.clone()); else -> None }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/patterns.rs:120
pub fn arm_has_nested_pattern(cond: &Expr) -> Bool {
    if cond == { .PatternTest{pattern, ..} -> pattern.has_nested_pattern(); .Binary(.And, left, _, _) -> arm_has_nested_pattern(left); else -> false }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/patterns.rs:134
pub fn arm_variant_pattern(cx: &Cx, cond: &Expr, subject: &Expr) -> Pattern? {
    if cond == {
        .PatternTest{subject: s, pattern, ..} if pattern_subjects_match(cx, s, subject) -> {
            if pattern is .Range{..} -> return None
            if pattern_is_variant_or_orvariant(pattern) -> Val(pattern.clone()) else -> None
        }
        .Binary(.Eq, lhs, rhs, _) if pattern_subjects_match(cx, lhs, subject) -> {
            if rhs == .Ident(variant, rhs_span) {
                if cx.variant_owner.contains_key(variant) -> return Val(Pattern.Variant{variant: variant.clone(), bindings: [], leading_dot: false, span: rhs_span})
            }
            None
        }
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/patterns.rs:173
pub fn arm_guarded_variant_pattern(cx: &Cx, cond: &Expr, subject: &Expr) -> Pattern? {
    if cond != .Binary(.And, left, _, _) -> return None
    first := left
    while first == .Binary(.And, nested_left, _, _) { first = nested_left }
    arm_variant_pattern(cx, first, subject)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/patterns.rs:187
pub fn is_data_event_variant(variant: String) -> Bool {
    if variant == { "Null" | "Bool" | "Int" | "Float" | "Text" | "Bytes" | "ArrayStart" | "ArrayEnd" | "ObjectStart" | "Key" | "ObjectEnd" -> true; else -> false }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/patterns.rs:204
pub fn is_hook_outcome_variant(variant: String) -> Bool {
    if variant == { "Continue" | "Cancel" | "Fail" -> true; else -> false }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/patterns.rs:210
pub fn pattern_is_variant_or_orvariant(pattern: &Pattern) -> Bool {
    if pattern == {
        .Variant{bindings, ..} -> bindings.iter().all(fn(s) { if s == { .Bind{..} | .Wildcard | .Range{..} -> true; else -> false } })
        .Or(alts, _) -> !alts.is_empty() && alts.iter().all(fn(p) { pattern_is_variant_or_orvariant(p) })
        else -> false
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/patterns.rs:233
pub fn variant_pattern_uses_payload(pattern: &Pattern) -> Bool {
    if pattern == {
        .Variant{bindings, ..} -> bindings.iter().any(fn(slot) { !(slot is .Wildcard) })
        .Or(alts, _) -> alts.iter().any(fn(p) { variant_pattern_uses_payload(p) })
        else -> true
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/patterns.rs:244
pub fn variant_pattern_enum(cx: &Cx, pattern: &Pattern) -> String? {
    if pattern == {
        .Variant{variant, ..} -> cx.variant_owner.get(variant).cloned()
        .Or(alts, _) -> alts.iter().find_map(fn(a) { variant_pattern_enum(cx, a) })
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/patterns.rs:254
pub fn arm_head_range(cx: &Cx, cond: &Expr, subject: &Expr) -> (I64, I64)? {
    // RangeSwitch reads the subject per arm: only an ident is side-effect free.
    if !(subject is .Ident(..)) -> return None
    if cond == { .PatternTest{subject: s, pattern: .Range{lo, hi, ..}, ..} if pattern_subjects_match(cx, s, subject) -> Val((lo, hi)); else -> None }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/patterns.rs:276
pub fn pattern_subjects_match(cx: &Cx, a: &Expr, b: &Expr) -> Bool {
    if (a, b) == {
        (.Ident(na, _), .Ident(nb, _)) -> na == nb
        (.Ident(n, _), _) if n == Syntax.KW_IT -> true
        else -> {
            sa := cx.src.get(a.span().start..a.span().end)
            sb := cx.src.get(b.span().start..b.span().end)
            if (sa, sb) == { (Val(x), Val(y)) -> x == y; else -> false }
        }
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/patterns.rs:291
pub fn add_pattern_binding_names(pattern: &Pattern, locals: &HashSet<String>) {
    if pattern == {
        .Variant{..} -> locals.extend(pattern.binding_names().into_iter().map(fn(binding) { binding.local_name().to_owned() }))
        .Or(alts, _) -> { if alts.first() == Val(first) { add_pattern_binding_names(first, locals) } }
        else -> {}
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/patterns.rs:311
pub fn add_struct_pattern_binding_names(pattern: &Pattern, locals: &HashSet<String>) {
    if pattern == .Struct{fields, ..} {
        for field in fields { if field == .Bind{local, ..} { locals.insert(local.clone()) } }
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/patterns.rs:322
pub fn add_str_match_pattern_binding_names(pattern: &Pattern, locals: &HashSet<String>) {
    if pattern == .StrMatch{parts, ..} {
        for part in parts { if part == .Hole{name, ..} { locals.insert(name.clone()) } }
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/patterns.rs:333
pub fn add_bin_match_pattern_binding_names(pattern: &Pattern, locals: &HashSet<String>) {
    if pattern == .BinMatch{parts, ..} {
        for part in parts { if part == .Hole{name, ..} { locals.insert(name.clone()) } }
    }
}
