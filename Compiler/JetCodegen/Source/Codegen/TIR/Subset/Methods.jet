//RS 
//RS /// Method names a core/stdlib/builtin/special lowering intercepts *before* the
//RS /// user-method dispatch (`emit_method_call` → `emit_builtin_method` and the
//RS /// `.raw()`/`.snapshot()`/`mem.*.new` special cases).
//RS /// A user method sharing one of these names is emitted by that bespoke lowering on
//RS /// the AST path, not by `method_sigs`, so the TIR must NOT claim it — exclude.
//RS /// The list is intentionally a superset (every name those paths mention, guarded
//RS /// or not): an extra exclusion only keeps a function on the AST path (always safe).
//RS pub(crate) fn is_intercepted_method_name(method: &str) -> bool {
//RS     matches!(
//RS         method,
//RS         // Special-cased in `emit_method_call` / `emit_expr` (clone is the synthetic
//RS         // path, handled separately above; raw/snapshot/new have bespoke lowering).
//RS         "clone" | "raw" | "snapshot" | "new"
//RS         // String / list / map / collection builtins (`emit_builtin_method`).
//RS         | "parse" | "from_bytes" | "from_bytes_lossy" | "len" | "is_empty" | "push" | "append" | "pop" | "insert"
//RS         | "remove" | "get" | "post" | "put" | "delete" | "first" | "last"
//RS         | "contains" | "has" | "index_of" | "index" | "reverse" | "sort" | "sort_desc" | "join" | "detach"
//RS         | "receive" | "sender" | "send" | "clear" | "chars" | "bytes" | "encode" | "trim"
//RS         | "strip" | "lstrip" | "rstrip" | "expandtabs" | "startswith" | "endswith"
