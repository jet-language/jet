}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/methods.rs:1539
pub fn static_method_call_in_subset(type_name: String, method: String, args: [CallArg], cx: Cx, locals: Set<String>) -> Bool {
    if type_name == "UIShortcut" && method == "cmd" {
        return args.len() == 1 && args[0].label.is_none() && (args[0].expr.without_parens() == {
            Str(parts, _) -> parts.len() == 1 && (parts[0] == { Lit(value) -> { text := value.trim() // #4303
                !text.is_empty() }; _ -> false })
            _ -> false
        })
    }
    if locals.contains(type_name) { return false }
    is_string_distinct := cx.distinct_type_identity(type_name).and_then(fn(identity) { cx.distinct_types.get(identity) }).is_some_and(fn(entry) { entry.0 == Type.String })
    if is_string_distinct && (method == "from" || method == "encode_hole" || method == "raw") { return args.len() == 1 && args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) }) }
    if type_name == "FieldError" && method == "under" && args.len() == 2 { return args.iter().all(fn(arg) { expr_in_subset(arg.expr, cx, locals) }) }
    if method == "merge" && args.len() == 2 && cx.type_names.contains(type_name) && cx.struct_fields.contains_key(type_name) && !cx.sigs.contains_key("{type_name}::merge") { return args.iter().all(fn(arg) { arg.label.is_none() && expr_in_subset(arg.expr, cx, locals) }) }
    if (type_name, method, args.len()) == { ("Clock", "new", 1) | ("Clock", "system", 0) | ("Clock", "now", 0) | (Syntax.TYPE_AUTHORITY, "workspace", 0) | ("Date", "today", 0) | ("Path", "home", 0) -> true; _ -> false } { return true }
    if type_name == Syntax.TYPE_AUTHORITY && method == "from_rights" && args.len() == 1 { return args.iter().all(fn(arg) { expr_in_subset(arg.expr, cx, locals) }) }
    if (type_name, method, args.len()) == ("ExpiringValue", "new", 3) { return args.iter().all(fn(arg) { expr_in_subset(arg.expr, cx, locals) }) }
    if (type_name, method, args.len()) == ("ExpiringSecret", "new", 3) { return args.iter().all(fn(arg) { expr_in_subset(arg.expr, cx, locals) }) }
    if (type_name, method, args.len()) == { ("Int" | "Float", "parse", 1) -> true; _ -> false } { return expr_in_subset(args[0].expr, cx, locals) }
    if type_name == "Int" && method == "from_radix" && args.len() == 2 { return args.iter().all(fn(argument) { expr_in_subset(argument.expr, cx, locals) }) }
    if (type_name, method, args.len()) == { ("String", "from_bytes" | "from_bytes_lossy", 1) -> true; _ -> false } { return expr_in_subset(args[0].expr, cx, locals) }
    if numeric_type_from_name(type_name).is_some() && Syntax.numeric_conversion_source(method).is_some() && args.len() == 1 { return expr_in_subset(args[0].expr, cx, locals) }
    if cx.distinct_types.get(type_name) == Val((base, _)) {
        if base.is_numeric() && Syntax.numeric_conversion_source(method).is_some() && args.len() == 1 { return expr_in_subset(args[0].expr, cx, locals) }
        if !base.is_numeric() && Syntax.conversion_method_for_source(base.name()) == method && args.len() == 1 { return expr_in_subset(args[0].expr, cx, locals) }
    }
    if cx.unit_facts.contains_key(type_name) && method.starts_with("from_") {
        if args.len() == 1 { return expr_in_subset(args[0].expr, cx, locals) }
        if method.ends_with("_rounded") && args.len() == 3 {
            mode := args[1].expr == { EnumLit { variant, args: variant_args, .. } -> variant_args.is_empty() && Syntax.unit_rounding_mode(variant).is_some(); _ -> false }
            return args[0].label.is_none() && args[1].label.is_none() && args[2].label.map(fn(label) { label.0 }) == Val("digits") && mode && expr_in_subset(args[0].expr, cx, locals) && expr_in_subset(args[2].expr, cx, locals)
        }
    }
    if (type_name, method, args.len()) == {
        ("Secret", "from_text" | "from_bytes", 1) | ("SigningKey" | "X25519SecretKey", "new_random", 0)
        | ("SigningKey" | "X25519SecretKey" | "VerifyKey" | "X25519PublicKey" | "Signature" | "WrappedVaultKey", "from_bytes", 1)
        | ("KeyUnlock", "Recipient" | "Passphrase", 1) | ("X25519PublicKey", "from_text", 1) -> true
        _ -> false
    } { return args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) }) }
    if Sema.is_math_type(type_name) && !cx.type_names.contains(type_name) && Sema.math_static_return(type_name, method, args.len()).is_some() { return args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) }) }
    if type_name == "Perf" && !cx.type_names.contains("Perf") && core_call_covered("core.perf", method) { return args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) }) }
    if method == Generics.LITERAL_FROM_LITERAL && cx.trait_method_traits.get((type_name, method)).is_some_and(fn(trait_name) { Generics.is_literal_capability(trait_name) }) { return args.len() == 1 && args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) }) }
    if method != Syntax.MEM_ALLOC_NEW && is_intercepted_method_name(method) { return false }
    ty := Type.Named(type_name.to_string())
    if !is_covered_struct_ty(ty, cx) && !is_covered_enum_ty(ty, cx) { return false }
    if cx.enum_variants.get(type_name) == Val(variants) { if variants.iter().any(fn(entry) { entry.0 == method }) { return false } }
    sig := cx.method_sigs.get((type_name, method)) == { Val(value) -> value; None -> { return false } }
    if args.len() != sig.len() { return false }
    args.iter().zip(sig.iter()).all(fn(entry) { expr_in_subset(entry.0.expr, cx, locals) })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/methods.rs:1754
pub fn is_intercepted_method_name(method: String) -> Bool {
    method == {
        "clone" | "raw" | "snapshot" | "new"
        | "parse" | "from_bytes" | "from_bytes_lossy" | "len" | "is_empty" | "push" | "append" | "pop" | "insert"
        | "remove" | "get" | "post" | "put" | "delete" | "first" | "last"
        | "contains" | "has" | "index_of" | "index" | "reverse" | "sort" | "sort_desc" | "join" | "detach"
        | "receive" | "sender" | "send" | "clear" | "chars" | "bytes" | "encode" | "trim"
        | "strip" | "lstrip" | "rstrip" | "expandtabs" | "startswith" | "endswith"
        | "split" | "starts_with" | "ends_with" | "replace" | "to_upper"
        | "to_lower" | "to_ascii_upper" | "to_ascii_lower" | "repeat" | "slice" | "keys" | "values" | "items" | "has_key" | "add" | "add_new" | "setdefault" | "update"
        | "difference_update" | "intersection_update" | "symmetric_difference_update" | "merge"
        | "to_string" | "map" | "filter" | "each" | "find" | "any" | "all" | "count_where"
        | "sort_by" | "sort_by_desc" | "reduce" | "update_first"
        | "is_lower" | "is_upper" | "capitalize" | "swapcase" | "normalize"
        | "remove_prefix" | "remove_suffix" | "rsplit" | "equal" | "copy" | "rfind" | "rpartition"
        | "take" | "skip" | "step_by" | "dedup" | "chunks" | "windows"
        | "indexed" | "indexes" | "zip" | "zip_short" | "zip_pad"
        | "take_while" | "skip_while" | "flat_map" | "scan"
        | "position" | "min_by" | "max_by" | "fold" | "group_by" | "count_by" | "counts" | "partition"
        | "para_map" | "para_filter" | "para_partition" | "para_fold"
        | "cycle" | "drop_last" | "shuffle" | "is_sorted" | "is_sorted_by"
        | "dedup_by" | "average" | "chunk_while" | "last_index_of" | "compare" | "to_set"
        | "is_nan" | "is_infinite" | "is_finite" | "count_ones" | "count_zeros" | "leading_zeros" | "trailing_zeros"
        | "elapsed_millis" | "write_line" | "flush" | "read_line" | "lines"
        | "alloc" | "reset" | "accept" | "local_addr" | "read" | "write"
        | "peer_addr" | "close" | "method" | "path" | "body" | "header" | "param" | "status" | "group"
        | "union" | "to_list" | "collect" | "count" | "top_n"
        | "push_front" | "push_back" | "pop_front" | "pop_back" | "peek_front" | "peek_back" | "capacity"
        | "from" | "init" | "lift2" -> true
        _ -> false
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/methods.rs:1810
// All three conventions are lowered canonically; none is excluded.
pub fn arg_conv_in_subset(_a: CallArg) -> Bool { true }

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/methods.rs:1829
pub fn closure_method_in_subset(method: String, args: [CallArg], cx: Cx, locals: Set<String>) -> Bool {
    para_callback := fn(expr: Expr) { expr == { Lambda(lam) -> lambda_in_subset(lam, cx, locals); Ident(name, _) -> cx.fn_types.contains_key(name); _ -> false } }
    map_callback := fn(expr: Expr) { expr == { Lambda(lam) -> lambda_in_subset(lam, cx, locals); Ident(name, _) -> locals.contains(name) || cx.fn_types.contains_key(name); _ -> false } }
    if !Collections.is_closure_method(method) { return false }
    if args.iter().enumerate().any(fn(entry) {
        (index, arg) := entry
        arg.label.is_some() && !(method == "para_map" && index == 1 && arg.label.map(fn(label) { label.0 }) == Val("limit"))
    }) { return false }
    method == {
        "edit_disjoint" -> args.len() == 2 && expr_in_subset(args[0].expr, cx, locals) && (args[1].expr == { Lambda(lam) -> lambda_in_subset(lam, cx, locals); _ -> false })
        "reduce" | "scan" | "fold" -> args.len() == 2 && expr_in_subset(args[0].expr, cx, locals) && (args[1].expr == { Lambda(lam) -> lambda_in_subset(lam, cx, locals); _ -> false })
        "para_fold" -> args.len() == 3 && args.iter().all(fn(arg) { para_callback(arg.expr) })
        "para_map" | "para_filter" | "para_partition" -> args.first().is_some_and(fn(arg) { para_callback(arg.expr) }) && (if method == "para_map" && args.len() == 2 { expr_in_subset(args[1].expr, cx, locals) } else { args.len() == 1 })
        "map" -> args.len() == 1 && map_callback(args[0].expr)
        "update_first" -> args.len() == 2 && (args[0].expr == { Lambda(lam) -> lambda_in_subset(lam, cx, locals); _ -> false }) && expr_in_subset(args[1].expr, cx, locals)
        _ -> args.len() == 1 && (args[0].expr == { Lambda(lam) -> lambda_in_subset(lam, cx, locals); _ -> false })
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/methods.rs:1896
fn is_builtin_collection_recv(recv_type: String?) -> Bool {
    recv_type == {
        None | Val("String" | "Option" | "SQL") -> true
        Val(name) -> {
            leaf := name.rsplit('.').next().unwrap_or(name)
            (leaf == { Syntax.TYPE_BYTES | Syntax.TYPE_LIST | "Equatable" | "FixedList" | "Set" | "Map" -> true; _ -> false }) || leaf.starts_with('[')
        }
    }
}
