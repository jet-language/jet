// Rust: crates/jet-codegen/src/Codegen/TIR/subset/methods.rs:1430
pub fn core_module_path_from_receiver(receiver: Expr, cx: Cx, locals: Set<String>) -> String? {
    receiver == {
        Ident(alias, _) -> if !locals.contains(alias) { cx.any_core_import_module(alias).map(fn(module) { module.to_string() }) } else { None }
        Field(base, leaf, _) -> {
            module := core_module_path_from_receiver(base, cx, locals)?
            submodule := "{module}.{leaf}"
            if Syntax.is_known_core_module(submodule) { Val(^submodule) } else { None }
        }
        _ -> None
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/methods.rs:1453
pub fn fn_field_call_ty(method: String, recv_type: String?, cx: Cx) -> Type? {
    ty_name := recv_type?
    if !is_covered_struct_ty(Type.Named(ty_name.to_string()), cx) { return None }
    fields := cx.struct_fields.get(ty_name)?
    (_, fty) := fields.iter().find(fn(entry) { entry.0 == method })?
    if fty == { Fn { .. } -> true; _ -> false } { Val(fty) } else { None }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/methods.rs:1471
pub fn fn_field_call_in_subset(receiver: Expr, method: String, args: [CallArg], recv_type: String?, cx: Cx, locals: Set<String>) -> Bool {
    if fn_field_call_ty(method, recv_type, cx).is_none() { return false }
    expr_in_subset(receiver, cx, locals) && args.iter().all(fn(a) { a.label.is_none() && !a.flags.shared_auto_clone && expr_in_subset(a.expr, cx, locals) })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/methods.rs:1504
pub fn static_call_type_name_unchecked(receiver: Expr) -> String? {
    receiver == {
        Ident(name, _) -> Val(name.to_string())
        Field(base, leaf, _) -> {
            if base == { Ident(prefix, _) -> {
                if prefix.chars().next().is_some_and(fn(c) { c.is_ascii_uppercase() }) { return Val("{prefix}.{leaf}") }
            }; _ -> {} }
