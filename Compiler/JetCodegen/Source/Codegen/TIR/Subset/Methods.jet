use JetSema.AST.[Expr, Type, CallArg, StrPart, numeric_type_from_name]
use JetSema.[Syntax, Generics, Collections, Sema]
use JetCodegen.Codegen.[Cx, foreign_binding_method_key, is_db_value_type_name, is_db_value_variant, is_json_type_name, is_json_variant, is_key_variant]
use JetCodegen.Codegen.TIR.*
use JetCodegen.Codegen.TIR.Subset.CoreCalls.core_call_args_in_subset
use core.collections.Set

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/methods.rs:54
pub fn method_call_in_subset(receiver: Expr, method: String, args: [CallArg], recv_type: String?, resolved_ret: Type?, cx: Cx, locals: Set<String>) -> Bool {
    if recv_type == Val(Syntax.INTERNAL_CALL_VALUE) {
        return expr_in_subset(receiver, cx, locals) && args.iter().all(fn(arg) { expr_in_subset(arg.expr, cx, locals) })
    }
    if (method == "equal" || method == "compare") && args.len() == 1 {
        return expr_in_subset(receiver, cx, locals) && expr_in_subset(args[0].expr, cx, locals)
    }
    if web_receiver_projection(recv_type, method, args.len()).is_some() {
        return expr_in_subset(receiver, cx, locals) && args.iter().all(fn(arg) { expr_in_subset(arg.expr, cx, locals) })
    }
    if recv_type == Val(Syntax.INTERNAL_VALIDATE_OVER) && method == "over" && args.is_empty() {
        return expr_in_subset(receiver, cx, locals)
    }
    if recv_type == Val(Syntax.TYPE_AUTHORITY) && (method == "with" || method == "without") && args.len() == 1 {
        return expr_in_subset(receiver, cx, locals) && expr_in_subset(args[0].expr, cx, locals)
    }
    if method == Syntax.METHOD_MEMO_CACHE && args.is_empty() && resolved_ret.is_some_and(fn(ty) {
        ty == { Named(name) -> name == Syntax.TYPE_MEMO_STATS; _ -> false }
    }) {
        return receiver == { Ident(_, _) -> true; _ -> false }
    }
    if recv_type.is_some_and(fn(name) {
        name == Syntax.INTERNAL_ROOT_CALL_LOCAL || name.starts_with(Syntax.INTERNAL_ROOT_CALL_IMPORT_PREFIX) || name.starts_with(Syntax.INTERNAL_ROOT_CALL_CORE_PREFIX)
    }) {
        return expr_in_subset(receiver, cx, locals) && args.iter().all(fn(arg) { expr_in_subset(arg.expr, cx, locals) })
    }
    if recv_type.is_some_and(fn(name) {
        cx.current_type_params.borrow().contains(name) || cx.trait_names.contains(name) || Generics.is_builtin_trait(name) || name == Generics.IO_READER || name == Generics.IO_WRITER
    }) && method == {
        "read" | "write" | "write_all" | "add" | "sub" | "mul" | "div" | "equal" | "compare" | "query" | "query_one" | "execute" | "begin" | "commit" | "rollback" -> true
        _ -> false
    } {
        return args.iter().all(fn(arg) { expr_in_subset(arg.expr, cx, locals) }) && expr_in_subset(receiver, cx, locals)
    }
    if (recv_type == { Val("Query" | "DataGroupedQuery" | "DataTracked" | "DataWatch") -> true; _ -> false }) ||
        (recv_type.is_none() && method == "query" && args.len() == 1 && receiver == {
            Ident(alias, _) -> locals.contains(alias) || cx.any_core_import_module(alias).is_none()
            _ -> true
        }) {
        method_ok := recv_type == {
            Val("Query") -> method == { "filter" | "sort_by" | "map" | "min" | "max" | "inner_join" | "left_join" | "collect" | "plan" | "group_by" | "watch" -> true; _ -> false }
            Val("DataGroupedQuery") -> method == { "count" | "sum" | "mean" -> true; _ -> false }
            Val("DataTracked") -> method == { "query" | "insert" | "replace" | "remove" -> true; _ -> false }
            Val("DataWatch") -> method == { "get" | "status" | "cancel" -> true; _ -> false }
            None -> true
            _ -> false
        }
        if method_ok { return expr_in_subset(receiver, cx, locals) && args.iter().all(fn(arg) { expr_in_subset(arg.expr, cx, locals) }) }
    }
    if method == "clone" { return args.is_empty() && expr_in_subset(receiver, cx, locals) }
    inline_range_head := receiver == {
        Call(call) -> call.name == Syntax.TYPE_INT && call.args.len() == 1 && call.resolved_ret == {
            Val(InlineRange { .. }) -> true
            Val(Result { ok, .. }) -> ok == { InlineRange { .. } -> true; _ -> false }
            _ -> false
        }
        _ -> false
    }
    if method == Syntax.conversion_method_for_source("Int") && args.len() == 1 && inline_range_head {
        return expr_in_subset(args[0].expr, cx, locals)
    }
    if method == Syntax.BUILTIN_SNAPSHOT {
        if receiver == { Call(call) -> {
            if call.name == Syntax.BUILTIN_EXPECT && !cx.sigs.contains_key(call.name) && !locals.contains(call.name) && call.args.len() == 1 && args.is_empty() {
                return expr_in_subset(call.args[0].expr, cx, locals)
            }
        }; _ -> {} }
    }
    if receiver == { Ident(alias, _) -> {
        if !locals.contains(alias) && (cx.reexport_calls.contains_key((alias, method)) || cx.import_mods.contains_key(alias) || cx.code_modules.contains(alias)) {
            return args.iter().all(fn(a) { !a.flags.shared_auto_clone && arg_conv_in_subset(a) && expr_in_subset(a.expr, cx, locals) })
        }
    }; _ -> {} }
    if method == "raw" {
        if receiver == { Ident(n, _) -> {
            if n == "SQL" || n == "HTML" || n == Syntax.TYPE_SH { return args.len() == 1 && expr_in_subset(args[0].expr, cx, locals) }
        }; _ -> {} }
        if args.len() == 1 {
            if static_call_type_name(receiver, locals) == Val(type_name) {
                if cx.distinct_type_identity(type_name).and_then(fn(identity) { cx.distinct_types.get(identity) }).is_some_and(fn(entry) { entry.0 == Type.String }) {
                    return expr_in_subset(args[0].expr, cx, locals)
                }
            }
        }
    }
    if recv_type == Val("__Carrier__") { return args.is_empty() && expr_in_subset(receiver, cx, locals) }
    if (method == "then" || method == "reverse") && (recv_type == Val(Syntax.TYPE_ORDERING) || (recv_type.is_none() && !(receiver == { Ident(_, _) -> true; _ -> false }))) {
        return ((method == "then" && args.len() == 1) || (method == "reverse" && args.is_empty())) && expr_in_subset(receiver, cx, locals) && args.iter().all(fn(arg) { expr_in_subset(arg.expr, cx, locals) })
    }
    if method == Syntax.METHOD_DISTINCT_RAW { return args.is_empty() && expr_in_subset(receiver, cx, locals) }
    if recv_type == Val("SQL") && (method == "template" || method == "params") { return args.is_empty() && expr_in_subset(receiver, cx, locals) }
    if recv_type == Val("HTML") && method == "text" { return args.is_empty() && expr_in_subset(receiver, cx, locals) }
    if method == Syntax.TXN_ON_COMMIT && recv_type == Val(Syntax.TXN_HANDLE_TYPE) {
        return args.len() == 1 && args[0].label.is_none() && (args[0].expr == { Lambda(_) -> true; _ -> false }) && expr_in_subset(args[0].expr, cx, locals)
    }
    if method == Syntax.TXN_ON_ROLLBACK && recv_type == Val(Syntax.TXN_HANDLE_TYPE) {
        return args.len() == 1 && args[0].label.is_none() && (args[0].expr == { Lambda(_) -> true; _ -> false }) && expr_in_subset(args[0].expr, cx, locals)
    }
    if recv_type == Val(Syntax.INTERNAL_TASK_SURFACE_TYPE) && method == Syntax.INTERNAL_TASK_SPAWN_METHOD {
        return args.len() == 1 && args[0].label.is_none() && (args[0].expr == { Lambda(_) -> true; _ -> false }) && expr_in_subset(args[0].expr, cx, locals)
    }
    if recv_type == Val(Syntax.INTERNAL_TASK_SURFACE_TYPE) && method == Syntax.INTERNAL_TASK_TIMEOUT_METHOD {
        return args.len() == 1 && args[0].label.is_none() && expr_in_subset(args[0].expr, cx, locals)
    }
    if recv_type == Val(Syntax.INTERNAL_TASK_SURFACE_TYPE) && (method == Syntax.INTERNAL_TASK_ALL_METHOD || method == Syntax.INTERNAL_TASK_RACE_METHOD || method == Syntax.INTERNAL_TASK_ANY_METHOD) {
        return args.len() == 1 && expr_in_subset(args[0].expr, cx, locals)
    }
    task_group_receiver := recv_type == Val(Syntax.TYPE_TASKGROUP) || recv_type == Val(Syntax.INTERNAL_TASK_GROUP_SURFACE_TYPE)
    if task_group_receiver && method == Syntax.INTERNAL_TASK_SPAWN_METHOD {
        return args.len() == 1 && args[0].label.is_none() && (args[0].expr == { Lambda(_) -> true; _ -> false }) && expr_in_subset(args[0].expr, cx, locals)
    }
    if task_group_receiver && method == Syntax.INTERNAL_TASK_ALL_METHOD { return args.len() == 1 && expr_in_subset(args[0].expr, cx, locals) }
    if task_group_receiver && (method == Syntax.INTERNAL_TASK_RACE_METHOD || method == Syntax.INTERNAL_TASK_ANY_METHOD) { return args.len() == 1 && expr_in_subset(args[0].expr, cx, locals) }
    // The receipt destination is ambient; only its payload crosses TIR.
    if recv_type == Val(Syntax.INTERNAL_RECEIPT_HANDLE) && method == Syntax.METHOD_RECEIPT_ATTACH { return args.len() == 1 && expr_in_subset(args[0].expr, cx, locals) }
    if recv_type == Val("Shared") {
        if method == "capture" {
            return args == {
                [] -> true
                [arg] -> arg.expr == { Lambda(lam) -> lambda_in_subset(lam, cx, locals); _ -> false }
                _ -> false
            }
        }
        if method == "try_replace" { return args.len() == 2 && args.iter().all(fn(arg) { expr_in_subset(arg.expr, cx, locals) }) }
    }
    if recv_type == Val("Pool") && (method == "add" || method == "remove" || method == "ids") {
        return method == {
            "add" -> args.len() == 1 && expr_in_subset(args[0].expr, cx, locals)
            "remove" -> args.len() == 1 && expr_in_subset(args[0].expr, cx, locals)
            "ids" -> args.is_empty()
            _ -> panic("matches! above admitted only these")
        }
    }
    if recv_type == Val("Shared") {
        return method == {
            "read" | "edit" | "read_txn" -> args.len() == 1 && (args[0].expr == { Lambda(lam) -> lambda_in_subset(lam, cx, locals); _ -> false })
            "guard_read" | "guard_edit" | "downgrade" | "strong_count" -> args.is_empty()
            "same" -> args.len() == 1 && expr_in_subset(args[0].expr, cx, locals)
            _ -> false
        }
    }
    if recv_type == Val(Syntax.TYPE_SHARED_WEAK) { return method == "upgrade" && args.is_empty() }
    if recv_type == Val(Syntax.TYPE_SHARED_GUARD) {
        return method == {
            "map" -> args.len() == 1 && (args[0].expr == { Lambda(lam) -> lam.meta.guard_projection.is_some() && lambda_in_subset(lam, cx, locals); _ -> false })
            "split" -> args.len() == 2 && args.iter().all(fn(arg) { arg.expr == { Lambda(lam) -> lam.meta.guard_projection.is_some() && lambda_in_subset(lam, cx, locals); _ -> false } })
            "wait" -> args.len() == 2 && expr_in_subset(args[0].expr, cx, locals) && (args[1].expr == { Lambda(lam) -> lambda_in_subset(lam, cx, locals); _ -> false })
            _ -> false
        }
    }
    if recv_type == Val(Syntax.TYPE_CONDITION) { return (method == "notify_one" || method == "notify_all") && args.is_empty() }
    if recv_type.is_some_and(fn(handle) { service_method_route(handle, method).is_some() }) {
        return expr_in_subset(receiver, cx, locals) && args.iter().all(fn(arg) { expr_in_subset(arg.expr, cx, locals) })
    }
    if recv_type == { Val("Cell" | "CellReadGuard" | "CellEditGuard") -> true; _ -> false } {
        plain := (recv_type, method, args.len()) == {
            (Val("Cell"), "get" | "guard_read" | "guard_edit", 0) | (Val("Cell"), "set" | "replace", 1) | (Val("CellReadGuard" | "CellEditGuard"), "get", 0) | (Val("CellEditGuard"), "set", 1) -> true
            _ -> false
        }
        if plain { return expr_in_subset(receiver, cx, locals) && args.iter().all(fn(arg) { expr_in_subset(arg.expr, cx, locals) }) }
        closure := (recv_type, method) == {
            (Val("Cell"), "get_or_set" | "read" | "edit") | (Val("CellReadGuard"), "read" | "map" | "split") | (Val("CellEditGuard"), "read" | "edit" | "map" | "split") -> true
            _ -> false
        }
        if closure {
            return expr_in_subset(receiver, cx, locals) && !args.is_empty() && args.iter().all(fn(arg) { arg.label.is_none() && (arg.expr == { Lambda(lambda) -> lambda_in_subset(lambda, cx, locals); _ -> false }) })
        }
        return false
    }
    if recv_type == Val("ExpiringSecret") {
        if method == "new" && args.len() == 3 && (receiver == { Ident(name, _) -> name == "ExpiringSecret"; _ -> false }) {
            return args.iter().all(fn(arg) { expr_in_subset(arg.expr, cx, locals) })
        }
        return method == "with" && args.len() == 1 && (args[0].expr == { Lambda(lam) -> lambda_in_subset(lam, cx, locals); _ -> false })
    }
    // Function-valued fields win before instance/static method dispatch.
    if fn_field_call_in_subset(receiver, method, args, recv_type, cx, locals) { return true }
    if receiver == { Ident(type_name, _) -> {
        if !locals.contains(type_name) && is_json_type_name(type_name) && is_json_variant(method) { return args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) }) }
    }; _ -> {} }
    if receiver == { Ident(type_name, _) -> {
        if !locals.contains(type_name) && is_db_value_type_name(type_name) && is_db_value_variant(method) { return args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) }) }
    }; _ -> {} }
    if recv_type.is_none() {
        if receiver == { Ident(type_name, _) -> {
            if !locals.contains(type_name) {
                if type_name == Syntax.TYPE_KEY { return is_key_variant(method) && args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) }) }
                if type_name == "DataEvent" { return (method == { "Bool" | "Int" | "Float" | "Text" | "Bytes" | "Key" -> true; _ -> false }) && args.len() == 1 && args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) }) }
            }
        }; _ -> {} }
    }
    if recv_type.is_none() {
        if receiver == { Field(_, _, _) -> true; _ -> false } {
            if core_module_path_from_receiver(receiver, cx, locals) == Val(submodule) {
                return core_call_covered(submodule, method) && core_call_args_in_subset(submodule, method, args, cx, locals)
            }
            if receiver == { Field(base, leaf, _) -> {
                if base == { Ident(owner, _) -> {
                    if cx.inline_reexport_foreign.contains_key((owner, leaf)) {
                        return args.iter().all(fn(a) { !a.flags.shared_auto_clone && arg_conv_in_subset(a) && expr_in_subset(a.expr, cx, locals) })
                    }
                }; _ -> {} }
            }; _ -> {} }
        }
        if receiver == { Ident(alias, _) -> {
            if !locals.contains(alias) {
                if cx.any_core_import_module(alias) == Val(module) {
                    if core_closure_call_in_subset(module, method, args, cx, locals) { return true }
                    return core_call_covered(module, method) && core_call_args_in_subset(module, method, args, cx, locals)
                }
                if cx.inline_reexport_core.get((alias, method)) == Val((module, real_method)) {
                    return core_call_covered(module, real_method) && core_call_args_in_subset(module, real_method, args, cx, locals)
                }
                if cx.any_foreign_import_module(alias).is_some() {
                    return args.iter().all(fn(a) { !a.flags.shared_auto_clone && arg_conv_in_subset(a) && expr_in_subset(a.expr, cx, locals) })
                }
                is_module_alias := cx.reexport_calls.contains_key((alias, method)) || cx.import_mods.contains_key(alias) || cx.code_modules.contains(alias)
                if is_module_alias { return args.iter().all(fn(a) { !a.flags.shared_auto_clone && arg_conv_in_subset(a) && expr_in_subset(a.expr, cx, locals) }) }
            }
        }; _ -> {} }
    }
    if allocator_constructor_owner(recv_type, method) == Val(alloc_type) {
        return_ok := resolved_ret == { Val(Named(name)) -> name == alloc_type; _ -> false }
        arity_ok := if alloc_type == "Fixed" { args.len() == 1 } else { args.len() <= 1 }
        return return_ok && arity_ok && args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) })
    }
    if solve_new_type(receiver, method, cx, locals).is_some() { return args.len() == 1 && args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) }) }
    if duration_new_unit(receiver, method, locals).is_some() { return args.len() == 1 && args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) }) }
    if game_static_type(receiver, method, cx, locals) == Val(static_type) {
        want := (static_type, method) == { ("Backend", "headless") -> 0; _ -> 1 }
        return args.len() == want && args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) })
    }
    if tls_static_op(receiver, method, cx, locals) == Val(op) {
        want := op == { TLSClientConfigDefault -> 0; TLSRootCertificatesFromPem -> 1; TLSClientIdentityFromPem -> 2; _ -> { return false } }
        return args.len() == want && args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) })
    }
    if http_client_static_op(receiver, method, cx, locals).is_some() { return args.is_empty() }
    if is_builtin_collection_recv(recv_type) && is_covered_builtin_name(method, args.len()) {
        labels_ok := if method == "zip" || method == "zip_short" || method == "zip_pad" { true }
            else if method == "merge" && args.len() == 2 { args[0].label.is_none() && (args[1].label.map(fn(label) { label.0 }) == { None | Val("conflict") -> true; _ -> false }) }
            else { args.iter().all(fn(a) { a.label.is_none() }) }
        return expr_in_subset(receiver, cx, locals) && labels_ok && args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) })
    }
    if recv_type == Val("Atomic") && is_covered_builtin_name(method, args.len()) { return expr_in_subset(receiver, cx, locals) && args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) }) }
    if (recv_type == Val("Set") || recv_type == Val(Syntax.TYPE_RANK)) && is_covered_builtin_name(method, args.len()) { return expr_in_subset(receiver, cx, locals) && args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) }) }
    if recv_type.is_none() {
        if receiver == { Ident(type_name, _) -> {
            if !locals.contains(type_name) {
                if (type_name, method, args.len()) == {
                    ("Set", "from", 1) | ("Set", "new", 0) | ("Map", "new", 0) | ("Map", "from_keys", 2) | ("Map", "fromkeys", 2)
                    | (Syntax.TYPE_RANK, "from", 1) | ("PriorityQueue", "from", 1) | (Syntax.TYPE_BYTES, "from", 1)
                    | (Syntax.TYPE_TALLY, "new", 0) | (Syntax.TYPE_QUEUE, "new", 0) | (Syntax.TYPE_QUEUE, "init", 1)
                    | (Syntax.TYPE_RANK, "new", 0) | ("PriorityQueue", "new", 0) | ("Cache", "new", 1)
                    | (Syntax.TYPE_BITS, "new", 0) | (Syntax.TYPE_BYTES, "new", 0) | (Syntax.TYPE_BYTES, "with_capacity", 1)
                    | (Syntax.TYPE_LIST, "try_new", 0) | (Syntax.TYPE_LIST, "try_with_capacity", 1) -> true
                    _ -> false
                } { return args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) }) }
                if (type_name, method, args.len()) == ("Pool", "new", 0) { return true }
                if (type_name, method, args.len()) == ("Shared", "new", 1) { return args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) }) }
                if (type_name, method, args.len()) == ("Condition", "new", 0) { return true }
                if (type_name, method, args.len()) == ("Cell", "new", 1) { return args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) }) }
                if (type_name, method, args.len()) == ("ExpiringSecret", "new", 3) { return args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) }) }
                if (type_name, method, args.len()) == ("ExpiringValue", "new", 3) { return args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) }) }
                if (type_name, method, args.len()) == ("Path", "from", 1) && !cx.type_names.contains("Path") { return args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) }) }
                if (type_name, method, args.len()) == ("Reader", "over", 1) && !cx.type_names.contains("Reader") { return args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) }) }
                if (type_name, method, args.len()) == ("Cursor", "over", 1) && !cx.type_names.contains("Cursor") { return args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) }) }
                if (type_name, method, args.len()) == {
                    ("HTTPMethod", "custom", 1) | ("HTTPMethod", "get" | "head" | "post" | "put" | "delete" | "connect" | "options" | "trace" | "patch", 0)
                    | ("HTTPStatus", "new", 1) | ("HTTPVersion", "http_1_0" | "http_1_1" | "http_2", 0)
                    | ("HTTPHeaderName" | "HTTPHeaderValue", "new", 1) | ("Headers", "new", 0) | ("Body", "empty", 0)
                    | ("Body", "bytes" | "json" | "form" | "multipart", 1) | ("Body", "text" | "reader", 1 | 2) -> true
                    _ -> false
                } { return args.iter().all(fn(argument) { expr_in_subset(argument.expr, cx, locals) }) }
                if (type_name, method, args.len()) == ("Option", "lift2", 3) && !cx.type_names.contains("Option") { return args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) }) }
            }
        }; _ -> {} }
    }
    if recv_type.is_none() && is_concurrency_method_name(method, args.len()) { return expr_in_subset(receiver, cx, locals) && args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) }) }
    if recv_type == Val("Match") && method == "group" && args.len() == 1 { return expr_in_subset(receiver, cx, locals) && args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) }) }
    if (recv_type == { Val("Signal" | "Derived" | "Computed") -> true; _ -> false }) && is_reactive_method_name(method, args.len()) { return expr_in_subset(receiver, cx, locals) && args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) }) }
    if recv_type == Val(Syntax.TYPE_EFFECT) && is_reactive_effect_method_name(method, args.len()) { return expr_in_subset(receiver, cx, locals) }
    if is_event_handle_type(recv_type) && is_event_method_name(method, args.len()) {
        handler_ok := (method, args.len()) == {
            ("on" | "once", 2) -> args.get(1).is_some_and(fn(a) { a.label.is_none() && (a.expr == { Lambda(_) -> true; _ -> false }) })
            ("on_priority", 3) -> args.get(1).is_some_and(fn(a) { expr_in_subset(a.expr, cx, locals) }) && args.get(2).is_some_and(fn(a) { a.label.is_none() && (a.expr == { Lambda(_) -> true; _ -> false }) })
            _ -> true
        }
        return expr_in_subset(receiver, cx, locals) && handler_ok && args.iter().enumerate().all(fn(entry) {
            (i, a) := entry
            a.label.is_none() && ((method, args.len(), i) == { ("on" | "once", 2, 1) | ("on_priority", 3, 2) -> true; _ -> expr_in_subset(a.expr, cx, locals) })
