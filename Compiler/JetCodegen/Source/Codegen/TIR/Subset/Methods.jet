        }
        _ -> None
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/methods.rs:1523
pub fn static_call_type_name(receiver: Expr, locals: Set<String>) -> String? {
    name := static_call_type_name_unchecked(receiver)?
    receiver == {
