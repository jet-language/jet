//RS         return false;
//RS     }
//RS     let recv_type_leaf = recv_type.as_deref().map(|name| {
//RS         name.rsplit("::")
//RS             .next()
//RS             .unwrap_or(name)
//RS             .rsplit('.')
//RS             .next()
//RS             .unwrap_or(name)
//RS     });
//RS     // D-CRYPTO-SUBSET1: Core crypto constructors are Jet-declared static
//RS     // methods; a checked path may still carry the nominal receiver marker.
//RS     // Reuse the existing constructor admission table for that shape.
//RS     if let Some(type_name) = recv_type_leaf {
//RS         if matches!(
//RS             type_name,
//RS             "Secret"
//RS                 | "SigningKey"
//RS                 | "X25519SecretKey"
//RS                 | "VerifyKey"
//RS                 | "X25519PublicKey"
//RS                 | "Signature"
//RS                 | "WrappedVaultKey"
//RS                 | "KeyUnlock"
//RS         ) && matches!(receiver, Expr::Ident(name, _) if name == type_name && !locals.contains(name))
//RS         {
//RS             return static_method_call_in_subset(type_name, method, args, cx, locals);
//RS         }
//RS     }
//RS     if matches!(
//RS         (recv_type_leaf, method, args.len()),
//RS         (Some("SigningKey" | "X25519SecretKey"), "public_key", 0)
//RS             | (Some("WrappedVaultKey"), "bytes", 0)
//RS             | (Some("Digest256" | "Digest512"), "hex" | "as_bytes", 0)
//RS             | (Some("X25519PublicKey"), "text", 0)
//RS     ) {
//RS         return expr_in_subset(receiver, cx, locals);
//RS     }
//RS     // Shape (n) [c109 Phase 30]: DYNAMIC dispatch on a TRAIT-OBJECT receiver
//RS     // (`s.name()`/`s.area()` where `s: Shape` is a `Box<dyn __jet_Shape>`). Sema sets
//RS     // `recv_type == Some(<trait>)` with the trait in `cx.trait_names`; the AST
//RS     // `emit_method_call` (Expression.rs ~L1657) keys on `cx.trait_names.contains(rt)` and
//RS     // emits `({recv}).{method}({args})` — the BARE method name (vtable dispatch), args
//RS     // lowered PLAINLY (`emit_call_args(.., None, ..)`). Disjoint from the user-instance
//RS     // shape below (a trait name is never a covered struct/enum) and from the
//RS     // numeric/handle/builtin shapes (a trait name isn't any of those). Covered when the
//RS     // receiver is in-subset and every arg is in-subset + unlabeled.
//RS     if let Some(ty) = recv_type {
//RS         if cx.trait_names.contains(ty) {
//RS             return expr_in_subset(receiver, cx, locals)
//RS                 && args.iter().all(|a| expr_in_subset(&a.expr, cx, locals));
//RS         }
//RS     }
//RS     // Shape (b): a user-defined instance method. The `recv_type` is the TOTAL sema
//RS     // fact; a `None` was handled above (static). Anything else (a fallback-inferred
//RS     // path) the subset must NOT reproduce — but `recv_type == Some` is the total
//RS     // instance-method signal.
//RS     let Some(ty) = recv_type else {
//RS         return false;
//RS     };
//RS     // The method must be a user-defined method on that type (in `method_sigs`). A real
//RS     // `method_sigs` entry is the TOTAL "this is a user method on `ty`" signal: the AST
//RS     // `emit_method_call` now dispatches to the user method (`__jet_<method>`) BEFORE
//RS     // `emit_builtin_method` whenever `recv_type == Some(T)` and `(T, method) ∈ method_sigs`
//RS     // (the builtin-name-collision fix), so a user method SHADOWING a builtin name
//RS     // (`get`/`len`/…) routes here, not through the name-keyed builtin path.
//RS     let metadata_ty = cx.method_metadata_name(ty, method);
//RS     let binding_method = cx
//RS         .extern_funcs
//RS         .contains_key(&foreign_binding_method_key(ty, method));
//RS     let sig = cx.method_sigs.get(&(metadata_ty, method.to_string()));
//RS     let distinct_numeric_operator = cx
//RS         .distinct_types
//RS         .get(ty)
//RS         .is_some_and(|(_, numeric)| *numeric)
//RS         && !cx.distinct_ranges.contains_key(ty)
//RS         && matches!(method, "add" | "sub" | "mul" | "div")
//RS         && args.len() == 1;
//RS     let distinct_trait_method = cx.distinct_types.contains_key(ty)
//RS         && (cx.trait_methods.contains(&(ty.clone(), method.to_string()))
//RS             || distinct_numeric_operator);
//RS     if sig.is_none() && !binding_method && !distinct_trait_method {
//RS         // No user method: a name a core/stdlib/builtin/special lowering would intercept
//RS         // *before* the user dispatch (`emit_builtin_method`, the `.raw()`/`.snapshot()`/
//RS         // alloc special cases) has bespoke name-keyed lowering — exclude it (those are
//RS         // covered by their own shapes, not the user-method TIR).
//RS         return false;
//RS     }
//RS     // A builtin-name method with NO `method_sigs` entry was already excluded above. With a
//RS     // real user method present, the intercepted-name check (`is_intercepted_method_name`,
//RS     // still used by the static-call shape) no longer applies — the AST path dispatches to
//RS     // the user method. The `clone`/`raw` special forms returned earlier in this function;
//RS     // `snapshot`/`new` fire their AST special cases only for non-instance receivers (an
//RS     // `expect(...)` call / a type-name ident), so an INSTANCE method of that name with a
//RS     // `method_sigs` entry reaches here and routes to the user method on BOTH paths.
//RS     // The receiver type must be a covered struct or enum (so the receiver place
//RS     // emits exactly as the AST path does, and the method is a plain user method).
//RS     let recv_ty = Type::Named(ty.clone());
//RS     // D-OPMIX1: `impl Int.Mul(Price)` is a user method on a builtin. Admit it
//RS     // when method_sigs has the hook, so mixed arithmetic stays in TIR.
//RS     let operator_hook =
//RS         sig.is_some() && matches!(method, "add" | "sub" | "mul" | "div") && args.len() == 1;
//RS     if !is_covered_struct_ty(&recv_ty, cx)
//RS         && !is_covered_enum_ty(&recv_ty, cx)
//RS         && !is_covered_foreign_value_ty(&recv_ty, cx)
//RS         && !distinct_trait_method
//RS         && !operator_hook
//RS     {
//RS         return false;
//RS     }
//RS     // The receiver expression must itself be in-subset (a covered local/param/field).
//RS     if !expr_in_subset(receiver, cx, locals) {
//RS         return false;
//RS     }
//RS     // Arity must match the resolved signature (sema guaranteed it, but be defensive).
//RS     if sig.is_some_and(|sig| args.len() != sig.len()) {
//RS         return false;
//RS     }
//RS     // Every argument must be in-subset. Unlike a plain call, a method arg MAY use any
//RS     // of `Read`/`Move`/`Mutate` with implicit/Arc clone — those are carried as total
//RS     // flags and emitted verbatim (mirroring `emit_call_args`). c109 Phase 13: a Fn-typed
//RS     // param routes through the `Box::new(…) as <fn-type>` coercion (`lower_one_call_arg`).
//RS     // D-APILABEL1=A: sema binds labels by name and rewrites arguments into
//RS     // declaration order. Lowering reads `source_index` to preserve the order
//RS     // in which the caller wrote their expressions.
//RS     args.iter().all(|a| expr_in_subset(&a.expr, cx, locals))
//RS }
