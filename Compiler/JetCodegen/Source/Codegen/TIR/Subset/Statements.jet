use JetSema.AST.*
use JetSema.Syntax
use JetCodegen.Codegen.Cx
use JetCodegen.Codegen.[is_json_variant, is_key_variant]
use JetCodegen.Codegen.TIR.*
use JetCodegen.Codegen.TIR.Subset.Refusal as refusal
use JetDiagnostics.Span
use core.collections.Set

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/statements.rs:35
fn scoped_stmts_in_subset(body: [Stmt], cx: Cx, locals: Set<String>) -> Bool {
    scoped := locals.clone()
    body.iter().all(fn(s) { stmt_in_subset(s, cx, &scoped) })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/statements.rs:45
// Bindings extend locals in source order; refusals identify the actual statement.
pub fn stmt_in_subset(s: Stmt, cx: Cx, locals: &Set<String>) -> Bool {
    if stmt_in_subset_inner(s, cx, locals) -> return true
    refusal.note(refusal.STMT, s.span())
    false
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/statements.rs:53
fn stmt_in_subset_inner(s: Stmt, cx: Cx, locals: &Set<String>) -> Bool {
    if s == {
        .Val(b) -> if b.pattern == {
            Val(.Tuple(elems: elems, ..)) | Val(.List(elems: elems, ..)) -> {
                ok := !b.is_comptime && !b.uninit && expr_in_subset(b.init, cx, locals)
                for e in elems { _ :: locals.insert(e.name.clone()) }
                ok
            }
            Val(.Struct(fields: fields, ..)) -> {
                ok := !b.is_comptime && !b.uninit && expr_in_subset(b.init, cx, locals)
                for f in fields { _ :: locals.insert(f.local_name().to_string()) }
                ok
            }
            Val(.Refutable(pattern: pattern, fallback: fallback, names: names, ..)) -> {
                admitted := if pattern == {
                    .Ok(..) | .Present(..) -> true
                    .Variant(variant: variant, ..) -> cx.variant_owner.contains_key(variant)
                    else -> false
                }
                if !admitted -> return false
                ok := !b.is_comptime && !b.uninit && expr_in_subset(b.init, cx, locals)
                    && orfallback_rhs_in_subset(fallback, cx, locals)
                for name in names { _ :: locals.insert(name.local_name().to_string()) }
                ok
            }
            Val(_) -> false
            None -> {
                // Uninit has no evaluated initializer; resolved comptime data is literal.
                ok := if b.uninit { true } else if b.is_comptime {
                    b.ct.is_some() || expr_in_subset(b.init, cx, locals)
                } else { expr_in_subset(b.init, cx, locals) }
                _ :: locals.insert(b.name.clone())
                ok
            }
        }
        .Assign(target: target, value: value, ..) -> if target == {
            .Local(..) -> expr_in_subset(value, cx, locals)
            .Index(base: base, index: index, kind: kind, ..) -> kind != IndexKind.Unknown
                && expr_in_subset(base, cx, locals) && expr_in_subset(index, cx, locals)
                && expr_in_subset(value, cx, locals)
            .Field(base: base, ..) -> expr_in_subset(base, cx, locals) && expr_in_subset(value, cx, locals)
        }
        .Return(Val(e), _) -> expr_in_subset(e, cx, locals)
        .Return(None, _) -> true
        .Yield(e, _) -> expr_in_subset(e, cx, locals)
        .DeferClose(close: close, ..) -> expr_in_subset(close, cx, locals)
        .Expr(e) -> {
            if e == {
                .MethodCall(receiver: receiver, method: method, ..) -> {
                    if method == Syntax.METHOD_DROP -> return expr_in_subset(receiver, cx, locals)
                }
                else -> {}
            }
            expr_in_subset(e, cx, locals)
        }
        .Loop(body: body, ..) -> {
            body_locals := locals.clone()
            body.iter().all(fn(s) { stmt_in_subset(s, cx, &body_locals) })
        }
        .While(cond: cond, body: body, ..) -> {
            if !expr_in_subset(cond, cx, locals) -> return false
            body_locals := locals.clone()
            body.iter().all(fn(s) { stmt_in_subset(s, cx, &body_locals) })
        }
        .CountedLoop(init: init, cond: cond, step: step, body: body, ..) -> {
            if !expr_in_subset(init.init, cx, locals) -> return false
            inner := locals.clone()
            _ :: inner.insert(init.name.clone())
            if !expr_in_subset(cond, cx, inner) -> return false
            if step.is_some_and(fn(step) { !stmt_in_subset(step, cx, &inner) }) -> return false
            body.iter().all(fn(s) { stmt_in_subset(s, cx, &inner) })
        }
        .For(var: var, var2: var2, kind: kind, body: body, ..) -> if kind == {
            .Range(start: start, end: end, step: step, ..) -> {
                if var2.is_some() -> return false
                if !expr_in_subset(start, cx, locals) || !expr_in_subset(end, cx, locals) -> return false
                if step == { Val(st) -> { if !expr_in_subset(st, cx, locals) -> return false }; else -> {} }
                body_locals := locals.clone()
                _ :: body_locals.insert(var.clone())
                body.iter().all(fn(s) { stmt_in_subset(s, cx, &body_locals) })
            }
            .In(collection, step) -> {
                if step.is_some_and(fn(step) { !expr_in_subset(step, cx, locals) }) -> return false
                if var2.is_some() {
                    if !expr_in_subset(collection, cx, locals) -> return false
                } else {
                    if collection == {
                        .MethodCall(..) -> { if !forin_method_collection_in_subset(collection, cx, locals) -> return false }
                        else -> { if !expr_in_subset(collection, cx, locals) -> return false }
                    }
                }
                body_locals := locals.clone()
                _ :: body_locals.insert(var.clone())
                if var2 == { Val((v2, _)) -> { _ :: body_locals.insert(v2.clone()) }; else -> {} }
                body.iter().all(fn(s) { stmt_in_subset(s, cx, &body_locals) })
            }
            else -> false
        }
        .Break(_) | .Continue(_) | .BreakLabel(..) | .ContinueLabel(..) -> true
        .BreakValue(value, _) | .BreakLabelValue(_, _, value, _) -> expr_in_subset(value, cx, locals)
        .Switch(subject, arms, else_body, span) -> switch_in_subset(subject, arms, else_body, span, cx, locals)
        .ComptimeBlock(..) -> true
        .ComptimeIf(then_body: then_body, else_body: else_body, selected_then: selected_then, ..) -> {
            chosen := if selected_then == {
                Val(true) | None -> then_body
                Val(false) -> else_body.unwrap_or([])
            }
            chosen.iter().all(fn(s) { stmt_in_subset(s, cx, locals) })
        }
        .Unsafe(body: body, ..) | .Impure(body: body, ..) | .Reactive(body: body, ..)
        | .Shield(body: body, ..) -> scoped_stmts_in_subset(body, cx, locals)
        .Switched(marker: marker, body: body, ..) -> {
            if switched_off(marker) -> return true
            scoped := locals.clone()
            body.iter().all(fn(s) { stmt_in_subset(s, cx, &scoped) })
        }
        .Region(body: body, ..) | .Policy(body: body, ..) -> scoped_stmts_in_subset(body, cx, locals)
        .TaskGroup(name: name, body: body, ..) -> {
            scoped := locals.clone()
            _ :: scoped.insert(name.clone())
            body.iter().all(fn(statement) { stmt_in_subset(statement, cx, &scoped) })
        }
        // Layout and setup deliberately extend the enclosing runtime scope.
        .Layout(name: name, body: body, ..) -> {
            _ :: locals.insert(name.clone())
            body.iter().all(fn(s) { stmt_in_subset(s, cx, locals) })
        }
        .ContextBlock(fields: fields, body: body, ..) -> fields.iter().all(fn((_, v, _)) {
            expr_in_subset(v, cx, locals)
        }) && scoped_stmts_in_subset(body, cx, locals)
        .AuthorityScope(binding: binding, body: body, ..) -> {
            scoped := locals.clone()
            if binding == { Val(binding) -> { _ :: scoped.insert(binding.clone()) }; else -> {} }
            body.iter().all(fn(s) { stmt_in_subset(s, cx, &scoped) })
        }
        .Live(body: body, ..) -> scoped_stmts_in_subset(body, cx, locals)
        .ScopeMember(name: name, body: body, ..) -> {
            if name == Syntax.SCOPE_TEST_SETUP { body.iter().all(fn(s) { stmt_in_subset(s, cx, locals) }) }
            else { scoped_stmts_in_subset(body, cx, locals) }
        }
        .AssumeDet(body: body, ..) -> scoped_stmts_in_subset(body, cx, locals)
        .Transact(name: name, body: body, ..) -> {
            inner := locals.clone()
            if name == { Val(name) -> { _ :: inner.insert(name.clone()) }; else -> {} }
            body.iter().all(fn(s) { stmt_in_subset(s, cx, &inner) })
        }
        else -> false
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/statements.rs:455
pub fn forin_method_collection_in_subset(collection: Expr, cx: Cx, locals: Set<String>) -> Bool {
    if collection == {
        .MethodCall(receiver: receiver, method: method, ..) -> {
            if method == "chars" || method == "lines" { expr_in_subset(receiver, cx, locals) }
            else { expr_in_subset(collection, cx, locals) }
        }
        else -> false
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/statements.rs:481
pub fn if_cond_in_subset(cond: Expr, cx: Cx, locals: Set<String>) -> [String]? {
    if cond == { .Binary(BinOp.And, left, right, _) -> {
        bindings := if_cond_in_subset(left, cx, locals) ?? return None
        right_locals := locals.clone()
        right_locals.extend(bindings.iter().cloned())
        bindings.extend(if_cond_in_subset(right, cx, right_locals) ?? return None)
        return Val(^bindings)
    }; else -> {} }
    if cond == { .PatternTest(subject: subject, pattern: pattern, ..) -> {
        if pattern == {
            .Absent(_) -> return if expr_in_subset(subject, cx, locals) { Val([]) } else { None }
            .Struct(..) -> {
                if !expr_in_subset(subject, cx, locals) || !struct_pattern_values_in_subset(pattern, cx, locals) -> return None
                names: Set<String> := Set.new()
                add_struct_pattern_binding_names(pattern, &names)
                return Val(names.into_iter().collect())
            }
            .StrMatch(..) -> {
                if !expr_in_subset(subject, cx, locals) -> return None
                names: Set<String> := Set.new()
                add_str_match_pattern_binding_names(pattern, &names)
                return Val(names.into_iter().collect())
            }
            .BinMatch(..) -> {
                if !expr_in_subset(subject, cx, locals) -> return None
                names: Set<String> := Set.new()
                add_bin_match_pattern_binding_names(pattern, &names)
                return Val(names.into_iter().collect())
            }
            else -> {}
        }
        if !expr_in_subset(subject, cx, locals) -> return None
        is_or := if pattern == { .Or(..) -> true; else -> false }
        if is_or && pattern_is_variant_or_orvariant(pattern)
            && variant_pattern_enum(cx, pattern).is_some_and(fn(owner) { enum_is_covered(owner, cx) }) {
            return Val(pattern.binding_names().into_iter().map(fn(binding) { binding.local_name().to_owned() }).collect())
        }
        if pattern.has_nested_pattern() {
            return Val(pattern.binding_names().into_iter().map(fn(binding) { binding.local_name().to_owned() })
                .filter(fn(name) { name != "_" }).collect())
        }
        if pattern == { .Variant(variant: variant, bindings: bindings, ..) -> {
            if is_data_event_variant(variant) || is_hook_outcome_variant(variant) {
                wildcard_first := if bindings.first() == { Val(.Wildcard) -> true; else -> false }
                if bindings.is_empty() || wildcard_first -> return Val([])
                if bindings.len() == 1 {
                    if bindings.first() == { Val(.Bind(name: name, ..)) -> return Val([name.clone()]); else -> {} }
                }
            }
            if is_json_variant(variant) && bindings.len() == 1 {
                if bindings[0] == { .Bind(name: name, ..) -> return Val([name.clone()]); else -> {} }
            }
            if is_key_variant(variant) {
                single_bind := bindings.len() == 1 && if bindings[0] == { .Bind(..) -> true; else -> false }
                if bindings.is_empty() || single_bind {
                    names: [String] := bindings.iter().filter_map(fn(s) {
                        if s == { .Bind(name: name, ..) -> Val(name.clone()); else -> None }
                    }).collect()
                    return Val(^names)
                }
            }
            if !bindings.is_empty() && bindings.iter().all(fn(slot) {
                if slot == { .Bind(..) | .Wildcard | .Range(..) -> true; else -> false }
            }) {
                names: [String] := bindings.iter().filter_map(fn(slot) {
                    if slot == { .Bind(name: name, ..) -> Val(name.clone()); else -> None }
                }).collect()
                if cx.variant_owner.get(variant) == {
                    Val(owner) -> {
                        covered := if variant_pattern_uses_payload(pattern) { enum_is_covered(owner, cx) }
                            else { enum_tag_is_covered(owner, cx) }
                        if covered -> return Val(^names)
                    }
                    None -> return Val(^names)
                }
            }
            if bindings.is_empty() && cx.variant_owner.contains_key(variant) -> return Val([])
            return None
        }; else -> {} }
        if pattern == { .Range(..) -> {
            if subject == { .Ident(..) -> return Val([]); else -> {} }
            return None
        }; else -> {} }
        return if pattern == {
            .Present(binding: binding, ..) | .Ok(binding: binding, ..) | .Err(binding: binding, ..) -> Val([binding.clone()])
            else -> None
        }
    }; else -> {} }
    if expr_in_subset(cond, cx, locals) { Val([]) } else { None }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/statements.rs:728
pub fn switch_in_subset(subject: Expr, arms: [SwitchArm], else_body: [Stmt]?, span: Span, cx: Cx, locals: &Set<String>) -> Bool {
    if arms.is_empty() -> return false
    if !expr_in_subset(subject, cx, locals) -> return false
    ident_subject := if subject == { .Ident(..) -> true; else -> false }
    // RangeSwitch repeats its subject spelling; preserve single-evaluation semantics.
    if !ident_subject && arms.iter().any(fn(arm) {
        if arm.cond == { .PatternTest(pattern: Pattern.Range(..), ..) -> true; else -> false }
    }) -> return false
    if is_subjectless_guard(subject, span) {
        if arms.iter().any(fn(arm) { readiness_head(arm.cond).is_some() }) {
            has_wait := false
            for arm in arms {
                head := readiness_head(arm.cond) ?? return false
                bindings := if head == {
                    .Receive(binding, source) -> {
                        has_wait = true
                        if !expr_in_subset(source, cx, locals) -> return false
                        [binding.to_string()]
                    }
                    .After(duration) -> {
                        has_wait = true
                        if !expr_in_subset(duration, cx, locals) -> return false
                        []
                    }
                }
                body_locals := locals.clone()
                body_locals.extend(^bindings)
                if !arm.body.iter().all(fn(stmt) { stmt_in_subset(stmt, cx, &body_locals) }) -> return false
            }
            if !has_wait -> return false
            return else_body.is_none_or(fn(body) {
                else_locals := locals.clone()
                body.iter().all(fn(stmt) { stmt_in_subset(stmt, cx, &else_locals) })
            })
        }
        for arm in arms {
            bindings := if_cond_in_subset(arm.cond, cx, locals) ?? return false
            body_locals := locals.clone()
            body_locals.extend(^bindings)
            if !arm.body.iter().all(fn(stmt) { stmt_in_subset(stmt, cx, &body_locals) }) -> return false
        }
        return else_body.is_none_or(fn(body) {
            else_locals := locals.clone()
            body.iter().all(fn(stmt) { stmt_in_subset(stmt, cx, &else_locals) })
        })
    }
    // Nested payload patterns use the guard chain and ordinary condition bindings.
    if arms.iter().any(fn(arm) { arm_has_nested_pattern(arm.cond) }) {
        for arm in arms {
            bindings := if_cond_in_subset(arm.cond, cx, locals) ?? return false
            body_locals := locals.clone()
            body_locals.extend(^bindings)
            if !arm.body.iter().all(fn(stmt) { stmt_in_subset(stmt, cx, &body_locals) }) -> return false
        }
        return else_body.is_none_or(fn(body) {
            else_locals := locals.clone()
            body.iter().all(fn(stmt) { stmt_in_subset(stmt, cx, &else_locals) })
        })
    }
    // DataTree tags have no user-variant ownership entries.
    if arms.iter().all(fn(arm) {
        arm_variant_pattern(cx, arm.cond, subject).is_some_and(fn(pattern) {
            if pattern == { .Variant(variant: variant, ..) -> is_json_variant(variant); else -> false }
        })
    }) {
        for arm in arms {
            pattern := arm_variant_pattern(cx, arm.cond, subject).expect("DataTree switch arm was checked above")
            body_locals := locals.clone()
            add_pattern_binding_names(pattern, &body_locals)
            if !arm.body.iter().all(fn(stmt) { stmt_in_subset(stmt, cx, &body_locals) }) -> return false
        }
        if else_body == { Val(body) -> {
            else_locals := locals.clone()
            if !body.iter().all(fn(stmt) { stmt_in_subset(stmt, cx, &else_locals) }) -> return false
        }; else -> {} }
        return true
    }
    // Guards can leave residual enum cases; require an explicit else.
    has_guarded_variant := arms.iter().any(fn(a) { arm_guarded_variant_pattern(cx, a.cond, subject).is_some() })
    if else_body.is_some() && has_guarded_variant && arms.iter().all(fn(a) {
        arm_variant_pattern(cx, a.cond, subject).is_some() || arm_guarded_variant_pattern(cx, a.cond, subject).is_some()
    }) {
        for arm in arms {
            bindings := if_cond_in_subset(arm.cond, cx, locals) ?? return false
            body_locals := locals.clone()
            body_locals.extend(^bindings)
            if !arm.body.iter().all(fn(stmt) { stmt_in_subset(stmt, cx, &body_locals) }) -> return false
        }
        body := else_body.expect("guarded variant shape requires else")
        else_locals := locals.clone()
        return body.iter().all(fn(stmt) { stmt_in_subset(stmt, cx, &else_locals) })
    }
    // Shape A: exhaustive enum match, with tag-only and union-owner alternatives.
    if arms.iter().all(fn(a) { arm_variant_pattern(cx, a.cond, subject).is_some() }) {
        subj_enum := arms.iter().find_map(fn(a) {
            arm_variant_pattern(cx, a.cond, subject).and_then(fn(p) { variant_pattern_enum(cx, p) })
        })
        payload_used := arms.iter().any(fn(a) {
            arm_variant_pattern(cx, a.cond, subject).is_some_and(fn(pattern) { variant_pattern_uses_payload(pattern) })
        })
        union_shaped := subj_enum.is_none() && arms.iter().all(fn(a) {
            if arm_variant_pattern(cx, a.cond, subject) == {
                Val(.Variant(bindings: bindings, ..)) -> bindings.len() == 1
                else -> false
            }
        })
        if subj_enum.is_none() && !union_shaped -> return false
        if subj_enum == { Val(enum_name) -> {
            covered := if payload_used { enum_is_covered(enum_name, cx) } else { enum_tag_is_covered(enum_name, cx) }
            if enum_name != "HookOutcome" && !covered -> return false
        }; else -> {} }
        for a in arms {
            pat := arm_variant_pattern(cx, a.cond, subject).expect("checked above")
            body_locals := locals.clone()
            add_pattern_binding_names(pat, &body_locals)
            if !a.body.iter().all(fn(s) { stmt_in_subset(s, cx, &body_locals) }) -> return false
        }
        if else_body == { Val(body) -> {
            else_locals := locals.clone()
            if !body.iter().all(fn(s) { stmt_in_subset(s, cx, &else_locals) }) -> return false
        }; else -> {} }
        return true
    }
    // Shape B: range-only table with else, no new bindings.
    if else_body.is_some() && arms.iter().all(fn(a) { arm_head_range(cx, a.cond, subject).is_some() }) {
        for a in arms {
            body_locals := locals.clone()
            if !a.body.iter().all(fn(s) { stmt_in_subset(s, cx, &body_locals) }) -> return false
        }
        if else_body == { Val(body) -> {
            else_locals := locals.clone()
            if !body.iter().all(fn(s) { stmt_in_subset(s, cx, &else_locals) }) -> return false
        }; else -> {} }
        return true
    }
    // Shape C: fallible/optional match, one binding for success/failure/present.
    if arms.iter().all(fn(a) { arm_fallible_pattern(cx, a.cond, subject).is_some() }) {
        for a in arms {
            pat := arm_fallible_pattern(cx, a.cond, subject).expect("checked above")
            body_locals := locals.clone()
            if fallible_pattern_binding(pat) == { Val(b) -> { _ :: body_locals.insert(^b) }; else -> {} }
            if !a.body.iter().all(fn(s) { stmt_in_subset(s, cx, &body_locals) }) -> return false
        }
        if else_body == { Val(body) -> {
            else_locals := locals.clone()
            if !body.iter().all(fn(s) { stmt_in_subset(s, cx, &else_locals) }) -> return false
        }; else -> {} }
        return true
    }
    // Shape D: mixed comparisons/ranges/struct/string/binary patterns.
    if arms.iter().all(fn(a) {
        arm_is_plain_cond(cx, a.cond, subject) || arm_head_range(cx, a.cond, subject).is_some()
            || arm_struct_pattern(cx, a.cond, subject).is_some()
            || arm_str_match_pattern(cx, a.cond, subject).is_some()
            || arm_bin_match_pattern(cx, a.cond, subject).is_some()
    }) {
        for a in arms {
            if arm_head_range(cx, a.cond, subject).is_none()
                && arm_struct_pattern(cx, a.cond, subject).is_none()
                && arm_str_match_pattern(cx, a.cond, subject).is_none()
                && arm_bin_match_pattern(cx, a.cond, subject).is_none()
                && !expr_in_subset(a.cond, cx, locals) -> return false
            body_locals := locals.clone()
            if arm_struct_pattern(cx, a.cond, subject) == { Val(pat) -> {
                if !struct_pattern_values_in_subset(pat, cx, locals) -> return false
                add_struct_pattern_binding_names(pat, &body_locals)
            }; else -> {} }
            if arm_str_match_pattern(cx, a.cond, subject) == {
                Val(pat) -> add_str_match_pattern_binding_names(pat, &body_locals); else -> {}
            }
            if arm_bin_match_pattern(cx, a.cond, subject) == {
                Val(pat) -> add_bin_match_pattern_binding_names(pat, &body_locals); else -> {}
            }
            if !a.body.iter().all(fn(s) { stmt_in_subset(s, cx, &body_locals) }) -> return false
        }
        if else_body == { Val(body) -> {
            else_locals := locals.clone()
            if !body.iter().all(fn(s) { stmt_in_subset(s, cx, &else_locals) }) -> return false
        }; else -> {} }
        return true
    }
    false
}
