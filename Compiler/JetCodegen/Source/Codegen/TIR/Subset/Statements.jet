//RS         receiver, method, ..
//RS     } = collection
//RS     else {
//RS         return false;
//RS     };
//RS     match method.as_str() {
//RS         "chars" | "lines" => expr_in_subset(receiver, cx, locals),
//RS         _ => expr_in_subset(collection, cx, locals),
//RS     }
//RS }
