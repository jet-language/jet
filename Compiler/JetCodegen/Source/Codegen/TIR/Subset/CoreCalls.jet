use JetSema.AST.[Expr, CallArg]
use JetSema.[Sema, Syntax]
use JetCodegen.Codegen.Cx
use JetCodegen.Codegen.TIR.[expr_in_subset, lambda_in_subset]
use JetFoundation.CoreModuleExports
use core.collections.Set

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/core_calls.rs:29
// Registry coverage is solely the TIR_SUBSET projection, never an AOT fact.
pub fn core_call_covered(module: String, method: String) -> Bool {
    if Syntax.core_call(module, method) == {
        Val(row) -> return row.coverage.contains(Syntax.CoreCallCoverage.TIR_SUBSET)
        else -> {}
    }
    if module == "core.mem" && method == "address_of" -> return true
    if module == "core.time" && if method == {
        "nanoseconds" | "microseconds" | "milliseconds" | "seconds" | "minutes" | "hours" -> true
        else -> false
    } -> return true
    if module == "core.tasks" && (method == "yield_now" || method == "current_task") -> return true
    if module == "core.mem" && method == Syntax.MEM_PIN -> return true
    if Sema.is_polymorphic_core_special(module, method) -> return true
    if module == "core.http" && if method == {
        "router" | "parse" | "dispatch" | "serve" -> true; else -> false
    } -> return true
    if module == "core.term" && method == "input" -> return true
    if module == "core.reflect" && method == "of" -> return true
    if CoreModuleExports.core_source_owns(module, method) -> return true
    if method == "new" && if module == {
        "core.data.sketch.hll" | "core.data.sketch.tdigest"
        | "core.data.sketch.cms" | "core.data.sketch.reservoir" -> true
        else -> false
    } -> return true
    if module == "core.event" && if method == {
        "new" | "with_policy" | "hook" | "decision_hook" | "scope" | "policy_sync" | "async_result" -> true
        else -> false
    } -> return true
    if (module == "app" || module == "core.web") && method == "sync" -> return true
    if (module == "core.http.client" || module == "core.http.server" || module == "core.http.middleware")
        && if method == {
            "get" | "post" | "request" | "bind" | "mux" | "mux_handler" | "serve"
            | "serve_once" | "serve_once_listener" | "response" | "tls" | "sse"
            | "static_file" | "static_file_range" | "static_files" | "json"
            | "access_log" | "request_id" | "timeout" | "body_limit" | "cors"
            | "cors_policy" | "compress" -> true
            else -> false
        } -> return true
    if module == "core.net.ws" && (method == "connect" || method == "upgrade") -> return true
    if module == "core.web.browser" && if method == {
        "profile" | "timeout" | "locked" | "connect" | "connect_profile" -> true
        else -> false
    } -> return true
    if module == "core.ui" && method == "mount" -> return true
    Sema.core_fixed_sig(module, method).is_some()
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/core_calls.rs:222
pub fn core_call_args_in_subset(module: String, method: String, args: [CallArg], cx: Cx, locals: Set<String>) -> Bool {
    if module == "core.tasks" && method == "channel" {
        if args.len() == 0 -> return true
        if args.len() != 1 -> return false
        label := args[0].label.map(fn((label, _)) { label })
        return (label == None || label == Val("capacity")) && expr_in_subset(args[0].expr, cx, locals)
    }
    // Written expression order is preserved for labeled one-shot regex calls.
    if module == "core.regex" -> return args.iter().all(fn(arg) { expr_in_subset(arg.expr, cx, locals) })
    if module == "core.auth" && (method == "verify_jwt" || method == "verify_paseto") {
        labels: [String?] := if method == "verify_jwt" {
            [None, Val("key"), Val("audience"), Val("issuer"), Val("clock_skew")]
        } else {
            [None, Val("key"), Val("audience"), Val("issuer"), Val("clock_skew"), Val("footer"), Val("implicit")]
        }
        return args.len() >= 3 && args.len() <= labels.len()
            && args.iter().zip(labels).all(fn((arg, expected)) {
                arg.label.map(fn((label, _)) { label }) == expected && expr_in_subset(arg.expr, cx, locals)
            })
    }
    if module == "core.net.tls" && method == "client" && args.len() == 4 {
        labels: [String?] := [None, Val("server_name"), Val("config"), Val("deadline")]
        return args.iter().zip(labels).all(fn((arg, expected)) {
            arg.label.map(fn((label, _)) { label }) == expected && expr_in_subset(arg.expr, cx, locals)
        })
    }
    if module == "core.net.tls" && method == "client" && args.len() == 3 {
        return args.iter().enumerate().all(fn((idx, arg)) {
            label_ok := if idx == 2 { arg.label.map(fn((label, _)) { label }) == Val("deadline") }
                else { arg.label.is_none() }
            label_ok && expr_in_subset(arg.expr, cx, locals)
        })
    }
    if module == "core.net" && method == "unix_connect" && args.len() == 2 {
        return args.iter().enumerate().all(fn((idx, arg)) {
            label_ok := if idx == 1 { arg.label.map(fn((label, _)) { label }) == Val("deadline") }
                else { arg.label.is_none() }
            label_ok && expr_in_subset(arg.expr, cx, locals)
        })
    }
    // The binder materializes absent optional TLS and deadline slots.
    if module == "core.http.server" && (method == "serve" || method == "bind") && args.len() == 4 {
        return args.iter().enumerate().all(fn((idx, a)) {
            label := a.label.map(fn((label, _)) { label })
            label_ok := if idx == {
                2 -> label == None || label == Val("tls")
                3 -> label == None || label == Val("deadline")
                else -> a.label.is_none()
            }
            label_ok && expr_in_subset(a.expr, cx, locals)
        })
    }
    if module == "core.game" && method == "run" && args.len() >= 1 && args.len() <= 4 {
        return args.iter().enumerate().all(fn((idx, a)) {
            absent := if a.expr == { .Absent(_) -> true; else -> false }
            label := a.label.map(fn((label, _)) { label })
            label_ok := if idx == {
                0 -> a.label.is_none()
                1 -> absent || a.label.is_none() || label == Val("replay")
                2 -> absent || a.label.is_none() || label == Val("backend")
                3 -> absent || a.label.is_none() || label == Val("frames")
                else -> false
            }
            label_ok && expr_in_subset(a.expr, cx, locals)
        })
    }
    if module == "core.text" && method == "display_width" {
        return (args.len() == 1 || args.len() == 2) && args.iter().enumerate().all(fn((idx, arg)) {
            label_ok := if idx == 1 { arg.label.map(fn((label, _)) { label }) == Val("policy") }
                else { arg.label.is_none() }
            label_ok && expr_in_subset(arg.expr, cx, locals)
        })
    }
    if (module == "app" || module == "core.web") && method == "sync" {
        return args.len() == 2 && args.iter().enumerate().all(fn((idx, arg)) {
            label_ok := if idx == 1 { arg.label.map(fn((label, _)) { label }) == Val("over") }
                else { arg.label.is_none() }
            label_ok && expr_in_subset(arg.expr, cx, locals)
        })
    }
    if module == "core.service" && method == "runtime" {
        return args.len() == 2 && args.iter().enumerate().all(fn((idx, arg)) {
            label_ok := if idx == 1 { arg.label.map(fn((label, _)) { label }) == Val("retention") }
                else { arg.label.is_none() }
            label_ok && expr_in_subset(arg.expr, cx, locals)
        })
    }
    if module == "core.ui" && method == "button" && args.len() == 1 {
        return args[0].label.is_none() && expr_in_subset(args[0].expr, cx, locals)
    }
    if module == "core.files" && (method == "walk" || method == "walk_parallel" || method == "walk_files") {
        return (args.len() == 1 || args.len() == 2) && args.iter().enumerate().all(fn((index, arg)) {
            label := arg.label.map(fn((label, _)) { label })
            label_ok := if index == 1 { label == None || label == Val("ignore") }
                else { arg.label.is_none() }
            !arg.spread && label_ok && expr_in_subset(arg.expr, cx, locals)
        })
    }
    if Syntax.core_call(module, method).is_some() {
        return Syntax.core_call_projection(module, method, Syntax.CoreCallCoverage.TIR_SUBSET, args.len()).is_ok()
            && args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) })
    }
    args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/core_calls.rs:431
pub fn core_closure_call_in_subset(module: String, method: String, args: [CallArg], cx: Cx, locals: Set<String>) -> Bool {
    lambda_arg := fn(i: USize) {
        if args.get(i).map(fn(a) { a.expr }) == {
            Val(.Lambda(lam)) -> lambda_in_subset(lam, cx, locals)
            else -> false
        }
    }
    no_labels := args.iter().all(fn(a) { a.label.is_none() })
    if (module, method) == {
        // Service tree lambdas are declarative typed payloads, not arbitrary callbacks.
        ("core.service", "tree") -> args.len() == 1 && no_labels
            && if args[0].expr == { .Lambda(_) -> true; else -> false }
        ("core.tasks", "spawn") -> args.len() == 1 && no_labels && lambda_arg(0)
        ("core.http", "serve") -> args.len() == 2 && no_labels
            && expr_in_subset(args[0].expr, cx, locals) && lambda_arg(1)
        ("core.mem.scope", "guard") -> args.len() == 1 && no_labels && lambda_arg(0)
        ("core.sys", "on_interrupt") -> args.len() == 1 && no_labels && expr_in_subset(args[0].expr, cx, locals)
        ("core.data", "query") -> args.len() == 1 && no_labels && expr_in_subset(args[0].expr, cx, locals)
        ("core.data", "inner_join" | "left_join") -> args.len() == 4 && no_labels
            && expr_in_subset(args[0].expr, cx, locals) && expr_in_subset(args[1].expr, cx, locals)
            && lambda_arg(2) && lambda_arg(3)
        ("core.data", "pivot_sum") -> args.len() == 4 && no_labels
            && expr_in_subset(args[0].expr, cx, locals) && lambda_arg(1) && lambda_arg(2) && lambda_arg(3)
        ("core.reactive", "derived" | "computed" | "effect") -> args.len() == 1 && no_labels && lambda_arg(0)
        ("core.ui", "reactive_render") -> args.len() == 1 && no_labels && lambda_arg(0)
        ("core.ui", "button") -> args.len() == 2 && lambda_arg(1)
            && args.get(1).is_some_and(fn(a) { a.label.is_some_and(fn((label, _)) { label == "on_click" }) })
            && expr_in_subset(args[0].expr, cx, locals)
        ("core.ui", "mount") -> (args.len() == 2 || args.len() == 3) && no_labels
            && args.iter().all(fn(a) { expr_in_subset(a.expr, cx, locals) })
        else -> false
    }
}
