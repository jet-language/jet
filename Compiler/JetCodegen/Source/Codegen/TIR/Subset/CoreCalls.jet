//RS                 && lambda_arg(2)
//RS                 && lambda_arg(3)
//RS         }
//RS         ("core.data", "pivot_sum") => {
//RS             args.len() == 4
//RS                 && no_labels
//RS                 && expr_in_subset(&args[0].expr, cx, locals)
//RS                 && lambda_arg(1)
