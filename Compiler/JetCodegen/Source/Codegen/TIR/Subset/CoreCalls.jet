//RS         ("core.mem.scope", "guard") => args.len() == 1 && no_labels && lambda_arg(0),
//RS         // D-OSINTERRUPT1: the callback itself is canonicalized by lowering;
//RS         // admit all in-subset callback shapes so inline, named, and indirect
//RS         // values use the same `CoreClosureCall` path in every tier.
//RS         ("core.sys", "on_interrupt") => {
//RS             args.len() == 1 && no_labels && expr_in_subset(&args[0].expr, cx, locals)
//RS         }
//RS         // D-QUERY-RETAIN1=A: `core.data.query(rows)` builds one typed
//RS         // deferred Query value; its receiver methods are admitted by the
//RS         // method-call subset gate below.
//RS         ("core.data", "query") => {
//RS             args.len() == 1 && no_labels && expr_in_subset(&args[0].expr, cx, locals)
//RS         }
//RS         ("core.data", "inner_join" | "left_join") => {
//RS             args.len() == 4
//RS                 && no_labels
//RS                 && expr_in_subset(&args[0].expr, cx, locals)
