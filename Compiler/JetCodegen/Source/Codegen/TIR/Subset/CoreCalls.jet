//RS /// c109 Phase 10: is a core/stdlib call `(module, method)` one the TIR lowers? The
//RS /// covered set is the **type-monomorphic** core calls. A call that is a row in the
//RS /// foundation Core-call registry is decided by that row's own `TIR_SUBSET`
//RS /// projection bit; every other call key falls back to `Sema::core_fixed_sig`,
//RS /// whose full signature (param conventions + return type) is fixed. Either
//RS /// source is total: the resolved return type gives the node's total `ty` (for
//RS /// `?`-unwrap and binding inference), and `emit_tir_core_call` has a matching
//RS /// emit arm for every covered key.
//RS ///
//RS /// Gating on `core_fixed_sig(...).is_some()` cleanly EXCLUDES the deferred calls:
//RS ///   - **closure-taking** (`http.serve`, `scope.guard`) — not in the
//RS ///     table / typed `None` → Phase 11 lambdas;
//RS ///   - **polymorphic** math/random/io specials (`math.abs`/`min`/`max`/`clamp`,
//RS ///     `random.pick`/`shuffle`, `io.input`/`io.eprint`) — return type depends on the
//RS ///     arg type, resolved by bespoke `check_core_call` logic, not the fixed table, so
//RS ///     a total `ty` would need re-inference (I3) → deferred;
//RS ///   - **handle-constructor** specials NOT in the table (`tasks.channel`,
//RS ///     `http.router`/`parse`/`dispatch`) and `core.mem` ptr/alloc (`#Unsafe`).
//RS /// A handle-PRODUCING call that IS in the table (`files.open` → `FileReader`,
//RS /// `net.tcp_connect` → `TcpStream`, `time.start` → `Stopwatch`, …) is covered: the
//RS /// CALL emits a plain helper call (parity-exact), and any later METHOD on the
//RS /// returned handle is itself out of subset → excludes the enclosing function.
//RS pub(crate) fn core_call_covered(module: &str, method: &str) -> bool {
//RS     // Plain Core calls are rows in the foundation registry, and the row's own
//RS     // TIR_SUBSET projection bit is the entire decision for a registry key. A row
//RS     // that genuinely has no TIR lowering drops that bit in the table; nothing
//RS     // here may veto a row on a fact that belongs to another tier.
//RS     //
//RS     // This lookup used to also require `row.has_direct_symbol()` — an AOT-only
//RS     // fact (`aot_direct`). Because the lookup returns early, every row that
//RS     // deliberately keeps a typed AOT emitter instead of a direct Prelude symbol
//RS     // (`time.new`/`today`/`parse`/`from_timestamp`, `compute.set`, `ui.box`,
//RS     // `time.parse_time`, `encoding.xml.decode`/`decode_bytes`, the
//RS     // `crypto.expert` calls, the `crypto.__*` field extracts) was reported as
//RS     // out of subset, which took the whole enclosing function out of TIR and off
//RS     // the resident JIT even though every tier had a lowering for it. Coverage is
//RS     // a TIR fact; the AOT projection is read by `emit_plain_core_call` alone.
//RS     //
//RS     // Argument expressions and resolved value types are checked by the callers
//RS     // below; this lookup owns the call-key coverage decision.
//RS     if let Some(row) = crate::Syntax::core_call(module, method) {
//RS         return row
//RS             .coverage
//RS             .contains(crate::Syntax::CoreCallCoverage::TIR_SUBSET);
//RS     }
//RS     // c109 Phase 18: `mem.address_of` is not a registry row — it has a bespoke
//RS     // sema return type and Rust expression — so it needs its own admission here.
//RS     // The enclosing `#Unsafe` gate is checked by the statement and expression
//RS     // subset walkers; this only admits its total call shape. `volatile_read` and
//RS     // `volatile_write` ARE registry rows and ride the lookup above.
//RS     if module == "core.mem" && method == "address_of" {
//RS         return true;
//RS     }
//RS     // D-SHAPE-DURATION1=A: duration constructors are Prelude calls with a unit
//RS     // selected by the method name, and they are not registry rows. Their fixed
//RS     // integer argument and Result type are already resolved by sema.
//RS     if module == "core.time"
//RS         && matches!(
//RS             method,
//RS             "nanoseconds" | "microseconds" | "milliseconds" | "seconds" | "minutes" | "hours"
//RS         )
//RS     {
//RS         return true;
//RS     }
//RS     if module == "core.tasks" && matches!(method, "yield_now" | "current_task") {
//RS         return true;
//RS     }
//RS     // D-PIN1=A: `mem.pin(&place)` lowers to the same exclusive borrow node as
//RS     // `&place` (see `lower_method_call`), so every tier emits the identical
//RS     // form and none of them re-encodes the address-stability rule — sema owns
//RS     // it (I3/I9). The `Pin<T>` return type is total from the argument's type.
//RS     if module == "core.mem" && method == crate::Syntax::MEM_PIN {
//RS         return true;
//RS     }
//RS     // c109 Phase 20: the polymorphic core specials (`math.abs/min/max/clamp`,
//RS     // `random.pick/shuffle`, `io.eprint`). NOT in `core_fixed_sig` — their return
//RS     // type is arg-type dependent, resolved by sema's bespoke `infer_core_call` and
//RS     // written onto the node's `resolved_ret` field (read at lowering, so it's total —
//RS     // I3). The EMITTED form is a fixed per-`(module, method)` string (reproduced in
//RS     // `emit_tir_core_call`), args emitted plainly, preserving canonical encoding.
//RS     // (`io.input` is NOT here — it IS in `core_fixed_sig`, covered by Phase 10.)
//RS     // D-TUPLE-DESTRUCT1: `tasks.channel<T>()` is now a polymorphic core special
//RS     // (registered in `is_polymorphic_core_special` above) — its `(Sender<T>,
//RS     // Receiver<T>)` return type is arg-type dependent (the call-site turbofish
//RS     // `<T>`, sema E0904 requires it), so it's covered by the check just above, not
//RS     // a dedicated block here. Sema writes the resolved `Type::Tuple` onto the
//RS     // node's `resolved_ret`; lowering reads it totally (I3), and the emit reads `T`
//RS     // off that same type to build `{root}jet_std::channel::<{T}>()`
//RS     // (Source/Codegen/TIR/emit.rs `emit_tir_core_call`). The `Receiver`/`Sender`/
//RS     // `Task` METHODS route via their own shape (d3 below).
//RS     if crate::Sema::is_polymorphic_core_special(module, method) {
//RS         return true;
//RS     }
//RS     // c109 Phase 25 / D-FOUND-LIFECYCLE1: HTTP constructors. The ordinary
//RS     // `http.serve(mux, deadline:)` call now rides the registry like router
//RS     // creation and request dispatch; the legacy address/handler spelling
//RS     // remains a separate `CoreClosureCall` path.
//RS     if module == "core.http" && matches!(method, "router" | "parse" | "dispatch" | "serve") {
//RS         return true;
//RS     }
//RS     // D-TEXTWIDTH1=B: `text.display_width` used to be claimed here by name.
//RS     // It is now registered in `is_polymorphic_core_special` (its return type
//RS     // is arity-dependent: `Int` for 1 arg, `Int !TextError` for the `policy:`
//RS     // form), so the check above already covers it and sema carries the
//RS     // resolved type on `resolved_ret`. One coverage mechanism, not two (I8).
//RS     // c109 Phase 29: qualified `io.input(prompt)`. NOT in `core_fixed_sig` — its return
//RS     // type (`Result<String, IOError>`) lives in sema's bespoke `infer_core_call` arm
//RS     // (CheckerCoreLib.rs), carried total by `core_call_return_ty`. It is the DISTINCT
//RS     // qualified MethodCall on a `core.term` alias (the ambient bare `input()`, Phase 25, is
//RS     // a separate `Expr::Call` node → `AmbientInput`). Emits the same fixed-string CoreCall
//RS     // `{root}jet_std_io_input(None|Some(&(prompt)))` (reproduced in `emit_tir_core_call`),
//RS     // byte-for-byte the TIR core-call encoding. Composes with the Phase-8 `?? return`.
//RS     // parity: guard tests/tir_language_features.rs::ambient_input
//RS     if module == "core.term" && method == "input" {
//RS         return true;
//RS     }
//RS     // D-ANY-JAI1 (c7jaiany §6): `reflect.of(x)`. NOT in `core_fixed_sig` (the
//RS     // param type is "any printable value", not a fixed `Type`), but the
//RS     // return type IS fixed regardless of the arg (always `Value`) — total,
//RS     // not arg-dependent, so it's covered like the other fixed-but-not-in-
//RS     // the-table specials above.
//RS     if module == "core.reflect" && method == "of" {
//RS         return true;
//RS     }
//RS     // Source-owned Core members are ordinary Jet module calls in TIR. Their
//RS     // checked fixed signature remains sema's type contract; the source
//RS     // package owns the implementation and no CoreCall registry row is needed.
//RS     if jet_foundation::CoreModuleExports::core_source_owns(module, method) {
//RS         return true;
//RS     }
//RS     // D-APPROX1=A: `HLL.new()`, `TD.new()`, `CMS.new()`, `RS.new(capacity)`. NOT in `core_fixed_sig`.
//RS     if matches!(
//RS         module,
//RS         "core.data.sketch.hll"
//RS             | "core.data.sketch.tdigest"
//RS             | "core.data.sketch.cms"
//RS             | "core.data.sketch.reservoir"
//RS     ) && method == "new"
//RS     {
//RS         return true;
//RS     }
//RS     // D-EVENT1=D: Event/Hook constructors are generic over the payload/result
//RS     // types, so their real return type comes from sema's resolved call.
//RS     if module == "core.event"
//RS         && matches!(
//RS             method,
//RS             "new"
//RS                 | "with_policy"
//RS                 | "hook"
//RS                 | "decision_hook"
//RS                 | "scope"
//RS                 | "policy_sync"
//RS                 | "async_result"
//RS         )
//RS     {
//RS         return true;
//RS     }
//RS     // D-SYNC1: the application sync publisher is a typed, deterministic
//RS     // Prelude call. Its return is String and its named `over:` label is
//RS     // already checked by sema; no closure or host policy remains for TIR.
//RS     if matches!(module, "app" | "core.web") && method == "sync" {
//RS         return true;
//RS     }
//RS     // D-NETDEP1=A / D-HTTPLIB1=A: HTTP constructors. NOT in `core_fixed_sig`.
//RS     if matches!(
//RS         module,
//RS         "core.http.client" | "core.http.server" | "core.http.middleware"
//RS     ) && matches!(
//RS         method,
//RS         "get"
//RS             | "post"
//RS             | "request"
//RS             | "bind"
//RS             | "mux"
//RS             | "mux_handler"
//RS             | "serve"
//RS             | "serve_once"
//RS             | "serve_once_listener"
//RS             | "response"
//RS             | "tls"
//RS             | "sse"
//RS             | "static_file"
//RS             | "static_file_range"
//RS             | "static_files"
//RS             | "json"
//RS             | "access_log"
//RS             | "request_id"
//RS             | "timeout"
//RS             | "body_limit"
//RS             | "cors"
//RS             | "cors_policy"
//RS             | "compress"
//RS     ) {
//RS         return true;
//RS     }
//RS     // D-WS1=B: WebSocket entry points live in core.net.ws (not core.http).
//RS     if module == "core.net.ws" && matches!(method, "connect" | "upgrade") {
//RS         return true;
//RS     }
//RS     // D-BROWSER-AUTO1=A: fixed native BiDi entry points.
//RS     if module == "core.web.browser"
//RS         && matches!(
//RS             method,
//RS             "profile" | "timeout" | "locked" | "connect" | "connect_profile"
//RS         )
//RS     {
//RS         return true;
//RS     }
//RS     // D-UI-MOUNT1=A: bespoke arity (2|3) + backend union; Unit return from sema.
//RS     if module == "core.ui" && method == "mount" {
//RS         return true;
//RS     }
//RS     crate::Sema::core_fixed_sig(module, method).is_some()
//RS }
