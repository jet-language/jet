        else -> false
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/builtin_methods.rs:725
pub fn resolve_numeric_op(method: String, src_name: String, line: U32) -> TNumericOp? Never! {
    if src_name == "Int" {
        if method == METHOD_DIV_EUCLID -> return Val(TNumericOp.EuclideanDiv(line as Int))
        if method == METHOD_REM_EUCLID -> return Val(TNumericOp.EuclideanRem(line as Int))
    }
    if method == "is_nan" || method == "is_infinite" || method == "is_finite" -> return Val(TNumericOp.Predicate(method.to_string()))
    if method == "count_ones" || method == "count_zeros" || method == "leading_zeros" || method == "trailing_zeros" || method == "bit_count" || method == "bit_length" {
        width := if src_name == { "I8" | "U8" -> 8; "I16" | "U16" -> 16; "I32" | "U32" -> 32; else -> 64 }
        return Val(TNumericOp.BitCount(method.to_string(), width))
    }
    if method == "to_string" -> return Val(TNumericOp.ToShow)
    None
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/builtin_methods.rs:765
pub fn resolve_numeric_conversion_op(target_name: String, source_name: String) -> TNumericOp? Never! {
    target := numeric_rust_type_tir(target_name)
    if target.is_none() -> return None
    (dst_rust, dst_int) := target.unwrap()
    if dst_int.is_none() {
        if dst_rust == "f32" && (source_name == "Float" || source_name == "F64") -> return Val(TNumericOp.FloatNarrow(target_name.to_string()))
        return Val(TNumericOp.CastAs(dst_rust.to_string()))
    }
    (dsigned, dbits) := dst_int.unwrap()
    // U64 is an i64 carrier word; preserve the exact unsigned-to-Int Prelude route.
    if target_name == "Int" && parse_int_name_tir(source_name).is_some_and(fn(pair) { !pair.0 }) -> return Val(TNumericOp.CastAs(dst_rust.to_string()))
    if source_name == "Int" && target_name != "Int" {
        host_kind := numeric_host_kind(dsigned, dbits)
        if host_kind.is_none() -> return None
        return Val(TNumericOp.TryFrom(host_kind.unwrap() as Int, dst_rust.to_string(), target_name.to_string()))
    }
    if parse_int_name_tir(source_name) == .Val((ssigned, sbits)) {
        (slo, shi) := int_range(ssigned, sbits)
        (dlo, dhi) := int_range(dsigned, dbits)
        if dlo <= slo && shi <= dhi -> return Val(TNumericOp.CastAs(dst_rust.to_string()))
        host_kind := numeric_host_kind(dsigned, dbits)
        if host_kind.is_none() -> return None
        return Val(TNumericOp.TryFrom(host_kind.unwrap() as Int, dst_rust.to_string(), target_name.to_string()))
    }
    (lo, hi) := int_range(dsigned, dbits)
    host_kind := numeric_host_kind(dsigned, dbits)
    if host_kind.is_none() -> return None
    // int_range is the canonical exact i128 range, so U64's exclusive upper bound cannot overflow.
    Val(TNumericOp.FloatToInt(host_kind.unwrap() as Int, dst_rust.to_string(), target_name.to_string(), "{lo}.0", "{hi + 1}.0"))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/builtin_methods.rs:825
fn numeric_host_kind(signed: Bool, bits: U8) -> I64? Never! {
    if (signed, bits) == { (true, 8) -> Val(0); (true, 16) -> Val(1); (true, 32) -> Val(2); (true, 64) -> Val(3); (false, 8) -> Val(4); (false, 16) -> Val(5); (false, 32) -> Val(6); (false, 64) -> Val(7); else -> None }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/builtin_methods.rs:839
fn numeric_rust_type_tir(name: String) -> (String, (Bool, U8)?)? Never! {
    if name == {
        "I8" -> Val(("i8", Val((true, 8))))
        "I16" -> Val(("i16", Val((true, 16))))
        "I32" -> Val(("i32", Val((true, 32))))
        "I64" | "Int" -> Val(("i64", Val((true, 64))))
        "U8" -> Val(("u8", Val((false, 8))))
        "U16" -> Val(("u16", Val((false, 16))))
        "U32" -> Val(("u32", Val((false, 32))))
        "U64" -> Val(("u64", Val((false, 64))))
        "F32" -> Val(("f32", None))
        "F64" | "Float" -> Val(("f64", None))
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/builtin_methods.rs:857
pub fn parse_int_name_tir(name: String) -> (Bool, U8)? Never! {
    if name == "Int" -> return Val((true, 64))
    if name == "Float" || name == "F32" || name == "F64" -> return None
    signed := name.starts_with("I")
    if (signed || name.starts_with("U")) && name.len() > 1 {
        suffix := name[1..] // #4303: retain the suffix view at the parse boundary.
        return U8.from_str(suffix).ok().map(fn(bits) { (signed, bits) })
    }
    None
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/builtin_methods.rs:882
pub fn is_covered_numeric_method(method: String, nargs: USize) -> Bool Never! {
    numeric_overflow_method(method, nargs).is_some()
        || (nargs == 1 && (method == METHOD_DIV_EUCLID || method == METHOD_REM_EUCLID))
        || (nargs == 0 && if method == { "is_nan" | "is_infinite" | "is_finite" | "count_ones" | "count_zeros" | "leading_zeros" | "trailing_zeros" | "to_string" -> true; else -> false })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/builtin_methods.rs:906
pub fn is_numeric_bounds_const(member: String) -> Bool Never! { if member == { "MIN" | "MAX" | "INFINITY" | "NEG_INFINITY" | "NAN" | "EPSILON" -> true; else -> false } }
