// Rust: crates/jet-codegen/src/Codegen/TIR/subset/builtin_methods.rs:249
pub fn is_process_handle_method_name(recv_type: String?, method: String, nargs: USize) -> Bool Never! {
    if recv_type == {
        .Val("ProcessSpec") -> if (method, nargs) == {
            ("cwd" | "env_remove" | "stdin" | "stdout" | "stderr" | "arg" | "args_extend", 1) | ("env", 2) | ("terminal", 0 | 1)
            | ("env_clear" | "detached" | "abilities" | "plan" | "run" | "run_checked" | "spawn", 0)
            | ("under" | "timeout" | "cpu_time_limit" | "output_limit" | "memory_limit" | "open_file_limit", 1) -> true
            else -> false
        }
        .Val("ProcessChild") -> nargs == 0 && if method == { "id" | "wait" | "exited" | "kill" | "terminate" | "interrupt" -> true; else -> false }
        .Val("TerminalSession") -> method == "resize" && nargs == 1
        .Val("ProcessStdin") -> if (method, nargs) == { ("write", 1) | ("close", 0) -> true; else -> false }
        .Val("ProcessStdoutStream" | "ProcessStderrStream") -> method == "lines" && nargs == 0
        else -> false
    }
}
