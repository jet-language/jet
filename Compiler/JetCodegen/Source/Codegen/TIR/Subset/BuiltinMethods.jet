// Rust: crates/jet-codegen/src/Codegen/TIR/subset/builtin_methods.rs:402
pub fn is_http_method_name(recv_type: String?, method: String) -> Bool Never! {
    if recv_type == {
        .Val("HTTPRequest") -> if method == { "method" | "path" | "param" | "body_len" | "under_limit" | "header" | "body" | "text" | "timeout" | "connect_timeout" | "read_timeout" | "total_timeout" | "dns_timeout" | "tls_timeout" | "write_timeout" | "first_byte_timeout" | "redirects" | "proxy" | "cookie" | "form" | "multipart_text" | "send" | "trailers" | "json" -> true; else -> false }
        .Val("HTTPResponse") -> if method == { "status" | "text" | "json" | "body" | "header" | "cookies" | "trailers" | "protocol" | "remote_address" | "redirect_history" | "timings" | "reused_connection" | "raw_content_encoding" -> true; else -> false }
        .Val("HTTPClient") -> if method == { "cookies" | "redirects" | "protocols" | "timeouts" | "raw_encoding" | "proxy" | "tls" | "allow_http_downgrade" | "retries" | "send" -> true; else -> false }
        .Val("Headers") -> if method == { "first" | "all" | "append" | "set" | "remove" -> true; else -> false }
        .Val("Body") -> if method == { "bytes" | "text" | "json" | "chunks" | "copy_to" -> true; else -> false }
        .Val("HTTPMux") -> if method == { "get" | "post" | "put" | "delete" | "patch" | "head" | "options" | "middleware" -> true; else -> false }
        .Val("HTTPHandler") -> method == "handle"
        .Val("HTTPServer") -> if method == { "local_addr" | "serve" | "shutdown" | "wait" -> true; else -> false }
        .Val("WsConn") -> if method == { "send_text" | "send_bytes" | "recv" | "close" -> true; else -> false }
        .Val("WsMessage") -> if method == { "is_text" | "is_binary" | "is_close" | "text" | "bytes" -> true; else -> false }
        .Val("Browser") -> if method == { "abilities" | "context" | "subscribe" | "next_event" | "add_intercept" | "add_intercept_url" | "continue_request" | "fail_request" | "fulfill_request" | "allow_downloads" | "protocol" | "trace" | "privacy" | "receipt" | "close" -> true; else -> false }
        .Val("BrowserContext") -> if method == { "page" | "tab" | "close" | "isolated" | "user_hash" -> true; else -> false }
        .Val("BrowserPage") -> if method == { "goto" | "get_by_role" | "get_by_text" | "get_by_label" | "get_by_placeholder" | "get_by_test_id" | "get_by_css" | "close" | "main_frame" | "frames" | "screenshot" | "pdf" | "set_cookie" | "cookie" | "clear_cookies" | "storage_get" | "storage_set" | "storage_clear" -> true; else -> false }
        .Val("BrowserFrame") -> method == "close"
        .Val("BrowserLocator") -> if method == { "wait" | "wait_gone" | "click" | "hover" | "fill" | "press" | "set_files" -> true; else -> false }
        .Val("BrowserIntercept") -> method == "remove"
        .Val("BrowserEvent") -> if method == { "kind" | "request_id" | "request_method" | "url_hash" | "is_blocked" | "status_code" | "download_id" | "suggested_filename_hash" -> true; else -> false }
        .Val("BrowserProtocol") -> method == "send"
        .Val("BrowserAbilities") -> if method == { "bidi" | "cdp" | "profile" -> true; else -> false }
        .Val("BrowserTrace") -> if method == { "entry_count" | "redacted" | "summary" -> true; else -> false }
        .Val("BrowserReceipt") -> if method == { "entry_count" | "redacted" | "summary" | "isolated" | "cleaned" -> true; else -> false }
        .Val("BrowserPrivacy") -> if method == { "isolated_profiles" | "redact_receipts" | "shared_profiles" -> true; else -> false }
        .Val("BrowserLocked") -> if method == { "engine" | "version" | "binary" | "protocol" | "verify" -> true; else -> false }
        else -> false
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/builtin_methods.rs:565
pub fn is_civil_time_method_name(recv_type: String?, method: String) -> Bool Never! {
    // This one receiver-keyed table is shared by lowering and residency gates.
    if recv_type == {
        .Val("Date" | "LocalDate") -> if method == { "year" | "month" | "day" | "add_days" | "add_months" | "add_period" | "subtract_period" | "diff_days" | "weekday" | "iso_weekday" | "day_of_year" | "iso_week" | "iso_week_year" | "quarter_of_year" | "days_in_month" | "is_leap_year" | "truncate" | "replace" | "format" | "format_checked" | "until" | "since" | "with" | "to_string" | "equal" | "compare" -> true; else -> false }
        .Val("LocalTime") -> if method == { "hour" | "minute" | "second" | "millisecond" | "microsecond" | "nanosecond" | "add_duration" | "subtract_duration" | "round" | "truncate" | "floor" | "ceil" | "until" | "since" | "format" | "format_checked" | "to_string" | "equal" | "compare" -> true; else -> false }
        .Val("DateTime") -> if method == { "hour" | "minute" | "second" | "millisecond" | "microsecond" | "nanosecond" | "to_timestamp" | "to_unix_ms" | "to_unix_s" | "to_unix_us" | "to_unix_ns" | "date" | "time" | "plus_duration" | "subtract_duration" | "add_nanoseconds" | "difference" | "add_period" | "subtract_period" | "until" | "since" | "truncate" | "round" | "floor" | "ceil" | "replace" | "with" | "in_zone" | "format_rfc3339" | "format" | "format_checked" | "to_string" | "equal" | "compare" -> true; else -> false }
        .Val("Instant") -> if method == { "elapsed_millis" | "elapsed" | "equal" | "compare" -> true; else -> false }
        .Val("Period") -> if method == { "years" | "months" | "days" | "sign" | "is_zero" | "abs" | "negated" | "add" | "sub" | "total_in" | "to_string" -> true; else -> false }
        .Val("Zone") -> if method == { "name" | "next_transition" | "previous_transition" | "start_of_day" | "hours_in_day" -> true; else -> false }
        .Val("ZonedDateTime") -> if method == { "date" | "time" | "offset_seconds" | "is_dst" | "to_datetime" | "zone" | "add_duration" | "subtract_duration" | "add_period" | "subtract_period" | "with_time" | "with_zone" | "until" | "since" | "next_transition" | "previous_transition" | "start_of_day" | "hours_in_day" | "format" | "format_rfc9557" | "format_checked" | "to_string" | "equal" | "compare" -> true; else -> false }
        else -> false
    }
}
