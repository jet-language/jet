//RS /// c109 Phase 9: is `method` (with `nargs` arguments) a built-in collection/string
//RS /// method the TIR lowers? This is the NON-closure, non-numeric, non-handle slice of
//RS /// built-in method lowering, restricted to the list/map/
//RS /// string surface (`Source/Collections.rs`). The closure-taking methods (`map`/
//RS /// `filter`/`each`/`find`/`any`/`all`/`sort_by`/`reduce` — `Collections::
//RS /// is_closure_method`) are deferred to the lambda phase; the numeric width/predicate/
//RS /// numeric queries (`is_nan`/`count_ones`/… — D-NUMOPS1) and the handle methods
//RS /// (FileWriter/TcpStream/HTTPRequest/… — Phase 10) carry a nominal
//RS /// `Some(recv_type)`, while parenthesized/fallible String receivers may carry
//RS /// `Some("String")`; the subset gate admits that one canonical String exception.
//RS /// This name list is the final filter. The arg count disambiguates `join()` (no
//RS /// separator) vs `join(sep)`.
//RS pub(crate) fn is_covered_builtin_name(method: &str, nargs: usize) -> bool {
//RS     // Closure-taking methods are NEVER covered here (Phase 11), even by name.
//RS     // Exception: 0-arg forms that share a name with a closure adapter
//RS     // (Bytes.position — cursor read, not Iter.position(pred)).
//RS     if crate::Collections::is_closure_method(method) && nargs > 0 {
//RS         return false;
//RS     }
//RS     // D-ZIPPAD1: zip-family arity is variadic. Sema has already validated the
//RS     // receiver and every input/fill label; lowering carries the resolved row
//RS     // shape, so this gate must not impose an artificial arity ceiling.
//RS     if matches!(method, "zip" | "zip_short" | "zip_pad") {
//RS         return true;
//RS     }
//RS     matches!(
//RS         (method, nargs),
//RS         // D-FAIL-CARRIER1=A: `.or_err("why")` lifts a clean absence into a
//RS         // failure; `.partial` and `.notes` read the carrier's middle states.
//RS         ("or_err", 1) | ("partial", 0) | ("notes", 0)
//RS         // List + map shared.
//RS         // D-PLACE1: Atomic<T> methods are keyed by the receiver type in
//RS         // `method_call_in_subset`; these names are not collection fallbacks.
//RS         | ("load", 0) | ("store", 1)
//RS         | ("compare_exchange", 2) | ("publish", 1) | ("observe", 0)
//RS         |         ("len", 0) | ("is_empty", 0) | ("clear", 0)
//RS         // List-only, except for Iter's positional terminal.
//RS         | ("push", 1) | ("append", 1) | ("pop", 0) | ("pop", 1) | ("first", 0) | ("last", 0)
//RS         | ("index_of" | "index", 1) | ("reverse", 0) | ("sort", 0) | ("sort_desc", 0) | ("join", 1)
//RS         // List + map: insert/remove/get (the Map vs List branch resolves at lowering).
//RS         | ("insert", 2) | ("add", 2) | ("add_new", 2) | ("remove", 1 | 2) | ("get", 1)
//RS         // List + string: contains.
//RS         | ("contains", 1)
//RS         // Map-only.
//RS         | ("keys", 0) | ("values", 0) | ("items", 0) | ("has_key", 1)
//RS         | ("setdefault", 2)
//RS         | ("update", 1) | ("merge", 1) | ("merge", 2)
//RS         | ("strip" | "lstrip" | "rstrip", 0)
//RS         | ("expandtabs", 1) | ("find", 1) | ("rfind", 1) | ("rindex", 1)
//RS         | ("partition", 1)
//RS         | ("repeat", 1) | ("slice", 2)
//RS         | ("trim_start", 0) | ("trim_end", 0)
//RS         | ("pad_start", 2) | ("pad_end", 2)
//RS         | ("is_alphabetic", 0) | ("is_numeric", 0)
//RS         | ("is_whitespace", 0) | ("is_ascii", 0)
//RS         | ("to_title", 0) | ("split_once", 1) | ("cut_last", 1)
//RS         | ("is_lower", 0) | ("is_upper", 0)
//RS         | ("capitalize", 0) | ("swapcase", 0) | ("normalize", 0)
//RS         | ("remove_prefix", 1) | ("remove_suffix", 1)
//RS         | ("rsplit", 1)
//RS         | ("count", 1) | ("counts", 0) | ("extend", 1) | ("concat", 1)
//RS         // D-STR-AFTER1: first-occurrence substring split.
//RS         | ("after", 1) | ("before", 1)
//RS         // c97/D-STRPARSE1: parsing stays `Type.parse`.
//RS         | ("lines", 0) | ("bytes", 0)
//RS         // D-STR-DECLINE1=C: `parse`/`to_int`/`to_float` — same numeric
//RS         // parse mechanisms, with String as the receiver.
//RS         | ("parse", 0) | ("to_int", 0) | ("to_float", 0)
//RS         | ("matches", 1) | ("match", 1)
//RS         // `to_string` (String/Bool/Char receiver — String may retain
//RS         // `recv_type == Some("String")` through parentheses/fallibility; Bool/Char
//RS         // stay untyped here; numeric `to_string` sets another nominal `recv_type`).
//RS         | ("to_string", 0)
//RS         // D-ITER1: non-closure lazy adapters.
//RS         | ("take", 1) | ("skip", 1) | ("step_by", 1)
//RS         | ("dedup", 0) | ("chunks", 1) | ("windows", 1)
//RS         | ("indexed", 0) | ("indexes", 0) | ("zip", 1)
//RS         | ("sum", 0) | ("product", 0) | ("min", 0) | ("max", 0)
//RS         | ("flatten", 0) | ("intersperse", 1) | ("unzip", 0)
//RS         // #1479 Iter ledger surface (non-closure).
//RS         | ("cycle", 1) | ("drop_last", 1) | ("shuffle", 0)
//RS         | ("is_sorted", 0) | ("average", 0)
//RS         // D-ITER-RESUME1=A: one exclusive pull from an Iter.
//RS         | ("next", 0)
//RS         // D-LOOPMAP1=B: enter the lazy pipeline plane from an in-memory list.
//RS         | ("lazy", 0)
//RS         // D-COLLBREADTH1=A: Set<T> instance methods.
//RS         | ("add", 1) | ("discard", 1) | ("union", 1) | ("to_list", 0)
//RS         | ("intersection", 1) | ("difference", 1)
//RS         | ("symmetric_difference", 1)
//RS         | ("difference_update" | "intersection_update" | "symmetric_difference_update", 1)
//RS         | ("is_subset" | "issubset", 1)
//RS         | ("is_superset" | "issuperset", 1)
//RS         | ("is_disjoint" | "isdisjoint", 1)
//RS         | ("to_set", 0)
//RS         | ("peek", 0) | ("to_sorted_list", 0)
//RS         | ("capacity", 0) | ("count", 0) | ("to_bytes", 0)
//RS         | ("write_u8", 1) | ("write_byte", 1) | ("write_u16_le", 1) | ("write_u16_be", 1)
//RS         | ("write_i8", 1)
//RS         | ("write_i16_le", 1) | ("write_i16_be", 1)
//RS         | ("write_u32_le", 1) | ("write_u32_be", 1)
//RS         | ("write_i32_le", 1) | ("write_i32_be", 1)
//RS         | ("write_u64_le", 1) | ("write_u64_be", 1)
//RS         | ("write_i64_le", 1) | ("write_i64_be", 1)
//RS         | ("write_f32_le", 1) | ("write_f32_be", 1)
//RS         | ("write_f64_le", 1) | ("write_f64_be", 1)
//RS         | ("write_bytes", 1) | ("write", 1)
//RS         | ("position", 0) | ("eof", 0) | ("rewind", 0) | ("flush", 0) | ("close", 0)
//RS         | ("shutdown", 0) | ("get_buffer", 0) | ("buffer", 0) | ("string", 0)
//RS         | ("title", 0) | ("clone", 0) | ("copy", 0) | ("read", 0)
//RS         | ("seek", 1) | ("read_bytes", 1) | ("read_string", 1)
//RS         | ("last_index_of", 1) | ("equal", 1) | ("compare", 1) | ("copy_to", 1)
//RS         | ("binary_search", 1) | ("random", 0) | ("min_max", 0) | ("slice", 1)
//RS         | ("contains_value", 1) | ("pop_first", 0) | ("top_n", 1)
//RS         | ("write_to", 1)
//RS         // D-TAG1: Tally<T> instance methods (add/remove share list/set arms above).
//RS         | ("has", 1)
//RS         // D-COLLBREADTH1=A: Queue<T> instance methods.
//RS         | ("push_front", 1) | ("push_back", 1)
//RS         | ("pop_front", 0) | ("pop_back", 0)
//RS         | ("peek_front", 0) | ("peek_back", 0)
//RS         | ("delete", 1)
//RS         // D-FAILCOMP1: failure-aware list adapter.
//RS         | ("try_collect", 0)
//RS         // D-ALLOCFAIL1=A: the fallible-allocation rail is an ordinary builtin
//RS         // receiver op on the same list/map/string surface — sema types it via
//RS         // `Collections::*_method_return` (so `recv_type` stays `None`),
//RS         // `resolve_builtin_op` maps it to `TBuiltinOp::TryPush`/`TryStringPush`/
//RS         // `TryReserve`/`TryInsertMap`, and emit renders `jet_list_try_push`/
//RS         // `jet_string_try_push`/`jet_list_try_reserve`/`jet_map_try_insert`.
//RS         // This gate is the third table of that set and must name them too, or a
//RS         // `#Test` body using the rail leaves the subset and `emit_test_body`
//RS         // reports an internal compiler error instead of emitting (I2/R7).
//RS         | ("try_push", 1) | ("try_reserve", 1) | ("try_insert", 2)
//RS         // D-DYNARRAY1: `list.view(a..b)` — zero-copy window constructor. The
//RS         // View<T> read-accessor methods (`get`/`first`/`last`/`index_of`/
//RS         // `len`/`is_empty`/`contains`) need no separate entry — they share
//RS         // the exact same (name, argcount) pairs as the list arms above, and
//RS         // `resolve_builtin_op`/`method_call_in_subset` don't branch on
//RS         // receiver type for those (a `&[T]` receiver satisfies them exactly
//RS         // as a `Vec<T>` does — see `Context::rust_type`'s `View` arm).
//RS         | ("view", 2)
//RS         | ("split_write", 1)
//RS         | ("get_disjoint_write", 1)
//RS     )
//RS     // NOTE: `is_empty` (now Bool-typed in `Collections::*_method_return` after the
//RS     // c109 fix; lowered to `TBuiltinOp::IsEmpty`) is covered above. `join()` (no
//RS     // separator) stays excluded: sema requires `join(sep)` (E0311 on no-arg), so the
//RS     // no-arg form never reaches codegen — its AST arm is dead.
//RS }
