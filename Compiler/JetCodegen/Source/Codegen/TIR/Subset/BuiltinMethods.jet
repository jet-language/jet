use jet_codegen.Collections.[is_closure_method, numeric_overflow_method]

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/builtin_methods.rs:15
pub fn is_covered_builtin_name(method: String, nargs: USize) -> Bool Never! {
    // Nonzero-argument closure routes belong to the lambda phase, not this table.
    if is_closure_method(method) && nargs > 0 -> return false
    // Sema has validated every input/fill label. Zip-family arity has no ceiling.
    if method == "zip" || method == "zip_short" || method == "zip_pad" -> return true
    if (method, nargs) == {
        ("or_err", 1) | ("partial", 0) | ("notes", 0)
        | ("load", 0) | ("store", 1) | ("compare_exchange", 2) | ("publish", 1) | ("observe", 0)
        | ("len", 0) | ("is_empty", 0) | ("clear", 0)
        | ("push", 1) | ("append", 1) | ("pop", 0) | ("pop", 1) | ("first", 0) | ("last", 0)
        | ("index_of" | "index", 1) | ("reverse", 0) | ("sort", 0) | ("sort_desc", 0) | ("join", 1)
        | ("insert", 2) | ("add", 2) | ("add_new", 2) | ("remove", 1 | 2) | ("get", 1) | ("contains", 1)
        | ("keys", 0) | ("values", 0) | ("items", 0) | ("has_key", 1) | ("setdefault", 2)
        | ("update", 1) | ("merge", 1) | ("merge", 2)
        | ("strip" | "lstrip" | "rstrip", 0) | ("expandtabs", 1) | ("find", 1) | ("rfind", 1) | ("rindex", 1) | ("partition", 1)
        | ("repeat", 1) | ("slice", 2) | ("trim_start", 0) | ("trim_end", 0) | ("pad_start", 2) | ("pad_end", 2)
        | ("is_alphabetic", 0) | ("is_numeric", 0) | ("is_whitespace", 0) | ("is_ascii", 0)
        | ("to_title", 0) | ("split_once", 1) | ("cut_last", 1) | ("is_lower", 0) | ("is_upper", 0)
        | ("capitalize", 0) | ("swapcase", 0) | ("normalize", 0) | ("remove_prefix", 1) | ("remove_suffix", 1) | ("rsplit", 1)
        | ("count", 1) | ("counts", 0) | ("extend", 1) | ("concat", 1) | ("after", 1) | ("before", 1)
        | ("lines", 0) | ("bytes", 0) | ("parse", 0) | ("to_int", 0) | ("to_float", 0)
        | ("matches", 1) | ("match", 1) | ("to_string", 0)
        | ("take", 1) | ("skip", 1) | ("step_by", 1) | ("dedup", 0) | ("chunks", 1) | ("windows", 1)
        | ("indexed", 0) | ("indexes", 0) | ("zip", 1) | ("sum", 0) | ("product", 0) | ("min", 0) | ("max", 0)
        | ("flatten", 0) | ("intersperse", 1) | ("unzip", 0) | ("cycle", 1) | ("drop_last", 1) | ("shuffle", 0)
        | ("is_sorted", 0) | ("average", 0) | ("next", 0) | ("lazy", 0)
        | ("add", 1) | ("discard", 1) | ("union", 1) | ("to_list", 0) | ("intersection", 1) | ("difference", 1)
        | ("symmetric_difference", 1) | ("difference_update" | "intersection_update" | "symmetric_difference_update", 1)
        | ("is_subset" | "issubset", 1) | ("is_superset" | "issuperset", 1) | ("is_disjoint" | "isdisjoint", 1)
        | ("to_set", 0) | ("peek", 0) | ("to_sorted_list", 0) | ("capacity", 0) | ("count", 0) | ("to_bytes", 0)
        | ("write_u8", 1) | ("write_byte", 1) | ("write_u16_le", 1) | ("write_u16_be", 1) | ("write_i8", 1)
        | ("write_i16_le", 1) | ("write_i16_be", 1) | ("write_u32_le", 1) | ("write_u32_be", 1)
        | ("write_i32_le", 1) | ("write_i32_be", 1) | ("write_u64_le", 1) | ("write_u64_be", 1)
        | ("write_i64_le", 1) | ("write_i64_be", 1) | ("write_f32_le", 1) | ("write_f32_be", 1)
        | ("write_f64_le", 1) | ("write_f64_be", 1) | ("write_bytes", 1) | ("write", 1)
        | ("position", 0) | ("eof", 0) | ("rewind", 0) | ("flush", 0) | ("close", 0)
        | ("shutdown", 0) | ("get_buffer", 0) | ("buffer", 0) | ("string", 0)
        | ("title", 0) | ("clone", 0) | ("copy", 0) | ("read", 0) | ("seek", 1) | ("read_bytes", 1) | ("read_string", 1)
        | ("last_index_of", 1) | ("equal", 1) | ("compare", 1) | ("copy_to", 1)
        | ("binary_search", 1) | ("random", 0) | ("min_max", 0) | ("slice", 1)
        | ("contains_value", 1) | ("pop_first", 0) | ("top_n", 1) | ("write_to", 1) | ("has", 1)
        | ("push_front", 1) | ("push_back", 1) | ("pop_front", 0) | ("pop_back", 0) | ("peek_front", 0) | ("peek_back", 0) | ("delete", 1)
        | ("try_collect", 0) | ("try_push", 1) | ("try_reserve", 1) | ("try_insert", 2)
        | ("view", 2) | ("split_write", 1) | ("get_disjoint_write", 1) -> true
        else -> false
    }
}

