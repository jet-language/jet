// Rust: crates/jet-codegen/src/Codegen/TIR/subset/builtin_methods.rs:714
pub fn is_sketch_method_name(recv_type: String?, method: String) -> Bool Never! {
    if recv_type == {
        .Val("HyperLogLog" | "CountMinSketch") -> method == "add" || method == "count"
        .Val("TDigest") -> method == "add" || method == "quantile"
