use JetSema.AST.[Func, Stmt, Type, numeric_type_from_name]
use JetSema.[Syntax, Generics]
use JetCodegen.Codegen.Cx
use JetCodegen.Codegen.TIR.*
use JetCodegen.Codegen.TIR.Subset.Refusal as refusal
use core.collections.Set

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/entry.rs:23
// Conservative structural coverage: exclude on any doubt. Sema owns purity,
// unsafe admission, generic bounds and default-argument filling.
pub fn tir_covers(f: Func, cx: Cx) -> Bool {
    refusal.begin()
    if f.params.iter().find(fn(p) { p.name == Syntax.KW_SELF }) == {
        Val(p) -> { refusal.note(refusal.SELF_PARAM, p.name_span); return false }
        else -> {}
    }
    for p in f.params {
        param_ty := if p.variadic { Type.List(p.ty.clone()) } else { p.ty.clone() }
        if !is_subset_param_ty(param_ty, cx) {
            refusal.note(refusal.PARAM_TY, p.ty_span)
            return false
        }
    }
    if f.return_type == { Val(rt) -> {
        if !is_subset_return_ty(rt, cx) {
            if f.return_type_span == { Val(span) -> refusal.note(refusal.RETURN_TY, span); else -> {} }
            return false
        }
    }; else -> {} }
    locals: Set<String> := f.params.iter().map(fn(p) { p.name.clone() }).collect()
    f.body.iter().all(fn(statement) { stmt_in_subset(statement, cx, &locals) })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/entry.rs:87
pub fn tir_covers_error_conv_body(body: [Stmt], cx: Cx) -> Bool {
    refusal.begin()
    locals: Set<String> := Set.new()
    _ :: locals.insert(Syntax.KW_SELF.to_string())
    body.iter().all(fn(s) { stmt_in_subset(s, cx, &locals) })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/entry.rs:109
// Restore the enclosing type-parameter scope after checking a method.
pub fn tir_covers_method(f: Func, type_name: String, cx: Cx) -> Bool {
    refusal.begin()
    previous_type_params := cx.current_type_params.borrow().clone()
    method_type_params := previous_type_params.clone()
    method_type_params.extend(f.type_params.iter().map(fn(param) { param.name.clone() }))
    _ :: cx.current_type_params.replace(^method_type_params)
    covered := tir_covers_method_inner(f, type_name, cx)
    _ :: cx.current_type_params.replace(^previous_type_params)
    covered
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/entry.rs:123
fn tir_covers_method_inner(f: Func, type_name: String, cx: Cx) -> Bool {
    generic_owner := struct_is_generic(type_name, cx)
    owner_ty := Type.Named(type_name.to_string())
    if !generic_owner && !is_covered_struct_ty(owner_ty, cx) && !is_covered_enum_ty(owner_ty, cx) {
        refusal.note(refusal.UNCOVERED_OWNER, f.name_span)
        return false
    }
    if f.params.iter().skip(1).find(fn(p) { p.name == Syntax.KW_SELF }) == {
        Val(p) -> { refusal.note(refusal.EXTRA_SELF_PARAM, p.name_span); return false }
        else -> {}
    }
    // Mutable-self assignments lower through the dereferenced receiver slot.
    for p in f.params.iter().filter(fn(p) { p.name != Syntax.KW_SELF }) {
        if !is_subset_param_ty(resolve_self_ty(p.ty, type_name), cx) {
            refusal.note(refusal.PARAM_TY, p.ty_span)
            return false
        }
    }
    if f.return_type == { Val(rt) -> {
        if !is_subset_return_ty(resolve_self_ty(rt, type_name), cx) {
            if f.return_type_span == { Val(span) -> refusal.note(refusal.RETURN_TY, span); else -> {} }
            return false
        }
    }; else -> {} }
    locals: Set<String> := f.params.iter().map(fn(p) { p.name.clone() }).collect()
    f.body.iter().all(fn(s) { stmt_in_subset(s, cx, &locals) })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/entry.rs:186
pub fn tir_covers_trait_method(f: Func, type_name: String, cx: Cx, trait_name: String) -> Bool {
    refusal.begin()
    if !trait_method_binders_lower_in_place(f, type_name, cx, trait_name) {
        refusal.note(refusal.TYPE_PARAMS, f.name_span)
        return false
    }
    serde_generic_owner := (trait_name == Generics.ENCODE || trait_name == Generics.DECODE)
        && struct_is_generic(type_name, cx)
    is_literal := Generics.is_literal_capability(trait_name)
    is_checked_text := trait_name == Generics.CHECKED_TEXT
    owner_ty := Type.Named(type_name.to_string())
    operator_on_builtin := (trait_name == Syntax.TRAIT_ADD || trait_name == Syntax.TRAIT_SUB
        || trait_name == Syntax.TRAIT_MUL || trait_name == Syntax.TRAIT_DIV)
        && numeric_type_from_name(type_name).is_some()
    if !serde_generic_owner && !is_covered_struct_ty(owner_ty, cx)
        && !is_covered_enum_ty(owner_ty, cx) && !cx.distinct_types.contains_key(type_name)
        && !operator_on_builtin {
        refusal.note(refusal.UNCOVERED_OWNER, f.name_span)
        return false
    }
    // Decode, CheckedText and literal contracts admit static trait methods.
    is_decode := trait_name == Generics.DECODE
    if !is_decode && !is_checked_text && !is_literal {
        first := f.params.first() ?? {
            refusal.note(refusal.MISSING_SELF_PARAM, f.name_span)
            return false
        }
        if first.name != Syntax.KW_SELF {
            refusal.note(refusal.MISSING_SELF_PARAM, first.name_span)
            return false
        }
    }
    if f.params.iter().skip(1).find(fn(p) { p.name == Syntax.KW_SELF }) == {
        Val(p) -> { refusal.note(refusal.EXTRA_SELF_PARAM, p.name_span); return false }
        else -> {}
    }
    for p in f.params.iter().filter(fn(p) { p.name != Syntax.KW_SELF }) {
        if p.default.is_some() {
            refusal.note(refusal.DEFAULTED_TRAIT_PARAM, p.name_span)
            return false
        }
        if !is_subset_param_ty(resolve_self_ty(p.ty, type_name), cx) {
            refusal.note(refusal.PARAM_TY, p.ty_span)
            return false
        }
    }
    if f.return_type == { Val(rt) -> {
        if !is_subset_return_ty(resolve_self_ty(rt, type_name), cx) {
            if f.return_type_span == { Val(span) -> refusal.note(refusal.RETURN_TY, span); else -> {} }
            return false
        }
    }; else -> {} }
    locals: Set<String> := f.params.iter().map(fn(p) { p.name.clone() }).collect()
    f.body.iter().all(fn(s) { stmt_in_subset(s, cx, &locals) })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/entry.rs:288
// Program lowering asks only this route fact, never the body coverage gate.
pub fn trait_method_binders_lower_in_place(f: Func, type_name: String, cx: Cx, trait_name: String) -> Bool {
    f.type_params.is_empty()
        || ((trait_name == Generics.ENCODE || trait_name == Generics.DECODE) && struct_is_generic(type_name, cx))
        || trait_name == Generics.CHECKED_TEXT
        || Generics.is_literal_capability(trait_name)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/entry.rs:307
// Parser-unforgeable derive provenance, not the source-method gate, owns coverage.
pub fn tir_covers_compiler_derive_method(f: Func, _cx: Cx) -> Bool { f.type_params.is_empty() }
