// I2 internal breadcrumb for the TIR coverage gate; never a user diagnostic.
use jet_codegen.Codegen.Context.Cx
use jet_foundation.Diagnostics.[Span, span_line_col]
use std.cell.Cell
use std.thread_local.ThreadLocal

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/refusal.rs:22
struct Refusal { what: String, span: Span }
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/refusal.rs:27
pub const EXPR: String = "expression"
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/refusal.rs:28
pub const STMT: String = "statement"
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/refusal.rs:29
pub const PARAM_TY: String = "parameter type"
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/refusal.rs:30
pub const RETURN_TY: String = "return type"
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/refusal.rs:31
pub const SELF_PARAM: String = "`self` parameter on a plain function"
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/refusal.rs:32
pub const EXTRA_SELF_PARAM: String = "`self` parameter after the first"
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/refusal.rs:33
pub const MISSING_SELF_PARAM: String = "trait method with no `self` receiver"
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/refusal.rs:34
pub const UNCOVERED_OWNER: String = "method whose owner type is not covered"
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/refusal.rs:35
pub const TYPE_PARAMS: String = "method's own type parameters"
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/refusal.rs:36
pub const DEFAULTED_TRAIT_PARAM: String = "defaulted trait-method parameter"
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/refusal.rs:40
const MAX_SNIPPET_CHARS: USize = 60
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/refusal.rs:42
// GATE #4494: real thread-local Cell; each coverage question is isolated per thread.
const FIRST: ThreadLocal<Cell<Refusal?>> = ThreadLocal.new(fn() { Cell.new(None) })

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/refusal.rs:49
pub fn begin() { FIRST.with(fn(slot) { slot.set(None) }) }
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/refusal.rs:56
pub fn note(what: String, span: Span) {
    FIRST.with(fn(slot) {
        if slot.get().is_none() { slot.set(Val(Refusal{what: what, span: span})) }
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/refusal.rs:68
pub fn describe(cx: &Cx) -> String {
    refusal := FIRST.with(fn(slot) { slot.get() }) ?? return "no construct was recorded"
    (line, column) := span_line_col(cx.src, refusal.span.start.min(cx.src.len()))
    "the {refusal.what} `{snippet(cx.src, refusal.span)}` at {cx.file}:{line}:{column}"
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/refusal.rs:85
fn snippet(src: String, span: Span) -> String {
    start := span.start.min(src.len())
    end := span.end.clamp(start, src.len())
    text := src.get(start..end) ?? return "<span off a character boundary>"
    flat := String.with_capacity(text.len().min(MAX_SNIPPET_CHARS + 4))
    for (taken, ch) in text.chars().enumerate() {
        if taken == MAX_SNIPPET_CHARS { flat.push('…'); break }
        flat.push(if ch.is_control() -> ' ' else -> ch)
    }
    trimmed := flat.trim() // #4303
    if trimmed.is_empty() -> "<empty span>" else -> trimmed.to_string()
}
