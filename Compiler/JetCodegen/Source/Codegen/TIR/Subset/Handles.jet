use jet_foundation.AST.[Expr, Type, CallArg]
use jet_foundation.TIR.THandleOp
use jet_foundation.Diagnostics.[Span, Diagnostic]
use jet_foundation.Syntax as Syntax
use jet_codegen.Codegen.[Cx, is_db_value_type_name, is_json_type_name]
use jet_codegen.Codegen.TIR.[expr_in_subset, lambda_in_subset, unit_type]
use jet_sema.Sema as Sema
use jet_sema.Collections as Collections

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/handles.rs:24
pub fn solve_new_type(receiver: Expr, method: String, cx: Cx, locals: Set<String>) -> String? Never! {
    if method != "new" -> return None
    if receiver == .Field(inner, solver_type, _) && inner == .Ident(alias, _) {
        if locals.contains(alias) || cx.any_core_import_module(alias) != Val(Syntax.CORE_SOLVE_MODULE) -> return None
        if solver_type == Syntax.SOLVER_TYPE -> return Val(solver_type)
    }
    None
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/handles.rs:49
pub fn duration_new_unit(receiver: Expr, method: String, locals: Set<String>) -> String? Never! {
    if receiver == .Ident(type_name, _) {
        if type_name == Syntax.DURATION_TYPE && !locals.contains(type_name) -> return Syntax.duration_unit_for_constructor(method)
    }
    None
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/handles.rs:63
pub fn game_static_type(receiver: Expr, method: String, cx: Cx, locals: Set<String>) -> String? Never! {
    if receiver == .Field(inner, static_type, _) && inner == .Ident(alias, _) {
        if locals.contains(alias) || cx.any_core_import_module(alias) != Val("core.game") -> return None
        if (static_type, method) == {
            ("Scene", "new") | ("Replay", "record") | ("Backend", "headless") -> return Val(static_type)
            else -> {}
        }
    }
    None
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/handles.rs:86
pub fn tls_static_op(receiver: Expr, method: String, cx: Cx, locals: Set<String>) -> THandleOp? Never! {
    if receiver == .Field(inner, static_type, _) && inner == .Ident(alias, _) {
        if locals.contains(alias) || cx.any_core_import_module(alias) != Val("core.net.tls") -> return None
        if (static_type, method) == {
            ("ClientConfig", "default") -> return Val(THandleOp.TLSClientConfigDefault)
            ("RootCertificates", "from_pem") -> return Val(THandleOp.TLSRootCertificatesFromPem)
            ("ClientIdentity", "from_pem") -> return Val(THandleOp.TLSClientIdentityFromPem)
            else -> {}
        }
    }
    None
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/handles.rs:109
pub fn http_client_static_op(receiver: Expr, method: String, cx: Cx, locals: Set<String>) -> THandleOp? Never! {
    if receiver == .Field(inner, static_type, _) && inner == .Ident(alias, _) {
        if locals.contains(alias) || cx.any_core_import_module(alias) != Val("core.http.client") -> return None
        if static_type == "Client" && method == "new" -> return Val(THandleOp.HTTPClientNew)
    }
    None
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/handles.rs:133
pub fn router_register_in_subset(receiver: Expr, args: [CallArg], cx: Cx, locals: Set<String>) -> Bool Never! {
    loop arg in args { if arg.label != None -> return false }
    if !expr_in_subset(receiver, cx, locals) || !expr_in_subset(args[0].expr, cx, locals) -> return false
    if args[1].expr == {
        .Ident(name, _) -> !locals.contains(name)
        .Lambda(lam) -> lambda_in_subset(lam, cx, locals)
        else -> false
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/handles.rs:160
pub fn handle_method_op(source_handle: String, method: String, nargs: Int) -> THandleOp? Never! {
    handle :: if Sema.core_net_handle_dispatch_name(source_handle) == Val(net) {
        if net == "TCPStream" -> "TcpStream"
        else if net == "TCPListener" -> "TcpListener"
        else -> panic("core TCP handle dispatch mapping is closed")
    } else -> Sema.core_file_handle_dispatch_name(source_handle) ?? source_handle
    op :: if (handle, method, nargs) == {
        (Syntax.INTERNAL_RECEIPT_HANDLE, Syntax.METHOD_RECEIPT_ATTACH, 1) -> THandleOp.ReceiptAttach
        ("FileReader", "read_line", 0) -> THandleOp.FileReaderReadLine
        ("MappedFile", "window", 2) -> THandleOp.MappedFileWindow
        ("MappedFile", "window_len", 2) -> THandleOp.MappedFileWindowLen
        ("MappedFile", "lines", 0) -> THandleOp.MappedFileLines
        ("MappedFile", "len", 0) -> THandleOp.MappedFileLen
        ("MappedFile", "is_empty", 0) -> THandleOp.MappedFileIsEmpty
        ("FileWriter", "write_line", 1) -> THandleOp.FileWriterWriteLine
        ("FileWriter", "flush", 0) -> THandleOp.FileWriterFlush
        ("JSONReader", "next", 0) -> THandleOp.JSONReaderNext
        ("JSONWriter", "write", 1) -> THandleOp.JSONWriterWrite
        ("JSONWriter", "flush", 0) -> THandleOp.JSONWriterFlush
        ("JSONWriter", "finish", 0) -> THandleOp.JSONWriterFinish
        ("JSONLReader", "next", 0) -> THandleOp.JSONLReaderNext
        ("JSONLWriter", "write", 1) -> THandleOp.JSONLWriterWrite
        ("JSONLWriter", "flush", 0) -> THandleOp.JSONLWriterFlush
        ("JSONLWriter", "finish", 0) -> THandleOp.JSONLWriterFinish
        ("CSVReader", "next", 0) -> THandleOp.CSVReaderNext
        ("DataStream", "next", 0) -> THandleOp.DataStreamNext
        ("Stream", "with_event_time", 1) -> THandleOp.StreamWithEventTime
        ("StreamEventTime", "key_by", 1) -> THandleOp.StreamKeyBy
        ("KeyedStream", "window", 3) -> THandleOp.StreamWindow
        ("CSVWriter", "write", 1) -> THandleOp.CSVWriterWrite
        ("CSVWriter", "flush", 0) -> THandleOp.CSVWriterFlush
        ("CSVWriter", "finish", 0) -> THandleOp.CSVWriterFinish
        ("XMLReader", "next", 0) -> THandleOp.XMLReaderNext
        ("XMLWriter", "write", 1) -> THandleOp.XMLWriterWrite
        ("XMLWriter", "flush", 0) -> THandleOp.XMLWriterFlush
        ("XMLWriter", "finish", 0) -> THandleOp.XMLWriterFinish
        ("CBORReader", "next", 0) -> THandleOp.CBORReaderNext
        ("CBORWriter", "write", 1) -> THandleOp.CBORWriterWrite
        ("CBORWriter", "flush", 0) -> THandleOp.CBORWriterFlush
        ("CBORWriter", "finish", 0) -> THandleOp.CBORWriterFinish
