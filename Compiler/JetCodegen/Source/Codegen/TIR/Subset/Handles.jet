        ("Reader", "remaining", 0) -> THandleOp.ReaderRemaining
        ("Reader", "is_at_end", 0) -> THandleOp.ReaderAtEnd
        ("Cursor", "take_until", 1) -> THandleOp.CursorTakeUntil
        ("Cursor", "skip_ws", 0) -> THandleOp.CursorSkipWs
        else -> return None
    }
    if handle == Syntax.CLOCK_TYPE || handle == Syntax.RNG_TYPE || handle == "HistoryRNG" || handle == Syntax.FAKE_TYPE || handle == Syntax.SOLVER_TYPE {
        emitted_borrow :: if op == {
            .ClockTick | .ClockAdvance | .ClockWait | .RngInt | .RngFloat | .RngFloatRange
            | .RngBool | .RngBoolP | .RngNormal | .RngExponential | .RngBytes | .RngSplit
            | .RngPick | .RngWeightedPick | .RngSample | .RngShuffle | .HistoryRngNextU64
            | .HistoryRngBelow | .FakeName | .FakeEmail | .FakeHost | .FakeAddress | .SolverRequire -> Collections.BuiltinReceiverBorrow.EagerWrite
            else -> Collections.BuiltinReceiverBorrow.Read
        }
        debug_assert_eq(Collections.builtin_receiver_borrow(Type.Named(handle), method), emitted_borrow)
    }
    Val(op)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/handles.rs:588
pub fn handle_method_return_ty(source_handle: String, method: String, nargs: Int, receiver_ty: Type, resolved_ret: Type?) -> Type Never! {
    handle :: Sema.core_net_handle_dispatch_name(source_handle) ?? (Sema.core_file_handle_dispatch_name(source_handle) ?? source_handle)
    if resolved_ret == Val(ret) -> return ret
    if handle == "HistoryRNG" {
        if (method == "next_u64" && nargs == 0) || (method == "below" && nargs == 1) -> return Type.IntN{signed: false, bits: 64}
        return unit_type()
    }
    if handle == "RealtimeStream" -> return Sema.realtime_stream_method_return(method, nargs).flatten() ?? unit_type()
    if handle == Syntax.DETERMINISTIC_WORLD_TYPE {
        if (method == "now" && nargs == 0) || (method == "advance" && nargs == 1) -> return Type.Int
        if method == "history" && nargs == 0 -> return Type.String
        return unit_type()
    }
    if handle == "TestSuite" && method == "run" && nargs == 0 -> return Type.Int
    span :: Span{start: 0, end: 0}
    sink := [Diagnostic]{}
    // The outer Option distinguishes an unclaimed operation from a claimed void return.
    ret := Type??{None}
    if is_json_type_name(handle) {
        if Sema.datatree_method_return(method, nargs) == Val(ty) -> ret = Val(Val(ty))
    }
    if ret == None -> ret = Sema.file_handle_method_return(handle, method, nargs, span, &sink)
    if ret == None -> ret = Sema.encoding_handle_method_return(handle, method, nargs)
    if ret == None -> ret = Sema.net_method_return(handle, method, nargs, span, &sink)
    if ret == None -> ret = Sema.path_method_return(handle, method, nargs, span, &sink)
    if ret == None {
        if handle == "DBConnection" -> ret = Val(Sema.db_connection_method_return_ty(method))
        else if handle == "DBScope" -> ret = Val(Sema.db_scope_method_return_ty(method))
        else if handle == "DBPool" -> ret = Val(Sema.db_pool_method_return_ty(method))
        else if handle == "ServiceRuntime" {
            if Sema.service_runtime_method_return_ty(method) == Val(ty) -> ret = Val(Val(ty))
        }
    }
    if ret == None && is_db_value_type_name(handle) -> ret = Val(Sema.db_value_method_return(method, nargs))
    if ret == None && Sema.is_reflect_type_name(handle) -> ret = Val(Sema.reflect_method_return(handle, method, nargs))
    if ret == None && (handle == Syntax.TYPE_DECIMAL || handle == Syntax.TYPE_FRACTION || handle == Syntax.DURATION_TYPE) -> ret = Collections.builtin_method_return(receiver_ty, method, nargs, false)
    if ret == None {
        ret = if (handle, method, nargs) == {
            ("MIME", "media_type" | "subtype" | "essence" | "to_string", 0) -> Val(Val(Type.String))
            ("MIME", "param", 1) -> Val(Val(Type.Option(Type.String)))
            ("MIME", "params", 0) -> Val(Val(Type.List(Type.List(Type.String))))
            ("Message", "envelope", 0) -> Val(Val(Type.Named("Envelope")))
            ("Message", "with_envelope", 1) -> Val(Val(Type.Result{ok: Type.Named("Message"), err: Type.Named("EmailError")}))
            ("Mailer", "send", 1) -> Val(Val(Type.Result{ok: Type.Named("SendReport"), err: Type.Named("EmailError")}))
            ("Regex", "pattern" | "source" | "flags" | "options", 0) -> Val(Val(Type.String))
            ("Regex", "names", 0) -> Val(Val(Type.List(Type.String)))
            ("Regex", "count", 1) -> Val(Val(Type.Int))
            ("Regex", "is_match" | "full_match", 1) -> Val(Val(Type.Bool))
            ("Regex", "match", 1) -> Val(Val(Type.Option(Type.Named("Match"))))
            ("Regex", "find", 1) -> Val(Val(Type.Option(Type.String)))
            ("Regex", "replace" | "replace_first", 2) -> Val(Val(Type.String))
            ("Regex", "split_limit", 2) -> Val(Val(Type.List(Type.String)))
            ("Match", "group" | "name", 1) -> Val(Val(Type.Option(Type.String)))
            ("Match", "start" | "end", 0) -> Val(Val(Type.Int))
            ("Match", "named_captures", 0) -> Val(Val(Type.List(Type.List(Type.String))))
            ("Match", "group_start" | "group_end", 1) -> Val(Val(Type.Option(Type.Int)))
            else -> None
        }
    }
    if ret == None -> ret = Sema.binary_reader_method_return(handle, method, nargs)
    if ret == None -> ret = Sema.text_cursor_method_return(handle, method, nargs)
    if ret == None && handle == Syntax.SOLVER_TYPE -> ret = Collections.builtin_method_return(receiver_ty, method, nargs, false)
    if ret == None {
        ret = if (handle, method, nargs) == {
            ("GameAssets", "image", 1) -> Val(Val(Type.Result{ok: Type.Named("GameImage"), err: Type.String}))
            ("GameAssets", "sound", 1) -> Val(Val(Type.Result{ok: Type.Named("GameSound"), err: Type.String}))
            ("GameScene", "query", 1) -> Val(Val(Type.List(Type.String)))
            ("GameInputSnapshot", "pressed", 1) | ("GameBackend", "should_continue", 0) -> Val(Val(Type.Bool))
            ("GameBackend", "present", 0) -> Val(None)
            ("GameScene", "on_frame" | "component", 1) | ("GameInputMap", "bind", 2) -> Val(None)
            else -> None
        }
    }
    if ret == Val(Val(ty)) -> ty else -> unit_type()
}
// Rust: crates/jet-codegen/src/Codegen/TIR/subset/handles.rs:752
pub fn core_closure_call_return_ty(module: String, method: String, body_ty: Type) -> Type Never! {
    if (module, method) == {
        ("core.tasks", "spawn") -> Type.Apply{name: "Task", args: [Type]{body_ty}}
        ("core.mem.scope", "guard") -> Type.Named("ScopeGuard")
        ("core.reactive", "effect") -> Type.Named(Syntax.TYPE_EFFECT)
        else -> unit_type()
    }
}
