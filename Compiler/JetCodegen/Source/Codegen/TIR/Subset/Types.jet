//RS     let Type::Apply { name, args } = ty else {
//RS         return false;
//RS     };
//RS     // The base must be a known struct (not an enum/trait/core/prelude type). Local
//RS     // and imported user structs are both registered in `cx.struct_fields`.
//RS     if !cx.struct_fields.contains_key(name) {
//RS         return false;
//RS     }
//RS     if !struct_is_covered(name, cx, &mut HashSet::new()) {
//RS         return false;
//RS     }
//RS     // Every type argument is a covered value type or a bare type variable (`T`).
//RS     // c148: pass cx so multi-char type params are recognized.
//RS     args.iter()
//RS         .all(|a| is_type_var_param_ty(a, cx) || is_subset_param_ty(a, cx))
