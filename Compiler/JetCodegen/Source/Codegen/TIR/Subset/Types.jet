use jet_foundation.[Type, atomic_scalar_type]
use jet_codegen.[Cx, is_covered_enum_ty, is_covered_struct_ty, struct_is_covered, alloc_handle_rust_type, core_rust_type_name, file_handle_rust_type, is_json_type_name, layout_handle_rust_type, net_handle_rust_type, root_prelude_rust_type_name, service_handle_rust_type]
use jet_syntax.[TYPE_KEY, TYPE_ORDERING, TYPE_TASKGROUP, TYPE_CONDITION, TYPE_NEVER, TYPE_PIN, TYPE_SHARED_GUARD, TYPE_SHARED_WEAK, TYPE_BITS, TYPE_BYTES, TYPE_SET, TYPE_RANK, TYPE_PRIORITY_QUEUE, TYPE_TALLY, TYPE_LRU, TYPE_ERR]
use jet_generics.[is_type_var_name]

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:20
// Resolve only literal Self; other types pass through with the Rust-owned result.
pub fn resolve_self_ty(ty: @Type, type_name: String) -> Type Never! {
    if ty == { .Named(name) if name == "Self" -> Type.Named(~type_name) else -> ~ty }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:34
pub fn is_subset_param_ty(input: @Type, cx: @Cx) -> Bool Never! {
    ty :: cx.expand_type_aliases(input)
    if ty == .Tagged(_, inner) -> return is_subset_param_ty(inner, cx)
    if ty == .Named(name) {
        if name == TYPE_KEY || name == TYPE_ORDERING || name == TYPE_TASKGROUP || name == TYPE_CONDITION || name == TYPE_NEVER || name == "DataEvent" -> return true
        if is_json_type_name(name) -> return true
        if (if name == {
            "KeyStatus" | "VaultError" | "WrappedVaultKey" | "KeyUnlock" | "KeyWrapError" | "HTTPHandler"
            | "Effect" | "UINode" | "Subscription" | "EventScope" | "EventPolicy" | "EventTrace" | "AsyncPolicy" | "HookPolicy"
            | "Overflow" | "FailurePolicy" | "DispatchState" | "EventConfigError"
            | "App" | "WebPage" | "DevServer" | "HTTPServerTLS"
            | "EventResult" | "NullBackend" | "TUIBackend" | "GtkBackend"
            | "Point" | "Size" | "Rect" | "SizeConstraint" | "AriaRole" | "InputEvent"
            | "UIPreview" | "UIPreviewRegistry" | "UIPreviewAccessibility" | "UIPreviewAuthority" | "UIPreviewContext"
            | "UIPreviewDevice" | "UIPreviewEffect" | "UIPreviewInputOverride" | "UIPreviewInputValue" | "UIPreviewKind" | "UIPreviewLifecycle"
            | "UIPreviewSource" | "UIPreviewTheme" | "UIPreviewTraits" | "UIPreviewViewport" | "LateEventDisposition"
            | "WebFormFieldState" | "WebFormTyped" | "WebTableState" | "WebVirtualPlan" | "WebTableSort" | "WebTableFilter"
            | "WebFormStatus" | "WebFormLifecycle" | "WebFormValidationTiming" | "WebTableSortDirection" | "WebTablePageMode" -> true
            else -> false
        }) -> return true
    }
    if ty == .Apply(name, args) {
        if (name == "WebTablePage" || name == "WebTable" || name == "WebTableColumn" || name == "WebTableRow") && args.len() == 1 && is_subset_param_ty(@args[0], cx) -> return true
    }
    if ty == .Union(members) -> return !members.is_empty() && members.iter().all(fn(member) { is_subset_param_ty(member, cx) })
    ty.is_scalar() || ty == Type.Char || ty == Type.String
        || is_type_var_param_ty(@ty, cx)
        || is_covered_trait_object_ty(@ty, cx)
        || is_covered_distinct_ty(@ty, cx)
        || is_covered_tuple_ty(@ty, cx)
        || is_covered_struct_ty(@ty, cx)
        || is_covered_enum_ty(@ty, cx)
        || is_covered_collection_ty(@ty, cx)
        || is_covered_view_ty(@ty, cx)
        || is_covered_expanded_collection_ty(@ty, cx)
        || is_covered_fallible_ty(@ty, cx)
        || is_covered_fn_ty(@ty, cx)
        || is_covered_foreign_value_ty(@ty, cx)
        || is_covered_generic_struct_ty(@ty, cx)
        || is_covered_concurrency_ty(@ty, cx)
        || is_covered_reactive_ty(@ty, cx)
        || is_covered_event_ty(@ty, cx)
        || is_covered_shared_ty(@ty, cx)
        || is_covered_shared_guard_ty(@ty, cx)
        || is_covered_shared_weak_ty(@ty, cx)
        || is_covered_atomic_ty(@ty)
        || is_covered_pool_ty(@ty, cx)
        || is_covered_cell_ty(@ty, cx)
        || is_covered_data_ty(@ty, cx)
        || is_covered_compute_ty(@ty)
        || is_covered_vault_ty(@ty, cx)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:146
pub fn is_covered_atomic_ty(ty: @Type) -> Bool Never! {
    if ty == { .Apply(name, args) -> name == "Atomic" && args.len() == 1 && atomic_scalar_type(@args[0]) else -> false }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:159
// Unit is only a callable result, not a parameter or binding value.
pub fn is_subset_return_ty(ty: @Type, cx: @Cx) -> Bool Never! {
    (if ty == { .Named(name) -> name == "Unit" else -> false }) || is_subset_param_ty(ty, cx)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:166
pub fn is_covered_compute_ty(ty: @Type) -> Bool Never! { ty.is_compute_tensor_family() }

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:170
fn is_covered_vault_ty(ty: @Type, cx: @Cx) -> Bool Never! {
    if ty == {
        .Apply(name, args) -> (name == "ExpiringSecret" || name == "KeyRef" || name == "MutationPlan" || name == "VaultWrite" || name == "Rotation" || name == "WrappedImportPlan") && args.len() == 1 && is_subset_param_ty(@args[0], cx)
        else -> false
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:179
// Sema already proved view/Pin provenance; only element representation is gated.
fn is_covered_view_ty(ty: @Type, cx: @Cx) -> Bool Never! {
    if ty == {
        .Apply(name, args) -> (name == "View" || name == "ViewMut" || name == "ComputeViewMut" || name == TYPE_PIN) && args.len() == 1 && ((if args[0] == { .Named(inner) -> inner == "str" else -> false }) || is_subset_param_ty(@args[0], cx))
        else -> false
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:192
pub fn is_covered_event_ty(ty: @Type, cx: @Cx) -> Bool Never! {
    if ty == .Apply(name, args) {
        return if name == {
            "Event" | "DispatchReport" | "DispatchFailure" -> args.len() == 1 && is_subset_param_ty(@args[0], cx)
            "Hook" | "DecisionHook" | "HookDecision" | "HookOutcome" | "AsyncEvent" -> args.len() == 2 && args.iter().all(fn(arg) { is_subset_param_ty(arg, cx) })
            else -> false
        }
    }
    false
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:210
pub fn is_covered_data_ty(ty: @Type, cx: @Cx) -> Bool Never! {
    if ty == .Apply(name, args) {
        return if name == {
            "Query" -> args.len() == 1 && is_subset_param_ty(@args[0], cx)
            "DataGroupedQuery" | "Group" | "DataJoin" -> args.len() == 2 && args.iter().all(fn(arg) { is_subset_param_ty(arg, cx) })
            else -> false
        }
    }
    false
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:229
pub fn is_covered_pool_ty(ty: @Type, cx: @Cx) -> Bool Never! {
    if ty == .Apply(name, args) {
        elem :: args.first() ?? return false
        return if name == {
            // ID does not embed T. Recursing would loop on Node{parent: ID<Node>?}.
            "ID" -> if elem == { .Named(n) -> cx.type_names.contains(n) else -> false }
            "Pool" -> concurrency_elem_covered(elem, cx)
            else -> false
        }
    }
    false
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:254
pub fn is_covered_cell_ty(ty: @Type, cx: @Cx) -> Bool Never! {
    if ty == { .Apply(name, args) -> (name == "Cell" || name == "CellReadGuard" || name == "CellEditGuard") && args.len() == 1 && is_subset_param_ty(@args[0], cx) else -> false }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:278
pub fn is_covered_shared_ty(ty: @Type, cx: @Cx) -> Bool Never! {
    if ty == { .Shared(inner) -> is_subset_param_ty(inner, cx) else -> false }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:282
pub fn is_covered_shared_guard_ty(ty: @Type, cx: @Cx) -> Bool Never! {
    if ty == { .Apply(name, args) -> name == TYPE_SHARED_GUARD && args.len() == 1 && is_subset_param_ty(@args[0], cx) else -> false }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:292
pub fn is_covered_shared_weak_ty(ty: @Type, cx: @Cx) -> Bool Never! {
    if ty == .Apply(name, args) {
        if name != TYPE_SHARED_WEAK || args.len() != 1 -> return false
        if args[0] == .Named(n) { if cx.struct_fields.contains_key(n) -> return true }
        // A weak user-struct handle is sized independently of that struct's fields.
        return is_subset_param_ty(@args[0], cx)
    }
    false
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:321
pub fn is_covered_concurrency_ty(ty: @Type, cx: @Cx) -> Bool Never! {
    if ty == .Apply(name, args) {
        return if name == {
            "Task" | "Receiver" | "Sender" | "Stream" | "StreamEventTime" -> args.len() == 1 && concurrency_elem_covered(@args[0], cx)
            "KeyedStream" | "Window" -> args.len() == 2 && args.iter().all(fn(arg) { concurrency_elem_covered(arg, cx) })
            else -> false
        }
    }
    false
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:343
pub fn is_covered_reactive_ty(ty: @Type, cx: @Cx) -> Bool Never! {
    if ty == { .Apply(name, args) -> (name == "Signal" || name == "Derived" || name == "Computed") && args.len() == 1 && is_subset_param_ty(@args[0], cx) else -> false }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:352
pub fn is_covered_expanded_collection_ty(ty: @Type, cx: @Cx) -> Bool Never! {
    if ty == {
        .Named(name) -> name == TYPE_BITS || name == TYPE_BYTES
        .Apply(name, args) if name == TYPE_SET || name == TYPE_RANK || name == TYPE_PRIORITY_QUEUE || name == TYPE_TALLY -> args.len() == 1 && is_subset_param_ty(@args[0], cx)
        .Apply(name, args) if name == TYPE_LRU -> args.len() == 2 && is_subset_param_ty(@args[0], cx) && is_subset_param_ty(@args[1], cx)
        else -> false
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:385
pub fn concurrency_elem_covered(ty: @Type, cx: @Cx) -> Bool Never! {
    (if ty == { .Named(name) -> name == "Unit" else -> false }) || is_subset_param_ty(ty, cx)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:399
pub fn is_covered_generic_struct_ty(ty: @Type, cx: @Cx) -> Bool Never! {
    if ty == .Apply(name, args) {
        if !cx.struct_fields.contains_key(name) -> return false
        seen := [String: Bool]{}
        if !struct_is_covered(name, cx, &seen) -> return false
        return args.iter().all(fn(arg) { is_type_var_param_ty(arg, cx) || is_subset_param_ty(arg, cx) })
    }
    false
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:427
pub fn is_covered_distinct_ty(ty: @Type, cx: @Cx) -> Bool Never! {
    if ty == { .Named(name) -> cx.is_distinct_type_name(name) else -> false }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:440
pub fn is_covered_tuple_ty(ty: @Type, cx: @Cx) -> Bool Never! {
    if ty == { .Tuple(fields) -> !fields.is_empty() && fields.iter().all(fn(field) { is_subset_param_ty(@field.ty, cx) }) else -> false }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:457
pub fn is_type_var_param_ty(ty: @Type, cx: @Cx) -> Bool Never! {
    if ty == { .Named(name) -> is_type_var_name(name) || cx.current_type_params.borrow().contains(name) else -> false }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:474
// Canonical, alias-qualified and bare spellings all use the shared import resolver.
pub fn foreign_type_module(name: String, cx: @Cx) -> @String? Never! {
    if cx.foreign_types.get(name) == Val(module) -> return Val(module)
    identity :: cx.imported_type_metadata_name(name) ?? return None
    cx.foreign_types.get(identity)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:493
pub fn is_covered_foreign_value_ty(ty: @Type, cx: @Cx) -> Bool Never! {
    if ty == .Named(name) {
        if foreign_type_module(name, cx).is_some() -> return true
        if (if name == {
            "Match" | "Claims" | "AuthError" | "Session" | "Auth" | "SyncText" | "SyncCounter" | "SyncMap" | "SyncList" | "RowPolicy" | "LiveQuery" | "DBScope"
            | "Secret" | "SigningKey" | "VerifyKey" | "X25519SecretKey" | "X25519PublicKey" | "SharedSecret"
            | "Signature" | "Sealed" | "WrappedKey" | "PasswordHash" | "Digest256" | "Digest512" | "CryptoError" | "FileCryptoError" | "KeyWrapError" -> true
            else -> false
        }) -> return true
        if !cx.type_names.contains(name) && (name == "FontStyle" || name == "FontFace" || name == "Glyph" || name == "GlyphRun" || name == "GlyphShaper") -> return true
        return is_prelude_struct_name(name)
            || core_rust_type_name(name).is_some()
            || root_prelude_rust_type_name(name).is_some()
            || service_handle_rust_type(name).is_some()
            || cx.core_qualified_rust_type_name(name).is_some()
            || file_handle_rust_type(name).is_some()
            || net_handle_rust_type(name).is_some()
            || alloc_handle_rust_type(name).is_some()
            || layout_handle_rust_type(name).is_some()
    }
    false
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:584
pub fn is_prelude_struct_name(name: String) -> Bool Never! {
    if name == {
        "Err" | "HTTPRequest" | "HTTPResponse" | "Range" | "TextWidth" | "TerminalSize" | "TerminalPolicy" | "DataLineOptions"
        | "AsyncPolicy" | "FieldError" | "EncodingLimits" | "EncodingCause" | "EncodingError"
        | "CBOROptions" | "CBORError" | "XMLLimits" | "XMLParseOptions" | "XMLRenderOptions" | "XMLCanonical" | "XMLError"
        | "RecipientReport" | "SendReport" | "Limits" | "DKIMConfig" | "SMTPConfig" | "WebFormFieldSpec" | "ModGrant" -> true
        else -> false
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:614
pub fn foreign_struct_lit_in_subset(type_name: String, type_args: @[Type], import_ns: String?, cx: @Cx) -> Bool Never! {
    alias :: import_ns ?? ""
    qualified :: cx.foreign_type_identity(alias, type_name) ?? return false
    if import_ns == Val(alias) {
        import_mod :: cx.import_mods.get(alias) ?? return false
        if cx.foreign_types.get(qualified) != Val(import_mod) -> return false
    }
    if !cx.struct_fields.contains_key(qualified) -> return false
    type_args.iter().all(fn(arg) { is_type_var_param_ty(arg, cx) || is_subset_param_ty(arg, cx) })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:647
pub fn is_covered_fn_ty(ty: @Type, cx: @Cx) -> Bool Never! {
    if ty == {
        .Fn{params, ret, ..} -> params.iter().all(fn(param) { is_subset_param_ty(param, cx) }) && (if ret == { Val(value) -> is_subset_param_ty(value, cx) None -> true })
        else -> false
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:669
pub fn is_covered_trait_object_ty(ty: @Type, cx: @Cx) -> Bool Never! {
    if ty == {
        .TraitObject(bounds) -> bounds.iter().all(fn(name) { cx.trait_names.contains(name) })
        .Named(name) -> cx.trait_names.contains(name)
        else -> false
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:685
pub fn is_covered_fallible_ty(ty: @Type, cx: @Cx) -> Bool Never! {
    if ty == {
        .Option(inner) -> fallible_payload_covered(inner, cx)
        .Result(ok, err) -> fallible_payload_covered(ok, cx) && fallible_payload_covered(err, cx)
        else -> false
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:700
pub fn fallible_payload_covered(ty: @Type, cx: @Cx) -> Bool Never! {
    if ty == .Option(inner) -> return fallible_payload_covered(inner, cx)
    if is_type_var_param_ty(ty, cx) -> return true
    if ty == .Union(members) -> return !members.is_empty() && members.iter().all(fn(member) { fallible_payload_covered(member, cx) })
    if ty == .Named(name) {
        if name == "Unit" || name == TYPE_NEVER || name == TYPE_ERR || name == "CryptoError" || name == "ComputeError" || name == "Closed" || name == "Match" -> return true
    }
    ty.is_scalar() || ty == Type.Char || ty == Type.String
        || is_covered_distinct_ty(ty, cx)
        || is_covered_struct_ty(ty, cx)
        || is_covered_enum_ty(ty, cx)
        || is_covered_generic_struct_ty(ty, cx)
        || is_covered_collection_ty(ty, cx)
        || is_covered_view_ty(ty, cx)
        || is_covered_data_ty(ty, cx)
        || is_covered_foreign_value_ty(ty, cx)
        || is_covered_pool_ty(ty, cx)
        || is_covered_shared_ty(ty, cx)
        || is_covered_shared_guard_ty(ty, cx)
        || is_covered_shared_weak_ty(ty, cx)
        || is_covered_compute_ty(ty)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:802
pub fn is_covered_collection_ty(ty: @Type, cx: @Cx) -> Bool Never! {
    if ty == {
        .List(inner) -> collection_elem_covered(inner, cx)
        .FixedList{elem, ..} -> collection_elem_covered(elem, cx)
        .Map{key, value, ..} -> collection_elem_covered(key, cx) && collection_elem_covered(value, cx)
        else -> false
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/subset/types.rs:816
pub fn collection_elem_covered(ty: @Type, cx: @Cx) -> Bool Never! {
    ty.is_scalar() || ty == Type.Char || ty == Type.String
        || (if ty == { .Named(name) -> name == "UINode" else -> false })
        || is_type_var_param_ty(ty, cx)
        || is_covered_tuple_ty(ty, cx)
        || is_covered_distinct_ty(ty, cx)
        || is_covered_struct_ty(ty, cx)
        || is_covered_enum_ty(ty, cx)
        || is_covered_collection_ty(ty, cx)
        || is_covered_view_ty(ty, cx)
        || is_covered_concurrency_ty(ty, cx)
        || is_covered_trait_object_ty(ty, cx)
        || is_covered_foreign_value_ty(ty, cx)
        || is_covered_pool_ty(ty, cx)
        || is_covered_shared_ty(ty, cx)
        || is_covered_shared_guard_ty(ty, cx)
        || is_covered_shared_weak_ty(ty, cx)
}
