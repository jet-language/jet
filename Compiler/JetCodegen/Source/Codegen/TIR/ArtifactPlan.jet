//RS /// Lower a top-level `#FFI(c)`, `#FFI(cpp)`, or `#FFI(asm)` function to the
//RS /// native bridge symbol emitted by the prepared FFI crate. The call expression
//RS /// retains the wrapper identity (`jet_ffi_<name>`); MIR uses this row to resolve
//RS /// that identity to the checked bridge symbol (`jet_inline_jet_ffi_<name>`).
//RS fn lower_inline_c_foreign(
//RS     function: &Func,
//RS     module: &str,
//RS     target: TirArtifactTarget,
//RS ) -> Option<TirForeignFact> {
//RS     let inline = function.inline_foreign.as_ref()?;
//RS     let language = inline.lang.to_ascii_lowercase();
//RS     if !matches!(language.as_str(), "c" | "asm" | "cpp") {
//RS         return None;
//RS     }
//RS     let wrapper = format!("jet_ffi_{}", function.name);
//RS     let applicability = if matches!(target, TirArtifactTarget::Web) {
//RS         // The native bridge has no browser provider. Keep this fact explicit so
//RS         // Web cannot silently fall back to AOT or resident native execution.
//RS         TirTargetApplicability::default()
//RS     } else {
//RS         target_applicability_for(target)
//RS     };
//RS     Some(TirForeignFact {
//RS         key: wrapper.clone(),
//RS         module: module.to_string(),
//RS         name: function.name.clone(),
//RS         span: function.span,
//RS         symbol: format!("jet_inline_{wrapper}"),
//RS         path: wrapper,
//RS         params: lower_params(&function.params),
//RS         bridge_eligible: true,
//RS         raw_scalar_abi: true,
//RS         return_type: function.return_type.clone(),
//RS         abi: "C".to_string(),
//RS         language,
//RS         applicability,
//RS         effect_root: None,
//RS         callback_transport: None,
//RS         callback_plan_digest: None,
//RS         callback_identity: None,
//RS         link_key: None,
//RS         callback_key: None,
//RS         handle_key: None,
//RS         close_function_key: None,
//RS         undo_function_key: None,
//RS     })
//RS }
//RS /// Lower one per-callable `#Import(c)` declaration into the same foreign row
//RS /// used by its generated C ABI wrapper.  The expression lowering keeps the
//RS /// wrapper identity as the MIR foreign key; omitting this row leaves a
//RS /// checked `ExternCall` pointing at an unregistered foreign ID.
//RS fn lower_guest_import_foreign(
//RS     function: &Func,
