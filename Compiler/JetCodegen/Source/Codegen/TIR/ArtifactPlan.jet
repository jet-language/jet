// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:1281
fn lower_c_foreign(function: &jet_foundation.AST.ExternFn, module: String, lib: String, handles: &[FfiHandleFact], target: TirArtifactTarget) -> TirForeignFact {
    function_key := key(module, function.name)
    handle_key := None
    if function.return_type == .Val(ty) {
        if ty == .Named(name) {
            if handles.iter().any(fn(handle) { handle.lib == lib && handle.jet_name == name }) -> handle_key = Val("c::{lib}::{name}")
        }
    }
    if handle_key == None {
        loop param in function.params {
            if param.ty == .Named(name) {
                if handles.iter().any(fn(handle) { handle.lib == lib && handle.jet_name == name }) {
                    handle_key = Val("c::{lib}::{name}")
                    break
                }
            }
        }
    }
    abi := if function.abi == .Val((abi, _)) -> abi else -> "C"
    close_key := if function.close == .Val((name, _)) -> Val(key(module, name)) else -> None
    undo_key := if function.undo == .Val((name, _)) -> Val(key(module, name)) else -> None
    TirForeignFact{key: function_key, module: module, name: function.name, span: function.span, symbol: function.rust_path, path: function.rust_path, params: lower_params(function.params), bridge_eligible: function.hidden_c_bridge_compatible_with_handles(handles), raw_scalar_abi: false, return_type: function.return_type, abi: abi, language: "c", applicability: target_applicability_for(target), effect_root: function.effect_root, callback_transport: function.callback_transport, callback_plan_digest: function.callback_plan_digest, callback_identity: function.callback_identity, link_key: Val("c::{lib}"), callback_key: None, handle_key: handle_key, close_function_key: close_key, undo_function_key: undo_key}
