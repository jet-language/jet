// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:1707
fn lower_links(bundle: &ProgramBundle, target: TirArtifactTarget) -> [TirLinkUnit] {
    cache_identity := bundle.cffi.link_closure.stable_key()
    applicability := target_applicability_for(target)
    links := loop lib in bundle.cffi.libs -> TirLinkUnit{key: "c::{lib.lib}", crate_spec: lib.lib, cache_identity: cache_identity, applicability: applicability, dependency_dirs: [String]{}, link_closure: bundle.cffi.link_closure.libraries().collect()}
    if links.is_empty() && !cache_identity.is_empty() -> &links.push(TirLinkUnit{key: "c::closure", crate_spec: "c", cache_identity: cache_identity, applicability: applicability, dependency_dirs: [String]{}, link_closure: bundle.cffi.link_closure.libraries().collect()})
    links
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:1746
fn lower_callbacks(bundle: &ProgramBundle, facts: &TirArtifactFacts) -> [TirCallbackFact] {
    functions := [String:Int]{}
    loop (index, function) in facts.functions.iter().enumerate() -> _ := &functions.insert(function.reference.key, index)
    names := bundle.ffi_callback_fns.iter().collect()
    &names.sort()
    rows := [TirCallbackFact]{}
    loop name in names {
        if functions.get(name) == .Val(index) {
            function := facts.functions[index]
            &rows.push(TirCallbackFact{key: "{function.reference.key}::callback", symbol: function.reference.key, function: function.reference, params: function.params, return_type: function.return_type})
        }
    }
    rows
