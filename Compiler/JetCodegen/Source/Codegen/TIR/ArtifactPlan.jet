// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:1837
fn lower_coverage_points(facts: &TirArtifactFacts) -> [TirCoveragePoint] {
    rows := [TirCoveragePoint]{}
    seen := Set<String>{}
    loop test in facts.tests {
        row_key := "{test.key}::coverage::entry"
        if &seen.insert(row_key) -> &rows.push(TirCoveragePoint{key: row_key, function: test.function, block: Val("entry"), span: test.span})
    }
    loop function in facts.functions {
        row_key := "{function.reference.key}::coverage::entry"
        if &seen.insert(row_key) -> &rows.push(TirCoveragePoint{key: row_key, function: function.reference, block: Val("entry"), span: function.reference.span})
    }
    rows
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:1865
fn lower_harness(facts: &TirArtifactFacts) -> TirHarnessPlan? {
    if facts.tests.is_empty() && facts.output_checks.is_empty() && facts.coverage_points.is_empty() -> return None
    kind := if facts.tests.is_empty() && facts.output_checks.is_empty() -> TirHarnessKind.Coverage else -> TirHarnessKind.Test
    tests := loop test in facts.tests -> test.key
    Val(TirHarnessPlan{key: "{facts.package_identity}::harness::{kind:?}", kind: kind, tests: tests, output_checks: facts.output_checks, selected_test: None, coverage_points: facts.coverage_points, command_override: false})
}

// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:1886
fn lower_exports(bundle: &ProgramBundle, facts: &TirArtifactFacts, kind: TirArtifactKind) -> [TirExport] {
    surface := if kind == {
        .NativeLibrary -> jet_sema.guest_export_surface(bundle)
        .SandboxPlugin -> jet_sema.sandbox_export_surface(bundle)
        .NativeExecutable | .WebApplication | .TestExecutable | .FuzzExecutable | .TestOverride -> []
    }
    rows := [TirExport]{}
    loop export in surface {
        if kind != TirArtifactKind.SandboxPlugin && export.scalar == None -> continue
        if facts.functions.iter().find(fn(function) { function.reference.name == export.name }) == .Val(function) {
            &rows.push(TirExport{symbol: export.name, function: function.reference, abi: TirExportAbi.C})
        }
    }
    rows
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:1920
fn lower_artifact_plan(bundle: &ProgramBundle, target: TirArtifactTarget, facts: &TirArtifactFacts) -> TirArtifactPlan {
    entry := facts.entry
    output_kind := if entry == .Val(entry) -> Val(entry.output_kind) else -> None
    kind := if output_kind == {
        .Val(.Library) -> TirArtifactKind.NativeLibrary
        .Val(.Service) -> TirArtifactKind.WebApplication
        .Val(.Check) -> TirArtifactKind.TestExecutable
        else -> if target == TirArtifactTarget.Web -> TirArtifactKind.WebApplication else -> TirArtifactKind.NativeExecutable
    }
    dossier := bundle.build_facts.target_dossier
    modules := loop module in facts.modules -> module.key
    links := loop link in facts.links -> link.key
    jobs := loop job in facts.jobs -> job.key
    harness := if facts.harnesses.first() == .Val(harness) -> Val(harness.key) else -> None
    TirArtifactPlan{key: "{facts.package_identity}::artifact::{target:?}", kind: kind, name: facts.package_identity, target: target, modules: modules, links: links, jobs: jobs, runtime_parts: bundle.used_core.iter().collect(), exports: lower_exports(bundle, facts, kind), provider_identity: dossier.provider_identity, closure_identity: dossier.closure_identity, artifact_identity: "{dossier.compiler_identity}:{dossier.environment_identity}:{bundle.build_facts.target_triple}", entry: entry, harness: harness}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:1965
fn lower_tir_artifact_facts_for_request(bundle: &ProgramBundle, request: MirArtifactRequest, contract_rows: &ContractSamplingPlan) -> TirArtifactFacts {
    target := request.target
    kind := request.kind
    mode := request.mode
    name := request.name
    facts := lower_tir_artifact_facts_for_target(bundle, target, contract_rows)
    facts.build_mode = mode
    if name == .Val(name) {
        if !facts.artifacts.is_empty() -> facts.artifacts[0].name = name
    }
    exports := lower_exports(bundle, facts, kind)
    if !facts.artifacts.is_empty() {
        facts.artifacts[0].kind = kind
        facts.artifacts[0].exports = exports
    }
    if kind == TirArtifactKind.TestExecutable || kind == TirArtifactKind.FuzzExecutable {
        facts.entry = None
        if !facts.artifacts.is_empty() -> facts.artifacts[0].entry = None
    }
    if mode == MirArtifactBuildMode.Fuzz {
        if !facts.harnesses.is_empty() {
            facts.harnesses[0].kind = TirHarnessKind.Fuzz
            selected_test := None
            if name == .Val(name) {
                if facts.tests.iter().find(fn(test) { test.name == name }) == .Val(test) -> selected_test = Val(test.key)
            }
            facts.harnesses[0].selected_test = selected_test
            facts.harnesses[0].key = "{facts.package_identity}::harness::{facts.harnesses[0].kind:?}"
        }
        if !facts.artifacts.is_empty() -> facts.artifacts[0].harness = if facts.harnesses.first() == .Val(harness) -> Val(harness.key) else -> None
    }
    if kind == TirArtifactKind.TestOverride && mode == MirArtifactBuildMode.Test {
        module := module_identity(bundle, bundle.entry)
        if facts.functions.iter().find(fn(function) { function.reference.module == module && function.reference.name == "test" }) == .Val(function) {
            entry := TirEntrySpec{kind: TirArtifactEntryKind.Test, function: Val(function.reference), cli: None, output: TirEntryOutput.ReturnValue, output_kind: OutputKind.Check, initialize_environment: initialize_environment(bundle, target), initialize_gc: false, serves_until_stopped: false, package_version: bundle.build_facts.package_version}
            facts.entry = Val(entry)
            if !facts.harnesses.is_empty() -> facts.harnesses[0].command_override = true
            if !facts.artifacts.is_empty() {
                facts.artifacts[0].entry = Val(entry)
                facts.artifacts[0].harness = if facts.harnesses.first() == .Val(harness) -> Val(harness.key) else -> None
            }
        }
    }
    facts
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:2053
fn lower_tir_artifact_facts_for_target(bundle: &ProgramBundle, target: TirArtifactTarget, contract_rows: &ContractSamplingPlan) -> TirArtifactFacts {
    package_identity := bundle.build_facts.package_name
    facts := TirArtifactFacts{package_identity: package_identity, package_version: bundle.build_facts.package_version, target: target, build_mode: MirArtifactBuildMode.Dev, build: bundle.build_facts, names: lower_names(bundle), functions: [], modules: [], imports: [], foreign: [], links: [], callbacks: [], handles: [], entry: None, cli: None, jobs: [], tests: [], output_checks: [], coverage_points: [], harnesses: [], artifacts: [], cffi: lower_cffi(bundle)}
    loop (module_index, module) in bundle.modules.iter().enumerate() {
        identity := module_identity(bundle, module_index)
        imports := loop import in module.imports -> key(identity, import.alias)
        order := module.items.iter().filter_map(fn(item) { item_ref(identity, item) }).collect()
        &facts.modules.push(TirModuleFact{key: identity, name: module.alias, path: module.display, source_path: module.display, imports: imports, item_order: order})
        collect_imports(bundle, module_index, identity, &facts.imports)
        collect_items(bundle, module_index, identity, module.items, &facts, target, contract_rows)
    }
    facts.links = lower_links(bundle, target)
    facts.handles = facts.cffi.handle_facts
    (cli, entry) := lower_cli_and_entry(bundle, target)
    facts.cli = cli
    facts.entry = entry
    facts.output_checks = lower_output_checks(bundle, facts)
    facts.coverage_points = lower_coverage_points(facts)
    if lower_harness(facts) == .Val(harness) -> &facts.harnesses.push(harness)
    plan := lower_artifact_plan(bundle, target, facts)
    &facts.artifacts.push(plan)
    facts.callbacks = lower_callbacks(bundle, facts)
    facts
}

