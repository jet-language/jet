// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:1443
fn collect_items(bundle: &ProgramBundle, module_index: Int, module: String, items: &[Item], facts: &TirArtifactFacts, target: TirArtifactTarget, contract_rows: &ContractSamplingPlan) {
    loop item in items {
        reference := item_ref(module, item)
        if item == {
            .Func(function) -> {
                if lower_guest_import_foreign(function, module, bundle.modules[module_index].alias, target) == .Val(foreign) -> &facts.foreign.push(foreign)
                if lower_inline_c_foreign(function, module, target) == .Val(foreign) -> &facts.foreign.push(foreign)
                push_function(&facts, module, function, function.name)
                if lower_job(bundle, function, module) == .Val(job) -> &facts.jobs.push(job)
                if lower_contract_test(function, module, contract_rows) == .Val(test) -> &facts.tests.push(test)
            }
            .Struct(definition) -> {
                loop function in definition.methods -> push_function(&facts, module, function, "{definition.name}::{function.name}")
                loop implementation in definition.trait_impls {
                    loop function in implementation.methods {
                        push_function(&facts, module, function, method_reference_name(definition.name, Val(implementation.trait_name), implementation.operator_rhs, function))
                    }
                }
            }
            .Enum(definition) -> {
                loop function in definition.methods -> push_function(&facts, module, function, "{definition.name}::{function.name}")
                loop implementation in definition.trait_impls {
                    loop function in implementation.methods {
                        push_function(&facts, module, function, method_reference_name(definition.name, Val(implementation.trait_name), implementation.operator_rhs, function))
                    }
                }
            }
            .Impl(implementation) -> {
                loop function in implementation.methods {
                    name := method_reference_name(implementation.type_name, implementation.trait_name, implementation.operator_rhs, function)
                    push_function(&facts, module, function, name)
                }
            }
            .Test(test) -> &facts.tests.push(lower_test(test, module))
            .ExternRust(block) -> {
                loop function in block.functions -> &facts.foreign.push(lower_foreign(function, module, block.crate_spec, target))
            }
            .CModule(c_module) -> {
                loop function in c_module.functions -> &facts.foreign.push(lower_c_foreign(function, module, c_module.lib, bundle.cffi.handle_facts, target))
            }
            .CodeModule(code_module) -> {
                if code_module.body == .Val(body) {
                    child := key(module, code_module.name)
                    imports := loop import in code_module.imports -> key(child, import.alias)
                    order := body.iter().filter_map(fn(item) { item_ref(child, item) }).collect()
                    &facts.modules.push(TirModuleFact{key: child, name: code_module.name, path: child, source_path: bundle.modules[module_index].display, imports: imports, item_order: order})
                    collect_items(bundle, module_index, child, body, &facts, target, contract_rows)
                }
            }
            else -> {}
        }
        if reference == .Val(reference) {
            // Unknown kinds still retain semantic spelling in module order.
            row := facts.modules.iter().position(fn(row) { row.key == module })
            if row == .Val(index) -> &facts.modules[index].item_order.push(reference)
        }
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:1597
fn lower_names(bundle: &ProgramBundle) -> TirNameFacts {
    modules := bundle.modules.iter().enumerate().filter_map(fn(pair) { bundle.name_ledger.module(pair.0) }).collect()
    facts := TirNameFacts{modules: modules, declarations: bundle.name_ledger.declarations().collect(), aliases: bundle.name_ledger.aliases().collect(), references: bundle.name_ledger.references().values().collect(), structure_facts: bundle.name_ledger.structure_facts()}
    &facts.declarations.sort_by_key(fn(row) { (row.module, row.name, row.path) })
    &facts.aliases.sort_by_key(fn(row) { (row.module, row.name, row.target) })
    &facts.references.sort_by_key(fn(row) { (row.module_path, row.kind, row.def_span.start, row.def_span.end) })
    &facts.structure_facts.sort_by_key(fn(row) { (row.subject, row.source, row.span.start, row.span.end) })
    facts
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:1635
fn lower_cffi(bundle: &ProgramBundle) -> TirCffiFacts {
    import_links := loop link in bundle.cffi.import_links -> TirCImportLink{importing_module: module_identity(bundle, link.importing_idx), scope: link.scope, alias: link.alias, target_module: module_identity(bundle, link.target_idx)}
    libs := loop lib in bundle.cffi.libs -> TirCLib{lib: lib.lib, module: module_identity(bundle, lib.module_idx)}
    overrides := loop row in bundle.cffi.overlay_overrides -> TirCOverlayOverride{lib: row.lib, generated_symbol: row.generated_symbol, overlay_symbol: row.overlay_symbol}
    handles := loop fact in bundle.cffi.handle_facts -> lower_handle(fact)
    adapters := loop adapter in bundle.cffi.close_adapters -> lower_close_adapter(adapter)
    TirCffiFacts{import_links: import_links, libs: libs, overlay_overrides: overrides, boundaries: bundle.cffi.boundaries, handle_facts: handles, direct_links: bundle.cffi.link_closure.direct, transitive_links: bundle.cffi.link_closure.transitive, close_adapters: adapters}
}
