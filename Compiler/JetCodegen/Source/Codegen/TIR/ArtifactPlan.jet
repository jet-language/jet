    bridge_eligible := jet_sema.guest_import_bridge_compatible(function)
    wrapper := jet_sema.guest_import_wrapper_name(module_alias, function.name)
    wraps_default_failure := if function.return_type == .Val(ty) -> jet_foundation.AST.FailureContract.from_return_type(Val(ty)).effective_type() != ty else -> false
    transport := if wraps_default_failure -> Val("guest-import-result") else -> None
    Val(TirForeignFact{key: wrapper, module: module, name: function.name, span: function.span, symbol: import.symbol, path: import.symbol, params: lower_params(function.params), raw_scalar_abi: true, bridge_eligible: bridge_eligible, return_type: function.return_type, abi: "C", language: "c", applicability: target_applicability_for(target), effect_root: None, callback_transport: transport, callback_identity: None, callback_plan_digest: None, link_key: None, callback_key: None, handle_key: None, close_function_key: None, undo_function_key: None})
