// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:1779
fn lower_output_checks(bundle: &ProgramBundle, facts: &TirArtifactFacts) -> [TirOutputCheck] {
    rows := [TirOutputCheck]{}
    loop (module_index, module) in bundle.modules.iter().enumerate() {
        module_key := module_identity(bundle, module_index)
        loop item in module.items {
            if item == .Const(constant) {
                output := constant.resolved_output ?? continue
                if !output.selected || output.kind != OutputKind.Check -> continue
                callable_name := if output.semantic_name.is_empty() -> output.source_name else -> output.semantic_name
                if callable_name.is_empty() -> continue
                row := facts.functions.iter().find(fn(function) { function.reference.module == module_key && (function.reference.name == callable_name || function.reference.key == callable_name) })
                reference := if row == .Val(function) -> function.reference else -> function_ref(module_key, callable_name, output.definition, NameVisibility.Private)
                &rows.push(TirOutputCheck{key: "{module_key}::output-check::{output.output_name}@{output.definition.start}..{output.definition.end}", name: output.output_name, function: reference})
            }
        }
    }
    rows
