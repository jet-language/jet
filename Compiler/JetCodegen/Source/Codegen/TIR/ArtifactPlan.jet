// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:48
fn target_applicability_for(target: TirArtifactTarget) -> TirTargetApplicability {
    if target == {
        .RustAot -> TirTargetApplicability{rust_aot: true, cranelift: false, interpreter: false, web: false}
        .Cranelift -> TirTargetApplicability{rust_aot: false, cranelift: true, interpreter: false, web: false}
        .Interpreter -> TirTargetApplicability{rust_aot: false, cranelift: false, interpreter: true, web: false}
        .Web -> TirTargetApplicability{rust_aot: false, cranelift: false, interpreter: false, web: true}
    }
}

