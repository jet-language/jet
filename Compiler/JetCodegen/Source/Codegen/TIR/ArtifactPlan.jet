    schedule := if function.every == .Val(every) -> every.resolved else -> None
    Val(TirJobFact{key: key(module, "job::{function.name}"), function: Val(function_ref(module, function.name, function.span, function_visibility(function))), name: job.name, scope: metadata.scope, doc: job.doc, arguments: arguments, record_inputs: record_inputs, schedule: schedule, after: metadata.after, parallel: metadata.parallel ?? 1, packages: metadata.packages, working_directory: metadata.cwd, input_paths: metadata.inputs, output_paths: metadata.outputs, skip: metadata.skip, cache: metadata.cache, limits: metadata.limits})
}
