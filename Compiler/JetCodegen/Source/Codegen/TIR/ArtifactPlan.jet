// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:1769
fn lower_cli_and_entry(bundle: &ProgramBundle, target: TirArtifactTarget) -> (TirCliEntry?, TirEntrySpec?) {
    schema := jet_foundation.CLISchema.executable_schema(bundle)
    module := module_identity(bundle, bundle.entry)
