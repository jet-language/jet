// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:1055
fn lower_entry(bundle: &ProgramBundle, target: TirArtifactTarget, cli: TirCliEntry?) -> TirEntrySpec? {
    if output_entry(bundle) == .Val(output) {
        module := module_identity(bundle, output.module)
        reference := Val(function_ref(module, output.semantic_name, output.definition, NameVisibility.Public))
        return Val(TirEntrySpec{kind: entry_kind(output.kind), function: reference, cli: cli, output: entry_output(output.kind), output_kind: output.kind, initialize_environment: initialize_environment(bundle, target), initialize_gc: false, serves_until_stopped: output.kind == OutputKind.Service || jet_foundation.AST.bundle_serves_until_stopped(bundle), package_version: bundle.build_facts.package_version})
    }
    root := bundle.modules.get(bundle.entry) ?? return None
    function := root.items.iter().find_map(fn(item) {
        if item == .Func(function) {
            if function.name == "run" && (function.params.is_empty() || cli != None) -> return Val(function)
        }
        None
    }) ?? return None
    module := module_identity(bundle, bundle.entry)
    Val(TirEntrySpec{kind: TirArtifactEntryKind.Command, function: Val(function_ref(module, function.name, function.span, function_visibility(function))), cli: cli, output: TirEntryOutput.ReturnValue, output_kind: OutputKind.Executable, initialize_environment: initialize_environment(bundle, target), initialize_gc: false, serves_until_stopped: jet_foundation.AST.bundle_serves_until_stopped(bundle), package_version: bundle.build_facts.package_version})
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:1116
fn job_cli_scalar(ty: &Type) -> Bool {
    if ty == {
        .Option(inner) -> {
            nested := if inner == { .Option(_) -> true else -> false }
            !nested && job_cli_scalar(inner)
        }
        .Bool | .Int | .Float | .Float32 | .String | .IntN(_, _) -> true
        .Named(name) -> name == Syntax.TYPE_PATH
        else -> false
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:1129
fn job_record_inputs(bundle: &ProgramBundle, function: &Func) -> [TirCliInput]? {
    if function.params.len() != 1 -> return None
    name := if function.params[0].ty == { .Named(name) -> name else -> return None }
    leaf := name.rsplit(['.', ':']).next() ?? name
    loop module in bundle.modules {
        loop item in module.items {
            if item == .Struct(structure) {
                if structure.name == leaf {
                    if jet_foundation.CLISchema.command_schema_with_items(module.items, structure) == .Val(schema) {
                        inputs := loop input in schema.inputs -> lower_cli_input(input)
                        return Val(inputs)
                    }
                }
            }
        }
    }
    None
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:1151
fn lower_job(bundle: &ProgramBundle, function: &Func, module: String) -> TirJobFact? {
    if !function.is_job -> return None
    record_inputs := job_record_inputs(bundle, function)
    if record_inputs == None && !function.params.iter().all(fn(param) { job_cli_scalar(param.ty) }) -> return None
    metadata := function.job_metadata ?? jet_foundation.AST.JobMetadata.default()
    job := jet_foundation.CLISchema.JobFact.from_function(function)
    params := function.params.iter().filter(fn(param) { param.name != Syntax.KW_SELF })
