// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:1243
fn lower_foreign(function: &jet_foundation.AST.ExternFn, module: String, crate_spec: String, target: TirArtifactTarget) -> TirForeignFact {
    function_key := key(module, function.rust_path)
    abi := if function.abi == .Val((abi, _)) -> abi else -> "C"
    close_key := if function.close == .Val((name, _)) -> Val(key(module, name)) else -> None
    undo_key := if function.undo == .Val((name, _)) -> Val(key(module, name)) else -> None
    TirForeignFact{key: function_key, module: module, name: function.name, span: function.span, symbol: function_key, path: function.rust_path, params: lower_params(function.params), bridge_eligible: true, raw_scalar_abi: false, return_type: function.return_type, abi: abi, language: "rust:{crate_spec}", applicability: target_applicability_for(target), effect_root: function.effect_root, callback_transport: None, callback_plan_digest: None, callback_identity: None, link_key: None, callback_key: None, handle_key: None, close_function_key: close_key, undo_function_key: undo_key}
