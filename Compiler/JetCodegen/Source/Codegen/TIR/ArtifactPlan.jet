// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:533
fn key(module: String, name: String) -> String {
    if module.is_empty() -> name else if name.is_empty() -> module else -> "{module}::{name}"
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:543
fn function_ref(module: String, name: String, span: Span, visibility: NameVisibility) -> TirFunctionRef {
    TirFunctionRef{key: key(module, name), module: module, name: name, span: span, visibility: visibility}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:558
fn function_visibility(function: &Func) -> NameVisibility {
    NameVisibility.from_flags(function.is_pub, function.is_package_pub)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:562
fn is_operator_trait(trait_name: String) -> Bool {
    trait_name == Syntax.TRAIT_ADD || trait_name == Syntax.TRAIT_SUB || trait_name == Syntax.TRAIT_MUL || trait_name == Syntax.TRAIT_DIV || trait_name == Syntax.TRAIT_EQUATABLE || trait_name == Syntax.TRAIT_COMPARABLE
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:574
fn method_reference_name(owner: String, trait_name: String?, operator_rhs: Type?, method: &Func) -> String {
    if trait_name == .Val(trait_name) {
        if is_operator_trait(trait_name) {
            rhs := operator_rhs ?? panic("sema must normalize every operator RHS")
            return jet_foundation.Traits.operator_method_identity(owner, trait_name, method.name, rhs)
        }
        return "{owner}::{trait_name}::{method.name}"
    }
    "{owner}::{method.name}"
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:590
fn item_ref(module: String, item: &Item) -> TirItemRef? {
    reference := if item == {
        .Func(function) -> TirItemRef.Function(key(module, function.name))
        .Struct(definition) -> TirItemRef.Type(key(module, definition.name))
        .Enum(definition) -> TirItemRef.Type(key(module, definition.name))
        .Distinct(definition) -> TirItemRef.Type(key(module, definition.name))
        .TypeAlias(definition) -> TirItemRef.Type(key(module, definition.name))
        .UnitFamily(definition) -> TirItemRef.Type(key(module, definition.family))
        .Trait(definition) -> TirItemRef.Trait(key(module, definition.name))
        .Impl(definition) -> {
            local := if definition.trait_name == .Val(trait_name) {
                if is_operator_trait(trait_name) {
                    rhs := definition.operator_rhs ?? panic("sema must normalize every operator RHS")
                    "impl::{definition.type_name}::{trait_name}<{rhs.name()}>"
                } else -> "impl::{definition.type_name}::{trait_name}"
            } else -> "impl::{definition.type_name}"
            TirItemRef.Impl(key(module, local))
        }
        .Const(definition) -> TirItemRef.Constant(key(module, definition.name))
        .Test(definition) -> TirItemRef.Unknown(test_key(module, definition))
        .ExternRust(_) -> TirItemRef.Foreign(key(module, "extern"))
        .CodeModule(definition) -> {
            if definition.body == None -> return None
            TirItemRef.Module(key(module, definition.name))
        }
        else -> TirItemRef.Unknown(std.any.type_name<Item>())
    }
    Val(reference)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:631
fn test_key(module: String, test: &TestDef) -> String {
    name := test.name ?? "anonymous"
    key(module, "test::{name}@{test.span.start}..{test.span.end}")
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:638
fn contract_key(module: String, function: &Func) -> String {
    key(module, "contract::{function.name}@{function.span.start}..{function.span.end}")
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:648
fn contract_eligibility_key(module: String, function: &Func) -> String {
    key(module, "contract-pre::{function.name}@{function.span.start}..{function.span.end}")
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:662
// Absent candidate / sampled None / explicit unavailability reason.
alias ContractSamplingPlan :: [String:String?]
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:675
fn contract_sampling_reason(function: &Func, covered: Bool) -> String?? {
    if function.pre.is_empty() || function.params.is_empty() -> return None
    precondition_calls_function := function.pre.iter().any(fn(clause) {
        found := false
        clause.cond.for_each_expr(fn(expr) {
            if expr == { .Call(_) | .MethodCall(_, _, _, _, _) -> true else -> false } -> found = true
        })
        found
    })
    reason := if {
        function.inline_foreign != None -> Val("contract_target_foreign")
        !function.type_params.is_empty() -> Val("contract_target_generic")
        !covered -> Val("contract_target_unsupported")
        precondition_calls_function -> Val("precondition_calls_function")
        else -> None
    }
    Val(reason)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:702
fn lower_contract_test(function: &Func, module: String, contract_rows: &ContractSamplingPlan) -> TirTestFact? {
    if function.pre.is_empty() || function.params.is_empty() -> return None
    row_key := contract_key(module, function)
    reason := contract_rows.get(row_key) ?? return None
    reference := TirFunctionRef{key: row_key, module: module, name: row_key, span: function.span, visibility: NameVisibility.Private}
    sampled := reason == None
    eligibility := if sampled -> Val(TirFunctionRef{key: contract_eligibility_key(module, function), module: module, name: contract_eligibility_key(module, function), span: function.span, visibility: NameVisibility.Private}) else -> None
    Val(TirTestFact{key: row_key, function: reference, name: "contract::{function.name}", span: function.span, kind: TirTestKind.Property, parameters: if sampled -> lower_params(function.params) else -> [TirParamFact]{}, faults: [String]{}, expected_failure: false, contract_generated: true, eligibility: eligibility, generation_unavailable_reason: reason})
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:753
fn core_import_module_path(module_alias: String, items: &[(String, String?)]) -> String? {
    _ := jet_foundation.AST.core_list_prefix(module_alias) ?? return None
    target := None
    loop (original, _) in items {
        path := jet_foundation.AST.core_list_path(module_alias, original) ?? return None
        module := if path == { .Module(module) | .Item(module, _) -> module }
        if target == .Val(existing) {
            if existing != module -> return Val(module_alias)
        } else -> target = Val(module)
    }
    if target == None -> Val(module_alias) else -> target
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:776
fn lower_import(bundle: &ProgramBundle, module_index: Int, module: String, import: &ImportDecl) -> TirImportFact {
    kind := if import.kind == {
        .File(path, _) -> TirImportKind.File{path: path}
        .Module(path, _) -> TirImportKind.Module{path: path}
        .Unqualified(module_alias, items, _) -> {
            if core_import_module_path(module_alias, items) == .Val(path) -> TirImportKind.Module{path: path}
            else {
                target := bundle.name_ledger.import_target(module_index, import.span)
                if target == None {
                    loop candidate in bundle.modules[module_index].imports {
                        unqualified := if candidate.kind == { .Unqualified(_, _, _) -> true else -> false }
                        if !unqualified && candidate.import_alias() == module_alias {
                            target = bundle.name_ledger.import_target(module_index, candidate.span)
                            if target != None -> break
                        }
                    }
                }
                target_module := if target == .Val(index) -> module_identity(bundle, index) else -> module_alias
                imported := loop (original, local) in items {
                    local_name := local ?? original
                    resolved := bundle.name_ledger.canonical_path(module_index, local_name) ?? key(target_module, original)
                    TirImportItem{original: original, local: local_name, item: TirItemRef.Unknown(resolved)}
                }
                TirImportKind.Unqualified{module: target_module, items: imported}
            }
        }
    }
    version := if import.inline_version == .Val(version) -> Val(version.text) else -> None
    TirImportFact{module: module, alias: import.alias, visibility: NameVisibility.from_flags(import.is_pub, import.is_package_pub), kind: kind, span: import.span, version: version}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:849
fn collect_imports(bundle: &ProgramBundle, module_index: Int, module: String, imports: &[TirImportFact]) {
    loaded := bundle.modules[module_index]
    loop import in loaded.imports -> &imports.push(lower_import(bundle, module_index, module, import))
    // Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:862
    fn nested(bundle: &ProgramBundle, module_index: Int, module: String, items: &[Item], imports: &[TirImportFact]) {
        loop item in items {
            if item == .CodeModule(code_module) {
                child := key(module, code_module.name)
                loop import in code_module.imports -> &imports.push(lower_import(bundle, module_index, child, import))
                if code_module.body == .Val(body) -> nested(bundle, module_index, child, body, &imports)
            }
        }
    }
    nested(bundle, module_index, module, loaded.items, &imports)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:888
fn lower_cli_default(default: &jet_foundation.CLISchema.CLIDefault) -> TirCliDefault {
    if default == { .TypeDefault -> TirCliDefault.TypeDefault .Value(value) -> TirCliDefault.Value(value) .Recorded(value) -> TirCliDefault.Recorded(value) }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:896
fn lower_cli_input(input: &jet_foundation.CLISchema.CLIInputSchema) -> TirCliInput {
    shape := if input.shape == {
        .Flag -> TirCliInputShape.Flag
        .Value(kind, optional, default) -> {
            lowered_default := if default == .Val(value) -> Val(lower_cli_default(value)) else -> None
            TirCliInputShape.Value{kind: kind, optional: optional, default: lowered_default}
        }
    }
    TirCliInput{field: input.field, flag: input.flag, short: input.short, env: input.env, help: input.help, metavar: input.metavar, shape: shape, positional: input.positional, variadic: false}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:922
fn find_entry_struct(items: &[Item], name: String) -> jet_foundation.AST.StructDef? {
    leaf := name.rsplit("::").next() ?? name
    loop item in items {
        if item == .Struct(definition) {
            if definition.name == leaf -> return Val(definition)
        }
    }
    None
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:930
fn lower_cli_entry(bundle: &ProgramBundle, schema: &jet_foundation.CLISchema.CLICommandSchema, module: String) -> TirCliEntry? {
    if schema.entry_type.is_empty() && schema.inputs.is_empty() && schema.commands.is_empty() && !schema.standard -> return None
    inputs := loop input in schema.inputs -> lower_cli_input(input)
    root := bundle.modules.get(bundle.entry) ?? return None
    structure := find_entry_struct(root.items, schema.entry_type)
    commands := loop command in schema.commands {
        target := if structure == .Val(structure) -> jet_foundation.CLISchema.command_target(structure, command, root.items, schema.entry_type) else -> None
        reference := None
        receiver := None
        if target == .Val(target) {
            function_name := if target.is_method -> "{schema.entry_type}::{target.function.name}" else -> target.function.name
            reference = Val(function_ref(module, function_name, target.function.span, function_visibility(target.function)))
            if target.bound_shared || target.is_method -> receiver = Val(key(module, schema.entry_type))
        }
        command_inputs := loop input in command.inputs -> lower_cli_input(input)
        TirCliCommand{name: command.name, description: command.description, function: reference, receiver: receiver, inputs: command_inputs}
    }
    Val(TirCliEntry{record_inputs: !schema.entry_type.is_empty(), description: schema.description, inputs: inputs, commands: commands, standard: schema.standard, version: schema.version})
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:997
fn output_entry(bundle: &ProgramBundle) -> jet_foundation.AST.ResolvedOutput? {
    loop module in bundle.modules {
        loop item in module.items {
            if item == .Const(constant) {
                if constant.resolved_output == .Val(output) {
                    if output.selected -> return Val(output)
                }
            }
        }
    }
    None
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:1011
fn entry_kind(kind: OutputKind) -> TirArtifactEntryKind {
    if kind == {
        .Library -> TirArtifactEntryKind.Library
        .Executable -> TirArtifactEntryKind.Command
        .Service -> TirArtifactEntryKind.Service
        .Check -> TirArtifactEntryKind.Test
        .Environment | .Image | .Bundle | .System | .Fleet -> TirArtifactEntryKind.App
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:1025
fn entry_output(kind: OutputKind) -> TirEntryOutput {
    if kind == {
        .Executable | .Service | .Check -> TirEntryOutput.ReturnValue
        .Library | .Environment | .Image | .Bundle | .System | .Fleet -> TirEntryOutput.None
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:1039
fn no_os_profile(bundle: &ProgramBundle) -> Bool {
    if bundle.build_facts.target_dossier.machine == .Val(machine) -> machine.no_os else -> false
}
// Rust: crates/jet-codegen/src/Codegen/TIR/artifact_plan.rs:1048
fn initialize_environment(bundle: &ProgramBundle, target: TirArtifactTarget) -> Bool {
