        .MathMethod(type_name, method, reduce_op) -> {
            (suffix, arity) :: if (method, reduce_op) == {
                ("reduce", .Val("Add")) -> ("reduce_add", 1)
                ("reduce", .Val("Mul")) -> ("reduce_mul", 1)
                ("reduce", .Val("Min")) -> ("reduce_min", 1)
                ("reduce", .Val("Max")) -> ("reduce_max", 1)
                ("reduce", .Val("Avg")) -> ("reduce_avg", 1)
                ("to_array" | "sum" | "product" | "min" | "max", None) if Sema.is_simd_lane_type(type_name) -> (method, 1)
                ("to_array" | "length" | "normalize", None) if type_name == "Vec2" || type_name == "Vec3" || type_name == "Vec4" -> (method, 1)
                ("dot", None) if type_name == "Vec2" || type_name == "Vec3" || type_name == "Vec4" -> ("dot", 2)
                ("cross", None) if type_name == "Vec3" -> ("cross", 2)
                ("to_array" | "transpose", None) if type_name == "Mat3" || type_name == "Mat4" -> (method, 1)
                ("matmul" | "transform", None) if type_name == "Mat3" || type_name == "Mat4" -> (method, 2)
                else -> return Err(route_error("checked math method `{type_name}.{method}` requires structural MIR lowering"))
