//RS             .find_map(|i| match i {
//RS                 Item::Struct(s) if s.name == type_name => Some(s.methods.as_slice()),
//RS                 Item::Enum(e) if e.name == type_name => Some(e.methods.as_slice()),
//RS                 _ => None,
//RS             })
//RS             .unwrap_or_else(|| panic!("no type {type_name}"));
//RS         let f = methods
//RS             .iter()
//RS             .find(|m| m.name == method)
//RS             .unwrap_or_else(|| panic!("no method {type_name}{method}"));
//RS         tir_covers_method(f, type_name, &cx)
//RS     })
//RS }
