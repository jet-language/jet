//RS #[test]
//RS fn rejects_intercepted_static_name() {
//RS     // A static method named `new` collides with the alloc/special intercept
//RS     // (`mem.*.new`) — the AST path special-cases the name, so the TIR static
//RS     // call gate must NOT claim it. (The method body itself may still route, but
//RS     // its *call* `Type.new()` stays on the AST path; here we check the body gate
//RS     // is independent — `new` as a *static body* is still a plain method def.)
//RS     // The static *call*-site exclusion is covered by `is_intercepted_method_name`.
//RS     assert!(is_intercepted_method_name("new"));
//RS }
