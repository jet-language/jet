//RS         let (toks, lex_diags) = crate::Lexer::lex(src);
//RS         assert!(lex_diags.is_empty(), "lex errors: {lex_diags:?}");
//RS         let prog = crate::Parser::parse(&toks).expect("parse failed");
//RS         let cx = build_cx(&prog, src, "test.jet");
