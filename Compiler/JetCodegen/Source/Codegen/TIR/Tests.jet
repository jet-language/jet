//RS #[test]
//RS fn rejects_range_switch_over_non_ident_subject() {
//RS     // D-IF3: a value+range mixed switch (shape D) lowers each range head to
//RS     // `subject >= lo && subject <= hi`. `arm_head_range` (subset/patterns.rs)
//RS     // admits an arm-head range ONLY over an `Expr::Ident` subject, so a call
//RS     // subject with a range arm leaves the whole switch out of the subset: the
//RS     // range arm satisfies neither `arm_head_range` nor `arm_is_plain_cond`
//RS     // (which excludes every `Expr::PatternTest`), so shape D rejects it.
//RS     //
//RS     // That restriction is deliberate and still load-bearing. The one
//RS     // `arm_head_range` helper gates BOTH shape B and shape D, and shape B's
//RS     // emitter (`TStmt::RangeSwitch`, emit/statements.rs) re-emits `subject_str`
//RS     // twice per arm instead of reading the `__jet_switch_subject` binding — so a
//RS     // call subject would be evaluated 2n times. Commit e45822626 added the
//RS     // guard for exactly that; this assertion had been flipped the day before
//RS     // (84ec4c9dc) and never ran, because the lib test target did not compile.
//RS     //
//RS     // A non-ident subject stays covered without a range arm — see
//RS     // `covers_mixed_switch_non_ident_subject`.
//RS     let src = "fn pick() -> Int { return 5 }\nfn f() -> String {\n if pick() == {\n 0 -> { return \"zero\" }\n 1..10 -> { return \"low\" }\n else -> { return \"mid\" }\n }\n}\n";
//RS     assert!(!covers(src, "f"));
//RS }
