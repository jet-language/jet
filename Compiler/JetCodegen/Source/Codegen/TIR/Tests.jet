//RS /// Parse `src` (no full sema needed — `tir_covers` is structural plus
//RS /// program-table lookups that `build_cx` fills) and return whether the
//RS /// named function is covered by the Phase-1 TIR gate.
//RS ///
//RS /// The gate is a mutually recursive descent whose debug frames are hundreds
//RS /// of KiB each (`lower_method_call_impl` 528 KiB, `lower_stmt_plan` 256 KiB,
//RS /// measured in `tests/dev.rs::resident_jit_safe_increment_decrement`), so a
//RS /// few levels of source nesting exhaust libtest's 2 MiB test thread and abort
//RS /// the whole binary — every test ordered after the aborting one is never
//RS /// measured. Jet owns exactly one boundary for that abort,
//RS /// `jet_foundation::CompilerStack`, installed at the four public funnels
//RS /// (sema's bundle check, the driver's compile/load funnels,
//RS /// `TIR::lower_jit_program`, `jet_jit`'s bundle entries). A unit test reaches
//RS /// the descent below all four, so every helper here makes the same hop. It is
//RS /// re-entrant, so the ones that run sema first cost one thread-local read.
//RS fn covers(src: &str, fn_name: &str) -> bool {
//RS     jet_foundation::CompilerStack::run_on_compiler_stack(|| {
//RS         let (toks, lex_diags) = crate::Lexer::lex(src);
//RS         assert!(lex_diags.is_empty(), "lex errors: {lex_diags:?}");
//RS         let prog = crate::Parser::parse(&toks).expect("parse failed");
//RS         let cx = build_cx(&prog, src, "test.jet");
//RS         let f = prog
//RS             .items
//RS             .iter()
//RS             .find_map(|i| match i {
//RS                 Item::Func(f) if f.name == fn_name => Some(f),
//RS                 _ => None,
//RS             })
//RS             .unwrap_or_else(|| panic!("no fn {fn_name}"));
//RS         tir_covers(f, &cx)
//RS     })
//RS }
//RS 
//RS #[test]
//RS fn shield_block_is_covered_by_tir() {
//RS     assert!(covers("fn guarded() { #Shield { value :: 1 } }", "guarded"));
//RS }
