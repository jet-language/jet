fn index_route(kind: MirIndexKind, access: MirAccess, result: Type, carrier: TFailureCarrier) -> TPreludeRoute LowerError! {
    (member, symbol, arity, mask) :: if (kind, access) == {
        (.List | .FixedListProof, .Read) -> ("index_list", "jet_index_vec", 4, [true, false, true, false])
        (.List | .FixedListProof, .Write) -> ("index_list_mut", "jet_index_vec_mut", 4, [true, false, true, false])
        (.List | .FixedListProof, .Move) -> fail route_error("index move has no checked Prelude kernel")
        (.Map, .Read) -> ("index_map", "jet_index_map", 8, [true, true, true, false, true, true, false, false])
        (.Map, .Write) -> ("index_map_mut", "jet_index_map_mut", 8, [true, true, true, false, true, true, false, false])
        (.Map, .Move) -> fail route_error("map index move has no checked Prelude kernel")
        (.Pool, .Read) -> ("index_pool", "jet_std::jet_pool_get", 6, [true, false, true, false, true, true])
        (.Pool, .Write) -> ("index_pool_mut", "jet_std::jet_pool_get_mut", 6, [true, false, true, false, true, true])
        (.Pool, .Move) -> fail route_error("pool index move has no checked Prelude kernel")
        (.Lane, _) -> fail route_error("lane index requires the checked lane type route")
    }
    prelude_route_row(MirPreludeFamily.StaticPrelude, "core.index", member, symbol, arity, arity, mask, None, carrier, MirPreludeAbi.Value, "index operation")!
}
