// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:8429
fn math_builtin_route(type_name: String, func: String, arity: USize, result: Type, carrier: TFailureCarrier) -> TPreludeRoute LowerError! {
    if func == "abs" {
        if arity != 1 -> fail route_error("math builtin `{type_name}::abs` has unsupported arity {arity}")
        symbol :: if (type_name, result) == {
            ("Int", .Int) -> "jet_std::jet_int_abs"
            ("Float", .Float) -> "jet_std_math_abs_f64"
            ("F32", .Float32) -> "jet_std_math_abs_f32"
            ("Complex", .Float) -> "jet_complex_abs"
            _ -> fail route_error("math builtin `{type_name}::abs` has no canonical typed route")
        }
        return prelude_route_row(MirPreludeFamily.MathBuiltin, "core.math", "abs", symbol, 1, 1, [false], None, carrier, MirPreludeAbi.Value, "math builtin")!
    }
    prelude_route_row(MirPreludeFamily.MathBuiltin, type_name, func, "jet_math_{type_name}_{func}", arity, arity, [Bool].repeat(false, arity), None, carrier, MirPreludeAbi.Value, "math builtin")!
}
