fn alloc_new_route(ctor: TAllocCtor, result: Type, arg_count: USize, carrier: TFailureCarrier) -> TPreludeRoute LowerError! {
    (member, symbol, arity, max_arity, mask) :: if ctor == {
        .Arena -> if arg_count == 0 -> ("arena.new", "jet_mem::JetArena::new", 0, 0, []) else -> ("arena.new", "jet_mem::JetArena::with_capacity", 1, 1, [false])
        .Bump -> if arg_count == 0 -> ("bump.new", "jet_mem::JetBump::new", 0, 0, []) else -> ("bump.new", "jet_mem::JetBump::with_capacity", 1, 1, [false])
        .Pool -> ("pool.new", "jet_mem::JetPool::with_slots", 1, 1, [false])
        .Fixed(_) -> ("fixed.new", "jet_mem::JetFixed::new", 1, 1, [false])
        .FixedOver -> ("fixed.over", "jet_mem::JetFixed::over", 1, 1, [true])
    }
    if arg_count < arity || arg_count > max_arity -> fail route_error("allocator constructor route `{member}` accepts {arity}..={max_arity} argument(s), got {arg_count}")
    prelude_route_row(MirPreludeFamily.StaticPrelude, "core.mem", member, symbol, arity, max_arity, mask, None, carrier, MirPreludeAbi.Value, "allocator constructor")!
}
