fn require_stop_route(kind: String, value_arity: USize, result: Type, carrier: TFailureCarrier) -> TPreludeRoute LowerError! {
    (member, symbol, kernel_arity, mask, effect) :: if kind == {
        "require" -> {
            if value_arity > 1 -> fail route_error("require stop `{kind}` has unsupported checked value arity {value_arity}")
            ("require", "jet_require", 9, [false, true, true, false, true, true, false, false, true], Val(Effect.Panic))
        }
        "require_eq" -> {
            if value_arity != 2 -> fail route_error("require stop `{kind}` has unsupported checked value arity {value_arity}")
            ("require_eq", "jet_require_eq", 10, [false, true, true, true, false, true, true, false, false, true], Val(Effect.Panic))
        }
        "panic" -> {
            if value_arity != 1 -> fail route_error("require stop `{kind}` has unsupported checked value arity {value_arity}")
            ("panic", "jet_panic_rich", 8, [true, false, true, true, false, false, true, true], Val(Effect.Panic))
        }
        _ -> fail route_error("require stop `{kind}` has unsupported checked value arity {value_arity}")
    }
    prelude_route_row(MirPreludeFamily.StaticPrelude, "core.require", member, symbol, kernel_arity, kernel_arity, mask, effect, carrier, MirPreludeAbi.Control, "require stop")!
}
