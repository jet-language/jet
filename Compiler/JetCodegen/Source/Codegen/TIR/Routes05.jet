    string_map_key :: if base.without_user_tags() == .Map(key, _) -> key.without_user_tags() == .String else -> false
    (member, symbol, arity, mask) :: if kind == {
        .List | .FixedListProof -> ("index_list_set", "jet_index_vec_set", 5, [true, false, false, true, false])
        .Map -> if string_map_key -> ("index_map_set", "jet_map_update_string", 3, [true, true, false]) else -> ("index_map_set", "jet_map_insert", 3, [true, false, false])
        .Pool -> ("index_pool_set", "jet_std::jet_pool_set", 7, [true, false, false, true, false, true, true])
        .Lane -> fail route_error("lane index assignment has no checked typed setter route")
    }
    prelude_route_row(MirPreludeFamily.StaticPrelude, "core.index", member, symbol, arity, arity, mask, None, carrier, MirPreludeAbi.Value, "index assignment")!
}
