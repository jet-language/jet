fn core_closure_route(kind: MirCoreClosureKind, grouped_spawn: Bool, result: Type, carrier: TFailureCarrier) -> TPreludeRoute LowerError! {
    (module, member, symbol, arity, mask) :: if kind == {
        .Spawn -> if grouped_spawn -> ("core.tasks", "spawn_grouped", "jet_std::JetTaskGroup::spawn_at", 4, [false, false, false, false]) else -> ("core.tasks", "spawn", "jet_std::JetTask::spawn_at", 3, [false, false, false])
        .Realtime -> ("core.rt", "callback", "jet_rt_callback", 3, [false, false, false])
        .Serve -> ("core.http", "serve", "jet_http_serve", 2, [true, false])
        .OnInterrupt -> ("core.sys", "on_interrupt", "jet_std_os_on_interrupt", 1, [false])
        .Guard -> ("core.mem.scope", "guard", "jet_scope_guard", 1, [false])
        .OnCommit -> ("core.transaction", "on_commit", "jet_transaction_on_commit", 2, [true, false])
        .OnRollback -> ("core.transaction", "on_rollback", "jet_transaction_on_rollback", 2, [true, false])
        .ReactiveDerived -> ("core.reactive", "derived", "jet_std::JetDerived::new", 1, [false])
        .ReactiveEffect -> ("core.reactive", "effect", "jet_std::jet_reactive_effect", 1, [false])
        .UiMount -> ("core.ui", "reactive_render", "jet_ui_reactive_render", 1, [false])
        .UiPreview(playground, _) -> ("core.ui", if playground -> "playground" else -> "preview", if playground -> "jet_ui_playground_with_viewport" else -> "jet_ui_preview_with_viewport", 3, [true, false, false])
        .UiAction -> ("core.ui", "button", "jet_ui_button_on_click", 4, [true, false, false, false])
        .UiTextInputOnDrop -> ("core.ui", "text_input", "jet_ui_text_input_on_drop", 3, [true, false, false])
    }
    effect :: if kind == .Realtime -> Val(Effect.Time) else -> None
    prelude_route_row(MirPreludeFamily.StaticPrelude, module, member, symbol, arity, arity, mask, effect, carrier, MirPreludeAbi.Value, "core closure call")!
}
