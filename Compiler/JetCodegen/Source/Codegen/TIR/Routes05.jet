use jet_foundation.[Type, BinOp, Effect, TFailureCarrier, TBuiltinOp, THelperKind, TAllocCtor, TPreludeRoute, TRoutePlan]
use jet_foundation.MIR.[MirAccess, MirIndexKind, MirLayoutCompareOp, MirCoreClosureKind, MirPreludeFamily, MirPreludeAbi, MirSymbol, MirCallSignature, MirType]
use jet_codegen.Codegen.TIR.LowerError

// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:6689
impl TBuiltinOp {
    fn prelude_route(self, receiver: Type, result: Type, carrier: TFailureCarrier) -> TPreludeRoute LowerError! {
        plan :: if iterator_builtin_route(self, receiver, carrier) == Val(plan) -> plan else {
            if self == {
                .JoinSep -> b("join", "jet_list_join", 2, 2, [true, true], None, carrier)
                .StartsWith -> if is_string_receiver(receiver) -> b("string_starts_with", "jet_string_starts_with", 2, 2, [true, true], None, carrier)
                    else -> b("list_starts_with", "jet_list_starts_with", 2, 2, [true, true], None, carrier)
                .EndsWith -> if is_string_receiver(receiver) -> b("string_ends_with", "jet_string_ends_with", 2, 2, [true, true], None, carrier)
                    else -> b("list_ends_with", "jet_list_ends_with", 2, 2, [true, true], None, carrier)
                .Max(float, _) -> {
                    if !float && receiver == .Apply("Set", _) -> builtin_collection_route(self, receiver, carrier)!
                    else -> self.route_plan(result, carrier)!
                }
                .SetShuffle -> builtin_collection_route(self, receiver, carrier)!
                .Contains -> {
                    if receiver == .Named(name) && name == TYPE_BITS -> builtin_collection_route(self, receiver, carrier)!
                    else if is_string_receiver(receiver) -> b("contains", "jet_string_contains", 2, 2, [true, true], None, carrier)
                    else -> builtin_collection_route(self, receiver, carrier)!
                }
                .LenList | .ContainsKey | .IsEmpty | .DequeCapacity | .SetCapacity | .GetMap | .GetList | .First | .Last | .ListUnion | .ListIntersection | .ListDifference | .ListRandom -> builtin_collection_route(self, receiver, carrier)!
                .MapFromKeys -> b("map_from_keys", map_from_keys_symbol(receiver), 2, 2, [false, false], None, carrier)
                _ -> self.route_plan(result, carrier)!
            }
        }
        as_prelude(plan, "builtin method")!
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:6790
fn b(member: String, symbol: String, arity: USize, max_arity: USize, borrow_mask: [Bool], effect: Effect?, carrier: TFailureCarrier) -> TRoutePlan Never! {
    prelude(MirPreludeFamily.BuiltinMethod, "core.builtin", member, symbol, arity, max_arity, borrow_mask, effect, carrier, MirPreludeAbi.Value)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:6813
fn atomic_method_route(method: String, carrier: TFailureCarrier) -> TRoutePlan LowerError! {
    (member, symbol, arity, mask, effect) :: if method == {
        "load" -> ("load", "jet_atomic_load", 1, [true], None)
        "store" -> ("store", "jet_atomic_store", 2, [true, false], None)
        "add" -> ("add", "jet_atomic_add", 2, [true, false], None)
        "try_add" -> ("try_add", "jet_atomic_try_add", 2, [true, false], Val(Effect.Mem))
        "compare_exchange" -> ("compare_exchange", "jet_atomic_compare_exchange", 3, [true, false, false], None)
        "publish" -> ("publish", "jet_atomic_publish", 2, [true, false], None)
        "observe" -> ("observe", "jet_atomic_observe", 1, [true], None)
        _ -> fail route_error("unknown checked Atomic method `{method}`")
    }
    prelude(MirPreludeFamily.BuiltinMethod, "core.mem", member, symbol, arity, arity, mask, effect, carrier, MirPreludeAbi.Value)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:6854
fn byte_buffer_method_route(method: String, carrier: TFailureCarrier) -> TRoutePlan LowerError! {
    if method == "capacity" -> return b("byte_buffer_capacity", "JetByteBuffer::capacity", 1, 1, [true], None, carrier)
    arity :: if method == {
        "len" | "is_empty" | "clear" | "position" | "eof" | "rewind" | "flush" | "close" | "shutdown" | "get_buffer" | "buffer" | "to_string" | "string" | "trim" | "trim_start" | "trim_end" | "to_lower" | "to_upper" | "to_title" | "title" | "clone" | "copy" | "lines" | "first" | "next" | "read_byte" | "read" | "is_ascii" -> 1
        "get" | "seek" | "read_bytes" | "read_string" | "contains" | "starts_with" | "ends_with" | "index_of" | "last_index_of" | "split" | "partition" | "join" | "equal" | "compare" | "copy_to" | "write_to" -> 2
        "replace" -> 3
        _ -> return primitive()
    }
    b("byte_buffer_{method}", "JetByteBuffer::{method}", arity, arity, [Bool].repeat(true, arity), Val(Effect.Mem), carrier)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:6893
fn byte_buffer_write_route(method: String, carrier: TFailureCarrier) -> TRoutePlan LowerError! {
    b("byte_buffer_{method}", "JetByteBuffer::{method}", 2, 2, [true, false], Val(Effect.Mem), carrier)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:6910
fn string_method_route(method: String, result: Type, carrier: TFailureCarrier) -> TRoutePlan LowerError! {
    if method == "equal" -> return prelude(MirPreludeFamily.BuiltinMethod, "core.compare", "eq", "jet_eq", 2, 2, [true, true], None, carrier, MirPreludeAbi.Value)
    if method == "expandtabs" -> return b("expandtabs", "jet_text_expandtabs", 2, 2, [true, false], None, carrier)
    (member, symbol, arity) :: if method == {
        "expandtabs" -> ("expandtabs", "jet_text_expandtabs", 2)
        "find" -> ("find", "jet_text_parse_find", 2)
        "rfind" -> ("rfind", "jet_text_parse_rfind", 2)
        "partition" -> ("partition", "jet_text_parse_partition", 2)
        "rpartition" -> ("rpartition", "jet_text_parse_rpartition", 2)
        "strip" -> ("strip", "jet_text_parse_strip", 1)
        "lstrip" -> ("lstrip", "jet_text_parse_lstrip", 1)
        "rstrip" -> ("rstrip", "jet_text_parse_rstrip", 1)
        "copy" -> ("copy", "jet_string_copy", 1)
        "replace" -> ("replace", "jet_string_replace", 3)
        "count_bytes" -> ("count_bytes", "jet_string_count_bytes", 1)
        "last_index_of" -> ("last_index_of", "jet_unicode_last_index_of", 2)
        "is_lower" -> ("is_lower", "jet_text_is_lower", 1)
        "is_upper" -> ("is_upper", "jet_text_is_upper", 1)
        "capitalize" -> ("capitalize", "jet_text_capitalize", 1)
        "swapcase" -> ("swapcase", "jet_text_swapcase", 1)
        "remove_prefix" | "removeprefix" -> ("remove_prefix", "jet_text_remove_prefix", 2)
        "remove_suffix" | "removesuffix" -> ("remove_suffix", "jet_text_remove_suffix", 2)
        "compare" -> ("compare", "jet_text_compare", 2)
        "reverse" -> ("reverse", "jet_text_reverse", 1)
        "normalize" -> ("normalize", "jet_text_normalize_nfc", 1)
        "rsplit" -> ("rsplit", "jet_iter_string_rsplit", 2)
        "matches" -> ("matches", "jet_std::jet_string_matches", 2)
        "match" -> ("match", "jet_std::jet_string_match", 2)
        "isalnum" -> ("isalnum", "jet_text_isalnum", 1)
        "isalpha" -> ("isalpha", "jet_text_is_alphabetic", 1)
        "isascii" -> ("isascii", "jet_text_unicode_is_ascii", 1)
        "isdecimal" -> ("isdecimal", "jet_text_isdecimal", 1)
        "isdigit" -> ("isdigit", "jet_text_isdigit", 1)
        "isidentifier" -> ("isidentifier", "jet_text_isidentifier", 1)
        "isnumeric" -> ("isnumeric", "jet_text_isnumeric", 1)
        "isprintable" -> ("isprintable", "jet_text_isprintable", 1)
        "isspace" -> ("isspace", "jet_text_is_whitespace", 1)
        "istitle" -> ("istitle", "jet_text_istitle", 1)
        "islower" -> ("islower", "jet_text_is_lower", 1)
        "isupper" -> ("isupper", "jet_text_is_upper", 1)
        "lower" -> ("lower", "jet_unicode_lower", 1)
        "upper" -> ("upper", "jet_unicode_upper", 1)
        "title" -> ("title", "jet_text_title", 1)
        "casefold" -> ("casefold", "jet_text_casefold", 1)
        "center" -> ("center", "jet_text_center_ref", 3)
        "ljust" -> ("ljust", "jet_text_pad_end_ref", 3)
        "rjust" -> ("rjust", "jet_text_pad_start_ref", 3)
        "zfill" -> ("zfill", "jet_text_zfill_ref", 2)
        _ -> fail route_error("unknown checked String method `{method}`")
    }
    b(member, symbol, arity, arity, [Bool].repeat(true, arity), None, carrier)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:7003
fn overflow_input_type(ty: Type) -> Type Never! {
    stripped :: ty.without_user_tags()
    if stripped == {
        .InlineRange(base, _, _) -> overflow_input_type(base)
        .Tagged(inner, _) -> overflow_input_type(inner)
        other -> other
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:7012
fn fixed_width_name(ty: Type) -> String? Never! {
    if overflow_input_type(ty) == {
        .IntN(true, 8) -> Val("i8")
        .IntN(true, 16) -> Val("i16")
        .IntN(true, 32) -> Val("i32")
        .IntN(true, 64) -> Val("i64")
        .IntN(false, 8) -> Val("u8")
        .IntN(false, 16) -> Val("u16")
        .IntN(false, 32) -> Val("u32")
        .IntN(false, 64) -> Val("u64")
        _ -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:7050
fn numeric_binary(op: BinOp) -> Bool Never! {
    if op == {
        .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .Pow | .Shl | .Shr | .BitAnd | .BitOr | .BitXor -> true
        _ -> false
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:7069
fn exact_int_type(ty: Type) -> Bool Never! {
    if ty.without_user_tags() == {
        .Int -> true
        .InlineRange(base, _, _) -> exact_int_type(base)
        _ -> false
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:7077
fn exact_int_binary_route(op: BinOp, carrier: TFailureCarrier) -> TRoutePlan LowerError! {
    (member, symbol, arity, effect) :: if op == {
        .Add -> ("add", "jet_std::jet_int_add", 2, None)
        .Sub -> ("sub", "jet_std::jet_int_sub", 2, None)
        .Mul -> ("mul", "jet_std::jet_int_mul", 2, None)
        .BitAnd -> ("bit_and", "jet_std::jet_int_bit_and", 2, None)
        .BitOr -> ("bit_or", "jet_std::jet_int_bit_or", 2, None)
        .BitXor -> ("bit_xor", "jet_std::jet_int_bit_xor", 2, None)
        .Div -> ("div", "jet_std::jet_int_div", 4, Val(Effect.Panic))
        .Rem -> ("rem", "jet_std::jet_int_rem", 4, Val(Effect.Panic))
        .FloorDiv -> ("floor_div", "jet_std::jet_int_floor_div", 4, Val(Effect.Panic))
        .Mod -> ("mod", "jet_std::jet_int_mod", 4, Val(Effect.Panic))
        .Pow -> ("pow", "jet_std::jet_int_pow", 4, Val(Effect.Panic))
        .Shl -> ("shl", "jet_std::jet_int_shl", 4, Val(Effect.Panic))
        .Shr -> ("shr", "jet_std::jet_int_shr", 4, Val(Effect.Panic))
        _ -> return TRoutePlan.Primitive
    }
    prelude(MirPreludeFamily.Overflow, "core.numeric", member, symbol, arity, arity, [Bool].repeat(false, arity), effect, carrier, MirPreludeAbi.Value)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:7114
fn fixed_trap_binary_route(width: String, op: BinOp, carrier: TFailureCarrier) -> TRoutePlan LowerError! {
    op_name :: if op == {
        .Add -> "add"
        .Sub -> "sub"
        .Mul -> "mul"
        .Div -> "div"
        .Rem -> "rem"
        .FloorDiv -> "floor_div"
        .Mod -> "mod"
        .Pow -> "pow"
        .Shl -> "shl"
        .Shr -> "shr"
        _ -> return TRoutePlan.Primitive
    }
    row :: prelude_route_row(MirPreludeFamily.Overflow, "core.numeric", "{width}.trap.{op_name}", "jet_{width}_trap_{op_name}", 4, 4, [false, false, false, false], Val(Effect.Panic), carrier, MirPreludeAbi.Value, "fixed-width trap arithmetic")!
    TRoutePlan.Prelude(row)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:7150
fn binary_route(op: BinOp, overflow: Bool, input: Type, rhs: Type, result: Type, carrier: TFailureCarrier) -> TRoutePlan LowerError! {
    if op == .Add || op == .Sub {
        left_layout :: if input == .Named(name) -> is_layout_axis_type(name) else -> false
        right_layout :: if rhs == .Named(name) -> is_layout_axis_type(name) else -> false
        if left_layout || right_layout -> return layout_binary_route(op, result, carrier)!
    }
    if input == .Named(left) && rhs == .Named(right) && left == right {
        func :: if (left, op) == {
            ("Decimal", .Add) -> Val("add")
            ("Decimal", .Sub) -> Val("sub")
            ("Decimal", .Mul) -> Val("mul")
            ("Fraction", .Add) -> Val("add")
            ("Fraction", .Sub) -> Val("sub")
            ("Fraction", .Mul) -> Val("mul")
            ("Fraction", .Div) -> Val("div")
            _ -> None
        }
        if func == Val(name) -> return TRoutePlan.Prelude(precise_builtin_route(left, name, 2, result, carrier)!)
    }
    if exact_int_type(input) {
        if numeric_binary(op) && !exact_int_type(result) -> fail route_error("exact Int arithmetic has a non-Int resolved result type")
        return exact_int_binary_route(op, carrier)!
    }
    if !numeric_binary(op) -> return TRoutePlan.Primitive
    width :: fixed_width_name(input) ?? {
        if overflow -> fail route_error("checked arithmetic has no resolved fixed numeric type")
        return TRoutePlan.Primitive
    }
    if fixed_width_name(result) != Val(width) -> fail route_error("fixed-width arithmetic has a mismatched resolved result type")
    if !overflow && op != .Rem && op != .FloorDiv && op != .Mod && op != .Pow -> return TRoutePlan.Primitive
    fixed_trap_binary_route(width, op, carrier)!
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:7213
fn compare_route(op: BinOp, hook: Bool, result: Type, carrier: TFailureCarrier) -> TRoutePlan LowerError! {
    if !hook -> return TRoutePlan.Primitive
    if op == {
        .Lt | .Gt | .Le | .Ge | .Eq | .Ne -> prelude(MirPreludeFamily.BuiltinMethod, "core.compare", op.spell(), "jet_int_compare", 2, 2, [true, true], None, carrier, MirPreludeAbi.Value)
        .Compare -> prelude(MirPreludeFamily.BuiltinMethod, "core.compare", "compare", "jet_int_compare", 2, 2, [true, true], None, carrier, MirPreludeAbi.Value)
        _ -> TRoutePlan.Primitive
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:7252
fn runtime(family: MirPreludeFamily, module: String, member: String, symbol: String, arity: USize, max_arity: USize, borrow_mask: [Bool], effect: Effect?, carrier: TFailureCarrier, abi: MirPreludeAbi) -> TRoutePlan Never! {
    TRoutePlan.Prelude(TPreludeRoute{
        family: family, module: module, member: member, symbol: MirSymbol.Runtime(symbol),
        signature: MirCallSignature{arity: arity, max_arity: max_arity, borrow_mask: borrow_mask},
        effect: effect, fallibility: carrier, authority: None, abi: abi, db_metadata: None,
    })
}

