//RS #[test]
//RS fn covers_comptime_const_in_interpolation() {
//RS     crate::Codegen::MIREval::install_mir_bridge();
//RS     // c109 Phase 24 / S57: a marked comptime const carries its sema-evaluated
//RS     // value into the interpolation operand, so this needs the full sema pass.
//RS     let src = "\
//RS HEADER :: prep { \"<html>\" }
//RS fn wrap(s: String) -> String {
//RS     return \"{HEADER}: {s}\"
//RS }
//RS fn run() {
//RS     print(wrap(\"body\"))
//RS }
