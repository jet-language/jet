// Canonical Core-call projection for the TIR-to-MIR boundary.
// Records are already resolved; preserve every metadata field, without rediscovery.
use JetFoundation.MIR.[MirCoreCall]
use JetFoundation.Syntax.[CoreCallRecord]

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_core.rs:16
// One row per (id, key), in stable (id, key) order, independent of traversal order.
fn lower_core_records(records: [CoreCallRecord]) -> [MirCoreCall] {
    rows := records.iter().map(|record| -> MirCoreCall.from_record(record)).collect()
    rows.sort_unstable_by(|left, right| -> left.id.cmp(right.id).then_with(|| -> left.key.cmp(right.key)))
    rows.dedup_by(|left, right| -> left.id == right.id && left.key == right.key)
    ^rows
}
