pub fn range_checked_ctor_route(name: String, result: Type, carrier: TFailureCarrier) -> TPreludeRoute LowerError! {
    prelude_route_row(MIRPreludeFamily.StaticPrelude, "core.numeric", "inline_range", "jet_inline_range_from_int", 3, 3, [false, false, false], None, carrier, MIRPreludeABI.Value, "range checked constructor")
