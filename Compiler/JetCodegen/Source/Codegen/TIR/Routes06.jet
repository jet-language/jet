pub fn gc_edit_route(kind: TGCEditKind, result: Type, carrier: TFailureCarrier) -> TPreludeRoute LowerError! {
    (member, symbol, arity, borrow_mask) :: if kind == {
        .Clear -> ("edit_clear", "jet_gc_edit_clear", 2, [true, false])
        .Pop -> ("edit_pop", "jet_gc_edit_pop", 2, [true, false])
        .RemoveIndex -> ("edit_remove_index", "jet_gc_edit_remove_index", 3, [true, false, false])
        .InsertIndex -> ("edit_insert_index", "jet_gc_edit_insert_index", 4, [true, false, true, false])
        .Prepend -> ("edit_prepend", "jet_gc_edit_prepend", 3, [true, true, false])
        .Additive -> ("edit_additive", "jet_gc_edit_additive", 3, [true, true, false])
        .Plain -> ("edit_plain", "jet_gc_edit_plain", 2, [true, false])
        .EdgeSlot -> ("edit_edge_slot", "jet_gc_edit_edge_slot", 4, [true, true, false, false])
    }
    prelude_route_row(MIRPreludeFamily.StaticPrelude, "core.gc", member, symbol, arity, arity, borrow_mask, Val(Effect.Mem), carrier, MIRPreludeABI.Value, "GC edit")
}
