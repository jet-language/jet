// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:9147
pub fn distinct_conversion_route(name: String, source: Type, op: TNumericOp, range: (Int, Int)?, result: Type, carrier: TFailureCarrier) -> TPreludeRoute LowerError! {
    if op == {
        .CheckedIntToFloat{..} -> if source == Type.Int -> prelude_route_row(MIRPreludeFamily.StaticPrelude, "core.numeric", "checked_widen", "jet_std::jet_int_checked_widen", 4, 4, [false, false, true, false], None, carrier, MIRPreludeABI.Value, "integer widening") else -> prelude_route_row(MIRPreludeFamily.StaticPrelude, "core.numeric", "checked_widen", "jet_numeric_checked_widen_at", 5, 5, [false, false, false, true, false], None, carrier, MIRPreludeABI.Value, "numeric widening")
        .TryFrom{..} -> if source == Type.Int -> prelude_route_row(MIRPreludeFamily.StaticPrelude, "core.numeric", "int_try_from", "jet_std::jet_int_try_from_checked", 2, 2, [false, false], None, carrier, MIRPreludeABI.Value, "integer narrowing conversion") else -> prelude_route_row(MIRPreludeFamily.StaticPrelude, "core.numeric", "fixed_try_from", "jet_numeric_try_from_fixed", 3, 3, [false, false, false], None, carrier, MIRPreludeABI.Value, "fixed integer narrowing conversion")
        .InlineRange{..} -> prelude_route_row(MIRPreludeFamily.StaticPrelude, "core.numeric", "inline_range", "jet_inline_range_from_int", 3, 3, [false, false, false], None, carrier, MIRPreludeABI.Value, "inline range conversion")
        .CheckedIntToFixed{..} -> prelude_route_row(MIRPreludeFamily.StaticPrelude, "core.numeric", "int_checked_fixed", "jet_std::jet_int_checked_fixed", 4, 4, [false, false, true, false], None, carrier, MIRPreludeABI.Value, "checked fixed integer construction")
        .FloatToInt{..} -> prelude_route_row(MIRPreludeFamily.StaticPrelude, "core.numeric", "float_to_int", "jet_numeric_float_to_int", 2, 2, [false, false], None, carrier, MIRPreludeABI.Value, "float to integer conversion")
        .FloatNarrow{..} -> prelude_route_row(MIRPreludeFamily.StaticPrelude, "core.numeric", "float_narrow", "jet_numeric_float_narrow", 1, 1, [false], None, carrier, MIRPreludeABI.Value, "float narrowing conversion")
        .CastAs{..} | .Predicate(_) | .BitCount{..} | .ToShow | .EuclideanDiv{..} | .EuclideanRem{..} -> Err(route_error("numeric operation is not a checked distinct conversion"))
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:9272
fn is_measurement_type(ty: Type) -> Bool Never! {
    if ty.without_user_tags() == { .Apply(name, args) -> name == "Measurement" && args.len() == 1 && args[0].without_user_tags() == Type.Float else -> false }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:9282
fn is_measured_conversion_result(ty: Type) -> Bool Never! {
    if ty.without_user_tags() == { .Option(inner) -> is_measurement_type(inner) .Result(ok, _) -> is_measurement_type(ok) else -> false }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:9290
pub fn unit_conversion_route(destination: String, scale: UnitRatio, offset: UnitRatio, rounding: UnitRoundingMode?, relative_uncertainty: Float?, result: Type, carrier: TFailureCarrier) -> TPreludeRoute LowerError! {
    measured :: relative_uncertainty.is_some() && is_measured_conversion_result(result)
    if (rounding, measured) == {
        (None, false) -> prelude_route_row(MIRPreludeFamily.StaticPrelude, "core.units", "conversion_exact", "jet_unit_conversion_exact", 5, 5, [false, true, true, true, true], None, carrier, MIRPreludeABI.Value, "exact unit conversion")
        (None, true) -> prelude_route_row(MIRPreludeFamily.StaticPrelude, "core.units", "conversion_exact_measurement", "jet_std::jet_unit_conversion_exact_measurement", 6, 6, [false, true, true, true, true, false], None, carrier, MIRPreludeABI.Value, "exact measured unit conversion")
        (Val(_), false) -> prelude_route_row(MIRPreludeFamily.StaticPrelude, "core.units", "conversion_rounded", "jet_unit_conversion_rounded", 7, 7, [false, true, true, true, true, false, false], None, carrier, MIRPreludeABI.Value, "rounded unit conversion")
        (Val(_), true) -> prelude_route_row(MIRPreludeFamily.StaticPrelude, "core.units", "conversion_rounded_measurement", "jet_std::jet_unit_conversion_rounded_measurement", 8, 8, [false, true, true, true, true, false, false, false], None, carrier, MIRPreludeABI.Value, "rounded measured unit conversion")
    }
}
