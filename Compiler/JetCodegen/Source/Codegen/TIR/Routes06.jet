pub fn decode_under_route(result: Type, carrier: TFailureCarrier) -> TPreludeRoute LowerError! {
    prelude_route_row(MIRPreludeFamily.StaticPrelude, "core.encoding", "decode_under", "jet_std::FieldError::under", 2, 2, [true, false], None, carrier, MIRPreludeABI.Value, "decode error context")
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:8894
pub fn compare_chain_route(op: BinOp, hook: Bool, left_ty: Type, result: Type, carrier: TFailureCarrier) -> TRoutePlan LowerError! { compare_route(op, hook, result, carrier) }
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:8905
pub fn overflow_opt_route(prefix: String, op: String, line: Int, input: Type, result: Type, carrier: TFailureCarrier) -> TPreludeRoute LowerError! {
    width :: fixed_width_name(input) ?? return Err(route_error("overflow option has no resolved fixed numeric receiver type"))
    checked :: prefix == "checked"
    if checked {
        value :: if result == { .Option(value) -> value else -> return Err(route_error("checked overflow option has no Option result type")) }
        if value != input -> return Err(route_error("checked overflow option has a mismatched payload type"))
        if carrier != .Optional{..} -> return Err(route_error("checked overflow option has a mismatched failure carrier"))
    } else if result != input {
        return Err(route_error("overflow option has a mismatched resolved result type"))
    } else if carrier == .Optional{..} {
        return Err(route_error("value-producing overflow option has an optional failure carrier"))
    }
    (mode, op_name, arity, effect) :: if (prefix, op) == {
        ("checked", "add" | "sub" | "mul" | "div" | "rem" | "pow") -> ("checked", op, 2, None)
        ("checked_policy", "add" | "sub" | "mul" | "div" | "rem" | "pow") -> ("trap", op, 4, Val(Effect.Panic))
        ("wrapping", "add" | "sub" | "mul") -> ("wrapping", op, 2, None)
        ("wrapping", "div" | "pow") -> ("wrapping", op, 4, Val(Effect.Panic))
        ("saturating", "add" | "sub" | "mul") -> ("saturating", op, 2, None)
        ("saturating", "div" | "pow") -> ("saturating", op, 4, Val(Effect.Panic))
        ("rotate_left" | "rotate_right", "rotate") -> (prefix, "rotate", 4, Val(Effect.Panic))
        else -> return Err(route_error("unsupported fixed-width overflow operation `{prefix}_{op}`"))
    }
    symbol :: if prefix == "rotate_left" || prefix == "rotate_right" -> "jet_{width}_{prefix}" else -> "jet_{width}_{mode}_{op_name}"
    member :: "{width}.{prefix}.{op}"
    prelude_route_row(MIRPreludeFamily.Overflow, "core.numeric", member, symbol, arity, arity, [Bool].repeat(false, arity), effect, carrier, MIRPreludeABI.Value, "fixed-width overflow option")
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:8983
pub fn try_conversion_route(convert: TTryConvert, source: Type, result: Type, carrier: TFailureCarrier) -> TPreludeRoute LowerError! {
    if convert == {
        .DefaultErr -> prelude_route_row(MIRPreludeFamily.StaticPrelude, "core.errors", "from_message", "jet_err_from_message", 1, 1, [false], None, TFailureCarrier.Infallible, MIRPreludeABI.Value, "default error conversion")
        .Typed{..} -> Err(route_error("typed error conversion requires checked MIR function lowering"))
        .WidenUnion{..} -> Err(route_error("union error conversion requires checked MIR enum lowering"))
        .ProtocolExit -> prelude_route_row(MIRPreludeFamily.StaticPrelude, "core.errors", "entry_error_exit", "jet_entry_error_exit_jet", 1, 1, [false], Val(Effect.Panic), TFailureCarrier.Diverges(Type.Named(TYPE_NEVER)), MIRPreludeABI.Control, "protocol error exit")
        .NoConversion | .Never -> Err(route_error("bare try propagation has no conversion Prelude route"))
    }
}
