// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:8674
pub fn string_format_route(format: StrFormat, value_ty: Type, result: Type, carrier: TFailureCarrier) -> TPreludeRoute LowerError! {
    integer :: is_int(value_ty)
    (member, symbol, arity, borrow_mask) :: if format == {
        .Display -> ("display", "jet_fmt_display", 1, [true])
        .Debug -> ("debug", "jet_fmt_debug", 1, [true])
        .Pretty -> ("pretty", "jet_fmt_pretty", 1, [true])
        .Unit(_) -> return Err(route_error("unit formatting is lowered through its checked String function"))
        .Fixed(_) -> ("fixed", if integer -> "jet_fmt_decimal_int" else -> "jet_fmt_decimal", 2, [integer, false])
        .Grouped(_) -> ("grouped", if integer -> "jet_fmt_grouped_int" else -> "jet_fmt_grouped", 2, [integer, false])
        .Hex(_) -> ("hex", if integer -> "jet_fmt_hex" else -> "jet_fmt_hex_decimal", 2, [integer, false])
        .Pad{..} -> ("pad", "jet_fmt_pad", 3, [true, false, true])
        .PadLeft{..} -> ("pad_left", "jet_fmt_pad_left", 3, [true, false, true])
        .Sci(_) -> ("sci", "jet_fmt_sci", 2, [integer, false])
        .Percent(_) -> ("percent", "jet_fmt_percent", 2, [integer, false])
        .Bin -> ("bin", if integer -> "jet_fmt_bin" else -> "jet_fmt_bin_decimal", 1, [true])
        .Oct -> ("oct", if integer -> "jet_fmt_oct" else -> "jet_fmt_oct_decimal", 1, [true])
    }
    prelude_route_row(MIRPreludeFamily.StaticPrelude, "core.text.fmt", member, symbol, arity, arity, borrow_mask, None, carrier, MIRPreludeABI.Value, "string interpolation format")
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:8682
fn is_int(ty: Type) -> Bool Never! {
    if ty.without_user_tags() == { .Int | .IntN{..} -> true .InlineRange(base, _, _) -> is_int(base) .Named(name) -> name == "Int" .Tagged(_, inner) -> is_int(inner) else -> false }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:8804
pub fn quantity_format_route(result: Type, carrier: TFailureCarrier) -> TPreludeRoute LowerError! {
    prelude_route_row(MIRPreludeFamily.StaticPrelude, "core.text.fmt", "quantity", "jet_fmt_quantity", 1, 1, [false], None, carrier, MIRPreludeABI.Value, "quantity magnitude formatting")
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:8824
pub fn static_prelude_route(module: String, member: String, borrow_mask: [Bool], result: Type, carrier: TFailureCarrier) -> TPreludeRoute LowerError! {
    effect :: if module == "::JetAtomic" && member == "try_new" -> Val(Effect.Mem) else -> None
    arity :: borrow_mask.len()
    symbol :: if (module, member) == {
        ("::JetAuthority", "from_rights") -> "jet_authority_from_rights"
        ("::JetAuthority", "workspace") -> "jet_authority_workspace"
        ("::JetAuthority", "with") -> "jet_authority_with"
        ("::JetAuthority", "without") -> "jet_authority_without"
        else -> if module.strip_prefix("::") == { .Val(rooted) -> "{rooted}::{member}" else -> "{module}::{member}" }
    }
    plan :: if module.starts_with("::") -> prelude(MIRPreludeFamily.StaticPrelude, module, member, symbol, arity, arity, borrow_mask, effect, carrier, MIRPreludeABI.Value) else -> runtime(MIRPreludeFamily.StaticPrelude, module, member, symbol, arity, arity, borrow_mask, effect, carrier, MIRPreludeABI.Value)
    as_prelude(plan, "static Prelude call")
}
