// One static mask backs all returned borrowed slices; arities above 15 select 16.
HOST_RECV_BORROW_MASK :: [Bool#16]{true, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false}
fn host_recv_borrow_mask(arity: Int) -> View<Bool> Never! { HOST_RECV_BORROW_MASK[0..<min(arity, 16)] }
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:9700
pub fn host_method_route(recv: Type, method: String, arg_count: Int, result: Type, carrier: TFailureCarrier) -> TPreludeRoute LowerError! {
    shape := recv
    loop shape == .Tagged(_, inner) { shape = inner }
    if shape == .Named(full_name) {
        name :: full_name.rsplit("::").next() ?? full_name
        leaf :: name.rsplit('.').next() ?? name
        if leaf == TYPE_BUILD_CONTEXT || leaf == TYPE_PROGRAM_INFO || leaf == TYPE_TYPE_INFO || leaf == "FieldInfo" || leaf == "MethodInfo" || leaf == "CompilerLexed" || leaf == "CompilerSyntaxTree" || leaf == "CompilerChecked" || leaf == "CompilerSourceMap" || leaf == "CompilerPackageError" || leaf == "CompilerDependency" || leaf == "CompilerPackageTarget" || leaf == "CompilerPackageOutput" || leaf == "CompilerBuildProfile" || leaf == "CompilerManifest" || leaf == "CompilerPackage" || leaf == "CompilerLockedPackage" || leaf == "CompilerLock" || leaf == "CompilerKeyValue" || leaf == "CompilerProfile" || leaf == "CompilerProfileSet" {
            member :: "{leaf}.{method}"
            arity :: arg_count.saturating_add(1)
            return prelude_route_row(MIRPreludeFamily.StaticPrelude, "core.host", member, "jet_comptime_host_method", arity, arity, host_recv_borrow_mask(arity), None, carrier, MIRPreludeABI.Value, "comptime host method")
        }
    }
    (member, symbol, arity, borrow_mask) :: if shape == {
        .Apply(name, _) if name == "Pool" -> if method == {
            "add" -> ("Pool.add", "jet_std::JetPool::add", 2, [true, false])
            "remove" -> ("Pool.remove", "jet_std::JetPool::remove", 2, [true, false])
            "ids" -> ("Pool.ids", "jet_std::JetPool::ids", 1, [true])
            else -> return Err(route_error("unknown checked Pool host method `{method}`"))
        }
        .Shared(_) -> if (method, arg_count) == {
            ("get", 0) -> ("Shared.get", "jet_shared_get", 1, [true])
            ("set", 1) -> ("Shared.set", "jet_shared_set", 2, [true, false])
            ("replace", 1) -> ("Shared.replace", "jet_shared_replace", 2, [true, false])
            ("read", 1) -> ("Shared.read", "jet_shared_read", 2, [true, false])
            ("edit", 1) -> ("Shared.edit", "jet_shared_edit", 2, [true, false])
            ("capture", 0) -> ("Shared.capture", "jet_shared_capture", 1, [true])
            ("capture", 1) -> ("Shared.capture", "jet_shared_capture_with", 2, [true, false])
            ("capture_txn", 0) -> ("Shared.capture_txn", "jet_shared_capture_txn_plain", 2, [true, true])
            ("capture_txn", 1) -> ("Shared.capture_txn", "jet_shared_capture_txn", 3, [true, true, false])
            ("try_replace", 2) -> ("Shared.try_replace", "jet_shared_try_replace", 3, [true, false, false])
            ("read_txn", 1) -> ("Shared.read_txn", "jet_shared_read_txn", 3, [true, true, false])
            ("edit_txn", 1) -> ("Shared.edit_txn", "jet_shared_edit_txn", 3, [true, true, false])
            ("guard_read", 0) -> ("Shared.guard_read", "jet_shared_guard_read", 1, [true])
            ("guard_edit", 0) -> ("Shared.guard_edit", "jet_shared_guard_edit", 1, [true])
            ("downgrade", 0) -> ("Shared.downgrade", "jet_shared_downgrade", 1, [true])
            ("strong_count", 0) -> ("Shared.strong_count", "jet_shared_strong_count", 1, [true])
            ("same", 1) -> ("Shared.same", "jet_shared_same", 2, [true, true])
            else -> return Err(route_error("unknown checked Shared host method `{method}`"))
        }
        .Apply(name, _) if name == TYPE_SHARED_SNAPSHOT -> if (method, arg_count) == {
            ("value", 0) -> ("SharedSnapshot.value", "jet_shared_snapshot_value", 1, [true])
            else -> return Err(route_error("unknown checked SharedSnapshot host method `{method}`"))
        }
        .Apply(name, _) if name == TYPE_SHARED_WEAK -> if method == {
            "upgrade" -> ("Shared.Weak.upgrade", "jet_shared_weak_upgrade", 1, [true])
            else -> return Err(route_error("unknown checked Shared.Weak host method `{method}`"))
        }
        .Apply(name, _) if name == "Cell" -> if method == {
            "get" -> ("Cell.get", "jet_cell_get", 1, [true])
            "guard_read" -> ("Cell.guard_read", "jet_cell_guard_read", 1, [true])
            "guard_edit" -> ("Cell.guard_edit", "jet_cell_guard_edit", 1, [true])
            "set" -> ("Cell.set", "jet_cell_set", 2, [true, false])
            "replace" -> ("Cell.replace", "jet_cell_replace", 2, [true, false])
            "read" -> ("Cell.read", "jet_cell_read", 2, [true, false])
            "edit" -> ("Cell.edit", "jet_cell_edit", 2, [true, false])
            "get_or_set" -> ("Cell.get_or_set", "jet_cell_get_or_set", 2, [true, false])
            else -> return Err(route_error("unknown checked Cell host method `{method}`"))
        }
        .Apply(name, _) if name == "CellReadGuard" -> if method == {
            "get" -> ("CellReadGuard.get", "jet_cell_read_guard_get", 1, [true])
            "read" -> ("CellReadGuard.read", "jet_cell_read_guard_read", 2, [true, false])
            else -> return Err(route_error("unknown checked CellReadGuard host method `{method}`"))
        }
        .Apply(name, _) if name == "CellEditGuard" -> if method == {
            "get" -> ("CellEditGuard.get", "jet_cell_edit_guard_get", 1, [true])
            "set" -> ("CellEditGuard.set", "jet_cell_edit_guard_set", 2, [true, false])
            "read" -> ("CellEditGuard.read", "jet_cell_edit_guard_read", 2, [true, false])
            "edit" -> ("CellEditGuard.edit", "jet_cell_edit_guard_edit", 2, [true, false])
            else -> return Err(route_error("unknown checked CellEditGuard host method `{method}`"))
        }
        .Apply(name, _) if name == "ExpiringSecret" -> if method == {
            "with" -> ("ExpiringSecret.with", "jet_expiring_secret_with", 2, [true, false])
            else -> return Err(route_error("unknown checked ExpiringSecret host method `{method}`"))
        }
        else -> return Err(route_error("unknown checked host method `{method}` on `{recv.name()}`"))
    }
    prelude_route_row(MIRPreludeFamily.StaticPrelude, "core.host", member, symbol, arity, arity, borrow_mask, None, carrier, MIRPreludeABI.Value, "runtime host method")
}
