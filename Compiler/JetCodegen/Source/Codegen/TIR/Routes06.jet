// Private fragment of Codegen.TIR.routes; shares the total checked route registry.
use jet_foundation.[Type, BinOp, StrFormat, UnitRatio, UnitRoundingMode, Effect, TFailureCarrier, TGCEditKind, TNumericOp, TTryConvert, TTypedTextForm, MIRTypedHeadKind, MIRPreludeFamily, MIRPreludeABI]
use jet_foundation.Syntax.[TYPE_NEVER, TYPE_BUILD_CONTEXT, TYPE_PROGRAM_INFO, TYPE_TYPE_INFO, TYPE_SHARED_SNAPSHOT, TYPE_SHARED_WEAK]
use jet_codegen.Codegen.TIR.[TPreludeRoute, TRoutePlan, LowerError]
use jet_codegen.Codegen.TIR.Routes.[prelude_route_row, runtime_route_row, route_error, prelude, runtime, as_prelude, compare_route, fixed_width_name]

// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:8487
pub fn geometry_builtin_route(type_name: String, func: String, arity: Int, result: Type, carrier: TFailureCarrier) -> TPreludeRoute LowerError! {
    symbol :: "jet_math_{type_name}_{func}"
    prelude_route_row(MIRPreludeFamily.MathBuiltin, "core.math", "geometry.{type_name}.{func}", symbol, arity, arity, [Bool].repeat(false, arity), None, carrier, MIRPreludeABI.Value, "coordinate-space builtin")
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:8511
fn geometry_method_arity(method: String) -> Int? Never! {
    if method == { "add" | "sub" | "then" | "ray" -> Val(2) "inverse" -> Val(1) "point" -> Val(2) "point_at_depth" -> Val(3) else -> None }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:8521
fn geometry_method_route(type_name: String, method: String, receiver: Type, carrier: TFailureCarrier) -> TRoutePlan LowerError! {
    arity :: geometry_method_arity(method) ?? return Err(route_error("coordinate-space method `{type_name}.{method}` has no registered route"))
    symbol :: "jet_math_{type_name}_{method}"
    borrow_mask := [Bool].repeat(false, arity)
    borrow_mask[0] = true
    Ok(TRoutePlan.Prelude(prelude_route_row(MIRPreludeFamily.MathBuiltin, "core.math", "geometry.{type_name}.{method}", symbol, arity, arity, borrow_mask, None, carrier, MIRPreludeABI.Value, "coordinate-space method")?))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:8551
pub fn precise_builtin_route(type_name: String, func: String, arity: Int, result: Type, carrier: TFailureCarrier) -> TPreludeRoute LowerError! {
    symbol :: if type_name == "Measurement" && func == "new" -> "jet_std::JetMeasurement::new" else -> "jet_{type_name.to_ascii_lowercase()}_{func}"
    by_value :: func == "new" || func == "from_parts" || (func.starts_with("from_") && func != "from_str")
    prelude_route_row(MIRPreludeFamily.PreciseBuiltin, type_name, func, symbol, arity, arity, [Bool].repeat(!by_value, arity), None, carrier, MIRPreludeABI.Value, "precise builtin")
}
