pub fn print_route(result: Type, carrier: TFailureCarrier) -> TPreludeRoute LowerError! {
    prelude_route_row(MIRPreludeFamily.StaticPrelude, "core.term", "print", "jet_term_write_stdout_line", 2, 2, [true, false], Val(Effect.IO), carrier, MIRPreludeABI.Effect, "print")
}
