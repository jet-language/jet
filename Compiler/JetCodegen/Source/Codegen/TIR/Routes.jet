// Total checked operation routes shared by every TIR consumer.
// No backend inference: primitive plans are expanded structurally into MIR.
use jet_foundation.[Type, Span, Effect]
use jet_foundation.MIR.[MirCallSignature, MirPreludeAbi, MirPreludeFamily, MirSymbol]
use jet_codegen.TIR.[LowerError, TClosureOp, TNumericOp, TFailureCarrier, TPreludeRoute, TRoutePlan, TZipMode]
use jet_codegen.TIR.Routes04.[h]
use jet_syntax as Syntax

// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:23
fn route_error(message: String) -> LowerError Never! { LowerError.new(Span.new(0, 0), message) }
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:32
pub struct TLoopRouteBundle {
    pub range_init: TPreludeRoute
    pub range_has_next: TPreludeRoute
    pub range_value: TPreludeRoute
    pub range_advance: TPreludeRoute
    pub iter_init: TPreludeRoute
    pub iter_has_next: TPreludeRoute
    pub iter_value: TPreludeRoute
    pub iter_advance: TPreludeRoute
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:48
pub fn loop_route_bundle() -> TLoopRouteBundle Never! {
    carrier :: TFailureCarrier.Infallible
    row :: fn(member: String, symbol: String, arity: USize, borrow_mask: [Bool]) {
        TPreludeRoute{family: MirPreludeFamily.StaticPrelude, module: "core.prelude", member: member,
            symbol: MirSymbol.Prelude(symbol), signature: MirCallSignature{arity: arity, max_arity: arity, borrow_mask: borrow_mask},
            effect: None, fallibility: carrier, abi: MirPreludeAbi.Value, authority: None, db_metadata: None}
    }
    TLoopRouteBundle{
        range_init: row("loop_range_init", "jet_loop_range_init", 5, [Bool]{false, false, false, false, false}),
        range_has_next: row("loop_range_has_next", "jet_loop_range_has_next", 1, [Bool]{true}),
        range_value: row("loop_range_value", "jet_loop_range_value", 1, [Bool]{true}),
        range_advance: row("loop_range_advance", "jet_loop_range_advance", 1, [Bool]{true}),
        iter_init: row("loop_iter_init", "jet_loop_iter_init", 5, [Bool]{false, false, false, false, false}),
        iter_has_next: row("loop_iter_has_next", "jet_loop_iter_has_next", 1, [Bool]{true}),
        iter_value: row("loop_iter_value", "jet_loop_iter_value", 1, [Bool]{true}),
        iter_advance: row("loop_iter_advance", "jet_loop_iter_advance", 1, [Bool]{true})}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:88
pub fn zip_closure_route(mode: TZipMode) -> TPreludeRoute Never! {
    (member, symbol, arity) :: if mode == { .Short -> ("zip", "jet_iter_zip", 3); .Strict -> ("zip_strict", "jet_iter_zip_strict", 10); .Pad -> ("zip_pad", "jet_iter_zip_pad", 5) }
    TPreludeRoute{family: MirPreludeFamily.ClosureMethod, module: "core.iter", member: member,
        symbol: MirSymbol.Prelude(symbol), signature: MirCallSignature{arity: arity, max_arity: arity, borrow_mask: [Bool].repeat(false, arity)},
        effect: None, fallibility: TFailureCarrier.Infallible, abi: MirPreludeAbi.Value, authority: None, db_metadata: None}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:112
fn prelude(family: MirPreludeFamily, module: String, member: String, symbol: String, arity: USize, max_arity: USize, borrow_mask: [Bool], effect: Effect?, carrier: TFailureCarrier, abi: MirPreludeAbi) -> TRoutePlan Never! {
    TRoutePlan.Prelude(TPreludeRoute{family: family, module: module, member: member, symbol: MirSymbol.Prelude(symbol),
        signature: MirCallSignature{arity: arity, max_arity: max_arity, borrow_mask: ~borrow_mask}, effect: effect,
        fallibility: ~carrier, abi: abi, authority: None, db_metadata: None})
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:142
fn primitive() -> TRoutePlan Never! { TRoutePlan.Primitive }
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:146
fn as_prelude(plan: TRoutePlan, name: String) -> TPreludeRoute LowerError! {
    if plan == { .Prelude(route) -> Ok(^route); .Primitive -> Err(route_error("checked operation `{name}` requires structural MIR lowering")) }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:154
fn closure_receiver_kind(receiver: Type) -> String? Never! {
    if receiver == {
        .Tagged{inner, ..} -> closure_receiver_kind(inner)
        .List(_) | .FixedList{..} -> Val("list")
        .Apply{name, args} if args.len() == 1 && (name == "Iter" || name == "ViewIter") -> Val("iter")
        .Apply{name, args} if args.len() == 1 && (name == "View" || name == "ViewMut" || name == "ComputeViewMut") -> Val("view")
        .Option(_) -> Val("option")
        .Map{..} -> Val("map")
        .Apply{name, ..} if name == Syntax.TYPE_TALLY -> Val("bag")
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:176
fn collection_closure_route(op: TClosureOp, receiver: Type, carrier: TFailureCarrier) -> TRoutePlan LowerError! {
    kind :: closure_receiver_kind(receiver) ?? return Err(route_error("checked closure operation `{op:?}` has an unsupported receiver type"))
    (module, member, symbol, arity, borrow_mask) :: if (op, kind) == {
        (.Map, "list") -> ("core.list", "map", "jet_list_map", 2, [Bool]{false, false})
        (.Map, "iter") -> ("core.iter", "map", "jet_iter_map", 2, [Bool]{false, false})
        (.MapMut, "list") -> ("core.list", "map_mut", "jet_list_map_mut", 2, [Bool]{false, false})
        (.MapMut, "iter") -> ("core.iter", "map_mut", "jet_iter_map_mut", 2, [Bool]{false, false})
        (.TryMap, "list") -> ("core.list", "try_map", "jet_list_try_map", 2, [Bool]{false, false})
        (.TryMap, "iter") -> ("core.iter", "try_map", "jet_iter_try_map", 2, [Bool]{false, false})
        (.TryMap, "view") -> ("core.view", "try_map", "jet_view_try_map", 2, [Bool]{true, false})
        (.Filter, "list") -> ("core.list", "filter", "jet_list_filter", 2, [Bool]{false, false})
        (.Filter, "iter") -> ("core.iter", "filter", "jet_iter_filter", 2, [Bool]{false, false})
        (.FilterMap, "list") -> ("core.list", "filter_map", "jet_list_filter_map_iter", 2, [Bool]{false, false})
        (.FilterMap, "iter") -> ("core.iter", "filter_map", "jet_iter_filter_map", 2, [Bool]{false, false})
        (.TryFilter, "list") -> ("core.list", "try_filter", "jet_list_try_filter", 2, [Bool]{false, false})
        (.TryFilter, "iter") -> ("core.iter", "try_filter", "jet_iter_try_filter", 2, [Bool]{false, false})
        (.TryFilter, "view") -> ("core.view", "try_filter", "jet_view_try_filter", 2, [Bool]{true, false})
        (.Each | .EachMut, "list" | "iter") -> if op is .Each -> ("core.list", "each", "jet_list_each", 2, [Bool]{false, false}) else -> ("core.list", "each_mut", "jet_list_each_mut", 2, [Bool]{false, false})
        (.Find, "list" | "iter") -> ("core.list", "find", "jet_list_find", 2, [Bool]{false, false})
        (.Any, "list" | "iter") -> ("core.list", "any", "jet_list_any", 2, [Bool]{false, false})
        (.All, "list" | "iter") -> ("core.list", "all", "jet_list_all", 2, [Bool]{false, false})
        (.Reduce, "list" | "iter") -> ("core.list", "reduce", "jet_list_reduce", 3, [Bool]{false, false, false})
        (.TakeWhile, "list") -> ("core.list", "take_while", "jet_list_take_while_iter", 2, [Bool]{false, false})
        (.TakeWhile, "iter") -> ("core.iter", "take_while", "jet_iter_take_while", 2, [Bool]{false, false})
        (.SkipWhile, "list") -> ("core.list", "skip_while", "jet_list_skip_while_iter", 2, [Bool]{false, false})
        (.SkipWhile, "iter") -> ("core.iter", "skip_while", "jet_iter_skip_while", 2, [Bool]{false, false})
        (.FlatMap, "list") -> ("core.list", "flat_map", "jet_list_flat_map", 2, [Bool]{false, false})
        (.FlatMap, "iter") -> ("core.iter", "flat_map", "jet_iter_flat_map", 2, [Bool]{false, false})
        (.Position, "list" | "iter") -> ("core.list", "position", "jet_list_position", 2, [Bool]{false, false})
        (.MinBy, "list" | "iter") -> ("core.list", "min_by", "jet_list_min_by", 2, [Bool]{false, false})
        (.MaxBy, "list" | "iter") -> ("core.list", "max_by", "jet_list_max_by", 2, [Bool]{false, false})
        (.GroupBy, "list" | "iter") -> ("core.list", "group_by", "jet_list_group_by", 2, [Bool]{false, false})
        (.CountBy, "list" | "iter") -> ("core.list", "count_by", "jet_list_count_by", 2, [Bool]{false, false})
        (.Scan, "list") -> ("core.list", "scan", "jet_list_scan_iter", 3, [Bool]{false, false, false})
        (.Scan, "iter") -> ("core.iter", "scan", "jet_iter_scan", 3, [Bool]{false, false, false})
        (.OptionMap, "option") -> ("core.option", "map", "jet_option_map_ref", 2, [Bool]{true, false})
        (.BagAny, "bag") -> ("core.bag", "any", "jet_bag_any", 2, [Bool]{true, false})
        else -> return Err(route_error("checked closure operation `{op:?}` has no Prelude route for receiver `{kind}`"))
    }
    Ok(prelude(MirPreludeFamily.ClosureMethod, module, member, symbol, arity, arity, borrow_mask, None, carrier, MirPreludeAbi.Value))
}

impl TClosureOp {
    // Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:417
    pub fn route_plan(self, receiver: Type, _result: Type, carrier: TFailureCarrier) -> TRoutePlan LowerError! {
        // Each row is the original checked helper, including its borrow/effect/ABI facts.
        (module, member, symbol, arity, mask, effect, abi) :: if self == {
            .EditDisjoint -> ("core.collections", "edit_disjoint", "jet_edit_disjoint", 3, [Bool]{true, true, false}, None, MirPreludeAbi.Value)
            .EachRef -> ("core.collections", "each_ref", "jet_list_each_ref", 2, [Bool]{true, false}, None, MirPreludeAbi.Value)
            .EachMap -> ("core.map", "each", "jet_map_each", 2, [Bool]{false, false}, None, MirPreludeAbi.Value)
            .MapAny -> ("core.map", "any", "jet_map_any", 2, [Bool]{false, false}, None, MirPreludeAbi.Value)
            .MapAll -> ("core.map", "all", "jet_map_all", 2, [Bool]{false, false}, None, MirPreludeAbi.Value)
            .MapFilter -> ("core.map", "filter", "jet_map_filter", 2, [Bool]{false, false}, None, MirPreludeAbi.Value)
            .MapMap -> ("core.map", "map", "jet_map_map_values", 2, [Bool]{false, false}, None, MirPreludeAbi.Value)
            .MapFold -> ("core.map", "fold", "jet_map_fold", 3, [Bool]{false, false, false}, None, MirPreludeAbi.Value)
            .MapFlatMap -> ("core.map", "flat_map", "jet_map_flat_map", 2, [Bool]{false, false}, None, MirPreludeAbi.Value)
            .ListBinarySearchBy -> ("core.list", "binary_search_by", "jet_list_binary_search_by", 2, [Bool]{true, false}, None, MirPreludeAbi.Value)
            .ListMinMaxBy{..} -> ("core.list", "min_max_by", "jet_list_min_max_by", 2, [Bool]{true, false}, None, MirPreludeAbi.Aggregate)
            .CountWhere -> ("core.list", "count_where", "jet_list_count_where", 2, [Bool]{true, false}, None, MirPreludeAbi.Value)
            .SortBy -> ("core.list", "sort_by", "jet_list_sort_by", 2, [Bool]{true, false}, None, MirPreludeAbi.Value)
            .SortByDesc -> ("core.list", "sort_by_desc", "jet_list_sort_by_desc", 2, [Bool]{true, false}, None, MirPreludeAbi.Value)
            .TrySortBy -> ("core.list", "try_sort_by", "jet_list_try_sort_by", 2, [Bool]{true, false}, None, MirPreludeAbi.Value)
            .TrySortByDesc -> ("core.list", "try_sort_by_desc", "jet_list_try_sort_by_desc", 2, [Bool]{true, false}, None, MirPreludeAbi.Value)
            .SortByCompare -> ("core.list", "sort_by_compare", "jet_list_sort_by_compare", 2, [Bool]{true, false}, None, MirPreludeAbi.Value)
            .ParaMap -> ("core.list", "para_map", "jet_list_para_map", 3, [Bool]{false, false, false}, None, MirPreludeAbi.Value)
            .ParaFilter -> ("core.list", "para_filter", "jet_list_para_filter", 2, [Bool]{false, false}, None, MirPreludeAbi.Value)
            .ParaPartition{..} -> ("core.list", "para_partition", "jet_list_para_partition", 2, [Bool]{false, false}, None, MirPreludeAbi.Aggregate)
            .FloatAddFold{f32} -> ("core.list", if f32 -> "fold_add_fixed_f32" else -> "fold_add_fixed_f64", if f32 -> "jet_list_fold_add_fixed_f32" else -> "jet_list_fold_add_fixed_f64", 2, [Bool]{false, false}, None, MirPreludeAbi.Value)
            .FloatAddParaFold{f32} -> ("core.list", if f32 -> "para_fold_add_fixed_f32" else -> "para_fold_add_fixed_f64", if f32 -> "jet_list_para_fold_add_fixed_f32" else -> "jet_list_para_fold_add_fixed_f64", 2, [Bool]{false, false}, None, MirPreludeAbi.Value)
            .ParaFold -> ("core.list", "para_fold", "jet_list_para_fold", 4, [Bool]{false, false, false, false}, None, MirPreludeAbi.Value)
            .FilterMap -> return collection_closure_route(self, receiver, carrier)
            .DedupBy -> ("core.iter", "dedup_by", "jet_iter_dedup_by", 2, [Bool]{false, false}, None, MirPreludeAbi.Value)
            .IsSortedBy -> ("core.iter", "is_sorted_by", "jet_iter_is_sorted_by", 2, [Bool]{false, false}, None, MirPreludeAbi.Value)
            .ChunkWhile -> ("core.iter", "chunk_while", "jet_iter_chunk_while", 2, [Bool]{false, false}, None, MirPreludeAbi.Value)
            .Scan -> return collection_closure_route(self, receiver, carrier)
            .Fold -> ("core.list", "fold", "jet_list_fold", 3, [Bool]{false, false, false}, None, MirPreludeAbi.Value)
            .ViewFold -> ("core.view", "fold", "jet_view_fold", 3, [Bool]{true, false, false}, None, MirPreludeAbi.Value)
            .ViewMap -> ("core.view", "map", "jet_view_map", 2, [Bool]{true, false}, None, MirPreludeAbi.Value)
            .UpdateFirst -> ("core.list", "update_first", "jet_list_update_first", 3, [Bool]{true, false, false}, Val(Effect.Mem), MirPreludeAbi.Value)
            .Partition{..} -> ("core.list", "partition", "jet_list_partition", 2, [Bool]{false, false}, None, MirPreludeAbi.Aggregate)
            .Map | .MapMut | .TryMap | .Filter | .TryFilter | .Each | .EachMut | .Find | .Any | .BagAny | .All | .Reduce | .TakeWhile | .SkipWhile | .FlatMap | .Position | .MinBy | .MaxBy | .GroupBy | .CountBy | .OptionMap -> return collection_closure_route(self, receiver, carrier)
        }
        Ok(prelude(MirPreludeFamily.ClosureMethod, module, member, symbol, arity, arity, mask, effect, carrier, abi))
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:827
    pub fn prelude_route(self, receiver: Type, result: Type, carrier: TFailureCarrier) -> TPreludeRoute LowerError! {
        as_prelude(self.route_plan(receiver, result, carrier)?, "closure method")
    }
}
impl TNumericOp {
    // Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:841
    pub fn route_plan(self, _result: Type, carrier: TFailureCarrier) -> TRoutePlan LowerError! {
        plan :: if self == {
            .EuclideanDiv{..} -> prelude(MirPreludeFamily.Overflow, "core.numeric", "div_euclid", "jet_std::jet_int_div_euclid", 2, 2, [Bool]{false, false}, None, carrier, MirPreludeAbi.Value)
            .EuclideanRem{..} -> prelude(MirPreludeFamily.Overflow, "core.numeric", "rem_euclid", "jet_std::jet_int_rem_euclid", 2, 2, [Bool]{false, false}, None, carrier, MirPreludeAbi.Value)
            .Predicate(method) -> {
                (member, symbol) :: if method == {
                    "is_nan" -> ("is_nan", "jet_std_math_is_nan")
                    "is_infinite" -> ("is_infinite", "jet_std_math_is_infinite")
                    "is_finite" -> ("is_finite", "jet_std_math_is_finite")
                    else -> return Err(route_error("unknown numeric predicate `{method}`"))
                }
                prelude(MirPreludeFamily.BuiltinMethod, "core.math", member, symbol, 1, 1, [Bool]{false}, None, carrier, MirPreludeAbi.Value)
            }
            else -> primitive()
        }
        Ok(^plan)
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:897
    pub fn prelude_route(self, result: Type, carrier: TFailureCarrier) -> TPreludeRoute LowerError! {
        as_prelude(self.route_plan(result, carrier)?, "numeric method")
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:906
fn watch_receiver_kind(receiver: Type) -> String? Never! {
    if receiver == {
        .Tagged{inner, ..} | .InlineRange{base: inner, ..} -> watch_receiver_kind(inner)
        .Named(name) if name == "WatchHandle" || name == "WatchSet" -> Val(name)
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:918
fn watch_route(receiver: Type, method: String, carrier: TFailureCarrier) -> TRoutePlan LowerError! {
    kind :: watch_receiver_kind(receiver) ?? return Err(route_error("checked watch method `{method}` has an unsupported receiver type"))
    Ok(if (kind, method) == {
        ("WatchHandle", "poll" | "events") -> h("watch.poll", "jet_jit_watch_poll", 1, 1, [Bool]{true}, Val(Effect.IO), carrier)
        ("WatchHandle", "cancel") -> h("watch.cancel", "jet_jit_watch_cancel", 1, 1, [Bool]{true}, Val(Effect.IO), carrier)
        ("WatchHandle", "is_active") -> h("watch.is_active", "jet_jit_watch_is_active", 1, 1, [Bool]{true}, None, carrier)
        ("WatchHandle", "summary") -> h("watch.summary", "jet_jit_watch_summary", 1, 1, [Bool]{true}, None, carrier)
        ("WatchHandle", "on") -> prelude(MirPreludeFamily.ClosureMethod, "core.watcher", "on", "jet_jit_watch_on", 3, 3, [Bool]{true, true, false}, Val(Effect.IO), carrier, MirPreludeAbi.Value)
        ("WatchHandle", "once") -> prelude(MirPreludeFamily.ClosureMethod, "core.watcher", "once", "jet_jit_watch_once", 3, 3, [Bool]{true, true, false}, Val(Effect.IO), carrier, MirPreludeAbi.Value)
        ("WatchSet", "add") -> h("watchset.add", "jet_jit_watchset_add", 2, 2, [Bool]{true, true}, Val(Effect.IO), carrier)
        ("WatchSet", "poll" | "events") -> h("watchset.poll", "jet_jit_watchset_poll", 1, 1, [Bool]{true}, Val(Effect.IO), carrier)
        ("WatchSet", "summary") -> h("watchset.summary", "jet_jit_watchset_summary", 1, 1, [Bool]{true}, None, carrier)
        else -> return Err(route_error("unknown checked watch method `{kind}.{method}`"))
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:1024
fn event_receiver_kind(receiver: Type) -> String? Never! {
    if receiver == {
        .Tagged{inner, ..} | .InlineRange{base: inner, ..} -> event_receiver_kind(inner)
        .Apply{name, ..} | .Named(name) if (if name == { "Event" | "AsyncEvent" | "Hook" | "DecisionHook" | "Subscription" | "EventScope" | "EventTrace" | "DispatchReport" -> true; else -> false }) -> Val(name)
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/routes.rs:1048
fn event_route(receiver: Type, method: String, carrier: TFailureCarrier) -> TRoutePlan LowerError! {
    kind :: event_receiver_kind(receiver) ?? return Err(route_error("checked event method `{method}` has an unsupported receiver type"))
    (symbol, arity, max_arity, mask) :: if (kind, method) == {
        ("Event", "on") -> ("jet_std::JetEvent::on", 3, 3, [Bool]{true, true, false})
        ("Event", "once") -> ("jet_std::JetEvent::once", 3, 3, [Bool]{true, true, false})
        ("Event", "on_priority") -> ("jet_std::JetEvent::on_priority", 4, 4, [Bool]{true, true, false, false})
        ("Event", "emit") -> ("jet_std::JetEvent::emit", 2, 2, [Bool]{true, false})
        ("Event", "listener_count") -> ("jet_std::JetEvent::listener_count", 1, 1, [Bool]{true})
        ("Event", "trace") -> ("jet_std::JetEvent::trace", 1, 1, [Bool]{true})
        ("AsyncEvent", "on") -> ("jet_std::JetAsyncEvent::on", 3, 3, [Bool]{true, true, false})
        ("AsyncEvent", "once") -> ("jet_std::JetAsyncEvent::once", 3, 3, [Bool]{true, true, false})
        ("AsyncEvent", "on_priority") -> ("jet_std::JetAsyncEvent::on_priority", 4, 4, [Bool]{true, true, false, false})
        ("AsyncEvent", "emit_async") -> (if carrier is .Result{..} -> "jet_std::JetAsyncEvent::emit_async_result" else -> "jet_std::JetAsyncEvent::emit_async", 2, 2, [Bool]{true, false})
        ("AsyncEvent", "close") -> ("jet_std::JetAsyncEvent::close", 1, 1, [Bool]{true})
        ("AsyncEvent", "listener_count") -> ("jet_std::JetAsyncEvent::listener_count", 1, 1, [Bool]{true})
        ("AsyncEvent", "queued_count") -> ("jet_std::JetAsyncEvent::queued_count", 1, 1, [Bool]{true})
        ("AsyncEvent", "running_count") -> ("jet_std::JetAsyncEvent::running_count", 1, 1, [Bool]{true})
        ("AsyncEvent", "blocked_count") -> ("jet_std::JetAsyncEvent::blocked_count", 1, 1, [Bool]{true})
        ("Hook", "on") -> ("jet_std::JetHook::on", 3, 3, [Bool]{true, true, false})
        ("Hook", "once") -> ("jet_std::JetHook::once", 3, 3, [Bool]{true, true, false})
        ("Hook", "on_priority") -> ("jet_std::JetHook::on_priority", 4, 4, [Bool]{true, true, false, false})
        ("Hook", "run") -> ("jet_std::JetHook::run", 3, 3, [Bool]{true, false, false})
        ("Hook", "listener_count") -> ("jet_std::JetHook::listener_count", 1, 1, [Bool]{true})
        ("Hook", "trace") -> ("jet_std::JetHook::trace", 1, 1, [Bool]{true})
        ("DecisionHook", "on") -> ("jet_std::JetDecisionHook::on", 3, 3, [Bool]{true, true, false})
        ("DecisionHook", "once") -> ("jet_std::JetDecisionHook::once", 3, 3, [Bool]{true, true, false})
        ("DecisionHook", "on_priority") -> ("jet_std::JetDecisionHook::on_priority", 4, 4, [Bool]{true, true, false, false})
        ("DecisionHook", "run") -> ("jet_std::JetDecisionHook::run", 2, 2, [Bool]{true, false})
        ("DecisionHook", "listener_count") -> ("jet_std::JetDecisionHook::listener_count", 1, 1, [Bool]{true})
        ("Subscription", "unsubscribe") -> ("jet_std::JetSubscription::unsubscribe", 1, 1, [Bool]{true})
        ("Subscription", "is_active") -> ("jet_std::JetSubscription::active", 1, 1, [Bool]{true})
        ("EventScope", "cancel") -> ("jet_std::JetEventScope::cancel", 1, 1, [Bool]{true})
        ("EventScope", "active_count") -> ("jet_std::JetEventScope::active_count", 1, 1, [Bool]{true})
        ("EventTrace", "summary") -> ("jet_std::JetEventTrace::summary", 1, 1, [Bool]{true})
        ("EventTrace", "delivered") -> ("jet_std::JetEventTrace::delivered", 1, 1, [Bool]{true})
        ("EventTrace", "queued") -> ("jet_std::JetEventTrace::queued", 1, 1, [Bool]{true})
        ("EventTrace", "dropped") -> ("jet_std::JetEventTrace::dropped", 1, 1, [Bool]{true})
        ("DispatchReport", "state") -> ("jet_std::JetDispatchReport::state", 1, 1, [Bool]{true})
        ("DispatchReport", "accepted") -> ("jet_std::JetDispatchReport::accepted", 1, 1, [Bool]{true})
        ("DispatchReport", "delivered_handlers") -> ("jet_std::JetDispatchReport::delivered_handlers", 1, 1, [Bool]{true})
        ("DispatchReport", "failures") -> ("jet_std::JetDispatchReport::failures", 1, 1, [Bool]{true})
        ("DispatchReport", "trace") -> ("jet_std::JetDispatchReport::trace", 1, 1, [Bool]{true})
