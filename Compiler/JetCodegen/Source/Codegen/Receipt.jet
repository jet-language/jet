// Checked Codable projection for structured interpreter receipt attachments.
// Only checked MIR type rows and wire metadata determine JSON keys.
use JetFoundation.MIR.[MirRuntimeValue, MirConstKey, MirSerdeAttributeKind, MirType, MirTypeDef, MirTypeDefKind, MirTypeKind, MirVariantPayload, MirProgram, MirField, MirVariant]
use JetFoundation.Shape.ShapeProjectionKind

// Rust: crates/jet-codegen/src/Codegen/Receipt.rs:14
const JSON_OBJECT: String = "JSONObject"
// Rust: crates/jet-codegen/src/Codegen/Receipt.rs:15
fn field_json_name(field: &MirField) -> String Never! {
    field.shape_names.name_for(ShapeProjectionKind.Json).expect("checked receipt fields always have a JSON projection name")
}
// Rust: crates/jet-codegen/src/Codegen/Receipt.rs:22
fn object(fields: [(String, MirRuntimeValue)]) -> MirRuntimeValue Never! {
    MirRuntimeValue.Struct { type_name: JSON_OBJECT.to_string(), fields: ^fields }
}
// Rust: crates/jet-codegen/src/Codegen/Receipt.rs:29
fn type_definition(program: &MirProgram, ty: &MirType) -> &MirTypeDef? Never! {
    if ty.identity is Some(id) {
        for definition in program.types { if definition.id == id { return Some(&definition) } }
    }
    None
}
// Rust: crates/jet-codegen/src/Codegen/Receipt.rs:37
fn is_u8(ty: &MirType) -> Bool Never! {
    match ty.kind() { MirTypeKind.IntN { signed: false, bits: 8 } => true, _ => false }
}
// Rust: crates/jet-codegen/src/Codegen/Receipt.rs:47
fn encode_byte_values(values: &[MirRuntimeValue]) -> MirRuntimeValue Err! {
    bytes: [U8] := []
    for value in values {
        byte :: match value {
            MirRuntimeValue.Int(number) => U8.try_from(number).map_err(fn(_) { "receipt byte list contains an out-of-range value" })
            MirRuntimeValue.BigInt(number) => number.parse<U8>().map_err(fn(_) { "receipt byte list contains an out-of-range value" })
            _ => Err("receipt byte list contains a non-integer value")
        }
        bytes.push(byte)
    }
    MirRuntimeValue.Bytes(^bytes)
}
// Rust: crates/jet-codegen/src/Codegen/Receipt.rs:62
fn encode_fields(program: &MirProgram, source: &[(String, MirRuntimeValue)], fields: &[MirField]) -> [(String, MirRuntimeValue)] Err! {
    seen: [String: Bool] := [:]
    for (name, _) in source {
        if seen.contains_key(name) { return Err("receipt record repeats checked field `{name}`") }
        seen.insert(name.clone(), true)
        if !fields.iter().any(fn(field) { field.name == name }) {
            return Err("receipt record has unknown checked field `{name}`")
        }
    }
    encoded: [(String, MirRuntimeValue)] := []
    for field in fields {
        if field.skip { continue }
        pair :: source.iter().find(fn(pair) { pair.0 == field.name }).ok_or_else(fn() { "receipt value is missing checked field `{field.name}`" })
        value := &pair.1
        if field.ty.kind() is MirTypeKind.Option(_) {
            if value is MirRuntimeValue.Absent { .. } { continue }
        }
        item :: encode_value(program, value, &field.ty)
        encoded.push((field_json_name(field).to_string(), ^item))
    }
    ^encoded
}
// Rust: crates/jet-codegen/src/Codegen/Receipt.rs:100
fn serde_tag(definition: &MirTypeDef) -> String? Never! {
    for attribute in definition.serde {
        if attribute.kind == MirSerdeAttributeKind.Tag {
            if attribute.value is Some(value) { return Some(value.clone()) }
        }
    }
    None
}
// Rust: crates/jet-codegen/src/Codegen/Receipt.rs:108
fn serde_untagged(definition: &MirTypeDef) -> Bool Never! {
    definition.serde.iter().any(fn(attribute) { attribute.kind == MirSerdeAttributeKind.Untagged })
}
// Rust: crates/jet-codegen/src/Codegen/Receipt.rs:115
fn encode_enum(program: &MirProgram, value: &MirRuntimeValue, variants: &[MirVariant], definition: &MirTypeDef) -> MirRuntimeValue Err! {
    match value {
        MirRuntimeValue.Enum { variant: source_variant, args, .. } => {
            variant :: variants.iter().find(fn(candidate) { candidate.name == source_variant }).ok_or_else(fn() {
                "receipt value `{definition.name}` has unknown enum variant `{source_variant}`"
            })
            payload: MirRuntimeValue? := None
            match variant.payload {
                MirVariantPayload.Unit => {
                    if !args.is_empty() { return Err("receipt enum variant `{variant.name}` has an unexpected payload") }
                }
                MirVariantPayload.Single(ty) => {
                    pair :: args.first().ok_or_else(fn() { "receipt enum variant `{variant.name}` is missing its payload" })
                    if args.len() != 1 { return Err("receipt enum variant `{variant.name}` has too many payload values") }
                    encoded :: encode_value(program, &pair.1, ty)
                    payload = Some(^encoded)
                }
                MirVariantPayload.Named(fields) => {
                    if args.len() != fields.len() {
                        return Err("receipt enum variant `{variant.name}` has {args.len()} payload values; checked shape needs {fields.len()}")
                    }
                    encoded: [(String, MirRuntimeValue)] := []
                    for (index, field) in fields.iter().enumerate() {
                        if field.skip { continue }
                        labeled := args.iter().find_map(fn(pair) {
                            if pair.0.as_deref() == Some(field.name.as_str()) { Some(&pair.1) } else { None }
                        })
                        positional: &MirRuntimeValue? := None
                        if args.iter().all(fn(pair) { pair.0.is_none() }) {
                            positional = args.get(index).map(fn(pair) { &pair.1 })
                        }
                        source :: labeled.or(positional).ok_or_else(fn() { "receipt enum variant `{variant.name}` is missing checked field `{field.name}`" })
                        item :: encode_value(program, source, &field.ty)
                        encoded.push((field_json_name(field).to_string(), ^item))
                    }
                    payload = Some(object(^encoded))
                }
            }
            if serde_untagged(definition) { return payload.unwrap_or(MirRuntimeValue.Unit) }
            wire := variant.wire_name.clone()
            if serde_tag(definition) is Some(tag) {
                fields := [(tag, MirRuntimeValue.String(wire))]
                match payload {
                    None => {}
                    Some(item) => {
                        if variant.payload is MirVariantPayload.Single(_) { fields.push(("value", ^item)) }
                        else {
                            match item {
                                MirRuntimeValue.Struct { fields: nested, .. } => fields.extend(^nested)
                                _ => return Err("receipt enum variant `{variant.name}` has an invalid named payload")
                            }
                        }
                    }
                }
                return object(^fields)
            }
            match payload {
                None => MirRuntimeValue.String(^wire)
                Some(item) => object([(^wire, ^item)])
            }
        }
        _ => Err("receipt value `{definition.name}` is not an enum carrier")
    }
}
// Rust: crates/jet-codegen/src/Codegen/Receipt.rs:229
fn encode_definition(program: &MirProgram, value: &MirRuntimeValue, definition: &MirTypeDef) -> MirRuntimeValue Err! {
    match definition.kind {
        MirTypeDefKind.Struct { fields, .. } => {
            match value {
                MirRuntimeValue.Struct { fields: source, .. } => {
                    encoded :: encode_fields(program, source, fields)
                    object(^encoded)
                }
                _ => Err("receipt value `{definition.name}` is not a record carrier")
            }
        }
        MirTypeDefKind.Enum { variants, .. } => encode_enum(program, value, variants, definition)
        MirTypeDefKind.Distinct { base, .. } => encode_value(program, value, base)
        MirTypeDefKind.Alias { target } => encode_value(program, value, target)
        MirTypeDefKind.UnitFamily { .. } => Err("receipt type `{definition.name}` has no checked Codable variant metadata")
    }
}
// Rust: crates/jet-codegen/src/Codegen/Receipt.rs:256
fn encode_option(program: &MirProgram, value: &MirRuntimeValue, inner: &MirType) -> MirRuntimeValue Err! {
    match value {
        MirRuntimeValue.Present(item) => encode_value(program, item, inner)
        MirRuntimeValue.Absent { .. } => MirRuntimeValue.Unit
        MirRuntimeValue.FailedTold(_) => Err("receipt Option carries a told failure")
        _ => Err("receipt Option has an invalid result carrier")
    }
}
// Rust: crates/jet-codegen/src/Codegen/Receipt.rs:269
fn encode_result(program: &MirProgram, value: &MirRuntimeValue, ok: &MirType) -> MirRuntimeValue Err! {
    match value {
        MirRuntimeValue.Present(item) => encode_value(program, item, ok)
        MirRuntimeValue.Absent { .. } => MirRuntimeValue.Unit
        MirRuntimeValue.FailedTold(_) => Err("receipt Result has a non-Codable error carrier")
        _ => Err("receipt Result has an invalid result carrier")
    }
}
// Rust: crates/jet-codegen/src/Codegen/Receipt.rs:282
fn encode_value(program: &MirProgram, value: &MirRuntimeValue, ty: &MirType) -> MirRuntimeValue Err! {
    if ty.kind() is MirTypeKind.Apply { name, args } {
        match name.name {
            "List" if args.len() == 1 => return encode_value(program, value, &MirType.from_kind(MirTypeKind.List(args[0].clone())))
            "Shared" if args.len() == 1 => return encode_value(program, value, &MirType.from_kind(MirTypeKind.Shared(args[0].clone())))
            "Option" if args.len() == 1 => return encode_option(program, value, &args[0])
            "Result" if args.len() == 2 => return encode_result(program, value, &args[0])
            _ => {}
        }
    }
    if type_definition(program, ty) is Some(definition) { return encode_definition(program, value, definition) }
    match ty.kind() {
        MirTypeKind.Int | MirTypeKind.IntN { .. } | MirTypeKind.Measure(_) => match value {
            MirRuntimeValue.Int(_) | MirRuntimeValue.BigInt(_) => value.clone()
            _ => Err("receipt integer has an invalid scalar carrier")
        }
        MirTypeKind.Float | MirTypeKind.Float32 => match value {
            MirRuntimeValue.Float { value: number, .. } if number.is_finite() => value.clone()
            MirRuntimeValue.Float { .. } => Err("receipt Float contains a non-finite value")
            _ => Err("receipt Float has an invalid scalar carrier")
        }
        MirTypeKind.Bool => match value {
            MirRuntimeValue.Bool(_) => value.clone()
            _ => Err("receipt Bool has an invalid scalar carrier")
        }
        MirTypeKind.Char => match value {
            MirRuntimeValue.Char(_) => value.clone()
            _ => Err("receipt Char has an invalid scalar carrier")
        }
        MirTypeKind.String => match value {
            MirRuntimeValue.String(_) => value.clone()
            _ => Err("receipt String has an invalid scalar carrier")
        }
        MirTypeKind.List(inner) => match value {
            MirRuntimeValue.Bytes(_) if is_u8(inner) => value.clone()
            MirRuntimeValue.List(values) if is_u8(inner) => encode_byte_values(values)
            MirRuntimeValue.List(values) => {
                encoded: [MirRuntimeValue] := []
                for item in values { result :: encode_value(program, item, inner); encoded.push(^result) }
                MirRuntimeValue.List(^encoded)
            }
            _ => Err("receipt List has an invalid list carrier")
        }
        MirTypeKind.FixedList { elem, .. } => match value {
            MirRuntimeValue.Bytes(_) if is_u8(elem) => value.clone()
            MirRuntimeValue.List(values) if is_u8(elem) => encode_byte_values(values)
            MirRuntimeValue.List(values) => {
                encoded: [MirRuntimeValue] := []
                for item in values { result :: encode_value(program, item, elem); encoded.push(^result) }
                MirRuntimeValue.List(^encoded)
            }
            _ => Err("receipt fixed list has an invalid list carrier")
        }
        MirTypeKind.Map { value: value_ty, .. } => match value {
            MirRuntimeValue.Map(entries) => {
                encoded: [(MirConstKey, MirRuntimeValue)] := []
                for (key, item) in entries {
                    result :: encode_value(program, item, value_ty)
                    encoded.push((key.clone(), ^result))
                }
                MirRuntimeValue.Map(^encoded)
            }
            _ => Err("receipt Map has an invalid map carrier")
        }
        MirTypeKind.Shared(inner) => encode_value(program, value, inner)
        MirTypeKind.Option(inner) => encode_option(program, value, inner)
        MirTypeKind.Result { ok, .. } => encode_result(program, value, ok)
        MirTypeKind.Tuple(_) => Err("receipt type `{ty.display_name()}` has no checked Codable field metadata")
        MirTypeKind.Tagged { inner, .. } | MirTypeKind.InlineRange { base: inner, .. } | MirTypeKind.Quantity { base: inner, .. } => encode_value(program, value, inner)
        MirTypeKind.Apply { name, args } => match name.name {
            "List" if args.len() == 1 => encode_value(program, value, &MirType.from_kind(MirTypeKind.List(args[0].clone())))
            "Shared" if args.len() == 1 => encode_value(program, value, &MirType.from_kind(MirTypeKind.Shared(args[0].clone())))
            "Option" if args.len() == 1 => encode_option(program, value, &args[0])
            "Result" if args.len() == 2 => encode_result(program, value, &args[0])
            _ => Err("receipt type `{ty.display_name()}` has no checked Codable definition")
        }
        MirTypeKind.Union(_) => Err("receipt type `{ty.display_name()}` has no checked Codable definition")
        MirTypeKind.Fn(_) | MirTypeKind.SendFn { .. } | MirTypeKind.TraitObject(_) => Err("receipt type `{ty.display_name()}` is not Codable")
    }
}
// Rust: crates/jet-codegen/src/Codegen/Receipt.rs:404
fn encode_interpreter_value(program: &MirProgram, value: &MirRuntimeValue, ty: &MirType) -> MirRuntimeValue Err! {
    encode_value(program, value, ty)
}
