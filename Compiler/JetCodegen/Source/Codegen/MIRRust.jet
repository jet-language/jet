// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:277
fn mir_type_nominals(ty: MirType, names: &[String]) -> {
    if ty.kind() == {
        MirTypeKind.Apply(name: name, args: args) -> {
            names.push(name.name)
            for arg in args { mir_type_nominals(arg, &names) }
        }
        MirTypeKind.TraitObject(bounds) -> { for bound in bounds { names.push(bound.name) } }
        MirTypeKind.List(inner) | MirTypeKind.Shared(inner) | MirTypeKind.Option(inner) |
        MirTypeKind.FixedList(elem: inner) | MirTypeKind.InlineRange(base: inner) |
        MirTypeKind.Tagged(inner: inner) | MirTypeKind.Quantity(base: inner) -> mir_type_nominals(inner, &names)
        MirTypeKind.Map(key: key, value: value) | MirTypeKind.Result(ok: key, err: value) -> {
            mir_type_nominals(key, &names)
            mir_type_nominals(value, &names)
        }
        MirTypeKind.Tuple(fields) -> { for (_, field) in fields { mir_type_nominals(field, &names) } }
        MirTypeKind.Union(members) -> { for member in members { mir_type_nominals(member, &names) } }
        MirTypeKind.Fn(signature) -> {
            for param in signature.params { mir_type_nominals(param, &names) }
            if ret := signature.ret { mir_type_nominals(ret, &names) }
        }
        MirTypeKind.SendFn(params: params, ret: ret) -> {
            for param in params { mir_type_nominals(param, &names) }
            if ret := ret { mir_type_nominals(ret, &names) }
        }
        MirTypeKind.Int | MirTypeKind.Float | MirTypeKind.Bool | MirTypeKind.String |
        MirTypeKind.Char | MirTypeKind.IntN | MirTypeKind.Float32 | MirTypeKind.Measure(_) -> {}
    }
}
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:342
fn mir_type_single_trait_objects(ty: MirType, found: &(String) -> Void) -> {
    if ty.kind() == {
        MirTypeKind.TraitObject(bounds) -> { if bounds.len() == 1 { found(bounds[0].name) } }
        MirTypeKind.Apply(args: inner) | MirTypeKind.Union(inner) -> {
            for ty in inner { mir_type_single_trait_objects(ty, &found) }
        }
        MirTypeKind.List(inner) | MirTypeKind.Shared(inner) | MirTypeKind.Option(inner) |
        MirTypeKind.FixedList(elem: inner) | MirTypeKind.InlineRange(base: inner) |
        MirTypeKind.Tagged(inner: inner) | MirTypeKind.Quantity(base: inner) -> mir_type_single_trait_objects(inner, &found)
        MirTypeKind.Map(key: key, value: value) | MirTypeKind.Result(ok: key, err: value) -> {
            mir_type_single_trait_objects(key, &found)
            mir_type_single_trait_objects(value, &found)
        }
        MirTypeKind.Tuple(fields) -> { for (_, field) in fields { mir_type_single_trait_objects(field, &found) } }
        MirTypeKind.Fn(signature) -> {
            for param in signature.params { mir_type_single_trait_objects(param, &found) }
            if ret := signature.ret { mir_type_single_trait_objects(ret, &found) }
        }
        MirTypeKind.SendFn(params: params, ret: ret) -> {
            for param in params { mir_type_single_trait_objects(param, &found) }
            if ret := ret { mir_type_single_trait_objects(ret, &found) }
        }
        MirTypeKind.Int | MirTypeKind.Float | MirTypeKind.Bool | MirTypeKind.String |
        MirTypeKind.Char | MirTypeKind.IntN | MirTypeKind.Float32 | MirTypeKind.Measure(_) -> {}
    }
}
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:409
// Scan all noncandidate roots, then demanded codec methods; nominal demands are indexed.
fn demanded_codec_impls(program: MirProgram) -> [Bool] {
    keep := program.impls.map((implementation) -> !(implementation.compiler_generated &&
        implementation.serde != None && implementation.self_type.nominal_name() != None))
    by_method := [MirFunctionId: USize]{}
    by_name := [String: [USize]]{}
    for (index, implementation) in program.impls.enumerate() {
        if keep[index] { continue }
        for method in implementation.methods { by_method[method] = index }
        if name := implementation.self_type.nominal_name() { by_name.entry(name).or_default().push(index) }
    }
    functions := [MirFunctionId: MirFunction]{}
    pending := [MirFunction][]
    for function in program.functions {
        functions[function.id] = function
        if !by_method.contains_key(function.id) { pending.push(function) }
    }
    seen_names := [String: Bool]{}
    demanded := [USize][]
    while function := pending.pop() {
        names := [String][]
        for block in function.blocks {
            for instruction in block.instructions {
                if instruction.operation == {
                    MirOperation.Call(callee: callee, type_args: type_args) -> {
                        if callee == {
                            MirCallee.User(id) | MirCallee.Associated(function: id) | MirCallee.Method(function: id) -> {
                                if index := by_method.get(id) { demanded.push(index) }
                            }
                            else -> {}
                        }
                        for ty in type_args { mir_type_nominals(ty, &names) }
                    }
                    MirOperation.IndirectCall(type_args: type_args) | MirOperation.CoreCall(type_args: type_args) -> {
                        for ty in type_args { mir_type_nominals(ty, &names) }
                    }
                    MirOperation.Semantic(MirSemanticOp.StaticPreludeCall(owner_type_args: owner_type_args, type_args: type_args)) -> {
                        for arg in owner_type_args {
                            if arg == { MirPreludeTypeArg.Type(ty) -> mir_type_nominals(ty, &names); else -> {} }
                        }
                        for ty in type_args { mir_type_nominals(ty, &names) }
                    }
                    else -> {}
                }
            }
        }
        for name in names {
            if !seen_names.contains_key(name) {
                seen_names[name] = true
                if indices := by_name.get(name) { demanded.extend(indices) }
            }
        }
        for index in demanded.drain() {
            if !keep[index] {
                keep[index] = true
                for method in program.impls[index].methods {
                    if function := functions.get(method) { pending.push(function) }
                }
            }
        }
    }
    keep
}
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:500
fn mir_type_uses_atomic_word(ty: MirType) -> Bool {
    if ty.kind() == {
        MirTypeKind.Apply(name: name, args: args) -> name.name == "Atomic" || name.name.ends_with("::Atomic") || args.any(mir_type_uses_atomic_word)
        MirTypeKind.List(inner) | MirTypeKind.Shared(inner) | MirTypeKind.Option(inner) |
        MirTypeKind.FixedList(elem: inner) | MirTypeKind.InlineRange(base: inner) |
        MirTypeKind.Tagged(inner: inner) | MirTypeKind.Quantity(base: inner) -> mir_type_uses_atomic_word(inner)
        MirTypeKind.Map(key: key, value: value) | MirTypeKind.Result(ok: key, err: value) -> mir_type_uses_atomic_word(key) || mir_type_uses_atomic_word(value)
        MirTypeKind.Fn(signature) -> signature.params.any(mir_type_uses_atomic_word) || signature.ret.is_some_and(mir_type_uses_atomic_word)
        MirTypeKind.SendFn(params: params, ret: ret) -> params.any(mir_type_uses_atomic_word) || ret.is_some_and(mir_type_uses_atomic_word)
        MirTypeKind.Tuple(fields) -> fields.any((field) -> mir_type_uses_atomic_word(field.1))
        MirTypeKind.Union(members) -> members.any(mir_type_uses_atomic_word)
        MirTypeKind.Int | MirTypeKind.Float | MirTypeKind.Bool | MirTypeKind.String | MirTypeKind.Char |
        MirTypeKind.TraitObject(_) | MirTypeKind.IntN | MirTypeKind.Float32 | MirTypeKind.Measure(_) -> false
    }
}
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:549
fn mir_type_has_inline_nominal_word(ty: MirType) -> Bool {
    if ty.kind() == {
        MirTypeKind.Apply(args: args) -> {
            scalar :: if ty.layout.abi == { MirAbi.Scalar(_) -> true; else -> false }
            size8 :: if ty.layout.size == { MirSize.Static(8) -> true; else -> false }
            (scalar && size8) || args.any(mir_type_has_inline_nominal_word)
        }
        MirTypeKind.List(inner) | MirTypeKind.Shared(inner) | MirTypeKind.Option(inner) |
        MirTypeKind.FixedList(elem: inner) | MirTypeKind.InlineRange(base: inner) |
        MirTypeKind.Tagged(inner: inner) | MirTypeKind.Quantity(base: inner) -> mir_type_has_inline_nominal_word(inner)
        MirTypeKind.Map(key: key, value: value) | MirTypeKind.Result(ok: key, err: value) -> mir_type_has_inline_nominal_word(key) || mir_type_has_inline_nominal_word(value)
        MirTypeKind.Fn(signature) -> signature.params.any(mir_type_has_inline_nominal_word) || signature.ret.is_some_and(mir_type_has_inline_nominal_word)
        MirTypeKind.SendFn(params: params, ret: ret) -> params.any(mir_type_has_inline_nominal_word) || ret.is_some_and(mir_type_has_inline_nominal_word)
        MirTypeKind.Tuple(fields) -> fields.any((field) -> mir_type_has_inline_nominal_word(field.1))
        MirTypeKind.Union(members) -> members.any(mir_type_has_inline_nominal_word)
        MirTypeKind.Int | MirTypeKind.Float | MirTypeKind.Bool | MirTypeKind.String | MirTypeKind.Char |
        MirTypeKind.TraitObject(_) | MirTypeKind.IntN | MirTypeKind.Float32 | MirTypeKind.Measure(_) -> false
    }
}
