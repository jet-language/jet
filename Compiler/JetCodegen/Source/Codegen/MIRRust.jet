// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:647
fn mir_program_uses_shared_kernel(program: MirProgram) -> Bool {
    program.type_instances.any(mir_type_uses_shared_kernel) || program.prelude_calls.any((call) -> {
        symbol :: if call.symbol == { MirSymbol.Prelude(symbol) | MirSymbol.Runtime(symbol) -> symbol }
        symbol.starts_with("jet_shared_")
    })
}
