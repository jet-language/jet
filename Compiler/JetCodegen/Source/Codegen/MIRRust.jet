// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:677
pub fn mir_rust_aot_metadata(program: MirProgram, config: MirRustConfig) -> MirRustAotMetadata {
    artifact_identity :: program.artifact_identity(config.execution.artifact).unwrap_or_else((error) ->
        panic("MIR Rust metadata requires canonical artifact identity: {error}"))
    emitter :: RustEmitter.new(program, config, artifact_identity)
    metadata := MirRustAotMetadata{}
    for function in program.functions {
        top_level :: if function.form == { MirFunctionForm.TopLevel -> true; else -> false }
        if !emitter.module_selected(function.module_id) || !emitter.selected_for_target(function) || !top_level { continue }
        parameters :: emitter.declared_params(function)
        parameter_types :: parameters.map((parameter) -> emitter.parameter_type(parameter))
        parameter_access :: parameters.map((parameter) -> parameter.access)
        callable_parameters :: parameters.map((parameter) -> parameter.ty)
        callable_type :: emitter.callable_type(callable_parameters, parameter_access, function.return_type)
        metadata.callables.push(MirRustCallableMetadata{
            function: function.id, symbol: emitter.function_name(function.id),
            parameter_types: parameter_types, parameter_access: parameter_access,
            return_type: emitter.rust_type(function.return_type), callable_type: callable_type,
        })
    }
    if config.execution.emit_types {
        for definition in program.traits {
            if !emitter.module_selected(definition.module) { continue }
            metadata.traits.push(MirRustTraitMetadata{
                trait_id: definition.id, key: definition.key, name: definition.name,
                symbol: emitter.trait_name(definition.id),
            })
            for method in definition.methods {
                parameter_types :: method.params.map((parameter) -> emitter.synthetic_rollback_parameter_type(definition, parameter))
                parameter_access :: method.params.map((parameter) -> parameter.access)
                metadata.trait_methods.push(MirRustTraitMethodMetadata{
                    trait_id: definition.id, method_id: method.id,
                    key: emitter.trait_method_key(definition, method), name: method.name,
                    symbol: emitter.trait_method_symbol(definition, method), receiver_access: method.self_access,
                    parameter_types: parameter_types, parameter_access: parameter_access,
                    return_type: emitter.synthetic_rollback_type(definition, method.return_type),
