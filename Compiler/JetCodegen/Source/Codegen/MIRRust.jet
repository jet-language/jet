// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:120
fn is_string_view_type(ty: MirType) -> Bool {
    if ty.kind() == {
        MirTypeKind.Apply(name: name, args: args) -> {
            if (name.name == "View" || name.name == "ViewMut") && args.len() == 1 {
                if args[0].kind() == {
                    MirTypeKind.Apply(name: name, args: args) -> args.is_empty() && name.name == "str"
                    else -> false
                }
            } else { false }
        }
        MirTypeKind.Tagged(inner: inner) -> is_string_view_type(inner)
        else -> false
    }
}
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:136
fn is_view_type(ty: MirType) -> Bool {
    if ty.kind() == {
        MirTypeKind.Apply(name: name) -> name.name == "View" || name.name == "ViewMut"
        MirTypeKind.Tagged(inner: inner) -> is_view_type(inner)
        else -> false
    }
}
