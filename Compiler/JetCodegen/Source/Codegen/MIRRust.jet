//RS /// Provenance line the bootstrap assembler (`Compiler/Bootstrap/assemble.mjs`)
//RS /// writes before each original `Compiler/<Package>/…` file it concatenates
//RS /// into the one compiler unit.
//RS const UNIT_PROVENANCE_MARKER: &str = "// [jet-bootstrap source: ";
//RS /// Opens one build-unit section of an emitted program; packaging builds each
//RS /// section as its own crate. Single-crate consumers only see comments.
//RS pub const UNIT_BEGIN_MARKER: &str = "// jet:unit-begin ";
//RS /// Closes the build-unit section named after it.
//RS pub const UNIT_END_MARKER: &str = "// jet:unit-end ";
//RS /// The unit beneath every package: Core items, compiler-synthesized rows and
//RS /// anything outside a marked source range.
//RS const BASE_UNIT: &str = "base";
//RS 
//RS /// Build units of one emitted program. An item's unit is the package of the
//RS /// original file whose provenance marker is in effect at the item's span, so
//RS /// the assembled compiler splits into one crate per `Compiler/<Package>`.
//RS /// Programs with fewer than two units are not split.
//RS struct EmissionUnits {
//RS     /// Per source file: (byte offset where a marked file's text starts, unit),
//RS     /// in source order.
