// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:839
fn push_runtime_block(emitter: RustEmitter, program: MirProgram, config: MirRustConfig, out: &String) -> {
    if config.execution.emit_runtime {
        if emitter.is_no_os() {
            out.push_str("#![no_std]\n#![no_main]\n")
            push_portable_corelib_prelude(&out, program, emitter.artifact)
        } else {
            uses_arrow :: mir_program_uses_arrow(program) || emitter.artifact.runtime_parts.contains(MirRuntimePartId.Data)
            active_os :: OSTarget.parse(program.facts.active_os).or_else(() -> OSTarget.from_triple(config.target.triple)).unwrap_or_else(OSTarget.host)
            push_cached_runtime_begin_with_policy(&out, config.execution.ffi, uses_arrow, config.execution.release_devtools_policy)
            out.push_str(CACHED_RUNTIME_END)
            out.push_str(CACHED_CORE_BEGIN)
            test_harness :: emitter.artifact.harness != None || if emitter.artifact.kind == {
                MirArtifactKind.TestExecutable | MirArtifactKind.FuzzExecutable | MirArtifactKind.TestOverride -> true
                else -> false
            }
            push_full_corelib_prelude_with_policy(&out, active_os, test_harness, program.facts.edition,
                emitter.artifact.runtime_parts, mir_program_uses_shared_kernel(program), uses_arrow, config.execution.release_devtools_policy)
            out.push_str(CACHED_CORE_END)
            if link := config.execution.ffi {
                needs_http_bridge :: program.prelude_calls.any((call) -> {
                    symbol :: if call.symbol == { MirSymbol.Prelude(symbol) | MirSymbol.Runtime(symbol) -> symbol }
                    symbol == "jet_http_client_get" || symbol == "jet_http_client_post" || symbol == "jet_http_client_request_send"
                })
                if needs_http_bridge { out.push_str("jet_http_client_bridge!({link.crate_name});\n") }
                if program.prelude_calls.any((call) -> is_net_tls_client_bridge_call(call.symbol)) {
                    out.push_str("jet_net_tls_client_bridge!({link.crate_name});\n")
                }
                needs_plugin_bridge :: program.prelude_calls.any((call) -> if call.symbol == {
                    MirSymbol.Prelude(symbol) -> symbol == "jet_plugin_load"
                    else -> false
                })
                if needs_plugin_bridge { out.push_str("jet_plugin_bridge!({link.crate_name});\n") }
                needs_db_bridge :: program.prelude_calls.any((call) -> {
                    symbol :: if call.symbol == { MirSymbol.Prelude(symbol) | MirSymbol.Runtime(symbol) -> symbol }
                    symbol.starts_with("jet_db_")
                })
                if needs_db_bridge { out.push_str("jet_db_bridge!({link.crate_name});\n") }
                needs_vault_display_bridge :: program.prelude_calls.any((call) -> {
                    symbol :: if call.symbol == { MirSymbol.Prelude(symbol) | MirSymbol.Runtime(symbol) -> symbol }
                    symbol.rsplit("::").next().is_some_and((symbol) -> symbol.starts_with("jet_vault_"))
                })
                if needs_vault_display_bridge { out.push_str("jet_vault_display_bridge!({link.crate_name});\n") }
            }
            out.push('\n')
        }
    }
}
