                if instruction.operation == {
                    MirOperation.ScopeEnter(scope: scope) -> { if debug_scopes.contains_key(scope) { active = true } }
                    MirOperation.ScopeExit(scope: scope) -> { if debug_scopes.contains_key(scope) { active = false } }
