pub fn emit_mir_runtime_text(program: MirProgram, config: MirRustConfig) -> String {
    artifact_identity :: program.artifact_identity(config.execution.artifact).unwrap_or_else((error) ->
        panic("MIR runtime text requires canonical artifact identity: {error}"))
