//RS /// Position of each block in `function.blocks`, keyed by block id (the first
//RS /// row wins, as a linear `find` would).
//RS fn block_positions(function: &MirFunction) -> HashMap<MirBlockId, usize> {
//RS     let mut positions = HashMap::with_capacity(function.blocks.len());
//RS     for (position, block) in function.blocks.iter().enumerate() {
//RS         positions.entry(block.id).or_insert(position);
//RS     }
//RS     positions
//RS }
//RS 
//RS /// Per-function lookup tables, built once per function on first use so the
//RS /// emitter's per-value queries never rescan the function body. MIR
//RS /// validation rejects a value defined twice or given two metadata rows, so
//RS /// each value has at most one row in `definitions` and `values`.
//RS struct FunctionIndex {
//RS     /// (block position, instruction position) of each value's definition.
//RS     definitions: HashMap<MirValueId, (usize, usize)>,
//RS     /// Position of each value's `function.values` row.
//RS     values: HashMap<MirValueId, usize>,
//RS     /// Every use of each value in body order: (block position, instruction
//RS     /// position), or `None` for the block's terminator. One row per user.
//RS     uses: HashMap<MirValueId, Vec<(usize, Option<usize>)>>,
//RS     /// (block position, instruction position) of the first `ScopeEnter` that
//RS     /// carries a test member, per scope.
//RS     test_members: HashMap<MirScopeId, (usize, usize)>,
//RS     /// Position of each scope's `function.scopes` row.
//RS     scopes: HashMap<MirScopeId, usize>,
//RS     /// Position of each place's `function.places` row.
//RS     places: HashMap<MirPlaceId, usize>,
//RS     /// The value of the first `Capture` instruction of each capture slot.
//RS     capture_values: HashMap<usize, MirValueId>,
//RS     /// Capture values some place moves out of (`access == Move`).
//RS     moved_captures: HashSet<MirValueId>,
//RS     /// (block position, coverage branch ordinals before the block) per
//RS     /// block id: Branch terminators count once, Switch arms once each.
//RS     blocks: HashMap<MirBlockId, (usize, usize)>,
//RS     /// Positions of the blocks ending in `Jump` to each block, in body order.
//RS     jump_sources: HashMap<MirBlockId, Vec<usize>>,
//RS     /// Predecessor block positions of each block, along terminator edges.
//RS     predecessors: Vec<Vec<usize>>,
//RS     /// D-MEM-COPYSEM1: per local, the (block, instruction) positions of the
//RS     /// operations that may change or release it: a write, move, replace, or
//RS     /// write borrow of one of its places, a write or move call argument
//RS     /// naming one, and any use of a write borrow taken from one.
//RS     local_writes: HashMap<MirLocalId, Vec<(usize, usize)>>,
//RS     /// Locals some operation reaches outside place reads and writes (a
//RS     /// closure capture, a raw address, a by-identity entry list): an
//RS     /// in-place read of one is never proven stable.
//RS     escaped_locals: HashSet<MirLocalId>,
//RS     /// Per parameter index, the (block, instruction) positions of the
//RS     /// operations that may change one of its places, as `local_writes`
//RS     /// counts them for a local, with the place each one changes.
//RS     parameter_writes: HashMap<usize, Vec<(usize, usize, MirPlaceId)>>,
//RS     /// Parameters some operation reaches outside place reads and writes, as
//RS     /// `escaped_locals` counts them, or a drop action releases a place of.
//RS     escaped_parameters: HashSet<usize>,
//RS     /// `stable_local_read` answers per read value, computed on first query.
//RS     stable_reads: std::cell::RefCell<HashMap<MirValueId, bool>>,
//RS }
//RS 
