        MirTypeKind.Fn(signature) -> signature.params.any(mir_type_uses_shared_kernel) || signature.ret.is_some_and(mir_type_uses_shared_kernel)
        MirTypeKind.SendFn(params: params, ret: ret) -> params.any(mir_type_uses_shared_kernel) || ret.is_some_and(mir_type_uses_shared_kernel)
        MirTypeKind.Tuple(fields) -> fields.any((field) -> mir_type_uses_shared_kernel(field.1))
        MirTypeKind.Union(members) -> members.any(mir_type_uses_shared_kernel)
        MirTypeKind.Int | MirTypeKind.Float | MirTypeKind.Bool | MirTypeKind.String | MirTypeKind.Char |
        MirTypeKind.TraitObject(_) | MirTypeKind.IntN | MirTypeKind.Float32 | MirTypeKind.Measure(_) -> false
    }
