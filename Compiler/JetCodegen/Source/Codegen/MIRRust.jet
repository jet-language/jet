            definitions: definitions, values: values, uses: uses, test_members: test_members,
            scopes: scopes, places: places, capture_values: capture_values, moved_captures: moved_captures,
            blocks: blocks, jump_sources: jump_sources, predecessors: predecessors,
            local_writes: local_writes, escaped_locals: escaped_locals, parameter_writes: parameter_writes,
