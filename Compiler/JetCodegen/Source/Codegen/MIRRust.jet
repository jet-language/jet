                        MirOperation.InitializeUninit(place: place) | MirOperation.WritePlace(place: place) |
                        MirOperation.ReplacePlace(place: place) |
                        MirOperation.Semantic(MirSemanticOp.BuiltinMethod(receiver_place: Some(place))) -> touch(place)
                        MirOperation.Semantic(MirSemanticOp.CursorTakePattern(receiver_place: place) |
                            MirSemanticOp.ReaderTakePattern(receiver_place: place)) -> {
                            if parameter := place_parameter(place) { changed.push(parameter) }
                        }
                        MirOperation.RawAddressOf(place: place) -> escape(place)
                        MirOperation.Closure(captures: captures) -> {
                            for capture in captures {
