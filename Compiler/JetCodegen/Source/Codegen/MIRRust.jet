MAX_STRUCTURED_INDENT :: 4 * 256
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:1733
struct MirCfgPlan {
    positions: [MirBlockId: USize]
    entry: USize
    order: [USize]
    headers: [Bool]
    merges: [Bool]
    follows: [[USize]]
}
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:1745
struct MirCfgState {
    plan: Shared<MirCfgPlan>?
    phi_targets: [MirBlockId: Bool]
    inline_edges: [(USize, USize, USize)]
}
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:1757
fn phi_is_trivial(incoming: [(MirBlockId, MirValueId)]) -> Bool {
    if incoming.is_empty() { return false }
    first :: incoming[0].1
    incoming[1..].all((row) -> row.1 == first)
}
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:1763
fn phi_target_blocks(function: MirFunction) -> [MirBlockId: Bool] {
    targets := [MirBlockId: Bool]{}
    for block in function.blocks {
        if block.instructions.any((instruction) -> if instruction.operation == {
            MirOperation.Phi(incoming: incoming) -> !phi_is_trivial(incoming)
            else -> false
        }) { targets[block.id] = true }
    }
    targets
}
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:1778
fn for_each_value_mention(text: String, visit: &(USize, USize, U64) -> Void) -> {
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:1779
    PREFIX :: "__jet_v_"
    for (line_index, line) in text.split_inclusive('\n').enumerate() {
        search := 0
        while found := line[search..].find(PREFIX) {
            at :: search + found
            digits_start :: at + PREFIX.len()
            digits :: line[digits_start..].bytes().take_while((byte) -> byte.is_ascii_digit()).count()
            search = digits_start + digits
            joined :: line[..at].bytes().next_back().is_some_and((byte) -> byte.is_ascii_alphanumeric() || byte == 95)
            if digits == 0 || joined { continue }
            if id := line[digits_start..digits_start + digits].parse<U64>().ok() { visit(line_index, at, id) }
        }
    }
}
