                        MirOperation.Call(args: args) | MirOperation.CoreCall(args: args) | MirOperation.IndirectCall(args: args) |
                        MirOperation.Semantic(MirSemanticOp.StaticPreludeCall(args: args) | MirSemanticOp.HardwareCall(args: args) |
