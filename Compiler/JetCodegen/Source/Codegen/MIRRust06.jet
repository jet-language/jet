    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:9899
    fn emit_period_anchor_impls(self, out: &String) -> Unit {
        for def in &self.program.types {
            if !self.module_selected(def.module) { continue }
            variants :: if def.kind == { .Enum(variants, ..) -> variants _ -> continue }
            if variants.len() != 3 { continue }
            has_date := false; has_local_date := false; has_date_time := false
            for variant in variants {
                payload :: if variant.payload == { .Single(payload) -> payload _ -> { has_date = false; has_local_date = false; has_date_time = false; break } }
                nominal :: if payload.kind() == { .Apply(nominal, ..) -> nominal _ -> { has_date = false; has_local_date = false; has_date_time = false; break } }
                if nominal.name.as_str() == {
                    "Date" -> has_date = true
                    "LocalDate" -> has_local_date = true
                    "DateTime" -> has_date_time = true
                    _ -> { has_date = false; has_local_date = false; has_date_time = false; break }
                }
            }
            if !(has_date && has_local_date && has_date_time) { continue }
            name :: self.type_name(def.id)
            trait_name :: "{self.config.root_prefix}JetPeriodAnchor"
            out.push_str(&"impl {trait_name} for {name} {{\n    fn period_total_in(&self, period: &{self.config.root_prefix}JetPeriod, unit: &String) -> f64 {{\n        match self {{\n")
            for variant in variants {
                payload :: if variant.payload == { .Single(payload) -> payload _ -> panic("validated period anchor union variant payload") }
                nominal :: if payload.kind() == { .Apply(nominal, ..) -> nominal _ -> panic("validated period anchor union payload type") }
                out.push_str(&"            {name}::{mangle_variant(&variant.name)}(anchor) => anchor.period_total_in(period, unit),\n")
                debug_assert(["Date", "LocalDate", "DateTime"].contains(&nominal.name.as_str()))
            }
            out.push_str("        }\n    }\n}\n\n")
        }
    }
