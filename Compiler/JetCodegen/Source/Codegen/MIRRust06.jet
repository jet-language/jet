    fn emit_foreign(self, foreign: &MirForeign, out: &String) -> Unit {
        if foreign.callback_transport.as_ref().is_some_and(fn(transport) { ["managed", "managed-close", "emit-task"].contains(transport) }) { return }
        if !self.module_selected(foreign.module_id) { panic("MIR foreign {foreign.id:?} belongs to an unselected module") }
        if !self.target_applicable(foreign.target_applicability) { panic("MIR foreign {foreign.id:?} is not applicable to the selected artifact target") }
        abi :: self.foreign_abi_name(&foreign.foreign_abi)
        language :: self.foreign_language_name(foreign.foreign_language)
        out.push_str(&"// jet-mir-foreign: id={foreign.id.0} module={foreign.module} language={language} abi={abi} symbol={foreign.symbol} path={foreign.path:?} callback={foreign.callback:?} handle={foreign.handle:?} close={foreign.close_function:?} undo={foreign.undo_function:?}\n")
        params := foreign.params.iter().map(fn(param) { "{mangle(&param.name)}: {self.foreign_param_type(foreign, param)}" }).collect()
        if foreign.callback_transport.as_ref() == Some("native-start") { params.push("__jet_callback_ctx: *mut core::ffi::c_void".to_string()) }
        params :: params.join(", ")
        ret :: self.foreign_return_type(foreign)
        if foreign.foreign_language == .Rust { return }
        rust_name :: self.foreign_name(foreign.id)
        out.push_str(&"extern \"{abi}\" {{\n")
        if rust_name != foreign.symbol { out.push_str(&"    #[link_name = {foreign.symbol:?}]\n") }
        out.push_str(&"    fn {rust_name}({params}) -> {ret};\n}}\n\n")
    }
