            .Shared(ty) -> MirTypeKind.Shared(sub(ty))
            .Option(ty) -> MirTypeKind.Option(sub(ty))
            .Map(key, value) -> MirTypeKind.Map(sub(key), sub(value))
            .Result(ok, err) -> MirTypeKind.Result(sub(ok), sub(err))
            .Tuple(fields) -> MirTypeKind.Tuple(fields.iter().map(fn((name, ty)) { (name.clone(), sub(ty)) }).collect())
            .Union(types) -> MirTypeKind.Union(types.iter().map(sub).collect())
            .FixedList(elem, len) -> MirTypeKind.FixedList(sub(elem), len.clone())
            .InlineRange(base, lo, hi) -> MirTypeKind.InlineRange(sub(base), lo, hi)
