    fn history_codec_constraints(self, ty: &MirType) -> Set[String] {
        constraints := [String].new().into_set()
        children := [&MirType].new()
        if ty.kind() == {
            .Apply(name, args) -> {
                if self.program.types.iter().find(fn(def) { def.id == name.id }) == Some(def) {
                    for (param, argument) in def.generic_params.iter().zip(args) {
                        if !param.bounds.is_empty() {
                            bounds :: param.bounds.iter().map(fn(bound) { self.trait_nominal_name(bound) }).collect().join(" + ")
                            constraints.insert("{self.rust_type(argument)}: {bounds}")
                        }
                    }
                }
                children.extend(args)
            }
            .List(ty) | .Shared(ty) | .Option(ty) | .FixedList(ty, ..) | .InlineRange(ty, ..) | .Tagged(_, ty) | .Quantity(ty, ..) -> children.push(ty)
            .Map(key, value) | .Result(key, value) -> { children.push(key); children.push(value) }
            .Tuple(fields) -> children.extend(fields.iter().map(fn((_, ty)) { ty }))
            .Union(types) -> children.extend(types)
            .Fn(signature) -> { children.extend(&signature.params); if signature.ret == Some(ty) { children.push(ty) } }
            .SendFn(params, ret, ..) -> { children.extend(params); if ret == Some(ty) { children.push(ty) } }
            _ -> {}
        }
        for child in children { constraints.extend(self.history_codec_constraints(child)) }
        constraints
    }
