        if ty.kind() == {
            .Tagged(_, inner) -> self.web_abi_encode(inner, value)
            .InlineRange(base, ..) | .Quantity(base, ..) -> self.web_abi_encode(base, value)
            .Bool -> "if {value} {{ 1 }} else {{ 0 }}"
            .Char -> "({value} as u32)"
            _ -> value.to_string()
        }
    }
