    fn emit_exports(self, out: &String) -> Unit {
        if self.artifact.kind == .NativeLibrary || self.artifact.kind == .SandboxPlugin { return }
        if self.config.target_kind == .WebWasm { self.emit_web_exports(out); return }
        symbols := [String].new().into_set()
        for export in &self.artifact.exports {
            function :: self.function_row(export.function)
            if export.symbol.is_empty() { panic("MIR export for function {export.function:?} has an empty symbol") }
            if self.callback_ids().iter().any(fn(callback_id) { self.program.callbacks.iter().any(fn(callback) { callback.id == callback_id && callback.symbol == export.symbol }) }) { panic("MIR export symbol {export.symbol:?} collides with a callback trampoline") }
            if !symbols.insert(export.symbol.clone()) { panic("MIR export symbol {export.symbol:?} is emitted more than once") }
            if !self.module_selected(function.module_id) || !self.selected_for_target(function) { panic("MIR export {export.symbol:?} targets an unselected function") }
            if function.form != .TopLevel || !function.capture_params.is_empty() { panic("MIR export {export.symbol:?} targets a non-exportable function") }
            params :: function.params.iter().map(fn(param) { "{mangle(&param.name)}: {self.parameter_type(param)}" }).collect().join(", ")
            args :: function.params.iter().map(fn(param) { mangle(&param.name) }).collect().join(", ")
            ret :: self.rust_type(&function.return_type)
            call :: self.function_name(function.id)
            call :: if function.is_unsafe { "unsafe {{ {call}({args}) }}" } else { "{call}({args})" }
            abi :: self.foreign_abi_name(&export.abi)
            out.push_str(&"#[no_mangle]\npub extern \"{abi}\" fn {export.symbol}({params}) -> {ret} {{ {call} }}\n\n")
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:10599
    fn web_abi_type(self, ty: &MirType) -> (String, String?) {
        if ty.is_unit() { return ("()", None) }
        if ty.kind() == {
            .Tagged(_, inner) -> self.web_abi_type(inner)
            .InlineRange(base, ..) | .Quantity(base, ..) -> self.web_abi_type(base)
            .Int -> ("u64", Some("int"))
            .String -> ("u64", Some("string"))
            .Float -> ("f64", None)
            .Float32 -> ("f32", None)
            .Bool -> ("i32", None)
            .Char -> ("u32", None)
            .IntN(8, true) -> ("i8", None)
            .IntN(8, false) -> ("u8", None)
            .IntN(16, true) -> ("i16", None)
            .IntN(16, false) -> ("u16", None)
            .IntN(32, true) -> ("i32", None)
            .IntN(32, false) -> ("u32", None)
            .IntN(64, true) -> ("i64", None)
            .IntN(64, false) -> ("u64", None)
            .List(inner) -> if self.web_abi_type(inner) == {
                (_, .Some("int")) -> ("u64", Some("list_int"))
                (_, .Some("string")) -> ("u64", Some("list_string"))
                ("i64", .None) -> ("u64", Some("list_i64"))
                _ -> panic("checked Web list has no ABI rail: {ty:?}")
            }
            .Map(key, value) -> if self.web_abi_type(key) == ("u64", Some("string")) && self.web_abi_type(value) == ("u64", Some("int")) { ("u64", Some("map_string_int")) } else { panic("checked Web export has no ABI rail: {ty:?}") }
            _ -> panic("checked Web export has no ABI rail: {ty:?}")
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:10662
    fn web_abi_decode(self, ty: &MirType, value: &String) -> String {
        if self.web_abi_type(ty).1 == Some(rail) { return "jet_abi_{rail}_arg({value})" }
        if ty.kind() == {
            .Tagged(_, inner) -> self.web_abi_decode(inner, value)
            .InlineRange(base, ..) | .Quantity(base, ..) -> self.web_abi_decode(base, value)
            .Bool -> "({value} != 0)"
            .Char -> "char::from_u32({value}).expect(\"Web Char scalar\")"
            _ -> value.to_string()
        }
    }
