        }
        out.push_str("}\n\n")
        out.push_str(&"impl{impl_generics} {self.config.root_prefix}JetRow for {row_ty} {{\n    type Cell = {cell_ty};\n    fn jet_row_width() -> usize {{ {fields.len()} }}\n    fn jet_row_split(self) -> Vec<Self::Cell> {{\n        vec![\n")
