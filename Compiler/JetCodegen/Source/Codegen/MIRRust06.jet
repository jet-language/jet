    fn callback_boundary_symbol(self, callback_id: MirCallbackId) -> String {
        route := None
        for function in &self.program.functions {
            if !self.module_selected(function.module_id) || !self.selected_for_target(function) { continue }
            for instruction in function.blocks.iter().flat_map(fn(block) { &block.instructions }) {
                if instruction.operation == .Semantic(.CCallback(call, callback, ..)) {
                    if callback != callback_id { continue }
                    if route == {
                        .Some(previous) -> if previous != call { panic("MIR callback {callback_id:?} uses multiple boundary Prelude routes") }
                        .None -> route = Some(call)
                    }
                }
            }
        }
        call :: route.unwrap_or_else(fn() { panic("MIR callback {callback_id:?} has no boundary Prelude route") })
        self.prelude_symbol(call)
    }
