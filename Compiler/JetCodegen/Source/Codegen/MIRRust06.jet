    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:10154
    fn emit_link_unit(self, id: MirLinkUnitId, seen: &Set[MirLinkUnitId], out: &String) -> Unit {
        if !seen.insert(id) { return }
        link :: self.program.links.iter().find(fn(link) { link.id == id }).unwrap_or_else(fn() { panic("MIR link unit ID {id:?} has no row") })
        if !self.target_applicable(link.target_applicability) { panic("MIR link unit {link.id:?} is not applicable to the selected artifact target") }
        for dependency in &link.link_closure { self.emit_link_unit(dependency, seen, out) }
        out.push_str(&"// jet-mir-link-unit: id={link.id.0} crate={link.crate_spec} cache={link.cache_identity}\n")
        for directory in &link.dependency_dirs { out.push_str(&"// jet-mir-link-search-path: {directory}\n") }
        for artifact in &link.artifacts {
            if artifact.kind == {
                .Object | .StaticLibrary | .DynamicLibrary | .Framework -> out.push_str(&"#[link(name = {artifact.path:?})] extern \"C\" {{}}\n")
                .GeneratedSource -> out.push_str(&"// jet-mir-generated-link-source: {artifact.path}\n")
            }
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:10201
    fn callback_ids(self) -> Set[MirCallbackId] {
        callbacks := [MirCallbackId].new().into_set()
        for function in &self.program.functions {
            if !self.module_selected(function.module_id) || !self.selected_for_target(function) { continue }
            for instruction in function.blocks.iter().flat_map(fn(block) { &block.instructions }) {
                if instruction.operation == .Semantic(.CCallback(_, callback, ..)) { callbacks.insert(callback) }
            }
        }
        callbacks
    }
