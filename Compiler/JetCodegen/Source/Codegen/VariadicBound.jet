// Trait-bounded heterogeneous variadics use one closed typed function identity
// per call-site arity. Sema's E1314 guarantees one top-level iteration loop.
use jet_foundation.AST.[Binding, Expr, ForKind, Func, Param, ParamZone, Stmt, Type, TypeParam, Call, LValue, EnumLitArg, StrPart]
use jet_foundation.Diagnostics.[ice]
use jet_codegen.Codegen.Context.[Cx]
use jet_codegen.Codegen.TIR.[LowerEnv, TExpr, TExprKind, TCallArg, call_return_type, lower_one_call_arg]

// Rust: crates/jet-codegen/src/Codegen/VariadicBound.rs:22
fn variadic_bound_fn_name(base: String, arity: USize) -> String Never! {
    "{base}__va{arity}"
}
// Rust: crates/jet-codegen/src/Codegen/VariadicBound.rs:33
fn lower_variadic_bound_call(call: Call, fixed: USize, cx: Cx, env: &LowerEnv) -> TExpr Never! {
    sig :: cx.sigs.get(call.name)
    tail_convention :: sig.and_then(params -> params.get(fixed)).map(pair -> pair.0)
        .expect("trait-bounded variadic signature must retain its tail convention")
    arity :: call.args.len().saturating_sub(fixed)
    args := [TCallArg]{}
    loop (i, a) in call.args.enumerate() {
        conv :: if i < fixed {
            sig.and_then(ps -> ps.get(i))
        } else {
            Val((tail_convention, Type.Named("JaiVar{i - fixed}")))
        }
        &args.push(lower_one_call_arg(a, conv, &env, cx))
    }
    &cx.jit_generic_calls.borrow_mut().entry(variadic_bound_fn_name(call.name, arity))
        .or_default().push(args.map(arg -> arg.value.ty))
    TExpr{ty: call_return_type(cx, call.name), kind: TExprKind.Call{
        name: variadic_bound_fn_name(call.name, arity), type_args: [], args: ^args
    }}
}
// Rust: crates/jet-codegen/src/Codegen/VariadicBound.rs:88
fn build_variadic_bound_func(f: Func, bounds: [String], arity: USize) -> Func Never! {
    last :: f.params.last().expect("internal compiler error: trait-bounded variadic func has no trailing param (I2/D-ANY-JAI1)")
    params := f.params[..f.params.len() - 1].to_list()
    type_params := f.type_params.clone()
    loop i in 0..<arity {
        tname :: "JaiVar{i}"
        &type_params.push(TypeParam{name: tname, name_span: last.name_span, bounds: bounds.clone(), prep: None})
        &params.push(Param{
            convention: last.convention, root: false, name: variadic_slot_name(last.name, i),
            name_span: last.name_span, ty: Type.Named(tname), ty_span: last.ty_span,
            default: None, variadic: false, variadic_bound_list: None,
            declared_view_from_names: None, public_label: None, zone: ParamZone.Either
        })
    }
    body :: unroll_variadic_body(f.body, last.name, arity) catch msg -> ice(None,
        "trait-bounded variadic `{f.name}` — {msg} — codegen only covers a single top-level `loop x in {last.name}` loop; sema's E1314 (Sema/Registration.rs::check_variadic_bound_body_shape) should have rejected this body already (D-ANY-JAI1)")
    result := f.clone()
    result.name = variadic_bound_fn_name(f.name, arity)
    result.type_params = ^type_params
    result.params = ^params
    result.body = ^body
    result
}
// Rust: crates/jet-codegen/src/Codegen/VariadicBound.rs:139
fn variadic_slot_name(param_name: String, i: USize) -> String Never! { "{param_name}__va{i}" }

// Rust: crates/jet-codegen/src/Codegen/VariadicBound.rs:149
fn unroll_variadic_body(stmts: [Stmt], target: String, arity: USize) -> [Stmt] Err! {
    out := [Stmt]{}
    seen_loop := false
    loop s in stmts {
        if s == {
            .For{var, var_span, var2: None, kind: .In{collection, ..}, body, label: None, ..}
                if (if collection == { .Ident(n, _) -> n == target, else -> false }) -> {
                if seen_loop -> return Err("more than one `for … in {target}` loop")
                seen_loop = true
                loop i in 0..<arity {
                    &out.push(Stmt.Val(Binding{
                        mutable: false, markers: [], reactive_upgrade: false, meta: None,
                        name: var, name_span: var_span, sigil_span: None, pattern: None,
                        ty: None, ty_span: None, init: Expr.Ident(variadic_slot_name(target, i), var_span),
                        is_comptime: false, ct: None, uninit: false, arena_view: false,
                        string_view: false, gc_promotion: None, gc_transferred: false
                    }))
                    &out.extend(body.clone())
                }
            }
            else -> {
                if stmt_references_ident(s, target) -> return Err("`{target}` used outside a `loop x in {target} {{ … }}` loop")
                &out.push(s.clone())
            }
        }
    }
    out
}
// Rust: crates/jet-codegen/src/Codegen/VariadicBound.rs:207
// Conservative backstop mirrors sema's coverage: unknown shapes count as uses.
fn stmt_references_ident(s: Stmt, name: String) -> Bool Never! {
    if s == {
        .Expr(e) | .DeferClose{close: e, ..} | .Return(Val(e), _) -> expr_references_ident(e, name)
        .Val(b) -> expr_references_ident(b.init, name)
        .Assign{target, value, ..} -> {
            target_hit :: if target == {
                .Index{base, index, ..} -> expr_references_ident(base, name) || expr_references_ident(index, name)
                .Field{base, ..} -> expr_references_ident(base, name)
                .Local{name: n, ..} -> n == name
            }
            target_hit || expr_references_ident(value, name)
        }
        .While{cond, body, ..} -> expr_references_ident(cond, name) || body.any(s -> stmt_references_ident(s, name))
        .For{kind, body, ..} -> {
            kind_hit :: if kind == {
                .Range{start, end, step, ..} -> expr_references_ident(start, name) || expr_references_ident(end, name) || step.is_some_and(s -> expr_references_ident(s, name))
                .In{collection, step} -> expr_references_ident(collection, name) || step.is_some_and(s -> expr_references_ident(s, name))
            }
            kind_hit || body.any(s -> stmt_references_ident(s, name))
        }
        .Switch{subject, arms, else_body, ..} -> expr_references_ident(subject, name)
            || arms.any(a -> expr_references_ident(a.cond, name) || a.body.any(s -> stmt_references_ident(s, name)))
            || else_body.is_some_and(b -> b.any(s -> stmt_references_ident(s, name)))
        .Loop{body, ..} -> body.any(s -> stmt_references_ident(s, name))
        .CountedLoop{init, cond, step, body, ..} -> expr_references_ident(init.init, name)
            || expr_references_ident(cond, name) || step.is_some_and(step -> stmt_references_ident(step, name))
            || body.any(s -> stmt_references_ident(s, name))
        .Return(None, _) | .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> false
        else -> true
    }
}
// Rust: crates/jet-codegen/src/Codegen/VariadicBound.rs:287
fn expr_references_ident(e: Expr, name: String) -> Bool Never! {
    if e == {
        .Ident(n, _) -> n == name
        .Call(c) -> c.args.any(a -> expr_references_ident(a.expr, name))
        .MethodCall{receiver, args, ..} -> expr_references_ident(receiver, name) || args.any(a -> expr_references_ident(a.expr, name))
        .CallValue{callee, args, ..} -> expr_references_ident(callee, name) || args.any(a -> expr_references_ident(a.expr, name))
        .Binary(_, l, r, _) -> expr_references_ident(l, name) || expr_references_ident(r, name)
        .Unary(_, inner, _) | .Field(inner, _, _) | .Deref(inner, _) | .RawOf(inner, _)
        | .Copy(inner, _) | .Place(inner, _, _) | .Tainted(inner, _, _) | .Present(inner, _)
        | .Ok(inner, _) | .Err(inner, _) -> expr_references_ident(inner, name)
        .Try(inner, _, _, note) -> expr_references_ident(inner, name) || note.is_some_and(note -> expr_references_ident(note, name))
        .OptField{base, ..} -> expr_references_ident(base, name)
        .Index{base, index, ..} -> expr_references_ident(base, name) || expr_references_ident(index, name)
        .Slice{base, start, end, range, ..} -> expr_references_ident(base, name) || range.map_or_else(
            fn() { expr_references_ident(start, name) || expr_references_ident(end, name) },
            range -> expr_references_ident(range, name))
        .ListLit(items, _) -> items.any(i -> expr_references_ident(i, name))
        .MapLit(pairs, _) -> pairs.any(pair -> expr_references_ident(pair.0, name) || expr_references_ident(pair.1, name))
        .StructLit{fields, ..} -> fields.any(field -> expr_references_ident(field.2, name))
        .TypedLit{body, ..} -> {
            hit := false
            body.for_each_expr(v -> { if expr_references_ident(v, name) -> hit = true })
            hit
        }
        .TupleLit(fields, _, _) -> fields.any(field -> expr_references_ident(field.1, name))
        .EnumLit{args, ..} -> args.any(a -> {
            value :: if a == { .Positional(value) -> value, .Named{expr, ..} -> expr }
            expr_references_ident(value, name)
        })
        .Str(parts, _) -> parts.any(p -> if p == { .Interp(inner, _) -> expr_references_ident(inner, name), .Lit(_) -> false })
        .Int(..) | .Float(..) | .Bool(..) | .Char(..) | .ReduceMarker(..) -> false
        else -> true
    }
}
