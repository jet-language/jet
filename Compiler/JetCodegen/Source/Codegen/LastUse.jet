// D-MEM-COPYSEM1 (#3714): last uses move (tir_to_mir_last_use.rs).
//
// Lowering reads an owned local or one of its fields with ReadPlace, which
// every backend materializes as a copy; an unmarked owning use reaches
// lowering as that bare read (a `^`-marked one arrives as a TIR Move and is
// lowered as MovePlace directly, never left to this pass). When the read's value
// is consumed (stored, returned, wrapped, or passed to an owning parameter)
// and no later code can observe the place, the copy and the value are
// indistinguishable, so the read becomes MovePlace. A whole local's drop
// flag clears, exactly as an explicit move lowers. A field moves when
// nothing reads it again before a write refills it (`^x.f` followed by
// `x.f = ...`) or before its owner's remainder drop: a scope-end cleanup
// that moves the whole owner only to release it releases just the fields
// still in place (Legality mir_pass_remainder_drops; native glue skips the
// zeroed field, the Rust tier's partial-move plan drops the rest), so it
// reads none of the moved ones. A read that only inspects its value
// (`list.len()`) stays a read. The same
// liveness fact lets a match arm take the payloads of a subject value that
// nothing reads after the arm binds them: a Move of the subject feeds those
// EnumPayloads, which the emitter extracts by value.
//
// Borrows, views and copies keep a place alive. Every use of a value that
// borrows or views a place, directly or through further borrows, counts as
// a use of the place, and a borrow or view stored anywhere keeps every read
// of the place a copy. The emitter may serve a borrowed consumer of a copy
// by reading the place itself at that consumer, so the place holds its
// value up to every use of every other copy of it.
//
// One backward liveness pass over the function's blocks decides all of it.

use jet_foundation.[MIRValueConsumption, mir_operation_consumption_route, mir_operation_value_consumption, mir_terminator_value_consumption]

struct JetCodegenLastUseCandidate {
    // An owned local (whole place and drop flag), a field path of the owned
    // local candidate `root`, an enum subject value, or a copy (`value`, a
    // ReadPlace result) used outside its own block.
    local: Bool
    field: Bool
    copied: Bool
    place: MIRPlaceID
    flag: MIRPlaceID
    value: MIRValueID
    root: Int
    path: [MIRFieldID]
}

struct JetCodegenLastUseEvent {
    index: Int
    candidate: Int
    kill: Bool
}

struct JetCodegenLastUseEnumUse {
    block: Int
    index: Int
    payload: Bool
    owner: MIRTypeID
    variant: String
    field: Int
}

struct JetCodegenLastUseGroup {
    candidate: Int
    block: Int
    payloads: [Int]
}

// The control-flow facts move_last_uses reads: each block's predecessors,
// whether the entry reaches it along explicit edges, and the candidate whose
// drop flag guards it as a cleanup block (-1 for none).
struct JetCodegenLastUseCFG {
    predecessors: [[Int]]
    reachable: [Bool]
    guarded: [Int]
}


fn jet_codegen_last_use_call_places(args: [MIRCallArg], places: &[MIRPlaceID]) Never! {
    loop arg in args {
        if arg.place == .Val(place) -> &places.push(place)
    }
}

// Every place an operation names (checked_operation_place_refs).
fn jet_codegen_last_use_places(operation: MIROperation) -> [MIRPlaceID] Never! {
    places := mir_operation_place_uses(operation)
    if operation == {
        .Closure(_, captures, _) -> {
            loop capture in captures {
                if capture == .Place(place) -> &places.push(place)
            }
        }
        .Call(_, args, _) -> jet_codegen_last_use_call_places(args, &places)
        .IndirectCall(_, args, _) -> jet_codegen_last_use_call_places(args, &places)
        .CoreCall(_, _, args, _, _, _) -> jet_codegen_last_use_call_places(args, &places)
        .Semantic(semantic) -> {
            if semantic == {
                .StaticPreludeCall(_, args, _, _) -> jet_codegen_last_use_call_places(args, &places)
                .HardwareCall(_, _, _, args) -> jet_codegen_last_use_call_places(args, &places)
                .ClosureMethod(_, args, _) -> jet_codegen_last_use_call_places(args, &places)
                .HostCall(_, args) -> jet_codegen_last_use_call_places(args, &places)
                else -> {}
            }
        }
        else -> {}
    }
    places
}

// Locals an operation reads by identity rather than through a place.
fn jet_codegen_last_use_locals(operation: MIROperation) -> [MIRLocalID] Never! {
    locals := [MIRLocalID]{}
    if operation == {
        .Semantic(semantic) -> {
            if semantic == {
                .RequireStop(_, _, _, _, context, _, _) -> {
                    loop row in context.locals -> &locals.push(row.local)
                }
                else -> {}
            }
        }
        else -> {}
    }
    locals
}

fn jet_codegen_last_use_borrowed(mode: MIROwnershipMode) -> Bool Never! {
    if mode == {
        .ReadBorrow | .WriteBorrow -> true
        else -> false
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_last_use.rs::is_view
fn jet_codegen_last_use_view(ty: MIRType) -> Bool Never! {
    if ty.kind == .Apply(name, _) -> return name.name == "View" || name.name == "ViewMut"
    false
}

// A value that may hold a borrow of the storage it came from.
fn jet_codegen_last_use_holds_borrow(builder: JetCodegenBuilder, program: JetCodegenProgram, value_row: [U64:Int], value: MIRValueID) -> Bool Never! {
    if value_row.get(value.value) == None -> return false
    row :: value_row.get(value.value) ?? panic("checked last-use row is missing")
    jet_codegen_last_use_borrowed(builder.values[row].ownership.mode) || jet_codegen_last_use_view(builder.values[row].ty)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_last_use.rs::field_path
fn jet_codegen_last_use_field_path(projections: [MIRProjection]) -> [MIRFieldID]? Never! {
    path := [MIRFieldID]{}
    loop projection in projections {
        if projection == .Field(field, _) {
            &path.push(field)
        } else {
            return None
        }
    }
    Val(path)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_last_use.rs::overlaps
fn jet_codegen_last_use_overlaps(projections: [MIRProjection], path: [MIRFieldID]) -> Bool Never! {
    loop (depth, projection) in projections {
        if depth >= path.len() -> return true
        if projection == .Field(field, _) {
            if field != path[depth] -> return false
        } else {
            return true
        }
    }
    true
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_last_use.rs::covers
fn jet_codegen_last_use_covers(projections: [MIRProjection], path: [MIRFieldID]) -> Bool Never! {
    if projections.len() > path.len() -> return false
    loop (depth, projection) in projections {
        if projection == .Field(field, _) {
            if field != path[depth] -> return false
        } else {
            return false
        }
    }
    true
}


// Resolve checked access metadata once; consumption itself is Foundation's
// shared MIR classifier, also used by legality, lint and SSA retirement.
fn jet_codegen_operation_borrow_mask(builder: JetCodegenBuilder, operation: MIROperation) -> [Bool] Never! {
    if mir_operation_consumption_route(operation) == Val(call) {
        row :: builder.prelude_call_positions.get(call.value) ?? return [Bool]{}
        return builder.prelude_calls[row].signature.borrow_mask
    }
    [Bool]{}
}

// Whether `value` is consumed: some use takes it, directly or through the
// results that carry it onward.
fn jet_codegen_last_use_consumed(builder: JetCodegenBuilder, program: JetCodegenProgram, users_block: [U64:[Int]], users_index: [U64:[Int]], value: MIRValueID) -> Bool Never! {
    pending := [MIRValueID]{value}
    seen := [U64:Bool]{}
    loop pending.len() > 0 {
        current :: &pending.pop() ?? { break }
        if seen.get(current.value) != None -> next
        _ := &seen.add(current.value, true)
        if users_block.get(current.value) == None -> next
        blocks :: users_block.get(current.value) ?? panic("checked last-use row is missing")
        indices :: users_index.get(current.value) ?? panic("checked last-use row is missing")
        loop (position, block) in blocks {
            index :: indices[position]
            if index >= builder.blocks[block].instructions.len() {
                if mir_terminator_value_consumption(builder.blocks[block].terminator, current) != .No -> return true
                next
            }
            operation :: builder.blocks[block].instructions[index].operation
            mask :: jet_codegen_operation_borrow_mask(builder, operation)
            if mir_operation_value_consumption(operation, current, mask) == {
                .Yes(_) -> return true
                .Through(_) -> {
                    if builder.blocks[block].instructions[index].result == .Val(carried) -> &pending.push(carried)
                }
                .No -> {}
            }
        }
    }
    false
}

// The candidates an origin (a copy or a borrow taken from places) observes.
fn jet_codegen_last_use_observed(touches: [U64:[Int]], copy_place: [U64:U64], borrow_roots: [U64:[Int]], origin: U64) -> [Int] Never! {
    if copy_place.get(origin) == .Val(place) -> return touches.get(place) ?? [Int]{}
    borrow_roots.get(origin) ?? [Int]{}
}

// Whether a use at (`block`, `index`) lies after the copy `origin` in the
// copy's own block.
fn jet_codegen_last_use_inside_copy(copy_block: [U64:Int], copy_index: [U64:Int], origin: U64, block: Int, index: Int) -> Bool Never! {
    (copy_block.get(origin) ?? -1) == block && (copy_index.get(origin) ?? -1) < index
}

// The events of one operand use: a subject use, a copy's read-window
// extension or copy-bit use, or a use of every candidate a borrow observes.
fn jet_codegen_last_use_value_events(events: &[JetCodegenLastUseEvent], copy_end: &[U64:Int], subject_candidate: [U64:Int], origins: [U64:[U64]], copy_block: [U64:Int], copy_index: [U64:Int], copy_bit: [U64:Int], borrow_roots: [U64:[Int]], block: Int, index: Int, value: MIRValueID) Never! {
    if subject_candidate.get(value.value) == .Val(candidate) -> &events.push(JetCodegenLastUseEvent{index: index, candidate: candidate, kill: false})
    if origins.get(value.value) == None -> return
    carried :: origins.get(value.value) ?? panic("checked last-use row is missing")
    loop origin in carried {
        if copy_block.get(origin) != None {
            if jet_codegen_last_use_inside_copy(copy_block, copy_index, origin, block, index) {
                if (copy_end.get(origin) ?? -1) < index -> _ := &copy_end.add(origin, index)
            } else if copy_bit.get(origin) == .Val(bit) {
                &events.push(JetCodegenLastUseEvent{index: index, candidate: bit, kill: false})
            }
        } else {
            observed :: borrow_roots.get(origin) ?? [Int]{}
            loop candidate in observed -> &events.push(JetCodegenLastUseEvent{index: index, candidate: candidate, kill: false})
        }
    }
}

// One instruction position (or block and candidate pair) as one integer
// table key; positions and candidates stay far below the stride.
JET_CODEGEN_LAST_USE_KEY_STRIDE :: 4294967296

fn jet_codegen_last_use_key(block: Int, index: Int) -> Int Never! {
    block * JET_CODEGEN_LAST_USE_KEY_STRIDE + index
}

// Whether `index` lies strictly inside one of the read windows of
// `candidate` in `block` (flattened start/end pairs).
fn jet_codegen_last_use_in_window(windows: [Int:[Int]], block: Int, index: Int, candidate: Int) -> Bool Never! {
    bounds :: windows.get(jet_codegen_last_use_key(block, candidate)) ?? { return false }
    position := 0
    loop position + 1 < bounds.len() {
        if bounds[position] < index && index < bounds[position + 1] -> return true
        position += 2
    }
    false
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_last_use.rs::LowerCtx::last_use_instruction
fn jet_codegen_last_use_instruction(builder: &JetCodegenBuilder, program: JetCodegenProgram, span: Span, role: String, ty: MIRType?, ownership: MIROwnership, operation: MIROperation) -> MIRInstruction Never! {
    identity := jet_codegen_identity(&builder, program, "operation", span, role, "")
    result := MIRValueID?{None}
    if ty == .Val(value_type) {
        value := MIRValueID{value: stable_id("mir-value", identity)}
        jet_codegen_push_value(&builder, program, MIRValueFact{id: value, ty: value_type, span: span, ownership: ownership})
        result = Val(value)
    }
    MIRInstruction{id: MIROpID{value: stable_id("mir-op", identity)}, span: span, source_line: None, result: result, ty: ty, operation: operation}
}

fn jet_codegen_last_use_new_candidate(local: Bool, field: Bool, copied: Bool, place: MIRPlaceID, flag: MIRPlaceID, value: MIRValueID, root: Int, path: [MIRFieldID]) -> JetCodegenLastUseCandidate Never! {
    JetCodegenLastUseCandidate{local: local, field: field, copied: copied, place: place, flag: flag, value: value, root: root, path: path}
}

// The results of whole-root MovePlaces that only feed releasing Drops: an
// owner's remainder drop (its scope-end cleanup), which releases only the
// fields still in place (Legality.jet mir_pass_remainder_drops).
fn jet_codegen_last_use_remainder_moves(builder: JetCodegenBuilder, place_row: [U64:Int]) -> [U64:Bool] Never! {
    // 0: no user yet; 1: every user so far is a releasing Drop; 2: another user.
    states := [U64:Int]{}
    order := [U64]{}
    loop row in builder.blocks {
        loop instruction in row.instructions {
            if instruction.operation == .MovePlace(place) {
                if instruction.result == .Val(result) {
                    if place_row.get(place.value) == .Val(place_index) {
                        if builder.places[place_index].projections.len() == 0 {
                            _ := &states.add(result.value, 0)
                            &order.push(result.value)
                        }
                    }
                }
            }
        }
    }
    remainder := [U64:Bool]{}
    if order.len() == 0 -> return remainder
    loop row in builder.blocks {
        loop instruction in row.instructions {
            released := MIRValueID?{None}
            if instruction.operation == .Drop(dropped, kind) {
                if kind != MIRDropKind.NoDrop -> released = Val(dropped)
            }
            loop value in mir_operation_value_uses(instruction.operation) {
                state :: states.get(value.value) ?? next
                drop_only :: if released == .Val(dropped_value) -> dropped_value == value else -> false
                if state != 2 -> _ := &states.add(value.value, if drop_only -> 1 else -> 2)
            }
        }
        loop value in mir_terminator_value_uses(row.terminator) {
            if states.get(value.value) != None -> _ := &states.add(value.value, 2)
        }
    }
    loop value in order {
        if states.get(value) == .Val(state) {
            if state == 1 -> _ := &remainder.add(value, true)
        }
    }
    remainder
}

// The key of the borrowed plain list walk (LoopIterInit, not by value) that
// is the only use of `value`, as its collection; -1 for none.
fn jet_codegen_last_use_iter_source(builder: JetCodegenBuilder, users_block: [U64:[Int]], users_index: [U64:[Int]], value: MIRValueID) -> Int Never! {
    blocks :: users_block.get(value.value) ?? return -1
    indices :: users_index.get(value.value) ?? return -1
    if blocks.len() != 1 -> return -1
    block :: blocks[0]
    index :: indices[0]
    if index >= builder.blocks[block].instructions.len() -> return -1
    if builder.blocks[block].instructions[index].operation == .LoopIterInit(_, collection, _, by_value, source_kind) {
        if collection == value && !by_value && source_kind == MIRLoopSourceKind.Plain -> return jet_codegen_last_use_key(block, index)
    }
    -1
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_last_use.rs::LowerCtx::move_last_uses
fn jet_codegen_move_last_uses(builder: &JetCodegenBuilder, program: JetCodegenProgram) Never! {
    block_count :: builder.blocks.len()
    block_index := [U64:Int]{}
    def_block := [U64:Int]{}
    def_index := [U64:Int]{}
    loop (block, row) in builder.blocks {
        _ := &block_index.add(row.id.value, block)
        loop (index, instruction) in row.instructions {
            if instruction.result == .Val(result) {
                _ := &def_block.add(result.value, block)
                _ := &def_index.add(result.value, index)
            }
        }
    }
    value_row := [U64:Int]{}
    loop (index, fact) in builder.values -> _ := &value_row.add(fact.id.value, index)
    place_row := [U64:Int]{}
    loop (index, row) in builder.places -> _ := &place_row.add(row.id.value, index)
    no_place :: MIRPlaceID{value: 0}
    no_value :: MIRValueID{value: 0}

    // Owned locals and owned (`^`) parameters: a whole place with a drop flag
    // whose release has no observable effect (no scope-end `close`, not a
    // view). Keyed by root: "local:<id>" or "parameter:<value>".
    candidates := [JetCodegenLastUseCandidate]{}
    rejected := [Bool]{}
    root_candidate := [String:Int]{}
    flag_candidate := [U64:Int]{}
    loop record in builder.drop_live_all {
        if place_row.get(record.place.value) == None -> next
        row_index :: place_row.get(record.place.value) ?? panic("checked last-use row is missing")
        row :: builder.places[row_index]
        if row.projections.len() != 0 || row.persist_key != None -> next
        if jet_codegen_scope_end_close_function(builder, program, record.ty) != None -> next
        if jet_codegen_last_use_view(row.ty) -> next
        root_key := String?{None}
        if row.base == {
            .Local(local) -> root_key = Val("local:{local.value}")
            .Parameter(value) -> root_key = Val("parameter:{value.value}")
            else -> {}
        }
        key :: root_key ?? next
        if root_candidate.get(key) == .Val(existing) {
            rejected[existing] = true
            next
        }
        _ := &root_candidate.add(key, candidates.len())
        _ := &flag_candidate.add(record.live.value, candidates.len())
        &candidates.push(jet_codegen_last_use_new_candidate(true, false, false, record.place, record.live, no_value, -1, [MIRFieldID]{}))
        &rejected.push(false)
    }
    place_candidate := [U64:Int]{}
    loop row in builder.places {
        root_key := String?{None}
        if row.base == {
            .Local(local) -> root_key = Val("local:{local.value}")
            .Parameter(value) -> root_key = Val("parameter:{value.value}")
            else -> {}
        }
        key :: root_key ?? next
        if root_candidate.get(key) == .Val(candidate) -> _ := &place_candidate.add(row.id.value, candidate)
    }

    // Field paths of owned locals and owned (`^`) parameters that some
    // ReadPlace reads: one candidate per (root, path), whichever place rows
    // name it. A field has no scope-end `close` of its own (its owner drops
    // it), so moving it out changes no observable release.
    read_places := [U64:Bool]{}
    loop row in builder.blocks {
        loop instruction in row.instructions {
            if instruction.operation == .ReadPlace(place) -> _ := &read_places.add(place.value, true)
        }
    }
    field_candidate := [U64:Int]{}
    root_fields := [Int:[Int]]{}
    by_path := [String:Int]{}
    loop row in builder.places {
        if read_places.get(row.id.value) == None || row.projections.len() == 0 || row.persist_key != None -> next
        if jet_codegen_last_use_view(row.ty) -> next
        root_key := String?{None}
        if row.base == {
            .Local(local) -> root_key = Val("local:{local.value}")
            .Parameter(value) -> root_key = Val("parameter:{value.value}")
            else -> {}
        }
        key :: root_key ?? next
        owner :: root_candidate.get(key) ?? next
        path :: jet_codegen_last_use_field_path(row.projections) ?? next
        path_key := "{owner}"
        loop field in path -> path_key = "{path_key}.{field.value}"
        candidate := by_path.get(path_key) ?? -1
        if candidate < 0 {
            candidate = candidates.len()
            _ := &by_path.add(path_key, candidate)
            &candidates.push(jet_codegen_last_use_new_candidate(false, true, false, row.id, no_place, no_value, owner, path))
            &rejected.push(false)
            fields := root_fields.get(owner) ?? [Int]{}
            &fields.push(candidate)
            _ := &root_fields.add(owner, fields)
        }
        _ := &field_candidate.add(row.id.value, candidate)
    }
    // Every candidate a place observes: its root and the field candidates of
    // that root it overlaps.
    touches := [U64:[Int]]{}
    loop row in builder.places {
        root :: place_candidate.get(row.id.value) ?? next
        observed := [Int]{root}
        if root_fields.get(root) == .Val(fields) {
            loop field in fields {
                if jet_codegen_last_use_overlaps(row.projections, candidates[field].path) -> &observed.push(field)
            }
        }
        _ := &touches.add(row.id.value, observed)
    }
    // Locals an operation names by identity (a parameter's local row names
    // the parameter's own place).
    local_candidate := [U64:Int]{}
    loop local in builder.locals {
        if place_candidate.get(local.place.value) == .Val(candidate) {
            if local_candidate.get(local.id.value) == None -> _ := &local_candidate.add(local.id.value, candidate)
        }
    }
    // A parameter read as a bare value rather than through its place is
    // outside this place-based liveness; such a parameter keeps its lexical
    // lifetime.
    loop row in builder.blocks {
        uses := mir_terminator_value_uses(row.terminator)
        loop instruction in row.instructions {
            loop value in mir_operation_value_uses(instruction.operation) -> &uses.push(value)
        }
        loop value in uses {
            if root_candidate.get("parameter:{value.value}") == .Val(candidate) -> rejected[candidate] = true
        }
    }

    // Copies: the result of a ReadPlace of a candidate place, with that
    // place, its block and its index. A ReadBorrow read (a borrowed local's
    // write, jet_codegen_write_borrowed_binding) is no copy: it is a borrow
    // origin below, so storing it keeps every read of its place a copy.
    copy_place := [U64:U64]{}
    copy_block := [U64:Int]{}
    copy_index := [U64:Int]{}
    copy_order := [U64]{}
    loop (block, row) in builder.blocks {
        loop (index, instruction) in row.instructions {
            if instruction.operation == .ReadPlace(place) {
                if instruction.result == .Val(result) {
                    if touches.get(place.value) != None && !jet_codegen_last_use_holds_borrow(builder, program, value_row, result) {
                        _ := &copy_place.add(result.value, place.value)
                        _ := &copy_block.add(result.value, block)
                        _ := &copy_index.add(result.value, index)
                        &copy_order.push(result.value)
                    }
                }
            }
        }
    }

    // Enum subjects: every use is an EnumIs or an EnumPayload, and each
    // block that binds payloads binds those of one variant (each index once)
    // after every EnumIs of that block. Each such block (one match arm) is
    // its own payload group; an arm whose bindings are the subject's last
    // use takes the subject apart there.
    enum_uses := [JetCodegenLastUseEnumUse]{}
    enum_subject := [U64]{}
    other_uses := [U64:Bool]{}
    loop (block, row) in builder.blocks {
        loop (index, instruction) in row.instructions {
            if instruction.operation == {
                .EnumIs(subject, owner, variant) -> {
                    &enum_uses.push(JetCodegenLastUseEnumUse{block: block, index: index, payload: false, owner: owner, variant: variant, field: -1})
                    &enum_subject.push(subject.value)
                }
                .EnumPayload(subject, owner, variant, field) -> {
                    &enum_uses.push(JetCodegenLastUseEnumUse{block: block, index: index, payload: true, owner: owner, variant: variant, field: field})
                    &enum_subject.push(subject.value)
                }
                else -> {
                    loop value in mir_operation_value_uses(instruction.operation) -> _ := &other_uses.add(value.value, true)
                }
            }
        }
        loop value in mir_terminator_value_uses(row.terminator) -> _ := &other_uses.add(value.value, true)
    }
    loop row in builder.places {
        if row.base == .Temporary(value) -> _ := &other_uses.add(value.value, true)
    }
    uses_by_subject := [U64:[Int]]{}
    subject_order := [U64]{}
    loop (row, subject) in enum_subject {
        rows := uses_by_subject.get(subject) ?? {
            &subject_order.push(subject)
            [Int]{}
        }
        &rows.push(row)
        _ := &uses_by_subject.add(subject, rows)
    }
    subject_candidate := [U64:Int]{}
    groups := [JetCodegenLastUseGroup]{}
    loop subject in subject_order {
        if other_uses.get(subject) != None -> next
        if uses_by_subject.get(subject) == None -> next
        rows :: uses_by_subject.get(subject) ?? panic("checked last-use row is missing")
        arm_payloads := [Int:[Int]]{}
        arm_order := [Int]{}
        loop row in rows {
            entry :: enum_uses[row]
            if entry.payload {
                arm := arm_payloads.get(entry.block) ?? {
                    &arm_order.push(entry.block)
                    [Int]{}
                }
                &arm.push(row)
                _ := &arm_payloads.add(entry.block, arm)
            }
        }
        if arm_order.len() == 0 -> next
        valid := true
        loop arm_block in arm_order {
            arm :: arm_payloads.get(arm_block) ?? panic("checked last-use row is missing")
            head :: enum_uses[arm[0]]
            fields := [Int:Bool]{}
            loop row in arm {
                entry :: enum_uses[row]
                if entry.owner != head.owner || entry.variant != head.variant || fields.get(entry.field) != None -> valid = false
                _ := &fields.add(entry.field, true)
            }
            loop row in rows {
                entry :: enum_uses[row]
                if !entry.payload && entry.block == arm_block && entry.index > head.index -> valid = false
            }
        }
        if def_block.get(subject) == None -> next
        defined_block :: def_block.get(subject) ?? panic("checked last-use row is missing")
        if def_index.get(subject) == None -> next
        defined_index :: def_index.get(subject) ?? panic("checked last-use row is missing")
        if builder.blocks[defined_block].instructions[defined_index].operation == {
            .Parameter(_, _) | .Capture(_) | .Global(_) -> valid = false
            // A borrowed local's value belongs to its subject: never taken apart.
            .ReadPlace(read) -> {
                if jet_codegen_borrowed_local_place(builder, program, read) -> valid = false
            }
            else -> {}
        }
        if value_row.get(subject) == None -> next
        fact_row :: value_row.get(subject) ?? panic("checked last-use row is missing")
        if builder.values[fact_row].ownership.mode == {
            .Owned | .Move -> {}
            else -> valid = false
        }
        if jet_codegen_read_window_of(builder, program, MIRValueID{value: subject}) != None -> valid = false
        if !valid -> next
        _ := &subject_candidate.add(subject, candidates.len())
        loop arm_block in arm_order {
            arm :: arm_payloads.get(arm_block) ?? panic("checked last-use row is missing")
            indices := [Int]{}
            loop row in arm -> &indices.push(enum_uses[row].index)
            &groups.push(JetCodegenLastUseGroup{candidate: candidates.len(), block: arm_block, payloads: indices})
        }
        &candidates.push(jet_codegen_last_use_new_candidate(false, false, false, no_place, no_place, MIRValueID{value: subject}, -1, [MIRFieldID]{}))
        &rejected.push(false)
    }
    if candidates.len() == 0 -> return

    // CFG: predecessors, reachable blocks and guarded cleanup blocks.
    cfg := jet_codegen_last_use_cfg(builder, block_count, block_index, def_block, def_index, flag_candidate)
    predecessors := ^cfg.predecessors
    reachable := ^cfg.reachable
    guarded := ^cfg.guarded

    // Borrows and views of candidate places, by origin. An origin is a copy
    // (its own ReadPlace value, observing its place's candidates) or a
    // borrowed or view result of an operation on candidate places
    // (borrow_roots, with the candidates those places observe). A borrowed
    // or view result of an operand that carries origins carries them too,
    // transitively; every use of such a value is a use of its origins. An
    // operation that lets a place escape (raw address, closure capture) keeps
    // all of that place's reads copies.
    borrow_roots := [U64:[Int]]{}
    borrow_order := [U64]{}
    loop row in builder.blocks {
        loop instruction in row.instructions {
            escapes := false
            if instruction.operation == {
                .RawAddressOf(_) | .Closure(_, _, _) -> escapes = true
                else -> {}
            }
            observed := [Int]{}
            loop place in jet_codegen_last_use_places(instruction.operation) {
                list :: touches.get(place.value) ?? next
                loop candidate in list {
                    if escapes -> rejected[candidate] = true
                    &observed.push(candidate)
                }
            }
            if observed.len() == 0 -> next
            if instruction.operation == .ReadPlace(_) && copy_place.get((instruction.result ?? no_value).value) != None -> next
            if instruction.result == .Val(result) {
                if jet_codegen_last_use_holds_borrow(builder, program, value_row, result) {
                    if borrow_roots.get(result.value) == None -> &borrow_order.push(result.value)
                    _ := &borrow_roots.add(result.value, observed)
                }
            }
        }
    }
    origins := [U64:[U64]]{}
    loop value in copy_order -> _ := &origins.add(value, [U64]{value})
    loop value in borrow_order -> _ := &origins.add(value, [U64]{value})
    // The results that can carry origins: the filter is the same on every
    // pass, so the passes visit only these, in block and instruction order.
    // A carrier none of whose operands changed since it last ran would
    // change nothing and is skipped (`changed_at` / `ran_at` steps).
    carrier_blocks := [Int]{}
    carrier_indices := [Int]{}
    loop (block, row) in builder.blocks {
        loop (index, instruction) in row.instructions {
            result :: instruction.result ?? next
            if copy_place.get(result.value) != None || borrow_roots.get(result.value) != None -> next
            if !jet_codegen_last_use_holds_borrow(builder, program, value_row, result) -> next
            &carrier_blocks.push(block)
            &carrier_indices.push(index)
        }
    }
    changed_at := [U64:Int]{}
    ran_at := (loop _ in 0..<carrier_blocks.len() -> -1)
    step := 0
    changed := carrier_blocks.len() > 0
    loop changed {
        changed = false
        loop carrier in 0..<carrier_blocks.len() {
            instruction :: builder.blocks[carrier_blocks[carrier]].instructions[carrier_indices[carrier]]
            result :: instruction.result ?? next
            step = step + 1
            last_ran :: ran_at[carrier]
            ran_at[carrier] = step
            if last_ran >= 0 {
                stale := false
                loop operand in mir_operation_value_uses(instruction.operation) {
                    if (changed_at.get(operand.value) ?? -1) > last_ran -> stale = true
                }
                if !stale -> next
            }
            carried := origins.get(result.value) ?? [U64]{}
            before :: carried.len()
            seen := [U64:Bool]{}
            loop origin in carried -> _ := &seen.add(origin, true)
            loop operand in mir_operation_value_uses(instruction.operation) {
                from :: origins.get(operand.value) ?? next
                loop origin in from {
                    if seen.get(origin) == None {
                        _ := &seen.add(origin, true)
                        &carried.push(origin)
                    }
                }
            }
            if carried.len() != before {
                _ := &origins.add(result.value, carried)
                changed_at[result.value] = step
                changed = true
            }
        }
    }
    // A borrow or view stored into a place or captured outlives every read
    // this pass decides.
    loop row in builder.blocks {
        loop instruction in row.instructions {
            stored := [MIRValueID]{}
            if instruction.operation == {
                .WritePlace(_, value) -> &stored.push(value)
                .ReplacePlace(_, value) -> &stored.push(value)
                .Closure(_, captures, _) -> {
                    loop capture in captures {
                        if capture == .Value(value) -> &stored.push(value)
                    }
                }
                else -> {}
            }
            loop value in stored {
                if copy_place.get(value.value) != None -> next
                from :: origins.get(value.value) ?? next
                loop origin in from {
                    loop candidate in jet_codegen_last_use_observed(touches, copy_place, borrow_roots, origin) -> rejected[candidate] = true
                }
            }
        }
    }

    // A use of a copy's value after the copy in its own block lies in the
    // copy's read window; a use anywhere else is tracked by the copy's own
    // liveness bit.
    copy_bit := [U64:Int]{}
    loop (block, row) in builder.blocks {
        terminator_index :: row.instructions.len()
        use_values := [MIRValueID]{}
        use_indices := [Int]{}
        loop (index, instruction) in row.instructions {
            loop value in mir_operation_value_uses(instruction.operation) {
                &use_values.push(value)
                &use_indices.push(index)
            }
        }
        loop value in mir_terminator_value_uses(row.terminator) {
            &use_values.push(value)
            &use_indices.push(terminator_index)
        }
        loop (position, value) in use_values {
            from :: origins.get(value.value) ?? next
            loop origin in from {
                if copy_place.get(origin) == None || copy_bit.get(origin) != None -> next
                if jet_codegen_last_use_inside_copy(copy_block, copy_index, origin, block, use_indices[position]) -> next
                _ := &copy_bit.add(origin, candidates.len())
                &candidates.push(jet_codegen_last_use_new_candidate(false, false, true, no_place, no_place, MIRValueID{value: origin}, -1, [MIRFieldID]{}))
                &rejected.push(false)
            }
        }
    }
    // The copy bits that observe each candidate.
    observing := [Int:[Int]]{}
    loop value in copy_order {
        bit :: copy_bit.get(value) ?? next
        observed :: touches.get(copy_place.get(value) ?? 0) ?? [Int]{}
        loop candidate in observed {
            bits := observing.get(candidate) ?? [Int]{}
            &bits.push(bit)
            _ := &observing.add(candidate, bits)
        }
    }

    // Per-block events in execution order; the terminator's index is the
    // block's instruction count.
    copy_end := [U64:Int]{}
    events := [JetCodegenLastUseEvent]{}
    event_start := [Int]{}
    remainder :: jet_codegen_last_use_remainder_moves(builder, place_row)
    loop (block, row) in builder.blocks {
        &event_start.push(events.len())
        loop (index, instruction) in row.instructions {
            kills := [Int]{}
            loop place in jet_codegen_last_use_places(instruction.operation) {
                list :: touches.get(place.value) ?? next
                projections :: builder.places[place_row.get(place.value) ?? panic("checked last-use row is missing")].projections
                loop candidate in list {
                    entry :: candidates[candidate]
                    // 1 = kill, 0 = use, -1 = no event.
                    outcome := 0
                    if entry.local {
                        whole :: place == entry.place
                        if instruction.operation == {
                            .WritePlace(_, _) | .ReplacePlace(_, _) | .InitializeUninit(_) -> {
                                if whole -> outcome = 1
                            }
                            .MovePlace(_) -> {
                                if whole && guarded[block] == candidate -> outcome = -1
                            }
                            else -> {}
                        }
                    } else if entry.field {
                        // A write of the field or of a record prefix replaces
                        // it; a replace that releases a larger owner reads
                        // it, and so does every move of a prefix except the
                        // owner's remainder drop, which skips moved fields.
                        if instruction.operation == {
                            .WritePlace(_, _) | .InitializeUninit(_) -> {
                                if jet_codegen_last_use_covers(projections, entry.path) -> outcome = 1
                            }
                            .ReplacePlace(_, _) -> {
                                if projections.len() == entry.path.len() && jet_codegen_last_use_covers(projections, entry.path) -> outcome = 1
                            }
                            .MovePlace(_) -> {
                                if projections.len() == 0 && remainder.get((instruction.result ?? no_value).value) != None -> outcome = -1
                            }
                            else -> {}
                        }
                    } else {
                        outcome = -1
                    }
                    if outcome == 1 -> &kills.push(candidate)
                    if outcome == 0 -> &events.push(JetCodegenLastUseEvent{index: index, candidate: candidate, kill: false})
                }
            }
            loop local in jet_codegen_last_use_locals(instruction.operation) {
                if local_candidate.get(local.value) == None -> next
                candidate :: local_candidate.get(local.value) ?? panic("checked last-use row is missing")
                &events.push(JetCodegenLastUseEvent{index: index, candidate: candidate, kill: false})
                fields :: root_fields.get(candidate) ?? [Int]{}
                loop field in fields -> &events.push(JetCodegenLastUseEvent{index: index, candidate: field, kill: false})
            }
            loop value in mir_operation_value_uses(instruction.operation) {
                jet_codegen_last_use_value_events(&events, &copy_end, subject_candidate, origins, copy_block, copy_index, copy_bit, borrow_roots, block, index, value)
            }
            if instruction.result == .Val(result) {
                if subject_candidate.get(result.value) == .Val(candidate) -> &kills.push(candidate)
                if copy_bit.get(result.value) == .Val(bit) -> &kills.push(bit)
            }
            loop candidate in kills -> &events.push(JetCodegenLastUseEvent{index: index, candidate: candidate, kill: true})
        }
        terminator_index :: row.instructions.len()
        loop value in mir_terminator_value_uses(row.terminator) {
            jet_codegen_last_use_value_events(&events, &copy_end, subject_candidate, origins, copy_block, copy_index, copy_bit, borrow_roots, block, terminator_index, value)
        }
        if !reachable[block] {
            loop event_index in event_start[block]..<events.len() {
                if events[event_index].kill -> next
                candidate :: events[event_index].candidate
                if candidates[candidate].copied {
                    observed :: touches.get(copy_place.get(candidates[candidate].value.value) ?? 0) ?? [Int]{}
                    loop observed_candidate in observed -> rejected[observed_candidate] = true
                } else {
                    rejected[candidate] = true
                }
            }
        }
    }
    &event_start.push(events.len())
    read_windows := [Int:[Int]]{}
    loop value in copy_order {
        if copy_end.get(value) == .Val(window_end) {
            window_block :: copy_block.get(value) ?? -1
            window_candidates :: touches.get(copy_place.get(value) ?? 0) ?? [Int]{}
            loop window_candidate in window_candidates {
                key :: jet_codegen_last_use_key(window_block, window_candidate)
                bounds := read_windows.get(key) ?? [Int]{}
                &bounds.push(copy_index.get(value) ?? -1)
                &bounds.push(window_end)
                _ := &read_windows.add(key, bounds)
            }
        }
    }

    live_out := jet_codegen_last_use_live_out(block_count, events, event_start, predecessors)

    // Each value's uses, as parallel (block, index) rows with the terminator
    // at the block's instruction count, to decide whether a read is consumed.
    users_block := [U64:[Int]]{}
    users_index := [U64:[Int]]{}
    loop (block, row) in builder.blocks {
        terminator_index :: row.instructions.len()
        use_values := [MIRValueID]{}
        use_indices := [Int]{}
        loop (index, instruction) in row.instructions {
            loop value in mir_operation_value_uses(instruction.operation) {
                &use_values.push(value)
                &use_indices.push(index)
            }
        }
        loop value in mir_terminator_value_uses(row.terminator) {
            &use_values.push(value)
            &use_indices.push(terminator_index)
        }
        loop (position, value) in use_values {
            user_blocks := users_block.get(value.value) ?? [Int]{}
            user_indices := users_index.get(value.value) ?? [Int]{}
            &user_blocks.push(block)
            &user_indices.push(use_indices[position])
            _ := &users_block.add(value.value, user_blocks)
            _ := &users_index.add(value.value, user_indices)
        }
    }

    // Decide each read against the liveness right after it.
    group_end := [Int:Int]{}
    loop (group_index, row) in groups -> _ := &group_end.add(jet_codegen_last_use_key(row.block, row.payloads[row.payloads.len() - 1]), group_index)
    conversions := [Int:Int]{}
    iter_takes := [Int:Bool]{}
    moved_groups := [Int]{}
    loop block in 0..<block_count {
        if !reachable[block] -> next
        // The fixed point is complete; consume this live-out row in place.
        cursor := event_start[block + 1]
        index := builder.blocks[block].instructions.len()
        loop cursor > event_start[block] && events[cursor - 1].index >= index {
            cursor -= 1
            _ := &live_out[block].add(events[cursor].candidate, !events[cursor].kill)
        }
        loop index > 0 {
            index -= 1
            if builder.blocks[block].instructions[index].operation == .ReadPlace(place) {
                target := -1
                if place_candidate.get(place.value) == .Val(root_index) {
                    if candidates[root_index].local && candidates[root_index].place == place -> target = root_index
                }
                if target < 0 -> target = field_candidate.get(place.value) ?? -1
                if builder.blocks[block].instructions[index].result == .Val(result) && target >= 0 {
                    // A field move pays for splitting its owner only for an
                    // owned (heap) value; a Copy field stays a read. The
                    // liveness right after the read already proves nothing
                    // reads the field before a refill or its owner's
                    // remainder drop (MIR legality admits both).
                    root := target
                    // #5041: a ReadBorrow read (a borrowed carrier's payload,
                    // jet_codegen_emit_borrowed_carrier) lends the place and
                    // never takes it, even at the place's last use.
                    worth := true
                    if value_row.get(result.value) == .Val(read_row) -> worth = !jet_codegen_last_use_borrowed(builder.values[read_row].ownership.mode)
                    if candidates[target].field {
                        root = candidates[target].root
                        worth = false
                        if value_row.get(result.value) == .Val(fact_row) {
                            if builder.values[fact_row].ownership.mode == {
                                .Owned | .Move -> worth = true
                                else -> {}
                            }
                        }
                    }
                    own :: copy_bit.get(result.value) ?? -1
                    other_copy := false
                    bits :: observing.get(target) ?? [Int]{}
                    loop bit in bits {
                        if bit != own && (live_out[block].get(bit) ?? false) -> other_copy = true
                    }
                    // A read only a borrowed list walk's cursor takes moves
                    // into it, and the walk then hands its items out by value.
                    consumed := jet_codegen_last_use_consumed(builder, program, users_block, users_index, result)
                    iter_key := -1
                    if !consumed {
                        listed := false
                        if value_row.get(result.value) == .Val(list_row) {
                            if builder.values[list_row].ty.kind == .List(_) -> listed = true
                        }
                        if listed -> iter_key = jet_codegen_last_use_iter_source(builder, users_block, users_index, result)
                    }
                    if worth && !rejected[target] && !rejected[root] && !(live_out[block].get(target) ?? false) && !jet_codegen_last_use_in_window(read_windows, block, index, target) && !other_copy && jet_codegen_read_window_of(builder, program, result) == None && (consumed || iter_key >= 0) {
                        _ := &conversions.add(jet_codegen_last_use_key(block, index), target)
                        if iter_key >= 0 -> _ := &iter_takes.add(iter_key, true)
                    }
                }
            }
            if group_end.get(jet_codegen_last_use_key(block, index)) == .Val(group_index) {
                candidate :: groups[group_index].candidate
                if !rejected[candidate] && !(live_out[block].get(candidate) ?? false) -> &moved_groups.push(group_index)
            }
            loop cursor > event_start[block] && events[cursor - 1].index >= index {
                cursor -= 1
                _ := &live_out[block].add(events[cursor].candidate, !events[cursor].kill)
            }
        }
    }
    if conversions.len() == 0 && moved_groups.len() == 0 -> return

    // Rewrite each touched block once: a group's Move goes before its first
    // payload, which with the later payloads reads the moved value; a
    // converted read becomes a MovePlace of its own place, and a whole
    // local's is followed by its drop-flag clear. A field move leaves its
    // owner live: the refill that follows makes it whole again.
    takes := [Int:MIRInstruction]{}
    retarget := [Int:MIRValueID]{}
    touched := [Int:Bool]{}
    loop group_index in moved_groups {
        row :: groups[group_index]
        subject :: candidates[row.candidate].value
        first_span := builder.blocks[row.block].instructions[row.payloads[0]].span
        if value_row.get(subject.value) == None -> next
        fact_row :: value_row.get(subject.value) ?? panic("checked last-use row is missing")
        subject_ty := builder.values[fact_row].ty
        moved_take :: jet_codegen_last_use_instruction(&builder, program, first_span, "match.payload.take", Val(subject_ty), mir_ownership_from_access(MIRAccess.Move), MIROperation.Move{value: subject})
        if moved_take.result == None -> next
        taken :: moved_take.result ?? panic("checked last-use row is missing")
        _ := &takes.add(jet_codegen_last_use_key(row.block, row.payloads[0]), moved_take)
        loop payload in row.payloads -> _ := &retarget.add(jet_codegen_last_use_key(row.block, payload), taken)
        _ := &touched.add(row.block, true)
    }
    moved_reads := [Int:MIRPlaceID]{}
    clears := [Int:[MIRInstruction]]{}
    bool_type :: jet_codegen_lower_type_for_function(Type.Bool, builder, program)
    loop block in 0..<block_count {
        loop index in 0..<builder.blocks[block].instructions.len() {
            key :: jet_codegen_last_use_key(block, index)
            if conversions.get(key) == None -> next
            candidate :: conversions.get(key) ?? panic("checked last-use row is missing")
            read_place := no_place
            if builder.blocks[block].instructions[index].operation == .ReadPlace(place) -> read_place = place
            _ := &moved_reads.add(key, read_place)
            _ := &touched.add(block, true)
            if place_row.get(read_place.value) == .Val(place_index) -> builder.places[place_index].access = MIRAccess.Move
            if builder.blocks[block].instructions[index].result == .Val(result) {
                if value_row.get(result.value) == .Val(fact_row) -> builder.values[fact_row].ownership = mir_ownership_from_access(MIRAccess.Move)
            }
            if !candidates[candidate].local -> next
            span := builder.blocks[block].instructions[index].span
            off :: jet_codegen_last_use_instruction(&builder, program, span, "owned.local.last-use.state", Val(bool_type), mir_copy_ownership(), MIROperation.Constant{value: MIRConstant.Bool{value: false}})
            if off.result == None -> next
            off_value :: off.result ?? panic("checked last-use row is missing")
            write :: jet_codegen_last_use_instruction(&builder, program, span, "owned.local.last-use.update", None, mir_copy_ownership(), MIROperation.WritePlace{place: candidates[candidate].flag, value: off_value})
            _ := &clears.add(key, [MIRInstruction]{off, write})
        }
    }
    // A borrowed list walk whose collection read became a move takes the
    // list by value (LoopIterInit by_value: the items move out of it).
    loop block in 0..<block_count {
        loop index in 0..<builder.blocks[block].instructions.len() {
            if iter_takes.get(jet_codegen_last_use_key(block, index)) != None -> _ := &touched.add(block, true)
        }
    }
    loop block in 0..<block_count {
        if touched.get(block) == None -> next
        rewritten := [MIRInstruction]{}
        loop (index, original) in builder.blocks[block].instructions {
            key :: jet_codegen_last_use_key(block, index)
            if takes.get(key) == .Val(moved_take) -> &rewritten.push(moved_take)
            instruction := original
            if retarget.get(key) == .Val(taken) && original.operation == .EnumPayload(_, owner, variant, field) {
                instruction.operation = MIROperation.EnumPayload{subject: taken, owner: owner, variant: variant, index: field}
            }
            if moved_reads.get(key) == .Val(read_place) -> instruction.operation = MIROperation.MovePlace{place: read_place}
            if iter_takes.get(key) != None && original.operation == .LoopIterInit(call, collection, step, _, source_kind) {
                instruction.operation = MIROperation.LoopIterInit{call: call, collection: collection, step: step, by_value: true, source_kind: source_kind}
            }
            &rewritten.push(instruction)
            if clears.get(key) == .Val(extra) {
                loop added in extra -> &rewritten.push(added)
            }
        }
        builder.blocks[block].instructions = rewritten
    }
}

// move_last_uses's CFG: successors, predecessors, blocks reachable from the
// entry along explicit edges, and cleanup blocks guarded by one local's drop
// flag (every predecessor branches to the block on that flag's then edge).
// A separate function keeps move_last_uses within what one backend codegen
// unit compiles quickly.
fn jet_codegen_last_use_cfg(builder: JetCodegenBuilder, block_count: Int, block_index: [U64:Int], def_block: [U64:Int], def_index: [U64:Int], flag_candidate: [U64:Int]) -> JetCodegenLastUseCFG Never! {
    successors := [[Int]]{}
    predecessors := [[Int]]{}
    loop filler in 0..<block_count -> &predecessors.push([Int]{})
    loop (block, row) in builder.blocks {
        targets := [Int]{}
        loop target in mir_terminator_targets(row.terminator) {
            if block_index.get(target.value) == .Val(target_index) {
                &targets.push(target_index)
                &predecessors[target_index].push(block)
            }
        }
        &successors.push(targets)
    }
    reachable := [Bool]{}
    loop filler in 0..<block_count -> &reachable.push(false)
    if block_index.get(builder.entry.value) == .Val(entry) {
        pending := [Int]{entry}
        reachable[entry] = true
        loop pending.len() > 0 {
            block :: &pending.pop() ?? { break }
            loop target in successors[block] {
                if !reachable[target] {
                    reachable[target] = true
                    &pending.push(target)
                }
            }
        }
    }
    guard_of := [Int]{}
    loop (block, row) in builder.blocks {
        flag_guard := -1
        if row.terminator == .Branch(condition, then_target, else_target) && then_target != else_target {
            if def_block.get(condition.value) == .Val(flag_block) {
                flag_index :: def_index.get(condition.value) ?? -1
                if builder.blocks[flag_block].instructions[flag_index].operation == .ReadPlace(flag) {
                    flag_guard = flag_candidate.get(flag.value) ?? -1
                }
            }
        }
        &guard_of.push(flag_guard)
    }
    guarded := [Int]{}
    loop (block, preds) in predecessors {
        shared_guard := -1
        if preds.len() > 0 {
            shared_guard = guard_of[preds[0]]
            loop pred in preds {
                then_index := -1
                if builder.blocks[pred].terminator == .Branch(_, then_target, _) -> then_index = block_index.get(then_target.value) ?? -1
                if guard_of[pred] != shared_guard || then_index != block -> shared_guard = -1
            }
        }
        &guarded.push(shared_guard)
    }
    jet_codegen_last_use_bypass_retests(builder, block_index, def_block, def_index, &predecessors)
    JetCodegenLastUseCFG{predecessors: ^predecessors, reachable: ^reachable, guarded: ^guarded}
}

// One re-test join bypassed for liveness: `target` (a successor of `join`)
// lists `preds` (the join's predecessors whose edge agrees) instead of
// `join`.
struct JetCodegenLastUseBypass {
    target: Int
    join: Int
    preds: [Int]
}

// The liveness predecessors (move_last_uses walks them only for liveness):
// a bound pattern condition branches on its test to the binding block or
// straight to its join, and the join re-branches on a trivial phi of that
// same test (jet_codegen_lower_pattern_shape_condition, Rust
// lower_guarded_pattern). A predecessor that enters the join on the test's
// false edge never leaves it on the true edge, and the binding block never
// leaves it on the false edge, so each successor of the join lists the
// join's predecessors whose edge agrees (an edge of unknown outcome feeds
// both) instead of the join, which holds only that phi. Otherwise a binding
// consumed in its arm stays live along the unmatched edge and, around a
// loop's back edge, is never a last use inside a loop. Native lowering
// prunes the same edge for payload takes (lower_use_infeasible). Every
// bypass is decided on the CFG's own predecessors before any is applied.
fn jet_codegen_last_use_bypass_retests(builder: JetCodegenBuilder, block_index: [U64:Int], def_block: [U64:Int], def_index: [U64:Int], predecessors: &[[Int]]) Never! {
    bypasses := [JetCodegenLastUseBypass]{}
    loop (join, row) in builder.blocks {
        tested :: jet_codegen_last_use_retest(builder, def_block, def_index, join) ?? next
        then_index := -1
        else_index := -1
        if row.terminator == .Branch(_, then_target, else_target) {
            then_index = block_index.get(then_target.value) ?? -1
            else_index = block_index.get(else_target.value) ?? -1
        }
        if then_index < 0 || else_index < 0 || then_index == join || else_index == join || then_index == else_index -> next
        then_preds := [Int]{}
        else_preds := [Int]{}
        loop pred in predecessors[join] {
            known :: jet_codegen_last_use_edge_known(builder, block_index, def_block, def_index, predecessors, pred, join, tested)
            if known != 0 -> &then_preds.push(pred)
            if known != 1 -> &else_preds.push(pred)
        }
        &bypasses.push(JetCodegenLastUseBypass{target: then_index, join: join, preds: ^then_preds})
        &bypasses.push(JetCodegenLastUseBypass{target: else_index, join: join, preds: ^else_preds})
    }
    loop bypass in bypasses {
        rows := [Int]{}
        loop pred in predecessors[bypass.target] {
            if pred == bypass.join {
                loop agreeing in bypass.preds -> &rows.push(agreeing)
            } else {
                &rows.push(pred)
            }
        }
        predecessors[bypass.target] = ^rows
    }
}

// The test a pattern's re-test join branches on: the join's only
// instruction is a trivial phi (every incoming value the same test) and its
// terminator branches on that phi. None for any other block.
fn jet_codegen_last_use_retest(builder: JetCodegenBuilder, def_block: [U64:Int], def_index: [U64:Int], block: Int) -> MIRValueID? Never! {
    row :: builder.blocks[block]
    if row.instructions.len() != 1 -> return None
    if row.terminator == .Branch(condition, _, _) {
        if row.instructions[0].result != (Val(condition)) -> return None
        if !(row.instructions[0].operation == .Phi(_)) -> return None
        tested :: jet_codegen_last_use_tested(builder, def_block, def_index, condition)
        if tested == condition -> return None
        return Val(tested)
    }
    None
}

// The value a branch condition tests: a trivial phi (every incoming value
// the same) stands for that value, as native lower_use_tested reads it.
fn jet_codegen_last_use_tested(builder: JetCodegenBuilder, def_block: [U64:Int], def_index: [U64:Int], condition: MIRValueID) -> MIRValueID Never! {
    block :: def_block.get(condition.value) ?? return condition.copy()
    index :: def_index.get(condition.value) ?? return condition.copy()
    if builder.blocks[block].instructions[index].operation == .Phi(incoming) {
        if incoming.len() == 0 || incoming[0].value == condition -> return condition.copy()
        loop row in incoming {
            if row.value != incoming[0].value -> return condition.copy()
        }
        return jet_codegen_last_use_tested(builder, def_block, def_index, incoming[0].value)
    }
    condition.copy()
}

// Whether the edge from `from` into `join` is taken only when `tested`
// holds (1), only when it fails (0), or either way (-1): `from` branches on
// `tested` with `join` as one target, or `from` ends a chain of
// single-predecessor blocks (a pattern's binding block) entered from one
// edge of such a branch.
fn jet_codegen_last_use_edge_known(builder: JetCodegenBuilder, block_index: [U64:Int], def_block: [U64:Int], def_index: [U64:Int], predecessors: [[Int]], from: Int, join: Int, tested: MIRValueID) -> Int Never! {
    if builder.blocks[from].terminator == .Branch(condition, then_target, else_target) {
        return jet_codegen_last_use_branch_known(builder, block_index, def_block, def_index, condition, then_target, else_target, join, tested)
    }
    if !(builder.blocks[from].terminator == .Jump(_)) -> return -1
    at := from
    steps := 0
    loop steps < 16 {
        if predecessors[at].len() != 1 -> return -1
        entry :: predecessors[at][0]
        if builder.blocks[entry].terminator == {
            .Branch(condition, then_target, else_target) -> return jet_codegen_last_use_branch_known(builder, block_index, def_block, def_index, condition, then_target, else_target, at, tested)
            .Jump(_) -> {
                at = entry
                steps += 1
            }
            else -> return -1
        }
    }
    -1
}

// 1 when the branch reaches `target` only on its true edge of `tested`, 0
// only on its false edge, -1 otherwise.
fn jet_codegen_last_use_branch_known(builder: JetCodegenBuilder, block_index: [U64:Int], def_block: [U64:Int], def_index: [U64:Int], condition: MIRValueID, then_target: MIRBlockID, else_target: MIRBlockID, target: Int, tested: MIRValueID) -> Int Never! {
    if then_target == else_target -> return -1
    if jet_codegen_last_use_tested(builder, def_block, def_index, condition) != tested -> return -1
    if (block_index.get(then_target.value) ?? -1) == target -> return 1
    if (block_index.get(else_target.value) ?? -1) == target -> return 0
    return -1
}

// move_last_uses's backward liveness: the candidates live out of each block.
// Each live-in candidate propagates to predecessors once. Sparse rows and
// candidate deltas reach the same least fixed point without rescans.
fn jet_codegen_last_use_live_out(block_count: Int, events: [JetCodegenLastUseEvent], event_start: [Int], predecessors: [[Int]]) -> [[Int:Bool]] Never! {
    killed := [[Int:Bool]]{}
    live_in := [[Int:Bool]]{}
    live_out := [[Int:Bool]]{}
    live_delta := [[Int]]{}
    delta_cursor := [Int]{}
    pending := [Int]{}
    queued := [Bool]{}
    loop block in 0..<block_count {
        &killed.push([Int:Bool]{})
        &live_in.push([Int:Bool]{})
        &live_out.push([Int:Bool]{})
        &live_delta.push([Int]{})
        &delta_cursor.push(0)
        // Pop the initial blocks in reverse physical order.
        &pending.push(block)
        &queued.push(true)
        loop event_index in event_start[block]..<event_start[block + 1] {
            event :: events[event_index]
            if event.kill {
                _ := &killed[block].add(event.candidate, true)
            } else if killed[block].get(event.candidate) == None && live_in[block].get(event.candidate) == None {
                _ := &live_in[block].add(event.candidate, true)
                &live_delta[block].push(event.candidate)
            }
        }
    }
    loop pending.len() > 0 {
        block :: &pending.pop() ?? { break }
        queued[block] = false
        loop delta_cursor[block] < live_delta[block].len() {
            candidate := live_delta[block][delta_cursor[block]]
            delta_cursor[block] = delta_cursor[block] + 1
            loop pred in predecessors[block] {
                if live_out[pred].get(candidate) != None -> next
                _ := &live_out[pred].add(candidate, true)
                if killed[pred].get(candidate) != None || live_in[pred].get(candidate) != None -> next
                _ := &live_in[pred].add(candidate, true)
                &live_delta[pred].push(candidate)
                if !queued[pred] {
                    queued[pred] = true
                    &pending.push(pred)
                }
            }
        }
    }
    live_out
}
