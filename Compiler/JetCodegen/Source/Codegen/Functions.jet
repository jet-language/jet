]

struct JetCodegenFunctions {
    functions: [MIRFunction]
    nested_functions: [MIRFunction]
    callbacks: [MIRCallbackAdapter]
    closure_sources: [JetCodegenClosureSource]
    types: [MIRTypeDef]
    core_owners: [MIRCoreOwner]
    traits: [MIRTraitDef]
    impls: [MIRImplDef]
    constants: [MIRConstantDef]
    fields: [MIRFieldRow]
    core_calls: [MIRCoreCall]
    prelude_calls: [MIRPreludeCall]
    used_core: [String]
}
struct JetCodegenForeignArtifacts {
    foreign: [MIRForeign]
    links: [MIRLinkUnit]
    handles: [MIRHandleLifecycle]
    // Rust `function_foreign_provenance`: one body-less `asm` leaf per
    // checked `#FFI(asm)` row, keyed like its foreign row, so native
    // lowering binds the foreign call to the declaration's inline body.
    functions: [MIRFunction]
}
fn jet_codegen_lower_declaration_ownership_mode(ownership: TDeclarationOwnership) -> MIROwnershipMode Never! {
    if ownership == {
        .Owned -> MIROwnershipMode.Owned
        .ReadBorrow -> MIROwnershipMode.ReadBorrow
        .WriteBorrow -> MIROwnershipMode.WriteBorrow
        .Move -> MIROwnershipMode.Move
    }
}

fn jet_codegen_lower_declaration_ownership(ownership: TDeclarationOwnership) -> MIROwnership Never! {
    if ownership == {
        .Owned -> mir_owned_ownership()
        .ReadBorrow -> MIROwnership{mode: MIROwnershipMode.ReadBorrow, drop: MIRDropKind.NoDrop, moved: false, last_use: false, gc_root: false}
        .WriteBorrow -> MIROwnership{mode: MIROwnershipMode.WriteBorrow, drop: MIRDropKind.NoDrop, moved: false, last_use: false, gc_root: false}
        .Move -> MIROwnership{mode: MIROwnershipMode.Move, drop: MIRDropKind.Value, moved: false, last_use: false, gc_root: false}
    }
}

fn jet_codegen_lower_declaration_field(field: TField, owner_key: String, modules: [SemaGraphModuleResult], module_identity: String, generic_names: [String]) -> MIRField Never! {
    return MIRField{
        id: mir_field_id("{owner_key}::{field.name}"),
        name: field.name,
        shape_names: MIRShapeFieldNames{
            text: field.shape_names.text,
            json: field.shape_names.json,
            cbor: field.shape_names.cbor,
            csv: field.shape_names.csv,
            toml: field.shape_names.toml,
            yaml: field.shape_names.yaml,
            xml: field.shape_names.xml,
            args: field.shape_names.args,
            env: field.shape_names.env,
            db: field.shape_names.db,
            layout: field.shape_names.layout,
        },
        skip: field.skip,
        ty: jet_codegen_lower_type_with_modules(field.ty, modules, module_identity, generic_names),
        span: field.span,
        public: field.public,
        package_public: field.package_public,
        computed: field.computed,
        has_default: field.has_default,
        redact: field.redact,
    }
}

fn jet_codegen_declaration_function_id(functions: JetCodegenFunctionIndex, key: String, module_identity: String) -> MIRFunctionID Never! {
    function :: jet_codegen_find_function_by_key(functions, key, module_identity) ?? panic("checked declaration function reference is not reachable")
    return jet_codegen_function_id(function)
}

// With `closure_only`, `functions` is a comptime closure and the row lists
// only the methods lowered with it: a method outside it is left out.
fn jet_codegen_type_method_ids(definition: TTypeDef, method_keys: [String], functions: JetCodegenFunctionIndex, closure_only: Bool) -> [MIRFunctionID] Never! {
    lowered := [MIRFunctionID]{}
    loop key in method_keys {
        function := jet_codegen_find_function_by_key(functions, key, definition.module_identity)
        if function == None {
            // Rust tir_to_mir_types.rs::resolve_type_methods: imported Core
            // metadata keeps every declared method while only reachable bodies
            // lower, and a generic owner's method is a template lowered per
            // demanded instance; a call to an omitted one fails at its site.
            if closure_only || definition.key.starts_with("<corelib>/") || definition.generic_params.len() > 0 -> next
            panic("checked type method has no reachable TFunc")
        }
        target :: function ?? panic("checked type method lookup lost its TFunc")
        &lowered.push(jet_codegen_function_id(target))
    }
    return lowered
}

fn jet_codegen_lower_declaration_generic_params(params: [TGenericParam], modules: [SemaGraphModuleResult]) -> [MIRGenericParam] Never! {
    lowered := [MIRGenericParam]{}
    loop param in params {
        bounds := [MIRTraitRef]{}
        loop bound in param.bounds -> &bounds.push(jet_codegen_mir_trait_ref_for_symbol(modules, bound))
        &lowered.push(MIRGenericParam{name: param.name, bounds: bounds})
    }
    return lowered
}

fn jet_codegen_lower_cli_value_kind(kind: TCLIValueKind) -> MIRCLIValueKind Never! {
    return if kind == {
        .Bool -> MIRCLIValueKind.Bool
        .Int -> MIRCLIValueKind.Int
        .Float -> MIRCLIValueKind.Float
        .String -> MIRCLIValueKind.String
        .Path -> MIRCLIValueKind.Path
    }
}

fn jet_codegen_lower_cli_default(default: TCLIDefault, modules: [SemaGraphModuleResult], module_identity: String) -> MIRCLIDefault? {
    return if default == {
        .TypeDefault -> Val(MIRCLIDefault.TypeDefault)
        .Value(value) -> {
            lowered :: jet_codegen_lower_comptime_value(value, modules, module_identity, [String]{}) ?? return None
            Val(MIRCLIDefault.Value{value: lowered})
        }
        .Recorded(value) -> Val(MIRCLIDefault.Value{value: MIRConstant.String{value: value}})
    }
}

fn jet_codegen_lower_cli_input(input: TCLIInput, ordinal: Int, modules: [SemaGraphModuleResult], module_identity: String) -> MIRCLIInput {
    shape := MIRCLIInputShape.Flag
    scalar_type := Type.Bool
    optional := false
    _ := if input.shape == {
        .Flag -> ()
        .Value(kind, is_optional, default) -> {
            lowered_kind := jet_codegen_lower_cli_value_kind(kind)
            scalar_type = if lowered_kind == {
                .Bool -> Type.Bool
                .Int -> Type.Int
                .Float -> Type.Float
                .String -> Type.String
                .Path -> Type.String
            }
            lowered_default := MIRCLIDefault?{None}
            if default != None {
                value :: default
                lowered_default = jet_codegen_lower_cli_default(value, modules, module_identity)
            }
            shape = MIRCLIInputShape.Value{kind: lowered_kind, optional: is_optional, default: lowered_default}
            optional = is_optional
            ()
        }
    }
    ty := scalar_type
    if {
        input.variadic -> {
            ty = Type.List{element: scalar_type}
        }
        optional -> {
            ty = Type.Option{inner: scalar_type}
        }
    }
    return MIRCLIInput{
        parameter: ordinal,
        name: input.field,
        label: input.field,
        ty: jet_codegen_lower_type_with_modules(ty, modules, module_identity, [String]{}),
        zone: ParamZone.Either,
        flag: input.flag,
        short: input.short,
        env: input.env,
        help: input.help,
        metavar: input.metavar,
        shape: shape,
        positional: input.positional,
        variadic: input.variadic,
    }
}

fn jet_codegen_lower_cli_inputs(inputs: [TCLIInput], modules: [SemaGraphModuleResult], module_identity: String) -> [MIRCLIInput] {
    lowered := [MIRCLIInput]{}
    index := 0
    loop input in inputs {
        &lowered.push(jet_codegen_lower_cli_input(input, index, modules, module_identity))
        index += 1
    }
    return lowered
}

fn jet_codegen_lower_cli_entry(entry: TCLIEntry, functions: JetCodegenFunctionIndex, modules: [SemaGraphModuleResult], module_identity: String) -> MIRCLIEntry {
    commands := [MIRCLICommand]{}
    loop command in entry.commands {
        if command.function != None {
            reference :: command.function ?? panic("checked CLI command function reference disappeared")
            inputs := jet_codegen_lower_cli_inputs(command.inputs, modules, module_identity)
            receiver := if command.receiver == {
                None -> None
                Val(name) -> Val(mir_type_id(name))
            }
            &commands.push(MIRCLICommand{
                name: command.name,
                description: command.description,
                function: jet_codegen_declaration_function_id(functions, reference.key, reference.module_identity),
                receiver: receiver,
                inputs: inputs,
            })
        }
    }
    return MIRCLIEntry{
        record_inputs: entry.record_inputs,
        description: entry.description,
        inputs: jet_codegen_lower_cli_inputs(entry.inputs, modules, module_identity),
        commands: commands,
        standard: entry.standard,
        version: entry.version,
    }
}

fn jet_codegen_lower_c_enum_tag(enum_tag: TCEnumTag) -> MIRCEnumTag Never! {
    return if enum_tag == {
        .CInt -> MIRCEnumTag.CInt
        .U8 -> MIRCEnumTag.U8
        .I8 -> MIRCEnumTag.I8
        .U16 -> MIRCEnumTag.U16
        .I16 -> MIRCEnumTag.I16
        .U32 -> MIRCEnumTag.U32
        .I32 -> MIRCEnumTag.I32
        .U64 -> MIRCEnumTag.U64
        .I64 -> MIRCEnumTag.I64
    }
}

fn jet_codegen_lower_compiler_builtin(value: TCompilerBuiltin) -> MIRCompilerBuiltin Never! {
    return if value == {
        .DefaultErr -> MIRCompilerBuiltin.DefaultErr
    }
}

fn jet_codegen_lower_type_definition(definition: TTypeDef, functions: JetCodegenFunctionIndex, modules: [SemaGraphModuleResult], closure_only: Bool) -> MIRTypeDef {
    generic_names := [String]{}
    loop param in definition.generic_params -> &generic_names.push(param.name)
    kind := if definition.kind == {
        .Struct(fields, methods) -> {
            lowered_fields := [MIRField]{}
            loop field in fields -> &lowered_fields.push(jet_codegen_lower_declaration_field(field, definition.key, modules, definition.module_identity, generic_names))
            MIRTypeDefKind.Struct{fields: lowered_fields, methods: jet_codegen_type_method_ids(definition, methods, functions, closure_only)}
        }
        .Enum(variants, methods) -> {
            lowered_variants := [MIRVariant]{}
            loop variant in variants {
                payload := if variant.payload == {
                    .Unit -> MIRVariantPayload.Unit
                    .Single(value) -> MIRVariantPayload.Single{value: jet_codegen_lower_type_with_modules(value, modules, definition.module_identity, generic_names)}
                    .Named(fields) -> {
                        owner_key := "{definition.key}::{variant.name}"
                        lowered_fields := [MIRField]{}
                        loop field in fields -> &lowered_fields.push(jet_codegen_lower_declaration_field(field, owner_key, modules, definition.module_identity, generic_names))
                        MIRVariantPayload.Named{fields: lowered_fields}
                    }
                }
                &lowered_variants.push(MIRVariant{
                    name: variant.name,
                    wire_name: variant.wire_name,
                    span: variant.span,
                    payload: payload,
                    discriminant: variant.discriminant,
                })
            }
            MIRTypeDefKind.Enum{variants: lowered_variants, methods: jet_codegen_type_method_ids(definition, methods, functions, closure_only)}
        }
        .Distinct(base, range) -> {
            lowered_range := if range == {
                None -> None
                Val(value) -> Val(MIRIntegerRange{lo: value.lo, hi: value.hi})
            }
            MIRTypeDefKind.Distinct{base: jet_codegen_lower_type_with_modules(base, modules, definition.module_identity, generic_names), range: lowered_range}
        }
        .Alias(target) -> MIRTypeDefKind.Alias{target: jet_codegen_lower_type_with_modules(target, modules, definition.module_identity, generic_names)}
        .UnitFamily(members) -> MIRTypeDefKind.UnitFamily{members: members}
    }
    layout := if definition.layout == {
        None -> None
        Val(value) -> Val(if value == {
            .C -> MIRStructLayout.C
            .CAligned(alignment, target) -> MIRStructLayout.CAligned{alignment: alignment, target: target}
            .Columnar -> MIRStructLayout.Columnar
        })
    }
    serde := [MIRSerdeAttribute]{}
    loop attribute in definition.serde {
        serde_kind := if attribute.kind == {
            .RenameAll -> MIRSerdeAttributeKind.RenameAll
            .Tag -> MIRSerdeAttributeKind.Tag
            .Untagged -> MIRSerdeAttributeKind.Untagged
            .DenyUnknownFields -> MIRSerdeAttributeKind.DenyUnknownFields
        }
        &serde.push(MIRSerdeAttribute{kind: serde_kind, value: attribute.value, span: attribute.span})
    }
    cli_bindings := [MIRCLIBinding]{}
    loop binding in definition.cli_bindings {
        &cli_bindings.push(MIRCLIBinding{
            name: binding.name,
            function: jet_codegen_declaration_function_id(functions, binding.function_key, definition.module_identity),
            span: binding.span,
            markers: binding.markers,
        })
    }
    cli := if definition.cli == {
        None -> None
        Val(entry) -> Val(jet_codegen_lower_cli_entry(entry, functions, modules, definition.module_identity))
    }
    alignment := if definition.layout_alignment == {
        None -> None
        Val(value) -> Val(MIRLayoutAlignmentFact{
            requested_alignment: value.requested_alignment,
            effective_alignment: value.effective_alignment,
            target_mode: value.target_mode,
            target_profile: value.target_profile,
            fact_identity: value.fact_identity,
        })
    }
    c_layout_tag := if definition.c_layout_tag == {
        None -> None
        Val(c_layout_tag_value) -> Val(jet_codegen_lower_c_enum_tag(c_layout_tag_value))
    }
    derives := [MIRTraitID]{}
    loop name in definition.derives -> &derives.push(jet_codegen_lower_type_derive_trait_id(name, modules, definition.module_identity))
    return MIRTypeDef{
        id: mir_type_id(definition.key),
        module_id: mir_module_id(definition.module_identity),
        key: definition.key,
        name: definition.name,
        span: definition.span,
        public: definition.public,
        package_public: definition.package_public,
        generic_params: jet_codegen_lower_declaration_generic_params(definition.generic_params, modules),
        derives: derives,
        auto_derive_default: definition.auto_derive_default,
        auto_printable: definition.auto_printable,
        published_schema: definition.published_schema,
        single_use: definition.single_use,
        must_use: definition.must_use,
        layout: layout,
        c_layout_tag: c_layout_tag,
        enum_layout: definition.enum_layout,
        layout_alignment: alignment,
        cli: cli,
        serde: serde,
        cli_bindings: cli_bindings,
        ownership: jet_codegen_lower_declaration_ownership_mode(definition.ownership),
        boxed_edges: definition.boxed_edges,
        compiler_builtin: definition.compiler_builtin.map(jet_codegen_lower_compiler_builtin),
        kind: kind,
    }
}


fn jet_codegen_lower_declaration_failure(failure: TFailureCarrier, modules: [SemaGraphModuleResult], module_identity: String) -> MIRFailureCarrier Never! {
    return if failure == {
        .Infallible -> MIRFailureCarrier.Infallible
        .Result(success, error) -> MIRFailureCarrier.Result{
            success: jet_codegen_lower_type_with_modules(success, modules, module_identity, [String]{}),
            error: jet_codegen_lower_type_with_modules(error, modules, module_identity, [String]{}),
        }
        .Optional(value) -> MIRFailureCarrier.Optional{value: jet_codegen_lower_type_with_modules(value, modules, module_identity, [String]{})}
        .Diverges(value) -> MIRFailureCarrier.Diverges{value: jet_codegen_lower_type_with_modules(value, modules, module_identity, [String]{})}
    }
}

fn jet_codegen_lower_declaration_param(parameter: TDeclarationParam, modules: [SemaGraphModuleResult], module_identity: String) -> MIRParam Never! {
    access := jet_codegen_lower_access(parameter.access)
    return MIRParam{
        index: parameter.index,
        name: parameter.name,
        span: parameter.span,
        ty: jet_codegen_lower_type_with_modules(parameter.ty, modules, module_identity, [String]{}),
        access: access,
        ownership: jet_codegen_lower_declaration_ownership(parameter.ownership),
        public_label: parameter.public_label,
        variadic: parameter.variadic,
        default_present: parameter.default_present,
    }
}

fn jet_codegen_lower_declaration_effects(declared: [TEffectSpan]?) -> MIREffectFacts Never! {
    direct := [String]{}
    direct_spans := [MIRNamedSpan]{}
    if declared != None {
        effects :: declared
        loop effect_span in effects {
            seen := false
            loop name in direct {
                if name == effect_span.name -> seen = true
            }
            if !seen -> &direct.push(effect_span.name)
            &direct_spans.push(MIRNamedSpan{name: effect_span.name, span: effect_span.span})
        }
    }
    direct = jet_codegen_sort_strings(direct)
    direct_spans = jet_codegen_sort_named_spans(direct_spans)
    return MIREffectFacts{direct: direct, solved: direct, call_edges: [String]{}, maximal: false, direct_spans: direct_spans}
}

fn jet_codegen_lower_trait_method(method: TTraitMethod, trait_key: String, module_identity: String, functions: JetCodegenFunctionIndex, modules: [SemaGraphModuleResult]) -> MIRTraitMethod Never! {
    params := [MIRParam]{}
    loop parameter in method.params -> &params.push(jet_codegen_lower_declaration_param(parameter, modules, module_identity))
    declared_return := if method.declared_return == {
        None -> None
        Val(value) -> Val(jet_codegen_lower_type_with_modules(value, modules, module_identity, [String]{}))
    }
    default_function := MIRFunctionID?{None}
    if method.default_function_key != None {
        key :: method.default_function_key ?? panic("checked trait default key disappeared during MIR lowering")
        function := jet_codegen_find_function_by_key(functions, key, module_identity)
        if function != None -> default_function = Val(jet_codegen_function_id(function ?? panic("checked trait default lookup lost its TFunc")))
    }
    self_access := if method.self_access == {
        None -> None
        Val(value) -> Val(jet_codegen_lower_access(value))
    }
    return MIRTraitMethod{
        id: MIRTraitMethodID{value: stable_id("mir-trait-method", "{trait_key}::{method.key}")},
        name: jet_codegen_impl_method_leaf(method.name),
        span: method.span,
        self_access: self_access,
        params: params,
        declared_return: declared_return,
        return_type: jet_codegen_lower_type_with_modules(method.return_type, modules, module_identity, [String]{}),
        failure: jet_codegen_lower_declaration_failure(method.failure, modules, module_identity),
        effects: jet_codegen_lower_declaration_effects(method.declared_effects),
        is_pure: method.is_pure,
        return_view_provenance: jet_codegen_lower_view_provenance_map(method.return_view_provenance),
        declared_return_view_provenance: None,
        default: default_function,
    }
}

fn jet_codegen_lower_trait_definition(definition: TTraitDef, functions: JetCodegenFunctionIndex, modules: [SemaGraphModuleResult]) -> MIRTraitDef Never! {
    associated_types := [MIRAssociatedTypeDecl]{}
    loop value in definition.associated_types -> &associated_types.push(MIRAssociatedTypeDecl{name: value.name, span: value.span})
    methods := [MIRTraitMethod]{}
    loop method in definition.methods -> &methods.push(jet_codegen_lower_trait_method(method, definition.key, definition.module_identity, functions, modules))
    key := jet_codegen_canonical_target_type(definition.module_identity, definition.key)
    return MIRTraitDef{
        id: mir_trait_id(key),
        module_id: mir_module_id(definition.module_identity),
        key: key,
        name: definition.name,
        span: definition.span,
        visibility: jet_codegen_lower_visibility(definition.visibility),
        associated_types: associated_types,
        methods: methods,
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::resolve_field_id
fn jet_codegen_field_id_index(types: [MIRTypeDef]) -> [String:MIRFieldID] {
    fields_by_name := [String:MIRFieldID]{}
    loop definition in types {
        if definition.kind == {
            .Struct(fields, _) -> loop field in fields {
                if fields_by_name.get(field.name) == None -> &fields_by_name.add(field.name, field.id).drop("first field name wins")
            }
            .Enum(variants, _) -> loop variant in variants {
                if variant.payload == {
                    .Named(fields) -> loop field in fields {
                        if fields_by_name.get(field.name) == None -> &fields_by_name.add(field.name, field.id).drop("first field name wins")
                    }
                    else -> {}
                }
            }
            else -> {}
        }
    }
    fields_by_name
}

fn jet_codegen_lower_target_os(target: TTargetOS?) -> MIROSTarget? {
    return if target == {
        None -> None
        Val(os) -> if os == {
            .Linux -> Val(MIROSTarget.Linux)
            .MacOS -> Val(MIROSTarget.MacOS)
            .Windows -> Val(MIROSTarget.Windows)
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::method_base_leaf: the
// method leaf of an impl method key, without an operator `<Rhs>` suffix.
fn jet_codegen_impl_method_leaf(key: String) -> String Never! {
    bytes :: key.bytes()
    end := bytes.len()
    if end > 0 && Int.from_u8(bytes[end - 1]) == 62 {
        depth := 0
        position := end - 1
        loop position >= 0 {
            byte :: Int.from_u8(bytes[position])
            if byte == 62 -> depth += 1
            if byte == 60 {
                depth -= 1
                if depth == 0 {
                    end = position
                    break
                }
            }
            position -= 1
        }
    }
    start := 0
    position := end - 2
    loop position >= 0 {
        if Int.from_u8(bytes[position]) == 58 && Int.from_u8(bytes[position + 1]) == 58 {
            start = position + 2
            break
        }
        position -= 1
    }
    String.from_bytes(bytes[start..<end].copy()) ?? ""
}

fn jet_codegen_impl_owner_name(ty: Type) -> String Never! {
    if ty == {
        .Named(name) | .Apply(name, _) -> name
        else -> type_name(ty)
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::impl_method_matches. Sema
// keys a checked method by its registration symbol, while an impl row names
// it `<module>::<Owner>::<Trait>::<method><Rhs>`, so the row's method is the
// same-module method with that leaf on the same owner. A trait-block method
// in a struct or enum body (derived ones included) is checked as an owner
// method; a trait method must name the row's trait.
fn jet_codegen_impl_method_matches(function: TFunc, definition: TImplDef, trait_ref: MIRTraitRef?, modules: [SemaGraphModuleResult], leaf: String) -> Bool Never! {
    if function.module_identity != definition.module_identity || function.name != leaf -> return false
    owner := Type?{None}
    if function.kind == {
        .Method(_, owner_type) -> owner = Val(owner_type)
        .TraitMethod(_, _, owner_type, trait_symbol, _) -> {
            expected :: trait_ref ?? return false
            if jet_codegen_mir_trait_ref_for_symbol(modules, trait_symbol).id != expected.id -> return false
            owner = Val(owner_type)
        }
        .TopLevel -> return false
    }
    actual :: owner ?? return false
    jet_codegen_canonical_target_type(definition.module_identity, jet_codegen_impl_owner_name(definition.self_type)) == jet_codegen_canonical_target_type(function.module_identity, jet_codegen_impl_owner_name(actual))
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::lower_impl_rows. Only a
// lowered function (`lowered_ids`) is an executable impl method.
fn jet_codegen_lower_impl_definition(definition: TImplDef, functions: JetCodegenFunctionIndex, modules: [SemaGraphModuleResult], trait_names: JetCodegenTraitNames, fields_by_name: [String:MIRFieldID], lowered_ids: [U64:Bool]) -> MIRImplDef? {
    trait_name := if definition.trait_ref == {
        Val(name) -> Val(name)
        None -> definition.trait_name
    }
    trait_ref := if trait_name == {
        None -> None
        Val(name) -> Val(jet_codegen_lower_declared_or_builtin_trait_ref(trait_names, name, definition.module_identity))
    }
    method_ids := [MIRFunctionID]{}
    seen_methods := [U64:Bool]{}
    loop key in definition.methods {
        candidates := [MIRFunctionID]{}
        function := jet_codegen_find_function_by_key(functions, key, definition.module_identity)
        if function == .Val(found) -> &candidates.push(jet_codegen_function_id(found))
        leaf :: jet_codegen_impl_method_leaf(key)
        row := functions.first_by_name.get(leaf) ?? -1
        loop row >= 0 {
            if jet_codegen_impl_method_matches(functions.rows[row], definition, trait_ref, modules, leaf) -> &candidates.push(jet_codegen_function_id(functions.rows[row]))
            row = functions.next_by_name[row]
        }
        loop id in candidates {
            if lowered_ids.get(id.value) == None || seen_methods.get(id.value) != None -> next
            _ := &seen_methods.add(id.value, true)
            &method_ids.push(id)
        }
    }
    if definition.methods.len() > 0 && method_ids.len() == 0 -> return None
    associated_types := [MIRAssociatedTypeValue]{}
    loop value in definition.associated_types {
        &associated_types.push(MIRAssociatedTypeValue{
            name: value.name,
            ty: jet_codegen_lower_type_with_modules(value.ty, modules, definition.module_identity, [String]{}),
            span: value.span,
        })
    }
    delegation := if definition.delegation_field == {
        None -> None
        Val(name) -> fields_by_name.get(name)
    }
    serde := if definition.serde == {
        None -> None
        Val(codec) -> if codec == {
            .Encode -> Val(MIRSerdeCodec.Encode)
            .Decode -> Val(MIRSerdeCodec.Decode)
        }
    }
    operator_marker := if definition.operator_marker == {
        None -> None
        Val(marker) -> if marker == {
            .Commutative -> Val(MIROperatorMarker.Commutative)
        }
    }
    operator_rhs := if definition.operator_rhs == {
        None -> None
        Val(ty) -> Val(jet_codegen_lower_type_with_modules(ty, modules, definition.module_identity, [String]{}))
    }
    return MIRImplDef{
        id: MIRImplID{value: stable_id("mir-impl", definition.key)},
        module_id: mir_module_id(definition.module_identity),
        key: definition.key,
        span: definition.span,
        self_type: jet_codegen_lower_type_with_modules(definition.self_type, modules, definition.module_identity, [String]{}),
        trait_ref: trait_ref,
        associated_types: associated_types,
        methods: method_ids,
        delegation: delegation,
        compiler_generated: definition.compiler_generated,
        serde: serde,
        operator_marker: operator_marker,
        operator_rhs: operator_rhs,
        target_os: jet_codegen_lower_target_os(definition.target_os),
        target_applicability: MIRTargetApplicability{rust_aot: true, interpreter: true, web: true},
    }
}

fn jet_codegen_constant_is_output_type(ty: Type, modules: [SemaGraphModuleResult], module_identity: String) -> Bool Never! {
    return if ty == {
        .Named(name) -> {
            if name == "Output" || name == "OutputDefaults" -> return true
            nominal := jet_codegen_find_nominal_identity(modules, module_identity, name, [String]{})
            if nominal == .Val(value) -> return value.name == "Output" || value.name == "OutputDefaults"
            false
        }
        else -> false
    }
}

struct JetCodegenConstantIndex {
    rows: [String:JetCodegenConstantRow]
    forced_static: [String:Bool]
    forced_inline: [String:Bool]
}

struct JetCodegenConstantRow {
    module_index: Int
    definition_index: Int
}

// A checked read names a module constant by its symbol (`ConstRef`), whose
// key is `symbol_id(Constant, module, "", name)`; the declaration row's own
// `key` is the MIR global name (`module::name`). Rows are found by the symbol.
fn jet_codegen_constant_symbol_key(definition: TConstantDef) -> String Never! {
    symbol_id(SymbolKind.Constant, definition.module_identity, "", definition.name).key
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::inline_known_constant_reads
fn jet_codegen_constant_index(modules: [SemaGraphModuleResult]) -> JetCodegenConstantIndex Never! {
    rows := [String:JetCodegenConstantRow]{}
    forced_static := [String:Bool]{}
    forced_inline := [String:Bool]{}
    loop module_row in 0..<modules.len() {
        loop definition_row in 0..<modules[module_row].declarations.constants.len() {
            key :: jet_codegen_constant_symbol_key(modules[module_row].declarations.constants[definition_row])
            if rows.get(key) == None -> _ := &rows.add(key, JetCodegenConstantRow{module_index: module_row, definition_index: definition_row})
        }
        loop constant in modules[module_row].constants {
            key := jet_codegen_qualified_function_key(modules[module_row].module_identity, constant.symbol.id.key)
            loop attr in constant.declaration.attrs {
                if attr == ConstAttr.ForceStatic -> _ := &forced_static.add(key, true)
                if attr == ConstAttr.ForceInline -> _ := &forced_inline.add(key, true)
            }
        }
    }
    JetCodegenConstantIndex{rows: rows, forced_static: forced_static, forced_inline: forced_inline}
}

// Card #4258 (D-CONSTMARK1): a read of an immutable module constant copies
// its folded value into the use site when the value is a scalar, short text,
// or a small record or enum case of those, so the optimizer folds it and no
// backend calls an accessor. `#Static` keeps the one addressable item and
// `#Inline` copies any value; tables stay one shared item, cached when large.
// The Rust bootstrap mirrors this in `inline_known_constant_reads`.
// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::inline_known_constant_reads
fn jet_codegen_constant_copies_into_uses(definition: TConstantDef, modules: [SemaGraphModuleResult], forced_static: Bool, forced_inline: Bool) -> Bool Never! {
    if jet_codegen_constant_is_output_type(definition.ty, modules, definition.module_identity) -> return true
    if definition.is_storage -> return false
    if forced_static -> return false
    if forced_inline -> return true
    if definition.value == .Closure(_) -> return definition.is_comptime
    leaves :: jet_codegen_constant_use_site_leaves(definition.value)
    leaves >= 0 && leaves <= 8
}

// The scalar leaves of a value that may be copied into a use site: scalars and
// text of at most 256 bytes, through records, enum cases, and present
// optionals. Any other value (tables, bytes, failures) is -1.
fn jet_codegen_constant_use_site_leaves(value: TComptimeValue) -> Int Never! {
    return if value == {
        .Int(_) | .Float(_, _) | .Bool(_) | .Char(_) | .BigInt(_) | .Unit -> 1
        .String(text) -> if text.bytes().len() <= 256 -> 1 else -> -1
        .Struct(_, fields) -> {
            total := 0
            loop field in fields {
                leaves :: jet_codegen_constant_use_site_leaves(field.value)
                if leaves < 0 -> return -1
                total += leaves
            }
            total
        }
        .Enum(_, _, args) -> {
            total := 0
            loop argument in args {
                leaves :: jet_codegen_constant_use_site_leaves(argument.value)
                if leaves < 0 -> return -1
                total += leaves
            }
            total
        }
        .Present(inner) -> jet_codegen_constant_use_site_leaves(inner)
        else -> -1
    }
}

// Every module constant a body may read through a `Global` keeps its row
// (Rust `lower_constant_rows`): runtime constants, storage, and prepared
// constants whose value is folded, also when every read was copied into its
// use site; the emitter writes an accessor only for rows still read through
// `Global`. A prepared `Unit` and an `Output`/`OutputDefaults` value have none.
fn jet_codegen_lower_constant_definition(definition: TConstantDef, modules: [SemaGraphModuleResult]) -> MIRConstantDef? {
    if jet_codegen_constant_is_output_type(definition.ty, modules, definition.module_identity) -> return None
    if definition.is_comptime && definition.value == .Unit -> return None
    lowered := jet_codegen_lower_byte_list_constant(definition.ty, definition.value)
    if lowered == None -> lowered = jet_codegen_lower_comptime_value(definition.value, modules, definition.module_identity, [String]{})
    value :: lowered ?? return None
    return MIRConstantDef{
        id: MIRConstantID{value: stable_id("mir-constant", definition.key)},
        module_id: mir_module_id(definition.module_identity),
        key: definition.key,
        name: definition.name,
        span: definition.span,
        visibility: jet_codegen_lower_visibility(definition.visibility),
        ty: jet_codegen_lower_type_with_modules(definition.ty, modules, definition.module_identity, [String]{}),
        is_storage: definition.is_storage,
        value: value,
    }
}

// Rust mir.rs `lower_byte_list_constant`: a `[U8]` constant whose folded value
// is a list of integer bytes (generated Unicode tables) is one Bytes constant.
fn jet_codegen_lower_byte_list_constant(ty: Type, value: TComptimeValue) -> MIRConstant? Never! {
    is_byte_list :: if jet_codegen_unwrap_pattern_tags(ty) == {
        .List(element) -> element == Type.IntN{signed: false, bits: 8}
        else -> false
    }
    if !is_byte_list -> return None
    if value == {
        .List(elements) -> {
            bytes := [U8]{}
            loop element in elements {
                if element == {
                    .Int(literal) -> {
                        byte :: U8.from_int(literal) ?? return None
                        &bytes.push(byte)
                    }
                    else -> return None
                }
            }
            return Val(MIRConstant.Bytes{value: bytes})
        }
        else -> {}
    }
    None
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::inline_known_constant_reads
fn jet_codegen_lower_constant_reference(builder: &JetCodegenBuilder, program: JetCodegenProgram, expression: TExpr, symbol: SymbolID) -> MIRValueID {
    if jet_codegen_find_function_row(program.function_index, symbol.key) != None {
        return jet_codegen_lower_named_function_value(&builder, program, expression, symbol.key, false)
    }
    row :: program.owners.constants.rows.get(symbol.key) ?? panic("checked constant reference has no declaration or function target")
    // Copied out of the builder, which the emits below write through.
    definition :: program.modules[row.module_index].declarations.constants[row.definition_index].copy()
    copies := builder.constant_copies.get(symbol.key)
    if copies == None {
        qualified := jet_codegen_qualified_function_key(definition.module_identity, symbol.key)
        decision := jet_codegen_constant_copies_into_uses(definition, program.modules, program.owners.constants.forced_static.get(qualified) != None, program.owners.constants.forced_inline.get(qualified) != None)
        _ := &builder.constant_copies.add(symbol.key, decision)
        copies = Val(decision)
    }
    if !(copies ?? false) -> return jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Global{name: definition.key})
    constant := jet_codegen_lower_comptime_value(definition.value, program.modules, definition.module_identity, builder.generic_type_names) ?? {
        if definition.is_comptime -> panic("checked compile-time constant reference has no MIR value")
        return jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Global{name: definition.key})
    }
    // A sized-integer read keeps its width, as a literal does.
    if constant == {
        .Int(number, width, spelling) -> {
            if width == None -> constant = mir_integer_constant(number, jet_codegen_pattern_integer_width(expression.ty), spelling)
        }
        else -> {}
    }
    return jet_codegen_emit_value(&builder, program, expression.span, expression.ty, MIROperation.Constant{value: constant})
}

fn jet_codegen_tuple_shape_names(name: String) -> MIRShapeFieldNames Never! {
    argument_bytes := [U8]{}
    environment_bytes := [U8]{}
    loop byte in name.bytes() {
        code := Int.from_u8(byte)
        if code == 95 -> &argument_bytes.push(U8{45}) else -> &argument_bytes.push(byte)
        if {
            code == 45 -> &environment_bytes.push(U8{95})
            code >= 97 && code <= 122 -> &environment_bytes.push(U8{code - 32})
            else -> &environment_bytes.push(byte)
        }
    }
    return MIRShapeFieldNames{
        text: name,
        json: None,
        cbor: None,
        csv: None,
        toml: None,
        yaml: None,
        xml: None,
        args: String.from_bytes(argument_bytes) ?? name,
        env: String.from_bytes(environment_bytes) ?? name,
        db: None,
        layout: None,
    }
}

// `seen` holds the field-ID values already emitted, program-wide.
fn jet_codegen_append_tuple_field_rows(ty: MIRType, rows: &[MIRFieldRow], seen: &[U64:Bool]) Never! {
    _ := if ty.kind == {
        .Tuple(fields) -> {
            if {
                ty.identity != None -> {
                    owner :: ty.identity ?? panic("tuple MIR type has no identity")
                    loop field in fields {
                        id := mir_field_id("{mir_type_identity_key(ty)}::{field.name}")
                        if seen.get(id.value) == None {
                            &rows.push(MIRFieldRow{
                                id: id,
                                owner: owner,
                                field: MIRField{
                                    id: id,
                                    name: field.name,
                                    shape_names: jet_codegen_tuple_shape_names(field.name),
                                    skip: false,
                                    ty: field.ty,
                                    span: Span{start: 0, end: 0},
                                    public: true,
                                    package_public: true,
                                    computed: false,
                                    has_default: false,
                                    redact: false,
                                },
                            })
                            seen[id.value] = true
                        }
                        jet_codegen_append_tuple_field_rows(field.ty, &rows, &seen)
                    }
                } else -> {
                    loop field in fields -> jet_codegen_append_tuple_field_rows(field.ty, &rows, &seen)
                }
            }
            ()
        }
        .List(inner) -> {
            jet_codegen_append_tuple_field_rows(inner, &rows, &seen)
            ()
        }
        .Shared(inner) -> {
            jet_codegen_append_tuple_field_rows(inner, &rows, &seen)
            ()
        }
        .Option(inner) -> {
            jet_codegen_append_tuple_field_rows(inner, &rows, &seen)
            ()
        }
        .FixedList(inner, _) -> {
            jet_codegen_append_tuple_field_rows(inner, &rows, &seen)
            ()
        }
        .InlineRange(inner, _, _) -> {
            jet_codegen_append_tuple_field_rows(inner, &rows, &seen)
            ()
        }
        .Tagged(_, inner) -> {
            jet_codegen_append_tuple_field_rows(inner, &rows, &seen)
            ()
        }
        .Quantity(inner, _) -> {
            jet_codegen_append_tuple_field_rows(inner, &rows, &seen)
            ()
        }
        .Map(key, value) -> {
            jet_codegen_append_tuple_field_rows(key, &rows, &seen)
            jet_codegen_append_tuple_field_rows(value, &rows, &seen)
            ()
        }
        .Result(ok, error) -> {
            jet_codegen_append_tuple_field_rows(ok, &rows, &seen)
            jet_codegen_append_tuple_field_rows(error, &rows, &seen)
            ()
        }
        .Fn(signature) -> {
            loop param in signature.params -> jet_codegen_append_tuple_field_rows(param, &rows, &seen)
            if signature.ret != None {
                ret :: signature.ret ?? panic("function MIR signature lost its return type")
                jet_codegen_append_tuple_field_rows(ret, &rows, &seen)
            }
            ()
        }
        .SendFn(params, ret, _) -> {
            loop param in params -> jet_codegen_append_tuple_field_rows(param, &rows, &seen)
            if ret != None {
                return_type :: ret
                jet_codegen_append_tuple_field_rows(return_type, &rows, &seen)
            }
            ()
        }
        .Apply(_, args) -> {
            loop argument in args -> jet_codegen_append_tuple_field_rows(argument, &rows, &seen)
            ()
        }
        .Union(args) -> {
            loop argument in args -> jet_codegen_append_tuple_field_rows(argument, &rows, &seen)
            ()
        }
        else -> ()
    }
}

fn jet_codegen_append_type_definition_fields(definition: MIRTypeDef, rows: &[MIRFieldRow], seen: &[U64:Bool]) Never! {
    _ := if definition.kind == {
        .Struct(fields, _) -> {
            loop field in fields {
                if seen.get(field.id.value) == None {
                    &rows.push(MIRFieldRow{id: field.id, owner: definition.id, field: field})
                    seen[field.id.value] = true
                }
                jet_codegen_append_tuple_field_rows(field.ty, &rows, &seen)
            }
            ()
        }
        .Enum(variants, _) -> {
            loop variant in variants {
                _ := if variant.payload == {
                    .Single(value) -> {
                        jet_codegen_append_tuple_field_rows(value, &rows, &seen)
                        ()
                    }
                    .Named(fields) -> {
                        loop field in fields {
                            if seen.get(field.id.value) == None {
                                &rows.push(MIRFieldRow{id: field.id, owner: definition.id, field: field})
                                seen[field.id.value] = true
                            }
                            jet_codegen_append_tuple_field_rows(field.ty, &rows, &seen)
                        }
                        ()
                    }
                    .Unit -> ()
                }
            }
            ()
        }
        .Distinct(base, _) -> {
            jet_codegen_append_tuple_field_rows(base, &rows, &seen)
            ()
        }
        .Alias(target) -> {
            jet_codegen_append_tuple_field_rows(target, &rows, &seen)
            ()
        }
        .UnitFamily(_) -> ()
    }
}

fn jet_codegen_append_failure_tuple_rows(failure: MIRFailureCarrier, rows: &[MIRFieldRow], seen: &[U64:Bool]) Never! {
    _ := if failure == {
        .Infallible -> ()
        .Result(success, error) -> {
            jet_codegen_append_tuple_field_rows(success, &rows, &seen)
            jet_codegen_append_tuple_field_rows(error, &rows, &seen)
            ()
        }
        .Optional(value) -> {
            jet_codegen_append_tuple_field_rows(value, &rows, &seen)
            ()
        }
        .Diverges(value) -> {
            jet_codegen_append_tuple_field_rows(value, &rows, &seen)
            ()
        }
    }
}

fn jet_codegen_lower_field_rows(types: [MIRTypeDef], functions: [MIRFunction], nested_functions: [MIRFunction], traits: [MIRTraitDef], impls: [MIRImplDef], constants: [MIRConstantDef]) -> [MIRFieldRow] Never! {
    rows := [MIRFieldRow]{}
    seen := [U64:Bool]{}
    loop definition in types {
        jet_codegen_append_type_definition_fields(definition, &rows, &seen)
        if definition.cli != None {
            entry :: definition.cli ?? panic("MIR CLI entry disappeared while collecting field rows")
            loop input in entry.inputs -> jet_codegen_append_tuple_field_rows(input.ty, &rows, &seen)
            loop command in entry.commands {
                loop input in command.inputs -> jet_codegen_append_tuple_field_rows(input.ty, &rows, &seen)
            }
        }
    }
    loop function in functions -> jet_codegen_append_function_field_rows(function, &rows, &seen)
    loop function in nested_functions -> jet_codegen_append_function_field_rows(function, &rows, &seen)
    loop definition in traits {
        loop method in definition.methods {
            loop parameter in method.params -> jet_codegen_append_tuple_field_rows(parameter.ty, &rows, &seen)
            jet_codegen_append_tuple_field_rows(method.return_type, &rows, &seen)
            if method.declared_return != None {
                ty :: method.declared_return ?? panic("MIR trait method return type disappeared while collecting field rows")
                jet_codegen_append_tuple_field_rows(ty, &rows, &seen)
            }
            jet_codegen_append_failure_tuple_rows(method.failure, &rows, &seen)
        }
    }
    loop implementation in impls {
        jet_codegen_append_tuple_field_rows(implementation.self_type, &rows, &seen)
        loop associated in implementation.associated_types -> jet_codegen_append_tuple_field_rows(associated.ty, &rows, &seen)

        if implementation.operator_rhs != None {
            ty :: implementation.operator_rhs ?? panic("MIR impl operator type disappeared while collecting field rows")
            jet_codegen_append_tuple_field_rows(ty, &rows, &seen)
        }
    }
    loop constant in constants -> jet_codegen_append_tuple_field_rows(constant.ty, &rows, &seen)
    return rows
}

fn jet_codegen_append_function_field_rows(function: MIRFunction, rows: &[MIRFieldRow], seen: &[U64:Bool]) Never! {
    jet_codegen_append_tuple_field_rows(function.return_type, &rows, &seen)
    jet_codegen_append_failure_tuple_rows(function.failure, &rows, &seen)
    if function.declared_return != None {
        ty :: function.declared_return ?? panic("MIR function return type disappeared while collecting field rows")
        jet_codegen_append_tuple_field_rows(ty, &rows, &seen)
    }
    loop parameter in function.params -> jet_codegen_append_tuple_field_rows(parameter.ty, &rows, &seen)
    loop parameter in function.capture_params -> jet_codegen_append_tuple_field_rows(parameter.ty, &rows, &seen)
    loop local in function.locals -> jet_codegen_append_tuple_field_rows(local.ty, &rows, &seen)
    loop value in function.values -> jet_codegen_append_tuple_field_rows(value.ty, &rows, &seen)
    loop place in function.places -> jet_codegen_append_tuple_field_rows(place.ty, &rows, &seen)
}
fn jet_codegen_core_effect_name(effect_value: Effect?) -> String? {
    return if effect_value == {
        None -> None
        Val(effect_kind) -> if effect_kind == {
            .Net -> Val("Net")
            .FS -> Val("FS")
            .IO -> Val("IO")
            .DB -> Val("DB")
            .Time -> Val("Time")
            .Rand -> Val("Rand")
            .Env -> Val("Env")
            .Exec -> Val("Exec")
            .Log -> Val("Log")
            .GPU -> Val("GPU")
            .Panic -> Val("Panic")
            .FFI -> Val("FFI")
            .Browser -> Val("Browser")
            .Secret -> Val("Secret")
            .Mem -> Val("Mem")
        }
    }
}

fn jet_codegen_core_call_fallibility(carrier: TFailureCarrier, builder: JetCodegenBuilder, program: JetCodegenProgram) -> MIRCallFallibility Never! {
    if carrier == {
        .Infallible -> MIRCallFallibility.Infallible
        else -> MIRCallFallibility.Failure{failure: jet_codegen_lower_failure(carrier, builder, program)}
    }
}

fn jet_codegen_core_route_fallibility_identity(carrier: TFailureCarrier) -> String Never! {
    if carrier == {
        .Infallible -> "Infallible"
        .Result(success, error) -> "Failure(Result({type_identity_key(success)},{type_identity_key(error)}))"
        .Optional(value) -> "Failure(Optional({type_identity_key(value)}))"
        .Diverges(value) -> "Failure(Diverges({type_identity_key(value)}))"
    }
}

fn jet_codegen_intern_core_route(builder: &JetCodegenBuilder, program: JetCodegenProgram, record: CoreCallRecord, carrier: TFailureCarrier) -> MIRPreludeCallID Never! {
    symbol := if record.symbol == {
        .Prelude(name) -> MIRSymbol.Prelude{name: name}
        .Rust(name) -> MIRSymbol.Runtime{name: name}
        .SourceOwned -> panic("source-owned Core declaration reached a host route")
    }
    module_name := record.module_name
    if module_name == "" -> module_name = "receiver({record.receiver_types.join("|")})"
    mask_names := [String]{}
    loop borrowed in record.signature.borrow_mask {
        if borrowed -> &mask_names.push("true") else -> &mask_names.push("false")
    }
    effect_identity := "None"
    if record.effect_kind != None {
        effect_kind :: record.effect_kind ?? panic("checked Core-call effect disappeared during MIR lowering")
        effect_name :: jet_codegen_core_effect_name(Val(effect_kind)) ?? panic("Core-call effect lost its name")
        effect_identity = "Some({effect_name})"
    }
    identity := "StaticPrelude:{module_name}:{record.member}:{core_call_symbol_name(record.symbol)}:{record.signature.arity}:{record.signature.max_arity}:[{mask_names.join(", ")}]:{effect_identity}:{jet_codegen_core_route_fallibility_identity(carrier)}:Value"
    id := MIRPreludeCallID{value: stable_id("mir-prelude-call", identity)}
    row := MIRPreludeCall{
        id: id,
        family: MIRPreludeFamily.StaticPrelude,
        module_name: module_name,
        member: record.member,
        symbol: symbol,
        signature: MIRCallSignature{arity: record.signature.arity, max_arity: record.signature.max_arity, borrow_mask: record.signature.borrow_mask},
        effect_kind: record.effect_kind,
        fallibility: jet_codegen_core_call_fallibility(carrier, builder, program),
        abi: MIRPreludeABI.Value,
        authority: record.authority,
        db_metadata: None,
    }
    return jet_codegen_intern_prelude_call(&builder, program, row)
}

fn jet_codegen_core_call_row(record: CoreCallRecord) -> MIRCoreCall Never! {
    key := core_call_key(record)
    return MIRCoreCall{
        id: MIRCoreCallID{value: stable_id("core-call", key)},
        key: key,
        module_name: record.module_name,
        member: record.member,
        receiver_types: record.receiver_types,
        arity: record.signature.arity,
        max_arity: record.signature.max_arity,
        borrow_mask: record.signature.borrow_mask,
        fallibility: record.fallibility,
        effect_kind: record.effect_kind,
        effect_leaf: record.effect_leaf,
        sink_class: record.sink_class,
        pure_route: record.pure_route,
        interpreter_route: record.interpreter_route,
        symbol: record.symbol,
        coverage_bits: record.coverage.bits,
        aot_direct: record.aot_direct,
        native_int_result: record.native_int_result,
        marker: record.marker,
    }
}

fn jet_codegen_string_rows_equal(left: [String], right: [String]) -> Bool Never! {
    if left.len() != right.len() -> return false
    index := 0
    loop index < left.len() {
        if left[index] != right[index] -> return false
        index += 1
    }
    true
}

fn jet_codegen_bool_rows_equal(left: [Bool], right: [Bool]) -> Bool Never! {
    if left.len() != right.len() -> return false
    index := 0
    loop index < left.len() {
        if left[index] != right[index] -> return false
        index += 1
    }
    true
}

fn jet_codegen_core_markers_equal(left: CoreMarkerApplication?, right: CoreMarkerApplication?) -> Bool Never! {
    if left == {
        None -> right == None
        Val(first) -> {
            if right == {
                None -> false
                Val(second) -> first.member == second.member && first.since == second.since && first.replacement == second.replacement && first.removed_in == second.removed_in
            }
        }
    }
}

fn jet_codegen_core_access_rows_equal(left: [CoreCallResourceAccess], right: [CoreCallResourceAccess]) -> Bool Never! {
    if left.len() != right.len() -> return false
    index := 0
    loop index < left.len() {
        if left[index].argument != right[index].argument || left[index].mode != right[index].mode -> return false
        index += 1
    }
    true
}

fn jet_codegen_core_completion_equal(left: CoreCallCompletion?, right: CoreCallCompletion?) -> Bool Never! {
    if left == {
        None -> right == None
        Val(first) -> {
            if right == {
                None -> false
                Val(second) -> first.kind == second.kind && first.token == second.token && first.provider == second.provider
            }
        }
    }
}

fn jet_codegen_core_capability_equal(left: CoreCapabilityContract, right: CoreCapabilityContract) -> Bool Never! {
    left.kind == right.kind && left.provider == right.provider && left.fallback == right.fallback && left.failure == right.failure
}
fn jet_codegen_authority_decisions_equal(left: MIRAuthorityDecision?, right: MIRAuthorityDecision?) -> Bool Never! {
    if left == None -> return right == None
    if right == None -> return false
    first :: left
    second :: right
    first.import.id == second.import.id
        && first.import.operation == second.import.operation
        && first.import.required_right == second.import.required_right
        && jet_codegen_string_rows_equal(first.import.parameter_type_ids, second.import.parameter_type_ids)
        && first.import.result_type_id == second.import.result_type_id
        && first.authority_argument == second.authority_argument
        && first.inherited == second.inherited
}


fn jet_codegen_core_records_match(left: CoreCallRecord, right: CoreCallRecord) -> Bool Never! {
    if left.module_name != right.module_name || left.member != right.member || !jet_codegen_string_rows_equal(left.receiver_types, right.receiver_types) -> return false
    if left.signature.arity != right.signature.arity || left.signature.max_arity != right.signature.max_arity || !jet_codegen_bool_rows_equal(left.signature.borrow_mask, right.signature.borrow_mask) -> return false
    if left.fallibility != right.fallibility || left.effect_kind != right.effect_kind || left.effect_leaf != right.effect_leaf || left.sink_class != right.sink_class -> return false
    if left.pure_route != right.pure_route || left.interpreter_route != right.interpreter_route || left.symbol != right.symbol -> return false
    if left.coverage.bits != right.coverage.bits || left.aot_direct != right.aot_direct || left.native_int_result != right.native_int_result -> return false
    if !jet_codegen_core_access_rows_equal(left.frame_accesses, right.frame_accesses) || !jet_codegen_core_completion_equal(left.frame_completion, right.frame_completion) || !jet_codegen_core_capability_equal(left.capability, right.capability) || !jet_codegen_string_rows_equal(left.ui_capabilities, right.ui_capabilities) -> return false
    jet_codegen_authority_decisions_equal(left.authority, right.authority) && jet_codegen_core_markers_equal(left.marker, right.marker)
}

fn jet_codegen_canonical_core_record(record: CoreCallRecord) -> CoreCallRecord Never! {
    jet_codegen_canonical_core_record_in(CORE_CALLS, record)
}

// The registry is a read parameter, so the scan reads its rows in place.
fn jet_codegen_canonical_core_record_in(rows: [CoreCallRecord], record: CoreCallRecord) -> CoreCallRecord Never! {
    key := core_call_key(record)
    found := CoreCallRecord?{None}
    loop candidate in rows {
        if core_call_key(candidate) == key {
            if found != None -> panic("duplicate canonical Core-call key")
            found = Val(candidate)
        }
    }
    canonical :: found ?? panic("checked Core-call record is absent from the canonical registry")
    if !jet_codegen_core_records_match(canonical, record) -> panic("checked Core-call metadata disagrees with the canonical registry")
    canonical
}

fn jet_codegen_note_core_module(builder: &JetCodegenBuilder, program: JetCodegenProgram, module_name: String) Never! {
    if module_name != "core" && !module_name.starts_with("core.") -> return
    loop existing in builder.used_core {
        if existing == module_name -> return
    }
    &builder.used_core.push(module_name)
}

fn jet_codegen_intern_core_call(builder: &JetCodegenBuilder, program: JetCodegenProgram, record: CoreCallRecord) -> MIRCoreCallID Never! {
    if record.symbol == CoreCallSymbol.SourceOwned -> panic("source-owned Core declaration reached executable MIR")
    row := jet_codegen_core_call_row(record)
    loop existing in builder.core_calls {
        if existing.id == row.id {
            if existing.key != row.key -> panic("Core-call stable identity collision during MIR lowering")
            return existing.id
        }
    }
    &builder.core_calls.push(row)
    if record.module_name != "" -> jet_codegen_note_core_module(&builder, program, record.module_name)
    row.id
}

fn jet_codegen_lower_visibility(visibility: TVisibility) -> MIRVisibility Never! {
    if visibility == {
        .Private -> MIRVisibility.Private
        .Package -> MIRVisibility.Package
        .Public -> MIRVisibility.Public
    }
}

fn jet_codegen_lower_web_bucket(bucket: WebBucket?) -> MIRWebBucket? {
    return if bucket == {
        None -> None
        Val(web_bucket) -> if web_bucket == {
            .JS -> Val(MIRWebBucket.JS)
            .Wasm -> Val(MIRWebBucket.Wasm)
        }
    }
}

fn jet_codegen_lower_web_marker(marker: WebPartitionMarker?) -> MIRWebPartitionMarker? {
    return if marker == {
        None -> None
        Val(partition_marker) -> if partition_marker == {
            .JS -> Val(MIRWebPartitionMarker.JS)
            .Wasm -> Val(MIRWebPartitionMarker.Wasm)
            .WasmExport -> Val(MIRWebPartitionMarker.WasmExport)
        }
    }
}

fn jet_codegen_lower_failure(failure: TFailureCarrier, builder: JetCodegenBuilder, program: JetCodegenProgram) -> MIRFailureCarrier Never! {
    if failure == {
        .Infallible -> MIRFailureCarrier.Infallible
        .Result(success, error) -> MIRFailureCarrier.Result{success: jet_codegen_lower_type_for_function(success, builder, program), error: jet_codegen_lower_type_for_function(error, builder, program)}
        .Optional(value) -> MIRFailureCarrier.Optional{value: jet_codegen_lower_type_for_function(value, builder, program)}
        .Diverges(value) -> MIRFailureCarrier.Diverges{value: jet_codegen_lower_type_for_function(value, builder, program)}
    }
}

fn jet_codegen_lower_parameter(builder: &JetCodegenBuilder, program: JetCodegenProgram, parameter: TParameter, index: Int) Never! {
    access := jet_codegen_lower_access(parameter.convention)
    lowered_ty :: jet_codegen_lower_type_for_function(parameter.ty, builder, program)
    value := jet_codegen_emit_mir_type(&builder, program, parameter.span, lowered_ty, mir_ownership_from_access(access), MIROperation.Parameter{index: index, name: parameter.name})
    _ := jet_codegen_bind_local(&builder, program, parameter.local, parameter.ty, parameter.local.mutable, Val(value), Val(access), false)
    &builder.params.push(MIRParam{
        index: index,
        name: parameter.name,
        span: parameter.span,
        ty: lowered_ty,
        access: access,
        ownership: mir_ownership_from_access(access),
        public_label: parameter.public_label,
        variadic: parameter.variadic,
        default_present: parameter.default != None,
    })
}

fn jet_codegen_lower_generic_params(params: [TGenericParam], modules: [SemaGraphModuleResult]) -> [MIRGenericParam] Never! {
    lowered := [MIRGenericParam]{}
    loop param in params {
        bounds := [MIRTraitRef]{}
        loop bound in param.bounds -> &bounds.push(jet_codegen_mir_trait_ref_for_symbol(modules, bound))
        &lowered.push(MIRGenericParam{name: param.name, bounds: bounds})
    }
    lowered
}

fn jet_codegen_lower_kernel_proof(proof: KernelProof?) -> MIRKernelFacts? {
    if proof == {
        None -> None
        Val(value) -> {
            if value.mode != KernelMode.Parallel -> panic("checked kernel proof uses an unsupported MIR kernel mode")
            Val(MIRKernelFacts{
                bounds: value.bounds,
                alias_free: value.alias_free,
                captures: value.captures,
                race_free: value.race_free,
                barriers_uniform: value.barriers_uniform,
                control_flow: value.control_flow,
            })
        }
    }
}

fn jet_codegen_lower_web_reconstructions(builder: JetCodegenBuilder, program: JetCodegenProgram, rows: [TWebParamReconstruction]) -> [MIRWebParamReconstruction] Never! {
    lowered := [MIRWebParamReconstruction]{}
    loop row in rows {
        fields := [MIRWebParamField]{}
        loop field in row.fields -> &fields.push(MIRWebParamField{field: field.field, parameter: field.parameter, ty: jet_codegen_lower_type_for_function(field.ty, builder, program)})
        &lowered.push(MIRWebParamReconstruction{local: row.local.name, ty: jet_codegen_lower_type_for_function(row.ty, builder, program), fields: fields})
    }
    lowered
}


// Sort scalar index keys, then move whole rows through empty slots into their
// canonical positions. The original receiver allocation is retained.
fn jet_codegen_sort_blocks(blocks: &[MIRBasicBlock]) Never! {
    keys := [U64]{}
    loop index in 0..<blocks.len() -> &keys.push(blocks[index].id.value)
    compiler_apply_order<MIRBasicBlock>(&blocks, jet_codegen_sorted_order(keys, [String]{}))
}
fn jet_codegen_lower_receiver(builder: &JetCodegenBuilder, program: JetCodegenProgram, owner_type: Type, convention: AccessConvention?, span: Span, index: Int) Never! {
    access := if convention == {
        None -> MIRAccess.Read
        Val(value) -> jet_codegen_lower_access(value)
    }
    lowered_ty :: jet_codegen_lower_type_for_function(owner_type, builder, program)
    value := jet_codegen_emit_mir_type(&builder, program, span, lowered_ty, mir_ownership_from_access(access), MIROperation.Parameter{index: index, name: "self"})
    local := TLocal{
        name: "self",
        symbol_id: Val(symbol_id(SymbolKind.Parameter, builder.function.module_identity, builder.function.key, "self")),
        span: span,
        generated: false,
        deref: false,
        address_lifetime: None,
        persist_key: None,
        persist_ty: None,
        mutable: access == MIRAccess.Write,
        string_bytes_source: None,
        integer_bounds: None,
        uninit_scalar: false,
        uninit_fixed: false,
        direct_closure: false,
    }
    _ := jet_codegen_bind_local(&builder, program, local, owner_type, local.mutable, Val(value), Val(access), false)
    &builder.params.push(MIRParam{
        index: index,
        name: "self",
        span: span,
        ty: lowered_ty,
        access: access,
        ownership: mir_ownership_from_access(access),
        public_label: "self",
        variadic: false,
        default_present: false,
    })
}

fn jet_codegen_lower_function_form(function: TFunc, builder: JetCodegenBuilder, program: JetCodegenProgram) -> MIRFunctionForm Never! {
    return if function.kind == {
        .TopLevel -> MIRFunctionForm.TopLevel
        .Method(convention, owner_type) -> {
            self_access := if convention == {
                None -> None
                Val(value) -> Val(jet_codegen_lower_access(value))
            }
            MIRFunctionForm.Method{owner: jet_codegen_lower_type_for_function(owner_type, builder, program), self_access: self_access}
        }
        .TraitMethod(_, convention, owner_type, trait_symbol, codec) -> {
            self_access := if convention == {
                None -> None
                Val(value) -> Val(jet_codegen_lower_access(value))
            }
            serde := if codec == {
                None -> None
                Val(codec_value) -> if codec_value == {
                    .Encode -> Val(MIRSerdeCodec.Encode)
                    .Decode -> Val(MIRSerdeCodec.Decode)
                }
            }
            trait_ref := jet_codegen_mir_trait_ref_for_symbol(program.modules, trait_symbol)
            MIRFunctionForm.TraitMethod{owner: jet_codegen_lower_type_for_function(owner_type, builder, program), trait_ref: trait_ref, self_access: self_access, serde: serde}
        }
    }
}

fn jet_codegen_lambda_capture_facts(lambda: TLambda) -> MIRCaptureFacts Never! {
    MIRCaptureFacts{
        escapes: lambda.capture_facts.escapes,
        needs_fn_mut: lambda.capture_facts.needs_fn_mut,
        mutable: lambda.capture_facts.mutable,
        cloned: lambda.capture_facts.cloned,
        frozen: lambda.capture_facts.frozen,
        materialized: lambda.capture_facts.materialized,
        moved: lambda.capture_facts.moved,
    }
}

// Rust: none (Jet-only pass)
fn jet_codegen_validate_lambda_metadata(lambda: TLambda) Never! {
    if lambda.source_params.len() != lambda.param_types.len() -> panic("checked lambda parameter names and types differ")
    if lambda.source_param_symbols.len() != lambda.source_params.len() -> panic("checked lambda parameter symbol count differs")
    if lambda.host_param_conventions != None {
        conventions :: lambda.host_param_conventions ?? [AccessConvention]{}
        if conventions.len() != lambda.source_params.len() -> panic("checked lambda host convention count differs")
    }
    seen_parameter_symbols := [String:Bool]{}
    loop symbol in lambda.source_param_symbols {
        if symbol.key == "" || seen_parameter_symbols.get(symbol.key) != None -> panic("checked lambda has an empty or duplicate parameter symbol")
        _ := &seen_parameter_symbols.add(symbol.key, true)
    }
    seen_sources := [String:Bool]{}
    seen_runtime := [String:Bool]{}
    seen_capture_symbols := [String:Bool]{}
    loop capture in lambda.captures {
        if capture.source == "" || capture.local.name == "" -> panic("checked lambda has an empty capture slot")
        symbol :: capture.local.symbol_id ?? panic("checked lambda capture has no resolved source symbol")
        if symbol.key == "" || seen_capture_symbols.get(symbol.key) != None -> panic("checked lambda has an empty or duplicate capture symbol")
        if seen_sources.get(capture.source) != None -> panic("checked lambda has a duplicate source capture")
        if seen_runtime.get(capture.local.name) != None -> panic("checked lambda has a duplicate runtime capture")
        _ := &seen_sources.add(capture.source, true)
        _ := &seen_runtime.add(capture.local.name, true)
        _ := &seen_capture_symbols.add(symbol.key, true)
    }
    facts := jet_codegen_lambda_capture_facts(lambda)
    loop name in facts.mutable {
        if seen_sources.get(name) == None -> panic("checked lambda capture facts have no matching capture slot")
    }
    loop name in facts.cloned {
        if seen_sources.get(name) == None -> panic("checked lambda capture facts have no matching capture slot")
    }
    loop name in facts.frozen {
        if seen_sources.get(name) == None -> panic("checked lambda capture facts have no matching capture slot")
    }
    loop name in facts.materialized {
        if seen_sources.get(name) == None -> panic("checked lambda capture facts have no matching capture slot")
    }
    loop name in facts.moved {
        if seen_sources.get(name) == None -> panic("checked lambda capture facts have no matching capture slot")
    }
}

fn jet_codegen_bind_lambda_captures(builder: &JetCodegenBuilder, program: JetCodegenProgram, lambda: TLambda) Never! {
    facts := jet_codegen_lambda_capture_facts(lambda)
    builder.capture_facts = Val(facts)
    slot := 0
    loop capture in lambda.captures {
        moved := facts.moved.contains(capture.source)
        cloned := !moved && (facts.cloned.contains(capture.source) || facts.materialized.contains(capture.source))
        access := if {
            facts.mutable.contains(capture.source) -> MIRAccess.Write
            else -> MIRAccess.Read
        }
        ownership := if {
            moved || cloned -> mir_owned_ownership()
            else -> mir_ownership_from_access(access)
        }
        lowered_ty :: jet_codegen_lower_type_for_function(capture.ty, builder, program)
        value := jet_codegen_emit_mir_type(&builder, program, lambda.source_span, lowered_ty, ownership, MIROperation.Capture{slot: slot})
        &builder.capture_params.push(MIRCaptureParam{
            slot: slot,
            name: capture.source,
            span: lambda.source_span,
            ty: lowered_ty,
            access: access,
            ownership: ownership,
            place_only: false,
        })
        if capture.local.name != capture.source {
            source_local := capture.local
            source_local.name = capture.source
            _ := jet_codegen_bind_capture_local(&builder, program, source_local, capture.ty, value, access, ownership, false)
        }
        _ := jet_codegen_bind_capture_local(&builder, program, capture.local, capture.ty, value, access, ownership, false)
        slot += 1
    }
}

// Keep local byte spans attached to the checked function that owns them.
fn jet_codegen_lowering_error_message(function: TFunc, span: Span, message: String) -> String Never! {
    "checked TIR cannot lower to MIR at {span.start}..{span.end}: {function.source_file} (module {function.module_identity}), {function.name}: {message}"
}


// Lowers `function` on `builder`, which holds the program-wide inputs; the
// builder's per-function state is reset first (jet_codegen_begin_function).
fn jet_codegen_lower_function(builder: &JetCodegenBuilder, program: JetCodegenProgram, function: TFunc, statements: [TStmt], expression: TExpr?, lambda: TLambda?) -> JetCodegenLoweredFunction {
    // #3740: lower against the executable signature; a plain-return function
    // (`T Never!`) returns its success value directly.
    jet_codegen_begin_function(&builder, program, jet_codegen_executable_function(function))
    builder.stable_element_lets = jet_codegen_stable_element_lets(statements, expression)
    builder.partial_move_roots = jet_codegen_partial_move_roots(statements, expression)
    if lambda != None {
        value := lambda
        jet_codegen_validate_lambda_metadata(value)
        jet_codegen_bind_lambda_captures(&builder, program, value)
    }
    parameter_index := if function.kind == {
        .TopLevel -> 0
        .Method(convention, owner_type) -> {
            if convention == {
                None -> 0
                else -> {
                    jet_codegen_lower_receiver(&builder, program, owner_type, convention, function.source_span, 0)
                    1
                }
            }
        }
        .TraitMethod(_, convention, owner_type, _, _) -> {
            if convention == {
                None -> 0
                else -> {
                    jet_codegen_lower_receiver(&builder, program, owner_type, convention, function.source_span, 0)
                    1
                }
            }
        }
    }
    loop parameter in function.params {
        jet_codegen_lower_parameter(&builder, program, parameter, parameter_index)
        parameter_index += 1
    }
    jet_codegen_emit_entry_check(&builder, program)
    return_source := builder.function.ret ?? Type.Named{name: "Unit"}
    if {
        expression == None -> {
            jet_codegen_lower_statements(&builder, program, statements)
        } else -> {
            value :: expression
            lowered_value := jet_codegen_lower_expr(&builder, program, value)
            if jet_codegen_current_is_open(builder, program) -> _ := jet_codegen_terminate_with_owned_cleanup(&builder, program, MIRTerminator.Return{value: Val(lowered_value)}, -1)
        }
    }
    // Rust `lower_function` ends every open body with a bare return; a checked
    // body can only reach its end when its success is Unit.
    if jet_codegen_current_is_open(builder, program) {
        unit_ok :: jet_codegen_unit_never_return(&builder, program, function.source_span)
        if {
            unit_ok != None -> _ := jet_codegen_terminate_with_owned_cleanup(&builder, program, MIRTerminator.Return{value: unit_ok}, -1)
            jet_codegen_bare_return_completes(builder.function) -> _ := jet_codegen_terminate_with_owned_cleanup(&builder, program, MIRTerminator.Return{value: None}, -1)
            else -> panic(jet_codegen_lowering_error_message(builder.function, function.source_span, "checked non-Unit TFunc falls through during MIR lowering"))
        }
    }
    jet_codegen_seal_all_exit_chains(&builder, program)
    loop block in builder.blocks {
        if jet_codegen_is_open_terminator(block.terminator) {
            panic(jet_codegen_lowering_error_message(builder.function, function.source_span, "Jet codegen left an unterminated MIR block"))
        }
    }
    jet_codegen_move_last_uses(&builder, program)
    jet_codegen_resolve_drop_flags(&builder, program)
    jet_codegen_pack_function(&builder, program, function, return_source)
}

// Shared checked MIR packing for complete functions and suspended REPL roots.
// A suspended root deliberately has not run last-use/drop-finalization passes.
// Packing moves the function's rows out of `builder` (compiler_take_rows),
// leaving those lists empty: the next jet_codegen_begin_function resets the
// builder anyway, and a caller that keeps lowering on the builder packs a copy.
fn jet_codegen_pack_function(builder: &JetCodegenBuilder, program: JetCodegenProgram, function: TFunc, return_source: Type) -> JetCodegenLoweredFunction {
    optimization := mir_empty_optimization_facts()
    optimization.pure = function.is_pure
    optimization.inline = function.is_inline
    optimization.inline_always = function.is_inline_always
    optimization.gc_return = function.gc_return
    optimization.gc_scope = function.gc_scope
    optimization.kernel = function.kernel_proof != None
    // Every builder-derived fact is read before any row list moves out.
    declared_return := MIRType?{None}
    if builder.function.ret != None -> declared_return = Val(jet_codegen_lower_type_for_function(return_source, builder, program))
    return_type :: jet_codegen_lower_type_for_function(return_source, builder, program)
    form :: jet_codegen_lower_function_form(function, builder, program)
    failure :: jet_codegen_lower_failure(builder.function.failure_carrier, builder, program)
    web_param_reconstructions :: jet_codegen_lower_web_reconstructions(builder, program, function.web_param_reconstructions)
    entry :: builder.entry
    captures :: builder.capture_facts
    optimization.checked_vector_facts = compiler_take_rows<MIRVectorFact>(&builder.checked_vector_facts)
    blocks := compiler_take_rows<MIRBasicBlock>(&builder.blocks)
    jet_codegen_sort_blocks(&blocks)
    foreign_language := String?{None}
    if function.foreign == .Val(provenance) -> foreign_language = Val(provenance.language)
    mir_function := MIRFunction{
        id: jet_codegen_function_id(function),
        module_id: mir_module_id(function.module_identity),
        source_file: mir_source_file_id(function.source_file),
        key: function.key,
        module_name: function.module_name,
        name: function.name,
        span: function.source_span,
        kind: MIRFunctionKind.Jet,
        form: form,
        visibility: jet_codegen_lower_visibility(function.visibility),
        target_applicability: MIRTargetApplicability{
            rust_aot: function.target_applicability.rust_aot,
            interpreter: function.target_applicability.interpreter,
            web: function.target_applicability.web,
        },
        web_bucket: jet_codegen_lower_web_bucket(function.web_bucket),
        web_marker: jet_codegen_lower_web_marker(function.web_marker),
        generic_params: jet_codegen_lower_generic_params(function.generic_params, program.modules),
        capture_params: compiler_take_rows<MIRCaptureParam>(&builder.capture_params),
        params: compiler_take_rows<MIRParam>(&builder.params),
        declared_return: declared_return,
        return_type: return_type,
        failure: failure,
        effects: MIREffectFacts{
            direct: function.effects.direct,
            solved: function.effects.solved,
            call_edges: function.effects.call_edges,
            maximal: function.effects.maximal,
            direct_spans: jet_codegen_lower_effect_spans(function.effects.direct_spans),
        },
        captures: captures,
        generator: None,
        optimization: optimization,
        is_unsafe: function.is_unsafe,
        unsafe_gate: jet_codegen_lower_unsafe_gate(function.unsafe_gate),
        is_pure: function.is_pure,
        memo_bound: function.memo_bound,
        memo_unbounded: function.memo_unbounded,
        is_reactive: function.is_reactive,
        reactive_upgrades: function.reactive_upgrades,
        is_inline: function.is_inline,
        is_inline_always: function.is_inline_always,
        is_scalar: function.is_scalar,
        kernel_proof: jet_codegen_lower_kernel_proof(function.kernel_proof),
        gc_return: function.gc_return,
        return_view_provenance: jet_codegen_lower_view_provenance_map(function.return_view_provenance),
        web_param_reconstructions: web_param_reconstructions,
        blocks: blocks,
        entry: entry,
        locals: compiler_take_rows<MIRLocal>(&builder.locals),
        values: compiler_take_rows<MIRValueFact>(&builder.values),
        places: compiler_take_rows<MIRPlace>(&builder.places),
        scopes: compiler_take_rows<MIRScope>(&builder.scopes),
        drops: [MIRDropAction]{},
        foreign_language: foreign_language,
    }
    nested_functions := compiler_take_rows<MIRFunction>(&builder.nested_functions)
    fields := [MIRFieldRow]{}
    field_ids := [U64:Bool]{}
    jet_codegen_append_function_field_rows(mir_function, &fields, &field_ids)
    loop nested in nested_functions -> jet_codegen_append_function_field_rows(nested, &fields, &field_ids)
    jet_codegen_sort_field_rows(&fields)
    return JetCodegenLoweredFunction{
        function: mir_function,
        nested_functions: nested_functions,
        shared_sites: compiler_take_rows<MIRConstantDef>(&builder.shared_sites),
        closure_sources: compiler_take_rows<JetCodegenClosureSource>(&builder.closure_sources),
        callbacks: compiler_take_rows<MIRCallbackAdapter>(&builder.callbacks),
        fields: fields,
        prelude_calls: compiler_take_rows<MIRPreludeCall>(&builder.prelude_calls),
        core_calls: compiler_take_rows<MIRCoreCall>(&builder.core_calls),
        used_core: compiler_take_rows<String>(&builder.used_core),
    }
}

fn jet_codegen_lambda_function_type(lambda: TLambda) -> Type Never! {
    metadata := FunctionCallMetadata?{None}
    if lambda.host_param_conventions != None {
        conventions :: lambda.host_param_conventions ?? [AccessConvention]{}
        metadata = Val(FunctionCallMetadata{
            names: [String]{},
            defaults: [FunctionDefaultRef?]{},
            variadic: [Bool]{},
            conventions: conventions,
            policies: CallablePolicyChain{policies: [CallablePolicy]{}},
        })
    }
    Type.Fn{params: lambda.param_types, ret: lambda.ret, effect_bound: None, param_contract: None, call_metadata: metadata, return_view_provenance: None}
}

fn jet_codegen_send_function_type(builder: JetCodegenBuilder, program: JetCodegenProgram, ty: Type) -> MIRType Never! {
    lowered := jet_codegen_lower_type_for_function(ty, builder, program)
    if lowered.kind == {
        .Fn(signature) -> {
            conventions := [MIRAccess]{}
            metadata := signature.call_metadata
            index := 0
            loop index < signature.params.len() {
                access := MIRAccess.Read
                if metadata != None {
                    value :: metadata ?? panic("SendFn call metadata disappeared")
                    if index < value.conventions.len() -> access = value.conventions[index]
                }
                &conventions.push(access)
                index += 1
            }
            send_type := mir_type_from_kind(MIRTypeKind.SendFn{params: signature.params, ret: signature.ret, conventions: conventions})
            mir_type_with_identity(send_type, mir_type_id(mir_type_canonical_key(send_type)))
        }
        else -> panic("checked SendFn value has no function signature")
    }
}

// Rust mir.rs `promote_spawn_closure_to_send`: a spawned task body runs on a
// worker thread, so the spawn retypes its closure value to SendFn (an `Arc`
// closure in Rust AOT); the value keeps the ownership it was emitted with.
fn jet_codegen_promote_spawn_closure_to_send(builder: &JetCodegenBuilder, program: JetCodegenProgram, closure: MIRValueID, closure_type: Type) Never! {
    at :: builder.value_positions.get(closure.value) ?? panic("spawn closure has no MIR value type")
    if builder.values[at].ty.kind == {
        .SendFn(_, _, _) -> return
        .Fn(_) -> {}
        else -> panic("spawn closure is not callable")
    }
    target := jet_codegen_send_function_type(builder, program, closure_type)
    builder.values[at].ty = target
    // The closure is the instruction the spawn just lowered, in the current block.
    position :: builder.block_positions.get(builder.current.value) ?? panic("spawn closure block is missing")
    index := builder.blocks[position].instructions.len()
    loop index > 0 {
        index -= 1
        if builder.blocks[position].instructions[index].result == .Val(result) {
            if result == closure {
                builder.blocks[position].instructions[index].ty = Val(target)
                return
            }
        }
    }
    panic("spawn closure instruction is missing")
}

fn jet_codegen_emit_owned_value(builder: &JetCodegenBuilder, program: JetCodegenProgram, span: Span, ty: Type, operation: MIROperation) -> MIRValueID Never! {
    lowered_ty :: jet_codegen_lower_type_for_function(ty, builder, program)
    jet_codegen_emit_mir_type(&builder, program, span, lowered_ty, mir_owned_ownership(), operation)
}

fn jet_codegen_place_shares_record_handle(builder: JetCodegenBuilder, program: JetCodegenProgram, place: MIRPlaceID) -> Bool Never! {
    row :: jet_codegen_find_place(builder, program, place) ?? return false
    if row.projections.len() == 0 -> return false
    is_index := if row.projections[row.projections.len() - 1] == {
        .Index(_, _, _, _, _, _, _) -> true
        else -> false
    }
    if !is_index -> return false
    row.ty.layout.abi == MIRABI.Nominal || row.ty.layout.abi == MIRABI.Aggregate || row.ty.layout.abi == MIRABI.Sequence || row.ty.layout.abi == MIRABI.Dynamic
}

fn jet_codegen_same_callback(left: MIRCallbackAdapter, right: MIRCallbackAdapter) -> Bool Never! {
    left.id == right.id &&
        left.symbol == right.symbol &&
        left.function == right.function &&
        left.params == right.params &&
        left.return_type == right.return_type &&
        left.abi == right.abi &&
        left.managed == right.managed &&
        left.plan_digest == right.plan_digest &&
        left.callback_identity == right.callback_identity
}

fn jet_codegen_append_nested_function(builder: &JetCodegenBuilder, program: JetCodegenProgram, function: MIRFunction) Never! {
    loop existing in builder.nested_functions {
        if existing.id == function.id || (existing.module_id == function.module_id && existing.key == function.key) -> panic("duplicate nested MIR function identity")
    }
    &builder.nested_functions.push(function)
}

fn jet_codegen_merge_lowered_child(builder: &JetCodegenBuilder, program: JetCodegenProgram, lowered: JetCodegenLoweredFunction) Never! {
    jet_codegen_append_nested_function(&builder, program, lowered.function)
    loop nested in lowered.nested_functions -> jet_codegen_append_nested_function(&builder, program, nested)
    loop source in lowered.closure_sources -> &builder.closure_sources.push(source)
    jet_codegen_merge_shared_sites(&builder.shared_sites, lowered.shared_sites)
    loop callback in lowered.callbacks {
        duplicate := false
        loop existing in builder.callbacks {
            if existing.id == callback.id {
                if !jet_codegen_same_callback(existing, callback) -> panic("conflicting C callback adapter identity")
                duplicate = true
            }
        }
        if !duplicate -> &builder.callbacks.push(callback)
    }
    loop call in lowered.prelude_calls {
        if builder.prelude_call_positions.get(call.id.value) == .Val(position) {
            existing :: builder.prelude_calls[position]
            if existing.family != call.family || existing.module_name != call.module_name || existing.member != call.member || existing.symbol != call.symbol || existing.signature != call.signature || existing.effect_kind != call.effect_kind || !jet_codegen_authority_decisions_equal(existing.authority, call.authority) || existing.fallibility != call.fallibility || existing.abi != call.abi {
                panic("conflicting Prelude route identity across nested functions")
            }
        } else {
            jet_codegen_push_prelude_call(&builder, program, call)
        }
    }
    loop call in lowered.core_calls {
        duplicate := false
        loop existing in builder.core_calls {
            if existing.id == call.id {
                if existing.key != call.key -> panic("Core-call identity collision across nested functions")
                duplicate = true
            }
        }
        if !duplicate -> &builder.core_calls.push(call)
    }
    loop used_core_module in lowered.used_core {
        if !builder.used_core.contains(used_core_module) -> &builder.used_core.push(used_core_module)
    }
}

// Rust `project_lambda_effect_facts` (D-EFFECT-LAMBDA1): a lambda's solved row
// is its reachability row, its direct effects plus the solved row of every
// function it calls. Jet's effect graph folds each lambda into its enclosing
// function's node, so the checked lambda carries only its direct seed; the
// callees' rows are solved by now, so project them here.
fn jet_codegen_lambda_effects(function_index: JetCodegenFunctionIndex, effects: TEffectFacts) -> TEffectFacts Never! {
    projected := effects
    loop edge in effects.call_edges {
        if edge == "__jet_panic__" {
            _ := sema_effect_set_union(&projected.solved, [String]{"Panic"})
            next
        }
        row :: jet_codegen_find_function_row(function_index, edge) ?? next
        _ := sema_effect_set_union(&projected.solved, function_index.rows[row].effects.solved)
    }
    projected
}

fn jet_codegen_lower_lambda(builder: &JetCodegenBuilder, program: JetCodegenProgram, lambda: TLambda, send: Bool, purpose: String) -> JetCodegenLambdaValue {
    jet_codegen_validate_lambda_metadata(lambda)
    base_key := "{builder.function.key}::lambda@{lambda.source_span.start}..{lambda.source_span.end}"
    occurrence := builder.spawn_occurrences.get(base_key) ?? 0
    _ := &builder.spawn_occurrences.add(base_key, occurrence + 1)
    suffix := String?{None}
    if {
        purpose != "" && purpose != "direct" && (purpose != "spawn" || occurrence > 0) -> {
            suffix = Val("{purpose}-{occurrence}")
        }
        occurrence > 0 -> {
            suffix = Val("lambda-{occurrence}")
        }
    }
    key := base_key
    name := "__jet_lambda_{lambda.source_span.start}_{lambda.source_span.end}"
    if suffix != None {
        value :: suffix ?? ""
        key = "{key}::{value}"
        name = "{name}_{value}"
    }
    params := [TParameter]{}
    index := 0
    loop source_name in lambda.source_params {
        ty := lambda.param_types[index]
        convention := AccessConvention.Read
        if lambda.host_param_conventions != None {
            conventions :: lambda.host_param_conventions ?? [AccessConvention]{}
            convention = conventions[index]
        }
        local := tir_symbol_local(source_name, lambda.source_span, lambda.source_param_symbols[index])
        local.mutable = convention == AccessConvention.Write
        &params.push(TParameter{
            local: local,
            name: source_name,
            span: lambda.source_span,
            ty: ty,
            convention: convention,
            public_label: source_name,
            zone: ParamZone.Either,
            default: None,
            variadic: false,
        })
        index += 1
    }
    function := TFunc{
        name: name,
        module_name: builder.function.module_name,
        module_identity: builder.function.module_identity,
        key: key,
        source_file: builder.function.source_file,
        source_span: lambda.source_span,
        failure_carrier: lambda.failure_carrier,
        effects: jet_codegen_lambda_effects(program.function_index, lambda.effects),
        target_applicability: builder.function.target_applicability,
        web_bucket: builder.function.web_bucket,
        web_marker: None,
        visibility: TVisibility.Private,
        foreign: None,
        params: params,
        web_param_reconstructions: [TWebParamReconstruction]{},
        ret: lambda.ret,
        gc_return: false,
        gc_scope: false,
        return_view_provenance: None,
        generic_params: [TGenericParam]{},
        clone_types: [Type]{},
        is_main: false,
        line: builder.function.line,
        synthetic: true,
        is_unsafe: false,
        unsafe_gate: None,
        is_pure: lambda.effects.direct.len() == 0,
        memo_bound: None,
        memo_unbounded: false,
        is_reactive: false,
        reactive_upgrades: [String]{},
        is_inline: false,
        is_inline_always: false,
        is_scalar: false,
        kernel_proof: None,
        memo_field: None,
        uses_stack_sentry: lambda.uses_stack_sentry,
        body: [TStmt]{},
        kind: TFuncKind.TopLevel,
    }
    statements := [TStmt]{}
    expression := TExpr?{None}
    if lambda.executable == {
        .Expr(value) -> expression = Val(value)
        .Block(body) | .SharedBlock(body) -> statements = body
    }
    // The nested function lowers on the same builder (no program copy); the
    // enclosing function's state is saved around it.
    enclosing := jet_codegen_function_state(builder, program)
    lowered := jet_codegen_lower_function(&builder, program, function, statements, expression, Val(lambda))
    jet_codegen_restore_function_state(&builder, program, ^enclosing)
    function_id := lowered.function.id
    jet_codegen_merge_lowered_child(&builder, program, lowered)
    &builder.closure_sources.push(JetCodegenClosureSource{function: function_id, source_file: builder.function.source_file, lambda: lambda})

    facts := jet_codegen_lambda_capture_facts(lambda)
    captures := [MIRCaptureOperand]{}
    loop capture in lambda.captures {
        moved := facts.moved.contains(capture.source)
        cloned := !moved && (facts.cloned.contains(capture.source) || facts.materialized.contains(capture.source))
        access := if {
            facts.mutable.contains(capture.source) -> MIRAccess.Write
            else -> MIRAccess.Read
        }
        borrowed := (access == MIRAccess.Read || access == MIRAccess.Write) && !moved && !cloned
        outer_slot := capture.local.name
        if cloned && capture.local.name != capture.source -> outer_slot = capture.source
        outer_access := if moved -> MIRAccess.Move else if cloned -> MIRAccess.Read else -> access
        outer_local := capture.local
        outer_local.name = outer_slot
        place := jet_codegen_lower_place_for_access(&builder, program, TPlace.Local{local: outer_local}, outer_access)
        if borrowed {
            &captures.push(MIRCaptureOperand.Place{place: place})
            next
        }
        value := if {
            cloned -> {
                read := jet_codegen_emit_value(&builder, program, lambda.source_span, capture.ty, MIROperation.ReadPlace{place: place})
                if {
                    facts.mutable.contains(capture.source) && jet_codegen_place_shares_record_handle(builder, program, place) -> {
                        read
                    } else -> {
                        jet_codegen_emit_owned_value(&builder, program, lambda.source_span, capture.ty, MIROperation.Copy{value: read, fact: if facts.materialized.contains(capture.source) -> MIRCopyFact.ViewMaterialize else -> MIRCopyFact.Materialize})
                    }
                }
            }
            moved -> {
                jet_codegen_emit_owned_value(&builder, program, lambda.source_span, capture.ty, MIROperation.MovePlace{place: place})
            }
            else -> {
                jet_codegen_emit_value(&builder, program, lambda.source_span, capture.ty, MIROperation.ReadPlace{place: place})
            }
        }
        &captures.push(MIRCaptureOperand.Value{value: value})
    }
    capture_facts := jet_codegen_lambda_capture_facts(lambda)
    operation := MIROperation.Closure{function: function_id, captures: captures, facts: capture_facts}
    closure_type := jet_codegen_lambda_function_type(lambda)
    value := if {
        send -> {
            send_ty :: jet_codegen_send_function_type(builder, program, closure_type)
            jet_codegen_emit_mir_type(&builder, program, lambda.source_span, send_ty, mir_owned_ownership(), operation)
        } else -> {
            jet_codegen_emit_value(&builder, program, lambda.source_span, closure_type, operation)
        }
    }
    JetCodegenLambdaValue{value: value, function: function_id}
}

fn jet_codegen_sort_strings(values: [String]) -> [String] Never! {
    sorted := [String]{}
    loop position in jet_codegen_sorted_order([U64]{}, values) -> &sorted.push(values[position])
    unique := [String]{}
    loop value in sorted {
        if unique.len() == 0 || unique[unique.len() - 1] != value -> &unique.push(value)
    }
    unique
}

fn jet_codegen_sort_named_spans(values: [MIRNamedSpan]) -> [MIRNamedSpan] Never! {
    names := [String]{}
    loop value in values -> &names.push(value.name)
    sorted := [MIRNamedSpan]{}
    loop position in jet_codegen_sorted_order([U64]{}, names) -> &sorted.push(values[position])
    unique := [MIRNamedSpan]{}
    loop value in sorted {
        if unique.len() == 0 || unique[unique.len() - 1].name != value.name -> &unique.push(value)
    }
    unique
}

fn jet_codegen_lower_effect_spans(spans: [TEffectSpan]) -> [MIRNamedSpan] Never! {
    lowered := [MIRNamedSpan]{}
    loop span in spans -> &lowered.push(MIRNamedSpan{name: span.name, span: span.span})
    jet_codegen_sort_named_spans(lowered)
}

fn jet_codegen_lower_unsafe_gate(gate: TUnsafeGate?) -> MIRUnsafeGate? {
    if gate == None -> return None
    value :: gate
    Val(MIRUnsafeGate{file: value.file, line: value.line, reason: value.reason, enabled: value.enabled, fenced: value.fenced})
}

fn jet_codegen_comptime_module_name(modules: [SemaGraphModuleResult], module_identity: String) -> String Never! {
    loop semantic_module in modules {
        if semantic_module.module_identity == module_identity -> return semantic_module.module_name
    }
    panic("checked comptime item has no staged Sema module")
}

// The synthetic function a comptime item lowers as.
fn jet_codegen_comptime_item_tfunc(module_identity: String, module_name: String, key: String, source_file: String, span: Span, result_type: Type) -> TFunc Never! {
    TFunc{
        name: "__comptime_item",
        module_name: module_name,
        module_identity: module_identity,
        key: key,
        source_file: source_file,
        source_span: span,
        failure_carrier: TFailureCarrier.Infallible,
        effects: TEffectFacts{direct: [String]{}, solved: [String]{}, call_edges: [String]{}, maximal: false, direct_spans: [TEffectSpan]{}},
        target_applicability: TTargetApplicability{rust_aot: false, interpreter: true, web: false},
        web_bucket: None,
        web_marker: None,
        visibility: TVisibility.Private,
        foreign: None,
        params: [TParameter]{},
        web_param_reconstructions: [TWebParamReconstruction]{},
        ret: Val(result_type),
        gc_return: false,
        gc_scope: false,
        return_view_provenance: None,
        generic_params: [TGenericParam]{},
        clone_types: [Type]{},
        is_main: false,
        line: 0,
        synthetic: true,
        is_unsafe: false,
        unsafe_gate: None,
        is_pure: false,
        memo_bound: None,
        memo_unbounded: false,
        is_reactive: false,
        reactive_upgrades: [String]{},
        is_inline: false,
        is_inline_always: false,
        is_scalar: false,
        kernel_proof: None,
        memo_field: None,
        uses_stack_sentry: false,
        body: [TStmt]{},
        kind: TFuncKind.TopLevel,
    }
}

fn jet_codegen_comptime_item_function(request: SemaComptimeItemRequest, modules: [SemaGraphModuleResult]) -> TFunc {
    result_type := request.expression.ty
    if request.expected_type != None {
        expected :: request.expected_type ?? panic("checked comptime item lost its expected type")
        if type_identity_key(expected) != type_identity_key(result_type) -> panic("checked comptime item result disagrees with its expected type")
        result_type = expected
    }
    jet_codegen_comptime_item_tfunc(request.module_identity, jet_codegen_comptime_module_name(modules, request.module_identity), "{request.module_identity}::__comptime_item::{request.key}", request.source_file, request.span, result_type)
}

// The lowering inputs of one staged module set, kept by a comptime run across
// its items: the program owns the modules (moved in once), their owner, field
// and source indexes, all built once here, and the staged values that land
// later join it in place (jet_codegen_comptime_session_add_constants). Each
// item lowers its closure and itself on the one builder; per item only the
// closure-sized function index and closure method set change, never a
// whole-program walk.
struct JetCodegenComptimeSession {
    program: JetCodegenProgram
    builder: JetCodegenBuilder
    // The staged modules' constant rows (jet_codegen_lower_constant_rows),
    // in canonical order when `constants_sorted` (rows added since are sorted
    // when a program next takes a copy).
    constants: [MIRConstantDef]
    constants_sorted: Bool
    // Module identity -> its first position in `program.modules`.
    module_rows: [String:Int]
    // The staged modules' declared types (jet_codegen_declared_type_slots),
    // lowered once against no function: each item's program takes these rows
    // and relowers only the definitions whose methods its closure lowers and
    // those with a CLI entry or binding (jet_codegen_comptime_types).
    type_slots: [JetCodegenTypeSlot]
    // Qualified method key (jet_codegen_qualified_function_key) -> the
    // positions in `type_slots` of the rows that list that method.
    method_slots: [String:[Int]]
    // The staged modules' trait spellings (jet_codegen_trait_names): staged
    // values add only constants, so every item's impl rows resolve their
    // trait names against this one index.
    trait_names: JetCodegenTraitNames
    // The qualified keys (jet_codegen_qualified_function_key) of every
    // function a declared row looks up by key: type methods, trait default
    // bodies and impl methods. A free function outside this set changes no
    // type, trait or impl row when it joins a program
    // (lower_comptime_growth).
    row_keys: [String:Bool]
}

fn jet_codegen_comptime_session(modules: ^[SemaGraphModuleResult], source_files: [MIRSourceFile], stop_points: Bool, edition: String) -> JetCodegenComptimeSession {
    field_symbols := jet_codegen_field_symbol_index(modules)
    source_index := jet_codegen_source_index(source_files)
    function_index := jet_codegen_function_index([TFunc]{})
    constants := jet_codegen_lower_constant_rows(modules)
    // With no function and `closure_only`, a type row lists no method: the
    // row any closure that lowers none of its methods also gets.
    type_slots := jet_codegen_declared_type_slots(function_index, modules, true, true)
    method_slots := [String:[Int]]{}
    loop position in 0..<type_slots.len() {
        slot :: type_slots[position]
        if slot.module_index < 0 || slot.row == None -> next
        definition :: modules[slot.module_index].declarations.type_defs[slot.definition_index]
        method_keys := if definition.kind == {
            .Struct(_, methods) | .Enum(_, methods) -> methods
            else -> [String]{}
        }
        loop key in method_keys {
            qualified :: jet_codegen_qualified_function_key(definition.module_identity, key)
            positions := method_slots.get(qualified) ?? [Int]{}
            &positions.push(position)
            method_slots[qualified] = positions
        }
    }
    trait_names := jet_codegen_trait_names(modules)
    module_rows := [String:Int]{}
    loop (index, semantic_module) in modules {
        if module_rows.get(semantic_module.module_identity) == None -> module_rows[semantic_module.module_identity] = index
    }
    row_keys := [String:Bool]{}
    loop semantic_module in modules {
        loop definition in semantic_module.declarations.type_defs {
            method_keys := if definition.kind == {
                .Struct(_, methods) | .Enum(_, methods) -> methods
                else -> [String]{}
            }
            loop key in method_keys -> row_keys[jet_codegen_qualified_function_key(definition.module_identity, key)] = true
        }
        loop definition in semantic_module.declarations.traits {
            loop method in definition.methods {
                if method.default_function_key == .Val(key) -> row_keys[jet_codegen_qualified_function_key(definition.module_identity, key)] = true
            }
        }
        loop definition in semantic_module.declarations.impls {
            loop key in definition.methods -> row_keys[jet_codegen_qualified_function_key(definition.module_identity, key)] = true
        }
    }
    // Every lowering replaces this first function (jet_codegen_begin_function).
    first := jet_codegen_comptime_item_tfunc("", "", "", "", Span{start: 0, end: 0}, Type.Named{name: "Unit"})
    program := jet_codegen_new_program(^function_index, ^modules, ^field_symbols, source_files, ^source_index, edition)
    // A native-host comptime session lowers compiler callables: stop points
    // plus the budget can-stop operations.
    program.stop_points = stop_points
    program.comptime_budget = stop_points
    builder := jet_codegen_new_builder(first, program)
    program.owners.closure_only = true
    JetCodegenComptimeSession{program: ^program, builder: ^builder, constants: ^constants, constants_sorted: true, module_rows: ^module_rows, type_slots: ^type_slots, method_slots: ^method_slots, trait_names: ^trait_names, row_keys: ^row_keys}
}

// The staged modules a session was built from, moved out of it at the end of
// a comptime run: as given, with the constant rows of the values that landed
// since joined (jet_codegen_comptime_session_add_constants changes nothing
// else in them).
fn jet_codegen_comptime_session_modules(session: ^JetCodegenComptimeSession) -> [SemaGraphModuleResult] {
    owned := ^session
    modules := ^owned.program.modules
    modules
}

// Joins the checked rows of staged constants that landed after the session
// was built (sema_comptime_staged_constant_rows) to its modules, constant
// index and constant rows, exactly as building the session with them would:
// lowering finds a module constant only by its symbol key, and constant rows
// keep canonical ID order, so where a row joins is unobservable. A key that
// already has a row keeps it, as the first staged value of a key wins.
// Returns the lowered rows it added, in order; the session's rows are sorted
// again only when a program takes them (lower_comptime_closure), not per add.
fn jet_codegen_comptime_session_add_constants(session: &JetCodegenComptimeSession, definitions: [TConstantDef]) -> [MIRConstantDef] {
    added := [MIRConstantDef]{}
    loop definition in definitions {
        key :: jet_codegen_constant_symbol_key(definition)
        if session.program.owners.constants.rows.get(key) != None -> next
        module_index :: session.module_rows.get(definition.module_identity) ?? panic("a staged comptime constant has no staged module")
        _ := &session.program.owners.constants.rows.add(key, JetCodegenConstantRow{module_index: module_index, definition_index: session.program.modules[module_index].declarations.constants.len()})
        &session.program.modules[module_index].declarations.constants.push(definition)
        lowered :: jet_codegen_lower_constant_definition(definition, session.program.modules) ?? next
        &session.constants.push(lowered)
        &added.push(lowered)
        session.constants_sorted = false
    }
    added
}

// The declared type rows of one closure's program: the session's rows, with
// each definition whose methods the closure lowers, or that has a CLI entry
// or binding, lowered against the closure (jet_codegen_lower_type_definition
// with `closure_only`). Every other definition lowers to its session row,
// because none of its methods is in the closure's function index.
fn jet_codegen_comptime_types(session: JetCodegenComptimeSession) -> [MIRTypeDef] {
    named := (loop _ in session.type_slots -> false)
    loop function in session.program.function_index.rows {
        positions :: session.method_slots.get(jet_codegen_qualified_function_key(function.module_identity, function.key)) ?? next
        loop position in positions -> named[position] = true
    }
    types := [MIRTypeDef]{}
    loop position in 0..<session.type_slots.len() {
        slot :: session.type_slots[position]
        if !named[position] {
            if slot.row == .Val(row) {
                &types.push(row)
                next
            }
        }
        definition :: session.program.modules[slot.module_index].declarations.type_defs[slot.definition_index]
        &types.push(jet_codegen_lower_type_definition(definition, session.program.function_index, session.program.modules, true))
    }
    types
}

// The temporary interpreter lowering of a comptime program's checked function
// closure, returned as program rows; the session's builder keeps the
// closure's function index, so lower_comptime_item then lowers each item
// function of the program against it. A type row names only the methods
// lowered with this closure: the owner index consults the closure method set
// (jet_codegen_function_type_generic_names) and type rows drop methods
// outside the closure's function index (jet_codegen_type_method_ids), so the
// staged modules are never rewritten per program.
fn lower_comptime_closure(session: &JetCodegenComptimeSession, functions: [TFunc]) -> JetCodegenFunctions {
    jet_codegen_comptime_session_restore(&session, functions)
    rows := jet_codegen_lower_each_function(&session.builder, session.program, functions, None)
    if !session.constants_sorted {
        jet_codegen_sort_constant_definitions(&session.constants)
        session.constants_sorted = true
    }
    constants := session.constants
    types := jet_codegen_comptime_types(session)
    jet_codegen_functions_from_rows(^rows, functions, session.program.function_index, session.program.modules, session.trait_names, ^types, ^constants)
}

// Makes `functions` the session's closure (its function index and closure
// method set), as lower_comptime_closure does before lowering them: a growing
// program's closure again, after the session lowered another program's.
fn jet_codegen_comptime_session_restore(session: &JetCodegenComptimeSession, functions: [TFunc]) {
    closure_methods := [String:Bool]{}
    loop function in functions -> closure_methods[jet_codegen_qualified_function_key(function.module_identity, function.key)] = true
    session.program.owners.closure_methods = ^closure_methods
    session.program.function_index = jet_codegen_function_index(functions.copy())
}

// The item function of one comptime `request`, lowered against the closure
// the last lower_comptime_closure set up on `session`.
fn lower_comptime_item(session: &JetCodegenComptimeSession, request: SemaComptimeItemRequest) -> JetCodegenLoweredFunction {
    item_function := jet_codegen_comptime_item_function(request, session.program.modules)
    jet_codegen_lower_function(&session.builder, session.program, item_function, [TStmt]{}, Val(request.expression), None)
}

// A2c, one growing comptime program per run: the rows a program whose
// closure is the session's gains when `functions` (closure functions it
// lacks) and the item functions of `requests` join it, as
// lower_comptime_closure, lower_comptime_item and the driver's item merge
// give them for the larger closure. Each new function must be a free
// function that no declared row names (`row_keys`): such a function changes
// no type, trait or impl row (type method lists, trait defaults and impl
// methods look functions up only by those keys, or by name among methods),
// so the program keeps every row it has and gains only these. The new
// functions join the session's closure before any lowers (a function's
// lowering looks up its callees, which its closure holds). `fields` holds the
// field rows of the new closure functions and of `constants` (the constant
// rows the program gains), as jet_codegen_functions_from_rows derives them,
// then each item's own rows, unmerged; `types` holds the synthetic union rows
// the new closure functions name, which the program must already have. None,
// before the session changes, when a new function is not such a free
// function.
fn lower_comptime_growth(session: &JetCodegenComptimeSession, functions: [TFunc], requests: [SemaComptimeItemRequest], constants: [MIRConstantDef]) -> JetCodegenFunctions? {
    loop function in functions {
        free := if function.kind == {
            .TopLevel -> true
            else -> false
        }
        if !free -> return None
        if session.row_keys.get(jet_codegen_qualified_function_key(function.module_identity, function.key)) != None -> return None
    }
    if functions.len() > 0 {
        loop function in functions -> session.program.owners.closure_methods[jet_codegen_qualified_function_key(function.module_identity, function.key)] = true
        added := functions.copy()
        jet_codegen_function_index_append(&session.program.function_index, &added)
    }
    rows := jet_codegen_lower_each_function(&session.builder, session.program, functions, None)
    grown := JetCodegenFunctions{functions: [MIRFunction]{}, nested_functions: [MIRFunction]{}, callbacks: [MIRCallbackAdapter]{}, closure_sources: [JetCodegenClosureSource]{}, types: [MIRTypeDef]{}, core_owners: [MIRCoreOwner]{}, traits: [MIRTraitDef]{}, impls: [MIRImplDef]{}, constants: [MIRConstantDef]{}, fields: [MIRFieldRow]{}, core_calls: [MIRCoreCall]{}, prelude_calls: [MIRPreludeCall]{}, used_core: [String]{}}
    seen := JetCodegenGrowthSeen{prelude_calls: [U64:Bool]{}, core_calls: [U64:Bool]{}, used_core: [String:Bool]{}}
    loop row in rows -> jet_codegen_growth_add(&grown, &seen, row)
    jet_codegen_register_synthetic_unions(&grown.types, grown.functions, grown.nested_functions)
    grown.fields = jet_codegen_lower_field_rows([MIRTypeDef]{}, grown.functions, grown.nested_functions, [MIRTraitDef]{}, [MIRImplDef]{}, constants)
    loop request in requests {
        item := lower_comptime_item(&session, request)
        loop field in item.fields -> &grown.fields.push(field)
        jet_codegen_growth_add(&grown, &seen, item)
    }
    Val(grown)
}

struct JetCodegenGrowthSeen {
    prelude_calls: [U64:Bool]
    core_calls: [U64:Bool]
    used_core: [String:Bool]
}

// Appends one lowered function's rows to `grown`: its function, nested
// functions and callbacks, and the Prelude calls, Core calls and Core modules
// `grown` does not list yet.
fn jet_codegen_growth_add(grown: &JetCodegenFunctions, seen: &JetCodegenGrowthSeen, row: JetCodegenLoweredFunction) Never! {
    &grown.functions.push(row.function)
    loop nested in row.nested_functions -> &grown.nested_functions.push(nested)
    loop callback in row.callbacks -> &grown.callbacks.push(callback)
    loop source in row.closure_sources -> &grown.closure_sources.push(source)
    jet_codegen_merge_shared_sites(&grown.constants, row.shared_sites)
    loop call in row.prelude_calls {
        if seen.prelude_calls.get(call.id.value) != None -> next
        seen.prelude_calls[call.id.value] = true
        &grown.prelude_calls.push(call)
    }
    loop call in row.core_calls {
        if seen.core_calls.get(call.id.value) != None -> next
        seen.core_calls[call.id.value] = true
        &grown.core_calls.push(call)
    }
    loop usage in row.used_core {
        if seen.used_core.get(usage) != None -> next
        seen.used_core[usage] = true
        &grown.used_core.push(usage)
    }
}

// Positions of `keys` in stable ascending (key, tie) order; an empty `keys`
// or `ties` list compares as all-equal. Bottom-up merge sort: O(n log n) on
// the hash-ordered ids the canonical row sorts see, where insertion sort was
// quadratic.
fn jet_codegen_sorted_order(keys: [U64], ties: [String]) -> [Int] Never! {
    count :: if keys.len() > ties.len() -> keys.len() else -> ties.len()
    order := [Int]{}
    loop index in 0..<count -> &order.push(index)
    scratch := order
    width := 1
    loop width < count {
        start := 0
        loop start < count {
            middle :: if start + width < count -> start + width else -> count
            stop :: if start + 2 * width < count -> start + 2 * width else -> count
            left := start
            right := middle
            out := start
            loop out < stop {
                take_right := false
                if left >= middle {
                    take_right = true
                } else if right < stop {
                    take_right = jet_codegen_order_before(keys, ties, order[right], order[left])
                }
                if take_right {
                    scratch[out] = order[right]
                    right += 1
                } else {
                    scratch[out] = order[left]
                    left += 1
                }
                out += 1
            }
            start = stop
        }
        merged := scratch
        scratch = order
        order = merged
        width = width * 2
    }
    order
}

fn jet_codegen_order_before(keys: [U64], ties: [String], left: Int, right: Int) -> Bool Never! {
    if keys.len() > 0 && keys[left] != keys[right] -> return keys[left] < keys[right]
    ties.len() > 0 && ties[left] < ties[right]
}

fn jet_codegen_sort_functions(rows: &[MIRFunction]) Never! {
    keys := [U64]{}
    ties := [String]{}
    loop index in 0..<rows.len() {
        &keys.push(rows[index].id.value)
        &ties.push(rows[index].key)
    }
    compiler_apply_order<MIRFunction>(&rows, jet_codegen_sorted_order(keys, ties))
}

fn jet_codegen_sort_callback_adapters(rows: &[MIRCallbackAdapter]) Never! {
    keys := [U64]{}
    loop index in 0..<rows.len() -> &keys.push(rows[index].id.value)
    compiler_apply_order<MIRCallbackAdapter>(&rows, jet_codegen_sorted_order(keys, [String]{}))
}

fn jet_codegen_sort_type_definitions(rows: &[MIRTypeDef]) Never! {
    keys := [U64]{}
    loop index in 0..<rows.len() -> &keys.push(rows[index].id.value)
    compiler_apply_order<MIRTypeDef>(&rows, jet_codegen_sorted_order(keys, [String]{}))
}
struct JetCodegenUnionIndex {
    rows: [MIRType]
    positions: [U64:Int]
    canonical_keys: [String]
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::lower_anonymous_union_type_defs
fn jet_codegen_collect_union_type(ty: MIRType, unions: &JetCodegenUnionIndex) Never! {
    if ty.kind == {
        .Union(members) -> {
            identity :: ty.identity ?? panic("checked structural union has no MIR identity")
            key := mir_type_canonical_key(ty)
            if unions.positions.get(identity.value) == .Val(position) {
                if unions.canonical_keys[position] != key -> panic("structural union identity has conflicting member types")
            } else {
                _ := &unions.positions.add(identity.value, unions.rows.len())
                &unions.rows.push(ty)
                &unions.canonical_keys.push(key)
            }
            loop member in members -> jet_codegen_collect_union_type(member, &unions)
        }
        .List(inner) | .Shared(inner) | .Option(inner) | .FixedList(inner, _) | .InlineRange(inner, _, _) | .Tagged(_, inner) | .Quantity(inner, _) -> jet_codegen_collect_union_type(inner, &unions)
        .Map(key, value) -> {
            jet_codegen_collect_union_type(key, &unions)
            jet_codegen_collect_union_type(value, &unions)
        }
        .Result(ok, err) -> {
            jet_codegen_collect_union_type(ok, &unions)
            jet_codegen_collect_union_type(err, &unions)
        }
        .Fn(signature) -> {
            loop parameter in signature.params -> jet_codegen_collect_union_type(parameter, &unions)
            if signature.ret != None -> jet_codegen_collect_union_type(signature.ret ?? ty, &unions)
        }
        .SendFn(params, ret, _) -> {
            loop parameter in params -> jet_codegen_collect_union_type(parameter, &unions)
            if ret != None -> jet_codegen_collect_union_type(ret, &unions)
        }
        .Apply(_, args) -> loop argument in args -> jet_codegen_collect_union_type(argument, &unions)
        .Tuple(fields) -> loop field in fields -> jet_codegen_collect_union_type(field.ty, &unions)
        else -> {}
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::lower_anonymous_union_type_defs
fn jet_codegen_collect_unions_from_type_definition(definition: MIRTypeDef, unions: &JetCodegenUnionIndex) Never! {
    if definition.kind == {
        .Struct(fields, _) -> loop field in fields -> jet_codegen_collect_union_type(field.ty, &unions)
        .Enum(variants, _) -> loop variant in variants {
            if variant.payload == {
                .Single(value) -> jet_codegen_collect_union_type(value, &unions)
                .Named(fields) -> loop field in fields -> jet_codegen_collect_union_type(field.ty, &unions)
                .Unit -> {}
            }
        }
        .Distinct(base, _) -> jet_codegen_collect_union_type(base, &unions)
        .Alias(target) -> jet_codegen_collect_union_type(target, &unions)
        .UnitFamily(_) -> {}
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::lower_anonymous_union_type_defs
fn jet_codegen_collect_unions_from_function(function: MIRFunction, unions: &JetCodegenUnionIndex) Never! {
    jet_codegen_collect_union_type(function.return_type, &unions)
    if function.declared_return != None -> jet_codegen_collect_union_type(function.declared_return ?? function.return_type, &unions)
    loop parameter in function.params -> jet_codegen_collect_union_type(parameter.ty, &unions)
    loop capture in function.capture_params -> jet_codegen_collect_union_type(capture.ty, &unions)
    loop local in function.locals -> jet_codegen_collect_union_type(local.ty, &unions)
    loop value in function.values -> jet_codegen_collect_union_type(value.ty, &unions)
    loop place in function.places -> jet_codegen_collect_union_type(place.ty, &unions)
    loop block in function.blocks {
        loop instruction in block.instructions {
            if instruction.ty != None -> jet_codegen_collect_union_type(instruction.ty ?? function.return_type, &unions)
        }
    }
}

fn jet_codegen_union_mir_member_tag(ty: MIRType) -> String {
    raw := mir_type_display_name(ty)
    before_args := raw.split("<").to_list()[0]
    bytes := before_args.bytes()
    last_separator := -1
    index := 0
    loop index + 1 < bytes.len() {
        if {
            bytes[index] == (U8{58}) && bytes[index + 1] == (U8{58}) -> {
                last_separator = index + 1
                index += 2
            } else -> {
                index += 1
            }
        }
    }
    start := if last_separator >= 0 -> last_separator + 1 else -> 0
    base := String.from_bytes(bytes[start..<bytes.len()]) ?? panic("canonical union member name is not valid UTF-8")
    suffix := ""
    if before_args.len() < raw.len() -> suffix = String.from_bytes(raw.bytes()[before_args.bytes().len()..<raw.bytes().len()]) ?? panic("canonical union generic name is not valid UTF-8")
    jet_codegen_union_member_tag_name("{base}{suffix}")
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::lower_anonymous_union_type_defs
fn jet_codegen_synthetic_union_definition(ty: MIRType, module_id: MIRModuleID) -> MIRTypeDef {
    identity :: ty.identity ?? panic("checked structural union has no MIR identity")
    members := if ty.kind == {
        .Union(values) -> values
        else -> panic("synthetic union type definition received a non-union type")
    }
    variants := [MIRVariant]{}
    seen_tags := [String:Bool]{}
    loop member in members {
        member_tag := jet_codegen_union_mir_member_tag(member)
        if seen_tags.get(member_tag) != None -> panic("structural union members lower to duplicate Rust variant tags")
        _ := &seen_tags.add(member_tag, true)
        &variants.push(MIRVariant{
            name: member_tag,
            wire_name: member_tag,
            span: Span{start: 0, end: 0},
            payload: MIRVariantPayload.Single{value: member},
            discriminant: None,
        })
    }
    name := "__JetUnion_{identity.value}"
    return MIRTypeDef{
        id: identity,
        module_id: module_id,
        key: name,
        name: name,
        span: Span{start: 0, end: 0},
        public: false,
        package_public: false,
        generic_params: [MIRGenericParam]{},
        derives: [MIRTraitID]{},
        auto_derive_default: false,
        auto_printable: false,
        published_schema: false,
        single_use: false,
        must_use: false,
        layout: None,
        c_layout_tag: None,
        enum_layout: None,
        layout_alignment: None,
        cli: None,
        serde: [MIRSerdeAttribute]{},
        cli_bindings: [MIRCLIBinding]{},
        ownership: MIROwnershipMode.Owned,
        boxed_edges: [String]{},
        compiler_builtin: None,
        kind: MIRTypeDefKind.Enum{variants: variants, methods: [MIRFunctionID]{}},
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs::compiler_owned_record
// (`Range`, `FieldError`, the carrier, Core and math record rows)
fn jet_codegen_compiler_owned_record_definition(module_identity: String, name: String, record_fields: [TypeTupleField]) -> MIRTypeDef {
    jet_codegen_compiler_owned_definition(module_identity, name, MIRTypeDefKind.Struct{fields: jet_codegen_compiler_owned_fields(name, record_fields), methods: [MIRFunctionID]{}})
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs::compiler_owned_type_defs
// (a COMPILER_OWNED_ENUMS row) and compiler_owned_core_enums (`plain`: a Core
// enum leaf with no loaded source declaration, every variant unit).
fn jet_codegen_compiler_owned_enum_definition(module_identity: String, name: String, variant_names: [String], plain: Bool) -> MIRTypeDef {
    variants := [MIRVariant]{}
    loop variant in variant_names {
        payload := if plain -> JetCodegenCompilerOwnedPayload.Unit else -> jet_codegen_compiler_owned_enum_payload(name, variant)
        lowered := if payload == {
            .Unit -> MIRVariantPayload.Unit
            .Single(ty) -> MIRVariantPayload.Single{value: jet_codegen_lower_type(ty)}
            .Named(fields) -> MIRVariantPayload.Named{fields: jet_codegen_compiler_owned_fields("{name}::{variant}", fields)}
        }
        &variants.push(MIRVariant{name: variant, wire_name: variant, span: Span{start: 0, end: 0}, payload: lowered, discriminant: None})
    }
    jet_codegen_compiler_owned_definition(module_identity, name, MIRTypeDefKind.Enum{variants: variants, methods: [MIRFunctionID]{}})
}

// The declared fields of a compiler-owned row: public, stored, under the
// field IDs `{owner_key}::{field}` a projection of the bare row resolves to.
fn jet_codegen_compiler_owned_fields(owner_key: String, record_fields: [TypeTupleField]) -> [MIRField] {
    span :: Span{start: 0, end: 0}
    fields := [MIRField]{}
    loop field in record_fields {
        &fields.push(MIRField{
            id: mir_field_id("{owner_key}::{field.name}"),
            name: field.name,
            shape_names: jet_codegen_tuple_shape_names(field.name),
            skip: false,
            ty: jet_codegen_lower_type(field.ty),
            span: span,
            public: true,
            package_public: false,
            computed: false,
            has_default: false,
            redact: false,
        })
    }
    fields
}

// One compiler-owned row under its bare canonical key, with the row's type
// parameters (`jet_codegen_compiler_owned_generic_params`).
fn jet_codegen_compiler_owned_definition(module_identity: String, name: String, kind: MIRTypeDefKind) -> MIRTypeDef {
    generic_params := [MIRGenericParam]{}
    loop param in jet_codegen_compiler_owned_generic_params(name) -> &generic_params.push(MIRGenericParam{name: param, bounds: [MIRTraitRef]{}})
    return MIRTypeDef{
        id: mir_type_id(name),
        module_id: mir_module_id(module_identity),
        key: name,
        name: name,
        span: Span{start: 0, end: 0},
        public: true,
        package_public: false,
        generic_params: generic_params,
        derives: [MIRTraitID]{},
        auto_derive_default: false,
        auto_printable: false,
        published_schema: false,
        single_use: false,
        must_use: false,
        layout: None,
        c_layout_tag: None,
        enum_layout: None,
        layout_alignment: None,
        cli: None,
        serde: [MIRSerdeAttribute]{},
        cli_bindings: [MIRCLIBinding]{},
        ownership: MIROwnershipMode.Owned,
        boxed_edges: [String]{},
        compiler_builtin: None,
        kind: kind,
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs::compiler_owned_parse_error
// The compiler-owned `ParseError` (the error of `Int.parse`, `String.to_int`,
// `Float.parse`, ...) is a public alias of String under the shared Prelude
// spelling, so the emitter declares `type __jet_ParseError = String`.
fn jet_codegen_parse_error_alias_definition(module_identity: String) -> MIRTypeDef {
    return MIRTypeDef{
        id: mir_type_id(JET_CODEGEN_PARSE_ERROR_ALIAS),
        module_id: mir_module_id(module_identity),
        key: JET_CODEGEN_PARSE_ERROR_ALIAS,
        name: JET_CODEGEN_PARSE_ERROR_ALIAS,
        span: Span{start: 0, end: 0},
        public: true,
        package_public: false,
        generic_params: [MIRGenericParam]{},
        derives: [MIRTraitID]{},
        auto_derive_default: false,
        auto_printable: false,
        published_schema: false,
        single_use: false,
        must_use: false,
        layout: None,
        c_layout_tag: None,
        enum_layout: None,
        layout_alignment: None,
        cli: None,
        serde: [MIRSerdeAttribute]{},
        cli_bindings: [MIRCLIBinding]{},
        ownership: MIROwnershipMode.Owned,
        boxed_edges: [String]{},
        compiler_builtin: None,
        kind: MIRTypeDefKind.Alias{target: jet_codegen_lower_type(Type.String)},
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::lower_anonymous_union_type_defs
fn jet_codegen_register_synthetic_unions(types: &[MIRTypeDef], functions: [MIRFunction], nested_functions: [MIRFunction]) {
    unions := JetCodegenUnionIndex{rows: [MIRType]{}, positions: [U64:Int]{}, canonical_keys: [String]{}}
    loop function in functions -> jet_codegen_collect_unions_from_function(function, &unions)
    loop function in nested_functions -> jet_codegen_collect_unions_from_function(function, &unions)
    loop definition in types -> jet_codegen_collect_unions_from_type_definition(definition, &unions)
    if unions.rows.len() == 0 -> return
    module_id := if functions.len() > 0 -> functions[0].module_id else -> if nested_functions.len() > 0 -> nested_functions[0].module_id else -> if types.len() > 0 -> types[0].module_id else -> panic("structural union has no owning MIR module")
    definitions := [U64:Bool]{}
    loop definition in types -> _ := &definitions.add(definition.id.value, true)
    loop union_type in unions.rows {
        identity :: union_type.identity ?? panic("checked structural union has no MIR identity")
        if definitions.get(identity.value) == None {
            &types.push(jet_codegen_synthetic_union_definition(union_type, module_id))
            _ := &definitions.add(identity.value, true)
        }
    }
}


fn jet_codegen_sort_trait_definitions(rows: &[MIRTraitDef]) Never! {
    keys := [U64]{}
    loop index in 0..<rows.len() -> &keys.push(rows[index].id.value)
    compiler_apply_order<MIRTraitDef>(&rows, jet_codegen_sorted_order(keys, [String]{}))
}

fn jet_codegen_sort_impl_definitions(rows: &[MIRImplDef]) Never! {
    keys := [U64]{}
    loop index in 0..<rows.len() -> &keys.push(rows[index].id.value)
    compiler_apply_order<MIRImplDef>(&rows, jet_codegen_sorted_order(keys, [String]{}))
}

fn jet_codegen_sort_constant_definitions(rows: &[MIRConstantDef]) Never! {
    keys := [U64]{}
    loop index in 0..<rows.len() -> &keys.push(rows[index].id.value)
    compiler_apply_order<MIRConstantDef>(&rows, jet_codegen_sorted_order(keys, [String]{}))
}

fn jet_codegen_sort_field_rows(rows: &[MIRFieldRow]) Never! {
    keys := [U64]{}
    loop index in 0..<rows.len() -> &keys.push(rows[index].id.value)
    compiler_apply_order<MIRFieldRow>(&rows, jet_codegen_sorted_order(keys, [String]{}))
}

fn jet_codegen_sort_core_calls(rows: &[MIRCoreCall]) Never! {
    keys := [U64]{}
    ties := [String]{}
    loop index in 0..<rows.len() {
        &keys.push(rows[index].id.value)
        &ties.push(rows[index].key)
    }
    compiler_apply_order<MIRCoreCall>(&rows, jet_codegen_sorted_order(keys, ties))
}

fn jet_codegen_sort_prelude_calls(rows: &[MIRPreludeCall]) Never! {
    keys := [U64]{}
    loop index in 0..<rows.len() -> &keys.push(rows[index].id.value)
    compiler_apply_order<MIRPreludeCall>(&rows, jet_codegen_sorted_order(keys, [String]{}))
}

fn jet_codegen_sort_used_core(rows: &[String]) Never! {
    order :: jet_codegen_sorted_order([U64]{}, rows)
    compiler_apply_order<String>(&rows, order)
}

fn jet_codegen_add_needed_trait(reference: MIRTraitRef, known: [MIRTraitID], needed: &[MIRTraitRef]) Never! {
    loop id in known {
        if id == reference.id -> return
    }
    loop prior in needed {
        if prior.id == reference.id -> return
    }
    native_name := jet_codegen_native_rust_derive_name_for_id(reference.id)
    if native_name != None {
        expected :: native_name ?? panic("native derive identity disappeared")
        if reference.name != expected -> panic("native derive reference name disagrees with its canonical identity")
        return
    }
    compiler_owned_name := jet_codegen_compiler_owned_trait_name_for_id(reference.id)
    if compiler_owned_name != None {
        expected :: compiler_owned_name ?? panic("compiler-owned trait identity disappeared")
        if reference.name != expected -> panic("compiler-owned trait reference name disagrees with its canonical identity")
        &needed.push(MIRTraitRef{id: reference.id, name: expected})
        return
    }
    if jet_codegen_is_checked_text_trait_id(reference.id) {
        if reference.name != "CheckedText" -> panic("CheckedText reference name disagrees with its canonical identity")
        return
    }
    // Rust mir.rs::ensure_referenced_traits: any other referenced trait
    // without a declaration (a builtin bound such as `Numeric`) gets a
    // synthesized row under its reference name.
    &needed.push(reference)
}

fn jet_codegen_add_needed_derived_trait(id: MIRTraitID, known: [MIRTraitID], needed: &[MIRTraitRef]) Never! {
    loop known_id in known {
        if known_id == id -> return
    }
    if jet_codegen_native_rust_derive_name_for_id(id) != None -> return
    compiler_owned_name := jet_codegen_compiler_owned_trait_name_for_id(id)
    if compiler_owned_name != None {
        name :: compiler_owned_name ?? panic("compiler-owned derive identity disappeared")
        jet_codegen_add_needed_trait(MIRTraitRef{id: id, name: name}, known, &needed)
        return
    }
    if jet_codegen_is_checked_text_trait_id(id) -> return
    // Rust mir.rs::ensure_referenced_traits: a derive with a selected impl but
    // no declaration gets a synthesized `derive#<id>` row.
    loop prior in needed {
        if prior.id == id -> return
    }
    &needed.push(MIRTraitRef{id: id, name: "derive#{id.value}"})
}

fn jet_codegen_synthesized_trait_associated_types(name: String) -> [MIRAssociatedTypeDecl] Never! {
    names := [String]{}
    if name == "Iterator" -> &names.push("Item")
    if name == "Iterable" -> &names.push("Iter")
    if name == "Index" {
        &names.push("Key")
        &names.push("Value")
    }
    if name == "Rollback" -> &names.push("Snapshot")
    associated := [MIRAssociatedTypeDecl]{}
    loop value in names -> &associated.push(MIRAssociatedTypeDecl{name: value, span: Span{start: 0, end: 0}})
    associated
}

// Rust `ensure_builtin_debug_trait`: an automatic or written `Debug` derive
// names the compiler-owned Debug trait, which no module declares. Its row
// joins the program once (in the module of the first type deriving it), so
// the Rust printer's derive lookup selects the structural `JetDebug` impl.
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs::ensure_builtin_debug_trait
fn jet_codegen_ensure_builtin_debug_trait(traits: &[MIRTraitDef], types: [MIRTypeDef]) Never! {
    debug_id :: mir_trait_id("Debug")
    module_id := MIRModuleID?{None}
    loop definition in types {
        if module_id != None -> break
        loop derived in definition.derives {
            if derived == debug_id -> module_id = Val(definition.module_id)
        }
    }
    owner :: module_id ?? return
    loop definition in traits {
        if definition.name == "Debug" -> return
    }
    &traits.push(MIRTraitDef{
        id: debug_id,
        module_id: owner,
        key: "Debug",
        name: "Debug",
        span: Span{start: 0, end: 0},
        visibility: MIRVisibility.Public,
        associated_types: [MIRAssociatedTypeDecl]{},
        methods: [MIRTraitMethod]{},
    })
}

// Trait-object bounds in callable/value types retain their declaration rows.
fn jet_codegen_collect_type_traits(ty: MIRType, known: [MIRTraitID], needed: &[MIRTraitRef]) Never! {
    if ty.kind == {
        .TraitObject(bounds) -> loop bound in bounds -> jet_codegen_add_needed_trait(bound, known, &needed)
        .Union(members) | .Apply(_, members) -> loop member in members -> jet_codegen_collect_type_traits(member, known, &needed)
        .List(inner) | .Shared(inner) | .Option(inner) | .FixedList(inner, _) | .InlineRange(inner, _, _) | .Tagged(_, inner) | .Quantity(inner, _) -> jet_codegen_collect_type_traits(inner, known, &needed)
        .Map(key, value) | .Result(key, value) -> {
            jet_codegen_collect_type_traits(key, known, &needed)
            jet_codegen_collect_type_traits(value, known, &needed)
        }
        .Fn(signature) -> {
            loop parameter in signature.params -> jet_codegen_collect_type_traits(parameter, known, &needed)
            if signature.ret == .Val(ret) -> jet_codegen_collect_type_traits(ret, known, &needed)
        }
        .SendFn(params, ret, _) -> {
            loop parameter in params -> jet_codegen_collect_type_traits(parameter, known, &needed)
            if ret == .Val(value) -> jet_codegen_collect_type_traits(value, known, &needed)
        }
        .Tuple(fields) -> loop field in fields -> jet_codegen_collect_type_traits(field.ty, known, &needed)
        else -> {}
    }
}

fn jet_codegen_ensure_referenced_traits(traits: &[MIRTraitDef], impls: [MIRImplDef], functions: [MIRFunction], nested_functions: [MIRFunction], types: [MIRTypeDef]) Never! {
    known := [MIRTraitID]{}
    needed := [MIRTraitRef]{}
    loop definition in traits -> &known.push(definition.id)
    loop implementation in impls {
        if implementation.trait_ref == {
            None -> {}
            Val(reference) -> jet_codegen_add_needed_trait(reference, known, &needed)
        }
    }
    jet_codegen_collect_function_traits(functions, known, &needed)
    jet_codegen_collect_function_traits(nested_functions, known, &needed)
    loop definition in types {
        loop derived_trait in definition.derives -> jet_codegen_add_needed_derived_trait(derived_trait, known, &needed)
        loop parameter in definition.generic_params {
            loop bound in parameter.bounds -> jet_codegen_add_needed_trait(bound, known, &needed)
        }
        if definition.kind == {
            .Struct(fields, _) -> loop field in fields -> jet_codegen_collect_type_traits(field.ty, known, &needed)
            .Enum(variants, _) -> loop variant in variants {
                if variant.payload == {
                    .Single(value) -> jet_codegen_collect_type_traits(value, known, &needed)
                    .Named(fields) -> loop field in fields -> jet_codegen_collect_type_traits(field.ty, known, &needed)
                    .Unit -> {}
                }
            }
            .Distinct(base, _) | .Alias(base) -> jet_codegen_collect_type_traits(base, known, &needed)
            .UnitFamily(_) -> {}
        }
    }
    module_id := mir_module_id("compiler")
    if traits.len() > 0 -> module_id = traits[0].module_id
    if traits.len() == 0 && impls.len() > 0 -> module_id = impls[0].module_id
    if traits.len() == 0 && impls.len() == 0 && functions.len() > 0 -> module_id = functions[0].module_id
    if traits.len() == 0 && impls.len() == 0 && functions.len() == 0 && nested_functions.len() > 0 -> module_id = nested_functions[0].module_id
    loop reference in needed {
        // Compiler-owned traits keep their canonical name; any other
        // reference keeps its own (Rust ensure_referenced_traits).
        name := reference.name
        if jet_codegen_compiler_owned_trait_name_for_id(reference.id) == .Val(owned) {
            if reference.name != owned -> panic("synthesized trait name disagrees with its canonical identity")
            name = owned
        }
        &traits.push(MIRTraitDef{
            id: reference.id,
            module_id: module_id,
            key: name,
            name: name,
            span: Span{start: 0, end: 0},
            visibility: MIRVisibility.Public,
            associated_types: jet_codegen_synthesized_trait_associated_types(name),
            methods: [MIRTraitMethod]{},
        })
    }
}

fn jet_codegen_collect_function_traits(functions: [MIRFunction], known: [MIRTraitID], needed: &[MIRTraitRef]) Never! {
    loop function in functions {
        if function.form == {
            .TraitMethod(_, reference, _, _) -> jet_codegen_add_needed_trait(reference, known, &needed)
            else -> {}
        }
        loop parameter in function.generic_params {
            loop bound in parameter.bounds -> jet_codegen_add_needed_trait(bound, known, &needed)
        }
        jet_codegen_collect_type_traits(function.return_type, known, &needed)
        if function.declared_return == .Val(ret) -> jet_codegen_collect_type_traits(ret, known, &needed)
        loop parameter in function.params -> jet_codegen_collect_type_traits(parameter.ty, known, &needed)
        loop capture in function.capture_params -> jet_codegen_collect_type_traits(capture.ty, known, &needed)
        loop local in function.locals -> jet_codegen_collect_type_traits(local.ty, known, &needed)
        loop value in function.values -> jet_codegen_collect_type_traits(value.ty, known, &needed)
        loop place in function.places -> jet_codegen_collect_type_traits(place.ty, known, &needed)
        loop block in function.blocks {
            loop instruction in block.instructions {
                if instruction.ty == .Val(ty) -> jet_codegen_collect_type_traits(ty, known, &needed)
            }
        }
    }
}
fn jet_codegen_canonical_target_type(module_identity: String, name: String) -> String Never! {
    text := name.trim()
    if module_identity == "" -> return text
    prefix := "{module_identity}::"
    if text.starts_with(prefix) {
        remainder := text
        prefix_length := prefix.bytes().len()
        loop remainder.starts_with(prefix) {
            remainder = String.from_bytes(remainder.bytes()[prefix_length..<remainder.bytes().len()]) ?? remainder
        }
        return "{prefix}{remainder}"
    }
    if text.contains("::") || text.contains(".") -> return text
    "{prefix}{text}"
}

fn jet_codegen_plain_impl_owner(owner: MIRType) -> Bool Never! {
    if owner.kind == {
        .Int -> true
        .Float -> true
        .Float32 -> true
        .Bool -> true
        .String -> true
        .Char -> true
        .IntN(_, _) -> true
        .Apply(_, args) -> args.len() == 0
        else -> false
    }
}

fn jet_codegen_canonical_impl_key(module_identity: String, owner: MIRType, trait_ref: MIRTraitRef?) -> String {
    qualified_display := jet_codegen_canonical_target_type(module_identity, mir_type_display_name(owner))
    owner_display := qualified_display
    if module_identity != "" {
        prefix := "{module_identity}::"
        if owner_display.starts_with(prefix) -> owner_display = String.from_bytes(owner_display.bytes()[prefix.bytes().len()..<owner_display.bytes().len()]) ?? owner_display
    }
    if !jet_codegen_plain_impl_owner(owner) && mir_type_canonical_key(owner) != qualified_display -> owner_display = "{owner_display}__instance__{mir_type_canonical_key(owner)}"
    key := if module_identity == "" -> owner_display else -> "{module_identity}::{owner_display}"
    if trait_ref == {
        None -> {}
        Val(reference) -> key = "{key}::{reference.name}"
    }
    key
}

struct JetCodegenImplOwnerIndex {
    identities: [String:Int]
    heads: [String:Int]
    tails: [String:Int]
    next_rows: [Int]
    fallback_heads: [String:Int]
    fallback_tails: [String:Int]
    next_fallback_rows: [Int]
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::find_impl_index
fn jet_codegen_impl_owner_prefix(module_id: MIRModuleID, trait_ref: MIRTraitRef?) -> String Never! {
    trait_key := if trait_ref == {
        None -> "none"
        Val(reference) -> "{reference.id.value}:{reference.name.len()}:{reference.name}"
    }
    "{module_id.value}:{trait_key.len()}:{trait_key}:"
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::find_impl_index
// Identityless owners need ordered (module, trait) candidates: checked-type
// equality can erase tags or equate differently-spelled nested identities.
fn jet_codegen_index_impl_owner(index: &JetCodegenImplOwnerIndex, implementation: MIRImplDef, row: Int) Never! {
    bucket := jet_codegen_impl_owner_prefix(implementation.module_id, implementation.trait_ref)
    &index.next_rows.push(-1)
    &index.next_fallback_rows.push(-1)
    if index.tails.get(bucket) == .Val(tail) -> index.next_rows[tail] = row else -> _ := &index.heads.add(bucket, row)
    _ := &index.tails.add(bucket, row)
    if implementation.self_type.identity == .Val(identity) {
        key := "{bucket}id:{identity.value}"
        if index.identities.get(key) == None -> _ := &index.identities.add(key, row)
    } else {
        if index.fallback_tails.get(bucket) == .Val(tail) -> index.next_fallback_rows[tail] = row else -> _ := &index.fallback_heads.add(bucket, row)
        _ := &index.fallback_tails.add(bucket, row)
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::find_impl_index
fn jet_codegen_find_indexed_impl(index: JetCodegenImplOwnerIndex, impls: [MIRImplDef], owner: MIRType, trait_ref: MIRTraitRef?, module_id: MIRModuleID) -> Int? Never! {
    bucket := jet_codegen_impl_owner_prefix(module_id, trait_ref)
    first := Int?{None}
    row := index.heads.get(bucket) ?? -1
    if owner.identity == .Val(identity) {
        first = index.identities.get("{bucket}id:{identity.value}")
        row = index.fallback_heads.get(bucket) ?? -1
    }
    loop row >= 0 {
        if first == .Val(position) {
            if row >= position -> break
        }
        if mir_type_same_checked_type(impls[row].self_type, owner) -> return Val(row)
        row = if owner.identity != None -> index.next_fallback_rows[row] else -> index.next_rows[row]
    }
    first
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::retain_selected_derives.
// A type keeps a derive only when it is a native Rust derive or an impl row of
// that trait for that type joined the program. An unreached Core
// `Equatable`/`Comparable` derive has no kept method
// (`jet_codegen_reachable_core_rows`), so `jet_codegen_lower_impl_definition`
// drops its impl row; its derive request goes with it instead of reaching the
// emitter without a selected implementation. Self types match as in the
// emitter's `jet_rust_emit_derived_impl_matches_type` (identity, or the head
// of an applied nominal).
fn jet_codegen_retain_selected_derives(types: &[MIRTypeDef], impls: [MIRImplDef]) Never! {
    selected := [String:Bool]{}
    loop implementation in impls {
        trait_ref :: implementation.trait_ref ?? next
        if implementation.self_type.identity == .Val(self_id) -> selected["{trait_ref.id.value}:{self_id.value}"] = true
        if implementation.self_type.kind == .Apply(name, _) -> selected["{trait_ref.id.value}:{name.id.value}"] = true
    }
    native := jet_codegen_native_rust_derive_ids()
    loop index in 0..<types.len() {
        derives :: types[index].derives
        if derives.len() == 0 -> next
        type_id :: types[index].id
        kept := [MIRTraitID]{}
        loop trait_id in derives {
            if native.get(trait_id.value) != None || selected.get("{trait_id.value}:{type_id.value}") != None -> &kept.push(trait_id)
        }
        if kept.len() != derives.len() -> types[index].derives = kept
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::attach_orphan_methods
fn jet_codegen_attach_orphan_methods(impls: &[MIRImplDef], functions: [MIRFunction], nested_functions: [MIRFunction], source_functions: [TFunc]) {
    // Every function id some impl already lists, kept current as orphans are
    // attached (instead of rescanning every impl's methods per function).
    owned := [U64:Bool]{}
    source_rows := [U64:Int]{}
    loop row in 0..<source_functions.len() {
        id := jet_codegen_function_id(source_functions[row])
        if source_rows.get(id.value) == None -> _ := &source_rows.add(id.value, row)
    }
    owner_index := JetCodegenImplOwnerIndex{identities: [String:Int]{}, heads: [String:Int]{}, tails: [String:Int]{}, next_rows: [Int]{}, fallback_heads: [String:Int]{}, fallback_tails: [String:Int]{}, next_fallback_rows: [Int]{}}
    loop row in 0..<impls.len() -> jet_codegen_index_impl_owner(&owner_index, impls[row], row)
    loop implementation in impls {
        loop method in implementation.methods -> _ := &owned.add(method.value, true)
    }
    jet_codegen_attach_orphan_rows(&impls, functions, source_functions, source_rows, &owned, &owner_index)
    jet_codegen_attach_orphan_rows(&impls, nested_functions, source_functions, source_rows, &owned, &owner_index)
}

fn jet_codegen_attach_orphan_rows(impls: &[MIRImplDef], functions: [MIRFunction], source_functions: [TFunc], source_rows: [U64:Int], owned: &[U64:Bool], owner_index: &JetCodegenImplOwnerIndex) {
    loop function in functions {
        if function.form == {
            .TopLevel -> next
            else -> {}
        }
        if owned.get(function.id.value) != None -> next
        owner := MIRType?{None}
        trait_ref := MIRTraitRef?{None}
        skip := false
        if function.form == {
            .Method(value, _) -> owner = Val(value)
            .TraitMethod(value, reference, _, serde) -> {
                owner = Val(value)
                trait_ref = Val(reference)
                if serde != None -> skip = true
            }
            .TopLevel -> {}
        }
        if skip -> next
        owner_type :: owner ?? panic("lowered method has no checked owner type")
        source_row :: source_rows.get(function.id.value) ?? panic("lowered method has no checked TFunc identity")
        module_identity := source_functions[source_row].module_identity
        matching_impl := jet_codegen_find_indexed_impl(owner_index, impls, owner_type, trait_ref, function.module_id)
        if matching_impl != None {
            impl_index :: matching_impl ?? panic("matching implementation index disappeared")
            &impls[impl_index].methods.push(function.id)
            _ := &owned.add(function.id.value, true)
            next
        }
        key := jet_codegen_canonical_impl_key(module_identity, owner_type, trait_ref)
        _ := &owned.add(function.id.value, true)
        &impls.push(MIRImplDef{
            id: MIRImplID{value: stable_id("mir-impl", key)},
            module_id: function.module_id,
            key: key,
            span: function.span,
            self_type: owner_type,
            trait_ref: trait_ref,
            associated_types: [MIRAssociatedTypeValue]{},
            methods: [MIRFunctionID]{function.id},
            delegation: None,
            compiler_generated: false,
            serde: None,
            operator_marker: None,
            operator_rhs: None,
            target_os: None,
            target_applicability: MIRTargetApplicability{rust_aot: true, interpreter: true, web: true},
        })
        jet_codegen_index_impl_owner(&owner_index, impls[impls.len() - 1], impls.len() - 1)
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/functions.rs::lower_trait_method_inner
// lowers every trait-block method as a trait method. Sema checks a struct or
// enum body's trait-block methods (derived ones included) as owner methods,
// so the trait impl row that lists one supplies its trait form and codec.
fn jet_codegen_bind_trait_impl_forms(functions: &[MIRFunction], impls: [MIRImplDef]) Never! {
    rows := [U64:Int]{}
    loop row in 0..<functions.len() {
        if rows.get(functions[row].id.value) == None -> _ := &rows.add(functions[row].id.value, row)
    }
    loop implementation in impls {
        trait_ref :: implementation.trait_ref ?? next
        loop method in implementation.methods {
            row :: rows.get(method.value) ?? next
            if functions[row].form == .Method(owner, self_access) {
                functions[row].form = MIRFunctionForm.TraitMethod{owner: owner, trait_ref: trait_ref, self_access: self_access, serde: implementation.serde}
            }
        }
    }
}

fn jet_codegen_sort_core_owners(rows: &[MIRCoreOwner]) Never! {
    &rows.sort_by((left: MIRCoreOwner, right: MIRCoreOwner) -> if left.id.value != right.id.value -> left.id.value <=> right.id.value else -> left.key <=> right.key)
}

fn jet_codegen_lower_core_builtin_owner(owner: TCoreBuiltinOwner, module_info: SemaGraphModuleResult) -> MIRCoreOwner Never! {
    if owner.name == "" || owner.symbol.key == "" -> panic("checked Core builtin owner has an empty canonical identity")
    key := owner.symbol.key
    module_id := MIRModuleID?{None}
    if owner.module_identity != None {
        identity :: owner.module_identity ?? panic("checked Core builtin owner module disappeared")
        if identity != module_info.module_identity -> panic("checked Core builtin owner has a module linkage mismatch")
        module_id = Val(mir_module_id(identity))
    }
    ownership := jet_codegen_lower_declaration_ownership_mode(owner.ownership)
    if ownership != MIROwnershipMode.Owned && ownership != MIROwnershipMode.Move -> panic("checked Core builtin owner is not owned")
    MIRCoreOwner{
        id: mir_type_id(key),
        nominal_id: mir_nominal_ref(owner.name).id,
        module_id: module_id,
        key: key,
        name: owner.name,
        ownership: ownership,
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::lower_impl_rows
// The checked `functions` and `modules` move into the one program that every
// function lowers against and back out when lowering ends, so the caller
// keeps them and the checked program is never resident twice. With more than
// one admitted thread (jet_codegen_lower_threads) the program moves into the
// threads' shared slot for the lowering and back out after it.
fn lower_functions(functions: &[TFunc], modules: &[SemaGraphModuleResult], source_files: [MIRSourceFile], threads: CompilerThreads, trace_sink: CompilerTraceSink?, native_stop_points: Bool, edition: String) -> JetCodegenFunctions {
    if functions.len() == 0 {
        constants := jet_codegen_lower_constant_rows(modules)
        empty_index := jet_codegen_function_index([TFunc]{})
        types := jet_codegen_declared_type_rows(empty_index, modules)
        no_rows := [JetCodegenLoweredFunction]{}
        return jet_codegen_functions_from_rows(^no_rows, functions, empty_index, modules, jet_codegen_trait_names(modules), ^types, ^constants)
    }
    rows := [TFunc]{}
    compiler_transfer_rows<TFunc>(&rows, &functions)
    program_modules := [SemaGraphModuleResult]{}
    compiler_transfer_rows<SemaGraphModuleResult>(&program_modules, &modules)
    function_index := jet_codegen_function_index(^rows)
    field_symbols := jet_codegen_field_symbol_index(program_modules)
    source_index := jet_codegen_source_index(source_files)
    program := jet_codegen_new_program(^function_index, ^program_modules, ^field_symbols, source_files, ^source_index, edition)
    // Select before threaded and closure lowering share this program.
    program.stop_points = native_stop_points
    lowered_rows := [JetCodegenLoweredFunction]{}
    weights :: jet_codegen_lower_weights(program)
    // Capture follows the real per-function lowering order, never thread
    // completion order. Ordinary compiles keep the existing parallel waves.
    capture_passes :: if program.canonical_journal == { .Val(_) -> true None -> false }
    workers :: if capture_passes -> 1 else -> jet_codegen_lower_threads(weights, threads, trace_sink)
    if workers > 1 {
        bounds :: compiler_threads_partition(weights, workers)
        slot :: shared JetCodegenProgramSlot{programs: [JetCodegenProgram]{}}
        jet_codegen_program_slot_fill(slot, ^program)
        lowered_rows = jet_codegen_lower_in_parts(slot, bounds, workers)
        program = jet_codegen_program_slot_take(slot)
    } else {
        builder := jet_codegen_new_builder(program.function_index.rows[0], program)
        lowered_rows = jet_codegen_lower_indexed_functions(&builder, program, trace_sink)
    }
    constants := jet_codegen_lower_constant_rows(program.modules)
    types := jet_codegen_declared_type_rows(program.function_index, program.modules)
    lowered := jet_codegen_functions_from_rows(lowered_rows, program.function_index.rows, program.function_index, program.modules, jet_codegen_trait_names(program.modules), ^types, ^constants)
    compiler_transfer_rows<TFunc>(&functions, &program.function_index.rows)
    compiler_transfer_rows<SemaGraphModuleResult>(&modules, &program.modules)
    lowered
}


// A compiler thread is admitted for at least this many bytes of function
// source, so a small program lowers on the calling thread.
JET_CODEGEN_LOWER_MIN_BYTES_PER_THREAD :: 65536

// The threads that lower functions of these source `weights`: one under a
// per-function trace (its spans time each function in order), else as many
// as `threads` admits for their source bytes.
fn jet_codegen_lower_threads(weights: [Int], threads: CompilerThreads, trace_sink: CompilerTraceSink?) -> Int {
    if trace_sink == .Val(sink) {
        if sink.functions() -> return 1
    }
    work := 0
    loop index in 0..<weights.len() -> work += weights[index]
    compiler_threads_admit(threads, weights.len(), work, JET_CODEGEN_LOWER_MIN_BYTES_PER_THREAD, 0, 0)
}

// Each function row's source bytes, in row order.
fn jet_codegen_lower_weights(program: JetCodegenProgram) -> [Int] {
    weights := [Int]{}
    loop index in 0..<program.function_index.rows.len() {
        span :: program.function_index.rows[index].source_span
        &weights.push(span.end - span.start)
    }
    weights
}

// The program while compiler threads lower against it: moved in as the one
// row of `programs` and moved back out after, so it is never copied.
struct JetCodegenProgramSlot {
    programs: [JetCodegenProgram]
}

fn jet_codegen_program_slot_fill(slot: Shared<JetCodegenProgramSlot>, program: ^JetCodegenProgram) {
    permit :: slot.guard_edit()
    &permit.value.programs.push(^program)
}

fn jet_codegen_program_slot_take(slot: Shared<JetCodegenProgramSlot>) -> JetCodegenProgram {
    permit :: slot.guard_edit()
    &permit.value.programs.pop() ?? panic("the lowering program left the threads' shared slot")
}

// One thread's consecutive function rows [first, last) and their lowerings.
struct JetCodegenLowerPart {
    first: Int
    last: Int
    rows: [JetCodegenLoweredFunction]
}

// Lowers the program in `slot` on `workers` threads: the consecutive parts of
// its function rows `bounds` cuts (compiler_threads_partition), each on its
// own builder, joined in part order. A function's lowering reads only the
// program and its own builder state (jet_codegen_begin_function resets every
// per-function field), so the rows are those one builder lowers in order.
fn jet_codegen_lower_in_parts(slot: Shared<JetCodegenProgramSlot>, bounds: [Int], workers: Int) -> [JetCodegenLoweredFunction] {
    parts := [Shared<JetCodegenLowerPart>]{}
    loop part in 0..<workers {
        row :: shared JetCodegenLowerPart{first: bounds[part], last: bounds[part + 1], rows: [JetCodegenLoweredFunction]{}}
        &parts.push(row)
    }
    _ := jet_codegen_lower_parts(slot, parts, 0)
    reversed := [JetCodegenLoweredFunction]{}
    part := workers
    loop part > 0 {
        part -= 1
        jet_codegen_lower_part_drain(parts[part], &reversed)
    }
    lowered_rows := [JetCodegenLoweredFunction]{}
    loop reversed.len() > 0 {
        lowered := &reversed.pop() ?? { break }
        &lowered_rows.push(^lowered)
    }
    lowered_rows
}

// Moves a part's lowerings onto `reversed`, last first.
fn jet_codegen_lower_part_drain(part: Shared<JetCodegenLowerPart>, reversed: &[JetCodegenLoweredFunction]) {
    permit :: part.guard_edit()
    loop permit.value.rows.len() > 0 {
        lowered :: &permit.value.rows.pop() ?? break
        &reversed.push(lowered)
    }
}

// Lowers `parts[from..]`, one task per part and the last part on this thread;
// returns how many functions they lowered.
fn jet_codegen_lower_parts(slot: Shared<JetCodegenProgramSlot>, parts: [Shared<JetCodegenLowerPart>], from: Int) -> Int {
    if from >= parts.len() - 1 -> return jet_codegen_lower_part(slot, parts[from])
    lowered := 0
    task.group lower_threads {
        head :: task jet_codegen_lower_part(slot, parts[from])
        lowered = jet_codegen_lower_parts(slot, parts, from + 1)
        lowered += head.join() ?? panic(compiler_threads_failure_text(err))
    }
    lowered
}

// One thread: lowers its part's rows in order on its own builder.
fn jet_codegen_lower_part(slot: Shared<JetCodegenProgramSlot>, part: Shared<JetCodegenLowerPart>) -> Int {
    inputs :: slot.guard_read()
    permit := part.guard_edit()
    // Passed straight through: a local binding of the guarded program would copy it.
    jet_codegen_lower_part_rows(inputs.value.programs[0], &permit.value)
}

fn jet_codegen_lower_part_rows(program: JetCodegenProgram, part: &JetCodegenLowerPart) -> Int {
    if part.first >= part.last -> return 0
    builder := jet_codegen_new_builder(program.function_index.rows[part.first], program)
    loop position in part.first..<part.last {
        &part.rows.push(jet_codegen_lower_function(&builder, program, program.function_index.rows[position], program.function_index.rows[position].body, None, None))
    }
    part.last - part.first
}

// Lowers every row of the program's function index, in order, on `builder`.
// Each row is read in place: the program, which owns the rows, is read-only
// while functions lower.
fn jet_codegen_lower_indexed_functions(builder: &JetCodegenBuilder, program: JetCodegenProgram, trace_sink: CompilerTraceSink?) -> [JetCodegenLoweredFunction] {
    lowered_rows := [JetCodegenLoweredFunction]{}
    trace_functions := false
    if trace_sink == .Val(sink) -> trace_functions = sink.functions()
    count :: program.function_index.rows.len()
    loop position in 0..<count {
        if trace_sink == .Val(sink) -> sink.progress("lower", position, count)
        if trace_functions {
            if trace_sink == .Val(sink) -> sink.begin("lower.function", program.function_index.rows[position].name, position, count)
        }
        &lowered_rows.push(jet_codegen_lower_function(&builder, program, program.function_index.rows[position], program.function_index.rows[position].body, None, None))
        if trace_functions {
            if trace_sink == .Val(sink) -> sink.end("lower.function", 1)
        }
    }
    if trace_sink == .Val(sink) {
        sink.progress("counters.lower.functions_scanned", count, -1)
        sink.progress("counters.lower.functions_lowered", lowered_rows.len(), -1)
    }
    lowered_rows
}

// Lowers each of `functions` (a comptime closure), in order, on one builder.
fn jet_codegen_lower_each_function(builder: &JetCodegenBuilder, program: JetCodegenProgram, functions: [TFunc], trace_sink: CompilerTraceSink?) -> [JetCodegenLoweredFunction] {
    lowered_rows := [JetCodegenLoweredFunction]{}
    trace_functions := false
    if trace_sink == .Val(sink) -> trace_functions = sink.functions()
    loop (position, function) in functions {
        if trace_sink == .Val(sink) -> sink.progress("lower", position, functions.len())
        if trace_functions {
            if trace_sink == .Val(sink) -> sink.begin("lower.function", function.name, position, functions.len())
        }
        &lowered_rows.push(jet_codegen_lower_function(&builder, program, function, function.body, None, None))
        if trace_functions {
            if trace_sink == .Val(sink) -> sink.end("lower.function", 1)
        }
    }
    if trace_sink == .Val(sink) {
        sink.progress("counters.lower.functions_scanned", functions.len(), -1)
        sink.progress("counters.lower.functions_lowered", lowered_rows.len(), -1)
    }
    lowered_rows
}

// One declared type row of a program, in program order: the definition's row,
// or None for a comptime session's definition with a CLI entry or binding,
// whose function IDs only a closure can lower. `module_index` and
// `definition_index` place a declared definition in its modules (-1 for a
// compiler-owned row).
struct JetCodegenTypeSlot {
    row: MIRTypeDef?
    module_index: Int
    definition_index: Int
}

// Rust `collect_items`: every module's type rows, then the compiler-owned rows
// of compiler_owned_type_defs (the runtime enums, the plain Core enums no
// loaded source declares, `FieldError`, `Range`, the carrier records, the Core
// records and the math records), each unless a row already owns its canonical
// key, then the compiler-owned `ParseError` alias. With `defer_cli`, a
// definition with a CLI entry or binding keeps no row. A plain Core enum row
// also stays out when a program declaration (outside `<corelib>/`) spells its
// leaf: declared keys are module-qualified, so the key check never sees it,
// and the bootstrap host codec resolves enum owners by leaf name, so a second
// `Effect` row shadows the compiler's own `Effect` (every variant missing).
fn jet_codegen_declared_type_slots(function_index: JetCodegenFunctionIndex, modules: [SemaGraphModuleResult], closure_only: Bool, defer_cli: Bool) -> [JetCodegenTypeSlot] {
    slots := [JetCodegenTypeSlot]{}
    declared_keys := [String:Bool]{}
    program_type_names := [String:Bool]{}
    parse_error_declared := false
    loop module_index in 0..<modules.len() {
        loop definition_index in 0..<modules[module_index].declarations.type_defs.len() {
            definition :: modules[module_index].declarations.type_defs[definition_index]
            declared_keys[definition.key] = true
            if !definition.key.starts_with("<corelib>/") -> program_type_names[definition.name] = true
            if definition.key == JET_CODEGEN_PARSE_ERROR_ALIAS -> parse_error_declared = true
            row := MIRTypeDef?{None}
            if !defer_cli || (definition.cli == None && definition.cli_bindings.len() == 0) -> row = Val(jet_codegen_lower_type_definition(definition, function_index, modules, closure_only))
            &slots.push(JetCodegenTypeSlot{row: ^row, module_index: module_index, definition_index: definition_index})
        }
    }
    if modules.len() > 0 {
        record_module :: modules[0].module_identity
        loop row in JET_CODEGEN_COMPILER_OWNED_ENUMS {
            if declared_keys.get(row.name) != None -> next
            declared_keys[row.name] = true
            &slots.push(JetCodegenTypeSlot{row: Val(jet_codegen_compiler_owned_enum_definition(record_module, row.name, row.variants, false)), module_index: -1, definition_index: -1})
        }
        // Rust compiler_owned_core_enums less discard_duplicate_core_enum_fallbacks:
        // a Core enum leaf whose one loaded source declaration owns its identity
        // keeps no plain row.
        source_enum_counts := jet_codegen_core_source_enum_counts(modules)
        loop core_row in CORE_ENUM_ROWS {
            if declared_keys.get(core_row.name) != None || program_type_names.get(core_row.name) != None -> next
            if (source_enum_counts.get(core_row.name) ?? 0) == 1 -> next
            if core_row.kind == .Enum(variants) {
                declared_keys[core_row.name] = true
                &slots.push(JetCodegenTypeSlot{row: Val(jet_codegen_compiler_owned_enum_definition(record_module, core_row.name, variants, true)), module_index: -1, definition_index: -1})
            }
        }
        record_names := [String]{"FieldError", JET_CODEGEN_RANGE_RECORD}
        loop name in JET_CODEGEN_COMPILER_OWNED_CARRIER_RECORDS -> &record_names.push(name)
        loop record in JET_CODEGEN_COMPILER_OWNED_CORE_RECORDS -> &record_names.push(record.name)
        loop record in JET_CODEGEN_COMPILER_OWNED_MATH_RECORDS -> &record_names.push(record.name)
        loop name in record_names {
            if declared_keys.get(name) != None -> next
            declared_keys[name] = true
            if name == JET_CODEGEN_PARSE_ERROR_ALIAS -> parse_error_declared = true
            fields :: jet_codegen_compiler_owned_record_fields(name) ?? panic("compiler-owned record `{name}` has no field rows")
            &slots.push(JetCodegenTypeSlot{row: Val(jet_codegen_compiler_owned_record_definition(record_module, name, fields)), module_index: -1, definition_index: -1})
        }
    }
    // Rust `collect_items` (seed_parse_error): each module that declares no
    // `ParseError` of its own seeds the compiler-owned alias row; rows dedupe
    // by key, so the first such module owns it.
    if !parse_error_declared {
        loop semantic_module in modules {
            owned := false
            loop definition in semantic_module.declarations.type_defs {
                if definition.name == JET_CODEGEN_PARSE_ERROR_ALIAS -> owned = true
            }
            if !owned {
                &slots.push(JetCodegenTypeSlot{row: Val(jet_codegen_parse_error_alias_definition(semantic_module.module_identity)), module_index: -1, definition_index: -1})
                break
            }
        }
    }
    slots
}

// Rust discard_duplicate_core_enum_fallbacks: how many loaded Core source enum
// rows (`<corelib>/...` keys) declare each leaf name.
fn jet_codegen_core_source_enum_counts(modules: [SemaGraphModuleResult]) -> [String:Int] Never! {
    counts := [String:Int]{}
    loop semantic_module in modules {
        loop definition in semantic_module.declarations.type_defs {
            if !definition.key.starts_with("<corelib>/") || definition.key == definition.name -> next
            if definition.kind == .Enum(_, _) -> counts[definition.name] = (counts.get(definition.name) ?? 0) + 1
        }
    }
    counts
}

// The declared type rows of a whole program (jet_codegen_declared_type_slots),
// each moved out of its slot.
fn jet_codegen_declared_type_rows(function_index: JetCodegenFunctionIndex, modules: [SemaGraphModuleResult]) -> [MIRTypeDef] {
    slots := jet_codegen_declared_type_slots(function_index, modules, false, false)
    reversed := [MIRTypeDef]{}
    loop slots.len() > 0 {
        slot := &slots.pop() ?? { break }
        row := ^slot.row ?? panic("a declared type slot of a whole program has no row")
        &reversed.push(^row)
    }
    types := [MIRTypeDef]{}
    loop reversed.len() > 0 {
        row := &reversed.pop() ?? { break }
        &types.push(^row)
    }
    types
}

// Intern Core publication constants by their canonical initializer identity.
fn jet_codegen_merge_shared_sites(rows: &[MIRConstantDef], incoming: [MIRConstantDef]) Never! {
    loop site in incoming {
        found := false
        loop existing in rows {
            if existing.id != site.id -> next
            if existing.ty != site.ty -> panic("one Core initializer has conflicting Shared payload types")
            if existing.value == .SharedSite(left) && site.value == .SharedSite(right) {
                if left.initializer != right.initializer || left.lifetime != right.lifetime -> panic("one Core initializer has conflicting publication lifetimes")
            } else {
                panic("Core publication site collides with ordinary constant")
            }
            found = true
        }
        if !found -> &rows.push(site)
    }
}

// The program rows of `functions`, lowered as `lowered_rows`: their merged
// function, callback and call rows, plus every module's trait and impl rows,
// with `declared_types` (jet_codegen_declared_type_rows of `modules`, or a
// comptime closure's jet_codegen_comptime_types) and `constants`
// (jet_codegen_lower_constant_rows of `modules`).
// The lowered rows are owned: each row's function, nested functions and
// metadata rows move out of it in program order, so no MIR row is copied.
fn jet_codegen_functions_from_rows(lowered_rows: ^[JetCodegenLoweredFunction], functions: [TFunc], function_index: JetCodegenFunctionIndex, modules: [SemaGraphModuleResult], trait_names: JetCodegenTraitNames, declared_types: ^[MIRTypeDef], constant_rows: ^[MIRConstantDef]) -> JetCodegenFunctions {
    constants := ^constant_rows
    lowered_functions := [MIRFunction]{}
    prelude_calls := [MIRPreludeCall]{}
    core_calls := [MIRCoreCall]{}
    used_core := [String]{}
    nested_functions := [MIRFunction]{}
    callbacks := [MIRCallbackAdapter]{}
    closure_sources := [JetCodegenClosureSource]{}
    // Identity sets so each merge step is O(1) rather than a rescan of every
    // row lowered so far: the id and `"module:key"` per top-level and nested
    // function, and row positions of callbacks, routes and Core calls by id.
    top_ids := [U64:Bool]{}
    top_keys := [String:Bool]{}
    nested_ids := [U64:Bool]{}
    nested_keys := [String:Bool]{}
    callback_rows := [String:Int]{}
    prelude_seen := [String:Bool]{}
    core_rows := [String:Int]{}
    used_core_seen := [String:Bool]{}
    // Popping the reversed rows yields them in program order.
    pending := ^lowered_rows
    &pending.reverse()
    loop {
        lowered := &pending.pop() ?? break
        jet_codegen_merge_shared_sites(&constants, lowered.shared_sites)
        id_key :: lowered.function.id.value
        module_key :: "{lowered.function.module_id.value}:{lowered.function.key}"
        if top_ids.get(id_key) != None || top_keys.get(module_key) != None -> panic("duplicate top-level MIR function identity")
        if nested_ids.get(id_key) != None || nested_keys.get(module_key) != None -> panic("top-level MIR function collides with a nested function")
        // A field moves only when a write in the same block refills it
        // (LastUse.jet); the bodiless signature row is that refill.
        shell := jet_rust_emit_signature_row(lowered.function)
        function := ^lowered.function
        lowered.function = ^shell
        &lowered_functions.push(^function)
        top_ids[id_key] = true
        top_keys[module_key] = true
        // Popping the reversed list in place moves each nested row out.
        &lowered.nested_functions.reverse()
        loop {
            nested := &lowered.nested_functions.pop() ?? break
            nested_id_key :: nested.id.value
            nested_module_key :: "{nested.module_id.value}:{nested.key}"
            if top_ids.get(nested_id_key) != None || top_keys.get(nested_module_key) != None -> panic("nested MIR function collides with a top-level function")
            if nested_ids.get(nested_id_key) != None || nested_keys.get(nested_module_key) != None -> panic("duplicate nested MIR function identity")
            &nested_functions.push(^nested)
            nested_ids[nested_id_key] = true
            nested_keys[nested_module_key] = true
        }
        loop source in lowered.closure_sources -> &closure_sources.push(source)
        loop callback in lowered.callbacks {
            callback_key :: "{callback.id.value}"
            if callback_rows.get(callback_key) == .Val(row) {
                if !jet_codegen_same_callback(callbacks[row], callback) -> panic("conflicting C callback adapter identity")
            } else {
                callback_rows[callback_key] = callbacks.len()
                &callbacks.push(callback)
            }
        }
        loop call in lowered.prelude_calls {
            call_key :: "{call.id.value}"
            if prelude_seen.get(call_key) == None {
                prelude_seen[call_key] = true
                &prelude_calls.push(call)
            }
        }
        loop call in lowered.core_calls {
            call_key :: "{call.id.value}"
            if core_rows.get(call_key) == .Val(row) {
                if core_calls[row].key != call.key -> panic("Core-call identity collision across lowered functions")
            } else {
                core_rows[call_key] = core_calls.len()
                &core_calls.push(call)
            }
        }
        loop used_core_module in lowered.used_core {
            if used_core_seen.get(used_core_module) == None {
                used_core_seen[used_core_module] = true
                &used_core.push(used_core_module)
            }
        }
    }

    core_owners := [MIRCoreOwner]{}
    loop semantic_module in modules {
        loop owner in semantic_module.declarations.core_builtin_owners {
            lowered := jet_codegen_lower_core_builtin_owner(owner, semantic_module)
            duplicate := false
            loop existing in core_owners {
                if existing.id == lowered.id || existing.key == lowered.key {
                    if existing.module_id != lowered.module_id || existing.nominal_id != lowered.nominal_id || existing.key != lowered.key || existing.name != lowered.name || existing.ownership != lowered.ownership -> panic("conflicting checked Core builtin owner identity")
                    duplicate = true
                }
            }
            if !duplicate -> &core_owners.push(lowered)
        }
    }
    jet_codegen_sort_core_owners(&core_owners)

    types := ^declared_types
    traits := [MIRTraitDef]{}
    loop semantic_module in modules {
        loop definition in semantic_module.declarations.traits -> &traits.push(jet_codegen_lower_trait_definition(definition, function_index, modules))
    }
    jet_codegen_ensure_builtin_debug_trait(&traits, types)
    jet_codegen_register_synthetic_unions(&types, lowered_functions, nested_functions)
    jet_codegen_sort_type_definitions(&types)
    jet_codegen_sort_trait_definitions(&traits)

    impls := [MIRImplDef]{}
    fields_by_name := jet_codegen_field_id_index(types)
    impl_method_membership := [String:Bool]{}
    // Impl keys are unique in `impls` (a repeated key merges into its row), so
    // a key -> row map finds the one row a later definition merges into.
    impl_index_by_key := [String:Int]{}
    loop semantic_module in modules {
        loop definition in semantic_module.declarations.impls {
            lowered :: jet_codegen_lower_impl_definition(definition, function_index, modules, trait_names, fields_by_name, top_ids) ?? next
            if impl_index_by_key.get(lowered.key) == .Val(index) {
                loop method in lowered.methods {
                    method_key := jet_codegen_qualified_function_key(lowered.key, "{method.value}")
                    if impl_method_membership.get(method_key) == None {
                        &impls[index].methods.push(method)
                        _ := &impl_method_membership.add(method_key, true)
                    }
                }
                next
            }
            &impl_index_by_key.add(lowered.key, impls.len()).drop("the lookup above proved this impl key has no row")
            loop method in lowered.methods -> _ := &impl_method_membership.add(jet_codegen_qualified_function_key(lowered.key, "{method.value}"), true)
            &impls.push(lowered)
        }
    }
    jet_codegen_attach_orphan_methods(&impls, lowered_functions, nested_functions, functions)
    jet_codegen_retain_selected_derives(&types, impls)
    jet_codegen_ensure_referenced_traits(&traits, impls, lowered_functions, nested_functions, types)
    jet_codegen_bind_trait_impl_forms(&lowered_functions, impls)
    jet_codegen_sort_trait_definitions(&traits)

    jet_codegen_sort_functions(&lowered_functions)
    jet_codegen_sort_functions(&nested_functions)
    jet_codegen_sort_callback_adapters(&callbacks)
    jet_codegen_sort_impl_definitions(&impls)
    jet_codegen_sort_core_calls(&core_calls)
    jet_codegen_sort_prelude_calls(&prelude_calls)
    jet_codegen_sort_used_core(&used_core)
    fields := jet_codegen_lower_field_rows(types, lowered_functions, nested_functions, traits, impls, constants)
    jet_codegen_sort_field_rows(&fields)
    return JetCodegenFunctions{
        functions: lowered_functions,
        nested_functions: nested_functions,
        callbacks: callbacks,
        closure_sources: closure_sources,
        types: types,
        core_owners: core_owners,
        traits: traits,
        impls: impls,
        constants: constants,
        fields: fields,
        core_calls: core_calls,
        prelude_calls: prelude_calls,
        used_core: used_core,
    }
}

// Every module's constant rows in canonical order. They read only `modules`,
// so a comptime session lowers them once for all of its items.
fn jet_codegen_lower_constant_rows(modules: [SemaGraphModuleResult]) -> [MIRConstantDef] {
    constants := [MIRConstantDef]{}
    loop semantic_module in modules {
        loop definition in semantic_module.declarations.constants {
            value := jet_codegen_lower_constant_definition(definition, modules)
            if value != None -> &constants.push(value ?? panic("lowered constant lost its MIR row"))
        }
    }
    jet_codegen_sort_constant_definitions(&constants)
    constants
}
fn jet_codegen_foreign_target_applicability(target: MIRArtifactTarget) -> MIRTargetApplicability Never! {
    if target == {
        .RustAOT -> MIRTargetApplicability{rust_aot: true, interpreter: false, web: false}
        .Interpreter -> MIRTargetApplicability{rust_aot: false, interpreter: true, web: false}
        .Web -> MIRTargetApplicability{rust_aot: false, interpreter: false, web: true}
    }
}

fn jet_codegen_lower_foreign_abi(abi: String) -> MIRForeignABI Never! {
    if abi == {
        "C" | "c" -> MIRForeignABI.C
        "C-unwind" | "c-unwind" | "cunwind" -> MIRForeignABI.CUnwind
        "system" | "System" -> MIRForeignABI.System
        "stdcall" | "Stdcall" -> MIRForeignABI.Stdcall
        "fastcall" | "Fastcall" -> MIRForeignABI.Fastcall
        "vectorcall" | "Vectorcall" -> MIRForeignABI.Vectorcall
        "rust" | "Rust" -> MIRForeignABI.Rust
        else -> MIRForeignABI.Platform{name: abi}
    }
}

fn jet_codegen_lower_foreign_language(language: String) -> MIRForeignLanguage Never! {
    if language == "c" -> return MIRForeignLanguage.C
    if language == "cpp" || language == "c++" -> return MIRForeignLanguage.Cpp
    if language == "asm" || language == "assembly" -> return MIRForeignLanguage.Assembly
    if language.starts_with("rust:") || language == "rust" -> return MIRForeignLanguage.Rust
    panic("checked foreign language has no MIR representation")
}

fn jet_codegen_foreign_effects(effect_root: String?, span: Span) -> MIREffectFacts Never! {
    direct := [String]{}
    direct_spans := [MIRNamedSpan]{}
    if effect_root != None {
        root :: effect_root
        if root == "" -> panic("checked foreign effect root is empty")
        &direct.push(root)
        &direct_spans.push(MIRNamedSpan{name: root, span: span})
    }
    MIREffectFacts{direct: direct, solved: direct, call_edges: [String]{}, maximal: false, direct_spans: direct_spans}
}

struct JetCodegenForeignHookIndex {
    functions: [String:MIRFunctionID]
    foreign: [String:MIRForeignID]
    ambiguous: [String:Bool]
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::lower_foreign_rows
fn jet_codegen_foreign_hook_index(modules: [SemaGraphModuleResult]) -> JetCodegenForeignHookIndex Never! {
    functions := [String:MIRFunctionID]{}
    foreign := [String:MIRForeignID]{}
    ambiguous := [String:Bool]{}
    loop semantic_module in modules {
        loop function in semantic_module.functions {
            if functions.get(function.key) == None -> _ := &functions.add(function.key, jet_codegen_function_id(function))
        }
        loop row in semantic_module.foreign_functions {
            id := MIRForeignID{value: stable_id("mir-foreign", row.key)}
            if foreign.get(row.key) != None -> _ := &ambiguous.add(row.key, true)
            _ := &foreign.add(row.key, id)
            if row.symbol_id.key != row.key {
                if foreign.get(row.symbol_id.key) != None -> _ := &ambiguous.add(row.symbol_id.key, true)
                _ := &foreign.add(row.symbol_id.key, id)
            }
        }
    }
    JetCodegenForeignHookIndex{functions: functions, foreign: foreign, ambiguous: ambiguous}
}

fn jet_codegen_find_checked_foreign_row(modules: [SemaGraphModuleResult], key: String) -> SemaCheckedForeignFunction? {
    found := SemaCheckedForeignFunction?{None}
    loop semantic_module in modules {
        loop row in semantic_module.foreign_functions {
            if row.key == key || row.symbol_id.key == key {
                if found != None -> panic("checked foreign call identity resolves to multiple rows")
                found = Val(row)
            }
        }
    }
    found
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::lower_foreign_rows
fn jet_codegen_foreign_lookup_id(hooks: JetCodegenForeignHookIndex, key: String) -> MIRForeignID? {
    if hooks.ambiguous.get(key) != None -> panic("checked foreign call identity resolves to multiple rows")
    hooks.foreign.get(key)
}

fn jet_codegen_lower_foreign_params(params: [SemaCheckedForeignParam], modules: [SemaGraphModuleResult], module_identity: String) -> [MIRParam] Never! {
    lowered := [MIRParam]{}
    loop parameter in params {
        access := jet_codegen_lower_access(parameter.convention)
        &lowered.push(MIRParam{
            index: parameter.index,
            name: parameter.name,
            span: parameter.span,
            ty: jet_codegen_lower_type_with_modules(parameter.ty, modules, module_identity, [String]{}),
            access: access,
            ownership: jet_codegen_lower_declaration_ownership(parameter.ownership),
            public_label: parameter.public_label,
            variadic: parameter.variadic,
            default_present: parameter.default_present,
        })
    }
    lowered
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::lower_foreign_rows
fn jet_codegen_lower_foreign_row(row: SemaCheckedForeignFunction, modules: [SemaGraphModuleResult], applicability: MIRTargetApplicability, hooks: JetCodegenForeignHookIndex) -> MIRForeign Never! {
    return_type := if row.return_type == {
        None -> None
        Val(ty) -> Val(jet_codegen_lower_type_with_modules(ty, modules, row.module_identity, [String]{}))
    }
    link := if row.link_key == {
        None -> None
        Val(key) -> Val(MIRLinkUnitID{value: stable_id("mir-link", key)})
    }
    callback := if row.callback_key == {
        None -> None
        Val(key) -> Val(MIRCallbackID{value: stable_id("mir-callback", key)})
    }
    handle := if row.handle_key == {
        None -> None
        Val(key) -> Val(MIRHandleID{value: stable_id("mir-handle", key)})
    }
    close_function := if row.close_function_key == {
        None -> None
        Val(key) -> Val(hooks.functions.get(key) ?? panic("checked foreign close adapter has no registered TFunc"))
    }
    close_foreign := if row.close_foreign_key == {
        None -> None
        Val(key) -> Val(jet_codegen_foreign_lookup_id(hooks, key) ?? panic("checked raw foreign close has no registered foreign row"))
    }
    undo_function := if row.undo_function_key == {
        None -> None
        Val(key) -> hooks.functions.get(key)
    }
    MIRForeign{
        id: MIRForeignID{value: stable_id("mir-foreign", row.key)},
        module_id: mir_module_id(row.module_identity),
        key: row.key,
        module_name: row.module_name,
        name: row.name,
        span: row.span,
        symbol: row.symbol,
        path: row.path,
        params: jet_codegen_lower_foreign_params(row.params, modules, row.module_identity),
        raw_scalar_abi: row.raw_scalar_abi,
        bridge_eligible: row.bridge_eligible,
        return_type: return_type,
        foreign_abi: jet_codegen_lower_foreign_abi(row.abi),
        foreign_language: jet_codegen_lower_foreign_language(row.language),
        target_applicability: applicability,
        effects: jet_codegen_foreign_effects(row.effect_root, row.span),
        callback_transport: row.callback_transport,
        callback_plan_digest: row.callback_plan_digest,
        callback_identity: row.callback_identity,
        link: link,
        callback: callback,
        handle: handle,
        close_function: close_function,
        close_foreign: close_foreign,
        undo_function: undo_function,
        unsafe_gate: jet_codegen_lower_unsafe_gate(row.unsafe_gate),
    }
}

fn jet_codegen_lower_foreign_handle_ownership(ownership: String) -> MIRHandleOwnership Never! {
    if ownership == {
        "Owned" -> MIRHandleOwnership.Owned
        "Shared" -> MIRHandleOwnership.Shared
        "Borrowed" -> MIRHandleOwnership.Borrowed
        else -> panic("checked foreign handle ownership has no MIR representation")
    }
}

fn jet_codegen_lower_foreign_close_source(source: String) -> MIRFFICloseSource Never! {
    if source == {
        "conventional" -> MIRFFICloseSource.Conventional
        "overlay" -> MIRFFICloseSource.Overlay
        else -> panic("checked foreign handle close source has no MIR representation")
    }
}

fn jet_codegen_lower_foreign_thread_safety(safety: String) -> MIRFFIThreadSafety Never! {
    if safety == {
        "unspecified" -> MIRFFIThreadSafety.Unspecified
        "safe" -> MIRFFIThreadSafety.Safe
        "unsafe" -> MIRFFIThreadSafety.Unsafe
        else -> panic("checked foreign handle thread-safety has no MIR representation")
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::lower_handle_rows
fn jet_codegen_lower_foreign_handle(handle: SemaCheckedForeignHandle, module_identity: String, modules: [SemaGraphModuleResult], hooks: JetCodegenForeignHookIndex) -> MIRHandleLifecycle Never! {
    close_function := MIRFunctionID?{None}
    close_foreign := MIRForeignID?{None}
    if handle.close_function_key != None {
        key :: handle.close_function_key ?? panic("checked foreign handle close function key disappeared")
        close_function = hooks.functions.get(key) ?? panic("checked foreign handle close adapter does not resolve to a TFunc")
    }
    if handle.close_foreign_key != None {
        key :: handle.close_foreign_key ?? panic("checked foreign handle close foreign key disappeared")
        close_foreign = jet_codegen_foreign_lookup_id(hooks, key) ?? panic("checked foreign handle fallback does not resolve to a foreign row")
    }
    undo := MIRFunctionID?{None}
    if handle.undo_function_key != None {
        key :: handle.undo_function_key ?? panic("checked foreign handle undo key disappeared")
        undo = hooks.functions.get(key)
    }
    MIRHandleLifecycle{
        id: MIRHandleID{value: stable_id("mir-handle", "c::{handle.library}::{handle.jet_name}")},
        ty: jet_codegen_lower_type_with_modules(Type.Named{name: handle.jet_name}, modules, module_identity, [String]{}),
        ownership: jet_codegen_lower_foreign_handle_ownership(handle.ownership),
        payload: MIRHandlePayload{library: handle.library, typedef_name: handle.typedef_name, close: handle.close},
        close: close_function,
        close_foreign: close_foreign,
        undo: undo,
        send: handle.send,
        sync: handle.sync,
        close_source: Val(jet_codegen_lower_foreign_close_source(handle.close_source)),
        thread_safety: Val(jet_codegen_lower_foreign_thread_safety(handle.thread_safety)),
    }
}

fn jet_codegen_foreign_push_unique_string(rows: &[String], value: String) Never! {
    if !rows.contains(value) -> &rows.push(value)
}

fn jet_codegen_foreign_sort_strings(rows: &[String]) Never! {
    &rows.sort()
}

fn jet_codegen_foreign_sort_rows(rows: &[MIRForeign]) Never! {
    &rows.sort_by((left: MIRForeign, right: MIRForeign) -> if left.id.value != right.id.value -> left.id.value <=> right.id.value else -> left.key <=> right.key)
}

fn jet_codegen_foreign_sort_links(rows: &[MIRLinkUnit]) Never! {
    &rows.sort_by((left: MIRLinkUnit, right: MIRLinkUnit) -> if left.id.value != right.id.value -> left.id.value <=> right.id.value else -> left.crate_spec <=> right.crate_spec)
}

fn jet_codegen_foreign_sort_handles(rows: &[MIRHandleLifecycle]) Never! {
    &rows.sort_by((left: MIRHandleLifecycle, right: MIRHandleLifecycle) -> left.id.value <=> right.id.value)
}

fn jet_codegen_foreign_add_link_closure_id(closure: &[MIRLinkUnitID], name: String, libraries: &[String]) Never! {
    loop library in libraries {
        if name == library {
            key := "c::{library}"
            id := MIRLinkUnitID{value: stable_id("mir-link", key)}
            if !closure.contains(id) -> &closure.push(id)
        }
    }
}

fn jet_codegen_foreign_link_closure(direct: &[String], transitive: &[String], libraries: &[String]) -> [MIRLinkUnitID] Never! {
    closure := [MIRLinkUnitID]{}
    loop name in direct -> jet_codegen_foreign_add_link_closure_id(&closure, name, &libraries)
    loop name in transitive -> jet_codegen_foreign_add_link_closure_id(&closure, name, &libraries)
    closure
}

fn jet_codegen_foreign_link_row(library: String, cache_identity: String, applicability: MIRTargetApplicability, direct: &[String], transitive: &[String], libraries: &[String]) -> MIRLinkUnit Never! {
    key := "c::{library}"
    MIRLinkUnit{
        id: MIRLinkUnitID{value: stable_id("mir-link", key)},
        crate_spec: library,
        cache_identity: cache_identity,
        target_applicability: applicability,
        artifacts: [MIRLinkArtifact]{},
        dependency_dirs: [String]{},
        link_closure: jet_codegen_foreign_link_closure(&direct, &transitive, &libraries),
    }
}

fn jet_codegen_same_foreign_handle(left: MIRHandleLifecycle, right: MIRHandleLifecycle) -> Bool Never! {
    left.id == right.id &&
    mir_type_identity_key(left.ty) == mir_type_identity_key(right.ty) &&
    left.ownership == right.ownership &&
    left.payload.library == right.payload.library &&
    left.payload.typedef_name == right.payload.typedef_name &&
    left.payload.close == right.payload.close &&
    left.close == right.close &&
    left.close_foreign == right.close_foreign &&
    left.undo == right.undo &&
    left.send == right.send &&
    left.sync == right.sync &&
    left.close_source == right.close_source &&
    left.thread_safety == right.thread_safety
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::lower_foreign_rows
fn lower_foreign_artifacts(modules: [SemaGraphModuleResult], package_facts: MIRPackageFacts) -> JetCodegenForeignArtifacts Never! {
    direct_links := [String]{}
    transitive_links := [String]{}
    libraries := [String]{}
    has_foreign_data := false
    loop semantic_module in modules {
        if semantic_module.foreign_functions.len() > 0 -> has_foreign_data = true
        loop provider in semantic_module.foreign_providers {
            has_foreign_data = true
            jet_codegen_foreign_push_unique_string(&libraries, provider.library)
            loop library in provider.direct_links -> jet_codegen_foreign_push_unique_string(&direct_links, library)
            loop library in provider.transitive_links -> jet_codegen_foreign_push_unique_string(&transitive_links, library)
        }
    }
    if !has_foreign_data -> return JetCodegenForeignArtifacts{foreign: [MIRForeign]{}, links: [MIRLinkUnit]{}, handles: [MIRHandleLifecycle]{}, functions: [MIRFunction]{}}
    target :: package_facts.artifact_target ?? panic("checked foreign artifact lowering has no selected package target")
    applicability := jet_codegen_foreign_target_applicability(target)
    jet_codegen_foreign_sort_strings(&direct_links)
    jet_codegen_foreign_sort_strings(&transitive_links)
    write_index := 0
    read_index := 0
    loop read_index < transitive_links.len() {
        library := transitive_links[read_index]
        if !direct_links.contains(library) {
            transitive_links[write_index] = library
            write_index += 1
        }
        read_index += 1
    }
    loop transitive_links.len() > write_index -> _ := &transitive_links.pop()
    jet_codegen_foreign_sort_strings(&libraries)
    cache_identity := "direct={direct_links.join(",")};transitive={transitive_links.join(",")}"
    links := [MIRLinkUnit]{}
    loop library in libraries -> &links.push(jet_codegen_foreign_link_row(library, cache_identity, applicability, &direct_links, &transitive_links, &libraries))
    foreign := [MIRForeign]{}
    hooks := jet_codegen_foreign_hook_index(modules)
    asm_functions := [MIRFunction]{}
    loop semantic_module in modules {
        loop row in semantic_module.foreign_functions {
            if row.owner == SemaCheckedForeignOwner.CModule {
                link_key :: row.link_key ?? panic("checked C foreign link key disappeared")
                link_id := MIRLinkUnitID{value: stable_id("mir-link", link_key)}
                found := false
                loop link_row in links {
                    if link_row.id == link_id -> found = true
                }
                if !found -> panic("checked C foreign function references a missing link provider")
            }
            lowered := jet_codegen_lower_foreign_row(row, modules, applicability, hooks)
            loop existing in foreign {
                if existing.id == lowered.id -> panic("duplicate or colliding checked foreign function identity")
            }
            &foreign.push(lowered)
            if row.language == "asm" -> &asm_functions.push(jet_codegen_lower_asm_leaf(row, modules, applicability))
        }
    }
    handles := [MIRHandleLifecycle]{}
    loop semantic_module in modules {
        loop provider in semantic_module.foreign_providers {
            loop handle in provider.handles {
                lowered := jet_codegen_lower_foreign_handle(handle, semantic_module.module_identity, modules, hooks)
                duplicate := false
                loop existing in handles {
                    if existing.id == lowered.id {
                        if !jet_codegen_same_foreign_handle(existing, lowered) -> panic("conflicting checked foreign handle identity")
                        duplicate = true
                    }
                }
                if !duplicate -> &handles.push(lowered)
            }
        }
    }
    loop row in foreign {
        if row.handle != None {
            handle_id :: row.handle ?? panic("checked foreign handle ID disappeared")
            found := false
            loop handle_row in handles {
                if handle_row.id == handle_id -> found = true
            }
            if !found -> panic("checked foreign function references a missing handle provider")
        }
        if row.close_foreign != None {
            close_id :: row.close_foreign ?? panic("checked foreign close ID disappeared")
            found := false
            loop foreign_row in foreign {
                if foreign_row.id == close_id -> found = true
            }
            if !found -> panic("checked foreign function references a missing foreign close function")
        }
    }
    jet_codegen_foreign_sort_rows(&foreign)
    jet_codegen_foreign_sort_links(&links)
    jet_codegen_foreign_sort_handles(&handles)
    JetCodegenForeignArtifacts{foreign: foreign, links: links, handles: handles, functions: asm_functions}
}

// Rust `function_foreign_provenance` (TIR/mod.rs): an `#FFI(asm)` function
// is a foreign leaf whose code is its inline source. It keeps the checked
// foreign row's key, parameters, return and declaration span; the native
// backend lowers it from that span (InlineAsm.jet) and never runs a body,
// so its one block is unreachable.
fn jet_codegen_lower_asm_leaf(row: SemaCheckedForeignFunction, modules: [SemaGraphModuleResult], applicability: MIRTargetApplicability) -> MIRFunction Never! {
    unit :: Type.Named{name: "Unit"}
    return_type :: jet_codegen_lower_type_with_modules(row.return_type ?? unit, modules, row.module_identity, [String]{})
    entry :: MIRBlockID{value: stable_id("mir-block", "{row.key}|{row.source_file}|{row.span.start}|{row.span.end}|asm-entry")}
    declared_return := MIRType?{None}
    if row.return_type != None -> declared_return = Val(return_type)
    MIRFunction{
        id: mir_function_id("{row.key}|{row.source_file}|{row.span.start}|{row.span.end}|asm"),
        module_id: mir_module_id(row.module_identity),
        source_file: mir_source_file_id(row.source_file),
        key: row.key,
        module_name: row.module_name,
        name: row.name,
        span: row.span,
        kind: MIRFunctionKind.Foreign,
        form: MIRFunctionForm.TopLevel,
        visibility: MIRVisibility.Private,
        target_applicability: applicability,
        web_bucket: None,
        web_marker: None,
        generic_params: [MIRGenericParam]{},
        capture_params: [MIRCaptureParam]{},
        params: jet_codegen_lower_foreign_params(row.params, modules, row.module_identity),
        declared_return: declared_return,
        return_type: return_type,
        failure: MIRFailureCarrier.Infallible,
        effects: jet_codegen_foreign_effects(row.effect_root, row.span),
        captures: None,
        generator: None,
        optimization: mir_empty_optimization_facts(),
        is_unsafe: true,
        unsafe_gate: jet_codegen_lower_unsafe_gate(row.unsafe_gate),
        is_pure: false,
        memo_bound: None,
        memo_unbounded: false,
        is_reactive: false,
        reactive_upgrades: [String]{},
        is_inline: false,
        is_inline_always: false,
        is_scalar: false,
        kernel_proof: None,
        gc_return: false,
        return_view_provenance: None,
        web_param_reconstructions: [MIRWebParamReconstruction]{},
        blocks: [MIRBasicBlock]{MIRBasicBlock{id: entry, span: row.span, instructions: [MIRInstruction]{}, terminator: MIRTerminator.Unreachable{reason: "inline asm leaf lowers from its source span"}}},
        entry: entry,
        locals: [MIRLocal]{},
        values: [MIRValueFact]{},
        places: [MIRPlace]{},
        scopes: [MIRScope]{},
        drops: [MIRDropAction]{},
        foreign_language: Val("asm"),
    }
}
