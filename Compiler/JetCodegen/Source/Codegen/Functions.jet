pub struct JetCodegenFunctions {
    pub functions: [MIRFunction]
    pub nested_functions: [MIRFunction]
    pub callbacks: [MIRCallbackAdapter]
    pub types: [MIRTypeDef]
    pub core_owners: [MIRCoreOwner]
    pub traits: [MIRTraitDef]
    pub impls: [MIRImplDef]
    pub constants: [MIRConstantDef]
    pub fields: [MIRFieldRow]
    pub core_calls: [MIRCoreCall]
    pub prelude_calls: [MIRPreludeCall]
    pub used_core: [String]
}
pub struct JetCodegenForeignArtifacts {
    pub foreign: [MIRForeign]
    pub links: [MIRLinkUnit]
    pub handles: [MIRHandleLifecycle]
}
fn jet_codegen_lower_declaration_ownership_mode(ownership: TDeclarationOwnership) -> MIROwnershipMode Never! {
    if ownership == {
        .Owned -> MIROwnershipMode.Owned
        .ReadBorrow -> MIROwnershipMode.ReadBorrow
        .WriteBorrow -> MIROwnershipMode.WriteBorrow
        .Move -> MIROwnershipMode.Move
    }
}

fn jet_codegen_lower_declaration_ownership(ownership: TDeclarationOwnership) -> MIROwnership Never! {
    if ownership == {
        .Owned -> mir_owned_ownership()
        .ReadBorrow -> MIROwnership{mode: MIROwnershipMode.ReadBorrow, drop: MIRDropKind.NoDrop, moved: false, last_use: false, gc_root: false}
        .WriteBorrow -> MIROwnership{mode: MIROwnershipMode.WriteBorrow, drop: MIRDropKind.NoDrop, moved: false, last_use: false, gc_root: false}
        .Move -> MIROwnership{mode: MIROwnershipMode.Move, drop: MIRDropKind.Value, moved: false, last_use: false, gc_root: false}
    }
}

fn jet_codegen_lower_declaration_field(field: TField, owner_key: String, modules: [SemaGraphModuleResult], module_identity: String, generic_names: [String]) -> MIRField Never! {
    return MIRField{
        id: mir_field_id("{owner_key}::{field.name}"),
        name: field.name,
        shape_names: MIRShapeFieldNames{
            text: field.shape_names.text,
            json: field.shape_names.json,
            cbor: field.shape_names.cbor,
            csv: field.shape_names.csv,
            toml: field.shape_names.toml,
            yaml: field.shape_names.yaml,
            xml: field.shape_names.xml,
            args: field.shape_names.args,
            env: field.shape_names.env,
            db: field.shape_names.db,
            layout: field.shape_names.layout,
        },
        skip: field.skip,
        ty: jet_codegen_lower_type_with_modules(field.ty, modules, module_identity, generic_names),
        span: field.span,
        public: field.public,
        package_public: field.package_public,
        computed: field.computed,
        has_default: field.has_default,
        redact: field.redact,
    }
}

fn jet_codegen_declaration_function_id(functions: JetCodegenFunctionIndex, key: String, module_identity: String) -> MIRFunctionID Never! {
    function :: jet_codegen_find_function_by_key(functions, key, module_identity) ?? panic("checked declaration function reference is not reachable")
    return jet_codegen_function_id(function)
}

fn jet_codegen_type_method_ids(definition: TTypeDef, method_keys: [String], functions: JetCodegenFunctionIndex) -> [MIRFunctionID] Never! {
    lowered := [MIRFunctionID]{}
    loop key in method_keys {
        function := jet_codegen_find_function_by_key(functions, key, definition.module_identity)
        if function == None {
            if definition.key.starts_with("<corelib>/") -> next
            panic("checked type method has no reachable TFunc")
        }
        target :: function ?? panic("checked type method lookup lost its TFunc")
        &lowered.push(jet_codegen_function_id(target))
    }
    return lowered
}

fn jet_codegen_lower_declaration_generic_params(params: [TGenericParam], modules: [SemaGraphModuleResult]) -> [MIRGenericParam] Never! {
    lowered := [MIRGenericParam]{}
    loop param in params {
        bounds := [MIRTraitRef]{}
        loop bound in param.bounds -> &bounds.push(jet_codegen_mir_trait_ref_for_symbol(modules, bound))
        &lowered.push(MIRGenericParam{name: param.name, bounds: bounds})
    }
    return lowered
}

fn jet_codegen_lower_cli_value_kind(kind: TCLIValueKind) -> MIRCLIValueKind Never! {
    return if kind == {
        .Bool -> MIRCLIValueKind.Bool
        .Int -> MIRCLIValueKind.Int
        .Float -> MIRCLIValueKind.Float
        .String -> MIRCLIValueKind.String
        .Path -> MIRCLIValueKind.Path
    }
}

fn jet_codegen_lower_cli_default(default: TCLIDefault, modules: [SemaGraphModuleResult], module_identity: String) -> MIRCLIDefault? {
    return if default == {
        .TypeDefault -> Val(MIRCLIDefault.TypeDefault)
        .Value(value) -> {
            lowered :: jet_codegen_lower_comptime_value(value, modules, module_identity, [String]{}) ?? return None
            Val(MIRCLIDefault.Value{value: lowered})
        }
        .Recorded(value) -> Val(MIRCLIDefault.Value{value: MIRConstant.String{value: value}})
    }
}

fn jet_codegen_lower_cli_input(input: TCLIInput, ordinal: Int, modules: [SemaGraphModuleResult], module_identity: String) -> MIRCLIInput {
    shape := MIRCLIInputShape.Flag
    scalar_type := Type.Bool
    optional := false
    _ := if input.shape == {
        .Flag -> ()
        .Value(kind, is_optional, default) -> {
            lowered_kind := jet_codegen_lower_cli_value_kind(kind)
            scalar_type = if lowered_kind == {
                .Bool -> Type.Bool
                .Int -> Type.Int
                .Float -> Type.Float
                .String -> Type.String
                .Path -> Type.String
            }
            lowered_default := MIRCLIDefault?{None}
            if default != None {
                value :: default
                lowered_default = jet_codegen_lower_cli_default(value, modules, module_identity)
            }
            shape = MIRCLIInputShape.Value{kind: lowered_kind, optional: is_optional, default: lowered_default}
            optional = is_optional
            ()
        }
    }
    ty := scalar_type
    if {
        input.variadic -> {
            ty = Type.List{element: scalar_type}
        }
        optional -> {
            ty = Type.Option{inner: scalar_type}
        }
    }
    return MIRCLIInput{
        parameter: ordinal,
        name: input.field,
        label: input.field,
        ty: jet_codegen_lower_type_with_modules(ty, modules, module_identity, [String]{}),
        zone: ParamZone.Either,
        flag: input.flag,
        short: input.short,
        env: input.env,
        help: input.help,
        metavar: input.metavar,
        shape: shape,
        positional: input.positional,
        variadic: input.variadic,
    }
}

fn jet_codegen_lower_cli_inputs(inputs: [TCLIInput], modules: [SemaGraphModuleResult], module_identity: String) -> [MIRCLIInput] {
    lowered := [MIRCLIInput]{}
    index := 0
    loop input in inputs {
        &lowered.push(jet_codegen_lower_cli_input(input, index, modules, module_identity))
        index += 1
    }
    return lowered
}

fn jet_codegen_lower_cli_entry(entry: TCLIEntry, functions: JetCodegenFunctionIndex, modules: [SemaGraphModuleResult], module_identity: String) -> MIRCLIEntry {
    commands := [MIRCLICommand]{}
    loop command in entry.commands {
        if command.function != None {
            reference :: command.function ?? panic("checked CLI command function reference disappeared")
            inputs := jet_codegen_lower_cli_inputs(command.inputs, modules, module_identity)
            receiver := if command.receiver == {
                None -> None
                Val(name) -> Val(mir_type_id(name))
            }
            &commands.push(MIRCLICommand{
                name: command.name,
                description: command.description,
                function: jet_codegen_declaration_function_id(functions, reference.key, reference.module_identity),
                receiver: receiver,
                inputs: inputs,
            })
        }
    }
    return MIRCLIEntry{
        record_inputs: entry.record_inputs,
        description: entry.description,
        inputs: jet_codegen_lower_cli_inputs(entry.inputs, modules, module_identity),
        commands: commands,
        standard: entry.standard,
        version: entry.version,
    }
}

fn jet_codegen_lower_c_enum_tag(enum_tag: TCEnumTag) -> MIRCEnumTag Never! {
    return if enum_tag == {
        .CInt -> MIRCEnumTag.CInt
        .U8 -> MIRCEnumTag.U8
        .I8 -> MIRCEnumTag.I8
        .U16 -> MIRCEnumTag.U16
        .I16 -> MIRCEnumTag.I16
        .U32 -> MIRCEnumTag.U32
        .I32 -> MIRCEnumTag.I32
        .U64 -> MIRCEnumTag.U64
        .I64 -> MIRCEnumTag.I64
    }
}

fn jet_codegen_lower_compiler_builtin(value: TCompilerBuiltin) -> MIRCompilerBuiltin Never! {
    return if value == {
        .DefaultErr -> MIRCompilerBuiltin.DefaultErr
    }
}

fn jet_codegen_lower_type_definition(definition: TTypeDef, functions: JetCodegenFunctionIndex, modules: [SemaGraphModuleResult]) -> MIRTypeDef {
    generic_names := [String]{}
    loop param in definition.generic_params -> &generic_names.push(param.name)
    kind := if definition.kind == {
        .Struct(fields, methods) -> {
            lowered_fields := [MIRField]{}
            loop field in fields -> &lowered_fields.push(jet_codegen_lower_declaration_field(field, definition.key, modules, definition.module_identity, generic_names))
            MIRTypeDefKind.Struct{fields: lowered_fields, methods: jet_codegen_type_method_ids(definition, methods, functions)}
        }
        .Enum(variants, methods) -> {
            lowered_variants := [MIRVariant]{}
            loop variant in variants {
                payload := if variant.payload == {
                    .Unit -> MIRVariantPayload.Unit
                    .Single(value) -> MIRVariantPayload.Single{value: jet_codegen_lower_type_with_modules(value, modules, definition.module_identity, generic_names)}
                    .Named(fields) -> {
                        owner_key := "{definition.key}::{variant.name}"
                        lowered_fields := [MIRField]{}
                        loop field in fields -> &lowered_fields.push(jet_codegen_lower_declaration_field(field, owner_key, modules, definition.module_identity, generic_names))
                        MIRVariantPayload.Named{fields: lowered_fields}
                    }
                }
                &lowered_variants.push(MIRVariant{
                    name: variant.name,
                    wire_name: variant.wire_name,
                    span: variant.span,
                    payload: payload,
                    discriminant: variant.discriminant,
                })
            }
            MIRTypeDefKind.Enum{variants: lowered_variants, methods: jet_codegen_type_method_ids(definition, methods, functions)}
        }
        .Distinct(base, range) -> {
            lowered_range := if range == {
                None -> None
                Val(value) -> Val(MIRIntegerRange{lo: value.lo, hi: value.hi})
            }
            MIRTypeDefKind.Distinct{base: jet_codegen_lower_type_with_modules(base, modules, definition.module_identity, generic_names), range: lowered_range}
        }
        .Alias(target) -> MIRTypeDefKind.Alias{target: jet_codegen_lower_type_with_modules(target, modules, definition.module_identity, generic_names)}
        .UnitFamily(members) -> MIRTypeDefKind.UnitFamily{members: members}
    }
    layout := if definition.layout == {
        None -> None
        Val(value) -> Val(if value == {
            .C -> MIRStructLayout.C
            .CAligned(alignment, target) -> MIRStructLayout.CAligned{alignment: alignment, target: target}
            .Columnar -> MIRStructLayout.Columnar
        })
    }
    serde := [MIRSerdeAttribute]{}
    loop attribute in definition.serde {
        serde_kind := if attribute.kind == {
            .RenameAll -> MIRSerdeAttributeKind.RenameAll
            .Tag -> MIRSerdeAttributeKind.Tag
            .Untagged -> MIRSerdeAttributeKind.Untagged
            .DenyUnknownFields -> MIRSerdeAttributeKind.DenyUnknownFields
        }
        &serde.push(MIRSerdeAttribute{kind: serde_kind, value: attribute.value, span: attribute.span})
    }
    cli_bindings := [MIRCLIBinding]{}
    loop binding in definition.cli_bindings {
        &cli_bindings.push(MIRCLIBinding{
            name: binding.name,
            function: jet_codegen_declaration_function_id(functions, binding.function_key, definition.module_identity),
            span: binding.span,
            markers: binding.markers,
        })
    }
    cli := if definition.cli == {
        None -> None
        Val(entry) -> Val(jet_codegen_lower_cli_entry(entry, functions, modules, definition.module_identity))
    }
    alignment := if definition.layout_alignment == {
        None -> None
        Val(value) -> Val(MIRLayoutAlignmentFact{
            requested_alignment: value.requested_alignment,
            effective_alignment: value.effective_alignment,
            target_mode: value.target_mode,
            target_profile: value.target_profile,
            fact_identity: value.fact_identity,
        })
    }
    c_layout_tag := if definition.c_layout_tag == {
        None -> None
        Val(c_layout_tag_value) -> Val(jet_codegen_lower_c_enum_tag(c_layout_tag_value))
    }
    derives := [MIRTraitID]{}
    loop name in definition.derives -> &derives.push(jet_codegen_lower_type_derive_trait_id(name, modules, definition.module_identity))
    return MIRTypeDef{
        id: mir_type_id(definition.key),
        module_id: mir_module_id(definition.module_identity),
        key: definition.key,
        name: definition.name,
        span: definition.span,
        public: definition.public,
        package_public: definition.package_public,
        generic_params: jet_codegen_lower_declaration_generic_params(definition.generic_params, modules),
        derives: derives,
        auto_derive_default: definition.auto_derive_default,
        auto_printable: definition.auto_printable,
        published_schema: definition.published_schema,
        single_use: definition.single_use,
        must_use: definition.must_use,
        layout: layout,
        c_layout_tag: c_layout_tag,
        enum_layout: definition.enum_layout,
        layout_alignment: alignment,
        cli: cli,
        serde: serde,
        cli_bindings: cli_bindings,
        ownership: jet_codegen_lower_declaration_ownership_mode(definition.ownership),
        boxed_edges: definition.boxed_edges,
        compiler_builtin: definition.compiler_builtin.map(jet_codegen_lower_compiler_builtin),
        kind: kind,
    }
}


fn jet_codegen_lower_declaration_failure(failure: TFailureCarrier, modules: [SemaGraphModuleResult], module_identity: String) -> MIRFailureCarrier Never! {
    return if failure == {
        .Infallible -> MIRFailureCarrier.Infallible
        .Result(success, error) -> MIRFailureCarrier.Result{
            success: jet_codegen_lower_type_with_modules(success, modules, module_identity, [String]{}),
            error: jet_codegen_lower_type_with_modules(error, modules, module_identity, [String]{}),
        }
        .Optional(value) -> MIRFailureCarrier.Optional{value: jet_codegen_lower_type_with_modules(value, modules, module_identity, [String]{})}
        .Diverges(value) -> MIRFailureCarrier.Diverges{value: jet_codegen_lower_type_with_modules(value, modules, module_identity, [String]{})}
    }
}

fn jet_codegen_lower_declaration_param(parameter: TDeclarationParam, modules: [SemaGraphModuleResult], module_identity: String) -> MIRParam Never! {
    access := jet_codegen_lower_access(parameter.access)
    return MIRParam{
        index: parameter.index,
        name: parameter.name,
        span: parameter.span,
        ty: jet_codegen_lower_type_with_modules(parameter.ty, modules, module_identity, [String]{}),
        access: access,
        ownership: jet_codegen_lower_declaration_ownership(parameter.ownership),
        public_label: parameter.public_label,
        variadic: parameter.variadic,
        default_present: parameter.default_present,
    }
}

fn jet_codegen_lower_declaration_effects(declared: [TEffectSpan]?) -> MIREffectFacts Never! {
    direct := [String]{}
    direct_spans := [MIRNamedSpan]{}
    if declared != None {
        effects :: declared
        loop effect_span in effects {
            seen := false
            loop name in direct {
                if name == effect_span.name -> seen = true
            }
            if !seen -> &direct.push(effect_span.name)
            &direct_spans.push(MIRNamedSpan{name: effect_span.name, span: effect_span.span})
        }
    }
    direct = jet_codegen_sort_strings(direct)
    direct_spans = jet_codegen_sort_named_spans(direct_spans)
    return MIREffectFacts{direct: direct, solved: direct, call_edges: [String]{}, maximal: false, direct_spans: direct_spans}
}

fn jet_codegen_lower_trait_method(method: TTraitMethod, trait_key: String, module_identity: String, functions: JetCodegenFunctionIndex, modules: [SemaGraphModuleResult]) -> MIRTraitMethod Never! {
    params := [MIRParam]{}
    loop parameter in method.params -> &params.push(jet_codegen_lower_declaration_param(parameter, modules, module_identity))
    declared_return := if method.declared_return == {
        None -> None
        Val(value) -> Val(jet_codegen_lower_type_with_modules(value, modules, module_identity, [String]{}))
    }
    default_function := MIRFunctionID?{None}
    if method.default_function_key != None {
        key :: method.default_function_key ?? panic("checked trait default key disappeared during MIR lowering")
        function := jet_codegen_find_function_by_key(functions, key, module_identity)
        if function != None -> default_function = Val(jet_codegen_function_id(function ?? panic("checked trait default lookup lost its TFunc")))
    }
    self_access := if method.self_access == {
        None -> None
        Val(value) -> Val(jet_codegen_lower_access(value))
    }
    return MIRTraitMethod{
        id: MIRTraitMethodID{value: stable_id("mir-trait-method", "{trait_key}::{method.key}")},
        name: method.name,
        span: method.span,
        self_access: self_access,
        params: params,
        declared_return: declared_return,
        return_type: jet_codegen_lower_type_with_modules(method.return_type, modules, module_identity, [String]{}),
        failure: jet_codegen_lower_declaration_failure(method.failure, modules, module_identity),
        effects: jet_codegen_lower_declaration_effects(method.declared_effects),
        is_pure: method.is_pure,
        return_view_provenance: jet_codegen_lower_view_provenance_map(method.return_view_provenance),
        declared_return_view_provenance: None,
        default: default_function,
    }
}

fn jet_codegen_lower_trait_definition(definition: TTraitDef, functions: JetCodegenFunctionIndex, modules: [SemaGraphModuleResult]) -> MIRTraitDef Never! {
    associated_types := [MIRAssociatedTypeDecl]{}
    loop value in definition.associated_types -> &associated_types.push(MIRAssociatedTypeDecl{name: value.name, span: value.span})
    methods := [MIRTraitMethod]{}
    loop method in definition.methods -> &methods.push(jet_codegen_lower_trait_method(method, definition.key, definition.module_identity, functions, modules))
    key := jet_codegen_canonical_target_type(definition.module_identity, definition.key)
    return MIRTraitDef{
        id: mir_trait_id(key),
        module_id: mir_module_id(definition.module_identity),
        key: key,
        name: definition.name,
        span: definition.span,
        visibility: jet_codegen_lower_visibility(definition.visibility),
        associated_types: associated_types,
        methods: methods,
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::resolve_field_id
fn jet_codegen_field_id_index(types: [MIRTypeDef]) -> [String:MIRFieldID] {
    fields_by_name := [String:MIRFieldID]{}
    loop definition in types {
        if definition.kind == {
            .Struct(fields, _) -> loop field in fields {
                if fields_by_name.get(field.name) == None -> &fields_by_name.add(field.name, field.id).drop("first field name wins")
            }
            .Enum(variants, _) -> loop variant in variants {
                if variant.payload == {
                    .Named(fields) -> loop field in fields {
                        if fields_by_name.get(field.name) == None -> &fields_by_name.add(field.name, field.id).drop("first field name wins")
                    }
                    else -> {}
                }
            }
            else -> {}
        }
    }
    fields_by_name
}

fn jet_codegen_lower_target_os(target: TTargetOS?) -> MIROSTarget? {
    return if target == {
        None -> None
        Val(os) -> if os == {
            .Linux -> Val(MIROSTarget.Linux)
            .MacOS -> Val(MIROSTarget.MacOS)
            .Windows -> Val(MIROSTarget.Windows)
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::lower_impl_rows
fn jet_codegen_lower_impl_definition(definition: TImplDef, functions: JetCodegenFunctionIndex, modules: [SemaGraphModuleResult], fields_by_name: [String:MIRFieldID]) -> MIRImplDef? {
    method_ids := [MIRFunctionID]{}
    seen_methods := [U64:Bool]{}
    loop key in definition.methods {
        function := jet_codegen_find_function_by_key(functions, key, definition.module_identity)
        if function == None -> next
        id := jet_codegen_function_id(function ?? panic("checked impl method lookup lost its TFunc"))
        if seen_methods.get(id.value) == None {
            _ := &seen_methods.add(id.value, true)
            &method_ids.push(id)
        }
    }
    if definition.methods.len() > 0 && method_ids.len() == 0 -> return None
    trait_name := if definition.trait_ref == {
        Val(name) -> Val(name)
        None -> definition.trait_name
    }
    trait_ref := if trait_name == {
        None -> None
        Val(name) -> Val(jet_codegen_lower_declared_or_builtin_trait_ref(modules, name, definition.module_identity))
    }
    associated_types := [MIRAssociatedTypeValue]{}
    loop value in definition.associated_types {
        &associated_types.push(MIRAssociatedTypeValue{
            name: value.name,
            ty: jet_codegen_lower_type_with_modules(value.ty, modules, definition.module_identity, [String]{}),
            span: value.span,
        })
    }
    delegation := if definition.delegation_field == {
        None -> None
        Val(name) -> fields_by_name.get(name)
    }
    serde := if definition.serde == {
        None -> None
        Val(codec) -> if codec == {
            .Encode -> Val(MIRSerdeCodec.Encode)
            .Decode -> Val(MIRSerdeCodec.Decode)
        }
    }
    operator_marker := if definition.operator_marker == {
        None -> None
        Val(marker) -> if marker == {
            .Commutative -> Val(MIROperatorMarker.Commutative)
        }
    }
    operator_rhs := if definition.operator_rhs == {
        None -> None
        Val(ty) -> Val(jet_codegen_lower_type_with_modules(ty, modules, definition.module_identity, [String]{}))
    }
    return MIRImplDef{
        id: MIRImplID{value: stable_id("mir-impl", definition.key)},
        module_id: mir_module_id(definition.module_identity),
        key: definition.key,
        span: definition.span,
        self_type: jet_codegen_lower_type_with_modules(definition.self_type, modules, definition.module_identity, [String]{}),
        trait_ref: trait_ref,
        associated_types: associated_types,
        methods: method_ids,
        delegation: delegation,
        compiler_generated: definition.compiler_generated,
        serde: serde,
        operator_marker: operator_marker,
        operator_rhs: operator_rhs,
        target_os: jet_codegen_lower_target_os(definition.target_os),
        target_applicability: MIRTargetApplicability{rust_aot: true, cranelift: true, interpreter: true, web: true},
    }
}

fn jet_codegen_constant_is_output_type(ty: Type, modules: [SemaGraphModuleResult], module_identity: String) -> Bool Never! {
    return if ty == {
        .Named(name) -> {
            if name == "Output" || name == "OutputDefaults" -> return true
            nominal := jet_codegen_find_nominal_identity(modules, module_identity, name, [String]{})
            if nominal == .Val(value) -> return value.name == "Output" || value.name == "OutputDefaults"
            false
        }
        else -> false
    }
}

pub struct JetCodegenConstantIndex {
    pub rows: [String:JetCodegenConstantRow]
    pub forced_static: [String:Bool]
    pub forced_inline: [String:Bool]
    pub copies_into_uses: [String:Bool]
}

pub struct JetCodegenConstantRow {
    pub module_index: Int
    pub definition_index: Int
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::inline_known_constant_reads
fn jet_codegen_constant_index(modules: [SemaGraphModuleResult]) -> JetCodegenConstantIndex Never! {
    rows := [String:JetCodegenConstantRow]{}
    forced_static := [String:Bool]{}
    forced_inline := [String:Bool]{}
    loop module_row in 0..<modules.len() {
        loop definition_row in 0..<modules[module_row].declarations.constants.len() {
            key :: modules[module_row].declarations.constants[definition_row].key
            if rows.get(key) == None -> _ := &rows.add(key, JetCodegenConstantRow{module_index: module_row, definition_index: definition_row})
        }
        loop constant in modules[module_row].constants {
            key := jet_codegen_qualified_function_key(modules[module_row].module_identity, constant.symbol.id.key)
            loop attr in constant.declaration.attrs {
                if attr == ConstAttr.ForceStatic -> _ := &forced_static.add(key, true)
                if attr == ConstAttr.ForceInline -> _ := &forced_inline.add(key, true)
            }
        }
    }
    JetCodegenConstantIndex{rows: rows, forced_static: forced_static, forced_inline: forced_inline, copies_into_uses: [String:Bool]{}}
}

// Card #4258 (D-CONSTMARK1): a read of an immutable module constant copies
// its folded value into the use site when the value is a scalar, short text,
// or a small record or enum case of those, so the optimizer folds it and no
// backend calls an accessor. `#Static` keeps the one addressable item and
// `#Inline` copies any value; tables stay one shared item, cached when large.
// The Rust bootstrap mirrors this in `inline_known_constant_reads`.
// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::inline_known_constant_reads
fn jet_codegen_constant_copies_into_uses(definition: TConstantDef, modules: [SemaGraphModuleResult], forced_static: Bool, forced_inline: Bool) -> Bool Never! {
    if jet_codegen_constant_is_output_type(definition.ty, modules, definition.module_identity) -> return true
    if definition.is_storage -> return false
    if forced_static -> return false
    if forced_inline -> return true
    if definition.value == .Closure(_) -> return definition.is_comptime
    leaves :: jet_codegen_constant_use_site_leaves(definition.value)
    leaves >= 0 && leaves <= 8
}

// The scalar leaves of a value that may be copied into a use site: scalars and
// text of at most 256 bytes, through records, enum cases, and present
// optionals. Any other value (tables, bytes, failures) is -1.
fn jet_codegen_constant_use_site_leaves(value: TComptimeValue) -> Int Never! {
    return if value == {
        .Int(_) | .Float(_, _) | .Bool(_) | .Char(_) | .BigInt(_) | .Unit -> 1
        .String(text) -> if text.bytes().len() <= 256 -> 1 else -> -1
        .Struct(_, fields) -> {
            total := 0
            loop field in fields {
                leaves :: jet_codegen_constant_use_site_leaves(field.value)
                if leaves < 0 -> return -1
                total += leaves
            }
            total
        }
        .Enum(_, _, args) -> {
            total := 0
            loop argument in args {
                leaves :: jet_codegen_constant_use_site_leaves(argument.value)
                if leaves < 0 -> return -1
                total += leaves
            }
            total
        }
        .Present(inner) -> jet_codegen_constant_use_site_leaves(inner)
        else -> -1
    }
}

// Every module constant a body may read through a `Global` keeps its row
// (Rust `lower_constant_rows`): runtime constants, storage, and prepared
// constants whose value is folded, also when every read was copied into its
// use site; the emitter writes an accessor only for rows still read through
// `Global`. A prepared `Unit` and an `Output`/`OutputDefaults` value have none.
fn jet_codegen_lower_constant_definition(definition: TConstantDef, modules: [SemaGraphModuleResult]) -> MIRConstantDef? {
    if jet_codegen_constant_is_output_type(definition.ty, modules, definition.module_identity) -> return None
    if definition.is_comptime && definition.value == .Unit -> return None
    value :: jet_codegen_lower_comptime_value(definition.value, modules, definition.module_identity, [String]{}) ?? return None
    return MIRConstantDef{
        id: MIRConstantID{value: stable_id("mir-constant", definition.key)},
        module_id: mir_module_id(definition.module_identity),
        key: definition.key,
        name: definition.name,
        span: definition.span,
        visibility: jet_codegen_lower_visibility(definition.visibility),
        ty: jet_codegen_lower_type_with_modules(definition.ty, modules, definition.module_identity, [String]{}),
        is_storage: definition.is_storage,
        value: value,
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::inline_known_constant_reads
fn jet_codegen_lower_constant_reference(builder: &JetCodegenBuilder, expression: TExpr, symbol: SymbolID) -> MIRValueID {
    if jet_codegen_find_function_row(builder.function_index, symbol.key) != None {
        return jet_codegen_lower_named_function_value(&builder, expression, symbol.key, false)
    }
    row :: builder.owners.constants.rows.get(symbol.key) ?? panic("checked constant reference has no declaration or function target")
    // Copied out of the builder, which the emits below write through.
    definition :: ~builder.modules[row.module_index].declarations.constants[row.definition_index]
    copies := builder.owners.constants.copies_into_uses.get(symbol.key)
    if copies == None {
        qualified := jet_codegen_qualified_function_key(definition.module_identity, definition.key)
        decision := jet_codegen_constant_copies_into_uses(definition, builder.modules, builder.owners.constants.forced_static.get(qualified) != None, builder.owners.constants.forced_inline.get(qualified) != None)
        _ := &builder.owners.constants.copies_into_uses.add(symbol.key, decision)
        copies = Val(decision)
    }
    if !(copies ?? false) -> return jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Global{name: definition.key})
    constant := jet_codegen_lower_comptime_value(definition.value, builder.modules, definition.module_identity, builder.generic_type_names) ?? {
        if definition.is_comptime -> panic("checked compile-time constant reference has no MIR value")
        return jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Global{name: definition.key})
    }
    // A sized-integer read keeps its width, as a literal does.
    if constant == {
        .Int(number, width, spelling) -> {
            if width == None -> constant = MIRConstant.Int{value: number, width: jet_codegen_pattern_integer_width(expression.ty), spelling: spelling}
        }
        else -> {}
    }
    return jet_codegen_emit_value(&builder, expression.span, expression.ty, MIROperation.Constant{value: constant})
}

fn jet_codegen_tuple_shape_names(name: String) -> MIRShapeFieldNames Never! {
    argument_bytes := [U8]{}
    environment_bytes := [U8]{}
    loop byte in name.bytes() {
        code := Int.from_u8(byte)
        if code == 95 -> &argument_bytes.push(U8{45}) else -> &argument_bytes.push(byte)
        if {
            code == 45 -> &environment_bytes.push(U8{95})
            code >= 97 && code <= 122 -> &environment_bytes.push(U8{code - 32})
            else -> &environment_bytes.push(byte)
        }
    }
    return MIRShapeFieldNames{
        text: name,
        json: None,
        cbor: None,
        csv: None,
        toml: None,
        yaml: None,
        xml: None,
        args: String.from_bytes(argument_bytes) ?? name,
        env: String.from_bytes(environment_bytes) ?? name,
        db: None,
        layout: None,
    }
}

// `seen` holds the field-ID values already emitted, program-wide.
fn jet_codegen_append_tuple_field_rows(ty: MIRType, rows: &[MIRFieldRow], seen: &[U64:Bool]) Never! {
    _ := if ty.kind == {
        .Tuple(fields) -> {
            if {
                ty.identity != None -> {
                    owner :: ty.identity ?? panic("tuple MIR type has no identity")
                    loop field in fields {
                        id := mir_field_id("{mir_type_identity_key(ty)}::{field.name}")
                        if seen.get(id.value) == None {
                            &rows.push(MIRFieldRow{
                                id: id,
                                owner: owner,
                                field: MIRField{
                                    id: id,
                                    name: field.name,
                                    shape_names: jet_codegen_tuple_shape_names(field.name),
                                    skip: false,
                                    ty: field.ty,
                                    span: Span{start: 0, end: 0},
                                    public: true,
                                    package_public: true,
                                    computed: false,
                                    has_default: false,
                                    redact: false,
                                },
                            })
                            seen[id.value] = true
                        }
                        jet_codegen_append_tuple_field_rows(field.ty, &rows, &seen)
                    }
                } else -> {
                    loop field in fields -> jet_codegen_append_tuple_field_rows(field.ty, &rows, &seen)
                }
            }
            ()
        }
        .List(inner) -> {
            jet_codegen_append_tuple_field_rows(inner, &rows, &seen)
            ()
        }
        .Shared(inner) -> {
            jet_codegen_append_tuple_field_rows(inner, &rows, &seen)
            ()
        }
        .Option(inner) -> {
            jet_codegen_append_tuple_field_rows(inner, &rows, &seen)
            ()
        }
        .FixedList(inner, _) -> {
            jet_codegen_append_tuple_field_rows(inner, &rows, &seen)
            ()
        }
        .InlineRange(inner, _, _) -> {
            jet_codegen_append_tuple_field_rows(inner, &rows, &seen)
            ()
        }
        .Tagged(_, inner) -> {
            jet_codegen_append_tuple_field_rows(inner, &rows, &seen)
            ()
        }
        .Quantity(inner, _) -> {
            jet_codegen_append_tuple_field_rows(inner, &rows, &seen)
            ()
        }
        .Map(key, value) -> {
            jet_codegen_append_tuple_field_rows(key, &rows, &seen)
            jet_codegen_append_tuple_field_rows(value, &rows, &seen)
            ()
        }
        .Result(ok, error) -> {
            jet_codegen_append_tuple_field_rows(ok, &rows, &seen)
            jet_codegen_append_tuple_field_rows(error, &rows, &seen)
            ()
        }
        .Fn(signature) -> {
            loop param in signature.params -> jet_codegen_append_tuple_field_rows(param, &rows, &seen)
            if signature.ret != None {
                ret :: signature.ret ?? panic("function MIR signature lost its return type")
                jet_codegen_append_tuple_field_rows(ret, &rows, &seen)
            }
            ()
        }
        .SendFn(params, ret, _) -> {
            loop param in params -> jet_codegen_append_tuple_field_rows(param, &rows, &seen)
            if ret != None {
                return_type :: ret
                jet_codegen_append_tuple_field_rows(return_type, &rows, &seen)
            }
            ()
        }
        .Apply(_, args) -> {
            loop argument in args -> jet_codegen_append_tuple_field_rows(argument, &rows, &seen)
            ()
        }
        .Union(args) -> {
            loop argument in args -> jet_codegen_append_tuple_field_rows(argument, &rows, &seen)
            ()
        }
        else -> ()
    }
}

fn jet_codegen_append_type_definition_fields(definition: MIRTypeDef, rows: &[MIRFieldRow], seen: &[U64:Bool]) Never! {
    _ := if definition.kind == {
        .Struct(fields, _) -> {
            loop field in fields {
                if seen.get(field.id.value) == None {
                    &rows.push(MIRFieldRow{id: field.id, owner: definition.id, field: field})
                    seen[field.id.value] = true
                }
                jet_codegen_append_tuple_field_rows(field.ty, &rows, &seen)
            }
            ()
        }
        .Enum(variants, _) -> {
            loop variant in variants {
                _ := if variant.payload == {
                    .Single(value) -> {
                        jet_codegen_append_tuple_field_rows(value, &rows, &seen)
                        ()
                    }
                    .Named(fields) -> {
                        loop field in fields {
                            if seen.get(field.id.value) == None {
                                &rows.push(MIRFieldRow{id: field.id, owner: definition.id, field: field})
                                seen[field.id.value] = true
                            }
                            jet_codegen_append_tuple_field_rows(field.ty, &rows, &seen)
                        }
                        ()
                    }
                    .Unit -> ()
                }
            }
            ()
        }
        .Distinct(base, _) -> {
            jet_codegen_append_tuple_field_rows(base, &rows, &seen)
            ()
        }
        .Alias(target) -> {
            jet_codegen_append_tuple_field_rows(target, &rows, &seen)
            ()
        }
        .UnitFamily(_) -> ()
    }
}

fn jet_codegen_append_failure_tuple_rows(failure: MIRFailureCarrier, rows: &[MIRFieldRow], seen: &[U64:Bool]) Never! {
    _ := if failure == {
        .Infallible -> ()
        .Result(success, error) -> {
            jet_codegen_append_tuple_field_rows(success, &rows, &seen)
            jet_codegen_append_tuple_field_rows(error, &rows, &seen)
            ()
        }
        .Optional(value) -> {
            jet_codegen_append_tuple_field_rows(value, &rows, &seen)
            ()
        }
        .Diverges(value) -> {
            jet_codegen_append_tuple_field_rows(value, &rows, &seen)
            ()
        }
    }
}

fn jet_codegen_lower_field_rows(types: [MIRTypeDef], functions: [MIRFunction], traits: [MIRTraitDef], impls: [MIRImplDef], constants: [MIRConstantDef]) -> [MIRFieldRow] Never! {
    rows := [MIRFieldRow]{}
    seen := [U64:Bool]{}
    loop definition in types {
        jet_codegen_append_type_definition_fields(definition, &rows, &seen)
        if definition.cli != None {
            entry :: definition.cli ?? panic("MIR CLI entry disappeared while collecting field rows")
            loop input in entry.inputs -> jet_codegen_append_tuple_field_rows(input.ty, &rows, &seen)
            loop command in entry.commands {
                loop input in command.inputs -> jet_codegen_append_tuple_field_rows(input.ty, &rows, &seen)
            }
        }
    }
    loop function in functions {
        jet_codegen_append_tuple_field_rows(function.return_type, &rows, &seen)
        jet_codegen_append_failure_tuple_rows(function.failure, &rows, &seen)
        if function.declared_return != None {
            ty :: function.declared_return ?? panic("MIR function return type disappeared while collecting field rows")
            jet_codegen_append_tuple_field_rows(ty, &rows, &seen)
        }
        loop parameter in function.params -> jet_codegen_append_tuple_field_rows(parameter.ty, &rows, &seen)
        loop parameter in function.capture_params -> jet_codegen_append_tuple_field_rows(parameter.ty, &rows, &seen)
        loop local in function.locals -> jet_codegen_append_tuple_field_rows(local.ty, &rows, &seen)
        loop value in function.values -> jet_codegen_append_tuple_field_rows(value.ty, &rows, &seen)
        loop place in function.places -> jet_codegen_append_tuple_field_rows(place.ty, &rows, &seen)
    }
    loop definition in traits {
        loop method in definition.methods {
            loop parameter in method.params -> jet_codegen_append_tuple_field_rows(parameter.ty, &rows, &seen)
            jet_codegen_append_tuple_field_rows(method.return_type, &rows, &seen)
            if method.declared_return != None {
                ty :: method.declared_return ?? panic("MIR trait method return type disappeared while collecting field rows")
                jet_codegen_append_tuple_field_rows(ty, &rows, &seen)
            }
            jet_codegen_append_failure_tuple_rows(method.failure, &rows, &seen)
        }
    }
    loop implementation in impls {
        jet_codegen_append_tuple_field_rows(implementation.self_type, &rows, &seen)
        loop associated in implementation.associated_types -> jet_codegen_append_tuple_field_rows(associated.ty, &rows, &seen)

        if implementation.operator_rhs != None {
            ty :: implementation.operator_rhs ?? panic("MIR impl operator type disappeared while collecting field rows")
            jet_codegen_append_tuple_field_rows(ty, &rows, &seen)
        }
    }
    loop constant in constants -> jet_codegen_append_tuple_field_rows(constant.ty, &rows, &seen)
    return rows
}
fn jet_codegen_core_effect_name(effect_value: Effect?) -> String? {
    return if effect_value == {
        None -> None
        Val(effect_kind) -> if effect_kind == {
            .Net -> Val("Net")
            .FS -> Val("FS")
            .IO -> Val("IO")
            .DB -> Val("DB")
            .Time -> Val("Time")
            .Rand -> Val("Rand")
            .Env -> Val("Env")
            .Exec -> Val("Exec")
            .Log -> Val("Log")
            .GPU -> Val("GPU")
            .Panic -> Val("Panic")
            .FFI -> Val("FFI")
            .Browser -> Val("Browser")
            .Secret -> Val("Secret")
            .Mem -> Val("Mem")
        }
    }
}

fn jet_codegen_core_call_fallibility(carrier: TFailureCarrier, builder: JetCodegenBuilder) -> MIRCallFallibility Never! {
    if carrier == {
        .Infallible -> MIRCallFallibility.Infallible
        else -> MIRCallFallibility.Failure{failure: jet_codegen_lower_failure(carrier, builder)}
    }
}

fn jet_codegen_core_route_fallibility_identity(carrier: TFailureCarrier) -> String Never! {
    if carrier == {
        .Infallible -> "Infallible"
        .Result(success, error) -> "Failure(Result({type_identity_key(success)},{type_identity_key(error)}))"
        .Optional(value) -> "Failure(Optional({type_identity_key(value)}))"
        .Diverges(value) -> "Failure(Diverges({type_identity_key(value)}))"
    }
}

fn jet_codegen_intern_core_route(builder: &JetCodegenBuilder, record: CoreCallRecord, carrier: TFailureCarrier) -> MIRPreludeCallID Never! {
    symbol := if record.symbol == {
        .Prelude(name) -> MIRSymbol.Prelude{name: name}
        .Rust(name) -> MIRSymbol.Runtime{name: name}
    }
    module_name := record.module_name
    if module_name == "" -> module_name = "receiver({record.receiver_types.join("|")})"
    mask_names := [String]{}
    loop borrowed in record.signature.borrow_mask {
        if borrowed -> &mask_names.push("true") else -> &mask_names.push("false")
    }
    effect_identity := "None"
    if record.effect_kind != None {
        effect_kind :: record.effect_kind ?? panic("checked Core-call effect disappeared during MIR lowering")
        effect_name :: jet_codegen_core_effect_name(Val(effect_kind)) ?? panic("Core-call effect lost its name")
        effect_identity = "Some({effect_name})"
    }
    identity := "StaticPrelude:{module_name}:{record.member}:{core_call_symbol_name(record.symbol)}:{record.signature.arity}:{record.signature.max_arity}:[{mask_names.join(", ")}]:{effect_identity}:{jet_codegen_core_route_fallibility_identity(carrier)}:Value"
    id := MIRPreludeCallID{value: stable_id("mir-prelude-call", identity)}
    row := MIRPreludeCall{
        id: id,
        family: MIRPreludeFamily.StaticPrelude,
        module_name: module_name,
        member: record.member,
        symbol: symbol,
        signature: MIRCallSignature{arity: record.signature.arity, max_arity: record.signature.max_arity, borrow_mask: record.signature.borrow_mask},
        effect_kind: record.effect_kind,
        fallibility: jet_codegen_core_call_fallibility(carrier, builder),
        abi: MIRPreludeABI.Value,
        authority: record.authority,
        db_metadata: None,
    }
    return jet_codegen_intern_prelude_call(&builder, row)
}

fn jet_codegen_core_call_row(record: CoreCallRecord) -> MIRCoreCall Never! {
    key := core_call_key(record)
    return MIRCoreCall{
        id: MIRCoreCallID{value: stable_id("core-call", key)},
        key: key,
        module_name: record.module_name,
        member: record.member,
        receiver_types: record.receiver_types,
        arity: record.signature.arity,
        max_arity: record.signature.max_arity,
        borrow_mask: record.signature.borrow_mask,
        fallibility: record.fallibility,
        effect_kind: record.effect_kind,
        effect_leaf: record.effect_leaf,
        sink_class: record.sink_class,
        pure_route: record.pure_route,
        interpreter_route: record.interpreter_route,
        symbol: record.symbol,
        coverage_bits: record.coverage.bits,
        aot_direct: record.aot_direct,
        jit_direct: record.jit_direct,
        jit_symbol: record.jit_symbol,
        marker: record.marker,
    }
}

fn jet_codegen_string_rows_equal(left: [String], right: [String]) -> Bool Never! {
    if left.len() != right.len() -> return false
    index := 0
    loop index < left.len() {
        if left[index] != right[index] -> return false
        index += 1
    }
    true
}

fn jet_codegen_bool_rows_equal(left: [Bool], right: [Bool]) -> Bool Never! {
    if left.len() != right.len() -> return false
    index := 0
    loop index < left.len() {
        if left[index] != right[index] -> return false
        index += 1
    }
    true
}

fn jet_codegen_core_markers_equal(left: CoreMarkerApplication?, right: CoreMarkerApplication?) -> Bool Never! {
    if left == {
        None -> right == None
        Val(first) -> {
            if right == {
                None -> false
                Val(second) -> first.member == second.member && first.since == second.since && first.replacement == second.replacement && first.removed_in == second.removed_in
            }
        }
    }
}

fn jet_codegen_core_access_rows_equal(left: [CoreCallResourceAccess], right: [CoreCallResourceAccess]) -> Bool Never! {
    if left.len() != right.len() -> return false
    index := 0
    loop index < left.len() {
        if left[index].argument != right[index].argument || left[index].mode != right[index].mode -> return false
        index += 1
    }
    true
}

fn jet_codegen_core_completion_equal(left: CoreCallCompletion?, right: CoreCallCompletion?) -> Bool Never! {
    if left == {
        None -> right == None
        Val(first) -> {
            if right == {
                None -> false
                Val(second) -> first.kind == second.kind && first.token == second.token && first.provider == second.provider
            }
        }
    }
}

fn jet_codegen_core_capability_equal(left: CoreCapabilityContract, right: CoreCapabilityContract) -> Bool Never! {
    left.kind == right.kind && left.provider == right.provider && left.fallback == right.fallback && left.failure == right.failure
}
fn jet_codegen_authority_decisions_equal(left: MIRAuthorityDecision?, right: MIRAuthorityDecision?) -> Bool Never! {
    if left == None -> return right == None
    if right == None -> return false
    first :: left
    second :: right
    first.import.id == second.import.id
        && first.import.operation == second.import.operation
        && first.import.required_right == second.import.required_right
        && jet_codegen_string_rows_equal(first.import.parameter_type_ids, second.import.parameter_type_ids)
        && first.import.result_type_id == second.import.result_type_id
        && first.authority_argument == second.authority_argument
        && first.inherited == second.inherited
}


fn jet_codegen_core_records_match(left: CoreCallRecord, right: CoreCallRecord) -> Bool Never! {
    if left.module_name != right.module_name || left.member != right.member || !jet_codegen_string_rows_equal(left.receiver_types, right.receiver_types) -> return false
    if left.signature.arity != right.signature.arity || left.signature.max_arity != right.signature.max_arity || !jet_codegen_bool_rows_equal(left.signature.borrow_mask, right.signature.borrow_mask) -> return false
    if left.fallibility != right.fallibility || left.effect_kind != right.effect_kind || left.effect_leaf != right.effect_leaf || left.sink_class != right.sink_class -> return false
    if left.pure_route != right.pure_route || left.interpreter_route != right.interpreter_route || left.symbol != right.symbol -> return false
    if left.coverage.bits != right.coverage.bits || left.aot_direct != right.aot_direct || left.jit_direct != right.jit_direct || left.jit_symbol != right.jit_symbol -> return false
    if !jet_codegen_core_access_rows_equal(left.frame_accesses, right.frame_accesses) || !jet_codegen_core_completion_equal(left.frame_completion, right.frame_completion) || !jet_codegen_core_capability_equal(left.capability, right.capability) || !jet_codegen_string_rows_equal(left.ui_capabilities, right.ui_capabilities) -> return false
    jet_codegen_authority_decisions_equal(left.authority, right.authority) && jet_codegen_core_markers_equal(left.marker, right.marker)
}

fn jet_codegen_canonical_core_record(record: CoreCallRecord) -> CoreCallRecord Never! {
    jet_codegen_canonical_core_record_in(CORE_CALLS, record)
}

// The registry is a read parameter, so the scan reads its rows in place.
fn jet_codegen_canonical_core_record_in(rows: [CoreCallRecord], record: CoreCallRecord) -> CoreCallRecord Never! {
    key := core_call_key(record)
    found := CoreCallRecord?{None}
    loop candidate in rows {
        if core_call_key(candidate) == key {
            if found != None -> panic("duplicate canonical Core-call key")
            found = Val(candidate)
        }
    }
    canonical :: found ?? panic("checked Core-call record is absent from the canonical registry")
    if !jet_codegen_core_records_match(canonical, record) -> panic("checked Core-call metadata disagrees with the canonical registry")
    canonical
}

fn jet_codegen_note_core_module(builder: &JetCodegenBuilder, module_name: String) Never! {
    if module_name != "core" && !module_name.starts_with("core.") -> return
    loop existing in builder.used_core {
        if existing == module_name -> return
    }
    &builder.used_core.push(module_name)
}

fn jet_codegen_intern_core_call(builder: &JetCodegenBuilder, record: CoreCallRecord) -> MIRCoreCallID Never! {
    row := jet_codegen_core_call_row(record)
    loop existing in builder.core_calls {
        if existing.id == row.id {
            if existing.key != row.key -> panic("Core-call stable identity collision during MIR lowering")
            return existing.id
        }
    }
    &builder.core_calls.push(row)
    if record.module_name != "" -> jet_codegen_note_core_module(&builder, record.module_name)
    row.id
}

fn jet_codegen_lower_visibility(visibility: TVisibility) -> MIRVisibility Never! {
    if visibility == {
        .Private -> MIRVisibility.Private
        .Package -> MIRVisibility.Package
        .Public -> MIRVisibility.Public
    }
}

fn jet_codegen_lower_web_bucket(bucket: WebBucket?) -> MIRWebBucket? {
    return if bucket == {
        None -> None
        Val(web_bucket) -> if web_bucket == {
            .JS -> Val(MIRWebBucket.JS)
            .Wasm -> Val(MIRWebBucket.Wasm)
        }
    }
}

fn jet_codegen_lower_web_marker(marker: WebPartitionMarker?) -> MIRWebPartitionMarker? {
    return if marker == {
        None -> None
        Val(partition_marker) -> if partition_marker == {
            .JS -> Val(MIRWebPartitionMarker.JS)
            .Wasm -> Val(MIRWebPartitionMarker.Wasm)
            .WasmExport -> Val(MIRWebPartitionMarker.WasmExport)
        }
    }
}

fn jet_codegen_lower_failure(failure: TFailureCarrier, builder: JetCodegenBuilder) -> MIRFailureCarrier Never! {
    if failure == {
        .Infallible -> MIRFailureCarrier.Infallible
        .Result(success, error) -> MIRFailureCarrier.Result{success: jet_codegen_lower_type_for_function(success, builder), error: jet_codegen_lower_type_for_function(error, builder)}
        .Optional(value) -> MIRFailureCarrier.Optional{value: jet_codegen_lower_type_for_function(value, builder)}
        .Diverges(value) -> MIRFailureCarrier.Diverges{value: jet_codegen_lower_type_for_function(value, builder)}
    }
}

fn jet_codegen_lower_parameter(builder: &JetCodegenBuilder, parameter: TParameter, index: Int) Never! {
    access := jet_codegen_lower_access(parameter.convention)
    lowered_ty :: jet_codegen_lower_type_for_function(parameter.ty, builder)
    value := jet_codegen_emit_mir_type(&builder, parameter.span, lowered_ty, mir_ownership_from_access(access), MIROperation.Parameter{index: index, name: parameter.name})
    _ := jet_codegen_bind_local(&builder, parameter.local, parameter.ty, parameter.local.mutable, Val(value), Val(access), false)
    &builder.params.push(MIRParam{
        index: index,
        name: parameter.name,
        span: parameter.span,
        ty: lowered_ty,
        access: access,
        ownership: mir_ownership_from_access(access),
        public_label: parameter.public_label,
        variadic: parameter.variadic,
        default_present: parameter.default != None,
    })
}

fn jet_codegen_lower_generic_params(params: [TGenericParam], modules: [SemaGraphModuleResult]) -> [MIRGenericParam] Never! {
    lowered := [MIRGenericParam]{}
    loop param in params {
        bounds := [MIRTraitRef]{}
        loop bound in param.bounds -> &bounds.push(jet_codegen_mir_trait_ref_for_symbol(modules, bound))
        &lowered.push(MIRGenericParam{name: param.name, bounds: bounds})
    }
    lowered
}

fn jet_codegen_lower_kernel_proof(proof: KernelProof?) -> MIRKernelFacts? {
    if proof == {
        None -> None
        Val(value) -> {
            if value.mode != KernelMode.Parallel -> panic("checked kernel proof uses an unsupported MIR kernel mode")
            Val(MIRKernelFacts{
                bounds: value.bounds,
                alias_free: value.alias_free,
                captures: value.captures,
                race_free: value.race_free,
                barriers_uniform: value.barriers_uniform,
                control_flow: value.control_flow,
            })
        }
    }
}

fn jet_codegen_lower_web_reconstructions(builder: JetCodegenBuilder, rows: [TWebParamReconstruction]) -> [MIRWebParamReconstruction] Never! {
    lowered := [MIRWebParamReconstruction]{}
    loop row in rows {
        fields := [MIRWebParamField]{}
        loop field in row.fields -> &fields.push(MIRWebParamField{field: field.field, parameter: field.parameter, ty: jet_codegen_lower_type_for_function(field.ty, builder)})
        &lowered.push(MIRWebParamReconstruction{local: row.local.name, ty: jet_codegen_lower_type_for_function(row.ty, builder), fields: fields})
    }
    lowered
}


fn jet_codegen_sort_blocks(blocks: &[MIRBasicBlock]) Never! {
    keys := [U64]{}
    loop block in blocks -> &keys.push(block.id.value)
    sorted := [MIRBasicBlock]{}
    loop position in jet_codegen_sorted_order(keys, [String]{}) -> &sorted.push(blocks[position])
    loop (index, block) in sorted -> blocks[index] = block
}
fn jet_codegen_lower_receiver(builder: &JetCodegenBuilder, owner_type: Type, convention: AccessConvention?, span: Span, index: Int) Never! {
    access := if convention == {
        None -> MIRAccess.Read
        Val(value) -> jet_codegen_lower_access(value)
    }
    lowered_ty :: jet_codegen_lower_type_for_function(owner_type, builder)
    value := jet_codegen_emit_mir_type(&builder, span, lowered_ty, mir_ownership_from_access(access), MIROperation.Parameter{index: index, name: "self"})
    local := TLocal{
        name: "self",
        symbol_id: Val(symbol_id(SymbolKind.Parameter, builder.function.module_identity, builder.function.key, "self")),
        span: span,
        generated: false,
        deref: false,
        address_lifetime: None,
        persist_key: None,
        persist_ty: None,
        mutable: access == MIRAccess.Write,
        string_bytes_source: None,
        integer_bounds: None,
        uninit_scalar: false,
        uninit_fixed: false,
        direct_closure: false,
    }
    _ := jet_codegen_bind_local(&builder, local, owner_type, local.mutable, Val(value), Val(access), false)
    &builder.params.push(MIRParam{
        index: index,
        name: "self",
        span: span,
        ty: lowered_ty,
        access: access,
        ownership: mir_ownership_from_access(access),
        public_label: "self",
        variadic: false,
        default_present: false,
    })
}

fn jet_codegen_lower_function_form(function: TFunc, builder: JetCodegenBuilder) -> MIRFunctionForm Never! {
    return if function.kind == {
        .TopLevel -> MIRFunctionForm.TopLevel
        .Method(convention, owner_type) -> {
            self_access := if convention == {
                None -> None
                Val(value) -> Val(jet_codegen_lower_access(value))
            }
            MIRFunctionForm.Method{owner: jet_codegen_lower_type_for_function(owner_type, builder), self_access: self_access}
        }
        .TraitMethod(_, convention, owner_type, trait_symbol, codec) -> {
            self_access := if convention == {
                None -> None
                Val(value) -> Val(jet_codegen_lower_access(value))
            }
            serde := if codec == {
                None -> None
                Val(codec_value) -> if codec_value == {
                    .Encode -> Val(MIRSerdeCodec.Encode)
                    .Decode -> Val(MIRSerdeCodec.Decode)
                }
            }
            trait_ref := jet_codegen_mir_trait_ref_for_symbol(builder.modules, trait_symbol)
            MIRFunctionForm.TraitMethod{owner: jet_codegen_lower_type_for_function(owner_type, builder), trait_ref: trait_ref, self_access: self_access, serde: serde}
        }
    }
}

fn jet_codegen_lambda_capture_facts(lambda: TLambda) -> MIRCaptureFacts Never! {
    MIRCaptureFacts{
        escapes: lambda.capture_facts.escapes,
        needs_fn_mut: lambda.capture_facts.needs_fn_mut,
        mutable: lambda.capture_facts.mutable,
        cloned: lambda.capture_facts.cloned,
        frozen: lambda.capture_facts.frozen,
        materialized: lambda.capture_facts.materialized,
        moved: lambda.capture_facts.moved,
    }
}

// Rust: none (Jet-only pass)
fn jet_codegen_validate_lambda_metadata(lambda: TLambda) Never! {
    if lambda.source_params.len() != lambda.param_types.len() -> panic("checked lambda parameter names and types differ")
    if lambda.source_param_symbols.len() != lambda.source_params.len() -> panic("checked lambda parameter symbol count differs")
    if lambda.host_param_conventions != None {
        conventions :: lambda.host_param_conventions ?? [AccessConvention]{}
        if conventions.len() != lambda.source_params.len() -> panic("checked lambda host convention count differs")
    }
    seen_parameter_symbols := [String:Bool]{}
    loop symbol in lambda.source_param_symbols {
        if symbol.key == "" || seen_parameter_symbols.get(symbol.key) != None -> panic("checked lambda has an empty or duplicate parameter symbol")
        _ := &seen_parameter_symbols.add(symbol.key, true)
    }
    seen_sources := [String:Bool]{}
    seen_runtime := [String:Bool]{}
    seen_capture_symbols := [String:Bool]{}
    loop capture in lambda.captures {
        if capture.source == "" || capture.local.name == "" -> panic("checked lambda has an empty capture slot")
        symbol :: capture.local.symbol_id ?? panic("checked lambda capture has no resolved source symbol")
        if symbol.key == "" || seen_capture_symbols.get(symbol.key) != None -> panic("checked lambda has an empty or duplicate capture symbol")
        if seen_sources.get(capture.source) != None -> panic("checked lambda has a duplicate source capture")
        if seen_runtime.get(capture.local.name) != None -> panic("checked lambda has a duplicate runtime capture")
        _ := &seen_sources.add(capture.source, true)
        _ := &seen_runtime.add(capture.local.name, true)
        _ := &seen_capture_symbols.add(symbol.key, true)
    }
    facts := jet_codegen_lambda_capture_facts(lambda)
    loop name in facts.mutable {
        if seen_sources.get(name) == None -> panic("checked lambda capture facts have no matching capture slot")
    }
    loop name in facts.cloned {
        if seen_sources.get(name) == None -> panic("checked lambda capture facts have no matching capture slot")
    }
    loop name in facts.frozen {
        if seen_sources.get(name) == None -> panic("checked lambda capture facts have no matching capture slot")
    }
    loop name in facts.materialized {
        if seen_sources.get(name) == None -> panic("checked lambda capture facts have no matching capture slot")
    }
    loop name in facts.moved {
        if seen_sources.get(name) == None -> panic("checked lambda capture facts have no matching capture slot")
    }
}

fn jet_codegen_bind_lambda_captures(builder: &JetCodegenBuilder, lambda: TLambda) Never! {
    facts := jet_codegen_lambda_capture_facts(lambda)
    builder.capture_facts = Val(facts)
    slot := 0
    loop capture in lambda.captures {
        moved := facts.moved.contains(capture.source)
        cloned := !moved && (facts.cloned.contains(capture.source) || facts.materialized.contains(capture.source))
        access := if {
            moved -> MIRAccess.Move
            facts.mutable.contains(capture.source) -> MIRAccess.Write
            else -> MIRAccess.Read
        }
        ownership := if {
            moved -> mir_ownership_from_access(MIRAccess.Move)
            cloned -> mir_owned_ownership()
            else -> mir_ownership_from_access(access)
        }
        lowered_ty :: jet_codegen_lower_type_for_function(capture.ty, builder)
        value := jet_codegen_emit_mir_type(&builder, lambda.source_span, lowered_ty, ownership, MIROperation.Capture{slot: slot})
        &builder.capture_params.push(MIRCaptureParam{
            slot: slot,
            name: capture.source,
            span: lambda.source_span,
            ty: lowered_ty,
            access: access,
            ownership: ownership,
        })
        if capture.local.name != capture.source {
            source_local := capture.local
            source_local.name = capture.source
            _ := jet_codegen_bind_capture_local(&builder, source_local, capture.ty, value, access, ownership, false)
        }
        place := jet_codegen_bind_capture_local(&builder, capture.local, capture.ty, value, access, ownership, false)
        if moved -> jet_codegen_register_drop_live(&builder, place, capture.ty, ownership, true)
        slot += 1
    }
}


// Lowers `function` on `builder`, which holds the program-wide inputs; the
// builder's per-function state is reset first (jet_codegen_begin_function).
fn jet_codegen_lower_function(builder: &JetCodegenBuilder, function: TFunc, statements: [TStmt], expression: TExpr?, lambda: TLambda?) -> JetCodegenLoweredFunction {
    // #3740: lower against the executable signature; a plain-return function
    // (`T Never!`) returns its success value directly.
    jet_codegen_begin_function(&builder, jet_codegen_executable_function(function))
    if lambda != None {
        value := lambda
        jet_codegen_validate_lambda_metadata(value)
        jet_codegen_bind_lambda_captures(&builder, value)
    }
    parameter_index := if function.kind == {
        .TopLevel -> 0
        .Method(convention, owner_type) -> {
            if convention == {
                None -> 0
                else -> {
                    jet_codegen_lower_receiver(&builder, owner_type, convention, function.source_span, 0)
                    1
                }
            }
        }
        .TraitMethod(_, convention, owner_type, _, _) -> {
            if convention == {
                None -> 0
                else -> {
                    jet_codegen_lower_receiver(&builder, owner_type, convention, function.source_span, 0)
                    1
                }
            }
        }
    }
    loop parameter in function.params {
        jet_codegen_lower_parameter(&builder, parameter, parameter_index)
        parameter_index += 1
    }
    return_source := builder.function.ret ?? Type.Named{name: "Unit"}
    if {
        expression == None -> {
            jet_codegen_lower_statements(&builder, statements)
        } else -> {
            value :: expression
            lowered_value := jet_codegen_lower_expr(&builder, value)
            if jet_codegen_current_is_open(builder) -> _ := jet_codegen_terminate_with_owned_cleanup(&builder, MIRTerminator.Return{value: Val(lowered_value)}, -1)
        }
    }
    if jet_codegen_current_is_open(builder) {
        if {
            type_is_unit_callable_return(return_source) -> _ := jet_codegen_terminate_with_owned_cleanup(&builder, MIRTerminator.Return{value: None}, -1)
            else -> panic("checked non-Unit TFunc falls through during MIR lowering")
        }
    }
    jet_codegen_seal_all_exit_chains(&builder)
    loop block in builder.blocks {
        if jet_codegen_is_open_terminator(block.terminator) {
            panic("Jet codegen left an unterminated MIR block")
        }
    }
    jet_codegen_move_last_uses(&builder)
    jet_codegen_resolve_drop_flags(&builder)
    optimization := mir_empty_optimization_facts()
    optimization.pure = function.is_pure
    optimization.inline = function.is_inline
    optimization.inline_always = function.is_inline_always
    optimization.gc_return = function.gc_return
    optimization.gc_scope = function.gc_scope
    optimization.kernel = function.kernel_proof != None
    optimization.checked_vector_facts = builder.checked_vector_facts
    blocks := builder.blocks
    jet_codegen_sort_blocks(&blocks)
    declared_return := MIRType?{None}
    if builder.function.ret != None -> declared_return = Val(jet_codegen_lower_type_for_function(return_source, builder))
    foreign_language := String?{None}
    if function.foreign == .Val(provenance) -> foreign_language = Val(provenance.language)
    mir_function := MIRFunction{
        id: jet_codegen_function_id(function),
        module_id: mir_module_id(function.module_identity),
        source_file: mir_source_file_id(function.source_file),
        key: function.key,
        module_name: function.module_name,
        name: function.name,
        span: function.source_span,
        kind: MIRFunctionKind.Jet,
        form: jet_codegen_lower_function_form(function, builder),
        visibility: jet_codegen_lower_visibility(function.visibility),
        target_applicability: MIRTargetApplicability{
            rust_aot: function.target_applicability.rust_aot,
            cranelift: function.target_applicability.cranelift,
            interpreter: function.target_applicability.interpreter,
            web: function.target_applicability.web,
        },
        web_bucket: jet_codegen_lower_web_bucket(function.web_bucket),
        web_marker: jet_codegen_lower_web_marker(function.web_marker),
        generic_params: jet_codegen_lower_generic_params(function.generic_params, builder.modules),
        capture_params: builder.capture_params,
        params: builder.params,
        declared_return: declared_return,
        return_type: jet_codegen_lower_type_for_function(return_source, builder),
        failure: jet_codegen_lower_failure(builder.function.failure_carrier, builder),
        effects: MIREffectFacts{
            direct: function.effects.direct,
            solved: function.effects.solved,
            call_edges: function.effects.call_edges,
            maximal: function.effects.maximal,
            direct_spans: jet_codegen_lower_effect_spans(function.effects.direct_spans),
        },
        captures: builder.capture_facts,
        generator: None,
        optimization: optimization,
        is_unsafe: function.is_unsafe,
        unsafe_gate: jet_codegen_lower_unsafe_gate(function.unsafe_gate),
        is_pure: function.is_pure,
        memo_bound: function.memo_bound,
        memo_unbounded: function.memo_unbounded,
        is_reactive: function.is_reactive,
        reactive_upgrades: function.reactive_upgrades,
        is_inline: function.is_inline,
        is_inline_always: function.is_inline_always,
        is_scalar: function.is_scalar,
        kernel_proof: jet_codegen_lower_kernel_proof(function.kernel_proof),
        gc_return: function.gc_return,
        return_view_provenance: jet_codegen_lower_view_provenance_map(function.return_view_provenance),
        web_param_reconstructions: jet_codegen_lower_web_reconstructions(builder, function.web_param_reconstructions),
        blocks: blocks,
        entry: builder.entry,
        locals: builder.locals,
        values: builder.values,
        places: builder.places,
        scopes: builder.scopes,
        drops: [MIRDropAction]{},
        foreign_language: foreign_language,
    }
    function_rows := [MIRFunction]{mir_function}
    loop nested in builder.nested_functions -> &function_rows.push(nested)
    fields := jet_codegen_lower_field_rows([MIRTypeDef]{}, function_rows, [MIRTraitDef]{}, [MIRImplDef]{}, [MIRConstantDef]{})
    jet_codegen_sort_field_rows(&fields)
    return JetCodegenLoweredFunction{
        function: mir_function,
        nested_functions: builder.nested_functions,
        callbacks: builder.callbacks,
        fields: fields,
        prelude_calls: builder.prelude_calls,
        core_calls: builder.core_calls,
        used_core: builder.used_core,
    }
}

fn jet_codegen_lambda_function_type(lambda: TLambda) -> Type Never! {
    metadata := FunctionCallMetadata?{None}
    if lambda.host_param_conventions != None {
        conventions :: lambda.host_param_conventions ?? [AccessConvention]{}
        metadata = Val(FunctionCallMetadata{
            names: [String]{},
            defaults: [FunctionDefaultRef?]{},
            variadic: [Bool]{},
            conventions: conventions,
            policies: CallablePolicyChain{policies: [CallablePolicy]{}},
        })
    }
    Type.Fn{params: lambda.param_types, ret: lambda.ret, effect_bound: None, param_contract: None, call_metadata: metadata, return_view_provenance: None}
}

fn jet_codegen_send_function_type(builder: JetCodegenBuilder, ty: Type) -> MIRType Never! {
    lowered := jet_codegen_lower_type_for_function(ty, builder)
    if lowered.kind == {
        .Fn(signature) -> {
            conventions := [MIRAccess]{}
            metadata := signature.call_metadata
            index := 0
            loop index < signature.params.len() {
                access := MIRAccess.Read
                if metadata != None {
                    value :: metadata ?? panic("SendFn call metadata disappeared")
                    if index < value.conventions.len() -> access = value.conventions[index]
                }
                &conventions.push(access)
                index += 1
            }
            send_type := mir_type_from_kind(MIRTypeKind.SendFn{params: signature.params, ret: signature.ret, conventions: conventions})
            mir_type_with_identity(send_type, mir_type_id(mir_type_canonical_key(send_type)))
        }
        else -> panic("checked SendFn value has no function signature")
    }
}

fn jet_codegen_emit_owned_value(builder: &JetCodegenBuilder, span: Span, ty: Type, operation: MIROperation) -> MIRValueID Never! {
    lowered_ty :: jet_codegen_lower_type_for_function(ty, builder)
    jet_codegen_emit_mir_type(&builder, span, lowered_ty, mir_owned_ownership(), operation)
}

fn jet_codegen_place_shares_record_handle(builder: JetCodegenBuilder, place: MIRPlaceID) -> Bool Never! {
    row :: jet_codegen_find_place(builder, place) ?? return false
    if row.projections.len() == 0 -> return false
    is_index := if row.projections[row.projections.len() - 1] == {
        .Index(_, _, _, _, _, _, _) -> true
        else -> false
    }
    if !is_index -> return false
    row.ty.layout.abi == MIRABI.Nominal || row.ty.layout.abi == MIRABI.Aggregate || row.ty.layout.abi == MIRABI.Sequence || row.ty.layout.abi == MIRABI.Dynamic
}

fn jet_codegen_same_callback(left: MIRCallbackAdapter, right: MIRCallbackAdapter) -> Bool Never! {
    left.id == right.id &&
        left.symbol == right.symbol &&
        left.function == right.function &&
        left.params == right.params &&
        left.return_type == right.return_type &&
        left.abi == right.abi &&
        left.managed == right.managed &&
        left.plan_digest == right.plan_digest &&
        left.callback_identity == right.callback_identity
}

fn jet_codegen_append_nested_function(builder: &JetCodegenBuilder, function: MIRFunction) Never! {
    loop existing in builder.nested_functions {
        if existing.id == function.id || (existing.module_id == function.module_id && existing.key == function.key) -> panic("duplicate nested MIR function identity")
    }
    &builder.nested_functions.push(function)
}

fn jet_codegen_merge_lowered_child(builder: &JetCodegenBuilder, lowered: JetCodegenLoweredFunction) Never! {
    jet_codegen_append_nested_function(&builder, lowered.function)
    loop nested in lowered.nested_functions -> jet_codegen_append_nested_function(&builder, nested)
    loop callback in lowered.callbacks {
        duplicate := false
        loop existing in builder.callbacks {
            if existing.id == callback.id {
                if !jet_codegen_same_callback(existing, callback) -> panic("conflicting C callback adapter identity")
                duplicate = true
            }
        }
        if !duplicate -> &builder.callbacks.push(callback)
    }
    loop call in lowered.prelude_calls {
        if builder.prelude_call_positions.get(call.id.value) == .Val(position) {
            existing :: builder.prelude_calls[position]
            if existing.family != call.family || existing.module_name != call.module_name || existing.member != call.member || existing.symbol != call.symbol || existing.signature != call.signature || existing.effect_kind != call.effect_kind || !jet_codegen_authority_decisions_equal(existing.authority, call.authority) || existing.fallibility != call.fallibility || existing.abi != call.abi {
                panic("conflicting Prelude route identity across nested functions")
            }
        } else {
            jet_codegen_push_prelude_call(&builder, call)
        }
    }
    loop call in lowered.core_calls {
        duplicate := false
        loop existing in builder.core_calls {
            if existing.id == call.id {
                if existing.key != call.key -> panic("Core-call identity collision across nested functions")
                duplicate = true
            }
        }
        if !duplicate -> &builder.core_calls.push(call)
    }
    loop used_core_module in lowered.used_core {
        if !builder.used_core.contains(used_core_module) -> &builder.used_core.push(used_core_module)
    }
}

fn jet_codegen_lower_lambda(builder: &JetCodegenBuilder, lambda: TLambda, send: Bool, purpose: String) -> JetCodegenLambdaValue {
    jet_codegen_validate_lambda_metadata(lambda)
    base_key := "{builder.function.key}::lambda@{lambda.source_span.start}..{lambda.source_span.end}"
    occurrence := builder.spawn_occurrences.get(base_key) ?? 0
    _ := &builder.spawn_occurrences.add(base_key, occurrence + 1)
    suffix := String?{None}
    if {
        purpose != "" && purpose != "direct" && (purpose != "spawn" || occurrence > 0) -> {
            suffix = Val("{purpose}-{occurrence}")
        }
        occurrence > 0 -> {
            suffix = Val("lambda-{occurrence}")
        }
    }
    key := base_key
    name := "__jet_lambda_{lambda.source_span.start}_{lambda.source_span.end}"
    if suffix != None {
        value :: suffix ?? ""
        key = "{key}::{value}"
        name = "{name}_{value}"
    }
    params := [TParameter]{}
    index := 0
    loop source_name in lambda.source_params {
        ty := lambda.param_types[index]
        convention := AccessConvention.Read
        if lambda.host_param_conventions != None {
            conventions :: lambda.host_param_conventions ?? [AccessConvention]{}
            convention = conventions[index]
        }
        local := tir_symbol_local(source_name, lambda.source_span, lambda.source_param_symbols[index])
        local.mutable = convention == AccessConvention.Write
        &params.push(TParameter{
            local: local,
            name: source_name,
            span: lambda.source_span,
            ty: ty,
            convention: convention,
            public_label: source_name,
            zone: ParamZone.Either,
            default: None,
            variadic: false,
        })
        index += 1
    }
    function := TFunc{
        name: name,
        module_name: builder.function.module_name,
        module_identity: builder.function.module_identity,
        key: key,
        source_file: builder.function.source_file,
        source_span: lambda.source_span,
        failure_carrier: lambda.failure_carrier,
        effects: lambda.effects,
        target_applicability: TTargetApplicability{rust_aot: true, cranelift: true, interpreter: true, web: true},
        web_bucket: builder.function.web_bucket,
        web_marker: None,
        visibility: TVisibility.Private,
        foreign: None,
        params: params,
        web_param_reconstructions: [TWebParamReconstruction]{},
        ret: lambda.ret,
        gc_return: false,
        gc_scope: false,
        return_view_provenance: None,
        generic_params: [TGenericParam]{},
        clone_types: [Type]{},
        is_main: false,
        line: builder.function.line,
        synthetic: true,
        is_unsafe: false,
        unsafe_gate: None,
        is_pure: lambda.effects.direct.len() == 0,
        memo_bound: None,
        memo_unbounded: false,
        is_reactive: false,
        reactive_upgrades: [String]{},
        is_inline: false,
        is_inline_always: false,
        is_scalar: false,
        kernel_proof: None,
        memo_field: None,
        uses_stack_sentry: lambda.uses_stack_sentry,
        body: [TStmt]{},
        kind: TFuncKind.TopLevel,
    }
    statements := [TStmt]{}
    expression := TExpr?{None}
    if lambda.executable == {
        .Expr(value) -> expression = Val(value)
        .Block(body) | .SharedBlock(body) -> statements = body
    }
    // The nested function lowers on the same builder (no program copy); the
    // enclosing function's state is saved around it.
    enclosing := jet_codegen_function_state(builder)
    lowered := jet_codegen_lower_function(&builder, function, statements, expression, Val(lambda))
    jet_codegen_restore_function_state(&builder, enclosing)
    function_id := lowered.function.id
    jet_codegen_merge_lowered_child(&builder, lowered)

    facts := jet_codegen_lambda_capture_facts(lambda)
    captures := [MIRCaptureOperand]{}
    loop capture in lambda.captures {
        moved := facts.moved.contains(capture.source)
        cloned := !moved && (facts.cloned.contains(capture.source) || facts.materialized.contains(capture.source))
        access := if {
            moved -> MIRAccess.Move
            facts.mutable.contains(capture.source) -> MIRAccess.Write
            else -> MIRAccess.Read
        }
        borrowed := (access == MIRAccess.Read || access == MIRAccess.Write) && !cloned
        outer_slot := capture.local.name
        if cloned && capture.local.name != capture.source -> outer_slot = capture.source
        outer_access := if cloned -> MIRAccess.Read else -> access
        outer_local := capture.local
        outer_local.name = outer_slot
        place := jet_codegen_lower_place_for_access(&builder, TPlace.Local{local: outer_local}, outer_access)
        if borrowed {
            &captures.push(MIRCaptureOperand.Place{place: place})
            next
        }
        value := if {
            cloned -> {
                read := jet_codegen_emit_value(&builder, lambda.source_span, capture.ty, MIROperation.ReadPlace{place: place})
                if {
                    facts.mutable.contains(capture.source) && jet_codegen_place_shares_record_handle(builder, place) -> {
                        read
                    } else -> {
                        jet_codegen_emit_owned_value(&builder, lambda.source_span, capture.ty, MIROperation.Copy{value: read, fact: if facts.materialized.contains(capture.source) -> MIRCopyFact.ViewMaterialize else -> MIRCopyFact.Materialize})
                    }
                }
            }
            access == MIRAccess.Move -> {
                jet_codegen_emit_owned_value(&builder, lambda.source_span, capture.ty, MIROperation.MovePlace{place: place})
            }
            else -> {
                jet_codegen_emit_value(&builder, lambda.source_span, capture.ty, MIROperation.ReadPlace{place: place})
            }
        }
        &captures.push(MIRCaptureOperand.Value{value: value})
    }
    capture_facts := jet_codegen_lambda_capture_facts(lambda)
    operation := MIROperation.Closure{function: function_id, captures: captures, facts: capture_facts}
    closure_type := jet_codegen_lambda_function_type(lambda)
    value := if {
        send -> {
            send_ty :: jet_codegen_send_function_type(builder, closure_type)
            jet_codegen_emit_mir_type(&builder, lambda.source_span, send_ty, mir_owned_ownership(), operation)
        } else -> {
            jet_codegen_emit_value(&builder, lambda.source_span, closure_type, operation)
        }
    }
    JetCodegenLambdaValue{value: value, function: function_id}
}

fn jet_codegen_sort_strings(values: [String]) -> [String] Never! {
    sorted := [String]{}
    loop position in jet_codegen_sorted_order([U64]{}, values) -> &sorted.push(values[position])
    unique := [String]{}
    loop value in sorted {
        if unique.len() == 0 || unique[unique.len() - 1] != value -> &unique.push(value)
    }
    unique
}

fn jet_codegen_sort_named_spans(values: [MIRNamedSpan]) -> [MIRNamedSpan] Never! {
    names := [String]{}
    loop value in values -> &names.push(value.name)
    sorted := [MIRNamedSpan]{}
    loop position in jet_codegen_sorted_order([U64]{}, names) -> &sorted.push(values[position])
    unique := [MIRNamedSpan]{}
    loop value in sorted {
        if unique.len() == 0 || unique[unique.len() - 1].name != value.name -> &unique.push(value)
    }
    unique
}

fn jet_codegen_lower_effect_spans(spans: [TEffectSpan]) -> [MIRNamedSpan] Never! {
    lowered := [MIRNamedSpan]{}
    loop span in spans -> &lowered.push(MIRNamedSpan{name: span.name, span: span.span})
    jet_codegen_sort_named_spans(lowered)
}

fn jet_codegen_lower_unsafe_gate(gate: TUnsafeGate?) -> MIRUnsafeGate? {
    if gate == None -> return None
    value :: gate
    Val(MIRUnsafeGate{file: value.file, line: value.line, reason: value.reason, enabled: value.enabled, fenced: value.fenced})
}

fn jet_codegen_comptime_module_name(modules: [SemaGraphModuleResult], module_identity: String) -> String Never! {
    loop semantic_module in modules {
        if semantic_module.module_identity == module_identity -> return semantic_module.module_name
    }
    panic("checked comptime item has no staged Sema module")
}

pub fn lower_comptime_item(request: SemaComptimeItemRequest, reachable_functions: [TFunc], modules: [SemaGraphModuleResult], source_files: [MIRSourceFile]) -> JetCodegenLoweredFunction {
    result_type := request.expression.ty
    if request.expected_type != None {
        expected :: request.expected_type ?? panic("checked comptime item lost its expected type")
        if type_identity_key(expected) != type_identity_key(result_type) -> panic("checked comptime item result disagrees with its expected type")
        result_type = expected
    }
    function := TFunc{
        name: "__comptime_item",
        module_name: jet_codegen_comptime_module_name(modules, request.module_identity),
        module_identity: request.module_identity,
        key: "{request.module_identity}::__comptime_item::{request.key}",
        source_file: request.source_file,
        source_span: request.span,
        failure_carrier: TFailureCarrier.Infallible,
        effects: TEffectFacts{direct: [String]{}, solved: [String]{}, call_edges: [String]{}, maximal: false, direct_spans: [TEffectSpan]{}},
        target_applicability: TTargetApplicability{rust_aot: false, cranelift: false, interpreter: true, web: false},
        web_bucket: None,
        web_marker: None,
        visibility: TVisibility.Private,
        foreign: None,
        params: [TParameter]{},
        web_param_reconstructions: [TWebParamReconstruction]{},
        ret: Val(result_type),
        gc_return: false,
        gc_scope: false,
        return_view_provenance: None,
        generic_params: [TGenericParam]{},
        clone_types: [Type]{},
        is_main: false,
        line: 0,
        synthetic: true,
        is_unsafe: false,
        unsafe_gate: None,
        is_pure: false,
        memo_bound: None,
        memo_unbounded: false,
        is_reactive: false,
        reactive_upgrades: [String]{},
        is_inline: false,
        is_inline_always: false,
        is_scalar: false,
        kernel_proof: None,
        memo_field: None,
        uses_stack_sentry: false,
        body: [TStmt]{},
        kind: TFuncKind.TopLevel,
    }
    builder := jet_codegen_new_builder(function, jet_codegen_function_index(reachable_functions), modules, jet_codegen_field_symbol_index(modules), source_files, jet_codegen_source_index(source_files))
    jet_codegen_lower_function(&builder, function, [TStmt]{}, Val(request.expression), None)
}

// Positions of `keys` in stable ascending (key, tie) order; an empty `keys`
// or `ties` list compares as all-equal. Bottom-up merge sort: O(n log n) on
// the hash-ordered ids the canonical row sorts see, where insertion sort was
// quadratic.
pub fn jet_codegen_sorted_order(keys: [U64], ties: [String]) -> [Int] Never! {
    count :: if keys.len() > ties.len() -> keys.len() else -> ties.len()
    order := [Int]{}
    loop index in 0..<count -> &order.push(index)
    scratch := order
    width := 1
    loop width < count {
        start := 0
        loop start < count {
            middle :: if start + width < count -> start + width else -> count
            stop :: if start + 2 * width < count -> start + 2 * width else -> count
            left := start
            right := middle
            out := start
            loop out < stop {
                take_right := false
                if left >= middle {
                    take_right = true
                } else if right < stop {
                    take_right = jet_codegen_order_before(keys, ties, order[right], order[left])
                }
                if take_right {
                    scratch[out] = order[right]
                    right += 1
                } else {
                    scratch[out] = order[left]
                    left += 1
                }
                out += 1
            }
            start = stop
        }
        merged := scratch
        scratch = order
        order = merged
        width = width * 2
    }
    order
}

fn jet_codegen_order_before(keys: [U64], ties: [String], left: Int, right: Int) -> Bool Never! {
    if keys.len() > 0 && keys[left] != keys[right] -> return keys[left] < keys[right]
    ties.len() > 0 && ties[left] < ties[right]
}

fn jet_codegen_sort_functions(rows: &[MIRFunction]) Never! {
    keys := [U64]{}
    ties := [String]{}
    loop row in rows {
        &keys.push(row.id.value)
        &ties.push(row.key)
    }
    sorted := [MIRFunction]{}
    loop position in jet_codegen_sorted_order(keys, ties) -> &sorted.push(rows[position])
    loop (index, row) in sorted -> rows[index] = row
}

fn jet_codegen_sort_callback_adapters(rows: &[MIRCallbackAdapter]) Never! {
    keys := [U64]{}
    loop row in rows -> &keys.push(row.id.value)
    sorted := [MIRCallbackAdapter]{}
    loop position in jet_codegen_sorted_order(keys, [String]{}) -> &sorted.push(rows[position])
    loop (index, row) in sorted -> rows[index] = row
}

fn jet_codegen_sort_type_definitions(rows: &[MIRTypeDef]) Never! {
    keys := [U64]{}
    loop row in rows -> &keys.push(row.id.value)
    sorted := [MIRTypeDef]{}
    loop position in jet_codegen_sorted_order(keys, [String]{}) -> &sorted.push(rows[position])
    loop (index, row) in sorted -> rows[index] = row
}
struct JetCodegenUnionIndex {
    pub rows: [MIRType]
    pub positions: [U64:Int]
    pub canonical_keys: [String]
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::lower_anonymous_union_type_defs
fn jet_codegen_collect_union_type(ty: MIRType, unions: &JetCodegenUnionIndex) Never! {
    if ty.kind == {
        .Union(members) -> {
            identity :: ty.identity ?? panic("checked structural union has no MIR identity")
            key := mir_type_canonical_key(ty)
            if unions.positions.get(identity.value) == .Val(position) {
                if unions.canonical_keys[position] != key -> panic("structural union identity has conflicting member types")
            } else {
                _ := &unions.positions.add(identity.value, unions.rows.len())
                &unions.rows.push(ty)
                &unions.canonical_keys.push(key)
            }
            loop member in members -> jet_codegen_collect_union_type(member, &unions)
        }
        .List(inner) | .Shared(inner) | .Option(inner) | .FixedList(inner, _) | .InlineRange(inner, _, _) | .Tagged(_, inner) | .Quantity(inner, _) -> jet_codegen_collect_union_type(inner, &unions)
        .Map(key, value) -> {
            jet_codegen_collect_union_type(key, &unions)
            jet_codegen_collect_union_type(value, &unions)
        }
        .Result(ok, err) -> {
            jet_codegen_collect_union_type(ok, &unions)
            jet_codegen_collect_union_type(err, &unions)
        }
        .Fn(signature) -> {
            loop parameter in signature.params -> jet_codegen_collect_union_type(parameter, &unions)
            if signature.ret != None -> jet_codegen_collect_union_type(signature.ret ?? ty, &unions)
        }
        .SendFn(params, ret, _) -> {
            loop parameter in params -> jet_codegen_collect_union_type(parameter, &unions)
            if ret != None -> jet_codegen_collect_union_type(ret, &unions)
        }
        .Apply(_, args) -> loop argument in args -> jet_codegen_collect_union_type(argument, &unions)
        .Tuple(fields) -> loop field in fields -> jet_codegen_collect_union_type(field.ty, &unions)
        else -> {}
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::lower_anonymous_union_type_defs
fn jet_codegen_collect_unions_from_type_definition(definition: MIRTypeDef, unions: &JetCodegenUnionIndex) Never! {
    if definition.kind == {
        .Struct(fields, _) -> loop field in fields -> jet_codegen_collect_union_type(field.ty, &unions)
        .Enum(variants, _) -> loop variant in variants {
            if variant.payload == {
                .Single(value) -> jet_codegen_collect_union_type(value, &unions)
                .Named(fields) -> loop field in fields -> jet_codegen_collect_union_type(field.ty, &unions)
                .Unit -> {}
            }
        }
        .Distinct(base, _) -> jet_codegen_collect_union_type(base, &unions)
        .Alias(target) -> jet_codegen_collect_union_type(target, &unions)
        .UnitFamily(_) -> {}
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::lower_anonymous_union_type_defs
fn jet_codegen_collect_unions_from_function(function: MIRFunction, unions: &JetCodegenUnionIndex) Never! {
    jet_codegen_collect_union_type(function.return_type, &unions)
    if function.declared_return != None -> jet_codegen_collect_union_type(function.declared_return ?? function.return_type, &unions)
    loop parameter in function.params -> jet_codegen_collect_union_type(parameter.ty, &unions)
    loop capture in function.capture_params -> jet_codegen_collect_union_type(capture.ty, &unions)
    loop local in function.locals -> jet_codegen_collect_union_type(local.ty, &unions)
    loop value in function.values -> jet_codegen_collect_union_type(value.ty, &unions)
    loop place in function.places -> jet_codegen_collect_union_type(place.ty, &unions)
    loop block in function.blocks {
        loop instruction in block.instructions {
            if instruction.ty != None -> jet_codegen_collect_union_type(instruction.ty ?? function.return_type, &unions)
        }
    }
}

fn jet_codegen_union_mir_member_tag(ty: MIRType) -> String {
    raw := mir_type_display_name(ty)
    before_args := raw.split("<").to_list()[0]
    bytes := before_args.bytes()
    last_separator := -1
    index := 0
    loop index + 1 < bytes.len() {
        if {
            bytes[index] == (U8{58}) && bytes[index + 1] == (U8{58}) -> {
                last_separator = index + 1
                index += 2
            } else -> {
                index += 1
            }
        }
    }
    start := if last_separator >= 0 -> last_separator + 1 else -> 0
    base := String.from_bytes(bytes[start..<bytes.len()]) ?? panic("canonical union member name is not valid UTF-8")
    suffix := ""
    if before_args.len() < raw.len() -> suffix = String.from_bytes(raw.bytes()[before_args.bytes().len()..<raw.bytes().len()]) ?? panic("canonical union generic name is not valid UTF-8")
    jet_codegen_union_member_tag_name("{base}{suffix}")
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::lower_anonymous_union_type_defs
fn jet_codegen_synthetic_union_definition(ty: MIRType, module_id: MIRModuleID) -> MIRTypeDef {
    identity :: ty.identity ?? panic("checked structural union has no MIR identity")
    members := if ty.kind == {
        .Union(values) -> values
        else -> panic("synthetic union type definition received a non-union type")
    }
    variants := [MIRVariant]{}
    seen_tags := [String:Bool]{}
    loop member in members {
        member_tag := jet_codegen_union_mir_member_tag(member)
        if seen_tags.get(member_tag) != None -> panic("structural union members lower to duplicate Rust variant tags")
        _ := &seen_tags.add(member_tag, true)
        &variants.push(MIRVariant{
            name: member_tag,
            wire_name: member_tag,
            span: Span{start: 0, end: 0},
            payload: MIRVariantPayload.Single{value: member},
            discriminant: None,
        })
    }
    name := "__JetUnion_{identity.value}"
    return MIRTypeDef{
        id: identity,
        module_id: module_id,
        key: name,
        name: name,
        span: Span{start: 0, end: 0},
        public: false,
        package_public: false,
        generic_params: [MIRGenericParam]{},
        derives: [MIRTraitID]{},
        auto_derive_default: false,
        auto_printable: false,
        published_schema: false,
        single_use: false,
        must_use: false,
        layout: None,
        c_layout_tag: None,
        enum_layout: None,
        layout_alignment: None,
        cli: None,
        serde: [MIRSerdeAttribute]{},
        cli_bindings: [MIRCLIBinding]{},
        ownership: MIROwnershipMode.Owned,
        boxed_edges: [String]{},
        compiler_builtin: None,
        kind: MIRTypeDefKind.Enum{variants: variants, methods: [MIRFunctionID]{}},
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::lower_anonymous_union_type_defs
fn jet_codegen_register_synthetic_unions(types: &[MIRTypeDef], functions: [MIRFunction]) {
    unions := JetCodegenUnionIndex{rows: [MIRType]{}, positions: [U64:Int]{}, canonical_keys: [String]{}}
    loop function in functions -> jet_codegen_collect_unions_from_function(function, &unions)
    loop definition in types -> jet_codegen_collect_unions_from_type_definition(definition, &unions)
    if unions.rows.len() == 0 -> return
    module_id := if functions.len() > 0 -> functions[0].module_id else -> if types.len() > 0 -> types[0].module_id else -> panic("structural union has no owning MIR module")
    definitions := [U64:Bool]{}
    loop definition in types -> _ := &definitions.add(definition.id.value, true)
    loop union_type in unions.rows {
        identity :: union_type.identity ?? panic("checked structural union has no MIR identity")
        if definitions.get(identity.value) == None {
            &types.push(jet_codegen_synthetic_union_definition(union_type, module_id))
            _ := &definitions.add(identity.value, true)
        }
    }
}


fn jet_codegen_sort_trait_definitions(rows: &[MIRTraitDef]) Never! {
    keys := [U64]{}
    loop row in rows -> &keys.push(row.id.value)
    sorted := [MIRTraitDef]{}
    loop position in jet_codegen_sorted_order(keys, [String]{}) -> &sorted.push(rows[position])
    loop (index, row) in sorted -> rows[index] = row
}

fn jet_codegen_sort_impl_definitions(rows: &[MIRImplDef]) Never! {
    keys := [U64]{}
    loop row in rows -> &keys.push(row.id.value)
    sorted := [MIRImplDef]{}
    loop position in jet_codegen_sorted_order(keys, [String]{}) -> &sorted.push(rows[position])
    loop (index, row) in sorted -> rows[index] = row
}

fn jet_codegen_sort_constant_definitions(rows: &[MIRConstantDef]) Never! {
    keys := [U64]{}
    loop row in rows -> &keys.push(row.id.value)
    sorted := [MIRConstantDef]{}
    loop position in jet_codegen_sorted_order(keys, [String]{}) -> &sorted.push(rows[position])
    loop (index, row) in sorted -> rows[index] = row
}

fn jet_codegen_sort_field_rows(rows: &[MIRFieldRow]) Never! {
    keys := [U64]{}
    loop row in rows -> &keys.push(row.id.value)
    sorted := [MIRFieldRow]{}
    loop position in jet_codegen_sorted_order(keys, [String]{}) -> &sorted.push(rows[position])
    loop (index, row) in sorted -> rows[index] = row
}

fn jet_codegen_sort_core_calls(rows: &[MIRCoreCall]) Never! {
    keys := [U64]{}
    ties := [String]{}
    loop row in rows {
        &keys.push(row.id.value)
        &ties.push(row.key)
    }
    sorted := [MIRCoreCall]{}
    loop position in jet_codegen_sorted_order(keys, ties) -> &sorted.push(rows[position])
    loop (index, row) in sorted -> rows[index] = row
}

fn jet_codegen_sort_prelude_calls(rows: &[MIRPreludeCall]) Never! {
    keys := [U64]{}
    loop row in rows -> &keys.push(row.id.value)
    sorted := [MIRPreludeCall]{}
    loop position in jet_codegen_sorted_order(keys, [String]{}) -> &sorted.push(rows[position])
    loop (index, row) in sorted -> rows[index] = row
}

fn jet_codegen_sort_used_core(rows: &[String]) Never! {
    sorted := [String]{}
    loop position in jet_codegen_sorted_order([U64]{}, rows) -> &sorted.push(rows[position])
    loop (index, row) in sorted -> rows[index] = row
}

fn jet_codegen_add_needed_trait(reference: MIRTraitRef, known: [MIRTraitID], needed: &[MIRTraitRef]) Never! {
    loop id in known {
        if id == reference.id -> return
    }
    loop prior in needed {
        if prior.id == reference.id -> return
    }
    native_name := jet_codegen_native_rust_derive_name_for_id(reference.id)
    if native_name != None {
        expected :: native_name ?? panic("native derive identity disappeared")
        if reference.name != expected -> panic("native derive reference name disagrees with its canonical identity")
        return
    }
    compiler_owned_name := jet_codegen_compiler_owned_trait_name_for_id(reference.id)
    if compiler_owned_name != None {
        expected :: compiler_owned_name ?? panic("compiler-owned trait identity disappeared")
        if reference.name != expected -> panic("compiler-owned trait reference name disagrees with its canonical identity")
        &needed.push(MIRTraitRef{id: reference.id, name: expected})
        return
    }
    if jet_codegen_is_checked_text_trait_id(reference.id) {
        if reference.name != "CheckedText" -> panic("CheckedText reference name disagrees with its canonical identity")
        return
    }
    panic("MIR trait reference has no declared or registered builtin identity")
}

fn jet_codegen_add_needed_derived_trait(id: MIRTraitID, known: [MIRTraitID], needed: &[MIRTraitRef]) Never! {
    loop known_id in known {
        if known_id == id -> return
    }
    if jet_codegen_native_rust_derive_name_for_id(id) != None -> return
    compiler_owned_name := jet_codegen_compiler_owned_trait_name_for_id(id)
    if compiler_owned_name != None {
        name :: compiler_owned_name ?? panic("compiler-owned derive identity disappeared")
        jet_codegen_add_needed_trait(MIRTraitRef{id: id, name: name}, known, &needed)
        return
    }
    if jet_codegen_is_checked_text_trait_id(id) -> return
    panic("MIR derive identity has no declared or registered builtin trait")
}

fn jet_codegen_synthesized_trait_associated_types(name: String) -> [MIRAssociatedTypeDecl] Never! {
    names := [String]{}
    if name == "Iterator" -> &names.push("Item")
    if name == "Iterable" -> &names.push("Iter")
    if name == "Index" {
        &names.push("Key")
        &names.push("Value")
    }
    if name == "Rollback" -> &names.push("Snapshot")
    associated := [MIRAssociatedTypeDecl]{}
    loop value in names -> &associated.push(MIRAssociatedTypeDecl{name: value, span: Span{start: 0, end: 0}})
    associated
}

fn jet_codegen_ensure_referenced_traits(traits: &[MIRTraitDef], impls: [MIRImplDef], functions: [MIRFunction], types: [MIRTypeDef]) Never! {
    known := [MIRTraitID]{}
    needed := [MIRTraitRef]{}
    loop definition in traits -> &known.push(definition.id)
    loop implementation in impls {
        if implementation.trait_ref == {
            None -> {}
            Val(reference) -> jet_codegen_add_needed_trait(reference, known, &needed)
        }
    }
    loop function in functions {
        if function.form == {
            .TraitMethod(_, reference, _, _) -> jet_codegen_add_needed_trait(reference, known, &needed)
            else -> {}
        }
        loop parameter in function.generic_params {
            loop bound in parameter.bounds -> jet_codegen_add_needed_trait(bound, known, &needed)
        }
    }
    loop definition in types {
        loop derived_trait in definition.derives -> jet_codegen_add_needed_derived_trait(derived_trait, known, &needed)
        loop parameter in definition.generic_params {
            loop bound in parameter.bounds -> jet_codegen_add_needed_trait(bound, known, &needed)
        }
    }
    module_id := mir_module_id("compiler")
    if traits.len() > 0 -> module_id = traits[0].module_id
    if traits.len() == 0 && impls.len() > 0 -> module_id = impls[0].module_id
    if traits.len() == 0 && impls.len() == 0 && functions.len() > 0 -> module_id = functions[0].module_id
    loop reference in needed {
        name_option := jet_codegen_compiler_owned_trait_name_for_id(reference.id)
        if name_option == None -> panic("only registered compiler-owned traits may be synthesized without declarations")
        name :: name_option ?? panic("compiler-owned trait identity disappeared")
        if reference.name != name -> panic("synthesized trait name disagrees with its canonical identity")
        &traits.push(MIRTraitDef{
            id: reference.id,
            module_id: module_id,
            key: name,
            name: name,
            span: Span{start: 0, end: 0},
            visibility: MIRVisibility.Public,
            associated_types: jet_codegen_synthesized_trait_associated_types(name),
            methods: [MIRTraitMethod]{},
        })
    }
}
fn jet_codegen_canonical_target_type(module_identity: String, name: String) -> String Never! {
    text := name.trim()
    if module_identity == "" -> return text
    prefix := "{module_identity}::"
    if text.starts_with(prefix) {
        remainder := text
        prefix_length := prefix.bytes().len()
        loop remainder.starts_with(prefix) {
            remainder = String.from_bytes(remainder.bytes()[prefix_length..<remainder.bytes().len()]) ?? remainder
        }
        return "{prefix}{remainder}"
    }
    if text.contains("::") || text.contains(".") -> return text
    "{prefix}{text}"
}

fn jet_codegen_plain_impl_owner(owner: MIRType) -> Bool Never! {
    if owner.kind == {
        .Int -> true
        .Float -> true
        .Float32 -> true
        .Bool -> true
        .String -> true
        .Char -> true
        .IntN(_, _) -> true
        .Apply(_, args) -> args.len() == 0
        else -> false
    }
}

fn jet_codegen_canonical_impl_key(module_identity: String, owner: MIRType, trait_ref: MIRTraitRef?) -> String {
    qualified_display := jet_codegen_canonical_target_type(module_identity, mir_type_display_name(owner))
    owner_display := qualified_display
    if module_identity != "" {
        prefix := "{module_identity}::"
        if owner_display.starts_with(prefix) -> owner_display = String.from_bytes(owner_display.bytes()[prefix.bytes().len()..<owner_display.bytes().len()]) ?? owner_display
    }
    if !jet_codegen_plain_impl_owner(owner) && mir_type_canonical_key(owner) != qualified_display -> owner_display = "{owner_display}__instance__{mir_type_canonical_key(owner)}"
    key := if module_identity == "" -> owner_display else -> "{module_identity}::{owner_display}"
    if trait_ref == {
        None -> {}
        Val(reference) -> key = "{key}::{reference.name}"
    }
    key
}

struct JetCodegenImplOwnerIndex {
    pub identities: [String:Int]
    pub heads: [String:Int]
    pub tails: [String:Int]
    pub next_rows: [Int]
    pub fallback_heads: [String:Int]
    pub fallback_tails: [String:Int]
    pub next_fallback_rows: [Int]
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::find_impl_index
fn jet_codegen_impl_owner_prefix(module_id: MIRModuleID, trait_ref: MIRTraitRef?) -> String Never! {
    trait_key := if trait_ref == {
        None -> "none"
        Val(reference) -> "{reference.id.value}:{reference.name.len()}:{reference.name}"
    }
    "{module_id.value}:{trait_key.len()}:{trait_key}:"
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::find_impl_index
// Identityless owners need ordered (module, trait) candidates: checked-type
// equality can erase tags or equate differently-spelled nested identities.
fn jet_codegen_index_impl_owner(index: &JetCodegenImplOwnerIndex, implementation: MIRImplDef, row: Int) Never! {
    bucket := jet_codegen_impl_owner_prefix(implementation.module_id, implementation.trait_ref)
    &index.next_rows.push(-1)
    &index.next_fallback_rows.push(-1)
    if index.tails.get(bucket) == .Val(tail) -> index.next_rows[tail] = row else -> _ := &index.heads.add(bucket, row)
    _ := &index.tails.add(bucket, row)
    if implementation.self_type.identity == .Val(identity) {
        key := "{bucket}id:{identity.value}"
        if index.identities.get(key) == None -> _ := &index.identities.add(key, row)
    } else {
        if index.fallback_tails.get(bucket) == .Val(tail) -> index.next_fallback_rows[tail] = row else -> _ := &index.fallback_heads.add(bucket, row)
        _ := &index.fallback_tails.add(bucket, row)
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::find_impl_index
fn jet_codegen_find_indexed_impl(index: JetCodegenImplOwnerIndex, impls: [MIRImplDef], owner: MIRType, trait_ref: MIRTraitRef?, module_id: MIRModuleID) -> Int? Never! {
    bucket := jet_codegen_impl_owner_prefix(module_id, trait_ref)
    first := Int?{None}
    row := index.heads.get(bucket) ?? -1
    if owner.identity == .Val(identity) {
        first = index.identities.get("{bucket}id:{identity.value}")
        row = index.fallback_heads.get(bucket) ?? -1
    }
    loop row >= 0 {
        if first == .Val(position) {
            if row >= position -> break
        }
        if mir_type_same_checked_type(impls[row].self_type, owner) -> return Val(row)
        row = if owner.identity != None -> index.next_fallback_rows[row] else -> index.next_rows[row]
    }
    first
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::attach_orphan_methods
fn jet_codegen_attach_orphan_methods(impls: &[MIRImplDef], functions: [MIRFunction], source_functions: [TFunc]) {
    // Every function id some impl already lists, kept current as orphans are
    // attached (instead of rescanning every impl's methods per function).
    owned := [U64:Bool]{}
    source_rows := [U64:Int]{}
    loop row in 0..<source_functions.len() {
        id := jet_codegen_function_id(source_functions[row])
        if source_rows.get(id.value) == None -> _ := &source_rows.add(id.value, row)
    }
    owner_index := JetCodegenImplOwnerIndex{identities: [String:Int]{}, heads: [String:Int]{}, tails: [String:Int]{}, next_rows: [Int]{}, fallback_heads: [String:Int]{}, fallback_tails: [String:Int]{}, next_fallback_rows: [Int]{}}
    loop row in 0..<impls.len() -> jet_codegen_index_impl_owner(&owner_index, impls[row], row)
    loop implementation in impls {
        loop method in implementation.methods -> _ := &owned.add(method.value, true)
    }
    loop function in functions {
        if function.form == {
            .TopLevel -> next
            else -> {}
        }
        if owned.get(function.id.value) != None -> next
        owner := MIRType?{None}
        trait_ref := MIRTraitRef?{None}
        skip := false
        if function.form == {
            .Method(value, _) -> owner = Val(value)
            .TraitMethod(value, reference, _, serde) -> {
                owner = Val(value)
                trait_ref = Val(reference)
                if serde != None -> skip = true
            }
            .TopLevel -> {}
        }
        if skip -> next
        owner_type :: owner ?? panic("lowered method has no checked owner type")
        source_row :: source_rows.get(function.id.value) ?? panic("lowered method has no checked TFunc identity")
        module_identity := source_functions[source_row].module_identity
        matching_impl := jet_codegen_find_indexed_impl(owner_index, impls, owner_type, trait_ref, function.module_id)
        if matching_impl != None {
            impl_index :: matching_impl ?? panic("matching implementation index disappeared")
            &impls[impl_index].methods.push(function.id)
            _ := &owned.add(function.id.value, true)
            next
        }
        key := jet_codegen_canonical_impl_key(module_identity, owner_type, trait_ref)
        _ := &owned.add(function.id.value, true)
        &impls.push(MIRImplDef{
            id: MIRImplID{value: stable_id("mir-impl", key)},
            module_id: function.module_id,
            key: key,
            span: function.span,
            self_type: owner_type,
            trait_ref: trait_ref,
            associated_types: [MIRAssociatedTypeValue]{},
            methods: [MIRFunctionID]{function.id},
            delegation: None,
            compiler_generated: false,
            serde: None,
            operator_marker: None,
            operator_rhs: None,
            target_os: None,
            target_applicability: MIRTargetApplicability{rust_aot: true, cranelift: true, interpreter: true, web: true},
        })
        jet_codegen_index_impl_owner(&owner_index, impls[impls.len() - 1], impls.len() - 1)
    }
}

fn jet_codegen_sort_core_owners(rows: &[MIRCoreOwner]) Never! {
    keys := [U64]{}
    ties := [String]{}
    loop row in rows {
        &keys.push(row.id.value)
        &ties.push(row.key)
    }
    sorted := [MIRCoreOwner]{}
    loop position in jet_codegen_sorted_order(keys, ties) -> &sorted.push(rows[position])
    loop (index, row) in sorted -> rows[index] = row
}

fn jet_codegen_lower_core_builtin_owner(owner: TCoreBuiltinOwner, module_info: SemaGraphModuleResult) -> MIRCoreOwner Never! {
    if owner.name == "" || owner.symbol.key == "" -> panic("checked Core builtin owner has an empty canonical identity")
    key := owner.symbol.key
    module_id := MIRModuleID?{None}
    if owner.module_identity != None {
        identity :: owner.module_identity ?? panic("checked Core builtin owner module disappeared")
        if identity != module_info.module_identity -> panic("checked Core builtin owner has a module linkage mismatch")
        module_id = Val(mir_module_id(identity))
    }
    ownership := jet_codegen_lower_declaration_ownership_mode(owner.ownership)
    if ownership != MIROwnershipMode.Owned && ownership != MIROwnershipMode.Move -> panic("checked Core builtin owner is not owned")
    MIRCoreOwner{
        id: mir_type_id(key),
        nominal_id: mir_nominal_ref(owner.name).id,
        module_id: module_id,
        key: key,
        name: owner.name,
        ownership: ownership,
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::lower_impl_rows
pub fn lower_functions(functions: [TFunc], modules: [SemaGraphModuleResult], source_files: [MIRSourceFile], trace_sink: CompilerTraceSink?) -> JetCodegenFunctions {
    lowered_functions := [MIRFunction]{}
    prelude_calls := [MIRPreludeCall]{}
    core_calls := [MIRCoreCall]{}
    used_core := [String]{}
    nested_functions := [MIRFunction]{}
    callbacks := [MIRCallbackAdapter]{}
    source_index :: jet_codegen_source_index(source_files)
    field_symbols :: jet_codegen_field_symbol_index(modules)
    function_index :: jet_codegen_function_index(functions)
    // Identity sets so each merge step is O(1) rather than a rescan of every
    // row lowered so far: `"id"` and `"module:key"` per top-level and nested
    // function, and row positions of callbacks, routes and Core calls by id.
    top_ids := [String:Bool]{}
    top_keys := [String:Bool]{}
    nested_ids := [String:Bool]{}
    nested_keys := [String:Bool]{}
    callback_rows := [String:Int]{}
    prelude_seen := [String:Bool]{}
    core_rows := [String:Int]{}
    used_core_seen := [String:Bool]{}
    // One builder holds the program inputs for every function (a builder per
    // function copied the whole checked program each time).
    lowered_rows := [JetCodegenLoweredFunction]{}
    if functions.len() > 0 {
        builder := jet_codegen_new_builder(functions[0], function_index, modules, field_symbols, source_files, source_index)
        trace_functions := false
        if trace_sink == .Val(sink) -> trace_functions = sink.functions()
        loop (position, function) in functions {
            if trace_sink == .Val(sink) -> sink.progress("lower", position, functions.len())
            if trace_functions {
                if trace_sink == .Val(sink) -> sink.begin("lower.function", function.name, position, functions.len())
            }
            &lowered_rows.push(jet_codegen_lower_function(&builder, function, function.body, None, None))
            if trace_functions {
                if trace_sink == .Val(sink) -> sink.end("lower.function", 1)
            }
        }
    }
    loop lowered in lowered_rows {
        id_key :: "{lowered.function.id.value}"
        module_key :: "{lowered.function.module_id.value}:{lowered.function.key}"
        if top_ids.get(id_key) != None || top_keys.get(module_key) != None -> panic("duplicate top-level MIR function identity")
        if nested_ids.get(id_key) != None || nested_keys.get(module_key) != None -> panic("top-level MIR function collides with a nested function")
        &lowered_functions.push(lowered.function)
        top_ids[id_key] = true
        top_keys[module_key] = true
        loop nested in lowered.nested_functions {
            nested_id_key :: "{nested.id.value}"
            nested_module_key :: "{nested.module_id.value}:{nested.key}"
            if top_ids.get(nested_id_key) != None || top_keys.get(nested_module_key) != None -> panic("nested MIR function collides with a top-level function")
            if nested_ids.get(nested_id_key) != None || nested_keys.get(nested_module_key) != None -> panic("duplicate nested MIR function identity")
            &nested_functions.push(nested)
            nested_ids[nested_id_key] = true
            nested_keys[nested_module_key] = true
        }
        loop callback in lowered.callbacks {
            callback_key :: "{callback.id.value}"
            if callback_rows.get(callback_key) == .Val(row) {
                if !jet_codegen_same_callback(callbacks[row], callback) -> panic("conflicting C callback adapter identity")
            } else {
                callback_rows[callback_key] = callbacks.len()
                &callbacks.push(callback)
            }
        }
        loop call in lowered.prelude_calls {
            call_key :: "{call.id.value}"
            if prelude_seen.get(call_key) == None {
                prelude_seen[call_key] = true
                &prelude_calls.push(call)
            }
        }
        loop call in lowered.core_calls {
            call_key :: "{call.id.value}"
            if core_rows.get(call_key) == .Val(row) {
                if core_calls[row].key != call.key -> panic("Core-call identity collision across lowered functions")
            } else {
                core_rows[call_key] = core_calls.len()
                &core_calls.push(call)
            }
        }
        loop used_core_module in lowered.used_core {
            if used_core_seen.get(used_core_module) == None {
                used_core_seen[used_core_module] = true
                &used_core.push(used_core_module)
            }
        }
    }
    all_function_rows := [MIRFunction]{}
    loop function in lowered_functions -> &all_function_rows.push(function)
    loop function in nested_functions -> &all_function_rows.push(function)

    core_owners := [MIRCoreOwner]{}
    loop semantic_module in modules {
        loop owner in semantic_module.declarations.core_builtin_owners {
            lowered := jet_codegen_lower_core_builtin_owner(owner, semantic_module)
            duplicate := false
            loop existing in core_owners {
                if existing.id == lowered.id || existing.key == lowered.key {
                    if existing.module_id != lowered.module_id || existing.nominal_id != lowered.nominal_id || existing.key != lowered.key || existing.name != lowered.name || existing.ownership != lowered.ownership -> panic("conflicting checked Core builtin owner identity")
                    duplicate = true
                }
            }
            if !duplicate -> &core_owners.push(lowered)
        }
    }
    jet_codegen_sort_core_owners(&core_owners)

    types := [MIRTypeDef]{}
    traits := [MIRTraitDef]{}
    loop semantic_module in modules {
        loop definition in semantic_module.declarations.type_defs {
            // core.term stream handles lower to their native carrier, never a record row.
            if jet_codegen_is_core_term_stream_carrier(modules, definition.module_identity, definition.name) -> next
            &types.push(jet_codegen_lower_type_definition(definition, function_index, modules))
        }
        loop definition in semantic_module.declarations.traits -> &traits.push(jet_codegen_lower_trait_definition(definition, function_index, modules))
    }
    jet_codegen_register_synthetic_unions(&types, all_function_rows)
    jet_codegen_sort_type_definitions(&types)
    jet_codegen_sort_trait_definitions(&traits)

    impls := [MIRImplDef]{}
    fields_by_name := jet_codegen_field_id_index(types)
    impl_method_membership := [String:Bool]{}
    // Impl keys are unique in `impls` (a repeated key merges into its row), so
    // a key -> row map finds the one row a later definition merges into.
    impl_index_by_key := [String:Int]{}
    loop semantic_module in modules {
        loop definition in semantic_module.declarations.impls {
            lowered :: jet_codegen_lower_impl_definition(definition, function_index, modules, fields_by_name) ?? next
            if impl_index_by_key.get(lowered.key) == .Val(index) {
                loop method in lowered.methods {
                    method_key := jet_codegen_qualified_function_key(lowered.key, "{method.value}")
                    if impl_method_membership.get(method_key) == None {
                        &impls[index].methods.push(method)
                        _ := &impl_method_membership.add(method_key, true)
                    }
                }
                next
            }
            &impl_index_by_key.add(lowered.key, impls.len()).drop("the lookup above proved this impl key has no row")
            loop method in lowered.methods -> _ := &impl_method_membership.add(jet_codegen_qualified_function_key(lowered.key, "{method.value}"), true)
            &impls.push(lowered)
        }
    }
    jet_codegen_attach_orphan_methods(&impls, all_function_rows, functions)
    jet_codegen_ensure_referenced_traits(&traits, impls, all_function_rows, types)
    jet_codegen_sort_trait_definitions(&traits)

    constants := [MIRConstantDef]{}
    loop semantic_module in modules {
        loop definition in semantic_module.declarations.constants {
            value := jet_codegen_lower_constant_definition(definition, modules)
            if value != None -> &constants.push(value ?? panic("lowered constant lost its MIR row"))
        }
    }
    jet_codegen_sort_functions(&lowered_functions)
    jet_codegen_sort_functions(&nested_functions)
    jet_codegen_sort_callback_adapters(&callbacks)
    jet_codegen_sort_impl_definitions(&impls)
    jet_codegen_sort_constant_definitions(&constants)
    jet_codegen_sort_core_calls(&core_calls)
    jet_codegen_sort_prelude_calls(&prelude_calls)
    jet_codegen_sort_used_core(&used_core)
    fields := jet_codegen_lower_field_rows(types, all_function_rows, traits, impls, constants)
    jet_codegen_sort_field_rows(&fields)
    return JetCodegenFunctions{
        functions: lowered_functions,
        nested_functions: nested_functions,
        callbacks: callbacks,
        types: types,
        core_owners: core_owners,
        traits: traits,
        impls: impls,
        constants: constants,
        fields: fields,
        core_calls: core_calls,
        prelude_calls: prelude_calls,
        used_core: used_core,
    }
}
fn jet_codegen_foreign_target_applicability(target: MIRArtifactTarget) -> MIRTargetApplicability Never! {
    if target == {
        .RustAOT -> MIRTargetApplicability{rust_aot: true, cranelift: false, interpreter: false, web: false}
        .Cranelift -> MIRTargetApplicability{rust_aot: false, cranelift: true, interpreter: false, web: false}
        .Interpreter -> MIRTargetApplicability{rust_aot: false, cranelift: false, interpreter: true, web: false}
        .Web -> MIRTargetApplicability{rust_aot: false, cranelift: false, interpreter: false, web: true}
    }
}

fn jet_codegen_lower_foreign_abi(abi: String) -> MIRForeignABI Never! {
    if abi == {
        "C" | "c" -> MIRForeignABI.C
        "C-unwind" | "c-unwind" | "cunwind" -> MIRForeignABI.CUnwind
        "system" | "System" -> MIRForeignABI.System
        "stdcall" | "Stdcall" -> MIRForeignABI.Stdcall
        "fastcall" | "Fastcall" -> MIRForeignABI.Fastcall
        "vectorcall" | "Vectorcall" -> MIRForeignABI.Vectorcall
        "rust" | "Rust" -> MIRForeignABI.Rust
        else -> MIRForeignABI.Platform{name: abi}
    }
}

fn jet_codegen_lower_foreign_language(language: String) -> MIRForeignLanguage Never! {
    if language == "c" -> return MIRForeignLanguage.C
    if language == "cpp" || language == "c++" -> return MIRForeignLanguage.Cpp
    if language == "asm" || language == "assembly" -> return MIRForeignLanguage.Assembly
    if language.starts_with("rust:") || language == "rust" -> return MIRForeignLanguage.Rust
    panic("checked foreign language has no MIR representation")
}

fn jet_codegen_foreign_effects(effect_root: String?, span: Span) -> MIREffectFacts Never! {
    direct := [String]{}
    direct_spans := [MIRNamedSpan]{}
    if effect_root != None {
        root :: effect_root
        if root == "" -> panic("checked foreign effect root is empty")
        &direct.push(root)
        &direct_spans.push(MIRNamedSpan{name: root, span: span})
    }
    MIREffectFacts{direct: direct, solved: direct, call_edges: [String]{}, maximal: false, direct_spans: direct_spans}
}

struct JetCodegenForeignHookIndex {
    pub functions: [String:MIRFunctionID]
    pub foreign: [String:MIRForeignID]
    pub ambiguous: [String:Bool]
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::lower_foreign_rows
fn jet_codegen_foreign_hook_index(modules: [SemaGraphModuleResult]) -> JetCodegenForeignHookIndex Never! {
    functions := [String:MIRFunctionID]{}
    foreign := [String:MIRForeignID]{}
    ambiguous := [String:Bool]{}
    loop semantic_module in modules {
        loop function in semantic_module.functions {
            if functions.get(function.key) == None -> _ := &functions.add(function.key, jet_codegen_function_id(function))
        }
        loop row in semantic_module.foreign_functions {
            id := MIRForeignID{value: stable_id("mir-foreign", row.key)}
            if foreign.get(row.key) != None -> _ := &ambiguous.add(row.key, true)
            _ := &foreign.add(row.key, id)
            if row.symbol_id.key != row.key {
                if foreign.get(row.symbol_id.key) != None -> _ := &ambiguous.add(row.symbol_id.key, true)
                _ := &foreign.add(row.symbol_id.key, id)
            }
        }
    }
    JetCodegenForeignHookIndex{functions: functions, foreign: foreign, ambiguous: ambiguous}
}

fn jet_codegen_find_checked_foreign_row(modules: [SemaGraphModuleResult], key: String) -> SemaCheckedForeignFunction? {
    found := SemaCheckedForeignFunction?{None}
    loop semantic_module in modules {
        loop row in semantic_module.foreign_functions {
            if row.key == key || row.symbol_id.key == key {
                if found != None -> panic("checked foreign call identity resolves to multiple rows")
                found = Val(row)
            }
        }
    }
    found
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::lower_foreign_rows
fn jet_codegen_foreign_lookup_id(hooks: JetCodegenForeignHookIndex, key: String) -> MIRForeignID? {
    if hooks.ambiguous.get(key) != None -> panic("checked foreign call identity resolves to multiple rows")
    hooks.foreign.get(key)
}

fn jet_codegen_lower_foreign_params(params: [SemaCheckedForeignParam], modules: [SemaGraphModuleResult], module_identity: String) -> [MIRParam] Never! {
    lowered := [MIRParam]{}
    loop parameter in params {
        access := jet_codegen_lower_access(parameter.convention)
        &lowered.push(MIRParam{
            index: parameter.index,
            name: parameter.name,
            span: parameter.span,
            ty: jet_codegen_lower_type_with_modules(parameter.ty, modules, module_identity, [String]{}),
            access: access,
            ownership: jet_codegen_lower_declaration_ownership(parameter.ownership),
            public_label: parameter.public_label,
            variadic: parameter.variadic,
            default_present: parameter.default_present,
        })
    }
    lowered
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::lower_foreign_rows
fn jet_codegen_lower_foreign_row(row: SemaCheckedForeignFunction, modules: [SemaGraphModuleResult], applicability: MIRTargetApplicability, hooks: JetCodegenForeignHookIndex) -> MIRForeign Never! {
    return_type := if row.return_type == {
        None -> None
        Val(ty) -> Val(jet_codegen_lower_type_with_modules(ty, modules, row.module_identity, [String]{}))
    }
    link := if row.link_key == {
        None -> None
        Val(key) -> Val(MIRLinkUnitID{value: stable_id("mir-link", key)})
    }
    callback := if row.callback_key == {
        None -> None
        Val(key) -> Val(MIRCallbackID{value: stable_id("mir-callback", key)})
    }
    handle := if row.handle_key == {
        None -> None
        Val(key) -> Val(MIRHandleID{value: stable_id("mir-handle", key)})
    }
    close_function := if row.close_function_key == {
        None -> None
        Val(key) -> Val(hooks.functions.get(key) ?? panic("checked foreign close adapter has no registered TFunc"))
    }
    close_foreign := if row.close_foreign_key == {
        None -> None
        Val(key) -> Val(jet_codegen_foreign_lookup_id(hooks, key) ?? panic("checked raw foreign close has no registered foreign row"))
    }
    undo_function := if row.undo_function_key == {
        None -> None
        Val(key) -> hooks.functions.get(key)
    }
    MIRForeign{
        id: MIRForeignID{value: stable_id("mir-foreign", row.key)},
        module_id: mir_module_id(row.module_identity),
        key: row.key,
        module_name: row.module_name,
        name: row.name,
        span: row.span,
        symbol: row.symbol,
        path: row.path,
        params: jet_codegen_lower_foreign_params(row.params, modules, row.module_identity),
        raw_scalar_abi: row.raw_scalar_abi,
        bridge_eligible: row.bridge_eligible,
        return_type: return_type,
        foreign_abi: jet_codegen_lower_foreign_abi(row.abi),
        foreign_language: jet_codegen_lower_foreign_language(row.language),
        target_applicability: applicability,
        effects: jet_codegen_foreign_effects(row.effect_root, row.span),
        callback_transport: row.callback_transport,
        callback_plan_digest: row.callback_plan_digest,
        callback_identity: row.callback_identity,
        link: link,
        callback: callback,
        handle: handle,
        close_function: close_function,
        close_foreign: close_foreign,
        undo_function: undo_function,
    }
}

fn jet_codegen_lower_foreign_handle_ownership(ownership: String) -> MIRHandleOwnership Never! {
    if ownership == {
        "Owned" -> MIRHandleOwnership.Owned
        "Shared" -> MIRHandleOwnership.Shared
        "Borrowed" -> MIRHandleOwnership.Borrowed
        else -> panic("checked foreign handle ownership has no MIR representation")
    }
}

fn jet_codegen_lower_foreign_close_source(source: String) -> MIRFFICloseSource Never! {
    if source == {
        "conventional" -> MIRFFICloseSource.Conventional
        "overlay" -> MIRFFICloseSource.Overlay
        else -> panic("checked foreign handle close source has no MIR representation")
    }
}

fn jet_codegen_lower_foreign_thread_safety(safety: String) -> MIRFFIThreadSafety Never! {
    if safety == {
        "unspecified" -> MIRFFIThreadSafety.Unspecified
        "safe" -> MIRFFIThreadSafety.Safe
        "unsafe" -> MIRFFIThreadSafety.Unsafe
        else -> panic("checked foreign handle thread-safety has no MIR representation")
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::lower_handle_rows
fn jet_codegen_lower_foreign_handle(handle: SemaCheckedForeignHandle, module_identity: String, modules: [SemaGraphModuleResult], hooks: JetCodegenForeignHookIndex) -> MIRHandleLifecycle Never! {
    close_function := MIRFunctionID?{None}
    close_foreign := MIRForeignID?{None}
    if handle.close_function_key != None {
        key :: handle.close_function_key ?? panic("checked foreign handle close function key disappeared")
        close_function = hooks.functions.get(key) ?? panic("checked foreign handle close adapter does not resolve to a TFunc")
    }
    if handle.close_foreign_key != None {
        key :: handle.close_foreign_key ?? panic("checked foreign handle close foreign key disappeared")
        close_foreign = jet_codegen_foreign_lookup_id(hooks, key) ?? panic("checked foreign handle fallback does not resolve to a foreign row")
    }
    undo := MIRFunctionID?{None}
    if handle.undo_function_key != None {
        key :: handle.undo_function_key ?? panic("checked foreign handle undo key disappeared")
        undo = hooks.functions.get(key)
    }
    MIRHandleLifecycle{
        id: MIRHandleID{value: stable_id("mir-handle", "c::{handle.library}::{handle.jet_name}")},
        ty: jet_codegen_lower_type_with_modules(Type.Named{name: handle.jet_name}, modules, module_identity, [String]{}),
        ownership: jet_codegen_lower_foreign_handle_ownership(handle.ownership),
        payload: MIRHandlePayload{library: handle.library, typedef_name: handle.typedef_name, close: handle.close},
        close: close_function,
        close_foreign: close_foreign,
        undo: undo,
        send: handle.send,
        sync: handle.sync,
        close_source: Val(jet_codegen_lower_foreign_close_source(handle.close_source)),
        thread_safety: Val(jet_codegen_lower_foreign_thread_safety(handle.thread_safety)),
    }
}

fn jet_codegen_foreign_push_unique_string(rows: &[String], value: String) Never! {
    if !rows.contains(value) -> &rows.push(value)
}

fn jet_codegen_foreign_sort_strings(rows: &[String]) Never! {
    sorted := [String]{}
    loop position in jet_codegen_sorted_order([U64]{}, rows) -> &sorted.push(rows[position])
    loop (index, row) in sorted -> rows[index] = row
}

fn jet_codegen_foreign_sort_rows(rows: &[MIRForeign]) Never! {
    keys := [U64]{}
    ties := [String]{}
    loop row in rows {
        &keys.push(row.id.value)
        &ties.push(row.key)
    }
    sorted := [MIRForeign]{}
    loop position in jet_codegen_sorted_order(keys, ties) -> &sorted.push(rows[position])
    loop (index, row) in sorted -> rows[index] = row
}

fn jet_codegen_foreign_sort_links(rows: &[MIRLinkUnit]) Never! {
    keys := [U64]{}
    ties := [String]{}
    loop row in rows {
        &keys.push(row.id.value)
        &ties.push(row.crate_spec)
    }
    sorted := [MIRLinkUnit]{}
    loop position in jet_codegen_sorted_order(keys, ties) -> &sorted.push(rows[position])
    loop (index, row) in sorted -> rows[index] = row
}

fn jet_codegen_foreign_sort_handles(rows: &[MIRHandleLifecycle]) Never! {
    keys := [U64]{}
    loop row in rows -> &keys.push(row.id.value)
    sorted := [MIRHandleLifecycle]{}
    loop position in jet_codegen_sorted_order(keys, [String]{}) -> &sorted.push(rows[position])
    loop (index, row) in sorted -> rows[index] = row
}

fn jet_codegen_foreign_add_link_closure_id(closure: &[MIRLinkUnitID], name: String, libraries: &[String]) Never! {
    loop library in libraries {
        if name == library {
            key := "c::{library}"
            id := MIRLinkUnitID{value: stable_id("mir-link", key)}
            if !closure.contains(id) -> &closure.push(id)
        }
    }
}

fn jet_codegen_foreign_link_closure(direct: &[String], transitive: &[String], libraries: &[String]) -> [MIRLinkUnitID] Never! {
    closure := [MIRLinkUnitID]{}
    loop name in direct -> jet_codegen_foreign_add_link_closure_id(&closure, name, &libraries)
    loop name in transitive -> jet_codegen_foreign_add_link_closure_id(&closure, name, &libraries)
    closure
}

fn jet_codegen_foreign_link_row(library: String, cache_identity: String, applicability: MIRTargetApplicability, direct: &[String], transitive: &[String], libraries: &[String]) -> MIRLinkUnit Never! {
    key := "c::{library}"
    MIRLinkUnit{
        id: MIRLinkUnitID{value: stable_id("mir-link", key)},
        crate_spec: library,
        cache_identity: cache_identity,
        target_applicability: applicability,
        artifacts: [MIRLinkArtifact]{},
        dependency_dirs: [String]{},
        link_closure: jet_codegen_foreign_link_closure(&direct, &transitive, &libraries),
    }
}

fn jet_codegen_same_foreign_handle(left: MIRHandleLifecycle, right: MIRHandleLifecycle) -> Bool Never! {
    left.id == right.id &&
    mir_type_identity_key(left.ty) == mir_type_identity_key(right.ty) &&
    left.ownership == right.ownership &&
    left.payload.library == right.payload.library &&
    left.payload.typedef_name == right.payload.typedef_name &&
    left.payload.close == right.payload.close &&
    left.close == right.close &&
    left.close_foreign == right.close_foreign &&
    left.undo == right.undo &&
    left.send == right.send &&
    left.sync == right.sync &&
    left.close_source == right.close_source &&
    left.thread_safety == right.thread_safety
}

// Rust: crates/jet-codegen/src/Codegen/TIR/mir.rs::lower_foreign_rows
pub fn lower_foreign_artifacts(modules: [SemaGraphModuleResult], package_facts: MIRPackageFacts) -> JetCodegenForeignArtifacts Never! {
    direct_links := [String]{}
    transitive_links := [String]{}
    libraries := [String]{}
    has_foreign_data := false
    loop semantic_module in modules {
        if semantic_module.foreign_functions.len() > 0 -> has_foreign_data = true
        loop provider in semantic_module.foreign_providers {
            has_foreign_data = true
            jet_codegen_foreign_push_unique_string(&libraries, provider.library)
            loop library in provider.direct_links -> jet_codegen_foreign_push_unique_string(&direct_links, library)
            loop library in provider.transitive_links -> jet_codegen_foreign_push_unique_string(&transitive_links, library)
        }
    }
    if !has_foreign_data -> return JetCodegenForeignArtifacts{foreign: [MIRForeign]{}, links: [MIRLinkUnit]{}, handles: [MIRHandleLifecycle]{}}
    target :: package_facts.artifact_target ?? panic("checked foreign artifact lowering has no selected package target")
    applicability := jet_codegen_foreign_target_applicability(target)
    jet_codegen_foreign_sort_strings(&direct_links)
    jet_codegen_foreign_sort_strings(&transitive_links)
    write_index := 0
    read_index := 0
    loop read_index < transitive_links.len() {
        library := transitive_links[read_index]
        if !direct_links.contains(library) {
            transitive_links[write_index] = library
            write_index += 1
        }
        read_index += 1
    }
    loop transitive_links.len() > write_index -> _ := &transitive_links.pop()
    jet_codegen_foreign_sort_strings(&libraries)
    cache_identity := "direct={direct_links.join(",")};transitive={transitive_links.join(",")}"
    links := [MIRLinkUnit]{}
    loop library in libraries -> &links.push(jet_codegen_foreign_link_row(library, cache_identity, applicability, &direct_links, &transitive_links, &libraries))
    foreign := [MIRForeign]{}
    hooks := jet_codegen_foreign_hook_index(modules)
    loop semantic_module in modules {
        loop row in semantic_module.foreign_functions {
            if row.owner == SemaCheckedForeignOwner.CModule {
                link_key :: row.link_key ?? panic("checked C foreign link key disappeared")
                link_id := MIRLinkUnitID{value: stable_id("mir-link", link_key)}
                found := false
                loop link_row in links {
                    if link_row.id == link_id -> found = true
                }
                if !found -> panic("checked C foreign function references a missing link provider")
            }
            lowered := jet_codegen_lower_foreign_row(row, modules, applicability, hooks)
            loop existing in foreign {
                if existing.id == lowered.id -> panic("duplicate or colliding checked foreign function identity")
            }
            &foreign.push(lowered)
        }
    }
    handles := [MIRHandleLifecycle]{}
    loop semantic_module in modules {
        loop provider in semantic_module.foreign_providers {
            loop handle in provider.handles {
                lowered := jet_codegen_lower_foreign_handle(handle, semantic_module.module_identity, modules, hooks)
                duplicate := false
                loop existing in handles {
                    if existing.id == lowered.id {
                        if !jet_codegen_same_foreign_handle(existing, lowered) -> panic("conflicting checked foreign handle identity")
                        duplicate = true
                    }
                }
                if !duplicate -> &handles.push(lowered)
            }
        }
    }
    loop row in foreign {
        if row.handle != None {
            handle_id :: row.handle ?? panic("checked foreign handle ID disappeared")
            found := false
            loop handle_row in handles {
                if handle_row.id == handle_id -> found = true
            }
            if !found -> panic("checked foreign function references a missing handle provider")
        }
        if row.close_foreign != None {
            close_id :: row.close_foreign ?? panic("checked foreign close ID disappeared")
            found := false
            loop foreign_row in foreign {
                if foreign_row.id == close_id -> found = true
            }
            if !found -> panic("checked foreign function references a missing foreign close function")
        }
    }
    jet_codegen_foreign_sort_rows(&foreign)
    jet_codegen_foreign_sort_links(&links)
    jet_codegen_foreign_sort_handles(&handles)
    JetCodegenForeignArtifacts{foreign: foreign, links: links, handles: handles}
}
