fn json_impls(program: MirProgram) -> String Never! {
    rows := [String]{}
    loop impl_def in program.impls {
        trait_ref :: if impl_def.trait_ref == { Val(trait_ref) -> "{{\"id\":{trait_ref.id.0},\"name\":{json_string(trait_ref.name)}}}" None -> "null" }
        associated_types :: loop associated in impl_def.associated_types -> "{{\"name\":{json_string(associated.name)},\"type\":{json_string(type_descriptor(associated.ty))}}}"
        methods :: loop id in impl_def.methods -> id.0.to_string()
        delegation :: if impl_def.delegation == { Val(id) -> id.0.to_string() None -> "null" }
        operator_rhs :: if impl_def.operator_rhs == { Val(ty) -> json_string(type_descriptor(ty)) None -> "null" }
        &rows.push("{{\"id\":{impl_def.id.0},\"module\":{impl_def.module.0},\"key\":{json_string(impl_def.key)},\"self_type\":{json_string(type_descriptor(impl_def.self_type))},\"trait\":{trait_ref},\"associated_types\":[{associated_types.join(",")}],\"methods\":[{methods.join(",")}],\"delegation\":{delegation},\"compiler_generated\":{impl_def.compiler_generated},\"serde\":{optional_serde_codec_descriptor(impl_def.serde)},\"operator_rhs\":{operator_rhs},\"target_applicability\":{{\"web\":{impl_def.target_applicability.web}}}}}")
    }
    "[{rows.join(",")}]"
}

