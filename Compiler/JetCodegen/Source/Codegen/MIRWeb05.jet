fn json_cli_shape(shape: MirCliInputShape) -> String Never! {
    if shape == {
        .Flag -> "{{\"kind\":\"flag\"}}"
        .Value(kind, optional, default) -> "{{\"kind\":{json_string(cli_value_kind_descriptor(kind))},\"optional\":{optional},\"default\":{json_cli_default(default)}}}"
    }
