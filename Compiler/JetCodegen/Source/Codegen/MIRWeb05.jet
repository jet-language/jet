}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:7423
fn json_artifact(artifact: MirArtifactPlan, program: MirProgram, artifact_identity: String) -> String MirWebError! {
    modules :: loop id in artifact.modules -> id.0.to_string()
    links :: loop id in artifact.links -> id.0.to_string()
    jobs :: loop id in artifact.jobs -> id.0.to_string()
    runtime_parts :: loop part in artifact.runtime_parts -> json_string(runtime_part_descriptor(part))
    exports :: loop export_row in artifact.exports -> "{{\"symbol\":{json_string(export_row.symbol)},\"function\":{export_row.function.0},\"abi\":{json_string(foreign_abi_descriptor(export_row.abi))}}}"
    entry :: json_entry_spec(artifact.entry, program)!
    harness :: if artifact.harness == { Val(id) -> id.0.to_string() None -> "null" }
    "{{\"id\":{artifact.id.0},\"kind\":{json_string(artifact.kind.as_str())},\"name\":{json_string(artifact.name)},\"target\":{json_string(artifact.target.as_str())},\"mode\":{json_string(artifact.mode.as_str())},\"modules\":[{modules.join(",")}],\"links\":[{links.join(",")}],\"jobs\":[{jobs.join(",")}],\"runtime_parts\":[{runtime_parts.join(",")}],\"exports\":[{exports.join(",")}],\"provider_identity\":{json_string(artifact.provider_identity)},\"closure_identity\":{json_string(artifact.closure_identity)},\"artifact_identity\":{json_string(artifact_identity)},\"entry\":{entry},\"harness\":{harness}}}"
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:7470
fn json_entry_spec(entry: MirEntrySpec?, program: MirProgram) -> String MirWebError! {
    entry :: entry ?? return "null"
    cli := "null"
    if entry.cli == Val(cli_entry) {
        commands := [String]{}
        loop command in cli_entry.commands {
            if !program.functions.any(fn(function) { function.id == command.function }) -> raise MirWebError.MissingUserFunction{function: command.function.0}
            description :: if command.description == { Val(value) -> json_string(value) None -> "null" }
            receiver :: if command.receiver == { Val(id) -> id.0.to_string() None -> "null" }
            &commands.push("{{\"name\":{json_string(command.name)},\"description\":{description},\"function\":{command.function.0},\"receiver\":{receiver},\"inputs\":{json_cli_inputs(command.inputs)}}}")
        }
        description :: if cli_entry.description == { Val(value) -> json_string(value) None -> "null" }
        cli = "{{\"description\":{description},\"record_inputs\":{cli_entry.record_inputs},\"inputs\":{json_cli_inputs(cli_entry.inputs)},\"commands\":[{commands.join(",")}],\"standard\":{cli_entry.standard}}}"
    }
    function_id :: optional_function_id(entry.function)
    "{{\"kind\":{json_string(entry_kind_descriptor(entry.kind))},\"function\":{function_id},\"cli\":{cli},\"output\":{json_string(entry_output_descriptor(entry.output))},\"initialize_environment\":{entry.initialize_environment},\"initialize_gc\":{entry.initialize_gc},\"serves_until_stopped\":{entry.serves_until_stopped},\"package_version\":{json_string(entry.package_version)}}}"
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:7525
fn json_cli_inputs(inputs: [MirCliInput]) -> String Never! {
    rows := [String]{}
    loop input in inputs {
        short :: if input.short == { Val(value) -> json_string(value) None -> "null" }
        env :: if input.env == { Val(value) -> json_string(value) None -> "null" }
        metavar :: if input.metavar == { Val(value) -> json_string(value) None -> "null" }
        positional :: if input.positional == { Val(value) -> value.to_string() None -> "null" }
        &rows.push("{{\"parameter\":{input.parameter},\"name\":{json_string(input.name)},\"label\":{json_string(input.label)},\"type\":{json_string(type_descriptor(input.ty))},\"zone\":{json_string(input.zone.as_str())},\"short\":{short},\"env\":{env},\"help\":{json_string(input.help)},\"metavar\":{metavar},\"shape\":{json_cli_shape(input.shape)},\"positional\":{positional},\"variadic\":{input.variadic}}}")
    }
    "[{rows.join(",")}]"
}

