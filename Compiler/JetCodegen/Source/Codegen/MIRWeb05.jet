// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:7581
fn json_cli_default(default: MirCliDefault?) -> String Never! {
    if default == {
        None -> "null"
        Val(.TypeDefault) -> "{{\"kind\":\"type-default\"}}"
        Val(.Value(value)) -> "{{\"kind\":\"value\",\"value\":{json_string(constant_descriptor(value))}}}"
    }
}

