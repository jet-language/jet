}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:8183
fn item_ref_descriptor(item: MirItemRef) -> String Never! {
    if item == { .Type(id) -> "type:{id.0}" .Trait(id) -> "trait:{id.0}" .Function(id) -> "function:{id.0}" .Constant(id) -> "constant:{id.0}" .Impl(id) -> "impl:{id.0}" .Foreign(id) -> "foreign:{id.0}" .Import(id) -> "import:{id.0}" }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:8195
fn import_kind_descriptor(kind: MirImportKind) -> String Never! {
    if kind == {
        .File(path) -> "file:{path}"
        .Module(path) -> "module:{path}"
        .Unqualified(module, items) -> {
            rows :: loop item in items -> "{item.original}:{item.local}:{item_ref_descriptor(item.item)}"
            "unqualified:module={module.0}:items={rows.join(",")}"
        }
    }
}

