// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:8392
fn json_reconstructions(reconstructions: [MirWebParamReconstruction]) -> String Never! {
    rows := [String]{}
    loop reconstruction in reconstructions {
        fields :: loop field in reconstruction.fields -> "{{\"field\":{json_string(field.field)},\"parameter\":{json_string(field.parameter)},\"type\":{json_string(type_descriptor(field.ty))}}}"
        &rows.push("{{\"local\":{json_string(reconstruction.local)},\"type\":{json_string(type_descriptor(reconstruction.ty))},\"fields\":[{fields.join(",")}]}}")
    }
    "[{rows.join(",")}]"
}
