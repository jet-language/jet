    loop trait_def in program.traits {
        associated_types :: loop associated in trait_def.associated_types -> json_string(associated.name)
        methods :: loop method in trait_def.methods -> "{{\"id\":{method.id.0},\"name\":{json_string(method.name)},\"self_access\":{optional_access(method.self_access)},\"default\":{optional_function_id(method.default)}}}"
        &rows.push("{{\"id\":{trait_def.id.0},\"module\":{trait_def.module.0},\"key\":{json_string(trait_def.key)},\"name\":{json_string(trait_def.name)},\"visibility\":{json_string(visibility_descriptor(trait_def.visibility))},\"associated_types\":[{associated_types.join(",")}],\"methods\":[{methods.join(",")}]}}")
    }
