// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:7619
fn emit_command_record(program: MirProgram, functions: [MirFunction], artifact: MirArtifactPlan, entry: MirFunctionId) -> [U8] MirWebError! {
    entry_type :: if functions.find(fn(function) { function.id == entry }) == { Val(function) -> function.name None -> artifact.name }
    description := None as String?
    standard := false
    version := None as String?
    inputs := [MirCliInput]{}
    commands := [MirCliCommand]{}
    if artifact.entry == Val(entry_spec) {
        version = Val(entry_spec.package_version)
        if entry_spec.cli == Val(cli) {
            description = cli.description
            standard = cli.standard
            inputs = cli.inputs
            commands = cli.commands
        }
    }
    jobs := [MirJob]{}
    loop job_id in artifact.jobs {
        job :: program.jobs.find(fn(job) { job.id == job_id }) ?? raise MirWebError.InvalidMir{message: "MIR WebApplication artifact {artifact.id.0} references missing job {job_id.0} while encoding its command record"}
        &jobs.push(job)
    }
    encode_mir_record(entry_type, description, standard, version, inputs, commands, jobs)
}

