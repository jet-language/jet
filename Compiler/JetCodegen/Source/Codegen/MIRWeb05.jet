// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:8289
fn job_limits_descriptor(limits: [String:String]) -> String Never! {
    keys := limits.keys()
    &keys.sort()
    rows :: loop key in keys -> "{key}={limits.get(key) ?? panic("known limit key") }"
    rows.join(",")
}

