}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:7699
fn js_call_values(program: MirProgram, function: MirFunction, args: [MirCallArg], write_alias: Bool) -> [String] MirWebError! {
    values := [String]{}
    loop arg in args -> &values.push(js_call_arg_value(program, function, arg, write_alias)!)
    values
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:7710
fn js_call_arg_value(program: MirProgram, function: MirFunction, arg: MirCallArg, write_alias: Bool) -> String MirWebError! {
    ty :: mir_function_value_type(function, arg.value)!
    source :: if arg.access == {
        .Move -> js_move_value_expression(arg.value)
        .Read -> if arg.place == { Val(place) -> js_read_place_storage_expression(program, function, place)! None -> "__jet_values.get({arg.value.0})" }
        .Write -> {
            place :: arg.place ?? raise MirWebError.InvalidMir{message: "MIR Web write call argument {arg.value.0} has no checked place"}
            if write_alias -> "jet_web_write_arg({js_place_cell_expression(program, function, place)!})" else -> js_read_place_storage_expression(program, function, place)!
        }
    }
    value := if arg.access == MirAccess.Read && !arg.implicit_clone && !arg.shared_auto_clone -> js_copy_expression(program, ty, source) else -> source
    if arg.implicit_clone || arg.shared_auto_clone {
        copy_source :: if arg.access == MirAccess.Write && write_alias -> "jet_web_call_arg_value({value})" else -> value
        value = js_copy_expression(program, ty, copy_source)
    }
    if arg.fn_coercion == Val(coercion) {
        if coercion.ty.identity == Val(type_id) -> ensure_type_instance(program, type_id)!
        // JS function values already use the canonical callable ABI.
    }
    if arg.widen_fixed_to_list -> value = "Array.from({value})"
    if arg.widen_to_union == Val(coercion) {
        ensure_type_instance(program, coercion.union)!
        type_def :: program.types.find(fn(type_def) { type_def.id == coercion.union }) ?? raise MirWebError.InvalidMir{message: "MIR call argument {arg.value.0} widens to missing union type {coercion.union.0}"}
        if type_def.kind == {
            .Enum(variants, _) -> {
                if !variants.any(fn(variant) { variant.name == coercion.variant }) -> raise MirWebError.InvalidMir{message: "MIR call argument {arg.value.0} widens to union {coercion.union.0} with missing variant {coercion.variant}"}
            }
            .Struct(_, _) | .Distinct(_, _) | .Alias(_) | .UnitFamily(_) -> raise MirWebError.InvalidMir{message: "MIR call argument {arg.value.0} widens to non-enum union type {coercion.union.0}"}
        }
        value = "{{ tag: {js_string(coercion.variant)}, values: [{value}] }}"
    }
    // Canonical Web trait values are already their concrete JS objects.
    if arg.spread -> "...{value}" else -> value
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:7819
fn type_descriptor(ty: MirType) -> String Never! {
    "{ty.name()}:abi={mir_abi_descriptor(ty.layout.abi)},size={mir_size_descriptor(ty.layout.size)},align={mir_size_descriptor(ty.layout.align)}"
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:7829
fn mir_abi_descriptor(abi: MirAbi) -> String Never! {
    if abi == {
        .Scalar(kind) -> "scalar-{mir_scalar_kind_descriptor(kind)}"
        .Aggregate -> "aggregate"
        .Sequence -> "sequence"
        .Function -> "function"
        .Nominal -> "nominal"
        .Dynamic -> "dynamic"
        .Never -> "never"
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:7843
fn mir_scalar_kind_descriptor(kind: MirScalarKind) -> String Never! {
    if kind == { .Int -> "int" .Float -> "float" .Float32 -> "float32" .Bool -> "bool" .Char -> "char" .Pointer -> "pointer" }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:7854
fn mir_size_descriptor(size: MirSize) -> String Never! {
    if size == { .Static(bytes) -> "static-{bytes}" .Dynamic -> "dynamic" }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:7861
fn mir_int_width_descriptor(width: (Bool, U8)?) -> String Never! {
    if width == {
        Val((signed, bits)) -> "{if signed -> "signed" else -> "unsigned"}-{bits}"
        None -> "unspecified"
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:7868
fn mir_char_descriptor(value: Char) -> String Never! {
    // GATE #4494: Rust-compatible char escape_default primitive.
    value.escape_default().collect()
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:7872
fn mir_bytes_descriptor(value: [U8]) -> String Never! {
    out := [String]{}
    loop byte in value -> &out.push("{byte:02x}")
    out.join("")
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:7876
fn mir_float_descriptor(value: F64, is_f32: Bool) -> String Never! {
    if is_f32 -> "{value as F32}" else -> value.to_string()
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:7884
fn js_string(value: String) -> String Never! { "\"{escape_string(value)}\"" }

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:7888
fn json_string(value: String) -> String Never! { "\"{escape_string(value)}\"" }

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:7892
fn escape_string(value: String) -> String Never! {
    out := ""
    loop ch in value.chars() {
        if ch == {
            '\\' -> &out.push_str("\\\\")
            '"' -> &out.push_str("\\\"")
            '\n' -> &out.push_str("\\n")
            '\r' -> &out.push_str("\\r")
            '\t' -> &out.push_str("\\t")
            '\u{08}' -> &out.push_str("\\b")
            '\u{0c}' -> &out.push_str("\\f")
            c -> if c.is_control() -> &out.push_str("\\u{c as U32:04x}") else -> &out.push(c)
        }
    }
    out
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:7910
fn default_index_html() -> String Never! {
    "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Jet app</title></head><body><script type=\"module\" src=\"./app.js\"></script></body></html>\n"
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:7914
fn constant_descriptor(constant: MirConstant) -> String Never! {
    if constant == {
        .Int(value, width, spelling) -> "int:{value}:{mir_int_width_descriptor(width)}:{spelling ?? ""}"
        .Float(value, f32, spelling) -> "float:{mir_float_descriptor(value, f32)}:{f32}:{spelling ?? ""}"
        .Bool(value) -> "bool:{value}"
        .Char(value) -> "char:{mir_char_descriptor(value)}"
        .String(value) -> "string:{value}"
        .Bytes(value) -> "bytes:{mir_bytes_descriptor(value)}"
        .Unit -> "unit"
        .BigInt(value) -> "bigint:{value}"
        .List(values) -> {
            rows :: loop value in values -> constant_descriptor(value)
            "list:{rows.join(",")}"
        }
        .Map(values) -> {
            rows :: loop (key, value) in values -> "{const_key_descriptor(key)}={constant_descriptor(value)}"
            "map:{rows.join(",")}"
        }
        .Struct(type_name, fields) -> {
            rows :: loop (name, value) in fields -> "{name}={constant_descriptor(value)}"
            "struct:{type_name}:{rows.join(",")}"
        }
        .Enum(type_name, variant, args) -> {
            rows :: loop (name, value) in args -> "{name ?? ""}={constant_descriptor(value)}"
            "enum:{type_name}:{variant}:{rows.join(",")}"
        }
        .Present(value) -> "present:{constant_descriptor(value)}"
        .Failed(report) -> "failed:{const_report_descriptor(report)}"
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:7974
fn const_report_descriptor(report: MirConstReport) -> String Never! {
    if report == { .Clean(ty) -> "clean:{ty.identity_key()}" .Told(value) -> "told:{constant_descriptor(value)}" }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:7981
fn const_key_descriptor(key: MirConstKey) -> String Never! {
    if key == {
        .Int(value) -> "int:{value}"
        .String(value) -> "string:{value}"
        .Bool(value) -> "bool:{value}"
        .Char(value) -> "char:{mir_char_descriptor(value)}"
        .Tuple(values) -> {
            rows :: loop (name, key) in values -> "{name}={const_key_descriptor(key)}"
            "tuple:{rows.join(",")}"
        }
        .Struct(type_name, fields) -> {
            rows :: loop (name, key) in fields -> "{name}={const_key_descriptor(key)}"
            "struct:{type_name}:{rows.join(",")}"
        }
        .Enum(type_name, variant) -> "enum:{type_name}:{variant}"
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:8010
fn layout_compare_code(op: MirLayoutCompareOp) -> U8 Never! {
    if op == { .Equal -> 0 .LessEqual -> 1 .GreaterEqual -> 2 }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:8017
fn task_group_code(kind: MirTaskGroupKind) -> U8 Never! {
    if kind == { .All -> 0 .Any -> 1 .Race -> 2 }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:8021
fn select_code(kind: MirSelectKind) -> U8 Never! {
    if kind == { .Start -> 0 .Receive -> 1 .After -> 2 .Wait -> 3 }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:8028
fn js_string_part(part: MirStringPart) -> String Never! {
    if part == { .Literal(value) -> js_string(value) .Value(value) -> "__jet_values.get({value.0})" }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:8038
fn type_def_kind_descriptor(kind: MirTypeDefKind) -> String Never! {
    if kind == {
        .Struct(fields, methods) -> "struct:fields={fields.len()}:methods={methods.len()}"
        .Enum(variants, methods) -> "enum:variants={variants.len()}:methods={methods.len()}"
        .Distinct(base, range) -> "distinct:{type_descriptor(base)}:range={mir_range_descriptor(range)}"
        .Alias(target) -> "alias:{type_descriptor(target)}"
        .UnitFamily(members) -> "unit-family:{members.join(",")}"
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:8054
fn mir_range_descriptor(range: (I64, I64)?) -> String Never! {
    if range == { Val((lo, hi)) -> "{lo}..{hi}" None -> "none" }
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:8060
fn function_kind_descriptor(kind: MirFunctionKind) -> String Never! {
    if kind == { .Jet -> "jet" .Foreign -> "foreign" .Test -> "test" }
}

