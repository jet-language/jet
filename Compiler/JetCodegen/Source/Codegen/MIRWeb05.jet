// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:7113
fn json_generic_params(params: [MirGenericParam], program: MirProgram) -> String MirWebError! {
    rows := [String]{}
    loop param in params {
        bounds := [String]{}
        loop bound in param.bounds {
            trait_def :: program.traits.find(fn(candidate) { candidate.id == bound.id }) ?? raise MirWebError.InvalidMir{message: "MIR generic parameter {param.name} references missing trait {bound.id.0}"}
            &bounds.push("{{\"id\":{bound.id.0},\"name\":{json_string(trait_def.name)}}}")
        }
        &rows.push("{{\"name\":{json_string(param.name)},\"bounds\":[{bounds.join(",")}]}}")
    }
    "[{rows.join(",")}]"
}

// Rust: crates/jet-codegen/src/Codegen/MIRWeb.rs:7149
fn json_modules(program: MirProgram) -> String Never! {
    rows := [String]{}
    loop module in program.modules {
        imports :: loop id in module.imports -> id.0.to_string()
        items :: loop item in module.item_order -> json_string(item_ref_descriptor(item))
        &rows.push("{{\"id\":{module.id.0},\"key\":{json_string(module.key)},\"name\":{json_string(module.name)},\"path\":{json_string(module.path)},\"source_file\":{module.source_file.0},\"imports\":[{imports.join(",")}],\"item_order\":[{items.join(",")}]}}")
    }
    "[{rows.join(",")}]"
}

