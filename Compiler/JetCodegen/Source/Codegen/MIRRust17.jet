        }
    }

    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:29300
    fn prelude_values(self: &RustEmitter, call: MirPreludeCallId, values: &[MirValueId]) -> String {
        row :: self.prelude_row(call)
        self.validate_prelude_count(row, values.len())
        symbol :: self.prelude_symbol(call)
        adapter :: self.exact_prelude_adapter(&symbol)
        args :: values.iter().enumerate().map(fn((index, value)) {
            if row.signature.borrow_mask[index] || adapter.is_some_and(fn((_, positions)) { positions.contains(&index) }) || RustEmitter.canonical_math_borrow(&symbol, index) { self.value_slot_reference(value, false) } else { self.value_owned(value) }
        }).collect().join(", ")
        symbol :: adapter.map(fn((name, _)) { "{self.config.root_prefix}{name}" }).unwrap_or(symbol)
        "{symbol}({args})"
    }

    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:29326
    fn prelude_call_args(self: &RustEmitter, call: MirPreludeCallId, args: &[String]) -> String {
        self.validate_prelude_count(self.prelude_row(call), args.len())
        "{self.prelude_symbol(call)}({args.join(", ")})"
    }

    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:29332
    fn list_aggregate_builder(self: &RustEmitter, function: &MirFunction, receiver: MirValueId, result: MirValueId?) -> String {
        if self.value_type(function, receiver).list_element().is_none() { panic("MIR list aggregate route has a non-list receiver") }
        result :: result.unwrap_or_else(fn() { panic("MIR list aggregate route has no result") })
        result_type :: self.value_type(function, result)
        result_type :: result_type.option_inner().or_else(fn() { result_type.result_parts().map(fn((ok, _)) { ok }) }).unwrap_or(result_type)
        if result_type.kind() == {
            .Tuple(fields) -> {
                if fields.len() != 2 || fields[0].0 != "min" || fields[1].0 != "max" { panic("MIR list aggregate result is not the checked min/max shape") }
                "|min, max| (min, max)"
            }
            .Apply { .. } -> {
                type_id :: result_type.nominal_id().unwrap_or_else(fn() { panic("MIR list aggregate result has no nominal type") })
                definition :: self.type_def(type_id)
                fields_opt :: if definition.kind == { .Struct { fields, .. } -> Some(fields); _ -> None }
                fields :: fields_opt.unwrap_or_else(fn() { panic("MIR list aggregate result is not a record") })
                if fields.len() != 2 || !fields.iter().any(fn(field) { field.name == "min" }) || !fields.iter().any(fn(field) { field.name == "max" }) { panic("MIR list aggregate result is not the checked min/max shape") }
                min :: fields.iter().find(fn(field) { field.name == "min" }).expect("checked min field")
                max :: fields.iter().find(fn(field) { field.name == "max" }).expect("checked max field")
                "|min, max| {self.rust_type(result_type)} {{ {self.field_name(min.id)}: min, {self.field_name(max.id)}: max }}"
            }
            _ -> panic("MIR list aggregate result is not the checked min/max shape")
        }
    }

    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:29386
    fn map_aggregate_builder(self: &RustEmitter, function: &MirFunction, result: MirValueId?) -> String {
        result :: result.unwrap_or_else(fn() { panic("MIR map aggregate route has no result") })
        element :: self.value_type(function, result).list_element().unwrap_or_else(fn() { panic("MIR map aggregate route has a non-list result") })
        fields_opt :: if element.kind() == { .Tuple(fields) -> Some(fields); _ -> None }
        fields :: fields_opt.unwrap_or_else(fn() { panic("MIR map aggregate result is not a named tuple") })
        if fields.len() != 2 || fields[0].0 != "key" || fields[1].0 != "value" { panic("MIR map aggregate result is not the checked key/value shape") }
        "|key, value| (key, value)"
    }

    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:29401
    fn canonical_builtin_optional_result(self: &RustEmitter, call: MirPreludeCallId, value: String) -> String {
        route :: self.prelude_row(call)
