use jet_foundation.MIR.*
use jet_foundation.Syntax.[TypedHeadKind, TYPE_DB_VALUE]
use jet_foundation.Names.[mangle, mangle_path]
use jet_codegen.Codegen.MIRRust.[RustEmitter, quote_rust_string, value_slot, local_slot, is_allocator_result_type]

extend RustEmitter {
    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:28797
    fn carrier_fact(self: &RustEmitter, call: MirPreludeCallId, receiver: MirValueId, field: MirFieldId) -> String {
        "{self.prelude_symbol(call)}(&(*{self.value_borrow(receiver)}), |__jet_report| __jet_report.{self.field_name(field)}.clone())"
    }

    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:28811
    fn typed_sql_binding(self: &RustEmitter, function: &MirFunction, value: MirValueId) -> String {
        db_value :: "{self.config.root_prefix}jet_std::DBValue"
        ty :: self.value_type(function, value)
        if ty.nominal_name() == Some(TYPE_DB_VALUE) { return self.value_owned(value) }
        if ty.kind() == {
            .Int -> "{db_value}::Int({self.config.root_prefix}jet_std::jet_int_owned_to_i64(&(*{self.value_borrow(value)})).expect(\"SQL Int exceeds i64 wire range\"))"
            .IntN { .. } -> "{db_value}::Int(({self.value_owned(value)}) as i64)"
            .Float | .Float32 -> "{db_value}::Float(({self.value_owned(value)}) as f64)"
            .Bool -> "{db_value}::Bool({self.value_owned(value)})"
            .String -> "{db_value}::Text({self.value_owned(value)})"
            .List(inner) if inner.kind() == MirTypeKind.IntN { signed: false, bits: 8 } -> "{db_value}::Blob({self.value_owned(value)})"
            .Char | .List(_) | .Map { .. } | .Shared(_) | .Option(_) | .Result { .. } | .Fn(_) | .SendFn { .. } | .Apply { .. } | .TraitObject(_) | .Tuple(_) | .FixedList { .. } | .InlineRange { .. } | .Tagged { .. } | .Quantity { .. } | .Union(_) | .Measure(_) -> "{db_value}::Text(({self.value_borrow(value)}).jet_show())"
        }
    }

    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:28866
    fn typed_text_interp(self: &RustEmitter, function: &MirFunction, call: MirPreludeCallId, kind: TypedHeadKind, literals: &[String], holes: &[MirValueId], trusted_html: &[Bool]) -> String {
        debug_assert(trusted_html.len() == holes.len())
        if kind != TypedHeadKind.HTML { debug_assert(trusted_html.iter().all(fn(trusted) { !trusted })) }
        literal_array :: "&[{literals.iter().map(fn(literal) { quote_rust_string(literal) }).collect().join(", ")}]"
        hole_array :: if kind == {
            .SQL -> holes.iter().map(fn(value) { self.typed_sql_binding(function, value) }).collect()
            .HTML -> holes.iter().enumerate().map(fn((index, value)) { if trusted_html.get(index).copied().unwrap_or(false) { "({self.value_owned(value)})" } else { "({self.value_borrow(value)}).jet_show()" } }).collect()
            .Sh | .URL | .Path | .DateTime -> holes.iter().map(fn(value) { "({self.value_borrow(value)}).jet_show()" }).collect()
        }
        hole_expr :: "vec![{hole_array.join(", ")}]"
        args :: if kind == {
            .HTML -> [literal_array, hole_expr, "&[{trusted_html.iter().map(fn(trusted) { trusted.to_string() }).collect().join(", ")}]" ]
            .SQL | .Sh | .URL | .Path | .DateTime -> [literal_array, hole_expr]
        }
        self.validate_prelude_count(self.prelude_row(call), args.len())
        args :: args.join(", ")
        symbol :: if kind == TypedHeadKind.SQL { "{self.prelude_symbol(call)}::<{self.config.root_prefix}jet_std::DBValue>" } else { self.prelude_symbol(call) }
        "{symbol}({args})"
    }

    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:28945
    fn gc_edit(self: &RustEmitter, call: MirPreludeCallId, root: MirValueId, edges: &[MirValueId], edit: MirValueId, index: MirValueId?, kind: MirGcEditKind, site: MirGcEditSiteId) -> String {
        root :: self.value_borrow(root)
        edge_values :: "&[{edges.iter().map(fn(value) { self.value_owned(value) }).collect().join(", ")}]"
        edit :: self.value_move(edit)
        args :: if kind == {
            .Clear | .Pop | .Plain -> {
                if index.is_some() || !edges.is_empty() { panic("MIR GC edit carries unused index or edge operands") }
                [root, edit]
            }
            .RemoveIndex -> {
                if !edges.is_empty() { panic("MIR GC remove edit carries edge operands") }
                index :: index.unwrap_or_else(fn() { panic("MIR GC remove edit has no index") })
                [root, self.value_owned(index), edit]
            }
            .InsertIndex -> {
                index :: index.unwrap_or_else(fn() { panic("MIR GC insert edit has no index") })
                [root, self.value_owned(index), edge_values, edit]
            }
            .Prepend | .Additive -> {
                if index.is_some() { panic("MIR GC edge edit carries an unused index") }
                [root, edge_values, edit]
            }
            .EdgeSlot -> {
                if index.is_some() { panic("MIR GC edge-slot edit carries an unused index") }
                [root, edge_values, edit, "{site.0}u64"]
            }
        }
        self.prelude_call_args_exact(call, &args)
    }

    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:28999
    fn native_callback_adapter(self: &RustEmitter, function: &MirFunction, closure: MirValueId, params: USize) -> String {
        send_fn :: if self.value_type(function, closure).kind() == { .SendFn { .. } -> true; _ -> false }
        callback :: self.value_move(closure)
        if params == {
            0 -> {
                invocation :: if send_fn || self.history_runtime_metadata_enabled() { "(__jet_host_callback)()" } else { self.fn_value_call("__jet_host_callback.clone()", &[]) }
                "{{ let __jet_host_callback = {callback}; move || {invocation} }}"
            }
            1 -> {
                argument :: if self.callable_borrow_mask(self.value_type(function, closure)).first().copied().unwrap_or(false) { "&__jet_host_arg" } else { "__jet_host_arg" }
                invocation :: if send_fn || self.history_runtime_metadata_enabled() { "(__jet_host_callback)({argument})" } else { self.fn_value_call("__jet_host_callback.clone()", &[argument.to_string()]) }
                "{{ let __jet_host_callback = {callback}; move |__jet_host_arg| {invocation} }}"
            }
            _ -> panic("native callback adapter supports at most one parameter")
        }
    }

    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:29046
    fn core_closure_call(self: &RustEmitter, function: &MirFunction, call: MirPreludeCallId, kind: MirCoreClosureKind, values: &[MirValueId], closure: MirValueId?, _site: MirSiteId, _label: &String) -> String {
        preview_source :: if kind == {
            .UiPreview { source_file, source_start_line, source_start_column, source_end_line, source_end_column, build_id, revision, .. } -> Some((source_file.clone(), source_start_line, source_start_column, source_end_line, source_end_column, build_id.clone(), revision.clone()))
            _ -> None
        }
        args := [String].new()
        // GATE #4494: generated host callback/thread/interrupt carriers remain native ABI.
        if kind == {
            .Spawn -> {
