    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:29628
    fn prelude_receiver_is_mutating(self: &RustEmitter, row: &MirPreludeCall) -> Bool {
        row.family == MirPreludeFamily.ClosureMethod && if row.symbol.name() == { "jet_edit_disjoint" | "jet_list_sort_by" | "jet_list_sort_by_desc" | "jet_list_try_sort_by" | "jet_list_try_sort_by_desc" | "jet_list_sort_by_compare" | "jet_list_update_first" -> true; _ -> false }
    }

    // Rust: crates/jet-codegen/src/Codegen/MIRRust.rs:29642
    fn closure_callback_params(self: &RustEmitter, function: &MirFunction, value: MirValueId) -> [MirType]? {
        if self.value_type(function, value).kind() == { .Fn(signature) -> Some(signature.params.clone()); .SendFn { params, .. } -> Some(params.clone()); _ -> None }
