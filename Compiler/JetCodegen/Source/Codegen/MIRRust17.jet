                closure :: closure.unwrap_or_else(fn() { panic("MIR CoreClosureCall Guard has no checked closure value") })
                if !values.is_empty() { panic("MIR CoreClosureCall Guard has {values.len()} value operands; expected none") }
                args.push(self.native_callback_adapter(function, closure, 0))
            }
