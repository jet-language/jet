                closure :: closure.unwrap_or_else(fn() { panic("MIR CoreClosureCall OnCommit has no checked closure value") })
                if values.len() != 1 { panic("MIR CoreClosureCall OnCommit has {values.len()} value operands; expected one handle") }
                args.push(self.mutable_receiver_reference(function, values[0])); args.push("Box::new({self.native_callback_adapter(function, closure, 0)})")
            }
            .OnRollback -> {
                closure :: closure.unwrap_or_else(fn() { panic("MIR CoreClosureCall OnRollback has no checked closure value") })
                if values.len() != 1 { panic("MIR CoreClosureCall OnRollback has {values.len()} value operands; expected one handle") }
                args.push(self.mutable_receiver_reference(function, values[0])); args.push("Box::new({self.native_callback_adapter(function, closure, 0)})")
            }
            .ReactiveDerived -> {
                closure :: closure.unwrap_or_else(fn() { panic("MIR CoreClosureCall ReactiveDerived has no checked closure value") })
                if !values.is_empty() { panic("MIR CoreClosureCall ReactiveDerived has {values.len()} value operands; expected none") }
                args.push(self.native_callback_adapter(function, closure, 0))
            }
            .ReactiveEffect -> {
                closure :: closure.unwrap_or_else(fn() { panic("MIR CoreClosureCall ReactiveEffect has no checked closure value") })
                if !values.is_empty() { panic("MIR CoreClosureCall ReactiveEffect has {values.len()} value operands; expected none") }
                args.push(self.native_callback_adapter(function, closure, 0))
            }
            .UiMount -> {
                closure :: closure.unwrap_or_else(fn() { panic("MIR CoreClosureCall UiMount has no checked closure value") })
                if !values.is_empty() { panic("MIR CoreClosureCall UiMount has {values.len()} value operands; expected none") }
                args.push(self.native_callback_adapter(function, closure, 0))
            }
            .UiPreview { .. } -> {
                closure :: closure.unwrap_or_else(fn() { panic("MIR CoreClosureCall UIPreview has no checked closure value") })
                if values.len() != 2 { panic("MIR CoreClosureCall UIPreview has {values.len()} value operands; expected name and viewport") }
                args.push(self.value_borrow(values[0])); args.push(self.value_move(values[1])); args.push(self.native_callback_adapter(function, closure, 0))
            }
            .UiAction -> {
                closure :: closure.unwrap_or_else(fn() { panic("MIR CoreClosureCall UiAction has no checked closure value") })
                if values.len() != 3 { panic("MIR CoreClosureCall UiAction has {values.len()} value operands; expected display, shortcut, accessible label") }
                args.push(self.value_borrow(values[0])); args.push(self.value_move(values[1])); args.push(self.value_move(values[2])); args.push(self.native_callback_adapter(function, closure, 0))
            }
