                closure :: closure.unwrap_or_else(fn() { panic("MIR CoreClosureCall UiTextInputOnDrop has no checked closure value") })
                if values.len() != 2 { panic("MIR CoreClosureCall UiTextInputOnDrop has {values.len()} value operands; expected state and IME mode") }
                args.push(self.value_borrow(values[0])); args.push(self.value_move(values[1])); args.push(self.native_callback_adapter(function, closure, 1))
