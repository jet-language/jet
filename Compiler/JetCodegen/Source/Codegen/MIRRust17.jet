            .Some((source_file, source_start_line, source_start_column, source_end_line, source_end_column, build_id, revision)) -> {
                source_id :: source_file.clone()
                "{self.config.root_prefix}jet_ui_preview_attach_compiler_source({emitted}, {quote_rust_string(&source_id)}, {quote_rust_string(&source_file)}, {quote_rust_string(&build_id)}, {quote_rust_string(&revision)}, {source_start_line}u32, {source_start_column}u32, {source_end_line}u32, {source_end_column}u32)"
