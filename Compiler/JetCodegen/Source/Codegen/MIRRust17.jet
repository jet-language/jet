                closure :: closure.unwrap_or_else(fn() { panic("MIR CoreClosureCall Spawn has no checked closure value") })
                site_index :: if values.len() == 2 { 0 } else { 1 }
                site :: "usize::try_from({self.native_int_argument(self.value_move(values[site_index]), None)}).unwrap_or_else(|_| {self.config.root_prefix}jet_arithmetic_stop(\"<mir>\", 0, \"spawn site is negative or exceeds usize range\"))"
                if values.len() == 3 { args.push(self.borrowed_value_reference(function, values[0], MirAccess.Read)) }
                args.push(site)
                args.push("&({self.value_move(values[site_index + 1])})")
                args.push("{{ let __jet_callback = {self.value_move(closure)}; move || (__jet_callback)() }}")
            }
            .Realtime -> {
                closure :: closure.unwrap_or_else(fn() { panic("MIR CoreClosureCall Realtime has no checked closure value") })
                if values.len() != 2 { panic("MIR CoreClosureCall Realtime has {values.len()} value operands; expected rate and frames") }
                args.push(self.value_move(values[0])); args.push(self.value_move(values[1])); args.push(self.value_move(closure))
            }
            .Serve -> {
                closure :: closure.unwrap_or_else(fn() { panic("MIR CoreClosureCall Serve has no checked closure value") })
                if values.len() != 1 { panic("MIR CoreClosureCall Serve has {values.len()} value operands; expected one address") }
                args.push(self.value_borrow(values[0])); args.push(self.value_move(closure))
            }
            .OnInterrupt -> {
                if closure.is_some() || values.len() != 1 { panic("MIR CoreClosureCall OnInterrupt requires one callback value and no closure field") }
                args.push(self.value_move(values[0]))
