// Checked TIR statement/control-flow lowering uses only shared MIR vocabulary.
use JetCodegen.Codegen.TIR.Mir.[LowerCtx, LowerError, TransactionRestore]
use JetCodegen.Codegen.TIR.TirToMirExpr.[lower_expr, lower_receiver_place, lower_or_fallback_window, lower_binary_dispatch]
use JetSema.AST.[BinOp, Type, AutoVectorizationFacts]
use JetSema.[Syntax, Sema]
use JetCodegen.Codegen.TIR.*
use jet_foundation.CanonicalPass
use jet_foundation.MIR.*

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:25
pub fn lower_stmts(ctx: &LowerCtx, stmts: [TStmt]) -> Unit LowerError! {
    before := canonical_statements_before(stmts)
    for stmt in stmts { if ctx.is_terminated() { break }; lower_stmt(ctx, stmt)? }
    record_lowered_statements(ctx, ^before)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:38
fn canonical_statements_before(stmts: [TStmt]) -> (String, String)? {
    if CanonicalPass.enabled() { Val((canonical_statements_payload(stmts), canonical_statements_identity(stmts))) } else { None }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:47
fn record_lowered_statements(ctx: LowerCtx, before: (String, String)?) {
    if before == Val((before_payload, before_identity)) {
        CanonicalPass.record("lowering", "mir.lower-statements", "crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs", "tir", ^before_payload, ^before_identity, "mir", CanonicalPass.debug_payload("mir", "mir.lower-statements", ctx.blocks), CanonicalPass.debug_identity("mir", "mir.lower-statements", ctx.blocks), "preserve")
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:69
pub fn lower_stmt(ctx: &LowerCtx, stmt: TStmt) -> Unit LowerError! {
    stmt == {
        InvariantViolation { construct, span } -> fail ctx.error(span, construct.to_string())
        Contract { contract } -> ctx.lower_contract(contract)?
        ContractScope { pre, body, post, result } -> ctx.lower_contract_scope(pre, body, post, result)?
        Let { name, kw, let_ty, init, gc_promotion, gc_transferred: _ } -> {
            scope_guard_binding := (init.kind == { CoreClosureCall { kind: Guard { .. } } -> true; _ -> false }) || (init.ty == { Named(name) -> name == "EventScope"; _ -> false })
            alias_place := init.kind == {
                Borrow { place, mutable } -> Val((ctx.lower_place(TPlace.Expr(place), if mutable { MirAccess.Write } else { MirAccess.Read })?, mutable))
                BuiltinMethod { recv, op: ViewMutNew { .. }, .. } -> {
                    if recv.ty.without_user_tags() == { List(_) -> true; _ -> false } {
                        lower_receiver_place(ctx, init, MirAccess.Write)?.map(fn(place) { (place, true) })
                    } else if !kw.contains("mut") && !scope_guard_binding && let_binds_init_type(let_ty, init.ty) && gc_promotion.is_none() {
                        ctx.read_window_place(init)?.map(fn(place) { (place, false) })
                    } else { None }
                }
                _ -> {
                    if !kw.contains("mut") && !scope_guard_binding && let_binds_init_type(let_ty, init.ty) && gc_promotion.is_none() {
                        place := init.kind == { OrFallback { value, fallback } -> lower_or_fallback_window(ctx, init, value, fallback)?; _ -> ctx.read_window_place(init)? }
                        place.map(fn(place) { (place, false) })
                    } else { None }
                }
            }
            ty := let_binding_type(let_ty, init.ty)
            is_uninit := init.kind == { Uninit -> true; _ -> false }
            value := if is_uninit || alias_place.is_some() { None } else {
                value := lower_expr(ctx, init)?
                Val(ctx.trait_box_value(value, init.ty, ty)?)
            }
            local := local_for_binding(name, kw)
            place := alias_place == {
                Val((alias, mutable)) -> {
                    if mutable { _ :: ctx.window_aliases.insert(local.name.to_string()) }
                    ctx.bind_local_alias(local, ^ty, alias, mutable)?
                }
                None -> if let_ty == { SendFn(_) -> true; _ -> false } { ctx.bind_local_send_fn(local, ^ty, local.mutable, false, is_uninit)? } else { ctx.bind_local(local, ^ty, local.mutable, false, is_uninit)? }
            }
            if is_uninit { _ :: ctx.emit("stmt.let.initialize-uninit", None, MirOperation.InitializeUninit { place })? }
            else if value == Val(value) { _ :: ctx.emit("stmt.let.write", None, MirOperation.WritePlace { place, value })? }
            if scope_guard_binding && alias_place.is_none() { ctx.register_scope_guard(place)? }
            if alias_place.is_none() { if value == Val(value) { ctx.register_file_owner_binding(place, value)? } }
        }
        RefutableBind { pattern, init, fallback } -> lower_refutable_bind(ctx, pattern, init, fallback)?
        GcEdit { root, slot, index_temp, stmt, .. } -> {
            scope := ctx.enter_scope(MirScopeKind.Authority, ctx.span(), Val("{root}.{slot}"))?
            if index_temp == Val((name, init)) { lower_let_like(ctx, name, init, true)? }
            lower_stmt(ctx, stmt)?
            ctx.exit_scope(scope)?
        }
        SplitViews { owner, root, name, start, end, single, write, elem_ty, line, .. } -> lower_split_view(ctx, owner, root, name, start, end, single, write, line, elem_ty)?
        TupleDestructure { tmp, init, kw, move_fields, binds } -> lower_tuple_destructure(ctx, init, tmp, kw, move_fields, binds)?
        StructDestructure { tmp, init, kw, move_fields, binds } -> lower_struct_destructure(ctx, init, tmp, kw, move_fields, binds)?
        ListDestructure { init, kw, want, elems, .. } -> lower_list_destructure(ctx, init, kw, want, elems)?
        Assign { place, op, value, clone_value, line } -> lower_assign(ctx, place, op, value, clone_value, line)?
        Return(value) -> ctx.lower_return(value)?
        ExprStmt(expr) -> { _ :: lower_expr(ctx, expr)? }
        TaskGroup { group, limit, body } -> {
            scope := ctx.enter_scope(MirScopeKind.TaskGroup, ctx.span(), Val(group.name.to_string()))?
            call_arg := fn(value: TExpr, borrow: Bool) { TCallArg { value, template_items: None, borrow, mut_borrow: false, clone: false, arc_clone: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None } }
            group_ty := Type.Named(Syntax.TYPE_TASKGROUP.to_string())
            constructor_args := limit == {
                Val(limit) -> {
                    conversion := resolve_numeric_conversion_op("I64", "Int") == {
                        Val(TryFrom { host_kind, dst_rust, dst_spelling }) -> (host_kind, dst_rust, dst_spelling)
                        _ -> { fail ctx.error(ctx.span(), "missing task group limit conversion") }
                    }
                    (host_kind, dst_rust, dst_spelling) := ^conversion
                    line := ctx.function_source().map(fn(source) { source.lines.line_col(source.text, ctx.span().start).0 }).unwrap_or(ctx.function.line) as U32
                    [call_arg(TExpr { ty: Type.IntN { signed: true, bits: 64 }, kind: TExprKind.NumericMethod { recv: limit, op: TNumericOp.CheckedIntToFixed { host_kind, dst_rust, dst_spelling, line } } }, false)]
                }
                None -> []
            }
            owner := TStaticOwner.Prelude { rooted: true, path: "jet_std::JetTaskGroup", generics: [] }
            constructor := TExpr { ty: group_ty, kind: TExprKind.StaticCall { owner, owner_type: None, method: TMethodRef.bare(if limit.is_some() { "with_limit" } else { "new" }), type_args: [], args: ^constructor_args } }
            group_place := ctx.bind_local(group, group_ty, group.mutable, false, false)?
            group_value := lower_expr(ctx, constructor)?
            _ :: ctx.emit("stmt.task-group.write", None, MirOperation.WritePlace { place: group_place, value: group_value })?
            close := TExpr { ty: Type.Named(Syntax.INTERNAL_UNIT_TYPE.to_string()), kind: TExprKind.StaticCall { owner, owner_type: None, method: TMethodRef.bare("close"), type_args: [], args: [call_arg(TExpr { ty: group_ty, kind: TExprKind.Local(group) }, true)] } }
            ctx.register_defer_close(^close, group)?
            lower_stmts(ctx, body)?
            ctx.exit_scope(scope)?
        }
        DeferClose { close, resource } -> ctx.register_defer_close(close, resource)?
        If { cond, then_body, else_body, .. } -> lower_if(ctx, cond, then_body, else_body)?
        Loop { label, body } -> lower_loop(ctx, label, body)?
        While { label, cond, body } -> lower_while(ctx, label, cond, body)?
        CountedLoop { label, init, cond, step, auto_vectorization, body } -> lower_counted_loop(ctx, label, init, cond, step, auto_vectorization, body)?
        Range { label, var, source, start, end, step, exclusive, auto_vectorization, body } -> lower_range_loop(ctx, label, var, source, start, end, step, exclusive, auto_vectorization, body)?
        Break(label) -> {
            target := ctx.resolve_break(label)?
            depth := ctx.break_cleanup_depth(label)?
            ctx.terminate_with_cleanup(MirTerminator.Break { target, value: None }, depth)?
        }
        BreakValue { label, value } -> {
            value := lower_expr(ctx, value)?
            target := ctx.resolve_break(label)?
            depth := ctx.break_cleanup_depth(label)?
            ctx.terminate_with_cleanup(MirTerminator.Break { target, value: Val(value) }, depth)?
        }
        Continue(label) -> {
            target := ctx.resolve_continue(label)?
            depth := ctx.continue_cleanup_depth(label)?
            ctx.terminate_with_cleanup(MirTerminator.Continue { target }, depth)?
        }
        EnumMatch { scrutinee, clone_subject, arms, else_body, fallthrough } -> lower_enum_match(ctx, scrutinee, clone_subject, arms, else_body, fallthrough)?
        RangeSwitch { subject, arms, else_body } -> lower_range_switch(ctx, subject, arms, else_body)?
        IndexAssign { uninit, base, index, is_map, value } -> {
            // RHS precedes effectful place evaluation.
            expected := base.ty.without_user_tags() == { Map { value, .. } -> Val(value); List(elem) | FixedList { elem, .. } -> Val(elem); _ -> None }
            source := value.ty
            lowered := lower_expr(ctx, value)?
            assigned := expected == { Val(expected) -> ctx.trait_box_value(lowered, source, expected)?; None -> lowered }
            place := ctx.lower_index_place(base, index, if uninit { MirIndexKind.FixedListProof } else if is_map { MirIndexKind.Map } else { MirIndexKind.List }, MirAccess.Write)?
            _ :: ctx.emit("stmt.index.write", None, MirOperation.WritePlace { place, value: assigned })?
            ctx.drop_temporary_shared_guard(place)?
        }
        IndexFieldAssign(assign) -> lower_index_field_assign(ctx, assign)?
        IndexHookAssign { base, index, value, .. } -> {
            call := TExpr {
                ty: Type.Result { ok: Type.Named(Syntax.INTERNAL_UNIT_TYPE.to_string()), err: Type.Named(Syntax.TYPE_ERR.to_string()) },
                kind: TExprKind.MethodCall {
                    recv: base, method: TMethodRef.trait_method(Syntax.TRAIT_INDEX_MUT, "set"), type_args: [],
                    args: [
                        TCallArg { value: index, template_items: None, borrow: !index.ty.is_scalar(), mut_borrow: false, clone: false, arc_clone: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None },
                        TCallArg { value, template_items: None, borrow: !value.ty.is_scalar(), mut_borrow: false, clone: false, arc_clone: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None }
                    ], source_first_string_literal: None, operator_line: None
                }
            }
            _ :: lower_expr(ctx, call)?
        }
        MathSwizzleAssign { base, lanes, value, clone_value, .. } -> lower_swizzle_assign(ctx, base, lanes, value, clone_value)?
        ForIn { label, var, var2, source, collection, step, method_kind, columnar, by_value, source_stable, body } -> lower_for_in(ctx, label, var, var2, source, collection, step, method_kind, by_value, columnar, source_stable, body)?
        Inline(body) -> lower_stmts(ctx, body)?
        DebugOnly(body) -> lower_debug_only(ctx, body)?
        MixedSwitch { subject, arms, else_body, .. } -> lower_mixed_switch(ctx, subject, arms, else_body)?
        Unsafe { gate, body } -> {
            scope := ctx.enter_scope(MirScopeKind.Unsafe, ctx.span(), Val(gate.reason.to_string()))?
            ctx.set_scope_fact(scope, "sentry_file", gate.file.to_string())?
            ctx.set_scope_fact(scope, "sentry_enabled", gate.enabled.to_string())?
            ctx.set_scope_fact(scope, "sentry_fenced", gate.fenced.to_string())?
            ctx.set_scope_fact(scope, "sentry_line", gate.line.to_string())?
            lower_stmts(ctx, body)?
            ctx.exit_scope(scope)?
        }
        SentryPolicy { enabled, body } -> {
            scope := ctx.enter_scope(MirScopeKind.Policy, ctx.span(), Val(if enabled { "enabled" } else { "disabled" }))?
            ctx.set_scope_fact(scope, "sentry_enabled", enabled.to_string())?
            lower_stmts(ctx, body)?
            ctx.exit_scope(scope)?
        }
        Impure(body) -> lower_scoped(ctx, MirScopeKind.Impure, None, body)?
        Reactive { executable } -> {
            site := ctx.site_id_for(ctx.span(), "reactive").0 as USize
            expr := TExpr { ty: Type.Named(Syntax.INTERNAL_UNIT_TYPE.to_string()), kind: TExprKind.CoreClosureCall { kind: TCoreClosureKind.ReactiveEffect { executable, site } } }
            _ :: lower_expr(ctx, expr)?
        }
        Region(body) -> lower_scoped(ctx, MirScopeKind.Region, None, body)?
        Layout { handle, label, body } -> {
            scope := ctx.enter_scope(MirScopeKind.Layout, ctx.span(), Val(label.to_string()))?
            handle_ty := Type.Named(Syntax.LAYOUT_TYPE.to_string())
            place := ctx.bind_local(handle, handle_ty, handle.mutable, false, false)?
            value := ctx.emit("stmt.layout.global", Val(handle_ty), MirOperation.Global { name: "layout::{label}" })?
            _ :: ctx.emit("stmt.layout.write", None, MirOperation.WritePlace { place, value })?
            lower_stmts(ctx, body)?
            ctx.exit_scope(scope)?
        }
        ContextBlock { guards, body } -> {
            mut deadline: MirValueId? := None
            for (name, value) in guards { lowered := lower_expr(ctx, value)?; if name == Syntax.CTX_FIELD_DEADLINE { deadline = Val(lowered) } }
            scope := ctx.enter_scope(MirScopeKind.Context, ctx.span(), None)?
            if deadline == Val(deadline) { ctx.set_scope_deadline(scope, deadline)? }
            lower_stmts(ctx, body)?
            ctx.exit_scope(scope)?
        }
        Live { body } -> lower_scoped(ctx, MirScopeKind.Live, None, body)?
        Shield { body } -> lower_scoped(ctx, MirScopeKind.Shield, None, body)?
        ScopeMember { kind, body } -> lower_scope_member(ctx, kind, body)?
        Transact { handle, snapshots, stm, body } -> lower_transaction(ctx, handle, snapshots, stm, body)?
        LineMarker(line) -> {
            checked := U32.try_from(line).map_err(fn(_) { LowerError.new(ctx.span(), "checked source line exceeds MIR line range") })?
            ctx.set_line_marker(checked)
        }
        SourceSpan(span) -> ctx.set_span(span)
        Erased { construct, span, reason } -> ctx.record_erasure(construct, span, reason)
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:737
fn let_binding_type(let_ty: TLetTy, init_ty: Type) -> Type {
    let_ty == {
        Inferred | StrView -> init_ty.clone()
        Annotated { ty, .. } -> ty.clone()
        Tuple(types) -> Type.Tuple(types.iter().enumerate().map(fn(entry) { (entry.0.to_string(), entry.1.clone()) }).collect())
        SendFn(ty) -> ty.clone()
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:756
fn let_binds_init_type(let_ty: TLetTy, init_ty: Type) -> Bool {
    let_ty == { Inferred -> true; Annotated { ty, wrapper: None } -> ty.without_user_tags() == init_ty.without_user_tags(); _ -> false }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:767
fn local_for_binding(name: String, kw: String) -> TLocal { if kw.contains("mut") { TLocal.user(name).as_mutable() } else { TLocal.user(name) } }

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:775
fn lower_let_like(ctx: &LowerCtx, name: String, init: TExpr, mutable: Bool) -> Unit LowerError! {
    is_uninit := init.kind == { Uninit -> true; _ -> false }
    value := if is_uninit { None } else { Val(lower_expr(ctx, init)?) }
    local := if mutable { TLocal.user(name).as_mutable() } else { TLocal.user(name) }
    place := ctx.bind_local(local, init.ty, mutable, false, is_uninit)?
    if is_uninit { _ :: ctx.emit("stmt.let-like.initialize-uninit", None, MirOperation.InitializeUninit { place })? }
    else if value == Val(value) { _ :: ctx.emit("stmt.let-like.write", None, MirOperation.WritePlace { place, value })? }
    if value == Val(value) { ctx.register_file_owner_binding(place, value)? }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:812
fn maybe_copy(ctx: &LowerCtx, value: MirValueId, ty: Type, copy: Bool) -> MirValueId LowerError! {
    if copy { ctx.emit("stmt.copy", Val(ty.clone()), MirOperation.Copy { value, fact: MirCopyFact.Materialize })? } else { value }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:832
fn lower_refutable_bind(ctx: &LowerCtx, pattern: TPattern, init: TExpr, fallback: [TStmt]) -> Unit LowerError! {
    subject := ctx.lower_read_window(init)? == { Val(subject) -> subject; None -> lower_expr(ctx, init)? }
    lowered_pattern := ctx.lower_pattern(pattern)?
    shadow_mark := ctx.shadow_mark()
    test := ctx.lower_pattern_condition(subject, lowered_pattern)?
    success := ctx.new_block(ctx.span(), "refutable.success")?
    miss := ctx.new_block(ctx.span(), "refutable.miss")?
    join := ctx.new_block(ctx.span(), "refutable.join")?
    ctx.terminate(MirTerminator.Branch { condition: test, then_target: success, else_target: miss })
    ctx.switch_to(success)
    ctx.bind_success_pattern(subject, lowered_pattern)?
    if !ctx.is_terminated() { ctx.terminate(MirTerminator.Jump { target: join }) }
    payload_bindings := ctx.restore_shadowed_locals(shadow_mark)
    ctx.switch_to(miss)
    lower_stmts(ctx, fallback)?
    ctx.reinstate_shadowed_locals(^payload_bindings)
    if !ctx.is_terminated() { ctx.terminate(MirTerminator.Jump { target: join }) }
    ctx.switch_to(join)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:875
fn lower_split_view(ctx: &LowerCtx, owner: TExpr?, root: String, name: String, start: I64, end: I64, single: Bool, write: Bool, line: USize, elem_ty: Type?) -> Unit LowerError! {
    element := elem_ty == { Val(element) -> element.clone(); None -> { fail LowerError.new(ctx.span(), "split view `{name}` has no checked element type") } }
    root_expr := TExpr { ty: Type.List(element), kind: TExprKind.Local(TLocal.user(root)) }
    base_expr := owner.unwrap_or(root_expr)
    start_expr := TExpr { ty: Type.Int, kind: TExprKind.IntLit(start, None) }
    end_expr := TExpr { ty: Type.Int, kind: TExprKind.IntLit(end, None) }
    if single && write {
        place := ctx.lower_index_place(base_expr, start_expr, MirIndexKind.FixedListProof, MirAccess.Write)?
        local := TLocal.user(name).as_mutable()
        _ :: ctx.bind_local_alias(local, ^element, place, true)?
        return
    }
    ty := if single { element.clone() } else { Type.Apply { name: if write { "ViewMut" } else { "View" }, args: [element] } }
    value := if single { ctx.lower_index_value(base_expr, start_expr, MirIndexKind.FixedListProof, element, MirAccess.Read)? } else {
        range_expr := TExpr { ty: Type.Named("Range"), kind: TExprKind.StructLit { fields: [("start", start_expr, false), ("end", end_expr, false), ("exclusive", TExpr { ty: Type.Bool, kind: TExprKind.BoolLit(false) }, false)], extra: None, as_trait: None } }
        view := TExpr { ty, kind: TExprKind.BuiltinMethod { recv: base_expr, op: if write { TBuiltinOp.ViewMutNew { line } } else { TBuiltinOp.ViewNew { line } }, args: [^range_expr] } }
        lower_expr(ctx, view)?
    }
    local := if write { TLocal.user(name).as_mutable() } else { TLocal.user(name) }
    place := ctx.bind_local(local, ^ty, write, false, false)?
    _ :: ctx.emit("stmt.split.write", None, MirOperation.WritePlace { place, value })?
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:985
fn lower_tuple_destructure(ctx: &LowerCtx, init: TExpr, tmp: String, kw: String, move_fields: Bool, binds: [(String, String)]) -> Unit LowerError! {
    subject := if move_fields {
        lower_receiver_place(ctx, init, MirAccess.Move)? == { Val(place) -> ctx.emit("stmt.tuple.move-source", Val(init.ty), MirOperation.MovePlace { place })?; None -> lower_expr(ctx, init)? }
    } else { lower_expr(ctx, init)? }
    mutable := kw.contains("mut")
    if !move_fields {
        for (index, (local_name, _)) in binds.iter().enumerate() {
            field_name := ctx.field_name_for_type(init.ty, index)?
            field_ty := ctx.checked_field_type(init.ty, field_name)?
            field_id := ctx.field_id_for_type(init.ty, field_name)?
            projected := ctx.emit("stmt.tuple.field", Val(field_ty), MirOperation.Field { base: subject, field: field_id })?
            value := maybe_copy(ctx, projected, field_ty, true)?
            local := if mutable { TLocal.user(local_name).as_mutable() } else { TLocal.user(local_name) }
            place := ctx.bind_local(local, ^field_ty, mutable, false, false)?
            _ :: ctx.emit("stmt.tuple.write", None, MirOperation.WritePlace { place, value })?
        }
        return
    }
    temp := TLocal.generated(tmp)
    _ :: ctx.bind_local(temp, init.ty, true, false, false)?
    temp_place := ctx.place_for_local(temp, MirAccess.Move)?
    _ :: ctx.emit("stmt.tuple.move-temp.write", None, MirOperation.WritePlace { place: temp_place, value: subject })?
    for (index, (local_name, _)) in binds.iter().enumerate() {
        field_name := ctx.field_name_for_type(init.ty, index)?
        field_ty := ctx.checked_field_type(init.ty, field_name)?
        field_place := ctx.project_field_place(temp_place, field_name, field_ty, ctx.span())?
        value := ctx.emit("stmt.tuple.move-field", Val(field_ty), MirOperation.MovePlace { place: field_place })?
        local := if mutable { TLocal.user(local_name).as_mutable() } else { TLocal.user(local_name) }
        place := ctx.bind_local(local, ^field_ty, mutable, false, false)?
        _ :: ctx.emit("stmt.tuple.write", None, MirOperation.WritePlace { place, value })?
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:1074
fn lower_struct_destructure(ctx: &LowerCtx, init: TExpr, tmp: String, kw: String, move_fields: Bool, binds: [(String, String)]) -> Unit LowerError! {
    subject := if move_fields {
        lower_receiver_place(ctx, init, MirAccess.Move)? == { Val(place) -> ctx.emit("stmt.struct.move-source", Val(init.ty), MirOperation.MovePlace { place })?; None -> lower_expr(ctx, init)? }
    } else { lower_expr(ctx, init)? }
    mutable := kw.contains("mut")
    if !move_fields {
        for (local_name, field_name) in binds {
            field_ty := ctx.checked_field_type(init.ty, field_name)?
            field_id := ctx.field_id_for_type(init.ty, field_name)?
            projected := ctx.emit("stmt.struct.field", Val(field_ty), MirOperation.Field { base: subject, field: field_id })?
            value := maybe_copy(ctx, projected, field_ty, true)?
            local := if mutable { TLocal.user(local_name).as_mutable() } else { TLocal.user(local_name) }
            place := ctx.bind_local(local, ^field_ty, mutable, false, false)?
            _ :: ctx.emit("stmt.struct.write", None, MirOperation.WritePlace { place, value })?
        }
        return
    }
    temp := TLocal.generated(tmp)
    _ :: ctx.bind_local(temp, init.ty, true, false, false)?
    temp_place := ctx.place_for_local(temp, MirAccess.Move)?
    _ :: ctx.emit("stmt.struct.move-temp.write", None, MirOperation.WritePlace { place: temp_place, value: subject })?
    for (local_name, field_name) in binds {
        field_ty := ctx.checked_field_type(init.ty, field_name)?
        field_place := ctx.project_field_place(temp_place, field_name, field_ty, ctx.span())?
        value := ctx.emit("stmt.struct.move-field", Val(field_ty), MirOperation.MovePlace { place: field_place })?
        local := if mutable { TLocal.user(local_name).as_mutable() } else { TLocal.user(local_name) }
        place := ctx.bind_local(local, ^field_ty, mutable, false, false)?
        _ :: ctx.emit("stmt.struct.write", None, MirOperation.WritePlace { place, value })?
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:1161
fn lower_list_destructure(ctx: &LowerCtx, init: TExpr, kw: String, want: USize, elems: [String]) -> Unit LowerError! {
    subject := lower_expr(ctx, init)?
    mutable := kw.contains("mut")
    element_ty := init.ty == { List(ty) | FixedList { elem: ty, .. } -> ty.clone(); _ -> init.ty.clone() }
    for (index, local_name) in elems.iter().enumerate().take(want) {
        index_value := const_int(ctx, index as I64)?
        projected := ctx.emit_index_value(subject, index_value, MirIndexKind.List, element_ty, MirAccess.Read, "stmt.list-destructure.index")?
        local := if mutable { TLocal.user(local_name).as_mutable() } else { TLocal.user(local_name) }
        place := ctx.bind_local(local, element_ty, mutable, false, false)?
        _ :: ctx.emit("stmt.list-destructure.write", None, MirOperation.WritePlace { place, value: projected })?
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:1202
fn assignment_place_type(ctx: LowerCtx, place: TPlace) -> Type LowerError! {
    place == {
        Expr(expr) -> expr.ty.clone()
        Local(local) -> ctx.local_types.get(local.name).cloned().or_else(fn() { local.persist_ty.clone() }) == { Val(ty) -> ^ty; None -> { fail ctx.error(ctx.span(), "checked MIR local `{local.name}` has no type") } }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:1222
fn assignment_binary_overflow(op: BinOp, lhs: Type, rhs: Type) -> Bool {
    ((op == { Add | Sub | Mul | Div -> true; _ -> false }) && (lhs.is_integer() || rhs.is_integer())) || ((op == { Shl | Shr -> true; _ -> false }) && lhs.is_integer())
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:1228
fn lower_assign(ctx: &LowerCtx, place: TPlace, op: BinOp?, value: TExpr, clone_value: Bool, line: U32) -> Unit LowerError! {
    place_ty := assignment_place_type(ctx, place)?
    rhs := lower_expr(ctx, value)?
    rhs_copy := maybe_copy(ctx, rhs, value.ty, clone_value)?
    place_id := ctx.lower_place(place, MirAccess.Write)?
    assigned := op == {
        Val(op) -> {
            old := ctx.emit("stmt.assign.read", Val(place_ty), MirOperation.ReadPlace(place_id))?
            dispatch := lower_binary_dispatch(ctx, op, assignment_binary_overflow(op, place_ty, value.ty), place_ty, value.ty, place_ty, line)?
            ctx.emit("stmt.assign.rmw", Val(place_ty), MirOperation.Binary { op: mir_binary_op(op), dispatch, left: old, right: rhs_copy })?
        }
        None -> ctx.trait_box_value(rhs_copy, value.ty, place_ty)?
    }
    owning_file_slot := ctx.places.iter().find(fn(candidate) { candidate.id == place_id }).and_then(fn(candidate) { candidate.ty.identity }).is_some_and(fn(identity) { ctx.is_core_file_owner(identity) })
    ctx.emit_file_owner_replacement(place_id)?
    _ :: ctx.emit("stmt.assign.write", None, if owning_file_slot { MirOperation.ReplacePlace { place: place_id, value: assigned } } else { MirOperation.WritePlace { place: place_id, value: assigned } })?
    ctx.drop_temporary_shared_guard(place_id)?
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:1298
fn lower_index_field_assign(ctx: &LowerCtx, assign: TIndexFieldAssign) -> Unit LowerError! {
    rhs := lower_expr(ctx, assign.value)?
    rhs_copy := maybe_copy(ctx, rhs, assign.value.ty, assign.clone_value)?
    base_place := ctx.lower_index_place(assign.base, assign.index, if assign.is_map { MirIndexKind.Map } else { MirIndexKind.List }, MirAccess.Write)?
    place := ctx.project_field_place(base_place, assign.field, assign.field_ty, ctx.span())?
    assigned := assign.op == {
        Val(op) -> {
            old := ctx.emit("stmt.index-field.read", Val(assign.field_ty), MirOperation.ReadPlace(place))?
            dispatch := lower_binary_dispatch(ctx, op, assignment_binary_overflow(op, assign.field_ty, assign.value.ty), assign.field_ty, assign.value.ty, assign.field_ty, assign.line as U32)?
            ctx.emit("stmt.index-field.rmw", Val(assign.field_ty), MirOperation.Binary { op: mir_binary_op(op), dispatch, left: old, right: rhs_copy })?
        }
        None -> ctx.trait_box_value(rhs_copy, assign.value.ty, assign.field_ty)?
    }
    owning_file_slot := ctx.mir_type(assign.field_ty)?.identity.is_some_and(fn(identity) { ctx.is_core_file_owner(identity) })
    _ :: ctx.emit("stmt.index-field.write", None, if owning_file_slot { MirOperation.ReplacePlace { place, value: assigned } } else { MirOperation.WritePlace { place, value: assigned } })?
    ctx.drop_temporary_shared_guard(place)?
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:1372
fn lower_swizzle_assign(ctx: &LowerCtx, base: TExpr, lanes: [U8], value: TExpr, clone_value: Bool) -> Unit LowerError! {
    rhs := lower_expr(ctx, value)?
    (rhs_values, rhs_ty) := if lanes.len() > 1 {
        rhs_type_name := value.ty.without_user_tags() == { Named(name) -> name; _ -> { fail ctx.error(ctx.span(), "checked multi-lane swizzle assignment has no vector RHS") } }
        scalar_ty := Sema.math_scalar_ty(rhs_type_name)
        lane_carrier := TFailureCarrier.from_checked_type(scalar_ty)
        line := ctx.source_line()
        mut values: [MirValueId] := [].with_capacity(lanes.len())
        for ordinal in 0..<lanes.len() {
            index := ctx.emit("math-swizzle-rhs-index-{ordinal}", Val(Type.Int), MirOperation.Constant(MirConstant.Int { value: ordinal as I64, width: None, spelling: None }))?
            call := ctx.intern_prelude_route(lane_index_route(rhs_type_name, scalar_ty, lane_carrier)?)?
            location := ctx.panic_location_at(line)
            context := ctx.panic_context_at(line, None)
            values.push(ctx.emit("math-swizzle-rhs-lane", Val(scalar_ty), MirOperation.Index { call, base: rhs, index, kind: MirIndexKind.Lane, access: MirAccess.Read, location, context })?)
        }
        (^values, scalar_ty)
    } else { ([rhs], value.ty) }
    places := ctx.lower_swizzle_place(base, lanes, MirAccess.Write)?
    for (index, place) in places.iter().enumerate() {
        value := maybe_copy(ctx, rhs_values[index], rhs_ty, clone_value || index + 1 < lanes.len())?
        _ :: ctx.emit("stmt.swizzle.write", None, MirOperation.WritePlace { place, value })?
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:1449
struct IfChainLink { join: MirBlockId, else_scope: (MirScopeId, (String, String)?)? }

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:1462
fn lower_if(ctx: &LowerCtx, cond: TIfCond, then_body: [TStmt], else_body: [TStmt]?) -> Unit LowerError! {
    mut links: [IfChainLink] := []
    // Read windows retain borrowed chain links rather than copying nested arms.
    mut current_cond := &cond
    mut current_then := &then_body
    mut current_else := &else_body
    loop {
        then_block := ctx.new_block(ctx.span(), "if.then")?
        else_block := ctx.new_block(ctx.span(), "if.else")?
        join := ctx.new_block(ctx.span(), "if.join")?
        shadow_mark := ctx.shadow_mark()
        lower_cond(ctx, current_cond, then_block, else_block)?
        ctx.switch_to(then_block)
        scope := ctx.enter_scope(MirScopeKind.Live, ctx.span(), None)?
        lower_stmts(ctx, current_then)?
        ctx.exit_scope(scope)?
        if !ctx.is_terminated() { ctx.terminate(MirTerminator.Jump { target: join }) }
        _ :: ctx.restore_shadowed_locals(shadow_mark)
        ctx.switch_to(else_block)
        if current_else == Val(body) {
            scope := ctx.enter_scope(MirScopeKind.Live, ctx.span(), None)?
            if body == [If { cond: next_cond, then_body: next_then, else_body: next_else, .. }] {
                before := canonical_statements_before(body)
                if !ctx.is_terminated() {
                    links.push(IfChainLink { join, else_scope: Val((scope, ^before)) })
                    current_cond = &next_cond
                    current_then = &next_then
                    current_else = &next_else
                    continue
                }
                record_lowered_statements(ctx, ^before)
            } else { lower_stmts(ctx, body)? }
            ctx.exit_scope(scope)?
        }
        links.push(IfChainLink { join, else_scope: None })
        break
    }
    while links.pop() == Val(link) {
        if link.else_scope == Val((scope, before)) { record_lowered_statements(ctx, ^before); ctx.exit_scope(scope)? }
        if !ctx.is_terminated() { ctx.terminate(MirTerminator.Jump { target: link.join }) }
        ctx.switch_to(link.join)
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:1535
fn lower_cond(ctx: &LowerCtx, cond: TIfCond, then_target: MirBlockId, else_target: MirBlockId) -> Unit LowerError! {
    cond == {
        Plain(expr) -> { value := lower_expr(ctx, expr)?; ctx.terminate(MirTerminator.Branch { condition: value, then_target, else_target }) }
        And { left, right } -> {
            right_block := ctx.new_block(ctx.span(), "if.and.right")?
            lower_cond(ctx, left, right_block, else_target)?
            ctx.switch_to(right_block)
            lower_cond(ctx, right, then_target, else_target)?
        }
        IfLet { pattern, subj } -> {
            subject := ctx.lower_pattern_subject(subj)?
            lowered_pattern := ctx.lower_pattern(pattern)?
            test := ctx.lower_pattern_condition(subject, lowered_pattern)?
            ctx.terminate(MirTerminator.Branch { condition: test, then_target, else_target })
        }
        IsNone { subj } -> {
            subject := lower_expr(ctx, subj)?
            present := ctx.emit("if.is-none.test", Val(Type.Bool), MirOperation.OptionIsSome { subject })?
            ctx.terminate(MirTerminator.Branch { condition: present, then_target: else_target, else_target: then_target })
        }
        Matches { pattern, subj } -> {
            subject := ctx.lower_pattern_subject(subj)?
            lowered_pattern := ctx.lower_pattern(pattern)?
            test := ctx.lower_pattern_condition(subject, lowered_pattern)?
            ctx.terminate(MirTerminator.Branch { condition: test, then_target, else_target })
        }
        WithPrelude { prelude, cond } -> { lower_stmts(ctx, prelude)?; if !ctx.is_terminated() { lower_cond(ctx, cond, then_target, else_target)? } }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:1599
fn lower_loop(ctx: &LowerCtx, label: String?, body: [TStmt]) -> Unit LowerError! { _ :: lower_loop_with_exit(ctx, label, body)? }

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:1603
pub fn lower_loop_value(ctx: &LowerCtx, label: String?, body: [TStmt], result_ty: Type) -> MirValueId LowerError! {
    exit := lower_loop_with_exit(ctx, label, body)?
    mut incoming: [(MirBlockId, MirValueId)] := []
    mut value_less_break := false
    for block in ctx.blocks {
        if block.terminator == Break { target, value } {
            if target != exit { continue }
            if value == Val(value) { incoming.push((block.id, value)) } else { value_less_break = true }
        }
    }
    if value_less_break || incoming.is_empty() { fail ctx.error(ctx.span(), "TExprKind::InlineBlock result loop has a break exit without a value") }
    ctx.switch_to(exit)
    ctx.emit("loop-value-phi", Val(result_ty.clone()), MirOperation.Phi { incoming: ^incoming })?
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:1638
fn lower_loop_with_exit(ctx: &LowerCtx, label: String?, body: [TStmt]) -> MirBlockId LowerError! {
    header := ctx.new_block(ctx.span(), "loop.header")?
    body_block := ctx.new_block(ctx.span(), "loop.body")?
    exit := ctx.new_block(ctx.span(), "loop.exit")?
    ctx.terminate(MirTerminator.Jump { target: header })
    ctx.switch_to(header)
    ctx.terminate(MirTerminator.Jump { target: body_block })
    ctx.switch_to(body_block)
    ctx.push_loop(label.map(fn(label) { label.to_string() }), exit, header)
    ctx.push_lexical_frame()
    lower_stmts(ctx, body)?
    ctx.pop_lexical_frame()?
    ctx.pop_loop()
    if !ctx.is_terminated() { ctx.terminate(MirTerminator.Jump { target: header }) }
    ctx.switch_to(exit)
    exit
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:1662
fn lower_while(ctx: &LowerCtx, label: String?, cond: TExpr, body: [TStmt]) -> Unit LowerError! {
    header := ctx.new_block(ctx.span(), "while.header")?
    body_block := ctx.new_block(ctx.span(), "while.body")?
    exit := ctx.new_block(ctx.span(), "while.exit")?
    ctx.terminate(MirTerminator.Jump { target: header })
    ctx.switch_to(header)
    condition := lower_expr(ctx, cond)?
    ctx.terminate(MirTerminator.Branch { condition, then_target: body_block, else_target: exit })
    ctx.switch_to(body_block)
    ctx.push_loop(label.map(fn(label) { label.to_string() }), exit, header)
    ctx.push_lexical_frame()
    lower_stmts(ctx, body)?
    ctx.pop_lexical_frame()?
    ctx.pop_loop()
    if !ctx.is_terminated() { ctx.terminate(MirTerminator.Jump { target: header }) }
    ctx.switch_to(exit)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_stmt.rs:1692
fn lower_counted_loop(ctx: &LowerCtx, label: String?, init: TStmt, cond: TExpr, step: TStmt?, auto_vectorization: AutoVectorizationFacts?, body: [TStmt]) -> Unit LowerError! {
    loop_span := ctx.span()
    lower_stmt(ctx, init)?
    if ctx.is_terminated() { return }
    header := ctx.new_block(ctx.span(), "counted.header")?
    body_block := ctx.new_block(ctx.span(), "counted.body")?
    step_block := ctx.new_block(ctx.span(), "counted.step")?
    exit := ctx.new_block(ctx.span(), "counted.exit")?
    ctx.terminate(MirTerminator.Jump { target: header })
    ctx.switch_to(header)
    condition := lower_expr(ctx, cond)?
    ctx.terminate(MirTerminator.Branch { condition, then_target: body_block, else_target: exit })
    ctx.switch_to(body_block)
    ctx.push_loop(label.map(fn(label) { label.to_string() }), exit, step_block)
    ctx.push_lexical_frame()
    lower_stmts(ctx, body)?
    ctx.pop_lexical_frame()?
    ctx.pop_loop()
    if !ctx.is_terminated() { ctx.terminate(MirTerminator.Jump { target: step_block }) }
    ctx.switch_to(step_block)
    if step == Val(step) { lower_stmt(ctx, step)? }
    if !ctx.is_terminated() { ctx.terminate(MirTerminator.Jump { target: header }) }
    ctx.switch_to(exit)
    if auto_vectorization == Val(facts) {
        cursor_place := ctx.loop_cursor_place(cond)
        body_blocks := ctx.loop_body_blocks(header, body_block, Val(exit), Val(step_block))
        cursor := ctx.checked_loop_cursor(body_blocks, Val(step_block), cursor_place, None)
        ctx.record_checked_vector_fact(header, cursor, ^body_blocks, Val(step_block), cursor_place, facts, loop_span)?
    }
}
