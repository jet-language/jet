use jet_foundation.[ProgramBundle, MirArtifactRequest, MirArtifactKind, PackageEdition, Type, Item, TFunc, TFuncKind, TFactChannel, TFactExclusivity, TFactPurity, TUnsafeGate, TGenericParam, TContractKind, TContractDisposition, TContract, TWebParamReconstruction, TSerdeCodec, TForInMethod, TIfCond, TScopeMemberKind, TIndexFieldAssign, TStructExtra, AccessConvention, Span]
use std.collections.HashSet
use jet_codegen.[LowerError, TirProgram, TirPackageFacts, CanonicalPass]

// Rust: crates/jet-codegen/src/Codegen/TIR/mod.rs:5030
fn lower_checked_tir_program_on_stack(bundle: ProgramBundle, request: MirArtifactRequest, debug_linemap: Bool) -> TirProgram LowerError! {
    PackageEdition.with_package_edition(bundle.edition, || {
        module :: bundle.modules.get(bundle.entry) ?? fail LowerError.new(Span.new(0, 0), "missing entry module")
        extern_funcs :: bundle_extern_funcs(bundle)
        cx := build_cx_items(module.items, module.source, module.display, None, extern_funcs, bundle.edition)
        cx.debug_linemap = debug_linemap
        populate_cx_from_bundle(&cx, bundle, bundle.entry)
        register_own_struct_shapes(&cx, bundle, bundle.entry)
        collect_iterable_hooks(&cx, module.items)
        type_shapes :: collect_type_shapes(module.items)
        funcs := [TFunc]{}
        include_tests :: request.kind == MirArtifactKind.TestExecutable || request.kind == MirArtifactKind.FuzzExecutable || request.kind == MirArtifactKind.TestOverride
        entry_module_identity :: artifact_plan.module_identity(bundle, bundle.entry)
        boxed_edges_by_module := [String:HashSet[(String, String)]]{}
        &boxed_edges_by_module.insert(entry_module_identity, cx.boxed_edges)
        auto_printable_by_module := [String:HashSet[String]]{}
        &auto_printable_by_module.insert(entry_module_identity, cx.auto_printable)
        auto_debug_by_module := [String:HashSet[String]]{}
        &auto_debug_by_module.insert(entry_module_identity, cx.auto_debug)
        entry_name := None
        cli_schema := None
        if request.kind != MirArtifactKind.NativeLibrary && request.kind != MirArtifactKind.SandboxPlugin && request.kind != MirArtifactKind.TestExecutable && request.kind != MirArtifactKind.FuzzExecutable {
            zero_arg_entry :: selected_test_override_tir_entry(bundle, request).or_else(|| selected_zero_arg_tir_entry(bundle))
            if zero_arg_entry == None -> cli_schema = entry_schema_for_bundle(bundle)
            cli_run := None
            if cli_schema != None {
                loop item in module.items {
                    if item == {
                        .Func(function) -> if function.name == "run" -> cli_run = Val(function.name)
                        .Const(value) -> if value.resolved_output == Val(output) {
                            if output.selected && output.module == bundle.entry && output.params.len() == 1 -> cli_run = Val(output.semantic_name)
                        }
                        _ -> {}
                    }
                    if cli_run != None -> break
                }
            }
            if zero_arg_entry == Val(name) -> entry_name = Val(name)
            else if cli_run != None || cli_schema != None -> entry_name = Val(mangle_generated("cli_main"))
            else -> fail LowerError.new(Span.new(0, 0), NO_RUNNABLE_ENTRY)
        }
        core_source_modules :: core_source_module_indices(bundle)
        reachable_core_bodies := HashSet[(USize, USize, USize)]{}
        if !core_source_modules.is_empty() {
            app_graph :: extract_app_graph(bundle).0
            callables :: cost_callables(bundle, app_graph)
            reachable :: reachable_core_source_callables(bundle, callables, core_source_modules, include_tests, request, entry_name)
            reachable_core_bodies = reachable_core_source_bodies(callables, core_source_modules, reachable)
        }
        &cx.jit_spawn_lambdas.clear()
        &cx.jit_spawn_sites.clear()
        &cx.jit_method_calls.clear()
        &cx.jit_generic_calls.clear()
        &cx.jit_core_source_generic_calls.clear()
        &cx.jit_canonical_deopt.clear()
        &cx.jit_canonical_calls.clear()
        http_route_handlers := HashSet[String]{}
        collect_http_route_handlers(module.items, &http_route_handlers)
        contract_rows := artifact_plan.ContractSamplingPlan.new()
        uncovered_entry_reason := None
        loop item in module.items {
            if item == {
                .Func(f) -> {
                    if is_guest_import(f) -> next
                    covered :: f.inline_foreign == None && (tir_covers(f, cx) || http_route_handlers.contains(f.name))
                    if !covered && entry_name == Val(name) {
                        if name == f.name || name.ends_with("::{f.name}") -> uncovered_entry_reason = Val(refusal.describe(cx))
                    }
                    materialize_contract_sampling(f, entry_module_identity, covered, f.name, cx, &funcs, &contract_rows)
                    if f.inline_foreign != None || !f.type_params.is_empty() -> next
                    // Resident execution has no AST fallback; siblings must still lower.
                    &funcs.push(lower_func(f, cx))
                }
                .Test(test) -> if include_tests && test.name != None -> &funcs.push(lower_test_item(test, entry_module_identity, cx))
                .ErrorConv(ec) -> {
                    if !tir_covers_error_conv_body(ec.body, cx) -> next
                    &funcs.push(lower_error_conv(ec, cx))
                }
                .Struct(s) -> {
                    if s.type_params.is_empty() {
                        loop m in s.methods {
                            lowered := lower_method(m, s.name, cx)
                            lowered.name = "{s.name}::{m.name}"
                            &funcs.push(^lowered)
                        }
                        loop implementation in s.trait_impls {
                            if implementation.trait_name == ENCODE || implementation.trait_name == DECODE -> next
                            loop method in implementation.methods {
                                if !trait_method_binders_lower_in_place(method, s.name, cx, implementation.trait_name) -> next
                                lowered := lower_trait_method(method, s.name, cx, implementation.trait_name, implementation.compiler_generated && method.compiler_generated, implementation.operator_rhs)
                                set_lowered_method_name(&lowered, || "{s.name}::{method.name}")
                                &funcs.push(^lowered)
                            }
                        }
                    }
                }
                .Enum(e) -> {
                    if e.type_params.is_empty() {
                        loop method in e.methods {
                            lowered := lower_method(method, e.name, cx)
                            lowered.name = "{e.name}::{method.name}"
                            &funcs.push(^lowered)
                        }
                        loop implementation in e.trait_impls {
                            if implementation.trait_name == ENCODE || implementation.trait_name == DECODE -> next
                            loop method in implementation.methods {
                                if !trait_method_binders_lower_in_place(method, e.name, cx, implementation.trait_name) -> next
                                lowered := lower_trait_method(method, e.name, cx, implementation.trait_name, implementation.compiler_generated && method.compiler_generated, implementation.operator_rhs)
                                set_lowered_method_name(&lowered, || "{e.name}::{method.name}")
                                &funcs.push(^lowered)
                            }
                        }
                    }
                }
                .Impl(imp) -> {
                    owner_module :: impl_owner_module(bundle, bundle.entry, imp.type_name)
                    owner_params := []
                    loop owner_item in bundle.modules[owner_module].items {
                        if owner_item == {
                            .Struct(s) -> if s.name == imp.type_name -> owner_params = s.type_params
                            .Enum(e) -> if e.name == imp.type_name -> owner_params = e.type_params
                            _ -> {}
                        }
                    }
                    owners := [Type]{}
                    if imp.trait_name != None || owner_params.is_empty() -> &owners.push(Type.Named(imp.type_name))
                    loop owner_ty in owners {
                        subst := [String:Type]{}
                        if owner_ty == .Apply(_, args) {
                            loop (param, arg) in owner_params.zip(args) -> &subst.insert(param.name, arg)
                        }
                        loop method in imp.methods {
                            specialized :: if subst.is_empty() -> method else -> specialize_function_types(method, subst)
                            if !specialized.type_params.is_empty() -> next
                            lowered := if imp.trait_name == Val(trait_name) {
                                lower_trait_method(specialized, imp.type_name, cx, trait_name,
                                    (imp.is_generated_serde && specialized.compiler_generated) || (specialized.compiler_generated && specialized.state_transition != None && specialized.return_type != None && specialized.failure_contract().is_default()), imp.operator_rhs)
                            } else {
                                lower_method_for_owner(specialized, imp.type_name, owner_ty, cx, specialized.compiler_generated && specialized.state_transition != None && specialized.return_type != None && specialized.failure_contract().is_default())
                            }
                            set_lowered_method_name(&lowered, || "{owner_ty.name()}::{method.name}")
                            &funcs.push(^lowered)
                        }
                    }
                }
                .CodeModule(cm) -> {
                    body :: cm.body ?? next
                    member_prefix :: member_name(cm.name, "")
                    loop inner in body {
                        if inner == {
                            .Func(f) -> {
                                covered :: tir_covers(f, cx)
                                child :: child_module_identity(entry_module_identity, cm.name)
                                previous_prefix :: cx.jit_local_call_prefix
                                cx.jit_local_call_prefix = Val("{mangle(cm.name)}::")
                                materialize_contract_sampling(f, child, covered, f.name, cx, &funcs, &contract_rows)
                                cx.jit_local_call_prefix = previous_prefix
                                if f.inline_foreign != None || !f.type_params.is_empty() -> next
                                member :: member_name(cm.name, f.name)
                                mangled_f := f
                                mangled_f.name = member
                                lowered := lower_func(mangled_f, cx)
                                lowered.name = member
                                &funcs.push(^lowered)
                            }
                            .Test(test) -> if include_tests && test.name != None {
                                child :: child_module_identity(entry_module_identity, cm.name)
                                &funcs.push(lower_test_item(test, child, cx))
                            }
                            .Struct(s) -> {
                                type_name :: if s.name.starts_with(member_prefix) -> s.name else -> member_name(cm.name, s.name)
                                loop method in s.methods {
                                    lowered := lower_method(method, type_name, cx)
                                    set_lowered_method_name(&lowered, || "{type_name}::{method.name}")
                                    &funcs.push(^lowered)
                                }
                            }
                            .Impl(imp) -> {
                                type_name :: if imp.type_name.starts_with(member_prefix) -> imp.type_name else -> member_name(cm.name, imp.type_name)
                                loop method in imp.methods {
                                    lowered := if imp.trait_name == Val(trait_name) {
                                        if !imp.is_generated_serde && !trait_method_binders_lower_in_place(method, type_name, cx, trait_name) -> next
                                        lower_trait_method(method, type_name, cx, trait_name, imp.is_generated_serde && method.compiler_generated, imp.operator_rhs)
                                    } else -> lower_method(method, type_name, cx)
                                    set_lowered_method_name(&lowered, || "{type_name}::{method.name}")
                                    &funcs.push(^lowered)
                                }
                            }
                            _ -> {}
                        }
                    }
                }
                _ -> {}
            }
        }
        lower_demanded_generic_methods(module.items, cx, &funcs)!
        specialize_generic_free_functions(module.items, cx, &funcs)
        spawn_lambdas := std.mem.take(&cx.jit_spawn_lambdas)
        reflect_paths := cx.reflect_paths
        memo_dependencies := memo_dependency_facts(cx)
        loop (module_idx, imported) in bundle.modules.enumerate() {
            if module_idx == bundle.entry -> next
            imported_owner :: bundle.name_ledger.module_identity(module_idx) ?? panic("name ledger must contain every loaded module")
            imported_cx := build_cx_items(imported.items, imported.source, imported.display, None, extern_funcs, bundle.edition)
            imported_cx.debug_linemap = debug_linemap
            populate_cx_from_bundle(&imported_cx, bundle, module_idx)
            &boxed_edges_by_module.insert(imported_owner, imported_cx.boxed_edges)
            &auto_printable_by_module.insert(imported_owner, imported_cx.auto_printable)
            &auto_debug_by_module.insert(imported_owner, imported_cx.auto_debug)
            // Own canonical shapes are needed as well as consumer import shapes (#2252).
            register_own_struct_shapes(&imported_cx, bundle, module_idx)
            collect_iterable_hooks(&imported_cx, imported.items)
            imported_cx.jit_local_call_prefix = Val("{mangle(imported.alias)}::")
            lower_imported_generated_codecs(bundle, module_idx, core_source_modules, reachable_core_bodies, imported_cx, &funcs)
            loop (owner, sources) in memo_dependency_facts(imported_cx) {
                target := memo_dependencies.get(owner) ?? [:]
                loop (source, fields) in sources {
                    if !target.contains_key(source) -> &target.insert(source, fields)
                }
                &memo_dependencies.insert(owner, ^target)
            }
            loop (name, path) in imported_cx.reflect_paths {
                if !reflect_paths.contains_key(name) -> &reflect_paths.insert(name, path)
            }
            imported_cx.jit_spawn_site_base = spawn_lambdas.len()
            loop item in imported.items {
                if item == {
                    .Func(function) -> {
                        covered :: function.type_params.is_empty() && tir_covers(function, imported_cx)
                        imported_cx.jit_local_call_prefix = Val("{mangle(imported.alias)}::")
                        if function.inline_foreign == None && function.type_params.is_empty() && !should_lower_imported_core_body(core_source_modules, reachable_core_bodies, module_idx, function) -> next
                        if function.inline_foreign == None && function.type_params.is_empty() {
                            lowered := lower_func(function, imported_cx)
                            binders :: qualification_binders([], Val(function))
                            loop param in &lowered.params -> param.ty = qualify_imported_type(bundle, module_idx, imported_owner, binders, param.ty)
                            lowered.ret = lowered.ret.map(|ty| qualify_imported_type(bundle, module_idx, imported_owner, binders, ty))
                            lowered.name = "{mangle(imported.alias)}::{mangle(function.name)}"
                            &funcs.push(^lowered)
                        }
                        materialize_contract_sampling(function, imported_owner, covered, function.name, imported_cx, &funcs, &contract_rows)
                    }
                    .Test(test) -> if include_tests && test.name != None {
                        imported_cx.jit_local_call_prefix = Val("{mangle(imported.alias)}::")
                        &funcs.push(lower_test_item(test, imported_owner, imported_cx))
                    }
                    .CodeModule(code_module) -> {
                        body :: code_module.body ?? next
                        loop inner in body {
                            if inner == .Test(test) {
                                if include_tests && test.name != None {
                                    child :: child_module_identity(imported_owner, code_module.name)
                                    &funcs.push(lower_test_item(test, child, imported_cx))
                                }
                                next
                            }
                            function :: if inner == .Func(f) -> f else -> next
                            covered :: function.type_params.is_empty() && tir_covers(function, imported_cx)
                            child :: child_module_identity(imported_owner, code_module.name)
                            imported_cx.jit_local_call_prefix = Val("{mangle(code_module.name)}::")
                            materialize_contract_sampling(function, child, covered, function.name, imported_cx, &funcs, &contract_rows)
                            if !function.type_params.is_empty() -> next
                            if !should_lower_imported_core_body(core_source_modules, reachable_core_bodies, module_idx, function) -> next
                            mangled_function := function
                            mangled_function.name = member_name(code_module.name, function.name)
                            lowered := lower_func(mangled_function, imported_cx)
                            binders :: qualification_binders([], Val(function))
                            loop param in &lowered.params -> param.ty = qualify_imported_type(bundle, module_idx, imported_owner, binders, param.ty)
                            lowered.ret = lowered.ret.map(|ty| qualify_imported_type(bundle, module_idx, imported_owner, binders, ty))
                            lowered.name = "{mangle(code_module.name)}::{mangle(function.name)}"
                            &funcs.push(^lowered)
                        }
                    }
                    .Struct(_) | .Enum(_) -> {
                        (name, type_params, methods, trait_impls) :: if item == {
                            .Struct(d) -> (d.name, d.type_params, d.methods, d.trait_impls)
                            .Enum(d) -> (d.name, d.type_params, d.methods, d.trait_impls)
                            _ -> panic("nominal item gate")
                        }
                        if !type_params.is_empty() -> next
                        imported_cx.jit_local_call_prefix = Val("{mangle(imported.alias)}::")
                        loop owner in imported_type_owners(bundle, module_idx) {
                            qualified :: imported_type_name(owner, name)
                            loop method in methods {
                                if !should_lower_imported_core_body(core_source_modules, reachable_core_bodies, module_idx, method) -> next
                                lowered := lower_method_for_owner(method, qualified, Type.Named(qualified), imported_cx, false)
                                binders :: qualification_binders(type_params, Val(method))
                                lowered.ret = lowered.ret.map(|ty| qualify_imported_type(bundle, module_idx, owner, binders, ty))
                                set_lowered_method_name(&lowered, || "{qualified}::{method.name}")
                                &funcs.push(^lowered)
                            }
                            loop implementation in trait_impls {
                                if implementation.trait_name == ENCODE || implementation.trait_name == DECODE -> next
                                loop method in implementation.methods {
                                    if !should_lower_imported_core_body(core_source_modules, reachable_core_bodies, module_idx, method) -> next
                                    if !trait_method_binders_lower_in_place(method, qualified, imported_cx, implementation.trait_name) -> next
                                    lowered := lower_trait_method(method, qualified, imported_cx, implementation.trait_name, implementation.compiler_generated && method.compiler_generated, implementation.operator_rhs)
                                    binders :: qualification_binders(type_params, Val(method))
                                    lowered.ret = lowered.ret.map(|ty| qualify_imported_type(bundle, module_idx, owner, binders, ty))
                                    set_lowered_method_name(&lowered, || "{qualified}::{method.name}")
                                    &funcs.push(^lowered)
                                }
                            }
                        }
                    }
                    .Impl(implementation) -> {
                        if implementation.trait_name == None {
                            owner_module :: impl_owner_module(bundle, module_idx, implementation.type_name)
                            owner_is_generic := false
                            loop owner_item in bundle.modules[owner_module].items {
                                if owner_item == {
                                    .Struct(d) -> if d.name == implementation.type_name && !d.type_params.is_empty() -> owner_is_generic = true
                                    .Enum(d) -> if d.name == implementation.type_name && !d.type_params.is_empty() -> owner_is_generic = true
                                    _ -> {}
                                }
                            }
                            if owner_is_generic || implementation.is_generated_serde -> next
                            imported_cx.jit_local_call_prefix = Val("{mangle(imported.alias)}::")
                            loop owner in imported_type_owners(bundle, owner_module) {
                                qualified :: imported_type_name(owner, implementation.type_name)
                                loop method in implementation.methods {
                                    if !should_lower_imported_core_body(core_source_modules, reachable_core_bodies, module_idx, method) -> next
                                    if !method.type_params.is_empty() -> next
                                    name :: "{qualified}::{method.name}"
                                    if funcs.any(|function| function.name == name) -> next
                                    lowered := lower_method_for_owner(method, qualified, Type.Named(qualified), imported_cx, false)
                                    binders :: qualification_binders([], Val(method))
                                    lowered.ret = lowered.ret.map(|ty| qualify_imported_type(bundle, module_idx, owner, binders, ty))
                                    lowered.name = name
                                    &funcs.push(^lowered)
                                }
                            }
                        } else if implementation.trait_name == Val(TRAIT_DISPLAY) && imported_cx.unit_labels.contains_key(implementation.type_name) {
                            loop method in implementation.methods {
                                if !should_lower_imported_core_body(core_source_modules, reachable_core_bodies, module_idx, method) -> next
                                if !trait_method_binders_lower_in_place(method, implementation.type_name, imported_cx, TRAIT_DISPLAY) -> next
                                lowered := lower_trait_method(method, implementation.type_name, imported_cx, TRAIT_DISPLAY, false, implementation.operator_rhs)
                                set_lowered_method_name(&lowered, || "{imported_owner}::{implementation.type_name}::{method.name}")
                                &funcs.push(^lowered)
                            }
                        } else {
                            // Imported impl blocks are ordinary items; generated codec provenance has its own pass.
                            if implementation.is_generated_serde -> next
                            owner_module :: impl_owner_module(bundle, module_idx, implementation.type_name)
                            owner_params := []
                            loop owner_item in bundle.modules[owner_module].items {
                                if owner_item == {
                                    .Struct(d) -> if d.name == implementation.type_name -> owner_params = d.type_params
                                    .Enum(d) -> if d.name == implementation.type_name -> owner_params = d.type_params
                                    _ -> {}
                                }
                            }
                            if !owner_params.is_empty() -> next
                            imported_cx.jit_local_call_prefix = Val("{mangle(imported.alias)}::")
                            loop owner in imported_type_owners(bundle, owner_module) {
                                qualified :: imported_type_name(owner, implementation.type_name)
                                loop method in implementation.methods {
                                    if !should_lower_imported_core_body(core_source_modules, reachable_core_bodies, module_idx, method) -> next
                                    if !method.type_params.is_empty() -> next
                                    lowered := if implementation.trait_name == Val(trait_name) {
                                        lower_trait_method(method, qualified, imported_cx, trait_name, false, implementation.operator_rhs)
                                    } else -> lower_method_for_owner(method, qualified, Type.Named(qualified), imported_cx, false)
                                    binders :: qualification_binders(owner_params, Val(method))
                                    lowered.ret = lowered.ret.map(|ty| qualify_imported_type(bundle, module_idx, owner, binders, ty))
                                    set_lowered_method_name(&lowered, || "{qualified}::{method.name}")
                                    &funcs.push(^lowered)
                                }
                            }
                        }
                    }
                    _ -> {}
                }
            }
            &spawn_lambdas.extend(std.mem.take(&imported_cx.jit_spawn_lambdas))
            merge_core_source_generic_calls(cx, imported_cx)
        }
        specialize_checked_core_source_generics(bundle, extern_funcs, debug_linemap, cx, &funcs, &spawn_lambdas)!
        apply_checked_web_partitions(bundle, &funcs)
        if entry_name == Val(name) {
            entry_ok :: if name == mangle_generated("cli_main") {
                cli_schema != None || funcs.any(|function| function.name == "run" && function.kind == .TopLevel)
            } else -> funcs.any(|function| function.key == name && function.kind == .TopLevel)
            if !entry_ok {
                reason :: if name == mangle_generated("cli_main") -> CLI_ENTRY_MISSING_RUN
                    else if uncovered_entry_reason == Val(detail) -> "selected entry is not a top-level function ({detail})"
                    else -> "selected entry is not a top-level function"
                fail LowerError.new(Span.new(0, 0), reason)
            }
        }
        struct_fields := [String:[String]]{}
        struct_field_types := [String:[Type]]{}
        reflection_fields := [:]
        struct_type_params := [String:[String]]{}
        enum_variants := [String:[String]]{}
        enum_variant_payload_types := [String:[Type]]{}
        ordering_variants :: compiler_owned_enum_variants(TYPE_ORDERING) ?? panic("Ordering is a compiler-owned enum")
        &enum_variants.insert(TYPE_ORDERING, ordering_variants.map(|variant| mangle(variant)))
        &enum_variants.insert(TYPE_TASK_FAILURE, ["Cancelled", "DeadlineBlown", "Panicked"])
        &enum_variant_payload_types.insert("{TYPE_TASK_FAILURE}::Panicked", [Type.String])
        &enum_variants.insert("TaskOutcome", ["Finished", "Panicked", "Cancelled", "DeadlineBlown"])
        &enum_variant_payload_types.insert("TaskOutcome::Panicked", [Type.String])
        &enum_variants.insert("TaskStatus", ["Running", "Paused", "CancelRequested"])
        &enum_variants.insert("WatchDomain", ["File", "Process", "Port"])
        &enum_variants.insert("WatchKind", ["Created", "Modified", "Removed", "Error", "Exited", "Ready"])
        int_constants := [String:Int]{}
        constants := [:]
        persist_prep :: prepare_bundle(bundle)
        persist_overrides :: persist_prep.by_name
        loop item in module.items {
            if item == {
                .Struct(s) -> {
                    &struct_type_params.insert(s.name, s.type_params.map(|param| param.name))
                    fields := s.reflection_fields().map(|f| mangle(f.name))
                    add_published_schema_field(s, &fields)
                    &struct_fields.insert(s.name, ^fields)
                    types := s.reflection_fields().map(|f| f.ty)
                    add_published_schema_field_type(s, &types)
                    &struct_field_types.insert(s.name, ^types)
                    &reflection_fields.insert(s.name, Reflection.fields(s))
                    loop field in s.fields -> register_union_type(field.ty, &enum_variants, &enum_variant_payload_types)
                }
                .Enum(e) -> if e.type_params.is_empty() -> register_enum_variants(e.name, e.variants, &enum_variants, &enum_variant_payload_types)
                .Func(function) -> {
                    loop param in function.params -> register_union_type(param.ty, &enum_variants, &enum_variant_payload_types)
                    if function.return_type == Val(ret) -> register_union_type(ret, &enum_variants, &enum_variant_payload_types)
                }
                .Const(c) -> {
                    persisted :: if c.is_persist -> persist_overrides.get(c.name) else -> None
                    if persisted.or_else(|| source_constant_value(c)) == Val(value) {
                        if value == .Int(integer) -> &int_constants.insert(c.name, integer)
                        &constants.insert(c.name, value)
                    }
                }
                .CodeModule(cm) -> if cm.body == Val(body) {
                    member_prefix :: member_name(cm.name, "")
                    loop inner in body {
                        if inner == {
                            .Struct(s) -> if s.type_params.is_empty() {
                                name :: if s.name.starts_with(member_prefix) -> s.name else -> member_name(cm.name, s.name)
                                fields := s.reflection_fields().map(|f| mangle(f.name))
                                add_published_schema_field(s, &fields)
                                &struct_fields.insert(name, ^fields)
                                types := s.reflection_fields().map(|f| f.ty)
                                add_published_schema_field_type(s, &types)
                                &struct_field_types.insert(name, ^types)
                                &reflection_fields.insert(name, Reflection.fields(s))
                            }
                            .Enum(e) -> if e.type_params.is_empty() {
                                name :: if e.name.starts_with(member_prefix) -> e.name else -> member_name(cm.name, e.name)
                                register_enum_variants(name, e.variants, &enum_variants, &enum_variant_payload_types)
                            }
                            .Const(c) -> {
                                name :: member_name(cm.name, c.name)
                                if source_constant_value(c) == Val(value) {
                                    if value == .Int(integer) -> &int_constants.insert(name, integer)
                                    &constants.insert(name, value)
                                }
                            }
                            _ -> {}
                        }
                    }
                }
                _ -> {}
            }
        }
        loop (module_idx, imported) in bundle.modules.enumerate() {
            if module_idx == bundle.entry -> next
            loop item in imported.items {
                if item == {
                    .Struct(s) -> {
                        binders :: qualification_binders(s.type_params, None)
                        loop owner in imported_type_owners(bundle, module_idx) {
                            name :: imported_type_name(owner, s.name)
                            &struct_type_params.insert(name, s.type_params.map(|param| param.name))
                            fields := s.reflection_fields().map(|field| mangle(field.name))
                            add_published_schema_field(s, &fields)
                            &struct_fields.insert(name, ^fields)
                            types := s.reflection_fields().map(|field| qualify_imported_type(bundle, module_idx, owner, binders, field.ty))
                            add_published_schema_field_type(s, &types)
                            &struct_field_types.insert(name, ^types)
                            reflected := Reflection.fields(s)
                            loop field in &reflected -> field.ty = qualify_imported_type(bundle, module_idx, owner, binders, field.ty)
                            &reflection_fields.insert(name, ^reflected)
                        }
                        loop field in s.fields -> register_union_type(field.ty, &enum_variants, &enum_variant_payload_types)
                    }
                    .Enum(e) -> if e.type_params.is_empty() {
                        binders :: qualification_binders(e.type_params, None)
                        loop owner in imported_type_owners(bundle, module_idx) -> register_imported_enum_variants(bundle, module_idx, owner, binders, e.name, e.variants, &enum_variants, &enum_variant_payload_types)
                    }
                    .CodeModule(code_module) -> {
                        body :: code_module.body ?? next
                        loop inner in body {
                            if inner == {
                                .Struct(s) -> if s.type_params.is_empty() {
                                    &struct_fields.insert(s.name, s.reflection_fields().map(|field| mangle(field.name)))
                                    &struct_field_types.insert(s.name, s.reflection_fields().map(|field| field.ty))
                                    &reflection_fields.insert(s.name, Reflection.fields(s))
                                    loop field in s.fields -> register_union_type(field.ty, &enum_variants, &enum_variant_payload_types)
                                }
                                .Enum(e) -> if e.type_params.is_empty() -> register_enum_variants(e.name, e.variants, &enum_variants, &enum_variant_payload_types)
                                _ -> {}
                            }
                        }
                    }
                    _ -> {}
                }
            }
        }
        loop (_, fields) in type_shapes.tuples {
            tuple_ty :: Type.Tuple(fields.map(|(name, ty)| (name, ty)))
            &struct_fields.insert(tuple_ty.name(), fields.map(|(name, _)| mangle(name)))
            &struct_field_types.insert(tuple_ty.name(), fields.map(|(_, ty)| ty))
        }
        distinct_bases := [String:Type]{}
        loop (name, (base, _)) in cx.distinct_types -> &distinct_bases.insert(name, base)
        iterable_item_types := [(String, String):Type]{}
        loop (collection, hook) in cx.iterable_hooks -> &iterable_item_types.insert((collection, hook.iter_type), hook.item_type)
        codec_migrations :: compile_codec_migrations(cx, entry_module_identity, module.items) ?? fail LowerError.new(Span.new(0, 0), "checked schema migration is missing its default or conversion function")
        canonical_deopt :: cx.jit_canonical_deopt
        canonical_calls :: cx.jit_canonical_calls
        declarations :: lower_tir_declarations(bundle, boxed_edges_by_module, auto_printable_by_module, auto_debug_by_module)
        hardware_use :: target_hardware_use(bundle)
        hardware_profile :: target_hardware_profile(bundle)
        hardware_profile_id :: target_hardware_profile_id(bundle) ?? ""
        hardware_capabilities :: target_hardware_capabilities(bundle)
        hardware_setups :: target_hardware_setups(bundle, hardware_use, hardware_profile, hardware_profile_id)
        used_core := HashSet[String].from(bundle.used_core)
        if hardware_profile != None -> &used_core.insert("core.hardware")
        // BTreeSet reference order is retained in the package projection.
        sorted_used_core := used_core.to_array()
        &sorted_used_core.sort()
        artifact_facts :: lower_tir_artifact_facts_for_request(bundle, request, contract_rows)
        unreachable := []
        loop (index, source) in bundle.modules.enumerate() -> collect_item_erasures(source.items, artifact_plan.module_identity(bundle, index), include_tests, &unreachable)
        entry_sibling_calls :: if !bundle.name_ledger.namespace_siblings(bundle.entry).is_empty() -> Val((entry_module_identity, "{mangle(bundle.modules[bundle.entry].alias)}::")) else -> None
        core_calls := CORE_CALLS.to_array()
        &core_calls.extend(tir_core_call_records())
        program := TirProgram{
            package_identity: bundle.build_facts.package_name,
            entry_sibling_calls: entry_sibling_calls,
            facts: TirPackageFacts{
                project_root: bundle.project_root.display().to_string(),
                used_core: sorted_used_core,
                ffi_callback_functions: bundle.ffi_callback_fns.to_array(),
                active_os: "{bundle.active_os:?}",
                inferred_layer: "{bundle.inferred_layer:?}",
                allocator: "{bundle.program_allocator:?}",
                web_app: extract_app_graph(bundle).0,
                authority_needs: bundle.package_guarantees.authority_needs,
                hardware_use: hardware_use,
                hardware_profile: hardware_profile,
                hardware_profile_id: hardware_profile_id,
                hardware_capabilities: hardware_capabilities,
                hardware_setups: hardware_setups,
            },
            source_file: module.display,
            source_text: module.source,
            source_files: bundle.modules.map(|source| (source.display, source.source)),
            package_hardened: bundle.package_guarantees.harden,
            application_authority: bundle.package_guarantees.application_authority,
            edition: bundle.edition,
            funcs: funcs,
            declarations: declarations,
            artifact_facts: artifact_facts,
            core_calls: core_calls,
            unreachable: unreachable,
            spawn_lambdas: spawn_lambdas,
            struct_fields: struct_fields,
            struct_field_types: struct_field_types,
            memo_dependencies: memo_dependencies,
            reflection_fields: reflection_fields,
            reflect_paths: reflect_paths,
            nominal_identities: nominal_identity_projection(bundle),
            struct_type_params: struct_type_params,
            enum_variants: enum_variants,
            enum_variant_payload_types: enum_variant_payload_types,
            canonical_deopt: canonical_deopt,
            canonical_calls: canonical_calls,
            int_constants: int_constants,
            constants: constants,
            distinct_bases: distinct_bases,
            distinct_ranges: cx.distinct_ranges,
            codec_migrations: codec_migrations,
            trait_method_traits: cx.trait_method_traits,
            iterable_item_types: iterable_item_types,
        }
        CanonicalPass.record("lowering", "tir.lower-checked-program", "crates/jet-codegen/src/Codegen/TIR/mod.rs", "ast", CanonicalPass.ast_payload(bundle), CanonicalPass.ast_identity(bundle), "tir", canonical_payload(program), canonical_identity(program), "preserve")
        tir_before_optimization :: canonical_payload(program)
        tir_before_identity :: canonical_identity(program)
        opt.optimize_program(&program)
        CanonicalPass.record("lowering", "tir.optimize-program", "crates/jet-codegen/src/Codegen/TIR/opt.rs", "tir", tir_before_optimization, tir_before_identity, "tir", canonical_payload(program), canonical_identity(program), "preserve")
        program
    })!
}

