impl TFunc {
    pub fn fact_channel(self) -> TFactChannel Never! {
        TFactChannel{
            ty: self.ret,
            integer_bounds: self.ret.and_then(integer_bounds_for_type),
            exclusivity: TFactExclusivity.Unknown,
            purity: if self.is_pure -> TFactPurity.Pure else -> TFactPurity.Unknown,
            no_cross_iteration_deps: false,
            comptime_value: None,
            cost: None,
        }
    }
}
