impl TFuncKind {
    // The receiver precedes declared MIR parameters and is absent on static functions.
    pub fn receiver(self) -> (Type, AccessConvention)? Never! {
        if self == {
            .TopLevel -> None
            .Method(self_convention, owner_type) -> self_convention.map(|access| (owner_type, access))
            .TraitMethod(_, self_convention, owner_type, _, _) -> self_convention.map(|access| (owner_type, access))
        }
    }
}
