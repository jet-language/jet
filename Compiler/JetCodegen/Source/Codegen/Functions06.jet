//RS /// Explicit lowering messages for a checked bundle with no runnable entry.
//RS pub const NO_RUNNABLE_ENTRY: &str = "no runnable entry";
//RS pub const CLI_ENTRY_MISSING_RUN: &str = "cli entry missing `run`";
//RS 
//RS // ---------------------------------------------------------------------------
//RS // TIR types. Every node carries the facts codegen needs, pre-resolved (totality).
//RS // ---------------------------------------------------------------------------
//RS 
//RS /// Runtime sentry metadata for one source-level `#Unsafe` gate. The metadata
//RS /// is data in TIR; each engine only marshals it into the shared Prelude sentry.
//RS #[derive(Clone, Debug)]
//RS pub struct TUnsafeGate {
//RS     pub file: String,
//RS     pub line: u32,
//RS     pub reason: String,
//RS     pub enabled: bool,
//RS     /// D-MEM-GUARANTEE1: this gate belongs to a contained dependency and
//RS     /// must activate the same Prelude witness even in release.
//RS     pub fenced: bool,
//RS }
//RS 
//RS /// One source-level generic parameter and its checked bounds.
//RS #[derive(Clone, Debug, PartialEq, Eq)]
//RS pub struct TGenericParam {
//RS     pub name: String,
//RS     pub bounds: Vec<String>,
//RS }
//RS 
//RS /// A lowered top-level function. Parameter and generic names remain Jet
//RS /// identities; each adapter owns target-specific spelling.
//RS #[derive(Clone)]
//RS pub struct TFunc {
//RS     /// Jet function name (unmangled).
//RS     pub name: String,
//RS     /// Canonical module identity for this checked body.
//RS     pub module: String,
//RS     /// Deterministic semantic key for this function, independent of allocation order.
//RS     pub key: String,
//RS     /// Source file identity owned by this function row.
//RS     pub source_file: String,
//RS     /// Source range for function-level evaluator diagnostics.
//RS     pub source_span: crate::Diagnostics::Span,
//RS     /// Sema-selected failure carrier; adapters must not infer it from `ret`.
//RS     pub failure_carrier: TFailureCarrier,
//RS     /// Direct/solved/call-edge effect facts and their source spans.
//RS     pub effects: TEffectFacts,
//RS     /// Target applicability fixed by the checked bundle.
//RS     pub target_applicability: TTargetApplicability,
//RS     /// Checked web partition facts.
//RS     pub web_bucket: Option<crate::WebPartition::WebBucket>,
//RS     pub web_marker: Option<crate::WebPartition::WebPartitionMarker>,
//RS     /// Checked visibility and foreign ownership provenance.
//RS     pub visibility: TVisibility,
//RS     pub foreign: Option<TForeignProvenance>,
//RS     /// `(Jet parameter name, resolved Jet type, convention)` per parameter.
//RS     pub params: Vec<(String, Type, AccessConvention)>,
//RS     /// Web-export boundary facts.
//RS     pub web_param_reconstructions: Vec<TWebParamReconstruction>,
//RS     /// Resolved return type, or `None` for a unit-returning function.
//RS     pub ret: Option<Type>,
//RS     /// Sema-proven hidden automatic-root return representation.
//RS     pub gc_return: bool,
//RS     /// Sema-selected tracing scope, including scopes with no promotions.
//RS     pub gc_scope: bool,
//RS     pub return_view_provenance: Option<crate::AST::ViewProvenanceMap>,
//RS     /// Checked generic parameters; no rendered target-language clause.
//RS     pub generic_params: Vec<TGenericParam>,
//RS     /// Types of operands materialized with `.clone()` while lowering this body.
//RS     /// Generic inherent impl emission unions these facts to derive minimal bounds.
//RS     pub clone_types: Vec<Type>,
//RS     pub is_main: bool,
//RS     /// D-COV1: the 1-based Jet source line of this function's name, for the
//RS     /// `jet_cov(line)` coverage probe. Only read in coverage mode.
//RS     pub line: usize,
//RS     /// Compiler-synthesized function (auto-derive/serde builders). The stack
//RS     /// frame keeps its file/line/name attribution, but never embeds the raw
//RS     /// source line — that line is a declaration the user wrote for something
//RS     /// else (e.g. a `#UnitFamily(...)` marker), not this function.
//RS     pub synthetic: bool,
//RS     /// c109 Phase 18: an `#Unsafe fn` (S58, E2-M13/D-LL1) lowers to a Rust `unsafe fn`
//RS     /// (the `unsafe ` keyword prefixes the signature), so the body may use gated pointer
//RS     /// ops directly — calling it is already gated to an `#Unsafe` block in sema (E3103).
//RS     /// I1: this is true ONLY when the source function was `#Unsafe fn`; no `unsafe` is
//RS     /// ever emitted without that source gate. Applies to `TopLevel`/`Method`; a trait
//RS     /// method carries its own `is_unsafe` on `TFuncKind::TraitMethod`.
//RS     pub is_unsafe: bool,
//RS     /// Function-level `#Unsafe("reason") fn` sentry scope, if present.
//RS     pub unsafe_gate: Option<TUnsafeGate>,
//RS     /// D-CABI-CALLBACK1: named pure, monomorphic top-level functions expose a
//RS     /// stable C-convention symbol; sema alone decides whether it may cross C.
//RS     pub is_pure: bool,
//RS     /// D-MEMO1=A: sema-proved result-cache configuration. TIR carries the
//RS     /// bound; emitters and evaluators only marshal it into the shared Prelude.
//RS     pub memo_bound: Option<Option<usize>>,
//RS     /// D-REACTCORE1: `#Reactive fn` — the body is emitted inside `jet_reactive_effect`.
//RS     pub is_reactive: bool,
//RS     /// D-DATARACE1=C: upgrade-report lines for reactive boxes that crossed a boundary.
//RS     pub reactive_upgrades: Vec<String>,
//RS     /// D-METHODMACRO1=A: `#Inline fn` — emits `#[inline]`. Soft hint; sema never
//RS     /// rejects it.
//RS     pub is_inline: bool,
//RS     /// D-METHODMACRO1=A: `#Inline(Always) fn` — emits `#[inline(always)]`. Only ever
//RS     /// `true` here once sema has confirmed the function can actually inline
//RS     /// (E0917/E0918/E0919 would have failed the build otherwise) — I3: sema
//RS     /// decides, codegen just emits.
//RS     pub is_inline_always: bool,
//RS     /// D-SIMD3=B: `#Scalar` is the explicit native auto-vectorization opt-out.
//RS     /// It is a codegen boundary hint; semantics remain in the shared Prelude.
//RS     pub is_scalar: bool,
//RS     /// D-COMPUTE-KERNEL-SURFACE1=B: sema's complete safe-kernel proof. The
//RS     /// emitter and interpreter carry this fact without re-deriving it.
//RS     pub kernel_proof: Option<crate::AST::KernelProof>,
//RS     /// D-FIELDMEMO1=A: the synthetic getter stores its result in this hidden
//RS     /// owner field. `None` keeps ordinary functions and methods unchanged.
//RS     pub memo_field: Option<String>,
//RS     /// D-HARDENED1 / D-MEM-SENTRY1: lowering proved that this body mints an
//RS     /// address from current-frame storage. Engines install one shared Prelude
//RS     /// frame token before executing such a body.
//RS     pub uses_stack_sentry: bool,
//RS     pub body: Vec<TStmt>,
//RS     /// c109 Phase 7: how this function is emitted. A top-level function gets
//RS     /// `pub fn name(…)` at module scope; a method gets `pub fn __jet_name(<self>, …)`
//RS     /// inside an `impl` block (indented), with the `self` receiver form per the
//RS     /// resolved convention (or no receiver for a static method).
//RS     pub kind: TFuncKind,
//RS }
//RS 
//RS impl TFunc {
//RS     /// Return function-level facts without copying a side bundle.
//RS     ///
//RS     /// `is_pure` is a sema proof, not an inference from the body. A false bit
//RS     /// therefore remains `Unknown`, so an optimizer cannot treat an ordinary
//RS     /// function as impure merely because no purity proof was attached.
//RS     pub fn fact_channel(&self) -> TFactChannel<'_> {
//RS         TFactChannel {
//RS             ty: self.ret.as_ref(),
//RS             integer_bounds: self.ret.as_ref().and_then(integer_bounds_for_type),
//RS             exclusivity: TExclusivity::Unknown,
//RS             purity: if self.is_pure {
//RS                 TPurity::Pure
//RS             } else {
//RS                 TPurity::Unknown
//RS             },
//RS             no_cross_iteration_deps: false,
//RS             comptime_value: None,
//RS             cost: None,
//RS         }
//RS     }
//RS }
//RS 
//RS /// One lowered `#Pre`/`#Post` clause. `condition` and `message` share the
//RS /// function's parameter bindings; postconditions bind `result` to the typed
//RS /// sema-visible value selected by the enclosing `ContractScope`.
//RS #[derive(Clone, Copy, PartialEq, Eq)]
//RS pub enum TContractKind {
//RS     Pre,
//RS     Post,
//RS }
//RS 
//RS /// Why a contract node remains or disappears from executable TIR.
//RS ///
//RS /// `Stripped` is reserved for the ratified per-module build policy.  It is
//RS /// deliberately distinct from `Proven`: an explicit policy choice is not a
//RS /// proof fact and must remain auditable in TIR.
//RS #[derive(Clone, Copy, PartialEq, Eq)]
//RS pub enum TContractDisposition {
//RS     Check,
//RS     Proven,
//RS     Stripped,
//RS }
//RS 
//RS #[derive(Clone)]
//RS pub struct TContract {
//RS     pub kind: TContractKind,
//RS     pub condition: TExpr,
//RS     pub message: TExpr,
//RS     pub file: String,
//RS     pub line: u32,
//RS     pub span: crate::Diagnostics::Span,
//RS     pub disposition: TContractDisposition,
//RS }
//RS 
//RS /// One typed parameter reconstructed by a flattened WebAssembly export wrapper.
//RS #[derive(Clone)]
//RS pub struct TWebParamReconstruction {
//RS     /// Param slot the reconstructed value binds into (matches `TFunc.params`).
//RS     pub local: TLocal,
//RS     /// Struct type being rebuilt from flattened ABI scalars; emit spells Rust.
//RS     pub ty: Type,
//RS     /// `(mangled field, flattened ABI parameter, resolved scalar type)`.
//RS     pub fields: Vec<(String, String, Type)>,
//RS }
//RS 
//RS /// D-SERDE2 (card #131 S1-bridge): which built-in codec trait a hand impl method
//RS /// bridges to. `Encode` → `jet_encode(&self) -> jet_std::DataTree`; `Decode` →
//RS /// the static `jet_decode(tree: &jet_std::DataTree) -> Result<Self, Vec<FieldError>>`.
//RS #[derive(Clone, Copy, PartialEq, Eq)]
//RS pub enum SerdeCodec {
//RS     Encode,
//RS     Decode,
//RS }
//RS 
//RS /// c109 Phase 7: the emission shape of a lowered function.
//RS #[derive(Clone)]
//RS pub enum TFuncKind {
//RS     /// A module-level free function — `pub fn name(params) { … }`.
//RS     TopLevel,
//RS     /// An inherent method inside `impl __jet_<T> { … }`. `self_conv` is the receiver
//RS     /// convention for an instance method (`Read`→`&self`, `Mutate`→`&mut self`,
//RS     /// `Move`→`self`), or `None` for a STATIC (associated) method (no `self`
//RS     /// parameter). The method name is mangled (`__jet_<name>`) and emitted with `pub`.
//RS     Method {
//RS         self_conv: Option<AccessConvention>,
//RS         owner_type: Type,
//RS     },
//RS     /// c109 Phase 12: a trait-impl method inside `impl Trait for __jet_<T> { … }` (the
//RS     /// caller `emit_trait_impl`/`emit_external_trait_impl` opened the block). Distinct
//RS     /// from an inherent `Method`: the method name is BARE (the trait owns it — no
//RS     /// `__jet_` mangle) and there is NO `pub`. `self_conv` is the receiver convention
//RS     /// (`Read`→`&self`, `Mutate`→`&mut self`, `Move`→`self`), or `None` for a static
//RS     /// trait method. D-MUTSELF1: a `mut self` trait method gets `&mut self` and may
//RS     /// mutate the receiver in place. `is_unsafe` reproduces the `unsafe fn` prefix
//RS     /// for an `#Unsafe fn` trait method (S58/D-LL1 — the body may use gated ops;
//RS     /// calling it is already gated to an `#Unsafe` block).
//RS     TraitMethod {
//RS         is_unsafe: bool,
//RS         self_conv: Option<AccessConvention>,
//RS         /// Neutral checked owner identity; MIR lowering must not recover it
//RS         /// from the legacy emitted signature.
//RS         owner_type: Type,
//RS         /// Neutral checked trait identity; MIR lowering must not recover it
//RS         /// from the legacy emitted signature.
//RS         trait_name: String,
//RS         /// D-SERDE2 (card #131 S1-bridge): a hand-written `impl T.Encode` /
//RS         /// `impl T.Decode` method. The user writes the verbs `encode`/`decode`
//RS         /// with Jet-facing signatures, but the Rust `__jet_Encode`/`__jet_Decode`
//RS         /// traits declare `jet_encode(&self) -> DataTree` /
//RS         /// `jet_decode(tree: &DataTree) -> Result<Self, [FieldError]>`. This bridges
//RS         /// the name + signature internally (I2: a sema-accepted hand impl must
//RS         /// produce Rust rustc accepts). `None` for every ordinary trait method.
//RS         serde: Option<SerdeCodec>,
//RS     },
//RS }
//RS 
//RS impl TFuncKind {
//RS     /// The receiver slot of an instance method: its checked owner type and
//RS     /// access convention. `None` for free functions and static methods.
//RS     ///
//RS     /// `TFunc.params` never lists the receiver; this is the one fact every
//RS     /// MIR consumer binds it from, so the receiver is MIR parameter 0 and the
//RS     /// declared parameters follow it in order.
//RS     pub fn receiver(&self) -> Option<(&Type, AccessConvention)> {
//RS         match self {
//RS             TFuncKind::TopLevel => None,
//RS             TFuncKind::Method {
//RS                 self_conv,
//RS                 owner_type,
//RS             }
//RS             | TFuncKind::TraitMethod {
//RS                 self_conv,
//RS                 owner_type,
//RS                 ..
//RS             } => self_conv.map(|access| (owner_type, access)),
//RS         }
//RS     }
//RS }
//RS 
//RS /// c109 Phase 22: a special source iteration form on a `loop x in <coll>`,
//RS /// resolved at lowering from the collection's type or method-call shape.
//RS /// Each carries the receiver's emitted Rust string;
//RS /// `file`/the panic line are program/source facts. The plain `.iter().cloned()` form
//RS /// (incl. a non-special method-call collection like `.split(…)`, which `emit_for_in`
//RS /// routes to its `else` default) is represented by `ForIn.method_kind == None`.
//RS #[derive(Clone)]
//RS pub enum TForInMethod {
//RS     /// `loop c in s.chars()` — char iteration: `for __jet_c in ({recv}).chars()`,
//RS     /// binding `let <var> = __jet_c;`.
//RS     Chars,
//RS     /// `loop line in reader.lines()` on a `FileReader` — streaming `BufRead::lines`
//RS     /// over the reader's `inner`, with a mid-stream-error panic (line `0`, `cx.file`).
//RS     LinesFile,
//RS     /// `loop line in io.stdin().lines()` / a `StdinHandle` — the same streaming read,
//RS     /// but the receiver is materialised into a `__jet_stdin_h` local inside an extra
//RS     /// block (so the `io.stdin()` temporary outlives the loop body), with a matching
//RS     /// extra closing brace.
//RS     LinesStdin,
//RS     /// D-PROCESS1=A: `loop line in child.stdout.lines()` / `child.stderr.lines()` —
//RS     /// a `ProcessChild`'s streaming reader. The receiver string is the plain field
//RS     /// access (`(child).stdout`); each iteration polls
//RS     /// `jet_process_stream_next_line(&recv)` via a `let Some(x) = … else { break }`,
//RS     /// so (unlike `LinesFile`/`LinesStdin`) no extra wrapper block is needed.
//RS     LinesProcessStream,
//RS     /// D-CONC-CHAN1=A: `loop value in receiver` pulls until the receiver closes.
//RS     ChannelReceiver,
//RS     /// D-ENCSTREAM-SURFACE1=A: bounded synchronous codec-reader pull source.
//RS     EncodingReader { reader_type: String },
//RS     /// D-ITER-HOOK: `loop x in mytype` when `mytype` implements `Iterable`.
//RS     /// The symbol fields are canonical checked TFunc identities; MIR and
//RS     /// adapters must not reconstruct them from the collection type.
//RS     /// `item_type` is the hook's checked `Iterator.Item`, the loop binding's
//RS     /// type; the collection type is never the element type.
//RS     Iterable {
//RS         coll_type: String,
//RS         iter_type: String,
//RS         iter_symbol: String,
//RS         next_symbol: String,
//RS         item_type: Type,
//RS     },
//RS }
//RS 
//RS /// c109 Phase 22: an `if` condition, resolved at lowering from the AST node shape
//RS /// (`emit_if`/`if_pattern_test`, Source/Codegen/Statement.rs):
//RS ///  - `Plain` — a boolean expression: `if {cond} {`.
//RS ///  - `And` — a short-circuiting conjunction whose earlier pattern bindings
//RS ///    dominate every later condition and the selected body.
//RS ///  - `IfLet` — an optional-binding test (`x == value(b)` → `Some(b)`, `Ok(b)`/`Err(b)`,
//RS ///    a variant `c == Active(id)`): `if let {pat_str} = {subj} {`. The bound name(s)
//RS ///    are in scope in the then-branch (the binding's resolved type is bound at lowering,
//RS ///    mirroring `add_pattern_bindings`).
//RS ///  - `IsNone` — an `x == null` test (`Pattern::Absent`): `if {subj}.is_none() {`.
//RS ///  - `Matches` — a binding-free enum variant/group test (`d == .Fire`): `if matches!(&{subj}, {pat}) {`.
//RS ///  - `WithPrelude` — compiler-owned statements that must run immediately before
//RS ///    the condition and remain in scope for both the condition and its selected
//RS ///    branch. This is used when a structural pattern reads one subject in both
//RS ///    places; the subject is evaluated once, outside the condition's expression
//RS ///    scope.
//RS #[derive(Clone)]
//RS pub enum TIfCond {
//RS     Plain(TExpr),
//RS     /// A right-associated, short-circuiting conjunction. `left` is atomic;
//RS     /// bindings it introduces dominate `right` and the selected body.
//RS     And {
//RS         left: Box<TIfCond>,
//RS         right: Box<TIfCond>,
//RS     },
//RS     IfLet {
//RS         pattern: TPattern,
//RS         subj: TExpr,
//RS     },
//RS     IsNone {
//RS         subj: TExpr,
//RS     },
//RS     Matches {
//RS         pattern: TPattern,
//RS         subj: TExpr,
//RS     },
//RS     WithPrelude {
//RS         prelude: Vec<TStmt>,
//RS         cond: Box<TIfCond>,
//RS     },
//RS }
//RS 
//RS /// D-DOTSCOPE1: which `#Test` scope member a `TStmt::ScopeMember` is.
//RS #[derive(Clone)]
//RS pub enum ScopeMemberKind {
//RS     /// `.setup { … }` — the body's statements are spliced inline (bindings leak
//RS     /// to the rest of the test), running first.
//RS     Setup,
//RS     /// `.expect_fail { … }` / `.expect_fail(E3010) { … }` — the region must
//RS     /// fail, optionally with the named runtime stop code.
//RS     ExpectFail(Option<String>),
//RS     /// `.timeout(dur) { … }` — post-hoc budget. The region runs to completion,
//RS     /// then its elapsed time is compared against the canonical Duration value;
//RS     /// over budget fails the test. (v1: post-hoc — does not interrupt a hang.)
//RS     Timeout(TExpr),
//RS     /// `.measure { … }` — a claim selected by `jet test --measure`. Plain
//RS     /// `jet test` still executes the body once as an ordinary correctness claim.
//RS     Measure,
//RS     /// `.skip { … }` — a region that is not executed. Emitted as `if false { … }`
//RS     /// so the body still type-checks but never runs.
//RS     Skip,
//RS }
//RS 
