// Exact Prelude lowering for checked typed XML decoders.
// The Prelude owns parsing, XML projection, and FieldError translation.
fn jet_codegen_lower_xml_typed_decode(builder: &JetCodegenBuilder, expression: TExpr, args: [TExpr], type_args: [Type], data_plan: ?MirDataPlan) -> ?MirValueId {
    if type_args.len() != 1 -> return None
    if data_plan != None -> panic("typed XML decode cannot carry a data plan")
    if args.len() != 2 -> panic("checked typed XML decode must materialize its XMLParseOptions argument")
    input_type := jet_codegen_unwrap_pattern_tags(args[0].ty)
    bytes_input := input_type == Type.List(Type.IntN(false, 8))
    if input_type != Type.String && !bytes_input -> panic("checked XML decode has neither String nor [U8] input")
    if args[1].ty != Type.Named("XMLParseOptions") -> panic("checked XML decode options type changed")

    member := if bytes_input -> "decode_bytes" else -> "decode"
    symbol := if bytes_input -> "jet_enc_xml_decode_bytes" else -> "jet_enc_xml_decode"
    route := jet_codegen_intern_route(
        &builder,
        MirPreludeFamily.StaticPrelude,
        "core.encoding.xml",
        member,
        symbol,
        2,
        [Bool]{true, false},
        None,
        jet_codegen_failure_carrier_for_type(expression.ty),
        MirPreludeAbi.Value,
    )
    values := [MirValueId]{}
    loop argument in args -> values.push(jet_codegen_lower_expr(&builder, argument))
    call_args := [MirCallArg]{
        jet_codegen_numeric_call_arg(values[0], args[0].span),
        jet_codegen_numeric_call_arg(values[1], args[1].span),
    }
    lowered_type_args := [MirType]{jet_codegen_lower_type_for_function(type_args[0], &builder)}
    Val(jet_codegen_emit_value(
        &builder,
        expression.span,
        expression.ty,
        MirOperation.Semantic(MirSemanticOp.StaticPreludeCall(route, call_args, [MirPreludeTypeArg]{}, lowered_type_args)),
    ))
}
