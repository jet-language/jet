// MIRRust unwrap_slot_options: `parent[i]` is the line opening the block that
// holds line `i` (-1 for none); `jumps_before[i]` counts the lines before `i`
// that may leave a block early.
struct JetRustEmitSlotReach {
    pub parent: [Int]
    pub jumps_before: [Int]
    pub scope_end: [Int]
}

fn jet_rust_emit_slot_reach(body: [String], indents: [Int], scope_end: [Int]) -> JetRustEmitSlotReach Never! {
    blank :: 9223372036854775807
