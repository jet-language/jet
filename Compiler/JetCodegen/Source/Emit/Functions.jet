// MIRRust plan_native_version `arithmetic`: the native work of a plan, its
// native Binary values and its comparisons of two native values.
fn jet_rust_emit_native_version_arithmetic(ctx: &JetRustEmitContext, function: MIRFunction, plan: JetRustEmitNativeInts) -> Int Never! {
    count := 0
