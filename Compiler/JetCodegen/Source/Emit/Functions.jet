        loop mention in jet_rust_emit_value_mentions(updated) {
            scalar :: plain.get(mention.id) ?? next
            name :: "__jet_v_{mention.id}"
            reference :: "{name}.as_ref().expect(\"MIR value\")"
            read :: if scalar -> name else -> "{name}.clone()"
            updated = updated.replace("({reference}).clone()", read).replace("(*{reference})", name).replace(reference, "(&{name})")
        }
        &rebuilt.push(updated)
    }
    rebuilt
}

// How jet_rust_emit_unwrap_slot_options reads one mention of a function-top
// `Option` slot: a whole-line `slot = Some(E);` write, an `as_ref`/`as_mut`
// borrow, or a take.
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::SlotAccess
enum JetRustEmitSlotAccess { Write Borrow Take }

struct JetRustEmitSlotUse {
    pub line: Int
    pub access: JetRustEmitSlotAccess
}

struct JetRustEmitOptionSlot {
    pub name: String
    pub ty: String
    pub initial: String?
}

// MIRRust option_slot_declaration: `let mut <slot>: Option<T> = None;`, or
// `.. = Some(E);` where jet_rust_emit_localize_value_slots declared a slot at
// its definition, for a numbered local or value slot: the slot, `T`, and the
// `E` that fills it.
fn jet_rust_emit_option_slot_declaration(line: String) -> JetRustEmitOptionSlot? Never! {
    bytes :: line.bytes()
    statement :: String.from_bytes(~(bytes[jet_rust_emit_fold_indent(bytes)..<bytes.len()])) ?? ""
    if !statement.starts_with("let mut ") -> return None
    statement_bytes :: statement.bytes()
    split :: jet_rust_emit_fold_find(statement_bytes, ": Option<".bytes(), 0)
    if split < 8 -> return None
    name :: String.from_bytes(~(statement_bytes[8..<split])) ?? ""
    if !jet_rust_emit_fold_numbered(name, "__jet_l_", "") && !jet_rust_emit_fold_numbered(name, "__jet_v_", "") -> return None
    if statement.ends_with("> = None;") {
        type_end :: statement_bytes.len() - "> = None;".bytes().len()
        if type_end < split + 9 -> return None
        return Val(JetRustEmitOptionSlot{name: name, ty: String.from_bytes(~(statement_bytes[split + 9..<type_end])) ?? "", initial: None})
    }
    fill :: jet_rust_emit_fold_find(statement_bytes, "> = Some(".bytes(), split + 9)
    if fill < 0 -> return None
    payload :: jet_rust_emit_option_slot_write_payload(String.from_bytes(~(statement_bytes[fill + 1..<statement_bytes.len()])) ?? "") ?? return None
    Val(JetRustEmitOptionSlot{name: name, ty: String.from_bytes(~(statement_bytes[split + 9..<fill])) ?? "", initial: Val(payload)})
}

// MIRRust option_slot_write_payload: the payload `E` of a whole-line
// `<slot> = Some(E);` statement, given the text after the slot name; None
// when `Some(` does not close at the final `)`, or `E` holds a character or
// label quote this scan does not pair.
fn jet_rust_emit_option_slot_write_payload(rest: String) -> String? Never! {
    if !rest.starts_with(" = Some(") || !rest.ends_with(");") -> return None
    bytes :: rest.bytes()
    end :: bytes.len() - 2
    if end < 8 -> return None
    depth := 0
    quoted := false
    escaped := false
    loop index in 8..<end {
        code :: Int.from_u8(bytes[index])
        if quoted {
            quoted = escaped || code != 34
            escaped = !escaped && code == 92
            next
        }
        if code == 34 -> quoted = true
        if code == 39 -> return None
        if code == 40 -> depth += 1
        if code == 41 {
            if depth == 0 -> return None
            depth -= 1
        }
    }
    if depth != 0 || quoted -> return None
    Val(String.from_bytes(~(bytes[8..<end])) ?? "")
}

// MIRRust unwrap_slot_options: for each line, the first later line indented
// less than it (`inclusive` false: the end of its block) or no deeper
// (`inclusive` true: the end of the block it opens). Blank lines close nothing.
fn jet_rust_emit_slot_block_ends(indents: [Int], inclusive: Bool) -> [Int] Never! {
    blank :: 9223372036854775807
    ends := [Int]{}
