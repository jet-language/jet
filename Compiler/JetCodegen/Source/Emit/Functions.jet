        bytes :: line.bytes()
        end := 20
        loop end < bytes.len() && Int.from_u8(bytes[end]) >= 48 && Int.from_u8(bytes[end]) <= 57 -> end += 1
        if end > 20 -> &declarations.add(String.from_bytes(~(bytes[20..<end])) ?? "", index).drop("value ids are unique")
    }
    removed := [Bool]{}
    loop _ in body -> &removed.push(false)
    folded := false
    loop index in first_body..<body.len() {
        definition :: indexed[index].definition ?? next
        expected :: if definition.hoisted -> 3 else -> 2
        if (mentions.get(definition.id) ?? 0) != expected -> next
        if definition.hoisted && declarations.get(definition.id) == None -> next
        if !(indexed[index].pure || (definition.hoisted && jet_rust_emit_fold_borrowing_closure(definition.payload))) || jet_rust_emit_fold_attributed(body, index) -> next
        name :: "__jet_v_{definition.id}"
        mention :: jet_rust_emit_fold_index_next(mention_index, name, index + 1, body.len(), false)
        barrier :: jet_rust_emit_fold_index_next(skippable, "{definition.indent}", index + 1, body.len(), true)
        consumer :: if mention < barrier -> mention else -> barrier
        if consumer >= body.len() -> next
        bytes :: body[consumer].bytes()
        indent :: jet_rust_emit_fold_indent(bytes)
        if indent != definition.indent || jet_rust_emit_fold_attributed(body, consumer) -> next
        form := ""
        at := -1
        forms :: [String]{"({name}.as_ref().expect(\"MIR value\")).clone()", "(*{name}.as_ref().expect(\"MIR value\"))", "{name}.take().expect(\"MIR value\")"}
        loop candidate in forms {
            positions :: jet_rust_emit_fold_occurrences(bytes, candidate.bytes())
            if positions.len() == 1 {
                form = candidate
                at = positions[0]
                break
            }
        }
        if at < 0 || jet_rust_emit_fold_inside_closure(bytes, at) -> next
        before :: String.from_bytes(~(bytes[0..<at])) ?? ""
        after :: String.from_bytes(~(bytes[at + form.bytes().len()..<bytes.len()])) ?? ""
        rest :: "{before}{after}"
        rest_bytes :: rest.bytes()
        target := ""
        assign :: jet_rust_emit_fold_find(rest_bytes, " = ".bytes(), indent)
        if assign > indent {
            lhs :: String.from_bytes(~(rest_bytes[indent..<assign])) ?? ""
            if jet_rust_emit_fold_numbered(lhs, "__jet_l_", "") -> target = lhs
        }
        rest_identifiers :: jet_rust_emit_fold_identifiers(rest_bytes)
        conflict := false
