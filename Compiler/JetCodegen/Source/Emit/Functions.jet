// MIRRust unwrap_slot_options: the access on line `at` has a dominating write
// (an earlier write whose reach still holds it) with no take after that write
// and before it, and no unrefilled take inside a loop entered between them.
fn jet_rust_emit_slot_use_initialized(body: [String], reach: JetRustEmitSlotReach, body_end: [Int], loops: [Int], writes: [Int], takes: [Int], at: Int) -> Bool Never! {
    write := -1
    loop candidate in writes {
        if candidate < at && jet_rust_emit_slot_reach_end(body, reach, candidate) > at -> write = candidate
    }
    if write < 0 -> return false
    loop taken in takes {
        if taken > write && taken < at -> return false
