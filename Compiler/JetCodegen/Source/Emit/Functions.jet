fn jet_rust_emit_function_signature(ctx: &JetRustEmitContext, function: MIRFunction) -> String Never! {
    params := [String]{}
    loop capture in function.capture_params -> &params.push(jet_rust_emit_capture_param(&ctx, capture))
    loop parameter in function.params -> &params.push(jet_rust_emit_function_param(&ctx, function, parameter))
    unsafe_prefix :: if function.is_unsafe -> "unsafe " else -> ""
    visibility :: jet_rust_emit_function_visibility(function)
    generic_params :: ~ctx.current_generic_params
    generics :: jet_rust_emit_generic_params(&ctx, generic_params)
    "{visibility}{unsafe_prefix}fn {jet_rust_emit_function_name(&ctx, function.id)}{generics}({params.join(", ")}) -> {jet_rust_emit_callable_return(&ctx, function)} {{"
}

fn jet_rust_emit_function_has_sentry_scope(function: MIRFunction) -> Bool Never! {
    loop scope in function.scopes {
        if scope.kind == MIRScopeKind.Unsafe || scope.kind == MIRScopeKind.Policy -> return true
    }
    false
}

fn jet_rust_emit_function_has_deadline_scope(function: MIRFunction) -> Bool Never! {
    loop scope in function.scopes {
        if scope.kind == MIRScopeKind.Context && scope.deadline != None -> return true
    }
    false
}

fn jet_rust_emit_function_has_unsafe_scope(function: MIRFunction) -> Bool Never! {
    loop scope in function.scopes {
        if scope.kind == MIRScopeKind.Unsafe -> return true
    }
    false
}

