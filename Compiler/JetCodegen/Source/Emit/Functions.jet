        if definition.hoisted -> removed[declarations.get(definition.id) ?? index] = true
        folded = true
    }
    if !folded -> return ~lines
    rebuilt := [String]{}
    loop (index, entry) in lines {
        if index >= values_start -> break
        &rebuilt.push(entry)
    }
    loop (index, line) in body {
        if !removed[index] -> &rebuilt.push(line)
    }
    rebuilt
}

// A Rust type whose values copy, so an owned read names the binding.
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::copy_scalar_type
fn jet_rust_emit_copy_scalar_type(ty: String) -> Bool Never! {
    ty == "bool" || ty == "char" || ty == "f32" || ty == "f64" || ty == "i8" || ty == "i16" || ty == "i32" || ty == "i64" || ty == "i128" || ty == "isize" || ty == "u8" || ty == "u16" || ty == "u32" || ty == "u64" || ty == "u128" || ty == "usize"
}

// Whether `pattern` occurs in `bytes` starting exactly at `at`.
fn jet_rust_emit_bytes_at(bytes: [U8], pattern: [U8], at: Int) -> Bool Never! {
    if at < 0 || at + pattern.len() > bytes.len() -> return false
    loop offset in 0..<pattern.len() {
        if bytes[at + offset] != pattern[offset] -> return false
    }
    true
}

// MIRRust unwrap_value_slots: `lines[start..]` are the slot declarations and
// the body. A slot declared at its single definition (`let mut slot:
// Option<T> = Some(E);`, see `jet_rust_emit_localize_value_slots`) whose every
// other mention is a shared read (`slot.as_ref().expect("MIR value")`) is never
// taken, written through or re-initialized, so it becomes `let slot: T = E;`:
// an owned read names a Copy scalar directly and clones any other type, and a
// borrow is `&slot`.
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::unwrap_value_slots
fn jet_rust_emit_unwrap_value_slots(lines: [String], start: Int) -> [String] Never! {
    body := [String]{}
    loop (index, entry) in lines {
        if index >= start {
            loop line in entry.split("\n").to_list() -> &body.push(line)
        }
    }
    borrow :: ".as_ref().expect(\"MIR value\")".bytes()
    mentions := [String:Int]{}
    borrows := [String:Int]{}
    definitions := [String]{}
    types := [String:String]{}
    loop line in body {
        bytes :: line.bytes()
        loop mention in jet_rust_emit_value_mentions(line) {
            &mentions.add(mention.id, (mentions.get(mention.id) ?? 0) + 1).drop("the count replaces the prior count")
            if jet_rust_emit_bytes_at(bytes, borrow, mention.column + 8 + mention.id.bytes().len()) -> &borrows.add(mention.id, (borrows.get(mention.id) ?? 0) + 1).drop("the count replaces the prior count")
        }
        definition :: jet_rust_emit_fold_definition(line) ?? next
        if definition.hoisted -> next
        statement :: String.from_bytes(~(bytes[definition.indent..<bytes.len()])) ?? ""
        prefix :: "let mut __jet_v_{definition.id}: Option<"
        if !statement.starts_with(prefix) -> next
        statement_bytes :: statement.bytes()
        end :: jet_rust_emit_fold_find(statement_bytes, "> = Some(".bytes(), 0)
        if end < prefix.bytes().len() -> next
        &definitions.push(definition.id)
        &types.add(definition.id, String.from_bytes(~(statement_bytes[prefix.bytes().len()..<end])) ?? "").drop("a later definition replaces the prior one")
    }
    plain := [String:Bool]{}
    loop id in definitions {
        if (mentions.get(id) ?? 0) == (borrows.get(id) ?? 0) + 1 -> &plain.add(id, jet_rust_emit_copy_scalar_type(types.get(id) ?? "")).drop("a later definition replaces the prior one")
    }
    if plain.len() == 0 -> return ~lines
    rebuilt := [String]{}
    loop (index, entry) in lines {
        if index >= start -> break
        &rebuilt.push(entry)
    }
    loop line in body {
        // A plain slot's definition becomes a plain `let`; its expression can
        // itself read other plain slots, so the rewritten line still gets the
        // read replacements below.
        updated := line
        if jet_rust_emit_fold_definition(line) == .Val(row) {
            if !row.hoisted && plain.get(row.id) != None {
                bytes :: line.bytes()
                pad :: String.from_bytes(~(bytes[0..<row.indent])) ?? ""
                updated = "{pad}let __jet_v_{row.id}: {types.get(row.id) ?? ""} = {row.payload};"
            }
