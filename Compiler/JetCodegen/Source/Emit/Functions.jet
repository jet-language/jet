fn jet_rust_emit_return_slot_wrapper(ctx: &JetRustEmitContext, function: MIRFunction) -> [String] Never! {
    params := [String]{}
    args := [String]{}
    loop parameter in function.params {
        &params.push(jet_rust_emit_function_param(&ctx, function, parameter))
        &args.push(jet_rust_emit_parameter_name(function, parameter.index))
    }
    &args.push("&mut {JET_RUST_EMIT_RETURN_SLOT_PARAMETER}")
