    generics :: jet_rust_emit_generic_params(&ctx, generic_params)
    name :: jet_rust_emit_function_name(&ctx, function.id)
    [String]{
        "{jet_rust_emit_function_visibility(function)}fn {name}{generics}({params.join(", ")}) -> {jet_rust_emit_callable_return(&ctx, function)} {{",
        "    let mut {JET_RUST_EMIT_RETURN_SLOT_PARAMETER} = None;",
        "    {jet_rust_emit_return_slot_symbol(name)}({args.join(", ")});",
        "    {JET_RUST_EMIT_RETURN_SLOT_PARAMETER}.expect(\"MIR return slot\")",
        "}}",
        "",
    }
}

// MIRRust emit_callable_named (#4566 return slot): the head of a return-slot
// function's body symbol, which takes the caller's slot as a hidden last
// parameter and returns nothing.
fn jet_rust_emit_return_slot_signature(ctx: &JetRustEmitContext, function: MIRFunction) -> String Never! {
    params := [String]{}
    loop parameter in function.params -> &params.push(jet_rust_emit_function_param(&ctx, function, parameter))
    &params.push("{JET_RUST_EMIT_RETURN_SLOT_PARAMETER}: &mut Option<{jet_rust_emit_callable_return(&ctx, function)}>")
    generic_params :: ~ctx.current_generic_params
    generics :: jet_rust_emit_generic_params(&ctx, generic_params)
    "{jet_rust_emit_function_visibility(function)}fn {jet_rust_emit_return_slot_symbol(jet_rust_emit_function_name(&ctx, function.id))}{generics}({params.join(", ")}) {{"
