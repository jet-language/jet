            allowed :: if variable == target -> 1 else -> 0
            if (rest_identifiers.counts.get(variable) ?? 0) > allowed -> conflict = true
            between :: jet_rust_emit_fold_index_prefix(mention_index, variable, consumer) - jet_rust_emit_fold_index_prefix(mention_index, variable, index + 1)
