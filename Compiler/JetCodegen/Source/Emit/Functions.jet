        }
        if indexed[consumer].skippable {
            prior :: indexed[consumer].definition ?? next
            jet_rust_emit_fold_index_add(&skippable, "{prior.indent}", consumer, -1, body.len())
        }
        indexed[consumer] = jet_rust_emit_fold_line(body, consumer)
        loop variable in indexed[consumer].identifiers.names {
            jet_rust_emit_fold_index_add(&mention_index, variable, consumer, indexed[consumer].identifiers.counts.get(variable) ?? 0, body.len())
        }
