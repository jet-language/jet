// MIRRust native_param_slot: the native shadow of a versioned parameter.
fn jet_rust_emit_native_param_slot(index: Int) -> String Never! {
    "__jet_pi_{index}"
}

// MIRRust native_int_local: the native local `place` names whole, if any.
