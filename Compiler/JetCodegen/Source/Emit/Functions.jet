// MIRRust unwrap_slot_options reach_end: the end of what a write on line
// `write` initializes for: its own block, widened past each enclosing labeled
// block (`'label: {`) that always runs the write before control leaves it,
// which holds when no jump inside that block precedes the write.
fn jet_rust_emit_slot_reach_end(body: [String], reach: JetRustEmitSlotReach, write: Int) -> Int Never! {
    current := write
    loop reach.parent[current] >= 0 {
        opener :: reach.parent[current]
        content :: body[opener].trim()
        labeled :: content.starts_with("'") && content.ends_with(": {{") && !content.ends_with("loop {{")
        if !labeled || reach.jumps_before[write] > reach.jumps_before[opener + 1] -> break
        current = opener
