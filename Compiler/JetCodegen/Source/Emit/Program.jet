// Public MIR -> Rust source boundary. Incomplete artifacts never carry source.
use jet_foundation.[
    CompilerTraceSink,
    MIRAccess,
    MIRConstantDef,
    MIRForeign,
    MIRForeignABI,
    MIRForeignLanguage,
    MIRFunction,
    MIRImplDef,
    MIRModuleID,
    MIRParam,
    MIRProgram,
    MIRTargetApplicability,
    MIRType,
    MIRTypeID,
    MIRTypeKind,
    mir_terminator_targets,
]

fn jet_rust_emit_target_enabled(config: JetRustEmitConfig, applicability: MIRTargetApplicability) -> Bool Never! {
    if config.target == "web" -> applicability.web else -> applicability.rust_aot
}

fn jet_rust_emit_function_target_enabled(config: JetRustEmitConfig, function: MIRFunction) -> Bool Never! {
    if !jet_rust_emit_target_enabled(config, function.target_applicability) -> return false
    if config.target != "web" -> return true
    bucket :: config.web_bucket ?? return true
    function.web_bucket == (Val(bucket))
}

fn jet_rust_emit_foreign_target_enabled(ctx: &JetRustEmitContext, foreign: MIRForeign) -> Bool Never! {
    if !jet_rust_emit_target_enabled(ctx.config, foreign.target_applicability) -> return false
    if ctx.config.target != "web" || ctx.config.web_bucket == None -> return true
    loop function_index in 0..<ctx.program.functions.len() {
        function :: ctx.program.functions[function_index]
        if !jet_rust_emit_function_target_enabled(ctx.config, function) -> next
        loop block in function.blocks {
            loop instruction in block.instructions {
                if instruction.operation == {
                    .Call(callee, _, _) -> {
                        if callee == {
                            .Foreign(id) -> {
                                if id == foreign.id -> return true
                            }
                            else -> {}
                        }
                    }
                    else -> {}
                }
            }
        }
    }
    false
}

// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::module_selected
fn jet_rust_emit_module_selected(ctx: JetRustEmitContext, module_id: MIRModuleID) -> Bool Never! {
    ctx.all_modules_selected || ctx.selected_modules.get(jet_rust_emit_id_key(module_id.value)) != None
}

// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::impl_selected_for_target
fn jet_rust_emit_impl_target_enabled(ctx: &JetRustEmitContext, implementation: MIRImplDef) -> Bool Never! {
    if !jet_rust_emit_target_enabled(ctx.config, implementation.target_applicability) -> return false
    if ctx.config.target != "web" || ctx.config.web_bucket == None -> return true
    loop method_id in implementation.methods {
        if jet_rust_emit_function_index(ctx, method_id) == .Val(function_index) {
            if ctx.program.functions[function_index].id == method_id && jet_rust_emit_function_target_enabled(ctx.config, ctx.program.functions[function_index]) -> return true
        }
    }
    false
}

fn jet_rust_emit_validate_function(ctx: &JetRustEmitContext, function: MIRFunction) Never! {
    block_ids := [U64:Bool]{}
    loop block in function.blocks -> block_ids[block.id.value] = true
    found_entry := false
    loop block in function.blocks {
        if block.id == function.entry -> found_entry = true
        loop target in mir_terminator_targets(block.terminator) {
            if block_ids.get(target.value) == None -> jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidControlFlow, "E0003", "MIR terminator targets a missing block", "checked CFG edges must resolve before source emission", Val(block.span))
        }
    }
    if !found_entry -> jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidControlFlow, "E0003", "MIR function entry block is missing", "each checked function must have one block matching its entry identity", Val(function.span))
}

fn jet_rust_emit_validate_program(ctx: &JetRustEmitContext) Never! {
    loop function_index in 0..<ctx.program.functions.len() {
        function := ctx.program.functions[function_index]
        jet_rust_emit_validate_function(&ctx, function)
    }
    jet_rust_emit_reject_history_strategies(&ctx)
}

fn jet_rust_emit_foreign_abi(abi: MIRForeignABI) -> String Never! {
    if abi == {
        .C -> "C"
        .CUnwind -> "C-unwind"
        .System -> "system"
        .Stdcall -> "stdcall"
        .Fastcall -> "fastcall"
        .Vectorcall -> "vectorcall"
        .Rust -> "Rust"
        .Platform(name) -> name
    }
}

fn jet_rust_emit_foreign_handle_type(ctx: &JetRustEmitContext, foreign: MIRForeign, ty: MIRType) -> Bool Never! {
    if foreign.handle == None -> return false
    loop handle in ctx.program.handles {
        if jet_rust_emit_same_handle_type(handle.ty, ty) -> return true
    }
    false
}

fn jet_rust_emit_foreign_param_type(ctx: &JetRustEmitContext, foreign: MIRForeign, parameter: MIRParam) -> String Never! {
    transport :: foreign.callback_transport ?? ""
    if transport == "native-start" {
        if parameter.ty.kind == {
            .Fn(signature) -> {
                if signature.params.len() == 0 {
                    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "native callback start parameter has no event payload", "native callback start rows must carry a checked FfiCallbackEvent payload", Val(foreign.span))
                    return "()"
                }
                payload := signature.params[0]
                if payload.kind == {
                    .Apply(name, args) -> {
                        if name.name == "FfiCallbackEvent" && args.len() == 1 {
                            ret :: if signature.ret == .Val(ret_ty) -> " -> {jet_rust_emit_type(&ctx, ret_ty)}" else -> ""
                            return "Option<unsafe extern \"C\" fn(*mut core::ffi::c_void, {jet_rust_emit_type(&ctx, args[0])}){ret}>"
                        }
                    }
                    else -> {}
                }
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "native callback start parameter has an invalid event payload", "native callback start rows must carry FfiCallbackEvent<T> as their first callback parameter", Val(foreign.span))
                return "()"
            }
            else -> {}
        }
    }
    if jet_rust_emit_foreign_handle_type(&ctx, foreign, parameter.ty) -> return "*mut core::ffi::c_void"
    if foreign.foreign_language == MIRForeignLanguage.C && transport == "" {
        visited := [MIRTypeID]{}
        if !jet_rust_emit_c_abi_type_supported(&ctx, parameter.ty, &visited) {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.UnsupportedForeign, "E0003", "C parameter has no checked physical ABI representation", "direct C parameters require C-safe scalar, fixed-array, repr(C) record, or tagged C enum facts", Val(foreign.span))
        }
        abi_type :: jet_rust_emit_c_abi_type(&ctx, parameter.ty)
        if parameter.access == MIRAccess.Write -> return "*mut {abi_type}"
        return abi_type
    }
    // MIRRust foreign_param_type: a raw-scalar Int parameter is a host machine word.
    if foreign.raw_scalar_abi && parameter.ty.kind == MIRTypeKind.Int -> return "i64"
    jet_rust_emit_callable_param_type(&ctx, parameter.ty, parameter.access)
}

fn jet_rust_emit_foreign_return_type(ctx: &JetRustEmitContext, foreign: MIRForeign) -> String Never! {
    transport :: foreign.callback_transport ?? ""
    if transport == "native-start" -> return "*mut core::ffi::c_void"
    ty :: foreign.return_type ?? return "()"
    if jet_rust_emit_foreign_handle_type(&ctx, foreign, ty) -> return "*mut core::ffi::c_void"
    if foreign.foreign_language == MIRForeignLanguage.C && transport == "" {
        visited := [MIRTypeID]{}
        if !jet_rust_emit_c_abi_type_supported(&ctx, ty, &visited) {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.UnsupportedForeign, "E0003", "C return has no checked physical ABI representation", "direct C returns require C-safe scalar, fixed-array, repr(C) record, or tagged C enum facts", Val(foreign.span))
        }
        return jet_rust_emit_c_abi_type(&ctx, ty)
    }
    jet_rust_emit_type(&ctx, ty)
}

fn jet_rust_emit_foreign(ctx: &JetRustEmitContext, foreign: MIRForeign) -> [String] Never! {
    lines := [String]{}
    transport :: foreign.callback_transport ?? ""
    if transport == "managed" || transport == "managed-close" || transport == "emit-task" -> return lines
    params := [String]{}
    loop parameter in foreign.params {
        name :: jet_rust_emit_mangle(parameter.name)
        &params.push("{name}: {jet_rust_emit_foreign_param_type(&ctx, foreign, parameter)}")
    }
    if transport == "native-start" -> &params.push("__jet_callback_ctx: *mut core::ffi::c_void")
    ret :: jet_rust_emit_foreign_return_type(&ctx, foreign)
    &lines.push("extern \"{jet_rust_emit_foreign_abi(foreign.foreign_abi)}\" {{")
    &lines.push("    #[link_name = {jet_rust_emit_quote(foreign.symbol)}]")
    &lines.push("    pub fn {jet_rust_emit_foreign_name(&ctx, foreign.id)}({params.join(", ")}) -> {ret};")
    &lines.push("}}")
    lines
}

// MIRRust emit_constant_def: a storage constant is one persistent cell (an
// exact Int defers its heap-backed initializer to the first read); a folded
// scalar is an inline function because heap-backed carriers are not Rust const
// expressions. A folded aggregate is one per-thread value built once; reads
// borrow it (`NAME_shared`). A large list is filled by row chunks, a smaller
// one by the inline `vec![..]` of the same rows.
fn jet_rust_emit_constant_definition(ctx: &JetRustEmitContext, definition: MIRConstantDef) -> String Never! {
    visibility :: jet_rust_emit_visibility(definition.visibility)
    name :: jet_rust_emit_generated_path(definition.key)
    ty :: jet_rust_emit_type(&ctx, definition.ty)
    root :: ~ctx.config.root_prefix
    if jet_rust_emit_shared_constant(jet_rust_emit_is_no_os(&ctx), definition) {
        chunks := [String]{}
        init := ""
        listed := if definition.ty.kind == {
            .List(_) -> true
            else -> false
        }
        if listed {
            listed = false
            if definition.value == .List(values) {
                listed = true
                element :: jet_rust_emit_constant_inner_type(definition.ty, 0)
                rows := [String]{}
                bytes := 0
                loop value in values {
                    row :: jet_rust_emit_constant(&ctx, value, element)
                    bytes += row.bytes().len()
                    &rows.push(row)
                }
                init = if bytes > 16 * 1024 -> jet_rust_emit_list_constant_chunks(name, ty, rows, &chunks) else -> "vec![{rows.join(", ")}]"
            }
        }
        if !listed -> init = jet_rust_emit_constant(&ctx, definition.value, definition.ty)
        &chunks.push("thread_local! {{\n    static {name}_SHARED: std::rc::Rc<{ty}> = std::rc::Rc::new({init});\n}}\n")
        &chunks.push("#[inline]\n{visibility}fn {name}() -> {ty} {{ {name}_SHARED.with(|value| (**value).clone()) }}\n")
        &chunks.push("#[inline]\n{visibility}fn {name}_shared() -> {root}JetSharedSlot<{ty}> {{ {name}_SHARED.with(|value| {root}JetSharedSlot::new(std::rc::Rc::clone(value))) }}")
        return chunks.join("\n")
    }
    value :: jet_rust_emit_constant(&ctx, definition.value, definition.ty)
    if definition.is_storage {
        cell :: "{root}JetPersistCell"
        if definition.ty.kind == MIRTypeKind.Int -> return "{visibility}static {name}: std::sync::LazyLock<{cell}<{ty}>> = std::sync::LazyLock::new(|| {cell}::new({value}));"
        return "{visibility}static {name}: {cell}<{ty}> = {cell}::new({value});"
    }
    "#[inline]\n{visibility}fn {name}() -> {ty} {{ {value} }}"
}

// MIRRust shared_constant (D-MEM-COPYSEM1): a folded aggregate constant (text,
// list, map, option, result, tuple, or nominal value) on a hosted target is one
// shared per-thread value; a read holds it in a `JetSharedSlot` and borrows it
// in place, and only an owned use copies it. Scalars stay plain values.
fn jet_rust_emit_shared_constant(no_os: Bool, definition: MIRConstantDef) -> Bool Never! {
    if definition.is_storage || no_os -> return false
    if definition.ty.kind == {
        .String | .List(_) | .Map(_, _) | .Option(_) | .Result(_, _) | .Tuple(_) | .Apply(_, _) -> true
        else -> false
    }
}

// MIRRust emit_list_constant_chunks: the initializer of a large folded list
// constant. Row-chunk helpers of at most 64 KB each fill the rows, so no
// emitted function holds the whole table; the helpers go to `chunks`.
fn jet_rust_emit_list_constant_chunks(name: String, ty: String, rows: [String], chunks: &[String]) -> String Never! {
    lines := [String]{}
    count := 0
    start := 0
    bytes := 0
    loop (index, row) in rows {
        width :: row.bytes().len()
        if index > start && bytes + width > 64 * 1024 {
            &lines.push("}}\n")
            count += 1
            start = index
            bytes = 0
        }
        if index == start -> &lines.push("fn {name}_rows_{count}(rows: &mut {ty}) {{")
        bytes += width
        &lines.push("    rows.push({row});")
    }
    &lines.push("}}\n")
    count += 1
    &chunks.push(lines.join("\n"))
    init := [String]{"{{", "        let mut rows: {ty} = Vec::with_capacity({rows.len()});"}
    loop index in 0..<count -> &init.push("        {name}_rows_{index}(&mut rows);")
    &init.push("        rows")
    &init.push("    }}")
    init.join("\n")
}

// The emitted text is the user-item suffix of the artifact: the host prepends
// the build-fact runtime prefix (MIRRust emit_mir_runtime_text), which owns the
// crate-level inner attributes and imports, so this header carries neither.
fn jet_rust_emit_program_header(ctx: &JetRustEmitContext, lines: &[String]) Never! {
    &lines.push("// Generated by Jet MIR Rust source emission; checked MIR is authoritative.")
    &lines.push("")
    if ctx.config.emit_metadata {
        schema_doc :: jet_rust_emit_quote("jet-mir-schema:{ctx.program.schema_version}")
        package_doc :: jet_rust_emit_quote("jet-package:{ctx.program.package_identity}")
        &lines.push("#[doc = {schema_doc}]")
        &lines.push("#[doc = {package_doc}]")
    }
}

pub fn jet_rust_emit_program(program: MIRProgram, config: JetRustEmitConfig, trace_sink: CompilerTraceSink?) -> JetRustEmitResult Never! {
    ctx := jet_rust_emit_context(program, config)
    if ctx.failure != None -> return jet_rust_emit_result(&ctx, "")
    jet_rust_emit_validate_program(&ctx)
    if ctx.failure != None -> return jet_rust_emit_result(&ctx, "")
    // Program items go to their build unit's section (jet_rust_emit_units);
    // `pieces` records the line range of each package-unit item.
    units :: jet_rust_emit_units(ctx.program)
    pieces := [JetRustEmitUnitPiece]{}
    lines := [String]{}
    jet_rust_emit_program_header(&ctx, &lines)
    jet_rust_emit_hardware_facts(&ctx, &lines)
    // MIRRust module_selected: only the selected artifact's modules emit items.
    artifact :: jet_rust_emit_selected_artifact(&ctx)
    if artifact == .Val(plan) {
        ctx.all_modules_selected = false
        loop module_id in plan.modules -> ctx.selected_modules[jet_rust_emit_id_key(module_id.value)] = true
    }
    // MIRRust emit_mir_program_items order: types, traits and constants (all
    // under emit_types), link closure, C ABI records, foreign items, callback
    // trampolines, impls, then top-level functions.
    if ctx.config.emit_types {
        loop handle in ctx.program.handles {
            handle_lines := [String]{}
            jet_rust_emit_handle_type(&ctx, handle, &handle_lines)
            loop line in handle_lines -> &lines.push(line)
            if handle_lines.len() > 0 -> &lines.push("")
        }
        loop definition in ctx.program.types {
            if !jet_rust_emit_module_selected(ctx, definition.module_id) -> next
            start :: lines.len()
            jet_rust_emit_type_definition(&ctx, definition, &lines)
            if units.split -> jet_rust_emit_units_record(&pieces, jet_rust_emit_units_module_unit(units, definition.module_id, definition.span.start), start, lines.len())
        }
        jet_rust_emit_period_anchor_impls(&ctx, &lines)
        loop definition in ctx.program.traits {
            if !jet_rust_emit_module_selected(ctx, definition.module_id) -> next
            // MIRRust: the cached runtime declares compiler-owned traits; only
            // Rollback keeps a per-program declaration.
            if definition.name != "Rollback" && (jet_rust_emit_compiler_owned_trait(definition.name) || jet_rust_emit_compiler_owned_trait(definition.key)) -> next
            start :: lines.len()
            trait_lines := [String]{}
            jet_rust_emit_trait_definition(&ctx, definition, &trait_lines)
            loop line in trait_lines -> &lines.push(line)
            &lines.push("")
            if units.split -> jet_rust_emit_units_record(&pieces, jet_rust_emit_units_module_unit(units, definition.module_id, definition.span.start), start, lines.len())
        }
        // Card #4258: a constant whose every read was copied into its use
        // sites (jet_codegen_constant_copies_into_uses) needs no accessor;
        // storage cells and every constant still read through `Global` keep
        // their item.
        global_reads := [String:Bool]{}
        loop function in ctx.program.functions {
            loop block in function.blocks {
                loop instruction in block.instructions {
                    if instruction.operation == .Global(name) -> global_reads[name] = true
                }
            }
        }
        loop constant in ctx.program.constants {
            if !jet_rust_emit_module_selected(ctx, constant.module_id) -> next
            if !constant.is_storage && global_reads.get(constant.key) == None -> next
            start :: lines.len()
            &lines.push(jet_rust_emit_constant_definition(&ctx, constant))
            &lines.push("")
            if units.split -> jet_rust_emit_units_record(&pieces, jet_rust_emit_units_module_unit(units, constant.module_id, constant.span.start), start, lines.len())
        }
    }
    jet_rust_emit_link_closure(&ctx, &lines)
    jet_rust_emit_c_abi_type_definitions(&ctx, &lines)
    if ctx.config.emit_foreign {
        loop foreign in ctx.program.foreign {
            if !jet_rust_emit_module_selected(ctx, foreign.module_id) -> next
            if jet_rust_emit_foreign_target_enabled(&ctx, foreign) {
                start :: lines.len()
                foreign_lines :: jet_rust_emit_foreign(&ctx, foreign)
                loop line in foreign_lines -> &lines.push(line)
                &lines.push("")
                if units.split -> jet_rust_emit_units_record(&pieces, jet_rust_emit_units_module_unit(units, foreign.module_id, foreign.span.start), start, lines.len())
            }
        }
    }
    jet_rust_emit_callback_trampolines(&ctx, &lines)
    codec_keep :: mir_demanded_codec_impls(ctx.program)
    loop (index, implementation) in ctx.program.impls {
        if !jet_rust_emit_module_selected(ctx, implementation.module_id) {
            loop method_id in implementation.methods -> ctx.skipped_methods[jet_rust_emit_id_key(method_id.value)] = true
            next
        }
        if !codec_keep[index] {
            loop method_id in implementation.methods -> ctx.skipped_methods[jet_rust_emit_id_key(method_id.value)] = true
            next
        }
        if jet_rust_emit_impl_target_enabled(&ctx, implementation) {
            start :: lines.len()
            impl_lines := [String]{}
            jet_rust_emit_impl_definition(&ctx, implementation, &impl_lines)
            loop line in impl_lines -> &lines.push(line)
            &lines.push("")
            if units.split -> jet_rust_emit_units_record(&pieces, jet_rust_emit_units_impl_unit(&ctx, units, implementation), start, lines.len())
        }
    }
    trace_functions := false
    if trace_sink == .Val(sink) -> trace_functions = sink.functions()
    loop position in 0..<ctx.program.functions.len() {
        function := ctx.program.functions[position]
        if trace_sink == .Val(sink) -> sink.progress("emit", position, ctx.program.functions.len())
        if !jet_rust_emit_module_selected(ctx, function.module_id) -> next
        if jet_rust_emit_function_target_enabled(ctx.config, function) && ctx.skipped_methods.get(jet_rust_emit_id_key(function.id.value)) == None {
            if trace_functions {
                if trace_sink == .Val(sink) -> sink.begin("emit.function", function.name, position, ctx.program.functions.len())
            }
            start :: lines.len()
            function_lines :: jet_rust_emit_function(&ctx, function)
            loop line in function_lines -> &lines.push(line)
            &lines.push("")
            if units.split -> jet_rust_emit_units_record(&pieces, jet_rust_emit_units_file_unit(units, jet_rust_emit_id_key(function.source_file.value), function.span.start), start, lines.len())
            if trace_functions {
                if trace_sink == .Val(sink) -> sink.end("emit.function", lines.len() - start)
            }
        }
    }
    items_end :: lines.len()
    // The emit phase's end closes this span on every return below.
    if trace_sink == .Val(sink) -> sink.begin("emit.assemble", "", -1, -1)
    jet_rust_emit_artifact_assembly(&ctx, &lines)
    if ctx.failure != None -> return jet_rust_emit_result(&ctx, "")
    if units.split -> return jet_rust_emit_result(&ctx, jet_rust_emit_units_layout(pieces, lines, items_end).join("\n"))
    jet_rust_emit_result(&ctx, lines.join("\n"))
}

// MIRRust EmissionUnits: build units of one emitted program. An item's unit
// is the package of the original `Compiler/<Package>/…` file whose bootstrap
// assembler provenance marker (Compiler/Bootstrap/assemble.mjs) is in effect
// at the item's span, so the assembled compiler splits into one crate per
// package. Items outside a marked range (Core, compiler-synthesized rows) go
// to the `base` unit beneath every package. Programs with fewer than two
// units are not split; single-crate consumers only see marker comments.
JET_RUST_EMIT_UNIT_PROVENANCE_MARKER :: "// [jet-bootstrap source: "
JET_RUST_EMIT_UNIT_BEGIN_MARKER :: "// jet:unit-begin "
JET_RUST_EMIT_UNIT_END_MARKER :: "// jet:unit-end "
JET_RUST_EMIT_BASE_UNIT :: "base"

struct JetRustEmitUnitStart {
    pub offset: Int
    pub unit: String
}

struct JetRustEmitUnits {
    pub split: Bool
    // Source file id key -> (byte offset where a marked file's text starts,
    // unit), in source order.
    pub starts: [String:[JetRustEmitUnitStart]]
    // Module id key -> source file id key.
    pub module_files: [String:String]
}

// The emitted lines `start..<end` of one package-unit item.
struct JetRustEmitUnitPiece {
    pub unit: String
    pub start: Int
    pub end: Int
}

fn jet_rust_emit_units(program: MIRProgram) -> JetRustEmitUnits Never! {
    starts := [String:[JetRustEmitUnitStart]]{}
    names := [String:Bool]{}
    marker_length :: JET_RUST_EMIT_UNIT_PROVENANCE_MARKER.bytes().len()
    loop file in program.source_files {
        rows := [JetRustEmitUnitStart]{}
        offset := 0
        // MIRRust EmissionUnits::new: offsets count each line with its real
        // newline (split_inclusive), and a marker line matches with its
        // trailing whitespace (`\r`, spaces) trimmed.
        segments :: file.source.split("\n").to_list()
        loop (index, line) in segments {
            last :: index == segments.len() - 1
            width :: line.bytes().len()
            if last && width == 0 -> break
            newline :: if last -> 0 else -> 1
            offset += width + newline
            if !line.starts_with(JET_RUST_EMIT_UNIT_PROVENANCE_MARKER) -> next
            marker :: line.trim_end()
            if !marker.ends_with("]") -> next
            bytes :: marker.bytes()
            path :: String.from_bytes(~(bytes[marker_length..<bytes.len() - 1])) ?? ""
            parts :: path.split("/").to_list()
            unit :: if parts.len() > 1 -> parts[1] else -> JET_RUST_EMIT_BASE_UNIT
            names[unit] = true
            &rows.push(JetRustEmitUnitStart{offset: offset, unit: unit})
        }
        if rows.len() > 0 -> starts[jet_rust_emit_id_key(file.id.value)] = rows
    }
    module_files := [String:String]{}
    loop row in program.modules -> module_files[jet_rust_emit_id_key(row.id.value)] = jet_rust_emit_id_key(row.source_file.value)
    JetRustEmitUnits{split: names.len() > 1, starts: starts, module_files: module_files}
}

fn jet_rust_emit_units_file_unit(units: JetRustEmitUnits, file_key: String, offset: Int) -> String Never! {
    rows :: units.starts.get(file_key) ?? return JET_RUST_EMIT_BASE_UNIT
    low := 0
    high := rows.len()
    loop low < high {
        middle :: (low + high) /% 2
        if rows[middle].offset <= offset -> low = middle + 1 else -> high = middle
    }
    if low == 0 -> return JET_RUST_EMIT_BASE_UNIT
    rows[low - 1].unit
}

fn jet_rust_emit_units_module_unit(units: JetRustEmitUnits, module_id: MIRModuleID, offset: Int) -> String Never! {
    file_key :: units.module_files.get(jet_rust_emit_id_key(module_id.value)) ?? return JET_RUST_EMIT_BASE_UNIT
    jet_rust_emit_units_file_unit(units, file_key, offset)
}

// Rust's orphan rule: an impl of a runtime trait must live in the crate
// declaring its self type, so it follows the type's unit (the first type row
// matching the nominal id, key or name, as MIRRust first_type_def_matching).
fn jet_rust_emit_units_impl_unit(ctx: &JetRustEmitContext, units: JetRustEmitUnits, implementation: MIRImplDef) -> String Never! {
    if implementation.self_type.kind == .Apply(name, _) {
        index := -1
        by_id :: ctx.type_index_by_id.get(jet_rust_emit_id_key(name.id.value)) ?? -1
        by_key :: ctx.type_index_by_key.get(name.name) ?? -1
        by_name :: ctx.type_index_by_name.get(name.name) ?? -1
        candidates :: [Int]{by_id, by_key, by_name}
        loop row in candidates {
            if row >= 0 && (index < 0 || row < index) -> index = row
        }
        if index >= 0 {
            definition :: ctx.program.types[index]
            return jet_rust_emit_units_module_unit(units, definition.module_id, definition.span.start)
        }
    }
    jet_rust_emit_units_module_unit(units, implementation.module_id, implementation.span.start)
}

fn jet_rust_emit_units_record(pieces: &[JetRustEmitUnitPiece], unit: String, start: Int, end: Int) Never! {
    if unit == JET_RUST_EMIT_BASE_UNIT || end <= start -> return
    &pieces.push(JetRustEmitUnitPiece{unit: unit, start: start, end: end})
}

// MIRRust EmissionUnits.write_sections: the base section (every line before
// `items_end` outside a package piece) first, then each package's pieces in
// unit-name order, each between its begin/end markers. Lines from
// `items_end` on (artifact assembly) stay after the sections.
fn jet_rust_emit_units_layout(pieces: [JetRustEmitUnitPiece], lines: [String], items_end: Int) -> [String] Never! {
    out := [String]{}
    &out.push("{JET_RUST_EMIT_UNIT_BEGIN_MARKER}{JET_RUST_EMIT_BASE_UNIT}")
    cursor := 0
    names := [String]{}
    loop piece in pieces {
        loop index in cursor..<piece.start -> &out.push(lines[index])
        cursor = piece.end
        &names.push(piece.unit)
    }
    loop index in cursor..<items_end -> &out.push(lines[index])
    &out.push("{JET_RUST_EMIT_UNIT_END_MARKER}{JET_RUST_EMIT_BASE_UNIT}")
    loop unit in jet_codegen_sort_strings(names) {
        &out.push("{JET_RUST_EMIT_UNIT_BEGIN_MARKER}{unit}")
        loop piece in pieces {
            if piece.unit != unit -> next
            loop index in piece.start..<piece.end -> &out.push(lines[index])
        }
        &out.push("{JET_RUST_EMIT_UNIT_END_MARKER}{unit}")
    }
    loop index in items_end..<lines.len() -> &out.push(lines[index])
    out
}
