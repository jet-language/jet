// Public MIR -> Rust source boundary. Incomplete artifacts never carry source.
use jet_foundation.[
    name_mangle,
    CompilerTraceSink,
    MIRAccess,
    MIRBasicBlock,
    MIRConstantDef,
    MIRDropAction,
    MIRSharedLifetime,
    MIRForeign,
    MIRForeignABI,
    MIRForeignLanguage,
    MIRFunction,
    MIRImplDef,
    MIRLocal,
    MIRModuleID,
    MIRParam,
    MIRPlace,
    MIRProgram,
    MIRScope,
    MIRTargetApplicability,
    MIRType,
    MIRTypeID,
    MIRTypeKind,
    MIRValueFact,
    compiler_threads_admit,
    compiler_threads_failure_text,
    compiler_threads_part_of,
    compiler_threads_partition,
    mir_terminator_targets,
    mir_type_is_unit,
    mir_demanded_codec_impls,
]

fn jet_rust_emit_target_enabled(config: JetRustEmitConfig, applicability: MIRTargetApplicability) -> Bool Never! {
    if config.target == "web" -> applicability.web else -> applicability.rust_aot
}

fn jet_rust_emit_function_target_enabled(config: JetRustEmitConfig, function: MIRFunction) -> Bool Never! {
    if !jet_rust_emit_target_enabled(config, function.target_applicability) -> return false
    if config.target != "web" -> return true
    bucket :: config.web_bucket ?? return true
    function.web_bucket == (Val(bucket))
}

fn jet_rust_emit_foreign_target_enabled(ctx: &JetRustEmitContext, foreign: MIRForeign) -> Bool Never! {
    if !jet_rust_emit_target_enabled(ctx.config, foreign.target_applicability) -> return false
    if ctx.config.target != "web" || ctx.config.web_bucket == None -> return true
    loop function_index in 0..<ctx.program.functions.len() {
        function :: ctx.program.functions[function_index]
        if !jet_rust_emit_function_target_enabled(ctx.config, function) -> next
        loop block in function.blocks {
            loop instruction in block.instructions {
                if instruction.operation == {
                    .Call(callee, _, _) -> {
                        if callee == {
                            .Foreign(id) -> {
                                if id == foreign.id -> return true
                            }
                            else -> {}
                        }
                    }
                    else -> {}
                }
            }
        }
    }
    false
}

// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::module_selected
fn jet_rust_emit_module_selected(ctx: JetRustEmitContext, module_id: MIRModuleID) -> Bool Never! {
    ctx.all_modules_selected || ctx.selected_modules.get(module_id.value) != None
}

// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::impl_selected_for_target
fn jet_rust_emit_impl_target_enabled(ctx: &JetRustEmitContext, implementation: MIRImplDef) -> Bool Never! {
    if !jet_rust_emit_target_enabled(ctx.config, implementation.target_applicability) -> return false
    if ctx.config.target != "web" || ctx.config.web_bucket == None -> return true
    loop method_id in implementation.methods {
        if jet_rust_emit_function_index(ctx, method_id) == .Val(function_index) {
            if ctx.program.functions[function_index].id == method_id && jet_rust_emit_function_target_enabled(ctx.config, ctx.program.functions[function_index]) -> return true
        }
    }
    false
}

fn jet_rust_emit_validate_function(ctx: &JetRustEmitContext, function: MIRFunction) Never! {
    block_ids := [U64:Bool]{}
    loop block in function.blocks -> block_ids[block.id.value] = true
    found_entry := false
    loop block in function.blocks {
        if block.id == function.entry -> found_entry = true
        loop target in mir_terminator_targets(block.terminator) {
            if block_ids.get(target.value) == None -> jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidControlFlow, "E0003", "MIR terminator targets a missing block", "checked CFG edges must resolve before source emission", Val(block.span))
        }
    }
    if !found_entry -> jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidControlFlow, "E0003", "MIR function entry block is missing", "each checked function must have one block matching its entry identity", Val(function.span))
}

fn jet_rust_emit_validate_program(ctx: &JetRustEmitContext) Never! {
    loop function_index in 0..<ctx.program.functions.len() {
        function := ctx.program.functions[function_index]
        jet_rust_emit_validate_function(&ctx, function)
    }
    jet_rust_emit_reject_history_strategies(&ctx)
}

fn jet_rust_emit_foreign_abi(abi: MIRForeignABI) -> String Never! {
    if abi == {
        .C -> "C"
        .CUnwind -> "C-unwind"
        .System -> "system"
        .Stdcall -> "stdcall"
        .Fastcall -> "fastcall"
        .Vectorcall -> "vectorcall"
        .Rust -> "Rust"
        .Platform(name) -> name
    }
}

fn jet_rust_emit_foreign_handle_type(ctx: &JetRustEmitContext, foreign: MIRForeign, ty: MIRType) -> Bool Never! {
    if foreign.handle == None -> return false
    loop handle in ctx.program.handles {
        if jet_rust_emit_same_handle_type(handle.ty, ty) -> return true
    }
    false
}

fn jet_rust_emit_foreign_param_type(ctx: &JetRustEmitContext, foreign: MIRForeign, parameter: MIRParam) -> String Never! {
    transport :: foreign.callback_transport ?? ""
    if transport == "native-start" {
        if parameter.ty.kind == {
            .Fn(signature) -> {
                if signature.params.len() == 0 {
                    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "native callback start parameter has no event payload", "native callback start rows must carry a checked FfiCallbackEvent payload", Val(foreign.span))
                    return "()"
                }
                payload := signature.params[0]
                if payload.kind == {
                    .Apply(name, args) -> {
                        if name.name == "FfiCallbackEvent" && args.len() == 1 {
                            ret :: if signature.ret == .Val(ret_ty) -> " -> {jet_rust_emit_type(&ctx, ret_ty)}" else -> ""
                            return "Option<unsafe extern \"C\" fn(*mut core::ffi::c_void, {jet_rust_emit_type(&ctx, args[0])}){ret}>"
                        }
                    }
                    else -> {}
                }
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "native callback start parameter has an invalid event payload", "native callback start rows must carry FfiCallbackEvent<T> as their first callback parameter", Val(foreign.span))
                return "()"
            }
            else -> {}
        }
    }
    if jet_rust_emit_foreign_handle_type(&ctx, foreign, parameter.ty) -> return "*mut core::ffi::c_void"
    if foreign.foreign_language == MIRForeignLanguage.C && transport == "" {
        visited := [MIRTypeID]{}
        if !jet_rust_emit_c_abi_type_supported(&ctx, parameter.ty, &visited) {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.UnsupportedForeign, "E0003", "C parameter has no checked physical ABI representation", "direct C parameters require C-safe scalar, fixed-array, repr(C) record, or tagged C enum facts", Val(foreign.span))
        }
        abi_type :: jet_rust_emit_c_abi_type(&ctx, parameter.ty)
        if parameter.access == MIRAccess.Write -> return "*mut {abi_type}"
        return abi_type
    }
    // MIRRust foreign_param_type: a raw-scalar Int parameter is a host machine word.
    if foreign.raw_scalar_abi && parameter.ty.kind == MIRTypeKind.Int -> return "i64"
    jet_rust_emit_callable_param_type(&ctx, parameter.ty, parameter.access)
}

fn jet_rust_emit_foreign_return_type(ctx: &JetRustEmitContext, foreign: MIRForeign) -> String Never! {
    transport :: foreign.callback_transport ?? ""
    if transport == "native-start" -> return "*mut core::ffi::c_void"
    ty :: foreign.return_type ?? return "()"
    if jet_rust_emit_foreign_handle_type(&ctx, foreign, ty) -> return "*mut core::ffi::c_void"
    if foreign.foreign_language == MIRForeignLanguage.C && transport == "" {
        visited := [MIRTypeID]{}
        if !jet_rust_emit_c_abi_type_supported(&ctx, ty, &visited) {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.UnsupportedForeign, "E0003", "C return has no checked physical ABI representation", "direct C returns require C-safe scalar, fixed-array, repr(C) record, or tagged C enum facts", Val(foreign.span))
        }
        return jet_rust_emit_c_abi_type(&ctx, ty)
    }
    jet_rust_emit_type(&ctx, ty)
}

fn jet_rust_emit_safe_c_value_type(ty: MIRType) -> Bool Never! {
    if mir_type_is_unit(ty) -> return true
    if ty.kind == {
        .Int | .IntN(_, _) | .Float | .Float32 | .Bool | .Char | .String -> true
        else -> false
    }
}

fn jet_rust_emit_safe_c_foreign(foreign: MIRForeign) -> Bool Never! {
    if foreign.foreign_language != MIRForeignLanguage.C || foreign.callback_transport != None -> return false
    loop parameter in foreign.params {
        if parameter.access != MIRAccess.Read || !jet_rust_emit_safe_c_value_type(parameter.ty) -> return false
    }
    if foreign.return_type == .Val(ty) -> return jet_rust_emit_safe_c_value_type(ty)
    true
}

fn jet_rust_emit_safe_c_module(foreign: MIRForeign) -> String Never! {
    "__jet___c_{foreign.id.value}"
}

fn jet_rust_emit_safe_c_adapter(ctx: &JetRustEmitContext, foreign: MIRForeign, lines: &[String]) Never! {
    params := [String]{}
    rendered := [String]{}
    setup := [String]{}
    index := 0
    loop parameter in foreign.params {
        ty :: if parameter.ty.kind == MIRTypeKind.String -> "str" else -> jet_rust_emit_type(&ctx, parameter.ty)
        &params.push("arg_{index}: &{ty}")
        if parameter.ty.kind == MIRTypeKind.String {
            &setup.push("let cstring_{index} = std::ffi::CString::new(arg_{index}).unwrap_or_else(|_| panic!(\"native C String contains NUL\"));")
            &rendered.push("cstring_{index}.as_ptr()")
        } else {
            &rendered.push(jet_rust_emit_c_abi_encode(&ctx, "arg_{index}", parameter.ty, true, [MIRTypeID]{}) ?? panic("checked value-only C parameter has no physical encoding"))
        }
        index += 1
    }
    raw :: "unsafe {{ super::{jet_rust_emit_foreign_name(&ctx, foreign.id)}({rendered.join(", ")}) }}"
    ret := "()"
    body := raw
    if foreign.return_type == .Val(ty) {
        ret = jet_rust_emit_type(&ctx, ty)
        body = jet_rust_emit_c_abi_decode(&ctx, raw, ty, [MIRTypeID]{}) ?? panic("checked value-only C result has no physical decoding")
    }
    &lines.push("// AUDIT: value-only C ABI; CString owners live through the call.")
    &lines.push("// Scalar narrowing and result validation use shared checked adapters.")
    &lines.push("// Pointer/handle/write signatures retain source-authored Unsafe gates.")
    &lines.push("mod {jet_rust_emit_safe_c_module(foreign)} {{ use super::*; pub(super) fn call({params.join(", ")}) -> {ret} {{")
    loop line in setup -> &lines.push(line)
    &lines.push(body)
    &lines.push("}} }}")
}

fn jet_rust_emit_foreign(ctx: &JetRustEmitContext, foreign: MIRForeign) -> [String] Never! {
    lines := [String]{}
    transport :: foreign.callback_transport ?? ""
    if transport == "managed" || transport == "managed-close" || transport == "emit-task" -> return lines
    params := [String]{}
    loop parameter in foreign.params {
        name :: name_mangle(parameter.name)
        &params.push("{name}: {jet_rust_emit_foreign_param_type(&ctx, foreign, parameter)}")
    }
    if transport == "native-start" -> &params.push("__jet_callback_ctx: *mut core::ffi::c_void")
    ret :: jet_rust_emit_foreign_return_type(&ctx, foreign)
    &lines.push("extern \"{jet_rust_emit_foreign_abi(foreign.foreign_abi)}\" {{")
    &lines.push("    #[link_name = {jet_rust_emit_quote(foreign.symbol)}]")
    &lines.push("    pub fn {jet_rust_emit_foreign_name(&ctx, foreign.id)}({params.join(", ")}) -> {ret};")
    &lines.push("}}")
    if jet_rust_emit_safe_c_foreign(foreign) -> jet_rust_emit_safe_c_adapter(&ctx, foreign, &lines)
    lines
}

// MIRRust emit_constant_def: a storage constant is one persistent cell (an
// exact Int defers its heap-backed initializer to the first read); a folded
// scalar is an inline function because heap-backed carriers are not Rust const
// expressions. A folded aggregate is one per-thread value built once; reads
// borrow it (`NAME_shared`). A large list is filled by row chunks, a smaller
// one by the inline `vec![..]` of the same rows.
fn jet_rust_emit_constant_definition(ctx: &JetRustEmitContext, definition: MIRConstantDef) -> String Never! {
    visibility :: jet_rust_emit_visibility(definition.visibility)
    name :: jet_rust_emit_generated_path(definition.key)
    // A constant's views can only borrow static data.
    ty :: jet_rust_emit_type_with_view_lifetime(&ctx, definition.ty, "'static")
    root :: ctx.config.root_prefix.copy()
    if definition.value == .SharedSite(site) {
        initialize :: jet_rust_emit_function_name(&ctx, site.initializer)
        process_or_world :: if site.lifetime == {
            .Process | .World -> true
            else -> false
        }
        if process_or_world {
            payload :: if definition.ty.kind == {.Shared(inner) -> jet_rust_emit_type(&ctx, inner) else -> panic("checked publication site has non-Shared type")}
            world :: site.lifetime == MIRSharedLifetime.World
            return "static __{name}_site: {root}jet_std::JetSharedSite<{payload}> = {root}jet_std::JetSharedSite::new();\n{visibility}fn {name}() -> {ty} {{ __{name}_site.get({initialize}, {world}) }}\n"
        }
        lines := [String]{"thread_local! {{ static __{name}_site: std::cell::RefCell<Option<{ty}>> = const {{ std::cell::RefCell::new(None) }}; }}"}
        register := ""
        if site.lifetime == MIRSharedLifetime.Attempt {
            &lines.push("fn __{name}_reset() {{ __{name}_site.with(|site| {{ let retired = site.borrow_mut().take(); drop(retired); }}); }}")
            register = "{root}jet_global_shared_register_attempt({site.initializer.value}u64, __{name}_reset); "
        }
        &lines.push("{visibility}fn {name}() -> {ty} {{ __{name}_site.with(|site| {{ if let Some(value) = site.borrow().as_ref() {{ return value.clone(); }} let candidate = {initialize}(); let value = {{ let mut site = site.borrow_mut(); site.get_or_insert(candidate).clone() }}; {register}value }}) }}")
        return "{lines.join("\n")}\n"
    } else {
        return jet_rust_emit_ordinary_constant_definition(&ctx, definition, visibility, name, ty, root)
    }
}

fn jet_rust_emit_ordinary_constant_definition(ctx: &JetRustEmitContext, definition: MIRConstantDef, visibility: String, name: String, ty: String, root: String) -> String Never! {
    if jet_rust_emit_shared_constant(jet_rust_emit_is_no_os(&ctx), definition) {
        chunks := [String]{}
        init := ""
        listed := if definition.ty.kind == {
            .List(_) -> true
            else -> false
        }
        if listed {
            listed = false
            if definition.value == .List(values) {
                listed = true
                element :: jet_rust_emit_constant_inner_type(definition.ty, 0)
                rows := [String]{}
                bytes := 0
                loop value in values {
                    row :: jet_rust_emit_constant(&ctx, value, element)
                    bytes += row.bytes().len()
                    &rows.push(row)
                }
                init = if bytes > 16 * 1024 -> jet_rust_emit_list_constant_chunks(name, ty, rows, &chunks) else -> "vec![{rows.join(", ")}]"
            }
        }
        if !listed -> init = jet_rust_emit_constant(&ctx, definition.value, definition.ty)
        &chunks.push("thread_local! {{\n    static {name}_SHARED: std::rc::Rc<{ty}> = std::rc::Rc::new({init});\n}}\n")
        &chunks.push("#[inline]\n{visibility}fn {name}() -> {ty} {{ {name}_SHARED.with(|value| (**value).clone()) }}\n")
        &chunks.push("#[inline]\n{visibility}fn {name}_shared() -> {root}JetSharedSlot<{ty}> {{ {name}_SHARED.with(|value| {root}JetSharedSlot::new(std::rc::Rc::clone(value))) }}\n")
        // #5001: a `Static` place borrows the thread's one shared value for
        // the thread's life: one retained handle per thread, no copy.
        &chunks.push("thread_local! {{\n    static {name}_STATIC: &'static std::rc::Rc<{ty}> = {name}_SHARED.with(|value| &*Box::leak(Box::new(std::rc::Rc::clone(value))));\n}}\n")
        &chunks.push("#[inline]\n#[allow(dead_code)]\n{visibility}fn {name}_static() -> &'static {ty} {{ let shared: &'static std::rc::Rc<{ty}> = {name}_STATIC.with(|value| *value); &**shared }}")
        return chunks.join("\n")
    }
    value :: jet_rust_emit_constant(&ctx, definition.value, definition.ty)
    if definition.is_storage {
        cell :: "{root}JetPersistCell"
        if definition.ty.kind == MIRTypeKind.Int -> return "{visibility}static {name}: std::sync::LazyLock<{cell}<{ty}>> = std::sync::LazyLock::new(|| {cell}::new({value}));"
        return "{visibility}static {name}: {cell}<{ty}> = {cell}::new({value});"
    }
    "#[inline]\n{visibility}fn {name}() -> {ty} {{ {value} }}"
}

// MIRRust shared_constant a folded aggregate constant (text,
// list, map, option, result, tuple, or nominal value) on a hosted target is one
// shared per-thread value; a read holds it in a `JetSharedSlot` and borrows it
// in place, and only an owned use copies it. Scalars stay plain values.
fn jet_rust_emit_shared_constant(no_os: Bool, definition: MIRConstantDef) -> Bool Never! {
    if definition.is_storage || no_os -> return false
    if definition.value == .SharedSite(_) -> return false
    shared :: if definition.ty.kind == {
        .String | .List(_) | .Map(_, _) | .Option(_) | .Result(_, _) | .Tuple(_) | .Apply(_, _) -> true
        else -> false
    }
    shared
}

// MIRRust emit_list_constant_chunks: the initializer of a large folded list
// constant. Row-chunk helpers of at most 64 KB each fill the rows, so no
// emitted function holds the whole table; the helpers go to `chunks`.
fn jet_rust_emit_list_constant_chunks(name: String, ty: String, rows: [String], chunks: &[String]) -> String Never! {
    lines := [String]{}
    count := 0
    start := 0
    bytes := 0
    loop (index, row) in rows {
        width :: row.bytes().len()
        if index > start && bytes + width > 64 * 1024 {
            &lines.push("}}\n")
            count += 1
            start = index
            bytes = 0
        }
        if index == start -> &lines.push("fn {name}_rows_{count}(rows: &mut {ty}) {{")
        bytes += width
        &lines.push("    rows.push({row});")
    }
    &lines.push("}}\n")
    count += 1
    &chunks.push(lines.join("\n"))
    init := [String]{"{{", "        let mut rows: {ty} = Vec::with_capacity({rows.len()});"}
    loop index in 0..<count -> &init.push("        {name}_rows_{index}(&mut rows);")
    &init.push("        rows")
    &init.push("    }}")
    init.join("\n")
}

// The emitted text is the user-item suffix of the artifact: the host prepends
// the build-fact runtime prefix (MIRRust emit_mir_runtime_text), which owns the
// crate-level inner attributes and imports, so this header carries neither.
fn jet_rust_emit_program_header(ctx: &JetRustEmitContext, lines: &[String]) Never! {
    &lines.push("// Generated by Jet MIR Rust source emission; checked MIR is authoritative.")
    &lines.push("")
    if ctx.config.emit_metadata {
        schema_doc :: jet_rust_emit_quote("jet-mir-schema:{ctx.program.schema_version}")
        package_doc :: jet_rust_emit_quote("jet-package:{ctx.program.package_identity}")
        &lines.push("#[doc = {schema_doc}]")
        &lines.push("#[doc = {package_doc}]")
    }
}

fn jet_rust_emit_program(program: MIRProgram, config: JetRustEmitConfig, trace_sink: CompilerTraceSink?) -> JetRustEmitResult Never! {
    ctx := jet_rust_emit_context(program, config)
    jet_rust_emit_program_items(&ctx, trace_sink)
}

// JET_KEEP_GOING: the program's emission with every failure kept beside the
// function being printed. Past the emitter's own tables (whose failure still
// stops it), a failure no longer stops emission: the result is the complete
// text with each failed construct's placeholder, never a shippable artifact.
struct JetRustEmitKeepGoing {
    result: JetRustEmitResult
    failures: [JetRustEmitKeptFailure]
}

fn jet_rust_emit_program_keep_going(program: MIRProgram, config: JetRustEmitConfig, trace_sink: CompilerTraceSink?) -> JetRustEmitKeepGoing Never! {
    kept_config := config
    kept_config.keep_going = true
    ctx := jet_rust_emit_context(program, kept_config)
    result := jet_rust_emit_program_items(&ctx, trace_sink)
    JetRustEmitKeepGoing{result: result, failures: ctx.kept_failures}
}

fn jet_rust_emit_program_items(ctx: &JetRustEmitContext, trace_sink: CompilerTraceSink?) -> JetRustEmitResult Never! {
    if ctx.failure != None -> return jet_rust_emit_result(&ctx, "")
    jet_rust_emit_validate_program(&ctx)
    if ctx.failure != None && !ctx.config.keep_going -> return jet_rust_emit_result(&ctx, "")
    lines := [String]{}
    global_instructions_scanned := 0
    impls_emitted := 0
    top_level_functions_emitted := 0
    jet_rust_emit_program_header(&ctx, &lines)
    jet_rust_emit_hardware_facts(&ctx, &lines)
    jet_rust_emit_program_allocator(&ctx, &lines)
    // MIRRust module_selected: only the selected artifact's modules emit items.
    artifact :: jet_rust_emit_selected_artifact(&ctx)
    if artifact == .Val(plan) {
        ctx.all_modules_selected = false
        loop module_id in plan.modules -> ctx.selected_modules[module_id.value] = true
    }
    // MIRRust emit_mir_program_items order: types, traits and constants (all
    // under emit_types), link closure, C ABI records, foreign items, callback
    // trampolines, impls, then top-level functions.
    if ctx.config.emit_types {
        loop handle in ctx.program.handles {
            handle_lines := [String]{}
            jet_rust_emit_handle_type(&ctx, handle, &handle_lines)
            loop line in handle_lines -> &lines.push(line)
            if handle_lines.len() > 0 -> &lines.push("")
        }
        carrierless_records :: jet_rust_emit_used_carrierless_core_records(&ctx)
        loop definition in ctx.program.types {
            if !jet_rust_emit_module_selected(ctx, definition.module_id) -> next
            jet_rust_emit_type_definition(&ctx, definition, carrierless_records.get(definition.id.value) != None, &lines)
        }
        loop definition in ctx.program.traits {
            if !jet_rust_emit_module_selected(ctx, definition.module_id) -> next
            // MIRRust: the cached runtime declares compiler-owned traits; only
            // Rollback keeps a per-program declaration.
            if definition.name != "Rollback" && (jet_rust_emit_compiler_owned_trait(definition.name) || jet_rust_emit_compiler_owned_trait(definition.key)) -> next
            trait_lines := [String]{}
            jet_rust_emit_trait_definition(&ctx, definition, &trait_lines)
            loop line in trait_lines -> &lines.push(line)
            &lines.push("")
        }
        // Card #4258: a constant whose every read was copied into its use
        // sites (jet_codegen_constant_copies_into_uses) needs no accessor;
        // storage cells and every constant still read through `Global` keep
        // their item.
        global_reads := [String:Bool]{}
        loop function in ctx.program.functions {
            loop block in function.blocks {
                loop instruction in block.instructions {
                    if trace_sink != None -> global_instructions_scanned += 1
                    if instruction.operation == .Global(name) -> global_reads[name] = true
                }
            }
            // #5001: a constant read in place keeps its item too.
            loop place in function.places {
                if place.base == .Static(name) -> global_reads[name] = true
            }
        }
        loop constant in ctx.program.constants {
            if !jet_rust_emit_module_selected(ctx, constant.module_id) -> next
            if !constant.is_storage && global_reads.get(constant.key) == None -> next
            &lines.push(jet_rust_emit_constant_definition(&ctx, constant))
            &lines.push("")
        }
    }
    jet_rust_emit_link_closure(&ctx, &lines)
    jet_rust_emit_c_abi_type_definitions(&ctx, &lines)
    if ctx.config.emit_foreign {
        loop foreign in ctx.program.foreign {
            if !jet_rust_emit_module_selected(ctx, foreign.module_id) -> next
            if jet_rust_emit_foreign_target_enabled(&ctx, foreign) {
                foreign_lines :: jet_rust_emit_foreign(&ctx, foreign)
                loop line in foreign_lines -> &lines.push(line)
                &lines.push("")
            }
        }
    }
    jet_rust_emit_callback_trampolines(&ctx, &lines)
    codec_keep :: mir_demanded_codec_impls(ctx.program)
    loop (index, implementation) in ctx.program.impls {
        if !jet_rust_emit_module_selected(ctx, implementation.module_id) {
            loop method_id in implementation.methods -> ctx.skipped_methods[method_id.value] = true
            next
        }
        if !codec_keep[index] || jet_rust_emit_runtime_carrier_trait_impl(&ctx, implementation) {
            loop method_id in implementation.methods -> ctx.skipped_methods[method_id.value] = true
            next
        }
        if jet_rust_emit_impl_target_enabled(&ctx, implementation) {
            impl_lines := [String]{}
            jet_rust_emit_impl_definition(&ctx, implementation, &impl_lines)
            if trace_sink != None -> impls_emitted += 1
            loop line in impl_lines -> &lines.push(line)
            &lines.push("")
        }
    }
    trace_functions := false
    if trace_sink == .Val(sink) -> trace_functions = sink.functions()
    // Per-function trace spans time each function on this thread.
    workers :: if trace_functions -> 1 else -> jet_rust_emit_function_workers(ctx)
    if workers > 1 {
        texts :: jet_rust_emit_functions_on_threads(&ctx, workers) ?? panic("the function printing threads failed")
        printed := 0
        loop position in 0..<ctx.program.functions.len() {
            if trace_sink == .Val(sink) -> sink.progress("emit", position, ctx.program.functions.len())
            if !jet_rust_emit_prints_function(ctx, ctx.program.functions[position]) -> next
            loop line in texts[printed] -> &lines.push(line)
            printed += 1
            &lines.push("")
        }
    }
    if workers <= 1 {
        loop position in 0..<ctx.program.functions.len() {
            function := ctx.program.functions[position]
            if trace_sink == .Val(sink) -> sink.progress("emit", position, ctx.program.functions.len())
            if !jet_rust_emit_prints_function(ctx, function) -> next
            if trace_functions {
                if trace_sink == .Val(sink) -> sink.begin("emit.function", function.name, position, ctx.program.functions.len())
            }
            start :: lines.len()
            function_lines :: jet_rust_emit_function(&ctx, function)
            if trace_sink != None -> top_level_functions_emitted += 1
            loop line in function_lines -> &lines.push(line)
            &lines.push("")
            if trace_functions {
                if trace_sink == .Val(sink) -> sink.end("emit.function", lines.len() - start)
            }
        }
    }
    if trace_sink == .Val(sink) {
        sink.progress("counters.emit.global_instructions_scanned", global_instructions_scanned, -1)
        sink.progress("counters.emit.impls_scanned", ctx.program.impls.len(), -1)
        sink.progress("counters.emit.impls_emitted", impls_emitted, -1)
        sink.progress("counters.emit.functions_scanned", ctx.program.functions.len(), -1)
        sink.progress("counters.emit.top_level_functions_emitted", top_level_functions_emitted, -1)
        sink.progress("counters.emit.item_lines_emitted", lines.len(), -1)
    }
    // The emit phase's end closes this span on every return below.
    if trace_sink == .Val(sink) -> sink.begin("emit.assemble", "", -1, -1)
    jet_rust_emit_artifact_assembly(&ctx, &lines)
    if ctx.failure != None && !ctx.config.keep_going -> return jet_rust_emit_result(&ctx, "")
    if ctx.config.keep_going -> ctx.failure = None
    jet_rust_emit_result(&ctx, lines.join("\n"))
}

// Function printing threads (compiler_threads_admit): a thread is
// admitted for at least this many MIR instructions, so a small program
// prints on the calling thread.
JET_RUST_EMIT_MIN_INSTRUCTIONS_PER_THREAD :: 20000
// Estimated bytes per MIR instruction of the program for each thread's two
// copies of the emission context (its tables and every function's signature
// row, no bodies), and per instruction of the largest function a thread
// prints (its body index, move facts and printed lines).
JET_RUST_EMIT_CONTEXT_BYTES_PER_INSTRUCTION :: 256
JET_RUST_EMIT_PRINT_BYTES_PER_INSTRUCTION :: 4096

// One printing thread's slot: its rows (last-first) and whether it prints
// each, moved in by single-element moves; then the lines of each row it
// printed (first-first) and the failures printing them reported. The thread
// prints the rows in place behind the slot's guard, so no row is copied.
struct JetRustEmitSlot {
    functions: [MIRFunction]
    prints: [Bool]
    texts: [[String]]
    failure: JetRustEmitFailure?
    kept_failures: [JetRustEmitKeptFailure]
}

// MIRRust emit_mir_program_items: a function prints when its module is
// selected, its target admits it, and no impl prints or drops it.
fn jet_rust_emit_prints_function(ctx: JetRustEmitContext, function: MIRFunction) -> Bool Never! {
    jet_rust_emit_module_selected(ctx, function.module_id) && jet_rust_emit_function_target_enabled(ctx.config, function) && ctx.skipped_methods.get(function.id.value) == None
}

fn jet_rust_emit_function_instructions(function: MIRFunction) -> Int Never! {
    size := 0
    loop block_index in 0..<function.blocks.len() -> size += function.blocks[block_index].instructions.len()
    size
}

// The threads that print the functions: as many as the compiler may use,
// one per JET_RUST_EMIT_MIN_INSTRUCTIONS_PER_THREAD printed instructions at
// most, within the memory the host reported free.
fn jet_rust_emit_function_workers(ctx: JetRustEmitContext) -> Int Never! {
    jobs := 0
    total := 0
    largest := 0
    loop position in 0..<ctx.program.functions.len() {
        if !jet_rust_emit_prints_function(ctx, ctx.program.functions[position]) -> next
        size :: jet_rust_emit_function_instructions(ctx.program.functions[position])
        jobs += 1
        total += size
        if size > largest -> largest = size
    }
    compiler_threads_admit(ctx.config.threads, jobs, total, JET_RUST_EMIT_MIN_INSTRUCTIONS_PER_THREAD, total * JET_RUST_EMIT_CONTEXT_BYTES_PER_INSTRUCTION + largest * JET_RUST_EMIT_PRINT_BYTES_PER_INSTRUCTION, total * JET_RUST_EMIT_CONTEXT_BYTES_PER_INSTRUCTION)
}

// A function row without its body: what printing another function reads of
// it (identity, signature, form, facts and flags).
fn jet_rust_emit_signature_row(function: MIRFunction) -> MIRFunction Never! {
    MIRFunction{
        id: function.id,
        module_id: function.module_id,
        source_file: function.source_file,
        key: function.key,
        module_name: function.module_name,
        name: function.name,
        span: function.span,
        kind: function.kind,
        form: function.form,
        visibility: function.visibility,
        target_applicability: function.target_applicability,
        web_bucket: function.web_bucket,
        web_marker: function.web_marker,
        generic_params: function.generic_params,
        capture_params: function.capture_params,
        params: function.params,
        declared_return: function.declared_return,
        return_type: function.return_type,
        failure: function.failure,
        effects: function.effects,
        captures: function.captures,
        generator: function.generator,
        optimization: function.optimization,
        is_unsafe: function.is_unsafe,
        unsafe_gate: function.unsafe_gate,
        is_pure: function.is_pure,
        memo_bound: function.memo_bound,
        memo_unbounded: function.memo_unbounded,
        is_reactive: function.is_reactive,
        reactive_upgrades: function.reactive_upgrades,
        is_inline: function.is_inline,
        is_inline_always: function.is_inline_always,
        is_scalar: function.is_scalar,
        kernel_proof: function.kernel_proof,
        gc_return: function.gc_return,
        return_view_provenance: function.return_view_provenance,
        web_param_reconstructions: function.web_param_reconstructions,
        blocks: [MIRBasicBlock]{},
        entry: function.entry,
        locals: [MIRLocal]{},
        values: [MIRValueFact]{},
        places: [MIRPlace]{},
        scopes: [MIRScope]{},
        drops: [MIRDropAction]{},
        foreign_language: function.foreign_language,
    }
}

// Prints the printed functions on `workers` threads, the same as one thread
// would. The rows leave the program in consecutive parts of about equal
// printed instructions (compiler_threads_partition), one slot per part, and
// while the threads print, the program holds only signature rows, so the
// context the threads share carries no body. Each thread prints its part's
// rows in order on its own copy of that context; the slots drain in part
// order: the rows come back in program order, the first failure is the first
// in program order after any already reported, and kept failures stay in
// program order. Returns each printed function's lines, in program order.
fn jet_rust_emit_functions_on_threads(ctx: &JetRustEmitContext, workers: Int) -> [[String]] {
    prints := [Bool]{}
    weights := [Int]{}
    loop position in 0..<ctx.program.functions.len() {
        prints_row :: jet_rust_emit_prints_function(ctx, ctx.program.functions[position])
        &prints.push(prints_row)
        &weights.push(if prints_row -> jet_rust_emit_function_instructions(ctx.program.functions[position]) else -> 0)
    }
    bounds :: compiler_threads_partition(weights, workers)
    slots := [Shared<JetRustEmitSlot>]{}
    loop _ in 0..<workers {
        slot :: shared JetRustEmitSlot{functions: [MIRFunction]{}, prints: [Bool]{}, texts: [[String]]{}, failure: None, kept_failures: [JetRustEmitKeptFailure]{}}
        &slots.push(slot)
    }
    signatures := [MIRFunction]{}
    part := workers - 1
    loop {
        function :: &ctx.program.functions.pop() ?? break
        position :: ctx.program.functions.len()
        part = compiler_threads_part_of(bounds, part, position)
        &signatures.push(jet_rust_emit_signature_row(function))
        jet_rust_emit_slot_fill(slots[part], ^function, prints[position])
    }
    &signatures.reverse()
    ctx.program.functions = signatures
    shared_ctx :: shared ctx
    // The threads read the signature rows from their shared copy; the slots
    // drain the full rows back onto an empty program.
    ctx.program.functions = [MIRFunction]{}
    printed :: jet_rust_emit_slots(slots, 0, shared_ctx)
    texts := [[String]]{}
    loop slot in slots -> jet_rust_emit_slot_drain(&ctx, slot, &texts)
    if texts.len() != printed -> panic("emit threads returned {texts.len()} printed functions for {printed}")
    texts
}

// Moves one row into its part's slot (rows arrive last-first).
fn jet_rust_emit_slot_fill(slot: Shared<JetRustEmitSlot>, function: ^MIRFunction, prints: Bool) {
    permit :: slot.guard_edit()
    &permit.value.functions.push(^function)
    &permit.value.prints.push(prints)
}

// Moves a slot's rows back onto the end of the program (popping its
// last-first rows restores program order), appends its printed lines, and
// merges its failures after the ones already held.
fn jet_rust_emit_slot_drain(ctx: &JetRustEmitContext, slot: Shared<JetRustEmitSlot>, texts: &[[String]]) {
    permit :: slot.guard_edit()
    loop permit.value.functions.len() > 0 {
        function :: &permit.value.functions.pop() ?? break
        &ctx.program.functions.push(function)
    }
    loop permit.value.texts.len() > 0 {
        lines :: &permit.value.texts.pop() ?? break
        &texts.push(lines)
    }
    if ctx.failure == None -> ctx.failure = permit.value.failure
    &ctx.kept_failures.extend(permit.value.kept_failures)
}

// Prints `slots[from..]`, one task per slot and the last slot on this
// thread, and returns how many functions they printed.
fn jet_rust_emit_slots(slots: [Shared<JetRustEmitSlot>], from: Int, shared_ctx: Shared<JetRustEmitContext>) -> Int {
    if from >= slots.len() - 1 -> return jet_rust_emit_slot(slots[from], shared_ctx)
    printed := 0
    task.group emit_threads {
        head :: task jet_rust_emit_slot(slots[from], shared_ctx)
        printed = jet_rust_emit_slots(slots, from + 1, shared_ctx)
        printed += head.join() ?? panic(compiler_threads_failure_text(err))
    }
    printed
}

// One thread: prints its slot's rows first-first, in place, on its own copy
// of the shared context, which starts with no failure so the slot reports
// only its own. The lines are held last-first, so draining pops them in
// program order.
fn jet_rust_emit_slot(slot: Shared<JetRustEmitSlot>, shared_ctx: Shared<JetRustEmitContext>) -> Int {
    // copy: each emit worker edits its own context (failure, kept failures, caches), while the
    // shared context behind the read guard stays intact for every other worker.
    worker := shared_ctx.guard_read().value.copy()
    worker.failure = None
    worker.kept_failures = [JetRustEmitKeptFailure]{}
    permit :: slot.guard_edit()
    printed := [[String]]{}
    index := permit.value.functions.len()
    loop index > 0 {
        index -= 1
        if permit.value.prints[index] -> &printed.push(jet_rust_emit_function(&worker, permit.value.functions[index]))
    }
    count :: printed.len()
    loop printed.len() > 0 {
        lines :: &printed.pop() ?? break
        &permit.value.texts.push(lines)
    }
    permit.value.failure = worker.failure
    permit.value.kept_failures = worker.kept_failures
    count
}
