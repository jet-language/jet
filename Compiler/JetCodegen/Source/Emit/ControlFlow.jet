// CFG emission. Keeping MIR blocks explicit makes phi predecessors and checked
// edge targets visible in the generated artifact; a reducible CFG is emitted as
// structured Rust so the borrow checker sees MIR's real paths.
use jet_foundation.[
    MIRAccess,
    MIRBlockID,
    MIRDropEdge,
    MIRFieldID,
    MIRFunction,
    MIRHandleLifecycle,
    MIRHandleOwnership,
    MIRInstruction,
    MIRPanicLoc,
    MIRPhiIncoming,
    MIRPlaceBase,
    MIRPlaceID,
    MIRSourceFile,
    MIRTerminator,
    MIRType,
    MIRTypeID,
    MIRValueID,
    Span,
    mir_operation_value_uses,
    mir_terminator_targets,
    mir_terminator_value_uses,
    mir_type_canonical_key,
    mir_type_is_unit,
    MIRBinaryOp,
    MIRIndexKind,
    MIRLocalID,
    MIRProjection,
    MIRScopeKind,
    MIRTypeKind,
]

fn jet_rust_emit_block_id(block: MIRBlockID) -> String Never! { "{block.value}" }

fn jet_rust_emit_store_result(result: MIRValueID?, expression: String) -> String Never! {
    if result == .Val(slot) -> "{jet_rust_emit_value_slot(slot)} = Some({expression});" else -> "{expression};"
}

// MIRRust persist_value_update: under the local devtools rail, every write to a
// persistent place reports its new value (rendered only for scalar text forms).
fn jet_rust_emit_persist_renderable_type(ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .Int | .Float | .Bool | .String | .Char | .IntN(_, _) | .Float32 | .Measure(_) -> return true
        .InlineRange(base, _, _) | .Tagged(_, base) | .Quantity(base, _) -> return jet_rust_emit_persist_renderable_type(base)
        else -> return false
    }
}

fn jet_rust_emit_persist_value_update(ctx: &JetRustEmitContext, function: MIRFunction, id: MIRPlaceID) -> String? {
    if !ctx.config.local_rail -> return None
    loop place in function.places {
        if place.id == id {
            key :: place.persist_key ?? return None
            rendered :: if jet_rust_emit_persist_renderable_type(place.ty) -> "Some(&({jet_rust_emit_place_read(&ctx, function, id)}).jet_show())" else -> "None"
            return Val("{ctx.config.root_prefix}jet_observe_live_value_update({jet_rust_emit_quote(key)}, {jet_rust_emit_quote(mir_type_canonical_key(place.ty))}, {rendered})")
        }
    }
    None
}

fn jet_rust_emit_instruction_location(ctx: &JetRustEmitContext, function: MIRFunction, instruction: MIRInstruction) -> MIRPanicLoc Never! {
    line := 0
    if instruction.source_line == {
        .Val(source_line) -> {
        line = source_line
        }
        else -> {
        if jet_rust_emit_source_row(ctx, function.source_file) == {
            .Val(row) -> {
            line = jet_codegen_line_of(ctx.source_index.rows[row].line_starts, instruction.span.start)
            }
            else -> {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR source file row is missing", "checked panic locations must resolve through the function source-file identity", Val(function.span))
            }
        }
    }
    }
    MIRPanicLoc{file: function.source_file, line: line, column: 0}
}

// Rust: none (Jet-only pass)
fn jet_rust_emit_is_unit_ratio_parameter(ctx: &JetRustEmitContext, function: MIRFunction, value: MIRValueID) -> Bool Never! {
    if ctx.unit_ratio_function != Val(function.id) {
        allowed_at := [U64:Int]{}
        candidate_values := [MIRValueID]{}
        blocked := [U64:Bool]{}
        ordinal := 0
        loop block in function.blocks {
            loop instruction in block.instructions {
                // A value in the first four parameters is allowed even when
                // another operand of this same instruction repeats that value.
                if instruction.operation == {
                    .Convert(_, parameters, _, conversion) -> {
                        if conversion == {
                            .Prelude(call, _, _) -> {
                                if ctx.prelude_call_last.get(call.value) == .Val(position) {
                                    if ctx.program.prelude_calls[position].member.starts_with("conversion_") {
                                        loop index in 0..<parameters.len() {
                                            if index >= 4 -> break
                                            parameter :: parameters[index]
                                            if allowed_at.get(parameter.value) == None -> &candidate_values.push(parameter)
                                            &allowed_at.add(parameter.value, ordinal).drop("the latest allowed instruction replaces the prior one")
                                        }
                                    }
                                }
                            }
                            else -> {}
                        }
                    }
                    else -> {}
                }
                loop used in mir_operation_value_uses(instruction.operation) {
                    if allowed_at.get(used.value) != Val(ordinal) -> &blocked.add(used.value, true).drop("disallowed uses are idempotent")
                }
                ordinal += 1
            }
            // A terminator reads the slot too (`Return(v)`), so its uses are
            // never ratio-only.
            loop used in mir_terminator_value_uses(block.terminator) -> &blocked.add(used.value, true).drop("disallowed uses are idempotent")
        }
        ratio_parameters := [U64:Bool]{}
        loop candidate in candidate_values {
            if blocked.get(candidate.value) == None -> &ratio_parameters.add(candidate.value, true).drop("candidate values are unique")
        }
        ctx.unit_ratio_parameters = ratio_parameters
        ctx.unit_ratio_function = Val(function.id)
    }
    ctx.unit_ratio_parameters.get(value.value) ?? false
}

fn jet_rust_emit_instruction(ctx: &JetRustEmitContext, function: MIRFunction, instruction: MIRInstruction) -> [String] Never! {
    lines := [String]{}
    if instruction.result == .Val(value) {
        if jet_rust_emit_partial_drop_value(&ctx, function, value) != None -> return lines
        if jet_rust_emit_uninit_fixed_drop_value(ctx, function, value) != None -> return lines
        // MIRRust emit_instruction: a reference binding's move into a drop
        // copies nothing, and the read it binds is borrowed by its write.
        if jet_rust_emit_ref_binding_drop(&ctx, function, value) != None -> return lines
        if jet_rust_emit_nonowning_drop_value(&ctx, function, value) || jet_rust_emit_unused_place_read(&ctx, function, value) -> return lines
        if ctx.ref_bindings.payloads.get(value.value) != None || ctx.ref_bindings.collections.get(value.value) != None -> return lines
        // MIRRust emit_instruction (#4566 slices 5 and 6): a split whose
        // only consumer, a join, splits and joins the source in place; an
        // inlined adapter callback is built at its adapter; a fused adapter
        // runs inside its consumer; a views split loop reads its operands
        // at the loop cursor.
        if jet_rust_emit_fused_split_join(ctx, function, value).len() == 2 -> return lines
        if jet_rust_emit_inline_callback(ctx, function, value) != None || jet_rust_emit_fused_adapter_receiver(ctx, function, value) || jet_rust_emit_split_loop_collection(ctx, function, value) -> return lines
        if jet_rust_emit_partial_projection_only(&ctx, function, value) -> return lines
        if jet_rust_emit_inspected_only(&ctx, function, value) -> return lines
        // MIRRust direct_borrow_projection: a shared-guard deref or guard
        // field that only feeds borrows is never copied out of the guard.
        if jet_rust_emit_shared_guard_projection_only(&ctx, function, value) -> return lines
        // MIRRust emit_instruction: a Parameter/Capture result names its
        // retained place; an unread binding stores no entry copy.
        if jet_rust_emit_unread_binding(&ctx, function, instruction, value) -> return lines
        // MIRRust emit_instruction (#4566): the read and concatenation of an
        // in-place append, or a static literal its consumer spells in place.
        if jet_rust_emit_string_append_part(ctx, value) -> return lines
    }
    // MIRRust: a HostBorrowCallback is a one-use boundary adapter its consuming
    // call inlines; an ordinary owned callable slot would erase the borrowed ABI.
    if jet_rust_emit_is_host_borrow_callback(instruction) -> return lines
    if instruction.operation == {
        .Constant(constant) -> {
            if constant == {
                .String(_) -> {
                    if instruction.result == .Val(value) {
                        if jet_rust_emit_is_unit_ratio_parameter(&ctx, function, value) -> return lines
                    }
                }
                else -> {}
            }
        }
        else -> {}
    }
    if instruction.operation == {
        .WritePlace(place, value) | .ReplacePlace(place, value) -> {
            // MIRRust emit_instruction (#4566): `place += text` grows the
            // place's own buffer, and `place = ""` empties it in place.
            if instruction.operation == .WritePlace(_, _) {
                if ctx.move_facts.clears.get("{value.value}") != None {
                    row :: jet_rust_emit_append_place_row(ctx, function, place) ?? panic("checked string clear place is missing")
                    &lines.push("({jet_rust_emit_place_base(&ctx, function, row.base, true, row.projections)}).clear();")
                    return lines
                }
            }
            if instruction.operation == .WritePlace(_, _) {
                if ctx.move_facts.appends.get("{value.value}") == .Val(append) {
                    row :: jet_rust_emit_append_place_row(ctx, function, append.place) ?? panic("checked string append place is missing")
                    &lines.push("({jet_rust_emit_place_base(&ctx, function, row.base, true, row.projections)}).push_str({jet_rust_emit_string_add_operand(ctx, append.text)});")
                    return lines
                }
            }
            // MIRRust emit_instruction: a reference binding borrows the read
            // it binds in place.
            if ctx.ref_bindings.payloads.get(value.value) != None {
                loop row in function.places {
                    if row.id == place && row.base == .Local(local) -> &lines.push("{jet_rust_emit_local_slot(local)} = Some({jet_rust_emit_ref_payload_reference(&ctx, function, value)});")
                }
                return lines
            }
            transferred :: jet_rust_emit_value_transfer(ctx, function, value)
            &lines.push("{jet_rust_emit_place_write(&ctx, function, place, Val(value), transferred)};")
            if jet_rust_emit_persist_value_update(&ctx, function, place) == .Val(update) -> &lines.push("{update};")
            return lines
        }
        // MIRRust: a read of a shared constant holds the shared value; its
        // readers borrow it in place (`JetSharedSlot`).
        .Global(name) -> {
            if instruction.result == .Val(value) {
                if jet_rust_emit_shared_constant_accessor(&ctx, name) == .Val(accessor) {
                    &lines.push("{jet_rust_emit_value_slot(value)} = {accessor};")
                    return lines
                }
            }
        }
        .InitializeUninit(place) -> {
            loop row in function.places {
                if row.id == place && row.projections.len() == 0 {
                    if row.base == {
                        .Local(local) -> {
                            // MIRRust initialize_uninit_expression: a split
                            // root drops its whole value and every field slot.
                            if {
                                jet_rust_emit_partial_root_has(ctx, function, row.base) -> {
                                owner :: jet_rust_emit_partial_node_owner(&ctx, function, row.base, [MIRFieldID]{}) ?? MIRTypeID{value: 0}
                                &lines.push("{{ drop({jet_rust_emit_partial_root_slot(row.base)}.take()); {jet_rust_emit_partial_clear(&ctx, function, row.base, [MIRFieldID]{}, owner)}}};")
                                }
                                jet_rust_emit_local_uninit_fixed_type(function, local) != None -> {
                                &lines.push("{jet_rust_emit_local_slot(local)} = Some({ctx.config.root_prefix}jet_mem::JetUninitFixed::new());")
                                }
                                else -> {
                                &lines.push("{jet_rust_emit_local_storage(&ctx, local)} = None;")
                                }
                            }
                        }
                        .Temporary(value) -> &lines.push("{jet_rust_emit_value_slot(value)} = None;")
                        else -> &lines.push("{jet_rust_emit_place_lvalue(&ctx, function, place)} = Default::default();")
                    }
                }
            }
            return lines
        }
        else -> {}
    }
    location :: jet_rust_emit_instruction_location(&ctx, function, instruction)
    expression :: jet_rust_emit_operation(&ctx, function, instruction.operation, instruction.result, Val(location))
    // MIRRust emit_instruction: a result that is a split-storage root is
    // written whole through its partial node, clearing every field slot.
    if instruction.result == .Val(result) {
        if jet_rust_emit_partial_root_has(ctx, function, MIRPlaceBase.Temporary{value: result}) {
            owner :: jet_rust_emit_partial_node_owner(&ctx, function, MIRPlaceBase.Temporary{value: result}, [MIRFieldID]{}) ?? MIRTypeID{value: 0}
            &lines.push("{jet_rust_emit_partial_write(&ctx, function, MIRPlaceBase.Temporary{value: result}, [MIRFieldID]{}, owner, [MIRFieldID]{}, expression)};")
            return lines
        }
    }
    &lines.push(jet_rust_emit_store_result(instruction.result, expression))
    lines
}

// Structured emission plan (Ramsey, "Beyond Relooper", JFP 2022). Rust's
// borrow checker reasons about the emitted control flow, not MIR's: in one
// dispatch loop any block may follow any block, so a view value read in one
// block conflicts with a later rebind or drop of its base local in another
// (E0502/E0506), although MIR never takes that path. When every retreating
// edge targets a block that dominates its source (a reducible CFG, which every
// checked Jet body is), each reachable block is emitted once, nested by the
// dominator tree: a loop header opens a labeled `loop`, a merge block (two or
// more forward in-edges) follows a labeled block its predecessors `break` out
// of, any other block is emitted in place at its only forward edge, and a back
// edge is `continue` of its header's loop. Any other CFG keeps the dispatch
// loop.
struct JetRustEmitCFGPlan {
    structured: Bool
    phis: Bool
    // Block id value -> true when the block's phi reads the predecessor.
    phi_targets: [U64:Bool]
    entry: Int
    // MIR block id value -> position in `function.blocks`.
    positions: [U64:Int]
    // Reverse postorder number per position; -1 for an unreachable block.
    order: [Int]
    headers: [Bool]
    merges: [Bool]
    // The merge blocks each position immediately dominates, latest first.
    follows: [[Int]]
    debug: [Bool]
}

fn jet_rust_emit_cfg_reverse_postorder(successors: [[Int]], entry: Int) -> [Int] Never! {
    visited := [Bool]{}
    loop _ in successors -> &visited.push(false)
    postorder := [Int]{}
    stack := [Int]{entry}
    cursors := [Int]{0}
    visited[entry] = true
    loop stack.len() > 0 {
        top :: stack.len() - 1
        node :: stack[top].copy()
        next_edge :: cursors[top].copy()
        if next_edge < successors[node].len() {
            cursors[top] = next_edge + 1
            child :: successors[node][next_edge]
            if !visited[child] {
                visited[child] = true
                &stack.push(child)
                &cursors.push(0)
            }
        } else {
            &postorder.push(node)
            _ := &stack.pop()
            _ := &cursors.pop()
        }
    }
    order := [Int]{}
    index := postorder.len() - 1
    loop index >= 0 {
        &order.push(postorder[index])
        index -= 1
    }
    order
}

// Cooper, Harvey and Kennedy, "A Simple, Fast Dominance Algorithm".
fn jet_rust_emit_cfg_intersect(idom: [Int], order: [Int], left: Int, right: Int) -> Int Never! {
    a := left
    b := right
    loop a != b {
        loop order[a] > order[b] -> a = idom[a]
        loop order[b] > order[a] -> b = idom[b]
    }
    a
}

fn jet_rust_emit_cfg_dominates(idom: [Int], entry: Int, dominator: Int, block: Int) -> Bool Never! {
    current := block
    loop current != dominator {
        if current == entry -> return false
        current = idom[current]
    }
    true
}

// MIRRust phi_is_trivial: a phi whose every incoming row carries one value
// does not read the predecessor.
fn jet_rust_emit_phi_is_trivial(incoming: [MIRPhiIncoming]) -> Bool Never! {
    loop row in incoming {
        if row.value != incoming[0].value -> return false
    }
    incoming.len() > 0
}

fn jet_rust_emit_phi_targets(function: MIRFunction) -> [U64:Bool] Never! {
    targets := [U64:Bool]{}
    loop block in function.blocks {
        loop instruction in block.instructions {
            if instruction.operation == {
                .Phi(incoming) -> {
                    if !jet_rust_emit_phi_is_trivial(incoming) && targets.get(block.id.value) == None -> &targets.add(block.id.value, true).drop("each block is recorded once")
                }
                else -> {}
            }
        }
    }
    targets
}

fn jet_rust_emit_cfg_plan(function: MIRFunction) -> JetRustEmitCFGPlan Never! {
    positions := [U64:Int]{}
    loop (position, block) in function.blocks -> &positions.add(block.id.value, position).drop("checked MIR block ids are unique")
    entry :: positions.get(function.entry.value) ?? -1
    states :: jet_rust_emit_debug_only_block_states(function, positions)
    structured := entry >= 0
    successors := [[Int]]{}
    predecessors := [[Int]]{}
    order := [Int]{}
    idom := [Int]{}
    forward := [Int]{}
    headers := [Bool]{}
    merges := [Bool]{}
    follows := [[Int]]{}
    debug := [Bool]{}
    loop block in function.blocks {
        row := [Int]{}
        loop target in mir_terminator_targets(block.terminator) {
            position :: positions.get(target.value) ?? -1
            if position < 0 -> structured = false
            &row.push(position)
        }
        &successors.push(row)
        &predecessors.push([Int]{})
        &order.push(-1)
        &idom.push(-1)
        &forward.push(0)
        &headers.push(false)
        &merges.push(false)
        &follows.push([Int]{})
        &debug.push(states.get(block.id.value) ?? false)
    }
    if structured {
        rpo :: jet_rust_emit_cfg_reverse_postorder(successors, entry)
        loop (number, position) in rpo -> order[position] = number
        loop position in rpo {
            loop target in successors[position] -> &predecessors[target].push(position)
        }
        idom[entry] = entry
        changed := true
        loop changed {
            changed = false
            loop position in rpo {
                if position == entry -> next
                candidate := -1
                loop predecessor in predecessors[position] {
                    if idom[predecessor] < 0 -> next
                    candidate = if candidate < 0 -> predecessor else -> jet_rust_emit_cfg_intersect(idom, order, predecessor, candidate)
                }
                if idom[position] != candidate {
                    idom[position] = candidate
                    changed = true
                }
            }
        }
        loop position in rpo {
            loop target in successors[position] {
                if order[target] <= order[position] {
                    if !jet_rust_emit_cfg_dominates(idom, entry, target, position) -> structured = false
                    headers[target] = true
                } else {
                    forward[target] = forward[target] + 1
                }
            }
        }
        // Latest first: the outermost labeled block closes before the merge
        // block that comes last in reverse postorder.
        index := rpo.len() - 1
        loop index > 0 {
            position :: rpo[index]
            if forward[position] >= 2 {
                merges[position] = true
                &follows[idom[position]].push(position)
            }
            index -= 1
        }
    }
    phi_targets :: jet_rust_emit_phi_targets(function)
    JetRustEmitCFGPlan{structured: structured, phis: phi_targets.len() > 0, phi_targets: phi_targets, entry: entry, positions: positions, order: order, headers: headers, merges: merges, follows: follows, debug: debug}
}

// One unit of body emission. Blocks, dominator subtrees and edges expand into
// more items on an explicit stack, so a deep MIR body (a long `if` chain, a
// match with hundreds of arms) never deepens the emitter's call stack.
enum JetRustEmitCFGItem {
    Line(text: String)
    Block(position: Int, indent: String)
    Tree(position: Int, indent: String)
    Within(position: Int, follow: Int, indent: String)
    Edge(source: MIRBlockID, target: MIRBlockID, indent: String)
}

fn jet_rust_emit_cfg_line(text: String) -> JetRustEmitCFGItem Never! { JetRustEmitCFGItem.Line{text: text} }

fn jet_rust_emit_cfg_edge(source: MIRBlockID, target: MIRBlockID, indent: String) -> JetRustEmitCFGItem Never! {
    JetRustEmitCFGItem.Edge{source: source, target: target, indent: indent}
}

// MIRRust MAX_STRUCTURED_INDENT: rustc's recursive passes overflow their stack
// on a few thousand nested blocks, so a deeper body keeps the dispatch loop.
JET_RUST_EMIT_MAX_STRUCTURED_INDENT :: 1024

// Whether the edge prints its target subtree in place (structured bodies only):
// neither a loop back edge nor a break to a merge block.
fn jet_rust_emit_cfg_edge_inlines(plan: JetRustEmitCFGPlan, source: MIRBlockID, target: MIRBlockID) -> Bool Never! {
    if !plan.structured -> return false
    source_position :: plan.positions.get(source.value) ?? return false
    target_position :: plan.positions.get(target.value) ?? return false
    plan.order[target_position] > plan.order[source_position] && !plan.merges[target_position]
}

// The local `place` names whole, if any.
fn jet_rust_emit_int_sum_walk_local(function: MIRFunction, index: JetRustEmitBodyIndex, place: MIRPlaceID) -> MIRLocalID? Never! {
    row :: index.place_rows.get(place.value) ?? return None
    if function.places[row].projections.len() > 0 -> return None
    if function.places[row].base == .Local(local) -> return Val(local)
    None
}

// MIRRust int_sum_walk (#4566): the native sum `jet_int_sum_walk(cursor, acc,
// xs)` printed just before the loop the block at `position` heads, when that
// loop is the exact Int range walk `loop i in a..<b { acc = acc + xs[i] }`
// over an unchanged list: the header only tests the range cursor, one body
// block reads the element and adds it to a whole exact Int local, and one
// latch only advances the cursor. The helper commits the exact sum of a prefix
// of the walk and moves the cursor past it, so the loop runs only the rest.
// The loop's index local and values live in the body alone, so skipping
// iterations changes nothing else.
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::int_sum_walk
fn jet_rust_emit_int_sum_walk(ctx: &JetRustEmitContext, function: MIRFunction, position: Int) -> String? Never! {
    index :: ctx.body_index
    header :: function.blocks[position]
    if header.instructions.len() != 1 || position >= index.predecessors.len() || index.predecessors[position].len() != 2 -> return None
    test :: header.instructions[0]
    cursor := MIRValueID?{None}
    if test.operation == .LoopRangeHasNext(_, tested) -> cursor = Val(tested)
    walked_cursor :: cursor ?? return None
    body_id := MIRBlockID?{None}
    if header.terminator == .Branch(condition, then_target, _) {
        if test.result == (Val(condition)) -> body_id = Val(then_target)
    }
    body_target :: body_id ?? return None
    body_position :: index.block_positions.get(body_target.value) ?? return None
    body :: function.blocks[body_position]
    latch_id := MIRBlockID?{None}
    if body.terminator == .Jump(target) -> latch_id = Val(target)
    latch_target :: latch_id ?? return None
    latch_position :: index.block_positions.get(latch_target.value) ?? return None
    latch :: function.blocks[latch_position]
    if latch.instructions.len() != 1 -> return None
    advances := false
    if latch.instructions[0].operation == .LoopRangeAdvance(_, advanced) -> advances = advanced == walked_cursor
    back := false
    if latch.terminator == .Jump(target) -> back = target == header.id
    if !advances || !back -> return None
    if index.predecessors[body_position].len() != 1 || index.predecessors[body_position][0] != position -> return None
    if index.predecessors[latch_position].len() != 1 || index.predecessors[latch_position][0] != body_position -> return None
    if index.predecessors[position][0] != latch_position && index.predecessors[position][1] != latch_position -> return None
    // The body: the cursor value, optionally kept in the index local and read
    // back, the reads of `acc` and `xs[index]`, their sum, and the write of
    // `acc`, in any order the lowering chose.
    value := MIRValueID?{None}
    read_values := [MIRValueID]{}
    read_places := [MIRPlaceID]{}
    sum := MIRValueID?{None}
    sum_left := MIRValueID?{None}
    sum_right := MIRValueID?{None}
    write_places := [MIRPlaceID]{}
    write_values := [MIRValueID]{}
    loop instruction in body.instructions {
        if instruction.operation == {
            .LoopRangeValue(_, read) -> {
                result :: instruction.result ?? return None
                if read != walked_cursor || value != None -> return None
                value = Val(result)
            }
            .ReadPlace(place) -> {
                result :: instruction.result ?? return None
                &read_values.push(result)
                &read_places.push(place)
            }
            .Binary(op, _, _, left, right) -> {
                result :: instruction.result ?? return None
                if op != MIRBinaryOp.Add || sum != None -> return None
                sum = Val(result)
                sum_left = Val(left)
                sum_right = Val(right)
            }
            .WritePlace(place, written) -> {
                &write_places.push(place)
                &write_values.push(written)
            }
            else -> return None
        }
    }
    cursor_value :: value ?? return None
    total :: sum ?? return None
    left :: sum_left ?? return None
    right :: sum_right ?? return None
    index_local := MIRLocalID?{None}
    acc_place := MIRPlaceID?{None}
    loop at in 0..<write_places.len() {
        local :: jet_rust_emit_int_sum_walk_local(function, index, write_places[at]) ?? return None
        if write_values[at] == cursor_value && index_local == None {
            index_local = Val(local)
        } else if write_values[at] == total && acc_place == None {
            acc_place = Val(write_places[at])
        } else {
            return None
        }
    }
    acc :: acc_place ?? return None
    acc_local :: jet_rust_emit_int_sum_walk_local(function, index, acc) ?? return None
    index_read := MIRValueID?{None}
    acc_read := MIRValueID?{None}
    element := MIRValueID?{None}
    element_place := MIRPlaceID?{None}
    loop at in 0..<read_places.len() {
        local :: jet_rust_emit_int_sum_walk_local(function, index, read_places[at])
        if local != None && local == index_local && index_read == None {
            index_read = Val(read_values[at])
        } else if local == (Val(acc_local)) && acc_read == None {
            acc_read = Val(read_values[at])
        } else if element == None {
            element = Val(read_values[at])
            element_place = Val(read_places[at])
        } else {
            return None
        }
    }
    accumulated :: acc_read ?? return None
    read_element :: element ?? return None
    read_place :: element_place ?? return None
    if !(left == accumulated && right == read_element) && !(left == read_element && right == accumulated) -> return None
    // The index is the cursor value, directly or through the index local.
    walked := cursor_value
    if index_local != None {
        walked = index_read ?? return None
    } else if index_read != None {
        return None
    }
    row_position :: index.place_rows.get(read_place.value) ?? return None
    row :: function.places[row_position]
    acc_position :: index.place_rows.get(acc.value) ?? return None
    acc_row :: function.places[acc_position]
    if row.projections.len() == 0 -> return None
    indexed := false
    if row.projections[row.projections.len() - 1] == .Index(kind, at, _, _, _, _, _) -> indexed = (kind == MIRIndexKind.List || kind == MIRIndexKind.FixedListProof) && at == walked
    if !indexed || row.ty.kind != MIRTypeKind.Int || acc_row.ty.kind != MIRTypeKind.Int -> return None
    based := false
    if row.base == {
        .Local(local) -> based = local != acc_local
        .Parameter(_) -> based = true
        else -> {}
    }
    if !based -> return None
    prefix := [MIRProjection]{}
    loop at in 0..<row.projections.len() - 1 {
        if row.projections[at] == {
            .Field(_, _) | .Deref(_) -> &prefix.push(row.projections[at])
            else -> return None
        }
    }
    if ctx.ref_bindings.locals.get(acc_local.value) != None -> return None
    // Every body value feeds the next body instruction only.
    accumulated_slot :: index.use_slots.get(accumulated.value) ?? return None
    element_slot :: index.use_slots.get(read_element.value) ?? return None
    total_slot :: index.use_slots.get(total.value) ?? return None
    if index.uses[accumulated_slot].len() != 1 || index.uses[element_slot].len() != 1 || index.uses[total_slot].len() != 1 -> return None
    // The cursor value and the index read are used in the body alone.
    confined := [MIRValueID]{cursor_value}
    if index_read == .Val(read) -> &confined.push(read)
    loop confined_value in confined {
        slot :: index.use_slots.get(confined_value.value) ?? next
        loop user in index.uses[slot] {
            if user.block != body_position -> return None
        }
    }
    // The index local is written and read in the body alone, so the
    // iterations the helper skips leave nothing observable in it.
    if index_local == .Val(walked_local) {
        if index.escaped_locals.get(walked_local.value) != None -> return None
        write_slot :: index.write_slots.get(walked_local.value) ?? -1
        if write_slot >= 0 {
            loop write in index.local_writes[write_slot] {
                if write.block != body_position -> return None
            }
        }
        loop block_position in 0..<function.blocks.len() {
            if block_position == body_position -> next
            loop instruction in function.blocks[block_position].instructions {
                named := MIRPlaceID?{None}
                if instruction.operation == {
                    .ReadPlace(place) | .MovePlace(place) | .WritePlace(place, _) | .ReplacePlace(place, _) | .AddressOf(place, _) | .RawAddressOf(place) -> named = Val(place)
                    else -> {}
                }
                place_id :: named ?? next
                place_row :: index.place_rows.get(place_id.value) ?? next
                if function.places[place_row].base == (MIRPlaceBase.Local{local: walked_local}) -> return None
            }
        }
    }
    cursor_text :: jet_rust_emit_value_reference(ctx, walked_cursor, true)
    acc_text :: jet_rust_emit_place_base(&ctx, function, acc_row.base, true, [MIRProjection]{})
    list_text :: jet_rust_emit_place_base(&ctx, function, row.base, false, prefix)
    Val("{ctx.config.root_prefix}jet_int_sum_walk({cursor_text}, &mut ({acc_text}), &({list_text})[..])")
}

// Expands `start` depth-first into Rust lines. A Tree is one dominator
// subtree: the block, the merge blocks it immediately dominates (Within), and
// for a loop header the loop around them. An Edge is the control transfer:
// the predecessor write a non-trivial target phi reads, then `continue` of a
// loop header, `break` out of a merge block's labeled block, or the target's
// subtree in place. Returns false once a subtree would nest deeper than
// JET_RUST_EMIT_MAX_STRUCTURED_INDENT.
fn jet_rust_emit_cfg_run(ctx: &JetRustEmitContext, function: MIRFunction, plan: JetRustEmitCFGPlan, start: JetRustEmitCFGItem, lines: &[String]) -> Bool Never! {
    pending := [JetRustEmitCFGItem]{start}
    loop pending.len() > 0 {
        item :: &pending.pop() ?? return true
        expanded := [JetRustEmitCFGItem]{}
        if item == {
            .Line(text) -> &lines.push(text)
            .Block(position, indent) -> jet_rust_emit_block(&ctx, function, plan, position, indent, &expanded)
            .Tree(position, indent) -> {
                if indent.len() > JET_RUST_EMIT_MAX_STRUCTURED_INDENT -> return false
                if plan.headers[position] {
                    if jet_rust_emit_int_sum_walk(&ctx, function, position) == .Val(walk) -> &expanded.push(jet_rust_emit_cfg_line("{indent}{walk};"))
                    &expanded.push(jet_rust_emit_cfg_line("{indent}'jet_loop_{function.blocks[position].id.value}: loop {{"))
                    &expanded.push(JetRustEmitCFGItem.Within{position: position, follow: 0, indent: "{indent}    "})
                    &expanded.push(jet_rust_emit_cfg_line("{indent}}}"))
                } else {
                    &expanded.push(JetRustEmitCFGItem.Within{position: position, follow: 0, indent: indent})
                }
            }
            .Within(position, follow, indent) -> {
                if follow >= plan.follows[position].len() {
                    &expanded.push(JetRustEmitCFGItem.Block{position: position, indent: indent})
                } else {
                    merge :: plan.follows[position][follow]
                    &expanded.push(jet_rust_emit_cfg_line("{indent}'jet_block_{function.blocks[merge].id.value}: {{"))
                    &expanded.push(JetRustEmitCFGItem.Within{position: position, follow: follow + 1, indent: "{indent}    "})
                    &expanded.push(jet_rust_emit_cfg_line("{indent}}}"))
                    &expanded.push(JetRustEmitCFGItem.Tree{position: merge, indent: indent})
                }
            }
            .Edge(source, target, indent) -> {
                if plan.phi_targets.get(target.value) ?? false -> &expanded.push(jet_rust_emit_cfg_line("{indent}__jet_mir_dispatch_prev = {jet_rust_emit_block_id(source)};"))
                if plan.structured {
                    source_position :: plan.positions.get(source.value) ?? plan.entry
                    target_position :: plan.positions.get(target.value) ?? plan.entry
                    if {
                        plan.order[target_position] <= plan.order[source_position] -> &expanded.push(jet_rust_emit_cfg_line("{indent}continue 'jet_loop_{target.value};"))
                        plan.merges[target_position] -> &expanded.push(jet_rust_emit_cfg_line("{indent}break 'jet_block_{target.value};"))
                        else -> &expanded.push(JetRustEmitCFGItem.Tree{position: target_position, indent: indent})
                    }
                } else {
                    &expanded.push(jet_rust_emit_cfg_line("{indent}__jet_mir_dispatch_pc = {jet_rust_emit_block_id(target)};"))
                    &expanded.push(jet_rust_emit_cfg_line("{indent}continue 'mir_dispatch;"))
                }
            }
        }
        index := expanded.len() - 1
        loop index >= 0 {
            &pending.push(expanded[index])
            index -= 1
        }
    }
    true
}

fn jet_rust_emit_return_expression(ctx: &JetRustEmitContext, function: MIRFunction, value: MIRValueID?) -> String Never! {
    if value == .Val(operand) -> return jet_rust_emit_value_move(ctx, operand)
    if mir_type_is_unit(function.return_type) -> return "()"
    if function.failure == {
        .Result(success, _) -> {
            if mir_type_is_unit(success) -> return "Ok(())"
        }
        else -> {}
    }
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidControlFlow, "E0003", "MIR non-unit Return has no value", "checked Return terminators need an operand unless the full return is Unit or the Result success type is Unit", Val(function.span))
    "unreachable!(\"missing MIR Return value\")"
}

fn jet_rust_emit_drop_edge_matches(action: MIRDropEdge, wanted: MIRDropEdge) -> Bool Never! {
    if action == {
        .Normal -> wanted == MIRDropEdge.Normal
        .Return -> wanted == MIRDropEdge.Return
        .Failure(left) -> {
            if wanted == {
                .Failure(right) -> left == right
                else -> false
            }
        }
        .Unwind(left) -> {
            if wanted == {
                .Unwind(right) -> left == right
                else -> false
            }
        }
    }
}

// MIRRust close_handle_drop: the foreign raw close takes precedence over a Jet
// close function when a lifecycle row carries both.
fn jet_rust_emit_handle_drop(ctx: &JetRustEmitContext, function: MIRFunction, moved: String, span: Span, handle: MIRHandleLifecycle) -> String Never! {
    if handle.ownership != MIRHandleOwnership.Owned -> return "{{ let _ = {moved}; () }}"
    if handle.close_foreign == .Val(foreign) {
        close :: jet_rust_emit_foreign_name(&ctx, foreign)
        return "{{ let __jet_handle = {moved}; unsafe {{ let _ = {close}(__jet_handle.into_raw()); }} () }}"
    }
    if handle.close == .Val(close_id) {
        close :: jet_rust_emit_function_name(&ctx, close_id)
        needs_unsafe := false
        if jet_rust_emit_function_index(ctx, close_id) == .Val(candidate_index) {
            if ctx.program.functions[candidate_index].id == close_id -> needs_unsafe = ctx.program.functions[candidate_index].is_unsafe
        }
        call :: if needs_unsafe -> "unsafe {{ {close}(__jet_handle) }}" else -> "{close}(__jet_handle)"
        return "{{ let __jet_handle = {moved}; let _ = {call}; () }}"
    }
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "owned foreign handle has no close adapter", "checked handle lifecycle rows must retain the canonical close operation required by MIR", Val(span))
    "unreachable!(\"foreign handle close adapter missing\")"
}

// MIRRust emit_drops: a handle closes its moved place; any other drop action
// drops a read of the place, so the owner's slot keeps its state.
fn jet_rust_emit_drop_place(ctx: &JetRustEmitContext, function: MIRFunction, place: MIRPlaceID, span: Span) -> String Never! {
    loop row in function.places {
        if row.id == place {
            if jet_rust_emit_is_nonowning_reference_type(row.ty) -> return "()"
            partial :: jet_rust_emit_partial_drop(&ctx, function, place)
            if partial == .Val(partial_drop) -> return partial_drop
            uninit_drop :: jet_rust_emit_uninit_fixed_drop_place(function, place)
            if uninit_drop == .Val(fixed_drop) -> return fixed_drop
            loop handle in ctx.program.handles {
                if jet_rust_emit_same_handle_type(handle.ty, row.ty) {
                    if row.access != MIRAccess.Move {
                        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidOwnership, "E0003", "MIR drop targets a non-owned place", "checked handle drop actions must use a move-access place", Val(span))
                        return "unreachable!(\"non-owned MIR drop\")"
                    }
                    moved :: jet_rust_emit_place_move(&ctx, function, place)
                    return jet_rust_emit_handle_drop(&ctx, function, moved, row.span, handle)
                }
            }
            return "drop({jet_rust_emit_place_read(&ctx, function, place)})"
        }
    }
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR drop targets a missing place", "checked drop actions must resolve to one function place row", Val(span))
    "unreachable!(\"missing MIR drop place\")"
}

// Each drop action is one statement (MIRRust writes `{expression};`); a
// reference binding owns nothing to release.
fn jet_rust_emit_drops(ctx: &JetRustEmitContext, function: MIRFunction, edge: MIRDropEdge) -> [String] Never! {
    lines := [String]{}
    loop action in function.drops {
        if !jet_rust_emit_drop_edge_matches(action.edge, edge) || jet_rust_emit_ref_binding_place(&ctx, function, action.place) -> next
        &lines.push("{jet_rust_emit_drop_place(&ctx, function, action.place, action.span)};")
    }
    lines
}

fn jet_rust_emit_ref_binding_place(ctx: &JetRustEmitContext, function: MIRFunction, place: MIRPlaceID) -> Bool Never! {
    if ctx.ref_bindings.locals.len() == 0 -> return false
    loop row in function.places {
        if row.id == place && row.base == .Local(local) -> return ctx.ref_bindings.locals.get(local.value) != None
    }
    false
}

// Every arm of an emitted branch ends in a control transfer, so the last arm
// follows the `if` instead of nesting in an `else`: an `if` chain or a long
// match stays flat in the Rust source. A branch whose then-subtree prints in
// place while its else edge does not is negated (MIRRust emit_terminator), so
// the subtree stays at this depth and only the short edge nests.
fn jet_rust_emit_terminator(ctx: &JetRustEmitContext, function: MIRFunction, plan: JetRustEmitCFGPlan, block_id: MIRBlockID, terminator: MIRTerminator, indent: String, items: &[JetRustEmitCFGItem]) Never! {
    if terminator == {
        .Jump(target) -> {
            loop line in jet_rust_emit_drops(&ctx, function, MIRDropEdge.Normal) -> &items.push(jet_rust_emit_cfg_line("{indent}{line}"))
            &items.push(jet_rust_emit_cfg_edge(block_id, target, indent))
        }
        .Branch(condition, then_target, else_target) -> {
            loop line in jet_rust_emit_drops(&ctx, function, MIRDropEdge.Normal) -> &items.push(jet_rust_emit_cfg_line("{indent}{line}"))
            coverage :: jet_rust_emit_coverage_for(&ctx, function)
            // MIRRust emit_terminator: a coverage branch keeps both arms in an
            // explicit if/else so each records its own branch hit.
            if coverage {
                &items.push(jet_rust_emit_cfg_line("{indent}if {jet_rust_emit_value_owned(ctx, function, condition)} {{"))
                &items.push(jet_rust_emit_cfg_line("{indent}    {jet_rust_emit_coverage_branch_line(&ctx, function, block_id, 0, true)}"))
                &items.push(jet_rust_emit_cfg_edge(block_id, then_target, "{indent}    "))
                &items.push(jet_rust_emit_cfg_line("{indent}}} else {{"))
                &items.push(jet_rust_emit_cfg_line("{indent}    {jet_rust_emit_coverage_branch_line(&ctx, function, block_id, 0, false)}"))
                &items.push(jet_rust_emit_cfg_edge(block_id, else_target, "{indent}    "))
                &items.push(jet_rust_emit_cfg_line("{indent}}}"))
                return
            }
            invert :: jet_rust_emit_cfg_edge_inlines(plan, block_id, then_target) && !jet_rust_emit_cfg_edge_inlines(plan, block_id, else_target)
            condition_text :: jet_rust_emit_value_owned(ctx, function, condition)
            nested :: if invert -> else_target else -> then_target
            follow :: if invert -> then_target else -> else_target
            head :: if invert -> "{indent}if !({condition_text}) {{" else -> "{indent}if {condition_text} {{"
            &items.push(jet_rust_emit_cfg_line(head))
            &items.push(jet_rust_emit_cfg_edge(block_id, nested, "{indent}    "))
            &items.push(jet_rust_emit_cfg_line("{indent}}}"))
            &items.push(jet_rust_emit_cfg_edge(block_id, follow, indent))
        }
        // Each arm condition is the checked Bool for that arm (MIRRust
        // emit_switch); the subject is carried for facts only.
        .Switch(_, arms, otherwise) -> {
            loop line in jet_rust_emit_drops(&ctx, function, MIRDropEdge.Normal) -> &items.push(jet_rust_emit_cfg_line("{indent}{line}"))
            if {
                arms.len() > 0 && jet_rust_emit_coverage_for(&ctx, function) -> jet_rust_emit_switch_coverage(&ctx, function, block_id, arms, otherwise, 0, indent, &items)
                else -> {
                    loop (index, arm) in arms {
                        prefix :: if index == 0 -> "if" else -> "else if"
                        &items.push(jet_rust_emit_cfg_line("{indent}{prefix} {jet_rust_emit_value_owned(ctx, function, arm.condition)} {{"))
                        &items.push(jet_rust_emit_cfg_edge(block_id, arm.target, "{indent}    "))
                        &items.push(jet_rust_emit_cfg_line("{indent}}}"))
                    }
                    &items.push(jet_rust_emit_cfg_edge(block_id, otherwise, indent))
                }
            }
        }
        .Return(value) -> {
            loop line in jet_rust_emit_drops(&ctx, function, MIRDropEdge.Return) -> &items.push(jet_rust_emit_cfg_line("{indent}{line}"))
            if {
                function.generator != None -> {
                if value != None -> jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidControlFlow, "E0003", "MIR generator return carries a value", "generator returns must terminate the stream without a value", Val(function.span))
                &items.push(jet_rust_emit_cfg_line("{indent}return;"))
                }
                else -> {
                &items.push(jet_rust_emit_cfg_line("{indent}return {jet_rust_emit_return_expression(&ctx, function, value)};"))
                }
            }
        }
        .Yield(value, resume) -> {
            loop line in jet_rust_emit_drops(&ctx, function, MIRDropEdge.Normal) -> &items.push(jet_rust_emit_cfg_line("{indent}{line}"))
            if {
                function.generator == None -> {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidControlFlow, "E0003", "MIR yield appears in a non-generator function", "the checked generator facts must accompany every Yield terminator", Val(function.span))
                &items.push(jet_rust_emit_cfg_line("{indent}unreachable!(\"invalid MIR yield\");"))
                }
                else -> {
                &items.push(jet_rust_emit_cfg_line("{indent}let _ = __jet_yield_tx.send_stream({jet_rust_emit_value_move(ctx, value)});"))
                &items.push(jet_rust_emit_cfg_edge(block_id, resume, indent))
                }
            }
        }
        .Break(target, value) -> {
            loop line in jet_rust_emit_drops(&ctx, function, MIRDropEdge.Normal) -> &items.push(jet_rust_emit_cfg_line("{indent}{line}"))
            if value == .Val(incoming_value) {
                feeds_phi := false
                if plan.positions.get(target.value) == .Val(target_position) {
                    loop instruction in function.blocks[target_position].instructions {
                        if instruction.operation == {
                            .Phi(incoming) -> {
                                loop row in incoming {
                                    if row.block == block_id && row.value == incoming_value -> feeds_phi = true
                                }
                            }
                            else -> {}
                        }
                    }
                }
                if !feeds_phi -> &items.push(jet_rust_emit_cfg_line("{indent}let _ = {jet_rust_emit_value_move(ctx, incoming_value)};"))
            }
            &items.push(jet_rust_emit_cfg_edge(block_id, target, indent))
        }
        .Continue(target) -> {
            loop line in jet_rust_emit_drops(&ctx, function, MIRDropEdge.Normal) -> &items.push(jet_rust_emit_cfg_line("{indent}{line}"))
            &items.push(jet_rust_emit_cfg_edge(block_id, target, indent))
        }
        .Unreachable(reason) -> &items.push(jet_rust_emit_cfg_line("{indent}unreachable!({jet_rust_emit_quote(reason)});"))
        // Stop points are produced only for the native execution host (MIR Stops.jet), after the optimizer.
        .Poll(_, _, _) | .Stopped -> jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidControlFlow, "E0003", "MIR stop point reached the Rust emitter", "stop points are produced only for native host compilations", None)
    }
}

// MIRRust debug_only_block_states: the debug-only scope ids are collected
// once, and each work item reads its block through `positions` rather than
// scanning the block list.
fn jet_rust_emit_debug_only_block_states(function: MIRFunction, positions: [U64:Int]) -> [U64:Bool] Never! {
    debug_scopes := [U64:Bool]{}
    loop scope in function.scopes {
        if scope.kind == MIRScopeKind.DebugOnly {
            _ := &debug_scopes.add(scope.id.value, true)
        }
    }
    states := [U64:Bool]{}
    &states.add(function.entry.value, false).drop("the entry block starts outside debug-only scopes")
    pending := [MIRBlockID]{function.entry}
    loop pending.len() > 0 {
        block_id :: &pending.pop() ?? function.entry
        position :: positions.get(block_id.value) ?? next
        block :: function.blocks[position]
        active := states.get(block_id.value) ?? false
        loop instruction in block.instructions {
            if instruction.operation == {
                .ScopeEnter(scope, _) -> {
                    if debug_scopes.get(scope.value) != None -> active = true
                }
                .ScopeExit(scope) -> {
                    if debug_scopes.get(scope.value) != None -> active = false
                }
                else -> {}
            }
        }
        loop target in mir_terminator_targets(block.terminator) {
            next_active :: active || (states.get(target.value) ?? false)
            prior :: states.get(target.value)
            if prior != Val(next_active) {
                &states.add(target.value, next_active).drop("the merged state replaces the prior block state")
                &pending.push(target)
            }
        }
    }
    states
}

// The canonical exit block is a join, never an early-return cleanup path.
fn jet_rust_emit_expected_scope_exits(ctx: &JetRustEmitContext, function: MIRFunction) -> [U64:U64] Never! {
    exits := [U64:U64]{}
    loop pass in 0..<2 {
        loop block in function.blocks {
            if pass == 0 {
                if block.terminator == { .Jump(_) -> {} else -> next }
            }
            loop instruction in block.instructions {
                if instruction.operation == .ScopeExit(scope) {
                    member :: jet_rust_emit_scope_member(ctx, function, scope)
                    if member == .Val(.ExpectFail(_, _)) && exits.get(scope.value) == None {
                        &exits.add(scope.value, block.id.value).drop("first canonical exit wins")
                    }
                }
            }
        }
    }
    exits
}

fn jet_rust_emit_block(ctx: &JetRustEmitContext, function: MIRFunction, plan: JetRustEmitCFGPlan, position: Int, indent: String, items: &[JetRustEmitCFGItem]) Never! {
    block :: function.blocks[position]
    active := plan.debug[position]
    expects_fail :: ctx.expected_test_exits.len() > 0
    if expects_fail -> &items.push(jet_rust_emit_cfg_line("{indent}let __jet_scope_step = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {{"))
    loop (index, instruction) in block.instructions {
        skip := false
        if instruction.operation == {
            .ScopeEnter(scope, _) -> {
                if jet_rust_emit_scope_is_debug_only(ctx, function, scope) {
                    active = true
                    skip = true
                }
            }
            .ScopeExit(scope) -> {
                if jet_rust_emit_scope_is_debug_only(ctx, function, scope) {
                    active = false
                    skip = true
                }
            }
            else -> {}
        }
        if skip -> next
        instruction_lines :: jet_rust_emit_instruction(&ctx, function, instruction)
        if {
            active && instruction_lines.len() > 0 -> {
            &items.push(jet_rust_emit_cfg_line("{indent}#[cfg(not(jet_release))]"))
            &items.push(jet_rust_emit_cfg_line("{indent}{{"))
            loop line in instruction_lines -> &items.push(jet_rust_emit_cfg_line("{indent}    {line}"))
            &items.push(jet_rust_emit_cfg_line("{indent}}}"))
            }
            else -> {
            loop line in instruction_lines -> &items.push(jet_rust_emit_cfg_line("{indent}{line}"))
            }
        }
        // MIRRust emit_block_instructions (#4566): loop capacity hints.
        if !active {
            loop line in jet_rust_emit_loop_reserves(&ctx, function, block.id, index) -> &items.push(jet_rust_emit_cfg_line("{indent}{line}"))
        }
    }
    if expects_fail {
        &items.push(jet_rust_emit_cfg_line("{indent}}}));"))
        &items.push(jet_rust_emit_cfg_line("{indent}if let Err(__jet_payload) = __jet_scope_step {{"))
        &items.push(jet_rust_emit_cfg_line("{indent}    if __jet_payload.is::<JetRenderedRuntimeStop>() {{"))
        &items.push(jet_rust_emit_cfg_line("{indent}        if let Some(__jet_scope) = {ctx.config.root_prefix}jet_test_expect_fail_stopped_scope() {{"))
        &items.push(jet_rust_emit_cfg_line("{indent}            match __jet_scope {{"))
        loop (scope, exit) in ctx.expected_test_exits {
            &items.push(jet_rust_emit_cfg_line("{indent}                {scope} => {{ {ctx.config.root_prefix}jet_test_expect_fail_catch_scope(); __jet_mir_dispatch_pc = {exit}; continue 'mir_dispatch; }},"))
        }
        &items.push(jet_rust_emit_cfg_line("{indent}                _ => std::panic::resume_unwind(__jet_payload),"))
        &items.push(jet_rust_emit_cfg_line("{indent}            }}"))
        &items.push(jet_rust_emit_cfg_line("{indent}        }} else {{ std::panic::resume_unwind(__jet_payload); }}"))
        &items.push(jet_rust_emit_cfg_line("{indent}    }} else {{ std::panic::resume_unwind(__jet_payload); }}"))
        &items.push(jet_rust_emit_cfg_line("{indent}}}"))
    }
    jet_rust_emit_terminator(&ctx, function, plan, block.id, block.terminator, indent, &items)
}
