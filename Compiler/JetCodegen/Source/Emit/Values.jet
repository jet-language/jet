// SSA values and MIR places. Ownership is represented by Option slots so a
// checked Move consumes exactly one slot; borrowed places remain references.
use jet_foundation.[
    MIRAccess,
    MIRBinaryOp,
    MIRCallArg,
    MIRCallee,
    MIRCopyFact,
    MIRDropKind,
    MIRField,
    MIRFieldID,
    MIRFunction,
    MIRFunctionSignature,
    MIRGenericParam,
    MIRIndexKind,
    MIRInstruction,
    MIRLocalID,
    MIRLoopSourceKind,
    MIROperation,
    MIRParam,
    MIRPayloadKind,
    MIRPlace,
    MIRPlaceBase,
    MIRPlaceID,
    MIRPreludeCallID,
    MIRProjection,
    MIRRuntimeLayer,
    MIRSourceFileID,
    MIRInternalTag,
    MIROwnershipMode,
    MIRTagMarker,
    MIRTupleField,
    MIRType,
    MIRTypeID,
    MIRTypeKind,
    MIRValueID,
    mir_measure_expression,
    mir_operation_place_uses,
    mir_operation_value_uses,
    mir_terminator_targets,
    mir_terminator_value_uses,
    mir_type_is_scalar,
    mir_type_from_kind,
    mir_type_id,
    mir_type_same_checked_type,
]

struct JetRustPartialValuePath {
    pub base: MIRPlaceBase
    pub fields: [MIRFieldID]
}

fn jet_rust_emit_value_slot(value: MIRValueID) -> String Never! { "__jet_v_{value.value}" }

fn jet_rust_emit_local_slot(local: MIRLocalID) -> String Never! { "__jet_l_{local.value}" }

fn jet_rust_emit_previous_slot() -> String Never! { "__jet_mir_dispatch_prev" }

fn jet_rust_emit_local_uninit_fixed_type(function: MIRFunction, local: MIRLocalID) -> MIRType? {
    loop row in function.locals {
        if row.id == local && row.uninit {
            if row.ty.kind == {
                .FixedList(_, _) -> return Val(row.ty)
                else -> return None
            }
        }
    }
    None
}

fn jet_rust_emit_uninit_fixed_storage_type(ctx: &JetRustEmitContext, ty: MIRType) -> String? {
    if ty.kind == {
        .FixedList(elem, len) -> Val("{ctx.config.root_prefix}jet_mem::JetUninitFixed<{jet_rust_emit_type(&ctx, elem)}, {mir_measure_expression(len)}>")
        else -> None
    }
}

fn jet_rust_emit_uninit_fixed_place_local(function: MIRFunction, place: MIRPlaceID) -> MIRLocalID? {
    loop row in function.places {
        if row.id == place && row.projections.len() == 0 {
            if row.base == {
                .Local(local) -> {
                    if jet_rust_emit_local_uninit_fixed_type(function, local) != None -> return Val(local)
                }
                else -> return None
            }
        }
    }
    None
}

fn jet_rust_emit_find_value_instruction(ctx: JetRustEmitContext, function: MIRFunction, value: MIRValueID) -> MIRInstruction? {
    if ctx.body_index.function == (Val(function.id)) {
        block :: ctx.body_index.definition_blocks.get(value.value) ?? return None
        position :: ctx.body_index.definition_positions.get(value.value) ?? return None
        return Val(function.blocks[block].instructions[position])
    }
    loop block in function.blocks {
        loop instruction in block.instructions {
            if instruction.result == (Val(value)) -> return Val(instruction)
        }
    }
    None
}

fn jet_rust_emit_value_type(ctx: JetRustEmitContext, function: MIRFunction, value: MIRValueID) -> MIRType Never! {
    if ctx.body_index.function == (Val(function.id)) {
        row :: ctx.body_index.value_rows.get(value.value) ?? panic("Jet Rust emitter reached a MIR value without a checked type row")
        return function.values[row].ty
    }
    loop row in function.values {
        if row.id == value -> return row.ty
    }
    panic("Jet Rust emitter reached a MIR value without a checked type row")
}

fn jet_rust_emit_value_mode(ctx: JetRustEmitContext, function: MIRFunction, value: MIRValueID) -> MIROwnershipMode Never! {
    if ctx.body_index.function == (Val(function.id)) {
        row :: ctx.body_index.value_rows.get(value.value) ?? panic("Jet Rust emitter reached a MIR value without a checked ownership row")
        return function.values[row].ownership.mode
    }
    loop row in function.values {
        if row.id == value -> return row.ownership.mode
    }
    panic("Jet Rust emitter reached a MIR value without a checked ownership row")
}

// The lookup rows of one function body (MIRRust FunctionIndex::new), built
// once when the function is printed.
fn jet_rust_emit_body_index(function: MIRFunction) -> JetRustEmitBodyIndex Never! {
    definition_blocks := [U64:Int]{}
    definition_positions := [U64:Int]{}
    block_positions := [U64:Int]{}
    branch_bases := [U64:Int]{}
    use_slots := [U64:Int]{}
    uses := [[JetRustEmitUse]]{}
    used_places := [U64:Bool]{}
    moves := [MIRPlaceID]{}
    test_member_blocks := [U64:Int]{}
    test_member_positions := [U64:Int]{}
    ordinal := 0
    loop (block_position, block) in function.blocks {
        if block_positions.get(block.id.value) == None {
            _ := &block_positions.add(block.id.value, block_position)
            _ := &branch_bases.add(block.id.value, ordinal)
        }
        ordinal = ordinal + jet_rust_emit_terminator_branch_count(block.terminator)
        loop (position, instruction) in block.instructions {
            if instruction.result == .Val(result) {
                if definition_blocks.get(result.value) == None {
                    _ := &definition_blocks.add(result.value, block_position)
                    _ := &definition_positions.add(result.value, position)
                }
            }
            loop used in mir_operation_value_uses(instruction.operation) -> jet_rust_emit_index_use(&use_slots, &uses, used.value, JetRustEmitUse{block: block_position, instruction: position})
            loop place in mir_operation_place_uses(instruction.operation) -> _ := &used_places.add(place.value, true)
            if instruction.operation == {
                .MovePlace(place) -> &moves.push(place)
                .AddressOf(place, access) -> {
                    if access == MIRAccess.Move -> &moves.push(place)
                }
                .ScopeEnter(scope, member) -> {
                    if member != None && test_member_blocks.get(scope.value) == None {
                        _ := &test_member_blocks.add(scope.value, block_position)
                        _ := &test_member_positions.add(scope.value, position)
                    }
                }
                else -> {}
            }
        }
        loop used in mir_terminator_value_uses(block.terminator) -> jet_rust_emit_index_use(&use_slots, &uses, used.value, JetRustEmitUse{block: block_position, instruction: -1})
    }
    value_rows := [U64:Int]{}
    loop (position, row) in function.values {
        if value_rows.get(row.id.value) == None -> _ := &value_rows.add(row.id.value, position)
    }
    scope_rows := [U64:Int]{}
    loop (position, row) in function.scopes {
        if scope_rows.get(row.id.value) == None -> _ := &scope_rows.add(row.id.value, position)
    }
    place_rows := [U64:Int]{}
    slot_read_values := [U64:Bool]{}
    loop (position, row) in function.places {
        if place_rows.get(row.id.value) == None -> _ := &place_rows.add(row.id.value, position)
        if row.base == .Temporary(base) {
            if used_places.get(row.id.value) != None -> _ := &slot_read_values.add(base.value, true)
        }
    }
    predecessors := [[Int]]{}
    loop _ in function.blocks -> &predecessors.push([Int]{})
    loop (block_position, block) in function.blocks {
        loop target in mir_terminator_targets(block.terminator) {
            if block_positions.get(target.value) == .Val(target_position) -> &predecessors[target_position].push(block_position)
        }
    }
    // Partial moves: each move of a field place, under its root base.
    moved_places := [U64:Bool]{}
    partial_slots := [String:Int]{}
    partial_paths := [[[MIRFieldID]]]{}
    loop place in moves {
        _ := &moved_places.add(place.value, true)
        row :: place_rows.get(place.value) ?? next
        path :: jet_rust_emit_place_row_field_path(function, row)
        if path.len() == 0 -> next
        key :: jet_rust_emit_place_base_identity(function.places[row].base)
        if partial_slots.get(key) == .Val(slot) {
            &partial_paths[slot].push(path)
        } else {
            partial_slots[key] = partial_paths.len()
            &partial_paths.push([[MIRFieldID]]{path})
        }
    }
    writes :: jet_rust_emit_local_writes(function, place_rows, value_rows)
    JetRustEmitBodyIndex{
        function: Val(function.id),
        definition_blocks: definition_blocks,
        definition_positions: definition_positions,
        value_rows: value_rows,
        block_positions: block_positions,
        branch_bases: branch_bases,
        shared_locals: [U64:Bool]{},
        use_slots: use_slots,
        uses: uses,
        place_rows: place_rows,
        predecessors: predecessors,
        write_slots: writes.slots,
        local_writes: writes.rows,
        escaped_locals: writes.escaped,
        parameter_write_slots: writes.parameter_slots,
        parameter_writes: writes.parameter_rows,
        escaped_parameters: writes.parameter_escaped,
        slot_read_values: slot_read_values,
        moved_places: moved_places,
        partial_slots: partial_slots,
        partial_paths: partial_paths,
        scope_rows: scope_rows,
        test_member_blocks: test_member_blocks,
        test_member_positions: test_member_positions,
    }
}

// Appends `at` to the rows of `key`; one operation using a key twice adds one
// row (MIRRust FunctionIndex add_use).
fn jet_rust_emit_index_use(slots: &[U64:Int], rows: &[[JetRustEmitUse]], key: U64, at: JetRustEmitUse) Never! {
    if slots.get(key) == .Val(slot) {
        last :: rows[slot].len() - 1
        if last >= 0 && rows[slot][last].block == at.block && rows[slot][last].instruction == at.instruction -> return
        &rows[slot].push(at)
    } else {
        slots[key] = rows.len()
        &rows.push([JetRustEmitUse]{at})
    }
}

// An exact identity of a place base (`jet_rust_emit_partial_base_key` joins
// value-rooted bases of one value).
fn jet_rust_emit_place_base_identity(base: MIRPlaceBase) -> String Never! {
    if base == {
        .Local(local) -> "L{local.value}"
        .Parameter(value) -> "P{value.value}"
        .Capture(value) -> "C{value.value}"
        .Temporary(value) -> "T{value.value}"
        .Static(name) -> "S{name}"
    }
}

// The field path of a place row; empty when any projection is not a field.
fn jet_rust_emit_place_row_field_path(function: MIRFunction, row: Int) -> [MIRFieldID] Never! {
    fields := [MIRFieldID]{}
    loop projection in function.places[row].projections {
        if projection == {
            .Field(field, _) -> &fields.push(field)
            else -> return [MIRFieldID]{}
        }
    }
    fields
}

struct JetRustEmitLocalWrites {
    slots: [U64:Int]
    rows: [[JetRustEmitUse]]
    escaped: [U64:Bool]
    parameter_slots: [Int:Int]
    parameter_rows: [[JetRustEmitPlaceWrite]]
    parameter_escaped: [Int:Bool]
}

fn jet_rust_emit_index_place_local(function: MIRFunction, place_rows: [U64:Int], place: MIRPlaceID) -> MIRLocalID? {
    row :: place_rows.get(place.value) ?? return None
    if function.places[row].base == .Local(local) -> return Val(local)
    None
}

// The parameter index of a place rooted at a parameter (`parameters`: the
// index each `Parameter` value names).
fn jet_rust_emit_index_place_parameter(function: MIRFunction, place_rows: [U64:Int], parameters: [U64:Int], place: MIRPlaceID) -> Int? {
    row :: place_rows.get(place.value) ?? return None
    if function.places[row].base == .Parameter(value) -> return parameters.get(value.value)
    None
}

// Adds `place` to `changed` when it is rooted at a parameter.
fn jet_rust_emit_index_parameter_change(function: MIRFunction, place_rows: [U64:Int], parameters: [U64:Int], place: MIRPlaceID, changed: &[MIRPlaceID]) Never! {
    if jet_rust_emit_index_place_parameter(function, place_rows, parameters, place) != None -> &changed.push(place)
}

// Marks the parameter `place` is rooted at, if any, as escaping.
fn jet_rust_emit_index_parameter_escape(function: MIRFunction, place_rows: [U64:Int], parameters: [U64:Int], place: MIRPlaceID, escaped: &[Int:Bool]) Never! {
    if jet_rust_emit_index_place_parameter(function, place_rows, parameters, place) == .Val(index) -> _ := &escaped.add(index, true)
}

fn jet_rust_emit_index_write_borrow(function: MIRFunction, value_rows: [U64:Int], value: MIRValueID) -> Bool Never! {
    row :: value_rows.get(value.value) ?? return false
    function.values[row].ownership.mode == MIROwnershipMode.WriteBorrow
}

// The call arguments an operation passes (MIRRust FunctionIndex::new).
fn jet_rust_emit_index_call_args(operation: MIROperation) -> [MIRCallArg] Never! {
    if operation == {
        .Call(_, args, _) | .IndirectCall(_, args, _) | .CoreCall(_, _, args, _, _, _) -> return args
        .Semantic(op) -> {
            if op == {
                .StaticPreludeCall(_, args, _, _) | .HardwareCall(_, _, _, args) | .ClosureMethod(_, args, _) | .HostCall(_, args) -> return args
                else -> {}
            }
        }
        else -> {}
    }
    [MIRCallArg]{}
}

// MIRRust FunctionIndex::new local_writes / escaped_locals: per local, the
// instructions that may change or release it (a write, move, replace or
// write borrow of one of its places, a write or move argument naming one, a
// use of a write borrow taken from one), and the locals place-based tracking
// cannot follow (a partial move, raw address, closure capture or entry list).
// parameter_writes / escaped_parameters: the same per parameter index, each
// row with the place it changes (a pattern scan advancing its receiver
// changes it too), plus the parameters a drop action releases a place of.
// Two passes: a write borrow's definition may sit in a block listed after one
// of its uses.
fn jet_rust_emit_local_writes(function: MIRFunction, place_rows: [U64:Int], value_rows: [U64:Int]) -> JetRustEmitLocalWrites Never! {
    slots := [U64:Int]{}
    rows := [[JetRustEmitUse]]{}
    escaped := [U64:Bool]{}
    borrow_roots := [U64:MIRLocalID]{}
    parameters := [U64:Int]{}
    loop block in function.blocks {
        loop instruction in block.instructions {
            if instruction.operation == .Parameter(index, _) {
                if instruction.result == .Val(result) {
                    if parameters.get(result.value) == None -> _ := &parameters.add(result.value, index)
                }
            }
        }
    }
    parameter_slots := [Int:Int]{}
    parameter_rows := [[JetRustEmitPlaceWrite]]{}
    parameter_escaped := [Int:Bool]{}
    parameter_borrow_roots := [U64:MIRPlaceID]{}
    loop pass in 0..<2 {
        slots = [U64:Int]{}
        rows = [[JetRustEmitUse]]{}
        parameter_slots = [Int:Int]{}
        parameter_rows = [[JetRustEmitPlaceWrite]]{}
        loop (block_position, block) in function.blocks {
            loop (position, instruction) in block.instructions {
                touched := [MIRLocalID]{}
                changed := [MIRPlaceID]{}
                if instruction.operation == {
                    .ReadPlace(place) -> {
                        if instruction.result == .Val(result) {
                            if jet_rust_emit_index_write_borrow(function, value_rows, result) {
                                if jet_rust_emit_index_place_local(function, place_rows, place) == .Val(local) -> &touched.push(local)
                                jet_rust_emit_index_parameter_change(function, place_rows, parameters, place, &changed)
                            }
                        }
                    }
                    .AddressOf(place, access) -> {
                        if jet_rust_emit_index_place_local(function, place_rows, place) == .Val(local) {
                            if access == MIRAccess.Move {
                                _ := &escaped.add(local.value, true)
                            } else if access != MIRAccess.Read {
                                &touched.push(local)
                            }
                        }
                        if access == MIRAccess.Move {
                            jet_rust_emit_index_parameter_escape(function, place_rows, parameters, place, &parameter_escaped)
                        } else if access != MIRAccess.Read {
                            jet_rust_emit_index_parameter_change(function, place_rows, parameters, place, &changed)
                        }
                    }
                    .MovePlace(place) -> {
                        projects :: if place_rows.get(place.value) == .Val(row) -> function.places[row].projections.len() > 0 else -> false
                        if jet_rust_emit_index_place_local(function, place_rows, place) == .Val(local) {
                            if projects {
                                _ := &escaped.add(local.value, true)
                            } else {
                                &touched.push(local)
                            }
                        }
                        if projects {
                            jet_rust_emit_index_parameter_escape(function, place_rows, parameters, place, &parameter_escaped)
                        } else {
                            jet_rust_emit_index_parameter_change(function, place_rows, parameters, place, &changed)
                        }
                    }
                    .InitializeUninit(place) | .WritePlace(place, _) | .ReplacePlace(place, _) -> {
                        if jet_rust_emit_index_place_local(function, place_rows, place) == .Val(local) -> &touched.push(local)
                        jet_rust_emit_index_parameter_change(function, place_rows, parameters, place, &changed)
                    }
                    .RawAddressOf(place) -> {
                        if jet_rust_emit_index_place_local(function, place_rows, place) == .Val(local) -> _ := &escaped.add(local.value, true)
                        jet_rust_emit_index_parameter_escape(function, place_rows, parameters, place, &parameter_escaped)
                    }
                    .Closure(_, captures, _) -> {
                        loop capture in captures {
                            if capture == .Place(place) {
                                if jet_rust_emit_index_place_local(function, place_rows, place) == .Val(local) -> _ := &escaped.add(local.value, true)
                                jet_rust_emit_index_parameter_escape(function, place_rows, parameters, place, &parameter_escaped)
                            }
                        }
                    }
                    .Semantic(op) -> {
                        if op == {
                            .BuiltinMethod(_, _, receiver_place, _, _) -> {
                                if receiver_place == .Val(place) {
                                    if jet_rust_emit_index_place_local(function, place_rows, place) == .Val(local) -> &touched.push(local)
                                    jet_rust_emit_index_parameter_change(function, place_rows, parameters, place, &changed)
                                }
                            }
                            // A pattern scan advances its receiver in place.
                            .CursorTakePattern(_, place, _) | .ReaderTakePattern(_, place, _) -> jet_rust_emit_index_parameter_change(function, place_rows, parameters, place, &changed)
                            .DataEntriesToMap(_, entry_local) -> _ := &escaped.add(entry_local.value, true)
                            else -> {}
                        }
                    }
                    else -> {}
                }
                loop arg in jet_rust_emit_index_call_args(instruction.operation) {
                    if arg.access != MIRAccess.Read && arg.place == .Val(place) {
                        if jet_rust_emit_index_place_local(function, place_rows, place) == .Val(local) -> &touched.push(local)
                        jet_rust_emit_index_parameter_change(function, place_rows, parameters, place, &changed)
                    }
                }
                loop used in mir_operation_value_uses(instruction.operation) {
                    if borrow_roots.get(used.value) == .Val(local) -> &touched.push(local)
                    if parameter_borrow_roots.get(used.value) == .Val(root) -> &changed.push(root)
                }
                if instruction.result == .Val(result) {
                    if jet_rust_emit_index_write_borrow(function, value_rows, result) {
                        if touched.len() > 0 -> borrow_roots[result.value] = touched[0]
                        if changed.len() > 0 -> parameter_borrow_roots[result.value] = changed[0]
                    }
                }
                if pass == 1 {
                    loop local in touched -> jet_rust_emit_index_use(&slots, &rows, local.value, JetRustEmitUse{block: block_position, instruction: position})
                    loop place in changed {
                        index :: jet_rust_emit_index_place_parameter(function, place_rows, parameters, place) ?? next
                        row :: JetRustEmitPlaceWrite{block: block_position, instruction: position, place: place}
                        if parameter_slots.get(index) == .Val(slot) {
                            &parameter_rows[slot].push(row)
                        } else {
                            parameter_slots[index] = parameter_rows.len()
                            &parameter_rows.push([JetRustEmitPlaceWrite]{row})
                        }
                    }
                }
            }
        }
    }
    loop action in function.drops -> jet_rust_emit_index_parameter_escape(function, place_rows, parameters, action.place, &parameter_escaped)
    JetRustEmitLocalWrites{slots: slots, rows: rows, escaped: escaped, parameter_slots: parameter_slots, parameter_rows: parameter_rows, parameter_escaped: parameter_escaped}
}

// Every use of `value` in body order: the indexed rows of the function being
// printed, else one walk of `function`.
fn jet_rust_emit_value_users(ctx: JetRustEmitContext, function: MIRFunction, value: MIRValueID) -> [JetRustEmitUse] Never! {
    if ctx.body_index.function == (Val(function.id)) {
        slot :: ctx.body_index.use_slots.get(value.value) ?? return [JetRustEmitUse]{}
        return ctx.body_index.uses[slot]
    }
    users := [JetRustEmitUse]{}
    loop (block_position, block) in function.blocks {
        loop (position, instruction) in block.instructions {
            if mir_operation_value_uses(instruction.operation).contains(value) -> &users.push(JetRustEmitUse{block: block_position, instruction: position})
        }
        if mir_terminator_value_uses(block.terminator).contains(value) -> &users.push(JetRustEmitUse{block: block_position, instruction: -1})
    }
    users
}

// MIRRust plan_shared_capture_locals (S47/M2): a whole local written through a
// non-Send closure lives in one shared cell. The closure environment keeps a
// handle to the cell and borrows it mutably only for each call, so writes land
// on the owner and the owner's later reads need no frame-long `&mut`.
fn jet_rust_emit_shared_capture_locals(ctx: JetRustEmitContext, function: MIRFunction) -> [U64:Bool] Never! {
    shared := [U64:Bool]{}
    loop block in function.blocks {
        loop instruction in block.instructions {
            if instruction.operation == .Closure(target_id, captures, _) {
                if instruction.result == .Val(result) {
                    if jet_rust_emit_value_type(ctx, function, result).kind == .SendFn(_, _, _) -> next
                }
                target_index :: jet_rust_emit_function_index(ctx, target_id) ?? next
                target :: ctx.program.functions[target_index]
                loop (index, operand) in captures {
                    if index >= target.capture_params.len() || target.capture_params[index].access != MIRAccess.Write -> next
                    if operand == .Place(place_id) {
                        loop row in function.places {
                            if row.id != place_id || row.projections.len() != 0 -> next
                            if row.base == .Local(local) {
                                if jet_rust_emit_partial_root_has(ctx, function, row.base) || jet_rust_emit_local_uninit_fixed_type(function, local) != None -> next
                                if jet_rust_emit_local_is_allocator_view(function, local) -> next
                                if shared.get(local.value) == None -> _ := &shared.add(local.value, true)
                            }
                        }
                    }
                }
            }
        }
    }
    shared
}

fn jet_rust_emit_local_is_allocator_view(function: MIRFunction, local: MIRLocalID) -> Bool Never! {
    loop row in function.locals {
        if row.id != local -> next
        if row.ty.kind == .Tagged(marker, _) -> return marker == (MIRTagMarker.Internal{internal_tag: MIRInternalTag.AllocatorView})
    }
    false
}

// MIRRust local_storage: a shared-cell local is reached through its cell.
fn jet_rust_emit_local_storage(ctx: &JetRustEmitContext, local: MIRLocalID) -> String Never! {
    if jet_rust_emit_local_is_shared(&ctx, local) -> return "(*{jet_rust_emit_local_slot(local)}.borrow_mut())"
    jet_rust_emit_local_slot(local)
}

fn jet_rust_emit_local_is_shared(ctx: &JetRustEmitContext, local: MIRLocalID) -> Bool Never! {
    ctx.body_index.shared_locals.get(local.value) != None
}

fn jet_rust_emit_find_parameter(function: MIRFunction, index: Int) -> MIRParam Never! {
    loop parameter in function.params {
        if parameter.index == index -> return parameter
    }
    panic("Jet Rust emitter reached a MIR parameter without a checked parameter row")
}

fn jet_rust_emit_is_receiver(function: MIRFunction, index: Int) -> Bool Never! {
    if index != 0 -> return false
    if function.form == {
        .Method(_, access) -> access != None
        .TraitMethod(_, _, access, _) -> access != None
        .TopLevel -> false
    }
}

// MIRRust parameter names: `Names::mangle` of the checked parameter name, so a
// Jet name that is a Rust keyword (`async`) still spells a legal identifier.
fn jet_rust_emit_parameter_name(function: MIRFunction, index: Int) -> String Never! {
    if jet_rust_emit_is_receiver(function, index) -> "__jet_self" else -> jet_rust_emit_mangle(jet_rust_emit_find_parameter(function, index).name)
}

fn jet_rust_emit_capture_name(slot: Int) -> String Never! { "__jet_capture_{slot}" }

fn jet_rust_emit_parameter_expression(function: MIRFunction, index: Int, access: MIRAccess) -> String Never! {
    name :: jet_rust_emit_parameter_name(function, index)
    if access == {
        .Read -> {
            parameter :: jet_rust_emit_find_parameter(function, index)
            if jet_rust_emit_is_receiver(function, index) || jet_rust_emit_type_is_borrowed(parameter.ty) -> "(*{name}).clone()" else -> name
        }
        .Write -> "(*{name}).clone()"
        .Move -> name
    }
}

// MIRRust capture_expression: the target capture's own access decides; a Move
// capture is the owned binding, a Read/Write capture is a borrow to clone.
fn jet_rust_emit_capture_expression(function: MIRFunction, slot: Int) -> String Never! {
    name :: jet_rust_emit_capture_name(slot)
    if jet_rust_emit_capture_access(function, slot) == MIRAccess.Move -> name else -> "(*{name}).clone()"
}

fn jet_rust_emit_capture_access(function: MIRFunction, slot: Int) -> MIRAccess Never! {
    loop capture in function.capture_params {
        if capture.slot == slot -> return capture.access
    }
    panic("Jet Rust emitter reached a MIR capture without a checked capture row")
}

// MIRRust value_slot_reference: a binding (a borrowed Parameter/Capture, or a
// read that only feeds borrows) lends the place it names (only a Write
// binding lends it mutably); any other value lends its slot.
fn jet_rust_emit_value_reference(ctx: JetRustEmitContext, value: MIRValueID, mutable: Bool) -> String Never! {
    if ctx.body_index.bindings.get(value.value) == .Val(binding) {
        if !mutable -> return "&({binding.read})"
        place :: binding.write ?? panic("MIR parameter place is not writable")
        return "&mut ({place})"
    }
    if mutable -> "{jet_rust_emit_value_slot(value)}.as_mut().expect(\"MIR value\")" else -> "{jet_rust_emit_value_slot(value)}.as_ref().expect(\"MIR value\")"
}

// MIRRust value_borrow (#4318): a shared reference to the value's slot, or to
// the place a binding names. Inspecting and borrowing consumers read through
// it; nothing is copied.
fn jet_rust_emit_value_borrow(ctx: JetRustEmitContext, value: MIRValueID) -> String Never! { jet_rust_emit_value_reference(ctx, value, false) }

// MIRRust value_copy (#4318): the copy of a MIR `Copy{fact}` operand, and the
// only printer of a value clone. MIRRust tags the clone with `fact` under
// JET_COPY_TAGS=1 for Tools/agent/copy-ratchet.mjs; this emitter has no tag
// mode, so the fact names the copy at the call site and the text is the same.
fn jet_rust_emit_value_copy(ctx: JetRustEmitContext, function: MIRFunction, value: MIRValueID, fact: MIRCopyFact) -> String Never! { jet_rust_emit_copy_text(ctx, function, value) }

// MIRRust value_owned: an owned read of a value the consumer keeps no hold of
// in MIR, a copy no MIR `Copy{fact}` backs yet (`unbacked` in MIRRust tags).
fn jet_rust_emit_value_owned(ctx: JetRustEmitContext, function: MIRFunction, value: MIRValueID) -> String Never! { jet_rust_emit_copy_text(ctx, function, value) }

// MIRRust copy_text: a value whose Rust carrier is `Copy` is read bitwise
// through its borrow; any other value clones.
fn jet_rust_emit_copy_text(ctx: JetRustEmitContext, function: MIRFunction, value: MIRValueID) -> String Never! {
    borrow :: jet_rust_emit_value_borrow(ctx, value)
    if jet_rust_emit_copy_carrier(ctx, jet_rust_emit_value_type(ctx, function, value)) -> "(*{borrow})" else -> "({borrow}).clone()"
}

// MIRRust rust_copy_carrier: whether `ty`'s Rust carrier (jet_rust_emit_type)
// is a `Copy` primitive.
fn jet_rust_emit_copy_carrier(ctx: JetRustEmitContext, source: MIRType) -> Bool Never! {
    ty := source
    if source.identity == .Val(identity) {
        if jet_rust_emit_type_instance(ctx, identity, true) == .Val(instance) -> ty = instance
    }
    if ty.kind == {
        .Bool | .Char | .Float | .Float32 | .Measure(_) -> true
        .IntN(_, bits) -> bits == 8 || bits == 16 || bits == 32 || bits == 64 || bits == 128
        .Tagged(marker, inner) -> marker != (MIRTagMarker.Internal{internal_tag: MIRInternalTag.AllocatorView}) && jet_rust_emit_copy_carrier(ctx, inner)
        .InlineRange(base, _, _) | .Quantity(base, _) -> jet_rust_emit_copy_carrier(ctx, base)
        else -> false
    }
}

// MIRRust value_move: a borrowed binding is never moved out of; its owned read
// copies the place where it is read (MIRRust value_owned), not at entry.
fn jet_rust_emit_value_move(ctx: JetRustEmitContext, value: MIRValueID) -> String Never! {
    if ctx.body_index.bindings.get(value.value) == .Val(binding) -> return if binding.bitwise -> "(*&({binding.read}))" else -> "(&({binding.read})).clone()"
    "{jet_rust_emit_value_slot(value)}.take().expect(\"MIR value\")"
}

// MIRRust value_transfer: an allocator view (never cloned) and an Owned/Move
// value are consumed; a Copy/Shared/borrowed value stays readable by others.
fn jet_rust_emit_value_transfer(ctx: JetRustEmitContext, function: MIRFunction, value: MIRValueID) -> String Never! {
    ty :: jet_rust_emit_value_type(ctx, function, value)
    if ty.kind == .Tagged(marker, _) {
        if marker == (MIRTagMarker.Internal{internal_tag: MIRInternalTag.AllocatorView}) -> return jet_rust_emit_value_move(ctx, value)
    }
    mode :: jet_rust_emit_value_mode(ctx, function, value)
    if mode == MIROwnershipMode.Owned || mode == MIROwnershipMode.Move -> jet_rust_emit_value_move(ctx, value) else -> jet_rust_emit_value_owned(ctx, function, value)
}

fn jet_rust_emit_place_local(ctx: &JetRustEmitContext, local: MIRLocalID, mutable: Bool) -> String Never! {
    storage :: jet_rust_emit_local_storage(&ctx, local)
    // MIRRust place_base: a reference binding names its referent.
    if ctx.ref_bindings.locals.get(local.value) != None {
        if mutable -> jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidOwnership, "E0003", "MIR reference binding local has a write", "a reference binding is planned only for a local nothing writes after its binding", None)
        return "**{storage}.as_ref().expect(\"MIR local\")"
    }
    if mutable -> "*{storage}.as_mut().expect(\"MIR local\")" else -> "*{storage}.as_ref().expect(\"MIR local\")"
}

// MIRRust binding_uses_move_slot: a non-scalar Move parameter or capture is
// owned by its SSA Option slot once the Parameter/Capture result moves it in.
fn jet_rust_emit_binding_uses_move_slot(ctx: JetRustEmitContext, function: MIRFunction, value: MIRValueID) -> Bool Never! {
    instruction :: jet_rust_emit_find_value_instruction(ctx, function, value) ?? return false
    access := MIRAccess.Read
    if instruction.operation == {
        .Parameter(index, _) -> access = jet_rust_emit_find_parameter(function, index).access
        .Capture(slot) -> access = jet_rust_emit_capture_access(function, slot)
        else -> return false
    }
    if access != MIRAccess.Move -> return false
    // MIRRust is_scalar (jet_rust_emit_is_scalar): a Core-layer String is
    // scalar; JetInt owns a Foundation node and never is.
    ty :: jet_rust_emit_value_type(ctx, function, value)
    if ty.kind == MIRTypeKind.Int -> return true
    if ty.kind == MIRTypeKind.String && ctx.program.facts.target_dossier.layer == MIRRuntimeLayer.Core -> return false
    !mir_type_is_scalar(ty)
}

// MIRRust history_binding: a Parameter/Capture result names the retained
// place, so MIRRust never stores it at entry; its users borrow or copy that
// place where they read it. A binding of jet_rust_emit_place_bindings or
// jet_rust_emit_read_bindings has no slot: every operand use renders its
// place. Any other borrowed (non-Move) binding still stores its slot, except
// when nothing reads that slot: every operand use is the drop that releases
// nothing (jet_rust_emit_drop_value), and nothing moves out of a place rooted
// at the binding (jet_rust_emit_place_move, partial moves).
fn jet_rust_emit_unread_binding(ctx: &JetRustEmitContext, function: MIRFunction, instruction: MIRInstruction, value: MIRValueID) -> Bool Never! {
    if ctx.body_index.function != (Val(function.id)) -> return false
    if ctx.body_index.bindings.get(value.value) != None -> return true
    access := MIRAccess.Move
    if instruction.operation == {
        .Parameter(index, _) -> access = jet_rust_emit_find_parameter(function, index).access
        .Capture(slot) -> access = jet_rust_emit_capture_access(function, slot)
        else -> return false
    }
    if access == MIRAccess.Move -> return false
    loop user in jet_rust_emit_value_users(ctx, function, value) {
        if user.instruction < 0 -> return false
        if function.blocks[user.block].instructions[user.instruction].operation == {
            .Drop(_, _) -> {}
            else -> return false
        }
    }
    loop row in function.places {
        if row.base == {
            .Parameter(base) | .Capture(base) -> { if base == value && ctx.body_index.moved_places.get(row.id.value) != None -> return false }
            else -> {}
        }
    }
    true
}

// MIRRust history_binding / emit_slots: the borrowed (Read/Write, non-window)
// Parameter and Capture results whose entry store would copy the referent
// (jet_rust_emit_parameter_expression clones it), keyed by value id. Their
// users read the parameter place itself (jet_rust_emit_value_reference,
// jet_rust_emit_value_move), so the function never deep-copies a borrowed
// argument on entry. A binding keeps its slot when a place rooted at it is
// moved out of (jet_rust_emit_place_move and partial moves take the slot) or
// when a temporary place projects it (a write through that place needs a
// writable copy), and in a generator, whose `move` stream task owns everything
// its body reads.
fn jet_rust_emit_place_bindings(ctx: JetRustEmitContext, function: MIRFunction) -> [U64:JetRustEmitPlaceBinding] Never! {
    bindings := [U64:JetRustEmitPlaceBinding]{}
    if function.generator != None -> return bindings
    kept := [U64:Bool]{}
    loop row in function.places {
        if row.base == {
            .Parameter(base) | .Capture(base) -> { if ctx.body_index.moved_places.get(row.id.value) != None -> kept[base.value] = true }
            .Temporary(base) -> kept[base.value] = true
            else -> {}
        }
    }
    loop block in function.blocks {
        loop instruction in block.instructions {
            value :: instruction.result ?? next
            access := MIRAccess.Move
            if instruction.operation == {
                .Parameter(index, _) -> {
                    parameter :: jet_rust_emit_find_parameter(function, index)
                    // A window is a `&mut [T]` slice, read whole as an owned
                    // copy; a by-value Read parameter (scalar ABI) is moved
                    // into its slot, never copied.
                    if jet_rust_emit_window_param(ctx, function.id, index) -> next
                    if parameter.access == MIRAccess.Read && !jet_rust_emit_is_receiver(function, index) && !jet_rust_emit_type_is_borrowed(parameter.ty) -> next
                    access = parameter.access
                }
                .Capture(slot) -> access = jet_rust_emit_capture_access(function, slot)
                else -> next
            }
            if access == MIRAccess.Move || kept.get(value.value) != None || bindings.get(value.value) != None -> next
            write := String?{None}
            if access == MIRAccess.Write -> write = Val(jet_rust_emit_parameter_place(ctx, function, value, true))
            bindings[value.value] = JetRustEmitPlaceBinding{read: jet_rust_emit_parameter_place(ctx, function, value, false), write: write, bitwise: jet_rust_emit_copy_carrier(ctx, jet_rust_emit_value_type(ctx, function, value))}
        }
    }
    bindings
}

// MIRRust direct_borrow_projection / direct_borrow_only: the bindings of
// jet_rust_emit_place_bindings plus every `ReadPlace` of a read parameter's
// place whose users never need it stored (jet_rust_emit_place_read_use),
// keyed by value id. Such a read is never made: its users read the parameter
// place itself through jet_rust_emit_value_reference (display holes,
// operator and index operands, borrowed arguments, inspected subjects), so
// the function never copies a borrowed argument just to read it. A read
// parameter's place cannot change while the function runs
// (jet_rust_emit_immutable_read_place), so the place read at a use holds
// exactly what the copy would. The place projects only fields and payloads:
// an index projection would move its bounds check from the read to each use.
// A generator keeps its copies: its `move` stream task owns everything its
// body reads.
fn jet_rust_emit_read_bindings(ctx: &JetRustEmitContext, function: MIRFunction) -> [U64:JetRustEmitPlaceBinding] Never! {
    bindings := ctx.body_index.bindings
    if function.generator != None -> return bindings
    // Values named as an index inside a place projection: the place renders
    // them through jet_rust_emit_index_operand or the value borrow. A range
    // projection keeps its operand's slot.
    projected := [U64:Bool]{}
    loop row in function.places {
        loop projection in row.projections {
            if projection == {
                .Index(_, index, _, _, _, _, _) -> { if projected.get(index.value) == None -> projected[index.value] = true }
                .Range(range, _, _) -> projected[range.value] = false
                else -> {}
            }
        }
    }
    loop block in function.blocks {
        loop instruction in block.instructions {
            value :: instruction.result ?? next
            if instruction.operation == .ReadPlace(place) {
                if bindings.get(value.value) == None {
                    if jet_rust_emit_read_binding_place(&ctx, function, value, place, projected) == .Val(read) -> bindings[value.value] = JetRustEmitPlaceBinding{read: read, write: None, bitwise: jet_rust_emit_copy_carrier(ctx, jet_rust_emit_value_type(ctx, function, value))}
                }
            }
        }
    }
    bindings
}

// The place expression a jet_rust_emit_read_bindings read names, or None when
// the read must be stored.
fn jet_rust_emit_read_binding_place(ctx: &JetRustEmitContext, function: MIRFunction, value: MIRValueID, place: MIRPlaceID, projected: [U64:Bool]) -> String? Never! {
    if ctx.ref_bindings.payloads.get(value.value) != None || ctx.ref_bindings.collections.get(value.value) != None || ctx.ref_bindings.cursors.get(value.value) != None -> return None
    if jet_rust_emit_immutable_read_place(&ctx, function, value) != (Val(place)) -> return None
    row :: ctx.body_index.place_rows.get(place.value) ?? return None
    shape :: function.places[row]
    root := MIRValueID?{None}
    if shape.base == .Parameter(base) -> root = Val(base)
    parameter :: root ?? return None
    if jet_rust_emit_parameter_access(ctx, function, parameter) != (Val(MIRAccess.Read)) -> return None
    definition :: jet_rust_emit_find_value_instruction(ctx, function, parameter) ?? return None
    if definition.operation == .Parameter(index, _) {
        if jet_rust_emit_window_param(ctx, function.id, index) -> return None
    }
    loop projection in shape.projections {
        if projection == {
            .Field(_, _) | .Payload(_, _) -> {}
            else -> return None
        }
    }
    // Nothing moves out of the parameter (a moved place takes its slot), and
    // the read is the place itself, not a widened native Int.
    loop other in function.places {
        if other.base == .Parameter(base) {
            if base == parameter && ctx.body_index.moved_places.get(other.id.value) != None -> return None
        }
    }
    if jet_rust_emit_partial_root_has(ctx, function, shape.base) || jet_rust_emit_native_place_int_type(&ctx, function, place) != None -> return None
    // A place projecting from the read's own slot reads that slot.
    if jet_rust_emit_value_slot_read(ctx, function, value) -> return None
    if projected.get(value.value) == (Val(false)) -> return None
    used := projected.get(value.value) != None
    loop user in jet_rust_emit_value_users(ctx, function, value) {
        if user.instruction < 0 {
            if !jet_rust_emit_switch_subject_use(function, user, value) -> return None
        } else {
            if !jet_rust_emit_place_read_use(&ctx, function, function.blocks[user.block].instructions[user.instruction], value) -> return None
        }
        used = true
    }
    if !used -> return None
    Val(jet_rust_emit_place(&ctx, function, place, false))
}

// A consumer of a jet_rust_emit_read_bindings read that never needs the read
// stored: it renders the read through jet_rust_emit_value_reference (an owned
// operand copies the place there, through jet_rust_emit_value_owned or
// jet_rust_emit_value_move, instead of taking a copy made at the read), or
// borrows the place the read's definition names
// (jet_rust_emit_place_borrowing_use, a builtin receiver place), or inspects
// a transfer of it that is never made, or drops it (the read was never made,
// so nothing is released). No consumer borrows the read mutably.
fn jet_rust_emit_place_read_use(ctx: &JetRustEmitContext, function: MIRFunction, instruction: MIRInstruction, value: MIRValueID) -> Bool Never! {
    operation :: instruction.operation
    if instruction.result == .Val(transfer) {
        if jet_rust_emit_transparent_read(ctx, function, transfer) == (Val(value)) && jet_rust_emit_inspected_transfer(&ctx, function, transfer) -> return true
    }
    if operation == {
        // An index operand renders through jet_rust_emit_index_operand; a
        // base is borrowed for a read.
        .Index(_, base, _, _, access, _, _) -> return base != value || access == MIRAccess.Read
        .BuildString(_) | .Binary(_, _, _, _, _) | .Unary(_, _) | .LoopRangeInit(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _) -> return true
        .EnumIs(_, _, _) | .EnumPayload(_, _, _, _) | .OptionIsSome(_) | .OptionValue(_) | .ResultIsOk(_) | .ResultValue(_, _) -> return true
        .Drop(_, kind) -> return kind != MIRDropKind.ForeignHandle && !jet_rust_emit_is_stm_type(jet_rust_emit_value_type(ctx, function, value))
        // A Core call renders each argument through
        // jet_rust_emit_call_arg_with_borrow; a Write argument would lend the
        // read parameter's place mutably.
        .CoreCall(_, _, args, _, _, _) -> {
            loop arg in args {
                if arg.value == value && arg.access == MIRAccess.Write -> return false
            }
            return true
        }
        .Semantic(semantic) -> {
            if semantic == {
                .Print(_, _) -> return true
                // A static Prelude call renders exactly as a Prelude call
                // (jet_rust_emit_prelude_call).
                .StaticPreludeCall(call, args, _, _) -> return jet_rust_emit_direct_borrow_call(&ctx, function, MIRCallee.Prelude{call: call}, args, value)
                else -> {}
            }
        }
        else -> {}
    }
    jet_rust_emit_builtin_place_receiver(operation, value) || jet_rust_emit_place_borrowing_use(&ctx, function, operation, value)
}

fn jet_rust_emit_parameter_place(ctx: JetRustEmitContext, function: MIRFunction, value: MIRValueID, mutable: Bool) -> String Never! {
    instruction :: jet_rust_emit_find_value_instruction(ctx, function, value) ?? panic("MIR parameter place has no producer")
    if jet_rust_emit_binding_uses_move_slot(ctx, function, value) {
        accessor :: if mutable -> "as_mut" else -> "as_ref"
        what :: if instruction.operation == .Capture(_) -> "capture" else -> "parameter"
        return "*{jet_rust_emit_value_slot(value)}.{accessor}().expect(\"MIR {what}\")"
    }
    if instruction.operation == {
        .Parameter(index, _) -> {
            name :: jet_rust_emit_parameter_name(function, index)
            parameter :: jet_rust_emit_find_parameter(function, index)
            if mutable {
                if parameter.access == MIRAccess.Move -> return name
                if parameter.access != MIRAccess.Write -> panic("MIR parameter place is not writable")
                return "*{name}"
            }
            // MIRRust parameter_place: a by-value Read parameter (scalar ABI)
            // is the binding itself; only a borrowed binding dereferences.
            if parameter.access == {
                .Move -> return name
                .Read -> if !jet_rust_emit_is_receiver(function, index) && !jet_rust_emit_type_is_borrowed(parameter.ty) -> return name
                .Write -> {}
            }
            return "*{name}"
        }
        .Capture(slot) -> {
            name :: jet_rust_emit_capture_name(slot)
            access :: jet_rust_emit_capture_access(function, slot)
            if access == MIRAccess.Move -> return name
            if mutable && access != MIRAccess.Write -> panic("MIR capture place is not writable")
            return "*{name}"
        }
        else -> panic("MIR place base does not refer to a parameter or capture value")
    }
}

fn jet_rust_emit_prelude_symbol(ctx: &JetRustEmitContext, id: MIRPreludeCallID) -> String Never! {
    loop row in jet_rust_emit_prelude_route_rows(ctx, id) {
        if row.id == id {
            if row.symbol == {
                .Prelude(name) -> return "{ctx.config.root_prefix}{name}"
                .Runtime(name) -> {
                    if name.starts_with("jet_crypto_") || name.starts_with("jet_vault_") -> return "jet_ffi::{name}"
                    return name
                }
            }
        }
    }
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR Prelude route is missing from the program registry", "every checked operation route must carry one canonical Prelude row", None)
    "__jet_missing_prelude_{id.value}"
}

fn jet_rust_emit_source_path(ctx: &JetRustEmitContext, id: MIRSourceFileID) -> String Never! {
    if jet_rust_emit_source_row(ctx, id) == .Val(row) -> return jet_rust_emit_quote(ctx.source_index.rows[row].path)
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR panic location names a missing source file", "source spans must resolve to immutable source-file rows before emission", None)
    "\"<missing-source>\""
}

fn jet_rust_emit_partial_base_key(base: MIRPlaceBase) -> String Never! {
    if base == {
        .Local(local) -> "local_{local.value}"
        .Parameter(value) -> "value_{value.value}"
        .Capture(value) -> "value_{value.value}"
        .Temporary(value) -> "value_{value.value}"
        .Static(name) -> "static_{jet_rust_emit_sanitize(name)}"
    }
}

fn jet_rust_emit_partial_root_slot(base: MIRPlaceBase) -> String Never! {
    if base == {
        .Local(local) -> jet_rust_emit_local_slot(local)
        .Parameter(value) -> jet_rust_emit_value_slot(value)
        .Capture(value) -> jet_rust_emit_value_slot(value)
        .Temporary(value) -> jet_rust_emit_value_slot(value)
        .Static(name) -> "{name}"
    }
}

fn jet_rust_emit_partial_field_slot(base: MIRPlaceBase, path: [MIRFieldID]) -> String Never! {
    out := "__jet_partial_{jet_rust_emit_partial_base_key(base)}"
    index := 0
    loop index < path.len() {
        out = "{out}_{path[index].value}"
        index += 1
    }
    out
}

fn jet_rust_emit_partial_path_prefix(path: [MIRFieldID], count: Int) -> [MIRFieldID] Never! {
    prefix := [MIRFieldID]{}
    loop index in 0..<count -> &prefix.push(path[index])
    prefix
}

fn jet_rust_emit_partial_path_append(path: [MIRFieldID], field: MIRFieldID) -> [MIRFieldID] Never! {
    extended := [MIRFieldID]{}
    loop current in path -> &extended.push(current)
    &extended.push(field)
    extended
}

fn jet_rust_emit_partial_path_suffix(path: [MIRFieldID], start: Int) -> [MIRFieldID] Never! {
    suffix := [MIRFieldID]{}
    index := start
    loop index < path.len() {
        &suffix.push(path[index])
        index += 1
    }
    suffix
}

// The field path a partial move takes out of place `id`: empty unless some
// instruction moves out of `id` and every projection of its row is a field.
fn jet_rust_emit_partial_place_path(ctx: JetRustEmitContext, function: MIRFunction, id: MIRPlaceID) -> [MIRFieldID] Never! {
    if ctx.body_index.function == (Val(function.id)) {
        if ctx.body_index.moved_places.get(id.value) == None -> return [MIRFieldID]{}
        row :: ctx.body_index.place_rows.get(id.value) ?? return [MIRFieldID]{}
        return jet_rust_emit_place_row_field_path(function, row)
    }
    loop block in function.blocks {
        loop instruction in block.instructions {
            moved :: if instruction.operation == {
                .MovePlace(place) -> place == id
                .AddressOf(place, access) -> place == id && access == MIRAccess.Move
                else -> false
            }
            if !moved -> next
            loop (row, place) in function.places {
                if place.id == id -> return jet_rust_emit_place_row_field_path(function, row)
            }
        }
    }
    [MIRFieldID]{}
}

fn jet_rust_emit_place_projection_path(function: MIRFunction, id: MIRPlaceID) -> [MIRFieldID] Never! {
    loop row in function.places {
        if row.id == id {
            fields := [MIRFieldID]{}
            loop projection in row.projections {
                if projection == {
                    .Field(field, _) -> &fields.push(field)
                    else -> return [MIRFieldID]{}
                }
            }
            return fields
        }
    }
    [MIRFieldID]{}
}

fn jet_rust_emit_partial_value_path(ctx: JetRustEmitContext, function: MIRFunction, value: MIRValueID) -> JetRustPartialValuePath? {
    instruction :: jet_rust_emit_find_value_instruction(ctx, function, value) ?? return None
    if instruction.operation == {
        .ReadPlace(place) | .AddressOf(place, _) -> {
            loop row in function.places {
                if row.id == place {
                    fields :: jet_rust_emit_place_projection_path(function, place)
                    if fields.len() != row.projections.len() -> return None
                    return Val(JetRustPartialValuePath{base: row.base, fields: fields})
                }
            }
        }
        .Field(base, field) -> {
            path := jet_rust_emit_partial_value_path(ctx, function, base)
            if path != None {
                projected := path ?? return None
                &projected.fields.push(field)
                return Val(projected)
            }
        }
        .Parameter(_, _) -> return Val(JetRustPartialValuePath{base: MIRPlaceBase.Parameter{value: value}, fields: [MIRFieldID]{}})
        .Capture(_) -> return Val(JetRustPartialValuePath{base: MIRPlaceBase.Capture{value: value}, fields: [MIRFieldID]{}})
        else -> {}
    }
    None
}

fn jet_rust_emit_partial_projected_value(ctx: &JetRustEmitContext, function: MIRFunction, base: MIRValueID, field: MIRFieldID) -> String? {
    projected := jet_rust_emit_partial_value_path(ctx, function, base) ?? return None
    if !jet_rust_emit_partial_root_has(ctx, function, projected.base) -> return None
    owner :: jet_rust_emit_partial_node_owner(&ctx, function, projected.base, [MIRFieldID]{}) ?? return None
    &projected.fields.push(field)
    Val(jet_rust_emit_partial_field_reference(&ctx, function, projected.base, [MIRFieldID]{}, owner, projected.fields, false))
}

fn jet_rust_emit_partial_value_reference(ctx: &JetRustEmitContext, function: MIRFunction, value: MIRValueID) -> String? {
    projected :: jet_rust_emit_partial_value_path(ctx, function, value) ?? return None
    if !jet_rust_emit_partial_root_has(ctx, function, projected.base) -> return None
    owner :: jet_rust_emit_partial_node_owner(&ctx, function, projected.base, [MIRFieldID]{}) ?? return None
    if projected.fields.len() > 0 {
        return Val(jet_rust_emit_partial_field_reference(&ctx, function, projected.base, [MIRFieldID]{}, owner, projected.fields, false))
    }
    root :: jet_rust_emit_partial_root_slot(projected.base)
    restore :: jet_rust_emit_partial_restore(&ctx, function, projected.base, [MIRFieldID]{}, owner, false)
    reference :: "{root}.as_ref().expect(\"MIR local\")"
    Val("{{ {restore} {reference} }}")
}

fn jet_rust_emit_partial_direct_borrow_call(ctx: &JetRustEmitContext, function: MIRFunction, callee: MIRCallee, args: [MIRCallArg], value: MIRValueID, projected: JetRustPartialValuePath) -> Bool Never! {
    if callee == {
        .Foreign(_) -> return false
        else -> {}
    }
    borrow_mask :: jet_rust_emit_call_borrow_mask(&ctx, callee, function, args)
    found := false
    index := 0
    loop arg in args {
        if arg.value == value {
            if index >= borrow_mask.len() || !borrow_mask[index] -> return false
            if arg.access != MIRAccess.Read && arg.access != MIRAccess.Write -> return false
            if arg.authority_boundary || arg.implicit_clone || arg.shared_auto_clone || arg.widen_fixed_to_list || arg.widen_to_union != None || arg.box_as_trait != None || arg.fn_coercion != None -> return false
            if {
                arg.place == None -> {
                if arg.access != MIRAccess.Read || jet_rust_emit_partial_value_reference(&ctx, function, value) == None -> return false
                }
                else -> {
                place_id :: arg.place ?? return false
                place_fields :: jet_rust_emit_place_projection_path(function, place_id)
                place_found := false
                loop row in function.places {
                    if row.id == place_id {
                        place_found = true
                        if row.base != projected.base || row.access != arg.access || row.projections.len() != place_fields.len() || place_fields != projected.fields -> return false
                    }
                }
                if !place_found -> return false
                }
            }
            found = true
        }
        index += 1
    }
    found
}

fn jet_rust_emit_partial_projection_only(ctx: &JetRustEmitContext, function: MIRFunction, value: MIRValueID) -> Bool Never! {
    instruction :: jet_rust_emit_find_value_instruction(ctx, function, value) ?? return false
    if instruction.operation == {
        .ReadPlace(_) | .AddressOf(_, _) | .Field(_, _) -> {}
        else -> return false
    }
    path := jet_rust_emit_partial_value_path(ctx, function, value)
    if path == None -> return false
    projected :: path ?? return false
    if !jet_rust_emit_partial_root_has(ctx, function, projected.base) -> return false
    loop user in jet_rust_emit_value_users(ctx, function, value) {
        if user.instruction < 0 -> return false
        if function.blocks[user.block].instructions[user.instruction].operation == {
            .Field(base, _) -> {
                if base != value -> return false
            }
            .Call(callee, args, _) -> {
                if !jet_rust_emit_partial_direct_borrow_call(&ctx, function, callee, args, value, projected) -> return false
            }
            else -> return false
        }
    }
    true
}

// D-MEM-COPYSEM1: the place a `ReadPlace` value reads when a consumer that
// only inspects the value may read that place instead of a materialized copy
// (and the copy is never emitted when every consumer does). The place
// projects fields, payloads, and list indexes from a read parameter, which
// cannot change while the function runs, or from a write parameter or an
// owned local that nothing changes or releases between the read and any use
// of the value (jet_rust_emit_stable_parameter_read,
// jet_rust_emit_stable_local_read; MIRRust immutable_read_place). #4318 §8:
// a transfer of such a read (jet_rust_emit_transparent_read) is inspected in
// the same place.
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::immutable_read_place
fn jet_rust_emit_immutable_read_place(ctx: &JetRustEmitContext, function: MIRFunction, value: MIRValueID) -> MIRPlaceID? {
    instruction :: jet_rust_emit_find_value_instruction(ctx, function, value) ?? return None
    read_value := value
    source := instruction
    if instruction.operation == {
        .ReadPlace(_) -> {}
        else -> {
            read_value = jet_rust_emit_transparent_read(ctx, function, value) ?? return None
            source = jet_rust_emit_find_value_instruction(ctx, function, read_value) ?? return None
        }
    }
    read := MIRPlaceID?{None}
    if source.operation == .ReadPlace(place) -> read = Val(place)
    place_id :: read ?? return None
    loop row in function.places {
        if row.id != place_id -> next
        loop projection in row.projections {
            if projection == {
                .Field(field, _) -> {
                    owner :: jet_rust_emit_partial_owner(&ctx, field) ?? return None
                    // A recursive (boxed) field is read through its box in place.
                    // MIRRust native_host_field_type: a native carrier's field
                    // read widens its host scalar, so it is never borrowed raw.
                    if jet_rust_emit_type_index(ctx, owner) == .Val(definition_index) {
                        if ctx.program.types[definition_index].id == owner && jet_rust_emit_has_native_type_projection(ctx.program.types[definition_index].key) -> return None
                    }
                }
                .Payload(_, _) -> {}
                .Index(kind, _, _, _, _, _, _) -> {
                    if kind != MIRIndexKind.List -> return None
                }
                else -> return None
            }
        }
        if row.base == {
            .Parameter(parameter) -> {
                access :: jet_rust_emit_parameter_access(ctx, function, parameter) ?? return None
                if access == MIRAccess.Read -> return Val(place_id)
                if access != MIRAccess.Write -> return None
                if !jet_rust_emit_stable_parameter_read(&ctx, function, read_value, row) -> return None
                if read_value == value -> return Val(place_id)
                if jet_rust_emit_stable_parameter_read(&ctx, function, value, row) -> return Val(place_id)
            }
            .Local(local) -> {
                read_stable :: jet_rust_emit_stable_local_read(&ctx, function, read_value, local)
                if !read_stable -> return None
                if read_value == value -> return Val(place_id)
                if jet_rust_emit_stable_local_read(&ctx, function, value, local) -> return Val(place_id)
            }
            else -> {}
        }
        return None
    }
    None
}

// MIRRust transparent_read (#4318 §8): the place read `value` transfers when
// `value` is a `Move`, or a `Copy` that is neither the programmer's `~` nor a
// view materialization, of a `ReadPlace` value. Such a transfer copies
// nothing a consumer that only inspects it needs: that consumer reads the
// place (jet_rust_emit_immutable_read_place).
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::transparent_read
fn jet_rust_emit_transparent_read(ctx: JetRustEmitContext, function: MIRFunction, value: MIRValueID) -> MIRValueID? {
    instruction :: jet_rust_emit_find_value_instruction(ctx, function, value) ?? return None
    operand := MIRValueID?{None}
    if instruction.operation == {
        .Move(read) -> operand = Val(read)
        .Copy(read, fact) -> {
            if fact != MIRCopyFact.Explicit && fact != MIRCopyFact.ViewMaterialize -> operand = Val(read)
        }
        else -> {}
    }
    read_value :: operand ?? return None
    definition :: jet_rust_emit_find_value_instruction(ctx, function, read_value) ?? return None
    if definition.operation == .ReadPlace(_) -> return Val(read_value)
    None
}

// MIRRust inspected_transfer (#4318 §8): a transparent transfer of a stable
// read whose every consumer only inspects it through the read's place
// (jet_rust_emit_inspected_value_reference) or drops it. The transfer is
// never made, and a read it alone consumes is never emitted either.
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::inspected_transfer
fn jet_rust_emit_inspected_transfer(ctx: &JetRustEmitContext, function: MIRFunction, value: MIRValueID) -> Bool Never! {
    if jet_rust_emit_transparent_read(ctx, function, value) == None -> return false
    // A place projecting from the transfer's own slot reads that slot.
    if jet_rust_emit_value_slot_read(ctx, function, value) -> return false
    used := false
    loop user in jet_rust_emit_value_users(ctx, function, value) {
        if user.instruction < 0 {
            if !jet_rust_emit_switch_subject_use(function, user, value) -> return false
            used = true
            next
        }
        operation :: function.blocks[user.block].instructions[user.instruction].operation
        inspects :: if operation == {
            .EnumIs(subject, _, _) -> subject == value
            .EnumPayload(subject, _, _, _) -> subject == value
            .OptionIsSome(subject) -> subject == value
            .OptionValue(subject) -> subject == value
            .ResultIsOk(subject) -> subject == value
            .ResultValue(subject, _) -> subject == value
            .Binary(op, dispatch, _, left, _) -> dispatch == .Primitive && jet_rust_emit_comparison_by_reference(&ctx, function, op, left)
            // A transfer that was never made owns nothing to release.
            .Drop(operand, kind) -> operand == value && kind != MIRDropKind.ForeignHandle && !jet_rust_emit_is_stm_type(jet_rust_emit_value_type(ctx, function, value))
            else -> false
        }
        if !inspects -> return false
        used = true
    }
    used && jet_rust_emit_immutable_read_place(&ctx, function, value) != None
}

// MIRRust emit_switch: a Switch terminator renders only its arm conditions;
// its subject is carried for facts only, so naming the subject reads no slot.
// A value that is an arm condition too is read there.
fn jet_rust_emit_switch_subject_use(function: MIRFunction, user: JetRustEmitUse, value: MIRValueID) -> Bool Never! {
    if user.instruction >= 0 -> return false
    if function.blocks[user.block].terminator == .Switch(subject, arms, _) {
        if subject != value -> return false
        loop arm in arms {
            if arm.condition == value -> return false
        }
        return true
    }
    false
}

// MIRRust STM_TYPE: the root transaction guard (`Stm`).
fn jet_rust_emit_is_stm_type(ty: MIRType) -> Bool Never! {
    if ty.kind == .Apply(name, args) -> return args.len() == 0 && name.name == "Stm"
    false
}

// D-MEM-COPYSEM1: true when no operation that may change or release `local`
// (body_index.local_writes) runs between the `ReadPlace` defining `value` and
// any use of `value`, so each use reads in the local's place exactly what the
// copy would hold. A local that escapes place-based tracking
// (body_index.escaped_locals) never proves stable. Only paths that do not
// pass the read again count: a later pass redefines the value. Answers are
// kept per read value in the body index (MIRRust stable_reads).
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::stable_local_read
fn jet_rust_emit_stable_local_read(ctx: &JetRustEmitContext, function: MIRFunction, value: MIRValueID, local: MIRLocalID) -> Bool Never! {
    if ctx.body_index.function != (Val(function.id)) -> return false
    if ctx.body_index.stable_reads.get(value.value) == .Val(known) -> return known
    stable :: jet_rust_emit_local_unchanged_until_uses(ctx, function, value, local)
    _ := &ctx.body_index.stable_reads.add(value.value, stable)
    stable
}

// MIRRust stable_parameter_read: jet_rust_emit_stable_local_read for a
// `value` that reads, or transfers a read of, `place`, a place rooted at a
// write parameter: no operation that may change an overlapping place of that
// parameter (jet_rust_emit_parameter_place_writes) runs between the read and
// any use.
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::stable_parameter_read
fn jet_rust_emit_stable_parameter_read(ctx: &JetRustEmitContext, function: MIRFunction, value: MIRValueID, place: MIRPlace) -> Bool Never! {
    if ctx.body_index.function != (Val(function.id)) -> return false
    if ctx.body_index.stable_reads.get(value.value) == .Val(known) -> return known
    stable := false
    if jet_rust_emit_parameter_place_writes(ctx, function, place) == .Val(writes) -> stable = jet_rust_emit_unchanged_until_uses(ctx, function, value, writes)
    _ := &ctx.body_index.stable_reads.add(value.value, stable)
    stable
}

// The access of the parameter `parameter` (a `Parameter` value) names.
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::parameter_access
fn jet_rust_emit_parameter_access(ctx: JetRustEmitContext, function: MIRFunction, parameter: MIRValueID) -> MIRAccess? {
    definition :: jet_rust_emit_find_value_instruction(ctx, function, parameter) ?? return None
    if definition.operation == .Parameter(index, _) {
        loop param in function.params {
            if param.index == index -> return Val(param.access)
        }
    }
    None
}

// MIRRust parameter_place_writes: the instructions that may change `place`,
// a place rooted at a write parameter: those changing a place of that
// parameter that shares storage with it (jet_rust_emit_places_overlap). None
// when the parameter is a range window, which reads as a copied list, or
// escapes place-based tracking.
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::parameter_place_writes
fn jet_rust_emit_parameter_place_writes(ctx: JetRustEmitContext, function: MIRFunction, place: MIRPlace) -> [JetRustEmitUse]? {
    parameter := MIRValueID?{None}
    if place.base == .Parameter(value) -> parameter = Val(value)
    parameter_value :: parameter ?? return None
    definition :: jet_rust_emit_find_value_instruction(ctx, function, parameter_value) ?? return None
    index := -1
    if definition.operation == .Parameter(position, _) -> index = position
    if index < 0 -> return None
    if ctx.body_index.escaped_parameters.get(index) != None || jet_rust_emit_window_param(ctx, function.id, index) -> return None
    writes := [JetRustEmitUse]{}
    slot :: ctx.body_index.parameter_write_slots.get(index) ?? return Val(writes)
    loop write in ctx.body_index.parameter_writes[slot] {
        overlaps := true
        if ctx.body_index.place_rows.get(write.place.value) == .Val(row) -> overlaps = jet_rust_emit_places_overlap(function.places[row].projections, place.projections)
        if overlaps -> &writes.push(JetRustEmitUse{block: write.block, instruction: write.instruction})
    }
    Val(writes)
}

// MIRRust places_overlap: whether two places of one root, given by their
// projections, may share storage: only a field of one record that differs
// from the other's field at the same depth keeps them apart. An index,
// payload or other projection is taken to overlap whatever it meets.
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::places_overlap
fn jet_rust_emit_places_overlap(left: [MIRProjection], right: [MIRProjection]) -> Bool Never! {
    loop (position, projection) in left {
        if position >= right.len() -> return true
        left_field := MIRFieldID?{None}
        right_field := MIRFieldID?{None}
        if projection == .Field(field, _) -> left_field = Val(field)
        if right[position] == .Field(field, _) -> right_field = Val(field)
        if left_field == None || right_field == None -> return true
        if left_field != right_field -> return false
    }
    true
}

// MIRRust unchanged_after: whether none of `writes` may run after
// instruction `position` of block `block`: none later in that block, none in
// a block reachable from it.
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::unchanged_after
fn jet_rust_emit_unchanged_after(ctx: JetRustEmitContext, function: MIRFunction, writes: [JetRustEmitUse], block: Int, position: Int) -> Bool Never! {
    reached := [Int:Bool]{}
    pending := [Int]{block}
    loop pending.len() > 0 {
        at :: &pending.pop() ?? { break }
        loop target in mir_terminator_targets(function.blocks[at].terminator) {
            if ctx.body_index.block_positions.get(target.value) == .Val(target_position) {
                if reached.get(target_position) == None {
                    _ := &reached.add(target_position, true)
                    &pending.push(target_position)
                }
            }
        }
    }
    loop write in writes {
        if reached.get(write.block) != None || (write.block == block && write.instruction > position) -> return false
    }
    true
}

// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::local_unchanged_until_uses
fn jet_rust_emit_local_unchanged_until_uses(ctx: JetRustEmitContext, function: MIRFunction, value: MIRValueID, local: MIRLocalID) -> Bool Never! {
    if ctx.body_index.escaped_locals.get(local.value) != None -> return false
    write_slot :: ctx.body_index.write_slots.get(local.value) ?? -1
    writes :: if write_slot >= 0 -> ctx.body_index.local_writes[write_slot] else -> [JetRustEmitUse]{}
    jet_rust_emit_unchanged_until_uses(ctx, function, value, writes)
}

// MIRRust unchanged_until_uses: whether none of `writes` runs between the
// definition of `value` and any use of it, along paths that do not pass the
// definition again.
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::unchanged_until_uses
fn jet_rust_emit_unchanged_until_uses(ctx: JetRustEmitContext, function: MIRFunction, value: MIRValueID, writes: [JetRustEmitUse]) -> Bool Never! {
    read_block :: ctx.body_index.definition_blocks.get(value.value) ?? return false
    read_position :: ctx.body_index.definition_positions.get(value.value) ?? return false
    use_slot :: ctx.body_index.use_slots.get(value.value) ?? return true
    first_write := -1
    loop write in writes {
        if write.block == read_block && write.instruction > read_position && (first_write < 0 || write.instruction < first_write) -> first_write = write.instruction
    }
    // Blocks from which a use is reachable without passing the read.
    region := [Int:Bool]{}
    pending := [Int]{}
    loop user in ctx.body_index.uses[use_slot] {
        if user.block == read_block {
            at :: if user.instruction < 0 -> function.blocks[user.block].instructions.len() else -> user.instruction
            if first_write >= 0 && first_write <= at -> return false
        } else if region.get(user.block) == None {
            _ := &region.add(user.block, true)
            &pending.push(user.block)
        }
    }
    if pending.len() == 0 -> return true
    loop pending.len() > 0 {
        block :: &pending.pop() ?? { break }
        loop predecessor in ctx.body_index.predecessors[block] {
            if predecessor != read_block && region.get(predecessor) == None {
                _ := &region.add(predecessor, true)
                &pending.push(predecessor)
            }
        }
    }
    // A use past the read block's end: the rest of the read block runs
    // first, then any region block may (conservatively, all of it).
    if first_write >= 0 -> return false
    loop write in writes {
        if region.get(write.block) != None -> return false
    }
    true
}

// MIRRust plan_ref_bindings (#4318): the binding locals of `function` that
// hold a shared reference to the value they bind instead of a copy of it.
// Every write of such a local binds, read once and earlier in the writing
// block, a plain enum, option or result payload of a stable place, or the
// stable place itself (`x :: p.f`). A stable place is rooted at a read
// parameter, which nothing changes while the function runs, at a write
// parameter whose overlapping places nothing may change once the bound read
// is made (jet_rust_emit_parameter_place_writes), or at another reference
// binding, whose referent is just as stable however that binding is later
// rebound. Nothing else writes the local, borrows it for writing, moves
// out of a projection of it, captures it or lets it escape. Its reads then
// borrow the referent; a consuming move copies the referent, as the binding
// did before; a whole move that only feeds a drop releases nothing.
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::plan_ref_bindings
fn jet_rust_emit_ref_bindings(ctx: &JetRustEmitContext, function: MIRFunction) -> JetRustEmitRefBindings Never! {
    bindings := jet_rust_emit_empty_ref_bindings()
    if function.optimization.checked_vector_facts.len() > 0 || function.generator != None -> return bindings
    loop block in function.blocks {
        if block.terminator == .Yield(_, _) -> return bindings
    }
    // Places rooted at a local (and whether they project), values some place
    // is rooted at (read through that place too), and rejected locals.
    place_locals := [U64:MIRLocalID]{}
    whole_places := [U64:Bool]{}
    rooted := [U64:Bool]{}
    rejected := [U64:Bool]{}
    loop place in function.places {
        if place.base == {
            .Local(local) -> {
                _ := &place_locals.add(place.id.value, local)
                if place.projections.len() == 0 -> _ := &whole_places.add(place.id.value, true)
                if place.persist_key != None -> _ := &rejected.add(local.value, true)
            }
            .Temporary(value) -> _ := &rooted.add(value.value, true)
            else -> {}
        }
    }
    loop local in function.locals {
        storage :: place_locals.get(local.place.value) == (Val(local.id)) && whole_places.get(local.place.value) != None
        if !storage || local.mutable || local.uninit || local.is_comptime || local.arena_view || local.string_view || local.gc_root || jet_rust_emit_local_is_allocator_view(function, local.id) || jet_rust_emit_copy_scalar_type(jet_rust_emit_type(&ctx, local.ty)) || jet_rust_emit_local_is_shared(&ctx, local.id) {
            _ := &rejected.add(local.id.value, true)
            next
        }
        loop row in ctx.program.handles {
            if jet_rust_emit_same_handle_type(row.ty, local.ty) -> _ := &rejected.add(local.id.value, true)
        }
        if jet_rust_emit_partial_root_has(ctx, function, MIRPlaceBase.Local{local: local.id}) -> _ := &rejected.add(local.id.value, true)
    }
    // Using instructions per value (a terminator use never qualifies).
    use_counts := [U64:Int]{}
    loop block in function.blocks {
        loop instruction in block.instructions {
            seen := [U64:Bool]{}
            loop used in mir_operation_value_uses(instruction.operation) {
                if seen.get(used.value) != None -> next
                _ := &seen.add(used.value, true)
                _ := &use_counts.add(used.value, (use_counts.get(used.value) ?? 0) + 1)
            }
        }
        loop used in mir_terminator_value_uses(block.terminator) -> _ := &use_counts.add(used.value, (use_counts.get(used.value) ?? 0) + 2)
    }
    candidates :: jet_rust_emit_borrowed_loop_candidates(&ctx, function, use_counts)
    // MIRRust FunctionIndex local_writes: the operations that may change or
    // release a local, in two passes since a write borrow's definition may
    // sit in a block listed after one of its uses. Only a binding write from
    // a stable source and a whole move are allowed on a candidate.
    borrows := [U64:MIRLocalID]{}
    touches := [String:Bool]{}
    writes := [U64:[JetRustEmitRefSource]]{}
    order := [MIRLocalID]{}
    loop pass in 0..<2 {
        touches = [String:Bool]{}
        loop (block_position, block) in function.blocks {
            loop (position, instruction) in block.instructions {
                touched := [MIRLocalID]{}
                allowed := MIRLocalID?{None}
                if instruction.operation == {
                    .ReadPlace(place) -> {
                        if place_locals.get(place.value) == .Val(local) && instruction.result == .Val(result) {
                            if jet_rust_emit_value_mode(ctx, function, result) == MIROwnershipMode.WriteBorrow -> &touched.push(local)
                        }
                    }
                    .AddressOf(place, access) -> {
                        if place_locals.get(place.value) == .Val(local) {
                            if access == MIRAccess.Move {
                                _ := &rejected.add(local.value, true)
                            } else if access != MIRAccess.Read {
                                &touched.push(local)
                            }
                        }
                    }
                    .MovePlace(place) -> {
                        if place_locals.get(place.value) == .Val(local) {
                            if whole_places.get(place.value) == None {
                                _ := &rejected.add(local.value, true)
                            } else {
                                &touched.push(local)
                                allowed = Val(local)
                            }
                        }
                    }
                    .WritePlace(place, value) -> {
                        if place_locals.get(place.value) == .Val(local) {
                            &touched.push(local)
                            if pass == 1 && whole_places.get(place.value) != None && rooted.get(value.value) == None {
                                if jet_rust_emit_ref_binding_source(&ctx, function, value, block_position, position, use_counts, touches, candidates) == .Val(source) {
                                    allowed = Val(local)
                                    rows := writes.get(local.value) ?? [JetRustEmitRefSource]{}
                                    if rows.len() == 0 -> &order.push(local)
                                    &rows.push(source)
                                    _ := &writes.add(local.value, rows)
                                }
                            }
                        }
                    }
                    .InitializeUninit(place) | .ReplacePlace(place, _) -> {
                        if place_locals.get(place.value) == .Val(local) -> &touched.push(local)
                    }
                    .RawAddressOf(place) -> {
                        if place_locals.get(place.value) == .Val(local) -> _ := &rejected.add(local.value, true)
                    }
                    .Closure(_, captures, _) -> {
                        loop capture in captures {
                            if capture == .Place(place) {
                                if place_locals.get(place.value) == .Val(local) -> _ := &rejected.add(local.value, true)
                            }
                        }
                    }
                    .Call(_, args, _) | .IndirectCall(_, args, _) | .CoreCall(_, _, args, _, _, _) -> jet_rust_emit_ref_write_args(args, place_locals, &touched)
                    .Semantic(op) -> {
                        if op == {
                            .BuiltinMethod(_, _, receiver_place, _, _) -> {
                                if receiver_place == .Val(place) {
                                    if place_locals.get(place.value) == .Val(local) -> _ := &rejected.add(local.value, true)
                                }
                            }
                            .DataEntriesToMap(_, entry_local) -> _ := &rejected.add(entry_local.value, true)
                            .StaticPreludeCall(_, args, _, _) | .HardwareCall(_, _, _, args) | .ClosureMethod(_, args, _) | .HostCall(_, args) -> jet_rust_emit_ref_write_args(args, place_locals, &touched)
                            else -> {}
                        }
                    }
                    else -> {}
                }
                loop used in mir_operation_value_uses(instruction.operation) {
                    if borrows.get(used.value) == .Val(root) -> &touched.push(root)
                }
                if touched.len() > 0 && instruction.result == .Val(result) {
                    if jet_rust_emit_value_mode(ctx, function, result) == MIROwnershipMode.WriteBorrow -> _ := &borrows.add(result.value, touched[0])
                }
                loop local in touched {
                    _ := &touches.add("{local.value}:{block_position}:{position}", true)
                    if pass == 1 && allowed != (Val(local)) -> _ := &rejected.add(local.value, true)
                }
            }
        }
    }
    live := [U64:Bool]{}
    loop local in order -> _ := &live.add(local.value, rejected.get(local.value) == None)
    active := [U64:Bool]{}
    loop candidate in candidates -> _ := &active.add(candidate.cursor.value, true)
    loop {
        // A binding rooted at another binding needs that one to stay a
        // reference binding too.
        changed := true
        loop changed {
            changed = false
            loop local in order {
                if live.get(local.value) != (Val(true)) -> next
                sources :: writes.get(local.value) ?? [JetRustEmitRefSource]{}
                loop source in sources {
                    if source.root == .Val(root) {
                        if root == local || live.get(root.value) != (Val(true)) {
                            _ := &live.add(local.value, false)
                            changed = true
                            break
                        }
                    }
                }
            }
        }
        // A cursor walks its list in place only when every element it yields
        // binds a reference; otherwise its bindings copy again.
        bound := [U64:Bool]{}
        loop local in order {
            if live.get(local.value) != (Val(true)) -> next
            sources :: writes.get(local.value) ?? [JetRustEmitRefSource]{}
            loop source in sources -> _ := &bound.add(source.value.value, true)
        }
        failed := [U64:Bool]{}
        loop candidate in candidates {
            if active.get(candidate.cursor.value) != (Val(true)) -> next
            loop user in jet_rust_emit_value_users(ctx, function, candidate.cursor) {
                if user.instruction < 0 -> next
                instruction :: function.blocks[user.block].instructions[user.instruction]
                if instruction.operation == .LoopIterValue(_, _) {
                    element_bound := false
                    if instruction.result == .Val(element) -> element_bound = bound.get(element.value) != None
                    if !element_bound -> _ := &failed.add(candidate.cursor.value, true)
                }
            }
        }
        if failed.len() == 0 -> break
        loop candidate in candidates {
            if failed.get(candidate.cursor.value) != None -> _ := &active.add(candidate.cursor.value, false)
        }
        loop local in order {
            if live.get(local.value) != (Val(true)) -> next
            sources :: writes.get(local.value) ?? [JetRustEmitRefSource]{}
            loop source in sources {
                written :: jet_rust_emit_find_value_instruction(ctx, function, source.value) ?? next
                if written.operation == .LoopIterValue(_, cursor) {
                    if failed.get(cursor.value) != None -> _ := &live.add(local.value, false)
                }
            }
        }
    }
    loop candidate in candidates {
        if active.get(candidate.cursor.value) != (Val(true)) -> next
        _ := &bindings.cursors.add(candidate.cursor.value, candidate.place)
        _ := &bindings.collections.add(candidate.collection.value, true)
    }
    loop local in order {
        if live.get(local.value) != (Val(true)) -> next
        _ := &bindings.locals.add(local.value, true)
        sources :: writes.get(local.value) ?? [JetRustEmitRefSource]{}
        loop source in sources {
            // A moved payload (`x :: p ?? return`) has no slot either.
            if jet_rust_emit_find_value_instruction(ctx, function, source.value) == .Val(written) {
                if written.operation == .Move(payload) -> _ := &bindings.payloads.add(payload.value, true)
            }
            _ := &bindings.payloads.add(source.value.value, true)
        }
    }
    bindings
}

// MIRRust borrowed_loop_candidates (#4318): read loops that may walk their
// list in place: a plain, unstepped `LoopIterInit` over a `Vec` collection
// read once, from a stable place (jet_rust_emit_immutable_read_place) that
// nothing may change while the cursor is live
// (jet_rust_emit_unchanged_until_uses over the cursor's uses, which span the
// whole loop), whose cursor only feeds its own has-next, value, advance and
// drop. Each row names the cursor, its collection, the place, and the
// reference binding the place is rooted at, if any (a rebinding of that
// local leaves the walked referent as it was).
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::borrowed_loop_candidates
fn jet_rust_emit_borrowed_loop_candidates(ctx: &JetRustEmitContext, function: MIRFunction, use_counts: [U64:Int]) -> [JetRustEmitLoopCandidate] Never! {
    candidates := [JetRustEmitLoopCandidate]{}
    if function.optimization.vector_facts.len() > 0 || function.optimization.acceleration_facts.len() > 0 -> return candidates
    loop block in function.blocks {
        loop instruction in block.instructions {
            if instruction.operation == .LoopIterInit(_, collection, step, by_value, source_kind) {
                cursor :: instruction.result ?? next
                if step != None || by_value || source_kind != MIRLoopSourceKind.Plain -> next
                if use_counts.get(collection.value) != (Val(1)) -> next
                if jet_rust_emit_value_mode(ctx, function, collection) == MIROwnershipMode.WriteBorrow -> next
                if jet_rust_emit_transparent_read(ctx, function, collection) == .Val(read) {
                    if jet_rust_emit_value_mode(ctx, function, read) == MIROwnershipMode.WriteBorrow -> next
                }
                collection_type :: jet_rust_emit_value_type(ctx, function, collection)
                if jet_rust_emit_byte_loop_collection(collection_type) || jet_rust_emit_shared_constant_value(&ctx, function, collection) -> next
                if !jet_rust_emit_type(&ctx, collection_type).starts_with("Vec<") -> next
                if !jet_rust_emit_loop_cursor_only(ctx, function, cursor) -> next
                place_id :: jet_rust_emit_immutable_read_place(&ctx, function, collection) ?? next
                row :: ctx.body_index.place_rows.get(place_id.value) ?? next
                place :: function.places[row]
                root := MIRLocalID?{None}
                if place.base == {
                    .Parameter(parameter) -> {
                        access :: jet_rust_emit_parameter_access(ctx, function, parameter) ?? next
                        if access == MIRAccess.Read {
                            if jet_rust_emit_place_is_window(&ctx, function, place_id) -> next
                        } else if access == MIRAccess.Write {
                            writes :: jet_rust_emit_parameter_place_writes(ctx, function, place) ?? next
                            if !jet_rust_emit_unchanged_until_uses(ctx, function, cursor, writes) -> next
                        } else {
                            next
                        }
                    }
                    .Local(local) -> {
                        write_slot :: ctx.body_index.write_slots.get(local.value) ?? -1
                        writes :: if write_slot >= 0 -> ctx.body_index.local_writes[write_slot] else -> [JetRustEmitUse]{}
                        if ctx.body_index.escaped_locals.get(local.value) != None || !jet_rust_emit_unchanged_until_uses(ctx, function, cursor, writes) -> root = Val(local)
                    }
                    else -> next
                }
                &candidates.push(JetRustEmitLoopCandidate{cursor: cursor, collection: collection, place: place_id, root: root})
            }
        }
    }
    candidates
}

// Whether `cursor` only feeds its own has-next, value, advance and drop.
fn jet_rust_emit_loop_cursor_only(ctx: JetRustEmitContext, function: MIRFunction, cursor: MIRValueID) -> Bool Never! {
    loop user in jet_rust_emit_value_users(ctx, function, cursor) {
        if user.instruction < 0 -> return false
        used :: if function.blocks[user.block].instructions[user.instruction].operation == {
            .LoopIterHasNext(_, operand) | .LoopIterValue(_, operand) | .LoopIterAdvance(_, operand) -> operand == cursor
            .Drop(operand, _) -> operand == cursor
            else -> false
        }
        if !used -> return false
    }
    true
}

fn jet_rust_emit_ref_write_args(args: [MIRCallArg], place_locals: [U64:MIRLocalID], touched: &[MIRLocalID]) Never! {
    loop arg in args {
        if arg.access != MIRAccess.Read && arg.place == .Val(place) {
            if place_locals.get(place.value) == .Val(local) -> &touched.push(local)
        }
    }
}

// MIRRust ref_binding_source: the source of a binding write at `(block,
// position)` when `value` is a plain payload of a stable place, or a stable
// place itself, used only by that write and defined earlier in the same
// block with nothing changing the place's root in between (`touches`: the
// writes seen so far). The root is None for a read parameter, or a write
// parameter that nothing may change from the read on, else the local that
// must itself be a reference binding. A `value` that only moves such a
// payload, used by nothing else (the unwrap of `x :: p ?? return`), binds
// that payload. An element of a candidate in-place loop
// (jet_rust_emit_borrowed_loop_candidates) binds by reference into the walked
// list, rooted as that list's place.
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::ref_binding_source
fn jet_rust_emit_ref_binding_source(ctx: &JetRustEmitContext, function: MIRFunction, value: MIRValueID, block: Int, position: Int, use_counts: [U64:Int], touches: [String:Bool], candidates: [JetRustEmitLoopCandidate]) -> JetRustEmitRefSource? {
    if use_counts.get(value.value) != (Val(1)) -> return None
    def_block :: ctx.body_index.definition_blocks.get(value.value) ?? return None
    def_position :: ctx.body_index.definition_positions.get(value.value) ?? return None
    if def_block != block || def_position >= position -> return None
    bound := value
    bound_block := block
    bound_position := def_position
    if function.blocks[block].instructions[def_position].operation == .Move(payload) {
        if use_counts.get(payload.value) != (Val(1)) -> return None
        bound_block = ctx.body_index.definition_blocks.get(payload.value) ?? return None
        bound_position = ctx.body_index.definition_positions.get(payload.value) ?? return None
        if function.blocks[bound_block].instructions[bound_position].operation == {
            .EnumPayload(_, _, _, _) | .OptionValue(_) | .ResultValue(_, _) -> bound = payload
            else -> return None
        }
    }
    read := value
    if function.blocks[bound_block].instructions[bound_position].operation == {
        .EnumPayload(subject, owner, variant, index) -> {
            if ctx.move_facts.payload_subjects.get("{bound.value}") != None -> return None
            if jet_rust_emit_plain_payload_pattern(&ctx, owner, variant, index) == None -> return None
            read = subject
        }
        .OptionValue(subject) | .ResultValue(subject, _) -> read = subject
        .ReadPlace(_) -> {}
        .LoopIterValue(_, cursor) -> {
            loop candidate in candidates {
                if candidate.cursor != cursor -> next
                element_type :: jet_rust_emit_value_type(ctx, function, value)
                list_type :: jet_rust_emit_value_type(ctx, function, candidate.collection)
                element :: jet_rust_emit_type(&ctx, element_type)
                list :: jet_rust_emit_type(&ctx, list_type)
                if list != "Vec<{element}>" -> return None
                return Val(JetRustEmitRefSource{value: value, root: candidate.root})
            }
            return None
        }
        else -> return None
    }
    place_id :: jet_rust_emit_immutable_read_place(&ctx, function, read) ?? return None
    loop place in function.places {
        if place.id != place_id -> next
        if place.base == {
            .Parameter(parameter) -> {
                // A range-window parameter reads as a copied list, not in place.
                if jet_rust_emit_place_is_window(&ctx, function, place_id) -> return None
                // A write parameter's place stays as bound when nothing that
                // may change it can run once its payload or value is read.
                if jet_rust_emit_parameter_access(ctx, function, parameter) == (Val(MIRAccess.Write)) {
                    writes :: jet_rust_emit_parameter_place_writes(ctx, function, place) ?? return None
                    if !jet_rust_emit_unchanged_after(ctx, function, writes, bound_block, bound_position) -> return None
                }
                return Val(JetRustEmitRefSource{value: value, root: None})
            }
            .Local(root) -> {
                if bound_block != block -> return None
                loop at in (bound_position + 1)..<position {
                    if touches.get("{root.value}:{block}:{at}") != None -> return None
                }
                return Val(JetRustEmitRefSource{value: value, root: Val(root)})
            }
            else -> return None
        }
    }
    None
}

// MIRRust ref_binding_drop: a whole move out of a reference binding whose
// every user drops it; the binding owns nothing, so neither copies.
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::ref_binding_drop
fn jet_rust_emit_ref_binding_drop(ctx: &JetRustEmitContext, function: MIRFunction, value: MIRValueID) -> MIRLocalID? {
    if ctx.ref_bindings.locals.len() == 0 -> return None
    producer :: jet_rust_emit_find_value_instruction(ctx, function, value) ?? return None
    place_id := MIRPlaceID?{None}
    if producer.operation == {
        .MovePlace(place) -> place_id = Val(place)
        else -> return None
    }
    id :: place_id ?? return None
    loop place in function.places {
        if place.id != id -> next
        if place.projections.len() > 0 -> return None
        if place.base == .Local(local) {
            if ctx.ref_bindings.locals.get(local.value) == None || !jet_rust_emit_value_dropped_only(ctx, function, value) -> return None
            return Val(local)
        }
        return None
    }
    None
}

// A shared reference for a consumer that only inspects `value`: the stable
// place `value` reads (jet_rust_emit_immutable_read_place), else the value slot.
fn jet_rust_emit_inspected_value_reference(ctx: &JetRustEmitContext, function: MIRFunction, value: MIRValueID) -> String Never! {
    place :: jet_rust_emit_immutable_read_place(&ctx, function, value) ?? return jet_rust_emit_value_reference(ctx, value, false)
    jet_rust_emit_place_reference(&ctx, function, place, MIRAccess.Read)
}

// A builtin mutating route writes through its checked receiver place
// (jet_rust_emit_builtin_method_values) and never reads the receiver value.
fn jet_rust_emit_builtin_place_receiver(operation: MIROperation, value: MIRValueID) -> Bool Never! {
    if operation == {
        .Semantic(semantic) -> {
            if semantic == {
                .BuiltinMethod(_, receiver, receiver_place, args, _) -> return receiver == value && receiver_place != None && !args.contains(value)
                else -> return false
            }
        }
        else -> return false
    }
}

// A consumer that renders every use of `value` through
// jet_rust_emit_borrowed_value_reference: an index base, the receiver or
// arguments a builtin route borrows (jet_rust_emit_builtin_method_values), and
// the borrowed arguments of a call or host call of any dispatch. Over a
// `ReadPlace` that reference names the place itself, so the consumer never reads
// the value slot (MIRRust borrowed_operation_use, direct_borrow_only). A
// shared-guard deref reads through the guard's place (jet_rust_emit_deref), and
// a field of a guard-origin value through the guarded place
// (jet_rust_emit_shared_guard_borrow_place).
fn jet_rust_emit_place_borrowing_use(ctx: &JetRustEmitContext, function: MIRFunction, operation: MIROperation, value: MIRValueID) -> Bool Never! {
    if operation == {
        .Index(_, base, index, _, access, _, _) -> return base == value && index != value && access != MIRAccess.Move
        .Call(callee, args, _) -> return jet_rust_emit_direct_borrow_call(&ctx, function, callee, args, value)
        .Deref(operand) -> return operand == value && jet_rust_emit_is_shared_guard_type(jet_rust_emit_value_type(ctx, function, operand))
        .Field(base, _) -> return base == value && jet_rust_emit_shared_guard_borrow_origin(&ctx, function, base)
        .Semantic(semantic) -> {
            if semantic == {
                .BuiltinMethod(call, receiver, receiver_place, args, _) -> {
                    if receiver_place != None && receiver == value -> return false
                    row :: jet_rust_emit_prelude_route(ctx, call, false) ?? return false
                    mask :: row.signature.borrow_mask
                    if mask.len() != args.len() + 1 -> return false
                    if receiver == value && !mask[0] -> return false
                    loop (index, arg) in args {
                        if arg != value -> next
                        if !mask[index + 1] || jet_rust_emit_builtin_native_int_arg(row, index, true, jet_rust_emit_value_type(ctx, function, arg)) -> return false
                    }
                    return true
                }
                // MIRRust borrowed_operation_use: a handle route lends every
                // operand its mask borrows (jet_rust_emit_handle_method_values).
                .HandleMethod(call, receiver, args, _, _) -> {
                    row :: jet_rust_emit_prelude_route(ctx, call, false) ?? return false
                    mask :: row.signature.borrow_mask
                    if mask.len() != args.len() + 1 -> return false
                    if receiver == value && !mask[0] -> return false
                    loop (index, arg) in args {
                        if arg == value && !mask[index + 1] -> return false
                    }
                    return true
                }
                // A host call renders exactly as a Prelude call (jet_rust_emit_prelude_call).
                .HostCall(call, args) -> return jet_rust_emit_direct_borrow_call(&ctx, function, MIRCallee.Prelude{call: call}, args, value)
                else -> return false
            }
        }
        else -> return false
    }
}

// MIRRust shared_guard_borrow_origin: a shared-guard deref, or a field chain
// over one, borrows the guarded value instead of owning a copy of it.
fn jet_rust_emit_shared_guard_borrow_origin(ctx: &JetRustEmitContext, function: MIRFunction, value: MIRValueID) -> Bool Never! {
    instruction :: jet_rust_emit_find_value_instruction(ctx, function, value) ?? return false
    if instruction.operation == {
        .Deref(guard) -> return jet_rust_emit_is_shared_guard_type(jet_rust_emit_value_type(ctx, function, guard))
        .Field(base, _) -> return jet_rust_emit_shared_guard_borrow_origin(&ctx, function, base)
        else -> return false
    }
}

// MIRRust shared_guard_borrow_place: the guarded place a guard-origin value
// names, `**(guard)` under its field chain, with the guard borrowed from its
// own place when it reads or addresses one; None for any other value.
fn jet_rust_emit_shared_guard_borrow_place(ctx: &JetRustEmitContext, function: MIRFunction, value: MIRValueID, access: MIRAccess) -> String? Never! {
    instruction :: jet_rust_emit_find_value_instruction(ctx, function, value) ?? return None
    if instruction.operation == {
        .Deref(guard) -> {
            if !jet_rust_emit_is_shared_guard_type(jet_rust_emit_value_type(ctx, function, guard)) -> return None
            reference := jet_rust_emit_value_reference(ctx, guard, access == MIRAccess.Write)
            if jet_rust_emit_find_value_instruction(ctx, function, guard) == .Val(definition) {
                if definition.operation == {
                    .AddressOf(place, _) | .ReadPlace(place) -> reference = jet_rust_emit_place_reference(&ctx, function, place, access)
                    else -> {}
                }
            }
            return Val("**({reference})")
        }
        .Field(base, field) -> {
            if !jet_rust_emit_shared_guard_borrow_origin(&ctx, function, base) -> return None
            place :: jet_rust_emit_shared_guard_borrow_place(&ctx, function, base, access) ?? return None
            return Val("({place}).{jet_rust_emit_field_name(&ctx, field)}")
        }
        else -> return None
    }
}

// MIRRust direct_borrow_projection over a guard-origin value: when every
// consumer only borrows it (jet_rust_emit_place_borrowing_use), the value is
// never stored in its slot, so no bitwise copy of the guarded value is made
// (the Rust emitter's elided_shared_guard_base). Field reads and borrowed
// references name the guarded place instead.
fn jet_rust_emit_shared_guard_projection_only(ctx: &JetRustEmitContext, function: MIRFunction, value: MIRValueID) -> Bool Never! {
    if !jet_rust_emit_shared_guard_borrow_origin(&ctx, function, value) -> return false
    // A place projecting from the value's own slot reads that slot.
    if jet_rust_emit_value_slot_read(ctx, function, value) -> return false
    used := false
    loop user in jet_rust_emit_value_users(ctx, function, value) {
        if user.instruction < 0 -> return false
        if !jet_rust_emit_place_borrowing_use(&ctx, function, function.blocks[user.block].instructions[user.instruction].operation, value) -> return false
        used = true
    }
    used
}

// D-MEM-COPYSEM1: true when `value` reads a stable place and every consumer
// only inspects it (variant tests, payload reads, comparisons of non-scalar
// operands, a borrowing slice), so the copy is never emitted. A read or
// address that only feeds consumers borrowing the place itself (builtin routes
// writing through it, index bases, borrowed builtin operands) is never emitted
// either (MIRRust direct_borrow_only). #4318 §8: neither is a transparent
// transfer of a read whose consumers only inspect it, nor a read that only
// such a transfer consumes (jet_rust_emit_inspected_transfer).
fn jet_rust_emit_inspected_only(ctx: &JetRustEmitContext, function: MIRFunction, value: MIRValueID) -> Bool Never! {
    instruction :: jet_rust_emit_find_value_instruction(ctx, function, value) ?? return false
    address := false
    if instruction.operation == {
        .ReadPlace(_) -> {}
        // MIRRust direct_borrow_projection: a Read or Write address; a Move
        // address is a consuming partial move here.
        .AddressOf(_, access) -> {
            if access == MIRAccess.Move -> return false
            address = true
        }
        .Move(_) | .Copy(_, _) -> return jet_rust_emit_inspected_transfer(&ctx, function, value)
        else -> return false
    }
    // A place projecting from the value's own slot reads that slot, so an
    // instruction naming such a place is a use the value-use rows do not see.
    if jet_rust_emit_value_slot_read(ctx, function, value) -> return false
    used := false
    place_receivers_only := true
    loop user in jet_rust_emit_value_users(ctx, function, value) {
        if user.instruction < 0 {
            if !jet_rust_emit_switch_subject_use(function, user, value) -> return false
            used = true
            next
        }
        operation :: function.blocks[user.block].instructions[user.instruction].operation
        used = true
        transfer :: function.blocks[user.block].instructions[user.instruction].result
        if transfer == .Val(result) {
            transfers_read :: jet_rust_emit_transparent_read(ctx, function, result) == .Val(value)
            if transfers_read && jet_rust_emit_inspected_transfer(&ctx, function, result) -> next
        }
        if jet_rust_emit_builtin_place_receiver(operation, value) || jet_rust_emit_place_borrowing_use(&ctx, function, operation, value) -> next
        place_receivers_only = false
        inspects :: if operation == {
            .EnumIs(subject, _, _) -> subject == value
            .EnumPayload(subject, _, _, _) -> subject == value
            .OptionIsSome(subject) -> subject == value
            .OptionValue(subject) -> subject == value
            .ResultIsOk(subject) -> subject == value
            .ResultValue(subject, _) -> subject == value
            .Binary(op, dispatch, _, left, _) -> dispatch == .Primitive && jet_rust_emit_comparison_by_reference(&ctx, function, op, left)
            .Slice(call, base, start, end, range, _) -> base == value && start != value && end != value && range != (Val(value)) && jet_rust_emit_slice_borrows_base(&ctx, call)
            else -> false
        }
        if !inspects -> return false
    }
    used && (place_receivers_only || (!address && jet_rust_emit_immutable_read_place(&ctx, function, value) != None))
}

// True when some instruction names a place projecting from `value`'s own
// slot (body_index.slot_read_values for the function being printed).
fn jet_rust_emit_value_slot_read(ctx: JetRustEmitContext, function: MIRFunction, value: MIRValueID) -> Bool Never! {
    if ctx.body_index.function == (Val(function.id)) -> return ctx.body_index.slot_read_values.get(value.value) != None
    slot_places := [U64:Bool]{}
    loop row in function.places {
        if row.base == .Temporary(base) {
            if base == value -> _ := &slot_places.add(row.id.value, true)
        }
    }
    if slot_places.len() == 0 -> return false
    loop block in function.blocks {
        loop instruction in block.instructions {
            loop place in mir_operation_place_uses(instruction.operation) {
                if slot_places.get(place.value) != None -> return true
            }
        }
    }
    false
}

// The slice route borrows its base (`jet_rust_emit_slice`).
fn jet_rust_emit_slice_borrows_base(ctx: &JetRustEmitContext, call: MIRPreludeCallID) -> Bool Never! {
    route :: jet_rust_emit_prelude_row(&ctx, call) ?? return false
    route.signature.borrow_mask.len() > 0 && route.signature.borrow_mask[0]
}

// True when some instruction moves a field path out of `base`.
fn jet_rust_emit_partial_root_has(ctx: JetRustEmitContext, function: MIRFunction, base: MIRPlaceBase) -> Bool Never! {
    if ctx.body_index.function == (Val(function.id)) -> return ctx.body_index.partial_slots.get(jet_rust_emit_place_base_identity(base)) != None
    jet_rust_emit_partial_base_paths(ctx, function, base).len() > 0
}

// The field paths of the partial moves out of `base`, in body order: the
// indexed rows of the function being printed, else one walk of `function`.
fn jet_rust_emit_partial_base_paths(ctx: JetRustEmitContext, function: MIRFunction, base: MIRPlaceBase) -> [[MIRFieldID]] Never! {
    if ctx.body_index.function == (Val(function.id)) {
        slot :: ctx.body_index.partial_slots.get(jet_rust_emit_place_base_identity(base)) ?? return [[MIRFieldID]]{}
        return ctx.body_index.partial_paths[slot]
    }
    paths := [[MIRFieldID]]{}
    loop block in function.blocks {
        loop instruction in block.instructions {
            moved :: if instruction.operation == {
                .MovePlace(place) -> Val(place)
                .AddressOf(place, access) -> if access == MIRAccess.Move -> Val(place) else -> MIRPlaceID?{None}
                else -> MIRPlaceID?{None}
            }
            place :: moved ?? next
            loop (row, candidate) in function.places {
                if candidate.id != place -> next
                if candidate.base == base {
                    path :: jet_rust_emit_place_row_field_path(function, row)
                    if path.len() > 0 -> &paths.push(path)
                }
                break
            }
        }
    }
    paths
}

fn jet_rust_emit_partial_path_starts_with(path: [MIRFieldID], prefix: [MIRFieldID]) -> Bool Never! {
    if path.len() < prefix.len() -> return false
    loop (index, field) in prefix {
        if path[index] != field -> return false
    }
    true
}

fn jet_rust_emit_partial_node_slot(base: MIRPlaceBase, prefix: [MIRFieldID]) -> String Never! {
    if prefix.len() == 0 -> jet_rust_emit_partial_root_slot(base) else -> jet_rust_emit_partial_field_slot(base, prefix)
}

fn jet_rust_emit_partial_node_owner(ctx: &JetRustEmitContext, function: MIRFunction, base: MIRPlaceBase, prefix: [MIRFieldID]) -> MIRTypeID? {
    loop path in jet_rust_emit_partial_base_paths(ctx, function, base) {
        if path.len() > prefix.len() && jet_rust_emit_partial_path_starts_with(path, prefix) -> return jet_rust_emit_partial_owner(&ctx, path[prefix.len()])
    }
    None
}

fn jet_rust_emit_partial_node_type(function: MIRFunction, base: MIRPlaceBase, prefix: [MIRFieldID]) -> MIRType? {
    if prefix.len() == 0 {
        if base == {
            .Local(local) -> {
                loop row in function.locals { if row.id == local -> return Val(row.ty) }
                return None
            }
            .Parameter(value) | .Capture(value) | .Temporary(value) -> {
                loop row in function.values { if row.id == value -> return Val(row.ty) }
                return None
            }
            .Static(_) -> return None
        }
    }
    loop row in function.places {
        if row.base == base {
            path :: jet_rust_emit_place_projection_path(function, row.id)
            if path.len() == prefix.len() && jet_rust_emit_partial_path_starts_with(path, prefix) -> return Val(row.ty)
        }
    }
    None
}

fn jet_rust_emit_partial_type_instance(ctx: &JetRustEmitContext, ty: MIRType) -> MIRType Never! {
    loop instance in ctx.program.type_instances {
        if mir_type_same_checked_type(ty, instance) -> return instance
    }
    ~ty
}

fn jet_rust_emit_partial_substitute_type(ctx: &JetRustEmitContext, source: MIRType, parameters: [MIRGenericParam], arguments: [MIRType]) -> MIRType Never! {
    if source.kind == {
        .Apply(name, nested) -> {
            if nested.len() == 0 {
                loop (index, parameter) in parameters {
                    if parameter.name == name.name && name.id == mir_type_id(parameter.name) {
                        if index < arguments.len() -> return arguments[index]
                        return ~source
                    }
                }
            }
            mapped :: loop item in nested -> jet_rust_emit_partial_substitute_type(&ctx, item, parameters, arguments)
            jet_rust_emit_partial_type_instance(&ctx, mir_type_from_kind(MIRTypeKind.Apply{name: name, args: mapped}))
        }
        .List(inner) -> {
            mapped :: jet_rust_emit_partial_substitute_type(&ctx, inner, parameters, arguments)
            jet_rust_emit_partial_type_instance(&ctx, mir_type_from_kind(MIRTypeKind.List{inner: mapped}))
        }
        .Map(key, value) -> {
            mapped_key :: jet_rust_emit_partial_substitute_type(&ctx, key, parameters, arguments)
            mapped_value :: jet_rust_emit_partial_substitute_type(&ctx, value, parameters, arguments)
            jet_rust_emit_partial_type_instance(&ctx, mir_type_from_kind(MIRTypeKind.Map{key: mapped_key, value: mapped_value}))
        }
        .Shared(inner) -> {
            mapped :: jet_rust_emit_partial_substitute_type(&ctx, inner, parameters, arguments)
            jet_rust_emit_partial_type_instance(&ctx, mir_type_from_kind(MIRTypeKind.Shared{inner: mapped}))
        }
        .Option(inner) -> {
            mapped :: jet_rust_emit_partial_substitute_type(&ctx, inner, parameters, arguments)
            jet_rust_emit_partial_type_instance(&ctx, mir_type_from_kind(MIRTypeKind.Option{inner: mapped}))
        }
        .Result(ok, err) -> {
            mapped_ok :: jet_rust_emit_partial_substitute_type(&ctx, ok, parameters, arguments)
            mapped_err :: jet_rust_emit_partial_substitute_type(&ctx, err, parameters, arguments)
            jet_rust_emit_partial_type_instance(&ctx, mir_type_from_kind(MIRTypeKind.Result{ok: mapped_ok, err: mapped_err}))
        }
        .Fn(signature) -> {
            mapped_params :: loop parameter in signature.params -> jet_rust_emit_partial_substitute_type(&ctx, parameter, parameters, arguments)
            mapped_ret := MIRType?{None}
            if signature.ret == .Val(ret_ty) -> mapped_ret = Val(jet_rust_emit_partial_substitute_type(&ctx, ret_ty, parameters, arguments))
            mapped_signature :: MIRFunctionSignature{
                params: mapped_params,
                ret: mapped_ret,
                effect_bound: signature.effect_bound,
                param_contract: signature.param_contract,
                call_metadata: signature.call_metadata,
                return_view_provenance: signature.return_view_provenance,
            }
            jet_rust_emit_partial_type_instance(&ctx, mir_type_from_kind(MIRTypeKind.Fn{signature: mapped_signature}))
        }
        .SendFn(params, ret, conventions) -> {
            mapped_params :: loop parameter in params -> jet_rust_emit_partial_substitute_type(&ctx, parameter, parameters, arguments)
            mapped_ret := MIRType?{None}
            if ret == .Val(ret_ty) -> mapped_ret = Val(jet_rust_emit_partial_substitute_type(&ctx, ret_ty, parameters, arguments))
            jet_rust_emit_partial_type_instance(&ctx, mir_type_from_kind(MIRTypeKind.SendFn{params: mapped_params, ret: mapped_ret, conventions: conventions}))
        }
        .Tuple(fields) -> {
            mapped_fields :: loop field in fields -> MIRTupleField{name: field.name, ty: jet_rust_emit_partial_substitute_type(&ctx, field.ty, parameters, arguments)}
            jet_rust_emit_partial_type_instance(&ctx, mir_type_from_kind(MIRTypeKind.Tuple{fields: mapped_fields}))
        }
        .FixedList(elem, len) -> {
            mapped :: jet_rust_emit_partial_substitute_type(&ctx, elem, parameters, arguments)
            jet_rust_emit_partial_type_instance(&ctx, mir_type_from_kind(MIRTypeKind.FixedList{elem: mapped, len: len}))
        }
        .InlineRange(base, lo, hi) -> {
            mapped :: jet_rust_emit_partial_substitute_type(&ctx, base, parameters, arguments)
            jet_rust_emit_partial_type_instance(&ctx, mir_type_from_kind(MIRTypeKind.InlineRange{base: mapped, lo: lo, hi: hi}))
        }
        .Tagged(marker, inner) -> {
            mapped :: jet_rust_emit_partial_substitute_type(&ctx, inner, parameters, arguments)
            jet_rust_emit_partial_type_instance(&ctx, mir_type_from_kind(MIRTypeKind.Tagged{marker: marker, inner: mapped}))
        }
        .Union(members) -> {
            mapped :: loop member in members -> jet_rust_emit_partial_substitute_type(&ctx, member, parameters, arguments)
            jet_rust_emit_partial_type_instance(&ctx, mir_type_from_kind(MIRTypeKind.Union{members: mapped}))
        }
        .Quantity(base, dimension) -> {
            mapped :: jet_rust_emit_partial_substitute_type(&ctx, base, parameters, arguments)
            jet_rust_emit_partial_type_instance(&ctx, mir_type_from_kind(MIRTypeKind.Quantity{base: mapped, dimension: dimension}))
        }
        else -> source
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::partial_move_node
fn jet_rust_emit_partial_field_type(ctx: &JetRustEmitContext, function: MIRFunction, base: MIRPlaceBase, prefix: [MIRFieldID], owner: MIRTypeID, field: MIRField) -> String Never! {
    parent := jet_rust_emit_partial_node_type(function, base, prefix)
    if parent == None {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR partial storage owner type is missing", "every checked projected move must retain the parent place type needed to preserve its canonical field layout", Val(field.span))
        return jet_rust_emit_type(&ctx, field.ty)
    }
    parent_type := parent ?? field.ty
    if parent_type.identity == .Val(identity) {
        if jet_rust_emit_type_instance(ctx, identity, false) == .Val(instance) -> parent_type = instance
    }
    generic_params := [MIRGenericParam]{}
    found_owner := false
    if jet_rust_emit_type_index(ctx, owner) == .Val(definition_index) {
        if ctx.program.types[definition_index].id == owner {
            generic_params = ctx.program.types[definition_index].generic_params
            found_owner = true
        }
    }
    if found_owner {
        if parent_type.kind == {
            .Apply(name, args) -> {
                if name.id == owner || parent_type.identity == (Val(owner)) {
                    if args.len() != generic_params.len() {
                        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR partial storage owner has incomplete type arguments", "projected field slots must use the same checked generic instantiation as their parent aggregate", Val(field.span))
                        return jet_rust_emit_type(&ctx, field.ty)
                    }
                    specialized :: jet_rust_emit_partial_substitute_type(&ctx, field.ty, generic_params, args)
                    return jet_rust_emit_type(&ctx, specialized)
                }
            }
            else -> {}
        }
    }
    jet_rust_emit_type(&ctx, field.ty)
}

fn jet_rust_emit_partial_field_reference(ctx: &JetRustEmitContext, function: MIRFunction, base: MIRPlaceBase, prefix: [MIRFieldID], owner: MIRTypeID, fields: [MIRFieldID], mutable: Bool) -> String Never! {
    field := fields[0]
    child_prefix :: jet_rust_emit_partial_path_append(prefix, field)
    slot :: jet_rust_emit_partial_field_slot(base, child_prefix)
    boxed :: jet_rust_emit_partial_field_boxed(&ctx, owner, field)
    whole := "__jet_whole"
    loop projected in fields -> whole = "({whole}).{jet_rust_emit_field_name(&ctx, projected)}"
    last := fields[fields.len() - 1]
    last_owner :: jet_rust_emit_partial_owner(&ctx, last) ?? MIRTypeID{value: 0}
    last_boxed :: jet_rust_emit_partial_field_boxed(&ctx, last_owner, last)
    borrow :: if mutable -> "&mut" else -> "&"
    accessor :: if mutable -> "as_mut" else -> "as_ref"
    whole_ref :: if last_boxed -> "({whole}).{accessor}()" else -> "{borrow}({whole})"
    nested_owner := jet_rust_emit_partial_node_owner(&ctx, function, base, child_prefix)
    if fields.len() == 1 {
        target := if boxed -> "{slot}.{accessor}().expect(\"MIR partial field\").{accessor}()" else -> "{borrow} *{slot}.{accessor}().expect(\"MIR partial field\")"
        reference :: "match {jet_rust_emit_partial_node_slot(base, prefix)}.{accessor}() {{ Some(__jet_whole) => {whole_ref}, None => {target} }}"
        if nested_owner != None {
            nested :: nested_owner ?? MIRTypeID{value: 0}
            restore :: jet_rust_emit_partial_restore(&ctx, function, base, child_prefix, nested, boxed)
            parent :: jet_rust_emit_partial_node_slot(base, prefix)
            return "{{ if {parent}.is_none() {{ {restore} }}; {reference} }}"
        }
        return reference
    }
    partial := ""
    if {
        nested_owner != None -> {
        partial = jet_rust_emit_partial_field_reference(
            &ctx,
            function,
            base,
            child_prefix,
            nested_owner ?? MIRTypeID{value: 0},
            jet_rust_emit_partial_path_suffix(fields, 1),
            mutable,
        )
        }
        else -> {
        target := "{slot}.{accessor}().expect(\"MIR partial field\")"
        index := 1
        loop index < fields.len() {
            target = "({target}).{jet_rust_emit_field_name(&ctx, fields[index])}"
            index += 1
        }
        partial = if last_boxed -> "({target}).{accessor}()" else -> "{borrow}({target})"
        }
    }
    "match {jet_rust_emit_partial_node_slot(base, prefix)}.{accessor}() {{ Some(__jet_whole) => {whole_ref}, None => {partial} }}"
}

fn jet_rust_emit_partial_type_is_tuple(ctx: &JetRustEmitContext, owner: MIRTypeID) -> Bool Never! {
    instance :: jet_rust_emit_type_instance(ctx, owner, true) ?? return false
    if instance.kind == {
        .Tuple(_) -> true
        else -> false
    }
}

fn jet_rust_emit_partial_split(ctx: &JetRustEmitContext, base: MIRPlaceBase, prefix: [MIRFieldID], owner: MIRTypeID, boxed: Bool) -> String Never! {
    node :: jet_rust_emit_partial_node_slot(base, prefix)
    out := "if let Some(__jet_whole) = {node}.take() {{ "
    if boxed -> out = "{out}let __jet_whole = *__jet_whole; "
    fields :: jet_rust_emit_partial_fields(&ctx, owner)
    loop field in fields {
        child_prefix :: jet_rust_emit_partial_path_append(prefix, field.id)
        slot :: jet_rust_emit_partial_field_slot(base, child_prefix)
        out = "{out}{slot} = Some(__jet_whole.{jet_rust_emit_field_name(&ctx, field.id)}); "
    }
    "{out}}}"
}

fn jet_rust_emit_partial_clear(ctx: &JetRustEmitContext, function: MIRFunction, base: MIRPlaceBase, prefix: [MIRFieldID], owner: MIRTypeID) -> String Never! {
    out := ""
    fields :: jet_rust_emit_partial_fields(&ctx, owner)
    loop field in fields {
        child_prefix :: jet_rust_emit_partial_path_append(prefix, field.id)
        slot :: jet_rust_emit_partial_field_slot(base, child_prefix)
        out = "{out}drop({slot}.take()); "
        nested_owner := jet_rust_emit_partial_node_owner(&ctx, function, base, child_prefix)
        if nested_owner != None {
            out = "{out}{jet_rust_emit_partial_clear(&ctx, function, base, child_prefix, nested_owner ?? MIRTypeID{value: 0})}"
        }
    }
    out
}

fn jet_rust_emit_partial_restore(ctx: &JetRustEmitContext, function: MIRFunction, base: MIRPlaceBase, prefix: [MIRFieldID], owner: MIRTypeID, boxed: Bool) -> String Never! {
    node :: jet_rust_emit_partial_node_slot(base, prefix)
    out := "if {node}.is_none() {{ "
    fields :: jet_rust_emit_partial_fields(&ctx, owner)
    values := [String]{}
    loop field in fields {
        child_prefix :: jet_rust_emit_partial_path_append(prefix, field.id)
        nested_owner := jet_rust_emit_partial_node_owner(&ctx, function, base, child_prefix)
        if nested_owner != None {
            child_boxed :: jet_rust_emit_partial_field_boxed(&ctx, owner, field.id)
            out = "{out}{jet_rust_emit_partial_restore(&ctx, function, base, child_prefix, nested_owner ?? MIRTypeID{value: 0}, child_boxed)}"
        }
        slot :: jet_rust_emit_partial_field_slot(base, child_prefix)
        value := "{slot}.take().expect(\"MIR initialized field\")"
        if {
            jet_rust_emit_partial_type_is_tuple(&ctx, owner) -> {
            &values.push(value)
            }
            else -> {
            &values.push("{jet_rust_emit_field_name(&ctx, field.id)}: {value}")
            }
        }
    }
    value := if jet_rust_emit_partial_type_is_tuple(&ctx, owner) -> "({values.join(", ")},)" else -> "{jet_rust_emit_type_name(&ctx, owner)} {{ {values.join(", ")} }}"
    if boxed -> value = "Box::new({value})"
    "{out}{node} = Some({value}); }} "
}

fn jet_rust_emit_partial_write(ctx: &JetRustEmitContext, function: MIRFunction, base: MIRPlaceBase, prefix: [MIRFieldID], owner: MIRTypeID, fields: [MIRFieldID], value: String) -> String Never! {
    node :: jet_rust_emit_partial_node_slot(base, prefix)
    if fields.len() == 0 {
        clear := jet_rust_emit_partial_clear(&ctx, function, base, prefix, owner)
        return "{{ let __jet_replacement = {value}; {clear} {node} = Some(__jet_replacement); }}"
    }
    field := fields[0]
    child_prefix :: jet_rust_emit_partial_path_append(prefix, field)
    slot :: jet_rust_emit_partial_field_slot(base, child_prefix)
    whole := "__jet_whole"
    loop projected in fields -> whole = "({whole}).{jet_rust_emit_field_name(&ctx, projected)}"
    partial := ""
    if {
        fields.len() == 1 -> {
        nested_owner := jet_rust_emit_partial_node_owner(&ctx, function, base, child_prefix)
        clear := if nested_owner != None -> jet_rust_emit_partial_clear(&ctx, function, base, child_prefix, nested_owner ?? MIRTypeID{value: 0}) else -> ""
        partial = "{clear}{slot} = Some(__jet_replacement);"
        }
        else -> {
        nested_owner := jet_rust_emit_partial_node_owner(&ctx, function, base, child_prefix)
        if {
            nested_owner != None -> {
            tail :: jet_rust_emit_partial_path_suffix(fields, 1)
            partial = jet_rust_emit_partial_write(&ctx, function, base, child_prefix, nested_owner ?? MIRTypeID{value: 0}, tail, "__jet_replacement")
            }
            else -> {
            target := "{slot}.as_mut().expect(\"MIR initialized field\")"
            index := 1
            loop index < fields.len() {
                target = "({target}).{jet_rust_emit_field_name(&ctx, fields[index])}"
                index += 1
            }
            partial = "{target} = __jet_replacement;"
            }
        }
        }
    }
    "{{ let __jet_replacement = {value}; if let Some(__jet_whole) = {node}.as_mut() {{ {whole} = __jet_replacement; }} else {{ {partial} }} }}"
}

fn jet_rust_emit_partial_move(ctx: &JetRustEmitContext, function: MIRFunction, place: MIRPlaceID) -> String? {
    loop row in function.places {
        if row.id == place {
            fields :: jet_rust_emit_partial_place_path(ctx, function, place)
            if fields.len() == 0 || row.projections.len() != fields.len() -> return None
            prefix := [MIRFieldID]{}
            out := ""
            index := 0
            loop index < fields.len() {
                owner := jet_rust_emit_partial_owner(&ctx, fields[index]) ?? MIRTypeID{value: 0}
                boxed := false
                if prefix.len() > 0 {
                    parent_owner :: jet_rust_emit_partial_owner(&ctx, prefix[prefix.len() - 1]) ?? MIRTypeID{value: 0}
                    boxed = jet_rust_emit_partial_field_boxed(&ctx, parent_owner, prefix[prefix.len() - 1])
                }
                out = "{out}{jet_rust_emit_partial_split(&ctx, row.base, prefix, owner, boxed)} "
                prefix = jet_rust_emit_partial_path_append(prefix, fields[index])
                index += 1
            }
            last := fields[fields.len() - 1]
            owner := jet_rust_emit_partial_owner(&ctx, last) ?? MIRTypeID{value: 0}
            boxed := jet_rust_emit_partial_field_boxed(&ctx, owner, last)
            nested_owner := jet_rust_emit_partial_node_owner(&ctx, function, row.base, prefix)
            if nested_owner != None {
                out = "{out}{jet_rust_emit_partial_restore(&ctx, function, row.base, prefix, nested_owner ?? MIRTypeID{value: 0}, boxed)}"
            }
            slot :: jet_rust_emit_partial_node_slot(row.base, prefix)
            unbox :: if boxed -> "*" else -> ""
            field_name :: jet_rust_emit_field_name(&ctx, last)
            return Val("{{ {out} {unbox}{slot}.take().expect(\"MIR partial field {field_name}\") }}")
        }
    }
    None
}

fn jet_rust_emit_partial_drop(ctx: &JetRustEmitContext, function: MIRFunction, place: MIRPlaceID) -> String? {
    loop row in function.places {
        if row.id == place && row.projections.len() == 0 && jet_rust_emit_partial_root_has(ctx, function, row.base) {
            owner :: jet_rust_emit_partial_node_owner(&ctx, function, row.base, [MIRFieldID]{}) ?? MIRTypeID{value: 0}
            clear :: jet_rust_emit_partial_clear(&ctx, function, row.base, [MIRFieldID]{}, owner)
            root :: jet_rust_emit_partial_root_slot(row.base)
            return Val("{{ drop({root}.take()); {clear} () }}")
        }
    }
    None
}

// True when every use of `value` drops it, and some use does.
fn jet_rust_emit_value_dropped_only(ctx: JetRustEmitContext, function: MIRFunction, value: MIRValueID) -> Bool Never! {
    dropped := false
    loop user in jet_rust_emit_value_users(ctx, function, value) {
        if user.instruction < 0 -> return false
        if function.blocks[user.block].instructions[user.instruction].operation == {
            .Drop(operand, _) -> {
                if operand != value -> return false
                dropped = true
            }
            else -> return false
        }
    }
    dropped
}

fn jet_rust_emit_uninit_fixed_drop_place(function: MIRFunction, place: MIRPlaceID) -> String? {
    local :: jet_rust_emit_uninit_fixed_place_local(function, place) ?? return None
    Val("{{ drop({jet_rust_emit_local_slot(local)}.take()); () }}")
}

fn jet_rust_emit_uninit_fixed_drop_value(ctx: JetRustEmitContext, function: MIRFunction, value: MIRValueID) -> String? {
    producer :: jet_rust_emit_find_value_instruction(ctx, function, value) ?? return None
    place := MIRPlaceID?{None}
    if producer.operation == {
        .MovePlace(id) -> place = Val(id)
        else -> return None
    }
    id :: place ?? return None
    dropped := jet_rust_emit_uninit_fixed_drop_place(function, id)
    if dropped == None || !jet_rust_emit_value_dropped_only(ctx, function, value) -> return None
    dropped
}

fn jet_rust_emit_partial_drop_value(ctx: &JetRustEmitContext, function: MIRFunction, value: MIRValueID) -> String? {
    producer :: jet_rust_emit_find_value_instruction(ctx, function, value) ?? return None
    place_id := MIRPlaceID?{None}
    if producer.operation == {
        .MovePlace(place) -> place_id = Val(place)
        else -> return None
    }
    place :: place_id ?? return None
    root_drop := jet_rust_emit_partial_drop(&ctx, function, place)
    if root_drop == None || !jet_rust_emit_value_dropped_only(ctx, function, value) -> return None
    root_drop
}

fn jet_rust_emit_partial_owner(ctx: &JetRustEmitContext, field: MIRFieldID) -> MIRTypeID? {
    loop row in jet_rust_emit_field_rows(ctx, field) { if row.id == field -> return Val(row.owner) }
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR partial move field is missing from the program registry", "field projections must retain their owner identity for split storage", None)
    None
}

// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::boxed_field
fn jet_rust_emit_partial_field_boxed(ctx: &JetRustEmitContext, owner: MIRTypeID, field: MIRFieldID) -> Bool Never! {
    field_name := ""
    loop row in jet_rust_emit_field_rows(ctx, field) { if row.id == field -> field_name = row.field.name }
    if jet_rust_emit_type_index(ctx, owner) == .Val(definition_index) {
        if ctx.program.types[definition_index].id == owner {
            loop edge in ctx.program.types[definition_index].boxed_edges {
                if edge == field_name || edge.ends_with(".{field_name}") -> return true
            }
        }
    }
    false
}

// MIRRust boxed_field: the field's owner declaration boxes it as a recursive edge.
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::boxed_field
fn jet_rust_emit_field_boxed(ctx: &JetRustEmitContext, field: MIRFieldID) -> Bool Never! {
    loop row in jet_rust_emit_field_rows(ctx, field) {
        if row.id == field {
            if jet_rust_emit_type_index(ctx, row.owner) == .Val(definition_index) {
                if ctx.program.types[definition_index].id == row.owner {
                    loop edge in ctx.program.types[definition_index].boxed_edges { if edge == row.field.name -> return true }
                }
            }
            return false
        }
    }
    false
}

fn jet_rust_emit_partial_field_expression(ctx: &JetRustEmitContext, function: MIRFunction, place: MIRPlaceID, mutable: Bool) -> String? {
    loop row in function.places {
        if row.id == place {
            if !jet_rust_emit_partial_root_has(ctx, function, row.base) -> return None
            fields :: jet_rust_emit_place_projection_path(function, place)
            if fields.len() == 0 || row.projections.len() != fields.len() -> return None
            owner :: jet_rust_emit_partial_node_owner(&ctx, function, row.base, [MIRFieldID]{}) ?? MIRTypeID{value: 0}
            return Val(jet_rust_emit_partial_field_reference(&ctx, function, row.base, [MIRFieldID]{}, owner, fields, mutable))
        }
    }
    None
}

fn jet_rust_emit_partial_root_restore(ctx: &JetRustEmitContext, function: MIRFunction, place: MIRPlaceID) -> String? {
    loop row in function.places {
        if row.id == place && row.projections.len() == 0 && jet_rust_emit_partial_root_has(ctx, function, row.base) {
            owner :: jet_rust_emit_partial_node_owner(&ctx, function, row.base, [MIRFieldID]{}) ?? MIRTypeID{value: 0}
            return Val(jet_rust_emit_partial_restore(&ctx, function, row.base, [MIRFieldID]{}, owner, false))
        }
    }
    None
}

// MIRRust payload_pattern's boxed flag: the payload slot of a recursive
// variant edge holds a `Box`, so its place unboxes once more.
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::payload_pattern
fn jet_rust_emit_payload_boxed(ctx: &JetRustEmitContext, kind: MIRPayloadKind) -> Bool Never! {
    if kind == .Enum(owner, variant, index) {
        if jet_rust_emit_type_index(ctx, owner) == .Val(definition_index) {
            if ctx.program.types[definition_index].id != owner -> return false
            if ctx.program.types[definition_index].kind == .Enum(variants, _) {
                loop row in variants {
                    if row.name != variant -> next
                    if row.payload == {
                        .Single(_) -> return ctx.program.types[definition_index].boxed_edges.contains(variant)
                        .Named(fields) -> {
                            if index >= 0 && index < fields.len() -> return ctx.program.types[definition_index].boxed_edges.contains("{variant}.{fields[index].name}")
                        }
                        .Unit -> {}
                    }
                }
            }
        }
    }
    false
}

fn jet_rust_emit_place_base(ctx: &JetRustEmitContext, function: MIRFunction, base: MIRPlaceBase, mutable: Bool, projections: [MIRProjection]) -> String Never! {
    // MIRRust place_base: over a partially moved owner the leading field
    // chain resolves through the split slots; the remaining projections
    // continue from that surviving field.
    leading := [MIRFieldID]{}
    if jet_rust_emit_partial_root_has(ctx, function, base) {
        loop projection in projections {
            if projection == .Field(field, _) {
                &leading.push(field)
            } else {
                break
            }
        }
    }
    remaining := projections
    expression := ""
    if leading.len() > 0 {
        owner :: jet_rust_emit_partial_node_owner(&ctx, function, base, [MIRFieldID]{}) ?? MIRTypeID{value: 0}
        expression = "*({jet_rust_emit_partial_field_reference(&ctx, function, base, [MIRFieldID]{}, owner, leading, mutable)})"
        remaining = [MIRProjection]{}
        loop index in leading.len()..<projections.len() -> &remaining.push(projections[index])
    } else {
        expression = if base == {
            .Local(local) -> {
                if {
                    jet_rust_emit_local_uninit_fixed_type(function, local) != None -> {
                    if mutable -> "*{jet_rust_emit_local_slot(local)}.as_mut().expect(\"MIR local\").as_array_mut()" else -> "*{jet_rust_emit_local_slot(local)}.as_ref().expect(\"MIR local\").as_array()"
                    }
                    // MIRRust place_base: a local allocator view names its referent.
                    jet_rust_emit_local_is_allocator_view(function, local) -> {
                    storage :: jet_rust_emit_local_storage(&ctx, local)
                    if mutable -> "**{storage}.as_mut().expect(\"MIR local\")" else -> "**{storage}.as_ref().expect(\"MIR local\")"
                    }
                    else -> jet_rust_emit_place_local(&ctx, local, mutable)
                }
            }
            .Parameter(value) -> jet_rust_emit_parameter_place(ctx, function, value, mutable)
            .Capture(value) -> jet_rust_emit_parameter_place(ctx, function, value, mutable)
            .Temporary(value) -> "*({jet_rust_emit_value_reference(ctx, value, mutable)})"
            .Static(name) -> {
                // MIRRust place_base: a persistent cell lends no mutable projection.
                if mutable -> jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidOwnership, "E0003", "MIR mutable static projection has no canonical owning representation", "persistent places are read whole and written through their cell", None)
                "({jet_rust_emit_static_path(&ctx, name)}).get()"
            }
        }
    }
    loop projection in remaining {
        if projection == {
            // A boxed recursive edge names the boxed value, so every borrow,
            // read, write and index through it sees `T` (MIRRust place_base).
            .Field(field, _) -> expression = if jet_rust_emit_field_boxed(&ctx, field) -> "(*({expression}).{jet_rust_emit_field_name(&ctx, field)})" else -> "({expression}).{jet_rust_emit_field_name(&ctx, field)}"
            .Deref(_) -> expression = "*({expression})"
            .Payload(kind, _) -> {
                borrow :: if mutable -> "&mut" else -> "&"
                payload :: if jet_rust_emit_payload_boxed(&ctx, kind) -> "{borrow} **payload" else -> "payload"
                expression = "*(match {borrow} ({expression}) {{ {jet_rust_emit_payload_pattern(&ctx, kind)} => {payload}, _ => unreachable!(\"MIR payload variant mismatch\") }})"
            }
            .Index(kind, index, call, _, location, context, _) -> {
                // MIRRust place projection: the fixed ref/mut index helpers
                // borrow the projected place; the route row supplies the ABI.
                index_expression :: if {
                    kind == MIRIndexKind.Map && !mutable -> jet_rust_emit_value_borrow(ctx, index)
                    kind == MIRIndexKind.Map -> jet_rust_emit_value_owned(ctx, function, index)
                    else -> jet_rust_emit_index_operand(&ctx, function, index, location)
                }
                symbol :: if kind == {
                    .List | .FixedListProof -> if mutable -> "jet_index_vec_mut" else -> "jet_index_vec_ref"
                    .Map -> if mutable -> "jet_index_map_mut" else -> "jet_index_map_ref"
                    .Pool -> if mutable -> "jet_std::jet_pool_get_mut" else -> "jet_std::jet_pool_get_ref"
                    .Lane -> if mutable -> "jet_std::jet_native_lane_mut" else -> "jet_std::jet_native_lane_ref"
                }
                borrow :: if mutable -> "&mut" else -> "&"
                args :: jet_rust_emit_index_arguments(&ctx, function, call, "{borrow} ({expression})", index_expression, location, context)
                expression = "*{ctx.config.root_prefix}{symbol}({args.join(", ")})"
            }
            .Range(range, location, _) -> {
                symbol :: if mutable -> "jet_view_mut_new_range" else -> "jet_view_new_range"
                borrow :: if mutable -> "&mut" else -> "&"
                expression = "*{ctx.config.root_prefix}{symbol}({borrow} ({expression}), &({jet_rust_emit_value_owned(ctx, function, range)}), {jet_rust_emit_source_path(&ctx, location.file)}, {location.line}u32)"
            }
        }
    }
    expression
}

fn jet_rust_emit_place(ctx: &JetRustEmitContext, function: MIRFunction, id: MIRPlaceID, mutable: Bool) -> String Never! {
    loop place in function.places {
        if place.id == id -> return jet_rust_emit_place_base(&ctx, function, place.base, mutable, place.projections)
    }
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR place identity is missing from its function", "all read/write/move place operations must resolve to one checked place row", None)
    "__jet_missing_place_{id.value}"
}

fn jet_rust_emit_place_read(ctx: &JetRustEmitContext, function: MIRFunction, id: MIRPlaceID) -> String Never! {
    uninit_local := jet_rust_emit_uninit_fixed_place_local(function, id)
    if uninit_local != None {
        local :: uninit_local ?? MIRLocalID{value: 0}
        return "{jet_rust_emit_local_slot(local)}.as_ref().expect(\"MIR local\").read_array()"
    }
    // MIRRust place_read: a whole local allocator view reborrows its
    // referent; the unique view is never cloned.
    loop row in function.places {
        if row.id != id -> next
        if row.projections.len() == 0 {
            if row.base == .Local(local) {
                if jet_rust_emit_local_is_allocator_view(function, local) -> return "&mut **{jet_rust_emit_local_storage(&ctx, local)}.as_mut().expect(\"MIR local\")"
            }
        }
        break
    }
    partial := jet_rust_emit_partial_field_expression(&ctx, function, id, false)
    if partial != None {
        fallback :: partial ?? "__jet_missing_partial"
        return "({fallback}).clone()"
    }
    place :: jet_rust_emit_place(&ctx, function, id, false)
    restore := jet_rust_emit_partial_root_restore(&ctx, function, id)
    if restore != None {
        prepare :: restore ?? ""
        return "{{ {prepare} ({place}).clone() }}"
    }
    // A range window, or a window parameter read whole, is a slice: copy it
    // out as an owned list.
    read :: if jet_rust_emit_place_is_window(&ctx, function, id) -> "({place}).to_vec()" else -> "({place}).clone()"
    native :: jet_rust_emit_native_place_int_type(&ctx, function, id) ?? return read
    jet_rust_emit_native_int_result(&ctx, read, native) ?? read
}

// MIRRust place_read: a native host record's Int slot widens on every read,
// exactly as the value-level field read does, including a payload projected
// out of that slot (`limits.max_total_bytes` matched as `.Val(max)`). The
// type to widen: the slot's declared type, or the projected payload's.
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::native_host_field_type
fn jet_rust_emit_native_place_int_type(ctx: &JetRustEmitContext, function: MIRFunction, id: MIRPlaceID) -> MIRType? {
    loop place in function.places {
        if place.id != id -> next
        index := place.projections.len() - 1
        loop index >= 0 {
            if place.projections[index] == .Payload(_, _) {
                index -= 1
            } else {
                break
            }
        }
        if index < 0 -> return None
        if place.projections[index] == .Field(field, _) {
            loop row in jet_rust_emit_field_rows(ctx, field) {
                if row.id != field -> next
                if jet_rust_emit_type_index(ctx, row.owner) == .Val(definition_index) {
                    if ctx.program.types[definition_index].id == row.owner && jet_rust_emit_has_native_type_projection(ctx.program.types[definition_index].key) {
                        if index == place.projections.len() - 1 -> return Val(row.field.ty)
                        return Val(place.ty)
                    }
                }
            }
        }
        return None
    }
    None
}

// True when `id` is a range window place or a bare window parameter.
fn jet_rust_emit_place_is_window(ctx: &JetRustEmitContext, function: MIRFunction, id: MIRPlaceID) -> Bool Never! {
    loop place in function.places {
        if place.id == id {
            if place.projections.len() > 0 {
                if place.projections[place.projections.len() - 1] == .Range(_, _, _) -> return true
                return false
            }
            if place.base == .Parameter(value) {
                instruction :: jet_rust_emit_find_value_instruction(ctx, function, value) ?? return false
                if instruction.operation == .Parameter(index, _) -> return jet_rust_emit_window_param(ctx, function.id, index)
            }
            return false
        }
    }
    false
}

fn jet_rust_emit_place_reference(ctx: &JetRustEmitContext, function: MIRFunction, id: MIRPlaceID, access: MIRAccess) -> String Never! {
    if access == MIRAccess.Move -> return jet_rust_emit_place_move(&ctx, function, id)
    uninit_local := jet_rust_emit_uninit_fixed_place_local(function, id)
    if uninit_local != None {
        local :: uninit_local ?? MIRLocalID{value: 0}
        if access == MIRAccess.Write -> return "{jet_rust_emit_local_slot(local)}.as_mut().expect(\"MIR local\").as_array_mut()"
        return "{jet_rust_emit_local_slot(local)}.as_ref().expect(\"MIR local\").as_array()"
    }
    if jet_rust_emit_partial_field_expression(&ctx, function, id, access == MIRAccess.Write) == .Val(partial) -> return partial
    // MIRRust place_reference: a whole local borrows its slot's value; for an
    // allocator view that is the view itself, not its referent (`place_base`).
    loop row in function.places {
        if row.id != id -> next
        if row.projections.len() == 0 {
            if row.base == .Local(local) {
                if jet_rust_emit_local_is_allocator_view(function, local) {
                    accessor :: if access == MIRAccess.Write -> "as_mut" else -> "as_ref"
                    return "{jet_rust_emit_local_storage(&ctx, local)}.{accessor}().expect(\"MIR local\")"
                }
            }
        }
        break
    }
    place :: jet_rust_emit_place(&ctx, function, id, access == MIRAccess.Write)
    restore := jet_rust_emit_partial_root_restore(&ctx, function, id)
    if restore != None {
        prepare :: restore ?? ""
        borrow :: if access == MIRAccess.Write -> "&mut" else -> "&"
        return "{{ {prepare} {borrow}({place}) }}"
    }
    if access == MIRAccess.Write -> "&mut ({place})" else -> "&({place})"
}

fn jet_rust_emit_partial_fields(ctx: &JetRustEmitContext, owner: MIRTypeID) -> [MIRField] Never! {
    fields := [MIRField]{}
    rows :: ctx.field_rows_by_owner.get(jet_rust_emit_id_key(owner.value)) ?? [Int]{}
    loop row_index in rows {
        row :: ctx.program.fields[row_index]
        if !row.field.computed -> &fields.push(row.field)
    }
    fields
}

// Partial split, restore, move, write, and drop helpers above use the same path-qualified storage tree.

fn jet_rust_emit_place_lvalue(ctx: &JetRustEmitContext, function: MIRFunction, id: MIRPlaceID) -> String Never! {
    jet_rust_emit_place(&ctx, function, id, true)
}

// MIRRust write_place_expr: `value_id` is the written value when the write
// comes from a WritePlace/ReplacePlace (its type selects allocator-view
// rebinding and native Int narrowing).
fn jet_rust_emit_place_write(ctx: &JetRustEmitContext, function: MIRFunction, id: MIRPlaceID, value_id: MIRValueID?, value: String) -> String Never! {
    loop place in function.places {
        if place.id != id -> next
        if place.projections.len() == 0 {
            if jet_rust_emit_partial_root_has(ctx, function, place.base) {
                root_owner :: jet_rust_emit_partial_node_owner(&ctx, function, place.base, [MIRFieldID]{}) ?? MIRTypeID{value: 0}
                return jet_rust_emit_partial_write(&ctx, function, place.base, [MIRFieldID]{}, root_owner, [MIRFieldID]{}, value)
            }
            if place.base == {
                .Local(local) -> {
                    if jet_rust_emit_local_uninit_fixed_type(function, local) != None {
                        return "{jet_rust_emit_local_storage(&ctx, local)} = Some({ctx.config.root_prefix}jet_mem::JetUninitFixed::from_array({value}))"
                    }
                    // MIRRust: rebinding a local allocator view to another view
                    // replaces the carrier; any other value writes its referent.
                    if jet_rust_emit_local_is_allocator_view(function, local) {
                        rebind := false
                        if value_id == .Val(written) {
                            if jet_rust_emit_value_type(ctx, function, written).kind == .Tagged(marker, _) {
                                rebind = marker == (MIRTagMarker.Internal{internal_tag: MIRInternalTag.AllocatorView})
                            }
                        }
                        if rebind -> return "{jet_rust_emit_local_storage(&ctx, local)} = Some({value})"
                        return "**{jet_rust_emit_local_storage(&ctx, local)}.as_mut().expect(\"MIR local\") = {value}"
                    }
                    return "{jet_rust_emit_local_storage(&ctx, local)} = Some({value})"
                }
                .Temporary(temp) -> return "{jet_rust_emit_value_slot(temp)} = Some({value})"
                .Static(name) -> return "({jet_rust_emit_static_path(&ctx, name)}).set({value})"
                .Parameter(binding) | .Capture(binding) -> {
                    if jet_rust_emit_binding_uses_move_slot(ctx, function, binding) -> return "{jet_rust_emit_value_slot(binding)} = Some({value})"
                }
            }
        }
        last_index :: place.projections.len() - 1
        if last_index >= 0 {
            if place.projections[last_index] == .Index(kind, index, _, write_call, location, context, _) {
                if last_index == 0 && kind == MIRIndexKind.FixedListProof {
                    if place.base == .Local(local) {
                        if jet_rust_emit_local_uninit_fixed_type(function, local) != None {
                            index_text :: jet_rust_emit_index_operand(&ctx, function, index, location)
                            return "{jet_rust_emit_local_storage(&ctx, local)}.as_mut().expect(\"MIR local\").write(({index_text}) as usize, {value})"
                        }
                    }
                }
                // The checked setter route writes the indexed slot: a map
                // assignment inserts a missing key instead of trapping.
                call :: write_call ?? {
                    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR writable index place has no exact setter Prelude route", "checked writable index places carry their setter route", Val(place.span))
                    return "unreachable!(\"MIR index setter route\")"
                }
                prefix := [MIRProjection]{}
                loop position in 0..<last_index -> &prefix.push(place.projections[position])
                base :: jet_rust_emit_place_base(&ctx, function, place.base, true, prefix)
                route :: jet_rust_emit_prelude_row(&ctx, call) ?? return "unreachable!(\"missing Prelude route\")"
                if route.symbol == .Prelude(symbol) {
                    if symbol == "jet_map_update_string" {
                        key :: jet_rust_emit_borrowed_value_reference(&ctx, function, index, MIRAccess.Read)
                        return jet_rust_emit_prelude_args_exact(&ctx, function, call, [String]{"&mut ({base})", key, "move |_| {{ {value} }}"})
                    }
                }
                index_text :: if kind == MIRIndexKind.Map -> jet_rust_emit_value_owned(ctx, function, index) else -> jet_rust_emit_index_operand(&ctx, function, index, location)
                extras := [String]{jet_rust_emit_source_path(&ctx, location.file), "{location.line}u32"}
                if context == .Val(row) {
                    &extras.push(jet_rust_emit_quote(row.function))
                    &extras.push(jet_rust_emit_quote(row.source_line))
                }
                args :: jet_rust_emit_append_prelude_context(&ctx, function, call, [String]{"&mut ({base})", index_text, value}, extras)
                return jet_rust_emit_prelude_args_exact(&ctx, function, call, args)
            }
        }
        stored := value
        // MIRRust: a native host record's Int slot takes the host word.
        if last_index >= 0 {
            if value_id == .Val(written) {
                if place.projections[last_index] == .Field(field, _) {
                    if jet_rust_emit_native_host_field(&ctx, field) && jet_rust_emit_value_type(ctx, function, written).kind == MIRTypeKind.Int {
                        stored = jet_rust_emit_native_int_argument(&ctx, stored, None)
                    }
                }
            }
        }
        if jet_rust_emit_partial_root_has(ctx, function, place.base) {
            fields :: jet_rust_emit_place_projection_path(function, id)
            if place.projections.len() == fields.len() {
                root_owner :: jet_rust_emit_partial_node_owner(&ctx, function, place.base, [MIRFieldID]{}) ?? MIRTypeID{value: 0}
                last :: fields[fields.len() - 1]
                owner :: jet_rust_emit_partial_owner(&ctx, last) ?? MIRTypeID{value: 0}
                if jet_rust_emit_partial_field_boxed(&ctx, owner, last) -> stored = "Box::new({stored})"
                return jet_rust_emit_partial_write(&ctx, function, place.base, [MIRFieldID]{}, root_owner, fields, stored)
            }
        }
        // `place_lvalue` already names a boxed edge's value (`place_base`).
        return "{jet_rust_emit_place_lvalue(&ctx, function, id)} = {stored}"
    }
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR place write identity is missing from its function", "checked place writes require a complete place row", None)
    "()"
}

// MIRRust native_host_field_type: the field's owner is a native host record.
fn jet_rust_emit_native_host_field(ctx: &JetRustEmitContext, field: MIRFieldID) -> Bool Never! {
    loop row in jet_rust_emit_field_rows(ctx, field) {
        if row.id != field -> next
        if jet_rust_emit_type_index(ctx, row.owner) == .Val(definition_index) {
            if ctx.program.types[definition_index].id == row.owner -> return jet_rust_emit_has_native_type_projection(ctx.program.types[definition_index].key)
        }
        return false
    }
    false
}

fn jet_rust_emit_place_move(ctx: &JetRustEmitContext, function: MIRFunction, id: MIRPlaceID) -> String Never! {
    loop place in function.places {
        if place.id == id {
            if place.projections.len() != 0 {
                if jet_rust_emit_partial_move(&ctx, function, id) == .Val(partial) -> return partial
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidOwnership, "E0003", "projected MIR move lacks a source ownership projection", "checked projected moves require a canonical partial-move plan", Val(place.span))
                return "unreachable!(\"unsupported projected MIR move\")"
            }
            if jet_rust_emit_partial_root_has(ctx, function, place.base) {
                owner :: jet_rust_emit_partial_node_owner(&ctx, function, place.base, [MIRFieldID]{}) ?? MIRTypeID{value: 0}
                restore :: jet_rust_emit_partial_restore(&ctx, function, place.base, [MIRFieldID]{}, owner, false)
                return "{{ {restore} {jet_rust_emit_partial_root_slot(place.base)}.take().expect(\"MIR whole move\") }}"
            }
            if place.base == {
                .Local(local) -> {
                    // MIRRust move_base: moving a reference binding's value
                    // out copies the referent.
                    if ctx.ref_bindings.locals.get(local.value) != None -> return "(*{jet_rust_emit_local_slot(local)}.take().expect(\"MIR local\")).clone()"
                    if jet_rust_emit_local_uninit_fixed_type(function, local) != None {
                        return "{jet_rust_emit_local_slot(local)}.take().expect(\"MIR local\").into_array()"
                    }
                    return "{jet_rust_emit_local_storage(&ctx, local)}.take().expect(\"MIR local\")"
                }
                .Temporary(temp) -> return jet_rust_emit_value_move(ctx, temp)
                .Parameter(binding) -> return jet_rust_emit_value_move(ctx, binding)
                .Capture(binding) -> return jet_rust_emit_value_move(ctx, binding)
                .Static(name) -> return "({jet_rust_emit_static_path(&ctx, name)}).take()"
            }
        }
    }
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR move place identity is missing from its function", "checked move operations require a complete place row", None)
    "unreachable!(\"missing MIR move place\")"
}
