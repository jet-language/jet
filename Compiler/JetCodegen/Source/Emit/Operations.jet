// MIR operation printer. Every branch consumes an already checked operation and
// either preserves its ownership/failure facts or marks the artifact incomplete.
use jet_foundation.[
    MIRAccess,
    MIRBinaryDispatch,
    MIRBinaryOp,
    MIRBinaryPatternPart,
    MIRCLIEntry,
    MIRCallArg,
    MIRCallFallibility,
    MIRCallMetadata,
    MIRCallSignature,
    MIRCallablePolicy,
    MIRCallablePolicyChain,
    MIRCallbackAdapter,
    MIRCallbackID,
    MIRCallee,
    MIRCaptureOperand,
    MIRCompilerBuiltin,
    MIRConversion,
    MIRCoreCallID,
    MIRDataPlan,
    MIRDropKind,
    MIREnumArg,
    MIRFailureCarrier,
    MIRField,
    MIRFieldID,
    MIRFieldValue,
    MIRForeign,
    MIRForeignID,
    MIRForeignLanguage,
    MIRFunction,
    MIRFunctionForm,
    MIRFunctionID,
    MIRGenericParam,
    MIRHandleLifecycle,
    MIRIndexKind,
    MIRInternalTag,
    MIRLocal,
    MIRLoopSourceKind,
    MIROperation,
    MIRPanicLoc,
    MIRPanicContext,
    MIRParam,
    MIRPayloadKind,
    MIRPlaceID,
    MIRPreludeABI,
    MIRPreludeCall,
    MIRPreludeCallID,
    MIRPreludeFamily,
    MIRScope,
    MIRScopeID,
    MIRScopeKind,
    MIRStringFormat,
    MIRStringPart,
    MIRSymbol,
    MIRTagMarker,
    MIRTestScopeMember,
    MIRTextHoleKind,
    MIRTextPatternPart,
    MIRTraitMethod,
    MIRTraitMethodID,
    MIRTraitRef,
    MIRType,
    MIRTypeDef,
    MIRTypeID,
    MIRTypeKind,
    MIRUnaryOp,
    MIRUnsafeGate,
    MIRValueID,
    MIRVariantPayload,
    Span,
    core_call_symbol_name,
    mir_measure_literal_value,
    mir_nominal_ref,
    mir_type_id,
    mir_type_canonical_key,
    mir_type_is_integer,
    mir_type_is_scalar,
    mir_type_layout,
    mir_type_same_checked_type,
    mir_view_copy_kind,
    mir_view_copy_symbol,
    mir_view_copy_target_matches,
]

fn jet_rust_emit_binary_operator(op: MIRBinaryOp) -> String Never! {
    if op == {
        .Add -> "+"
        .Sub -> "-"
        .Mul -> "*"
        .Div -> "/"
        .FloorDiv -> "/"
        .Mod -> "%"
        .Rem -> "%"
        .Pow -> "^"
        .BitAnd -> "&"
        .BitOr -> "|"
        .BitXor -> "^"
        .Shl -> "<<"
        .Shr -> ">>"
        .Eq -> "=="
        .Ne -> "!="
        .Lt -> "<"
        .Gt -> ">"
        .Le -> "<="
        .Ge -> ">="
        .Compare -> "<=>"
        .And -> "&&"
        .Or -> "||"
    }
}

fn jet_rust_emit_exact_int_helper(op: MIRBinaryOp) -> String? {
    if op == {
        .Add -> Val("jet_int_owned_add")
        .Sub -> Val("jet_int_owned_sub")
        .Mul -> Val("jet_int_owned_mul")
        .Div -> Val("jet_int_owned_div")
        .FloorDiv -> Val("jet_int_owned_floor_div")
        .Mod -> Val("jet_int_owned_mod")
        .Rem -> Val("jet_int_owned_rem")
        .Pow -> Val("jet_int_owned_pow")
        .BitAnd -> Val("jet_int_owned_bit_and")
        .BitOr -> Val("jet_int_owned_bit_or")
        .BitXor -> Val("jet_int_owned_bit_xor")
        .Shl -> Val("jet_int_owned_shl")
        .Shr -> Val("jet_int_owned_shr")
        else -> None
    }
}

fn jet_rust_emit_core_symbol(ctx: &JetRustEmitContext, id: MIRCoreCallID) -> String Never! {
    loop row in ctx.program.core_calls {
        if row.id == id {
            symbol :: core_call_symbol_name(row.symbol)
            if symbol == "" {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR Core call has an empty source symbol", "checked Core calls must retain a canonical source-emission symbol", None)
                return "__jet_missing_core"
            }
            if symbol.starts_with("jet_vault_") || symbol.starts_with("jet_crypto_") -> return "jet_ffi::{symbol}"
            return symbol
        }
    }
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR Core call has no registry row", "checked Core calls must retain a canonical source-emission symbol", None)
    "__jet_missing_core"
}

fn jet_rust_emit_route_call(ctx: &JetRustEmitContext, id: MIRPreludeCallID, args: [String]) -> String Never! {
    row := MIRPreludeCall?{None}
    loop candidate in ctx.program.prelude_calls {
        if candidate.id == id -> row = Val(candidate)
    }
    if row == None {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR Prelude call has no registry row", "every route must be registered with its checked ABI before source emission", None)
        return "__jet_missing_prelude()"
    }
    route :: row ?? MIRPreludeCall{id: id, family: MIRPreludeFamily.Host, module_name: "", member: "", symbol: MIRSymbol.Runtime{name: "__jet_missing_prelude"}, signature: MIRCallSignature{arity: 0, max_arity: 0, borrow_mask: [Bool]{}}, effect_kind: None, fallibility: MIRCallFallibility.Infallible, abi: MIRPreludeABI.Value, authority: None, db_metadata: None}
    if args.len() < route.signature.arity || args.len() > route.signature.max_arity || route.signature.borrow_mask.len() != args.len() {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR Prelude route arity does not match its emitted arguments", "the checked call ABI and operation payload must agree exactly", None)
        return "__jet_invalid_prelude_call()"
    }
    source :: jet_rust_emit_prelude_symbol(&ctx, id)
    target :: jet_rust_emit_exact_adapter(&ctx, None, source, [MIRCallArg]{})
    positions :: jet_rust_emit_exact_adapter_positions(target)
    rendered := [String]{}
    index := 0
    loop arg in args {
        forced := false
        if source != target {
            loop position in positions { if position == index -> forced = true }
        }
        // A slot read `(slot.as_ref().expect(..)).clone()` is an owned value;
        // only a bare slot reference is already borrowed.
        owned_read :: arg.ends_with(").clone()")
        preborrowed :: arg.starts_with("&") || arg.starts_with("match ") || (!owned_read && (arg.contains(".as_ref().expect") || arg.contains(".as_mut().expect")))
        if (route.signature.borrow_mask[index] || forced) && !preborrowed -> &rendered.push("&({arg})") else -> &rendered.push(arg)
        index += 1
    }
    "{target}({rendered.join(", ")})"
}

fn jet_rust_emit_call_arg(ctx: &JetRustEmitContext, function: MIRFunction, arg: MIRCallArg) -> String Never! {
    borrowed :: arg.access == MIRAccess.Write || (arg.access == MIRAccess.Read && jet_rust_emit_type_is_borrowed(jet_rust_emit_value_type(function, arg.value)))
    jet_rust_emit_call_arg_with_borrow(&ctx, function, arg, borrowed)
}

fn jet_rust_emit_checked_trait_box_target(ctx: &JetRustEmitContext, id: MIRTypeID, span: Span?) -> MIRType? {
    loop row in ctx.program.type_instances {
        if row.identity == (Val(id)) {
            if row.kind == {
                .TraitObject(bounds) -> {
                    if bounds.len() != 1 {
                        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR trait coercion target does not name exactly one trait", "checked trait boxing targets carry one canonical trait bound", span)
                        return None
                    }
                }
                else -> {
                    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR trait coercion target is not a trait object", "checked trait boxing must retain a canonical trait-object type instance", span)
                    return None
                }
            }
            return Val(row)
        }
    }
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR trait coercion target is missing", "checked trait boxing must retain a canonical trait-object type instance", span)
    None
}

fn jet_rust_emit_trait_object_type(ctx: &JetRustEmitContext, id: MIRTypeID) -> String Never! {
    row :: jet_rust_emit_checked_trait_box_target(&ctx, id, None) ?? return "Box<dyn std::any::Any>"
    jet_rust_emit_type(&ctx, row)
}

fn jet_rust_emit_trait_box_source_needs_box(ctx: &JetRustEmitContext, source_ty: MIRType, target_ty: MIRType, span: Span?) -> Bool? {
    target_bound := if target_ty.kind == {
        .TraitObject(bounds) -> if bounds.len() == 1 -> Val(bounds[0]) else -> MIRTraitRef?{None}
        else -> MIRTraitRef?{None}
    }
    bound :: target_bound ?? {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR trait coercion target has no canonical bound", "checked trait boxing targets carry exactly one declared trait identity", span)
        return None
    }
    if source_ty.kind == {
        .TraitObject(_) -> {
            if !mir_type_same_checked_type(source_ty, target_ty) {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR trait boxing attempts an unsupported trait-object upcast", "already dynamic values must match the exact canonical trait-object identity", span)
                return None
            }
            return Val(false)
        }
        .Apply(name, args) -> {
            generic_param := MIRGenericParam?{None}
            if args.len() == 0 {
                loop candidate in ctx.current_generic_params {
                    if candidate.name == name.name && name.id == mir_type_id(candidate.name) {
                        if generic_param != None {
                            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR trait boxing generic parameter is ambiguous", "generic source identities must bind to one checked generic parameter", span)
                            return None
                        }
                        generic_param = Val(candidate)
                    }
                }
            }
            if generic_param == .Val(parameter) {
                has_target_bound := false
                loop candidate in parameter.bounds {
                    if candidate.id == bound.id {
                        if candidate.name != bound.name {
                            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR generic trait bound name disagrees with its identity", "checked generic TraitBox evidence must preserve the exact canonical trait reference", span)
                            return None
                        }
                        has_target_bound = true
                    }
                }
                if !has_target_bound {
                    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR generic trait boxing lacks the target bound", "generic TraitBox sources require the matching checked generic bound", span)
                    return None
                }
            }
            return Val(true)
        }
        else -> {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR trait boxing source is not nominal", "checked TraitBox sources are nominal values or bounded generic parameters", span)
            return None
        }
    }
}

fn jet_rust_emit_call_arg_trait_box(ctx: &JetRustEmitContext, function: MIRFunction, arg: MIRCallArg) -> Bool Never! {
    if arg.box_as_trait == None -> return false
    trait_id :: arg.box_as_trait ?? MIRTypeID{value: 0}
    target :: jet_rust_emit_checked_trait_box_target(&ctx, trait_id, Val(function.span)) ?? return false
    source_ty :: jet_rust_emit_value_type(function, arg.value)
    jet_rust_emit_trait_box_source_needs_box(&ctx, source_ty, target, Val(function.span)) ?? false
}

fn jet_rust_emit_call_arg_with_borrow(ctx: &JetRustEmitContext, function: MIRFunction, arg: MIRCallArg, borrowed: Bool) -> String Never! {
    trait_box :: jet_rust_emit_call_arg_trait_box(&ctx, function, arg)
    has_coercion :: arg.authority_boundary || arg.implicit_clone || arg.shared_auto_clone || arg.widen_fixed_to_list || arg.widen_to_union != None || trait_box || arg.fn_coercion != None
    already_borrowed := false
    value := if {
        borrowed && !has_coercion && arg.access == MIRAccess.Read -> {
            already_borrowed = true
            if arg.place == {
                .Val(place) -> jet_rust_emit_place_reference(&ctx, function, place, MIRAccess.Read)
                else -> {
                    partial :: if jet_rust_emit_partial_projection_only(&ctx, function, arg.value) -> jet_rust_emit_partial_value_reference(&ctx, function, arg.value) else -> String?{None}
                    if partial == .Val(reference) -> reference else -> jet_rust_emit_value_reference(arg.value, false)
                }
            }
        }
        arg.access == MIRAccess.Write -> {
            if arg.place == .Val(place) -> jet_rust_emit_place_reference(&ctx, function, place, MIRAccess.Write) else -> jet_rust_emit_value_reference(arg.value, true)
        }
        arg.access == MIRAccess.Move -> jet_rust_emit_value_move(arg.value)
        else -> jet_rust_emit_value_read(arg.value)
    }
    if arg.authority_boundary -> value = "jet_authority_to_wire(&({value}))"
    if arg.implicit_clone || arg.shared_auto_clone -> value = "({value}).clone()"
    if arg.widen_fixed_to_list -> value = "({value}).to_vec()"
    if arg.widen_to_union == .Val(coercion) {
        value = "{jet_rust_emit_type_name(&ctx, coercion.union)}::{jet_rust_emit_sanitize(coercion.variant)}({value})"
    }
    if trait_box {
        trait_id :: arg.box_as_trait ?? MIRTypeID{value: 0}
        value = "Box::new({value}) as {jet_rust_emit_trait_object_type(&ctx, trait_id)}"
    }
    if arg.fn_coercion == .Val(coercion) {
        target :: jet_rust_emit_type(&ctx, coercion.ty)
        if !coercion.already_boxed {
            wrapper :: if target.starts_with("std::rc::Rc<") -> "std::rc::Rc::new" else -> "Box::new"
            value = "{wrapper}({value})"
        }
        value = "({value}) as {target}"
    }
    if borrowed && arg.access != MIRAccess.Write && !already_borrowed && !(value.starts_with("&(") || value.starts_with("&mut ")) -> value = "&({value})"
    return value
}

fn jet_rust_emit_call_arguments(ctx: &JetRustEmitContext, function: MIRFunction, args: [MIRCallArg], borrow_mask: [Bool]) -> String Never! {
    if borrow_mask.len() < args.len() {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "call ABI borrow metadata does not cover its arguments", "checked call routes must provide one borrow convention for every emitted argument", Val(function.span))
        return ""
    }
    rendered := [String]{}
    index := 0
    loop arg in args {
        &rendered.push(jet_rust_emit_call_arg_with_borrow(&ctx, function, arg, borrow_mask[index]))
        index += 1
    }
    rendered.join(", ")
}

// MIRRust is_string_view_type: `View<str>`/`ViewMut<str>`, through tags.
fn jet_rust_emit_is_string_view_type(ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .Apply(name, args) -> {
            if (name.name != "View" && name.name != "ViewMut") || args.len() != 1 -> return false
            if args[0].kind == {
                .Apply(inner, inner_args) -> return inner_args.len() == 0 && inner.name == "str"
                else -> return false
            }
        }
        .Tagged(_, inner) -> return jet_rust_emit_is_string_view_type(inner)
        else -> return false
    }
}

// MIRRust exact_int_binary's carrier test: exact Int, through refinements.
fn jet_rust_emit_exact_int_carrier(ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .Int -> true
        .InlineRange(base, _, _) | .Tagged(_, base) | .Quantity(base, _) -> jet_rust_emit_exact_int_carrier(base)
        else -> false
    }
}

fn jet_rust_emit_exact_int_hot_helper(op: MIRBinaryOp) -> String? {
    if op == {
        .Add -> Val("jet_int_add_hot")
        .Sub -> Val("jet_int_sub_hot")
        .Mul -> Val("jet_int_mul_hot")
        .BitAnd -> Val("jet_int_bit_and_hot")
        .BitOr -> Val("jet_int_bit_or_hot")
        .BitXor -> Val("jet_int_bit_xor_hot")
        .Div -> Val("jet_int_div_hot")
        .FloorDiv -> Val("jet_int_floor_div_hot")
        .Mod -> Val("jet_int_mod_hot")
        .Rem -> Val("jet_int_rem_hot")
        .Shl -> Val("jet_int_shl_hot")
        .Shr -> Val("jet_int_shr_hot")
        else -> None
    }
}

// MIRRust exact_int_binary: Int arithmetic takes the raw-word hot macro when
// one exists, else the owned helper; division-like ops carry their source line.
fn jet_rust_emit_exact_int_binary(ctx: &JetRustEmitContext, function: MIRFunction, op: MIRBinaryOp, left: MIRValueID, right: MIRValueID, location: MIRPanicLoc?) -> String? {
    if !jet_rust_emit_exact_int_carrier(jet_rust_emit_value_type(function, left)) || !jet_rust_emit_exact_int_carrier(jet_rust_emit_value_type(function, right)) -> return None
    owned :: jet_rust_emit_exact_int_helper(op) ?? return None
    contextual :: op == MIRBinaryOp.Div || op == MIRBinaryOp.FloorDiv || op == MIRBinaryOp.Mod || op == MIRBinaryOp.Rem || op == MIRBinaryOp.Pow || op == MIRBinaryOp.Shl || op == MIRBinaryOp.Shr
    root :: ~ctx.config.root_prefix
    left_text :: jet_rust_emit_value_reference(left, false)
    right_text :: jet_rust_emit_value_reference(right, false)
    context := ""
    if contextual {
        loc :: location ?? {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR exact Int arithmetic is missing source location", "checked division, remainder, power and shift operations carry their trap location", Val(function.span))
            return Val("unreachable!(\"MIR exact Int arithmetic location\")")
        }
        context = ", {jet_rust_emit_source_path(&ctx, loc.file)}, {loc.line}u32"
    }
    if jet_rust_emit_exact_int_hot_helper(op) == .Val(hot) -> return Val("{root}jet_std::jet_int_owned_from_raw_result({root}jet_std::{hot}!(({left_text}).to_raw(), ({right_text}).to_raw(){context}))")
    Val("{root}jet_std::{owned}({left_text}, {right_text}{context})")
}

// MIRRust binary: the primitive operator spelling for non-Int operands.
fn jet_rust_emit_primitive_binary(ctx: &JetRustEmitContext, op: MIRBinaryOp, left: String, right: String) -> String Never! {
    root :: ~ctx.config.root_prefix
    if op == {
        .Compare -> "match ({left}).cmp(&({right})) {{ std::cmp::Ordering::Less => {root}__jet_Ordering::__jet_Less, std::cmp::Ordering::Equal => {root}__jet_Ordering::__jet_Equal, std::cmp::Ordering::Greater => {root}__jet_Ordering::__jet_Greater }}"
        .FloorDiv -> "({left}).jet_floor_div({right})"
        .Mod -> "({left}).jet_mod({right})"
        .Rem -> "({left}).rem({right})"
        .Pow -> "({left}).jet_pow({right})"
        else -> "(({left}) {jet_rust_emit_binary_operator(op)} ({right}))"
    }
}

// MIRRust canonical_math_borrow: math kernels that borrow their left operand.
fn jet_rust_emit_canonical_math_borrow(symbol: String, index: Int) -> Bool Never! {
    bare := symbol
    loop part in symbol.split("::") -> bare = part
    if index == 1 -> return bare == "jet_math_Float_mul_Vec3" || bare == "jet_math_Float_div_Vec3"
    if index != 0 -> return false
    borrowing :: [String]{"jet_math_Vec2_add", "jet_math_Vec2_sub", "jet_math_Vec2_mul", "jet_math_Vec3_add", "jet_math_Vec3_sub", "jet_math_Vec3_hadamard_mul", "jet_math_Vec4_add", "jet_math_Vec4_sub", "jet_math_Vec4_mul", "jet_math_Vec3_mul", "jet_math_Vec3_div", "jet_math_Mat3_add", "jet_math_Mat3_sub", "jet_math_Mat3_mul", "jet_math_Mat3_matmul", "jet_math_Mat3_transform", "jet_math_Mat4_add", "jet_math_Mat4_sub", "jet_math_Mat4_mul", "jet_math_Mat4_matmul", "jet_math_Mat4_transform", "jet_math_Vec2_dot", "jet_math_Vec3_dot", "jet_math_Vec4_dot", "jet_math_Vec3_cross"}
    borrowing.contains(bare)
}

fn jet_rust_emit_binary(ctx: &JetRustEmitContext, function: MIRFunction, op: MIRBinaryOp, dispatch: MIRBinaryDispatch, left: MIRValueID, right: MIRValueID, location: MIRPanicLoc?) -> String Never! {
    if dispatch == .Prelude(call, dispatch_location) {
        route :: jet_rust_emit_prelude_row(&ctx, call) ?? return "unreachable!(\"missing Prelude route\")"
        symbol :: jet_rust_emit_prelude_symbol(&ctx, call)
        exact :: jet_rust_emit_exact_adapter(&ctx, None, symbol, [MIRCallArg]{})
        adapted :: exact != symbol
        if adapted {
            if jet_rust_emit_exact_int_binary(&ctx, function, op, left, right, dispatch_location) == .Val(direct) -> return direct
        }
        positions :: if adapted -> jet_rust_emit_exact_adapter_positions(exact) else -> [Int]{}
        args := [String]{}
        operands :: [MIRValueID]{left, right}
        loop (index, value) in operands {
            borrowed :: positions.contains(index) || (index < route.signature.borrow_mask.len() && route.signature.borrow_mask[index]) || jet_rust_emit_canonical_math_borrow(symbol, index)
            &args.push(if borrowed -> jet_rust_emit_value_reference(value, false) else -> jet_rust_emit_value_read(value))
        }
        extras := [String]{}
        if dispatch_location == .Val(loc) {
            &extras.push(jet_rust_emit_source_path(&ctx, loc.file))
            &extras.push("{loc.line}u32")
        }
        args = jet_rust_emit_append_prelude_context(&ctx, function, call, args, extras)
        if args.len() < route.signature.arity || args.len() > route.signature.max_arity || route.signature.borrow_mask.len() != args.len() {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR Prelude operator call arity does not match its checked ABI", "the checked operator route and its operands plus source context must agree exactly", Val(function.span))
            return "unreachable!(\"Prelude operator arity\")"
        }
        rendered := [String]{}
        loop (index, arg) in args {
            &rendered.push(if index >= 2 && route.signature.borrow_mask[index] -> "&({arg})" else -> arg)
        }
        return "{exact}({rendered.join(", ")})"
    }
    left_ty :: jet_rust_emit_value_type(function, left)
    right_ty :: jet_rust_emit_value_type(function, right)
    if op == MIRBinaryOp.Add && left_ty.kind == MIRTypeKind.String && (right_ty.kind == MIRTypeKind.String || jet_rust_emit_is_string_view_type(right_ty)) {
        right_text :: if jet_rust_emit_is_string_view_type(right_ty) -> jet_rust_emit_value_read(right) else -> jet_rust_emit_value_reference(right, false)
        return "(({jet_rust_emit_value_read(left)}) + ({right_text}))"
    }
    if op == MIRBinaryOp.Eq || op == MIRBinaryOp.Ne {
        if jet_rust_emit_canonical_equality(&ctx, function, left, right) == .Val(equal) {
            return if op == MIRBinaryOp.Eq -> equal else -> "!({equal})"
        }
    }
    if op == MIRBinaryOp.Lt || op == MIRBinaryOp.Gt || op == MIRBinaryOp.Le || op == MIRBinaryOp.Ge || op == MIRBinaryOp.Compare {
        left_view :: jet_rust_emit_is_string_view_type(left_ty)
        right_view :: jet_rust_emit_is_string_view_type(right_ty)
        if (left_view && right_ty.kind == MIRTypeKind.String) || (right_view && left_ty.kind == MIRTypeKind.String) {
            // A text view against a String: Rust orders `str` with `str`
            // only, so both sides read as `&str`.
            left_text :: "::std::convert::AsRef::<str>::as_ref(&({jet_rust_emit_value_reference(left, false)}))"
            right_text :: "::std::convert::AsRef::<str>::as_ref(&({jet_rust_emit_value_reference(right, false)}))"
            return jet_rust_emit_primitive_binary(&ctx, op, left_text, right_text)
        }
    }
    if jet_rust_emit_exact_int_binary(&ctx, function, op, left, right, location) == .Val(exact) -> return exact
    if op == MIRBinaryOp.Compare -> return jet_rust_emit_primitive_binary(&ctx, op, jet_rust_emit_value_reference(left, false), jet_rust_emit_value_reference(right, false))
    jet_rust_emit_primitive_binary(&ctx, op, jet_rust_emit_value_read(left), jet_rust_emit_value_read(right))
}

// MIRRust canonical_type: a typed identity reads its canonical instance row.
fn jet_rust_emit_canonical_instance(ctx: &JetRustEmitContext, ty: MIRType) -> MIRType Never! {
    identity :: ty.identity ?? return ~ty
    loop instance in ctx.program.type_instances {
        if instance.identity == (Val(identity)) -> return ~instance
    }
    ~ty
}

// MIRRust structural_type_def_for: the nominal or anonymous-union definition
// behind an Apply or Union type.
fn jet_rust_emit_equality_type_def(ctx: &JetRustEmitContext, ty: MIRType) -> MIRTypeDef? {
    if ty.kind == {
        .Apply(_, _) -> return jet_rust_emit_structural_type_def(&ctx, ty)
        .Union(members) -> {
            identity := ty.identity
            if identity == None {
                loop instance in ctx.program.type_instances {
                    if instance.identity != None && mir_type_same_checked_type(instance, ty) {
                        identity = instance.identity
                        break
                    }
                }
            }
            if identity == .Val(id) {
                loop definition in ctx.program.types { if definition.id == id -> return Val(definition) }
                return None
            }
            loop definition in ctx.program.types {
                if !definition.name.starts_with("__JetUnion_") -> next
                if definition.kind == {
                    .Enum(variants, _) -> {
                        if variants.len() != members.len() -> next
                        matched := true
                        loop (index, variant) in variants {
                            if variant.payload == {
                                .Single(payload) -> {
                                    if !mir_type_same_checked_type(payload, members[index]) && mir_type_canonical_key(payload) != mir_type_canonical_key(members[index]) -> matched = false
                                }
                                else -> matched = false
                            }
                        }
                        if matched -> return Val(definition)
                    }
                    else -> {}
                }
            }
            return None
        }
        else -> return None
    }
}

// MIRRust selected_equatable_impl_for_type: the selected user Equatable impl.
fn jet_rust_emit_selected_equatable_impl(ctx: &JetRustEmitContext, ty: MIRType) -> MIRTraitRef? {
    nominal :: if ty.kind == {
        .Apply(name, _) -> Val(name.name)
        else -> String?{None}
    }
    loop implementation in ctx.program.impls {
        trait_ref :: implementation.trait_ref ?? next
        if trait_ref.name != "Equatable" || !jet_rust_emit_impl_target_enabled(&ctx, implementation) -> next
        if mir_type_same_checked_type(implementation.self_type, ty) -> return Val(trait_ref)
        if nominal == .Val(name) {
            if implementation.self_type.kind == {
                .Apply(self_name, _) -> { if self_name.name == name -> return Val(trait_ref) }
                else -> {}
            }
        }
    }
    None
}

fn jet_rust_emit_canonical_equality_needed(ctx: &JetRustEmitContext, source: MIRType) -> Bool Never! {
    ty :: jet_rust_emit_canonical_instance(&ctx, source)
    if ty.kind == {
        .List(_) | .Map(_, _) | .Option(_) | .Result(_, _) | .Tuple(_) | .FixedList(_, _) -> true
        .InlineRange(base, _, _) | .Tagged(_, base) | .Quantity(base, _) -> jet_rust_emit_canonical_equality_needed(&ctx, base)
        .Apply(_, _) | .Union(_) -> jet_rust_emit_equality_type_def(&ctx, ty) != None && jet_rust_emit_selected_equatable_impl(&ctx, ty) == None
        else -> false
    }
}

fn jet_rust_emit_equality_edge_boxed(definition: MIRTypeDef, edge: String) -> Bool Never! {
    loop candidate in definition.boxed_edges { if candidate == edge -> return true }
    false
}

fn jet_rust_emit_equality_field(ctx: &JetRustEmitContext, definition: MIRTypeDef, edge: String, receiver: String, field: MIRField) -> String Never! {
    value :: "({receiver}).{jet_rust_emit_field_name(&ctx, field.id)}"
    if jet_rust_emit_equality_edge_boxed(definition, edge) -> "{value}.as_ref()" else -> "&{value}"
}

// MIRRust canonical_equality_expression: structural `==` over collections,
// carriers and nominal rows; a selected user Equatable impl is called directly.
fn jet_rust_emit_canonical_equality_expression(ctx: &JetRustEmitContext, source: MIRType, left: String, right: String, seen: &[MIRTypeID]) -> String Never! {
    ty :: jet_rust_emit_canonical_instance(&ctx, source)
    if ty.kind == {
        .List(inner) -> {
            columnar :: jet_rust_emit_is_columnar_list(&ctx, inner)
            element :: if columnar -> jet_rust_emit_canonical_equality_expression(&ctx, inner, "&__jet_left", "&__jet_right", &seen) else -> jet_rust_emit_canonical_equality_expression(&ctx, inner, "__jet_left", "__jet_right", &seen)
            iter :: if columnar -> "iter_aos" else -> "iter"
            return "(({left}).len() == ({right}).len() && ({left}).{iter}().zip(({right}).{iter}()).all(|(__jet_left,__jet_right)| {element}))"
        }
        .Map(key, value) -> {
            key_equal :: jet_rust_emit_canonical_equality_expression(&ctx, key, "__jet_left_key", "__jet_right_key", &seen)
            value_equal :: jet_rust_emit_canonical_equality_expression(&ctx, value, "__jet_left_value", "__jet_right_value", &seen)
            return "(({left}).len() == ({right}).len() && ({left}).iter().zip(({right}).iter()).all(|((__jet_left_key,__jet_left_value),(__jet_right_key,__jet_right_value))| {key_equal} && {value_equal}))"
        }
        .Option(inner) -> {
            inner_equal :: jet_rust_emit_canonical_equality_expression(&ctx, inner, "__jet_left", "__jet_right", &seen)
            return "match ({left}, {right}) {{ (Ok(__jet_left), Ok(__jet_right)) => {inner_equal}, (Err(_), Err(_)) => true, _ => false }}"
        }
        .Result(ok, err) -> {
            ok_equal :: jet_rust_emit_canonical_equality_expression(&ctx, ok, "__jet_left", "__jet_right", &seen)
            err_equal :: jet_rust_emit_canonical_equality_expression(&ctx, err, "__jet_left", "__jet_right", &seen)
            return "match ({left}, {right}) {{ (Ok(__jet_left), Ok(__jet_right)) => {ok_equal}, (Err(__jet_left), Err(__jet_right)) => {err_equal}, _ => false }}"
        }
        .Tuple(fields) -> {
            parts := [String]{}
            loop (index, field) in fields -> &parts.push(jet_rust_emit_canonical_equality_expression(&ctx, field.ty, "&({left}).{index}", "&({right}).{index}", &seen))
            return if parts.len() == 0 -> "true" else -> "({parts.join(" && ")})"
        }
        .FixedList(elem, _) -> {
            element :: jet_rust_emit_canonical_equality_expression(&ctx, elem, "__jet_left", "__jet_right", &seen)
            return "({left}).iter().zip(({right}).iter()).all(|(__jet_left,__jet_right)| {element})"
        }
        .InlineRange(base, _, _) | .Tagged(_, base) | .Quantity(base, _) -> return jet_rust_emit_canonical_equality_expression(&ctx, base, left, right, &seen)
        .Apply(_, _) | .Union(_) -> {}
        else -> return "(({left}) == ({right}))"
    }
    if jet_rust_emit_selected_equatable_impl(&ctx, ty) == .Val(trait_ref) -> return "<{jet_rust_emit_type(&ctx, ty)} as {jet_rust_emit_trait_name(&ctx, trait_ref.id)}>::equal({left}, {right})"
    definition :: jet_rust_emit_equality_type_def(&ctx, ty) ?? return "(({left}) == ({right}))"
    if seen.contains(definition.id) -> return "(({left}) == ({right}))"
    &seen.push(definition.id)
    expression :: if definition.kind == {
        .Struct(fields, _) -> {
            parts := [String]{}
            loop field in fields {
                if field.computed -> next
                left_field :: jet_rust_emit_equality_field(&ctx, definition, field.name, left, field)
                right_field :: jet_rust_emit_equality_field(&ctx, definition, field.name, right, field)
                &parts.push(jet_rust_emit_canonical_equality_expression(&ctx, field.ty, left_field, right_field, &seen))
            }
            if parts.len() == 0 -> "true" else -> "({parts.join(" && ")})"
        }
        .Enum(variants, _) -> {
            arms := [String]{}
            loop variant in variants {
                head :: jet_rust_emit_enum_variant_name(&ctx, definition.id, variant.name)
                if variant.payload == {
                    .Unit -> &arms.push("({head}, {head}) => true")
                    .Single(payload) -> {
                        boxed :: jet_rust_emit_equality_edge_boxed(definition, variant.name)
                        left_value :: if boxed -> "__jet_left.as_ref()" else -> "__jet_left"
                        right_value :: if boxed -> "__jet_right.as_ref()" else -> "__jet_right"
                        &arms.push("({head}(__jet_left), {head}(__jet_right)) => {jet_rust_emit_canonical_equality_expression(&ctx, payload, left_value, right_value, &seen)}")
                    }
                    .Named(fields) -> {
                        left_bindings := [String]{}
                        right_bindings := [String]{}
                        parts := [String]{}
                        index := 0
                        loop field in fields {
                            if field.computed -> next
                            field_name :: jet_rust_emit_field_name(&ctx, field.id)
                            &left_bindings.push("{field_name}: __jet_left_{index}")
                            &right_bindings.push("{field_name}: __jet_right_{index}")
                            boxed :: jet_rust_emit_equality_edge_boxed(definition, "{variant.name}.{field.name}")
                            left_value :: if boxed -> "__jet_left_{index}.as_ref()" else -> "__jet_left_{index}"
                            right_value :: if boxed -> "__jet_right_{index}.as_ref()" else -> "__jet_right_{index}"
                            &parts.push(jet_rust_emit_canonical_equality_expression(&ctx, field.ty, left_value, right_value, &seen))
                            index += 1
                        }
                        equal :: if parts.len() == 0 -> "true" else -> "({parts.join(" && ")})"
                        left_pattern :: if left_bindings.len() == 0 -> "{head} {{ .. }}" else -> "{head} {{ {left_bindings.join(", ")}, .. }}"
                        right_pattern :: if right_bindings.len() == 0 -> "{head} {{ .. }}" else -> "{head} {{ {right_bindings.join(", ")}, .. }}"
                        &arms.push("({left_pattern}, {right_pattern}) => {equal}")
                    }
                }
            }
            &arms.push("_ => false")
            "match ({left}, {right}) {{ {arms.join(", ")} }}"
        }
        .Distinct(base, _) -> jet_rust_emit_canonical_equality_expression(&ctx, base, "&({left}).0", "&({right}).0", &seen)
        .UnitFamily(members) -> {
            arms := [String]{}
            type_name :: jet_rust_emit_type_name(&ctx, definition.id)
            loop member in members {
                head :: "{type_name}::{jet_rust_emit_sanitize(member)}"
                &arms.push("({head}, {head}) => true")
            }
            &arms.push("_ => false")
            "match ({left}, {right}) {{ {arms.join(", ")} }}"
        }
        .Alias(target) -> jet_rust_emit_canonical_equality_expression(&ctx, target, left, right, &seen)
    }
    _ := &seen.pop()
    expression
}

// MIRRust canonical_equality: `==`/`!=` over structural carriers compares
// through the canonical expression instead of a Rust PartialEq derive.
fn jet_rust_emit_canonical_equality(ctx: &JetRustEmitContext, function: MIRFunction, left: MIRValueID, right: MIRValueID) -> String? {
    ty :: jet_rust_emit_value_type(function, left)
    if !jet_rust_emit_canonical_equality_needed(&ctx, ty) -> return None
    seen := [MIRTypeID]{}
    equal :: jet_rust_emit_canonical_equality_expression(&ctx, ty, "&__jet_left", "&__jet_right", &seen)
    Val("{{ let __jet_left = {jet_rust_emit_value_read(left)}; let __jet_right = {jet_rust_emit_value_read(right)}; {equal} }}")
}

// MIRRust unary: exact Int (through refinements) takes the owned helper by
// reference; every other operand applies the Rust operator to the slot value.
fn jet_rust_emit_unary_text(ctx: &JetRustEmitContext, op: MIRUnaryOp, value: String, ty: MIRType) -> String Never! {
    if ty.kind == {
        .InlineRange(base, _, _) | .Tagged(_, base) | .Quantity(base, _) -> return jet_rust_emit_unary_text(&ctx, op, value, base)
        .Int -> {
            member :: if op == MIRUnaryOp.Neg -> "neg" else -> "not"
            return "{ctx.config.root_prefix}jet_std::jet_int_owned_{member}(&({value}))"
        }
        else -> return if op == MIRUnaryOp.Neg -> "(-({value}))" else -> "(!({value}))"
    }
}

fn jet_rust_emit_unary(ctx: &JetRustEmitContext, function: MIRFunction, op: MIRUnaryOp, value: MIRValueID) -> String Never! {
    jet_rust_emit_unary_text(&ctx, op, "*({jet_rust_emit_value_reference(value, false)})", jet_rust_emit_value_type(function, value))
}

fn jet_rust_emit_string_format(format: MIRStringFormat, value: String) -> String Never! {
    if format == {
        .Display -> "({value}).jet_show()"
        .Debug -> "({value}).jet_debug()"
        .Pretty -> "({value}).jet_pretty()"
        .Fixed(digits) -> "({value}).jet_format_fixed({digits})"
        .Grouped(digits) -> "({value}).jet_format_grouped({digits})"
        .Hex(digits) -> "({value}).jet_format_hex({digits})"
        .Pad(width, fill) -> "({value}).jet_format_pad({width}, {jet_rust_emit_quote(fill)})"
        .PadLeft(width, fill) -> "({value}).jet_format_pad_left({width}, {jet_rust_emit_quote(fill)})"
        .Sci(digits) -> "({value}).jet_format_sci({digits})"
        .Percent(digits) -> "({value}).jet_format_percent({digits})"
        .Bin -> "({value}).jet_format_bin()"
        .Oct -> "({value}).jet_format_oct()"
        .Unit(unit) -> {
            member :: if unit == {
                .Symbol -> "jet_unit_symbol"
                .Name -> "jet_unit_name"
                else -> "jet_unit_bare"
            }
            "{value}.{member}()"
        }
    }
}

fn jet_rust_emit_build_string(function: MIRFunction, parts: [MIRStringPart]) -> String Never! {
    lines := [String]{"{{ let mut __jet_rendered = String::new();"}
    loop part in parts {
        if part.kind == {
            .Literal(text) -> &lines.push("__jet_rendered.push_str({jet_rust_emit_quote(text)});")
            .Interpolation(value, format) -> &lines.push("__jet_rendered.push_str(&{jet_rust_emit_string_format(format, jet_rust_emit_value_read(value))});")
        }
    }
    &lines.push("__jet_rendered }}")
    lines.join(" ")
}

fn jet_rust_emit_generic_call_args(ctx: &JetRustEmitContext, type_args: [MIRType]) -> String Never! {
    if type_args.len() == 0 -> return ""
    rendered := [String]{}
    loop ty in type_args -> &rendered.push(jet_rust_emit_type(&ctx, ty))
    "::<{rendered.join(", ")}>"
}

fn jet_rust_emit_exact_adapter_integer_args(function: MIRFunction?, args: [MIRCallArg], positions: [Int]) -> Bool Never! {
    loop position in positions {
        if position < 0 || position >= args.len() {
            if function == None -> next
            return false
        }
        if function == .Val(checked_function) {
            if !mir_type_is_integer(jet_rust_emit_value_type(checked_function, args[position].value)) -> return false
        }
    }
    true
}

fn jet_rust_emit_exact_adapter(ctx: &JetRustEmitContext, function: MIRFunction?, symbol: String, args: [MIRCallArg]) -> String Never! {
    root := ctx.config.root_prefix
    if (symbol == "{root}jet_fraction_from_parts" || symbol == "jet_fraction_from_parts") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0, 1}) -> return "{root}jet_fraction_from_owned_parts"
    if (symbol == "{root}JetDate::new" || symbol == "JetDate::new") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0, 1, 2}) -> return "{root}jet_local_date_owned"
    if (symbol == "{root}JetLocalTime::new" || symbol == "JetLocalTime::new") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0, 1, 2}) -> return "{root}jet_local_time_owned"
    if (symbol == "{root}JetPeriod::new" || symbol == "JetPeriod::new") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0, 1, 2}) -> return "{root}jet_period_owned"
    if (symbol == "{root}jet_std::jet_int_abs" || symbol == "jet_std::jet_int_abs") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0}) -> return "{root}jet_std::jet_int_owned_abs"
    if (symbol == "{root}jet_std::jet_int_add" || symbol == "jet_std::jet_int_add") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0, 1}) -> return "{root}jet_std::jet_int_owned_add"
    if (symbol == "{root}jet_std::jet_int_sub" || symbol == "jet_std::jet_int_sub") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0, 1}) -> return "{root}jet_std::jet_int_owned_sub"
    if (symbol == "{root}jet_std::jet_int_mul" || symbol == "jet_std::jet_int_mul") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0, 1}) -> return "{root}jet_std::jet_int_owned_mul"
    if (symbol == "{root}jet_std::jet_int_bit_and" || symbol == "jet_std::jet_int_bit_and") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0, 1}) -> return "{root}jet_std::jet_int_owned_bit_and"
    if (symbol == "{root}jet_std::jet_int_bit_or" || symbol == "jet_std::jet_int_bit_or") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0, 1}) -> return "{root}jet_std::jet_int_owned_bit_or"
    if (symbol == "{root}jet_std::jet_int_bit_xor" || symbol == "jet_std::jet_int_bit_xor") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0, 1}) -> return "{root}jet_std::jet_int_owned_bit_xor"
    if (symbol == "{root}jet_std::jet_int_neg" || symbol == "jet_std::jet_int_neg") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0}) -> return "{root}jet_std::jet_int_owned_neg"
    if (symbol == "{root}jet_std::jet_int_not" || symbol == "jet_std::jet_int_not") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0}) -> return "{root}jet_std::jet_int_owned_not"
    if (symbol == "{root}jet_std::jet_int_div" || symbol == "jet_std::jet_int_div") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0, 1}) -> return "{root}jet_std::jet_int_owned_div"
    if (symbol == "{root}jet_std::jet_int_rem" || symbol == "jet_std::jet_int_rem") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0, 1}) -> return "{root}jet_std::jet_int_owned_rem"
    if (symbol == "{root}jet_std::jet_int_div_euclid" || symbol == "jet_std::jet_int_div_euclid") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0, 1}) -> return "{root}jet_std::jet_int_owned_div_euclid"
    if (symbol == "{root}jet_std::jet_int_rem_euclid" || symbol == "jet_std::jet_int_rem_euclid") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0, 1}) -> return "{root}jet_std::jet_int_owned_rem_euclid"
    if (symbol == "{root}jet_std::jet_int_floor_div" || symbol == "jet_std::jet_int_floor_div") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0, 1}) -> return "{root}jet_std::jet_int_owned_floor_div"
    if (symbol == "{root}jet_std::jet_int_mod" || symbol == "jet_std::jet_int_mod") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0, 1}) -> return "{root}jet_std::jet_int_owned_mod"
    if (symbol == "{root}jet_std::jet_int_pow" || symbol == "jet_std::jet_int_pow") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0, 1}) -> return "{root}jet_std::jet_int_owned_pow"
    if (symbol == "{root}jet_std::jet_int_shl" || symbol == "jet_std::jet_int_shl") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0, 1}) -> return "{root}jet_std::jet_int_owned_shl"
    if (symbol == "{root}jet_std::jet_int_shr" || symbol == "jet_std::jet_int_shr") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0, 1}) -> return "{root}jet_std::jet_int_owned_shr"
    if (symbol == "{root}jet_std::jet_int_checked_widen" || symbol == "jet_std::jet_int_checked_widen") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0}) -> return "{root}jet_std::jet_int_owned_checked_widen"
    if (symbol == "{root}jet_std::jet_int_try_from_checked" || symbol == "jet_std::jet_int_try_from_checked") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0}) -> return "{root}jet_std::jet_int_owned_try_from_checked"
    if (symbol == "{root}jet_std::jet_int_checked_fixed" || symbol == "jet_std::jet_int_checked_fixed") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0}) -> return "{root}jet_std::jet_int_owned_checked_fixed"
    if (symbol == "{root}jet_numeric_int_bit_count" || symbol == "jet_numeric_int_bit_count") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0}) -> return "{root}jet_std::jet_int_owned_bit_count"
    if (symbol == "{root}jet_inline_range_from_int" || symbol == "jet_inline_range_from_int") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0}) -> return "{root}jet_std::jet_int_owned_inline_range"
    if (symbol == "{root}jet_std::jet_int_to_radix" || symbol == "jet_std::jet_int_to_radix") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0, 1}) -> return "{root}jet_std::jet_int_owned_to_radix"
    if (symbol == "{root}jet_std::jet_int_from_radix" || symbol == "jet_std::jet_int_from_radix") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{1}) -> return "{root}jet_std::jet_int_owned_from_radix"
    if (symbol == "{root}jet_std::jet_int_parse" || symbol == "jet_std::jet_int_parse") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{}) -> return "{root}jet_std::jet_int_owned_parse"
    if (symbol == "{root}jet_fmt_decimal_int" || symbol == "jet_fmt_decimal_int") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0, 1}) -> return "{root}jet_std::jet_fmt_decimal_int_owned"
    if (symbol == "{root}jet_fmt_grouped_int" || symbol == "jet_fmt_grouped_int") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0, 1}) -> return "{root}jet_std::jet_fmt_grouped_int_owned"
    if (symbol == "{root}jet_fmt_hex" || symbol == "jet_fmt_hex") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0, 1}) -> return "{root}jet_std::jet_fmt_hex_owned"
    if (symbol == "{root}jet_fmt_bin" || symbol == "jet_fmt_bin") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0}) -> return "{root}jet_std::jet_fmt_bin_owned"
    if (symbol == "{root}jet_fmt_oct" || symbol == "jet_fmt_oct") && jet_rust_emit_exact_adapter_integer_args(function, args, [Int]{0}) -> return "{root}jet_std::jet_fmt_oct_owned"
    ~symbol
}

fn jet_rust_emit_exact_adapter_positions(target: String) -> [Int] Never! {
    if {
        target.ends_with("jet_local_date_owned") || target.ends_with("jet_local_time_owned") || target.ends_with("jet_period_owned") -> [Int]{0, 1, 2}
        target.ends_with("jet_int_owned_from_radix") -> [Int]{1}
        target.ends_with("jet_int_owned_parse") -> [Int]{}
        target.ends_with("jet_fraction_from_owned_parts") -> [Int]{0, 1}
        target.ends_with("jet_int_owned_add") || target.ends_with("jet_int_owned_sub") || target.ends_with("jet_int_owned_mul") || target.ends_with("jet_int_owned_bit_and") || target.ends_with("jet_int_owned_bit_or") || target.ends_with("jet_int_owned_bit_xor") || target.ends_with("jet_int_owned_div") || target.ends_with("jet_int_owned_rem") || target.ends_with("jet_int_owned_div_euclid") || target.ends_with("jet_int_owned_rem_euclid") || target.ends_with("jet_int_owned_floor_div") || target.ends_with("jet_int_owned_mod") || target.ends_with("jet_int_owned_pow") || target.ends_with("jet_int_owned_shl") || target.ends_with("jet_int_owned_shr") || target.ends_with("jet_int_owned_to_radix") || target.ends_with("jet_fmt_decimal_int_owned") || target.ends_with("jet_fmt_grouped_int_owned") || target.ends_with("jet_fmt_hex_owned") -> [Int]{0, 1}
        else -> [Int]{0}
    }
}

fn jet_rust_emit_exact_adapter_mask(args: [MIRCallArg], source: String, mask: [Bool], target: String) -> [Bool] Never! {
    updated := mask
    if source != target {
        loop position in jet_rust_emit_exact_adapter_positions(target) {
            if position < args.len() -> updated[position] = true
        }
    }
    updated
}

fn jet_rust_emit_prelude_call(ctx: &JetRustEmitContext, function: MIRFunction, id: MIRPreludeCallID, args: [MIRCallArg], type_args: [MIRType]) -> String Never! {
    row := MIRPreludeCall?{None}
    loop candidate in ctx.program.prelude_calls { if candidate.id == id -> row = Val(candidate) }
    if row == None {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR Prelude route is missing", "checked Prelude calls require one canonical route row", Val(function.span))
        return "unreachable!(\"missing Prelude route\")"
    }
    route :: row ?? MIRPreludeCall{id: id, family: MIRPreludeFamily.Host, module_name: "", member: "", symbol: MIRSymbol.Runtime{name: "__jet_missing_prelude"}, signature: MIRCallSignature{arity: 0, max_arity: 0, borrow_mask: [Bool]{}}, effect_kind: None, fallibility: MIRCallFallibility.Infallible, abi: MIRPreludeABI.Value, authority: None, db_metadata: None}
    if args.len() < route.signature.arity || args.len() > route.signature.max_arity || route.signature.borrow_mask.len() != args.len() {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR Prelude call arity does not match its checked ABI", "the checked Prelude route and call arguments must agree exactly", Val(function.span))
        return "unreachable!(\"Prelude call arity\")"
    }
    symbol :: jet_rust_emit_prelude_symbol(&ctx, id)
    exact :: jet_rust_emit_exact_adapter(&ctx, Val(function), symbol, args)
    mask := route.signature.borrow_mask
    mask = jet_rust_emit_exact_adapter_mask(args, symbol, mask, exact)
    rendered :: jet_rust_emit_call_arguments(&ctx, function, args, mask)
    "{exact}{jet_rust_emit_generic_call_args(&ctx, type_args)}({rendered})"
}

fn jet_rust_emit_function_failure(ctx: &JetRustEmitContext, id: MIRFunctionID) -> MIRCallFallibility Never! {
    loop function in ctx.program.functions {
        if function.id == id {
            return if function.failure == {
                .Infallible -> MIRCallFallibility.Infallible
                .Result(success, error) -> MIRCallFallibility.Failure{failure: MIRFailureCarrier.Result{success: success, error: error}}
                .Optional(value) -> MIRCallFallibility.Failure{failure: MIRFailureCarrier.Optional{value: value}}
                .Diverges(value) -> MIRCallFallibility.Failure{failure: MIRFailureCarrier.Diverges{value: value}}
            }
        }
    }
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR callee function is missing from the emitter registry", "fallibility propagation requires the checked target function row", None)
    MIRCallFallibility.Infallible
}

fn jet_rust_emit_failure_needs_try(carrier: MIRCallFallibility, result_ty: MIRType) -> Bool Never! {
    if carrier == {
        .Failure(failure) -> {
            if failure == {
                .Result(success, _) -> return mir_type_same_checked_type(success, result_ty)
                .Optional(value) -> return mir_type_same_checked_type(value, result_ty)
                else -> return false
            }
        }
        .Infallible -> return false
    }
}

fn jet_rust_emit_indirect_borrow_mask(function: MIRFunction, value: MIRValueID) -> [Bool] Never! {
    ty :: jet_rust_emit_value_type(function, value)
    if ty.kind == {
        .Fn(signature) -> {
            conventions := [MIRAccess]{}
            if signature.call_metadata != None -> conventions = (signature.call_metadata ?? MIRCallMetadata{names: [String]{}, defaults: [Bool]{}, variadic: [Bool]{}, conventions: [MIRAccess]{}, policies: MIRCallablePolicyChain{policies: [MIRCallablePolicy]{}}}).conventions
            mask := [Bool]{}
            index := 0
            loop parameter in signature.params {
                access := if index < conventions.len() -> conventions[index] else -> MIRAccess.Read
                &mask.push(access == MIRAccess.Write || (access == MIRAccess.Read && jet_rust_emit_type_is_borrowed(parameter)))
                index += 1
            }
            return mask
        }
        .SendFn(params, _, conventions) -> {
            mask := [Bool]{}
            index := 0
            loop parameter in params {
                access := if index < conventions.len() -> conventions[index] else -> MIRAccess.Read
                &mask.push(access == MIRAccess.Write || (access == MIRAccess.Read && jet_rust_emit_type_is_borrowed(parameter)))
                index += 1
            }
            return mask
        }
        else -> {}
    }
    [Bool]{}
}

fn jet_rust_emit_call_borrow_mask(ctx: &JetRustEmitContext, callee: MIRCallee, function: MIRFunction, args: [MIRCallArg]) -> [Bool] Never! {
    if callee == {
        .User(id) -> {
            mask := [Bool]{}
            loop candidate in ctx.program.functions {
                if candidate.id == id {
                    loop parameter in candidate.params -> &mask.push(parameter.access == MIRAccess.Write || (parameter.access == MIRAccess.Read && jet_rust_emit_type_is_borrowed(parameter.ty)))
                    return mask
                }
            }
        }
        .Associated(id, _) -> {
            mask := [Bool]{}
            loop candidate in ctx.program.functions {
                if candidate.id == id {
                    loop parameter in candidate.params -> &mask.push(parameter.access == MIRAccess.Write || (parameter.access == MIRAccess.Read && jet_rust_emit_type_is_borrowed(parameter.ty)))
                    return mask
                }
            }
        }
        .Method(id, _) -> {
            mask := [Bool]{}
            loop candidate in ctx.program.functions {
                if candidate.id == id {
                    loop parameter in candidate.params -> &mask.push(parameter.access == MIRAccess.Write || (parameter.access == MIRAccess.Read && jet_rust_emit_type_is_borrowed(parameter.ty)))
                    return mask
                }
            }
        }
.TraitMethod(_, _, _) -> {
            mask := [Bool]{}
            loop arg in args -> &mask.push(arg.access == MIRAccess.Write || (arg.access == MIRAccess.Read && jet_rust_emit_type_is_borrowed(jet_rust_emit_value_type(function, arg.value))))
            return mask
        }
        .Indirect(value) -> return jet_rust_emit_indirect_borrow_mask(function, value)
        .Foreign(id) -> {
            mask := [Bool]{}
            loop row in ctx.program.foreign {
                if row.id == id {
                    loop parameter in row.params -> &mask.push(parameter.access == MIRAccess.Write || (parameter.access == MIRAccess.Read && jet_rust_emit_type_is_borrowed(parameter.ty)))
                    return mask
                }
            }
        }
        .Core(id) -> {
            loop row in ctx.program.core_calls {
                if row.id == id -> return row.borrow_mask
            }
        }
        .Prelude(id) -> {
            loop row in ctx.program.prelude_calls {
                if row.id == id -> return row.signature.borrow_mask
            }
        }
        else -> {}
    }
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR function call target is missing", "checked direct calls must resolve to one canonical parameter ABI", Val(function.span))
    [Bool]{}
}

fn jet_rust_emit_return_fallibility(ty: MIRType) -> MIRCallFallibility Never! {
    if ty.kind == {
        .Result(success, error) -> return MIRCallFallibility.Failure{failure: MIRFailureCarrier.Result{success: success, error: error}}
        .Option(value) -> return MIRCallFallibility.Failure{failure: MIRFailureCarrier.Optional{value: value}}
        else -> return MIRCallFallibility.Infallible
    }
}

fn jet_rust_emit_indirect_failure(function: MIRFunction, value: MIRValueID) -> MIRCallFallibility Never! {
    ty :: jet_rust_emit_value_type(function, value)
    if ty.kind == {
        .Fn(signature) -> {
            if signature.ret == .Val(ret_ty) -> return jet_rust_emit_return_fallibility(ret_ty)
        }
        .SendFn(_, ret, _) -> {
            if ret == .Val(ret_ty) -> return jet_rust_emit_return_fallibility(ret_ty)
        }
        else -> {}

    }
    MIRCallFallibility.Infallible
}

fn jet_rust_emit_c_abi_encode(ctx: &JetRustEmitContext, source: String, ty: MIRType, borrowed: Bool, visited: &[MIRTypeID]) -> String? {
    if ty.kind == {
        .Int -> {
            input :: if borrowed -> source else -> "&({source})"
            return Val("{ctx.config.root_prefix}jet_std::jet_int_owned_to_i64({input}).unwrap_or_else(|_| panic!(\"C ABI Int does not fit i64\"))")
        }
        .Float | .Float32 | .Bool | .IntN(_, _) -> return Val(if borrowed -> "*({source})" else -> source)
        .Char -> return Val("u32::from({if borrowed -> "*({source})" else -> source})")
        .String -> {
            bytes :: if borrowed -> "({source}).as_bytes()" else -> "({source}).into_bytes()"
            return Val("{{ __jet_c_strings.push(std::ffi::CString::new({bytes}).expect(\"C ABI string contains an interior NUL\")); __jet_c_strings.last().expect(\"C ABI string retention\").as_ptr() }}")
        }
        .InlineRange(base, _, _) | .Quantity(base, _) -> return jet_rust_emit_c_abi_encode(&ctx, source, base, borrowed, &visited)
        .Tagged(marker, inner) -> {
            if marker == (MIRTagMarker.Internal{internal_tag: MIRInternalTag.AllocatorView}) -> return None
            return jet_rust_emit_c_abi_encode(&ctx, source, inner, borrowed, &visited)
        }
        .FixedList(element, length) -> {
            count :: mir_measure_literal_value(length) ?? return None
            if count < 0 -> return None
            array_name :: "__jet_c_array_{visited.len()}_{count}"
            values := [String]{}
            index := 0
            loop index < count {
                value := jet_rust_emit_c_abi_encode(&ctx, "&({array_name}[{index}])", element, true, &visited)
                if value == None -> return None
                &values.push(value ?? "")
                index += 1
            }
            return Val("{{ let {array_name} = {source}; [{values.join(", ")}] }}")
        }
        .Apply(name, args) -> {
            if name.name == "Unit" && args.len() == 0 -> return Val("()")
            if name.name == "Ptr" && args.len() == 1 -> return Val(if borrowed -> "*({source})" else -> source)
            definition := jet_rust_emit_c_abi_record_definition(&ctx, ty)
            if definition == None -> definition = jet_rust_emit_c_abi_enum_definition(&ctx, ty)
            if definition == None -> return None
            row :: definition ?? return None
            if visited.contains(row.id) -> return None
            &visited.push(row.id)
            semantic_type :: jet_rust_emit_type(&ctx, ty)
            if row.kind == {
                .Struct(fields, _) -> {
                    rendered := [String]{}
                    valid := true
                    loop field in fields {
                        if field.computed -> next
                        field_name := jet_rust_emit_field_name(&ctx, field.id)
                        value := jet_rust_emit_c_abi_encode(&ctx, "({source}).{field_name}", field.ty, borrowed, &visited)
                        if value == None {
                            valid = false
                            break
                        }
                        &rendered.push("{field_name}: {value ?? ""}")
                    }
                    _ := &visited.pop()
                    if !valid -> return None
                    abi_type := jet_rust_emit_c_abi_nominal_name(row, "record")
                    return Val("{abi_type} {{ {rendered.join(", ")} }}")
                }
                .Enum(variants, _) -> {
                    layout_tag :: row.c_layout_tag ?? {
                        _ := &visited.pop()
                        return None
                    }
                    tag_type :: jet_rust_emit_c_abi_tag_type(layout_tag)
                    abi_type := if jet_rust_emit_c_abi_unit_enum(variants) -> tag_type else -> jet_rust_emit_c_abi_nominal_name(row, "enum")
                    arms := [String]{}
                    variant_index := 0
                    loop variant in variants {
                        variant_name :: jet_rust_emit_variant_name(&ctx, row.id, variant.name)
                        discriminant :: jet_rust_emit_c_abi_discriminant(variants, variant_index) ?? {
                            _ := &visited.pop()
                            return None
                        }
                        if {
                            jet_rust_emit_c_abi_unit_enum(variants) -> {
                            &arms.push("{semantic_type}::{variant_name} => {discriminant} as {tag_type}")
                            }
                            else -> {
                            if variant.payload == {
                                .Unit -> {
                                    physical := "{abi_type} {{ tag: {discriminant} as {tag_type}, payload: {abi_type}_payload {{ __jet_empty: () }} }}"
                                    &arms.push("{semantic_type}::{variant_name} => {physical}")
                                }
                                .Single(value_ty) -> {
                                    binding := "__jet_c_variant_{variant_index}"
                                    encoded := jet_rust_emit_c_abi_encode(&ctx, binding, value_ty, borrowed, &visited)
                                    if encoded == None {
                                        _ := &visited.pop()
                                        return None
                                    }
                                    field_name := jet_rust_emit_c_abi_payload_field_name(variant)
                                    physical := "{abi_type} {{ tag: {discriminant} as {tag_type}, payload: {abi_type}_payload {{ {field_name}: {encoded ?? ""} }} }}"
                                    &arms.push("{semantic_type}::{variant_name}({binding}) => {physical}")
                                }
                                .Named(fields) -> {
                                    pattern_fields := [String]{}
                                    payload_fields := [String]{}
                                    valid := true
                                    loop field in fields {
                                        if field.computed -> next
                                        field_name := jet_rust_emit_field_name(&ctx, field.id)
                                        binding := "__jet_c_field_{field.id.value}"
                                        &pattern_fields.push("{field_name}: {binding}")
                                        encoded := jet_rust_emit_c_abi_encode(&ctx, binding, field.ty, borrowed, &visited)
                                        if encoded == None {
                                            valid = false
                                            break
                                        }
                                        &payload_fields.push("{field_name}: {encoded ?? ""}")
                                    }
                                    if !valid {
                                        _ := &visited.pop()
                                        return None
                                    }
                                    pattern :: if pattern_fields.len() == 0 -> "{semantic_type}::{variant_name} {{ .. }}" else -> "{semantic_type}::{variant_name} {{ {pattern_fields.join(", ")}, .. }}"
                                    payload_name :: jet_rust_emit_c_abi_payload_type_name(row, variant)
                                    union_field :: jet_rust_emit_c_abi_payload_field_name(variant)
                                    physical := "{abi_type} {{ tag: {discriminant} as {tag_type}, payload: {abi_type}_payload {{ {union_field}: {payload_name} {{ {payload_fields.join(", ")} }} }} }}"
                                    &arms.push("{pattern} => {physical}")
                                }
                            }
                        }
                        }
                        variant_index += 1
                    }
                    _ := &visited.pop()
                    if jet_rust_emit_c_abi_unit_enum(variants) -> return Val("match {source} {{ {arms.join(", ")} }}")
                    return Val("match {source} {{ {arms.join(", ")} }}")
                }
                else -> {
                    _ := &visited.pop()
                    return None
                }
            }
        }
        else -> return None
    }
}

fn jet_rust_emit_c_abi_decode(ctx: &JetRustEmitContext, source: String, ty: MIRType, visited: &[MIRTypeID]) -> String? {
    if ty.kind == {
        .Int -> return Val("jet_foundation::Numeric::JetInt::from_i64({source})")
        .Float | .Float32 | .Bool | .IntN(_, _) -> return Val(source)
        .Char -> return Val("char::from_u32({source}).expect(\"C ABI returned an invalid Unicode scalar\")")
        .String -> {
            local :: "__jet_c_string_{visited.len()}"
            return Val("{{ let {local} = {source}; if {local}.is_null() {{ panic!(\"C ABI returned a null string\") }} unsafe {{ core::ffi::CStr::from_ptr({local}).to_str().expect(\"C ABI returned non-UTF-8 string\").to_owned() }} }}")
        }
        .InlineRange(base, _, _) | .Quantity(base, _) -> return jet_rust_emit_c_abi_decode(&ctx, source, base, &visited)
        .Tagged(marker, inner) -> {
            if marker == (MIRTagMarker.Internal{internal_tag: MIRInternalTag.AllocatorView}) -> return None
            return jet_rust_emit_c_abi_decode(&ctx, source, inner, &visited)
        }
        .FixedList(element, length) -> {
            count :: mir_measure_literal_value(length) ?? return None
            if count < 0 -> return None
            array_name :: "__jet_c_array_{visited.len()}_{count}"
            values := [String]{}
            index := 0
            loop index < count {
                value := jet_rust_emit_c_abi_decode(&ctx, "{array_name}[{index}]", element, &visited)
                if value == None -> return None
                &values.push(value ?? "")
                index += 1
            }
            return Val("{{ let {array_name} = {source}; [{values.join(", ")}] }}")
        }
        .Apply(name, args) -> {
            if name.name == "Unit" && args.len() == 0 -> return Val("()")
            if name.name == "Ptr" && args.len() == 1 -> return Val(source)
            definition := jet_rust_emit_c_abi_record_definition(&ctx, ty)
            if definition == None -> definition = jet_rust_emit_c_abi_enum_definition(&ctx, ty)
            if definition == None -> return None
            row :: definition ?? return None
            if visited.contains(row.id) -> return None
            &visited.push(row.id)
            semantic_type :: jet_rust_emit_type(&ctx, ty)
            if row.kind == {
                .Struct(fields, _) -> {
                    rendered := [String]{}
                    valid := true
                    loop field in fields {
                        if field.computed -> next
                        field_name := jet_rust_emit_field_name(&ctx, field.id)
                        value := jet_rust_emit_c_abi_decode(&ctx, "({source}).{field_name}", field.ty, &visited)
                        if value == None {
                            valid = false
                            break
                        }
                        &rendered.push("{field_name}: {value ?? ""}")
                    }
                    _ := &visited.pop()
                    if !valid -> return None
                    return Val("{semantic_type} {{ {rendered.join(", ")} }}")
                }
                .Enum(variants, _) -> {
                    layout_tag :: row.c_layout_tag ?? {
                        _ := &visited.pop()
                        return None
                    }
                    tag_type :: jet_rust_emit_c_abi_tag_type(layout_tag)
                    arms := [String]{}
                    variant_index := 0
                    loop variant in variants {
                        variant_name :: jet_rust_emit_variant_name(&ctx, row.id, variant.name)
                        discriminant :: jet_rust_emit_c_abi_discriminant(variants, variant_index) ?? {
                            _ := &visited.pop()
                            return None
                        }
                        if {
                            jet_rust_emit_c_abi_unit_enum(variants) -> {
                            &arms.push("{discriminant} => {semantic_type}::{variant_name}")
                            }
                            else -> {
                            match_arm :: if variant.payload == {
                                .Unit -> "{discriminant} => {semantic_type}::{variant_name}"
                                .Single(value_ty) -> {
                                    payload_name := "__jet_c_payload_{variant_index}"
                                    union_field := jet_rust_emit_c_abi_payload_field_name(variant)
                                    decoded :: jet_rust_emit_c_abi_decode(&ctx, payload_name, value_ty, &visited) ?? {
                                        _ := &visited.pop()
                                        return None
                                    }
                                    "{discriminant} => {{ let {payload_name} = unsafe {{ ({source}).payload.{union_field} }}; {semantic_type}::{variant_name}({decoded}) }}"
                                }
                                .Named(fields) -> {
                                    payload_name := "__jet_c_payload_{variant_index}"
                                    union_field := jet_rust_emit_c_abi_payload_field_name(variant)
                                    payload_values := [String]{}
                                    valid := true
                                    loop field in fields {
                                        if field.computed -> next
                                        field_name := jet_rust_emit_field_name(&ctx, field.id)
                                        decoded := jet_rust_emit_c_abi_decode(&ctx, "({payload_name}).{field_name}", field.ty, &visited)
                                        if decoded == None {
                                            valid = false
                                            break
                                        }
                                        &payload_values.push("{field_name}: {decoded ?? ""}")
                                    }
                                    if !valid {
                                        _ := &visited.pop()
                                        return None
                                    }
                                    "{discriminant} => {{ let {payload_name} = unsafe {{ ({source}).payload.{union_field} }}; {semantic_type}::{variant_name} {{ {payload_values.join(", ")} }} }}"
                                }
                            }
                            &arms.push(match_arm)
                        }
                        }
                        variant_index += 1
                    }
                    _ := &visited.pop()
                    if jet_rust_emit_c_abi_unit_enum(variants) -> return Val("match {source} {{ {arms.join(", ")}, _ => panic!(\"unknown C enum discriminant\") }}")
                    return Val("match ({source}).tag {{ {arms.join(", ")}, _ => panic!(\"unknown C enum discriminant\") }}")
                }
                else -> {
                    _ := &visited.pop()
                    return None
                }
            }
        }
        else -> return None
    }
}

fn jet_rust_emit_foreign_argument(ctx: &JetRustEmitContext, function: MIRFunction, foreign: MIRForeign, arg: MIRCallArg, parameter: MIRParam) -> String Never! {
    if foreign.handle != None {
        loop handle in ctx.program.handles {
            if jet_rust_emit_same_handle_type(handle.ty, parameter.ty) {
                if arg.access == MIRAccess.Move -> return "({jet_rust_emit_value_move(arg.value)}).into_raw()"
                raw :: if {
                    arg.place != None -> {
                    selected := jet_rust_emit_place_reference(&ctx, function, arg.place ?? MIRPlaceID{value: 0}, arg.access)
                    selected
                    }
                    else -> {
                    selected := jet_rust_emit_value_reference(arg.value, arg.access == MIRAccess.Write)
                    selected
                    }
                }
                return "({raw}).as_raw()"
            }
        }
    }
    borrowed :: arg.access == MIRAccess.Read && !mir_type_is_scalar(parameter.ty)
    jet_rust_emit_call_arg_with_borrow(&ctx, function, arg, borrowed)
}

fn jet_rust_emit_callback_handler(ctx: &JetRustEmitContext, function: MIRFunction, callback_id: MIRCallbackID, lambda: MIRValueID) -> String Never! {
    callback := MIRCallbackAdapter?{None}
    loop row in ctx.program.callbacks {
        if row.id == callback_id -> callback = Val(row)
    }
    if callback == None {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR callback adapter row is missing", "managed callback calls must resolve their checked callback adapter identity", Val(function.span))
        return "unreachable!(\"missing callback adapter\")"
    }
    callback_row :: callback ?? return "unreachable!(\"missing callback adapter\")"
    lambda_function := MIRFunctionID?{None}
    captures := [MIRCaptureOperand]{}
    loop block in function.blocks {
        loop instruction in block.instructions {
            if instruction.result == (Val(lambda)) {
                if instruction.operation == {
                    .Closure(target, operands, _) -> {
                        lambda_function = Val(target)
                        captures = operands
                    }
                    else -> {}
                }
            }
        }
    }
    if lambda_function == None {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR callback lambda has no closure producer", "checked callback registration requires a Closure operation for its lambda value", Val(function.span))
        return "unreachable!(\"missing callback lambda\")"
    }
    target_id :: lambda_function ?? callback_row.function
    if target_id != callback_row.function {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR callback lambda target disagrees with its adapter", "callback adapters must invoke the checked function identity carried by their closure row", Val(function.span))
        return "unreachable!(\"callback target mismatch\")"
    }
    target := MIRFunction?{None}
    loop candidate in ctx.program.functions { if candidate.id == target_id -> target = Val(candidate) }
    if target == None {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR callback target function is missing", "callback adapters must resolve their checked target function before source emission", Val(function.span))
        return "unreachable!(\"missing callback target\")"
    }
    target_function :: target ?? return "unreachable!(\"missing callback target\")"
    if target_function.form == {
        .TopLevel -> {}
        else -> {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR callback target is not top-level", "callback adapters must invoke a checked top-level function ABI", Val(function.span))
            return "unreachable!(\"callback target form\")"
        }
    }
    if callback_row.params.len() != target_function.params.len() {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR callback parameter arity is invalid", "callback adapter parameters must match the checked target function ABI", Val(function.span))
        return "unreachable!(\"callback parameter arity\")"
    }
    index := 0
    loop target_parameter in target_function.params {
        callback_parameter := callback_row.params[index]
        if callback_parameter.access != target_parameter.access || !mir_type_same_checked_type(callback_parameter.ty, target_parameter.ty) {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR callback parameter ABI disagrees with its target", "callback adapters must preserve checked parameter access and type facts", Val(function.span))
            return "unreachable!(\"callback parameter ABI\")"
        }
        index += 1
    }
    if !callback_row.managed {
        if target_function.capture_params.len() > 0 {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "unmanaged MIR callback target has captures", "unmanaged callback adapters cannot carry closure capture state across the foreign ABI", Val(function.span))
            return "unreachable!(\"unmanaged callback captures\")"
        }
        return callback_row.symbol
    }

    if captures.len() != target_function.capture_params.len() {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "managed callback capture arity is invalid", "managed callback closures must preserve the checked capture ABI", Val(function.span))
        return "unreachable!(\"callback capture arity\")"
    }
    setup := ""
    call_args := [String]{}
    index = 0
    loop operand in captures {
        capture := target_function.capture_params[index]
        captured :: if operand == {
            .Place(place) -> jet_rust_emit_place_reference(&ctx, function, place, MIRAccess.Read)
            .Value(_) -> {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidOwnership, "E0003", "managed callback capture is not a place", "managed callback captures must preserve read-place ownership facts", Val(function.span))
                return "unreachable!(\"callback capture ownership\")"
            }
        }
        name :: jet_rust_emit_capture_name(capture.slot)
        setup = "{setup}let {name} = ({captured}).clone(); "
        &call_args.push("&{name}")
        index += 1
    }
    if target_function.params.len() == 0 {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "managed callback target has no event parameter", "managed callback targets must accept the checked event carrier", Val(function.span))
        return "unreachable!(\"callback event parameter\")"
    }
    event_name :: "__jet_callback_event_value"
    event_arg :: if jet_rust_emit_type_is_borrowed(target_function.params[0].ty) -> "&{event_name}" else -> event_name
    &call_args.push(event_arg)
    invocation := "{jet_rust_emit_function_name(&ctx, target_id)}({call_args.join(", ")})"
    if target_function.is_unsafe -> invocation = "unsafe {{ {invocation} }}"
    "{{ {setup}std::sync::Arc::new(move |__jet_callback_event| {{ let {event_name} = {ctx.config.root_prefix}jet_std::JetFfiCallbackEventValue::new((*__jet_callback_event.value()).clone()); {invocation}; Ok(()) }}) }}"
}

fn jet_rust_emit_managed_foreign_call(ctx: &JetRustEmitContext, function: MIRFunction, foreign: MIRForeign, args: [MIRCallArg]) -> String? {
    transport :: foreign.callback_transport ?? ""
    if transport == "managed-close" {
        if args.len() != 1 || args[0].access != MIRAccess.Move {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "managed callback unsubscribe ABI is invalid", "managed callback unsubscribe must consume exactly one registration handle", Val(foreign.span))
            return Val("unreachable!(\"managed callback unsubscribe ABI\")")
        }
        registration :: jet_rust_emit_value_move(args[0].value)
        return Val("{ctx.config.root_prefix}jet_std::jet_ffi_callback_registration_unsubscribe_result(({registration}).into_raw())")
    }
    if transport == "emit-task" {
        if args.len() != 1 || foreign.params.len() != 1 {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "managed callback emission ABI is invalid", "managed callback emission must receive exactly one payload", Val(foreign.span))
            return Val("unreachable!(\"managed callback emission ABI\")")
        }
        native := MIRForeign?{None}
        loop candidate in ctx.program.foreign {
            if candidate.module_id == foreign.module_id && candidate.name == "__jet_native_emit_async" -> native = Val(candidate)
        }
        if native == None {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "managed callback emission native function is missing", "managed callback emission must retain its checked native async adapter", Val(foreign.span))
            return Val("unreachable!(\"managed callback emission adapter\")")
        }
        native_row :: native ?? return "unreachable!(\"managed callback emission adapter\")"
        if native_row.foreign_language == MIRForeignLanguage.C && native_row.callback_transport == None {
            call :: jet_rust_emit_c_foreign_call(&ctx, function, native_row, args)
            return Val("{ctx.config.root_prefix}jet_std::JetTask::spawn(move || Ok({call}))")
        }
        value :: jet_rust_emit_foreign_argument(&ctx, function, foreign, args[0], foreign.params[0])
        return Val("{ctx.config.root_prefix}jet_std::JetTask::spawn(move || Ok(unsafe {{ {jet_rust_emit_foreign_name(&ctx, native_row.id)}({value}) }}))")
    }
    if transport == "managed" {
        if args.len() != 1 || foreign.params.len() != 1 {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "managed callback registration ABI is invalid", "managed callback registration must receive exactly one callback value", Val(foreign.span))
            return Val("unreachable!(\"managed callback registration ABI\")")
        }
        callback_id := MIRCallbackID?{None}
        lambda := MIRValueID?{None}
        expected_result :: Val(args[0].value)
        loop block in function.blocks {
            loop instruction in block.instructions {
                if instruction.result == expected_result {
                    if instruction.operation == {
                        .Semantic(semantic) -> {
                            if semantic == {
                                .CCallback(_, adapter, callback_lambda) -> {
                                    callback_id = Val(adapter)
                                    lambda = Val(callback_lambda)
                                }
                                else -> {}
                            }
                        }
                        else -> {}
                    }
                }
            }
        }
        if callback_id == None || lambda == None {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "managed callback argument lacks a C callback adapter", "managed callback registration must consume the checked CCallback operation result", Val(foreign.span))
            return Val("unreachable!(\"managed callback adapter operation\")")
        }
        callback_row := MIRCallbackAdapter?{None}
        loop row in ctx.program.callbacks {
            if row.id == (callback_id ?? MIRCallbackID{value: 0}) -> callback_row = Val(row)
        }
        if callback_row == None {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "managed callback adapter row is missing", "managed callback registration must resolve its checked callback adapter", Val(foreign.span))
            return Val("unreachable!(\"managed callback adapter row\")")
        }
        native_start := MIRForeign?{None}
        native_stop := MIRForeign?{None}
        loop candidate in ctx.program.foreign {
            candidate_transport := candidate.callback_transport ?? ""
            if candidate.module_id == foreign.module_id && candidate.name == "__jet_native_{foreign.name}" && candidate_transport == "native-start" -> native_start = Val(candidate)
            if candidate.module_id == foreign.module_id && candidate.name == "__jet_native_unsubscribe" -> native_stop = Val(candidate)
        }
        if native_start == None || native_stop == None {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "managed callback native lifecycle is incomplete", "managed callback registration must retain checked native start and stop adapters", Val(foreign.span))
            return Val("unreachable!(\"managed callback native lifecycle\")")
        }
        identity :: foreign.callback_identity ?? ""
        digest :: foreign.callback_plan_digest ?? ""
        if identity == "" || digest == "" {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "managed callback identity facts are incomplete", "managed callback registration must preserve its checked identity and plan digest", Val(foreign.span))
            return Val("unreachable!(\"managed callback identity\")")
        }
        handler :: jet_rust_emit_callback_handler(&ctx, function, callback_id ?? MIRCallbackID{value: 0}, lambda ?? MIRValueID{value: 0})
        callback :: callback_row ?? return "unreachable!(\"managed callback adapter row\")"
        start :: native_start ?? return "unreachable!(\"managed callback native start\")"
        stop :: native_stop ?? return "unreachable!(\"managed callback native stop\")"
        return Val("{ctx.config.root_prefix}jet_std::JetFfiCallbackRegistrationHandle::from_raw({ctx.config.root_prefix}jet_std::jet_ffi_callback_registration_start_i64(Some({callback.symbol} as unsafe extern \"C\" fn(*mut core::ffi::c_void, i64)), |__jet_callback, __jet_context| unsafe {{ {jet_rust_emit_foreign_name(&ctx, start.id)}(__jet_callback, __jet_context) }}, |__jet_context| unsafe {{ {jet_rust_emit_foreign_name(&ctx, stop.id)}(__jet_context) }}, |_| {{}}, {handler}, {jet_rust_emit_quote(identity)}, {jet_rust_emit_quote(digest)}))")
    }
    None
}

fn jet_rust_emit_foreign_arguments(ctx: &JetRustEmitContext, function: MIRFunction, id: MIRForeignID, args: [MIRCallArg]) -> String Never! {
    loop foreign in ctx.program.foreign {
        if foreign.id == id {
            if args.len() != foreign.params.len() {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR foreign call arity does not match its declaration", "foreign ABI calls must retain one checked parameter row per argument", Val(foreign.span))
                return ""
            }
            rendered := [String]{}
            index := 0
            loop arg in args {
                parameter := foreign.params[index]
                if arg.access != parameter.access {
                    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR foreign call access does not match its declaration", "foreign ABI arguments must preserve checked read/write/move ownership", Val(arg.span))
                    return ""
                }
                &rendered.push(jet_rust_emit_foreign_argument(&ctx, function, foreign, arg, parameter))
                index += 1
            }
            return rendered.join(", ")
        }
    }
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR foreign call declaration is missing", "checked foreign calls must resolve to one canonical ABI row", Val(function.span))
    ""
}

fn jet_rust_emit_c_foreign_call(ctx: &JetRustEmitContext, function: MIRFunction, foreign: MIRForeign, args: [MIRCallArg]) -> String Never! {
    if args.len() != foreign.params.len() {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "C foreign call arity does not match its declaration", "C ABI arguments must retain one checked parameter row per call operand", Val(foreign.span))
        return "unreachable!(\"C foreign call arity\")"
    }
    body := [String]{"let mut __jet_c_strings: Vec<std::ffi::CString> = Vec::new();"}
    rendered_args := [String]{}
    writebacks := [String]{}
    index := 0
    loop arg in args {
        parameter := foreign.params[index]
        if arg.access != parameter.access {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "C foreign call access does not match its declaration", "C ABI arguments must preserve checked read/write/move ownership", Val(arg.span))
            return "unreachable!(\"C foreign call access\")"
        }
        if jet_rust_emit_foreign_handle_type(&ctx, foreign, parameter.ty) {
            &rendered_args.push(jet_rust_emit_foreign_argument(&ctx, function, foreign, arg, parameter))
            index += 1
            next
        }
        visited := [MIRTypeID]{}
        if !jet_rust_emit_c_abi_type_supported(&ctx, parameter.ty, &visited) {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.UnsupportedForeign, "E0003", "C parameter has no checked physical ABI representation", "direct C parameters require C-safe scalars, fixed arrays, repr(C) records, or tagged C enums", Val(arg.span))
            return "unreachable!(\"unsupported C parameter\")"
        }
        if {
            arg.access == MIRAccess.Write -> {
            if arg.place == None {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidOwnership, "E0003", "C write argument has no checked place", "write-access C arguments require a stable MIR place for post-call writeback", Val(arg.span))
                return "unreachable!(\"C write argument place\")"
            }
            place_id :: arg.place ?? MIRPlaceID{value: 0}
            place_name :: "__jet_c_place_{index}"
            &body.push("let {place_name} = {jet_rust_emit_place_reference(&ctx, function, place_id, MIRAccess.Write)};")
            encoded := jet_rust_emit_c_abi_encode(&ctx, "&*{place_name}", parameter.ty, true, [MIRTypeID]{})
            if encoded == None {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.UnsupportedForeign, "E0003", "C write argument cannot be encoded", "the checked write-place type must have a complete C physical representation", Val(arg.span))
                return "unreachable!(\"C write argument encoding\")"
            }
            arg_name :: "__jet_c_arg_{index}"
            &body.push("let mut {arg_name} = {encoded ?? ""};")
            &rendered_args.push("&mut {arg_name}")
            decoded := jet_rust_emit_c_abi_decode(&ctx, arg_name, parameter.ty, [MIRTypeID]{})
            if decoded == None {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.UnsupportedForeign, "E0003", "C write argument cannot be decoded", "C writeback requires a checked reverse conversion for the parameter type", Val(arg.span))
                return "unreachable!(\"C write argument decoding\")"
            }
            &writebacks.push("*{place_name} = {decoded ?? ""};")
            }
            else -> {
            source :: if {
                arg.access == MIRAccess.Move -> {
                if arg.place != None -> jet_rust_emit_place_move(&ctx, function, arg.place ?? MIRPlaceID{value: 0}) else -> jet_rust_emit_value_move(arg.value)
                }
                else -> {
                if arg.place != None -> jet_rust_emit_place_reference(&ctx, function, arg.place ?? MIRPlaceID{value: 0}, MIRAccess.Read) else -> jet_rust_emit_value_reference(arg.value, false)
                }
            }
            encoded := jet_rust_emit_c_abi_encode(&ctx, source, parameter.ty, arg.access == MIRAccess.Read, [MIRTypeID]{})
            if encoded == None {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.UnsupportedForeign, "E0003", "C argument cannot be encoded", "the checked argument type must have a complete C physical representation", Val(arg.span))
                return "unreachable!(\"C argument encoding\")"
            }
            &rendered_args.push(encoded ?? "")
        }
        }
        index += 1
    }
    call :: "unsafe {{ {jet_rust_emit_foreign_name(&ctx, foreign.id)}({rendered_args.join(", ")}) }}"
    result := "()"
    if foreign.return_type == {
        .Val(return_type) -> {
        &body.push("let __jet_c_return = {call};")
        if {
            jet_rust_emit_foreign_handle_type(&ctx, foreign, return_type) -> {
            handle_return := MIRHandleLifecycle?{None}
            loop handle in ctx.program.handles {
                if jet_rust_emit_same_handle_type(handle.ty, return_type) -> handle_return = Val(handle)
            }
            if handle_return == None {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "C foreign handle return has no lifecycle type", "C handle returns must identify the canonical owned handle type", Val(foreign.span))
                return "unreachable!(\"C handle return type\")"
            }
            result = "{jet_rust_emit_type(&ctx, return_type)}::from_raw(__jet_c_return)"
            }
            else -> {
            visited := [MIRTypeID]{}
            if !jet_rust_emit_c_abi_type_supported(&ctx, return_type, &visited) {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.UnsupportedForeign, "E0003", "C return has no checked physical ABI representation", "direct C returns require C-safe scalars, fixed arrays, repr(C) records, or tagged C enums", Val(foreign.span))
                return "unreachable!(\"unsupported C return\")"
            }
            decoded := jet_rust_emit_c_abi_decode(&ctx, "__jet_c_return", return_type, [MIRTypeID]{})
            if decoded == None {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.UnsupportedForeign, "E0003", "C return cannot be decoded", "the checked return type must have a complete reverse C ABI conversion", Val(foreign.span))
                return "unreachable!(\"C return decoding\")"
            }
            result = decoded ?? "()"
        }
        }
        }
        else -> {
        &body.push("{call};")
    }
    }
    loop writeback in writebacks -> &body.push(writeback)
    &body.push(result)
    "{{ {body.join(" ")} }}"
}

fn jet_rust_emit_validate_function_dispatch(ctx: &JetRustEmitContext, id: MIRFunctionID, owner: MIRType, instance: Bool, span: Span) Never! {
    loop candidate in ctx.program.functions {
        if candidate.id == id {
            if candidate.form == {
                .Method(declared_owner, self_access) -> {
                    if !mir_type_same_checked_type(declared_owner, owner) || (instance && self_access == None) || (!instance && self_access != None) {
                        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR method dispatch owner/access disagrees with its callee form", "associated and instance calls must preserve the checked method owner and receiver ABI", Val(span))
                    }
                    return
                }
                .TraitMethod(declared_owner, _, self_access, _) -> {
                    if !mir_type_same_checked_type(declared_owner, owner) || (instance && self_access == None) || (!instance && self_access != None) {
                        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR trait dispatch owner/access disagrees with its callee form", "associated and instance calls must preserve the checked trait owner and receiver ABI", Val(span))
                    }
                    return
                }
                .TopLevel -> {
                    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR associated/method call targets a top-level function", "checked associated dispatch requires a method or trait-method function form", Val(span))
                    return
                }
            }
        }
    }
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR associated/method target is missing", "checked dispatch must resolve its function identity before source emission", Val(span))
}

fn jet_rust_emit_associated_dispatch(ctx: &JetRustEmitContext, id: MIRFunctionID, owner: MIRType, generic: String, rendered_args: String, span: Span) -> String Never! {
    loop candidate in ctx.program.functions {
        if candidate.id == id {
            if candidate.form == {
                .Method(declared_owner, self_access) -> {
                    if self_access != None || !mir_type_same_checked_type(declared_owner, owner) {
                        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR associated dispatch owner/access is invalid", "associated calls must target the checked inherent owner without a receiver", Val(span))
                        return "unreachable!(\"invalid associated dispatch\")"
                    }
                    return "{jet_rust_emit_type(&ctx, owner)}::{jet_rust_emit_sanitize(candidate.name)}{generic}({rendered_args})"
                }
                .TraitMethod(declared_owner, trait_ref, self_access, _) -> {
                    if self_access != None || !mir_type_same_checked_type(declared_owner, owner) {
                        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR trait-associated dispatch owner/access is invalid", "trait-associated calls must target the checked owner without a receiver", Val(span))
                        return "unreachable!(\"invalid trait associated dispatch\")"
                    }
                    return "<{jet_rust_emit_type(&ctx, owner)} as {jet_rust_emit_trait_name(&ctx, trait_ref.id)}>::{jet_rust_emit_sanitize(candidate.name)}{generic}({rendered_args})"
                }
                .TopLevel -> {
                    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR associated dispatch targets a top-level function", "associated calls require a checked method or trait-method function form", Val(span))
                    return "unreachable!(\"invalid associated dispatch\")"
                }
            }
        }
    }
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR associated dispatch target is missing", "associated calls must resolve to one checked function identity", Val(span))
    "unreachable!(\"missing associated dispatch\")"
}

fn jet_rust_emit_method_dispatch(ctx: &JetRustEmitContext, function: MIRFunction, id: MIRFunctionID, owner: MIRType, args: [MIRCallArg], type_args: [MIRType]) -> String Never! {
    loop candidate in ctx.program.functions {
        if candidate.id == id {
            if candidate.form == {
                .Method(declared_owner, self_access) -> {
                    if self_access == None || !mir_type_same_checked_type(declared_owner, owner) {
                        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR method dispatch owner/access is invalid", "instance calls must preserve the checked inherent owner and receiver access", Val(function.span))
                        return "unreachable!(\"invalid method dispatch\")"
                    }
                    if args.len() != candidate.params.len() || args.len() == 0 {
                        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR method dispatch arity is invalid", "instance calls must preserve the checked receiver and parameter ABI", Val(function.span))
                        return "unreachable!(\"method dispatch arity\")"
                    }
                    access :: self_access ?? MIRAccess.Read
                    if args[0].access != access {
                        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR method receiver access is invalid", "instance calls must preserve checked read/write/move receiver ownership", Val(args[0].span))
                        return "unreachable!(\"method receiver access\")"
                    }
                    receiver :: jet_rust_emit_call_arg_with_borrow(&ctx, function, args[0], access == MIRAccess.Read)
                    rendered := [String]{}
                    arg_index := 0
                    loop parameter in candidate.params {
                        if jet_rust_emit_is_receiver(candidate, parameter.index) {
                            arg_index += 1
                            next
                        }
                        if arg_index >= args.len() -> break
                        borrow :: parameter.access == MIRAccess.Write || (parameter.access == MIRAccess.Read && jet_rust_emit_type_is_borrowed(parameter.ty))
                        &rendered.push(jet_rust_emit_call_arg_with_borrow(&ctx, function, args[arg_index], borrow))
                        arg_index += 1
                    }
                    generic :: jet_rust_emit_generic_call_args(&ctx, type_args)
                    return "({receiver}).{jet_rust_emit_sanitize(candidate.name)}{generic}({rendered.join(", ")})"
                }
                .TraitMethod(_, _, _, _) -> {
                    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR method dispatch targets a trait-method function", "instance method calls must use the checked inherent method form", Val(function.span))
                    return "unreachable!(\"trait method in inherent dispatch\")"
                }
                .TopLevel -> {
                    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR method dispatch targets a top-level function", "instance calls require a checked method function form", Val(function.span))
                    return "unreachable!(\"top-level method dispatch\")"
                }
            }
        }
    }
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR method dispatch target is missing", "instance calls must resolve to one checked function identity", Val(function.span))
    "unreachable!(\"missing method dispatch\")"
}

fn jet_rust_emit_trait_method_call_row(ctx: &JetRustEmitContext, function: MIRFunction, trait_ref: MIRTraitRef, receiver: MIRType, method: MIRTraitMethod, args: [MIRCallArg], type_args: [MIRType]) -> String Never! {
    if receiver.kind == {
        .TraitObject(bounds) -> {
            found := false
            loop bound in bounds {
                if bound.id == trait_ref.id {
                    found = true
                    if bound.name != trait_ref.name {
                        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR trait receiver bound name disagrees with its identity", "trait-object dispatch uses the exact checked trait ID; the name is consistency data only", Val(function.span))
                    }
                }
            }
            if !found {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR trait receiver lacks its dispatched trait bound", "trait-object calls must retain the checked trait bound used for vtable dispatch", Val(function.span))
                return "unreachable!(\"trait bound missing\")"
            }
        }
        else -> {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR trait receiver is not a trait object", "trait-method calls require a checked trait-object receiver", Val(function.span))
            return "unreachable!(\"trait receiver is not a trait object\")"
        }
    }
    if method.self_access == None {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR trait method has no receiver", "dynamic trait dispatch requires a checked receiver access", Val(method.span))
        return "unreachable!(\"trait method receiver missing\")"
    }
    if args.len() != method.params.len() + 1 {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR trait call arity does not match its method row", "trait vtable dispatch must preserve the checked receiver plus parameter ABI", Val(function.span))
        return "unreachable!(\"trait call arity\")"
    }
    access :: method.self_access ?? MIRAccess.Read
    if args[0].access != access {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR trait receiver access does not match its method row", "trait vtable dispatch must preserve checked read/write/move receiver ownership", Val(args[0].span))
        return "unreachable!(\"trait receiver access\")"
    }
    if type_args.len() > 0 {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR trait method carries unsupported type arguments", "trait method rows currently have no generic parameter ABI", Val(method.span))
        return "unreachable!(\"trait method type arguments\")"
    }
    receiver_text :: jet_rust_emit_call_arg_with_borrow(&ctx, function, args[0], access == MIRAccess.Read)
    rendered := [String]{}
    index := 0
    loop parameter in method.params {
        &rendered.push(jet_rust_emit_call_arg_with_borrow(&ctx, function, args[index + 1], parameter.access == MIRAccess.Write || (parameter.access == MIRAccess.Read && jet_rust_emit_type_is_borrowed(parameter.ty))))
        index += 1
    }
    "({receiver_text}).{jet_rust_emit_trait_method_symbol(method)}({rendered.join(", ")})"
}

fn jet_rust_emit_trait_method_call(ctx: &JetRustEmitContext, function: MIRFunction, method_id: MIRTraitMethodID, trait_ref: MIRTraitRef, receiver: MIRType, args: [MIRCallArg], type_args: [MIRType]) -> String Never! {
    loop definition in ctx.program.traits {
        if definition.id == trait_ref.id {
            loop method in definition.methods {
                if method.id == method_id -> return jet_rust_emit_trait_method_call_row(&ctx, function, trait_ref, receiver, method, args, type_args)
            }
        }
    }
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR trait method is missing", "trait vtable dispatch requires a checked method row in its trait registry", Val(function.span))
    "unreachable!(\"missing trait method\")"
}

fn jet_rust_emit_foreign_call(ctx: &JetRustEmitContext, function: MIRFunction, id: MIRForeignID, args: [MIRCallArg], type_args: [MIRType]) -> String Never! {
    if type_args.len() > 0 {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR foreign call carries type arguments", "foreign ABI calls are monomorphic at the source boundary", Val(function.span))
        return "unreachable!(\"foreign call type arguments\")"
    }
    loop foreign in ctx.program.foreign {
        if foreign.id == id {
            transport := foreign.callback_transport ?? ""
            if jet_rust_emit_managed_foreign_call(&ctx, function, foreign, args) == .Val(managed) -> return managed
            if foreign.foreign_language == MIRForeignLanguage.C && transport == "" -> return jet_rust_emit_c_foreign_call(&ctx, function, foreign, args)
            rendered :: jet_rust_emit_foreign_arguments(&ctx, function, id, args)
            call :: "unsafe {{ {jet_rust_emit_foreign_name(&ctx, id)}({rendered}) }}"
            if transport == "guest-import-result" -> return "Ok({call})"
            if foreign.return_type != None && foreign.handle != None {
                unit :: MIRTypeKind.Apply{name: mir_nominal_ref("Unit"), args: [MIRType]{}}
                return_type :: foreign.return_type ?? MIRType{kind: unit, identity: None, layout: mir_type_layout(unit)}
                loop handle in ctx.program.handles {
                    if jet_rust_emit_same_handle_type(handle.ty, return_type) -> return "{jet_rust_emit_type(&ctx, return_type)}::from_raw({call})"
                }
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR foreign handle return has no lifecycle type", "foreign handle-return rows must identify the canonical owned handle type", Val(foreign.span))
                return "unreachable!(\"foreign handle return type\")"
            }
            return call
        }
    }
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR foreign call declaration is missing", "checked foreign calls must resolve to one canonical ABI row", Val(function.span))
    "unreachable!(\"missing foreign call\")"
}

fn jet_rust_emit_call_failure(ctx: &JetRustEmitContext, callee: MIRCallee) -> MIRCallFallibility Never! {
    if callee == {
        .User(id) -> return jet_rust_emit_function_failure(&ctx, id)
        .Associated(id, _) -> return jet_rust_emit_function_failure(&ctx, id)
        .Method(id, _) -> return jet_rust_emit_function_failure(&ctx, id)
        .TraitMethod(method, trait_ref, _) -> {
            loop definition in ctx.program.traits {
                if definition.id == trait_ref.id {
                    loop candidate in definition.methods {
                        if candidate.id == method {
                            if candidate.failure == {
                                .Infallible -> return MIRCallFallibility.Infallible
                                .Result(success, error) -> return MIRCallFallibility.Failure{failure: MIRFailureCarrier.Result{success: success, error: error}}
                                .Optional(value) -> return MIRCallFallibility.Failure{failure: MIRFailureCarrier.Optional{value: value}}
                                .Diverges(value) -> return MIRCallFallibility.Failure{failure: MIRFailureCarrier.Diverges{value: value}}
                            }
                        }
                    }
                }
            }
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR trait method is missing from its trait registry", "trait call fallibility must come from the checked trait method row", None)
            return MIRCallFallibility.Infallible
        }
        .Core(id) -> {
            loop row in ctx.program.core_calls { if row.id == id -> return MIRCallFallibility.Infallible }
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR Core call fallibility row is missing", "checked Core calls must retain its canonical failure carrier", None)
            return MIRCallFallibility.Infallible
        }
        .Prelude(id) -> {
            loop row in ctx.program.prelude_calls { if row.id == id -> return row.fallibility }
            return MIRCallFallibility.Infallible
        }
        .Foreign(_) -> return MIRCallFallibility.Infallible
        .Indirect(_) -> return MIRCallFallibility.Infallible
    }
}

fn jet_rust_emit_call(ctx: &JetRustEmitContext, function: MIRFunction, callee: MIRCallee, args: [MIRCallArg], type_args: [MIRType], result: MIRValueID?) -> String Never! {
    mask := jet_rust_emit_call_borrow_mask(&ctx, callee, function, args)
    rendered_args :: if callee == {
        .Core(id) -> {
            loop row in ctx.program.core_calls {
                if row.id == id {
                    if args.len() < row.arity || args.len() > row.max_arity || row.borrow_mask.len() < row.arity {
                        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR Core call arity does not match its checked ABI", "the checked Core route and operation payload must agree exactly", Val(function.span))
                    }
                    mask = row.borrow_mask
                }
            }
            source := jet_rust_emit_core_symbol(&ctx, id)
            target := jet_rust_emit_exact_adapter(&ctx, Val(function), source, args)
            mask = jet_rust_emit_exact_adapter_mask(args, source, mask, target)
            jet_rust_emit_call_arguments(&ctx, function, args, mask)
        }
        .Prelude(id) -> {
            loop row in ctx.program.prelude_calls {
                if row.id == id {
                    if args.len() < row.signature.arity || args.len() > row.signature.max_arity || row.signature.borrow_mask.len() != args.len() {
                        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR Prelude call arity does not match its checked ABI", "the checked Prelude route and operation payload must agree exactly", Val(function.span))
                    }
                    mask = row.signature.borrow_mask
                }
            }
            jet_rust_emit_call_arguments(&ctx, function, args, mask)
        }
        .Foreign(id) -> jet_rust_emit_foreign_arguments(&ctx, function, id, args)
        else -> jet_rust_emit_call_arguments(&ctx, function, args, mask)
    }
    generic :: jet_rust_emit_generic_call_args(&ctx, type_args)
    call := if callee == {
        .User(id) -> "{jet_rust_emit_function_name(&ctx, id)}{generic}({rendered_args})"
        .Associated(id, owner) -> {
            jet_rust_emit_validate_function_dispatch(&ctx, id, owner, false, function.span)
            jet_rust_emit_associated_dispatch(&ctx, id, owner, generic, rendered_args, function.span)
        }
        .Method(id, owner) -> jet_rust_emit_method_dispatch(&ctx, function, id, owner, args, type_args)
        .TraitMethod(method, trait_ref, receiver) -> jet_rust_emit_trait_method_call(&ctx, function, method, trait_ref, receiver, args, type_args)
        .Core(id) -> {
            source := jet_rust_emit_core_symbol(&ctx, id)
            target := jet_rust_emit_exact_adapter(&ctx, Val(function), source, args)
            "{target}{generic}({rendered_args})"
        }
        .Prelude(id) -> jet_rust_emit_prelude_call(&ctx, function, id, args, type_args)
        .Foreign(id) -> jet_rust_emit_foreign_call(&ctx, function, id, args, type_args)
        .Indirect(value) -> jet_rust_emit_indirect_call(&ctx, function, value, args, rendered_args)
    }
    if result == .Val(value) {
        result_ty :: jet_rust_emit_value_type(function, value)
        // MIRRust: a Prelude/Core kernel result re-enters the exact Int carrier.
        if callee == {
            .Core(_) | .Prelude(_) -> return jet_rust_emit_native_int_result(&ctx, call, result_ty) ?? call
            else -> {}
        }
        failure := jet_rust_emit_call_failure(&ctx, callee)
        if callee == {
            .Indirect(callable) -> failure = jet_rust_emit_indirect_failure(function, callable)
            else -> {}
        }
        needs_try :: if callee == {
            .Core(_) | .Prelude(_) | .Foreign(_) -> false
            else -> jet_rust_emit_failure_needs_try(failure, result_ty)
        }
        if needs_try && function.failure == MIRFailureCarrier.Infallible {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidControlFlow, "E0003", "fallible MIR call cannot propagate into an infallible function", "checked failure carriers must be represented by the caller signature before Rust source emission", Val(function.span))
        }
        if needs_try -> call = "({call})?"
    }
    call
}

fn jet_rust_emit_core_shape_expression(ctx: &JetRustEmitContext, function: MIRFunction, module_name: String, member: String, route_info: MIRPreludeCall, args: [MIRCallArg], type_args: [MIRType]) -> String? {
    root := ctx.config.root_prefix
    if module_name == "core.db" && member == "decode" {
        if type_args.len() != 1 {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR core.db.decode has the wrong type-argument arity", "checked DB decoding requires exactly one target carrier type", Val(function.span))
            return Val("unreachable!(\"core.db.decode type arguments\")")
        }
        target_type := type_args[0]
        names := jet_rust_emit_shape_name_map(&ctx, target_type, "db", "core.db.decode")
        rendered := jet_rust_emit_call_arguments(&ctx, function, args, route_info.signature.borrow_mask)
        target := jet_rust_emit_type(&ctx, target_type)
        return Val("{{ let __jet_db_entries = {root}jet_std::jet_db_row_project({rendered}, {names}, |value| match value {{ {root}jet_std::DBValue::Null => {root}jet_std::DataTree::Null, {root}jet_std::DBValue::Int(value) => {root}jet_std::DataTree::Int(*value), {root}jet_std::DBValue::Float(value) => {root}jet_std::DataTree::Float(*value), {root}jet_std::DBValue::Text(value) => {root}jet_std::DataTree::Text(value.clone()), {root}jet_std::DBValue::Bool(value) => {root}jet_std::DataTree::Bool(*value), {root}jet_std::DBValue::Blob(value) => {root}jet_std::DataTree::Bytes(value.clone()) }}); {root}jet_db_decode::<{target}>(&__jet_db_entries) }}")
    }
    if module_name == "core.sys" && member == "decode" {
        if type_args.len() != 1 {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR core.sys.decode has the wrong type-argument arity", "checked environment decoding requires exactly one target carrier type", Val(function.span))
            return Val("unreachable!(\"core.sys.decode type arguments\")")
        }
        target_type := type_args[0]
        names := jet_rust_emit_shape_name_map(&ctx, target_type, "env", "core.sys.decode")
        rendered := jet_rust_emit_call_arguments(&ctx, function, args, route_info.signature.borrow_mask)
        target := jet_rust_emit_type(&ctx, target_type)
        return Val("{root}jet_std_env_decode::<{target}>({rendered}, {names})")
    }
    // MIRRust cli_shape_core_call: the target's #CLI shape builds the same spec
    // as the CLI entry, then decodes argv (or merges argv over the layers).
    if module_name == "core.args" && (member == "decode" || member == "merge") {
        if type_args.len() != 1 {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR core.args call has the wrong type-argument arity", "checked argument decoding requires exactly one #CLI target type", Val(function.span))
            return Val("unreachable!(\"core.args type arguments\")")
        }
        target_type := type_args[0]
        cli_entry := MIRCLIEntry?{None}
        loop definition in ctx.program.types {
            if target_type.identity == (Val(definition.id)) -> cli_entry = definition.cli
        }
        cli :: cli_entry ?? {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR core.args target carries no #CLI shape", "checked argument decoding targets a #CLI record declaration", Val(function.span))
            return Val("unreachable!(\"core.args target shape\")")
        }
        program :: "&{root}jet_args_source_program_name(__jet_argv.first().map(String::as_str).unwrap_or(\"\"))"
        spec := jet_rust_emit_cli_spec_expr(&ctx, cli.inputs, cli.description, cli.standard, cli.version, program)
        loop command in cli.commands {
            command_spec :: jet_rust_emit_cli_spec_expr(&ctx, command.inputs, command.description, false, None, program)
            spec = "{root}jet_args_subcommand({spec}, &{jet_rust_emit_quote(command.name)}.to_string(), &{jet_rust_emit_quote(command.description ?? "")}.to_string(), {command_spec})"
        }
        target := jet_rust_emit_type(&ctx, target_type)
        names := jet_rust_emit_shape_name_map(&ctx, target_type, "args", "core.args")
        if member == "decode" -> return Val("{{ let __jet_argv = {root}jet_std_io_args(); let __jet_spec = {spec}; {root}jet_args_decode::<{target}>(&__jet_spec, &__jet_argv, {names}) }}")
        layers := [String]{}
        loop arg in args -> &layers.push(jet_rust_emit_call_arg_with_borrow(&ctx, function, arg, true))
        return Val("{{ let __jet_argv = {root}jet_std_io_args(); let __jet_spec = {spec}; {root}jet_config_merge::<{target}>(&__jet_spec, &__jet_argv, {names}, {layers.join(", ")}) }}")
    }
    // D-JSON3: the typed form shares the one generated Decode engine.
    if module_name == "core.encoding.json" && member == "decode" && type_args.len() > 0 {
        rendered := jet_rust_emit_call_arguments(&ctx, function, args, route_info.signature.borrow_mask)
        return Val("{root}jet_enc_json_decode{jet_rust_emit_generic_call_args(&ctx, type_args)}({rendered})")
    }
    // D-WEBQUERY1: the checked callback carries JetErr; the AOT query kernel
    // takes text failures through this one narrowing seam.
    if module_name == "core.web.query" && member == "live" && args.len() > 0 {
        values := [String]{}
        loop (index, arg) in args {
            borrowed :: index < route_info.signature.borrow_mask.len() && route_info.signature.borrow_mask[index]
            &values.push(jet_rust_emit_call_arg_with_borrow(&ctx, function, arg, borrowed))
        }
        callback :: values[values.len() - 1]
        invocation :: if jet_rust_emit_is_fn_type(jet_rust_emit_value_type(function, args[args.len() - 1].value)) -> jet_rust_emit_fn_value_call(callback, [String]{}) else -> "({callback})()"
        kept := [String]{}
        loop (index, value) in values { if index + 1 < values.len() -> &kept.push(value) }
        &kept.push("move || {invocation}.map_err(|__error| {root}jet_err_message(&__error))")
        return Val("{jet_rust_emit_prelude_symbol(&ctx, route_info.id)}{jet_rust_emit_generic_call_args(&ctx, type_args)}({kept.join(", ")})")
    }
    if module_name == "core.mem" && (member == "volatile_read" || member == "volatile_write") {
        values := [String]{}
        loop (index, arg) in args {
            borrowed :: index < route_info.signature.borrow_mask.len() && route_info.signature.borrow_mask[index]
            &values.push(jet_rust_emit_call_arg_with_borrow(&ctx, function, arg, borrowed))
        }
        if member == "volatile_read" && values.len() >= 1 -> return Val("jet_mem::jet_sentry_volatile_read(({values[0]}), \"valid_ptr\")")
        if member == "volatile_write" && values.len() >= 2 -> return Val("jet_mem::jet_sentry_volatile_write(({values[0]}), {values[1]}, \"valid_ptr\")")
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR volatile access has the wrong arity", "checked volatile reads take a pointer and writes a pointer and value", Val(function.span))
        return Val("unreachable!(\"core.mem volatile arity\")")
    }
    // `cbor.parse(bytes)` omits its options; the Prelude kernel always takes the
    // safe default explicitly.
    if module_name == "core.encoding.cbor" && member == "parse" && args.len() == 1 {
        borrowed :: route_info.signature.borrow_mask.len() == 0 || route_info.signature.borrow_mask[0]
        bytes :: jet_rust_emit_call_arg_with_borrow(&ctx, function, args[0], borrowed)
        return Val("{jet_rust_emit_prelude_symbol(&ctx, route_info.id)}({bytes}, {root}jet_std::CBOROptions::safe())")
    }
    // The core.compute AD calls need MIRRust's tensor tape adapter (compute_call),
    // which the Jet emitter does not carry: fail closed.
    if module_name == "core.compute" && (member == "gradient" || member == "value_and_gradient" || member == "vjp" || member == "jvp") {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.UnsupportedOperation, "E0003", "core.compute differentiation is not supported by the Jet Rust emitter", "the compute AD tape adapter is not part of the Jet emitter", Val(function.span))
        return Val("unreachable!(\"unsupported Core adapter\")")
    }
    None
}

fn jet_rust_emit_core_operation(ctx: &JetRustEmitContext, function: MIRFunction, call: MIRCoreCallID, route: MIRPreludeCallID, args: [MIRCallArg], type_args: [MIRType], fallibility: MIRCallFallibility, data_plan: MIRDataPlan?, result: MIRValueID?) -> String Never! {
    core_found := false
    module_name := ""
    member := ""
    loop row in ctx.program.core_calls {
        if row.id == call {
            core_found = true
            module_name = row.module_name
            member = row.member
            if args.len() < row.arity || args.len() > row.max_arity || row.borrow_mask.len() < row.arity {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR Core call arity does not match its checked ABI", "the checked Core route and operation payload must agree exactly", Val(function.span))
            }
        }
    }
    if !core_found {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR Core call is missing from the canonical Core registry", "checked Core calls must retain their source-owned symbol and ABI row", Val(function.span))
        return "unreachable!(\"missing MIR Core call\")"
    }
    // MIRRust source_math_call: these core.math members are routed through their
    // Jet source function unless the row is an AOT-direct Prelude kernel.
    source_math :: [String]{"checked_abs", "checked_neg", "checked_add", "checked_sub", "checked_mul", "checked_div", "checked_rem", "checked_pow", "saturating_add", "saturating_mul", "int_pow", "sum_int", "prod_int", "abs_diff", "div_mod", "div_rem"}
    aot_direct := false
    loop row in ctx.program.core_calls { if row.id == call -> aot_direct = row.aot_direct }
    if module_name == "core.math" && !aot_direct && source_math.contains(member) {
        loop candidate in ctx.program.functions {
            if candidate.module_name == module_name && candidate.name == member && candidate.form == MIRFunctionForm.TopLevel {
                if candidate.id == function.id || candidate.params.len() != args.len() {
                    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR Core math call does not match its Jet source function", "source-routed core.math calls select another top-level function with the same arity", Val(function.span))
                    return "unreachable!(\"core.math source route\")"
                }
                return jet_rust_emit_call(&ctx, function, MIRCallee.User{function: candidate.id}, args, type_args, result)
            }
        }
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR Core math call has no Jet source function", "source-routed core.math calls require their Core source function in the program", Val(function.span))
        return "unreachable!(\"core.math source function\")"
    }
    route_row := MIRPreludeCall?{None}
    loop row in ctx.program.prelude_calls { if row.id == route -> route_row = Val(row) }
    if route_row == None {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR Core route is missing from the Prelude registry", "Core calls carry a checked Prelude ABI row for argument marshalling", Val(function.span))
        return "unreachable!(\"missing MIR Core route\")"
    }
    route_info :: route_row ?? MIRPreludeCall{id: route, family: MIRPreludeFamily.Host, module_name: "", member: "", symbol: MIRSymbol.Runtime{name: "__jet_missing_route"}, signature: MIRCallSignature{arity: 0, max_arity: 0, borrow_mask: [Bool]{}}, effect_kind: None, fallibility: MIRCallFallibility.Infallible, abi: MIRPreludeABI.Value, authority: None, db_metadata: None}
    if route_info.fallibility != fallibility {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR Core and Prelude route fallibility disagree", "Core operation failure propagation must retain one canonical checked carrier", Val(function.span))
    }
    if route_info.signature.borrow_mask.len() != args.len() {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR Core route borrow metadata does not match its arguments", "Core operation arguments must match the route Prelude signature exactly", Val(function.span))
    }
    source :: jet_rust_emit_core_symbol(&ctx, call)
    target :: jet_rust_emit_exact_adapter(&ctx, Val(function), source, args)
    mask :: jet_rust_emit_exact_adapter_mask(args, source, route_info.signature.borrow_mask, target)
    rendered :: jet_rust_emit_call_arguments(&ctx, function, args, mask)
    generic :: jet_rust_emit_generic_call_args(&ctx, type_args)
    expression := "{target}{generic}({rendered})"
    special := jet_rust_emit_core_shape_expression(&ctx, function, module_name, member, route_info, args, type_args)
    if special == .Val(adapter) {
        expression = adapter
    } else if result == .Val(result_value) {
        // MIRRust core_call: a native-word kernel result re-enters the Jet carrier.
        if jet_rust_emit_native_int_result(&ctx, expression, jet_rust_emit_value_type(function, result_value)) == .Val(widened) -> expression = widened
    }
    if module_name == "core.crypto.vault" && member == "current" -> expression = "({expression}).map(|value| match value {{ Some(value) => Ok(value), None => Err({ctx.config.root_prefix}JetAbsent) }})"
    if fallibility == {
        .Failure(carrier) -> {
            if carrier == {
                .Optional(_) -> expression = "({expression}).ok_or({ctx.config.root_prefix}JetAbsent)"
                else -> {}
            }
        }
        .Infallible -> {}
    }
    if result == .Val(value) {
        if jet_rust_emit_failure_needs_try(fallibility, jet_rust_emit_value_type(function, value)) -> expression = "({expression})?"
    }
    expression
}

fn jet_rust_emit_index_operand(ctx: &JetRustEmitContext, function: MIRFunction, index: MIRValueID, location: MIRPanicLoc) -> String Never! {
    ty := jet_rust_emit_value_type(function, index)
    loop {
        if ty.kind == {
            .InlineRange(base, _, _) -> ty = base
            .Tagged(_, base) -> ty = base
            .Quantity(base, _) -> ty = base
            .Int -> {
                value :: jet_rust_emit_value_reference(index, false)
                return "{ctx.config.root_prefix}jet_std::jet_int_owned_to_i64({value}).unwrap_or_else(|_| {ctx.config.root_prefix}jet_arithmetic_stop({jet_rust_emit_source_path(&ctx, location.file)}, {location.line}u32, \"index exceeds host range\"))"
            }
            else -> return jet_rust_emit_value_read(index)
        }
    }
}

fn jet_rust_emit_columnar_read(ctx: &JetRustEmitContext, function: MIRFunction, base: MIRValueID, index: MIRValueID, column: MIRFieldID, column_index: Int, accessor: MIRPreludeCallID, location: MIRPanicLoc) -> String Never! {
    route := MIRPreludeCall?{None}
    loop candidate in ctx.program.prelude_calls {
        if candidate.id == accessor -> route = Val(candidate)
    }
    if route == None {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR columnar accessor route is missing", "columnar reads must retain their checked gather-cell Prelude route", Val(function.span))
        return "unreachable!(\"missing columnar accessor route\")"
    }
    row :: route ?? return "unreachable!(\"missing columnar accessor route\")"
    valid_mask :: row.signature.borrow_mask.len() == 3 && row.signature.borrow_mask[0] && !row.signature.borrow_mask[1] && !row.signature.borrow_mask[2]
    if row.family != MIRPreludeFamily.ColumnarAccess || row.module_name != "core.columnar" || row.member != "jet_columns_gather_cell" || row.signature.arity != 3 || row.signature.max_arity != 3 || !valid_mask {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR columnar accessor route is not canonical", "columnar reads must use core.columnar.jet_columns_gather_cell with its checked three-argument borrow ABI", Val(function.span))
        return "unreachable!(\"invalid columnar accessor route\")"
    }
    base_text :: jet_rust_emit_value_reference(base, false)
    index_text :: jet_rust_emit_index_operand(&ctx, function, index, location)
    field_name :: jet_rust_emit_field_name(&ctx, column)
    "({base_text}).cell({column_index}usize, {index_text}, {jet_rust_emit_source_path(&ctx, location.file)}, {location.line}u32).jet_col_{field_name}()"
}

// MIRRust is_columnar_list: a `List<T>` whose element is a columnar row.
fn jet_rust_emit_is_columnar_list(ctx: &JetRustEmitContext, ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .List(inner) -> jet_rust_emit_is_columnar_type(&ctx, inner)
        else -> false
    }
}

// MIRRust index_arguments: base, index, file and line, then as many checked
// panic-context values (function, source line, column, caret) as the route's
// arity leaves open.
fn jet_rust_emit_index_arguments(ctx: &JetRustEmitContext, function: MIRFunction, call: MIRPreludeCallID, base: String, index: String, location: MIRPanicLoc, context: MIRPanicContext?) -> [String] Never! {
    args := [String]{base, index, jet_rust_emit_source_path(&ctx, location.file), "{location.line}u32"}
    route :: jet_rust_emit_prelude_row(&ctx, call) ?? return args
    if route.signature.arity < args.len() {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR index route has fewer arguments than its base/index location prefix", "checked index routes take base, index, file and line", Val(function.span))
        return args
    }
    context_values := [String]{}
    if context == .Val(row) {
        context_values = [String]{jet_rust_emit_quote(row.function), jet_rust_emit_quote(row.source_line), "{location.column}u32", "{row.caret}u32"}
    }
    additional :: route.signature.arity - args.len()
    if additional > context_values.len() {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR index route requires more context arguments than MIR supplied", "checked index routes take at most the function, source line, column and caret context", Val(function.span))
        return args
    }
    loop position in 0..<additional -> &args.push(context_values[position])
    args
}

// MIRRust index: columnar reads gather one row; every other index borrows its
// base place and passes the host-word index plus the checked panic context.
fn jet_rust_emit_index(ctx: &JetRustEmitContext, function: MIRFunction, call: MIRPreludeCallID, base: MIRValueID, index: MIRValueID, kind: MIRIndexKind, access: MIRAccess, location: MIRPanicLoc, context: MIRPanicContext) -> String Never! {
    if (kind == MIRIndexKind.List || kind == MIRIndexKind.FixedListProof) && access == MIRAccess.Read && jet_rust_emit_is_columnar_list(&ctx, jet_rust_emit_value_type(function, base)) {
        return "({jet_rust_emit_borrowed_value_reference(&ctx, function, base, MIRAccess.Read)}).gather_at({jet_rust_emit_index_operand(&ctx, function, index, location)}, {jet_rust_emit_source_path(&ctx, location.file)}, {location.line}u32)"
    }
    if access == MIRAccess.Move {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidOwnership, "E0003", "MIR index move has no checked Prelude route", "checked index operations read or write their base place", Val(function.span))
        return "unreachable!(\"MIR index move\")"
    }
    base_text :: jet_rust_emit_borrowed_value_reference(&ctx, function, base, access)
    index_text :: if kind == MIRIndexKind.Map -> "&({jet_rust_emit_value_read(index)})" else -> jet_rust_emit_index_operand(&ctx, function, index, location)
    args :: jet_rust_emit_index_arguments(&ctx, function, call, base_text, index_text, location, Val(context))
    jet_rust_emit_prelude_args_exact(&ctx, function, call, args)
}

// MIRRust slice: the base follows the route borrow mask; explicit bounds cross
// as host words and a range operand is borrowed when the route says so.
fn jet_rust_emit_slice(ctx: &JetRustEmitContext, function: MIRFunction, call: MIRPreludeCallID, base: MIRValueID, start: MIRValueID, end: MIRValueID, range: MIRValueID?, location: MIRPanicLoc) -> String Never! {
    route :: jet_rust_emit_prelude_row(&ctx, call) ?? return "unreachable!(\"missing Prelude route\")"
    mask :: route.signature.borrow_mask
    file :: jet_rust_emit_source_path(&ctx, location.file)
    line :: "{location.line}u32"
    base_text :: if mask.len() > 0 && mask[0] -> jet_rust_emit_borrowed_value_reference(&ctx, function, base, MIRAccess.Read) else -> jet_rust_emit_value_read(base)
    if range == .Val(range_value) {
        range_text :: if mask.len() > 1 && mask[1] -> "&({jet_rust_emit_value_read(range_value)})" else -> jet_rust_emit_value_read(range_value)
        return jet_rust_emit_prelude_args_exact(&ctx, function, call, [String]{base_text, range_text, file, line})
    }
    args :: [String]{base_text, jet_rust_emit_native_int_argument(&ctx, jet_rust_emit_value_read(start), Val(location)), jet_rust_emit_native_int_argument(&ctx, jet_rust_emit_value_read(end), Val(location)), file, line}
    jet_rust_emit_prelude_args_exact(&ctx, function, call, args)
}

fn jet_rust_emit_enum_variant_name(ctx: &JetRustEmitContext, type_id: MIRTypeID, variant: String) -> String Never! {
    "{jet_rust_emit_type_name(&ctx, type_id)}::{jet_rust_emit_variant_name(&ctx, type_id, variant)}"
}

// MIRRust enum_value: payloads follow the owner declaration's boxed recursive
// edges, so construction matches layout, and a named variant constructs with
// field syntax in declaration order.
fn jet_rust_emit_enum_value(ctx: &JetRustEmitContext, function: MIRFunction, owner: MIRTypeID, variant: String, args: [MIREnumArg], location: MIRPanicLoc?) -> String Never! {
    head :: jet_rust_emit_enum_variant_name(&ctx, owner, variant)
    definition := MIRTypeDef?{None}
    loop candidate in ctx.program.types { if candidate.id == owner -> definition = Val(candidate) }
    row :: definition ?? {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR enum owner type has no row", "checked enum construction resolves its owner declaration", Val(function.span))
        return "unreachable!(\"MIR enum owner\")"
    }
    payload := MIRVariantPayload?{None}
    if row.kind == {
        .Enum(variants, _) -> {
            loop candidate in variants { if candidate.name == variant -> payload = Val(candidate.payload) }
        }
        else -> {}
    }
    shape :: payload ?? {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR enum variant has no row", "checked enum construction names one declared variant of an enum owner", Val(function.span))
        return "unreachable!(\"MIR enum variant\")"
    }
    root :: ~ctx.config.root_prefix
    // MIRRust enum_value: the Core HTTP Body carrier constructs through its
    // native constructors; a native Prelude enum narrows Jet `Int` payloads into
    // its declared Rust slot; DataTree's exact Int and Map-backed Object cross
    // through their Prelude helpers.
    http_body :: jet_rust_emit_is_core_http_type(row, "Body")
    native :: jet_rust_emit_has_native_type_projection(row.key)
    data_tree :: jet_rust_emit_core_rust_type_name(row.key) == (Val("DataTree"))
    if shape == {
        .Unit -> {
            if args.len() != 0 -> jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR unit variant construction has payload arguments", "unit variants construct without a payload", Val(function.span))
            if http_body {
                if variant != "Empty" -> jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.UnsupportedOperation, "E0003", "Core HTTP Body variant has no native constructor projection", "Body constructs through empty/from_text/from_bytes", Val(function.span))
                return "{jet_rust_emit_type_name(&ctx, owner)}::empty()"
            }
            return head
        }
        .Single(payload_type) -> {
            if args.len() != 1 {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR single variant construction payload arity mismatch", "single-payload variants construct from exactly one value", Val(function.span))
                return "unreachable!(\"MIR variant payload arity\")"
            }
            value := jet_rust_emit_native_int_payload_value(&ctx, function, args[0].value, payload_type, jet_rust_emit_value_move(args[0].value), location)
            if jet_rust_emit_equality_edge_boxed(row, variant) -> value = "Box::new({value})"
            if http_body {
                if variant == "Text" -> return "{jet_rust_emit_type_name(&ctx, owner)}::from_text({value})"
                if variant == "Bytes" -> return "{jet_rust_emit_type_name(&ctx, owner)}::from_bytes({value})"
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.UnsupportedOperation, "E0003", "Core HTTP Body variant has no native constructor projection", "Body constructs through empty/from_text/from_bytes", Val(function.span))
                return "unreachable!(\"MIR HTTP Body variant\")"
            }
            if data_tree && variant == "Int" -> return "{root}jet_std::jet_datatree_int({value})"
            if native {
                if jet_rust_emit_native_int_input(&ctx, value, payload_type, location) == .Val(narrowed) -> value = narrowed
            }
            if data_tree && variant == "Object" {
                if jet_rust_emit_value_type(function, args[0].value).kind == {
                    .Map(_, _) -> value = "{root}jet_map_into_entries({value})"
                    else -> {}
                }
            }
            return "{head}({value})"
        }
        .Named(fields) -> {
            if args.len() != fields.len() {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR named variant construction payload arity mismatch", "named variants construct every declared field", Val(function.span))
                return "unreachable!(\"MIR variant payload arity\")"
            }
            rendered := [String]{}
            loop (index, field) in fields {
                if args[index].field != (Val(field.id)) {
                    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR named variant construction field order mismatch", "named variant arguments follow the declared field order", Val(function.span))
                    return "unreachable!(\"MIR variant field order\")"
                }
                value := jet_rust_emit_native_int_payload_value(&ctx, function, args[index].value, field.ty, jet_rust_emit_value_move(args[index].value), location)
                if jet_rust_emit_equality_edge_boxed(row, "{variant}.{field.name}") -> value = "Box::new({value})"
                if native {
                    if jet_rust_emit_native_int_input(&ctx, value, field.ty, location) == .Val(narrowed) -> value = narrowed
                }
                &rendered.push("{jet_rust_emit_field_name(&ctx, field.id)}: {value}")
            }
            return "{head} {{ {rendered.join(", ")} }}"
        }
    }
}

// MIRRust is_core_http_type: a canonical `core.http` declaration with this leaf.
fn jet_rust_emit_is_core_http_type(definition: MIRTypeDef, leaf: String) -> Bool Never! {
    definition.key.starts_with("<corelib>/Core/http::") && definition.key.ends_with("::{leaf}")
}

// MIRRust native_int_payload_value: a Jet `Int` stored in a fixed-width payload
// slot narrows through the host word with a source-located range stop.
fn jet_rust_emit_native_int_payload_value(ctx: &JetRustEmitContext, function: MIRFunction, value_id: MIRValueID, expected: MIRType, value: String, location: MIRPanicLoc?) -> String Never! {
    if jet_rust_emit_value_type(function, value_id).kind != MIRTypeKind.Int -> return ~value
    target := ~expected
    loop {
        if target.kind == {
            .InlineRange(base, _, _) | .Tagged(_, base) | .Quantity(base, _) -> target = ~base
            else -> break
        }
    }
    if target.kind == {
        .IntN(signed, bits) -> {
            root :: ~ctx.config.root_prefix
            file := "\"<mir>\""
            line := 0
            if location == .Val(loc) {
                file = jet_rust_emit_source_path(&ctx, loc.file)
                line = loc.line
            }
            raw :: "{root}jet_std::jet_int_owned_to_i64(&({value})).unwrap_or_else(|_| {root}jet_arithmetic_stop({file}, {line}u32, \"native Int payload exceeds host range\"))"
            if signed && bits == 64 -> return raw
            return "({raw}).try_into().unwrap_or_else(|_| {root}jet_arithmetic_stop({file}, {line}u32, \"native Int payload exceeds target range\"))"
        }
        else -> return ~value
    }
}

// MIRRust native_int_input: narrow a Jet value into a native host slot (record
// field or enum payload), the inverse of native_int_result for `Int` leaves.
fn jet_rust_emit_native_int_input(ctx: &JetRustEmitContext, value: String, ty: MIRType, location: MIRPanicLoc?) -> String? {
    root :: ~ctx.config.root_prefix
    if ty.kind == {
        .Tagged(marker, inner) -> {
            if marker == (MIRTagMarker.Internal{internal_tag: MIRInternalTag.AllocatorView}) -> return None
            return jet_rust_emit_native_int_input(&ctx, value, inner, location)
        }
        .Int -> {
            file := "\"<mir>\""
            line := 0
            if location == .Val(loc) {
                file = jet_rust_emit_source_path(&ctx, loc.file)
                line = loc.line
            }
            return Val("{root}jet_std::jet_int_owned_into_native({value}).unwrap_or_else(|_| {root}jet_arithmetic_stop({file}, {line}u32, \"native Int argument exceeds host range\"))")
        }
        .InlineRange(base, _, _) | .Quantity(base, _) -> return jet_rust_emit_native_int_input(&ctx, value, base, location)
        .Option(inner) -> {
            converted :: jet_rust_emit_native_int_input(&ctx, "__jet_value", inner, location) ?? return None
            return Val("({value}).map(|__jet_value| {converted})")
        }
        .Result(ok, err) -> {
            ok_text :: jet_rust_emit_native_int_input(&ctx, "__jet_value", ok, location)
            err_text :: jet_rust_emit_native_int_input(&ctx, "__jet_error", err, location)
            if ok_text == .Val(ok_converted) {
                if err_text == .Val(err_converted) -> return Val("({value}).map(|__jet_value| {ok_converted}).map_err(|__jet_error| {err_converted})")
                return Val("({value}).map(|__jet_value| {ok_converted})")
            }
            if err_text == .Val(err_converted) -> return Val("({value}).map_err(|__jet_error| {err_converted})")
            return None
        }
        .List(inner) -> {
            converted :: jet_rust_emit_native_int_input(&ctx, "__jet_value", inner, location) ?? return None
            return Val("({value}).into_iter().map(|__jet_value| {converted}).collect::<Vec<_>>()")
        }
        else -> return None
    }
}

fn jet_rust_emit_enum_variant_pattern(ctx: &JetRustEmitContext, owner: MIRTypeID, variant: String) -> String Never! {
    loop definition in ctx.program.types {
        if definition.id == owner {
            if definition.kind == {
                .Enum(variants, _) -> {
                    loop row in variants {
                        if row.name == variant {
                            if row.payload == {
                                .Unit -> return jet_rust_emit_enum_variant_name(&ctx, owner, variant)
                                .Single(_) -> return "{jet_rust_emit_enum_variant_name(&ctx, owner, variant)}(_)"
                                .Named(_) -> return "{jet_rust_emit_enum_variant_name(&ctx, owner, variant)} {{ .. }}"
                            }
                        }
                    }
                }
                else -> {}
            }
        }
    }
    "{jet_rust_emit_enum_variant_name(&ctx, owner, variant)}(..)"
}

// MIRRust enum_is: the HTTP Body carrier and DataTree's exact Int answer through
// their Prelude predicates; every other variant is a structural `matches!`.
fn jet_rust_emit_enum_is(ctx: &JetRustEmitContext, subject: MIRValueID, owner: MIRTypeID, variant: String) -> String Never! {
    receiver :: jet_rust_emit_value_reference(subject, false)
    loop definition in ctx.program.types {
        if definition.id != owner -> next
        if jet_rust_emit_is_core_http_type(definition, "Body") {
            if variant == {
                "Empty" -> return "({receiver}).source_is_empty()"
                "Text" -> return "({receiver}).source_is_text()"
                "Bytes" -> return "({receiver}).source_is_bytes()"
                else -> return "unreachable!(\"Core HTTP Body variant has no native predicate projection\")"
            }
        }
        if variant == "Int" && jet_rust_emit_core_rust_type_name(definition.key) == (Val("DataTree")) -> return "{ctx.config.root_prefix}jet_std::jet_datatree_is_int(&{receiver})"
    }
    "matches!({receiver}, {jet_rust_emit_enum_variant_pattern(&ctx, owner, variant)})"
}

// MIRRust enum_payload: reads the payload by reference and clones it out, through
// boxed recursive edges, the HTTP Body projections, DataTree's exact Int and
// Map-backed Object, and native Prelude enums' Int slots.
fn jet_rust_emit_enum_payload(ctx: &JetRustEmitContext, function: MIRFunction, result: MIRValueID?, subject: MIRValueID, owner: MIRTypeID, variant: String, index: Int) -> String Never! {
    value :: jet_rust_emit_value_reference(subject, false)
    root :: ~ctx.config.root_prefix
    loop definition in ctx.program.types {
        if definition.id == owner {
            if jet_rust_emit_is_core_http_type(definition, "Body") {
                if index != 0 -> return "unreachable!(\"MIR single variant payload index out of range\")"
                if variant == {
                    "Text" -> return "({value}).source_text()"
                    "Bytes" -> return "({value}).source_bytes()"
                    else -> return "unreachable!(\"Core HTTP Body variant has no native payload projection\")"
                }
            }
            native :: jet_rust_emit_has_native_type_projection(definition.key)
            data_tree :: jet_rust_emit_core_rust_type_name(definition.key) == (Val("DataTree"))
            head :: jet_rust_emit_enum_variant_name(&ctx, owner, variant)
            if definition.kind == {
                .Enum(variants, _) -> {
                    loop row in variants {
                        if row.name == variant {
                            if row.payload == {
                                .Single(payload_type) -> {
                                    if index != 0 -> return "unreachable!(\"MIR enum payload index out of range\")"
                                    if data_tree && variant == "Int" -> return "{root}jet_std::jet_datatree_int_payload(&{value}).expect(\"MIR enum payload variant mismatch\")"
                                    payload := "payload.clone()"
                                    object_map := false
                                    if data_tree && variant == "Object" && result == .Val(result_id) {
                                        if jet_rust_emit_value_type(function, result_id).kind == {
                                            .Map(_, _) -> object_map = true
                                            else -> {}
                                        }
                                    }
                                    if object_map {
                                        payload = "{root}jet_data_entries_to_map(payload.clone())"
                                    } else if native && jet_rust_emit_native_int_result(&ctx, "payload.clone()", payload_type) != None {
                                        payload = jet_rust_emit_native_int_result(&ctx, "payload.clone()", payload_type) ?? payload
                                    } else if jet_rust_emit_equality_edge_boxed(definition, variant) {
                                        payload = "payload.as_ref().clone()"
                                    }
                                    return "match {value} {{ {head}(payload) => {payload}, _ => unreachable!(\"MIR enum payload variant mismatch\") }}"
                                }
                                .Named(fields) -> {
                                    if index < 0 || index >= fields.len() -> return "unreachable!(\"MIR enum payload index out of range\")"
                                    field :: fields[index]
                                    payload := if jet_rust_emit_equality_edge_boxed(definition, "{variant}.{field.name}") -> "payload.as_ref().clone()" else -> "payload.clone()"
                                    if native {
                                        if jet_rust_emit_native_int_result(&ctx, payload, field.ty) == .Val(widened) -> payload = widened
                                    }
                                    return "match {value} {{ {head} {{ {jet_rust_emit_field_name(&ctx, field.id)}: payload, .. }} => {payload}, _ => unreachable!(\"MIR enum payload variant mismatch\") }}"
                                }
                                .Unit -> return "unreachable!(\"MIR unit enum has no payload\")"
                            }
                        }
                    }
                }
                else -> {}
            }
        }
    }
    "unreachable!(\"MIR enum payload row is missing\")"
}

// MIRRust rust_struct_literal: a native host record narrows Jet `Int` fields into
// its Rust slots, with the bespoke Range/DataError/AsyncPolicy/WebFormFieldSpec
// host shapes, and the Core email Address keeps a native Option display.
fn jet_rust_emit_struct_literal(ctx: &JetRustEmitContext, type_id: MIRTypeID, fields: [MIRFieldValue]) -> String Never! {
    rust_type_name :: jet_rust_emit_type_name(&ctx, type_id)
    definition := MIRTypeDef?{None}
    loop candidate in ctx.program.types { if candidate.id == type_id -> definition = Val(candidate) }
    key := ""
    if definition == .Val(row) -> key = row.key
    native :: jet_rust_emit_has_native_type_projection(key)
    range_type :: rust_type_name.ends_with("JetRange")
    data_error :: rust_type_name.ends_with("jet_std::DataError")
    async_policy :: key == "AsyncPolicy"
    form_field_spec :: key == "WebFormFieldSpec"
    email_address :: jet_rust_emit_core_email_type_name(key) == (Val("Address"))
    bespoke :: range_type || data_error || async_policy || form_field_spec || rust_type_name == "JetNetErrorDetail"
    rendered := [String]{}
    loop field in fields {
        field_name :: jet_rust_emit_field_name(&ctx, field.field)
        field_type :: jet_rust_emit_field_row_type(&ctx, field.field) ?? MIRType{kind: MIRTypeKind.Bool, identity: None, layout: mir_type_layout(MIRTypeKind.Bool)}
        value := jet_rust_emit_value_move(field.value)
        email_display := false
        if email_address && field_name == "display" {
            if field_type.kind == .Option(inner) -> email_display = inner.kind == MIRTypeKind.String
        }
        if email_display -> value = "({value}).ok()"
        if !email_display && native && !bespoke {
            if jet_rust_emit_native_int_input(&ctx, value, field_type, None) == .Val(narrowed) -> value = narrowed
        }
        if data_error && (field_name == "row" || field_name == "column" || field_name == "index") {
            narrowed :: jet_rust_emit_native_int_argument(&ctx, "__jet_data_index", None)
            value = "({value}).map(|__jet_data_index| {narrowed})"
        }
        if range_type && (field_name == "start" || field_name == "end") -> value = jet_rust_emit_native_int_argument(&ctx, value, None)
        if async_policy && field_name == "capacity" -> value = jet_rust_emit_native_int_argument(&ctx, value, None)
        if form_field_spec && (field_name == "default" || field_name == "group") -> value = "({value}).ok()"
        &rendered.push("{field_name}: {value}")
    }
    private_fields :: if form_field_spec -> ", parser: None" else -> ""
    "{rust_type_name} {{ {rendered.join(", ")}{private_fields} }}"
}

fn jet_rust_emit_field_row_type(ctx: &JetRustEmitContext, id: MIRFieldID) -> MIRType? {
    loop row in ctx.program.fields { if row.id == id -> return Val(row.field.ty) }
    None
}

// MIRRust field projection: boxed recursive fields unbox, and a native host
// record's Prelude slots re-enter the Jet carriers (WebFormFieldSpec optionals,
// the email Address display, `Int` fields stored as host words).
fn jet_rust_emit_field_read(ctx: &JetRustEmitContext, function: MIRFunction, base: MIRValueID, field: MIRFieldID) -> String Never! {
    root :: ~ctx.config.root_prefix
    owner := MIRTypeDef?{None}
    field_row := MIRField?{None}
    loop row in ctx.program.fields {
        if row.id == field {
            field_row = Val(row.field)
            loop definition in ctx.program.types { if definition.id == row.owner -> owner = Val(definition) }
        }
    }
    boxed := false
    native := false
    key := ""
    if owner == .Val(definition) {
        key = definition.key
        native = jet_rust_emit_has_native_type_projection(definition.key)
        if field_row == .Val(declared) {
            loop edge in definition.boxed_edges { if edge == declared.name -> boxed = true }
        }
    }
    field_name :: jet_rust_emit_field_name(&ctx, field)
    unbox :: if boxed -> ".as_ref()" else -> ""
    value := "({jet_rust_emit_value_read(base)}).{field_name}{unbox}.clone()"
    partial :: jet_rust_emit_partial_projected_value(&ctx, function, base, field)
    if partial == .Val(reference) {
        value = if boxed -> "({reference}).as_ref().clone()" else -> "(*({reference})).clone()"
    }
    if key == "WebFormFieldSpec" && (field_name == "default" || field_name == "group") -> return "({value}).ok_or({root}JetAbsent)"
    if field_row == .Val(declared) {
        if jet_rust_emit_core_email_type_name(key) == (Val("Address")) && declared.name == "display" {
            if declared.ty.kind == .Option(inner) {
                if inner.kind == MIRTypeKind.String -> return "({value}).ok_or({root}JetAbsent)"
            }
        }
        if native {
            if jet_rust_emit_native_int_result(&ctx, value, declared.ty) == .Val(converted) -> return converted
        }
    }
    value
}

// D-OPT-WRITE1 (#3974): the Rust pattern that binds a `MIRProjection.Payload`
// slot as `payload`.
fn jet_rust_emit_payload_pattern(ctx: &JetRustEmitContext, kind: MIRPayloadKind) -> String Never! {
    if kind == {
        .Option -> return "Ok(payload)"
        .Result(ok) -> return if ok -> "Ok(payload)" else -> "Err(payload)"
        .Enum(owner, variant, index) -> {
            head :: jet_rust_emit_enum_variant_name(&ctx, owner, variant)
            loop definition in ctx.program.types {
                if definition.id == owner {
                    if definition.kind == {
                        .Enum(variants, _) -> {
                            loop row in variants {
                                if row.name == variant {
                                    if row.payload == {
                                        .Single(_) -> {
                                            if index == 0 -> return "{head}(payload)"
                                        }
                                        .Named(fields) -> {
                                            if index >= 0 && index < fields.len() {
                                                field :: fields[index]
                                                return "{head} {{ {jet_rust_emit_field_name(&ctx, field.id)}: payload, .. }}"
                                            }
                                        }
                                        .Unit -> {}
                                    }
                                }
                            }
                        }
                        else -> {}
                    }
                }
            }
        }
    }
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR payload place names no variant payload slot", "a payload projection must name one payload slot of a checked variant", None)
    "__jet_missing_payload"
}

fn jet_rust_emit_is_distinct_type(ctx: &JetRustEmitContext, source: MIRType) -> Bool Never! {
    ty := source
    if ty.identity == .Val(identity) {
        loop instance in ctx.program.type_instances {
            if instance.identity == (Val(identity)) { ty = instance; break }
        }
    }
    if ty.kind == {
        .Apply(name, _) -> {
            loop definition in ctx.program.types {
                if definition.id == name.id {
                    if definition.kind == {
                        .Distinct(_, _) -> return true
                        else -> return false
                    }
                }
            }
        }
        else -> {}
    }
    false
}

fn jet_rust_emit_unit_wrap(ctx: &JetRustEmitContext, target: MIRType, value: String) -> String Never! {
    if jet_rust_emit_is_distinct_type(&ctx, target) -> "{jet_rust_emit_type(&ctx, target)}({value})" else -> value
}

fn jet_rust_emit_unit_conversion(ctx: &JetRustEmitContext, function: MIRFunction, call: MIRPreludeCallID, value: MIRValueID, parameters: [MIRValueID], target: MIRType, location: MIRPanicLoc) -> String Never! {
    route := MIRPreludeCall?{None}
    loop candidate in ctx.program.prelude_calls { if candidate.id == call -> route = Val(candidate) }
    route_row :: route ?? {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "unit conversion route is missing", "each checked unit conversion must retain its exact StaticPrelude kernel", Val(function.span))
        return "unreachable!(\"missing unit conversion route\")"
    }
    rounded :: route_row.member == "conversion_rounded" || route_row.member == "conversion_rounded_measurement"
    args := [String]{jet_rust_emit_value_read(value)}
    digits_index :: if rounded -> 5 else -> -1
    loop index in 0..<parameters.len() {
        parameter := parameters[index]
        if index < 4 {
            instruction :: jet_rust_emit_find_value_instruction(function, parameter)
            if instruction == .Val(producer) {
                if producer.operation == {
                    .Constant(constant) -> {
                        if constant == {
                            .String(text) -> {
                                &args.push("&{jet_rust_emit_quote(text)}")
                                next
                            }
                            else -> {}
                        }
                    }
                    else -> {}
                }
            }
        }
        if {
            index == digits_index && jet_rust_emit_value_type(function, parameter).kind == MIRTypeKind.Int -> {
            &args.push("__jet_unit_digits")
            }
            else -> {
            &args.push(jet_rust_emit_value_read(parameter))
            }
        }
    }
    expected := route_row.signature.arity
    if {
        args.len() + 2 == expected -> {
        &args.push(jet_rust_emit_source_path(&ctx, location.file))
        &args.push("{location.line}u32")
        }
        args.len() != expected -> {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "unit conversion ABI has an unexpected parameter count", "exact, measured, rounded, and measured-rounded routes use 5/6/7/8 arguments without source-location suffixes", Val(function.span))
        return "unreachable!(\"unit conversion ABI\")"
        }
    }
    digit_setup := ""
    if rounded && jet_rust_emit_value_type(function, parameters[digits_index]).kind == MIRTypeKind.Int {
        digits := parameters[digits_index]
        digit_ref :: jet_rust_emit_value_reference(digits, false)
        if target.kind == {
            .Result(_, error) -> {
                if error.kind != MIRTypeKind.String -> jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "rounded unit conversion uses a non-String error carrier", "the checked rounded conversion route reports conversion failures as String", Val(function.span))
                digit_setup = "let __jet_unit_digits = {ctx.config.root_prefix}jet_std::jet_int_owned_to_i64(&({digit_ref})).map_err(|error| error.to_string())?;"
            }
            else -> digit_setup = "let __jet_unit_digits = {ctx.config.root_prefix}jet_std::jet_int_owned_to_i64(&({digit_ref})).unwrap_or_else(|error| panic!(\"unit conversion digits are out of range: {{}}\", error));"
        }
    }
    result :: jet_rust_emit_route_call(&ctx, call, args)
    if target.kind == {
        .Result(ok, error) -> {
            if error.kind != MIRTypeKind.String {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "unit conversion uses a non-String error carrier", "the checked unit conversion kernel reports failures as String", Val(function.span))
                return "unreachable!(\"unit conversion error carrier\")"
            }
            converted := jet_rust_emit_unit_wrap(&ctx, ok, "value")
            if rounded {
                return "(|| -> {jet_rust_emit_type(&ctx, target)} {{ {digit_setup} let __jet_unit_result = {result}; __jet_unit_result.map(|value| {converted}).map_err(|error| error.to_string()) }})()"
            }
            converted_result :: jet_rust_emit_unit_wrap(&ctx, ok, "__jet_unit_result")
            return "(|| -> {jet_rust_emit_type(&ctx, target)} {{ let __jet_unit_result = {result}.ok_or_else(|| \"unit conversion is not exactly representable\".to_string())?; Ok({converted_result}) }})()"
        }
        .Option(inner) -> {
            converted := jet_rust_emit_unit_wrap(&ctx, inner, "value")
            if rounded -> return "({result}).ok().map(|value| {converted})"
            return "({result}).map(|value| {converted})"
        }
        else -> {}
    }
    if rounded {
        unwrapped := "({result}).unwrap_or_else(|error| panic!(\"unit conversion failed: {{}}\", error))"
        return jet_rust_emit_unit_wrap(&ctx, target, unwrapped)
    }
    unwrapped := "({result}).unwrap_or_else(|| panic!(\"unit conversion is not exactly representable\"))"
    jet_rust_emit_unit_wrap(&ctx, target, unwrapped)
}

fn jet_rust_emit_conversion(ctx: &JetRustEmitContext, function: MIRFunction, value: MIRValueID, parameters: [MIRValueID], target: MIRType, conversion: MIRConversion) -> String Never! {
    rendered := jet_rust_emit_value_read(value)
    if conversion == MIRConversion.Transparent {
        if jet_rust_emit_is_distinct_type(&ctx, jet_rust_emit_value_type(function, value)) -> rendered = "({rendered}).0"
        if jet_rust_emit_is_distinct_type(&ctx, target) -> rendered = "{jet_rust_emit_type(&ctx, target)}({rendered})"
        return rendered
    }
    if conversion == MIRConversion.NumericCast -> return "({rendered}) as {jet_rust_emit_type(&ctx, target)}"
    if conversion == MIRConversion.SendFn -> return "std::sync::Arc::new({rendered})"
    if conversion == {
        .Prelude(call, location, fallibility) -> {
            route := MIRPreludeCall?{None}
            loop candidate in ctx.program.prelude_calls { if candidate.id == call -> route = Val(candidate) }
            if route == .Val(route_row) {
                if route_row.member.starts_with("conversion_") -> return jet_rust_emit_unit_conversion(&ctx, function, call, value, parameters, target, location)
            }
            args := [String]{rendered}
            loop parameter in parameters -> &args.push(jet_rust_emit_value_read(parameter))
            route_arity := args.len()
            if route == .Val(route_row) {
                route_arity = route_row.signature.arity
            }
            if {
                args.len() + 2 == route_arity -> {
                &args.push(jet_rust_emit_source_path(&ctx, location.file))
                &args.push("{location.line}u32")
                }
                args.len() != route_arity -> {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR conversion arguments do not match the checked route", "location arguments are emitted only for routes whose ABI includes them", Val(function.span))
                }
            }
            result :: jet_rust_emit_route_call(&ctx, call, args)
            if jet_rust_emit_failure_needs_try(fallibility, target) -> return "({result})?"
            return result
        }
        else -> {}
    }
    "unreachable!(\"unsupported MIR conversion\")"
}

fn jet_rust_emit_compiler_builtin_for_type(ctx: &JetRustEmitContext, id: MIRTypeID) -> MIRCompilerBuiltin? {
    loop definition in ctx.program.types {
        if definition.id == id -> return definition.compiler_builtin
    }
    None
}

fn jet_rust_emit_default_err_struct(ctx: &JetRustEmitContext, id: MIRTypeID, values: [MIRFieldValue]) -> String Never! {
    definition := MIRTypeDef?{None}
    loop candidate in ctx.program.types {
        if candidate.id == id -> definition = Val(candidate)
    }
    if definition == None {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "compiler-owned Err type row is missing", "the canonical default error constructor requires its checked field schema", None)
        return "unreachable!(\"missing default Err type\")"
    }
    definition_row :: definition ?? panic("default Err type row disappeared")
    declared := [MIRField]{}
    if definition_row.kind == {
        .Struct(fields, _) -> declared = fields
        else -> jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "compiler-owned Err type is not a struct", "the canonical default error constructor has message/code/cause fields", None)
    }
    if declared.len() != 3 || values.len() != 3 {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "compiler-owned Err literal has an invalid field set", "the default error carrier must contain exactly message, code, and cause", None)
        return "unreachable!(\"invalid default Err literal\")"
    }
    message := MIRValueID?{None}
    code := MIRValueID?{None}
    cause := MIRValueID?{None}
    loop declared_field in declared {
        matched := MIRValueID?{None}
        loop value in values {
            if value.field == declared_field.id {
                if matched != None {
                    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "compiler-owned Err literal repeats a field", "each canonical error field must appear once", Val(declared_field.span))
                }
                matched = Val(value.value)
            }
        }
        if declared_field.name == {
            "message" -> message = matched
            "code" -> code = matched
            "cause" -> cause = matched
            else -> jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "compiler-owned Err has an unexpected field", "the canonical error carrier fields are message, code, and cause", Val(declared_field.span))
        }
    }
    message_value :: message ?? {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "compiler-owned Err literal omits message", "the default error constructor requires its checked message field", None)
        return "unreachable!(\"missing default Err message\")"
    }
    code_value :: code ?? {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "compiler-owned Err literal omits code", "the default error constructor requires its checked code field", None)
        return "unreachable!(\"missing default Err code\")"
    }
    cause_value :: cause ?? {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "compiler-owned Err literal omits cause", "the default error constructor requires its checked cause field", None)
        return "unreachable!(\"missing default Err cause\")"
    }
    message_text := jet_rust_emit_value_move(message_value)
    code_text := jet_rust_emit_value_move(code_value)
    // A Core-layer program spells `String` as `&'static str`, while the
    // Prelude constructor owns its text.
    if jet_rust_emit_is_core_layer(&ctx) {
        message_text = "String::from({message_text})"
        code_text = "({code_text}).map(String::from)"
    }
    "{ctx.config.root_prefix}jet_err({message_text}, {code_text}, {jet_rust_emit_value_move(cause_value)})"
}

fn jet_rust_emit_global_symbol(ctx: &JetRustEmitContext, name: String) -> String Never! {
    if name == "transaction" -> return "{ctx.config.root_prefix}jet_transaction()"
    if name == "stm" -> return "{ctx.config.root_prefix}jet_stm::begin()"
    loop constant in ctx.program.constants {
        if constant.name == name || constant.key == name -> return jet_rust_emit_symbol("__jet_const_", constant.name, constant.id.value)
    }
    "{ctx.config.root_prefix}{jet_rust_emit_sanitize(name)}"
}

fn jet_rust_emit_scope_fact(scope: MIRScope, key: String) -> String? {
    loop fact in scope.facts { if fact.key == key -> return Val(fact.value) }
    None
}

fn jet_rust_emit_scope_row(ctx: &JetRustEmitContext, function: MIRFunction, id: MIRScopeID) -> MIRScope? {
    loop scope in function.scopes { if scope.id == id -> return Val(scope) }
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR scope identity is missing from its function", "scope enter/exit operations must resolve to one checked scope row", Val(function.span))
    None
}

fn jet_rust_emit_scope_is_debug_only(function: MIRFunction, id: MIRScopeID) -> Bool Never! {
    loop scope in function.scopes {
        if scope.id == id -> return scope.kind == MIRScopeKind.DebugOnly
    }
    false
}

fn jet_rust_emit_scope_enter(ctx: &JetRustEmitContext, function: MIRFunction, id: MIRScopeID, member: MIRTestScopeMember?) -> String Never! {
    scope_value :: jet_rust_emit_scope_row(&ctx, function, id)
    if scope_value == .Val(scope) {
        if scope.kind == MIRScopeKind.DebugOnly -> return "()"
        if scope.kind == MIRScopeKind.Shield -> return "jet_scheduler_shield_enter()"
        if scope.kind == MIRScopeKind.Context {
            if scope.deadline != None -> return "__jet_deadline_scopes.push(jet_ctx_push_deadline({jet_rust_emit_value_read(scope.deadline ?? MIRValueID{value: 0})}))"
            return "()"
        }
        if scope.kind == MIRScopeKind.Unsafe {
            file := ""
            file_fact := jet_rust_emit_scope_fact(scope, "sentry_file")
            if file_fact != None -> file = file_fact ?? ""
            if file == "" && function.unsafe_gate != None -> file = (function.unsafe_gate ?? MIRUnsafeGate{file: "", line: 0, reason: "", enabled: true, fenced: false}).file
            line := "0u32"
            line_fact := jet_rust_emit_scope_fact(scope, "sentry_line")
            if {
                line_fact != None -> line = "{line_fact ?? "0"}u32"
                function.unsafe_gate != None -> line = "{(function.unsafe_gate ?? MIRUnsafeGate{file: "", line: 0, reason: "", enabled: true, fenced: false}).line}u32"
            }
            enabled := "true"
            enabled_fact := jet_rust_emit_scope_fact(scope, "sentry_enabled")
            if {
                enabled_fact != None -> enabled = enabled_fact ?? "true"
                function.unsafe_gate != None && !(function.unsafe_gate ?? MIRUnsafeGate{file: "", line: 0, reason: "", enabled: true, fenced: false}).enabled -> enabled = "false"
            }
            fenced := "false"
            fenced_fact := jet_rust_emit_scope_fact(scope, "sentry_fenced")
            if {
                fenced_fact != None -> fenced = fenced_fact ?? "false"
                function.unsafe_gate != None && (function.unsafe_gate ?? MIRUnsafeGate{file: "", line: 0, reason: "", enabled: true, fenced: false}).fenced -> fenced = "true"
            }
            reason := scope.name ?? ""
            if reason == "" && function.unsafe_gate != None -> reason = (function.unsafe_gate ?? MIRUnsafeGate{file: "", line: 0, reason: "", enabled: true, fenced: false}).reason
            constructor :: if fenced == "true" -> "jet_sentry_fenced_scope" else -> "jet_sentry_scope"
            return "__jet_sentry_scopes.push(jet_mem::{constructor}({enabled}, {jet_rust_emit_quote(file)}, {line}, {jet_rust_emit_quote(reason)}))"
        }
        if scope.kind == MIRScopeKind.Policy {
            enabled := jet_rust_emit_scope_fact(scope, "sentry_enabled") ?? "false"
            return "__jet_sentry_scopes.push(jet_mem::jet_sentry_policy_scope({enabled}))"
        }
    }
    if member == .Val(member_value) {
        if member_value == {
            .ExpectFail(expected) -> {
                expected_text :: if expected == .Val(expected_code) -> "Some({jet_rust_emit_quote(expected_code)})" else -> "None"
                return "{ctx.config.root_prefix}jet_test_expect_fail_enter_scope({id.value}, {expected_text})"
            }
            .Timeout(duration) -> return "{ctx.config.root_prefix}jet_test_timeout_enter({id.value}, ({jet_rust_emit_value_read(duration)}).ns)"
            .Skip(_) -> return "()"
            .Measure -> return "()"
        }
    }

    "()"
}

fn jet_rust_emit_scope_member(function: MIRFunction, id: MIRScopeID) -> MIRTestScopeMember? {
    loop block in function.blocks {
        loop instruction in block.instructions {
            if instruction.operation == {
                .ScopeEnter(scope, member) -> {
                    if scope == id && member != None -> return member
                }
                else -> {}
            }
        }
    }
    None
}

fn jet_rust_emit_scope_exit(ctx: &JetRustEmitContext, function: MIRFunction, id: MIRScopeID) -> String Never! {
    scope_value :: jet_rust_emit_scope_row(&ctx, function, id)
    if scope_value == .Val(scope) {
        if scope.kind == MIRScopeKind.Transaction && scope.name != None {
            local_name :: scope.name ?? ""
            local := MIRLocal?{None}
            loop candidate in function.locals {
                if candidate.name == local_name {
                    if local != None -> jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR transaction local name is ambiguous", "each shared transaction scope must own one uniquely named STM local", Val(scope.span))
                    local = Val(candidate)
                }
            }
            local_row :: local ?? {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR transaction scope has no STM local", "a Shared transaction scope must retain its generated transaction guard", Val(scope.span))
                return "unreachable!(\"missing MIR STM local\")"
            }
            return "{jet_rust_emit_local_slot(local_row.id)}.take().expect(\"MIR STM transaction\").commit()"
        }

        if scope.kind == MIRScopeKind.DebugOnly -> return "()"
        if scope.kind == MIRScopeKind.Shield -> return "jet_scheduler_shield_leave()"
        if scope.kind == MIRScopeKind.Context {
            if scope.deadline != None -> return "drop(__jet_deadline_scopes.pop())"
            return "()"
        }
        if scope.kind == MIRScopeKind.Unsafe || scope.kind == MIRScopeKind.Policy -> return "drop(__jet_sentry_scopes.pop())"
    }
    member :: jet_rust_emit_scope_member(function, id)
    if member == .Val(member_value) {
        if member_value == {
            .ExpectFail(expected) -> {
                expected_text :: if expected == .Val(expected_code) -> "Some({jet_rust_emit_quote(expected_code)})" else -> "None"
                return "if {ctx.config.root_prefix}jet_test_expect_fail_leave_scope({id.value}).is_none() {{ {ctx.config.root_prefix}jet_test_expect_fail_unmet({expected_text}); }}"
            }
            .Timeout(_) -> return "if let Some((__jet_elapsed, __jet_limit)) = {ctx.config.root_prefix}jet_test_timeout_leave({id.value}) {{ if __jet_elapsed > __jet_limit {{ {ctx.config.root_prefix}jet_test_timeout_failure(__jet_elapsed, __jet_limit); }} }}"
            .Skip(whole_test) -> return "{ctx.config.root_prefix}jet_test_skip_scope({whole_test})"
            .Measure -> return "()"
        }
    }
    "()"
}

fn jet_rust_emit_drop_value(ctx: &JetRustEmitContext, function: MIRFunction, value: MIRValueID, kind: MIRDropKind) -> String Never! {
    if jet_rust_emit_partial_drop_value(&ctx, function, value) == .Val(partial) -> return partial
    if jet_rust_emit_uninit_fixed_drop_value(function, value) == .Val(uninit) -> return uninit
    if kind == {
        .Value | .Shared -> return "{{ drop({jet_rust_emit_value_move(value)}); () }}"
        .View -> return "{{ drop({jet_rust_emit_value_move(value)}); () }}"
        .ForeignHandle -> {
            ty :: jet_rust_emit_value_type(function, value)
            loop handle in ctx.program.handles {
                if jet_rust_emit_same_handle_type(handle.ty, ty) -> return jet_rust_emit_handle_drop(&ctx, function, jet_rust_emit_value_move(value), function.span, handle)
            }
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR foreign-handle drop has no lifecycle row", "checked foreign-handle values must retain the canonical close operation required by MIR", Val(function.span))
            return "unreachable!(\"foreign handle lifecycle missing\")"
        }
        .NoDrop -> return "{{ let _ = {jet_rust_emit_value_move(value)}; () }}"
    }
}

fn jet_rust_emit_closure(ctx: &JetRustEmitContext, outer: MIRFunction, target_id: MIRFunctionID, captures: [MIRCaptureOperand], result: MIRValueID?) -> String Never! {
    target := MIRFunction?{None}
    loop candidate in ctx.program.functions {
        if candidate.id == target_id -> target = Val(candidate)
    }
    target_function :: target ?? {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR closure target function is missing", "checked closures must resolve their target function identity before source emission", Val(outer.span))
        return "|| unreachable!(\"missing MIR closure target\")"
    }
    if captures.len() != target_function.capture_params.len() {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR closure capture arity is invalid", "checked closure values must preserve the target capture ABI", Val(outer.span))
        return "|| unreachable!(\"MIR closure capture arity\")"
    }
    setup := ""
    call_args := [String]{}
    loop (index, operand) in captures {
        capture := target_function.capture_params[index]
        captured :: if operand == {
            .Place(place) -> {
                if capture.access == {
                    .Move -> jet_rust_emit_place_move(&ctx, outer, place)
                    .Read -> if jet_rust_emit_type_is_borrowed(capture.ty) -> jet_rust_emit_place_reference(&ctx, outer, place, MIRAccess.Read) else -> jet_rust_emit_place_read(&ctx, outer, place)
                    .Write -> jet_rust_emit_place_reference(&ctx, outer, place, MIRAccess.Write)
                }
            }
            .Value(value) -> if capture.access == MIRAccess.Move -> jet_rust_emit_value_move(value) else -> jet_rust_emit_value_read(value)
        }
        name :: jet_rust_emit_capture_name(capture.slot)
        setup = if capture.access == MIRAccess.Write -> "{setup}let mut {name} = {captured}; " else -> "{setup}let {name} = {captured}; "
        call_arg :: if {
            capture.access == MIRAccess.Write -> "&mut {name}"
            capture.access == MIRAccess.Read && jet_rust_emit_type_is_borrowed(capture.ty) -> "&{name}"
            else -> name
        }
        &call_args.push(call_arg)
    }
    params := [String]{}
    loop parameter in target_function.params {
        name := jet_rust_emit_parameter_name(target_function, parameter.index)
        &params.push("{name}: {jet_rust_emit_callable_param_type(&ctx, parameter.ty, parameter.access)}")
        &call_args.push(name)
    }
    invocation := "{jet_rust_emit_function_name(&ctx, target_id)}({call_args.join(", ")})"
    if target_function.is_unsafe -> invocation = "unsafe {{ {invocation} }}"
    closure := "move |{params.join(", ")}| {invocation}"
    if setup != "" -> closure = "{{ {setup}{closure} }}"
    send := false
    if result == .Val(result_id) {
        result_type :: jet_rust_emit_value_type(outer, result_id)
        if result_type.kind == {
            .SendFn(_, _, _) -> send = true
            else -> {}
        }
    }
    return if send -> "std::sync::Arc::new({closure})" else -> "std::rc::Rc::new(std::cell::RefCell::new(Some(Box::new({closure}))))"
}

fn jet_rust_emit_shared_guard_map(ctx: &JetRustEmitContext, function: MIRFunction, call: MIRPreludeCallID, guard: MIRValueID, path: [MIRFieldID], editable: Bool) -> String Never! {
    if path.len() == 0 {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR shared guard path is empty", "checked guard projections must carry at least one field edge", Val(function.span))
        return "unreachable!(\"empty shared guard path\")"
    }
    route := MIRPreludeCall?{None}
    loop candidate in ctx.program.prelude_calls { if candidate.id == call -> route = Val(candidate) }
    row :: route ?? {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR shared guard route is missing", "checked guard projections must resolve their map Prelude route", Val(function.span))
        return "unreachable!(\"missing shared guard route\")"
    }
    method := row.member
    if row.module_name == "core.cell_guard" && (method == "map_read" || method == "map_edit") -> method = "map"
    borrow :: if editable -> "&mut" else -> "&"
    expression := jet_rust_emit_value_move(guard)
    loop field in path {
        project :: "|__jet_guard_value| ({borrow}__jet_guard_value.{jet_rust_emit_field_name(&ctx, field)})"
        if row.module_name == "core.cell_guard" -> expression = "({expression}).{method}({project})" else -> expression = "({expression}).{method}({field.value}i64, {project})"
    }
    expression
}

fn jet_rust_emit_shared_guard_split(ctx: &JetRustEmitContext, function: MIRFunction, call: MIRPreludeCallID, map_call: MIRPreludeCallID, guard: MIRValueID, first: [MIRFieldID], second: [MIRFieldID], editable: Bool) -> String Never! {
    if first.len() == 0 || second.len() == 0 {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR shared guard split path is empty", "checked guard splits must carry two non-empty field paths", Val(function.span))
        return "unreachable!(\"empty shared guard split path\")"
    }
    common := 0
    loop common < first.len() && common < second.len() {
        if first[common] != second[common] -> break
        common += 1
    }
    if common == first.len() || common == second.len() {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR shared guard split paths overlap", "checked guard split paths must diverge below their common prefix", Val(function.span))
        return "unreachable!(\"overlapping shared guard split paths\")"
    }
    prefix := [MIRFieldID]{}
    index := 0
    loop index < common {
        &prefix.push(first[index])
        index += 1
    }
    mapped :: jet_rust_emit_shared_guard_map(&ctx, function, map_call, guard, prefix, editable)
    split_route := MIRPreludeCall?{None}
    loop candidate in ctx.program.prelude_calls { if candidate.id == call -> split_route = Val(candidate) }
    row :: split_route ?? {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR shared guard split route is missing", "checked guard splits must resolve their split Prelude route", Val(function.span))
        return "unreachable!(\"missing shared guard split route\")"
    }
    method := row.member
    if row.module_name == "core.cell_guard" && (method == "split_read" || method == "split_edit") -> method = "split"
    borrow :: if editable -> "&mut" else -> "&"
    first_name :: jet_rust_emit_field_name(&ctx, first[common])
    second_name :: jet_rust_emit_field_name(&ctx, second[common])
    project :: "|__jet_guard_value| ({borrow}__jet_guard_value.{first_name}, {borrow}__jet_guard_value.{second_name})"
    if row.module_name == "core.cell_guard" -> return "({mapped}).{method}({project})"

    "({mapped}).{method}({first[common].value}i64, {second[common].value}i64, {project})"
}

fn jet_rust_emit_text_hole_kind(kind: MIRTextHoleKind) -> String Never! {
    if kind == {
        .Text -> "JetTextHoleKind::Text"
        .Int -> "JetTextHoleKind::Int"
        .Float -> "JetTextHoleKind::Float"
        .Bool -> "JetTextHoleKind::Bool"
        .InlineRange(lo, hi) -> "JetTextHoleKind::InlineRange {{ lo: {lo}, hi: {hi} }}"
    }
}

fn jet_rust_emit_text_pattern(parts: [MIRTextPatternPart]) -> String Never! {
    rendered := [String]{}
    loop part in parts {
        if part == {
            .Literal(value) -> &rendered.push("JetTextMatchPart::Literal({jet_rust_emit_quote(value)})")
            .Hole(kind, _, _) -> &rendered.push("JetTextMatchPart::Hole {{ kind: {jet_rust_emit_text_hole_kind(kind)} }}")
        }
    }
    "&[{rendered.join(", ")}]"
}

fn jet_rust_emit_binary_pattern(parts: [MIRBinaryPatternPart]) -> String Never! {
    rendered := [String]{}
    loop part in parts {
        if part == {
            .Literal(bytes) -> {
                values := [String]{}
                loop byte in bytes -> &values.push("{Int.from_u8(byte)}u8")
                &rendered.push("JetBinMatchPart::Lit(&[{values.join(", ")}])")
            }
            .Bits(width, _, little, _) -> &rendered.push("JetBinMatchPart::Bits {{ width: {width}usize, little: {if little -> "true" else -> "false"} }}")
            .Rest(_, _) -> &rendered.push("JetBinMatchPart::Rest")
        }
    }
    "&[{rendered.join(", ")}]"
}

fn jet_rust_emit_host_callback(ctx: &JetRustEmitContext, function: MIRFunction, callable: MIRValueID, params: [MIRType]) -> String Never! {
    send := false
    callable_type :: jet_rust_emit_value_type(function, callable)
    if callable_type.kind == {
        .SendFn(_, _, _) -> send = true
        else -> {}
    }
    mask := jet_rust_emit_indirect_borrow_mask(function, callable)
    parameter_text := [String]{}
    argument_text := [String]{}
    loop (index, ty) in params {
        name :: "__jet_callback_arg_{index}"
        &parameter_text.push("{name}: &{jet_rust_emit_type(&ctx, ty)}")
        borrowed :: index < mask.len() && mask[index]
        if {
            borrowed -> &argument_text.push(name)
            jet_rust_emit_type_is_borrowed(ty) -> &argument_text.push("*{name}")
            else -> &argument_text.push(name)
        }
    }
    callback :: jet_rust_emit_value_move(callable)
    invocation :: "(__jet_callback)({argument_text.join(", ")})"
    wrapper :: if send -> "std::sync::Arc::new" else -> "Box::new"
    "{{ let __jet_callback = {callback}; {wrapper}(move |{parameter_text.join(", ")}| {invocation}) }}"
}

fn jet_rust_emit_semantic_values(ctx: &JetRustEmitContext, function: MIRFunction, call: MIRPreludeCallID, values: [MIRValueID]) -> String Never! {
    route := MIRPreludeCall?{None}
    loop candidate in ctx.program.prelude_calls {
        if candidate.id == call -> route = Val(candidate)
    }
    if route == None {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR semantic Prelude route is missing", "semantic operations must resolve their checked route identity before source emission", Val(function.span))
        return "unreachable!(\"missing semantic Prelude route\")"
    }
    row :: route ?? return "unreachable!(\"missing semantic Prelude route\")"
    if values.len() < row.signature.arity || values.len() > row.signature.max_arity || row.signature.borrow_mask.len() != values.len() {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR semantic Prelude arity is invalid", "semantic operation values must match the checked route arity and borrow ABI", Val(function.span))
        return "unreachable!(\"semantic Prelude arity\")"
    }
    rendered := [String]{}
    index := 0
    loop value in values {
        if row.signature.borrow_mask[index] -> &rendered.push(jet_rust_emit_value_reference(value, false)) else -> &rendered.push(jet_rust_emit_value_read(value))
        index += 1
    }
    jet_rust_emit_route_call(&ctx, call, rendered)
}

fn jet_rust_emit_pattern_capture_descriptor(function: MIRFunction, matched: MIRValueID, index: Int) -> Bool Never! {
    instruction :: jet_rust_emit_find_value_instruction(function, matched) ?? return false
    row := instruction
    if row.operation == {
        .Semantic(semantic) -> {
            if semantic == {
                .TextPatternMatch(_, _, parts) | .CursorTakePattern(_, _, parts) -> {
                    capture_index := 0
                    loop part in parts {
                        if part == {
                            .Hole(_, _, _) -> {
                                if capture_index == index -> return true
                                capture_index += 1
                            }
                            else -> {}
                        }
                    }
                }
                .BinaryPatternMatch(_, _, parts) | .ReaderTakePattern(_, _, parts) -> {
                    capture_index := 0
                    loop part in parts {
                        if part == {
                            .Bits(_, _, _, _) | .Rest(_, _) -> {
                                if capture_index == index -> return true
                                capture_index += 1
                            }
                            else -> {}
                        }
                    }
                }
                else -> {}
            }
        }
        else -> {}
    }
    false
}

fn jet_rust_emit_pattern_capture(ctx: &JetRustEmitContext, function: MIRFunction, matched: MIRValueID, index: Int, result: MIRValueID?) -> String Never! {
    if result == None {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR pattern capture has no result value", "checked pattern captures must produce their typed tuple field", Val(function.span))
        return "unreachable!(\"MIR pattern capture result missing\")"
    }
    if !jet_rust_emit_pattern_capture_descriptor(function, matched, index) {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR pattern capture index has no descriptor", "checked pattern captures must reference one typed hole or binary rest descriptor from their match producer", Val(function.span))
        return "unreachable!(\"MIR pattern capture descriptor missing\")"
    }
    "({jet_rust_emit_value_reference(matched, false)}).as_ref().unwrap_or_else(|_| unreachable!(\"MIR pattern capture unavailable\")).{index}.clone()"
}

fn jet_rust_emit_view_copy(ctx: &JetRustEmitContext, function: MIRFunction, value: MIRValueID, result: MIRValueID?) -> String Never! {
    source :: jet_rust_emit_value_type(function, value)
    kind :: mir_view_copy_kind(source) ?? {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR view materialization source has no canonical copy kernel", "checked MaterializeView sources must be String, View<T>, List<T>, or FixedList<T>", Val(function.span))
        return "unreachable!(\"invalid MIR view materialization source\")"
    }
    symbol :: mir_view_copy_symbol(kind)
    if result == .Val(result_id) {
        target :: jet_rust_emit_value_type(function, result_id)
        if !mir_view_copy_target_matches(kind, target) {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR view materialization destination does not own the source window", "checked view materialization must target String or List<T> according to its source kernel", Val(function.span))
            return "unreachable!(\"invalid MIR view materialization destination\")"
        }
    }
    "{symbol}({jet_rust_emit_value_read(value)})"
}

// MIRRust is_shared_guard_type: the named expert lock token, through tags.
fn jet_rust_emit_is_shared_guard_type(ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .Tagged(_, inner) -> return jet_rust_emit_is_shared_guard_type(inner)
        .Apply(name, _) -> return name.name == "SharedGuard"
        else -> return false
    }
}

// MIRRust Deref: every pointer read goes through the memory sentry; a shared
// guard derefs to its guarded value, borrowed from the guard's own place.
fn jet_rust_emit_deref(ctx: &JetRustEmitContext, function: MIRFunction, value: MIRValueID) -> String Never! {
    if !jet_rust_emit_is_shared_guard_type(jet_rust_emit_value_type(function, value)) -> return "jet_mem::jet_sentry_read(({jet_rust_emit_value_read(value)}), \"valid_ptr\")"
    guard := jet_rust_emit_value_reference(value, false)
    if jet_rust_emit_find_value_instruction(function, value) == .Val(instruction) {
        if instruction.operation == {
            .AddressOf(place, _) | .ReadPlace(place) -> guard = jet_rust_emit_place_reference(&ctx, function, place, MIRAccess.Read)
            else -> {}
        }
    }
    "jet_mem::jet_sentry_read((&**({guard})) as *const _, \"valid_ptr\")"
}

fn jet_rust_emit_copy(ctx: &JetRustEmitContext, function: MIRFunction, value: MIRValueID, materialize_view: Bool, result: MIRValueID?) -> String Never! {
    if materialize_view -> jet_rust_emit_view_copy(&ctx, function, value, result) else -> jet_rust_emit_value_read(value)
}

// MIRRust native_int_result: a native-word kernel result re-enters the exact
// Int carrier, through refinements, carriers, tuples, lists and count maps.
fn jet_rust_emit_native_int_result(ctx: &JetRustEmitContext, value: String, ty: MIRType) -> String? {
    root :: ~ctx.config.root_prefix
    if ty.kind == {
        .Tagged(marker, inner) -> {
            if marker == (MIRTagMarker.Internal{internal_tag: MIRInternalTag.AllocatorView}) -> return None
            return jet_rust_emit_native_int_result(&ctx, value, inner)
        }
        .Int -> return Val("{root}jet_std::jet_int_owned_from_native_result({value})")
        .InlineRange(base, _, _) | .Quantity(base, _) -> return jet_rust_emit_native_int_result(&ctx, value, base)
        .Option(inner) -> {
            converted :: jet_rust_emit_native_int_result(&ctx, "__jet_value", inner) ?? return None
            return Val("({value}).map(|__jet_value| {converted})")
        }
        .Result(ok, err) -> {
            ok_text :: jet_rust_emit_native_int_result(&ctx, "__jet_value", ok)
            err_text :: jet_rust_emit_native_int_result(&ctx, "__jet_error", err)
            if ok_text == .Val(ok_converted) {
                if err_text == .Val(err_converted) -> return Val("({value}).map(|__jet_value| {ok_converted}).map_err(|__jet_error| {err_converted})")
                return Val("({value}).map(|__jet_value| {ok_converted})")
            }
            if err_text == .Val(err_converted) -> return Val("({value}).map_err(|__jet_error| {err_converted})")
            return None
        }
        .Tuple(fields) -> {
            converted_any := false
            values := [String]{}
            loop (index, field) in fields {
                original :: "__jet_value.{index}"
                if jet_rust_emit_native_int_result(&ctx, original, field.ty) == .Val(converted) {
                    converted_any = true
                    &values.push(converted)
                } else {
                    &values.push(original)
                }
            }
            if !converted_any -> return None
            rendered :: if values.len() == 1 -> "{values[0]}," else -> values.join(", ")
            return Val("{{ let __jet_value = {value}; ({rendered}) }}")
        }
        .List(inner) -> {
            converted :: jet_rust_emit_native_int_result(&ctx, "__jet_value", inner) ?? return None
            return Val("({value}).into_iter().map(|__jet_value| {converted}).collect::<Vec<_>>()")
        }
        .Map(_, inner) -> {
            if inner.kind == MIRTypeKind.Int -> return Val("{root}jet_std::jet_int_map_owned_from_native_result({value})")
            return None
        }
        else -> return None
    }
}

// MIRRust MirLoopSourceKind::wire: the length-prefixed canonical source fact
// the five-argument iterator Prelude ABI decodes.
fn jet_rust_emit_loop_source_wire(kind: MIRLoopSourceKind) -> String Never! {
    if kind == {
        .Plain -> "plain"
        .Chars -> "chars"
        .LinesFile -> "lines:file"
        .LinesStdin -> "lines:stdin"
        .LinesProcessStream -> "lines:process"
        .ChannelReceiver -> "channel"
        .EncodingReader(reader_type) -> "encoding:{reader_type.bytes().len()}:{reader_type}"
        .Iterable(coll_type, iter_type, iter_symbol, next_symbol) -> "iterable:{coll_type.bytes().len()}:{coll_type}:{iter_type.bytes().len()}:{iter_type}:{iter_symbol.bytes().len()}:{iter_symbol}:{next_symbol.bytes().len()}:{next_symbol}"
    }
}

fn jet_rust_emit_loop_source_kind(kind: MIRLoopSourceKind) -> String Never! {
    "JetLoopSourceKind::from_wire({jet_rust_emit_quote(jet_rust_emit_loop_source_wire(kind))}).unwrap_or_else(|| jet_panic(\"<core.prelude>\", 0, \"invalid canonical loop source wire\"))"
}

// MIRRust byte_loop_collection: a borrowed `[U8]` loop walks the byte slice.
fn jet_rust_emit_byte_loop_collection(ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .List(inner) | .FixedList(inner, _) -> inner.kind == (MIRTypeKind.IntN{signed: false, bits: 8})
        .Tagged(_, inner) -> jet_rust_emit_byte_loop_collection(inner)
        else -> false
    }
}

fn jet_rust_emit_byte_loop_cursor(function: MIRFunction, cursor: MIRValueID) -> Bool Never! {
    if jet_rust_emit_value_type(function, cursor).kind == {
        .Apply(name, _) -> name.name == "ByteIterCursor"
        else -> false
    }
}

// MIRRust prelude_cursor_call: cursor routes take exactly one borrowed cursor.
fn jet_rust_emit_prelude_cursor_call(ctx: &JetRustEmitContext, function: MIRFunction, call: MIRPreludeCallID, cursor: MIRValueID, access: MIRAccess) -> String Never! {
    route :: jet_rust_emit_prelude_row(&ctx, call) ?? return "unreachable!(\"missing Prelude route\")"
    if route.signature.arity != 1 || route.signature.borrow_mask.len() != 1 || !route.signature.borrow_mask[0] {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR cursor route must have one borrowed cursor argument", "checked loop cursor routes borrow their cursor exactly once", Val(function.span))
        return "unreachable!(\"MIR cursor route ABI\")"
    }
    cursor_text :: if access == {
        .Read -> jet_rust_emit_value_reference(cursor, false)
        .Write -> jet_rust_emit_value_reference(cursor, true)
        .Move -> jet_rust_emit_value_move(cursor)
    }
    jet_rust_emit_prelude_args_exact(&ctx, function, call, [String]{cursor_text})
}

fn jet_rust_emit_operation(ctx: &JetRustEmitContext, function: MIRFunction, operation: MIROperation, result: MIRValueID?, location: MIRPanicLoc?) -> String Never! {

    if operation == {
        .Parameter(index, _) -> {
            // A window parameter is a `&mut [T]` slice; its whole read is an owned copy.
            if jet_rust_emit_window_param(ctx, function.id, index) -> return "(*{jet_rust_emit_parameter_name(function, index)}).to_vec()"
            return jet_rust_emit_parameter_expression(function, index, jet_rust_emit_find_parameter(function, index).access)
        }
        .Capture(slot) -> return jet_rust_emit_capture_expression(function, slot, MIRAccess.Read)
        .Global(name) -> return jet_rust_emit_global_symbol(&ctx, name)
        .Phi(incoming) -> {
            rows := [String]{}
            loop row in incoming -> &rows.push("{jet_rust_emit_block_id(row.block)} => {jet_rust_emit_value_move(row.value)}")
            return "match {jet_rust_emit_previous_slot()} {{ {rows.join(", ")}, _ => unreachable!(\"invalid MIR phi predecessor\") }}"
        }
        .ReadPlace(place) -> return jet_rust_emit_place_read(&ctx, function, place)
        .MovePlace(place) -> return jet_rust_emit_place_move(&ctx, function, place)
        .WritePlace(_, _) -> return "()"
        .ReplacePlace(_, _) -> return "()"
        .InitializeUninit(_) -> return "()"
        .Copy(value, materialize_view) -> return jet_rust_emit_copy(&ctx, function, value, materialize_view, result)
        .Move(value) -> return jet_rust_emit_value_move(value)
        .Constant(value) -> return jet_rust_emit_constant(&ctx, value, jet_rust_emit_value_type(function, result ?? MIRValueID{value: 0}))
        .Unary(op, value) -> return jet_rust_emit_unary(&ctx, function, op, value)
        .Binary(op, dispatch, _, left, right) -> return jet_rust_emit_binary(&ctx, function, op, dispatch, left, right, location)
        .BuildString(parts) -> return jet_rust_emit_build_string(function, parts)
        .BuildList(values, trait_coercion) -> {
            rendered := [String]{}
            target_ty := MIRType?{None}
            if trait_coercion == .Val(trait_id) {
                target_ty = jet_rust_emit_checked_trait_box_target(&ctx, trait_id, Val(function.span))
            }
            loop value in values {
                source := jet_rust_emit_value_move(value)
                if target_ty == .Val(target) {
                    source_ty := jet_rust_emit_value_type(function, value)
                    action := jet_rust_emit_trait_box_source_needs_box(&ctx, source_ty, target, Val(function.span))
                    if action == (Val(true)) -> source = "Box::new({source}) as {jet_rust_emit_type(&ctx, target)}"
                }
                &rendered.push(source)
            }
            if result == .Val(result_id) {
                if jet_rust_emit_value_type(function, result_id).kind == {
                    .FixedList(_, _) -> return "[{rendered.join(", ")}]"
                    else -> return "vec![{rendered.join(", ")}]"
                }
            }
            return "vec![{rendered.join(", ")}]"
        }
        .BuildMap(entries) -> {
            rendered := [String]{}
            loop entry in entries -> &rendered.push("({jet_rust_emit_value_move(entry.key)}, {jet_rust_emit_value_move(entry.value)})")
            return "[{rendered.join(", ")}].into_iter().collect::<{ctx.config.root_prefix}JetMap<_,_>>()"
        }
        .EnumIs(subject, owner, variant) -> return jet_rust_emit_enum_is(&ctx, subject, owner, variant)
        .EnumPayload(subject, owner, variant, index) -> return jet_rust_emit_enum_payload(&ctx, function, result, subject, owner, variant, index)
        .OptionIsSome(subject) | .ResultIsOk(subject) | .PatternMatched(subject) -> return "matches!({jet_rust_emit_value_reference(subject, false)}, Ok(_))"
        .OptionValue(subject) -> return "match {jet_rust_emit_value_move(subject)} {{ Ok(value) => value, Err(_) => unreachable!(\"MIR option payload missing\") }}"
        .ResultValue(subject, ok) -> {
            if ok -> return "match {jet_rust_emit_value_move(subject)} {{ Ok(value) => value, Err(_) => unreachable!(\"MIR result success payload missing\") }}"
            return "match {jet_rust_emit_value_move(subject)} {{ Ok(_) => unreachable!(\"MIR result error payload missing\"), Err(error) => error }}"
        }
        .Struct(type_id, fields) -> {
            builtin :: jet_rust_emit_compiler_builtin_for_type(&ctx, type_id)
            if builtin == {
                .Val(value) -> {
                    if value == {
                        .DefaultErr -> return jet_rust_emit_default_err_struct(&ctx, type_id, fields)
                        else -> {}
                    }
                }
                else -> {}
            }
            return jet_rust_emit_struct_literal(&ctx, type_id, fields)
        }
        .PatternCapture(matched, index) -> return jet_rust_emit_pattern_capture(&ctx, function, matched, index, result)
        .ProjectMembers(base, members) -> {
            expression := jet_rust_emit_value_read(base)
            loop member in members -> expression = "({expression}).{jet_rust_emit_field_name(&ctx, member)}"
            return expression
        }
        .Index(call, base, index, kind, access, panic_location, context) -> return jet_rust_emit_index(&ctx, function, call, base, index, kind, access, panic_location, context)
        .Slice(call, base, start, end, range, panic_location) -> return jet_rust_emit_slice(&ctx, function, call, base, start, end, range, panic_location)
        .Range(start, end, exclusive) -> return "{jet_rust_emit_native_int_argument(&ctx, jet_rust_emit_value_read(start), None)}{if exclusive -> ".." else -> "..="}{jet_rust_emit_native_int_argument(&ctx, jet_rust_emit_value_read(end), None)}"
        .Field(base, field) -> return jet_rust_emit_field_read(&ctx, function, base, field)
        .Enum(type_id, variant, args) -> return jet_rust_emit_enum_value(&ctx, function, type_id, variant, args, location)
        .Tuple(_, fields) -> {
            rendered := [String]{}
            loop field in fields -> &rendered.push(jet_rust_emit_value_move(field.value))
            if rendered.len() == 1 -> return "({rendered[0]},)"
            return "({rendered.join(", ")})"
        }
        .Present(value) -> return "Ok({jet_rust_emit_value_move(value)})"
        .ResultOk(value) -> return "Ok({jet_rust_emit_value_move(value)})"
        .Absent -> return "{ctx.config.root_prefix}JetOutcome::Err({ctx.config.root_prefix}JetAbsent)"
        .ResultErr(value) -> return "Err({jet_rust_emit_value_move(value)})"
        .Call(callee, args, type_args) -> return jet_rust_emit_call(&ctx, function, callee, args, type_args, result)
        .IndirectCall(callee, args, type_args) -> return jet_rust_emit_call(&ctx, function, MIRCallee.Indirect{value: callee}, args, type_args, result)
        .Closure(target, captures, _) -> return jet_rust_emit_closure(&ctx, function, target, captures, result)
        .Convert(value, parameters, target, conversion) -> return jet_rust_emit_conversion(&ctx, function, value, parameters, target, conversion)
        .TraitBox(value, target) -> {
            target_ty :: jet_rust_emit_checked_trait_box_target(&ctx, target, Val(function.span)) ?? return "unreachable!(\"MIR trait boxing target is invalid\")"
            source_ty := jet_rust_emit_value_type(function, value)
            action := jet_rust_emit_trait_box_source_needs_box(&ctx, source_ty, target_ty, Val(function.span))
            if action == None -> return "unreachable!(\"MIR trait boxing source is invalid\")"
            if action != (Val(true)) {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR trait boxing source is already a trait object", "checked TraitBox operations consume concrete values and must not rebox an existing trait object", Val(function.span))
                return "unreachable!(\"MIR trait boxing source is already dynamic\")"
            }
            return "Box::new({jet_rust_emit_value_move(value)}) as {jet_rust_emit_type(&ctx, target_ty)}"
        }
        .PtrFromAddr(address, element) -> {
            address_text := jet_rust_emit_value_read(address)
            if jet_rust_emit_value_type(function, address).kind == MIRTypeKind.Int -> address_text = jet_rust_emit_native_int_argument(&ctx, address_text, location)
            return "({address_text} as usize as *mut {jet_rust_emit_type(&ctx, element)})"
        }
        .Deref(value) -> return jet_rust_emit_deref(&ctx, function, value)
        .RawAddressOf(place) -> return "(&mut {jet_rust_emit_place_lvalue(&ctx, function, place)} as *mut _)"
        .AddressOf(place, access) -> return jet_rust_emit_place_reference(&ctx, function, place, access)
.CoreCall(call, route, args, type_args, fallibility, data_plan) -> return jet_rust_emit_core_operation(&ctx, function, call, route, args, type_args, fallibility, data_plan, result)
        .AttachTag(value, _) -> return jet_rust_emit_value_move(value)
        .Semantic(semantic) -> {
            if semantic == {
                .DataEntriesToMap(call, local) -> return jet_rust_emit_route_call(&ctx, call, [String]{jet_rust_emit_place_local(function, local, false)})
                .MathBuiltin(_, call, args) | .PreciseBuiltin(_, call, args) -> return jet_rust_emit_semantic_values(&ctx, function, call, args)
                .Print(call, value) -> return jet_rust_emit_print(&ctx, function, call, value)
                .AmbientInput(call, prompt) -> return jet_rust_emit_ambient_input(&ctx, function, call, prompt)
                .LayoutCompare(call, op, left, right) -> return "{jet_rust_emit_semantic_values(&ctx, function, call, [MIRValueID]{left, right})} /* layout_compare={jet_rust_emit_layout_compare_name(op)} */"
                .LayoutLiteral(inner) -> return "{ctx.config.root_prefix}jet_layout::LinExpr::from_const(({jet_rust_emit_value_read(inner)}) as f64)"
                .ConditionNotify(call, condition, all) -> return jet_rust_emit_route_call(&ctx, call, [String]{jet_rust_emit_value_move(condition), if all -> "true" else -> "false"})
                .AllocNew(call, _, _, args) -> {
                    rendered := [String]{}
                    loop arg in args -> &rendered.push(jet_rust_emit_call_arg(&ctx, function, arg))
                    return jet_rust_emit_route_call(&ctx, call, rendered)
                }
                .StaticPreludeCall(call, args, _, type_args) -> return jet_rust_emit_prelude_call(&ctx, function, call, args, type_args)
                .DecodeUnder(call, segment, inner) -> return jet_rust_emit_semantic_values(&ctx, function, call, [MIRValueID]{segment, inner})
                .HardwareCall(call, op, receiver, args) -> return jet_rust_emit_hardware_call(&ctx, function, call, op, receiver, args)
                .BuiltinMethod(call, receiver, _, args, _) -> {
                    values := [MIRValueID]{receiver}
                    loop arg in args -> &values.push(arg)
                    return jet_rust_emit_semantic_values(&ctx, function, call, values)
                }
                .NumericMethod(call, receiver) -> return jet_rust_emit_semantic_values(&ctx, function, call, [MIRValueID]{receiver})
                .NumericBinaryMethod(call, receiver, argument) -> return jet_rust_emit_semantic_values(&ctx, function, call, [MIRValueID]{receiver, argument})
                .OverflowOption(call, left, right, overflow_location) -> return jet_rust_emit_overflow_option(&ctx, function, call, left, right, overflow_location)
                .HandleMethod(call, receiver, args, _, _) -> {
                    values := [MIRValueID]{receiver}
                    loop arg in args -> &values.push(arg)
                    return jet_rust_emit_semantic_values(&ctx, function, call, values)
                }
                .CoreClosureCall(call, kind, values, closure, _, _) -> return jet_rust_emit_core_closure_call(&ctx, function, call, kind, values, closure)
                .TaskGroup(call, kind, tasks) -> return jet_rust_emit_task_group(&ctx, function, call, kind, tasks)
                .Select(call, kind, values) -> return jet_rust_emit_select(&ctx, function, call, kind, values)
                .PolicyFunction(policy, values) -> return jet_rust_emit_value_call(policy, values)
                .InterruptFunction(interrupt, values) -> return jet_rust_emit_value_call(interrupt, values)
                .ColumnarRead(base, index, column, column_index, accessor) -> {
                    loc :: location ?? MIRPanicLoc{file: function.source_file, line: 0, column: 0}
                    return jet_rust_emit_columnar_read(&ctx, function, base, index, column, column_index, accessor, loc)
                }
                .CCallback(_, callback, lambda) -> return jet_rust_emit_callback_handler(&ctx, function, callback, lambda)
                .HostCall(call, args) -> return jet_rust_emit_prelude_call(&ctx, function, call, args, [MIRType]{})
                .StructLiteral(type_id, fields, _, trait_coercion, boxed_fields) -> {
                    rendered := [String]{}
                    loop field in fields {
                        value := jet_rust_emit_value_move(field.value)
                        loop boxed in boxed_fields { if boxed == field.field -> value = "Box::new({value})" }
                        &rendered.push("{jet_rust_emit_field_name(&ctx, field.field)}: {value}")
                    }
                    value := "{jet_rust_emit_type_name(&ctx, type_id)} {{ {rendered.join(", ")} }}"
                    if trait_coercion == .Val(trait_id) -> return "Box::new({value}) as {jet_rust_emit_trait_object_type(&ctx, trait_id)}"
                    return value
                }
                .ReflectOf(type_name, path, display, fields) -> {
                    rendered := [String]{}
                    loop field in fields {
                        &rendered.push("jet_reflect_field_new({jet_rust_emit_quote(field.name)}.to_string(), jet_reflect_value_from_field(&({jet_rust_emit_value_read(field.value)}), {jet_rust_emit_quote(field.type_name)}.to_string(), {jet_rust_emit_quote(field.path)}.to_string()))")
                    }
                    return "jet_reflect_value_finish({jet_rust_emit_quote(type_name)}.to_string(), {jet_rust_emit_quote(path)}.to_string(), {jet_rust_emit_value_read(display)}, vec![{rendered.join(", ")}])"
                }
                .RequireStop(call, kind, condition, stop_location, context, values, _) -> return jet_rust_emit_require_stop(&ctx, function, call, kind, condition, stop_location, context, values)
                .SharedGuardWait(call, guard, condition, predicate) -> return jet_rust_emit_semantic_values(&ctx, function, call, [MIRValueID]{guard, condition, predicate})
                .CellGuardProject(map_call, split_call, guard, paths, editable, disjoint) -> {
                    if paths.len() == 1 -> return jet_rust_emit_shared_guard_map(&ctx, function, map_call, guard, paths[0], editable)
                    if paths.len() == 2 {
                        if editable && !disjoint {
                            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR editable cell guard split paths overlap", "editable guard split paths must be disjoint by the checked guard contract", Val(function.span))
                            return "unreachable!(\"overlapping cell guard paths\")"
                        }
                        if split_call == None {
                            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR cell guard split route is missing", "checked two-path cell guards must carry their split Prelude route", Val(function.span))
                            return "unreachable!(\"missing cell guard split route\")"
                        }
                        return jet_rust_emit_shared_guard_split(&ctx, function, split_call, map_call, guard, paths[0], paths[1], editable)
                    }
                    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR cell guard path count is invalid", "checked cell guard projections have exactly one or two paths", Val(function.span))
                    return "unreachable!(\"invalid cell guard paths\")"
                }
                .SharedGuardMap(call, guard, path, editable) -> return jet_rust_emit_shared_guard_map(&ctx, function, call, guard, path, editable)
                .SharedGuardSplit(call, map_call, guard, first, second, editable) -> return jet_rust_emit_shared_guard_split(&ctx, function, call, map_call, guard, first, second, editable)
                .OptionLift2(call, callback, left, right) -> {
                    route_args := [String]{jet_rust_emit_value_read(callback), "left", "right"}
                    emitted :: jet_rust_emit_route_call(&ctx, call, route_args)
                    return "match ({jet_rust_emit_value_read(left)}, {jet_rust_emit_value_read(right)}) {{ (Ok(left), Ok(right)) => {emitted}, _ => Err({ctx.config.root_prefix}JetAbsent) }}"
                }
                .ClosureMethod(callable, args, call) -> {
                    values := [MIRValueID]{callable}
                    loop arg in args -> &values.push(arg.value)
                    return jet_rust_emit_semantic_values(&ctx, function, call, values)
                }
                .HostBorrowCallback(callable, params) -> return jet_rust_emit_host_callback(&ctx, function, callable, params)
                .PluginInvoke(call, handle, _, _, args) -> {
                    values := [MIRValueID]{handle}
                    loop arg in args -> &values.push(arg)
                    return jet_rust_emit_semantic_values(&ctx, function, call, values)
                }
                .HTTPRouterRegister(call, receiver, path, handler, method, handler_param_names, contract, http_location) -> return jet_rust_emit_http_router_register(&ctx, function, call, receiver, path, handler, method, handler_param_names, contract, http_location)
                .TextPatternMatch(call, subject, parts) -> return jet_rust_emit_text_pattern_match(&ctx, function, call, subject, parts, result)
                .BinaryPatternMatch(call, subject, parts) -> return jet_rust_emit_binary_pattern_match(&ctx, function, call, subject, parts, result)
                .CursorTakePattern(_, receiver_place, parts) -> return jet_rust_emit_cursor_take_pattern(&ctx, function, receiver_place, parts, result)
                .ReaderTakePattern(_, receiver_place, parts) -> return jet_rust_emit_reader_take_pattern(&ctx, function, receiver_place, parts, result)
                .GCEdit(call, root, edges, edit, index, kind, site) -> return jet_rust_emit_gc_edit(&ctx, function, call, root, edges, edit, index, kind, site)
                .TypedTextInterp(call, kind, literals, holes, trusted_html) -> return jet_rust_emit_typed_text_interp(&ctx, function, call, kind, literals, holes, trusted_html)
                .CarrierFact(call, receiver, field, _) -> return "{jet_rust_emit_prelude_symbol(&ctx, call)}(&({jet_rust_emit_value_read(receiver)}), |__jet_report| __jet_report.{jet_rust_emit_field_name(&ctx, field)}.clone())"
                else -> {}
            }
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR semantic operation has no Jet source adapter", "semantic operations must retain one checked source-emission adapter before Rust source generation", Val(function.span))
            return "unreachable!(\"unsupported MIR semantic operation\")"
        }
        .Todo(call, todo_location, expected_type) -> {
            emitted :: jet_rust_emit_route_call(&ctx, call, [String]{})
            expected :: if expected_type == .Val(ty) -> jet_rust_emit_type(&ctx, ty) else -> "()"
            return "{{ let _: {expected} = {emitted}; unreachable!(\"MIR Todo at {todo_location.file.value}:{todo_location.line}:{todo_location.column}\") }}"
        }
        .Never(reason) -> return "unreachable!({jet_rust_emit_quote(reason)})"
        .LoopRangeInit(call, start, end, step, exclusive) -> {
            loc :: location ?? {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR range cursor is missing its instruction source location", "checked range cursors carry the location their host-range trap reports", Val(function.span))
                return "unreachable!(\"MIR range cursor location\")"
            }
            step_text :: if step == .Val(step_value) -> jet_rust_emit_index_operand(&ctx, function, step_value, loc) else -> "0"
            args :: [String]{jet_rust_emit_index_operand(&ctx, function, start, loc), jet_rust_emit_index_operand(&ctx, function, end, loc), step_text, if step != None -> "true" else -> "false", if exclusive -> "true" else -> "false"}
            return jet_rust_emit_prelude_args_exact(&ctx, function, call, args)
        }
        .LoopRangeHasNext(call, cursor) -> return jet_rust_emit_prelude_cursor_call(&ctx, function, call, cursor, MIRAccess.Read)
        .LoopRangeValue(call, cursor) -> {
            emitted :: jet_rust_emit_prelude_cursor_call(&ctx, function, call, cursor, MIRAccess.Read)
            result_id :: result ?? return emitted
            return jet_rust_emit_native_int_result(&ctx, emitted, jet_rust_emit_value_type(function, result_id)) ?? emitted
        }
        .LoopRangeAdvance(call, cursor) -> return jet_rust_emit_prelude_cursor_call(&ctx, function, call, cursor, MIRAccess.Write)
        .LoopIterInit(call, collection, step, by_value, source_kind) -> {
            loc :: location ?? {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR iterator cursor is missing its instruction source location", "checked iterator cursors carry the location their host-range trap reports", Val(function.span))
                return "unreachable!(\"MIR iterator cursor location\")"
            }
            byte_loop :: !by_value && source_kind == MIRLoopSourceKind.Plain && jet_rust_emit_byte_loop_collection(jet_rust_emit_value_type(function, collection))
            collection_text :: if by_value -> jet_rust_emit_value_move(collection) else -> jet_rust_emit_value_reference(collection, true)
            step_text :: if step == .Val(step_value) -> jet_rust_emit_index_operand(&ctx, function, step_value, loc) else -> "0"
            has_step :: if step != None -> "true" else -> "false"
            if byte_loop -> return "jet_loop_iter_bytes_init(({collection_text}).as_slice(), {step_text}, {has_step})"
            args :: [String]{collection_text, step_text, has_step, if by_value -> "true" else -> "false", jet_rust_emit_loop_source_kind(source_kind)}
            return jet_rust_emit_prelude_args_exact(&ctx, function, call, args)
        }
        .LoopIterHasNext(call, cursor) -> {
            if jet_rust_emit_byte_loop_cursor(function, cursor) -> return "jet_loop_iter_bytes_has_next({jet_rust_emit_value_reference(cursor, false)})"
            return jet_rust_emit_prelude_cursor_call(&ctx, function, call, cursor, MIRAccess.Read)
        }
        .LoopIterValue(call, cursor) -> {
            if jet_rust_emit_byte_loop_cursor(function, cursor) -> return "jet_loop_iter_bytes_value({jet_rust_emit_value_reference(cursor, true)})"
            return jet_rust_emit_prelude_cursor_call(&ctx, function, call, cursor, MIRAccess.Write)
        }
        .LoopIterAdvance(call, cursor) -> {
            if jet_rust_emit_byte_loop_cursor(function, cursor) -> return "jet_loop_iter_bytes_advance({jet_rust_emit_value_reference(cursor, true)})"
            return jet_rust_emit_prelude_cursor_call(&ctx, function, call, cursor, MIRAccess.Write)
        }
        .ScopeEnter(scope, member) -> return jet_rust_emit_scope_enter(&ctx, function, scope, member)
        .ScopeExit(scope) -> return jet_rust_emit_scope_exit(&ctx, function, scope)
        .Drop(value, kind) -> return jet_rust_emit_drop_value(&ctx, function, value, kind)
    }
}
