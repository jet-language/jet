        name == "jet_std::JetMeasurement::value" -> Val("jet_measurement_value")
        name == "jet_std::JetMeasurement::uncertainty" -> Val("jet_measurement_uncertainty")
        name == "jet_std::JetSignal::new" -> Val("jetDom.makeSignal")
        name == "jet_std::JetSignal::get" -> Val("jetDom.signalGet")
        name == "jet_std::JetSignal::set" -> Val("jetDom.signalSet")
        name == "jet_ui_reactive_render" -> Val("jetDom.reactiveRender")
        name == "jet_ui_null" -> Val("jetDom.createBackend")
        name == "JetNullBackend::mount_node" -> Val("jetDom.mount")
        name == "JetNullBackend::paint_commands" -> Val("jetDom.commands")
        name == "jet_testing_histories" -> Val("jet_testing_histories")
        name == "jet_testing_status" -> Val("jet_testing_status")
        name == "jet_testing_assert_equal" -> Val("jet_testing_assert_equal")
        name == "jet_world_now" -> Val("jet_world_now")
        name == "jet_world_advance" -> Val("jet_world_advance")
        name == "jet_world_wait_idle" -> Val("jet_world_wait_idle")
        name == "jet_world_history" -> Val("jet_world_history")
        name == "jet_transaction_on_commit" -> Val("jet_transaction_on_commit")
        name == "jet_transaction_on_rollback" -> Val("jet_transaction_on_rollback")
        name == "jet_data_track" -> Val("jet_data_track")
        name == "jet_data_query" -> Val("jet_data_query")
        name == "jet_data_count" -> Val("jet_data_count")
        name == "jet_data_load" -> Val("jet_data_loader_load")
        name == "jet_data_loader_load" -> Val("jet_data_loader_load")
        name == "jet_data_loader_file" -> Val("jet_data_loader_file")
        name == "jet_data_loader_url" -> Val("jet_data_loader_url")
        name == "jet_data_stream_next" -> Val("jet_data_stream_next")
        name == "jet_data_stream_collect" -> Val("jet_data_stream_collect")
        name == "jet_fmt_display" -> Val("jet_display")
        name == "jet_fmt_debug" -> Val("jet_debug")
        name == "jet_text_pattern_match" -> Val("jet_text_pattern_match")
        name == "jet_binary_pattern_match" -> Val("jet_binary_pattern_match")
        name == "jet_cursor_take_pattern" -> Val("jet_cursor_take_pattern")
        name == "jet_web_stream_commit" -> Val("jetDom.webStreamCommit")
        name == "jet_web_stream_begin" -> Val("jetDom.webStreamBegin")
        name == "jet_web_stream_fail" -> Val("jetDom.webStreamFail")
