// JavaScript lowering for the Web partition.  This file intentionally keeps
// the MIR operation match exhaustive: an operation is either lowered through a
// checked runtime/Prelude route or records an incomplete Web artifact.

fn jet_web_js_value(value: MirValueId) -> String Never! { "__jet_values.get({value.value})" }

fn jet_web_js_move(value: MirValueId) -> String Never! {
    "(() => {{ const moved = __jet_values.get({value.value}); __jet_values.set({value.value}, __jet_moved); const cell = __jet_cells.get({value.value}); if (cell) cell.value = __jet_moved; return moved; }})()"
}

fn jet_web_js_field_name(ctx: &JetWebEmitContext, field: MirFieldId) -> String Never! {
    if jet_web_find_field_name(ctx.program, field) == .Val(name) -> return name
    jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidMir, "E0003", "Web MIR field identity is missing", "checked field projections must resolve through the canonical field table", None)
    ""
}

fn jet_web_js_valid_identifier(value: String) -> Bool Never! {
    bytes :: value.bytes()
    if bytes.len() == 0 -> return false
    loop (index, byte) in bytes {
        code :: Int.from_u8(byte)
        if {
            index == 0 -> {
                if !((code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95 || code == 36) -> return false
            }
            !((code >= 65 && code <= 90) || (code >= 97 && code <= 122) || (code >= 48 && code <= 57) || code == 95 || code == 36) -> return false
            else -> {}
        }
    }
    true
}

fn jet_web_js_symbol_alias(name: String) -> String? {
    if {
        name == "jet_term_write_stdout_line" -> Val("jetDom.print")
        name == "jet_std::jet_typed_url_literal" -> Val("jet_typed_url_literal")
        name == "jet_std::jet_int_abs" -> Val("jet_int_abs")
        name == "jet_std::jet_int_add" -> Val("jet_int_add")
        name == "jet_std::jet_int_sub" -> Val("jet_int_sub")
        name == "jet_std::jet_int_mul" -> Val("jet_int_mul")
        name == "jet_std::jet_int_checked_widen" -> Val("jet_int_checked_widen")
        name == "jet_std::jet_int_try_from" -> Val("jet_int_try_from")
        name == "jet_std::jet_int_try_from_checked" -> Val("jet_int_try_from_checked")
        name == "jet_std::channel" -> Val("jet_channel_new")
        name == "jet_std::channel_bounded" -> Val("jet_channel_bounded")
        name == "jet_std::JetReceiver::receive" -> Val("jet_channel_receive")
        name == "jet_std::JetReceiver::try_receive" -> Val("jet_channel_try_receive")
        name == "jet_std::JetReceiver::close" -> Val("jet_channel_close")
        name == "jet_std::JetShared::new" -> Val("jet_shared_new")
