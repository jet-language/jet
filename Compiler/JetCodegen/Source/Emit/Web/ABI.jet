// WebAssembly boundary lowering for checked Web exports.  Collection values use
// the DOM runtime ABI; scalar values use the Wasm numeric ABI.  The checked MIR
// reconstruction rows are expanded here, never inferred from a source type.

fn jet_web_wasm_list_kind(ctx: &JetWebEmitContext, inner: MirType) -> ?String {
    if inner.kind == {
        .Int -> return Val("list-int")
        .String -> return Val("list-string")
        .IntN(signed, bits) -> {
            if signed && bits == 64 -> return Val("list-i64")
        }
        .InlineRange(base, _, _) -> return jet_web_wasm_list_kind(ctx, base)
        .Tagged(_, base) -> return jet_web_wasm_list_kind(ctx, base)
        .Quantity(base, _) -> return jet_web_wasm_list_kind(ctx, base)
        else -> {}
    }
    None
}

fn jet_web_wasm_abi_kind(ctx: &JetWebEmitContext, ty: MirType) -> ?String {
    if mir_type_is_unit(ty) -> return None
    if ty.kind == {
        .Int -> return Val("int")
        .String -> return Val("string")
        .List(inner) -> {
            kind := jet_web_wasm_list_kind(ctx, inner)
            if kind != None -> return kind
            jet_web_fail(ctx, JetWebEmitFailureKind.InvalidAbi, "E0003", "unsupported Web Wasm export collection type", mir_type_display_name(ty), None)
            return None
        }
        .Map(key, value) -> {
            if key.kind == MirTypeKind.String && value.kind == MirTypeKind.Int -> return Val("map-string-int")
            jet_web_fail(ctx, JetWebEmitFailureKind.InvalidAbi, "E0003", "unsupported Web Wasm export map type", mir_type_display_name(ty), None)
            return None
        }
        .InlineRange(base, _, _) -> return jet_web_wasm_abi_kind(ctx, base)
        .Tagged(_, base) -> return jet_web_wasm_abi_kind(ctx, base)
        .Quantity(base, _) -> return jet_web_wasm_abi_kind(ctx, base)
        .Float | .Bool | .Char | .IntN(_, _) | .Float32 -> return None
        else -> {
            jet_web_fail(ctx, JetWebEmitFailureKind.InvalidAbi, "E0003", "unsupported Web Wasm export boundary type", mir_type_display_name(ty), None)
            return None
        }
    }
}

fn jet_web_wasm_direct_argument(ctx: &JetWebEmitContext, value: String, ty: MirType) -> String {
    if ty.kind == {
        .Float | .Float32 -> return "Number({value})"
        .Bool -> return "Number(Boolean({value}))"
        .Char -> return "Number(String({value}).codePointAt(0))"
        .IntN(_, bits) -> {
            if bits <= 32 -> return "Number({value})"
            return "BigInt({value})"
        }
        .InlineRange(base, _, _) -> return jet_web_wasm_direct_argument(ctx, value, base)
        .Tagged(_, base) -> return jet_web_wasm_direct_argument(ctx, value, base)
        .Quantity(base, _) -> return jet_web_wasm_direct_argument(ctx, value, base)
        else -> {}
    }
    jet_web_fail(ctx, JetWebEmitFailureKind.InvalidAbi, "E0003", "unsupported direct Web Wasm export argument type", mir_type_display_name(ty), None)
    "undefined"
}

fn jet_web_wasm_direct_return(ctx: &JetWebEmitContext, raw: String, ty: MirType) -> String {
    if ty.kind == {
        .Float | .Float32 -> return "Number({raw})"
        .Bool -> return "Boolean(Number({raw}))"
        .Char -> return "String.fromCodePoint(Number({raw}))"
        .IntN(signed, bits) -> {
            mode := if signed -> "Int" else -> "Uint"
            return "BigInt.as{mode}N({bits}, BigInt({raw}))"
        }
        .InlineRange(base, _, _) -> return jet_web_wasm_direct_return(ctx, raw, base)
        .Tagged(_, base) -> return jet_web_wasm_direct_return(ctx, raw, base)
        .Quantity(base, _) -> return jet_web_wasm_direct_return(ctx, raw, base)
        else -> {}
    }
    jet_web_fail(ctx, JetWebEmitFailureKind.InvalidAbi, "E0003", "unsupported direct Web Wasm export return type", mir_type_display_name(ty), None)
    "undefined"
}

fn jet_web_wasm_argument(ctx: &JetWebEmitContext, value: String, ty: MirType) -> String {
    kind := jet_web_wasm_abi_kind(ctx, ty)
    if ctx.failure != None -> return "undefined"
    if kind != None -> return "jetDom.marshalAbi({value}, {jet_web_js_quote(kind ?? "")}, __jetPreludeWasm)"
    jet_web_wasm_direct_argument(ctx, value, ty)
}

fn jet_web_wasm_return(ctx: &JetWebEmitContext, raw: String, ty: MirType) -> String {
    kind := jet_web_wasm_abi_kind(ctx, ty)
    if ctx.failure != None -> return "undefined"
    if kind != None -> return "jetDom.unmarshalAbi({raw}, {jet_web_js_quote(kind ?? "")}, __jetPreludeWasm)"
    if mir_type_is_unit(ty) -> return "undefined"
    jet_web_wasm_direct_return(ctx, raw, ty)
}

fn jet_web_wasm_bridge_arguments(ctx: &JetWebEmitContext, function: MirFunction) -> [String] {
    values := [String]{}
    index := 0
    loop parameter in function.params {
        value := "args[{index}]"
        reconstruction := None
        loop row in function.web_param_reconstructions {
            if row.local == parameter.name -> reconstruction = Val(row)
        }
        if reconstruction != None {
            row :: reconstruction ?? return values
            loop field in row.fields {
                field_value := "({value})[{jet_web_js_quote(field.field)}]"
                values.push(jet_web_wasm_argument(ctx, field_value, field.ty))
            }
        } else {
            values.push(jet_web_wasm_argument(ctx, value, parameter.ty))
        }
        index += 1
    }
    values
}

fn jet_web_wasm_export_symbol(function: MirFunction) -> String { "jet_export_{function.name}" }
fn jet_web_wasm_bridge_name(function: MirFunction) -> String { "bridge_{function.name}" }

fn jet_web_wasm_export_success_type(function: MirFunction) -> MirType {
    if function.failure == {
        .Result(success, _) -> return success
        .Optional(value) -> return value
        .Infallible | .Diverges(_) -> return function.return_type
    }
}

fn jet_web_emit_wasm_export_bridge(ctx: &JetWebEmitContext, function: MirFunction, out: &[String]) {
    if !jet_web_is_wasm_export(function) || !jet_web_function_in_bucket(function, MirWebBucket.Wasm) -> return
    if function.form != MirFunctionForm.TopLevel || function.capture_params.len() != 0 {
        jet_web_fail(ctx, JetWebEmitFailureKind.InvalidExport, "E0003", "Web Wasm export is not a top-level capture-free function", function.name, Val(function.span))
        return
    }
    if function.generator != None {
        jet_web_fail(ctx, JetWebEmitFailureKind.InvalidExport, "E0003", "Web Wasm export cannot be a generator", function.name, Val(function.span))
        return
    }
    bridge := jet_web_wasm_bridge_name(function)
    symbol := jet_web_wasm_export_symbol(function)
    args := jet_web_wasm_bridge_arguments(ctx, function)
    if ctx.failure != None -> return
    result := jet_web_wasm_return(ctx, "raw", jet_web_wasm_export_success_type(function))
    if ctx.failure != None -> return
    out.push("async function {bridge}(...args) {{")
    out.push("  if (args.length !== {function.params.len()}) throw new TypeError({jet_web_js_quote("Web Wasm export {function.name} expects {function.params.len()} arguments")});")
    out.push("  const raw = __jetPreludeWasm.{symbol}({args.join(", ")});")
    out.push("  const outcome = jetDom.takeWasmError(__jetPreludeWasm);")
    out.push("  if (outcome?.tag === \"Host\") throw jet_web_wasm_host_error(outcome, null, Number(outcome.status ?? 101));")
    if function.failure == {
        .Result(_, _) | .Optional(_) -> {
            out.push("  if (outcome?.tag === \"Err\") return { tag: \"Err\", values: [outcome.error] };")
            out.push("  return { tag: \"Ok\", values: [{result}] };")
        }
        .Infallible | .Diverges(_) -> {
            out.push("  if (outcome) return jet_web_edge_result(outcome);")
            out.push("  return {result};")
        }
    }
    out.push("}")
    out.push("")
}

fn jet_web_emit_wasm_export_bridges(ctx: &JetWebEmitContext, functions: [MirFunction], out: &[String]) {
    names := [String]{}
    loop function in functions {
        if !jet_web_is_wasm_export(function) || !jet_web_function_in_bucket(function, MirWebBucket.Wasm) -> next
        loop name in names {
            if name == function.name {
                jet_web_fail(ctx, JetWebEmitFailureKind.InvalidExport, "E0003", "Web Wasm export has a duplicate JavaScript bridge name", function.name, Val(function.span))
                break
            }
        }
        names.push(function.name)
        jet_web_emit_wasm_export_bridge(ctx, function, &out)
    }
}
