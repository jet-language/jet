// CFG and module emission for the JavaScript Web partition.
use jet_foundation.[
    MIRAccess,
    MIRBasicBlock,
    MIRFunction,
    MIRModule,
    MIROperation,
    MIRParam,
    MIRRuntimePartID,
    MIRType,
    MIRWebBucket,
    mir_sha256_hex,
    mir_type_canonical_key,
]

fn jet_web_emit_js_terminator(ctx: &JetWebEmitContext, function: MIRFunction, block: MIRBasicBlock, out: &[String]) Never! {
    if block.terminator == {
        .Jump(target) -> {
            &out.push("        __jet_pred = __jet_block; __jet_block = {target.value}; continue;")
        }
        .Branch(condition, then_target, else_target) -> {
            &out.push("        __jet_pred = __jet_block; __jet_block = Boolean(__jet_values.get({condition.value})) ? {then_target.value} : {else_target.value}; continue;")
        }
        .Switch(subject, arms, otherwise) -> {
            // MIRWeb emit_js_terminator: read the subject once, then test the
            // arms in order.
            tests := [String]{}
            loop arm in arms -> &tests.push("__jet_subject === __jet_values.get({arm.condition.value}) ? {arm.target.value} : ")
            &out.push("        __jet_pred = __jet_block; const __jet_subject = __jet_values.get({subject.value}); __jet_block = {tests.join("")}{otherwise.value}; continue;")
        }
        .Return(value) -> {
            if value == .Val(id) {
                // MIRWeb js_return_expression: an Option return leaves no
                // dirty absent sentinel behind.
                returned := "__jet_values.get({id.value})"
                if function.return_type.kind == .Option(_) -> returned = "jet_clean_option({returned})"
                &out.push("        return {returned};")
                return
            }
            &out.push("        return undefined;")
        }
        .Yield(value, resume, _) -> {
            if {
                function.generator == None -> {
                jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidMIR, "E0003", "MIR Yield terminator has no generator facts", "checked generator functions must retain generator metadata", Val(function.span))
                }
                else -> {
                &out.push("        yield __jet_values.get({value.value}); __jet_pred = __jet_block; __jet_block = {resume.value}; continue;")
                }
            }
        }
        .Break(target, value) -> {
            if value == .Val(id) -> &out.push("        __jet_break_value = __jet_values.get({id.value});")
            &out.push("        __jet_pred = __jet_block; __jet_block = {target.value}; continue;")
        }
        .Continue(target) -> &out.push("        __jet_pred = __jet_block; __jet_block = {target.value}; continue;")
        .Unreachable(reason) -> &out.push("        throw new Error({jet_web_js_quote(reason)});")
    }
}

// MIRWeb js_persist_live_value_update: under the local devtools rail, a write
// to a persistent place publishes its new value (scalar text forms only).
fn jet_web_js_persist_type_renderable(ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .Int | .Float | .Bool | .String | .Char | .IntN(_, _) | .Float32 | .Measure(_) -> return true
        .InlineRange(base, _, _) | .Tagged(_, base) | .Quantity(base, _) -> return jet_web_js_persist_type_renderable(base)
        else -> return false
    }
}

fn jet_web_js_persist_live_value_update(ctx: &JetWebEmitContext, function: MIRFunction, operation: MIROperation) -> String? {
    if !ctx.config.release_devtools_policy.local_rail -> return None
    if operation == {
        .WritePlace(place_id, _) -> {
            loop place in function.places {
                if place.id == place_id {
                    key :: place.persist_key ?? return None
                    rendered :: if jet_web_js_persist_type_renderable(place.ty) -> "String({jet_web_js_read_place(&ctx, function, place_id)})" else -> "null"
                    return Val("jetDom.publishLiveValueUpdate({jet_web_js_quote(key)}, {jet_web_js_quote(mir_type_canonical_key(place.ty))}, {rendered});")
                }
            }
            jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidMIR, "E0003", "Web MIR place is missing", "persistent place writes must resolve one checked place row", Val(function.span))
            return None
        }
        else -> return None
    }
}

fn jet_web_emit_js_function(ctx: &JetWebEmitContext, function: MIRFunction, out: &[String]) {
    if !jet_web_function_in_bucket(function, MIRWebBucket.JS) -> return
    keyword :: if function.generator != None -> "async function*" else -> "async function"
    &out.push("{keyword} jet_fn_{function.id.value}(__jet_env, __jet_args) {{")
    &out.push("  const __jet_stack_frame = jet_stack_enter({jet_web_js_quote(jet_web_find_source_path(ctx.program, function.source_file) ?? "")}, {jet_web_source_line(ctx.program, function)}, {jet_web_js_quote(function.name)}, {jet_web_js_quote(jet_web_source_line(ctx.program, function))});")
    &out.push("  try {{")
    &out.push("    const __jet_values = new Map();")
    &out.push("    const __jet_cells = new Map();")
    &out.push("    const __jet_places = new Map();")
    &out.push("    const __jet_transactions = [];")
    &out.push("    const __jet_moved = Symbol.for(\"jet.moved\");")
    &out.push("    let __jet_break_value = undefined;")
    loop place in function.places {
        if place.base == {
            .Local(_) -> &out.push("    __jet_places.set({place.id.value}, {{ value: undefined }});")
            else -> {}
        }
    }
    &out.push("    let __jet_block = {function.entry.value};")
    &out.push("    let __jet_pred = -1;")
    &out.push("    for (;;) {{")
    &out.push("      switch (__jet_block) {{")
    loop block in function.blocks {
        &out.push("        case {block.id.value}: {{")
        loop instruction in block.instructions {
            expression :: jet_web_js_operation(&ctx, function, instruction.operation, instruction.ty)
            if instruction.result == {
                .Val(result) -> {
                &out.push("          __jet_values.set({result.value}, {expression});")
                if instruction.operation == {
                    .Parameter(index, _) -> {
                        parameter := MIRParam?{None}
                        loop row in function.params { if row.index == index -> parameter = Val(row) }
                        if parameter == .Val(row) {
                            if {
                                row.access == MIRAccess.Write -> {
                                &out.push("          __jet_cells.set({result.value}, {{ get value() {{ return __jet_args[{index}]; }}, set value(v) {{ __jet_args[{index}] = v; }} }});")
                                }
                                else -> {
                                &out.push("          __jet_cells.set({result.value}, {{ value: __jet_values.get({result.value}) }});")
                                }
                            }
                        }
                    }
                    .Capture(slot) -> &out.push("          __jet_cells.set({result.value}, __jet_env[{slot}]);")
                    else -> {}
                }
                }
                else -> {
                &out.push("          void ({expression});")
                }
            }
            if jet_web_js_persist_live_value_update(&ctx, function, instruction.operation) == .Val(update) -> &out.push("          {update}")
        }
        jet_web_emit_js_terminator(&ctx, function, block, &out)
        &out.push("        }}")
    }
    &out.push("        default: throw new Error(\"invalid MIR block\");")
    &out.push("      }}")
    &out.push("    }}")
    &out.push("  }} finally {{")
    &out.push("    jet_stack_leave(__jet_stack_frame);")
    &out.push("  }}")
    &out.push("}}")
    &out.push("")
}

fn jet_web_emit_module_registry(ctx: &JetWebEmitContext, out: &[String]) Never! {
    loop module_id in ctx.artifact.modules {
        module_row := MIRModule?{None}
        loop candidate in ctx.program.modules { if candidate.id == module_id -> module_row = Val(candidate) }
        if module_row == None {
            jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidMIR, "E0003", "Web artifact references a missing module", "module closure identities must resolve before JavaScript emission", None)
            next
        }
        row :: module_row ?? next
        if row.key == "" || row.path == "" {
            jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidMIR, "E0003", "Web artifact module has no stable key or path", "module registry provenance requires both checked identity fields", None)
            next
        }
        nul :: String.from_bytes([U8]{0}) ?? ""
        interface_seed :: "{row.key}{nul}{row.path}{nul}{row.imports.len()}{nul}{row.item_order.len()}"
        body_seed :: "{ctx.artifact_identity}{nul}{module_id.value}{nul}{row.path}"
        interface_digest :: jet_web_js_quote("sha256-{mir_sha256_hex(interface_seed)}")
        body_digest :: jet_web_js_quote("sha256-{mir_sha256_hex(body_seed)}")
        &out.push("jetDom.registerWebModule({jet_web_js_quote(row.key)}, {interface_digest}, {body_digest});")
    }
    &out.push("")
}

fn jet_web_emit_js_entry(ctx: &JetWebEmitContext, out: &[String]) Never! {
    entry_is_js :: jet_web_function_in_bucket(ctx.entry, MIRWebBucket.JS)
    if !entry_is_js && jet_web_function_in_bucket(ctx.entry, MIRWebBucket.Wasm) && ctx.entry.generator != None {
        entry_name := ~ctx.entry.name
        entry_span := ctx.entry.span
        jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidMIR, "E0003", "Web Wasm entry cannot be a generator", entry_name, Val(entry_span))
        return
    }
    function :: ctx.entry
    if {
        jet_web_function_in_bucket(function, MIRWebBucket.JS) -> {
            &out.push("export async function jet_main(...args) {{")
            &out.push("  const __jet_edge_result = await jet_fn_{function.id.value}([], args);")
            &out.push("  return jet_web_edge_result(__jet_edge_result);")
            &out.push("}}")
            &out.push("")
        }
        jet_web_function_in_bucket(function, MIRWebBucket.Wasm) -> {
            // A Wasm generator entry was rejected above.
            &out.push("export async function jet_main(...args) {{")
            &out.push("  __jetPreludeWasm.jet_entry_{function.id.value}(...args);")
            &out.push("  const outcome = jetDom.takeWasmError(__jetPreludeWasm);")
            &out.push("  if (outcome) return jet_web_edge_result(outcome);")
            &out.push("  return undefined;")
            &out.push("}}")
            &out.push("")
        }
        else -> {
            entry_span := function.span
            jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidPartition, "E0003", "Web entry has no checked partition", "the selected entry function must be JS or Wasm-applicable", Val(entry_span))
        }
    }
}

fn jet_web_emit_js_app(ctx: &JetWebEmitContext) -> String {
    needs_font :: jet_web_needs_font_shaping(&ctx)
    has_data :: jet_web_has_runtime_part(&ctx, MIRRuntimePartID.Data)
    has_game :: jet_web_has_runtime_part(&ctx, MIRRuntimePartID.Game)
    font_import :: if needs_font -> "await jet_ui_web_harfbuzz_imports()" else -> "jet_ui_web_unreachable_harfbuzz_imports()"
    lines := [String]{
        "import * as jetDom from \"./jet_dom_runtime.js\";",
        jet_web_compose_prelude(&ctx),
        "const __jetFontImports = {font_import};",
    }
    &lines.push(jet_web_js_copy_type_facts(&ctx))
    if has_data -> &lines.push("const __jetDataImports = jet_data_web_imports();")
    // History is part of every checked Web Wasm import contract.
    &lines.push("const __jetTestingHistoryImports = jet_testing_history_web_imports();")
    imports := [String]{"...__jetFontImports", "...__jetTestingHistoryImports"}
    if has_data -> &imports.push("...__jetDataImports")
    imports_text :: imports.join(", ")
    &lines.push("const __jetPreludeWasm = (await jetDom.instantiateWasm(new URL(\"./app.wasm\", import.meta.url).href, {{ {imports_text} }})).exports;")
    if has_data {
        &lines.push("jet_data_web_bind_wasm(__jetPreludeWasm);")
        &lines.push("if (typeof __jetPreludeWasm.jet_data_web_register_types === \"function\") __jetPreludeWasm.jet_data_web_register_types();")
    }
    &lines.push("jet_testing_history_web_bind_wasm(__jetPreludeWasm);")
    if needs_font -> &lines.push("jet_ui_web_harfbuzz_bind_app(__jetPreludeWasm);")
    if has_game {
        &lines.push("if (typeof fetch === \"function\") {{")
        &lines.push("  try {{")
        &lines.push("    const __jetProjection = await fetch(\"/__jet_devtools/state\").then((response) => response.ok ? response.json() : null);")
        &lines.push("    if (__jetProjection?.session_id) {{")
        &lines.push("      globalThis.__jetDevtoolsGameIdentity = {{")
        &lines.push("        session_id: __jetProjection.session_id,")
        &lines.push("        source_id: __jetProjection.source_id || \"game\",")
        &lines.push("        build_id: __jetProjection.build_id || \"runtime\",")
        &lines.push("        revision: __jetProjection.revision || \"runtime\",")
        &lines.push("      }};")
        &lines.push("    }}")
        &lines.push("  }} catch (_) {{}}")
        &lines.push("}}")
    }
    jet_web_emit_module_registry(&ctx, &lines)
    jet_web_emit_wasm_export_bridges(&ctx, &lines)
    loop function in ctx.functions -> jet_web_emit_js_function(&ctx, function, &lines)
    jet_web_emit_js_entry(&ctx, &lines)
    lines.join("\n")
}
