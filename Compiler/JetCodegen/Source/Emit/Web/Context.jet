// Checked MIR Web publication context.  The Web adapter is deliberately a
// representation layer: target applicability, partition markers, runtime
// closure, and artifact selection are facts already present on MirProgram.
// It never re-runs sema policy and never asks a host compiler to choose a
// partition.
use jet_foundation.[
    JetReleaseDevtoolsPolicy,
    JetTargetLayout,
    MIRArtifactID,
    MIRArtifactKind,
    MIRArtifactPlan,
    MIRArtifactTarget,
    MIRCoreCall,
    MIRCoreCallID,
    MIRFieldID,
    MIRFunction,
    MIRFunctionID,
    MIRModuleID,
    MIRPreludeCall,
    MIRPreludeCallID,
    MIRProgram,
    MIRRuntimePartID,
    MIRScopeKind,
    MIRSourceFileID,
    MIRType,
    MIRTypeDef,
    MIRTypeID,
    MIRValueID,
    MIRWebBucket,
    MIRWebPartitionMarker,
    Span,
]

struct JetWebTimezoneAsset {
    name: String
    bytes: [U8]
}

struct JetWebAssets {
    dom_runtime: String
    execution_prelude: String
    event_prelude: String
    realtime_prelude: String
    data_prelude: String
    history_prelude: String
    compute_prelude: String
    raylib_prelude: String
    game_prelude: String
    task_group_prelude: String
    runtime_stop_metadata: String
    game_default_frame_budget: Int
    game_frame_budget_error: String
    harfbuzz_wasm: [U8]
    timezone_data: [JetWebTimezoneAsset]
    index_html: String
    explicit_html_path: String?
    source_names: [String]
    source_contents: [String]
}

fn jet_web_assets_with_default_shell() -> JetWebAssets Never! {
    JetWebAssets{
        // The canonical DOM/runtime fragments are supplied by Foundation/Driver.
        // Empty values are rejected by the checked publication gate rather than
        // replaced with a second runtime implementation here.
        dom_runtime: "",
        execution_prelude: "",
        event_prelude: "",
        realtime_prelude: "",
        data_prelude: "",
        history_prelude: "",
        compute_prelude: "",
        raylib_prelude: "",
        game_prelude: "",
        task_group_prelude: "",
        runtime_stop_metadata: "",
        game_default_frame_budget: 0,
        game_frame_budget_error: "",
        harfbuzz_wasm: [U8]{},
        timezone_data: [JetWebTimezoneAsset]{},
        index_html: "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Jet app</title></head><body><script type=\"module\" src=\"./app.js\"></script></body></html>\n",
        explicit_html_path: None,
        source_names: [String]{},
        source_contents: [String]{},
    }
}

struct JetWebEmitConfig {
    artifact: MIRArtifactID
    layout: JetTargetLayout
    assets: JetWebAssets
    semantic_digest: String
    root_prefix: String
    release_devtools_policy: JetReleaseDevtoolsPolicy
}

enum JetWebEmitFailureKind {
    InvalidMIR
    InvalidLayout
    InvalidAssets
    InvalidRuntimeAssets
    MissingCoreCall
    MissingPreludeCall
    MissingUserFunction
    MissingEntryFunction
    InvalidABI
    InvalidExport
    InvalidPartition
    InvalidProvenance
}

struct JetWebEmitFailure {
    kind: JetWebEmitFailureKind
    code: String
    message: String
    detail: String
    span: Span?
}

struct JetWebArtifacts {
    manifest_json: String
    wasm_rust: String
    rustc_incremental_identity: String
    js_app: String
    js_source_map: String
    source_names: [String]
    source_contents: [String]
    dom_runtime: String
    index_html: String
    explicit_html_path: String?
    command_record: [U8]
}

enum JetWebEmitResult {
    Complete(value: JetWebArtifacts)
    Incomplete(failure: JetWebEmitFailure)
}

struct JetWebEmitContext {
    program: MIRProgram
    config: JetWebEmitConfig
    artifact: MIRArtifactPlan
    functions: [MIRFunction]
    entry: MIRFunction
    artifact_identity: String
    history_source: String
    history_tool: String
    history_target: String
    failure: JetWebEmitFailure?
}

fn jet_web_failure(kind: JetWebEmitFailureKind, code: String, message: String, detail: String, span: Span?) -> JetWebEmitFailure Never! {
    JetWebEmitFailure{kind: kind, code: code, message: message, detail: detail, span: span}
}

fn jet_web_fail(ctx: &JetWebEmitContext, kind: JetWebEmitFailureKind, code: String, message: String, detail: String, span: Span?) Never! {
    if ctx.failure == None {
        ctx.failure = Val(jet_web_failure(kind, code, message, detail, span))
    }
}

fn jet_web_id(value: Int) -> String Never! { "{value}" }

fn jet_web_json_quote(value: String) -> String Never! {
    bytes :: value.bytes()
    out := "\""
    loop byte in bytes {
        code :: Int.from_u8(byte)
        out = if {
            code == 92 -> "{out}\\\\"
            code == 34 -> "{out}\\\""
            code == 10 -> "{out}\\n"
            code == 13 -> "{out}\\r"
            code == 9 -> "{out}\\t"
            code < 32 -> {
                hex :: "0123456789abcdef"
                high :: String.from_bytes([hex.bytes()[code /% 16]]) ?? "0"
                low :: String.from_bytes([hex.bytes()[code % 16]]) ?? "0"
                "{out}\\u00{high}{low}"
            }
            else -> {
                byte_text :: String.from_bytes([byte]) ?? ""
                "{out}{byte_text}"
            }
        }
    }
    "{out}\""
}

fn jet_web_js_quote(value: String) -> String Never! { jet_web_json_quote(value) }

fn jet_web_bool_json(value: Bool) -> String Never! { if value -> "true" else -> "false" }

fn jet_web_optional_string(value: String?) -> String Never! {
    text :: value ?? return "null"
    jet_web_json_quote(text)
}

fn jet_web_optional_int(value: Int?) -> String Never! {
    number :: value ?? return "null"
    "{number}"
}

fn jet_web_bucket_json(value: MIRWebBucket?) -> String Never! {
    bucket :: value ?? return "null"
    if bucket == {
        .JS -> jet_web_json_quote("JS")
        else -> jet_web_json_quote("Wasm")
    }
}

fn jet_web_marker_json(value: MIRWebPartitionMarker?) -> String Never! {
    marker :: value ?? return "null"
    if marker == {
        .JS -> jet_web_json_quote("JS")
        .Wasm -> jet_web_json_quote("Wasm")
        else -> jet_web_json_quote("WasmExport")
    }
}

fn jet_web_function_in_bucket(function: MIRFunction, bucket: MIRWebBucket) -> Bool Never! {
    if function.web_bucket == .Val(own) -> return own == bucket
    marker :: function.web_marker ?? return false
    if bucket == {
        .JS -> marker == MIRWebPartitionMarker.JS
        else -> marker == MIRWebPartitionMarker.Wasm || marker == MIRWebPartitionMarker.WasmExport
    }
}

fn jet_web_is_wasm_export(function: MIRFunction) -> Bool Never! {
    function.web_marker == (Val(MIRWebPartitionMarker.WasmExport))
}

fn jet_web_find_function(program: MIRProgram, id: MIRFunctionID) -> MIRFunction? {
    loop function in program.functions { if function.id == id -> return Val(function) }
    None
}

fn jet_web_find_type(program: MIRProgram, id: MIRTypeID) -> MIRTypeDef? {
    loop definition in program.types { if definition.id == id -> return Val(definition) }
    None
}

fn jet_web_find_artifact(program: MIRProgram, id: MIRArtifactID) -> MIRArtifactPlan? {
    loop artifact in program.artifacts { if artifact.id == id -> return Val(artifact) }
    None
}

fn jet_web_find_field_name(program: MIRProgram, id: MIRFieldID) -> String? {
    loop row in program.fields { if row.id == id -> return Val(row.field.name) }
    None
}

fn jet_web_find_source_path(program: MIRProgram, id: MIRSourceFileID) -> String? {
    loop row in program.source_files { if row.id == id -> return Val(row.path) }
    None
}

fn jet_web_find_prelude(program: MIRProgram, id: MIRPreludeCallID) -> MIRPreludeCall? {
    loop row in program.prelude_calls { if row.id == id -> return Val(row) }
    None
}

fn jet_web_find_core(program: MIRProgram, id: MIRCoreCallID) -> MIRCoreCall? {
    loop row in program.core_calls { if row.id == id -> return Val(row) }
    None
}

fn jet_web_find_value_type(function: MIRFunction, id: MIRValueID) -> MIRType? {
    loop row in function.values { if row.id == id -> return Val(row.ty) }
    None
}

fn jet_web_source_line(program: MIRProgram, function: MIRFunction) -> String Never! {
    source := String?{None}
    loop candidate in program.source_files { if candidate.id == function.source_file -> source = Val(candidate.source) }
    text :: source ?? return ""
    line := 1
    offset := 0
    loop offset < function.span.start && offset < text.bytes().len() {
        if text.bytes()[offset] == (U8{10}) -> line += 1
        offset += 1
    }
    lines :: text.split("\n").to_list()
    if line > 0 && line <= lines.len() -> lines[line - 1] else -> ""
}

fn jet_web_validate_assets(ctx: &JetWebEmitContext) Never! {
    if ctx.config.assets.dom_runtime == "" {
        jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidRuntimeAssets, "E0003", "Web DOM runtime asset is empty", "the canonical browser runtime must be supplied by Driver/Prelude assets", None)
    }
    if ctx.config.assets.execution_prelude == "" {
        jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidRuntimeAssets, "E0003", "Web execution Prelude asset is empty", "the canonical raw execution fragments must be supplied by Driver/Host", None)
    }
    if ctx.config.assets.history_prelude == "" {
        jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidRuntimeAssets, "E0003", "Web history Prelude asset is empty", "the Wasm history ABI requires the canonical raw history fragment", None)
    }
    if ctx.config.assets.task_group_prelude == "" {
        jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidRuntimeAssets, "E0003", "Web task-group Prelude asset is empty", "the canonical task-group fragment must be supplied by Driver/Host", None)
    }
    if ctx.config.assets.runtime_stop_metadata == "" {
        jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidRuntimeAssets, "E0003", "Web runtime-stop metadata asset is empty", "the canonical checked diagnostic metadata must be supplied by Driver/Host", None)
    }
    if jet_web_has_runtime_part(&ctx, MIRRuntimePartID.Event) && ctx.config.assets.event_prelude == "" {
        jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidRuntimeAssets, "E0003", "Web Event Prelude asset is empty", "the selected Event runtime part has no canonical raw fragment", None)
    }
    if jet_web_has_runtime_part(&ctx, MIRRuntimePartID.Realtime) && ctx.config.assets.realtime_prelude == "" {
        jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidRuntimeAssets, "E0003", "Web Realtime Prelude asset is empty", "the selected Realtime runtime part has no canonical raw fragment", None)
    }
    if jet_web_has_runtime_part(&ctx, MIRRuntimePartID.Data) && ctx.config.assets.data_prelude == "" {
        jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidRuntimeAssets, "E0003", "Web Data Prelude asset is empty", "the selected Data runtime part has no canonical raw fragment", None)
    }
    if jet_web_has_runtime_part(&ctx, MIRRuntimePartID.Compute) && ctx.config.assets.compute_prelude == "" {
        jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidRuntimeAssets, "E0003", "Web Compute Prelude asset is empty", "the selected Compute runtime part has no canonical raw fragment", None)
    }
    if jet_web_has_runtime_part(&ctx, MIRRuntimePartID.Game) {
        if ctx.config.assets.raylib_prelude == "" || ctx.config.assets.game_prelude == "" || ctx.config.assets.game_default_frame_budget <= 0 || ctx.config.assets.game_frame_budget_error == "" {
            jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidRuntimeAssets, "E0003", "Web Game runtime assets are incomplete", "the selected Game runtime part requires canonical Raylib, Game, and frame-budget assets", None)
        }
    }
    if jet_web_needs_font_shaping(&ctx) && ctx.config.assets.harfbuzz_wasm.len() == 0 {
        jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidRuntimeAssets, "E0003", "Web HarfBuzz asset is empty", "core.font.shape requires the canonical checked HarfBuzz Wasm bytes", None)
    }
    if jet_web_has_runtime_part(&ctx, MIRRuntimePartID.Math) && ctx.config.assets.timezone_data.len() == 0 {
        jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidRuntimeAssets, "E0003", "Web timezone asset is empty", "the selected Math runtime part requires canonical sorted TZif data", None)
    }
    if ctx.config.assets.index_html == "" {
        jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidAssets, "E0003", "Web HTML asset is empty", "publication requires a non-empty index HTML asset", None)
    }
    if ctx.config.assets.source_names.len() != ctx.config.assets.source_contents.len() {
        jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidAssets, "E0003", "Web source-map asset rows are misaligned", "source_names and source_contents must be parallel canonical rows", None)
    }
}

fn jet_web_validate_artifact(ctx: &JetWebEmitContext) Never! {
    if ctx.artifact.kind != MIRArtifactKind.WebApplication {
        jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidMIR, "E0003", "selected MIR artifact is not a WebApplication", "Web emission accepts only the checked WebApplication artifact plan", None)
    }
    if ctx.artifact.target != MIRArtifactTarget.Web {
        jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidMIR, "E0003", "selected MIR artifact does not target Web", "artifact target and Web representation must agree", None)
    }
    if ctx.artifact.modules.len() == 0 {
        jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidMIR, "E0003", "WebApplication artifact has no selected modules", "publication closure must select at least one module", None)
    }
    missing_module := false
    loop module_id in ctx.artifact.modules {
        if !program_has_module(ctx.program, module_id) -> missing_module = true
    }
    if missing_module -> jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidMIR, "E0003", "Web artifact references a missing module", "selected module identities must resolve in the checked MIR program", None)
    if ctx.artifact.entry == None {
        jet_web_fail(&ctx, JetWebEmitFailureKind.MissingEntryFunction, "E0003", "WebApplication artifact has no entry", "the checked artifact plan must carry one entry function", None)
    }
}

fn program_has_module(program: MIRProgram, id: MIRModuleID) -> Bool Never! {
    loop module_row in program.modules { if module_row.id == id -> return true }
    false
}

fn jet_web_validate_partition(ctx: &JetWebEmitContext, function: MIRFunction) Never! {
    loop scope in function.scopes {
        if scope.kind == MIRScopeKind.StopCleanup -> jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidMIR, "E0003", "MIR StopCleanup reached the web emitter", "StopCleanup is produced only for native host compilations", Val(scope.span))
    }
    if function.target_applicability.web && function.web_bucket == None {
        jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidPartition, "E0003", "Web-applicable MIR function has no Web bucket", "partition selection must be a checked MIR fact before emission", Val(function.span))
    }
    if function.web_bucket == (Val(MIRWebBucket.JS)) && function.web_marker == (Val(MIRWebPartitionMarker.Wasm)) {
        jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidPartition, "E0003", "JS Web bucket has a Wasm marker", "contradictory checked partition facts cannot be published", Val(function.span))
    }
    if function.web_bucket == (Val(MIRWebBucket.JS)) && function.web_marker == (Val(MIRWebPartitionMarker.WasmExport)) {
        jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidPartition, "E0003", "JS Web bucket has a WasmExport marker", "contradictory checked partition facts cannot be published", Val(function.span))
    }
    if function.web_bucket == (Val(MIRWebBucket.Wasm)) && function.web_marker == (Val(MIRWebPartitionMarker.JS)) {
        jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidPartition, "E0003", "Wasm Web bucket has a JS marker", "contradictory checked partition facts cannot be published", Val(function.span))
    }
    loop reconstruction in function.web_param_reconstructions {
        if reconstruction.local == "" -> jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidMIR, "E0003", "Web parameter reconstruction has an empty local", "reconstruction rows must preserve checked local identity", Val(function.span))
        loop field in reconstruction.fields {
            if field.field == "" || field.parameter == "" -> jet_web_fail(&ctx, JetWebEmitFailureKind.InvalidMIR, "E0003", "Web parameter reconstruction has an empty field", "reconstruction rows must preserve checked field and parameter identity", Val(function.span))
        }
    }
}
