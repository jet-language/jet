// Canonical raw Web runtime assets and Source-owned feature closure.
//
// Host/Driver supplies immutable fragments and data; this module alone decides
// which checked runtime parts are selected and composes them in the same order
// as the Web ABI.  No native emitter or preselected Prelude is consulted.

fn jet_web_has_runtime_part(ctx: &JetWebEmitContext, wanted: MirRuntimePartId) -> Bool {
    loop part in ctx.artifact.runtime_parts {
        if part == wanted -> return true
    }
    false
}

fn jet_web_core_is_font_shape(ctx: &JetWebEmitContext, id: MirCoreCallId) -> Bool {
    row := jet_web_find_core(ctx.program, id)
    if row == None -> return false
    call :: row ?? return false
    call.module_name == "core.font" && call.member == "shape"
}

fn jet_web_needs_font_shaping(ctx: &JetWebEmitContext) -> Bool {
    loop function in ctx.functions {
        loop block in function.blocks {
            loop instruction in block.instructions {
                uses_font := if instruction.operation == {
                    .CoreCall(call, _, _, _, _, _) -> jet_web_core_is_font_shape(ctx, call)
                    .Call(callee, _, _) -> {
                        if callee == {
                            .Core(call) -> jet_web_core_is_font_shape(ctx, call)
                            else -> false
                        }
                    }
                    else -> false
                }
                if uses_font -> return true
            }
        }
    }
    false
}

fn jet_web_js_byte_array(bytes: [U8]) -> String {
    values := [String]{}
    loop byte in bytes -> values.push("{Int.from_u8(byte)}")
    "[{values.join(",")}]"
}

fn jet_web_timezone_fragment(ctx: &JetWebEmitContext) -> String {
    lines := [String]{"\n// D-TIMEDEPTH1: exact checked repository TZif inputs for browser named zones."}
    loop timezone in ctx.config.assets.timezone_data {
        lines.push("JET_TIME_ZONE_DATA[{jet_web_js_quote(timezone.name)}] = new Uint8Array({jet_web_js_byte_array(timezone.bytes)});")
    }
    lines.join("\n")
}

fn jet_web_harfbuzz_fragment(ctx: &JetWebEmitContext) -> String {
    bytes := ctx.config.assets.harfbuzz_wasm
    digest := mir_sha256_hex_bytes(bytes)
    "\n// D-FOUND-PLATFORM1=A: the checked HarfBuzz bridge travels with the app.\nconst __jetCanonicalHarfBuzzWasmAsset = Object.freeze({{path: {jet_web_js_quote(\"wasm/jet_harfbuzz.wasm\")},sha256: {jet_web_js_quote(digest)},bytes: new Uint8Array({jet_web_js_byte_array(bytes)})}});\nglobalThis.__jetCanonicalHarfBuzzWasm = __jetCanonicalHarfBuzzWasmAsset;"
}

fn jet_web_compose_prelude(ctx: &JetWebEmitContext) -> String {
    parts := [String]{ctx.config.assets.execution_prelude}
    if jet_web_has_runtime_part(ctx, MirRuntimePartId.Event) -> parts.push(ctx.config.assets.event_prelude)
    if jet_web_has_runtime_part(ctx, MirRuntimePartId.Realtime) -> parts.push(ctx.config.assets.realtime_prelude)
    if jet_web_has_runtime_part(ctx, MirRuntimePartId.Data) -> parts.push(ctx.config.assets.data_prelude)
    // The Wasm prelude always exports the history ABI, even for programs with
    // no authored history call, so instantiation never loses its imports.
    parts.push(ctx.config.assets.history_prelude)
    if jet_web_has_runtime_part(ctx, MirRuntimePartId.Compute) -> parts.push(ctx.config.assets.compute_prelude)
    if jet_web_has_runtime_part(ctx, MirRuntimePartId.Game) {
        parts.push(ctx.config.assets.raylib_prelude)
        parts.push(ctx.config.assets.game_prelude)
        parts.push("\nconst JET_GAME_DEFAULT_FRAME_BUDGET = {ctx.config.assets.game_default_frame_budget};\nconst JET_GAME_FRAME_BUDGET_ERROR = {jet_web_js_quote(ctx.config.assets.game_frame_budget_error)};")
    }
    if jet_web_needs_font_shaping(ctx) -> parts.push(jet_web_harfbuzz_fragment(ctx))
    if jet_web_has_runtime_part(ctx, MirRuntimePartId.Math) -> parts.push(jet_web_timezone_fragment(ctx))
    parts.push(ctx.config.assets.task_group_prelude)
    parts.push(ctx.config.assets.runtime_stop_metadata)
    parts.join("\n")
}
