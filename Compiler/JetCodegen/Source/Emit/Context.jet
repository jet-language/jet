// Jet-owned Rust source emission context. The emitter consumes complete MIR and
// never asks the Rust compiler to rediscover checked policy.
use jet_foundation.[
    MIRAccess,
    MIRCompilerBuiltin,
    MIRCoreCall,
    MIRCoreCallID,
    MIRFieldID,
    MIRForeignID,
    MIRForeign,
    MIRFieldRow,
    MIRFunctionID,
    MIRGenericParam,
    MIRNominalRef,
    MIRPlaceID,
    MIRPreludeCall,
    MIRPreludeCallID,
    MIRProgram,
    MIRSourceFileID,
    MIRTraitID,
    MIRTraitDef,
    MIRTraitMethodID,
    MIRType,
    MIRTypeDef,
    MIRTypeID,
    MIRWebBucket,
    MIR_SCHEMA_VERSION,
    Span,
    mir_field_id,
    mir_type_identity_key,
    mir_type_same_checked_type,
]

pub struct JetRustEmitConfig {
    pub target: String
    pub web_bucket: MIRWebBucket?
    pub root_prefix: String
    pub emit_types: Bool
    pub emit_foreign: Bool
    pub emit_metadata: Bool
    // The release devtools policy's local rail: persistent writes report to
    // the live value observer only while it is enabled.
    pub local_rail: Bool
}

pub enum JetRustEmitFailureKind {
    InvalidSchema
    MissingIdentity
    MissingRow
    UnsupportedTarget
    UnsupportedOperation
    UnsupportedForeign
    InvalidOwnership
    InvalidControlFlow
}

pub struct JetRustEmitFailure {
    pub kind: JetRustEmitFailureKind
    pub code: String
    pub message: String
    pub detail: String
    pub span: Span?
}

pub struct JetRustEmitCallableMetadata {
    pub function: MIRFunctionID
    pub source_name: String
    pub symbol: String
    pub parameter_types: [String]
    pub parameter_access: [MIRAccess]
    pub return_type: String
    pub callable_type: String
}

pub struct JetRustEmitTypeMetadata {
    pub ty: MIRTypeID
    pub source_name: String
    pub symbol: String
}

pub struct JetRustEmitFieldMetadata {
    pub field: MIRFieldID
    pub owner: MIRTypeID
    pub source_name: String
    pub symbol: String
}

pub struct JetRustEmitVariantMetadata {
    pub owner: MIRTypeID
    pub source_name: String
    pub wire_name: String
    pub symbol: String
    pub payload_types: [String]
}

pub struct JetRustEmitTraitMetadata {
    pub trait_id: MIRTraitID
    pub key: String
    pub name: String
    pub symbol: String
}

pub struct JetRustEmitTraitMethodMetadata {
    pub trait_id: MIRTraitID
    pub method_id: MIRTraitMethodID
    pub key: String
    pub name: String
    pub symbol: String
    pub receiver_access: MIRAccess?
    pub parameter_types: [String]
    pub parameter_access: [MIRAccess]
    pub return_type: String
}

pub struct JetRustEmitManifest {
    pub schema_version: Int
    pub target: String
    pub package_identity: String
    pub type_count: Int
    pub function_count: Int
    pub foreign_count: Int
    pub source_bytes: Int
    pub function_symbols: [String:String]
    pub type_symbols: [String:String]
    pub field_symbols: [String:String]
    pub variant_symbols: [String:String]
    pub variant_source_names: [String:String]
    pub variant_wire_names: [String:String]
    pub type_metadata: [JetRustEmitTypeMetadata]
    pub callable_metadata: [JetRustEmitCallableMetadata]
    pub field_metadata: [JetRustEmitFieldMetadata]
    pub variant_metadata: [JetRustEmitVariantMetadata]
    pub traits: [JetRustEmitTraitMetadata]
    pub trait_methods: [JetRustEmitTraitMethodMetadata]
}

pub enum JetRustEmitResult {
    Complete(source: String, manifest: JetRustEmitManifest)
    Incomplete(failure: JetRustEmitFailure)
}

JET_RUST_EMIT_NO_CYCLE_FLOOR :: 9223372036854775807

pub struct JetRustEmitContext {
    pub program: MIRProgram
    pub config: JetRustEmitConfig
    pub function_names: [String:String]
    pub type_names: [String:String]
    pub type_by_name: [String:String]
    pub trait_names: [String:String]
    // Trait id keys of declared (not compiler-owned) traits used as a
    // single-bound trait object `Box<dyn T>`: each gets a clone-box
    // supertrait so the boxed value is Clone (MIRRust dyn_clone_traits).
    pub dyn_clone_traits: [String:Bool]
    pub field_names: [String:String]
    pub variant_names: [String:String]
    pub variant_source_names: [String:String]
    pub variant_wire_names: [String:String]
    pub foreign_names: [String:String]
    pub failure: JetRustEmitFailure?
    pub current_function: MIRFunctionID?
    pub current_generic_params: [MIRGenericParam]
    // `"function:param"` keys of list write parameters emitted as `&mut [T]`
    // because a caller fills them with a range write window.
    pub window_params: [String:Bool]
    // Line starts and bytes of every source row, built once for panic,
    // stack-frame and coverage lines (rows looked up by file id).
    pub source_index: JetCodegenSourceIndex
    // First index into program.types per id key, canonical key and leaf name.
    pub type_index_by_id: [String:Int]
    pub type_index_by_key: [String:Int]
    pub type_index_by_name: [String:Int]
    // Indexes into program.impls of every impl with a trait, per trait id key,
    // in program order.
    pub impls_by_trait: [String:[Int]]
    // Row indexes built once per program so per-instruction and per-type
    // lookups never rescan whole MIR tables: first row per function, foreign
    // and trait id; first and last program.fields row per field id and the
    // rows per owner; first and last type instance per identity; and the
    // key/name spellings of columnar-layout types.
    pub function_index_by_id: [String:Int]
    pub foreign_index_by_id: [String:Int]
    pub trait_index_by_id: [String:Int]
    pub field_index_by_id: [String:Int]
    pub field_last_index_by_id: [String:Int]
    pub field_rows_by_owner: [String:[Int]]
    pub type_instance_first: [String:Int]
    pub type_instance_last: [String:Int]
    pub columnar_type_names: [String:Bool]
    // First Core route row per id; first and last Prelude route row per id.
    pub core_call_index_by_id: [String:Int]
    pub prelude_call_first: [String:Int]
    pub prelude_call_last: [String:Int]
    // Memoized derive-capability answers for closed type rows, keyed
    // "trait:type id" (MIRRust derive_capability_cache).
    pub derive_capability_cache: [String:Bool]
    // Lowest `visiting` index a cycle assumption reached in the current
    // derive-capability frame; JET_RUST_EMIT_NO_CYCLE_FLOOR when none.
    pub derive_capability_cycle_floor: Int
    // Function id keys of impl methods whose free function body is not
    // emitted: printed natively inside their impl (derived Equatable and
    // Comparable) or owned by an undemanded derived codec impl
    // (mir_demanded_codec_impls).
    pub skipped_methods: [String:Bool]
    // D-MEM-COPYSEM1 move facts of the function being printed
    // (jet_rust_emit_move_facts): values read once in their own block, and
    // moved enum subjects whose payload bindings take them apart once.
    pub move_facts: JetRustEmitMoveFacts
    // #4318 reference bindings of the function being printed
    // (jet_rust_emit_ref_bindings): binding locals held as `Option<&T>`.
    pub ref_bindings: JetRustEmitRefBindings
    // Lookup rows of the function being printed (jet_rust_emit_body_index).
    pub body_index: JetRustEmitBodyIndex
    // Ratio-use classification of the last queried function; rebuilt when
    // its function id changes (jet_rust_emit_is_unit_ratio_parameter).
    pub unit_ratio_function: MIRFunctionID?
    pub unit_ratio_parameters: [U64:Bool]
    // Module id keys of the selected artifact plan (MIRRust module_selected),
    // set by jet_rust_emit_program; every module is selected without a plan.
    pub selected_modules: [String:Bool]
    pub all_modules_selected: Bool
}

pub struct JetRustEmitPayloadMember {
    pub field: Int
    pub result: MIRValueID
}

pub struct JetRustEmitMoveFacts {
    pub single_use: [String:Bool]
    // Subject id key -> its payload bindings in block order.
    pub payload_groups: [String:[JetRustEmitPayloadMember]]
    // Payload result id key -> its group's subject id key.
    pub payload_subjects: [String:String]
}

fn jet_rust_emit_empty_move_facts() -> JetRustEmitMoveFacts Never! {
    JetRustEmitMoveFacts{single_use: [String:Bool]{}, payload_groups: [String:[JetRustEmitPayloadMember]]{}, payload_subjects: [String:String]{}}
}

// MIRRust RefBindings (#4318): binding locals stored as a shared reference to
// the value they bind, keyed by local id value, and the reads whose only use
// binds one of them (their write borrows in place; they have no slot). Read
// loops that walk their list in place map their cursor to the walked list
// place; the collection values they walk have no slot.
pub struct JetRustEmitRefBindings {
    pub locals: [U64:Bool]
    pub payloads: [U64:Bool]
    pub cursors: [U64:MIRPlaceID]{[U64:MIRPlaceID]{}}
    pub collections: [U64:Bool]{[U64:Bool]{}}
}

fn jet_rust_emit_empty_ref_bindings() -> JetRustEmitRefBindings Never! {
    JetRustEmitRefBindings{locals: [U64:Bool]{}, payloads: [U64:Bool]{}}
}

// MIRRust borrowed_loop_candidates: one read loop that may walk its list in
// place: its cursor, the collection it walks, the list place, and the
// reference binding that place is rooted at, if any.
struct JetRustEmitLoopCandidate {
    cursor: MIRValueID
    collection: MIRValueID
    place: MIRPlaceID
    root: MIRLocalID?
}

// One binding write of a reference binding candidate: the bound read and the
// reference binding its stable place is rooted at (None: a read parameter).
struct JetRustEmitRefSource {
    value: MIRValueID
    root: MIRLocalID?
}

// Lookup rows of one function body (MIRRust FunctionIndex), keyed by id
// value; the first row per id wins, as a linear scan would. Per-value
// queries read them instead of rescanning the body.
pub struct JetRustEmitBodyIndex {
    // The indexed function; None before any function is printed.
    pub function: MIRFunctionID?
    // Block and instruction position of each value's definition.
    pub definition_blocks: [U64:Int]
    pub definition_positions: [U64:Int]
    // Position of each value's function.values row.
    pub value_rows: [U64:Int]
    // Position of each block, and the coverage branch ordinals before it.
    pub block_positions: [U64:Int]
    pub branch_bases: [U64:Int]
    // MIRRust shared_capture_locals: locals held in one shared cell because a
    // non-Send closure writes them (jet_rust_emit_shared_capture_locals).
    pub shared_locals: [U64:Bool]
    // Every use of each value in body order, one row per user (MIRRust
    // FunctionIndex::uses): `use_slots` maps a value to its row list.
    pub use_slots: [U64:Int]{[U64:Int]{}}
    pub uses: [[JetRustEmitUse]]{[[JetRustEmitUse]]{}}
    // Position of each place's function.places row.
    pub place_rows: [U64:Int]{[U64:Int]{}}
    // Predecessor block positions of each block, along terminator edges.
    pub predecessors: [[Int]]{[[Int]]{}}
    // MIRRust local_writes / escaped_locals: per local, the instructions
    // that may change or release it, and the locals place-based tracking
    // cannot follow.
    pub write_slots: [U64:Int]{[U64:Int]{}}
    pub local_writes: [[JetRustEmitUse]]{[[JetRustEmitUse]]{}}
    pub escaped_locals: [U64:Bool]{[U64:Bool]{}}
    // MIRRust parameter_writes / escaped_parameters: per parameter index, the
    // instructions that may change one of its places, with the place each
    // changes, and the parameters place-based tracking cannot follow or a
    // drop action releases a place of.
    pub parameter_write_slots: [Int:Int]{[Int:Int]{}}
    pub parameter_writes: [[JetRustEmitPlaceWrite]]{[[JetRustEmitPlaceWrite]]{}}
    pub escaped_parameters: [Int:Bool]{[Int:Bool]{}}
    // Temporary values whose own slot some instruction reads through a
    // projecting place (jet_rust_emit_inspected_only).
    pub slot_read_values: [U64:Bool]{[U64:Bool]{}}
    // Places some instruction moves out of (MovePlace or a Move address).
    pub moved_places: [U64:Bool]{[U64:Bool]{}}
    // Partial moves per root place base (jet_rust_emit_place_base_identity):
    // the field path of each move of a field place, in body order.
    pub partial_slots: [String:Int]{[String:Int]{}}
    pub partial_paths: [[[MIRFieldID]]]{[[[MIRFieldID]]]{}}
    // MIRRust FunctionIndex::stable_reads: jet_rust_emit_stable_local_read
    // answers per read value, computed on first query.
    pub stable_reads: [U64:Bool]{[U64:Bool]{}}
    // MIRRust FunctionIndex scopes / test_members: the position of each
    // scope's function.scopes row, and the block and instruction position of
    // the first ScopeEnter of each scope that carries a test member.
    pub scope_rows: [U64:Int]{[U64:Int]{}}
    pub test_member_blocks: [U64:Int]{[U64:Int]{}}
    pub test_member_positions: [U64:Int]{[U64:Int]{}}
}

// One use of a value: its block position and instruction position, or -1
// for the block's terminator.
pub struct JetRustEmitUse {
    pub block: Int
    pub instruction: Int
}

// One instruction that may change a parameter place, and that place.
pub struct JetRustEmitPlaceWrite {
    pub block: Int
    pub instruction: Int
    pub place: MIRPlaceID
}

fn jet_rust_emit_empty_body_index() -> JetRustEmitBodyIndex Never! {
    JetRustEmitBodyIndex{function: None, definition_blocks: [U64:Int]{}, definition_positions: [U64:Int]{}, value_rows: [U64:Int]{}, block_positions: [U64:Int]{}, branch_bases: [U64:Int]{}, shared_locals: [U64:Bool]{}}
}

fn jet_rust_emit_merge_generic_params(outer: [MIRGenericParam], inner: [MIRGenericParam]) -> [MIRGenericParam] Never! {
    merged := outer
    loop parameter in inner {
        index := 0
        found := false
        loop index < merged.len() {
            if merged[index].name == parameter.name {
                merged[index] = parameter
                found = true
                break
            }
            index += 1
        }
        if !found -> &merged.push(parameter)
    }
    merged
}

fn jet_rust_emit_id_key(value: U64) -> String Never! { "{value}" }

fn jet_rust_emit_sanitize(value: String) -> String Never! {
    bytes :: value.bytes()
    out := [U8]{}
    loop byte in bytes {
        code :: Int.from_u8(byte)
        &out.push(if (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95 -> byte else -> U8{95})
    }
    result :: String.from_bytes(out) ?? "_"
    if result.len() == 0 -> return "_"
    first := result.bytes()[0]
    if first >= (U8{48}) && first <= (U8{57}) -> "_{result}" else -> result
}

// Names::mangle: the Rust identifier of one Jet name. A comptime `$name`
// becomes `ct_name`; every name takes the single `__jet_` machine prefix.
fn jet_rust_emit_mangle(name: String) -> String Never! {
    bytes :: name.bytes()
    plain :: if name.starts_with("$") -> "ct_{String.from_bytes(~(bytes[1..<bytes.len()])) ?? ""}" else -> name
    if plain.starts_with("__jet_") -> plain else -> "__jet_{plain}"
}

// MIRRust mangle_variant: a grouped leaf keeps its dotted identity through the
// path encoding (`__jet_Net_dPing`); a flat variant takes the plain mangle.
fn jet_rust_emit_mangle_variant(name: String) -> String Never! {
    if name.contains(".") -> jet_rust_emit_generated_path(name) else -> jet_rust_emit_mangle(name)
}

fn jet_rust_emit_hex(value: Int) -> String Never! {
    digits :: "0123456789abcdef".bytes()
    out := [U8]{}
    rest := value
    loop {
        &out.push(digits[rest % 16])
        rest = rest /% 16
        if rest == 0 -> break
    }
    reversed := [U8]{}
    index := out.len()
    loop index > 0 {
        index -= 1
        &reversed.push(out[index])
    }
    String.from_bytes(reversed) ?? "0"
}

// Rust `char::escape_debug`: whether `{:?}` escapes a non-ASCII scalar.
fn jet_rust_emit_debug_escaped(code: Int) -> Bool Never! {
    ranges :: JET_RUST_EMIT_DEBUG_ESCAPED_RANGES
    low := 0
    high := ranges.len() /% 2
    loop low < high {
        middle :: (low + high) /% 2
        if ranges[middle * 2 + 1] < code -> low = middle + 1 else -> high = middle
    }
    low < ranges.len() /% 2 && ranges[low * 2] <= code
}

// The `{:?}` escape of one scalar inside a Rust string (`quote` 34) or char
// (`quote` 39) literal; None when the scalar prints as itself.
fn jet_rust_emit_debug_escape(code: Int, quote: Int) -> String? {
    if {
        code == 0 -> Val("\\0")
        code == 9 -> Val("\\t")
        code == 10 -> Val("\\n")
        code == 13 -> Val("\\r")
        code == 92 -> Val("\\\\")
        code == quote && code == 34 -> Val("\\\"")
        code == quote && code == 39 -> Val("\\'")
        code < 32 || code == 127 -> Val("\\u{{{jet_rust_emit_hex(code)}}}")
        code > 127 && jet_rust_emit_debug_escaped(code) -> Val("\\u{{{jet_rust_emit_hex(code)}}}")
        else -> None
    }
}

// Rust `{:?}` of a str (MIRRust `format!("{value:?}")`): the reference emitter
// spells every string literal, panic text and source path this way.
fn jet_rust_emit_quote(value: String) -> String Never! {
    bytes :: value.bytes()
    out := [U8]{34}
    index := 0
    loop index < bytes.len() {
        lead :: Int.from_u8(bytes[index])
        width :: if {
            lead < 128 -> 1
            lead >= 240 -> 4
            lead >= 224 -> 3
            else -> 2
        }
        code := if width == 1 -> lead else -> if width == 2 -> lead % 32 else -> if width == 3 -> lead % 16 else -> lead % 8
        loop offset in 1..<width {
            if index + offset < bytes.len() -> code = code * 64 + Int.from_u8(bytes[index + offset]) % 64
        }
        if jet_rust_emit_debug_escape(code, 34) == .Val(escape) {
            loop byte in escape.bytes() -> &out.push(byte)
        } else {
            loop offset in 0..<width {
                if index + offset < bytes.len() -> &out.push(bytes[index + offset])
            }
        }
        index += width
    }
    &out.push(U8{34})
    String.from_bytes(out) ?? "\"\""
}

// Rust `{:?}` of a char (MIRRust `format!("{value:?}")` for Char constants).
fn jet_rust_emit_char_literal(code: Int) -> String Never! {
    if jet_rust_emit_debug_escape(code, 39) == .Val(escape) -> return "'{escape}'"
    out := [U8]{39}
    if {
        code < 128 -> &out.push(U8{code})
        code < 2048 -> {
            &out.push(U8{192 + code /% 64})
            &out.push(U8{128 + code % 64})
        }
        code < 65536 -> {
            &out.push(U8{224 + code /% 4096})
            &out.push(U8{128 + (code /% 64) % 64})
            &out.push(U8{128 + code % 64})
        }
        else -> {
            &out.push(U8{240 + code /% 262144})
            &out.push(U8{128 + (code /% 4096) % 64})
            &out.push(U8{128 + (code /% 64) % 64})
            &out.push(U8{128 + code % 64})
        }
    }
    &out.push(U8{39})
    String.from_bytes(out) ?? "'\\u{{{jet_rust_emit_hex(code)}}}'"
}

fn jet_rust_emit_failure(kind: JetRustEmitFailureKind, code: String, message: String, detail: String, span: Span?) -> JetRustEmitFailure Never! {
    JetRustEmitFailure{kind: kind, code: code, message: message, detail: detail, span: span}
}

fn jet_rust_emit_fail(ctx: &JetRustEmitContext, kind: JetRustEmitFailureKind, code: String, message: String, detail: String, span: Span?) Never! {
    if ctx.failure == None {
        ctx.failure = Val(jet_rust_emit_failure(kind, code, message, detail, span))
    }
}

fn jet_rust_emit_function_name(ctx: &JetRustEmitContext, id: MIRFunctionID) -> String Never! {
    if ctx.function_names.get(jet_rust_emit_id_key(id.value)) == .Val(name) -> return name
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR function identity is missing from the emitter registry", "checked callees must resolve to one canonical source-emission symbol", None)
    "__jet_missing_function_{id.value}"
}

fn jet_rust_emit_type_name(ctx: &JetRustEmitContext, id: MIRTypeID) -> String Never! {
    if ctx.type_names.get(jet_rust_emit_id_key(id.value)) == .Val(name) -> return name
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR type identity is missing from the emitter registry", "checked nominal references must resolve to one canonical source-emission symbol", None)
    "__jet_missing_type_{id.value}"
}

fn jet_rust_emit_trait_name(ctx: &JetRustEmitContext, id: MIRTraitID) -> String Never! {
    if ctx.trait_names.get(jet_rust_emit_id_key(id.value)) == .Val(name) -> return name
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR trait identity is missing from the emitter registry", "checked trait bounds must resolve to one canonical source-emission symbol", None)
    "__jet_missing_trait_{id.value}"
}

// MIRRust mir_type_single_trait_objects: record every declared trait that
// `ty` uses as a single-bound trait object.
fn jet_rust_emit_collect_dyn_clone_traits(ctx: &JetRustEmitContext, ty: MIRType) Never! {
    if ty.kind == {
        .TraitObject(bounds) -> {
            if bounds.len() != 1 -> return
            key :: jet_rust_emit_id_key(bounds[0].id.value)
            index :: ctx.trait_index_by_id.get(key) ?? return
            row :: ctx.program.traits[index]
            if jet_rust_emit_compiler_owned_trait(row.name) || jet_rust_emit_compiler_owned_trait(row.key) -> return
            ctx.dyn_clone_traits[key] = true
        }
        .Apply(_, inner) | .Union(inner) -> loop item in inner -> jet_rust_emit_collect_dyn_clone_traits(&ctx, item)
        .List(inner) | .Shared(inner) | .Option(inner) | .FixedList(inner, _) | .InlineRange(inner, _, _) | .Tagged(_, inner) | .Quantity(inner, _) -> jet_rust_emit_collect_dyn_clone_traits(&ctx, inner)
        .Map(key, value) | .Result(key, value) -> {
            jet_rust_emit_collect_dyn_clone_traits(&ctx, key)
            jet_rust_emit_collect_dyn_clone_traits(&ctx, value)
        }
        .Tuple(fields) -> loop field in fields -> jet_rust_emit_collect_dyn_clone_traits(&ctx, field.ty)
        .Fn(signature) -> {
            loop param in signature.params -> jet_rust_emit_collect_dyn_clone_traits(&ctx, param)
            if signature.ret == .Val(ret) -> jet_rust_emit_collect_dyn_clone_traits(&ctx, ret)
        }
        .SendFn(params, ret, _) -> {
            loop param in params -> jet_rust_emit_collect_dyn_clone_traits(&ctx, param)
            if ret == .Val(result) -> jet_rust_emit_collect_dyn_clone_traits(&ctx, result)
        }
        else -> {}
    }
}

fn jet_rust_emit_field_name(ctx: &JetRustEmitContext, id: MIRFieldID) -> String Never! {
    if ctx.field_names.get(jet_rust_emit_id_key(id.value)) == .Val(name) -> return name
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR field identity is missing from the emitter registry", "checked field projections must resolve to one canonical source-emission symbol", None)
    "__jet_missing_field_{id.value}"
}

// MIRRust collect_type_fields: a native carrier keeps the Prelude field name.
fn jet_rust_emit_register_field(ctx: &JetRustEmitContext, id: MIRFieldID, raw: String, native: Bool, span: Span) Never! {
    key :: jet_rust_emit_id_key(id.value)
    symbol :: if native -> raw else -> jet_rust_emit_mangle(raw)
    prior :: ctx.field_names.get(key)
    if prior == .Val(existing) {
        if existing != symbol -> jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingIdentity, "E0003", "MIR field identity maps to conflicting symbols", "each checked field ID must retain one canonical source-emission name", Val(span))
        return
    }
    &ctx.field_names.add(key, symbol).drop("the prior lookup proved this field key is new")
}

fn jet_rust_emit_variant_name(ctx: &JetRustEmitContext, type_id: MIRTypeID, variant: String) -> String Never! {
    key :: "{type_id.value}:{variant}"
    symbol :: ctx.variant_names.get(key)
    if symbol == .Val(path) {
        last := ""
        loop part in path.split("::") -> last = part
        if last.len() > 0 -> return last
    }
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR enum variant identity is missing from the emitter registry", "checked enum values must resolve to one canonical variant symbol", None)
    jet_rust_emit_mangle_variant(variant)
}

// The variant path of a folded enum constant: through its resolved
// declaration's ID-keyed registry row, else the named type plus the variant's
// mangle (MIRRust constant / typed_enum_constant).
fn jet_rust_emit_variant_symbol(ctx: &JetRustEmitContext, definition: MIRTypeDef?, type_name: String, variant: String) -> String Never! {
    if definition == .Val(row) -> return "{jet_rust_emit_type_name(&ctx, row.id)}::{jet_rust_emit_variant_name(&ctx, row.id, variant)}"
    native :: jet_rust_emit_has_native_type_projection(type_name)
    "{jet_rust_emit_named_type(&ctx, type_name)}::{if native -> variant else -> jet_rust_emit_mangle_variant(variant)}"
}

fn jet_rust_emit_same_handle_type(left: MIRType, right: MIRType) -> Bool Never! {
    if mir_type_same_checked_type(left, right) -> return true
    if left.kind == {
        .Apply(left_name, _) -> {
            if right.kind == {
                .Apply(right_name, _) -> left_name.name == right_name.name
                else -> false
            }
        }
        else -> false
    }
}

fn jet_rust_emit_foreign_name(ctx: &JetRustEmitContext, id: MIRForeignID) -> String Never! {
    if ctx.foreign_names.get(jet_rust_emit_id_key(id.value)) == .Val(name) -> return name
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR foreign identity is missing from the emitter registry", "checked foreign calls must resolve to one canonical source-emission symbol", None)
    "__jet_missing_foreign_{id.value}"
}

// A list write parameter that receives a range window, directly
// (`fill(&values[1..3])`) or through a caller's own window parameter passed
// onward, is emitted as `&mut [T]` so the callee edits the owner's storage in
// place. Sema admits a range window only for a parameter proven
// length-preserving; whole-list callers still pass `&mut Vec<T>`, which
// coerces.
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::collect_window_params
fn jet_rust_emit_collect_window_params(program: MIRProgram) -> [String:Bool] Never! {
    // Last row per function id, matching the scan this index replaces.
    function_index := [String:Int]{}
    loop (index, function) in program.functions -> function_index[jet_rust_emit_id_key(function.id.value)] = index
    // One walk records each list write parameter a caller fills with a range
    // window (a seed) and each one it fills with its own parameter (an edge
    // from that caller parameter). The windows are the seeds and everything
    // they reach along the edges, the same least fixed point the former
    // whole-program rescans reached.
    windows := [String:Bool]{}
    forward_slots := [String:Int]{}
    forwards := [[String]]{}
    pending := [String]{}
    loop function in program.functions {
        // Built on the first write argument this function passes: first
        // place row per id, and the parameter index of each value whose
        // first producer is a `Parameter` (-1 otherwise).
        place_rows := [String:Int]{}
        parameter_values := [String:Int]{}
        indexed := false
        loop block in function.blocks {
            loop instruction in block.instructions {
                if instruction.operation == .Call(callee, args, _) {
                    target := MIRFunctionID?{None}
                    if callee == {
                        .User(id) | .Associated(id, _) | .Method(id, _) -> target = Val(id)
                        else -> {}
                    }
                    target_id :: target ?? next
                    callee_index :: function_index.get(jet_rust_emit_id_key(target_id.value)) ?? next
                    loop (position, arg) in args {
                        if arg.access != MIRAccess.Write || position >= program.functions[callee_index].params.len() -> next
                        place_id :: arg.place ?? next
                        if !indexed {
                            loop (index, place) in function.places {
                                key :: jet_rust_emit_id_key(place.id.value)
                                if place_rows.get(key) == None -> place_rows[key] = index
                            }
                            loop scan_block in function.blocks {
                                loop scan in scan_block.instructions {
                                    result :: scan.result ?? next
                                    key :: jet_rust_emit_id_key(result.value)
                                    if parameter_values.get(key) != None -> next
                                    parameter_values[key] = if scan.operation == {
                                        .Parameter(index, _) -> index
                                        else -> -1
                                    }
                                }
                            }
                            indexed = true
                        }
                        param :: program.functions[callee_index].params[position]
                        list_param :: if param.ty.kind == {
                            .List(_) -> true
                            else -> false
                        }
                        if !list_param -> next
                        key :: "{target_id.value}:{param.index}"
                        place_index :: place_rows.get(jet_rust_emit_id_key(place_id.value)) ?? next
                        place :: function.places[place_index]
                        if place.projections.len() > 0 {
                            if place.projections[place.projections.len() - 1] == .Range(_, _, _) {
                                if windows.get(key) == None {
                                    windows[key] = true
                                    &pending.push(key)
                                }
                            }
                        }
                        if place.projections.len() == 0 {
                            if place.base == .Parameter(value) {
                                if parameter_values.get(jet_rust_emit_id_key(value.value)) == .Val(index) {
                                    if index >= 0 {
                                        source :: "{function.id.value}:{index}"
                                        slot := forward_slots.get(source) ?? -1
                                        if slot < 0 {
                                            slot = forwards.len()
                                            forward_slots[source] = slot
                                            &forwards.push([String]{})
                                        }
                                        &forwards[slot].push(key)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    cursor := 0
    loop cursor < pending.len() {
        source := pending[cursor]
        cursor += 1
        slot :: forward_slots.get(source) ?? next
        loop key in forwards[slot] {
            if windows.get(key) == None {
                windows[key] = true
                &pending.push(key)
            }
        }
    }
    windows
}

fn jet_rust_emit_window_param(ctx: JetRustEmitContext, function: MIRFunctionID, index: Int) -> Bool Never! {
    ctx.window_params.get("{function.value}:{index}") != None
}

// The first function row with this id (ids are unique once the context is built).
fn jet_rust_emit_function_index(ctx: JetRustEmitContext, id: MIRFunctionID) -> Int? {
    ctx.function_index_by_id.get(jet_rust_emit_id_key(id.value))
}

fn jet_rust_emit_foreign_index(ctx: JetRustEmitContext, id: MIRForeignID) -> Int? {
    ctx.foreign_index_by_id.get(jet_rust_emit_id_key(id.value))
}

fn jet_rust_emit_trait_index(ctx: JetRustEmitContext, id: MIRTraitID) -> Int? {
    ctx.trait_index_by_id.get(jet_rust_emit_id_key(id.value))
}

// First (`first`) or last type-instance row whose identity is `id`.
fn jet_rust_emit_type_instance(ctx: JetRustEmitContext, id: MIRTypeID, first: Bool) -> MIRType? {
    key :: jet_rust_emit_id_key(id.value)
    found :: if first -> ctx.type_instance_first.get(key) else -> ctx.type_instance_last.get(key)
    index :: found ?? return None
    Val(ctx.program.type_instances[index])
}

fn jet_rust_emit_core_index(ctx: JetRustEmitContext, id: MIRCoreCallID) -> Int? {
    ctx.core_call_index_by_id.get(jet_rust_emit_id_key(id.value))
}

// First (`first`) or last Prelude route row with this id.
fn jet_rust_emit_prelude_route(ctx: JetRustEmitContext, id: MIRPreludeCallID, first: Bool) -> MIRPreludeCall? {
    key :: jet_rust_emit_id_key(id.value)
    found :: if first -> ctx.prelude_call_first.get(key) else -> ctx.prelude_call_last.get(key)
    index :: found ?? return None
    Val(ctx.program.prelude_calls[index])
}

fn jet_rust_emit_prelude_route_rows(ctx: JetRustEmitContext, id: MIRPreludeCallID) -> [MIRPreludeCall] Never! {
    row :: jet_rust_emit_prelude_route(ctx, id, true) ?? return [MIRPreludeCall]{}
    [MIRPreludeCall]{row}
}

fn jet_rust_emit_core_rows(ctx: JetRustEmitContext, id: MIRCoreCallID) -> [MIRCoreCall] Never! {
    index :: jet_rust_emit_core_index(ctx, id) ?? return [MIRCoreCall]{}
    [MIRCoreCall]{ctx.program.core_calls[index]}
}

fn jet_rust_emit_foreign_rows(ctx: JetRustEmitContext, id: MIRForeignID) -> [MIRForeign] Never! {
    index :: jet_rust_emit_foreign_index(ctx, id) ?? return [MIRForeign]{}
    [MIRForeign]{ctx.program.foreign[index]}
}

fn jet_rust_emit_trait_rows(ctx: JetRustEmitContext, id: MIRTraitID) -> [MIRTraitDef] Never! {
    index :: jet_rust_emit_trait_index(ctx, id) ?? return [MIRTraitDef]{}
    [MIRTraitDef]{ctx.program.traits[index]}
}

// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::new
fn jet_rust_emit_type_index(ctx: JetRustEmitContext, id: MIRTypeID) -> Int? {
    ctx.type_index_by_id.get(jet_rust_emit_id_key(id.value))
}

// program.fields rows with this id, first to last.
fn jet_rust_emit_field_rows(ctx: JetRustEmitContext, id: MIRFieldID) -> [MIRFieldRow] Never! {
    key :: jet_rust_emit_id_key(id.value)
    first :: ctx.field_index_by_id.get(key) ?? return [MIRFieldRow]{}
    last :: ctx.field_last_index_by_id.get(key) ?? first
    if first == last -> return [MIRFieldRow]{ctx.program.fields[first]}
    rows := [MIRFieldRow]{}
    loop index in first..<(last + 1) {
        if ctx.program.fields[index].id == id -> &rows.push(ctx.program.fields[index])
    }
    rows
}

// Row of a MIR source file id in `ctx.source_index` (built from
// `program.source_files` in the same order).
fn jet_rust_emit_source_row(ctx: JetRustEmitContext, id: MIRSourceFileID) -> Int? {
    ctx.source_index.by_id.get(id.value)
}

// MIRRust is_compiler_owned_trait: traits whose Rust spelling the cached
// runtime declares once; program trait rows only name them.
fn jet_rust_emit_compiler_owned_trait(name: String) -> Bool Never! {
    owned :: [String]{"Encode", "Decode", "Display", "Debug", "Equatable", "Comparable", "Close", "Index", "IndexMut", "Iterable", "Iterator", "Add", "Sub", "Mul", "Div", "Rollback"}
    owned.contains(name)
}

// MIRRust rust_trait_name: the runtime spelling of a compiler-owned trait
// (Generics rust_trait_bound, else the plain `__jet_` mangle).
fn jet_rust_emit_compiler_trait_symbol(name: String) -> String Never! {
    if {
        name == "Display" -> "__jet_Display"
        name == "Debug" -> "JetDebug"
        name == "Equatable" -> "__jet_Equatable"
        name == "Comparable" -> "__jet_Comparable"
        name == "Encode" -> "__jet_Encode"
        name == "Decode" -> "__jet_Decode"
        name == "Close" -> "__jet_Close"
        name == "Add" -> "__jet_Add"
        name == "Sub" -> "__jet_Sub"
        name == "Mul" -> "__jet_Mul"
        name == "Div" -> "__jet_Div"
        name == "Index" -> "__jet_Index"
        name == "IndexMut" -> "__jet_IndexMut"
        else -> jet_rust_emit_mangle(name)
    }
}

// The context owns its MIR snapshot; the public emission caller retains the
// checked program for its compile result. Do not copy that snapshot again
// during item traversal or metadata collection.
// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::new
fn jet_rust_emit_context(program: MIRProgram, config: JetRustEmitConfig) -> JetRustEmitContext Never! {
    functions := [String:String]{}
    types := [String:String]{}
    type_by_name := [String:String]{}
    traits := [String:String]{}
    fields := [String:String]{}
    variants := [String:String]{}
    variant_source_names := [String:String]{}
    variant_wire_names := [String:String]{}
    foreigns := [String:String]{}
    // First-row indexes of program.types and the selected-trait impl rows, so
    // per-type derive queries do not rescan every row (MIRRust type_def_by_* /
    // impls_by_trait).
    type_index_by_id := [String:Int]{}
    type_index_by_key := [String:Int]{}
    type_index_by_name := [String:Int]{}
    columnar_type_names := [String:Bool]{}
    loop (index, definition) in program.types {
        id_key :: jet_rust_emit_id_key(definition.id.value)
        if type_index_by_id.get(id_key) == None -> type_index_by_id[id_key] = index
        if type_index_by_key.get(definition.key) == None -> type_index_by_key[definition.key] = index
        if type_index_by_name.get(definition.name) == None -> type_index_by_name[definition.name] = index
        if definition.layout == .Val(layout) {
            if layout == {
                .Columnar -> {
                    columnar_type_names[definition.key] = true
                    columnar_type_names[definition.name] = true
                }
                else -> {}
            }
        }
    }
    function_index_by_id := [String:Int]{}
    loop (index, function) in program.functions {
        key :: jet_rust_emit_id_key(function.id.value)
        if function_index_by_id.get(key) == None -> function_index_by_id[key] = index
    }
    foreign_index_by_id := [String:Int]{}
    loop (index, foreign) in program.foreign {
        key :: jet_rust_emit_id_key(foreign.id.value)
        if foreign_index_by_id.get(key) == None -> foreign_index_by_id[key] = index
    }
    trait_index_by_id := [String:Int]{}
    loop (index, trait_row) in program.traits {
        key :: jet_rust_emit_id_key(trait_row.id.value)
        if trait_index_by_id.get(key) == None -> trait_index_by_id[key] = index
    }
    field_index_by_id := [String:Int]{}
    field_last_index_by_id := [String:Int]{}
    field_rows_by_owner := [String:[Int]]{}
    field_owner_slots := [String:Int]{}
    field_owner_keys := [String]{}
    field_owner_rows := [[Int]]{}
    loop (index, row) in program.fields {
        key :: jet_rust_emit_id_key(row.id.value)
        if field_index_by_id.get(key) == None -> field_index_by_id[key] = index
        field_last_index_by_id[key] = index
        owner_key :: jet_rust_emit_id_key(row.owner.value)
        slot := field_owner_slots.get(owner_key) ?? -1
        if slot < 0 {
            slot = field_owner_rows.len()
            field_owner_slots[owner_key] = slot
            &field_owner_keys.push(owner_key)
            &field_owner_rows.push([Int]{})
        }
        &field_owner_rows[slot].push(index)
    }
    loop slot in 0..<field_owner_rows.len() -> field_rows_by_owner[field_owner_keys[slot]] = field_owner_rows[slot]
    type_instance_first := [String:Int]{}
    type_instance_last := [String:Int]{}
    loop (index, instance) in program.type_instances {
        identity :: instance.identity ?? next
        key :: jet_rust_emit_id_key(identity.value)
        if type_instance_first.get(key) == None -> type_instance_first[key] = index
        type_instance_last[key] = index
    }
    core_call_index_by_id := [String:Int]{}
    loop (index, row) in program.core_calls {
        key :: jet_rust_emit_id_key(row.id.value)
        if core_call_index_by_id.get(key) == None -> core_call_index_by_id[key] = index
    }
    prelude_call_first := [String:Int]{}
    prelude_call_last := [String:Int]{}
    loop (index, row) in program.prelude_calls {
        key :: jet_rust_emit_id_key(row.id.value)
        if prelude_call_first.get(key) == None -> prelude_call_first[key] = index
        prelude_call_last[key] = index
    }
    impls_by_trait := [String:[Int]]{}
    impl_trait_slots := [String:Int]{}
    impl_trait_keys := [String]{}
    impl_trait_rows := [[Int]]{}
    loop (index, implementation) in program.impls {
        if implementation.trait_ref == .Val(trait_ref) {
            trait_key :: jet_rust_emit_id_key(trait_ref.id.value)
            slot := impl_trait_slots.get(trait_key) ?? -1
            if slot < 0 {
                slot = impl_trait_rows.len()
                impl_trait_slots[trait_key] = slot
                &impl_trait_keys.push(trait_key)
                &impl_trait_rows.push([Int]{})
            }
            &impl_trait_rows[slot].push(index)
        }
    }
    loop slot in 0..<impl_trait_rows.len() -> impls_by_trait[impl_trait_keys[slot]] = impl_trait_rows[slot]
    ctx := JetRustEmitContext{
        program: program,
        config: config,
        function_names: functions,
        type_names: types,
        type_by_name: type_by_name,
        trait_names: traits,
        dyn_clone_traits: [String:Bool]{},
        field_names: fields,
        variant_names: variants,
        variant_source_names: variant_source_names,
        variant_wire_names: variant_wire_names,
        foreign_names: foreigns,
        failure: None,
        current_function: None,
        current_generic_params: [MIRGenericParam]{},
        window_params: jet_rust_emit_collect_window_params(program),
        source_index: jet_codegen_source_index(program.source_files),
        type_index_by_id: type_index_by_id,
        type_index_by_key: type_index_by_key,
        type_index_by_name: type_index_by_name,
        impls_by_trait: impls_by_trait,
        function_index_by_id: function_index_by_id,
        foreign_index_by_id: foreign_index_by_id,
        trait_index_by_id: trait_index_by_id,
        field_index_by_id: field_index_by_id,
        field_last_index_by_id: field_last_index_by_id,
        field_rows_by_owner: field_rows_by_owner,
        type_instance_first: type_instance_first,
        type_instance_last: type_instance_last,
        columnar_type_names: columnar_type_names,
        core_call_index_by_id: core_call_index_by_id,
        prelude_call_first: prelude_call_first,
        prelude_call_last: prelude_call_last,
        derive_capability_cache: [String:Bool]{},
        derive_capability_cycle_floor: JET_RUST_EMIT_NO_CYCLE_FLOOR,
        skipped_methods: [String:Bool]{},
        move_facts: jet_rust_emit_empty_move_facts(),
        ref_bindings: jet_rust_emit_empty_ref_bindings(),
        body_index: jet_rust_emit_empty_body_index(),
        unit_ratio_function: None,
        unit_ratio_parameters: [U64:Bool]{},
        selected_modules: [String:Bool]{},
        all_modules_selected: true,
    }
    if ctx.program.schema_version != MIR_SCHEMA_VERSION {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR schema is not supported by the Jet Rust emitter", "rebuild the emitter and lowering together so both sides use the same MIR schema", None)
        return ctx
    }
    if ctx.config.target != "rust_aot" && ctx.config.target != "web" {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.UnsupportedTarget, "E0003", "Rust source emission received an unsupported target partition", "the current Jet emitter accepts only rust_aot or web", None)
        return ctx
    }
    if ctx.config.web_bucket != None && ctx.config.target != "web" {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.UnsupportedTarget, "E0003", "Web partition emission requires the web target", "only Web target emission may select a checked JS/Wasm bucket", None)
        return ctx
    }

    loop function_index in 0..<ctx.program.functions.len() {
        function := ctx.program.functions[function_index]
        key :: jet_rust_emit_id_key(function.id.value)
        if ctx.function_names.get(key) != None {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingIdentity, "E0003", "MIR function identity is duplicated", "each checked function must have one stable source-emission symbol", Val(function.span))
            return ctx
        }
        &ctx.function_names.add(key, jet_rust_emit_generated_path(function.key)).drop("the prior lookup proved this function key is new")
    }
    native_type_keys := [String:Bool]{}
    loop definition in ctx.program.types {
        key :: jet_rust_emit_id_key(definition.id.value)
        if ctx.type_names.get(key) != None {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingIdentity, "E0003", "MIR type identity is duplicated", "each nominal type must have one stable source-emission symbol", Val(definition.span))
            return ctx
        }
        // MIRRust type_name/collect_type_fields: a Prelude carrier keeps its native
        // Rust spelling and its raw field and variant names. The compiler-owned
        // default Err is the Prelude `JetErr` (Rust keys it `Err`, which the
        // native projection resolves); its MIR key is module-qualified here, so
        // the checked builtin fact selects it.
        default_err :: definition.compiler_builtin == (Val(MIRCompilerBuiltin.DefaultErr))
        native :: default_err || jet_rust_emit_has_native_type_projection(definition.key) || jet_rust_emit_vault_host_record(definition.key)
        if native -> native_type_keys[key] = true
        symbol :: if definition.compiler_builtin == {
            .Val(builtin) -> {
                if builtin == MIRCompilerBuiltin.DefaultErr -> "{ctx.config.root_prefix}JetErr" else -> jet_rust_emit_generated_path(definition.key)
            }
            else -> if jet_rust_emit_has_native_type_projection(definition.key) -> jet_rust_emit_apply_type(&ctx, MIRNominalRef{id: definition.id, name: definition.key}, [MIRType]{}) else -> jet_rust_emit_generated_path(definition.key)
        }
        &ctx.type_names.add(key, symbol).drop("the prior lookup proved this type key is new")
        &ctx.type_by_name.add(definition.key, symbol).drop("a later same-named row takes the canonical key spelling")
        &ctx.type_by_name.add(definition.name, symbol).drop("a later same-named row takes the leaf spelling")
        if definition.kind == {
            .Struct(declared, _) -> {
                loop field in declared {
                    jet_rust_emit_register_field(&ctx, field.id, field.name, native, field.span)
                }
            }
            .Enum(enum_variants, _) -> {
                loop variant in enum_variants {
                    variant_key :: "{key}:{variant.name}"
                    if ctx.variant_names.get(variant_key) != None {
                        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingIdentity, "E0003", "MIR enum variant identity is duplicated", "each checked variant key must map to one stable source-emission symbol", Val(variant.span))
                        return ctx
                    }
                    variant_symbol :: if native -> "{symbol}::{variant.name}" else -> "{symbol}::{jet_rust_emit_mangle_variant(variant.name)}"
                    &ctx.variant_names.add(variant_key, variant_symbol).drop("the prior lookup proved this variant key is new")
                    &ctx.variant_source_names.add(variant_key, variant.name).drop("the prior lookup proved this variant key is new")
                    &ctx.variant_wire_names.add(variant_key, variant.wire_name).drop("the prior lookup proved this variant key is new")
                    if variant.payload == {
                        .Named(declared) -> loop field in declared {
                            jet_rust_emit_register_field(&ctx, field.id, field.name, native, field.span)
                        }
                        else -> {}
                    }
                }
            }
            else -> {}
        }
    }
    loop trait_row in ctx.program.traits {
        key :: jet_rust_emit_id_key(trait_row.id.value)
        if ctx.trait_names.get(key) != None {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingIdentity, "E0003", "MIR trait identity is duplicated", "each checked trait must have one stable source-emission symbol", Val(trait_row.span))
            return ctx
        }
        symbol :: if jet_rust_emit_compiler_owned_trait(trait_row.name) -> jet_rust_emit_compiler_trait_symbol(trait_row.name) else -> jet_rust_emit_generated_path(trait_row.key)
        &ctx.trait_names.add(key, symbol).drop("the prior lookup proved this trait key is new")
    }
    loop instance in ctx.program.type_instances -> jet_rust_emit_collect_dyn_clone_traits(&ctx, instance)
    loop foreign in ctx.program.foreign {
        key :: jet_rust_emit_id_key(foreign.id.value)
        if ctx.foreign_names.get(key) != None {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingIdentity, "E0003", "MIR foreign identity is duplicated", "each foreign declaration must have one stable source-emission symbol", Val(foreign.span))
            return ctx
        }
        name :: if foreign.name.len() == 0 -> jet_rust_emit_generated_path(foreign.key) else -> jet_rust_emit_mangle(foreign.name)
        &ctx.foreign_names.add(key, name).drop("the prior lookup proved this foreign key is new")
    }
    // MIRRust RustEmitter::new: a structural tuple projects its members by
    // position, keyed by the same field identity lowering derives from the
    // tuple's identity and member name.
    loop instance in ctx.program.type_instances {
        if instance.kind == .Tuple(members) {
            identity :: mir_type_identity_key(instance)
            loop (index, member) in members {
                key :: jet_rust_emit_id_key(mir_field_id("{identity}::{member.name}").value)
                ctx.field_names[key] = "{index}"
            }
        }
    }
    loop row in ctx.program.fields {
        if ctx.field_names.get(jet_rust_emit_id_key(row.id.value)) != None -> next
        jet_rust_emit_register_field(&ctx, row.id, row.field.name, native_type_keys.get(jet_rust_emit_id_key(row.owner.value)) != None, row.field.span)
    }
    ctx
}

fn jet_rust_emit_source_line(lines: &[String], line: String) Never! { &lines.push(line) }

fn jet_rust_emit_type_metadata(ctx: &JetRustEmitContext) -> [JetRustEmitTypeMetadata] Never! {
    out := [JetRustEmitTypeMetadata]{}
    if !ctx.config.emit_types -> return out
    loop definition in ctx.program.types {
        symbol :: ctx.type_names.get(jet_rust_emit_id_key(definition.id.value)) ?? {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR type identity is missing from the emitter registry", "type metadata must use the same canonical symbol as emitted type declarations", Val(definition.span))
            next
        }
        &out.push(JetRustEmitTypeMetadata{
            ty: definition.id,
            source_name: definition.name,
            symbol: symbol,
        })
    }
    out
}

fn jet_rust_emit_callable_metadata(ctx: &JetRustEmitContext) -> [JetRustEmitCallableMetadata] Never! {
    out := [JetRustEmitCallableMetadata]{}
    loop function_index in 0..<ctx.program.functions.len() {
        function := ctx.program.functions[function_index]
        if !jet_rust_emit_function_target_enabled(ctx.config, function) -> next
        top_level :: if function.form == {
            .TopLevel -> true
            else -> false
        }
        if !top_level -> next
        previous_generic_params := ctx.current_generic_params
        owner_generic_params :: jet_rust_emit_function_owner_generic_params(&ctx, function)
        function_scope :: jet_rust_emit_merge_generic_params(previous_generic_params, owner_generic_params)
        ctx.current_generic_params = jet_rust_emit_merge_generic_params(function_scope, function.generic_params)
        parameter_types := [String]{}
        parameter_access := [MIRAccess]{}
        parameter_mir_types := [MIRType]{}
        loop parameter in function.params {
            &parameter_types.push(jet_rust_emit_callable_param_type(&ctx, parameter.ty, parameter.access))
            &parameter_access.push(parameter.access)
            &parameter_mir_types.push(parameter.ty)
        }
        &out.push(JetRustEmitCallableMetadata{
            function: function.id,
            symbol: jet_rust_emit_function_name(&ctx, function.id),
            source_name: function.name,
            parameter_types: parameter_types,
            parameter_access: parameter_access,
            return_type: jet_rust_emit_type(&ctx, function.return_type),
            callable_type: jet_rust_emit_callable_type_parts(&ctx, parameter_mir_types, parameter_access, Val(function.return_type)),
        })
        ctx.current_generic_params = previous_generic_params
    }
    out
}

fn jet_rust_emit_field_metadata(ctx: &JetRustEmitContext) -> [JetRustEmitFieldMetadata] Never! {
    out := [JetRustEmitFieldMetadata]{}
    loop row in ctx.program.fields {
        &out.push(JetRustEmitFieldMetadata{
            field: row.id,
            owner: row.owner,
            source_name: row.field.name,
            symbol: jet_rust_emit_field_name(&ctx, row.id),
        })
    }
    out
}

fn jet_rust_emit_variant_metadata(ctx: &JetRustEmitContext) -> [JetRustEmitVariantMetadata] Never! {
    out := [JetRustEmitVariantMetadata]{}
    if !ctx.config.emit_types -> return out
    loop definition in ctx.program.types {
        // Variant rows describe the enums this artifact declares; the
        // runtime's own carriers keep their payload spellings there.
        if !jet_rust_emit_declares_type_definition(&ctx, definition) -> next
        previous_generic_params := ctx.current_generic_params
        ctx.current_generic_params = jet_rust_emit_merge_generic_params(previous_generic_params, definition.generic_params)
        if definition.kind == {
            .Enum(variants, _) -> {
                loop variant in variants {
                    key :: "{definition.id.value}:{variant.name}"
                    symbol :: ctx.variant_names.get(key) ?? {
                        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR enum variant identity is missing from the emitter registry", "variant metadata must use the same canonical symbol as emitted enum declarations", Val(variant.span))
                        next
                    }
                    payload_types := [String]{}
                    if variant.payload == {
                        .Single(value) -> &payload_types.push(jet_rust_emit_type(&ctx, value))
                        .Named(fields) -> loop field in fields -> &payload_types.push(jet_rust_emit_type(&ctx, field.ty))
                        else -> {}
                    }
                    &out.push(JetRustEmitVariantMetadata{
                        owner: definition.id,
                        source_name: variant.name,
                        wire_name: variant.wire_name,
                        symbol: symbol,
                        payload_types: payload_types,
                    })
                }
            }
            else -> {}
        }
        ctx.current_generic_params = previous_generic_params
    }
    out
}

fn jet_rust_emit_trait_metadata(ctx: &JetRustEmitContext) -> [JetRustEmitTraitMetadata] Never! {
    out := [JetRustEmitTraitMetadata]{}
    if !ctx.config.emit_types -> return out
    loop definition in ctx.program.traits {
        &out.push(JetRustEmitTraitMetadata{
            trait_id: definition.id,
            key: definition.key,
            name: definition.name,
            symbol: jet_rust_emit_trait_name(&ctx, definition.id),
        })
    }
    out
}

fn jet_rust_emit_trait_method_metadata(ctx: &JetRustEmitContext) -> [JetRustEmitTraitMethodMetadata] Never! {
    out := [JetRustEmitTraitMethodMetadata]{}
    if !ctx.config.emit_types -> return out
    loop definition in ctx.program.traits {
        module_key := String?{None}
        loop module_row in ctx.program.modules {
            if module_row.id == definition.module_id -> module_key = Val(module_row.key)
        }
        key_prefix :: module_key ?? {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR trait module is missing", "trait method metadata keys require the canonical module key from the trait's owning module", Val(definition.span))
            next
        }
        loop method in definition.methods {
            parameter_types := [String]{}
            parameter_access := [MIRAccess]{}
            loop parameter in method.params {
                &parameter_types.push(jet_rust_emit_callable_param_type(&ctx, parameter.ty, parameter.access))
                &parameter_access.push(parameter.access)
            }
            &out.push(JetRustEmitTraitMethodMetadata{
                trait_id: definition.id,
                method_id: method.id,
                key: "{key_prefix}::{method.name}",
                name: method.name,
                symbol: jet_rust_emit_trait_method_symbol(definition.name, method),
                receiver_access: method.self_access,
                parameter_types: parameter_types,
                parameter_access: parameter_access,
                return_type: jet_rust_emit_type(&ctx, method.return_type),
            })
        }
    }
    out
}

fn jet_rust_emit_result(ctx: &JetRustEmitContext, source: String) -> JetRustEmitResult Never! {
    if ctx.failure == .Val(failure) -> return JetRustEmitResult.Incomplete{failure: failure}
    bytes :: source.bytes().len()
    type_metadata :: jet_rust_emit_type_metadata(&ctx)
    callable_metadata :: jet_rust_emit_callable_metadata(&ctx)
    field_metadata :: jet_rust_emit_field_metadata(&ctx)
    variant_metadata :: jet_rust_emit_variant_metadata(&ctx)
    trait_metadata :: jet_rust_emit_trait_metadata(&ctx)
    trait_method_metadata :: jet_rust_emit_trait_method_metadata(&ctx)
    if ctx.failure == .Val(failure) -> return JetRustEmitResult.Incomplete{failure: failure}
    manifest :: JetRustEmitManifest{
        schema_version: ctx.program.schema_version,
        target: ctx.config.target,
        package_identity: ctx.program.package_identity,
        type_count: ctx.program.types.len(),
        function_count: ctx.program.functions.len(),
        foreign_count: ctx.program.foreign.len(),
        source_bytes: bytes,
        function_symbols: ctx.function_names,
        type_symbols: ctx.type_names,
        field_symbols: ctx.field_names,
        variant_symbols: ctx.variant_names,
        variant_source_names: ctx.variant_source_names,
        variant_wire_names: ctx.variant_wire_names,
        type_metadata: type_metadata,
        callable_metadata: callable_metadata,
        field_metadata: field_metadata,
        variant_metadata: variant_metadata,
        traits: trait_metadata,
        trait_methods: trait_method_metadata,
    }
    JetRustEmitResult.Complete{source: source, manifest: manifest}
}
