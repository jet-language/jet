// The runtime/Core prefix of one native artifact: the text the Rust host
// prepends to the Jet emitter's user-item suffix (Rust:
// crates/jet-codegen/src/Codegen/MIRRust.rs `emit_mir_runtime_text`, whose
// assembly lives in crates/jet-codegen/src/Codegen/mod.rs). It is decided by
// build facts only, never by user source, so both compilers link one cached
// `jet_runtime`. The host reads the Prelude and Foundation `.rs` sources the
// Rust compiler embeds (`jet_rust_runtime_source_paths`, relative to the
// toolchain root); this module alone selects and orders them, byte for byte.
use jet_foundation.[
    DiagnosticRegistryStatus,
    JetReleaseDevtoolsPolicy,
    JetReleaseDevtoolsAuthentication,
    JetReleaseDevtoolsAuthority,
    JetReleaseDevtoolsDeployment,
    JetReleaseDevtoolsEndpoint,
    JetReleaseDevtoolsNetwork,
    JetReleaseDevtoolsPublication,
    JetReleaseInspect,
    MIRArtifactBuildMode,
    MIRArtifactKind,
    MIRArtifactPlan,
    MIRArtifactTarget,
    MIRProgram,
    MIRRuntimePartID,
    MIRSymbol,
    MIRType,
    diagnostic_registry_rows,
    mir_sha256_hex,
]

struct JetRustRuntimeSource { path: String, text: String }

struct JetRustRuntimeAsset { path: String, bytes: [U8] }

struct JetRustRuntimePrefixInputs {
    // rustc target triple (OS fallback when the package facts name none).
    target_triple: String
    policy: JetReleaseDevtoolsPolicy
    // The FFI link crate (`FfiLink.crate_name`); None without foreign Rust.
    ffi_crate: String?
    sources: [JetRustRuntimeSource]
    assets: [JetRustRuntimeAsset]
}

enum JetRustRuntimePrefix {
    Text(text: String)
    // A required source or marker is missing, or the target is not hosted.
    Refused(message: String)
}

struct JetRustPrefixState {
    sources: [JetRustRuntimeSource]
    assets: [JetRustRuntimeAsset]
    failure: String?
}

JET_RUST_PREFIX_PRELUDE :: "crates/jet-codegen/src/Prelude/"
JET_RUST_PREFIX_FOUNDATION :: "crates/jet-foundation/src/"
JET_RUST_PREFIX_CODEGEN_MOD :: "crates/jet-codegen/src/Codegen/mod.rs"
JET_RUST_PREFIX_CARGO :: "crates/jet-codegen/Cargo.toml"
JET_RUST_PREFIX_STACK :: "crates/jet-foundation/src/CompilerStack.rs"
JET_RUST_PREFIX_SYNTAX :: "crates/jet-foundation/src/Syntax/math_layout.rs"
JET_RUST_PREFIX_FONTS :: [String]{
    "Docs/site/assets/fonts/exo2-700.ttf",
    "Docs/site/assets/fonts/noto-sans-arabic-regular.ttf",
    "Docs/site/assets/fonts/noto-sans-symbols2-regular.ttf",
}

