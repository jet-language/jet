// Every text source the assembler may read, relative to the toolchain root.
fn jet_rust_runtime_source_paths() -> [String] Never! {
    paths := [String]{JET_RUST_PREFIX_CODEGEN_MOD, JET_RUST_PREFIX_CARGO, JET_RUST_PREFIX_STACK, JET_RUST_PREFIX_SYNTAX, "crates/jet-rt/src/__gc_core.rs", "crates/jet-rt/src/__gc_host.rs"}
    loop file in JET_RUST_PREFIX_PRELUDE_FILES -> &paths.push("{JET_RUST_PREFIX_PRELUDE}{file}")
    loop file in JET_RUST_PREFIX_FOUNDATION_FILES -> &paths.push("{JET_RUST_PREFIX_FOUNDATION}{file}")
    paths
}

// The binary assets the assembler may read: the canonical UI fonts.
fn jet_rust_runtime_asset_paths() -> [String] Never! { JET_RUST_PREFIX_FONTS }

// The unique Rust AOT artifact a native build emits (Emit/Entry.jet
// `jet_rust_emit_selected_artifact`).
fn jet_rust_runtime_artifact(program: MIRProgram) -> MIRArtifactPlan? Never! {
    selected := MIRArtifactPlan?{None}
    loop artifact in program.artifacts {
        if artifact.target != MIRArtifactTarget.RustAOT -> next
        if selected != None -> return None
        selected = Val(artifact)
    }
    selected
}

// ---- byte text helpers ------------------------------------------------------

fn jet_rust_prefix_find(hay: [U8], needle: [U8], from: Int) -> Int Never! {
    if needle.len() == 0 -> return from
    last :: hay.len() - needle.len()
    first :: needle[0]
    index := from
    loop index <= last {
        if hay[index] == first {
            matched := true
            offset := 1
            loop offset < needle.len() {
                if hay[index + offset] != needle[offset] {
                    matched = false
                    break
                }
                offset += 1
            }
            if matched -> return index
        }
        index += 1
    }
    -1
}

fn jet_rust_prefix_at(bytes: [U8], index: Int, needle: String) -> Bool Never! {
    pattern :: needle.bytes()
    if index < 0 || index + pattern.len() > bytes.len() -> return false
    loop offset in 0..<pattern.len() {
        if bytes[index + offset] != pattern[offset] -> return false
    }
    true
}

fn jet_rust_prefix_slice(bytes: [U8], start: Int, end: Int) -> String Never! {
    if end <= start -> return ""
    String.from_bytes(bytes.slice(start, end)) ?? ""
}

// Rust `str::replace`: every non-overlapping match, left to right.
fn jet_rust_prefix_replace(text: String, from: String, to: String) -> String Never! {
    bytes :: text.bytes()
    pattern :: from.bytes()
    at := jet_rust_prefix_find(bytes, pattern, 0)
    if at < 0 -> return text.copy()
    parts := [String]{}
    kept := 0
    loop at >= 0 {
        &parts.push(jet_rust_prefix_slice(bytes, kept, at))
        &parts.push(to)
        kept = at + pattern.len()
        at = jet_rust_prefix_find(bytes, pattern, kept)
    }
    &parts.push(jet_rust_prefix_slice(bytes, kept, bytes.len()))
    parts.join("")
}

fn jet_rust_prefix_is_space(byte: U8) -> Bool Never! {
    value :: Int.from_u8(byte)
    value == 32 || value == 9 || value == 10 || value == 12 || value == 13
}

// Rust `str::trim` over ASCII whitespace, as byte bounds [start, end).
fn jet_rust_prefix_trim(bytes: [U8], start: Int, end: Int) -> String Never! {
    low := start
    high := end
    loop low < high && jet_rust_prefix_is_space(bytes[low]) -> low += 1
    loop high > low && jet_rust_prefix_is_space(bytes[high - 1]) -> high -= 1
    jet_rust_prefix_slice(bytes, low, high)
}

fn jet_rust_prefix_trim_text(text: String) -> String Never! {
    bytes :: text.bytes()
    jet_rust_prefix_trim(bytes, 0, bytes.len())
}

// Byte-wise order (Rust `str` Ord / BTreeMap key order).
fn jet_rust_prefix_less(left: String, right: String) -> Bool Never! {
    a :: left.bytes()
    b :: right.bytes()
    index := 0
    loop index < a.len() && index < b.len() {
        if a[index] != b[index] -> return Int.from_u8(a[index]) < Int.from_u8(b[index])
        index += 1
    }
    a.len() < b.len()
}

// ---- sources ----------------------------------------------------------------

fn jet_rust_prefix_source(state: &JetRustPrefixState, path: String) -> String Never! {
    loop index in 0..<state.sources.len() {
        if state.sources[index].path == path -> return state.sources[index].text
    }
    if state.failure == None -> state.failure = Val("the runtime source `{path}` was not supplied")
    ""
}

fn jet_rust_prefix_prelude(state: &JetRustPrefixState, file: String) -> String Never! {
    jet_rust_prefix_source(&state, "{JET_RUST_PREFIX_PRELUDE}{file}")
}

fn jet_rust_prefix_foundation(state: &JetRustPrefixState, file: String) -> String Never! {
    jet_rust_prefix_source(&state, "{JET_RUST_PREFIX_FOUNDATION}{file}")
}

fn jet_rust_prefix_fail(state: &JetRustPrefixState, message: String) Never! {
    if state.failure == None -> state.failure = Val(message)
}

// The text between `open` and the first `close` after it in `text`.
fn jet_rust_prefix_between(state: &JetRustPrefixState, text: String, open: String, close: String, what: String) -> String Never! {
    bytes :: text.bytes()
    start :: jet_rust_prefix_find(bytes, open.bytes(), 0)
    if start < 0 {
        jet_rust_prefix_fail(&state, "the runtime source has no {what}")
        return ""
    }
    body :: start + open.bytes().len()
    end :: jet_rust_prefix_find(bytes, close.bytes(), body)
    if end < 0 {
        jet_rust_prefix_fail(&state, "the runtime source's {what} is not terminated")
        return ""
    }
    jet_rust_prefix_slice(bytes, body, end)
}

// A `const NAME: &str = r#"…"#;` body of Codegen/mod.rs, verbatim.
fn jet_rust_prefix_raw_const(state: &JetRustPrefixState, name: String) -> String Never! {
    codegen :: jet_rust_prefix_source(&state, JET_RUST_PREFIX_CODEGEN_MOD)
    jet_rust_prefix_between(&state, codegen, "const {name}: &str = r#\"", "\"#", "`{name}` raw string")
}

// ---- small Rust value renderings ---------------------------------------------

// mod.rs `push_package_edition_value`: `edition.parse::<u16>().unwrap_or(2027)`.
fn jet_rust_prefix_edition_year(edition: String) -> Int Never! {
    bytes :: edition.bytes()
    start :: if bytes.len() > 0 && Int.from_u8(bytes[0]) == 43 -> 1 else -> 0
    if start >= bytes.len() -> return 2027
    value := 0
    loop index in start..<bytes.len() {
        digit :: Int.from_u8(bytes[index]) - 48
        if digit < 0 || digit > 9 -> return 2027
        value = value * 10 + digit
        if value > 65535 -> return 2027
    }
    value
}

// `jet_foundation::CompilerStack::COMPILER_STACK_SIZE`, a product of literals.
fn jet_rust_prefix_stack_size(state: &JetRustPrefixState) -> Int Never! {
    source :: jet_rust_prefix_source(&state, JET_RUST_PREFIX_STACK)
    expression :: jet_rust_prefix_between(&state, source, "pub const COMPILER_STACK_SIZE: usize = ", ";", "`COMPILER_STACK_SIZE`")
    value := 1
    loop factor in expression.split("*") {
        number :: Int.parse(jet_rust_prefix_trim_text(factor).replace("_", "")) ?? {
            jet_rust_prefix_fail(&state, "`COMPILER_STACK_SIZE` is not a product of integer literals")
            return 0
        }
        value = value * number
    }
    value
}

// `{:?}` of `Syntax::DIGIT_SEPARATOR`: the char literal as the source spells it.
fn jet_rust_prefix_digit_separator(state: &JetRustPrefixState) -> String Never! {
    source :: jet_rust_prefix_source(&state, JET_RUST_PREFIX_SYNTAX)
    jet_rust_prefix_trim_text(jet_rust_prefix_between(&state, source, "pub const DIGIT_SEPARATOR: char = ", ";", "`DIGIT_SEPARATOR`"))
}

// `env!("CARGO_PKG_VERSION")` of the jet-codegen crate.
fn jet_rust_prefix_compiler_version(state: &JetRustPrefixState) -> String Never! {
    manifest :: jet_rust_prefix_source(&state, JET_RUST_PREFIX_CARGO)
    jet_rust_prefix_between(&state, manifest, "\nversion = \"", "\"", "package version")
}

fn jet_rust_prefix_byte_list(bytes: [U8]) -> String Never! {
    values :: loop byte in bytes -> "{Int.from_u8(byte)}"
    "[{values.join(", ")}]"
}

// mod.rs `canonical_font_prelude`.
fn jet_rust_prefix_font_prelude(state: &JetRustPrefixState) -> String Never! {
    rendered := [String]{}
    loop path in JET_RUST_PREFIX_FONTS {
        found := false
        loop index in 0..<state.assets.len() {
            if state.assets[index].path == path {
                &rendered.push(jet_rust_prefix_byte_list(state.assets[index].bytes))
                found = true
                break
            }
        }
        if !found {
            jet_rust_prefix_fail(&state, "the runtime asset `{path}` was not supplied")
            return ""
        }
    }
    "const JET_CANONICAL_FONT_BYTES: &[u8] = &{rendered[0]};\nconst JET_CANONICAL_ARABIC_FONT_BYTES: &[u8] = &{rendered[1]};\nconst JET_CANONICAL_SYMBOLS_FONT_BYTES: &[u8] = &{rendered[2]};\n"
}

// ---- flat Prelude fragments (mod.rs `split_leading_top_level_uses` …) ---------

struct JetRustPrefixSplitUses { imports: [String], body: String }

fn jet_rust_prefix_split_uses(source: String) -> JetRustPrefixSplitUses Never! {
    bytes :: source.bytes()
    imports := [String]{}
    body := [String]{}
    rest := 0
    newline :: "\n".bytes()
    semicolon :: ";".bytes()
    loop rest < bytes.len() {
        found :: jet_rust_prefix_find(bytes, newline, rest)
        line_end :: if found < 0 -> bytes.len() else -> found + 1
        trimmed :: jet_rust_prefix_trim(bytes, rest, line_end)
        if trimmed == "" || trimmed.starts_with("//") || trimmed.starts_with("#") {
            &body.push(jet_rust_prefix_slice(bytes, rest, line_end))
            rest = line_end
            next
        }
        if !jet_rust_prefix_at(bytes, rest, "use ") -> break
        end := line_end
        loop end < bytes.len() {
            stop :: jet_rust_prefix_find(bytes, semicolon, rest)
            if stop >= 0 && stop < end -> break
            next_line :: jet_rust_prefix_find(bytes, newline, end)
            end = if next_line < 0 -> bytes.len() else -> next_line + 1
        }
        &imports.push(jet_rust_prefix_trim(bytes, rest, end))
        rest = end
    }
    &body.push(jet_rust_prefix_slice(bytes, rest, bytes.len()))
    JetRustPrefixSplitUses{imports: imports, body: body.join("")}
}

fn jet_rust_prefix_flat_body(source: String) -> String Never! {
    jet_rust_prefix_split_uses(source).body
}

struct JetRustPrefixImport { path: String, name: String, binding: String }

fn jet_rust_prefix_trim_start_all(text: String, prefix: String) -> String Never! {
    value := text
    loop prefix != "" && value.starts_with(prefix) {
        bytes :: value.bytes()
        value = jet_rust_prefix_slice(bytes, prefix.bytes().len(), bytes.len())
    }
    value
}

fn jet_rust_prefix_trim_end_all(text: String, suffix: String) -> String Never! {
    value := text
    loop suffix != "" && value.ends_with(suffix) {
        bytes :: value.bytes()
        value = jet_rust_prefix_slice(bytes, 0, bytes.len() - suffix.bytes().len())
    }
    value
}

// mod.rs `flat_prelude_import_bindings`.
fn jet_rust_prefix_import_bindings(source: String) -> [JetRustPrefixImport] Never! {
    bindings := [JetRustPrefixImport]{}
    loop statement in jet_rust_prefix_split_uses(source).imports {
        item :: jet_rust_prefix_trim_text(jet_rust_prefix_trim_end_all(jet_rust_prefix_trim_start_all(statement, "use "), ";"))
        bytes :: item.bytes()
        path := ""
        names := ""
        brace :: jet_rust_prefix_find(bytes, "::{{".bytes(), 0)
        if brace >= 0 {
            path = jet_rust_prefix_trim(bytes, 0, brace)
            names = jet_rust_prefix_trim_end_all(jet_rust_prefix_slice(bytes, brace + 3, bytes.len()), "}}")
        } else {
            last := -1
            at := jet_rust_prefix_find(bytes, "::".bytes(), 0)
            loop at >= 0 {
                last = at
                at = jet_rust_prefix_find(bytes, "::".bytes(), at + 1)
            }
            if last < 0 {
                names = item
            } else {
                path = jet_rust_prefix_slice(bytes, 0, last)
                names = jet_rust_prefix_slice(bytes, last + 2, bytes.len())
            }
        }
        loop raw in names.split(",") {
            name :: jet_rust_prefix_trim_text(raw)
            if name == "" -> next
            name_bytes :: name.bytes()
            alias :: jet_rust_prefix_find(name_bytes, " as ".bytes(), 0)
            if alias >= 0 {
                &bindings.push(JetRustPrefixImport{path: path, name: jet_rust_prefix_trim(name_bytes, 0, alias), binding: jet_rust_prefix_trim(name_bytes, alias + 4, name_bytes.len())})
            } else {
                &bindings.push(JetRustPrefixImport{path: path, name: name, binding: name})
            }
        }
    }
    bindings
}

// `FlatPreludeImport::identity`: `core::`/`alloc::` spell `std::` items.
fn jet_rust_prefix_import_identity(import: JetRustPrefixImport) -> String Never! {
    path :: if {
        import.path.starts_with("core::") -> "std::{jet_rust_prefix_trim_start_once(import.path, "core::")}"
        import.path.starts_with("alloc::") -> "std::{jet_rust_prefix_trim_start_once(import.path, "alloc::")}"
        else -> import.path
    }
    "{path}\n{import.name}"
}

fn jet_rust_prefix_trim_start_once(text: String, prefix: String) -> String Never! {
    bytes :: text.bytes()
    jet_rust_prefix_slice(bytes, prefix.bytes().len(), bytes.len())
}

// mod.rs `FOUNDATION_PLACEMENTS`: (module, generated path); "" = crate root.
JET_RUST_PREFIX_PLACEMENTS :: [String]{
    "Outcome", "", "Shape", "", "Devtools", "", "DevtoolsNative", "", "Evidence", "",
    "NumericConversion", "", "ExactUnitConversion", "", "StructuralDebug", "", "StreamCursor", "",
    "RuntimeDiagnosticCore", "RuntimeDiagnosticCore", "EncodingErrors", "jet_encoding_errors",
    "JSONNumber", "jet_json_number", "EncodingJson", "jet_encoding_json", "Dyn", "jet_foundation_dyn",
    "ArrowData", "jet_arrow_data", "ArrowFileReader", "jet_arrow_file_reader",
    "PreludeDataFlow", "jet_prelude_data_flow", "SHA256", "SHA256", "PerformanceBudget", "PerformanceBudget",
    "Numeric", "jet_foundation_numeric", "Facts", "Facts", "ResourceSchedule", "ResourceSchedule",
    "CompilerStack", "CompilerStack",
}

// The placement path of `name`; None when the program does not embed it.
fn jet_rust_prefix_placement(name: String) -> String? Never! {
    index := 0
    loop index + 1 < JET_RUST_PREFIX_PLACEMENTS.len() {
        if JET_RUST_PREFIX_PLACEMENTS[index] == name -> return Val(JET_RUST_PREFIX_PLACEMENTS[index + 1])
        index += 2
    }
    None
}

// mod.rs `merge_flat_prelude_imports`.
fn jet_rust_prefix_merge_imports(state: &JetRustPrefixState, sources: [String]) -> String Never! {
    kept := [JetRustPrefixImport]{}
    loop source in sources {
        loop import in jet_rust_prefix_import_bindings(source) {
            if import.path.starts_with("jet_foundation::") {
                rest :: jet_rust_prefix_trim_start_once(import.path, "jet_foundation::")
                foundation_name :: rest.split("::").to_list()[0]
                placement :: jet_rust_prefix_placement(foundation_name) ?? {
                    jet_rust_prefix_fail(&state, "flat Prelude fragment imports `jet_foundation::{foundation_name}`, which the generated program does not embed; add its placement to FOUNDATION_PLACEMENTS")
                    return ""
                }
                if placement == "" && import.binding == import.name -> next
            }
            position := 0
            duplicate := false
            loop position < kept.len() {
                if kept[position].binding == import.binding {
                    duplicate = true
                    break
                }
                position += 1
            }
            if duplicate {
                if jet_rust_prefix_import_identity(kept[position]) != jet_rust_prefix_import_identity(import) {
                    jet_rust_prefix_fail(&state, "flat Prelude fragments bind `{import.binding}` to two items: `{kept[position].path}::{kept[position].name}` and `{import.path}::{import.name}`")
                    return ""
                }
                next
            }
            // Keep `kept` in binding order (the BTreeMap key).
            position = 0
            loop position < kept.len() && jet_rust_prefix_less(kept[position].binding, import.binding) -> position += 1
            kept = jet_rust_prefix_insert_import(kept, position, import)
        }
    }
    paths := [String]{}
    loop import in kept {
        known := false
        loop path in paths {
            if path == import.path -> known = true
        }
        if known -> next
        position := 0
        loop position < paths.len() && jet_rust_prefix_less(paths[position], import.path) -> position += 1
        paths = jet_rust_prefix_insert_text(paths, position, import.path)
    }
    rendered := [String]{}
    loop path in paths {
        names := [String]{}
        loop import in kept {
            if import.path != path -> next
            &names.push(if import.binding == import.name -> import.name else -> "{import.name} as {import.binding}")
        }
        if names.len() == 1 {
            &rendered.push("use {path}::{names[0]};\n")
        } else {
            &rendered.push("use {path}::{{{names.join(", ")}}};\n")
        }
    }
    &rendered.push("\n")
    rendered.join("")
}

// mod.rs `FLAT_PRELUDE_SOURCES`, in order.
fn jet_rust_prefix_flat_sources(state: &JetRustPrefixState) -> [String] Never! {
    [String]{
        jet_rust_prefix_prelude(&state, "Core/Atomic.rs"),
        jet_rust_prefix_prelude(&state, "CoreLib/Top/EncodingTraits.rs"),
        jet_rust_prefix_prelude(&state, "Scheduler.rs"),
        jet_rust_prefix_prelude(&state, "Stream.rs"),
        jet_rust_prefix_prelude(&state, "Core/EmbeddedHardware.rs"),
        jet_rust_prefix_prelude(&state, "Core/LazyTablePlan.rs"),
        JET_RUST_PREFIX_DATA_PLOT_IMPORTS,
        jet_rust_prefix_prelude(&state, "Core/ParallelPlan.rs"),
        jet_rust_prefix_prelude(&state, "Core/GameFrameProfiler.rs"),
        jet_rust_prefix_prelude(&state, "CoreLib/Top/ServiceAuthority.rs"),
        jet_rust_prefix_prelude(&state, "CoreLib/Top/JobQueueNative.rs"),
        jet_rust_prefix_prelude(&state, "CoreLib/Top/GameAssetsImport.rs"),
        jet_rust_prefix_prelude(&state, "CoreLib/Top/GameAssetsRuntime.rs"),
        jet_rust_prefix_prelude(&state, "CoreLib/Top/WebRouter.rs"),
        jet_rust_prefix_prelude(&state, "CoreLib/Top/OpenAPI.rs"),
        jet_rust_prefix_prelude(&state, "CoreLib/Top/WebQuery.rs"),
        jet_rust_prefix_prelude(&state, "CoreLib/Top/WebForms.rs"),
        jet_rust_prefix_prelude(&state, "CoreLib/Top/WebTable.rs"),
        jet_rust_prefix_prelude(&state, "CoreLib/Top/WebVirtual.rs"),
        jet_rust_prefix_prelude(&state, "CoreLib/Top/WebStore.rs"),
        jet_rust_prefix_prelude(&state, "CoreLib/Top/WebServerFn.rs"),
    }
}

JET_RUST_PREFIX_DATA_PLOT_IMPORTS :: "use std::collections::{{BTreeMap, BTreeSet}};\nuse std::sync::Arc as JetDataPlotArc;\n"

// mod.rs `scheduler_prelude_for_emit(true)`: the flat import set, then the
// native-I/O Scheduler body and the Stream body.
fn jet_rust_prefix_scheduler(state: &JetRustPrefixState) -> String Never! {
    sources :: jet_rust_prefix_flat_sources(&state)
    imports :: jet_rust_prefix_merge_imports(&state, sources)
    scheduler :: jet_rust_prefix_replace(jet_rust_prefix_flat_body(jet_rust_prefix_prelude(&state, "Scheduler.rs")), "feature = \"jet_native_io\"", "all()")
    "{imports}{scheduler}{jet_rust_prefix_flat_body(jet_rust_prefix_prelude(&state, "Stream.rs"))}"
}

// ---- the fixed runtime block ---------------------------------------------------

// Cut `text[begin marker start .. end marker end]` (mod.rs `push_embedded_devtools`).
fn jet_rust_prefix_cut(state: &JetRustPrefixState, text: String, begin: String, end: String) -> String Never! {
    bytes :: text.bytes()
    start :: jet_rust_prefix_find(bytes, begin.bytes(), 0)
    stop :: jet_rust_prefix_find(bytes, end.bytes(), 0)
    if start < 0 || stop < 0 || start >= stop + end.bytes().len() {
        jet_rust_prefix_fail(&state, "the runtime source markers `{begin}`/`{end}` are missing or out of order")
        return text.copy()
    }
    "{jet_rust_prefix_slice(bytes, 0, start)}{jet_rust_prefix_slice(bytes, stop + end.bytes().len(), bytes.len())}"
}

fn jet_rust_prefix_insert_import(rows: [JetRustPrefixImport], position: Int, row: JetRustPrefixImport) -> [JetRustPrefixImport] Never! {
    out := [JetRustPrefixImport]{}
    loop index in 0..<rows.len() {
        if index == position -> &out.push(row)
        &out.push(rows[index])
    }
    if position >= rows.len() -> &out.push(row)
    out
}

fn jet_rust_prefix_insert_text(rows: [String], position: Int, row: String) -> [String] Never! {
    out := [String]{}
    loop index in 0..<rows.len() {
        if index == position -> &out.push(row)
        &out.push(rows[index])
    }
    if position >= rows.len() -> &out.push(row)
    out
}

fn jet_rust_prefix_collections(state: &JetRustPrefixState) -> String Never! {
    source :: jet_rust_prefix_prelude(&state, "Core/Collections.rs")
    marker :: "include!(\"LoopCursor.rs\");"
    bytes :: source.bytes()
    at :: jet_rust_prefix_find(bytes, marker.bytes(), 0)
    if at < 0 {
        jet_rust_prefix_fail(&state, "Collections Prelude source is missing its cursor-kernel marker")
        return source
    }
    tail :: at + marker.bytes().len()
    if jet_rust_prefix_find(bytes, marker.bytes(), tail) >= 0 {
        jet_rust_prefix_fail(&state, "Collections Prelude source has duplicate cursor-kernel markers")
        return source
    }
    "{jet_rust_prefix_slice(bytes, 0, at)}{jet_rust_prefix_prelude(&state, "Core/LoopCursor.rs")}{jet_rust_prefix_slice(bytes, tail, bytes.len())}"
}

fn jet_rust_prefix_numeric_runtime(state: &JetRustPrefixState, out: &[String]) Never! {
    source :: jet_rust_prefix_foundation(&state, "Numeric.rs")
    bytes :: source.bytes()
    start :: jet_rust_prefix_find(bytes, "// ── CtFraction".bytes(), 0)
    if start < 0 {
        jet_rust_prefix_fail(&state, "Numeric.rs CtFraction marker missing")
        return
    }
    &out.push("\n// JET_VETTED_UNSAFE_BEGIN: jet_foundation_numeric\n// AUDIT: D-INTBIG1/D-DECIMAL1 keep the hazard-pointer exact numeric\n// carrier and its raw i64 ownership adapters in this Foundation module.\n#[allow(non_snake_case, unused_imports, dead_code)]\nmod jet_foundation_numeric {{\nuse crate::jet_json_number::{{json_decimal_lexeme, json_decimal_small, json_exact_integer_text}};\nuse crate::{{AllocError, jet_alloc_error}};\nuse std::alloc::{{alloc, dealloc, Layout}};\nuse std::cell::Cell;\nuse std::fmt;\nuse std::ptr::{{self, NonNull}};\nuse std::sync::atomic::{{AtomicPtr, AtomicUsize, Ordering}};\nmod Syntax {{\n    pub const TYPE_DECIMAL: &'static str = \"Decimal\";\n    pub const TYPE_FRACTION: &'static str = \"Fraction\";\n}}\n#[derive(Clone, Debug)]\nenum CtValue {{\n    Int(i64),\n    Bool(bool),\n    Str(String),\n    BigInt(CtBigInt),\n    Struct {{ type_name: String, fields: Vec<(String, CtValue)> }},\n}}\n")
    body := jet_rust_prefix_slice(bytes, start, bytes.len())
    body = jet_rust_prefix_replace(body, "crate::AST::CtValue", "CtValue")
    body = jet_rust_prefix_replace(body, "crate::Syntax::", "Syntax::")
    body = jet_rust_prefix_replace(body, "crate::NumericConversion::", "crate::")
    body = jet_rust_prefix_replace(body, "crate::Outcome::", "crate::")
    &out.push(body)
    &out.push("\n}}\n// JET_VETTED_UNSAFE_END: jet_foundation_numeric\n")
}

fn jet_rust_prefix_shared_numeric(state: &JetRustPrefixState, out: &[String]) Never! {
    &out.push("\n#[allow(non_snake_case, unused_imports, dead_code)]\nmod jet_exact_numeric {{\nuse crate::jet_foundation_numeric::CtBigInt as ExactBigInt;\n")
    &out.push(jet_rust_prefix_prelude(&state, "Core/ExactNumeric.rs"))
    &out.push("\n}}\n")
    &out.push("\n#[allow(non_snake_case, unused_imports, dead_code)]\nmod jet_precise_numeric {{\nuse crate::jet_foundation_numeric::{{CtBigInt as ExactBigInt, CtDecimal as ExactDecimal, CtFraction as ExactFraction}};\n")
    &out.push(jet_rust_prefix_prelude(&state, "Core/PreciseNumeric.rs"))
    &out.push("\n}}\n")
}

// mod.rs `push_prelude`: the policy constants, the numeric kernels, PRELUDE_PARTS.
fn jet_rust_prefix_prelude_parts(state: &JetRustPrefixState, out: &[String], devtools_enabled: Bool, local_rail: Bool) Never! {
    &out.push("\nconst JET_DEVTOOLS_RUNTIME_ENABLED: bool = {devtools_enabled};\nconst JET_DEVTOOLS_LOCAL_RAIL_ENABLED: bool = {local_rail};\n#[inline(always)]\nfn jet_web_runtime_devtools_enabled() -> bool {{ JET_DEVTOOLS_RUNTIME_ENABLED }}\n#[inline(always)]\nfn jet_web_runtime_history_enabled() -> bool {{ JET_DEVTOOLS_LOCAL_RAIL_ENABLED }}\n")
    jet_rust_prefix_numeric_runtime(&state, &out)
    jet_rust_prefix_shared_numeric(&state, &out)
    &out.push(jet_rust_prefix_foundation(&state, "Shape.rs"))
    &out.push(jet_rust_prefix_prelude(&state, "DevelopmentReceipt.rs"))
    &out.push(jet_rust_prefix_prelude(&state, "Core/Receipt.rs"))
    devtools :: jet_rust_prefix_prelude(&state, "Devtools.rs")
    &out.push(jet_rust_prefix_cut(&state, devtools, "// JET_HOST_DEVTOOLS_NATIVE_BEGIN", "// JET_HOST_DEVTOOLS_NATIVE_END"))
    &out.push(jet_rust_prefix_foundation(&state, "DevtoolsNative.rs"))
    &out.push(jet_rust_prefix_raw_const(&state, "DEVTOOLS_NATIVE_WRAPPERS_PRELUDE"))
    jet_rust_prefix_push_files(&state, &out, [String]{"FaultInjection.rs", "Core/Keep.rs", "JobQueueTypes.rs", "Job.rs", "Core/Option.rs", "Core/FixedList.rs", "Core/Columns.rs", "Core/ColumnList.rs", "Core/UnicodeString.rs", "Core/Ascii.rs", "Core/StringConcat.rs", "Core/ViewCopy.rs", "Core/Loadable.rs", "Core/Values.rs", "Core/TextValues.rs", "Core/RangeBounds.rs", "Core/InlineRange.rs", "Core/Disjoint.rs", "Core/SetAlgebra.rs", "Core/Duration.rs", "Core/TimeMonotonic.rs", "Core/Time.rs", "Core/Contracts.rs", "Core/MapKey.rs", "Core/RuntimeStack.rs", "Core/Authority.rs", "Core/FixedArithmetic.rs", "Core/FloatOrdering.rs", "Core/ParallelKernel.rs"})
    // RESOURCE_FACTS_PRELUDE
    &out.push("\n#[allow(non_snake_case, unused_imports)]\nmod ResourceSchedule {{\n")
    &out.push(jet_rust_prefix_foundation(&state, "ResourceSchedule.rs"))
    &out.push("\n}}\n\n#[allow(non_snake_case, unused_imports)]\nmod Facts {{\n")
    &out.push(jet_rust_prefix_foundation(&state, "FactsDerivation.rs"))
    &out.push("\n}}\n")
    &out.push(jet_rust_prefix_foundation(&state, "Evidence.rs"))
    jet_rust_prefix_push_files(&state, &out, [String]{"Core/TestEvidence.rs", "Core/NativeTaskBody.rs", "Core.rs", "Core/ViewAccess.rs", "Core/Power.rs", "Core/Division.rs", "TypedText.rs", "Core/Progress.rs", "Core/Bytes.rs", "Core/FSIgnore.rs", "Core/FSWalk.rs", "CoreLib/JetStd/Iter.rs", "Core/CollectionFailure.rs", "Core/SortKernel.rs"})
    &out.push(jet_rust_prefix_collections(&state))
    &out.push(jet_rust_prefix_prelude(&state, "Memo.rs"))
    &out.push(jet_rust_prefix_prelude(&state, "SharedProtocol.rs"))
    // TERM_PRELUDE
    &out.push("\n// JET_VETTED_UNSAFE_BEGIN: jet_term_kernel\n// AUDIT: D-IO-TERM1 keeps terminal detection, stream ownership, and the\n// platform raw-mode ABI in this compiler-owned shared kernel.\n")
    &out.push(jet_rust_prefix_prelude(&state, "Term.rs"))
    &out.push("\n// JET_VETTED_UNSAFE_END: jet_term_kernel\n")
    &out.push(jet_rust_prefix_prelude(&state, "Core/HumanOutput.rs"))
    &out.push(jet_rust_prefix_prelude(&state, "Core/TermKey.rs"))
    &out.push(jet_rust_prefix_prelude(&state, "Core/RuntimeControl.rs"))
    &out.push(jet_rust_prefix_foundation(&state, "NumericConversion.rs"))
    &out.push(jet_rust_prefix_prelude(&state, "Core/NumericRuntime.rs"))
    &out.push(jet_rust_prefix_prelude(&state, "Observe.rs"))
    &out.push(jet_rust_prefix_foundation(&state, "ExactUnitConversion.rs"))
    &out.push(jet_rust_prefix_prelude(&state, "Core/NumericWeb.rs"))
    &out.push(jet_rust_prefix_foundation(&state, "StructuralDebug.rs"))
    &out.push(jet_rust_prefix_foundation(&state, "StreamCursor.rs"))
    &out.push(jet_rust_prefix_foundation(&state, "Prelude/MatchScan.rs"))
}

// mod.rs `template_holes`: the `{name}` holes of the row templates, first use first.
fn jet_rust_prefix_template_holes(templates: [String]) -> [String] Never! {
    holes := [String]{}
    loop template in templates {
        bytes :: template.bytes()
        start := 0
        loop start < bytes.len() {
            open :: jet_rust_prefix_find(bytes, "{{".bytes(), start)
            if open < 0 -> break
            close :: jet_rust_prefix_find(bytes, "}}".bytes(), open + 1)
            if close < 0 -> break
            plain := close > open + 1
            index := open + 1
            loop index < close {
                code :: Int.from_u8(bytes[index])
                if !((code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95) -> plain = false
                index += 1
            }
            hole :: jet_rust_prefix_slice(bytes, open + 1, close)
            if plain {
                seen := false
                loop existing in holes {
                    if existing == hole -> seen = true
                }
                if !seen -> &holes.push(hole)
            }
            start = close + 1
        }
    }
    holes
}

// mod.rs `runtime_diagnostic_projection`.
fn jet_rust_prefix_diagnostic_projection() -> String Never! {
    out := [String]{"\nfn jet_runtime_diagnostic_row(code: &str) -> Option<JetRuntimeDiagnosticRow> {{\n\n    match code {{\n"}
    loop row in diagnostic_registry_rows() {
        if !row.has_stage("runtime") || row.status != DiagnosticRegistryStatus.Active -> next
        templates :: [String]{row.what, row.why, row.fix}
        holes := [String]{}
        loop hole in jet_rust_prefix_template_holes(templates) -> &holes.push(jet_rust_emit_quote(hole))
        code :: jet_rust_emit_quote(row.code)
        &out.push("        {code} => Some(JetRuntimeDiagnosticRow {{ code: {code}, what: {jet_rust_emit_quote(row.what)}, why: {jet_rust_emit_quote(row.why)}, fix: {jet_rust_emit_quote(row.fix)}, template_holes: &[{holes.join(", ")}] }}),\n")
    }
    &out.push("        _ => None,\n    }}\n}}\n\npub fn jet_render_runtime_stop(\ncode: &'static str, file: &str, line: u32, fn_name: &str,\nsrc_line: &str, col: u32, caret_len: u32, message: &str, locals: &str,\n) -> JetRuntimeDiagnostic {{\njet_render_runtime_stop_from_row(\njet_runtime_diagnostic_row(code), code, file, line, fn_name, src_line,\ncol, caret_len, message, locals,\n)\n}}\n\npub fn jet_render_runtime_sentry(\ncode: &'static str, file: &str, line: u32, gate: &str,\noperation: &str, obligation: &str, detail: &str,\n) -> JetRuntimeDiagnostic {{\njet_render_runtime_sentry_with_context(\ncode, file, line, gate, operation, obligation, detail,\n\"false\", None, None,\n)\n}}\n\npub fn jet_render_runtime_sentry_with_context(\ncode: &'static str, file: &str, line: u32, gate: &str,\noperation: &str, obligation: &str, detail: &str,\nobligation_status: &str, foreign_component: Option<&str>,\nforeign_fenced: Option<bool>,\n) -> JetRuntimeDiagnostic {{\njet_render_runtime_sentry_from_row(\njet_runtime_diagnostic_row(code), code, file, line, gate,\noperation, obligation, detail, obligation_status,\nforeign_component, foreign_fenced,\n)\n}}\n\n")
    out.join("")
}

// mod.rs `push_embedded_outcome`.
fn jet_rust_prefix_outcome(state: &JetRustPrefixState) -> String Never! {
    source :: jet_rust_prefix_foundation(&state, "Outcome.rs")
    bytes :: source.bytes()
    stop_start :: jet_rust_prefix_find(bytes, "// JET_HOST_RUNTIME_STOP_BEGIN".bytes(), 0)
    stop_end :: jet_rust_prefix_find(bytes, "// JET_HOST_RUNTIME_STOP_END".bytes(), 0)
    sentry_start :: jet_rust_prefix_find(bytes, "// JET_HOST_RUNTIME_SENTRY_BEGIN".bytes(), 0)
    sentry_end :: jet_rust_prefix_find(bytes, "// JET_HOST_RUNTIME_SENTRY_END".bytes(), 0)
    if stop_start < 0 || stop_end < 0 || sentry_start < 0 || sentry_end < 0 {
        jet_rust_prefix_fail(&state, "Outcome host wrapper markers missing")
        return ""
    }
    stop_after :: stop_end + "// JET_HOST_RUNTIME_STOP_END".bytes().len()
    sentry_after :: sentry_end + "// JET_HOST_RUNTIME_SENTRY_END".bytes().len()
    if stop_after > sentry_start || sentry_start > sentry_after {
        jet_rust_prefix_fail(&state, "Outcome host wrappers are out of order")
        return ""
    }
    "{jet_rust_prefix_slice(bytes, 0, stop_start)}{jet_rust_prefix_slice(bytes, stop_after, sentry_start)}{jet_rust_prefix_slice(bytes, sentry_after, bytes.len())}{jet_rust_prefix_diagnostic_projection()}"
}

// mod.rs `EMBEDDED_PRELUDE_PARTS`: one part's dependencies, then its source.
fn jet_rust_prefix_part_dependencies(name: String) -> [String] Never! {
    if name == {
        "encoding_json" -> [String]{"encoding_errors", "json_number"}
        "outcome" -> [String]{"encoding_json", "runtime_diagnostic_core"}
        "performance_budget" | "prelude_data_flow" -> [String]{"sha256"}
        "arrow_file_reader" -> [String]{"arrow_data"}
        else -> [String]{}
    }
}

fn jet_rust_prefix_wrapped(state: &JetRustPrefixState, open: String, file: String, close: String) -> String Never! {
    "{open}{jet_rust_prefix_foundation(&state, file)}{close}"
}

// mod.rs `push_embedded_encoding_json`: flatten host-relative includes.
fn jet_rust_prefix_encoding_json(state: &JetRustPrefixState) -> String Never! {
    source :: jet_rust_prefix_foundation(&state, "EncodingJson.rs")
    bytes :: source.bytes()
    types_marker :: "include!(\"../../jet-codegen/src/Prelude/CoreLib/JetStd/EncodingTypes.rs\");"
    error_marker :: "include!(\"../../jet-codegen/src/Prelude/Core/EncodingError.rs\");"
    types_start :: jet_rust_prefix_find(bytes, types_marker.bytes(), 0)
    error_start :: jet_rust_prefix_find(bytes, error_marker.bytes(), 0)
    if types_start < 0 || error_start < types_start + types_marker.bytes().len() {
        jet_rust_prefix_fail(&state, "EncodingJson host include markers missing or out of order")
        return ""
    }
    "\nmod jet_encoding_json {{\n{jet_rust_prefix_slice(bytes, 0, types_start)}{jet_rust_prefix_prelude(&state, "CoreLib/JetStd/EncodingTypes.rs")}{jet_rust_prefix_slice(bytes, types_start + types_marker.bytes().len(), error_start)}{jet_rust_prefix_prelude(&state, "Core/EncodingError.rs")}{jet_rust_prefix_slice(bytes, error_start + error_marker.bytes().len(), bytes.len())}\n}}\n\n#[allow(non_snake_case)]\nmod EncodingJson {{ pub use crate::jet_encoding_json::*; }}\n"
}

fn jet_rust_prefix_part_source(state: &JetRustPrefixState, name: String) -> String Never! {
    if name == {
        "fixed_allocator" -> "\n// JET_VETTED_UNSAFE_BEGIN: jet_fixed_kernel\npub mod jet_fixed_kernel {{\n{jet_rust_prefix_prelude(&state, "Core/FixedAllocator.rs")}\n}}\n// JET_VETTED_UNSAFE_END: jet_fixed_kernel\n"
        "runtime_diagnostic_core" -> jet_rust_prefix_wrapped(&state, "\npub mod RuntimeDiagnosticCore {{\n", "RuntimeDiagnosticCore.rs", "\n}}\n")
        "encoding_errors" -> jet_rust_prefix_wrapped(&state, "\nmod jet_encoding_errors {{\n", "EncodingErrors.rs", "\n}}\n")
        "json_number" -> jet_rust_prefix_wrapped(&state, "\nmod jet_json_number {{\n", "JSONNumber.rs", "\n}}\n")
        "encoding_json" -> jet_rust_prefix_encoding_json(&state)
        "outcome" -> jet_rust_prefix_outcome(&state)
        "sha256" -> jet_rust_prefix_wrapped(&state, "\n// JET_VETTED_UNSAFE_BEGIN: jet_foundation_sha256\n// AUDIT: this Foundation SHA-256 module owns the bounded hostile-input\n// tree-hash file boundary; its rooted authority uses checked no-follow\n// descriptors and keeps every raw descriptor operation in this module.\n#[allow(non_snake_case)]\nmod SHA256 {{\n", "SHA256.rs", "\n}}\n// JET_VETTED_UNSAFE_END: jet_foundation_sha256\n")
        "performance_budget" -> jet_rust_prefix_wrapped(&state, "\n#[allow(non_snake_case)]\nmod PerformanceBudget {{\n", "PerformanceBudget.rs", "\n}}\n")
        "prelude_data_flow" -> jet_rust_prefix_wrapped(&state, "\nmod jet_prelude_data_flow {{\n", "PreludeDataFlow.rs", "\n}}\n")
        "arrow_data" -> jet_rust_prefix_wrapped(&state, "\n// JET_VETTED_UNSAFE_BEGIN: jet_arrow_data\n// AUDIT: this region imports the Arrow C data interface, validates\n// schema/length/offset/buffer bounds, and retains release callbacks.\n// Safe Rust cannot express foreign ownership and callback ABIs.\n// Callers must provide live C records and transfer each owner once;\n// violating that contract can read outside a buffer or double-free.\nmod jet_arrow_data {{\n", "ArrowData.rs", "\n}}\n// JET_VETTED_UNSAFE_END: jet_arrow_data\n#[allow(non_snake_case)]\nmod ArrowData {{ pub use crate::jet_arrow_data::*; }}\n")
        "arrow_file_reader" -> jet_rust_prefix_wrapped(&state, "\n// JET_VETTED_UNSAFE_BEGIN: jet_arrow_file_reader\n// AUDIT: this region crosses the registered Arrow file-reader\n// provider boundary and transfers imported batch ownership.\nmod jet_arrow_file_reader {{\n", "ArrowFileReader.rs", "\n}}\n// JET_VETTED_UNSAFE_END: jet_arrow_file_reader\n")
        else -> {
            jet_rust_prefix_fail(&state, "unknown embedded Prelude part `{name}`")
            ""
        }
    }
}

fn jet_rust_prefix_part(state: &JetRustPrefixState, out: &[String], name: String, emitted: &[String]) Never! {
    loop seen in emitted {
        if seen == name -> return
    }
    &emitted.push(name)
    loop dependency in jet_rust_prefix_part_dependencies(name) -> jet_rust_prefix_part(&state, &out, dependency, &emitted)
    &out.push(jet_rust_prefix_part_source(&state, name))
}

// mod.rs `push_prelude_dependency_closure`: a fresh emitted set per call.
fn jet_rust_prefix_closure(state: &JetRustPrefixState, out: &[String], roots: [String]) Never! {
    emitted := [String]{}
    loop root in roots -> jet_rust_prefix_part(&state, &out, root, &emitted)
}

fn jet_rust_prefix_ffi_reporter(out: &[String], ffi_crate: String?) Never! {
    if ffi_crate == .Val(crate_name) {
        &out.push("// JET_VETTED_UNSAFE_BEGIN: ffi_reporter\nextern \"C\" fn jet_ffi_reporter(message: *const u8, len: usize) {{\n    let _ = (message, len);\n}}\n// JET_VETTED_UNSAFE_END: ffi_reporter\nfn jet_ffi_install_reporter() {{ {crate_name}::jet_ffi_set_reporter(jet_ffi_reporter); }}\n\n")
    } else {
        &out.push("fn jet_ffi_install_reporter() {{}}\n\n")
    }
}

// mod.rs `push_cached_runtime_traits`.
fn jet_rust_prefix_runtime_traits(out: &[String]) Never! {
    &out.push("pub trait __jet_Display {{\n    fn display(&self) -> String;\n}}\n\npub trait __jet_Equatable: Sized {{ fn equal(&self, rhs: &Self) -> bool; }}\n")
    equatable :: [String]{"i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "f32", "f64", "bool", "char", "String"}
    loop ty in equatable {
        &out.push("impl __jet_Equatable for {ty} {{ fn equal(&self, rhs: &Self) -> bool {{ self == rhs }} }}\n")
    }
    &out.push("\n#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]\npub enum __jet_Ordering {{ __jet_Less, __jet_Equal, __jet_Greater }}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum __jet_RemoveBy {{ __jet_Val, __jet_Slot }}\n\npub trait __jet_Comparable: Sized {{ fn compare(&self, rhs: &Self) -> __jet_Ordering; }}\n")
    comparable :: [String]{"i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "bool", "char", "String"}
    loop ty in comparable {
        &out.push("impl __jet_Comparable for {ty} {{ fn compare(&self, rhs: &Self) -> __jet_Ordering {{ if self < rhs {{ __jet_Ordering::__jet_Less }} else if self > rhs {{ __jet_Ordering::__jet_Greater }} else {{ __jet_Ordering::__jet_Equal }} }} }}\n")
    }
    arithmetic :: [String]{"Add add", "Sub sub", "Mul mul", "Div div"}
    loop pair in arithmetic {
        words :: pair.split(" ").to_list()
        &out.push("pub trait __jet_{words[0]}<Rhs = Self>: Sized {{ type Output; fn {words[1]}(&self, rhs: &Rhs) -> Self::Output; }}\n")
    }
    &out.push("pub trait __jet_Index {{\n    type __jet_Key;\n    type __jet_Value;\n    fn get(&self, key: &Self::__jet_Key) -> JetOutcome<Self::__jet_Value, JetAbsent>;\n}}\npub trait __jet_IndexMut: __jet_Index {{\n    fn set(&mut self, key: &Self::__jet_Key, value: &Self::__jet_Value) -> JetOutcome<(), JetErr>;\n}}\npub trait __jet_Iterator {{\n    type __jet_Item;\n    fn next(&mut self) -> JetOutcome<Self::__jet_Item, JetAbsent>;\n}}\npub trait __jet_Iterable: Sized {{\n    type __jet_Iter;\n    fn iter(self) -> Self::__jet_Iter;\n}}\npub trait __jet_Close: Sized {{\n    fn close(self);\n}}\n\n")
}

fn jet_rust_prefix_foundation_facade(state: &JetRustPrefixState, out: &[String], include_arrow: Bool) Never! {
    &out.push("\n#[allow(non_snake_case, dead_code)]\npub(crate) mod CompilerStack {{\n    pub const COMPILER_STACK_SIZE: usize = {jet_rust_prefix_stack_size(&state)};\n}}\n")
    &out.push("\n#[allow(non_snake_case, unused_imports)]\nmod jet_foundation {{\n")
    index := 0
    loop index + 1 < JET_RUST_PREFIX_PLACEMENTS.len() {
        foundation_name :: JET_RUST_PREFIX_PLACEMENTS[index]
        path :: JET_RUST_PREFIX_PLACEMENTS[index + 1]
        index += 2
        if !include_arrow && (foundation_name == "ArrowData" || foundation_name == "ArrowFileReader") -> next
        target :: if path == "" -> "crate" else -> "crate::{path}"
        &out.push("    pub mod {foundation_name} {{ pub use {target}::*; }}\n")
    }
    &out.push("}}\n")
}

// mod.rs `push_cached_runtime_body`.
fn jet_rust_prefix_cached_runtime(state: &JetRustPrefixState, out: &[String], ffi_crate: String?, include_arrow: Bool, policy: JetReleaseDevtoolsPolicy) Never! {
    if ffi_crate == None -> jet_rust_prefix_ffi_reporter(&out, None)
    jet_rust_prefix_runtime_traits(&out)
    jet_rust_prefix_closure(&state, &out, [String]{"outcome", "prelude_data_flow", "performance_budget"})
    &out.push("\n#[allow(non_snake_case)]\nmod Syntax {{\n    pub const DIGIT_SEPARATOR: char = {jet_rust_prefix_digit_separator(&state)};\n}}\n")
    is_release :: policy.inspect != None
    jet_rust_prefix_prelude_parts(&state, &out, !is_release || policy.stream_code, policy.local_rail)
    &out.push(jet_rust_prefix_prelude(&state, "EnvInit.rs"))
    // push_mem_prelude
    jet_rust_prefix_closure(&state, &out, [String]{"fixed_allocator"})
    &out.push("mod jet_uninit_semantics {{\n{jet_rust_prefix_prelude(&state, "Uninit.rs")}\n}}\n")
    &out.push("mod jet_mem {{\n    mod jet_sentry {{\n{jet_rust_prefix_foundation(&state, "MemSentry.rs")}\n    }}\n{jet_rust_prefix_prelude(&state, "Mem.rs")}\n}}\n")
    // push_gc_prelude (hosted collector platform)
    &out.push("mod jet_gc {{\nmod __gc_platform {{\n{jet_rust_prefix_source(&state, "crates/jet-rt/src/__gc_host.rs")}\n}}\nuse __gc_platform::*;\n{jet_rust_prefix_source(&state, "crates/jet-rt/src/__gc_core.rs")}\n}}\n")
    &out.push(jet_rust_prefix_prelude(&state, "Layout.rs"))
    jet_rust_prefix_foundation_facade(&state, &out, include_arrow)
}

// ---- the Core closure ----------------------------------------------------------

fn jet_rust_prefix_has(parts: [MIRRuntimePartID], wanted: MIRRuntimePartID) -> Bool Never! {
    loop part in parts {
        if part == wanted -> return true
    }
    false
}

// mod.rs `strip_source_shared_interop_jit`.
fn jet_rust_prefix_strip_interop(kernel: String) -> String Never! {
    bytes :: kernel.bytes()
    begin :: "    // jet:source-shared-interop-jit-begin\n"
    end :: "    // jet:source-shared-interop-jit-end\n"
    start :: jet_rust_prefix_find(bytes, begin.bytes(), 0)
    if start < 0 -> return kernel.copy()
    stop :: jet_rust_prefix_find(bytes, end.bytes(), start)
    if stop < 0 -> return kernel.copy()
    "{jet_rust_prefix_slice(bytes, 0, start)}{jet_rust_prefix_slice(bytes, stop + end.bytes().len(), bytes.len())}"
}

fn jet_rust_prefix_vetted(open: String, audit: String, source: String, close: String) -> String Never! {
    "\n// JET_VETTED_UNSAFE_BEGIN: {open}\n{audit}{source}\n// JET_VETTED_UNSAFE_END: {close}\n"
}

// mod.rs `CORELIB_KERNEL_PARTS`, with the mapped-file and shared-route gates.
fn jet_rust_prefix_kernel_parts(state: &JetRustPrefixState, out: &[String], mapped_file: Bool, shared: Bool) Never! {
    parts := [String]{}
    jet_rust_prefix_push_files(&state, &parts, [String]{"CoreLib/JetStd/Open.rs", "CoreLib/JetStd/Regex.rs", "TaskGroup.rs", "CoreLib/JetStd/Mime.rs", "CoreLib/JetStd/UrlMime.rs", "CoreLib/JetStd/JSONCodec.rs", "CoreLib/JetStd/EncodingTypes.rs"})
    &parts.push(jet_rust_prefix_vetted("jet_std_common_types", "// AUDIT: D-INTBIG1 keeps the exact-Int raw ownership adapters and the\n// platform terminal handle seam inside this compiler-owned source.\n", jet_rust_prefix_prelude(&state, "CoreLib/JetStd/CommonTypes.rs"), "jet_std_common_types"))
    if mapped_file -> &parts.push(jet_rust_prefix_prelude(&state, "CoreLib/JetStd/MappedFile.rs"))
    &parts.push(jet_rust_prefix_vetted("jet_std_xml_options", "// AUDIT: D-ENC-XML-SURFACE1 keeps XML stream limits and policies shared\n// between the AOT Prelude and the resident JIT stream host.\n", jet_rust_prefix_prelude(&state, "CoreLib/JetStd/XmlOptions.rs"), "jet_std_xml_options"))
    &parts.push(jet_rust_prefix_prelude(&state, "CommandSuite.rs"))
    &parts.push(jet_rust_prefix_prelude(&state, "CoreLib/JetStd/RowPolicy.rs"))
    &parts.push("\npub mod plugin_wire {{\n")
    &parts.push(jet_rust_prefix_foundation(&state, "PluginWire.rs"))
    &parts.push("\n}}\n")
    jet_rust_prefix_push_files(&state, &parts, [String]{"CoreLib/JetStd/DBPluginWire.rs", "CoreLib/JetStd/WireOrder.rs", "CoreLib/JetStd/DynKind.rs", "Core/FieldError.rs"})
    &parts.push("\npub use crate::Dyn::Dyn;\n")
    &parts.push(jet_rust_prefix_prelude(&state, "CoreLib/JetStd/Dyn.rs"))
    &parts.push(jet_rust_prefix_prelude(&state, "CoreLib/JetStd/TestingComparison.rs"))
    &parts.push("\njet_dyn_decode_helpers!();\n")
    &parts.push("\n#[allow(unused_imports)]\npub use crate::jet_json_number::validate_json_number;\n")
    &parts.push("\n// JET_VETTED_UNSAFE_BEGIN: jet_cell\nmod jet_cell {{\n#[allow(unused_imports)]\nuse crate::{{JetOutcome, JetAbsent}};\n")
    &parts.push(jet_rust_prefix_prelude(&state, "LocalCell.rs"))
    &parts.push("\n}}\npub use self::jet_cell::{{JetCell, JetCellEditGuard, JetCellReadGuard}};\n// JET_VETTED_UNSAFE_END: jet_cell\n")
    &parts.push(jet_rust_prefix_strip_interop(jet_rust_prefix_vetted("jet_std_math_task_mem", "// AUDIT: D-SIMD2/D-SIMD3/D-SHARED-REVISION1 keep lane representation,\n// permit-gated UnsafeCell projections, and consumed revision tickets in\n// this compiler-owned JetStd source.\n", jet_rust_prefix_prelude(&state, "CoreLib/JetStd/MathTaskMem.rs"), "jet_std_math_task_mem")))
    &parts.push(jet_rust_prefix_vetted("jet_std_reactive_event_watch", "// AUDIT: D-REACT1/D-DATARACE1 keep re-entrant staged values and synchronized\n// signal storage behind this compiler-owned, opt-in reactive source.\n", jet_rust_prefix_prelude(&state, "CoreLib/JetStd/ReactiveEventWatch.rs"), "jet_std_reactive_event_watch"))
    &parts.push(jet_rust_prefix_vetted("jet_std_ffi_callbacks", "// AUDIT: D-FFI-CALLBACK2 keeps callback registration, in-flight accounting,\n// native shutdown acknowledgement, and release in one managed source.\n", jet_rust_prefix_prelude(&state, "CoreLib/JetStd/FfiCallbacks.rs"), "jet_std_ffi_callbacks"))
    &parts.push("\nuse crate::jet_encoding_json::quote_json;\n")
    jet_rust_prefix_push_files(&state, &parts, [String]{"CoreLib/JetStd/JSONDyn.rs", "CoreLib/JetStd/TOML.rs", "CoreLib/JetStd/YAML.rs"})
    if shared -> &parts.push(jet_rust_prefix_prelude(&state, "CoreLib/Top/SharedRoutes.rs"))
    // Host crates include UrlMime.rs directly; AOT already embeds the MIME kernel.
    mime :: "    include!(\"Mime.rs\");\n\n"
    loop part in parts {
        if part.starts_with(mime) -> &out.push(jet_rust_prefix_trim_start_once(part, mime)) else -> &out.push(part)
    }
}

// mod.rs `push_corelib_prelude_body` for the cached Core closure: no Core-use
// labels, so only the forces select optional kernels.
fn jet_rust_prefix_corelib_body(state: &JetRustPrefixState, out: &[String], mapped_file: Bool, shared: Bool, arrow: Bool) Never! {
    &out.push(jet_rust_prefix_foundation(&state, "LiveLifecycle.rs"))
    &out.push("\n// JET_VETTED_UNSAFE_BEGIN: jet_program_allocator\n// AUDIT: the shared allocator kernel uses System only for its own allocation-free bookkeeping; the checked cap is installed by the program.\npub mod jet_program_allocator {{\n{jet_rust_prefix_prelude(&state, "ProgramAllocator.rs")}\n}}\n// JET_VETTED_UNSAFE_END: jet_program_allocator\n")
    &out.push("\n// D-SERDE2: the generated Prelude uses Foundation's canonical carrier.\nmod jet_foundation_dyn {{\n{jet_rust_prefix_foundation(&state, "Dyn.rs")}\n}}\n#[allow(non_snake_case)]\nmod Dyn {{\n    pub use crate::jet_foundation_dyn::Dyn;\n}}\n")
    &out.push(jet_rust_prefix_prelude(&state, "Core/SimdLanes.rs"))
    &out.push("// JET_VETTED_UNSAFE_BEGIN: jet_atomic_carrier\n")
    &out.push(jet_rust_prefix_flat_body(jet_rust_prefix_prelude(&state, "Core/Atomic.rs")))
    &out.push("// JET_VETTED_UNSAFE_END: jet_atomic_carrier\n\n\n")
    &out.push("\nmod jet_xml_pull {{\n{jet_rust_prefix_foundation(&state, "XmlPull.rs")}\n}}\n")
    &out.push("\n#[allow(non_snake_case)]\nmod XmlPull {{ pub use crate::jet_xml_pull::*; }}\n")
    &out.push("\nmod jet_xml_kernel {{\n{jet_rust_prefix_foundation(&state, "XmlKernel.rs")}\n}}\n")
    &out.push("\nmod jet_cbor_budget {{\n{jet_rust_prefix_foundation(&state, "CborBudget.rs")}\n}}\n")
    &out.push("\n#[allow(non_snake_case)]\nmod CborBudget {{ pub use crate::jet_cbor_budget::*; }}\n")
    &out.push("\nmod jet_cbor_kernel {{\n{jet_rust_prefix_foundation(&state, "CborKernel.rs")}\n}}\n")
    &out.push("\nmod jet_csv_kernel {{\n{jet_rust_prefix_foundation(&state, "CsvKernel.rs")}\n}}\n")
    &out.push("\nmod jet_base_encoding_strict {{\n{jet_rust_prefix_foundation(&state, "BaseEncodingStrict.rs")}\n}}\n")
    &out.push("\nmod jet_regex_syntax {{\n{jet_rust_prefix_foundation(&state, "RegexSyntax.rs")}\n}}\n")
    &out.push(jet_rust_prefix_prelude(&state, "Core/FileHandleOwners.rs"))
    jet_rust_prefix_kernel_parts(&state, &out, mapped_file, shared)
    &out.push(jet_rust_prefix_flat_body(jet_rust_prefix_prelude(&state, "Core/LazyTablePlan.rs")))
    &out.push(jet_rust_prefix_prelude(&state, "CoreLib/Top/CommandSuite.rs"))
    &out.push("\npub use crate::jet_std::JetTaskGroupRuntime;\n")
    &out.push("\npub use crate::jet_std::JetDynAccess;\n")
    &out.push(jet_rust_prefix_prelude(&state, "Core/Fmt.rs"))
    &out.push(jet_rust_prefix_prelude(&state, "Core/FmtAot.rs"))
    &out.push("\n// JET_VETTED_UNSAFE_BEGIN: jet_native_meta\n// AUDIT: image-bound native metadata owns the canonical nine-word\n// descriptor layout and copies only admitted live metadata pointers.\n")
    &out.push(jet_rust_prefix_prelude(&state, "Core/NativeMeta.rs"))
    &out.push("\n// JET_VETTED_UNSAFE_END: jet_native_meta\n")
    &out.push("\n// JET_VETTED_UNSAFE_BEGIN: jet_c_abi\n// AUDIT: D-EXEC1 keeps the raw handle, byte-slice and allocator\n// adapters of the Jet-native backend's runtime ABI in this module.\n")
    &out.push(jet_rust_prefix_prelude(&state, "Core/CAbi.rs"))
    &out.push("\n// JET_VETTED_UNSAFE_END: jet_c_abi\n")
    &out.push(jet_rust_prefix_prelude(&state, "Core/CAbiSession.rs"))
    &out.push("\nmod terminal_default {{\n{jet_rust_prefix_prelude(&state, "TerminalDefault.rs")}\n}}\n")
    if arrow -> jet_rust_prefix_closure(&state, &out, [String]{"arrow_file_reader"})
    &out.push("// jet:raylib-begin\n")
    jet_rust_prefix_push_files(&state, &out, [String]{"Core/Raylib.rs", "CoreLib/Top/HandlesRaylib.rs", "CoreLib/Top/DbPool.rs", "CoreLib/Top/UnicodeTables.rs", "Core/Path.rs", "CoreLib/Top/Text.rs", "Core/Codec.rs"})
    &out.push(jet_rust_prefix_flat_body(jet_rust_prefix_prelude(&state, "CoreLib/Top/EncodingTraits.rs")))
    jet_rust_prefix_push_files(&state, &out, [String]{"Core/ColumnListCodec.rs", "CoreLib/Top/EncodingHostileIo.rs", "CoreLib/Top/EncodingStream.rs", "Core/EncodingError.rs", "Core/EncodingBase.rs", "CoreLib/Top/EncodingCodecs.rs", "CoreLib/Top/SHA256Raw.rs", "CoreLib/Top/SHAFamily.rs"})
    &out.push("fn jet_log_write_line(line: &str) {{ eprintln!(\"{{}}\", line); }}\n")
    &out.push("fn jet_log_process_exit(code: i64) {{ std::process::exit(code as i32); }}\n")
    jet_rust_prefix_push_files(&state, &out, [String]{"Core/LogState.rs", "CoreLib/Top/Log.rs", "CoreLib/Top/RingCsvLogTimeCrypto.rs"})
    &out.push("// JET_VETTED_UNSAFE_BEGIN: jet_crypto_entropy\n")
    &out.push(jet_rust_prefix_prelude(&state, "CoreLib/Top/CryptoEntropy.rs"))
    &out.push("// JET_VETTED_UNSAFE_END: jet_crypto_entropy\n")
    &out.push("use jet_crypto_entropy::{{jet_crypto_entropy_fill, JetCryptoEntropyError}};\n")
    jet_rust_prefix_push_files(&state, &out, [String]{"CoreLib/Top/DNSResolverPolicy.rs", "Deadline.rs", "WorkflowWait.rs", "CoreLib/Top/TimeSleep.rs", "CoreLib/Top/WorkflowSleep.rs", "Core/NetPure.rs", "Core/NetError.rs", "CoreLib/Top/NetHTTP.rs", "Core/SeededRandom.rs", "Core/StringBytes.rs", "Core/TimeInstant.rs", "CoreLib/Top/MathRandomTime.rs", "CoreLib/Top/FakeData.rs"})
    // MIR closure emission always uses the typed testing-history carriers.
    &out.push("\nmod jet_testing_comparison_foundation {{\n{jet_rust_prefix_foundation(&state, "TestingComparison.rs")}\n}}\n")
    &out.push("\n#[allow(non_snake_case)]\nmod TestingComparison {{ pub use crate::jet_testing_comparison_foundation::*; }}\n#[allow(non_snake_case)]\nmod JSON {{\n")
    &out.push(jet_rust_prefix_foundation(&state, "JSON.rs"))
    &out.push("\n}}\n// JET_VETTED_UNSAFE_BEGIN: jet_testing_history_foundation\n// AUDIT: D-TEST-HISTORY1 and the Foundation SAFETY CONTRACT keep\n// weak callback metadata non-owning and reads tied to live owners.\nmod jet_testing_history_foundation {{\n")
    &out.push(jet_rust_prefix_foundation(&state, "TestingHistory.rs"))
    &out.push("\n}}\n// JET_VETTED_UNSAFE_END: jet_testing_history_foundation\n")
    &out.push(jet_rust_prefix_prelude(&state, "CoreLib/Top/TestingComparison.rs"))
    &out.push("// JET_VETTED_UNSAFE_BEGIN: jet_testing_history_top\n")
    &out.push(jet_rust_prefix_prelude(&state, "CoreLib/Top/TestingHistory.rs"))
    &out.push("\n// JET_VETTED_UNSAFE_END: jet_testing_history_top\n")
}

fn jet_rust_prefix_identity_field(value: String) -> String Never! {
    length :: value.bytes().len()
    header := [U8]{}
    shift := 56
    loop shift >= 0 {
        &header.push(U8{(length >> shift).bit_and(255)})
        shift -= 8
    }
    prefix :: String.from_bytes(header) ?? ""
    "{prefix}{value}"
}

// mod.rs `corelib_emission_identity` with an empty Core-use closure.
fn jet_rust_prefix_corelib_identity(body: String) -> String Never! {
    schema :: "jet-core-source-closure-v1"
    source :: mir_sha256_hex(schema)
    closure :: mir_sha256_hex(body)
    length :: body.bytes().len()
    fingerprint :: mir_sha256_hex("{schema}{jet_rust_prefix_identity_field(source)}{jet_rust_prefix_identity_field(closure)}{jet_rust_prefix_identity_field("{length}")}")
    "/* jet-corelib-r10 source={source} closure={closure} len={length} fp={fingerprint} */"
}

fn jet_rust_prefix_push_files(state: &JetRustPrefixState, out: &[String], files: [String]) Never! {
    loop file in files -> &out.push(jet_rust_prefix_prelude(&state, file))
}

fn jet_rust_prefix_flat_files(state: &JetRustPrefixState, out: &[String], files: [String]) Never! {
    loop file in files -> &out.push(jet_rust_prefix_flat_body(jet_rust_prefix_prelude(&state, file)))
}

fn jet_rust_prefix_game_debug(out: &[String], policy: JetReleaseDevtoolsPolicy) Never! {
    &out.push("\nconst JET_GAME_DEBUG_DATA_ENABLED: bool = {policy.inspect == None};\n")
}

fn jet_rust_prefix_process(state: &JetRustPrefixState, out: &[String]) Never! {
    &out.push("// JET_VETTED_UNSAFE_BEGIN: jet_process_pty\n\nmod jet_process_pty {{\n")
    &out.push(jet_rust_prefix_prelude(&state, "CoreLib/ProcessPty.rs"))
    &out.push("\n}}\n// JET_VETTED_UNSAFE_END: jet_process_pty\n// JET_VETTED_UNSAFE_BEGIN: jet_process_sandbox\n\nmod jet_process_sandbox {{\n")
    &out.push(jet_rust_prefix_prelude(&state, "CoreLib/Top/ProcessSandbox.rs"))
    &out.push(jet_rust_prefix_prelude(&state, "CoreLib/Top/ProcessWindowsSandbox.rs"))
    &out.push("\n}}\n// JET_VETTED_UNSAFE_END: jet_process_sandbox\n")
    jet_rust_prefix_push_files(&state, &out, [String]{"CoreLib/Top/ProcessPolicy.rs", "CoreLib/Top/ProcessSpec.rs", "CoreLib/Top/Process.rs"})
}

fn jet_rust_prefix_http_message(state: &JetRustPrefixState, out: &[String]) Never! {
    jet_rust_prefix_push_files(&state, &out, [String]{"Core/HttpRequestTarget.rs", "CoreLib/Top/HTTPMessage.rs"})
}

// mod.rs `push_typed_core_optional_parts`.
fn jet_rust_prefix_optional_parts(state: &JetRustPrefixState, out: &[String], parts: [MIRRuntimePartID], omit_testing_shared: Bool, policy: JetReleaseDevtoolsPolicy, version: String) Never! {
    if jet_rust_prefix_has(parts, MIRRuntimePartID.Email) -> &out.push(jet_rust_prefix_prelude(&state, "CoreLib/Email.rs"))
    needs_data :: jet_rust_prefix_has(parts, MIRRuntimePartID.Data)
    fs_runtime :: jet_rust_prefix_has(parts, MIRRuntimePartID.FSRuntime)
    process :: jet_rust_prefix_has(parts, MIRRuntimePartID.Process)
    http :: jet_rust_prefix_has(parts, MIRRuntimePartID.HTTP)
    web_socket :: jet_rust_prefix_has(parts, MIRRuntimePartID.WebSocket)
    browser :: jet_rust_prefix_has(parts, MIRRuntimePartID.Browser)
    sync :: jet_rust_prefix_has(parts, MIRRuntimePartID.Sync)
    services :: jet_rust_prefix_has(parts, MIRRuntimePartID.Services)
    if jet_rust_prefix_has(parts, MIRRuntimePartID.Game) {
        jet_rust_prefix_game_debug(&out, policy)
        &out.push(jet_rust_prefix_flat_body(jet_rust_prefix_foundation(&state, "Game.rs")))
        jet_rust_prefix_flat_files(&state, &out, [String]{"Core/GameAssetPipeline.rs", "Core/GameHotSwap.rs", "Core/GameWorldInspector.rs", "Core/GameFrameProfiler.rs", "Core/GameOverlay.rs"})
        &out.push("\nmod jet_devtools_control {{\n{jet_rust_prefix_replace(jet_rust_prefix_foundation(&state, "DevtoolsControl.rs"), "crate::Devtools::", "super::")}\n}}\n")
        // DevtoolsNative.rs supplies native callbacks and relay functions at
        // Prelude root; only control DTOs and command queues belong here.
        &out.push("pub use jet_devtools_control::{{JetDevtoolsCommand, JetDevtoolsCommandReceipt, JetDevtoolsGameControlKind,JetDevtoolsGameControlRequest, jet_devtools_clear_commands,jet_devtools_enqueue_command, jet_devtools_requeue_command_front,jet_devtools_command_count, jet_devtools_poll_command,jet_devtools_poll_database_explain, jet_devtools_enqueue_game_control,jet_devtools_poll_game_control, jet_devtools_record_command_receipt,jet_devtools_update_command_receipt, jet_devtools_poll_command_receipt,jet_devtools_command_receipt_count, jet_devtools_clear_command_receipts}};\n")
        &out.push(jet_rust_prefix_prelude(&state, "CoreLib/Top/GameDevProtocol.rs"))
        jet_rust_prefix_flat_files(&state, &out, [String]{"CoreLib/Top/GameAssetsImport.rs", "CoreLib/Top/GameAssetsRuntime.rs"})
        &out.push(jet_rust_prefix_prelude(&state, "CoreLib/Top/Game.rs"))
    }
    if jet_rust_prefix_has(parts, MIRRuntimePartID.Files) || fs_runtime -> &out.push(jet_rust_prefix_prelude(&state, "CoreLib/Top/PathFiles.rs"))
    if jet_rust_prefix_has(parts, MIRRuntimePartID.Interrupt) || process || fs_runtime -> &out.push(jet_rust_prefix_prelude(&state, "CoreLib/Top/Interrupt.rs"))
    if process || fs_runtime -> jet_rust_prefix_process(&state, &out)
    if fs_runtime {
        if !omit_testing_shared -> &out.push(jet_rust_prefix_prelude(&state, "CoreLib/Top/TestingShared.rs"))
        jet_rust_prefix_push_files(&state, &out, [String]{"CoreLib/Top/IoLineStream.rs", "Core/EnvConfig.rs", "Core/EnvProjection.rs", "Core/FSOps.rs", "CoreLib/Top/FileStream.rs", "CoreLib/Top/FSRuntimeOps.rs", "Core/StdinReader.rs", "CoreLib/Top/FSIoEnvOsTesting.rs", "Core/CollectionIoSources.rs", "CoreLib/Top/FSWriteOps.rs", "CoreLib/Top/PlatformFamily.rs"})
        &out.push("// JET_VETTED_UNSAFE_BEGIN: jet_os_extra\n")
        &out.push(jet_rust_prefix_prelude(&state, "CoreLib/Top/OsExtra.rs"))
        &out.push("// JET_VETTED_UNSAFE_END: jet_os_extra\n")
    }
    if jet_rust_prefix_has(parts, MIRRuntimePartID.Math) -> jet_rust_prefix_push_files(&state, &out, [String]{"CoreLib/Top/MathLibPure.rs", "CoreLib/Top/MathComplexTraits.rs", "CoreLib/Top/MathRandomFns.rs", "CoreLib/Top/LinalgFns.rs"})
    if needs_data -> &out.push(jet_rust_prefix_replace(jet_rust_prefix_prelude(&state, "CoreLib/Top/DataPlot.rs"), JET_RUST_PREFIX_DATA_PLOT_IMPORTS, ""))
    if jet_rust_prefix_has(parts, MIRRuntimePartID.DataFmt) {
        &out.push(jet_rust_prefix_replace(jet_rust_prefix_prelude(&state, "CoreLib/Top/DataQuery.rs"), "    include!(\"../../Core/SqlQuery.rs\");\n", jet_rust_prefix_prelude(&state, "Core/SqlQuery.rs")))
        &out.push(jet_rust_prefix_prelude(&state, "CoreLib/Top/DataFmt.rs"))
    }
    if needs_data {
        &out.push(jet_rust_prefix_prelude(&state, "CoreLib/Top/DataStats.rs"))
        &out.push("// JET_VETTED_UNSAFE_BEGIN: jet_data_flow\n")
        &out.push(jet_rust_prefix_prelude(&state, "CoreLib/Top/DataFlow.rs"))
        &out.push("\n// JET_VETTED_UNSAFE_END: jet_data_flow\n")
    }
    if jet_rust_prefix_has(parts, MIRRuntimePartID.Compute) {
        &out.push("// JET_VETTED_UNSAFE_BEGIN: jet_compute\n")
        &out.push(jet_rust_prefix_prelude(&state, "CoreLib/Top/Compute.rs"))
        &out.push("\n// JET_VETTED_UNSAFE_END: jet_compute\n")
    }
    if http {
        if !sync -> &out.push("struct JetDbRequestScope;\nimpl JetDbRequestScope {{ fn enter(_: Option<String>) -> Self {{ Self }} }}\n")
        jet_rust_prefix_http_message(&state, &out)
        jet_rust_prefix_push_files(&state, &out, [String]{"CoreLib/Top/HTTPRoute.rs", "CoreLib/Top/HTTPClient.rs", "CoreLib/Top/HTTPServer.rs"})
    } else if web_socket || browser {
        jet_rust_prefix_http_message(&state, &out)
    }
    if web_socket || http || browser -> jet_rust_prefix_push_files(&state, &out, [String]{"CoreLib/Top/WsClient.rs", "CoreLib/Top/Ws.rs"})
    if browser -> jet_rust_prefix_push_files(&state, &out, [String]{"CoreLib/Top/Browser.rs", "BrowserTest.rs"})
    if jet_rust_prefix_has(parts, MIRRuntimePartID.Args) -> jet_rust_prefix_push_files(&state, &out, [String]{"CoreLib/Top/Args.rs", "Core/ArgsProjectionCore.rs", "Core/ArgsProjection.rs"})
    if jet_rust_prefix_has(parts, MIRRuntimePartID.Reflect) -> &out.push(jet_rust_prefix_prelude(&state, "CoreLib/Top/Reflect.rs"))
    if jet_rust_prefix_has(parts, MIRRuntimePartID.AuthSession) -> &out.push(jet_rust_prefix_prelude(&state, "CoreLib/Top/AuthSession.rs"))
    if sync {
        &out.push("\nmod jet_sync {{\n")
        &out.push(jet_rust_prefix_replace(jet_rust_prefix_prelude(&state, "CoreLib/Top/Sync.rs"), "include!(\"../SyncPublish.rs\");", jet_rust_prefix_prelude(&state, "CoreLib/SyncPublish.rs")))
        &out.push("\n}}\npub(crate) use jet_sync::*;\n")
    }
    // push_runtime_devtools_panel_preludes: producer-only panel facts when
    // the full panel surface is compiled out.
    if !(policy.panel_code && jet_rust_prefix_has(parts, MIRRuntimePartID.Devtools)) {
        if needs_data || jet_rust_prefix_has(parts, MIRRuntimePartID.DataFmt) -> &out.push(jet_rust_prefix_prelude(&state, "Core/DevtoolsDatabasePanel.rs"))
        if http -> &out.push(jet_rust_prefix_prelude(&state, "Core/DevtoolsRequestPanel.rs"))
        if process || fs_runtime || http || services -> &out.push(jet_rust_prefix_prelude(&state, "Core/DevtoolsTopologyPanel.rs"))
    }
    if services {
        &out.push(jet_rust_prefix_flat_body(jet_rust_prefix_prelude(&state, "CoreLib/Top/ServiceAuthority.rs")))
        &out.push(jet_rust_prefix_prelude(&state, "CoreLib/Top/JobQueueNative.rs"))
        &out.push(jet_rust_prefix_prelude(&state, "CoreLib/Top/Services.rs"))
    }
    if jet_rust_prefix_has(parts, MIRRuntimePartID.Mod) {
        &out.push("\nconst __JET_COMPILER_VERSION: &str = {jet_rust_emit_quote(version)};\n")
        &out.push(jet_rust_prefix_prelude(&state, "CoreLib/Top/Mod.rs"))
        &out.push("\n")
    }
}

// mod.rs `push_typed_app_preludes`.
fn jet_rust_prefix_app_parts(state: &JetRustPrefixState, out: &[String], parts: [MIRRuntimePartID]) Never! {
    apps :: jet_rust_prefix_has(parts, MIRRuntimePartID.Apps)
    if jet_rust_prefix_has(parts, MIRRuntimePartID.Sync) || apps -> &out.push(jet_rust_prefix_prelude(&state, "CoreLib/Top/LiveQuery.rs"))
    if !apps -> return
    &out.push("mod jet_app_middleware {{\n{jet_rust_prefix_foundation(&state, "AppMiddleware.rs")}\n}}\n")
    jet_rust_prefix_flat_files(&state, &out, [String]{"Core/WebPending.rs", "CoreLib/Top/WebRouter.rs", "CoreLib/Top/OpenAPI.rs", "CoreLib/Top/WebQuery.rs", "CoreLib/Top/WebForms.rs", "CoreLib/Top/WebTable.rs", "CoreLib/Top/WebVirtual.rs", "CoreLib/Top/WebStore.rs", "CoreLib/Top/WebServerFn.rs"})
    jet_rust_prefix_push_files(&state, &out, [String]{"DevServer.rs", "App.rs"})
}

// mod.rs `push_full_corelib_prelude_with_policy`.
fn jet_rust_prefix_full_corelib(state: &JetRustPrefixState, out: &[String], linux: Bool, test_harness: Bool, edition: String, parts: [MIRRuntimePartID], uses_shared: Bool, uses_arrow: Bool, policy: JetReleaseDevtoolsPolicy) Never! {
    &out.push("const __JET_PACKAGE_EDITION: u16 = {jet_rust_prefix_edition_year(edition)};\n\n")
    body := [String]{}
    jet_rust_prefix_corelib_body(&state, &body, jet_rust_prefix_has(parts, MIRRuntimePartID.FSRuntime), uses_shared, uses_arrow || jet_rust_prefix_has(parts, MIRRuntimePartID.Data))
    body_text :: body.join("")
    &out.push(jet_rust_prefix_corelib_identity(body_text))
    &out.push("\n")
    &out.push(body_text)
    if test_harness {
        &out.push(jet_rust_prefix_foundation(&state, "Report.rs"))
        &out.push(jet_rust_prefix_prelude(&state, "TestReport.rs"))
        &out.push(jet_rust_prefix_prelude(&state, "CoreLib/Top/TestingShared.rs"))
        &out.push(jet_rust_prefix_raw_const(&state, "TEST_PRELUDE"))
        &out.push(jet_rust_prefix_raw_const(&state, "PROP_PRELUDE"))
        &out.push(jet_rust_prefix_prelude(&state, "Core/CAbiTest.rs"))
    }
    &out.push(jet_rust_prefix_scheduler(&state))
    &out.push(jet_rust_prefix_prelude(&state, "Core/Stream.rs"))
    &out.push(jet_rust_prefix_raw_const(&state, "CORE_STREAM_DURATION_ADAPTER"))
    &out.push(jet_rust_prefix_prelude(&state, "Core/CollectionSources.rs"))
    if jet_rust_prefix_has(parts, MIRRuntimePartID.Realtime) -> &out.push(jet_rust_prefix_prelude(&state, "Core/Realtime.rs"))
    if jet_rust_prefix_has(parts, MIRRuntimePartID.EmbeddedHardware) -> &out.push(jet_rust_prefix_flat_body(jet_rust_prefix_prelude(&state, "Core/EmbeddedHardware.rs")))
    &out.push(jet_rust_prefix_flat_body(jet_rust_prefix_prelude(&state, "Core/ParallelPlan.rs")))
    if jet_rust_prefix_has(parts, MIRRuntimePartID.UI) {
        &out.push(jet_rust_prefix_font_prelude(&state))
        &out.push(jet_rust_prefix_prelude(&state, "Core/HostServices.rs"))
        // mod.rs `FONT_STYLE_COMPARABLE`: Core source compares the native FontStyle with `==`.
        &out.push("impl __jet_Comparable for JetFontStyle {{ fn compare(&self, rhs: &Self) -> __jet_Ordering {{ match (*self as u8).cmp(&(*rhs as u8)) {{ std::cmp::Ordering::Less => __jet_Ordering::__jet_Less, std::cmp::Ordering::Equal => __jet_Ordering::__jet_Equal, std::cmp::Ordering::Greater => __jet_Ordering::__jet_Greater }} }} }}\n")
        &out.push("\nmod jet_tui_kernel {{\n{jet_rust_prefix_foundation(&state, "Prelude/TuiKernel.rs")}\n}}\n")
        &out.push(jet_rust_prefix_prelude(&state, "Ui.rs"))
        &out.push(jet_rust_prefix_prelude(&state, "Core/Preview.rs"))
    }
    if policy.panel_code && jet_rust_prefix_has(parts, MIRRuntimePartID.Devtools) {
        jet_rust_prefix_push_files(&state, &out, [String]{"Core/DevtoolsPanel.rs", "Core/DevtoolsPanelCatalog.rs", "Core/DevtoolsDatabasePanel.rs", "Core/DevtoolsJobsPanel.rs", "Core/DevtoolsRequestPanel.rs", "Core/DevtoolsTelemetryPanel.rs", "Core/DevtoolsTopologyPanel.rs"})
    }
    if jet_rust_prefix_has(parts, MIRRuntimePartID.Gtk) && linux -> &out.push(jet_rust_prefix_prelude(&state, "UiGtk.rs"))
    version :: jet_rust_prefix_compiler_version(&state)
    jet_rust_prefix_optional_parts(&state, &out, parts, test_harness, policy, version)
    jet_rust_prefix_app_parts(&state, &out, parts)
}

// ---- strip_test_items (crates/jet-foundation/src/RustSource.rs) ----------------

fn jet_rust_prefix_byte(bytes: [U8], index: Int) -> Int Never! {
    if index < 0 || index >= bytes.len() -> return -1
    Int.from_u8(bytes[index])
}

// `raw_string_start`: [prefix length, hash count], or empty.
fn jet_rust_prefix_raw_start(bytes: [U8], at: Int) -> [Int] Never! {
    first :: jet_rust_prefix_byte(bytes, at)
    index := 0
    if {
        first == 114 -> index = 1
        first == 98 && jet_rust_prefix_byte(bytes, at + 1) == 114 -> index = 2
        else -> return [Int]{}
    }
    start :: index
    loop jet_rust_prefix_byte(bytes, at + index) == 35 -> index += 1
    if jet_rust_prefix_byte(bytes, at + index) != 34 -> return [Int]{}
    [Int]{index + 1, index - start}
}

// `char_literal_end`: true when a char literal starts at `at`.
fn jet_rust_prefix_char_literal(bytes: [U8], at: Int) -> Bool Never! {
    if jet_rust_prefix_byte(bytes, at) != 39 -> return false
    lead :: jet_rust_prefix_byte(bytes, at + 1)
    if lead < 0 -> return false
    if lead != 92 {
        width :: if {
            lead <= 127 -> 1
            lead >= 192 && lead <= 223 -> 2
            lead >= 224 && lead <= 239 -> 3
            lead >= 240 && lead <= 247 -> 4
            else -> 0
        }
        if width == 0 || at + 1 + width > bytes.len() -> return false
        loop offset in 1..<width {
            continuation :: jet_rust_prefix_byte(bytes, at + 1 + offset)
            if continuation < 128 || continuation > 191 -> return false
        }
        return jet_rust_prefix_byte(bytes, at + 1 + width) == 39
    }
    escaped := false
    index := at + 1
    loop index < bytes.len() {
        byte :: Int.from_u8(bytes[index])
        if {
            escaped -> escaped = false
            byte == 92 -> escaped = true
            byte == 39 -> return true
            byte == 10 -> return false
            else -> {}
        }
        index += 1
    }
    false
}

// `rust_code_mask`: comments and literals blanked to spaces, newlines kept.
fn jet_rust_prefix_code_mask(bytes: [U8]) -> [U8] Never! {
    space :: U8{32}
    newline :: U8{10}
    out := [U8]{}
    // 0 code, 1 line comment, 2 block comment, 3 string, 4 raw string, 5 char
    state := 0
    depth := 0
    escaped := false
    hashes := 0
    index := 0
    loop index < bytes.len() {
        byte :: Int.from_u8(bytes[index])
        if state == 0 {
            next_byte :: jet_rust_prefix_byte(bytes, index + 1)
            raw :: if byte == 114 || byte == 98 -> jet_rust_prefix_raw_start(bytes, index) else -> [Int]{}
            if byte == 47 && next_byte == 47 {
                &out.push(space)
                &out.push(space)
                index += 2
                state = 1
            } else if byte == 47 && next_byte == 42 {
                &out.push(space)
                &out.push(space)
                index += 2
                state = 2
                depth = 1
            } else if raw.len() == 2 {
                loop _ in 0..<raw[0] -> &out.push(space)
                index += raw[0]
                hashes = raw[1]
                state = 4
            } else if byte == 34 || (byte == 98 && next_byte == 34) {
                width :: if byte == 98 -> 2 else -> 1
                loop _ in 0..<width -> &out.push(space)
                index += width
                state = 3
                escaped = false
            } else if byte == 39 && jet_rust_prefix_char_literal(bytes, index) {
                &out.push(space)
                index += 1
                state = 5
                escaped = false
            } else {
                &out.push(bytes[index])
                index += 1
            }
        } else if state == 1 {
            if byte == 10 {
                &out.push(newline)
                state = 0
            } else {
                &out.push(space)
            }
            index += 1
        } else if state == 2 {
            next_byte :: jet_rust_prefix_byte(bytes, index + 1)
            if byte == 47 && next_byte == 42 {
                &out.push(space)
                &out.push(space)
                index += 2
                depth += 1
            } else if byte == 42 && next_byte == 47 {
                &out.push(space)
                &out.push(space)
                index += 2
                depth -= 1
                if depth == 0 -> state = 0
            } else {
                &out.push(if byte == 10 -> newline else -> space)
                index += 1
            }
        } else if state == 3 {
            &out.push(if byte == 10 -> newline else -> space)
            index += 1
            if {
                escaped -> escaped = false
                byte == 92 -> escaped = true
                byte == 34 -> state = 0
                else -> {}
            }
        } else if state == 4 {
            closes := byte == 34 && index + 1 + hashes <= bytes.len()
            if closes {
                loop offset in 0..<hashes {
                    if Int.from_u8(bytes[index + 1 + offset]) != 35 -> closes = false
                }
            }
            &out.push(if byte == 10 -> newline else -> space)
            index += 1
            if closes {
                loop _ in 0..<hashes {
                    &out.push(space)
                    index += 1
                }
                state = 0
            }
        } else {
            &out.push(space)
            index += 1
            if {
                escaped -> escaped = false
                byte == 92 -> escaped = true
                byte == 39 -> state = 0
                else -> {}
            }
        }
    }
    out
}

fn jet_rust_prefix_skip_space(code: [U8], start: Int) -> Int Never! {
    index := start
    loop index < code.len() && jet_rust_prefix_is_space(code[index]) -> index += 1
    index
}

// `closing_bracket`: the index closing the bracket at `open`, or -1.
fn jet_rust_prefix_closing(code: [U8], open: Int) -> Int Never! {
    depth := 0
    index := open
    loop index < code.len() {
        byte :: Int.from_u8(code[index])
        if byte == 40 || byte == 91 || byte == 123 {
            depth += 1
        } else if byte == 41 || byte == 93 || byte == 125 {
            if depth == 0 -> return -1
            depth -= 1
            if depth == 0 -> return index
        }
        index += 1
    }
    -1
}

fn jet_rust_prefix_past_line(code: [U8], end: Int) -> Int Never! {
    index := end
    loop index < code.len() && (Int.from_u8(code[index]) == 32 || Int.from_u8(code[index]) == 9 || Int.from_u8(code[index]) == 13) -> index += 1
    if index >= code.len() -> return index
    if Int.from_u8(code[index]) == 10 -> return index + 1
    end
}

JET_RUST_PREFIX_BODY_ITEMS :: [String]{"fn ", "mod ", "impl ", "impl<", "trait ", "struct ", "enum ", "union ", "macro_rules!", "thread_local!", "unsafe fn ", "unsafe impl", "unsafe trait ", "async fn ", "const fn ", "const unsafe fn ", "extern "}
JET_RUST_PREFIX_SEMICOLON_ITEMS :: [String]{"const ", "static ", "use ", "type "}

// `test_item_end`: past the item whose attributes start at `at`, or -1.
fn jet_rust_prefix_test_item_end(code: [U8], at: Int) -> Int Never! {
    index := at
    loop {
        index = jet_rust_prefix_skip_space(code, index)
        if jet_rust_prefix_byte(code, index) == 35 && jet_rust_prefix_byte(code, index + 1) == 91 {
            close :: jet_rust_prefix_closing(code, index + 1)
            if close < 0 -> return -1
            index = close + 1
        } else {
            break
        }
    }
    if jet_rust_prefix_at(code, index, "pub(") {
        close :: jet_rust_prefix_closing(code, index + 3)
        if close < 0 -> return -1
        index = jet_rust_prefix_skip_space(code, close + 1)
    } else if jet_rust_prefix_at(code, index, "pub ") {
        index = jet_rust_prefix_skip_space(code, index + 4)
    }
    body_item := false
    known := false
    loop keyword in JET_RUST_PREFIX_BODY_ITEMS {
        if jet_rust_prefix_at(code, index, keyword) {
            body_item = true
            known = true
        }
    }
    if !known {
        loop keyword in JET_RUST_PREFIX_SEMICOLON_ITEMS {
            if jet_rust_prefix_at(code, index, keyword) -> known = true
        }
    }
    if !known -> return -1
    depth := 0
    angles := 0
    in_body := false
    position := index
    loop position < code.len() {
        byte :: Int.from_u8(code[position])
        generic_header :: body_item && !in_body && depth == 0
        if byte == 60 && generic_header {
            angles += 1
        } else if byte == 62 && generic_header && position > index && Int.from_u8(code[position - 1]) != 45 {
            if angles == 0 -> return -1
            angles -= 1
        } else if byte == 123 {
            if depth == 0 && angles == 0 -> in_body = true
            depth += 1
        } else if byte == 40 || byte == 91 {
            depth += 1
        } else if byte == 41 || byte == 93 {
            if depth == 0 -> return -1
            depth -= 1
        } else if byte == 125 {
            if depth == 0 -> return -1
            depth -= 1
            if depth == 0 && body_item && in_body -> return jet_rust_prefix_past_line(code, position + 1)
        } else if byte == 59 && depth == 0 && angles == 0 {
            return jet_rust_prefix_past_line(code, position + 1)
        }
        position += 1
    }
    -1
}

fn jet_rust_prefix_indent(bytes: [U8], start: Int, end: Int) -> Int Never! {
    index := start
    loop index < end && (Int.from_u8(bytes[index]) == 32 || Int.from_u8(bytes[index]) == 9) -> index += 1
    index
}

fn jet_rust_prefix_line_starts(bytes: [U8], at: Int, end: Int, prefix: String) -> Bool Never! {
    at + prefix.bytes().len() <= end && jet_rust_prefix_at(bytes, at, prefix)
}

// `leading_item_start`: the first doc/attribute line above `line_start`, or -1.
fn jet_rust_prefix_leading_start(source: [U8], code: [U8], line_start: Int, floor: Int) -> Int Never! {
    start := line_start
    loop start > floor {
        previous := start - 1
        loop previous > floor && Int.from_u8(source[previous - 1]) != 10 -> previous -= 1
        doc :: jet_rust_prefix_line_starts(source, jet_rust_prefix_indent(source, previous, start), start, "///")
        attribute :: jet_rust_prefix_line_starts(code, jet_rust_prefix_indent(code, previous, start), start, "#[")
        if !(doc || attribute) -> break
        start = previous
    }
    above := start
    loop above > floor && jet_rust_prefix_is_space(code[above - 1]) -> above -= 1
    found :: above == floor || Int.from_u8(code[above - 1]) != 93
    if found -> start else -> -1
}

// `strip_test_items`: drop every `#[cfg(test)]`/`#[test]` item with its docs.
fn jet_rust_prefix_strip_test_items(text: String) -> String Never! {
    source :: text.bytes()
    code :: jet_rust_prefix_code_mask(source)
    out := [String]{}
    kept := 0
    line_start := 0
    newline :: "\n".bytes()
    loop line_start < code.len() {
        found :: jet_rust_prefix_find(code, newline, line_start)
        line_end :: if found < 0 -> code.len() else -> found + 1
        at :: jet_rust_prefix_indent(code, line_start, line_end)
        if jet_rust_prefix_line_starts(code, at, line_end, "#[cfg(test)]") || jet_rust_prefix_line_starts(code, at, line_end, "#[test]") {
            end :: jet_rust_prefix_test_item_end(code, at)
            if end >= 0 {
                start :: jet_rust_prefix_leading_start(source, code, line_start, kept)
                if start >= 0 {
                    &out.push(jet_rust_prefix_slice(source, kept, start))
                    kept = end
                    line_start = end
                    next
                }
            }
        }
        line_start = line_end
    }
    if kept == 0 -> return text.copy()
    &out.push(jet_rust_prefix_slice(source, kept, source.len()))
    out.join("")
}

// ---- the artifact prefix -------------------------------------------------------

fn jet_rust_prefix_type_uses_shared(ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .Apply(name, args) -> {
            if name.name == "Pool" || name.name == "ID" || name.name == "Shared" -> return true
            loop arg in args { if jet_rust_prefix_type_uses_shared(arg) -> return true }
            false
        }
        .List(inner) | .Shared(inner) | .Option(inner) | .FixedList(inner, _) | .InlineRange(inner, _, _) | .Tagged(_, inner) | .Quantity(inner, _) -> jet_rust_prefix_type_uses_shared(inner)
        .Map(key, value) | .Result(key, value) -> jet_rust_prefix_type_uses_shared(key) || jet_rust_prefix_type_uses_shared(value)
        .Fn(signature) -> {
            loop param in signature.params { if jet_rust_prefix_type_uses_shared(param) -> return true }
            if signature.ret == .Val(ret) {
                if jet_rust_prefix_type_uses_shared(ret) -> return true
            }
            false
        }
        .SendFn(params, ret, _) -> {
            loop param in params { if jet_rust_prefix_type_uses_shared(param) -> return true }
            if ret == .Val(value) {
                if jet_rust_prefix_type_uses_shared(value) -> return true
            }
            false
        }
        .Tuple(fields) -> {
            loop field in fields { if jet_rust_prefix_type_uses_shared(field.ty) -> return true }
            false
        }
        .Union(members) -> {
            loop member in members { if jet_rust_prefix_type_uses_shared(member) -> return true }
            false
        }
        else -> false
    }
}

fn jet_rust_prefix_symbol(symbol: MIRSymbol) -> String Never! {
    if symbol == {
        .Prelude(name) -> name
        .Runtime(name) -> name
    }
}

fn jet_rust_prefix_symbol_is_prelude(symbol: MIRSymbol) -> Bool Never! {
    if symbol == {
        .Prelude(_) -> true
        else -> false
    }
}

// MIRRust `mir_program_uses_shared_kernel`.
fn jet_rust_prefix_uses_shared(program: MIRProgram) -> Bool Never! {
    loop ty in program.type_instances {
        if jet_rust_prefix_type_uses_shared(ty) -> return true
    }
    loop call in program.prelude_calls {
        if jet_rust_prefix_symbol(call.symbol).starts_with("jet_shared_") -> return true
    }
    false
}

// The FFI bridge macros MIRRust `push_runtime_block` appends after the Core block.
fn jet_rust_prefix_ffi_bridges(out: &[String], program: MIRProgram, crate_name: String) Never! {
    http := false
    tls := false
    plugin := false
    db := false
    vault := false
    loop call in program.prelude_calls {
        symbol :: jet_rust_prefix_symbol(call.symbol)
        if symbol == "jet_http_client_get" || symbol == "jet_http_client_post" || symbol == "jet_http_client_request_send" -> http = true
        if symbol == "jet_net_tls_client" || symbol == "jet_net_tls_client_deadline" || symbol == "jet_net_tls_client_config_deadline" || symbol == "jet_tls_root_certificates_from_pem" || symbol == "jet_tls_client_identity_from_pem" -> tls = true
        if jet_rust_prefix_symbol_is_prelude(call.symbol) && symbol == "jet_plugin_load" -> plugin = true
        if symbol.starts_with("jet_db_") -> db = true
        segments :: symbol.split("::").to_list()
        if segments[segments.len() - 1].starts_with("jet_vault_") -> vault = true
    }
    if http -> &out.push("jet_http_client_bridge!({crate_name});\n")
    if tls -> &out.push("jet_net_tls_client_bridge!({crate_name});\n")
    if plugin -> &out.push("jet_plugin_bridge!({crate_name});\n")
    if db -> &out.push("jet_db_bridge!({crate_name});\n")
    if vault -> &out.push("jet_vault_display_bridge!({crate_name});\n")
}

// OSTarget::parse(facts.active_os), else from_triple(triple), else the host
// (Linux for every host this assembler runs on but Windows and macOS).
fn jet_rust_prefix_active_linux(active_os: String, triple: String) -> Bool Never! {
    if active_os == "Linux" -> return true
    if active_os == "MacOS" || active_os == "Windows" -> return false
    if triple.contains("windows") || triple.contains("apple") || triple.contains("darwin") -> return false
    true
}

// MIRRust `emit_mir_runtime_text` for `artifact` under `inputs`.
fn jet_rust_runtime_prefix(program: MIRProgram, artifact: MIRArtifactPlan, inputs: JetRustRuntimePrefixInputs) -> JetRustRuntimePrefix Never! {
    if program.facts.target_dossier.machine == .Val(machine) {
        if machine.no_os -> return JetRustRuntimePrefix.Refused{message: "the Jet host does not assemble the no-OS portable runtime yet; build this target with the Rust `jet`"}
    }
    state := JetRustPrefixState{sources: inputs.sources, assets: inputs.assets, failure: None}
    parts :: artifact.runtime_parts
    uses_arrow :: program.facts.uses_arrow || jet_rust_prefix_has(parts, MIRRuntimePartID.Data)
    block := [String]{}
    if inputs.ffi_crate != None -> jet_rust_prefix_ffi_reporter(&block, inputs.ffi_crate)
    &block.push("// jet:cached-runtime-begin\n")
    jet_rust_prefix_cached_runtime(&state, &block, inputs.ffi_crate, uses_arrow, inputs.policy)
    &block.push("// jet:cached-runtime-end\n")
    &block.push("// jet:cached-core-begin\n")
    test_harness :: artifact.harness != None || artifact.kind == MIRArtifactKind.TestExecutable || artifact.kind == MIRArtifactKind.FuzzExecutable || artifact.kind == MIRArtifactKind.TestOverride
    jet_rust_prefix_full_corelib(&state, &block, jet_rust_prefix_active_linux(program.facts.active_os, inputs.target_triple), test_harness, program.facts.edition, parts, jet_rust_prefix_uses_shared(program), uses_arrow, inputs.policy)
    &block.push("// jet:cached-core-end\n")
    if inputs.ffi_crate == .Val(crate_name) -> jet_rust_prefix_ffi_bridges(&block, program, crate_name)
    &block.push("\n")
    text := jet_rust_prefix_strip_test_items(block.join(""))
    if artifact.mode == MIRArtifactBuildMode.Coverage -> text = "{text}{jet_rust_prefix_raw_const(&state, "COVERAGE_PRELUDE")}"
    if state.failure == .Val(message) -> return JetRustRuntimePrefix.Refused{message: message}
    JetRustRuntimePrefix.Text{text: text}
}

// Package ReleaseDevtoolsPolicy: `development()` for None, else
// `from_manifest_profile(inspect)` (the deployment comes from the environment
// and does not reach the runtime prefix).
fn jet_rust_release_devtools_policy(inspect: JetReleaseInspect?) -> JetReleaseDevtoolsPolicy Never! {
    endpoint := JetReleaseDevtoolsEndpoint.Absent
    local_rail := true
    panel_code := true
    stream_code := true
    if inspect == .Val(mode) {
        if mode == {
            .Local -> {
                panel_code = false
                stream_code = false
            }
            .ReadOnly -> endpoint = JetReleaseDevtoolsEndpoint.ReadOnly
            .Disabled -> {
                local_rail = false
                panel_code = false
                stream_code = false
            }
        }
    }
    JetReleaseDevtoolsPolicy{
        inspect: inspect,
        endpoint: endpoint,
        authentication: JetReleaseDevtoolsAuthentication.BearerToken,
        authority: JetReleaseDevtoolsAuthority.LoopbackOrAllowlist,
        publication: JetReleaseDevtoolsPublication.SiteGated,
        local_rail: local_rail,
        panel_code: panel_code,
        stream_code: stream_code,
        deployment: JetReleaseDevtoolsDeployment{enabled: false, token: None, allowlist: [JetReleaseDevtoolsNetwork]{}},
    }
}
