fn jet_rust_emit_core_email_type_name(raw: String) -> String? {
    prefix :: "<corelib>/Core/email::Core/email/email.jet::"
    name :: if raw.starts_with(prefix) -> jet_rust_emit_core_source_type_leaf(raw) else -> ~raw
    leaf :: jet_rust_emit_qualified_leaf_under(name, [String]{"email", "core.email", "core::email"}) ?? return None
    if leaf == "EmailError" -> return Val("Error")
    carriers :: [String]{"Address", "Message", "Attachment", "Envelope", "SMTPSecurity", "RecipientPolicy", "RecipientReport", "SendReport", "Limits", "SMTPAuth", "TLSTrust", "DKIMConfig", "SMTPConfig", "Mailer"}
    if carriers.contains(leaf) -> return Val(leaf)
    None
}

fn jet_rust_emit_core_crypto_rust_type_name(raw: String) -> String? {
    name := ~raw
    if raw.starts_with("<corelib>/Core/crypto::Core/crypto/crypto.jet::") || raw.starts_with("<corelib>/Core/crypto::Core/crypto/expert.jet::") -> name = jet_rust_emit_core_source_type_leaf(raw)
    leaf :: jet_rust_emit_qualified_leaf_under(name, [String]{"crypto", "core.crypto", "core::crypto"}) ?? return None
    if leaf == {
        "WrappedVaultKey" -> Val("JetWrappedVaultKey")
        "KeyUnlock" -> Val("JetVaultKeyUnlock<'_>")
        "KeyWrapError" -> Val("JetVaultKeyWrapError")
        else -> None
    }
}

fn jet_rust_emit_core_ui_type_name(name: String) -> String? {
    result_aliases :: [String]{"UIServiceResult", "UIFileFilterResult", "UIFSGrantResult", "UIShortcutResult", "UiShortcutBindingResult", "UIAccessibilityResult", "UIFileDialogResult", "UIClipboardTextResult", "UIClipboardWriteResult", "UIIMEResult", "UIDragResult", "UIShortcutDispatchResult", "UIAccessibilityNodeResult", "UIAccessibilityAttachResult", "UIAccessibilityProjectionResult"}
    if result_aliases.contains(name) -> return None
    loop row in CORE_MODULE_EXPORTS {
        if (row.module_name == "core.ui" || row.module_name == "core.ui.host") && row.type_exports.contains(name) -> return Val(~name)
    }
    None
}

fn jet_rust_emit_history_type_name(name: String) -> String? {
    leaf :: jet_rust_emit_core_qualified_leaf(name) ?? return None
    records :: [String]{"Count", "HandleID", "TaskID", "EventID", "HistoryRNG", "HistoryValue", "HistoryPrecondition", "HistoryCase", "HistoryOperation", "HistoryScheduleChoice", "HistoryBounds", "HistoryDistribution", "HistoryStrategy", "TypedHistoryCase"}
    if records.contains(leaf) -> return Val(leaf)
    None
}

// MIRRust has_native_type_projection: the declaration is a Prelude carrier, so the
// program spells the native Rust type (raw field and variant names) and never
// declares it.
fn jet_rust_emit_has_native_type_projection(name: String) -> Bool Never! {
    if jet_rust_emit_source_owned_core_shape(name) -> return false
    probe :: jet_rust_emit_core_native_probe_name(name)
    if jet_rust_emit_core_rust_type_name(name) != None || jet_rust_emit_root_prelude_type_name(probe) != None || jet_rust_emit_core_ui_type_name(probe) != None -> return true
    if jet_rust_emit_compute_handle_type_name(probe) != None || jet_rust_emit_service_handle_type_name(probe) != None || jet_rust_emit_alloc_handle_type_name(probe) != None -> return true
    if jet_rust_emit_file_handle_type_name(name) != None || jet_rust_emit_reflect_handle_type_name(probe) != None || jet_rust_emit_binary_text_handle_type_name(probe) != None -> return true
    jet_rust_emit_core_email_type_name(name) != None || jet_rust_emit_core_crypto_rust_type_name(name) != None
}

fn jet_rust_emit_is_canonical_core_native_type(name: String) -> Bool Never! {
    name.starts_with("<corelib>/") && jet_rust_emit_has_native_type_projection(name)
}

// MIRRust collect_type_fields: the vault ffi records keep raw field names too.
fn jet_rust_emit_vault_host_record(key: String) -> Bool Never! {
    if !key.starts_with("<corelib>/") && (key.contains("::") || key.contains(".")) -> return false
    separator :: if key.contains("::") -> "::" else -> "."
    parts :: key.split(separator).to_list()
    leaf :: parts[parts.len() - 1]
    records :: [String]{"KeyRef", "KeyStatus", "MutationPlan", "Rotation", "VaultError", "VaultWrite", "WrappedImportPlan"}
    records.contains(leaf)
}

fn jet_rust_emit_root_prelude_type(ctx: &JetRustEmitContext, root_name: String, args: [MIRType]) -> String Never! {
    head :: "{ctx.config.root_prefix}{root_name}"
    if args.len() == 0 -> return head
    rendered := [String]{}
    loop arg in args -> &rendered.push(jet_rust_emit_type(&ctx, arg))
    "{head}<{rendered.join(", ")}>"
}

// MIRRust `config.execution.ffi` defaults to the `jet_ffi` link crate; the Jet
// driver links no other FFI crate.
fn jet_rust_emit_ffi_crate() -> String Never! { "jet_ffi" }

// MIRRust rust_apply_type, the Prelude-carrier arms between the cursor carriers and
// the declared nominal lookup. None means the name is an ordinary declared nominal.
fn jet_rust_emit_native_apply_type(ctx: &JetRustEmitContext, name: MIRNominalRef, args: [MIRType]) -> String? {
    root :: ~ctx.config.root_prefix
    native_name :: jet_rust_emit_core_native_probe_name(name.name)
    user_declared :: ctx.type_by_name.get(name.name) != None
    if name.name == "Tally" && args.len() == 1 -> return Val("std::collections::HashMap<{jet_rust_emit_type(&ctx, args[0])}, usize>")
    if name.name == "Queue" && args.len() == 1 -> return Val("std::collections::VecDeque<{jet_rust_emit_type(&ctx, args[0])}>")
    if args.len() == 0 && name.name == "Group" -> return Val("{root}jet_std::JetTaskGroup")
    if name.name == "Instant" -> return Val(jet_rust_emit_root_prelude_type(&ctx, "JetInstant", args))
    if name.name == "RealtimeStream" -> return Val("{root}jet_std::JetRealtimeStream")
    if name.name == "RealtimeReceipt" -> return Val("{root}jet_std::JetRealtimeReceipt")
    if (name.name == "Cell" || name.name == "CellReadGuard" || name.name == "CellEditGuard") && args.len() == 1 {
        carrier :: if name.name == {
            "Cell" -> "JetCell"
            "CellReadGuard" -> "JetCellReadGuard"
            else -> "JetCellEditGuard"
        }
        return Val("{root}jet_std::{carrier}<{jet_rust_emit_type(&ctx, args[0])}>")
    }
    if jet_rust_emit_file_handle_type_name(name.name) == .Val(handle) -> return Val("{root}{handle}")
    if jet_rust_emit_reflect_handle_type_name(native_name) == .Val(handle) -> return Val(jet_rust_emit_root_prelude_type(&ctx, handle, args))
    if jet_rust_emit_binary_text_handle_type_name(native_name) == .Val(handle) {
        if name.name.starts_with("<corelib>/") || !user_declared -> return Val("{root}{handle}")
    }
    if (name.name == "Tensor" && args.len() <= 1) || name.name == "Vec" || name.name == "Matrix" -> return Val("{root}JetTensor")
    if (name.name == "KeyRef" || name.name == "MutationPlan" || name.name == "VaultWrite" || name.name == "Rotation" || name.name == "WrappedImportPlan") && args.len() == 1 {
        rust :: if name.name == {
            "KeyRef" -> "JetVaultKeyRef"
            "MutationPlan" -> "JetVaultMutationPlan"
            "VaultWrite" -> "JetVaultWrite"
            "Rotation" -> "JetVaultRotation"
            else -> "JetVaultWrappedImportPlan"
        }
        return Val("{jet_rust_emit_ffi_crate()}::{rust}<{jet_rust_emit_type(&ctx, args[0])}>")
    }
    if name.name == "ExpiringSecret" && args.len() == 1 -> return Val("JetExpiringSecret<{jet_rust_emit_type(&ctx, args[0])}>")
    if name.name == "ExpiringValue" && args.len() == 1 -> return Val("JetExpiring<{jet_rust_emit_type(&ctx, args[0])}>")
    if jet_rust_emit_core_email_type_name(name.name) == .Val(email) {
        if (email == "SMTPAuth" || email == "DKIMConfig" || email == "SMTPConfig") && args.len() == 0 -> return Val("{root}jet_email::{email}<{jet_rust_emit_ffi_crate()}::Secret>")
        return Val(jet_rust_emit_root_prelude_type(&ctx, "jet_email::{email}", args))
    }
    if jet_rust_emit_core_ui_type_name(native_name) == .Val(ui) -> return Val(jet_rust_emit_root_prelude_type(&ctx, "Jet{ui}", args))
    if name.name == "HTML" && args.len() == 0 -> return Val("String")
    if name.name == "Measurement" && args.len() == 1 -> return Val("{root}jet_std::JetMeasurement<{jet_rust_emit_type(&ctx, args[0])}>")
    if jet_rust_emit_root_prelude_type_name(native_name) == .Val(prelude) -> return Val(jet_rust_emit_root_prelude_type(&ctx, prelude, args))
    if jet_rust_emit_history_type_name(name.name) == .Val(history) {
        carrier :: "crate::jet_testing_history_foundation::{history}"
        if args.len() == 0 -> return Val(carrier)
        rendered := [String]{}
        loop arg in args -> &rendered.push(jet_rust_emit_type(&ctx, arg))
        return Val("{carrier}<{rendered.join(", ")}>")
    }
    if jet_rust_emit_compute_handle_type_name(native_name) == .Val(compute) -> return Val(jet_rust_emit_root_prelude_type(&ctx, compute, args))
    if jet_rust_emit_service_handle_type_name(native_name) == .Val(service) -> return Val(jet_rust_emit_root_prelude_type(&ctx, service, args))
    if args.len() == 0 && jet_rust_emit_alloc_handle_type_name(native_name) == .Val(allocator) -> return Val("{root}{allocator}")
    // A bare trait name surviving in an Apply row resolves to its one trait object.
    if args.len() == 0 && !user_declared {
        trait_rows := [MIRTraitDef]{}
        loop definition in ctx.program.traits {
            if definition.key == name.name || definition.name == name.name -> &trait_rows.push(definition)
        }
        if trait_rows.len() == 1 -> return Val("Box<dyn {jet_rust_emit_trait_name(&ctx, trait_rows[0].id)}>")
    }
    if name.name == "DataStream" && args.len() > 0 -> return Val("{root}jet_std::DataStream")
    if jet_rust_emit_core_rust_type_name(name.name) == .Val(core_name) {
        if core_name == "JetRowPolicy" || core_name == "JetTaskFailure" -> return Val(jet_rust_emit_root_prelude_type(&ctx, core_name, args))
        if jet_rust_emit_root_prelude_type_name(core_name) == .Val(root_name) -> return Val(jet_rust_emit_root_prelude_type(&ctx, root_name, args))
        return Val(jet_rust_emit_root_prelude_type(&ctx, "jet_std::{core_name}", args))
    }
    if name.name == "__JetDmaTransfer" && args.len() == 1 -> return Val("{root}jet_std::JetDmaTransfer<'static, {jet_rust_emit_type(&ctx, args[0])}>")
    if name.name == "StreamEventTime" && args.len() == 1 -> return Val("{root}jet_std::JetStream<{root}jet_std::JetStreamEvent<{jet_rust_emit_type(&ctx, args[0])}>>")
    if name.name == "KeyedStream" && args.len() == 2 -> return Val("{root}jet_std::JetKeyedStream<{jet_rust_emit_type(&ctx, args[0])}, {jet_rust_emit_type(&ctx, args[1])}>")
    if name.name == "Window" && args.len() == 2 -> return Val("{root}jet_std::JetStreamWindow<{jet_rust_emit_type(&ctx, args[0])}, {jet_rust_emit_type(&ctx, args[1])}>")
    if name.name == "Stream" && args.len() == 1 -> return Val("{root}jet_std::JetStream<{jet_rust_emit_type(&ctx, args[0])}>")
    if jet_rust_emit_alloc_handle_type_name(native_name) == .Val(allocator) -> return Val("{root}{allocator}")
    // MIRRust nominal_name: the crypto carriers and any remaining native projection.
    if jet_rust_emit_core_crypto_rust_type_name(name.name) == .Val(crypto) -> return Val("{jet_rust_emit_ffi_crate()}::{crypto}")
    if name.name == "Condition" && !user_declared -> return Val("{root}jet_std::JetCondition")
    if !user_declared {
        layout :: if name.name == {
            "HVar" | "VVar" | "LengthVar" -> Val("jet_layout::LinExpr")
            "Constraint" -> Val("jet_layout::Constraint")
            "Layout" -> Val("jet_layout::Handle")
            else -> String?{None}
        }
        if layout == .Val(rust) -> return Val("{root}{rust}")
    }
    if name.name == "KeyStatus" -> return Val("{jet_rust_emit_ffi_crate()}::JetVaultKeyStatus")
    if name.name == "VaultError" -> return Val("{jet_rust_emit_ffi_crate()}::JetVaultError")
    None
}
