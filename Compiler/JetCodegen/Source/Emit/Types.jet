// Context.rs core_rust_type_name: the `jet_std::` carriers of registered Core owners.
fn jet_rust_emit_core_rust_type_name(raw: String) -> String? {
    if raw.starts_with("<corelib>/Core/sync::") && raw.ends_with("::RowPolicy") -> return None
    name :: jet_rust_emit_core_qualified_leaf(jet_rust_emit_core_source_type_leaf(raw)) ?? return None
    if name == "DataTree" || name == "JSON" || name == "TOML" || name == "YAML" || name == "CSV" -> return Val("DataTree")
    if jet_rust_emit_job_queue_type_name(name) == .Val(queue) -> return Val(queue)
    lanes :: [String]{"F32x4", "F64x2", "F32x8", "F64x4", "I8x16", "I16x8", "I32x4", "I64x2", "U8x16", "U16x8", "U32x4", "U64x2", "I8x32", "I16x16", "I32x8", "I64x4", "U8x32", "U16x16", "U32x8", "U64x4", "Vec2", "Vec3", "Vec4", "Mat3", "Mat4"}
    if lanes.contains(name) -> return Val(~name)
    coords :: [String]{"Point2", "Delta2", "ScreenPoint", "WorldPoint", "ViewPoint", "CameraPoint", "DevicePoint", "ScreenDelta", "WorldDelta", "ViewDelta", "CameraDelta", "DeviceDelta"}
    if coords.contains(name) -> return Val("JetCoord2")
    // Carriers whose Rust name equals the Jet name.
    same :: [String]{"IOError", "IOContext", "IOOperation", "ProcessResourceLimit", "EnvError", "UTF8Error", "ProcessPlan", "ProcessSpec", "ProcessChild", "ProcessStreamMode", "TerminalPolicy", "TerminalSize", "TerminalMode", "TerminalSession", "TextWidth", "TextWidthAmbiguous", "TextWidthControls", "TextError", "DataGroupedQuery", "DataJoin", "TestSuite", "Clock", "RNG", "Fake", "Solver", "Duration", "DurationUnit", "RangeError", "DataLoaderKind", "DataFormat", "DataFreshness", "DataInvalidationCause", "DataAuthority", "DataSourceIdentity", "DataProvenance", "DataSnapshotIdentity", "DataLoaderStatus", "DataLoader", "DataSnapshot", "RegexFlags", "Closed", "DirEntry", "Stat", "WalkEntry", "WatchEvent", "WatchDomain", "WatchKind", "WatchHandle", "WatchSet", "TempDir", "TempFile", "FileLock", "DataLineOptions", "DataColumn", "DataStatus", "DataSummary", "DataLimits", "DataError", "DataErrorKind", "DataPivotCell", "DataStream", "DataTracked", "DataWatch", "DataWatchStatus", "LogField", "LogSpan", "EncodingLimits", "EncodingError", "EncodingCause", "EncodingFormat", "EncodingErrorKind", "FieldError", "CBOROptions", "CBORError", "CBORErrorKind", "XMLLimits", "XMLParseOptions", "XMLRenderOptions", "XMLEncoding", "XMLLexicalPolicy", "XMLCanonical", "XMLCanonicalMode", "XMLError", "XMLReason", "XMLEntityPolicy", "DataEvent", "JSONReader", "JSONWriter", "JSONLReader", "JSONLWriter", "CSVReader", "CSVWriter", "CSVRow", "XMLReader", "XMLWriter", "DBValue", "DBError", "RaylibWindow", "RaylibColor", "RaylibSound", "RaylibTextureAtlas", "SQL", "HTML", "Sh"}
    if same.contains(name) -> return Val(~name)
    if name == {
        "ProcessResult" | "ProcessReceipt" -> Val("ProcessReceipt")
        "Query" -> Val("DataQuery")
        "Group" -> Val("GroupValue")
        "SharedGuard" -> Val("JetSharedGuard")
        "Signal" -> Val("JetSignal")
        "Derived" -> Val("JetDerived")
        "AsyncPolicy" -> Val("JetAsyncPolicy")
        "Event" -> Val("JetEvent")
        "AsyncEvent" -> Val("JetAsyncEvent")
        "Hook" -> Val("JetHook")
        "DecisionHook" -> Val("JetDecisionHook")
        "HookDecision" -> Val("JetHookDecision")
        "HookOutcome" -> Val("JetHookOutcome")
        "Subscription" -> Val("JetSubscription")
        "EventScope" -> Val("JetEventScope")
        "EventPolicy" -> Val("JetEventPolicy")
        "EventTrace" -> Val("JetEventTrace")
        "DispatchReport" -> Val("JetDispatchReport")
        "DispatchFailure" -> Val("JetDispatchFailure")
        "Overflow" -> Val("JetEventOverflow")
        "FailurePolicy" -> Val("JetFailurePolicy")
        "DispatchState" -> Val("JetDispatchState")
        "HookPolicy" -> Val("JetHookPolicy")
        "EventConfigError" -> Val("JetEventConfigError")
        "TestComparison" -> Val("JetTestComparison")
        "LateEventDisposition" -> Val("JetLateEventDisposition")
        "Instant" -> Val("JetInstant")
        "Date" | "LocalDate" -> Val("JetDate")
        "LocalTime" -> Val("JetLocalTime")
        "DateTime" -> Val("JetDateTime")
        "Period" -> Val("JetPeriod")
        "Zone" -> Val("JetZone")
        "ZonedDateTime" -> Val("JetZonedDateTime")
        "URL" -> Val("JetURL")
        "MIME" -> Val("JetMIME")
        "Regex" -> Val("JetRegex")
        "Match" -> Val("JetRegexMatch")
        "Decimal" -> Val("JetDecimal")
        "Fraction" -> Val("JetFraction")
        "Receiver" -> Val("JetReceiver")
        "Sender" -> Val("JetSender")
        "Pool" -> Val("JetPool")
        "ID" -> Val("JetId")
        "TaskFailure" -> Val("JetTaskFailure")
        "FfiCallbackEvent" -> Val("JetFfiCallbackEventValue")
        "FfiCallbackRegistration" -> Val("JetFfiCallbackRegistrationHandle")
        "MappedFile" -> Val("JetMappedFile")
        "RowPolicy" -> Val("JetRowPolicy")
        "Transform" | "Transform2" -> Val("JetTransform2")
        "Ray2" -> Val("JetRay2")
        else -> None
    }
}

