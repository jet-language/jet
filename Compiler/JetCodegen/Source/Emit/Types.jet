// MIR type, declaration, and constant projections. All names are derived from
// canonical MIR identities; no source or Rust AST lookup is performed here.
use jet_foundation.[
    CORE_MODULE_EXPORTS,
    ByteLayout,
    FieldLayoutFacts,
    LayoutFacts,
    MIRAccess,
    MIRCEnumTag,
    MIRCallMetadata,
    MIRCallablePolicy,
    MIRCallablePolicyChain,
    MIRConstKey,
    MIRConstant,
    MIRField,
    MIRForeignID,
    MIRFunction,
    MIRFunctionID,
    MIRFunctionSignature,
    MIRGenericParam,
    MIRHandleLifecycle,
    MIRHandleOwnership,
    MIRImplDef,
    MIRInternalTag,
    MIRNominalRef,
    MIROwnershipMode,
    MIRStructLayout,
    MIRTagMarker,
    MIRTraitDef,
    MIRTraitID,
    MIRTraitRef,
    MIRType,
    MIRTypeDef,
    MIRTypeID,
    MIRTypeKind,
    MIRVariant,
    MIRVariantPayload,
    MIRVisibility,
    mir_measure_expression,
    mir_measure_literal_value,
    mir_trait_id,
    mir_trait_ref,
    mir_type_id,
    mir_type_is_scalar,
    mir_type_layout,
    mir_type_same_checked_type,
    core_enum_variants,
]

fn jet_rust_emit_type_is_borrowed(ty: MIRType) -> Bool Never! {
    if ty.kind == MIRTypeKind.Int -> true else -> !mir_type_is_scalar(ty)
}

fn jet_rust_emit_callable_param_type(ctx: &JetRustEmitContext, ty: MIRType, access: MIRAccess) -> String Never! {
    rendered :: jet_rust_emit_type(&ctx, ty)
    if access == {
        .Write -> "&mut {rendered}"
        .Read -> if jet_rust_emit_type_is_borrowed(ty) -> "&{rendered}" else -> rendered
        .Move -> rendered
    }
}

fn jet_rust_emit_callable_return(ctx: &JetRustEmitContext, function: MIRFunction) -> String Never! {
    jet_rust_emit_type(&ctx, function.return_type)
}

fn jet_rust_emit_is_columnar_type(ctx: &JetRustEmitContext, source: MIRType) -> Bool Never! {
    ty := source
    if ty.identity == .Val(identity) {
        if jet_rust_emit_type_instance(ctx, identity, false) == .Val(instance) -> ty = instance
    }
    if ty.kind == {
        .Apply(name, _) -> ctx.columnar_type_names.get(name.name) != None
        else -> false
    }
}

fn jet_rust_emit_type(ctx: &JetRustEmitContext, source: MIRType) -> String Never! {
    ty := source
    if ty.identity == .Val(identity) {
        if jet_rust_emit_type_instance(ctx, identity, true) == .Val(canonical_ty) -> ty = canonical_ty
    }
    if ty.kind == {
        .Int -> "jet_foundation::Numeric::JetInt"
        .Float -> "f64"
        .Float32 -> "f32"
        .Bool -> "bool"
        .String -> if jet_rust_emit_is_core_layer(&ctx) -> "&'static str" else -> "String"
        .Char -> "char"
        .List(inner) -> if jet_rust_emit_is_columnar_type(&ctx, inner) -> "{ctx.config.root_prefix}JetColumnList<{jet_rust_emit_type(&ctx, inner)}>" else -> "Vec<{jet_rust_emit_type(&ctx, inner)}>"
        .Map(key, value) -> "{ctx.config.root_prefix}JetMap<{jet_rust_emit_type(&ctx, key)}, {jet_rust_emit_type(&ctx, value)}>"
        .Shared(inner) -> "{ctx.config.root_prefix}jet_std::JetShared<{jet_rust_emit_type(&ctx, inner)}>"
        .Option(inner) -> "{ctx.config.root_prefix}JetOutcome<{jet_rust_emit_type(&ctx, inner)}, {ctx.config.root_prefix}JetAbsent>"
        .Result(ok, err) -> "{ctx.config.root_prefix}JetOutcome<{jet_rust_emit_type(&ctx, ok)}, {jet_rust_emit_type(&ctx, err)}>"
        .Fn(signature) -> jet_rust_emit_function_type(&ctx, signature)
        .SendFn(params, ret, conventions) -> jet_rust_emit_send_function_type(&ctx, params, ret, conventions)
        .Apply(name, args) -> jet_rust_emit_apply_type(&ctx, name, args)
        .TraitObject(bounds) -> {
            names :: loop bound in bounds -> jet_rust_emit_trait_name(&ctx, bound.id)
            if names.len() == 0 -> "Box<dyn std::any::Any>" else -> "Box<dyn {names.join(" + ")}>"
        }
        .Tuple(fields) -> {
            names :: loop field in fields -> jet_rust_emit_type(&ctx, field.ty)
            if names.len() == {
                0 -> "()"
                1 -> "({names[0]},)"
                else -> "({names.join(", ")})"
            }
        }
        .FixedList(elem, len) -> "[{jet_rust_emit_type(&ctx, elem)}; {mir_measure_expression(len)}]"
        .IntN(signed, bits) -> "{if signed -> "i" else -> "u"}{bits}"
        .InlineRange(base, _, _) -> jet_rust_emit_type(&ctx, base)
        .Tagged(marker, inner) -> {
            if marker == (MIRTagMarker.Internal{internal_tag: MIRInternalTag.AllocatorView}) -> "&mut {jet_rust_emit_type(&ctx, inner)}" else -> jet_rust_emit_type(&ctx, inner)
        }
        .Union(_) -> {
            identity :: ty.identity ?? {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingIdentity, "E0003", "MIR union has no canonical identity", "lowering must register every structural union instance before source emission", None)
                MIRTypeID{value: 0}
            }
            jet_rust_emit_type_name(&ctx, identity)
        }
        .Quantity(base, _) -> jet_rust_emit_type(&ctx, base)
        .Measure(_) -> "f64"
    }
}

fn jet_rust_emit_c_abi_tag_type(enum_tag: MIRCEnumTag) -> String Never! {
    if enum_tag == {
        .CInt -> "core::ffi::c_int"
        .U8 -> "u8"
        .I8 -> "i8"
        .U16 -> "u16"
        .I16 -> "i16"
        .U32 -> "u32"
        .I32 -> "i32"
        .U64 -> "u64"
        .I64 -> "i64"
    }
}

fn jet_rust_emit_c_abi_tag_size(enum_tag: MIRCEnumTag) -> Int Never! {
    if enum_tag == {
        .CInt | .U32 | .I32 -> 4
        .U8 | .I8 -> 1
        .U16 | .I16 -> 2
        .U64 | .I64 -> 8
    }
}

fn jet_rust_emit_c_abi_tag_accepts(enum_tag: MIRCEnumTag, value: Int) -> Bool Never! {
    if enum_tag == {
        .CInt | .I32 -> value >= -2147483648 && value <= 2147483647
        .U8 -> value >= 0 && value <= 255
        .I8 -> value >= -128 && value <= 127
        .U16 -> value >= 0 && value <= 65535
        .I16 -> value >= -32768 && value <= 32767
        .U32 -> value >= 0 && value <= 4294967295
        .U64 | .I64 -> true
    }
}

fn jet_rust_emit_c_abi_discriminant(variants: [MIRVariant], index: Int) -> Int? {
    next := 0
    current := 0
    loop variant in variants {
        value :: variant.discriminant ?? next
        if current == index -> return Val(value)
        if value == 9223372036854775807 && current + 1 < variants.len() -> return None
        next = value + 1
        current += 1
    }
    None
}

fn jet_rust_emit_c_abi_unit_enum(variants: [MIRVariant]) -> Bool Never! {
    loop variant in variants {
        if variant.payload != MIRVariantPayload.Unit -> return false
    }
    true
}

fn jet_rust_emit_c_abi_nominal_name(definition: MIRTypeDef, kind: String) -> String Never! {
    jet_rust_emit_generated_path("__jet_c_abi_{kind}::{definition.key}")
}

// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::c_abi_record_def
fn jet_rust_emit_c_abi_record_definition(ctx: &JetRustEmitContext, ty: MIRType) -> MIRTypeDef? {
    if ty.kind == {
        .Apply(name, args) -> {
            if name.name == "Ptr" || args.len() != 0 -> return None
            if jet_rust_emit_type_index(ctx, name.id) == .Val(definition_index) {
                if ctx.program.types[definition_index].id == name.id {
                    if ctx.program.types[definition_index].generic_params.len() != 0 || ctx.program.types[definition_index].layout == None -> return None
                    layout :: ctx.program.types[definition_index].layout ?? return None
                    if layout == {
                        .C | .CAligned(_, _) -> {}
                        .Columnar -> return None
                    }
                    if ctx.program.types[definition_index].kind == {
                        .Struct(fields, _) -> {
                            physical_field := false
                            loop field in fields { if !field.computed -> physical_field = true }
                            if physical_field -> return Val(ctx.program.types[definition_index])
                        }
                        else -> {}
                    }
                    return None
                }
            }
        }
        else -> {}
    }
    None
}

// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::c_abi_enum_def
fn jet_rust_emit_c_abi_enum_definition(ctx: &JetRustEmitContext, ty: MIRType) -> MIRTypeDef? {
    if ty.kind == {
        .Apply(name, args) -> {
            if args.len() != 0 -> return None
            if jet_rust_emit_type_index(ctx, name.id) == .Val(definition_index) {
                if ctx.program.types[definition_index].generic_params.len() != 0 || ctx.program.types[definition_index].c_layout_tag == None || ctx.program.types[definition_index].enum_layout == None -> return None
                if ctx.program.types[definition_index].layout == None -> return None
                layout :: ctx.program.types[definition_index].layout ?? return None
                if layout != MIRStructLayout.C -> return None
                if ctx.program.types[definition_index].kind == {
                    .Enum(variants, _) -> {
                        if variants.len() == 0 -> return None
                        enum_tag :: ctx.program.types[definition_index].c_layout_tag ?? return None
                        facts :: ctx.program.types[definition_index].enum_layout ?? return None
                        if facts.bytes == None || facts.fields.len() != variants.len() -> return None
                        bytes :: facts.bytes ?? ByteLayout{size: 0, alignment: 0, stride: 0}
                        if bytes.size <= 0 || bytes.alignment <= 0 || bytes.stride != bytes.size -> return None
                        if (bytes.alignment & (bytes.alignment - 1)) != 0 || bytes.size < jet_rust_emit_c_abi_tag_size(enum_tag) -> return None
                        payload_offset := -1
                        seen_discriminants := [Int]{}
                        index := 0
                        loop variant in variants {
                            value :: jet_rust_emit_c_abi_discriminant(variants, index) ?? return None
                            if !jet_rust_emit_c_abi_tag_accepts(enum_tag, value) || seen_discriminants.contains(value) -> return None
                            &seen_discriminants.push(value)
                            field := facts.fields[index]
                            if field.name != variant.name || field.offset == None || field.size == None || field.alignment == None || field.stride == None -> return None
                            offset :: field.offset ?? 0
                            size :: field.size ?? 0
                            alignment :: field.alignment ?? 0
                            stride :: field.stride ?? 0
                            if size <= 0 || size > bytes.size || alignment <= 0 || stride != size || (alignment & (alignment - 1)) != 0 || offset < 0 || offset > bytes.size - size -> return None
                            if variant.payload == {
                                .Unit -> {
                                    if offset != 0 || size != jet_rust_emit_c_abi_tag_size(enum_tag) || alignment != jet_rust_emit_c_abi_tag_size(enum_tag) -> return None
                                }
                                .Single(_) | .Named(_) -> {
                                    if offset < jet_rust_emit_c_abi_tag_size(enum_tag) || offset % alignment != 0 -> return None
                                    if {
                                        payload_offset < 0 -> payload_offset = offset
                                        payload_offset != offset -> return None
                                        else -> {}
                                    }
                                }
                            }
                            index += 1
                        }
                        if {
                            payload_offset < 0 -> {
                                if bytes.size != jet_rust_emit_c_abi_tag_size(enum_tag) -> return None
                            }
                            bytes.size <= payload_offset -> return None
                            else -> {}
                        }
                        return Val(ctx.program.types[definition_index])
                    }
                    else -> return None
                }
            }
        }
        else -> {}
    }
    None
}

fn jet_rust_emit_c_abi_unit_enum_definition(definition: MIRTypeDef) -> Bool Never! {
    if definition.kind == {
        .Enum(variants, _) -> return jet_rust_emit_c_abi_unit_enum(variants)
        else -> return false
    }
}

fn jet_rust_emit_c_abi_scalar_type(ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .Int | .Float | .Float32 | .Bool | .Char | .String | .IntN(_, _) -> return true
        .Tagged(marker, inner) -> {
            if marker == (MIRTagMarker.Internal{internal_tag: MIRInternalTag.AllocatorView}) -> return false
            return jet_rust_emit_c_abi_scalar_type(inner)
        }
        .InlineRange(base, _, _) | .Quantity(base, _) -> return jet_rust_emit_c_abi_scalar_type(base)
        .Apply(name, args) -> return name.name == "Ptr" && args.len() == 1
        else -> return false
    }
}

fn jet_rust_emit_c_abi_type_supported(ctx: &JetRustEmitContext, ty: MIRType, visited: &[MIRTypeID]) -> Bool Never! {
    if ty.kind == {
        .IntN(_, bits) -> return bits == 8 || bits == 16 || bits == 32 || bits == 64
        else -> {}
    }
    if jet_rust_emit_c_abi_scalar_type(ty) -> return true
    if ty.kind == {
        .FixedList(element, length) -> {
            count :: mir_measure_literal_value(length) ?? return false
            if count < 0 -> return false
            return jet_rust_emit_c_abi_type_supported(&ctx, element, &visited)
        }
        .Apply(name, args) -> {
            if name.name == "Unit" && args.len() == 0 -> return true
            if name.name == "Ptr" && args.len() == 1 -> return true
            definition := jet_rust_emit_c_abi_record_definition(&ctx, ty)
            if definition == None -> definition = jet_rust_emit_c_abi_enum_definition(&ctx, ty)
            if definition == None -> return false
            row :: definition ?? return false
            if visited.contains(row.id) -> return false
            &visited.push(row.id)
            supported := true
            if row.kind == {
                .Struct(fields, _) -> {
                    loop field in fields {
                        if !field.computed && !jet_rust_emit_c_abi_type_supported(&ctx, field.ty, &visited) {
                            supported = false
                            break
                        }
                    }
                }
                .Enum(variants, _) -> {
                    loop variant in variants {
                        if variant.payload == {
                            .Single(value) -> {
                                if !jet_rust_emit_c_abi_type_supported(&ctx, value, &visited) -> supported = false
                            }
                            .Named(fields) -> {
                                loop field in fields {
                                    if !field.computed && !jet_rust_emit_c_abi_type_supported(&ctx, field.ty, &visited) {
                                        supported = false
                                        break
                                    }
                                }
                            }
                            .Unit -> {}
                        }
                        if !supported -> break
                    }
                }
                else -> supported = false
            }
            _ := &visited.pop()
            supported
        }
        else -> false
    }
}

fn jet_rust_emit_c_abi_type(ctx: &JetRustEmitContext, source: MIRType) -> String Never! {
    ty := source
    if source.identity == .Val(identity) {
        if jet_rust_emit_type_instance(ctx, identity, false) == .Val(instance) -> ty = instance
    }
    if ty.kind == {
        .Int -> "i64"
        .Float -> "f64"
        .Float32 -> "f32"
        .Bool -> "bool"
        .Char -> "u32"
        .String -> "*const core::ffi::c_char"
        .IntN(signed, bits) -> "{if signed -> "i" else -> "u"}{bits}"
        .InlineRange(base, _, _) | .Quantity(base, _) -> jet_rust_emit_c_abi_type(&ctx, base)
        .Tagged(marker, inner) -> {
            if marker == (MIRTagMarker.Internal{internal_tag: MIRInternalTag.AllocatorView}) {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.UnsupportedForeign, "E0003", "allocator views cannot cross a direct C ABI", "C physical values must not expose Jet-managed allocator borrows", None)
                return "*mut ()"
            }
            jet_rust_emit_c_abi_type(&ctx, inner)
        }
        .FixedList(element, length) -> "[{jet_rust_emit_c_abi_type(&ctx, element)}; {mir_measure_expression(length)}]"
        .Apply(name, args) -> {
            if name.name == "Unit" && args.len() == 0 -> return "()"
            if name.name == "Ptr" && args.len() == 1 -> return jet_rust_emit_type(&ctx, ty)
            definition := jet_rust_emit_c_abi_record_definition(&ctx, ty)
            if definition == None -> definition = jet_rust_emit_c_abi_enum_definition(&ctx, ty)
            if definition == None {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.UnsupportedForeign, "E0003", "direct C nominal type lacks checked physical layout facts", "C by-value records and enums require checked non-generic repr(C) declarations and complete enum layout facts", None)
                return "()"
            }
            row :: definition ?? return "()"
            if row.kind == {
                .Enum(variants, _) -> {
                    if jet_rust_emit_c_abi_unit_enum(variants) {
                        enum_tag :: row.c_layout_tag ?? MIRCEnumTag.CInt
                        return jet_rust_emit_c_abi_tag_type(enum_tag)
                    }
                    jet_rust_emit_c_abi_nominal_name(row, "enum")
                }
                .Struct(_, _) -> jet_rust_emit_c_abi_nominal_name(row, "record")
                else -> "()"
            }
        }
        else -> {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.UnsupportedForeign, "E0003", "direct C ABI type has no checked physical mapping", "only checked C scalars, fixed arrays, repr(C) records, and tagged C enums can cross this boundary", None)
            "()"
        }
    }
}

// MIRRust c_abi_enum_variant_name: the variant's `mangle_variant` spelling, so
// grouped `Net.Ping` and flat `Net_Ping` name distinct payload carriers.
fn jet_rust_emit_c_abi_payload_type_name(definition: MIRTypeDef, variant: MIRVariant) -> String Never! {
    "{jet_rust_emit_c_abi_nominal_name(definition, "enum")}_payload_{jet_rust_emit_mangle_variant(variant.name)}"
}

// The union member keeps the `__jet_variant` prefix so no variant spelling
// meets the `__jet_empty` unit member.
fn jet_rust_emit_c_abi_payload_field_name(variant: MIRVariant) -> String Never! {
    "__jet_variant{jet_rust_emit_mangle_variant(variant.name)}"
}

fn jet_rust_emit_c_abi_type_definition(ctx: &JetRustEmitContext, definition: MIRTypeDef, lines: &[String]) Never! {
    if definition.kind == {
        .Struct(fields, _) -> {
            layout :: definition.layout ?? return
            if layout == .Columnar -> return
            record_type :: MIRType{kind: MIRTypeKind.Apply{name: MIRNominalRef{id: definition.id, name: definition.key}, args: [MIRType]{}}, identity: Val(definition.id), layout: mir_type_layout(MIRTypeKind.Apply{name: MIRNominalRef{id: definition.id, name: definition.key}, args: [MIRType]{}})}
            visited := [MIRTypeID]{}
            if !jet_rust_emit_c_abi_type_supported(&ctx, record_type, &visited) {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.UnsupportedForeign, "E0003", "C ABI record has a field with no checked physical representation", "every stored field of a `#layout(C)` record must be a C scalar, fixed array, pointer, C record, or tagged C enum", Val(definition.span))
                return
            }
            jet_rust_emit_layout_attributes(&ctx, definition, &lines)
            &lines.push("#[derive(Clone, Copy)]")
            name := jet_rust_emit_c_abi_nominal_name(definition, "record")
            &lines.push("struct {name} {{")
            loop field in fields {
                if !field.computed {
                    field_name := jet_rust_emit_field_name(&ctx, field.id)
                    &lines.push("    {field_name}: {jet_rust_emit_c_abi_type(&ctx, field.ty)},")
                }
            }
            &lines.push("}}")
        }
        .Enum(variants, _) -> {
            // MIRRust emit_c_abi_enums: only an enum with a checked C tag is a
            // C ABI row; a payload-free one needs no union carrier.
            enum_tag :: definition.c_layout_tag ?? return
            if jet_rust_emit_c_abi_unit_enum(variants) -> return
            enum_type :: MIRType{kind: MIRTypeKind.Apply{name: MIRNominalRef{id: definition.id, name: definition.key}, args: [MIRType]{}}, identity: Val(definition.id), layout: mir_type_layout(MIRTypeKind.Apply{name: MIRNominalRef{id: definition.id, name: definition.key}, args: [MIRType]{}})}
            visited := [MIRTypeID]{}
            if !jet_rust_emit_c_abi_type_supported(&ctx, enum_type, &visited) {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.UnsupportedForeign, "E0003", "C ABI enum has a payload with no checked physical representation", "every payload of a tagged C enum must be a C scalar, fixed array, pointer, C record, or tagged C enum", Val(definition.span))
                return
            }
            name := jet_rust_emit_c_abi_nominal_name(definition, "enum")
            union_name :: "{name}_payload"
            loop variant in variants {
                if variant.payload == {
                    .Named(fields) -> {
                        payload_name :: jet_rust_emit_c_abi_payload_type_name(definition, variant)
                        &lines.push("#[repr(C)]")
                        &lines.push("#[derive(Clone, Copy)]")
                        &lines.push("struct {payload_name} {{")
                        loop field in fields {
                            if !field.computed {
                                field_name := jet_rust_emit_field_name(&ctx, field.id)
                                &lines.push("    {field_name}: {jet_rust_emit_c_abi_type(&ctx, field.ty)},")
                            }
                        }
                        &lines.push("}}")
                    }
                    else -> {}
                }
            }
            &lines.push("#[repr(C)]")
            &lines.push("#[derive(Clone, Copy)]")
            &lines.push("union {union_name} {{")
            &lines.push("    __jet_empty: (),")
            loop variant in variants {
                field_name := jet_rust_emit_c_abi_payload_field_name(variant)
                if variant.payload == {
                    .Single(value) -> &lines.push("    {field_name}: {jet_rust_emit_c_abi_type(&ctx, value)},")
                    .Named(_) -> &lines.push("    {field_name}: {jet_rust_emit_c_abi_payload_type_name(definition, variant)},")
                    .Unit -> {}
                }
            }
            &lines.push("}}")
            &lines.push("#[repr(C)]")
            &lines.push("#[derive(Clone, Copy)]")
            &lines.push("struct {name} {{")
            &lines.push("    tag: {jet_rust_emit_c_abi_tag_type(enum_tag)},")
            &lines.push("    payload: {union_name},")
            &lines.push("}}")
            facts :: definition.enum_layout ?? LayoutFacts{bytes: None, fields: [FieldLayoutFacts]{}}
            bytes :: facts.bytes ?? ByteLayout{size: 0, alignment: 0, stride: 0}
            &lines.push("const _: [(); {bytes.size}usize] = [(); core::mem::size_of::<{name}>()];")
            &lines.push("const _: [(); {bytes.alignment}usize] = [(); core::mem::align_of::<{name}>()];")
        }
        else -> {}
    }
}

fn jet_rust_emit_c_abi_type_definitions(ctx: &JetRustEmitContext, lines: &[String]) Never! {
    loop definition in ctx.program.types {
        if !jet_rust_emit_module_selected(ctx, definition.module_id) -> next
        start :: lines.len()
        jet_rust_emit_c_abi_type_definition(&ctx, definition, &lines)
        if lines.len() > start -> &lines.push("")
    }
}

fn jet_rust_emit_callable_type_parts(ctx: &JetRustEmitContext, params: [MIRType], conventions: [MIRAccess], ret: MIRType?) -> String Never! {
    rendered := [String]{}
    index := 0
    loop param in params {
        access := MIRAccess.Read
        if index < conventions.len() -> access = conventions[index]
        &rendered.push(jet_rust_emit_callable_param_type(&ctx, param, access))
        index += 1
    }
    result := "()"
    if ret == .Val(ret_ty) -> result = jet_rust_emit_type(&ctx, ret_ty)
    "std::rc::Rc<std::cell::RefCell<Option<Box<dyn FnMut({rendered.join(", ")}) -> {result}>>>>"
}

fn jet_rust_emit_function_type(ctx: &JetRustEmitContext, signature: MIRFunctionSignature) -> String Never! {
    conventions := [MIRAccess]{}
    if signature.call_metadata != None -> conventions = (signature.call_metadata ?? MIRCallMetadata{names: [String]{}, defaults: [Bool]{}, variadic: [Bool]{}, conventions: [MIRAccess]{}, policies: MIRCallablePolicyChain{policies: [MIRCallablePolicy]{}}}).conventions
    jet_rust_emit_callable_type_parts(&ctx, signature.params, conventions, signature.ret)
}

fn jet_rust_emit_send_function_type(ctx: &JetRustEmitContext, params: [MIRType], ret: MIRType?, conventions: [MIRAccess]) -> String Never! {
    rendered := [String]{}
    index := 0
    loop param in params {
        access := MIRAccess.Read
        if index < conventions.len() -> access = conventions[index]
        &rendered.push(jet_rust_emit_callable_param_type(&ctx, param, access))
        index += 1
    }
    result := "()"
    if ret == .Val(ret_ty) -> result = jet_rust_emit_type(&ctx, ret_ty)
    "std::sync::Arc<dyn Fn({rendered.join(", ")}) -> {result} + Send + Sync + 'static>"
}

// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::generic_params_for_type
fn jet_rust_emit_type_application_generic_params(ctx: &JetRustEmitContext, source: MIRType) -> [MIRGenericParam] Never! {
    if source.kind == {
        .Apply(name, args) -> {
            if jet_rust_emit_type_index(ctx, name.id) == .Val(definition_index) {
                if ctx.program.types[definition_index].id == name.id {
                    if ctx.program.types[definition_index].generic_params.len() != args.len() -> return [MIRGenericParam]{}
                    parameters := [MIRGenericParam]{}
                    index := 0
                    loop index < args.len() {
                        if args[index].kind == {
                            .Apply(argument_name, argument_args) -> {
                                if argument_args.len() == 0 && !argument_name.name.contains("::") {
                                    declared := ctx.program.types[definition_index].generic_params[index]
                                    parameters = jet_rust_emit_merge_generic_params(parameters, [MIRGenericParam]{MIRGenericParam{name: argument_name.name, bounds: declared.bounds}})
                                }
                            }
                            else -> {}
                        }
                        index += 1
                    }
                    return parameters
                }
            }
        }
        else -> {}
    }
    [MIRGenericParam]{}
}

fn jet_rust_emit_function_owner_generic_params(ctx: &JetRustEmitContext, function: MIRFunction) -> [MIRGenericParam] Never! {
    owner := if function.form == {
        .Method(ty, _) -> Val(ty)
        .TraitMethod(ty, _, _, _) -> Val(ty)
        else -> MIRType?{None}
    }
    if owner == None -> return [MIRGenericParam]{}
    jet_rust_emit_type_application_generic_params(&ctx, owner ?? function.return_type)
}

fn jet_rust_emit_current_generic_parameter(ctx: &JetRustEmitContext, name: MIRNominalRef) -> Bool Never! {
    loop parameter in ctx.current_generic_params {
        if parameter.name == name.name && name.id == mir_type_id(parameter.name) -> return true
    }
    false
}

fn jet_rust_emit_apply_type(ctx: &JetRustEmitContext, name: MIRNominalRef, args: [MIRType]) -> String Never! {
    if args.len() == 0 && jet_rust_emit_current_generic_parameter(&ctx, name) -> return jet_rust_emit_mangle(name.name)
    if args.len() == 0 && name.name == "Unit" -> return "()"
    if args.len() == 0 && name.name == "Never" -> return "std::convert::Infallible"
    if args.len() == 0 && name.name == "Stm" -> return "{ctx.config.root_prefix}JetSharedTransaction"
    if args.len() == 0 && name.name == "Transaction" -> return "JetTransaction"
    // MIRRust rust_type: ScopeGuard is an inference-only carrier, and the loop
    // cursors are Prelude carriers with no MIR declaration row.
    if name.name == "ScopeGuard" -> return "_"
    if name.name == "RangeCursor" -> return "JetLoopRangeCursor"
    if name.name == "IterCursor" -> return "JetLoopIterCursor"
    if name.name == "ByteIterCursor" -> return "JetByteLoopIterCursor<'_>"
    if name.name == "Ptr" {
        if args.len() != 1 {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR Ptr type has the wrong arity", "checked Ptr values always carry one element type", None)
            return "*mut ()"
        }
        return "*mut {jet_rust_emit_type(&ctx, args[0])}"
    }
    if name.name == "View" && args.len() == 1 {
        inner := args[0]
        if inner.kind == {
            .Apply(inner_name, inner_args) -> {
                if inner_args.len() == 0 && inner_name.name == "str" -> return "&str"
            }
            else -> {}
        }
        return "&[{jet_rust_emit_type(&ctx, inner)}]"
    }
    if name.name == "ViewMut" && args.len() == 1 -> return "&mut [{jet_rust_emit_type(&ctx, args[0])}]"
    if name.name == "Set" && args.len() == 1 -> return "std::collections::HashSet<{jet_rust_emit_type(&ctx, args[0])}>"
    if name.name == "Rank" && args.len() == 1 -> return "std::collections::BTreeSet<{jet_rust_emit_type(&ctx, args[0])}>"
    if name.name == "PriorityQueue" && args.len() == 1 -> return "std::collections::BinaryHeap<{jet_rust_emit_type(&ctx, args[0])}>"
    if name.name == "Atomic" && args.len() == 1 {
        inner :: if args[0].kind == MIRTypeKind.Int -> "JetAtomicInt" else -> jet_rust_emit_type(&ctx, args[0])
        return "{ctx.config.root_prefix}JetAtomic<{inner}>"
    }
    if name.name == "Task" && args.len() == 1 -> return "{ctx.config.root_prefix}jet_std::JetTask<{jet_rust_emit_type(&ctx, args[0])}>"
    if name.name == "Stream" && args.len() == 1 -> return "{ctx.config.root_prefix}jet_std::JetStream<{jet_rust_emit_type(&ctx, args[0])}>"
    if jet_rust_emit_native_apply_type(&ctx, name, args) == .Val(native) -> return native
    head := ctx.type_by_name.get(name.name) ?? ""
    if head == "" {
        if {
            name.name.starts_with("<corelib>/") -> {
            head = "{ctx.config.root_prefix}jet_std::{jet_rust_emit_sanitize(name.name)}"
            }
            else -> {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR nominal type is missing from the emitter registry", "checked Apply types must resolve to a declared or canonical runtime type", None)
            head = jet_rust_emit_generated_path(name.name)
            }
        }
    }
    if args.len() == 0 -> return head
    rendered := [String]{}
    loop arg in args -> &rendered.push(jet_rust_emit_type(&ctx, arg))
    "{head}<{rendered.join(", ")}>"
}

fn jet_rust_emit_type_has_inline_nominal_word(ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .Apply(_, args) -> {
            scalar_word :: if ty.layout.abi == {
                .Scalar(_) -> if ty.layout.size == .Static(size) -> size == 8 else -> false
                else -> false
            }
            if scalar_word -> return true
            loop arg in args { if jet_rust_emit_type_has_inline_nominal_word(arg) -> return true }
            false
        }
        .List(inner) | .Shared(inner) | .Option(inner) | .FixedList(inner, _) | .InlineRange(inner, _, _) | .Tagged(_, inner) | .Quantity(inner, _) -> jet_rust_emit_type_has_inline_nominal_word(inner)
        .Map(key, value) | .Result(key, value) -> jet_rust_emit_type_has_inline_nominal_word(key) || jet_rust_emit_type_has_inline_nominal_word(value)
        .Fn(signature) -> {
            loop param in signature.params { if jet_rust_emit_type_has_inline_nominal_word(param) -> return true }
            if signature.ret == .Val(ret) {
                if jet_rust_emit_type_has_inline_nominal_word(ret) -> return true
            }
            false
        }
        .SendFn(params, ret, _) -> {
            loop param in params { if jet_rust_emit_type_has_inline_nominal_word(param) -> return true }
            if ret == .Val(value) {
                if jet_rust_emit_type_has_inline_nominal_word(value) -> return true
            }
            false
        }
        .Tuple(fields) -> {
            loop field in fields { if jet_rust_emit_type_has_inline_nominal_word(field.ty) -> return true }
            false
        }
        .Union(members) -> {
            loop member in members { if jet_rust_emit_type_has_inline_nominal_word(member) -> return true }
            false
        }
        else -> false
    }
}

fn jet_rust_emit_type_derives_allowed(definition: MIRTypeDef) -> Bool Never! {
    if definition.kind == {
        .Struct(fields, _) -> {
            loop field in fields {
                if !field.computed && jet_rust_emit_type_has_inline_nominal_word(field.ty) -> return false
            }
            true
        }
        .Enum(variants, _) -> {
            loop variant in variants {
                if variant.payload == {
                    .Single(ty) -> if jet_rust_emit_type_has_inline_nominal_word(ty) -> return false
                    .Named(fields) -> {
                        loop field in fields { if jet_rust_emit_type_has_inline_nominal_word(field.ty) -> return false }
                    }
                    .Unit -> {}
                }
            }
            true
        }
        .Distinct(base, _) | .Alias(base) -> !jet_rust_emit_type_has_inline_nominal_word(base)
        .UnitFamily(_) -> true
    }
}

// The first type row matching the identity, nominal id, key or leaf name; the
// context indexes hold each criterion's first row, so the minimum is that row.
fn jet_rust_emit_structural_type_row(ctx: JetRustEmitContext, ty: MIRType) -> Int? {
    if ty.kind == {
        .Apply(name, _) -> {
            identity :: ty.identity ?? name.id
            candidates :: [Int?]{
                ctx.type_index_by_id.get(jet_rust_emit_id_key(identity.value)),
                ctx.type_index_by_id.get(jet_rust_emit_id_key(name.id.value)),
                ctx.type_index_by_key.get(name.name),
                ctx.type_index_by_name.get(name.name),
            }
            best := -1
            loop candidate in candidates {
                if candidate == .Val(index) {
                    if best < 0 || index < best -> best = index
                }
            }
            if best >= 0 -> return Val(best)
        }
        else -> {}
    }
    None
}

fn jet_rust_emit_structural_type_def(ctx: &JetRustEmitContext, ty: MIRType) -> MIRTypeDef? {
    row :: jet_rust_emit_structural_type_row(ctx, ty) ?? return None
    Val(~ctx.program.types[row])
}

fn jet_rust_emit_native_rust_derive_name_for_id(id: MIRTraitID) -> String? {
    if {
        id == mir_trait_id("Clone") -> Val("Clone")
        id == mir_trait_id("Copy") -> Val("Copy")
        id == mir_trait_id("Debug") -> Val("Debug")
        id == mir_trait_id("Default") -> Val("Default")
        id == mir_trait_id("Eq") -> Val("Eq")
        id == mir_trait_id("Hash") -> Val("Hash")
        id == mir_trait_id("Ord") -> Val("Ord")
        id == mir_trait_id("PartialEq") -> Val("PartialEq")
        id == mir_trait_id("PartialOrd") -> Val("PartialOrd")
        else -> None
    }
}

fn jet_rust_emit_is_native_rust_derive_name(name: String) -> Bool Never! {
    name == "Clone" || name == "Copy" || name == "Debug" || name == "Default" || name == "Eq" || name == "Hash" || name == "Ord" || name == "PartialEq" || name == "PartialOrd"
}

// The native-derive check is `jet_rust_emit_is_native_rust_derive_name`: each
// of those names' trait ID maps back to it, and no other name's ID does.
fn jet_rust_emit_capability_trait_ref(ctx: &JetRustEmitContext, trait_name: String) -> MIRTraitRef? {
    if !jet_rust_emit_is_native_rust_derive_name(trait_name) -> return None
    expected_id :: mir_trait_id(trait_name)
    index :: jet_rust_emit_trait_index(ctx, expected_id) ?? return Val(mir_trait_ref(trait_name))
    if ctx.program.traits[index].id != expected_id -> return Val(mir_trait_ref(trait_name))
    if ctx.program.traits[index].name != trait_name || ctx.program.traits[index].key == "" {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR capability trait row disagrees with its canonical identity", "native capability lookup selects the exact raw trait ID and uses the checked canonical row key", None)
        return None
    }
    Val(MIRTraitRef{id: expected_id, name: ctx.program.traits[index].key})
}

fn jet_rust_emit_selected_user_capability_impl(ctx: &JetRustEmitContext, ty: MIRType, trait_name: String) -> Bool Never! {
    target_id := if ty.kind == {
        .Apply(name, _) -> Val(name.id)
        else -> MIRTypeID?{None}
    }
    nominal_id :: target_id ?? return false
    expected_trait_ref :: jet_rust_emit_capability_trait_ref(&ctx, trait_name) ?? return false
    rows :: ~(ctx.impls_by_trait.get(jet_rust_emit_id_key(expected_trait_ref.id.value)) ?? [Int]{})
    // Rows are read in place; only a matching row is copied for the target check.
    loop row in rows {
        if ctx.program.impls[row].compiler_generated -> next
        trait_ref :: ctx.program.impls[row].trait_ref ?? next
        if trait_ref.id != expected_trait_ref.id -> next
        if trait_ref.name != expected_trait_ref.name {
            span :: ~ctx.program.impls[row].span
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR capability trait name disagrees with its identity", "capability impl selection uses the exact trait ID; names are consistency data only", Val(span))
            return false
        }
        if !jet_rust_emit_module_selected(ctx, ctx.program.impls[row].module_id) -> next
        matches := mir_type_same_checked_type(ctx.program.impls[row].self_type, ty)
        if !matches {
            if ctx.program.impls[row].self_type.kind == {
                .Apply(name, _) -> matches = name.id == nominal_id
                else -> {}
            }
        }
        if matches {
            implementation :: ~ctx.program.impls[row]
            if jet_rust_emit_impl_target_enabled(&ctx, implementation) -> return true
        }
    }
    false
}

// MIRRust derives_trait: the row derives a trait whose declaration has this name.
fn jet_rust_emit_type_def_derives_trait(ctx: JetRustEmitContext, definition: MIRTypeDef, trait_name: String) -> Bool Never! {
    loop trait_id in definition.derives {
        index :: jet_rust_emit_trait_index(ctx, trait_id) ?? next
        if ctx.program.traits[index].id == trait_id && ctx.program.traits[index].name == trait_name -> return true
    }
    false
}

// MIRRust selected_user_capability_impl for a trait selected by name (the
// user impls keyed by `trait_ref.name`): a selected non-generated impl of
// `trait_name` whose self type is `ty` or shares its nominal name. Rows are
// read in place; only a matching row is copied for the target check.
fn jet_rust_emit_selected_user_impl_named(ctx: &JetRustEmitContext, ty: MIRType, trait_name: String) -> Bool Never! {
    nominal :: if ty.kind == {
        .Apply(name, _) -> Val(name.name)
        else -> String?{None}
    }
    rows :: ~(ctx.impls_by_trait_name.get(trait_name) ?? [Int]{})
    loop row in rows {
        if ctx.program.impls[row].compiler_generated || !jet_rust_emit_module_selected(ctx, ctx.program.impls[row].module_id) -> next
        matches := mir_type_same_checked_type(ctx.program.impls[row].self_type, ty)
        if !matches && nominal == .Val(name) {
            if ctx.program.impls[row].self_type.kind == {
                .Apply(self_name, _) -> matches = self_name.name == name
                else -> {}
            }
        }
        if matches {
            implementation :: ~ctx.program.impls[row]
            if jet_rust_emit_impl_target_enabled(&ctx, implementation) -> return true
        }
    }
    false
}

fn jet_rust_emit_type_derive_capability(ctx: &JetRustEmitContext, source: MIRType, trait_name: String, visiting: &[MIRTypeID], bindings: [String:MIRType], generic_params: [String]) -> Bool Never! {
    if source.kind == {
        .Apply(name, args) -> {
            if args.len() == 0 {
                bound :: bindings.get(name.name)
                if bound == .Val(candidate) {
                    is_generic :: if candidate.kind == {
                        .Apply(bound_name, bound_args) -> bound_args.len() == 0 && generic_params.contains(bound_name.name)
                        else -> false
                    }
                    if is_generic -> return true
                    return jet_rust_emit_type_derive_capability(&ctx, candidate, trait_name, &visiting, bindings, generic_params)
                }
                if generic_params.contains(name.name) -> return true
            }
        }
        else -> {}
    }
    ty := source
    if source.identity == .Val(identity) {
        if jet_rust_emit_type_instance(ctx, identity, false) == .Val(instance) -> ty = instance
    }
    if ty.kind == {
        .Int | .Bool | .String | .Char | .IntN(_, _) -> true
        // A Rust float is only partially ordered (sema never derives
        // Comparable over one), so it never derives `Ord`.
        .Float | .Float32 | .Measure(_) -> trait_name != "Ord"
        .Shared(_) | .Fn(_) | .SendFn(_, _, _) -> trait_name == "Clone"
        // Only Clone, through the clone-box supertrait every trait used as a
        // single-bound object gets (jet_rust_emit_trait_definition).
        .TraitObject(bounds) -> trait_name == "Clone" && bounds.len() == 1 && ctx.dyn_clone_traits.get(jet_rust_emit_id_key(bounds[0].id.value)) != None
        .List(inner) | .Option(inner) | .FixedList(inner, _) | .InlineRange(inner, _, _) | .Quantity(inner, _) -> jet_rust_emit_type_derive_capability(&ctx, inner, trait_name, &visiting, bindings, generic_params)
        .Tagged(marker, inner) -> {
            if marker == (MIRTagMarker.Internal{internal_tag: MIRInternalTag.CppCallbackABI}) -> return trait_name != "JetShow" && trait_name != "JetDebug"
            jet_rust_emit_type_derive_capability(&ctx, inner, trait_name, &visiting, bindings, generic_params)
        }
        // The runtime map carrier has no Rust `Ord` (sema never derives
        // Comparable over a Map).
        .Map(key, value) -> trait_name != "Ord" && jet_rust_emit_type_derive_capability(&ctx, key, trait_name, &visiting, bindings, generic_params) && jet_rust_emit_type_derive_capability(&ctx, value, trait_name, &visiting, bindings, generic_params)
        .Result(ok, err) -> jet_rust_emit_type_derive_capability(&ctx, ok, trait_name, &visiting, bindings, generic_params) && jet_rust_emit_type_derive_capability(&ctx, err, trait_name, &visiting, bindings, generic_params)
        // The runtime has no structural `JetShow`/`JetDebug` for tuples or
        // the synthetic `__JetUnion_*` carriers (no auto-Printable fact, no
        // derives), so a record holding one does not print structurally.
        .Tuple(fields) -> {
            if trait_name == "JetShow" || trait_name == "JetDebug" -> return false
            loop field in fields { if !jet_rust_emit_type_derive_capability(&ctx, field.ty, trait_name, &visiting, bindings, generic_params) -> return false }
            true
        }
        // Union values are spelled as the synthetic `__JetUnion_*` carrier,
        // which has no sema `Equatable`/`Comparable` derive and so no Rust
        // `PartialEq` or `Ord`.
        .Union(members) -> {
            if trait_name == "PartialEq" || trait_name == "Ord" || trait_name == "JetShow" || trait_name == "JetDebug" -> return false
            loop member in members { if !jet_rust_emit_type_derive_capability(&ctx, member, trait_name, &visiting, bindings, generic_params) -> return false }
            true
        }
        .Apply(name, args) -> {
            // A raw pointer or a view prints through no structural impl.
            if (trait_name == "JetShow" || trait_name == "JetDebug") && (name.name == "Ptr" || name.name == "View" || name.name == "ViewMut") -> return false
            if name.name == "Ptr" -> return true
            if name.name == "View" {
                if trait_name == "Clone" -> return true
                if args.len() == 0 -> return false
                return jet_rust_emit_type_derive_capability(&ctx, args[0], trait_name, &visiting, bindings, generic_params)
            }
            if name.name == "ViewMut" {
                if trait_name == "Clone" -> return false
                if args.len() == 0 -> return false
                return jet_rust_emit_type_derive_capability(&ctx, args[0], trait_name, &visiting, bindings, generic_params)
            }
            if jet_rust_emit_selected_user_capability_impl(&ctx, ty, trait_name) -> return true
            // The row is read in place; only its kind is copied, and only
            // when this frame expands it (a cache or cycle hit never does).
            row_index :: jet_rust_emit_structural_type_row(ctx, ty)
            if row_index == None {
                // MIRRust auto_derive_type_ready: a runtime handle implements
                // neither Printable nor Debug, so a record holding one does
                // not print structurally.
                if trait_name == "JetShow" || trait_name == "JetDebug" {
                    loop handle in ctx.program.handles { if jet_rust_emit_same_handle_type(handle.ty, ty) -> return false }
                }
                // A runtime carrier answers for `Ord` only through a checked
                // nominal row; none is assumed.
                if trait_name == "Ord" -> return false
                loop arg in args { if !jet_rust_emit_type_derive_capability(&ctx, arg, trait_name, &visiting, bindings, generic_params) -> return false }
                return true
            }
            row :: row_index
            if trait_name == "Clone" && ctx.program.types[row].ownership == MIROwnershipMode.Move -> return false
            is_alias :: ctx.program.types[row].kind == .Alias(_)
            // MIRRust auto_derive_type_ready for the structural show impls:
            // a nominal field prints through its own generated `JetShow` /
            // `JetDebug` (its auto-Printable fact / Debug derive) or a
            // selected user `Printable` / `Debug` impl.
            if (trait_name == "JetShow" || trait_name == "JetDebug") && !is_alias {
                if jet_rust_emit_selected_user_impl_named(&ctx, ty, if trait_name == "JetShow" -> "Printable" else -> "Debug") -> return true
                selected :: if trait_name == "JetShow" -> ctx.program.types[row].auto_printable else -> jet_rust_emit_type_def_derives_trait(ctx, ctx.program.types[row], "Debug")
                if !selected -> return false
            } else if !jet_rust_emit_type_derives_allowed(ctx.program.types[row]) {
                return false
            }
            // A nominal field compares through Rust `PartialEq` only when its
            // own row carries sema's structural `Equatable` derive (a user
            // `Equatable` impl has no Rust `PartialEq`); it orders through
            // Rust `Ord` only when the row also carries the structural
            // `Comparable` derive. An alias is transparent and answers for its
            // target. A union row is spelled as its synthetic carrier (see
            // `Union` above).
            if (trait_name == "PartialEq" || trait_name == "Ord") && !is_alias {
                if !jet_rust_emit_type_def_derives_trait(ctx, ctx.program.types[row], "Equatable") || jet_rust_emit_selected_user_impl_named(&ctx, ty, "Equatable") || ctx.program.types[row].name.starts_with("__JetUnion_") -> return false
            }
            if trait_name == "Ord" && !is_alias {
                if !jet_rust_emit_type_def_derives_trait(ctx, ctx.program.types[row], "Comparable") || jet_rust_emit_selected_user_impl_named(&ctx, ty, "Comparable") -> return false
            }
            row_id :: ctx.program.types[row].id
            if visiting.contains(row_id) {
                position := 0
                loop position < visiting.len() && visiting[position] != row_id {
                    position += 1
                }
                if position < ctx.derive_capability_cycle_floor -> ctx.derive_capability_cycle_floor = position
                return true
            }
            // A closed row's answer depends on the row alone: `false` means an
            // incapable leaf is reachable, and `true` is final once no cycle
            // assumption above this frame was used.
            cacheable :: args.len() == 0 && ctx.program.types[row].generic_params.len() == 0 && bindings.len() == 0 && generic_params.len() == 0
            cache_key :: "{trait_name}:{jet_rust_emit_id_key(row_id.value)}"
            if cacheable {
                if ctx.derive_capability_cache.get(cache_key) == .Val(cached) -> return cached
            }
            depth :: visiting.len()
            outer_floor :: ctx.derive_capability_cycle_floor
            ctx.derive_capability_cycle_floor = JET_RUST_EMIT_NO_CYCLE_FLOOR
            next_bindings := bindings
            next_generic_params := generic_params
            row_generic_params :: ~ctx.program.types[row].generic_params
            loop parameter in row_generic_params -> &next_generic_params.push(parameter.name)
            index := 0
            loop parameter in row_generic_params {
                if index < args.len() -> &next_bindings.add(parameter.name, args[index]).drop("generic parameter names are unique per declaration")
                index += 1
            }
            &visiting.push(row_id)
            kind :: ~ctx.program.types[row].kind
            result :: if kind == {
                .Struct(fields, _) -> {
                    capable := true
                    loop field in fields {
                        if !field.computed && !jet_rust_emit_type_derive_capability(&ctx, field.ty, trait_name, &visiting, next_bindings, next_generic_params) {
                            capable = false
                            break
                        }
                    }
                    capable
                }
                .Enum(variants, _) -> {
                    capable := true
                    loop variant in variants {
                        if variant.payload == {
                            .Single(payload) -> if !jet_rust_emit_type_derive_capability(&ctx, payload, trait_name, &visiting, next_bindings, next_generic_params) -> capable = false
                            .Named(fields) -> {
                                loop field in fields { if !jet_rust_emit_type_derive_capability(&ctx, field.ty, trait_name, &visiting, next_bindings, next_generic_params) -> capable = false }
                            }
                            .Unit -> {}
                        }
                        if !capable -> break
                    }
                    capable
                }
                .Distinct(base, _) | .Alias(base) -> jet_rust_emit_type_derive_capability(&ctx, base, trait_name, &visiting, next_bindings, next_generic_params)
                .UnitFamily(_) -> true
            }
            _ := &visiting.pop()
            floor :: ctx.derive_capability_cycle_floor
            if outer_floor < floor -> ctx.derive_capability_cycle_floor = outer_floor
            if cacheable && (!result || floor >= depth) -> ctx.derive_capability_cache[cache_key] = result
            result
        }
    }
}

fn jet_rust_emit_type_definition_derive_capability(ctx: &JetRustEmitContext, definition: MIRTypeDef, trait_name: String) -> Bool Never! {
    kind :: MIRTypeKind.Apply{name: MIRNominalRef{id: definition.id, name: definition.key}, args: [MIRType]{}}
    declared :: MIRType{kind: kind, identity: Val(definition.id), layout: mir_type_layout(kind)}
    jet_rust_emit_type_derive_capability(&ctx, declared, trait_name, [MIRTypeID]{}, [String:MIRType]{}, [String]{})
}

fn jet_rust_emit_type_derive_user_impl(ctx: &JetRustEmitContext, definition: MIRTypeDef, trait_name: String) -> Bool Never! {
    kind :: MIRTypeKind.Apply{name: MIRNominalRef{id: definition.id, name: definition.key}, args: [MIRType]{}}
    declared :: MIRType{kind: kind, identity: Val(definition.id), layout: mir_type_layout(kind)}
    jet_rust_emit_selected_user_capability_impl(&ctx, declared, trait_name)
}

fn jet_rust_emit_generic_params(ctx: &JetRustEmitContext, params: [MIRGenericParam]) -> String Never! {
    if params.len() == 0 -> return ""
    rendered := [String]{}
    loop param in params {
        bounds := [String]{}
        loop bound in param.bounds -> &bounds.push(jet_rust_emit_trait_name(&ctx, bound.id))
        if bounds.len() == 0 -> &rendered.push(jet_rust_emit_mangle(param.name)) else -> &rendered.push("{jet_rust_emit_mangle(param.name)}: {bounds.join(" + ")}")
    }
    "<{rendered.join(", ")}>"
}

fn jet_rust_emit_visibility(visibility: MIRVisibility) -> String Never! {
    if visibility == {
        .Private -> ""
        .Package -> "pub(crate) "
        .Public -> "pub "
    }
}

fn jet_rust_emit_field_declaration(ctx: &JetRustEmitContext, field: MIRField, boxed: Bool) -> String Never! {
    visibility :: if {
        field.public -> "pub "
        field.package_public -> "pub(crate) "
        else -> ""
    }
    rust_type :: jet_rust_emit_type(&ctx, field.ty)
    ty :: if boxed -> "Box<{rust_type}>" else -> rust_type
    "{visibility}{jet_rust_emit_field_name(&ctx, field.id)}: {ty}"
}

// MIRRust emit_type_def / emit_c_abi_records layout attributes: a tagged C
// enum keeps its checked non-`c_int` tag width, and an aligned record takes
// the checked effective alignment.
fn jet_rust_emit_layout_attributes(ctx: &JetRustEmitContext, definition: MIRTypeDef, lines: &[String]) Never! {
    layout :: definition.layout ?? return
    if layout == {
        .C -> {
            repr := "C"
            if definition.kind == .Enum(_, _) {
                if definition.c_layout_tag == .Val(enum_tag) {
                    if enum_tag != MIRCEnumTag.CInt -> repr = "C, {jet_rust_emit_c_abi_tag_type(enum_tag)}"
                }
            }
            &lines.push("#[repr({repr})]")
        }
        .CAligned(alignment, _) -> {
            fact :: definition.layout_alignment ?? {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR aligned type has no layout alignment fact", "aligned layouts carry the checked sema alignment fact", Val(definition.span))
                return
            }
            if fact.requested_alignment != alignment {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR aligned type fact disagrees with its requested alignment", "the checked alignment fact records the layout's requested alignment", Val(definition.span))
                return
            }
            &lines.push("#[repr(C, align({fact.effective_alignment}))]")
        }
        .Columnar -> {}
    }
}

fn jet_rust_emit_handle_for_definition(ctx: &JetRustEmitContext, definition: MIRTypeDef) -> MIRHandleLifecycle? {
    loop handle in ctx.program.handles {
        if handle.ty.kind == {
            .Apply(name, _) -> {
                if name.name == definition.name || name.name == definition.key -> return Val(handle)
            }
            else -> {}
        }
    }
    None
}

// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::emit_handle_type
fn jet_rust_emit_handle_type(ctx: &JetRustEmitContext, handle: MIRHandleLifecycle, lines: &[String]) Never! {
    if handle.payload.library == "core.process" -> return
    name :: jet_rust_emit_type(&ctx, handle.ty)
    &lines.push("#[repr(transparent)]")
    &lines.push("#[derive(Debug)]")
    &lines.push("pub struct {name} {{")
    &lines.push("    __jet_token: jet_foundation::MIR::MirHandleToken,")
    &lines.push("}}")
    &lines.push("impl {name} {{")
    &lines.push("    pub fn from_raw(raw: *mut core::ffi::c_void) -> Self {{")
    &lines.push("        Self {{ __jet_token: jet_foundation::MIR::MirHandleToken::new(jet_foundation::MIR::MirHandleId({handle.id.value}), raw as i64) }}")
    &lines.push("    }}")
    &lines.push("    pub fn as_raw(&self) -> *mut core::ffi::c_void {{")
    &lines.push("        self.__jet_token.raw().map(|raw| raw as *mut core::ffi::c_void).unwrap_or_else(|| panic!(\"opaque handle was already moved\"))")
    &lines.push("    }}")
    &lines.push("    pub fn into_raw(self) -> *mut core::ffi::c_void {{")
    &lines.push("        self.__jet_token.take_raw().map(|(_, raw)| raw as *mut core::ffi::c_void).unwrap_or_else(|| panic!(\"opaque handle was already moved\"))")
    &lines.push("    }}")
    &lines.push("    pub fn token_identity(&self) -> usize {{ self.__jet_token.identity() }}")
    &lines.push("}}")
    if handle.ownership != MIRHandleOwnership.Owned -> return
    close_foreign := MIRForeignID?{None}
    if handle.close_foreign == .Val(candidate) {
        loop foreign in jet_rust_emit_foreign_rows(ctx, candidate) {
            if foreign.id == candidate && jet_rust_emit_foreign_target_enabled(&ctx, foreign) -> close_foreign = Val(candidate)
        }
    }
    close_function := MIRFunctionID?{None}
    if handle.close == .Val(candidate) {
        if jet_rust_emit_function_index(ctx, candidate) == .Val(function_index) {
            if ctx.program.functions[function_index].id == candidate && jet_rust_emit_function_target_enabled(ctx.config, ctx.program.functions[function_index]) -> close_function = Val(candidate)
        }
    }
    if close_foreign == None && close_function == None -> return
    close_function_id :: close_function ?? MIRFunctionID{value: 0}
    close_foreign_id :: close_foreign ?? MIRForeignID{value: 0}
    &lines.push("impl Drop for {name} {{")
    &lines.push("    fn drop(&mut self) {{")
    &lines.push("        if let Some((_, __jet_raw)) = self.__jet_token.take_raw() {{")
    // MIRRust emit_handle_type: a selected foreign close wins over the Jet close.
    if {
        close_foreign != None -> {
        close := jet_rust_emit_foreign_name(&ctx, close_foreign_id)
        &lines.push("            unsafe {{ let _ = {close}(__jet_raw as *mut core::ffi::c_void); }}")
        }
        else -> {
        close := jet_rust_emit_function_name(&ctx, close_function_id)
        needs_unsafe := false
        if jet_rust_emit_function_index(ctx, close_function_id) == .Val(function_index) {
            if ctx.program.functions[function_index].id == close_function_id -> needs_unsafe = ctx.program.functions[function_index].is_unsafe
        }
        &lines.push("            let __jet_handle = {name}::from_raw(__jet_raw as *mut core::ffi::c_void);")
        if {
            needs_unsafe -> {
            &lines.push("            let _ = unsafe {{ {close}(__jet_handle) }};")
            }
            else -> {
            &lines.push("            let _ = {close}(__jet_handle);")
            }
        }
        }
    }
    &lines.push("        }}")
    &lines.push("    }}")
    &lines.push("}}")
}

fn jet_rust_emit_derived_impl_matches_type(implementation: MIRImplDef, definition: MIRTypeDef, trait_id: MIRTraitID, trait_key: String) -> Bool Never! {
    if implementation.trait_ref == None -> return false
    trait_ref :: implementation.trait_ref ?? MIRTraitRef{id: MIRTraitID{value: 0}, name: ""}
    if trait_ref.id != trait_id || trait_ref.name != trait_key -> return false
    if implementation.self_type.identity == (Val(definition.id)) -> return true
    if implementation.self_type.kind == {
        .Apply(name, _) -> name.id == definition.id
        else -> false
    }
}

// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::validate_derived_trait
fn jet_rust_emit_validate_derived_trait(ctx: &JetRustEmitContext, definition: MIRTypeDef, trait_id: MIRTraitID, trait_name: String) Never! {
    trait_definition := MIRTraitDef?{None}
    trait_key := ""
    loop candidate in jet_rust_emit_trait_rows(ctx, trait_id) {
        if candidate.id == trait_id {
            trait_definition = Val(candidate)
            trait_key = candidate.key
            if candidate.name != trait_name {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR derive trait name disagrees with its identity", "checked custom derives select the exact trait ID; names are consistency data only", Val(definition.span))
                return
            }
            break
        }
    }
    if trait_definition == None {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR derive trait has no declaration", "checked custom derives must resolve their canonical trait identity", Val(definition.span))
        return
    }
    implementation := MIRImplDef?{None}
    // Only the impls of this trait, in program order (first match wins as before).
    rows :: ~(ctx.impls_by_trait.get(jet_rust_emit_id_key(trait_id.value)) ?? [Int]{})
    loop row in rows {
        candidate :: ~ctx.program.impls[row]
        if jet_rust_emit_derived_impl_matches_type(candidate, definition, trait_id, trait_key) && jet_rust_emit_impl_target_enabled(&ctx, candidate) {
            implementation = Val(candidate)
            break
        }
    }
    if implementation == None {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR type derives a trait without a selected implementation", trait_name, Val(definition.span))
        return
    }
    trait_row :: trait_definition ?? return
    impl_row :: implementation ?? return
    loop method in trait_row.methods {
        if method.default != None -> next
        implemented := false
        loop function_id in impl_row.methods {
            if jet_rust_emit_function_index(ctx, function_id) == .Val(function_index) {
                if ctx.program.functions[function_index].id == function_id && ctx.program.functions[function_index].name == method.name -> implemented = true
            }
        }
        if !implemented -> jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR derived implementation omits a required method", method.name, Val(impl_row.span))
    }
}

fn jet_rust_emit_type_derive_names(ctx: &JetRustEmitContext, definition: MIRTypeDef) -> [String] Never! {
    derives_allowed :: jet_rust_emit_type_derives_allowed(definition)
    clone_capable :: derives_allowed && jet_rust_emit_type_definition_derive_capability(&ctx, definition, "Clone")
    debug_capable :: derives_allowed && jet_rust_emit_type_definition_derive_capability(&ctx, definition, "Debug")
    clone_user_impl :: jet_rust_emit_type_derive_user_impl(&ctx, definition, "Clone")
    debug_user_impl :: jet_rust_emit_type_derive_user_impl(&ctx, definition, "Debug")
    derives := [String]{}
    if clone_capable && !clone_user_impl -> &derives.push("Clone")
    if debug_capable && !debug_user_impl -> &derives.push("Debug")
    loop trait_id in definition.derives {
        trait_row := MIRTraitDef?{None}
        duplicate_trait_row := false
        loop candidate in jet_rust_emit_trait_rows(ctx, trait_id) {
            if candidate.id == trait_id {
                if trait_row != None {
                    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR derive trait identity is duplicated", "checked type derives require one row for each declared trait ID", Val(definition.span))
                    duplicate_trait_row = true
                    break
                }
                trait_row = Val(candidate)
            }
        }
        if duplicate_trait_row -> next
        // MIRRust emit_type_def: a native Rust derive name is a Rust derive
        // whether or not a declaration row carries it; only other names are
        // custom derives validated against their generated provider. Jet
        // lowering may omit the row of a canonical native derive ID.
        derive_name := ""
        if trait_row == .Val(row) {
            derive_name = row.name
        } else {
            derive_name = jet_rust_emit_native_rust_derive_name_for_id(trait_id) ?? {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR derive trait identity has no row", "only canonical native Rust derive IDs may omit a checked trait declaration", Val(definition.span))
                next
            }
        }
        if !jet_rust_emit_is_native_rust_derive_name(derive_name) {
            jet_rust_emit_validate_derived_trait(&ctx, definition, trait_id, derive_name)
            // Sema's structural `Equatable` derive is the checked fact behind
            // Rust `PartialEq` (`jet_eq` for `assert_eq`); every nominal field
            // must carry the same fact to derive it (MIRRust emit_type_def).
            if derive_name == "Equatable" && derives_allowed && !derives.contains("PartialEq") && jet_rust_emit_type_definition_derive_capability(&ctx, definition, "PartialEq") -> &derives.push("PartialEq")
            next
        }
        name :: derive_name
        if name == "Clone" && !clone_capable && !clone_user_impl {
            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR type derives Clone without a checked Rust Clone capability", "all stored fields and recursive nominal payloads must support Clone and ownership must not be Move", Val(definition.span))
        }
        // An automatic Debug selection whose fields cannot all print is not
        // derived (MIRRust auto_derive_type_ready); only Clone is a hard fact.
        capability := derives_allowed
        if name == "Clone" -> capability = clone_capable && !clone_user_impl
        if name == "Debug" -> capability = debug_capable && !debug_user_impl
        if capability && !derives.contains(name) -> &derives.push(name)
    }
    // Sema's structural `Comparable` derive (beside its structural
    // `Equatable`) is the checked fact behind the native `Eq`/`PartialOrd`/
    // `Ord` an ordered `JetMap` key needs. The derived Rust order is the
    // structural one: fields in declaration order, enum variants by ordinal.
    if derives_allowed && derives.contains("PartialEq") && jet_rust_emit_type_definition_derive_capability(&ctx, definition, "Ord") {
        if !derives.contains("Eq") -> &derives.push("Eq")
        if !derives.contains("PartialOrd") -> &derives.push("PartialOrd")
        if !derives.contains("Ord") -> &derives.push("Ord")
    }
    derives
}

fn jet_rust_emit_type_derive_lines(ctx: &JetRustEmitContext, definition: MIRTypeDef, lines: &[String]) Never! {
    derives :: jet_rust_emit_type_derive_names(&ctx, definition)
    if definition.kind == .Alias(_) -> return
    if derives.len() > 0 -> &lines.push("#[derive({derives.join(", ")})]")
    if definition.must_use -> &lines.push("#[must_use]")
}

fn jet_rust_emit_columnar_field_capability(ctx: &JetRustEmitContext, definition: MIRTypeDef, field: MIRField, trait_name: String) -> Bool Never! {
    generic_params := [String]{}
    loop parameter in definition.generic_params -> &generic_params.push(parameter.name)
    visiting := [MIRTypeID]{definition.id}
    jet_rust_emit_type_derive_capability(&ctx, field.ty, trait_name, &visiting, [String:MIRType]{}, generic_params)
}

fn jet_rust_emit_columnar_impl_generics(ctx: &JetRustEmitContext, params: [MIRGenericParam]) -> String Never! {
    if params.len() == 0 -> return ""
    rendered := [String]{}
    loop parameter in params {
        bounds := [String]{}
        loop bound in parameter.bounds -> &bounds.push(jet_rust_emit_trait_name(&ctx, bound.id))
        &bounds.push("Clone")
        &rendered.push("{jet_rust_emit_mangle(parameter.name)}: {bounds.join(" + ")}")
    }
    "<{rendered.join(", ")}>"
}

fn jet_rust_emit_columnar_generic_args(params: [MIRGenericParam]) -> String Never! {
    if params.len() == 0 -> return ""
    rendered := [String]{}
    loop parameter in params -> &rendered.push(jet_rust_emit_mangle(parameter.name))
    "<{rendered.join(", ")}>"
}

fn jet_rust_emit_columnar_row_adapter(ctx: &JetRustEmitContext, definition: MIRTypeDef, fields: [MIRField], lines: &[String]) Never! {
    usable := [MIRField]{}
    loop field in fields {
        if !field.computed -> &usable.push(field)
    }
    clone_capable := true
    debug_capable := true
    loop field in usable {
        if !jet_rust_emit_columnar_field_capability(&ctx, definition, field, "Clone") -> clone_capable = false
        if !jet_rust_emit_columnar_field_capability(&ctx, definition, field, "Debug") -> debug_capable = false
    }
    if !clone_capable {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR columnar cell has no Rust Clone capability", "the checked JetRow contract requires every stored column cell to implement Clone", Val(definition.span))
        return
    }
    generic_args :: jet_rust_emit_columnar_generic_args(definition.generic_params)
    impl_generics :: jet_rust_emit_columnar_impl_generics(&ctx, definition.generic_params)
    cell_name :: jet_rust_emit_generated_path("{definition.name}_cell")
    cell_type :: "{cell_name}{generic_args}"
    row_type :: "{jet_rust_emit_type_name(&ctx, definition.id)}{generic_args}"
    derives :: if debug_capable -> "Clone, Debug" else -> "Clone"
    &lines.push("#[derive({derives})]")
    &lines.push("#[allow(dead_code, non_camel_case_types)]")
    &lines.push("pub enum {cell_type} {{")
    loop field in usable {
        &lines.push("    {jet_rust_emit_field_name(&ctx, field.id)}({jet_rust_emit_type(&ctx, field.ty)}),")
    }
    &lines.push("}}")
    &lines.push("#[allow(dead_code, unreachable_patterns)]")
    &lines.push("impl{impl_generics} {cell_type} {{")
    loop field in usable {
        field_name := jet_rust_emit_field_name(&ctx, field.id)
        field_type :: jet_rust_emit_type(&ctx, field.ty)
        accessor :: "jet_col_{field_name}"
        &lines.push("    pub fn {accessor}(self) -> {field_type} {{")
        &lines.push("        match self {{")
        &lines.push("            {cell_type}::{field_name}(__value) => __value,")
        &lines.push("            _ => unreachable!(\"columnar cell does not match its column\"),")
        &lines.push("        }}")
        &lines.push("    }}")
        &lines.push("    pub fn {accessor}_ref(&self) -> &{field_type} {{")
        &lines.push("        match self {{")
        &lines.push("            {cell_type}::{field_name}(__value) => __value,")
        &lines.push("            _ => unreachable!(\"columnar cell does not match its column\"),")
        &lines.push("        }}")
        &lines.push("    }}")
    }
    &lines.push("}}")
    &lines.push("impl{impl_generics} {ctx.config.root_prefix}JetRow for {row_type} {{")
    &lines.push("    type Cell = {cell_type};")
    &lines.push("    fn jet_row_width() -> usize {{ {usable.len()} }}")
    &lines.push("    fn jet_row_split(self) -> Vec<Self::Cell> {{")
    &lines.push("        vec![")
    loop field in usable {
        field_name := jet_rust_emit_field_name(&ctx, field.id)
        &lines.push("            {cell_type}::{field_name}(self.{field_name}),")
    }
    &lines.push("        ]")
    &lines.push("    }}")
    &lines.push("    fn jet_row_join(__cells: Vec<Self::Cell>) -> Self {{")
    &lines.push("        let mut __cells = __cells.into_iter();")
    &lines.push("        Self {{")
    loop field in usable {
        field_name := jet_rust_emit_field_name(&ctx, field.id)
        &lines.push("            {field_name}: match __cells.next() {{")
        &lines.push("                Some({cell_type}::{field_name}(__value)) => __value,")
        &lines.push("                _ => unreachable!(\"columnar row is narrower than its column set\"),")
        &lines.push("            }},")
    }
    &lines.push("        }}")
    &lines.push("    }}")
    &lines.push("}}")
}

// tir_to_mir_types COMPILER_OWNED_ENUMS / COMPILER_OWNED_CORE_RECORDS /
// COMPILER_OWNED_MATH_RECORDS / COMPILER_OWNED_GEOMETRY_RECORDS: the leaves
// whose rows the cached runtime or Prelude declares once.
JET_RUST_EMIT_COMPILER_OWNED_ENUMS :: prep { [String]{
    "Overflow", "FailurePolicy", "HookPolicy", "HookOutcome", "HookDecision", "DispatchState", "Ordering", "RemoveBy", "TaskFailure", "TaskOutcome",
    "TaskStatus", "DeliveryState", "IOError", "Key", "IOOperation", "ProcessResourceLimit", "ProcessStreamMode", "TerminalMode", "DurationUnit", "FontStyle",
    "GlyphShaper", "WebFormValueType", "WebFormControl", "DataLoaderKind", "DataErrorKind", "DataFormat", "DataFreshness", "DataInvalidationCause", "DataTree", "DataEvent",
    "XMLCanonicalMode", "EmailError", "SMTPSecurity", "RecipientPolicy", "SMTPAuth", "TLSTrust", "TLSVersion", "TLSClientTrust", "NetDnsError", "NetError",
    "NetShutdown", "WatchDomain", "WatchKind", "NetReadyInterest", "WsError",
} }
JET_RUST_EMIT_COMPILER_OWNED_RECORDS :: prep { [String]{
    "IOContext", "NetErrorDetail", "AsyncPolicy", "CSVRow", "DataLineOptions", "DataLimits", "DataSourceIdentity", "DataAuthority", "DataError", "EncodingCause",
    "EncodingError", "EncodingLimits", "DataProvenance", "DataSchema", "DataSnapshotIdentity", "DataLoaderStatus", "Claims", "WebFormFieldSpec", "WebFormFieldState", "WebTableState",
    "WebTablePage", "WebVirtualPlan", "MemoStats", "GameScene", "GameFrame", "GameAssets", "GameInputMap", "GameInputSnapshot", "GameBackend", "GameReplay",
    "GameImage", "GameSound", "TestSuite", "TestComparison", "ProcessReceipt", "ProcessPlan", "ProcessChild", "TerminalSize", "TerminalPolicy", "Address",
    "Message", "Attachment", "RecipientReport", "SendReport", "Limits", "Mailer", "Envelope", "DKIMConfig", "SMTPConfig", "XMLCanonical",
    "Size", "UINode", "JSONWriter", "JSONReader", "JSONLWriter", "JSONLReader", "DirEntry", "WalkEntry", "TempDir", "TempFile",
    "FileLock", "WatchEvent", "Stat", "DataColumn", "DataStatus", "FontFace", "Glyph", "GlyphRun", "UIFileFilter", "UIFSGrant",
    "UIGrantedPath", "UIFileDialogRequest", "UIFileDialogSelection", "UIClipboardText", "UIClipboardWrite", "UITextRange", "UIIMEComposition", "UIIMEEvent", "UIDragEvent", "UIShortcut",
    "UIShortcutBinding", "UIAccessibility", "TypeInfo", "LayoutInfo", "LayoutField", "MarkerInfo", "MarkerArgInfo", "StateInfo", "StateRef", "TransitionInfo",
    "FactInfo", "FactValue", "MeasureInfo", "ExactnessInfo", "LayoutFact", "ClassificationInfo", "NominalInfo", "ObligationParamInfo", "ObligationInfo", "SendabilityInfo",
    "MovednessInfo", "ViewProvenanceInfo", "AttributionInfo", "OriginInfo", "UnitScaleProvenanceInfo", "MaturityInfo", "DimensionInfo", "DimensionAxis", "FunctionInfo", "ArithmeticOperationInfo",
    "PackageInfo", "EffectInfo", "MethodInfo", "FieldInfo", "TypeParamInfo", "SourceSpan", "TLSPeerIdentity", "TLSCertificate", "ModGrant",
    "F32x4", "F64x2", "Vec2", "Vec3", "Vec4",
    "Point2", "Delta2", "ScreenPoint", "WorldPoint", "ViewPoint", "CameraPoint", "DevicePoint", "ScreenDelta", "WorldDelta", "ViewDelta",
    "CameraDelta", "DeviceDelta", "Ray2", "Transform", "Transform2",
    "Measurement", "Err", "VJPRun", "Group", "DataJoin", "DataSnapshot", "DataPivotCell", "DataSummary", "FieldError", "AllocError",
    "KeyRef", "MutationPlan", "VaultWrite", "Rotation", "Range",
} }

// tir_to_mir_types is_compiler_owned_type: a registered compiler-owned enum or
// Core runtime record/carrier, classified by its Core source leaf.
fn jet_rust_emit_compiler_owned_type(key: String) -> Bool Never! {
    leaf :: jet_rust_emit_core_source_type_leaf(key)
    if JET_RUST_EMIT_COMPILER_OWNED_ENUMS.contains(leaf) || JET_RUST_EMIT_COMPILER_OWNED_RECORDS.contains(leaf) -> return true
    if core_enum_variants(leaf) != None && (!key.starts_with("<corelib>/") || jet_rust_emit_core_rust_type_name(key) != None) -> return true
    if jet_rust_emit_core_email_type_name(leaf) != None || jet_rust_emit_core_crypto_rust_type_name(leaf) != None -> return true
    if (jet_rust_emit_core_rust_type_name(leaf) ?? "") == "JetMappedFile" -> return true
    key.starts_with("<corelib>/Core/files::Core/files/files.jet::") && (leaf == "FileReader" || leaf == "FileWriter" || leaf == "FileScope")
}

// MIRRust runtime_declares_type: handles and compiler-owned rows (`Ordering`,
// default `Err`, Core runtime records) are declared once by the cached
// runtime, never per program.
fn jet_rust_emit_runtime_declares_type(ctx: &JetRustEmitContext, definition: MIRTypeDef) -> Bool Never! {
    definition.compiler_builtin != None || jet_rust_emit_handle_for_definition(&ctx, definition) != None || jet_rust_emit_compiler_owned_type(definition.key)
}

// MIRRust declares_type_def: type rows whose Rust declaration this artifact
// emits; canonical Core native carriers already have their Prelude spelling.
fn jet_rust_emit_declares_type_definition(ctx: &JetRustEmitContext, definition: MIRTypeDef) -> Bool Never! {
    !jet_rust_emit_runtime_declares_type(&ctx, definition) && !jet_rust_emit_is_canonical_core_native_type(definition.key)
}

fn jet_rust_emit_type_definition(ctx: &JetRustEmitContext, definition: MIRTypeDef, lines: &[String]) Never! {
    if jet_rust_emit_runtime_declares_type(&ctx, definition) -> return
    // MIRRust: a canonical Core native carrier is declared by the Prelude; only the
    // web-query status enums still take their structural show impls here.
    if jet_rust_emit_is_canonical_core_native_type(definition.key) {
        if jet_codegen_auto_derives_core_web_query_enum(definition.key) {
            debug_native := false
            loop trait_id in definition.derives {
                loop row in jet_rust_emit_trait_rows(ctx, trait_id) { if row.id == trait_id && row.name == "Debug" -> debug_native = true }
            }
            loop line in jet_codegen_auto_derive_lines(&ctx, definition, JetCodegenAutoDeriveFacts{type_id: definition.id, printable: definition.auto_printable, debug: debug_native}) -> &lines.push(line)
        }
        return
    }
    previous_generic_params := ctx.current_generic_params
    ctx.current_generic_params = jet_rust_emit_merge_generic_params(previous_generic_params, definition.generic_params)
    jet_rust_emit_layout_attributes(&ctx, definition, &lines)
    jet_rust_emit_type_derive_lines(&ctx, definition, &lines)
    visibility :: if {
        definition.public -> MIRVisibility.Public
        definition.package_public -> MIRVisibility.Package
        else -> MIRVisibility.Private
    }
    visibility_name :: jet_rust_emit_visibility(visibility)
    name :: jet_rust_emit_type_name(&ctx, definition.id)
    generics :: jet_rust_emit_generic_params(&ctx, definition.generic_params)
    if definition.kind == {
        .Struct(fields, _) -> {
            &lines.push("{visibility_name}struct {name}{generics} {{")
            loop field in fields {
                if !field.computed {
                    boxed := false
                    loop edge in definition.boxed_edges { if edge == field.name -> boxed = true }
                    &lines.push("    {jet_rust_emit_field_declaration(&ctx, field, boxed)},")
                }
            }
            &lines.push("}}")
            &lines.push("")
        }
        .Enum(variants, _) -> {
            &lines.push("{visibility_name}enum {name}{generics} {{")
            loop variant in variants {
                variant_name :: jet_rust_emit_variant_name(&ctx, definition.id, variant.name)
                if variant.payload == {
                    .Unit -> &lines.push("    {variant_name},")
                    .Single(value) -> {
                        boxed := false
                        loop edge in definition.boxed_edges { if edge == variant.name -> boxed = true }
                        ty := jet_rust_emit_type(&ctx, value)
                        if boxed -> ty = "Box<{ty}>"
                        &lines.push("    {variant_name}({ty}),")
                    }
                    .Named(fields) -> {
                        &lines.push("    {variant_name} {{")
                        // MIRRust: enum payload fields inherit the enum's
                        // visibility; a Rust qualifier there is E0449.
                        loop field in fields {
                            boxed := false
                            boxed_key :: "{variant.name}.{field.name}"
                            loop edge in definition.boxed_edges { if edge == boxed_key -> boxed = true }
                            rust_type :: jet_rust_emit_type(&ctx, field.ty)
                            ty :: if boxed -> "Box<{rust_type}>" else -> rust_type
                            &lines.push("        {jet_rust_emit_field_name(&ctx, field.id)}: {ty},")
                        }
                        &lines.push("    }},")
                    }
                }
            }
            &lines.push("}}")
            &lines.push("")
        }
        .Distinct(base, _) -> {
            &lines.push("#[repr(transparent)]")
            &lines.push("{visibility_name}struct {name}{generics}(pub {jet_rust_emit_type(&ctx, base)});")
            &lines.push("")
        }
        .Alias(target) -> {
            &lines.push("{visibility_name}type {name}{generics} = {jet_rust_emit_type(&ctx, target)};")
            &lines.push("")
        }
        .UnitFamily(members) -> {
            &lines.push("{visibility_name}enum {name}{generics} {{")
            loop member in members -> &lines.push("    {jet_rust_emit_mangle(member)},")
            &lines.push("}}")
            &lines.push("")
        }
    }
    debug_derived := false
    loop trait_id in definition.derives {
        loop row in jet_rust_emit_trait_rows(ctx, trait_id) { if row.id == trait_id && row.name == "Debug" -> debug_derived = true }
    }
    debug_derived = debug_derived && jet_rust_emit_type_definition_derive_capability(&ctx, definition, "JetDebug")
    printable :: definition.auto_printable && jet_rust_emit_type_definition_derive_capability(&ctx, definition, "JetShow")
    loop line in jet_codegen_auto_derive_lines(&ctx, definition, JetCodegenAutoDeriveFacts{type_id: definition.id, printable: printable, debug: debug_derived}) -> &lines.push(line)
    if definition.layout != None {
        layout :: definition.layout ?? MIRStructLayout.C
        if layout == {
            .Columnar -> {
                if definition.kind == {
                    .Struct(fields, _) -> {
                        jet_rust_emit_columnar_row_adapter(&ctx, definition, fields, &lines)
                        &lines.push("")
                    }
                    else -> jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR columnar layout requires a struct type definition", "columnar row adapters are defined only for checked struct rows", Val(definition.span))
                }
            }
            else -> {}
        }
    }
    ctx.current_generic_params = previous_generic_params
}

fn jet_rust_emit_named_type(ctx: &JetRustEmitContext, raw: String) -> String Never! {
    if ctx.type_by_name.get(raw) == .Val(name) -> return name
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR constant names a missing nominal type", "constant declarations must resolve to one emitted type identity", None)
    "__jet_missing_type_{jet_rust_emit_sanitize(raw)}"
}

fn jet_rust_emit_named_field(ctx: &JetRustEmitContext, owner: String, raw: String) -> String Never! {
    loop definition in ctx.program.types {
        if definition.key == owner || definition.name == owner {
            if definition.kind == {
                .Struct(fields, _) -> {
                    loop field in fields {
                        if field.name == raw -> return jet_rust_emit_field_name(&ctx, field.id)
                    }
                }
                else -> {}
            }
        }
    }
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR constant names a missing field", "constant struct fields must resolve to one emitted field identity", None)
    "__jet_missing_field_{jet_rust_emit_sanitize(raw)}"
}

// Rust: crates/jet-codegen/src/Codegen/MIRRust.rs::shape_name_map
fn jet_rust_emit_shape_name_map(ctx: &JetRustEmitContext, target: MIRType, projection: String, member: String) -> String Never! {
    identity :: target.identity ?? {
        jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingIdentity, "E0003", "MIR shape adapter target has no canonical type identity", "checked shape adapters must retain the target struct identity", None)
        return "&[]"
    }
    if jet_rust_emit_type_index(ctx, identity) == .Val(definition_index) {
        if ctx.program.types[definition_index].id == identity {
            if ctx.program.types[definition_index].kind == {
                .Struct(fields, _) -> {
                    pairs := [String]{}
                    loop field in fields {
                        if field.skip || field.computed -> next
                        selected := if projection == {
                            "db" -> field.shape_names.db
                            "env" -> Val(field.shape_names.env)
                            "args" -> Val(field.shape_names.args)
                            else -> {
                                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR shape adapter projection is unknown", "shape adapters must select one checked projection naming policy", Val(field.span))
                                return "&[]"
                            }
                        }
                        if selected == None || field.shape_names.json == None {
                            jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR shape adapter field name is incomplete", "checked shape adapters require both a selected source name and canonical JSON key", Val(field.span))
                            return "&[]"
                        }
                        source_name :: selected ?? ""
                        json_name :: field.shape_names.json ?? ""
                        &pairs.push("({jet_rust_emit_quote(source_name)}, {jet_rust_emit_quote(json_name)})")
                    }
                    return "&[{pairs.join(", ")}]"
                }
                else -> {
                    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR shape adapter target is not a struct", "checked shape adapters only decode declared struct carriers", None)
                    return "&[]"
                }
            }
        }
    }
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.MissingRow, "E0003", "MIR shape adapter target type is missing", "checked shape adapters must resolve their target definition before source emission", None)
    return "&[]"
}

// MIRRust constant_for_type: the type a nested constant renders against.
// Slot 0 selects a map key or result success, slot 1 a map value or error.
fn jet_rust_emit_constant_inner_type(ty: MIRType, slot: Int) -> MIRType Never! {
    if ty.kind == {
        .List(inner) | .FixedList(inner, _) | .Option(inner) -> ~inner
        .Map(key, value) -> if slot == 0 -> ~key else -> ~value
        .Result(ok, err) -> if slot == 0 -> ~ok else -> ~err
        else -> ~ty
    }
}

// MIRRust typed_constant_definition (#4003): the declaration a folded constant
// builds comes from the checked type it flows into; without one, its exact key
// or the one declaration carrying its display name. A user `FontStyle` beside
// Core's never resolves to Core's row.
fn jet_rust_emit_constant_type_definition(ctx: &JetRustEmitContext, type_name: String, ty: MIRType) -> MIRTypeDef? {
    candidates := [MIRType]{ty}
    if ty.kind == {
        .Option(inner) -> &candidates.push(~inner)
        .Result(ok, err) -> {
            &candidates.push(~ok)
            &candidates.push(~err)
        }
        else -> {}
    }
    loop candidate in candidates {
        if candidate.kind == .Apply(name, _) {
            loop definition in ctx.program.types {
                if definition.id != name.id && definition.key != name.name -> next
                if definition.key == type_name || definition.name == type_name -> return Val(definition)
            }
        }
    }
    loop definition in ctx.program.types {
        if definition.key == type_name -> return Val(definition)
    }
    found := MIRTypeDef?{None}
    loop definition in ctx.program.types {
        if definition.name == type_name {
            if found != None -> return None
            found = Val(definition)
        }
    }
    found
}

// The spelling a resolved constant renders through: its key when several
// declarations share the display name, else the source spelling.
fn jet_rust_emit_constant_owner(ctx: &JetRustEmitContext, type_name: String, definition: MIRTypeDef?) -> String Never! {
    resolved :: definition ?? return type_name
    shared := 0
    loop candidate in ctx.program.types {
        if candidate.name == resolved.name -> shared += 1
    }
    if shared > 1 -> resolved.key else -> type_name
}

// MIRRust history_capture_type over the definition's generic bindings: a
// declared field type renders against the constant's actual type arguments.
fn jet_rust_emit_constant_bound_type(ctx: &JetRustEmitContext, definition: MIRTypeDef, declared: MIRType, ty: MIRType) -> MIRType Never! {
    if ty.kind == .Apply(_, args) {
        if args.len() > 0 && definition.generic_params.len() > 0 -> return jet_rust_emit_partial_substitute_type(&ctx, declared, definition.generic_params, args)
    }
    ~declared
}

fn jet_rust_emit_constant_field_type(ctx: &JetRustEmitContext, definition: MIRTypeDef?, field_name: String, fallback: MIRType) -> MIRType Never! {
    if definition == Val(resolved) {
        if resolved.kind == .Struct(fields, _) {
            loop field in fields { if field.name == field_name -> return jet_rust_emit_constant_bound_type(&ctx, resolved, field.ty, fallback) }
        }
    }
    ~fallback
}

fn jet_rust_emit_constant_payload_type(ctx: &JetRustEmitContext, definition: MIRTypeDef?, variant: String, index: Int, name: String?, fallback: MIRType) -> MIRType Never! {
    if definition == Val(resolved) {
        if resolved.kind == .Enum(variants, _) {
            loop candidate in variants {
                if candidate.name != variant -> next
                if candidate.payload == {
                    .Single(payload) -> return jet_rust_emit_constant_bound_type(&ctx, resolved, payload, fallback)
                    .Named(fields) -> {
                        loop (position, field) in fields {
                            if name == (Val(field.name)) || (name == None && position == index) -> return jet_rust_emit_constant_bound_type(&ctx, resolved, field.ty, fallback)
                        }
                    }
                    .Unit -> {}
                }
            }
        }
    }
    ~fallback
}

// MIRRust boxed_edges: a recursive field or payload edge is stored in a Box,
// so its folded value is allocated like an ordinary constructor's.
fn jet_rust_emit_constant_edge_boxed(definition: MIRTypeDef?, edge: String) -> Bool Never! {
    resolved :: definition ?? return false
    resolved.boxed_edges.contains(edge)
}

// The Rust name of one named payload field of a folded enum constant.
fn jet_rust_emit_constant_payload_field(ctx: &JetRustEmitContext, definition: MIRTypeDef?, type_name: String, variant: String, field_name: String) -> String Never! {
    if definition == Val(resolved) {
        if resolved.kind == .Enum(variants, _) {
            loop candidate in variants {
                if candidate.name != variant -> next
                if candidate.payload == .Named(fields) {
                    loop field in fields { if field.name == field_name -> return jet_rust_emit_field_name(&ctx, field.id) }
                }
            }
        }
    }
    if jet_rust_emit_has_native_type_projection(type_name) -> ~field_name else -> jet_rust_emit_mangle(field_name)
}

// MIRRust Fraction constant: one exact-Int part of an intrinsic ratio.
fn jet_rust_emit_fraction_part(ctx: &JetRustEmitContext, fields: [MIRConstField], name: String) -> String Never! {
    int_ty :: MIRType{kind: MIRTypeKind.Int, identity: None, layout: mir_type_layout(MIRTypeKind.Int)}
    loop field in fields {
        if field.name == name -> return jet_rust_emit_constant(&ctx, field.value, int_ty)
    }
    jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR Fraction constant is missing a part", "a folded Fraction carries both an exact-Int numerator and denominator", None)
    "unreachable!(\"MIR Fraction part\")"
}

// MIRRust `(value as u64)`: an unsigned literal spells its two's-complement word.
fn jet_rust_emit_unsigned_literal(value: Int) -> String Never! {
    if value < 0 -> "{value + 18446744073709551616}" else -> "{value}"
}

// MIRRust constant: a spelling-less NaN or infinity has no numeric literal, so it
// takes the Rust associated constant of its width.
fn jet_rust_emit_float_literal(value: Float, f32: Bool) -> String Never! {
    width :: if f32 -> "f32" else -> "f64"
    if value != value -> return "{width}::NAN"
    if value * 0.0 != 0.0 -> return if value > 0.0 -> "{width}::INFINITY" else -> "{width}::NEG_INFINITY"
    "{value}{width}"
}

fn jet_rust_emit_constant(ctx: &JetRustEmitContext, constant: MIRConstant, ty: MIRType) -> String Never! {
    if ty.kind == {
        .InlineRange(base, _, _) | .Tagged(_, base) | .Quantity(base, _) -> return jet_rust_emit_constant(&ctx, constant, base)
        else -> {}
    }
    if constant == {
        .Int(value, width, spelling) -> {
            if ty.kind == {
                .Int -> return "jet_foundation::Numeric::JetInt::from_i64({value})"
                .IntN(signed, bits) -> {
                    text :: if signed -> "{value}" else -> jet_rust_emit_unsigned_literal(value)
                    return "{text}{if signed -> "i" else -> "u"}{bits}"
                }
                else -> {}
            }
            if width == .Val(width_value) {
                raw :: if width_value.signed -> spelling ?? "{value}" else -> jet_rust_emit_unsigned_literal(value)
                return "{raw}{if width_value.signed -> "i" else -> "u"}{width_value.bits}"
            }
            spelling ?? "{value}"
        }
        .Float(value, f32, spelling) -> spelling ?? jet_rust_emit_float_literal(value, f32)
        .Bool(value) -> if value -> "true" else -> "false"
        .Char(value) -> jet_rust_emit_char_literal(value)
        .String(value) -> if jet_rust_emit_is_core_layer(&ctx) -> jet_rust_emit_quote(value) else -> "{jet_rust_emit_quote(value)}.to_string()"
        .Bytes(values) -> {
            rendered := [String]{}
            loop value in values -> &rendered.push("{Int.from_u8(value)}")
            "vec![{rendered.join(", ")}]"
        }
        .Unit -> "()"
        .BigInt(value) -> {
            if ty.kind == {
                .IntN(signed, bits) -> return "{value}{if signed -> "i" else -> "u"}{bits}"
                else -> {}
            }
            "{ctx.config.root_prefix}jet_std::jet_int_owned_from_str({jet_rust_emit_quote(value)}).expect(\"MIR Int\")"
        }
        .List(values) -> {
            element :: jet_rust_emit_constant_inner_type(ty, 0)
            rendered := [String]{}
            loop value in values -> &rendered.push(jet_rust_emit_constant(&ctx, value, element))
            if ty.kind == {
                .FixedList(_, _) -> "[{rendered.join(", ")}]"
                else -> "vec![{rendered.join(", ")}]"
            }
        }
        .Map(entries) -> {
            key_ty :: jet_rust_emit_constant_inner_type(ty, 0)
            value_ty :: jet_rust_emit_constant_inner_type(ty, 1)
            typed :: if ty.kind == {
                .Map(_, _) -> true
                else -> false
            }
            rendered := [String]{}
            loop entry in entries {
                key :: if entry.key == {
                    .Int(literal) -> if typed -> jet_rust_emit_constant(&ctx, MIRConstant.Int{value: literal, width: None, spelling: None}, key_ty) else -> jet_rust_emit_const_key(&ctx, entry.key)
                    else -> jet_rust_emit_const_key(&ctx, entry.key)
                }
                &rendered.push("({key}, {jet_rust_emit_constant(&ctx, entry.value, value_ty)})")
            }
            collected :: if typed -> jet_rust_emit_type(&ctx, ty) else -> "{ctx.config.root_prefix}JetMap<_,_>"
            "[{rendered.join(", ")}].into_iter().collect::<{collected}>()"
        }
        .Struct(type_name, fields) -> {
            definition :: jet_rust_emit_constant_type_definition(&ctx, type_name, ty)
            // MIRRust constant: an intrinsic Fraction with no declaration row
            // takes the native constructor over its exact-Int parts.
            if definition == None && type_name == "Fraction" && ctx.type_by_name.get(type_name) == None {
                return "{ctx.config.root_prefix}jet_fraction_from_parts({jet_rust_emit_fraction_part(&ctx, fields, "numerator")}, {jet_rust_emit_fraction_part(&ctx, fields, "denominator")})"
            }
            owner :: jet_rust_emit_constant_owner(&ctx, type_name, definition)
            rendered := [String]{}
            loop field in fields {
                field_ty :: jet_rust_emit_constant_field_type(&ctx, definition, field.name, ty)
                value := jet_rust_emit_constant(&ctx, field.value, field_ty)
                if jet_rust_emit_constant_edge_boxed(definition, field.name) -> value = "Box::new({value})"
                &rendered.push("{jet_rust_emit_named_field(&ctx, owner, field.name)}: {value}")
            }
            "{jet_rust_emit_named_type(&ctx, owner)} {{ {rendered.join(", ")} }}"
        }
        // MIRRust typed_enum_constant: named payloads keep their field names,
        // positional payloads stay positional; boxed edges allocate.
        .Enum(type_name, variant, args) -> {
            definition :: jet_rust_emit_constant_type_definition(&ctx, type_name, ty)
            path :: jet_rust_emit_variant_symbol(&ctx, definition, type_name, variant)
            if args.len() == 0 -> return path
            named := 0
            loop arg in args { if arg.name != None -> named += 1 }
            if named != 0 && named != args.len() {
                jet_rust_emit_fail(&ctx, JetRustEmitFailureKind.InvalidSchema, "E0003", "MIR enum constant mixes named and positional payloads", "a folded enum payload is either all named or all positional", None)
                return path
            }
            rendered := [String]{}
            loop (index, arg) in args {
                payload_ty :: jet_rust_emit_constant_payload_type(&ctx, definition, variant, index, arg.name, ty)
                value := jet_rust_emit_constant(&ctx, arg.value, payload_ty)
                if arg.name == .Val(field) {
                    if jet_rust_emit_constant_edge_boxed(definition, "{variant}.{field}") -> value = "Box::new({value})"
                    &rendered.push("{jet_rust_emit_constant_payload_field(&ctx, definition, type_name, variant, field)}: {value}")
                } else {
                    if jet_rust_emit_constant_edge_boxed(definition, variant) -> value = "Box::new({value})"
                    &rendered.push(value)
                }
            }
            if named != 0 -> "{path} {{ {rendered.join(", ")} }}" else -> "{path}({rendered.join(", ")})"
        }
        .Present(value) -> "Ok({jet_rust_emit_constant(&ctx, value, jet_rust_emit_constant_inner_type(ty, 0))})"
        .Failed(report) -> {
            if report == {
                .Told(value) -> "Err({jet_rust_emit_constant(&ctx, value, jet_rust_emit_constant_inner_type(ty, 1))})"
                .Clean(_) -> "Err({ctx.config.root_prefix}JetAbsent)"
            }
        }
    }
}

// MIRRust const_key: a map key literal; nominal keys take the emitted type
// and mangled member names (native carriers keep their Prelude spelling).
fn jet_rust_emit_const_key(ctx: &JetRustEmitContext, key: MIRConstKey) -> String Never! {
    if key == {
        .Int(value) -> "{value}"
        .String(value) -> if jet_rust_emit_is_core_layer(&ctx) -> jet_rust_emit_quote(value) else -> "{jet_rust_emit_quote(value)}.to_string()"
        .Bool(value) -> if value -> "true" else -> "false"
        .Char(value) -> jet_rust_emit_char_literal(value)
        .Tuple(fields) -> {
            values := [String]{}
            loop field in fields -> &values.push(jet_rust_emit_const_key(&ctx, field.key))
            "({values.join(", ")})"
        }
        .Struct(type_name, fields) -> {
            native :: jet_rust_emit_has_native_type_projection(type_name)
            values := [String]{}
            loop field in fields -> &values.push("{if native -> field.name else -> jet_rust_emit_mangle(field.name)}: {jet_rust_emit_const_key(&ctx, field.key)}")
            "{jet_rust_emit_named_type(&ctx, type_name)} {{ {values.join(", ")} }}"
        }
        .Enum(type_name, variant) -> "{jet_rust_emit_named_type(&ctx, type_name)}::{if jet_rust_emit_has_native_type_projection(type_name) -> variant else -> jet_rust_emit_mangle_variant(variant)}"
    }
}

// ---- Core native carriers (MIRRust core_native_probe_name, has_native_type_projection,
// rust_apply_type; Context.rs root_prelude/core/file/net/compute/service tables) -------

// Context.rs core_source_type_leaf: a canonical `<corelib>/...::Leaf` identity reduces
// to its leaf; any other spelling stays intact.
fn jet_rust_emit_core_source_type_leaf(name: String) -> String Never! {
    if !name.starts_with("<corelib>/") -> return ~name
    parts :: name.split("::").to_list()
    parts[parts.len() - 1]
}

// The leaf of a bare or `core`-qualified name; None for any other qualified name
// (Context.rs `rsplit_once("::").or_else(rsplit_once('.'))` prefix rule).
fn jet_rust_emit_core_qualified_leaf(name: String) -> String? {
    separator :: if name.contains("::") -> "::" else -> "."
    parts :: name.split(separator).to_list()
    if parts.len() < 2 -> return Val(~name)
    if !name.starts_with("core.") && !name.starts_with("core::") -> return None
    Val(parts[parts.len() - 1])
}

// The leaf of a bare name or of a name qualified by exactly one of `owners`.
fn jet_rust_emit_qualified_leaf_under(name: String, owners: [String]) -> String? {
    separator :: if name.contains("::") -> "::" else -> "."
    parts :: name.split(separator).to_list()
    if parts.len() < 2 -> return Val(~name)
    leaf :: parts[parts.len() - 1]
    loop owner in owners {
        expected :: "{owner}{separator}{leaf}"
        if name == expected -> return Val(leaf)
    }
    None
}

fn jet_rust_emit_source_owned_core_shape(name: String) -> Bool Never! {
    if name.starts_with("<corelib>/Core/compute::") -> return true
    if !name.starts_with("<corelib>/") -> return false
    leaf :: jet_rust_emit_core_source_type_leaf(name)
    net_shapes :: [String]{"SocketAddr", "UDPSocket", "UDPPacket", "UnixStream", "UnixListener", "SRVRecord"}
    if name.starts_with("<corelib>/Core/net::") && net_shapes.contains(leaf) -> return true
    if name.starts_with("<corelib>/Core/net/tls::") && (leaf == "TLSCertificate" || leaf == "TLSPeerIdentity") -> return true
    name.starts_with("<corelib>/Core/web::Core/web/query.jet::") && (leaf == "WebQuery" || leaf == "WebQueryState" || leaf == "WebMutationState")
}

fn jet_rust_emit_core_native_probe_name(name: String) -> String Never! {
    if (name.starts_with("<corelib>/Core/sync::") && name.ends_with("::RowPolicy")) || jet_rust_emit_source_owned_core_shape(name) -> return ~name
    jet_rust_emit_core_source_type_leaf(name)
}

