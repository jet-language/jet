        "NullBackend" -> Val("JetNullBackend")
        "TUIBackend" -> Val("JetTuiBackend")
        "GtkBackend" -> Val("JetGtkBackend")
        "Session" -> Val("JetAuthSession")
        "Auth" -> Val("JetAuthApp")
