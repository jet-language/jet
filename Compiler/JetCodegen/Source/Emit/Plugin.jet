// D-PLUGIN1=B / D-DEP-WASM1=A / D-PLUGIN-EXPORT1=A: the `target: sandbox`
// guest artifact producer (the Jet port of the Rust Codegen Plugin.rs). The
// checked MIR artifact plan owns the package identity and export rows, and
// each export row's Component signature is the shared MIR export law
// (`mir_component_export_signature`); this module only renders the guest WIT
// world and the canonical-ABI wrapper text around the whole-program Rust the
// emitter already produced. It never reads source AST or reconstructs
// visibility from public functions.
use jet_foundation.[
    name_mangle,
    MIRArtifactID,
    MIRArtifactKind,
    MIRArtifactPlan,
    MIRArtifactTarget,
    MIRComponentSignatureDescriptor,
    MIRComponentTypeDescriptor,
    MIRComponentTypeField,
    MIRFunction,
    MIRProgram,
    MIRType,
    MIRTypeKind,
    mir_c_export_result,
    mir_component_export_signature,
]

// The guest-side artifacts of a `target: sandbox` build.
struct JetPluginArtifacts {
    // The full `.wit` world text (`package jet:<name>@0.1.0; world jetplugin { … }`).
    wit: String
    // The whole-program Rust plus the canonical-ABI export wrappers, ready for
    // `rustc --target wasm32-unknown-unknown --crate-type cdylib`.
    guest_rust: String
    // The fixed `.wit` world name.
    world_name: String
    // The sanitized artifact-plan name used as the WIT package identity.
    export_name: String
    // The Jet names of every exported function, in export-row order.
    exported_fns: [String]
}

enum JetPluginEmitResult {
    Complete(artifacts: JetPluginArtifacts)
    Incomplete(failure: JetRustEmitFailure)
}

// Every sandbox uses the one fixed world; only the package identity varies
// (D-PLUGIN-EXPORT1=A adds no in-source keyword to name it).
JET_PLUGIN_WORLD_NAME :: "jetplugin"

// One core wasm value slot of the canonical ABI's flattened form.
enum JetPluginCoreSlot { I32 I64 F64 }

struct JetPluginLayout { size: Int, align: Int }

fn jet_plugin_slot_rust(slot: JetPluginCoreSlot) -> String Never! {
    if slot == {
        .I32 -> "i32"
        .I64 -> "i64"
        .F64 -> "f64"
    }
}

// `snake_case` -> `kebab-case`, the Component Model identifier shape. Jet
// function names are ASCII identifiers, so the swap is exact and total.
fn jet_plugin_kebab(name: String) -> String Never! {
    name.replace("_", "-")
}

// A valid WIT package segment: lowercase ASCII alphanumerics joined by single
// `-`, starting with a letter.
fn jet_plugin_sanitize_package_name(name: String) -> String Never! {
    out := [U8]{}
    loop byte in name.bytes() {
        digit :: byte >= 48 && byte <= 57
        lower :: byte >= 97 && byte <= 122
        upper :: byte >= 65 && byte <= 90
        if {
            digit || lower -> &out.push(byte)
            upper -> &out.push(U8{Int.from_u8(byte) + 32})
            out.len() > 0 && out[out.len() - 1] != 45 -> &out.push(45)
            else -> {}
        }
    }
    loop out.len() > 0 && out[out.len() - 1] == 45 -> _ := &out.pop()
    text :: String.from_bytes(out) ?? ""
    if text == "" -> return "plugin-export"
    first :: out[0]
    if !(first >= 97 && first <= 122) -> return "plugin-{text}"
    text
}

// A generated helper's name; the helpers live in the guest crate itself.
fn jet_plugin_generated(stem: String) -> String Never! {
    name_mangle("__plugin_{stem}")
}

fn jet_plugin_merge_slot(left: JetPluginCoreSlot, right: JetPluginCoreSlot) -> JetPluginCoreSlot Never! {
    if left == right -> return left.copy()
    JetPluginCoreSlot.I64
}

fn jet_plugin_merge_slots(left: [JetPluginCoreSlot], right: [JetPluginCoreSlot]) -> [JetPluginCoreSlot] Never! {
    merged := [JetPluginCoreSlot]{}
    length :: if left.len() > right.len() -> left.len() else -> right.len()
    loop index in 0..<length {
        if {
            index < left.len() && index < right.len() -> &merged.push(jet_plugin_merge_slot(left[index], right[index]))
            index < left.len() -> &merged.push(left[index])
            else -> &merged.push(right[index])
        }
    }
    merged
}

fn jet_plugin_flat_slots(ty: MIRComponentTypeDescriptor) -> [JetPluginCoreSlot] Never! {
    if ty == {
        .Int -> [JetPluginCoreSlot]{JetPluginCoreSlot.I64}
        .Float -> [JetPluginCoreSlot]{JetPluginCoreSlot.F64}
        .Bool -> [JetPluginCoreSlot]{JetPluginCoreSlot.I32}
        .String | .List(_) -> [JetPluginCoreSlot]{JetPluginCoreSlot.I32, JetPluginCoreSlot.I32}
        .Option(inner) -> {
            slots := [JetPluginCoreSlot]{JetPluginCoreSlot.I32}
            loop slot in jet_plugin_flat_slots(inner) -> &slots.push(slot)
            slots
        }
        .Result(ok, err) -> {
            slots := [JetPluginCoreSlot]{JetPluginCoreSlot.I32}
            loop slot in jet_plugin_merge_slots(jet_plugin_flat_slots(ok), jet_plugin_flat_slots(err)) -> &slots.push(slot)
            slots
        }
        .Record(_, fields) -> {
            slots := [JetPluginCoreSlot]{}
            loop field in fields {
                loop slot in jet_plugin_flat_slots(field.ty) -> &slots.push(slot)
            }
            slots
        }
    }
}

fn jet_plugin_align_to(value: Int, align: Int) -> Int Never! {
    ((value + align - 1) /% align) * align
}

fn jet_plugin_max(left: Int, right: Int) -> Int Never! {
    if left > right -> left else -> right
}

fn jet_plugin_memory_layout(ty: MIRComponentTypeDescriptor) -> JetPluginLayout Never! {
    if ty == {
        .Int | .Float -> JetPluginLayout{size: 8, align: 8}
        .Bool -> JetPluginLayout{size: 1, align: 1}
        .String | .List(_) -> JetPluginLayout{size: 8, align: 4}
        .Option(inner) -> {
            layout :: jet_plugin_memory_layout(inner)
            payload :: jet_plugin_align_to(1, layout.align)
            JetPluginLayout{size: jet_plugin_align_to(payload + layout.size, layout.align), align: layout.align}
        }
        .Result(ok, err) -> {
            ok_layout :: jet_plugin_memory_layout(ok)
            err_layout :: jet_plugin_memory_layout(err)
            align :: jet_plugin_max(ok_layout.align, err_layout.align)
            payload :: jet_plugin_align_to(1, align)
            JetPluginLayout{size: jet_plugin_align_to(payload + jet_plugin_max(ok_layout.size, err_layout.size), align), align: align}
        }
        .Record(_, fields) -> jet_plugin_sequence_layout((loop field in fields -> field.ty))
    }
}

fn jet_plugin_sequence_layout(types: [MIRComponentTypeDescriptor]) -> JetPluginLayout Never! {
    size := 0
    align := 1
    loop ty in types {
        layout :: jet_plugin_memory_layout(ty)
        size = jet_plugin_align_to(size, layout.align) + layout.size
        align = jet_plugin_max(align, layout.align)
    }
    JetPluginLayout{size: jet_plugin_align_to(size, align), align: align}
}

fn jet_plugin_record_offsets(fields: [MIRComponentTypeField]) -> [Int] Never! {
    offsets := [Int]{}
    offset := 0
    loop field in fields {
        layout :: jet_plugin_memory_layout(field.ty)
        offset = jet_plugin_align_to(offset, layout.align)
        &offsets.push(offset)
        offset += layout.size
    }
    offsets
}

fn jet_plugin_payload_offset(ty: MIRComponentTypeDescriptor) -> Int Never! {
    if ty == {
        .Option(inner) -> jet_plugin_align_to(1, jet_plugin_memory_layout(inner).align)
        .Result(ok, err) -> jet_plugin_align_to(1, jet_plugin_max(jet_plugin_memory_layout(ok).align, jet_plugin_memory_layout(err).align))
        else -> 0
    }
}

fn jet_plugin_needs_post_return(ty: MIRComponentTypeDescriptor) -> Bool Never! {
    if ty == {
        .String | .List(_) -> true
        .Option(inner) -> jet_plugin_needs_post_return(inner)
        .Result(ok, err) -> jet_plugin_needs_post_return(ok) || jet_plugin_needs_post_return(err)
        .Record(_, fields) -> {
            loop field in fields {
                if jet_plugin_needs_post_return(field.ty) -> return true
            }
            false
        }
        else -> false
    }
}

fn jet_plugin_fresh(counter: &Int, stem: String) -> String Never! {
    value :: "__jet_plugin_{stem}_{counter}"
    counter += 1
    value
}

fn jet_plugin_offset_ptr(ptr: String, offset: Int) -> String Never! {
    "(({ptr}) as usize + {offset}) as i32"
}

fn jet_plugin_read_memory(ptr: String, offset: Int, rust_ty: String) -> String Never! {
    "unsafe {{ std::ptr::read_unaligned((({ptr}) as usize + {offset}) as *const {rust_ty}) }}"
}

fn jet_plugin_write_memory(ptr: String, offset: Int, rust_ty: String, value: String) -> String Never! {
    "unsafe {{ std::ptr::write_unaligned((({ptr}) as usize + {offset}) as *mut {rust_ty}, {value}); }}"
}

fn jet_plugin_result_types(ty: MIRType) -> [MIRType] Never! {
    if ty.kind == .Result(ok, err) -> return [MIRType]{ok, err}
    panic("checked Component result has a non-Result MIR carrier")
}

// A Jet `Int` is the exact runtime integer; the Component boundary carries s64.
fn jet_plugin_int_from_s64(ctx: &JetRustEmitContext, raw: String) -> String Never! {
    "{ctx.config.root_prefix}jet_std::jet_int_owned_from_i64(({raw}) as i64)"
}

fn jet_plugin_int_to_s64(ctx: &JetRustEmitContext, reference: String) -> String Never! {
    "{ctx.config.root_prefix}jet_std::jet_int_owned_to_i64({reference}).expect(\"sandbox Int exceeds the Component s64 range\")"
}

fn jet_plugin_bool_from(raw: String, float_slot: Bool) -> String Never! {
    if float_slot -> return "match {raw} {{ 0.0 => false, 1.0 => true, _ => panic!(\"invalid canonical bool\") }}"
    "match {raw} {{ 0 => false, 1 => true, _ => panic!(\"invalid canonical bool\") }}"
}

// Rebuild a lifted list in its checked carrier: a fixed list checks its
// length, a columnar list rebuilds its columns, a plain list is the Vec.
fn jet_plugin_list_carrier(ctx: &JetRustEmitContext, source: MIRType, output: String) -> String Never! {
    ty :: jet_rust_emit_plugin_type(&ctx, source)
    if ty.kind == {
        .FixedList(_, _) -> return "let {output}: {jet_rust_emit_type(&ctx, ty)} = match {output}.try_into() {{ Ok(value) => value, Err(_) => panic!(\"canonical list length mismatch\") }}; {output}"
        .List(element) -> {
            if jet_rust_emit_is_columnar_type(&ctx, element) -> return "<{jet_rust_emit_type(&ctx, ty)}>::from_aos({output})"
        }
        else -> {}
    }
    output.copy()
}

// The element sequence of a list carrier, borrowed for lowering.
fn jet_plugin_list_items(ctx: &JetRustEmitContext, source: MIRType, value: String) -> String Never! {
    ty :: jet_rust_emit_plugin_type(&ctx, source)
    if ty.kind == .List(element) {
        if jet_rust_emit_is_columnar_type(&ctx, element) -> return "({value}).to_aos()"
    }
    "({value})"
}

fn jet_plugin_record_value(ctx: &JetRustEmitContext, source: MIRType, component_fields: [MIRComponentTypeField], values: [String]) -> String Never! {
    ty :: jet_rust_emit_plugin_type(&ctx, source)
    declared :: jet_rust_emit_plugin_record_fields(&ctx, ty)
    assignments := [String]{}
    loop index in 0..<declared.len() {
        field :: declared[index]
        if field.computed -> next
        value := "Default::default()"
        loop position in 0..<component_fields.len() {
            if component_fields[position].index == index -> value = values[position]
        }
        &assignments.push("{jet_rust_emit_field_name(&ctx, field.id)}: {value}")
    }
    "{jet_rust_emit_type(&ctx, ty)} {{ {jet_rust_emit_record_type_phantom_initializer(&ctx, ty)}{assignments.join(", ")} }}"
}

fn jet_plugin_record_field_value(ctx: &JetRustEmitContext, source: MIRType, component_field: MIRComponentTypeField, value: String) -> String Never! {
    declared :: jet_rust_emit_plugin_record_fields(&ctx, source)
    field :: jet_rust_emit_plugin_field(declared, component_field)
    "({value}).{jet_rust_emit_field_name(&ctx, field.id)}"
}

fn jet_plugin_record_field_type(ctx: &JetRustEmitContext, source: MIRType, component_field: MIRComponentTypeField) -> MIRType Never! {
    declared :: jet_rust_emit_plugin_record_fields(&ctx, source)
    jet_rust_emit_plugin_field(declared, component_field).ty
}

// Lift one value from the flattened core arguments `args[cursor..]`.
fn jet_plugin_flat_lift(ctx: &JetRustEmitContext, source: MIRType, descriptor: MIRComponentTypeDescriptor, args: [String], slots: [JetPluginCoreSlot], cursor: &Int, counter: &Int, read_text: String) -> String Never! {
    ty :: jet_rust_emit_plugin_type(&ctx, source)
    if descriptor == {
        .Int -> {
            raw :: args[cursor]
            cursor += 1
            return jet_plugin_int_from_s64(&ctx, raw)
        }
        .Float -> {
            raw :: args[cursor]
            slot :: slots[cursor]
            cursor += 1
            if slot == JetPluginCoreSlot.F64 -> return raw
            return "f64::from_bits(({raw}) as u64)"
        }
        .Bool -> {
            raw :: args[cursor]
            slot :: slots[cursor]
            cursor += 1
            return jet_plugin_bool_from(raw, slot == JetPluginCoreSlot.F64)
        }
        .String -> {
            ptr :: args[cursor]
            len :: args[cursor + 1]
            cursor += 2
            return "{read_text}(({ptr}) as i32, ({len}) as i32)"
        }
        .List(inner) -> {
            ptr :: args[cursor]
            len :: args[cursor + 1]
            cursor += 2
            return jet_plugin_lift_list(&ctx, ty, inner, ptr, len, &counter, read_text)
        }
        .Option(inner) -> {
            selector :: args[cursor]
            cursor += 1
            payload_start :: cursor
            child :: jet_plugin_flat_lift(&ctx, jet_rust_emit_plugin_inner(ty), inner, args, slots, &cursor, &counter, read_text)
            cursor = payload_start + jet_plugin_flat_slots(inner).len()
            return "{{ match {selector} {{ 0 => Err({ctx.config.root_prefix}JetAbsent), 1 => Ok({child}), _ => panic!(\"invalid canonical option discriminant\") }} }}"
        }
        .Result(ok, err) -> {
            selector :: args[cursor]
            cursor += 1
            payload_start :: cursor
            sources :: jet_plugin_result_types(ty)
            ok_cursor := payload_start
            ok_value :: jet_plugin_flat_lift(&ctx, sources[0], ok, args, slots, &ok_cursor, &counter, read_text)
            err_cursor := payload_start
            err_value :: jet_plugin_flat_lift(&ctx, sources[1], err, args, slots, &err_cursor, &counter, read_text)
            cursor = payload_start + jet_plugin_merge_slots(jet_plugin_flat_slots(ok), jet_plugin_flat_slots(err)).len()
            return "{{ match {selector} {{ 0 => Ok({ok_value}), 1 => Err({err_value}), _ => panic!(\"invalid canonical result discriminant\") }} }}"
        }
        .Record(_, fields) -> {
            values := [String]{}
            loop field in fields {
                field_type :: jet_plugin_record_field_type(&ctx, ty, field)
                &values.push(jet_plugin_flat_lift(&ctx, field_type, field.ty, args, slots, &cursor, &counter, read_text))
            }
            return jet_plugin_record_value(&ctx, ty, fields, values)
        }
    }
}

fn jet_plugin_lift_list(ctx: &JetRustEmitContext, ty: MIRType, inner: MIRComponentTypeDescriptor, ptr: String, len: String, counter: &Int, read_text: String) -> String Never! {
    base :: jet_plugin_fresh(&counter, "list_base")
    length :: jet_plugin_fresh(&counter, "list_len")
    output :: jet_plugin_fresh(&counter, "list_out")
    index :: jet_plugin_fresh(&counter, "list_index")
    element_ptr :: jet_plugin_fresh(&counter, "list_element_ptr")
    element :: jet_plugin_memory_lift(&ctx, jet_rust_emit_plugin_inner(ty), inner, element_ptr, &counter, read_text)
    carrier :: jet_plugin_list_carrier(&ctx, ty, output)
    "{{ let {base} = ({ptr}) as usize; let {length} = ({len}) as usize; let mut {output} = Vec::with_capacity({length}); for {index} in 0..{length} {{ let {element_ptr} = ({base} + {index} * {jet_plugin_memory_layout(inner).size}) as i32; {output}.push({element}); }} {carrier} }}"
}

// Lift one value stored in linear memory at `ptr`.
fn jet_plugin_memory_lift(ctx: &JetRustEmitContext, source: MIRType, descriptor: MIRComponentTypeDescriptor, ptr: String, counter: &Int, read_text: String) -> String Never! {
    ty :: jet_rust_emit_plugin_type(&ctx, source)
    if descriptor == {
        .Int -> return jet_plugin_int_from_s64(&ctx, jet_plugin_read_memory(ptr, 0, "i64"))
        .Float -> return jet_plugin_read_memory(ptr, 0, "f64")
        .Bool -> return jet_plugin_bool_from(jet_plugin_read_memory(ptr, 0, "u8"), false)
        .String -> return "{read_text}({jet_plugin_read_memory(ptr, 0, "i32")}, {jet_plugin_read_memory(ptr, 4, "i32")})"
        .List(inner) -> return jet_plugin_lift_list(&ctx, ty, inner, jet_plugin_read_memory(ptr, 0, "i32"), jet_plugin_read_memory(ptr, 4, "i32"), &counter, read_text)
        .Option(inner) -> {
            child :: jet_plugin_memory_lift(&ctx, jet_rust_emit_plugin_inner(ty), inner, jet_plugin_offset_ptr(ptr, jet_plugin_payload_offset(descriptor)), &counter, read_text)
            return "{{ match {jet_plugin_read_memory(ptr, 0, "u8")} {{ 0 => Err({ctx.config.root_prefix}JetAbsent), 1 => Ok({child}), _ => panic!(\"invalid canonical option discriminant\") }} }}"
        }
        .Result(ok, err) -> {
            sources :: jet_plugin_result_types(ty)
            payload :: jet_plugin_offset_ptr(ptr, jet_plugin_payload_offset(descriptor))
            ok_value :: jet_plugin_memory_lift(&ctx, sources[0], ok, payload, &counter, read_text)
            err_value :: jet_plugin_memory_lift(&ctx, sources[1], err, payload, &counter, read_text)
            return "{{ match {jet_plugin_read_memory(ptr, 0, "u8")} {{ 0 => Ok({ok_value}), 1 => Err({err_value}), _ => panic!(\"invalid canonical result discriminant\") }} }}"
        }
        .Record(_, fields) -> {
            offsets :: jet_plugin_record_offsets(fields)
            values := [String]{}
            loop position in 0..<fields.len() {
                field :: fields[position]
                field_type :: jet_plugin_record_field_type(&ctx, ty, field)
                &values.push(jet_plugin_memory_lift(&ctx, field_type, field.ty, jet_plugin_offset_ptr(ptr, offsets[position]), &counter, read_text))
            }
            return jet_plugin_record_value(&ctx, ty, fields, values)
        }
    }
}

// Lower one single-slot result value; `value` is a reference expression.
fn jet_plugin_flat_lower(ctx: &JetRustEmitContext, source: MIRType, descriptor: MIRComponentTypeDescriptor, value: String) -> String Never! {
    ty :: jet_rust_emit_plugin_type(&ctx, source)
    if descriptor == {
        .Int -> return jet_plugin_int_to_s64(&ctx, value)
        .Float -> return "*({value})"
        .Bool -> return "if *({value}) {{ 1i32 }} else {{ 0i32 }}"
        .Record(_, fields) -> {
            if fields.len() == 0 -> panic("a zero-slot Component record has no flat result")
            field :: fields[0]
            field_type :: jet_plugin_record_field_type(&ctx, ty, field)
            field_value :: jet_plugin_record_field_value(&ctx, ty, field, value)
            return jet_plugin_flat_lower(&ctx, field_type, field.ty, "&{field_value}")
        }
        .Option(inner) -> {
            if jet_plugin_flat_slots(inner).len() != 0 -> panic("a multi-slot Component option has no flat result")
            return "match {value} {{ Ok(_) => 1i32, Err(_) => 0i32 }}"
        }
        .Result(ok, err) -> {
            if jet_plugin_flat_slots(ok).len() != 0 || jet_plugin_flat_slots(err).len() != 0 -> panic("a multi-slot Component result has no flat result")
            return "match {value} {{ Ok(_) => 0i32, Err(_) => 1i32 }}"
        }
        .String | .List(_) -> panic("a multi-slot Component value has no flat result")
    }
}

// Store one value (a reference expression) into linear memory at `ptr`.
fn jet_plugin_memory_lower(ctx: &JetRustEmitContext, source: MIRType, descriptor: MIRComponentTypeDescriptor, value: String, ptr: String, counter: &Int, allocator: String) -> String Never! {
    ty :: jet_rust_emit_plugin_type(&ctx, source)
    if descriptor == {
        .Int -> return jet_plugin_write_memory(ptr, 0, "i64", jet_plugin_int_to_s64(&ctx, value))
        .Float -> return jet_plugin_write_memory(ptr, 0, "f64", "*({value})")
        .Bool -> return jet_plugin_write_memory(ptr, 0, "u8", "if *({value}) {{ 1u8 }} else {{ 0u8 }}")
        .String -> {
            bytes :: jet_plugin_fresh(&counter, "string_bytes")
            length :: jet_plugin_fresh(&counter, "string_len")
            data :: jet_plugin_fresh(&counter, "string_data")
            statements :: [String]{
                "let {bytes} = ({value}).as_bytes();",
                "let {length} = {bytes}.len();",
                "let {data} = {allocator}(0, 0, 1, {length} as i32); if {data} == 0 && {length} != 0 {{ panic!(\"canonical string allocation failed\") }}",
                "if {length} != 0 {{ unsafe {{ std::ptr::copy_nonoverlapping({bytes}.as_ptr(), {data} as *mut u8, {length}); }} }}",
                jet_plugin_write_memory(ptr, 0, "i32", data),
                jet_plugin_write_memory(ptr, 4, "i32", "{length} as i32"),
            }
            return "{{ {statements.join(" ")} }}"
        }
        .List(inner) -> {
            layout :: jet_plugin_memory_layout(inner)
            items :: jet_plugin_fresh(&counter, "write_list_items")
            length :: jet_plugin_fresh(&counter, "write_list_len")
            bytes :: jet_plugin_fresh(&counter, "write_list_bytes")
            data :: jet_plugin_fresh(&counter, "write_list_data")
            index :: jet_plugin_fresh(&counter, "write_list_index")
            item :: jet_plugin_fresh(&counter, "write_list_item")
            element_ptr :: jet_plugin_fresh(&counter, "write_list_element_ptr")
            nested :: jet_plugin_memory_lower(&ctx, jet_rust_emit_plugin_inner(ty), inner, item, element_ptr, &counter, allocator)
            return "{{ let {items} = {jet_plugin_list_items(&ctx, ty, value)}; let {length} = {items}.len(); let {bytes} = {length}.checked_mul({layout.size}).expect(\"canonical list size overflow\"); let {data} = {allocator}(0, 0, {layout.align}, {bytes} as i32); if {data} == 0 && {bytes} != 0 {{ panic!(\"canonical list allocation failed\") }}; for ({index}, {item}) in {items}.iter().enumerate() {{ let {element_ptr} = ({data} as usize + {index} * {layout.size}) as i32; {nested} }} {jet_plugin_write_memory(ptr, 0, "i32", data)} {jet_plugin_write_memory(ptr, 4, "i32", "{length} as i32")} }}"
        }
        .Option(inner) -> {
            child :: jet_plugin_memory_lower(&ctx, jet_rust_emit_plugin_inner(ty), inner, "inner", jet_plugin_offset_ptr(ptr, jet_plugin_payload_offset(descriptor)), &counter, allocator)
            return "match {value} {{ Ok(inner) => {{ {jet_plugin_write_memory(ptr, 0, "u8", "1u8")} {child} }}, Err(_) => {{ {jet_plugin_write_memory(ptr, 0, "u8", "0u8")} }} }}"
        }
        .Result(ok, err) -> {
            sources :: jet_plugin_result_types(ty)
            payload :: jet_plugin_offset_ptr(ptr, jet_plugin_payload_offset(descriptor))
            ok_code :: jet_plugin_memory_lower(&ctx, sources[0], ok, "inner", payload, &counter, allocator)
            err_code :: jet_plugin_memory_lower(&ctx, sources[1], err, "inner", payload, &counter, allocator)
            return "match {value} {{ Ok(inner) => {{ {jet_plugin_write_memory(ptr, 0, "u8", "0u8")} {ok_code} }}, Err(inner) => {{ {jet_plugin_write_memory(ptr, 0, "u8", "1u8")} {err_code} }} }}"
        }
        .Record(_, fields) -> {
            offsets :: jet_plugin_record_offsets(fields)
            statements := [String]{}
            loop position in 0..<fields.len() {
                field :: fields[position]
                field_value :: jet_plugin_record_field_value(&ctx, ty, field, value)
                field_type :: jet_plugin_record_field_type(&ctx, ty, field)
                &statements.push(jet_plugin_memory_lower(&ctx, field_type, field.ty, "&{field_value}", jet_plugin_offset_ptr(ptr, offsets[position]), &counter, allocator))
            }
            return statements.join(" ")
        }
    }
}

// Release the canonical heap parts of one value stored at `ptr`.
fn jet_plugin_memory_free(descriptor: MIRComponentTypeDescriptor, ptr: String, counter: &Int, allocator: String) -> String Never! {
    if descriptor == {
        .Int | .Float | .Bool -> ""
        .String -> {
            data :: jet_plugin_fresh(&counter, "free_string_data")
            length :: jet_plugin_fresh(&counter, "free_string_len")
            "{{ let {data} = {jet_plugin_read_memory(ptr, 0, "i32")}; let {length} = {jet_plugin_read_memory(ptr, 4, "i32")}; if {data} != 0 && {length} != 0 {{ {allocator}({data}, {length}, 1, 0); }} }}"
        }
        .List(inner) -> {
            data :: jet_plugin_fresh(&counter, "free_list_data")
            length :: jet_plugin_fresh(&counter, "free_list_len")
            index :: jet_plugin_fresh(&counter, "free_list_index")
            element_ptr :: jet_plugin_fresh(&counter, "free_list_element_ptr")
            child :: jet_plugin_memory_free(inner, element_ptr, &counter, allocator)
            layout :: jet_plugin_memory_layout(inner)
            "{{ let {data} = {jet_plugin_read_memory(ptr, 0, "i32")}; let {length} = {jet_plugin_read_memory(ptr, 4, "i32")}; if {data} != 0 && {length} != 0 {{ for {index} in 0..({length} as usize) {{ let {element_ptr} = ({data} as usize + {index} * {layout.size}) as i32; {child} }} {allocator}({data}, ({length} as usize * {layout.size}) as i32, {layout.align}, 0); }} }}"
        }
        .Option(inner) -> {
            selector :: jet_plugin_fresh(&counter, "free_option_tag")
            child :: jet_plugin_memory_free(inner, jet_plugin_offset_ptr(ptr, jet_plugin_payload_offset(descriptor)), &counter, allocator)
            "{{ let {selector} = {jet_plugin_read_memory(ptr, 0, "u8")}; match {selector} {{ 0 => {{}}, 1 => {{ {child} }}, _ => panic!(\"invalid canonical option discriminant\") }} }}"
        }
        .Result(ok, err) -> {
            selector :: jet_plugin_fresh(&counter, "free_result_tag")
            payload :: jet_plugin_offset_ptr(ptr, jet_plugin_payload_offset(descriptor))
            ok_code :: jet_plugin_memory_free(ok, payload, &counter, allocator)
            err_code :: jet_plugin_memory_free(err, payload, &counter, allocator)
            "{{ let {selector} = {jet_plugin_read_memory(ptr, 0, "u8")}; match {selector} {{ 0 => {{ {ok_code} }}, 1 => {{ {err_code} }}, _ => panic!(\"invalid canonical result discriminant\") }} }}"
        }
        .Record(_, fields) -> {
            offsets :: jet_plugin_record_offsets(fields)
            statements := [String]{}
            loop position in 0..<fields.len() {
                freed :: jet_plugin_memory_free(fields[position].ty, jet_plugin_offset_ptr(ptr, offsets[position]), &counter, allocator)
                if freed != "" -> &statements.push(freed)
            }
            statements.join(" ")
        }
    }
}

// The WIT spelling of one Component shape; records name their own
// definitions, which `jet_plugin_wit_definitions` declares once each.
fn jet_plugin_wit_type(ty: MIRComponentTypeDescriptor) -> String Never! {
    if ty == {
        .Int -> "s64"
        .Float -> "f64"
        .Bool -> "bool"
        .String -> "string"
        .List(inner) -> "list<{jet_plugin_wit_type(inner)}>"
        .Option(inner) -> "option<{jet_plugin_wit_type(inner)}>"
        .Result(ok, err) -> "result<{jet_plugin_wit_type(ok)}, {jet_plugin_wit_type(err)}>"
        .Record(name, _) -> jet_plugin_kebab(jet_plugin_wit_identifier(name))
    }
}

// A Jet type or field name as a WIT identifier: `CamelCase` and `snake_case`
// both become lowercase kebab words.
fn jet_plugin_wit_identifier(name: String) -> String Never! {
    out := [U8]{}
    loop byte in name.bytes() {
        upper :: byte >= 65 && byte <= 90
        if upper && out.len() > 0 && out[out.len() - 1] != 45 -> &out.push(45)
        if {
            upper -> &out.push(U8{Int.from_u8(byte) + 32})
            byte == 95 -> {
                if out.len() > 0 && out[out.len() - 1] != 45 -> &out.push(45)
            }
            else -> &out.push(byte)
        }
    }
    String.from_bytes(out) ?? name
}

fn jet_plugin_wit_definitions(ty: MIRComponentTypeDescriptor, defined: &[String], definitions: &[String]) Never! {
    if ty == {
        .List(inner) | .Option(inner) -> jet_plugin_wit_definitions(inner, &defined, &definitions)
        .Result(ok, err) -> {
            jet_plugin_wit_definitions(ok, &defined, &definitions)
            jet_plugin_wit_definitions(err, &defined, &definitions)
        }
        .Record(name, fields) -> {
            loop field in fields -> jet_plugin_wit_definitions(field.ty, &defined, &definitions)
            wit_name :: jet_plugin_wit_type(ty)
            if defined.contains(wit_name) -> return
            &defined.push(wit_name)
            lines := [String]{"record {wit_name} {{"}
            loop field in fields -> &lines.push("  {jet_plugin_wit_identifier(field.name)}: {jet_plugin_wit_type(field.ty)},")
            &lines.push("}}")
            &definitions.push(lines.join("\n"))
        }
        else -> {}
    }
}

// The host operations named by the sandbox's checked `authority.needs`: a
// closed projection, so the world never grows an ambient import because a
// guest mentions a similarly named function.
fn jet_plugin_declared_host_imports(program: MIRProgram) -> [String] Never! {
    imports := [String]{}
    loop need in program.facts.authority_needs {
        root :: need.split(":").to_list()[0]
        if (root == "FS.Read" || root == "FS.Write" || root == "Net.Connect" || root == "Exec") && !imports.contains(root) -> &imports.push(root)
    }
    ordered := [String]{}
    order :: [String]{"Exec", "FS.Read", "FS.Write", "Net.Connect"}
    loop name in order {
        if imports.contains(name) -> &ordered.push(name)
    }
    ordered
}

fn jet_plugin_host_import_wit(import: String) -> String Never! {
    if import == {
        "FS.Read" -> "  import host-read: func(path: string) -> result<string, io-error>;"
        "FS.Write" -> "  import host-write: func(path: string, text: string) -> result<_, io-error>;"
        "Net.Connect" -> "  import host-connect: func(endpoint: string) -> bool;"
        "Exec" -> "  import host-exec: func(program: string, args: list<string>) -> string;"
        else -> ""
    }
}

// The canonical IOError Component types (variant order is Core IOError's).
fn jet_plugin_host_io_wit_definitions() -> String Never! {
    [String]{
        "enum io-operation {{", "  read,", "  write,", "  flush,", "  connect,", "  accept,", "  close,", "  resolve,", "  codec,", "}}",
        "record io-context {{", "  operation: io-operation,", "  resource: option<string>,", "  os-code: option<s64>,", "  cause: option<string>,", "}}",
        "enum process-resource-limit {{", "  wall-time,", "  cpu-time,", "  memory,", "  open-files,", "  output,", "}}",
        "variant io-error {{", "  invalid-input(io-context),", "  not-found(io-context),", "  permission-denied(io-context),", "  timed-out(io-context),", "  cancelled(io-context),", "  closed(io-context),", "  protocol(io-context),", "  other(io-context),", "  resource-limit(process-resource-limit),", "  already-exists(io-context),", "  unsupported(io-context),", "}}",
    }.join("\n")
}

// One sandbox export: lift the canonical arguments, call the checked
// function across the FFI callback boundary, exit through the entry error
// edge on failure, and lower the published result (flat for one slot,
// through a return area plus `cabi_post_` release otherwise).
fn jet_plugin_component_wrapper(ctx: &JetRustEmitContext, function: MIRFunction, symbol: String, descriptor: MIRComponentSignatureDescriptor) -> String Never! {
    root :: ctx.config.root_prefix.copy()
    allocator :: jet_plugin_generated("cabi_realloc_impl")
    read_text :: jet_plugin_generated("read_component_text")
    kebab :: jet_plugin_kebab(symbol)
    wrapper_name :: name_mangle("plugin_export_{function.name}")
    result_source :: mir_c_export_result(function) ?? panic("a checked sandbox export has no published result")
    parameter_slots := [JetPluginCoreSlot]{}
    loop ty in descriptor.params {
        loop slot in jet_plugin_flat_slots(ty) -> &parameter_slots.push(slot)
    }
    indirect :: parameter_slots.len() > 16
    counter := 0
    locals := [String]{}
    cleanup := [String]{}
    params_ptr :: "__jet_plugin_params_ptr"
    if indirect {
        offsets :: jet_plugin_record_offsets((loop ty in descriptor.params -> MIRComponentTypeField{index: 0, name: "", ty: ty}))
        loop index in 0..<descriptor.params.len() {
            value :: jet_plugin_memory_lift(&ctx, function.params[index].ty, descriptor.params[index], jet_plugin_offset_ptr(params_ptr, offsets[index]), &counter, read_text)
            mutable :: if function.params[index].access == .Write -> "mut " else -> ""
            &locals.push("let {mutable}p{index} = {value};")
        }
        loop index in 0..<descriptor.params.len() {
            freed :: jet_plugin_memory_free(descriptor.params[index], jet_plugin_offset_ptr(params_ptr, offsets[index]), &counter, allocator)
            if freed != "" -> &cleanup.push(freed)
        }
        layout :: jet_plugin_sequence_layout(descriptor.params)
        &cleanup.push("{allocator}({params_ptr}, {layout.size}i32, {layout.align}, 0);")
    } else {
        args := [String]{}
        loop index in 0..<parameter_slots.len() -> &args.push("a{index}")
        cursor := 0
        loop index in 0..<descriptor.params.len() {
            value :: jet_plugin_flat_lift(&ctx, function.params[index].ty, descriptor.params[index], args, parameter_slots, &cursor, &counter, read_text)
            mutable :: if function.params[index].access == .Write -> "mut " else -> ""
            &locals.push("let {mutable}p{index} = {value};")
        }
        if cursor != parameter_slots.len() -> panic("sandbox export lifting consumed the wrong number of core arguments")
    }
    call_args := [String]{}
    loop index in 0..<function.params.len() -> &call_args.push(jet_rust_emit_cli_owned_argument(function.params[index], "p{index}"))
    direct :: "{jet_rust_emit_function_name(&ctx, function.id)}({call_args.join(", ")})"
    call := if function.is_unsafe -> "unsafe {{ {direct} }}" else -> direct
    if function.failure == .Result(_, _) -> call = "match {call} {{ Ok(value) => value, Err(error) => {jet_rust_emit_entry_error_exit(&ctx, function, "error", false)} }}"
    result_slots :: jet_plugin_flat_slots(descriptor.result)
    header := "#[export_name = {jet_rust_emit_quote(kebab)}]\npub extern \"C\" fn {wrapper_name}("
    if indirect {
        header = "{header}{params_ptr}: i32"
    } else {
        rendered := [String]{}
        loop index in 0..<parameter_slots.len() -> &rendered.push("a{index}: {jet_plugin_slot_rust(parameter_slots[index])}")
        header = "{header}{rendered.join(", ")}"
    }
    header = "{header})"
    if {
        result_slots.len() == 0 -> header = "{header} {{ "
        result_slots.len() == 1 -> header = "{header} -> {jet_plugin_slot_rust(result_slots[0])} {{ "
        else -> header = "{header} -> i32 {{ "
    }
    body := "{header}{locals.join(" ")} let __jet_plugin_value = {root}jet_ffi_callback_boundary(|| {{ {call} }}); {cleanup.join(" ")}"
    if {
        result_slots.len() == 0 -> body = "{body} let _ = __jet_plugin_value; () }}"
        result_slots.len() == 1 -> body = "{body} {jet_plugin_flat_lower(&ctx, result_source, descriptor.result, "&__jet_plugin_value")} }}"
        else -> {
            layout :: jet_plugin_memory_layout(descriptor.result)
            lower :: jet_plugin_memory_lower(&ctx, result_source, descriptor.result, "&__jet_plugin_value", "__jet_plugin_ret_ptr", &counter, allocator)
            body = "{body} let __jet_plugin_ret_ptr = {allocator}(0, 0, {layout.align}, {layout.size}); if __jet_plugin_ret_ptr == 0 && {layout.size} != 0 {{ panic!(\"canonical component result allocation failed\") }} {lower} __jet_plugin_ret_ptr }}"
        }
    }
    body = "{body}\n"
    if result_slots.len() > 1 && jet_plugin_needs_post_return(descriptor.result) {
        layout :: jet_plugin_memory_layout(descriptor.result)
        freed :: jet_plugin_memory_free(descriptor.result, "ret_ptr", &counter, allocator)
        post_name :: name_mangle("plugin_post_{function.name}")
        body = "{body}#[export_name = {jet_rust_emit_quote("cabi_post_{kebab}")}]\npub extern \"C\" fn {post_name}(ret_ptr: i32) {{ if ret_ptr != 0 {{ {freed} {allocator}(ret_ptr, {layout.size}i32, {layout.align}, 0); }} }}\n"
    }
    body
}

// The canonical allocator and text helpers every Component export shares.
fn jet_plugin_text_helpers() -> String Never! {
    allocator :: jet_plugin_generated("cabi_realloc_impl")
    realloc :: jet_plugin_generated("cabi_realloc")
    read_component_text :: jet_plugin_generated("read_component_text")
    lines :: [String]{
        "fn {name_mangle("__plugin_cabi_realloc_impl")}(old_ptr: i32, old_len: i32, align: i32, new_len: i32) -> i32 {{",
        "    let old_len = old_len as usize;",
        "    let new_len = new_len as usize;",
        "    let align = align as usize;",
        "    if new_len == 0 {{",
        "        if old_ptr != 0 && old_len != 0 {{",
        "            if let Ok(layout) = std::alloc::Layout::from_size_align(old_len, align) {{",
        "                unsafe {{ std::alloc::dealloc(old_ptr as *mut u8, layout) }};",
        "            }}",
        "        }}",
        "        return 0;",
        "    }}",
        "    let Ok(new_layout) = std::alloc::Layout::from_size_align(new_len, align) else {{",
        "        return 0;",
        "    }};",
        "    let ptr = if old_ptr == 0 {{",
        "        unsafe {{ std::alloc::alloc(new_layout) }}",
        "    }} else {{",
        "        let Ok(old_layout) = std::alloc::Layout::from_size_align(old_len, align) else {{",
        "            return 0;",
        "        }};",
        "        unsafe {{ std::alloc::realloc(old_ptr as *mut u8, old_layout, new_len) }}",
        "    }};",
        "    ptr as i32",
        "}}",
        "",
        "#[export_name = \"cabi_realloc\"]",
        "pub extern \"C\" fn {realloc}(old_ptr: i32, old_len: i32, align: i32, new_len: i32) -> i32 {{",
        "    {allocator}(old_ptr, old_len, align, new_len)",
        "}}",
        "",
        "fn {read_component_text}(ptr: i32, len: i32) -> String {{",
        "    if ptr == 0 || len == 0 {{",
        "        return String::new();",
        "    }}",
        "    unsafe {{",
        "        String::from_utf8(std::slice::from_raw_parts(ptr as *const u8, len as usize).to_vec())",
        "            .unwrap_or_else(|_| panic!(\"invalid canonical UTF-8 string\"))",
        "    }}",
        "}}",
        "",
    }
    lines.join("\n")
}

fn jet_plugin_push_all(lines: &[String], more: [String]) Never! {
    loop line in more -> &lines.push(line)
}

// result<string, io-error> and result<_, io-error> share one canonical return
// area: a u8 discriminant at byte 0, the payload at byte 8, size 64,
// alignment 8. The io-error payload is a variant of size 56/alignment 8; an
// io-context holds operation @0, option<string> resource @4, option<s64>
// os-code @16 and option<string> cause @32.
fn jet_plugin_io_error_helpers(root: String) -> String Never! {
    io :: "{root}jet_std"
    allocator :: jet_plugin_generated("cabi_realloc_impl")
    read_text :: jet_plugin_generated("read_component_text")
    context_variants :: [String]{"InvalidInput", "NotFound", "PermissionDenied", "TimedOut", "Cancelled", "Closed", "Protocol", "Other"}
    operations :: [String]{"Read", "Write", "Flush", "Connect", "Accept", "Close", "Resolve", "Codec"}
    limits :: [String]{"WallTime", "CpuTime", "Memory", "OpenFiles", "Output"}
    lines := [String]{
        "fn {name_mangle("__plugin_read_io_error")}(ptr: i32) -> {io}::IOError {{",
        "    let tag = unsafe {{ std::ptr::read_unaligned(ptr as *const u8) }};",
        "    if tag <= 7 || tag == 9 || tag == 10 {{",
        "        let context_ptr = (ptr as usize + 8) as i32;",
        "        let operation = match unsafe {{ std::ptr::read_unaligned(context_ptr as *const u8) }} {{",
    }
    loop index in 0..<operations.len() -> &lines.push("            {index} => {io}::IOOperation::{operations[index]},")
    jet_plugin_push_all(&lines, [String]{
        "            _ => panic!(\"invalid canonical io-operation discriminant\"),",
        "        }};",
        "        let resource = match unsafe {{ std::ptr::read_unaligned((context_ptr as usize + 4) as *const u8) }} {{",
        "            0 => Err({root}JetAbsent),",
        "            1 => Ok({read_text}(unsafe {{ std::ptr::read_unaligned((context_ptr as usize + 8) as *const i32) }}, unsafe {{ std::ptr::read_unaligned((context_ptr as usize + 12) as *const i32) }})),",
        "            _ => panic!(\"invalid canonical io-context resource discriminant\"),",
        "        }};",
        "        let os_code = match unsafe {{ std::ptr::read_unaligned((context_ptr as usize + 16) as *const u8) }} {{",
        "            0 => Err({root}JetAbsent),",
        "            1 => Ok(unsafe {{ std::ptr::read_unaligned((context_ptr as usize + 24) as *const i64) }}),",
        "            _ => panic!(\"invalid canonical io-context os-code discriminant\"),",
        "        }};",
        "        let cause = match unsafe {{ std::ptr::read_unaligned((context_ptr as usize + 32) as *const u8) }} {{",
        "            0 => Err({root}JetAbsent),",
        "            1 => Ok({read_text}(unsafe {{ std::ptr::read_unaligned((context_ptr as usize + 36) as *const i32) }}, unsafe {{ std::ptr::read_unaligned((context_ptr as usize + 40) as *const i32) }})),",
        "            _ => panic!(\"invalid canonical io-context cause discriminant\"),",
        "        }};",
        "        let context = {io}::IOContext {{ operation, resource, os_code, cause }};",
        "        match tag {{",
    })
    loop index in 0..<context_variants.len() -> &lines.push("            {index} => {io}::IOError::{context_variants[index]}(context),")
    jet_plugin_push_all(&lines, [String]{
        "            9 => {io}::IOError::AlreadyExists(context),",
        "            10 => {io}::IOError::Unsupported(context),",
        "            _ => unreachable!(),",
        "        }}",
        "    }} else if tag == 8 {{",
        "        let limit = match unsafe {{ std::ptr::read_unaligned((ptr as usize + 8) as *const u8) }} {{",
    })
    loop index in 0..<limits.len() -> &lines.push("            {index} => {io}::ProcessResourceLimit::{limits[index]},")
    jet_plugin_push_all(&lines, [String]{
        "            _ => panic!(\"invalid canonical process-resource-limit discriminant\"),",
        "        }};",
        "        {io}::IOError::ResourceLimit(limit)",
        "    }} else {{",
        "        panic!(\"invalid canonical io-error discriminant\")",
        "    }}",
        "}}",
        "",
        "fn {name_mangle("__plugin_free_io_error")}(ptr: i32) {{",
        "    let tag = unsafe {{ std::ptr::read_unaligned(ptr as *const u8) }};",
        "    if tag <= 7 || tag == 9 || tag == 10 {{",
        "        let context_ptr = (ptr as usize + 8) as i32;",
        "        match unsafe {{ std::ptr::read_unaligned((context_ptr as usize + 4) as *const u8) }} {{",
        "            0 => {{}}",
        "            1 => {{",
        "                let value_ptr = unsafe {{ std::ptr::read_unaligned((context_ptr as usize + 8) as *const i32) }};",
        "                let value_len = unsafe {{ std::ptr::read_unaligned((context_ptr as usize + 12) as *const i32) }};",
        "                {allocator}(value_ptr, value_len, 1, 0);",
        "            }}",
        "            _ => panic!(\"invalid canonical io-context resource discriminant\"),",
        "        }}",
        "        match unsafe {{ std::ptr::read_unaligned((context_ptr as usize + 32) as *const u8) }} {{",
        "            0 => {{}}",
        "            1 => {{",
        "                let value_ptr = unsafe {{ std::ptr::read_unaligned((context_ptr as usize + 36) as *const i32) }};",
        "                let value_len = unsafe {{ std::ptr::read_unaligned((context_ptr as usize + 40) as *const i32) }};",
        "                {allocator}(value_ptr, value_len, 1, 0);",
        "            }}",
        "            _ => panic!(\"invalid canonical io-context cause discriminant\"),",
        "        }}",
        "    }} else if tag == 8 {{",
        "        let limit = unsafe {{ std::ptr::read_unaligned((ptr as usize + 8) as *const u8) }};",
        "        if limit > 4 {{",
        "            panic!(\"invalid canonical process-resource-limit discriminant\")",
        "        }}",
        "    }} else {{",
        "        panic!(\"invalid canonical io-error discriminant\")",
        "    }}",
        "}}",
        "",
    })
    lines.join("\n")
}

// The root imports' raw standard32 guest bridge. The Component Model owns
// the host adapter; this code performs only the canonical pointer/length and
// return-area marshalling of the wasm32 core module. Each error arm decodes
// the io-error before its one payload release.
fn jet_plugin_host_import_bridge(root: String, imports: [String]) -> String Never! {
    if imports.len() == 0 -> return ""
    io :: "{root}jet_std"
    allocator :: jet_plugin_generated("cabi_realloc_impl")
    read_text :: jet_plugin_generated("read_component_text")
    read_io_error :: jet_plugin_generated("read_io_error")
    free_io_error :: jet_plugin_generated("free_io_error")
    lines := [String]{"// D-PLUGIN1=B: declared host imports use the standard32 canonical ABI.", "#[link(wasm_import_module = \"cm32p2\")]", "extern \"C\" {{"}
    loop import in imports {
        if import == {
            "FS.Read" -> {
                &lines.push("    #[link_name = \"host-read\"]")
                &lines.push("    fn __jet_plugin_import_read(path_ptr: i32, path_len: i32, ret_ptr: i32);")
            }
            "FS.Write" -> {
                &lines.push("    #[link_name = \"host-write\"]")
                &lines.push("    fn __jet_plugin_import_write(path_ptr: i32, path_len: i32, text_ptr: i32, text_len: i32, ret_ptr: i32);")
            }
            "Net.Connect" -> {
                &lines.push("    #[link_name = \"host-connect\"]")
                &lines.push("    fn __jet_plugin_import_connect(endpoint_ptr: i32, endpoint_len: i32) -> i32;")
            }
            "Exec" -> {
                &lines.push("    #[link_name = \"host-exec\"]")
                &lines.push("    fn __jet_plugin_import_exec(program_ptr: i32, program_len: i32, args_ptr: i32, args_len: i32, ret_ptr: i32);")
            }
            else -> {}
        }
    }
    &lines.push("}}")
    error_arm :: "        1 => {{ let value = {read_io_error}((ret_ptr as usize + 8) as i32); {free_io_error}((ret_ptr as usize + 8) as i32); Err(value) }}"
    if imports.contains("FS.Read") {
        jet_plugin_push_all(&lines, [String]{
            "fn {name_mangle("__plugin_import_fs_read")}(path: &String) -> Result<String, {io}::IOError> {{",
            "    let ret_ptr = {allocator}(0, 0, 8, 64);",
            "    if ret_ptr == 0 {{ panic!(\"canonical host read return allocation failed\") }}",
            "    unsafe {{ __jet_plugin_import_read(path.as_ptr() as i32, path.len() as i32, ret_ptr); }}",
            "    let tag = unsafe {{ std::ptr::read_unaligned(ret_ptr as *const u8) }};",
            "    let result = match tag {{",
            "        0 => {{ let (ptr, len) = unsafe {{ (std::ptr::read_unaligned((ret_ptr as usize + 8) as *const i32), std::ptr::read_unaligned((ret_ptr as usize + 12) as *const i32)) }}; let value = {read_text}(ptr, len); {allocator}(ptr, len, 1, 0); Ok(value) }}",
            error_arm,
            "        _ => {{ {allocator}(ret_ptr, 64, 8, 0); panic!(\"invalid canonical host read result discriminant\") }}",
            "    }};",
            "    {allocator}(ret_ptr, 64, 8, 0);",
            "    result",
            "}}",
        })
    }
    if imports.contains("FS.Write") {
        jet_plugin_push_all(&lines, [String]{
            "fn {name_mangle("__plugin_import_fs_write")}(path: &String, text: &String) -> Result<(), {io}::IOError> {{",
            "    let ret_ptr = {allocator}(0, 0, 8, 64);",
            "    if ret_ptr == 0 {{ panic!(\"canonical host write return allocation failed\") }}",
            "    unsafe {{ __jet_plugin_import_write(path.as_ptr() as i32, path.len() as i32, text.as_ptr() as i32, text.len() as i32, ret_ptr); }}",
            "    let tag = unsafe {{ std::ptr::read_unaligned(ret_ptr as *const u8) }};",
            "    let result = match tag {{",
            "        0 => Ok(()),",
            error_arm,
            "        _ => {{ {allocator}(ret_ptr, 64, 8, 0); panic!(\"invalid canonical host write result discriminant\") }}",
            "    }};",
            "    {allocator}(ret_ptr, 64, 8, 0);",
            "    result",
            "}}",
        })
    }
    if imports.contains("Net.Connect") {
        jet_plugin_push_all(&lines, [String]{
            "fn {name_mangle("__plugin_import_net_connect")}(endpoint: &String) -> Result<bool, {io}::IOError> {{",
            "    let connected = unsafe {{ __jet_plugin_import_connect(endpoint.as_ptr() as i32, endpoint.len() as i32) != 0 }};",
            "    Ok(connected)",
            "}}",
        })
    }
    if imports.contains("Exec") {
        jet_plugin_push_all(&lines, [String]{
            "fn {name_mangle("__plugin_import_exec")}(program: &String, args: &Vec<String>) -> Result<String, {io}::IOError> {{",
            "    let ret_ptr = {allocator}(0, 0, 4, 8);",
            "    if ret_ptr == 0 {{ panic!(\"canonical host exec return allocation failed\") }}",
            "    let args_bytes = args.len().checked_mul(8).expect(\"canonical host exec argument list is too large\");",
            "    let args_ptr = {allocator}(0, 0, 4, args_bytes as i32);",
            "    if args_ptr == 0 && args_bytes != 0 {{ panic!(\"canonical host exec argument allocation failed\") }}",
            "    for (index, argument) in args.iter().enumerate() {{",
            "        let bytes = argument.as_bytes();",
            "        let ptr = {allocator}(0, 0, 1, bytes.len() as i32);",
            "        if ptr == 0 && !bytes.is_empty() {{ panic!(\"canonical host exec argument allocation failed\") }}",
            "        if !bytes.is_empty() {{ unsafe {{ std::ptr::copy_nonoverlapping(bytes.as_ptr(), ptr as *mut u8, bytes.len()); }} }}",
            "        unsafe {{ std::ptr::write_unaligned((args_ptr as usize + index * 8) as *mut i32, ptr); std::ptr::write_unaligned((args_ptr as usize + index * 8 + 4) as *mut i32, bytes.len() as i32); }}",
            "    }}",
            "    unsafe {{ __jet_plugin_import_exec(program.as_ptr() as i32, program.len() as i32, args_ptr, args.len() as i32, ret_ptr); }}",
            "    for index in 0..args.len() {{",
            "        let (ptr, len) = unsafe {{ (std::ptr::read_unaligned((args_ptr as usize + index * 8) as *const i32), std::ptr::read_unaligned((args_ptr as usize + index * 8 + 4) as *const i32)) }};",
            "        {allocator}(ptr, len, 1, 0);",
            "    }}",
            "    {allocator}(args_ptr, args_bytes as i32, 4, 0);",
            "    let (ptr, len) = unsafe {{ (std::ptr::read_unaligned(ret_ptr as *const i32), std::ptr::read_unaligned((ret_ptr as usize + 4) as *const i32)) }};",
            "    let value = {read_text}(ptr, len);",
            "    {allocator}(ptr, len, 1, 0);",
            "    {allocator}(ret_ptr, 8, 4, 0);",
            "    Ok(value)",
            "}}",
        })
    }
    &lines.push("")
    lines.join("\n")
}

// The embedded TZif closure the guest's Time implementation reads (the
// sandbox has no host filesystem).
fn jet_plugin_time_zones(timezone_data: [JetWebTimezoneAsset]) -> String Never! {
    digits :: "0123456789abcdef".bytes()
    lines := [String]{
        "fn jet_time_embedded_zone_bytes(name: &str) -> Option<&'static [u8]> {{",
        "    let name = name.strip_prefix(\"posix/\").unwrap_or(name);",
        "    let name = name.strip_prefix(\"right/\").unwrap_or(name);",
        "    match name {{",
    }
    loop zone in timezone_data {
        escaped := [U8]{}
        loop byte in zone.bytes {
            value :: Int.from_u8(byte)
            &escaped.push(92)
            &escaped.push(120)
            &escaped.push(digits[value /% 16])
            &escaped.push(digits[value % 16])
        }
        &lines.push("        {jet_rust_emit_quote(zone.name)} => Some(b\"{String.from_bytes(escaped) ?? ""}\"),")
    }
    &lines.push("        _ => None,")
    &lines.push("    }}")
    &lines.push("}}")
    lines.join("\n")
}

// Build the guest artifacts of the checked `SandboxPlugin` artifact `artifact_id`
// around `whole_program_rust`, the emitter's own output for that program.
fn jet_rust_emit_plugin(program: MIRProgram, config: JetRustEmitConfig, artifact_id: MIRArtifactID, codable_keys: [String], whole_program_rust: String, timezone_data: [JetWebTimezoneAsset]) -> JetPluginEmitResult Never! {
    ctx := jet_rust_emit_context(program, config)
    selected := MIRArtifactPlan?{None}
    loop artifact in ctx.program.artifacts {
        if artifact.id == artifact_id -> selected = Val(artifact)
    }
    artifact :: selected ?? return JetPluginEmitResult.Incomplete{failure: jet_rust_emit_failure(JetRustEmitFailureKind.MissingRow, "E0003", "the sandbox artifact has no MIR plan row", "plugin emission reads the exact selected artifact plan", None)}
    if artifact.kind != MIRArtifactKind.SandboxPlugin || artifact.target != MIRArtifactTarget.RustAOT {
        return JetPluginEmitResult.Incomplete{failure: jet_rust_emit_failure(JetRustEmitFailureKind.UnsupportedTarget, "E0003", "plugin emission requires a RustAOT SandboxPlugin artifact", "the selected artifact plan is not a sandbox guest", None)}
    }
    package_name :: jet_plugin_sanitize_package_name(artifact.name)
    host_imports :: jet_plugin_declared_host_imports(ctx.program)
    wit_lines := [String]{}
    wit_definitions := [String]{}
    wit_defined := [String]{}
    if host_imports.contains("FS.Read") || host_imports.contains("FS.Write") -> &wit_definitions.push(jet_plugin_host_io_wit_definitions())
    loop import in host_imports -> &wit_lines.push(jet_plugin_host_import_wit(import))
    wrappers := [String]{}
    exported := [String]{}
    loop export in artifact.exports {
        function :: jet_rust_emit_find_function(&ctx, export.function) ?? return JetPluginEmitResult.Incomplete{failure: jet_rust_emit_failure(JetRustEmitFailureKind.MissingRow, "E0003", "a sandbox export names no MIR function", "every export row calls one checked top-level function", None)}
        descriptor :: mir_component_export_signature(ctx.program.types, codable_keys, function) ?? return JetPluginEmitResult.Incomplete{failure: jet_rust_emit_failure(JetRustEmitFailureKind.InvalidSchema, "E0003", "a sandbox export row has no checked Component signature", "the driver admits only exports that satisfy the Component export law (E1260)", Val(function.span))}
        loop ty in descriptor.params -> jet_plugin_wit_definitions(ty, &wit_defined, &wit_definitions)
        jet_plugin_wit_definitions(descriptor.result, &wit_defined, &wit_definitions)
        wit_params := [String]{}
        loop index in 0..<descriptor.params.len() -> &wit_params.push("p{index}: {jet_plugin_wit_type(descriptor.params[index])}")
        &wit_lines.push("  export {jet_plugin_kebab(export.symbol)}: func({wit_params.join(", ")}) -> {jet_plugin_wit_type(descriptor.result)};")
        &wrappers.push(jet_plugin_component_wrapper(&ctx, function, export.symbol, descriptor))
        &exported.push(function.name)
    }
    if ctx.failure == .Val(failure) -> return JetPluginEmitResult.Incomplete{failure: failure}
    wit :: "package jet:{package_name}@0.1.0;\n\n{wit_definitions.join("\n")}\nworld {JET_PLUGIN_WORLD_NAME} {{\n{wit_lines.join("\n")}\n}}\n"
    parts := [String]{whole_program_rust, jet_plugin_time_zones(timezone_data), "\n// D-PLUGIN-EXPORT1=A: generated sandbox export wrappers (JetCodegen Emit/Plugin.jet).", jet_plugin_text_helpers()}
    if host_imports.contains("FS.Read") || host_imports.contains("FS.Write") -> &parts.push(jet_plugin_io_error_helpers(ctx.config.root_prefix))
    &parts.push(jet_plugin_host_import_bridge(ctx.config.root_prefix, host_imports))
    &parts.push(wrappers.join(""))
    JetPluginEmitResult.Complete{artifacts: JetPluginArtifacts{
        wit: wit,
        guest_rust: parts.join("\n"),
        world_name: JET_PLUGIN_WORLD_NAME,
        export_name: package_name,
        exported_fns: exported,
    }}
}
