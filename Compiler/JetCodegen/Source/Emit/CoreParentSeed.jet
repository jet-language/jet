// Seed-only transport text. All policy and physical ownership live in the
// Source resident host. Bindings below are selected from checked emit metadata.
struct JetRustCoreParentSeedBindings {
    host_type: String
    request_type: String
    getter_type: String
    symbols_type: String
    int_from_address: String
    runtime_initializer: String
    request_rows_field: String
    new_call: String
    request_call: String
    prepare_call: String
    attach_call: String
    getter_call: String
    abis_decode_call: String
}

// The aggregate assembler owns this exact first-line header. A per-source
// marker anywhere else in a user file does not grant private host provenance.
fn jet_rust_core_parent_source_is_private(path: String, source: String) -> Bool Never! {
    path == "Compiler/Bootstrap/Host/Entry.jet" ||
        path.ends_with("/Compiler/Bootstrap/Host/Entry.jet") ||
        source.starts_with("// [jet-bootstrap private host: Compiler/Bootstrap/Host/Entry.jet]\n")
}

fn jet_rust_emit_core_parent_seed(bindings: JetRustCoreParentSeedBindings) -> String Never! {
    lines :: [String]{
        "// Generated by Jet Source CoreParentSeed.jet; this seed transport dies at Rust cutover.",
        "// JET_SOURCE_CORE_PARENT_INGRESS_DEFINED",
        "static __JET_BOOTSTRAP_CORE_PARENT: ::std::sync::OnceLock<Result<::std::sync::Mutex<{bindings.host_type}>, String>> = ::std::sync::OnceLock::new();",
        "fn __jet_bootstrap_core_ingress(__jet_request: &{bindings.request_type}, __jet_admission: Option<crate::compiler_bootstrap_runner::HostBootstrapRuntimeAdmission>) -> Result<(), String> {{",
        "    let Some(__jet_admission) = __jet_admission else {{ return Ok(()); }};",
        "    let __jet_resident = __JET_BOOTSTRAP_CORE_PARENT.get_or_init(|| -> Result<_, String> {{",
        "        let __jet_record = ::jet_codegen::ParentRuntimeLibrary::embedded_admission().ok_or_else(|| \"E0956: RuntimeLibraryMissingAdmission\".to_string())?;",
        "        let __jet_receipt = ::jet_foundation::JSON::parse_json(::std::str::from_utf8(__jet_record.receipt_bytes).map_err(|_| \"E0956: RuntimeLibraryReceiptHashMismatch\".to_string())?).map_err(|_| \"E0956: RuntimeLibraryReceiptHashMismatch\".to_string())?;",
        "        let __jet_export_abi = __jet_receipt.get(\"exportABI\").map_err(|_| \"E0956: RuntimeLibraryExportABIInvalid\".to_string())?;",
        "        let __jet_export_abis = {bindings.abis_decode_call}.map_err(|_| \"E0956: RuntimeLibraryExportABIInvalid\".to_string())?;",
        "        let __jet_exports = __jet_receipt.get(\"exports\").and_then(::jet_foundation::Dyn::Dyn::as_array).map_err(|_| \"E0956: RuntimeLibraryExportSealMismatch\".to_string())?;",
        "        let mut __jet_pairs = Vec::with_capacity(__jet_exports.len());",
        "        for __jet_export in __jet_exports {{",
        "            let __jet_name = __jet_export.as_str().map_err(|_| \"E0956: RuntimeLibraryExportSealMismatch\".to_string())?;",
        "            let __jet_address = __jet_admission.library().symbol(__jet_name).map_err(|key| format!(\"E0956: {{}}\", key.key()))?;",
        "            let __jet_address = i64::try_from(__jet_address).map_err(|_| \"E0956: RuntimeLibraryExportSealMismatch\".to_string())?;",
        "            __jet_pairs.push((__jet_name.to_string(), {bindings.int_from_address}));",
        "        }}",
        "        let __jet_symbols = __jet_pairs.into_iter().collect::<{bindings.symbols_type}>();",
        "        let __jet_hex = |bytes: &[u8; 32]| -> String {{",
        "            const DIGITS: &[u8; 16] = b\"0123456789abcdef\";",
        "            let mut text = String::with_capacity(64);",
        "            for byte in bytes {{ text.push(DIGITS[usize::from(byte >> 4)] as char); text.push(DIGITS[usize::from(byte & 15)] as char); }}",
        "            text",
        "        }};",
        "        let __jet_receipt_identity = __jet_hex(__jet_admission.library().receipt_identity());",
        "        let __jet_library_identity = __jet_hex(__jet_admission.library().library_identity());",
        "        let __jet_runtime = {bindings.runtime_initializer};",
        "        let __jet_original_rows = __jet_request.{bindings.request_rows_field}.clone();",
        "        let __jet_host = {bindings.new_call};",
        "        Ok(::std::sync::Mutex::new(__jet_host))",
        "    }}).as_ref().map_err(Clone::clone)?;",
        "    let mut __jet_host = __jet_resident.lock().map_err(|_| \"E0956: CoreSharedAdmissionIncomplete\".to_string())?;",
        "    // The current factory's checked Source accessor rechecks the original recipe.",
        "    let __jet_recipe_request = {bindings.request_call};",
        "    let __jet_prepared = {bindings.prepare_call};",
        "    let __jet_refusal = {bindings.attach_call};",
        "    if !__jet_refusal.is_empty() {{ return Err(__jet_refusal); }}",
        "    Ok(())",
        "}}",
        "fn __jet_bootstrap_core_getter_seed(__jet_site_key: &String) -> Result<{bindings.getter_type}, String> {{",
        "    let __jet_resident = __JET_BOOTSTRAP_CORE_PARENT.get().ok_or_else(|| \"E0956: CoreSharedNotAdmitted\".to_string())?.as_ref().map_err(Clone::clone)?;",
        "    let mut __jet_host = __jet_resident.lock().map_err(|_| \"E0956: CoreSharedAdmissionIncomplete\".to_string())?;",
        "    Ok({bindings.getter_call})",
        "}}",
    }
    "\n{lines.join("\n")}\n"
}
