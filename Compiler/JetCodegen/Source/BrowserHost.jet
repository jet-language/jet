// Rust: crates/jet-codegen/src/BrowserHost.rs:75
// GATE #4494: real per-thread cells; never process-global handle state.
VALUES :: ThreadLocal.new(fn() { RefCell.new([Int: BrowserHostValue]{}) })
NEXT_VALUE :: ThreadLocal.new(fn() { Cell.new(1) })

// Rust: crates/jet-codegen/src/BrowserHost.rs:80
fn browser_error(error: JetBrowserError) -> CtValue Never! {
    CtValue.Struct(type_name: "BrowserError", fields: [("kind", CtValue.Str(error.kind.to_string()))])
}
// Rust: crates/jet-codegen/src/BrowserHost.rs:87
fn result<T>(value: T JetBrowserError!, map: fn(T) -> CtValue) -> CtValue Never! {
    if value == {
        .Ok(value) -> CtValue.Present(map(^value))
        .Err(error) -> CtValue.failed(browser_error(error))
    }
}
// Rust: crates/jet-codegen/src/BrowserHost.rs:94
fn store(type_name: String, value: BrowserHostValue) -> CtValue Never! {
    id :: NEXT_VALUE.with(fn(next) {
        id :: next.get()
        next.set(id + 1)
        id
    })
    VALUES.with(fn(values) { values.borrow_mut().insert(id, ^value) })
    CtValue.Struct(type_name: type_name, fields: [("__browser_host_id", CtValue.Int(id))])
}
// Rust: crates/jet-codegen/src/BrowserHost.rs:109
fn handle_id(value: &CtValue, type_name: String, span: Span) -> Int Diagnostic! {
    if value == {
        .Struct(actual, fields) -> {
            if actual != type_name -> return Err(host_error(type_name, span))
            loop (name, field_value) in fields {
                if name == "__browser_host_id" {
                    if field_value == { .Int(id) -> return Ok(id) else -> {} }
                }
            }
            Err(host_error(type_name, span))
        }
        else -> Err(host_error(type_name, span))
    }
}
// Rust: crates/jet-codegen/src/BrowserHost.rs:129
fn field(value: &CtValue, type_name: String, name: String) -> &CtValue? Never! {
    if value == {
        .Struct(actual, fields) -> {
            if actual != type_name -> return None
            loop (field_name, field_value) in fields {
                if field_name == name -> return Val(&field_value)
            }
            None
        }
        else -> None
    }
}
// Rust: crates/jet-codegen/src/BrowserHost.rs:141
fn host_error(what: String, span: Span) -> Diagnostic Never! {
    browser_tier0_unsupported(what, span)
}
// Rust: crates/jet-codegen/src/BrowserHost.rs:145
fn int_arg(args: &[CtValue], index: USize, span: Span) -> Int Diagnostic! {
    if args.get(index) == {
        .Val(.Int(value)) -> Ok(value)
        else -> Err(host_error("Int argument", span))
    }
}
// Rust: crates/jet-codegen/src/BrowserHost.rs:152
fn event_ct(event: JetBrowserEvent) -> CtValue Never! {
    CtValue.Struct(type_name: "BrowserEvent", fields: [
        ("method", CtValue.Str(^event.method)),
        ("request_id", CtValue.Str(^event.request_id)),
        ("request_method", CtValue.Str(^event.request_method)),
        ("url_hash", CtValue.Str(^event.url_hash)),
        ("is_blocked", CtValue.Bool(event.is_blocked)),
        ("status_code", CtValue.Int(event.status_code)),
        ("download_id", CtValue.Str(^event.download_id)),
        ("suggested_filename_hash", CtValue.Str(^event.suggested_filename_hash))
    ])
}
// Rust: crates/jet-codegen/src/BrowserHost.rs:174
fn string_arg(args: &[CtValue], index: USize, span: Span) -> String Diagnostic! {
    if args.get(index) == {
        .Val(.Str(value)) -> Ok(value.clone())
        else -> Err(host_error("String argument", span))
    }
}
// Rust: crates/jet-codegen/src/BrowserHost.rs:181
fn timeout_value(value: &CtValue, span: Span) -> JetBrowserTimeout Diagnostic! {
    if field(value, "BrowserTimeout", "milliseconds") == {
        .Val(.Int(milliseconds)) -> Ok(JetBrowserTimeout{milliseconds: milliseconds})
        else -> Err(host_error("timeout", span))
    }
}
// Rust: crates/jet-codegen/src/BrowserHost.rs:190
fn profile_value(value: &CtValue, span: Span) -> JetBrowserProfile Diagnostic! {
    if (field(value, "BrowserProfile", "name"), field(value, "BrowserProfile", "version")) == {
        (.Val(.Str(name)), .Val(.Str(version))) -> Ok(JetBrowserProfile{name: name.clone(), version: version.clone()})
        else -> Err(host_error("profile", span))
    }
}
// Rust: crates/jet-codegen/src/BrowserHost.rs:203
fn profile_ct(value: JetBrowserProfile) -> CtValue Never! {
    CtValue.Struct(type_name: "BrowserProfile", fields: [("name", CtValue.Str(^value.name)), ("version", CtValue.Str(^value.version))])
}
// Rust: crates/jet-codegen/src/BrowserHost.rs:213
fn timeout_ct(value: JetBrowserTimeout) -> CtValue Never! {
    CtValue.Struct(type_name: "BrowserTimeout", fields: [("milliseconds", CtValue.Int(value.milliseconds))])
}
// Rust: crates/jet-codegen/src/BrowserHost.rs:220
fn locked_ct(value: JetBrowserLocked) -> CtValue Never! {
    CtValue.Struct(type_name: "BrowserLocked", fields: [
        ("engine", CtValue.Str(^value.engine)), ("version", CtValue.Str(^value.version)),
        ("binary", CtValue.Str(^value.binary)), ("protocol", CtValue.Str(^value.protocol)),
        ("size", CtValue.Int(value.size)), ("output_hash", CtValue.Str(^value.output_hash))
    ])
}
// Rust: crates/jet-codegen/src/BrowserHost.rs:234
fn locked_value(value: &CtValue, span: Span) -> JetBrowserLocked Diagnostic! {
    if (field(value, "BrowserLocked", "engine"), field(value, "BrowserLocked", "version"),
        field(value, "BrowserLocked", "binary"), field(value, "BrowserLocked", "protocol"),
        field(value, "BrowserLocked", "size"), field(value, "BrowserLocked", "output_hash")) == {
        (.Val(.Str(engine)), .Val(.Str(version)), .Val(.Str(binary)), .Val(.Str(protocol)), .Val(.Int(size)), .Val(.Str(output_hash))) ->
            Ok(JetBrowserLocked{engine: engine.clone(), version: version.clone(), binary: binary.clone(),
                protocol: protocol.clone(), size: size, output_hash: output_hash.clone()})
        else -> Err(host_error("locked", span))
    }
}

// Rust: crates/jet-codegen/src/BrowserHost.rs:262
pub fn eval_core_call(method: String, args: [CtValue], span: Span) -> CtValue Diagnostic! {
    value :: if method == {
        "profile" -> result(jet_browser_profile(&string_arg(&args, 0, span)?), profile_ct)
        "timeout" -> {
            milliseconds :: if args.first() == {
                .Val(.Int(value)) -> value
                else -> return Err(host_error("timeout argument", span))
            }
            result(jet_browser_timeout(milliseconds), timeout_ct)
        }
        "locked" -> result(jet_browser_locked(&string_arg(&args, 0, span)?), locked_ct)
        "connect" -> result(jet_browser_connect(&string_arg(&args, 0, span)?), fn(browser) { store("Browser", BrowserHostValue.Browser(^browser)) })
        "connect_profile" -> {
            endpoint :: string_arg(&args, 0, span)?
            profile :: profile_value(args.get(1) ?? return Err(host_error("profile", span)), span)?
            timeout :: timeout_value(args.get(2) ?? return Err(host_error("timeout", span)), span)?
            result(jet_browser_connect_profile(&endpoint, &profile, timeout), fn(browser) { store("Browser", BrowserHostValue.Browser(^browser)) })
        }
        else -> return Err(host_error(method, span))
    }
    Ok(^value)
}

// Rust: crates/jet-codegen/src/BrowserHost.rs:303
pub fn eval_method(kind: String, method: String, recv: &CtValue, args: &[CtValue], span: Span) -> CtValue Diagnostic! {
    id :: handle_id(recv, kind, span)?
    value :: VALUES.with(fn(values) { values.borrow().get(id).cloned() }) ?? return Err(host_error(kind, span))
    output :: if (&value, method) == {
        (.Browser(browser), "abilities") -> {
            caps :: jet_browser_abilities(browser)
            CtValue.Struct(type_name: "BrowserAbilities", fields: [("bidi", CtValue.Bool(caps.bidi)), ("cdp", CtValue.Bool(caps.cdp)), ("profile", CtValue.Str(^caps.profile))])
        }
        (.Browser(browser), "context") -> result(jet_browser_context(browser), fn(context) { store("BrowserContext", BrowserHostValue.Context(^context)) })
        (.Browser(browser), "subscribe") -> result(jet_browser_subscribe(browser, &string_arg(args, 0, span)?), fn(_) { CtValue.Unit })
        (.Browser(browser), "next_event") -> result(jet_browser_next_event(browser, timeout_value(args.first() ?? return Err(host_error("timeout", span)), span)?), event_ct)
        (.Browser(browser), "add_intercept") -> result(jet_browser_add_intercept(browser, &string_arg(args, 0, span)?), fn(intercept) { store("BrowserIntercept", BrowserHostValue.Intercept(^intercept)) })
        (.Browser(browser), "add_intercept_url") -> result(jet_browser_add_intercept_url(browser, &string_arg(args, 0, span)?, &string_arg(args, 1, span)?), fn(intercept) { store("BrowserIntercept", BrowserHostValue.Intercept(^intercept)) })
        (.Browser(browser), "continue_request") -> result(jet_browser_continue_request(browser, &string_arg(args, 0, span)?), fn(_) { CtValue.Unit })
        (.Browser(browser), "fail_request") -> result(jet_browser_fail_request(browser, &string_arg(args, 0, span)?), fn(_) { CtValue.Unit })
        (.Browser(browser), "fulfill_request") -> result(jet_browser_fulfill_request(browser, &string_arg(args, 0, span)?, int_arg(args, 1, span)?, &string_arg(args, 2, span)?), fn(_) { CtValue.Unit })
        (.Browser(browser), "allow_downloads") -> result(jet_browser_allow_downloads(browser, &string_arg(args, 0, span)?), fn(_) { CtValue.Unit })
        (.Browser(browser), "protocol") -> result(jet_browser_protocol(browser, &string_arg(args, 0, span)?), fn(protocol) { store("BrowserProtocol", BrowserHostValue.Protocol(^protocol)) })
        (.Browser(browser), "trace") -> {
            trace :: jet_browser_trace(browser)
            CtValue.Struct(type_name: "BrowserTrace", fields: [("entries", CtValue.List(trace.entries.into_iter().map(fn(entry) { CtValue.Str(^entry) }).collect()))])
        }
        (.Browser(browser), "privacy") -> {
            privacy :: jet_browser_privacy(browser)
            CtValue.Struct(type_name: "BrowserPrivacy", fields: [
                ("isolated_profiles", CtValue.Bool(privacy.isolated_profiles)),
                ("redact_receipts", CtValue.Bool(privacy.redact_receipts)),
                ("shared_profiles", CtValue.Bool(privacy.shared_profiles))])
        }
        (.Browser(browser), "receipt") -> {
            receipt :: jet_browser_receipt(browser)
            CtValue.Struct(type_name: "BrowserReceipt", fields: [
                ("entries", CtValue.List(receipt.entries.into_iter().map(fn(entry) { CtValue.Str(^entry) }).collect())),
                ("isolated", CtValue.Bool(receipt.isolated)), ("cleaned", CtValue.Bool(receipt.cleaned))])
        }
        (.Browser(browser), "close") -> result(jet_browser_close(browser), fn(_) { CtValue.Unit })
        (.Context(context), "page") -> result(jet_browser_context_page(context), fn(page) { store("BrowserPage", BrowserHostValue.Page(^page)) })
        (.Context(context), "tab") -> result(jet_browser_context_tab(context), fn(page) { store("BrowserPage", BrowserHostValue.Page(^page)) })
        (.Context(context), "close") -> result(jet_browser_context_close(context), fn(_) { CtValue.Unit })
        (.Context(context), "isolated") -> CtValue.Bool(jet_browser_context_isolated(context))
        (.Context(context), "user_hash") -> CtValue.Str(jet_browser_context_user_hash(context))
        (.Page(page), "goto") -> result(jet_browser_page_goto(page, &string_arg(args, 0, span)?), fn(_) { CtValue.Unit })
        (.Page(page), "get_by_role") -> store("BrowserLocator", BrowserHostValue.Locator(jet_browser_page_get_by_role(page, &string_arg(args, 0, span)?, &string_arg(args, 1, span)?)))
        (.Page(page), "get_by_text") -> store("BrowserLocator", BrowserHostValue.Locator(jet_browser_page_get_by_text(page, &string_arg(args, 0, span)?)))
        (.Page(page), "get_by_label") -> store("BrowserLocator", BrowserHostValue.Locator(jet_browser_page_get_by_label(page, &string_arg(args, 0, span)?)))
        (.Page(page), "get_by_placeholder") -> store("BrowserLocator", BrowserHostValue.Locator(jet_browser_page_get_by_placeholder(page, &string_arg(args, 0, span)?)))
        (.Page(page), "get_by_test_id") -> store("BrowserLocator", BrowserHostValue.Locator(jet_browser_page_get_by_test_id(page, &string_arg(args, 0, span)?)))
        (.Page(page), "get_by_css") -> store("BrowserLocator", BrowserHostValue.Locator(jet_browser_page_get_by_css(page, &string_arg(args, 0, span)?)))
        (.Page(page), "main_frame") -> result(jet_browser_page_main_frame(page), fn(frame) { store("BrowserFrame", BrowserHostValue.Frame(^frame)) })
        (.Page(page), "frames") -> result(jet_browser_page_frames(page), fn(frames) { CtValue.List(frames.into_iter().map(fn(frame) { store("BrowserFrame", BrowserHostValue.Frame(^frame)) }).collect()) })
        (.Page(page), "close") -> result(jet_browser_page_close(page), fn(_) { CtValue.Unit })
        (.Page(page), "screenshot") -> result(jet_browser_page_screenshot(page), fn(text) { CtValue.Str(^text) })
        (.Page(page), "pdf") -> result(jet_browser_page_pdf(page), fn(text) { CtValue.Str(^text) })
        (.Page(page), "set_cookie") -> result(jet_browser_page_set_cookie(page, &string_arg(args, 0, span)?, &string_arg(args, 1, span)?, &string_arg(args, 2, span)?), fn(_) { CtValue.Unit })
        (.Page(page), "cookie") -> result(jet_browser_page_cookie(page, &string_arg(args, 0, span)?), fn(value) {
            if value == { .Val(text) -> CtValue.Present(CtValue.Str(^text)) else -> CtValue.absent(Type.String) }
        })
        (.Page(page), "clear_cookies") -> result(jet_browser_page_clear_cookies(page), fn(_) { CtValue.Unit })
        (.Page(page), "storage_get") -> result(jet_browser_page_storage_get(page, &string_arg(args, 0, span)?, &string_arg(args, 1, span)?), fn(value) {
            if value == { .Val(text) -> CtValue.Present(CtValue.Str(^text)) else -> CtValue.absent(Type.String) }
        })
        (.Page(page), "storage_set") -> result(jet_browser_page_storage_set(page, &string_arg(args, 0, span)?, &string_arg(args, 1, span)?, &string_arg(args, 2, span)?), fn(_) { CtValue.Unit })
        (.Page(page), "storage_clear") -> result(jet_browser_page_storage_clear(page, &string_arg(args, 0, span)?), fn(_) { CtValue.Unit })
        (.Frame(frame), "close") -> result(jet_browser_frame_close(frame), fn(_) { CtValue.Unit })
        (.Locator(locator), "wait") -> result(jet_browser_locator_wait(locator, timeout_value(args.first() ?? return Err(host_error("timeout", span)), span)?), fn(_) { CtValue.Unit })
        (.Locator(locator), "wait_gone") -> result(jet_browser_locator_wait_gone(locator, timeout_value(args.first() ?? return Err(host_error("timeout", span)), span)?), fn(_) { CtValue.Unit })
        (.Locator(locator), "click") -> result(jet_browser_locator_click(locator), fn(_) { CtValue.Unit })
        (.Locator(locator), "hover") -> result(jet_browser_locator_hover(locator), fn(_) { CtValue.Unit })
        (.Locator(locator), "fill") -> result(jet_browser_locator_fill(locator, &string_arg(args, 0, span)?), fn(_) { CtValue.Unit })
        (.Locator(locator), "press") -> result(jet_browser_locator_press(locator, &string_arg(args, 0, span)?), fn(_) { CtValue.Unit })
        (.Locator(locator), "set_files") -> result(jet_browser_locator_set_files(locator, &string_arg(args, 0, span)?), fn(_) { CtValue.Unit })
        (.Intercept(intercept), "remove") -> result(jet_browser_intercept_remove(intercept), fn(_) { CtValue.Unit })
        (.Protocol(protocol), "send") -> result(jet_browser_protocol_send(protocol, &string_arg(args, 0, span)?, &string_arg(args, 1, span)?), fn(text) { CtValue.Str(^text) })
        else -> return Err(host_error(method, span))
    }
    Ok(^output)
}

// Rust: crates/jet-codegen/src/BrowserHost.rs:616
pub fn eval_value_method(kind: String, method: String, recv: &CtValue, span: Span) -> CtValue? Diagnostic! {
    value :: if (kind, method) == {
        ("BrowserEvent", "kind") -> field(recv, kind, "method").cloned()
        ("BrowserEvent", "request_id" | "request_method" | "url_hash" | "download_id" | "suggested_filename_hash") -> field(recv, kind, method).cloned()
        ("BrowserEvent", "is_blocked") -> field(recv, kind, "is_blocked").cloned()
        ("BrowserEvent", "status_code") -> field(recv, kind, "status_code").cloned()
        ("BrowserAbilities", "bidi" | "cdp" | "profile") -> field(recv, kind, method).cloned()
        ("BrowserTrace", "entry_count") -> field(recv, kind, "entries").and_then(fn(value) {
            if value == { .List(entries) -> Val(CtValue.Int(entries.len() as Int)) else -> None }
        })
        ("BrowserTrace", "summary") -> field(recv, kind, "entries").and_then(fn(value) {
            if value == {
                .List(entries) -> Val(CtValue.Str(entries.iter().filter_map(fn(entry) {
                    if entry == { .Str(text) -> Val(text.as_str()) else -> None }
                }).collect().join(",")))
                else -> None
            }
        })
        ("BrowserTrace", "redacted") -> field(recv, kind, "entries").and_then(fn(value) {
            if value == {
                .List(entries) -> {
                    texts := [String]{}
                    loop entry in entries {
                        if entry == { .Str(text) -> texts.push(text.clone()) else -> return None }
                    }
                    Val(CtValue.Bool(jet_browser_trace_redacted(&JetBrowserTrace{entries: ^texts})))
                }
                else -> None
            }
        })
        ("BrowserReceipt", "entry_count") -> field(recv, kind, "entries").and_then(fn(value) {
            if value == { .List(entries) -> Val(CtValue.Int(entries.len() as Int)) else -> None }
        })
        ("BrowserReceipt", "summary") -> field(recv, kind, "entries").and_then(fn(value) {
            if value == {
                .List(entries) -> Val(CtValue.Str(entries.iter().filter_map(fn(entry) {
                    if entry == { .Str(text) -> Val(text.as_str()) else -> None }
                }).collect().join(",")))
                else -> None
            }
        })
        ("BrowserReceipt", "redacted") -> field(recv, kind, "entries").and_then(fn(value) {
            if value == {
                .List(entries) -> {
                    texts := [String]{}
                    loop entry in entries {
                        if entry == { .Str(text) -> texts.push(text.clone()) else -> return None }
                    }
                    Val(CtValue.Bool(jet_browser_receipt_redacted(&JetBrowserReceipt{entries: ^texts, isolated: true, cleaned: false})))
                }
                else -> None
            }
        })
        ("BrowserReceipt", "isolated" | "cleaned") -> field(recv, kind, method).cloned()
        ("BrowserPrivacy", "isolated_profiles" | "redact_receipts" | "shared_profiles") -> field(recv, kind, method).cloned()
        ("BrowserLocked", "engine" | "version" | "binary" | "protocol") -> field(recv, kind, method).cloned()
        ("BrowserLocked", "verify") -> {
            locked :: locked_value(recv, span)?
            Val(result(jet_browser_locked_verify(&locked), fn(_) { CtValue.Unit }))
        }
        else -> None
    }
    if value == None -> return Err(host_error(method, span))
    Ok(^value)
}
// Rust: crates/jet-codegen/src/BrowserHost.rs:736
pub fn clear() -> Unit Never! {
    VALUES.with(fn(values) { values.borrow_mut().clear() })
    NEXT_VALUE.with(fn(next) { next.set(1) })
}
