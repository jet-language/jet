// Rust: crates/jet-codegen/src/BrowserHost.rs:65
 enum BrowserHostValue {
    Browser(JetBrowser)
    Context(JetBrowserContext)
    Page(JetBrowserPage)
    Frame(JetBrowserFrame)
    Locator(JetBrowserLocator)
    Intercept(JetBrowserIntercept)
    Protocol(JetBrowserProtocol)
