pub mod local_cell {
    pub use jet_codegen.Prelude.LocalCell.*
    pub use jet_foundation.Outcome.*
    use jet_foundation.MIR.MirRuntimeValue
    // Rust: crates/jet-codegen/src/lib.rs:222
    impl JetCellOptionLike for MirRuntimeValue {
        type Value = MirRuntimeValue
        // Rust: crates/jet-codegen/src/lib.rs:225
        fn value(self: &MirRuntimeValue) -> &MirRuntimeValue? Never! {
            if self == {
                .Absent { .. } -> None
                .Moved -> None
                .Present(inner) -> Val(&inner)
                other -> Val(&other)
            }
        }
        // Rust: crates/jet-codegen/src/lib.rs:234
        fn store(self: &MirRuntimeValue, value: MirRuntimeValue) -> Unit Never! {
            self = MirRuntimeValue.Present(Box.new(^value))
        }
    }
}
