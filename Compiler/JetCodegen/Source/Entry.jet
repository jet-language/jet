pub mod embedded_hardware {
    // Rust: crates/jet-codegen/src/lib.rs:269
    // GATE #4494: native unwind retains the Foundation-rendered diagnostic.
    fn jet_panic(file: String, line: U32, message: String) -> Never Never! {
        diagnostic :: jet_foundation.Outcome.jet_render_runtime_stop("E3001", file, line, "", "", 1, 1, message, "")
        std.panic.panic_any(diagnostic.rendered)
    }
    pub use jet_codegen.Prelude.Core.EmbeddedHardware.*
}
