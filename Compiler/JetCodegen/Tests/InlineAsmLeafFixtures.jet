// Assemble with the compiler fixture unit: real parser/foreign admission feeds
// the body-less asm producer, then the unchanged MIR legality gate checks it.
use jet_parser.[parse_source]
use jet_sema.[
    SemaBuildFacts, SemaCheckedForeignProvider, SemaForeignProviderInput, SemaGraphModuleResult,
    SemaRegistrationForeignHandleFacts, SemaRegistrationImportEdge, SemaRegistrationModuleInput,
    SemaSourceOrigin, sema_checked_foreign_functions, sema_has_error_since,
    sema_registration_prepare_graph,
]
use jet_driver.[jet_driver_canonical_effect_module, jet_driver_source_segments]
use jet_foundation.[
    Diagnostic, MIRCoreCall, MIRFunctionKind, MIROptimizationPassID, MIRPreludeCall,
    MIRTargetApplicability, jet_target_machine_hosted, mir_source_file_id,
]
use jet_codegen.[jet_codegen_lower_asm_leaf, jet_codegen_nominal_index]
use jet_optimizer.[MIRPassLegalityTables, mir_pass_validate_function]

fn asm_leaf_require(ok: Bool, message: String) Never! {
    if !ok -> panic("InlineAsmLeafFixtures: {message}")
}

#Test("inline_asm_leaf_fixtures") {
    source :: "use core.mem\n#[Unsafe(\"the caller passes one machine word\"), FFI(asm)]\nfn asm_word(value: I64) -> I64 {{\n    \"\"\"\n    mov rax, {{value}} ; -> return\n    \"\"\"\n}}\n"
    parsed := parse_source(source.bytes())
    asm_leaf_require(!sema_has_error_since(parsed.diagnostics, 0), "the real inline asm declaration parses")
    file :: "asm-leaf.jet"
    input :: SemaRegistrationModuleInput{package_identity: "asm-leaf", module_identity: "asm-leaf::main", module_name: "main", core_source_alias: "", module_path: file, source_file: file, source_segments: jet_driver_source_segments(file, source), source_origin: SemaSourceOrigin.Snapshot, program: ^parsed.program, foreign_handles: [SemaRegistrationForeignHandleFacts]{}, source: source}
    canonical :: jet_driver_canonical_effect_module("effect IO\neffect Panic\n") ?? panic("the canonical effect fixture parses")
    canonical_identity :: canonical.module_identity.copy()
    facts :: SemaBuildFacts{package_name: "asm-leaf", package_version: "0.1.0", os: "linux", profile: "dev", stamp_git: None, stamp_dirty: false, stamp_toolchain: "fixture", stamp_at: ""}
    graph :: sema_registration_prepare_graph([SemaRegistrationModuleInput]{input, canonical}, [SemaRegistrationImportEdge]{}, "asm-leaf", "asm-leaf::main", canonical_identity, [SemaForeignProviderInput]{}, jet_target_machine_hosted("x86_64-unknown-linux-gnu", "0.1.0"), facts, false)
    diagnostics := [Diagnostic]{}
    rows :: sema_checked_foreign_functions(graph, graph.modules[0], [SemaCheckedForeignProvider]{}, &diagnostics)
    asm_leaf_require(!sema_has_error_since(diagnostics, 0) && rows.len() == 1, "the existing foreign stage admits exactly one asm row")
    asm_leaf_require(rows[0].asm_contract != None, "the row retains its real operand contract")
    applicability :: MIRTargetApplicability{rust_aot: true, interpreter: true, web: false}
    nominals :: jet_codegen_nominal_index([SemaGraphModuleResult]{})
    leaf :: jet_codegen_lower_asm_leaf(rows[0], nominals, applicability)
    repeat :: jet_codegen_lower_asm_leaf(rows[0], nominals, applicability)
    asm_leaf_require(leaf.entry.value != 0 && leaf.id.value != 0, "asm leaf block and function identities are nonzero")
    asm_leaf_require(leaf.entry == repeat.entry && leaf.id == repeat.id, "asm leaf identities are deterministic")
    asm_leaf_require(leaf.key == rows[0].key && leaf.foreign_language == (Val("asm")), "asm_foreign resolves the exact checked key and language")
    asm_leaf_require(leaf.source_file == mir_source_file_id(file) && leaf.span == rows[0].span, "the leaf retains authorized source coordinates")
    asm_leaf_require(leaf.params.len() == 1 && leaf.return_type == leaf.params[0].ty, "the raw I64 signature survives lowering")
    asm_leaf_require(leaf.kind == MIRFunctionKind.Foreign && leaf.blocks.len() == 1 && leaf.blocks[0].id == leaf.entry, "the foreign leaf has one canonical entry block")
    tables :: MIRPassLegalityTables{prelude_calls: [MIRPreludeCall]{}, prelude_positions: [U64:Int]{}, prelude_failure: None, core_calls: [MIRCoreCall]{}, core_positions: [U64:Int]{}, functions: [U64:Bool]{}, types: [U64:Bool]{}, fields: [U64:Bool]{}, source_files: [U64:Bool]{leaf.source_file.value: true}, foreign: [U64:Bool]{}, callbacks: [U64:Bool]{}, traits: [U64:Bool]{}, trait_methods: [U64:Bool]{}}
    asm_leaf_require(mir_pass_validate_function(leaf, MIROptimizationPassID.LegalityVerification, tables) == None, "the unchanged MIR legality validator accepts the foreign leaf")
    print("inline asm leaf legality: passed")
}
