        ("FileReader", "read_line", 0), ("FileWriter", "write_line", 1), ("FileWriter", "flush", 0),
        ("TcpStream", "read", 0), ("TcpStream", "close", 0), ("TcpListener", "accept", 0),
        ("Arena", "alloc", 1), ("Bump", "reset", 0),
        ("HTTPRequest", "method", 0), ("HTTPRequest", "path", 0), ("HTTPRequest", "header", 1),
        ("HTTPRequest", "param", 1), ("HTTPRequest", "trailers", 0), ("HTTPResponse", "status", 0),
        ("HTTPResponse", "body", 0), ("HTTPResponse", "trailers", 1),
        ("ArgsSpec", "flag", 2), ("ArgsSpec", "option", 3), ("ArgsSpec", "positional", 2),
        ("ArgsSpec", "description", 1), ("ArgsSpec", "help", 0), ("ArgsSpec", "parse", 1),
        ("ParsedArgs", "flag", 1), ("ParsedArgs", "option", 1), ("ParsedArgs", "positional", 1),
        ("Value", "type_name", 0), ("Value", "display", 0), ("Value", "fields", 0),
        ("Field", "name", 0), ("Field", "value", 0)
    ] -> assert(handle_method_op(owner, method, arity).is_some())
    assert(handle_method_op("Pool", "free", 0).is_none())
    assert(handle_method_op("FileReader", "lines", 0).is_none())
    assert(handle_method_op("FileWriter", "write_line", 0).is_none())
}
