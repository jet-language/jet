// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:3198
#Test("core_closure_calls_covered") {
    cx_src :: "fn f() {}\n"
    (toks, _) :: lex(cx_src)
    prog :: parse(toks).expect("parse")
    cx :: build_cx(prog, cx_src, "t.jet")
    locals :: [String:Bool]{}
    lam :: fn(body: String) -> [CallArg] {
        s :: "fn g() {{ x :: scope.guard({body})\n}}\n"
        (t, _) :: lex(s)
        p :: parse(t).expect("parse lam")
        loop item in p.items {
            if item == .Func(f) {
                loop st in f.body {
                    if st == .Val(b) {
                        if b.init == .MethodCall{args, ..} -> return args
                    }
                }
            }
        }
        []
    }
    guard_args :: lam("() -> { print(\"x\") }")
    assert(core_closure_call_in_subset("core.mem.scope", "guard", guard_args, cx, locals))
    assert(core_closure_call_in_subset("core.tasks", "spawn", guard_args, cx, locals))
    assert(!core_closure_call_in_subset("core.files", "read", guard_args, cx, locals))
}
