// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:1815
fn non_scalar_clone_count(rust: String) -> Int Never! {
    scalars := [String:Bool]{}
    loop line in rust.lines() {
        rest :: line.trim_start().strip_prefix("let ") ?? continue
        rest :: rest.strip_prefix("mut ") ?? rest
        (name, ty) :: rest.split_once(':') ?? continue
        ty :: ty.trim_start() // #4303
        if ty.contains("JetInt") || ty.starts_with("bool") || ty.starts_with("Option<bool>") -> &scalars.insert(name.trim(), true)
    }
    count := 0
    loop (at, _) in rust.match_indices(".clone()") {
        prefix :: rust[0..<at]
        prefix :: prefix.strip_suffix(".as_ref().expect(\"MIR local\")") ?? prefix.strip_suffix(".as_ref().expect(\"MIR value\")") ?? prefix
        start :: prefix.rfind(fn(c) { !(c.is_alphanumeric() || c == '_') }).map(fn(index) { index + 1 }) ?? 0
        if !scalars.has_key(prefix[start..]) -> count += 1
    }
    count
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:1846
fn emitted_fn_body(rust: String, name: String) -> View<U8> Never! {
    start :: rust.find("{name}(__jet_") ?? panic("`{name}` was not emitted:\n{rust}")
    rest :: rust[start..]
    rest[0..<rest.find("\n}\n").expect("emitted function has a closing brace")]
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:1855
#Test("borrowed_builtin_arguments_are_never_copied") {
    run_on_compiler_stack(fn() {
        src :: "struct Sym {\n    name: String\n    id: Int\n}\n\nfn has_value(items: [String], value: String) -> Bool {\n    items.contains(value)\n}\n\nfn find_sym(m: [String:Int], s: Sym) -> Int? {\n    m.get(s.name)\n}\n\nfn keep_value(items: &[String], value: String) {\n    &items.push(value)\n}\n\nfn run() {\n    m :: [String:Int]{}\n    names := [String]{}\n    keep_value(&names, \"b\")\n    print(has_value(names, \"a\"))\n    print(find_sym(m, Sym{name: \"a\", id: 1}) ?? 0)\n}\n"
        (_, rust) :: emitted_rust(src)
        loop name in ["has_uvalue", "find_usym"] {
            body :: emitted_fn_body(rust, name)
            assert(!body.contains(".clone()"), "a borrowed builtin argument must be borrowed in place, not copied:\n{body}")
        }
        keep :: emitted_fn_body(rust, "keep_uvalue")
        assert(keep.matches(".clone()").count() == 1, "a stored builtin argument is copied exactly once:\n{keep}")
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:1879
#Test("mir_walks_stable_loop_sources_in_place") {
    run_on_compiler_stack(fn() {
        program :: fn(setup: String, source: String, inside: String, after: String) {
            "struct Bag {{\n    names: [String]\n}}\nfn make_names(count: Int) -> [String] {{\n    names := [String]{{}}\n    loop i in 0..count {{\n        &names.push(\"name\")\n    }}\n    return names\n}}\nfn run() {{\n    {setup}\n    n := 0\n    loop name in {source} {{\n        n = n + name.len()\n        {inside}\n    }}\n    {after}\n    print(n)\n}}\n"
        }
        loop (setup, source) in [("names := make_names(3)", "names"), ("bag := Bag{names: make_names(3)}", "bag.names")] {
            mention :: "_ := {source}.len()"
            (stable_cursors, stable_clones) :: stable_loop_probe(program(setup, source, "", mention))
            (snapshot_cursors, snapshot_clones) :: stable_loop_probe(program(setup, source, mention, ""))
            eprintln("stable loop source `{source}`: non-scalar .clone() {snapshot_clones} (body mentions source) -> {stable_clones} (stable); cursors {snapshot_cursors:?} -> {stable_cursors:?}")
            assert(stable_cursors.get("run") == Val(0), "`{source}`: {stable_cursors:?}")
            assert(snapshot_cursors.get("run") == Val(1), "`{source}`: {snapshot_cursors:?}")
            assert(stable_clones < snapshot_clones, "`{source}`: stable walk emitted {stable_clones} clones, snapshot {snapshot_clones}")
        }
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:1937
#Test("mir_keeps_full_call_carriers_and_drops_partial_move_remainders") {
    run_on_compiler_stack(fn() {
        src :: "struct Pair {\n    shared: Shared<String>\n    remaining: String\n}\nfn child() -> Int Err! { return Ok(7) }\nfn caller() -> Int Err! { return child() }\nfn generic_child<T>(value: ^T) -> T Err! { return Ok(value) }\nfn generic_caller() -> Int Err! { return generic_child<Int>(7) }\nfn take_shared(pair: ^Pair) -> Shared<String> { return ^pair.shared }\nstruct Box<T> {\n    value: T\n    fn get(self) -> T Err! { return Ok(self.value) }\n}\nfn boxed(item: Box<Int>) -> Int Err! { return item.get() }\nfn run() {}\n"
        bundle :: checked_bundle(src)
        request :: MIRArtifactRequest.new(MIRArtifactTarget.RustAot, MIRArtifactKind.NativeExecutable, MIRArtifactBuildMode.Dev)
        (mir, _) :: lower_checked_mir_program_for(bundle, request).expect("full-carrier ownership fixture failed to lower")
        mir.validate().expect("full-carrier ownership fixture failed validation")
        child :: mir.functions.find(fn(f) { f.name == "child" }).expect("child function")
        caller :: mir.functions.find(fn(f) { f.name == "caller" }).expect("caller function")
        call :: caller.blocks.flat_map(fn(b) { b.instructions }).find(fn(i) { if i.operation == { .Call{callee: .User(target), ..} -> target == child.id else -> false } }).expect("caller invokes child")
        assert(call.ty == Val(child.return_type))
        call_result :: call.result.expect("typed call result")
        returned :: caller.blocks.find_map(fn(b) { if b.terminator == { .Return(Val(value)) -> Val(value) else -> None } }).expect("caller returns the child result")
        assert(returned == call_result)
        returned_type :: caller.values.find(fn(row) { row.0 == returned }).map(fn(row) { row.1 }).expect("returned call value has a type fact")
        assert(returned_type == caller.return_type)
        generic_child :: mir.functions.find(fn(f) { f.name == "generic_child" }).expect("generic child function")
        generic_caller :: mir.functions.find(fn(f) { f.name == "generic_caller" }).expect("generic caller function")
        generic_call :: generic_caller.blocks.flat_map(fn(b) { b.instructions }).find(fn(i) { if i.operation == { .Call{callee: .User(target), ..} -> target == generic_child.id else -> false } }).expect("generic caller invokes generic child")
        assert(generic_call.ty == Val(generic_caller.return_type), "generic call preserves its instantiated full carrier")
        assert(generic_call.ty != Val(generic_child.return_type), "generic call does not retain the uninstantiated callee carrier")
        boxed :: mir.functions.find(fn(f) { f.name == "boxed" }).expect("generic-owner method caller")
        (method_call, get_id) :: boxed.blocks.flat_map(fn(b) { b.instructions }).find_map(fn(i) { if i.operation == { .Call{callee: .Method{function, ..}, ..} -> Val((i, function)) else -> None } }).expect("generic-owner method call")
        get :: mir.functions.find(fn(f) { f.id == get_id }).expect("generic-owner method target")
        assert(method_call.ty == Val(boxed.return_type), "method call uses its owner-instantiated full carrier")
        assert(method_call.ty != Val(get.return_type), "method call does not retain the generic owner carrier")
        take_shared :: mir.functions.find(fn(f) { f.name == "take_shared" }).expect("take_shared function")
        pair :: take_shared.locals.find(fn(l) { l.name == "pair" }).expect("owned Pair parameter")
        projected_move :: take_shared.blocks.flat_map(fn(b) { b.instructions }).find(fn(i) { if i.operation == { .MovePlace(place) -> take_shared.places.any(fn(p) { p.id == place && !p.projections.is_empty() }) else -> false } }).expect("projected Shared field is moved")
        assert(projected_move.result.is_some())
        assert(!take_shared.locals.any(fn(l) { l.name.starts_with("owned_live_") }), "a projected move must not clear whole-owner liveness")
        instructions :: take_shared.blocks.flat_map(fn(b) { b.instructions }).collect()
        root_move :: instructions.find(fn(i) { if i.operation == { .MovePlace(place) -> place == pair.place else -> false } }).expect("remaining Pair fields are moved for cleanup")
        root_value :: root_move.result.expect("root cleanup move result")
        assert(instructions.any(fn(i) { if i.operation == { .Drop{value, ..} -> value == root_value else -> false } }))
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:2135
#Test("mir_types_absent_match_arm_from_its_checked_option_peer") {
    run_on_compiler_stack(fn() {
        src :: "fn canonical_device(device: String) -> String? {\n    if device == {\n        \"CPU\" | \"cpu\" -> Val(\"CPU\")\n        \"Auto\" | \"auto\" -> Val(\"Auto\")\n        \"CUDA\" | \"cuda\" -> Val(\"CUDA\")\n        \"Metal\" | \"metal\" -> Val(\"Metal\")\n        \"Vulkan\" | \"vulkan\" -> Val(\"Vulkan\")\n        \"WebGPU\" | \"webgpu\" -> Val(\"WebGPU\")\n        else -> None\n    }\n}\nfn run() {}\n"
        bundle :: checked_bundle(src)
        request :: MIRArtifactRequest.new(MIRArtifactTarget.RustAot, MIRArtifactKind.NativeExecutable, MIRArtifactBuildMode.Dev)
        (mir, _) :: lower_checked_mir_program_for(bundle, request).expect("canonical_device failed to lower to MIR")
        mir.validate().expect("canonical_device MIR failed validation")
        function :: mir.functions.find(fn(f) { f.name == "canonical_device" }).expect("canonical_device MIR function")
        assert(function.blocks.flat_map(fn(b) { b.instructions }).any(fn(i) { i.operation == .Absent && i.ty.is_some_and(fn(t) { if t.kind == { .Option(inner) -> inner.kind == .String else -> false } }) }), "the final None arm must retain the checked Option<String> type")
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:2189
#Test("mir_lowers_core_net_error_constructors_as_typed_enums") {
    run_on_compiler_stack(fn() {
        src :: "fn net_err(op: String, addr: String, message: String) -> NetError {\n    return NetError.InvalidInput(NetErrorDetail{\n        operation: op,\n        address: Val(addr),\n        name: None,\n        message: message,\n        os_code: None,\n    })\n}\nfn dns_err(name: String) -> NetError {\n    return NetError.DNS(NetDnsError.NotFound(name))\n}\nfn run() {}\n"
        bundle :: checked_bundle(src)
        request :: MIRArtifactRequest.new(MIRArtifactTarget.RustAot, MIRArtifactKind.NativeExecutable, MIRArtifactBuildMode.Dev)
        (mir, _) :: lower_checked_mir_program_for(bundle, request).expect("NetError construction failed to lower to MIR")
        mir.validate().expect("NetError MIR failed validation")
        net_err_fn :: mir.functions.find(fn(f) { f.name == "net_err" }).expect("net_err MIR function")
        has_absent_payload :: fn(matches_payload: fn(MIRTypeKind) -> Bool) { net_err_fn.blocks.flat_map(fn(b) { b.instructions }).any(fn(i) { i.operation == .Absent && i.ty.is_some_and(fn(t) { if t.kind == { .Option(inner) -> matches_payload(inner.kind) else -> false } }) }) }
        assert(has_absent_payload(fn(kind) { kind == .String }), "NetErrorDetail.name must retain its checked Option<String> type")
        assert(has_absent_payload(fn(kind) { kind == .Int }), "NetErrorDetail.os_code must retain its checked Option<Int> type")
        net_error :: mir.types.find(fn(t) { t.key == "NetError" }).expect("compiler-owned NetError type row")
        net_dns_error :: mir.types.find(fn(t) { t.key == "NetDnsError" }).expect("compiler-owned NetDnsError type row")
        detail :: mir.types.find(fn(t) { t.key == "NetErrorDetail" }).expect("compiler-owned NetErrorDetail type row")
        net_error_variants :: if net_error.kind == { .Enum(variants, _) -> variants else -> panic("NetError must be an enum row") }
        assert(net_error_variants.map(fn(v) { v.name }) == ["InvalidInput", "PermissionDenied", "AddressInUse", "AddressUnavailable", "ConnectionRefused", "ConnectionReset", "NotConnected", "Closed", "Timeout", "Cancelled", "Unsupported", "TLS", "Protocol", "Other", "DNS"])
        invalid_input :: net_error_variants.find(fn(v) { v.name == "InvalidInput" }).expect("NetError.InvalidInput variant row")
        payload :: if invalid_input.payload == { .Single(payload) -> payload else -> panic("NetError.InvalidInput must carry NetErrorDetail") }
        assert(payload.identity == Val(detail.id))
        net_dns_variants :: if net_dns_error.kind == { .Enum(variants, _) -> variants else -> panic("NetDnsError must be an enum row") }
        assert(net_dns_variants.map(fn(v) { v.name }) == ["NotFound", "Failure"])
        has_enum :: fn(function_name: String, type_id, variant_name: String) {
            function :: mir.functions.find(fn(f) { f.name == function_name }).expect("missing MIR function {function_name}")
            function.blocks.flat_map(fn(b) { b.instructions }).any(fn(i) { if i.operation == { .Enum{type_id: owner, variant, ..} -> owner == type_id && variant == variant_name else -> false } })
        }
        assert(has_enum("net_err", net_error.id, "InvalidInput"))
        assert(has_enum("dns_err", net_error.id, "DNS"))
        assert(has_enum("dns_err", net_dns_error.id, "NotFound"))
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:2353
#Test("mir_is_finite_selects_math_runtime_part") {
    run_on_compiler_stack(fn() {
        src :: "fn checked(x: Float) -> Bool {\n return x.is_finite()\n}\nfn run() { print(checked(1.0)) }\n"
        bundle :: checked_bundle(src)
        request :: MIRArtifactRequest.new(MIRArtifactTarget.RustAot, MIRArtifactKind.NativeExecutable, MIRArtifactBuildMode.Dev)
        (mir, _) :: lower_checked_mir_program_for(bundle, request).expect("is_finite failed to lower to MIR")
        assert(mir.artifacts.any(fn(a) { a.runtime_parts.contains(MIRRuntimePartID.Math) }), "Float.is_finite must select the Math runtime part so AOT emits jet_std_math_is_finite")
        assert(mir.prelude_calls.any(fn(row) { row.symbol.name() == "jet_std_math_is_finite" }), "Float.is_finite must intern the Prelude symbol jet_std_math_is_finite")
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:2383
#Test("mir_lowers_user_struct_and_instance_method") {
    run_on_compiler_stack(fn() {
        src :: "pub struct Gauge {\n n: Int\n}\nfn Gauge.value(self) -> Int { self.n }\nfn run() {\n v :: Gauge{ n: 1 }\n print(\"{v.value()}\")\n}\n"
        bundle :: checked_bundle(src)
        request :: MIRArtifactRequest.new(MIRArtifactTarget.RustAot, MIRArtifactKind.NativeExecutable, MIRArtifactBuildMode.Dev)
        (mir, _) :: lower_checked_mir_program_for(bundle, request).expect("user struct method failed to lower to MIR")
        mir.validate().expect("user struct MIR failed validate")
        method :: mir.functions.find(fn(f) { f.name == "Gauge::value" || f.name.ends_with("::value") || f.name == "value" }).expect("instance method value")
        assert(if method.form == { .Method{self_access: Val(_), ..} -> true else -> false }, "value must be an instance method, got {method.form:?}")
        receiver :: method.params.first().expect("instance method must declare parameter 0")
        assert(receiver.name == KW_SELF && receiver.index == 0)
        assert(mir.impls.any(fn(row) { row.trait_ref.is_none() && row.methods.contains(method.id) }), "instance method must belong to an inherent impl row so AOT can emit it")
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:2431
#Test("mir_resolves_same_named_methods_on_indexed_receivers") {
    run_on_compiler_stack(fn() {
        src :: "struct First { value: Int }\nstruct Second { value: Int }\nfn Second.mark(&self, delta: Int) -> Int { self.value + delta * 10 }\nfn First.mark(&self, delta: Int) -> Int { self.value + delta }\nfn run() {\n    firsts := [First]{ First{ value: 1 } }\n    seconds := [Second]{ Second{ value: 2 } }\n    first_value :: &firsts[0].mark(3)\n    second_value :: &seconds[0].mark(4)\n    print(\"{first_value}:{second_value}\")\n}\n"
        bundle :: checked_bundle(src)
        request :: MIRArtifactRequest.new(MIRArtifactTarget.RustAot, MIRArtifactKind.NativeExecutable, MIRArtifactBuildMode.Dev)
        (mir, _) :: lower_checked_mir_program_for(bundle, request).expect("indexed same-name methods failed")
        mir.validate().expect("indexed same-name MIR failed validate")
        called_method_names := [String:Bool]{}
        run :: mir.functions.find(fn(f) { f.name == "run" || f.name.ends_with("::run") }).expect("run function")
        // Build an ID index once instead of repeatedly scanning every function.
        functions := [MIRFunctionID:MIRFunction]{}
        loop f in mir.functions -> &functions.insert(f.id, f)
        loop instruction in run.blocks.flat_map(fn(b) { b.instructions }) {
            if instruction.operation == .Call{callee: .Method{function, ..}, ..} {
                if functions.get(function) == .Val(target) {
                    name :: if target.name == "First::mark" || target.name.ends_with("::First::mark") -> "First::mark" else -> if target.name == "Second::mark" || target.name.ends_with("::Second::mark") -> "Second::mark" else -> target.name
                    &called_method_names.insert(name, true)
                }
            }
        }
        assert(called_method_names == [String:Bool]{"First::mark": true, "Second::mark": true})
    })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:2497
#Test("mir_lowers_computed_field_getter_onto_inherent_impl") {
    run_on_compiler_stack(fn() {
        src :: "struct Stats {\n n: Int\n doubled: Int -> n * 2\n}\nfn run() {\n s :: Stats{ n: 1 }\n print(\"{s.doubled}\")\n}\n"
        bundle :: checked_bundle(src)
        request :: MIRArtifactRequest.new(MIRArtifactTarget.RustAot, MIRArtifactKind.NativeExecutable, MIRArtifactBuildMode.Dev)
        (mir, _) :: lower_checked_mir_program_for(bundle, request).expect("computed field failed to lower to MIR")
        mir.validate().expect("computed field MIR failed validate")
        method :: mir.functions.find(fn(f) { f.name == "Stats::doubled" || f.name.ends_with("::doubled") || f.name == "doubled" }).expect("computed field getter doubled")
        assert(if method.form == { .Method{..} -> true else -> false }, "computed getter must be an inherent method, got {method.form:?}")
        assert(mir.impls.any(fn(row) { row.trait_ref.is_none() && row.methods.contains(method.id) }), "computed field getter must belong to an inherent impl row")
    })
}

