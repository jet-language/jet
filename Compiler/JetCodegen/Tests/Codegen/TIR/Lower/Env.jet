use jet_foundation.[Type, TLocal, TIntegerBounds]
use jet_codegen.Codegen.TIR.Lower.Env.LowerEnv
use jet_codegen.Codegen.TIR.Lower.Panic.clone_env

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:102-284; no original inline tests.
#Test("lower_env_keeps_partial_types_and_clears_both_materialized_view_marks") {
    env := LowerEnv.new("function")
    &env.bind("item", TLocal.user("item"), None)
    assert_eq(env.ty_of("item"), None)
    &env.mark_string_view("item")
    &env.mark_split_view("item", Type.Named("View"))
    assert(env.is_string_view_local("item"))
    assert_eq(env.split_view_handle("item"), Val(Type.Named("View")))
    &env.clear_view_marks("item")
    assert(!env.is_string_view_local("item"))
    assert_eq(env.split_view_handle("item"), None)
    &env.bind("ref", TLocal.user("ref").through_ref(), Val(Type.Int))
    assert(env.is_borrowed("ref"))
    &env.mark_borrowed("item")
    assert(env.is_borrowed("item"))
    &env.set_integer_bounds("item", Val(TIntegerBounds{lo: 2, hi: 5}))
    assert_eq(env.integer_bounds_of("item"), Val(TIntegerBounds{lo: 2, hi: 5}))
    &env.set_integer_bounds("item", None)
    assert_eq(env.integer_bounds_of("item"), None)
    assert_eq(env.local_of("unbound").name, "unbound")
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/env.rs:164-194; panic.rs:11
#Test("child_env_shares_resource_and_stack_facts_but_not_lexical_bindings") {
    root := LowerEnv.new("function")
    child := clone_env(root)
    &child.bind("temporary", TLocal.user("temporary"), Val(Type.String))
    assert_eq(root.ty_of("temporary"), None)
    child.note_stack_address()
    assert(root.stack_sentry_needed())
    taken :: child.resource_take_place("resource")
    assert(root.resource_take_targets().contains(taken.rust_name()))
    &child.note_clone(Type.Int)
    assert_eq(root.cloned_types.borrow().len(), 1)
    assert_eq(root.cloned_types.borrow()[0], Type.Int)
}
