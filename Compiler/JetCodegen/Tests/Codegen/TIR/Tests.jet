// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:897
pub fn covers_with_core_import(src: String, fn_name: String, alias: String, module: String) -> Bool {
    return CompilerStack.run_on_compiler_stack(fn() {
        (toks, lex_diags) :: lex(src)
        assert(lex_diags.is_empty(), "lex errors: {lex_diags:?}")
        prog :: parse(toks).expect("parse failed")
        cx := build_cx(prog, src, "test.jet")
        cx.core_imports.insert(alias, module)
        f :: prog.items.iter().find_map(fn(i) {
            if i == { .Func(f) -> { if f.name == fn_name { return Val(f) } }; else -> {} }
            return None
        }).expect("no fn {fn_name}")
        return tir_covers(f, cx)
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:962
pub fn covers_with_foreign(src: String, fn_name: String, foreign: [(String, String)]) -> Bool {
    return CompilerStack.run_on_compiler_stack(fn() {
        (toks, lex_diags) :: lex(src)
        assert(lex_diags.is_empty(), "lex errors: {lex_diags:?}")
        prog :: parse(toks).expect("parse failed")
        cx := build_cx(prog, src, "test.jet")
        for (ty, module) in foreign { cx.foreign_types.insert(ty, module) }
        f :: prog.items.iter().find_map(fn(i) {
            if i == { .Func(f) -> { if f.name == fn_name { return Val(f) } }; else -> {} }
            return None
        }).expect("no fn {fn_name}")
        return tir_covers(f, cx)
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:1762
pub fn stable_loop_probe(src: String) -> ([String: USize], USize) {
    (mir, rust) :: emitted_rust(src)
    cursors: [String: USize] := [:]
    for function in mir.functions {
        count: USize := 0
        for block in function.blocks {
            for instruction in block.instructions {
                if instruction.operation == { .LoopIterInit(..) -> { count += 1 }; else -> {} }
            }
        }
        cursors.insert(function.name, count)
    }
    return (cursors, non_scalar_clone_count(rust))
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:1786
pub fn emitted_rust(src: String) -> (MirProgram, String) {
    bundle :: checked_bundle(src)
    request :: MirArtifactRequest.new(MirArtifactTarget.RustAot, MirArtifactKind.NativeExecutable, MirArtifactBuildMode.Dev)
    (mir, artifact) :: lower_checked_mir_program_for(bundle, request).unwrap_or_else(fn(err) { panic("probe failed to lower: {err:?}") })
    mir.validate().unwrap_or_else(fn(err) { panic("probe failed validation: {err}") })
    execution := MirRustExecutionConfig.for_artifact(artifact)
    execution.emit_types = false
    execution.emit_runtime = false
    rust :: emit_mir_program(mir, MirRustConfig{
        target: TargetLayout.host(), target_kind: MirRustTarget.Native,
        root_prefix: "", execution: execution
    })
    return (mir, rust)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:6
#Test("fact_channel_prefers_exact_literal_bounds_over_carrier_range") {
    expr :: TExpr{ty: Type.InlineRange{base: Type.Int, lo: 1, hi: 10}, kind: TExprKind.IntLit(7, None)}
    assert(expr.fact_channel().integer_bounds == Val(TIntegerBounds.exact(7)))
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:22
#Test("outcome_cost_facts_distinguish_carriers_and_fast_paths") {
    int_expr :: fn() { TExpr{ty: Type.Int, kind: TExprKind.IntLit(1, None)} }
    result_ty :: Type.Result{ok: Type.Int, err: Type.String}
    explicit :: TExpr{ty: result_ty, kind: TExprKind.Ok(int_expr())}
    assert(explicit.fact_channel().cost == Val(TCostFact.semantic(TCostKind.OutcomeConstruction)))
    call :: TExpr{ty: result_ty, kind: TExprKind.Call{name: "load", type_args: [], args: []}}
    assert(call.fact_channel().cost == Val(TCostFact.semantic(TCostKind.OutcomeConstruction)))
    fast :: TExpr{ty: Type.Option(Type.Int), kind: TExprKind.BuiltinMethod{
        recv: TExpr{ty: Type.Named("Bytes"), kind: TExprKind.Unit},
        op: TBuiltinOp.ByteBufferMethod{method: "next"}, args: []
    }}
    assert(fast.fact_channel().cost == Val(TCostFact.semantic(TCostKind.OutcomeConstruction)))
    fallback :: TExpr{ty: Type.Int, kind: TExprKind.OrFallback{value: fast, fallback: TOrFallback.Value(int_expr())}}
    sites := []
    collect_cost_expr(fallback, "run", Span.new(0, 0), 0, &sites)
    assert(sites.len() == 1)
    assert(sites[0].kind == TCostKind.OutcomeConstruction)
    assert(sites[0].state == TCostState.OptimizerRemoved)
}

