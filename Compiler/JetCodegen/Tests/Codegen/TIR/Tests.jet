// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:106
// Direct gate helpers sit below the public compiler-stack funnels. Hop through
// the same re-entrant boundary before recursive structural lowering.
pub fn covers(src: String, fn_name: String) -> Bool {
    return CompilerStack.run_on_compiler_stack(fn() {
        (toks, lex_diags) :: lex(src)
        assert(lex_diags.is_empty(), "lex errors: {lex_diags:?}")
        prog :: parse(toks).expect("parse failed")
        cx :: build_cx(prog, src, "test.jet")
        f :: prog.items.iter().find_map(fn(i) {
            if i == { .Func(f) -> { if f.name == fn_name { return Val(f) } }; else -> {} }
            return None
        }).expect("no fn {fn_name}")
        return tir_covers(f, cx)
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:132
pub fn refusal_for(src: String, fn_name: String) -> String {
    return CompilerStack.run_on_compiler_stack(fn() {
        (toks, lex_diags) :: lex(src)
        assert(lex_diags.is_empty(), "lex errors: {lex_diags:?}")
        prog :: parse(toks).expect("parse failed")
        cx :: build_cx(prog, src, "test.jet")
        f :: prog.items.iter().find_map(fn(i) {
            if i == { .Func(f) -> { if f.name == fn_name { return Val(f) } }; else -> {} }
            return None
        }).expect("no fn {fn_name}")
        assert(!tir_covers(f, cx), "fn {fn_name} is covered, so there is no refusal to report")
        return refusal.describe(cx)
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:236
pub fn checked_bundle(src: String) -> ProgramBundle {
    (toks, lex_diags) :: lex(src)
    assert(lex_diags.is_empty(), "lex errors: {lex_diags:?}")
    prog := parse(toks).expect("parse failed")
    bundle := ProgramBundle{
        entry: 0, project_root: OSPath.from("."),
        modules: [LoadedModule{
            path: OSPath.from("test.jet"), display: "test.jet", alias: "main",
            imports: mem.take(&prog.imports), items: mem.take(&prog.items),
            script_body: mem.take(&prog.script_body), block_spans: mem.take(&prog.block_spans),
            source: src, web_target_ceiling: prog.web_target_ceiling,
            pub_file: prog.pub_file, no_prelude: prog.no_prelude,
            default_target: prog.default_target, html_path: prog.html_path,
            policy_declarations: prog.policy_declarations,
            user_policy_declarations: prog.user_policy_declarations,
            rule_facts: mem.take(&prog.rule_facts)
        }],
        devtools_registry: DevtoolsRegistry.default(), parse_teaching: [],
        used_core: Set.new(), ffi_callback_fns: Set.new(), cffi: CFfi.default(),
        comptime_inputs: [], name_ledger: NameLedger.default(), layer_ceiling: None,
        inferred_layer: RuntimeLayer.Core, web_partitions: [:],
        web_partition_enforced: false, web_partition_report: None, dep_roots: [:],
        package_guarantees: Default.default(), program_allocator: Default.default(),
        active_os: OSTarget.host(), build_facts: Default.default(), edition: "2027"
    }
    // Install the production MIR comptime bridge; fragments need Check, not Run.
    install_mir_bridge()
    diags :: check_bundle(&bundle, CompileMode.Check)
    assert(!diags.iter().any(fn(d) { d.severity == JetFoundation.Diagnostics.Severity.Error }), "sema errors: {diags:?}")
    return bundle
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:300
pub fn covers_after_sema(src: String, fn_name: String) -> Bool {
    return CompilerStack.run_on_compiler_stack(fn() {
        bundle :: checked_bundle(src)
        module :: bundle.modules[bundle.entry]
        cx := build_cx_items(module.items, src, "test.jet", None, [:], bundle.edition)
        populate_cx_from_bundle(&cx, bundle, bundle.entry)
        f :: module.items.iter().find_map(fn(i) {
            if i == { .Func(f) -> { if f.name == fn_name { return Val(f) } }; else -> {} }
            return None
        }).expect("no fn {fn_name}")
        return tir_covers(f, cx)
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:325
pub fn refusal_after_sema(src: String, fn_name: String) -> String {
    return CompilerStack.run_on_compiler_stack(fn() {
        bundle :: checked_bundle(src)
        module :: bundle.modules[bundle.entry]
        cx := build_cx_items(module.items, src, "test.jet", None, [:], bundle.edition)
        populate_cx_from_bundle(&cx, bundle, bundle.entry)
        f :: module.items.iter().find_map(fn(i) {
            if i == { .Func(f) -> { if f.name == fn_name { return Val(f) } }; else -> {} }
            return None
        }).expect("no fn {fn_name}")
        covered :: tir_covers(f, cx)
        detail :: refusal.describe(cx)
        return "covered={covered}; core_imports={cx.core_imports:?}; {detail}"
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:356
pub fn lower_after_sema(src: String, fn_name: String) -> TFunc {
    return CompilerStack.run_on_compiler_stack(fn() {
        bundle :: checked_bundle(src)
        module :: bundle.modules[bundle.entry]
        cx := build_cx_items(module.items, src, "test.jet", None, [:], bundle.edition)
        populate_cx_from_bundle(&cx, bundle, bundle.entry)
        f :: module.items.iter().find_map(fn(item) {
            if item == { .Func(f) -> { if f.name == fn_name { return Val(f) } }; else -> {} }
            return None
        }).expect("no fn {fn_name}")
        return lower_func(f, cx)
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:784
pub fn covers_method(src: String, type_name: String, method: String) -> Bool {
    return CompilerStack.run_on_compiler_stack(fn() {
        (toks, lex_diags) :: lex(src)
        assert(lex_diags.is_empty(), "lex errors: {lex_diags:?}")
        prog :: parse(toks).expect("parse failed")
        cx :: build_cx(prog, src, "test.jet")
        methods :: prog.items.iter().find_map(fn(i) {
            if i == {
                .Struct(s) -> { if s.name == type_name { return Val(s.methods) } }
                .Enum(e) -> { if e.name == type_name { return Val(e.methods) } }
                else -> {}
            }
            return None
        }).expect("no type {type_name}")
        f :: methods.iter().find(fn(m) { m.name == method }).expect("no method {type_name}{method}")
        return tir_covers_method(f, type_name, cx)
    })
}

