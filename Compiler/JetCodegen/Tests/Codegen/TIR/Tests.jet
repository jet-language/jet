// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:191
#Test("compiler_fact_pattern_fold_does_not_claim_user_enums") {
    span :: Span.new(0, 0)
    fact_value :: Expr.ComptimeName{name: "method_maturity", span: span,
        value: Val(CtValue.Enum{type_name: "Maturity", variant: "Experimental", args: []})}
    pattern :: Pattern.Variant{variant: "Experimental", bindings: [], leading_dot: true, span: span}
    assert(fold_typed_fact_enum_pattern(fact_value, pattern) == Val(true))
    user_value :: Expr.EnumLit{type_name: "Maturity", variant: "Experimental", variant_span: None,
        args: [], leading_dot: false, span: span}
    assert(fold_typed_fact_enum_pattern(user_value, pattern).is_none(), "a user enum must not be folded as a compiler fact")
    assert(fold_typed_fact_enum_equality(BinOp.Eq, user_value, user_value).is_none(), "the binary route must preserve the same user-enum ownership wall")
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:383
#Test("loaded_core_source_signatures_include_transitive_files_calls") {
    // Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:384
    fn loaded_module(alias: String, source: String) -> LoadedModule {
        (tokens, diagnostics) :: lex(source)
        assert(diagnostics.is_empty(), "lex errors: {diagnostics:?}")
        program := parse(tokens).expect("parse failed")
        return LoadedModule{
            path: OSPath.from("{alias}.jet"), display: "{alias}.jet", source: source, alias: alias,
            imports: mem.take(&program.imports), items: mem.take(&program.items),
            script_body: mem.take(&program.script_body), block_spans: mem.take(&program.block_spans),
            web_target_ceiling: program.web_target_ceiling, pub_file: program.pub_file,
            no_prelude: program.no_prelude, default_target: program.default_target,
            html_path: program.html_path, policy_declarations: program.policy_declarations,
            user_policy_declarations: program.user_policy_declarations, rule_facts: mem.take(&program.rule_facts)
        }
    }
    files :: CoreModuleExports.core_source_module("core.files").expect("core.files source module")
    files_path :: CoreModuleExports.core_source_module("core.files.path").expect("core.files.path source module")
    modules :: [loaded_module("caller", "use core.files.path.[Path]\nfn run() {{}}"),
        loaded_module(files_path.alias, "use core.files as files"),
        loaded_module(files.alias, "pub fn read_lines(path: String) -> [String] {{ [String]{{}} }}\npub fn write_lines(path: String, lines: [String]) {{}}")]
    bundle :: ProgramBundle{
        entry: 0, project_root: OSPath.new(), modules: modules,
        devtools_registry: DevtoolsRegistry.default(), parse_teaching: [], used_core: Set.new(),
        ffi_callback_fns: Set.new(), cffi: CFfi.default(), comptime_inputs: [], name_ledger: NameLedger.default(),
        layer_ceiling: None, inferred_layer: RuntimeLayer.Core, web_partitions: [:],
        web_partition_enforced: false, web_partition_report: None, dep_roots: [:],
        package_guarantees: Default.default(), program_allocator: Default.default(),
        active_os: OSTarget.host(), build_facts: Default.default(), edition: "2026"
    }
    signatures :: core_source_sig_map(bundle)
    read :: signatures.get(("core.files", "read_lines")).expect("loaded core.files.read_lines signature")
    assert(read.params.len() == 1)
    assert(read.params[0].1 == Type.String)
    assert(read.return_type == Val(Type.List(Type.String)))
    write :: signatures.get(("core.files", "write_lines")).expect("loaded core.files.write_lines signature")
    assert(write.params.len() == 2)
    assert(write.params[0].1 == Type.String)
    assert(write.params[1].1 == Type.List(Type.String))
    assert(write.return_type.is_none())
}

