// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:1028
#Test("covers_fixed_list_param_and_field") {
    mk :: fn(src: String) {
        (toks, _) :: lex(src)
        prog :: parse(toks).expect("parse")
        return build_cx(prog, src, "test.jet")
    }
    fl :: Type.FixedList{elem: Type.Int, len: Measure.literal("length", 3)}
    assert(is_subset_param_ty(fl, mk("fn f(){{}}")))
    assert(is_covered_collection_ty(fl, mk("fn f(){{}}")))
    assert(collection_elem_covered(fl, mk("fn f(){{}}")))
    src :: "struct Grid {{ row: [Int#3] }}\nfn f(){{}}"
    assert(is_covered_struct_ty(Type.Named("Grid"), mk(src)))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:1057
#Test("rejects_list_of_tuple_with_unsupported_nested_option") {
    mk :: fn(src: String) {
        (toks, _) :: lex(src)
        prog :: parse(toks).expect("parse")
        return build_cx(prog, src, "test.jet")
    }
    good_tuple :: Type.Tuple([("x", Type.Int), ("y", Type.Float)])
    good_list :: Type.List(good_tuple)
    cx :: mk("fn f(){{}}")
    assert(is_covered_collection_ty(good_list, cx))
    tuple :: Type.Tuple([("ok", Type.Int), ("bad", Type.List(Type.Option(Type.Int)))])
    list :: Type.List(tuple)
    if list == {
        .List(inner) -> { assert(!collection_elem_covered(inner, cx)) }
        else -> panic("test list is constructed as Type.List")
    }
    assert(!is_covered_collection_ty(list, cx))
}
