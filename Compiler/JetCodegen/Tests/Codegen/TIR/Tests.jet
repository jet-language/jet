// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:499
#Test("explicit_run_is_lowered_as_the_canonical_run_function") {
    source :: "fn run() {{ print(\"script\") }}\nfn helper() {{}}\n"
    bundle :: checked_bundle(source)
    module :: bundle.modules[bundle.entry]
    assert(module.script_body.is_empty())
    runs :: module.items.iter().filter_map(fn(item) {
        if item == { .Func(function) -> { if function.name == "run" { return Val(function) } }; else -> {} }
        return None
    }).collect()
    assert(runs.len() == 1, "the explicit run must be the sole ordinary run")
    run :: runs[0]
    assert(run.params.is_empty(), "run must have no parameters")
    assert(!run.is_job && !run.is_unsafe && !run.is_reactive)
    assert(run.return_type == Val(Type.Result{ok: Type.Named(INTERNAL_UNIT_TYPE), err: Type.Named(TYPE_NEVER)}))
    prints :: run.body.iter().filter(fn(stmt) {
        return if stmt == { .Expr(.Call(call)) -> call.name == "print"; else -> false }
    }).count()
    assert(prints == 1, "the explicit run operation must enter run exactly once")
    helpers :: module.items.iter().filter_map(fn(item) {
        if item == { .Func(function) -> { if function.name == "helper" { return Val(function) } }; else -> {} }
        return None
    }).collect()
    assert(helpers.len() == 1, "same-line declarations stay file-wide")
    assert(helpers[0].span.start >= run.span.end)
    assert(helpers[0].body.is_empty())
    lowered :: lower_after_sema(source, "run")
    assert(lowered.name == "run")
    assert(lowered.kind == TFuncKind.TopLevel)
    assert(lowered.ret == Val(Type.Result{ok: Type.Named(INTERNAL_UNIT_TYPE), err: Type.Named(TYPE_ERR)}), "canonical fallible unit return must survive TIR lowering")
    markers :: lowered.body.iter().filter(fn(stmt) { return if stmt == { .SourceSpan(_) -> true; else -> false } }).count()
    assert(markers == 1, "TIR must retain one source statement marker for the explicit run operation")
    printed :: lowered.body.iter().filter_map(fn(stmt) {
        if stmt == { .ExprStmt(expr) -> { if expr.kind == { .Print(value) -> { return Val(value) }; else -> {} } }; else -> {} }
        return None
    }).collect()
    assert(printed.len() == 1, "the explicit run operation must lower exactly once")
    assert(printed[0].kind == TExprKind.StrLit([TStrPart.Lit("script")]))
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:595
#Test("comptime_float_and_string_constants_lower_to_typed_literals") {
    install_mir_bridge()
    lowered :: lower_after_sema("\nfn run() {{\n    narrow :: prep {{ F32{{16777217.0}} }}\n    wide :: prep {{ Float{{2.5}} }}\n    label :: prep {{ \"ready\" }}\n\n    print(narrow)\n    print(wide)\n    print(label)\n}}\n", "run")
    literals :: lowered.body.iter().filter_map(fn(stmt) {
        if stmt == { .Let(init: init, ..) -> { return Val(init) }; else -> {} }
        return None
    }).collect()
    assert(literals.len() == 3)
    assert(literals[0].ty == Type.Float32)
    assert(literals[0].kind == TExprKind.FloatLit(16777216.0))
    assert(literals[1].ty == Type.Float)
    assert(literals[1].kind == TExprKind.FloatLit(2.5))
    assert(literals[2].ty == Type.String)
    assert(literals[2].kind == TExprKind.StrLit([TStrPart.Lit("ready")]))
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:642
#Test("regex_find_all_counts_chain_preserves_receiver_result") {
    lowered :: lower_after_sema("fn scan(text: String) {{\n    counts :: Regex{{\"[A-Za-z]+\"}}.find_all(text).counts()\n}}\n", "scan")
    init :: lowered.body.iter().find_map(fn(stmt) {
        if stmt == { .Let(name: name, init: init, ..) -> { if name == "counts" { return Val(init) } }; else -> {} }
        return None
    }).expect("counts binding should lower as a let")
    // Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:658
    fn strip_ownership(expr: TExpr) -> TExpr {
        if expr.kind == {
            .Clone(inner, _) | .ExplicitCopy(inner) | .MaterializeView(inner) -> { return strip_ownership(inner) }
            else -> { return expr }
        }
    }
    if strip_ownership(init).kind == {
        .BuiltinMethod(op: .Counts, ..) -> {}
        .BuiltinMethod(..) -> panic("counts chain lowered to another builtin")
        .MethodCall(..) -> panic("counts chain remained a user method call")
        .CoreCall(..) -> panic("counts chain lowered to a core call")
        .Call(..) -> panic("counts chain lowered to a plain call")
        .InlineBlock(_) -> panic("counts chain lowered inside an inline block")
        else -> panic("counts chain lowered to an unrelated expression")
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:681
#Test("refined_collection_results_have_exact_tir_types") {
    src :: "fn run() {{\n    folded := [1, 2].fold(0.5, (a: Decimal, n: Int) -> a + 0.5)\n    reduced := [1, 2].reduce(0.5, (a: Decimal, n: Int) -> a + 0.5)\n    scanned := [1, 2].scan(0.5, (a: Decimal, n: Int) -> a + 0.5)\n    mapped := [1, 2].map((n: Int) -> 1.5)\n    filtered := [\"1.5\", \"bad\"].filter_map((s: String) -> Decimal(s))\n    flattened := [1, 2].flat_map((n: Int) -> [1.5])\n    grouped := [1, 2].group_by((n: Int) -> n % 2 == 0)\n    counted := [1, 2].count_by((n: Int) -> n % 2)\n    parallel := [1, 2].para_fold(() -> 0.5, (a: Decimal, n: Int) -> a + 0.5, (left: Decimal, right: Decimal) -> left + right)\n    grouped_string_get := [1, 2].group_by((n: Int) -> \"x\").get(\"x\")\n    counted_string_get := [1, 2].count_by((n: Int) -> \"x\").get(\"x\")\n}}\n"
    lowered :: lower_after_sema(src, "run")
    lets :: lowered.body.iter().filter(fn(stmt) { return if stmt == { .Let(..) -> true; else -> false } }).collect()
    actual :: lets.iter().filter_map(fn(stmt) {
        if stmt == { .Let(init: init, ..) -> { return Val(init.ty) }; else -> {} }
        return None
    }).collect()
    decimal :: Type.Named(TYPE_DECIMAL)
    assert(actual == [decimal, decimal, iter_ty(decimal), Type.List(decimal), iter_ty(decimal), Type.List(decimal),
        Type.Map{key: Type.Bool, key_span: None, value: Type.List(Type.Int)},
        Type.Map{key: Type.Int, key_span: None, value: Type.Int}, decimal,
        Type.Option(Type.List(Type.Int)), Type.Option(Type.Int)])
    // Non-Let statements must not shift the final two GetMap pins.
    assert(if lets[9] == { .Let(init: init, ..) -> if init.kind == { .BuiltinMethod(op: .GetMap, ..) -> true; else -> false }; else -> false })
    assert(if lets[10] == { .Let(init: init, ..) -> if init.kind == { .BuiltinMethod(op: .GetMap, ..) -> true; else -> false }; else -> false })
}

