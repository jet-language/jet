// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:1603
#Test("compiler_owned_core_enum_rows_reuse_checked_source_payloads") {
    source :: CoreModuleExports.core_source_module("core.http").expect("Core HTTP source module")
    body :: core_source_text(source.module).expect("Core HTTP body")
    source_for_parse :: mask_inline_package_source(body).expect("Core HTTP package header").0
    (tokens, lex_diags) :: lex(source_for_parse)
    assert(lex_diags.is_empty(), "Core HTTP lex errors: {lex_diags:?}")
    (program, _) :: parse_for_check_with_source(tokens, source_for_parse).expect("Core HTTP source parses")
    method := program.items.into_iter().find_map(fn(item) {
        if item == { .Enum(definition) -> { if definition.name == "Method" { return Val(definition) } }; else -> {} }
        return None
    }).expect("Core HTTP Method declaration")
    path :: source.path.strip_suffix(".jet").expect("Core source path suffix")
    identity :: "<corelib>/{path}::Method"
    method.name = identity
    checked_nominals := MirFragmentNominalFacts.default()
    checked_nominals.foreign_modules.insert(identity, source.alias)
    checked_nominals.enums.insert(identity, method)
    declarations :: lower_declarations_from_items_with_boxed_edges([], "", TargetLayout.host(), Set.new(), Set.new(), Set.new(), Val(checked_nominals))
    method :: declarations.type_defs.iter().find(fn(definition) { definition.key == "Method" }).expect("compiler-owned Core Method type row")
    if method.kind == {
        .Enum(variants: variants, ..) -> {
            expected :: CoreModuleExports.core_enum_variants("Method").expect("Core Method variant export names")
            assert(variants.iter().map(fn(variant) { variant.name }).collect() == expected)
            custom :: variants.iter().find(fn(variant) { variant.name == "Custom" }).expect("Method.Custom variant")
            assert(custom.payload == TirVariantPayload.Single(Type.String))
            assert(variants.iter().filter(fn(variant) { variant.name != "Custom" }).all(fn(variant) { variant.payload == TirVariantPayload.Unit }), "only Method.Custom has a payload")
        }
        else -> panic("Core Method must be an enum row")
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:1682
#Test("compiler_owned_default_err_is_a_struct_row") {
    declarations :: lower_declarations_from_items([], "", TargetLayout.host())
    err :: declarations.type_defs.iter().find(fn(ty) { ty.key == TYPE_ERR }).expect("default Err must be a compiler-owned type row")
    kind :: "{err.kind:?}"
    assert(kind.starts_with("Struct"), "default Err must be a struct, got {kind}")
    for field in ["message", "code", "cause"] {
        assert(kind.contains(field), "default Err missing field {field} in {kind}")
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:1706
#Test("compiler_owned_core_ui_registry_has_nominal_rows") {
    declarations :: lower_declarations_from_items([], "", TargetLayout.host())
    for entry in CoreModuleExports.core_modules().iter().filter(fn(entry) { entry.module == "core.ui" || entry.module == "core.ui.host" }) {
        for (name, _) in entry.type_exports {
            if core_ui_rust_type_name(name).is_some() {
                assert(declarations.type_defs.iter().any(fn(row) { row.key == name }), "Core UI type {name} must have a canonical TIR declaration row")
            }
        }
    }
    shortcut :: declarations.type_defs.iter().find(fn(row) { row.key == "UIShortcut" }).expect("UIShortcut must have a canonical declaration row")
    if shortcut.kind == {
        .Struct(fields: fields, ..) -> { assert(fields.iter().map(fn(field) { field.name }).collect() == ["key", "modifiers"]) }
        else -> panic("UIShortcut must lower as a struct row")
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/tests.rs:1744
#Test("mir_lowers_default_err_return") {
    CompilerStack.run_on_compiler_stack(fn() {
        src :: "fn f(x: Int) -> Int Err! {{\n if x == 0 {{\n return Err(\"bad\")\n }}\n return Ok(x)\n}}\nfn run() {{}}\n"
        bundle :: checked_bundle(src)
        request :: MirArtifactRequest.new(MirArtifactTarget.RustAot, MirArtifactKind.NativeExecutable, MirArtifactBuildMode.Dev)
        _ :: lower_checked_mir_program_for(bundle, request).unwrap_or_else(fn(err) { panic("default Err return failed to lower to MIR: {err:?}") })
    })
}
