struct SendFromCleanup { sender: JetSchedulerSender<I64>, delivered: Arc<AtomicBool> }
// Rust: crates/jet-codegen/src/SchedulerHost.rs:346
impl Drop for SendFromCleanup {
    fn drop(self: &SendFromCleanup) -> Unit Never! { self.delivered.store(self.sender.send(7), Ordering.Release) }
}
// Rust: crates/jet-codegen/src/SchedulerHost.rs:337
#Test("a_cancel_reached_from_cleanup_defers_instead_of_aborting") {
    channel :: JetSchedulerChannel<I64>.new()
    delivered :: Arc.new(AtomicBool.new(false))
    control :: JetTaskControl.new()
    control.cancel()
    jet_scheduler_set_task_control(Val(control))
    jet_scheduler_task_panic_enter()
    cleanup_delivered :: Arc.clone(&delivered)
    sender :: channel.sender()
    payload :: panic.catch_unwind(panic.AssertUnwindSafe(fn() {
        _cleanup :: SendFromCleanup(sender: sender, delivered: cleanup_delivered)
        panic.panic_any("producer failure")
    })).expect_err("the original unwind must reach the task frame")
    assert(payload.downcast_ref<String>().copied() == Val("producer failure"), "a cancel observed during cleanup must not replace the in-flight failure")
    assert(delivered.load(Ordering.Acquire), "a wait point reached from drop glue must complete instead of raising")
    assert(channel.try_receive() == Val(7))
    assert(!jet_scheduler_shielded(), "the cleanup deferral lasts exactly as long as the unwind")
    raised :: panic.catch_unwind(panic.AssertUnwindSafe(fn() { channel.sender().send(8) })).expect_err("a cancelled wait point must still unwind outside cleanup")
    assert(jet_scheduler_is_cancel_unwind(raised.as_ref()), "deferral must preserve the live wait point payload")
    assert(channel.try_receive() == None)
    jet_scheduler_task_panic_leave()
    jet_scheduler_set_task_control(None)
}
// Rust: crates/jet-codegen/src/SchedulerHost.rs:397
#Test("stream_producer_failure_still_completes_consumer") {
    (sender, consumer) := jet_stream<I64>()
    producer :: thread.spawn(fn() {
        result :: panic.catch_unwind(panic.AssertUnwindSafe(fn() {
            assert(sender.send_stream(1))
            panic.panic_any("producer failure")
        }))
        if result.is_err() -> sender.fail()
    })
    assert(consumer.pull() == Val(1))
    assert(consumer.pull() == None)
    assert(consumer.failed())
    drop(^consumer)
    producer.join().unwrap()
}
