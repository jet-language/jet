use jet_codegen.Entry.scheduler.*
use jet_codegen.Entry.task_group as jet_std
use std.sync.[Arc, Mutex, OnceLock, mpsc]
use std.sync.atomic.[AtomicBool, AtomicUsize, Ordering]
use std.time.[Duration, Instant]
use std.[thread, fs, panic]
// GATE #4494: tests exercise real threads, atomics, native unwind and Drop cleanup.

// Rust: crates/jet-codegen/src/SchedulerHost.rs:140
#Test("the_jit_scheduler_is_the_prelude_scheduler") {
    // The retired JIT host's anti-refork guard now checks the shared Jet seam.
    root :: OSPath.new("Compiler/JetCodegen/Source")
    assert(!root.join("scheduler.jet").exists(), "a second scheduler must not shadow Prelude.Scheduler")
    assert(!root.join("scheduler").exists(), "a second scheduler directory must not shadow Prelude.Scheduler")
    entry :: fs.read_to_string(root.join("Entry.jet")).unwrap()
    assert(entry.matches("pub use jet_codegen.Prelude.Scheduler.*").count() == 1)
    assert(entry.matches("pub use jet_codegen.Prelude.Stream.*").count() == 1)
    assert(!root.join("stream.jet").exists(), "use the one Prelude Stream runtime")
    stream :: fs.read_to_string(OSPath.new("crates/jet-codegen/src/Prelude/Stream.rs")).unwrap()
    assert(!stream.contains("StreamControl"), "the producer child's JetTaskControl is the one cancel fact")
    evaluator :: fs.read_to_string(OSPath.new("crates/jet-codegen/src/Codegen/MIREval.rs")).unwrap()
    assert(!evaluator.contains("stream_wait_check") && !evaluator.contains("stream_cancel"), "yield must reach task_wait_check, not a stream-only twin")
}
// Rust: crates/jet-codegen/src/SchedulerHost.rs:195
#Test("stream_pull_releases_exactly_one_yield_at_a_time") {
    events :: Arc.new(Mutex.new([String]{}))
    (sender, consumer) := jet_stream<I64>()
    producer_events :: Arc.clone(&events)
    producer :: thread.spawn(fn() {
        producer_events.lock().unwrap().push("before-1")
        assert(sender.send_stream(1))
        producer_events.lock().unwrap().push("after-1")
        assert(!sender.send_stream(2))
        producer_events.lock().unwrap().push("after-2")
    })
    assert(consumer.pull() == Val(1))
    assert(*events.lock().unwrap() == ["before-1"])
    assert(consumer.pull() == Val(2))
    assert(*events.lock().unwrap() == ["before-1", "after-1"])
    drop(^consumer)
    producer.join().unwrap()
    assert(*events.lock().unwrap() == ["before-1", "after-1", "after-2"])
}
// Rust: crates/jet-codegen/src/SchedulerHost.rs:221
#Test("stream_sender_observes_explicit_consumer_close") {
    (sender, consumer) := jet_stream<I64>()
    (done_tx, done_rx) :: mpsc.sync_channel<Unit>(1)
    producer :: thread.spawn(fn() {
        assert(!sender.send_stream(1))
        done_tx.send(()).unwrap()
    })
    assert(consumer.pull() == Val(1))
    drop(^consumer)
    done_rx.recv_timeout(Duration.from_secs(1)).expect("closed Stream did not release its producer")
    producer.join().unwrap()
}
// Rust: crates/jet-codegen/src/SchedulerHost.rs:239
struct CleanupMark { flag: Arc<AtomicBool> }
// Rust: crates/jet-codegen/src/SchedulerHost.rs:242
impl Drop for CleanupMark {
    fn drop(self: &CleanupMark) -> Unit Never! { self.flag.store(true, Ordering.Release) }
}
// Rust: crates/jet-codegen/src/SchedulerHost.rs:238
#Test("stream_drop_uses_the_shared_task_cancel_cleanup_path") {
    cleaned :: Arc.new(AtomicBool.new(false))
    continued :: Arc.new(AtomicBool.new(false))
    producer_cleaned :: Arc.clone(&cleaned)
    producer_continued :: Arc.clone(&continued)
    stream :: jet_stream_task(fn(sender) {
        _cleanup :: CleanupMark(flag: producer_cleaned)
        assert(sender.send_stream(1))
        producer_continued.store(true, Ordering.Release)
    })
    iterator := stream.into_iter()
    assert(iterator.next() == Val(1))
    drop(^iterator)
    assert(cleaned.load(Ordering.Acquire))
    assert(!continued.load(Ordering.Acquire))
}
// Rust: crates/jet-codegen/src/SchedulerHost.rs:276
// The second Rust-local CleanupMark/drop (279) has the identical body above.
#Test("one_cancel_law_stops_a_stream_producer_and_a_task_child_alike") {
    stream_cleaned :: Arc.new(AtomicBool.new(false))
    stream_continued :: Arc.new(AtomicBool.new(false))
    cleaned :: Arc.clone(&stream_cleaned)
    continued :: Arc.clone(&stream_continued)
    stream :: jet_stream_task(fn(sender) {
        _cleanup :: CleanupMark(flag: cleaned)
        assert(sender.send_stream(1))
        continued.store(true, Ordering.Release)
    })
    iterator := stream.into_iter()
    assert(iterator.next() == Val(1))
    drop(^iterator)
    task_cleaned :: Arc.new(AtomicBool.new(false))
    task_continued :: Arc.new(AtomicBool.new(false))
    cleaned_task :: Arc.clone(&task_cleaned)
    continued_task :: Arc.clone(&task_continued)
    channel :: JetSchedulerChannel<I64>.new()
    parked :: channel.clone()
    control :: JetTaskControl.new()
    join :: jet_scheduler_spawn_with_control(fn() {
        _cleanup :: CleanupMark(flag: cleaned_task)
        _ :: parked.receive()
        continued_task.store(true, Ordering.Release)
    }, control.clone())
    control.cancel()
    if join.rx.recv_timeout(Duration.from_secs(5)) == {
        .Ok(.Cancelled) -> {}
        _ -> panic.panic_any("a cancelled task child must report Cancelled")
    }
    assert((stream_cleaned.load(Ordering.Acquire), stream_continued.load(Ordering.Acquire)) == (task_cleaned.load(Ordering.Acquire), task_continued.load(Ordering.Acquire)), "a stream producer and a task child must be freed by one law")
    assert(stream_cleaned.load(Ordering.Acquire))
    assert(!stream_continued.load(Ordering.Acquire))
}
