// Rust: crates/jet-codegen/src/SchedulerHost.rs:529
fn run_backpressure_scale(n: I64) -> Unit Never! {
    handle :: thread.spawn(fn() {
        before :: jet_scheduler_metric_park_blocks()
        channel :: JetSchedulerChannel<I64>.bounded(1)
        for _ in 0..n {
            sender :: channel.sender()
            _ :: jet_scheduler_spawn(fn() { sender.send(1) })
        }
        total := 0
        for _ in 0..n -> total += channel.receive().expect("channel closed before all sends drained")
        jet_scheduler_drain()
        blocks :: jet_scheduler_metric_park_blocks().saturating_sub(before)
        inner :: channel.select_inner()
        st :: inner.state.lock().unwrap()
        (total, blocks, st.send_waiters.len(), st.recv_waiters.len())
    })
    start :: Instant.now()
    budget :: Duration.from_secs(120)
    while !handle.is_finished() {
        assert(start.elapsed() < budget, "scale workload hung: a park never woke (lost-wake / deadlock)")
        thread.sleep(Duration.from_millis(20))
    }
    (total, blocks, send_leak, recv_leak) :: handle.join().expect("scale worker panicked")
    assert(total == n, "every task's message must be delivered exactly once")
    assert(blocks > 0, "no task ever blocked on a park condvar under capacity-1 backpressure — the scheduler is busy-waiting, not parking")
    assert(send_leak == 0, "send waiters leaked after drain (unbounded growth)")
    assert(recv_leak == 0, "recv waiters leaked after drain (unbounded growth)")
}
// Rust: crates/jet-codegen/src/SchedulerHost.rs:580
#Test("scale_10k_tasks_park_under_backpressure") { run_backpressure_scale(10_000) }
// Rust: crates/jet-codegen/src/SchedulerHost.rs:586
#Ignore("local 100k parked-task scale proof; run with --ignored")
#Test("scale_100k_tasks_park_under_backpressure") { run_backpressure_scale(100_000) }
// Rust: crates/jet-codegen/src/SchedulerHost.rs:595
#Test("pause_holds_a_running_task_at_its_wait_point_until_resume") {
    control :: JetTaskControl.new()
    ready :: JetSchedulerChannel<I64>.new()
    ready_tx :: ready.sender()
    work :: JetSchedulerChannel<I64>.new()
    work_tx :: work.sender()
    progressed :: Arc.new(AtomicUsize.new(0))
    task_progressed :: progressed.clone()
    _join :: jet_scheduler_spawn_with_control(fn() {
        ready_tx.send(1)
        _ :: work.receive()
        task_progressed.fetch_add(1, Ordering.SeqCst)
    }, control.clone())
    assert(ready.receive() == Val(1))
    control.pause()
    work_tx.send(42)
    thread.sleep(Duration.from_millis(60))
    assert(progressed.load(Ordering.SeqCst) == 0, "paused task consumed the value and ran past its wait point — pause is not real")
    control.resume()
    start :: Instant.now()
    while progressed.load(Ordering.SeqCst) == 0 {
        assert(start.elapsed() < Duration.from_secs(5), "resumed task never progressed")
        thread.yield_now()
    }
    jet_scheduler_drain()
}
// Rust: crates/jet-codegen/src/SchedulerHost.rs:649
struct DropMark { outcome: Arc<AtomicUsize> }
// Rust: crates/jet-codegen/src/SchedulerHost.rs:651
impl Drop for DropMark {
    fn drop(self: &DropMark) -> Unit Never! {
        _ :: self.outcome.compare_exchange(0, 2, Ordering.SeqCst, Ordering.SeqCst)
    }
}
// Rust: crates/jet-codegen/src/SchedulerHost.rs:645
#Test("cancel_unwinds_a_parked_task_runs_drop_and_reports_cancelled") {
    control :: JetTaskControl.new()
    ready :: JetSchedulerChannel<I64>.new()
    ready_tx :: ready.sender()
    work :: JetSchedulerChannel<I64>.new()
    outcome :: Arc.new(AtomicUsize.new(0))
    task_outcome :: outcome.clone()
    join :: jet_scheduler_spawn_with_control(fn() {
        _mark :: DropMark(outcome: task_outcome.clone())
        ready_tx.send(1)
        _got :: work.receive()
        task_outcome.store(1, Ordering.SeqCst)
        0
    }, control.clone())
    assert(ready.receive() == Val(1))
    control.cancel()
    start :: Instant.now()
    loop {
        if join.try_recv() == {
            .Val(.Cancelled) -> break
            .Val(other) -> {
                name :: if other == {
                    .Value(_) -> "Value"
                    .Panicked(_) -> "Panicked"
                    .Cancelled -> panic.panic_any("unreachable")
                    .Deadline(_) -> "Deadline"
                }
                panic.panic_any("cancelled task must report Cancelled, got {name}")
            }
            .None -> {
                assert(start.elapsed() < Duration.from_secs(5), "cancel did not unwind the parked task")
                thread.yield_now()
            }
        }
    }
    assert(outcome.load(Ordering.SeqCst) == 2, "unwind must run Drop cleanup and skip the code after the wait point")
    jet_scheduler_drain()
}
// Rust: crates/jet-codegen/src/SchedulerHost.rs:718
#Test("shielded_region_defers_cancel_until_it_exits") {
    control :: JetTaskControl.new()
    ready :: JetSchedulerChannel<I64>.new()
    ready_tx :: ready.sender()
    work :: JetSchedulerChannel<I64>.new()
    work_tx :: work.sender()
    stage :: Arc.new(AtomicUsize.new(0))
    task_stage :: stage.clone()
    join :: jet_scheduler_spawn_with_control(fn() {
        ready_tx.send(1)
        jet_scheduler_shield_enter()
        got :: work.receive()
        if got == Val(42) -> task_stage.store(1, Ordering.SeqCst)
        jet_scheduler_shield_leave()
        task_stage.store(9, Ordering.SeqCst)
        0
    }, control.clone())
    assert(ready.receive() == Val(1))
    control.cancel()
    thread.sleep(Duration.from_millis(30))
    assert(stage.load(Ordering.SeqCst) == 0, "shielded recv completed or unwound before its value arrived")
    work_tx.send(42)
    start :: Instant.now()
    loop {
        if join.try_recv() == {
            .Val(.Cancelled) -> break
            .Val(_) -> panic.panic_any("shielded task must end Cancelled after the region")
            .None -> {
                assert(start.elapsed() < Duration.from_secs(5), "deferred cancel never landed at shield exit")
                thread.yield_now()
            }
        }
    }
    assert(stage.load(Ordering.SeqCst) == 1, "shielded recv must complete (stage 1) and the post-shield code must not run")
    jet_scheduler_drain()
}
// Rust: crates/jet-codegen/src/SchedulerHost.rs:785
#Test("shield_defers_deadline_until_it_exits") {
    jet_scheduler_set_task_control(Val(JetTaskControl.new()))
    jet_scheduler_task_panic_enter()
    result :: panic.catch_unwind(panic.AssertUnwindSafe(fn() {
        jet_scheduler_shield_enter()
        TEST_DEADLINE_EXCEEDED.with(fn(d) { d.set(true) })
        slot :: ParkSlot.new()
        slot.wake()
        jet_scheduler_yield("shielded wait", &slot, Val(Duration.from_millis(1)))
        jet_scheduler_shield_leave()
        "no-unwind"
    }))
    TEST_DEADLINE_EXCEEDED.with(fn(d) { d.set(false) })
    jet_scheduler_set_task_control(None)
    jet_scheduler_task_panic_leave()
    assert(result.is_err(), "deadline deferred by the shield must unwind when the region exits")
}
// Rust: crates/jet-codegen/src/SchedulerHost.rs:809
#Test("non_unwind_wait_boundary_returns_typed_deadline_for_yield") {
    jet_scheduler_set_task_control(Val(JetTaskControl.new()))
    jet_scheduler_task_panic_enter()
    TEST_DEADLINE_EXCEEDED.with(fn(deadline) { deadline.set(true) })
    result :: jet_scheduler_wait_without_unwind(jet_scheduler_yield_now)
    TEST_DEADLINE_EXCEEDED.with(fn(deadline) { deadline.set(false) })
    jet_scheduler_set_task_control(None)
    jet_scheduler_task_panic_leave()
    if result == {
        .Deadline(rendered) -> assert(rendered == jet_std.jet_task_deadline("task yield").render())
        _ -> panic.panic_any("yield deadline must cross native boundary as typed status")
    }
}
// Rust: crates/jet-codegen/src/SchedulerHost.rs:828
struct EmittedShieldGuard<F> { callback: F? }
// Rust: crates/jet-codegen/src/SchedulerHost.rs:830
impl<F: FnOnce> Drop for EmittedShieldGuard<F> {
    fn drop(self: &EmittedShieldGuard<F>) -> Unit Never! {
        if self.callback.take() == { .Val(f) -> f(); .None -> {} }
    }
}
// Rust: crates/jet-codegen/src/SchedulerHost.rs:837
// The macro's lexical guard is expanded at each control-flow site below.
// Rust: crates/jet-codegen/src/SchedulerHost.rs:845
fn emitted_early_return() -> I64 Never! {
    jet_scheduler_shield_enter()
    _shield_guard :: EmittedShieldGuard(callback: Val(fn() { jet_scheduler_shield_leave() }))
    return 17
}
// Rust: crates/jet-codegen/src/SchedulerHost.rs:849
fn emitted_try_exit() -> I64 Err! {
    jet_scheduler_shield_enter()
    _shield_guard :: EmittedShieldGuard(callback: Val(fn() { jet_scheduler_shield_leave() }))
    _ :: Err("stop")?
    return 1
}
// Rust: crates/jet-codegen/src/SchedulerHost.rs:855
#Test("emitted_shield_guard_covers_control_flow_unwind_and_reset_matrix") {
    TEST_DEADLINE_EXCEEDED.with(fn(d) { d.set(true) })
    {
        jet_scheduler_shield_enter()
        _shield_guard :: EmittedShieldGuard(callback: Val(fn() { jet_scheduler_shield_leave() }))
        assert(!jet_scheduler_shielded())
    }
    TEST_DEADLINE_EXCEEDED.with(fn(d) { d.set(false) })
    jet_scheduler_task_panic_enter()
    jet_scheduler_set_task_control(Val(JetTaskControl.new()))
    {
        jet_scheduler_shield_enter()
        _shield_guard :: EmittedShieldGuard(callback: Val(fn() { jet_scheduler_shield_leave() }))
        assert(jet_scheduler_shielded())
        {
            jet_scheduler_shield_enter()
            _inner_guard :: EmittedShieldGuard(callback: Val(fn() { jet_scheduler_shield_leave() }))
            assert(jet_scheduler_shielded())
        }
        assert(jet_scheduler_shielded())
    }
    assert(!jet_scheduler_shielded(), "nested guards must balance depth")
    assert(emitted_early_return() == 17)
    assert(!jet_scheduler_shielded(), "return must drop the guard")
    assert(emitted_try_exit() == Err("stop"))
    assert(!jet_scheduler_shielded(), "? must drop the guard")
    for pending_deadline in [false, true] {
        control :: JetTaskControl.new()
        control.cancel()
        jet_scheduler_set_task_control(Val(control))
        TEST_DEADLINE_EXCEEDED.with(fn(d) { d.set(pending_deadline) })
        raised :: panic.catch_unwind(panic.AssertUnwindSafe(fn() {
            jet_scheduler_shield_enter()
            _shield_guard :: EmittedShieldGuard(callback: Val(fn() { jet_scheduler_shield_leave() }))
            panic.panic_any("body panic")
        }))
        text :: raised.expect_err("body must panic").downcast<String>().map(fn(s) { *s }).unwrap_or("")
        assert(text == "body panic")
        assert(!jet_scheduler_shielded(), "panic must reset shield depth")
        TEST_DEADLINE_EXCEEDED.with(fn(d) { d.set(false) })
    }
    control :: JetTaskControl.new()
    control.cancel()
    jet_scheduler_set_task_control(Val(control))
    both :: panic.catch_unwind(panic.AssertUnwindSafe(fn() {
        jet_scheduler_shield_enter()
        _shield_guard :: EmittedShieldGuard(callback: Val(fn() { jet_scheduler_shield_leave() }))
        TEST_DEADLINE_EXCEEDED.with(fn(d) { d.set(true) })
    }))
    payload :: both.expect_err("pending deadline must land at guard drop")
    text :: payload.downcast_ref<JetDeadlineUnwind>().map(fn(deadline) { deadline.rendered.as_str() }).unwrap_or("")
    assert(text == jet_std.jet_task_deadline("shield exit").render())
    assert(!jet_scheduler_shielded())
    TEST_DEADLINE_EXCEEDED.with(fn(d) { d.set(false) })
    jet_scheduler_set_task_control(Val(JetTaskControl.new()))
    {
        jet_scheduler_shield_enter()
        _shield_guard :: EmittedShieldGuard(callback: Val(fn() { jet_scheduler_shield_leave() }))
        assert(jet_scheduler_shielded())
    }
    assert(!jet_scheduler_shielded(), "subsequent task must start clean")
    jet_scheduler_set_task_control(None)
    jet_scheduler_task_panic_leave()
}
