// Rust: crates/jet-codegen/src/SchedulerHost.rs:452
fn ready_entries_in_reverse_completion_order() -> [(JetSchedulerJoin<I64>, Arc<JetTaskControl>)] Never! {
    (slow_tx, slow_rx) :: mpsc.sync_channel<JetSchedulerResult<I64>>(1)
    (fast_tx, fast_rx) :: mpsc.sync_channel<JetSchedulerResult<I64>>(1)
    fast_tx.send(JetSchedulerResult.Value(42)).unwrap()
    slow_tx.send(JetSchedulerResult.Value(7)).unwrap()
    fast_order :: Arc.new(OnceLock.new())
    fast_order.set(0).unwrap()
    slow_order :: Arc.new(OnceLock.new())
    slow_order.set(1).unwrap()
    [
        (JetSchedulerJoin(rx: slow_rx, pending: Mutex.new(None), completion_order: slow_order, completion_wait: ParkSlot.new(), identity: "scheduler-host-slow"), JetTaskControl.new()),
        (JetSchedulerJoin(rx: fast_rx, pending: Mutex.new(None), completion_order: fast_order, completion_wait: ParkSlot.new(), identity: "scheduler-host-fast"), JetTaskControl.new())
    ]
}
// Rust: crates/jet-codegen/src/SchedulerHost.rs:489
#Test("race_uses_completion_order_when_results_are_already_ready") {
    assert(jet_scheduler_race(ready_entries_in_reverse_completion_order()).unwrap() == 42)
}
// Rust: crates/jet-codegen/src/SchedulerHost.rs:497
#Test("any_uses_completion_order_when_results_are_already_ready") {
    assert(jet_scheduler_any(ready_entries_in_reverse_completion_order()).unwrap() == 42)
}
