// Canonical Foundation Devtools.rs:207-219 (also the Prelude symlink owner).
// Main-authorized RT222 extraction; source-list/public package wiring is held
// for Main's stage-1 cutover. Runtime consumes this entire decision, never a
// second value universe or a replacement for the canonical devtools envelope.
pub JET_DEVTOOLS_MAX_LIVE_VALUES :: 4096

// Foundation owns disposition/redaction; Observe merely stores/renders it.
pub struct JetLiveValueDecision {
    pub value_id: String
    pub type_identity: String
    pub disposition: String
    pub reason: String
    pub rendered_value: String?
}
