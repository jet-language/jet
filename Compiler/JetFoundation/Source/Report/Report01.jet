impl DerivationIdentity {
    // Rust: crates/jet-foundation/src/FactsDerivation.rs:175
    pub fn new(source: String, build: String, run: String, target: String) -> DerivationIdentity Never! {
        derivation_identity(source, build, run, target)
    }
    // Rust: crates/jet-foundation/src/FactsDerivation.rs:189
    pub fn differs_from(self, other: DerivationIdentity) -> Bool Never! {
        self.source != other.source || self.build != other.build || self.run != other.run || self.target != other.target
    }
    // Rust: crates/jet-foundation/src/FactsDerivation.rs:193
    pub fn is_empty(self) -> Bool Never! {
        self.source.is_empty() && self.build.is_empty() && self.run.is_empty() && self.target.is_empty()
    }
}
// Rust: crates/jet-foundation/src/FactsDerivation.rs:203
// DerivationRecord fields are owned by Derivations.jet:18.
impl DerivationRecord {
    // Rust: crates/jet-foundation/src/FactsDerivation.rs:220
    pub fn new(subject: String, claim: String, producer: String, method: MIRDerivationMethod, rule: String, premises: ^[String], identity: DerivationIdentity) -> DerivationRecord Never! {
        values := ^premises
        &values.sort()
        &values.dedup()
        record := DerivationRecord{id: "", subject: subject, claim: claim, producer: producer, method: method, rule: rule, premises: ^values, identity: identity, assumptions: [], disposition: .Current, observation: None, payload: None}
        record.id = derivation_record_id(record)
        record
    }
    // Rust: crates/jet-foundation/src/FactsDerivation.rs:254
    pub fn with_assumptions(self: ^DerivationRecord, assumptions: ^[String]) -> DerivationRecord Never! {
        result := ^self
        result.assumptions = ^assumptions
        &result.assumptions.sort()
        &result.assumptions.dedup()
        result
    }
    // Rust: crates/jet-foundation/src/FactsDerivation.rs:261
    pub fn with_disposition(self: ^DerivationRecord, disposition: MIRDerivationDisposition) -> DerivationRecord Never! {
        result := ^self
        result.disposition = disposition
        result
    }
    // Rust: crates/jet-foundation/src/FactsDerivation.rs:266
    pub fn with_observation(self: ^DerivationRecord, observation: DerivationObservation) -> DerivationRecord Never! {
        result := ^self
        result.observation = if observation.is_empty() { None } else { Val(observation) }
        result
    }
    // Rust: crates/jet-foundation/src/FactsDerivation.rs:273
    pub fn invalidate_if_identity_changed(self: &DerivationRecord, current: DerivationIdentity) -> Bool Never! {
        derivation_record_invalidate_if_identity_changed(&self, current)
    }
    // Rust: crates/jet-foundation/src/FactsDerivation.rs:283
    fn canonical_id(self) -> String Never! { derivation_record_id(self) }
    // Rust: crates/jet-foundation/src/FactsDerivation.rs:304
    pub fn validate(self) Err! {
        if self.id != self.canonical_id() -> return Err("derivation {self.id} has a non-canonical identity")
    }
    // Rust: crates/jet-foundation/src/FactsDerivation.rs:314
    pub fn with_payload(self: ^DerivationRecord, payload: DerivationPayload) -> DerivationRecord Never! {
        derivation_record_with_payload(^self, payload)
    }
    // Rust: crates/jet-foundation/src/FactsDerivation.rs:320
    pub fn reference(self) -> MIRDerivationRef Never! { derivation_record_reference(self) }
    // Rust: crates/jet-foundation/src/FactsDerivation.rs:326
    pub fn to_json(self) -> String Never! { derivation_record_json(self) }
}
