// Rust: crates/jet-foundation/src/FactsDerivation.rs:12
// DerivationMethod is canonical MIR.jet::MIRDerivationMethod (same variants/order).
impl MIRDerivationMethod {
    // Rust: crates/jet-foundation/src/FactsDerivation.rs:21
    pub fn as_str(self) -> String Never! { derivation_method_raw(self) }
    // Rust: crates/jet-foundation/src/FactsDerivation.rs:31
    pub fn from_str(value: String) -> MIRDerivationMethod? Never! {
        if value == {
            "static_derivation" -> Val(.StaticDerivation)
            "formal_proof" -> Val(.FormalProof)
            "recorded_execution" -> Val(.RecordedExecution)
            "sampled_agreement" -> Val(.SampledAgreement)
            "external_assumption" -> Val(.ExternalAssumption)
            else -> None
        }
    }
}
// Rust: crates/jet-foundation/src/FactsDerivation.rs:48
// DerivationDisposition is canonical MIR.jet::MIRDerivationDisposition.
impl MIRDerivationDisposition {
    // Rust: crates/jet-foundation/src/FactsDerivation.rs:60
    pub fn as_str(self) -> String Never! { derivation_disposition_text(self) }
    // Rust: crates/jet-foundation/src/FactsDerivation.rs:73
    pub fn from_str(value: String) -> MIRDerivationDisposition? Never! {
        if value == {
            "current" -> Val(.Current)
            "stale" -> Val(.Stale)
            "expired" -> Val(.Expired)
            "redacted" -> Val(.Redacted)
            "unavailable" -> Val(.Unavailable)
            "unsupported" -> Val(.Unsupported)
            "budget_exhausted" -> Val(.BudgetExhausted)
            "unknown" -> Val(.Unknown)
            else -> None
        }
    }
    // Rust: crates/jet-foundation/src/FactsDerivation.rs:87
    pub fn is_current(self) -> Bool Never! { self == .Current }
    // Rust: crates/jet-foundation/src/FactsDerivation.rs:91
    pub fn is_unknown(self) -> Bool Never! { self == .Unknown }
}
