// The one binary record format for compiler records (#2517).
//
// This is the Jet implementation of `jet_foundation::RecordCodec`. Both
// implementations write the same bytes for the same record, and a conformance
// test compares them. The layout, with every integer an unsigned LEB128
// `uvarint` in its minimal form:
//
//   "JETR"                         magic, 4 bytes
//   uvarint format                 RECORD_FORMAT (1)
//   str schema                     for example "jet.iface/v1"
//   uvarint n, n x str             string table, first-use order
//   uvarint sections               section count
//   per section, ascending tag:
//     uvarint tag
//     uvarint elements
//     elements x uvarint length    element index
//     element bytes, concatenated
//   32 bytes                       SHA-256 of every preceding byte
//
// `str` is a uvarint byte length followed by UTF-8. The string table is
// interned by walking sections in tag order, elements in order, and each value
// depth-first (a map key before its value). Values are self-describing: tag 0
// null, 1 false, 2 true, 3 zigzag `i64`, 4 string-table index, 5 bytes, 6 list,
// 7 map with keys sorted by their UTF-8 bytes, 8 a 32-byte digest.
//
// The encoding is canonical and the decoder rejects every other byte form.
// Decode problems carry the Rust codec's messages; a caller treats any
// problem as a cache miss.

RECORD_FORMAT: 1
RECORD_CHECKSUM_BYTES: 32
RECORD_MAX_DEPTH: 128
RECORD_MAX_I64: 9223372036854775807

RECORD_TAG_NULL: 0
RECORD_TAG_FALSE: 1
RECORD_TAG_TRUE: 2
RECORD_TAG_INT: 3
RECORD_TAG_STR: 4
RECORD_TAG_BYTES: 5
RECORD_TAG_LIST: 6
RECORD_TAG_MAP: 7
RECORD_TAG_DIGEST: 8

// One self-describing record value. `Map` fields may be given in any order;
// the encoder writes them sorted by name bytes and rejects a repeated name.
RecordValue: enum {
    Null
    Bool(value: Bool)
    Int(value: Int)
    Str(value: String)
    Bytes(value: [U8])
    List(values: [RecordValue])
    Map(fields: [RecordField])
    Digest(value: [U8])
}

RecordField: struct {
    name: String
    value: RecordValue
}

// One tagged section: an indexed list of elements.
RecordSection: struct {
    id: Int
    elements: [RecordValue]
}

// A fully decoded record. `digest` is the trailing SHA-256, the record's
// content digest.
Record: struct {
    schema: String
    sections: [RecordSection]
    digest: [U8]
}

RecordEncodeResult: struct {
    bytes: [U8]?
    problem: String?
}

RecordDecodeResult: struct {
    record: Record?
    problem: String?
}

// A verified record whose elements decode on demand. Section `s` has id
// `ids[s]`; `bounds[firsts[s]..]` holds the start of each of its elements
// followed by the end of the last one.
RecordReader: struct {
    schema: String
    digest: [U8]
    bytes: [U8]
    strings: [String]
    ids: [Int]
    section_positions: [Int:Int]
    firsts: [Int]
    bounds: [Int]
}

RecordReaderResult: struct {
    reader: RecordReader?
    problem: String?
}

RecordValueResult: struct {
    value: RecordValue?
    problem: String?
}

// Typed views carry the same explicit problem as the binary reader.
RecordStringResult: struct {
    value: String?
    problem: String?
}

RecordOptionalStringResult: struct {
    value: String?
    problem: String?
}

RecordIntResult: struct {
    value: Int?
    problem: String?
}

RecordBoolResult: struct {
    value: Bool?
    problem: String?
}

RecordListResult: struct {
    value: [RecordValue]?
    problem: String?
}

RecordMapResult: struct {
    value: [RecordField]?
    problem: String?
}

RecordDigestResult: struct {
    value: [U8]?
    problem: String?
}

RecordCountResult: struct {
    value: Int?
    problem: String?
}

RecordStringsResult: struct {
    value: [String]?
    problem: String?
}

RecordElementsResult: struct {
    value: [RecordValue]?
    problem: String?
}

record_value_kind: fn(value: RecordValue) -> String Never! {
    if value == {
        .Null -> "null"
        .Bool(_) -> "boolean"
        .Int(_) -> "integer"
        .Str(_) -> "string"
        .Bytes(_) -> "bytes"
        .List(_) -> "list"
        .Map(_) -> "map"
        .Digest(_) -> "digest"
    }
}

record_value_shape: fn(expected: String, value: RecordValue) -> String Never! {
    "record is malformed: expected {expected}, found {record_value_kind(value)}"
}

record_value_is_null: fn(value: RecordValue) -> Bool Never! {
    value == .Null
}

record_value_as_str: fn(value: RecordValue) -> RecordStringResult Never! {
    if value == {
        .Str(text) -> RecordStringResult{value: Val(text), problem: None}
        .Null | .Bool(_) | .Int(_) | .Bytes(_) | .List(_) | .Map(_) | .Digest(_) -> RecordStringResult{value: None, problem: Val(record_value_shape("string", value))}
    }
}

record_value_as_optional_str: fn(value: RecordValue) -> RecordOptionalStringResult Never! {
    if value == .Null -> return RecordOptionalStringResult{value: None, problem: None}
    decoded: record_value_as_str(value)
    RecordOptionalStringResult{value: decoded.value, problem: decoded.problem}
}

record_value_as_int: fn(value: RecordValue) -> RecordIntResult Never! {
    if value == {
        .Int(number) -> RecordIntResult{value: Val(number), problem: None}
        .Null | .Bool(_) | .Str(_) | .Bytes(_) | .List(_) | .Map(_) | .Digest(_) -> RecordIntResult{value: None, problem: Val(record_value_shape("integer", value))}
    }
}

// A count: a non-negative integer that fits a 64-bit unsigned word.
record_value_as_usize: fn(value: RecordValue) -> RecordCountResult Never! {
    decoded: record_value_as_int(value)
    number: decoded.value ?? return RecordCountResult{value: None, problem: decoded.problem}
    if number < 0 || number > 18446744073709551615 -> return RecordCountResult{value: None, problem: Val("record is malformed: negative or oversized count")}
    RecordCountResult{value: Val(number), problem: None}
}

record_value_as_bool: fn(value: RecordValue) -> RecordBoolResult Never! {
    if value == {
        .Bool(flag) -> RecordBoolResult{value: Val(flag), problem: None}
        .Null | .Int(_) | .Str(_) | .Bytes(_) | .List(_) | .Map(_) | .Digest(_) -> RecordBoolResult{value: None, problem: Val(record_value_shape("boolean", value))}
    }
}

record_value_as_list: fn(value: RecordValue) -> RecordListResult Never! {
    if value == {
        .List(values) -> RecordListResult{value: Val(values), problem: None}
        .Null | .Bool(_) | .Int(_) | .Str(_) | .Bytes(_) | .Map(_) | .Digest(_) -> RecordListResult{value: None, problem: Val(record_value_shape("list", value))}
    }
}

record_value_as_map: fn(value: RecordValue) -> RecordMapResult Never! {
    if value == {
        .Map(fields) -> RecordMapResult{value: Val(fields), problem: None}
        .Null | .Bool(_) | .Int(_) | .Str(_) | .Bytes(_) | .List(_) | .Digest(_) -> RecordMapResult{value: None, problem: Val(record_value_shape("map", value))}
    }
}

record_value_as_digest: fn(value: RecordValue) -> RecordDigestResult Never! {
    if value == {
        .Digest(digest) -> RecordDigestResult{value: Val(digest), problem: None}
        .Null | .Bool(_) | .Int(_) | .Str(_) | .Bytes(_) | .List(_) | .Map(_) -> RecordDigestResult{value: None, problem: Val(record_value_shape("digest", value))}
    }
}

// A required map field.
record_value_field: fn(value: RecordValue, name: String) -> RecordValueResult Never! {
    decoded: record_value_as_map(value)
    fields: decoded.value ?? return RecordValueResult{value: None, problem: decoded.problem}
    loop field in fields {
        if field.name == name -> return RecordValueResult{value: Val(field.value), problem: None}
    }
    RecordValueResult{value: None, problem: Val("record is malformed: field `{name}` is missing")}
}

record_value_str_list: fn(value: RecordValue) -> RecordStringsResult Never! {
    decoded: record_value_as_list(value)
    items: decoded.value ?? return RecordStringsResult{value: None, problem: decoded.problem}
    texts := [String]{}
    loop item in items {
        text: record_value_as_str(item)
        if text.problem != None -> return RecordStringsResult{value: None, problem: text.problem}
        texts.push(text.value ?? "")
    }
    RecordStringsResult{value: Val(texts), problem: None}
}

record_value_optional_str: fn(value: String?) -> RecordValue Never! {
    if value == {
        .Val(text) -> RecordValue.Str{value: text}
        .None -> RecordValue.Null
    }
}

record_value_list_of_str: fn(values: [String]) -> RecordValue Never! {
    items := [RecordValue]{}
    loop text in values -> items.push(RecordValue.Str{value: text})
    RecordValue.List{values: items}
}

// ---------------------------------------------------------------- encoding

record_put_uvarint: fn(out: &[U8], value: Int) Never! {
    rest := value
    loop {
        low: (rest).bit_and(127)
        rest = rest >> 7
        if rest == 0 {
            out.push(U8{low})
            return
        }
        out.push(U8{(low).bit_or(128)})
    }
}

record_put_str: fn(out: &[U8], value: String) Never! {
    bytes: value.bytes()
    record_put_uvarint(out, bytes.len())
    loop byte in bytes -> out.push(byte)
}

record_zigzag: fn(value: Int) -> Int Never! {
    if value >= 0 -> value * 2 else -> (0 - value) * 2 - 1
}

record_unzigzag: fn(value: Int) -> Int Never! {
    if (value).bit_and(1) == 0 -> value >> 1 else -> 0 - (value >> 1) - 1
}

// True when `left` sorts strictly before `right` by bytes.
record_bytes_before: fn(left: [U8], right: [U8]) -> Bool Never! {
    index := 0
    loop index < left.len() && index < right.len() {
        a: Int{left[index]}
        b: Int{right[index]}
        if a != b -> return a < b
        index += 1
    }
    left.len() < right.len()
}

// The canonical form of a value: map fields sorted by name bytes. A value no
// byte form can represent adds its reason to `problems`.
record_canonical_value: fn(value: RecordValue, problems: &[String]) -> RecordValue Never! {
    if value == {
        .Int(number) -> {
            if number < 0 - RECORD_MAX_I64 - 1 || number > RECORD_MAX_I64 -> problems.push("record integer {number} is outside i64")
            value
        }
        .Digest(digest) -> {
            if digest.len() != RECORD_CHECKSUM_BYTES -> problems.push("record digest has {digest.len()} bytes, expected 32")
            value
        }
        .List(values) -> {
            canonical := [RecordValue]{}
            loop item in values -> canonical.push(record_canonical_value(item, problems))
            RecordValue.List{values: canonical}
        }
        .Map(fields) -> {
            // Canonicalize in input order (a repeated name is reported where
            // it recurs), then one stable merge sort by name bytes.
            canonical := [RecordField]{}
            names := [[U8]]{}
            seen := [String:Bool]{}
            loop field in fields {
                canonical.push(RecordField{name: field.name, value: record_canonical_value(field.value, problems)})
                names.push(field.name.bytes())
                if seen.get(field.name) != None {
                    problems.push("record map key `{field.name}` is duplicated")
                } else {
                    seen[field.name] = true
                }
            }
            sorted: loop index in record_sorted_order(names) -> canonical[index]
            RecordValue.Map{fields: sorted}
        }
        .Null | .Bool(_) | .Str(_) | .Bytes(_) -> value
    }
}

// Row order of `names` sorted by bytes; equal names keep their input order.
record_sorted_order: fn(names: [[U8]]) -> [Int] Never! {
    order := [Int]{}
    loop index in 0..<names.len() -> order.push(index)
    width := 1
    loop width < order.len() {
        merged := [Int]{}
        start := 0
        loop start < order.len() {
            middle: if start + width < order.len() -> start + width else -> order.len()
            end: if start + 2 * width < order.len() -> start + 2 * width else -> order.len()
            left := start
            right := middle
            loop left < middle || right < end {
                if right >= end || (left < middle && !record_bytes_before(names[order[right]], names[order[left]])) {
                    merged.push(order[left])
                    left += 1
                } else {
                    merged.push(order[right])
                    right += 1
                }
            }
            start = end
        }
        order = merged
        width = width * 2
    }
    order
}

RecordStringTable: struct {
    order: [String]
    index: [String:Int]
}

record_intern: fn(table: &RecordStringTable, value: String) Never! {
    if table.index.get(value) == None {
        table.index[value] = table.order.len()
        table.order.push(value.copy())
    }
}

record_intern_value: fn(table: &RecordStringTable, value: RecordValue) Never! {
    if value == {
        .Str(text) -> record_intern(table, text)
        .List(values) -> {
            loop item in values -> record_intern_value(table, item)
        }
        .Map(fields) -> {
            loop field in fields {
                record_intern(table, field.name)
                record_intern_value(table, field.value)
            }
        }
        .Null | .Bool(_) | .Int(_) | .Bytes(_) | .Digest(_) -> {}
    }
}

record_put_ref: fn(out: &[U8], table: RecordStringTable, value: String) Never! {
    record_put_uvarint(out, table.index.get(value) ?? 0)
}

record_put_value: fn(out: &[U8], table: RecordStringTable, value: RecordValue) Never! {
    if value == {
        .Null -> out.push(U8{RECORD_TAG_NULL})
        .Bool(flag) -> {
            if flag -> out.push(U8{RECORD_TAG_TRUE}) else -> out.push(U8{RECORD_TAG_FALSE})
        }
        .Int(number) -> {
            out.push(U8{RECORD_TAG_INT})
            record_put_uvarint(out, record_zigzag(number))
        }
        .Str(text) -> {
            out.push(U8{RECORD_TAG_STR})
            record_put_ref(out, table, text)
        }
        .Bytes(bytes) -> {
            out.push(U8{RECORD_TAG_BYTES})
            record_put_uvarint(out, bytes.len())
            loop byte in bytes -> out.push(byte)
        }
        .List(values) -> {
            out.push(U8{RECORD_TAG_LIST})
            record_put_uvarint(out, values.len())
            loop item in values -> record_put_value(out, table, item)
        }
        .Map(fields) -> {
            out.push(U8{RECORD_TAG_MAP})
            record_put_uvarint(out, fields.len())
            loop field in fields {
                record_put_ref(out, table, field.name)
                record_put_value(out, table, field.value)
            }
        }
        .Digest(digest) -> {
            out.push(U8{RECORD_TAG_DIGEST})
            loop byte in digest -> out.push(byte)
        }
    }
}

// Stable scalar-position ordering by section id.
record_section_order: fn(ids: [Int]) -> [Int] Never! {
    order := [Int]{}
    loop index in 0..<ids.len() -> order.push(index)
    width := 1
    loop width < order.len() {
        merged := [Int]{}
        start := 0
        loop start < order.len() {
            middle: if start + width < order.len() -> start + width else -> order.len()
            end: if start + 2 * width < order.len() -> start + 2 * width else -> order.len()
            left := start
            right := middle
            loop left < middle || right < end {
                if right >= end || (left < middle && !(ids[order[right]] < ids[order[left]])) {
                    merged.push(order[left])
                    left += 1
                } else {
                    merged.push(order[right])
                    right += 1
                }
            }
            start = end
        }
        order = merged
        width = width * 2
    }
    order
}

// Encode a record. Sections may be passed in any order; they are written in
// ascending id order. A repeated section id, a repeated map key, an integer
// outside i64, or a digest that is not 32 bytes is a problem, not bytes.
record_encode: fn(schema: String, sections: [RecordSection]) -> RecordEncodeResult Never! {
    problems := [String]{}
    canonical := [RecordSection]{}
    ids := [Int]{}
    seen := [Int:Bool]{}
    loop section in sections {
        if section.id < 0 || section.id >> 64 != 0 -> return RecordEncodeResult{bytes: None, problem: Val("record section id {section.id} is outside u64")}
        elements := [RecordValue]{}
        loop element in section.elements -> elements.push(record_canonical_value(element, problems))
        canonical.push(RecordSection{id: section.id, elements: elements})
        ids.push(section.id)
        if seen.get(section.id) != None {
            return RecordEncodeResult{bytes: None, problem: Val("record section {section.id} is duplicated or out of order")}
        }
        seen[section.id] = true
    }
    order: record_section_order(ids)
    if problems.len() > 0 -> return RecordEncodeResult{bytes: None, problem: Val(problems[0])}
    table := RecordStringTable{order: [String]{}, index: [String:Int]{}}
    loop index in order {
        loop element in canonical[index].elements -> record_intern_value(table, element)
    }
    out := [U8]{74, 69, 84, 82}
    record_put_uvarint(out, RECORD_FORMAT)
    record_put_str(out, schema)
    record_put_uvarint(out, table.order.len())
    loop text in table.order -> record_put_str(out, text)
    record_put_uvarint(out, order.len())
    loop index in order {
        record_put_uvarint(out, canonical[index].id)
        record_put_uvarint(out, canonical[index].elements.len())
        body := [U8]{}
        loop element in canonical[index].elements {
            encoded := [U8]{}
            record_put_value(encoded, table, element)
            record_put_uvarint(out, encoded.len())
            loop byte in encoded -> body.push(byte)
        }
        loop byte in body -> out.push(byte)
    }
    view: out[0..<out.len()]
    checksum: sha256_bytes(view)
    loop byte in checksum -> out.push(byte)
    RecordEncodeResult{bytes: Val(out), problem: None}
}

// ---------------------------------------------------------------- decoding

// A read position over `bytes[at..end]`. The first problem sticks; every read
// after it returns a neutral value.
RecordCursor: struct {
    at: Int
    end: Int
    problem: String?
}

record_fail: fn(cursor: &RecordCursor, problem: String) Never! {
    if cursor.problem == None -> cursor.problem = Val(problem)
}

record_malformed: fn(cursor: &RecordCursor, reason: String) Never! {
    record_fail(cursor, "record is malformed: {reason}")
}

record_read_byte: fn(bytes: [U8], cursor: &RecordCursor) -> Int Never! {
    if cursor.problem != None -> return 0
    if cursor.at >= cursor.end {
        record_fail(cursor, "record is truncated")
        return 0
    }
    value: Int{bytes[cursor.at]}
    cursor.at += 1
    value
}

record_read_uvarint: fn(bytes: [U8], cursor: &RecordCursor) -> Int Never! {
    value := 0
    shift := 0
    loop {
        byte: record_read_byte(bytes, cursor)
        if cursor.problem != None -> return 0
        low: (byte).bit_and(127)
        if shift == 63 && low > 1 {
            record_malformed(cursor, "varint overflows u64")
            return 0
        }
        value = (value).bit_or((low << shift))
        if (byte).bit_and(128) == 0 {
            if byte == 0 && shift > 0 {
                record_malformed(cursor, "varint is not minimal")
                return 0
            }
            return value
        }
        shift += 7
        if shift > 63 {
            record_malformed(cursor, "varint overflows u64")
            return 0
        }
    }
}

// A count or length: never larger than the remaining input, because every
// counted thing occupies at least one byte.
record_read_len: fn(bytes: [U8], cursor: &RecordCursor) -> Int Never! {
    value: record_read_uvarint(bytes, cursor)
    if cursor.problem != None -> return 0
    if value > cursor.end - cursor.at {
        record_fail(cursor, "record is truncated")
        return 0
    }
    value
}

// Advance past `len` bytes without copying them.
record_skip: fn(cursor: &RecordCursor, len: Int) Never! {
    if cursor.problem != None -> return
    if len > cursor.end - cursor.at {
        record_fail(cursor, "record is truncated")
        return
    }
    cursor.at += len
}

record_take: fn(bytes: [U8], cursor: &RecordCursor, len: Int) -> [U8] Never! {
    start: cursor.at
    record_skip(cursor, len)
    if cursor.problem != None -> return [U8]{}
    bytes.slice(start, start + len)
}

record_read_str: fn(bytes: [U8], cursor: &RecordCursor) -> String Never! {
    len: record_read_len(bytes, cursor)
    raw: record_take(bytes, cursor, len)
    if cursor.problem != None -> return ""
    String.from_bytes(raw) ?? {
        record_malformed(cursor, "string is not UTF-8")
        return ""
    }
}

record_reader_failure: fn(problem: String) -> RecordReaderResult Never! {
    RecordReaderResult{reader: None, problem: Val(problem)}
}

// Verify the checksum and framing and index every section. Element payloads are
// not decoded until asked for.
record_open: fn(bytes: [U8]) -> RecordReaderResult Never! {
    if bytes.len() < 4 + RECORD_CHECKSUM_BYTES -> return record_reader_failure("record is truncated")
    body_end: bytes.len() - RECORD_CHECKSUM_BYTES
    if (Int{bytes[0]}) != 74 || (Int{bytes[1]}) != 69 || (Int{bytes[2]}) != 84 || (Int{bytes[3]}) != 82 {
        return record_reader_failure("record magic is not `JETR`")
    }
    checksum: bytes.slice(body_end, bytes.len())
    body: bytes[0..<body_end]
    if sha256_bytes(body) != checksum -> return record_reader_failure("record checksum does not match its bytes")
    cursor := RecordCursor{at: 4, end: body_end, problem: None}
    format: record_read_uvarint(bytes, cursor)
    if cursor.problem == None && format != RECORD_FORMAT -> return record_reader_failure("record format {format} is not supported")
    schema: record_read_str(bytes, cursor)
    string_count: record_read_len(bytes, cursor)
    strings := [String]{}
    loop _ in 0..<string_count {
        if cursor.problem != None -> break
        strings.push(record_read_str(bytes, cursor))
    }
    section_count: record_read_len(bytes, cursor)
    ids := [Int]{}
    section_positions := [Int:Int]{}
    firsts := [Int]{}
    bounds := [Int]{}
    loop _ in 0..<section_count {
        if cursor.problem != None -> break
        id: record_read_uvarint(bytes, cursor)
        if cursor.problem != None -> break
        if ids.len() > 0 && ids[ids.len() - 1] >= id -> return record_reader_failure("record section {id} is duplicated or out of order")
        element_count: record_read_len(bytes, cursor)
        lengths := [Int]{}
        loop _ in 0..<element_count {
            if cursor.problem != None -> break
            lengths.push(record_read_len(bytes, cursor))
        }
        section_positions[id] = ids.len()
        ids.push(id)
        firsts.push(bounds.len())
        bounds.push(cursor.at)
        loop len in lengths {
            record_skip(cursor, len)
            bounds.push(cursor.at)
        }
    }
    if cursor.problem == None && cursor.at != body_end -> record_malformed(cursor, "trailing bytes before the checksum")
    if cursor.problem != None -> return record_reader_failure(cursor.problem ?? "")
    RecordReaderResult{
        reader: Val(RecordReader{schema: schema, digest: checksum, bytes: bytes, strings: strings, ids: ids, section_positions: section_positions, firsts: firsts, bounds: bounds}),
        problem: None,
    }
}

// Open and require `schema`: the checksum and framing are verified before the
// schema is compared; element payloads still decode on demand.
record_open_schema: fn(bytes: [U8], schema: String) -> RecordReaderResult Never! {
    opened: record_open(bytes)
    reader: opened.reader ?? return opened
    if reader.schema != schema -> return record_reader_failure("record schema is `{reader.schema}`, expected `{schema}`")
    opened
}

record_section_index: fn(reader: RecordReader, id: Int) -> Int? Never! {
    reader.section_positions.get(id)
}

record_section_elements: fn(reader: RecordReader, section: Int) -> Int Never! {
    next: if section + 1 < reader.firsts.len() -> reader.firsts[section + 1] else -> reader.bounds.len()
    next - reader.firsts[section] - 1
}

record_read_string_ref: fn(reader: RecordReader, cursor: &RecordCursor) -> String Never! {
    index: record_read_uvarint(reader.bytes, cursor)
    if cursor.problem != None -> return ""
    if index >= reader.strings.len() {
        record_malformed(cursor, "string index {index} is out of range")
        return ""
    }
    reader.strings[index]
}

record_read_value: fn(reader: RecordReader, cursor: &RecordCursor, depth: Int) -> RecordValue Never! {
    if depth > RECORD_MAX_DEPTH {
        record_malformed(cursor, "value nesting is too deep")
        return RecordValue.Null
    }
    value_tag: record_read_byte(reader.bytes, cursor)
    if cursor.problem != None -> return RecordValue.Null
    if value_tag == {
        RECORD_TAG_NULL -> RecordValue.Null
        RECORD_TAG_FALSE -> RecordValue.Bool{value: false}
        RECORD_TAG_TRUE -> RecordValue.Bool{value: true}
        RECORD_TAG_INT -> RecordValue.Int{value: record_unzigzag(record_read_uvarint(reader.bytes, cursor))}
        RECORD_TAG_STR -> RecordValue.Str{value: record_read_string_ref(reader, cursor)}
        RECORD_TAG_BYTES -> {
            len: record_read_len(reader.bytes, cursor)
            RecordValue.Bytes{value: record_take(reader.bytes, cursor, len)}
        }
        RECORD_TAG_LIST -> {
            count: record_read_len(reader.bytes, cursor)
            values := [RecordValue]{}
            loop _ in 0..<count {
                if cursor.problem != None -> break
                values.push(record_read_value(reader, cursor, depth + 1))
            }
            RecordValue.List{values: values}
        }
        RECORD_TAG_MAP -> {
            count: record_read_len(reader.bytes, cursor)
            fields := [RecordField]{}
            loop _ in 0..<count {
                if cursor.problem != None -> break
                name: record_read_string_ref(reader, cursor)
                if cursor.problem != None -> break
                if fields.len() > 0 && !record_bytes_before(fields[fields.len() - 1].name.bytes(), name.bytes()) {
                    record_malformed(cursor, "map key `{name}` is duplicated or out of order")
                    break
                }
                fields.push(RecordField{name: name, value: record_read_value(reader, cursor, depth + 1)})
            }
            RecordValue.Map{fields: fields}
        }
        RECORD_TAG_DIGEST -> RecordValue.Digest{value: record_take(reader.bytes, cursor, RECORD_CHECKSUM_BYTES)}
        else -> {
            record_malformed(cursor, "unknown value tag {value_tag}")
            RecordValue.Null
        }
    }
}

record_section_element: fn(reader: RecordReader, section: Int, index: Int) -> RecordValueResult Never! {
    start: reader.bounds[reader.firsts[section] + index]
    cursor := RecordCursor{at: start, end: reader.bounds[reader.firsts[section] + index + 1], problem: None}
    value: record_read_value(reader, cursor, 0)
    if cursor.problem == None && cursor.at != cursor.end -> record_malformed(cursor, "element has trailing bytes")
    if cursor.problem != None -> return RecordValueResult{value: None, problem: cursor.problem}
    RecordValueResult{value: Val(value), problem: None}
}

// Decode one element of one section.
record_element: fn(reader: RecordReader, id: Int, index: Int) -> RecordValueResult Never! {
    section: record_section_index(reader, id) ?? return RecordValueResult{value: None, problem: Val("record section {id} is missing")}
    if index < 0 || index >= record_section_elements(reader, section) -> return RecordValueResult{value: None, problem: Val("record is malformed: section {id} has no element {index}")}
    record_section_element(reader, section, index)
}

// Decode every element of one section.
record_elements: fn(reader: RecordReader, id: Int) -> RecordElementsResult Never! {
    section: record_section_index(reader, id) ?? return RecordElementsResult{value: None, problem: Val("record section {id} is missing")}
    values := [RecordValue]{}
    loop index in 0..<record_section_elements(reader, section) {
        decoded: record_section_element(reader, section, index)
        value: decoded.value ?? return RecordElementsResult{value: None, problem: decoded.problem}
        values.push(value.copy())
    }
    RecordElementsResult{value: Val(values), problem: None}
}

// Decode a whole record.
record_decode: fn(bytes: [U8]) -> RecordDecodeResult Never! {
    opened: record_open(bytes)
    reader: opened.reader ?? return RecordDecodeResult{record: None, problem: opened.problem}
    sections := [RecordSection]{}
    loop section in 0..<reader.ids.len() {
        elements := [RecordValue]{}
        loop index in 0..<record_section_elements(reader, section) {
            decoded: record_section_element(reader, section, index)
            value: decoded.value ?? return RecordDecodeResult{record: None, problem: decoded.problem}
            elements.push(value.copy())
        }
        sections.push(RecordSection{id: reader.ids[section], elements: elements})
    }
    RecordDecodeResult{record: Val(Record{schema: reader.schema, sections: sections, digest: reader.digest}), problem: None}
}

// The content digest a record would have, without keeping the bytes.
record_digest: fn(schema: String, sections: [RecordSection]) -> RecordDigestResult Never! {
    encoded: record_encode(schema, sections)
    bytes: encoded.bytes ?? return RecordDigestResult{value: None, problem: encoded.problem}
    RecordDigestResult{value: Val(bytes.slice(bytes.len() - RECORD_CHECKSUM_BYTES, bytes.len())), problem: None}
}

// Lowercase hex of a digest.
record_digest_hex: fn(digest: [U8]) -> String Never! {
    sha256_hex_bytes(digest)
}

// Parse a 64-character lowercase hex digest.
record_parse_digest_hex: fn(text: String) -> [U8]? Never! {
    raw: text.bytes()
    if raw.len() != 64 -> return None
    digest := [U8]{}
    loop index in 0..<32 {
        high: record_hex_value(Int{raw[index * 2]}) ?? return None
        low: record_hex_value(Int{raw[index * 2 + 1]}) ?? return None
        digest.push(checked(U8{high * 16 + low}) ?? return None)
    }
    Val(digest)
}

record_hex_value: fn(byte: Int) -> Int? Never! {
    if byte >= 48 && byte <= 57 -> return Val(byte - 48)
    if byte >= 97 && byte <= 102 -> return Val(byte - 87)
    None
}

// Any record rendered as JSON for tests and debugging; not a user surface.
record_json: fn(bytes: [U8]) -> RecordStringResult Never! {
    decoded: record_decode(bytes)
    record: decoded.record ?? return RecordStringResult{value: None, problem: decoded.problem}
    out := [U8]{}
    foundation_json_append(out, "{{\"schema\":\"{foundation_json_escape(record.schema)}\",\"digest\":\"{record_digest_hex(record.digest)}\",\"sections\":{{")
    loop (index, section) in record.sections {
        if index > 0 -> foundation_json_append(out, ",")
        foundation_json_append(out, "\"{section.id}\":[")
        loop (element, value) in section.elements {
            if element > 0 -> foundation_json_append(out, ",")
            record_value_json(out, value)
        }
        foundation_json_append(out, "]")
    }
    foundation_json_append(out, "}}}}")
    RecordStringResult{value: Val(String.from_bytes(out) ?? panic("record JSON is UTF-8")), problem: None}
}

record_value_json: fn(out: &[U8], value: RecordValue) Never! {
    if value == {
        .Null -> foundation_json_append(out, "null")
        .Bool(flag) -> foundation_json_append(out, if flag -> "true" else -> "false")
        .Int(number) -> foundation_json_append(out, "{number}")
        .Str(text) -> foundation_json_append(out, "\"{foundation_json_escape(text)}\"")
        .Bytes(raw) -> foundation_json_append(out, "{{\"bytes\":\"{sha256_hex_bytes(raw)}\"}}")
        .List(values) -> {
            foundation_json_append(out, "[")
            loop (index, item) in values {
                if index > 0 -> foundation_json_append(out, ",")
                record_value_json(out, item)
            }
            foundation_json_append(out, "]")
        }
        .Map(fields) -> {
            foundation_json_append(out, "{{")
            loop (index, field) in fields {
                if index > 0 -> foundation_json_append(out, ",")
                foundation_json_append(out, "\"{foundation_json_escape(field.name)}\":")
                record_value_json(out, field.value)
            }
            foundation_json_append(out, "}}")
        }
        .Digest(digest) -> foundation_json_append(out, "{{\"digest\":\"{sha256_hex_bytes(digest)}\"}}")
    }
}

// ---------------------------------------------------------------- key hashing

// The key hash shared with `jet_foundation::PackageIdentity`: SHA-256 over
// each field as a uvarint UTF-8 byte length followed by its bytes, rendered
// as lowercase hex. Digests enter as 64-character hex and counts as decimal.
record_key_digest: fn(fields: [String]) -> String Never! {
    framed := [U8]{}
    loop field in fields -> record_put_str(framed, field)
    view: framed[0..<framed.len()]
    sha256_hex_bytes(sha256_bytes(view))
}

// The store key of a blob record: lowercase hex SHA-256 of its whole bytes.
record_blob_key: fn(bytes: View<U8>) -> String Never! {
    sha256_hex_bytes(sha256_bytes(bytes))
}
