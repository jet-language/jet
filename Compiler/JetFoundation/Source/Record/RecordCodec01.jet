// Rust: crates/jet-foundation/src/RecordCodec.rs:225
#Error
pub enum RecordError {
    Truncated
    BadMagic
    UnsupportedFormat(format: U64)
    Checksum
    DuplicateSection(tag: U64)
    MissingSection(tag: U64)
    Schema(expected: String, found: String)
    Malformed(reason: String)
}
impl RecordError {
    // Rust: crates/jet-foundation/src/RecordCodec.rs:237
    fn shape(expected: String, found: RecordValue) -> RecordError Never! { RecordError.Malformed("expected {expected}, found {found.kind()}") }
    // Rust: crates/jet-foundation/src/RecordCodec.rs:243
    pub fn display(self) -> String Never! {
        if self == {
            .Truncated -> "record is truncated"
            .BadMagic -> "record magic is not `JETR`"
            .UnsupportedFormat(format) -> "record format {format} is not supported"
            .Checksum -> "record checksum does not match its bytes"
            .DuplicateSection(tag) -> "record section {tag} is duplicated or out of order"
            .MissingSection(tag) -> "record section {tag} is missing"
            .Schema(expected, found) -> "record schema is `{found}`, expected `{expected}`"
            .Malformed(reason) -> "record is malformed: {reason}"
        }
    }
}
