// Rust: crates/jet-foundation/src/RecordCodec.rs:180
pub fn record_map(fields: ^[(String, RecordValue)]) -> RecordValue Never! {
    // Match BTreeMap collection: duplicate input keys keep the last value.
    index := [String:RecordValue]{}
    loop (name, value) in ^fields -> index[^name] = ^value
    names := index.keys().to_list()
    &names.sort_by((left, right) -> {
        if record_bytes_before(left.bytes(), right.bytes()) -> Ordering.Less
        else if left == right -> Ordering.Equal else -> Ordering.Greater
    })
    rows := [RecordField]{}
    loop name in names -> &rows.push(RecordField{name: ~name, value: index.remove(name).expect("indexed map key")})
    RecordValue.Map{fields: ^rows}
}
