// PORT-PENDING 0090 crates-jet-foundation-src-recordcodec: crates/jet-foundation/src/RecordCodec.rs:1-911
// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! The one std-only binary record codec for compiler records (#2517).
//RS //!
//RS //! Every persisted compiler record (package checks, interfaces, typed
//RS //! diagnostics, item graphs, program records, and the invocation Receipt)
//RS //! uses this byte format. I6 rules out serde; the layout follows Go's Unified
//RS //! IR shape so a reader can decode one element without decoding the rest.
//RS //!
//RS //! Layout (all integers are unsigned LEB128 `uvarint`s in their minimal form):
//RS //!
//RS //! ```text
//RS //! "JETR"                         magic, 4 bytes
//RS //! uvarint format                 RECORD_FORMAT (1)
//RS //! str schema                     for example "jet.iface/v1"
//RS //! uvarint n, n × str             string table, first-use order
//RS //! uvarint sections               section count
//RS //! per section, ascending tag:
//RS //!   uvarint tag
//RS //!   uvarint elements
//RS //!   elements × uvarint length    element index
//RS //!   element bytes, concatenated
//RS //! 32 bytes                       SHA-256 of every preceding byte
//RS //! ```
//RS //!
//RS //! `str` is a uvarint byte length followed by UTF-8. The string table is
//RS //! interned by walking sections in tag order, elements in order, and each
//RS //! value depth-first (a map key before its value). Values are self-describing:
//RS //!
//RS //! | tag | value |
//RS //! |---|---|
//RS //! | 0 | null |
//RS //! | 1 | false |
//RS //! | 2 | true |
//RS //! | 3 | integer, zigzag-encoded `i64` as a uvarint |
//RS //! | 4 | string, uvarint string-table index |
//RS //! | 5 | bytes, uvarint length and raw bytes |
//RS //! | 6 | list, uvarint count and values |
//RS //! | 7 | map, uvarint count and (uvarint key index, value) pairs sorted by key bytes |
//RS //! | 8 | digest, 32 raw bytes |
//RS //!
//RS //! The encoding is canonical: one value has exactly one byte form. The
//RS //! decoder rejects anything else (overlong varints, unsorted or duplicate map
//RS //! keys or section tags, out-of-range string indexes, trailing bytes, and a
//RS //! checksum mismatch). A caller treats every decode error as a cache miss.
//RS //! JetFoundation implements the same bytes; a conformance test compares them.
//RS 
//RS use std::collections::{BTreeMap, HashMap};
//RS use std::fmt;
//RS 
//RS use crate::SHA256::sha256;
//RS 
//RS pub const RECORD_MAGIC: [u8; 4] = *b"JETR";
//RS pub const RECORD_FORMAT: u64 = 1;
//RS const CHECKSUM_BYTES: usize = 32;
//RS /// Nesting bound so a hostile record cannot exhaust the decoder's stack.
//RS const MAX_DEPTH: usize = 128;
//RS 
//RS const TAG_NULL: u8 = 0;
//RS const TAG_FALSE: u8 = 1;
//RS const TAG_TRUE: u8 = 2;
//RS const TAG_INT: u8 = 3;
//RS const TAG_STR: u8 = 4;
//RS const TAG_BYTES: u8 = 5;
//RS const TAG_LIST: u8 = 6;
//RS const TAG_MAP: u8 = 7;
//RS const TAG_DIGEST: u8 = 8;
//RS 
