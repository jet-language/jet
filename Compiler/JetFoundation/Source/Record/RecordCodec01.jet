// decode_record -> record_decode, RecordCodec.jet:617.
// Rust: crates/jet-foundation/src/RecordCodec.rs:679
pub fn digest_hex(digest: [U8]) -> String Never! { mir_sha256_hex_bytes(digest.view(0..<digest.len())) }
// Rust: crates/jet-foundation/src/RecordCodec.rs:688
pub fn parse_digest_hex(text: String) -> [U8; 32]? Never! {
    bytes :: text.bytes()
    if bytes.len() != 64 -> return None
    loop byte in bytes {
        if !(byte >= U8{48} && byte <= U8{57}) && !(byte >= U8{97} && byte <= U8{102}) -> return None
    }
    digest := [U8; 32]{}
    loop index in 0..<32 {
        a :: bytes[index * 2]
        b :: bytes[index * 2 + 1]
        high :: if a <= U8{57} -> a - U8{48} else -> a - U8{97} + U8{10}
        low :: if b <= U8{57} -> b - U8{48} else -> b - U8{97} + U8{10}
        digest[index] = high * U8{16} + low
    }
    Val(^digest)
}
// Rust: crates/jet-foundation/src/RecordCodec.rs:701
pub fn record_json(bytes: [U8]) -> String Err! {
    decoded :: record_decode(bytes)
    record :: decoded.record ?? return err(decoded.problem.expect("decode failure reason"))
    out := "{{\"schema\":\"{json_escape(record.schema)}\",\"digest\":\"{digest_hex(record.digest)}\",\"sections\":{{"
    loop index in 0..<record.sections.len() {
        section :: record.sections[index]
        if index > 0 -> out += ","
        out += "\"{section.id}\":["
        loop element in 0..<section.elements.len() {
            if element > 0 -> out += ","
            value_json(&out, section.elements[element])
        }
        out += "]"
    }
    out += "}}"
    ^out
}
// Rust: crates/jet-foundation/src/RecordCodec.rs:725
fn value_json(out: &String, value: RecordValue) Never! {
    if value == {
        .Null -> out += "null"
        .Bool(flag) -> out += if flag -> "true" else -> "false"
        .Int(number) -> out += number.to_string()
        .Str(text) -> { out += "\""; out += json_escape(text); out += "\"" }
        .Bytes(bytes) -> {
            out += "{\"bytes\":\""
            loop byte in bytes -> out += "{byte:02x}"
            out += "\"}"
        }
        .List(values) -> {
            out += "["
            loop index in 0..<values.len() { if index > 0 -> out += ","; value_json(&out, values[index]) }
            out += "]"
        }
        .Map(fields) -> {
            out += "{"
            loop index in 0..<fields.len() {
                field :: fields[index]
                if index > 0 -> out += ","
                out += "\"{json_escape(field.name)}\":"
                value_json(&out, field.value)
            }
            out += "}"
        }
        .Digest(digest) -> { out += "{\"digest\":\""; out += digest_hex(digest); out += "\"}" }
    }
}
