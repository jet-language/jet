// Rust: crates/jet-foundation/src/RecordCodec.rs:547
pub fn record_open_schema(bytes: [U8], schema: String) -> RecordReaderResult Never! {
    opened :: record_open(bytes)
    reader :: opened.reader ?? return opened
    if reader.schema != schema -> return RecordReaderResult{reader: None, problem: Val(RecordError.Schema{expected: ~schema, found: ~reader.schema}.display())}
    RecordReaderResult{reader: Val(^reader), problem: None}
}
