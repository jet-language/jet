pub fn record_elements(reader: RecordReader, tag: Int) -> [RecordValue] Err! {
    count :: record_element_count(reader, tag) ?? return err("record section {tag} is missing")
    values := [RecordValue]{}
    loop index in 0..<count {
        decoded :: record_element(reader, tag, index)
        value :: decoded.value ?? return err(decoded.problem.expect("element failure reason"))
        &values.push(^value)
    }
    ^values
}
// Rust: crates/jet-foundation/src/RecordCodec.rs:599
pub fn record_reader_decode(reader: RecordReader) -> Record Err! {
    sections := [RecordSection]{}
    loop tag in reader.ids -> &sections.push(RecordSection{id: tag, elements: record_elements(reader, tag)})
    Record{schema: ~reader.schema, sections: ^sections, digest: ~reader.digest}
}
