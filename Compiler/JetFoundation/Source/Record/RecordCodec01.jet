pub fn record_digest(schema: String, sections: [RecordSection]) -> [U8] Err! {
    encoded :: record_encode(schema, sections)
    bytes :: encoded.bytes ?? return err(encoded.problem.expect("encode failure reason"))
    bytes.slice(bytes.len() - RECORD_CHECKSUM_BYTES, bytes.len())
}
