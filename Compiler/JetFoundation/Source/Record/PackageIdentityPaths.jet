// Rust PackageIdentity.rs::normalize/slash/stable_label OS-path operations.
// One real Core component implementation, never a Rust leaf or UTF8 path recovery.
use core.files.runtime.kernel_path_components as compiler_identity_path
pub enum PackageIdentityOsPaths { Components }
impl PackageIdentityOsPaths.PackageIdentityPathProvider {
    fn normalize(self, path: compiler_identity_path.OsPath) -> compiler_identity_path.OsPath Never! {
        compiler_identity_path.normalize_identity(path)
    }
    fn is_relative(self, path: compiler_identity_path.OsPath) -> Bool Never! {
        compiler_identity_path.is_relative(path)
    }
    fn strip_prefix(self, path: compiler_identity_path.OsPath, root: compiler_identity_path.OsPath) -> compiler_identity_path.OsPath? Never! {
        compiler_identity_path.strip_prefix(path, root)
    }
    fn slash(self, path: compiler_identity_path.OsPath) -> String Never! {
        compiler_identity_path.slash(path)
    }
}
