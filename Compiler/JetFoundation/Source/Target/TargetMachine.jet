// Driver-owned target selection and dossier construction ported and
// Driver::target_machine_for_facts.

// The one target capability vocabulary. A capability's name is its Target
// build fact row (Prelude/Facts.jet), and the provider dossier writes one fact
// per capability in this order.
TargetCapability: enum {
    Allocator Memory Atomic64 MMIO Hardware TimeWall TimeMonotonic TimeZoneData
    TimeSleep Entropy Scheduler IORead IOWrite Panic PanicReport Startup
}
TARGET_CAPABILITY_ALL: #run {
    [TargetCapability]{
        TargetCapability.Allocator, TargetCapability.Memory, TargetCapability.Atomic64, TargetCapability.MMIO,
        TargetCapability.Hardware, TargetCapability.TimeWall, TargetCapability.TimeMonotonic, TargetCapability.TimeZoneData,
        TargetCapability.TimeSleep, TargetCapability.Entropy, TargetCapability.Scheduler, TargetCapability.IORead,
        TargetCapability.IOWrite, TargetCapability.Panic, TargetCapability.PanicReport, TargetCapability.Startup
    }
}
TargetUnsafeGate: struct { reason: String }
MMIOAccess: struct {
    address: Int
    size: ByteSize
    unsafe_gate: TargetUnsafeGate?
}
TargetMachineUse: struct {
    stack_bytes: Int
    static_ram_bytes: Int
    heap_required: Bool
    core_apis: [String]
    mmio: [MMIOAccess]
    required_capabilities: [TargetCapability]
}
SizeBudgetReport: struct {
    artifact_bytes: Int
    flash_bytes: Int
    flash_ok: Bool
    ram_bytes: Int
    ram_used_bytes: Int
    ram_ok: Bool
}
#Error
TargetMachineError: enum {
    MissingTargetTriple
    MissingMemoryKind(kind: MemoryKind)
    DuplicateMemoryRegion(name: String)
    EmptyMemoryRegion(name: String)
    MemoryAddressOverflow(name: String)
    OverlappingMemoryRegions(first: String, second: String)
    MissingLinkerInput
    LinkerFileMissingPath
    LinkerFileMissingHash(path: String)
    MissingAllocatorPolicy
    AllocatorRegionUnknown(region: String)
    AllocatorRegionNotRam(region: String)
    AllocatorRegionTooSmall(region: String, requested_bytes: Int, available_bytes: Int)
    HostedAllocatorRequiresOS
    MissingPanicPolicy
    MissingTargetCapability(capability: String)
    HostedCapabilityRequiresOS(capability: String)
    InvalidProviderContract(capability: String, provider: String, sha256: String)
    RamOverflow(used_bytes: Int, ram_bytes: Int)
    HeapRequiresAllocator
    CoreAPIUnavailable(api: String, required: RuntimeLayer, available: RuntimeLayer)
    MMIOOutsideRegion(address: Int, size_bytes: Int)
    MMIOMissingUnsafeGate(address: Int)
    MMIOEmptyUnsafeReason(address: Int)
    HostedHasNoLinkerScript
    HostedHasNoStartup
    UnsupportedStartupTriple(triple: String)
    ExecutionTierUnsupported(tier: String, machine: String)
    FirmwareToolchainMissing(tool: String)
    FirmwareBuildFailed(detail: String)
    SizeBudgetExceeded(report: SizeBudgetReport)
    HardwareFactsMissingSVD
    InvalidHardwareSVD(source: String, sha256: String)
    HardwareFactEmptyName(kind: String)
    DuplicateRegisterBlock(name: String)
    RegisterBlockEmpty(name: String)
    RegisterBlockAddressOverflow(name: String)
    RegisterBlockOutsideRegion(name: String, address: Int, size_bytes: Int)
    DuplicateRegister(block: String, register: String)
    RegisterAddressOverflow(block: String, register: String)
    RegisterOutsideBlock(block: String, register: String)
    UnknownRegisterBlock(block: String)
    UnknownRegister(block: String, register: String)
    RegisterWidthMismatch(block: String, register: String, expected: RegisterWidth, actual: RegisterWidth)
    RegisterReadDenied(block: String, register: String)
    RegisterWriteDenied(block: String, register: String)
    DuplicateInterrupt(name: String)
    DuplicateInterruptVector(vector: Int)
    InvalidInterruptEffect(interrupt: String, effect_name: String)
    UnknownInterrupt(interrupt: String)
    InterruptEffectForbidden(interrupt: String, handler: String, effect_name: String)
    InterruptHandlerUnbounded(interrupt: String, handler: String)
    DuplicateDMAChannel(name: String)
    DuplicateDMAChannelNumber(channel: Int)
    DMATransferSizeZero(channel: String)
    UnknownDMAChannel(channel: String)
    DMAOwnershipMismatch(channel: String, buffer: String, expected: TargetDMAOwner, actual: TargetDMAOwner)
    DMAStartWhileInFlight(channel: String, buffer: String)
    DMAWaitWithoutTransfer(channel: String, buffer: String)
    DMABufferUnavailable(channel: String, buffer: String)
    DMAWaitChannelMismatch(channel: String, buffer: String)
}

jet_target_abi_c: fn() -> ProviderABI Never! {
    ProviderABI{calling_convention: "C", version: "1"}
}

jet_target_hardware_empty: fn() -> TargetHardwareFacts Never! {
    TargetHardwareFacts{
        svd: None,
        register_blocks: [TargetRegisterBlockFact]{},
        interrupts: [TargetInterruptFact]{},
        dma_channels: [TargetDMAChannelFact]{},
    }
}

jet_target_machine_base: fn(name: String, triple: String, no_os: Bool, linker: LinkerInput, allocator: AllocatorPolicy, panic: PanicPolicy, mmio: MMIOPolicy, wall_clock: ClockPolicy, monotonic_clock: ClockPolicy, zone_data: ClockPolicy, sleep: ClockPolicy, entropy: EntropyPolicy, scheduler: SchedulerPolicy, byte_sink: ByteSinkPolicy, startup: StartupPolicy, startup_entry: String, startup_vectors: String, startup_placement: String, package_version: String) -> TargetMachine Never! {
    layout: jet_target_layout_from_triple(triple, package_version)
    TargetMachine{
        name: name,
        triple: triple,
        layout: layout.facts,
        no_os: no_os,
        memory: [MemoryRegion]{},
        linker: linker,
        allocator: allocator,
        panic: panic,
        mmio: mmio,
        wall_clock: wall_clock,
        monotonic_clock: monotonic_clock,
        zone_data: zone_data,
        sleep: sleep,
        entropy: entropy,
        scheduler: scheduler,
        byte_sink: byte_sink,
        startup: startup,
        startup_entry: startup_entry,
        startup_vectors: startup_vectors,
        startup_abi: jet_target_abi_c(),
        startup_placement: startup_placement,
        hardware: jet_target_hardware_empty(),
        programmers: [TargetProgrammerFacts]{},
        audit: AuditPolicy{build_artifact: true, dossier_lens: true},
    }
}

jet_target_machine_hosted: fn(triple: String, package_version: String) -> TargetMachine Never! {
    jet_target_machine_base(
        "hosted",
        triple,
        false,
        LinkerInput.HostedDefault,
        AllocatorPolicy.HostedDefault,
        PanicPolicy.HostedDefault,
        MMIOPolicy.HostedDefault,
        ClockPolicy.HostedDefault,
        ClockPolicy.HostedDefault,
        ClockPolicy.HostedDefault,
        ClockPolicy.HostedDefault,
        EntropyPolicy.HostedDefault,
        SchedulerPolicy.HostedDefault,
        ByteSinkPolicy.HostedDefault,
        StartupPolicy.HostedDefault,
        "",
        "",
        "",
        package_version,
    )
}

jet_target_machine_bare_metal: fn(name: String, triple: String, package_version: String) -> TargetMachine Never! {
    jet_target_machine_base(
        name,
        triple,
        true,
        LinkerInput.Generated,
        AllocatorPolicy.Unspecified,
        PanicPolicy.Unspecified,
        MMIOPolicy.Unspecified,
        ClockPolicy.Unspecified,
        ClockPolicy.Unspecified,
        ClockPolicy.Unspecified,
        ClockPolicy.Unspecified,
        EntropyPolicy.Unspecified,
        SchedulerPolicy.Unspecified,
        ByteSinkPolicy.Unspecified,
        StartupPolicy.Unspecified,
        "Reset_Handler",
        "vectors",
        ".vectors",
        package_version,
    )
}

jet_target_append_u64: fn(bytes: &[U8], value: Int) Never! {
    loop index in 0..<8 -> bytes.push(U8{((value >> (8 * index))).bit_and(255)})
}

jet_target_append_frame: fn(bytes: &[U8], label: String, value: String) Never! {
    jet_target_append_u64(bytes, label.bytes().len())
    loop byte in label.bytes() -> bytes.push(byte)
    jet_target_append_u64(bytes, value.bytes().len())
    loop byte in value.bytes() -> bytes.push(byte)
}

jet_target_json_hex: fn(value: Int) -> String Never! {
    if value < 10 -> return String.from_bytes([U8{48 + value}]) ?? "0"
    String.from_bytes([U8{87 + value}]) ?? "0"
}

jet_target_json_quote: fn(value: String) -> String Never! {
    bytes: value.bytes()
    output := "\""
    segment_start := 0
    index := 0
    loop index < bytes.len() {
        byte: Int.from_u8(bytes[index])
        escape: if byte == {
            34 -> "\\\""
            92 -> "\\\\"
            10 -> "\\n"
            13 -> "\\r"
            9 -> "\\t"
            else -> {
                if byte < 32 -> "\\u00{jet_target_json_hex(((byte >> 4)).bit_and(15))}{jet_target_json_hex((byte).bit_and(15))}" else -> ""
            }
        }
        if {
            escape.len() > 0 -> {
                if segment_start < index {
                    chunk: String.from_bytes(bytes[segment_start..index - 1]) ?? ""
                    output = "{output}{chunk}"
                }
                output = "{output}{escape}"
                index += 1
                segment_start = index
            }
            else -> {
                index += 1
            }
        }
    }
    if segment_start < bytes.len() {
        chunk: String.from_bytes(bytes[segment_start..bytes.len() - 1]) ?? ""
        output = "{output}{chunk}"
    }
    "{output}\""
}

jet_target_bool_json: fn(value: Bool) -> String Never! {
    if value -> "true" else -> "false"
}

jet_target_optional_int_json: fn(value: Int?) -> String Never! {
    actual: value ?? return "null"
    "{actual}"
}

jet_target_optional_string_json: fn(value: String?) -> String Never! {
    actual: value ?? return "null"
    jet_target_json_quote(actual)
}

jet_target_optional_contract_json: fn(value: ProviderContract?) -> String Never! {
    contract: value ?? return "null"
    jet_target_provider_contract_json(contract)
}

jet_target_provider_contract_json: fn(value: ProviderContract) -> String Never! {
    "{{\"provider\":{jet_target_json_quote(value.provider)},\"sha256\":{jet_target_json_quote(value.sha256)},\"provenance\":{jet_target_json_quote(value.provenance)},\"abi\":{jet_target_abi_json(value.abi)},\"limits\":{jet_target_provider_limits_json(value.limits)}}}"
}

jet_target_abi_json: fn(value: ProviderABI) -> String Never! {
    "{{\"calling_convention\":{jet_target_json_quote(value.calling_convention)},\"version\":{jet_target_json_quote(value.version)}}}"
}

jet_target_provider_limits_json: fn(value: ProviderLimits) -> String Never! {
    "{{\"max_request_bytes\":{jet_target_optional_int_json(value.max_request_bytes)},\"max_response_bytes\":{jet_target_optional_int_json(value.max_response_bytes)},\"max_calls\":{jet_target_optional_int_json(value.max_calls)}}}"
}

jet_target_linker_json: fn(value: LinkerInput) -> String Never! {
    if value == {
        .HostedDefault -> "{{\"kind\":\"hosted-default\"}}"
        .Unspecified -> "{{\"kind\":\"unspecified\"}}"
        .Generated -> "{{\"kind\":\"generated\"}}"
        .File(path, sha256) -> "{{\"kind\":\"file\",\"path\":{jet_target_json_quote(path)},\"sha256\":{jet_target_json_quote(sha256)}}}"
    }
}

jet_target_allocator_json: fn(value: AllocatorPolicy) -> String Never! {
    if value == {
        .HostedDefault -> "{{\"kind\":\"hosted-default\"}}"
        .Unspecified -> "{{\"kind\":\"unspecified\"}}"
        .NoAllocator -> "{{\"kind\":\"none\"}}"
        .Provider(provider) -> "{{\"kind\":\"provider\",\"contract\":{jet_target_provider_contract_json(provider)}}}"
        .Fixed(region, size) -> "{{\"kind\":\"fixed\",\"region\":{jet_target_json_quote(region)},\"size_bytes\":{size.bytes}}}"
        .Counting(cap) -> "{{\"kind\":\"counting\",\"wraps\":\"system\",\"cap_bytes\":{jet_target_optional_byte_size_json(cap)}}}"
    }
}

jet_target_optional_byte_size_json: fn(value: ByteSize?) -> String Never! {
    size: value ?? return "null"
    "{size.bytes}"
}

jet_target_panic_json: fn(value: PanicPolicy) -> String Never! {
    if value == {
        .HostedDefault -> "{{\"kind\":\"hosted-default\"}}"
        .Unspecified -> "{{\"kind\":\"unspecified\"}}"
        .Abort -> "{{\"kind\":\"abort\"}}"
        .Report(provider) -> "{{\"kind\":\"report\",\"contract\":{jet_target_provider_contract_json(provider)}}}"
    }
}

jet_target_clock_json: fn(value: ClockPolicy) -> String Never! {
    if value == {
        .HostedDefault -> "{{\"kind\":\"hosted-default\"}}"
        .Unspecified -> "{{\"kind\":\"unspecified\"}}"
        .NoClock -> "{{\"kind\":\"none\"}}"
        .Provider(provider) -> "{{\"kind\":\"provider\",\"contract\":{jet_target_provider_contract_json(provider)}}}"
    }
}

jet_target_entropy_json: fn(value: EntropyPolicy) -> String Never! {
    if value == {
        .HostedDefault -> "{{\"kind\":\"hosted-default\"}}"
        .Unspecified -> "{{\"kind\":\"unspecified\"}}"
        .NoEntropy -> "{{\"kind\":\"none\"}}"
        .Provider(provider) -> "{{\"kind\":\"provider\",\"contract\":{jet_target_provider_contract_json(provider)}}}"
    }
}

jet_target_scheduler_json: fn(value: SchedulerPolicy) -> String Never! {
    if value == {
        .HostedDefault -> "{{\"kind\":\"hosted-default\"}}"
        .Unspecified -> "{{\"kind\":\"unspecified\"}}"
        .NoScheduler -> "{{\"kind\":\"none\"}}"
        .Cooperative(provider) -> "{{\"kind\":\"cooperative\",\"contract\":{jet_target_provider_contract_json(provider)}}}"
        .InterruptDriven(provider) -> "{{\"kind\":\"interrupt-driven\",\"contract\":{jet_target_provider_contract_json(provider)}}}"
        .BoardRuntime(provider) -> "{{\"kind\":\"board-runtime\",\"contract\":{jet_target_provider_contract_json(provider)}}}"
    }
}

jet_target_mmio_json: fn(value: MMIOPolicy) -> String Never! {
    if value == {
        .HostedDefault -> "{{\"kind\":\"hosted-default\"}}"
        .Unspecified -> "{{\"kind\":\"unspecified\"}}"
        .NoMMIO -> "{{\"kind\":\"none\"}}"
        .Provider(provider) -> "{{\"kind\":\"provider\",\"contract\":{jet_target_provider_contract_json(provider)}}}"
    }
}

jet_target_byte_sink_json: fn(value: ByteSinkPolicy) -> String Never! {
    if value == {
        .HostedDefault -> "{{\"kind\":\"hosted-default\"}}"
        .Unspecified -> "{{\"kind\":\"unspecified\"}}"
        .NoByteSink -> "{{\"kind\":\"none\"}}"
        .Provider(read, write, report) -> "{{\"kind\":\"provider\",\"read\":{jet_target_optional_contract_json(read)},\"write\":{jet_target_optional_contract_json(write)},\"report\":{jet_target_optional_contract_json(report)}}}"
    }
}

jet_target_byte_sink_component_json: fn(value: ByteSinkPolicy, component: String) -> String Never! {
    if value == {
        .HostedDefault -> "{{\"kind\":\"hosted-default\"}}"
        .Unspecified -> "{{\"kind\":\"unspecified\"}}"
        .NoByteSink -> "{{\"kind\":\"none\"}}"
        .Provider(read, write, report) -> {
            contract: if component == {
                "read" -> read
                "write" -> write
                else -> report
            }
            "{{\"kind\":\"provider\",\"contract\":{jet_target_optional_contract_json(contract)}}}"
        }
    }
}

jet_target_startup_json: fn(value: StartupPolicy) -> String Never! {
    if value == {
        .HostedDefault -> "{{\"kind\":\"hosted-default\"}}"
        .Unspecified -> "{{\"kind\":\"unspecified\"}}"
        .Generated(provider) -> "{{\"kind\":\"generated\",\"contract\":{jet_target_provider_contract_json(provider)}}}"
    }
}

jet_target_register_width_name: fn(value: RegisterWidth) -> String Never! {
    if value == {
        .U8 -> "u8"
        .U16 -> "u16"
        .U32 -> "u32"
        .U64 -> "u64"
    }
}

jet_target_register_access_name: fn(value: TargetRegisterAccessMode) -> String Never! {
    if value == {
        .ReadOnly -> "read-only"
        .WriteOnly -> "write-only"
        .ReadWrite -> "read-write"
    }
}

jet_target_memory_kind_name: fn(value: MemoryKind) -> String Never! {
    if value == {
        .Flash -> "flash"
        .Ram -> "ram"
        .MMIO -> "mmio"
        .Reserved -> "reserved"
    }
}

jet_target_memory_access_name: fn(value: MemoryAccess) -> String Never! {
    if value == {
        .R -> "r"
        .Rw -> "rw"
        .Rx -> "rx"
        .Rwx -> "rwx"
    }
}

jet_target_memory_json: fn(regions: [MemoryRegion]) -> String Never! {
    rows := [String]{}
    loop region in regions {
        rows.push("{{\"name\":{jet_target_json_quote(region.name)},\"origin\":{region.origin},\"size_bytes\":{region.size.bytes},\"kind\":{jet_target_json_quote(jet_target_memory_kind_name(region.kind))},\"access\":{jet_target_json_quote(jet_target_memory_access_name(region.access))}}}")
    }
    "[{rows.join(",")}]"
}

jet_target_hardware_json: fn(facts: TargetHardwareFacts) -> String Never! {
    svd: if facts.svd == {
        .Val(provenance) -> "{{\"source\":{jet_target_json_quote(provenance.source)},\"sha256\":{jet_target_json_quote(provenance.sha256)}}}"
        .None -> "null"
    }
    blocks := [String]{}
    loop block in facts.register_blocks {
        registers := [String]{}
        loop register in block.registers {
            registers.push("{{\"name\":{jet_target_json_quote(register.name)},\"offset\":{register.offset},\"width\":{jet_target_json_quote(jet_target_register_width_name(register.width))},\"access\":{jet_target_json_quote(jet_target_register_access_name(register.access))},\"volatile\":{jet_target_bool_json(register.volatile)}}}")
        }
        blocks.push("{{\"name\":{jet_target_json_quote(block.name)},\"base\":{block.base},\"size_bytes\":{block.size.bytes},\"registers\":[{registers.join(",")}]}}")
    }
    interrupts := [String]{}
    loop interrupt in facts.interrupts {
        effects := [String]{}
        loop effect_name in interrupt.forbidden_effects -> effects.push(jet_target_json_quote(effect_name))
        interrupts.push("{{\"name\":{jet_target_json_quote(interrupt.name)},\"vector\":{interrupt.vector},\"forbidden_effects\":[{effects.join(",")}],\"bounded\":{jet_target_bool_json(interrupt.bounded)}}}")
    }
    channels := [String]{}
    loop channel in facts.dma_channels {
        ownership: if channel.ownership == TargetDMAOwnership.Borrowed -> "borrowed" else -> "transfer"
        channels.push("{{\"name\":{jet_target_json_quote(channel.name)},\"channel\":{channel.channel},\"transfer_width\":{jet_target_json_quote(jet_target_register_width_name(channel.transfer_width))},\"ownership\":{jet_target_json_quote(ownership)},\"max_transfer_bytes\":{jet_target_optional_int_json(channel.max_transfer_bytes)}}}")
    }
    "{{\"svd\":{svd},\"register_blocks\":[{blocks.join(",")}],\"interrupts\":[{interrupts.join(",")}],\"dma_channels\":[{channels.join(",")}]}}"
}

jet_target_programmer_adapter_name: fn(value: TargetProgrammerAdapter) -> String Never! {
    if value == {
        .Emulator -> "emulator"
        .ProbeRs -> "probe-rs"
        .OpenOcd -> "openocd"
    }
}

jet_target_programmers_json: fn(programmers: [TargetProgrammerFacts]) -> String Never! {
    rows := [String]{}
    loop programmer in programmers {
        config := [String]{}
        loop value in programmer.config -> config.push(jet_target_json_quote(value))
        rows.push("{{\"adapter\":{jet_target_json_quote(jet_target_programmer_adapter_name(programmer.adapter))},\"chip\":{jet_target_optional_string_json(programmer.chip)},\"config\":[{config.join(",")}],\"cpu\":{jet_target_optional_string_json(programmer.cpu)},\"executable\":{jet_target_json_quote(programmer.executable)},\"interface\":{jet_target_optional_string_json(programmer.interface)},\"machine\":{jet_target_optional_string_json(programmer.machine)},\"reset\":{jet_target_bool_json(programmer.reset)},\"speed_khz\":{jet_target_optional_int_json(programmer.speed_khz)}}}")
    }
    "[{rows.join(",")}]"
}

// Rust TargetProgrammerFacts::missing_fact.
jet_target_programmer_missing_fact: fn(facts: TargetProgrammerFacts) -> String? Never! {
    if facts.executable.trim().is_empty() -> return Val("executable")
    loop value in facts.config {
        if value.trim().is_empty() -> return Val("config")
    }
    if facts.adapter == {
        .Emulator -> {
            machine: facts.machine ?? ""
            if machine.trim().is_empty() -> return Val("machine")
            cpu: facts.cpu ?? ""
            if cpu.trim().is_empty() -> return Val("cpu")
        }
        .ProbeRs -> {
            chip: facts.chip ?? ""
            if chip.trim().is_empty() -> return Val("chip")
        }
        .OpenOcd -> {
            interface: facts.interface ?? ""
            if interface.trim().is_empty() && facts.config.is_empty() -> return Val("interface or config")
        }
    }
    None
}

jet_target_atomic_word_supported: fn(triple: String) -> Bool Never! {
    triple.starts_with("x86_64-") || triple.starts_with("aarch64-") || triple.starts_with("wasm32-")
}

jet_target_provider_facts_json: fn(machine: TargetMachine) -> String Never! {
    facts := [String]{}
    loop capability in TARGET_CAPABILITY_ALL {
        facts.push("{{\"capability\":{jet_target_json_quote(jet_target_capability_name(capability))},\"fact\":{jet_target_capability_fact_json(machine, capability)}}}")
    }
    "[{facts.join(",")}]"
}

jet_target_capability_fact_json: fn(machine: TargetMachine, capability: TargetCapability) -> String Never! {
    if capability == {
        .Allocator -> jet_target_allocator_json(machine.allocator)
        .Memory -> jet_target_memory_json(machine.memory)
        .Atomic64 -> "{{\"triple\":{jet_target_json_quote(machine.triple)},\"supported\":{jet_target_bool_json(jet_target_atomic_word_supported(machine.triple))}}}"
        .MMIO -> jet_target_mmio_json(machine.mmio)
        .Hardware -> jet_target_hardware_json(machine.hardware)
        .TimeWall -> jet_target_clock_json(machine.wall_clock)
        .TimeMonotonic -> jet_target_clock_json(machine.monotonic_clock)
        .TimeZoneData -> jet_target_clock_json(machine.zone_data)
        .TimeSleep -> jet_target_clock_json(machine.sleep)
        .Entropy -> jet_target_entropy_json(machine.entropy)
        .Scheduler -> jet_target_scheduler_json(machine.scheduler)
        .IORead -> jet_target_byte_sink_component_json(machine.byte_sink, "read")
        .IOWrite -> jet_target_byte_sink_component_json(machine.byte_sink, "write")
        .Panic -> jet_target_panic_json(machine.panic)
        .PanicReport -> "{{\"panic\":{jet_target_panic_json(machine.panic)},\"sink\":{jet_target_byte_sink_component_json(machine.byte_sink, "report")}}}"
        .Startup -> "{{\"policy\":{jet_target_startup_json(machine.startup)},\"entry\":{jet_target_json_quote(machine.startup_entry)},\"vectors\":{jet_target_json_quote(machine.startup_vectors)},\"abi\":{jet_target_abi_json(machine.startup_abi)},\"placement\":{jet_target_json_quote(machine.startup_placement)}}}"
    }
}

jet_target_environment_identity: fn(machine: TargetMachine) -> String Never! {
    if {
        machine.no_os -> "no-os"
        machine.triple.contains("wasip") -> "wasi"
        machine.triple == "wasm32-unknown-unknown" -> "browser"
        else -> "hosted"
    }
}

// The effects code built for a hosted `machine` is denied, the row the
// machine's `core.target` facts derive: a web build's host starts no
// processes and makes no C foreign calls; a native or WASI host lacks none.
// A machine with no OS is checked by its own policies instead.
jet_target_machine_denied_effects: fn(machine: TargetMachine) -> [String] Never! {
    if jet_target_environment_identity(machine) == "browser" -> return [String]{"Exec", "FFI.C"}
    [String]{}
}

jet_target_provider_identity: fn(machine: TargetMachine) -> String Never! {
    bytes := [U8]{}
    jet_target_append_frame(bytes, "environment", jet_target_environment_identity(machine))
    jet_target_append_frame(bytes, "linker", jet_target_linker_json(machine.linker))
    jet_target_append_frame(bytes, "allocator", jet_target_allocator_json(machine.allocator))
    jet_target_append_frame(bytes, "panic", jet_target_panic_json(machine.panic))
    jet_target_append_frame(bytes, "memory", jet_target_memory_json(machine.memory))
    jet_target_append_frame(bytes, "mmio", jet_target_mmio_json(machine.mmio))
    jet_target_append_frame(bytes, "time_wall", jet_target_clock_json(machine.wall_clock))
    jet_target_append_frame(bytes, "time_monotonic", jet_target_clock_json(machine.monotonic_clock))
    jet_target_append_frame(bytes, "time_zone_data", jet_target_clock_json(machine.zone_data))
    jet_target_append_frame(bytes, "time_sleep", jet_target_clock_json(machine.sleep))
    jet_target_append_frame(bytes, "entropy", jet_target_entropy_json(machine.entropy))
    jet_target_append_frame(bytes, "scheduler", jet_target_scheduler_json(machine.scheduler))
    jet_target_append_frame(bytes, "byte_sink", jet_target_byte_sink_json(machine.byte_sink))
    jet_target_append_frame(bytes, "startup", jet_target_startup_json(machine.startup))
    jet_target_append_frame(bytes, "provider_facts", jet_target_provider_facts_json(machine))
    jet_target_append_frame(bytes, "hardware", jet_target_hardware_json(machine.hardware))
    jet_target_append_frame(bytes, "programmers", jet_target_programmers_json(machine.programmers))
    jet_target_append_frame(bytes, "layout_facts", jet_target_layout_cache_identity(machine.layout))
    "target-providers-v1:{sha256_hex_bytes(sha256_bytes(bytes[0..<bytes.len()]))}"
}

// The target dossier: one JSON object with the machine's name, triple,
// environment and provider identity, every policy and provider fact, and the
// tiers it runs at. It exists only for a machine whose audit policy keeps the
// dossier lens.
jet_target_machine_dossier_json: fn(machine: TargetMachine) -> String? Never! {
    if !machine.audit.dossier_lens -> return None
    fields: [String]{
        "\"name\":{jet_target_json_quote(machine.name)}",
        "\"triple\":{jet_target_json_quote(machine.triple)}",
        "\"environment\":{jet_target_json_quote(jet_target_environment_identity(machine))}",
        "\"provider_identity\":{jet_target_json_quote(jet_target_provider_identity(machine))}",
        "\"linker\":{jet_target_linker_json(machine.linker)}",
        "\"allocator\":{jet_target_allocator_json(machine.allocator)}",
        "\"panic\":{jet_target_panic_json(machine.panic)}",
        "\"memory\":{jet_target_memory_json(machine.memory)}",
        "\"mmio_capability\":{jet_target_mmio_json(machine.mmio)}",
        "\"time_wall\":{jet_target_clock_json(machine.wall_clock)}",
        "\"time_monotonic\":{jet_target_clock_json(machine.monotonic_clock)}",
        "\"time_zone_data\":{jet_target_clock_json(machine.zone_data)}",
        "\"time_sleep\":{jet_target_clock_json(machine.sleep)}",
        "\"entropy\":{jet_target_entropy_json(machine.entropy)}",
        "\"scheduler\":{jet_target_scheduler_json(machine.scheduler)}",
        "\"byte_sink\":{jet_target_byte_sink_json(machine.byte_sink)}",
        "\"startup\":{jet_target_startup_json(machine.startup)}",
        "\"provider_facts\":{jet_target_provider_facts_json(machine)}",
        "\"hardware\":{jet_target_hardware_json(machine.hardware)}",
        "\"programmers\":{jet_target_programmers_json(machine.programmers)}",
        "\"execution\":{{\"aot\":true,\"dev\":{jet_target_bool_json(!machine.no_os)}}}",
        "\"audit\":{{\"build_artifact\":{jet_target_bool_json(machine.audit.build_artifact)},\"dossier_lens\":true}}",
    }
    Val("{{{fields.join(",")}}}")
}

jet_target_allocator_provides_heap: fn(policy: AllocatorPolicy) -> Bool Never! {
    if policy == {
        .HostedDefault | .Provider(_) | .Fixed(_, _) | .Counting(_) -> true
        .Unspecified | .NoAllocator -> false
    }
}

jet_target_max_runtime_layer: fn(machine: TargetMachine) -> RuntimeLayer Never! {
    if {
        !machine.no_os -> RuntimeLayer.Std
        jet_target_allocator_provides_heap(machine.allocator) -> RuntimeLayer.Alloc
        else -> RuntimeLayer.Core
    }
}

jet_target_machine_for_facts: fn(no_os: Bool, web_target: Bool, target_triple: String, package_version: String) -> TargetMachine Never! {
    if {
        web_target -> jet_target_machine_wasm_browser(package_version)
        target_triple == "wasm32-wasip2" -> jet_target_machine_wasm_wasi(package_version)
        no_os -> jet_target_machine_bare_metal("no-os", target_triple, package_version)
        else -> jet_target_machine_hosted(target_triple, package_version)
    }
}

jet_target_wasm_provider: fn(name: String, implementation: String) -> ProviderContract Never! {
    bytes := [U8]{}
    jet_target_append_frame(bytes, "provider", name)
    jet_target_append_frame(bytes, "implementation", implementation)
    digest: sha256_hex_bytes(sha256_bytes(bytes[0..<bytes.len()]))
    ProviderContract{
        provider: name,
        sha256: "sha256:{digest}",
        provenance: "provider:{name}",
        abi: jet_target_abi_c(),
        limits: ProviderLimits{max_request_bytes: None, max_response_bytes: None, max_calls: None},
    }
}

jet_target_machine_wasm_browser: fn(package_version: String) -> TargetMachine Never! {
    machine := jet_target_machine_hosted("wasm32-unknown-unknown", package_version)
    machine.name = "wasm.browser"
    machine.allocator = AllocatorPolicy.Provider{provider: jet_target_wasm_provider("wasm.browser.allocator", "wasm-browser-allocator")}
    machine.panic = PanicPolicy.Report{provider: jet_target_wasm_provider("wasm.browser.report", "wasm-browser-report")}
    machine.mmio = MMIOPolicy.NoMMIO
    machine.wall_clock = ClockPolicy.Provider{provider: jet_target_wasm_provider("wasm.browser.wall_clock", "wasm-browser-wall")}
    machine.monotonic_clock = ClockPolicy.Provider{provider: jet_target_wasm_provider("wasm.browser.monotonic_clock", "wasm-browser-mono")}
    machine.zone_data = ClockPolicy.Provider{provider: jet_target_wasm_provider("wasm.browser.zone_data", "wasm-browser-zone")}
    machine.sleep = ClockPolicy.Provider{provider: jet_target_wasm_provider("wasm.browser.sleep", "wasm-browser-sleep")}
    machine.entropy = EntropyPolicy.Provider{provider: jet_target_wasm_provider("wasm.browser.entropy", "wasm-browser-entropy")}
    machine.scheduler = SchedulerPolicy.Cooperative{provider: jet_target_wasm_provider("wasm.browser.scheduler", "wasm-browser-scheduler")}
    machine.byte_sink = ByteSinkPolicy.Provider{
        read: Val(jet_target_wasm_provider("wasm.browser.io_read", "wasm-browser-read")),
        write: Val(jet_target_wasm_provider("wasm.browser.io_write", "wasm-browser-write")),
        report: Val(jet_target_wasm_provider("wasm.browser.report", "wasm-browser-report")),
    }
    machine.startup = StartupPolicy.Generated{provider: jet_target_wasm_provider("wasm.browser.startup", "wasm-browser-startup")}
    machine
}

jet_target_machine_wasm_wasi: fn(package_version: String) -> TargetMachine Never! {
    machine := jet_target_machine_hosted("wasm32-wasip2", package_version)
    machine.name = "wasm.wasi"
    machine.allocator = AllocatorPolicy.Provider{provider: jet_target_wasm_provider("wasm.wasi.allocator", "wasm-wasi-allocator")}
    machine.panic = PanicPolicy.Report{provider: jet_target_wasm_provider("wasm.wasi.report", "wasm-wasi-report")}
    machine.mmio = MMIOPolicy.NoMMIO
    machine.wall_clock = ClockPolicy.Provider{provider: jet_target_wasm_provider("wasm.wasi.wall_clock", "wasm-wasi-wall")}
    machine.monotonic_clock = ClockPolicy.Provider{provider: jet_target_wasm_provider("wasm.wasi.monotonic_clock", "wasm-wasi-mono")}
    machine.zone_data = ClockPolicy.Provider{provider: jet_target_wasm_provider("wasm.wasi.zone_data", "wasm-wasi-zone")}
    machine.sleep = ClockPolicy.Provider{provider: jet_target_wasm_provider("wasm.wasi.sleep", "wasm-wasi-sleep")}
    machine.entropy = EntropyPolicy.Provider{provider: jet_target_wasm_provider("wasm.wasi.entropy", "wasm-wasi-entropy")}
    machine.scheduler = SchedulerPolicy.BoardRuntime{provider: jet_target_wasm_provider("wasm.wasi.scheduler", "wasm-wasi-scheduler")}
    machine.byte_sink = ByteSinkPolicy.Provider{
        read: Val(jet_target_wasm_provider("wasm.wasi.io_read", "wasm-wasi-read")),
        write: Val(jet_target_wasm_provider("wasm.wasi.io_write", "wasm-wasi-write")),
        report: Val(jet_target_wasm_provider("wasm.wasi.report", "wasm-wasi-report")),
    }
    machine.startup = StartupPolicy.Generated{provider: jet_target_wasm_provider("wasm.wasi.startup", "wasm-wasi-startup")}
    machine
}

jet_target_package_version_from_compiler_identity: fn(identity: String) -> String? {
    identity_parts := identity.split("@").to_list()
    if identity_parts.len() != 2 || identity_parts[0].len() == 0 -> return None
    build_parts := identity_parts[1].split("#").to_list()
    if build_parts.len() != 2 || build_parts[0].len() == 0 -> return None
    Val(build_parts[0])
}

// The OS `#build.target.os` folds on: Freestanding for a machine with no OS (a
// bare-metal or no-OS Wasm machine), else the OS its triple names
// (jet_target_triple_os), else the host's (`host_os` is a key such as
// `macos`), else Linux.
jet_target_active_os_name: fn(machine: TargetMachine, host_os: String) -> String Never! {
    if machine.no_os -> return target_os_name(TTargetOS.Freestanding)
    if jet_target_triple_os(machine.triple) == .Val(os) -> return target_os_name(os)
    target_os_name(target_os_parse(host_os) ?? TTargetOS.Linux)
}

// The OS a target triple names: Web for the browser's Wasm triple, Wasm for
// any other Wasm triple, else the triple's native OS; None when it names
// none.
jet_target_triple_os: fn(triple: String) -> TTargetOS? Never! {
    if {
        triple == "wasm32-unknown-unknown" -> Val(TTargetOS.Web)
        triple.starts_with("wasm") -> Val(TTargetOS.Wasm)
        triple.contains("windows") -> Val(TTargetOS.Windows)
        triple.contains("apple") || triple.contains("darwin") -> Val(TTargetOS.MacOS)
        triple.contains("linux") -> Val(TTargetOS.Linux)
        else -> None
    }
}

// Rust TargetMachineUse::default.
jet_target_machine_use_default: fn() -> TargetMachineUse Never! {
    TargetMachineUse{stack_bytes: 0, static_ram_bytes: 0, heap_required: false,
        core_apis: [String]{}, mmio: [MMIOAccess]{}, required_capabilities: [TargetCapability]{}}
}

// Rust TargetCapability::as_str.
jet_target_capability_name: fn(capability: TargetCapability) -> String Never! {
    if capability == {
        .Allocator -> "Target.Allocator"
        .Memory -> "Target.Memory"
        .Atomic64 -> "Target.Atomic64"
        .MMIO -> "Target.MMIO"
        .Hardware -> "Target.Hardware"
        .TimeWall -> "Time.Wall"
        .TimeMonotonic -> "Time.Monotonic"
        .TimeZoneData -> "Time.ZoneData"
        .TimeSleep -> "Time.Sleep"
        .Entropy -> "Rand.Entropy"
        .Scheduler -> "Target.Scheduler"
        .IORead -> "IO.Read"
        .IOWrite -> "IO.Write"
        .Panic -> "Target.Panic"
        .PanicReport -> "Panic.Report"
        .Startup -> "Target.Startup"
    }
}

// Rust capabilities_for_core_usage.
jet_target_capabilities_for_core_usage: fn(api: String) -> [TargetCapability] Never! {
    bytes: api.bytes()
    separator := 0
    loop separator + 1 < bytes.len() {
        if Int.from_u8(bytes[separator]) == 58 && Int.from_u8(bytes[separator + 1]) == 58 -> break
        separator += 1
    }
    module_name := api
    helper := ""
    if separator + 1 < bytes.len() {
        module_name = String.from_bytes(bytes[0..<separator]) ?? ""
        helper = String.from_bytes(bytes[separator + 2..<bytes.len()]) ?? ""
    }
    result := [TargetCapability]{}
    if module_name == {
        "core.mem" -> if helper == "Atomic" || helper == "atomic" -> result.push(.Atomic64)
        "core.term" -> {
            reads: [String]{"", "__input_lines", "__input_edit", "readline", "read_until", "read_all_input", "take", "buffered", "stdin", "binread", "read_key", "confirm", "choose", "select"}
            writes: [String]{"", "__input_edit", "print", "eprint", "progress", "binwrite", "stdout", "stderr", "style", "style_force"}
            if reads.contains(helper) -> result.push(.IORead)
            if writes.contains(helper) -> result.push(.IOWrite)
        }
        "core.concurrency" | "core.tasks" -> result.push(.Scheduler)
        "core.time" -> {
            if helper == {
                "sleep" | "delay" | "yield" | "wait" -> result.push(.TimeSleep)
                "instant" | "monotonic" | "elapsed" | "elapsed_millis" -> result.push(.TimeMonotonic)
                "zone" | "zone_data" | "named_zone" -> result.push(.TimeZoneData)
                "" | "typed_head" | "__duration__" | "duration" -> {}
                else -> result.push(.TimeWall)
            }
        }
        "core.crypto.random" | "core.crypto.uuid" -> result.push(.Entropy)
        "core.hardware" -> result.push(.Hardware)
        else -> {}
    }
    result
}

// Rust TargetMachineUse::from_core_apis.
jet_target_machine_use_from_core_apis: fn(apis: [String]) -> TargetMachineUse Never! {
    usage := jet_target_machine_use_default()
    sorted := apis.copy()
    sorted.sort()
    loop api in sorted {
        if usage.core_apis.is_empty() || usage.core_apis[usage.core_apis.len() - 1] != api -> usage.core_apis.push(api)
    }
    loop row in jet_ring_classify_prelude_closure(usage.core_apis) {
        if jet_ring_layer_rank(row.layer) >= jet_ring_layer_rank(.Alloc) -> usage.heap_required = true
    }
    loop api in usage.core_apis {
        loop capability in jet_target_capabilities_for_core_usage(api) {
            if !usage.required_capabilities.contains(capability) -> usage.required_capabilities.push(capability)
        }
    }
    usage
}

// Rust ProviderAbi::is_valid / ProviderContract::is_valid.
jet_target_no_whitespace: fn(value: String) -> Bool Never! {
    // UTF-8 spellings of Rust char::is_whitespace. Scan the borrowed byte
    // view rather than allocating chars and a one-character String per scalar.
    bytes: value.bytes()
    loop index in 0..<bytes.len() {
        first: Int.from_u8(bytes[index])
        if first == 32 || (first >= 9 && first <= 13) -> return false
        if index + 1 < bytes.len() && first == 194 {
            second: Int.from_u8(bytes[index + 1])
            if second == 133 || second == 160 -> return false
        }
        if index + 2 < bytes.len() {
            second: Int.from_u8(bytes[index + 1])
            third: Int.from_u8(bytes[index + 2])
            if first == 225 && second == 154 && third == 128 -> return false
            if first == 226 && second == 128 && ((third >= 128 && third <= 138) || third == 168 || third == 169 || third == 175) -> return false
            if first == 226 && second == 129 && third == 159 -> return false
            if first == 227 && second == 128 && third == 128 -> return false
        }
    }
    true
}
jet_target_abi_valid: fn(abi: ProviderABI) -> Bool Never! {
    !abi.calling_convention.trim().is_empty() && !abi.version.trim().is_empty()
        && jet_target_no_whitespace(abi.calling_convention) && jet_target_no_whitespace(abi.version)
}
jet_target_provider_valid: fn(provider: ProviderContract) -> Bool Never! {
    if provider.provider.trim().is_empty() || provider.provenance.trim().is_empty() || !jet_target_abi_valid(provider.abi) -> return false
    if !provider.sha256.starts_with("sha256:") -> return false
    digest: String.from_bytes(provider.sha256.bytes()[7..<provider.sha256.bytes().len()]) ?? ""
    if digest.trim().is_empty() || !jet_target_no_whitespace(digest) -> return false
    limits: [Int?]{provider.limits.max_request_bytes, provider.limits.max_response_bytes, provider.limits.max_calls}
    loop limit in limits {
        if limit == Val(bound) && bound <= 0 -> return false
    }
    true
}

// Rust MemoryRegion::end / contains.
jet_target_memory_end: fn(region: MemoryRegion) -> Int? Never! {
    end: region.origin + region.size.bytes
    if end > 18446744073709551615 -> None else -> Val(end)
}
jet_target_memory_contains: fn(region: MemoryRegion, origin: Int, size: ByteSize) -> Bool Never! {
    end: jet_target_memory_end(region) ?? return false
    access_end: origin + size.bytes
    access_end <= 18446744073709551615 && region.origin <= origin && access_end <= end
}
// Whether the machine declares a RAM region, the no-OS form of `Target.Memory`.
jet_target_memory_declares_ram: fn(regions: [MemoryRegion]) -> Bool Never! {
    loop region in regions {
        if region.kind == .Ram -> return true
    }
    false
}

// Rust policy provider/provides methods.
jet_target_clock_provider: fn(policy: ClockPolicy) -> ProviderContract? Never! {
    if policy == {
        .Provider(provider) -> Val(provider)
        .HostedDefault | .Unspecified | .NoClock -> None
    }
}
jet_target_scheduler_provider: fn(policy: SchedulerPolicy) -> ProviderContract? Never! {
    if policy == {
        .Cooperative(provider) | .InterruptDriven(provider) | .BoardRuntime(provider) -> Val(provider)
        .HostedDefault | .Unspecified | .NoScheduler -> None
    }
}
jet_target_sink_provider: fn(policy: ByteSinkPolicy, capability: TargetCapability) -> ProviderContract? Never! {
    if policy == {
        .Provider(read, write, report) -> if capability == {
            .IORead -> read
            .IOWrite -> write
            .Allocator | .Memory | .Atomic64 | .MMIO | .Hardware | .TimeWall | .TimeMonotonic | .TimeZoneData | .TimeSleep | .Entropy | .Scheduler | .Panic | .PanicReport | .Startup -> report
        }
        .HostedDefault | .Unspecified | .NoByteSink -> None
    }
}
// Rust TargetMachine::provides_capability.
jet_target_machine_provides_capability: fn(machine: TargetMachine, capability: TargetCapability) -> Bool Never! {
    hosted: jet_target_environment_identity(machine) == "hosted"
    if capability == {
        .Allocator -> if machine.allocator == {
            .HostedDefault | .Counting(_) -> hosted
            .Provider(_) | .Fixed(_, _) -> true
            .Unspecified | .NoAllocator -> false
        }
        .Memory -> hosted || jet_target_memory_declares_ram(machine.memory)
        .Atomic64 -> jet_target_atomic_word_supported(machine.triple)
        .MMIO -> if machine.mmio == {
            .HostedDefault -> hosted
            .Provider(_) -> true
            .Unspecified | .NoMMIO -> false
        }
        .Hardware -> !machine.hardware.register_blocks.is_empty() || !machine.hardware.interrupts.is_empty() || !machine.hardware.dma_channels.is_empty()
        .TimeWall -> (hosted && machine.wall_clock == .HostedDefault) || jet_target_clock_provider(machine.wall_clock) != None
        .TimeMonotonic -> (hosted && machine.monotonic_clock == .HostedDefault) || jet_target_clock_provider(machine.monotonic_clock) != None
        .TimeZoneData -> (hosted && machine.zone_data == .HostedDefault) || jet_target_clock_provider(machine.zone_data) != None
        .TimeSleep -> (hosted && machine.sleep == .HostedDefault) || jet_target_clock_provider(machine.sleep) != None
        .Entropy -> if machine.entropy == {
            .HostedDefault -> hosted
            .Provider(_) -> true
            .Unspecified | .NoEntropy -> false
        }
        .Scheduler -> (hosted && machine.scheduler == .HostedDefault) || jet_target_scheduler_provider(machine.scheduler) != None
        .Panic -> if machine.panic == {
            .HostedDefault -> hosted
            .Abort | .Report(_) -> true
            .Unspecified -> false
        }
        .IORead | .IOWrite | .PanicReport -> (hosted && machine.byte_sink == .HostedDefault) || jet_target_sink_provider(machine.byte_sink, capability) != None
        .Startup -> if machine.startup == {
            .HostedDefault -> hosted
            .Generated(_) -> true
            .Unspecified -> false
        }
    }
}

// Rust push_unique / validate_provider_contract / validate_simple_capability.
jet_target_push_unique: fn(errors: &[TargetMachineError], error: TargetMachineError) Never! {
    if !errors.contains(error) -> errors.push(error.copy())
}
jet_target_validate_provider_contract: fn(capability: TargetCapability, provider: ProviderContract, errors: &[TargetMachineError]) Never! {
    if !jet_target_provider_valid(provider) -> jet_target_push_unique(errors, .InvalidProviderContract{capability: jet_target_capability_name(capability), provider: provider.provider, sha256: provider.sha256})
}
jet_target_validate_simple_capability: fn(machine: TargetMachine, capability: TargetCapability, declared: Bool, hosted_default: Bool, provider: ProviderContract?, errors: &[TargetMachineError]) Never! {
    if machine.no_os {
        if {
            hosted_default -> jet_target_push_unique(errors, .HostedCapabilityRequiresOS{capability: jet_target_capability_name(capability)})
            (!declared) -> jet_target_push_unique(errors, .MissingTargetCapability{capability: jet_target_capability_name(capability)})
            else -> {}
        }
    }
    if provider == Val(contract) -> jet_target_validate_provider_contract(capability, contract, errors)
}

// Rust validate_memory_regions; sort indices, not copied region payloads.
jet_target_validate_memory_regions: fn(regions: [MemoryRegion], errors: &[TargetMachineError]) Never! {
    names := [String:Bool]{}
    indices := [Int]{}
    loop index in 0..<regions.len() {
        region: regions[index]
        if region.size.bytes == 0 -> errors.push(.EmptyMemoryRegion{name: region.name})
        if jet_target_memory_end(region) == None -> errors.push(.MemoryAddressOverflow{name: region.name})
        if {
            names.has_key(region.name) -> errors.push(.DuplicateMemoryRegion{name: region.name})
            else -> names[region.name] = true
        }
        indices.push(index)
    }
    indices.sort_by(fn(a: Int, b: Int) { regions[a].origin <=> regions[b].origin })
    loop index in 1..<indices.len() {
        first: regions[indices[index - 1]]
        second: regions[indices[index]]
        end: jet_target_memory_end(first) ?? next
        if end > second.origin -> errors.push(.OverlappingMemoryRegions{first: first.name, second: second.name})
    }
}

// Rust validate_linker.
jet_target_validate_linker: fn(linker: LinkerInput, no_os: Bool, errors: &[TargetMachineError]) Never! {
    if linker == {
        .Unspecified -> if no_os -> errors.push(.MissingLinkerInput)
        .File(path, sha256) -> {
            if path.trim().is_empty() -> errors.push(.LinkerFileMissingPath)
            if !sha256.starts_with("sha256:") || sha256.bytes().len() <= 7 -> errors.push(.LinkerFileMissingHash{path: path})
        }
        .HostedDefault | .Generated -> {}
    }
}
// Rust validate_allocator.
jet_target_validate_allocator: fn(machine: TargetMachine, errors: &[TargetMachineError]) Never! {
    if machine.allocator == {
        .Unspecified -> if machine.no_os -> errors.push(.MissingAllocatorPolicy)
        .HostedDefault | .Counting(_) -> if machine.no_os -> errors.push(.HostedAllocatorRequiresOS)
        .Provider(provider) -> jet_target_validate_provider_contract(.Allocator, provider, errors)
        .Fixed(region, size) -> {
            loop memory in machine.memory {
                if memory.name != region -> next
                if {
                    memory.kind != .Ram -> errors.push(.AllocatorRegionNotRam{region: region})
                    size.bytes > memory.size.bytes -> errors.push(.AllocatorRegionTooSmall{region: region, requested_bytes: size.bytes, available_bytes: memory.size.bytes})
                    else -> {}
                }
                return
            }
            errors.push(.AllocatorRegionUnknown{region: region})
        }
        .NoAllocator -> {}
    }
}
// Rust validate_panic.
jet_target_validate_panic: fn(machine: TargetMachine, errors: &[TargetMachineError]) Never! {
    if machine.no_os && (machine.panic == .Unspecified || machine.panic == .HostedDefault) -> errors.push(.MissingPanicPolicy)
    if machine.panic == .Report(provider) -> jet_target_validate_provider_contract(.PanicReport, provider, errors)
}
// Rust validate_ram_budget.
jet_target_validate_ram_budget: fn(machine: TargetMachine, usage: TargetMachineUse, errors: &[TargetMachineError]) Never! {
    if !machine.no_os -> return
    kinds: [MemoryKind]{.Flash, .Ram}
    loop kind in kinds {
        present := false
        loop region in machine.memory { if region.kind == kind -> present = true }
        if !present -> errors.push(.MissingMemoryKind{kind: kind})
    }
    // CLI-37 Main/Pip ruling: keep the true RAM total in exact Int; the
    // reference's u64 sum can wrap into a false small budget. Used bytes
    // retain Rust's saturation below. Integration also fixes Rust to u128.
    ram := 0
    loop region in machine.memory { if region.kind == .Ram -> ram += region.size.bytes }
    fixed: if machine.allocator == {
        .Fixed(_, size) -> size.bytes
        .HostedDefault | .Unspecified | .NoAllocator | .Provider(_) | .Counting(_) -> 0
    }
    sum: usage.stack_bytes + usage.static_ram_bytes + fixed
    used: if sum > 18446744073709551615 -> 18446744073709551615 else -> sum
    if ram > 0 && used > ram -> errors.push(.RamOverflow{used_bytes: used, ram_bytes: ram})
}
// Rust validate_core_usage.
jet_target_validate_core_usage: fn(machine: TargetMachine, usage: TargetMachineUse, errors: &[TargetMachineError]) Never! {
    if usage.heap_required && !jet_target_machine_provides_capability(machine, .Allocator) -> errors.push(.HeapRequiresAllocator)
    available: jet_target_max_runtime_layer(machine)
    loop row in jet_ring_classify_prelude_closure(usage.core_apis) {
        if jet_ring_layer_rank(row.layer) > jet_ring_layer_rank(available) -> errors.push(.CoreAPIUnavailable{api: row.key, required: row.layer, available: available})
    }
}

// Rust validate_target_capabilities.
jet_target_validate_target_capabilities: fn(machine: TargetMachine, usage: TargetMachineUse, errors: &[TargetMachineError]) Never! {
    mmio_provider: if machine.mmio == {
        .Provider(provider) -> Val(provider)
        .HostedDefault | .Unspecified | .NoMMIO -> None
    }
    jet_target_validate_simple_capability(machine, .MMIO, machine.mmio != .Unspecified, machine.mmio == .HostedDefault, mmio_provider, errors)
    jet_target_validate_simple_capability(machine, .TimeWall, machine.wall_clock != .Unspecified, machine.wall_clock == .HostedDefault, jet_target_clock_provider(machine.wall_clock), errors)
    jet_target_validate_simple_capability(machine, .TimeMonotonic, machine.monotonic_clock != .Unspecified, machine.monotonic_clock == .HostedDefault, jet_target_clock_provider(machine.monotonic_clock), errors)
    jet_target_validate_simple_capability(machine, .TimeZoneData, machine.zone_data != .Unspecified, machine.zone_data == .HostedDefault, jet_target_clock_provider(machine.zone_data), errors)
    jet_target_validate_simple_capability(machine, .TimeSleep, machine.sleep != .Unspecified, machine.sleep == .HostedDefault, jet_target_clock_provider(machine.sleep), errors)
    entropy_provider: if machine.entropy == {
        .Provider(provider) -> Val(provider)
        .HostedDefault | .Unspecified | .NoEntropy -> None
    }
    jet_target_validate_simple_capability(machine, .Entropy, machine.entropy != .Unspecified, machine.entropy == .HostedDefault, entropy_provider, errors)
    jet_target_validate_simple_capability(machine, .Scheduler, machine.scheduler != .Unspecified, machine.scheduler == .HostedDefault, jet_target_scheduler_provider(machine.scheduler), errors)
    startup_provider: if machine.startup == {
        .Generated(provider) -> Val(provider)
        .HostedDefault | .Unspecified -> None
    }
    jet_target_validate_simple_capability(machine, .Startup, machine.startup != .Unspecified, machine.startup == .HostedDefault, startup_provider, errors)
    sinks: [TargetCapability]{.IORead, .IOWrite, .PanicReport}
    if machine.byte_sink == {
        .HostedDefault -> if machine.no_os {
            loop capability in sinks -> jet_target_push_unique(errors, .HostedCapabilityRequiresOS{capability: jet_target_capability_name(capability)})
        }
        .Unspecified -> if machine.no_os {
            loop capability in sinks -> jet_target_push_unique(errors, .MissingTargetCapability{capability: jet_target_capability_name(capability)})
        }
        .Provider(read, write, report) -> {
            if read == Val(provider) -> jet_target_validate_provider_contract(.IORead, provider, errors)
            if write == Val(provider) -> jet_target_validate_provider_contract(.IOWrite, provider, errors)
            if report == Val(provider) -> jet_target_validate_provider_contract(.PanicReport, provider, errors)
        }
        .NoByteSink -> {}
    }
    if machine.panic == .Report(_) && !jet_target_machine_provides_capability(machine, .PanicReport) -> jet_target_push_unique(errors, .MissingTargetCapability{capability: "Panic.Report"})
    if !usage.mmio.is_empty() && !jet_target_machine_provides_capability(machine, .MMIO) -> jet_target_push_unique(errors, .MissingTargetCapability{capability: "Target.MMIO"})
    loop capability in usage.required_capabilities {
        if !jet_target_machine_provides_capability(machine, capability) -> jet_target_push_unique(errors, .MissingTargetCapability{capability: jet_target_capability_name(capability)})
    }
}
// Rust validate_startup_facts.
jet_target_validate_startup_facts: fn(machine: TargetMachine, errors: &[TargetMachineError]) Never! {
    if !machine.no_os -> return
    if machine.startup == {
        .Generated(provider) -> {
            if machine.startup_entry.trim().is_empty() || machine.startup_vectors.trim().is_empty() || machine.startup_placement.trim().is_empty() -> jet_target_push_unique(errors, .MissingTargetCapability{capability: "Target.Startup"})
            if !jet_target_abi_valid(machine.startup_abi) -> jet_target_push_unique(errors, .InvalidProviderContract{capability: "Target.Startup", provider: provider.provider, sha256: provider.sha256})
        }
        .HostedDefault | .Unspecified -> {}
    }
}
// Rust validate_mmio.
jet_target_validate_mmio: fn(machine: TargetMachine, usage: TargetMachineUse, errors: &[TargetMachineError]) Never! {
    loop access in usage.mmio {
        inside := false
        loop region in machine.memory {
            if region.kind == .MMIO && jet_target_memory_contains(region, access.address, access.size) -> inside = true
        }
        if !inside -> errors.push(.MMIOOutsideRegion{address: access.address, size_bytes: access.size.bytes})
        if access.unsafe_gate == {
            Val(gate) -> if gate.reason.trim().is_empty() -> errors.push(.MMIOEmptyUnsafeReason{address: access.address})
            None -> errors.push(.MMIOMissingUnsafeGate{address: access.address})
        }
    }
}

// Rust TargetHardwareFacts::validate_into.
jet_target_hardware_validate_into: fn(hardware: TargetHardwareFacts, memory: [MemoryRegion], errors: &[TargetMachineError]) Never! {
    if hardware.svd == Val(svd) {
        digest: if svd.sha256.starts_with("sha256:") -> String.from_bytes(svd.sha256.bytes()[7..<svd.sha256.bytes().len()]) ?? "" else -> ""
        if svd.source.trim().is_empty() || digest.trim().is_empty() -> errors.push(.InvalidHardwareSVD{source: svd.source, sha256: svd.sha256})
    }
    blocks := [String:Bool]{}
    loop block in hardware.register_blocks {
        if block.name.trim().is_empty() -> errors.push(.HardwareFactEmptyName{kind: "register block"})
        if blocks.has_key(block.name) -> errors.push(.DuplicateRegisterBlock{name: block.name})
        blocks[block.name] = true
        if block.size.bytes == 0 -> errors.push(.RegisterBlockEmpty{name: block.name})
        if {
            block.base + block.size.bytes > 18446744073709551615 -> errors.push(.RegisterBlockAddressOverflow{name: block.name})
            else -> {
                inside := false
                loop region in memory {
                    if region.kind == .MMIO && jet_target_memory_contains(region, block.base, block.size) -> inside = true
                }
                if !inside -> errors.push(.RegisterBlockOutsideRegion{name: block.name, address: block.base, size_bytes: block.size.bytes})
            }
        }
        registers := [String:Bool]{}
        loop register in block.registers {
            if register.name.trim().is_empty() -> errors.push(.HardwareFactEmptyName{kind: "register in `{block.name}`"})
            if registers.has_key(register.name) -> errors.push(.DuplicateRegister{block: block.name, register: register.name})
            registers[register.name] = true
            width: if register.width == {
                .U8 -> 1
                .U16 -> 2
                .U32 -> 4
                .U64 -> 8
            }
            if {
                register.offset + width > 18446744073709551615 -> errors.push(.RegisterAddressOverflow{block: block.name, register: register.name})
                register.offset + width > block.size.bytes -> errors.push(.RegisterOutsideBlock{block: block.name, register: register.name})
                else -> {}
            }
        }
    }
    interrupts := [String:Bool]{}
    vectors := [Int:Bool]{}
    loop interrupt in hardware.interrupts {
        if interrupt.name.trim().is_empty() -> errors.push(.HardwareFactEmptyName{kind: "interrupt"})
        if interrupts.has_key(interrupt.name) -> errors.push(.DuplicateInterrupt{name: interrupt.name})
        interrupts[interrupt.name] = true
        if vectors.has_key(interrupt.vector) -> errors.push(.DuplicateInterruptVector{vector: interrupt.vector})
        vectors[interrupt.vector] = true
        loop effect_name in authority_holds(interrupt.forbidden_effects) {
            if authority_parse_right(effect_name) == None -> errors.push(.InvalidInterruptEffect{interrupt: interrupt.name, effect_name: effect_name})
        }
    }
    channels := [String:Bool]{}
    numbers := [Int:Bool]{}
    loop channel in hardware.dma_channels {
        if channel.name.trim().is_empty() -> errors.push(.HardwareFactEmptyName{kind: "DMA channel"})
        if channels.has_key(channel.name) -> errors.push(.DuplicateDMAChannel{name: channel.name})
        channels[channel.name] = true
        if numbers.has_key(channel.channel) -> errors.push(.DuplicateDMAChannelNumber{channel: channel.channel})
        numbers[channel.channel] = true
        if channel.max_transfer_bytes == Val(bound) && bound == 0 -> errors.push(.DMATransferSizeZero{channel: channel.name})
    }
}
// Rust TargetHardwareFacts::validate.
jet_target_hardware_validate: fn(hardware: TargetHardwareFacts, memory: [MemoryRegion]) -> [TargetMachineError] Never! {
    errors := [TargetMachineError]{}
    jet_target_hardware_validate_into(hardware, memory, errors)
    errors
}
// Rust TargetMachine::validate; preserve push order.
jet_target_machine_validate: fn(machine: TargetMachine, usage: TargetMachineUse) -> [TargetMachineError] Never! {
    errors := [TargetMachineError]{}
    if machine.triple.trim().is_empty() -> errors.push(.MissingTargetTriple)
    jet_target_validate_memory_regions(machine.memory, errors)
    jet_target_validate_linker(machine.linker, machine.no_os, errors)
    jet_target_validate_allocator(machine, errors)
    jet_target_validate_panic(machine, errors)
    jet_target_validate_ram_budget(machine, usage, errors)
    jet_target_validate_core_usage(machine, usage, errors)
    jet_target_validate_target_capabilities(machine, usage, errors)
    jet_target_validate_startup_facts(machine, errors)
    jet_target_validate_mmio(machine, usage, errors)
    jet_target_hardware_validate_into(machine.hardware, machine.memory, errors)
    errors
}

// Rust derive(Debug) for TargetMachineError. String :Debug delegates to Rust
// str Debug.
jet_target_machine_error_debug: fn(error: TargetMachineError) -> String Never! {
    if error == {
        .MissingTargetTriple -> "MissingTargetTriple"
        .MissingMemoryKind(kind) -> {
            name: if kind == {
                .Flash -> "Flash"
                .Ram -> "Ram"
                .MMIO -> "Mmio"
                .Reserved -> "Reserved"
            }
            "MissingMemoryKind {{ kind: {name} }}"
        }
        .DuplicateMemoryRegion(name) -> "DuplicateMemoryRegion {{ name: {name:Debug} }}"
        .EmptyMemoryRegion(name) -> "EmptyMemoryRegion {{ name: {name:Debug} }}"
        .MemoryAddressOverflow(name) -> "MemoryAddressOverflow {{ name: {name:Debug} }}"
        .OverlappingMemoryRegions(first, second) -> "OverlappingMemoryRegions {{ first: {first:Debug}, second: {second:Debug} }}"
        .MissingLinkerInput -> "MissingLinkerInput"
        .LinkerFileMissingPath -> "LinkerFileMissingPath"
        .LinkerFileMissingHash(path) -> "LinkerFileMissingHash {{ path: {path:Debug} }}"
        .MissingAllocatorPolicy -> "MissingAllocatorPolicy"
        .AllocatorRegionUnknown(region) -> "AllocatorRegionUnknown {{ region: {region:Debug} }}"
        .AllocatorRegionNotRam(region) -> "AllocatorRegionNotRam {{ region: {region:Debug} }}"
        .AllocatorRegionTooSmall(region, requested_bytes, available_bytes) -> "AllocatorRegionTooSmall {{ region: {region:Debug}, requested_bytes: {requested_bytes}, available_bytes: {available_bytes} }}"
        .HostedAllocatorRequiresOS -> "HostedAllocatorRequiresOs"
        .MissingPanicPolicy -> "MissingPanicPolicy"
        .MissingTargetCapability(capability) -> "MissingTargetCapability {{ capability: {capability:Debug} }}"
        .HostedCapabilityRequiresOS(capability) -> "HostedCapabilityRequiresOs {{ capability: {capability:Debug} }}"
        .InvalidProviderContract(capability, provider, sha256) -> "InvalidProviderContract {{ capability: {capability:Debug}, provider: {provider:Debug}, sha256: {sha256:Debug} }}"
        .RamOverflow(used_bytes, ram_bytes) -> "RamOverflow {{ used_bytes: {used_bytes}, ram_bytes: {ram_bytes} }}"
        .HeapRequiresAllocator -> "HeapRequiresAllocator"
        .CoreAPIUnavailable(api, required, available) -> {
            required_name: if required == {
                .Core -> "Core"
                .Alloc -> "Alloc"
                .Std -> "Std"
            }
            available_name: if available == {
                .Core -> "Core"
                .Alloc -> "Alloc"
                .Std -> "Std"
            }
            "CoreApiUnavailable {{ api: {api:Debug}, required: {required_name}, available: {available_name} }}"
        }
        .MMIOOutsideRegion(address, size_bytes) -> "MmioOutsideRegion {{ address: {address}, size_bytes: {size_bytes} }}"
        .MMIOMissingUnsafeGate(address) -> "MmioMissingUnsafeGate {{ address: {address} }}"
        .MMIOEmptyUnsafeReason(address) -> "MmioEmptyUnsafeReason {{ address: {address} }}"
        .HostedHasNoLinkerScript -> "HostedHasNoLinkerScript"
        .HostedHasNoStartup -> "HostedHasNoStartup"
        .UnsupportedStartupTriple(triple) -> "UnsupportedStartupTriple {{ triple: {triple:Debug} }}"
        .ExecutionTierUnsupported(tier, machine) -> "ExecutionTierUnsupported {{ tier: {tier:Debug}, machine: {machine:Debug} }}"
        .FirmwareToolchainMissing(tool) -> "FirmwareToolchainMissing {{ tool: {tool:Debug} }}"
        .FirmwareBuildFailed(detail) -> "FirmwareBuildFailed {{ detail: {detail:Debug} }}"
        .SizeBudgetExceeded(report) -> {
            flash_ok: jet_target_bool_json(report.flash_ok)
            ram_ok: jet_target_bool_json(report.ram_ok)
            "SizeBudgetExceeded {{ report: SizeBudgetReport {{ artifact_bytes: {report.artifact_bytes}, flash_bytes: {report.flash_bytes}, flash_ok: {flash_ok}, ram_bytes: {report.ram_bytes}, ram_used_bytes: {report.ram_used_bytes}, ram_ok: {ram_ok} }} }}"
        }
        .HardwareFactsMissingSVD -> "HardwareFactsMissingSvd"
        .InvalidHardwareSVD(source, sha256) -> "InvalidHardwareSvd {{ source: {source:Debug}, sha256: {sha256:Debug} }}"
        .HardwareFactEmptyName(kind) -> "HardwareFactEmptyName {{ kind: {kind:Debug} }}"
        .DuplicateRegisterBlock(name) -> "DuplicateRegisterBlock {{ name: {name:Debug} }}"
        .RegisterBlockEmpty(name) -> "RegisterBlockEmpty {{ name: {name:Debug} }}"
        .RegisterBlockAddressOverflow(name) -> "RegisterBlockAddressOverflow {{ name: {name:Debug} }}"
        .RegisterBlockOutsideRegion(name, address, size_bytes) -> "RegisterBlockOutsideRegion {{ name: {name:Debug}, address: {address}, size_bytes: {size_bytes} }}"
        .DuplicateRegister(block, register) -> "DuplicateRegister {{ block: {block:Debug}, register: {register:Debug} }}"
        .RegisterAddressOverflow(block, register) -> "RegisterAddressOverflow {{ block: {block:Debug}, register: {register:Debug} }}"
        .RegisterOutsideBlock(block, register) -> "RegisterOutsideBlock {{ block: {block:Debug}, register: {register:Debug} }}"
        .UnknownRegisterBlock(block) -> "UnknownRegisterBlock {{ block: {block:Debug} }}"
        .UnknownRegister(block, register) -> "UnknownRegister {{ block: {block:Debug}, register: {register:Debug} }}"
        .RegisterWidthMismatch(block, register, expected, actual) -> "RegisterWidthMismatch {{ block: {block:Debug}, register: {register:Debug}, expected: {expected:Debug}, actual: {actual:Debug} }}"
        .RegisterReadDenied(block, register) -> "RegisterReadDenied {{ block: {block:Debug}, register: {register:Debug} }}"
        .RegisterWriteDenied(block, register) -> "RegisterWriteDenied {{ block: {block:Debug}, register: {register:Debug} }}"
        .DuplicateInterrupt(name) -> "DuplicateInterrupt {{ name: {name:Debug} }}"
        .DuplicateInterruptVector(vector) -> "DuplicateInterruptVector {{ vector: {vector} }}"
        .InvalidInterruptEffect(interrupt, effect_name) -> "InvalidInterruptEffect {{ interrupt: {interrupt:Debug}, effect: {effect_name:Debug} }}"
        .UnknownInterrupt(interrupt) -> "UnknownInterrupt {{ interrupt: {interrupt:Debug} }}"
        .InterruptEffectForbidden(interrupt, handler, effect_name) -> "InterruptEffectForbidden {{ interrupt: {interrupt:Debug}, handler: {handler:Debug}, effect: {effect_name:Debug} }}"
        .InterruptHandlerUnbounded(interrupt, handler) -> "InterruptHandlerUnbounded {{ interrupt: {interrupt:Debug}, handler: {handler:Debug} }}"
        .DuplicateDMAChannel(name) -> "DuplicateDmaChannel {{ name: {name:Debug} }}"
        .DuplicateDMAChannelNumber(channel) -> "DuplicateDmaChannelNumber {{ channel: {channel} }}"
        .DMATransferSizeZero(channel) -> "DmaTransferSizeZero {{ channel: {channel:Debug} }}"
        .UnknownDMAChannel(channel) -> "UnknownDmaChannel {{ channel: {channel:Debug} }}"
        .DMAOwnershipMismatch(channel, buffer, expected, actual) -> {
            expected_name: if expected == {
                .CPU -> "Cpu"
                .Device -> "Device"
            }
            actual_name: if actual == {
                .CPU -> "Cpu"
                .Device -> "Device"
            }
            "DmaOwnershipMismatch {{ channel: {channel:Debug}, buffer: {buffer:Debug}, expected: {expected_name}, actual: {actual_name} }}"
        }
        .DMAStartWhileInFlight(channel, buffer) -> "DmaStartWhileInFlight {{ channel: {channel:Debug}, buffer: {buffer:Debug} }}"
        .DMAWaitWithoutTransfer(channel, buffer) -> "DmaWaitWithoutTransfer {{ channel: {channel:Debug}, buffer: {buffer:Debug} }}"
        .DMABufferUnavailable(channel, buffer) -> "DmaBufferUnavailable {{ channel: {channel:Debug}, buffer: {buffer:Debug} }}"
        .DMAWaitChannelMismatch(channel, buffer) -> "DmaWaitChannelMismatch {{ channel: {channel:Debug}, buffer: {buffer:Debug} }}"
    }
}
// Rust Vec<TargetMachineError> derive(Debug).
jet_target_machine_errors_debug: fn(errors: [TargetMachineError]) -> String Never! {
    rows: loop error in errors -> jet_target_machine_error_debug(error)
    "[{rows.join(", ")}]"
}

// Rust MemoryRegion::new.
jet_target_memory_region_new: fn(name: String, origin: Int, size: ByteSize, kind: MemoryKind, access: MemoryAccess) -> MemoryRegion Never! {
    MemoryRegion{name: name, origin: origin, size: size, kind: kind, access: access}
}
// Rust TargetMachine::with_startup_facts.
jet_target_machine_with_startup_facts: fn(machine: TargetMachine, entry: String, vectors: String, abi: ProviderABI, placement: String) -> TargetMachine Never! {
    result := machine
    result.startup_entry = entry
    result.startup_vectors = vectors
    result.startup_abi = abi
    result.startup_placement = placement
    result
}
// Rust builtin_provider. These digests are the immutable board implementation
// facts, calculated from Rust's exact adapter/startup format! bytes by
// CLI-37/oracle.py, not a profile-label hash.
jet_target_builtin_provider_digest: fn(name: String, digest: String) -> ProviderContract Never! {
    ProviderContract{provider: name, sha256: "sha256:{digest}",
        provenance: "builtin:{name};sha256:{digest}", abi: jet_target_abi_c(),
        limits: ProviderLimits{max_request_bytes: None, max_response_bytes: None, max_calls: None}}
}
// Rust TargetMachine::board_sensor_v1.
jet_target_machine_board_sensor_v1: fn(package_version: String) -> TargetMachine Never! {
    machine := jet_target_machine_bare_metal("board.sensor_v1", "thumbv7em-none-eabihf", package_version)
    machine.memory = [MemoryRegion]{
        jet_target_memory_region_new("flash", 0, ByteSize{bytes: 4194304}, .Flash, .Rx),
        jet_target_memory_region_new("ram", 0x20000000, ByteSize{bytes: 4194304}, .Ram, .Rw),
        jet_target_memory_region_new("peripherals", 0x40000000, ByteSize{bytes: 65536}, .MMIO, .Rw),
    }
    digest: "91b8448a7d4b24c5c83a79bb4504c6de2cd756795529029f46f86e0fb6279d57"
    machine.allocator = .NoAllocator
    machine.panic = .Abort
    machine.mmio = .Provider{provider: jet_target_builtin_provider_digest("board.sensor_v1.mmio", digest)}
    machine.wall_clock = .NoClock
    machine.monotonic_clock = .Provider{provider: jet_target_builtin_provider_digest("board.sensor_v1.systick", digest)}
    machine.zone_data = .NoClock
    machine.sleep = .Provider{provider: jet_target_builtin_provider_digest("board.sensor_v1.systick", digest)}
    machine.entropy = .NoEntropy
    machine.scheduler = .Cooperative{provider: jet_target_builtin_provider_digest("board.sensor_v1.cooperative", digest)}
    machine.byte_sink = .Provider{
        read: Val(jet_target_builtin_provider_digest("board.sensor_v1.uart_rx", digest)),
        write: Val(jet_target_builtin_provider_digest("board.sensor_v1.uart_tx", digest)),
        report: Val(jet_target_builtin_provider_digest("board.sensor_v1.report_uart", digest))}
    machine.startup = .Generated{provider: jet_target_builtin_provider_digest("board.sensor_v1.startup", "6a126b444bd1ad9269159ea88aebbe3c5e0034b68a2399761619c7d98ab91320")}
    machine.hardware.register_blocks = [TargetRegisterBlockFact]{
        {name: "UART0", base: 0x40004000, size: ByteSize{bytes: 0x14},
            registers: [TargetRegisterFact]{
                {name: "data", offset: 0, width: .U32, access: .ReadWrite, volatile: true},
                {name: "state", offset: 4, width: .U32, access: .ReadWrite, volatile: true},
                {name: "ctrl", offset: 8, width: .U32, access: .ReadWrite, volatile: true},
                {name: "bauddiv", offset: 16, width: .U32, access: .ReadWrite, volatile: true},
            }},
    }
    machine
}
// Rust TargetMachine::board_virt_aarch64.
jet_target_machine_board_virt_aarch64: fn(package_version: String) -> TargetMachine Never! {
    machine := jet_target_machine_with_startup_facts(jet_target_machine_bare_metal("board.virt_aarch64", "aarch64-unknown-none", package_version), "_start", "vectors", ProviderABI{calling_convention: "AArch64", version: "1"}, ".vectors")
    machine.memory = [MemoryRegion]{
        jet_target_memory_region_new("flash", 0x40000000, ByteSize{bytes: 1048576}, .Flash, .Rx),
        jet_target_memory_region_new("ram", 0x40100000, ByteSize{bytes: 1048576}, .Ram, .Rw),
        jet_target_memory_region_new("uart0", 0x09000000, ByteSize{bytes: 4096}, .MMIO, .Rw),
    }
    digest: "9c805c6bee9baecf958f958aeaa6a517b0b0333c0df66d6e6a68d8337da668dd"
    machine.allocator = .NoAllocator
    machine.panic = .Abort
    machine.mmio = .Provider{provider: jet_target_builtin_provider_digest("board.virt_aarch64.mmio", digest)}
    machine.wall_clock = .NoClock
    machine.monotonic_clock = .NoClock
    machine.zone_data = .NoClock
    machine.sleep = .NoClock
    machine.entropy = .NoEntropy
    machine.scheduler = .NoScheduler
    sink: jet_target_builtin_provider_digest("board.virt_aarch64.uart0", digest)
    machine.byte_sink = .Provider{read: None, write: Val(sink), report: Val(sink)}
    machine.startup = .Generated{provider: jet_target_builtin_provider_digest("board.virt_aarch64.startup", "f1f5931350c9036875f628dbddb4a42eeb4df50f43fe2c7241a909498f53e96c")}
    machine.programmers = [TargetProgrammerFacts]{
        {adapter: .Emulator, executable: "qemu-system-aarch64", chip: None,
            interface: None, config: [String]{}, speed_khz: None, reset: false,
            machine: Val("virt"), cpu: Val("cortex-a57")},
    }
    machine
}
// Rust TargetMachine::wasm_no_os.
jet_target_machine_wasm_no_os: fn(package_version: String) -> TargetMachine Never! {
    machine := jet_target_machine_bare_metal("wasm.no-os", "wasm32-unknown-unknown", package_version)
    machine.memory = [MemoryRegion]{
        jet_target_memory_region_new("flash", 0, ByteSize{bytes: 16777216}, .Flash, .Rx),
        jet_target_memory_region_new("ram", 0x01000000, ByteSize{bytes: 16777216}, .Ram, .Rw),
    }
    machine.allocator = .NoAllocator
    machine.panic = .Abort
    machine.mmio = .NoMMIO
    machine.wall_clock = .NoClock
    machine.monotonic_clock = .NoClock
    machine.zone_data = .NoClock
    machine.sleep = .NoClock
    machine.entropy = .NoEntropy
    machine.scheduler = .NoScheduler
    machine.byte_sink = .NoByteSink
    machine.startup = .Generated{provider: jet_target_wasm_provider("wasm.no-os.startup", "wasm-no-os-startup")}
    machine
}

// Rust ExecutionTier: the tier a selected machine runs a program on.
TargetExecutionTier: enum { AOT Dev }

jet_target_execution_tier_name: fn(tier: TargetExecutionTier) -> String Never! {
    if tier == {
        .AOT -> "aot"
        .Dev -> "dev"
    }
}

// Rust TargetMachine::supports_execution_tier: no-OS machines are AOT-only;
// hosted ones keep Dev.
jet_target_machine_supports_execution_tier: fn(machine: TargetMachine, tier: TargetExecutionTier) -> TargetMachineError? Never! {
    if machine.no_os && tier == .Dev -> return Val(.ExecutionTierUnsupported{tier: jet_target_execution_tier_name(tier), machine: machine.name})
    None
}

// Rust jet-sema check_target_machine: every validation error of `machine`
// for `usage` as its registered target diagnostic (E3303, E3310-E3314), so
// human and machine output share one diagnostic contract.
jet_target_machine_diagnostics: fn(machine: TargetMachine, usage: TargetMachineUse) -> [Diagnostic] Never! {
    loop error in jet_target_machine_validate(machine, usage) -> jet_target_machine_error_diagnostic(machine, error)
}

// The machine's name, or its triple when the name is blank.
jet_target_machine_display_name: fn(machine: TargetMachine) -> String Never! {
    if machine.name.trim().is_empty() -> machine.triple else -> machine.name
}

// One registry row's What, Why and Fix with each `{names[i]}` placeholder
// filled in with `values[i]`.
jet_target_registry_diagnostic: fn(code: String, names: [String], values: [String]) -> Diagnostic Never! {
    row: diagnostic_registry_row(code) ?? panic("{code} is not registered")
    what := row.what
    why := row.why
    fix := row.fix
    loop (at, name) in names {
        what = what.replace("{{{name}}}", values[at])
        why = why.replace("{{{name}}}", values[at])
        fix = fix.replace("{{{name}}}", values[at])
    }
    diagnostic_from_registry(code, None, what, why, fix)
}

// `0x` and the address in uppercase hex, as Rust `{address:X}`.
jet_target_address_hex: fn(address: Int) -> String Never! {
    "0x{diagnostic_lower_hex(address, 1).to_upper()}"
}

jet_target_mmio_diagnostic: fn(target: String, detail: String) -> Diagnostic Never! {
    jet_target_registry_diagnostic("E3313", [String]{"target", "detail"}, [String]{target, detail})
}

jet_target_machine_error_diagnostic: fn(machine: TargetMachine, error: TargetMachineError) -> Diagnostic Never! {
    target: jet_target_machine_display_name(machine)
    if error == {
        .CoreAPIUnavailable(api, required, available) -> jet_target_registry_diagnostic("E3310", [String]{"api", "required", "available", "target"}, [String]{api, jet_ring_layer_name(required), jet_ring_layer_name(available), target})
        .HeapRequiresAllocator | .MissingAllocatorPolicy -> jet_target_registry_diagnostic("E3303", [String]{}, [String]{})
        .MissingTargetCapability(capability) | .HostedCapabilityRequiresOS(capability) -> jet_target_registry_diagnostic("E3311", [String]{"target", "capability"}, [String]{target, capability})
        .InvalidProviderContract(capability, provider, sha256) -> jet_target_registry_diagnostic("E3312", [String]{"target", "capability", "provider", "sha256"}, [String]{target, capability, provider, sha256})
        .MMIOOutsideRegion(address, size_bytes) -> jet_target_mmio_diagnostic(target, "address {jet_target_address_hex(address)} ({size_bytes} bytes) is outside a declared MMIO region")
        .MMIOMissingUnsafeGate(address) -> jet_target_mmio_diagnostic(target, "address {jet_target_address_hex(address)} has no #Unsafe gate")
        .MMIOEmptyUnsafeReason(address) -> jet_target_mmio_diagnostic(target, "address {jet_target_address_hex(address)} has an empty #Unsafe reason")
        .MissingTargetTriple | .MissingMemoryKind(_) | .DuplicateMemoryRegion(_) | .EmptyMemoryRegion(_) | .MemoryAddressOverflow(_) | .OverlappingMemoryRegions(_, _) | .MissingLinkerInput | .LinkerFileMissingPath | .LinkerFileMissingHash(_) | .AllocatorRegionUnknown(_) | .AllocatorRegionNotRam(_) | .AllocatorRegionTooSmall(_, _, _) | .HostedAllocatorRequiresOS | .MissingPanicPolicy | .RamOverflow(_, _) | .HostedHasNoLinkerScript | .HostedHasNoStartup | .UnsupportedStartupTriple(_) | .ExecutionTierUnsupported(_, _) | .FirmwareToolchainMissing(_) | .FirmwareBuildFailed(_) | .SizeBudgetExceeded(_) | .HardwareFactsMissingSVD | .InvalidHardwareSVD(_, _) | .HardwareFactEmptyName(_) | .DuplicateRegisterBlock(_) | .RegisterBlockEmpty(_) | .RegisterBlockAddressOverflow(_) | .RegisterBlockOutsideRegion(_, _, _) | .DuplicateRegister(_, _) | .RegisterAddressOverflow(_, _) | .RegisterOutsideBlock(_, _) | .UnknownRegisterBlock(_) | .UnknownRegister(_, _) | .RegisterWidthMismatch(_, _, _, _) | .RegisterReadDenied(_, _) | .RegisterWriteDenied(_, _) | .DuplicateInterrupt(_) | .DuplicateInterruptVector(_) | .InvalidInterruptEffect(_, _) | .UnknownInterrupt(_) | .InterruptEffectForbidden(_, _, _) | .InterruptHandlerUnbounded(_, _) | .DuplicateDMAChannel(_) | .DuplicateDMAChannelNumber(_) | .DMATransferSizeZero(_) | .UnknownDMAChannel(_) | .DMAOwnershipMismatch(_, _, _, _) | .DMAStartWhileInFlight(_, _) | .DMAWaitWithoutTransfer(_, _) | .DMABufferUnavailable(_, _) | .DMAWaitChannelMismatch(_, _) -> jet_target_registry_diagnostic("E3314", [String]{"target", "fact", "detail"}, [String]{target, jet_target_fact_name(error), jet_target_fact_detail(error)})
    }
}

jet_target_memory_kind_label: fn(kind: MemoryKind) -> String Never! {
    if kind == {
        .Flash -> "flash"
        .Ram -> "RAM"
        .MMIO -> "MMIO"
        .Reserved -> "reserved"
    }
}

jet_target_dma_owner_label: fn(owner: TargetDMAOwner) -> String Never! {
    if owner == {
        .CPU -> "CPU"
        .Device -> "device"
    }
}

// The fact an E3314 target fact error names (Rust generic_detail's first
// half).
jet_target_fact_name: fn(error: TargetMachineError) -> String Never! {
    if error == {
        .MissingTargetTriple -> "target triple"
        .MissingMemoryKind(_) | .DuplicateMemoryRegion(_) | .EmptyMemoryRegion(_) | .MemoryAddressOverflow(_) | .OverlappingMemoryRegions(_, _) | .RamOverflow(_, _) -> "memory"
        .MissingLinkerInput | .LinkerFileMissingPath | .LinkerFileMissingHash(_) | .HostedHasNoLinkerScript -> "linker"
        .AllocatorRegionUnknown(_) | .AllocatorRegionNotRam(_) | .AllocatorRegionTooSmall(_, _, _) | .HostedAllocatorRequiresOS -> "allocator"
        .MissingPanicPolicy -> "panic"
        .HostedHasNoStartup | .UnsupportedStartupTriple(_) -> "startup"
        .ExecutionTierUnsupported(_, _) -> "execution"
        .FirmwareToolchainMissing(_) -> "toolchain"
        .FirmwareBuildFailed(_) -> "firmware"
        .SizeBudgetExceeded(_) -> "size budget"
        .HardwareFactsMissingSVD | .InvalidHardwareSVD(_, _) | .HardwareFactEmptyName(_) -> "hardware profile"
        .DuplicateRegisterBlock(_) | .RegisterBlockEmpty(_) | .RegisterBlockAddressOverflow(_) | .RegisterBlockOutsideRegion(_, _, _) | .DuplicateRegister(_, _) | .RegisterAddressOverflow(_, _) | .RegisterOutsideBlock(_, _) | .UnknownRegisterBlock(_) | .UnknownRegister(_, _) | .RegisterWidthMismatch(_, _, _, _) | .RegisterReadDenied(_, _) | .RegisterWriteDenied(_, _) -> "registers"
        .DuplicateInterrupt(_) | .DuplicateInterruptVector(_) | .InvalidInterruptEffect(_, _) | .UnknownInterrupt(_) | .InterruptEffectForbidden(_, _, _) | .InterruptHandlerUnbounded(_, _) -> "interrupts"
        .DuplicateDMAChannel(_) | .DuplicateDMAChannelNumber(_) | .DMATransferSizeZero(_) | .UnknownDMAChannel(_) | .DMAOwnershipMismatch(_, _, _, _) | .DMAStartWhileInFlight(_, _) | .DMAWaitWithoutTransfer(_, _) | .DMABufferUnavailable(_, _) | .DMAWaitChannelMismatch(_, _) -> "DMA"
        .MissingAllocatorPolicy | .MissingTargetCapability(_) | .HostedCapabilityRequiresOS(_) | .InvalidProviderContract(_, _, _) | .HeapRequiresAllocator | .CoreAPIUnavailable(_, _, _) | .MMIOOutsideRegion(_, _) | .MMIOMissingUnsafeGate(_) | .MMIOEmptyUnsafeReason(_) -> "target"
    }
}

// What is wrong with the fact jet_target_fact_name names (Rust
// generic_detail's second half).
jet_target_fact_detail: fn(error: TargetMachineError) -> String Never! {
    if error == {
        .MissingTargetTriple -> "the selected target triple is empty"
        .MissingMemoryKind(kind) -> "the target is missing a {jet_target_memory_kind_label(kind)} memory region"
        .DuplicateMemoryRegion(name) -> "memory region `{name}` is declared more than once"
        .EmptyMemoryRegion(name) -> "memory region `{name}` has zero size"
        .MemoryAddressOverflow(name) -> "memory region `{name}` overflows the address space"
        .OverlappingMemoryRegions(first, second) -> "memory regions `{first}` and `{second}` overlap"
        .MissingLinkerInput -> "the no-OS target has no linker input"
        .LinkerFileMissingPath -> "the linker file path is empty"
        .LinkerFileMissingHash(path) -> "linker file `{path}` has no valid sha256 provenance"
        .AllocatorRegionUnknown(region) -> "allocator region `{region}` does not exist"
        .AllocatorRegionNotRam(region) -> "allocator region `{region}` is not RAM"
        .AllocatorRegionTooSmall(region, requested_bytes, available_bytes) -> "allocator region `{region}` has {available_bytes} bytes but needs {requested_bytes}"
        .HostedAllocatorRequiresOS -> "a hosted system allocator cannot be selected on a no-OS target"
        .MissingPanicPolicy -> "the no-OS target has no panic policy"
        .RamOverflow(used_bytes, ram_bytes) -> "RAM use ({used_bytes} bytes) exceeds {ram_bytes} bytes"
        .HostedHasNoLinkerScript -> "hosted targets do not have a generated linker script"
        .HostedHasNoStartup -> "hosted targets do not have generated startup glue"
        .UnsupportedStartupTriple(triple) -> "target triple `{triple}` has no startup generator"
        .ExecutionTierUnsupported(tier, machine_name) -> "target machine `{machine_name}` does not support the `{tier}` tier"
        .FirmwareToolchainMissing(tool) -> "required firmware tool `{tool}` is unavailable"
        .FirmwareBuildFailed(detail) -> detail
        .SizeBudgetExceeded(report) -> "artifact={report.artifact_bytes} flash={report.flash_bytes} ram={report.ram_bytes} used_ram={report.ram_used_bytes}"
        .HardwareFactsMissingSVD -> "register, interrupt, or DMA facts require SVD provenance"
        .InvalidHardwareSVD(source, sha256) -> "SVD `{source}` has invalid sha256 provenance `{sha256}`"
        .HardwareFactEmptyName(kind) -> "{kind} fact has an empty name"
        .DuplicateRegisterBlock(name) -> "register block `{name}` is declared more than once"
        .RegisterBlockEmpty(name) -> "register block `{name}` has zero size"
        .RegisterBlockAddressOverflow(name) -> "register block `{name}` overflows the address space"
        .RegisterBlockOutsideRegion(name, address, size_bytes) -> "register block `{name}` at {jet_target_address_hex(address)} ({size_bytes} bytes) is outside a declared MMIO region"
        .DuplicateRegister(block, register) -> "register `{register}` is declared more than once in `{block}`"
        .RegisterAddressOverflow(block, register) -> "register `{block}.{register}` overflows the address space"
        .RegisterOutsideBlock(block, register) -> "register `{block}.{register}` lies outside its block"
        .UnknownRegisterBlock(block) -> "register block `{block}` is not in the target SVD"
        .UnknownRegister(block, register) -> "register `{block}.{register}` is not in the target SVD"
        .RegisterWidthMismatch(block, register, expected, actual) -> "`{block}.{register}` requires {jet_target_register_width_name(expected)} but operation requested {jet_target_register_width_name(actual)}"
        .RegisterReadDenied(block, register) -> "register `{block}.{register}` is not readable"
        .RegisterWriteDenied(block, register) -> "register `{block}.{register}` is not writable"
        .DuplicateInterrupt(name) -> "interrupt `{name}` is declared more than once"
        .DuplicateInterruptVector(vector) -> "interrupt vector {vector} is declared more than once"
        .InvalidInterruptEffect(interrupt, effect_name) -> "interrupt `{interrupt}` has invalid effect `{effect_name}`"
        .UnknownInterrupt(interrupt) -> "interrupt `{interrupt}` is not in the target vector table"
        .InterruptEffectForbidden(interrupt, handler, effect_name) -> "handler `{handler}` for `{interrupt}` uses forbidden effect `{effect_name}`"
        .InterruptHandlerUnbounded(interrupt, handler) -> "handler `{handler}` for `{interrupt}` is not bounded"
        .DuplicateDMAChannel(name) -> "DMA channel `{name}` is declared more than once"
        .DuplicateDMAChannelNumber(channel) -> "DMA channel number {channel} is declared more than once"
        .DMATransferSizeZero(channel) -> "DMA channel `{channel}` has a zero transfer limit"
        .UnknownDMAChannel(channel) -> "DMA channel `{channel}` is not in the target profile"
        .DMAOwnershipMismatch(channel, buffer, expected, actual) -> "DMA `{channel}` buffer `{buffer}` expects {jet_target_dma_owner_label(expected)} ownership, got {jet_target_dma_owner_label(actual)}"
        .DMAStartWhileInFlight(channel, buffer) -> "DMA `{channel}` cannot start while buffer `{buffer}` is in flight"
        .DMAWaitWithoutTransfer(channel, buffer) -> "DMA `{channel}` cannot wait for buffer `{buffer}` before start"
        .DMABufferUnavailable(channel, buffer) -> "buffer `{buffer}` is unavailable while DMA `{channel}` owns it"
        .DMAWaitChannelMismatch(channel, buffer) -> "DMA `{channel}` does not own in-flight buffer `{buffer}`"
        .MissingAllocatorPolicy | .MissingTargetCapability(_) | .HostedCapabilityRequiresOS(_) | .InvalidProviderContract(_, _, _) | .HeapRequiresAllocator | .CoreAPIUnavailable(_, _, _) | .MMIOOutsideRegion(_, _) | .MMIOMissingUnsafeGate(_) | .MMIOEmptyUnsafeReason(_) -> "the selected target fact is invalid"
    }
}
