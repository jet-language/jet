// Canonical target layout identity, profile contracts, and compiler-owned
// physical layout facts. This module deliberately never asks a native layout
// engine for an answer: `#Layout(c)` and `#Layout(columnar)` declarations
// receive the facts of their declaration, and a struct without `#Layout`
// receives the facts of the compiler's own placement (jet_target_layout_native_struct_facts).

JET_TARGET_LAYOUT_FACT_VERSION: "layout-facts-v2"

JET_LAYOUT_U64_MAX: 0xffffffffffffffff

JET_LAYOUT_PORTABLE_ALIGNMENT_BASELINE_MAX: 1048576

// Every portable alignment boundary is an exact power of two. The target
// profile may prove a narrower set, but a portable declaration cannot exceed
// this baseline unless it opts into target alignment mode.
JET_LAYOUT_PORTABLE_ALIGNMENT_BASELINE: #run { [Int]{
    1, 2, 4, 8, 16, 32, 64, 128, 256, 512,
    1024, 2048, 4096, 8192, 16384, 32768, 65536,
    131072, 262144, 524288, 1048576
} }

// Size, alignment, and repeated-element stride for one physical value.
ByteLayout: struct {
    size: Int
    alignment: Int
    stride: Int
}

// Byte facts for one stored field or enum payload. Unknown physical facts are
// represented by None in every numeric column; they are never approximated.
FieldLayoutFacts: struct {
    name: String
    offset: Int?
    size: Int?
    alignment: Int?
    stride: Int?
}

// The one physical-layout result consumed by sema, IR lowering and reflection.
LayoutFacts: struct {
    bytes: ByteLayout?
    fields: [FieldLayoutFacts]
}

CheckedLayoutFacts: struct {
    physical: LayoutFacts
    alignment: LayoutAlignmentFact?
}

JetTargetLayout: struct {
    triple: String
    pointer_size: Int
    pointer_alignment: Int
    facts: LayoutCapabilityFacts
}

JetLayoutAlignmentError: enum {
    Zero
    NotPowerOfTwo(requested: Int)
    PortableBaseline(requested: Int, baseline: Int)
    MissingTypeFacts(profile: String)
    Unsupported(requested: Int, effective: Int, profile: String)
}

JetLayoutAlignmentResult: enum {
    Accepted(value: LayoutAlignmentFact)
    Rejected(error: JetLayoutAlignmentError)
}

JetLayoutStorageKind: enum {
    Stack
    Global
    Heap
    ForeignByValue
}

JetLayoutStorageError: enum {
    MissingFacts(kind: JetLayoutStorageKind, profile: String)
    UnsupportedAlignment(kind: JetLayoutStorageKind, alignment: Int, profile: String)
    MissingSizeBound(kind: JetLayoutStorageKind)
    SizeExceeded(kind: JetLayoutStorageKind, size: Int, max_size: Int)
    MissingAddressBound(kind: JetLayoutStorageKind)
    AddressOverflow(kind: JetLayoutStorageKind)
    AddressExceeded(kind: JetLayoutStorageKind, end: Int, max_address: Int)
}

JetLayoutStorageResult: enum {
    Accepted
    Rejected(error: JetLayoutStorageError)
}

JetCheckedLayoutResult: enum {
    Accepted(value: CheckedLayoutFacts)
    Rejected(error: JetLayoutAlignmentError)
}

// One source declaration in the canonical module-qualified layout registry.
// `core` marks a Core source's declaration, which has no native layout of
// its own.
TargetLayoutQualifiedItem: struct {
    qualified_name: String
    core: Bool
    item: Item
}

// One exact source-name resolution produced by sema. The owner is the
// declaration's canonical identity, so aliases and imported paths remain
// distinct even when they occur in the same module.
TargetLayoutNameResolution: struct {
    owner_qualified_name: String
    source_name: String
    qualified_name: String
}

// The engine owns the selected target and the complete source-item registry.
// The registry is required for nominal field/payload resolution; the target is
// required explicitly so sema cannot infer a host default. The registry's
// name indexes (first row per name) are built once with the engine, not per
// query (Rust `TargetLayoutEngine::new`).
TargetLayoutEngine: struct {
    target: JetTargetLayout
    items: [Item]
    qualified_items: [TargetLayoutQualifiedItem]
    name_resolutions: [TargetLayoutNameResolution]
    item_positions: [String:Int]
    qualified_positions: [String:Int]
    resolution_positions: [String:Int]
}

// The target/profile and registry are fixed for this query. Completed byte
// facts are keyed by registry row plus generic arguments, never by an active
// recursion path. Cycle-dependent unknown results must not enter the memo.
// Registry lookup indexes belong to TargetLayoutEngine and are reused across
// queries; each query owns only its recursion tracking and completed layouts.
JetTargetLayoutQuery: struct {
    active: [String:Bool]
    cycle_hits: Int
    completed_positions: [String:Int]
    completed: [ByteLayout?]
}

// Rust: none (Jet-only pass)
jet_target_layout_resolution_key: fn(owner: String, source: String) -> String Never! {
    "{owner.bytes().len()}:{owner}{source}"
}

jet_target_layout_query: fn() -> JetTargetLayoutQuery Never! {
    JetTargetLayoutQuery{
        active: [String:Bool]{},
        cycle_hits: 0,
        completed_positions: [String:Int]{},
        completed: [ByteLayout?]{},
    }
}

jet_target_layout_support_unknown: fn() -> LayoutSupportFacts Never! {
    LayoutSupportFacts{
        proven: false,
        alignments: [Int]{},
        max_size: None,
        max_address: None,
        abi: None,
        provenance: "",
    }
}

jet_target_layout_support_exact: fn(triple: String, address_bound: Int) -> LayoutSupportFacts Never! {
    LayoutSupportFacts{
        proven: true,
        alignments: JET_LAYOUT_PORTABLE_ALIGNMENT_BASELINE,
        max_size: Val(address_bound),
        max_address: Val(address_bound),
        abi: None,
        provenance: "target-profile:{triple}:portable-alignment-baseline",
    }
}

jet_target_layout_support_with_abi: fn(support: LayoutSupportFacts, abi: String) -> LayoutSupportFacts Never! {
    LayoutSupportFacts{
        proven: support.proven,
        alignments: support.alignments,
        max_size: support.max_size,
        max_address: support.max_address,
        abi: Val(abi),
        provenance: support.provenance,
    }
}

jet_target_layout_supports_alignment: fn(support: LayoutSupportFacts, alignment: Int) -> Bool Never! {
    if !support.proven || alignment <= 0 -> return false
    loop candidate in support.alignments {
        if candidate == alignment -> return true
    }
    false
}

jet_target_layout_known_triple: fn(triple: String) -> Bool Never! {
    triple.starts_with("x86_64-") || triple.starts_with("aarch64-") || triple.starts_with("wasm32-") || triple.starts_with("i686-") || triple.starts_with("arm-") || triple.starts_with("armv7-") || triple.starts_with("thumb")
}

jet_target_layout_pointer_size: fn(triple: String) -> Int Never! {
    if triple.starts_with("wasm32-") || triple.starts_with("i686-") || triple.starts_with("arm-") || triple.starts_with("armv7-") || triple.starts_with("thumb") -> 4 else -> 8
}

// The bytes one cache line of `triple`'s CPU holds: Apple's arm64 cores fetch
// 128-byte lines, every other supported CPU 64.
jet_target_layout_cache_line: fn(triple: String) -> Int Never! {
    if triple.starts_with("aarch64-apple-") -> 128 else -> 64
}

// The CPU features every CPU `triple` names has, so code built for it may use
// them unprobed: SSE2 on x86-64, NEON on arm64, none elsewhere.
jet_target_layout_cpu_features: fn(triple: String) -> [String] Never! {
    if triple.starts_with("x86_64-") -> return [String]{"sse2"}
    if triple.starts_with("aarch64-") -> return [String]{"neon"}
    [String]{}
}

jet_target_layout_from_triple_and_version: fn(triple: String, package_version: String) -> JetTargetLayout Never! {
    pointer_size: jet_target_layout_pointer_size(triple)
    address_bound: if pointer_size <= 4 -> 0xffffffff else -> JET_LAYOUT_U64_MAX
    unknown: jet_target_layout_support_unknown()
    support: if jet_target_layout_known_triple(triple) -> jet_target_layout_support_exact(triple, address_bound) else -> unknown
    foreign: jet_target_layout_support_with_abi(support, "C")
    layout_facts: LayoutCapabilityFacts{
        fact_version: JET_TARGET_LAYOUT_FACT_VERSION,
        target_profile: triple,
        execution_modes: [String]{"aot"},
        backend: "jet-codegen",
        toolchain: package_version,
        linker: "target-profile",
        allocator_provider: "target-profile",
        type_representation: support,
        stack_placement: support,
        global_placement: support,
        heap_allocator: support,
        foreign_by_value_abi: foreign,
    }
    JetTargetLayout{
        triple: triple,
        pointer_size: pointer_size,
        pointer_alignment: pointer_size,
        facts: layout_facts,
    }
}

jet_target_layout_from_triple: fn(triple: String, package_version: String) -> JetTargetLayout Never! {
    jet_target_layout_from_triple_and_version(triple, package_version)
}

// Reuse the already selected driver machine. This is the only adapter allowed
// to move machine layout facts into a physical layout engine.
jet_target_layout_from_machine: fn(machine: TargetMachine) -> JetTargetLayout Never! {
    pointer_size: jet_target_layout_pointer_size(machine.triple)
    JetTargetLayout{
        triple: machine.triple,
        pointer_size: pointer_size,
        pointer_alignment: pointer_size,
        facts: machine.layout,
    }
}

jet_target_layout_u64_bytes: fn(value: Int) -> [U8] Never! {
    bytes := [U8]{}
    loop index in 0..<8 -> bytes.push(U8{((value >> (8 * index))).bit_and(255)})
    bytes
}

jet_target_layout_frame: fn(bytes: &[U8], value: [U8]) Never! {
    loop byte in jet_target_layout_u64_bytes(value.len()) -> bytes.push(byte)
    loop byte in value -> bytes.push(byte)
}

jet_target_layout_frame_string: fn(bytes: &[U8], value: String) Never! {
    jet_target_layout_frame(bytes, value.bytes())
}

jet_target_layout_frame_bool: fn(bytes: &[U8], value: Bool) Never! {
    if value -> jet_target_layout_frame(bytes, [U8]{1}) else -> jet_target_layout_frame(bytes, [U8]{0})
}

jet_target_layout_frame_optional_int: fn(bytes: &[U8], value: Int?) Never! {
    actual: value ?? 0
    jet_target_layout_frame(bytes, jet_target_layout_u64_bytes(actual))
}

jet_target_layout_frame_support: fn(bytes: &[U8], support: LayoutSupportFacts) Never! {
    jet_target_layout_frame_bool(bytes, support.proven)
    loop alignment in support.alignments -> jet_target_layout_frame(bytes, jet_target_layout_u64_bytes(alignment))
    jet_target_layout_frame_optional_int(bytes, support.max_size)
    jet_target_layout_frame_optional_int(bytes, support.max_address)
    abi: support.abi ?? ""
    jet_target_layout_frame_string(bytes, abi)
    jet_target_layout_frame_string(bytes, support.provenance)
}

jet_target_layout_cache_identity: fn(facts: LayoutCapabilityFacts) -> String Never! {
    bytes := [U8]{}
    jet_target_layout_frame_string(bytes, facts.fact_version)
    jet_target_layout_frame_string(bytes, facts.target_profile)
    jet_target_layout_frame_string(bytes, facts.backend)
    jet_target_layout_frame_string(bytes, facts.toolchain)
    jet_target_layout_frame_string(bytes, facts.linker)
    jet_target_layout_frame_string(bytes, facts.allocator_provider)
    loop mode in facts.execution_modes -> jet_target_layout_frame_string(bytes, mode)
    jet_target_layout_frame_support(bytes, facts.type_representation)
    jet_target_layout_frame_support(bytes, facts.stack_placement)
    jet_target_layout_frame_support(bytes, facts.global_placement)
    jet_target_layout_frame_support(bytes, facts.heap_allocator)
    jet_target_layout_frame_support(bytes, facts.foreign_by_value_abi)
    "{JET_TARGET_LAYOUT_FACT_VERSION}:{sha256_hex_bytes(sha256_bytes(bytes[0..<bytes.len()]))}"
}

jet_target_layout_check_alignment: fn(target: JetTargetLayout, requested: Int, natural: Int, target_mode: Bool) -> JetLayoutAlignmentResult Never! {
    if requested == 0 -> return JetLayoutAlignmentResult.Rejected{error: JetLayoutAlignmentError.Zero}
    if !jet_layout_is_power_of_two(requested) -> return JetLayoutAlignmentResult.Rejected{error: JetLayoutAlignmentError.NotPowerOfTwo{requested: requested}}
    if !target_mode && requested > JET_LAYOUT_PORTABLE_ALIGNMENT_BASELINE_MAX -> return JetLayoutAlignmentResult.Rejected{error: JetLayoutAlignmentError.PortableBaseline{requested: requested, baseline: JET_LAYOUT_PORTABLE_ALIGNMENT_BASELINE_MAX}}
    if !target.facts.type_representation.proven -> return JetLayoutAlignmentResult.Rejected{error: JetLayoutAlignmentError.MissingTypeFacts{profile: target.facts.target_profile}}
    effective: if natural > requested -> natural else -> requested
    if !jet_target_layout_supports_alignment(target.facts.type_representation, effective) -> return JetLayoutAlignmentResult.Rejected{error: JetLayoutAlignmentError.Unsupported{requested: requested, effective: effective, profile: target.facts.target_profile}}
    JetLayoutAlignmentResult.Accepted{value: LayoutAlignmentFact{
        requested_alignment: requested,
        effective_alignment: effective,
        target_mode: target_mode,
        target_profile: target.facts.target_profile,
        fact_identity: jet_target_layout_cache_identity(target.facts),
    }}
}


jet_target_layout_storage_kind_name: fn(kind: JetLayoutStorageKind) -> String Never! {
    if kind == JetLayoutStorageKind.Stack -> return "Stack"
    if kind == JetLayoutStorageKind.Global -> return "Global"
    if kind == JetLayoutStorageKind.Heap -> return "Heap"
    "ForeignByValue"
}

jet_target_layout_engine: fn(items: [Item], target: JetTargetLayout) -> TargetLayoutEngine Never! {
    jet_target_layout_engine_with_registry(items, [TargetLayoutQualifiedItem]{}, [TargetLayoutNameResolution]{}, target)
}

jet_target_layout_engine_with_registry: fn(items: [Item], qualified_items: [TargetLayoutQualifiedItem], name_resolutions: [TargetLayoutNameResolution], target: JetTargetLayout) -> TargetLayoutEngine Never! {
    item_positions := [String:Int]{}
    loop position in 0..<items.len() {
        name: jet_target_layout_item_name(items[position])
        if item_positions.get(name) == None -> item_positions[name] = position
    }
    qualified_positions := [String:Int]{}
    loop position in 0..<qualified_items.len() {
        name: qualified_items[position].qualified_name
        if qualified_positions.get(name) == None -> qualified_positions[name] = position
    }
    resolution_positions := [String:Int]{}
    loop position in 0..<name_resolutions.len() {
        key: jet_target_layout_resolution_key(name_resolutions[position].owner_qualified_name, name_resolutions[position].source_name)
        if resolution_positions.get(key) == None -> resolution_positions[key] = position
    }
    TargetLayoutEngine{target: target, items: items, qualified_items: qualified_items, name_resolutions: name_resolutions, item_positions: item_positions, qualified_positions: qualified_positions, resolution_positions: resolution_positions}
}

jet_target_layout_engine_target: fn(engine: TargetLayoutEngine) -> JetTargetLayout Never! {
    engine.target
}

// `module_text` is the declaring module identity's text ("" for none).
jet_target_layout_struct_facts_in_module: fn(engine: TargetLayoutEngine, definition: StructDef, module_text: String) -> LayoutFacts Never! {
    query := jet_target_layout_query()
    identity: if module_text == "" -> definition.name else -> "{module_text}::{definition.name}"
    jet_target_layout_struct_facts_inner_named(engine, definition, identity, identity, query)
}


// `#Layout(U8)` names the integer type that backs a
// payload-free enum; these are the accepted backing types.
jet_layout_integer_backing_name: fn(name: String) -> Bool Never! {
    jet_layout_integer_backing_tag(name) != None
}

jet_layout_integer_backing_tag: fn(name: String) -> CEnumTag? {
    if name == {
        "U8" -> Val(CEnumTag.U8)
        "I8" -> Val(CEnumTag.I8)
        "U16" -> Val(CEnumTag.U16)
        "I16" -> Val(CEnumTag.I16)
        "U32" -> Val(CEnumTag.U32)
        "I32" -> Val(CEnumTag.I32)
        "U64" -> Val(CEnumTag.U64)
        "I64" -> Val(CEnumTag.I64)
        else -> None
    }
}

// The C ABI tag of `#Layout(c)` / `#Layout(c, U8)`. An integer backing
// `#Layout(U8)` is no C layout: see jet_target_layout_enum_backing.
jet_target_layout_enum_c_tag: fn(definition: EnumDef) -> CEnumTag? {
    marker: loop candidate in definition.type_markers {
        if candidate.name == "Layout" -> break candidate
    } ?? return None
    layout_expr: jet_target_layout_marker_expression(marker, 0) ?? return None
    layout_name: if layout_expr == {
        .Ident(name, _, _) -> name
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> ""
    }
    if jet_target_layout_ascii_lower(layout_name) != "c" -> return None
    enum_tag: jet_target_layout_marker_expression(marker, 1) ?? return Val(CEnumTag.CInt)
    if enum_tag == {
        .Ident(name, _, _) -> jet_layout_integer_backing_tag(name)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

// The integer backing of `#Layout(U8) E: enum { … }`: its type name, None for
// every other enum.
jet_target_layout_enum_backing: fn(definition: EnumDef) -> String? {
    marker: loop candidate in definition.type_markers {
        if candidate.name == "Layout" -> break candidate
    } ?? return None
    if marker.args.len() != 1 -> return None
    layout_expr: jet_target_layout_marker_expression(marker, 0) ?? return None
    if layout_expr == {
        .Ident(name, _, _) -> if jet_layout_integer_backing_name(name) -> Val(name) else -> None
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

// The least and greatest case number a backing type holds (U64 stops at the
// greatest Int, the type of a case number).
jet_layout_integer_backing_min: fn(name: String) -> Int Never! {
    if name == {
        "I8" -> -128
        "I16" -> -32768
        "I32" -> -2147483648
        "I64" -> -9223372036854775807 - 1
        else -> 0
    }
}

jet_layout_integer_backing_max: fn(name: String) -> Int Never! {
    if name == {
        "U8" -> 255
        "I8" -> 127
        "U16" -> 65535
        "I16" -> 32767
        "U32" -> 4294967295
        "I32" -> 2147483647
        else -> 9223372036854775807
    }
}

jet_target_layout_marker_expression: fn(marker: Marker, index: Int) -> Expr? {
    if index < 0 || index >= marker.args.len() -> return None
    if marker.args[index] == {
        .Expr(value) -> Val(value)
        .EffectRow(_, _) -> None
    }
}

jet_target_layout_enum_facts_in_module: fn(engine: TargetLayoutEngine, definition: EnumDef, module_text: String) -> LayoutFacts Never! {
    query := jet_target_layout_query()
    identity: if module_text == "" -> definition.name else -> "{module_text}::{definition.name}"
    jet_target_layout_enum_facts_inner_named(engine, definition, identity, identity, query)
}

jet_target_layout_type_facts: fn(engine: TargetLayoutEngine, ty: Type) -> ByteLayout? {
    query := jet_target_layout_query()
    jet_target_layout_type_inner(engine, ty, "", query)
}

jet_target_layout_struct_facts_inner_named: fn(engine: TargetLayoutEngine, definition: StructDef, identity: String, owner_qualified_name: String, query: &JetTargetLayoutQuery) -> LayoutFacts Never! {
    field_names: loop field in definition.fields if field.computed == None -> field.name
    layout: definition.layout ?? return jet_target_layout_native_struct_facts(engine, definition, identity, query)
    if !jet_target_layout_struct_layout_is_physical(layout) -> return jet_target_layout_unknown(field_names)
    if !jet_target_layout_enter(query, identity) -> return jet_target_layout_unknown(field_names)
    names := [String]{}
    types := [Type]{}
    loop field in definition.fields {
        if field.computed != None -> next
        names.push(field.name)
        types.push(field.ty)
    }
    facts: jet_target_layout_aggregate(engine, names, types, owner_qualified_name, query)
    query.active[identity] = false
    if layout == {
        .CAligned(alignment, _) -> jet_target_layout_aligned_struct_facts(facts, alignment)
        .C | .Columnar -> facts
    }
}

// The order in which members of alignments `aligns` take their offsets: by
// descending alignment, declaration order among equals, when `reorder`;
// declaration order otherwise. The native code generator places struct
// members in this order, so its layout and these facts never disagree.
jet_target_layout_member_order: fn(aligns: [Int], reorder: Bool) -> [Int] Never! {
    order := [Int]{}
    loop index in 0..<aligns.len() {
        at := order.len()
        if reorder {
            loop at > 0 && aligns[order[at - 1]] < aligns[index] -> at -= 1
        }
        order.insert(at, index)
    }
    order
}

// The bytes the native code generator gives struct `definition`: a struct
// without `#Layout` places its members by jet_target_layout_member_order, a
// `#Layout` struct in declaration order. Each member sits at its alignment, a
// nested struct or List member at 8; the struct is a multiple of 8 bytes, at
// least 8, aligned to 8. Unknown when any member's bytes are.
jet_target_layout_native_struct_facts: fn(engine: TargetLayoutEngine, definition: StructDef, identity: String, query: &JetTargetLayoutQuery) -> LayoutFacts Never! {
    names := [String]{}
    types := [Type]{}
    loop field in definition.fields {
        if field.computed != None -> next
        names.push(field.name)
        types.push(field.ty)
    }
    if !jet_target_layout_enter(query, identity) -> return jet_target_layout_unknown(names)
    layouts := [ByteLayout]{}
    loop ty in types {
        layout: jet_target_layout_native_type(engine, ty, identity, query)
        if layout == .Val(known) { layouts.push(known) } else { break }
    }
    query.active[identity] = false
    if layouts.len() != names.len() -> return jet_target_layout_unknown(names)
    aligns: loop layout in layouts -> layout.alignment
    offsets := [Int]{}
    loop _ in 0..<layouts.len() -> offsets.push(0)
    cursor := 0
    loop index in jet_target_layout_member_order(aligns, definition.layout == None) {
        if layouts[index].size > 0 -> cursor = jet_layout_align_up(cursor, layouts[index].alignment) ?? return jet_target_layout_unknown(names)
        offsets[index] = cursor
        cursor = jet_layout_checked_add(cursor, layouts[index].size) ?? return jet_target_layout_unknown(names)
    }
    end: jet_layout_align_up(cursor, 8) ?? return jet_target_layout_unknown(names)
    size: if end < 8 -> 8 else -> end
    fields: loop index in 0..<names.len() -> FieldLayoutFacts{name: names[index], offset: Val(offsets[index]), size: Val(layouts[index].size), alignment: Val(layouts[index].alignment), stride: Val(layouts[index].stride)}
    LayoutFacts{bytes: Val(ByteLayout{size: size, alignment: 8, stride: size}), fields: fields}
}

// The bytes a value of `ty` takes as a member of a struct the native code
// generator lays out, None when unknown. Int, Float, Char, String, Option,
// Result, enums and raw pointers are one word; an IntN packs into 1, 2, 4 or
// 8 bytes; a List is its 24-byte header. Core declarations are carried by
// the runtime, not by their declared fields, and stay unknown.
jet_target_layout_native_type: fn(engine: TargetLayoutEngine, ty: Type, owner_qualified_name: String, query: &JetTargetLayoutQuery) -> ByteLayout? {
    if ty == {
        .Int | .Float | .Char | .String | .Option(_) | .Result(_, _) -> Val(jet_target_layout_scalar(8))
        .Bool -> Val(jet_target_layout_scalar(1))
        .Float32 -> Val(jet_target_layout_scalar(4))
        .IntN(_, bits) -> {
            if bits < 1 || bits > 64 -> return None
            Val(jet_target_layout_scalar(if bits <= 8 -> 1 else if bits <= 16 -> 2 else if bits <= 32 -> 4 else -> 8))
        }
        .List(_) -> Val(ByteLayout{size: 24, alignment: 8, stride: 24})
        .InlineRange(base, _, _) | .Tagged(_, base) | .Quantity(base, _) -> jet_target_layout_native_type(engine, base, owner_qualified_name, query)
        .Named(name) -> jet_target_layout_native_named(engine, name, owner_qualified_name, query)
        .Apply(name, args) -> if (name == "Ptr" && args.len() == 1) || jet_target_layout_bit_set(engine, name, args, owner_qualified_name) -> Val(jet_target_layout_scalar(8)) else -> None
        .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .Union(_) | .Case(_, _) | .Measure(_) -> None
    }
}

jet_target_layout_native_named: fn(engine: TargetLayoutEngine, name: String, owner_qualified_name: String, query: &JetTargetLayoutQuery) -> ByteLayout? {
    if jet_target_layout_numeric_type(name) == .Val(numeric) -> return jet_target_layout_native_type(engine, numeric, owner_qualified_name, query)
    if name == "Bool" -> return Val(jet_target_layout_scalar(1))
    if name == "Char" || name == "String" -> return Val(jet_target_layout_scalar(8))
    if name == "Unit" || name == "()" -> return Val(ByteLayout{size: 0, alignment: 1, stride: 0})
    resolved_name: jet_target_layout_resolved_name(engine, owner_qualified_name, name)
    if jet_target_layout_numeric_type(resolved_name) == .Val(numeric_resolved) -> return jet_target_layout_native_type(engine, numeric_resolved, owner_qualified_name, query)
    if resolved_name == name && engine.item_positions.get(name) == .Val(position) {
        return jet_target_layout_native_item(engine, engine.items[position], name, query)
    }
    position: engine.qualified_positions.get(resolved_name) ?? return None
    if engine.qualified_items[position].core -> return None
    jet_target_layout_native_item(engine, engine.qualified_items[position].item, engine.qualified_items[position].qualified_name, query)
}

jet_target_layout_native_item: fn(engine: TargetLayoutEngine, item: Item, identity: String, query: &JetTargetLayoutQuery) -> ByteLayout? {
    if item == {
        .Struct(definition) -> {
            if definition.type_params.len() > 0 -> return None
            jet_target_layout_native_struct_facts(engine, definition, identity, query).bytes
        }
        .Enum(_) -> Val(jet_target_layout_scalar(8))
        .Distinct(definition) -> {
            if !jet_target_layout_enter(query, identity) -> return None
            bytes: jet_target_layout_native_type(engine, definition.base, identity, query)
            query.active[identity] = false
            bytes
        }
        .TypeAlias(definition) -> {
            if definition.type_params.len() > 0 || !jet_target_layout_enter(query, identity) -> return None
            bytes: jet_target_layout_native_type(engine, definition.target, identity, query)
            query.active[identity] = false
            bytes
        }
        .Func(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> None
    }
}

jet_target_layout_enum_facts_inner_named: fn(engine: TargetLayoutEngine, definition: EnumDef, identity: String, owner_qualified_name: String, query: &JetTargetLayoutQuery) -> LayoutFacts Never! {
    variant_names: loop variant in definition.variants -> variant.name
    enum_tag: jet_target_layout_enum_c_tag(definition) ?? return jet_target_layout_unknown(variant_names)
    if !jet_target_layout_enter(query, identity) -> return jet_target_layout_unknown(variant_names)
    tag_layout: jet_target_layout_scalar(jet_target_layout_enum_tag_size(enum_tag))
    payloads := [ByteLayout?]{}
    payloads_known := [Bool]{}
    loop variant in definition.variants {
        if variant.payload == {
            .Unit -> {
                payloads.push(None)
                payloads_known.push(true)
            }
            .Single(ty, _) -> {
                payload: jet_target_layout_type_inner(engine, ty, owner_qualified_name, query)
                payloads.push(payload.copy())
                payloads_known.push(payload != None)
            }
            .Named(fields) -> {
                names := [String]{}
                types := [Type]{}
                loop field in fields {
                    names.push(field.name)
                    types.push(field.ty)
                }
                payload: jet_target_layout_aggregate(engine, names, types, owner_qualified_name, query).bytes
                payloads.push(payload.copy())
                payloads_known.push(payload != None)
            }
        }
    }
    payload_alignment := 1
    payload_size := 0
    all_known := true
    loop index in 0..<payloads.len() {
        if !payloads_known[index] -> all_known = false
        if payloads[index] == .Val(payload) {
            if payload.alignment > payload_alignment -> payload_alignment = payload.alignment
            if payload.size > payload_size -> payload_size = payload.size
        }
    }
    alignment: if tag_layout.alignment > payload_alignment -> tag_layout.alignment else -> payload_alignment
    payload_offset: jet_layout_align_up(tag_layout.size, payload_alignment) ?? {
        query.active[identity] = false
        return jet_target_layout_unknown(variant_names)
    }
    total: jet_layout_checked_add(payload_offset, payload_size) ?? {
        query.active[identity] = false
        return jet_target_layout_unknown(variant_names)
    }
    size: jet_layout_align_up(total, alignment) ?? {
        query.active[identity] = false
        return jet_target_layout_unknown(variant_names)
    }
    bytes: jet_target_layout_enum_bytes(all_known, size, alignment)
    facts := [FieldLayoutFacts]{}
    index := 0
    loop index < definition.variants.len() {
        variant := definition.variants[index]
        if payloads[index] == {
            Val(payload) -> facts.push(FieldLayoutFacts{name: variant.name, offset: Val(payload_offset), size: Val(payload.size), alignment: Val(payload.alignment), stride: Val(payload.stride)})
            None -> facts.push(FieldLayoutFacts{name: variant.name, offset: Val(0), size: Val(tag_layout.size), alignment: Val(tag_layout.alignment), stride: Val(tag_layout.stride)})
        }
        index += 1
    }
    query.active[identity] = false
    LayoutFacts{bytes: bytes, fields: facts}
}

jet_target_layout_aggregate: fn(engine: TargetLayoutEngine, names: [String], types: [Type], owner_qualified_name: String, query: &JetTargetLayoutQuery) -> LayoutFacts Never! {
    cursor := Val(0)
    aggregate_alignment := Val(1)
    facts := [FieldLayoutFacts]{}
    index := 0
    loop index < names.len() {
        name := names[index]
        layout := jet_target_layout_type_inner(engine, types[index], owner_qualified_name, query)
        offset := jet_target_layout_field_offset(cursor, layout)
        if layout == {
            Val(value) -> {
                if offset == {
                    Val(actual) -> cursor = jet_layout_checked_add(actual, value.size)
                    None -> cursor = None
                }
                if aggregate_alignment != None {
                    current: aggregate_alignment ?? 1
                    aggregate_alignment = Val(if current > value.alignment -> current else -> value.alignment)
                }
                facts.push(FieldLayoutFacts{name: name, offset: offset, size: Val(value.size), alignment: Val(value.alignment), stride: Val(value.stride)})
            }
            None -> {
                cursor = None
                aggregate_alignment = None
                facts.push(jet_target_layout_unknown_field(name))
            }
        }
        index += 1
    }
    LayoutFacts{bytes: jet_target_layout_aggregate_bytes(cursor, aggregate_alignment), fields: facts}
}

jet_target_layout_enum_bytes: fn(all_known: Bool, size: Int, alignment: Int) -> ByteLayout? {
    if !all_known -> return None
    Val(ByteLayout{size: size, alignment: alignment, stride: size})
}

jet_target_layout_field_offset: fn(cursor: Int?, layout: ByteLayout?) -> Int? {
    current: cursor ?? return None
    value: layout ?? return None
    jet_layout_align_up(current, value.alignment)
}

jet_target_layout_aggregate_bytes: fn(cursor: Int?, aggregate_alignment: Int?) -> ByteLayout? {
    current: cursor ?? return None
    alignment: aggregate_alignment ?? return None
    size: jet_layout_align_up(current, alignment) ?? return None
    Val(ByteLayout{size: size, alignment: alignment, stride: size})
}

jet_target_layout_type_inner: fn(engine: TargetLayoutEngine, ty: Type, owner_qualified_name: String, query: &JetTargetLayoutQuery) -> ByteLayout? {
    if ty == {
        .Int | .Float -> Val(jet_target_layout_scalar(8))
        .Bool -> Val(jet_target_layout_scalar(1))
        .Char -> Val(jet_target_layout_scalar(4))
        .Float32 -> Val(jet_target_layout_scalar(4))
        .IntN(_, bits) -> {
            size: jet_layout_checked_add(bits, 7) ?? return None
            Val(jet_target_layout_scalar(size /% 8))
        }
        .String | .List(_) -> jet_target_layout_pointer_layout(engine.target)
        .FixedList(element, length) -> {
            element_layout: jet_target_layout_type_inner(engine, element, owner_qualified_name, query) ?? return None
            count: measure_literal_value(length) ?? return None
            size: jet_layout_checked_mul(element_layout.stride, count) ?? return None
            Val(ByteLayout{size: size, alignment: element_layout.alignment, stride: size})
        }
        .InlineRange(base, _, _) | .Tagged(_, base) | .Quantity(base, _) -> jet_target_layout_type_inner(engine, base, owner_qualified_name, query)
        .Named(name) -> jet_target_layout_named_type(engine, name, [Type]{}, owner_qualified_name, query)
        .Apply(name, args) -> {
            if name == "Ptr" && args.len() == 1 -> return Val(ByteLayout{size: engine.target.pointer_size, alignment: engine.target.pointer_alignment, stride: engine.target.pointer_size})
            if jet_target_layout_bit_set(engine, name, args, owner_qualified_name) -> return Val(jet_target_layout_scalar(8))
            if jet_target_layout_is_atomic_name(name) -> return jet_target_layout_atomic_layout(engine, args)
            jet_target_layout_named_type(engine, name, args, owner_qualified_name, query)
        }
        .Tuple(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Union(_) | .Case(_, _) | .Measure(_) -> None
    }
}

jet_target_layout_is_atomic_name: fn(name: String) -> Bool Never! {
    name == "Atomic" || name.ends_with("::Atomic") || name.ends_with(".Atomic")
}

jet_target_layout_atomic_layout: fn(engine: TargetLayoutEngine, args: [Type]) -> ByteLayout? {
    if {
        !jet_target_layout_supports_atomic_word(engine.target) -> None
        args.len() != 1 -> None
        jet_target_layout_atomic_scalar_type(args[0]) -> Val(jet_target_layout_scalar(8))
        else -> None
    }
}

// Whether `Set<args[0]>` is stored as bits, one 8-byte word with a bit per
// case: its element names an enum of 1 to 64 cases with no payloads and no
// type parameters.
jet_target_layout_bit_set: fn(engine: TargetLayoutEngine, name: String, args: [Type], owner_qualified_name: String) -> Bool Never! {
    if name != "Set" || args.len() != 1 -> return false
    element: if args[0] == .Named(element_name) -> element_name.copy() else -> return false
    resolved: jet_target_layout_resolved_name(engine, owner_qualified_name, element)
    if resolved == element && engine.item_positions.get(element) == .Val(position) -> return jet_layout_bits_enum(engine.items[position])
    position: engine.qualified_positions.get(resolved) ?? return false
    jet_layout_bits_enum(engine.qualified_items[position].item)
}

// Whether `item` is an enum a Set stores as bits.
jet_layout_bits_enum: fn(item: Item) -> Bool Never! {
    if item == .Enum(definition) {
        if definition.type_params.len() > 0 || definition.variants.len() == 0 || definition.variants.len() > 64 -> return false
        loop variant in definition.variants {
            if variant.payload == {
                .Unit -> {}
                .Single(_, _) | .Named(_) -> return false
            }
        }
        return true
    }
    false
}

// The bit index of `value` when it is one bit of a 64-bit word (a power of
// two from 1 to 2^63), None for any other value: the bit a `#Specified`
// enum's case crosses as in a Set stored as bits.
jet_layout_one_bit_shift: fn(value: Int) -> Int? Never! {
    power := 1
    loop shift in 0..<64 {
        if value == power -> return Val(shift)
        power = power * 2
    }
    None
}

// Rust: none (Jet-only pass)
jet_target_layout_resolved_name: fn(engine: TargetLayoutEngine, owner_qualified_name: String, source_name: String) -> String Never! {
    key: jet_target_layout_resolution_key(owner_qualified_name, source_name)
    position: engine.resolution_positions.get(key) ?? return source_name.copy()
    engine.name_resolutions[position].qualified_name
}

jet_target_layout_named_item: fn(engine: TargetLayoutEngine, item: Item, identity: String, registry_key: String, args: [Type], query: &JetTargetLayoutQuery) -> ByteLayout? {
    key: type_identity_key(Type.Apply{name: registry_key, args: args})
    if !(query.active.get(identity) ?? false) {
        if query.completed_positions.get(key) == .Val(position) -> return query.completed[position]
    }
    cycle_hits: query.cycle_hits
    result: if item == {
        .Struct(definition) -> jet_target_layout_struct_facts_inner_named(engine, definition, identity, identity, query).bytes
        .Enum(definition) -> jet_target_layout_enum_facts_inner_named(engine, definition, identity, identity, query).bytes
        .Distinct(definition) -> {
            if !jet_target_layout_enter(query, identity) -> return None
            bytes: jet_target_layout_type_inner(engine, definition.base, identity, query)
            query.active[identity] = false
            bytes
        }
        .TypeAlias(definition) -> {
            if !jet_target_layout_enter(query, identity) -> return None
            bytes: jet_target_layout_type_inner(engine, definition.target, identity, query)
            query.active[identity] = false
            bytes
        }
        .Func(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> None
    }
    if cycle_hits == query.cycle_hits && query.completed_positions.get(key) == None {
        query.completed_positions[key] = query.completed.len()
        query.completed.push(result.copy())
    }
    result
}

jet_target_layout_named_type: fn(engine: TargetLayoutEngine, name: String, args: [Type], owner_qualified_name: String, query: &JetTargetLayoutQuery) -> ByteLayout? {
    if jet_target_layout_numeric_type(name) == .Val(numeric) -> return jet_target_layout_type_inner(engine, numeric, owner_qualified_name, query)
    if name == "Bool" -> return Val(jet_target_layout_scalar(1))
    if name == "Char" -> return Val(jet_target_layout_scalar(4))
    if name == "String" || name == "List" -> return jet_target_layout_pointer_layout(engine.target)
    if name == "Unit" || name == "()" -> return Val(ByteLayout{size: 0, alignment: 1, stride: 0})

    resolved_name: jet_target_layout_resolved_name(engine, owner_qualified_name, name)
    if resolved_name != name {
        if jet_target_layout_numeric_type(resolved_name) == .Val(numeric_resolved) -> return jet_target_layout_type_inner(engine, numeric_resolved, owner_qualified_name, query)
        position: engine.qualified_positions.get(resolved_name) ?? return None
        return jet_target_layout_named_item(engine, engine.qualified_items[position].item, engine.qualified_items[position].qualified_name, "qualified:{position}", args, query)
    }
    if engine.item_positions.get(name) == .Val(position) {
        return jet_target_layout_named_item(engine, engine.items[position], name, "item:{position}", args, query)
    }
    position: engine.qualified_positions.get(name) ?? return None
    jet_target_layout_named_item(engine, engine.qualified_items[position].item, engine.qualified_items[position].qualified_name, "qualified:{position}", args, query)
}

jet_target_layout_pointer_layout: fn(target: JetTargetLayout) -> ByteLayout? {
    size: jet_layout_checked_mul(target.pointer_size, 3) ?? return None
    Val(ByteLayout{size: size, alignment: target.pointer_alignment, stride: size})
}

jet_target_layout_numeric_type: fn(name: String) -> Type? {
    if name == {
        "Int" -> Val(Type.Int)
        "Float" | "F64" -> Val(Type.Float)
        "F32" -> Val(Type.Float32)
        "I8" -> Val(Type.IntN{signed: true, bits: 8})
        "U8" -> Val(Type.IntN{signed: false, bits: 8})
        "I16" -> Val(Type.IntN{signed: true, bits: 16})
        "U16" -> Val(Type.IntN{signed: false, bits: 16})
        "I32" -> Val(Type.IntN{signed: true, bits: 32})
        "U32" -> Val(Type.IntN{signed: false, bits: 32})
        "I64" -> Val(Type.IntN{signed: true, bits: 64})
        "U64" -> Val(Type.IntN{signed: false, bits: 64})
        else -> None
    }
}

jet_target_layout_item_name: fn(item: Item) -> String Never! {
    if item == {
        .Struct(definition) -> definition.name
        .Enum(definition) -> definition.name
        .Distinct(definition) -> definition.name
        .TypeAlias(definition) -> definition.name
        .Func(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> ""
    }
}

jet_target_layout_scalar: fn(size: Int) -> ByteLayout Never! {
    ByteLayout{size: size, alignment: jet_target_layout_scalar_alignment(size), stride: size}
}

jet_target_layout_scalar_alignment: fn(size: Int) -> Int Never! {
    if {
        size == 0 -> 1
        size == 1 || size == 2 || size == 4 || size == 8 -> size
        else -> 8
    }
}

jet_target_layout_enum_tag_size: fn(enum_tag: CEnumTag) -> Int Never! {
    if enum_tag == {
        .CInt -> 4
        .U8 | .I8 -> 1
        .U16 | .I16 -> 2
        .U32 | .I32 -> 4
        .U64 | .I64 -> 8
    }
}

jet_target_layout_aligned_struct_facts: fn(facts: LayoutFacts, alignment: Int) -> LayoutFacts Never! {
    if alignment <= 0 || !jet_layout_is_power_of_two(alignment) -> return LayoutFacts{bytes: None, fields: facts.fields}
    bytes: facts.bytes ?? return facts
    size: jet_layout_align_up(bytes.size, alignment) ?? return LayoutFacts{bytes: None, fields: facts.fields}
    effective: if bytes.alignment > alignment -> bytes.alignment else -> alignment
    LayoutFacts{bytes: Val(ByteLayout{size: size, alignment: effective, stride: size}), fields: facts.fields}
}

jet_target_layout_struct_layout_is_physical: fn(layout: StructLayout) -> Bool Never! {
    if layout == {
        .C | .CAligned(_, _) | .Columnar -> true
    }
}

jet_target_layout_unknown_field: fn(name: String) -> FieldLayoutFacts Never! {
    FieldLayoutFacts{name: name, offset: None, size: None, alignment: None, stride: None}
}

jet_target_layout_unknown: fn(names: [String]) -> LayoutFacts Never! {
    fields: loop name in names -> jet_target_layout_unknown_field(name)
    LayoutFacts{bytes: None, fields: fields}
}

jet_target_layout_atomic_scalar_type: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Bool | .Int -> true
        .IntN(_, bits) -> bits == 32 || bits == 64
        .Named(name) -> {
            if name == "Bool" -> return true
            numeric: jet_target_layout_numeric_type(name) ?? return false
            jet_target_layout_atomic_scalar_type(numeric)
        }
        .Float | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

jet_target_layout_atomic_add_type: fn(ty: Type) -> Bool Never! {
    if !jet_target_layout_atomic_scalar_type(ty) -> return false
    if ty == {
        .Bool -> false
        .Named(name) -> name != "Bool"
        .Int | .Float | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> true
    }
}

jet_target_layout_supports_atomic_word: fn(target: JetTargetLayout) -> Bool Never! {
    target.triple.starts_with("x86_64-") || target.triple.starts_with("aarch64-") || target.triple.starts_with("wasm32-")
}

jet_target_layout_enter: fn(query: &JetTargetLayoutQuery, identity: String) -> Bool Never! {
    if query.active.get(identity) ?? false {
        query.cycle_hits += 1
        return false
    }
    query.active[identity] = true
    true
}

jet_target_layout_ascii_lower: fn(text: String) -> String Never! {
    bytes := text.bytes()
    loop index in 0..<bytes.len() {
        code: Int{bytes[index]}
        if code >= 65 && code <= 90 -> bytes[index] = U8{code + 32}
    }
    String.from_bytes(bytes) ?? text
}

jet_layout_is_power_of_two: fn(value: Int) -> Bool Never! {
    value > 0 && ((value).bit_and((value - 1))) == 0
}

jet_layout_checked_add: fn(left: Int, right: Int) -> Int? {
    if left < 0 || right < 0 || left > JET_LAYOUT_U64_MAX || right > JET_LAYOUT_U64_MAX -> return None
    if left > JET_LAYOUT_U64_MAX - right -> return None
    Val(left + right)
}

jet_layout_checked_mul: fn(left: Int, right: Int) -> Int? {
    if left < 0 || right < 0 || left > JET_LAYOUT_U64_MAX || right > JET_LAYOUT_U64_MAX -> return None
    if left == 0 || right == 0 -> return Val(0)
    if left > JET_LAYOUT_U64_MAX /% right -> return None
    Val(left * right)
}

jet_layout_align_up: fn(value: Int, alignment: Int) -> Int? {
    if value < 0 || value > JET_LAYOUT_U64_MAX || alignment < 0 || alignment > JET_LAYOUT_U64_MAX -> return None
    effective: if alignment < 1 -> 1 else -> alignment
    padding: jet_layout_checked_add(value, effective - 1) ?? return None
    Val((padding /% effective) * effective)
}

#Test("raw pointer layout uses the selected target without pointee layout") {
    loop triple in ([String]{"x86_64-unknown-linux-gnu", "wasm32-unknown-unknown"}) {
        target: jet_target_layout_from_triple(triple, "0.0.1")
        engine: jet_target_layout_engine([Item]{}, target)
        pointer_size: if triple.starts_with("wasm32-") -> 4 else -> 8
        loop pointee in ([Type]{Type.Int, Type.Named{name: "UnresolvedPointee"}}) {
            pointer: Type.Apply{name: "Ptr", args: [Type]{pointee}}
            layout: jet_target_layout_type_facts(engine, pointer) ?? panic("raw pointer layout is missing")
            assert(layout.size == pointer_size)
            assert(layout.alignment == pointer_size)
            assert(layout.stride == pointer_size)
        }
        loop args in ([[Type]]{[Type]{}, [Type]{Type.Int, Type.Bool}}) {
            assert(jet_target_layout_type_facts(engine, Type.Apply{name: "Ptr", args: args}) == None)
        }
    }
}
