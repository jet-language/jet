// Canonical target layout identity, profile contracts, and compiler-owned
// physical layout facts. This module deliberately never asks a native layout
// engine for an answer: only `#Layout(c)` and `#Layout(columnar)` declarations
// receive concrete aggregate facts.

JET_TARGET_LAYOUT_FACT_VERSION :: prep { "layout-facts-v2" }

JET_LAYOUT_U64_MAX :: prep { 0xffffffffffffffff }

JET_LAYOUT_PORTABLE_ALIGNMENT_BASELINE_MAX :: prep { 1048576 }

// Every portable alignment boundary is an exact power of two. The target
// profile may prove a narrower set, but a portable declaration cannot exceed
// this baseline unless it opts into target alignment mode.
JET_LAYOUT_PORTABLE_ALIGNMENT_BASELINE :: prep { [Int]{
    1, 2, 4, 8, 16, 32, 64, 128, 256, 512,
    1024, 2048, 4096, 8192, 16384, 32768, 65536,
    131072, 262144, 524288, 1048576
} }

// Size, alignment, and repeated-element stride for one physical value.
pub struct ByteLayout {
    pub size: Int
    pub alignment: Int
    pub stride: Int
}

// Byte facts for one stored field or enum payload. Unknown physical facts are
// represented by None in every numeric column; they are never approximated.
pub struct FieldLayoutFacts {
    pub name: String
    pub offset: Int?
    pub size: Int?
    pub alignment: Int?
    pub stride: Int?
}

// The one physical-layout result consumed by sema/TIR/MIR and reflection.
pub struct LayoutFacts {
    pub bytes: ByteLayout?
    pub fields: [FieldLayoutFacts]
}

pub struct CheckedLayoutFacts {
    pub physical: LayoutFacts
    pub alignment: MIRLayoutAlignmentFact?
}

pub struct JetTargetLayout {
    pub triple: String
    pub pointer_size: Int
    pub pointer_alignment: Int
    pub facts: MIRLayoutCapabilityFacts
}

pub enum JetLayoutAlignmentError {
    Zero
    NotPowerOfTwo(requested: Int)
    PortableBaseline(requested: Int, baseline: Int)
    MissingTypeFacts(profile: String)
    Unsupported(requested: Int, effective: Int, profile: String)
}

pub enum JetLayoutAlignmentResult {
    Accepted(value: MIRLayoutAlignmentFact)
    Rejected(error: JetLayoutAlignmentError)
}

pub enum JetLayoutStorageKind {
    Stack
    Global
    Heap
    ForeignByValue
}

pub enum JetLayoutStorageError {
    MissingFacts(kind: JetLayoutStorageKind, profile: String)
    UnsupportedAlignment(kind: JetLayoutStorageKind, alignment: Int, profile: String)
    MissingSizeBound(kind: JetLayoutStorageKind)
    SizeExceeded(kind: JetLayoutStorageKind, size: Int, max_size: Int)
    MissingAddressBound(kind: JetLayoutStorageKind)
    AddressOverflow(kind: JetLayoutStorageKind)
    AddressExceeded(kind: JetLayoutStorageKind, end: Int, max_address: Int)
}

pub enum JetLayoutStorageResult {
    Accepted
    Rejected(error: JetLayoutStorageError)
}

pub enum JetCheckedLayoutResult {
    Accepted(value: CheckedLayoutFacts)
    Rejected(error: JetLayoutAlignmentError)
}

// One source declaration in the canonical module-qualified layout registry.
// The module identity is retained so raw field names can be resolved in the
// declaration's own source namespace during recursive layout.
pub struct TargetLayoutQualifiedItem {
    pub qualified_name: String
    pub module_identity: String
    pub item: Item
}

// One exact source-name resolution produced by sema. The owner is the
// declaration's canonical identity, so aliases and imported paths remain
// distinct even when they occur in the same module.
pub struct TargetLayoutNameResolution {
    pub owner_qualified_name: String
    pub source_name: String
    pub qualified_name: String
}

// The engine owns the selected target and the complete source-item registry.
// The registry is required for nominal field/payload resolution; the target is
// required explicitly so sema cannot infer a host default. The registry's
// name indexes (first row per name) are built once with the engine, not per
// query (Rust `TargetLayoutEngine::new`).
pub struct TargetLayoutEngine {
    pub target: JetTargetLayout
    pub items: [Item]
    pub qualified_items: [TargetLayoutQualifiedItem]
    pub name_resolutions: [TargetLayoutNameResolution]
    pub item_positions: [String:Int]
    pub qualified_positions: [String:Int]
    pub resolution_positions: [String:Int]
}

// The target/profile and registry are fixed for this query. Completed byte
// facts are keyed by registry row plus generic arguments, never by an active
// recursion path. Cycle-dependent unknown results must not enter the memo.
struct JetTargetLayoutQuery {
    active: [String:Bool]
    cycle_hits: Int
    completed_positions: [String:Int]
    completed: [ByteLayout?]
}

// Rust: none (Jet-only pass)
fn jet_target_layout_resolution_key(owner: String, source: String) -> String Never! {
    "{owner.bytes().len()}:{owner}{source}"
}

fn jet_target_layout_query() -> JetTargetLayoutQuery Never! {
    JetTargetLayoutQuery{
        active: [String:Bool]{},
        cycle_hits: 0,
        completed_positions: [String:Int]{},
        completed: [ByteLayout?]{},
    }
}

pub fn jet_target_layout_support_unknown() -> MIRLayoutSupportFacts Never! {
    MIRLayoutSupportFacts{
        proven: false,
        alignments: [Int]{},
        max_size: None,
        max_address: None,
        abi: None,
        provenance: "",
    }
}

fn jet_target_layout_support_exact(triple: String, address_bound: Int) -> MIRLayoutSupportFacts Never! {
    MIRLayoutSupportFacts{
        proven: true,
        alignments: JET_LAYOUT_PORTABLE_ALIGNMENT_BASELINE,
        max_size: Val(address_bound),
        max_address: Val(address_bound),
        abi: None,
        provenance: "target-profile:{triple}:portable-alignment-baseline",
    }
}

// Build an authoritative support row from a target-provided alignment set.
// Empty rows are unknown; no caller may treat unknown as unlimited support.
pub fn jet_target_layout_support_exact_rows(alignments: [Int], max_size: Int?, max_address: Int?, provenance: String) -> MIRLayoutSupportFacts Never! {
    proven :: alignments.len() > 0
    MIRLayoutSupportFacts{
        proven: proven,
        alignments: alignments,
        max_size: max_size,
        max_address: max_address,
        abi: None,
        provenance: provenance,
    }
}

// Build the exact powers-of-two support row through one checked boundary.
pub fn jet_target_layout_support_powers_through(max_alignment: Int, max_size: Int?, max_address: Int?, provenance: String) -> MIRLayoutSupportFacts Never! {
    if max_alignment <= 0 || !jet_layout_is_power_of_two(max_alignment) -> return jet_target_layout_support_unknown()
    alignments := [Int]{}
    alignment := 1
    loop {
        &alignments.push(alignment)
        if alignment >= max_alignment -> break
        next :: jet_layout_checked_mul(alignment, 2) ?? break
        alignment = next
    }
    jet_target_layout_support_exact_rows(alignments, max_size, max_address, provenance)
}

pub fn jet_target_layout_support_with_abi(support: MIRLayoutSupportFacts, abi: String) -> MIRLayoutSupportFacts Never! {
    MIRLayoutSupportFacts{
        proven: support.proven,
        alignments: support.alignments,
        max_size: support.max_size,
        max_address: support.max_address,
        abi: Val(abi),
        provenance: support.provenance,
    }
}

pub fn jet_target_layout_supports_alignment(support: MIRLayoutSupportFacts, alignment: Int) -> Bool Never! {
    if !support.proven || alignment <= 0 -> return false
    loop candidate in support.alignments {
        if candidate == alignment -> return true
    }
    false
}

fn jet_target_layout_known_triple(triple: String) -> Bool Never! {
    triple.starts_with("x86_64-") || triple.starts_with("aarch64-") || triple.starts_with("wasm32-") || triple.starts_with("i686-") || triple.starts_with("arm-") || triple.starts_with("armv7-") || triple.starts_with("thumb")
}

pub fn jet_target_layout_pointer_size(triple: String) -> Int Never! {
    if triple.starts_with("wasm32-") || triple.starts_with("i686-") || triple.starts_with("arm-") || triple.starts_with("armv7-") || triple.starts_with("thumb") -> 4 else -> 8
}

fn jet_target_layout_from_triple_and_version(triple: String, package_version: String) -> JetTargetLayout Never! {
    pointer_size :: jet_target_layout_pointer_size(triple)
    address_bound :: if pointer_size <= 4 -> 0xffffffff else -> JET_LAYOUT_U64_MAX
    unknown :: jet_target_layout_support_unknown()
    support :: if jet_target_layout_known_triple(triple) -> jet_target_layout_support_exact(triple, address_bound) else -> unknown
    foreign :: jet_target_layout_support_with_abi(support, "C")
    layout_facts :: MIRLayoutCapabilityFacts{
        fact_version: JET_TARGET_LAYOUT_FACT_VERSION,
        target_profile: triple,
        execution_modes: [String]{"aot"},
        backend: "jet-codegen",
        toolchain: package_version,
        linker: "target-profile",
        allocator_provider: "target-profile",
        type_representation: support,
        stack_placement: support,
        global_placement: support,
        heap_allocator: support,
        foreign_by_value_abi: foreign,
    }
    JetTargetLayout{
        triple: triple,
        pointer_size: pointer_size,
        pointer_alignment: pointer_size,
        facts: layout_facts,
    }
}

pub fn jet_target_layout_from_triple(triple: String, package_version: String) -> JetTargetLayout Never! {
    jet_target_layout_from_triple_and_version(triple, package_version)
}

// Reuse the already selected driver machine. This is the only adapter allowed
// to move machine layout facts into a physical layout engine.
pub fn jet_target_layout_from_machine(machine: MIRTargetMachine) -> JetTargetLayout Never! {
    pointer_size :: jet_target_layout_pointer_size(machine.triple)
    JetTargetLayout{
        triple: machine.triple,
        pointer_size: pointer_size,
        pointer_alignment: pointer_size,
        facts: machine.layout,
    }
}

// Same as the machine adapter for callers that retain only the selected
// profile facts. The triple remains explicit and is never taken from the host.
pub fn jet_target_layout_from_selected_facts(triple: String, facts: MIRLayoutCapabilityFacts) -> JetTargetLayout Never! {
    pointer_size :: jet_target_layout_pointer_size(triple)
    JetTargetLayout{
        triple: triple,
        pointer_size: pointer_size,
        pointer_alignment: pointer_size,
        facts: facts,
    }
}

fn jet_target_layout_u64_bytes(value: Int) -> [U8] Never! {
    bytes := [U8]{}
    loop index in 0..<8 -> &bytes.push(U8{(value >> (8 * index)) & 255})
    bytes
}

fn jet_target_layout_frame(bytes: &[U8], value: [U8]) Never! {
    loop byte in jet_target_layout_u64_bytes(value.len()) -> &bytes.push(byte)
    loop byte in value -> &bytes.push(byte)
}

fn jet_target_layout_frame_string(bytes: &[U8], value: String) Never! {
    jet_target_layout_frame(&bytes, value.bytes())
}

fn jet_target_layout_frame_bool(bytes: &[U8], value: Bool) Never! {
    if value -> jet_target_layout_frame(&bytes, [U8]{1}) else -> jet_target_layout_frame(&bytes, [U8]{0})
}

fn jet_target_layout_frame_optional_int(bytes: &[U8], value: Int?) Never! {
    actual :: value ?? 0
    jet_target_layout_frame(&bytes, jet_target_layout_u64_bytes(actual))
}

fn jet_target_layout_frame_support(bytes: &[U8], support: MIRLayoutSupportFacts) Never! {
    jet_target_layout_frame_bool(&bytes, support.proven)
    loop alignment in support.alignments -> jet_target_layout_frame(&bytes, jet_target_layout_u64_bytes(alignment))
    jet_target_layout_frame_optional_int(&bytes, support.max_size)
    jet_target_layout_frame_optional_int(&bytes, support.max_address)
    abi :: support.abi ?? ""
    jet_target_layout_frame_string(&bytes, abi)
    jet_target_layout_frame_string(&bytes, support.provenance)
}

pub fn jet_target_layout_cache_identity(facts: MIRLayoutCapabilityFacts) -> String Never! {
    bytes := [U8]{}
    jet_target_layout_frame_string(&bytes, facts.fact_version)
    jet_target_layout_frame_string(&bytes, facts.target_profile)
    jet_target_layout_frame_string(&bytes, facts.backend)
    jet_target_layout_frame_string(&bytes, facts.toolchain)
    jet_target_layout_frame_string(&bytes, facts.linker)
    jet_target_layout_frame_string(&bytes, facts.allocator_provider)
    loop mode in facts.execution_modes -> jet_target_layout_frame_string(&bytes, mode)
    jet_target_layout_frame_support(&bytes, facts.type_representation)
    jet_target_layout_frame_support(&bytes, facts.stack_placement)
    jet_target_layout_frame_support(&bytes, facts.global_placement)
    jet_target_layout_frame_support(&bytes, facts.heap_allocator)
    jet_target_layout_frame_support(&bytes, facts.foreign_by_value_abi)
    "{JET_TARGET_LAYOUT_FACT_VERSION}:{mir_sha256_hex_bytes(bytes)}"
}

pub fn jet_target_layout_check_alignment(target: JetTargetLayout, requested: Int, natural: Int, target_mode: Bool) -> JetLayoutAlignmentResult Never! {
    if requested == 0 -> return JetLayoutAlignmentResult.Rejected{error: JetLayoutAlignmentError.Zero}
    if !jet_layout_is_power_of_two(requested) -> return JetLayoutAlignmentResult.Rejected{error: JetLayoutAlignmentError.NotPowerOfTwo{requested: requested}}
    if !target_mode && requested > JET_LAYOUT_PORTABLE_ALIGNMENT_BASELINE_MAX -> return JetLayoutAlignmentResult.Rejected{error: JetLayoutAlignmentError.PortableBaseline{requested: requested, baseline: JET_LAYOUT_PORTABLE_ALIGNMENT_BASELINE_MAX}}
    if !target.facts.type_representation.proven -> return JetLayoutAlignmentResult.Rejected{error: JetLayoutAlignmentError.MissingTypeFacts{profile: target.facts.target_profile}}
    effective :: if natural > requested -> natural else -> requested
    if !jet_target_layout_supports_alignment(target.facts.type_representation, effective) -> return JetLayoutAlignmentResult.Rejected{error: JetLayoutAlignmentError.Unsupported{requested: requested, effective: effective, profile: target.facts.target_profile}}
    JetLayoutAlignmentResult.Accepted{value: MIRLayoutAlignmentFact{
        requested_alignment: requested,
        effective_alignment: effective,
        target_mode: target_mode,
        target_profile: target.facts.target_profile,
        fact_identity: jet_target_layout_cache_identity(target.facts),
    }}
}

pub fn jet_target_layout_alignment_error_reason(error: JetLayoutAlignmentError) -> String Never! {
    if error == {
        .Zero -> "zero does not establish an alignment boundary"
        .NotPowerOfTwo(_) -> "the value is not a power of two"
        .PortableBaseline(_, baseline) -> "the portable declaration baseline is {baseline} bytes; use `align(target, N)` for a profile-specific request"
        .MissingTypeFacts(profile) -> "target profile `{profile}` has no proved type-representation alignment facts"
        .Unsupported(requested, effective, profile) -> "target profile `{profile}` does not support requested alignment {requested} (effective {effective})"
    }
}

fn jet_target_layout_support_for_storage(target: JetTargetLayout, kind: JetLayoutStorageKind) -> MIRLayoutSupportFacts Never! {
    if kind == {
        .Stack -> target.facts.stack_placement
        .Global -> target.facts.global_placement
        .Heap -> target.facts.heap_allocator
        else -> target.facts.foreign_by_value_abi
    }
}

fn jet_target_layout_storage_kind_name(kind: JetLayoutStorageKind) -> String Never! {
    if kind == JetLayoutStorageKind.Stack -> return "Stack"
    if kind == JetLayoutStorageKind.Global -> return "Global"
    if kind == JetLayoutStorageKind.Heap -> return "Heap"
    "ForeignByValue"
}

pub fn jet_target_layout_storage_kind_name_lower(kind: JetLayoutStorageKind) -> String Never! {
    if kind == JetLayoutStorageKind.Stack -> return "stack"
    if kind == JetLayoutStorageKind.Global -> return "global"
    if kind == JetLayoutStorageKind.Heap -> return "heap"
    "foreign by-value ABI"
}

pub fn jet_target_layout_storage_error_reason(error: JetLayoutStorageError) -> String Never! {
    if error == {
        .MissingFacts(kind, profile) -> "{jet_target_layout_storage_kind_name(kind)} placement facts are missing for target profile `{profile}`"
        .UnsupportedAlignment(kind, alignment, profile) -> "{jet_target_layout_storage_kind_name(kind)} placement does not support alignment {alignment} on target profile `{profile}`"
        .MissingSizeBound(kind) -> "{jet_target_layout_storage_kind_name(kind)} placement has no proved size bound"
        .SizeExceeded(kind, size, max_size) -> "{jet_target_layout_storage_kind_name(kind)} object size {size} exceeds target bound {max_size}"
        .MissingAddressBound(kind) -> "{jet_target_layout_storage_kind_name(kind)} placement has no proved address bound"
        .AddressOverflow(kind) -> "{jet_target_layout_storage_kind_name(kind)} address plus object size overflows"
        .AddressExceeded(kind, end, max_address) -> "{jet_target_layout_storage_kind_name(kind)} object end {end} exceeds target address bound {max_address}"
    }
}

pub fn jet_target_layout_check_storage(target: JetTargetLayout, kind: JetLayoutStorageKind, alignment: Int, size: Int, address: Int?) -> JetLayoutStorageResult Never! {
    support :: jet_target_layout_support_for_storage(target, kind)
    if !support.proven -> return JetLayoutStorageResult.Rejected{error: JetLayoutStorageError.MissingFacts{kind: kind, profile: target.facts.target_profile}}
    if alignment <= 0 || !jet_target_layout_supports_alignment(support, alignment) -> return JetLayoutStorageResult.Rejected{error: JetLayoutStorageError.UnsupportedAlignment{kind: kind, alignment: alignment, profile: target.facts.target_profile}}
    if size < 0 -> return JetLayoutStorageResult.Rejected{error: JetLayoutStorageError.AddressOverflow{kind: kind}}
    max_size :: support.max_size ?? return JetLayoutStorageResult.Rejected{error: JetLayoutStorageError.MissingSizeBound{kind: kind}}
    if size > max_size -> return JetLayoutStorageResult.Rejected{error: JetLayoutStorageError.SizeExceeded{kind: kind, size: size, max_size: max_size}}
    if address == .Val(address_value) {
        max_address :: support.max_address ?? return JetLayoutStorageResult.Rejected{error: JetLayoutStorageError.MissingAddressBound{kind: kind}}
        end :: jet_layout_checked_add(address_value, size) ?? return JetLayoutStorageResult.Rejected{error: JetLayoutStorageError.AddressOverflow{kind: kind}}
        if end > max_address -> return JetLayoutStorageResult.Rejected{error: JetLayoutStorageError.AddressExceeded{kind: kind, end: end, max_address: max_address}}
    }
    JetLayoutStorageResult.Accepted
}

pub fn jet_target_layout_check_array_storage(target: JetTargetLayout, kind: JetLayoutStorageKind, count: Int, layout: ByteLayout, address: Int?) -> JetLayoutStorageResult Never! {
    size :: jet_layout_checked_mul(layout.stride, count) ?? return JetLayoutStorageResult.Rejected{error: JetLayoutStorageError.AddressOverflow{kind: kind}}
    jet_target_layout_check_storage(target, kind, layout.alignment, size, address)
}

pub fn jet_target_layout_engine_from_machine_with_registry(items: [Item], qualified_items: [TargetLayoutQualifiedItem], name_resolutions: [TargetLayoutNameResolution], machine: MIRTargetMachine) -> TargetLayoutEngine Never! {
    jet_target_layout_engine_with_registry(items, qualified_items, name_resolutions, jet_target_layout_from_machine(machine))
}

pub fn jet_target_layout_engine_from_selected_facts_with_registry(items: [Item], qualified_items: [TargetLayoutQualifiedItem], name_resolutions: [TargetLayoutNameResolution], triple: String, facts: MIRLayoutCapabilityFacts) -> TargetLayoutEngine Never! {
    jet_target_layout_engine_with_registry(items, qualified_items, name_resolutions, jet_target_layout_from_selected_facts(triple, facts))
}

pub fn jet_target_layout_engine_from_machine(items: [Item], machine: MIRTargetMachine) -> TargetLayoutEngine Never! {
    jet_target_layout_engine_from_machine_with_registry(items, [TargetLayoutQualifiedItem]{}, [TargetLayoutNameResolution]{}, machine)
}

pub fn jet_target_layout_engine_from_selected_facts(items: [Item], triple: String, facts: MIRLayoutCapabilityFacts) -> TargetLayoutEngine Never! {
    jet_target_layout_engine_with_registry(items, [TargetLayoutQualifiedItem]{}, [TargetLayoutNameResolution]{}, jet_target_layout_from_selected_facts(triple, facts))
}

pub fn jet_target_layout_engine(items: [Item], target: JetTargetLayout) -> TargetLayoutEngine Never! {
    jet_target_layout_engine_with_registry(items, [TargetLayoutQualifiedItem]{}, [TargetLayoutNameResolution]{}, target)
}

// Rust: crates/jet-foundation/src/Layout.rs::TargetLayoutEngine::new
pub fn jet_target_layout_engine_with_registry(items: [Item], qualified_items: [TargetLayoutQualifiedItem], name_resolutions: [TargetLayoutNameResolution], target: JetTargetLayout) -> TargetLayoutEngine Never! {
    item_positions := [String:Int]{}
    loop position in 0..<items.len() {
        name :: jet_target_layout_item_name(items[position])
        if item_positions.get(name) == None -> item_positions[name] = position
    }
    qualified_positions := [String:Int]{}
    loop position in 0..<qualified_items.len() {
        name :: qualified_items[position].qualified_name
        if qualified_positions.get(name) == None -> qualified_positions[name] = position
    }
    resolution_positions := [String:Int]{}
    loop position in 0..<name_resolutions.len() {
        key :: jet_target_layout_resolution_key(name_resolutions[position].owner_qualified_name, name_resolutions[position].source_name)
        if resolution_positions.get(key) == None -> resolution_positions[key] = position
    }
    TargetLayoutEngine{target: target, items: items, qualified_items: qualified_items, name_resolutions: name_resolutions, item_positions: item_positions, qualified_positions: qualified_positions, resolution_positions: resolution_positions}
}

pub fn jet_target_layout_engine_target(engine: TargetLayoutEngine) -> JetTargetLayout Never! {
    engine.target
}

// Rust: crates/jet-foundation/src/Layout.rs::TargetLayoutEngine::struct_facts
pub fn jet_target_layout_struct_facts(engine: TargetLayoutEngine, definition: StructDef) -> LayoutFacts Never! {
    query := jet_target_layout_query()
    jet_target_layout_struct_facts_inner_named(engine, definition, definition.name, "", &query)
}

// Rust: crates/jet-foundation/src/Layout.rs::TargetLayoutEngine::struct_facts
pub fn jet_target_layout_struct_facts_in_module(engine: TargetLayoutEngine, definition: StructDef, module_identity: String) -> LayoutFacts Never! {
    query := jet_target_layout_query()
    identity :: if module_identity == "" -> definition.name else -> "{module_identity}::{definition.name}"
    jet_target_layout_struct_facts_inner_named(engine, definition, identity, identity, &query)
}

pub fn jet_target_layout_checked_struct_facts(engine: TargetLayoutEngine, definition: StructDef) -> JetCheckedLayoutResult Never! {
    physical :: jet_target_layout_struct_facts(engine, definition)
    if definition.layout == {
        Val(layout) -> if layout == {
            .CAligned(alignment, target_mode) -> {
                natural :: physical.bytes.map(value -> value.alignment) ?? 1
                checked :: jet_target_layout_check_alignment(engine.target, alignment, natural, target_mode)
                if checked == {
                    .Accepted(value) -> return JetCheckedLayoutResult.Accepted{value: CheckedLayoutFacts{physical: physical, alignment: Val(value)}}
                    .Rejected(error) -> return JetCheckedLayoutResult.Rejected{error: error}
                }
            }
            else -> {}
        }
        None -> {}
    }
    JetCheckedLayoutResult.Accepted{value: CheckedLayoutFacts{physical: physical, alignment: None}}
}

pub fn jet_target_layout_enum_c_tag(definition: EnumDef) -> CEnumTag? {
    marker :: loop candidate in definition.type_markers {
        if candidate.name == "Layout" -> break candidate
    } ?? return None
    layout_expr :: jet_target_layout_marker_expression(marker, 0) ?? return None
    layout_name :: if layout_expr == { .Ident(name, _) -> name else -> "" }
    if jet_target_layout_ascii_lower(layout_name) != "c" -> return None
    enum_tag :: jet_target_layout_marker_expression(marker, 1) ?? return Val(CEnumTag.CInt)
    if enum_tag == {
        .Ident(name, _) -> if name == {
            "U8" -> Val(CEnumTag.U8)
            "I8" -> Val(CEnumTag.I8)
            "U16" -> Val(CEnumTag.U16)
            "I16" -> Val(CEnumTag.I16)
            "U32" -> Val(CEnumTag.U32)
            "I32" -> Val(CEnumTag.I32)
            "U64" -> Val(CEnumTag.U64)
            "I64" -> Val(CEnumTag.I64)
            else -> None
        }
        else -> None
    }
}

fn jet_target_layout_marker_expression(marker: Marker, index: Int) -> Expr? {
    if index < 0 || index >= marker.args.len() -> return None
    if marker.args[index] == { .Expr(value) -> Val(value) else -> None }
}

pub fn jet_target_layout_mir_c_tag(enum_tag: CEnumTag) -> MIRCEnumTag Never! {
    if enum_tag == {
        .CInt -> MIRCEnumTag.CInt
        .U8 -> MIRCEnumTag.U8
        .I8 -> MIRCEnumTag.I8
        .U16 -> MIRCEnumTag.U16
        .I16 -> MIRCEnumTag.I16
        .U32 -> MIRCEnumTag.U32
        .I32 -> MIRCEnumTag.I32
        .U64 -> MIRCEnumTag.U64
        .I64 -> MIRCEnumTag.I64
    }
}

// Rust: crates/jet-foundation/src/Layout.rs::TargetLayoutEngine::enum_facts
pub fn jet_target_layout_enum_facts(engine: TargetLayoutEngine, definition: EnumDef) -> LayoutFacts Never! {
    query := jet_target_layout_query()
    jet_target_layout_enum_facts_inner_named(engine, definition, definition.name, "", &query)
}

// Rust: crates/jet-foundation/src/Layout.rs::TargetLayoutEngine::enum_facts
pub fn jet_target_layout_enum_facts_in_module(engine: TargetLayoutEngine, definition: EnumDef, module_identity: String) -> LayoutFacts Never! {
    query := jet_target_layout_query()
    identity :: if module_identity == "" -> definition.name else -> "{module_identity}::{definition.name}"
    jet_target_layout_enum_facts_inner_named(engine, definition, identity, identity, &query)
}

// Rust: crates/jet-foundation/src/Layout.rs::TargetLayoutEngine::type_layout_inner
pub fn jet_target_layout_type_facts(engine: TargetLayoutEngine, ty: Type) -> ByteLayout? {
    query := jet_target_layout_query()
    jet_target_layout_type_inner(engine, ty, "", &query)
}

// Rust: crates/jet-foundation/src/Layout.rs::TargetLayoutEngine::struct_facts_inner
fn jet_target_layout_struct_facts_inner_named(engine: TargetLayoutEngine, definition: StructDef, identity: String, owner_qualified_name: String, query: &JetTargetLayoutQuery) -> LayoutFacts Never! {
    field_names :: loop field in definition.fields if field.computed == None -> field.name
    layout :: definition.layout ?? return jet_target_layout_unknown(field_names)
    if !jet_target_layout_struct_layout_is_physical(layout) -> return jet_target_layout_unknown(field_names)
    if !jet_target_layout_enter(&query, identity) -> return jet_target_layout_unknown(field_names)
    names := [String]{}
    types := [Type]{}
    loop field in definition.fields {
        if field.computed != None -> next
        &names.push(field.name)
        &types.push(field.ty)
    }
    facts :: jet_target_layout_aggregate(engine, names, types, owner_qualified_name, &query)
    query.active[identity] = false
    if layout == {
        .CAligned(alignment, _) -> jet_target_layout_aligned_struct_facts(facts, alignment)
        else -> facts
    }
}

// Rust: crates/jet-foundation/src/Layout.rs::TargetLayoutEngine::enum_facts
fn jet_target_layout_enum_facts_inner_named(engine: TargetLayoutEngine, definition: EnumDef, identity: String, owner_qualified_name: String, query: &JetTargetLayoutQuery) -> LayoutFacts Never! {
    variant_names :: loop variant in definition.variants -> variant.name
    enum_tag :: jet_target_layout_enum_c_tag(definition) ?? return jet_target_layout_unknown(variant_names)
    if !jet_target_layout_enter(&query, identity) -> return jet_target_layout_unknown(variant_names)
    tag_layout :: jet_target_layout_scalar(jet_target_layout_enum_tag_size(enum_tag))
    payloads := [ByteLayout?]{}
    payloads_known := [Bool]{}
    loop variant in definition.variants {
        if variant.payload == {
            .Unit -> {
                &payloads.push(None)
                &payloads_known.push(true)
            }
            .Single(ty, _) -> {
                payload :: jet_target_layout_type_inner(engine, ty, owner_qualified_name, &query)
                &payloads.push(payload)
                &payloads_known.push(payload != None)
            }
            .Named(fields) -> {
                names := [String]{}
                types := [Type]{}
                loop field in fields {
                    &names.push(field.name)
                    &types.push(field.ty)
                }
                payload :: jet_target_layout_aggregate(engine, names, types, owner_qualified_name, &query).bytes
                &payloads.push(payload)
                &payloads_known.push(payload != None)
            }
        }
    }
    payload_alignment := 1
    payload_size := 0
    all_known := true
    loop index in 0..<payloads.len() {
        if !payloads_known[index] -> all_known = false
        if payloads[index] == .Val(payload) {
            if payload.alignment > payload_alignment -> payload_alignment = payload.alignment
            if payload.size > payload_size -> payload_size = payload.size
        }
    }
    alignment :: if tag_layout.alignment > payload_alignment -> tag_layout.alignment else -> payload_alignment
    payload_offset :: jet_layout_align_up(tag_layout.size, payload_alignment) ?? {
        query.active[identity] = false
        return jet_target_layout_unknown(variant_names)
    }
    total :: jet_layout_checked_add(payload_offset, payload_size) ?? {
        query.active[identity] = false
        return jet_target_layout_unknown(variant_names)
    }
    size :: jet_layout_align_up(total, alignment) ?? {
        query.active[identity] = false
        return jet_target_layout_unknown(variant_names)
    }
    bytes :: jet_target_layout_enum_bytes(all_known, size, alignment)
    facts := [FieldLayoutFacts]{}
    index := 0
    loop index < definition.variants.len() {
        variant := definition.variants[index]
        if payloads[index] == {
            Val(payload) -> &facts.push(FieldLayoutFacts{name: variant.name, offset: Val(payload_offset), size: Val(payload.size), alignment: Val(payload.alignment), stride: Val(payload.stride)})
            None -> &facts.push(FieldLayoutFacts{name: variant.name, offset: Val(0), size: Val(tag_layout.size), alignment: Val(tag_layout.alignment), stride: Val(tag_layout.stride)})
        }
        index += 1
    }
    query.active[identity] = false
    LayoutFacts{bytes: bytes, fields: facts}
}

// Rust: crates/jet-foundation/src/Layout.rs::TargetLayoutEngine::aggregate_fields
fn jet_target_layout_aggregate(engine: TargetLayoutEngine, names: [String], types: [Type], owner_qualified_name: String, query: &JetTargetLayoutQuery) -> LayoutFacts Never! {
    cursor := Val(0)
    aggregate_alignment := Val(1)
    facts := [FieldLayoutFacts]{}
    index := 0
    loop index < names.len() {
        name := names[index]
        layout := jet_target_layout_type_inner(engine, types[index], owner_qualified_name, &query)
        offset := jet_target_layout_field_offset(cursor, layout)
        if layout == {
            Val(value) -> {
                if offset == {
                    Val(actual) -> cursor = jet_layout_checked_add(actual, value.size)
                    None -> cursor = None
                }
                if aggregate_alignment != None {
                    current :: aggregate_alignment ?? 1
                    aggregate_alignment = Val(if current > value.alignment -> current else -> value.alignment)
                }
                &facts.push(FieldLayoutFacts{name: name, offset: offset, size: Val(value.size), alignment: Val(value.alignment), stride: Val(value.stride)})
            }
            None -> {
                cursor = None
                aggregate_alignment = None
                &facts.push(jet_target_layout_unknown_field(name))
            }
        }
        index += 1
    }
    LayoutFacts{bytes: jet_target_layout_aggregate_bytes(cursor, aggregate_alignment), fields: facts}
}

fn jet_target_layout_enum_bytes(all_known: Bool, size: Int, alignment: Int) -> ByteLayout? {
    if !all_known -> return None
    Val(ByteLayout{size: size, alignment: alignment, stride: size})
}

fn jet_target_layout_field_offset(cursor: Int?, layout: ByteLayout?) -> Int? {
    current :: cursor ?? return None
    value :: layout ?? return None
    jet_layout_align_up(current, value.alignment)
}

fn jet_target_layout_aggregate_bytes(cursor: Int?, aggregate_alignment: Int?) -> ByteLayout? {
    current :: cursor ?? return None
    alignment :: aggregate_alignment ?? return None
    size :: jet_layout_align_up(current, alignment) ?? return None
    Val(ByteLayout{size: size, alignment: alignment, stride: size})
}

// Rust: crates/jet-foundation/src/Layout.rs::TargetLayoutEngine::type_layout_inner
fn jet_target_layout_type_inner(engine: TargetLayoutEngine, ty: Type, owner_qualified_name: String, query: &JetTargetLayoutQuery) -> ByteLayout? {
    if ty == {
        .Int | .Float -> Val(jet_target_layout_scalar(8))
        .Bool -> Val(jet_target_layout_scalar(1))
        .Char -> Val(jet_target_layout_scalar(4))
        .Float32 -> Val(jet_target_layout_scalar(4))
        .IntN(_, bits) -> {
            size :: jet_layout_checked_add(bits, 7) ?? return None
            Val(jet_target_layout_scalar(size /% 8))
        }
        .String | .List(_) -> jet_target_layout_pointer_layout(engine.target)
        .FixedList(element, length) -> {
            element_layout :: jet_target_layout_type_inner(engine, element, owner_qualified_name, &query) ?? return None
            count :: measure_literal_value(length) ?? return None
            size :: jet_layout_checked_mul(element_layout.stride, count) ?? return None
            Val(ByteLayout{size: size, alignment: element_layout.alignment, stride: size})
        }
        .InlineRange(base, _, _) | .Tagged(_, base) | .Quantity(base, _) -> jet_target_layout_type_inner(engine, base, owner_qualified_name, &query)
        .Named(name) -> jet_target_layout_named_type(engine, name, [Type]{}, owner_qualified_name, &query)
        .Apply(name, args) -> {
            if jet_target_layout_is_atomic_name(name) -> return jet_target_layout_atomic_layout(engine, args)
            jet_target_layout_named_type(engine, name, args, owner_qualified_name, &query)
        }
        .Tuple(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Union(_) | .Measure(_) -> None
    }
}

fn jet_target_layout_is_atomic_name(name: String) -> Bool Never! {
    name == "Atomic" || name.ends_with("::Atomic") || name.ends_with(".Atomic")
}

fn jet_target_layout_atomic_layout(engine: TargetLayoutEngine, args: [Type]) -> ByteLayout? {
    if {
        !jet_target_layout_supports_atomic_word(engine.target) -> None
        args.len() != 1 -> None
        jet_target_layout_atomic_scalar_type(args[0]) -> Val(jet_target_layout_scalar(8))
        else -> None
    }
}

// Rust: none (Jet-only pass)
fn jet_target_layout_resolved_name(engine: TargetLayoutEngine, owner_qualified_name: String, source_name: String) -> String Never! {
    key :: jet_target_layout_resolution_key(owner_qualified_name, source_name)
    position :: engine.resolution_positions.get(key) ?? return ~source_name
    engine.name_resolutions[position].qualified_name
}

// Rust: crates/jet-foundation/src/Layout.rs::TargetLayoutEngine::named_type_layout
fn jet_target_layout_named_item(engine: TargetLayoutEngine, item: Item, identity: String, registry_key: String, args: [Type], query: &JetTargetLayoutQuery) -> ByteLayout? {
    key :: type_identity_key(Type.Apply{name: registry_key, args: args})
    if !(query.active.get(identity) ?? false) {
        if query.completed_positions.get(key) == .Val(position) -> return query.completed[position]
    }
    cycle_hits :: query.cycle_hits
    result :: if item == {
        .Struct(definition) -> jet_target_layout_struct_facts_inner_named(engine, definition, identity, identity, &query).bytes
        .Enum(definition) -> jet_target_layout_enum_facts_inner_named(engine, definition, identity, identity, &query).bytes
        .Distinct(definition) -> {
            if !jet_target_layout_enter(&query, identity) -> return None
            bytes :: jet_target_layout_type_inner(engine, definition.base, identity, &query)
            query.active[identity] = false
            bytes
        }
        .TypeAlias(definition) -> {
            if !jet_target_layout_enter(&query, identity) -> return None
            bytes :: jet_target_layout_type_inner(engine, definition.target, identity, &query)
            query.active[identity] = false
            bytes
        }
        else -> None
    }
    if cycle_hits == query.cycle_hits && query.completed_positions.get(key) == None {
        query.completed_positions[key] = query.completed.len()
        &query.completed.push(result)
    }
    result
}

// Rust: crates/jet-foundation/src/Layout.rs::TargetLayoutEngine::named_type_layout
fn jet_target_layout_named_type(engine: TargetLayoutEngine, name: String, args: [Type], owner_qualified_name: String, query: &JetTargetLayoutQuery) -> ByteLayout? {
    if jet_target_layout_numeric_type(name) == .Val(numeric) -> return jet_target_layout_type_inner(engine, numeric, owner_qualified_name, &query)
    if name == "Bool" -> return Val(jet_target_layout_scalar(1))
    if name == "Char" -> return Val(jet_target_layout_scalar(4))
    if name == "String" || name == "List" -> return jet_target_layout_pointer_layout(engine.target)
    if name == "Unit" || name == "()" -> return Val(ByteLayout{size: 0, alignment: 1, stride: 0})

    resolved_name :: jet_target_layout_resolved_name(engine, owner_qualified_name, name)
    if resolved_name != name {
        if jet_target_layout_numeric_type(resolved_name) == .Val(numeric_resolved) -> return jet_target_layout_type_inner(engine, numeric_resolved, owner_qualified_name, &query)
        position :: engine.qualified_positions.get(resolved_name) ?? return None
        return jet_target_layout_named_item(engine, engine.qualified_items[position].item, engine.qualified_items[position].qualified_name, "qualified:{position}", args, &query)
    }
    if engine.item_positions.get(name) == .Val(position) {
        return jet_target_layout_named_item(engine, engine.items[position], name, "item:{position}", args, &query)
    }
    position :: engine.qualified_positions.get(name) ?? return None
    jet_target_layout_named_item(engine, engine.qualified_items[position].item, engine.qualified_items[position].qualified_name, "qualified:{position}", args, &query)
}

fn jet_target_layout_pointer_layout(target: JetTargetLayout) -> ByteLayout? {
    size :: jet_layout_checked_mul(target.pointer_size, 3) ?? return None
    Val(ByteLayout{size: size, alignment: target.pointer_alignment, stride: size})
}

fn jet_target_layout_numeric_type(name: String) -> Type? {
    if name == {
        "Int" -> Val(Type.Int)
        "Float" | "F64" -> Val(Type.Float)
        "F32" -> Val(Type.Float32)
        "I8" -> Val(Type.IntN{signed: true, bits: 8})
        "U8" -> Val(Type.IntN{signed: false, bits: 8})
        "I16" -> Val(Type.IntN{signed: true, bits: 16})
        "U16" -> Val(Type.IntN{signed: false, bits: 16})
        "I32" -> Val(Type.IntN{signed: true, bits: 32})
        "U32" -> Val(Type.IntN{signed: false, bits: 32})
        "I64" -> Val(Type.IntN{signed: true, bits: 64})
        "U64" -> Val(Type.IntN{signed: false, bits: 64})
        else -> None
    }
}

fn jet_target_layout_item_name(item: Item) -> String Never! {
    if item == {
        .Struct(definition) -> definition.name
        .Enum(definition) -> definition.name
        .Distinct(definition) -> definition.name
        .TypeAlias(definition) -> definition.name
        else -> ""
    }
}

fn jet_target_layout_scalar(size: Int) -> ByteLayout Never! {
    ByteLayout{size: size, alignment: jet_target_layout_scalar_alignment(size), stride: size}
}

fn jet_target_layout_scalar_alignment(size: Int) -> Int Never! {
    if {
        size == 0 -> 1
        size == 1 || size == 2 || size == 4 || size == 8 -> size
        else -> 8
    }
}

fn jet_target_layout_enum_tag_size(enum_tag: CEnumTag) -> Int Never! {
    if enum_tag == {
        .CInt -> 4
        .U8 | .I8 -> 1
        .U16 | .I16 -> 2
        .U32 | .I32 -> 4
        .U64 | .I64 -> 8
    }
}

fn jet_target_layout_aligned_struct_facts(facts: LayoutFacts, alignment: Int) -> LayoutFacts Never! {
    if alignment <= 0 || !jet_layout_is_power_of_two(alignment) -> return LayoutFacts{bytes: None, fields: facts.fields}
    bytes :: facts.bytes ?? return facts
    size :: jet_layout_align_up(bytes.size, alignment) ?? return LayoutFacts{bytes: None, fields: facts.fields}
    effective :: if bytes.alignment > alignment -> bytes.alignment else -> alignment
    LayoutFacts{bytes: Val(ByteLayout{size: size, alignment: effective, stride: size}), fields: facts.fields}
}

fn jet_target_layout_struct_layout_is_physical(layout: StructLayout) -> Bool Never! {
    if layout == {
        .C | .CAligned(_, _) | .Columnar -> true
    }
}

fn jet_target_layout_unknown_field(name: String) -> FieldLayoutFacts Never! {
    FieldLayoutFacts{name: name, offset: None, size: None, alignment: None, stride: None}
}

fn jet_target_layout_unknown(names: [String]) -> LayoutFacts Never! {
    fields :: loop name in names -> jet_target_layout_unknown_field(name)
    LayoutFacts{bytes: None, fields: fields}
}

pub fn jet_target_layout_atomic_scalar_type(ty: Type) -> Bool Never! {
    if ty == {
        .Bool | .Int -> true
        .IntN(_, bits) -> bits == 32 || bits == 64
        .Named(name) -> {
            if name == "Bool" -> return true
            numeric :: jet_target_layout_numeric_type(name) ?? return false
            jet_target_layout_atomic_scalar_type(numeric)
        }
        else -> false
    }
}

pub fn jet_target_layout_atomic_add_type(ty: Type) -> Bool Never! {
    if !jet_target_layout_atomic_scalar_type(ty) -> return false
    if ty == {
        .Bool -> false
        .Named(name) -> name != "Bool"
        else -> true
    }
}

pub fn jet_target_layout_supports_atomic_word(target: JetTargetLayout) -> Bool Never! {
    target.triple.starts_with("x86_64-") || target.triple.starts_with("aarch64-") || target.triple.starts_with("wasm32-")
}

// Rust: crates/jet-foundation/src/Layout.rs::TargetLayoutEngine::struct_facts_inner
fn jet_target_layout_enter(query: &JetTargetLayoutQuery, identity: String) -> Bool Never! {
    if query.active.get(identity) ?? false {
        query.cycle_hits += 1
        return false
    }
    query.active[identity] = true
    true
}

fn jet_target_layout_ascii_lower(text: String) -> String Never! {
    bytes := text.bytes()
    loop index in 0..<bytes.len() {
        code :: Int.from_u8(bytes[index])
        if code >= 65 && code <= 90 -> bytes[index] = U8{code + 32}
    }
    String.from_bytes(bytes) ?? text
}

fn jet_layout_is_power_of_two(value: Int) -> Bool Never! {
    value > 0 && (value & (value - 1)) == 0
}

fn jet_layout_checked_add(left: Int, right: Int) -> Int? {
    if left < 0 || right < 0 || left > JET_LAYOUT_U64_MAX || right > JET_LAYOUT_U64_MAX -> return None
    if left > JET_LAYOUT_U64_MAX - right -> return None
    Val(left + right)
}

fn jet_layout_checked_mul(left: Int, right: Int) -> Int? {
    if left < 0 || right < 0 || left > JET_LAYOUT_U64_MAX || right > JET_LAYOUT_U64_MAX -> return None
    if left == 0 || right == 0 -> return Val(0)
    if left > JET_LAYOUT_U64_MAX /% right -> return None
    Val(left * right)
}

fn jet_layout_align_up(value: Int, alignment: Int) -> Int? {
    if value < 0 || value > JET_LAYOUT_U64_MAX || alignment < 0 || alignment > JET_LAYOUT_U64_MAX -> return None
    effective :: if alignment < 1 -> 1 else -> alignment
    padding :: jet_layout_checked_add(value, effective - 1) ?? return None
    Val((padding /% effective) * effective)
}
