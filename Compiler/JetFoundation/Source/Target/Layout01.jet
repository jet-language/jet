pub fn jet_target_layout_host() -> JetTargetLayout Never! {
    jet_target_layout_from_triple(jet_target_layout_host_triple(), PKG_BUILD_STAMP_TOOLCHAIN)
}

// Rust: crates/jet-foundation/src/Layout.rs:629
// from_triple -> jet_target_layout_from_triple; package version is supplied by
// the canonical PKG_BUILD_STAMP_TOOLCHAIN constant, not the selected program.
// Rust: crates/jet-foundation/src/Layout.rs:651
pub fn jet_target_layout_from_build_facts(facts: BuildFactSnapshot) -> JetTargetLayout Never! {
    triple :: if facts.target_triple == "" -> jet_target_layout_host_triple() else -> facts.target_triple
    target := jet_target_layout_from_triple(triple, PKG_BUILD_STAMP_TOOLCHAIN)
    if facts.target_dossier.machine == .Val(machine) -> target.facts = machine.layout
    modes := ~target.facts.execution_modes
    if !modes.contains(facts.target_dossier.tier_identity) -> &modes.push(facts.target_dossier.tier_identity)
    target_profile :: if facts.target_dossier.machine == {
        .Val(machine) -> machine.layout.target_profile
        None -> "{facts.profile}:{target.triple}"
    }
    target.facts = jet_target_layout_with_identity(^target.facts, target_profile, ^modes,
        "jet-codegen", facts.target_dossier.compiler_identity,
        facts.target_dossier.linker_identity, facts.target_dossier.provider_identity)
    target
}

// Rust: crates/jet-foundation/src/Layout.rs:686
// supports_atomic_word -> jet_target_layout_supports_atomic_word.
// Rust: crates/jet-foundation/src/Layout.rs:692
// check_array_storage -> jet_target_layout_check_array_storage (checked stride).
// Rust: crates/jet-foundation/src/Layout.rs:709
pub fn jet_target_layout_host_triple() -> String Never! {
    // GATE #4483: Rust std process-host constants are required here, NOT the
    // program's selected target. An explicit build target bypasses this branch.
    arch :: std.env.consts.ARCH
    os :: std.env.consts.OS
    if {
        arch == "x86_64" && os == "linux" -> "x86_64-unknown-linux-gnu"
        arch == "aarch64" && os == "linux" -> "aarch64-unknown-linux-gnu"
        arch == "x86_64" && os == "windows" -> "x86_64-pc-windows-msvc"
        arch == "aarch64" && os == "windows" -> "aarch64-pc-windows-msvc"
        arch == "x86_64" && os == "macos" -> "x86_64-apple-darwin"
        arch == "aarch64" && os == "macos" -> "aarch64-apple-darwin"
        os == "wasi" -> "{arch}-wasi"
        else -> "{arch}-unknown-{os}"
    }
}

