// Canonical Layout.jet extension; publish in the SAME JetFoundation module.
// Rust: crates/jet-foundation/src/Layout.rs:1
// Concrete byte facts remain limited to compiler-owned C/columnar layouts.
// Existing items below map to Layout.jet; shared fact carriers map to MIR/MIR.jet.
// Integration: add Source/Target/Layout01.jet and Tests/Target/Layout01.jet to
// the existing JetFoundation source/test lists, without a new public module.
// Integration corrections in Layout.jet:
// - support_exact_rows: consume alignments through jet_target_layout_sorted_alignments
//   before computing proven and constructing the fact row.
// - supports_alignment: use support.proven &&
//   jet_target_layout_alignment_index(support.alignments, alignment) != None.
// These two helpers supply the Rust sorting/dedup and binary-search gaps, not
// another support-fact mechanism. No native allocation/atomic operations occur;
// #4494, #4499 and #4409 are not applicable to this reference window.

// Rust: crates/jet-foundation/src/Layout.rs:15
// LAYOUT_FACT_VERSION -> Layout.jet::JET_TARGET_LAYOUT_FACT_VERSION.
// Rust: crates/jet-foundation/src/Layout.rs:19
// PORTABLE_ALIGNMENT_BASELINE_MAX -> JET_LAYOUT_PORTABLE_ALIGNMENT_BASELINE_MAX.
// Rust: crates/jet-foundation/src/Layout.rs:24
// PORTABLE_ALIGNMENT_BASELINE -> JET_LAYOUT_PORTABLE_ALIGNMENT_BASELINE.
// Rust: crates/jet-foundation/src/Layout.rs:50
// LayoutSupportFacts -> MIR/MIR.jet::MIRLayoutSupportFacts.
// Rust: crates/jet-foundation/src/Layout.rs:67
// LayoutSupportFacts::unknown -> jet_target_layout_support_unknown.

// Rust: crates/jet-foundation/src/Layout.rs:78
// LayoutSupportFacts::exact -> jet_target_layout_support_exact_rows after the
// integration correction above (all fields otherwise match the canonical row).
fn jet_target_layout_sorted_alignments(values: ^[Int]) -> [Int] Never! {
    sorted := ^values
    &sorted.sort()
    kept := 0
    loop index in 0..<sorted.len() {
        if kept > 0 && sorted[index] == sorted[kept - 1] -> next
        if kept != index -> sorted[kept] = sorted[index]
        kept += 1
    }
    loop sorted.len() > kept -> &sorted.pop().drop("discard duplicate alignment beyond compacted prefix")
    sorted
}

// Rust: crates/jet-foundation/src/Layout.rs:97
// powers_through -> jet_target_layout_support_powers_through (already produces
// sorted unique powers, preserves checked multiplication and unknown boundary).
// Rust: crates/jet-foundation/src/Layout.rs:121
// with_abi -> jet_target_layout_support_with_abi.
// Rust: crates/jet-foundation/src/Layout.rs:126
// supports_alignment -> jet_target_layout_supports_alignment after correction.
fn jet_target_layout_alignment_index(alignments: [Int], alignment: Int) -> Int? Never! {
    low := 0
    high := alignments.len()
    loop low < high {
        middle :: low + (high - low) /% 2
        if alignments[middle] < alignment -> low = middle + 1 else -> high = middle
    }
    if low < alignments.len() && alignments[low] == alignment -> Val(low) else -> None
}

// Rust: crates/jet-foundation/src/Layout.rs:130
fn jet_target_layout_support_intersect(left: MIRLayoutSupportFacts, right: MIRLayoutSupportFacts) -> MIRLayoutSupportFacts Never! {
    alignments := [Int]{}
    if left.proven && right.proven {
        loop alignment in left.alignments {
            if jet_target_layout_alignment_index(right.alignments, alignment) != None -> &alignments.push(alignment)
        }
    }
    max_size := Int?{None}
    if left.max_size == .Val(a) {
        if right.max_size == .Val(b) -> max_size = Val(if a < b -> a else -> b)
    }
    max_address := Int?{None}
    if left.max_address == .Val(a) {
        if right.max_address == .Val(b) -> max_address = Val(if a < b -> a else -> b)
    }
    abi :: if left.abi == right.abi -> left.abi else -> None
    MIRLayoutSupportFacts{
        proven: left.proven && right.proven && alignments.len() > 0,
        alignments: ^alignments, max_size: max_size, max_address: max_address,
        abi: abi, provenance: "intersection({left.provenance}, {right.provenance})",
    }
}

// Rust: crates/jet-foundation/src/Layout.rs:161
pub struct LayoutExecutionFacts {
    pub mode: String
    pub type_representation: MIRLayoutSupportFacts
    pub stack_placement: MIRLayoutSupportFacts
    pub global_placement: MIRLayoutSupportFacts
    pub heap_allocator: MIRLayoutSupportFacts
    pub foreign_by_value_abi: MIRLayoutSupportFacts
}

// Rust: crates/jet-foundation/src/Layout.rs:171
pub fn jet_target_layout_execution_uniform(mode: String, support: MIRLayoutSupportFacts) -> LayoutExecutionFacts Never! {
    LayoutExecutionFacts{mode: mode, type_representation: support,
        stack_placement: support, global_placement: support,
        heap_allocator: support, foreign_by_value_abi: support}
}

// Rust: crates/jet-foundation/src/Layout.rs:187
// LayoutCapabilityFacts -> MIR/MIR.jet::MIRLayoutCapabilityFacts.
// Rust: crates/jet-foundation/src/Layout.rs:203
pub fn jet_target_layout_from_execution_modes(target_profile: String, backend: String, toolchain: String, linker: String, allocator_provider: String, modes: [LayoutExecutionFacts]) -> MIRLayoutCapabilityFacts Never! {
    execution_modes := loop mode in modes -> mode.mode
    &execution_modes.sort()
    kept := 0
    loop index in 0..<execution_modes.len() {
        if kept > 0 && execution_modes[index] == execution_modes[kept - 1] -> next
        if kept != index -> execution_modes[kept] = ^execution_modes[index]
        kept += 1
    }
    loop execution_modes.len() > kept -> &execution_modes.pop().drop("discard duplicate execution mode")
    type_representation := jet_target_layout_support_unknown()
    stack_placement := jet_target_layout_support_unknown()
    global_placement := jet_target_layout_support_unknown()
    heap_allocator := jet_target_layout_support_unknown()
    foreign_by_value_abi := jet_target_layout_support_unknown()
    if modes.len() > 0 {
        first :: modes[0]
        type_representation = first.type_representation
        stack_placement = first.stack_placement
        global_placement = first.global_placement
        heap_allocator = first.heap_allocator
        foreign_by_value_abi = first.foreign_by_value_abi
    }
    loop index in 1..<modes.len() {
        mode :: modes[index]
        type_representation = jet_target_layout_support_intersect(type_representation, mode.type_representation)
        stack_placement = jet_target_layout_support_intersect(stack_placement, mode.stack_placement)
        global_placement = jet_target_layout_support_intersect(global_placement, mode.global_placement)
        heap_allocator = jet_target_layout_support_intersect(heap_allocator, mode.heap_allocator)
        foreign_by_value_abi = jet_target_layout_support_intersect(foreign_by_value_abi, mode.foreign_by_value_abi)
    }
    MIRLayoutCapabilityFacts{fact_version: JET_TARGET_LAYOUT_FACT_VERSION,
        target_profile: target_profile, execution_modes: ^execution_modes,
        backend: backend, toolchain: toolchain, linker: linker,
        allocator_provider: allocator_provider, type_representation: ^type_representation,
        stack_placement: ^stack_placement, global_placement: ^global_placement,
        heap_allocator: ^heap_allocator, foreign_by_value_abi: ^foreign_by_value_abi}
}

// Rust: crates/jet-foundation/src/Layout.rs:264
// for_triple -> jet_target_layout_from_triple_and_version(...).facts;
// known families, address bounds, C ABI, aot mode and provenance match exactly.
// Rust: crates/jet-foundation/src/Layout.rs:309
pub fn jet_target_layout_with_identity(facts: ^MIRLayoutCapabilityFacts, target_profile: String, execution_modes: [String], backend: String, toolchain: String, linker: String, allocator_provider: String) -> MIRLayoutCapabilityFacts Never! {
    updated := ^facts
    updated.target_profile = target_profile
    updated.execution_modes = execution_modes
    updated.backend = backend
    updated.toolchain = toolchain
    updated.linker = linker
    updated.allocator_provider = allocator_provider
    updated
}

