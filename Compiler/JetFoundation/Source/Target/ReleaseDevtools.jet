// Shared Source projection of the package ReleaseDevtoolsPolicy.  Host policy
// parsing remains native; Driver folds the exact fields into these rows before
// handing them to Codegen or Web publication.
enum JetReleaseInspect { Local ReadOnly Disabled }

enum JetReleaseDevtoolsEndpoint { Absent ReadOnly }

enum JetReleaseDevtoolsAuthentication { BearerToken }

enum JetReleaseDevtoolsAuthority { LoopbackOrAllowlist }

enum JetReleaseDevtoolsPublication { SiteGated }

struct JetReleaseDevtoolsNetwork { address: String, prefix: Int }

struct JetReleaseDevtoolsDeployment {
    enabled: Bool
    token: String?
    allowlist: [JetReleaseDevtoolsNetwork]
}

struct JetReleaseDevtoolsPolicy {
    inspect: JetReleaseInspect?
    endpoint: JetReleaseDevtoolsEndpoint
    authentication: JetReleaseDevtoolsAuthentication
    authority: JetReleaseDevtoolsAuthority
    publication: JetReleaseDevtoolsPublication
    local_rail: Bool
    panel_code: Bool
    stream_code: Bool
    deployment: JetReleaseDevtoolsDeployment
}
