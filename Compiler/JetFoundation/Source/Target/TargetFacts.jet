// Target machine facts: memory, providers, policies, hardware registers, interrupts and DMA, and the
// layout facts the selected target supplies.

LayoutAlignmentFact: struct {
    requested_alignment: Int
    effective_alignment: Int
    target_mode: Bool
    target_profile: String
    fact_identity: String
}

RegisterWidth: enum { U8 U16 U32 U64 }

ByteSize: struct { bytes: Int }

TargetRegisterAccessMode: enum { ReadOnly WriteOnly ReadWrite }

SVDProvenance: struct { source: String, sha256: String }

TargetRegisterFact: struct {
    name: String
    offset: Int
    width: RegisterWidth
    access: TargetRegisterAccessMode
    volatile: Bool
}

TargetRegisterBlockFact: struct {
    name: String
    base: Int
    size: ByteSize
    registers: [TargetRegisterFact]
}

TargetRegisterOperation: enum { Read Write }

TargetRegisterAccessFact: struct {
    block: String
    register: String
    operation: TargetRegisterOperation
    width: RegisterWidth
}

TargetInterruptFact: struct {
    name: String
    vector: Int
    forbidden_effects: [String]
    bounded: Bool
}

TargetInterruptHandlerFact: struct {
    interrupt: String
    handler: String
    effects: [String]
    forbidden_effects: [String]
    bounded: Bool
}

TargetDMAOwnership: enum { Borrowed Transfer }

TargetDMAChannelFact: struct {
    name: String
    channel: Int
    transfer_width: RegisterWidth
    ownership: TargetDMAOwnership
    max_transfer_bytes: Int?
}

TargetDMAOperation: enum { Start Wait UseBuffer }

TargetDMAOwner: enum { CPU Device }

TargetDMAOperationFact: struct {
    channel: String
    buffer: String
    operation: TargetDMAOperation
    owner: TargetDMAOwner
}

TargetHardwareUnresolvedReference: enum {
    RegisterBlock(block: String)
    Register(block: String, register: String)
    DMAChannel(channel: String)
    Interrupt(interrupt: String)
}

TargetHardwareFacts: struct {
    svd: SVDProvenance?
    register_blocks: [TargetRegisterBlockFact]
    interrupts: [TargetInterruptFact]
    dma_channels: [TargetDMAChannelFact]
}

TargetHardwareUse: struct {
    register_accesses: [TargetRegisterAccessFact]
    interrupt_handlers: [TargetInterruptHandlerFact]
    dma_operations: [TargetDMAOperationFact]
    unresolved_references: [TargetHardwareUnresolvedReference]
}

TargetProgrammerAdapter: enum { Emulator ProbeRs OpenOcd }

TargetProgrammerFacts: struct {
    adapter: TargetProgrammerAdapter
    executable: String
    chip: String?
    interface: String?
    config: [String]
    speed_khz: Int?
    reset: Bool
    machine: String?
    cpu: String?
}

LayoutSupportFacts: struct {
    proven: Bool
    alignments: [Int]
    max_size: Int?
    max_address: Int?
    abi: String?
    provenance: String
}

LayoutCapabilityFacts: struct {
    fact_version: String
    target_profile: String
    execution_modes: [String]
    backend: String
    toolchain: String
    linker: String
    allocator_provider: String
    type_representation: LayoutSupportFacts
    stack_placement: LayoutSupportFacts
    global_placement: LayoutSupportFacts
    heap_allocator: LayoutSupportFacts
    foreign_by_value_abi: LayoutSupportFacts
}

MemoryKind: enum { Flash Ram MMIO Reserved }

MemoryAccess: enum { R Rw Rx Rwx }

MemoryRegion: struct {
    name: String
    origin: Int
    size: ByteSize
    kind: MemoryKind
    access: MemoryAccess
}

LinkerInput: enum {
    HostedDefault
    Unspecified
    Generated
    File(path: String, sha256: String)
}

ProviderABI: struct { calling_convention: String, version: String }

ProviderLimits: struct {
    max_request_bytes: Int?
    max_response_bytes: Int?
    max_calls: Int?
}

ProviderContract: struct {
    provider: String
    sha256: String
    provenance: String
    abi: ProviderABI
    limits: ProviderLimits
}

AllocatorPolicy: enum {
    HostedDefault
    Unspecified
    NoAllocator
    Provider(provider: ProviderContract)
    Fixed(region: String, size: ByteSize)
    Counting(cap: ByteSize?)
}

PanicPolicy: enum {
    HostedDefault
    Unspecified
    Abort
    Report(provider: ProviderContract)
}

ClockPolicy: enum { HostedDefault Unspecified NoClock Provider(provider: ProviderContract) }

EntropyPolicy: enum { HostedDefault Unspecified NoEntropy Provider(provider: ProviderContract) }

SchedulerPolicy: enum {
    HostedDefault
    Unspecified
    NoScheduler
    Cooperative(provider: ProviderContract)
    InterruptDriven(provider: ProviderContract)
    BoardRuntime(provider: ProviderContract)
}

MMIOPolicy: enum { HostedDefault Unspecified NoMMIO Provider(provider: ProviderContract) }

ByteSinkPolicy: enum {
    HostedDefault
    Unspecified
    NoByteSink
    Provider(read: ProviderContract?, write: ProviderContract?, report: ProviderContract?)
}

StartupPolicy: enum {
    HostedDefault
    Unspecified
    Generated(provider: ProviderContract)
}

AuditPolicy: struct { build_artifact: Bool, dossier_lens: Bool }

TargetMachine: struct {
    name: String
    triple: String
    layout: LayoutCapabilityFacts
    no_os: Bool
    memory: [MemoryRegion]
    linker: LinkerInput
    allocator: AllocatorPolicy
    panic: PanicPolicy
    mmio: MMIOPolicy
    wall_clock: ClockPolicy
    monotonic_clock: ClockPolicy
    zone_data: ClockPolicy
    sleep: ClockPolicy
    entropy: EntropyPolicy
    scheduler: SchedulerPolicy
    byte_sink: ByteSinkPolicy
    startup: StartupPolicy
    startup_entry: String
    startup_vectors: String
    startup_abi: ProviderABI
    startup_placement: String
    hardware: TargetHardwareFacts
    programmers: [TargetProgrammerFacts]
    audit: AuditPolicy
}

RuntimeLayer: enum { Core Alloc Std }
