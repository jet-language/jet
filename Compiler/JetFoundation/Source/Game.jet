// Dependency-free game development swap facts shared by hosts and generated code.
// Hosts supply filesystem/build/world facts; this module never infers game meaning.
use core.files as game_files

// Rust: crates/jet-foundation/src/Game.rs:13
pub struct JetGameFrameBudget {
    remaining: I64?
    next_index: I64
    frame_in_flight: Bool
    // Rust: crates/jet-foundation/src/Game.rs:20
    pub fn default() -> JetGameFrameBudget Never! { JetGameFrameBudget.default_headless() }
    // Rust: crates/jet-foundation/src/Game.rs:26
    pub DEFAULT_HEADLESS_FRAMES :: I64{3}
    // Rust: crates/jet-foundation/src/Game.rs:27
    pub FRAME_BUDGET_ERROR :: "`game.run` frame budget must be positive"
    // Rust: crates/jet-foundation/src/Game.rs:29
    pub fn live() -> JetGameFrameBudget Never! {
        JetGameFrameBudget{remaining: None, next_index: I64{0}, frame_in_flight: false}
    }
    // Rust: crates/jet-foundation/src/Game.rs:37
    pub fn default_headless() -> JetGameFrameBudget Never! {
        JetGameFrameBudget{remaining: Val(JetGameFrameBudget.DEFAULT_HEADLESS_FRAMES), next_index: I64{0}, frame_in_flight: false}
    }
    // Rust: crates/jet-foundation/src/Game.rs:45
    pub fn validate(frames: I64) Err! {
        if frames <= I64{0} -> return Err(JetGameFrameBudget.FRAME_BUDGET_ERROR)
    }
    // Rust: crates/jet-foundation/src/Game.rs:53
    pub fn with_frame_count(frames: I64) -> JetGameFrameBudget Err! {
        JetGameFrameBudget.validate(frames)?
        JetGameFrameBudget{remaining: Val(frames), next_index: I64{0}, frame_in_flight: false}
    }
    // Rust: crates/jet-foundation/src/Game.rs:62
    pub fn set_requested(&self, frames: I64?) Err! {
        if frames == .Val(count) -> self = JetGameFrameBudget.with_frame_count(count)?
    }
    // Rust: crates/jet-foundation/src/Game.rs:69
    pub fn should_continue(self) -> Bool Never! {
        !self.frame_in_flight && (if self.remaining == { .Val(count) -> count > I64{0}, .None -> true })
    }
    // Rust: crates/jet-foundation/src/Game.rs:73
    pub fn next_frame(&self) -> I64? Never! {
        if !self.should_continue() -> return None
        self.frame_in_flight = true
        index :: self.next_index
        self.next_index = self.next_index.saturating_add(I64{1})
        Val(index)
    }
    // Rust: crates/jet-foundation/src/Game.rs:83
    pub fn present(&self) Never! {
        self.frame_in_flight = false
        if self.remaining == .Val(count) -> self.remaining = Val(count.saturating_sub(I64{1}))
    }
}
// Rust: crates/jet-foundation/src/Game.rs:93
pub struct JetGameTranscriptHasher {
    state: U64
    // Rust: crates/jet-foundation/src/Game.rs:98
    pub fn new() -> JetGameTranscriptHasher Never! {
        hasher := JetGameTranscriptHasher{state: U64{0xcbf29ce484222325}}
        &hasher.push_bytes("jet.game.transcript.v1".bytes())
        &hasher.push_bytes([U8]{U8{0}})
        ^hasher
    }
    // Rust: crates/jet-foundation/src/Game.rs:106
    fn push_bytes(&self, bytes: View<U8>) Never! {
        loop byte in bytes {
            self.state = (self.state ~| U64{byte}).wrapping_mul(U64{0x100000001b3})
        }
    }
    // Rust: crates/jet-foundation/src/Game.rs:113
    fn push_u64(&self, value: U64) Never! {
        // Fixed little-endian wire bytes, independent of selected target endian.
        loop shift in 0..<8 {
            byte :: U8{(value >> (shift * 8)) & U64{255}}
            self.state = (self.state ~| U64{byte}).wrapping_mul(U64{0x100000001b3})
        }
    }
    // Rust: crates/jet-foundation/src/Game.rs:117
    pub fn push_frame(&self, index: I64, input: View<String>) Never! {
        &self.push_bytes("frame".bytes())
        &self.push_bytes([U8]{U8{0}})
        &self.push_u64(index.to_bits())
        &self.push_u64(U64{input.len()})
        loop action in input {
            &self.push_u64(U64{action.bytes().len()})
            &self.push_bytes(action.bytes())
        }
    }
    // Rust: crates/jet-foundation/src/Game.rs:127
    pub fn finish(^self) -> String Never! {
        out := [U8].with_capacity(16)
        hex :: "0123456789abcdef".bytes()
        loop index in 0..<16 {
            &out.push(hex[Int{(self.state >> ((15 - index) * 4)) & U64{15}}])
        }
        String.from_bytes(^out) ?? panic("hexadecimal transcript hash is UTF-8")
    }
}
// Rust: crates/jet-foundation/src/Game.rs:135
pub JET_GAME_REPLAY_MAX_BYTES :: 2 * 1024 * 1024
// Rust: crates/jet-foundation/src/Game.rs:136
pub JET_GAME_REPLAY_MAX_FRAMES :: 65_536
// Rust: crates/jet-foundation/src/Game.rs:137
pub JET_GAME_REPLAY_MAX_ACTIONS_PER_FRAME :: 256
// Rust: crates/jet-foundation/src/Game.rs:138
pub JET_GAME_REPLAY_MAX_ACTION_BYTES :: 256
// Rust: crates/jet-foundation/src/Game.rs:141
pub struct JetGameReplayFrame { pub index: I64, pub actions: [String] }
// Rust: crates/jet-foundation/src/Game.rs:147
pub struct JetGameReplay {
    frames: [JetGameReplayFrame]
    // Rust: crates/jet-foundation/src/Game.rs:152
    pub fn from_path(path: String) -[FS.Read]> JetGameReplay Err! {
        trimmed := path.trim() // #4303
        if trimmed.is_empty() -> return Err("game replay path must not be empty")
        bytes :: if game_files.read_bytes(OSPath.from_text(path)) == {
            .Ok(value) -> value
            .Err(error) -> return Err("could not read game replay `{path}`: {error}")
        }
        if bytes.len() > JET_GAME_REPLAY_MAX_BYTES -> return Err("game replay exceeds the retained byte limit")
        source :: String.from_bytes(^bytes) ?? return Err("game replay must be UTF-8 text")
        frames := [JetGameReplayFrame]{}
        previous_index := I64?{None}
        loop (line_number, raw_line) in source.lines() {
            line := raw_line.trim() // #4303
            if line.is_empty() || (frames.is_empty() && line == "jet.game.replay.v1") -> next
            fields :: line.split_once("\t") ?? return Err("game replay line {line_number + 1} requires a tab separator")
            index :: fields.0.parse<I64>() ?? return Err("game replay line {line_number + 1} has an invalid frame index")
            if index < I64{0} || (if previous_index == { .Val(previous) -> index <= previous, .None -> false }) {
                return Err("game replay line {line_number + 1} frame indexes must be non-negative and increasing")
            }
            if frames.len() >= JET_GAME_REPLAY_MAX_FRAMES -> return Err("game replay exceeds the retained frame limit")
            actions := [String]{}
            raw_actions :: fields.1
            if raw_actions != "none" && !raw_actions.is_empty() {
                loop action in raw_actions.split(",") {
                    if actions.len() >= JET_GAME_REPLAY_MAX_ACTIONS_PER_FRAME -> return Err("game replay line {line_number + 1} exceeds the action limit")
                    invalid := action.is_empty() || action.bytes().len() > JET_GAME_REPLAY_MAX_ACTION_BYTES
                    // Rust char::is_control covers C0, DEL and Unicode C1, not only ASCII controls.
                    loop scalar in action.chars() {
                        if scalar.is_control() { invalid = true; break }
                    }
                    if invalid -> return Err("game replay line {line_number + 1} contains an invalid action")
                    &actions.push(action.to_string())
                }
            }
            &frames.push(JetGameReplayFrame{index: index, actions: ^actions})
            previous_index = Val(index)
        }
        JetGameReplay{frames: ^frames}
    }
    // Rust: crates/jet-foundation/src/Game.rs:215
    pub fn actions_at(self, index: I64) -> View<String>? Never! from self {
        low := 0
        high := self.frames.len()
        loop low < high {
            middle :: low + (high - low) / 2
            if self.frames[middle].index < index -> low = middle + 1
            else -> high = middle
        }
        if low < self.frames.len() && self.frames[low].index == index {
            return Val(self.frames[low].actions.view(0..<self.frames[low].actions.len()))
        }
        None
    }
}
