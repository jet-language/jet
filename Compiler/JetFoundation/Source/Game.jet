}
// Rust: crates/jet-foundation/src/Game.rs:260
pub enum JetGameSwapStatus {
    Applied, Rejected
    // Rust: crates/jet-foundation/src/Game.rs:266
    pub fn as_str(self) -> String Never! { if self == { .Applied -> "applied", .Rejected -> "rejected" } }
    // Rust: crates/jet-foundation/src/Game.rs:273
    pub fn is_applied(self) -> Bool Never! { self == JetGameSwapStatus.Applied }
}
// Rust: crates/jet-foundation/src/Game.rs:280
pub struct JetGameChangeFact {
    pub path: String
    pub kind: JetGameChangeKind
    pub old_schema_id: String?
    pub new_schema_id: String?
    pub migration: JetGameMigrationDecision
    pub reason: String
    // Rust: crates/jet-foundation/src/Game.rs:290
    pub fn new(path: ^String, kind: JetGameChangeKind, old_schema_id: ^String?, new_schema_id: ^String?, migration: JetGameMigrationDecision, reason: ^String) -> JetGameChangeFact Err! {
        fact :: JetGameChangeFact{path: ^path, kind: kind, old_schema_id: ^old_schema_id, new_schema_id: ^new_schema_id, migration: migration, reason: ^reason}
        fact.validate()?
        ^fact
    }
    // Rust: crates/jet-foundation/src/Game.rs:310
    pub fn validate(self) Err! {
        path := self.path.trim() // #4303
        if path.is_empty() -> return Err("game change fact path is empty")
        reason := self.reason.trim() // #4303
        if reason.is_empty() -> return Err("game change fact `{self.path}` has no checked reason")
        if self.old_schema_id == .Val(value) {
            trimmed := value.trim() // #4303
            if trimmed.is_empty() -> return Err("game change fact `old schema id` is empty")
        }
        if self.new_schema_id == .Val(value) {
            trimmed := value.trim() // #4303
            if trimmed.is_empty() -> return Err("game change fact `new schema id` is empty")
        }
        if self.migration == JetGameMigrationDecision.Migrate && (self.old_schema_id == None || self.new_schema_id == None) {
            return Err("game change fact `{self.path}` cannot migrate without old and new schema ids")
        }
        if self.migration == JetGameMigrationDecision.Reset && self.new_schema_id == None {
            return Err("game change fact `{self.path}` cannot reset without a new schema id")
        }
    }
    // Rust: crates/jet-foundation/src/Game.rs:347
    // Replace the checked verdict without re-deriving path or schema identity.
    pub fn with_migration(^self, migration: JetGameMigrationDecision, reason: ^String) -> JetGameChangeFact Err! {
        JetGameChangeFact.new(^self.path, self.kind, ^self.old_schema_id, ^self.new_schema_id, migration, ^reason)
    }
}
// Rust: crates/jet-foundation/src/Game.rs:365
pub struct JetGameSwapOutcome {
    pub sequence: U64
    pub fact: JetGameChangeFact
    pub status: JetGameSwapStatus
    // Rust: crates/jet-foundation/src/Game.rs:372
    pub fn is_applied(self) -> Bool Never! { self.status.is_applied() }
    // Rust: crates/jet-foundation/src/Game.rs:376
    pub fn kind(self) -> JetGameChangeKind Never! { self.fact.kind }
}
// Rust: crates/jet-foundation/src/Game.rs:383
pub struct JetGameSwapKernel {
    next_sequence: U64
    last_outcome: JetGameSwapOutcome?
    // Rust: crates/jet-foundation/src/Game.rs:389
    pub fn new() -> JetGameSwapKernel Never! { JetGameSwapKernel.default() }
    // Rust: crates/jet-foundation/src/Game.rs:382
    pub fn default() -> JetGameSwapKernel Never! { JetGameSwapKernel{next_sequence: U64{0}, last_outcome: None} }
    // Rust: crates/jet-foundation/src/Game.rs:393
    pub fn apply_asset_swap(&self, fact: ^JetGameChangeFact) -> JetGameSwapOutcome Err! { &self.apply(JetGameChangeKind.Asset, ^fact) }
    // Rust: crates/jet-foundation/src/Game.rs:400
    pub fn apply_script_reload(&self, fact: ^JetGameChangeFact) -> JetGameSwapOutcome Err! { &self.apply(JetGameChangeKind.Script, ^fact) }
    // Rust: crates/jet-foundation/src/Game.rs:407
    pub fn apply_world_reload(&self, fact: ^JetGameChangeFact) -> JetGameSwapOutcome Err! { &self.apply(JetGameChangeKind.World, ^fact) }
    // Rust: crates/jet-foundation/src/Game.rs:414
    pub fn last_outcome(self) -> (@JetGameSwapOutcome)? Never! from self {
        if self.last_outcome == .Val(outcome) -> return Val(@outcome)
        None
    }
    // Rust: crates/jet-foundation/src/Game.rs:418
    fn apply(&self, expected_kind: JetGameChangeKind, fact: ^JetGameChangeFact) -> JetGameSwapOutcome Err! {
        fact.validate()?
        if fact.kind != expected_kind -> return Err("game swap operation `{expected_kind.as_str()}` received `{fact.kind.as_str()}` fact")
        self.next_sequence = self.next_sequence.saturating_add(U64{1})
        status :: if fact.migration == JetGameMigrationDecision.Reject -> JetGameSwapStatus.Rejected else -> JetGameSwapStatus.Applied
        outcome :: JetGameSwapOutcome{sequence: self.next_sequence, fact: ^fact, status: status}
        self.last_outcome = Val(~outcome)
        ^outcome
    }
}
// Rust: crates/jet-foundation/src/Game.rs:450
// Generated code wraps this kernel rather than implementing a second decision path.
pub struct JetGameDevSession {
    pub swap_kernel: JetGameSwapKernel
    // Rust: crates/jet-foundation/src/Game.rs:455
    pub fn new() -> JetGameDevSession Never! { JetGameDevSession.default() }
    // Rust: crates/jet-foundation/src/Game.rs:449
    pub fn default() -> JetGameDevSession Never! { JetGameDevSession{swap_kernel: JetGameSwapKernel.default()} }
    // Rust: crates/jet-foundation/src/Game.rs:459
    pub fn apply_asset_swap(&self, fact: ^JetGameChangeFact) -> JetGameSwapOutcome Err! { &self.swap_kernel.apply_asset_swap(^fact) }
    // Rust: crates/jet-foundation/src/Game.rs:466
    pub fn apply_script_reload(&self, fact: ^JetGameChangeFact) -> JetGameSwapOutcome Err! { &self.swap_kernel.apply_script_reload(^fact) }
    // Rust: crates/jet-foundation/src/Game.rs:473
    pub fn apply_world_reload(&self, fact: ^JetGameChangeFact) -> JetGameSwapOutcome Err! { &self.swap_kernel.apply_world_reload(^fact) }
    // Rust: crates/jet-foundation/src/Game.rs:480
    pub fn last_outcome(self) -> (@JetGameSwapOutcome)? Never! from self { self.swap_kernel.last_outcome() }
}
