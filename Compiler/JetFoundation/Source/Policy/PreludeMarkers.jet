// The marker vocabulary: one struct with an `impl Marker` block per rule
// (crates/jet-foundation/src/Policy/MarkerSource.rs `MARKER_SOURCE`).
// A marker exists exactly when it is written here; every reader of the rule
// rows (parser, sema, `jet inspect`, `jet explain`) parses this one text.
MARKER_SOURCE :: comptime { ```// The marker vocabulary is written here, not in Rust.
//
// This is ordinary Jet source: each marker is a struct with an
// `impl Marker { … }` block. The compiler reads this file to build its
// registry, so a marker exists exactly when it is written here (law zero).
//
// A field is an argument the use site writes: `name: Type` with an optional
// `{default}`; a last list field with no default takes the remaining
// arguments. The `impl Marker` settings are facts about the rule itself:
//
//   sites        the attachment points the rule accepts, `[]` for none
//   repeatable   the rule may be written more than once on one target
//   owns_menu    the rule teaches its own argument menu in its own error
//   inherits     the rule takes part in lexical policy inheritance
//   resolution   how nested writings combine: .Override, .Merge, .Tighten
//   scopes       the policy scopes the rule may be written at
//   companion    `[Rule, .Site]` — one extra site a companion rule opens
//
// `sites` is the only public legal-site declaration form. Fields are typed
// use-site arguments; every setting is fixed declaration metadata.
//
struct Policy {
    settings: [PolicySetting]

    impl Marker {
        sites :: [.Package, .Module, .Function, .Method, .Block]
        inherits :: true
        resolution :: .Tighten
        scopes :: [.Package, .Module, .Function, .Block]
    }
}

struct Arithmetic {
    mode: ArithmeticMode

    impl Marker {
        sites :: [.Function, .Method, .Block]
    }
}

struct Unsafe {
    reason: String
    obligations: ObligationMode{.None}

    impl Marker {
        sites :: [.Function, .Method, .Block, .Operation]
    }
}

struct Scrub {
    tag: Ident

    impl Marker {
        sites :: [.Function, .Method]
    }
}

struct Memo {
    bound: MemoBound{.Default}

    impl Marker {
        sites :: [.Function, .Field]
    }
}

struct Pre {
    condition: Value
    message: String

    impl Marker {
        sites :: [.Function, .Method]
        repeatable :: true
    }
}

struct Post {
    condition: Value
    message: String

    impl Marker {
        sites :: [.Function, .Method]
        repeatable :: true
    }
}

// These rows stay separate. Kernel requests a checked
// worker-boundary proof; Inline(Always) is a checked promise, not a hint.
struct Kernel {
    mode: KernelMode

    impl Marker {
        sites :: [.Function]
    }
}

struct Inline {
    mode: InlineMode{.Hint}

    impl Marker {
        sites :: [.Function, .Method, .Constant]
    }
}

// Native auto-vectorization is the safe default; this explicit
// function/method marker keeps scalar codegen available for reproducibility or
// a workload whose measured result favors scalar execution.
struct Scalar {
    impl Marker {
        sites :: [.Function, .Method]
    }
}
