// The one covers rule for effects that name a scope (spec.md "Effect
// scopes"). An effect argument names a scope from Core's scope kinds: a
// folder (`FS.Read("templates/")`), a host (`Net("api.example.com")`) or a
// device (`GPU("npu")`). Rows, run grants (`--allow`) and denials all decide
// coverage here, from three fixed laws, so coverage is reflexive, transitive
// and always terminates:
// - an `FS` argument is a path; it covers by whole components after
//   normalization, so `templates/` covers `templates/home.html` but not
//   `templates2/`, and `templates/../secret.txt` is `secret.txt`;
// - a `Net` argument is a host; it covers by exact match after lower-casing,
//   so `api.example.com` never covers `evilapi.example.com`;
// - any other argument covers by equality.
// A bare effect (`FS.Read`) covers every scoped instance of itself and of its
// leaves. A scoped effect never covers the bare one.

// An effect name split at its scope argument: `FS.Read("templates/")` is
// `FS.Read` with scope `templates/`; a name with no quoted argument is bare.
EffectScopeName: struct {
    base: String
    scope: String?
}

effect_scope_split: fn(name: String) -> EffectScopeName Never! {
    trimmed: name.trim()
    if !trimmed.ends_with("\")") -> return EffectScopeName{base: trimmed.copy(), scope: None}
    parts: trimmed.split_once("(\"") ?? return EffectScopeName{base: trimmed.copy(), scope: None}
    inner: parts.after.slice(0..<parts.after.len() - 2)
    EffectScopeName{base: parts.before.trim().copy(), scope: Val(inner.copy())}
}

// The written spelling of `base` scoped to `scope`.
effect_scope_name: fn(base: String, scope: String) -> String Never! {
    "{base}(\"{scope}\")"
}

// Whether `name` carries a scope argument.
effect_scope_is_scoped: fn(name: String) -> Bool Never! {
    effect_scope_split(name).scope != None
}

// The bare effect `name` scopes (`FS.Read` for `FS.Read("assets/")`).
effect_scope_base: fn(name: String) -> String Never! {
    effect_scope_split(name).base
}

// A scope argument the laws accept: not empty, and free of the quote and
// backslash a written row could not spell back.
effect_scope_argument_valid: fn(scope: String) -> Bool Never! {
    if scope == "" -> return false
    loop byte in scope.bytes() {
        if byte == (U8{34}) || byte == (U8{92}) || byte < (U8{32}) -> return false
    }
    true
}

// The scope kind of an effect root: `path` for `FS`, `host` for `Net`, and
// `value` for every other root, whose arguments cover by equality.
effect_scope_kind: fn(base: String) -> String Never! {
    root: base.split(".").to_list()[0]
    if root == "FS" -> return "path"
    if root == "Net" -> return "host"
    "value"
}

// A path's components after normalization: `.` and empty components go, and
// `..` takes back the component before it. An absolute path starts with
// `/`; a `..` above the root stays at the root, and a `..` above a relative
// start is kept, so it never falls inside a relative scope.
effect_scope_path_parts: fn(path: String) -> [String] Never! {
    parts := [String]{}
    if path.starts_with("/") -> parts.push("/")
    loop segment in path.split("/") {
        if segment == "" || segment == "." -> next
        if segment == ".." {
            if parts.len() == 0 || parts[parts.len() - 1] == ".." {
                parts.push("..")
            } else if parts[parts.len() - 1] != "/" {
                _ := parts.pop()
            }
            next
        }
        parts.push(segment.copy())
    }
    parts
}

// The path law: `bound` covers `need` when its components are a prefix of
// the need's and the need does not climb past them with a kept `..` (`..`
// never covers `../..`, nor `.` covers `../a`).
effect_scope_path_covers: fn(bound: String, need: String) -> Bool Never! {
    held: effect_scope_path_parts(bound)
    asked: effect_scope_path_parts(need)
    if held.len() > asked.len() -> return false
    loop index in 0..<held.len() {
        if held[index] != asked[index] -> return false
    }
    held.len() == asked.len() || asked[held.len()] != ".."
}

// A host lower-cased, with the one trailing `.` of a fully qualified name
// dropped; any other byte, whitespace too, is part of the host, as the
// runtime's authority_host_covers reads it.
effect_scope_host: fn(host: String) -> String Never! {
    bytes := [U8]{}
    loop byte in host.bytes() {
        if byte >= (U8{65}) && byte <= (U8{90}) {
            bytes.push(byte + (U8{32}))
        } else {
            bytes.push(byte)
        }
    }
    if bytes.len() > 0 && bytes[bytes.len() - 1] == (U8{46}) -> _ := bytes.pop()
    String.from_bytes(bytes) ?? host.copy()
}

// The host law: exact match after lower-casing.
effect_scope_host_covers: fn(bound: String, need: String) -> Bool Never! {
    effect_scope_host(bound) == effect_scope_host(need)
}

// Whether the bare effect `bound` covers the bare effect `need`: itself and
// every leaf below it (`FS` covers `FS.Read`).
effect_scope_base_covers: fn(bound: String, need: String) -> Bool Never! {
    if bound == need -> return true
    need.starts_with("{bound}.")
}

// The covers rule: `bound` covers `need` when the bare names cover and, if
// `bound` names a scope, `need` names one its law covers.
effect_scope_covers: fn(bound: String, need: String) -> Bool Never! {
    if bound == need -> return true
    held: effect_scope_split(bound)
    asked: effect_scope_split(need)
    if !effect_scope_base_covers(held.base, asked.base) -> return false
    held_scope: held.scope ?? return true
    asked_scope: asked.scope ?? return false
    kind: effect_scope_kind(held.base)
    if kind == "path" -> return effect_scope_path_covers(held_scope, asked_scope)
    if kind == "host" -> return effect_scope_host_covers(held_scope, asked_scope)
    held_scope == asked_scope
}

// Core's scope publishers, read off their declarations: a top-level
// `core.files` function whose first parameter is `path`, the one path it
// touches, and whose row declares one leaf of a path effect (`FS.Read`,
// `FS.Write`) publishes that leaf; `core.http.get`, whose URL names the one
// host it reaches, publishes `Net`. A call with a constant argument needs the
// published effect scoped to that argument; any other call needs it bare.
// `callee_key` is a `kind:module:owner:name` symbol key, `path_first` whether
// the callee's first parameter is `path`, and `declared` its declared row.
effect_scope_published_effect: fn(callee_key: String, path_first: Bool, declared: [String]) -> String? Never! {
    if callee_key.ends_with(":<corelib>/core.http::get") -> return Val("Net")
    if !callee_key.contains(":<corelib>/core.files::") || !path_first || declared.len() != 1 -> return None
    leaf: declared[0]
    if effect_scope_kind(leaf) != "path" || !leaf.contains(".") || effect_scope_is_scoped(leaf) -> return None
    // copy: the caller keeps its declared row.
    Val(leaf.copy())
}

// The run-time effect-scope descriptor (FnBody.effect_scope) of function
// `name`, symbol key `key`, whose first parameter is `path` when
// `path_first`, from its written row `row` (None: no row). A Core scope
// publisher's is its marker, `@` and the effect it publishes. A closed row
// with a scoped `FS` or `Net` entry (an allow or a `!` denial) gives the
// name, then the row's `FS` and `Net` entries one per line, each spelled as
// effect_scope_name spells it and a denial keeping its `!`. Every other
// function has none (""): an open row (`..E`) has no closed ceiling, and
// a library effect's listed scopes stay static.
effect_scope_descriptor: fn(name: String, key: String, path_first: Bool, row: [String]?) -> String Never! {
    written_row: row ?? return ""
    allowed := [String]{}
    loop entry in written_row {
        if !entry.starts_with("!") && !entry.starts_with("..") -> allowed.push(entry.trim().copy())
    }
    if effect_scope_published_effect(key, path_first, allowed) == .Val(published) -> return "@{published}"
    entries := [String]{}
    scoped := false
    loop entry in written_row {
        if entry.starts_with("..") -> return ""
        denied: entry.starts_with("!")
        written: if denied -> entry.slice(1..<entry.len()) else -> entry
        split: effect_scope_split(written)
        if effect_scope_kind(split.base) == "value" -> next
        spelled := split.base.copy()
        if split.scope == .Val(scope) {
            scoped = true
            spelled = effect_scope_name(split.base, scope)
        }
        entries.push(if denied -> "!{spelled}" else -> spelled)
    }
    if !scoped -> return ""
    "{name}\n{entries.join("\n")}"
}

// The scope a publisher's argument names for `effect`, from the argument's
// constant text: all of it when `whole`, else the text before the first
// interpolation. A path scope is the whole path, or the folder the constant
// text ends in (`assets/` for `"assets/{name}"`); a host scope is the URL's
// host. None when the constant text names no scope.
effect_scope_of_argument: fn(published: String, text: String, whole: Bool) -> String? Never! {
    if effect_scope_kind(published) == "host" -> return effect_scope_url_host(text, whole)
    scope := text.copy()
    if !whole {
        folder: text.cut_last("/") ?? return None
        scope = "{folder.before}/"
    }
    if !effect_scope_argument_valid(scope) -> return None
    Val(scope)
}

// The host of a `scheme://host[:port][/path]` URL whose constant text
// reaches past the host, or None.
effect_scope_url_host: fn(text: String, whole: Bool) -> String? Never! {
    rest: (text.split_once("://") ?? return None).after
    bytes: rest.bytes()
    end := bytes.len()
    loop index in 0..<bytes.len() {
        code: Int.from_u8(bytes[index])
        if code == 64 -> return None
        if code == 47 || code == 58 || code == 63 || code == 35 {
            end = index
            break
        }
    }
    if end == bytes.len() && !whole -> return None
    host: String.from_bytes(bytes[0..<end]) ?? return None
    if !effect_scope_argument_valid(host) -> return None
    Val(host)
}
