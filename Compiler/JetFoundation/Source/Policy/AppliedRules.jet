enum TAppliedRuleArgKind { Any String Path Ident Bool Int DurationOrString EffectRoots }

struct TAppliedRuleParameter {
    name: String
    kind: TAppliedRuleArgKind
    source_type: String
    default_source: String?
}

struct TAppliedRuleSignature {
    params: [TAppliedRuleParameter]
    variadic: TAppliedRuleArgKind?
    variadic_source_type: String?
}

struct TAppliedRuleCompanionSite {
    rule: String
    site: String
}

struct TAppliedRule {
    name: String
    signature: TAppliedRuleSignature
    policy_scopes: [String]
    sites: [String]
    repeatable: Bool
    owns_menu: Bool
    companion_site: TAppliedRuleCompanionSite?
    inherits: Bool
    resolution: String
}

struct TAppliedRuleArgumentMenu {
    name: String
    variants: [String]
    first_variant_segment: Bool
}

struct TAppliedRuleCatalog {
    rows: [TAppliedRule]
    argument_menus: [TAppliedRuleArgumentMenu]
}
