TAppliedRuleArgKind: enum { Any String Path Ident Bool Int DurationOrString StringOrMenu EffectRoots }

TAppliedRuleParameter: struct {
    name: String
    kind: TAppliedRuleArgKind
    source_type: String
    default_source: String?
}

TAppliedRuleSignature: struct {
    params: [TAppliedRuleParameter]
    variadic: TAppliedRuleArgKind?
    variadic_source_type: String?
    // The field that takes the remaining arguments (a last list field).
    variadic_name: String?{None}
}

TAppliedRuleCompanionSite: struct {
    rule: String
    site: String
}

TAppliedRule: struct {
    name: String
    signature: TAppliedRuleSignature
    policy_scopes: [String]
    sites: [String]
    repeatable: Bool
    owns_menu: Bool
    companion_site: TAppliedRuleCompanionSite?
    inherits: Bool
    resolution: String
}

TAppliedRuleArgumentMenu: struct {
    name: String
    variants: [String]
    first_variant_segment: Bool
}

TAppliedRuleCatalog: struct {
    rows: [TAppliedRule]
    argument_menus: [TAppliedRuleArgumentMenu]
}
