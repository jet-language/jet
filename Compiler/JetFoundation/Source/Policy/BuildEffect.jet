// Build-effect view of the canonical Prelude effect table, ported from
// jet_foundation::BuildEffects. The build projection excludes runtime-only
// FFI, Browser, and Secret roots while keeping the public effect identities.

// Rust BuildEffect::ALL, in the generated Prelude table's declaration order.
pub BUILD_EFFECT_ALL :: prep { [BuildEffect]{
    BuildEffect.Net, BuildEffect.FS, BuildEffect.IO, BuildEffect.DB,
    BuildEffect.Time, BuildEffect.Rand, BuildEffect.Env, BuildEffect.Exec,
    BuildEffect.Log, BuildEffect.GPU
} }

pub enum BuildEffect {
    Net
    FS
    IO
    DB
    Time
    Rand
    Env
    Exec
    Log
    GPU

    pub fn name(self) -> String Never! {
        if self == {
            .Net -> "Net"
            .FS -> "FS"
            .IO -> "IO"
            .DB -> "DB"
            .Time -> "Time"
            .Rand -> "Rand"
            .Env -> "Env"
            .Exec -> "Exec"
            .Log -> "Log"
            .GPU -> "GPU"
        }
    }

    pub fn flag(self) -> String Never! {
        if self == {
            .Net -> "net"
            .FS -> "fs"
            .IO -> "io"
            .DB -> "db"
            .Time -> "time"
            .Rand -> "rand"
            .Env -> "env"
            .Exec -> "exec"
            .Log -> "log"
            .GPU -> "gpu"
        }
    }

    // A root effect name matched ASCII case-insensitively against the
    // canonical table; dotted leaves are not build effects.
    pub fn parse(value: String) -> BuildEffect? Never! {
        if value.contains(".") -> return None
        if value.to_ascii_lower() == {
            "net" -> Val(BuildEffect.Net)
            "fs" -> Val(BuildEffect.FS)
            "io" -> Val(BuildEffect.IO)
            "db" -> Val(BuildEffect.DB)
            "time" -> Val(BuildEffect.Time)
            "rand" -> Val(BuildEffect.Rand)
            "env" -> Val(BuildEffect.Env)
            "exec" -> Val(BuildEffect.Exec)
            "log" -> Val(BuildEffect.Log)
            "gpu" -> Val(BuildEffect.GPU)
            else -> None
        }
    }

    // Position in the canonical table, the order Rust's derived `Ord` uses.
    pub fn rank(self) -> Int Never! {
        if self == {
            .Net -> 0
            .FS -> 1
            .IO -> 2
            .DB -> 3
            .Time -> 4
            .Rand -> 5
            .Env -> 6
            .Exec -> 7
            .Log -> 8
            .GPU -> 9
        }
    }

    // The effects in canonical table order, keeping repeats.
    pub fn sorted(effects: [BuildEffect]) -> [BuildEffect] Never! {
        out := effects
        &out.sort_by(written -> written.rank())
        out
    }
}
