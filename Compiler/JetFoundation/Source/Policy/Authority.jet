// Ported from jet_foundation.Authority: one rights tree and one holds
// relation.
//
// A rights set (Rust `Holds`, a `BTreeSet<String>`) is a sorted,
// duplicate-free `[String]`; `authority_holds` builds one. Host-import facts
// need compiler types (checked facts, Diagnostic), so their owner lives in the
// PackageModel area (Authority/SandboxAuthority.jet); this file stays
// compiler-free.

// jet_foundation.Syntax.EFFECT_LEAF_EXEC_ARGS: reading the program's own
// arguments, a leaf of `Exec`. The `Exec` root also covers spawning processes.
AUTHORITY_EXEC_ARGS_LEAF: "Exec.Args"

// Ending the program's own process, a leaf of `Exec`.
AUTHORITY_EXEC_EXIT_LEAF: "Exec.Exit"

// Whether `right` is an `Exec` leaf that acts on the program's own process,
// reading its arguments or ending it, rather than starting other programs.
authority_own_process_leaf: fn(right: String) -> Bool Never! {
    right == AUTHORITY_EXEC_ARGS_LEAF || right == AUTHORITY_EXEC_EXIT_LEAF
}

// The beginner floor every program holds: print, allocate, and read
// arguments. Never the `Exec` root.
AUTHORITY_AMBIENT_BASIC_EFFECTS: #run { [String]{"IO", "Mem.Alloc", AUTHORITY_EXEC_ARGS_LEAF} }

// The deny-only stop root.
AUTHORITY_PANIC_ROOT: "Panic"

// jet_foundation.Syntax.EFFECT_LEAF_TIME_WAIT: waiting on the program's own
// work, a deny-only leaf.
AUTHORITY_TIME_WAIT_LEAF: "Time.Wait"

// The deny-only root of reaching `#Unsafe` code outside Core.
AUTHORITY_UNSAFE_ROOT: "Unsafe"

// jet_foundation.Authority.is_deny_only: `Panic`, the `Mem` root, the
// `Time.Wait` leaf and `Unsafe` (reaching `#Unsafe` code) may be refused but
// never have to be granted, so the application policy never asks for them or
// writes them into `allow:`.
authority_is_deny_only: fn(right: String) -> Bool Never! {
    root: authority_root(right)
    root == AUTHORITY_PANIC_ROOT || root == "Mem" || root == AUTHORITY_UNSAFE_ROOT || right == AUTHORITY_TIME_WAIT_LEAF
}

// The roots an application may grant: every root Prelude/Effects.jet declares
// but the deny-only ones, in vocabulary order.
authority_grantable_roots: fn() -> [String] Never! {
    roots := [String]{}
    loop root in EFFECT_VOCABULARY_ROOTS {
        if !authority_is_deny_only(root) -> roots.push(root)
    }
    roots
}

// One grant the native process boundary can enforce: the runtime's name for
// it, its spelling, whether `Authority.workspace()` holds it, and whether the
// root also enforces one program, `Exec("/usr/bin/git")`.
AuthorityProcessGrant: struct {
    name: String,
    right: String,
    workspace: Bool,
    program: Bool,
}

// The grants an authority-bound process may hold; it refuses any other before
// spawn. Tools/Agent/RuntimeGenerators.jet generates the runtime's grant
// check, its program scope and the workspace rights from these rows, one row
// per line.
AUTHORITY_PROCESS_GRANTS: [AuthorityProcessGrant]{
    AuthorityProcessGrant{name: "workspace_read", right: "FS.Read(\"repo\")", workspace: true, program: false},
    AuthorityProcessGrant{name: "workspace_write", right: "FS.Write(\".jet/build\")", workspace: true, program: false},
    AuthorityProcessGrant{name: "net", right: "Net", workspace: false, program: false},
    AuthorityProcessGrant{name: "exec", right: "Exec", workspace: false, program: true},
    AuthorityProcessGrant{name: "io", right: "IO", workspace: false, program: false},
    AuthorityProcessGrant{name: "time_wait", right: "Time.Wait", workspace: false, program: false},
}

// The one verdict every checkpoint answers.
AuthorityVerdict: enum {
    Allowed,
    Denied,
    Missing,
}

// A rights set: sorted with duplicates removed (Rust `Holds`).
authority_holds: fn(rights: [String]) -> [String] Never! {
    sorted := rights
    sorted.sort()
    out := [String]{}
    loop right in sorted {
        if out.contains(right) -> next
        out.push(right)
    }
    out
}

// Root segment of a dotted right (`FS.Read` -> `FS`), with any scope
// argument set aside (`Net("api.example.com")` -> `Net`).
authority_root: fn(right: String) -> String Never! {
    parts: effect_scope_base(right).split(".").to_list()
    if parts.len() == 0 -> return right.copy()
    parts[0]
}

// ASCII-only lowercase, for the case-insensitive root table.
authority_ascii_lower: fn(value: String) -> String Never! {
    out := [U8]{}
    loop byte in value.bytes() {
        code: Int{byte}
        out.push(if code >= 65 && code <= 90 -> U8{code + 32} else -> byte)
    }
    String.from_bytes(out) ?? value
}

// Resolve one root, without regard to ASCII case, against the roots
// Prelude/Effects.jet declares. Dotted input is accepted only for its root;
// leaf declaration remains sema's job.
authority_parse_root: fn(right: String) -> String? Never! {
    folded: authority_ascii_lower(authority_root(right))
    loop known in EFFECT_VOCABULARY_ROOTS {
        if authority_ascii_lower(known) == folded -> return Val(known)
    }
    None
}

// Preserve a right's leaf spelling and scope argument while normalizing its
// canonical root.
authority_parse_right: fn(right: String) -> String? Never! {
    // #4303: Main-approved host-emitter binding workaround; bind `trimmed:` once the emitter is fixed.
    trimmed := right.trim()
    split: effect_scope_split(trimmed)
    root: authority_parse_root(split.base) ?? return None
    if root == AUTHORITY_PANIC_ROOT && trimmed != AUTHORITY_PANIC_ROOT -> return None
    canonical := root.copy()
    raw: split.base.bytes()
    loop index in 0..<raw.len() {
        if (Int{raw[index]}) == 46 {
            leaf: String.from_bytes(raw[index + 1..<raw.len()]) ?? ""
            canonical = "{root}.{leaf}"
            break
        }
    }
    if split.scope == .Val(scope) -> return Val(effect_scope_name(canonical, scope))
    Val(canonical)
}

// A bound covers itself and every descendant in the rights tree, and a
// scoped bound covers by its scope's law (EffectScope.jet): `/data` covers
// `/data/a.txt` but not `/database`.
authority_covers: fn(bound: String, right: String) -> Bool Never! {
    canonical_bound: authority_parse_right(bound) ?? bound.trim()
    canonical_right: authority_parse_right(right) ?? right.trim()
    if canonical_right == canonical_bound -> return true
    effect_scope_covers(canonical_bound, canonical_right)
}

authority_covers_any: fn(bounds: [String], right: String) -> Bool Never! {
    loop bound in bounds {
        if authority_covers(bound, right) -> return true
    }
    false
}

authority_answer: fn(held: [String], denied: [String], right: String) -> AuthorityVerdict Never! {
    if authority_covers_any(denied, right) -> return AuthorityVerdict.Denied
    if authority_covers_any(held, right) -> return AuthorityVerdict.Allowed
    AuthorityVerdict.Missing
}

// Whether `right` is an expert effect: its own vocabulary row, or a row
// above it, says `expert` (`Meta.Code.Raw` under `Meta.Code`). No package
// holds an expert effect until the main package names it.
authority_expert: fn(right: String) -> Bool Never! {
    canonical: effect_scope_base(authority_parse_right(right) ?? right.trim())
    loop row in EFFECT_VOCABULARY_ROWS {
        if row.expert && (row.name == canonical || canonical.starts_with("{row.name}.")) {
            return true
        }
    }
    false
}

// Whether `rights` names expert entries and nothing else. An expert entry
// only holds expert effects (authority_expert_answer), so an `allow` row or
// a grant line of nothing else sets no ceiling, and every other effect stays
// held unless denied.
authority_expert_only: fn(rights: [String]) -> Bool Never! {
    loop right in rights {
        if !authority_expert(right) -> return false
    }
    rights.len() > 0
}

// The verdict on the expert effect `right` for a package that names the
// entries `held` (the main package's `allow` row, or the main package's
// `authority.grants` line for a dependency); `denied` says whether a `deny`
// row that binds the package covers it, and deny wins. An entry holds an
// expert effect only when the entry is itself expert: `allow: [Meta]` holds
// none of `Meta.Code`'s leaves, while `allow: [Meta.Code]` holds all three.
authority_expert_answer: fn(held: [String], denied: Bool, right: String) -> AuthorityVerdict Never! {
    if denied -> return AuthorityVerdict.Denied
    loop bound in held {
        if authority_expert(bound) && authority_covers(bound, right) {
            return AuthorityVerdict.Allowed
        }
    }
    AuthorityVerdict.Missing
}

// The expert effects a named entry that is not itself expert leaves out:
// each topmost expert row under it (`Meta.Code` and `Meta.Host` under
// `Meta`); none for an expert entry.
authority_expert_left_out: fn(bound: String) -> [String] Never! {
    if authority_expert(bound) -> return [String]{}
    canonical: effect_scope_base(authority_parse_right(bound) ?? bound.trim())
    out := [String]{}
    loop row in EFFECT_VOCABULARY_ROWS {
        if !row.expert || !row.name.starts_with("{canonical}.") -> next
        topmost := true
        loop above in out {
            if row.name.starts_with("{above}.") -> topmost = false
        }
        if topmost -> out.push(row.name)
    }
    out
}

// Rights in `used` not covered by any held right.
authority_uncovered: fn(used: [String], held: [String]) -> [String] Never! {
    out := [String]{}
    loop right in used {
        if !authority_covers_any(held, right) -> out.push(right.copy())
    }
    authority_holds(out)
}

// A requested scope that would widen its parent authority.
#Error
AuthorityTightenError: struct {
    uncovered: [String],

    message: fn(self) -> String Never! {
        "authority scope widens its parent for `{self.uncovered.join(", ")}`"
    }
}

// The canonical authority value (Rust `Authority`) projected to runtime
// adapters. Sandbox wrappers must not keep a second grant set.
// Shared consumers use this same public constructor and read-only holds field.
CanonicalAuthority: struct {
    holds: [String],

    // Unknown spellings are retained for the caller's diagnostic; policy
    // checks still fail closed because no known hold covers them.
    from_rights: fn(rights: [String]) -> CanonicalAuthority Never! {
        holds := [String]{}
        loop right in rights -> holds.push(authority_parse_right(right) ?? right)
        CanonicalAuthority{holds: authority_holds(holds)}
    }

    from_holds: fn(holds: [String]) -> CanonicalAuthority Never! {
        CanonicalAuthority{holds: authority_holds(holds)}
    }

    allows: fn(self, right: String) -> Bool Never! { authority_covers_any(self.holds, right) }

    // True when this authority can satisfy a host operation declaring
    // `right`; a scoped hold (`FS.Read("/data")`) also satisfies the bare
    // operation (`FS.Read`), bounded by the held scope.
    allows_operation: fn(self, right: String) -> Bool Never! {
        if self.allows(right) -> return true
        loop held in self.holds {
            if authority_covers(right, held) -> return true
        }
        false
    }

    // A child authority, only when every requested right is covered here.
    tighten: fn(self, requested: [String]) -> CanonicalAuthority AuthorityTightenError! {
        uncovered: authority_uncovered(requested, self.holds)
        if uncovered.len() > 0 -> return Err(AuthorityTightenError{uncovered: uncovered})
        Ok(CanonicalAuthority.from_holds(requested))
    }
}

// Plain words for what a program does when it uses `right`
// (jet_foundation.Authority.effect_action). Unlisted leaves fall back to
// their root's words.
authority_effect_action: fn(right: String) -> String Never! {
    canonical: authority_parse_right(right) ?? right
    if canonical == {
        "FS.Read" -> return "reads files"
        "FS.Write" -> return "writes files"
        "Exec.Exit" -> return "ends its own process"
        "Time.Wait" -> return "waits"
        "Mem.Alloc" -> return "allocates memory"
        "DB.Read" -> return "reads a database"
        "DB.Write" -> return "writes a database"
        "Rand.Draw" -> return "draws random numbers"
        else -> {}
    }
    if canonical == AUTHORITY_EXEC_ARGS_LEAF -> return "reads its arguments"
    if authority_root(canonical) == {
        "IO" -> "prints text or reads input"
        "FS" -> "reads and writes files"
        "Net" -> "uses the network"
        "Exec" -> "starts other programs"
        "Env" -> "reads environment variables"
        "Time" -> "reads the clock"
        "Rand" -> "draws random numbers"
        "DB" -> "uses a database"
        "Log" -> "writes logs"
        "GPU" -> "uses the GPU"
        "FFI" -> "calls foreign code"
        "Browser" -> "uses browser APIs"
        "Secret" -> "reads secrets"
        "Mem" -> "allocates memory"
        "Panic" -> "can stop with a panic"
        "Unsafe" -> "reaches `#Unsafe` code"
        else -> "uses an undeclared authority"
    }
}

// The canonical spellings of `names`, dropping unknown ones; a package
// effect root (authority_package_effect) keeps its written spelling.
authority_parse_rights: fn(names: [String]) -> [String] Never! {
    out := [String]{}
    loop name in names {
        if authority_package_effect(name) {
            out.push(name.trim())
            next
        }
        parsed: authority_parse_right(name) ?? next
        out.push(parsed)
    }
    authority_holds(out)
}

// Whether `right` names a package effect root as a manifest writes one
// (`ledger.Ledger`): a dependency's manifest name, then the PascalCase name of
// an effect that dependency declares, with no case or scope. A first segment
// that names a vocabulary root (`net.Connect`) keeps naming that root.
authority_package_effect: fn(right: String) -> Bool Never! {
    split: right.trim().cut_last(".") ?? return false
    if split.before.contains(".") || authority_parse_root(split.before) != None -> return false
    authority_identifier_from(split.before, 97, 122) && authority_identifier_from(split.after, 65, 90)
}

// Whether `text` is an ASCII identifier whose first byte lies in
// `first_low...first_high` (`a`-`z` is 97...122, `A`-`Z` 65...90).
authority_identifier_from: fn(text: String, first_low: Int, first_high: Int) -> Bool Never! {
    raw: text.bytes()
    if raw.len() == 0 -> return false
    loop index in 0..<raw.len() {
        byte: Int{raw[index]}
        if index == 0 && (byte < first_low || byte > first_high) -> return false
        letter: (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90)
        if !letter && (byte < 48 || byte > 57) && byte != 95 -> return false
    }
    true
}
