// Invocation gates are transport, not a second policy resolver.

struct GateSet {
    allowed: [PolicyKey]{[PolicyKey]{}}
    build_flag: Bool{false}
    session_flag: Bool{false}
}

fn policy_gate_allows(gates: GateSet, key: PolicyKey) -> Bool Never! {
    if !gates.allowed.contains(key) -> return false
    if policy_resolve(key, [policy_invocation_declaration(key)]) == {
        .Ok(_) -> true
        .Err(_) -> false
    }
}

fn policy_gate_set_is_empty(gates: GateSet) -> Bool Never! {
    gates.allowed.is_empty()
}

#Error
struct PolicyGateParseError { message: String }

// One `--gate name=allow` argument: the audited gate it opens.
fn policy_gate_parse(spec: String) -> PolicyKey PolicyGateParseError! {
    raw :: spec.bytes()
    split := -1
    loop (index, byte) in raw {
        if Int.from_u8(byte) == 61 {
            split = index
            break
        }
    }
    if split < 0 -> return Err(PolicyGateParseError{message: "use `--gate name=allow`"})
    name :: (String.from_bytes(raw[0..<split]) ?? "").trim()
    value :: (String.from_bytes(raw[split + 1..<raw.len()]) ?? "").trim()
    key :: policy_key_parse(name) ?? return Err(PolicyGateParseError{message: "`{name}` is not an audited gate"})
    if !policy_key_is_audited_gate(key) || value != "allow" -> return Err(PolicyGateParseError{message: "`--gate {spec}` must name an audited gate with `=allow`"})
    if policy_resolve(key, [PolicyDeclaration]{policy_invocation_declaration(key)}) == {
        .Ok(_) -> {}
        .Err(error) -> return Err(PolicyGateParseError{message: "invalid gate `{spec}`: {error:Debug}"})
    }
    Ok(key)
}

fn policy_invocation_declaration(key: PolicyKey) -> PolicyDeclaration Never! {
    PolicyDeclaration{key: key, value: PolicyValue.Allow, scope: PolicyScope.Block, span: Span{start: 0, end: 0}, target: None, source: "<invocation>"}
}

fn policy_resolve_with_gates(key: PolicyKey, declarations: [PolicyDeclaration], gates: GateSet) -> EffectivePolicy? PolicyError! {
    effective :: policy_resolve(key, declarations)
    if gates.allowed.contains(key) {
        chain := declarations
        &chain.push(policy_invocation_declaration(key))
        _ :: policy_resolve(key, chain)
    }
    Ok(effective)
}

fn policy_default_gate_value(key: PolicyKey) -> PolicyValue Never! {
    if key == PolicyKey.Unsafe -> return PolicyValue.Default
    if policy_key_is_audited_gate(key) -> return PolicyValue.GateOnly
    if key == PolicyKey.Sentries -> return PolicyValue.On
    PolicyValue.Enabled
}
