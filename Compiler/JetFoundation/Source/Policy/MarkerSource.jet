// D-META-ONE1=A: the marker vocabulary comes from Prelude Jet declarations.
// This reader sits below the parser; parser agreement is checked separately.
use jet_foundation.Syntax
use jet_foundation.AST.RuleSite
use jet_foundation.Policy.AppliedRules.[TAppliedRule as AppliedRule, TAppliedRuleParameter as RuleParam, TAppliedRuleSignature as RuleSignature, TAppliedRuleArgKind as RuleArgType, TAppliedRuleStatus as RuleStatus, TAppliedRuleCompanionSite as CompanionSite, rule_site_name]

// Rust: crates/jet-foundation/src/Policy/MarkerSource.rs:20
pub const MARKER_SOURCE: String = #Embed("../../../../crates/jet-codegen/src/Prelude/Markers.jet")

// Rust: crates/jet-foundation/src/Policy/MarkerSource.rs:22
// Malformed bundled declarations are compiler bugs, not partial registries.
pub fn read() -> [AppliedRule] {
    MARKER_SOURCE.lines().map(line -> line.trim()).filter(line -> line.starts_with("marker ")).map(declaration).collect()
}

// Rust: crates/jet-foundation/src/Policy/MarkerSource.rs:35
fn declaration(line: String) -> AppliedRule {
    rest := line["marker ".len()..].trim() // #4303
    open :: rest.find('(') ?? panic("marker declaration without a parameter list: {line}")
    close :: rest.rfind(')') ?? panic("marker declaration without a closing `)`: {line}")
    name :: leak(rest[..open].trim())
    params := [RuleParam]{}
    variadic := (RuleArgType, String)?{None}
    sites := [String]{}
    scopes := [String]{}
    repeatable := false
    owns_menu := false
    inherits := false
    resolution := "SiteBound"
    companion_site := CompanionSite?{None}
    status := RuleStatus.Active
    loop entry in split_top_level(rest[open + 1..close]) {
        (raw_label, raw_value) :: entry.split_once(':') ?? panic("marker parameter without `:` in {line}: {entry}")
        label := raw_label.trim() // #4303
        value := raw_value.trim() // #4303
        if label.strip_prefix(Syntax.COMPTIME_MARK) == .Val(fact) {
            if fact == {
                "sites" -> sites = list(value).map(item -> site(item, line))
                "scopes" -> scopes = list(value).map(item -> scope(item, line))
                "repeatable" -> repeatable = flag(value, line)
                "owns_menu" -> owns_menu = flag(value, line)
                "inherits" -> inherits = flag(value, line)
                "resolution" -> resolution = rule_resolution(value, line)
                "companion" -> {
                    parts :: list(value)
                    assert(parts.len() == 2, "`$companion` reads `[Rule, .Site]` in {line}")
                    companion_site = Val(CompanionSite{rule: leak(parts[0]), site: site(parts[1], line)})
                }
                "retired" -> status = RuleStatus.Retired(leak(unquote(value, line)))
                other -> panic("unknown marker fact `${other}` in {line}")
            }
            next
        }
        (type_text, default) :: if split_default(value) == .Val((type_text, default)) -> (type_text, Val(leak(default))) else -> (value, None)
        if type_text.strip_prefix("...") == .Val(raw_element) {
            element := raw_element.trim() // #4303
            variadic = Val((arg_type(element), leak(element)))
            next
        }
        &params.push(RuleParam{name: leak(label), kind: arg_type(type_text), source_type: leak(type_text), default_source: default})
    }
    AppliedRule{
        name: name,
        signature: RuleSignature{params: leak_slice(^params), variadic: variadic.map(pair -> pair.0), variadic_source_type: variadic.map(pair -> pair.1)},
        policy_scopes: leak_slice(^scopes), sites: leak_slice(^sites),
        repeatable: repeatable, owns_menu: owns_menu, companion_site: companion_site,
        status: status, inherits: inherits, resolution: resolution
    }
}

// Rust: crates/jet-foundation/src/Policy/MarkerSource.rs:125
// Closed menu names bind as identifiers; PolicySetting binds as a free value.
fn arg_type(source_type: String) -> RuleArgType {
    if source_type == {
        "Value" | "PolicySetting" -> .Any
        "String" -> .String
        "Path" -> .Path
        "Ident" -> .Ident
        "Bool" -> .Bool
        "Int" -> .Int
        "Duration | String" -> .DurationOrString
        "[Effect]" -> .EffectRoots
        else -> .Ident
    }
}

// Rust: crates/jet-foundation/src/Policy/MarkerSource.rs:147
// Split Type{default}, ignoring braces inside strings and nested values.
pub fn split_default(value: String) -> (String, String)? {
    bytes :: value.as_bytes()
    scan := Scan.new()
    loop (index, byte) in bytes.enumerate() {
        if scan.depth == 0 && !scan.in_string && byte == 123 {
            default_scan := Scan.new()
            loop (relative_end, inner_byte) in bytes[index..].enumerate() {
                _ :: default_scan.step(inner_byte)
                if inner_byte == 125 && default_scan.depth == 0 && !default_scan.in_string {
                    end :: index + relative_end
                    suffix := value[end + 1..].trim() // #4303
                    if suffix.is_empty() {
                        type_text := value[..index].trim() // #4303
                        default := value[index + 1..end].trim() // #4303
                        return Val((type_text, default))
                    }
                    break
                }
            }
            break
        }
        _ :: scan.step(byte)
    }
    None
}

// Rust: crates/jet-foundation/src/Policy/MarkerSource.rs:172
// Comma-separated entries outside nesting and string literals.
pub fn split_top_level(text: String) -> [String] {
    entries := [String]{}
    start := 0
    scan := Scan.new()
    loop (index, byte) in text.as_bytes().enumerate() {
        if scan.step(byte) && byte == 44 {
            entry := text[start..index].trim() // #4303
            &entries.push(entry)
            start = index + 1
        }
    }
    last := text[start..].trim() // #4303
    if !last.is_empty() -> &entries.push(last)
    entries
}

// Rust: crates/jet-foundation/src/Policy/MarkerSource.rs:190
struct Scan {
    depth: Int
    in_string: Bool
    escaped: Bool

    // Rust: crates/jet-foundation/src/Policy/MarkerSource.rs:199
    fn new() -> Scan { Scan{depth: 0, in_string: false, escaped: false} }

    // Rust: crates/jet-foundation/src/Policy/MarkerSource.rs:207
    fn step(self: &Scan, byte: UInt8) -> Bool {
        if self.in_string {
            if self.escaped -> self.escaped = false
            else if byte == 92 -> self.escaped = true
            else if byte == 34 -> self.in_string = false
            return false
        }
        if byte == {
            34 -> { self.in_string = true; false }
            91 | 40 | 123 -> { self.depth += 1; false }
            93 | 41 | 125 -> { self.depth -= 1; false }
            else -> self.depth == 0
        }
    }
}

// Rust: crates/jet-foundation/src/Policy/MarkerSource.rs:237
fn list(value: String) -> [String] {
    inner :: value.strip_prefix('[').and_then(rest -> rest.strip_suffix(']')) ?? panic("expected a `[…]` list, found `{value}`")
    split_top_level(inner)
}

// Rust: crates/jet-foundation/src/Policy/MarkerSource.rs:246
fn flag(value: String, line: String) -> Bool {
    if value == {
        "true" -> true
        "false" -> false
        other -> panic("a marker fact reads `true` or `false`, found `{other}` in {line}")
    }
}

// Rust: crates/jet-foundation/src/Policy/MarkerSource.rs:257
fn unquote(value: String, line: String) -> String {
    inner :: value.strip_prefix('"').and_then(rest -> rest.strip_suffix('"')) ?? panic("expected a quoted value, found `{value}` in {line}")
    out := String.with_capacity(inner.len())
    escaped := false
    loop character in inner.chars() {
        if escaped { &out.push(character); escaped = false }
        else if character == '\\' -> escaped = true
        else -> &out.push(character)
    }
    out
}

// Rust: crates/jet-foundation/src/Policy/MarkerSource.rs:277
// Retained catalog stores site names; AST RuleSite is the vocabulary owner.
fn site(written: String, line: String) -> String {
    name :: written.strip_prefix('.') ?? written
    all :: [RuleSite.Package, .File, .Module, .Function, .Method, .Block, .Statement, .Expression, .Type, .Impl, .Declaration, .Constant, .Field, .Variant, .Parameter, .Test, .Operation, .Text]
    found :: all.find(candidate -> rule_site_name(candidate) == name) ?? panic("`{written}` is not a marker site, in {line}")
    rule_site_name(found)
}

// Rust: crates/jet-foundation/src/Policy/MarkerSource.rs:285
fn scope(written: String, line: String) -> String {
    name :: written.strip_prefix('.') ?? written
    if name == {
        "Organization" | "Package" | "Module" | "Function" | "Block" -> name
        other -> panic("`{other}` is not a policy scope, in {line}")
    }
}

// Rust: crates/jet-foundation/src/Policy/MarkerSource.rs:296
fn rule_resolution(written: String, line: String) -> String {
    name :: written.strip_prefix('.') ?? written
    if name == {
        "SiteBound" | "Override" | "Merge" | "Tighten" -> name
        other -> panic("`{other}` is not a resolution, in {line}")
    }
}

// Rust: crates/jet-foundation/src/Policy/MarkerSource.rs:306
// Jet rows own their text; ownership replaces Rust's leaked static lifetimes.
fn leak(text: String) -> String { ^text }

// Rust: crates/jet-foundation/src/Policy/MarkerSource.rs:312
fn leak_slice<T>(items: [T]) -> [T] { ^items }
