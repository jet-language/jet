// The marker registry is read from Prelude Jet source
// (crates/jet-foundation/src/Policy/MarkerSource.rs). `Prelude/Markers.jet`
// declares each rule as a marker type: `struct Name { fields  impl Marker {
// settings } }`. This reader accepts that one shape and nothing else; a
// malformed row is a bug in a file that ships with the compiler, so it panics
// with the offending declaration.

// `RuleSite::ALL` names, in order.
MARKER_SOURCE_SITES :: [String]{
    "Package", "File", "Module", "Function", "Method", "Block", "Statement", "Expression", "Type",
    "Impl", "Trait", "Declaration", "Constant", "Field", "Variant", "Parameter", "Test", "Operation", "Text",
}

MARKER_SOURCE_SCOPES :: [String]{"Organization", "Package", "Module", "Function", "Block"}

MARKER_SOURCE_RESOLUTIONS :: [String]{"SiteBound", "Override", "Merge", "Tighten"}

// Tracks bracket depth and string literals so a separator inside either is
// never mistaken for a top-level one.
struct MarkerSourceScan {
    depth: Int
    in_string: Bool
    escaped: Bool
}

// `Type{default}` split on its outer braces.
struct MarkerSourceDefault {
    type_text: String
    default: String
}

fn marker_source_slice(text: String, start: Int, end: Int) -> String Never! {
    bytes :: text.bytes()
    if start >= end -> return ""
    String.from_bytes(bytes[start..<end]) ?? ""
}

// True when this byte sits at top level and outside a string.
fn marker_source_scan_step(scan: &MarkerSourceScan, byte: Int) -> Bool Never! {
    if scan.in_string {
        if {
            scan.escaped -> scan.escaped = false
            byte == 92 -> scan.escaped = true
            byte == 34 -> scan.in_string = false
            else -> {}
        }
        return false
    }
    if {
        byte == 34 -> {
            scan.in_string = true
            return false
        }
        byte == 91 || byte == 40 || byte == 123 -> {
            scan.depth += 1
            return false
        }
        byte == 93 || byte == 41 || byte == 125 -> {
            scan.depth -= 1
            return false
        }
        else -> {}
    }
    scan.depth == 0
}

// Comma-separated entries at nesting depth zero, outside string literals.
fn marker_source_split_top_level(text: String) -> [String] Never! {
    entries := [String]{}
    start := 0
    scan := MarkerSourceScan{depth: 0, in_string: false, escaped: false}
    loop (index, byte) in text.bytes() {
        value :: Int.from_u8(byte)
        if marker_source_scan_step(&scan, value) && value == 44 {
            &entries.push(marker_source_slice(text, start, index).trim())
            start = index + 1
        }
    }
    last :: marker_source_slice(text, start, text.len()).trim()
    if last.len() > 0 -> &entries.push(last)
    entries
}

// Split `Type{default}` on its outer braces. Braces inside the default belong
// to the value, as do commas and braces inside strings.
fn marker_source_split_default(value: String) -> MarkerSourceDefault? Never! {
    bytes :: value.bytes()
    scan := MarkerSourceScan{depth: 0, in_string: false, escaped: false}
    loop (index, byte) in bytes {
        current :: Int.from_u8(byte)
        if scan.depth == 0 && !scan.in_string && current == 123 {
            default_scan := MarkerSourceScan{depth: 0, in_string: false, escaped: false}
            loop end in index..<bytes.len() {
                inner :: Int.from_u8(bytes[end])
                marker_source_scan_step(&default_scan, inner)
                if inner == 125 && default_scan.depth == 0 && !default_scan.in_string {
                    if marker_source_slice(value, end + 1, bytes.len()).trim().len() == 0 {
                        return Val(MarkerSourceDefault{
                            type_text: marker_source_slice(value, 0, index).trim(),
                            default: marker_source_slice(value, index + 1, end).trim(),
                        })
                    }
                    break
                }
            }
            break
        }
        marker_source_scan_step(&scan, current)
    }
    None
}

// The entries of a `[…]` value.
fn marker_source_list(value: String) -> [String] Never! {
    if !value.starts_with("[") || !value.ends_with("]") || value.len() < 2 -> panic("expected a `[…]` list, found `{value}`")
    marker_source_split_top_level(marker_source_slice(value, 1, value.len() - 1))
}

fn marker_source_flag(value: String, line: String) -> Bool Never! {
    if value == {
        "true" -> return true
        "false" -> return false
        else -> panic("a marker fact reads `true` or `false`, found `{value}` in {line}")
    }
}

fn marker_source_unquote(value: String, line: String) -> String Never! {
    if !value.starts_with("\"") || !value.ends_with("\"") || value.len() < 2 -> panic("expected a quoted value, found `{value}` in {line}")
    inner :: marker_source_slice(value, 1, value.len() - 1).bytes()
    out := [U8]{}
    escaped := false
    loop byte in inner {
        if escaped {
            &out.push(byte)
            escaped = false
            next
        }
        if Int.from_u8(byte) == 92 {
            escaped = true
            next
        }
        &out.push(byte)
    }
    String.from_bytes(out) ?? panic("a marker fact quote is not UTF-8 in {line}")
}

fn marker_source_unprefixed(written: String) -> String Never! {
    if written.starts_with(".") -> return marker_source_slice(written, 1, written.len())
    written.copy()
}

fn marker_source_site(written: String, line: String) -> String Never! {
    name :: marker_source_unprefixed(written)
    if !MARKER_SOURCE_SITES.contains(name) -> panic("`{written}` is not a marker site, in {line}")
    name
}

fn marker_source_scope(written: String, line: String) -> String Never! {
    name :: marker_source_unprefixed(written)
    if !MARKER_SOURCE_SCOPES.contains(name) -> panic("`{name}` is not a policy scope, in {line}")
    name
}

fn marker_source_resolution(written: String, line: String) -> String Never! {
    name :: marker_source_unprefixed(written)
    if !MARKER_SOURCE_RESOLUTIONS.contains(name) -> panic("`{name}` is not a resolution, in {line}")
    name
}

// A written parameter type names a typed argument shape
// or a closed `core.compiler.lang` menu, read as an identifier from it.
// `PolicySetting` entries are `key = value`, so it binds as a free value.
fn marker_source_arg_type(source_type: String) -> TAppliedRuleArgKind Never! {
    if source_type == {
        "Value" | "PolicySetting" -> TAppliedRuleArgKind.Any
        "String" -> TAppliedRuleArgKind.String
        "Path" -> TAppliedRuleArgKind.Path
        "Ident" -> TAppliedRuleArgKind.Ident
        "Bool" -> TAppliedRuleArgKind.Bool
        "Int" -> TAppliedRuleArgKind.Int
        "Duration | String" -> TAppliedRuleArgKind.DurationOrString
        "[Effect]" -> TAppliedRuleArgKind.EffectRoots
        else -> TAppliedRuleArgKind.Ident
    }
}

fn marker_source_byte_index(text: String, byte: Int) -> Int? Never! {
    loop (index, value) in text.bytes() {
        if Int.from_u8(value) == byte -> return Val(index)
    }
    None
}

fn marker_source_last_byte_index(text: String, byte: Int) -> Int? Never! {
    found := Int?{None}
    loop (index, value) in text.bytes() {
        if Int.from_u8(value) == byte -> found = Val(index)
    }
    found
}

// `source` without its `//` and `/* … */` comments; a comment opener inside
// a string literal is text.
fn marker_source_strip_comments(source: String) -> String Never! {
    bytes :: source.bytes()
    out := [U8]{}
    in_string := false
    escaped := false
    index := 0
    loop index < bytes.len() {
        byte :: Int.from_u8(bytes[index])
        following :: if index + 1 < bytes.len() -> Int.from_u8(bytes[index + 1]) else -> 0
        if in_string {
            if {
                escaped -> escaped = false
                byte == 92 -> escaped = true
                byte == 34 -> in_string = false
                else -> {}
            }
            &out.push(bytes[index])
            index += 1
            next
        }
        if byte == 47 && following == 47 {
            loop index < bytes.len() && Int.from_u8(bytes[index]) != 10 -> index += 1
            next
        }
        if byte == 47 && following == 42 {
            index += 2
            loop index + 1 < bytes.len() && !(Int.from_u8(bytes[index]) == 42 && Int.from_u8(bytes[index + 1]) == 47) -> index += 1
            index += 2
            next
        }
        if byte == 34 -> in_string = true
        &out.push(bytes[index])
        index += 1
    }
    String.from_bytes(out) ?? panic("the marker source is not UTF-8 once its comments are removed")
}

// The members of a declaration body: entries at nesting depth zero, outside
// string literals, separated by line ends, commas or semicolons.
fn marker_source_members(text: String) -> [String] Never! {
    entries := [String]{}
    start := 0
    scan := MarkerSourceScan{depth: 0, in_string: false, escaped: false}
    loop (index, byte) in text.bytes() {
        value :: Int.from_u8(byte)
        if marker_source_scan_step(&scan, value) && (value == 10 || value == 44 || value == 59) {
            entry :: marker_source_slice(text, start, index).trim()
            if entry.len() > 0 -> &entries.push(entry)
            start = index + 1
        }
    }
    last :: marker_source_slice(text, start, text.len()).trim()
    if last.len() > 0 -> &entries.push(last)
    entries
}

// The text between the first `{` and the last `}` of a member.
fn marker_source_block(member: String, what: String) -> String Never! {
    open :: marker_source_byte_index(member, 123) ?? panic("{what} without a `{{` body: {member}")
    close :: marker_source_last_byte_index(member, 125) ?? panic("{what} without a closing `}}`: {member}")
    marker_source_slice(member, open + 1, close)
}

// The offset of the first `::` in `text`.
fn marker_source_setting_separator(text: String) -> Int? Never! {
    bytes :: text.bytes()
    loop index in 1..<bytes.len() {
        if Int.from_u8(bytes[index - 1]) == 58 && Int.from_u8(bytes[index]) == 58 -> return Val(index - 1)
    }
    None
}

// One marker type: the fields are the rule's parameters and the
// `impl Marker` settings are its facts. None for a struct that is not a
// marker, or a marker that is a group rather than a rule.
fn marker_source_declaration(name: String, body: String) -> TAppliedRule? Never! {
    context :: "struct {name}"
    fields := [String]{}
    settings := String?{None}
    loop member in marker_source_members(body) {
        if member.starts_with("fn ") -> next
        if member.starts_with("impl Marker") {
            settings = Val(marker_source_block(member, "`impl Marker` in {context}"))
            next
        }
        &fields.push(member)
    }
    block :: settings ?? return None
    sites := [String]{}
    scopes := [String]{}
    repeatable := false
    owns_menu := false
    inherits := false
    resolution := "SiteBound"
    companion_site := TAppliedRuleCompanionSite?{None}
    group := false
    loop entry in marker_source_members(block) {
        if entry.starts_with("fn ") -> next
        separator :: marker_source_setting_separator(entry) ?? panic("a marker setting reads `name :: value`, found `{entry}` in {context}")
        key :: marker_source_slice(entry, 0, separator).trim()
        value :: marker_source_slice(entry, separator + 2, entry.len()).trim()
        if key == {
            "sites" -> sites = loop item in marker_source_list(value) -> marker_source_site(item, context)
            "scopes" -> scopes = loop item in marker_source_list(value) -> marker_source_scope(item, context)
            "repeatable" -> repeatable = marker_source_flag(value, context)
            "owns_menu" -> owns_menu = marker_source_flag(value, context)
            "inherits" -> inherits = marker_source_flag(value, context)
            "resolution" -> resolution = marker_source_resolution(value, context)
            "companion" -> {
                parts :: marker_source_list(value)
                if parts.len() != 2 -> panic("`companion` reads `[Rule, .Site]` in {context}")
                companion_site = Val(TAppliedRuleCompanionSite{rule: parts[0], site: marker_source_site(parts[1], context)})
            }
            "group" -> group = true
            else -> panic("unknown marker setting `{key}` in {context}")
        }
    }
    if group -> return None
    params := [TAppliedRuleParameter]{}
    variadic := TAppliedRuleArgKind?{None}
    variadic_source_type := String?{None}
    variadic_name := String?{None}
    loop index in 0..<fields.len() {
        entry :: fields[index]
        colon :: marker_source_byte_index(entry, 58) ?? panic("marker field without `:` in {context}: {entry}")
        label :: marker_source_slice(entry, 0, colon).trim()
        value :: marker_source_slice(entry, colon + 1, entry.len()).trim()
        type_text := value
        default := String?{None}
        if marker_source_split_default(value) == .Val(split) {
            type_text = split.type_text
            default = Val(split.default)
        }
        // A last list field with no default takes the remaining arguments.
        if index == fields.len() - 1 && default == None && type_text.starts_with("[") && type_text.ends_with("]") {
            element :: marker_source_slice(type_text, 1, type_text.len() - 1).trim()
            variadic = Val(marker_source_arg_type(element))
            variadic_source_type = Val(element)
            variadic_name = Val(label)
            next
        }
        &params.push(TAppliedRuleParameter{
            name: label,
            kind: marker_source_arg_type(type_text),
            source_type: type_text,
            default_source: default,
        })
    }
    Val(TAppliedRule{
        name: name,
        signature: TAppliedRuleSignature{params: params, variadic: variadic, variadic_source_type: variadic_source_type, variadic_name: variadic_name},
        policy_scopes: scopes,
        sites: sites,
        repeatable: repeatable,
        owns_menu: owns_menu,
        companion_site: companion_site,
        inherits: inherits,
        resolution: resolution,
    })
}

// Every marker type in `source`, the text of Prelude/Markers.jet
// (MarkerSource.rs `read`), in source order.
fn marker_source_read(source: String) -> [TAppliedRule] Never! {
    rows := [TAppliedRule]{}
    loop member in marker_source_members(marker_source_strip_comments(source)) {
        if !member.starts_with("struct ") -> next
        open :: marker_source_byte_index(member, 123) ?? panic("marker struct without a body: {member}")
        name :: marker_source_slice(member, 7, open).trim()
        if marker_source_declaration(name, marker_source_block(member, "struct {name}")) == .Val(row) -> &rows.push(row)
    }
    rows
}

// Policy.rs `RuleSignature::render`: `(name: Type{default}, …, Variadic...)`.
fn applied_rule_signature_render(signature: TAppliedRuleSignature) -> String Never! {
    parts := [String]{}
    loop param in signature.params {
        default :: if param.default_source == .Val(value) -> "{{{value}}}" else -> ""
        &parts.push("{param.name}: {param.source_type}{default}")
    }
    if signature.variadic_source_type == .Val(source_type) -> &parts.push("{source_type}...")
    "({parts.join(", ")})"
}

// A marker type on one line, as hover and symbol signatures show it: its
// fields, then the `impl Marker` settings. `source` is the declaring file,
// which spells the defaults and setting values.
fn marker_decl_signature(declaration: MarkerDecl, source: String) -> String Never! {
    parts := [String]{}
    settings := [String]{}
    loop parameter in declaration.params {
        value :: if parameter.value == .Val(expression) -> marker_decl_signature_source(source, expr_span(expression)) else -> "…"
        if parameter.ty == .Val(ty) {
            shown :: if parameter.variadic -> "[{type_name(ty)}]" else -> type_name(ty)
            default :: if parameter.value != None -> "{{{value}}}" else -> ""
            &parts.push("{parameter.name}: {shown}{default}")
        } else {
            key :: if parameter.name.starts_with("$") -> marker_source_slice(parameter.name, 1, parameter.name.len()) else -> parameter.name.copy()
            &settings.push("{key} :: {value}")
        }
    }
    block :: if settings.len() == 0 -> "impl Marker {{}}" else -> "impl Marker {{ {settings.join("; ")} }}"
    &parts.push(block)
    "struct {declaration.name} {{ {parts.join(", ")} }}"
}

fn marker_decl_signature_source(source: String, span: Span) -> String Never! {
    bytes :: source.bytes()
    if span.start < 0 || span.end < span.start || span.end > bytes.len() -> return "…"
    text :: (String.from_bytes(bytes[span.start..<span.end]) ?? return "…").trim()
    if text == "" -> return "…"
    text
}

// The registered signature `marker_argument_shape_error` (Policy.rs) names:
// the rule row's rendered signature, `()` when no row has that name.
fn marker_registered_signature(name: String) -> String Never! {
    loop rule in marker_source_read(MARKER_SOURCE) {
        if rule.name == name -> return applied_rule_signature_render(rule.signature)
    }
    "()"
}

// Whether the shared registry has an applied rule row named `name`. Marker
// declarations in scope are not visible here; sema resolves those.
fn marker_registered(name: String) -> Bool Never! {
    loop rule in marker_source_read(MARKER_SOURCE) {
        if rule.name == name -> return true
    }
    false
}

// Whether `name` is a registered applied rule that stays at its own site: it
// takes no part in lexical policy inheritance, so no policy scope can hold it.
fn marker_registered_site_bound(name: String) -> Bool Never! {
    loop rule in marker_source_read(MARKER_SOURCE) {
        if rule.name == name -> return !rule.inherits
    }
    false
}

// Policy.rs `RuleSignature::accepts_arguments` (D-MARK-FORM1=A): whether the
// registered rule `name` may be written with parentheses at all. A row with
// no parameter and no variadic list never takes arguments.
fn marker_registered_accepts_arguments(name: String) -> Bool Never! {
    loop rule in marker_source_read(MARKER_SOURCE) {
        if rule.name == name -> return rule.signature.params.len() > 0 || rule.signature.variadic != None
    }
    false
}
