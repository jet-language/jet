// Rust: crates/jet-foundation/src/Policy.rs:1824
pub fn marker_repeated_error(name: String, noun: String, span: Span) -> Diagnostic Never! {
    diagnostic_from_registry("E0999", Val(span), "`#{name}` is already applied to this {noun}", "`#{name}` is not a repeatable rule, so the second copy adds nothing and can only disagree with the first", "remove the repeated marker")
}

// Rust: crates/jet-foundation/src/Policy.rs:1843
// Parentheses occur exactly when arguments are written; delete only the pair.
pub fn marker_empty_arguments_error(name: String, parens: Span) -> Diagnostic Never! {
    diagnostic :: diagnostic_from_registry("E0999", Val(parens), "`#{name}()` has empty parentheses", "a marker writes parentheses exactly when it passes arguments", "write `#{name}`")
    diagnostic_with_structured_edit(diagnostic, TextEdit{span: parens, new_text: ""})
}

// Rust: crates/jet-foundation/src/Policy.rs:1867
pub fn marker_argument_unknown_variant(name: String, declaration: TAppliedRuleArgumentMenu, written: String, span: Span) -> Diagnostic Never! {
    variants := [String]{}
    loop variant in declaration.variants -> &variants.push("`{variant}`")
    menu :: variants.join(", ")
    diagnostic_from_registry("E0930", Val(span), "`#{name}` has no `{declaration.name}` called `{written}`", "`{declaration.name}` is a closed menu: {menu}", "pick one of {menu}")
}

// Rust: crates/jet-foundation/src/Policy.rs:1888
// MarkerSource::MARKER_SOURCE is FoundationEmbeddedCore.marker_source(); the
// sole parser/registry producer is Sema's sema_marker_rules_embedded_catalog.
// Rust: crates/jet-foundation/src/Policy.rs:1898
// APPLIED_RULES is retained in TAppliedRuleCatalog.rows, not a second global.
// Rust: crates/jet-foundation/src/Policy.rs:1900
pub fn applied_rule_registry(catalog: TAppliedRuleCatalog) -> [TAppliedRule] Never! { catalog.rows }

// Rust: crates/jet-foundation/src/Policy.rs:1904
pub fn applied_rule(catalog: TAppliedRuleCatalog, name: String) -> TAppliedRule? Never! {
    loop row in catalog.rows { if row.name == name -> return Val(row) }
    None
}

// Rust: crates/jet-foundation/src/Policy.rs:1908
// rule_allows is canonical in AppliedRules.jet (retained catalog argument).
// Rust: crates/jet-foundation/src/Policy.rs:1915
// rule_allows_with_companions is canonical in AppliedRules.jet.

// Rust: crates/jet-foundation/src/Policy.rs:1930
pub let DERIVE_RULES: [String] = [String]{
    "Codable", "Encode", "Decode", "Comparable", "Equatable", "Debug",
    "Numeric", "Printable", "CLI", "Patchable", "UnitFamily",
}

// Rust: crates/jet-foundation/src/Policy.rs:1946
pub fn nonderive_marker_trait_collision(catalog: TAppliedRuleCatalog, name: String) -> Bool Never! {
    row :: applied_rule(catalog, name) ?? return false
    row.status == TAppliedRuleStatus.Active && row.sites.contains("Type") && !DERIVE_RULES.contains(name)
}

