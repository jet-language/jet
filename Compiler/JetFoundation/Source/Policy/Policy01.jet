//RS     if rule_allows(name, site) {
//RS         return true;
//RS     }
//RS     let Some(companion) = applied_rule(name).and_then(|row| row.companion_site) else {
//RS         return false;
//RS     };
//RS     companion.site == site && companions.into_iter().any(|other| other == companion.rule)
//RS }
