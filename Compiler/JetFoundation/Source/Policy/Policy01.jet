//RS pub use MarkerSource::MARKER_SOURCE;
//RS 
//RS /// D-MARKSIG1=A + D-META-ONE1=A: the sole compiler registry for active and
//RS /// retired markers. Parser, sema, formatter, LSP, highlighting, explain, and
//RS /// retirement diagnostics read these rows; the rows themselves are written as
//RS /// ordinary Jet `marker` declarations in `Prelude/Markers.jet`, so this file
//RS /// holds no copy of the vocabulary.
//RS pub static APPLIED_RULES: LazyLock<Vec<AppliedRule>> = LazyLock::new(MarkerSource::read);
//RS 
//RS pub fn applied_rule_registry() -> &'static [AppliedRule] {
//RS     &APPLIED_RULES
//RS }
//RS 
//RS pub fn applied_rule(name: &str) -> Option<&'static AppliedRule> {
//RS     APPLIED_RULES.iter().find(|row| row.name == name)
//RS }
//RS 
//RS pub fn rule_allows(name: &str, site: RuleSite) -> bool {
//RS     applied_rule(name).is_some_and(|row| row.sites.contains(&site))
//RS }
//RS 
//RS /// `rule_allows`, plus the extra site a companion on the same target opens.
//RS /// `companions` is every rule name attached to that target, so `#Doc` is legal
//RS /// on a function exactly when `#Job` sits beside it (D-TASKS-LIST1=A).
//RS pub fn rule_allows_with_companions<'a>(
//RS     name: &str,
//RS     site: RuleSite,
//RS     companions: impl Iterator<Item = &'a str>,
