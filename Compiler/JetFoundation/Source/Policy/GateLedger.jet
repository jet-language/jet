// Canonical authority-gate read model.

GateKind: enum {
    Unsafe,
    Impure,
    DependencyGrant,
    BuildFlag,
    SessionFlag,
    TrustGrant,
    ForcePin,
    TaintScrub,
    DutyDrop,
    StateTransition,
    PrecisionDemotion,
    Nondeterministic,
    Structure,
    LintAllow,
    CheckRemoval,
    LinkOverride,
    HostFacts,
}

// GateKind picks from PolicyKey (AST/Statements.jet): each gate kind is the
// policy key that governs it, so a new kind is a policy key first. While the
// compiler builds, GATE_KIND_COUNT checks that each case is a PolicyKey
// case, and a stray stops the build naming it.
GATE_KIND_COUNT: #run gate_kind_count(embed_file("GateLedger.jet"), embed_file("toolchain:Compiler/JetFoundation/Source/AST/Statements.jet"))

// The number of GateKind cases in `text` (this file), once each is a case
// of `PolicyKey` in `statements`; else the build stops naming the strays.
gate_kind_count: fn(text: String, statements: String) -> Int {
    kinds: effect_vocabulary_enum_cases(text, "GateKind") ?? build_time_refused("GateLedger.jet declares no `GateKind: enum {{ … }}`")
    keys: effect_vocabulary_enum_cases(statements, "PolicyKey") ?? build_time_refused("AST/Statements.jet declares no `PolicyKey: enum {{ … }}`")
    strays: effect_vocabulary_strays(kinds, keys)
    if strays.len() > 0 {
        build_time_refused("GateLedger.jet: GateKind names kinds that `PolicyKey` in AST/Statements.jet does not declare: {strays.join(", ")}")
    }
    kinds.len()
}

// A build option value that removes a runtime memory-safety check
// (`bounds: off`, `bounds: report`; JetFoundation BuildOptions.jet).
// The `link_args` build option: native link inputs
// the program's own declarations don't name.
// A `#build.host.*` read: the build reads the machine running it.

gate_kind_policy_key: fn(kind: GateKind) -> PolicyKey Never! {
    if kind == {
        .Unsafe -> PolicyKey.Unsafe
        .Impure -> PolicyKey.Impure
        .DependencyGrant -> PolicyKey.DependencyGrant
        .BuildFlag -> PolicyKey.BuildFlag
        .SessionFlag -> PolicyKey.SessionFlag
        .TrustGrant -> PolicyKey.TrustGrant
        .ForcePin -> PolicyKey.ForcePin
        .TaintScrub -> PolicyKey.TaintScrub
        .DutyDrop -> PolicyKey.DutyDrop
        .StateTransition -> PolicyKey.StateTransition
        .PrecisionDemotion -> PolicyKey.PrecisionDemotion
        .Nondeterministic -> PolicyKey.Nondeterministic
        .Structure -> PolicyKey.Structure
        .LintAllow -> PolicyKey.LintAllow
        .CheckRemoval -> PolicyKey.CheckRemoval
        .LinkOverride -> PolicyKey.LinkOverride
        .HostFacts -> PolicyKey.HostFacts
    }
}

gate_kind_name: fn(kind: GateKind) -> String Never! { policy_key_name(gate_kind_policy_key(kind)) }

gate_kind_parse: fn(value: String) -> GateKind? Never! {
    if value.trim().to_ascii_lower() == {
        "unsafe" | "unsafe_region" | "unsafe_fn" -> Val(GateKind.Unsafe)
        "impure" -> Val(GateKind.Impure)
        "dependency" | "dependency_grant" | "grant" -> Val(GateKind.DependencyGrant)
        "build" | "build_flag" -> Val(GateKind.BuildFlag)
        "session" | "session_flag" -> Val(GateKind.SessionFlag)
        "trust" | "trust_grant" -> Val(GateKind.TrustGrant)
        "force" | "force_pin" -> Val(GateKind.ForcePin)
        "scrub" | "taint" | "taint_scrub" -> Val(GateKind.TaintScrub)
        "drop" | "detach" | "duty" | "duty_drop" -> Val(GateKind.DutyDrop)
        "state" | "transition" | "state_transition" -> Val(GateKind.StateTransition)
        "approx" | "precision" | "precision_demotion" | "rounded" | "wrapping" | "saturating" | "checked" -> Val(GateKind.PrecisionDemotion)
        "nondeterministic" | "determinism" -> Val(GateKind.Nondeterministic)
        "structure" -> Val(GateKind.Structure)
        "lint_allow" -> Val(GateKind.LintAllow)
        "check_removal" -> Val(GateKind.CheckRemoval)
        "link_override" -> Val(GateKind.LinkOverride)
        "host" | "host_facts" -> Val(GateKind.HostFacts)
        else -> None
    }
}

gate_kind_is_security: fn(kind: GateKind) -> Bool Never! {
    if kind == {
        .Unsafe | .Impure | .DependencyGrant | .BuildFlag | .SessionFlag | .TrustGrant | .ForcePin | .Nondeterministic | .CheckRemoval | .LinkOverride | .HostFacts -> true
        .TaintScrub | .DutyDrop | .StateTransition | .PrecisionDemotion | .Structure | .LintAllow -> false
    }
}

// The ledger's kind order: every security kind (gate_kind_is_security)
// before the knowledge-plane kinds, so `jet inspect gates` lists them first.
gate_kind_order: fn(kind: GateKind) -> Int Never! {
    if kind == {
        .Unsafe -> 0
        .CheckRemoval -> 1
        .LinkOverride -> 2
        .Impure -> 3
        .Nondeterministic -> 4
        .DependencyGrant -> 5
        .BuildFlag -> 6
        .SessionFlag -> 7
        .TrustGrant -> 8
        .ForcePin -> 9
        .HostFacts -> 10
        .TaintScrub -> 11
        .DutyDrop -> 12
        .StateTransition -> 13
        .PrecisionDemotion -> 14
        .Structure -> 15
        .LintAllow -> 16
    }
}

GateOperation: struct {
    kind: String,
    span: Span,
    required: [String],
    asserted: [String],
    discharged: Bool,
}

GateEntry: struct {
    kind: GateKind,
    domain: String,
    scope: String,
    source: String,
    span: Span?,
    subject: String,
    reason: String?,
    status: String?,
    detail: String,
    provenance: [String],
    operations: [GateOperation],
}

GateDiagnostic: struct {
    source: String,
    diagnostic: Diagnostic,
}

GateLedger: struct {
    rows: [GateEntry]{[GateEntry]{}},
    diagnostic_rows: [GateDiagnostic]{[GateDiagnostic]{}},
}

gate_same_fact: fn(left: GateEntry, right: GateEntry) -> Bool Never! {
    if left.kind != right.kind || left.domain != right.domain || left.scope != right.scope || left.subject != right.subject || left.detail != right.detail {
        return false
    }
    if left.span == .None && right.span == .None -> return true
    left.span != None && left.span == right.span && left.source == right.source
}

gate_ledger_push: fn(ledger: ^GateLedger, entry: ^^GateEntry) Never! {
    ^written: entry
    if written.provenance.len() == 0 -> written.provenance.push(written.source)
    loop index in 0..<ledger.rows.len() {
        if !gate_same_fact(ledger.rows[index], written) -> next
        loop provenance in written.provenance {
            if !ledger.rows[index].provenance.contains(provenance) {
                ledger.rows[index].provenance.push(provenance)
            }
        }
        if ledger.rows[index].reason == .None -> ledger.rows[index].reason = written.reason
        if ledger.rows[index].status == .None -> ledger.rows[index].status = written.status
        ledger.rows[index].provenance.sort()
        return
    }
    written.provenance.sort()
    ledger.rows.push(written)
}

gate_entry_compare: fn(left: GateEntry, right: GateEntry) -> Ordering Never! {
    order: gate_kind_order(left.kind) <=> gate_kind_order(right.kind)
    if order != Ordering.Equal -> return order
    source: left.source <=> right.source
    if source != Ordering.Equal -> return source
    if left.span == .None && right.span != None -> return Ordering.Greater
    if left.span != None && right.span == .None -> return Ordering.Less
    if left.span == .Val(a) && right.span == .Val(b) {
        start: a.start <=> b.start
        if start != Ordering.Equal -> return start
        end: a.end <=> b.end
        if end != Ordering.Equal -> return end
    }
    subject: left.subject <=> right.subject
    if subject != Ordering.Equal -> return subject
    left.detail <=> right.detail
}

gate_ledger_sort: fn(ledger: ^GateLedger) Never! {
    ledger.rows = loop fresh_item in ledger.rows -> fresh_item
    ledger.rows.sort_by(fn(left: GateEntry, right: GateEntry) { gate_entry_compare(left, right) })
}

gate_source_entry: fn(kind: GateKind, domain: String, scope: String, source: String, span: Span, subject: String, reason: String?, detail: String, status: String) -> GateEntry Never! {
    GateEntry{kind: kind, domain: domain, scope: scope, source: source, span: Val(span), subject: subject, reason: reason, status: Val(status), detail: detail, provenance: ["{source}:{span.start}..{span.end}"], operations: []}
}
