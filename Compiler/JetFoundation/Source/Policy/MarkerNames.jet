// The marker names the lexer, parser and checker test a written marker
// against. Each is a marker struct of MARKER_SOURCE (PreludeMarkers.jet), so a
// front-end comparison names the registry row and never a string of its own
// (tests/guards/diagnostics_coverage.jet marker_name_literals_stay_in_the_registry;
// Tests/Policy/MarkerNames.jet holds every constant to a registered struct).
MARKER_ABI: "ABI"
MARKER_ALLOW: "Allow"
MARKER_ARG: "Arg"
MARKER_AS: "As"
MARKER_CLI: "CLI"
MARKER_CODABLE: "Codable"
MARKER_COMMUTATIVE: "Commutative"
MARKER_CONTEXT: "Context"
MARKER_DEPRECATED: "Deprecated"
MARKER_DEV_PANEL: "DevPanel"
MARKER_DOC: "Doc"
MARKER_ERROR: "Error"
MARKER_FFI: "FFI"
MARKER_FLATTEN: "Flatten"
MARKER_FX: "FX"
MARKER_HTML: "HTML"
MARKER_INLINE: "Inline"
MARKER_INTERRUPT: "Interrupt"
MARKER_JOB: "Job"
MARKER_KERNEL: "Kernel"
MARKER_LOCAL: "Local"
MARKER_MEMO: "Memo"
MARKER_META: "Meta"
MARKER_MUST_USE: "MustUse"
MARKER_NO_PRELUDE: "NoPrelude"
MARKER_NUMERIC: "Numeric"
MARKER_OFF: "Off"
MARKER_POST: "Post"
MARKER_PRE: "Pre"
MARKER_POLICY: "Policy"
MARKER_PUBLISHED_SCHEMA: "PublishedSchema"
MARKER_REACTIVE: "Reactive"
MARKER_REPLAYABLE: "Replayable"
MARKER_REDACT: "Redact"
MARKER_RECEIPT: "Receipt"
MARKER_RENAME: "Rename"
MARKER_ROOT: "Root"
MARKER_SCALAR: "Scalar"
MARKER_SCRUB: "Scrub"
MARKER_SHARED: "Shared"
MARKER_SINGLE_USE: "SingleUse"
MARKER_SKIP: "Skip"
MARKER_STATE: "State"
MARKER_STATIC: "Static"
MARKER_TARGET: "Target"
MARKER_TRACK: "Track"
MARKER_TRANSACT: "Transact"
MARKER_UNDO: "Undo"
MARKER_UNSAFE: "Unsafe"
MARKER_UNTAGGED: "Untagged"
