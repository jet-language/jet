//RS         "Site" => SITE_VARIANTS,
//RS         "PolicySetting" => &[
//RS             "unsafe",
//RS             "gc",
//RS             "explicit_units",
//RS             "copies",
//RS             "sentries",
//RS             "Explicit",
//RS             "On",
//RS             "Off",
//RS         ],
//RS         "Path" => &[],
//RS         "State" => &[],
//RS         "TaintKind" => crate::Syntax::BUILTIN_TAGS,
//RS         "Target" => &["Native", "Web", "Wasm", "JS", "Freestanding", "OS"],
//RS         "Track" => &["Frontend", "Backend", "Runtime", "Tooling"],
//RS         _ => return None,
