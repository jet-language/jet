//RS /// D-META-FORM1=A / D-MARKER-SITES1=B: `$sites` on a `marker` declaration takes `[Site]`, so the
//RS /// eighteen attachment points are published as an ordinary `core.compiler.lang` enum
//RS /// beside the other marker-argument menus (D-RULEARG-TYPES1=A). `RuleSite::ALL`
//RS /// stays the one source; `site_variants_match_the_enum` proves this list is it.
//RS pub const SITE_VARIANTS: &[&str] = &[
//RS     "Package",
//RS     "File",
//RS     "Module",
//RS     "Function",
//RS     "Method",
//RS     "Block",
//RS     "Statement",
//RS     "Expression",
//RS     "Type",
//RS     "Impl",
//RS     "Declaration",
//RS     "Constant",
//RS     "Field",
//RS     "Variant",
//RS     "Parameter",
//RS     "Test",
//RS     "Operation",
//RS     "Text",
//RS ];
//RS 
//RS /// D-MARK-FORM1=A: one placement law. A marker, or one bracket group, is
//RS /// written immediately before its target; the registry says which targets it
//RS /// accepts; parentheses appear exactly when arguments are written. There is no
//RS /// written-form column — the signature and the site list carry everything the
//RS /// five retired `RuleForm` categories used to approximate.
//RS #[derive(Debug, Clone, Copy, PartialEq, Eq)]
//RS pub struct AppliedRule {
//RS     pub name: &'static str,
//RS     /// Executable source signature shared by parsing, diagnostics, and explain.
//RS     pub signature: RuleSignature,
//RS     /// Non-empty only for rules that participate in lexical policy inheritance.
//RS     pub policy_scopes: &'static [PolicyScope],
//RS     /// Exact sound attachment sites for non-inheriting rules.
//RS     pub sites: &'static [RuleSite],
//RS     /// D-MARK-REPEAT1=A: may this rule be written more than once on one target?
//RS     pub repeatable: bool,
//RS     /// This rule teaches its own argument menu downstream, so the shared binder
//RS     /// stays quiet about an unknown variant and lets the rule's product
//RS     /// diagnostic explain it (`#FFI` → E3220, `#RenameAll` → E2409).
//RS     pub owns_menu: bool,
//RS     /// One extra legal site that opens only when a companion rule sits on the
//RS     /// same target. `#Doc` describes CLI fields/types/variants and can also
//RS     /// describe a `#Job`.
//RS     pub companion_site: Option<CompanionSite>,
//RS     pub status: RuleStatus,
//RS     pub inherits: bool,
//RS     pub resolution: RuleResolution,
//RS }
//RS 
//RS #[derive(Debug, Clone, Copy, PartialEq, Eq)]
//RS pub enum RuleStatus {
//RS     Active,
//RS     Retired { replacement: &'static str },
//RS }
//RS 
//RS #[derive(Debug, Clone, Copy, PartialEq, Eq)]
//RS pub enum RuleResolution {
//RS     SiteBound,
//RS     Override,
//RS     Merge,
//RS     Tighten,
//RS }
//RS 
//RS #[derive(Debug, Clone, Copy, PartialEq, Eq)]
//RS pub enum RuleArgType {
//RS     Any,
//RS     String,
//RS     Path,
//RS     Ident,
//RS     Bool,
//RS     Int,
//RS     DurationOrString,
//RS     /// D-TESTFAULT1=A: a closed list of effect-root operation paths used by
//RS     /// the test harness. This is a marker contract shape, not a runtime type.
//RS     EffectRoots,
//RS }
//RS 
//RS /// D-RULEARG-TYPES1=A + D-LANGNS-NAME1=A: compiler vocabulary is published as
//RS /// ordinary generated enums in `core.compiler.lang`. Marker signatures point at these
//RS /// declarations; diagnostics, reflection, and editor tools read the same rows.
//RS #[derive(Debug, Clone, Copy, PartialEq, Eq)]
//RS pub struct RuleArgDeclaration {
//RS     pub name: &'static str,
//RS     pub variants: &'static [&'static str],
//RS     /// Which segment of a written path names the variant. `core.compiler.lang.Target.Web`
//RS     /// and `Effect.FS` are read from the front because their variants own
//RS     /// nested names; every other menu reads the last segment.
//RS     pub variant_segment: VariantSegment,
//RS }
//RS 
//RS #[derive(Debug, Clone, Copy, PartialEq, Eq)]
//RS pub enum VariantSegment {
//RS     First,
//RS     Last,
//RS }
//RS 
//RS /// An extra attachment site that a rule earns from a companion on the same
//RS /// target (D-TASKS-LIST1=A: `#Doc` describes a `#Job`).
//RS #[derive(Debug, Clone, Copy, PartialEq, Eq)]
//RS pub struct CompanionSite {
//RS     pub rule: &'static str,
//RS     pub site: RuleSite,
//RS }
