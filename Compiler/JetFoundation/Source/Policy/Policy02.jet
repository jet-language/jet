//RS 
//RS /// Source argument kinds that are checked by the language itself instead of
//RS /// published as closed menus in `core.compiler.lang`. `Type` is the ordinary
//RS /// declared-type slot for `#SQL` (D-SQL-ARG1=B), not a language enum.
//RS ///
//RS /// Only the declaration-coverage test reads this: production code asks
//RS /// `rule_arg_declaration` for a menu and gets `None` when there is none.
//RS #[cfg(test)]
//RS const RULE_ARG_TYPES_WITHOUT_CORE_DECLARATION: &[&str] = &[
//RS     "Value",
//RS     "String",
//RS     "Ident",
//RS     "Bool",
//RS     "Int",
//RS     "Duration | String",
//RS     "[Effect]",
//RS     "Type",
//RS     "T.default",
//RS ];
//RS 
//RS #[cfg(test)]
//RS fn rule_arg_needs_core_declaration(name: &str) -> bool {
//RS     !RULE_ARG_TYPES_WITHOUT_CORE_DECLARATION.contains(&name)
//RS }
//RS 
//RS /// Generated from the active/retired applied-rule signatures. `Track` is the
//RS /// compatibility reflection enum retained by D-RULEARG-TYPES1.
//RS pub static RULE_ARG_DECLARATIONS: LazyLock<Vec<RuleArgDeclaration>> = LazyLock::new(|| {
//RS     // `Site` is published for `$sites` on a `marker` declaration (D-META-FORM1=A)
//RS     // and `Track` for reflection; neither appears in a marker signature, so both
//RS     // are seeded rather than found.
//RS     let mut names = std::collections::BTreeSet::from(["Site", "Track"]);
//RS     for row in APPLIED_RULES.iter() {
//RS         names.extend(
//RS             row.signature
//RS                 .params
//RS                 .iter()
//RS                 .map(|parameter| parameter.source_type),
//RS         );
//RS         names.extend(row.signature.variadic_source_type);
//RS     }
//RS     names
//RS         .into_iter()
//RS         .filter_map(|name| {
//RS             canonical_rule_arg_variants(name).map(|variants| RuleArgDeclaration {
//RS                 name,
//RS                 variants,
//RS                 variant_segment: canonical_variant_segment(name),
//RS             })
//RS         })
//RS         .collect()
//RS });
//RS 
//RS /// D-RULEARG-TYPES1=A: `Effect` and `Target` variants own nested names
