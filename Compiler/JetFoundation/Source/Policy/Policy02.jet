//RS     Some(match name {
//RS         "ABI" => &["system", "cdecl", "stdcall", "fastcall", "win64", "sysv64"],
//RS         "Effect" => crate::Authority::EFFECT_ROOTS.as_slice(),
//RS         "ArithmeticMode" => &["Checked", "Wrapping", "Saturating"],
//RS         "FFILanguage" => &["c", "cpp", "asm"],
//RS         "InlineMode" => &["Hint", "Always", "Never"],
//RS         "JobScope" => crate::Syntax::JOB_SCOPE_VARIANTS,
//RS         "KernelMode" => &["parallel"],
//RS         "MemoBound" => &["Default", "none"],
//RS         "IntType" => &[
//RS             "I8", "I16", "I32", "I64", "I128", "U8", "U16", "U32", "U64", "U128",
//RS         ],
//RS         "Layout" => &[crate::Syntax::LAYOUT_C, crate::Syntax::LAYOUT_COLUMNAR],
//RS         "Maturity" => &["Experimental", "Tested", "Hardened"],
//RS         "NamingCase" => &[
//RS             crate::Syntax::RENAME_ALL_CAMEL,
//RS             crate::Syntax::RENAME_ALL_SNAKE,
//RS             crate::Syntax::RENAME_ALL_PASCAL,
