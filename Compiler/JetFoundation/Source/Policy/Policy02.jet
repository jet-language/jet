// Rust: crates/jet-foundation/src/Policy.rs:1311
// RULE_ARG_TYPES_WITHOUT_CORE_DECLARATION and rule_arg_needs_core_declaration:
// paired Tests/Policy/Policy02.jet retains these test-only declarations.
// Rust: crates/jet-foundation/src/Policy.rs:1330
// RULE_ARG_DECLARATIONS is bundle-local: callers retain the canonical catalog,
// rather than initializing an independent LazyLock/global APPLIED_RULES registry.
pub fn rule_arg_declarations(catalog: TAppliedRuleCatalog) -> [TAppliedRuleArgumentMenu] {
    names := [String:Bool]{"Site": true, "Track": true}
    loop row in catalog.rows {
        loop parameter in row.signature.params { names[parameter.source_type] = true }
        if ty :: row.signature.variadic_source_type -> names[ty] = true
    }
    ordered := names.keys().collect()
    &ordered.sort()
    result := [TAppliedRuleArgumentMenu]{}
    loop name in ordered {
        if variants :: canonical_rule_arg_variants(name, catalog) {
            &result.push(TAppliedRuleArgumentMenu{name: name, variants: variants, first_variant_segment: canonical_variant_segment(name)})
        }
    }
    result
}
// Rust: crates/jet-foundation/src/Policy.rs:1359
fn canonical_variant_segment(name: String) -> Bool Never! { name == "Effect" || name == "Target" }
// Rust: crates/jet-foundation/src/Policy.rs:1366
// rule_arg_declaration -> CoreMenus.jet::rule_arg_declaration(name, retained menus).
impl TAppliedRuleArgKind {
    // Rust: crates/jet-foundation/src/Policy.rs:1373
    pub fn name(self) -> String Never! {
        if self == {
            .Any -> "Value"
            .String -> "String"
            .Path -> "Path"
            .Ident -> "Ident"
            .Bool -> "Bool"
            .Int -> "Int"
            .DurationOrString -> "Duration | String"
            .EffectRoots -> "[Effect]"
        }
    }
}
