// Rust: crates/jet-foundation/src/Policy.rs:1403
pub struct RuleArgumentBinding {
    pub source_index: Int
    pub parameter_index: Int?
    pub ty: TAppliedRuleArgKind
}
impl TAppliedRuleSignature {
    // Rust: crates/jet-foundation/src/Policy.rs:1410
    pub fn render(self) -> String Never! {
        parts := [String]{}
        loop param in self.params {
            part := param.name + ": " + param.source_type
            if default :: param.default_source -> part += "{" + default + "}"
            &parts.push(part)
        }
        if ty :: self.variadic_source_type -> &parts.push(ty + "...")
        "(" + parts.join(", ") + ")"
    }
    // Rust: crates/jet-foundation/src/Policy.rs:1432
    pub fn accepts_arguments(self) -> Bool Never! { !self.params.is_empty() || self.variadic != None }
    // Rust: crates/jet-foundation/src/Policy.rs:1439
    pub fn arguments_required(self) -> Bool Never! { self.required() > 0 || self.params.is_empty() && self.variadic != None }
    // Rust: crates/jet-foundation/src/Policy.rs:1443
    pub fn required(self) -> Int Never! {
        count := 0
        loop parameter in self.params { if parameter.default_source == None -> count += 1 }
        count
    }
    // Rust: crates/jet-foundation/src/Policy.rs:1457
    pub fn argument_bindings(self, labels: [String?]) -> [RuleArgumentBinding]? Never! {
        supplied := [Bool]{}
        loop _ in self.params { &supplied.push(false) }
        positional := 0
        saw_named := false
        bindings := [RuleArgumentBinding]{}
        loop (source_index, label) in labels.enumerate() {
            parameter := None as Int?
            if name :: label {
                saw_named = true
                found := None as Int?
                loop (index, param) in self.params.enumerate() { if param.name == name { found = Val(index); break } }
                index :: found ?? return None
                if supplied[index] -> return None
                supplied[index] = true
                parameter = Val(index)
            } else {
                if saw_named -> return None
                loop positional < supplied.len() && supplied[positional] { positional += 1 }
                if positional < supplied.len() {
                    parameter = Val(positional)
                    supplied[positional] = true
                    positional += 1
                }
            }
            ty :: if parameter == { .Val(index) -> self.params[index].kind; .None -> self.variadic ?? return None }
            &bindings.push(RuleArgumentBinding{source_index: source_index, parameter_index: parameter, ty: ty})
        }
        loop (index, parameter) in self.params.enumerate() {
            if parameter.default_source == None && !supplied[index] -> return None
        }
        Val(bindings)
    }
    // Rust: crates/jet-foundation/src/Policy.rs:1507
    pub fn argument_types(self, labels: [String?]) -> [TAppliedRuleArgKind]? Never! {
        bindings :: self.argument_bindings(labels) ?? return None
        types := [TAppliedRuleArgKind]{}
        loop binding in bindings { &types.push(binding.ty) }
        Val(types)
    }
    // Rust: crates/jet-foundation/src/Policy.rs:1512
    pub fn marker_argument_bindings(self, marker: Marker) -> [RuleArgumentBinding]? Never! {
        if marker.name == "Meta" {
            all_named := true
            loop label in marker.arg_labels { if label == None -> all_named = false }
            if all_named {
                bindings := [RuleArgumentBinding]{}
                loop (source_index, label) in marker.arg_labels.enumerate() {
                    name :: (label ?? return None).name
                    index := None as Int?
                    loop (at, parameter) in self.params.enumerate() { if parameter.name == name { index = Val(at); break } }
                    at :: index ?? return None
                    &bindings.push(RuleArgumentBinding{source_index: source_index, parameter_index: Val(at), ty: self.params[at].kind})
                }
                return Val(bindings)
            }
        }
        if marker.name == "Policy" {
            bindings := [RuleArgumentBinding]{}
            loop (source_index, label) in marker.arg_labels.enumerate() {
                if value :: label { if value.name != "copies" && value.name != "sentries" -> return None }
                &bindings.push(RuleArgumentBinding{source_index: source_index, parameter_index: None, ty: self.variadic ?? return None})
            }
            return Val(bindings)
        }
        labels := [String?]{}
        limit :: marker.args.len().min(marker.arg_labels.len())
        loop index in 0..<limit {
            label := None as String?
            if value :: marker.arg_labels[index] { label = Val(value.name) }
            else if marker.name == "Meta" {
                if marker.args[index] == .Expr(.Ident(name, _)) { if name == "tunable" -> label = Val("tunable") }
            }
            &labels.push(label)
        }
        self.argument_bindings(labels)
    }
}
// Rust: crates/jet-foundation/src/Policy.rs:1587
pub fn marker_argument_shape_error(catalog: TAppliedRuleCatalog, name: String, span: Span) -> Diagnostic Never! {
    expected := "()"
    loop row in catalog.rows { if row.name == name { expected = row.signature.render(); break } }
    diagnostic_from_registry("E0930", Val(span), "`#{name}` arguments do not match `{name}{expected}`", "marker arguments use the same call grammar and typed signature as function arguments", "match the registered signature `{name}{expected}`")
}
// Rust: crates/jet-foundation/src/Policy.rs:1606
pub fn active_rule_names(catalog: TAppliedRuleCatalog) -> [String] Never! {
    result := [String]{}
    loop row in catalog.rows { if row.status == .Active -> &result.push(row.name) }
    result
}
// Rust: crates/jet-foundation/src/Policy.rs:1621
pub struct MarkerVocabulary {
    declared: [String:Bool]
    declarations_by_name: [String:MarkerDecl]
}
impl MarkerVocabulary {
    // Rust: crates/jet-foundation/src/Policy.rs:1632
    pub fn with_derives(names: [String]) -> MarkerVocabulary Never! {
        declared := [String:Bool]{}
        loop name in names { declared[name] = true }
        MarkerVocabulary{declared: ^declared, declarations_by_name: [:]}
    }
    // Rust: crates/jet-foundation/src/Policy.rs:1640
    pub fn with_derives_and_declarations(names: [String], declarations: [MarkerDecl]) -> MarkerVocabulary Never! {
        result := MarkerVocabulary.with_derives(names)
        loop declaration in declarations {
            result.declared[declaration.name] = true
            result.declarations_by_name[declaration.name] = declaration
        }
        result
    }
    // Rust: crates/jet-foundation/src/Policy.rs:1655
    pub fn knows(self, catalog: TAppliedRuleCatalog, name: String) -> Bool Never! {
        loop row in catalog.rows { if row.name == name && row.status == .Active -> return true }
        self.declared.contains_key(name)
    }
    // Rust: crates/jet-foundation/src/Policy.rs:1661
    pub fn names(self, catalog: TAppliedRuleCatalog) -> [String] Never! {
        result := active_rule_names(catalog)
        declared := self.declared.keys().collect()
        &declared.sort()
        loop name in declared { &result.push(name) }
        result
    }
    // Rust: crates/jet-foundation/src/Policy.rs:1671
    pub fn declaration(self, name: String) -> MarkerDecl? Never! { self.declarations_by_name.get(name) }
    // Rust: crates/jet-foundation/src/Policy.rs:1676
    pub fn declarations(self) -> [MarkerDecl] Never! {
        keys := self.declarations_by_name.keys().collect()
        &keys.sort()
        loop name in keys -> self.declarations_by_name[name]
    }
    // Rust: crates/jet-foundation/src/Policy.rs:1681
    pub fn unknown(self, catalog: TAppliedRuleCatalog, name: String, span: Span) -> Diagnostic Never! {
        marker_unknown_error(catalog, name, self.names(catalog), span)
    }
}
// Rust: crates/jet-foundation/src/Policy.rs:1693
pub fn marker_wrong_site_error(catalog: TAppliedRuleCatalog, name: String, site: RuleSite, span: Span) -> Diagnostic Never! {
    legal := [String]{}
    fix := "move `#{name}` to one of its registered sites"
    loop row in catalog.rows {
        if row.name != name -> next
        loop allowed in row.sites { &legal.push("`" + allowed + "`") }
        if companion :: row.companion_site { &legal.push("`{companion.site} with companion `#{companion.rule}``") }
        if row.companion_site == None && row.sites == ["Constant"] {
            fix = "write `#{name} NAME :: prep {{ value }}` — a storage marker precedes a module constant"
        }
        break
    }
    legal_text :: if legal.is_empty() { "no active attachment sites" } else { legal.join(", ") }
    diagnostic_from_registry("E0355", Val(span), "`#{name}` cannot attach at the {site.name()} site", "the registry allows `#{name}` only at: {legal_text}", fix)
}
// Rust: crates/jet-foundation/src/Policy.rs:1748
pub fn marker_unknown_error(catalog: TAppliedRuleCatalog, name: String, vocabulary: [String], span: Span) -> Diagnostic Never! {
    loop row in catalog.rows {
        if row.name == name && row.status == .Retired(replacement) {
            fix :: if replacement.starts_with("#") || replacement.starts_with(".") { "write `{replacement}` instead" } else { replacement }
            return diagnostic_from_registry("E0927", Val(span), "`#{name}` is retired", "the registry keeps this old spelling only to teach its replacement; it no longer applies a rule", fix)
        }
    }
    nearest := None as String?
    nearest_distance := 3
    ambiguous := false
    loop candidate in vocabulary {
        distance :: edit_distance(name, candidate)
        if distance == 0 || distance > 2 -> next
        if distance < nearest_distance { nearest = Val(candidate); nearest_distance = distance; ambiguous = false }
        else if distance == nearest_distance { if previous :: nearest { ambiguous = ambiguous || previous != candidate } }
    }
    if ambiguous -> nearest = None
    fix :: if nearest == {
        .Val(candidate) -> "did you mean `#{candidate}`?"
        .None -> "check the spelling, or see Docs/spec/syntax-decisions.md for the full applied-rule list."
    }
    diagnostic := diagnostic_from_registry("E0927", Val(span), "`#{name}` isn't a known applied rule", "`{name}` isn't registered as an applied rule — Jet rules are a closed, registered vocabulary (I7), not any PascalCase word.", fix)
    if candidate :: nearest { diagnostic = diagnostic_with_edit(diagnostic, TextEdit{span: span, new_text: candidate}) }
    diagnostic
}
