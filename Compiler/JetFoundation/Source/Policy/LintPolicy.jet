// One package lint wall for every sema lint
// (crates/jet-foundation/src/LintPolicy.rs). Lint names and codes come from
// the one typed diagnostic registry (DiagnosticRows.jet); no config surface
// owns a second code/name table.
use core.text as lint_unicode

// Canonical package fields (Rust Syntax/predicates.rs).
// Compiler-scoped names stay distinct from Jetpack Syntax in the flat bootstrap.
LINT_POLICY_FIELD_LINTS :: "lints"
LINT_POLICY_FIELD_DENY :: "deny"

// One parse failure from a lint-selection surface. Code/name are present only
// when the rejected value is a registered diagnostic code, so the caller can
// fill the typed diagnostic row without parsing user-facing prose.
#Error
struct LintPolicyError {
    detail: String
    code: String?
    name: String?

    // Rust `Display`: the detail text.
    fn message(self) -> String Never! { self.detail }
}

fn lint_policy_error(detail: String) -> LintPolicyError Never! {
    LintPolicyError{detail: detail, code: None, name: None}
}

fn lint_policy_code_error(detail: String, code: String, name: String?) -> LintPolicyError Never! {
    LintPolicyError{detail: detail, code: Val(code), name: name}
}

// Rust `registered_lints` (`Registry::lint_rows`): every lint-severity row.
fn lint_registered_lints() -> [DiagnosticRegistryRow] Never! {
    rows := [DiagnosticRegistryRow]{}
    loop row in DIAGNOSTIC_ROWS {
        if row.severity == DIAGNOSTIC_LINT -> &rows.push(row)
    }
    rows
}

// Rust `lint_by_name`.
fn lint_by_name(name: String) -> DiagnosticRegistryRow? Never! {
    loop row in DIAGNOSTIC_ROWS {
        if row.severity == DIAGNOSTIC_LINT && row.lint_name == .Val(lint_name) && lint_name == name -> return Val(row)
    }
    None
}

// Rust `code_for_name`: a lint name to its rendered diagnostic code.
fn lint_code_for_name(name: String) -> String? Never! {
    row :: lint_by_name(name) ?? return None
    Val(row.code)
}

// Rust `name_for_code`: a rendered diagnostic code to its stable lint name.
fn lint_name_for_code(code: String) -> String? Never! {
    row :: diagnostic_registry_row(code) ?? return None
    row.lint_name
}

// Rust `auto_derive_lint().lint_name`: the reserved auto-derive policy entry.
fn lint_auto_derive_name() -> String Never! {
    row :: lint_by_name("auto_derive") ?? panic("auto_derive must stay registered")
    row.lint_name ?? panic("lint rows have names")
}

// Rust `parse_policy_lints`: the `lints:` part of a package policy.
fn lint_parse_policy_lints(body: String) -> [String]? LintPolicyError! {
    lints_body :: lint_block_body(body, LINT_POLICY_FIELD_LINTS) ?? return Ok(None)
    deny := [String]{}
    loop entry in lint_key_value_entries(lints_body) {
        if entry.key != LINT_POLICY_FIELD_DENY -> return Err(lint_policy_error("unknown `policy.lints` field `{entry.key}` — allowed: `{LINT_POLICY_FIELD_DENY}`"))
        deny = lint_parse_name_list(entry.value.trim())
    }
    Ok(Val(deny))
}

// Rust `parse_lint_name_list`.
fn lint_parse_name_list(value: String) -> [String] LintPolicyError! {
    text :: value.trim()
    if !text.starts_with("[") || !text.ends_with("]") || text.bytes().len() < 2 -> return Err(lint_policy_error("`{LINT_POLICY_FIELD_DENY}:` must be a list like `[same_enum_guard_table, float_money]`"))
    names := [String]{}
    loop item in lint_top_level_commas(lint_slice(text.bytes(), 1, text.bytes().len() - 1)) {
        entry :: item.trim()
        if entry == "" -> next
        name :: lint_unquote(entry)
        if lint_code_for_name(name) == None {
            if lint_name_for_code(name) == .Val(canonical) -> return Err(lint_policy_code_error("`{name}` is a diagnostic code; use `{canonical}` in `policy.lints.deny`", name, Val(canonical)))
            if lint_is_diagnostic_code_shape(name) -> return Err(lint_policy_code_error("`{name}` is a diagnostic code; `policy.lints.deny` takes named lint values", name, None))
            return Err(lint_policy_error("`{name}` isn't a registered lint policy name; allowed: {lint_known_policy_names()}"))
        }
        &names.push(name)
    }
    Ok(names)
}

// Rust `known_lint_policy_names`.
fn lint_known_policy_names() -> String Never! {
    names := [String]{}
    loop row in lint_registered_lints() {
        name :: row.lint_name ?? panic("lint rows have names")
        &names.push("`{name}`")
    }
    names.join(", ")
}

// Rust `is_diagnostic_code_shape`: `E`, `L` or `W` and four ASCII digits.
fn lint_is_diagnostic_code_shape(value: String) -> Bool Never! {
    raw :: value.bytes()
    if raw.len() != 5 -> return false
    first :: Int.from_u8(raw[0])
    if first != 69 && first != 76 && first != 87 -> return false
    loop index in 1..<5 {
        code :: Int.from_u8(raw[index])
        if code < 48 || code > 57 -> return false
    }
    true
}

fn lint_slice(raw: [U8], start: Int, end: Int) -> String Never! {
    String.from_bytes(raw[start..<end]) ?? panic("lint policy reader cuts at scalar boundaries")
}

// Rust `block_body(text, key, '{', '}')`: the body of the first unquoted
// `key: {…}` (or `key: .{…}`) whose key is not preceded by a word character.
fn lint_block_body(text: String, key: String) -> String? Never! {
    raw :: text.bytes()
    pattern :: key.bytes()
    at := 0
    quoted := false
    escaped := false
    loop at < raw.len() {
        code :: Int.from_u8(raw[at])
        width :: diagnostic_utf8_width(raw, at)
        if quoted {
            if {
                escaped -> escaped = false
                code == 92 -> escaped = true
                code == 34 -> quoted = false
                else -> {}
            }
            at += width
            next
        }
        if code == 34 {
            quoted = true
            at += width
            next
        }
        if lint_bytes_at(raw, at, pattern) && lint_preceded_ok(raw, at) {
            after :: lint_slice(raw, at + pattern.len(), raw.len()).trim_start()
            if after.starts_with(":") {
                rest := after.removeprefix(":").trim_start()
                if rest.starts_with(".") -> rest = rest.removeprefix(".").trim_start()
                if rest.starts_with("{{") -> return Val(lint_balanced(rest.bytes()))
            }
        }
        at += width
    }
    None
}

fn lint_bytes_at(raw: [U8], at: Int, pattern: [U8]) -> Bool Never! {
    if at + pattern.len() > raw.len() -> return false
    loop offset in 0..<pattern.len() {
        if raw[at + offset] != pattern[offset] -> return false
    }
    true
}

// Rust: no alphanumeric or `_` character immediately before the key.
fn lint_preceded_ok(raw: [U8], at: Int) -> Bool Never! {
    if at == 0 -> return true
    start := at - 1
    loop start > 0 && Int.from_u8(raw[start]) >= 128 && Int.from_u8(raw[start]) <= 191 -> start -= 1
    previous :: lint_slice(raw, start, at)
    previous != "_" && !lint_unicode.is_alphabetic(previous) && !lint_unicode.is_numeric(previous)
}

// Rust `balanced(stripped, '{', '}')`: `raw` starts at the opening brace; the
// text up to its matching close (or the rest when unclosed).
fn lint_balanced(raw: [U8]) -> String Never! {
    depth := 1
    quoted := false
    escaped := false
    at := 1
    loop at < raw.len() {
        code :: Int.from_u8(raw[at])
        if quoted {
            if {
                escaped -> escaped = false
                code == 92 -> escaped = true
                code == 34 -> quoted = false
                else -> {}
            }
        } else if code == 34 {
            quoted = true
        } else if code == 123 {
            depth += 1
        } else if code == 125 {
            depth -= 1
            if depth == 0 -> return lint_slice(raw, 1, at)
        }
        at += 1
    }
    lint_slice(raw, 1, raw.len())
}

// Rust `top_level_commas`: split at depth-0 commas outside quotes; a blank
// tail is dropped.
fn lint_top_level_commas(body: String) -> [String] Never! {
    raw :: body.bytes()
    out := [String]{}
    depth := 0
    quoted := false
    escaped := false
    start := 0
    loop at in 0..<raw.len() {
        code :: Int.from_u8(raw[at])
        if quoted {
            if {
                escaped -> escaped = false
                code == 92 -> escaped = true
                code == 34 -> quoted = false
                else -> {}
            }
            next
        }
        if code == {
            34 -> quoted = true
            40 | 91 | 123 -> depth += 1
            41 | 93 | 125 -> depth -= 1
            44 -> {
                if depth == 0 {
                    &out.push(lint_slice(raw, start, at))
                    start = at + 1
                }
            }
            else -> {}
        }
    }
    tail :: lint_slice(raw, start, raw.len())
    if tail.trim() != "" -> &out.push(tail)
    out
}

// Rust `key_value_entries`: `key: value` pairs, trimmed.
fn lint_key_value_entries(body: String) -> [(key: String, value: String)] Never! {
    out := [(key: String, value: String)]{}
    loop entry in lint_top_level_commas(body) {
        parts :: entry.trim().split_once(":") ?? next
        &out.push((key: parts.before.trim(), value: parts.after.trim()))
    }
    out
}

// Rust `unquote`.
fn lint_unquote(value: String) -> String Never! {
    text :: value.trim()
    if text.bytes().len() >= 2 && text.starts_with("\"") && text.ends_with("\"") -> return lint_slice(text.bytes(), 1, text.bytes().len() - 1)
    text
}
