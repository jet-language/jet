// Canonical syntax checker for Jet's linear regex engine.
// Offsets count decoded Unicode scalar values, not UTF-8 bytes.

@REGEX_SYNTAX_USIZE_MAX :: 0xffffffffffffffff

pub struct RegexSyntaxError {
    pub offset: Int
    pub reason: String
}

struct RegexSyntaxCodepoint {
    pub value: Int
    pub width: Int
}

struct RegexSyntaxParser {
    pub bytes: [U8]
    pub byte_pos: Int
    pub pos: Int
}

struct RegexSyntaxNumber {
    pub value: Int
    pub error: ?RegexSyntaxError
}

fn regex_syntax_codepoint_at(bytes: [U8], offset: Int) -> ?RegexSyntaxCodepoint {
    if offset >= bytes.len() -> return None
    first :: Int.from_u8(bytes[offset])
    if first < 128 -> return Val(RegexSyntaxCodepoint{value: first, width: 1})
    if first < 224 {
        second :: Int.from_u8(bytes[offset + 1])
        return Val(RegexSyntaxCodepoint{value: ((first & 31) << 6) | (second & 63), width: 2})
    }
    if first < 240 {
        second :: Int.from_u8(bytes[offset + 1])
        third :: Int.from_u8(bytes[offset + 2])
        return Val(RegexSyntaxCodepoint{value: ((first & 15) << 12) | ((second & 63) << 6) | (third & 63), width: 3})
    }
    second :: Int.from_u8(bytes[offset + 1])
    third :: Int.from_u8(bytes[offset + 2])
    fourth :: Int.from_u8(bytes[offset + 3])
    Val(RegexSyntaxCodepoint{value: ((first & 7) << 18) | ((second & 63) << 12) | ((third & 63) << 6) | (fourth & 63), width: 4})
}

fn regex_syntax_peek(parser: &RegexSyntaxParser) -> ?Int {
    codepoint :: regex_syntax_codepoint_at(parser.bytes, parser.byte_pos) ?? return None
    Val(codepoint.value)
}

fn regex_syntax_peek_n(parser: &RegexSyntaxParser, offset: Int) -> ?Int {
    byte_pos := parser.byte_pos
    index := 0
    loop index < offset {
        codepoint :: regex_syntax_codepoint_at(parser.bytes, byte_pos) ?? return None
        byte_pos += codepoint.width
        index += 1
    }
    codepoint :: regex_syntax_codepoint_at(parser.bytes, byte_pos) ?? return None
    Val(codepoint.value)
}

fn regex_syntax_bump(parser: &RegexSyntaxParser) -> ?Int {
    codepoint :: regex_syntax_codepoint_at(parser.bytes, parser.byte_pos) ?? return None
    parser.byte_pos += codepoint.width
    parser.pos += 1
    Val(codepoint.value)
}

fn regex_syntax_error(parser: &RegexSyntaxParser, reason: String) -> RegexSyntaxError {
    RegexSyntaxError{offset: if parser.pos > 0 -> parser.pos - 1 else -> 0, reason: reason}
}

fn regex_syntax_error_at(offset: Int, reason: String) -> RegexSyntaxError {
    RegexSyntaxError{offset: offset, reason: reason}
}

fn regex_syntax_parse_alt(parser: &RegexSyntaxParser, terminator: ?Int) -> ?RegexSyntaxError {
    error := regex_syntax_parse_seq(parser, terminator)
    if error != None -> return error
    loop regex_syntax_peek(parser) == (Val(124)) {
        regex_syntax_bump(parser)
        error = regex_syntax_parse_seq(parser, terminator)
        if error != None -> return error
    }
    if terminator != None {
        if regex_syntax_peek(parser) != terminator -> return Val(regex_syntax_error(parser, "missing `)`"))
        regex_syntax_bump(parser)
    }
    None
}

fn regex_syntax_parse_seq(parser: &RegexSyntaxParser, terminator: ?Int) -> ?RegexSyntaxError {
    loop {
        ch :: regex_syntax_peek(parser) ?? break
        if terminator == (Val(ch)) || ch == 124 -> break
        error := regex_syntax_parse_atom(parser)
        if error != None -> return error
        error = regex_syntax_parse_quant(parser)
        if error != None -> return error
    }
    None
}

fn regex_syntax_parse_atom(parser: &RegexSyntaxParser) -> ?RegexSyntaxError {
    ch :: regex_syntax_bump(parser) ?? return Val(regex_syntax_error(parser, "empty atom"))
    if ch == {
        46 | 94 | 36 -> None
        40 -> regex_syntax_parse_group(parser)
        41 -> Val(regex_syntax_error(parser, "unmatched `)`"))
        91 -> regex_syntax_parse_class(parser)
        92 -> regex_syntax_parse_escape_atom(parser)
        42 | 43 | 63 -> {
            repeated :: String.from_bytes([U8{ch}]) ?? ""
            Val(regex_syntax_error(parser, "`{repeated}` has nothing to repeat"))
        }
        123 -> Val(regex_syntax_error(parser, "`{{n}}` has nothing to repeat"))
        else -> None
    }
}

fn regex_syntax_parse_group(parser: &RegexSyntaxParser) -> ?RegexSyntaxError {
    if regex_syntax_peek(parser) == (Val(63)) {
        regex_syntax_bump(parser)
        kind_start := parser.byte_pos
        kind :: regex_syntax_bump(parser)
        if {
            kind == (Val(58)) -> {}
            kind == (Val(60)) -> {
                error :: regex_syntax_parse_group_name(parser)
                if error != None -> return error
            }
            kind == (Val(61)) || kind == (Val(33)) -> {
                return Val(regex_syntax_error(parser, "lookaround is not supported; use a linear rewrite"))
            }
            kind == None -> {
                return Val(regex_syntax_error(parser, "missing group kind after `?`"))
            }
            else -> {
                end :: parser.byte_pos
                other :: String.from_bytes(parser.bytes[kind_start..end]) ?? ""
                return Val(regex_syntax_error(parser, "unsupported group `?{other}`"))
            }
        }
    }
    regex_syntax_parse_alt(parser, Val(41))
}

fn regex_syntax_parse_group_name(parser: &RegexSyntaxParser) -> ?RegexSyntaxError {
    is_empty := true
    valid := true
    loop {
        ch :: regex_syntax_peek(parser) ?? break
        if ch == 62 -> break
        is_empty = false
        regex_syntax_bump(parser)
        if !(ch == 95 || (ch >= 48 && ch <= 57) || (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122)) -> valid = false
    }
    if regex_syntax_bump(parser) != Val(62) -> return Val(regex_syntax_error(parser, "missing `>` in named group"))
    if is_empty || !valid -> return Val(regex_syntax_error(parser, "named group needs an identifier"))
    None
}

fn regex_syntax_parse_quant(parser: &RegexSyntaxParser) -> ?RegexSyntaxError {
    if regex_syntax_peek(parser) == (Val(42)) || regex_syntax_peek(parser) == (Val(43)) || regex_syntax_peek(parser) == (Val(63)) {
        regex_syntax_bump(parser)
        return None
    }
    if regex_syntax_peek(parser) != Val(123) -> return None
    regex_syntax_bump(parser)
    min_result :: regex_syntax_parse_number(parser)
    if min_result.error == .Val(error) -> return Val(error)
    min :: min_result.value
    max := Val(min)
    if regex_syntax_peek(parser) == (Val(44)) {
        regex_syntax_bump(parser)
        if {
            regex_syntax_peek(parser) == (Val(125)) -> {
                max = None
            }
            else -> {
                max_result :: regex_syntax_parse_number(parser)
                if max_result.error == .Val(error) -> return Val(error)
                max = Val(max_result.value)
            }
        }
    }
    if regex_syntax_bump(parser) != Val(125) -> return Val(regex_syntax_error(parser, "missing `}}` in quantifier"))
    if max == .Val(value) && value < min -> return Val(regex_syntax_error(parser, "quantifier max is below min"))
    None
}

fn regex_syntax_parse_class(parser: &RegexSyntaxParser) -> ?RegexSyntaxError {
    if regex_syntax_peek(parser) == (Val(94)) {
        regex_syntax_bump(parser)
    }
    loop {
        ch :: regex_syntax_peek(parser) ?? break
        if ch == 93 {
            regex_syntax_bump(parser)
            return None
        }
        range_start :: regex_syntax_parse_class_item(parser)
        if range_start.error == .Val(error) -> return Val(error)
        if regex_syntax_peek(parser) == (Val(45)) && regex_syntax_peek_n(parser, 1) != Val(93) {
            regex_syntax_bump(parser)
            error :: regex_syntax_parse_class_char(parser)
            if error != None -> return error
            if !range_start.value -> return Val(regex_syntax_error(parser, "class range needs literal endpoints"))
        }
    }
    Val(regex_syntax_error(parser, "missing `]`"))
}

struct RegexSyntaxClassItem {
    pub value: Bool
    pub error: ?RegexSyntaxError
}

fn regex_syntax_parse_class_item(parser: &RegexSyntaxParser) -> RegexSyntaxClassItem {
    if regex_syntax_peek(parser) != Val(92) {
        error :: regex_syntax_parse_class_char(parser)
        return RegexSyntaxClassItem{value: true, error: error}
    }
    regex_syntax_bump(parser)
    escaped :: regex_syntax_bump(parser)
    if escaped == (Val(100)) || escaped == (Val(119)) || escaped == (Val(115)) -> return RegexSyntaxClassItem{value: false, error: None}
    if escaped == (Val(112)) {
        error :: regex_syntax_parse_unicode_class(parser)
        return RegexSyntaxClassItem{value: false, error: error}
    }
    if escaped == (Val(80)) -> return RegexSyntaxClassItem{value: false, error: Val(regex_syntax_error(parser, "negated Unicode classes belong outside `[]` today"))}
    if escaped == None -> return RegexSyntaxClassItem{value: false, error: Val(regex_syntax_error(parser, "missing escape"))}
    RegexSyntaxClassItem{value: true, error: None}
}

fn regex_syntax_parse_class_char(parser: &RegexSyntaxParser) -> ?RegexSyntaxError {
    ch :: regex_syntax_bump(parser) ?? return Val(regex_syntax_error(parser, "missing class character"))
    if ch == 93 -> return Val(regex_syntax_error(parser, "missing class character"))
    if ch == 92 && regex_syntax_bump(parser) == None -> return Val(regex_syntax_error(parser, "missing escape"))
    None
}

fn regex_syntax_parse_escape_atom(parser: &RegexSyntaxParser) -> ?RegexSyntaxError {
    ch :: regex_syntax_bump(parser) ?? return Val(regex_syntax_error(parser, "missing escape"))
    if ch == 100 || ch == 68 || ch == 119 || ch == 87 || ch == 115 || ch == 83 -> return None
    if ch == 112 || ch == 80 -> return regex_syntax_parse_unicode_class(parser)
    if ch >= 48 && ch <= 57 -> return Val(regex_syntax_error(parser, "backreferences are not supported; captures stay linear"))
    None
}

fn regex_syntax_parse_unicode_class(parser: &RegexSyntaxParser) -> ?RegexSyntaxError {
    if regex_syntax_bump(parser) != Val(123) -> return Val(regex_syntax_error(parser, "Unicode class needs `{{...}}`"))
    start_byte := parser.byte_pos
    loop {
        ch :: regex_syntax_peek(parser) ?? break
        if ch == 125 -> break
        regex_syntax_bump(parser)
    }
    if regex_syntax_bump(parser) != Val(125) -> return Val(regex_syntax_error(parser, "missing `}}` in Unicode class"))
    end_byte :: parser.byte_pos - 1
    name :: String.from_bytes(parser.bytes[start_byte..end_byte]) ?? ""
    if name == "L" || name == "Letter" || name == "N" || name == "Number" || name == "Alphabetic" || name == "White_Space" || name == "Whitespace" -> return None
    Val(regex_syntax_error(parser, "unsupported Unicode class `{name}`"))
}

fn regex_syntax_parse_number(parser: &RegexSyntaxParser) -> RegexSyntaxNumber {
    start := parser.pos
    value := 0
    overflow := false
    loop {
        ch :: regex_syntax_peek(parser) ?? break
        if ch < 48 || ch > 57 -> break
        regex_syntax_bump(parser)
        digit :: ch - 48
        if !overflow {
            if {
                value > (@REGEX_SYNTAX_USIZE_MAX - digit) / 10 -> {
                    overflow = true
                }
                else -> {
                    value = value * 10 + digit
                }
            }
        }
    }
    if parser.pos == start -> return RegexSyntaxNumber{value: 0, error: Val(regex_syntax_error(parser, "quantifier needs a number"))}
    if overflow -> return RegexSyntaxNumber{value: 0, error: Val(regex_syntax_error_at(start, "quantifier is too large"))}
    RegexSyntaxNumber{value: value, error: None}
}

pub fn regex_syntax_validate(pattern: String) -> ?RegexSyntaxError {
    parser := RegexSyntaxParser{bytes: pattern.bytes(), byte_pos: 0, pos: 0}
    error :: regex_syntax_parse_alt(&parser, None)
    if error != None -> return error
    if parser.byte_pos != parser.bytes.len() -> return Val(regex_syntax_error(&parser, "unexpected trailing input"))
    None
}
