// Typed artifact carriers, independent of streaming compiler trace.
TraceToolchain: struct {
    jet_version: String,
    compiler_build_id: String,
    stdlib_id: String,
    runner_id: String,
}

TraceHardware: struct {
    cpu_arch: String,
    logical_cpus: U64,
    os: String,
    target: String,
}

CapturePolicy: struct {
    allowlist: [String],
    browser_rows_truncated: Bool,
    io_rows_truncated: Bool,
    native_rows_truncated: Bool,
    span_rows_truncated: Bool,
    task_rows_truncated: Bool,
}

capture_policy_default_exclusions: fn() -> CapturePolicy Never! {
    CapturePolicy{allowlist: [String]{}, browser_rows_truncated: false, io_rows_truncated: false, native_rows_truncated: false, span_rows_truncated: false, task_rows_truncated: false}
}

JetSymbolRef: struct {
    path: String,
    name: String,
}

TraceProfileSource: struct {
    path: String,
    sha256: String,
    start_line: U64,
    start_column: U64,
    end_line: U64,
    end_column: U64,
}

// One profile row: the samples of one source range on one clock.
// `inclusive_count`, when the sampler walks the stack, counts the samples
// that hold the range anywhere on it, once each however often;
// `allocation_count`, when the sampler records allocations, the allocations
// whose stack holds the range innermost of the profiled source's ranges.
// Under the memory lens each counter's count is the events of its
// samples whose stack holds the range innermost of the profiled source's
// ranges, each sample weighing the counter's period; None when the profile
// did not capture that counter, or the row is not one the samples name.
TraceProfileRow: struct {
    clock: String,
    allocation_count: U64?,
    dtlb_miss_count: U64?,
    execution_count: U64?,
    inclusive_count: U64?,
    l1d_miss_count: U64?,
    llc_miss_count: U64?,
    page_fault_count: U64?,
    sample_count: U64,
    sample_weight: U64,
    source: TraceProfileSource,
    symbol: JetSymbolRef,
}

// The counters the memory lens samples, in the order the runtime opens
// them (PerfSamples.jet perf_counter_config) and a profile lists them.
TraceCounterName: enum {
    L1dMisses,
    LlcMisses,
    DtlbMisses,
    PageFaults,
}

TRACE_COUNTERS: [TraceCounterName]{.L1dMisses, .LlcMisses, .DtlbMisses, .PageFaults}

trace_counter_name: fn(name: TraceCounterName) -> String Never! {
    if name == {
        .L1dMisses -> "l1d_misses"
        .LlcMisses -> "llc_misses"
        .DtlbMisses -> "dtlb_misses"
        .PageFaults -> "page_faults"
    }
}

// The key of the counter `name`'s count in a profile row.
trace_counter_key: fn(name: TraceCounterName) -> String Never! {
    if name == {
        .L1dMisses -> "l1d_miss_count"
        .LlcMisses -> "llc_miss_count"
        .DtlbMisses -> "dtlb_miss_count"
        .PageFaults -> "page_fault_count"
    }
}

// One counter of a profile the memory lens took: captured with a sample
// every `period` events, or unavailable because the kernel refused it with
// `errno`. An unavailable counter has no count in any row.
TraceCounter: struct {
    name: TraceCounterName,
    period: U64?,
    errno: U64?,
}

// A profile's overhead is `overhead_ns`, the sum of its two parts: what the
// runtime spent sampling (its handlers, its ring drains and the signals it
// asked for), measured, and what the kernel spent taking and writing the
// samples, estimated from timed samples. All three are None exactly when the
// overhead is not `measured`.
TraceProfile: struct {
    method: String,
    counters: [TraceCounter],
    status: String,
    coverage: String,
    rows: [TraceProfileRow],
    row_limit: U64,
    rows_truncated: Bool,
    overhead_ns: U64?,
    overhead_runtime_ns: U64?,
    overhead_kernel_ns: U64?,
    overhead_status: String,
    overhead_reason: String,
    reason: String,
    window_status: String,
    window_wall_ns: U64?,
    window_cpu_ns: U64?,
    window_reason: String,
}

trace_profile_unsupported: fn(reason: String) -> TraceProfile Never! {
    TraceProfile{
        method: "sampling",
        counters: [TraceCounter]{},
        status: "unsupported",
        coverage: "unsupported",
        rows: [TraceProfileRow]{},
        row_limit: U64{4096},
        rows_truncated: false,
        overhead_ns: None,
        overhead_runtime_ns: None,
        overhead_kernel_ns: None,
        overhead_status: "not_applicable",
        overhead_reason: "source sampling was not available",
        reason: reason,
        window_status: "unavailable",
        window_wall_ns: None,
        window_cpu_ns: None,
        window_reason: "the runtime published no run window",
    }
}

TraceSample: struct {
    domain: String,
    duration_ns: U64,
    symbol: JetSymbolRef,
}

TraceGameFunctionSource: struct {
    source_id: String,
    file: String,
    start_line: U64,
    start_column: U64,
    end_line: U64,
    end_column: U64,
}

TraceGameFunction: struct {
    function_id: String,
    name: String,
    source: TraceGameFunctionSource,
}

TraceGameFrame: struct {
    sequence: U64,
    frame_id: U64,
    scene: String,
    frame_index: U64,
    build: String,
    revision: String,
    trace_id: String,
    start_ns: U64,
    cpu_ns: U64,
    gpu_ns: U64?,
    responsible_function: TraceGameFunction?,
}

TraceGameDrawEvent: struct {
    sequence: U64,
    frame_id: U64,
    scene: String,
    frame_index: U64,
    build: String,
    revision: String,
    trace_id: String,
    event_index: U64,
    event_id: U64,
    function: TraceGameFunction,
    phase: String,
    domain: String,
    start_ns: U64,
    duration_ns: U64,
    object_id: String?,
    resource_id: String?,
}

TraceAllocation: struct {
    count: U64,
    bytes: U64,
    symbol: JetSymbolRef,
}

TraceTask: struct {
    id: U64,
    parent: U64,
    state: String,
    wait: String,
    canceled: Bool,
    symbol: JetSymbolRef,
}

TraceLock: struct {
    kind: String,
    id: U64,
    depth: U64,
    capacity: U64?,
    send_waiters: U64,
    recv_waiters: U64,
    closed: Bool,
    symbol: JetSymbolRef,
}

// An I/O row: one file or network transfer the program made through the
// runtime's I/O leaves under `jet perf run`, from `start_ns` to `end_ns` on
// the clock of every span. `kind` is `file` or `network`, `operation`
// `read` or `write`; `bytes` is what it moved, or 0 with the OS `error`
// (errno) that refused it. `target` is a file's path as the program named
// it (`fd N` for a descriptor the runtime holds no path for), a peer's
// `host:port` or a Unix socket's path. `task_id` is the task that made it,
// null outside every observed task; `stack` the frames of `symbol.path` on
// its stack, innermost first, and `symbol.name` its `operation` and
// `target`: `read notes.txt`.
TraceIO: struct {
    bytes: U64,
    end_ns: U64,
    error: U64?,
    kind: String,
    operation: String,
    stack: [TraceStackFrame],
    start_ns: U64,
    symbol: JetSymbolRef,
    target: String,
    task_id: U64?,
}

TraceNative: struct {
    clock: String,
    duration_ns: U64?,
    observed_at_ns: U64,
    reason: String,
    status: String,
    symbol: JetSymbolRef,
    target: String,
    task_id: U64?,
}

// A span row: a task's observed span (`task_observed`), a closed core.log
// span (`log_span`), a closed core.perf zone (`zone`), a frame mark
// (`frame_mark`), a plotted value (`plot`, whose `symbol.name` is its name
// and value: `fps = 60`) or a task's wait (`task_wait`), whose `task_id` is the
// waiting task, `symbol.name` the wait's name (`task join`, `channel
// receive`, `time sleep`, `shared lock`, `tcp read`, ...) and `wait_stack`
// the frames of `symbol.path` on its waiting stack, innermost first: the
// first is the line it waited at. A join's `awaited_task_id` is the task it
// waits for, which the line `spawn_line` spawned; a channel wait's
// `channel_id` is its channel's; a socket's wait names the socket by its own
// address `local_address` and its peer's `peer_address` (a host and port,
// or a Unix socket's path; either null when the socket has none). `waker`
// says what ended the wait: `task`, the task `waker_task_id` at its line
// `waker_line` (either null when unknown), `runtime`, outside every task,
// `peer`, a socket's peer outside the program, or `timeout`, no wake. Only
// a wait has any of these; other rows keep them null, `wait_stack` empty
// and `waker` empty.
TraceSpan: struct {
    awaited_task_id: U64?,
    channel_id: U64?,
    clock: String,
    end_ns: U64?,
    kind: String,
    local_address: String?,
    parent_task_id: U64?,
    peer_address: String?,
    reason: String,
    spawn_line: U64?,
    start_ns: U64?,
    status: String,
    symbol: JetSymbolRef,
    task_id: U64?,
    wait_stack: [TraceStackFrame],
    waker: String,
    waker_line: U64?,
    waker_task_id: U64?,
}

// One frame of a wait's or a transfer's stack: the function `name` at
// `line` of its row's `symbol.path`.
TraceStackFrame: struct {
    line: U64,
    name: String,
}

TraceBrowser: struct {
    class: String,
    duration_ns: U64,
    start_ns: U64,
    symbol: JetSymbolRef,
}

SourceIdentity: struct {
    path: String,
    sha256: String,
    symbols: [{name: String, kind: String}],
}

TraceSourceMap: struct {
    kind: String,
    path: String,
    sha256: String,
    map: String,
}

TraceReceiptSection: struct {
    name: String,
    type_name: String,
    value: CanonicalJSON,
    digest: String,
}

TraceSkeleton: struct {
    command: String,
    argv: [String],
    toolchain: TraceToolchain,
    hardware: TraceHardware,
    capture_policy: CapturePolicy,
    samples: [TraceSample],
    profile: TraceProfile,
    allocations: [TraceAllocation],
    browser: [TraceBrowser],
    game_frames: [TraceGameFrame],
    game_draw_events: [TraceGameDrawEvent],
    tasks: [TraceTask],
    locks: [TraceLock],
    io: [TraceIO],
    native: [TraceNative],
    spans: [TraceSpan],
    receipt_sections: [TraceReceiptSection],
    source_identity: [SourceIdentity],
    source_maps: [TraceSourceMap],
}

jettrace_uint: fn(value: U64) -> CanonicalJSON Never! { CanonicalJSON.Integer("{value}") }

jettrace_optional_uint: fn(value: U64?) -> CanonicalJSON Never! {
    if value == {
        .Val(number) -> jettrace_uint(number)
        .None -> CanonicalJSON.Null
    }
}

jettrace_optional_text: fn(value: String?) -> CanonicalJSON Never! {
    if value == {
        .Val(text) -> CanonicalJSON.String(text)
        .None -> CanonicalJSON.Null
    }
}

trace_toolchain_to_json: fn(value: TraceToolchain) -> CanonicalJSON JetTraceError! {
    ^fields: [CanonicalJSONField]{jettrace_field("compiler_build_id", .String(value.compiler_build_id)), jettrace_field("jet_version", .String(value.jet_version)), jettrace_field("runner_id", .String(value.runner_id)), jettrace_field("stdlib_id", .String(value.stdlib_id))}
    body: jettrace_object(fields)
    fields.push(jettrace_field("digest", .String(canonical_json_sha256(body))))
    jettrace_object(fields)
}

trace_hardware_to_json: fn(value: TraceHardware) -> CanonicalJSON JetTraceError! {
    ^fields: [CanonicalJSONField]{jettrace_field("cpu_arch", .String(value.cpu_arch)), jettrace_field("logical_cpus", jettrace_uint(value.logical_cpus)), jettrace_field("os", .String(value.os)), jettrace_field("target", .String(value.target))}
    body: jettrace_object(fields)
    fields.push(jettrace_field("fingerprint", .String(canonical_json_sha256(body))))
    jettrace_object(fields)
}

capture_policy_to_json: fn(value: CapturePolicy) -> CanonicalJSON JetTraceError! {
    ^order: loop index in 0..<value.allowlist.len() -> index
    order.sort_by(fn(left: Int, right: Int) { value.allowlist[left] <=> value.allowlist[right] })
    ^allowlist: [CanonicalJSON]{}
    loop at in 0..<order.len() {
        if at == 0 || value.allowlist[order[at]] != value.allowlist[order[at - 1]] {
            allowlist.push(.String(value.allowlist[order[at]].copy()))
        }
    }
    exclusions: loop name in DEFAULT_EXCLUSIONS -> CanonicalJSON.String(name.copy())
    jettrace_object(
        [CanonicalJSONField]{
            jettrace_field("allowlist", .Array(allowlist.move())),
            jettrace_field("browser_row_limit", jettrace_uint(TRACE_BROWSER_ROW_LIMIT)),
            jettrace_field("browser_rows_truncated", .Bool(value.browser_rows_truncated)),
            jettrace_field("default_exclusions", .Array(exclusions)),
            jettrace_field("io_row_limit", jettrace_uint(TRACE_IO_ROW_LIMIT)),
            jettrace_field("io_rows_truncated", .Bool(value.io_rows_truncated)),
            jettrace_field("native_row_limit", jettrace_uint(TRACE_NATIVE_ROW_LIMIT)),
            jettrace_field("native_rows_truncated", .Bool(value.native_rows_truncated)),
            jettrace_field("span_row_limit", jettrace_uint(TRACE_SPAN_ROW_LIMIT)),
            jettrace_field("span_rows_truncated", .Bool(value.span_rows_truncated)),
            jettrace_field("schema", .Integer(CAPTURE_POLICY_SCHEMA)),
            jettrace_field("task_row_limit", jettrace_uint(TRACE_TASK_ROW_LIMIT)),
            jettrace_field("task_rows_truncated", .Bool(value.task_rows_truncated)),
        },
    )
}

jet_symbol_ref_to_json: fn(value: JetSymbolRef) -> CanonicalJSON JetTraceError! {
    jettrace_object([CanonicalJSONField]{jettrace_field("name", .String(value.name)), jettrace_field("path", .String(value.path))})
}

trace_profile_source_to_json: fn(value: TraceProfileSource) -> CanonicalJSON JetTraceError! {
    jettrace_object([CanonicalJSONField]{jettrace_field("end_column", jettrace_uint(value.end_column)), jettrace_field("end_line", jettrace_uint(value.end_line)), jettrace_field("path", .String(value.path)), jettrace_field("sha256", .String(value.sha256)), jettrace_field("start_column", jettrace_uint(value.start_column)), jettrace_field("start_line", jettrace_uint(value.start_line))})
}

trace_profile_row_to_json: fn(value: TraceProfileRow) -> CanonicalJSON JetTraceError! {
    jettrace_object([CanonicalJSONField]{jettrace_field("allocation_count", jettrace_optional_uint(value.allocation_count)), jettrace_field("clock", .String(value.clock)), jettrace_field("dtlb_miss_count", jettrace_optional_uint(value.dtlb_miss_count)), jettrace_field("execution_count", jettrace_optional_uint(value.execution_count)), jettrace_field("inclusive_count", jettrace_optional_uint(value.inclusive_count)), jettrace_field("l1d_miss_count", jettrace_optional_uint(value.l1d_miss_count)), jettrace_field("llc_miss_count", jettrace_optional_uint(value.llc_miss_count)), jettrace_field("page_fault_count", jettrace_optional_uint(value.page_fault_count)), jettrace_field("sample_count", jettrace_uint(value.sample_count)), jettrace_field("sample_weight", jettrace_uint(value.sample_weight)), jettrace_field("source", trace_profile_source_to_json(value.source)), jettrace_field("symbol", jet_symbol_ref_to_json(value.symbol))})
}

trace_counter_to_json: fn(value: TraceCounter) -> CanonicalJSON JetTraceError! {
    status: if value.period == None -> "unavailable" else -> "captured"
    jettrace_object([CanonicalJSONField]{jettrace_field("errno", jettrace_optional_uint(value.errno)), jettrace_field("name", .String(trace_counter_name(value.name))), jettrace_field("period", jettrace_optional_uint(value.period)), jettrace_field("status", .String(status))})
}

trace_profile_to_json: fn(value: TraceProfile) -> CanonicalJSON JetTraceError! {
    counters: loop counter in value.counters -> trace_counter_to_json(counter)
    rows: loop row in value.rows -> trace_profile_row_to_json(row)
    jettrace_object([CanonicalJSONField]{jettrace_field("counters", .Array(counters)), jettrace_field("coverage", .String(value.coverage)), jettrace_field("method", .String(value.method)), jettrace_field("overhead_kernel_ns", jettrace_optional_uint(value.overhead_kernel_ns)), jettrace_field("overhead_ns", jettrace_optional_uint(value.overhead_ns)), jettrace_field("overhead_reason", .String(value.overhead_reason)), jettrace_field("overhead_runtime_ns", jettrace_optional_uint(value.overhead_runtime_ns)), jettrace_field("overhead_status", .String(value.overhead_status)), jettrace_field("reason", .String(value.reason)), jettrace_field("row_limit", jettrace_uint(value.row_limit)), jettrace_field("rows", .Array(rows)), jettrace_field("rows_truncated", .Bool(value.rows_truncated)), jettrace_field("status", .String(value.status)), jettrace_field("window_cpu_ns", jettrace_optional_uint(value.window_cpu_ns)), jettrace_field("window_reason", .String(value.window_reason)), jettrace_field("window_status", .String(value.window_status)), jettrace_field("window_wall_ns", jettrace_optional_uint(value.window_wall_ns))})
}

trace_sample_to_json: fn(value: TraceSample) -> CanonicalJSON JetTraceError! {
    jettrace_object([CanonicalJSONField]{jettrace_field("domain", .String(value.domain)), jettrace_field("duration_ns", jettrace_uint(value.duration_ns)), jettrace_field("symbol", jet_symbol_ref_to_json(value.symbol))})
}

trace_game_function_source_to_json: fn(value: TraceGameFunctionSource) -> CanonicalJSON JetTraceError! {
    jettrace_object([CanonicalJSONField]{jettrace_field("end_column", jettrace_uint(value.end_column)), jettrace_field("end_line", jettrace_uint(value.end_line)), jettrace_field("file", .String(value.file)), jettrace_field("source_id", .String(value.source_id)), jettrace_field("start_column", jettrace_uint(value.start_column)), jettrace_field("start_line", jettrace_uint(value.start_line))})
}

trace_game_function_to_json: fn(value: TraceGameFunction) -> CanonicalJSON JetTraceError! {
    jettrace_object([CanonicalJSONField]{jettrace_field("function_id", .String(value.function_id)), jettrace_field("name", .String(value.name)), jettrace_field("source", trace_game_function_source_to_json(value.source))})
}

trace_game_frame_to_json: fn(value: TraceGameFrame) -> CanonicalJSON JetTraceError! {
    function: if value.responsible_function == {
        .Val(item) -> trace_game_function_to_json(item)
        .None -> CanonicalJSON.Null
    }
    jettrace_object([CanonicalJSONField]{jettrace_field("build", .String(value.build)), jettrace_field("cpu_ns", jettrace_uint(value.cpu_ns)), jettrace_field("frame_id", jettrace_uint(value.frame_id)), jettrace_field("frame_index", jettrace_uint(value.frame_index)), jettrace_field("gpu_ns", jettrace_optional_uint(value.gpu_ns)), jettrace_field("responsible_function", function), jettrace_field("revision", .String(value.revision)), jettrace_field("scene", .String(value.scene)), jettrace_field("sequence", jettrace_uint(value.sequence)), jettrace_field("start_ns", jettrace_uint(value.start_ns)), jettrace_field("trace_id", .String(value.trace_id))})
}

trace_game_draw_event_to_json: fn(value: TraceGameDrawEvent) -> CanonicalJSON JetTraceError! {
    jettrace_object([CanonicalJSONField]{jettrace_field("build", .String(value.build)), jettrace_field("domain", .String(value.domain)), jettrace_field("duration_ns", jettrace_uint(value.duration_ns)), jettrace_field("event_id", jettrace_uint(value.event_id)), jettrace_field("event_index", jettrace_uint(value.event_index)), jettrace_field("frame_id", jettrace_uint(value.frame_id)), jettrace_field("frame_index", jettrace_uint(value.frame_index)), jettrace_field("function", trace_game_function_to_json(value.function)), jettrace_field("object_id", jettrace_optional_text(value.object_id)), jettrace_field("phase", .String(value.phase)), jettrace_field("resource_id", jettrace_optional_text(value.resource_id)), jettrace_field("revision", .String(value.revision)), jettrace_field("scene", .String(value.scene)), jettrace_field("sequence", jettrace_uint(value.sequence)), jettrace_field("start_ns", jettrace_uint(value.start_ns)), jettrace_field("trace_id", .String(value.trace_id))})
}

trace_allocation_to_json: fn(value: TraceAllocation) -> CanonicalJSON JetTraceError! {
    jettrace_object([CanonicalJSONField]{jettrace_field("bytes", jettrace_uint(value.bytes)), jettrace_field("count", jettrace_uint(value.count)), jettrace_field("symbol", jet_symbol_ref_to_json(value.symbol))})
}

trace_task_to_json: fn(value: TraceTask) -> CanonicalJSON JetTraceError! {
    jettrace_object([CanonicalJSONField]{jettrace_field("canceled", .Bool(value.canceled)), jettrace_field("id", jettrace_uint(value.id)), jettrace_field("parent", jettrace_uint(value.parent)), jettrace_field("state", .String(value.state)), jettrace_field("symbol", jet_symbol_ref_to_json(value.symbol)), jettrace_field("wait", .String(value.wait))})
}

trace_lock_to_json: fn(value: TraceLock) -> CanonicalJSON JetTraceError! {
    jettrace_object([CanonicalJSONField]{jettrace_field("capacity", jettrace_optional_uint(value.capacity)), jettrace_field("closed", .Bool(value.closed)), jettrace_field("depth", jettrace_uint(value.depth)), jettrace_field("id", jettrace_uint(value.id)), jettrace_field("kind", .String(value.kind)), jettrace_field("recv_waiters", jettrace_uint(value.recv_waiters)), jettrace_field("send_waiters", jettrace_uint(value.send_waiters)), jettrace_field("symbol", jet_symbol_ref_to_json(value.symbol))})
}

trace_io_to_json: fn(value: TraceIO) -> CanonicalJSON JetTraceError! {
    jettrace_object([CanonicalJSONField]{jettrace_field("bytes", jettrace_uint(value.bytes)), jettrace_field("end_ns", jettrace_uint(value.end_ns)), jettrace_field("error", jettrace_optional_uint(value.error)), jettrace_field("kind", .String(value.kind)), jettrace_field("operation", .String(value.operation)), jettrace_field("stack", trace_stack_to_json(value.stack)), jettrace_field("start_ns", jettrace_uint(value.start_ns)), jettrace_field("symbol", jet_symbol_ref_to_json(value.symbol)), jettrace_field("target", .String(value.target)), jettrace_field("task_id", jettrace_optional_uint(value.task_id))})
}

// A row's stack: each frame's line and function, innermost first.
trace_stack_to_json: fn(frames: [TraceStackFrame]) -> CanonicalJSON JetTraceError! {
    .Array(loop frame in frames -> jettrace_object([CanonicalJSONField]{jettrace_field("line", jettrace_uint(frame.line)), jettrace_field("name", .String(frame.name.copy()))}))
}

trace_native_to_json: fn(value: TraceNative) -> CanonicalJSON JetTraceError! {
    jettrace_object([CanonicalJSONField]{jettrace_field("clock", .String(value.clock)), jettrace_field("duration_ns", jettrace_optional_uint(value.duration_ns)), jettrace_field("observed_at_ns", jettrace_uint(value.observed_at_ns)), jettrace_field("reason", .String(value.reason)), jettrace_field("status", .String(value.status)), jettrace_field("symbol", jet_symbol_ref_to_json(value.symbol)), jettrace_field("target", .String(value.target)), jettrace_field("task_id", jettrace_optional_uint(value.task_id))})
}

trace_span_to_json: fn(value: TraceSpan) -> CanonicalJSON JetTraceError! {
    jettrace_object([CanonicalJSONField]{jettrace_field("awaited_task_id", jettrace_optional_uint(value.awaited_task_id)), jettrace_field("channel_id", jettrace_optional_uint(value.channel_id)), jettrace_field("clock", .String(value.clock)), jettrace_field("end_ns", jettrace_optional_uint(value.end_ns)), jettrace_field("kind", .String(value.kind)), jettrace_field("local_address", jettrace_optional_text(value.local_address)), jettrace_field("parent_task_id", jettrace_optional_uint(value.parent_task_id)), jettrace_field("peer_address", jettrace_optional_text(value.peer_address)), jettrace_field("reason", .String(value.reason)), jettrace_field("spawn_line", jettrace_optional_uint(value.spawn_line)), jettrace_field("start_ns", jettrace_optional_uint(value.start_ns)), jettrace_field("status", .String(value.status)), jettrace_field("symbol", jet_symbol_ref_to_json(value.symbol)), jettrace_field("task_id", jettrace_optional_uint(value.task_id)), jettrace_field("wait_stack", trace_stack_to_json(value.wait_stack)), jettrace_field("waker", .String(value.waker)), jettrace_field("waker_line", jettrace_optional_uint(value.waker_line)), jettrace_field("waker_task_id", jettrace_optional_uint(value.waker_task_id))})
}

trace_browser_to_json: fn(value: TraceBrowser) -> CanonicalJSON JetTraceError! {
    jettrace_object([CanonicalJSONField]{jettrace_field("class", .String(value.class)), jettrace_field("clock", .String("browser_monotonic_mapped")), jettrace_field("duration_ns", jettrace_uint(value.duration_ns)), jettrace_field("start_ns", jettrace_uint(value.start_ns)), jettrace_field("symbol", jet_symbol_ref_to_json(value.symbol))})
}

source_identity_to_json: fn(value: SourceIdentity) -> CanonicalJSON JetTraceError! {
    ^order: [Int]{}
    loop index in 0..<value.symbols.len() -> order.push(index)
    order.sort_by(fn(left: Int, right: Int) { value.symbols[left] <=> value.symbols[right] })
    ^symbols: [CanonicalJSON]{}
    loop index in order {
        pair: value.symbols[index]
        symbols.push(jettrace_object([CanonicalJSONField]{jettrace_field("kind", .String(pair.kind.copy())), jettrace_field("name", .String(pair.name.copy()))}))
    }
    jettrace_object([CanonicalJSONField]{jettrace_field("path", .String(value.path)), jettrace_field("sha256", .String(value.sha256)), jettrace_field("symbols", .Array(symbols.move()))})
}

trace_source_map_from_map_bytes: fn(kind: ^^String, path: ^^String, map: ^^String) -> TraceSourceMap Never! {
    raw: map.bytes()
    hash: sha256_bytes(raw[0..<raw.len()])
    digest: sha256_hex_bytes(hash[0..<hash.len()])
    TraceSourceMap{kind: kind.move(), path: path.move(), sha256: digest, map: map.move()}
}

trace_source_map_jet_with_source: fn(path: ^^String, source: String) -> TraceSourceMap JetTraceError! {
    map: jettrace_object([CanonicalJSONField]{jettrace_field("file", .String(path)), jettrace_field("mappings", .String("")), jettrace_field("names", .Array([CanonicalJSON]{})), jettrace_field("sources", .Array([CanonicalJSON]{.String(path)})), jettrace_field("sourcesContent", .Array([CanonicalJSON]{.String(source)})), jettrace_field("version", .Integer("3"))})
    text: String.from_bytes(canonical_json_bytes(map)) ?? return Err(jettrace_error("canonical json is not utf-8"))
    Ok(trace_source_map_from_map_bytes("jet", path, text))
}

trace_source_map_to_json: fn(value: TraceSourceMap) -> CanonicalJSON JetTraceError! {
    jettrace_object([CanonicalJSONField]{jettrace_field("kind", .String(value.kind)), jettrace_field("map", .String(value.map)), jettrace_field("path", .String(value.path)), jettrace_field("sha256", .String(value.sha256))})
}

trace_receipt_section_to_json: fn(value: TraceReceiptSection) -> CanonicalJSON JetTraceError! {
    jettrace_object([CanonicalJSONField]{jettrace_field("digest", .String(value.digest)), jettrace_field("name", .String(value.name)), jettrace_field("type_name", .String(value.type_name)), jettrace_field("value", value.value)})
}

trace_receipt_section_from_json: fn(value: CanonicalJSON) -> TraceReceiptSection JetTraceError! {
    trace_receipt_section_from_json_at(value, "trace receipt section")
}
