// One indexed task table shared by all causal domains.
JetTraceTaskFact: struct {
    parent: U64,
    state: String,
    wait: String,
    symbol: CanonicalJSON,
}

jettrace_validate_tasks: fn(value: CanonicalJSON, limit: Int) -> [U64:JetTraceTaskFact] JetTraceError! {
    items: jettrace_array(value, "content.tasks")
    if items.len() > limit {
        return Err(jettrace_error("content.tasks exceeds capture_policy.task_row_limit"))
    }
    tasks := [U64:JetTraceTaskFact]{}
    ids := [U64]{}
    loop index in 0..<items.len() {
        label: "content.tasks[{index}]"
        fields: jettrace_object_keys(items[index], label, [String]{"canceled", "id", "parent", "state", "symbol", "wait"})
        id: jettrace_unsigned(fields[jettrace_get(fields, "id")].value, "{label}.id")
        if id == (U64{0}) -> return Err(jettrace_error("{label}.id must be greater than zero"))
        parent: jettrace_unsigned(fields[jettrace_get(fields, "parent")].value, "{label}.parent")
        if id == parent -> return Err(jettrace_error("{label}.parent cannot be self"))
        state: jettrace_text(fields[jettrace_get(fields, "state")].value, "{label}.state")
        if state != "running" && state != "queued" && state != "blocked" && state != "done" {
            return Err(jettrace_error("{label}.state must be a live observe task state"))
        }
        wait: jettrace_text(fields[jettrace_get(fields, "wait")].value, "{label}.wait")
        _: jettrace_bool(fields[jettrace_get(fields, "canceled")].value, "{label}.canceled")
        symbol: fields[jettrace_get(fields, "symbol")].value
        jettrace_validate_symbol(symbol, "{label}.symbol")
        if tasks.has_key(id) -> return Err(jettrace_error("{label}.id duplicates task {id}"))
        tasks[id] = JetTraceTaskFact{parent: parent, state: state.move(), wait: wait.move(), symbol: symbol.copy()}
        ids.push(id)
    }
    ids.sort()
    // Sorted root order preserves Rust's first diagnostic. Three-color walks
    // memoize finished chains: no repeated traversal of every prior ancestor.
    finished := [U64:Bool]{}
    visiting := [U64:Bool]{}
    loop id in ids {
        parent: tasks[id].parent
        if parent != (U64{0}) && !tasks.has_key(parent) {
            return Err(jettrace_error("content.tasks task {id} has missing parent {parent}"))
        }
        chain := [U64]{}
        current := id
        loop tasks.has_key(current) {
            if finished.has_key(current) -> break
            next_parent: tasks[current].parent
            if next_parent == (U64{0}) -> break
            if visiting.has_key(current) {
                return Err(jettrace_error("content.tasks task {id} has cyclic parent causality"))
            }
            visiting[current] = true
            chain.push(current)
            current = next_parent
        }
        loop vertex in chain -> finished[vertex] = true
    }
    Ok(tasks)
}

jettrace_validate_locks: fn(value: CanonicalJSON) JetTraceError! {
    items: jettrace_array(value, "content.locks")
    loop index in 0..<items.len() {
        label: "content.locks[{index}]"
        fields: jettrace_object_keys(items[index], label, [String]{"capacity", "closed", "depth", "id", "kind", "recv_waiters", "send_waiters", "symbol"})
        if jettrace_text(fields[jettrace_get(fields, "kind")].value, "{label}.kind") != "channel" {
            return Err(jettrace_error("{label}.kind must be channel"))
        }
        _: jettrace_unsigned(fields[jettrace_get(fields, "id")].value, "{label}.id")
        _: jettrace_unsigned(fields[jettrace_get(fields, "depth")].value, "{label}.depth")
        capacity: fields[jettrace_get(fields, "capacity")].value
        if capacity != CanonicalJSON.Null -> _: jettrace_unsigned(capacity, "{label}.capacity")
        send: jettrace_unsigned(fields[jettrace_get(fields, "send_waiters")].value, "{label}.send_waiters")
        recv: jettrace_unsigned(fields[jettrace_get(fields, "recv_waiters")].value, "{label}.recv_waiters")
        if send == (U64{0}) && recv == (U64{0}) {
            return Err(jettrace_error("{label} has no waiters (idle channel is not a lock fact)"))
        }
        _: jettrace_bool(fields[jettrace_get(fields, "closed")].value, "{label}.closed")
        jettrace_validate_symbol(fields[jettrace_get(fields, "symbol")].value, "{label}.symbol")
    }
    return
}

// Each I/O row is one transfer the runtime recorded (Carriers.jet TraceIO):
// a file or network read or write of a target, that moved its bytes or
// failed with an errno and moved none, made by a known task or by none.
jettrace_validate_io: fn(value: CanonicalJSON, tasks: [U64:JetTraceTaskFact], limit: Int) JetTraceError! {
    items: jettrace_array(value, "content.io")
    if items.len() > limit {
        return Err(jettrace_error("content.io exceeds capture_policy.io_row_limit"))
    }
    loop index in 0..<items.len() {
        label: "content.io[{index}]"
        fields: jettrace_object_keys(items[index], label, [String]{"bytes", "end_ns", "error", "kind", "operation", "stack", "start_ns", "symbol", "target", "task_id"})
        kind: jettrace_text(fields[jettrace_get(fields, "kind")].value, "{label}.kind")
        if kind != "file" && kind != "network" {
            return Err(jettrace_error("{label}.kind must be file or network"))
        }
        operation: jettrace_text(fields[jettrace_get(fields, "operation")].value, "{label}.operation")
        if operation != "read" && operation != "write" {
            return Err(jettrace_error("{label}.operation must be read or write"))
        }
        if jettrace_text(fields[jettrace_get(fields, "target")].value, "{label}.target").len() == 0 {
            return Err(jettrace_error("{label}.target is empty (a transfer names what it moved bytes to or from)"))
        }
        start: jettrace_unsigned(fields[jettrace_get(fields, "start_ns")].value, "{label}.start_ns")
        end: jettrace_unsigned(fields[jettrace_get(fields, "end_ns")].value, "{label}.end_ns")
        if end < start -> return Err(jettrace_error("{label}.end_ns precedes start_ns"))
        bytes: jettrace_unsigned(fields[jettrace_get(fields, "bytes")].value, "{label}.bytes")
        error: fields[jettrace_get(fields, "error")].value
        if error != CanonicalJSON.Null {
            if jettrace_unsigned(error, "{label}.error") == (U64{0}) {
                return Err(jettrace_error("{label}.error must be an errno, from 1"))
            }
            if bytes != (U64{0}) {
                return Err(jettrace_error("{label} failed transfer must move no bytes"))
            }
        }
        task: fields[jettrace_get(fields, "task_id")].value
        if task != CanonicalJSON.Null {
            id: jettrace_unsigned(task, "{label}.task_id")
            if !tasks.has_key(id) {
                return Err(jettrace_error("{label}.task_id refers to missing task {id}"))
            }
        }
        jettrace_validate_stack(jettrace_array(fields[jettrace_get(fields, "stack")].value, "{label}.stack"), "{label}.stack")
        jettrace_validate_symbol(fields[jettrace_get(fields, "symbol")].value, "{label}.symbol")
    }
    return
}

// A row's stack (Carriers.jet TraceStackFrame): each frame a line, from 1,
// and the function at it.
jettrace_validate_stack: fn(stack: View<CanonicalJSON>, label: String) JetTraceError! {
    loop at in 0..<stack.len() {
        frame: jettrace_object_keys(stack[at], "{label}[{at}]", [String]{"line", "name"})
        if jettrace_unsigned(frame[jettrace_get(frame, "line")].value, "{label}[{at}].line") == (U64{0}) {
            return Err(jettrace_error("{label}[{at}].line must be a line, from 1"))
        }
        if jettrace_text(frame[jettrace_get(frame, "name")].value, "{label}[{at}].name").len() == 0 {
            return Err(jettrace_error("{label}[{at}].name must name a function"))
        }
    }
    return
}

jettrace_validate_native: fn(value: CanonicalJSON, tasks: [U64:JetTraceTaskFact], limit: Int) JetTraceError! {
    items: jettrace_array(value, "content.native")
    if items.len() > limit {
        return Err(jettrace_error("content.native exceeds capture_policy.native_row_limit"))
    }
    loop index in 0..<items.len() {
        label: "content.native[{index}]"
        fields: jettrace_object_keys(items[index], label, [String]{"clock", "duration_ns", "observed_at_ns", "reason", "status", "symbol", "target", "task_id"})
        if jettrace_text(fields[jettrace_get(fields, "clock")].value, "{label}.clock") != "process_cpu" {
            return Err(jettrace_error("{label}.clock must be process_cpu"))
        }
        _: jettrace_unsigned(fields[jettrace_get(fields, "observed_at_ns")].value, "{label}.observed_at_ns")
        reason: jettrace_text(fields[jettrace_get(fields, "reason")].value, "{label}.reason")
        status: jettrace_text(fields[jettrace_get(fields, "status")].value, "{label}.status")
        if jettrace_text(fields[jettrace_get(fields, "target")].value, "{label}.target").len() == 0 {
            return Err(jettrace_error("{label}.target is empty"))
        }
        symbol: fields[jettrace_get(fields, "symbol")].value
        jettrace_validate_symbol(symbol, "{label}.symbol")
        if {
            status == "captured" -> {
                _: jettrace_unsigned(fields[jettrace_get(fields, "duration_ns")].value, "{label}.duration_ns")
                id: jettrace_unsigned(fields[jettrace_get(fields, "task_id")].value, "{label}.task_id")
                if !tasks.has_key(id) {
                    return Err(jettrace_error("{label}.task_id refers to missing task {id}"))
                }
                if tasks[id].parent != (U64{0}) {
                    return Err(jettrace_error("{label}.task_id must identify the root task"))
                }
                if symbol != tasks[id].symbol {
                    return Err(jettrace_error("{label}.symbol does not match its task"))
                }
                if reason.len() != 0 {
                    return Err(jettrace_error("{label}.reason must be empty when captured"))
                }
            }
            status == "unavailable" -> {
                if fields[jettrace_get(fields, "duration_ns")].value != CanonicalJSON.Null || fields[jettrace_get(fields, "task_id")].value != CanonicalJSON.Null {
                    return Err(jettrace_error("{label} unavailable timing must not claim data"))
                }
                if reason.len() == 0 -> return Err(jettrace_error("{label}.reason is empty"))
            }
            else -> return Err(jettrace_error("{label}.status must be captured or unavailable"))
        }
    }
    return
}

// A span row is a task's observed span (`task_observed`), whose unavailable
// state is the only task row, a closed core.log span (`log_span`):
// captured, timed, and of no task, or a task's wait (`task_wait`):
// captured, timed, of its waiting task, naming the task it awaits when it
// is a join, with the line that spawned that task when known, its stack's
// functions and lines, and what ended it (`waker`): a task, the runtime or
// its timeout, which has no waker's task or line. Only a wait names an
// awaited task, a spawn line, a channel, a stack or a waker.
jettrace_validate_spans: fn(value: CanonicalJSON, tasks: [U64:JetTraceTaskFact], limit: Int) JetTraceError! {
    items: jettrace_array(value, "content.spans")
    if items.len() > limit {
        return Err(jettrace_error("content.spans exceeds capture_policy.span_row_limit"))
    }
    captured := 0
    unavailable := 0
    loop index in 0..<items.len() {
        label: "content.spans[{index}]"
        fields: jettrace_object_keys(items[index], label, [String]{"awaited_task_id", "channel_id", "clock", "end_ns", "kind", "parent_task_id", "reason", "spawn_line", "start_ns", "status", "symbol", "task_id", "wait_stack", "waker", "waker_line", "waker_task_id"})
        if jettrace_text(fields[jettrace_get(fields, "clock")].value, "{label}.clock") != "monotonic" {
            return Err(jettrace_error("{label}.clock must be monotonic"))
        }
        kind: jettrace_text(fields[jettrace_get(fields, "kind")].value, "{label}.kind")
        reason: jettrace_text(fields[jettrace_get(fields, "reason")].value, "{label}.reason")
        status: jettrace_text(fields[jettrace_get(fields, "status")].value, "{label}.status")
        symbol: fields[jettrace_get(fields, "symbol")].value
        jettrace_validate_symbol(symbol, "{label}.symbol")
        awaited: fields[jettrace_get(fields, "awaited_task_id")].value
        spawn_line: fields[jettrace_get(fields, "spawn_line")].value
        channel: fields[jettrace_get(fields, "channel_id")].value
        stack: jettrace_array(fields[jettrace_get(fields, "wait_stack")].value, "{label}.wait_stack")
        waker: jettrace_text(fields[jettrace_get(fields, "waker")].value, "{label}.waker")
        waker_line: fields[jettrace_get(fields, "waker_line")].value
        waker_task: fields[jettrace_get(fields, "waker_task_id")].value
        if kind == "task_wait" {
            if status != "captured" {
                return Err(jettrace_error("{label}.status must be captured for a wait"))
            }
            start: jettrace_unsigned(fields[jettrace_get(fields, "start_ns")].value, "{label}.start_ns")
            end: jettrace_unsigned(fields[jettrace_get(fields, "end_ns")].value, "{label}.end_ns")
            if end < start -> return Err(jettrace_error("{label} ends before it starts"))
            id: jettrace_unsigned(fields[jettrace_get(fields, "task_id")].value, "{label}.task_id")
            if !tasks.has_key(id) {
                return Err(jettrace_error("{label}.task_id refers to missing task {id}"))
            }
            if awaited != CanonicalJSON.Null {
                awaited_id: jettrace_unsigned(awaited, "{label}.awaited_task_id")
                if !tasks.has_key(awaited_id) {
                    return Err(jettrace_error("{label}.awaited_task_id refers to missing task {awaited_id}"))
                }
                if awaited_id == id {
                    return Err(jettrace_error("{label} join must not await its own task"))
                }
            }
            if spawn_line != CanonicalJSON.Null {
                if awaited == CanonicalJSON.Null {
                    return Err(jettrace_error("{label}.spawn_line needs an awaited task"))
                }
                if jettrace_unsigned(spawn_line, "{label}.spawn_line") == (U64{0}) {
                    return Err(jettrace_error("{label}.spawn_line must be a line, from 1"))
                }
            }
            if channel != CanonicalJSON.Null {
                _ := jettrace_unsigned(channel, "{label}.channel_id")
            }
            jettrace_validate_stack(stack, "{label}.wait_stack")
            if {
                waker == "task" -> {
                    if waker_task != CanonicalJSON.Null {
                        waker_id: jettrace_unsigned(waker_task, "{label}.waker_task_id")
                        if !tasks.has_key(waker_id) {
                            return Err(jettrace_error("{label}.waker_task_id refers to missing task {waker_id}"))
                        }
                    }
                }
                waker == "runtime" -> {
                    if waker_task != CanonicalJSON.Null {
                        return Err(jettrace_error("{label} the runtime's wake names no task"))
                    }
                }
                waker == "timeout" -> {
                    if waker_task != CanonicalJSON.Null || waker_line != CanonicalJSON.Null {
                        return Err(jettrace_error("{label} a timeout names no waker"))
                    }
                }
                else -> return Err(jettrace_error("{label}.waker must be task, runtime or timeout"))
            }
            if waker_line != CanonicalJSON.Null && jettrace_unsigned(waker_line, "{label}.waker_line") == (U64{0}) {
                return Err(jettrace_error("{label}.waker_line must be a line, from 1"))
            }
            if fields[jettrace_get(fields, "parent_task_id")].value != CanonicalJSON.Null {
                return Err(jettrace_error("{label} wait must not claim a parent"))
            }
            if reason.len() != 0 {
                return Err(jettrace_error("{label}.reason must be empty when captured"))
            }
            next
        }
        if awaited != CanonicalJSON.Null || spawn_line != CanonicalJSON.Null || channel != CanonicalJSON.Null || stack.len() != 0 || waker_line != CanonicalJSON.Null || waker_task != CanonicalJSON.Null || waker.len() != 0 {
            return Err(jettrace_error("{label} only a wait names an awaited task, a spawn line, a channel, a stack or a waker"))
        }
        if kind == "log_span" {
            if status != "captured" {
                return Err(jettrace_error("{label}.status must be captured for a log span"))
            }
            start: jettrace_unsigned(fields[jettrace_get(fields, "start_ns")].value, "{label}.start_ns")
            end: jettrace_unsigned(fields[jettrace_get(fields, "end_ns")].value, "{label}.end_ns")
            if end < start -> return Err(jettrace_error("{label} ends before it starts"))
            if fields[jettrace_get(fields, "task_id")].value != CanonicalJSON.Null || fields[jettrace_get(fields, "parent_task_id")].value != CanonicalJSON.Null {
                return Err(jettrace_error("{label} log span must not claim a task"))
            }
            if reason.len() != 0 {
                return Err(jettrace_error("{label}.reason must be empty when captured"))
            }
            next
        }
        if kind != "task_observed" {
            return Err(jettrace_error("{label}.kind must be task_observed, log_span or task_wait"))
        }
        if {
            status == "captured" -> {
                captured += 1
                start: jettrace_unsigned(fields[jettrace_get(fields, "start_ns")].value, "{label}.start_ns")
                end: jettrace_unsigned(fields[jettrace_get(fields, "end_ns")].value, "{label}.end_ns")
                if end < start -> return Err(jettrace_error("{label} ends before it starts"))
                id: jettrace_unsigned(fields[jettrace_get(fields, "task_id")].value, "{label}.task_id")
                if !tasks.has_key(id) {
                    return Err(jettrace_error("{label}.task_id refers to missing task {id}"))
                }
                task_fact: tasks[id]
                if symbol != task_fact.symbol {
                    return Err(jettrace_error("{label}.symbol does not match its task"))
                }
                if task_fact.parent == (U64{0}) {
                    if fields[jettrace_get(fields, "parent_task_id")].value != CanonicalJSON.Null {
                        return Err(jettrace_error("{label} root span must not claim a parent"))
                    }
                } else {
                    parent: jettrace_unsigned(fields[jettrace_get(fields, "parent_task_id")].value, "{label}.parent_task_id")
                    if parent != task_fact.parent || !tasks.has_key(parent) {
                        return Err(jettrace_error("{label}.parent_task_id does not match its task"))
                    }
                }
                if reason.len() != 0 {
                    return Err(jettrace_error("{label}.reason must be empty when captured"))
                }
            }
            status == "unavailable" -> {
                unavailable += 1
                if fields[jettrace_get(fields, "start_ns")].value != CanonicalJSON.Null || fields[jettrace_get(fields, "end_ns")].value != CanonicalJSON.Null || fields[jettrace_get(fields, "task_id")].value != CanonicalJSON.Null || fields[jettrace_get(fields, "parent_task_id")].value != CanonicalJSON.Null {
                    return Err(jettrace_error("{label} unavailable span must not claim data"))
                }
                if reason.len() == 0 -> return Err(jettrace_error("{label}.reason is empty"))
            }
            else -> return Err(jettrace_error("{label}.status must be captured or unavailable"))
        }
    }
    if unavailable > 1 || (unavailable == 1 && captured != 0) {
        return Err(jettrace_error("content.spans unavailable state must be the only task row"))
    }
    return
}
