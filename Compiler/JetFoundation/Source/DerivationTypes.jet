// Canonical derivation/frame resource types shared by compiler MIR and runtime
// evidence. Declarations moved intact from MIR.jet; no parallel carrier schema.

enum MIRResourceAccessMode { Read Write Move }

enum MIRResourceIdentity { Named(name: String) Unknown }

enum MIRResourceRegion {
    Whole
    Bytes(start: Int, length: Int)
    Unknown
}

struct MIRResourceLayout {
    size: Int
    align: Int
    layout: String
    device: String
}

struct MIRResourceAccess {
    resource: MIRResourceIdentity
    mode: MIRResourceAccessMode
    region: MIRResourceRegion
    layout: MIRResourceLayout?
    temporary: Bool
}

enum MIRFrameCompletion {
    Synchronous
    Pending(token: String)
    Event(token: String)
}

struct MIRFrameOperation {
    name: String
    source_index: Int
    accesses: [MIRResourceAccess]
    completion: MIRFrameCompletion
    completion_provider: String?
    external_effect: Bool
}

struct MIRFrameDependency {
    before: Int
    after: Int
    resource: String
    reason: String
}

struct MIRFrameTransfer {
    before: Int
    after: Int
    resource: String
    from_device: String
    to_device: String
}

struct MIRFrameReuse {
    previous_resource: String
    next_resource: String
    previous_last_use: Int
    next_first_use: Int
    legal: Bool
    reason: String
}

struct MIRFrameRetention {
    resource: String
    operation: Int
    owner: String
    completion_token: String?
    completed: Bool
}

struct MIRFrameSchedule {
    operations: [MIRFrameOperation]
    dependencies: [MIRFrameDependency]
    transfers: [MIRFrameTransfer]
    reuse: [MIRFrameReuse]
    retentions: [MIRFrameRetention]
    conservative: [String]
}

enum MIRDerivationMethod { StaticDerivation FormalProof RecordedExecution SampledAgreement ExternalAssumption }

enum MIRDerivationDisposition { Current Stale Expired Redacted Unavailable Unsupported BudgetExhausted Unknown }

struct MIRDerivationRef { id: String }
