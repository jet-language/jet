// How a derivation record was established and whether it still holds; shared
// by compile-time derivations and runtime evidence. Each case number is the
// byte the evidence codec writes for it.

#[Specified, Layout(U8)]
DerivationMethod: enum {
    StaticDerivation = 0
    FormalProof = 1
    RecordedExecution = 2
    SampledAgreement = 3
    ExternalAssumption = 4
}

#[Specified, Layout(U8)]
DerivationDisposition: enum {
    Current = 0
    Stale = 1
    Expired = 2
    Redacted = 3
    Unavailable = 4
    Unsupported = 5
    BudgetExhausted = 6
    Unknown = 7
}
