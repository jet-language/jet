// The explicit stack every compiler entry point runs on. Reentrant entries run
// inline; session-local state is captured/restored by the installing crate.
use std.cell.[Cell]
use std.thread as thread
use std.panic as unwind
use std.sync.[Mutex, PoisonError]
use std.sync.atomic.[AtomicUsize, Ordering]
use JetFoundation.Diagnostics.[MAX_SOURCE_NESTING, ice]

// Rust: crates/jet-foundation/src/CompilerStack.rs:37
// GATE #4494: native thread-local cells; this flag is established on the worker.
thread_local ON_COMPILER_WORKER: Cell<Bool> = Cell.new(false)

// Rust: crates/jet-foundation/src/CompilerStack.rs:80
// 256 sema frames at ~680 KiB require 170 MiB; remaining space covers lowering.
// This answers stack overflow, not missing panic handlers/unwind metadata.
pub const COMPILER_STACK_SIZE: Int = 192 * 1024 * 1024
// Rust: crates/jet-foundation/src/CompilerStack.rs:83
#Assert(COMPILER_STACK_SIZE >= MAX_SOURCE_NESTING * 680 * 1024,
    "the compiler worker stack must cover the deepest nesting the front end accepts")

// Rust: crates/jet-foundation/src/CompilerStack.rs:92
pub fn on_compiler_worker() -> Bool Never! {
    // GATE #4494: native TLS lookup, never a process-global flag.
    ON_COMPILER_WORKER.with(fn(active) { active.get() })
}

// Rust: crates/jet-foundation/src/CompilerStack.rs:144
pub fn run_on_compiler_stack<R: Send>(work: FnOnce() -> R + Send) -> R Never! {
    if on_compiler_worker() -> return work()
    // GATE #4494: scoped native thread creation and unchanged panic transport.
    outcome :: thread.scope(fn(scope) {
        worker :: thread.Builder.new().name("jet-compiler")
            .stack_size(COMPILER_STACK_SIZE).spawn_scoped(scope, fn() {
                ON_COMPILER_WORKER.with(fn(active) { active.set(true) })
                // Capture directly around work: the scoped thread never exits
                // panicking, and scope cannot replace the original payload.
                unwind.catch_unwind(unwind.AssertUnwindSafe(^work))
            }) ?? fn(error) { ice(None, "could not start compiler worker: {error}") }
        if worker.join() == {
            .Ok(value) -> value
            .Err(payload) -> Err(payload)
        }
    })
    if outcome == {
        .Ok(value) -> value
        .Err(payload) -> unwind.resume_unwind(^payload)
    }
}

// Rust: crates/jet-foundation/src/CompilerStack.rs:184
pub fn map_on_compiler_workers<T: Send, R: Send>(jobs: ^[T], workers: Int,
    work: Fn(T) -> R + Sync) -> [R] Never! {
    count :: jobs.len()
    worker_count :: workers.min(count)
    if worker_count <= 1 {
        out := [R]{}
        loop job in ^jobs { out.push(work(^job)) }
        return out
    }
    // GATE #4494: native mutexes, relaxed atomic index and scoped workers.
    slots := [Mutex<T?>]{}
    loop job in ^jobs { slots.push(Mutex.new(Val(^job))) }
    results := [Mutex<thread.Result<R>?>]{}
    loop _ in 0..<count { results.push(Mutex.new(None)) }
    next :: AtomicUsize.new(0)
    thread.scope(fn(scope) {
        loop index in 0..<worker_count {
            _ :: thread.Builder.new().name("jet-compiler-{index}")
                .stack_size(COMPILER_STACK_SIZE).spawn_scoped(scope, fn() {
                    ON_COMPILER_WORKER.with(fn(active) { active.set(true) })
                    loop {
                        job_index :: next.fetch_add(1, Ordering.Relaxed)
                        if job_index >= slots.len() -> break
                        guard := slots[job_index].lock() ?? PoisonError.into_inner
                        job :: guard.take() ?? panic("each job index is claimed once")
                        guard.drop()
                        // Per-job capture permits this worker to finish the batch.
                        outcome :: unwind.catch_unwind(unwind.AssertUnwindSafe(fn() { work(^job) }))
                        result_guard := results[job_index].lock() ?? PoisonError.into_inner
                        result_guard.set(Val(^outcome))
                    }
                }) ?? fn(error) { ice(None, "could not start compiler worker: {error}") }
        }
    })
    out := [R]{}
    // All workers have joined. Lowest-index panic wins, independent of timing.
    loop slot in ^results {
        outcome :: (slot.into_inner() ?? PoisonError.into_inner)
            ?? panic("every job ran before the workers joined")
        if outcome == {
            .Ok(value) -> out.push(^value)
            .Err(payload) -> unwind.resume_unwind(^payload)
        }
    }
    out
}
