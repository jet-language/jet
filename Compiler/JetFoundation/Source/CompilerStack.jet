//RS             .stack_size(COMPILER_STACK_SIZE)
//RS             .spawn_scoped(scope, move || {
//RS                 ON_COMPILER_WORKER.with(|active| active.set(true));
//RS                 // Asserted, not proven: the payload is re-raised immediately
//RS                 // and unchanged, so no caller ever observes state this panic
//RS                 // left behind without unwinding through it itself.
//RS                 std::panic::catch_unwind(std::panic::AssertUnwindSafe(work))
