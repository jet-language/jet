// One allocation-free runtime report renderer for every execution target.
// GATE #4499: retained streaming fmt traits and format_args; no owned formatting buffer.
use core.fmt.[Display, Write, Formatter, FmtError, format_args]

// Rust: crates/jet-foundation/src/RuntimeDiagnosticCore.rs:4
pub struct JetRuntimeDiagnosticRow {
    pub code: String
    pub what: String
    pub why: String
    pub fix: String
    pub template_holes: View<String>
}

// Rust: crates/jet-foundation/src/RuntimeDiagnosticCore.rs:13
pub struct JetRuntimeStopContext {
    pub file: String
    pub line: U32
    pub function: String
    pub source_line: String
    pub column: U32
    pub caret_len: U32
    pub expected_type: String
}

// Rust: crates/jet-foundation/src/RuntimeDiagnosticCore.rs:23
// None is the omitted message; an explicitly empty string remains empty.
pub fn jet_require_message(message: String?) -> String {
    message.unwrap_or("condition failed")
}

// Rust: crates/jet-foundation/src/RuntimeDiagnosticCore.rs:30
// Borrowed, allocation-free expected/got carrier.
pub struct JetRequireEqMessage {
    left_debug: &Display
    right_debug: &Display
}

// Rust: crates/jet-foundation/src/RuntimeDiagnosticCore.rs:36
impl Display for JetRequireEqMessage {
    // Rust: crates/jet-foundation/src/RuntimeDiagnosticCore.rs:37
    fn fmt(self, out: &Formatter) -> Void Err<FmtError>! {
        out.write_fmt(format_args("expected: {}, got: {}", self.right_debug, self.left_debug))?
    }
}

// Rust: crates/jet-foundation/src/RuntimeDiagnosticCore.rs:47
pub fn jet_require_eq_message(left_debug: &Display, right_debug: &Display) -> JetRequireEqMessage {
    JetRequireEqMessage{left_debug: left_debug, right_debug: right_debug}
}

// Rust: crates/jet-foundation/src/RuntimeDiagnosticCore.rs:58
pub fn jet_write_diagnostic_template(out: &Write, template: String,
    hole: fn(&Write, String) -> Void Err<FmtError>!) -> Void Err<FmtError>! {
    bytes := template.as_bytes()
    index := 0
    while index < bytes.len() {
        if bytes[index] == b'{' && bytes.get(index + 1) == Some(b'{') {
            out.write_char('{')?
            index += 2
            continue
        }
        if bytes[index] == b'}' && bytes.get(index + 1) == Some(b'}') {
            out.write_char('}')?
            index += 2
            continue
        }
        if bytes[index] == b'{' {
            if close_offset := template[index + 1..<template.len()].find('}') {
                close := index + 1 + close_offset
                name := template[index + 1..<close] // #4303: borrowed text slice
                if !name.is_empty() && name.bytes().all(fn(byte) -> byte.is_ascii_alphanumeric() || byte == b'_') {
                    hole(out, name)?
                    index = close + 1
                    continue
                }
            }
        }
        character := template[index..<template.len()].chars().next().expect("template character boundary")
        out.write_char(character)?
        index += character.len_utf8()
    }
}

// Rust: crates/jet-foundation/src/RuntimeDiagnosticCore.rs:96
// Only an initial ASCII lowercase word can change. Uppercase type names and fn are protected.
struct ProseStart {
    offset: Int = 0
    first: Int? = None
    token_len: Int = 0
    is_fn: Bool = false
    preserve: Bool = false
    period: Bool = false
    finished: Bool = false
}
// Rust: crates/jet-foundation/src/RuntimeDiagnosticCore.rs:108
impl Write for ProseStart {
    // Rust: crates/jet-foundation/src/RuntimeDiagnosticCore.rs:109
    fn write_str(self: &Self, text: String) -> Void Err<FmtError>! {
        for ch in text.chars() {
            offset := self.offset
            self.offset += ch.len_utf8()
            if self.finished { continue }
            if self.first.is_none() {
                if ch.is_whitespace() || ch == '*' || ch == '~' || ch == '_' { continue }
                if !ch.is_ascii_lowercase() {
                    self.finished = true
                    continue
                }
                self.first = Some(offset)
                self.token_len = 1
                self.is_fn = ch == 'f'
                continue
            }
            if ch.is_whitespace() || ch == ',' || ch == ';' || ch == ':' || ch == '(' || ch == ')' || ch == '[' || ch == ']' || ch == '!' {
                self.finished = true
                continue
            }
            if self.period { self.preserve = true }
            self.period = ch == '.'
            if self.period { continue }
            self.token_len += 1
            self.is_fn = self.is_fn && self.token_len == 2 && ch == 'n'
            self.preserve = self.preserve || ch.is_ascii_digit() || ch == '_' || ch == '/' || ch == '\\' || ch == '@' || ch == '#'
        }
    }
}

// Rust: crates/jet-foundation/src/RuntimeDiagnosticCore.rs:140
pub fn jet_write_sentence_case(out: &Write, value: &Display) -> Void Err<FmtError>! {
    start := ProseStart{}
    start.write_fmt(format_args("{}", value))?
    change := start.first.filter(fn(_) -> !start.preserve && !(start.is_fn && start.token_len == 2))
    writer := Capitalize{out: out, offset: 0, change: change}
    writer.write_fmt(format_args("{}", value))?
}
// Rust: crates/jet-foundation/src/RuntimeDiagnosticCore.rs:144
struct Capitalize {
    out: &Write
    offset: Int
    change: Int?
}
// Rust: crates/jet-foundation/src/RuntimeDiagnosticCore.rs:149
impl Write for Capitalize {
    // Rust: crates/jet-foundation/src/RuntimeDiagnosticCore.rs:150
    fn write_str(self: &Self, text: String) -> Void Err<FmtError>! {
        begin := self.offset
        self.offset += text.len()
        if change := self.change.filter(fn(change) -> change >= begin && change < self.offset) {
            index := change - begin
            prefix := text[0..<index] // #4303
            suffix := text[index + 1..<text.len()] // #4303
            self.out.write_str(prefix)?
            self.out.write_char(Char.from_u8(text.as_bytes()[index]).to_ascii_uppercase())?
            self.out.write_str(suffix)?
        } else {
            self.out.write_str(text)?
        }
    }
}

// Rust: crates/jet-foundation/src/RuntimeDiagnosticCore.rs:166
pub struct JetRuntimeStopField {
    row: JetRuntimeDiagnosticRow
    template: String
    context: JetRuntimeStopContext
    message: &Display
    raw_message: Bool
}
// Rust: crates/jet-foundation/src/RuntimeDiagnosticCore.rs:173
impl Display for JetRuntimeStopField {
    // Rust: crates/jet-foundation/src/RuntimeDiagnosticCore.rs:174
    fn fmt(self, out: &Formatter) -> Void Err<FmtError>! {
        raw := Raw{field: &self}
        jet_write_sentence_case(out, &raw)?
    }
}
// Rust: crates/jet-foundation/src/RuntimeDiagnosticCore.rs:175
struct Raw { field: &JetRuntimeStopField }
// Rust: crates/jet-foundation/src/RuntimeDiagnosticCore.rs:176
impl Display for Raw {
    // Rust: crates/jet-foundation/src/RuntimeDiagnosticCore.rs:177
    fn fmt(self, out: &Formatter) -> Void Err<FmtError>! {
        field := self.field
        if field.raw_message { return out.write_fmt(format_args("{}", field.message)) }
        jet_write_diagnostic_template(out, field.template, fn(out, name) -> {
            assert(field.row.template_holes.contains(name), "missing diagnostic template hole `{name}`")
            match name {
                "file" => out.write_str(field.context.file)
                "line", "n" => out.write_fmt(format_args("{}", field.context.line))
                "fn" => out.write_str(field.context.function)
                "type" => out.write_str(field.context.expected_type)
                _ => out.write_fmt(format_args("{}", field.message))
            }
        })?
    }
}

// Rust: crates/jet-foundation/src/RuntimeDiagnosticCore.rs:196
pub fn jet_runtime_stop_fields(row: JetRuntimeDiagnosticRow, code: String,
    context: JetRuntimeStopContext, message: &Display) -> [JetRuntimeStopField; 3] {
    [(row.what, code == "E3005"), (row.why, false), (row.fix, false)].map(fn(pair) ->
        JetRuntimeStopField{row: row, template: pair.0, context: context, message: message, raw_message: pair.1})
}

// Rust: crates/jet-foundation/src/RuntimeDiagnosticCore.rs:207
pub fn jet_runtime_stop_has_context(code: String) -> Bool {
    code == "E0128" || code == "E3001" || code == "E3012" || code == "E3014"
}

// Rust: crates/jet-foundation/src/RuntimeDiagnosticCore.rs:211
pub fn jet_runtime_stop_status(row: JetRuntimeDiagnosticRow?) -> I32 {
    if row.is_some() { 70 } else { 101 }
}

// Rust: crates/jet-foundation/src/RuntimeDiagnosticCore.rs:215
pub fn jet_write_runtime_stop(out: &Write, row: JetRuntimeDiagnosticRow?, code: String,
    context: JetRuntimeStopContext, message: &Display, locals: &Display?) -> Void Err<FmtError>! {
    resolved := match row {
        Some(value) => value
        None => {
            out.write_fmt(format_args("Internal error: runtime diagnostic `{}` is not an active runtime row\n Why: Jet could not resolve this stop through the active diagnostic registry\n Fix: report this as a Jet compiler or host defect\nMore: jet-lang.dev/e/{}\n", code, code))?
            return
        }
    }
    fields := jet_runtime_stop_fields(resolved, code, context, message)
    out.write_fmt(format_args("Stop [{}]: {}\n", code, fields[0]))?
    show_context := jet_runtime_stop_has_context(code)
    if !context.file.is_empty() {
        out.write_fmt(format_args("  --> {}:{}", context.file, context.line))?
        if show_context && !context.function.is_empty() { out.write_fmt(format_args(" in {}", context.function))? }
        out.write_char('\n')?
    }
    if show_context && !context.source_line.is_empty() {
        digits := 1
        line := context.line
        while line >= 10 { digits += 1; line /= 10 }
        out.write_fmt(format_args("{:width$}|\n{} | {}\n{:width$}| ", "", context.line, context.source_line, "", width: digits + 3))?
        for _ in 0..<context.column.saturating_sub(1) { out.write_char(' ')? }
        for _ in 0..<context.caret_len.max(1) { out.write_char('^')? }
        out.write_char('\n')?
    }
    if show_context {
        if value := locals { out.write_fmt(format_args("locals: {}\n", value))? }
    }
    out.write_fmt(format_args(" Why: {}\n Fix: {}\nMore: jet-lang.dev/e/{}\n", fields[1], fields[2], code))?
}
