impl ReportPath {
    // Rust: crates/jet-foundation/src/Report.rs:471
    fn new(value: String) -> ReportPath { ReportPath{value: ^value} }
    // Rust: crates/jet-foundation/src/Report.rs:475
    // Canonical: ReportPath.from_process.
    // Rust: crates/jet-foundation/src/Report.rs:482
    // Canonical: ReportPath.from_path.
    // Rust: crates/jet-foundation/src/Report.rs:502
    // Canonical: ReportPath.as_str.
    // Rust: crates/jet-foundation/src/Report.rs:506
    // Canonical: ReportPath.is_empty.
    // Rust: crates/jet-foundation/src/Report.rs:511
    fn as_ref(self) -> String { self.as_str() }
    // Rust: crates/jet-foundation/src/Report.rs:517
    fn fmt(self, formatter: &std.fmt.Formatter) -> std.fmt.Result {
        // GATE #4409: native formatter writes the path label without decoration.
        formatter.write_str(self.as_str())
    }
}
