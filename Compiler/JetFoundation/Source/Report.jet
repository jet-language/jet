// GATE #4499: publish the standard From conversion trait with the canonical
// Report StatusValue carrier; integers widen without truncation or text parsing.
use std.convert.From
// Rust: crates/jet-foundation/src/Report.rs:158
impl From<Bool> for StatusValue {
    fn from(value: Bool) -> StatusValue { StatusValue.Bool{value: value} }
}
// Rust: crates/jet-foundation/src/Report.rs:164
impl From<Int> for StatusValue {
    fn from(value: Int) -> StatusValue { StatusValue.Integer{value: value} }
}
// Rust: crates/jet-foundation/src/Report.rs:170
impl From<I64> for StatusValue {
    fn from(value: I64) -> StatusValue { StatusValue.Integer{value: Int.from_i64(value)} }
}
// Rust: crates/jet-foundation/src/Report.rs:176
impl From<I32> for StatusValue {
    fn from(value: I32) -> StatusValue { StatusValue.Integer{value: Int.from_i32(value)} }
}
// Rust: crates/jet-foundation/src/Report.rs:182
impl From<U64> for StatusValue {
    fn from(value: U64) -> StatusValue { StatusValue.Integer{value: Int.from_u64(value)} }
}
// Rust: crates/jet-foundation/src/Report.rs:188
impl From<U32> for StatusValue {
    fn from(value: U32) -> StatusValue { StatusValue.Integer{value: Int.from_u32(value)} }
}
// Rust: crates/jet-foundation/src/Report.rs:194
// usize uses the canonical Int index and the From<Int> implementation above.
// Rust: crates/jet-foundation/src/Report.rs:200
impl From<String> for StatusValue {
    fn from(value: String) -> StatusValue { StatusValue.String{value: ^value} }
}
// Rust: crates/jet-foundation/src/Report.rs:206
// &str uses canonical String input; borrowed text is copied when an owned value
// is required, and the From<String> route constructs the same String variant.

