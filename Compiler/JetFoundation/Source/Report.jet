impl StatusFields {
    // Rust: crates/jet-foundation/src/Report.rs:263
    // The canonical StatusField rows carry the same name/value pair, borrowed.
    pub fn iter(self) -> View<StatusField> { self.entries[0..<self.entries.len()] }
    // Rust: crates/jet-foundation/src/Report.rs:267
    // Canonical: StatusFields.from_data_tree_object.
    // Rust: crates/jet-foundation/src/Report.rs:278
    fn json(self) -> String {
        out := [U8]{}
        report_status_fields_json(&out, self)
        report_bytes_text(out)
    }
}
