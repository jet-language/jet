// Opt-in compiler-owned pass-boundary evidence. Ordinary builds do not capture.
use AST.[Item, ProgramBundle]
use JSON.[json_escape]
use std.env
use std.cell.[RefCell]
use std.thread_local.[ThreadLocal]
use std.fs.[OpenOptions]
use std.mem
use std.fmt.[Debug]

// Rust: crates/jet-foundation/src/CanonicalPass.rs:14
pub SCHEMA :: prep { "jet.canonical-pass-record.v1" }
// Rust: crates/jet-foundation/src/CanonicalPass.rs:15
pub PROTOCOL :: prep { "jet.canonical-pass.v1" }
// Rust: crates/jet-foundation/src/CanonicalPass.rs:16
pub BASE_PREMISES :: prep { ["source_origin_is_retained", "typed_failure_is_retained", "mutation_is_retained", "input_consumption_is_exact", "ordered_effects_are_retained", "cleanup_edges_are_retained", "resource_premises_are_explicit", "target_applicability_is_checked"] }
// Rust: crates/jet-foundation/src/CanonicalPass.rs:28
pub struct Record {
    pub stage: String
    pub operation_id: String
    pub occurrence: Int
    pub order: Int
    pub source: String
    pub input_representation: String
    pub input_payload: String
    pub input_identity: String
    pub output_representation: String
    pub output_payload: String
    pub output_identity: String
    pub premises: [String]
    pub disposition: String
}
// Rust: crates/jet-foundation/src/CanonicalPass.rs:44
// GATE #4494: native thread-local RefCell ownership, not a process-global journal.
RECORDS :: prep { ThreadLocal<RefCell<[Record]>>.new(|| -> RefCell.new([Record]{})) }
// Rust: crates/jet-foundation/src/CanonicalPass.rs:50
pub fn enabled() -> Bool {
    // GATE #4494: native environment reads retain OS text semantics.
    env.var_os("JET_ADAPTER_MODE").is_some_and(|mode| -> !mode.is_empty()) && env.var_os("JET_ADAPTER_OPERATION_IDS").is_some_and(|ids| -> !ids.is_empty())
}
// Rust: crates/jet-foundation/src/CanonicalPass.rs:55
pub fn clear() -> { RECORDS.with(|records| -> records.borrow_mut().clear()) }
// Rust: crates/jet-foundation/src/CanonicalPass.rs:59
pub fn record(stage: String, operation_id: String, source: String, input_representation: String, input_payload: ^String, input_identity: ^String, output_representation: String, output_payload: ^String, output_identity: ^String, disposition: String) -> {
    if !enabled() || !env.var("JET_ADAPTER_OPERATION_IDS").ok().is_some_and(|ids| -> ids.split(',').any(|candidate| -> candidate == operation_id)) -> return
    RECORDS.with(|cell| -> {
        records := cell.borrow_mut()
        occurrence :: records.iter().filter(|entry| -> entry.operation_id == operation_id).count() + 1
        order :: records.len() + 1
        records.push(Record{stage: ~stage, operation_id: ~operation_id, occurrence: occurrence, order: order, source: ~source, input_representation: ~input_representation, input_payload: ^input_payload, input_identity: ^input_identity, output_representation: ~output_representation, output_payload: ^output_payload, output_identity: ^output_identity, premises: BASE_PREMISES.iter().map(|value| -> ~value).collect(), disposition: ~disposition})
    })
}
// Rust: crates/jet-foundation/src/CanonicalPass.rs:104
pub fn take() -> [Record] { RECORDS.with(|records| -> mem.take(&records.borrow_mut())) }
// Rust: crates/jet-foundation/src/CanonicalPass.rs:109
fn record_json(record: Record) -> String {
    premises :: record.premises.iter().map(|premise| -> "\"" + json_escape(premise) + "\"").collect().join(",")
    "{\"schema\":\"" + SCHEMA + "\",\"protocol\":\"" + PROTOCOL + "\",\"stage\":\"" + json_escape(record.stage) + "\",\"operation_id\":\"" + json_escape(record.operation_id) + "\",\"occurrence\":" + record.occurrence.to_string() + ",\"order\":" + record.order.to_string() + ",\"source\":{\"path\":\"" + json_escape(record.source) + "\"},\"input\":{\"representation\":\"" + json_escape(record.input_representation) + "\",\"canonical_payload\":" + record.input_payload + ",\"identity\":" + record.input_identity + "},\"output\":{\"representation\":\"" + json_escape(record.output_representation) + "\",\"canonical_payload\":" + record.output_payload + ",\"identity\":" + record.output_identity + "},\"premises\":[" + premises + "],\"disposition\":\"" + json_escape(record.disposition) + "\"}"
}
// Rust: crates/jet-foundation/src/CanonicalPass.rs:140
// Append-only, best effort; unavailable scratch paths never alter compilation.
pub fn persist_process(process: String) -> {
    if env.var("JET_ADAPTER_CANONICAL_PASS_PROCESS").ok() != Val(process) -> return
    path :: env.var_os("JET_ADAPTER_CANONICAL_PASS_PATH") ?? return
    records :: take()
    if records.is_empty() -> return
    rows :: records.iter().map(|entry| -> record_json(entry)).collect().join(",")
    payload :: "{\"schema\":\"jet.canonical-pass-journal.v1\",\"protocol\":\"" + PROTOCOL + "\",\"process\":\"" + json_escape(process) + "\",\"records\":[" + rows + "]}\n"
    // GATE #4494: native append/create and write; preserve best-effort error policy.
    file := OpenOptions.new().create(true).append(true).open(OSPath.from(path)) catch _ -> return
    _ :: file.write_all(payload.as_bytes()) catch _ -> {}
}
// Rust: crates/jet-foundation/src/CanonicalPass.rs:165
// Structured source-backed snapshot: node kinds and order, not a digest.
pub fn ast_payload(bundle: ProgramBundle) -> String {
    modules :: bundle.modules.iter().map(|module| -> {
        items :: module.items.iter().enumerate().map(|(index, item)| -> "{\"index\":" + index.to_string() + ",\"kind\":\"" + item_kind(item) + "\"}").collect().join(",")
        "{\"display\":\"" + json_escape(module.display) + "\",\"alias\":\"" + json_escape(module.alias) + "\",\"source_length\":" + module.source.as_bytes().len().to_string() + ",\"items\":[" + items + "]}"
    }).collect().join(",")
    "{\"representation\":\"ast\",\"entry\":" + bundle.entry.to_string() + ",\"modules\":[" + modules + "]}"
}
// Rust: crates/jet-foundation/src/CanonicalPass.rs:198
pub fn ast_identity(bundle: ProgramBundle) -> String {
    modules :: bundle.modules.iter().map(|module| -> "{\"display\":\"" + json_escape(module.display) + "\",\"items\":" + module.items.len().to_string() + "}").collect().join(",")
    "{\"representation\":\"ast\",\"entry\":" + bundle.entry.to_string() + ",\"modules\":[" + modules + "]}"
}
// Rust: crates/jet-foundation/src/CanonicalPass.rs:217
fn item_kind(item: Item) -> String {
    match item {
        Item.Func(_) => "Func"
        Item.Struct(_) => "Struct"
        Item.Enum(_) => "Enum"
        Item.Distinct(_) => "Distinct"
        Item.TypeAlias(_) => "TypeAlias"
        Item.UnitFamily(_) => "UnitFamily"
        Item.Trait(_) => "Trait"
        Item.Tag(_) => "Tag"
        Item.EffectDecl(_) => "EffectDecl"
        Item.Impl(_) => "Impl"
        Item.Const(_) => "Const"
        Item.Test(_) => "Test"
        Item.ExternRust(_) => "ExternRust"
        Item.Module(_) => "Module"
        Item.CModule(_) => "CModule"
        Item.CodeModule(_) => "CodeModule"
        Item.ErrorConv(_) => "ErrorConv"
        Item.Migration(_) => "Migration"
        Item.ProtocolDecl(_) => "ProtocolDecl"
        Item.UserDerive(_) => "UserDerive"
        Item.TemplateLoop(_) => "TemplateLoop"
        Item.GenericModule(_) => "GenericModule"
        Item.ModuleAlias(_) => "ModuleAlias"
        Item.MarkerDecl(_) => "MarkerDecl"
        Item.FactDecl(_) => "FactDecl"
    }
}
// Rust: crates/jet-foundation/src/CanonicalPass.rs:246
pub fn ast_items_payload(items: [Item]) -> String {
    rows :: items.iter().enumerate().map(|(index, item)| -> "{\"index\":" + index.to_string() + ",\"kind\":\"" + item_kind(item) + "\"}").collect().join(",")
    "{\"representation\":\"ast\",\"items\":[" + rows + "]}"
}
// Rust: crates/jet-foundation/src/CanonicalPass.rs:261
pub fn ast_items_identity(items: [Item]) -> String { "{\"representation\":\"ast\",\"item_count\":" + items.len().to_string() + "}" }
// Rust: crates/jet-foundation/src/CanonicalPass.rs:268
pub fn debug_payload<T: Debug>(representation: String, operation_id: String, value: T) -> String {
    "{\"representation\":\"" + json_escape(representation) + "\",\"operation_id\":\"" + json_escape(operation_id) + "\",\"debug\":\"" + json_escape(value.debug()) + "\"}"
}
// Rust: crates/jet-foundation/src/CanonicalPass.rs:281
pub fn debug_identity<T: Debug>(representation: String, operation_id: String, value: T) -> String {
    "{\"representation\":\"" + json_escape(representation) + "\",\"operation_id\":\"" + json_escape(operation_id) + "\",\"identity\":\"" + json_escape(value.debug()) + "\"}"
}
