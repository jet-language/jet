// Canonical named fixed-width integer kinds, shared by Source compiler menus
// and the Source type parser/numeric consumers as they migrate to this registry.
// S42 closes the menu at 64 bits: I8 through I64 and U8 through U64.
FoundationFixedInteger: struct {
    name: String
    signed: Bool
    bits: Int
}

FOUNDATION_FIXED_INTEGERS: comptime { [FoundationFixedInteger]{
    {name: "I8", signed: true, bits: 8},
    {name: "I16", signed: true, bits: 16},
    {name: "I32", signed: true, bits: 32},
    {name: "I64", signed: true, bits: 64},
    {name: "U8", signed: false, bits: 8},
    {name: "U16", signed: false, bits: 16},
    {name: "U32", signed: false, bits: 32},
    {name: "U64", signed: false, bits: 64}
} }

foundation_fixed_integers: fn() -> [FoundationFixedInteger] Never! {
    FOUNDATION_FIXED_INTEGERS
}

#Test("the fixed-width integer menu closes at 64 bits") {
    names := [String]{}
    loop kind in foundation_fixed_integers() {
        assert(kind.bits <= 64)
        names.push(kind.name)
    }
    assert_eq(names.join(" "), "I8 I16 I32 I64 U8 U16 U32 U64")
}
