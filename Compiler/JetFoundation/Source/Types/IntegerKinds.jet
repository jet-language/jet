// Canonical named fixed-width integer kinds, shared by Source compiler menus
// and the Source type parser/numeric consumers as they migrate to this registry.
struct FoundationFixedInteger {
    name: String
    signed: Bool
    bits: Int
}

FOUNDATION_FIXED_INTEGERS :: prep { [FoundationFixedInteger]{
    FoundationFixedInteger{name: "I8", signed: true, bits: 8},
    FoundationFixedInteger{name: "I16", signed: true, bits: 16},
    FoundationFixedInteger{name: "I32", signed: true, bits: 32},
    FoundationFixedInteger{name: "I64", signed: true, bits: 64},
    FoundationFixedInteger{name: "I128", signed: true, bits: 128},
    FoundationFixedInteger{name: "U8", signed: false, bits: 8},
    FoundationFixedInteger{name: "U16", signed: false, bits: 16},
    FoundationFixedInteger{name: "U32", signed: false, bits: 32},
    FoundationFixedInteger{name: "U64", signed: false, bits: 64},
    FoundationFixedInteger{name: "U128", signed: false, bits: 128}
} }

fn foundation_fixed_integers() -> [FoundationFixedInteger] Never! {
    FOUNDATION_FIXED_INTEGERS
}
