// Canonical semantic type and declaration identities shared by every compiler
// phase. Keep this separate from target layout and backend representations.

pub enum Type {
    Int
    Float
    Bool
    String
    Char
    List(element: Type)
    Map(key: Type, key_span: Span?, value: Type)
    Shared(inner: Type)
    Option(inner: Type)
    Result(ok: Type, err: Type)
    Fn(params: [Type], ret: Type?, effect_bound: [EffectRowEntry]?, param_contract: [CallContractRow]?, call_metadata: FunctionCallMetadata?, return_view_provenance: ViewProvenanceMap?)
    Named(name: String)
    Apply(name: String, args: [Type])
    TraitObject(bounds: [String])
    Tuple(fields: [TypeTupleField])
    FixedList(elem: Type, len: Measure)
    IntN(signed: Bool, bits: Int)
    InlineRange(base: Type, lo: Int, hi: Int)
    Float32
    Tagged(marker: TagMarker, inner: Type)
    Union(members: [Type])
    Quantity(base: Type, dimension: Dimension)
    Measure(measure: Measure)
}

pub struct TypeTupleField {
    pub name: String
    pub ty: Type
}

pub enum AccessConvention {
    Read
    Write
    Move
}

pub fn access_sigil(access: AccessConvention) -> String Never! {
    if access == {
        .Write -> "&"
        .Move -> "^"
        else -> ""
    }
}

pub enum TagMarker {
    User(name: String)
    Internal(internal_tag: InternalTag)
}

pub enum InternalTag {
    CoreCryptoNominal
    DeterministicClock
    SystemClock
    ExpiringSecretLoan
    SharedGuardRead
    SharedGuardEdit
    TerminalFactSet
    CppCallbackABI
    AllocatorView
}

pub enum MeasureRule {
    Add
    Mul
    Match
}

pub enum Measure {
    Literal(kind: String, value: Int)
    SignedLiteral(kind: String, value: Int)
    Symbol(kind: String, name: String)
    Combined(kind: String, rule: MeasureRule, left: Measure, right: Measure)
}

pub fn measure_kind(measure: Measure) -> String Never! {
    if measure == {
        .Literal(kind, _) -> kind
        .SignedLiteral(kind, _) -> kind
        .Symbol(kind, _) -> kind
        .Combined(kind, _, _, _) -> kind
    }
}

// AST/types.rs `Measure::literal_value`: the Rust `u64` carrier; `checked_add`
// and `checked_mul` overflow, signed literals, symbols and `match` are None.
pub fn measure_literal_value(measure: Measure) -> Int? {
    if measure == {
        .Literal(_, value) -> measure_checked_u64(value)
        .Combined(_, rule, left, right) -> {
            if rule == {
                .Add -> {
                    l :: measure_literal_value(left) ?? return None
                    r :: measure_literal_value(right) ?? return None
                    measure_checked_u64(l + r)
                }
                .Mul -> {
                    l :: measure_literal_value(left) ?? return None
                    r :: measure_literal_value(right) ?? return None
                    measure_checked_u64(l * r)
                }
                .Match -> None
            }
        }
        else -> None
    }
}

// AST/types.rs `Measure::signed_literal_value`: the Rust `i64` carrier; an
// unsigned literal above `i64::MAX` (`i64::try_from`) and `checked_add`/
// `checked_mul` overflow are None.
pub fn measure_signed_value(measure: Measure) -> Int? {
    if measure == {
        .SignedLiteral(_, value) -> measure_checked_i64(value)
        .Literal(_, value) -> {
            unsigned :: measure_checked_u64(value) ?? return None
            measure_checked_i64(unsigned)
        }
        .Combined(_, rule, left, right) -> {
            if rule == {
                .Add -> {
                    l :: measure_signed_value(left) ?? return None
                    r :: measure_signed_value(right) ?? return None
                    measure_checked_i64(l + r)
                }
                .Mul -> {
                    l :: measure_signed_value(left) ?? return None
                    r :: measure_signed_value(right) ?? return None
                    measure_checked_i64(l * r)
                }
                .Match -> None
            }
        }
        else -> None
    }
}

fn measure_checked_u64(value: Int) -> Int? {
    if value < 0 || value > 18446744073709551615 -> return None
    Val(value)
}

fn measure_checked_i64(value: Int) -> Int? {
    if value < -9223372036854775808 || value > 9223372036854775807 -> return None
    Val(value)
}

// AST/types.rs `Measure::combine`: same-kind operands only. `match` keeps equal
// operands; Add/Mul fold the `u64` values first, then the `i64` values, where an
// overflowing fold is None; any other pair stays a symbolic combination.
fn measure_combine(left: Measure, right: Measure, rule: MeasureRule) -> Measure? {
    kind :: measure_kind(left)
    if kind != measure_kind(right) -> return None
    if rule == MeasureRule.Match {
        if left == right -> return Val(left)
        return None
    }
    add :: rule == MeasureRule.Add
    if measure_literal_value(left) == .Val(l) {
        if measure_literal_value(right) == .Val(r) {
            folded :: measure_checked_u64(if add -> l + r else -> l * r) ?? return None
            return Val(Measure.Literal{kind: kind, value: folded})
        }
    }
    if measure_signed_value(left) == .Val(l) {
        if measure_signed_value(right) == .Val(r) {
            folded :: measure_checked_i64(if add -> l + r else -> l * r) ?? return None
            return Val(Measure.SignedLiteral{kind: kind, value: folded})
        }
    }
    Val(Measure.Combined{kind: kind, rule: rule, left: left, right: right})
}

pub fn measure_expression(measure: Measure) -> String Never! {
    if measure == {
        .Literal(_, value) -> "{value}"
        .SignedLiteral(_, value) -> "{value}"
        .Symbol(_, name) -> name
        .Combined(_, rule, left, right) -> {
            left_name :: measure_expression(left)
            right_name :: measure_expression(right)
            if rule == {
                .Add -> "({left_name} + {right_name})"
                .Mul -> "({left_name} * {right_name})"
                .Match -> "match({left_name}, {right_name})"
            }
        }
    }
}

pub fn measure_key(measure: Measure) -> String Never! {
    "{measure_kind(measure)}:{measure_expression(measure)}"
}

pub struct DimensionAxis {
    pub name: String
    pub exponent: Measure
}

// AST/types.rs `Dimension`: a Rust `BTreeMap` from nominal axis identity to its
// exponent, so `axes` holds unique names in byte order and the constructors
// below keep that invariant.
pub struct Dimension {
    pub axes: [DimensionAxis]
}

// AST/types.rs `Dimension::base`.
pub fn dimension_base(identity: String) -> Dimension Never! {
    Dimension{axes: [DimensionAxis]{DimensionAxis{name: identity, exponent: Measure.SignedLiteral{kind: "exponent", value: 1}}}}
}

// AST/types.rs `Dimension::multiply`.
pub fn dimension_multiply(left: Dimension, right: Dimension) -> Dimension? { dimension_combine(left, right, false) }

// AST/types.rs `Dimension::divide`.
pub fn dimension_divide(left: Dimension, right: Dimension) -> Dimension? { dimension_combine(left, right, true) }

// AST/types.rs `Dimension::combine`: the left axes are kept verbatim; each right
// axis is scaled by +/-1 and added to the matching left exponent through
// `measure_combine`. A sum outside `i32` is None, a zero sum removes the axis,
// and a new axis is inserted at its byte-ordered key position.
fn dimension_combine(left: Dimension, right: Dimension, subtract: Bool) -> Dimension? {
    axes := ~left.axes
    factor :: Measure.SignedLiteral{kind: "exponent", value: if subtract -> -1 else -> 1}
    loop axis in right.axes {
        exponent :: measure_combine(axis.exponent, factor, MeasureRule.Mul) ?? return None
        index := 0
        loop index < axes.len() && axes[index].name < axis.name -> index += 1
        present :: index < axes.len() && axes[index].name == axis.name
        current :: if present -> axes[index].exponent else -> Measure.SignedLiteral{kind: "exponent", value: 0}
        summed :: measure_combine(current, exponent, MeasureRule.Add) ?? return None
        value :: measure_signed_value(summed) ?? return None
        if value < -2147483648 || value > 2147483647 -> return None
        if {
            value == 0 && present -> {
                _ := &axes.remove(index, .Slot)
            }
            value == 0 -> {}
            present -> {
                axes[index].exponent = summed
            }
            else -> {
                &axes.insert(index, DimensionAxis{name: axis.name, exponent: summed})
            }
        }
    }
    Val(Dimension{axes: axes})
}

pub fn dimension_identity(dimension: Dimension) -> String Never! {
    parts := [String]{}
    loop axis in dimension.axes {
        exponent :: measure_signed_value(axis.exponent).map(value -> "{value}") ?? measure_expression(axis.exponent)
        &parts.push("{escape_dimension_axis(axis.name)}:{exponent}")
    }
    parts.join(";")
}

pub fn dimension_display_name(dimension: Dimension) -> String Never! {
    parts := [String]{}
    loop axis in dimension.axes {
        leaf := axis.name.split("::").to_list()
        name :: if leaf.len() == 0 -> axis.name else -> leaf[leaf.len() - 1]
        exponent :: measure_signed_value(axis.exponent)
        rendered :: if {
            exponent == (Val(1)) -> name
            else -> {
                exponent_name :: exponent.map(value -> "{value}") ?? measure_expression(axis.exponent)
                "{name}^{exponent_name}"
            }
        }
        &parts.push(rendered)
    }
    if parts.len() == 0 -> return "Scalar"
    parts.join(" * ")
}

fn escape_dimension_axis(axis: String) -> String Never! {
    axis.replace("%", "%25").replace(";", "%3B").replace(":", "%3A")
}

// AST/types.rs `Dimension::from_identity`: `axis:exponent` parts joined by `;`
// with escaped axes and nonzero `i32` exponents; a malformed part, a zero
// exponent or a repeated axis is None.
pub fn dimension_from_identity(identity: String) -> Dimension? {
    axes := [DimensionAxis]{}
    if identity == "" -> return Val(Dimension{axes: axes})
    loop part in identity.split(";") {
        colon :: part.last_index_of(":") ?? return None
        exponent :: dimension_parse_i32(part.slice(colon + 1, part.len())) ?? return None
        if exponent == 0 -> return None
        name :: unescape_dimension_axis(part.slice(0, colon)) ?? return None
        index := 0
        loop index < axes.len() && axes[index].name < name -> index += 1
        if index < axes.len() && axes[index].name == name -> return None
        &axes.insert(index, DimensionAxis{name: name, exponent: Measure.SignedLiteral{kind: "exponent", value: exponent}})
    }
    Val(Dimension{axes: axes})
}

// Rust `str::parse::<i32>`: an optional sign, then one or more ASCII digits.
fn dimension_parse_i32(text: String) -> Int? {
    bytes :: text.bytes()
    start :: if bytes.len() > 0 && (Int.from_u8(bytes[0]) == 43 || Int.from_u8(bytes[0]) == 45) -> 1 else -> 0
    if start == bytes.len() -> return None
    value := 0
    loop index in start..<bytes.len() {
        digit :: Int.from_u8(bytes[index]) - 48
        if digit < 0 || digit > 9 -> return None
        value = value * 10 + digit
        if value > 2147483648 -> return None
    }
    if Int.from_u8(bytes[0]) == 45 -> value = -value
    if value > 2147483647 -> return None
    Val(value)
}

// AST/types.rs `unescape_axis`: `%25`, `%3B` and `%3A` only; any other `%`
// sequence is None. Other bytes are copied as UTF-8 (the Rust reference pushes
// each byte as a `char`, which mangles non-ASCII axes; not reproduced).
fn unescape_dimension_axis(axis: String) -> String? {
    bytes :: axis.bytes()
    out := [U8]{}
    index := 0
    loop index < bytes.len() {
        if Int.from_u8(bytes[index]) != 37 {
            &out.push(bytes[index])
            index += 1
            next
        }
        if index + 3 > bytes.len() -> return None
        high :: Int.from_u8(bytes[index + 1])
        low :: Int.from_u8(bytes[index + 2])
        decoded :: if {
            high == 50 && low == 53 -> 37
            high == 51 && low == 66 -> 59
            high == 51 && low == 65 -> 58
            else -> -1
        }
        if decoded < 0 -> return None
        &out.push(U8{decoded})
        index += 3
    }
    Val(String.from_bytes(out) ?? return None)
}

pub enum Exactness {
    Exact
    Approximate(precision: Int)
    Measured
}

pub enum KnowledgeFact {
    Interval(lo: Int, hi: Int)
    Layout(bytes: Int)
    Measure(value: Measure)
    Exactness(value: Exactness)
    Dimension(value: Dimension)
    Classification(name: String)
    Nominal(name: String)
    Obligation(value: FunctionObligations)
}

pub struct KnowledgeEntry {
    pub path: [String]
    pub plane: String
    pub fact: KnowledgeFact
}

pub struct KnowledgeVector {
    pub entries: [KnowledgeEntry]
}

pub struct TypeIdentity {
    pub carrier: String
    pub knowledge: KnowledgeVector
}

pub enum ParamZone {
    PositionalOnly
    Either
    LabelOnly
}

pub struct CallContractRow {
    pub label: String
    pub zone: ParamZone
}

pub struct EffectRowEntry {
    pub name: String
    pub span: Span
}

pub struct FunctionObligations {
    pub effect_bound: [String]?
    pub param_contract: [CallContractRow]?
    pub variadic: [Bool]?
    pub return_view_provenance: ViewProvenanceMap?
}

pub struct CallablePolicy {
    pub name: String
    pub arguments: [String]
}

// Rust AST/types.rs CallablePolicy::display: arguments are already textual.
pub fn callable_policy_display(policy: CallablePolicy) -> String Never! {
    "{policy.name}({policy.arguments.join(", ")})"
}

pub struct CallablePolicyChain {
    pub policies: [CallablePolicy]
}

// Rust AST/types.rs::CallablePolicyChain::parse, preserving Result errors.
pub fn callable_policy_chain_parse(expressions: [Expr]) -> CallablePolicyChain String! {
    policies := [CallablePolicy]{}
    loop expression in expressions {
        call :: if expression == {
            .Call(value) -> value
            else -> { return Err("a callable policy is a call such as `retry(3)`") }
        }
        loop argument in call.args {
            if argument.label != None || argument.spread -> return Err("`{call.name}` policies take ordinary positional values")
        }
        arguments :: loop argument in call.args -> policy_argument_text(argument.expr)
        &policies.push(CallablePolicy{name: call.name, arguments: arguments})
    }
    Ok(CallablePolicyChain{policies: policies})
}

// Rust AST/types.rs::policy_argument_text. Float uses its value, not raw source;
// only a one-part literal String receives Debug quoting.
fn policy_argument_text(expression: Expr) -> String Never! {
    if expression == {
        .Str(parts, _) -> {
            if parts.len() == 1 {
                if parts[0] == .Lit(value) -> return "{value:Debug}"
                return "<string>"
            }
            "<expression>"
        }
        .Int(value, _, _, source) -> source ?? "{value}"
        .Float(value, _, _, _) -> "{value}"
        .Bool(value, _) -> "{value}"
        .Char(value, _) -> "'{value}'"
        .Ident(name, _) -> name
        .Field(base, field, _) -> "{policy_argument_text(base)}.{field}"
        .Call(call) -> {
            arguments :: loop argument in call.args -> policy_argument_text(argument.expr)
            "{call.name}({arguments.join(", ")})"
        }
        else -> "<expression>"
    }
}

// Callable defaults refer back to their owning declaration instead of copying
// an AST expression into the shared type. This keeps Type usable by parsing and
// sema without a Type <-> Expr module cycle; source+owner+index resolves a node.
pub struct FunctionCallMetadata {
    pub names: [String]
    pub defaults: [FunctionDefaultRef?]
    pub variadic: [Bool]
    pub conventions: [AccessConvention]
    pub policies: CallablePolicyChain
}

pub struct FunctionDefaultRef {
    pub source_file: String
    pub owner_key: String
    pub parameter_index: Int
    pub span: Span
}

pub enum ViewSource {
    Receiver
    Parameter(index: Int)
    Static(module_path: String, name: String)
}

pub enum ViewSourceProjection {
    Field(name: String)
    Index
    Range
}

pub struct ViewSourcePath {
    pub source: ViewSource
    pub projections: [ViewSourceProjection]
}

pub struct ViewProvenance {
    pub sources: [ViewSourcePath]
    pub mutable: Bool
}

pub struct ViewProvenanceEntry {
    pub slot: [String]
    pub value: ViewProvenance
}

pub struct ViewProvenanceMap {
    pub entries: [ViewProvenanceEntry]
}

// Rust AST/comptime.rs::ViewSourcePath::canonical.
pub fn view_source_path_canonical(value: ViewSourcePath) -> String Never! {
    owner :: if value.source == {
        .Receiver -> "receiver"
        .Parameter(index) -> "parameter:{index}"
        .Static(module_path, name) -> "static:{module_path}::{name}"
    }
    path :: loop projection in value.projections -> if projection == {
        .Field(name) -> "field:{name}"
        .Index -> "index"
        .Range -> "range"
    }
    "{owner};path:{path.join("/")}"
}

// Rust BTreeSet<ViewSourcePath> ordering is enum/tuple ordering, never display
// text ordering. Sort indices, borrowing the caller's paths; deduplicate as Set.
pub fn view_provenance_canonical(value: ViewProvenance) -> String Never! {
    order := (loop (index, _) in value.sources -> index)
    paths :: value.sources[0..<value.sources.len()]
    &order.sort_by((left: Int, right: Int) -> canonical_ast_compare_view_paths(paths[left], paths[right]))
    sources := [String]{}
    previous := Int?{None}
    loop index in order {
        if previous == .Val(old) && canonical_ast_compare_view_paths(paths[old], paths[index]) == Ordering.Equal -> next
        &sources.push(view_source_path_canonical(paths[index]))
        previous = Val(index)
    }
    access :: if value.mutable -> "write" else -> "read"
    if sources.len() == 1 {
        parts :: sources[0].split(";path:")
        "{parts[0]};access:{access};path:{parts[1]}"
    } else -> "one_of({sources.join(",")});access:{access}"
}

// Rust AST/comptime.rs::canonical_view_provenance_map: Vec<String> keys use
// lexicographic segment order, not dotted display-string order.
pub fn canonical_view_provenance_map(map: ViewProvenanceMap) -> String Never! {
    order := (loop (index, _) in map.entries -> index)
    entries :: map.entries[0..<map.entries.len()]
    &order.sort_by((left: Int, right: Int) -> canonical_ast_compare_strings(entries[left].slot, entries[right].slot))
    parts := [String]{}
    loop index in order {
        entry :: entries[index]
        slot :: if entry.slot.len() == 0 -> "$" else -> entry.slot.join(".")
        &parts.push("{slot}={view_provenance_canonical(entry.value)}")
    }
    parts.join("|")
}

pub enum SymbolKind {
    Module
    Function
    Type
    Trait
    Impl
    Constant
    Field
    Variant
    Parameter
    Local
    Import
    Foreign
    Label
}

// The canonical key, rather than allocation order, is declaration identity.
// Numeric MIR IDs are derived separately at the backend-neutral lowering edge.
pub struct SymbolID {
    pub key: String
}

pub struct Symbol {
    pub id: SymbolID
    pub kind: SymbolKind
    pub name: String
    pub module_name: String
    pub owner: String?
    pub span: Span
    pub ty: Type?
    pub visibility: Int
}

pub fn symbol_id(kind: SymbolKind, module_name: String, owner: String, name: String) -> SymbolID Never! {
    SymbolID{key: "{symbol_kind_name(kind)}:{module_name}:{owner}:{name}"}
}

pub fn symbol_kind_name(kind: SymbolKind) -> String Never! {
    if kind == {
        .Module -> "module"
        .Function -> "function"
        .Type -> "type"
        .Trait -> "trait"
        .Impl -> "impl"
        .Constant -> "constant"
        .Field -> "field"
        .Variant -> "variant"
        .Parameter -> "parameter"
        .Local -> "local"
        .Import -> "import"
        .Foreign -> "foreign"
        .Label -> "label"
    }
}

pub fn type_carrier_identity(ty: Type) -> String Never! {
    if ty == {
        .Int -> "Int"
        .Float -> "Float"
        .Bool -> "Bool"
        .String -> "String"
        .Char -> "Char"
        .List(inner) -> "[{type_carrier_identity(inner)}]"
        .Map(key, _, value) -> "[{type_carrier_identity(key)}:{type_carrier_identity(value)}]"
        .Shared(inner) -> "Shared<{type_carrier_identity(inner)}>"
        .Option(inner) -> "?{type_carrier_identity(inner)}"
        .Result(ok, err) -> "{type_carrier_identity(ok)} ! {type_carrier_identity(err)}"
        .Fn(params, ret, _, _, _, _) -> {
            names := [String]{}
            loop param in params -> &names.push(type_carrier_identity(param))
            signature := "fn({names.join(", ")})"
            if ret == .Val(value) {
                signature = "{signature} => {type_carrier_identity(value)}"
            }
            signature
        }
        .Named(name) -> name
        .Apply(name, args) -> {
            names := [String]{}
            loop arg in args -> &names.push(type_carrier_identity(arg))
            "{name}<{names.join(", ")}>"
        }
        .TraitObject(bounds) -> bounds.join(" + ")
        .Tuple(fields) -> {
            names := [String]{}
            loop field in fields -> &names.push("{field.name}: {type_carrier_identity(field.ty)}")
            "({names.join(", ")})"
        }
        .FixedList(elem, _) -> "[{type_carrier_identity(elem)}]"
        .IntN(signed, bits) -> {
            prefix :: if signed -> "I" else -> "U"
            "{prefix}{bits}"
        }
        .InlineRange(base, _, _) -> type_carrier_identity(base)
        .Float32 -> "F32"
        .Tagged(_, inner) -> type_carrier_identity(inner)
        .Union(members) -> {
            names := [String]{}
            loop member in members -> &names.push(type_carrier_identity(member))
            names.join(" | ")
        }
        .Quantity(base, _) -> type_carrier_identity(base)
        .Measure(_) -> "Int"
    }
}

pub fn type_name(ty: Type) -> String Never! {
    if ty == {
        .FixedList(elem, len) -> "[{type_name(elem)}#{measure_expression(len)}]"
        .IntN(signed, bits) -> {
            prefix :: if signed -> "I" else -> "U"
            "{prefix}{bits}"
        }
        .InlineRange(base, lo, hi) -> "{type_name(base)}({lo}..{hi})"
        .Tagged(marker, inner) -> {
            if marker == {
                .User(name) -> "#{name} {type_name(inner)}"
                .Internal(_) -> type_name(inner)
            }
        }
        .Quantity(base, dimension) -> "Quantity<{dimension_display_name(dimension)}, {type_name(base)}; {dimension_identity(dimension)}>"
        .Measure(value) -> measure_expression(value)
        .TraitObject(bounds) -> bounds.join(" + ")
        .Union(members) -> {
            names := [String]{}
            loop member in members -> &names.push(type_name(member))
            names.join(" | ")
        }
        .Named(name) -> name
        .Apply(name, args) -> {
            if {
                name == "Ptr" && args.len() == 1 -> "*{type_name(args[0])}"
                else -> {
                    dimensions_opt :: compute_shape_dimensions(ty)
                    if dimensions_opt == {
                        .Val(values) -> {
                            dimensions := [String]{}
                            loop dimension in values -> &dimensions.push("{dimension}")
                            "{name}<{dimensions.join(", ")}>"
                        }
                        .None -> type_application_name(name, args)
                    }
                }
            }
        }
        .Tuple(fields) -> {
            names := [String]{}
            loop field in fields -> &names.push("{field.name}: {type_name(field.ty)}")
            "({names.join(", ")})"
        }
        .List(inner) -> "[{type_name(inner)}]"
        .Map(key, _, value) -> "[{type_name(key)}:{type_name(value)}]"
        .Shared(inner) -> "Shared<{type_name(inner)}>"
        .Option(inner) -> "{type_marked_name(inner)}?"
        .Result(ok, err) -> result_surface_name(ok, err)
        // A callable type's surface spelling: `fn(T) -> U`, `fn(T) -[E]> U`,
        // and the unit-fallible `fn(T) IOError!` with no arrow before its contract.
        .Fn(params, ret, effect_bound, param_contract, _, _) -> {
            out := "fn({function_parameter_names(params, param_contract)})"
            shown_ret := ret
            if ret == .Val(value) && type_is_unit_callable_return(value) -> shown_ret = None
            unit_fallible := false
            if shown_ret == .Val(value) {
                if value == .Result(ok, _) -> unit_fallible = ok == Type.Named{name: "Unit"}
            }
            if effect_bound == .Val(rows) {
                effect_names :: loop row in rows -> row.name
                out = "{out} -[{effect_names.join(", ")}]>"
            } else if shown_ret != None && !unit_fallible {
                out = "{out} ->"
            }
            if shown_ret == .Val(value) -> out = "{out} {type_name(value)}"
            out
        }
        else -> type_carrier_identity(ty)
    }
}

fn function_parameter_names(params: [Type], param_contract: [CallContractRow]?) -> String Never! {
    names := [String]{}
    contracts :: param_contract ?? [CallContractRow]{}
    star_done := false
    loop (i, param) in params {
        zone :: if i < contracts.len() -> contracts[i].zone else -> ParamZone.Either
        if zone == ParamZone.LabelOnly && !star_done {
            &names.push("*")
            star_done = true
        }
        label :: if i < contracts.len() -> contracts[i].label else -> ""
        if label == "" { &names.push(type_name(param)) } else { &names.push("{label}: {type_name(param)}") }
        next_zone :: if i + 1 < contracts.len() -> contracts[i + 1].zone else -> ParamZone.Either
        if zone == ParamZone.PositionalOnly && next_zone != ParamZone.PositionalOnly -> &names.push("/")
    }
    names.join(", ")
}

fn type_application_name(name: String, args: [Type]) -> String Never! {
    names := [String]{}
    loop arg in args -> &names.push(type_name(arg))
    "{name}<{names.join(", ")}>"
}

// D-TYPE-SUFFIX1=A: both type marks follow the type they mark: `T?`,
// `Int ParseError!`, `(A | B)!`, and unit-fallible `SaveError!`.
fn result_surface_name(ok: Type, err: Type) -> String Never! {
    default_error :: err == Type.Named{name: "Err"}
    unit_success :: ok == Type.Named{name: "Unit"}
    if unit_success -> return "{type_marked_name(err)}!"
    if !default_error -> return "{type_marked_name(ok)} {type_marked_name(err)}!"
    type_name(ok)
}

// A type written before a suffix mark is grouped when the mark would
// otherwise bind to its last member.
fn type_marked_name(ty: Type) -> String Never! {
    if ty == {
        .Union(members) -> {
            names := [String]{}
            loop member in members -> &names.push(type_name(member))
            "({names.join(" | ")})"
        }
        .Fn(_, _, _, _, _, _) | .Result(_, _) | .Tagged(_, _) -> "({type_name(ty)})"
        else -> type_name(ty)
    }
}

pub fn type_is_unit_callable_return(ty: Type) -> Bool Never! {
    if ty == {
        .Named(name) -> name == "Unit"
        .Result(ok, err) -> ok == Type.Named{name: "Unit"} && err == Type.Named{name: "Err"}
        else -> false
    }
}

pub fn type_identity(ty: Type) -> TypeIdentity Never! {
    TypeIdentity{carrier: type_carrier_identity(ty), knowledge: type_identity_knowledge(ty)}
}

pub fn type_identity_key(ty: Type) -> String Never! {
    identity_key(type_identity(ty))
}

// Compare declaration identity without allocating a serialized key. Compile-
// time facts and directional callable obligations remain separate judgments.
pub fn type_identity_equal(left: Type, right: Type) -> Bool Never! {
    if left == {
        .Tagged(marker, inner) -> {
            if tag_is_identity_bearing(marker) {
                if right == {
                    .Tagged(other_marker, other_inner) -> {
                        if !tag_is_identity_bearing(other_marker) || marker != other_marker -> return false
                        return type_identity_equal(inner, other_inner)
                    }
                    else -> return false
                }
            }
            return type_identity_equal(inner, right)
        }
        else -> {}
    }
    if right == {
        .Tagged(marker, inner) -> {
            if tag_is_identity_bearing(marker) -> return false
            return type_identity_equal(left, inner)
        }
        else -> {}
    }
    same := if left == {
        .Int -> right == Type.Int
        .Float -> right == Type.Float
        .Bool -> right == Type.Bool
        .String -> right == Type.String
        .Char -> right == Type.Char
        .Float32 -> right == Type.Float32
        .List(element) -> if right == {
            .List(other) -> type_identity_equal(element, other)
            else -> false
        }
        .Map(key, _, value) -> if right == {
            .Map(other_key, _, other_value) -> type_identity_equal(key, other_key) && type_identity_equal(value, other_value)
            else -> false
        }
        .Shared(inner) -> if right == {
            .Shared(other) -> type_identity_equal(inner, other)
            else -> false
        }
        .Option(inner) -> if right == {
            .Option(other) -> type_identity_equal(inner, other)
            else -> false
        }
        .Result(ok, err) -> if right == {
            .Result(other_ok, other_err) -> type_identity_equal(ok, other_ok) && type_identity_equal(err, other_err)
            else -> false
        }
        .Fn(params, ret, _, contract, metadata, _) -> if right == {
            .Fn(other_params, other_ret, _, other_contract, other_metadata, _) -> type_array_identity_equal(params, other_params) && type_optional_identity_equal(ret, other_ret) && call_contract_identity_equal(contract, other_contract) && call_variadic_identity_equal(metadata, other_metadata)
            else -> false
        }
        .Named(name) -> if right == {
            .Named(other) -> name == other
            else -> false
        }
        .Apply(name, args) -> if right == {
            .Apply(other_name, other_args) -> name == other_name && type_array_identity_equal(args, other_args)
            else -> false
        }
        .TraitObject(bounds) -> if right == {
            .TraitObject(other) -> string_array_identity_equal(bounds, other)
            else -> false
        }
        .Tuple(fields) -> if right == {
            .Tuple(other) -> tuple_fields_identity_equal(fields, other)
            else -> false
        }
        .FixedList(element, length) -> if right == {
            .FixedList(other_element, other_length) -> type_identity_equal(element, other_element) && length == other_length
            else -> false
        }
        .IntN(signed, bits) -> if right == {
            .IntN(other_signed, other_bits) -> signed == other_signed && bits == other_bits
            else -> false
        }
        .InlineRange(base, lo, hi) -> if right == {
            .InlineRange(other_base, other_lo, other_hi) -> lo == other_lo && hi == other_hi && type_identity_equal(base, other_base)
            else -> false
        }
        .Union(members) -> if right == {
            .Union(other) -> type_array_identity_equal(members, other)
            else -> false
        }
        .Quantity(base, dimension) -> if right == {
            .Quantity(other_base, other_dimension) -> type_identity_equal(base, other_base) && dimension_identity_equal(dimension, other_dimension)
            else -> false
        }
        .Measure(measure) -> if right == {
            .Measure(other) -> measure == other
            else -> false
        }
        .Tagged(_, _) -> false
        else -> false
    }
    same
}

fn tag_is_identity_bearing(marker: TagMarker) -> Bool Never! {
    marker == TagMarker.Internal{internal_tag: InternalTag.CoreCryptoNominal}
}

fn type_array_identity_equal(left: [Type], right: [Type]) -> Bool Never! {
    if left.len() != right.len() -> return false
    loop (i, value) in left {
        if !type_identity_equal(value, right[i]) -> return false
    }
    true
}

fn type_optional_identity_equal(left: Type?, right: Type?) -> Bool Never! {
    if left == .Val(left_type) {
        if right == .Val(right_type) -> return type_identity_equal(left_type, right_type)
        return false
    }
    right == None
}

fn call_contract_identity_equal(left: [CallContractRow]?, right: [CallContractRow]?) -> Bool Never! {
    left == right
}

fn call_variadic_identity_equal(left: FunctionCallMetadata?, right: FunctionCallMetadata?) -> Bool Never! {
    function_variadic_obligation(left) == function_variadic_obligation(right)
}

fn string_array_identity_equal(left: [String], right: [String]) -> Bool Never! {
    if left.len() != right.len() -> return false
    loop (i, value) in left {
        if value != right[i] -> return false
    }
    true
}

fn tuple_fields_identity_equal(left: [TypeTupleField], right: [TypeTupleField]) -> Bool Never! {
    if left.len() != right.len() -> return false
    loop (i, field) in left {
        if field.name != right[i].name || !type_identity_equal(field.ty, right[i].ty) -> return false
    }
    true
}

fn dimension_identity_equal(left: Dimension, right: Dimension) -> Bool Never! {
    if left.axes.len() != right.axes.len() -> return false
    loop (i, axis) in left.axes {
        if axis.name != right.axes[i].name || axis.exponent != right.axes[i].exponent -> return false
    }
    true
}

pub fn type_with_effective_fn_returns(ty: Type) -> Type Never! {
    if ty == {
        .List(inner) -> Type.List{element: type_with_effective_fn_returns(inner)}
        .Map(key, key_span, value) -> Type.Map{key: type_with_effective_fn_returns(key), key_span: key_span, value: type_with_effective_fn_returns(value)}
        .Shared(inner) -> Type.Shared{inner: type_with_effective_fn_returns(inner)}
        .Option(inner) -> Type.Option{inner: type_with_effective_fn_returns(inner)}
        .Result(ok, err) -> Type.Result{ok: type_with_effective_fn_returns(ok), err: type_with_effective_fn_returns(err)}
        .Fn(params, ret, effect_bound, param_contract, call_metadata, return_view_provenance) -> {
            normalized_params := [Type]{}
            loop param in params -> &normalized_params.push(type_with_effective_fn_returns(param))
            normalized_ret := ret.map(value -> effective_callable_return(type_with_effective_fn_returns(value)))
            Type.Fn{params: normalized_params, ret: normalized_ret, effect_bound: effect_bound, param_contract: param_contract, call_metadata: call_metadata, return_view_provenance: return_view_provenance}
        }
        .Apply(name, args) -> {
            normalized_args := [Type]{}
            loop arg in args -> &normalized_args.push(type_with_effective_fn_returns(arg))
            Type.Apply{name: name, args: normalized_args}
        }
        .Tuple(fields) -> {
            normalized_fields := [TypeTupleField]{}
            loop field in fields -> &normalized_fields.push(TypeTupleField{name: field.name, ty: type_with_effective_fn_returns(field.ty)})
            Type.Tuple{fields: normalized_fields}
        }
        .FixedList(element, length) -> Type.FixedList{elem: type_with_effective_fn_returns(element), len: length}
        .InlineRange(base, lo, hi) -> Type.InlineRange{base: type_with_effective_fn_returns(base), lo: lo, hi: hi}
        .Tagged(marker, inner) -> if marker == (TagMarker.Internal{internal_tag: InternalTag.CppCallbackABI}) -> Type.Tagged{marker: marker, inner: inner} else -> Type.Tagged{marker: marker, inner: type_with_effective_fn_returns(inner)}
        .Union(members) -> {
            normalized_members := [Type]{}
            loop member in members -> &normalized_members.push(type_with_effective_fn_returns(member))
            Type.Union{members: normalized_members}
        }
        .Quantity(base, dimension) -> Type.Quantity{base: type_with_effective_fn_returns(base), dimension: dimension}
        else -> ty
    }
}

fn effective_callable_return(ty: Type) -> Type Never! {
    if ty == {
        .Named(name) -> if name == "Never" -> ty else -> Type.Result{ok: ty, err: Type.Named{name: "Err"}}
        .Option(_) -> ty
        .Result(_, _) -> ty
        else -> Type.Result{ok: ty, err: Type.Named{name: "Err"}}
    }
}

pub fn compute_dimension_type(value: Int) -> Type Never! {
    Type.Measure{measure: Measure.Literal{kind: "shape", value: value}}
}

pub fn compute_dimension_value(ty: Type) -> Int? {
    if ty == {
        .Measure(value) -> {
            if measure_kind(value) != "shape" -> return None
            measure_literal_value(value)
        }
        else -> None
    }
}

pub fn compute_shape_type(name: String, dimensions: [Int]) -> Type Never! {
    args :: loop dimension in dimensions -> compute_dimension_type(dimension)
    Type.Apply{name: name, args: args}
}

pub fn compute_shape_measures(ty: Type) -> [Measure]? {
    if ty == {
        .Apply(name, args) -> compute_shape_measures_apply(name, args)
        else -> None
    }
}

fn compute_shape_measures_apply(name: String, args: [Type]) -> [Measure]? {
    expected :: if name == {
        "Vec" -> 1
        "Matrix" -> 2
        else -> 0
    }
    if expected == 0 || args.len() != expected -> return None
    measures := [Measure]{}
    loop arg in args {
        if arg == {
            .Measure(measure) -> {
                if measure_kind(measure) != "shape" -> return None
                &measures.push(measure)
            }
            else -> return None
        }
    }
    Val(measures)
}

pub fn compute_shape_dimensions(ty: Type) -> [Int]? {
    measures :: compute_shape_measures(ty) ?? return None
    dimensions := [Int]{}
    loop measure in measures {
        value :: measure_literal_value(measure) ?? return None
        &dimensions.push(value)
    }
    Val(dimensions)
}

// D-COMPUTE-TYPE1: the source-owned `core.compute` declaration is the one
// Tensor owner, so its canonical nominal is the same family as `Tensor`.
pub fn is_compute_tensor_family(ty: Type) -> Bool Never! {
    if ty == {
        .Tagged(_, inner) -> is_compute_tensor_family(inner)
        .Named(name) -> name == "Tensor" || name == "<corelib>/Core/compute::Core/compute/compute.jet::Tensor"
        .Apply(name, args) -> is_compute_tensor_application(name, args)
        else -> false
    }
}

fn is_compute_tensor_application(name: String, args: [Type]) -> Bool Never! {
    if name == "Tensor" -> return args.len() <= 1
    expected :: if name == {
        "Vec" -> 1
        "Matrix" -> 2
        else -> 0
    }
    if expected == 0 || args.len() != expected -> return false
    if compute_shape_dimensions(Type.Apply{name: name, args: args}) != None -> return true
    loop arg in args {
        if arg != Type.Int -> return false
    }
    true
}

pub fn is_compute_view_mut(ty: Type) -> Bool Never! {
    if ty == {
        .Apply(name, args) -> name == "ComputeViewMut" && args.len() == 1 && args[0] == Type.Float
        else -> false
    }
}

fn is_measure_type(ty: Type) -> Bool Never! {
    if ty == {
        .Measure(_) -> true
        else -> false
    }
}

fn is_compute_shape_type(name: String, args: [Type]) -> Bool Never! {
    expected :: if name == {
        "Vec" -> 1
        "Matrix" -> 2
        else -> 0
    }
    if expected == 0 || args.len() != expected -> return false
    loop arg in args {
        if arg == {
            .Measure(value) -> {
                if measure_kind(value) != "shape" -> return false
            }
            else -> return false
        }
    }
    true
}

fn type_simd_lane_arity(name: String) -> Int? {
    if name == {
        "F32x4" | "F64x4" | "I32x4" | "U32x4" | "I64x4" | "U64x4" -> Val(4)
        "F64x2" | "I64x2" | "U64x2" -> Val(2)
        "F32x8" | "I16x8" | "U16x8" | "I32x8" | "U32x8" -> Val(8)
        "I8x16" | "U8x16" | "I16x16" | "U16x16" -> Val(16)
        "I8x32" | "U8x32" -> Val(32)
        else -> None
    }
}

pub fn identity_key(identity: TypeIdentity) -> String Never! {
    facts := [String]{}
    loop entry in identity.knowledge.entries {
        path :: if entry.path.len() == 0 -> "self" else -> entry.path.join(".")
        &facts.push("{path}:{entry.plane}={knowledge_fact_key(entry.fact)}")
    }
    if facts.len() == 0 -> return identity.carrier
    "{identity.carrier}|{facts.join("|")}"
}

pub fn knowledge_fact_key(fact: KnowledgeFact) -> String Never! {
    if fact == {
        .Interval(lo, hi) -> "interval:{lo}..{hi}"
        .Layout(bytes) -> "layout:{bytes}"
        .Measure(value) -> "measure:{measure_key(value)}"
        .Exactness(value) -> {
            if value == {
                .Exact -> "exactness:exact"
                .Approximate(precision) -> "exactness:approximate:{precision}"
                .Measured -> "exactness:measured"
            }
        }
        .Dimension(value) -> "dimension:{dimension_identity(value)}"
        .Classification(name) -> "classification:{name}"
        .Nominal(name) -> "nominal:{name}"
        .Obligation(value) -> "obligation:{function_obligations_key(value)}"
    }
}

pub fn function_obligations_key(value: FunctionObligations) -> String Never! {
    contract := [String]{}
    contract_rows :: value.param_contract ?? [CallContractRow]{}
    loop row in contract_rows -> &contract.push("{row.label}:{param_zone_name(row.zone)}")
    variadic := [String]{}
    variadic_values :: value.variadic ?? [Bool]{}
    loop is_variadic in variadic_values -> &variadic.push("{is_variadic}")
    "contract=[{contract.join(",")}];variadic=[{variadic.join(",")}]"
}

pub fn param_zone_name(zone: ParamZone) -> String Never! {
    if zone == {
        .PositionalOnly -> "positional-only"
        .Either -> "either"
        .LabelOnly -> "label-only"
    }
}

fn type_identity_knowledge(ty: Type) -> KnowledgeVector Never! {
    entries := [KnowledgeEntry]{}
    if ty == {
        .Int -> &entries.push(KnowledgeEntry{path: [String]{}, plane: "Exactness", fact: KnowledgeFact.Exactness{value: Exactness.Exact}})
        .Float -> &entries.push(KnowledgeEntry{path: [String]{}, plane: "Exactness", fact: KnowledgeFact.Exactness{value: Exactness.Approximate{precision: 53}}})
        .Float32 -> &entries.push(KnowledgeEntry{path: [String]{}, plane: "Exactness", fact: KnowledgeFact.Exactness{value: Exactness.Approximate{precision: 24}}})
        .IntN(signed, bits) -> {
            lower := 0
            upper := (2 ^ bits) - 1
            if signed {
                lower = -(2 ^ (bits - 1))
                upper = (2 ^ (bits - 1)) - 1
            }
            &entries.push(KnowledgeEntry{path: [String]{}, plane: "Interval", fact: KnowledgeFact.Interval{lo: lower, hi: upper}})
            &entries.push(KnowledgeEntry{path: [String]{}, plane: "Layout", fact: KnowledgeFact.Layout{bytes: (bits + 7) /% 8}})
            &entries.push(KnowledgeEntry{path: [String]{}, plane: "Exactness", fact: KnowledgeFact.Exactness{value: Exactness.Exact}})
        }
        .InlineRange(base, lo, hi) -> {
            entries = merge_type_knowledge(entries, type_identity_knowledge(base), [String]{})
            &entries.push(KnowledgeEntry{path: [String]{}, plane: "Interval", fact: KnowledgeFact.Interval{lo: lo, hi: hi}})
        }
        .FixedList(elem, len) -> {
            entries = merge_type_knowledge(entries, type_identity_knowledge(elem), [String]{"element"})
            &entries.push(KnowledgeEntry{path: [String]{}, plane: "Measure", fact: KnowledgeFact.Measure{value: len}})
        }
        .Measure(value) -> &entries.push(KnowledgeEntry{path: [String]{}, plane: "Measure", fact: KnowledgeFact.Measure{value: value}})
        .Quantity(base, dimension) -> {
            entries = merge_type_knowledge(entries, type_identity_knowledge(base), [String]{"base"})
            &entries.push(KnowledgeEntry{path: [String]{}, plane: "Dimension", fact: KnowledgeFact.Dimension{value: dimension}})
        }
        .Fn(params, ret, _, param_contract, call_metadata, _) -> {
            loop (i, param) in params {
                entries = merge_type_knowledge(entries, type_identity_knowledge(param), [String]{"param", "{i}"})
            }
            if ret == .Val(ret_type) -> entries = merge_type_knowledge(entries, type_identity_knowledge(ret_type), [String]{"return"})
            variadic :: function_variadic_obligation(call_metadata)
            if param_contract != None || variadic != None {
                obligations :: FunctionObligations{effect_bound: None, param_contract: param_contract, variadic: variadic, return_view_provenance: None}
                &entries.push(KnowledgeEntry{path: [String]{}, plane: "Obligation", fact: KnowledgeFact.Obligation{value: obligations}})
            }
        }
        .List(inner) -> entries = merge_type_knowledge(entries, type_identity_knowledge(inner), [String]{"element"})
        .Shared(inner) -> entries = merge_type_knowledge(entries, type_identity_knowledge(inner), [String]{"inner"})
        .Option(inner) -> entries = merge_type_knowledge(entries, type_identity_knowledge(inner), [String]{"some"})
        .Map(key, _, value) -> {
            entries = merge_type_knowledge(entries, type_identity_knowledge(key), [String]{"key"})
            entries = merge_type_knowledge(entries, type_identity_knowledge(value), [String]{"value"})
        }
        .Result(ok, err) -> {
            entries = merge_type_knowledge(entries, type_identity_knowledge(ok), [String]{"ok"})
            entries = merge_type_knowledge(entries, type_identity_knowledge(err), [String]{"err"})
        }
        .Tuple(fields) -> {
            loop field in fields {
                entries = merge_type_knowledge(entries, type_identity_knowledge(field.ty), [String]{"field", field.name})
            }
        }
        .Union(members) -> {
            loop (i, member) in members {
                entries = merge_type_knowledge(entries, type_identity_knowledge(member), [String]{"member", "{i}"})
            }
        }
        .Tagged(marker, inner) -> {
            if {
                tag_is_identity_bearing(marker) -> {
                    entries = merge_type_knowledge(entries, type_identity_knowledge(inner), [String]{"inner"})
                    &entries.push(KnowledgeEntry{path: [String]{}, plane: "Nominal", fact: KnowledgeFact.Nominal{name: "core.crypto"}})
                }
                else -> entries = merge_type_knowledge(entries, type_identity_knowledge(inner), [String]{})
            }
        }
        .Apply(name, args) -> {
            if {
                name == "Measurement" && args.len() == 1 -> {
                    entries = merge_type_knowledge(entries, type_identity_knowledge(args[0]), [String]{"value"})
                    &entries.push(KnowledgeEntry{path: [String]{}, plane: "Exactness", fact: KnowledgeFact.Exactness{value: Exactness.Measured}})
                }
                else -> {
                    loop (i, arg) in args {
                        if !(name == "Vec" || name == "Matrix") || !is_measure_type(arg) {
                            entries = merge_type_knowledge(entries, type_identity_knowledge(arg), [String]{"argument", "{i}"})
                        }
                    }
                    if is_compute_shape_type(name, args) {
                        loop (i, arg) in args {
                            if arg == {
                                .Measure(value) -> &entries.push(KnowledgeEntry{path: [String]{"shape", "{i}"}, plane: "Measure", fact: KnowledgeFact.Measure{value: value}})
                                else -> {}
                            }
                        }
                    }
                }
            }
        }
        .Named(name) -> {
            if name == "Decimal" || name == "Fraction" -> &entries.push(KnowledgeEntry{path: [String]{}, plane: "Exactness", fact: KnowledgeFact.Exactness{value: Exactness.Exact}})
            lanes := type_simd_lane_arity(name)
            if lanes != None -> &entries.push(KnowledgeEntry{path: [String]{}, plane: "Measure", fact: KnowledgeFact.Measure{value: Measure.Literal{kind: "lane", value: lanes ?? 0}}})
        }
        else -> {}
    }
    KnowledgeVector{entries: entries}
}

fn function_variadic_obligation(metadata: FunctionCallMetadata?) -> [Bool]? {
    value :: metadata ?? return None
    has_variadic := false
    loop is_variadic in value.variadic {
        if is_variadic {
            has_variadic = true
            break
        }
    }
    if has_variadic -> return Val(value.variadic)
    None
}

fn merge_type_knowledge(target: [KnowledgeEntry], nested: KnowledgeVector, prefix: [String]) -> [KnowledgeEntry] Never! {
    out := target
    loop entry in nested.entries {
        path := [String]{}
        loop part in prefix -> &path.push(part)
        loop part in entry.path -> &path.push(part)
        &out.push(KnowledgeEntry{path: path, plane: entry.plane, fact: entry.fact})
    }
    out
}

struct CanonicalUnionMember { ty: Type, spelling: String, first: Int }

// Rust AST/types.rs:1144-1174. Keep first occurrence under Type identity, then
// stable source-spelling order. Empty and singleton unions collapse.
pub fn canonicalize_union(members: [Type]) -> Type Never! {
    unique := [CanonicalUnionMember]{}
    loop member in members -> canonical_union_collect(member, &unique)
    // #4499: retain Rust's exact O(n²) identity scan until canonical identity-key hashing exists; no regression.
    // Descending order plus owning pop avoids a second whole-Type copy;
    // first-occurrence indices make equal-spelling ordering explicitly stable.
    &unique.sort_by((left: CanonicalUnionMember, right: CanonicalUnionMember) -> if left.spelling != right.spelling -> right.spelling <=> left.spelling else -> right.first <=> left.first)
    if unique.len() == 0 -> return Type.Named{name: INTERNAL_UNIT_TYPE}
    if unique.len() == 1 {
        member := &unique.pop() ?? panic("singleton union has its member")
        return ^member.ty
    }
    sorted := [Type]{}
    loop unique.len() > 0 {
        member := &unique.pop() ?? panic("nonempty union member queue")
        &sorted.push(^member.ty)
    }
    Type.Union{members: sorted}
}
fn canonical_union_collect(ty: Type, unique: &[CanonicalUnionMember]) Never! {
    if ty == .Union(inner) {
        loop member in inner -> canonical_union_collect(member, &unique)
        return
    }
    loop existing in unique {
        if type_identity_equal(existing.ty, ty) -> return
    }
    &unique.push(CanonicalUnionMember{ty: ~ty, spelling: type_name(ty), first: unique.len()})
}

// Rust AST/types.rs:1071-1075,1453-1509. Visitors own leaf judgments; Apply
// names do not constrain structural shape here.
#Error
pub enum CompositeTypePairError { ShapeMismatch }
pub trait CompositeTypePairVisitor {
    fn visit(&self, left: Type, right: Type) Never!
}
pub fn type_for_each_composite_pair<V: CompositeTypePairVisitor>(left: Type, right: Type, visitor: &V) CompositeTypePairError! {
    if left == {
        .List(left_inner) -> if right == .List(right_inner) {
            &visitor.visit(left_inner, right_inner)
            type_for_each_composite_pair<V>(left_inner, right_inner, &visitor)
            return Ok(())
        }
        .Option(left_inner) -> if right == .Option(right_inner) {
            &visitor.visit(left_inner, right_inner)
            type_for_each_composite_pair<V>(left_inner, right_inner, &visitor)
            return Ok(())
        }
        .Result(left_ok, left_err) -> if right == .Result(right_ok, right_err) {
            &visitor.visit(left, right)
            type_for_each_composite_pair<V>(left_ok, right_ok, &visitor)
            type_for_each_composite_pair<V>(left_err, right_err, &visitor)
            return Ok(())
        }
        .Apply(_, left_args) -> if right == .Apply(_, right_args) {
            if left_args.len() != right_args.len() -> return Err(CompositeTypePairError.ShapeMismatch)
            &visitor.visit(left, right)
            loop (index, arg) in left_args -> type_for_each_composite_pair<V>(arg, right_args[index], &visitor)
            return Ok(())
        }
        else -> {}
    }
    if type_is_walked_composite(left) || type_is_walked_composite(right) -> return Err(CompositeTypePairError.ShapeMismatch)
    &visitor.visit(left, right)
    Ok(())
}
fn type_is_walked_composite(ty: Type) -> Bool Never! {
    if ty == { .List(_) | .Option(_) | .Result(_, _) | .Apply(_, _) -> true else -> false }
}
fn type_is_matched_walked_composite(left: Type, right: Type) -> Bool Never! {
    if left == {
        .List(_) -> right == .List(_)
        .Option(_) -> right == .Option(_)
        .Result(_, _) -> right == .Result(_, _)
        .Apply(_, _) -> right == .Apply(_, _)
        else -> false
    }
}

// Rust AST/types.rs:1709-1742, reusing the existing variadic projection.
fn type_function_obligations(ty: Type) -> FunctionObligations? Never! {
    if ty == .Fn(_, _, effects, contract, metadata, provenance) {
        variadic :: function_variadic_obligation(metadata)
        if effects == None && contract == None && variadic == None && provenance == None -> return None
        effect_names := [String]?{None}
        if effects == .Val(rows) -> effect_names = Val(loop row in rows -> row.name)
        return Val(FunctionObligations{effect_bound: effect_names, param_contract: ~contract, variadic: variadic, return_view_provenance: ~provenance})
    }
    None
}

// Rust FunctionObligations::satisfies (types.rs:567-623). The canonical
// ViewProvenanceMap entry carrier remains the one shared representation.
// #4499: lookup-complexity parity additionally needs canonical composite-key
// ViewSlotPath maps and ViewSourcePath sets; preserve the existing shared
// carriers until that capability lands, never encode keys into Strings.
pub fn function_obligations_satisfy(offered: FunctionObligations, required: FunctionObligations) -> Bool Never! {
    if required.effect_bound == .Val(required_effects) {
        offered_effects :: offered.effect_bound ?? return false
        loop effect in offered_effects { if !required_effects.contains(effect) -> return false }
    }
    if required.param_contract == .Val(required_contract) {
        if offered.param_contract == .Val(offered_contract) {
            if required_contract.len() != offered_contract.len() -> return false
            loop (index, row) in offered_contract {
                required_row :: required_contract[index]
                if row.label != required_row.label || (row.zone != ParamZone.Either && row.zone != required_row.zone) -> return false
            }
        }
    }
    if required.variadic == .Val(required_variadic) {
        if offered.variadic == .Val(offered_variadic) { if offered_variadic != required_variadic -> return false }
    }
    if required.return_view_provenance == .Val(required_map) {
        offered_map :: offered.return_view_provenance ?? return false
        loop required_entry in required_map.entries {
            found := false
            loop entry in offered_map.entries {
                if entry.slot != required_entry.slot -> next
                if required_entry.value.mutable && !entry.value.mutable -> return false
                loop source in entry.value.sources {
                    if !required_entry.value.sources.contains(source) -> return false
                }
                found = true
                break
            }
            if !found -> return false
        }
    }
    true
}

struct TypeObligationsVisitor { satisfied: Bool }
impl TypeObligationsVisitor.CompositeTypePairVisitor {
    fn visit(&self, required: Type, offered: Type) Never! {
        if self.satisfied && !type_is_matched_walked_composite(required, offered) {
            self.satisfied = type_obligations_satisfy(required, offered)
        }
    }
}

// Rust AST/types.rs:1744-1846. Only matching composite kinds invoke the
// structural walker. Leaf carrier equality is a separate judgment.
pub fn type_obligations_satisfy(required: Type, offered: Type) -> Bool Never! {
    if required == {
        .Fn(required_params, required_ret, _, _, _, _) -> if offered == .Fn(offered_params, offered_ret, _, _, _, _) {
            if type_function_obligations(required) == .Val(contract) {
                offered_contract :: type_function_obligations(offered) ?? FunctionObligations{effect_bound: None, param_contract: None, variadic: None, return_view_provenance: None}
                if !function_obligations_satisfy(offered_contract, contract) -> return false
            }
            if required_params.len() != offered_params.len() -> return false
            loop (index, param) in required_params {
                if !type_obligations_satisfy(param, offered_params[index]) -> return false
            }
            return if required_ret == {
                .None -> if offered_ret == { .None -> true .Val(value) -> type_is_unit_callable_return(value) }
                .Val(value) -> if offered_ret == { .None -> type_is_unit_callable_return(value) .Val(other) -> type_obligations_satisfy(value, other) }
            }
        }
        .Shared(inner) -> if offered == .Shared(other) -> return type_obligations_satisfy(inner, other)
        .Map(key, _, value) -> if offered == .Map(other_key, _, other_value) -> return type_obligations_satisfy(key, other_key) && type_obligations_satisfy(value, other_value)
        .Tuple(fields) -> if offered == .Tuple(other_fields) {
            if fields.len() != other_fields.len() -> return false
            loop (index, field) in fields {
                if field.name != other_fields[index].name || !type_obligations_satisfy(field.ty, other_fields[index].ty) -> return false
            }
            return true
        }
        .FixedList(elem, _) -> if offered == .FixedList(other, _) -> return type_obligations_satisfy(elem, other)
        .Quantity(base, _) -> if offered == .Quantity(other, _) -> return type_obligations_satisfy(base, other)
        .Union(members) -> if offered == .Union(other_members) {
            if members.len() != other_members.len() -> return false
            loop (index, member) in members {
                if !type_obligations_satisfy(member, other_members[index]) -> return false
            }
            return true
        }
        else -> {}
    }
    if type_is_matched_walked_composite(required, offered) {
        visitor := TypeObligationsVisitor{satisfied: true}
        if type_for_each_composite_pair<TypeObligationsVisitor>(required, offered, &visitor) == .Err(_) -> return false
        return visitor.satisfied
    }
    // CoreCryptoNominal stays opaque; a transparent tag on the other side
    // still unwraps, exactly as Rust's ordered guarded match arms do.
    if required == .Tagged(marker, inner) {
        if !tag_is_identity_bearing(marker) -> return type_obligations_satisfy(inner, offered)
    }
    if offered == .Tagged(marker, inner) {
        if !tag_is_identity_bearing(marker) -> return type_obligations_satisfy(required, inner)
    }
    true
}
