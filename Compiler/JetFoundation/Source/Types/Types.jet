// Canonical semantic type and declaration identities shared by every compiler
// phase. Keep this separate from target layout and backend representations.
use core.collections.[Rows, Row]

#Equatable
Type: enum {
    Int,
    Float,
    Bool,
    String,
    Char,
    List(element: Type),
    Map(key: Type, key_span: Span?, value: Type),
    Shared(inner: Type),
    Option(inner: Type),
    Result(ok: Type, err: Type),
    Fn(params: [Type], ret: Type?, effect_bound: [EffectRowEntry]?, param_contract: [CallContractRow]?, call_metadata: FunctionCallMetadata?, return_view_provenance: ViewProvenanceMap?),
    Named(name: String),
    Apply(name: String, args: [Type]),
    TraitObject(bounds: [String]),
    Tuple(fields: [TypeTupleField]),
    FixedList(elem: Type, len: Measure),
    IntN(signed: Bool, bits: Int),
    InlineRange(base: Type, lo: Int, hi: Int),
    Float32,
    Tagged(marker: TagMarker, inner: Type),
    Union(members: [Type]),
    Case(name: String, payload: Type),
    Quantity(base: Type, dimension: Dimension),
    Measure(measure: Measure),
}

// `T?`: the optional suffix binds to the type it follows, so `[Int?]` and
// `[Int]?` differ; a second mark (`T?` again, or `T??`) is E0309. A
// written `Option<T>` is the same type.
// `T E!`: the error contract follows the success type (`Int ParseError!`,
// `Entry? (DBError | TimeoutError)!`). A type position holding only the
// contract, `E!` or `(A | B)!`, is `Result(Unit, E)`. A written
// `Result<T, E>` is the same type.
// `Name(T)` inside a union: the named case `Name` holding a `T`, written
// as inside an enum. Two named cases are one type when their names and
// payloads are; a named case is only ever a union's member.

// Shared primitive spelling authority for parsed types and Core call
// contracts. A size name (`U8`, `F64`) is the type its Core alias names
// (FOUNDATION_SIZE_ALIASES).
foundation_named_type: fn(name: String) -> Type Never! {
    if name == {
        "Int" -> Type.Int
        "Float" -> Type.Float
        "Bool" -> Type.Bool
        "String" -> Type.String
        "Char" -> Type.Char
        else -> foundation_size_alias(name) ?? Type.Named{name: name}
    }
}

// Core declares each number family once
// (Core/Prelude/Prelude.jet): `Signed<bits>` and `Unsigned<bits>` over
// `builtin.Word<bits>`, `IEEE<exponent, fraction>` over
// `builtin.FloatWord<exponent, fraction>`. Only standard sizes exist. A
// written size is the compiler's own type for it, so `Unsigned<8>` and its
// alias `U8` are one type and every report shows `U8`. The family names are
// read from the Prelude while the compiler builds, so no list of them is
// written here.
FOUNDATION_NUMBER_FAMILIES: #run foundation_number_family_rows(embed_file("toolchain:Core/Prelude/Prelude.jet"))

foundation_number_family: fn(name: String) -> Bool Never! {
    FOUNDATION_NUMBER_FAMILIES.contains(name)
}

// The number families `text` declares: each top-level `Name: struct<…> {`
// whose first line holds its storage, `raw: builtin.Word<…>` or
// `raw: builtin.FloatWord<…>`, in source order. A text with none stops the
// build.
foundation_number_family_rows: fn(text: String) -> [String] {
    families := [String]{}
    lines: text.split("\n").to_list()
    loop index in 0..<lines.len() - 1 {
        line: lines[index]
        colon: line.find(": struct<")
        if colon <= 0 || line.starts_with(" ") || !line.ends_with("{{") -> next
        storage: lines[index + 1].trim()
        if storage.starts_with("raw: builtin.Word<") || storage.starts_with("raw: builtin.FloatWord<") {
            families.push(line.slice(0..<colon))
        }
    }
    if families.len() == 0 -> panic("the text declares no number family `Name: struct<…> {{ raw: builtin.Word<…> }}`")
    families
}

// The written sizes of a family application, when every argument is a
// number literal (`Unsigned<8>`, `IEEE<11, 52>`). None when one is a name,
// as inside the family's own declaration (`Unsigned<bits>`).
foundation_family_sizes: fn(args: [Type]) -> [Int]? Never! {
    sizes := [Int]{}
    loop arg in args {
        if arg == .Measure(measure) && measure == .Literal(_, value) {
            sizes.push(value)
        } else {
            return None
        }
    }
    Val(sizes)
}

// The type a family names at `sizes`: `Signed<8|16|32|64>` and
// `Unsigned<8|16|32|64>` are IntN, `IEEE<8, 23>` is F32 and `IEEE<11, 52>`
// is F64. None for any other size, which no family has.
foundation_family_type: fn(name: String, sizes: [Int]) -> Type? Never! {
    if (name == "Signed" || name == "Unsigned") && sizes.len() == 1 && FOUNDATION_FAMILY_WORD_BITS.contains(sizes[0]) {
        return Val(Type.IntN{signed: name == "Signed", bits: sizes[0]})
    }
    if name == "IEEE" && sizes.len() == 2 {
        if sizes[0] == 8 && sizes[1] == 23 -> return Val(Type.Float32)
        if sizes[0] == 11 && sizes[1] == 52 -> return Val(Type.Float)
    }
    None
}

// The sizes a whole-number family has, in bits.
FOUNDATION_FAMILY_WORD_BITS: [Int]{8, 16, 32, 64}

// The sizes `name`'s family has, as a report lists them.
foundation_family_size_list: fn(name: String) -> String Never! {
    if name == "IEEE" -> "`IEEE<8, 23>` (F32) and `IEEE<11, 52>` (F64)" else -> "`{name}<8>`, `{name}<16>`, `{name}<32>` and `{name}<64>`"
}

// A size name: the alias `name: family<sizes>` Core/Prelude/Prelude.jet
// declares at its top level (`U8: Unsigned<8>`, `F64: IEEE<11, 52>`).
FoundationSizeAlias: struct {
    name: String,
    family: String,
    sizes: [Int],
}

// The size names, read from the Prelude while the compiler builds, so the
// parser's and Sema's spellings are the aliases Core declares and no list
// of them is written here.
FOUNDATION_SIZE_ALIASES: #run foundation_size_alias_rows(embed_file("toolchain:Core/Prelude/Prelude.jet"))

// Each top-level line `NAME: Family<sizes>` of `text` whose family is a
// number family `text` declares, in source order. An alias of a size no
// family has, a name declared twice, or a text with none stops the build.
foundation_size_alias_rows: fn(text: String) -> [FoundationSizeAlias] {
    families: foundation_number_family_rows(text)
    rows := [FoundationSizeAlias]{}
    loop line in text.split("\n").to_list() {
        colon: line.find(": ")
        if colon <= 0 || line.starts_with(" ") || !line.ends_with(">") -> next
        name: line.slice(0..<colon)
        written: line.slice(colon + 2..<line.len() - 1)
        open: written.find("<")
        if open <= 0 -> next
        family: written.slice(0..<open)
        if !families.contains(family) -> next
        sizes := [Int]{}
        loop part in written.slice(open + 1..<written.len()).split(", ").to_list() {
            sizes.push(Int.parse(part) ?? panic("`{line}`: a size alias names its family at number sizes"))
        }
        if foundation_family_type(family, sizes) == None -> panic("`{line}`: no family has that size")
        loop row in rows {
            if row.name == name -> panic("`{name}` is declared as a size alias twice")
        }
        rows.push(FoundationSizeAlias{name: name, family: family, sizes: sizes})
    }
    if rows.len() == 0 -> panic("the text declares no size alias `NAME: Family<sizes>`")
    rows
}

// The type the size name `name` spells, or None when it is not one.
foundation_size_alias: fn(name: String) -> Type? Never! {
    loop row in FOUNDATION_SIZE_ALIASES {
        if row.name == name -> return foundation_family_type(row.family, row.sizes)
    }
    None
}

#Test("the size aliases are the Prelude's, one per family size") {
    text: "Signed: struct<bits: Int> {{\n    raw: builtin.Word<bits>,\n}}\n\nIEEE: struct<exponent: Int, fraction: Int> {{\n    raw: builtin.FloatWord<exponent, fraction>,\n}}\n\nI8: Signed<8>\nF32: IEEE<8, 23>\nBox: Pair<Int>\nU16: Unsigned<16>\n    U8: Unsigned<8>\n"
    assert_eq(foundation_number_family_rows(text), [String]{"Signed", "IEEE"})
    assert_eq(FOUNDATION_NUMBER_FAMILIES, [String]{"Signed", "Unsigned", "IEEE"})
    rows: foundation_size_alias_rows(text)
    assert_eq(rows.len(), 2)
    assert_eq(rows[0].name, "I8")
    assert_eq(rows[1].sizes, [Int]{8, 23})
    sized := [Type]{}
    loop row in FOUNDATION_SIZE_ALIASES {
        ty: foundation_family_type(row.family, row.sizes) ?? panic("`{row.name}` names no size")
        assert(!sized.contains(ty))
        sized.push(ty)
    }
    loop bits in FOUNDATION_FAMILY_WORD_BITS {
        assert(sized.contains(Type.IntN{signed: true, bits: bits}) && sized.contains(Type.IntN{signed: false, bits: bits}))
    }
    assert(sized.contains(Type.Float32) && sized.contains(Type.Float))
    assert_eq(foundation_named_type("U8"), Type.IntN{signed: false, bits: 8})
    assert_eq(foundation_named_type("F64"), Type.Float)
}

// Canonical live-link type `@T` (`Type.Apply{name: "@", args: [T]}`), matching
// `Ptr<T>`, `View<T>`, and `Cell<T>` without breaking downstream Type matches.
foundation_link_type: fn(inner: Type) -> Type Never! {
    Type.Apply{name: "@", args: [Type]{inner}}
}

foundation_link_inner: fn(ty: Type) -> Type? Never! {
    if ty == .Apply(name, args) && name == "@" && args.len() == 1 -> return Val(args[0])
    None
}

foundation_is_link_type: fn(ty: Type) -> Bool Never! {
    if ty == .Apply(name, args) -> name == "@" && args.len() == 1 else -> false
}

TypeTupleField: struct {
    name: String,
    ty: Type,
}

AccessConvention: enum {
    Read,
    Write,
    Move,
}

// The signature mark of a parameter's access (`&&` takes).
access_sigil: fn(access: AccessConvention) -> String Never! {
    if access == {
        .Write -> "&"
        .Move -> "&&"
        .Read -> ""
    }
}

TagMarker: enum {
    User(name: String),
    Internal(internal_tag: InternalTag),
}

InternalTag: enum {
    CoreCryptoNominal,
    DeterministicClock,
    SystemClock,
    ExpiringSecretLoan,
    SharedGuardRead,
    SharedGuardEdit,
    TerminalFactSet,
    CppCallbackABI,
    AllocatorView,
}

MeasureRule: enum {
    Add,
    Mul,
    Match,
}

Measure: enum {
    Literal(kind: String, value: Int),
    SignedLiteral(kind: String, value: Int),
    Symbol(kind: String, name: String),
    Combined(kind: String, rule: MeasureRule, left: Measure, right: Measure),
}

measure_kind: fn(measure: Measure) -> String Never! {
    if measure == {
        .Literal(kind, _) -> kind
        .SignedLiteral(kind, _) -> kind
        .Symbol(kind, _) -> kind
        .Combined(kind, _, _, _) -> kind
    }
}

measure_literal_value: fn(measure: Measure) -> Int? {
    if measure == {
        .Literal(_, value) -> Val(value)
        .Combined(_, rule, left, right) -> if rule == {
            .Add -> {
                l: measure_literal_value(left) ?? return None
                r: measure_literal_value(right) ?? return None
                Val(l + r)
            }
            .Mul -> {
                l: measure_literal_value(left) ?? return None
                r: measure_literal_value(right) ?? return None
                Val(l * r)
            }
            .Match -> None
        }
        .SignedLiteral(_, _) | .Symbol(_, _) -> None
    }
}

measure_signed_value: fn(measure: Measure) -> Int? {
    if measure == {
        .SignedLiteral(_, value) -> Val(value)
        .Literal(_, value) -> Val(value)
        .Combined(_, rule, left, right) -> if rule == {
            .Add -> {
                l: measure_signed_value(left) ?? return None
                r: measure_signed_value(right) ?? return None
                Val(l + r)
            }
            .Mul -> {
                l: measure_signed_value(left) ?? return None
                r: measure_signed_value(right) ?? return None
                Val(l * r)
            }
            .Match -> None
        }
        .Symbol(_, _) -> None
    }
}

measure_expression: fn(measure: Measure) -> String Never! {
    if measure == {
        .Literal(_, value) -> "{value}"
        .SignedLiteral(_, value) -> "{value}"
        .Symbol(_, name) -> name
        .Combined(_, rule, left, right) -> {
            left_name: measure_expression(left)
            right_name: measure_expression(right)
            if rule == {
                .Add -> "({left_name} + {right_name})"
                .Mul -> "({left_name} * {right_name})"
                .Match -> "match({left_name}, {right_name})"
            }
        }
    }
}

measure_key: fn(measure: Measure) -> String Never! {
    "{measure_kind(measure)}:{measure_expression(measure)}"
}

DimensionAxis: struct {
    name: String,
    exponent: Measure,
}

Dimension: struct {
    axes: [DimensionAxis],
}

// Axes stay sorted by base identity with zero exponents removed (Rust
// BTreeMap), so equality is stable; an exponent outside i32 makes the
// combination unrepresentable.
dimension_base: fn(identity: String) -> Dimension Never! {
    Dimension{axes: [DimensionAxis]{DimensionAxis{name: identity, exponent: Measure.SignedLiteral{kind: "dimension", value: 1}}}}
}

dimension_multiply: fn(left: Dimension, right: Dimension) -> Dimension? {
    dimension_combine(left, right, false)
}

dimension_divide: fn(left: Dimension, right: Dimension) -> Dimension? {
    dimension_combine(left, right, true)
}

dimension_combine: fn(left: Dimension, right: Dimension, subtract: Bool) -> Dimension? {
    axes := left.axes.copy()
    loop axis in right.axes {
        exponent: measure_signed_value(axis.exponent) ?? return None
        delta: if subtract -> -exponent else -> exponent
        found := false
        index := 0
        loop index < axes.len() {
            if axes[index].name == axis.name {
                found = true
                break
            }
            index += 1
        }
        current := 0
        if found -> current = measure_signed_value(axes[index].exponent) ?? return None
        next: current + delta
        if next < -2147483648 || next > 2147483647 -> return None
        if found {
            if next == 0 -> _ := axes.remove(index, .Slot) else {
                axes[index].exponent = Measure.SignedLiteral{kind: "dimension", value: next}
            }
        } else {
            if next != 0 {
                axes.push(DimensionAxis{name: axis.name, exponent: Measure.SignedLiteral{kind: "dimension", value: next}})
            }
        }
    }
    axes = loop fresh_item in axes -> fresh_item
    axes.sort_by(fn(a: DimensionAxis, b: DimensionAxis) { a.name <=> b.name })
    Val(Dimension{axes: axes})
}

dimension_identity: fn(dimension: Dimension) -> String Never! {
    parts := [String]{}
    loop axis in dimension.axes {
        exponent: measure_signed_value(axis.exponent).map(fn(value) { "{value}" }) ?? measure_expression(axis.exponent)
        parts.push("{escape_dimension_axis(axis.name)}:{exponent}")
    }
    parts.join(";")
}

dimension_display_name: fn(dimension: Dimension) -> String Never! {
    parts := [String]{}
    loop axis in dimension.axes {
        leaf: axis.name.split(".").to_list()
        name: if leaf.len() == 0 -> axis.name else -> leaf[leaf.len() - 1]
        exponent: measure_signed_value(axis.exponent)
        rendered: if {
            exponent == (Val(1)) -> name
            else -> {
                exponent_name: exponent.map(fn(value) { "{value}" }) ?? measure_expression(axis.exponent)
                "{name}^{exponent_name}"
            }
        }
        parts.push(rendered)
    }
    if parts.len() == 0 -> return "Scalar"
    parts.join(" * ")
}

escape_dimension_axis: fn(axis: String) -> String Never! {
    axis.replace("%", "%25").replace(";", "%3B").replace(":", "%3A")
}

// The dimension `identity` names (dimension_identity's inverse): `;`
// separates the axes and the last `:` of each splits its escaped name from
// its whole exponent. Every `%` an escaped name holds starts one of the three
// escapes, so undoing them in the reverse order restores the name byte for
// byte, a non-ASCII axis name included. None when a part is not `name:exponent`
// or its exponent is not a whole number in i32.
dimension_from_identity: fn(identity: String) -> Dimension? {
    axes := [DimensionAxis]{}
    if identity == "" -> return Val(Dimension{axes: axes})
    loop part in identity.split(";") {
        cut: part.cut_last(":") ?? return None
        exponent: Int.parse(cut.after) ?? return None
        if exponent == 0 || exponent < -2147483648 || exponent > 2147483647 -> return None
        name: cut.before.replace("%3A", ":").replace("%3B", ";").replace("%25", "%")
        axes.push(DimensionAxis{name: name, exponent: Measure.SignedLiteral{kind: "dimension", value: exponent}})
    }
    Val(Dimension{axes: axes})
}

Exactness: enum {
    Exact,
    Approximate(precision: Int),
    Measured,
}

KnowledgeFact: enum {
    Interval(lo: Int, hi: Int),
    Layout(bytes: Int),
    Measure(value: Measure),
    Exactness(value: Exactness),
    Dimension(value: Dimension),
    Classification(name: String),
    Nominal(name: String),
    Obligation(value: FunctionObligations),
}

KnowledgeEntry: struct {
    path: [String],
    plane: String,
    fact: KnowledgeFact,
}

KnowledgeVector: struct {
    entries: [KnowledgeEntry],
}

TypeIdentity: struct {
    carrier: String,
    knowledge: KnowledgeVector,
}

ParamZone: enum {
    PositionalOnly,
    Either,
    LabelOnly,
}

CallContractRow: struct {
    label: String,
    zone: ParamZone,
}

EffectRowEntry: struct {
    name: String,
    span: Span,
}

FunctionObligations: struct {
    effect_bound: [String]?,
    param_contract: [CallContractRow]?,
    variadic: [Bool]?,
    return_view_provenance: ViewProvenanceMap?,
}

CallablePolicy: struct {
    name: String,
    arguments: [String],
}

// The written policy call; its arguments are already textual.
callable_policy_display: fn(policy: CallablePolicy) -> String Never! {
    "{policy.name}({policy.arguments.join(", ")})"
}

CallablePolicyChain: struct {
    policies: [CallablePolicy],
}

// Callable defaults refer back to their owning declaration instead of copying
// an AST expression into the shared type. This keeps Type usable by parsing and
// sema without a Type <-> Expr module cycle; source+owner+index resolves a node.
FunctionCallMetadata: struct {
    names: [String],
    defaults: [FunctionDefaultRef?],
    variadic: [Bool],
    conventions: [AccessConvention],
    policies: CallablePolicyChain,
}

FunctionDefaultRef: struct {
    source_file: String,
    owner_key: String,
    parameter_index: Int,
    span: Span,
}

ViewSource: enum {
    Receiver,
    Parameter(index: Int),
    Static(module_path: String, name: String),
}

ViewSourceProjection: enum {
    Field(name: String),
    Index,
    Range,
}

ViewSourcePath: struct {
    source: ViewSource,
    projections: [ViewSourceProjection],
}

ViewProvenance: struct {
    sources: [ViewSourcePath],
    mutable: Bool,
}

ViewProvenanceEntry: struct {
    slot: [String],
    value: ViewProvenance,
}

ViewProvenanceMap: struct {
    entries: [ViewProvenanceEntry],
}

SymbolKind: enum {
    Module,
    Function,
    Type,
    Trait,
    Impl,
    Constant,
    Field,
    Variant,
    Parameter,
    Local,
    Import,
    Foreign,
    Label,
}

// A declaration's identity (#6793 S2, Docs/Spec/compiler-data.md): a U32 row
// of the run's `SymbolTable`, or, with SYMBOL_LOCAL_BIT, a row of the
// checking body's own `SymbolLocalKeys` (its locals and the keys it minted
// that no registration holds). Equal ids are equal keys. Id 0 is no symbol,
// the empty key. The key text (`symbol_key_text`) is resolved only at an
// edge: a diagnostic, an IR function name, a record.
SymbolID: struct {
    id: U32,
}

SYMBOL_LOCAL_BIT: U32{0x80000000}

SYMBOL_LOCAL_BASE: 2147483648

SYMBOL_LOCAL_BOUND: 2147483647

// One id range: the key of id `base + n` is row `n` of `keys` (row 0, the
// empty key, is never handed out above base 0). A registration module's
// range is reserved before its rows are prepared, so a thread interns into
// its own range and every id is the same for any thread count.
// `module_identity` is the module whose keys the range holds; the serial
// range has none.
SymbolKeys: struct {
    base: Int,
    bound: Int,
    keys: SymbolKeyRows,
    module_identity: ModuleID{module_none()},
}

// A range's keys, each held once, as its String: a probe compares a key's
// `name_text_hash` and then the String, so a lookup copies no bytes and the
// range keeps no second copy of its keys' bytes.
SymbolKeyRows: struct {
    texts: [String],
    hashes: [Int],
    // Open-addressing slots: 0 is empty, otherwise the row plus one.
    slots: [Int],
    mask: Int,
}

// The run's symbols: ranges in ascending base, and a hash index of the keys
// the closed ranges hold. The last range is open: its one writer interns
// there, and a lookup the closed keys miss reads its own keys.
SymbolTable: struct {
    ranges: [SymbolKeys],
    // Open-addressing slots over each closed key's `name_text_hash`: 0 is
    // empty, otherwise the key's id plus one. A probe compares the String
    // the id's range holds, so the index stores no key text.
    slots: [Int]{[Int]{0}},
    mask: Int{0},
}

symbol_none: fn() -> SymbolID Never! { SymbolID{id: U32{0}} }

symbol_is_none: fn(id: SymbolID) -> Bool Never! { id.id == U32{0} }

symbol_is_local: fn(id: SymbolID) -> Bool Never! { id.id & SYMBOL_LOCAL_BIT != U32{0} }

// The key text of a declaration: its kind, then its module identity, owner
// key and name joined by `.`, an empty module or owner adding no segment
// (`function:<corelib>/core.files.exists`, `function:Display.display`,
// `type:Int`). The kind is a namespace of its own: `type:m.Point` and
// `function:m.Point` are two keys.
symbol_key_text: fn(kind: SymbolKind, module_name: String, owner: String, name: String) -> String Never! {
    kind_name: symbol_kind_name(kind)
    if module_name == "" && owner == "" -> return "{kind_name}:{name}"
    if module_name == "" -> return "{kind_name}:{owner}.{name}"
    if owner == "" -> return "{kind_name}:{module_name}.{name}"
    "{kind_name}:{module_name}.{owner}.{name}"
}

// Where the declared name in symbol key `key` starts: after its last `.` or
// `:` (symbol_key_text). A name holds neither.
symbol_key_leaf_start: fn(key: String) -> Int Never! {
    bytes: key.bytes()
    at := bytes.len()
    loop at > 0 {
        if bytes[at - 1] == (U8{46}) || bytes[at - 1] == (U8{58}) -> return at
        at -= 1
    }
    0
}

// The declared name symbol key `key` ends with: `exists` for
// `function:<corelib>/core.files.exists`.
symbol_key_leaf: fn(key: String) -> String Never! {
    foundation_byte_text(key.bytes(), symbol_key_leaf_start(key), key.count_bytes())
}

// Whether symbol key `key` ends with the declared name `name`: `name` after
// a `.` or the kind's `:`.
symbol_key_names: fn(key: String, name: String) -> Bool Never! {
    key_bytes: key.bytes()
    name_bytes: name.bytes()
    if name_bytes.len() == 0 || name_bytes.len() >= key_bytes.len() || !key.ends_with(name) {
        return false
    }
    before: key_bytes[key_bytes.len() - name_bytes.len() - 1]
    before == (U8{46}) || before == (U8{58})
}

// A declaration's key read back into what symbol_key_text joined: its kind
// word, its module identity, its owner segment and its own name. A member's
// owner segment is its owner's own key (`type:m.Point`, `function:m.helper`)
// and `owner_name` that owner's declared name; both are "" for a free
// declaration, as the module is for a key with no `.` (`type:Int`).
SymbolKeyParts: struct {
    kind: String,
    module_identity: String,
    owner: String,
    owner_name: String,
    name: String,
}

// `key` cut into its parts (SymbolKeyParts). A module identity holds `.`
// and `:` of its own, so the module is the longest prefix of the text before
// the name, cut at a `.`, that `is_module` accepts; None when `key` has no
// kind word or no prefix is a module.
symbol_key_parts: fn(key: String, is_module: fn(String) -[Mem.Alloc, Mem.Rc, Time.Wait]> Bool Never!) -> SymbolKeyParts? Never! {
    split: key.split_once(":") ?? return None
    bytes: split.after.bytes()
    name_start: symbol_key_leaf_start(split.after)
    name: foundation_byte_text(bytes, name_start, bytes.len())
    if name_start == 0 {
        return Val(SymbolKeyParts{kind: split.before, module_identity: "", owner: "", owner_name: "", name: name})
    }
    head_end: name_start - 1
    at := head_end
    loop at > 0 {
        if at == head_end || bytes[at] == (U8{46}) {
            module_identity: foundation_byte_text(bytes, 0, at)
            if is_module(module_identity) {
                owner: if at == head_end -> "" else -> foundation_byte_text(bytes, at + 1, head_end)
                owner_name: if owner.contains(":") -> symbol_key_leaf(owner) else -> owner
                return Val(SymbolKeyParts{kind: split.before, module_identity: module_identity, owner: owner, owner_name: owner_name, name: name})
            }
        }
        at -= 1
    }
    None
}

#Test("symbol keys join kind, module, owner and name with `.`, and read their name back") {
    core: "<corelib>/core.files"
    user: "module:3:app:src/main.jet"
    keys: [String]{
        symbol_key_text(SymbolKind.Function, core, "", "exists"),
        symbol_key_text(SymbolKind.Function, user, "", "Point"),
        symbol_key_text(SymbolKind.Type, user, "", "Point"),
        symbol_key_text(SymbolKind.Function, user, "Point", "area"),
        symbol_key_text(SymbolKind.Parameter, user, symbol_key_text(SymbolKind.Function, user, "", "helper"), "x"),
        symbol_key_text(SymbolKind.Function, "", "Display", "display"),
        symbol_key_text(SymbolKind.Type, "", "", "Int"),
    }
    assert_eq(keys[0], "function:<corelib>/core.files.exists")
    assert_eq(keys[3], "function:module:3:app:src/main.jet.Point.area")
    assert_eq(keys[4], "parameter:module:3:app:src/main.jet.function:module:3:app:src/main.jet.helper.x")
    assert_eq(keys[5], "function:Display.display")
    assert_eq(keys[6], "type:Int")
    loop (index, key) in keys {
        assert(!key.contains("::"), "`{key}` holds `::`")
        loop other in index + 1..<keys.len() {
            assert(key != keys[other], "two declarations share `{key}`")
        }
    }
    names: [String]{"exists", "Point", "Point", "area", "x", "display", "Int"}
    loop (index, key) in keys {
        assert_eq(symbol_key_leaf(key), names[index])
        assert(symbol_key_names(key, names[index]), "`{key}` names `{names[index]}`")
    }
    assert(!symbol_key_names(keys[3], "rea"), "a name is matched whole")
    assert(!symbol_key_names("type:Int", "type:Int"), "the kind is no name")
    assert_eq(symbol_key_leaf("plain"), "plain")
    assert_eq(symbol_key_leaf_start("plain"), 0)
}

#Test("a key reads back its module, its owner by its declared name, and its name") {
    user: "module:3:app:src/main.jet"
    is_user: fn(text: String) -> Bool { text == "module:3:app:src/main.jet" }
    method: symbol_key_text(SymbolKind.Function, user, symbol_key_text(SymbolKind.Type, user, "", "Point"), "area")
    assert_eq(method, "function:module:3:app:src/main.jet.type:module:3:app:src/main.jet.Point.area")
    read: symbol_key_parts(method, is_user) ?? panic("`{method}` has no module")
    assert(read.kind == "function" && read.module_identity == user && read.owner == "type:module:3:app:src/main.jet.Point" && read.owner_name == "Point" && read.name == "area", "{read:Debug}")
    free: symbol_key_parts(symbol_key_text(SymbolKind.Function, user, "", "helper"), is_user) ?? panic("a free function has no module")
    assert(free.module_identity == user && free.owner == "" && free.owner_name == "" && free.name == "helper", "{free:Debug}")
    bare: symbol_key_parts(symbol_key_text(SymbolKind.Function, user, "Point", "area"), is_user) ?? panic("a bare owner has no module")
    assert(bare.owner == "Point" && bare.owner_name == "Point", "{bare:Debug}")
    builtin: symbol_key_parts("type:Int", is_user) ?? panic("`type:Int` reads no name")
    assert(builtin.kind == "type" && builtin.module_identity == "" && builtin.name == "Int", "{builtin:Debug}")
    assert(symbol_key_parts("function:module:4:lib:src/x.jet.run", is_user) == None, "an unknown module reads as none")
    assert(symbol_key_parts("plain", is_user) == None, "a text with no kind is no key")
}

symbol_keys: fn(base: Int, bound: Int) -> SymbolKeys Never! {
    SymbolKeys{base: base, bound: bound, keys: symbol_key_rows(NAME_TABLE_INITIAL_SLOTS)}
}

// No range: what a registration row holds once the run's table took its
// range.
symbol_keys_empty: fn() -> SymbolKeys Never! {
    SymbolKeys{base: 0, bound: 0, keys: symbol_key_rows(2)}
}

SYMBOL_LOCAL_INITIAL_SLOTS: 16

// A checking body's own keys (BodyTree.symbols): local id
// `SYMBOL_LOCAL_BASE + n` is row `n`, and row 0 is the empty key. A body
// mints a key for every local it declares, so no row holds a String: each
// key's bytes are stored once, back to back, as a NameTable stores its
// spellings, and every reader inside the body compares ids. A key's text is
// built only where it leaves the body (symbol_local_keys_text).
SymbolLocalKeys: struct {
    // Row `n` ends at `ends[n]` and starts where row `n - 1` ends.
    bytes: [U8],
    ends: [Int],
    // Each row's `name_text_hash`: a probe compares bytes only with a row of
    // the same hash, and a grow never hashes a key again.
    hashes: [Int],
    // Open-addressing slots: 0 is empty, otherwise the row plus one. Sealed
    // keys (symbol_local_keys_seal) have none, and mask 0.
    slots: [Int],
    mask: Int,
}

// A body's keys: few, so slots are built lazily on the first non-empty key.
symbol_local_keys: fn() -> SymbolLocalKeys Never! {
    SymbolLocalKeys{bytes: [U8]{}, ends: [Int]{0}, hashes: [Int]{NAME_EMPTY_HASH}, slots: [Int]{}, mask: 0}
}

// How many rows `keys` holds, the empty key's included.
symbol_local_keys_count: fn(keys: SymbolLocalKeys) -> Int Never! { keys.ends.len() }

symbol_local_id: fn(row: Int) -> SymbolID Never! {
    SymbolID{id: checked(U32{SYMBOL_LOCAL_BASE + row}) ?? panic("local symbol row {row} is out of range")}
}

// The row of local `id` in its body's keys.
symbol_local_row: fn(id: SymbolID) -> Int Never! { Int{id.id} - SYMBOL_LOCAL_BASE }

symbol_local_keys_start: fn(keys: SymbolLocalKeys, row: Int) -> Int Never! {
    if row == 0 -> 0 else -> keys.ends[row - 1]
}

// Whether row `row` of `keys` spells `bytes`.
symbol_local_keys_spells: fn(keys: SymbolLocalKeys, row: Int, bytes: [U8]) -> Bool Never! {
    first: symbol_local_keys_start(keys, row)
    if keys.ends[row] - first != bytes.len() -> return false
    loop offset in 0..<bytes.len() {
        if keys.bytes[first + offset] != bytes[offset] -> return false
    }
    true
}

// The row of `key`, whose `name_text_hash` is `hash`, when `keys` holds it.
// Sealed keys (symbol_local_keys_seal) have no slots, so their rows are
// scanned.
symbol_local_keys_row: fn(keys: SymbolLocalKeys, key: String, hash: Int) -> Int? Never! {
    if keys.slots.len() == 0 {
        if keys.hashes.len() == keys.ends.len() {
            loop row in 0..<keys.hashes.len() {
                if keys.hashes[row] == hash && symbol_local_keys_spells(keys, row, key.bytes()) {
                    return Val(row)
                }
            }
            return None
        }
        loop row in 0..<keys.ends.len() {
            if symbol_local_keys_spells(keys, row, key.bytes()) {
                return Val(row)
            }
        }
        return None
    }
    slot := hash & keys.mask
    loop {
        entry: keys.slots[slot]
        if entry == 0 -> break
        if (entry >> 32) == hash {
            row: (entry & 0xffffffff) - 1
            if symbol_local_keys_spells(keys, row, key.bytes()) {
                return Val(row)
            }
        }
        slot = (slot + 1) & keys.mask
    }
    None
}

// The id of `key` in `keys`, added when it is new.
symbol_local_keys_intern: fn(keys: &SymbolLocalKeys, key: String) -> SymbolID Never! {
    hash: name_text_hash(key)
    if symbol_local_keys_row(keys, key, hash) == .Val(found) -> return symbol_local_id(found)
    row: keys.ends.len()
    if row >= SYMBOL_LOCAL_BOUND {
        panic("a body's symbol keys are full ({SYMBOL_LOCAL_BOUND} keys)")
    }
    if keys.hashes.len() < row {
        loop index in keys.hashes.len()..<row {
            keys.hashes.push(name_text_hash(String.from_bytes(keys.bytes.slice(symbol_local_keys_start(keys, index), keys.ends[index])) ?? ""))
        }
    }
    keys.bytes.extend(key.bytes())
    keys.ends.push(keys.bytes.len())
    keys.hashes.push(hash)
    if keys.slots.len() == 0 || (row + 1) * 2 > keys.mask {
        // The slots double as the keys grow; sealed keys rebuild theirs at
        // the size growing to this many keys reached.
        capacity := SYMBOL_LOCAL_INITIAL_SLOTS
        loop capacity - 1 < (row + 1) * 2 -> capacity *= 2
        mask: capacity - 1
        slots := (loop _ in 0..<capacity -> 0)
        loop index in 0..<keys.hashes.len() {
            item_hash: keys.hashes[index]
            slot := item_hash & mask
            loop slots[slot] != 0 -> slot = (slot + 1) & mask
            slots[slot] = (item_hash << 32) | (index + 1)
        }
        keys.slots = slots.move()
        keys.mask = mask
        return symbol_local_id(row)
    }
    slot := hash & keys.mask
    loop keys.slots[slot] != 0 -> slot = (slot + 1) & keys.mask
    keys.slots[slot] = (hash << 32) | (row + 1)
    symbol_local_id(row)
}

// Drops the slots of keys that stop growing (body_tree_sealed): a body holds
// few keys, so a later find scans them, and a later intern rebuilds the
// slots first.
symbol_local_keys_seal: fn(keys: &SymbolLocalKeys) Never! {
    keys.slots = [Int]{}
    keys.mask = 0
}

// The id of `key` when `keys` holds it; never interns.
symbol_local_keys_find: fn(keys: SymbolLocalKeys, key: String) -> SymbolID? Never! {
    row: symbol_local_keys_row(keys, key, name_text_hash(key)) ?? return None
    Val(symbol_local_id(row))
}

// The key text of local `id`, which `keys` holds.
symbol_local_keys_text: fn(keys: SymbolLocalKeys, id: SymbolID) -> String Never! {
    symbol_local_keys_text_at(keys, id) ?? panic("local symbol row {symbol_local_row(id)} is outside its body's {keys.ends.len()} keys")
}

// The key text of local `id` when `keys` holds its row, else None: a reader
// that can't prove `id` came from `keys` refuses it instead of reading past
// the keys.
symbol_local_keys_text_at: fn(keys: SymbolLocalKeys, id: SymbolID) -> String? Never! {
    row: symbol_local_row(id)
    if row < 0 || row >= keys.ends.len() -> return None
    Val(String.from_bytes(keys.bytes.slice(symbol_local_keys_start(keys, row), keys.ends[row])) ?? "")
}

// Rows whose row 0 is the empty key, with at least `slots` slots to start
// (rounded up to a power of two, so a probe visits every slot); they grow
// as keys arrive.
symbol_key_rows: fn(slots: Int) -> SymbolKeyRows Never! {
    capacity := 2
    loop capacity < slots -> capacity *= 2
    rows := SymbolKeyRows{texts: [String]{}, hashes: [Int]{}, slots: (loop _ in 0..<capacity -> 0), mask: capacity - 1}
    _ := symbol_key_rows_intern(rows, "")
    rows
}

// The row of `key`, whose `name_text_hash` is `hash`, when `rows` holds it.
symbol_key_rows_find: fn(rows: SymbolKeyRows, key: String, hash: Int) -> Int? Never! {
    slot := hash & rows.mask
    loop {
        entry: rows.slots[slot]
        if entry == 0 -> break
        if (entry >> 32) == hash {
            row: (entry & 0xffffffff) - 1
            if rows.texts[row] == key -> return Val(row)
        }
        slot = (slot + 1) & rows.mask
    }
    None
}

// The row of `key`, added when it is new.
symbol_key_rows_intern: fn(rows: &SymbolKeyRows, key: String) -> Int Never! {
    hash: name_text_hash(key)
    if symbol_key_rows_find(rows, key, hash) == .Val(found) -> return found
    row: rows.texts.len()
    // copy: the rows keep their own key; `key` stays with the caller.
    rows.texts.push(key.copy())
    rows.hashes.push(hash)
    if (row + 1) * 2 > rows.mask {
        capacity: (rows.mask + 1) * 2
        mask: capacity - 1
        slots := (loop _ in 0..<capacity -> 0)
        loop index in 0..<rows.texts.len() {
            item_hash: rows.hashes[index]
            slot := item_hash & mask
            loop slots[slot] != 0 -> slot = (slot + 1) & mask
            slots[slot] = (item_hash << 32) | (index + 1)
        }
        rows.slots = slots.move()
        rows.mask = mask
        return row
    }
    slot := hash & rows.mask
    loop rows.slots[slot] != 0 -> slot = (slot + 1) & rows.mask
    rows.slots[slot] = (hash << 32) | (row + 1)
    row
}

// The core builtin types no module declares, like the owned traits: the task
// and channel handles (`Task`, `Receiver`, `Sender`) and the Event family's
// handles. A bare spelling of one is that type, whatever loaded module
// declares a type of its name. A subset view of the built-in type catalog
// (JET_TYPE_NAMES), which SYMBOL_BUILTIN_TYPES_CHECKED holds it to.
SYMBOL_BUILTIN_TYPES: [String]{"Task", "Receiver", "Sender", "Event", "Hook", "DecisionHook", "AsyncEvent", "DispatchReport", "EventScope", "Subscription", "EventTrace"}

SYMBOL_BUILTIN_TYPES_CHECKED: #run symbol_builtin_types_checked(SYMBOL_BUILTIN_TYPES, JET_TYPE_NAMES)

// The number of names in `view` (SYMBOL_BUILTIN_TYPES), once each is one of
// `vocabulary`; else the build stops naming the strays.
symbol_builtin_types_checked: fn(view: [String], vocabulary: [String]) -> Int {
    strays := [String]{}
    loop name in view {
        if !vocabulary.contains(name) -> strays.push(name.copy())
    }
    if strays.len() > 0 {
        panic("SYMBOL_BUILTIN_TYPES names {strays.join(", ")}, which the built-in type catalog JET_TYPE_NAMES does not hold")
    }
    view.len()
}

// The compiler-owned declarations no module declares: every owned trait
// (OWNED_TRAITS, which a bound may name bare), the builtin owner types, then
// each owned trait's declared methods. They are rows 1.. of the first range
// of every table, in this order, so a builtin's id is one constant in every
// run and a reader with no table names it (symbol_builtin,
// symbol_builtin_method). An owned trait a Core module declares
// (OwnedTrait.declared_in) is keyed in that module, as its declaration would
// mint it, and that declaration takes this id (sema_registration_named_symbol).
symbol_builtin_keys_build: fn() -> SymbolKeys Never! {
    keys := symbol_keys(0, SYMBOL_LOCAL_BOUND)
    loop index in 0..<OWNED_TRAITS.len() {
        _ := symbol_keys_intern(keys, symbol_key_text(SymbolKind.Trait, OWNED_TRAITS[index].declared_in, "", OWNED_TRAITS[index].name))
    }
    loop name in SYMBOL_BUILTIN_TYPES {
        _ := symbol_keys_intern(keys, symbol_key_text(SymbolKind.Type, "", "", name))
    }
    loop index in 0..<OWNED_TRAITS.len() {
        if OWNED_TRAITS[index].contract == .Methods(methods, _, _) {
            loop declared in methods {
                _ := symbol_keys_intern(keys, symbol_key_text(SymbolKind.Function, "", OWNED_TRAITS[index].name, declared.name))
            }
        }
    }
    keys.bound = keys.keys.texts.len()
    keys
}

SYMBOL_BUILTIN_KEYS: #run symbol_builtin_keys_build()

symbol_builtin_keys: fn() -> SymbolKeys Never! { SYMBOL_BUILTIN_KEYS }

// The id of the owned trait or builtin owner type `name`
// (symbol_builtin_keys).
symbol_builtin: fn(kind: SymbolKind, name: String) -> SymbolID? Never! {
    if kind == SymbolKind.Trait {
        loop index in 0..<OWNED_TRAITS.len() {
            if OWNED_TRAITS[index].name == name {
                return Val(SymbolID{id: checked(U32{1 + index}) ?? return None})
            }
        }
        return None
    }
    if kind != SymbolKind.Type -> return None
    loop (index, builtin) in SYMBOL_BUILTIN_TYPES {
        if builtin == name {
            return Val(SymbolID{id: checked(U32{1 + OWNED_TRAITS.len() + index}) ?? return None})
        }
    }
    None
}

// The id a declaration of `name` in the module `module_identity` takes when
// it is an owned trait that module declares (OwnedTrait.declared_in): the
// builtin's, whose key is the one the declaration would mint.
symbol_builtin_declared: fn(kind: SymbolKind, module_identity: String, name: String) -> SymbolID? Never! {
    if kind != SymbolKind.Trait || module_identity == "" -> return None
    loop index in 0..<OWNED_TRAITS.len() {
        if OWNED_TRAITS[index].name == name && OWNED_TRAITS[index].declared_in == module_identity {
            return Val(SymbolID{id: checked(U32{1 + index}) ?? return None})
        }
    }
    None
}

// The id of owned trait `trait_name`'s declared method `method`
// (symbol_builtin_keys).
symbol_builtin_method: fn(trait_name: String, method: String) -> SymbolID? Never! {
    row := 1 + OWNED_TRAITS.len() + SYMBOL_BUILTIN_TYPES.len()
    loop index in 0..<OWNED_TRAITS.len() {
        if OWNED_TRAITS[index].contract == .Methods(methods, _, _) {
            loop declared in methods {
                if OWNED_TRAITS[index].name == trait_name && declared.name == method {
                    return Val(SymbolID{id: checked(U32{row}) ?? return None})
                }
                row += 1
            }
        }
    }
    None
}

// The id of `key` in `keys`, interned when it is new.
symbol_keys_intern: fn(keys: &SymbolKeys, key: String) -> SymbolID Never! {
    row: symbol_key_rows_intern(keys.keys, key)
    if row >= keys.bound -> panic("symbol range at {keys.base} is full ({keys.bound} keys)")
    SymbolID{id: checked(U32{keys.base + row}) ?? panic("symbol id out of range")}
}

// The key of `id`, which `keys` holds.
symbol_keys_text: fn(keys: SymbolKeys, id: SymbolID) -> String Never! {
    keys.keys.texts[Int{id.id} - keys.base]
}

// A table of the builtin range (symbol_builtin_keys) and one open range
// after it.
symbol_table: fn() -> SymbolTable Never! { symbol_table_of([SymbolKeys]{symbol_builtin_keys()}) }

// A table whose one range, open, is `keys`: a registration module's while
// a thread prepares it.
symbol_table_open: fn(keys: &&SymbolKeys) -> SymbolTable Never! {
    SymbolTable{ranges: [SymbolKeys]{keys.move()}}
}

// The table of `ranges`, ordered by base, then an open range after the
// last. Overlapping ranges, or a key held by two ranges, are an internal
// error, since equal keys must be equal ids.
symbol_table_of: fn(ranges: &&[SymbolKeys]) -> SymbolTable Never! {
    owned := ranges.move()
    owned.sort_by(fn(left: SymbolKeys, right: SymbolKeys) { left.base <=> right.base })
    end := 0
    loop range in owned {
        if range.base < end {
            panic("symbol range at {range.base} overlaps the range before it, which ends at {end}")
        }
        end = range.base + range.bound
    }
    count := 0
    loop range in owned -> count += range.keys.texts.len()
    capacity := 16
    loop capacity < count * 2 -> capacity *= 2
    table := SymbolTable{ranges: owned.move(), slots: (loop _ in 0..<capacity -> 0), mask: capacity - 1}
    loop index in 0..<table.ranges.len() {
        loop row in 1..<table.ranges[index].keys.texts.len() {
            hash: table.ranges[index].keys.hashes[row]
            slot := hash & table.mask
            loop table.slots[slot] != 0 {
                if symbol_table_holds(table, table.slots[slot] - 1, hash, table.ranges[index].keys.texts[row]) {
                    panic("symbol key `{table.ranges[index].keys.texts[row]}` is held by two ranges")
                }
                slot = (slot + 1) & table.mask
            }
            table.slots[slot] = table.ranges[index].base + row + 1
        }
    }
    table.ranges.push(symbol_keys(end, SYMBOL_LOCAL_BOUND - end))
    table
}

// Whether the key of closed id `id` is `key`, whose `name_text_hash` is
// `hash`.
symbol_table_holds: fn(table: SymbolTable, id: Int, hash: Int, key: String) -> Bool Never! {
    at: symbol_table_range_of(table, id)
    row: id - table.ranges[at].base
    table.ranges[at].keys.hashes[row] == hash && table.ranges[at].keys.texts[row] == key
}

// The range `table` holds for the keys of module `identity`.
symbol_table_module_range: fn(table: SymbolTable, identity: ModuleID) -> Int? Never! {
    loop (index, range) in table.ranges {
        if range.module_identity == identity -> return Val(index)
    }
    None
}

// The id of `key`, if a range holds it.
symbol_find: fn(table: SymbolTable, key: String) -> SymbolID? Never! {
    if key == "" -> return Val(symbol_none())
    hash: name_text_hash(key)
    slot := hash & table.mask
    loop table.slots[slot] != 0 {
        id: table.slots[slot] - 1
        if symbol_table_holds(table, id, hash, key) {
            return Val(SymbolID{id: checked(U32{id}) ?? return None})
        }
        slot = (slot + 1) & table.mask
    }
    open: table.ranges.len() - 1
    row: symbol_key_rows_find(table.ranges[open].keys, key, hash) ?? return None
    Val(SymbolID{id: checked(U32{table.ranges[open].base + row}) ?? return None})
}

// The id of `key`, interned in the open range when no range holds it. Only
// the table's one writer (a serial phase, or the thread preparing a
// module's range) calls this.
symbol_intern: fn(table: &SymbolTable, key: String) -> SymbolID Never! {
    if symbol_find(table, key) == .Val(found) -> return found
    symbol_keys_intern(table.ranges[table.ranges.len() - 1], key)
}

// The id of the declaration with this kind, module, owner and name,
// interned as `symbol_intern` does.
symbol_mint: fn(table: &SymbolTable, kind: SymbolKind, module_name: String, owner: String, name: String) -> SymbolID Never! {
    symbol_intern(table, symbol_key_text(kind, module_name, owner, name))
}

#Test("symbol keys intern once, grow past their slots, and resolve across closed and open ranges") {
    module_keys := SymbolKeys{base: 1000, bound: 100, keys: symbol_key_rows(2)}
    loop index in 0..<40 {
        assert_eq(Int{symbol_keys_intern(module_keys, "local:m:f:v{index}").id}, 1001 + index)
    }
    assert_eq(Int{symbol_keys_intern(module_keys, "local:m:f:v7").id}, 1008)
    assert_eq(module_keys.keys.texts.len(), 41)
    assert(symbol_key_rows_find(module_keys.keys, "local:m:f:v40", name_text_hash("local:m:f:v40")) == None)
    table := symbol_table_of([SymbolKeys]{symbol_builtin_keys(), module_keys})
    assert_eq(Int{(symbol_find(table, "local:m:f:v39") ?? symbol_none()).id}, 1040)
    assert(symbol_find(table, "") != None)
    fresh: symbol_mint(table, SymbolKind.Function, "m", "", "g")
    assert_eq(Int{fresh.id}, 1101)
    assert(symbol_intern(table, "function:m.g") == fresh)
    assert_eq(symbol_table_key(table, fresh), "function:m.g")
    assert_eq(symbol_table_key(table, SymbolID{id: U32{1001}}), "local:m:f:v0")
}

#Test("a body's symbol keys intern once, grow past their slots, and spell each key back") {
    keys := symbol_local_keys()
    loop index in 0..<40 {
        assert_eq(Int{symbol_local_keys_intern(keys, "local:m:f:v{index}").id}, SYMBOL_LOCAL_BASE + 1 + index)
    }
    assert_eq(Int{symbol_local_keys_intern(keys, "local:m:f:v7").id}, SYMBOL_LOCAL_BASE + 8)
    assert_eq(symbol_local_keys_count(keys), 41)
    assert(symbol_local_keys_find(keys, "local:m:f:v40") == None)
    assert_eq(Int{(symbol_local_keys_find(keys, "local:m:f:v39") ?? symbol_none()).id}, SYMBOL_LOCAL_BASE + 40)
    assert_eq(symbol_local_keys_text(keys, symbol_local_id(1)), "local:m:f:v0")
    assert_eq(symbol_local_keys_text(keys, symbol_local_id(40)), "local:m:f:v39")
    assert(symbol_local_keys_text_at(keys, symbol_local_id(41)) == None)
}

#Test("sealed symbol keys still find each key, and an intern rebuilds their slots") {
    keys := symbol_local_keys()
    loop index in 0..<40 -> _ := symbol_local_keys_intern(keys, "local:m:f:v{index}")
    symbol_local_keys_seal(keys)
    assert_eq(keys.slots.len(), 0)
    assert_eq(Int{(symbol_local_keys_find(keys, "local:m:f:v39") ?? symbol_none()).id}, SYMBOL_LOCAL_BASE + 40)
    assert(symbol_local_keys_find(keys, "local:m:f:v40") == None)
    assert_eq(Int{symbol_local_keys_intern(keys, "local:m:f:v7").id}, SYMBOL_LOCAL_BASE + 8)
    assert_eq(keys.slots.len(), 0)
    assert_eq(Int{symbol_local_keys_intern(keys, "local:m:f:v40").id}, SYMBOL_LOCAL_BASE + 41)
    assert_eq(keys.slots.len(), 128)
    assert_eq(Int{(symbol_local_keys_find(keys, "local:m:f:v0") ?? symbol_none()).id}, SYMBOL_LOCAL_BASE + 1)
    assert_eq(Int{(symbol_local_keys_find(keys, "local:m:f:v40") ?? symbol_none()).id}, SYMBOL_LOCAL_BASE + 41)
}

// The range of `id`: the last one whose base is at most `id`.
symbol_table_range: fn(table: SymbolTable, id: SymbolID) -> Int Never! {
    symbol_table_range_of(table, Int{id.id})
}

// The range of id `value`: the last one whose base is at most `value`.
symbol_table_range_of: fn(table: SymbolTable, value: Int) -> Int Never! {
    count: table.ranges.len()
    if count <= 1 || value < table.ranges[1].base -> return 0
    low := I64{1}
    high := I64{count - 1}
    loop low < high {
        middle: wrapping(low + high + I64{1}) >> I64{1}
        if table.ranges[Int{middle}].base <= value -> low = middle else -> high = wrapping(middle - I64{1})
    }
    Int{low}
}

// The key of `id`; `locals` holds a local one.
symbol_key: fn(table: SymbolTable, locals: SymbolLocalKeys, id: SymbolID) -> String Never! {
    if symbol_is_local(id) -> return symbol_local_keys_text(locals, id)
    symbol_table_key(table, id)
}

// The key of a run-wide `id`.
symbol_table_key: fn(table: SymbolTable, id: SymbolID) -> String Never! {
    symbol_keys_text(table.ranges[symbol_table_range(table, id)], id)
}

// How many keys `table` holds (each range's empty row included). A run's
// table only grows, so two of its states with one count are the same.
symbol_table_count: fn(table: SymbolTable) -> Int Never! {
    count := 0
    loop range in table.ranges -> count += range.keys.texts.len()
    count
}

Symbol: struct {
    id: SymbolID,
    kind: SymbolKind,
    name: String,
    module_identity: ModuleID,
    owner: String?,
    span: Span,
    ty: Type?,
    visibility: Int,
}

// A registered declaration in the run-wide table the registration freeze
// fills (Cutover B L2b, s3 §1 SymbolId; spelled DeclID beside SymbolID):
// its row of `DeclTable.rows`. Facts name a registered declaration by its
// DeclID; locals and parameters keep their body's SymbolIDs until L5 gives
// each one a FnFacts row.
DeclID: struct {
    row: Row<DeclRow>,
}

// One registered declaration: its run-wide symbol (its key text is the
// symbol table's, read with `decl_table_key`) and kind.
DeclRow: struct {
    symbol: SymbolID,
    kind: SymbolKind,
}

// Rows in registration order (module order, then each module's callables in
// row order). `by_symbol` maps each symbol to the position in `ids` of its
// first row once `decl_table_index` ran; a later row of a symbol (a
// redeclaration) is kept but never found.
DeclTable: struct {
    rows: Rows<DeclRow>{Rows<DeclRow>{}},
    by_symbol: [U32:Int]{[U32:Int]{}},
    ids: [DeclID]{[DeclID]{}},
    // Rows added since the last `decl_table_index`.
    pending: [DeclID]{[DeclID]{}},
}

// Appends `symbol`'s row, a run-wide one; `decl_table_index` keys it.
decl_table_add: fn(table: &DeclTable, symbol: Symbol) -> DeclID Never! {
    row: table.rows.add(DeclRow{symbol: symbol.id, kind: symbol.kind})
    table.pending.push(DeclID{row: row})
    DeclID{row: row}
}

// Keys the pending rows. They are in row order, so the first row of each
// symbol is the first one met, and a symbol an earlier index keyed keeps its
// row.
decl_table_index: fn(table: &DeclTable) Never! {
    loop id in compiler_take_rows<DeclID>(table.pending) {
        symbol: table.rows[id.row].symbol.id
        if table.by_symbol.get(symbol) != None -> next
        table.by_symbol[symbol] = table.ids.len()
        table.ids.push(id)
    }
}

// The declaration registered under key text `key` of `symbols`, the table
// the declarations' symbols are rows of.
decl_table_find: fn(table: DeclTable, symbols: SymbolTable, key: String) -> DeclID? Never! {
    decl_table_find_symbol(table, symbol_find(symbols, key) ?? return None)
}

// The declaration registered as `symbol`.
decl_table_find_symbol: fn(table: DeclTable, symbol: SymbolID) -> DeclID? Never! {
    position: table.by_symbol.get(symbol.id) ?? return None
    Val(table.ids[position])
}

// The key text of declaration `id` in `symbols`, the table its symbol is a
// row of.
decl_table_key: fn(table: DeclTable, symbols: SymbolTable, id: DeclID) -> String Never! {
    symbol_table_key(symbols, table.rows[id.row].symbol)
}

decl_id_index: fn(id: DeclID) -> Int Never! { id.row.index() }

symbol_kind_name: fn(kind: SymbolKind) -> String Never! {
    if kind == {
        .Module -> "module"
        .Function -> "function"
        .Type -> "type"
        .Trait -> "trait"
        .Impl -> "impl"
        .Constant -> "constant"
        .Field -> "field"
        .Variant -> "variant"
        .Parameter -> "parameter"
        .Local -> "local"
        .Import -> "import"
        .Foreign -> "foreign"
        .Label -> "label"
    }
}

// The spelling of a shared cell of a type spelled `inner`.
type_shared_text: fn(inner: String) -> String Never! { "Shared<{inner}>" }

type_carrier_identity: fn(ty: Type) -> String Never! {
    if ty == {
        .Int -> "Int"
        .Float -> "Float"
        .Bool -> "Bool"
        .String -> "String"
        .Char -> "Char"
        .List(inner) -> "[{type_carrier_identity(inner)}]"
        .Map(key, _, value) -> "[{type_carrier_identity(key)}:{type_carrier_identity(value)}]"
        .Shared(inner) -> type_shared_text(type_carrier_identity(inner))
        .Option(inner) -> "?{type_carrier_identity_grouped(inner)}"
        .Result(ok, err) -> "{type_carrier_identity_grouped(ok)} ! {type_carrier_identity_grouped(err)}"
        .Fn(params, ret, _, _, _, _) -> {
            names := [String]{}
            loop param in params -> names.push(type_carrier_identity(param))
            signature := "fn({names.join(", ")})"
            if ret == .Val(value) -> signature = "{signature} => {type_carrier_identity(value)}"
            signature
        }
        .Named(name) -> name
        .Apply(name, args) -> {
            names := [String]{}
            loop arg in args -> names.push(type_carrier_identity(arg))
            "{name}<{names.join(", ")}>"
        }
        .TraitObject(bounds) -> bounds.join(" + ")
        .Tuple(fields) -> {
            names := [String]{}
            loop field in fields -> names.push("{field.name}: {type_carrier_identity(field.ty)}")
            "({names.join(", ")})"
        }
        // A fixed list's length is part of its identity: `[U8]` and
        // `[U8#2]` lay out apart, so a generic used at both has two
        // instances.
        .FixedList(elem, len) -> "[{type_carrier_identity(elem)}#{type_fixed_length_identity(len)}]"
        .IntN(signed, bits) -> {
            prefix: if signed -> "I" else -> "U"
            "{prefix}{bits}"
        }
        .InlineRange(base, _, _) -> type_carrier_identity(base)
        .Float32 -> "F32"
        .Tagged(_, inner) -> type_carrier_identity(inner)
        .Union(members) -> {
            names := [String]{}
            loop member in members -> names.push(type_carrier_identity_grouped(member))
            names.join(" | ")
        }
        .Case(name, payload) -> "{name}({type_carrier_identity(payload)})"
        .Quantity(base, _) -> type_carrier_identity(base)
        // A `<N: Int>` argument names its instance by its number
        // (`Packet<4>` and `Packet<2>` are two instances).
        .Measure(measure) -> {
            if measure == .Literal(kind, value) && kind == "length" -> return "{value}"
            "Int"
        }
    }
}

// The length a fixed list's identity spells: its number when the measure
// folds to one, so one length has one spelling, and its written form
// otherwise.
type_fixed_length_identity: fn(len: Measure) -> String Never! {
    if measure_literal_value(len) == .Val(count) -> return "{count}"
    measure_expression(len)
}

// A member's identity inside an Option, Result or union: a function, Result
// or union is grouped, since its identity has no end of its own
// (a Result whose success is an optional function keeps an identity apart
// from an optional fallible function's).
type_carrier_identity_grouped: fn(ty: Type) -> String Never! {
    if ty == {
        .Fn(_, _, _, _, _, _) | .Result(_, _) | .Union(_) -> "({type_carrier_identity(ty)})"
        .Tagged(_, inner) -> type_carrier_identity_grouped(inner)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Quantity(_, _) | .Measure(_) | .Case(_, _) -> type_carrier_identity(ty)
    }
}

type_name: fn(ty: Type) -> String Never! {
    if ty == {
        .FixedList(elem, len) -> "[{type_name(elem)}#{measure_expression(len)}]"
        .IntN(signed, bits) -> {
            prefix: if signed -> "I" else -> "U"
            "{prefix}{bits}"
        }
        .InlineRange(base, lo, hi) -> "{type_name(base)}({lo}..{hi})"
        .Tagged(marker, inner) -> if marker == {
            .User(name) -> "#{name} {type_name(inner)}"
            .Internal(_) -> type_name(inner)
        }
        .Quantity(base, dimension) -> "Quantity<{dimension_display_name(dimension)}, {type_name(base)}; {dimension_identity(dimension)}>"
        .Measure(value) -> measure_expression(value)
        .TraitObject(bounds) -> bounds.join(" + ")
        .Union(members) -> {
            names := [String]{}
            loop member in members -> names.push(type_name(member))
            names.join(" | ")
        }
        .Case(name, payload) -> "{name}({type_name(payload)})"
        .Named(name) -> name
        .Apply(name, args) -> if {
            name == "Ptr" && args.len() == 1 -> "*{type_name(args[0])}"
            name == "@" && args.len() == 1 -> "@{type_name(args[0])}"
            else -> {
                dimensions_opt: compute_shape_dimensions(ty)
                if dimensions_opt == {
                    .Val(values) -> {
                        dimensions := [String]{}
                        loop dimension in values -> dimensions.push("{dimension}")
                        "{name}<{dimensions.join(", ")}>"
                    }
                    .None -> type_application_name(name, args)
                }
            }
        }
        // A record is written in braces, `{min: Int, max: Int}`; a
        // positional tuple keeps its parens, `(Int, String)`.
        .Tuple(fields) -> {
            if fields.len() > 0 && fields[0].name == "" {
                types: loop field in fields -> type_name(field.ty)
                return "({types.join(", ")})"
            }
            names: loop field in fields -> "{field.name}: {type_name(field.ty)}"
            "{{{names.join(", ")}}}"
        }
        .List(inner) -> "[{type_name(inner)}]"
        .Map(key, _, value) -> "[{type_name(key)}:{type_name(value)}]"
        .Shared(inner) -> type_shared_text(type_name(inner))
        .Option(inner) -> "{type_marked_name(inner)}?"
        .Result(ok, err) -> result_surface_name(ok, err)
        // A callable type's surface spelling: `fn(T) -> U`, `fn(T) -[E]> U`,
        // and the unit-fallible `fn(T) IOError!` with no arrow before its contract.
        .Fn(params, ret, effect_bound, param_contract, _, _) -> {
            out := "fn({function_parameter_names(params, param_contract)})"
            shown_ret := ret
            if ret == .Val(value) && type_is_unit_callable_return(value) -> shown_ret = None
            unit_fallible := false
            if shown_ret == .Val(value) {
                if value == .Result(ok, _) -> unit_fallible = ok == Type.Named{name: "Unit"}
            }
            if effect_bound == .Val(rows) {
                effect_names: loop row in rows -> row.name
                out = "{out} -[{effect_names.join(", ")}]>"
            } else if shown_ret != None && !unit_fallible { out = "{out} ->" }
            if shown_ret == .Val(value) -> out = "{out} {type_name(value)}"
            out
        }
        .Int | .Float | .Bool | .String | .Char | .Float32 -> type_carrier_identity(ty)
    }
}

// The shape family of a list, fixed array, optional or map, which every
// instance of that shape shares with the structural impl head written for it
// (`impl [T].Trait`, `impl [T#N].Trait`, `impl T?.Trait`, `impl [K: V].Trait`):
// the key such an impl is filed under and a receiver of the shape finds it by.
// None for any other type.
type_structural_family: fn(ty: Type) -> String? Never! {
    if ty == .List(_) -> return Val("[]")
    if ty == .FixedList(_, _) -> return Val("[#]")
    if ty == .Option(_) -> return Val("?")
    if ty == .Map(_, _, _) -> return Val("[:]")
    None
}

// The parameter names of structural impl head `head`, in its family's order:
// `T` of `[T]` and `T?`, `T` then `N` of `[T#N]`, `K` then `V` of `[K: V]`.
// None when `head` is not one of those shapes over plain names.
type_structural_head_names: fn(head: Type) -> [String]? Never! {
    if head == .List(element) {
        if element == .Named(name) -> return Val([String]{name})
    }
    if head == .FixedList(element, length) {
        if element == .Named(name) {
            if length == .Symbol(_, extent) -> return Val([String]{name, extent})
        }
    }
    if head == .Option(inner) {
        if inner == .Named(name) -> return Val([String]{name})
    }
    if head == .Map(key, _, value) {
        if key == .Named(key_name) {
            if value == .Named(value_name) -> return Val([String]{key_name, value_name})
        }
    }
    None
}

// The arguments list, fixed array, optional or map `ty` binds to the
// parameters of its structural impl head (type_structural_head_names), in the
// same order; a fixed array's length is a number argument. None for any other
// type.
type_structural_args: fn(ty: Type) -> [Type]? Never! {
    if ty == .List(element) -> return Val([Type]{element})
    if ty == .FixedList(element, length) {
        return Val([Type]{element, Type.Measure{measure: length}})
    }
    if ty == .Option(inner) -> return Val([Type]{inner})
    if ty == .Map(key, _, value) -> return Val([Type]{key, value})
    None
}

// (Rust `AST.union_member_tag`): a union member's own tag. Rust spells a
// declared member by its own name, so every nominal reads without its
// module qualifier (`module.LocalDate` is `LocalDate`); a compound spelling
// is sanitized into an identifier (`[String]` is `M__String_`). A named case
// is tagged by its name. Two members may share it; the tag an arm names is
// type_union_member_tag_in.
type_union_member_tag: fn(ty: Type) -> String Never! {
    if ty == .Case(name, _) -> return name.copy()
    type_union_member_tag_name(type_name(type_unqualified_nominals(ty)))
}

// The tag a union pattern arm names for member `ty` of the union `members`:
// its own tag (type_union_member_tag), unless two different members share
// that tag, as two types of one name from different modules do
// (`geo.Point | map.Point`). Each such member is then tagged by its full
// identity (type_union_member_identity_tag), so no two members of one union
// share a tag. Every site that names a union member's variant (layout,
// boxing, arms, coverage) reads its tag here.
type_union_member_tag_in: fn(members: [Type], ty: Type) -> String Never! {
    own: type_union_member_tag(ty)
    first := -1
    loop (index, member) in members {
        if type_union_member_tag(member) != own -> next
        if first < 0 -> first = index
        if !type_identity_equal(members[first], member) -> return type_union_member_identity_tag(ty)
    }
    own
}

// `ty`'s full spelling, module identities included, as an identifier after
// `I_`: letters and digits stay, and every other byte is `_` and its two hex
// digits, so two spellings never give one tag.
type_union_member_identity_tag: fn(ty: Type) -> String Never! {
    hex: "0123456789abcdef".bytes()
    bytes := [U8]{73, 95}
    loop byte in type_name(ty).bytes() {
        value := Int{byte}
        if (value >= 48 && value <= 57) || (value >= 65 && value <= 90) || (value >= 97 && value <= 122) {
            bytes.push(byte)
        } else {
            bytes.push(U8{95})
            bytes.push(hex[value /% 16])
            bytes.push(hex[value % 16])
        }
    }
    String.from_bytes(bytes) ?? "I_"
}

// The value a union member's variant carries: a named case carries its
// payload, and a type member carries the member itself.
type_union_member_payload: fn(ty: Type) -> Type Never! {
    if ty == .Case(_, payload) -> return payload.copy()
    ty.copy()
}

// Puts a union's members in the canonical order every union carries (Rust
// `canonicalize_union`): the parser writes each union so, and a union a
// binding rebuilds is put back in it (jet_sema sema_failure_union_canonical),
// so two spellings of one union are one Type. Members sort by their spelling
// read without module qualifiers, the full spelling breaking ties: resolving
// a member to its declaration key (`net.NetError` to
// `<corelib>/core.net.NetError`) never reorders the union. Each member's key
// is built once per sort, not once per comparison.
type_union_sort: fn(members: &[Type]) -[]> {
    if members.len() < 2 {
        return
    }
    keys := [String]{}
    loop member in members -> keys.push(type_union_order_key(member))
    index := 1
    loop index < members.len() {
        current := members[index]
        current_key := keys[index]
        insertion := index - 1
        loop insertion >= 0 && type_union_member_after(keys[insertion], members[insertion], current_key, current) {
            members[insertion + 1] = members[insertion]
            keys[insertion + 1] = keys[insertion]
            insertion -= 1
        }
        members[insertion + 1] = current
        keys[insertion + 1] = current_key
        index += 1
    }
}

type_union_member_after: fn(left_key: String, left: Type, right_key: String, right: Type) -[]> Bool {
    if left_key != right_key -> return left_key > right_key
    type_name(left) > type_name(right)
}

type_union_order_key: fn(ty: Type) -[]> String {
    if ty == {
        .Named(name) -> return type_union_unqualified(name)
        .Apply(name, _) -> {
            full: type_name(ty)
            if full.starts_with(name) {
                return "{type_union_unqualified(name)}{full.slice(name.len(), full.len())}"
            }
            return full
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    type_name(ty)
}

// A nominal name's leaf: what follows its last `.` (a declaration key's
// module) and then its last `.` (a written module alias, `net.NetError`).
type_union_unqualified: fn(name: String) -[]> String {
    leaf := name
    loop part in name.split(".") -> leaf = part
    unaliased := leaf
    loop part in leaf.split(".") -> unaliased = part
    unaliased
}

// Rust `union_member_tag`'s sanitizer over one written spelling.
type_union_member_tag_name: fn(raw: String) -> String Never! {
    safe := true
    loop byte in raw.bytes() {
        value := Int{byte}
        if !((value >= 48 && value <= 57) || (value >= 65 && value <= 90) || (value >= 97 && value <= 122) || value == 95) {
            safe = false
            break
        }
    }
    if safe && raw.len() > 0 -> return raw.copy()
    bytes := [U8]{77, 95}
    loop byte in raw.bytes() {
        value := Int{byte}
        if {
            (value >= 48 && value <= 57) || (value >= 65 && value <= 90) || (value >= 97 && value <= 122) -> {
                bytes.push(byte)
            }
            value < 128 -> bytes.push(U8{95})
            value >= 192 -> bytes.push(U8{95})
            else -> {}
        }
    }
    String.from_bytes(bytes) ?? "M_"
}

// `ty` with each nominal head read without its `module.` qualifier.
type_unqualified_nominals: fn(ty: Type) -> Type Never! { type_nominals_unqualified(ty, false) }

// `ty` as a module writes it: each nominal head read without the module
// identity a checker key qualifies it by (`<corelib>/core.prelude.Span` is
// `Span`), and a module path the source writes kept (`geo.Point` stays).
type_identity_unqualified_nominals: fn(ty: Type) -> Type Never! {
    type_nominals_unqualified(ty, true)
}

// `ty` with each nominal head unqualified: by any `module.` qualifier, or
// with `identities_only` by a module identity alone (type_unqualified_text).
type_nominals_unqualified: fn(ty: Type, identities_only: Bool) -> Type Never! {
    if ty == {
        .Named(name) -> Type.Named{name: type_unqualified_text(name, identities_only)}
        .Apply(name, args) -> Type.Apply{name: type_unqualified_text(name, identities_only), args: loop arg in args -> type_nominals_unqualified(arg, identities_only)}
        .List(inner) -> Type.List{element: type_nominals_unqualified(inner, identities_only)}
        .Shared(inner) -> Type.Shared{inner: type_nominals_unqualified(inner, identities_only)}
        .Option(inner) -> Type.Option{inner: type_nominals_unqualified(inner, identities_only)}
        // copy: `key_span` is a payload of read parameter `ty`, which keeps the original; field `key_span` of the new Type.Map owns this one
        .Map(key, key_span, value) -> Type.Map{key: type_nominals_unqualified(key, identities_only), key_span: key_span.copy(), value: type_nominals_unqualified(value, identities_only)}
        .Result(ok, err) -> Type.Result{ok: type_nominals_unqualified(ok, identities_only), err: type_nominals_unqualified(err, identities_only)}
        // copy: `len` is a payload of read parameter `ty`, which keeps the original; field `len` of the new Type.FixedList owns this one
        .FixedList(elem, len) -> Type.FixedList{elem: type_nominals_unqualified(elem, identities_only), len: len.copy()}
        // copy: `marker` is a payload of read parameter `ty`, which keeps the original; field `marker` of the new Type.Tagged owns this one
        .Tagged(marker, inner) -> Type.Tagged{marker: marker.copy(), inner: type_nominals_unqualified(inner, identities_only)}
        .Union(members) -> Type.Union{members: loop member in members -> type_nominals_unqualified(member, identities_only)}
        .Case(name, payload) -> Type.Case{name: name, payload: type_nominals_unqualified(payload, identities_only)}
        .Tuple(fields) -> Type.Tuple{fields: loop field in fields -> TypeTupleField{name: field.name, ty: type_nominals_unqualified(field.ty, identities_only)}}
        // copy: a read-parameter rewriter returns a type with no nominal to unqualify unchanged as
        // a new tree (owner: the result) while the caller keeps the input (owner: the read
        // parameter, a payload view of the caller's tree); taking the input would need a consuming
        // match of every rebuilt variant (children arrive as payload views).
        .Int | .Float | .Bool | .String | .Char | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Quantity(_, _) | .Measure(_) -> ty.copy()
    }
}

type_unqualified_name: fn(name: String) -> String Never! { type_unqualified_text(name, false) }

// `name` without its `module.` qualifier; with `identities_only`, only a
// module identity (`module:…`, `<corelib>/…`, which hold `:` or start with
// `<`) is a qualifier, and a written module path stays.
type_unqualified_text: fn(name: String, identities_only: Bool) -> String Never! {
    leaf := name
    if !identities_only || name.contains(":") || name.starts_with("<") {
        loop part in name.split(".") -> leaf = part
    }
    leaf
}

#Test("a type as a module writes it keeps a written module path and drops a module identity") {
    written: Type.List{element: Type.Named{name: "geo.Point"}}
    assert_eq(type_name(type_identity_unqualified_nominals(written)), "[geo.Point]")
    assert_eq(type_name(type_unqualified_nominals(written)), "[Point]")
    assert_eq(type_name(type_identity_unqualified_nominals(Type.Named{name: "<corelib>/core.prelude.SourceLocation"})), "SourceLocation")
    assert_eq(type_name(type_identity_unqualified_nominals(Type.Named{name: "module:3:app:src/geo.jet.Point"})), "Point")
}

function_parameter_names: fn(params: [Type], param_contract: [CallContractRow]?) -> String Never! {
    names := [String]{}
    contracts: param_contract ?? [CallContractRow]{}
    star_done := false
    loop (i, param) in params {
        zone: if i < contracts.len() -> contracts[i].zone else -> ParamZone.Either
        if zone == ParamZone.LabelOnly && !star_done {
            names.push("*")
            star_done = true
        }
        label: if i < contracts.len() -> contracts[i].label else -> ""
        if label == "" -> names.push(type_name(param)) else {
            names.push("{label}: {type_name(param)}")
        }
        next_zone: if i + 1 < contracts.len() -> contracts[i + 1].zone else -> ParamZone.Either
        if zone == ParamZone.PositionalOnly && next_zone != ParamZone.PositionalOnly {
            names.push("/")
        }
    }
    names.join(", ")
}

type_application_name: fn(name: String, args: [Type]) -> String Never! {
    names := [String]{}
    loop arg in args -> names.push(type_name(arg))
    "{name}<{names.join(", ")}>"
}

// Both type marks follow the type they mark: `T?`,
// `Int ParseError!`, `(A | B)!`, and unit-fallible `SaveError!`.
result_surface_name: fn(ok: Type, err: Type) -> String Never! {
    default_error: err == Type.Named{name: "Err"}
    unit_success: ok == Type.Named{name: "Unit"}
    if unit_success -> return "{type_marked_name(err)}!"
    if !default_error -> return "{type_marked_name(ok)} {type_marked_name(err)}!"
    type_name(ok)
}

// `ty` as type_name spells it, but with the error always spelled: a
// Result of the implicit default `Err` is `Int Err!`, which type_name
// leaves as `Int`, as a signature's `-> Int` does.
type_failure_name: fn(ty: Type) -> String Never! {
    if ty == .Result(ok, err) && err == (Type.Named{name: "Err"}) && ok != (Type.Named{name: "Unit"}) {
        return "{type_marked_name(ok)} Err!"
    }
    type_name(ty)
}

// A type written before a suffix mark is grouped when the mark would
// otherwise bind to its last member.
type_marked_name: fn(ty: Type) -> String Never! {
    if ty == {
        .Union(members) -> {
            names := [String]{}
            loop member in members -> names.push(type_name(member))
            "({names.join(" | ")})"
        }
        .Fn(_, _, _, _, _, _) | .Result(_, _) | .Tagged(_, _) -> "({type_name(ty)})"
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Quantity(_, _) | .Measure(_) | .Case(_, _) -> type_name(ty)
    }
}

type_is_unit_callable_return: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Named(name) -> name == "Unit"
        .Result(ok, err) -> ok == Type.Named{name: "Unit"} && err == Type.Named{name: "Err"}
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

type_identity: fn(ty: Type) -> TypeIdentity Never! {
    TypeIdentity{carrier: type_carrier_identity(ty), knowledge: type_identity_knowledge(ty)}
}

type_identity_key: fn(ty: Type) -> String Never! { identity_key(type_identity(ty)) }

type_internal_tag_name: fn(internal_tag: InternalTag) -> String Never! {
    if internal_tag == {
        .CoreCryptoNominal -> "core.crypto"
        .DeterministicClock -> "clock.deterministic"
        .SystemClock -> "clock.system"
        .ExpiringSecretLoan -> "expiring_secret.loan"
        .SharedGuardRead -> "shared_guard.read"
        .SharedGuardEdit -> "shared_guard.edit"
        .TerminalFactSet -> "terminal.fact_set"
        .CppCallbackABI -> "cpp.callback_abi"
        .AllocatorView -> "allocator.view"
    }
}

// Compare declaration identity without allocating a serialized key. Compile-
// time facts and directional callable obligations remain separate judgments.
type_identity_equal: fn(left: Type, right: Type) -> Bool Never! {
    if left == {
        .Tagged(marker, inner) -> {
            if tag_is_identity_bearing(marker) {
                if right == {
                    .Tagged(other_marker, other_inner) -> {
                        if !tag_is_identity_bearing(other_marker) || marker != other_marker {
                            return false
                        }
                        return type_identity_equal(inner, other_inner)
                    }
                    .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return false
                }
            }
            return type_identity_equal(inner, right)
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    if right == {
        .Tagged(marker, inner) -> {
            if tag_is_identity_bearing(marker) -> return false
            return type_identity_equal(left, inner)
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    same := if left == {
        .Int -> right == Type.Int
        .Float -> right == Type.Float
        .Bool -> right == Type.Bool
        .String -> right == Type.String
        .Char -> right == Type.Char
        .Float32 -> right == Type.Float32
        .List(element) -> if right == {
            .List(other) -> type_identity_equal(element, other)
            .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Map(key, _, value) -> if right == {
            .Map(other_key, _, other_value) -> type_identity_equal(key, other_key) && type_identity_equal(value, other_value)
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Shared(inner) -> if right == {
            .Shared(other) -> type_identity_equal(inner, other)
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Option(inner) -> if right == {
            .Option(other) -> type_identity_equal(inner, other)
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Result(ok, err) -> if right == {
            .Result(other_ok, other_err) -> type_identity_equal(ok, other_ok) && type_identity_equal(err, other_err)
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Fn(params, ret, _, contract, metadata, _) -> if right == {
            .Fn(other_params, other_ret, _, other_contract, other_metadata, _) -> type_array_identity_equal(params, other_params) && type_optional_identity_equal(ret, other_ret) && call_contract_identity_equal(contract, other_contract) && call_variadic_identity_equal(metadata, other_metadata)
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Named(name) -> if right == {
            .Named(other) -> name == other
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Apply(name, args) -> if right == {
            .Apply(other_name, other_args) -> name == other_name && type_array_identity_equal(args, other_args)
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        .TraitObject(bounds) -> if right == {
            .TraitObject(other) -> string_array_identity_equal(bounds, other)
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Tuple(fields) -> if right == {
            .Tuple(other) -> tuple_fields_identity_equal(fields, other)
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        .FixedList(element, length) -> if right == {
            .FixedList(other_element, other_length) -> type_identity_equal(element, other_element) && length == other_length
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        .IntN(signed, bits) -> if right == {
            .IntN(other_signed, other_bits) -> signed == other_signed && bits == other_bits
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        .InlineRange(base, lo, hi) -> if right == {
            .InlineRange(other_base, other_lo, other_hi) -> lo == other_lo && hi == other_hi && type_identity_equal(base, other_base)
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Union(members) -> if right == {
            .Union(other) -> type_array_identity_equal(members, other)
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Case(name, payload) -> if right == {
            .Case(other_name, other) -> name == other_name && type_identity_equal(payload, other)
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Quantity(base, dimension) -> if right == {
            .Quantity(other_base, other_dimension) -> type_identity_equal(base, other_base) && dimension_identity_equal(dimension, other_dimension)
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Measure(_) -> false
        }
        .Measure(measure) -> if right == {
            .Measure(other) -> measure == other
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) -> false
        }
        .Tagged(_, _) -> false
    }
    same
}

tag_is_identity_bearing: fn(marker: TagMarker) -> Bool Never! {
    marker == TagMarker.Internal{internal_tag: InternalTag.CoreCryptoNominal}
}

type_array_identity_equal: fn(left: [Type], right: [Type]) -> Bool Never! {
    if left.len() != right.len() -> return false
    loop (i, value) in left {
        if !type_identity_equal(value, right[i]) -> return false
    }
    true
}

type_optional_identity_equal: fn(left: Type?, right: Type?) -> Bool Never! {
    if left == .Val(left_type) {
        if right == .Val(right_type) -> return type_identity_equal(left_type, right_type)
        return false
    }
    right == None
}

call_contract_identity_equal: fn(left: [CallContractRow]?, right: [CallContractRow]?) -> Bool Never! {
    left == right
}

call_variadic_identity_equal: fn(left: FunctionCallMetadata?, right: FunctionCallMetadata?) -> Bool Never! {
    function_variadic_obligation(left) == function_variadic_obligation(right)
}

// Whether a function type's call metadata marks parameter `index` written
// (`fn(&[Int])`); a type with no metadata reads every parameter.
function_param_writes: fn(metadata: FunctionCallMetadata?, index: Int) -> Bool Never! {
    row: metadata ?? return false
    index >= 0 && index < row.conventions.len() && row.conventions[index] == AccessConvention.Write
}

string_array_identity_equal: fn(left: [String], right: [String]) -> Bool Never! {
    if left.len() != right.len() -> return false
    loop (i, value) in left {
        if value != right[i] -> return false
    }
    true
}

tuple_fields_identity_equal: fn(left: [TypeTupleField], right: [TypeTupleField]) -> Bool Never! {
    if left.len() != right.len() -> return false
    loop (i, field) in left {
        if field.name != right[i].name || !type_identity_equal(field.ty, right[i].ty) {
            return false
        }
    }
    true
}

dimension_identity_equal: fn(left: Dimension, right: Dimension) -> Bool Never! {
    if left.axes.len() != right.axes.len() -> return false
    loop (i, axis) in left.axes {
        if axis.name != right.axes[i].name || axis.exponent != right.axes[i].exponent {
            return false
        }
    }
    true
}

type_with_effective_fn_returns: fn(ty: Type) -> Type Never! {
    if ty == {
        .List(inner) -> Type.List{element: type_with_effective_fn_returns(inner)}
        // copy: `key_span` is a payload of read parameter `ty`, which keeps the original; field `key_span` of the new Type.Map owns this one
        .Map(key, key_span, value) -> Type.Map{key: type_with_effective_fn_returns(key), key_span: key_span.copy(), value: type_with_effective_fn_returns(value)}
        .Shared(inner) -> Type.Shared{inner: type_with_effective_fn_returns(inner)}
        .Option(inner) -> Type.Option{inner: type_with_effective_fn_returns(inner)}
        .Result(ok, err) -> Type.Result{ok: type_with_effective_fn_returns(ok), err: type_with_effective_fn_returns(err)}
        .Fn(params, ret, effect_bound, param_contract, call_metadata, return_view_provenance) -> {
            normalized_params := [Type]{}
            loop param in params -> normalized_params.push(type_with_effective_fn_returns(param))
            normalized_ret := ret.map(fn(value) { effective_callable_return(type_with_effective_fn_returns(value)) })
            Type.Fn{params: normalized_params, ret: normalized_ret, effect_bound: effect_bound, param_contract: param_contract, call_metadata: call_metadata, return_view_provenance: return_view_provenance}
        }
        .Apply(name, args) -> {
            normalized_args := [Type]{}
            loop arg in args -> normalized_args.push(type_with_effective_fn_returns(arg))
            Type.Apply{name: name, args: normalized_args}
        }
        .Tuple(fields) -> {
            normalized_fields := [TypeTupleField]{}
            loop field in fields {
                normalized_fields.push(TypeTupleField{name: field.name, ty: type_with_effective_fn_returns(field.ty)})
            }
            Type.Tuple{fields: normalized_fields}
        }
        // copy: `length` is a payload of read parameter `ty`, which keeps the original; field `len` of the new Type.FixedList owns this one
        .FixedList(element, length) -> Type.FixedList{elem: type_with_effective_fn_returns(element), len: length.copy()}
        .InlineRange(base, lo, hi) -> Type.InlineRange{base: type_with_effective_fn_returns(base), lo: lo, hi: hi}
        // copy: `marker`, `inner` and `marker` are payloads of read parameter `ty`, which keeps the originals; the new Type.Tagged's fields own `marker`, `inner` and `marker`
        .Tagged(marker, inner) -> if marker == (TagMarker.Internal{internal_tag: InternalTag.CppCallbackABI}) -> Type.Tagged{marker: marker.copy(), inner: inner.copy()} else -> Type.Tagged{marker: marker.copy(), inner: type_with_effective_fn_returns(inner)}
        .Union(members) -> {
            normalized_members := [Type]{}
            loop member in members {
                normalized_members.push(type_with_effective_fn_returns(member))
            }
            Type.Union{members: normalized_members}
        }
        .Case(name, payload) -> Type.Case{name: name, payload: type_with_effective_fn_returns(payload)}
        // copy: `dimension` is a payload of read parameter `ty`, which keeps the original; field `dimension` of the new Type.Quantity owns this one
        .Quantity(base, dimension) -> Type.Quantity{base: type_with_effective_fn_returns(base), dimension: dimension.copy()}
        .Int | .Float | .Bool | .String | .Char | .Named(_) | .TraitObject(_) | .IntN(_, _) | .Float32 | .Measure(_) -> ty
    }
}

// A parameter's written type as its callee holds it. A function-typed
// parameter (`f: fn(Int) -> Int`), and each function-typed parameter of that
// type, carries the inferred failure contract, so a declared function and a
// written function type agree on how they fail. A function type inside a
// container (`[fn(Int) -> Int]`, `(fn(Int) -> Int)?`) or returned by one
// keeps its written return, as the same type does on a binding or a typed
// literal. The fn-value adapter converts one function value between its
// failing and non-failing forms; it never converts the functions a
// collection already holds (#6281 c123).
type_with_effective_parameter_fn_return: fn(ty: Type) -> Type Never! {
    if ty == {
        .Fn(params, ret, effect_bound, param_contract, call_metadata, return_view_provenance) -> {
            normalized_params := [Type]{}
            loop param in params {
                normalized_params.push(type_with_effective_parameter_fn_return(param))
            }
            normalized_ret := ret.map(fn(value) { effective_callable_return(value) })
            Type.Fn{params: normalized_params, ret: normalized_ret, effect_bound: effect_bound, param_contract: param_contract, call_metadata: call_metadata, return_view_provenance: return_view_provenance}
        }
        // copy: `marker` and `inner` are payloads of read parameter `ty`, which keeps the originals; the new Type.Tagged's fields own `marker` and `inner`
        .Tagged(marker, inner) -> if marker == (TagMarker.Internal{internal_tag: InternalTag.CppCallbackABI}) -> Type.Tagged{marker: marker.copy(), inner: inner.copy()} else -> Type.Tagged{marker: marker.copy(), inner: type_with_effective_parameter_fn_return(inner)}
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> ty
    }
}

effective_callable_return: fn(ty: Type) -> Type Never! {
    if ty == {
        .Named(name) -> if name == "Never" -> ty else -> Type.Result{ok: ty, err: Type.Named{name: "Err"}}
        .Option(_) -> ty
        .Result(_, _) -> ty
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> Type.Result{ok: ty, err: Type.Named{name: "Err"}}
    }
}

compute_dimension_type: fn(value: Int) -> Type Never! {
    Type.Measure{measure: Measure.Literal{kind: "shape", value: value}}
}

// The number a `<N: Int>` argument holds: a literal length
// measure (`Packet<4>`, or a constant sema folded to one).
number_argument_value: fn(ty: Type) -> Int? Never! {
    if ty == .Measure(value) -> return measure_literal_value(value)
    None
}

compute_shape_type: fn(name: String, dimensions: [Int]) -> Type Never! {
    args: loop dimension in dimensions -> compute_dimension_type(dimension)
    Type.Apply{name: name, args: args}
}

compute_shape_measures: fn(ty: Type) -> [Measure]? {
    if ty == {
        .Apply(name, args) -> compute_shape_measures_apply(name, args)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
}

compute_shape_measures_apply: fn(name: String, args: [Type]) -> [Measure]? {
    expected: if name == {
        "Vec" -> 1
        "Matrix" -> 2
        else -> 0
    }
    if expected == 0 || args.len() != expected -> return None
    measures := [Measure]{}
    loop arg in args {
        if arg == {
            .Measure(measure) -> {
                if measure_kind(measure) != "shape" -> return None
                measures.push(measure.copy())
            }
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) -> return None
        }
    }
    Val(measures)
}

compute_shape_dimensions: fn(ty: Type) -> [Int]? {
    measures: compute_shape_measures(ty) ?? return None
    dimensions := [Int]{}
    loop measure in measures {
        value: measure_literal_value(measure) ?? return None
        dimensions.push(value)
    }
    Val(dimensions)
}

// The source-owned `core.compute` declaration is the one
// Tensor owner, so its canonical nominal is the same family as `Tensor`.
is_compute_tensor_family: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Tagged(_, inner) -> is_compute_tensor_family(inner)
        .Named(name) -> name == "Tensor" || name == "<corelib>/core.compute.Tensor"
        .Apply(name, args) -> is_compute_tensor_application(name, args)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

is_compute_tensor_application: fn(name: String, args: [Type]) -> Bool Never! {
    if name == "Tensor" -> return args.len() <= 1
    expected: if name == {
        "Vec" -> 1
        "Matrix" -> 2
        else -> 0
    }
    if expected == 0 || args.len() != expected -> return false
    if compute_shape_dimensions(Type.Apply{name: name, args: args}) != None -> return true
    loop arg in args {
        if arg != Type.Int -> return false
    }
    true
}

is_measure_type: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Measure(_) -> true
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) -> false
    }
}

is_compute_shape_type: fn(name: String, args: [Type]) -> Bool Never! {
    expected: if name == {
        "Vec" -> 1
        "Matrix" -> 2
        else -> 0
    }
    if expected == 0 || args.len() != expected -> return false
    loop arg in args {
        if arg == {
            .Measure(value) -> {
                if measure_kind(value) != "shape" -> return false
            }
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) -> return false
        }
    }
    true
}

type_simd_lane_arity: fn(name: String) -> Int? {
    if name == {
        "F32x4" | "F64x4" | "I32x4" | "U32x4" | "I64x4" | "U64x4" -> Val(4)
        "F64x2" | "I64x2" | "U64x2" -> Val(2)
        "F32x8" | "I16x8" | "U16x8" | "I32x8" | "U32x8" -> Val(8)
        "I8x16" | "U8x16" | "I16x16" | "U16x16" -> Val(16)
        "I8x32" | "U8x32" -> Val(32)
        else -> None
    }
}

identity_key: fn(identity: TypeIdentity) -> String Never! {
    facts := [String]{}
    loop entry in identity.knowledge.entries {
        path: if entry.path.len() == 0 -> "self" else -> entry.path.join(".")
        facts.push("{path}:{entry.plane}={knowledge_fact_key(entry.fact)}")
    }
    if facts.len() == 0 -> return identity.carrier
    "{identity.carrier}|{facts.join("|")}"
}

knowledge_fact_key: fn(fact: KnowledgeFact) -> String Never! {
    if fact == {
        .Interval(lo, hi) -> "interval:{lo}..{hi}"
        .Layout(bytes) -> "layout:{bytes}"
        .Measure(value) -> "measure:{measure_key(value)}"
        .Exactness(value) -> if value == {
            .Exact -> "exactness:exact"
            .Approximate(precision) -> "exactness:approximate:{precision}"
            .Measured -> "exactness:measured"
        }
        .Dimension(value) -> "dimension:{dimension_identity(value)}"
        .Classification(name) -> "classification:{name}"
        .Nominal(name) -> "nominal:{name}"
        .Obligation(value) -> "obligation:{function_obligations_key(value)}"
    }
}

function_obligations_key: fn(value: FunctionObligations) -> String Never! {
    contract := [String]{}
    contract_rows: value.param_contract ?? [CallContractRow]{}
    loop row in contract_rows -> contract.push("{row.label}:{param_zone_name(row.zone)}")
    variadic := [String]{}
    variadic_values: value.variadic ?? [Bool]{}
    loop is_variadic in variadic_values -> variadic.push("{is_variadic}")
    "contract=[{contract.join(",")}];variadic=[{variadic.join(",")}]"
}

param_zone_name: fn(zone: ParamZone) -> String Never! {
    if zone == {
        .PositionalOnly -> "positional-only"
        .Either -> "either"
        .LabelOnly -> "label-only"
    }
}

type_identity_knowledge: fn(ty: Type) -> KnowledgeVector Never! {
    entries := [KnowledgeEntry]{}
    if ty == {
        .Int -> {
            entries.push(KnowledgeEntry{path: [String]{}, plane: "Exactness", fact: KnowledgeFact.Exactness{value: Exactness.Exact}})
        }
        .Float -> {
            entries.push(KnowledgeEntry{path: [String]{}, plane: "Exactness", fact: KnowledgeFact.Exactness{value: Exactness.Approximate{precision: 53}}})
        }
        .Float32 -> {
            entries.push(KnowledgeEntry{path: [String]{}, plane: "Exactness", fact: KnowledgeFact.Exactness{value: Exactness.Approximate{precision: 24}}})
        }
        .IntN(signed, bits) -> {
            lower := 0
            upper := ((2).pow(bits)) - 1
            if signed {
                lower = -((2).pow((bits - 1)))
                upper = ((2).pow((bits - 1))) - 1
            }
            entries.push(KnowledgeEntry{path: [String]{}, plane: "Interval", fact: KnowledgeFact.Interval{lo: lower, hi: upper}})
            entries.push(KnowledgeEntry{path: [String]{}, plane: "Layout", fact: KnowledgeFact.Layout{bytes: (bits + 7) /% 8}})
            entries.push(KnowledgeEntry{path: [String]{}, plane: "Exactness", fact: KnowledgeFact.Exactness{value: Exactness.Exact}})
        }
        .InlineRange(base, lo, hi) -> {
            entries = merge_type_knowledge(entries, type_identity_knowledge(base), [String]{})
            entries.push(KnowledgeEntry{path: [String]{}, plane: "Interval", fact: KnowledgeFact.Interval{lo: lo, hi: hi}})
        }
        .FixedList(elem, len) -> {
            entries = merge_type_knowledge(entries, type_identity_knowledge(elem), [String]{"element"})
            entries.push(KnowledgeEntry{path: [String]{}, plane: "Measure", fact: KnowledgeFact.Measure{value: len}})
        }
        // copy: `value` is a payload of read parameter `ty`, which keeps the original; field `value` of the new KnowledgeFact.Measure owns this one
        .Measure(value) -> {
            entries.push(KnowledgeEntry{path: [String]{}, plane: "Measure", fact: KnowledgeFact.Measure{value: value.copy()}})
        }
        .Quantity(base, dimension) -> {
            entries = merge_type_knowledge(entries, type_identity_knowledge(base), [String]{"base"})
            entries.push(KnowledgeEntry{path: [String]{}, plane: "Dimension", fact: KnowledgeFact.Dimension{value: dimension}})
        }
        .Fn(params, ret, _, param_contract, call_metadata, _) -> {
            loop (i, param) in params {
                entries = merge_type_knowledge(entries, type_identity_knowledge(param), [String]{"param", "{i}"})
            }
            if ret == .Val(ret_type) {
                entries = merge_type_knowledge(entries, type_identity_knowledge(ret_type), [String]{"return"})
            }
            variadic: function_variadic_obligation(call_metadata)
            if param_contract != None || variadic != None {
                obligations: FunctionObligations{effect_bound: None, param_contract: param_contract, variadic: variadic, return_view_provenance: None}
                entries.push(KnowledgeEntry{path: [String]{}, plane: "Obligation", fact: KnowledgeFact.Obligation{value: obligations}})
            }
        }
        .List(inner) -> {
            entries = merge_type_knowledge(entries, type_identity_knowledge(inner), [String]{"element"})
        }
        .Shared(inner) -> {
            entries = merge_type_knowledge(entries, type_identity_knowledge(inner), [String]{"inner"})
        }
        .Option(inner) -> {
            entries = merge_type_knowledge(entries, type_identity_knowledge(inner), [String]{"some"})
        }
        .Map(key, _, value) -> {
            entries = merge_type_knowledge(entries, type_identity_knowledge(key), [String]{"key"})
            entries = merge_type_knowledge(entries, type_identity_knowledge(value), [String]{"value"})
        }
        .Result(ok, err) -> {
            entries = merge_type_knowledge(entries, type_identity_knowledge(ok), [String]{"ok"})
            entries = merge_type_knowledge(entries, type_identity_knowledge(err), [String]{"err"})
        }
        .Tuple(fields) -> {
            loop field in fields {
                entries = merge_type_knowledge(entries, type_identity_knowledge(field.ty), [String]{"field", field.name})
            }
        }
        .Union(members) -> {
            loop (i, member) in members {
                entries = merge_type_knowledge(entries, type_identity_knowledge(member), [String]{"member", "{i}"})
            }
        }
        .Case(name, payload) -> {
            entries = merge_type_knowledge(entries, type_identity_knowledge(payload), [String]{"case", name})
        }
        .Tagged(marker, inner) -> {
            if {
                tag_is_identity_bearing(marker) -> {
                    entries = merge_type_knowledge(entries, type_identity_knowledge(inner), [String]{"inner"})
                    entries.push(KnowledgeEntry{path: [String]{}, plane: "Nominal", fact: KnowledgeFact.Nominal{name: "core.crypto"}})
                }
                // A user tag is a transparent flow classification: the inner
                // facts stay at the tagged path, and the tag is its own fact.
                else -> {
                    entries = merge_type_knowledge(entries, type_identity_knowledge(inner), [String]{})
                    classification: if marker == {
                        .User(name) -> name
                        .Internal(internal_tag) -> type_internal_tag_name(internal_tag)
                    }
                    entries.push(KnowledgeEntry{path: [String]{}, plane: "Classification", fact: KnowledgeFact.Classification{name: classification}})
                }
            }
        }
        .Apply(name, args) -> {
            if {
                name == "Measurement" && args.len() == 1 -> {
                    entries = merge_type_knowledge(entries, type_identity_knowledge(args[0]), [String]{"value"})
                    entries.push(KnowledgeEntry{path: [String]{}, plane: "Exactness", fact: KnowledgeFact.Exactness{value: Exactness.Measured}})
                }
                else -> {
                    loop (i, arg) in args {
                        if !(name == "Vec" || name == "Matrix") || !is_measure_type(arg) {
                            entries = merge_type_knowledge(entries, type_identity_knowledge(arg), [String]{"argument", "{i}"})
                        }
                    }
                    if is_compute_shape_type(name, args) {
                        loop (i, arg) in args {
                            if arg == {
                                .Measure(value) -> {
                                    entries.push(KnowledgeEntry{path: [String]{"shape", "{i}"}, plane: "Measure", fact: KnowledgeFact.Measure{value: value}})
                                }
                                .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) -> {}
                            }
                        }
                    }
                }
            }
        }
        .Named(name) -> {
            if name == "Decimal" || name == "Fraction" {
                entries.push(KnowledgeEntry{path: [String]{}, plane: "Exactness", fact: KnowledgeFact.Exactness{value: Exactness.Exact}})
            }
            lanes := type_simd_lane_arity(name)
            if lanes != None {
                entries.push(KnowledgeEntry{path: [String]{}, plane: "Measure", fact: KnowledgeFact.Measure{value: Measure.Literal{kind: "lane", value: lanes ?? 0}}})
            }
        }
        .Bool | .String | .Char | .TraitObject(_) -> {}
    }
    KnowledgeVector{entries: entries}
}

function_variadic_obligation: fn(metadata: FunctionCallMetadata?) -> [Bool]? {
    value: metadata ?? return None
    has_variadic := false
    loop is_variadic in value.variadic {
        if is_variadic {
            has_variadic = true
            break
        }
    }
    if has_variadic -> return Val(value.variadic)
    None
}

merge_type_knowledge: fn(target: [KnowledgeEntry], nested: KnowledgeVector, prefix: [String]) -> [KnowledgeEntry] Never! {
    out := target
    loop entry in nested.entries {
        path := [String]{}
        loop part in prefix -> path.push(part.copy())
        loop part in entry.path -> path.push(part.copy())
        out.push(KnowledgeEntry{path: path, plane: entry.plane, fact: entry.fact})
    }
    out
}
