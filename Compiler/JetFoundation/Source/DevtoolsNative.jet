fn jet_devtools_command_relay_path() -> OSPath Err! {
    value :: env.var(JET_DEVTOOLS_COMMAND_RELAY_PATH_ENV).map_err(fn(_) { "game control command relay is unavailable" })?
    if value.is_empty() || value.bytes().len() > JET_DEVTOOLS_MAX_TEXT_BYTES || value.chars().any(fn(character) { character.is_control() }) {
