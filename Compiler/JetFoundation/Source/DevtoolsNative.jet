// Rust: crates/jet-foundation/src/DevtoolsNative.rs:684
pub fn jet_devtools_native_frame_begin_unchecked(frame_index: U64, width: U32, height: U32) -> [JetDevtoolsNativeDrawCommand] {
    session_id :: jet_devtools_native_active_session() ?? { return [] }
