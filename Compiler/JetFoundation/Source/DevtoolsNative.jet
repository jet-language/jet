// Rust: crates/jet-foundation/src/DevtoolsNative.rs:252
pub fn jet_devtools_dispatch_database_explain(session_id: String, request_id: String, statement_identity: String, timeout_ms: U64, max_rows: U64) -> Unit Err! {
    validate_command_text(session_id, "session_id")?
    validate_command_text(request_id, "request_id")?
    validate_command_text(statement_identity, "statement_identity")?
    if timeout_ms == U64{0} || timeout_ms > JET_DEVTOOLS_MAX_DATABASE_EXPLAIN_TIMEOUT_MS { return Err("database EXPLAIN timeout is outside its limit") }
    if max_rows == U64{0} || max_rows > JET_DEVTOOLS_MAX_DATABASE_EXPLAIN_ROWS { return Err("database EXPLAIN row limit is outside its limit") }
    callback :: {
        installed := JET_DEVTOOLS_DATABASE_EXPLAIN_CALLBACK.lock().map_err(fn(_) { "database EXPLAIN callback registry poisoned" })?
        *installed ?? { return Err("database EXPLAIN runtime callback is unavailable") }
    }
    callback(session_id, request_id, statement_identity, timeout_ms, max_rows)
}
