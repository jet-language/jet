// Rust: crates/jet-foundation/src/DevtoolsNative.rs:406
pub fn jet_devtools_write_game_control_relay(session_id: String, payload_json: String) -> Unit Err! {
    write_guard := JET_DEVTOOLS_COMMAND_RELAY_WRITE_LOCK.lock().map_err(fn(_) { "game control command relay lock is poisoned" })?
    validate_command_text(session_id, "session_id")?
    validate_command_text(payload_json, "game control payload")?
    directory :: jet_devtools_command_relay_path()?
    fs.create_dir_all(directory).map_err(fn(error) { "cannot create game control command relay: {error}" })?
    if selected_family() == "unix" {
        // GATE #4494: Unix ownership and permissions metadata.
        metadata :: fs.symlink_metadata(directory).map_err(fn(error) { "cannot inspect game control command relay: {error}" })?
        owner :: fs.metadata(OSPath.from("/proc/self")).map(fn(process) { process.uid() }).unwrap_or(metadata.uid())
        if !metadata.file_type().is_dir() || metadata.uid() != owner { return Err("game control command relay directory is not owned by this user") }
        permissions := metadata.permissions()
        &permissions.set_mode(0o700)
        _ :: fs.set_permissions(directory, permissions)
    }
    retained :: fs.read_dir(directory).map_err(fn(error) { "cannot inspect game control command relay: {error}" })?
        .filter_map(fn(entry) { entry.ok() })
        .filter(fn(entry) { entry.path().extension().is_some_and(fn(extension) { extension == "cmd" }) }).count()
    if retained >= JET_DEVTOOLS_COMMAND_RELAY_MAX_FILES { return Err("game control command relay is full") }
    sequence :: JET_DEVTOOLS_COMMAND_RELAY_SEQUENCE.fetch_add(U64{1}, Ordering.Relaxed)
    started_at_ms :: time.SystemTime.now().duration_since(time.UNIX_EPOCH).map(fn(duration) { duration.as_millis() as U64 }).unwrap_or(U64{0})
    protocol :: jet_devtools_relay_json_string(JET_DEVTOOLS_PROTOCOL)
    session :: jet_devtools_relay_json_string(session_id)
    envelope :: "{{\"protocol\":{protocol},\"session_id\":{session},\"started_at_ms\":{started_at_ms},\"direction\":\"host_to_runtime\",\"commands\":[{{\"kind\":\"GameControl\",\"payload\":{payload_json}}}]}}"
    if envelope.bytes().len() > JET_DEVTOOLS_MAX_ENVELOPE_BYTES { return Err("game control command relay payload exceeds the envelope limit") }
    process_id :: process.id()
    temporary :: directory.join(".{process_id:020}-{sequence:020}.tmp")
    final_path :: directory.join("{sequence:020}-{process_id:020}.cmd")
    options := fs.OpenOptions.new()
    &options.write(true).create_new(true)
    if selected_family() == "unix" { &options.mode(0o600) }
    file := options.open(temporary).map_err(fn(error) { "cannot open game control command relay: {error}" })?
    if file.write_all(envelope.bytes()).and_then(fn(_) { file.sync_all() }) == .Err(error) {
        _ :: fs.remove_file(temporary)
        return Err("cannot write game control command relay: {error}")
    }
    fs.rename(temporary, final_path).map_err(fn(error) { "cannot publish game control command relay: {error}" })?
}
// Rust: crates/jet-foundation/src/DevtoolsNative.rs:486
pub fn jet_devtools_take_game_control_relays(session_id: String) -> [String] Err! {
    validate_command_text(session_id, "session_id")?
    directory :: env.var(JET_DEVTOOLS_COMMAND_RELAY_PATH_ENV) == {
        .Ok(value) -> {
            if value.is_empty() || value.bytes().len() > JET_DEVTOOLS_MAX_TEXT_BYTES || value.chars().any(fn(character) { character.is_control() }) {
                return Err("game control command relay path is invalid")
            }
            OSPath.from(value)
        }
        .Err(env.VarError.NotPresent) -> { return [] }
        .Err(error) -> { return Err("cannot read game control command relay path: {error}") }
    }
    entries :: fs.read_dir(directory) == { .Ok(entries) -> entries, .Err(_) -> { return [] } }
    paths := entries.filter_map(fn(entry) { entry.ok() }).map(fn(entry) { entry.path() })
        .filter(fn(path) { path.extension().is_some_and(fn(extension) { extension == "cmd" }) }).collect()
    &paths.sort()
    &paths.truncate(JET_DEVTOOLS_COMMAND_RELAY_MAX_FILES)
    frames := [String].with_capacity(paths.len())
    for path in paths {
        metadata :: fs.symlink_metadata(path).map_err(fn(error) { "cannot inspect game control command relay entry: {error}" })?
        if selected_family() == "unix" {
            owner :: fs.metadata(OSPath.from("/proc/self")).map(fn(process) { process.uid() }).unwrap_or(metadata.uid())
            if metadata.uid() != owner || metadata.mode() & 0o077 != 0 {
                _ :: fs.remove_file(path)
                return Err("game control command relay entry has unsafe ownership")
            }
        }
        if !metadata.file_type().is_file() || metadata.len() > JET_DEVTOOLS_MAX_ENVELOPE_BYTES as U64 {
            _ :: fs.remove_file(path)
            return Err("game control command relay entry is invalid")
        }
        frame :: fs.read_to_string(path).map_err(fn(error) { "cannot read game control command relay: {error}" })?
        fs.remove_file(path).map_err(fn(error) { "cannot consume game control command relay: {error}" })?
        jet_devtools_validate_relay_frame(frame, session_id)?
        &frames.push(^frame)
    }
    ^frames
}
// Rust: crates/jet-foundation/src/DevtoolsNative.rs:544
pub fn jet_devtools_clear_game_control_relays() -> Unit Err! {
    directory :: jet_devtools_command_relay_path()?
    entries :: fs.read_dir(directory) == {
        .Ok(entries) -> entries
        .Err(error) -> {
            if error.kind() == std.io.ErrorKind.NotFound { return }
            return Err("cannot inspect game control command relay for teardown: {error}")
        }
    }
    for entry in entries {
        path :: entry.map_err(fn(error) { "cannot inspect game control command relay: {error}" })?.path()
        if path.extension().is_some_and(fn(extension) { extension == "cmd" }) {
            fs.remove_file(path).map_err(fn(error) { "cannot clear game control command relay: {error}" })?
        }
    }
}
// Rust: crates/jet-foundation/src/DevtoolsNative.rs:568
pub fn jet_devtools_install_native_host_unchecked(session_id: String, host: JetDevtoolsNativeHostHandle) -> JetDevtoolsNativeHostGuard Err! {
    if session_id.is_empty() || session_id.bytes().len() > JET_DEVTOOLS_MAX_TEXT_BYTES { return Err("native devtools host session identity is invalid") }
    if session_id.chars().any(fn(character) { character.is_control() }) { return Err("native devtools host session identity contains control text") }
    id :: {
        registry := JET_DEVTOOLS_NATIVE_HOSTS.lock().map_err(fn(_) { "native devtools host registry poisoned" })?
        id :: registry.next_id
        registry.next_id = registry.next_id.saturating_add(U64{1}).max(U64{1})
        &registry.hosts.push(JetDevtoolsNativeHostRegistration(id: id, session_id: ~session_id, host: ^host))
        id
    }
    jet_devtools_native_bind_session_unchecked(session_id)?
    JetDevtoolsNativeHostGuard(id: id, session_id: ^session_id)
}
// Rust: crates/jet-foundation/src/DevtoolsNative.rs:594
pub fn jet_devtools_native_bind_session_unchecked(session_id: String) -> Unit Err! {
    if session_id.is_empty() || session_id.bytes().len() > JET_DEVTOOLS_MAX_TEXT_BYTES || session_id.chars().any(fn(character) { character.is_control() }) {
        return Err("native devtools session identity is invalid")
    }
    active := JET_DEVTOOLS_NATIVE_SESSION.lock().map_err(fn(_) { "native devtools session poisoned" })?
    *active = some(~session_id)
}
// Rust: crates/jet-foundation/src/DevtoolsNative.rs:608
pub fn jet_devtools_native_clear_session_unchecked(session_id: String) -> Unit {
    if JET_DEVTOOLS_NATIVE_SESSION.lock() == .Ok(active) {
        if active.as_deref() == some(session_id) { *active = none }
    }
}
// Rust: crates/jet-foundation/src/DevtoolsNative.rs:616
fn jet_devtools_native_active_session() -> String? {
    active := JET_DEVTOOLS_NATIVE_SESSION.lock().ok() ?? { return none }
    ~*active
}
// Rust: crates/jet-foundation/src/DevtoolsNative.rs:620
pub fn jet_devtools_native_session_id() -> String? { jet_devtools_native_active_session() }
// Rust: crates/jet-foundation/src/DevtoolsNative.rs:628
pub fn jet_devtools_try_with_native_host<R>(session_id: String, callback: fn(JetDevtoolsNativeHost) -> R) -> R? {
    host :: {
        registry := JET_DEVTOOLS_NATIVE_HOSTS.lock().ok() ?? { return none }
        registration :: registry.hosts.iter().find(fn(registration) { registration.session_id == session_id }) ?? { return none }
        ~registration.host
    }
    some(callback(host.as_ref()))
}
// Rust: crates/jet-foundation/src/DevtoolsNative.rs:645
pub fn jet_devtools_publish_event_for_session_unchecked(session_id: String, event: JetDevtoolsEvent) -> Unit {
