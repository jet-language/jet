pub fn jet_devtools_install_database_explain_callback(callback: JetDevtoolsDatabaseExplainCallback) -> JetDevtoolsDatabaseExplainCallbackGuard Err! {
    installed := JET_DEVTOOLS_DATABASE_EXPLAIN_CALLBACK.lock().map_err(fn(_) { "database EXPLAIN callback registry poisoned" })?
