// Rust: crates/jet-foundation/src/CLISchema.rs:448
fn completion_words(jobs: [JobFact]) -> [String] Never! {
    words := [String]{}
    seen := [String:Bool]{}
    loop job in jobs {
        if job.scope == JobScope.Internal || seen.get(job.name) != None -> next
        seen[job.name] = true
        &words.push(job.name)
    }
    words
}
