    }
    // Rust: crates/jet-foundation/src/CLISchema.rs:1606
    fn u32(&self) -> Int MetadataError! {
        end :: cli_schema_size_add(self.at, 4) ?? return Err(MetadataError.Malformed{why: "length overflow"})
        if end > self.bytes.len() -> return Err(MetadataError.Malformed{why: "truncated payload"})
        value := 0
        loop index in 0..<4 -> value = value | (Int.from_u8(self.bytes[self.at + index]) << (8 * index))
        self.at = end
        Ok(value)
    }
