    fn string(&self) -> String MetadataError! {
        length :: &self.u32()
        if length > MAX_STRING_BYTES -> return Err(MetadataError.Malformed{why: "string too long"})
        end :: cli_schema_size_add(self.at, length) ?? return Err(MetadataError.Malformed{why: "length overflow"})
        if end > self.bytes.len() -> return Err(MetadataError.Malformed{why: "truncated string"})
        bytes :: self.bytes[self.at..<end]
        self.at = end
        Ok(String.from_bytes(bytes) ?? return Err(MetadataError.Malformed{why: "string is not UTF-8"}))
    }
    // Rust: crates/jet-foundation/src/CLISchema.rs:1635
    fn optional_string(&self) -> String? MetadataError! {
        if &self.byte() == {
            U8{0} -> Ok(None)
            U8{1} -> Ok(Val(&self.string()))
            else -> Err(MetadataError.Malformed{why: "invalid optional string bit"})
        }
    }
    // Rust: crates/jet-foundation/src/CLISchema.rs:1642
    fn done(self) -> Bool Never! { self.at == self.bytes.len() }
}
// Selected execution-target usize arithmetic, not the inspected file's width.
// GATE #4483: core.sys.usize_max.
fn cli_schema_size_add(left: Int, right: Int) -> Int? Never! {
    maximum :: Int.from_u64(cli_metadata_target.usize_max())
    if left < 0 || right < 0 || right > maximum || left > maximum - right -> None else -> Val(left + right)
}
fn cli_schema_size_mul(left: Int, right: Int) -> Int? Never! {
    maximum :: Int.from_u64(cli_metadata_target.usize_max())
    if left < 0 || right < 0 || left > maximum || right > maximum -> return None
    if right != 0 && left > maximum /% right -> None else -> Val(left * right)
}
fn cli_schema_bytes_start(bytes: View<U8>, prefix: [U8]) -> Bool Never! {
    if bytes.len() < prefix.len() -> return false
    loop index in 0..<prefix.len() { if bytes[index] != prefix[index] -> return false }
    true
}
// Rust: crates/jet-foundation/src/CLISchema.rs:1647
fn bounds(bytes: View<U8>, at: Int, length: Int) -> View<U8> MetadataError! from bytes {
    end :: cli_schema_size_add(at, length) ?? return Err(MetadataError.Malformed{why: "section range overflow"})
    if end > bytes.len() -> return Err(MetadataError.Malformed{why: "section outside file"})
    Ok(bytes[at..<end])
}
// Rust: crates/jet-foundation/src/CLISchema.rs:1656
fn read_num(bytes: View<U8>, at: Int, width: Int, little: Bool) -> U64 MetadataError! {
    value :: bounds(bytes, at, width)
    if width != 2 && width != 4 && width != 8 -> return Err(MetadataError.Malformed{why: "invalid integer width"})
    number := U64{0}
    loop index in 0..<width {
        shift :: if little -> index * 8 else -> (width - index - 1) * 8
        number = number | (U64.from_u8(value[index]) << shift)
    }
    Ok(number)
}
// Rust: crates/jet-foundation/src/CLISchema.rs:1669
fn usize_num(value: U64) -> Int MetadataError! {
    if value > cli_metadata_target.usize_max() -> return Err(MetadataError.Malformed{why: "file offset overflow"})
    Ok(Int.from_u64(value))
}
// Rust: crates/jet-foundation/src/CLISchema.rs:1673
fn c_name(bytes: View<U8>) -> String MetadataError! {
    end := bytes.len()
    loop index in 0..<bytes.len() { if bytes[index] == U8{0} { end = index; break } }
    // GATE #4494: validated borrowed UTF-8, no section-name allocation/copy.
    Ok(std.str.from_utf8(bytes[0..<end]) ?? return Err(MetadataError.Malformed{why: "section name is not UTF-8"}))
}
// Rust: crates/jet-foundation/src/CLISchema.rs:1682
fn elf_sections(bytes: View<U8>) -> [View<U8>] MetadataError! from bytes {
    if bytes.len() <= 4 -> return Err(MetadataError.Malformed{why: "truncated ELF header"})
    class :: bytes[4]
    if bytes.len() <= 5 -> return Err(MetadataError.Malformed{why: "invalid ELF byte order"})
    little :: if bytes[5] == { U8{1} -> true U8{2} -> false else -> return Err(MetadataError.Malformed{why: "invalid ELF byte order"}) }
    (header, shoff_at, shentsize_at, shnum_at, shstr_at, shoff_width, sh_offset_at, sh_size_at, value_width) :: if class == {
        U8{1} -> (52, 32, 46, 48, 50, 4, 16, 20, 4)
        U8{2} -> (64, 40, 58, 60, 62, 8, 24, 32, 8)
        else -> return Err(MetadataError.Malformed{why: "unsupported ELF class"})
    }
    _ :: bounds(bytes, 0, header)
    shoff :: usize_num(read_num(bytes, shoff_at, shoff_width, little))
    entsize :: usize_num(read_num(bytes, shentsize_at, 2, little))
    count :: usize_num(read_num(bytes, shnum_at, 2, little))
    names_index :: usize_num(read_num(bytes, shstr_at, 2, little))
    if count == 0 || entsize < sh_size_at + value_width || names_index >= count -> return Err(MetadataError.Malformed{why: "invalid ELF section table"})
    table_length :: cli_schema_size_mul(entsize, count) ?? return Err(MetadataError.Malformed{why: "ELF section count overflow"})
    _ :: bounds(bytes, shoff, table_length)
    (_, names_at, names_len) :: cli_schema_elf_section(bytes, names_index, shoff, entsize, sh_offset_at, sh_size_at, value_width, little)
    names :: bounds(bytes, names_at, names_len)
    found := [View<U8>]{}
    loop index in 0..<count {
        (name_at, offset, size) :: cli_schema_elf_section(bytes, index, shoff, entsize, sh_offset_at, sh_size_at, value_width, little)
        if name_at > names.len() -> return Err(MetadataError.Malformed{why: "ELF section name outside string table"})
        if c_name(names[name_at..<names.len()]) == ELF_SECTION -> &found.push(bounds(bytes, offset, size))
    }
    Ok(found)
}
// Rust: crates/jet-foundation/src/CLISchema.rs:1721
fn cli_schema_elf_section(bytes: View<U8>, index: Int, shoff: Int, entsize: Int, sh_offset_at: Int, sh_size_at: Int, value_width: Int, little: Bool) -> (Int, Int, Int) MetadataError! {
    relative :: cli_schema_size_mul(index, entsize) ?? return Err(MetadataError.Malformed{why: "ELF section offset overflow"})
    base :: cli_schema_size_add(shoff, relative) ?? return Err(MetadataError.Malformed{why: "ELF section offset overflow"})
    name :: usize_num(read_num(bytes, base, 4, little))
    offset :: usize_num(read_num(bytes, base + sh_offset_at, value_width, little))
    size :: usize_num(read_num(bytes, base + sh_size_at, value_width, little))
    Ok((name, offset, size))
}
// Rust: crates/jet-foundation/src/CLISchema.rs:1749
fn pe_sections(bytes: View<U8>) -> [View<U8>] MetadataError! from bytes {
    pe :: usize_num(read_num(bytes, 0x3c, 4, true))
    signature :: bounds(bytes, pe, 4)
    if !cli_schema_bytes_start(signature, [U8]{80, 69, 0, 0}) -> return Err(MetadataError.Malformed{why: "bad PE signature"})
    count :: usize_num(read_num(bytes, pe + 6, 2, true))
    optional :: usize_num(read_num(bytes, pe + 20, 2, true))
    base_table :: cli_schema_size_add(pe, 24) ?? return Err(MetadataError.Malformed{why: "PE section table overflow"})
    table :: cli_schema_size_add(base_table, optional) ?? return Err(MetadataError.Malformed{why: "PE section table overflow"})
    table_length :: cli_schema_size_mul(count, 40) ?? return Err(MetadataError.Malformed{why: "PE section count overflow"})
    _ :: bounds(bytes, table, table_length)
    found := [View<U8>]{}
    loop index in 0..<count {
        base :: table + index * 40
        if c_name(bounds(bytes, base, 8)) != PE_SECTION -> next
        size :: usize_num(read_num(bytes, base + 16, 4, true))
        offset :: usize_num(read_num(bytes, base + 20, 4, true))
        raw :: bounds(bytes, offset, size)
        if raw.len() < 14 -> return Err(MetadataError.Malformed{why: "truncated PE metadata section"})
        payload_len :: Int.from_u64(read_num(raw, 10, 4, true))
        record_len :: cli_schema_size_add(46, payload_len) ?? return Err(MetadataError.Malformed{why: "record length overflow"})
        record :: bounds(raw, 0, record_len)
        trailing :: raw[record_len..<raw.len()]
        if cli_schema_bytes_start(trailing, RECORD_MAGIC) -> return Err(MetadataError.Duplicate)
        loop byte in trailing { if byte != U8{0} -> return Err(MetadataError.Malformed{why: "nonzero bytes after PE metadata record"}) }
        &found.push(record)
    }
    Ok(found)
}
