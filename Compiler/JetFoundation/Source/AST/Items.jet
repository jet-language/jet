}

UnitFamilyDef: struct {
    is_pub: Bool
    is_package_pub: Bool
    family: String
    family_span: Span
    dimension: UnitDimensionDecl?
    resolved_dimension: Dimension?
    resolved_owner: String?
    base: NamedSpan?
    members: [UnitFamilyMember]
    span: Span
}

UnitDimensionDecl: enum {
    Base(span: Span)
    Derived(expr: Expr)
}

UnitFamilyMember: struct {
    name: String
    name_span: Span
    scale: UnitRatio
    scale_provenance: UnitScaleProvenance
    offset: UnitRatio
}

UnitRatio: struct {
    numerator: Int
    denominator: Int
}

UnitScaleProvenance: enum {
    Rational
    SymbolicPi(numerator: UnitRatio, denominator: UnitRatio)
    Conventional(value: String, source: String)
    Measured(central_value: String, standard_uncertainty: String, source: String)
}

// The type a unit member declares: each `_`-separated segment with its first
// character uppercased.
unit_family_type_name: fn(member: String) -> String Never! {
    out := ""
    loop segment in member.split("_") {
        if segment.len() > 0 -> out = "{out}{segment.slice(0, 1).to_upper()}{segment.slice(1, segment.len())}"
    }
    if out == "" -> return member.copy()
    out
}

// The distinct types a unit family declares, in member order: one linear type
// per member, or a Point and a Delta per member of an affine family. Points do
// not inherit point+point arithmetic; sema adds the closed Point/Delta algebra.
// Every generated name and derive keeps the member's span. The canonical
// core.units Time family declares none.
unit_family_distinct_defs: fn(family: UnitFamilyDef) -> [DistinctDef] Never! {
    definitions := [DistinctDef]{}
    if family.family == "Time" && family.resolved_owner == Val("core.units") -> return definitions
    affine := false
    if family.base != None {
        loop member in family.members {
            if member.offset.numerator != 0 -> affine = true
        }
    }
    loop member in family.members {
        base_name: unit_family_type_name(member.name)
        names: if affine -> [String]{"{base_name}Point", "{base_name}Delta"} else -> [String]{base_name}
        loop (index, name) in names {
            point: affine && index == 0
            derives := [NamedSpan]{NamedSpan{name: if point -> "Comparable" else -> "Numeric", span: member.name_span}}
            quantity := QuantityInfo?{None}
            if family.resolved_dimension == .Val(dimension) {
                loop codec in owned_trait_codec_names() -> derives.push(NamedSpan{name: codec.copy(), span: member.name_span})
                kind: if {
                    !affine -> QuantityKind.Linear
                    point -> QuantityKind.Point
                    else -> QuantityKind.Delta
                }
                quantity = Val(QuantityInfo{dimension: dimension, kind: kind})
            }
            definitions.push(DistinctDef{is_pub: family.is_pub, is_package_pub: family.is_package_pub, type_markers: [Marker]{}, derives: derives, quantity: quantity, name: name, name_span: member.name_span, base: Type.Float, base_span: member.name_span, range: None, span: member.name_span})
        }
    }
    definitions
}

