}

pub enum EveryScheduleError {
    UnknownDurationUnit
    NonPositiveDuration
    DurationOutOfRange
    BadWallClockFormat
    HourOutOfRange
    MinuteOutOfRange
    DynamicValue
}

pub struct Param {
