// Rust-shaped top-level AST, declaration payloads, and parser metadata.

pub enum Item {
    Func(value: Func)
    Struct(value: StructDef)
    Enum(value: EnumDef)
    Distinct(value: DistinctDef)
    TypeAlias(value: TypeAliasDef)
    UnitFamily(value: UnitFamilyDef)
    Trait(value: TraitDef)
    Tag(value: TagDef)
    EffectDecl(value: EffectDecl)
    Impl(value: ImplDef)
    Const(value: ConstDef)
    Test(value: TestDef)
    ExternRust(value: ExternRustBlock)
    Module(value: ModuleDecl)
    CModule(value: CModule)
    CodeModule(value: CodeModule)
    ErrorConv(value: ErrorConvDef)
    Migration(value: MigrationDecl)
    ProtocolDecl(value: ProtocolDecl)
    UserDerive(value: DeriveDef)
    TemplateLoop(value: ItemTemplateLoop)
    GenericModule(value: GenericModuleDef)
    ModuleAlias(value: ModuleAliasDef)
    MarkerDecl(value: MarkerDecl)
    FactDecl(value: FactDecl)
}

pub struct Program {
    pub imports: [ImportDecl]
    pub items: [Item]
    pub script_body: [Stmt]
    pub block_spans: [Span]
    pub fenced_statements: [FencedStatement]
    pub web_target_ceiling: WebBucket?
    pub pub_file: Bool
    pub no_prelude: Bool
    pub default_target: String?
    pub html_path: String?
    pub policy_declarations: [PolicyDeclaration]
    pub user_policy_declarations: [UserPolicyDecl]
    pub applied_rules: [AppliedRuleApplication]
    pub rule_facts: [AppliedRuleApplication]
    // L0303 (#3716): each dispatch table's authored `else` arm, so sema can
    // point at an arm that can never run and delete it.
    pub else_arms: [ElseArmSpan]{[ElseArmSpan]{}}
    // L0103 (D-LINT-UNUSED1): the local names of this file's imports that the
    // file spells outside its import declarations, so sema can report an
    // import that is never read.
    pub used_import_names: [String]{[String]{}}
    // D-DBG1=A: the authored text of every `debug(…)` call, so sema can
    // write the trace site and the E3405 unwrap edit without the source.
    pub debug_sites: [DebugTraceSite]{[DebugTraceSite]{}}
}

// D-DBG1=A: one `debug(…)` call as written. `name_start` keys it to the call's
// name span; `text` is the argument exactly as written; `close_end` is the
// byte after the closing `)`.
pub struct DebugTraceSite {
    pub name_start: Int
    pub text: String
    pub close_end: Int
}

pub struct ElseArmSpan {
    // The whole table, which is also the span every level of its chain carries.
    pub table: Span
    // From `else` through the end of its body.
    pub arm: Span
    // The arm plus the line break and indentation before it.
    pub delete: Span
}

pub struct FencedStatement {
    pub span: Span
    pub fences: [FencedNames]
    pub copies: Int
}

pub struct FencedNames {
    pub span: Span
    pub names: [NamedSpan]
    pub range: NameRange?
}

pub struct NameRange {
    pub start: String
    pub end: String
}

pub enum WebBucket {
    JS
    Wasm
}

pub enum WebPartitionMarker {
    JS
    Wasm
    WasmExport
}

pub struct AppliedRuleApplication {
    pub marker: Marker
    pub target: Span?
    pub site: RuleSite?
}

pub enum RuleSite {
    Package
    File
    Module
    Function
    Method
    Block
    Statement
    Expression
    Type
    Impl
    Declaration
    Constant
    Field
    Variant
    Parameter
    Test
    Operation
    Text
}

pub struct ImportDecl {
