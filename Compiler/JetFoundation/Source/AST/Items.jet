Param: struct {
    convention: AccessConvention
    root: Bool
    name: String
    name_span: Span
    public_label: CallLabel?
    zone: ParamZone
    ty: Type
    ty_span: Span
    default: Expr?
    variadic: Bool
    variadic_bound_list: [String]?
    declared_view_from_names: [String]?
    // The stated receiver footprint `&self.log` /
    // `&self.[log, hits]`; `None` on every other parameter.
    declared_footprint: [NamedSpan]?
}

Func: struct {
    span: Span
    is_pub: Bool
    is_package_pub: Bool
    is_comptime: Bool
    external_type: NamedSpan?
    name: String
    name_span: Span
    meta: MetaAttr?
    type_params: [TypeParam]
    head_pattern: Pattern?
    params: [Param]
    return_type: Type?
    return_type_span: Span?
    return_view_provenance: ViewProvenanceMap?
    declared_return_view_provenance: ViewProvenanceMap?
    gc_return: Bool
    diverges: Bool
    gc_scope: Bool
    is_unsafe: Bool
    unsafe_reason: String?
    unsafe_span: Span?
    is_pure: Bool
    scrub_tag: String?
    declared_effects: [EffectRowEntry]?
    effect_via: NamedSpan?
    state_requires: NamedSpan?
    state_transition: StateTransition?
    is_reactive: Bool
    reactive_upgrades: [String]
    is_replayable: Bool
    replayable_span: Span?
    is_job: Bool
    job_span: Span?
    job_metadata: JobMetadata?
    every: EveryMarker?
    is_must_use: Bool
    must_use_span: Span?
    maturity: MaturityTag?
    maturity_span: Span?
    kernel: KernelMarker?
    is_inline: Bool
    is_inline_always: Bool
    inline_span: Span?
    web_marker: WebPartitionMarker?
    pre: [ContractClause]
    post: [ContractClause]
    inline_foreign: InlineForeign?
    undo: NamedSpan?
    markers: [Marker]
    compiler_generated: Bool
    body: [Stmt]
    // The caps of every module enclosing this function, outermost first.
    module_caps: [ModuleCap]{[ModuleCap]{}}
}

// Only a concrete `App` or `App E!` return makes `run` an app entry.
type_is_app: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Named(name) -> name == "App"
        .Result(ok, _) -> ok == Type.Named{name: "App"}
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// The app entry `run`, searched through authored code-module bodies.
app_entry_run_fn: fn(items: [Item]) -> Func? Never! {
    loop item in items {
        if item == {
            .Func(function) -> {
                if function.name == "run" && function.return_type == .Val(ty) && type_is_app(ty) -> return Val(function)
            }
            .CodeModule(module_value) -> {
                if module_value.body == .Val(body) {
                    if app_entry_run_fn(body) == .Val(function) -> return Val(function)
                }
            }
            .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    None
}

StructDef: struct {
    span: Span
    is_pub: Bool
    is_package_pub: Bool
    // Minted only on the authenticated original Prelude Err declaration.
    compiler_builtin_error: Bool{false}
    name: String
    name_span: Span
    type_params: [TypeParam]
    fields: [Field]
    state: StateDecl?
    methods: [Func]
    cli_bindings: [CLICommandBinding]
    trait_impls: [TraitImplBlock]
    derives: [NamedSpan]
    auto_derive_default: Bool
    is_published_schema: Bool
    published_schema_span: Span?
    is_single_use: Bool
    single_use_span: Span?
    is_must_use: Bool
    must_use_span: Span?
    layout: StructLayout?
    layout_span: Span?
    layout_alignment_span: Span?
    serde_markers: [Marker]
    type_markers: [Marker]
    validate_block: [Stmt]
    validate_span: Span?
    // A marker type's `impl Marker { … }` block: the marker the struct declares
    // (its fields first, then the block's settings), where the block starts and
    // the span of its `expand: fn` template.
    marker: MarkerDecl?{None}
    marker_span: Span?{None}
    marker_expand_span: Span?{None}
    effect_impl: EffectImpl?{None}
    // The type's `#FX(…)` cap; the marker stays in `type_markers`.
    cap: ModuleCap?{None}
    // The span of the inline `name: module { … }` that declared the struct
    // (sema_inline_hoist_module sets it). Its `priv` fields belong to that
    // module and its children; None for a struct declared at file level.
    inline_module: Span?{None}
}

