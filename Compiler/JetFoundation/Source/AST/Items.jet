}

pub struct TypeParam {
    pub name: String
    pub name_span: Span
    pub bounds: [String]
    // D-CONSTGEN2=A: set when the declaration is a compile-time number
    // parameter, `<prep N: Int>`; `bounds` is then empty. `<prep>` and
    // `<prep: Trait>` stay ordinary type parameters named `prep`.
    pub prep: PrepParam?
}

// D-CONSTGEN2=A: the declaration head of a compile-time number parameter.
// Only the declaration carries `prep`; uses write the plain name. Sema rejects
// it with E0390 until card #3505 lands substitution, identity and layout.
pub struct PrepParam {
    pub prep_span: Span
    pub value_type: String
    pub value_type_span: Span
}

