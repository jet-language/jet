// Only a concrete `App` or `App E!` return makes `run` an app entry.
fn type_is_app(ty: Type) -> Bool Never! {
    if ty == {
        .Named(name) -> name == "App"
        .Result(ok, _) -> ok == Type.Named{name: "App"}
        else -> false
    }
}

// The app entry `run`, searched through authored code-module bodies.
fn app_entry_run_fn(items: [Item]) -> Func? Never! {
    loop item in items {
        if item == {
            .Func(function) -> {
                if function.name == "run" && function.return_type == .Val(ty) && type_is_app(ty) -> return Val(function)
            }
            .CodeModule(module_value) -> {
                if module_value.body == .Val(body) {
                    if app_entry_run_fn(body) == .Val(function) -> return Val(function)
                }
            }
            else -> {}
        }
    }
    None
}

