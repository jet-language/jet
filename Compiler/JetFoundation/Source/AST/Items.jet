/// The metadata a bare `#Job` carries: `.Dev` scope and every optional field
/// empty. `#Job(...)` starts from the same row before binding its arguments.
ast_job_metadata: fn() -> JobMetadata Never! {
    JobMetadata{scope: JobScope.Dev, after: [String]{}, packages: [String]{}, cwd: None, inputs: [String]{}, outputs: [String]{}, skip: None, cache: JobCachePolicy.Uncached, parallel: None, limits: [StringMapEntry]{}}
}

