    pub name: String
    pub span: Span
    pub ty: Type
}

pub struct ConstDef {
    pub span: Span
    pub name: String
    pub name_span: Span
    pub value: Expr
    // 3A / D-PUBPKG1=A: `pub NAME :: v` exports the binding like any other
    // top-level item; `pub(package)` keeps it inside the package.
    pub is_pub: Bool
    pub is_package_pub: Bool
    pub meta: MetaAttr?
    pub attrs: [ConstAttr]
    pub rust_kind: RustConstKind
    pub is_comptime: Bool
    pub ct: CtValue?
    pub ty: Type?
    pub is_persist: Bool
    pub persist_span: Span?
    pub mutable: Bool
    pub resolved_output: ResolvedOutput?
}

pub enum ConstAttr {
    ForceStatic
    ForceInline
}

pub enum RustConstKind {
    Const
    Static
}

pub enum OutputKind {
    Library
    Executable
    Service
    Check
    Environment
    Image
    Bundle
    System
    Fleet
}

pub enum OutputCallableAuthority {
    SafeJet
}

pub struct ResolvedOutput {
    pub address: String
    pub kind: OutputKind
    pub output_name: String
    pub module_id: Int
    pub source_path: String
    pub source_name: String
    pub semantic_name: String
    pub lowered_name: String
    pub params: [OutputParam]
    pub return_type: Type?
    pub failure_contract: FailureContract
    pub reference: Span
    pub definition: Span
    pub authority: OutputCallableAuthority
    pub effects: [String]
    pub selected: Bool
    pub selection_reason: String
}

pub struct OutputParam {
    pub access: AccessConvention
    pub ty: Type
}

pub struct ErrorConvDef {
    pub from_ty: String
    pub from_span: Span
    pub to_ty: String
    pub to_span: Span
    pub body: [Stmt]
    pub body_span: Span
}

pub struct MigrationDecl {
    pub type_name: String
    pub type_span: Span
    pub ops: [MigrationOp]
    pub span: Span
}

pub enum MigrationOp {
    Rename(from: String, from_span: Span, to: String, to_span: Span)
    Add(field: String, field_span: Span, ty: Type, ty_span: Span, default: Expr, default_span: Span, default_fn: String?)
    Remove(field: String, field_span: Span)
    Change(field: String, field_span: Span, from_ty: Type, from_span: Span, to_ty: Type, to_span: Span, converter: Expr?, converter_span: Span?, conv_fn: String?)
}

pub struct ParseResult {
    pub program: Program
    pub diagnostics: [Diagnostic]
}

pub fn ast_program() -> Program Never! {
    Program{
        imports: [ImportDecl]{},
        items: [Item]{},
        script_body: [Stmt]{},
        block_spans: [Span]{},
        fenced_statements: [FencedStatement]{},
        web_target_ceiling: None,
        pub_file: false,
        no_prelude: false,
        default_target: None,
        html_path: None,
        policy_declarations: [PolicyDeclaration]{},
        user_policy_declarations: [UserPolicyDecl]{},
        applied_rules: [AppliedRuleApplication]{},
        rule_facts: [AppliedRuleApplication]{},
    }
}

pub fn ast_func(name: String, name_span: Span, span: Span) -> Func Never! {
    Func{
        span: span,
        is_pub: false,
        is_package_pub: false,
        is_comptime: false,
        external_type: None,
        name: name,
        name_span: name_span,
        meta: None,
        type_params: [TypeParam]{},
        head_pattern: None,
        params: [Param]{},
        return_type: None,
        return_type_span: None,
        return_view_provenance: None,
        declared_return_view_provenance: None,
        gc_return: false,
        diverges: false,
        gc_scope: false,
        is_unsafe: false,
        unsafe_reason: None,
        unsafe_span: None,
        is_pure: false,
        is_sanitizer: false,
        scrub_tag: None,
        declared_effects: None,
        effect_via: None,
        state_requires: None,
        state_transition: None,
        is_reactive: false,
        reactive_upgrades: [String]{},
        is_replayable: false,
        replayable_span: None,
        is_job: false,
        job_span: None,
        job_metadata: None,
        every: None,
        is_must_use: false,
        must_use_span: None,
        maturity: None,
        maturity_span: None,
        kernel: None,
        is_inline: false,
        is_inline_always: false,
        inline_span: None,
        web_marker: None,
        pre: [ContractClause]{},
        post: [ContractClause]{},
        inline_foreign: None,
        undo: None,
        markers: [Marker]{},
        compiler_generated: false,
        body: [Stmt]{},
    }
}

/// The metadata a bare `#Job` carries: `.Dev` scope and every optional field
/// empty. `#Job(...)` starts from the same row before binding its arguments.
pub fn ast_job_metadata() -> JobMetadata Never! {
    JobMetadata{scope: JobScope.Dev, after: [String]{}, packages: [String]{}, cwd: None, inputs: [String]{}, outputs: [String]{}, skip: None, cache: JobCachePolicy.Uncached, parallel: None, limits: [StringMapEntry]{}}
}

pub fn ast_struct(name: String, name_span: Span, span: Span) -> StructDef Never! {
    StructDef{
        span: span,
        is_pub: false,
        is_package_pub: false,
        name: name,
        name_span: name_span,
        type_params: [TypeParam]{},
        fields: [Field]{},
        state: None,
        methods: [Func]{},
        cli_bindings: [CLICommandBinding]{},
        trait_impls: [TraitImplBlock]{},
        derives: [NamedSpan]{},
        auto_derive_default: false,
        is_published_schema: false,
        published_schema_span: None,
        is_single_use: false,
        single_use_span: None,
        is_must_use: false,
        must_use_span: None,
        layout: None,
        layout_span: None,
        serde_markers: [Marker]{},
        type_markers: [Marker]{},
        validate_block: [Stmt]{},
        validate_span: None,
    }
}

pub fn ast_enum(name: String, name_span: Span, span: Span) -> EnumDef Never! {
    EnumDef{
        span: span,
        is_pub: false,
        is_package_pub: false,
        name: name,
        name_span: name_span,
        type_params: [TypeParam]{},
        variants: [Variant]{},
        methods: [Func]{},
        trait_impls: [TraitImplBlock]{},
        derives: [NamedSpan]{},
        auto_derive_default: false,
        is_single_use: false,
        single_use_span: None,
        is_must_use: false,
        must_use_span: None,
        serde_markers: [Marker]{},
        type_markers: [Marker]{},
        groups: [EnumGroup]{},
    }
}

pub fn ast_const(name: String, name_span: Span, span: Span, value: Expr) -> ConstDef Never! {
    ConstDef{
        span: span,
        name: name,
        name_span: name_span,
        value: value,
        is_pub: false,
        is_package_pub: false,
        meta: None,
        attrs: [ConstAttr]{},
        rust_kind: RustConstKind.Const,
        is_comptime: false,
        ct: None,
        ty: None,
        is_persist: false,
        persist_span: None,
        mutable: false,
        resolved_output: None,
    }
}
