// The type a unit member declares: each `_`-separated segment with its first
// character uppercased.
fn unit_family_type_name(member: String) -> String Never! {
    out := ""
    loop segment in member.split("_") {
        if segment.len() > 0 -> out = "{out}{segment.slice(0, 1).to_upper()}{segment.slice(1, segment.len())}"
    }
    if out == "" -> return member.copy()
    out
}

// The distinct types a unit family declares, in member order: one linear type
// per member, or a Point and a Delta per member of an affine family. Points do
// not inherit point+point arithmetic; sema adds the closed Point/Delta algebra.
// Every generated name and derive keeps the member's span. The canonical
// core.units Time family declares none.
fn unit_family_distinct_defs(family: UnitFamilyDef) -> [DistinctDef] Never! {
    definitions := [DistinctDef]{}
    if family.family == "Time" && family.resolved_owner == Val("core.units") -> return definitions
    affine := false
    if family.base != None {
        loop member in family.members {
            if member.offset.numerator != 0 -> affine = true
        }
    }
    loop member in family.members {
        base_name :: unit_family_type_name(member.name)
        names :: if affine -> [String]{"{base_name}Point", "{base_name}Delta"} else -> [String]{base_name}
        loop (index, name) in names {
            point :: affine && index == 0
            derives := [NamedSpan]{NamedSpan{name: if point -> "Comparable" else -> "Numeric", span: member.name_span}}
            quantity := QuantityInfo?{None}
            if family.resolved_dimension == .Val(dimension) {
                &derives.push(NamedSpan{name: "Encode", span: member.name_span})
                &derives.push(NamedSpan{name: "Decode", span: member.name_span})
                kind :: if {
                    !affine -> QuantityKind.Linear
                    point -> QuantityKind.Point
                    else -> QuantityKind.Delta
                }
                quantity = Val(QuantityInfo{dimension: dimension, kind: kind})
            }
            &definitions.push(DistinctDef{is_pub: family.is_pub, is_package_pub: family.is_package_pub, type_markers: [Marker]{}, derives: derives, quantity: quantity, name: name, name_span: member.name_span, base: Type.Float, base_span: member.name_span, range: None, span: member.name_span})
        }
    }
    definitions
}

struct EnumDef {
    span: Span
    is_pub: Bool
    is_package_pub: Bool
    name: String
    name_span: Span
    type_params: [TypeParam]
    variants: [Variant]
    methods: [Func]
    trait_impls: [TraitImplBlock]
    derives: [NamedSpan]
    auto_derive_default: Bool
    is_single_use: Bool
    single_use_span: Span?
    is_must_use: Bool
    must_use_span: Span?
    serde_markers: [Marker]
    type_markers: [Marker]
    groups: [EnumGroup]
}

struct EnumGroup {
    path: String
    name_span: Span
}

struct Variant {
    name: String
    name_span: Span
    payload: VariantPayload
    discriminant: Int?
    discriminant_expr: Expr?
    serde_markers: [Marker]
}

enum VariantPayload {
    Unit
    Single(ty: Type, span: Span)
    Named(fields: [VariantField])
}

struct VariantField {
    name: String
    name_span: Span
    ty: Type
    ty_span: Span
}

struct ImplDef {
    span: Span
    type_name: String
    type_span: Span
    trait_name: String?
    trait_span: Span?
    operator_rhs: Type?
    operator_marker: OperatorMarker?
    methods: [Func]
    delegation_field: String?
    assoc_type_impls: [NamedType]
    is_generated_serde: Bool
    os_target: String?
}

struct Field {
    is_pub: Bool
    is_package_pub: Bool
    name: String
    name_span: Span
    ty: Type
    ty_span: Span
    serde_markers: [Marker]
    redact: Bool
    computed: Expr?
    default: Expr?
    default_ct: CtValue?
}

enum SerdeWireShape {
    Null
    Bool
    Int
    Float
    Text
    Array
    Object
    Number
}

struct TypedField {
    name: String
    name_span: Span
    ty: Type
    span: Span
}

struct TypedNamedField {
    name: String
    ty: Type
}

struct NamedType {
    name: String
    span: Span
    ty: Type
}

struct ConstDef {
    span: Span
    name: String
    name_span: Span
    value: Expr
    // 3A `pub NAME :: v` exports the binding like any other
    // top-level item; `pub(package)` keeps it inside the package.
    is_pub: Bool
    is_package_pub: Bool
    meta: MetaAttr?
    attrs: [ConstAttr]
    rust_kind: RustConstKind
    is_comptime: Bool
    ct: CtValue?
    ty: Type?
    is_persist: Bool
    persist_span: Span?
    mutable: Bool
    resolved_output: ResolvedOutput?
}

enum ConstAttr {
    ForceStatic
    ForceInline
}

enum RustConstKind {
    Const
    Static
}

enum OutputKind {
    Library
    Executable
    Service
    Check
    Environment
    Image
    Bundle
    System
    Fleet
}

enum OutputCallableAuthority {
    SafeJet
}

struct ResolvedOutput {
    address: String
    kind: OutputKind
    output_name: String
    module_id: Int
    source_path: String
    source_name: String
    semantic_name: String
    lowered_name: String
    params: [OutputParam]
    return_type: Type?
    failure_contract: FailureContract
    reference: Span
    definition: Span
    authority: OutputCallableAuthority
    effects: [String]
    selected: Bool
    selection_reason: String
}

struct OutputParam {
    access: AccessConvention
    ty: Type
}

struct ErrorConvDef {
    from_ty: String
    from_span: Span
    to_ty: String
    to_span: Span
    body: [Stmt]
    body_span: Span
}

struct MigrationDecl {
    type_name: String
    type_span: Span
    ops: [MigrationOp]
    span: Span
}

enum MigrationOp {
    Rename(from: String, from_span: Span, to: String, to_span: Span)
    Add(field: String, field_span: Span, ty: Type, ty_span: Span, default: Expr, default_span: Span, default_fn: String?)
    Remove(field: String, field_span: Span)
    Change(field: String, field_span: Span, from_ty: Type, from_span: Span, to_ty: Type, to_span: Span, converter: Expr?, converter_span: Span?, conv_fn: String?)
}

struct ParseResult {
    program: Program
    diagnostics: [Diagnostic]
}

fn ast_program() -> Program Never! {
    Program{
        imports: [ImportDecl]{},
        items: [Item]{},
        script_body: [Stmt]{},
        block_spans: [Span]{},
        fenced_statements: [FencedStatement]{},
        web_target_ceiling: None,
        no_prelude: false,
        default_target: None,
        html_path: None,
        policy_declarations: [PolicyDeclaration]{},
        user_policy_declarations: [UserPolicyDecl]{},
        applied_rules: [AppliedRuleApplication]{},
        rule_facts: [AppliedRuleApplication]{},
    }
}

fn ast_func(name: String, name_span: Span, span: Span) -> Func Never! {
    Func{
        span: span,
        is_pub: false,
        is_package_pub: false,
        is_comptime: false,
        external_type: None,
        name: name,
        name_span: name_span,
        meta: None,
        type_params: [TypeParam]{},
        head_pattern: None,
        params: [Param]{},
        return_type: None,
        return_type_span: None,
        return_view_provenance: None,
        declared_return_view_provenance: None,
        gc_return: false,
        diverges: false,
        gc_scope: false,
        is_unsafe: false,
        unsafe_reason: None,
        unsafe_span: None,
        is_pure: false,
        is_sanitizer: false,
        scrub_tag: None,
        declared_effects: None,
        effect_via: None,
        state_requires: None,
        state_transition: None,
        is_reactive: false,
        reactive_upgrades: [String]{},
        is_replayable: false,
        replayable_span: None,
        is_job: false,
        job_span: None,
        job_metadata: None,
        every: None,
        is_must_use: false,
        must_use_span: None,
        maturity: None,
        maturity_span: None,
        kernel: None,
        is_inline: false,
        is_inline_always: false,
        inline_span: None,
        web_marker: None,
        pre: [ContractClause]{},
        post: [ContractClause]{},
        inline_foreign: None,
        undo: None,
        markers: [Marker]{},
        compiler_generated: false,
        body: [Stmt]{},
    }
}

/// The metadata a bare `#Job` carries: `.Dev` scope and every optional field
/// empty. `#Job(...)` starts from the same row before binding its arguments.
fn ast_job_metadata() -> JobMetadata Never! {
    JobMetadata{scope: JobScope.Dev, after: [String]{}, packages: [String]{}, cwd: None, inputs: [String]{}, outputs: [String]{}, skip: None, cache: JobCachePolicy.Uncached, parallel: None, limits: [StringMapEntry]{}}
}

fn ast_struct(name: String, name_span: Span, span: Span) -> StructDef Never! {
    StructDef{
        span: span,
        is_pub: false,
        is_package_pub: false,
        name: name,
        name_span: name_span,
        type_params: [TypeParam]{},
        fields: [Field]{},
        state: None,
        methods: [Func]{},
        cli_bindings: [CLICommandBinding]{},
        trait_impls: [TraitImplBlock]{},
        derives: [NamedSpan]{},
        auto_derive_default: false,
        is_published_schema: false,
        published_schema_span: None,
        is_single_use: false,
        single_use_span: None,
        is_must_use: false,
        must_use_span: None,
        layout: None,
        layout_span: None,
        serde_markers: [Marker]{},
        type_markers: [Marker]{},
        validate_block: [Stmt]{},
        validate_span: None,
    }
}

fn ast_enum(name: String, name_span: Span, span: Span) -> EnumDef Never! {
    EnumDef{
        span: span,
        is_pub: false,
        is_package_pub: false,
        name: name,
        name_span: name_span,
        type_params: [TypeParam]{},
        variants: [Variant]{},
        methods: [Func]{},
        trait_impls: [TraitImplBlock]{},
        derives: [NamedSpan]{},
        auto_derive_default: false,
        is_single_use: false,
        single_use_span: None,
        is_must_use: false,
        must_use_span: None,
        serde_markers: [Marker]{},
        type_markers: [Marker]{},
        groups: [EnumGroup]{},
    }
}

fn ast_const(name: String, name_span: Span, span: Span, value: Expr) -> ConstDef Never! {
    ConstDef{
        span: span,
        name: name,
        name_span: name_span,
        value: value,
        is_pub: false,
        is_package_pub: false,
        meta: None,
        attrs: [ConstAttr]{},
        rust_kind: RustConstKind.Const,
        is_comptime: false,
        ct: None,
        ty: None,
        is_persist: false,
        persist_span: None,
        mutable: false,
        resolved_output: None,
    }
}
