// Rust-shaped top-level AST, declaration payloads, and parser metadata.

Item: enum {
    Func(value: Func)
    Struct(value: StructDef)
    Enum(value: EnumDef)
    Distinct(value: DistinctDef)
    TypeAlias(value: TypeAliasDef)
    UnitFamily(value: UnitFamilyDef)
    Trait(value: TraitDef)
    Tag(value: TagDef)
    EffectDecl(value: EffectDecl)
    Impl(value: ImplDef)
    Const(value: ConstDef)
    Test(value: TestDef)
    ExternRust(value: ExternRustBlock)
    Module(value: ModuleDecl)
    CModule(value: CModule)
    CodeModule(value: CodeModule)
    ErrorConv(value: ErrorConvDef)
    Migration(value: MigrationDecl)
    ProtocolDecl(value: ProtocolDecl)
    TemplateLoop(value: ItemTemplateLoop)
    GenericModule(value: GenericModuleDef)
    ModuleAlias(value: ModuleAliasDef)
    MarkerDecl(value: MarkerDecl)
    FactDecl(value: FactDecl)
}

Program: struct {
    imports: [ImportDecl]
    items: [Item]
    script_body: [Stmt]
    block_spans: [Span]
    fenced_statements: [FencedStatement]
    web_target_ceiling: WebBucket?
    no_prelude: Bool
    default_target: String?
    html_path: String?
    policy_declarations: [PolicyDeclaration]
    user_policy_declarations: [UserPolicyDecl]
    applied_rules: [AppliedRuleApplication]
    rule_facts: [AppliedRuleApplication]
    // E0641: each dispatch table's authored `else` arm, so sema can point at
    // an `else` over a closed set and rewrite or delete it.
    else_arms: [ElseArmSpan]{[ElseArmSpan]{}}
    // L0103 the local names of this file's imports that the
    // file spells outside its import declarations, so sema can report an
    // import that is never read.
    used_import_names: [String]{[String]{}}
    // The authored text of every `debug(…)` call, so sema can
    // write the trace site and the E3405 unwrap edit without the source.
    debug_sites: [DebugTraceSite]{[DebugTraceSite]{}}
    // Every `.routes(from:)` root this file names, as the driver read it
    // from the authorized snapshot, so sema checks the convention files.
    app_route_roots: [AppRouteRoot]{[AppRouteRoot]{}}
    // An `#FX(…)` written at the head of the file, above a `use` line: a cap
    // on every function in the file. Sema names it after the file.
    file_cap: ModuleCap?{None}
    // The names an entry file of top-level statements binds at its top
    // level: locals of its generated `run: fn` (JetSema
    // sema_script_entry), which its functions don't see.
    entry_locals: [String]{[String]{}}
}

// One `debug(…)` call as written. `name_start` keys it to the call's
// name span; `text` is the argument exactly as written; `close_end` is the
// byte after the closing `)`.
DebugTraceSite: struct {
    name_start: Int
    text: String
    close_end: Int
}

ElseArmSpan: struct {
    // The whole table, which is also the span every level of its chain carries.
    table: Span
    // From `else` through the end of its body.
    arm: Span
    // The arm plus the line break and indentation before it.
    delete: Span
    // The `else` shares its line with the arm before it (`{ .A -> 1 else -> 2 }`).
    one_line: Bool
    // A one-line table's layout, which sema rewrites one arm per line: a
    // one-line table holds one arm and its `else`, so the cases the `else`
    // stands for take a line of their own.
    layout: ElseArmLayout?
}

ElseArmLayout: struct {
    // From just after the table's `{` up to its `}`.
    span: Span
    // The arms before `else`, as written.
    head: String
    // The `else` arm after its keyword (` -> body`), as written.
    tail: String
    // The indentation of the line the table starts on.
    indent: String
}

FencedStatement: struct {
    span: Span
    fences: [FencedNames]
    copies: Int
}

FencedNames: struct {
    span: Span
    names: [NamedSpan]
    range: NameRange?
}

NameRange: struct {
    start: String
    end: String
}

WebBucket: enum {
    JS
    Wasm
}

WebPartitionMarker: enum {
    JS
    Wasm
    WasmExport
}

AppliedRuleApplication: struct {
    marker: Marker
    target: Span?
    site: RuleSite?
}

// A copy of `Site` in Core/Compiler/Lang.jet, in its order (the closed-list
// mirror ledger): edit `Site`, then copy it here.
RuleSite: enum {
    Package
    File
    Module
    Function
    Method
    Block
    Statement
    Expression
    Type
    Impl
    Trait
    Declaration
    Constant
    Field
    Variant
    Parameter
    Test
    Operation
    Text
    // A match arm: `#Through` is written after the arm's body.
    Arm
}

ImportDecl: struct {
    kind: ImportKind
    alias: String
    alias_span: Span
    span: Span
    item_spans: [Span]
    local_spans: [Span]
    is_pub: Bool
    is_package_pub: Bool
    inline_version: InlineVersion?
    // A `comptime use` row: from `comptime` up to `use`. Its names are for
    // compile-time code only.
    comptime_span: Span?{None}
}

ImportKind: enum {
    File(path: String, span: Span)
    Module(name: String, span: Span)
    Unqualified(module_alias: String, module_alias_span: Span, items: [ImportedItem], items_span: Span, span: Span)
}

ImportedItem: struct {
    original: String
    alias: String?
}

// One name an import declaration binds, as owned leaf projections of the
// declaration.
ImportBinding: struct {
    module_alias: String
    original: String?
    local: String
    alias: String?
    module_alias_span: Span
    item_span: Span?
    local_span: Span
    items_span: Span?
    import_span: Span
    is_pub: Bool
    is_package_pub: Bool
}

// The local name of one `use c: a.b` member: its alias, else the last
// segment of its path.
member_import_local: fn(original: String, alias: String?) -> String Never! {
    if alias == .Val(name) -> return name
    parts: original.split(".").to_list()
    parts[parts.len() - 1]
}

// The name a whole-module or file import binds.
import_alias: fn(declaration: ImportDecl) -> String Never! {
    if declaration.alias != "" -> return declaration.alias
    if declaration.kind == {
        .File(path, _) -> {
            parts: path.split("/").to_list()
            parts[parts.len() - 1]
        }
        .Module(name, _) -> name
        .Unqualified(module_alias, _, _, _, _) -> module_alias
    }
}

// Every binding a declaration introduces, in source order. A file import binds
// through its program, not through a name here.
import_walk_bindings: fn(declaration: ImportDecl) -> [ImportBinding] Never! {
    bindings := [ImportBinding]{}
    if declaration.kind == {
        .Module(name, path_span) -> {
            alias: if declaration.alias == "" -> None else -> Val(declaration.alias)
            bindings.push(ImportBinding{module_alias: name, original: None, local: import_alias(declaration), alias: alias, module_alias_span: path_span, item_span: None, local_span: declaration.alias_span, items_span: None, import_span: declaration.span, is_pub: declaration.is_pub, is_package_pub: declaration.is_package_pub})
        }
        .Unqualified(module_alias, module_alias_span, items, items_span, _) -> {
            loop (index, item) in items {
                item_span: if index < declaration.item_spans.len() -> Val(declaration.item_spans[index]) else -> None
                local_span: if index < declaration.local_spans.len() -> declaration.local_spans[index] else -> item_span ?? module_alias_span
                bindings.push(ImportBinding{module_alias: module_alias, original: Val(item.original), local: member_import_local(item.original, item.alias), alias: item.alias, module_alias_span: module_alias_span, item_span: item_span, local_span: local_span, items_span: Val(items_span), import_span: declaration.span, is_pub: declaration.is_pub, is_package_pub: declaration.is_package_pub})
            }
        }
        .File(_, _) -> {}
    }
    bindings
}

InlineVersion: struct {
    text: String
    span: Span
}

UserPolicyDecl: struct {
    is_pub: Bool
    name: String
    name_span: Span
    params: [Param]
    body: [Stmt]
    span: Span
}

EffectDecl: struct {
    name: String
    name_span: Span
    irreversible: Bool
    span: Span
}

// A type's `impl Effect { … }` block: where it starts, the written
// `irreversible: fn(self) -> Bool` body, the `parent: Name` setting of a
// package effect (the effect whose kind it is, written as a row writes it:
// `Log`, `Audit`, `audit.Audit`), and the effect names the type declares
// (the type itself, then each case of an enum family).
EffectImpl: struct {
    span: Span
    irreversible: Expr?
    method_span: Span?
    parent: NamedSpan?{None}
    decls: [EffectDecl]
}

MarkerDecl: struct {
    name: String
    name_span: Span
    is_pub: Bool{false}
    is_package_pub: Bool{false}
    group: [Marker]?{None}
    params: [MarkerDeclParam]
    body: [DeriveBodyItem]?
    // The effect row written on `expand`, `-[…]>`, and its span. None: the
    // row of `Marker.expand`, `Meta.Generate`.
    row: [EffectRowEntry]?{None}
    row_span: Span?{None}
    span: Span
}

MarkerDeclParam: struct {
    name: String
    name_span: Span
    ty: Type?
    value: Expr?
    variadic: Bool
}

FactDecl: struct {
    name: String
    name_span: Span
    params: [MarkerDeclParam]
    span: Span
}

CodeModule: struct {
    name: String
    name_span: Span
    is_pub: Bool
    is_package_pub: Bool
    body: [Item]?
    imports: [ImportDecl]
    web_target: WebBucket?
    instance_identity: ModuleInstanceIdentity?
    span: Span
    cap: ModuleCap?{None}
    // The markers written above `module` and as `#X: value` lines in its
    // body, in source order. `#FX` is the cap, not a marker.
    markers: [Marker]{[Marker]{}}
}

// A module's, a type's or a trait's `#FX(…)` cap. Its plain entries are the
// ceiling and its `!` entries are denials: for every function inside the
// module, nested modules and type bodies included, for every method of the
// type, trait impls written apart from its body included, or for every
// implementation of the trait's methods in any package. Sema checks each
// function's solved row against it. `scope` is `module`, `type` or `trait`;
// `owner` is the module's, the type's or the trait's name.
ModuleCap: struct {
    owner: String
    scope: String{"module"}
    entries: [EffectRowEntry]
    span: Span
}

ModuleInstanceIdentity: struct {
    full_key: [U8]
    fingerprint: String
    definition_id: String
    argument_keys: [[U8]]
    argument_values: [String]
    argument_provenance: [[String]]
    template_span: Span
    applications: [ModuleInstanceApplication]
}

ModuleInstanceApplication: struct {
    name: String
    source_module: String
    semantic_identity: String
    span: Span
}

GenericModuleParam: enum {
    Type(name: String, name_span: Span, bound: Type?)
    Value(name: String, name_span: Span, ty: Type)
}

ModuleArg: enum {
    Type(ty: Type, span: Span)
    Value(expr: Expr, span: Span)
}

GenericModuleDef: struct {
    name: String
    name_span: Span
    is_pub: Bool
    is_package_pub: Bool
    params: [GenericModuleParam]
    imports: [ImportDecl]
    body: [Item]
    span: Span
    // The markers written above the template. An `#FX(…)` among them is also
    // `cap`, carried by every function of the body as for a code module.
    markers: [Marker]{[Marker]{}}
    cap: ModuleCap?{None}
}

ModuleAliasDef: struct {
    name: String
    name_span: Span
    is_pub: Bool
    is_package_pub: Bool
    target: String
    target_span: Span
    args: [ModuleArg]
    span: Span
}

CModuleKind: enum {
    Extern
    Bindgen
}

CModule: struct {
    kind: CModuleKind
    lib: String
    path_span: Span
    functions: [ExternFn]
    span: Span
}

ModuleDecl: struct {
    name: String
    name_span: Span
    auto_discovered: Bool
    sources: [SourceDecl]
    imports: [Expr]
    members: [Expr]
    contributions: [Contribution]
    span: Span
    // The markers written above `module` and the `#X: value` lines of its
    // body, in source order.
    markers: [Marker]{[Marker]{}}
}

SourceDecl: struct {
    name: String
    name_span: Span
    ref_span: Span
    span: Span
}

Contribution: struct {
    namespace: Namespace
    path: String
    path_span: Span
    value: ContribValue
    span: Span
}

ContribValue: enum {
    Expr(value: Expr)
    Env(value: EnvLit)
    System(value: SystemLit)
    Image(value: ImageLit)
    Fleet(value: FleetLit)
    VMTest(value: VMTestLit)
    Profile(value: ProfileLit)
    Perf(value: PerfLit)
}

PerfLit: struct {
    budgets: [BudgetDecl]
    budgets_span: Span
    compile_workloads: [CompileWorkloadDecl]
    compile_workloads_span: Span?
    list_span: Span
    span: Span
}

CompileWorkloadDecl: struct {
    name: String
    name_span: Span
    target: Expr
    patch: Expr
    span: Span
}

ProfileLit: struct {
    fields: [NamedExpr]
    span: Span
}

BudgetDecl: struct {
    fields: [BudgetField]
    span: Span
}

BudgetField: struct {
    name: String
    name_span: Span
    value: Expr
    span: Span
}

EnvLit: struct {
    fields: [NamedExpr]
    services: [ServiceEntry]
    span: Span
}

SystemLit: struct {
    explicit_type: Span?
    fields: [SystemField]
    span: Span
}

SystemField: struct {
    name: String
    name_span: Span
    value: SystemFieldValue
    span: Span
}

SystemFieldValue: enum {
    Platform(os: String, arch: String, span: Span)
    Packages(value: Expr)
    Services(entries: [ServiceEntry])
    Options(entries: [OptionEntry])
    Other(value: Expr)
}

ServiceEntry: struct {
    name: String
    name_span: Span
    explicit_type: Span?
    fields: [NamedExpr]
    span: Span
}

OptionEntry: struct {
    key: String
    key_span: Span
    value: Expr
    value_span: Span
    span: Span
}

ImageLit: struct {
    explicit_type: Span?
    fields: [ImageField]
    span: Span
}

ImageField: struct {
    name: String
    name_span: Span
    value: ImageFieldValue
    span: Span
}

ImageFromRef: enum {
    System(name: String)
    Package(name: String)
    Environment(name: String)
}

ImageFieldValue: enum {
    From(source: ImageFromRef, span: Span)
    Format(word: String, span: Span)
    Platform(os: String, arch: String, span: Span)
    Other(value: Expr)
}

FleetLit: struct {
    explicit_type: Span?
    fields: [FleetField]
    span: Span
}

FleetField: struct {
    name: String
    name_span: Span
    value: FleetFieldValue
    span: Span
}

FleetFieldValue: enum {
    Hosts(entries: [HostEntry])
    Other(value: Expr)
}

HostEntry: struct {
    name: String
    name_span: Span
    system: String
    system_span: Span
    overrides: Span?
    span: Span
}

VMTestLit: struct {
    explicit_type: Span?
    fields: [VMTestField]
    span: Span
}

VMTestField: struct {
    name: String
    name_span: Span
    value: VMTestFieldValue
    span: Span
}

VMTestFieldValue: enum {
    Hosts(entries: [HostEntry])
    Run(span: Span)
    Other(value: Expr)
}

Namespace: enum {
    Env
    System
    Image
    Fleet
    VMTest
    Perf
    Profile
}

NamedExpr: struct {
    name: String
    name_span: Span
    value: Expr
}

TypeParam: struct {
    name: String
    name_span: Span
    bounds: [String]
    // Set when the declaration is a compile-time number
    // parameter, `<comptime N: Int>`; `bounds` is then empty.
    prep: PrepParam?
}

// The declaration head of a compile-time number parameter.
// Only the declaration carries `comptime`; uses write the plain name. An
// `Int` one is a generic parameter whose arguments are numbers (#3505);
// sema rejects any other value type with E0390.
PrepParam: struct {
    prep_span: Span
    value_type: String
    value_type_span: Span
}

TraitDef: struct {
    span: Span
    is_pub: Bool
    is_package_pub: Bool
    name: String
    name_span: Span
    // The traits this one builds on (`T: trait: A`,
    // `T: trait: [A, B]`).
    supertraits: [String]
    assoc_types: [NamedSpan]
    // The compile-time constants an implementation supplies: `sides: Int`,
    // or `severity: Severity{.Error}` with a default.
    constants: [TraitConstDecl]
    methods: [TraitMethodSig]
    // The markers written above `trait` and as lines in its body.
    markers: [Marker]{[Marker]{}}
    // `#FX(…)` above the trait, or an `#FX: (…)` line in its body.
    cap: ModuleCap?{None}
}

// One trait constant requirement. `ty` is written in the trait's module;
// `default` is the value an implementation that writes none takes.
TraitConstDecl: struct {
    name: String
    name_span: Span
    ty: Type
    ty_span: Span
    default: Expr?
    span: Span
}

// One trait constant an implementation supplies: `sides: 4`.
ImplConstValue: struct {
    name: String
    name_span: Span
    value: Expr
    span: Span
}

TagDef: struct {
    is_pub: Bool
    is_package_pub: Bool
    name: String
    name_span: Span
    deny: [NamedSpan]
    from: [NamedSpan]
    span: Span
    // `timing: .Free | .Fixed` and `protects: .Secrecy | .Integrity`
    // (core.compiler.lang TagTiming and TagProtects), as written; None
    // when the body leaves them out (.Free, .Secrecy).
    timing: NamedSpan?{None}
    protects: NamedSpan?{None}
}

ProtocolDirection: enum {
    ClientToServer
    ServerToClient
}

ProtocolMessage: struct {
    direction: ProtocolDirection
    name: String
    name_span: Span
    fields: [TypedNamedField]
    span: Span
}

ProtocolDecl: struct {
    is_pub: Bool
    is_package_pub: Bool
    name: String
    name_span: Span
    messages: [ProtocolMessage]
    span: Span
}

StateDecl: struct {
    is_pub: Bool
    is_package_pub: Bool
    type_name: String
    type_name_span: Span
    states: [NamedSpan]
    span: Span
}

DeriveBodyItem: enum {
    Item(value: Item)
    Stmt(value: Stmt)
    Loop(var: String, var_span: Span, source: Expr, body: [DeriveBodyItem], span: Span)
    // `comptime if cond { … } else { … }`: the template expands only the
    // chosen branch's items.
    If(cond: Expr, cond_span: Span, then_body: [DeriveBodyItem], else_body: [DeriveBodyItem]?, span: Span)
}

ItemTemplateLoop: struct {
    var: String
    var_span: Span
    source: Expr
    body: [DeriveBodyItem]
    span: Span
}

TraitMethodSig: struct {
    name: String
    name_span: Span
    // The method's own type parameters (`encode_hole: fn<T: Printable>(…)`).
    type_params: [TypeParam]
    params: [Param]
    return_type: Type?
    span: Span
    default_body: [Stmt]?
    is_pure: Bool
    declared_effects: [EffectRowEntry]?
    return_view_provenance: ViewProvenanceMap?
    declared_return_view_provenance: ViewProvenanceMap?
    markers: [Marker]
    // The `#FX(…)` caps of the modules enclosing the trait, outermost first:
    // an impl that inherits the default body inherits them with it.
    module_caps: [ModuleCap]{[ModuleCap]{}}
}

TraitImplBlock: struct {
    trait_name: String
    trait_span: Span
    operator_rhs: Type?
    operator_marker: OperatorMarker?
    methods: [Func]
    compiler_generated: Bool
    assoc_type_impls: [NamedType]
    constants: [ImplConstValue]
    delegation_field: String?{None}
    // The block's markers: those above `impl`, then its `#X: value` lines.
    markers: [Marker]{[Marker]{}}
    // The native OS the block is gated to by `#Target(OS.…)`, as on `ImplDef`.
    os_target: String?{None}
    // From `impl` through the block's end; None for a generated block.
    span: Span?{None}
}

OperatorMarker: enum {
    Commutative
}

ExternRustBlock: struct {
    crate_spec: String
    crate_span: Span
    functions: [ExternFn]
    span: Span
}

ExternFn: struct {
    abi: NamedSpan?
    name: String
    name_span: Span
    params: [Param]
    return_type: Type?
    return_type_span: Span?
    rust_path: String
    rust_path_span: Span
    generated: Bool
    callback_transport: String?
    callback_plan_digest: String?
    callback_identity: String?
    effect_root: String?
    undo: NamedSpan?
    close: NamedSpan?
    span: Span
}

TestDef: struct {
    span: Span
    name: String?
    name_expr: Expr?
    faults_expr: Expr?
    faults: [String]
    expected_fail_expr: Expr?
    expected_fail: Bool
    marker_name_span: Span
    name_prefix: String?
    name_span: Span
    params: [Param]
    fn_keyword_span: Span?
    body: [Stmt]
    // A property test's `#Pre(cond, msg)` clauses: a generated case that
    // fails one is rejected and does not count toward the case budget.
    pre: [ContractClause]{[ContractClause]{}}
}

MaturityTag: enum {
    Experimental
    Tested
    Hardened
}

KernelMode: enum {
