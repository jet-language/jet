    pub return_type: Type?
    pub return_type_span: Span?
    pub return_view_provenance: ViewProvenanceMap?
    pub declared_return_view_provenance: ViewProvenanceMap?
    pub gc_return: Bool
    pub diverges: Bool
    pub gc_scope: Bool
    pub is_unsafe: Bool
    pub unsafe_reason: String?
    pub unsafe_span: Span?
    pub is_pure: Bool
    pub is_sanitizer: Bool
    pub scrub_tag: String?
    pub declared_effects: [EffectRowEntry]?
    pub effect_via: NamedSpan?
    pub state_requires: NamedSpan?
    pub state_transition: StateTransition?
    pub is_reactive: Bool
    pub reactive_upgrades: [String]
    pub is_replayable: Bool
    pub replayable_span: Span?
    pub is_job: Bool
    pub job_span: Span?
    pub job_metadata: JobMetadata?
    pub every: EveryMarker?
    pub is_must_use: Bool
    pub must_use_span: Span?
    pub maturity: MaturityTag?
    pub maturity_span: Span?
    pub kernel: KernelMarker?
    pub is_inline: Bool
    pub is_inline_always: Bool
    pub inline_span: Span?
    pub web_marker: WebPartitionMarker?
    pub pre: [ContractClause]
    pub post: [ContractClause]
    pub inline_foreign: InlineForeign?
    pub undo: NamedSpan?
    pub markers: [Marker]
    pub compiler_generated: Bool
    pub body: [Stmt]
}

