        if self == {
            .DirectCAbi -> "DirectCAbi" .ClangCppShim -> "ClangCppShim" .LegacyRustExtern -> "LegacyRustExtern" .SupervisedPythonSidecar -> "SupervisedPythonSidecar" .TargetDispatchedJs -> "TargetDispatchedJs" .SwiftCAbiBridge -> "SwiftCAbiBridge" .GoCArchive -> "GoCArchive" .EmbeddedJvm -> "EmbeddedJvm" .EmbeddedDotNet -> "EmbeddedDotNet" .EmbeddedTcl -> "EmbeddedTcl" .EmbeddedLua -> "EmbeddedLua" .FortranIsoCBinding -> "FortranIsoCBinding" .GnuCobolCAbi -> "GnuCobolCAbi" .AdaGnatCAbi -> "AdaGnatCAbi" .FreePascalCdecl -> "FreePascalCdecl" .DartApiDl -> "DartApiDl" .SupervisedPowerShell -> "SupervisedPowerShell" .SupervisedPerl -> "SupervisedPerl" .SupervisedRuby -> "SupervisedRuby" .SupervisedPhpPool -> "SupervisedPhpPool" .SupervisedR -> "SupervisedR" .SupervisedOctave -> "SupervisedOctave" .WindowsComAutomation -> "WindowsComAutomation"
        }
    }
