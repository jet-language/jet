    ReentrantThreadSafe AdapterMarshalled NoCallback CAbi HostRegistration
    pub fn debug_name(self) -> String Never! { if self == { .ReentrantThreadSafe -> "ReentrantThreadSafe" .AdapterMarshalled -> "AdapterMarshalled" .NoCallback -> "None" .CAbi -> "CAbi" .HostRegistration -> "HostRegistration" } }
