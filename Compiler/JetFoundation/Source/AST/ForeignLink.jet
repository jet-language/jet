    CHeader CppHeader RustExternBlock PythonIntrospection TypeScriptDeclarations SwiftModule GoExports JvmClass DotNetAssembly TclScript LuaScript FortranIsoCBinding GnuCobolCopybook AdaSpec PascalSource DartContract PowerShellScript PerlScript RubyScript PhpScript RScript OctaveScript ComTypeLibrary
    pub fn debug_name(self) -> String Never! {
        if self == {
            .CHeader -> "CHeader" .CppHeader -> "CppHeader" .RustExternBlock -> "RustExternBlock" .PythonIntrospection -> "PythonIntrospection" .TypeScriptDeclarations -> "TypeScriptDeclarations" .SwiftModule -> "SwiftModule" .GoExports -> "GoExports" .JvmClass -> "JvmClass" .DotNetAssembly -> "DotNetAssembly" .TclScript -> "TclScript" .LuaScript -> "LuaScript" .FortranIsoCBinding -> "FortranIsoCBinding" .GnuCobolCopybook -> "GnuCobolCopybook" .AdaSpec -> "AdaSpec" .PascalSource -> "PascalSource" .DartContract -> "DartContract" .PowerShellScript -> "PowerShellScript" .PerlScript -> "PerlScript" .RubyScript -> "RubyScript" .PhpScript -> "PhpScript" .RScript -> "RScript" .OctaveScript -> "OctaveScript" .ComTypeLibrary -> "ComTypeLibrary"
        }
