// Canonical AST foreign bridge facts (Rust AST/ffi.rs). Paths stay native
// OS-path values; display strings are never inverted into filesystem identity.
use core.files.runtime.kernel_path_components as ffi_link_path

pub enum ThreadSafety { Unspecified Safe Unsafe }
pub enum CloseSource { Conventional Overlay }

pub fn pkg_ffi_close_source_name(source: CloseSource) -> String Never! {
    if source == { .Conventional -> "conventional" .Overlay -> "overlay" }
}
pub fn pkg_ffi_close_source_parse(value: String) -> CloseSource? Never! {
    if value == { "conventional" -> Val(CloseSource.Conventional) "overlay" -> Val(CloseSource.Overlay) else -> None }
}
pub fn pkg_ffi_thread_safety_name(safety: ThreadSafety) -> String Never! {
    if safety == { .Unspecified -> "unspecified" .Safe -> "safe" .Unsafe -> "unsafe" }
}
pub fn pkg_ffi_thread_safety_parse(value: String) -> ThreadSafety? Never! {
    if value == { "unspecified" -> Val(ThreadSafety.Unspecified) "safe" -> Val(ThreadSafety.Safe) "unsafe" -> Val(ThreadSafety.Unsafe) else -> None }
}

// Rust FfiLinkClosure::new: sorted nonempty identities, no quadratic membership
// scans. Exact empty strings disappear; whitespace-only identities do not.
fn pkg_ffi_sorted_nonempty(values: ^[String]) -> [String] Never! {
    sorted := ^values
    &sorted.sort()
    kept := 0
    loop index in 0..<sorted.len() {
        if sorted[index] == "" -> next
        if kept > 0 && sorted[index] == sorted[kept - 1] -> next
        if kept != index -> sorted[kept] = ^sorted[index]
        kept += 1
    }
    loop sorted.len() > kept -> &sorted.pop().drop("discard the duplicate or empty row beyond the compacted prefix")
    sorted
}

fn ffi_link_sorted_contains(rows: [String], name: String) -> Bool Never! {
    low := 0
    high := rows.len()
    loop low < high {
        mid :: (low + high) /% 2
        if rows[mid] < name -> low = mid + 1 else -> high = mid
    }
    low < rows.len() && rows[low] == name
}

pub struct FfiLinkClosure {
    pub direct: [String]
    pub transitive: [String]

    pub fn new(direct: ^[String], transitive: ^[String]) -> FfiLinkClosure Never! {
        direct_rows :: pkg_ffi_sorted_nonempty(^direct)
        transitive_rows := pkg_ffi_sorted_nonempty(^transitive)
        kept := 0
        loop index in 0..<transitive_rows.len() {
            if ffi_link_sorted_contains(direct_rows, transitive_rows[index]) -> next
            if kept != index -> transitive_rows[kept] = ^transitive_rows[index]
            kept += 1
        }
        loop transitive_rows.len() > kept -> &transitive_rows.pop().drop("discard direct libraries beyond the compacted transitive prefix")
        FfiLinkClosure{direct: direct_rows, transitive: transitive_rows}
    }

    pub fn empty() -> FfiLinkClosure Never! {
        FfiLinkClosure{direct: [String]{}, transitive: [String]{}}
    }

    pub fn libraries(self) -> FfiLibraries from self {
        FfiLibraries{closure: @self, at: 0}
    }

    pub fn stable_key(self) -> String Never! {
        "direct={self.direct.join(",")};transitive={self.transitive.join(",")}"
    }
}

// Rust FfiLinkClosure::libraries: borrow the owned lists through one stack
// cursor; iteration never allocates or materializes copies of native names.
pub struct FfiLibraries { pub closure: @FfiLinkClosure, pub at: Int }
impl FfiLibraries.Iterator {
    type Item = @String
    fn next(&self) -> (@String)? from self {
        index :: self.at
        if index < self.closure.direct.len() {
            self.at += 1
            return Val(@self.closure.direct[index])
        }
        transitive_index :: index - self.closure.direct.len()
        if transitive_index < self.closure.transitive.len() {
            self.at += 1
            return Val(@self.closure.transitive[transitive_index])
        }
        None
    }
}

pub struct FfiHandleFact {
    pub lib: String
    pub typedef_name: String
    pub jet_name: String
    pub close: String
    pub close_source: CloseSource
    pub thread_safety: ThreadSafety

    pub fn stable_key(self) -> String Never! {
        "lib={self.lib};typedef={self.typedef_name};jet={self.jet_name};close={self.close};close-source={pkg_ffi_close_source_name(self.close_source)};thread-safety={pkg_ffi_thread_safety_name(self.thread_safety)}"
    }
}

// Rust FfiLink1400–1426: preserve the complete link/provenance/native carrier.
// cdylib belongs to the precisely retired resident JIT consumer, not to the
// unrelated foreign handles, bridge identity or native link closure.
pub struct FfiLink {
    pub crate_name: String
    pub cache_identity: String
    pub provenance_path: ffi_link_path.OsPath
    pub rlib_path: ffi_link_path.OsPath
    pub cdylib_path: ffi_link_path.OsPath
    pub target_deps_dir: ffi_link_path.OsPath
    pub host_deps_dir: ffi_link_path.OsPath
    pub helper_bin_path: ffi_link_path.OsPath?
    pub secrets_helper_bin_path: ffi_link_path.OsPath?
    pub handle_facts: [FfiHandleFact]
    pub link_closure: FfiLinkClosure
}

impl FfiLink {
    // Rust dependency_dirs1428–1435. The stack cursor borrows this link; no
    // path list, OS-path copies or singleton collection are constructed.
    // #4500: ratified memory-reference fields/returns require native lowering.
    pub fn dependency_dirs(self) -> FfiDependencyDirs from self {
        FfiDependencyDirs{link: @self, at: 0}
    }
}

pub struct FfiDependencyDirs {
    pub link: @FfiLink
    pub at: Int
}

impl FfiDependencyDirs.Iterator {
    type Item = @ffi_link_path.OsPath

    fn next(&self) -> (@ffi_link_path.OsPath)? from self {
        if self.at == 0 {
            self.at = 1
            return Val(@self.link.target_deps_dir)
        }
        if self.at == 1 {
            self.at = 2
            if !ffi_link_path.equals(self.link.host_deps_dir, self.link.target_deps_dir) -> return Val(@self.link.host_deps_dir)
        }
        None
    }
}
// Rust AST/ffi.rs:9–790. One descriptor registry is shared by the compiler and
// package binders. Capability lists and descriptor lookups borrow static rows.
pub FOREIGN_DESCRIPTOR_SCHEMA :: prep { "jet-ffi-descriptor-v1" }
pub FOREIGN_ABI_CONTRACT_VERSION :: prep { 1 }

