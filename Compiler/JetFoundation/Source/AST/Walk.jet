// The Expr/Stmt preorder visitor.
// A visit reads the original checked parser node; no source-text discovery.
// It reads each node through its file's AST tables (Nodes.jet) and hands the
// visitor the node's handle; a visitor reads the node with `ast_expr`.
ast_visit_expr: fn(tables: ASTTables, expression: ExprNode, visitor: fn(ExprNode) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    visitor(expression)
    if ast_expr(tables, expression) == {
        .Str(parts, _, _) -> {
            loop part in parts {
                if part == .Interp(value, _) -> ast_visit_expr(tables, value, visitor)
            }
        }
        .ListLit(values, _, _) | .CompareChain(values, _, _, _, _) -> {
            loop value in values -> ast_visit_expr(tables, value, visitor)
        }
        .MemberSpread(value, _, _, _) | .Spread(value, _, _) | .Deref(value, _, _) | .RawOf(value, _, _) | .Copy(value, _, _) | .Place(value, _, _, _) | .Field(value, _, _, _) | .OptField(value, _, _, _, _, _) | .Present(value, _, _) | .Ok(value, _, _) | .Err(value, _, _) | .Paren(value, _, _) | .Unary(_, value, _, _) | .Tainted(value, _, _, _) -> {
            ast_visit_expr(tables, value, visitor)
        }
        .Try(value, _, _, note, _) -> {
            ast_visit_expr(tables, value, visitor)
            if note == .Val(note_value) -> ast_visit_expr(tables, note_value, visitor)
        }
        .MapLit(entries, _, _) -> {
            loop entry in entries {
                ast_visit_expr(tables, entry.key, visitor)
                ast_visit_expr(tables, entry.value, visitor)
            }
        }
        .Index(base, index, _, _, _) -> {
            ast_visit_expr(tables, base, visitor)
            ast_visit_expr(tables, index, visitor)
        }
        .Slice(base, start, end, range, _, _) -> {
            ast_visit_expr(tables, base, visitor)
            ast_visit_expr(tables, start, visitor)
            ast_visit_expr(tables, end, visitor)
            if range == .Val(value) -> ast_visit_expr(tables, value, visitor)
        }
        .Range(left, right, _, _, _) -> {
            ast_visit_expr(tables, left, visitor)
            ast_visit_expr(tables, right, visitor)
        }
        .Binary(_, left, right, _, _) -> {
            // A left-leaning chain (`a + b + c …`) walks its left spine in
            // this frame, so its length costs no stack: each inner level
            // visited going down, the innermost left operand, then each
            // level's right operand, innermost first.
            ^rights: [ExprNode]{right}
            ^operand: left
            loop {
                if {
                    ast_expr(tables, operand) == .Binary(_, inner_left, inner_right, _, _) -> {
                        visitor(operand)
                        rights.push(inner_right)
                        operand = inner_left
                    }
                    else -> { break }
                }
            }
            ast_visit_expr(tables, operand, visitor)
            ^index: rights.len() - 1
            loop index >= 0 {
                ast_visit_expr(tables, rights[index], visitor)
                index -= 1
            }
        }
        .Call(call, _) -> ast_visit_call_args(tables, call.args, visitor)
        .MethodCall(receiver, _, _, _, _, args, _) | .OptMethodCall(receiver, _, _, _, args, _, _) | .CallValue(receiver, args, _, _) -> {
            ast_visit_expr(tables, receiver, visitor)
            ast_visit_call_args(tables, args, visitor)
        }
        .StructLit(_, _, _, _, fields, _, _, _) -> {
            loop field in fields -> ast_visit_expr(tables, field.value, visitor)
        }
        .TypedLit(_, body, _, _) -> {
            if body == {
                .Fields(fields) -> {
                    loop field in fields -> ast_visit_expr(tables, field.value, visitor)
                }
                .Elements(values) -> {
                    loop value in values -> ast_visit_expr(tables, value, visitor)
                }
                .Entries(entries) -> {
                    loop entry in entries {
                        ast_visit_expr(tables, entry.key, visitor)
                        ast_visit_expr(tables, entry.value, visitor)
                    }
                }
                .Value(value) -> ast_visit_expr(tables, value, visitor)
                .ByteText(_) | .Empty -> {}
            }
        }
        .EnumLit(_, _, _, args, _, _, _) -> {
            loop argument in args {
                if argument == {
                    .Positional(value) | .Named(_, value) -> ast_visit_expr(tables, value, visitor)
                }
            }
        }
        .PatternTest(subject, pattern, _, _) -> {
            ast_visit_expr(tables, subject, visitor)
            ast_visit_pattern(tables, pattern, visitor)
        }
        .OrFallback(value, fallback, _, _, _) -> {
            ast_visit_expr(tables, value, visitor)
            ast_visit_fallback(tables, fallback, visitor)
        }
        .If(condition, then_body, then_value, else_body, else_value, _, _) -> {
            ast_visit_expr(tables, condition, visitor)
            ast_visit_body(tables, then_body, visitor, true)
            ast_visit_expr(tables, then_value, visitor)
            ast_visit_body(tables, else_body, visitor, true)
            ast_visit_expr(tables, else_value, visitor)
        }
        .TupleLit(fields, _, _, _) -> {
            loop field in fields -> ast_visit_expr(tables, field.value, visitor)
        }
        .Lambda(lambda, _) -> {
            if lambda.body == {
                .Expr(value) -> { ast_visit_expr(tables, value, visitor) }
                .Block(body) -> ast_visit_body(tables, body, visitor, true)
            }
        }
        .PtrFromAddr(_, _, _, address, _, _) -> { ast_visit_expr(tables, address, visitor) }
        .Pipe(head, steps, _, _) -> {
            ast_visit_expr(tables, head, visitor)
            loop step in steps -> ast_visit_expr(tables, step.value, visitor)
        }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .Ident(_, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .ComptimeName(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
}

// The operands under a Binary node whose operands are `left` and `right`,
// down its left-leaning chain (`a + b + c …`), in the order a walk that takes
// each node's left operand before its right one reaches them: the innermost
// left operand, then each level's right operand, innermost first. A walk with
// no work of its own at a Binary node walks these in one frame, so a chain's
// length costs it no stack.
expr_binary_operands: fn(tables: ASTTables, left: ExprNode, right: ExprNode) -> [ExprNode] Never! {
    ^operands: [ExprNode]{right}
    ^operand: left
    loop {
        if {
            ast_expr(tables, operand) == .Binary(_, inner_left, inner_right, _, _) -> {
                operands.push(inner_right)
                operand = inner_left
            }
            else -> { break }
        }
    }
    operands.push(operand)
    operands.reverse()
    operands
}

ast_visit_body: fn(tables: ASTTables, body: [StmtNode], visitor: fn(ExprNode) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!, nested_expression: Bool) Never! {
    loop statement in body -> ast_visit_statement(tables, statement, visitor, nested_expression)
}

// Each arm is read in place.
ast_visit_switch_arms: fn(tables: ASTTables, arms: [SwitchArm], visitor: fn(ExprNode) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!, nested_expression: Bool) Never! {
    loop arm in arms {
        ast_visit_expr(tables, arm.cond, visitor)
        ast_visit_body(tables, arm.body, visitor, nested_expression)
    }
}

ast_visit_call_args: fn(tables: ASTTables, args: [CallArg], visitor: fn(ExprNode) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    loop argument in args -> ast_visit_expr(tables, argument.expr, visitor)
}

ast_visit_pattern: fn(tables: ASTTables, pattern: PatternNode, visitor: fn(ExprNode) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if ast_pattern(tables, pattern) == {
        .Or(alternatives, _) -> {
            loop alternative in alternatives -> ast_visit_pattern(tables, alternative, visitor)
        }
        .Struct(fields, _, _, _) -> {
            loop field in fields {
                if field == {
                    .Value(_, _, value) -> { ast_visit_expr(tables, value, visitor) }
                    .Nested(_, _, inner) -> { ast_visit_pattern(tables, inner, visitor) }
                    .Bind(_, _, _, _) -> {}
                }
            }
        }
        .Variant(_, slots, _, _) | .List(slots, _, _) -> {
            loop slot in slots -> ast_visit_pattern_slot(tables, slot, visitor)
        }
        .Map(entries, _, _) -> {
            loop entry in entries {
                ast_visit_expr(tables, entry.key, visitor)
                ast_visit_pattern_slot(tables, entry.slot, visitor)
            }
        }
        .Present(_, _, inner, _) | .Ok(_, _, inner, _) | .Err(_, _, inner, _) -> {
            if inner == .Val(nested) -> ast_visit_pattern(tables, nested, visitor)
        }
        .Absent(_) | .Range(_, _, _) | .StrMatch(_, _) | .BinMatch(_, _) -> {}
    }
}

ast_visit_pattern_slot: fn(tables: ASTTables, slot: PatSlot, visitor: fn(ExprNode) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if slot == {
        .Value(value) -> { ast_visit_expr(tables, value, visitor) }
        .Nested(inner) -> { ast_visit_pattern(tables, inner, visitor) }
        .Named(_, _, inner) -> ast_visit_pattern_slot(tables, inner, visitor)
        .Wildcard | .Bind(_, _) | .Range(_, _) | .Rest(_) -> {}
    }
}

ast_visit_fallback: fn(tables: ASTTables, fallback: OrFallback, visitor: fn(ExprNode) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if fallback == {
        .Value(value) -> { ast_visit_expr(tables, value, visitor) }
        .Block(body, value, _) -> {
            ast_visit_body(tables, body, visitor, true)
            if value == .Val(value) -> ast_visit_expr(tables, value, visitor)
        }
        .Return(value, _) -> {
            if value == .Val(value) -> ast_visit_expr(tables, value, visitor)
        }
        .Panic(_, args) -> ast_visit_call_args(tables, args, visitor)
        .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> {}
    }
}

ast_visit_statement: fn(tables: ASTTables, statement: StmtNode, visitor: fn(ExprNode) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!, nested_expression: Bool) Never! {
    if ast_stmt(tables, statement) == {
        .Expr(expression) | .DeferClose(expression, _) -> {
            ast_visit_expr(tables, expression, visitor)
        }
        .Val(binding) -> {
            ast_visit_expr(tables, binding.init, visitor)
            if nested_expression && binding.pattern == .Val(.Refutable(pattern, fallback, _, _)) {
                ast_visit_pattern(tables, pattern, visitor)
                ast_visit_fallback(tables, fallback, visitor)
            }
        }
        // An assigned field or local is visited as the place expression it
        // names (the ownership checker's LValue-to-Expr reading), so a walk
        // sees `self.hits = 0` as the field `hits` of `self`. The place is
        // built here, outside the tables: the tree's handle is the node.
        .Assign(target, _, _, value) -> {
            if target == {
                .Index(base, index, _, _) -> {
                    ast_visit_expr(tables, base, visitor)
                    ast_visit_expr(tables, index, visitor)
                }
                // copy: `base`, `field` and `name` are payloads of read parameter `statement`; the visited place owns these
                .Field(base, field, span) -> {
                    ast_visit_expr(tables, Expr.Field{base: base.copy(), member: field.copy(), span: span, id: AST_NODE_GENERATED}, visitor)
                }
                .Local(name, name_span) -> {
                    visitor(Expr.Ident{name: name.copy(), span: name_span, id: AST_NODE_GENERATED})
                }
            }
            ast_visit_expr(tables, value, visitor)
        }
        .Return(value, _) -> {
            if value == .Val(value) -> ast_visit_expr(tables, value, visitor)
        }
        .While(condition, body, _, _, _) -> {
            ast_visit_expr(tables, condition, visitor)
            ast_visit_body(tables, body, visitor, nested_expression)
        }
        .For(_, _, _, kind, body, _, _, _, _) -> {
            if kind == {
                .Range(start, end, step, _) -> {
                    ast_visit_expr(tables, start, visitor)
                    ast_visit_expr(tables, end, visitor)
                    if step == .Val(value) -> ast_visit_expr(tables, value, visitor)
                }
                .In(collection, step) -> {
                    ast_visit_expr(tables, collection, visitor)
                    if step == .Val(value) -> ast_visit_expr(tables, value, visitor)
                }
            }
            ast_visit_body(tables, body, visitor, nested_expression)
        }
        .Switch(subject, arms, else_body, _) | .ComptimeSwitch(subject, arms, else_body, _) -> {
            ast_visit_expr(tables, subject, visitor)
            ast_visit_switch_arms(tables, arms, visitor, nested_expression)
            if else_body == .Val(body) -> ast_visit_body(tables, body, visitor, nested_expression)
        }
        .BreakValue(value, _) | .Yield(value, _) | .BreakLabelValue(_, _, value, _) -> {
            ast_visit_expr(tables, value, visitor)
        }
        .Loop(body, _, _, _) | .Reactive(body, _) | .Shield(body, _) | .Defer(body, _) | .Switched(_, body, _) | .Region(_, _, body, _) | .Policy(_, body, _) | .AuthorityScope(_, _, _, body, _) | .ComptimeBlock(body, _, _) | .Live(body, _) | .Transact(_, _, body, _, _) | .Layout(_, _, body, _) -> {
            ast_visit_body(tables, body, visitor, nested_expression)
        }
        .Unsafe(_, reason, body, _) | .Impure(_, reason, body, _) -> {
            if reason == .Val(value) -> ast_visit_expr(tables, value, visitor)
            ast_visit_body(tables, body, visitor, nested_expression)
        }
        .CountedLoop(init, condition, step, body, _, _, _) -> {
            ast_visit_expr(tables, init.init, visitor)
            ast_visit_expr(tables, condition, visitor)
            if step == .Val(value) -> ast_visit_statement(tables, value, visitor, nested_expression)
            ast_visit_body(tables, body, visitor, nested_expression)
        }
        .TaskGroup(_, _, args, body, _) -> {
            if args.limit == .Val(value) -> ast_visit_expr(tables, value, visitor)
            if args.stack == .Val(value) -> ast_visit_expr(tables, value, visitor)
            ast_visit_body(tables, body, visitor, nested_expression)
        }
        .ContextBlock(fields, body, _) -> {
            loop field in fields -> ast_visit_expr(tables, field.value, visitor)
            ast_visit_body(tables, body, visitor, nested_expression)
        }
        .AssumeDet(_, reason, body, _) -> {
            ast_visit_expr(tables, reason, visitor)
            ast_visit_body(tables, body, visitor, nested_expression)
        }
        .ComptimeIf(condition, _, then_body, else_body, _, _) -> {
            ast_visit_expr(tables, condition, visitor)
            ast_visit_body(tables, then_body, visitor, nested_expression)
            if else_body == .Val(body) -> ast_visit_body(tables, body, visitor, nested_expression)
        }
        .ScopeMember(_, _, args, _, body, _, _, _) -> {
            loop argument in args -> ast_visit_expr(tables, argument, visitor)
            ast_visit_body(tables, body, visitor, nested_expression)
        }
        .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> {}
    }
}
