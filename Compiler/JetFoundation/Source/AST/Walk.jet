// Rust Expr/Stmt preorder visitor, reused from origin/port/compiler.
// A visit reads the original checked parser node; no source-text discovery.
pub trait ASTExprVisitor { fn visit(&self, expression: Expr) Never! }
pub fn ast_expr_for_each_expr<V: ASTExprVisitor>(expression: Expr, visitor: &V) Never! {
    &visitor.visit(expression)
    if expression == {
        .Str(parts, _) -> loop part in parts { if part == .Interp(value, _) -> ast_expr_for_each_expr<V>(value, &visitor) }
        .ListLit(values, _) | .CompareChain(values, _, _, _) -> loop value in values -> ast_expr_for_each_expr<V>(value, &visitor)
        .MemberSpread(value, _, _) | .Spread(value, _) | .Deref(value, _) | .RawOf(value, _) | .Copy(value, _) | .Place(value, _, _) | .Field(value, _, _) | .OptField(value, _, _, _, _) | .Present(value, _) | .Ok(value, _) | .Err(value, _) | .Paren(value, _) | .Unary(_, value, _) | .Tainted(value, _, _) -> ast_expr_for_each_expr<V>(value, &visitor)
        .Try(value, _, _, note) -> {
            ast_expr_for_each_expr<V>(value, &visitor)
            if note == .Val(value) -> ast_expr_for_each_expr<V>(value, &visitor)
        }
        .MapLit(entries, _) -> loop entry in entries {
            ast_expr_for_each_expr<V>(entry.key, &visitor)
            ast_expr_for_each_expr<V>(entry.value, &visitor)
        }
        .Index(base, index, _, _) -> {
            ast_expr_for_each_expr<V>(base, &visitor)
            ast_expr_for_each_expr<V>(index, &visitor)
        }
        .Slice(base, start, end, range, _) -> {
            ast_expr_for_each_expr<V>(base, &visitor)
            ast_expr_for_each_expr<V>(start, &visitor)
            ast_expr_for_each_expr<V>(end, &visitor)
            if range == .Val(value) -> ast_expr_for_each_expr<V>(value, &visitor)
        }
        .Range(left, right, _, _) | .Binary(_, left, right, _) -> {
            ast_expr_for_each_expr<V>(left, &visitor)
            ast_expr_for_each_expr<V>(right, &visitor)
        }
        .Call(call) -> ast_visit_call_args<V>(call.args, &visitor)
        .MethodCall(receiver, _, _, _, _, args, _, _, _, _) | .OptMethodCall(receiver, _, _, _, args, _) | .CallValue(receiver, args, _) -> {
            ast_expr_for_each_expr<V>(receiver, &visitor)
            ast_visit_call_args<V>(args, &visitor)
        }
        .StructLit(_, _, _, _, fields, _, _) -> loop field in fields -> ast_expr_for_each_expr<V>(field.value, &visitor)
        .TypedLit(_, body, _) -> if body == {
            .Fields(fields) -> loop field in fields -> ast_expr_for_each_expr<V>(field.value, &visitor)
            .Elements(values) -> loop value in values -> ast_expr_for_each_expr<V>(value, &visitor)
            .Entries(entries) -> loop entry in entries {
                ast_expr_for_each_expr<V>(entry.key, &visitor)
                ast_expr_for_each_expr<V>(entry.value, &visitor)
            }
            .Value(value) -> ast_expr_for_each_expr<V>(value, &visitor)
            .ByteText(_) | .Empty -> {}
        }
        .EnumLit(_, _, _, args, _, _) -> loop argument in args {
            if argument == { .Positional(value) | .Named(_, value) -> ast_expr_for_each_expr<V>(value, &visitor) }
        }
        .PatternTest(subject, pattern, _) -> {
            ast_expr_for_each_expr<V>(subject, &visitor)
            ast_visit_pattern<V>(pattern, &visitor)
        }
        .OrFallback(value, fallback, _, _) -> {
            ast_expr_for_each_expr<V>(value, &visitor)
            ast_visit_fallback<V>(fallback, &visitor)
        }
        .If(condition, then_body, then_value, else_body, else_value, _) -> {
            ast_expr_for_each_expr<V>(condition, &visitor)
            ast_visit_body<V>(then_body, &visitor, true)
            ast_expr_for_each_expr<V>(then_value, &visitor)
            ast_visit_body<V>(else_body, &visitor, true)
            ast_expr_for_each_expr<V>(else_value, &visitor)
        }
        .TupleLit(fields, _, _) -> loop field in fields -> ast_expr_for_each_expr<V>(field.value, &visitor)
        .Lambda(lambda) -> if lambda.body == {
            .Expr(value) -> ast_expr_for_each_expr<V>(value, &visitor)
            .Block(body) -> ast_visit_body<V>(body, &visitor, true)
        }
        .PtrFromAddr(_, _, _, address, _) -> ast_expr_for_each_expr<V>(address, &visitor)
        else -> {}
    }
}
pub fn ast_stmt_for_each_expr<V: ASTExprVisitor>(statement: Stmt, visitor: &V) Never! {
    ast_visit_statement<V>(statement, &visitor, false)
}
fn ast_visit_body<V: ASTExprVisitor>(body: [Stmt], visitor: &V, nested_expression: Bool) Never! {
    loop statement in body -> ast_visit_statement<V>(statement, &visitor, nested_expression)
}
fn ast_visit_call_args<V: ASTExprVisitor>(args: [CallArg], visitor: &V) Never! {
    loop argument in args -> ast_expr_for_each_expr<V>(argument.expr, &visitor)
}
fn ast_visit_pattern<V: ASTExprVisitor>(pattern: Pattern, visitor: &V) Never! {
    if pattern == {
        .Or(alternatives, _) -> loop alternative in alternatives -> ast_visit_pattern<V>(alternative, &visitor)
        .Struct(fields, _, _) -> loop field in fields { if field == .Value(_, _, value) -> ast_expr_for_each_expr<V>(value, &visitor) }
        else -> {}
    }
}
fn ast_visit_fallback<V: ASTExprVisitor>(fallback: OrFallback, visitor: &V) Never! {
    if fallback == {
        .Value(value) -> ast_expr_for_each_expr<V>(value, &visitor)
        .Block(body, value, _) -> {
            ast_visit_body<V>(body, &visitor, true)
            if value == .Val(value) -> ast_expr_for_each_expr<V>(value, &visitor)
        }
        .Return(value, _) -> if value == .Val(value) -> ast_expr_for_each_expr<V>(value, &visitor)
        .Panic(_, args) -> ast_visit_call_args<V>(args, &visitor)
        else -> {}
    }
}
fn ast_visit_statement<V: ASTExprVisitor>(statement: Stmt, visitor: &V, nested_expression: Bool) Never! {
    if statement == {
        .Expr(expression) | .DeferClose(expression, _) -> ast_expr_for_each_expr<V>(expression, &visitor)
        .Val(binding) -> {
            ast_expr_for_each_expr<V>(binding.init, &visitor)
            if nested_expression && binding.pattern == .Val(.Refutable(pattern, fallback, _, _, _)) {
                ast_visit_pattern<V>(pattern, &visitor)
                ast_visit_fallback<V>(fallback, &visitor)
            }
        }
        .Assign(target, _, _, value) -> {
            if target == {
                .Index(base, index, _, _) -> {
                    ast_expr_for_each_expr<V>(base, &visitor)
                    ast_expr_for_each_expr<V>(index, &visitor)
                }
                .Field(base, _, _) -> ast_expr_for_each_expr<V>(base, &visitor)
                else -> {}
            }
            ast_expr_for_each_expr<V>(value, &visitor)
        }
        .Return(value, _) -> if value == .Val(value) -> ast_expr_for_each_expr<V>(value, &visitor)
        .While(condition, body, _, _, _) -> {
            ast_expr_for_each_expr<V>(condition, &visitor)
            ast_visit_body<V>(body, &visitor, nested_expression)
        }
        .For(_, _, _, kind, body, _, _, _, _) -> {
            if kind == {
                .Range(start, end, step, _) -> {
                    ast_expr_for_each_expr<V>(start, &visitor)
                    ast_expr_for_each_expr<V>(end, &visitor)
                    if step == .Val(value) -> ast_expr_for_each_expr<V>(value, &visitor)
                }
                .In(collection, step) -> {
                    ast_expr_for_each_expr<V>(collection, &visitor)
                    if step == .Val(value) -> ast_expr_for_each_expr<V>(value, &visitor)
                }
            }
            ast_visit_body<V>(body, &visitor, nested_expression)
        }
        .Switch(subject, arms, else_body, _) | .ComptimeSwitch(subject, arms, else_body, _) -> {
            ast_expr_for_each_expr<V>(subject, &visitor)
            loop arm in arms {
                ast_expr_for_each_expr<V>(arm.cond, &visitor)
                ast_visit_body<V>(arm.body, &visitor, nested_expression)
            }
            if else_body == .Val(body) -> ast_visit_body<V>(body, &visitor, nested_expression)
        }
        .BreakValue(value, _) | .Yield(value, _) | .BreakLabelValue(_, _, value, _) -> ast_expr_for_each_expr<V>(value, &visitor)
        .Loop(body, _, _, _) | .Reactive(body, _) | .Shield(body, _) | .Switched(_, body, _) | .Region(_, _, body, _) | .Policy(_, body, _) | .AuthorityScope(_, _, _, body, _) | .ComptimeBlock(body, _, _) | .Live(body, _) | .Transact(_, _, body, _, _) | .Layout(_, _, body, _) -> ast_visit_body<V>(body, &visitor, nested_expression)
        .Unsafe(_, reason, body, _) | .Impure(_, reason, body, _) -> {
            if reason == .Val(value) -> ast_expr_for_each_expr<V>(value, &visitor)
            ast_visit_body<V>(body, &visitor, nested_expression)
        }
        .CountedLoop(init, condition, step, body, _, _, _) -> {
            ast_expr_for_each_expr<V>(init.init, &visitor)
            ast_expr_for_each_expr<V>(condition, &visitor)
            if step == .Val(value) -> ast_visit_statement<V>(value, &visitor, nested_expression)
            ast_visit_body<V>(body, &visitor, nested_expression)
        }
        .TaskGroup(_, _, limit, body, _) -> {
            if limit == .Val(value) -> ast_expr_for_each_expr<V>(value, &visitor)
            ast_visit_body<V>(body, &visitor, nested_expression)
        }
        .ContextBlock(fields, body, _) -> {
            loop field in fields -> ast_expr_for_each_expr<V>(field.value, &visitor)
            ast_visit_body<V>(body, &visitor, nested_expression)
        }
        .AssumeDet(_, reason, body, _) -> {
            ast_expr_for_each_expr<V>(reason, &visitor)
            ast_visit_body<V>(body, &visitor, nested_expression)
        }
        .ComptimeIf(condition, _, then_body, else_body, _, _) -> {
            ast_expr_for_each_expr<V>(condition, &visitor)
            ast_visit_body<V>(then_body, &visitor, nested_expression)
            if else_body == .Val(body) -> ast_visit_body<V>(body, &visitor, nested_expression)
        }
        .ScopeMember(_, _, args, _, body, _, _, _) -> {
            loop argument in args -> ast_expr_for_each_expr<V>(argument, &visitor)
            ast_visit_body<V>(body, &visitor, nested_expression)
        }
        else -> {}
    }
}
