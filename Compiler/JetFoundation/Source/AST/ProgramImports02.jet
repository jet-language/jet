// Rust: crates/jet-foundation/src/AST/program_imports.rs:9
// Program, FencedStatement, FencedNames, AppliedRuleApplication, ImportDecl,
// InlineVersion and ImportBinding are canonically owned by Items.jet.

// Rust: crates/jet-foundation/src/AST/program_imports.rs:116
pub enum CoreListPath {
    Module(module: String)
    Item(module: String, item: String)
}

// Rust: crates/jet-foundation/src/AST/program_imports.rs:128
pub fn core_list_prefix(module_alias: String) -> String? Never! {
    if !module_alias.starts_with(Syntax.CORE_SHORT) -> return None
    rest := module_alias.after(Syntax.CORE_SHORT) // #4303
    if rest.is_empty() || rest.starts_with(".") -> return Val("{Syntax.CORE_SHORT}{rest}")
    None
}

// Rust: crates/jet-foundation/src/AST/program_imports.rs:136
pub fn core_list_path(module_alias: String, member: String) -> CoreListPath? Never! {
    prefix :: core_list_prefix(module_alias) ?? return None
    full :: "{prefix}.{member}"
    if Syntax.is_known_core_module(full) -> return Val(CoreListPath.Module(full))
    parts :: full.split(".")
    split := parts.len() - 1
    loop split >= 1 {
        module :: parts[0..<split].join(".")
        if Syntax.is_known_core_module(module) {
            item :: parts[split..<parts.len()].join(".")
            if !item.is_empty() -> return Val(CoreListPath.Item(module, item))
        }
        split -= 1
    }
    None
}

// Rust: crates/jet-foundation/src/AST/program_imports.rs:162
pub fn target_profile_path(import: ImportDecl) -> String? Never! {
    if import.kind == .Module(name, _) {
        if name == "board.sensor_v1" || name == "board.virt_aarch64" -> return Val(name)
    }
    None
}

// Rust: crates/jet-foundation/src/AST/program_imports.rs:175
pub fn core_import_maps(imports: [ImportDecl]) -> ([String:String], [String:String]) Never! {
    modules := [String:String]{}
    items := [String:String]{}
    loop import in imports {
        if (import.core_module_path() ?? target_profile_path(import)) == .Val(module) {
            modules[import_alias(import)] = module
        }
        if import.kind == .Unqualified(module_alias, _, _, _, _) {
            if core_list_prefix(module_alias) == .None -> continue
            loop binding in import_walk_bindings(import) {
                if binding.original == .Val(original) {
                    if core_list_path(module_alias, original) == {
                        .Val(.Module(module)) -> modules[binding.local] = module
                        .Val(.Item(module, item)) -> {
                            modules[binding.local] = module
                            items[binding.local] = item
                        }
                        .None -> {}
                    }
                }
            }
        }
    }
    (modules, items)
}

// Rust: crates/jet-foundation/src/AST/program_imports.rs:212
pub fn rewrite_core_item_call(expr: &Expr, method: String) Never! {
    if expr == .Call(_) {
        span :: expr.span()
        previous :: &expr.replace(Expr.Absent(span))
        if previous == .Call(call) {
            expr = Expr.MethodCall(Expr.Ident(^call.name, call.name_span), method,
                call.name_span, [], ^call.type_args, ^call.args, None,
                ^call.resolved_ret, None, false)
        } else -> unreachable("Core item rewrite checked the expression shape")
    }
}

// Rust: crates/jet-foundation/src/AST/program_imports.rs:237
// member_import_local and ImportBinding::path use Items.jet's canonical
// member_import_local and import_binding_path projections.

// Rust: crates/jet-foundation/src/AST/program_imports.rs:283
#Error
pub struct ForeignImportError {
    pub path: String
    pub language: ForeignLanguage
    pub span: Span
}
impl ForeignImportError {
    // Rust: crates/jet-foundation/src/AST/program_imports.rs:290
    pub fn diagnostic(self) -> Diagnostic Never! {
        root :: self.language.root()
        Diagnostic.error("E0611", "`{self.path}` is not a foreign library namespace",
            "foreign imports have exactly one library segment after the `{root}` language root",
            "write `use {root}.[library]` or `use {root}.library as alias`", Val(self.span))
    }
}

// Rust: crates/jet-foundation/src/AST/program_imports.rs:304
// import_alias and walk_bindings are Items.jet's import_alias and
// import_walk_bindings, shared with existing consumers rather than duplicated.
impl ImportDecl {
    // Rust: crates/jet-foundation/src/AST/program_imports.rs:324
    pub fn core_module_path(self) -> String? Never! {
        if self.kind == .Module(name, _) {
            if name == Syntax.CORE_SHORT || name == Syntax.CORE_CANONICAL || name == "app" || name.starts_with("core.") -> return Val(name)
        }
        None
    }

    // Rust: crates/jet-foundation/src/AST/program_imports.rs:392
    pub fn foreign_imports(self) -> [(ForeignNamespace, String)] ForeignImportError! {
        if self.kind == .File(_, _) -> return Ok([])
        imports := [(ForeignNamespace, String)]{}
        loop binding in import_walk_bindings(self) {
            path :: import_binding_path(binding)
            parts :: path.split(".")
            language :: ForeignLanguage.from_root(parts[0]) ?? continue
            namespace :: ForeignNamespace.from_module_path(path) ?? return Err(ForeignImportError{path: path, language: language, span: binding.import_span})
            &imports.push((namespace, binding.local))
        }
        Ok(imports)
    }

    // Rust: crates/jet-foundation/src/AST/program_imports.rs:416
    pub fn is_c_import(self) -> Bool ForeignImportError! {
        if self.kind == .File(path, _) -> return Ok(path.ends_with(".h"))
        imports :: self.foreign_imports()?
        loop (namespace, _) in imports {
            if namespace.language == ForeignLanguage.C -> return Ok(true)
        }
        Ok(false)
    }
}

// Rust: crates/jet-foundation/src/AST/program_imports.rs:434
// ForeignLanguage and its ALL/root/from_root/bindings_subdir vocabulary are
// canonically owned by ForeignLanguage.jet (ALL is the all() projection).

// Rust: crates/jet-foundation/src/AST/program_imports.rs:550
pub struct ForeignNamespace {
    pub language: ForeignLanguage
    pub lib: String
}
impl ForeignNamespace {
    // Rust: crates/jet-foundation/src/AST/program_imports.rs:557
    pub fn from_module_path(path: String) -> ForeignNamespace? Never! {
        parts :: path.split(".")
        if parts.len() != 2 || parts[1].is_empty() -> return None
        language :: ForeignLanguage.from_root(parts[0]) ?? return None
        Val(ForeignNamespace{language: language, lib: parts[1]})
    }

    // Rust: crates/jet-foundation/src/AST/program_imports.rs:570
    pub fn display(self) -> String Never! {
        "{self.language.root()}.{self.lib}"
    }
}

