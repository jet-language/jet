//RS     pub is_pub: bool,
//RS     /// D-PUBPKG1=A: true for `pub(package) use …` — package-scoped re-export.
//RS     pub is_package_pub: bool,
//RS     /// U11 (D-JPK-SCRIPTDEP1=A): the `#version` selector on `use pkg#version;` —
//RS     /// an inline script dependency. Only ever `Some` for a single-segment
//RS     /// `ImportKind::Module` (no dotted path); a manifest-less entry file's
//RS     /// `Loader` pass resolves these (crate::Jetpack::ScriptDeps). `None` for
//RS     /// every ordinary import, and ignored (kept for round-trip only) once a
//RS     /// project has a `pkg.jet` — deps then come from the manifest.
//RS     pub inline_version: Option<InlineVersion>,
//RS }
