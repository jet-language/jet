//RS #[derive(Debug, Clone, PartialEq, Eq)]
//RS pub enum TryConvert {
//RS     /// Error types match exactly — no conversion needed.
//RS     None,
//RS     /// The source carrier has `Never` as its error side. Sema proved that
//RS     /// this propagation site has no reachable failure route; lowering only
//RS     /// unwraps the shared carrier and never converts or reports an error.
//RS     Never,
//RS     /// D-FAIL-ERROR1=A: a legacy string-shaped failure becomes the default
//RS     /// `Err` value at the propagation seam.
//RS     DefaultErr,
//RS     /// Declared `impl Source -> Target { … }` conversion (D-ERR-CONV).
//RS     /// Holds the mangled Rust function name and the exact sema-resolved error
//RS     /// types carried into TIR.
//RS     Typed {
//RS         fn_name: String,
//RS         source: Type,
//RS         target: Type,
//RS     },
//RS     /// D-UNIONTYPE1=A: source error is one member of the return's anonymous union.
//RS     /// Codegen wraps with the canonical `__jet_<enum>::__jet_<tag>(e)` path.
