// Rust: crates/jet-foundation/src/ResourceSchedule.rs:437
fn frame_retention_guards(schedule: FrameSchedule) -> ([String:[JetFrameRetentionGuard]], [String:Bool]) Never! {
    guards := [String:[JetFrameRetentionGuard]]{}
    loop retention in schedule.retentions {
        if retention.completion_token == .Val(token) {
            if !guards.contains_key(token) -> guards[token] = []
            &guards[token].push(JetFrameRetentionGuard.new(~retention.resource, ~retention.owner))
        }
    }
    resources := [String:Bool]{}
    loop group in guards.values() {
        loop guard in group { if guard.is_live() -> resources[guard.resource] = true }
    }
    (^guards, ^resources)
}
