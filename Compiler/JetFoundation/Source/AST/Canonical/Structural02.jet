}
// Rust: crates/jet-foundation/src/ResourceSchedule.rs:715
pub fn signal_frame_completion_in(state: Arc<Mutex<JetFrameCompletionState>>, provider: String) Err! {
    guard := state.lock().map_err(fn(_) { "checked frame completion state is poisoned" })? // GATE #4494
    &guard.complete_from_provider(provider)
}
// Rust: crates/jet-foundation/src/ResourceSchedule.rs:725
pub fn signal_frame_completion_binding_in(state: Arc<Mutex<JetFrameCompletionState>>, provider: String, token: String, generation: U64) Err! {
    guard := state.lock().map_err(fn(_) { "checked frame completion state is poisoned" })? // GATE #4494
    if guard.generation != generation -> return Err("completion token `{token}` belongs to stale frame generation {generation}")
    schedule :: guard.schedule ?? return Err("completion state has no checked frame schedule")
    event := FrameOperation?{None}
    loop operation in schedule.operations {
        if operation.completion == .Event(event_token) && event_token == token { event = Val(operation); break }
    }
    checked :: event ?? return Err("completion token `{token}` is not in the checked schedule")
    if checked.completion_provider != Val(provider) {
        actual :: checked.completion_provider ?? "<none>"
        return Err("completion token `{token}` belongs to provider `{actual}` not `{provider}`")
    }
    if !guard.bound_tokens.contains_key(token) -> return Err("completion token `{token}` was signalled without a checked submission")
    &guard.complete(schedule.as_ref(), token)
}
