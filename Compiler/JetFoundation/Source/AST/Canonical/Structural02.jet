    provider :: if o.completion_provider == .Val(value) -> ",\"completion_provider\":{json_string(value)}" else -> ""
    "{{\"name\":{json_string(o.name)},\"source_index\":{json_number(o.source_index)},\"accesses\":[{accesses}],\"completion\":{encode_completion(o.completion)},\"external_effect\":{o.external_effect}{provider}}}"
}
