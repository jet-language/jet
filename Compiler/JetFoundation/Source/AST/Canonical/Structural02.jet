// Rust: crates/jet-foundation/src/ResourceSchedule.rs:1009
fn encode_completion(completion: FrameCompletion) -> String Never! {
    if completion == {
        .Synchronous -> "{{\"kind\":\"synchronous\"}}"
        .Pending(token) -> "{{\"kind\":\"pending\",\"token\":{json_string(token)}}}"
        .Event(token) -> "{{\"kind\":\"event\",\"token\":{json_string(token)}}}"
    }
}
// Rust: crates/jet-foundation/src/ResourceSchedule.rs:1023
fn encode_operation(o: FrameOperation) -> String Never! {
