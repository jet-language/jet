// Rust: crates/jet-foundation/src/ResourceSchedule.rs:618
pub fn with_frame_completion_scope<T>(state: Arc<Mutex<JetFrameCompletionState>>, body: fn() -> T) -> T {
    // GATE #4494: TLS plus unwind restoration, not a frame-end completion sweep.
    FRAME_COMPLETION_STATE.with(fn(active) {
        guard := state.lock().expect("checked frame completion state is poisoned")
        &guard.begin_frame()
        drop(^guard)
        previous :: active.replace(Val(state))
        result :: catch_unwind(AssertUnwindSafe(body))
        _ :: active.replace(previous)
        if result == { .Ok(value) -> value, .Err(payload) -> resume_unwind(payload) }
    })
}
