// Rust: crates/jet-foundation/src/ResourceSchedule.rs:1321
#Error
pub enum JetFrameScheduleError {
    InvalidOperation(index: Int, reason: String)
    InvalidAccess(operation: String, resource: String, reason: String)
    NonMonotonicSourceOrder(index: Int, previous: Int, current: Int)
    ConflictingAccess(before: String, after: String, resource: String, before_mode: ResourceAccessMode, after_mode: ResourceAccessMode)
    UnknownAlias(before: String, after: String)
    MissingCompletion(operation: String, resource: String, token: String)
}
impl JetFrameScheduleError {
    // Rust: crates/jet-foundation/src/ResourceSchedule.rs:1356
    pub fn fmt(self) -> String Never! {
        if self == {
            .InvalidOperation(index, reason) -> "operation {index} is invalid: {reason}"
            .InvalidAccess(operation, resource, reason) -> "operation `{operation}` has invalid access to `{resource}`: {reason}"
            .NonMonotonicSourceOrder(index, previous, current) -> "operation {index} source index {current} follows {previous} out of order"
            .ConflictingAccess(before, after, resource, before_mode, after_mode) -> "parallel frame refused: `{before}` {before_mode.as_str()} `{resource}` before `{after}` {after_mode.as_str()} it"
            .UnknownAlias(before, after) -> "parallel frame refused: `{before}` and `{after}` have unresolved aliasing"
            .MissingCompletion(operation, resource, token) -> "operation `{operation}` accesses `{resource}` before completion event `{token}`"
        }
    }
}
// Rust: crates/jet-foundation/src/ResourceSchedule.rs:1406
pub fn derive_frame_schedule(operations: [FrameOperation]) -> FrameSchedule JetFrameScheduleError! {
    derive_frame_schedule_with_options(operations, JetFrameScheduleOptions.serial())
}
// Rust: crates/jet-foundation/src/ResourceSchedule.rs:1415
pub fn derive_frame_schedule_with_options(operations: [FrameOperation], options: JetFrameScheduleOptions) -> FrameSchedule JetFrameScheduleError! {
    validate_operations(operations)?
    events :: completion_events(operations)?
    dependencies := [FrameDependency]{}
    dependency_keys := [(Int,Int,String):Bool]{}
    transfers := [FrameTransfer]{}
    transfer_keys := [(Int,Int,String):Bool]{}
    conservative := [String]{}
    loop li in 0..<operations.len() {
        left :: operations[li]
        loop ri in (li + 1)..<operations.len() {
            right :: operations[ri]
            loop la in left.accesses {
                loop ra in right.accesses {
                    if !la.resource.overlaps(ra.resource) || !la.region.overlaps(ra.region) -> continue
                    unknown :: la.resource == .Unknown || ra.resource == .Unknown
                    conflict :: la.mode.is_write() || ra.mode.is_write()
                    if unknown {
                        if options.permit_parallel && conflict -> return Err(.UnknownAlias(left.name, right.name))
                        &conservative.push("{left.name} and {right.name} keep source order because aliasing is unknown")
                        if !conflict -> push_dependency(&dependencies, &dependency_keys, li, ri, "unknown resource", "unknown aliasing")
                    }
                    if conflict {
                        if options.permit_parallel -> return Err(.ConflictingAccess(left.name, right.name, la.label(), la.mode, ra.mode))
                        resource :: if unknown -> "unknown resource" else -> la.label()
                        push_dependency(&dependencies, &dependency_keys, li, ri, resource, "{left.name} {la.mode.as_str()} -> {right.name} {ra.mode.as_str()}")
                    }
                    if (la.resource, la.layout, ra.layout) == (.Named(resource), .Val(ll), .Val(rl)) {
                        key :: (li, ri, resource)
                        if !ll.device.is_empty() && !rl.device.is_empty() && ll.device != rl.device && !transfer_keys.contains_key(key) {
                            transfer_keys[key] = true
                            &transfers.push(FrameTransfer{before: li, after: ri, resource: ~resource, from_device: ~ll.device, to_device: ~rl.device})
                        }
                    }
                }
            }
            if left.external_effect || right.external_effect -> push_dependency(&dependencies, &dependency_keys, li, ri, "external effect", "visible external effects preserve source order")
        }
    }
    retentions :: derive_retentions(operations, events)
    ensure_async_uses_complete(operations, events, &dependencies, &dependency_keys)?
    reuse :: derive_reuse(operations, events, &conservative)
    &dependencies.sort_by(fn(a, b) { (a.before, a.after, a.resource, a.reason).cmp((b.before, b.after, b.resource, b.reason)) })
    &transfers.sort_by(fn(a, b) { (a.before, a.after, a.resource, a.from_device, a.to_device).cmp((b.before, b.after, b.resource, b.from_device, b.to_device)) })
    &conservative.sort()
    &conservative.dedup()
    FrameSchedule{operations: ~operations, dependencies: ^dependencies, transfers: ^transfers, reuse: ^reuse, retentions: ^retentions, conservative: ^conservative}
}
// Rust: crates/jet-foundation/src/ResourceSchedule.rs:1574
fn validate_operations(operations: [FrameOperation]) JetFrameScheduleError! {
    previous_source := Int?{None}
    loop index in 0..<operations.len() {
        operation :: operations[index]
        name := operation.name.trim() // #4303
        if name.is_empty() -> return Err(.InvalidOperation(index, "checked operation name must not be empty"))
        if previous_source == .Val(previous) {
            if operation.source_index < previous -> return Err(.NonMonotonicSourceOrder(index, previous, operation.source_index))
        }
        previous_source = Val(operation.source_index)
        if operation.completion == {
            .Pending(token) | .Event(token) -> {
                text := token.trim() // #4303
                if text.is_empty() -> return Err(.InvalidOperation(index, "completion token must not be empty"))
            }
            else -> {}
        }
        loop access in operation.accesses {
            if access.resource == .Named(resource) {
                text := resource.trim() // #4303
                if text.is_empty() -> return Err(.InvalidAccess(operation.name, resource, "resource identity must not be empty"))
            }
            access.region.validate(operation.name, access.label())?
            if access.layout == .Val(layout) -> layout.validate(operation.name, access.label())?
        }
    }
}
// Rust: crates/jet-foundation/src/ResourceSchedule.rs:1625
fn completion_events(operations: [FrameOperation]) -> [String:Int] JetFrameScheduleError! {
    events := [String:Int]{}
    loop index in 0..<operations.len() {
        if operations[index].completion == .Event(token) {
            if events.get(token) == .Val(previous) -> return Err(.InvalidOperation(index, "completion token `{token}` has duplicate events at {previous} and {index}"))
            events[token] = index
        }
    }
    loop index in 0..<operations.len() {
        operation :: operations[index]
        if operation.completion != .Pending(token) -> continue
        resource :: if operation.accesses.is_empty() -> "unknown resource" else -> operation.accesses[0].label()
        event :: events.get(token) ?? return Err(.MissingCompletion(operation.name, resource, token))
        if event <= index -> return Err(.MissingCompletion(operation.name, resource, token))
    }
    ^events
}
// Rust: crates/jet-foundation/src/ResourceSchedule.rs:1673
fn push_dependency(dependencies: &[FrameDependency], keys: &[(Int,Int,String):Bool], before: Int, after: Int, resource: String, reason: String) Never! {
    key :: (before, after, resource)
    if !keys.contains_key(key) {
        keys[key] = true
        &dependencies.push(FrameDependency{before: before, after: after, resource: ~resource, reason: ~reason})
    }
}
// Rust: crates/jet-foundation/src/ResourceSchedule.rs:1691
fn ensure_async_uses_complete(operations: [FrameOperation], events: [String:Int], dependencies: &[FrameDependency], keys: &[(Int,Int,String):Bool]) JetFrameScheduleError! {
    loop index in 0..<operations.len() {
        operation :: operations[index]
        if operation.completion != .Pending(token) -> continue
        resource :: if operation.accesses.is_empty() -> "unknown resource" else -> operation.accesses[0].label()
        event_index :: events.get(token) ?? return Err(.MissingCompletion(operation.name, resource, token))
        if event_index <= index -> continue
        push_dependency(&dependencies, &keys, index, event_index, "completion", "{operation.name} completes at event {token}")
        loop later_index in (event_index + 1)..<operations.len() {
            loop access in operations[later_index].accesses {
                if operation.accesses.iter().any(fn(submitted) { submitted.resource.overlaps(access.resource) && submitted.region.overlaps(access.region) }) {
                    push_dependency(&dependencies, &keys, event_index, later_index, "completion", "event {token} releases submitted owners")
                }
            }
        }
    }
    loop index in 0..<operations.len() {
        operation :: operations[index]
        loop access in operation.accesses {
            loop pending_index in 0..<index {
                pending :: operations[pending_index]
                if pending.completion != .Pending(token) -> continue
                overlaps :: pending.accesses.iter().any(fn(submitted) { submitted.resource.overlaps(access.resource) && submitted.region.overlaps(access.region) })
                if !overlaps -> continue
                if events.get(token) == .Val(event_index) && event_index < index -> continue
                return Err(.MissingCompletion(operation.name, access.label(), token))
            }
        }
    }
}
// Rust: crates/jet-foundation/src/ResourceSchedule.rs:1774
fn derive_retentions(operations: [FrameOperation], events: [String:Int]) -> [FrameRetention] Never! {
    retentions := [FrameRetention]{}
    loop index in 0..<operations.len() {
        operation :: operations[index]
        if operation.completion != .Pending(token) -> continue
        completed :: if events.get(token) == .Val(event) -> event > index else -> false
        loop access in operation.accesses -> &retentions.push(FrameRetention{resource: ~access.label(), operation: index, owner: ~operation.name, completion_token: Val(~token), completed: completed})
    }
    ^retentions
}
// Rust: crates/jet-foundation/src/ResourceSchedule.rs:1797
struct ResourceUse {
    resource: String
    first: Int
    last: Int
    temporary: Bool
    layouts: [ResourceLayout?]
}
// Rust: crates/jet-foundation/src/ResourceSchedule.rs:1806
fn derive_reuse(operations: [FrameOperation], events: [String:Int], conservative: &[String]) -> [FrameReuse] Never! {
    uses := [String:ResourceUse]{}
    loop index in 0..<operations.len() {
        loop access in operations[index].accesses {
            if access.resource != .Named(resource) -> continue
            if !uses.contains_key(resource) -> uses[resource] = ResourceUse{resource: ~resource, first: index, last: index, temporary: access.temporary, layouts: []}
            uses[resource].first = uses[resource].first.min(index)
            uses[resource].last = uses[resource].last.max(index)
            uses[resource].temporary = uses[resource].temporary && access.temporary
            &uses[resource].layouts.push(~access.layout)
        }
    }
    names := uses.keys().collect()
    &names.sort()
    candidates := [String]{}
    loop name in names { if uses[name].temporary -> &candidates.push(name) }
    result := [FrameReuse]{}
    loop right_name in candidates {
        right :: uses[right_name]
        left_name := String?{None}
        loop name in candidates {
            candidate :: uses[name]
            if name == right_name || candidate.last >= right.first -> continue
            // Iterator::max_by_key chooses the last key in a tie.
            if left_name == .Val(previous) {
                if candidate.last < uses[previous].last -> continue
            }
            left_name = Val(name)
        }
        selected :: left_name ?? continue
        left :: uses[selected]
        reason :: matching_layout_reason(left, right)
        legal := reason == None
        reason_text := reason ?? "lifetimes do not overlap"
        if legal {
            pending_index := Int?{None}
            loop index in 0..=left.last {
                operation :: operations[index]
                if operation.completion == .Pending(_) && operation.accesses.iter().any(fn(access) { access.resource == .Named(left.resource) }) -> pending_index = Val(index)
            }
            if pending_index == .Val(index) {
                if operations[index].completion == .Pending(token) {
                    completed_at :: events.get(token)
                    ready :: if completed_at == .Val(event) -> event < right.first else -> false
                    if !ready { legal = false; reason_text = "completion event {token} has not occurred" }
                }
            }
        }
        if !legal -> &conservative.push("{left.resource} was not reused for {right.resource}: {reason_text}")
        &result.push(FrameReuse{previous_resource: ~left.resource, next_resource: ~right.resource, previous_last_use: left.last, next_first_use: right.first, legal: legal, reason: ^reason_text})
    }
    &result.sort_by(fn(a, b) { (a.previous_last_use, a.next_first_use, a.previous_resource, a.next_resource).cmp((b.previous_last_use, b.next_first_use, b.previous_resource, b.next_resource)) })
    ^result
}
// Rust: crates/jet-foundation/src/ResourceSchedule.rs:1898
fn matching_layout_reason(left: ResourceUse, right: ResourceUse) -> String? Never! {
    left_layout := ResourceLayout?{None}
    loop layout in left.layouts { if layout == .Val(value) { left_layout = Val(value); break } }
    ll :: left_layout ?? return Val("layout/size/alignment/device facts are incomplete")
    right_layout := ResourceLayout?{None}
    loop layout in right.layouts { if layout == .Val(value) { right_layout = Val(value); break } }
    rl :: right_layout ?? return Val("layout/size/alignment/device facts are incomplete")
    if left.layouts.iter().any(fn(layout) { layout != Val(ll) }) || right.layouts.iter().any(fn(layout) { layout != Val(rl) }) -> return Val("every temporary use needs complete matching layout facts")
    if ll.device.is_empty() || rl.device.is_empty() -> return Val("placement/device facts are incomplete")
    if ll != rl -> return Val("size, alignment, layout, or device differs")
    None
}


// Rust: crates/jet-foundation/src/WebPartition.rs:8 — WebBucket in Items.jet.
impl WebBucket {
