// Rust: crates/jet-foundation/src/ResourceSchedule.rs:655
pub fn bind_frame_completion_in(state: Arc<Mutex<JetFrameCompletionState>>, provider: String) -> JetFrameCompletionHandle Err! {
    guard := state.lock().map_err(fn(_) { "checked frame completion state is poisoned" })? // GATE #4494
    schedule :: guard.schedule ?? return Err("completion state has no checked frame schedule")
    loop operation in schedule.operations {
        if operation.completion != .Pending(token) -> continue
        if operation.completion_provider != Val(provider) || guard.bound_tokens.contains_key(token) -> continue
        event_provider := String?{None}
        loop event in schedule.operations {
            if event.completion == .Event(event_token) && event_token == token {
                if event.completion_provider == .Val(found) { event_provider = Val(found); break }
            }
        }
        if event_provider != Val(provider) -> continue
        guard.bound_tokens[token] = true
        guards :: guard.retention_guards.get(token).cloned() ?? []
        return JetFrameCompletionHandle{state: Arc.clone(state), token: ~token, event_provider: ~provider, generation: guard.generation, guards: ^guards}
    }
    Err("completion provider `{provider}` has no unbound checked submission")
}
// Rust: crates/jet-foundation/src/ResourceSchedule.rs:706
pub fn signal_frame_completion(provider: String) Err! {
