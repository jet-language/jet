        FrameSchedule.from_canonical_json(text)
    }
}
// Rust: crates/jet-foundation/src/ResourceSchedule.rs:936
fn json_string(value: String) -> String Never! {
    out := [U8]{U8{34}}
    loop character in value.chars() {
        if character == {
            '"' -> canonical_ast_write(&out, "\\\"")
            '\\' -> canonical_ast_write(&out, "\\\\")
            '\n' -> canonical_ast_write(&out, "\\n")
            '\r' -> canonical_ast_write(&out, "\\r")
            '\t' -> canonical_ast_write(&out, "\\t")
            '\u{08}' -> canonical_ast_write(&out, "\\b")
            '\u{0c}' -> canonical_ast_write(&out, "\\f")
            else -> if character.is_control() -> canonical_ast_write(&out, "\\u{character.codepoint():04x}") else -> canonical_ast_write(&out, "{character}")
        }
    }
    &out.push(U8{34})
    String.from_bytes(out) ?? panic("JSON writer preserves UTF-8")
}
// Rust: crates/jet-foundation/src/ResourceSchedule.rs:959
fn json_number(value: Int) -> String Never! { json_string("{value}") }
// Rust: crates/jet-foundation/src/ResourceSchedule.rs:963
fn encode_identity(identity: ResourceIdentity) -> String Never! {
    if identity == { .Named(resource) -> "{{\"kind\":\"named\",\"value\":{json_string(resource)}}}", .Unknown -> "{{\"kind\":\"unknown\"}}" }
}
// Rust: crates/jet-foundation/src/ResourceSchedule.rs:973
fn encode_region(region: ResourceRegion) -> String Never! {
    if region == {
        .Whole -> "{{\"kind\":\"whole\"}}"
        .Unknown -> "{{\"kind\":\"unknown\"}}"
        .Bytes(start, length) -> "{{\"kind\":\"bytes\",\"start\":{json_number(start)},\"length\":{json_number(length)}}}"
    }
}
// Rust: crates/jet-foundation/src/ResourceSchedule.rs:985
fn encode_layout(layout: ResourceLayout?) -> String Never! {
    if layout == { .None -> "null", .Val(r) -> "{{\"size\":{json_number(r.size)},\"align\":{json_number(r.align)},\"layout\":{json_string(r.layout)},\"device\":{json_string(r.device)}}}" }
