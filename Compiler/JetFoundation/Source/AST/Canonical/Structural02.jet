impl FrameSchedule {
    // Rust: crates/jet-foundation/src/ResourceSchedule.rs:775
    pub fn explain(self) -> String Never! {
        lines := [String]{"Why did these operations run in order?"}
        loop operation in self.operations {
            accesses := [String]{}
            loop access in operation.accesses -> &accesses.push("{access.mode.as_str()} {access.label()}")
            description :: if accesses.is_empty() -> "no resource access" else -> accesses.join(", ")
            &lines.push("  {operation.name} {description}")
        }
        loop d in self.dependencies -> &lines.push("  dependency: {self.operations[d.before].name} -> {self.operations[d.after].name} ({d.reason})")
        loop t in self.transfers -> &lines.push("  transfer: {t.resource} {t.from_device} -> {t.to_device}")
        loop r in self.reuse {
            verb :: if r.legal -> "reuse" else -> "reuse refused"
            &lines.push("  {verb}: {r.previous_resource} -> {r.next_resource} ({r.reason})")
        }
        loop r in self.retentions {
            state :: if r.completed -> "completed" else -> "still retained"
            token :: r.completion_token ?? "return"
            &lines.push("  retention: {r.resource} owner {r.owner} until {token} ({state})")
        }
        loop reason in self.conservative -> &lines.push("  conservative: {reason}")
        if self.dependencies.is_empty() -> &lines.push("  no conflicting resource accesses")
        lines.join("\n")
    }
    // Rust: crates/jet-foundation/src/ResourceSchedule.rs:835
    pub fn canonical_json(self) -> String Never! {
        operations :: self.operations.iter().map(encode_operation).collect().join(",")
        dependencies :: self.dependencies.iter().map(encode_dependency).collect().join(",")
        transfers :: self.transfers.iter().map(encode_transfer).collect().join(",")
        reuse :: self.reuse.iter().map(encode_reuse).collect().join(",")
        retentions :: self.retentions.iter().map(encode_retention).collect().join(",")
        conservative :: self.conservative.iter().map(json_string).collect().join(",")
        "{{\"schema\":\"jet.frame_schedule/v1\",\"operations\":[{operations}],\"dependencies\":[{dependencies}],\"transfers\":[{transfers}],\"reuse\":[{reuse}],\"retentions\":[{retentions}],\"conservative\":[{conservative}]}}"
    }
    // Rust: crates/jet-foundation/src/ResourceSchedule.rs:880
    pub fn from_canonical_json(input: String) -> FrameSchedule Err! {
        value :: parse_json(input, true).map_err(fn(error) { "invalid frame schedule JSON: {error.message}" })?
        root :: json_object(value, "frame schedule")?
        schema :: json_text(json_field(root, "schema")?, "schema")?
        if schema != "jet.frame_schedule/v1" -> return Err("unsupported frame schedule schema `{schema}`")
        operations := [FrameOperation]{}
        loop row in json_array(json_field(root, "operations")?, "operations")? -> &operations.push(parse_operation(row)?)
        dependencies := [FrameDependency]{}
        loop row in json_array(json_field(root, "dependencies")?, "dependencies")? -> &dependencies.push(parse_dependency(row)?)
        transfers := [FrameTransfer]{}
        loop row in json_array(json_field(root, "transfers")?, "transfers")? -> &transfers.push(parse_transfer(row)?)
        reuse := [FrameReuse]{}
        loop row in json_array(json_field(root, "reuse")?, "reuse")? -> &reuse.push(parse_reuse(row)?)
        retentions := [FrameRetention]{}
        loop row in json_array(json_field(root, "retentions")?, "retentions")? -> &retentions.push(parse_retention(row)?)
        conservative := [String]{}
        loop row in json_array(json_field(root, "conservative")?, "conservative")? -> &conservative.push(json_text(row, "conservative reason")?)
        FrameSchedule{operations: ^operations, dependencies: ^dependencies, transfers: ^transfers, reuse: ^reuse, retentions: ^retentions, conservative: ^conservative}
    }
    // Rust: crates/jet-foundation/src/ResourceSchedule.rs:924
    pub fn encode_canonical(self) -> [U8] Never! { self.canonical_json().into_bytes() }
    // Rust: crates/jet-foundation/src/ResourceSchedule.rs:928
    pub fn decode_canonical(bytes: [U8]) -> FrameSchedule Err! {
