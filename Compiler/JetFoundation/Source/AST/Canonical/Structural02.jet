// Rust: crates/jet-foundation/src/WebPartition.rs:32 — WebPartitionMarker in Items.jet.
impl WebPartitionMarker {
    // Rust: crates/jet-foundation/src/WebPartition.rs:39
    pub fn bucket(self) -> WebBucket Never! { if self == { .Wasm | .WasmExport -> .Wasm, .JS -> .JS } }
    // Rust: crates/jet-foundation/src/WebPartition.rs:51
    pub fn name(self) -> String Never! {
        if self == { .Wasm -> "Target(Wasm)", .JS -> "Target(JS)", .WasmExport -> Syntax.MARKER_WASM_EXPORT }
    }
}
// Rust: crates/jet-foundation/src/WebPartition.rs:64
pub fn partition_key(file_prefix: String?, module_prefix: String?, fn_name: String) -> String Never! {
    if module_prefix == .Val(module) -> return member_name(module, fn_name)
    if file_prefix == .Val(alias) -> member_name(alias, fn_name) else -> fn_name
}
// Rust: crates/jet-foundation/src/WebPartition.rs:78
pub fn partition_effect_key(file_alias: String, local_key: String) -> String Never! { "{file_alias}::{local_key}" }
// Rust: crates/jet-foundation/src/WebPartition.rs:85
pub fn is_abi_safe_type(ty: Type) -> Bool Never! {
    if ty == {
        .Int | .Float | .Bool | .String | .Char | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 -> true
        .Named(name) -> name == "String"
        .List(inner) | .Option(inner) | .Shared(inner) -> is_abi_safe_type(inner)
        .FixedList(elem, _) -> is_abi_safe_type(elem)
        .Map(key, _, value) -> key == .String && is_abi_safe_type(value)
        else -> false
    }
}
// Rust: crates/jet-foundation/src/WebPartition.rs:104
pub fn web_cross_partition(caller: String, callee: String, caller_bucket: WebBucket, callee_bucket: WebBucket, span: Span?) -> Diagnostic Never! {
    Diagnostic.error("E-WEB-CROSS-PARTITION",
        "`{caller}` is compiled to {caller_bucket.name()} but calls `{callee}`, which lives in {callee_bucket.name()}",
        "the web backend keeps DOM/view code in JS and compute in WASM; a direct call across that boundary is not allowed yet",
        "move the call behind a generated bridge, colocate both functions in the same bucket, or adjust their `#{Syntax.MARKER_TARGET}(Wasm|JS)` markers", span)
}
// Rust: crates/jet-foundation/src/WebPartition.rs:129
pub fn web_target_browser(fn_name: String, span: Span?) -> Diagnostic Never! {
    Diagnostic.error("E-WEB-TARGET-BROWSER",
        "`{fn_name}` is pinned to Wasm but uses the `Browser` effect",
        "the web backend keeps DOM/view code in JS and compute in WASM; a Wasm-pinned function cannot call browser APIs directly",
        "remove the `#{Syntax.MARKER_TARGET}(Wasm)` pin, move browser work into a `#{Syntax.MARKER_TARGET}(JS)` function, or drop the browser API calls", span)
}
// Rust: crates/jet-foundation/src/WebPartition.rs:148
pub fn web_abi_type(ty_show: String, context: String, span: Span?) -> Diagnostic Never! {
    Diagnostic.error("E-WEB-ABI-TYPE",
        "`{ty_show}` cannot cross the JS/WASM boundary {context}",
        "web exports and imports only admit ABI-safe types (scalars, `String`, `List`/`Map` of ABI-safe values, and `#[Codable]` structs/enums)",
        "use a scalar, `String`, a `List`/`Map` of ABI-safe values, or a `#[Codable]` struct/enum whose fields are ABI-safe", span)
}

