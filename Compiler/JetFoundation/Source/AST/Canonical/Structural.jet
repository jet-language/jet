// Rust: crates/jet-foundation/src/AST/items.rs::ExternFn (derived Debug field/variant order).
fn canonical_ast_write_extern_fn<P: CanonicalASTDefaultProvider>(out: &[U8], defaults: P, value: ExternFn, clear_callable_bodies: Bool) Never! {
    canonical_ast_write(&out, "ExternFn {{ ")
    canonical_ast_write(&out, "abi: ")
    if value.abi == {
        .Val(v1) -> {
            canonical_ast_write(&out, "Some(")
            canonical_ast_write(&out, "(")
            canonical_ast_write_string(&out, v1.name)
            canonical_ast_write(&out, ", ")
            canonical_ast_write(&out, "Span")
            canonical_ast_write(&out, ")")
