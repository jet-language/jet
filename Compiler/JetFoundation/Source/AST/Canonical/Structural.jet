// Rust CanonicalAST.rs::canonical_fragment; the only AST structural writer.
// Compound carriers are always traversed below. Debug is used only on scalar
// leaves, through the canonical runtime's quoting and numeric formatter.
pub trait CanonicalASTDefaultProvider {
    fn write_default(self, reference: FunctionDefaultRef, out: &[U8]) Never!
}

pub enum CanonicalASTParsedDefaults { Parsed }
impl CanonicalASTParsedDefaults.CanonicalASTDefaultProvider {
    fn write_default(self, reference: FunctionDefaultRef, out: &[U8]) Never! {
        panic("parsed AST cannot contain a checked default-expression reference")
    }
}

// Rust Parser/Expressions/postfix.rs:316–331,367–371. The optional-method
// syntax is CallValue (45) whose callee is OptField (26). This synchronous
// borrowed projection never constructs an Expr or stores/returns a node borrow.
// D/C are caller-owned writable state; N/P/S/M are borrowed caller metadata.
pub trait CanonicalASTOptionalCallVisitor<D, C, N, P, S, M> {
    fn visit_optional_method_call(self, db: &D, context: &C, names: N, program: P, source: S, module_path: M, receiver: Expr, receiver_span: Span, method: String, method_span: Span, type_args: [Type], args: [CallArg], call_span: Span) Never!
}

pub fn canonical_ast_visit_optional_method_call<V: CanonicalASTOptionalCallVisitor<D, C, N, P, S, M>, D, C, N, P, S, M>(expression: Expr, visitor: V, db: &D, context: &C, names: N, program: P, source: S, module_path: M) -> Bool Never! {
    if expression == .OptMethodCall(receiver, method, method_span, type_args, args, _, receiver_span, call_span) {
        visitor.visit_optional_method_call(&db, &context, names, program, source, module_path, receiver, receiver_span, method, method_span, type_args, args, call_span)
        return true
    }
    false
}

fn canonical_ast_write(out: &[U8], text: String) Never! {
    loop byte in text.bytes() -> &out.push(byte)
}
fn canonical_ast_write_string(out: &[U8], value: String) Never! {
    canonical_debug_write_string<[U8], CanonicalDebugBytes>(CanonicalDebugBytes.Writer, &out, value)
}
fn canonical_ast_write_char(out: &[U8], value: Char) Never! {
    canonical_debug_write_char<[U8], CanonicalDebugBytes>(CanonicalDebugBytes.Writer, &out, value)
}
fn canonical_ast_write_f32(out: &[U8], value: Float) Never! {
    // CtFloat.F32 stores the already-narrowed Rust payload as Float in Jet.
    // Restore that native scalar width; the public checked conversion rejects
    // nonfinite values, while all three are legal original f32 Debug payloads.
    narrow :: if {
        value == Float.INFINITY -> F32.INFINITY
        value == Float.NEG_INFINITY -> F32.NEG_INFINITY
        value != value -> F32.NAN
        else -> F32.from_float(value) ?? panic("checked F32 carrier retains a representable float")
    }
    canonical_ast_write(&out, "{narrow:Debug}")
}

// Rust Parser/Expressions/primary.rs:1074: a byte part becomes one Lit char.
fn canonical_ast_byte_char(value: U8) -> String Never! {
    code :: Int.from_u8(value)
    bytes :: if code < 128 -> [U8]{value} else -> [U8]{U8{192 + code /% 64}, U8{128 + code % 64}}
    String.from_bytes(bytes) ?? panic("one Latin-1 scalar has a valid UTF-8 encoding")
}

fn canonical_ast_write_optional_name(out: &[U8], value: NamedSpan?) Never! {
    if value == {
        .None -> canonical_ast_write(&out, "None")
        .Val(named) -> {
            canonical_ast_write(&out, "Some(")
            canonical_ast_write_string(&out, named.name)
            canonical_ast_write(&out, ")")
        }
    }
}
fn canonical_ast_write_optional_span(out: &[U8], value: NamedSpan?) Never! {
    if value == {
        .None -> canonical_ast_write(&out, "None")
        .Val(_) -> canonical_ast_write(&out, "Some(Span)")
    }
}

// Derived CtBigInt/PerformanceBudget::BigInt use normalized base-10^9 limbs.
// Project nine-digit decimal chunks in linear time; never repeatedly divide
// an arbitrary-precision Int or introduce a second bigint arithmetic kernel.
fn canonical_ast_decimal_start(bytes: [U8]) -> Int Never! {
    start := 0
    if bytes.len() > 0 && Int.from_u8(bytes[0]) == 45 -> start = 1
    loop start < bytes.len() && Int.from_u8(bytes[start]) == 48 -> start += 1
    start
}
fn canonical_ast_write_limbs(out: &[U8], bytes: [U8]) Never! {
    start :: canonical_ast_decimal_start(bytes)
    end := bytes.len()
    canonical_ast_write(&out, "[")
    first := true
    loop end > start {
        if !first -> canonical_ast_write(&out, ", ")
        begin :: if end - start > 9 -> end - 9 else -> start
        limb := 0
        loop index in begin..<end -> limb = limb * 10 + Int.from_u8(bytes[index]) - 48
        canonical_ast_write(&out, "{limb}")
        end = begin
        first = false
    }
    canonical_ast_write(&out, "]")
}
fn canonical_ast_write_ct_bigint(out: &[U8], decimal: String) Never! {
    bytes :: decimal.bytes()
    negative :: canonical_ast_decimal_start(bytes) < bytes.len() && Int.from_u8(bytes[0]) == 45
    canonical_ast_write(&out, "CtBigInt {{ negative: {negative:Debug}, limbs: ")
    canonical_ast_write_limbs(&out, bytes)
    canonical_ast_write(&out, " }}")
}
fn canonical_ast_write_bigint(out: &[U8], value: Int) Never! {
    decimal :: "{value}"
    sign :: if {
        value < 0 -> -1
        value == 0 -> 0
        else -> 1
    }
    canonical_ast_write(&out, "BigInt {{ sign: {sign}, limbs: ")
    canonical_ast_write_limbs(&out, decimal.bytes())
    canonical_ast_write(&out, " }}")
}
fn canonical_ast_write_os_target(out: &[U8], name: String) Never! {
    if name == {
        "linux" | "Linux" -> canonical_ast_write(&out, "Linux")
        "macos" | "MacOS" -> canonical_ast_write(&out, "MacOS")
        "windows" | "Windows" -> canonical_ast_write(&out, "Windows")
        else -> panic("checked OS target must be a canonical OSTarget variant")
    }
}

fn canonical_ast_compare_strings(left: [String], right: [String]) -> Ordering Never! {
    length :: if left.len() < right.len() -> left.len() else -> right.len()
    loop index in 0..<length {
        order :: left[index] <=> right[index]
        if order != Ordering.Equal -> return order
    }
    left.len() <=> right.len()
}
fn canonical_ast_view_source_rank(value: ViewSource) -> Int Never! {
    if value == {
        .Receiver -> 0
        .Parameter(_) -> 1
        .Static(_, _) -> 2
    }
}
fn canonical_ast_compare_view_source(left: ViewSource, right: ViewSource) -> Ordering Never! {
    rank :: canonical_ast_view_source_rank(left) <=> canonical_ast_view_source_rank(right)
    if rank != Ordering.Equal -> return rank
    if left == {
        .Receiver -> Ordering.Equal
        .Parameter(index) -> if right == .Parameter(other) -> index <=> other else -> Ordering.Equal
        .Static(module_path, name) -> {
            if right == .Static(other_path, other_name) {
                order :: module_path <=> other_path
                return if order != Ordering.Equal -> order else -> name <=> other_name
            }
            Ordering.Equal
        }
    }
}
fn canonical_ast_projection_rank(value: ViewSourceProjection) -> Int Never! {
    if value == {
        .Field(_) -> 0
        .Index -> 1
        .Range -> 2
    }
}
fn canonical_ast_compare_view_paths(left: ViewSourcePath, right: ViewSourcePath) -> Ordering Never! {
    source :: canonical_ast_compare_view_source(left.source, right.source)
    if source != Ordering.Equal -> return source
    length :: if left.projections.len() < right.projections.len() -> left.projections.len() else -> right.projections.len()
    loop index in 0..<length {
        lhs :: left.projections[index]
        rhs :: right.projections[index]
        rank :: canonical_ast_projection_rank(lhs) <=> canonical_ast_projection_rank(rhs)
        if rank != Ordering.Equal -> return rank
        if lhs == .Field(name) {
            if rhs == .Field(other) {
                order :: name <=> other
                if order != Ordering.Equal -> return order
            }
        }
    }
    left.projections.len() <=> right.projections.len()
}

// Rust CtKey::Ord -> shared Prelude/Core/MapKey.rs value semantics, projected
// without constructing/copying a second recursive key carrier.
fn canonical_ast_key_rank(key: CtKey) -> Int Never! {
    if key == {
        .Int(_) -> 0
        .Str(_) | .Enum(_, _) -> 2
        .Bool(_) -> 3
        .Char(_) -> 4
        .Tuple(_) | .Struct(_, _) -> 5
    }
}
fn canonical_ast_compare_key_fields(left: [NamedCtKey], right: [NamedCtKey]) -> Ordering Never! {
    length :: if left.len() < right.len() -> left.len() else -> right.len()
    loop index in 0..<length {
        order :: canonical_ast_compare_keys(left[index].value, right[index].value)
        if order != Ordering.Equal -> return order
    }
    left.len() <=> right.len()
}
fn canonical_ast_compare_keys(left: CtKey, right: CtKey) -> Ordering Never! {
    lhs :: canonical_ast_key_rank(left)
    rhs :: canonical_ast_key_rank(right)
    if lhs != rhs -> return lhs <=> rhs
    if left == {
        .Int(value) -> if right == .Int(other) -> value <=> other else -> panic("equal key ranks have the same payload")
        .Str(value) | .Enum(_, value) -> if right == {
            .Str(other) | .Enum(_, other) -> value <=> other
            else -> panic("equal key ranks have the same payload")
        }
        .Bool(value) -> if right == .Bool(other) -> value <=> other else -> panic("equal key ranks have the same payload")
        .Char(value) -> if right == .Char(other) -> value <=> other else -> panic("equal key ranks have the same payload")
        .Tuple(fields) | .Struct(_, fields) -> if right == {
            .Tuple(other) | .Struct(_, other) -> canonical_ast_compare_key_fields(fields, other)
            else -> panic("equal key ranks have the same payload")
        }
    }
}

// Borrowed providers call this operation to append the referenced default in
// the same buffer and through the same exhaustive structural traversal.
pub fn canonical_ast_write_expression<P: CanonicalASTDefaultProvider>(out: &[U8], defaults: P, expression: Expr) Never! {
    canonical_ast_write_expr<P>(&out, defaults, expression, false)
}

// Rust: crates/jet-foundation/src/AST/types.rs::AccessConvention (derived Debug field/variant order).
fn canonical_ast_write_access_convention<P: CanonicalASTDefaultProvider>(out: &[U8], defaults: P, value: AccessConvention, clear_callable_bodies: Bool) Never! {
    if value == {
        .Read -> {
            canonical_ast_write(&out, "Read")
        }
        .Write -> {
            canonical_ast_write(&out, "Write")
        }
        .Move -> {
            canonical_ast_write(&out, "Move")
        }
    }
}

// Rust: crates/jet-foundation/src/AST/program_imports.rs::AppliedRuleApplication (derived Debug field/variant order).
fn canonical_ast_write_applied_rule_application<P: CanonicalASTDefaultProvider>(out: &[U8], defaults: P, value: AppliedRuleApplication, clear_callable_bodies: Bool) Never! {
    canonical_ast_write(&out, "AppliedRuleApplication {{ ")
    canonical_ast_write(&out, "marker: ")
    canonical_ast_write_marker<P>(&out, defaults, value.marker, false)
    canonical_ast_write(&out, ", target: ")
    if value.target == {
        .Val(v1) -> {
            canonical_ast_write(&out, "Some(")
            canonical_ast_write(&out, "Span")
            canonical_ast_write(&out, ")")
        }
        .None -> canonical_ast_write(&out, "None")
    }
    canonical_ast_write(&out, ", site: ")
    if value.site == {
        .Val(v2) -> {
            canonical_ast_write(&out, "Some(")
            canonical_ast_write_rule_site<P>(&out, defaults, v2, false)
            canonical_ast_write(&out, ")")
        }
        .None -> canonical_ast_write(&out, "None")
    }
    canonical_ast_write(&out, " }}")
}

