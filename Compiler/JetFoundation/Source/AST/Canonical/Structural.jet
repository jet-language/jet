// Rust: crates/jet-foundation/src/AST/patterns.rs::BinSpec (derived Debug field/variant order).
fn canonical_ast_write_bin_spec<P: CanonicalASTDefaultProvider>(out: &[U8], defaults: P, value: BinSpec, clear_callable_bodies: Bool) Never! {
    if value == {
        .Bits(v1, v2) -> {
            canonical_ast_write(&out, "Bits {{ ")
            canonical_ast_write(&out, "width: ")
            canonical_ast_write(&out, "{v1:Debug}")
            canonical_ast_write(&out, ", ")
            canonical_ast_write(&out, "endian: ")
            canonical_ast_write_bin_endian<P>(&out, defaults, v2, false)
            canonical_ast_write(&out, " }}")
        }
        .Rest -> {
            canonical_ast_write(&out, "Rest")
        }
    }
}

// Rust: crates/jet-foundation/src/AST/patterns.rs::BindName (derived Debug field/variant order).
fn canonical_ast_write_bind_name<P: CanonicalASTDefaultProvider>(out: &[U8], defaults: P, value: BindName, clear_callable_bodies: Bool) Never! {
    canonical_ast_write(&out, "BindName {{ ")
    canonical_ast_write(&out, "name: ")
    canonical_ast_write_string(&out, value.name)
    canonical_ast_write(&out, ", span: ")
    canonical_ast_write(&out, "Span")
    canonical_ast_write(&out, ", rename: ")
    if value.rename == {
        .Val(v1) -> {
            canonical_ast_write(&out, "Some(")
            canonical_ast_write(&out, "(")
            canonical_ast_write_string(&out, v1.name)
            canonical_ast_write(&out, ", ")
            canonical_ast_write(&out, "Span")
            canonical_ast_write(&out, ")")
            canonical_ast_write(&out, ")")
        }
        .None -> canonical_ast_write(&out, "None")
    }
    canonical_ast_write(&out, " }}")
}

// Rust: crates/jet-foundation/src/AST/patterns.rs::BindPattern (derived Debug field/variant order).
fn canonical_ast_write_bind_pattern<P: CanonicalASTDefaultProvider>(out: &[U8], defaults: P, value: BindPattern, clear_callable_bodies: Bool) Never! {
    if value == {
        .Struct(v1, v2, v3, v4, v5) -> {
            canonical_ast_write(&out, "Struct {{ ")
            canonical_ast_write(&out, "type_name: ")
            canonical_ast_write_string(&out, v1)
            canonical_ast_write(&out, ", ")
            canonical_ast_write(&out, "type_span: ")
            canonical_ast_write(&out, "Span")
            canonical_ast_write(&out, ", ")
            canonical_ast_write(&out, "fields: ")
            canonical_ast_write(&out, "[")
            i7 := 0
            loop v6 in v3 {
                if i7 > 0 -> canonical_ast_write(&out, ", ")
                canonical_ast_write_bind_name<P>(&out, defaults, v6, false)
                i7 += 1
            }
            canonical_ast_write(&out, "]")
            canonical_ast_write(&out, ", ")
            canonical_ast_write(&out, "rest: ")
            if v4 == {
                .Val(v8) -> {
                    canonical_ast_write(&out, "Some(")
                    canonical_ast_write(&out, "Span")
                    canonical_ast_write(&out, ")")
                }
                .None -> canonical_ast_write(&out, "None")
            }
            canonical_ast_write(&out, ", ")
            canonical_ast_write(&out, "span: ")
            canonical_ast_write(&out, "Span")
            canonical_ast_write(&out, " }}")
        }
        .List(v9, v10) -> {
            canonical_ast_write(&out, "List {{ ")
            canonical_ast_write(&out, "elems: ")
            canonical_ast_write(&out, "[")
            i12 := 0
            loop v11 in v9 {
                if i12 > 0 -> canonical_ast_write(&out, ", ")
                canonical_ast_write_bind_name<P>(&out, defaults, v11, false)
                i12 += 1
            }
            canonical_ast_write(&out, "]")
            canonical_ast_write(&out, ", ")
            canonical_ast_write(&out, "span: ")
            canonical_ast_write(&out, "Span")
            canonical_ast_write(&out, " }}")
        }
        .Tuple(v13, v14) -> {
            canonical_ast_write(&out, "Tuple {{ ")
            canonical_ast_write(&out, "elems: ")
            canonical_ast_write(&out, "[")
            i16 := 0
            loop v15 in v13 {
                if i16 > 0 -> canonical_ast_write(&out, ", ")
                canonical_ast_write_bind_name<P>(&out, defaults, v15, false)
                i16 += 1
            }
            canonical_ast_write(&out, "]")
            canonical_ast_write(&out, ", ")
            canonical_ast_write(&out, "span: ")
            canonical_ast_write(&out, "Span")
            canonical_ast_write(&out, " }}")
        }
        .Refutable(v17, v18, v19, v20, v21) -> {
            canonical_ast_write(&out, "Refutable {{ ")
            canonical_ast_write(&out, "pattern: ")
            canonical_ast_write_pattern<P>(&out, defaults, v17, false)
            canonical_ast_write(&out, ", ")
            canonical_ast_write(&out, "fallback: ")
            canonical_ast_write_or_fallback<P>(&out, defaults, v18, false)
            canonical_ast_write(&out, ", ")
            canonical_ast_write(&out, "names: ")
            canonical_ast_write(&out, "[")
            i23 := 0
            loop v22 in v19 {
                if i23 > 0 -> canonical_ast_write(&out, ", ")
                canonical_ast_write_bind_name<P>(&out, defaults, v22, false)
                i23 += 1
            }
            canonical_ast_write(&out, "]")
            canonical_ast_write(&out, ", ")
            canonical_ast_write(&out, "span: ")
            canonical_ast_write(&out, "Span")
            canonical_ast_write(&out, ", ")
            canonical_ast_write(&out, "synthesized: ")
            canonical_ast_write(&out, "{v21:Debug}")
            canonical_ast_write(&out, " }}")
        }
