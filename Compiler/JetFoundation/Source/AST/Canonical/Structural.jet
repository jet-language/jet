// Rust: crates/jet-foundation/src/AST/patterns.rs::BinMatchPart (derived Debug field/variant order).
fn canonical_ast_write_bin_match_part<P: CanonicalASTDefaultProvider>(out: &[U8], defaults: P, value: BinMatchPart, clear_callable_bodies: Bool) Never! {
    if value == {
        .Lit(v1) -> {
            canonical_ast_write(&out, "Lit(")
            canonical_ast_write(&out, "[")
            i3 := 0
            loop v2 in v1 {
                if i3 > 0 -> canonical_ast_write(&out, ", ")
                canonical_ast_write(&out, "{v2:Debug}")
                i3 += 1
            }
            canonical_ast_write(&out, "]")
            canonical_ast_write(&out, ")")
        }
        .Hole(v4, v5, v6) -> {
            canonical_ast_write(&out, "Hole {{ ")
            canonical_ast_write(&out, "name: ")
            canonical_ast_write_string(&out, v4)
            canonical_ast_write(&out, ", ")
            canonical_ast_write(&out, "spec: ")
            canonical_ast_write_bin_spec<P>(&out, defaults, v5, false)
            canonical_ast_write(&out, ", ")
            canonical_ast_write(&out, "span: ")
            canonical_ast_write(&out, "Span")
            canonical_ast_write(&out, " }}")
        }
    }
}

