// Rust-shaped statements and their parser/semantic support records.

Stmt: enum {
    Expr(expr: Expr)
    Val(binding: Binding)
    Assign(target: LValue, op: BinOp?, op_span: Span, value: Expr)
    Return(value: Expr?, span: Span)
    While(cond: Expr, body: [Stmt], span: Span, arrow_body: Bool, label: NamedSpan?)
    For(var: String, var_span: Span, var2: NamedSpan?, kind: ForKind, body: [Stmt], span: Span, arrow_body: Bool, label: NamedSpan?, auto_vectorization: AutoVectorizationFacts?)
    Switch(subject: Expr, arms: [SwitchArm], else_body: [Stmt]?, span: Span)
    Break(span: Span)
    BreakValue(value: Expr, span: Span)
    Continue(span: Span)
    BreakLabel(name: String, span: Span)
    BreakLabelValue(name: String, name_span: Span, value: Expr, span: Span)
    ContinueLabel(name: String, span: Span)
    Loop(body: [Stmt], span: Span, arrow_body: Bool, label: NamedSpan?)
    CountedLoop(init: Binding, cond: Expr, step: Stmt?, body: [Stmt], span: Span, arrow_body: Bool, label: NamedSpan?)
    Unsafe(audit: String?, audit_expr: Expr?, body: [Stmt], span: Span)
    Impure(reason: String?, reason_expr: Expr?, body: [Stmt], span: Span)
    Reactive(body: [Stmt], span: Span)
    Shield(body: [Stmt], span: Span)
    Switched(marker: Marker, body: [Stmt], span: Span)
    Region(name: String, name_span: Span, body: [Stmt], span: Span)
    Policy(declarations: [PolicyDeclaration], body: [Stmt], span: Span)
    TaskGroup(name: String, name_span: Span, args: TaskGroupArgs, body: [Stmt], span: Span)
    Layout(name: String, name_span: Span, body: [Stmt], span: Span)
    AuthorityScope(caps: [NamedSpan], caps_span: Span, binding: NamedSpan?, body: [Stmt], span: Span)
    ComptimeIf(cond: Expr, cond_span: Span, then_body: [Stmt], else_body: [Stmt]?, span: Span, selected_then: Bool?)
    ComptimeSwitch(subject: Expr, arms: [SwitchArm], else_body: [Stmt]?, span: Span)
    ComptimeBlock(body: [Stmt], is_template_loop: Bool, span: Span)
    ContextBlock(fields: [ContextField], body: [Stmt], span: Span)
    Live(body: [Stmt], span: Span)
    AssumeDet(reason: String, reason_expr: Expr, body: [Stmt], span: Span)
    Transact(name: String?, name_span: Span?, body: [Stmt], implicit: Bool, span: Span)
    Yield(value: Expr, span: Span)
    ScopeMember(name: String, name_span: Span, args: [Expr], args_span: Span?, body: [Stmt], dsl: Bool, dot_span: Span, span: Span)
    DeferClose(close: Expr, span: Span)
}

IfStmt: struct {
    cond: Expr
    then_body: [Stmt]
    else_branch: ElseBranch?
    span: Span
}

ElseBranch: enum {
    ElseIf(branch: IfStmt)
    Else(body: [Stmt])
}

// `task.group g(limit: n, stack: bytes) { … }`: either argument may be left out.
TaskGroupArgs: struct {
    limit: Expr?{None}
    stack: Expr?{None}
}

SwitchArm: struct {
    cond: Expr
    body: [Stmt]
    span: Span
    // `#Through` after the body: the next arm's body runs after this one.
    through: Span?{None}
}

ContextField: struct {
    name: String
    value: Expr
    span: Span
}

PolicyDeclaration: struct {
    key: PolicyKey
    value: PolicyValue
    scope: PolicyScope
    span: Span
    target: Span?
    source: String
}

PolicyKey: enum {
    Unsafe
    Impure
    Nondeterministic
    DependencyGrant
    BuildFlag
    SessionFlag
    TrustGrant
    ForcePin
    TaintScrub
    DutyDrop
    StateTransition
    PrecisionDemotion
    Structure
    LintAllow
    CheckRemoval
    LinkOverride
    ScopedGC
    ExplicitUnits
    Copies
    Sentries
    // `#Policy(arithmetic: .Mode)`, at function, method or
    // block scope only; the innermost declaration wins and never crosses a call.
    Arithmetic
    Writes
}

PolicyValue: enum {
    Enabled
    Limit(value: Int)
    Forbid
    Default
    GateOnly
    Obligations
    Relaxed
    PerSite
    Track
    Skip
    Allow
    On
    Off
    Explicit
    // The fixed-width arithmetic mode of `#Policy(arithmetic: .Mode)`.
    Arithmetic(mode: ArithmeticMode)
}

PolicyScope: enum {
    Organization
    Package
    Module
    Function
    Block
}

ForKind: enum {
    Range(start: Expr, end: Expr, step: Expr?, exclusive: Bool)
    In(collection: Expr, step: Expr?)
}

LValue: enum {
    Local(name: String, name_span: Span)
    Index(base: Expr, index: Expr, span: Span, kind: IndexKind)
    Field(base: Expr, field: String, span: Span)
}

MetaField: enum {
    Category(value: Expr, span: Span)
    Tunable(span: Span)
    Maturity(value: Expr, span: Span)
    Unknown(name: String, value: Expr?, span: Span)
}

MetaAttr: struct {
    fields: [MetaField]
    span: Span
}

MetaFacts: struct {
    category: String?
    tunable: Bool
}

Binding: struct {
    mutable: Bool
    markers: [Marker]
    reactive_upgrade: Bool
    meta: MetaAttr?
    name: String
    name_span: Span
    sigil_span: Span?
    pattern: BindPattern?
    ty: Type?
    ty_span: Span?
    init: Expr
    is_comptime: Bool
    ct: CtValue?
    uninit: Bool
    arena_view: Bool
    string_view: Bool
    gc_promotion: GCPromotion?
    gc_transferred: Bool
}

GCPromotion: struct {
    span: Span
    scope: String
    policy_provenance: String
    reason: String
    edges: [GCPromotionEdge]
    collection_len: Int?
}

GCPromotionEdge: struct {
    binding: String
    slot: String
    group: Int
}

Marker: struct {
    name: String
    declaration_module: String? { None }
    declaration_span: Span? { None }
    negated: Bool
    name_span: Span
    args: [MarkerCallArg]
    arg_labels: [CallLabel?]
    span: Span
    ct: CtValue?
    // Written as a `#X: value` line inside the declaration's body rather
    // than above it. The marker means the same either way.
    inside: Bool{false}
    // The positions in `args` written `#run { value }`: each must have its
    // answer while building, after the marker's checked substitution.
    required: [Int]{[Int]{}}
}

// Sema's checked proof for one counted loop (JetSema LoopFacts.jet), carried
// on its ForRange statement to JetIR's range loop, which reads it and never
// re-derives eligibility. `extent` is the exclusive bound sema proved for the
// loop index when the range starts at or above 0 and the body neither rebinds
// nor writes the index (None: unproven); `proven_indexes` the index nodes of
// the body's list reads and writes that the extent keeps inside their fixed
// list, which need no bounds check. Each Bool is a semantic verdict on the
// whole body; a loop sema cannot read completely carries no facts at all.
AutoVectorizationFacts: struct {
    element_type: Type
    no_aliasing: Bool
    no_early_exit: Bool
    effect_free_body: Bool
    no_cross_iteration_deps: Bool
    extent: Int?
    proven_indexes: [Int]
}

ast_binding: fn(name: String, name_span: Span, mutable: Bool, init: Expr, sigil_span: Span?) -> Binding Never! {
    Binding{
        mutable: mutable,
        markers: [Marker]{},
        reactive_upgrade: false,
        meta: None,
        name: name,
        name_span: name_span,
        sigil_span: sigil_span,
        pattern: None,
        ty: None,
        ty_span: None,
        init: init,
        is_comptime: false,
        ct: None,
        uninit: false,
        arena_view: false,
        string_view: false,
        gc_promotion: None,
        gc_transferred: false,
    }
}
