// Compile-time values retained on AST nodes and semantic projections.

enum CtFloat {
    F32(value: Float)
    F64(value: Float)
}

enum CtValue {
    Int(value: Int)
    Float(value: CtFloat)
    Bool(value: Bool)
    Char(value: Char)
    Str(value: String)
    BigInt(value: String)
    Bytes(value: [U8])
    List(values: [CtValue])
    Map(entries: [CtMapEntry])
    Struct(type_name: String, fields: [NamedCtValue])
    Enum(type_name: String, variant: String, args: [CtEnumArg])
    Present(value: CtValue)
    Failed(report: CtReport)
    Unit
    Closure(value: ClosureData)
}

struct CtMapEntry {
    key: CtKey
    value: CtValue
}

struct NamedCtValue {
    name: String
    value: CtValue
}

struct CtEnumArg {
    label: String?
    value: CtValue
}

enum CtReport {
    Clean(ty: Type)
    Told(value: CtValue)
}

struct ClosureData {
    lambda: Lambda
    captured: [NamedCtValue]
    return_type: Type?
    opaque: CtOpaque?
}

struct CtOpaque {
    kind: String
    identity: String
}

enum CtKey {
    Int(value: Int)
    Str(value: String)
    Bool(value: Bool)
    Char(value: Char)
    Tuple(fields: [NamedCtKey])
    Struct(type_name: String, fields: [NamedCtKey])
    Enum(type_name: String, variant: String)
}

struct NamedCtKey {
    name: String
    value: CtKey
}

enum FailureContract {
    Default(success: Type, error: Type)
    Optional(success: Type)
    DeclaredNever
    Explicit(success: Type, error: Type)
    Converted(success: Type, source: Type, target: Type)
    ProvenUnreachable(success: Type)
}

// The failure route a callable exposes to its callers.
fn failure_contract_effective_type(contract: FailureContract) -> Type Never! {
    if contract == {
        .DeclaredNever -> Type.Named{name: "Never"}
        .Default(success, error) | .Explicit(success, error) -> Type.Result{ok: success, err: error}
        .Optional(success) -> Type.Option{inner: success}
        .Converted(success, _, target) -> Type.Result{ok: success, err: target}
        .ProvenUnreachable(success) -> Type.Result{ok: success, err: Type.Named{name: "Never"}}
    }
}

// Stable tooling projection of where the effective failure route came from;
// consumers read this fact instead of reconstructing it from the rendered type.
fn failure_contract_source(contract: FailureContract) -> String Never! {
    if contract == {
        .Default(_, _) -> "implicit default !Err"
        .Optional(_) -> "optional success"
        .Explicit(_, error) -> "explicit !{type_name(error)}"
        .Converted(_, source, target) -> "converted {type_name(source)} -> {type_name(target)}"
        .DeclaredNever -> "declared Never return"
        .ProvenUnreachable(_) -> "explicit !Never (proven unreachable)"
    }
}

fn ast_comptime_key_type(key: CtKey) -> Type Never! {
    if key == {
        .Int(_) -> Type.Int
        .Str(_) -> Type.String
        .Bool(_) -> Type.Bool
        .Char(_) -> Type.Char
        .Tuple(fields) -> {
            types := [TypeTupleField]{}
            loop field in fields -> &types.push(TypeTupleField{name: field.name, ty: ast_comptime_key_type(field.value)})
            Type.Tuple{fields: types}
        }
        .Struct(name, _) | .Enum(name, _) -> Type.Named{name: name}
    }
}

fn ast_comptime_value_type(value: CtValue) -> Type Never! {
    if value == {
        .Int(_) | .BigInt(_) -> Type.Int
        .Float(number) -> if number == {
            .F32(_) -> Type.Float32
            .F64(_) -> Type.Float
        }
        .Bool(_) -> Type.Bool
        .Char(_) -> Type.Char
        .Str(_) -> Type.String
        .Bytes(_) -> Type.List{element: Type.IntN{signed: false, bits: 8}}
        .List(values) -> Type.List{element: if values.len() == 0 -> Type.Int else -> ast_comptime_value_type(values[0])}
        .Map(entries) -> {
            if {
                entries.len() == 0 -> Type.Map{key: Type.String, key_span: None, value: Type.Int}
                else -> Type.Map{key: ast_comptime_key_type(entries[0].key), key_span: None, value: ast_comptime_value_type(entries[0].value)}
            }
        }
        .Struct(name, _) | .Enum(name, _, _) -> Type.Named{name: name}
        .Present(inner) -> Type.Option{inner: ast_comptime_value_type(inner)}
        .Failed(report) -> if report == {
            .Clean(ty) -> Type.Option{inner: ty}
            .Told(error) -> Type.Result{ok: Type.Int, err: ast_comptime_value_type(error)}
        }
        .Unit -> Type.Named{name: "Unit"}
        .Closure(_) -> Type.Fn{params: [Type]{}, ret: None, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
    }
}
