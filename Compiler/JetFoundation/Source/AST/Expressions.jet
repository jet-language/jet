// Expression and call AST. Recursive expression types and semantic type
// annotations are shared across compiler phases; `Type` is JetFoundation's.

// Every expression carries its AST NodeId (`id`), the key its facts are
// filed under. The parser numbers each top-level unit's expressions from the
// unit's first byte (`parser_node_id`), so ids are unique per file and do not
// depend on how the parse was chunked. A rewrite that rebuilds a node keeps
// its id; a node no source spelled carries `AST_NODE_GENERATED`.
AST_NODE_GENERATED: -1

Expr: enum {
    Str(parts: [StrPart], span: Span, id: Int),
    StrMatchLit(parts: [StrMatchPart], span: Span, id: Int),
    BinMatchLit(parts: [BinMatchPart], span: Span, id: Int),
    Int(value: Int, span: Span, width: IntegerWidth?, raw: String?, id: Int),
    Float(value: Float, span: Span, is_f32: Bool, raw: String?, id: Int),
    Bool(value: Bool, span: Span, id: Int),
    Unit(span: Span, id: Int),
    Char(value: String, span: Span, id: Int),
    ListLit(elements: [Expr], span: Span, id: Int),
    MemberSpread(base: Expr, members: [ExprMember], span: Span, id: Int),
    Spread(value: Expr, span: Span, id: Int),
    MapLit(entries: [ExprPair], span: Span, id: Int),
    Index(base: Expr, index: Expr, span: Span, kind: IndexKind, id: Int),
    Slice(base: Expr, start: Expr, end: Expr, range: Expr?, span: Span, id: Int),
    Range(start: Expr, end: Expr, exclusive: Bool, span: Span, id: Int),
    Ident(name: String, span: Span, id: Int),
    Call(call: Call, id: Int),
    Unary(op: UnOp, operand: Expr, span: Span, id: Int),
    Binary(op: BinOp, left: Expr, right: Expr, span: Span, id: Int),
    CompareChain(operands: [Expr], ops: [BinOp], hooks: [Bool], span: Span, id: Int),
    UnitLit(raw: String, int: Int?, float: Float?, suffix: String, suffix_span: Span, span: Span, id: Int),
    Deref(value: Expr, span: Span, id: Int),
    RawOf(value: Expr, span: Span, id: Int),
    Copy(value: Expr, span: Span, id: Int),
    Place(value: Expr, access: PlaceAccess, span: Span, id: Int),
    Field(base: Expr, member: String, span: Span, id: Int),
    OptField(base: Expr, member: String, member_span: Span, flatten: Bool, span: Span, id: Int),
    MethodCall(receiver: Expr, method: String, method_span: Span, owner_type_args: [Type], type_args: [Type], args: [CallArg], id: Int),
    OptMethodCall(receiver: Expr, method: String, method_span: Span, type_args: [Type], args: [CallArg], span: Span, id: Int),
    StructLit(type_name: String, type_args: [Type], import_ns: String?, as_trait: String?, fields: [ExprField], inferred: Bool, span: Span, id: Int),
    TypedLit(head: Type?, body: TypedLitBody, span: Span, id: Int),
    EnumLit(type_name: String, variant: String, variant_span: Span?, args: [EnumLitArg], leading_dot: Bool, span: Span, id: Int),
    Tainted(value: Expr, tag: String?, span: Span, id: Int),
    Present(value: Expr, span: Span, id: Int),
    Absent(span: Span, id: Int),
    Todo(span: Span, expected_type: String?, id: Int),
    NoElse(span: Span, id: Int),
    PatternTest(subject: Expr, pattern: Pattern, span: Span, id: Int),
    Ok(value: Expr, span: Span, id: Int),
    Err(value: Expr, span: Span, id: Int),
    Try(value: Expr, span: Span, conversion: TryConvert, context: Expr?, id: Int),
    OrFallback(value: Expr, fallback: OrFallback, is_option: Bool, span: Span, id: Int),
    If(cond: Expr, then_body: [Stmt], then_value: Expr, else_body: [Stmt], else_value: Expr, span: Span, id: Int),
    TupleLit(fields: [TupleField], span: Span, ty: Type?, id: Int),
    Lambda(lambda: Lambda, id: Int),
    CallValue(callee: Expr, args: [CallArg], span: Span, id: Int),
    PtrFromAddr(alias: String, alias_span: Span, elem: Type, addr: Expr, span: Span, id: Int),
    ComptimeName(name: String, span: Span, value: CtValue?, id: Int),
    TypeValue(ty: Type, span: Span, id: Int),
    Paren(value: Expr, span: Span, id: Int),
    Pipe(head: Expr, steps: [PipeStep], span: Span, id: Int),
}

// A generic type written where a value goes (`show(Box<Int>)`), kept
// whole so the tree shows its type arguments; sema refuses it as a type,
// not a value (E0636).
// `head |> step |> step`: each step reads the value of the
// line above as `<>`, which the parser spells as the step's hidden name.

// One `|> value` step of a pipe. `name` is the hidden binding that holds the
// value the step receives; every `<>` in `value` is an `Ident` of it, and
// `reads` counts them as written.
PipeStep: struct {
    name: String,
    value: Expr,
    reads: Int,
    span: Span,
}

// The hidden binding a pipe step's `<>` reads, named by the step's `|>`.
PIPE_VALUE_PREFIX: "__jet_pipe_"

pipe_value_name: fn(step_start: Int) -> String Never! { "{PIPE_VALUE_PREFIX}{step_start}" }

// Whether `name` is a pipe step's hidden binding, which source spells `<>`.
pipe_value_is_name: fn(name: String) -> Bool Never! { name.starts_with(PIPE_VALUE_PREFIX) }

// The receiver name of a static call on a list type, `[T?].name(…)` or
// `[T#N].filled(value)`. The written type is the call's one owner type
// argument; no source can spell this name.
LIST_TYPE_OWNER: "[]"

IntegerWidth: struct {
    signed: Bool,
    bits: Int,
}

ExprField: struct {
    name: String,
    name_span: Span,
    value: Expr,
}

ExprMember: struct {
    name: String,
    span: Span,
}

ExprPair: struct {
    key: Expr,
    value: Expr,
}

TupleField: struct {
    name: String,
    value: Expr,
}

EnumLitArg: enum {
    Positional(value: Expr),
    Named(label: String, expr: Expr),
}

Call: struct {
    name: String,
    name_span: Span,
    type_args: [Type],
    args: [CallArg],
}

CallArg: struct {
    convention: AccessConvention,
    expr: Expr,
    span: Span,
    flags: CallArgFlags,
    label: CallLabel?,
    spread: Bool,
    // The written `^`/`^^` on a place argument; only
    // `#Policy(writes: .Explicit)` accepts it (sema CallMarks.jet).
    mark: CallMark?{None},
}

// A call mark: `grow(^xs)` writes the place, `archive(^^title)` takes it. A
// marked receiver is a written Expr.Place instead (`^xs.push(4)`).
CallMark: struct {
    access: PlaceAccess,
    span: Span,
}

CallLabel: struct {
    name: String,
    span: Span,
}

CallArgFlags: struct {
    owned_last_use: Bool,
    shared_access_desugar: Bool,
    template_items: [DeriveBodyItem]?,
    c_callback_symbol: Bool,
    c_callback_function_key: String?,
    c_callback_managed: Bool,
    c_callback_plan_digest: String?,
    c_callback_identity: String?,
    trusted_html: Bool,
    source_index: Int?,
    binder_slot: Int?,
    binder_label: String?,
    binder_refs: [BinderRef],
    binder_site: Int?,
    callable_policy: CallablePolicyChain?,
    authority_boundary: Bool,
    // The operand of `Shared{<expr>}`: its Move convention is the cell's own
    // ownership, not a written `.move()`, so a bare name there is an unmarked
    // owning position (Calls/Static.jet).
    shared_operand: Bool{false},
    // A default the parameter writes `Type{#run value}`, which this call
    // computes while building (Calls/Checking.jet).
    run_default: Bool{false},
}

BinderRef: struct {
    name: String,
    slot: Int,
    ty: Type,
}

MarkerCallArg: enum {
    Expr(value: Expr),
    EffectRow(effects: [EffectRowEntry], span: Span),
}

// The label the parser gives the to-state of a retired `#State(A -> B)`.
// No written label can spell it, so `#State(A, to: B)` is never the arrow form.
STATE_ARROW_LABEL: "->"

BinOp: enum {
    Add,
    Sub,
    Mul,
    Div,
    FloorDiv,
    Mod,
    Rem,
    Pow,
    BitAnd,
    BitOr,
    BitXor,
    Shl,
    Shr,
    Eq,
    Ne,
    Lt,
    Gt,
    Le,
    Ge,
    Compare,
    And,
    Or,
}

// The prefix operators: `-`, `!`, and `~`, the bitwise complement of an
// integer.
UnOp: enum {
    Neg,
    Not,
    Complement,
}

IndexKind: enum {
    Unknown,
    List,
    Range,
    FixedListProof,
    Map,
    Lane(name: String),
    User(name: String),
    LayoutField(name: String),
    Pool,
}

// `Take` is a sema-built move of a place: `x.move()`, or the place a method
// call consumes (`buf.seal()`); sema checks it and lowers the unmarked call.
PlaceAccess: enum {
    Read,
    Write,
    Take,
}

TryConvert: enum {
    NoConversion,
    Never,
    DefaultErr,
    Typed(fn_name: String, source: Type, target: Type),
    WidenUnion(enum_name: String, tag: String),
}

// A string literal's pieces. An interpolated value's `format` is its
// selector, None for bare `{value}`; each Computed argument of the selector
// is the value of one of the parts right after it, in order.
StrPart: enum {
    Lit(text: String),
    Interp(expr: Expr, format: StrSelector?),
    Byte(value: U8),
}

// The flags of an argument no pass has marked. A constant, so every argument
// built with it borrows one static box instead of allocating its own.
AST_EMPTY_CALL_ARG_FLAGS: CallArgFlags{
    owned_last_use: false,
    shared_access_desugar: false,
    template_items: None,
    c_callback_symbol: false,
    c_callback_function_key: None,
    c_callback_managed: false,
    c_callback_plan_digest: None,
    c_callback_identity: None,
    trusted_html: false,
    source_index: None,
    binder_slot: None,
    binder_label: None,
    binder_refs: [BinderRef]{},
    binder_site: None,
    callable_policy: None,
    authority_boundary: false,
}

ast_empty_lambda_meta: fn() -> LambdaMeta Never! {
    LambdaMeta{
        escapes: false,
        runtime_erased: false,
        needs_fn_mut: false,
        mut_captures: [String]{},
        cloned_captures: [String]{},
        effect_direct: [String]{},
        effect_solved: [String]{},
        effect_call_edges: [String]{},
        effect_maximal: false,
        effect_direct_spans: [EffectRowEntry]{},
        frozen_captures: [String]{},
        materialized_captures: [String]{},
        moved_captures: [String]{},
        collecting_loop: false,
        collect_item_type: None,
        result_loop: false,
        requires_exhaustion_route: false,
        exhaustion_span: None,
        exhaustion_route_attached: false,
        loop_result_type: None,
        loop_label: None,
        guard_projection: None,
        return_view_provenance: None,
        cell_projection_path: None,
        fallible_propagation: false,
        fallible_carrier: None,
        frame_schedule_explanation: None,
        frame_schedule: None,
        frame_schedule_derivation: None,
    }
}

// A format selector, `{value:Name}` or `{value:Name(args)}`. Its meaning is
// a trait's: `Name` is trait `NameFormat`, and the selector calls its method
// `name` (the selector name in snake case) on the value with the arguments,
// so `{value:Hex(4)}` is `value.hex(4)` of core.text.fmt's HexFormat and a
// package's own `ColorFormat` gives it `{value:Color}`. `Debug` and `Pretty`
// show the value's Debug text, `Pad` and `PadLeft` pad its Display text, and
// `Unit` writes a quantity, each through core.text.fmt.
StrSelector: struct {
    name: String,
    span: Span,
    args: [StrSelectorArg],
}

// A selector argument as written: an Int literal, a quoted text, a word
// (`:Unit(bare)`), or any other expression, computed at run time after the
// value; the parts after the selector's own hold those, in order.
StrSelectorArg: enum {
    Number(value: Int),
    Text(value: String),
    Word(name: String),
    Computed,
}

// The trait call a style selector is: trait `{selector}Format` and its
// method, the selector name in snake case (`PadLeft` is `pad_left`).
StrSelectorStyle: struct {
    selector: String,
    trait_name: String,
    method: String,
}

str_selector_style: fn(selector: String) -> StrSelectorStyle {
    StrSelectorStyle{selector: selector, trait_name: "{selector}Format", method: sema_casing_snake_words(selector)}
}

// How many of the parts after a selector are its computed arguments.
str_selector_computed: fn(selector: StrSelector) -> Int Never! {
    ^count: 0
    loop arg in selector.args {
        if arg == .Computed -> count += 1
    }
    count
}

// A lambda parameter; `convention` is its written mark (`(buf: ^[Int])`
// writes, `(job: ^^Job)` takes), Read when it has none.
LambdaParam: struct {
    name: String,
    name_span: Span,
    ty: Type?,
    ty_span: Span?,
    convention: AccessConvention,
}

LambdaBody: enum {
    Expr(value: Expr),
    Block(body: [Stmt]),
}

// The span of the one expression a lambda body is: an expression body, or a
// braced body whose only line is that expression (`fn(x) { x.left }`). None
// otherwise.
ast_lambda_single_expr_span: fn(body: LambdaBody) -> Span? Never! {
    if body == .Expr(value) -> return Val(expr_span(value))
    if body == .Block(statements) && statements.len() == 1 && statements[0] == .Expr(value) {
        return Val(expr_span(value))
    }
    None
}

Lambda: struct {
    take_names: [NamedSpan],
    params: [LambdaParam],
    effects: [EffectRowEntry]?,
    body: LambdaBody,
    span: Span,
    meta: LambdaMeta,
    // The result a `fn(…) -> T {…}` lambda writes; None
    // when the expected callable type or the body gives it.
    result: Type?{None},
}

NamedSpan: struct {
    name: String,
    span: Span,
}

LambdaMeta: struct {
    escapes: Bool,
    runtime_erased: Bool,
    http_route_source: String?{None},
    // Whether the lambda is a bound `^self` method value (`counter.bump`
    // passed as a function) over a name or field path, whose one capture is
    // the receiver's root local: sema refuses the value when its closure would
    // copy that local, since the method would change the copy.
    bound_write: Bool{false},
    needs_fn_mut: Bool,
    mut_captures: [String],
    cloned_captures: [String],
    effect_direct: [String],
    effect_solved: [String],
    effect_call_edges: [String],
    effect_maximal: Bool,
    effect_direct_spans: [EffectRowEntry],
    frozen_captures: [String],
    materialized_captures: [String],
    moved_captures: [String],
    collecting_loop: Bool,
    collect_item_type: Type?,
    result_loop: Bool,
    requires_exhaustion_route: Bool,
    exhaustion_span: Span?,
    exhaustion_route_attached: Bool,
    loop_result_type: Type?,
    loop_label: NamedSpan?,
    guard_projection: [String]?,
    return_view_provenance: ViewProvenanceMap?,
    cell_projection_path: [String]?,
    fallible_propagation: Bool,
    fallible_carrier: Type?,
    frame_schedule_explanation: String?,
    frame_schedule: FrameSchedule?,
    // The record the frame scheduler made for `frame_schedule`; the semantic
    // index interns it into the derivation relation.
    frame_schedule_derivation: DerivationRecord?,
}

TypedLitBody: enum {
    Fields(fields: [ExprField]),
    Elements(elements: [Expr]),
    Entries(entries: [ExprPair]),
    Value(value: Expr),
    ByteText(parts: [ByteTextPart]),
    Empty,
}

// A `[U8]{"…"}` body: its text, and each run of `\xNN` escapes as one part
// holding the run's bytes (a generated table is one part, not a part per
// byte).
ByteTextPart: enum {
    Lit(text: String),
    Bytes(values: [U8]),
}

ArithmeticPolicyFact: struct {
    mode: ArithmeticMode,
    scope_span: Span,
    operation_span: Span,
    operation: ArithmeticOperation?,
}

// The arithmetic modes are a checked view of `Gate` in
// Core/Prelude/Prelude.jet: each mode is the escape its word (`checked`,
// `wrapping`, `saturating`) writes. While the compiler builds,
// ARITHMETIC_MODE_COUNT checks that each case is a Gate case, and a stray
// stops the build naming it.
ARITHMETIC_MODE_COUNT: #run arithmetic_mode_count(embed_file("Expressions.jet"), embed_file("toolchain:Core/Prelude/Prelude.jet"))

// The number of ArithmeticMode cases in `text` (this file), once each is a
// case of `Gate` in `prelude`; else the build stops naming the strays.
arithmetic_mode_count: fn(text: String, prelude: String) -> Int {
    modes: effect_vocabulary_enum_cases(text, "ArithmeticMode") ?? build_time_refused("Expressions.jet declares no `ArithmeticMode: enum {{ … }}`")
    gates: effect_vocabulary_enum_cases(prelude, "Gate") ?? build_time_refused("Core/Prelude/Prelude.jet declares no `Gate: enum {{ … }}`")
    strays: effect_vocabulary_strays(modes, gates)
    if strays.len() > 0 {
        build_time_refused("Expressions.jet: ArithmeticMode names escapes that `Gate` in Core/Prelude/Prelude.jet does not declare: {strays.join(", ")}")
    }
    modes.len()
}

ArithmeticMode: enum {
    Checked,
    Wrapping,
    Saturating,
}

ArithmeticOperation: enum {
    Add,
    Sub,
    Mul,
    Neg,
    Pow,
}

FrameSchedule: struct {
    operations: [FrameOperation],
    dependencies: [FrameDependency],
    transfers: [FrameTransfer],
    reuse: [FrameReuse],
    retentions: [FrameRetention],
    conservative: [String],
}

FrameOperation: struct {
    name: String,
    source_index: Int,
    accesses: [ResourceAccess],
    completion: FrameCompletion,
    completion_provider: String?,
    external_effect: Bool,
}

ResourceAccess: struct {
    resource: ResourceIdentity,
    mode: AccessConvention,
    region: ResourceRegion,
    layout: ResourceLayout?,
    temporary: Bool,
}

ResourceIdentity: enum {
    Named(name: String),
    Unknown,
}

ResourceRegion: enum {
    Whole,
    Bytes(start: Int, length: Int),
    Unknown,
}

ResourceLayout: struct {
    size: Int,
    align: Int,
    layout: String,
    device: String,
}

FrameCompletion: enum {
    Synchronous,
    Pending(token: String),
    Event(token: String),
}

FrameDependency: struct {
    before: Int,
    after: Int,
    resource: String,
    reason: String,
}

FrameTransfer: struct {
    before: Int,
    after: Int,
    resource: String,
    from_device: String,
    to_device: String,
}

FrameReuse: struct {
    previous_resource: String,
    next_resource: String,
    previous_last_use: Int,
    next_first_use: Int,
    legal: Bool,
    reason: String,
}

FrameRetention: struct {
    resource: String,
    operation: Int,
    owner: String,
    completion_token: String?,
    completed: Bool,
}

DerivationRef: struct {
    id: String,
}

// S71 the ordinary call that `receiver?.method(args)` runs on the
// present payload. Syntax walkers reuse their `MethodCall` facts through it.
expr_optional_method_call_as_call: fn(receiver: Expr, method: String, method_span: Span, type_args: [Type], args: [CallArg]) -> Expr Never! {
    Expr.MethodCall{receiver: receiver, method: method, method_span: method_span, owner_type_args: [Type]{}, type_args: type_args, args: args, id: AST_NODE_GENERATED}
}

// The index of `m[key, or: start]` is a call of this internal name with the
// key and the starting value, so no source name can spell it.
expr_map_slot_or_name: fn() -> String Never! {
    nul: String.from_bytes([U8]{U8{0}}) ?? ""
    "{nul}jet.map.or"
}

// The index `key, or: start` of a map slot that starts at `start` when the
// key is missing; `label` is the span of the written `or`.
expr_map_slot_or: fn(key: Expr, start: Expr, label: Span, id: Int) -> Expr Never! {
    key_span: expr_span(key)
    start_span: expr_span(start)
    span: Span{start: key_span.start, end: start_span.end}
    key_arg: CallArg{convention: AccessConvention.Read, expr: key, span: key_span, flags: AST_EMPTY_CALL_ARG_FLAGS, label: None, spread: false}
    start_arg: CallArg{convention: AccessConvention.Read, expr: start, span: start_span, flags: AST_EMPTY_CALL_ARG_FLAGS, label: Val(CallLabel{name: "or", span: label}), spread: false}
    Expr.Call{call: Call{name: expr_map_slot_or_name(), name_span: span, type_args: [Type]{}, args: [CallArg]{key_arg, start_arg}}, id: id}
}

// Whether `call` is the index of a map slot with a starting value
// (expr_map_slot_or): its arguments are the key and the starting value.
expr_is_map_slot_or: fn(call: Call) -> Bool Never! {
    call.args.len() == 2 && call.name == expr_map_slot_or_name()
}

// The `task` forms: a spawn (`task { … }`, `task ^^name { … }`, `task
// value`), `task.timeout(duration)` and the `task.all`, `task.race` and
// `task.any` combinators. The language owns them. The parser writes each one
// as a one-argument method call (task_form_call) on a NUL-led receiver and
// method no source can spell, and every later reader classifies the call
// through task_form_of.
TaskForm: enum {
    Spawn,
    Timeout,
    All,
    Race,
    Any,
}

// The receiver of every task form's call.
TASK_FORM_RECEIVER: "\u{0}jet.task"

// The method a task form's call names.
task_form_method: fn(form: TaskForm) -> String Never! {
    if form == {
        .Spawn -> "\u{0}jet.task.spawn"
        .Timeout -> "\u{0}jet.task.timeout"
        .All -> "\u{0}jet.task.all"
        .Race -> "\u{0}jet.task.race"
        .Any -> "\u{0}jet.task.any"
    }
}

// The form as a program writes it: `task`, `task.timeout`, `task.all`,
// `task.race` or `task.any`.
task_form_spelling: fn(form: TaskForm) -> String Never! {
    if form == {
        .Spawn -> "task"
        .Timeout -> "task.timeout"
        .All -> "task.all"
        .Race -> "task.race"
        .Any -> "task.any"
    }
}

// The combinator a `task.` selector names: all, race or any.
task_form_combinator: fn(selector: String) -> TaskForm? Never! {
    if selector == {
        "all" -> Val(TaskForm.All)
        "race" -> Val(TaskForm.Race)
        "any" -> Val(TaskForm.Any)
        else -> None
    }
}

// The call a task form is written as: the form's method on
// TASK_FORM_RECEIVER, with its one argument (the spawned lambda, the
// duration or the branches). `head` is the `task` word.
task_form_call: fn(form: TaskForm, head: Span, method_span: Span, argument: Expr, argument_span: Span, receiver_id: Int, id: Int) -> Expr Never! {
    receiver: Expr.Ident{name: TASK_FORM_RECEIVER, span: head, id: receiver_id}
    argument_arg: CallArg{convention: AccessConvention.Read, expr: argument, span: argument_span, flags: AST_EMPTY_CALL_ARG_FLAGS, label: None, spread: false}
    Expr.MethodCall{receiver: receiver, method: task_form_method(form), method_span: method_span, owner_type_args: [Type]{}, type_args: [Type]{}, args: [CallArg]{argument_arg}, id: id}
}

// The task form a method call of `method` on `receiver` writes, or None for
// any other call.
task_form_of: fn(receiver: Expr, method: String) -> TaskForm? Never! {
    on_receiver: if receiver == .Ident(name, _, _) -> name == TASK_FORM_RECEIVER else -> false
    if !on_receiver -> return None
    if method == {
        "\u{0}jet.task.spawn" -> Val(TaskForm.Spawn)
        "\u{0}jet.task.timeout" -> Val(TaskForm.Timeout)
        "\u{0}jet.task.all" -> Val(TaskForm.All)
        "\u{0}jet.task.race" -> Val(TaskForm.Race)
        "\u{0}jet.task.any" -> Val(TaskForm.Any)
        else -> None
    }
}

expr_span: fn(expr: Expr) -> Span {
    if expr == {
        .Str(_, span, _) -> return span
        .StrMatchLit(_, span, _) -> return span
        .BinMatchLit(_, span, _) -> return span
        .Int(_, span, _, _, _) -> return span
        .Float(_, span, _, _, _) -> return span
        .Bool(_, span, _) -> return span
        .Unit(span, _) -> return span
        .Char(_, span, _) -> return span
        .ListLit(_, span, _) -> return span
        .MemberSpread(_, _, span, _) -> return span
        .Spread(_, span, _) -> return span
        .MapLit(_, span, _) -> return span
        .Index(_, _, span, _, _) -> return span
        .Slice(_, _, _, _, span, _) -> return span
        .Range(_, _, _, span, _) -> return span
        .Ident(_, span, _) -> return span
        .Call(call, _) -> return call.name_span
        .Unary(_, _, span, _) -> return span
        .Binary(_, _, _, span, _) -> return span
        .CompareChain(_, _, _, span, _) -> return span
        .UnitLit(_, _, _, _, _, span, _) -> return span
        .Deref(_, span, _) -> return span
        .RawOf(_, span, _) -> return span
        .Copy(_, span, _) -> return span
        .Place(_, _, span, _) -> return span
        .Field(_, _, span, _) -> return span
        .OptField(_, _, _, _, span, _) -> return span
        .MethodCall(_, _, method_span, _, _, _, _) -> return method_span
        .OptMethodCall(_, _, method_span, _, _, _, _) -> return method_span
        .StructLit(_, _, _, _, _, _, span, _) -> return span
        .TypedLit(_, _, span, _) -> return span
        .EnumLit(_, _, _, _, _, span, _) -> return span
        .Tainted(_, _, span, _) -> return span
        .Present(_, span, _) -> return span
        .Absent(span, _) -> return span
        .Todo(span, _, _) -> return span
        .NoElse(span, _) -> return span
        .PatternTest(_, _, span, _) -> return span
        .Ok(_, span, _) -> return span
        .Err(_, span, _) -> return span
        .Try(_, span, _, _, _) -> return span
        .OrFallback(_, _, _, span, _) -> return span
        .If(_, _, _, _, _, span, _) -> return span
        .TupleLit(_, span, _, _) -> return span
        .Lambda(lambda, _) -> return lambda.span
        .CallValue(_, _, span, _) -> return span
        .PtrFromAddr(_, _, _, _, span, _) -> return span
        .ComptimeName(_, span, _, _) -> return span
        .TypeValue(_, span, _) -> return span
        .Paren(_, span, _) -> return span
        .Pipe(_, _, span, _) -> return span
    }
    Span{start: 0, end: 0}
}

// The AST NodeId of an expression (AST_NODE_GENERATED for a compiler-built one).
expr_node_id: fn(expr: Expr) -> Int Never! {
    if expr == {
        .Str(_, _, id) -> id
        .StrMatchLit(_, _, id) -> id
        .BinMatchLit(_, _, id) -> id
        .Int(_, _, _, _, id) -> id
        .Float(_, _, _, _, id) -> id
        .Bool(_, _, id) -> id
        .Unit(_, id) -> id
        .Char(_, _, id) -> id
        .ListLit(_, _, id) -> id
        .MemberSpread(_, _, _, id) -> id
        .Spread(_, _, id) -> id
        .MapLit(_, _, id) -> id
        .Index(_, _, _, _, id) -> id
        .Slice(_, _, _, _, _, id) -> id
        .Range(_, _, _, _, id) -> id
        .Ident(_, _, id) -> id
        .Call(_, id) -> id
        .Unary(_, _, _, id) -> id
        .Binary(_, _, _, _, id) -> id
        .CompareChain(_, _, _, _, id) -> id
        .UnitLit(_, _, _, _, _, _, id) -> id
        .Deref(_, _, id) -> id
        .RawOf(_, _, id) -> id
        .Copy(_, _, id) -> id
        .Place(_, _, _, id) -> id
        .Field(_, _, _, id) -> id
        .OptField(_, _, _, _, _, id) -> id
        .MethodCall(_, _, _, _, _, _, id) -> id
        .OptMethodCall(_, _, _, _, _, _, id) -> id
        .StructLit(_, _, _, _, _, _, _, id) -> id
        .TypedLit(_, _, _, id) -> id
        .EnumLit(_, _, _, _, _, _, id) -> id
        .Tainted(_, _, _, id) -> id
        .Present(_, _, id) -> id
        .Absent(_, id) -> id
        .Todo(_, _, id) -> id
        .NoElse(_, id) -> id
        .PatternTest(_, _, _, id) -> id
        .Ok(_, _, id) -> id
        .Err(_, _, id) -> id
        .Try(_, _, _, _, id) -> id
        .OrFallback(_, _, _, _, id) -> id
        .If(_, _, _, _, _, _, id) -> id
        .TupleLit(_, _, _, id) -> id
        .Lambda(_, id) -> id
        .CallValue(_, _, _, id) -> id
        .PtrFromAddr(_, _, _, _, _, id) -> id
        .ComptimeName(_, _, _, id) -> id
        .TypeValue(_, _, id) -> id
        .Paren(_, _, id) -> id
        .Pipe(_, _, _, id) -> id
    }
}

// The first source byte of an expression. A method call is spanned at its
// method name, so a method chain or a member path starts at its receiver.
expr_source_start: fn(expr: Expr) -> Int Never! {
    if expr == {
        .Paren(_, span, _) -> span.start
        .Field(base, _, _, _) -> expr_source_start(base)
        .OptField(base, _, _, _, _, _) -> expr_source_start(base)
        .Index(base, _, _, _, _) -> expr_source_start(base)
        .MethodCall(receiver, _, _, _, _, _, _) -> expr_source_start(receiver)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> expr_span(expr).start
    }
}

// An expression's source extent from its first byte (`expr_source_start`)
// to the end of its own span: a method call covers its receiver path
// through the method name (`xs.zip`), any other expression its own span.
expr_source_span: fn(expr: Expr) -> Span Never! {
    Span{start: expr_source_start(expr), end: expr_span(expr).end}
}
