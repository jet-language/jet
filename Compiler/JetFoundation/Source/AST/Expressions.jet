// Expression and call AST. Recursive expression types and semantic type
// annotations are shared across compiler phases; `Type` is JetFoundation's.

enum Expr {
    Str(parts: [StrPart], span: Span)
    StrMatchLit(parts: [StrMatchPart], span: Span)
    BinMatchLit(parts: [BinMatchPart], span: Span)
    Int(value: Int, span: Span, width: IntegerWidth?, raw: String?)
    Float(value: Float, span: Span, is_f32: Bool, raw: String?)
    Bool(value: Bool, span: Span)
    Unit(span: Span)
    Char(value: String, span: Span)
    ListLit(elements: [Expr], span: Span)
    MemberSpread(base: Expr, members: [ExprMember], span: Span)
    Spread(value: Expr, span: Span)
    MapLit(entries: [ExprPair], span: Span)
    Index(base: Expr, index: Expr, span: Span, kind: IndexKind)
    Slice(base: Expr, start: Expr, end: Expr, range: Expr?, span: Span)
    Range(start: Expr, end: Expr, exclusive: Bool, span: Span)
    Ident(name: String, span: Span)
    Call(call: Call)
    Unary(op: UnOp, operand: Expr, span: Span)
    Binary(op: BinOp, left: Expr, right: Expr, span: Span)
    CompareChain(operands: [Expr], ops: [BinOp], hooks: [Bool], span: Span)
    UnitLit(raw: String, int: Int?, float: Float?, suffix: String, suffix_span: Span, span: Span)
    Deref(value: Expr, span: Span)
    RawOf(value: Expr, span: Span)
    Copy(value: Expr, span: Span)
    Place(value: Expr, access: PlaceAccess, span: Span)
    Field(base: Expr, member: String, span: Span)
    OptField(base: Expr, member: String, member_span: Span, flatten: Bool, span: Span)
    MethodCall(receiver: Expr, method: String, method_span: Span, owner_type_args: [Type], type_args: [Type], args: [CallArg])
    OptMethodCall(receiver: Expr, method: String, method_span: Span, type_args: [Type], args: [CallArg], span: Span)
    StructLit(type_name: String, type_args: [Type], import_ns: String?, as_trait: String?, fields: [ExprField], inferred: Bool, span: Span)
    TypedLit(head: Type?, body: TypedLitBody, span: Span)
    EnumLit(type_name: String, variant: String, variant_span: Span?, args: [EnumLitArg], leading_dot: Bool, span: Span)
    Tainted(value: Expr, tag: String?, span: Span)
    Present(value: Expr, span: Span)
    Absent(span: Span)
    Todo(span: Span, expected_type: String?)
    NoElse(span: Span)
    ReduceMarker(name: String, span: Span)
    PatternTest(subject: Expr, pattern: Pattern, span: Span)
    Ok(value: Expr, span: Span)
    Err(value: Expr, span: Span)
    Try(value: Expr, span: Span, conversion: TryConvert, context: Expr?)
    OrFallback(value: Expr, fallback: OrFallback, is_option: Bool, span: Span)
    If(cond: Expr, then_body: [Stmt], then_value: Expr, else_body: [Stmt], else_value: Expr, span: Span)
    TupleLit(fields: [TupleField], span: Span, ty: Type?)
    Lambda(lambda: Lambda)
    CallValue(callee: Expr, args: [CallArg], span: Span)
    PtrFromAddr(alias: String, alias_span: Span, elem: Type, addr: Expr, span: Span)
    ComptimeName(name: String, span: Span, value: CtValue?)
    Paren(value: Expr, span: Span)
}

struct IntegerWidth {
    signed: Bool
    bits: Int
}

struct ExprField {
    name: String
    name_span: Span
    value: Expr
}

struct ExprMember {
    name: String
    span: Span
}

struct ExprPair {
    key: Expr
    value: Expr
}

struct TupleField {
    name: String
    value: Expr
}

enum EnumLitArg {
    Positional(value: Expr)
    Named(label: String, expr: Expr)
}

struct Call {
    name: String
    name_span: Span
    type_args: [Type]
    args: [CallArg]
}

struct CallArg {
    convention: AccessConvention
    expr: Expr
    span: Span
    flags: CallArgFlags
    label: CallLabel?
    spread: Bool
}

struct CallLabel {
    name: String
    span: Span
}

struct CallArgFlags {
    owned_last_use: Bool
    shared_access_desugar: Bool
    is_trailing_block: Bool
    template_items: [DeriveBodyItem]?
    c_callback_symbol: Bool
    c_callback_function_key: String?
    c_callback_managed: Bool
    c_callback_plan_digest: String?
    c_callback_identity: String?
    trusted_html: Bool
    source_index: Int?
    binder_slot: Int?
    binder_label: String?
    binder_refs: [BinderRef]
    binder_site: Int?
    callable_policy: CallablePolicyChain?
    authority_boundary: Bool
    arithmetic_policy: ArithmeticPolicyFact?
    // The operand of `shared <expr>`: its Move convention is the cell's own
    // ownership, not a written `^`, so a bare name there is an unmarked
    // owning position (Calls/Static.jet).
    shared_operand: Bool{false}
}

struct BinderRef {
    name: String
    slot: Int
    ty: Type
}

enum MarkerCallArg {
    Expr(value: Expr)
    EffectRow(effects: [EffectRowEntry], span: Span)
}

enum BinOp {
    Add
    Sub
    Mul
    Div
    FloorDiv
    Mod
    Rem
    Pow
    BitAnd
    BitOr
    BitXor
    Shl
    Shr
    Eq
    Ne
    Lt
    Gt
    Le
    Ge
    Compare
    And
    Or
}

enum UnOp {
    Neg
    Not
}

enum IndexKind {
    Unknown
    List
    Range
    FixedListProof
    Map
    Lane(name: String)
    User(name: String)
    LayoutField(name: String)
    Pool
}

// `Take` is the `^` mark on the place a method call
// consumes (`^buf.seal()`); sema checks it and lowers the unmarked call.
enum PlaceAccess {
    Read
    Write
    Take
}

enum TryConvert {
    NoConversion
    Never
    DefaultErr
    Typed(fn_name: String, source: Type, target: Type)
    WidenUnion(enum_name: String, tag: String)
}

enum StrPart {
    Lit(text: String)
    Interp(expr: Expr, format: StrFormat)
    Byte(value: U8)
}
fn ast_empty_call_arg_flags() -> CallArgFlags Never! {
    CallArgFlags{
        owned_last_use: false,
        shared_access_desugar: false,
        is_trailing_block: false,
        template_items: None,
        c_callback_symbol: false,
        c_callback_function_key: None,
        c_callback_managed: false,
        c_callback_plan_digest: None,
        c_callback_identity: None,
        trusted_html: false,
        source_index: None,
        binder_slot: None,
        binder_label: None,
        binder_refs: [BinderRef]{},
        binder_site: None,
        callable_policy: None,
        authority_boundary: false,
        arithmetic_policy: None,
    }
}

fn ast_empty_lambda_meta() -> LambdaMeta Never! {
    LambdaMeta{
        escapes: false,
        runtime_erased: false,
        needs_fn_mut: false,
        mut_captures: [String]{},
        cloned_captures: [String]{},
        effect_direct: [String]{},
        effect_solved: [String]{},
        effect_call_edges: [String]{},
        effect_maximal: false,
        effect_direct_spans: [EffectRowEntry]{},
        frozen_captures: [String]{},
        materialized_captures: [String]{},
        moved_captures: [String]{},
        collecting_loop: false,
        collect_item_type: None,
        result_loop: false,
        requires_exhaustion_route: false,
        exhaustion_span: None,
        exhaustion_route_attached: false,
        loop_result_type: None,
        loop_label: None,
        guard_projection: None,
        return_view_provenance: None,
        cell_projection_path: None,
        fallible_propagation: false,
        fallible_carrier: None,
        frame_schedule_explanation: None,
        frame_schedule: None,
        frame_schedule_derivation: None,
    }
}

enum StrFormat {
    Display
    Debug
    Pretty
    Fixed(digits: Int)
    Grouped(digits: Int)
    Hex(digits: Int)
    Pad(width: Int, fill: String)
    PadLeft(width: Int, fill: String)
    Sci(digits: Int)
    Percent(digits: Int)
    Bin
    Oct
    Unit(format: UnitFormat)
}

enum UnitFormat {
    Symbol
    Name
    Bare
}

struct LambdaParam {
    name: String
    name_span: Span
    ty: Type?
    ty_span: Span?
}

enum LambdaBody {
    Expr(value: Expr)
    Block(body: [Stmt])
}

struct Lambda {
    take_names: [NamedSpan]
    params: [LambdaParam]
    effects: [EffectRowEntry]?
    body: LambdaBody
    span: Span
    meta: LambdaMeta
}

struct NamedSpan {
    name: String
    span: Span
}

struct LambdaMeta {
    escapes: Bool
    runtime_erased: Bool
    http_route_source: String?{None}
    needs_fn_mut: Bool
    mut_captures: [String]
    cloned_captures: [String]
    effect_direct: [String]
    effect_solved: [String]
    effect_call_edges: [String]
    effect_maximal: Bool
    effect_direct_spans: [EffectRowEntry]
    frozen_captures: [String]
    materialized_captures: [String]
    moved_captures: [String]
    collecting_loop: Bool
    collect_item_type: Type?
    result_loop: Bool
    requires_exhaustion_route: Bool
    exhaustion_span: Span?
    exhaustion_route_attached: Bool
    loop_result_type: Type?
    loop_label: NamedSpan?
    guard_projection: [String]?
    return_view_provenance: ViewProvenanceMap?
    cell_projection_path: [String]?
    fallible_propagation: Bool
    fallible_carrier: Type?
    frame_schedule_explanation: String?
    frame_schedule: FrameSchedule?
    frame_schedule_derivation: DerivationRef?
}

enum TypedLitBody {
    Fields(fields: [ExprField])
    Elements(elements: [Expr])
    Entries(entries: [ExprPair])
    Value(value: Expr)
    ByteText(parts: [ByteTextPart])
    Empty
}

enum ByteTextPart {
    Lit(text: String)
    Byte(value: U8)
}

struct ArithmeticPolicyFact {
    mode: ArithmeticMode
    scope_span: Span
    operation_span: Span
    operation: ArithmeticOperation?
}

enum ArithmeticMode {
    Checked
    Wrapping
    Saturating
}

enum ArithmeticOperation {
    Add
    Sub
    Mul
    Neg
    Pow
}

struct FrameSchedule {
    operations: [FrameOperation]
    dependencies: [FrameDependency]
    transfers: [FrameTransfer]
    reuse: [FrameReuse]
    retentions: [FrameRetention]
    conservative: [String]
}

struct FrameOperation {
    name: String
    source_index: Int
    accesses: [ResourceAccess]
    completion: FrameCompletion
    completion_provider: String?
    external_effect: Bool
}

struct ResourceAccess {
    resource: ResourceIdentity
    mode: ResourceAccessMode
    region: ResourceRegion
    layout: ResourceLayout?
    temporary: Bool
}

enum ResourceIdentity {
    Named(name: String)
    Unknown
}

enum ResourceAccessMode {
    Read
    Write
    Move
}

enum ResourceRegion {
    Whole
    Bytes(start: Int, length: Int)
    Unknown
}

struct ResourceLayout {
    size: Int
    align: Int
    layout: String
    device: String
}

enum FrameCompletion {
    Synchronous
    Pending(token: String)
    Event(token: String)
}

struct FrameDependency {
    before: Int
    after: Int
    resource: String
    reason: String
}

struct FrameTransfer {
    before: Int
    after: Int
    resource: String
    from_device: String
    to_device: String
}

struct FrameReuse {
    previous_resource: String
    next_resource: String
    previous_last_use: Int
    next_first_use: Int
    legal: Bool
    reason: String
}

struct FrameRetention {
    resource: String
    operation: Int
    owner: String
    completion_token: String?
    completed: Bool
}

struct DerivationRef {
    id: String
}
// S71 the ordinary call that `receiver?.method(args)` runs on the
// present payload. Syntax walkers reuse their `MethodCall` facts through it.
fn expr_optional_method_call_as_call(receiver: Expr, method: String, method_span: Span, type_args: [Type], args: [CallArg]) -> Expr Never! {
    Expr.MethodCall{receiver: receiver, method: method, method_span: method_span, owner_type_args: [Type]{}, type_args: type_args, args: args}
}

fn expr_span(expr: Expr) -> Span {
    if expr == {
        .Str(_, span) -> return span
        .StrMatchLit(_, span) -> return span
        .BinMatchLit(_, span) -> return span
        .Int(_, span, _, _) -> return span
        .Float(_, span, _, _) -> return span
        .Bool(_, span) -> return span
        .Unit(span) -> return span
        .Char(_, span) -> return span
        .ListLit(_, span) -> return span
        .MemberSpread(_, _, span) -> return span
        .Spread(_, span) -> return span
        .MapLit(_, span) -> return span
        .Index(_, _, span, _) -> return span
        .Slice(_, _, _, _, span) -> return span
        .Range(_, _, _, span) -> return span
        .Ident(_, span) -> return span
        .Call(call) -> return call.name_span
        .Unary(_, _, span) -> return span
        .Binary(_, _, _, span) -> return span
        .CompareChain(_, _, _, span) -> return span
        .UnitLit(_, _, _, _, _, span) -> return span
        .Deref(_, span) -> return span
        .RawOf(_, span) -> return span
        .Copy(_, span) -> return span
        .Place(_, _, span) -> return span
        .Field(_, _, span) -> return span
        .OptField(_, _, _, _, span) -> return span
        .MethodCall(_, _, method_span, _, _, _) -> return method_span
        .OptMethodCall(_, _, method_span, _, _, _) -> return method_span
        .StructLit(_, _, _, _, _, _, span) -> return span
        .TypedLit(_, _, span) -> return span
        .EnumLit(_, _, _, _, _, span) -> return span
        .Tainted(_, _, span) -> return span
        .Present(_, span) -> return span
        .Absent(span) -> return span
        .Todo(span, _) -> return span
        .NoElse(span) -> return span
        .ReduceMarker(_, span) -> return span
        .PatternTest(_, _, span) -> return span
        .Ok(_, span) -> return span
        .Err(_, span) -> return span
        .Try(_, span, _, _) -> return span
        .OrFallback(_, _, _, span) -> return span
        .If(_, _, _, _, _, span) -> return span
        .TupleLit(_, span, _) -> return span
        .Lambda(lambda) -> return lambda.span
        .CallValue(_, _, span) -> return span
        .PtrFromAddr(_, _, _, _, span) -> return span
        .ComptimeName(_, span, _) -> return span
        .Paren(_, span) -> return span
    }
    Span{start: 0, end: 0}
}

// The first source byte of an expression. A method call is spanned at its
// method name, so a method chain or a member path starts at its receiver.
fn expr_source_start(expr: Expr) -> Int Never! {
    if expr == {
        .Paren(_, span) -> return span.start
        .Field(base, _, _) -> return expr_source_start(base)
        .OptField(base, _, _, _, _) -> return expr_source_start(base)
        .MethodCall(receiver, _, _, _, _, _) -> return expr_source_start(receiver)
        else -> return expr_span(expr).start
    }
}

// An expression's source extent from its first byte (`expr_source_start`)
// to the end of its own span: a method call covers its receiver path
// through the method name (`xs.zip`), any other expression its own span.
fn expr_source_span(expr: Expr) -> Span Never! {
    Span{start: expr_source_start(expr), end: expr_span(expr).end}
}
