// Interned spellings (SP08a). A lexed source keeps one `NameTable`: every
// distinct spelling is stored once and named by a dense `Name` id, so tokens
// carry ids instead of Strings and equal spellings compare as equal ids.
// Ids are assigned in first-seen order, so one source always gets the same
// ids. Text is resolved only where a String is needed (`name_text`).
//
// Lookup is an open-addressing hash over the spelling bytes (FNV-1a), so a
// source range interns without building a String first.

Name: struct {
    id: U32,
}

NameTable: struct {
    // The spelling of each id, resolved without decoding bytes again.
    texts: [String],
    // Every spelling's bytes, back to back; id `n` ends at `ends[n]` and
    // starts where id `n - 1` ends.
    bytes: [U8],
    ends: [Int],
    // Each id's `name_hash`: a probe compares bytes only against an entry
    // with the same hash, and a grow never hashes a spelling again.
    hashes: [Int],
    // Open-addressing slots: 0 is empty, otherwise the id plus one.
    slots: [Int],
    mask: Int,
}

NAME_TABLE_INITIAL_SLOTS: 1024

// Precomputed `name_hash([U8]{}, 0, 0)` (also `name_text_hash("")`).
NAME_EMPTY_HASH: 983116070

// A table whose id 0 is the empty spelling (`name_empty`).
name_table: fn() -> NameTable Never! { name_table_sized(NAME_TABLE_INITIAL_SLOTS) }

// An empty table of at least `slots` slots to start; it grows as
// `name_table` does. A small table (a body's own symbol keys) starts small.
// A probe steps through the slots masked by their count less one, which
// visits every slot only for a power of two: `slots` rounds up to one.
// Minimum capacity is 4 so id 0 (the empty spelling) never triggers an
// immediate grow on construction.
name_table_sized: fn(slots: Int) -> NameTable Never! {
    ^capacity: 4
    loop capacity < slots -> capacity *= 2
    mask: capacity - 1
    ^initial: [Int]{}
    initial.try_reserve(capacity) ?? ()
    loop _ in 0..<capacity -> initial.push(0)
    initial[NAME_EMPTY_HASH & mask] = (NAME_EMPTY_HASH << 32) | 1
    NameTable{texts: [String]{""}, bytes: [U8]{}, ends: [Int]{0}, hashes: [Int]{NAME_EMPTY_HASH}, slots: initial, mask: mask}
}

// The empty spelling; every `name_table()` interns it first.
name_empty: fn() -> Name Never! { Name{id: U32{0}} }

name_index: fn(name: Name) -> Int Never! { Int{name.id} }

name_text: fn(table: NameTable, name: Name) -> String Never! { table.texts[Int{name.id}] }

name_count: fn(table: NameTable) -> Int Never! { table.texts.len() }

name_start: fn(table: NameTable, id: Int) -> Int Never! {
    if id == 0 -> 0 else -> table.ends[id - 1]
}

name_hash: fn(bytes: [U8], start: Int, end: Int) -> Int Never! {
    len: I64{end - start}
    ^hash: wrapping(len * I64{-7046029254386353131}) ~ I64{-3750763034362895579}
    words: len & I64{-8}
    ^at: I64{0}
    loop at < words {
        base: start + Int{at}
        word: I64{bytes[base]} | (I64{bytes[base + 1]} << I64{8}) | (I64{bytes[base + 2]} << I64{16}) | (I64{bytes[base + 3]} << I64{24}) | (I64{bytes[base + 4]} << I64{32}) | (I64{bytes[base + 5]} << I64{40}) | (I64{bytes[base + 6]} << I64{48}) | (I64{bytes[base + 7]} << I64{56})
        mixed: wrapping((hash ~ word) * I64{-7046029254386353131})
        hash = mixed ~ ((mixed >> I64{29}) & I64{34359738367})
        at = wrapping(at + I64{8})
    }
    if at < len {
        ^tail: I64{0}
        ^pos: len
        loop pos > at {
            pos = wrapping(pos - I64{1})
            tail = (tail << I64{8}) | I64{bytes[start + Int{pos}]}
        }
        mixed: wrapping((hash ~ tail) * I64{-7046029254386353131})
        hash = mixed ~ ((mixed >> I64{29}) & I64{34359738367})
    }
    hash ~= (hash >> I64{33}) & I64{2147483647}
    hash = wrapping(hash * I64{-49064778989728563})
    hash ~= (hash >> I64{33}) & I64{2147483647}
    hash = wrapping(hash * I64{-4265267296055464877})
    final: hash ~ ((hash >> I64{33}) & I64{2147483647})
    Int{final & I64{0x3fffffff}}
}

// Whether id `id` spells `bytes[start..<end]` (caller already matched 30-bit hash).
name_bytes_match: fn(table: NameTable, id: Int, bytes: [U8], start: Int, end: Int) -> Bool Never! {
    first: name_start(table, id)
    len: end - start
    if table.ends[id] - first != len -> return false
    if len == 0 -> return true
    if table.bytes[first] != bytes[start] -> return false
    loop offset in 1..<len {
        if table.bytes[first + offset] != bytes[start + offset] -> return false
    }
    true
}

// Whether id `id` spells `bytes[start..<end]`, whose `name_hash` is `hash`.
name_bytes_equal: fn(table: NameTable, id: Int, hash: Int, bytes: [U8], start: Int, end: Int) -> Bool Never! {
    if table.hashes[id] != hash -> return false
    name_bytes_match(table, id, bytes, start, end)
}

// The slot of `bytes[start..<end]` (whose `name_hash` is `hash`) in
// `table`: the one holding its id, or the empty one a new id takes.
// Each occupied slot packs `((hash & 0x3fffffff) << 32) | (id + 1)` so a
// probe rejects mismatched hashes without touching `table.hashes`.
name_slot: fn(table: NameTable, hash: Int, bytes: [U8], start: Int, end: Int) -> Int Never! {
    mask: table.mask
    hash_tag: hash & 0x3fffffff
    ^slot: hash & mask
    loop {
        entry: table.slots[slot]
        if entry == 0 -> break
        if (entry >> 32) == hash_tag {
            id: (entry & 0xffffffff) - 1
            if name_bytes_match(table, id, bytes, start, end) -> return slot
        }
        slot = (slot + 1) & mask
    }
    slot
}

// Zero-allocation slot probe for a String `text` whose `name_text_hash` is `hash`.
name_slot_text: fn(table: NameTable, hash: Int, text: String) -> Int Never! {
    mask: table.mask
    hash_tag: hash & 0x3fffffff
    ^slot: hash & mask
    loop {
        entry: table.slots[slot]
        if entry == 0 -> break
        if (entry >> 32) == hash_tag {
            id: (entry & 0xffffffff) - 1
            if table.texts[id] == text -> return slot
        }
        slot = (slot + 1) & mask
    }
    slot
}

// Gives `bytes[start..<end]` (hash `hash`), whose String is `text`, the
// next id at the empty slot `slot`.
name_insert: fn(table: ^NameTable, slot: Int, hash: Int, bytes: [U8], start: Int, end: Int, text: ^^String) -> Name Never! {
    id: table.texts.len()
    if end > start -> table.bytes.extend(bytes[start..<end])
    table.ends.push(table.bytes.len())
    table.hashes.push(hash)
    table.texts.push(text)
    table.slots[slot] = ((hash & 0x3fffffff) << 32) | (id + 1)
    if (id + 1) * 2 > table.mask -> name_table_grow(table)
    Name{id: U32{id}}
}

// The id of `bytes[start..<end]`, interning it when it is new. A spelling
// that is not UTF-8 resolves to "" but keeps its own id.
name_intern_bytes: fn(table: ^NameTable, bytes: [U8], start: Int, end: Int) -> Name Never! {
    hash: name_hash(bytes, start, end)
    slot: name_slot(table, hash, bytes, start, end)
    entry: table.slots[slot]
    if entry != 0 -> return Name{id: U32{(entry & 0xffffffff) - 1}}
    name_insert(table, slot, hash, bytes, start, end, String.from_bytes(bytes.slice(start, end)) ?? "")
}

name_text_hash: fn(text: String) -> Int Never! { Int{text.hash() & U64{0x3fffffff}} }

// The id of `text` when the table holds it; never interns.
name_find: fn(table: NameTable, text: String) -> Name? Never! {
    if table.texts.len() <= 1 -> return if text == "" -> Val(name_empty()) else -> None
    name_find_hashed(table, text, name_text_hash(text))
}

// The id of `text` (whose `name_text_hash` is `hash`) when the table holds it.
name_find_hashed: fn(table: NameTable, text: String, hash: Int) -> Name? Never! {
    if table.texts.len() <= 1 -> return if text == "" -> Val(name_empty()) else -> None
    slot: name_slot_text(table, hash, text)
    entry: table.slots[slot]
    if entry == 0 -> return None
    Val(Name{id: U32{(entry & 0xffffffff) - 1}})
}

// The id of `bytes[start..<end]` when the table holds that spelling; never
// interns.
name_find_bytes: fn(table: NameTable, bytes: [U8], start: Int, end: Int) -> Name? Never! {
    slot: name_slot(table, name_hash(bytes, start, end), bytes, start, end)
    entry: table.slots[slot]
    if entry == 0 -> return None
    Val(Name{id: U32{(entry & 0xffffffff) - 1}})
}

name_intern: fn(table: ^NameTable, text: String) -> Name Never! {
    name_intern_hashed(table, text, name_text_hash(text))
}

name_intern_hashed: fn(table: ^NameTable, text: String, hash: Int) -> Name Never! {
    slot: name_slot_text(table, hash, text)
    entry: table.slots[slot]
    if entry != 0 -> return Name{id: U32{(entry & 0xffffffff) - 1}}
    bytes: text.bytes()
    name_insert(table, slot, hash, bytes, 0, bytes.len(), String.from_bytes(bytes) ?? "")
}

// The slot of the name pair `first`, `second`: each part's id in `table`,
// interned when new, the first in the high half. A lookup keyed by a pair
// slot never joins the two names into one text.
name_pair_slot: fn(table: ^NameTable, first: String, second: String) -> Int Never! {
    (name_index(name_intern(table, first)) << 32) | name_index(name_intern(table, second))
}

// The slot of the name pair `first`, `second` when `table` holds both
// names; never interns.
name_pair_find_slot: fn(table: NameTable, first: String, second: String) -> Int? Never! {
    first_name: name_find(table, first) ?? return None
    second_name: name_find(table, second) ?? return None
    Val((name_index(first_name) << 32) | name_index(second_name))
}

name_table_grow: fn(table: ^NameTable) Never! {
    capacity: (table.mask + 1) * 2
    mask: capacity - 1
    ^slots: [Int]{}
    slots.try_reserve(capacity) ?? ()
    loop _ in 0..<capacity -> slots.push(0)
    loop id in 0..<table.texts.len() {
        hash: table.hashes[id]
        ^slot: hash & mask
        loop slots[slot] != 0 -> slot = (slot + 1) & mask
        slots[slot] = ((hash & 0x3fffffff) << 32) | (id + 1)
    }
    table.slots = slots.move()
    table.mask = mask
}

// A load's spelling pool. Each lexed source keeps a table of its own, so its
// ids stay its own, but equal spellings across a load's sources need only
// one String: a source's table takes it from the pool (name_pool_adopt)
// before anything reads the table's Strings. The pool is two tables:
// `shared`, the spellings of the load's earlier parse waves, which every
// parse thread of a wave reads and none writes, and a thread's `own`, the
// spellings it met first, which name_pool_fold adds to `shared` after the
// wave.

// Points each spelling of `table` at the pool's String for it; a spelling
// the pool lacks joins `own` with the table's String. Ids and bytes stay.
name_pool_adopt: fn(table: ^NameTable, shared: NameTable, own: ^NameTable) Never! {
    loop id in 0..<table.texts.len() {
        start: name_start(table, id)
        end: table.ends[id]
        hash: table.hashes[id]
        found: name_slot(shared, hash, table.bytes, start, end)
        shared_entry: shared.slots[found]
        if shared_entry != 0 {
            table.texts[id] = name_text(shared, Name{id: U32{(shared_entry & 0xffffffff) - 1}})
            next
        }
        slot: name_slot(own, hash, table.bytes, start, end)
        own_entry: own.slots[slot]
        if {
            own_entry == 0 -> {
                ^_: name_insert(own, slot, hash, table.bytes, start, end, name_text(table, Name{id: U32{id}}))
            }
            else -> {
                table.texts[id] = name_text(own, Name{id: U32{(own_entry & 0xffffffff) - 1}})
            }
        }
    }
}

// Adds each spelling of `own` that `shared` lacks, with its String, to
// `shared`.
name_pool_fold: fn(shared: ^NameTable, own: NameTable) Never! {
    loop id in 0..<own.texts.len() {
        start: name_start(own, id)
        end: own.ends[id]
        slot: name_slot(shared, own.hashes[id], own.bytes, start, end)
        if shared.slots[slot] == 0 {
            ^_: name_insert(shared, slot, own.hashes[id], own.bytes, start, end, name_text(own, Name{id: U32{id}}))
        }
    }
}

// The compilation's NameTable (Docs/Spec/compiler-data.md): every name the
// phases share, a `Name` of it, such as a type's (TypeIDs.jet). Its first
// ids are the spellings the compiler itself writes, one constant each below,
// so a phase names them without the table; the loader then merges each
// source's table into it in source-unit order (name_table_merge), so one
// input always gets the same ids.
name_table_compilation: fn() -> NameTable Never! {
    ^table: name_table()
    _: name_intern(table, "Unit")
    _: name_intern(table, "Never")
    _: name_intern(table, "Self")
    _: name_intern(table, "T")
    _: name_intern(table, "K")
    _: name_intern(table, "V")
    _: name_intern(table, "Err")
    _: name_intern(table, "Pointer")
    table
}

NAME_UNIT: Name{id: U32{1}}

NAME_NEVER: Name{id: U32{2}}

NAME_SELF: Name{id: U32{3}}

NAME_T: Name{id: U32{4}}

NAME_K: Name{id: U32{5}}

NAME_V: Name{id: U32{6}}

NAME_ERR: Name{id: U32{7}}

NAME_POINTER: Name{id: U32{8}}

// Adds every spelling of `from` from id `first` on that `into` lacks, in
// `from`'s id order, and returns each such id's id in `into`, by id - first:
// the remap a merged source's rows are renumbered by.
name_table_merge: fn(into: ^NameTable, from: NameTable, first: Int) -> [Name] Never! {
    ^ids: [Name]{}
    count: from.texts.len() - first
    if count > 0 -> ids.try_reserve(count) ?? ()
    loop id in first..<from.texts.len() {
        start: name_start(from, id)
        end: from.ends[id]
        slot: name_slot(into, from.hashes[id], from.bytes, start, end)
        entry: into.slots[slot]
        if entry != 0 {
            ids.push(Name{id: U32{(entry & 0xffffffff) - 1}})
            next
        }
        ids.push(name_insert(into, slot, from.hashes[id], from.bytes, start, end, name_text(from, Name{id: U32{id}})))
    }
    ids
}

#Test("the compilation table's well-known names are their constants, and a merge renumbers a source's names") {
    assert_eq(NAME_EMPTY_HASH, name_hash([U8]{}, 0, 0))
    assert_eq(NAME_EMPTY_HASH, name_text_hash(""))
    ^table: name_table_compilation()
    assert_eq(name_text(table, NAME_NEVER), "Never")
    assert_eq(name_text(table, NAME_SELF), "Self")
    assert_eq(name_text(table, NAME_T), "T")
    assert_eq(name_text(table, NAME_K), "K")
    assert_eq(name_text(table, NAME_V), "V")
    assert_eq(name_text(table, NAME_UNIT), "Unit")
    assert_eq(name_text(table, NAME_ERR), "Err")
    assert_eq(name_text(table, NAME_POINTER), "Pointer")
    ^source: name_table()
    point: name_intern(source, "Point")
    unit: name_intern(source, "Unit")
    ids: name_table_merge(table, source, 0)
    assert_eq(ids[name_index(unit)], NAME_UNIT)
    assert_eq(name_text(table, ids[name_index(point)]), "Point")
    assert_eq(ids[0], name_empty())
    // A second source's same spelling gets the same id.
    ^other: name_table()
    again: name_intern(other, "Point")
    assert_eq(name_table_merge(table, other, 0)[name_index(again)], ids[name_index(point)])
}

// Loaded modules by identity (#6793, Docs/Spec/compiler-data.md). The loader
// interns each module's identity text once, as it first meets it; every later phase
// names a module by its `ModuleID` and resolves the text only at an edge (a
// diagnostic, a cache or symbol key, a tool record) with `module_text`. Id 0
// is the empty identity: no module.
//
// The id's top bit marks a Core source's identity (`<corelib>/...`), so the
// Core test needs no table; the low 31 bits are the table row.
ModuleID: struct {
    id: U32,
}

ModuleTable: struct {
    identities: NameTable,
}

MODULE_CORE_PREFIX: "<corelib>/"

MODULE_CORE_BIT: U32{0x80000000}

MODULE_ROW_BITS: U32{0x7fffffff}

// Core's one door to what the compiler provides (Core/Builtins/Builtins.jet):
// a Core module, though its name has no `core.` prefix. Only Core sources
// import it (E1013).
CORE_BUILTINS_MODULE: "jet_builtins"

module_table: fn() -> ModuleTable Never! { ModuleTable{identities: name_table()} }

module_none: fn() -> ModuleID Never! { ModuleID{id: U32{0}} }

module_is_none: fn(module_id: ModuleID) -> Bool Never! { module_id.id == U32{0} }

// The table row of `module_id`: 0 for no module, below `module_count`.
module_index: fn(module_id: ModuleID) -> Int Never! { Int{module_id.id & MODULE_ROW_BITS} }

module_count: fn(table: ModuleTable) -> Int Never! { name_count(table.identities) }

module_is_core: fn(module_id: ModuleID) -> Bool Never! { module_id.id & MODULE_CORE_BIT != U32{0} }

module_id_of: fn(name: Name, text: String) -> ModuleID Never! {
    if text.starts_with(MODULE_CORE_PREFIX) -> return ModuleID{id: name.id | MODULE_CORE_BIT}
    ModuleID{id: name.id}
}

// The id of identity `text`, interned when it is new.
module_intern: fn(table: ^ModuleTable, text: String) -> ModuleID Never! {
    module_id_of(name_intern(table.identities, text), text)
}

// The id of identity `text`, None when the table has no such identity.
module_find: fn(table: ModuleTable, text: String) -> ModuleID? Never! {
    name: name_find(table.identities, text) ?? return None
    Val(module_id_of(name, text))
}

module_text: fn(table: ModuleTable, module_id: ModuleID) -> String Never! {
    table.identities.texts[module_index(module_id)]
}

// A pass's own text-keyed column (Docs/Spec/compiler-data.md, Lookups): a
// pass that matches text no compilation table holds interns each key into a
// NameTable of its own and keeps the key's row at that id in an `[Int]`
// column; several columns may share one table. NAME_COLUMN_UNBOUND marks an
// id the column never bound (id 0, the empty spelling, starts unbound). A
// negative row reads as unbound to name_column_get and as itself to
// name_column_value, so -1 unbinds a key and a pass may keep markers of its
// own below 0.
NAME_COLUMN_UNBOUND: -4611686018427387904

// An empty column for a table expected to hold about `expected` keys.
name_column: fn(expected: Int{0}) -> [Int] Never! {
    ^rows: [Int]{}
    if expected > 0 -> rows.try_reserve(expected + 1) ?? ()
    rows.push(NAME_COLUMN_UNBOUND)
    rows
}

// A NameTable sized for about `expected` keys, as name_column is.
name_column_table: fn(expected: Int{0}) -> NameTable Never! { name_table_sized(expected * 2 + 2) }

// The row `rows` binds at id `id`, whatever its sign; None when unbound.
name_column_at: fn(rows: [Int], id: Int) -> Int? Never! {
    if id >= rows.len() || rows[id] == NAME_COLUMN_UNBOUND -> return None
    Val(rows[id])
}

// The row `rows` binds to `text` in `names` when it is not negative.
name_column_get: fn(names: NameTable, rows: [Int], text: String) -> Int? Never! {
    found: name_find(names, text) ?? return None
    row: name_column_at(rows, name_index(found)) ?? return None
    if row < 0 -> return None
    Val(row)
}

// name_column_get of a `text` whose name_text_hash is `hash`.
name_column_get_hashed: fn(names: NameTable, rows: [Int], text: String, hash: Int) -> Int? Never! {
    found: name_find_hashed(names, text, hash) ?? return None
    row: name_column_at(rows, name_index(found)) ?? return None
    if row < 0 -> return None
    Val(row)
}

// The row `rows` binds to `text` whatever its sign, if `text` was ever bound.
name_column_value: fn(names: NameTable, rows: [Int], text: String) -> Int? Never! {
    found: name_find(names, text) ?? return None
    name_column_at(rows, name_index(found))
}

// Binds `text` to `row`, replacing any earlier value.
name_column_set: fn(names: ^NameTable, rows: ^[Int], text: String, row: Int) Never! {
    name_column_set_hashed(names, rows, text, name_text_hash(text), row)
}

// name_column_set of a `text` whose name_text_hash is `hash`.
name_column_set_hashed: fn(names: ^NameTable, rows: ^[Int], text: String, hash: Int, row: Int) Never! {
    id: name_index(name_intern_hashed(names, text, hash))
    loop rows.len() <= id -> rows.push(NAME_COLUMN_UNBOUND)
    rows[id] = row
}

// Binds `text` to `row` (>= 0) unless it is bound: a key's first row stands.
name_column_set_first: fn(names: ^NameTable, rows: ^[Int], text: String, row: Int) Never! {
    id: name_index(name_intern(names, text))
    loop rows.len() <= id -> rows.push(NAME_COLUMN_UNBOUND)
    if rows[id] < 0 -> rows[id] = row
}

// The keys `rows` binds to a row >= 0 and their rows, in ascending key
// order.
name_column_sorted: fn(names: NameTable, rows: [Int]) -> [{key: String, local: Int}] Never! {
    ^run: [{key: String, local: Int}]{}
    loop id in 0..<rows.len() {
        if rows[id] >= 0 -> run.push({key: names.texts[id].copy(), local: rows[id]})
    }
    run.sort()
    run
}

#Test("a name column binds, replaces, keeps a first row and reads markers") {
    ^names: name_column_table()
    ^rows: name_column()
    assert_eq(name_column_get(names, rows, ""), None)
    assert_eq(name_column_value(names, rows, "a"), None)
    name_column_set(names, rows, "b", 2)
    name_column_set(names, rows, "a", 1)
    name_column_set_first(names, rows, "a", 5)
    assert_eq(name_column_get(names, rows, "a"), Val(1))
    name_column_set(names, rows, "b", -1)
    assert_eq(name_column_get(names, rows, "b"), None)
    assert_eq(name_column_value(names, rows, "b"), Val(-1))
    name_column_set_first(names, rows, "b", 7)
    assert_eq(name_column_get(names, rows, "b"), Val(7))
}
