// Interned spellings (SP08a). A lexed source keeps one `NameTable`: every
// distinct spelling is stored once and named by a dense `Name` id, so tokens
// carry ids instead of Strings and equal spellings compare as equal ids.
// Ids are assigned in first-seen order, so one source always gets the same
// ids. Text is resolved only where a String is needed (`name_text`).
//
// Lookup is an open-addressing hash over the spelling bytes (FNV-1a), so a
// source range interns without building a String first.

struct Name {
    id: U32
}

struct NameTable {
    // The spelling of each id, resolved without decoding bytes again.
    texts: [String]
    // Every spelling's bytes, back to back; id `n` ends at `ends[n]` and
    // starts where id `n - 1` ends.
    bytes: [U8]
    ends: [Int]
    // Each id's `name_hash`: a probe compares bytes only against an entry
    // with the same hash, and a grow never hashes a spelling again.
    hashes: [Int]
    // Open-addressing slots: 0 is empty, otherwise the id plus one.
    slots: [Int]
    mask: Int
}

NAME_TABLE_INITIAL_SLOTS :: 1024

// A table whose id 0 is the empty spelling (`name_empty`).
fn name_table() -> NameTable Never! {
    slots := [Int]{}
    loop _ in 0..<NAME_TABLE_INITIAL_SLOTS -> &slots.push(0)
    table := NameTable{texts: [String]{}, bytes: [U8]{}, ends: [Int]{}, hashes: [Int]{}, slots: slots, mask: NAME_TABLE_INITIAL_SLOTS - 1}
    name_intern_bytes(&table, [U8]{}, 0, 0)
    table
}

// The empty spelling; every `name_table()` interns it first.
fn name_empty() -> Name Never! {
    Name{id: U32{0}}
}

fn name_index(name: Name) -> Int Never! {
    Int.from_u32(name.id)
}

fn name_text(table: NameTable, name: Name) -> String Never! {
    table.texts[Int.from_u32(name.id)]
}

fn name_count(table: NameTable) -> Int Never! {
    table.texts.len()
}

fn name_start(table: NameTable, id: Int) -> Int Never! {
    if id == 0 -> 0 else -> table.ends[id - 1]
}

fn name_hash(bytes: [U8], start: Int, end: Int) -> Int Never! {
    hash := U32{0x811c9dc5}
    loop index in start..<end -> hash = (hash.bit_xor(U32.from_u8(bytes[index]))).wrapping_mul(U32{0x01000193})
    Int.from_u32(hash)
}

// Whether id `id` spells `bytes[start..<end]`, whose `name_hash` is `hash`.
fn name_bytes_equal(table: NameTable, id: Int, hash: Int, bytes: [U8], start: Int, end: Int) -> Bool Never! {
    if table.hashes[id] != hash -> return false
    first :: name_start(table, id)
    if table.ends[id] - first != end - start -> return false
    loop offset in 0..<(end - start) {
        if table.bytes[first + offset] != bytes[start + offset] -> return false
    }
    true
}

// The id of `bytes[start..<end]`, interning it when it is new. A spelling
// that is not UTF-8 resolves to "" but keeps its own id.
fn name_intern_bytes(table: &NameTable, bytes: [U8], start: Int, end: Int) -> Name Never! {
    hash :: name_hash(bytes, start, end)
    slot := hash.bit_and(table.mask)
    loop table.slots[slot] != 0 {
        id :: table.slots[slot] - 1
        if name_bytes_equal(table, id, hash, bytes, start, end) -> return Name{id: U32{id}}
        slot = (slot + 1).bit_and(table.mask)
    }
    id :: table.texts.len()
    &table.bytes.extend(bytes[start..<end])
    &table.ends.push(table.bytes.len())
    &table.hashes.push(hash)
    &table.texts.push(String.from_bytes(bytes.slice(start, end)) ?? "")
    table.slots[slot] = id + 1
    if (id + 1) * 2 > table.mask -> name_table_grow(&table)
    Name{id: U32{id}}
}

// The id of `text` when the table holds it; never interns.
fn name_find(table: NameTable, text: String) -> Name? Never! {
    bytes :: text.bytes()
    name_find_bytes(table, bytes, 0, bytes.len())
}

// The id of `bytes[start..<end]` when the table holds that spelling; never
// interns.
fn name_find_bytes(table: NameTable, bytes: [U8], start: Int, end: Int) -> Name? Never! {
    hash :: name_hash(bytes, start, end)
    slot := hash.bit_and(table.mask)
    loop table.slots[slot] != 0 {
        id :: table.slots[slot] - 1
        if name_bytes_equal(table, id, hash, bytes, start, end) -> return Val(Name{id: U32{id}})
        slot = (slot + 1).bit_and(table.mask)
    }
    None
}

fn name_intern(table: &NameTable, text: String) -> Name Never! {
    bytes :: text.bytes()
    name_intern_bytes(&table, bytes, 0, bytes.len())
}

fn name_table_grow(table: &NameTable) Never! {
    capacity :: (table.mask + 1) * 2
    mask :: capacity - 1
    slots := [Int]{}
    loop _ in 0..<capacity -> &slots.push(0)
    loop id in 0..<table.texts.len() {
        slot := table.hashes[id].bit_and(mask)
        loop slots[slot] != 0 -> slot = (slot + 1).bit_and(mask)
        slots[slot] = id + 1
    }
    table.slots = ^slots
    table.mask = mask
}

// The low 30 bits of `text.hash()`: a small Int whose low bits index slots.
// A lookup computes it once (in place, no byte copy) and passes it with the
// spelling to every `NameRows` it visits.
fn name_rows_hash(text: String) -> Int Never! {
    Int.from_u64(text.hash().bit_and(U64{0x3fffffff}))
}

// A String -> Int map (A1): open addressing over each key's `s.hash()`.
// A lookup hashes its key once and compares one candidate instead of
// binary-searching String keys, and one hash serves every map a lookup
// visits. Values are non-negative rows; -1 marks a removed key.
struct NameRows {
    texts: [String]
    hashes: [Int]
    rows: [Int]
    // Open-addressing slots: 0 is empty, otherwise the key index plus one.
    slots: [Int]
    mask: Int
}

NAME_ROWS_INITIAL_SLOTS :: 16

fn name_rows() -> NameRows Never! {
    slots := [Int]{}
    loop _ in 0..<NAME_ROWS_INITIAL_SLOTS -> &slots.push(0)
    NameRows{texts: [String]{}, hashes: [Int]{}, rows: [Int]{}, slots: slots, mask: NAME_ROWS_INITIAL_SLOTS - 1}
}

// The key index of `text` (whose name_rows_hash is `hash`), if the map ever
// held it.
fn name_rows_key(map: NameRows, text: String, hash: Int) -> Int? Never! {
    slot := hash.bit_and(map.mask)
    loop map.slots[slot] != 0 {
        key :: map.slots[slot] - 1
        if map.hashes[key] == hash && map.texts[key] == text -> return Val(key)
        slot = (slot + 1).bit_and(map.mask)
    }
    None
}

// Binds `text` to `row` (>= 0), replacing any earlier value.
fn name_rows_set(map: &NameRows, text: String, row: Int) Never! {
    name_rows_set_hashed(&map, text, name_rows_hash(text), row)
}

// name_rows_set for a `text` whose name_rows_hash is `hash`.
fn name_rows_set_hashed(map: &NameRows, text: String, hash: Int, row: Int) Never! {
    if name_rows_key(map, text, hash) == .Val(key) {
        map.rows[key] = row
        return
    }
    name_rows_append(&map, text, hash, row)
}

// Binds `text` to `row` (>= 0) unless it is bound: a key's first row stands.
// One hash serves the probe and the insert.
fn name_rows_set_first(map: &NameRows, text: String, row: Int) Never! {
    hash :: name_rows_hash(text)
    if name_rows_key(map, text, hash) == .Val(key) {
        if map.rows[key] < 0 -> map.rows[key] = row
        return
    }
    name_rows_append(&map, text, hash, row)
}

// Adds `text`, which the map never held, bound to `row`.
fn name_rows_append(map: &NameRows, text: String, hash: Int, row: Int) Never! {
    key :: map.texts.len()
    // copy: the map keeps its own key; `text` stays with the caller.
    &map.texts.push(text.copy())
    &map.hashes.push(hash)
    &map.rows.push(row)
    if (key + 1) * 2 > map.mask {
        name_rows_grow(&map)
        return
    }
    slot := hash.bit_and(map.mask)
    loop map.slots[slot] != 0 -> slot = (slot + 1).bit_and(map.mask)
    map.slots[slot] = key + 1
}

// Rebuilds the slots at twice the capacity from the stored hashes.
fn name_rows_grow(map: &NameRows) Never! {
    capacity :: (map.mask + 1) * 2
    mask :: capacity - 1
    slots := [Int]{}
    loop _ in 0..<capacity -> &slots.push(0)
    loop key in 0..<map.texts.len() {
        slot := map.hashes[key].bit_and(mask)
        loop slots[slot] != 0 -> slot = (slot + 1).bit_and(mask)
        slots[slot] = key + 1
    }
    map.slots = ^slots
    map.mask = mask
}

// The value of `text` (whose name_rows_hash is `hash`), if bound.
fn name_rows_get(map: NameRows, text: String, hash: Int) -> Int? Never! {
    key :: name_rows_key(map, text, hash) ?? return None
    if map.rows[key] < 0 -> return None
    Val(map.rows[key])
}

fn name_rows_get_text(map: NameRows, text: String) -> Int? Never! {
    name_rows_get(map, text, name_rows_hash(text))
}

// Unbinds `text`; its key stays for a later `name_rows_set`.
fn name_rows_remove(map: &NameRows, text: String) Never! {
    key :: name_rows_key(map, text, name_rows_hash(text)) ?? return
    map.rows[key] = -1
}
