// Interned spellings (SP08a). A lexed source keeps one `NameTable`: every
// distinct spelling is stored once and named by a dense `Name` id, so tokens
// carry ids instead of Strings and equal spellings compare as equal ids.
// Ids are assigned in first-seen order, so one source always gets the same
// ids. Text is resolved only where a String is needed (`name_text`).
//
// Lookup is an open-addressing hash over the spelling bytes (FNV-1a), so a
// source range interns without building a String first.

Name: struct {
    id: U32
}

NameTable: struct {
    // The spelling of each id, resolved without decoding bytes again.
    texts: [String]
    // Every spelling's bytes, back to back; id `n` ends at `ends[n]` and
    // starts where id `n - 1` ends.
    bytes: [U8]
    ends: [Int]
    // Each id's `name_hash`: a probe compares bytes only against an entry
    // with the same hash, and a grow never hashes a spelling again.
    hashes: [Int]
    // Open-addressing slots: 0 is empty, otherwise the id plus one.
    slots: [Int]
    mask: Int
}

NAME_TABLE_INITIAL_SLOTS: 1024

// A table whose id 0 is the empty spelling (`name_empty`).
name_table: fn() -> NameTable Never! {
    name_table_sized(NAME_TABLE_INITIAL_SLOTS)
}

// An empty table of at least `slots` slots to start; it grows as
// `name_table` does. A small table (a body's own symbol keys) starts small.
// A probe steps through the slots masked by their count less one, which
// visits every slot only for a power of two: `slots` rounds up to one.
name_table_sized: fn(slots: Int) -> NameTable Never! {
    capacity := 2
    loop capacity < slots -> capacity *= 2
    initial := [Int]{}
    loop _ in 0..<capacity -> initial.push(0)
    table := NameTable{texts: [String]{}, bytes: [U8]{}, ends: [Int]{}, hashes: [Int]{}, slots: initial, mask: capacity - 1}
    name_intern_bytes(table, [U8]{}, 0, 0)
    table
}

// The empty spelling; every `name_table()` interns it first.
name_empty: fn() -> Name Never! {
    Name{id: U32{0}}
}

name_index: fn(name: Name) -> Int Never! {
    Int{name.id}
}

name_text: fn(table: NameTable, name: Name) -> String Never! {
    table.texts[Int{name.id}]
}

name_count: fn(table: NameTable) -> Int Never! {
    table.texts.len()
}

name_start: fn(table: NameTable, id: Int) -> Int Never! {
    if id == 0 -> 0 else -> table.ends[id - 1]
}

name_hash: fn(bytes: [U8], start: Int, end: Int) -> Int Never! {
    hash := U32{0x811c9dc5}
    loop index in start..<end -> hash = wrapping((hash.bit_xor(U32{bytes[index]})) * U32{0x01000193})
    Int{hash}
}

// Whether id `id` spells `bytes[start..<end]`, whose `name_hash` is `hash`.
name_bytes_equal: fn(table: NameTable, id: Int, hash: Int, bytes: [U8], start: Int, end: Int) -> Bool Never! {
    if table.hashes[id] != hash -> return false
    first: name_start(table, id)
    if table.ends[id] - first != end - start -> return false
    loop offset in 0..<(end - start) {
        if table.bytes[first + offset] != bytes[start + offset] -> return false
    }
    true
}

// The id of `bytes[start..<end]`, interning it when it is new. A spelling
// that is not UTF-8 resolves to "" but keeps its own id.
name_intern_bytes: fn(table: &NameTable, bytes: [U8], start: Int, end: Int) -> Name Never! {
    hash: name_hash(bytes, start, end)
    slot := hash.bit_and(table.mask)
    loop table.slots[slot] != 0 {
        id: table.slots[slot] - 1
        if name_bytes_equal(table, id, hash, bytes, start, end) -> return Name{id: U32{id}}
        slot = (slot + 1).bit_and(table.mask)
    }
    id: table.texts.len()
    table.bytes.extend(bytes[start..<end])
    table.ends.push(table.bytes.len())
    table.hashes.push(hash)
    table.texts.push(String.from_bytes(bytes.slice(start, end)) ?? "")
    table.slots[slot] = id + 1
    if (id + 1) * 2 > table.mask -> name_table_grow(table)
    Name{id: U32{id}}
}

// The id of `text` when the table holds it; never interns.
name_find: fn(table: NameTable, text: String) -> Name? Never! {
    bytes: text.bytes()
    name_find_bytes(table, bytes, 0, bytes.len())
}

// The id of `bytes[start..<end]` when the table holds that spelling; never
// interns.
name_find_bytes: fn(table: NameTable, bytes: [U8], start: Int, end: Int) -> Name? Never! {
    hash: name_hash(bytes, start, end)
    slot := hash.bit_and(table.mask)
    loop table.slots[slot] != 0 {
        id: table.slots[slot] - 1
        if name_bytes_equal(table, id, hash, bytes, start, end) -> return Val(Name{id: U32{id}})
        slot = (slot + 1).bit_and(table.mask)
    }
    None
}

name_intern: fn(table: &NameTable, text: String) -> Name Never! {
    bytes: text.bytes()
    name_intern_bytes(table, bytes, 0, bytes.len())
}

name_table_grow: fn(table: &NameTable) Never! {
    capacity: (table.mask + 1) * 2
    mask: capacity - 1
    slots := [Int]{}
    loop _ in 0..<capacity -> slots.push(0)
    loop id in 0..<table.texts.len() {
        slot := table.hashes[id].bit_and(mask)
        loop slots[slot] != 0 -> slot = (slot + 1).bit_and(mask)
        slots[slot] = id + 1
    }
    table.slots = slots.move()
    table.mask = mask
}

// A table's lookup columns (`bytes`, `ends`, `hashes` and `slots`) follow
// from its texts and its mask, so a stored table may leave them out
// (name_table_index_drop) for the reader to rebuild them
// (name_table_index_rebuild). Every spelling of a table that interned only
// Strings is its text's bytes, so the rebuild gives the columns the interns
// left: ids placed in id order, as a grow places them.
name_table_index_drop: fn(table: &NameTable) Never! {
    table.bytes = [U8]{}
    table.ends = [Int]{}
    table.hashes = [Int]{}
    table.slots = [Int]{}
}

name_table_index_rebuild: fn(table: &NameTable) Never! {
    bytes := [U8]{}
    ends := [Int]{}
    hashes := [Int]{}
    slots := [Int]{}
    loop _ in 0..<table.mask + 1 -> slots.push(0)
    loop (id, text) in table.texts {
        spelled: text.bytes()
        hash: name_hash(spelled, 0, spelled.len())
        bytes.extend(spelled)
        ends.push(bytes.len())
        hashes.push(hash)
        slot := hash.bit_and(table.mask)
        loop slots[slot] != 0 -> slot = (slot + 1).bit_and(table.mask)
        slots[slot] = id + 1
    }
    table.bytes = bytes.move()
    table.ends = ends.move()
    table.hashes = hashes.move()
    table.slots = slots.move()
}

// Loaded modules by identity (#6793, Docs/spec/compiler-data.md). The loader
// interns each module's identity text once, as it first meets it; every later phase
// names a module by its `ModuleID` and resolves the text only at an edge (a
// diagnostic, a cache or symbol key, a tool record) with `module_text`. Id 0
// is the empty identity: no module.
//
// The id's top bit marks a Core source's identity (`<corelib>/...`), so the
// Core test needs no table; the low 31 bits are the table row.
ModuleID: struct {
    id: U32
}

ModuleTable: struct {
    identities: NameTable
}

MODULE_CORE_PREFIX: "<corelib>/"
MODULE_CORE_BIT: U32{0x80000000}
MODULE_ROW_BITS: U32{0x7fffffff}

module_table: fn() -> ModuleTable Never! {
    ModuleTable{identities: name_table()}
}

module_none: fn() -> ModuleID Never! {
    ModuleID{id: U32{0}}
}

module_is_none: fn(module_id: ModuleID) -> Bool Never! {
    module_id.id == U32{0}
}

// The table row of `module_id`: 0 for no module, below `module_count`.
module_index: fn(module_id: ModuleID) -> Int Never! {
    Int{module_id.id.bit_and(MODULE_ROW_BITS)}
}

module_count: fn(table: ModuleTable) -> Int Never! {
    name_count(table.identities)
}

module_is_core: fn(module_id: ModuleID) -> Bool Never! {
    module_id.id.bit_and(MODULE_CORE_BIT) != U32{0}
}

module_id_of: fn(name: Name, text: String) -> ModuleID Never! {
    if text.starts_with(MODULE_CORE_PREFIX) -> return ModuleID{id: name.id.bit_or(MODULE_CORE_BIT)}
    ModuleID{id: name.id}
}

// The id of identity `text`, interned when it is new.
module_intern: fn(table: &ModuleTable, text: String) -> ModuleID Never! {
    module_id_of(name_intern(table.identities, text), text)
}

// The id of identity `text`, None when the table has no such identity.
module_find: fn(table: ModuleTable, text: String) -> ModuleID? Never! {
    name: name_find(table.identities, text) ?? return None
    Val(module_id_of(name, text))
}

module_text: fn(table: ModuleTable, module_id: ModuleID) -> String Never! {
    table.identities.texts[module_index(module_id)]
}

// The low 30 bits of `text.hash()`: a small Int whose low bits index slots.
// A lookup computes it once (in place, no byte copy) and passes it with the
// spelling to every `NameRows` it visits.
name_rows_hash: fn(text: String) -> Int Never! {
    Int{text.hash().bit_and(U64{0x3fffffff})}
}

// A String -> Int map (A1): open addressing over each key's `s.hash()`.
// A lookup hashes its key once and compares one candidate instead of
// binary-searching String keys, and one hash serves every map a lookup
// visits. Values are non-negative rows; -1 marks a removed key.
NameRows: struct {
    texts: [String]
    hashes: [Int]
    rows: [Int]
    // Open-addressing slots: 0 is empty, otherwise the key index plus one.
    slots: [Int]
    mask: Int
}

NAME_ROWS_INITIAL_SLOTS: 16

name_rows: fn() -> NameRows Never! {
    slots := [Int]{}
    loop _ in 0..<NAME_ROWS_INITIAL_SLOTS -> slots.push(0)
    NameRows{texts: [String]{}, hashes: [Int]{}, rows: [Int]{}, slots: slots, mask: NAME_ROWS_INITIAL_SLOTS - 1}
}

// The key index of `text` (whose name_rows_hash is `hash`), if the map ever
// held it.
name_rows_key: fn(map: NameRows, text: String, hash: Int) -> Int? Never! {
    slot := hash.bit_and(map.mask)
    loop map.slots[slot] != 0 {
        key: map.slots[slot] - 1
        if map.hashes[key] == hash && map.texts[key] == text -> return Val(key)
        slot = (slot + 1).bit_and(map.mask)
    }
    None
}

// Binds `text` to `row`, replacing any earlier value. A negative `row` reads
// as unbound to name_rows_get and as itself to name_rows_value.
name_rows_set: fn(map: &NameRows, text: String, row: Int) Never! {
    name_rows_set_hashed(map, text, name_rows_hash(text), row)
}

// name_rows_set for a `text` whose name_rows_hash is `hash`.
name_rows_set_hashed: fn(map: &NameRows, text: String, hash: Int, row: Int) Never! {
    if name_rows_key(map, text, hash) == .Val(key) {
        map.rows[key] = row
        return
    }
    name_rows_append(map, text, hash, row)
}

// Binds `text` to `row` (>= 0) unless it is bound: a key's first row stands.
// One hash serves the probe and the insert.
name_rows_set_first: fn(map: &NameRows, text: String, row: Int) Never! {
    hash: name_rows_hash(text)
    if name_rows_key(map, text, hash) == .Val(key) {
        if map.rows[key] < 0 -> map.rows[key] = row
        return
    }
    name_rows_append(map, text, hash, row)
}

// Adds `text`, which the map never held, bound to `row`.
name_rows_append: fn(map: &NameRows, text: String, hash: Int, row: Int) Never! {
    key: map.texts.len()
    // copy: the map keeps its own key; `text` stays with the caller.
    map.texts.push(text.copy())
    map.hashes.push(hash)
    map.rows.push(row)
    if (key + 1) * 2 > map.mask {
        name_rows_grow(map)
        return
    }
    slot := hash.bit_and(map.mask)
    loop map.slots[slot] != 0 -> slot = (slot + 1).bit_and(map.mask)
    map.slots[slot] = key + 1
}

// Rebuilds the slots at twice the capacity from the stored hashes.
name_rows_grow: fn(map: &NameRows) Never! {
    capacity: (map.mask + 1) * 2
    mask: capacity - 1
    slots := [Int]{}
    loop _ in 0..<capacity -> slots.push(0)
    loop key in 0..<map.texts.len() {
        slot := map.hashes[key].bit_and(mask)
        loop slots[slot] != 0 -> slot = (slot + 1).bit_and(mask)
        slots[slot] = key + 1
    }
    map.slots = slots.move()
    map.mask = mask
}

// The value of `text` (whose name_rows_hash is `hash`), if bound.
name_rows_get: fn(map: NameRows, text: String, hash: Int) -> Int? Never! {
    key: name_rows_key(map, text, hash) ?? return None
    if map.rows[key] < 0 -> return None
    Val(map.rows[key])
}

name_rows_get_text: fn(map: NameRows, text: String) -> Int? Never! {
    name_rows_get(map, text, name_rows_hash(text))
}

// The value bound to `text` whatever its sign, if `text` was ever bound: for
// a map that removes no key and whose negative values are markers of its own
// (the IR's key tables: a failed helper, a memo of "none").
name_rows_value: fn(map: NameRows, text: String) -> Int? Never! {
    key: name_rows_key(map, text, name_rows_hash(text)) ?? return None
    Val(map.rows[key])
}

// The bound keys and values in ascending key order (removed keys left out).
name_rows_sorted: fn(map: NameRows) -> [(key: String, local: Int)] Never! {
    run := [(key: String, local: Int)]{}
    loop (key, text) in map.texts {
        if map.rows[key] >= 0 -> run.push((key: text.copy(), local: map.rows[key]))
    }
    run.sort()
    run
}

// Unbinds `text`; its key stays for a later `name_rows_set`.
name_rows_remove: fn(map: &NameRows, text: String) Never! {
    key: name_rows_key(map, text, name_rows_hash(text)) ?? return
    map.rows[key] = -1
}
