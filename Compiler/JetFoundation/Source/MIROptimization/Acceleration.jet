// Rust: crates/jet-foundation/src/MIROptimization/Acceleration.rs:455
fn acceleration_object(value: CanonicalJSON, label: String) -> [CanonicalJSONField] Err! {
    if value == { .Object(fields) -> Ok(fields) else -> Err("{label} must be a canonical object") }
}
// CanonicalJSON's sorted field carrier provides the same logarithmic lookup as
// Rust's BTreeMap without copying the complete value or building a second map.
fn acceleration_field(fields: [CanonicalJSONField], key: String) -> CanonicalJSON? Never! {
    low := 0
    high := fields.len()
    loop low < high {
        middle :: low + (high - low) /% 2
        if fields[middle].key < key -> low = middle + 1 else -> high = middle
    }
    if low < fields.len() && fields[low].key == key -> Val(fields[low].value) else -> None
}
// Rust: crates/jet-foundation/src/MIROptimization/Acceleration.rs:465
fn acceleration_require_fields(fields: [CanonicalJSONField], label: String, keys: [String]) Err! {
    if fields.len() != keys.len() -> return Err("{label} has missing or unknown fields")
    loop key in keys {
        if acceleration_field(fields, key) == None -> return Err("{label} has missing or unknown fields")
    }
    Ok()
}
// Rust: crates/jet-foundation/src/MIROptimization/Acceleration.rs:476
fn acceleration_string(fields: [CanonicalJSONField], key: String) -> String Err! {
    value :: acceleration_field(fields, key) ?? return Err("acceleration field `{key}` is missing")
