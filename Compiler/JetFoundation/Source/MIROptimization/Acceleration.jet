}
// Rust: crates/jet-foundation/src/MIROptimization/Acceleration.rs:487
fn acceleration_pin(value: CanonicalJSON) -> AccelerationPin Err! {
    if value == {
        .Null -> Err("pinned acceleration decision is missing pin")
        .String(value) -> if value == {
