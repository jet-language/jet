// Exact Rust unsigned decimal parser domain; optional '+' is accepted, '-' and
// whitespace are not. U64 overflow is checked before each multiply/add.
fn acceleration_parse_unsigned(text: String, maximum: U64, key: String) -> U64 Err! {
    bytes :: text.bytes()
    start :: if bytes.len() > 0 && bytes[0] == U8{43} -> 1 else -> 0
    if start == bytes.len() -> return Err("acceleration field `{key}` is out of range")
    value := U64{0}
    loop index in start..<bytes.len() {
        byte :: bytes[index]
        if byte < U8{48} || byte > U8{57} -> return Err("acceleration field `{key}` is out of range")
        digit :: U64.from_u8(byte - U8{48})
        if digit > maximum || value > (maximum - digit) / U64{10} -> return Err("acceleration field `{key}` is out of range")
        value = value * U64{10} + digit
    }
    Ok(value)
}
// Rust: crates/jet-foundation/src/MIROptimization/Acceleration.rs:499
fn acceleration_u64(fields: [CanonicalJSONField], key: String) -> U64 Err! {
    value :: acceleration_field(fields, key) ?? return Err("acceleration field `{key}` is missing")
    if value == {
        .Integer(text) -> acceleration_parse_unsigned(text, U64{0xffffffffffffffff}, key)
        else -> Err("acceleration field `{key}` must be an integer")
    }
}
// Rust: crates/jet-foundation/src/MIROptimization/Acceleration.rs:512
fn acceleration_usize(fields: [CanonicalJSONField], key: String) -> Int Err! {
    value :: acceleration_field(fields, key) ?? return Err("acceleration field `{key}` is missing")
    if value == {
        .Integer(text) -> {
            // GATE #4483: execution target usize width, never host assumptions.
            Ok(Int.from_u64(acceleration_parse_unsigned(text, acceleration_target_facts.usize_max(), key)))
        }
        else -> Err("acceleration field `{key}` must be an integer")
    }
}
// Rust: crates/jet-foundation/src/MIROptimization/Acceleration.rs:525
fn acceleration_optional_u64(fields: [CanonicalJSONField], key: String) -> U64? Err! {
    value :: acceleration_field(fields, key) ?? return Err("acceleration field `{key}` is missing")
    if value == {
        .Null -> Ok(None)
        .Integer(text) -> Ok(Val(acceleration_parse_unsigned(text, U64{0xffffffffffffffff}, key)))
        else -> Err("acceleration field `{key}` must be an integer or null")
    }
}

// Rust: crates/jet-foundation/src/MIROptimization/Acceleration.rs:543
pub struct AccelerationGate {
    pub static_floor_items: Int
    pub cache_block_bytes: Int
    pub required_gain_numerator: U64
    pub required_gain_denominator: U64
}
impl AccelerationGate {
    // Rust: crates/jet-foundation/src/MIROptimization/Acceleration.rs:551
    pub fn d_accel1() -> AccelerationGate Never! {
        AccelerationGate{static_floor_items: D_ACCEL_STATIC_FLOOR_ITEMS,
            cache_block_bytes: D_ACCEL_CACHE_BLOCK_BYTES,
            required_gain_numerator: D_ACCEL_REQUIRED_GAIN_NUMERATOR,
            required_gain_denominator: D_ACCEL_REQUIRED_GAIN_DENOMINATOR}
    }
    // Rust: crates/jet-foundation/src/MIROptimization/Acceleration.rs:560
    pub fn should_measure(self, items: Int) -> Bool Never! { items > self.static_floor_items }
    // Rust: crates/jet-foundation/src/MIROptimization/Acceleration.rs:564
    pub fn evaluate(self, transform: MIRAccelerationTransform, input: AccelerationGateInput) -> AccelerationDecision Never! {
        measurement :: self.measurement(input)
        status :: if {
            input.items <= self.static_floor_items -> AccelerationGateStatus.BelowStaticFloor
            input.pin != None -> AccelerationGateStatus.Pinned{pin: input.pin ?? panic("pin was present")}
            !input.release_build -> AccelerationGateStatus.NotReleaseBuild
            !input.cross_mode_parity_proven -> AccelerationGateStatus.CrossModeParityMissing
            transform == MIRAccelerationTransform.TransientColumnCopy && !input.workload.column_copy_applicable() -> AccelerationGateStatus.ColumnCopyNotApplicable
            !input.proof.proves(transform) -> AccelerationGateStatus.ProofIncomplete
            !input.first_chunk_serial_timed -> AccelerationGateStatus.SampleNotTimed
            !input.spawn_cost_once_per_process -> AccelerationGateStatus.SpawnCostNotMeasured
            !input.bandwidth_floor_measured -> AccelerationGateStatus.BandwidthFloorNotMeasured
            input.sample_items == 0 || input.sample_items > input.items || input.sample_nanos == U64{0} || input.spawn_nanos == U64{0} || input.bandwidth_floor_nanos == U64{0} || self.required_gain_numerator == U64{0} || self.required_gain_denominator == U64{0} -> AccelerationGateStatus.InvalidMeasurement
            measurement.projected_serial_nanos == None || measurement.required_serial_nanos == None -> AccelerationGateStatus.InvalidMeasurement
            (measurement.projected_serial_nanos ?? U64{0}) < (measurement.required_serial_nanos ?? U64{0}) -> AccelerationGateStatus.ProjectedGainBelowThreshold
            else -> AccelerationGateStatus.Selected
        }
        decision :: AccelerationDecision{transform: transform, status: status, measurement: measurement}
        // This existing typed producer preserves the exact CanonicalPass enabled
        // branch, input/output Debug payloads, identities and checked premises.
        canonical_pass_record_acceleration(input, decision)
        decision
    }
    // Rust: crates/jet-foundation/src/MIROptimization/Acceleration.rs:630
    fn measurement(self, input: AccelerationGateInput) -> AccelerationMeasurement Never! {
        floor_nanos :: if input.spawn_nanos > input.bandwidth_floor_nanos -> input.spawn_nanos else -> input.bandwidth_floor_nanos
        items :: U64.from_int(input.items)
        sample_items :: U64.from_int(input.sample_items)
        projected_serial_nanos :: if items == {
            .Val(items) -> if sample_items == {
                .Val(count) -> if count != U64{0} -> acceleration_project(input.sample_nanos, items, count) else -> None
                None -> None
            }
            None -> None
        }
        required_serial_nanos :: if self.required_gain_denominator == U64{0} -> None
            else -> acceleration_project(floor_nanos, self.required_gain_numerator, self.required_gain_denominator)
        AccelerationMeasurement{items: input.items, sample_items: input.sample_items,
            sample_nanos: input.sample_nanos, spawn_nanos: input.spawn_nanos,
            bandwidth_floor_nanos: input.bandwidth_floor_nanos, floor_nanos: floor_nanos,
            projected_serial_nanos: projected_serial_nanos, required_serial_nanos: required_serial_nanos}
    }
    // Rust: crates/jet-foundation/src/MIROptimization/Acceleration.rs:667
    pub fn default() -> AccelerationGate Never! { AccelerationGate.d_accel1() }
}
// Rust: crates/jet-foundation/src/MIROptimization/Acceleration.rs:638-651
fn acceleration_project(value: U64, factor: U64, divisor: U64) -> U64? Never! {
    maximum :: U64{0xffffffffffffffff}
    if factor != U64{0} && value > maximum / factor -> return None
    product :: value * factor
    rounding :: divisor - U64{1}
    if product > maximum - rounding -> return None
    Val((product + rounding) / divisor)
}
// #4494/#4499/#4409 are not applicable: supplied numeric facts only, no clock,
// worker, allocation primitive, composite map key or IO operation in Rust 1-670.
