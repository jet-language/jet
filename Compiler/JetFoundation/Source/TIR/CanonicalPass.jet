// Structured source-backed snapshots for the checked-program boundary.
use jet_foundation.[CanonicalPassSnapshot, Item, TFunc, AccessConvention, foundation_json_quote, type_name]

fn canonical_pass_tir_snapshot(package: String, source_file: String, edition: String, functions: [TFunc]) -> CanonicalPassSnapshot Never! {
    rows := [String]{}
    identities := [String]{}
    loop (index, function) in functions {
        parameters := [String]{}
        loop parameter in function.params {
            convention :: if parameter.convention == {
                .Read -> "Read"
                .Write -> "Write"
                .Move -> "Move"
            }
            &parameters.push("{{\"name\":{foundation_json_quote(parameter.name)},\"type\":{foundation_json_quote(type_name(parameter.ty))},\"convention\":{foundation_json_quote(convention)}}}")
        }
        ret := "null"
        if function.ret == .Val(ty) -> ret = foundation_json_quote(type_name(ty))
        &rows.push("{{\"index\":{index},\"name\":{foundation_json_quote(function.name)},\"module\":{foundation_json_quote(function.module_name)},\"key\":{foundation_json_quote(function.key)},\"source_file\":{foundation_json_quote(function.source_file)},\"source_span\":{{\"start\":{function.source_span.start},\"end\":{function.source_span.end}}},\"params\":[{parameters.join(",")}],\"ret\":{ret},\"body_nodes\":{function.body.len()},\"is_main\":{function.is_main},\"synthetic\":{function.synthetic}}}")
        &identities.push("{{\"key\":{foundation_json_quote(function.key)},\"source_file\":{foundation_json_quote(function.source_file)},\"span\":{{\"start\":{function.source_span.start},\"end\":{function.source_span.end}}}}}")
    }
    CanonicalPassSnapshot{
        representation: "tir",
        payload: "{{\"representation\":\"tir\",\"package\":{foundation_json_quote(package)},\"source_file\":{foundation_json_quote(source_file)},\"edition\":{foundation_json_quote(edition)},\"functions\":[{rows.join(",")}]}}",
        identity: "{{\"representation\":\"tir\",\"package\":{foundation_json_quote(package)},\"functions\":[{identities.join(",")}]}}",
    }
}
fn canonical_pass_ast_items_snapshot(items: [Item]) -> CanonicalPassSnapshot Never! {
    rows := [String]{}
    loop (index, item) in items -> &rows.push("{{\"index\":{index},\"kind\":{foundation_json_quote(canonical_pass_ast_item_kind(item))}}}")
    CanonicalPassSnapshot{representation: "ast", payload: "{{\"representation\":\"ast\",\"items\":[{rows.join(",")}]}}", identity: "{{\"representation\":\"ast\",\"item_count\":{items.len()}}}"}
}
fn canonical_pass_ast_item_kind(item: Item) -> String Never! {
    if item == {
        .Func(_) -> "Func"
        .Struct(_) -> "Struct"
        .Enum(_) -> "Enum"
        .Distinct(_) -> "Distinct"
        .TypeAlias(_) -> "TypeAlias"
        .UnitFamily(_) -> "UnitFamily"
        .Trait(_) -> "Trait"
        .Tag(_) -> "Tag"
        .EffectDecl(_) -> "EffectDecl"
        .Impl(_) -> "Impl"
        .Const(_) -> "Const"
        .Test(_) -> "Test"
        .ExternRust(_) -> "ExternRust"
        .Module(_) -> "Module"
        .CModule(_) -> "CModule"
        .CodeModule(_) -> "CodeModule"
        .ErrorConv(_) -> "ErrorConv"
        .Migration(_) -> "Migration"
        .ProtocolDecl(_) -> "ProtocolDecl"
        .UserDerive(_) -> "UserDerive"
        .TemplateLoop(_) -> "TemplateLoop"
        .GenericModule(_) -> "GenericModule"
        .ModuleAlias(_) -> "ModuleAlias"
        .MarkerDecl(_) -> "MarkerDecl"
        .FactDecl(_) -> "FactDecl"
    }
}
fn canonical_pass_debug_snapshot(representation: String, operation_id: String, debug: String) -> CanonicalPassSnapshot Never! {
    prefix :: "{{\"representation\":{foundation_json_quote(representation)},\"operation_id\":{foundation_json_quote(operation_id)}"
    CanonicalPassSnapshot{representation: representation, payload: "{prefix},\"debug\":{foundation_json_quote(debug)}}}", identity: "{prefix},\"identity\":{foundation_json_quote(debug)}}}"}
}
