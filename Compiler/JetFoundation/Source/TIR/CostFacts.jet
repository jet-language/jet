// Frozen typed cost evidence, shared by lowering and its reporting consumers.
// Mirrors Rust TIR::cost_fact_for_expr; never inspect generated adapter text.
TCOST_I128_MIN :: -170141183460469231731687303715884105728
TCOST_I128_MAX :: 170141183460469231731687303715884105727
TCOST_INLINE_MIN :: -4611686018427387904
TCOST_INLINE_MAX :: 4611686018427387903

fn tir_cost_bounded(lo: Int, hi: Int) -> TIntegerBounds? Never! {
    if lo < TCOST_I128_MIN || hi > TCOST_I128_MAX -> return None
    Val(TIntegerBounds{lo: lo, hi: hi})
}

fn tir_cost_type_bounds(ty: Type) -> TIntegerBounds? Never! {
    if ty == {
        .InlineRange(_, lo, hi) -> tir_cost_bounded(lo, hi)
        .IntN(signed, bits) -> {
            if bits <= 0 || bits > 128 || (!signed && bits == 128) -> return None
            if signed {
                limit :: 1 << (bits - 1)
                return Val(TIntegerBounds{lo: -limit, hi: limit - 1})
            }
            Val(TIntegerBounds{lo: 0, hi: (1 << bits) - 1})
        }
        .Tagged(_, inner) -> tir_cost_type_bounds(inner)
        else -> None
    }
}

fn tir_cost_min(left: Int, right: Int) -> Int Never! { if left < right -> left else -> right }
fn tir_cost_max(left: Int, right: Int) -> Int Never! { if left > right -> left else -> right }

fn tir_cost_combine_bounds(op: TBinaryOp, left: TIntegerBounds, right: TIntegerBounds) -> TIntegerBounds? Never! {
    if op == {
        .Add -> return tir_cost_bounded(tir_cost_min(left.lo + right.lo, 0), tir_cost_max(left.hi + right.hi, 0))
        .Sub -> return tir_cost_bounded(tir_cost_min(left.lo - right.hi, 0), tir_cost_max(left.hi - right.lo, 0))
        .Mul -> {
            first :: left.lo * right.lo
            second :: left.lo * right.hi
            third :: left.hi * right.lo
            fourth :: left.hi * right.hi
            return tir_cost_bounded(tir_cost_min(tir_cost_min(first, second), tir_cost_min(third, fourth)), tir_cost_max(tir_cost_max(first, second), tir_cost_max(third, fourth)))
        }
        .FloorDiv -> {
            if right.lo <= 0 && right.hi >= 0 -> return None
            if left.lo == TCOST_I128_MIN && right.lo <= -1 && right.hi >= -1 -> return None
            first :: left.lo /% right.lo
            second :: left.lo /% right.hi
            third :: left.hi /% right.lo
            fourth :: left.hi /% right.hi
            return tir_cost_bounded(tir_cost_min(tir_cost_min(first, second), tir_cost_min(third, fourth)), tir_cost_max(tir_cost_max(first, second), tir_cost_max(third, fourth)))
        }
        .Mod | .Rem -> {
            if right.lo <= 0 && right.hi >= 0 -> return None
            if left.lo == 0 && left.hi == 0 -> return Val(integer_bounds_exact(0))
            if right.lo == TCOST_I128_MIN || right.hi == TCOST_I128_MIN -> return None
            low_abs :: if right.lo < 0 -> -right.lo else -> right.lo
            high_abs :: if right.hi < 0 -> -right.hi else -> right.hi
            magnitude :: tir_cost_max(low_abs, high_abs) - 1
            if right.hi < 0 -> return Val(TIntegerBounds{lo: -magnitude, hi: 0})
            return Val(TIntegerBounds{lo: 0, hi: magnitude})
        }
        else -> return None
    }
}

// The exact value an integer literal node spells. A literal beyond i64 is a
// BigInt constant.
fn tir_expr_literal_integer(expression: TExpr) -> Int? Never! {
    if expression.kind == {
        .IntLit(value, _) -> return Val(value)
        .CtLit(value) -> {
            if value == .BigInt(decimal) -> return Val(Int.parse(decimal) ?? return None)
        }
        else -> {}
    }
    None
}

// The bounds a node states by itself: an integer literal, a negated literal
// (a fixed-width operand crosses the checked Int-to-fixed conversion), or a
// local, which carries its binding's bounds. No other node states bounds.
fn tir_expr_known_bounds(expression: TExpr) -> TIntegerBounds? Never! {
    if expression.kind == {
        .Local(local) -> return local.integer_bounds
        .Unary(op, operand) -> {
            if op != TUnaryOp.Neg -> return None
            literal := tir_expr_literal_integer(operand)
            if operand.kind == .NumericMethod(receiver, operation) {
                if operation == .CheckedIntToFixed(_, _, _, _) -> literal = tir_expr_literal_integer(receiver)
            }
            number :: literal ?? return None
            return Val(integer_bounds_exact(-number))
        }
        else -> {}
    }
    value :: tir_expr_literal_integer(expression) ?? return None
    Val(integer_bounds_exact(value))
}

fn tir_cost_integer_bounds(expression: TExpr) -> TIntegerBounds? Never! {
    known :: tir_expr_known_bounds(expression)
    if known != None -> return known
    bounds := TIntegerBounds?{None}
    if expression.kind == {
        .CtLit(value) -> {
            if value == .Int(number) -> bounds = Val(integer_bounds_exact(number))
        }
        .NumericMethod(receiver, operation) -> {
            if operation == {
                .InlineRange(lo, hi, _) -> bounds = Val(TIntegerBounds{lo: lo, hi: hi})
                .CastAs(destination) -> {
                    if destination == "i64" && tir_cost_integer_bounds(receiver) == .Val(original) && original.lo >= -9223372036854775808 && original.hi <= 9223372036854775807 -> bounds = Val(original)
                }
                else -> {}
            }
        }
        .Unary(op, value) -> {
            if op == TUnaryOp.Neg && tir_cost_integer_bounds(value) == .Val(operand) {
                bounds = tir_cost_bounded(-operand.hi, -operand.lo)
            }
        }
        .Binary(op, _, _, left, right) -> {
            if tir_cost_integer_bounds(left) == .Val(lhs) && tir_cost_integer_bounds(right) == .Val(rhs) -> bounds = tir_cost_combine_bounds(op, lhs, rhs)
        }
        .OrFallback(value, fallback, _) -> {
            success := TIntegerBounds?{None}
            if value.ty == {
                .Option(inner) -> success = tir_cost_type_bounds(inner)
                .Result(ok, _) -> success = tir_cost_type_bounds(ok)
                else -> {}
            }
            if fallback == .Value(alternative) {
                if success == .Val(normal) && tir_cost_integer_bounds(alternative) == .Val(other) -> bounds = Val(TIntegerBounds{lo: tir_cost_min(normal.lo, other.lo), hi: tir_cost_max(normal.hi, other.hi)})
            } else { bounds = success }
        }
        else -> {}
    }
    if bounds != None -> bounds else -> tir_cost_type_bounds(expression.ty)
}

fn tir_cost_bounds_fit_inline(bounds: TIntegerBounds) -> Bool Never! {
    bounds.lo >= TCOST_INLINE_MIN && bounds.hi <= TCOST_INLINE_MAX
}

fn tir_cost_fact(expression: TExpr) -> TCostFact? Never! {
    if expression.kind == {
        .MaterializeView(_) -> return Val(TCostFact{kind: TCostKind.ViewMaterialization, state: TCostState.SemanticRemainder})
        .BuiltinMethod(receiver, operation, _) -> {
            if receiver.ty == .Map(_, _, _) && tir_builtin_mutates_receiver(operation) -> return Val(TCostFact{kind: TCostKind.CollectionCopyOnWrite, state: TCostState.SemanticRemainder})
        }
        .Binary(op, _, _, left, right) -> {
            if expression.ty == Type.Int && (op == TBinaryOp.Add || op == TBinaryOp.Sub || op == TBinaryOp.Mul) {
                state := TCostState.SemanticRemainder
                if tir_cost_integer_bounds(left) == .Val(lhs) && tir_cost_integer_bounds(right) == .Val(rhs) {
                    if tir_cost_combine_bounds(op, lhs, rhs) == .Val(result) && tir_cost_bounds_fit_inline(lhs) && tir_cost_bounds_fit_inline(rhs) && tir_cost_bounds_fit_inline(result) -> state = TCostState.OptimizerRemoved
                }
                return Val(TCostFact{kind: TCostKind.ExactIntSpill, state: state})
            }
        }
        .Unary(op, operand) -> {
            if expression.ty == Type.Int && op == TUnaryOp.Neg {
                state := TCostState.SemanticRemainder
                if tir_cost_integer_bounds(operand) == .Val(bounds) && tir_cost_bounds_fit_inline(bounds) {
                    if tir_cost_bounded(-bounds.hi, -bounds.lo) == .Val(result) && tir_cost_bounds_fit_inline(result) -> state = TCostState.OptimizerRemoved
                }
                return Val(TCostFact{kind: TCostKind.ExactIntSpill, state: state})
            }
        }
        .Index(base, _, kind, _, _, _) -> {
            if kind == TIndexKind.List && base.ty == .List(_) -> return Val(TCostFact{kind: TCostKind.RepresentationFallback, state: TCostState.SemanticRemainder})
        }
        else -> {}
    }
    if {
        expression.ty == .Option(_) -> {}
        expression.ty == .Result(_, _) -> {}
        else -> return None
    }
    construction :: if expression.kind == {
        .Absent | .Present(_) | .Ok(_) | .Err(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _)
        | .MethodCall(_, _, _, _) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _)
        | .ClosureMethod(_, _, _) | .HandleMethod(_, _, _) | .CoreCall(_, _, _, _, _, _, _) | .HostCall(_) | .DecodeUnder(_, _) | .OptionLift2(_, _, _)
        | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) -> true
        .DistinctConvert(_, _, _, _, fallible) -> fallible
        .UnitConvert(_, _, _, _, _, fallible, _, _, _) -> fallible
        else -> false
    }
    if construction -> Val(TCostFact{kind: TCostKind.OutcomeConstruction, state: TCostState.SemanticRemainder}) else -> None
}

fn tir_builtin_mutates_receiver(operation: TBuiltinOp) -> Bool Never! {
    if operation == {
        .Push | .TryPush | .TryReserve | .TryInsertMap | .TryStringPush | .Pop
        | .InsertMap | .AddNewMap | .MapSetDefault | .MapUpdate | .InsertList | .RemoveMap
        | .RemoveList(_, _) | .MapPopFirst | .ExtendList | .Reverse | .SwapList | .Sort | .SortDesc | .Clear
        | .SetInsert | .SetUpdate | .SetDifferenceUpdate | .SetIntersectionUpdate
        | .SetSymmetricDifferenceUpdate | .SetRemove | .SetPop | .SetReplace | .SortedSetInsert
        | .SortedSetRemove | .BitSetAdd | .BitSetRemove | .BagAdd | .BagRemove | .LRUPut
        | .LRUAddNew | .LRUGet | .LRURemove | .DequePushFront | .DequePushBack | .DequePopFront
        | .DequePopBack | .DequeDelete | .DequeReverse | .DequeSplit | .SplitWrite(_) | .GetDisjointWrite
        | .PriorityQueuePop | .PriorityQueueRemove(_, _) | .ViewMutNew(_) | .IterNext -> return true
        .ByteBufferWrite(_) -> return true
        .ByteBufferMethod(method) -> return method == "clear" || method == "seek" || method == "rewind" || method == "next" || method == "read" || method == "read_byte" || method == "read_bytes" || method == "read_string" || method == "flush" || method == "close" || method == "shutdown" || method == "copy_to" || method == "write_to"
        else -> return false
    }
}

fn tir_cost_operation(kind: TCostKind) -> String Never! {
    if kind == {
        .ViewMaterialization -> "materializing a read-only view"
        .CollectionCopyOnWrite -> "editing a shared map backing store"
        .ExactIntSpill -> "an exact Int operation may spill to bigint"
        .OutcomeConstruction -> "constructing an Outcome carrier"
        .RepresentationFallback -> "using a generic collection representation"
    }
}
fn tir_cost_fix(kind: TCostKind) -> String Never! {
    if kind == {
        .ViewMaterialization -> "keep the value in its view form, or make the copy explicit outside the loop"
        .CollectionCopyOnWrite -> "mutate an exclusive map place, or move the edit outside the loop"
        .ExactIntSpill -> "bound the operands so the result stays on the packed Int rail, or accept exact bigint cost"
        .OutcomeConstruction -> "consume the outcome through an immediate fast path when one exists"
        .RepresentationFallback -> "provide the collection shape proof that selects the direct representation"
    }
}

