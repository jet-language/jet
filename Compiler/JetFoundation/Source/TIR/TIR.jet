    pub value: TComptimeValue
}

pub enum TComptimeKey {
    Int(value: Int)
    String(value: String)
    Bool(value: Bool)
    Char(value: Int)
    Tuple(fields: [TComptimeKeyField])
    Struct(type_name: String, fields: [TComptimeKeyField])
    Enum(type_name: String, variant: String)
}

pub struct TComptimeKeyField {
    pub name: String
    pub key: TComptimeKey
}

pub struct TComptimeField {
    pub name: String
    pub value: TComptimeValue
}

pub struct TComptimeEnumArg {
    pub name: String?
    pub value: TComptimeValue
}

pub enum TComptimeReport {
    Clean(ty: Type)
    Told(value: TComptimeValue)
}

pub enum TComptimeValue {
    Int(value: Int)
    Float(value: Float, bits: Int)
    Bool(value: Bool)
    Char(value: Int)
    String(value: String)
    BigInt(decimal: String)
    Bytes(value: [U8])
    List(values: [TComptimeValue])
    Map(entries: [TComptimeMapEntry])
    Struct(type_name: String, fields: [TComptimeField])
    Enum(type_name: String, variant: String, args: [TComptimeEnumArg])
    Present(value: TComptimeValue)
    Failed(report: TComptimeReport)
    Unit
    Closure(value: TLambda)
}
pub enum TUnitRoundingMode {
    TowardZero
    Floor
    Ceiling
    NearestEven
}
pub struct TUnitRounding { pub mode: TUnitRoundingMode, pub digits: TExpr }

pub enum TExprKind {
    IntLit(value: Int, width: TIntegerWidth?)
    FloatLit(value: Float)
    BoolLit(value: Bool)
    CharLit(value: Int)
    StrLit(parts: [TStrPart])
    Local(local: TLocal)
    Unit
    InlineBlock(body: [TStmt])
    DefaultLit
    Uninit
    CtLit(value: TComptimeValue)
    ConstRef(symbol: SymbolID)
    Call(callee: SymbolID, type_args: [Type], args: [TCallArg])
    IndirectCall(callee: TExpr, type_args: [Type], args: [TCallArg], signature: Type)
    MethodCall(receiver: TExpr, method: TMethodRef, type_args: [Type], args: [TCallArg])
    DistinctCtor(owner: SymbolID, argument: TExpr, base: Type)
    RangeCheckedCtor(owner: SymbolID, argument: TExpr, failure: TFailureCarrier)
    DistinctConvert(owner: SymbolID, argument: TExpr, operation: TNumericOp, range: TIntegerBounds?, fallible: Bool)
    TraitBox(value: TExpr, target: Type)
    UnitConvert(destination: SymbolID, argument: TExpr, scale: String, offset: String, rounding: TUnitRounding?, fallible: Bool, relative_uncertainty: Float?, file: String, line: Int)
    MathBuiltin(type_name: String, function: String, args: [TExpr])
    PreciseBuiltin(type_name: String, function: String, args: [TExpr])
    Print(value: TExpr)
    Drop(value: TExpr)
    Close(value: TExpr)
    Move(value: TExpr)
    ResourceNew(value: TExpr)
    ResourceTake(local: TLocal)
    AmbientInput(prompt: TExpr?)
    RequireStop(kind: TRequireKind, location: TPanicLoc, always_stops: Bool)
    Binary(op: TBinaryOp, overflow: Bool, line: Int, lhs: TExpr, rhs: TExpr)
    CompareChain(operands: [TExpr], operators: [TBinaryOp], hooks: [Bool])
    Unary(op: TUnaryOp, operand: TExpr)
    StructLit(fields: [TStructFieldValue], extra: TStructExtra?, as_trait: TCoercionTarget?)
    Field(receiver: TExpr, field: TFieldRef)
    Index(base: TExpr, index: TExpr, kind: TIndexKind, access: AccessConvention, checked_call: SymbolID?, location: TPanicLoc)
    Slice(base: TExpr, start: TExpr, end: TExpr, range: TExpr?, location: TPanicLoc)
    Range(start: TExpr, end: TExpr, exclusive: Bool)
    Tuple(values: [TExpr])
    List(values: [TExpr], trait_coercion: Type?)
    Map(entries: [TMapEntry])
    EnumCtor(owner: SymbolID, variant: SymbolID, payload: TEnumPayload)
    Try(value: TExpr, conversion: TTryConvert, failure: TFailureCarrier)
    TryWithContext(inner: TExpr, note: TExpr?, convert: TTryConvert, file: String, line: Int, function: String)
    Lambda(value: TLambda)
    Borrow(place: TExpr, access: AccessConvention)
    AddressOf(place: TPlace, access: AccessConvention, lifetime: TAddressLifetime)
    RawAddressOf(place: TPlace)
    Deref(value: TExpr)
    PtrFromAddr(address: TExpr, element: Type)
    LayoutLiteral(value: TExpr)
    LayoutCompare(op: TBinaryOp, lhs: TExpr, rhs: TExpr)
    SharedGuardValue(guard: TExpr, editable: Bool)
    SharedGuardMap(guard: TExpr, path: [TFieldRef], editable: Bool)
    SharedGuardSplit(guard: TExpr, first: [TFieldRef], second: [TFieldRef], editable: Bool)
    SharedGuardWait(guard: TExpr, condition: TExpr, predicate: TLambda)
    ConditionNotify(condition: TExpr, all: Bool)
    CoreCall(record: CoreCallRecord, args: [TExpr], source_span: Span, type_args: [Type], widen_to_vec: [Bool], data_plan: MIRDataPlan?, fallibility: TFailureCarrier)
    HostCall(call: THostCall)
    AllocNew(ctor: TAllocCtor, args: [TCallArg])
    EnumLit(enum_type: String, variant: String, payload: TEnumPayload)
    DataEntriesToMap(local: TLocal)
    JSONLit(variant: String, arg: TExpr?, clone_arg: Bool)
    DBValueLit(variant: String, arg: TExpr?, clone_arg: Bool)
    ListLit(values: [TExpr])
    ListSpread(parts: [TListSpreadPart])
    ColumnarListLit(columns_type: String, elements: [TExpr])
    ColumnarGather(base: TExpr, index: TExpr, line: Int)
    ColumnarColumnRead(base: TExpr, index: TExpr, owner: String, field: String, column: Int, line: Int)
    TupleLit(struct_name: String, fields: [TNamedExpr])
    IndexRead(base: TExpr, index: TExpr, is_map: Bool, uninit_fixed: Bool, line: Int)
    SliceOwned(base: TExpr, start: TExpr, end: TExpr, range: TExpr?, line: Int)
    MapLit(entries: [TMapEntry])
    PoolSlot(pool: TExpr, id: TExpr, mutable: Bool, field: String?, line: Int, source_line: String)
    IndexHook(type_name: String, base: TExpr, index: TExpr, line: Int)
    MathLaneIndex(lane_type: String, base: TExpr, index: TExpr, line: Int)
    MathSwizzleRead(type_name: String, receiver: TExpr, lanes: [Int])
    Clone(value: TExpr)
    ExplicitCopy(value: TExpr)
    MaterializeView(value: TExpr)
    StaticCall(owner: TStaticOwner, owner_type: Type?, method: TMethodRef, type_args: [Type], args: [TCallArg])
    DecodeUnder(segment: TExpr, inner: TExpr)
    BuiltinMethod(receiver: TExpr, operation: TBuiltinOp, args: [TExpr])
    IfExpr(cond: TIfCond, then_body: [TStmt], then_value: TExpr, else_body: [TStmt], else_value: TExpr)
    ResultHandler(subject: TExpr, ok_pattern: TPattern, ok_body: [TStmt], ok_value: TExpr, err_pattern: TPattern, err_body: [TStmt], err_value: TExpr, terminal: TExpr)
    RawOf(value: TExpr)
    Todo(line: Int)
    InvariantViolation(construct: String, span: Span)
    LayoutLit(value: TExpr)
    Unreachable(line: Int)
    DistinctRaw(value: TExpr)
    Present(value: TExpr)
    Absent
    Ok(value: TExpr)
    Err(value: TExpr)
    OrFallback(value: TExpr, fallback: TOrFallback, ambient_err: TLocal?)
    OptField(base: TExpr, member: String, flatten: Bool)
    OptMethodCall(base: TExpr, binding: TLocal, call: TExpr, flatten: Bool)
    LambdaValue(value: TLambda)
    PatternMatches(subject: TExpr, pattern: TPattern)
    OptionLift2(function: TExpr, left: TExpr, right: TExpr)
    ClosureMethod(receiver: TExpr, operation: TClosureOp, args: [TExpr])
    HostBorrowCallback(callable: TExpr, params: [Type])
    NumericMethod(receiver: TExpr, operation: TNumericOp)
    NumericBinaryMethod(receiver: TExpr, operation: TNumericOp, argument: TExpr)
    OverflowOpt(prefix: String, operation: String, line: Int, policy: ArithmeticPolicyFact?, lhs: TExpr, rhs: TExpr)
    HandleMethod(receiver: TExpr, operation: THandleOp, args: [TExpr])
    CoreClosureCall(kind: TCoreClosureKind)
    TaskGroupAll(tasks: TExpr)
    TaskGroupRace(tasks: TExpr)
    TaskGroupAny(tasks: TExpr)
    SelectStart
    SelectRecv(builder: TExpr, channel: TExpr)
    SelectAfter(builder: TExpr, duration: TExpr, value: TExpr?)
    SelectWait(builder: TExpr, nonblocking: Bool)
    FnValue(kind: TFnValueKind)
    ModuleCall(target: TFunctionRef, form: TModuleCallForm, target_return: Type?, type_args: [Type], args: [TCallArg])
    ExternCall(symbol: String, c_abi: Bool, args: [TExternArg])
    Never(reason: String)
}

