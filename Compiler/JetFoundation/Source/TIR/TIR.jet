    frame_schedule_derivation: DerivationRef?
    capture_facts: TCaptureFacts
    failure_carrier: TFailureCarrier
    effects: TEffectFacts
    host_param_conventions: [AccessConvention]?
    source_params: [String]
    source_param_symbols: [SymbolID]
    jit_name: String
    param_types: [Type]
    ret: Type?
    is_move: Bool
    boxed: Bool
    rc: Bool
    arc: Bool
    captures: [TCapture]
    materialized_captures: [String]
    frozen_captures: [String]
    uses_stack_sentry: Bool
}

enum TLambdaBody {
    Expr(value: TExpr)
    Block(body: [TStmt])
    SharedBlock(body: [TStmt])
}

struct TCapture {
    source: String
    local: TLocal
    ty: Type
}

struct TWebParamReconstruction {
    local: TLocal
    ty: Type
    fields: [TWebParamField]
}

struct TWebParamField {
    field: String
    parameter: String
    ty: Type
}

struct TOriginProjection {
    receiver: String?
    span: Span
    value: TComptimeValue
}

// A `todo` goal checked in a function body: its source and the card naming
// the expected type, which is kept apart from the fallback type used to keep
// checking an unconstrained `todo`.
struct TTypedGoal {
    span: Span
    expected: String
}

struct TFunc {
    name: String
    module_name: String
    module_identity: String
    key: String
    source_file: String
    source_span: Span
    failure_carrier: TFailureCarrier
    effects: TEffectFacts
    target_applicability: TTargetApplicability
    web_bucket: WebBucket?
    web_marker: WebPartitionMarker?
    visibility: TVisibility
    foreign: TForeignProvenance?
    params: [TParameter]
    web_param_reconstructions: [TWebParamReconstruction]
    ret: Type?
    gc_return: Bool
    gc_scope: Bool
    return_view_provenance: ViewProvenanceMap?
    generic_params: [TGenericParam]
    clone_types: [Type]
    is_main: Bool
    line: Int
    synthetic: Bool
    is_unsafe: Bool
    unsafe_gate: TUnsafeGate?
    is_pure: Bool
    memo_bound: Int?
    memo_unbounded: Bool
    is_reactive: Bool
    reactive_upgrades: [String]
    is_inline: Bool
    is_inline_always: Bool
    is_scalar: Bool
    kernel_proof: KernelProof?
    memo_field: String?
    uses_stack_sentry: Bool
    body: [TStmt]
    kind: TFuncKind
    origin_facts: [TOriginProjection]{[TOriginProjection]{}}
    typed_goals: [TTypedGoal]{[TTypedGoal]{}}
}

struct TParameter {
    local: TLocal
    name: String
    span: Span
    ty: Type
    convention: AccessConvention
    public_label: String
    zone: ParamZone
    default: TExpr?
    variadic: Bool
}

enum TContractResultMode { Direct ResultPayload OptionPayload }
enum TSerdeCodec { Encode Decode }

enum TFuncKind {
    TopLevel
    Method(self_convention: AccessConvention?, owner_type: Type)
    TraitMethod(is_unsafe: Bool, self_convention: AccessConvention?, owner_type: Type, trait_name: SymbolID, serde_codec: TSerdeCodec?)
}

enum TPlace {
    Local(local: TLocal)
    Expr(value: TExpr)
}

enum TCostKind {
    ViewMaterialization
    CollectionCopyOnWrite
    ExactIntSpill
    OutcomeConstruction
    RepresentationFallback
}

enum TCostState {
    SemanticRemainder
    OptimizerRemoved
}

struct TCostFact {
    kind: TCostKind
    state: TCostState
}

enum TFactExclusivity {
    Unknown
    Shared
    Exclusive
    Move
}

enum TFactPurity {
    Unknown
    Pure
    Impure
}

struct TFactChannel {
    ty: Type?
    integer_bounds: TIntegerBounds?
    exclusivity: TFactExclusivity
    purity: TFactPurity
    no_cross_iteration_deps: Bool
    comptime_value: TComptimeValue?
    cost: TCostFact?
}

fn tir_expr_facts(expression: TExpr) -> TFactChannel Never! {
    facts := TFactChannel{ty: Val(expression.ty), integer_bounds: tir_cost_integer_bounds(expression), exclusivity: TFactExclusivity.Unknown, purity: TFactPurity.Unknown, no_cross_iteration_deps: false, comptime_value: None, cost: tir_cost_fact(expression)}
    facts.exclusivity = if expression.kind == {
        .Borrow(_, access) -> if {
            access == AccessConvention.Write -> TFactExclusivity.Exclusive
            access == AccessConvention.Move -> TFactExclusivity.Move
            else -> TFactExclusivity.Shared
        }
        .Move(_) -> TFactExclusivity.Move
        else -> TFactExclusivity.Unknown
    }
    facts.purity = if expression.kind == {
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .Uninit | .CtLit(_) | .ConstRef(_) -> TFactPurity.Pure
        else -> TFactPurity.Unknown
    }
    facts.comptime_value = if expression.kind == {
        .CtLit(value) -> Val(value)
        else -> None
    }
    facts
}

fn tir_call_arg_facts(argument: TCallArg) -> TFactChannel Never! {
    facts := tir_expr_facts(argument.value)
    facts.exclusivity = if {
        argument.mut_borrow -> TFactExclusivity.Exclusive
        argument.borrow -> TFactExclusivity.Shared
        else -> if argument.value.kind == {
            .Move(_) -> TFactExclusivity.Move
            else -> TFactExclusivity.Unknown
        }
    }
    facts
}

fn tir_expr_address_lifetime(expression: TExpr) -> TAddressLifetime Never! {
    if expression.kind == {
        .Local(local) -> {
            if local.address_lifetime != None -> return local.address_lifetime ?? TAddressLifetime.Unknown
            if local.persist_key != None -> return TAddressLifetime.Static
            return TAddressLifetime.Stack
        }
        .ConstRef(_) -> return TAddressLifetime.Static
        .Field(receiver, _) -> return tir_expr_address_lifetime(receiver)
        .Index(base, _, _, _, _, _) -> return tir_expr_address_lifetime(base)
        .Slice(base, _, _, _, _) -> return tir_expr_address_lifetime(base)
        .PoolSlot(_, _, _, _, _, _) -> return TAddressLifetime.Heap
        .Borrow(_, _) -> return TAddressLifetime.Borrowed
        .RawAddressOf(_) | .RawOf(_) | .Deref(_) | .PtrFromAddr(_, _) -> return TAddressLifetime.Foreign
        .DistinctCtor(_, argument, _) | .DistinctRaw(argument) -> return tir_expr_address_lifetime(argument)
        else -> {}
    }
    TAddressLifetime.Unknown
}

fn tir_each_pattern_child(pattern: TPattern, visit: fn(TExpr) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    tir_each_pattern_shape_child(pattern.shape, visit)
}

fn tir_each_pattern_shape_child(shape: TPatternShape, visit: fn(TExpr) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if shape == {
        .Variant(_, slots, _, _) | .List(slots, _, _) -> {
            loop slot in slots {
                tir_each_pattern_slot_child(slot, visit)
            }
        }
        .Present(_, _, inner, _) | .Ok(_, _, inner, _) | .Err(_, _, inner, _) -> {
            if inner == .Val(nested) -> tir_each_pattern_shape_child(nested.shape, visit)
        }
        .Map(entries, _, _) -> loop entry in entries {
            visit(entry.key)
            tir_each_pattern_slot_child(entry.slot, visit)
        }
        .Or(alternatives, _) -> {
            loop alternative in alternatives {
                tir_each_pattern_shape_child(alternative, visit)
            }
        }
        .Struct(fields, _, _) -> {
            loop field in fields {
                if field == {
                    .Value(_, value, _) -> visit(value)
                    .Nested(_, inner, _) -> tir_each_pattern_shape_child(inner.shape, visit)
                    else -> {}
                }
            }
        }
        else -> {}
    }
}

fn tir_each_pattern_slot_child(slot: TPatternBinding, visit: fn(TExpr) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if slot == {
        .Value(value) -> visit(value)
        .Nested(inner) -> tir_each_pattern_shape_child(inner.shape, visit)
        else -> {}
    }
}

fn tir_each_if_cond_child(condition: TIfCond, visit: fn(TExpr) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if condition == {
        .Plain(value) -> visit(value)
        .And(left, right) -> {
            tir_each_if_cond_child(left, visit)
            tir_each_if_cond_child(right, visit)
        }
        .IfLet(pattern, subj) | .Matches(pattern, subj) -> {
            tir_each_pattern_child(pattern, visit)
            visit(subj)
        }
        .IsNone(subj) -> visit(subj)
        .WithPrelude(prelude, cond) -> {
            loop statement in prelude {
                tir_each_stmt_child(statement, visit)
            }
            tir_each_if_cond_child(cond, visit)
        }
    }
}

fn tir_each_lambda_child(lambda: TLambda, visit: fn(TExpr) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if lambda.executable == {
        .Expr(value) -> visit(value)
        .Block(body) | .SharedBlock(body) -> {
            loop statement in body {
                tir_each_stmt_child(statement, visit)
            }
        }
    }
}

fn tir_each_stmt_list_child(statements: [TStmt], visit: fn(TExpr) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    loop statement in statements {
        tir_each_stmt_child(statement, visit)
    }
}

fn tir_each_match_arm_child(arms: [TMatchArm], visit: fn(TExpr) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    loop arm in arms {
        tir_each_pattern_child(arm.pattern, visit)
        tir_each_stmt_list_child(arm.body, visit)
    }
}

// Visits the children of an `else`. An else-if chain (an `else` that is
// exactly one `if`, the shape sema gives every N-arm decision table) is
// followed by direct recursion over read parameters, one frame per arm:
// each link is read in place, never copied.
fn tir_each_else_child(else_body: [TStmt]?, visit: fn(TExpr) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if else_body == .Val(statements) {
        loop statement in statements {
            if statement == .If(condition, then_body, nested_else, _, _) {
                tir_each_if_cond_child(condition, visit)
                tir_each_stmt_list_child(then_body, visit)
                tir_each_else_child(nested_else, visit)
            } else {
                tir_each_stmt_child(statement, visit)
            }
        }
    }
}

fn tir_each_stmt_child(statement: TStmt, visit: fn(TExpr) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if statement == {
        .Contract(contract) -> {
            visit(contract.condition)
            visit(contract.message)
        }
        .ContractScope(pre, body, post, result, _) -> {
            loop contract in pre {
                visit(contract.condition)
                visit(contract.message)
            }
            tir_each_stmt_list_child(body, visit)
            loop contract in post {
                visit(contract.condition)
                visit(contract.message)
            }
            _ := result
        }
        .Let(_, _, init, _, _, _) -> visit(init)
        .RefutableBind(pattern, init, fallback, _) -> {
            tir_each_pattern_child(pattern, visit)
            visit(init)
            tir_each_stmt_list_child(fallback, visit)
        }
        .TupleDestructure(_, init, _, _, _) | .StructDestructure(_, init, _, _, _) | .ListDestructure(_, init, _, _, _, _, _) -> visit(init)
        .Assign(place, _, value, _, _) -> {
            if place == {
                .Expr(place_value) -> visit(place_value)
                else -> {}
            }
            visit(value)
        }
        .Return(value, _) -> {
            if value == Val(nested) -> visit(nested)
        }
        .ExprStmt(value, _) -> visit(value)
        .TaskGroup(_, limit, body, _) -> {
            if limit == Val(nested) -> visit(nested)
            tir_each_stmt_list_child(body, visit)
        }
        .DeferClose(close, _, _, _) -> visit(close)
        .If(condition, then_body, else_body, _, _) -> {
            tir_each_if_cond_child(condition, visit)
            tir_each_stmt_list_child(then_body, visit)
            tir_each_else_child(else_body, visit)
        }
        .Loop(_, body, _) -> tir_each_stmt_list_child(body, visit)
        .While(_, condition, body, _) -> {
            visit(condition)
            tir_each_stmt_list_child(body, visit)
        }
        .CountedLoop(_, init, condition, step, _, body, _) -> {
            tir_each_stmt_child(init, visit)
            visit(condition)
            if step == Val(nested) {
                tir_each_stmt_child(nested, visit)
            }
            tir_each_stmt_list_child(body, visit)
        }
        .ForRange(_, _, start, end, step, _, body, _, _) -> {
            visit(start)
            visit(end)
            if step == Val(nested) -> visit(nested)
            tir_each_stmt_list_child(body, visit)
        }
        .Range(_, _, source, start, end, step, _, _, body, _) -> {
            if source == Val(nested_source) -> visit(nested_source)
            visit(start)
            visit(end)
            if step == Val(nested_step) -> visit(nested_step)
            tir_each_stmt_list_child(body, visit)
        }
        .BreakValue(_, value, _) -> visit(value)
        .Match(subject, arms, _, _) -> {
            visit(subject)
            tir_each_match_arm_child(arms, visit)
        }
        .EnumMatch(scrutinee, arms, else_body, _, _) -> {
            visit(scrutinee)
            tir_each_match_arm_child(arms, visit)
            if else_body == Val(nested) {
                tir_each_stmt_list_child(nested, visit)
            }
        }
        .RangeSwitch(subject, arms, else_body, _) -> {
            visit(subject)
            loop arm in arms {
                tir_each_stmt_list_child(arm.body, visit)
            }
            tir_each_stmt_list_child(else_body, visit)
        }
        .ForIn(_, _, _, source, collection, step, _, _, _, _, body, _) -> {
            visit(source)
            visit(collection)
            if step == Val(nested) -> visit(nested)
            tir_each_stmt_list_child(body, visit)
        }
        .Inline(body, _) | .DebugOnly(body, _) | .Impure(body, _) | .Region(body, _) | .Live(body, _) | .Shield(body, _) -> tir_each_stmt_list_child(body, visit)
        .MixedSwitch(subject, _, arms, else_body, _) -> {
            visit(subject)
            loop arm in arms {
                visit(arm.condition)
                tir_each_stmt_list_child(arm.body, visit)
            }
            if else_body == Val(nested) {
                tir_each_stmt_list_child(nested, visit)
            }
        }
        .Unsafe(_, body) -> tir_each_stmt_list_child(body, visit)
        .UnsafeBlock(_, body, _) | .SentryPolicy(_, body, _) -> tir_each_stmt_list_child(body, visit)
        .Reactive(executable, _) -> tir_each_lambda_child(executable, visit)
        .Layout(_, _, body, _) -> tir_each_stmt_list_child(body, visit)
        .ContextBlock(guards, body, _) -> {
            loop guard in guards -> visit(guard.value)
            tir_each_stmt_list_child(body, visit)
        }
        .ScopeMember(kind, body, _) -> {
            if kind == {
                .Timeout(duration) -> visit(duration)
                else -> {}
            }
            tir_each_stmt_list_child(body, visit)
        }
        .Transact(_, _, _, body, _) -> tir_each_stmt_list_child(body, visit)
        .GCEdit(_, _, _, _, index_temp, edited, _) -> {
            if index_temp == Val(nested) -> visit(nested)
            tir_each_stmt_child(edited, visit)
        }
        else -> {}
    }
}

fn tir_each_place_child(place: TPlace, visit: fn(TExpr) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if place == {
        .Expr(value) -> visit(value)
        else -> {}
    }
}

fn tir_each_require_child(requirement: TRequireKind, visit: fn(TExpr) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if requirement == {
        .Require(condition, message) -> {
            visit(condition)
            if message == Val(message_value) -> visit(message_value)
        }
        .RequireEq(left, right) -> {
            visit(left)
            visit(right)
        }
        .Panic(message) -> visit(message)
    }
}

fn tir_each_or_fallback_child(fallback: TOrFallback, visit: fn(TExpr) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if fallback == {
        .Value(value) -> visit(value)
        .Return(value) -> {
            if value == Val(nested) -> visit(nested)
        }
        .Panic(message, _) -> visit(message)
        else -> {}
    }
}

fn tir_each_list_spread_child(parts: [TListSpreadPart], visit: fn(TExpr) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    loop part in parts {
        if part == {
            .Element(value) | .Spread(value) -> visit(value)
        }
    }
}

fn tir_each_host_call_child(call: THostCall, visit: fn(TExpr) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if call == {
        .Method(receiver, _, args) -> {
            visit(receiver)
            loop value in args -> visit(value)
        }
        .CarrierFact(receiver, _, _) -> visit(receiver)
        .CellGuardProject(receiver, _, _, _, _) -> visit(receiver)
        .FixedListIndex(base, index, _) -> {
            visit(base)
            visit(index)
        }
        .TypedText(_, argument) -> visit(argument)
        .GCEdit(_, _, _, edit, index_temp, _) -> {
            visit(edit)
            if index_temp == Val(index_value) -> visit(index_value)
        }
        .OptionProbe(inner, _) -> visit(inner)
        .TupleIndex(base, _) -> visit(base)
        .StrMatchScan(subject, _, _) | .BinMatchScan(subject, _, _) -> visit(subject)
        .YieldSend(value) -> visit(value)
        .TypedTextInterp(_, _, holes, _) -> loop hole in holes -> visit(hole)
        .ExpectSnapshot(value, _) -> visit(value)
        .EnvSet(name, value, _) -> {
            visit(name)
            visit(value)
        }
        .CCallback(_, lambda, _, _, _, _) -> tir_each_lambda_child(lambda, visit)
        else -> {}
    }
}

fn tir_each_core_closure_child(kind: TCoreClosureKind, visit: fn(TExpr) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if kind == {
        .Spawn(group, _, _, executable) -> {
            if group == Val(group_value) -> visit(group_value)
            tir_each_lambda_child(executable, visit)
        }
        .Realtime(rate, frames, executable) -> {
            visit(rate)
            visit(frames)
            tir_each_lambda_child(executable, visit)
        }
        .UITextInputOnDrop(state, ime, executable, _) -> {
            visit(state)
            visit(ime)
            tir_each_lambda_child(executable, visit)
        }
        .Serve(address, executable) -> {
            visit(address)
            tir_each_lambda_child(executable, visit)
        }
        .OnInterrupt(callback) -> visit(callback)
        .Guard(executable) -> tir_each_lambda_child(executable, visit)
        .ReactiveDerived(executable, _) | .ReactiveEffect(executable, _) | .UIReactiveRender(executable, _) -> tir_each_lambda_child(executable, visit)
        .OnCommit(_, executable) | .OnRollback(_, executable) -> tir_each_lambda_child(executable, visit)
        .UIButtonOnClick(label, shortcut, accessible_label, executable, _) -> {
            visit(label)
            visit(shortcut)
            visit(accessible_label)
            tir_each_lambda_child(executable, visit)
        }
        .UIPreview(name, viewport, executable, site, playground, source_file, source_span, source_start_line, source_start_column, source_end_line, source_end_column, build_id, revision) -> {
            _ := site
            _ := playground
            _ := source_file
            _ := source_span
            _ := source_start_line
            _ := source_start_column
            _ := source_end_line
            _ := source_end_column
            _ := build_id
            _ := revision
            visit(name)
            if viewport == Val(viewport_value) -> visit(viewport_value)
            tir_each_lambda_child(executable, visit)
        }
    }

}
fn tir_each_expr_child(expression: TExpr, visit: fn(TExpr) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if expression.kind == {
        .StrLit(parts) -> loop part in parts {
            if part == {
                .Interpolation(value, _) -> visit(value)
                else -> {}
            }
        }
        .InlineBlock(body) -> tir_each_stmt_list_child(body, visit)
        .Call(_, _, args) -> loop argument in args -> visit(argument.value)
        .IndirectCall(callee, _, args, _) -> {
            visit(callee)
            loop argument in args -> visit(argument.value)
        }
        .MethodCall(receiver, _, _, args) -> {
            visit(receiver)
            loop argument in args -> visit(argument.value)
        }
        .DistinctCtor(_, argument, _) | .DistinctConvert(_, argument, _, _, _) | .TraitBox(argument, _) -> visit(argument)
        .UnitConvert(_, argument, _, _, rounding, _, _, _, _) -> {
            visit(argument)
            if rounding == Val(rounding_value) -> visit(rounding_value.digits)
        }
        .MathBuiltin(_, _, args) | .PreciseBuiltin(_, _, args) -> loop value in args -> visit(value)
        .Print(value) | .Drop(value) | .Close(value) | .Move(value) -> visit(value)
        .AmbientInput(prompt) -> {
            if prompt == Val(prompt_value) -> visit(prompt_value)
        }
        .RequireStop(kind, _, _) -> tir_each_require_child(kind, visit)
        .Binary(_, _, _, lhs, rhs) -> {
            visit(lhs)
            visit(rhs)
        }
        .CompareChain(operands, _, _) -> loop value in operands -> visit(value)
        .Unary(_, operand) -> visit(operand)
        .StructLit(fields, _) -> loop field in fields -> visit(field.value)
        .Field(receiver, _) -> visit(receiver)
        .Index(base, index, _, _, _, _) -> {
            visit(base)
            visit(index)
        }
        .Slice(base, start, end, range, _) -> {
            visit(base)
            visit(start)
            visit(end)
            if range == Val(range_value) -> visit(range_value)
        }
        .Range(start, end, _) -> {
            visit(start)
            visit(end)
        }
        .Tuple(values) | .List(values, _) -> loop value in values -> visit(value)
        .Map(entries) | .MapLit(entries) -> loop entry in entries {
            visit(entry.key)
            visit(entry.value)
        }
        .EnumCtor(_, _, payload) | .EnumLit(_, _, payload) -> {
            if payload == {
                .Positional(args) -> loop argument in args -> visit(argument.value)
                .Named(fields) -> loop field in fields -> visit(field.value.value)
                .Unit -> {}
            }
        }
        .Present(value) | .Ok(value) | .Err(value) | .DistinctRaw(value) -> visit(value)
        .Try(value, _, _) -> visit(value)
        .TryWithContext(inner, note, _, _, _, _) -> {
            visit(inner)
            if note == Val(note_value) -> visit(note_value)
        }
        .Lambda(value) -> tir_each_lambda_child(value, visit)
        .Borrow(place, _) -> visit(place)
        .RawAddressOf(place) -> tir_each_place_child(place, visit)
        .RawOf(value) | .Deref(value) | .PtrFromAddr(value, _) | .LayoutLiteral(value) -> visit(value)
        .LayoutCompare(_, lhs, rhs) -> {
            visit(lhs)
            visit(rhs)
        }
        .SharedGuardValue(guard, _) -> visit(guard)
        .SharedGuardMap(guard, _, _) -> visit(guard)
        .SharedGuardSplit(guard, _, _, _) -> visit(guard)
        .SharedGuardWait(guard, condition, predicate) -> {
            visit(guard)
            visit(condition)
            tir_each_lambda_child(predicate, visit)
        }
        .ConditionNotify(condition, _) -> visit(condition)
        .CoreCall(_, args, _, _, _, _, _) -> loop value in args -> visit(value)
        .HostCall(call) -> tir_each_host_call_child(call, visit)
        .JSONLit(_, argument, _) | .DBValueLit(_, argument, _) -> {
            if argument == Val(argument_value) -> visit(argument_value)
        }
        .AllocNew(_, args) -> loop argument in args -> visit(argument.value)
        .ListLit(values) -> loop value in values -> visit(value)
        .ListSpread(parts) -> tir_each_list_spread_child(parts, visit)
        .PoolSlot(pool, id, _, _, _, _) -> {
            visit(pool)
            visit(id)
        }
        .MathLaneIndex(_, base, index, _) -> {
            visit(base)
            visit(index)
        }
        .MathSwizzleRead(_, receiver, _) -> visit(receiver)
        .Clone(value, _) | .ExplicitCopy(value) | .MaterializeView(value) -> visit(value)
        .StaticCall(_, _, _, _, args) -> loop argument in args -> visit(argument.value)
        .DecodeUnder(segment, inner) -> {
            visit(segment)
            visit(inner)
        }
        .BuiltinMethod(receiver, _, args) -> {
            visit(receiver)
            loop value in args -> visit(value)
        }
        .IfExpr(cond, then_body, then_value, else_body, else_value) -> {
            tir_each_if_cond_child(cond, visit)
            tir_each_stmt_list_child(then_body, visit)
            visit(then_value)
            tir_each_stmt_list_child(else_body, visit)
            visit(else_value)
        }
        .ResultHandler(subject, ok_pattern, ok_body, ok_value, err_pattern, err_body, err_value, terminal) -> {
            visit(subject)
            tir_each_pattern_child(ok_pattern, visit)
            tir_each_stmt_list_child(ok_body, visit)
            visit(ok_value)
            tir_each_pattern_child(err_pattern, visit)
            tir_each_stmt_list_child(err_body, visit)
            visit(err_value)
            visit(terminal)
        }
        .OrFallback(value, fallback, _) -> {
            visit(value)
            tir_each_or_fallback_child(fallback, visit)
        }
        .OptField(base, _, _) -> visit(base)
        .OptMethodCall(base, _, call, _) -> {
            visit(base)
            visit(call)
        }
        .PatternMatches(subject, pattern) -> {
            visit(subject)
            tir_each_pattern_child(pattern, visit)
        }
        .OptionLift2(function, left, right) -> {
            visit(function)
            visit(left)
            visit(right)
        }
        .ClosureMethod(receiver, _, args) -> {
            visit(receiver)
            loop value in args -> visit(value)
        }
        .HostBorrowCallback(callable, _) -> visit(callable)
        .NumericMethod(receiver, _) -> visit(receiver)
        .NumericBinaryMethod(receiver, _, argument) -> {
            visit(receiver)
            visit(argument)
        }
        .OverflowOpt(_, _, _, _, lhs, rhs) -> {
            visit(lhs)
            visit(rhs)
        }
        .HandleMethod(receiver, _, args) -> {
            visit(receiver)
            loop value in args -> visit(value)
        }
        .CoreClosureCall(kind) -> tir_each_core_closure_child(kind, visit)
        .TaskGroupAll(tasks) | .TaskGroupRace(tasks) | .TaskGroupAny(tasks) -> visit(tasks)
        .SelectRecv(builder, channel) -> {
            visit(builder)
            visit(channel)
        }
        .SelectAfter(builder, duration, value) -> {
            visit(builder)
            visit(duration)
            if value == Val(nested) -> visit(nested)
        }
        .SelectWait(builder, _) -> visit(builder)
        .FnValue(kind) -> tir_each_fn_value_child(kind, visit)
        else -> {}
    }
}

fn tir_each_fn_value_child(kind: TFnValueKind, visit: fn(TExpr) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if kind == {
        .NamedFn(_, lambda) -> {
            if lambda == Val(lambda_value) {
                tir_each_lambda_child(lambda_value, visit)
            }
        }
        .Policy(_, policy_args, _, _, _, callee) -> {
            loop argument in policy_args -> visit(argument.value)
            visit(callee)
        }
        .Call(callee, args) -> {
            visit(callee)
            loop argument in args -> visit(argument.value)
        }
        .Send(value) -> visit(value)
    }
}

fn tir_func_facts(function: TFunc) -> TFactChannel Never! {
    TFactChannel{
        ty: function.ret
        integer_bounds: None
        exclusivity: TFactExclusivity.Unknown
        purity: if function.is_pure -> TFactPurity.Pure else -> TFactPurity.Unknown
        no_cross_iteration_deps: false
        comptime_value: None
        cost: None
    }
}
