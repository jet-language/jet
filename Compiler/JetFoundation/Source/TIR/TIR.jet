// Checked/typed IR shared between sema, lowering, ownership analysis and every
// execution adapter. Nodes carry decisions already proved by sema; consumers
// must not reconstruct those decisions from source spelling.

TIR_SCHEMA_VERSION :: 8

enum TAddressLifetime {
    Stack
    Heap
    Static
    Borrowed
    Foreign
    Unknown
}

struct TIntegerBounds {
    lo: Int
    hi: Int
}

fn integer_bounds_exact(value: Int) -> TIntegerBounds Never! {
    TIntegerBounds{lo: value, hi: value}
}

struct TLocal {
    name: String
    symbol_id: SymbolID?{None}
    span: Span
    generated: Bool
    deref: Bool
    address_lifetime: TAddressLifetime?
    persist_key: String?
    persist_ty: Type?
    mutable: Bool
    string_bytes_source: TLocal?
    integer_bounds: TIntegerBounds?
    uninit_scalar: Bool
    uninit_fixed: Bool
    direct_closure: Bool
    // The checked `^p` of a match payload binding whose subject sema marked
    // partially moved (sema_ownership_move_pattern_payload): lowering may
    // take the payload out of the subject's storage instead of copying it.
    payload_take: Bool{false}
    // A read-only binding of a place (`x :: rows[i]`) that reads the place
    // itself instead of a copy: sema proved neither the binding nor the
    // variable the place reads is written, moved or captured while it lives
    // (JetSema Ownership/PlaceBorrows.jet).
    place_borrow: Bool{false}
}

fn tir_user_local(name: String, span: Span) -> TLocal Never! {
    TLocal{name: name, span: span, generated: false, deref: false, address_lifetime: None, persist_key: None, persist_ty: None, mutable: false, string_bytes_source: None, integer_bounds: None, uninit_scalar: false, uninit_fixed: false, direct_closure: false}
}

fn tir_symbol_local(name: String, span: Span, symbol_id: SymbolID) -> TLocal Never! {
    local := tir_user_local(name, span)
    local.symbol_id = Val(symbol_id)
    local
}

fn tir_generated_local(name: String, span: Span) -> TLocal Never! {
    TLocal{name: name, span: span, generated: true, deref: false, address_lifetime: None, persist_key: None, persist_ty: None, mutable: false, string_bytes_source: None, integer_bounds: None, uninit_scalar: false, uninit_fixed: false, direct_closure: false}
}

fn tir_persistent_local(name: String, module_name: String, ty: Type, span: Span) -> TLocal Never! {
    TLocal{name: name, span: span, generated: false, deref: false, address_lifetime: Val(TAddressLifetime.Static), persist_key: Val("{module_name}::{name}"), persist_ty: Val(ty), mutable: false, string_bytes_source: None, integer_bounds: None, uninit_scalar: false, uninit_fixed: false, direct_closure: false}
}

