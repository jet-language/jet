enum TPatternShape {
    Variant(variant: String, bindings: [TPatternBinding], leading_dot: Bool, span: Span)
    // S31: `inner` is a nested payload pattern (`.Val(.Rect(w, h))`).
    Present(binding: String, binding_span: Span, inner: TNestedPattern?, span: Span)
    Absent(span: Span)
    Ok(binding: String, binding_span: Span, inner: TNestedPattern?, span: Span)
    Err(binding: String, binding_span: Span, inner: TNestedPattern?, span: Span)
    Range(lo: Int, hi: Int, span: Span)
    Or(alternatives: [TPatternShape], span: Span)
    Struct(fields: [TPatternField], rest: Span?, span: Span)
    List(items: [TPatternBinding], rest: TListPatternRest?, span: Span)
    Map(entries: [TMapPatternEntry], rest: Bool, span: Span)
    Text(parts: [TTextPatternPart], span: Span)
    Binary(parts: [TBinaryPatternPart], span: Span)
}

// S31: a checked nested payload pattern with the payload type's owner.
struct TNestedPattern {
    shape: TPatternShape
    enum_type: SymbolID?
}

enum TPatternPosition {
    Binding
    OptionBinding
    Arm
    VariantPath
}
struct TPatternBindingFact {
    name: String
    span: Span
    ty: Type
    mutable: Bool
    symbol_id: SymbolID?
}

struct TPattern {
    shape: TPatternShape
    bindings: [TPatternBindingFact]
    enum_type: SymbolID?
    position: TPatternPosition
    mutable: Bool
    boxed: Bool
}

enum TPatternBinding {
    Wildcard
    Bind(name: String, span: Span)
    Range(lo: Int, hi: Int)
    Nested(pattern: TNestedPattern)
    Value(value: TExpr)
}

enum TPatternField {
    Bind(field: String, local: String, span: Span)
    Value(field: String, value: TExpr, span: Span)
    Nested(field: String, pattern: TNestedPattern, span: Span)
}

struct TListPatternRest {
    name: String?
    span: Span
}

struct TMapPatternEntry {
    key: TExpr
    optional: Bool
    slot: TPatternBinding
    span: Span
}

// Logical key identity ignores source spelling and resolved constant aliases.
fn tir_pattern_key_identity(key: TExpr) -> String? Never! {
    if key.kind == {
        .IntLit(value, _) -> Val("int:{value}")
        .StrLit(value) -> Val("text:{value}")
        .BoolLit(value) -> Val("bool:{value}")
        .CharLit(value) -> Val("char:{value}")
        .ConstRef(symbol) -> Val("constant:{symbol.key}")
        .EnumLit(owner, variant, _) -> Val("enum:{owner}:{variant}")
        .Unary(op, value) -> {
            if op == TUnaryOp.Neg && value.kind == .IntLit(number, _) -> Val("int:{-number}") else -> None
        }
        .CtLit(value) -> if value == {
            .Int(number) -> Val("int:{number}")
            .BigInt(number) -> Val("int:{number}")
            .String(text) -> Val("text:{text}")
            .Bool(flag) -> Val("bool:{flag}")
            .Char(character) -> Val("char:{character}")
            .Enum(owner, variant, _) -> Val("enum:{owner}:{variant}")
            else -> None
        }
        else -> None
    }
}

