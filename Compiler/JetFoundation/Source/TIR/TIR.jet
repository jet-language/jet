pub enum TFuncKind {
    TopLevel
    Method(self_convention: AccessConvention?, owner_type: Type)
    TraitMethod(is_unsafe: Bool, self_convention: AccessConvention?, owner_type: Type, trait_name: SymbolID, serde_codec: TSerdeCodec?)
}

pub enum TPlace {
    Local(local: TLocal)
    Expr(value: TExpr)
}

pub enum TCostKind {
    ViewMaterialization
    CollectionCopyOnWrite
    ExactIntSpill
    OutcomeConstruction
    RepresentationFallback
}

pub enum TCostState {
    SemanticRemainder
    OptimizerRemoved
}

pub struct TCostFact {
    pub kind: TCostKind
    pub state: TCostState
}

pub enum TFactExclusivity {
    Unknown
    Shared
    Exclusive
    Move
}

pub enum TFactPurity {
    Unknown
    Pure
    Impure
}

pub struct TFactChannel {
    pub ty: Type?
    pub integer_bounds: TIntegerBounds?
    pub exclusivity: TFactExclusivity
    pub purity: TFactPurity
    pub no_cross_iteration_deps: Bool
    pub comptime_value: TComptimeValue?
    pub cost: TCostFact?
}

pub fn tir_expr_facts(expression: TExpr) -> TFactChannel Never! {
    facts := TFactChannel{ty: Val(expression.ty), integer_bounds: expression.integer_bounds, exclusivity: TFactExclusivity.Unknown, purity: TFactPurity.Unknown, no_cross_iteration_deps: false, comptime_value: None, cost: expression.cost}
    facts.exclusivity = if expression.kind == {
        .Borrow(_, access) | .AddressOf(_, access, _) -> if {
            access == AccessConvention.Write -> TFactExclusivity.Exclusive
            access == AccessConvention.Move -> TFactExclusivity.Move
            else -> TFactExclusivity.Shared
        }
        .Move(_) | .ResourceTake(_) -> TFactExclusivity.Move
        else -> TFactExclusivity.Unknown
    }
    facts.purity = if expression.kind == {
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .DefaultLit | .Uninit | .CtLit(_) | .ConstRef(_) -> TFactPurity.Pure
        else -> TFactPurity.Unknown
    }
    facts.comptime_value = if expression.kind == {
        .CtLit(value) -> Val(value)
        else -> None
    }
    facts
}

pub fn tir_call_arg_facts(argument: TCallArg) -> TFactChannel Never! {
    facts := tir_expr_facts(argument.value)
    facts.exclusivity = if {
        argument.mut_borrow -> TFactExclusivity.Exclusive
        argument.borrow -> TFactExclusivity.Shared
        else -> if argument.value.kind == {
            .Move(_) | .ResourceTake(_) -> TFactExclusivity.Move
            else -> TFactExclusivity.Unknown
        }
    }
    facts
}

pub fn tir_expr_address_lifetime(expression: TExpr) -> TAddressLifetime Never! {
    if expression.kind == {
        .Local(local) -> {
            if local.address_lifetime != None -> return local.address_lifetime ?? TAddressLifetime.Unknown
            if local.persist_key != None -> return TAddressLifetime.Static
            return TAddressLifetime.Stack
        }
        .ConstRef(_) -> return TAddressLifetime.Static
        .Field(receiver, _) -> return tir_expr_address_lifetime(receiver)
        .Index(base, _, _, _, _, _) -> return tir_expr_address_lifetime(base)
        .IndexRead(base, _, _, _, _) -> return tir_expr_address_lifetime(base)
        .Slice(base, _, _, _, _) | .SliceOwned(base, _, _, _, _) -> return tir_expr_address_lifetime(base)
        .PoolSlot(_, _, _, _, _, _) -> return TAddressLifetime.Heap
        .Borrow(_, _) -> return TAddressLifetime.Borrowed
        .AddressOf(_, _, lifetime) -> return lifetime
        .RawAddressOf(_) | .RawOf(_) | .Deref(_) | .PtrFromAddr(_, _) -> return TAddressLifetime.Foreign
        .DistinctCtor(_, argument, _) | .DistinctRaw(argument) -> return tir_expr_address_lifetime(argument)
        else -> {}
    }
    TAddressLifetime.Unknown
}

pub fn tir_pattern_children(pattern: TPattern) -> [TExpr] Never! {
    tir_pattern_shape_children(pattern.shape)
}

fn tir_pattern_shape_children(shape: TPatternShape) -> [TExpr] Never! {
    children := [TExpr]{}
    if shape == {
        .Or(alternatives, _) -> {
            loop alternative in alternatives {
                loop child in tir_pattern_shape_children(alternative) -> &children.push(child)
            }
        }
        .Struct(fields, _, _) -> {
            loop field in fields {
                if field == {
                    .Value(_, value, _) -> &children.push(value)
                    else -> {}
                }
            }
        }
        else -> {}
    }
    children
}

pub fn tir_if_cond_children(condition: TIfCond) -> [TExpr] Never! {
    children := [TExpr]{}
    if condition == {
        .Plain(value) -> &children.push(value)
        .And(left, right) -> {
            loop child in tir_if_cond_children(left) -> &children.push(child)
            loop child in tir_if_cond_children(right) -> &children.push(child)
        }
        .IfLet(pattern, subj) | .Matches(pattern, subj) -> {
            loop child in tir_pattern_children(pattern) -> &children.push(child)
            &children.push(subj)
        }
        .IsNone(subj) -> &children.push(subj)
        .WithPrelude(prelude, cond) -> {
            loop statement in prelude {
                loop child in tir_stmt_children(statement) -> &children.push(child)
            }
            loop child in tir_if_cond_children(cond) -> &children.push(child)
        }
    }
    children
}

fn tir_lambda_children(lambda: TLambda) -> [TExpr] Never! {
    children := [TExpr]{}
    if lambda.executable == {
        .Expr(value) -> &children.push(value)
        .Block(body) | .SharedBlock(body) -> {
            loop statement in body {
                loop child in tir_stmt_children(statement) -> &children.push(child)
            }
        }
    }
    children
}

fn tir_stmt_list_children(statements: [TStmt]) -> [TExpr] Never! {
    children := [TExpr]{}
    loop statement in statements {
        loop child in tir_stmt_children(statement) -> &children.push(child)
    }
    children
}

fn tir_match_arm_children(arms: [TMatchArm]) -> [TExpr] Never! {
    children := [TExpr]{}
    loop arm in arms {
        loop child in tir_pattern_children(arm.pattern) -> &children.push(child)
        loop child in tir_stmt_list_children(arm.body) -> &children.push(child)
    }
    children
}

// Appends the children of an `else` to `children`. An else-if chain (an
// `else` that is exactly one `if`, the shape sema gives every N-arm decision
// table) is followed by direct recursion over read parameters, one frame per
// arm: each link is read in place and its children are copied once, where a
// loop would copy the rest of the chain into a local at every step.
fn tir_else_children_into(children: &[TExpr], else_body: [TStmt]?) Never! {
    if else_body == .Val(statements) {
        loop statement in statements {
            if statement == .If(condition, then_body, nested_else, _, _) {
                loop child in tir_if_cond_children(condition) -> &children.push(child)
                loop child in tir_stmt_list_children(then_body) -> &children.push(child)
                tir_else_children_into(&children, nested_else)
            } else {
                loop child in tir_stmt_children(statement) -> &children.push(child)
            }
        }
    }
}

pub fn tir_stmt_children(statement: TStmt) -> [TExpr] Never! {
    children := [TExpr]{}
    if statement == {
        .Contract(contract) -> {
            &children.push(contract.condition)
            &children.push(contract.message)
        }
        .ContractScope(pre, body, post, result, _) -> {
            loop contract in pre {
                &children.push(contract.condition)
                &children.push(contract.message)
            }
            loop child in tir_stmt_list_children(body) -> &children.push(child)
            loop contract in post {
                &children.push(contract.condition)
                &children.push(contract.message)
            }
            _ := result
        }
        .Let(_, _, init, _, _, _) -> &children.push(init)
        .RefutableBind(pattern, init, fallback, _) -> {
            loop child in tir_pattern_children(pattern) -> &children.push(child)
            &children.push(init)
            loop child in tir_stmt_list_children(fallback) -> &children.push(child)
        }
        .TupleDestructure(_, init, _, _, _) | .StructDestructure(_, init, _, _, _) | .ListDestructure(_, init, _, _, _, _, _) -> &children.push(init)
        .Assign(place, _, value, _, _, _) -> {
            if place == {
                .Expr(place_value) -> &children.push(place_value)
                else -> {}
            }
            &children.push(value)
        }
        .Return(value, _) -> {
            if value == Val(nested) -> &children.push(nested)
        }
        .ExprStmt(value, _) -> &children.push(value)
        .TaskGroup(_, limit, body, _) -> {
            if limit == Val(nested) -> &children.push(nested)
            loop child in tir_stmt_list_children(body) -> &children.push(child)
        }
        .DeferClose(close, _, _, _) -> &children.push(close)
        .If(condition, then_body, else_body, _, _) -> {
            loop child in tir_if_cond_children(condition) -> &children.push(child)
            loop child in tir_stmt_list_children(then_body) -> &children.push(child)
            tir_else_children_into(&children, else_body)
        }
        .Loop(_, body, _) -> loop child in tir_stmt_list_children(body) -> &children.push(child)
        .While(_, condition, body, _) -> {
            &children.push(condition)
            loop child in tir_stmt_list_children(body) -> &children.push(child)
        }
        .CountedLoop(_, init, condition, step, _, body, _) -> {
            loop child in tir_stmt_children(init) -> &children.push(child)
            &children.push(condition)
            if step == Val(nested) {
                loop child in tir_stmt_children(nested) -> &children.push(child)
            }
            loop child in tir_stmt_list_children(body) -> &children.push(child)
        }
        .ForRange(_, _, start, end, step, _, body, _, _) -> {
            &children.push(start)
            &children.push(end)
            if step == Val(nested) -> &children.push(nested)
            loop child in tir_stmt_list_children(body) -> &children.push(child)
        }
        .Range(_, _, source, start, end, step, _, _, body, _) -> {
            if source == Val(nested_source) -> &children.push(nested_source)
            &children.push(start)
            &children.push(end)
            if step == Val(nested_step) -> &children.push(nested_step)
            loop child in tir_stmt_list_children(body) -> &children.push(child)
        }
        .BreakValue(_, value, _) -> &children.push(value)
        .Match(subject, arms, _, _) -> {
            &children.push(subject)
            loop child in tir_match_arm_children(arms) -> &children.push(child)
        }
        .EnumMatch(scrutinee, _, arms, else_body, _, _) -> {
            &children.push(scrutinee)
            loop child in tir_match_arm_children(arms) -> &children.push(child)
            if else_body == Val(nested) {
                loop child in tir_stmt_list_children(nested) -> &children.push(child)
            }
        }
        .RangeSwitch(subject, arms, else_body, _) -> {
            &children.push(subject)
            loop arm in arms {
                loop child in tir_stmt_list_children(arm.body) -> &children.push(child)
            }
            loop child in tir_stmt_list_children(else_body) -> &children.push(child)
        }
        .IndexAssign(_, base, index, _, value, _) -> {
            &children.push(base)
            &children.push(index)
            &children.push(value)
        }
        .IndexFieldAssign(value, _) -> {
            &children.push(value.base)
            &children.push(value.index)
            &children.push(value.value)
        }
        .IndexHookAssign(_, base, index, value, _) -> {
            &children.push(base)
            &children.push(index)
            &children.push(value)
        }
        .MathSwizzleAssign(base, _, _, value, _, _) -> {
            &children.push(base)
            &children.push(value)
        }
        .ForIn(_, _, _, source, collection, step, _, _, _, body, _) -> {
            &children.push(source)
            &children.push(collection)
            if step == Val(nested) -> &children.push(nested)
            loop child in tir_stmt_list_children(body) -> &children.push(child)
        }
        .Inline(body, _) | .DebugOnly(body, _) | .Impure(body, _) | .Region(body, _) | .Live(body, _) | .Shield(body, _) -> loop child in tir_stmt_list_children(body) -> &children.push(child)
        .MixedSwitch(subject, _, arms, else_body, _) -> {
            &children.push(subject)
            loop arm in arms {
                &children.push(arm.condition)
                loop child in tir_stmt_list_children(arm.body) -> &children.push(child)
            }
            if else_body == Val(nested) {
                loop child in tir_stmt_list_children(nested) -> &children.push(child)
            }
        }
        .Unsafe(_, body) -> loop child in tir_stmt_list_children(body) -> &children.push(child)
        .UnsafeBlock(_, body, _) | .SentryPolicy(_, body, _) -> loop child in tir_stmt_list_children(body) -> &children.push(child)
        .Reactive(executable, _) -> loop child in tir_lambda_children(executable) -> &children.push(child)
        .Layout(_, _, body, _) -> loop child in tir_stmt_list_children(body) -> &children.push(child)
        .ContextBlock(guards, body, _) -> {
            loop guard in guards -> &children.push(guard.value)
            loop child in tir_stmt_list_children(body) -> &children.push(child)
        }
        .ScopeMember(kind, body, _) -> {
            if kind == {
                .Timeout(duration) -> &children.push(duration)
                else -> {}
            }
            loop child in tir_stmt_list_children(body) -> &children.push(child)
        }
        .Transact(_, _, _, body, _) -> loop child in tir_stmt_list_children(body) -> &children.push(child)
        .GCEdit(_, _, _, _, index_temp, edited, _) -> {
            if index_temp == Val(nested) -> &children.push(nested)
            loop child in tir_stmt_children(edited) -> &children.push(child)
        }
        .SplitViews(owner, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> {
            if owner == Val(nested) -> &children.push(nested)
        }
        else -> {}
    }
    children
}

fn tir_place_children(place: TPlace) -> [TExpr] Never! {
    children := [TExpr]{}
    if place == {
        .Expr(value) -> &children.push(value)
        else -> {}
    }
    children
}

fn tir_require_children(requirement: TRequireKind) -> [TExpr] Never! {
    children := [TExpr]{}
    if requirement == {
        .Require(condition, message) -> {
            &children.push(condition)
            if message == Val(message_value) -> &children.push(message_value)
        }
        .RequireEq(left, right) -> {
            &children.push(left)
            &children.push(right)
        }
        .Panic(message) -> &children.push(message)
    }
    children
}

fn tir_or_fallback_children(fallback: TOrFallback) -> [TExpr] Never! {
    children := [TExpr]{}
    if fallback == {
        .Value(value) -> &children.push(value)
        .Return(value) -> {
            if value == Val(nested) -> &children.push(nested)
        }
        .Panic(message, _) -> &children.push(message)
        else -> {}
    }
    children
}

fn tir_list_spread_children(parts: [TListSpreadPart]) -> [TExpr] Never! {
    children := [TExpr]{}
    loop part in parts {
        if part == {
            .Element(value) | .Spread(value) -> &children.push(value)
        }
    }
    children
}

fn tir_host_arg_children(argument: THostArg) -> [TExpr] Never! {
    children := [TExpr]{}
    if argument == {
        .Expr(value) | .Borrow(value) -> &children.push(value)
        .Lambda(value) -> loop child in tir_lambda_children(value) -> &children.push(child)
    }
    children
}

fn tir_host_call_children(call: THostCall) -> [TExpr] Never! {
    children := [TExpr]{}
    if call == {
        .Helper(_, _, args) -> loop argument in args {
            loop child in tir_host_arg_children(argument) -> &children.push(child)
        }
        .Method(receiver, _, args) -> {
            &children.push(receiver)
            loop value in args -> &children.push(value)
        }
        .CarrierFact(receiver, _, _) -> &children.push(receiver)
        .CellGuardProject(receiver, _, _, _, _) -> &children.push(receiver)
        .FixedListIndex(base, index, _) -> {
            &children.push(base)
            &children.push(index)
        }
        .TypedText(_, argument) -> &children.push(argument)
        .GCEdit(_, _, _, edit, index_temp, _) -> {
            &children.push(edit)
            if index_temp == Val(index_value) -> &children.push(index_value)
        }
        .OptionProbe(inner, _) -> &children.push(inner)
        .TupleIndex(base, _) -> &children.push(base)
        .StrMatchScan(subject, _, _) | .BinMatchScan(subject, _, _) -> &children.push(subject)
        .YieldSend(value) -> &children.push(value)
        .TypedTextInterp(_, _, holes, _) -> loop hole in holes -> &children.push(hole)
        .ExpectSnapshot(value, _) -> &children.push(value)
        .EnvSet(name, value, _) -> {
            &children.push(name)
            &children.push(value)
        }
        .ExpiringSecretNew(value, duration, clock, _) -> {
            &children.push(value)
            &children.push(duration)
            &children.push(clock)
        }
        .ExpiringValueNew(value, duration, clock) -> {
            &children.push(value)
            &children.push(duration)
            &children.push(clock)
        }
        .CCallback(_, lambda, _, _, _, _) -> loop child in tir_lambda_children(lambda) -> &children.push(child)
        else -> {}
    }
    children
}

fn tir_core_closure_children(kind: TCoreClosureKind) -> [TExpr] Never! {
    children := [TExpr]{}
    if kind == {
        .Spawn(group, _, _, executable) -> {
            if group == Val(group_value) -> &children.push(group_value)
            loop child in tir_lambda_children(executable) -> &children.push(child)
        }
        .Realtime(rate, frames, executable) -> {
            &children.push(rate)
            &children.push(frames)
            loop child in tir_lambda_children(executable) -> &children.push(child)
        }
        .UITextInputOnDrop(state, ime, executable, _) -> {
            &children.push(state)
            &children.push(ime)
            loop child in tir_lambda_children(executable) -> &children.push(child)
        }
        .Serve(address, executable) -> {
            &children.push(address)
            loop child in tir_lambda_children(executable) -> &children.push(child)
        }
        .OnInterrupt(callback) -> &children.push(callback)
        .Guard(executable) -> loop child in tir_lambda_children(executable) -> &children.push(child)
        .ReactiveDerived(executable, _) | .ReactiveEffect(executable, _) | .UIReactiveRender(executable, _) -> loop child in tir_lambda_children(executable) -> &children.push(child)
        .OnCommit(_, executable) | .OnRollback(_, executable) -> loop child in tir_lambda_children(executable) -> &children.push(child)
        .UIButtonOnClick(label, shortcut, accessible_label, executable, _) -> {
            &children.push(label)
            &children.push(shortcut)
            &children.push(accessible_label)
            loop child in tir_lambda_children(executable) -> &children.push(child)
        }
        .UIPreview(name, viewport, executable, site, playground, source_file, source_span, source_start_line, source_start_column, source_end_line, source_end_column, build_id, revision) -> {
            _ := site
            _ := playground
            _ := source_file
            _ := source_span
            _ := source_start_line
            _ := source_start_column
            _ := source_end_line
            _ := source_end_column
            _ := build_id
            _ := revision
            &children.push(name)
            if viewport == Val(viewport_value) -> &children.push(viewport_value)
            loop child in tir_lambda_children(executable) -> &children.push(child)
        }
    }

    children
}
pub fn tir_expr_children(expression: TExpr) -> [TExpr] {
    children := [TExpr]{}
    if expression.kind == {
        .StrLit(parts) -> loop part in parts {
            if part == {
                .Interpolation(value, _) -> &children.push(value)
                else -> {}
            }
        }
        .InlineBlock(body) -> loop child in tir_stmt_list_children(body) -> &children.push(child)
        .Call(_, _, args) -> loop argument in args -> &children.push(argument.value)
        .IndirectCall(callee, _, args, _) -> {
            &children.push(callee)
            loop argument in args -> &children.push(argument.value)
        }
        .MethodCall(receiver, _, _, args) -> {
            &children.push(receiver)
            loop argument in args -> &children.push(argument.value)
        }
        .DistinctCtor(_, argument, _) | .RangeCheckedCtor(_, argument, _) | .DistinctConvert(_, argument, _, _, _) | .TraitBox(argument, _) -> &children.push(argument)
        .UnitConvert(_, argument, _, _, rounding, _, _, _, _) -> {
            &children.push(argument)
            if rounding == Val(rounding_value) -> &children.push(rounding_value.digits)
        }
        .MathBuiltin(_, _, args) | .PreciseBuiltin(_, _, args) -> loop value in args -> &children.push(value)
        .Print(value) | .Drop(value) | .Close(value) | .Move(value) | .ResourceNew(value) -> &children.push(value)
        .AmbientInput(prompt) -> {
            if prompt == Val(prompt_value) -> &children.push(prompt_value)
        }
        .RequireStop(kind, _, _) -> loop child in tir_require_children(kind) -> &children.push(child)
        .Binary(_, _, _, lhs, rhs) -> {
            &children.push(lhs)
            &children.push(rhs)
        }
        .CompareChain(operands, _, _) -> loop value in operands -> &children.push(value)
        .Unary(_, operand) -> &children.push(operand)
        .StructLit(fields, _, _) -> loop field in fields -> &children.push(field.value)
        .Field(receiver, _) -> &children.push(receiver)
        .Index(base, index, _, _, _, _) | .IndexRead(base, index, _, _, _) -> {
            &children.push(base)
            &children.push(index)
        }
        .Slice(base, start, end, range, _) | .SliceOwned(base, start, end, range, _) -> {
            &children.push(base)
            &children.push(start)
            &children.push(end)
            if range == Val(range_value) -> &children.push(range_value)
        }
        .Range(start, end, _) -> {
            &children.push(start)
            &children.push(end)
        }
        .Tuple(values) | .List(values, _) -> loop value in values -> &children.push(value)
        .Map(entries) | .MapLit(entries) -> loop entry in entries {
            &children.push(entry.key)
            &children.push(entry.value)
        }
        .EnumCtor(_, _, payload) | .EnumLit(_, _, payload) -> {
            if payload == {
                .Positional(args) -> loop argument in args -> &children.push(argument.value)
                .Named(fields) -> loop field in fields -> &children.push(field.value.value)
                .Unit -> {}
            }
        }
        .Present(value) | .Ok(value) | .Err(value) | .DistinctRaw(value) -> &children.push(value)
        .Try(value, _, _) -> &children.push(value)
        .TryWithContext(inner, note, _, _, _, _) -> {
            &children.push(inner)
            if note == Val(note_value) -> &children.push(note_value)
        }
        .Lambda(value) | .LambdaValue(value) -> loop child in tir_lambda_children(value) -> &children.push(child)
        .Borrow(place, _) -> &children.push(place)
        .AddressOf(place, _, _) | .RawAddressOf(place) -> loop child in tir_place_children(place) -> &children.push(child)
        .RawOf(value) | .Deref(value) | .PtrFromAddr(value, _) | .LayoutLiteral(value) | .LayoutLit(value) -> &children.push(value)
        .LayoutCompare(_, lhs, rhs) -> {
            &children.push(lhs)
            &children.push(rhs)
        }
        .SharedGuardValue(guard, _) -> &children.push(guard)
        .SharedGuardMap(guard, _, _) -> &children.push(guard)
        .SharedGuardSplit(guard, _, _, _) -> &children.push(guard)
        .SharedGuardWait(guard, condition, predicate) -> {
            &children.push(guard)
            &children.push(condition)
            loop child in tir_lambda_children(predicate) -> &children.push(child)
        }
        .ConditionNotify(condition, _) -> &children.push(condition)
        .CoreCall(_, args, _, _, _, _, _) -> loop value in args -> &children.push(value)
        .HostCall(call) -> loop child in tir_host_call_children(call) -> &children.push(child)
        .JSONLit(_, argument, _) | .DBValueLit(_, argument, _) -> {
            if argument == Val(argument_value) -> &children.push(argument_value)
        }
        .AllocNew(_, args) -> loop argument in args -> &children.push(argument.value)
        .ListLit(values) -> loop value in values -> &children.push(value)
        .ListSpread(parts) -> loop child in tir_list_spread_children(parts) -> &children.push(child)
        .ColumnarListLit(_, elements) -> loop value in elements -> &children.push(value)
        .ColumnarGather(base, index, _) | .ColumnarColumnRead(base, index, _, _, _, _) -> {
            &children.push(base)
            &children.push(index)
        }
        .TupleLit(_, fields) -> loop field in fields -> &children.push(field.value)
        .PoolSlot(pool, id, _, _, _, _) -> {
            &children.push(pool)
            &children.push(id)
        }
        .IndexHook(_, base, index, _) | .MathLaneIndex(_, base, index, _) -> {
            &children.push(base)
            &children.push(index)
        }
        .MathSwizzleRead(_, receiver, _) -> &children.push(receiver)
        .Clone(value) | .ExplicitCopy(value) | .MaterializeView(value) -> &children.push(value)
        .StaticCall(_, _, _, _, args) -> loop argument in args -> &children.push(argument.value)
        .DecodeUnder(segment, inner) -> {
            &children.push(segment)
            &children.push(inner)
        }
        .BuiltinMethod(receiver, _, args) -> {
            &children.push(receiver)
            loop value in args -> &children.push(value)
        }
        .IfExpr(cond, then_body, then_value, else_body, else_value) -> {
            loop child in tir_if_cond_children(cond) -> &children.push(child)
            loop child in tir_stmt_list_children(then_body) -> &children.push(child)
            &children.push(then_value)
            loop child in tir_stmt_list_children(else_body) -> &children.push(child)
            &children.push(else_value)
        }
        .ResultHandler(subject, ok_pattern, ok_body, ok_value, err_pattern, err_body, err_value, terminal) -> {
            &children.push(subject)
            loop child in tir_pattern_children(ok_pattern) -> &children.push(child)
            loop child in tir_stmt_list_children(ok_body) -> &children.push(child)
            &children.push(ok_value)
            loop child in tir_pattern_children(err_pattern) -> &children.push(child)
            loop child in tir_stmt_list_children(err_body) -> &children.push(child)
            &children.push(err_value)
            &children.push(terminal)
        }
        .OrFallback(value, fallback, _) -> {
            &children.push(value)
            loop child in tir_or_fallback_children(fallback) -> &children.push(child)
        }
        .OptField(base, _, _) -> &children.push(base)
        .OptMethodCall(base, _, call, _) -> {
            &children.push(base)
            &children.push(call)
        }
        .PatternMatches(subject, pattern) -> {
            &children.push(subject)
            loop child in tir_pattern_children(pattern) -> &children.push(child)
        }
        .OptionLift2(function, left, right) -> {
            &children.push(function)
            &children.push(left)
            &children.push(right)
        }
        .ClosureMethod(receiver, _, args) -> {
            &children.push(receiver)
            loop value in args -> &children.push(value)
        }
        .HostBorrowCallback(callable, _) -> &children.push(callable)
        .NumericMethod(receiver, _) -> &children.push(receiver)
        .NumericBinaryMethod(receiver, _, argument) -> {
            &children.push(receiver)
            &children.push(argument)
        }
        .OverflowOpt(_, _, _, _, lhs, rhs) -> {
            &children.push(lhs)
            &children.push(rhs)
        }
        .HandleMethod(receiver, _, args) -> {
            &children.push(receiver)
            loop value in args -> &children.push(value)
        }
        .CoreClosureCall(kind) -> loop child in tir_core_closure_children(kind) -> &children.push(child)
        .TaskGroupAll(tasks) | .TaskGroupRace(tasks) | .TaskGroupAny(tasks) -> &children.push(tasks)
        .SelectRecv(builder, channel) -> {
            &children.push(builder)
            &children.push(channel)
        }
        .SelectAfter(builder, duration, value) -> {
            &children.push(builder)
            &children.push(duration)
            if value == Val(nested) -> &children.push(nested)
        }
        .SelectWait(builder, _) -> &children.push(builder)
        .FnValue(kind) -> loop child in tir_fn_value_children(kind) -> &children.push(child)
        .ModuleCall(_, _, _, _, args) -> loop argument in args -> &children.push(argument.value)
        .ExternCall(_, _, args) -> loop argument in args -> &children.push(argument.value)
        else -> {}
    }
    children
}

fn tir_fn_value_children(kind: TFnValueKind) -> [TExpr] Never! {
    children := [TExpr]{}
    if kind == {
        .NamedFn(_, lambda) -> {
            if lambda == Val(lambda_value) {
                loop child in tir_lambda_children(lambda_value) -> &children.push(child)
            }
        }
        .Policy(_, policy_args, _, _, _, callee) -> {
            loop argument in policy_args -> &children.push(argument.value)
            &children.push(callee)
        }
        .Call(callee, args) -> {
            &children.push(callee)
            loop argument in args -> &children.push(argument.value)
        }
        .Send(value) -> &children.push(value)
    }
    children
}

pub fn tir_func_facts(function: TFunc) -> TFactChannel Never! {
    TFactChannel{
        ty: function.ret
        integer_bounds: None
        exclusivity: TFactExclusivity.Unknown
        purity: if function.is_pure -> TFactPurity.Pure else -> TFactPurity.Unknown
        no_cross_iteration_deps: false
        comptime_value: None
        cost: None
    }
}
