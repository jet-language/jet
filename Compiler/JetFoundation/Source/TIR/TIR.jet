// Checked/typed IR shared between sema, lowering, ownership analysis and every
// execution adapter. Nodes carry decisions already proved by sema; consumers
// must not reconstruct those decisions from source spelling.

TIR_SCHEMA_VERSION :: 8

pub enum TAddressLifetime {
    Stack
    Heap
    Static
    Borrowed
    Foreign
    Unknown
}

pub struct TIntegerBounds {
    pub lo: Int
    pub hi: Int
}

pub fn integer_bounds_exact(value: Int) -> TIntegerBounds Never! {
    TIntegerBounds{lo: value, hi: value}
}

pub struct TLocal {
    pub name: String
    pub symbol_id: SymbolID?{None}
    pub span: Span
    pub generated: Bool
    pub deref: Bool
    pub address_lifetime: TAddressLifetime?
    pub persist_key: String?
    pub persist_ty: Type?
    pub mutable: Bool
    pub string_bytes_source: TLocal?
    pub integer_bounds: TIntegerBounds?
    pub uninit_scalar: Bool
    pub uninit_fixed: Bool
    pub direct_closure: Bool
}

pub fn tir_user_local(name: String, span: Span) -> TLocal Never! {
    TLocal{name: name, span: span, generated: false, deref: false, address_lifetime: None, persist_key: None, persist_ty: None, mutable: false, string_bytes_source: None, integer_bounds: None, uninit_scalar: false, uninit_fixed: false, direct_closure: false}
}

pub fn tir_symbol_local(name: String, span: Span, symbol_id: SymbolID) -> TLocal Never! {
    local := tir_user_local(name, span)
    local.symbol_id = Val(symbol_id)
    local
}

pub fn tir_generated_local(name: String, span: Span) -> TLocal Never! {
    TLocal{name: name, span: span, generated: true, deref: false, address_lifetime: None, persist_key: None, persist_ty: None, mutable: false, string_bytes_source: None, integer_bounds: None, uninit_scalar: false, uninit_fixed: false, direct_closure: false}
}

pub fn tir_persistent_local(name: String, module_name: String, ty: Type, span: Span) -> TLocal Never! {
    TLocal{name: name, span: span, generated: false, deref: false, address_lifetime: Val(TAddressLifetime.Static), persist_key: Val("{module_name}::{name}"), persist_ty: Val(ty), mutable: false, string_bytes_source: None, integer_bounds: None, uninit_scalar: false, uninit_fixed: false, direct_closure: false}
}

pub enum TBinaryOp {
    Add
    Sub
    Mul
    Div
    FloorDiv
    Mod
    Rem
    Pow
    BitAnd
    BitOr
    BitXor
    Shl
    Shr
    Eq
    Ne
    Lt
    Gt
    Le
    Ge
    Compare
    And
    Or
}

pub enum TUnaryOp {
    Neg
    Not
}
pub enum TIndexKind {
    Unknown
    List
    Range
    FixedListProof
    Map
    Lane(name: String)
    User(name: String)
    LayoutField(name: String)
    Pool
}

pub enum TStrFormat {
    Display
    Debug
    Pretty
    Fixed(digits: Int)
    Grouped(digits: Int)
    Hex(digits: Int)
    Pad(width: Int, fill: String)
    PadLeft(width: Int, fill: String)
    Sci(digits: Int)
    Percent(digits: Int)
    Bin
    Oct
    Unit(format: TUnitFormat)
}

pub enum TUnitFormat {
    Symbol
    Name
    Bare
}

pub enum TStrPart {
    Literal(text: String)
    Interpolation(value: TExpr, format: TStrFormat)
}

pub struct TCallArg {
    pub value: TExpr
    pub template_items: [SymbolID]
    pub borrow: Bool
    pub mut_borrow: Bool
    pub clone: Bool
    pub arc_clone: Bool
    pub fn_coerce: TFnCoerce?
    pub widen_to_vec: Bool
    pub widen_to_union: Type?
    pub box_as_trait: Type?
    pub label: String?
    pub spread: Bool
}

pub struct TFnCoerce {
    pub ty: Type
    pub already_boxed: Bool
}

pub struct TFieldRef {
    pub owner: SymbolID?
    pub field: SymbolID
    pub name: String
    pub ty: Type
    pub boxed: Bool
}

pub struct TEnumArg {
    pub value: TExpr
    pub clone: Bool
    pub move: Bool
}
pub enum TAllocCtor {
    Arena
    Bump
    Pool
    Fixed(size: Int)
    FixedOver
}

pub enum TEnumPayload {
    Unit
    Positional(args: [TEnumArg])
    Named(fields: [TNamedEnumArg])
}

pub struct TNamedEnumArg {
    pub name: String
    pub value: TEnumArg
}

pub enum TPatternShape {
    Variant(variant: String, bindings: [TPatternBinding], leading_dot: Bool, span: Span)
    // S31: `inner` is a nested payload pattern (`.Val(.Rect(w, h))`).
    Present(binding: String, binding_span: Span, inner: TNestedPattern?, span: Span)
    Absent(span: Span)
    Ok(binding: String, binding_span: Span, inner: TNestedPattern?, span: Span)
    Err(binding: String, binding_span: Span, inner: TNestedPattern?, span: Span)
    Range(lo: Int, hi: Int, span: Span)
    Or(alternatives: [TPatternShape], span: Span)
    Struct(fields: [TPatternField], rest: Span?, span: Span)
    Text(parts: [TTextPatternPart], span: Span)
    Binary(parts: [TBinaryPatternPart], span: Span)
}

// S31: a checked nested payload pattern with the payload type's owner.
pub struct TNestedPattern {
    pub shape: TPatternShape
    pub enum_type: SymbolID?
}

pub enum TPatternPosition {
    Binding
    OptionBinding
    Arm
    VariantPath
    DataEntries(temp: String)
}
pub struct TPatternBindingFact {
    pub name: String
    pub span: Span
    pub ty: Type
    pub mutable: Bool
    pub boxed: Bool
    pub symbol_id: SymbolID?
}

pub struct TPattern {
    pub shape: TPatternShape
    pub bindings: [TPatternBindingFact]
    pub enum_type: SymbolID?
    pub position: TPatternPosition
    pub mutable: Bool
    pub boxed: Bool
}

pub enum TPatternBinding {
    Wildcard
    Bind(name: String, span: Span)
    Range(lo: Int, hi: Int)
    Nested(pattern: TNestedPattern)
}

pub enum TPatternField {
    Bind(field: String, local: String, span: Span)
    Value(field: String, value: TExpr, span: Span)
}

pub enum TTextPatternPart {
    Literal(value: String)
    Hole(name: String, ty: Type, span: Span)
}

pub enum TBinaryPatternPart {
    Literal(value: [U8])
    Bits(name: String, width: Int, big_endian: Bool, ty: Type, span: Span)
    Rest(name: String, ty: Type, span: Span)
}

pub struct TMatchArm {
    pub pattern: TPattern
    pub body: [TStmt]
}

pub enum TIfCond {
    Plain(value: TExpr)
    And(left: TIfCond, right: TIfCond)
    IfLet(pattern: TPattern, subj: TExpr)
    IsNone(subj: TExpr)
    Matches(pattern: TPattern, subj: TExpr)
    WithPrelude(prelude: [TStmt], cond: TIfCond)
}

pub enum TLetWrapper {
    Plain
    Resource
    AutomaticRoot
}

pub enum TLetTy {
    Inferred
    StrView
    Annotated(ty: Type, wrapper: TLetWrapper)
    Tuple(types: [Type])
    SendFn(ty: Type)
}

pub struct TGCPromotion {
    pub span: Span
    pub scope: String
    pub policy_provenance: String
    pub reason: String
    pub edges: [TGCPromotionEdge]
    pub collection_len: Int?
}

pub struct TGCPromotionEdge {
    pub binding: String
    pub slot: String
    pub group: Int
}


pub enum TContractKind { Pre Post }
pub enum TContractDisposition { Check Proven Stripped }

pub struct TContract {
    pub kind: TContractKind
    pub condition: TExpr
    pub message: TExpr
    pub file: String
    pub line: Int
    pub span: Span
    pub disposition: TContractDisposition
}

pub struct TContractResult {
    pub carrier_ty: Type
    pub binding_ty: Type
    pub carrier_local: TLocal
    pub binding_local: TLocal
    pub mode: TContractResultMode
}

pub struct TDestructureBinding {
    pub local: TLocal
    pub field: String
}

pub enum TStmt {
    Contract(contract: TContract)
    ContractScope(pre: [TContract], body: [TStmt], post: [TContract], result: TContractResult, span: Span)
    Let(local: TLocal, let_ty: TLetTy, init: TExpr, gc_promotion: TGCPromotion?, gc_transferred: Bool, span: Span)
    RefutableBind(pattern: TPattern, init: TExpr, fallback: [TStmt], span: Span)
    TupleDestructure(temp: TLocal, init: TExpr, move_fields: Bool, binds: [TDestructureBinding], span: Span)
    StructDestructure(temp: TLocal, init: TExpr, move_fields: Bool, binds: [TDestructureBinding], span: Span)
    ListDestructure(temp: TLocal, init: TExpr, count: Int, file: String, line: Int, elements: [TLocal], span: Span)
    Assign(place: TPlace, op: TBinaryOp?, value: TExpr, clone_value: Bool, line: Int, span: Span)
    CountedLoop(label: String?, init: TStmt, condition: TExpr, step: TStmt?, vectorization: AutoVectorizationFacts?, body: [TStmt], span: Span)
    ForRange(label: String?, local: TLocal, start: TExpr, end: TExpr, step: TExpr?, exclusive: Bool, body: [TStmt], vectorization: AutoVectorizationFacts?, span: Span)
    Range(label: String?, variable: TLocal, source: TExpr?, start: TExpr, end: TExpr, step: TExpr?, exclusive: Bool, vectorization: AutoVectorizationFacts?, body: [TStmt], span: Span)
    ExprStmt(value: TExpr, span: Span)
    Return(value: TExpr?, span: Span)
    TaskGroup(group: TLocal, limit: TExpr?, body: [TStmt], span: Span)
    DeferClose(close: TExpr, resource: SymbolID, scope_id: Int, span: Span)
    If(condition: TIfCond, then_body: [TStmt], else_body: [TStmt]?, else_is_elseif: Bool, span: Span)
    Loop(label: String?, body: [TStmt], span: Span)
    While(label: String?, condition: TExpr, body: [TStmt], span: Span)
    Break(label: String?, span: Span)
    BreakValue(label: String?, value: TExpr, span: Span)
    Continue(label: String?, span: Span)
    Match(subject: TExpr, arms: [TMatchArm], exhaustive: Bool, span: Span)
    EnumMatch(scrutinee: TExpr, clone_subject: Bool, arms: [TMatchArm], else_body: [TStmt]?, fallthrough: Bool, span: Span)
    RangeSwitch(subject: TExpr, arms: [TRangeArm], else_body: [TStmt], span: Span)
    IndexAssign(uninit: Bool, base: TExpr, index: TExpr, is_map: Bool, value: TExpr, span: Span)
    IndexFieldAssign(value: TIndexFieldAssign, span: Span)
    IndexHookAssign(type_name: String, base: TExpr, index: TExpr, value: TExpr, span: Span)
    MathSwizzleAssign(base: TExpr, type_name: String, lanes: [Int], value: TExpr, clone_value: Bool, span: Span)
    ForIn(label: String?, variable: TLocal, variable_two: TLocal?, source: TExpr, collection: TExpr, step: TExpr?, method_kind: TForInMethod?, columnar: Bool, by_value: Bool, body: [TStmt], span: Span)
    Inline(body: [TStmt], span: Span)
    DebugOnly(body: [TStmt], span: Span)
    MixedSwitch(subject: TExpr, class: TBranchClass, arms: [TMixedArm], else_body: [TStmt]?, span: Span)
    Unsafe(gate: TUnsafeGate, body: [TStmt])
    UnsafeBlock(gate: TUnsafeGate, body: [TStmt], span: Span)
    SentryPolicy(enabled: Bool, body: [TStmt], span: Span)
    Impure(body: [TStmt], span: Span)
    Reactive(executable: TLambda, span: Span)
    Region(body: [TStmt], span: Span)
    Layout(handle: TLocal, label: String, body: [TStmt], span: Span)
    ContextBlock(guards: [TContextGuard], body: [TStmt], span: Span)
    Live(body: [TStmt], span: Span)
    Shield(body: [TStmt], span: Span)
    ScopeMember(kind: TScopeMemberKind, body: [TStmt], span: Span)
    Transact(handle: TLocal?, snapshots: [TTransactionSnapshot], stm: TLocal?, body: [TStmt], span: Span)
    GCEdit(root: String, slot: String, edges: [String], replace_all: Bool, index_temp: TExpr?, statement: TStmt, span: Span)
    SplitViews(owner: TExpr?, root: String, len: String, source: String, source_start: Int, before: String, split_tail: String, segment: String, after: String, name: String, start: Int, end: Int, single: Bool, write: Bool, elem_ty: Type?, line: Int, span: Span)
    Erased(construct: String, span: Span, reason: TErasureReason)
    InvariantViolation(construct: String, span: Span)
    LineMarker(line: Int)
    SourceSpan(span: Span)
}

