// Target-checked inline assembly payload carried by TIR functions.
pub enum TInlineAssemblyOutput {
    Parameter(index: Int)
    Register(name: String)
}

pub struct TInlineAssemblyContract {
    pub target: String
    pub output: ?TInlineAssemblyOutput
    pub clobbers: [String]
}

pub struct TInlineAssembly {
    pub source: String
    pub contract: TInlineAssemblyContract
}
