// Target-checked inline assembly payload carried by TIR functions.
enum TInlineAssemblyOutput {
    Parameter(index: Int)
    Register(name: String)
}

struct TInlineAssemblyContract {
    target: String
    output: TInlineAssemblyOutput?
    clobbers: [String]
}

struct TInlineAssembly {
    source: String
    contract: TInlineAssemblyContract
}

// The audited register sets per target, shared by sema's contract check and
// the Rust foreign bridge (D-JETPACK-LAYERS1=A).
fn inline_assembly_target_supported(target: String) -> Bool Never! {
    parts := target.split("-").to_list()
    arch := if parts.len() > 0 -> parts[0] else -> ""
    arch == "x86_64" || arch == "i386" || arch == "i586" || arch == "i686" || arch == "x86" || arch == "aarch64" || arch == "arm" || arch == "armv7" || arch.starts_with("thumb") || arch.starts_with("riscv64")
}

fn inline_assembly_normalize_register(register: String) -> String Never! {
    raw := register
    if raw.starts_with("%") {
        bytes := raw.bytes()
        raw = String.from_bytes(bytes.slice(1, bytes.len())) ?? ""
    }
    bytes := raw.bytes()
    index := 0
    loop index < bytes.len() {
        code := Int.from_u8(bytes[index])
        if code >= 65 && code <= 90 -> bytes[index] = U8{code + 32}
        index += 1
    }
    String.from_bytes(bytes) ?? raw
}

fn inline_assembly_register_number(register: String, prefix: String, lo: Int, hi: Int) -> Bool Never! {
    if !register.starts_with(prefix) -> return false
    bytes := register.bytes()
    prefix_len := prefix.bytes().len()
    if bytes.len() <= prefix_len -> return false
    index := prefix_len
    loop index < bytes.len() {
        code := Int.from_u8(bytes[index])
        if code < 48 || code > 57 -> return false
        index += 1
    }
    suffix := String.from_bytes(bytes.slice(prefix_len, bytes.len())) ?? ""
    number := Int.parse(suffix) ?? return false
    number >= lo && number <= hi
}

fn inline_assembly_register_known(target: String, register: String) -> Bool Never! {
    parts := target.split("-").to_list()
    arch := if parts.len() > 0 -> parts[0] else -> ""
    name := inline_assembly_normalize_register(register)
    if arch == "x86_64" {
        // SSE2 is baseline on x86-64; every SysV vector register is caller-saved.
        if name == "xmm0" || name == "xmm1" || name == "xmm2" || name == "xmm3" || name == "xmm4" || name == "xmm5" || name == "xmm6" || name == "xmm7" || name == "xmm8" || name == "xmm9" || name == "xmm10" || name == "xmm11" || name == "xmm12" || name == "xmm13" || name == "xmm14" || name == "xmm15" -> return true
        return name == "rax" || name == "eax" || name == "ax" || name == "al" || name == "ah" || name == "rbx" || name == "ebx" || name == "bx" || name == "bl" || name == "bh" || name == "rcx" || name == "ecx" || name == "cx" || name == "cl" || name == "ch" || name == "rdx" || name == "edx" || name == "dx" || name == "dl" || name == "dh" || name == "rsi" || name == "esi" || name == "si" || name == "sil" || name == "rdi" || name == "edi" || name == "di" || name == "dil" || name == "r8" || name == "r8d" || name == "r8w" || name == "r8b" || name == "r9" || name == "r9d" || name == "r9w" || name == "r9b" || name == "r10" || name == "r10d" || name == "r10w" || name == "r10b" || name == "r11" || name == "r11d" || name == "r11w" || name == "r11b" || name == "r12" || name == "r12d" || name == "r12w" || name == "r12b" || name == "r13" || name == "r13d" || name == "r13w" || name == "r13b" || name == "r14" || name == "r14d" || name == "r14w" || name == "r14b" || name == "r15" || name == "r15d" || name == "r15w" || name == "r15b"
    }
    if arch == "i386" || arch == "i586" || arch == "i686" || arch == "x86" {
        return name == "eax" || name == "ax" || name == "al" || name == "ah" || name == "ebx" || name == "bx" || name == "bl" || name == "bh" || name == "ecx" || name == "cx" || name == "cl" || name == "ch" || name == "edx" || name == "dx" || name == "dl" || name == "dh" || name == "esi" || name == "si" || name == "sil" || name == "edi" || name == "di" || name == "dil"
    }
    if arch == "aarch64" -> return inline_assembly_register_number(name, "x", 0, 30) || inline_assembly_register_number(name, "w", 0, 30)
    if arch == "arm" || arch == "armv7" || arch.starts_with("thumb") -> return inline_assembly_register_number(name, "r", 0, 12) || name == "r14"
    if arch.starts_with("riscv64") -> return inline_assembly_register_number(name, "x", 1, 31)
    false
}
