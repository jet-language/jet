// Target-checked inline assembly payload carried by TIR functions.
enum TInlineAssemblyOutput {
    Parameter(index: Int)
    Register(name: String)
}

struct TInlineAssemblyContract {
    target: String
    output: TInlineAssemblyOutput?
    clobbers: [String]
}

struct TInlineAssembly {
    source: String
    contract: TInlineAssemblyContract
}
