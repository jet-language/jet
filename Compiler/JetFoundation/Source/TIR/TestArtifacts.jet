enum TTestKind { Unit Property }

struct TTestParamFact {
    index: Int
    name: String
    span: Span
    ty: Type
    convention: AccessConvention
    label: String
    zone: ParamZone
    variadic: Bool
    default_present: Bool
}

struct TTestFact {
    key: String
    function: TFunctionRef
    name: String
    span: Span
    kind: TTestKind
    parameters: [TTestParamFact]
    faults: [String]
    expected_failure: Bool
    contract_generated: Bool
    eligibility: TFunctionRef?
    generation_unavailable_reason: String?
}

struct TJobArgumentFact {
    name: String
    label: String
    ty: String
    required: Bool
    default: String?
    variadic: Bool
    zone: ParamZone
}

struct TJobFact {
    key: String
    function: TFunctionRef?
    name: String
    scope: JobScope
    doc: String?
    arguments: [TJobArgumentFact]
    schedule: EverySchedule?
    after: [String]
    parallel: Int
    packages: [String]
    working_directory: String?
    input_paths: [String]
    output_paths: [String]
    skip: JobSkip?
    cache: JobCachePolicy
    limits: [StringMapEntry]
}

struct TOutputCheckFact {
    key: String
    name: String
    function: TFunctionRef
}

struct TCoveragePointFact {
    key: String
    function: TFunctionRef
    block: String?
    span: Span
}

enum THarnessKind { Test Fuzz Coverage }

struct THarnessPlanFact {
    key: String
    kind: THarnessKind
    tests: [String]
    output_checks: [TOutputCheckFact]
    selected_test: String?
    coverage_points: [TCoveragePointFact]
    command_override: Bool
}

fn tir_test_artifact_key(module_identity: String, test: TestDef) -> String Never! {
    name := test.name ?? "anonymous"
    local := "test::{name}@{test.span.start}..{test.span.end}"
    if module_identity == "" -> local else -> "{module_identity}::{local}"
}

fn tir_test_artifact_function_ref(module_identity: String, test: TestDef) -> TFunctionRef Never! {
    key := tir_test_artifact_key(module_identity, test)
    TFunctionRef{
        key: key,
        module_identity: module_identity,
        name: key,
        span: test.span,
        visibility: TVisibility.Private,
    }
}

fn tir_test_artifact_fact(module_identity: String, test: TestDef) -> TTestFact Never! {
    parameters := [TTestParamFact]{}
    index := 0
    loop parameter in test.params {
        &parameters.push(TTestParamFact{
            index: index,
            name: parameter.name,
            span: parameter.name_span,
            ty: parameter.ty,
            convention: parameter.convention,
            label: parameter.public_label.map((label) -> label.name) ?? parameter.name,
            zone: parameter.zone,
            variadic: parameter.variadic,
            default_present: parameter.default != None,
        })
        index += 1
    }
    key := tir_test_artifact_key(module_identity, test)
    TTestFact{
        key: key,
        function: tir_test_artifact_function_ref(module_identity, test),
        name: test.name ?? key,
        span: test.span,
        kind: if test.params.len() == 0 -> TTestKind.Unit else -> TTestKind.Property,
        parameters: parameters,
        faults: test.faults,
        expected_failure: test.expected_fail,
        contract_generated: false,
        eligibility: None,
        generation_unavailable_reason: None,
    }
}

fn tir_job_artifact_fact(function: TFunctionRef, name: String, doc: String?, arguments: [TJobArgumentFact], schedule: EverySchedule?, metadata: JobMetadata) -> TJobFact Never! {
    local := "job::{name}"
    key := if function.module_identity == "" -> local else -> "{function.module_identity}::{local}"
    TJobFact{
        key: key,
        function: Val(function),
        name: name,
        scope: metadata.scope,
        doc: doc,
        arguments: arguments,
        schedule: schedule,
        after: metadata.after,
        parallel: metadata.parallel ?? 1,
        packages: metadata.packages,
        working_directory: metadata.cwd,
        input_paths: metadata.inputs,
        output_paths: metadata.outputs,
        skip: metadata.skip,
        cache: metadata.cache,
        limits: metadata.limits,
    }
}
