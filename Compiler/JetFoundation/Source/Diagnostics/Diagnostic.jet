// Canonical diagnostic values shared by every compiler phase. Spans are UTF-8
// byte offsets into the checked source; edits and labels use the same spans.

pub struct Span {
    pub start: Int
    pub end: Int
}

pub struct TextEdit {
    pub span: Span
    pub new_text: String
}
pub enum DiagnosticMoment { Compile Run Test Tool }

pub enum DiagnosticFixApplicability { Safe Suggested }

pub enum DiagnosticFixSafety { Formatting BehaviorPreserving APIChanging TargetChanging NeedsReview }

pub enum DiagnosticNoFixReasonKind { Behavior Design Ambiguous }

pub struct DiagnosticNoFixReason {
    pub kind: DiagnosticNoFixReasonKind
    pub next: String
}

pub struct DiagnosticOrigin {
    pub display: String
    pub path: String
    pub source: String
    pub revision: String
}

pub struct DiagnosticCause {
    pub code: String
    pub span: Span?{None}
    pub origin: DiagnosticOrigin?{None}
}

// A secondary source location explaining the primary report, such as the
// earlier move a later use reaches. The host renderer draws it as its own
// `file:line:col` snippet with a caret and the message.
pub struct DiagnosticLabel {
    pub span: Span
    pub message: String
}

pub enum DiagnosticCryptoMisuseReason {
    InvalidLength
    NonceLength
    OutputLength
    SaltLength
    MemoryCost
    IterationCount
    LaneCount
    MemoryTimeCost
    RawNonce
    RawAlgorithm
    DeterministicEntropy
}

pub struct DiagnosticErrorContextFrame {
    pub text: String
    pub file: String
    pub line: Int
}

pub struct DiagnosticErrorConversion {
    pub source: String
    pub target: String
}

pub struct DiagnosticErrorField {
    pub name: String
    pub value: String
}

pub struct DiagnosticErrorSpan {
    pub start: Int
    pub end: Int
}

pub struct DiagnosticErrorDetails {
    pub variant: String
    pub fields: [DiagnosticErrorField]
    pub source_span: DiagnosticErrorSpan?{None}
}

pub struct DiagnosticErrorJourneyFrame {
    pub fn_name: String
    pub file: String
    pub line: Int
    pub note: String
    pub hops: Int
}

pub struct DiagnosticBuildError {
    pub code: String?{None}
    pub message: String
    pub typed_identity: String?{None}
    pub causes: [DiagnosticBuildError]{[DiagnosticBuildError]{}}
    pub context_frames: [DiagnosticErrorContextFrame]{[DiagnosticErrorContextFrame]{}}
    pub source_journey: [DiagnosticErrorJourneyFrame]{[DiagnosticErrorJourneyFrame]{}}
    pub conversion_history: [DiagnosticErrorConversion]{[DiagnosticErrorConversion]{}}
    pub details: DiagnosticErrorDetails?{None}
}

pub enum DiagnosticStructured {
    SuggestedEdits(edits: [TextEdit])
    CryptoMisuse(reason: DiagnosticCryptoMisuseReason, operation: String, expected: String?, actual: Int?)
    BuildError(report: DiagnosticBuildError)
    RuntimeHostFault(stdout: String)
}

pub struct Diagnostic {
    pub moment: DiagnosticMoment{DiagnosticMoment.Compile}
    pub severity: Int
    pub code: String
    pub span: Span?{None}
    pub source_path: String?{None}
    pub source_offset: Int?{None}
    pub source_start: Int?{None}
    pub origin: DiagnosticOrigin?{None}
    pub cause: [DiagnosticCause]{[DiagnosticCause]{}}
    pub labels: [DiagnosticLabel]{[DiagnosticLabel]{}}
    pub what: String
    pub why: String
    pub fix: String
    pub edit: TextEdit?{None}
    pub applicability: DiagnosticFixApplicability?{None}
    pub safety: DiagnosticFixSafety?{None}
    pub no_fix_reason: DiagnosticNoFixReason?{None}
    pub detail: String?{None}
    pub structured: DiagnosticStructured?{None}
    pub decision_row: MIRDecisionRow?{None}
    pub denial_kind: String?{None}
    pub call_chain: [String]{[String]{}}
    pub scope_chain: [String]{[String]{}}
    pub nearest_granting_scope: String?{None}
}

pub fn diagnostic_with_source_path(diagnostic: ^Diagnostic, source_path: String, aggregate_source_offset: Int) -> Diagnostic Never! {
    updated := diagnostic
    updated.source_path = Val(source_path)
    updated.source_offset = Val(aggregate_source_offset)
    updated.source_start = Val(0)
    updated
}

pub fn diagnostic_with_source_mapping(diagnostic: ^Diagnostic, source_path: String, aggregate_source_offset: Int, source_start: Int) -> Diagnostic Never! {
    updated := diagnostic
    updated.source_path = Val(source_path)
    updated.source_offset = Val(aggregate_source_offset)
    updated.source_start = Val(source_start)
    updated
}

pub fn diagnostic_with_edit(diagnostic: Diagnostic, edit: TextEdit) -> Diagnostic Never! {
    diagnostic_registry_with_edit(^diagnostic, edit)
}

pub fn diagnostic_with_moment(diagnostic: ^Diagnostic, moment: DiagnosticMoment) -> Diagnostic Never! {
    updated := diagnostic
    updated.moment = moment
    updated
}

pub fn diagnostic_with_origin(diagnostic: ^Diagnostic, origin: DiagnosticOrigin) -> Diagnostic Never! {
    updated := diagnostic
    updated.origin = Val(origin)
    updated
}

pub fn diagnostic_with_cause(diagnostic: ^Diagnostic, cause: DiagnosticCause) -> Diagnostic Never! {
    updated := diagnostic
    &updated.cause.push(cause)
    updated
}

pub fn diagnostic_with_causes(diagnostic: ^Diagnostic, causes: [DiagnosticCause]) -> Diagnostic Never! {
    updated := diagnostic
    updated.cause = causes
    updated
}

pub fn diagnostic_with_label(diagnostic: ^Diagnostic, span: Span, message: String) -> Diagnostic Never! {
    updated := diagnostic
    &updated.labels.push(DiagnosticLabel{span: span, message: message})
    updated
}

pub fn diagnostic_with_edit_grade(diagnostic: Diagnostic, edit: TextEdit, applicability: DiagnosticFixApplicability, safety: DiagnosticFixSafety) -> Diagnostic Never! {
    diagnostic_registry_with_edit_grade(^diagnostic, edit, applicability, safety)
}

pub fn diagnostic_with_fix_grades(diagnostic: Diagnostic, applicability: DiagnosticFixApplicability, safety: DiagnosticFixSafety) -> Diagnostic Never! {
    edit :: diagnostic.edit ?? panic("diagnostic `{diagnostic.code}` needs an edit before applying explicit fix grades")
    diagnostic_registry_with_edit_grade(^diagnostic, edit, applicability, safety)
}

pub fn diagnostic_with_structured_edit(diagnostic: Diagnostic, edit: TextEdit) -> Diagnostic Never! {
    diagnostic_registry_with_structured_edit(^diagnostic, edit)
}

pub fn diagnostic_with_source_derived_suggestion(diagnostic: Diagnostic, span: Span, new_text: String) -> Diagnostic Never! {
    diagnostic_registry_with_source_derived_suggestion(^diagnostic, span, new_text)
}

pub fn diagnostic_with_alternative_edit(diagnostic: Diagnostic, edit: TextEdit) -> Diagnostic Never! {
    diagnostic_registry_with_alternative_edit(^diagnostic, edit)
}

pub fn diagnostic_with_no_fix_reason(diagnostic: ^Diagnostic, reason: DiagnosticNoFixReason) -> Diagnostic Never! {
    updated := diagnostic
    updated.no_fix_reason = Val(reason)
    updated
}

pub fn diagnostic_with_detail(diagnostic: ^Diagnostic, detail: String) -> Diagnostic Never! {
    updated := diagnostic
    updated.detail = Val(detail)
    updated
}

pub fn diagnostic_with_structured(diagnostic: ^Diagnostic, structured: DiagnosticStructured) -> Diagnostic Never! {
    updated := diagnostic
    updated.structured = Val(structured)
    updated
}

pub fn diagnostic_with_decision_row(diagnostic: ^Diagnostic, decision_row: MIRDecisionRow) -> Diagnostic Never! {
    updated := diagnostic
    updated.decision_row = Val(decision_row)
    updated
}

pub fn diagnostic_with_rights(diagnostic: ^Diagnostic, denial_kind: String, call_chain: [String], scope_chain: [String], nearest_granting_scope: String?) -> Diagnostic Never! {
    updated := diagnostic
    updated.denial_kind = Val(denial_kind)
    updated.call_chain = call_chain
    updated.scope_chain = scope_chain
    updated.nearest_granting_scope = nearest_granting_scope
    updated
}

pub DIAGNOSTIC_ERROR :: 1
pub DIAGNOSTIC_LINT :: 2
