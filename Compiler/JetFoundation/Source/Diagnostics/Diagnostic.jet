// Canonical diagnostic values shared by every compiler phase. Spans are UTF-8
// byte offsets into the checked source; edits and labels use the same spans.

Span: struct {
    start: Int
    end: Int
}

TextEdit: struct {
    span: Span
    new_text: String
}
DiagnosticMoment: enum { Compile Run Test Tool }

DiagnosticFixApplicability: enum { Safe Suggested }

DiagnosticFixSafety: enum { Formatting BehaviorPreserving APIChanging TargetChanging NeedsReview }

DiagnosticNoFixReasonKind: enum { Behavior Design Ambiguous }

DiagnosticNoFixReason: struct {
    kind: DiagnosticNoFixReasonKind
    next: String
}

DiagnosticOrigin: struct {
    display: String
    path: String
    source: String
    revision: String
}

DiagnosticCause: struct {
    code: String
    span: Span?{None}
    origin: DiagnosticOrigin?{None}
}

// A secondary source location explaining the primary report, such as the
// earlier move a later use reaches. The host renderer draws it as its own
// `file:line:col` snippet with a caret and the message.
DiagnosticLabel: struct {
    span: Span
    message: String
}

DiagnosticCryptoMisuseReason: enum {
    InvalidLength
    NonceLength
    OutputLength
    SaltLength
    MemoryCost
    IterationCount
    LaneCount
    MemoryTimeCost
    RawNonce
    RawAlgorithm
    DeterministicEntropy
}

DiagnosticErrorContextFrame: struct {
    text: String
    file: String
    line: Int
}

DiagnosticErrorConversion: struct {
    source: String
    target: String
}

DiagnosticErrorField: struct {
    name: String
    value: String
}

DiagnosticErrorSpan: struct {
    start: Int
    end: Int
}

DiagnosticErrorDetails: struct {
    variant: String
    fields: [DiagnosticErrorField]
    source_span: DiagnosticErrorSpan?{None}
}

DiagnosticErrorJourneyFrame: struct {
    fn_name: String
    file: String
    line: Int
    note: String
    hops: Int
}

DiagnosticBuildError: struct {
    code: String?{None}
    message: String
    typed_identity: String?{None}
    causes: [DiagnosticBuildError]{[DiagnosticBuildError]{}}
    context_frames: [DiagnosticErrorContextFrame]{[DiagnosticErrorContextFrame]{}}
    source_journey: [DiagnosticErrorJourneyFrame]{[DiagnosticErrorJourneyFrame]{}}
    conversion_history: [DiagnosticErrorConversion]{[DiagnosticErrorConversion]{}}
    details: DiagnosticErrorDetails?{None}
}

DiagnosticStructured: enum {
    SuggestedEdits(edits: [TextEdit])
    CryptoMisuse(reason: DiagnosticCryptoMisuseReason, operation: String, expected: String?, actual: Int?)
    BuildError(report: DiagnosticBuildError)
    RuntimeHostFault(stdout: String)
}

Diagnostic: struct {
    moment: DiagnosticMoment{DiagnosticMoment.Compile}
    severity: Int
    code: String
    span: Span?{None}
    source_path: String?{None}
    source_offset: Int?{None}
    source_start: Int?{None}
    origin: DiagnosticOrigin?{None}
    cause: [DiagnosticCause]{[DiagnosticCause]{}}
    labels: [DiagnosticLabel]{[DiagnosticLabel]{}}
    what: String
    why: String
    fix: String
    edit: TextEdit?{None}
    applicability: DiagnosticFixApplicability?{None}
    safety: DiagnosticFixSafety?{None}
    no_fix_reason: DiagnosticNoFixReason?{None}
    detail: String?{None}
    structured: DiagnosticStructured?{None}
    denial_kind: String?{None}
    call_chain: [String]{[String]{}}
    scope_chain: [String]{[String]{}}
    nearest_granting_scope: String?{None}
}

diagnostic_with_source_path: fn(diagnostic: &&Diagnostic, source_path: String, aggregate_source_offset: Int) -> Diagnostic Never! {
    updated := diagnostic
    updated.source_path = Val(source_path)
    updated.source_offset = Val(aggregate_source_offset)
    updated.source_start = Val(0)
    updated
}

diagnostic_with_source_mapping: fn(diagnostic: &&Diagnostic, source_path: String, aggregate_source_offset: Int, source_start: Int) -> Diagnostic Never! {
    updated := diagnostic
    updated.source_path = Val(source_path)
    updated.source_offset = Val(aggregate_source_offset)
    updated.source_start = Val(source_start)
    updated
}

diagnostic_with_edit: fn(diagnostic: Diagnostic, edit: TextEdit) -> Diagnostic Never! {
    // copy: `diagnostic` is a read parameter; the registry builder owns the value it edits.
    diagnostic_registry_with_edit(diagnostic.copy(), edit)
}

diagnostic_with_moment: fn(diagnostic: &&Diagnostic, moment: DiagnosticMoment) -> Diagnostic Never! {
    updated := diagnostic
    updated.moment = moment
    updated
}

diagnostic_with_origin: fn(diagnostic: &&Diagnostic, origin: DiagnosticOrigin) -> Diagnostic Never! {
    updated := diagnostic
    updated.origin = Val(origin)
    updated
}

diagnostic_with_cause: fn(diagnostic: &&Diagnostic, cause: DiagnosticCause) -> Diagnostic Never! {
    updated := diagnostic
    updated.cause.push(cause.copy())
    updated
}

diagnostic_with_causes: fn(diagnostic: &&Diagnostic, causes: [DiagnosticCause]) -> Diagnostic Never! {
    updated := diagnostic
    updated.cause = causes
    updated
}

// Put the nearest wrapped report first, followed by its own causes in their
// existing order.
diagnostic_caused_by: fn(diagnostic: &&Diagnostic, cause: Diagnostic) -> Diagnostic Never! {
    updated := diagnostic
    updated.cause.push(DiagnosticCause{code: cause.code.copy(), span: cause.span, origin: cause.origin.copy()})
    loop link in cause.cause -> updated.cause.push(link.copy())
    updated
}

// A cause names a report by its code, primary span and owning source snapshot.
diagnostic_cause_matches: fn(cause: DiagnosticCause, diagnostic: Diagnostic) -> Bool Never! {
    cause.code == diagnostic.code && cause.span == diagnostic.span && cause.origin == diagnostic.origin
}

diagnostic_cause_is_pending: fn(diagnostic: Diagnostic, pending: [Diagnostic]) -> Bool Never! {
    loop cause in diagnostic.cause {
        loop candidate in pending {
            if diagnostic_cause_matches(cause, candidate) -> return true
        }
    }
    false
}

// Put root diagnostics before reports that name them as causes. The stable pass
// keeps source order among independent reports and breaks a cycle by leaving
// the remaining reports in their original order.
diagnostic_order_root_first: fn(diagnostics: &&[Diagnostic]) -> [Diagnostic] Never! {
    pending := diagnostics
    ordered := [Diagnostic]{}
    loop pending.len() > 0 {
        next := -1
        loop index in 0..<pending.len() {
            if !diagnostic_cause_is_pending(pending[index], pending) {
                next = index
                break
            }
        }
        if next < 0 {
            loop rest in pending -> ordered.push(rest.copy())
            break
        }
        root: pending.remove(next, .Slot) ?? panic("root-first ordering selected a pending diagnostic")
        ordered.push(root)
    }
    ordered
}

diagnostic_with_label: fn(diagnostic: &&Diagnostic, span: Span, message: String) -> Diagnostic Never! {
    updated := diagnostic
    updated.labels.push(DiagnosticLabel{span: span, message: message})
    updated
}

diagnostic_with_edit_grade: fn(diagnostic: Diagnostic, edit: TextEdit, applicability: DiagnosticFixApplicability, safety: DiagnosticFixSafety) -> Diagnostic Never! {
    // copy: `diagnostic` is a read parameter; the registry builder owns the value it edits.
    diagnostic_registry_with_edit_grade(diagnostic.copy(), edit, applicability, safety)
}

diagnostic_with_fix_grades: fn(diagnostic: Diagnostic, applicability: DiagnosticFixApplicability, safety: DiagnosticFixSafety) -> Diagnostic Never! {
    edit: diagnostic.edit ?? panic("diagnostic `{diagnostic.code}` needs an edit before applying explicit fix grades")
    // copy: `diagnostic` is a read parameter; the registry builder owns the value it edits.
    diagnostic_registry_with_edit_grade(diagnostic.copy(), edit, applicability, safety)
}

diagnostic_with_structured_edit: fn(diagnostic: Diagnostic, edit: TextEdit) -> Diagnostic Never! {
    // copy: `diagnostic` is a read parameter; the registry builder owns the value it edits.
    diagnostic_registry_with_structured_edit(diagnostic.copy(), edit)
}

diagnostic_with_source_derived_suggestion: fn(diagnostic: Diagnostic, span: Span, new_text: String) -> Diagnostic Never! {
    // copy: `diagnostic` is a read parameter; the registry builder owns the value it edits.
    diagnostic_registry_with_source_derived_suggestion(diagnostic.copy(), span, new_text)
}

diagnostic_with_alternative_edit: fn(diagnostic: Diagnostic, edit: TextEdit) -> Diagnostic Never! {
    // copy: `diagnostic` is a read parameter; the registry builder owns the value it edits.
    diagnostic_registry_with_alternative_edit(diagnostic.copy(), edit)
}

diagnostic_with_no_fix_reason: fn(diagnostic: &&Diagnostic, reason: DiagnosticNoFixReason) -> Diagnostic Never! {
    updated := diagnostic
    updated.no_fix_reason = Val(reason)
    updated
}

diagnostic_with_detail: fn(diagnostic: &&Diagnostic, detail: String) -> Diagnostic Never! {
    updated := diagnostic
    updated.detail = Val(detail)
    updated
}

diagnostic_with_structured: fn(diagnostic: &&Diagnostic, structured: DiagnosticStructured) -> Diagnostic Never! {
    updated := diagnostic
    updated.structured = Val(structured)
    updated
}

diagnostic_with_rights: fn(diagnostic: &&Diagnostic, denial_kind: String, call_chain: [String], scope_chain: [String], nearest_granting_scope: String?) -> Diagnostic Never! {
    updated := diagnostic
    updated.denial_kind = Val(denial_kind)
    updated.call_chain = call_chain
    updated.scope_chain = scope_chain
    updated.nearest_granting_scope = nearest_granting_scope
    updated
}

DIAGNOSTIC_ERROR: 1
DIAGNOSTIC_LINT: 2
