// Canonical diagnostic values shared by every compiler phase. Spans are UTF-8
// byte offsets into the checked source; edits and labels use the same spans.

struct Span {
    start: Int
    end: Int
}

struct TextEdit {
    span: Span
    new_text: String
}
enum DiagnosticMoment { Compile Run Test Tool }

enum DiagnosticFixApplicability { Safe Suggested }

enum DiagnosticFixSafety { Formatting BehaviorPreserving APIChanging TargetChanging NeedsReview }

enum DiagnosticNoFixReasonKind { Behavior Design Ambiguous }

struct DiagnosticNoFixReason {
    kind: DiagnosticNoFixReasonKind
    next: String
}

struct DiagnosticOrigin {
    display: String
    path: String
    source: String
    revision: String
}

struct DiagnosticCause {
    code: String
    span: Span?{None}
    origin: DiagnosticOrigin?{None}
}

// A secondary source location explaining the primary report, such as the
// earlier move a later use reaches. The host renderer draws it as its own
// `file:line:col` snippet with a caret and the message.
struct DiagnosticLabel {
    span: Span
    message: String
}

enum DiagnosticCryptoMisuseReason {
    InvalidLength
    NonceLength
    OutputLength
    SaltLength
    MemoryCost
    IterationCount
    LaneCount
    MemoryTimeCost
    RawNonce
    RawAlgorithm
    DeterministicEntropy
}

struct DiagnosticErrorContextFrame {
    text: String
    file: String
    line: Int
}

struct DiagnosticErrorConversion {
    source: String
    target: String
}

struct DiagnosticErrorField {
    name: String
    value: String
}

struct DiagnosticErrorSpan {
    start: Int
    end: Int
}

struct DiagnosticErrorDetails {
    variant: String
    fields: [DiagnosticErrorField]
    source_span: DiagnosticErrorSpan?{None}
}

struct DiagnosticErrorJourneyFrame {
    fn_name: String
    file: String
    line: Int
    note: String
    hops: Int
}

struct DiagnosticBuildError {
    code: String?{None}
    message: String
    typed_identity: String?{None}
    causes: [DiagnosticBuildError]{[DiagnosticBuildError]{}}
    context_frames: [DiagnosticErrorContextFrame]{[DiagnosticErrorContextFrame]{}}
    source_journey: [DiagnosticErrorJourneyFrame]{[DiagnosticErrorJourneyFrame]{}}
    conversion_history: [DiagnosticErrorConversion]{[DiagnosticErrorConversion]{}}
    details: DiagnosticErrorDetails?{None}
}

enum DiagnosticStructured {
    SuggestedEdits(edits: [TextEdit])
    CryptoMisuse(reason: DiagnosticCryptoMisuseReason, operation: String, expected: String?, actual: Int?)
    BuildError(report: DiagnosticBuildError)
    RuntimeHostFault(stdout: String)
}

struct Diagnostic {
    moment: DiagnosticMoment{DiagnosticMoment.Compile}
    severity: Int
    code: String
    span: Span?{None}
    source_path: String?{None}
    source_offset: Int?{None}
    source_start: Int?{None}
    origin: DiagnosticOrigin?{None}
    cause: [DiagnosticCause]{[DiagnosticCause]{}}
    labels: [DiagnosticLabel]{[DiagnosticLabel]{}}
    what: String
    why: String
    fix: String
    edit: TextEdit?{None}
    applicability: DiagnosticFixApplicability?{None}
    safety: DiagnosticFixSafety?{None}
    no_fix_reason: DiagnosticNoFixReason?{None}
    detail: String?{None}
    structured: DiagnosticStructured?{None}
    decision_row: MIRDecisionRow?{None}
    denial_kind: String?{None}
    call_chain: [String]{[String]{}}
    scope_chain: [String]{[String]{}}
    nearest_granting_scope: String?{None}
}

fn diagnostic_with_source_path(diagnostic: ^Diagnostic, source_path: String, aggregate_source_offset: Int) -> Diagnostic Never! {
    updated := diagnostic
    updated.source_path = Val(source_path)
    updated.source_offset = Val(aggregate_source_offset)
    updated.source_start = Val(0)
    updated
}

fn diagnostic_with_source_mapping(diagnostic: ^Diagnostic, source_path: String, aggregate_source_offset: Int, source_start: Int) -> Diagnostic Never! {
    updated := diagnostic
    updated.source_path = Val(source_path)
    updated.source_offset = Val(aggregate_source_offset)
    updated.source_start = Val(source_start)
    updated
}

fn diagnostic_with_edit(diagnostic: Diagnostic, edit: TextEdit) -> Diagnostic Never! {
    diagnostic_registry_with_edit(diagnostic.copy(), edit)
}

fn diagnostic_with_moment(diagnostic: ^Diagnostic, moment: DiagnosticMoment) -> Diagnostic Never! {
    updated := diagnostic
    updated.moment = moment
    updated
}

fn diagnostic_with_origin(diagnostic: ^Diagnostic, origin: DiagnosticOrigin) -> Diagnostic Never! {
    updated := diagnostic
    updated.origin = Val(origin)
    updated
}

fn diagnostic_with_cause(diagnostic: ^Diagnostic, cause: DiagnosticCause) -> Diagnostic Never! {
    updated := diagnostic
    &updated.cause.push(cause)
    updated
}

fn diagnostic_with_causes(diagnostic: ^Diagnostic, causes: [DiagnosticCause]) -> Diagnostic Never! {
    updated := diagnostic
    updated.cause = causes
    updated
}

fn diagnostic_with_label(diagnostic: ^Diagnostic, span: Span, message: String) -> Diagnostic Never! {
    updated := diagnostic
    &updated.labels.push(DiagnosticLabel{span: span, message: message})
    updated
}

fn diagnostic_with_edit_grade(diagnostic: Diagnostic, edit: TextEdit, applicability: DiagnosticFixApplicability, safety: DiagnosticFixSafety) -> Diagnostic Never! {
    diagnostic_registry_with_edit_grade(diagnostic.copy(), edit, applicability, safety)
}

fn diagnostic_with_fix_grades(diagnostic: Diagnostic, applicability: DiagnosticFixApplicability, safety: DiagnosticFixSafety) -> Diagnostic Never! {
    edit :: diagnostic.edit ?? panic("diagnostic `{diagnostic.code}` needs an edit before applying explicit fix grades")
    diagnostic_registry_with_edit_grade(diagnostic.copy(), edit, applicability, safety)
}

fn diagnostic_with_structured_edit(diagnostic: Diagnostic, edit: TextEdit) -> Diagnostic Never! {
    diagnostic_registry_with_structured_edit(diagnostic.copy(), edit)
}

fn diagnostic_with_source_derived_suggestion(diagnostic: Diagnostic, span: Span, new_text: String) -> Diagnostic Never! {
    diagnostic_registry_with_source_derived_suggestion(diagnostic.copy(), span, new_text)
}

fn diagnostic_with_alternative_edit(diagnostic: Diagnostic, edit: TextEdit) -> Diagnostic Never! {
    diagnostic_registry_with_alternative_edit(diagnostic.copy(), edit)
}

fn diagnostic_with_no_fix_reason(diagnostic: ^Diagnostic, reason: DiagnosticNoFixReason) -> Diagnostic Never! {
    updated := diagnostic
    updated.no_fix_reason = Val(reason)
    updated
}

fn diagnostic_with_detail(diagnostic: ^Diagnostic, detail: String) -> Diagnostic Never! {
    updated := diagnostic
    updated.detail = Val(detail)
    updated
}

fn diagnostic_with_structured(diagnostic: ^Diagnostic, structured: DiagnosticStructured) -> Diagnostic Never! {
    updated := diagnostic
    updated.structured = Val(structured)
    updated
}

fn diagnostic_with_decision_row(diagnostic: ^Diagnostic, decision_row: MIRDecisionRow) -> Diagnostic Never! {
    updated := diagnostic
    updated.decision_row = Val(decision_row)
    updated
}

fn diagnostic_with_rights(diagnostic: ^Diagnostic, denial_kind: String, call_chain: [String], scope_chain: [String], nearest_granting_scope: String?) -> Diagnostic Never! {
    updated := diagnostic
    updated.denial_kind = Val(denial_kind)
    updated.call_chain = call_chain
    updated.scope_chain = scope_chain
    updated.nearest_granting_scope = nearest_granting_scope
    updated
}

DIAGNOSTIC_ERROR :: 1
DIAGNOSTIC_LINT :: 2
