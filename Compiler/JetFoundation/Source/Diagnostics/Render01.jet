// Shared terminal color policy and semantic style roles.
use jet_foundation.Outcome.jet_terminal_auto_color

// Rust: crates/jet-foundation/src/Terminal.rs:5
pub enum ColorChoice { Auto Always Never }
impl ColorChoice {
    // Rust: crates/jet-foundation/src/Terminal.rs:12
    pub fn default() -> ColorChoice Never! { .Auto }
    // Rust: crates/jet-foundation/src/Terminal.rs:18
    pub fn parse(value: String) -> ColorChoice Never! {
        if value == { "always" -> .Always; "never" -> .Never; else -> .Auto }
    }
    // Rust: crates/jet-foundation/src/Terminal.rs:32
    pub fn resolve(self, is_tty: Bool) -> Bool {
        if self == { .Always -> true; .Never -> false; .Auto -> jet_terminal_auto_color(is_tty) }
    }
}
// Rust: crates/jet-foundation/src/Terminal.rs:43
pub struct Theme { color_enabled: Bool }
impl Theme {
    // Rust: crates/jet-foundation/src/Terminal.rs:48
    pub ACCENT_SGR :: "1;96"
    // Rust: crates/jet-foundation/src/Terminal.rs:49
    pub DIM_SGR :: "2;37"
    // Rust: crates/jet-foundation/src/Terminal.rs:50
    pub SUCCESS_SGR :: "32"
    // Rust: crates/jet-foundation/src/Terminal.rs:51
    pub WARN_SGR :: "33"
    // Rust: crates/jet-foundation/src/Terminal.rs:52
    pub ERROR_SGR :: "31"
    // Rust: crates/jet-foundation/src/Terminal.rs:53
    pub INVERT_SGR :: "48;5;24;97;1"
    // Rust: crates/jet-foundation/src/Terminal.rs:54
    pub BORDER_SGR :: "90"
    // Rust: crates/jet-foundation/src/Terminal.rs:56
    pub fn new(color: Bool) -> Theme Never! { Theme{color_enabled: color} }
    // Rust: crates/jet-foundation/src/Terminal.rs:60
    pub fn resolve(choice: ColorChoice, is_tty: Bool) -> Theme { Theme.new(choice.resolve(is_tty)) }
    // Rust: crates/jet-foundation/src/Terminal.rs:64
    pub fn color(self) -> Bool Never! { self.color_enabled }
    // Rust: crates/jet-foundation/src/Terminal.rs:68
    pub fn paint(self, sgr: String, text: String) -> String Never! {
        if self.color_enabled {
            escape :: String.from_bytes([U8]{27}) ?? panic("invalid ASCII escape byte")
            escape + "[" + sgr + "m" + text + escape + "[0m"
        } else { text }
    }
    // Rust: crates/jet-foundation/src/Terminal.rs:76
    pub fn accent(self, text: String) -> String Never! { self.paint(Theme.ACCENT_SGR, text) }
    // Rust: crates/jet-foundation/src/Terminal.rs:79
    pub fn dim(self, text: String) -> String Never! { self.paint(Theme.DIM_SGR, text) }
    // Rust: crates/jet-foundation/src/Terminal.rs:82
    pub fn success(self, text: String) -> String Never! { self.paint(Theme.SUCCESS_SGR, text) }
    // Rust: crates/jet-foundation/src/Terminal.rs:85
    pub fn warn(self, text: String) -> String Never! { self.paint(Theme.WARN_SGR, text) }
    // Rust: crates/jet-foundation/src/Terminal.rs:88
    pub fn error(self, text: String) -> String Never! { self.paint(Theme.ERROR_SGR, text) }
    // Rust: crates/jet-foundation/src/Terminal.rs:91
    pub fn invert(self, text: String) -> String Never! { self.paint(Theme.INVERT_SGR, text) }
    // Rust: crates/jet-foundation/src/Terminal.rs:94
    pub fn border(self, text: String) -> String Never! { self.paint(Theme.BORDER_SGR, text) }
    // Rust: crates/jet-foundation/src/Terminal.rs:97
    pub fn bold(self, text: String) -> String Never! { self.paint("1", text) }
}
