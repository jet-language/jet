// Human terminal rendering of diagnostics: the byte-stable form the tests/ui
// snapshots pin (Docs/spec/diagnostics.md). `render_inner`/`push_snippet` and
// `Theme`. With `color` false the text is plain; color only wraps the same text
// in ANSI styling, so scripts read identical bytes.
use diagnostic_unicode: core.text

DIAGNOSTIC_THEME_ACCENT: "1;96"
DIAGNOSTIC_THEME_DIM: "2;37"
DIAGNOSTIC_THEME_WARN: "33"
DIAGNOSTIC_THEME_ERROR: "31"
DIAGNOSTIC_THEME_BOLD: "1"

// One `Theme` role: `ESC [ sgr m text ESC [ 0 m` when color is on.
diagnostic_theme_paint: fn(color: Bool, sgr: String, text: String) -> String Never! {
    if !color -> return text.copy()
    escape: String.from_bytes([U8]{"\x1b"}) ?? ""
    "{escape}[{sgr}m{text}{escape}[0m"
}

diagnostic_theme_accent: fn(color: Bool, text: String) -> String Never! { diagnostic_theme_paint(color, DIAGNOSTIC_THEME_ACCENT, text) }
diagnostic_theme_dim: fn(color: Bool, text: String) -> String Never! { diagnostic_theme_paint(color, DIAGNOSTIC_THEME_DIM, text) }
diagnostic_theme_bold: fn(color: Bool, text: String) -> String Never! { diagnostic_theme_paint(color, DIAGNOSTIC_THEME_BOLD, text) }

diagnostic_theme_severity: fn(color: Bool, severity: Int, text: String) -> String Never! {
    if severity == DIAGNOSTIC_LINT -> return diagnostic_theme_paint(color, DIAGNOSTIC_THEME_WARN, text)
    diagnostic_theme_paint(color, DIAGNOSTIC_THEME_ERROR, text)
}

diagnostic_push_text: fn(out: &[U8], text: String) Never! {
    loop byte in text.bytes() -> out.push(byte)
}

diagnostic_bytes_text: fn(bytes: [U8], start: Int, end: Int) -> String Never! {
    out := [U8]{}
    index := if start < 0 -> 0 else -> start
    limit: if end > bytes.len() -> bytes.len() else -> end
    loop index < limit {
        out.push(bytes[index])
        index += 1
    }
    String.from_bytes(out) ?? ""
}

diagnostic_codepoint_at: fn(bytes: [U8], index: Int, width: Int) -> Int Never! {
    first: diagnostic_byte_at(bytes, index)
    second: if width == 2 || width == 3 || width == 4 -> diagnostic_byte_at(bytes, index + 1) else -> 0
    third: if width == 3 || width == 4 -> diagnostic_byte_at(bytes, index + 2) else -> 0
    fourth: if width == 4 -> diagnostic_byte_at(bytes, index + 3) else -> 0
    foundation_utf8_codepoint(first, second, third, fourth, width)
}

// Rust `char::is_control` (general category Cc) plus the Unicode line and
// paragraph separators.
diagnostic_is_terminal_control: fn(codepoint: Int) -> Bool Never! {
    codepoint < 32 || (codepoint >= 127 && codepoint <= 159) || codepoint == 8232 || codepoint == 8233
}

diagnostic_lower_hex: fn(value: Int, min_digits: Int) -> String Never! {
    digits: "0123456789abcdef".bytes()
    reversed := [U8]{}
    rest := value
    loop rest > 0 || reversed.len() < min_digits {
        reversed.push(digits[rest % 16])
        rest /%= 16
    }
    out := [U8]{}
    index := reversed.len() - 1
    loop index >= 0 {
        out.push(reversed[index])
        index -= 1
    }
    String.from_bytes(out) ?? ""
}

// Escape untrusted text before it is projected to a terminal. Display-only:
// C0/C1 controls, line separators, and line breaks become visible escapes.
diagnostic_escape_terminal_text: fn(value: String) -> String Never! {
    bytes: value.bytes()
    out := [U8]{}
    index := 0
    loop index < bytes.len() {
        width: diagnostic_utf8_width(bytes, index)
        codepoint: diagnostic_codepoint_at(bytes, index, width)
        if {
            codepoint == 10 -> diagnostic_push_text(out, "\\n")
            codepoint == 13 -> diagnostic_push_text(out, "\\r")
            codepoint == 9 -> diagnostic_push_text(out, "\\t")
            diagnostic_is_terminal_control(codepoint) -> diagnostic_push_text(out, "\\u{{{diagnostic_lower_hex(codepoint, 4)}}}")
            else -> {
                loop offset in 0..<width -> out.push(bytes[index + offset])
            }
        }
        index += width
    }
    String.from_bytes(out) ?? value
}

// Byte offset just past the last newline before `offset` (0 on line one).
diagnostic_line_start: fn(bytes: [U8], offset: Int) -> Int Never! {
    index := offset - 1
    loop index >= 0 {
        if bytes[index] == (U8{10}) -> return index + 1
        index -= 1
    }
    0
}

diagnostic_clamp_offset: fn(bytes: [U8], offset: Int) -> Int Never! {
    if offset < 0 -> return 0
    if offset > bytes.len() -> return bytes.len()
    offset
}

// 1-based line of `offset`; offsets past the end read as the end.
diagnostic_line_at: fn(source: String, offset: Int) -> Int Never! {
    bytes: source.bytes()
    limit: diagnostic_clamp_offset(bytes, offset)
    line := 1
    loop index in 0..<limit {
        if bytes[index] == (U8{10}) -> line += 1
    }
    line
}

// 1-based column of `offset`: every character that starts before it counts.
diagnostic_column_at: fn(source: String, offset: Int) -> Int Never! {
    bytes: source.bytes()
    limit: diagnostic_clamp_offset(bytes, offset)
    column := 1
    loop index in diagnostic_line_start(bytes, limit)..<limit {
        if !diagnostic_is_continuation(Int.from_u8(bytes[index])) -> column += 1
    }
    column
}

// One source's bytes and line starts, built once per file of a rendered
// batch: every diagnostic of the file reads these bytes in place, and a line
// or column is a binary search plus a scan of one line, never a copy and a
// scan of the whole file (the self-hosted compiler unit is one 25 MB file
// with thousands of lints).
DiagnosticSourceText: struct {
    bytes: [U8]
    // The byte offset of each line's first byte, ascending; line one is 0.
    line_starts: [Int]
}

diagnostic_source_text: fn(source: String) -> DiagnosticSourceText Never! {
    bytes: source.bytes()
    starts := [Int]{0}
    loop index in 0..<bytes.len() {
        if bytes[index] == (U8{10}) -> starts.push(index + 1)
    }
    DiagnosticSourceText{bytes: bytes, line_starts: starts}
}

// The 0-based line holding the clamped offset `limit`: the last line start
// at or before it.
diagnostic_source_line_index: fn(text: DiagnosticSourceText, limit: Int) -> Int Never! {
    low := 0
    high := text.line_starts.len() - 1
    loop low < high {
        middle: (low + high + 1) /% 2
        if text.line_starts[middle] <= limit -> low = middle else -> high = middle - 1
    }
    low
}

// diagnostic_line_at over an indexed source.
diagnostic_source_line: fn(text: DiagnosticSourceText, offset: Int) -> Int Never! {
    diagnostic_source_line_index(text, diagnostic_clamp_offset(text.bytes, offset)) + 1
}

// diagnostic_column_at over an indexed source.
diagnostic_source_column: fn(text: DiagnosticSourceText, offset: Int) -> Int Never! {
    limit: diagnostic_clamp_offset(text.bytes, offset)
    column := 1
    loop index in text.line_starts[diagnostic_source_line_index(text, limit)]..<limit {
        if !diagnostic_is_continuation(Int.from_u8(text.bytes[index])) -> column += 1
    }
    column
}

// The sources one batch renders, each indexed once (DiagnosticSourceText).
// A batch spans few files, so lookup is a scan of `keys`.
DiagnosticSourceTexts: struct {
    keys: [String]
    texts: [DiagnosticSourceText]
}

diagnostic_source_texts: fn() -> DiagnosticSourceTexts Never! {
    DiagnosticSourceTexts{keys: [String]{}, texts: [DiagnosticSourceText]{}}
}

// The position in `sources.texts` of the source a diagnostic reads: its
// origin's bytes (keyed by path and revision), else the batch's `source`.
// The source is indexed on first use.
diagnostic_source_position: fn(sources: &DiagnosticSourceTexts, origin: DiagnosticOrigin?, source: String) -> Int Never! {
    key: if origin == .Val(found) -> "origin:{found.path}\n{found.revision}" else -> "batch"
    loop (position, known) in sources.keys {
        if known == key -> return position
    }
    sources.keys.push(key)
    if origin == .Val(found) -> sources.texts.push(diagnostic_source_text(found.source)) else -> sources.texts.push(diagnostic_source_text(source))
    sources.keys.len() - 1
}

// The text of the line holding `offset`, as Rust `str::lines` yields it.
diagnostic_line_text_at: fn(bytes: [U8], offset: Int) -> String Never! {
    start: diagnostic_line_start(bytes, diagnostic_clamp_offset(bytes, offset))
    end := start
    loop end < bytes.len() && bytes[end] != (U8{10}) -> end += 1
    if end > start && bytes[end - 1] == (U8{13}) -> end -= 1
    diagnostic_bytes_text(bytes, start, end)
}

// The first `count` characters of `text`.
diagnostic_prefix_chars: fn(text: String, count: Int) -> String Never! {
    bytes: text.bytes()
    index := 0
    taken := 0
    loop taken < count && index < bytes.len() {
        index += diagnostic_utf8_width(bytes, index)
        taken += 1
    }
    diagnostic_bytes_text(bytes, 0, index)
}

diagnostic_is_char_boundary: fn(bytes: [U8], index: Int) -> Bool Never! {
    if index == bytes.len() -> return true
    if index < 0 || index > bytes.len() -> return false
    !diagnostic_is_continuation(Int.from_u8(bytes[index]))
}

// Rust `src.get(start..end)` up to its first newline; an invalid range is "".
diagnostic_snippet_first_line: fn(bytes: [U8], span: Span) -> String Never! {
    end: if span.end > bytes.len() -> bytes.len() else -> span.end
    if span.start > end || !diagnostic_is_char_boundary(bytes, span.start) || !diagnostic_is_char_boundary(bytes, end) -> return ""
    stop := span.start
    loop stop < end && bytes[stop] != (U8{10}) -> stop += 1
    diagnostic_bytes_text(bytes, span.start, stop)
}

diagnostic_right_align: fn(text: String, width: Int) -> String Never! {
    padding: width - text.bytes().len()
    if padding <= 0 -> return text.copy()
    "{" ".repeat(padding)}{text}"
}

// Draw one `--> file:line:col` snippet with a caret under `span`; a secondary
// label prints its message after the carets. `text` is the indexed source,
// read in place.
diagnostic_push_snippet: fn(out: &[U8], diagnostic: Diagnostic, color: Bool, file: String, text: DiagnosticSourceText, span: Span, message: String?) Never! {
    line: diagnostic_source_line(text, span.start)
    column: diagnostic_source_column(text, span.start)
    location: diagnostic_theme_dim(color, "--> {file}:{line}:{column}")
    diagnostic_push_text(out, "  {location}\n")
    raw_line_text: diagnostic_line_text_at(text.bytes, span.start)
    line_text: diagnostic_escape_terminal_text(raw_line_text)
    diagnostic_push_text(out, "    |\n")
    diagnostic_push_text(out, "{diagnostic_right_align("{line}", 3)} | {line_text}\n")
    // Width-aware underline: pad by the display width of everything before
    // the span, then draw carets as wide as the spanned text.
    prefix: diagnostic_escape_terminal_text(diagnostic_prefix_chars(raw_line_text, column - 1))
    pad_width: diagnostic_unicode.display_width(prefix)
    snippet_first_line: diagnostic_escape_terminal_text(diagnostic_snippet_first_line(text.bytes, span))
    line_width: diagnostic_unicode.display_width(line_text)
    avail: if line_width > pad_width -> line_width - pad_width else -> 0
    caret_len := diagnostic_unicode.display_width(snippet_first_line)
    if caret_len < 1 -> caret_len = 1
    if avail > 0 && caret_len > avail -> caret_len = avail
    pad: " ".repeat(pad_width)
    // Color only the caret glyphs, not the leading pad (keeps columns).
    marks: diagnostic_theme_severity(color, diagnostic.severity, "^".repeat(caret_len))
    if {
        message == .Val(label_text) -> diagnostic_push_text(out, "    | {pad}{marks} {diagnostic_escape_terminal_text(label_text)}\n")
        else -> diagnostic_push_text(out, "    | {pad}{marks}\n")
    }
}

// A detail whose first line is `kind:value` is structured data for machine
// consumers; the terminal projection leaves it out.
diagnostic_has_structured_detail_key: fn(detail: String) -> Bool Never! {
    bytes: detail.bytes()
    if bytes.len() == 0 -> return false
    end := 0
    loop end < bytes.len() && bytes[end] != (U8{10}) -> end += 1
    if end > 0 && bytes[end - 1] == (U8{13}) -> end -= 1
    colon := -1
    loop index in 0..<end {
        if bytes[index] == (U8{58}) {
            colon = index
            break
        }
    }
    if colon <= 0 || colon + 1 >= end -> return false
    loop index in 0..<colon {
        value: Int.from_u8(bytes[index])
        is_key_byte: (value >= 48 && value <= 57) || (value >= 65 && value <= 90) || (value >= 97 && value <= 122) || value == 95 || value == 45
        if !is_key_byte -> return false
    }
    !diagnostic_is_whitespace_at(bytes, colon + 1)
}

diagnostic_join_escaped: fn(parts: [String], separator: String) -> String Never! {
    joined := ""
    loop (index, part) in parts {
        escaped: diagnostic_escape_terminal_text(part)
        joined = if index == 0 -> escaped else -> "{joined}{separator}{escaped}"
    }
    joined
}

// One diagnostic as terminal text. `file` and `source` name the checked
// source; a diagnostic's own origin replaces both.
diagnostic_render: fn(diagnostic: Diagnostic, file: String, source: String, color: Bool) -> String Never! {
    sources := diagnostic_source_texts()
    diagnostic_render_with(diagnostic, file, source, color, sources)
}

// diagnostic_render over the batch's indexed sources: a source is indexed the
// first time a snippet reads it, and only then.
diagnostic_render_with: fn(diagnostic: Diagnostic, file: String, source: String, color: Bool, sources: &DiagnosticSourceTexts) -> String Never! {
    display: diagnostic_escape_terminal_text(if diagnostic.origin == .Val(origin) -> origin.display else -> file)
    what: diagnostic_escape_terminal_text(diagnostic.what)
    why: diagnostic_escape_terminal_text(diagnostic.why)
    fix: diagnostic_escape_terminal_text(diagnostic.fix)
    label: if diagnostic.severity == DIAGNOSTIC_LINT -> diagnostic_theme_severity(color, diagnostic.severity, "Warning") else -> diagnostic_theme_severity(color, diagnostic.severity, "Error")
    out := [U8]{}
    diagnostic_push_text(out, "{label} [{diagnostic_display_name(diagnostic.code)}]: {what}\n")
    if diagnostic.span != None || diagnostic.labels.len() > 0 {
        position: diagnostic_source_position(sources, diagnostic.origin, source)
        if diagnostic.span == .Val(span) -> diagnostic_push_snippet(out, diagnostic, color, display, sources.texts[position], span, None)
        loop secondary in diagnostic.labels -> diagnostic_push_snippet(out, diagnostic, color, display, sources.texts[position], secondary.span, Val(secondary.message))
    }
    diagnostic_push_text(out, " {diagnostic_theme_bold(color, "Why:")} {why}\n")
    diagnostic_push_text(out, " {diagnostic_theme_bold(color, "Fix:")} {fix}\n")
    if diagnostic.detail == .Val(detail) {
        if !diagnostic_has_structured_detail_key(detail) {
            first := true
            loop line in detail.split("\n") {
                if !first -> diagnostic_push_text(out, "\n")
                first = false
                diagnostic_push_text(out, diagnostic_escape_terminal_text(line))
            }
            if !detail.ends_with("\n") -> diagnostic_push_text(out, "\n")
        }
    }
    if diagnostic.denial_kind == .Val(kind) {
        diagnostic_push_text(out, " {diagnostic_theme_bold(color, "Denial:")} {diagnostic_escape_terminal_text(kind)}\n")
        if diagnostic.call_chain.len() > 0 -> diagnostic_push_text(out, " {diagnostic_theme_bold(color, "Call chain:")} {diagnostic_join_escaped(diagnostic.call_chain, " → ")}\n")
        if diagnostic.scope_chain.len() > 0 -> diagnostic_push_text(out, " {diagnostic_theme_bold(color, "Scope chain:")} {diagnostic_join_escaped(diagnostic.scope_chain, " → ")}\n")
        if diagnostic.nearest_granting_scope == .Val(scope) -> diagnostic_push_text(out, " {diagnostic_theme_bold(color, "Nearest granting scope:")} {diagnostic_escape_terminal_text(scope)}\n")
    }
    // Jet's own codes have a reference page; a library diagnostic's code is its type path.
    if !diagnostic.code.contains(".") -> diagnostic_push_text(out, diagnostic_more_line(diagnostic.code))
    String.from_bytes(out) ?? ""
}

// The reference line that closes every report of a Jet code.
diagnostic_more_line: fn(code: String) -> String Never! {
    "More: jet-lang.dev/e/{code}\n"
}

DIAGNOSTIC_STOP_OPEN: "Stop ["
DIAGNOSTIC_STOP_CLOSE: "]: "

// A runtime stop's first line, `Stop [CODE]: what`, as the runtime prints a
// stop row (its code, not its name).
diagnostic_stop_line: fn(code: String, what: String) -> String Never! {
    "{DIAGNOSTIC_STOP_OPEN}{code}{DIAGNOSTIC_STOP_CLOSE}{what}"
}

// The code and What of one line `diagnostic_stop_line` wrote, as a tool reads
// back the stop another Jet program printed; None for any other line.
DiagnosticStopHead: struct {
    code: String
    what: String
}

diagnostic_stop_parse: fn(line: String) -> DiagnosticStopHead? Never! {
    if !line.starts_with(DIAGNOSTIC_STOP_OPEN) -> return None
    open: DIAGNOSTIC_STOP_OPEN.bytes().len()
    close: line.find(DIAGNOSTIC_STOP_CLOSE)
    if close <= open -> return None
    bytes: line.bytes()
    code: String.from_bytes(bytes.slice(open, close)) ?? ""
    what: String.from_bytes(bytes.slice(close + DIAGNOSTIC_STOP_CLOSE.bytes().len(), bytes.len())) ?? ""
    Val(DiagnosticStopHead{code: code, what: what})
}

// The lines that close a runtime stop: its row's Why and Fix, then More.
diagnostic_stop_footer: fn(code: String) -> String Never! {
    row: diagnostic_registry_row(code) ?? panic("runtime stop `{code}` has no registry row")
    " Why: {row.why}\n Fix: {row.fix}\n{diagnostic_more_line(code)}"
}

// A batch of diagnostics, one blank line between each. Each source the batch
// reads is indexed once (DiagnosticSourceTexts), and the reports are joined
// once at the end.
diagnostic_render_all: fn(file: String, source: String, diagnostics: [Diagnostic], color: Bool) -> String Never! {
    sources := diagnostic_source_texts()
    rendered: loop diagnostic in diagnostics -> diagnostic_render_with(diagnostic, file, source, color, sources)
    rendered.join("\n")
}
