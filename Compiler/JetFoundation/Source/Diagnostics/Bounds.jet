// Rust crates/jet-foundation/src/Outcome.rs:2445-2452, jet_list_bounds_message.
// Collection adapters supply the shared Show-rendered length without narrowing
// it; Foundation alone owns the wording, including for an empty list.
pub fn jet_list_bounds_message(len_display: String, index: I64) -> String Never! {
    "the list has {len_display} items, so position {index} doesn't exist"
}
