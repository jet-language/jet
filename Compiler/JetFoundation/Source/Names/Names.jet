// Checked-name presentation, ported and origin/port/compiler. The indexed ledger
// owns the existing checked name rows, not a second resolver.

NameLedger: struct {
    facts: NameFacts,
    declarations: [{module_index: Int, name: String}:Int],
    aliases: [{module_index: Int, name: String}:Int],
    declaration_names: [String:[Int]],
    alias_names: [String:[Int]],
    display_paths: [{module_index: Int, path: String}:String],
    // The run's symbol table: it names the SymbolIDs the facts the ledger
    // presents carry (a call fact's callee, a body's constant).
    symbols: SymbolTable{symbol_table()},
}

name_facts_leaf: fn(name: String) -> String Never! {
    bytes: name.bytes()
    ^start: bytes.len()
    loop start > 0 && bytes[start - 1] != 46 -> start -= 1
    foundation_byte_text(bytes, start, bytes.len())
}

// Where a dotted path splits over a program's module graph: at its longest
// prefix that names a module, `cut` bytes long, so the rest after the `.`
// (empty when the whole path is the module) names a declaration in it.
// `named` counts the modules that prefix names: 1 is the split, more is
// ambiguous, and 0 (with `cut` 0) means no prefix names a module.
DottedPathSplit: struct {
    cut: Int,
    named: Int,
}

// The split of `path` over the program's modules, each named by its dotted
// `alias`; a name two modules share is ambiguous.
dotted_path_split: fn(path: String, modules: [NameModule]) -> DottedPathSplit Never! {
    bytes: path.bytes()
    ^cut: bytes.len()
    loop cut > 0 {
        named: dotted_path_named(path.slice(0..<cut), modules)
        if named > 0 -> return DottedPathSplit{cut: cut, named: named}
        cut -= 1
        loop cut > 0 && bytes[cut] != 46 -> cut -= 1
    }
    DottedPathSplit{cut: 0, named: 0}
}

// How many of `modules` are named `name`.
dotted_path_named: fn(name: String, modules: [NameModule]) -> Int Never! {
    ^named: 0
    loop row in modules {
        if row.alias == name -> named += 1
    }
    named
}

// How many module names an E2122 fix offers before `and N more`.
DOTTED_PATH_SHOWN: 3

// The E2122 report of a path whose split names no one module: its fix offers
// the names only one module has among those of `package`, the program's own,
// in graph order.
dotted_path_unresolved: fn(path: String, modules: [NameModule], package: String, split: DottedPathSplit) -> Diagnostic Never! {
    start: if split.named > 1 -> "`{path.slice(0..<split.cut)}`, the name of more than one module of this program" else -> "no module of this program"
    ^shown: [String]{}
    ^more: 0
    loop row in modules {
        if row.package != package || dotted_path_named(row.alias, modules) != 1 -> next
        if shown.len() == DOTTED_PATH_SHOWN -> more += 1 else -> shown.push("`{row.alias}`")
    }
    offered: if {
        shown.len() == 0 -> "this program has none"
        more > 0 -> "{shown.join(", ")} and {more} more"
        else -> shown.join(", ")
    }
    row: diagnostic_registry_row_of("E2122")
    what: row.what.replace("{{path}}", path).replace("{{start}}", start).replace("{{modules}}", offered)
    why: row.why.replace("{{path}}", path).replace("{{start}}", start).replace("{{modules}}", offered)
    fix: row.fix.replace("{{path}}", path).replace("{{start}}", start).replace("{{modules}}", offered)
    diagnostic_from_registry("E2122", None, what, why, fix)
}

// A map keeps its keys sorted and an insert moves every later key, so each
// map is filled in key order, where it grows at its end; filling it in row
// order would cost time quadratic in the rows. A repeated key keeps its last
// row, as a fill in row order does.
name_ledger_from_facts: fn(facts: ^^NameFacts) -> NameLedger Never! {
    ^ledger: NameLedger{facts: facts.move(), declarations: [{module_index: Int, name: String}:Int]{}, aliases: [{module_index: Int, name: String}:Int]{}, declaration_names: [String:[Int]]{}, alias_names: [String:[Int]]{}, display_paths: [{module_index: Int, path: String}:String]{}}
    ^modules: [Int]{}
    ^names: [String]{}
    ^leaves: [String]{}
    loop row in ledger.facts.declarations {
        modules.push(row.module_index)
        names.push(row.name)
        leaves.push(name_facts_leaf(row.name))
    }
    loop index in name_rows_by_key(modules, names) {
        ledger.declarations[{module_index: modules[index], name: names[index]}] = index
    }
    ledger.declaration_names = name_leaf_positions(leaves)
    modules = [Int]{}
    names = [String]{}
    leaves = [String]{}
    loop row in ledger.facts.aliases {
        modules.push(row.module_index)
        names.push(row.name)
        leaves.push(name_facts_leaf(row.name))
    }
    loop index in name_rows_by_key(modules, names) {
        ledger.aliases[{module_index: modules[index], name: names[index]}] = index
    }
    ledger.alias_names = name_leaf_positions(leaves)
    modules = [Int]{}
    names = [String]{}
    loop row in ledger.facts.display_paths {
        modules.push(row.module_index)
        names.push(row.internal_path)
    }
    loop index in name_rows_by_key(modules, names) {
        ledger.display_paths[{module_index: modules[index], path: names[index]}] = ledger.facts.display_paths[index].display_path
    }
    ledger
}

// The rows ordered by (module, name), equal keys in row order.
name_rows_by_key: fn(modules: [Int], names: [String]) -> [Int] Never! {
    ^order: [Int]{}
    loop index in 0..<names.len() -> order.push(index)
    order.sort_by(fn(a: Int, b: Int) { (modules[a] <=> modules[b]).then(names[a] <=> names[b]).then(a <=> b) })
    order
}

// Each leaf's row positions, ascending, filled in leaf order.
name_leaf_positions: fn(leaves: [String]) -> [String:[Int]] Never! {
    ^order: [Int]{}
    loop index in 0..<leaves.len() -> order.push(index)
    order.sort_by(fn(a: Int, b: Int) { (leaves[a] <=> leaves[b]).then(a <=> b) })
    ^positions: [String:[Int]]{}
    ^start: 0
    loop start < order.len() {
        leaf: leaves[order[start]]
        ^rows: [Int]{}
        ^end: start
        loop end < order.len() && leaves[order[end]] == leaf {
            rows.push(order[end])
            end += 1
        }
        positions[leaf] = rows.move()
        start = end
    }
    positions
}

name_ledger_declaration: fn(ledger: NameLedger, module_index: Int, name: String) -> NameDeclaration? Never! {
    index: ledger.declarations.get({module_index: module_index, name: name}) ?? return None
    Val(ledger.facts.declarations[index])
}

name_ledger_alias: fn(ledger: NameLedger, module_index: Int, name: String) -> NameAlias? Never! {
    index: ledger.aliases.get({module_index: module_index, name: name}) ?? return None
    Val(ledger.facts.aliases[index])
}

name_ledger_canonical_path: fn(ledger: NameLedger, module_index: Int, name: String) -> String? Never! {
    if name_ledger_declaration(ledger, module_index, name) == .Val(row) -> return Val(row.path)
    alias: name_ledger_alias(ledger, module_index, name) ?? return None
    if alias.target_module == .Val(target) {
        if name_ledger_declaration(ledger, target, name_facts_leaf(alias.target)) == .Val(row) {
            return Val(row.path)
        }
    }
    if alias.target.contains(".") -> Val(alias.target) else -> None
}

name_ledger_visible: fn(ledger: NameLedger, from: Int, module_index: Int, name: String) -> Bool Never! {
    if from == module_index -> return true
    if from < 0 || module_index < 0 || from >= ledger.facts.modules.len() || module_index >= ledger.facts.modules.len() {
        return false
    }
    source: ledger.facts.modules[from]
    target: ledger.facts.modules[module_index]
    if source.namespace != None && source.namespace == target.namespace -> return true
    ^visibility: NameVisibility?{None}
    if name_ledger_declaration(ledger, module_index, name) == .Val(row) {
        visibility = Val(row.visibility)
    }
    if visibility == None && name_ledger_alias(ledger, module_index, name) == .Val(row) {
        visibility = Val(row.visibility)
    }
    if visibility == (Val(NameVisibility.Public)) -> return true
    visibility == (Val(NameVisibility.Package)) && source.package == target.package
}

name_ledger_display_declaration_path: fn(ledger: NameLedger, module_index: Int, name: String) -> String? Never! {
    row: name_ledger_declaration(ledger, module_index, name) ?? return None
    Val(ledger.display_paths.get({module_index: module_index, path: row.path}) ?? row.path)
}

name_ledger_display_path: fn(ledger: NameLedger, from: Int, name: String, resolved_module: Int?) -> String? Never! {
    leaf: name_facts_leaf(name)
    ^least: String?{None}
    ^ambiguous: false
    ^projected: false
    loop index in (ledger.declaration_names.get(leaf) ?? [Int]{}) {
        row: ledger.facts.declarations[index]
        if !name_ledger_visible(ledger, from, row.module_index, leaf) -> next
        path: name_ledger_display_declaration_path(ledger, row.module_index, row.name) ?? next
        if {
            least == .Val(previous) -> {
                if path != previous -> ambiguous = true
                if path < previous -> least = Val(path)
            }
            else -> { least = Val(path) }
        }
        if ledger.display_paths.get({module_index: row.module_index, path: row.path}) != None {
            projected = true
        }
    }
    loop index in (ledger.alias_names.get(leaf) ?? [Int]{}) {
        alias: ledger.facts.aliases[index]
        if !name_ledger_visible(ledger, from, alias.module_index, leaf) -> next
        ^path: String?{None}
        if alias.target_module == .Val(target) {
            path = name_ledger_display_declaration_path(ledger, target, name_facts_leaf(alias.target))
        }
        if path == None && alias.target.contains(".") -> path = Val(alias.target)
        candidate: path ?? next
        if {
            least == .Val(previous) -> {
                if previous != candidate -> ambiguous = true
                if candidate < previous -> least = Val(candidate)
            }
            else -> { least = Val(candidate) }
        }
    }
    ^resolved: String?{None}
    if resolved_module == .Val(target) {
        resolved = name_ledger_display_declaration_path(ledger, target, leaf)
    }
    if resolved == None -> resolved = name_ledger_display_declaration_path(ledger, from, leaf)
    if resolved == None -> resolved = name_ledger_canonical_path(ledger, from, name)
    path: resolved ?? (least ?? return None)
    if !ambiguous && !name.contains(".") && !name.starts_with("__jet_") && !projected {
        return Val(leaf)
    }
    Val(path)
}

name_ledger_display_path_at: fn(ledger: NameLedger, module_index: Int, span: Span, name: String, owner: String?, resolved_module: Int?) -> String? Never! {
    key: if owner == .Val(value) -> "{value}.{name}" else -> name
    ^declaration: name_ledger_declaration(ledger, module_index, key)
    if declaration == .Val(row) && row.span != span -> declaration = None
    if declaration == None {
        loop row in ledger.facts.declarations {
            if row.module_index == module_index && row.span == span {
                if declaration != None -> return None
                declaration = Val(row)
            }
        }
    }
    ^canonical: String?{None}
    if declaration == .Val(row) {
        canonical = name_ledger_display_declaration_path(ledger, module_index, row.name)
    }
    if owner == .Val(value) {
        if name_ledger_display_path(ledger, module_index, value, resolved_module) == .Val(path) {
            return Val("{path}.{name}")
        }
        return canonical
    }
    if declaration == .Val(row) && row.name.starts_with("__jet_") -> return canonical
    if name_ledger_display_path(ledger, module_index, name, resolved_module) == .Val(path) {
        return Val(path)
    }
    canonical
}
