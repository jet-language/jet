// Shared identifier spelling. Moved intact from
// JetSema so parser recovery and semantic fixes use one canonical algorithm.
// Existing compiler spellings are retained; there is no compatibility copy.
use unicode: core.text
SemaNameCase: enum {
    Pascal
    Snake
    Screaming
}

sema_casing_ascii_code: fn(scalar: String) -> Int Never! {
    bytes: scalar.bytes()
    if bytes.len() != 1 -> return -1
    Int{bytes[0]}
}

sema_casing_is_upper: fn(scalar: String) -> Bool {
    code: sema_casing_ascii_code(scalar)
    if code >= 0 -> return code >= 65 && code <= 90
    unicode.upper(scalar) == scalar && unicode.lower(scalar) != scalar
}

sema_casing_is_lower: fn(scalar: String) -> Bool {
    code: sema_casing_ascii_code(scalar)
    if code >= 0 -> return code >= 97 && code <= 122
    unicode.lower(scalar) == scalar && unicode.upper(scalar) != scalar
}

sema_casing_is_alphabetic: fn(scalar: String) -> Bool {
    code: sema_casing_ascii_code(scalar)
    if code >= 0 -> return (code >= 65 && code <= 90) || (code >= 97 && code <= 122)
    unicode.is_alphabetic(scalar)
}

sema_casing_is_alphanumeric: fn(scalar: String) -> Bool {
    code: sema_casing_ascii_code(scalar)
    if code >= 0 -> return (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122)
    unicode.is_alphabetic(scalar) || unicode.is_numeric(scalar)
}

sema_casing_drop_first_byte: fn(text: String) -> String Never! {
    bytes: text.bytes()
    String.from_bytes(bytes.slice(1, bytes.len())) ?? ""
}

sema_casing_trim_leading_underscores: fn(text: String) -> String Never! {
    body := text
    loop body.starts_with("_") -> body = sema_casing_drop_first_byte(body)
    body
}

sema_casing_join: fn(scalars: [String], start: Int, end: Int) -> String Never! {
    out := ""
    loop index in start..<end -> out = "{out}{scalars[index]}"
    out
}

// The ASCII reading of sema_casing_has_case, straight from the name's bytes
// (no per-scalar strings); None when the name is not all ASCII.
sema_casing_ascii_has_case: fn(name: String, case: SemaNameCase) -> Bool? Never! {
    bytes: name.bytes()
    count: bytes.len()
    loop index in 0..<count {
        if (Int{bytes[index]}) >= 128 -> return None
    }
    if name == "_" -> return Val(true)
    start := 0
    if count > 0 && (Int{bytes[0]}) == 95 -> start = 1
    if start >= count || (Int{bytes[start]}) == 95 || (Int{bytes[count - 1]}) == 95 -> return Val(false)
    rest: start + 1
    loop index in rest..<count {
        if (Int{bytes[index]}) == 95 && (Int{bytes[index - 1]}) == 95 -> return Val(false)
    }
    first: Int{bytes[start]}
    upper: first >= 65 && first <= 90
    lower: first >= 97 && first <= 122
    if case == {
        .Pascal -> {
            if !upper -> return Val(false)
            loop index in rest..<count {
                code: Int{bytes[index]}
                if !((code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122)) -> return Val(false)
            }
        }
        .Snake -> {
            if !lower -> return Val(false)
            loop index in rest..<count {
                code: Int{bytes[index]}
                if !(code == 95 || (code >= 48 && code <= 57) || (code >= 97 && code <= 122)) -> return Val(false)
            }
        }
        .Screaming -> {
            if !upper -> return Val(false)
            loop index in rest..<count {
                code: Int{bytes[index]}
                if !(code == 95 || (code >= 48 && code <= 57) || (code >= 65 && code <= 90)) -> return Val(false)
            }
        }
    }
    Val(true)
}

// A template paste `#{method}` names a declaration from a binding; the case
// policy reads the binding's name inside it.
sema_casing_has_case: fn(name: String, case: SemaNameCase) -> Bool {
    if name.starts_with("#{{") && name.ends_with("}}") -> return sema_casing_has_case(name.slice(2, name.len() - 1), case)
    if sema_casing_ascii_has_case(name, case) == .Val(ascii) -> return ascii
    if name == "_" -> return true
    body := name
    if body.starts_with("_") -> body = sema_casing_drop_first_byte(body)
    if body == "" || body.starts_with("_") || body.ends_with("_") || body.contains("__") -> return false
    scalars: unicode.scalars(body)
    first: scalars[0]
    if case == {
        .Pascal -> {
            if !(sema_casing_is_upper(first) || (sema_casing_is_alphabetic(first) && !sema_casing_is_lower(first))) -> return false
            loop index in 1..<scalars.len() {
                if !sema_casing_is_alphanumeric(scalars[index]) -> return false
            }
        }
        .Snake -> {
            if !(sema_casing_is_lower(first) || (sema_casing_is_alphabetic(first) && !sema_casing_is_upper(first))) -> return false
            loop index in 1..<scalars.len() {
                scalar: scalars[index]
                if scalar != "_" && !(sema_casing_is_alphanumeric(scalar) && !sema_casing_is_upper(scalar)) -> return false
            }
        }
        .Screaming -> {
            if !(sema_casing_is_upper(first) || (sema_casing_is_alphabetic(first) && !sema_casing_is_lower(first))) -> return false
            loop index in 1..<scalars.len() {
                scalar: scalars[index]
                if scalar != "_" && !(sema_casing_is_alphanumeric(scalar) && !sema_casing_is_lower(scalar)) -> return false
            }
        }
    }
    true
}

// This rule mechanical word split. Underscore is a hard boundary; a
// capital run followed by lowercase yields its last capital to the next word
// (`HTTPHeader` -> `HTTP` + `Header`).
sema_casing_split_words: fn(name: String) -> [String] {
    words := [String]{}
    loop segment in name.split("_") {
        if segment == "" -> next
        scalars: unicode.scalars(segment)
        start := 0
        index := 0
        loop index < scalars.len() {
            if {
                sema_casing_is_upper(scalars[index]) -> {
                    run_start := index
                    loop index < scalars.len() && sema_casing_is_upper(scalars[index]) -> index += 1
                    if {
                        index < scalars.len() && sema_casing_is_lower(scalars[index]) && index - run_start > 1 -> {
                            last_capital: index - 1
                            if last_capital > start -> words.push(sema_casing_join(scalars, start, last_capital))
                            start = last_capital
                            loop index < scalars.len() && !sema_casing_is_upper(scalars[index]) -> index += 1
                            words.push(sema_casing_join(scalars, start, index))
                            start = index
                        }
                        index < scalars.len() && sema_casing_is_lower(scalars[index]) -> {
                            if run_start > start -> words.push(sema_casing_join(scalars, start, run_start))
                            start = run_start
                            loop index < scalars.len() && !sema_casing_is_upper(scalars[index]) -> index += 1
                            words.push(sema_casing_join(scalars, start, index))
                            start = index
                        }
                    }
                }
                else -> {
                    loop index < scalars.len() && !sema_casing_is_upper(scalars[index]) -> index += 1
                    if index > start {
                        words.push(sema_casing_join(scalars, start, index))
                        start = index
                    }
                }
            }
        }
        if start < scalars.len() -> words.push(sema_casing_join(scalars, start, scalars.len()))
    }
    words
}

sema_casing_snake_words: fn(name: String) -> String {
    if name.contains("_") {
        already_lower := true
        loop scalar in unicode.scalars(name) {
            if sema_casing_is_upper(scalar) -> already_lower = false
        }
        if already_lower -> return name.copy()
    }
    words := [String]{}
    loop word in sema_casing_split_words(name) -> words.push(unicode.lower(word))
    words.join("_")
}

sema_casing_pascal_words: fn(name: String) -> String {
    out := ""
    loop segment in name.split("_") {
        if segment == "" -> next
        scalars: unicode.scalars(segment)
        out = "{out}{unicode.upper(scalars[0])}{sema_casing_join(scalars, 1, scalars.len())}"
    }
    out
}

sema_casing_canonical: fn(name: String, case: SemaNameCase) -> String {
    leading: if name.starts_with("_") -> "_" else -> ""
    body: sema_casing_trim_leading_underscores(name)
    out: if case == {
        .Pascal -> sema_casing_pascal_words(body)
        .Snake -> sema_casing_snake_words(body)
        .Screaming -> unicode.upper(sema_casing_snake_words(body))
    }
    "{leading}{out}"
}

// The applied acronym lexicon: every initials-formed word in current
// Jet names, in canonical caps. A copy of `ACRONYMS` in
// Compiler/JetFoundation/Data/Syntax/Acronyms.jet, its one home: edit the
// home, then copy it here (tests/guards/closed_lists/mirrors.tsv fails on drift).
SEMA_CASING_ACRONYMS: #run { [String]{
    "AABB", "ABI", "AES", "ALPN", "ANSI", "AOT", "API", "ASCII", "AST", "BPE", "CAS", "CBOR",
    "CDP", "CFG", "CI", "CLI", "CMS", "CPU", "CSR", "CSS", "CSV", "DB", "DMA", "DNS",
    "DSL", "DTD", "EOF", "FFI", "FS", "GC", "GPIO", "GPU", "HLL", "HMAC", "HSM", "HTML", "HTTP",
    "ID", "IME", "IO", "IP", "IR", "JIT", "JS", "JSON", "JSONL", "JVM", "KDF", "KMS", "LRU",
    "LSP", "LTO", "LWW", "MCP", "MIME", "MMIO", "OCI", "OS", "PEM", "PID", "PM", "PNG",
    "RGA", "RGB", "RNG", "RPC", "RSA", "SDK", "SHA", "SPSC", "SQL", "SRI", "SRV", "SSG",
    "SSH", "SSR", "SVD", "SVG", "TCP", "TLS", "TOML", "TTY", "TUF", "TUI", "UART", "UDP",
    "UI", "URI", "URL", "UTF", "UUID", "VJP", "VM", "XML", "YAML",
} }

sema_casing_is_digit: fn(scalar: String) -> Bool {
    code: sema_casing_ascii_code(scalar)
    code >= 48 && code <= 57
}

// One PascalCase word: a lexicon acronym (plus trailing digits) in caps, a
// fixed compound spelling, or the word unchanged. Coined contractions stay.
sema_casing_acronym_word: fn(word: String) -> String {
    if word == "Wasm" || word == "Bindgen" -> return word.copy()
    lower: unicode.lower(word)
    if lower == "macos" -> return "MacOS"
    if lower == "ipv4" -> return "IPv4"
    if lower == "ipv6" -> return "IPv6"
    scalars: unicode.scalars(word)
    letters := scalars.len()
    loop letters > 0 && sema_casing_is_digit(scalars[letters - 1]) -> letters -= 1
    if letters == 0 -> return word.copy()
    // The longest lexicon acronyms (ASCII, JSONL) have five letters, and
    // upper-casing never shortens text, so a longer head matches none of
    // them. Raise this bound with the lexicon.
    if letters > 5 -> return word.copy()
    head: unicode.upper(sema_casing_join(scalars, 0, letters))
    loop acronym in SEMA_CASING_ACRONYMS {
        if acronym == head -> return "{head}{sema_casing_join(scalars, letters, scalars.len())}"
    }
    word.copy()
}

// Respell every word of a PascalCase name (`HttpUrlId` -> `HTTPURLID`).
// ALL_CAPS and snake_case names are value-like and stay unchanged.
sema_casing_acronym_name: fn(name: String) -> String {
    // An ASCII name is classified from its bytes, without a string per
    // scalar: only a name that starts upper-case and has a lower-case letter
    // is respelled.
    bytes: name.bytes()
    ascii := true
    has_lower := false
    loop index in 0..<bytes.len() {
        code: Int{bytes[index]}
        if code >= 128 {
            ascii = false
            break
        }
        if code >= 97 && code <= 122 -> has_lower = true
    }
    if ascii {
        if bytes.len() == 0 || (Int{bytes[0]}) < 65 || (Int{bytes[0]}) > 90 || !has_lower -> return name.copy()
    } else {
        scalars: unicode.scalars(name)
        if scalars.len() == 0 || !sema_casing_is_upper(scalars[0]) -> return name.copy()
        loop scalar in scalars {
            if sema_casing_is_lower(scalar) -> has_lower = true
        }
        if !has_lower -> return name.copy()
    }
    segments := [String]{}
    loop segment in name.split("_") {
        out := ""
        loop word in sema_casing_split_words(segment) -> out = "{out}{sema_casing_acronym_word(word)}"
        segments.push(out)
    }
    segments.join("_")
}

// A marker's library part is PascalCase. Each segment of
// an import alias or module path is written as its PascalCase spelling with
// acronyms in caps (`server` -> `Server`, `http_client` -> `HTTPClient`).
sema_casing_marker_qualifier: fn(path: String) -> String {
    segments := [String]{}
    loop segment in path.split(".") -> segments.push(sema_casing_acronym_name(sema_casing_canonical(segment, SemaNameCase.Pascal)))
    segments.join(".")
}
