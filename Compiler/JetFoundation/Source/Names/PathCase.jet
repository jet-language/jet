// Path case, the Jet repository's naming rule for its own files: every folder
// is TitleCase, and every PascalCase word in a folder or file name writes a
// lexicon acronym in its capitals (`Core/Net/TLS.jet`, not `Tls.jet`). A name
// passes when its TitleCase spelling (path_case_title) leaves it unchanged.
// The acronyms are read from their one home, PATH_CASE_LEXICON_PATH. The only
// folders that keep another spelling are the ones a language, a tool or the
// test kit reads by name, each class listed below with the code or tool that
// requires it.
// The rule holds only below a repository root, a folder that holds the
// lexicon at PATH_CASE_LEXICON_PATH. Three callers share it:
// Tests/Guards/AcronymPathCase sweeps the tracked tree,
// `jet check` reports each finding on the checked files (Jet.AcronymPathCase),
// and the language server reports one on its open document.
use pc_files: core.files

PATH_CASE_LEXICON_PATH: "Compiler/JetFoundation/Data/Syntax/Acronyms.jet"

// A kept name or tree and the rule that requires its spelling.
PathCaseKept: struct {
    pattern: String,
    why: String,
}

// Folder names a tool or the test kit looks up by exact spelling, wherever
// they sit: the folder and every name below it keep their spelling.
PATH_CASE_TOOL_NAMES: [PathCaseKept]{
    PathCaseKept{pattern: "node_modules", why: "Node resolves packages through `node_modules` by name"},
    PathCaseKept{pattern: "vendor", why: "the go tool resolves vendored modules through `vendor` by name"},
    PathCaseKept{pattern: "state", why: "the test kit plants a fixture's `state` tree as `.jet` by name, with the layout the tools read (kit_exec_copy_tree in Compiler/JetTestKit/Source/Exec.jet, Compiler/JetTestKit/Source/UI.jet)"},
    PathCaseKept{pattern: "fixture-state", why: "the test kit plants a fixture's `fixture-state` tree as `.jet` by name, with the layout the tools read (kit_exec_copy_tree in Compiler/JetTestKit/Source/Exec.jet, Compiler/JetTestKit/Source/UI.jet)"},
}

// Folders Cargo finds beside a `Cargo.toml` by their default names.
PATH_CASE_CARGO_NAMES: [String]{"src", "benches", "examples", "tests"}

// Trees whose names below the pattern are data, not authored names. A `*`
// segment matches any one folder.
PATH_CASE_DATA: [PathCaseKept]{
    PathCaseKept{pattern: "Core/Time/Tzdb", why: "IANA zone data: the folder and file names are the zone IDs a lookup matches"},
    PathCaseKept{pattern: "Docs/Site/Dist", why: "the published site: names below it are URL paths, and every diagnostic's explain link names one"},
    PathCaseKept{pattern: "Tools/Gauntlet/Entries/*/Fixtures", why: "a gauntlet fixture tree is the input a tool pair walks; both programs must report its names byte for byte"},
    PathCaseKept{pattern: "Tests/AgentWorkloads", why: "agent workload tasks, inputs, expected outputs and baselines are frozen by hash, and the manifest and checksum files name them relative to the corpus root"},
}

// Folders that keep their own name while the names below them are checked.
// A `*` segment matches any one folder.
PATH_CASE_NAMED: [PathCaseKept]{
    PathCaseKept{pattern: "Jetpack/Provider/Batteries/*", why: "a version dependency resolves a first-party battery to `Batteries/<package name>` (jet_cli_first_party_battery in Compiler/JetCLI/Source/CLI/Request.jet)"},
}

// A tool's fixed folder layout: the folder keeps its name and so do the names below it.
PATH_CASE_TOOL_LAYOUTS: [PathCaseKept]{
    PathCaseKept{pattern: "Tools/Editors/TreeSitter/src", why: "`tree-sitter generate` writes the parser into `src/` and the grammar's bindings read it there"},
    PathCaseKept{pattern: "Tools/Editors/TreeSitter/test", why: "`tree-sitter test` reads its corpus from `test/corpus`"},
    PathCaseKept{pattern: "Tools/Editors/Zed/languages", why: "Zed loads an extension's language configs and queries from `languages/` by name"},
    PathCaseKept{pattern: "Tools/Editors/Zed/grammars", why: "Zed fetches and builds an extension's grammars into `grammars/` by name"},
    PathCaseKept{pattern: "Tools/Tower/skills", why: "Claude Code loads a plugin's skills from `skills/` at the plugin root, and the Codex and Cursor manifests name `./skills/`"},
}

// Trees that keep their own name as well as the names below it.
PATH_CASE_KEPT_TREES: [PathCaseKept]{}

// The folder classes that keep their spelling by what the tree holds rather
// than by where they sit.
PathCaseClass: enum {
    ModuleFolder,
    CargoFolder,
    CaseFixture,
    FixtureFolder,
    FixturesTree,
    TestProject,
    GoldenData,
}

PathCaseClassRow: struct {
    kind: PathCaseClass,
    why: String,
}

PATH_CASE_CLASSES: [PathCaseClassRow]{
    PathCaseClassRow{kind: .ModuleFolder, why: "a lowercase folder beside its `name.jet` holds that module's submodules, which the loader finds by the module's name (Compiler/JetDriver/Source/Driver/Loader.jet)"},
    PathCaseClassRow{kind: .CargoFolder, why: "Cargo finds `src`, `benches`, `examples` and `tests` beside a `Cargo.toml` by their default names"},
    PathCaseClassRow{kind: .CaseFixture, why: "the test kit copies the folder a case's `fixture:` line names as the case's work folder, and the steps name its contents by path (Compiler/JetTestKit/Source/Steps.jet)"},
    PathCaseClassRow{kind: .FixtureFolder, why: "a `Name.fixture` folder reproduces a project as its users lay it out; its case steps, manifests and foreign build files name the paths inside it"},
    PathCaseClassRow{kind: .FixturesTree, why: "a project two or more levels inside a `Fixtures` folder is laid out as its users lay it out; its case steps, manifests and foreign build files name these paths"},
    PathCaseClassRow{kind: .TestProject, why: "the folders inside a test project under Tests/ (a folder holding run.jet, package.jet or workspace.jet) are its packages and data, named by its manifests and sources"},
    PathCaseClassRow{kind: .GoldenData, why: "a Tests/Run folder with no `.jet` file at any depth is data its golden program reads by path at compile or run time"},
}

// A word and its one spelling: a lexicon entry keyed by the word in
// lowercase, or a word the tree spells as one compound rather than one hump
// per word.
PathCaseWord: struct {
    word: String,
    spelling: String,
}

PATH_CASE_DOMAIN_WORDS: [PathCaseWord]{
    PathCaseWord{word: "corelib", spelling: "CoreLib"},
    PathCaseWord{word: "jetos", spelling: "JetOS"},
    PathCaseWord{word: "jetpack", spelling: "Jetpack"},
    PathCaseWord{word: "devserver", spelling: "DevServer"},
    PathCaseWord{word: "stdlib", spelling: "StdLib"},
    PathCaseWord{word: "websocket", spelling: "WebSocket"},
    PathCaseWord{word: "websockets", spelling: "WebSockets"},
}

// The acronym lexicon, each entry keyed by its spelling in lowercase.
PathCaseLexicon: struct {
    acronyms: [PathCaseWord],
    compounds: [PathCaseWord],
    exceptions: [PathCaseWord],
}

// The lexicon, read from its home when the compiler is built.
PATH_CASE_LEXICON: #run path_case_lexicon(embed_file("toolchain:{PATH_CASE_LEXICON_PATH}"))

// What the tree holds, as the classes read it: its files (`tracked`), the
// folders holding a `.jet` file at any depth, and the folders holding a
// project manifest, a `module.jet` or a `Cargo.toml`, and the folders the
// cases' `fixture:` lines name. Each column marks a path it holds with 1, at
// the path's id in `paths`.
PathCaseFacts: struct {
    paths: NameTable{name_column_table()},
    tracked: [Int]{name_column()},
    jet_folders: [Int]{name_column()},
    projects: [Int]{name_column()},
    modules: [Int]{name_column()},
    crates: [Int]{name_column()},
    fixture_roots: [Int]{name_column()},
}

// Whether `column` of a NameTable `paths` marks `path`.
path_case_holds: fn(paths: NameTable, column: [Int], path: String) -> Bool Never! {
    name_column_get(paths, column, path) != None
}

// A folder or file name that breaks the rule: its path from the repository
// root, its name, the name the rule spells instead, and what is wrong.
PathCaseFinding: struct {
    path: String,
    name: String,
    spelled: String,
    problem: String,
}

// A finding on disk: the absolute path of the folder or file it names, and
// the checked file it is reported on (the first below that folder).
PathCasePlaced: struct {
    named: String,
    file: String,
    finding: PathCaseFinding,
}

path_case_upper: fn(byte: U8) -> Bool Never! { Int{byte} >= 65 && Int{byte} <= 90 }

path_case_lower: fn(byte: U8) -> Bool Never! { Int{byte} >= 97 && Int{byte} <= 122 }

path_case_digit: fn(byte: U8) -> Bool Never! { Int{byte} >= 48 && Int{byte} <= 57 }

// `_`, `-`, `.` or white space: a separator between the words of a name.
path_case_separator: fn(byte: U8) -> Bool Never! {
    code: Int{byte}
    code == 95 || code == 45 || code == 46 || code == 32 || (code >= 9 && code <= 13)
}

// The bytes `start..<end` of `text`, which start and end on characters.
path_case_slice: fn(text: String, start: Int, end: Int) -> String {
    if start >= end -> return ""
    String.from_bytes(text.bytes()[start..(end - 1)]) ?? ""
}

path_case_uppers_end: fn(bytes: [U8], at: Int) -> Int {
    end := at
    loop end < bytes.len() && path_case_upper(bytes[end]) -> end += 1
    end
}

path_case_lowers_end: fn(bytes: [U8], at: Int) -> Int {
    end := at
    loop end < bytes.len() && path_case_lower(bytes[end]) -> end += 1
    end
}

path_case_digits_end: fn(bytes: [U8], at: Int) -> Int {
    end := at
    loop end < bytes.len() && path_case_digit(bytes[end]) -> end += 1
    end
}

// The separator-free parts of a name. A single separator between two digits
// joins them (`MuslErrno1_2_5` is one part).
path_case_parts: fn(stem: String) -> [String] {
    bytes: stem.bytes()
    parts := [String]{}
    start := 0
    index := 0
    loop index < bytes.len() {
        if !path_case_separator(bytes[index]) {
            index += 1
            next
        }
        end := index
        loop end < bytes.len() && path_case_separator(bytes[end]) -> end += 1
        joined: end - index == 1 && index > 0 && end < bytes.len() && path_case_digit(bytes[index - 1]) && path_case_digit(bytes[end])
        if !joined {
            if index > start -> parts.push(path_case_slice(stem, start, index))
            start = end
        }
        index = end
    }
    if bytes.len() > start -> parts.push(path_case_slice(stem, start, bytes.len()))
    parts
}

// The end of the hump that starts at `at`, or `at` when none does. The humps,
// tried in order: an acronym plural (`IDs`), an acronym run that stops before
// a capitalized word (`HTTPServer` gives `HTTP`), a word (`Server`, `fixture2`),
// a digit run with its lowercase tail (`2d`), and a `_` that joins digits.
path_case_hump_end: fn(bytes: [U8], at: Int) -> Int {
    count: bytes.len()
    uppers: path_case_uppers_end(bytes, at)
    run: uppers - at
    if run >= 2 {
        digits: path_case_digits_end(bytes, uppers)
        if digits < count && (Int{bytes[digits]}) == 115 && (digits + 1 >= count || !path_case_lower(bytes[digits + 1])) {
            return digits + 1
        }
    }
    if run >= 1 {
        if uppers >= count || !path_case_lower(bytes[uppers]) {
            return path_case_digits_end(bytes, uppers)
        }
        if run >= 2 -> return uppers - 1
        return path_case_digits_end(bytes, path_case_lowers_end(bytes, at + 1))
    }
    if path_case_lower(bytes[at]) {
        return path_case_digits_end(bytes, path_case_lowers_end(bytes, at))
    }
    if path_case_digit(bytes[at]) {
        return path_case_lowers_end(bytes, path_case_digits_end(bytes, at))
    }
    if (Int{bytes[at]}) == 95 && at + 1 < count && path_case_digit(bytes[at + 1]) -> return at + 1
    at
}

// The words of a name: its parts split into humps. Bytes no hump takes are
// dropped; a part with no hump at all is one word. A lowercase run right
// after a word's digits is that number's unit or suffix (`100ms`, `65th`,
// `4k`) and stays on the word, so a TitleCase name such as `Within100ms`
// keeps the spelling its snake_case source `within_100ms` was given.
path_case_words: fn(stem: String) -> [String] {
    words := [String]{}
    loop part in path_case_parts(stem) {
        bytes: part.bytes()
        found := false
        at := 0
        loop at < bytes.len() {
            end: path_case_hump_end(bytes, at)
            if end == at {
                at += 1
                next
            }
            hump: path_case_slice(part, at, end)
            if {
                found && at > 0 && path_case_digit(bytes[at - 1]) && path_case_lower(bytes[at]) -> {
                    last: words.len() - 1
                    words[last] = "{words[last]}{hump}"
                }
                else -> words.push(hump)
            }
            found = true
            at = end
        }
        if !found -> words.push(part)
    }
    words
}

// Whether a word is written in capitals: it has an uppercase letter and no
// lowercase one, or it is an acronym plural (`[A-Z]{2,}[0-9]*s`).
path_case_capitals: fn(word: String) -> Bool {
    bytes: word.bytes()
    upper := false
    lower := false
    loop byte in bytes {
        if path_case_upper(byte) -> upper = true
        if path_case_lower(byte) -> lower = true
    }
    if upper && !lower -> return true
    uppers: path_case_uppers_end(bytes, 0)
    uppers >= 2 && path_case_digits_end(bytes, uppers) == bytes.len() - 1 && (Int{bytes[bytes.len() - 1]}) == 115
}

// The spelling `rows` give a word in lowercase, if any.
path_case_spelling: fn(rows: [PathCaseWord], lower: String) -> String? {
    loop row in rows {
        if row.word == lower -> return Val(row.spelling)
    }
    None
}

// One word in TitleCase. A word already in capitals stays, a lexicon compound
// or word exception takes its spelling, and an acronym (with trailing digits or
// a plural `s`) takes its capitals; any other word is capitalized.
path_case_title_word: fn(word: String) -> String {
    if word.bytes().len() > 1 && path_case_capitals(word) -> return word.copy()
    lower: word.to_lower()
    if path_case_spelling(PATH_CASE_LEXICON.compounds, lower) == .Val(spelled) -> return spelled
    if path_case_spelling(PATH_CASE_LEXICON.exceptions, lower) == .Val(spelled) -> return spelled
    bytes: lower.bytes()
    letters := bytes.len()
    loop letters > 0 && path_case_digit(bytes[letters - 1]) -> letters -= 1
    head: path_case_slice(lower, 0, letters)
    digits: path_case_slice(lower, letters, bytes.len())
    if path_case_spelling(PATH_CASE_LEXICON.acronyms, head) == .Val(acronym) {
        return "{acronym}{digits}"
    }
    if letters > 2 && head.ends_with("s") {
        if path_case_spelling(PATH_CASE_LEXICON.acronyms, path_case_slice(head, 0, letters - 1)) == .Val(acronym) {
            return "{acronym}s{digits}"
        }
    }
    "{path_case_slice(lower, 0, 1).to_upper()}{path_case_slice(lower, 1, bytes.len())}"
}

// A name stem in TitleCase with acronyms in capitals.
path_case_title: fn(stem: String) -> String {
    out := ""
    loop word in path_case_words(stem) {
        spelled: path_case_spelling(PATH_CASE_DOMAIN_WORDS, word.to_lower()) ?? path_case_title_word(word)
        out = "{out}{spelled}"
    }
    out
}

// The string literals on one line.
path_case_quoted: fn(line: String) -> [String] {
    pieces: line.split("\"").to_list()
    out := [String]{}
    loop index in 0..<pieces.len() {
        if index % 2 == 1 && index + 1 < pieces.len() -> out.push(pieces[index])
    }
    out
}

// The lexicon read from its home's text: `ACRONYMS`, `ACRONYM_COMPOUNDS`
// and `ACRONYM_WORD_EXCEPTIONS`.
path_case_lexicon: fn(source: String) -> PathCaseLexicon {
    acronyms := [PathCaseWord]{}
    compounds := [PathCaseWord]{}
    exceptions := [PathCaseWord]{}
    in_acronyms := false
    loop line in source.lines() {
        if in_acronyms {
            if line.starts_with("}}") {
                in_acronyms = false
                next
            }
            loop word in path_case_quoted(line) {
                acronyms.push(PathCaseWord{word: word.to_lower(), spelling: word})
            }
            next
        }
        if line.starts_with("ACRONYMS: [String]{{") -> in_acronyms = true
        if line.starts_with("ACRONYM_COMPOUNDS:") {
            words: path_case_quoted(line)
            loop index in 0..<words.len() {
                if index % 2 == 1 {
                    compounds.push(PathCaseWord{word: words[index - 1], spelling: words[index]})
                }
            }
        }
        if line.starts_with("ACRONYM_WORD_EXCEPTIONS:") {
            loop word in path_case_quoted(line) {
                exceptions.push(PathCaseWord{word: word.to_lower(), spelling: word})
            }
        }
    }
    PathCaseLexicon{acronyms: acronyms, compounds: compounds, exceptions: exceptions}
}

// `[a-z][a-z0-9_]*`: a module name.
path_case_snake: fn(word: String) -> Bool Never! {
    bytes: word.bytes()
    if bytes.len() == 0 || !path_case_lower(bytes[0]) -> return false
    loop byte in bytes {
        if !path_case_lower(byte) && !path_case_digit(byte) && byte != (U8{95}) -> return false
    }
    true
}

// A PascalCase file stem, `[A-Z][A-Za-z0-9]*` with a lowercase letter: the
// only file names whose words are checked.
path_case_pascal: fn(stem: String) -> Bool Never! {
    bytes: stem.bytes()
    if bytes.len() == 0 || !path_case_upper(bytes[0]) -> return false
    lower := false
    loop byte in bytes {
        if path_case_lower(byte) {
            lower = true
            next
        }
        if !path_case_upper(byte) && !path_case_digit(byte) -> return false
    }
    lower
}

// Whether `path` lies at or below a pattern (`*` matches one segment).
path_case_under: fn(path: String, pattern: String) -> Bool {
    segments: path.split("/").to_list()
    wanted: pattern.split("/").to_list()
    if segments.len() < wanted.len() -> return false
    loop index in 0..<wanted.len() {
        if wanted[index] != "*" && wanted[index] != segments[index] -> return false
    }
    true
}

path_case_depth: fn(path: String) -> Int { path.split("/").to_list().len() }

path_case_data: fn(path: String) -> Bool {
    loop row in PATH_CASE_DATA {
        if path_case_under(path, row.pattern) && path_case_depth(path) > path_case_depth(row.pattern) {
            return true
        }
    }
    false
}

path_case_named: fn(path: String) -> Bool {
    loop row in PATH_CASE_NAMED {
        if path_case_under(path, row.pattern) && path_case_depth(path) == path_case_depth(row.pattern) {
            return true
        }
    }
    false
}

path_case_kept_tree: fn(path: String) -> Bool {
    loop row in PATH_CASE_KEPT_TREES {
        if path == row.pattern || path.starts_with("{row.pattern}/") -> return true
    }
    loop row in PATH_CASE_TOOL_LAYOUTS {
        if path == row.pattern || path.starts_with("{row.pattern}/") -> return true
    }
    false
}

// Tool state (`.git`, `.agents`, `.jet`) and a folder a tool or the test kit
// looks up by name keep their spelling, and so does everything below them.
path_case_tool_owned: fn(segments: [String]) -> Bool {
    loop segment in segments {
        if segment.starts_with(".") -> return true
        loop row in PATH_CASE_TOOL_NAMES {
            if row.pattern == segment -> return true
        }
    }
    false
}

// Whether the folder `segments` lies strictly below one of the roots `roots`
// marks (a column of `paths`) that has at least `shortest` segments.
path_case_below: fn(segments: [String], paths: NameTable, roots: [Int], shortest: Int) -> Bool {
    prefix := ""
    loop index in 0..<segments.len() - 1 {
        prefix = if index == 0 -> segments[0] else -> "{prefix}/{segments[index]}"
        if index + 1 >= shortest && path_case_holds(paths, roots, prefix) -> return true
    }
    false
}

path_case_fixture_folder: fn(segments: [String]) -> Bool {
    loop index in 0..<segments.len() - 1 {
        if segments[index].ends_with(".fixture") -> return true
    }
    false
}

path_case_fixtures_tree: fn(segments: [String]) -> Bool {
    loop index in 0..<segments.len() - 1 {
        if (segments[index] == "Fixtures" || segments[index] == "fixtures") && index + 1 < segments.len() - 1 {
            return true
        }
    }
    false
}

path_case_leaf: fn(path: String) -> String {
    segments: path.split("/").to_list()
    segments[segments.len() - 1]
}

path_case_parent: fn(folder: String) -> String {
    segments := folder.split("/").to_list()
    _ := segments.pop()
    segments.join("/")
}

path_case_class_keeps: fn(kind: PathCaseClass, folder: String, segments: [String], facts: PathCaseFacts) -> Bool {
    name: segments[segments.len() - 1]
    keeps: if kind == {
        .ModuleFolder -> name == name.to_lower() && path_case_holds(facts.paths, facts.tracked, "{folder}.jet")
        .CargoFolder -> PATH_CASE_CARGO_NAMES.contains(name) && path_case_holds(facts.paths, facts.crates, path_case_parent(folder))
        .CaseFixture -> path_case_below(segments, facts.paths, facts.fixture_roots, 1)
        .FixtureFolder -> path_case_fixture_folder(segments)
        .FixturesTree -> path_case_fixtures_tree(segments)
        .TestProject -> segments.len() > 1 && segments[0] == "Tests" && segments[1] != "Guards" && path_case_below(segments, facts.paths, facts.projects, 3)
        .GoldenData -> folder.starts_with("Tests/Run/") && !path_case_holds(facts.paths, facts.jet_folders, folder)
    }
    keeps
}

// Whether a folder keeps its spelling, by name, by place or by class.
path_case_kept: fn(folder: String, facts: PathCaseFacts) -> Bool {
    segments: folder.split("/").to_list()
    if path_case_tool_owned(segments) || path_case_data(folder) || path_case_kept_tree(folder) || path_case_named(folder) {
        return true
    }
    loop row in PATH_CASE_CLASSES {
        if path_case_class_keeps(row.kind, folder, segments, facts) -> return true
    }
    false
}

// `path` with `.` and `..` segments resolved.
path_case_normal: fn(path: String) -> String {
    out := [String]{}
    loop segment in path.split("/") {
        if segment == "" || segment == "." -> next
        if segment == ".." && out.len() > 0 && out[out.len() - 1] != ".." {
            _ := out.pop()
            next
        }
        out.push(segment)
    }
    out.join("/")
}

// The folder one `git grep` line `case:fixture: value` names: a single plain
// or quoted path, relative to the case's folder, as the kit's `fixture:` key
// reads it (Compiler/JetTestKit/Source/Steps.jet).
path_case_fixture_root: fn(line: String) -> String? {
    halves: line.split(":fixture:").to_list()
    if halves.len() != 2 -> return None
    value := halves[1].trim()
    if value == "" || value.contains(" ") || value.contains("\t") -> return None
    if value.starts_with("\"") && value.ends_with("\"") && value.bytes().len() >= 2 {
        value = path_case_slice(value, 1, value.bytes().len() - 1)
    }
    Val(path_case_normal("{path_case_parent(halves[0])}/{value}"))
}

path_case_facts: fn(tracked: [String], fixture_roots: [String]) -> PathCaseFacts {
    facts := PathCaseFacts{}
    loop path in tracked {
        name_column_set(facts.paths, facts.tracked, path, 1)
        segments: path.split("/").to_list()
        if segments.len() < 2 -> next
        leaf: segments[segments.len() - 1]
        parent: path_case_parent(path)
        if leaf == {
            "run.jet" | "package.jet" | "workspace.jet" -> { name_column_set(facts.paths, facts.projects, parent, 1) }
            "module.jet" -> { name_column_set(facts.paths, facts.modules, parent, 1) }
            "Cargo.toml" -> { name_column_set(facts.paths, facts.crates, parent, 1) }
            else -> {}
        }
        if !path.ends_with(".jet") -> next
        prefix := ""
        loop index in 0..<segments.len() - 1 {
            prefix = if index == 0 -> segments[0] else -> "{prefix}/{segments[index]}"
            name_column_set(facts.paths, facts.jet_folders, prefix, 1)
        }
    }
    loop root in fixture_roots -> name_column_set(facts.paths, facts.fixture_roots, root, 1)
    facts
}

// What is wrong with a folder the rule checks (one no class keeps), if
// anything. A directory module (`name: module` loads `name/module.jet`) is
// named like its declaration, in snake_case; any other folder is TitleCase,
// and a `.suffix` (`Name.fixture`) is a tool suffix that stays lowercase.
path_case_folder_check: fn(folder: String, facts: PathCaseFacts) -> PathCaseFinding? {
    name: path_case_leaf(folder)
    if path_case_holds(facts.paths, facts.modules, folder) {
        if path_case_snake(name) -> return None
        return Val(PathCaseFinding{path: folder, name: name, spelled: sema_casing_canonical(name, .Snake), problem: "directory module `{name}` is named like its `name: module` declaration, in snake_case"})
    }
    stem: name.split(".").to_list()[0]
    titled: path_case_title(stem)
    if titled == stem -> return None
    spelled: "{titled}{path_case_slice(name, stem.bytes().len(), name.bytes().len())}"
    Val(PathCaseFinding{path: folder, name: name, spelled: spelled, problem: "folder `{name}` is not TitleCase with acronyms in capitals; write `{spelled}`"})
}

// What is wrong with a file name in a folder the rule checks, if anything:
// a PascalCase stem writes each lexicon acronym in its capitals.
path_case_file_check: fn(path: String) -> PathCaseFinding? {
    name: path_case_leaf(path)
    stem: name.split(".").to_list()[0]
    if !path_case_pascal(stem) -> return None
    respelled: path_case_title(stem)
    if respelled == stem -> return None
    spelled: "{respelled}{path_case_slice(name, stem.bytes().len(), name.bytes().len())}"
    Val(PathCaseFinding{path: path, name: name, spelled: spelled, problem: "`{stem}` writes an acronym in lowercase; write `{respelled}`"})
}

// Every folder above the files `tracked` names, once each, sorted.
path_case_folders: fn(tracked: [String]) -> [String] {
    seen := name_column_table()
    marks := name_column()
    folders := [String]{}
    loop path in tracked {
        segments: path.split("/").to_list()
        prefix := ""
        loop index in 0..<segments.len() - 1 {
            prefix = if index == 0 -> segments[0] else -> "{prefix}/{segments[index]}"
            if path_case_holds(seen, marks, prefix) -> next
            name_column_set(seen, marks, prefix, 1)
            folders.push(prefix.copy())
        }
    }
    folders.sort()
    folders
}

// Every folder or file name of `tracked` (paths from the repository root)
// that breaks the rule, folders first, each in path order. A file is checked
// only when its folder is not kept.
path_case_findings: fn(tracked: [String], fixture_roots: [String]) -> [PathCaseFinding] {
    facts: path_case_facts(tracked, fixture_roots)
    findings := [PathCaseFinding]{}
    folders := name_column_table()
    kept := name_column()
    loop folder in path_case_folders(tracked) {
        if path_case_kept(folder, facts) {
            name_column_set(folders, kept, folder, 1)
            next
        }
        if path_case_folder_check(folder, facts) == .Val(finding) -> findings.push(finding)
    }
    files := [String]{}
    loop path in tracked {
        if path.contains("/") && path_case_holds(folders, kept, path_case_parent(path)) -> next
        files.push(path.copy())
    }
    files.sort()
    loop path in files {
        if path_case_file_check(path) == .Val(finding) -> findings.push(finding)
    }
    findings
}

// The repository root above the file at `path`: the nearest folder holding
// the lexicon at PATH_CASE_LEXICON_PATH. None outside every repository.
path_case_repository: fn(path: String) -[FS]> String? Never! {
    folder := path_case_parent(path)
    loop folder != "" {
        if pc_files.is_file("{folder}/{PATH_CASE_LEXICON_PATH}") -> return Val(folder)
        folder = path_case_parent(folder)
    }
    None
}

// One folder's part of the facts: its files and the folders its cases'
// `fixture:` lines name, all as paths from the repository root.
PathCaseListing: struct {
    files: [String],
    fixture_roots: [String],
}

// The listing of `folder` (a path from `root`, "" for the root itself).
path_case_listing: fn(root: String, folder: String) -[FS]> PathCaseListing Never! {
    files := [String]{}
    fixture_roots := [String]{}
    listed: pc_files.list_dir(if folder == "" -> root else -> "{root}/{folder}") ?? [pc_files.DirEntry]{}
    loop entry in listed {
        if entry.is_dir -> next
        file: if folder == "" -> entry.name else -> "{folder}/{entry.name}"
        if entry.name.ends_with(".case") {
            text: pc_files.read(entry.path) ?? ""
            loop line in text.lines() {
                if !line.starts_with("fixture:") -> next
                if path_case_fixture_root("{file}:{line}") == .Val(fixture) {
                    fixture_roots.push(fixture)
                }
            }
        }
        files.push(file)
    }
    PathCaseListing{files: files, fixture_roots: fixture_roots}
}

// The findings for the files at `paths` (absolute, `/`-separated) that lie in
// a repository: each folder above such a file and each file name, as the
// tracked sweep finds them, each once and reported on the first of `paths`
// it covers. The facts the classes read come from the folders above each
// file: their files, and the `fixture:` lines of the cases among them. A
// file outside every repository has none.
path_case_disk_findings: fn(paths: [String]) -[FS]> [PathCasePlaced] Never! {
    placed := [PathCasePlaced]{}
    // Each folder and file already reported on, and each folder's listing,
    // a row of `listings`, by absolute path at its id in `named`.
    named := name_column_table()
    seen := name_column()
    listed := name_column()
    listings := [PathCaseListing]{}
    loop path in paths {
        root: path_case_repository(path) ?? next
        relative: path_case_slice(path, root.bytes().len() + 1, path.bytes().len())
        segments: relative.split("/").to_list()
        tracked := [String]{}
        fixture_roots := [String]{}
        folder := ""
        loop index in 0..<segments.len() {
            key: "{root}/{folder}"
            row := name_column_get(named, listed, key) ?? -1
            if row < 0 {
                row = listings.len()
                listings.push(path_case_listing(root, folder))
                name_column_set(named, listed, key, row)
            }
            loop file in listings[row].files -> tracked.push(file.copy())
            loop fixture in listings[row].fixture_roots -> fixture_roots.push(fixture.copy())
            if index + 1 < segments.len() {
                folder = if folder == "" -> segments[index] else -> "{folder}/{segments[index]}"
            }
        }
        facts: path_case_facts(tracked, fixture_roots)
        prefix := ""
        kept := false
        loop index in 0..<segments.len() - 1 {
            prefix = if index == 0 -> segments[0] else -> "{prefix}/{segments[index]}"
            kept = path_case_kept(prefix, facts)
            if kept || path_case_holds(named, seen, "{root}/{prefix}") -> next
            name_column_set(named, seen, "{root}/{prefix}", 1)
            if path_case_folder_check(prefix, facts) == .Val(finding) {
                placed.push(PathCasePlaced{named: "{root}/{prefix}", file: path.copy(), finding: finding})
            }
        }
        if kept || path_case_holds(named, seen, path) -> next
        name_column_set(named, seen, path, 1)
        if path_case_file_check(relative) == .Val(finding) {
            placed.push(PathCasePlaced{named: path.copy(), file: path.copy(), finding: finding})
        }
    }
    placed
}

// Jet.AcronymPathCase for one finding, at the start of the file it is
// reported on.
path_case_diagnostic: fn(finding: PathCaseFinding) -> Diagnostic Never! {
    diagnostic_from_registry("L0536", Val(Span{start: 0, end: 0}), "`{finding.path}`: {finding.problem}", "Every folder and code file in the Jet repository is TitleCase, and a lexicon acronym keeps its capitals, so one name has one spelling", "Rename it to `{finding.spelled}`")
}
