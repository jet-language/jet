// Checked name facts: modules, declarations, aliases, references and structure facts that sema
// publishes for the index, the LSP and the CLI.

NameVisibility: enum { Private Package Public }

NameModule: struct { alias: String, path: String, package: String, namespace: String?{None} }

NameDeclaration: struct {
    module_index: Int
    name: String
    path: String
    kind: String
    span: Span
    visibility: NameVisibility
}

NameAlias: struct {
    module_index: Int
    name: String
    target: String
    target_module: Int?
    span: Span
    visibility: NameVisibility
}

NameReference: struct {
    module_path: String
    kind: String
    def_span: Span
    semantic_identity: String?
}

StructureFactKind: enum { Liveness Lifecycle ImportEdge }

StructureFact: struct {
    kind: StructureFactKind
    subject: String
    source: String
    span: Span
    status: String
    detail: String
    gate: String?
}

NameDisplayPath: struct {
    module_index: Int
    internal_path: String
    display_path: String
}

NameFacts: struct {
    modules: [NameModule]
    declarations: [NameDeclaration]
    aliases: [NameAlias]
    references: [NameReference]
    structure_facts: [StructureFact]
    // Source-facing paths are semantic-check metadata, not emitted identities.
    display_paths: [NameDisplayPath]{[NameDisplayPath]{}}
}
