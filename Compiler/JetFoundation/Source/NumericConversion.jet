fn jet_numeric_integer_bounds(kind: I64) -> (lower: Int, upper: Int)? Never! {
    return if kind == {
        I64{0} -> Val((Int{I8.min}, Int{I8.max}))
        I64{1} -> Val((Int{I16.min}, Int{I16.max}))
        I64{2} -> Val((Int{I32.min}, Int{I32.max}))
        I64{3} -> Val((Int{I64.min}, Int{I64.max}))
        I64{4} -> Val((Int{U8.min}, Int{U8.max}))
        I64{5} -> Val((Int{U16.min}, Int{U16.max}))
        I64{6} -> Val((Int{U32.min}, Int{U32.max}))
        I64{7} -> Val((Int{U64.min}, Int{U64.max}))
        else -> None
    }
}
