pub fn jet_numeric_checked_widen_parts(significant: Int, trailing: Int, value: F64, target_f32: Bool) -> F64? Never! {
    precision :: if target_f32 -> 24 else -> 53
    if significant > precision && trailing < significant - precision -> return None
    if !value.is_finite() -> return None
    if target_f32 {
        narrowed :: F32{value}
        if !narrowed.is_finite() -> return None
        return Val(F64{narrowed})
    }
    Val(value)
}
