    significant :: if magnitude == U64{0} -> 0 else -> 64 - Int{magnitude.leading_zeros()}
    trailing :: if magnitude == U64{0} -> 0 else -> Int{magnitude.trailing_zeros()}
    value :: if signed -> F64{signed_value} else -> F64{raw}
    jet_numeric_checked_widen_parts(significant, trailing, value, target_f32)
}
