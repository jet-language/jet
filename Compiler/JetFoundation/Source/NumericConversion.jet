pub fn jet_numeric_bit_count(value: I64, operation: I64, width: I64) -> I64 Never! {
    assert(width >= I64{1} && width <= I64{64}, "checked integer width")
    bits :: value.to_bits() & (U64.max >> (I64{64} - width))
    ones :: I64{bits.count_ones()}
    return if operation == {
        I64{0} -> ones
        I64{1} -> width - ones
        I64{2} -> I64{bits.leading_zeros()} - (I64{64} - width)
        I64{3} -> I64{bits.trailing_zeros()}.min(width)
        I64{4} -> I64{value.unsigned_abs().count_ones()}
        I64{5} -> {
            magnitude :: value.unsigned_abs()
            if magnitude == U64{0} -> I64{0} else -> I64{64} - I64{magnitude.leading_zeros()}
        }
        else -> panic("checked integer population operation")
    }
}
