pub fn jet_numeric_float_to_int(value: F64, kind: I64) -> Int Err! {
    bounds :: if jet_numeric_float_bounds(kind) == {
        .Val(bounds) -> bounds
        .None -> return err(JET_NUMERIC_CONVERSION_ERROR)
    }
    if !value.is_finite() || value < bounds.lower || value >= bounds.upper -> return err(JET_NUMERIC_CONVERSION_ERROR)
    Int{value.trunc()}
}
