// D-METAREFLECT1: comptime and runtime reflection project these registered rows.
// Runtime erases compile-time metadata; it never rebuilds fields from text.
use JetFoundation.Diagnostics.[Span]
use JetFoundation.AST.[Field, Marker, StructDef]
use JetFoundation.Types.[Type]

// Rust: crates/jet-foundation/src/Reflection.rs:12
pub struct ReflectionField {
    pub name: String
    pub ty: Type
    pub markers: [Marker]
    pub is_pub: Bool
    pub span: Span
}

// Rust: crates/jet-foundation/src/Reflection.rs:20
impl ReflectionField {
    // Rust: crates/jet-foundation/src/Reflection.rs:22
    pub fn from_field(field: Field) -> ReflectionField Never! {
        ReflectionField{name: ~field.name, ty: ~field.ty, markers: ~field.serde_markers, is_pub: field.is_pub, span: field.name_span}
    }
}

// Rust: crates/jet-foundation/src/Reflection.rs:34
pub fn fields(definition: StructDef) -> [ReflectionField] Never! {
    loop field in definition.reflection_fields() -> ReflectionField.from_field(field)
}
// Gates #4494/#4483/#4499/#4409 are not used by Reflection.rs:1-39.
