    {receivers: CollectionReceivers.View, name: "get", minimum_arity: 1, maximum_arity: 1, access: CollectionAccess.Read, args: [CollectionArg]{CollectionArg.Integer}, result: CollectionResult.OptionElement, op: CollectionOp.Builtin{op: TBuiltinOp.GetList}, law: CollectionLaw.Lookup, empty: "None", status: CollectionStatus.Current},
