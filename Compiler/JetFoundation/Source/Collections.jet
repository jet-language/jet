    {receivers: CollectionReceivers.Sequence, name: "split", minimum_arity: 1, maximum_arity: 1, access: CollectionAccess.Sequence, args: [CollectionArg]{CollectionArg.Integer}, result: CollectionResult.SplitPair, op: CollectionOp.Split, law: CollectionLaw.Build, empty: "two empty lists", status: CollectionStatus.Current},
    {receivers: CollectionReceivers.Sequence, name: "is_sorted", minimum_arity: 0, maximum_arity: 0, access: CollectionAccess.Sequence, args: [CollectionArg]{}, result: CollectionResult.Bool, op: CollectionOp.Builtin{op: TBuiltinOp.IterIsSorted}, law: CollectionLaw.Measure, empty: "true", status: CollectionStatus.Current},
