    collection_op(CollectionReceivers.Sequence, "cycle", 1, 1, CollectionAccess.Sequence, [CollectionArg]{CollectionArg.Integer}, CollectionResult.Lazy, CollectionOp.Builtin{op: TBuiltinOp.IterCycle}, CollectionLaw.Adapt, "empty iterator"),
    collection_op(CollectionReceivers.Sequence, "drop_last", 1, 1, CollectionAccess.Sequence, [CollectionArg]{CollectionArg.Integer}, CollectionResult.Lazy, CollectionOp.Builtin{op: TBuiltinOp.IterDropLast}, CollectionLaw.Reorder, "empty iterator"),
    collection_op(CollectionReceivers.Sequence, "chunks", 1, 1, CollectionAccess.Sequence, [CollectionArg]{CollectionArg.Integer}, CollectionResult.LazyChunks, CollectionOp.Builtin{op: TBuiltinOp.Chunks}, CollectionLaw.Window, "empty iterator"),
    collection_op(CollectionReceivers.Sequence, "windows", 1, 1, CollectionAccess.Sequence, [CollectionArg]{CollectionArg.Integer}, CollectionResult.LazyChunks, CollectionOp.Builtin{op: TBuiltinOp.Windows}, CollectionLaw.Window, "empty iterator"),
    collection_op(CollectionReceivers.Sequence, "dedup", 0, 0, CollectionAccess.Sequence, [CollectionArg]{}, CollectionResult.Lazy, CollectionOp.Builtin{op: TBuiltinOp.Dedup}, CollectionLaw.Adapt, "empty iterator"),
    collection_op(CollectionReceivers.Sequence, "flatten", 0, 0, CollectionAccess.Sequence, [CollectionArg]{}, CollectionResult.Flattened, CollectionOp.Builtin{op: TBuiltinOp.Flatten}, CollectionLaw.Adapt, "empty list or iterator"),
    collection_op(CollectionReceivers.Sequence, "indexed", 0, 0, CollectionAccess.Sequence, [CollectionArg]{}, CollectionResult.LazyIndexed, CollectionOp.Indexed, CollectionLaw.Adapt, "empty iterator"),
    collection_op(CollectionReceivers.Sequence, "indexes", 0, 0, CollectionAccess.Sequence, [CollectionArg]{}, CollectionResult.LazyIndexes, CollectionOp.Builtin{op: TBuiltinOp.Indexes}, CollectionLaw.Adapt, "empty iterator"),
    collection_op(CollectionReceivers.Sequence, "intersperse", 1, 1, CollectionAccess.Sequence, [CollectionArg]{CollectionArg.Element}, CollectionResult.Lazy, CollectionOp.Builtin{op: TBuiltinOp.Intersperse}, CollectionLaw.Adapt, "empty iterator"),
    collection_op(CollectionReceivers.Sequence, "first", 0, 0, CollectionAccess.Sequence, [CollectionArg]{}, CollectionResult.OptionElement, CollectionOp.Builtin{op: TBuiltinOp.First}, CollectionLaw.Lookup, "None"),
    collection_op(CollectionReceivers.List, "last", 0, 0, CollectionAccess.Read, [CollectionArg]{}, CollectionResult.OptionElement, CollectionOp.Builtin{op: TBuiltinOp.Last}, CollectionLaw.Lookup, "None"),
    collection_op(CollectionReceivers.Iter, "to_set", 0, 0, CollectionAccess.Move, [CollectionArg]{}, CollectionResult.ElementSet, CollectionOp.IterToSet, CollectionLaw.Drain, "empty Set"),
    collection_op(CollectionReceivers.Sequence, "try_collect", 0, 0, CollectionAccess.Sequence, [CollectionArg]{}, CollectionResult.TryCollected, CollectionOp.Builtin{op: TBuiltinOp.TryCollect}, CollectionLaw.Drain, "Ok(empty list)"),
    collection_op(CollectionReceivers.Sequence, "last_index_of", 1, 1, CollectionAccess.Sequence, [CollectionArg]{CollectionArg.Element}, CollectionResult.OptionInt, CollectionOp.Builtin{op: TBuiltinOp.IterLastIndexOf}, CollectionLaw.Lookup, "None"),
    collection_op(CollectionReceivers.Sequence, "min", 0, 0, CollectionAccess.Sequence, [CollectionArg]{}, CollectionResult.OptionElement, CollectionOp.Min, CollectionLaw.Lookup, "None"),
    collection_op(CollectionReceivers.Sequence, "max", 0, 0, CollectionAccess.Sequence, [CollectionArg]{}, CollectionResult.OptionElement, CollectionOp.Max, CollectionLaw.Lookup, "None"),
    collection_op(CollectionReceivers.Sequence, "sum", 0, 0, CollectionAccess.Sequence, [CollectionArg]{}, CollectionResult.Element, CollectionOp.Sum, CollectionLaw.Drain, "0"),
    collection_op(CollectionReceivers.Sequence, "product", 0, 0, CollectionAccess.Sequence, [CollectionArg]{}, CollectionResult.Element, CollectionOp.Product, CollectionLaw.Drain, "1"),
    collection_op(CollectionReceivers.Sequence, "average", 0, 0, CollectionAccess.Sequence, [CollectionArg]{}, CollectionResult.Float, CollectionOp.Average, CollectionLaw.Drain, "0.0"),
    collection_op(CollectionReceivers.Sequence, "join", 1, 1, CollectionAccess.Sequence, [CollectionArg]{CollectionArg.Text}, CollectionResult.Text, CollectionOp.Builtin{op: TBuiltinOp.JoinSep}, CollectionLaw.Drain, "empty string"),
    collection_op(CollectionReceivers.Sequence, "split", 1, 1, CollectionAccess.Sequence, [CollectionArg]{CollectionArg.Integer}, CollectionResult.SplitPair, CollectionOp.Split, CollectionLaw.Build, "two empty lists"),
    collection_op(CollectionReceivers.Sequence, "is_sorted", 0, 0, CollectionAccess.Sequence, [CollectionArg]{}, CollectionResult.Bool, CollectionOp.Builtin{op: TBuiltinOp.IterIsSorted}, CollectionLaw.Measure, "true"),
    collection_op(CollectionReceivers.Sequence, "compare", 1, 1, CollectionAccess.Sequence, [CollectionArg]{CollectionArg.ElementList}, CollectionResult.Int, CollectionOp.Builtin{op: TBuiltinOp.IterCompare}, CollectionLaw.Measure, "0 against an empty list"),
    collection_op(CollectionReceivers.Sequence, "is_empty", 0, 0, CollectionAccess.Sequence, [CollectionArg]{}, CollectionResult.Bool, CollectionOp.Builtin{op: TBuiltinOp.IsEmpty}, CollectionLaw.Measure, "true"),
    collection_op(CollectionReceivers.Sequence, "len", 0, 0, CollectionAccess.Sequence, [CollectionArg]{}, CollectionResult.Int, CollectionOp.Builtin{op: TBuiltinOp.LenList}, CollectionLaw.Measure, "0"),
    collection_op(CollectionReceivers.Map, "len", 0, 0, CollectionAccess.Read, [CollectionArg]{}, CollectionResult.Int, CollectionOp.Builtin{op: TBuiltinOp.LenList}, CollectionLaw.Measure, "0"),
    collection_op(CollectionReceivers.Map, "is_empty", 0, 0, CollectionAccess.Read, [CollectionArg]{}, CollectionResult.Bool, CollectionOp.Builtin{op: TBuiltinOp.IsEmpty}, CollectionLaw.Measure, "true"),
    collection_op(CollectionReceivers.Map, "replace", 2, 2, CollectionAccess.Write, [CollectionArg]{CollectionArg.Key, CollectionArg.Value}, CollectionResult.OptionElement, CollectionOp.Builtin{op: TBuiltinOp.InsertMap}, CollectionLaw.Mutate, "None"),
    collection_op(CollectionReceivers.Map, "keys", 0, 0, CollectionAccess.Read, [CollectionArg]{}, CollectionResult.KeyIter, CollectionOp.Builtin{op: TBuiltinOp.Keys}, CollectionLaw.Adapt, "empty iterator"),
    collection_op(CollectionReceivers.Map, "values", 0, 0, CollectionAccess.Read, [CollectionArg]{}, CollectionResult.ElementIter, CollectionOp.Builtin{op: TBuiltinOp.Values}, CollectionLaw.Adapt, "empty iterator"),
    collection_op(CollectionReceivers.Map, "first", 0, 0, CollectionAccess.Read, [CollectionArg]{}, CollectionResult.OptionKey, CollectionOp.Builtin{op: TBuiltinOp.MapFirst}, CollectionLaw.Lookup, "None"),
    collection_op(CollectionReceivers.Map, "min", 0, 0, CollectionAccess.Read, [CollectionArg]{}, CollectionResult.OptionElement, CollectionOp.Builtin{op: TBuiltinOp.MapMin}, CollectionLaw.Lookup, "None"),
    collection_op(CollectionReceivers.Map, "max", 0, 0, CollectionAccess.Read, [CollectionArg]{}, CollectionResult.OptionElement, CollectionOp.Builtin{op: TBuiltinOp.MapMax}, CollectionLaw.Lookup, "None"),
    collection_op(CollectionReceivers.Map, "to_list", 0, 0, CollectionAccess.Read, [CollectionArg]{}, CollectionResult.EntryPairs, CollectionOp.MapToList, CollectionLaw.Build, "empty list"),
    collection_op(CollectionReceivers.Map, "items", 0, 0, CollectionAccess.Read, [CollectionArg]{}, CollectionResult.EntryPairs, CollectionOp.MapToList, CollectionLaw.Build, "empty list"),
    collection_op(CollectionReceivers.View, "len", 0, 0, CollectionAccess.Read, [CollectionArg]{}, CollectionResult.Int, CollectionOp.Builtin{op: TBuiltinOp.LenList}, CollectionLaw.Measure, "0"),
    collection_op(CollectionReceivers.View, "is_empty", 0, 0, CollectionAccess.Read, [CollectionArg]{}, CollectionResult.Bool, CollectionOp.Builtin{op: TBuiltinOp.IsEmpty}, CollectionLaw.Measure, "true"),
    collection_op(CollectionReceivers.View, "get", 1, 1, CollectionAccess.Read, [CollectionArg]{CollectionArg.Integer}, CollectionResult.OptionElement, CollectionOp.Builtin{op: TBuiltinOp.GetList}, CollectionLaw.Lookup, "None"),
    collection_op(CollectionReceivers.View, "index_of", 1, 1, CollectionAccess.Read, [CollectionArg]{CollectionArg.Element}, CollectionResult.OptionInt, CollectionOp.Builtin{op: TBuiltinOp.IndexOf}, CollectionLaw.Lookup, "None"),
    collection_op(CollectionReceivers.View, "first", 0, 0, CollectionAccess.Read, [CollectionArg]{}, CollectionResult.OptionElement, CollectionOp.Builtin{op: TBuiltinOp.First}, CollectionLaw.Lookup, "None"),
    collection_op(CollectionReceivers.View, "last", 0, 0, CollectionAccess.Read, [CollectionArg]{}, CollectionResult.OptionElement, CollectionOp.Builtin{op: TBuiltinOp.Last}, CollectionLaw.Lookup, "None"),
    collection_op(CollectionReceivers.View, "contains", 1, 1, CollectionAccess.Read, [CollectionArg]{CollectionArg.Element}, CollectionResult.Bool, CollectionOp.Builtin{op: TBuiltinOp.Contains}, CollectionLaw.Measure, "false"),
    collection_op(CollectionReceivers.View, "join", 1, 1, CollectionAccess.Read, [CollectionArg]{CollectionArg.Text}, CollectionResult.Text, CollectionOp.Builtin{op: TBuiltinOp.JoinSep}, CollectionLaw.Build, "empty string"),
    collection_op(CollectionReceivers.Bits, "len", 0, 0, CollectionAccess.Read, [CollectionArg]{}, CollectionResult.Int, CollectionOp.Builtin{op: TBuiltinOp.LenList}, CollectionLaw.Measure, "0"),
    collection_op(CollectionReceivers.Bits, "count", 0, 0, CollectionAccess.Read, [CollectionArg]{}, CollectionResult.Int, CollectionOp.Builtin{op: TBuiltinOp.BitSetCount}, CollectionLaw.Measure, "0"),
    collection_op(CollectionReceivers.Bits, "is_empty", 0, 0, CollectionAccess.Read, [CollectionArg]{}, CollectionResult.Bool, CollectionOp.Builtin{op: TBuiltinOp.IsEmpty}, CollectionLaw.Measure, "true"),
    collection_op(CollectionReceivers.Bits, "to_list", 0, 0, CollectionAccess.Read, [CollectionArg]{}, CollectionResult.ElementList, CollectionOp.Builtin{op: TBuiltinOp.BitSetToList}, CollectionLaw.Build, "empty list")
} }
// END COLLECTION OPERATIONS

fn sema_collection_kind(ty: Type) -> SemaCollectionKind? {
    if ty == {
        .Tagged(_, inner) -> sema_collection_kind(inner)
        .List(element) -> Val(SemaCollectionKind.List{element: element})
        .FixedList(element, _) -> Val(SemaCollectionKind.FixedList{element: element})
        .Map(key, _, value) -> Val(SemaCollectionKind.Map{key: key, value: value})
        .Apply(name, args) -> {
            if name == "Iter" && args.len() == 1 -> return Val(SemaCollectionKind.Iter{element: args[0]})
            if name == "ViewIter" && args.len() == 1 -> return Val(SemaCollectionKind.ViewIter{element: args[0]})
            if name == "View" && args.len() == 1 -> return Val(SemaCollectionKind.View{element: args[0]})
            if name == "Set" && args.len() == 1 -> return Val(SemaCollectionKind.Set{element: args[0]})
            if name == "Rank" && args.len() == 1 -> return Val(SemaCollectionKind.Rank{element: args[0]})
            if name == "Tally" && args.len() == 1 -> return Val(SemaCollectionKind.Tally{element: args[0]})
            if name == "Queue" && args.len() == 1 -> return Val(SemaCollectionKind.Queue{element: args[0]})
            if name == "PriorityQueue" && args.len() == 1 -> return Val(SemaCollectionKind.PriorityQueue{element: args[0]})
            if name == "Cache" && args.len() == 2 -> return Val(SemaCollectionKind.Cache{key: args[0], value: args[1]})
            None
        }
        .Named(name) -> {
            if name == "Bits" -> return Val(SemaCollectionKind.Bits)
            None
        }
        else -> None
    }
}

pub fn sema_collection_kind_element(kind: SemaCollectionKind) -> Type Never! {
    if kind == {
        .List(element) | .FixedList(element) | .Iter(element) | .ViewIter(element) | .View(element) | .Set(element) | .Rank(element) | .Tally(element) | .Queue(element) | .PriorityQueue(element) -> element
        .Map(_, value) | .Cache(_, value) -> value
        .Bits -> Type.Int
    }
}

fn sema_collection_kind_key(kind: SemaCollectionKind) -> Type Never! {
    if kind == {
        .Map(key, _) | .Cache(key, _) -> key
        else -> sema_collection_kind_element(kind)
    }
}

fn sema_collection_family(kind: SemaCollectionKind) -> CollectionReceivers Never! {
    if kind == {
        .List(_) | .FixedList(_) -> CollectionReceivers.List
        .Iter(_) | .ViewIter(_) -> CollectionReceivers.Iter
        .View(_) -> CollectionReceivers.View
        .Map(_, _) -> CollectionReceivers.Map
        .Set(_) -> CollectionReceivers.Set
        .Rank(_) -> CollectionReceivers.Rank
        .Bits -> CollectionReceivers.Bits
        .Tally(_) -> CollectionReceivers.Tally
        .Cache(_, _) -> CollectionReceivers.Cache
        .Queue(_) -> CollectionReceivers.Queue
        .PriorityQueue(_) -> CollectionReceivers.PriorityQueue
    }
}

fn collection_receivers_accept(receivers: CollectionReceivers, family: CollectionReceivers) -> Bool Never! {
    if receivers == family -> return true
    receivers == CollectionReceivers.Sequence && (family == CollectionReceivers.List || family == CollectionReceivers.Iter)
}

fn collection_access_convention(access: CollectionAccess, family: CollectionReceivers) -> AccessConvention Never! {
    if access == {
        .Read -> AccessConvention.Read
        .Write -> AccessConvention.Write
        .Move -> AccessConvention.Move
        .Sequence -> if family == CollectionReceivers.Iter -> AccessConvention.Move else -> AccessConvention.Read
    }
}

fn collection_arg_is_callback(arg: CollectionArg) -> Bool Never! {
    if arg == {
        .ItemFn | .ItemPredicate | .PairPredicate | .Accumulator | .Comparator | .SortKey | .EntryFn | .EntryPredicate | .EntryAccumulator | .EntryFlatMap | .EntryMerge -> true
        else -> false
    }
}

pub fn sema_collection_receiver_element(receiver: Type) -> Type? {
    kind :: sema_collection_kind(receiver) ?? return None
    Val(sema_collection_kind_element(kind))
}

pub fn sema_collection_is_list(receiver: Type) -> Bool Never! {
    kind :: sema_collection_kind(receiver) ?? return false
    sema_collection_family(kind) == CollectionReceivers.List
}

pub fn sema_collection_is_iter(receiver: Type) -> Bool Never! {
    kind :: sema_collection_kind(receiver) ?? return false
    sema_collection_family(kind) == CollectionReceivers.Iter
}

pub fn sema_collection_is_view_iter(receiver: Type) -> Bool Never! {
    kind :: sema_collection_kind(receiver) ?? return false
    if kind == {
        .ViewIter(_) -> true
        else -> false
    }
}

pub fn sema_collection_is_map(receiver: Type) -> Bool Never! {
    kind :: sema_collection_kind(receiver) ?? return false
    sema_collection_family(kind) == CollectionReceivers.Map
}

pub fn sema_collection_is_set(receiver: Type) -> Bool Never! {
    kind :: sema_collection_kind(receiver) ?? return false
    sema_collection_family(kind) == CollectionReceivers.Set
}

// The one lookup: the checked row for this receiver and method, with its
// receiver-specific access and callback positions resolved.
pub fn sema_collection_method_contract(receiver: Type, method: String) -> SemaCollectionMethodContract? {
    kind :: sema_collection_kind(receiver) ?? return None
    family := sema_collection_family(kind)
    loop row in COLLECTION_OPERATIONS {
        if row.name == method && row.status != CollectionStatus.Proposed && collection_receivers_accept(row.receivers, family) {
            callbacks := [Int]{}
            seeds := [Int]{}
            comparator := false
            loop (index, arg) in row.args {
                if collection_arg_is_callback(arg) -> &callbacks.push(index)
                if arg == CollectionArg.Seed -> &seeds.push(index)
                if arg == CollectionArg.Comparator -> comparator = true
            }
            return Val(SemaCollectionMethodContract{receiver: receiver, kind: kind, row: row, minimum_arity: row.minimum_arity, maximum_arity: row.maximum_arity, receiver_access: collection_access_convention(row.access, family), callback_indices: callbacks, seed_indices: seeds, accepts_comparator: comparator})
        }
    }
    None
}

// Mem is the effect of every exclusive (in-place) collection operation.
pub fn sema_collection_method_effect_row(contract: SemaCollectionMethodContract, span: Span) -> [EffectRowEntry] Never! {
    if contract.row.access == CollectionAccess.Write -> return [EffectRowEntry]{EffectRowEntry{name: "Mem", span: span}}
    [EffectRowEntry]{}
}

fn sema_collection_fn(params: [Type], ret: Type?) -> Type Never! {
    Type.Fn{params: params, ret: ret, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
}

// Lazy results keep the receiver's iterator flavor: a ViewIter stays a ViewIter.
fn sema_collection_output_iter(contract: SemaCollectionMethodContract, element: Type) -> Type Never! {
    if contract.kind == {
        .ViewIter(_) -> Type.Apply{name: "ViewIter", args: [Type]{element}}
        else -> Type.Apply{name: "Iter", args: [Type]{element}}
    }
}

fn sema_collection_same_kind(kind: SemaCollectionKind, element: Type) -> Type Never! {
    if kind == {
        .Rank(_) -> Type.Apply{name: "Rank", args: [Type]{element}}
        .Queue(_) -> Type.Apply{name: "Queue", args: [Type]{element}}
        else -> Type.Apply{name: "Set", args: [Type]{element}}
    }
}

pub fn sema_collection_method_argument_type(contract: SemaCollectionMethodContract, index: Int, seed: Type?, comparator: Bool) -> Type? {
    if index < 0 || index >= contract.row.args.len() -> return None
    element := sema_collection_kind_element(contract.kind)
    key := sema_collection_kind_key(contract.kind)
    seed_ty :: seed ?? Type.Int
    if contract.row.args[index] == {
        .Element | .Value -> Val(element)
        .Key -> Val(key)
        .Integer -> Val(Type.Int)
        .Text -> Val(Type.String)
        .RemoveBy -> Val(Type.Named{name: "RemoveBy"})
        .ElementList -> Val(Type.List{element: element})
        .KeyList -> Val(Type.List{element: key})
        .SameKind -> Val(sema_collection_same_kind(contract.kind, element))
        .Entries -> Val(Type.Map{key: key, key_span: None, value: element})
        .Seed -> Val(seed_ty)
        .ItemFn | .SortKey -> Val(sema_collection_fn([Type]{element}, None))
        .ItemPredicate -> Val(sema_collection_fn([Type]{element}, Val(Type.Bool)))
        .PairPredicate -> Val(sema_collection_fn([Type]{element, element}, Val(Type.Bool)))
        .Accumulator -> Val(sema_collection_fn([Type]{seed_ty, element}, None))
        .Comparator -> {
            if comparator -> return Val(sema_collection_fn([Type]{element, element}, Val(Type.Named{name: "Ordering"})))
            Val(sema_collection_fn([Type]{element}, None))
        }
        .EntryFn -> Val(sema_collection_fn([Type]{key, element}, None))
        .EntryPredicate -> Val(sema_collection_fn([Type]{key, element}, Val(Type.Bool)))
        .EntryAccumulator -> Val(sema_collection_fn([Type]{seed_ty, key, element}, Val(seed_ty)))
        .EntryFlatMap -> Val(sema_collection_fn([Type]{key, element}, Val(Type.Map{key: key, key_span: None, value: element})))
        .EntryMerge -> Val(sema_collection_fn([Type]{key, element, element}, Val(element)))
    }
}

// Result-returning set and sequence filters preserve the error type and require Bool success.
pub fn sema_collection_method_result_type(contract: SemaCollectionMethodContract, callback_return: Type?, seed: Type?) -> Type? {
    element := sema_collection_kind_element(contract.kind)
    key := sema_collection_kind_key(contract.kind)
    family := sema_collection_family(contract.kind)
    eager := family == CollectionReceivers.List || family == CollectionReceivers.View
    callback :: callback_return ?? Type.Named{name: "Unit"}
    success := if callback == {.Result(ok, _) | .Option(ok) -> ok else -> callback}
    if contract.row.result == {
        .Unit -> Val(Type.Named{name: "Unit"})
        .Bool -> Val(Type.Bool)
        .Int -> Val(Type.Int)
        .Float -> Val(Type.Float)
        .Text -> Val(Type.String)
        .Element -> Val(element)
        .Receiver -> Val(contract.receiver)
        .OptionElement -> Val(Type.Option{inner: element})
        .OptionInt -> Val(Type.Option{inner: Type.Int})
        .OptionKey -> Val(Type.Option{inner: key})
        .ElementList -> Val(Type.List{element: element})
        .KeyList -> Val(Type.List{element: key})
        .ElementSet -> Val(Type.Apply{name: "Set", args: [Type]{element}})
        .ElementIter -> Val(Type.Apply{name: "Iter", args: [Type]{element}})
        .KeyIter -> Val(Type.Apply{name: "Iter", args: [Type]{key}})
        .SameKind -> Val(sema_collection_same_kind(contract.kind, element))
        .Entries -> Val(Type.Map{key: key, key_span: None, value: element})
        .EntryPairs -> Val(Type.List{element: Type.Tuple{fields: [TypeTupleField]{TypeTupleField{name: "key", ty: key}, TypeTupleField{name: "value", ty: element}}}})
        .AllocUnit -> Val(Type.Result{ok: Type.Named{name: "Unit"}, err: Type.Named{name: "AllocError"}})
        .AllocOptionValue -> Val(Type.Result{ok: Type.Option{inner: element}, err: Type.Named{name: "AllocError"}})
        .Lazy -> Val(sema_collection_output_iter(contract, element))
        .LazyChunks -> Val(sema_collection_output_iter(contract, Type.List{element: element}))
        .LazyIndexed -> Val(sema_collection_output_iter(contract, Type.Tuple{fields: [TypeTupleField]{TypeTupleField{name: "index", ty: Type.Int}, TypeTupleField{name: "item", ty: element}}}))
        .LazyIndexes -> Val(sema_collection_output_iter(contract, Type.Int))
        .LazyScan -> Val(sema_collection_output_iter(contract, callback))
        .LazyFilterMap -> {
            mapped := if success == {.Option(inner) -> inner else -> success}
            Val(sema_collection_output_iter(contract, mapped))
        }
        .Mapped -> {
            mapped := if eager -> Type.List{element: success} else -> sema_collection_output_iter(contract, success)
            if callback == {
                .Result(_, err) -> Val(Type.Result{ok: mapped, err: err})
                else -> Val(mapped)
            }
        }
        .Filtered -> {
            filtered := if eager -> Type.List{element: element} else -> sema_collection_output_iter(contract, element)
            sema_collection_filtered(filtered, callback)
        }
        .ListMapped -> {
            if callback == {
                .Result(_, err) -> Val(Type.Result{ok: Type.List{element: success}, err: err})
                else -> Val(Type.List{element: callback})
            }
        }
        .ListFiltered -> sema_collection_filtered(Type.List{element: element}, callback)
        .EntryMapped -> Val(Type.Map{key: key, key_span: None, value: callback})
        .EntryFiltered -> {
            if callback == Type.Bool -> return Val(Type.Map{key: key, key_span: None, value: element})
            None
        }
        .FlatMapped -> {
            inner :: if callback == {
                .List(value) | .FixedList(value, _) -> Val(value)
                else -> None
            } ?? return None
            Val(if family == CollectionReceivers.List -> Type.List{element: inner} else -> sema_collection_output_iter(contract, inner))
        }
        .Flattened -> {
            if element == {
                .List(inner) | .FixedList(inner, _) -> Val(if family == CollectionReceivers.List -> Type.List{element: inner} else -> sema_collection_output_iter(contract, inner))
                else -> None
            }
        }
        .Folded -> {
            if callback_return != None -> return Val(callback)
            seed
        }
        .Sorted -> {
            if callback == {
                .Result(_, err) -> Val(Type.Result{ok: Type.Named{name: "Unit"}, err: err})
                else -> Val(Type.Named{name: "Unit"})
            }
        }
        .Grouped -> Val(Type.Map{key: callback, key_span: None, value: Type.List{element: element}})
        .CountedBy -> Val(Type.Map{key: callback, key_span: None, value: Type.Int})
        .Partitioned -> Val(Type.Tuple{fields: [TypeTupleField]{TypeTupleField{name: "false_", ty: Type.List{element: element}}, TypeTupleField{name: "true_", ty: Type.List{element: element}}}})
        .Counts -> Val(Type.Map{key: element, key_span: None, value: Type.Int})
        .Unzipped -> {
            if element == {
                .Tuple(fields) -> {
                    output := [TypeTupleField]{}
                    loop field in fields -> &output.push(TypeTupleField{name: field.name, ty: Type.List{element: field.ty}})
                    Val(Type.Tuple{fields: output})
                }
                else -> None
            }
        }
        .SplitPair -> Val(Type.Tuple{fields: [TypeTupleField]{TypeTupleField{name: "left", ty: Type.List{element: element}}, TypeTupleField{name: "right", ty: Type.List{element: element}}}})
        .MinMax -> Val(Type.Option{inner: Type.Tuple{fields: [TypeTupleField]{TypeTupleField{name: "min", ty: element}, TypeTupleField{name: "max", ty: element}}}})
        .TryCollected -> {
            if element == {
                .Result(ok, err) -> Val(Type.Result{ok: Type.List{element: ok}, err: err})
                else -> None
            }
        }
    }
}

fn sema_collection_filtered(filtered: Type, callback: Type) -> Type? {
    if callback == {
        .Result(ok, err) -> {
            if ok == Type.Bool -> return Val(Type.Result{ok: filtered, err: err})
            return None
        }
        else -> {}
    }
    if callback != Type.Bool -> return None
    Val(filtered)
}

pub fn sema_collection_method_operation(contract: SemaCollectionMethodContract, argument_count: Int, line: Int, callback_return: Type?, callback_mutable: Bool, comparator: Bool, tuple_struct: String) -> SemaCollectionOperation Never! {
    element := sema_collection_kind_element(contract.kind)
    is_view := sema_collection_family(contract.kind) == CollectionReceivers.View
    is_float := element == Type.Float || element == Type.Float32
    is_f32 := element == Type.Float32
    callback :: callback_return ?? Type.Named{name: "Unit"}
    fallible := if callback == {.Result(_, _) -> true else -> false}
    remove_mode := if argument_count == 1 -> TListRemoveMode.Value else -> TListRemoveMode.Dynamic
    if contract.row.op == {
        .Builtin(op) -> SemaCollectionOperation.Builtin{operation: op}
        .Closure(op) -> SemaCollectionOperation.Closure{operation: op}
        .SetClosure(op) -> SemaCollectionOperation.SetClosure{operation: op}
        .SetMinimum -> SemaCollectionOperation.SetMinimum
        .IterToSet -> SemaCollectionOperation.IterToSet
        .ListShuffle -> SemaCollectionOperation.ListShuffle
        .Copy -> panic("copy rows are checked by the explicit copy path before operation selection")
        .SeqMap -> SemaCollectionOperation.Closure{operation: if {
            fallible -> TClosureOp.TryMap
            is_view -> TClosureOp.ViewMap
            callback_mutable -> TClosureOp.MapMut
            else -> TClosureOp.Map
        }}
        .SeqFilter -> SemaCollectionOperation.Closure{operation: if fallible -> TClosureOp.TryFilter else -> TClosureOp.Filter}
        .SeqEach -> SemaCollectionOperation.Closure{operation: if callback_mutable -> TClosureOp.EachMut else -> TClosureOp.Each}
        .SeqFold -> SemaCollectionOperation.Closure{operation: if is_view -> TClosureOp.ViewFold else -> TClosureOp.Fold}
        .SetMap -> SemaCollectionOperation.SetClosure{operation: if {
            fallible -> TClosureOp.TryMap
            callback_mutable -> TClosureOp.MapMut
            else -> TClosureOp.Map
        }}
        .SetFilter -> SemaCollectionOperation.SetClosure{operation: if fallible -> TClosureOp.TryFilter else -> TClosureOp.Filter}
        .SetEach -> SemaCollectionOperation.SetClosure{operation: if callback_mutable -> TClosureOp.EachMut else -> TClosureOp.Each}
        .SortBy -> SemaCollectionOperation.Closure{operation: if {
            comparator -> TClosureOp.SortByCompare
            fallible -> TClosureOp.TrySortBy
            else -> TClosureOp.SortBy
        }}
        .SortByDesc -> SemaCollectionOperation.Closure{operation: if fallible -> TClosureOp.TrySortByDesc else -> TClosureOp.SortByDesc}
        .Sum -> SemaCollectionOperation.Builtin{operation: TBuiltinOp.Sum{float: is_float, f32: is_f32}}
        .Product -> SemaCollectionOperation.Builtin{operation: TBuiltinOp.Product{float: is_float}}
        .Min -> SemaCollectionOperation.Builtin{operation: TBuiltinOp.Min{float: is_float}}
        .Max -> SemaCollectionOperation.Builtin{operation: TBuiltinOp.Max{float: is_float}}
        .Average -> SemaCollectionOperation.Builtin{operation: TBuiltinOp.IterAverage{float: is_float}}
        .Indexed -> SemaCollectionOperation.Builtin{operation: TBuiltinOp.Indexed{tuple_struct: tuple_struct}}
        .Unzip -> SemaCollectionOperation.Builtin{operation: TBuiltinOp.Unzip{tuple_struct: tuple_struct}}
        .Split -> SemaCollectionOperation.Builtin{operation: TBuiltinOp.IterSplit{tuple_struct: tuple_struct}}
        .Partition -> SemaCollectionOperation.Closure{operation: TClosureOp.Partition{tuple_struct: tuple_struct}}
        .ListRemove -> SemaCollectionOperation.Builtin{operation: TBuiltinOp.RemoveList{line: line, mode: remove_mode}}
        .PriorityQueueRemove -> SemaCollectionOperation.Builtin{operation: TBuiltinOp.PriorityQueueRemove{line: line, mode: remove_mode}}
        .MapMerge -> SemaCollectionOperation.Builtin{operation: if argument_count == 2 -> TBuiltinOp.MapMergeWith else -> TBuiltinOp.MapMerge}
        .MapTopN -> SemaCollectionOperation.Builtin{operation: TBuiltinOp.MapTopN{tuple_struct: tuple_struct}}
        .MapToList -> SemaCollectionOperation.Builtin{operation: TBuiltinOp.MapToList{tuple_struct: tuple_struct}}
        .ListMinMax -> SemaCollectionOperation.Builtin{operation: TBuiltinOp.ListMinMax{tuple_struct: tuple_struct}}
        .ListMinMaxBy -> SemaCollectionOperation.Closure{operation: TClosureOp.ListMinMaxBy{tuple_struct: tuple_struct}}
    }
}
