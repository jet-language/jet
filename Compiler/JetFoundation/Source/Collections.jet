    {receivers: CollectionReceivers.Sequence, name: "last_index_of", minimum_arity: 1, maximum_arity: 1, access: CollectionAccess.Sequence, args: [CollectionArg]{CollectionArg.Element}, result: CollectionResult.OptionInt, op: CollectionOp.Builtin{op: TBuiltinOp.IterLastIndexOf}, law: CollectionLaw.Lookup, empty: "None", status: CollectionStatus.Current},
    {receivers: CollectionReceivers.Sequence, name: "min", minimum_arity: 0, maximum_arity: 0, access: CollectionAccess.Sequence, args: [CollectionArg]{}, result: CollectionResult.OptionElement, op: CollectionOp.Min, law: CollectionLaw.Lookup, empty: "None", status: CollectionStatus.Current},
    {receivers: CollectionReceivers.Sequence, name: "max", minimum_arity: 0, maximum_arity: 0, access: CollectionAccess.Sequence, args: [CollectionArg]{}, result: CollectionResult.OptionElement, op: CollectionOp.Max, law: CollectionLaw.Lookup, empty: "None", status: CollectionStatus.Current},
    {receivers: CollectionReceivers.Sequence, name: "sum", minimum_arity: 0, maximum_arity: 0, access: CollectionAccess.Sequence, args: [CollectionArg]{}, result: CollectionResult.Element, op: CollectionOp.Sum, law: CollectionLaw.Drain, empty: "0", status: CollectionStatus.Current},
    {receivers: CollectionReceivers.Sequence, name: "product", minimum_arity: 0, maximum_arity: 0, access: CollectionAccess.Sequence, args: [CollectionArg]{}, result: CollectionResult.Element, op: CollectionOp.Product, law: CollectionLaw.Drain, empty: "1", status: CollectionStatus.Current},
