// Canonical structural collection contracts shared by Source Sema and TIR lowering.
// Zip and para_* are intentionally owned by their dedicated checkers.
//
// Every collection and Iter operation is one checked row in
// COLLECTION_OPERATIONS. Arity, receiver access, argument and callback shapes,
// the result projection, the TIR operation, the Mem effect and the documented
// law are all read from that row; no other table repeats them. Each row names
// one COLLECTION_LAWS entry that states its timing, result ownership, callback
// count and order, stop-item consumption, failure channel and buffering.
// Rows are literal struct data, so both tables land without a compile-time
// execution host.
// `node Tools/agent/gen-core-tables.mjs --write` projects both tables into
// Docs/spec/reference/core-library.md; `--check` rejects a stale projection.

// Append owning compiler rows in input order, leaving the source empty.
// Use pops instead of moving an indexed field/list payload out of a borrowed
// aggregate; both passes transfer whole locals and never clone a row.
fn compiler_transfer_rows<T>(to: &[T], from: &[T]) Never! {
    reversed := [T]{}
    loop from.len() > 0 {
        row := &from.pop() ?? panic("a nonempty compiler row source failed to pop")
        &reversed.push(^row)
    }
    loop reversed.len() > 0 {
        row := &reversed.pop() ?? panic("a nonempty compiler row buffer failed to pop")
        &to.push(^row)
    }
}

// Compiler-internal permutation: order[new index] is the original row index.
// The caller supplies the complete permutation produced by its stable index
// merge. Drain owning rows into unique empty slots in reverse destination
// order, then pop them back in canonical order into the original receiver
// (whose allocation and capacity pop retains). No row is read out of
// a borrowed indexed place and no owning payload is copied.
fn compiler_apply_order<T>(rows: &[T], order: [Int]) Never! {
    count :: rows.len()
    if count < 2 -> return
    changed := false
    loop index in 0..<count {
        if order[index] != index -> changed = true
    }
    if !changed -> return
    destinations := [Int]{}
    slots := [T?]{}
    loop index in 0..<count {
        &destinations.push(0)
        &slots.push(None)
    }
    loop index in 0..<count -> destinations[order[index]] = index
    loop rows.len() > 0 {
        original :: rows.len() - 1
        row := &rows.pop() ?? panic("a nonempty compiler row list failed to pop")
        slots[count - 1 - destinations[original]] = Val(^row)
    }
    loop slots.len() > 0 {
        slot := &slots.pop() ?? panic("a nonempty compiler slot list failed to pop")
        row := ^slot ?? panic("a compiler row permutation left an empty slot")
        &rows.push(^row)
    }
}

// Compiler-internal transfer: moves every row out of `rows` into the returned
// list, in order, leaving `rows` empty. Each row is popped (an owned move) and
// the result is reversed in place, so no owning payload is copied; reading a
// list field of a borrowed owner into a binding would copy every row.
fn compiler_take_rows<T>(rows: &[T]) -> [T] Never! {
    taken := [T]{}
    loop rows.len() > 0 {
        row := &rows.pop() ?? panic("a nonempty compiler row list failed to pop")
        &taken.push(^row)
    }
    &taken.reverse()
    taken
}

enum SemaCollectionKind {
    List(element: Type)
    FixedList(element: Type)
    Iter(element: Type)
    ViewIter(element: Type)
    View(element: Type)
    Map(key: Type, value: Type)
    Set(element: Type)
    Rank(element: Type)
    Bits
    Tally(element: Type)
    Cache(key: Type, value: Type)
    Queue(element: Type)
    PriorityQueue(element: Type)
}

enum SemaCollectionOperation {
    Builtin(operation: TBuiltinOp)
    Closure(operation: TClosureOp)
    ListShuffle
    SetClosure(operation: TClosureOp)
    SetMinimum
    IterToSet
}

// Receiver families a row applies to. `List` covers fixed lists and `Iter`
// covers view iterators; `Sequence` is the shared list-and-iterator surface.
enum CollectionReceivers { List Iter View Sequence Map Set Rank Bits Tally Cache Queue PriorityQueue }

// Receiver ownership. `Sequence` borrows a list or view and consumes an iterator.
enum CollectionAccess { Read Write Move Sequence }

// Positional argument shapes. The callback shapes name their parameter and
// return types; `Seed` is checked from the written expression.
enum CollectionArg {
    Element
    Key
    Value
    Integer
    Text
    IntegerList
    RemoveBy
    ElementList
    KeyList
    SameKind
    Entries
    Seed
    ItemFn
    ItemPredicate
    PairPredicate
    DisjointFn
    Accumulator
    Comparator
    SortKey
    EntryFn
    EntryPredicate
    EntryAccumulator
    EntryFlatMap
    EntryMerge
}

// Result projections over the receiver element, key, callback result and seed.
enum CollectionResult {
    Unit
    Bool
    Int
    Float
    Text
    Element
    Receiver
    OptionElement
    OptionInt
    OptionKey
    ElementList
    KeyList
    ElementSet
    ElementIter
    KeyIter
    SameKind
    Entries
    EntryPairs
    AllocUnit
    AllocOptionValue
    Lazy
    LazyChunks
    LazyIndexed
    LazyIndexes
    LazyScan
    LazyFilterMap
    Mapped
    Filtered
    ListMapped
    ListFiltered
    EntryMapped
    EntryFiltered
    FlatMapped
    Flattened
    Folded
    Sorted
    Grouped
    CountedBy
    Partitioned
    Counts
    Unzipped
    SplitPair
    MinMax
    TryCollected
    WriteViewPair
    WriteViewList
    DisjointUnit
}

// TIR producer. Fixed operations carry their TIR op; the others select one from
// the checked callback and element facts at the call site.
enum CollectionOp {
    Builtin(op: TBuiltinOp)
    Closure(op: TClosureOp)
    SetClosure(op: TClosureOp)
    SetMinimum
    IterToSet
    ListShuffle
    Copy
    SeqMap
    SeqFilter
    SeqEach
    SeqFold
    SetMap
    SetFilter
    SetEach
    SortBy
    SortByDesc
    Sum
    Product
    Min
    Max
    Average
    Indexed
    Unzip
    Split
    SplitWrite
    Partition
    ListRemove
    PriorityQueueRemove
    MapMerge
    MapTopN
    MapToList
    ListMinMax
    ListMinMaxBy
}

enum CollectionLaw {
    Measure
    Lookup
    Mutate
    TryMutate
    Build
    Copy
    Adapt
    Window
    Disjoint
    Visit
    Each
    Decide
    Stream
    Fold
    Group
    Drain
    Reorder
    SortBy
    Search
    MergeEntries
    Pull
}

// Current: checked and lowered on every engine. SourceOnly: checked by the
// self-hosted compiler before every engine carries it. Proposed: ratified but
// not accepted by the checker yet.
enum CollectionStatus { Current SourceOnly Proposed }

struct CollectionLawFacts {
    law: CollectionLaw
    timing: String
    result: String
    callbacks: String
    stop: String
    failure: String
    buffering: String
}

struct CollectionOperationRow {
    receivers: CollectionReceivers
    name: String
    minimum_arity: Int
    maximum_arity: Int
    access: CollectionAccess
    args: [CollectionArg]
    result: CollectionResult
    op: CollectionOp
    law: CollectionLaw
    empty: String
    status: CollectionStatus
}

struct SemaCollectionMethodContract {
    receiver: Type
    kind: SemaCollectionKind
    row: CollectionOperationRow
    minimum_arity: Int
    maximum_arity: Int
    receiver_access: AccessConvention
    callback_indices: [Int]
    seed_indices: [Int]
    accepts_comparator: Bool
}

// BEGIN COLLECTION LAWS
COLLECTION_LAWS :: prep { [CollectionLawFacts]{
    {law: CollectionLaw.Measure, timing: "eager", result: "a fresh scalar", callbacks: "none", stop: "an iterator receiver is consumed whole", failure: "none", buffering: "none"},
    {law: CollectionLaw.Lookup, timing: "eager", result: "an optional copy of the found item or index", callbacks: "none", stop: "an iterator receiver is consumed and cannot be resumed", failure: "absence is None", buffering: "none"},
    {law: CollectionLaw.Mutate, timing: "eager, in place", result: "Unit, a Bool, or the displaced item", callbacks: "none", stop: "not applicable", failure: "absence is None; no error channel", buffering: "the receiver's own storage"},
    {law: CollectionLaw.TryMutate, timing: "eager, in place", result: "a Result", callbacks: "none", stop: "not applicable", failure: "AllocError when storage cannot grow", buffering: "the receiver's own storage"},
    {law: CollectionLaw.Build, timing: "eager", result: "a fresh owned collection", callbacks: "none", stop: "the whole receiver is read", failure: "none", buffering: "the whole output"},
    {law: CollectionLaw.Copy, timing: "eager", result: "an independent value; storage is shared until the first write", callbacks: "none", stop: "not applicable", failure: "none", buffering: "none until the first write"},
    {law: CollectionLaw.Adapt, timing: "lazy", result: "an iterator that owns the adapted source", callbacks: "none", stop: "pulls only the items it yields or skips", failure: "none", buffering: "none"},
    {law: CollectionLaw.Window, timing: "lazy", result: "an iterator of lists", callbacks: "none", stop: "pulls one window or chunk at a time", failure: "none", buffering: "one window or chunk"},
    {law: CollectionLaw.Disjoint, timing: "eager proof, borrowed windows", result: "tracked exclusive ViewMut slots; edit_disjoint returns Unit", callbacks: "edit_disjoint invokes a callback with two lent views; the other methods have none", stop: "no callback runs for an invalid selection", failure: "String error for invalid bounds or overlapping selections", buffering: "view descriptors only; the owner's elements are never copied"},
    {law: CollectionLaw.Visit, timing: "eager on lists and maps, lazy on iterators", result: "a List or Map on eager receivers, an iterator on iterator receivers", callbacks: "once per item, in source order", stop: "every item is visited", failure: "a callback Err is the whole result; no partial output", buffering: "eager receivers buffer the output; iterators buffer nothing"},
    {law: CollectionLaw.Each, timing: "eager", result: "Unit", callbacks: "once per item, in source order", stop: "every item is visited", failure: "none", buffering: "none"},
    {law: CollectionLaw.Decide, timing: "eager", result: "a Bool, Option or position", callbacks: "once per item, in source order, until the answer is known", stop: "the deciding item is consumed; later items are never read and an iterator receiver is dropped", failure: "none", buffering: "none"},
    {law: CollectionLaw.Stream, timing: "lazy", result: "an iterator", callbacks: "once per pulled item, in source order", stop: "the item that ends take_while is consumed and not yielded", failure: "none", buffering: "the current item or group"},
    {law: CollectionLaw.Fold, timing: "eager", result: "the accumulator or chosen item; the seed or None when empty", callbacks: "once per item, in source order", stop: "every item is read; equal keys keep the last item", failure: "none", buffering: "none"},
    {law: CollectionLaw.Group, timing: "eager", result: "a fresh map, tuple or lists", callbacks: "once per item, in source order, when a key callback is given", stop: "every item is read", failure: "none", buffering: "every item is buffered into the output"},
    {law: CollectionLaw.Drain, timing: "eager", result: "a fresh value", callbacks: "none", stop: "the whole source is consumed", failure: "none", buffering: "the output"},
    {law: CollectionLaw.Reorder, timing: "eager: the whole source is read before the first result", result: "the reordered or trimmed items", callbacks: "none", stop: "the whole source is consumed", failure: "none", buffering: "the whole source"},
    {law: CollectionLaw.SortBy, timing: "eager, in place", result: "Unit, or a Result when the key callback can fail", callbacks: "key or comparator calls in the sort's order; count and order are unspecified", stop: "not applicable", failure: "the first callback Err is the result", buffering: "the list and its keys"},
    {law: CollectionLaw.Search, timing: "eager", result: "an optional index", callbacks: "once per probed item, in binary-search order", stop: "stops at the match", failure: "absence is None", buffering: "none"},
    {law: CollectionLaw.MergeEntries, timing: "eager", result: "a fresh map", callbacks: "once per key present in both maps", stop: "every entry is read", failure: "none", buffering: "the output map"},
    {law: CollectionLaw.Pull, timing: "one item per call", result: "an Option of the next item", callbacks: "none", stop: "exactly the returned item is consumed; the remainder stays in the source", failure: "end is None", buffering: "none"}
} }
// END COLLECTION LAWS

// BEGIN COLLECTION OPERATIONS
COLLECTION_OPERATIONS :: prep { [CollectionOperationRow]{
    {receivers: CollectionReceivers.Set, name: "map", minimum_arity: 1, maximum_arity: 1, access: CollectionAccess.Read, args: [CollectionArg]{CollectionArg.ItemFn}, result: CollectionResult.ListMapped, op: CollectionOp.SetMap, law: CollectionLaw.Visit, empty: "empty list", status: CollectionStatus.Current},
    {receivers: CollectionReceivers.Set, name: "filter", minimum_arity: 1, maximum_arity: 1, access: CollectionAccess.Read, args: [CollectionArg]{CollectionArg.ItemFn}, result: CollectionResult.ListFiltered, op: CollectionOp.SetFilter, law: CollectionLaw.Visit, empty: "empty list", status: CollectionStatus.Current},
    {receivers: CollectionReceivers.Set, name: "each", minimum_arity: 1, maximum_arity: 1, access: CollectionAccess.Read, args: [CollectionArg]{CollectionArg.ItemFn}, result: CollectionResult.Unit, op: CollectionOp.SetEach, law: CollectionLaw.Each, empty: "Unit", status: CollectionStatus.Current},
    {receivers: CollectionReceivers.Set, name: "all", minimum_arity: 1, maximum_arity: 1, access: CollectionAccess.Read, args: [CollectionArg]{CollectionArg.ItemPredicate}, result: CollectionResult.Bool, op: CollectionOp.SetClosure{op: TClosureOp.All}, law: CollectionLaw.Decide, empty: "true", status: CollectionStatus.Current},
    {receivers: CollectionReceivers.Set, name: "flat_map", minimum_arity: 1, maximum_arity: 1, access: CollectionAccess.Read, args: [CollectionArg]{CollectionArg.ItemFn}, result: CollectionResult.FlatMapped, op: CollectionOp.SetClosure{op: TClosureOp.FlatMap}, law: CollectionLaw.Visit, empty: "empty iterator", status: CollectionStatus.Current},
    {receivers: CollectionReceivers.Set, name: "fold", minimum_arity: 2, maximum_arity: 2, access: CollectionAccess.Read, args: [CollectionArg]{CollectionArg.Seed, CollectionArg.Accumulator}, result: CollectionResult.Folded, op: CollectionOp.SetClosure{op: TClosureOp.Fold}, law: CollectionLaw.Fold, empty: "the seed", status: CollectionStatus.Current},
    {receivers: CollectionReceivers.Set, name: "min", minimum_arity: 0, maximum_arity: 0, access: CollectionAccess.Read, args: [CollectionArg]{}, result: CollectionResult.OptionElement, op: CollectionOp.SetMinimum, law: CollectionLaw.Lookup, empty: "None", status: CollectionStatus.Current},
    {receivers: CollectionReceivers.Set, name: "max", minimum_arity: 0, maximum_arity: 0, access: CollectionAccess.Read, args: [CollectionArg]{}, result: CollectionResult.OptionElement, op: CollectionOp.Builtin{op: TBuiltinOp.Max{float: false}}, law: CollectionLaw.Lookup, empty: "None", status: CollectionStatus.Current},
