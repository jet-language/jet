// Canonical structural collection contracts shared by Source Sema and TIR lowering.
// Zip and para_* are intentionally owned by their dedicated checkers.
//
// D-ONE-OPERATIONS1=A: every collection and Iter operation is one checked row in
// COLLECTION_OPERATIONS. Arity, receiver access, argument and callback shapes,
// the result projection, the TIR operation, the Mem effect and the documented
// law are all read from that row; no other table repeats them. Each row names
// one COLLECTION_LAWS entry that states its timing, result ownership, callback
// count and order, stop-item consumption, failure channel and buffering.
// `node Tools/agent/gen-core-tables.mjs --write` projects both tables into
// Docs/spec/reference/core-library.md; `--check` rejects a stale projection.

pub enum SemaCollectionKind {
    List(element: Type)
    FixedList(element: Type)
    Iter(element: Type)
    ViewIter(element: Type)
    View(element: Type)
    Map(key: Type, value: Type)
    Set(element: Type)
    Rank(element: Type)
    Bits
    Tally(element: Type)
    Cache(key: Type, value: Type)
    Queue(element: Type)
    PriorityQueue(element: Type)
}

pub enum SemaCollectionOperation {
    Builtin(operation: TBuiltinOp)
    Closure(operation: TClosureOp)
    ListShuffle
    SetClosure(operation: TClosureOp)
    SetMinimum
    IterToSet
}

// Receiver families a row applies to. `List` covers fixed lists and `Iter`
// covers view iterators; `Sequence` is the shared list-and-iterator surface.
pub enum CollectionReceivers { List Iter View Sequence Map Set Rank Bits Tally Cache Queue PriorityQueue }

// Receiver ownership. `Sequence` borrows a list or view and consumes an iterator.
pub enum CollectionAccess { Read Write Move Sequence }

// Positional argument shapes. The callback shapes name their parameter and
// return types; `Seed` is checked from the written expression.
pub enum CollectionArg {
    Element
    Key
    Value
    Integer
    Text
    RemoveBy
    ElementList
    KeyList
    SameKind
    Entries
    Seed
    ItemFn
    ItemPredicate
    PairPredicate
    Accumulator
    Comparator
    SortKey
    EntryFn
    EntryPredicate
    EntryAccumulator
    EntryFlatMap
    EntryMerge
}

// Result projections over the receiver element, key, callback result and seed.
pub enum CollectionResult {
    Unit
    Bool
    Int
    Float
    Text
    Element
    Receiver
    OptionElement
    OptionInt
    OptionKey
    ElementList
    KeyList
    ElementSet
    ElementIter
    KeyIter
    SameKind
    Entries
    EntryPairs
    AllocUnit
    AllocOptionValue
    Lazy
    LazyChunks
    LazyIndexed
    LazyIndexes
    LazyScan
    LazyFilterMap
    Mapped
    Filtered
    ListMapped
    ListFiltered
    EntryMapped
    EntryFiltered
    FlatMapped
    Flattened
    Folded
    Sorted
    Grouped
    CountedBy
    Partitioned
    Counts
    Unzipped
    SplitPair
    MinMax
    TryCollected
}

// TIR producer. Fixed operations carry their TIR op; the others select one from
// the checked callback and element facts at the call site.
pub enum CollectionOp {
    Builtin(op: TBuiltinOp)
    Closure(op: TClosureOp)
    SetClosure(op: TClosureOp)
    SetMinimum
    IterToSet
    ListShuffle
    Copy
    SeqMap
    SeqFilter
    SeqEach
    SeqFold
    SetMap
    SetFilter
    SetEach
    SortBy
    SortByDesc
    Sum
    Product
    Min
    Max
    Average
    Indexed
    Unzip
    Split
    Partition
    ListRemove
    PriorityQueueRemove
    MapMerge
    MapTopN
    MapToList
    ListMinMax
    ListMinMaxBy
}

pub enum CollectionLaw {
    Measure
    Lookup
    Mutate
    TryMutate
    Build
    Copy
    Adapt
    Window
    Visit
    Each
    Decide
    Stream
    Fold
    Group
    Drain
    Reorder
    SortBy
    Search
    MergeEntries
    Pull
}

// Current: checked and lowered on every engine. SourceOnly: checked by the
// self-hosted compiler before every engine carries it. Proposed: ratified but
// not accepted by the checker yet.
pub enum CollectionStatus { Current SourceOnly Proposed }

pub struct CollectionLawFacts {
    pub law: CollectionLaw
    pub timing: String
    pub result: String
    pub callbacks: String
    pub stop: String
    pub failure: String
    pub buffering: String
}

pub struct CollectionOperationRow {
    pub receivers: CollectionReceivers
    pub name: String
    pub minimum_arity: Int
    pub maximum_arity: Int
    pub access: CollectionAccess
    pub args: [CollectionArg]
    pub result: CollectionResult
    pub op: CollectionOp
    pub law: CollectionLaw
    pub empty: String
    pub status: CollectionStatus
}

pub struct SemaCollectionMethodContract {
    pub receiver: Type
    pub kind: SemaCollectionKind
    pub row: CollectionOperationRow
    pub minimum_arity: Int
    pub maximum_arity: Int
    pub receiver_access: AccessConvention
    pub callback_indices: [Int]
    pub seed_indices: [Int]
    pub accepts_comparator: Bool
}

fn collection_law(law: CollectionLaw, timing: String, result: String, callbacks: String, stop: String, failure: String, buffering: String) -> CollectionLawFacts Never! {
    CollectionLawFacts{law: law, timing: timing, result: result, callbacks: callbacks, stop: stop, failure: failure, buffering: buffering}
}

fn collection_op(receivers: CollectionReceivers, name: String, minimum: Int, maximum: Int, access: CollectionAccess, args: [CollectionArg], result: CollectionResult, op: CollectionOp, law: CollectionLaw, empty: String) -> CollectionOperationRow Never! {
    CollectionOperationRow{receivers: receivers, name: name, minimum_arity: minimum, maximum_arity: maximum, access: access, args: args, result: result, op: op, law: law, empty: empty, status: CollectionStatus.Current}
}

// BEGIN COLLECTION LAWS
COLLECTION_LAWS :: prep { [CollectionLawFacts]{
    collection_law(CollectionLaw.Measure, "eager", "a fresh scalar", "none", "an iterator receiver is consumed whole", "none", "none"),
    collection_law(CollectionLaw.Lookup, "eager", "an optional copy of the found item or index", "none", "an iterator receiver is consumed and cannot be resumed", "absence is None", "none"),
    collection_law(CollectionLaw.Mutate, "eager, in place", "Unit, a Bool, or the displaced item", "none", "not applicable", "absence is None; no error channel", "the receiver's own storage"),
    collection_law(CollectionLaw.TryMutate, "eager, in place", "a Result", "none", "not applicable", "AllocError when storage cannot grow", "the receiver's own storage"),
    collection_law(CollectionLaw.Build, "eager", "a fresh owned collection", "none", "the whole receiver is read", "none", "the whole output"),
    collection_law(CollectionLaw.Copy, "eager", "an independent value; storage is shared until the first write", "none", "not applicable", "none", "none until the first write"),
    collection_law(CollectionLaw.Adapt, "lazy", "an iterator that owns the adapted source", "none", "pulls only the items it yields or skips", "none", "none"),
    collection_law(CollectionLaw.Window, "lazy", "an iterator of lists", "none", "pulls one window or chunk at a time", "none", "one window or chunk"),
    collection_law(CollectionLaw.Visit, "eager on lists and maps, lazy on iterators", "a List or Map on eager receivers, an iterator on iterator receivers", "once per item, in source order", "every item is visited", "a callback Err is the whole result; no partial output", "eager receivers buffer the output; iterators buffer nothing"),
    collection_law(CollectionLaw.Each, "eager", "Unit", "once per item, in source order", "every item is visited", "none", "none"),
    collection_law(CollectionLaw.Decide, "eager", "a Bool, Option or position", "once per item, in source order, until the answer is known", "the deciding item is consumed; later items are never read and an iterator receiver is dropped", "none", "none"),
    collection_law(CollectionLaw.Stream, "lazy", "an iterator", "once per pulled item, in source order", "the item that ends take_while is consumed and not yielded", "none", "the current item or group"),
    collection_law(CollectionLaw.Fold, "eager", "the accumulator or chosen item; the seed or None when empty", "once per item, in source order", "every item is read; equal keys keep the last item", "none", "none"),
    collection_law(CollectionLaw.Group, "eager", "a fresh map, tuple or lists", "once per item, in source order, when a key callback is given", "every item is read", "none", "every item is buffered into the output"),
    collection_law(CollectionLaw.Drain, "eager", "a fresh value", "none", "the whole source is consumed", "none", "the output"),
    collection_law(CollectionLaw.Reorder, "eager: the whole source is read before the first result", "the reordered or trimmed items", "none", "the whole source is consumed", "none", "the whole source"),
    collection_law(CollectionLaw.SortBy, "eager, in place", "Unit, or a Result when the key callback can fail", "key or comparator calls in the sort's order; count and order are unspecified", "not applicable", "the first callback Err is the result", "the list and its keys"),
    collection_law(CollectionLaw.Search, "eager", "an optional index", "once per probed item, in binary-search order", "stops at the match", "absence is None", "none"),
    collection_law(CollectionLaw.MergeEntries, "eager", "a fresh map", "once per key present in both maps", "every entry is read", "none", "the output map"),
    collection_law(CollectionLaw.Pull, "one item per call", "an Option of the next item", "none", "exactly the returned item is consumed; the remainder stays in the source", "end is None", "none")
} }
// END COLLECTION LAWS

// BEGIN COLLECTION OPERATIONS
