    collection_op(CollectionReceivers.Set, "map", 1, 1, CollectionAccess.Read, [CollectionArg]{CollectionArg.ItemFn}, CollectionResult.ListMapped, CollectionOp.SetMap, CollectionLaw.Visit, "empty list"),
    collection_op(CollectionReceivers.Set, "filter", 1, 1, CollectionAccess.Read, [CollectionArg]{CollectionArg.ItemFn}, CollectionResult.ListFiltered, CollectionOp.SetFilter, CollectionLaw.Visit, "empty list"),
