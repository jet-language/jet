    {receivers: CollectionReceivers.Set, name: "remove", minimum_arity: 1, maximum_arity: 1, access: CollectionAccess.Write, args: [CollectionArg]{CollectionArg.Element}, result: CollectionResult.Unit, op: CollectionOp.Builtin{op: TBuiltinOp.SetRemove}, law: CollectionLaw.Mutate, empty: "Unit", status: CollectionStatus.Current},
    {receivers: CollectionReceivers.Set, name: "discard", minimum_arity: 1, maximum_arity: 1, access: CollectionAccess.Write, args: [CollectionArg]{CollectionArg.Element}, result: CollectionResult.Unit, op: CollectionOp.Builtin{op: TBuiltinOp.SetRemove}, law: CollectionLaw.Mutate, empty: "Unit", status: CollectionStatus.Current},
    {receivers: CollectionReceivers.Set, name: "has", minimum_arity: 1, maximum_arity: 1, access: CollectionAccess.Read, args: [CollectionArg]{CollectionArg.Element}, result: CollectionResult.Bool, op: CollectionOp.Builtin{op: TBuiltinOp.Contains}, law: CollectionLaw.Measure, empty: "false", status: CollectionStatus.Current},
    {receivers: CollectionReceivers.Set, name: "pop", minimum_arity: 1, maximum_arity: 1, access: CollectionAccess.Write, args: [CollectionArg]{CollectionArg.Element}, result: CollectionResult.OptionElement, op: CollectionOp.Builtin{op: TBuiltinOp.SetPop}, law: CollectionLaw.Mutate, empty: "None", status: CollectionStatus.Current},
    {receivers: CollectionReceivers.Set, name: "take", minimum_arity: 1, maximum_arity: 1, access: CollectionAccess.Write, args: [CollectionArg]{CollectionArg.Element}, result: CollectionResult.OptionElement, op: CollectionOp.Builtin{op: TBuiltinOp.SetPop}, law: CollectionLaw.Mutate, empty: "None", status: CollectionStatus.Current},
