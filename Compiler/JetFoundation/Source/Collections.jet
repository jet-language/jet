    collection_op(CollectionReceivers.Set, "union", 1, 1, CollectionAccess.Read, [CollectionArg]{CollectionArg.SameKind}, CollectionResult.SameKind, CollectionOp.Builtin{op: TBuiltinOp.SetUnion}, CollectionLaw.Build, "the argument"),
