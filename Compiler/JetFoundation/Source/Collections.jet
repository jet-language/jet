    collection_op(CollectionReceivers.Set, "fold", 2, 2, CollectionAccess.Read, [CollectionArg]{CollectionArg.Seed, CollectionArg.Accumulator}, CollectionResult.Folded, CollectionOp.SetClosure{op: TClosureOp.Fold}, CollectionLaw.Fold, "the seed"),
