    pub fn new(^interrupt: String, ^handler: String, ^effects: EffectSet, bounded: Bool) -> TargetInterruptHandlerFact Never! {
        TargetInterruptHandlerFact{interrupt: ^interrupt, handler: ^handler, effects: ^effects, forbidden_effects: EffectSet.new(), bounded: bounded}
    }
}

