    // Rust: crates/jet-foundation/src/TargetMachine.rs:1071
    pub fn provider_identity(self) -> String Never! {
        bytes := [U8]{}
        append_identity_frame(&bytes, "environment", self.environment_identity())
        append_identity_frame(&bytes, "linker", self.linker.audit_json())
        append_identity_frame(&bytes, "allocator", self.allocator.audit_json())
        append_identity_frame(&bytes, "panic", self.panic.audit_json())
        append_identity_frame(&bytes, "memory", memory_json(self.memory))
        append_identity_frame(&bytes, "mmio", self.mmio.audit_json())
        append_identity_frame(&bytes, "time_wall", self.wall_clock.audit_json())
        append_identity_frame(&bytes, "time_monotonic", self.monotonic_clock.audit_json())
        append_identity_frame(&bytes, "time_zone_data", self.zone_data.audit_json())
        append_identity_frame(&bytes, "time_sleep", self.sleep.audit_json())
        append_identity_frame(&bytes, "entropy", self.entropy.audit_json())
        append_identity_frame(&bytes, "scheduler", self.scheduler.audit_json())
        append_identity_frame(&bytes, "byte_sink", self.byte_sink.audit_json())
        append_identity_frame(&bytes, "startup", self.startup.audit_json())
        append_identity_frame(&bytes, "provider_facts", self.provider_facts_json())
        append_identity_frame(&bytes, "hardware", self.hardware.audit_json())
        append_identity_frame(&bytes, "programmers", self.programmer_facts_json())
        append_identity_frame(&bytes, "layout_facts", self.layout.cache_identity())
        "target-providers-v1:{sha256_hex(bytes)}"
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:1103
    pub fn linker_identity(self) -> String Never! {
        if self.linker == .Generated {
            script :: self.generate_linker_script() catch { _ -> return self.linker.identity() }
            return "linker-generated-v2:{sha256_hex(script.bytes())}"
        }
        self.linker.identity()
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:1122
    pub fn target_dossier(self, usage: TargetMachineUse, tier: ExecutionTier, compiler_identity: String, dependency_identity: String) -> TargetDossier Never! {
        closure :: classify_prelude_closure(usage.core_apis)
        closure_bytes := [U8]{}
        loop (api, layer) in closure {
            append_identity_frame(&closure_bytes, "api", api)
            append_identity_frame(&closure_bytes, "layer", layer.as_str())
        }
        TargetDossier{machine: Val(~self), layer: self.max_runtime_layer(), provider_identity: self.provider_identity(), closure_identity: "prelude-closure-v1:{sha256_hex(closure_bytes)}", linker_identity: self.linker_identity(), tier_identity: tier.as_str(), compiler_identity: ~compiler_identity, environment_identity: self.environment_identity(), dependency_identity: ~dependency_identity}
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:1152
    pub fn max_runtime_layer(self) -> RuntimeLayer Never! {
        if !self.no_os -> .Std else if self.allocator.provides_heap() -> .Alloc else -> .Core
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:1164
    pub fn provides_capability(self, capability: TargetCapability) -> Bool Never! {
        hosted :: self.environment_identity() == "hosted"
        if capability == {
            .Allocator -> if self.allocator == {
                .HostedDefault | .Counting(_) -> hosted
                .Provider(_) | .Fixed(_, _) -> true
                .Unspecified | .None -> false
            }
            .Atomic64 -> self.supports_atomic_word()
            .Mmio -> self.mmio.provides(hosted)
            .Hardware -> !self.hardware.register_blocks.is_empty() || !self.hardware.interrupts.is_empty() || !self.hardware.dma_channels.is_empty()
            .TimeWall -> self.wall_clock.provides(hosted)
            .TimeMonotonic -> self.monotonic_clock.provides(hosted)
            .TimeZoneData -> self.zone_data.provides(hosted)
            .TimeSleep -> self.sleep.provides(hosted)
            .Entropy -> self.entropy.provides(hosted)
            .Scheduler -> self.scheduler.provides(hosted)
            .IoRead -> self.byte_sink.provides_read(hosted)
            .IoWrite -> self.byte_sink.provides_write(hosted)
            .PanicReport -> self.byte_sink.provides_report(hosted)
            .Startup -> self.startup.provides(hosted)
        }
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:1193
    pub fn validate(self, usage: TargetMachineUse) -> [TargetMachineError] Never! {
        errors := [TargetMachineError]{}
        if self.triple.trim().is_empty() -> &errors.push(TargetMachineError.MissingTargetTriple)
        validate_memory_regions(self.memory, &errors)
        validate_linker(self.linker, self.no_os, &errors)
        validate_allocator(self, &errors)
        validate_panic(self, &errors)
        validate_ram_budget(self, usage, &errors)
        validate_core_usage(self, usage, &errors)
        validate_target_capabilities(self, usage, &errors)
        validate_startup_facts(self, &errors)
        validate_mmio(self, usage, &errors)
        &errors.extend(self.hardware.validate(self.memory))
        ^errors
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:1217
    pub fn validate_hardware(self, usage: TargetHardwareUse) -> [TargetMachineError] Never! {
        errors := self.hardware.validate(self.memory)
        loop reference in usage.unresolved_references {
            if reference == {
                .RegisterBlock(block) -> &errors.push(TargetMachineError.UnknownRegisterBlock{block: ~block})
                .Register(block, register) -> &errors.push(TargetMachineError.UnknownRegister{block: ~block, register: ~register})
                .DmaChannel(channel) -> &errors.push(TargetMachineError.UnknownDmaChannel{channel: ~channel})
                .Interrupt(interrupt) -> &errors.push(TargetMachineError.UnknownInterrupt{interrupt: ~interrupt})
            }
        }
        self.hardware.validate_register_accesses(usage.register_accesses, &errors)
        ^errors
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:1251
    pub fn audit_value(self, usage: TargetMachineUse) -> StatusValue Never! {
        dossier :: self.target_dossier(usage, .Aot, "unspecified", "unspecified")
        StatusValue.object(StatusFields.new()
            .with("name", self.name)
            .with("triple", self.triple)
            .with("environment", self.environment_identity())
            .with("provider_identity", self.provider_identity())
            .with("linker", linker_value(self.linker))
            .with("allocator", allocator_value(self.allocator))
            .with("panic", panic_value(self.panic))
            .with("memory", memory_value(self.memory))
            .with("mmio_capability", mmio_policy_value(self.mmio))
            .with("time_wall", clock_value(self.wall_clock))
            .with("time_monotonic", clock_value(self.monotonic_clock))
            .with("time_zone_data", clock_value(self.zone_data))
            .with("time_sleep", clock_value(self.sleep))
            .with("entropy", entropy_value(self.entropy))
            .with("scheduler", scheduler_value(self.scheduler))
            .with("byte_sink", byte_sink_value(self.byte_sink))
            .with("startup", startup_value(self.startup))
            .with("provider_facts", provider_facts_value(self))
            .with("hardware", hardware_value(self.hardware))
            .with("programmers", programmers_value(self.programmers))
            .with("target_dossier", target_dossier_value(dossier, self.triple))
            .with("unavailable_core_apis", unavailable_core_value(self, usage))
            .with("mmio", mmio_value(usage.mmio))
            .with("execution", StatusValue.object(StatusFields.new().with("aot", true).with("dev", !self.no_os).with("jit", !self.no_os))))
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:1290
    pub fn audit_json(self, usage: TargetMachineUse) -> String Never! { self.audit_json_with_budget(usage, None) }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:1294
    pub fn audit_json_with_budget(self, usage: TargetMachineUse, budget: SizeBudgetReport?) -> String Never! {
        out := "{"
        push_field(&out, "name", json_str(self.name), true)
        push_field(&out, "triple", json_str(self.triple), false)
        push_field(&out, "environment", json_str(self.environment_identity()), false)
        push_field(&out, "provider_identity", json_str(self.provider_identity()), false)
        push_field(&out, "linker", self.linker.audit_json(), false)
        push_field(&out, "allocator", self.allocator.audit_json(), false)
        push_field(&out, "panic", self.panic.audit_json(), false)
        push_field(&out, "memory", memory_json(self.memory), false)
        push_field(&out, "mmio_capability", self.mmio.audit_json(), false)
        push_field(&out, "time_wall", self.wall_clock.audit_json(), false)
        push_field(&out, "time_monotonic", self.monotonic_clock.audit_json(), false)
        push_field(&out, "time_zone_data", self.zone_data.audit_json(), false)
        push_field(&out, "time_sleep", self.sleep.audit_json(), false)
        push_field(&out, "entropy", self.entropy.audit_json(), false)
        push_field(&out, "scheduler", self.scheduler.audit_json(), false)
        push_field(&out, "byte_sink", self.byte_sink.audit_json(), false)
        push_field(&out, "startup", self.startup.audit_json(), false)
        push_field(&out, "provider_facts", self.provider_facts_json(), false)
        push_field(&out, "hardware", self.hardware.audit_json(), false)
        push_field(&out, "programmers", self.programmer_facts_json(), false)
        dossier :: self.target_dossier(usage, .Aot, "unspecified", "unspecified")
        push_field(&out, "target_dossier", target_dossier_json(dossier, self.triple), false)
        push_field(&out, "unavailable_core_apis", unavailable_core_json(self, usage), false)
        push_field(&out, "mmio", mmio_json(usage.mmio), false)
        push_field(&out, "execution", execution_json(self), false)
        if budget == .Val(value) -> push_field(&out, "size_budget", value.to_json(), false)
        out += "}"
        ^out
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:1363
    pub fn generate_linker_script(self) -> String TargetMachineError! {
        if !self.no_os -> return Err(TargetMachineError.HostedHasNoLinkerScript)
        flash :: self.memory.find(|region| region.kind == .Flash) ?? return Err(TargetMachineError.MissingMemoryKind{kind: .Flash})
        ram :: self.memory.find(|region| region.kind == .Ram) ?? return Err(TargetMachineError.MissingMemoryKind{kind: .Ram})
        out := "/* generated by Jet target machine */\nMEMORY {\n"
        loop region in self.memory {
            attrs :: if region.kind == { .Flash -> "rx" .Ram -> "rwx" .Mmio -> "rw" .Reserved -> "r" }
            out += "  {region.name} ({attrs}) : ORIGIN = 0x{region.origin:08X}, LENGTH = {format_length(region.size.bytes)}\n"
        }
        out += "}\nENTRY({self.startup_entry})\nSECTIONS {{\n"
        out += "  .text : {{\n    KEEP(*({self.startup_placement}))\n    *(.text*)\n    *(.rodata*)\n  }} > {flash.name}\n"
        out += "  .data : ALIGN(4) {{\n    __jet_data_start = .;\n    *(.data*)\n    __jet_data_end = .;\n  }} > {ram.name} AT > {flash.name}\n  __jet_data_load = LOADADDR(.data);\n"
        out += "  .bss (NOLOAD) : ALIGN(4) {{\n    __jet_bss_start = .;\n    *(.bss*)\n    *(COMMON)\n    __jet_bss_end = .;\n  }} > {ram.name}\n"
        out += "  __jet_stack_top = ORIGIN({ram.name}) + LENGTH({ram.name});\n"
        if self.allocator == {
            .Fixed(region, size) -> out += "  __jet_heap_start = ORIGIN({region});\n  __jet_heap_end = ORIGIN({region}) + {size.bytes};\n"
            .Provider(_) -> out += "  __jet_heap_start = __jet_bss_end;\n  __jet_heap_end = ORIGIN({ram.name}) + LENGTH({ram.name});\n"
            .None | .Unspecified | .HostedDefault | .Counting(_) -> out += "  __jet_heap_start = __jet_bss_end;\n  __jet_heap_end = __jet_bss_end;\n"
        }
        out += "}\n"
        ^out
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:1453
    pub fn generate_startup_source(self) -> StartupSource TargetMachineError! {
        if !self.no_os -> return Err(TargetMachineError.HostedHasNoStartup)
        name :: self.name
        abi :: self.startup_abi.calling_convention
        abi_version :: self.startup_abi.version
        entry :: self.startup_entry
        vectors :: self.startup_vectors
        placement :: self.startup_placement
        if self.triple.contains("thumb") || self.triple.starts_with("arm") {
            _ :: self.memory.find(|region| region.kind == .Ram) ?? return Err(TargetMachineError.MissingMemoryKind{kind: .Ram})
            contents := "/* generated by Jet target machine `{name}` */\n/* ABI: {abi} {abi_version} */\n"
            contents += "typedef void (*vec_t)(void);\ntypedef __UINTPTR_TYPE__ uintptr_t;\ntypedef __UINT32_TYPE__ uint32_t;\n"
            contents += "extern unsigned char __jet_stack_top;\nextern unsigned char __jet_data_load;\nextern unsigned char __jet_data_start;\nextern unsigned char __jet_data_end;\nextern unsigned char __jet_bss_start;\nextern unsigned char __jet_bss_end;\n"
            contents += "#if defined(__ARM_FP) && (__ARM_FP != 0)\nstatic void __jet_enable_fpu(void) {{\n  volatile uint32_t *cpacr = (volatile uint32_t *)(uintptr_t)0xE000ED88u;\n  *cpacr |= (uint32_t)(0xFu << 20);\n  __asm__ volatile (\"dsb\" ::: \"memory\");\n  __asm__ volatile (\"isb\" ::: \"memory\");\n}}\n#else\nstatic void __jet_enable_fpu(void) {{}}\n#endif\n"
            contents += "void __jet_target_init(void);\nvoid __jet_program_entry(void);\nvoid {entry}(void);\nvoid SysTick_Handler(void);\nvoid Default_Handler(void) {{ for (;;) {{ __asm__ volatile (\"wfi\"); }} }}\n"
            contents += "__attribute__((section(\"{placement}\"), used, aligned(128)))\nvec_t const {vectors}[] = {{\n  (vec_t)&__jet_stack_top,\n  (vec_t){entry},\n  (vec_t)Default_Handler,\n  (vec_t)Default_Handler,\n  (vec_t)Default_Handler,\n  (vec_t)Default_Handler,\n  (vec_t)Default_Handler,\n  (vec_t)0,\n  (vec_t)0,\n  (vec_t)0,\n  (vec_t)0,\n  (vec_t)Default_Handler,\n  (vec_t)Default_Handler,\n  (vec_t)0,\n  (vec_t)Default_Handler,\n  (vec_t)SysTick_Handler\n}};\n"
            contents += "void {entry}(void) {{\n  unsigned char *src = &__jet_data_load;\n  unsigned char *dst = &__jet_data_start;\n  while (dst < &__jet_data_end) {{ *dst++ = *src++; }}\n  dst = &__jet_bss_start;\n  while (dst < &__jet_bss_end) {{ *dst++ = 0; }}\n  __jet_enable_fpu();\n  __jet_target_init();\n  __jet_program_entry();\n  for (;;) {{ __asm__ volatile (\"wfi\"); }}\n}}\n"
            return StartupSource{filename: "startup.c", contents: ^contents}
        } else if self.triple.contains("aarch64") {
            contents := "/* generated by Jet target machine `{name}` */\n/* ABI: {abi} {abi_version}; placement: {placement} */\n.text\n.global {entry}\n.type {entry}, %function\n"
            contents += ".extern __jet_target_init\n.extern __jet_program_entry\n.extern __jet_stack_top\n.extern __jet_data_load\n.extern __jet_data_start\n.extern __jet_data_end\n.extern __jet_bss_start\n.extern __jet_bss_end\n"
            contents += "{entry}:\n  ldr x0, =__jet_stack_top\n  mov sp, x0\n  ldr x0, =__jet_data_load\n  ldr x1, =__jet_data_start\n  ldr x2, =__jet_data_end\n1:\n  cmp x1, x2\n  b.hs 2f\n  ldrb w3, [x0], #1\n  strb w3, [x1], #1\n  b 1b\n2:\n  ldr x1, =__jet_bss_start\n  ldr x2, =__jet_bss_end\n3:\n  cmp x1, x2\n  b.hs 4f\n  strb wzr, [x1], #1\n  b 3b\n4:\n  bl __jet_target_init\n  bl __jet_program_entry\n5: wfe\n  b 5b\n.size {entry}, .-{entry}\n"
            return StartupSource{filename: "startup.S", contents: ^contents}
        }
        Err(TargetMachineError.UnsupportedStartupTriple{triple: ~self.triple})
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:1595
    pub fn generate_provider_source(self) -> TargetProviderSource TargetMachineError! {
        if !self.no_os -> return Err(TargetMachineError.FirmwareBuildFailed{detail: "hosted targets do not emit portable target adapters"})
        contents :: if self.name == {
            "board.sensor_v1" -> {
                uart :: self.hardware.register_blocks.find(|block| block.name == "UART0") ?? return Err(TargetMachineError.FirmwareBuildFailed{detail: "board.sensor_v1 requires UART0 hardware facts"})
                register_address :: |name: String| -> U64? {
                    register :: uart.register(name) ?? return None
                    Val(uart.base.saturating_add(register.offset))
                }
                data :: register_address("data") ?? return Err(TargetMachineError.FirmwareBuildFailed{detail: "board.sensor_v1 requires UART0.data hardware fact"})
                state :: register_address("state") ?? return Err(TargetMachineError.FirmwareBuildFailed{detail: "board.sensor_v1 requires UART0.state hardware fact"})
                ctrl :: register_address("ctrl") ?? return Err(TargetMachineError.FirmwareBuildFailed{detail: "board.sensor_v1 requires UART0.ctrl hardware fact"})
                bauddiv :: register_address("bauddiv") ?? return Err(TargetMachineError.FirmwareBuildFailed{detail: "board.sensor_v1 requires UART0.bauddiv hardware fact"})
                systick :: U64{0xE000_E018}
                sensor_provider_source_contents(ctrl, state, data, bauddiv, systick)
            }
            "board.virt_aarch64" -> {
                uart :: self.memory.find(|region| region.name == "uart0") ?? return Err(TargetMachineError.FirmwareBuildFailed{detail: "board.virt_aarch64 requires uart0 memory fact"})
                virt_provider_source_contents(uart.origin)
            }
            else -> return Err(TargetMachineError.FirmwareBuildFailed{detail: "no checked target adapter implementation for `{self.name}`"})
        }
        self.verify_provider_bindings(contents)!
        TargetProviderSource{filename: "target_providers.c", contents: ^contents}
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:1668
    fn verify_provider_bindings(self, source: String) TargetMachineError! {
        source_bytes :: source.bytes()
        check :: |capability: TargetCapability, provider: ProviderContract| TargetMachineError! {
            if !provider.provenance.starts_with("builtin:") || !provider.matches_source(source_bytes) -> return Err(TargetMachineError.InvalidProviderContract{capability: capability.as_str(), provider: ~provider.provider, sha256: ~provider.sha256})
        }
        if self.name == {
            "board.sensor_v1" -> {
                if self.mmio == .Provider(provider) -> check(.Mmio, provider)!
                if self.monotonic_clock == .Provider(provider) -> check(.TimeMonotonic, provider)!
                if self.sleep == .Provider(provider) -> check(.TimeSleep, provider)!
                if self.scheduler == .Cooperative(provider) -> check(.Scheduler, provider)!
                if self.panic.provider() == .Val(provider) -> check(.PanicReport, provider)!
                if self.byte_sink == .Provider(read, write, report) {
                    if read == .Val(provider) -> check(.IoRead, provider)!
                    if write == .Val(provider) -> check(.IoWrite, provider)!
                    if report == .Val(provider) -> check(.PanicReport, provider)!
                }
            }
            "board.virt_aarch64" -> {
                if self.mmio == .Provider(provider) -> check(.Mmio, provider)!
                if self.byte_sink == .Provider(_, write, report) {
                    if write == .Val(provider) -> check(.IoWrite, provider)!
                    if report == .Val(provider) -> check(.PanicReport, provider)!
                }
            }
            else -> panic("provider implementation matched above")
        }
        if self.startup == .Generated(provider) {
            startup :: self.generate_startup_source()!.contents
            if !provider.provenance.starts_with("builtin:") || !provider.matches_source(startup.bytes()) -> return Err(TargetMachineError.InvalidProviderContract{capability: TargetCapability.Startup.as_str(), provider: ~provider.provider, sha256: ~provider.sha256})
        }
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:1750
    pub fn size_budget(self, usage: TargetMachineUse, artifact_bytes: U64) -> SizeBudgetReport Never! {
        flash_bytes := U64{0}
        ram_bytes := U64{0}
        loop region in self.memory {
            if region.kind == .Flash -> flash_bytes += region.size.bytes
            if region.kind == .Ram -> ram_bytes += region.size.bytes
        }
        ram_used :: usage.stack_bytes.saturating_add(usage.static_ram_bytes).saturating_add(self.allocator.fixed_size())
        SizeBudgetReport{artifact_bytes: artifact_bytes, flash_bytes: flash_bytes, flash_ok: flash_bytes == U64{0} || artifact_bytes <= flash_bytes, ram_bytes: ram_bytes, ram_used_bytes: ram_used, ram_ok: ram_bytes == U64{0} || ram_used <= ram_bytes}
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:1778
    pub fn supports_execution_tier(self, tier: ExecutionTier) TargetMachineError! {
        if self.no_os && (tier == .Dev || tier == .Jit) -> return Err(TargetMachineError.ExecutionTierUnsupported{tier: tier.as_str(), machine: ~self.name})
    }
}
