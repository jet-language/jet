// Rust: crates/jet-foundation/src/TargetMachine.rs:410
pub struct TargetProgrammerFacts {
    pub adapter: TargetProgrammerAdapter
    pub executable: String
    pub chip: String?
    pub interface: String?
    pub config: [String]
    pub speed_khz: U32?
    pub reset: Bool
    pub machine: String?
    pub cpu: String?
    // Rust: crates/jet-foundation/src/TargetMachine.rs:423
    pub fn emulator(^executable: String, ^machine: String, ^cpu: String) -> TargetProgrammerFacts Never! {
        TargetProgrammerFacts{adapter: .Emulator, executable: ^executable, chip: None, interface: None, config: [], speed_khz: None, reset: false, machine: Val(^machine), cpu: Val(^cpu)}
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:441
    pub fn missing_fact(self) -> String? Never! {
        if self.executable.trim().is_empty() -> return Val("executable")
        loop value in self.config { if value.trim().is_empty() -> return Val("config") }
        if self.adapter == {
            .Emulator -> {
                machine :: self.machine ?? return Val("machine")
                if machine.trim().is_empty() -> return Val("machine")
                cpu :: self.cpu ?? return Val("cpu")
                if cpu.trim().is_empty() -> return Val("cpu")
            }
            .ProbeRs -> {
                chip :: self.chip ?? return Val("chip")
                if chip.trim().is_empty() -> return Val("chip")
            }
            .OpenOcd -> {
                has_interface :: if self.interface == .Val(value) -> !value.trim().is_empty() else -> false
                if !has_interface && self.config.is_empty() -> return Val("interface or config")
            }
        }
        None
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:485
    pub fn audit_json(self) -> String Never! {
        config := [String]{}
        loop value in self.config -> &config.push(json_str(value))
        chip :: if self.chip == .Val(value) -> json_str(value) else -> "null"
        cpu :: if self.cpu == .Val(value) -> json_str(value) else -> "null"
        interface :: if self.interface == .Val(value) -> json_str(value) else -> "null"
        machine :: if self.machine == .Val(value) -> json_str(value) else -> "null"
        speed :: if self.speed_khz == .Val(value) -> "{value}" else -> "null"
        "{{\"adapter\":{json_str(self.adapter.as_str())},\"chip\":{chip},\"config\":[{config.join(",")}],\"cpu\":{cpu},\"executable\":{json_str(self.executable)},\"interface\":{interface},\"machine\":{machine},\"reset\":{self.reset},\"speed_khz\":{speed}}}"
    }
}

// Rust: crates/jet-foundation/src/TargetMachine.rs:520
pub struct TargetHardwareFacts {
    pub svd: SvdProvenance?
    pub register_blocks: [TargetRegisterBlockFact]
    pub interrupts: [TargetInterruptFact]
    pub dma_channels: [TargetDmaChannelFact]
    pub fn default() -> TargetHardwareFacts Never! {
        TargetHardwareFacts{svd: None, register_blocks: [], interrupts: [], dma_channels: []}
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:527
    pub fn register_block(self, name: String) -> TargetRegisterBlockFact? from self {
        loop block in self.register_blocks { if block.name == name -> return Val(block) }
        None
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:533
    pub fn interrupt(self, selector: String) -> TargetInterruptFact? from self {
        loop interrupt in self.interrupts {
            if interrupt.name == selector || "{interrupt.vector}" == selector -> return Val(interrupt)
        }
        None
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:539
    pub fn dma_channel(self, name: String) -> TargetDmaChannelFact? from self {
        loop channel in self.dma_channels { if channel.name == name -> return Val(channel) }
        None
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:543
    pub fn validate(self, memory: [MemoryRegion]) -> [TargetMachineError] Never! {
        errors := [TargetMachineError]{}
        self.validate_into(memory, &errors)
        ^errors
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:549
    fn validate_into(self, memory: [MemoryRegion], errors: &[TargetMachineError]) Never! {
        if self.svd == .Val(svd) {
            if !svd.is_valid() -> &errors.push(TargetMachineError.InvalidHardwareSvd{source: ~svd.source, sha256: ~svd.sha256})
        }
        block_names := [String: Bool]{}
        loop block in self.register_blocks {
            if block.name.trim().is_empty() -> &errors.push(TargetMachineError.HardwareFactEmptyName{kind: "register block"})
            if block_names.contains_key(block.name) -> &errors.push(TargetMachineError.DuplicateRegisterBlock{name: ~block.name})
            &block_names.insert(~block.name, true)
            if block.size.bytes == U64{0} -> &errors.push(TargetMachineError.RegisterBlockEmpty{name: ~block.name})
            if block.base.checked_add(block.size.bytes) == None {
                &errors.push(TargetMachineError.RegisterBlockAddressOverflow{name: ~block.name})
            } else {
                inside := false
                loop region in memory {
                    if region.kind == .Mmio && region.contains(block.base, block.size) { inside = true; break }
                }
                if !inside -> &errors.push(TargetMachineError.RegisterBlockOutsideRegion{name: ~block.name, address: block.base, size_bytes: block.size.bytes})
            }
            register_names := [String: Bool]{}
            loop register in block.registers {
                if register.name.trim().is_empty() -> &errors.push(TargetMachineError.HardwareFactEmptyName{kind: "register in `{block.name}`"})
                if register_names.contains_key(register.name) -> &errors.push(TargetMachineError.DuplicateRegister{block: ~block.name, register: ~register.name})
                &register_names.insert(~register.name, true)
                if register.offset.checked_add(register.width.bytes()) == None {
                    &errors.push(TargetMachineError.RegisterAddressOverflow{block: ~block.name, register: ~register.name})
                } else if register.offset.saturating_add(register.width.bytes()) > block.size.bytes {
                    &errors.push(TargetMachineError.RegisterOutsideBlock{block: ~block.name, register: ~register.name})
                }
            }
        }
        vectors := [U16: Bool]{}
        interrupt_names := [String: Bool]{}
        loop interrupt in self.interrupts {
            if interrupt.name.trim().is_empty() -> &errors.push(TargetMachineError.HardwareFactEmptyName{kind: "interrupt"})
            if interrupt_names.contains_key(interrupt.name) -> &errors.push(TargetMachineError.DuplicateInterrupt{name: ~interrupt.name})
            &interrupt_names.insert(~interrupt.name, true)
            if vectors.contains_key(interrupt.vector) -> &errors.push(TargetMachineError.DuplicateInterruptVector{vector: interrupt.vector})
            &vectors.insert(interrupt.vector, true)
            loop effect in interrupt.forbidden_effects {
                if parse_right(effect) == None -> &errors.push(TargetMachineError.InvalidInterruptEffect{interrupt: ~interrupt.name, effect: ~effect})
            }
        }
        channels := [String: Bool]{}
        channel_numbers := [U16: Bool]{}
        loop channel in self.dma_channels {
            if channel.name.trim().is_empty() -> &errors.push(TargetMachineError.HardwareFactEmptyName{kind: "DMA channel"})
            if channels.contains_key(channel.name) -> &errors.push(TargetMachineError.DuplicateDmaChannel{name: ~channel.name})
            &channels.insert(~channel.name, true)
            if channel_numbers.contains_key(channel.channel) -> &errors.push(TargetMachineError.DuplicateDmaChannelNumber{channel: channel.channel})
            &channel_numbers.insert(channel.channel, true)
            if channel.max_transfer_bytes == Val(U64{0}) -> &errors.push(TargetMachineError.DmaTransferSizeZero{channel: ~channel.name})
        }
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:672
    fn validate_register_accesses(self, accesses: [TargetRegisterAccessFact], errors: &[TargetMachineError]) Never! {
        loop access in accesses {
            block :: self.register_block(access.block) ?? {
                &errors.push(TargetMachineError.UnknownRegisterBlock{block: ~access.block})
                continue
            }
            register :: block.register(access.register) ?? {
                &errors.push(TargetMachineError.UnknownRegister{block: ~access.block, register: ~access.register})
                continue
            }
            if register.width != access.width -> &errors.push(TargetMachineError.RegisterWidthMismatch{block: ~access.block, register: ~access.register, expected: register.width, actual: access.width})
            if access.operation == {
                .Read -> { if !register.access.can_read() -> &errors.push(TargetMachineError.RegisterReadDenied{block: ~access.block, register: ~access.register}) }
                .Write -> { if !register.access.can_write() -> &errors.push(TargetMachineError.RegisterWriteDenied{block: ~access.block, register: ~access.register}) }
            }
        }
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:717
    pub fn audit_json(self) -> String Never! {
        svd :: if self.svd == .Val(value) -> value.audit_json() else -> "null"
        out := "{{\"svd\":{svd},\"register_blocks\":["
        loop index in 0..<self.register_blocks.len() {
            if index > 0 -> out += ","
            block :: self.register_blocks[index]
            out += "{{\"name\":{json_str(block.name)},\"base\":{block.base},\"size_bytes\":{block.size.bytes},\"registers\":["
            loop register_index in 0..<block.registers.len() {
                if register_index > 0 -> out += ","
                register :: block.registers[register_index]
                out += "{{\"name\":{json_str(register.name)},\"offset\":{register.offset},\"width\":\"{register.width.as_str()}\",\"access\":\"{register.access.as_str()}\",\"volatile\":{register.volatile}}}"
            }
            out += "]}"
        }
        out += "],\"interrupts\":["
        loop index in 0..<self.interrupts.len() {
            if index > 0 -> out += ","
            interrupt :: self.interrupts[index]
            effects := [String]{}
            effect_keys := interrupt.forbidden_effects.keys()
            &effect_keys.sort()
            loop effect in effect_keys -> &effects.push(json_str(effect))
            out += "{{\"name\":{json_str(interrupt.name)},\"vector\":{interrupt.vector},\"forbidden_effects\":[{effects.join(",")}],\"bounded\":{interrupt.bounded}}}"
        }
        out += "],\"dma_channels\":["
        loop index in 0..<self.dma_channels.len() {
            if index > 0 -> out += ","
            channel :: self.dma_channels[index]
            maximum :: if channel.max_transfer_bytes == .Val(value) -> "{value}" else -> "null"
            out += "{{\"name\":{json_str(channel.name)},\"channel\":{channel.channel},\"transfer_width\":\"{channel.transfer_width.as_str()}\",\"ownership\":\"{channel.ownership.as_str()}\",\"max_transfer_bytes\":{maximum}}}"
        }
        out += "]}"
        ^out
    }
}

