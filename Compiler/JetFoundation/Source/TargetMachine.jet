// Rust: crates/jet-foundation/src/TargetMachine.rs:18
pub struct SvdProvenance {
    pub source: String
    pub sha256: String
    // Rust: crates/jet-foundation/src/TargetMachine.rs:24
    pub fn new(^source: String, ^sha256: String) -> SvdProvenance Never! {
        SvdProvenance{source: ^source, sha256: ^sha256}
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:31
    pub fn from_source(^source: String, contents: [U8]) -> SvdProvenance Never! {
        SvdProvenance.new(^source, "sha256:{sha256_hex(contents)}")
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:38
    pub fn is_valid(self) -> Bool Never! {
        digest :: self.sha256.strip_prefix("sha256:") ?? return false
        !self.source.trim().is_empty() && !digest.trim().is_empty()
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:46
    fn audit_json(self) -> String Never! {
        "{{\"source\":{json_str(self.source)},\"sha256\":{json_str(self.sha256)}}}"
    }
}

// Rust: crates/jet-foundation/src/TargetMachine.rs:57
pub enum RegisterWidth {
    U8
    U16
    U32
    U64
    // Rust: crates/jet-foundation/src/TargetMachine.rs:66
    pub fn bytes(self) -> U64 Never! {
        if self == { .U8 -> U64{1} .U16 -> U64{2} .U32 -> U64{4} .U64 -> U64{8} }
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:75
    pub fn bits(self) -> U16 Never! { U16{self.bytes() * U64{8}} }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:79
    pub fn as_str(self) -> String Never! {
        if self == { .U8 -> "u8" .U16 -> "u16" .U32 -> "u32" .U64 -> "u64" }
    }
}

// Rust: crates/jet-foundation/src/TargetMachine.rs:91
pub enum TargetRegisterAccessMode {
    ReadOnly
    WriteOnly
    ReadWrite
    // Rust: crates/jet-foundation/src/TargetMachine.rs:99
    pub fn can_read(self) -> Bool Never! { self == .ReadOnly || self == .ReadWrite }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:103
    pub fn can_write(self) -> Bool Never! { self == .WriteOnly || self == .ReadWrite }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:107
    pub fn as_str(self) -> String Never! {
        if self == { .ReadOnly -> "read-only" .WriteOnly -> "write-only" .ReadWrite -> "read-write" }
    }
}

