// Rust: crates/jet-foundation/src/TargetMachine.rs:819
pub struct TargetMachine {
    pub name: String
    pub triple: String
    pub layout: LayoutCapabilityFacts
    pub no_os: Bool
    pub memory: [MemoryRegion]
    pub linker: LinkerInput
    pub allocator: AllocatorPolicy
    pub panic: PanicPolicy
    pub mmio: MmioPolicy
    pub wall_clock: ClockPolicy
    pub monotonic_clock: ClockPolicy
    pub zone_data: ClockPolicy
    pub sleep: ClockPolicy
    pub entropy: EntropyPolicy
    pub scheduler: SchedulerPolicy
    pub byte_sink: ByteSinkPolicy
    pub startup: StartupPolicy
    pub startup_entry: String
    pub startup_vectors: String
    pub startup_abi: ProviderAbi
    pub startup_placement: String
    pub hardware: TargetHardwareFacts
    pub programmers: [TargetProgrammerFacts]
    pub audit: AuditPolicy
    // Rust: crates/jet-foundation/src/TargetMachine.rs:858
    pub fn hosted(^triple: String) -> TargetMachine Never! {
        layout :: TargetLayout.from_triple(triple).layout_facts
        TargetMachine{name: "hosted", triple: ^triple, layout: layout, no_os: false, memory: [], linker: .HostedDefault, allocator: .HostedDefault, panic: .HostedDefault, mmio: .HostedDefault, wall_clock: .HostedDefault, monotonic_clock: .HostedDefault, zone_data: .HostedDefault, sleep: .HostedDefault, entropy: .HostedDefault, scheduler: .HostedDefault, byte_sink: .HostedDefault, startup: .HostedDefault, startup_entry: "", startup_vectors: "", startup_abi: ProviderAbi.default(), startup_placement: "", hardware: TargetHardwareFacts.default(), programmers: [], audit: AuditPolicy.default()}
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:889
    pub fn bare_metal(^name: String, ^triple: String) -> TargetMachine Never! {
        layout :: TargetLayout.from_triple(triple).layout_facts
        TargetMachine{name: ^name, triple: ^triple, layout: layout, no_os: true, memory: [], linker: .Generated, allocator: .Unspecified, panic: .Unspecified, mmio: .Unspecified, wall_clock: .Unspecified, monotonic_clock: .Unspecified, zone_data: .Unspecified, sleep: .Unspecified, entropy: .Unspecified, scheduler: .Unspecified, byte_sink: .Unspecified, startup: .Unspecified, startup_entry: "Reset_Handler", startup_vectors: "vectors", startup_abi: ProviderAbi.c(), startup_placement: ".vectors", hardware: TargetHardwareFacts.default(), programmers: [], audit: AuditPolicy.default()}
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:922
    pub fn with_startup_facts(^self, ^entry: String, ^vectors: String, abi: ProviderAbi, ^placement: String) -> TargetMachine Never! {
        machine := ^self
        machine.startup_entry = ^entry
        machine.startup_vectors = ^vectors
        machine.startup_abi = abi
        machine.startup_placement = ^placement
        ^machine
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:938
    pub fn with_programmer(^self, ^programmer: TargetProgrammerFacts) -> TargetMachine Err! {
        if programmer.missing_fact() == .Val(missing) -> return Err("target programmer `{programmer.adapter.as_str()}` is missing explicit `{missing}` fact")
        machine := ^self
        &machine.programmers.push(^programmer)
        ^machine
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:952
    pub fn environment_identity(self) -> String Never! {
        if self.no_os -> "no-os"
        else if self.triple.contains("wasip") -> "wasi"
        else if self.triple == "wasm32-unknown-unknown" -> "browser"
        else -> "hosted"
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:969
    pub fn is_browser_target(self) -> Bool Never! { self.environment_identity() == "browser" && !self.no_os }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:974
    pub fn is_wasi_target(self) -> Bool Never! { self.environment_identity() == "wasi" && !self.no_os }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:980
    pub fn is_web_target(self) -> Bool Never! { self.is_browser_target() }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:987
    pub fn supports_atomic_word(self) -> Bool Never! {
        // GATE #4483: selected target triple, never the compiler host.
        self.triple.starts_with("x86_64-") || self.triple.starts_with("aarch64-") || self.triple.starts_with("wasm32-")
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:997
    pub fn provider_fact_list(self) -> [(TargetCapability, String)] Never! {
        facts := [(TargetCapability, String)]{}
        loop capability in TargetCapability.ALL {
            fact :: if capability == {
                .Allocator -> self.allocator.audit_json()
                .Atomic64 -> "{{\"triple\":{json_str(self.triple)},\"supported\":{self.supports_atomic_word()}}}"
                .Mmio -> self.mmio.audit_json()
                .Hardware -> self.hardware.audit_json()
                .TimeWall -> self.wall_clock.audit_json()
                .TimeMonotonic -> self.monotonic_clock.audit_json()
                .TimeZoneData -> self.zone_data.audit_json()
                .TimeSleep -> self.sleep.audit_json()
                .Entropy -> self.entropy.audit_json()
                .Scheduler -> self.scheduler.audit_json()
                .IoRead -> self.byte_sink.audit_component_json(.IoRead)
                .IoWrite -> self.byte_sink.audit_component_json(.IoWrite)
                .PanicReport -> "{{\"panic\":{self.panic.audit_json()},\"sink\":{self.byte_sink.audit_component_json(.PanicReport)}}}"
                .Startup -> "{{\"policy\":{self.startup.audit_json()},\"entry\":{json_str(self.startup_entry)},\"vectors\":{json_str(self.startup_vectors)},\"abi\":{self.startup_abi.audit_json()},\"placement\":{json_str(self.startup_placement)}}}"
            }
            &facts.push((capability, ^fact))
        }
        ^facts
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:1042
    fn provider_facts_json(self) -> String Never! {
        out := "["
        facts :: self.provider_fact_list()
        loop index in 0..<facts.len() {
            if index > 0 -> out += ","
            (capability, fact) :: facts[index]
            out += "{{\"capability\":{json_str(capability.as_str())},\"fact\":{fact}}}"
        }
        out += "]"
        ^out
    }
