// Rust: crates/jet-foundation/src/TargetMachine.rs:223
pub struct TargetInterruptFact {
    pub name: String
    pub vector: U16
    pub forbidden_effects: EffectSet
    pub bounded: Bool
    // Rust: crates/jet-foundation/src/TargetMachine.rs:231
    pub fn new(^name: String, vector: U16) -> TargetInterruptFact Never! {
        forbidden_effects := EffectSet.new()
        _ :: &forbidden_effects.insert("Mem.Alloc")
        _ :: &forbidden_effects.insert("Time.Wait")
        TargetInterruptFact{name: ^name, vector: vector, forbidden_effects: ^forbidden_effects, bounded: true}
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:243
    pub fn with_effects(^name: String, vector: U16, forbidden_effects: [String]) -> TargetInterruptFact Never! {
        effects := EffectSet.new()
        loop effect in forbidden_effects -> _ :: &effects.insert(~effect)
        TargetInterruptFact{name: ^name, vector: vector, forbidden_effects: ^effects, bounded: true}
    }
}

// Rust: crates/jet-foundation/src/TargetMachine.rs:268
