// Typed error report: the `jet.err/v1` wire built from typed error facts, never
// reconstructed from rendered text. The private execution journey
// (thread-local) stays with the runtime host.
use {
    error_report_json: core.encoding.json
    core.encoding.[EncodingError, EncodingErrorKind, EncodingLimits]
}

// The Rust strict reader's container depth: the 65th nested container is refused.
JET_ERROR_REPORT_JSON_DEPTH: 64

// The Rust original reports wire failures as the Rust error string.
#Error
JetErrorReportError: struct { message: String }

jet_error_report_error: fn(message: String) -> JetErrorReportError Never! { JetErrorReportError{message: message} }

JetErrorContextFrame: struct { text: String, file: String, line: Int }
JetErrorConversion: struct { source: String, target: String }
// `value` is raw canonical JSON, never a quoted rendering of the typed field.
JetErrorField: struct { name: String, value: String }
JetErrorSpan: struct { start: Int, end: Int }
JetErrorDetails: struct {
    variant: String
    fields: [JetErrorField]
    source_span: JetErrorSpan?{None}

    to_json: fn(self) -> String Never! {
        fields := [String]{}
        loop field in self.fields -> fields.push("{foundation_json_quote(field.name)}:{field.value}")
        span: if self.source_span == {
            .Val(value) -> "{{\"start\":{value.start},\"end\":{value.end}}}"
            .None -> "null"
        }
        "{{\"variant\":{foundation_json_quote(self.variant)},\"fields\":{{{fields.join(",")}}},\"source_span\":{span}}}"
    }
}
JetErrorJourneyFrame: struct {
    fn_name: String
    file: String
    line: Int
    column: Int
    note: String
    hops: Int
}
JetErrorReport: struct {
    code: String?{None}
    message: String
    typed_identity: String?{None}
    causes: [JetErrorReport]{[JetErrorReport]{}}
    context_frames: [JetErrorContextFrame]{[JetErrorContextFrame]{}}
    origin: JetErrorJourneyFrame?{None}
    source_journey: [JetErrorJourneyFrame]{[JetErrorJourneyFrame]{}}
    conversion_history: [JetErrorConversion]{[JetErrorConversion]{}}
    details: JetErrorDetails?{None}

    to_json: fn(self) -> String Never! {
        code: if self.code == {
            .Val(value) -> foundation_json_quote(value)
            .None -> "null"
        }
        causes := [String]{}
        loop cause in self.causes -> causes.push(cause.to_json())
        cause: if {
            causes.len() == 0 -> "null"
            causes.len() == 1 -> causes[0]
            else -> "[{causes.join(",")}]"
        }
        fields := [String]{"\"schema\":\"jet.err/v1\"", "\"message\":{foundation_json_quote(self.message)}", "\"code\":{code}", "\"cause\":{cause}"}
        if self.typed_identity == .Val(identity) -> fields.push("\"typed_identity\":{foundation_json_quote(identity)}")
        if self.context_frames.len() > 0 {
            frames := [String]{}
            loop frame in self.context_frames -> frames.push("{{\"text\":{foundation_json_quote(frame.text)},\"file\":{foundation_json_quote(frame.file)},\"line\":{frame.line}}}")
            fields.push("\"context_frames\":[{frames.join(",")}]")
        }
        if self.origin == .Val(origin) -> fields.push("\"origin\":{jet_error_journey_json(origin)}")
        if self.source_journey.len() > 0 {
            frames := [String]{}
            loop frame in self.source_journey -> frames.push(jet_error_journey_json(frame))
            fields.push("\"source_journey\":[{frames.join(",")}]")
        }
        if self.conversion_history.len() > 0 {
            conversions := [String]{}
            loop conversion in self.conversion_history -> conversions.push("{{\"source\":{foundation_json_quote(conversion.source)},\"target\":{foundation_json_quote(conversion.target)}}}")
            fields.push("\"conversion_history\":[{conversions.join(",")}]")
        }
        if self.details == .Val(details) -> fields.push("\"details\":{details.to_json()}")
        "{{{fields.join(",")}}}"
    }

    // JetErrorReport::from_json: the Rust strict reader (duplicate keys
    // refused, 64 containers, no byte ceiling, its refusal messages), then the
    // typed decode, then the canonical round trip.
    from_json: fn(text: String) -> JetErrorReport JetErrorReportError! {
        limits := EncodingLimits.safe()
        limits.max_depth = JET_ERROR_REPORT_JSON_DEPTH
        limits.max_item_bytes = if text.bytes().len() > 0 -> text.bytes().len() else -> 1
        value: if error_report_json.parse_with_limits(text, limits) == {
            .Ok(value) -> value
            .Err(error) -> { return Err(jet_error_report_error("invalid error report: {jet_error_report_json_reason(error)}")) }
        }
        report: jet_error_report_from_json(value)
        if report.to_json() != text -> return Err(jet_error_report_error("error report is not canonical"))
        Ok(report)
    }
}

// Core's refusal in the Rust strict reader's words: a value missing at its
// position (also at the end of input) is "expected a JSON value", and the 65th
// container is "nested too deeply".
jet_error_report_json_reason: fn(error: EncodingError) -> String Never! {
    if error.kind == EncodingErrorKind.Truncated || error.reason.starts_with("expected a JSON value") -> return "expected a JSON value"
    depth_refusal: "nesting exceeds max_depth ({JET_ERROR_REPORT_JSON_DEPTH})"
    if error.reason == depth_refusal -> return "JSON value is nested too deeply"
    error.reason.copy()
}

jet_error_journey_json: fn(frame: JetErrorJourneyFrame) -> String Never! {
    "{{\"fn_name\":{foundation_json_quote(frame.fn_name)},\"file\":{foundation_json_quote(frame.file)},\"line\":{frame.line},\"column\":{frame.column},\"note\":{foundation_json_quote(frame.note)},\"hops\":{frame.hops}}}"
}

jet_error_json_object: fn(value: Dyn, name: String) -> [(key: String, value: Dyn)] JetErrorReportError! {
    if value == {
        .Object(fields) -> Ok(fields)
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Array(_) -> Err(jet_error_report_error("error report {name} is not an object"))
    }
}
jet_error_json_lookup: fn(fields: [(key: String, value: Dyn)], name: String) -> Dyn? Never! {
    loop field in fields {
        if field.key == name -> return Val(field.value)
    }
    None
}
jet_error_json_field: fn(fields: [(key: String, value: Dyn)], name: String) -> Dyn JetErrorReportError! {
    Ok(jet_error_json_lookup(fields, name) ?? return Err(jet_error_report_error("error report lacks {name}")))
}
jet_error_json_text: fn(value: Dyn, name: String) -> String JetErrorReportError! {
    if value == {
        .Text(text) -> Ok(text)
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> Err(jet_error_report_error("error report {name} is not text"))
    }
}
jet_error_json_optional_text: fn(fields: [(key: String, value: Dyn)], name: String) -> String? JetErrorReportError! {
    if jet_error_json_lookup(fields, name) == {
        .Val(value) -> Ok(Val(jet_error_json_text(value, name)))
        .None -> Ok(None)
    }
}
jet_error_json_optional_array: fn(fields: [(key: String, value: Dyn)], name: String) -> [Dyn] JetErrorReportError! {
    value: jet_error_json_lookup(fields, name) ?? return Ok([Dyn]{})
    if value == {
        .Array(values) -> Ok(values)
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Object(_) -> Err(jet_error_report_error("error report {name} is not an array"))
    }
}
jet_error_json_u32: fn(value: Dyn, name: String) -> Int JetErrorReportError! {
    number: foundation_json_integer(value) ?? return Err(jet_error_report_error("error report {name} is not an integer"))
    // Rust's JSON Int is i64; wider tokens are not an integer.
    if number < -9223372036854775808 || number > 9223372036854775807 -> return Err(jet_error_report_error("error report {name} is not an integer"))
    if number < 0 || number > 4294967295 -> return Err(jet_error_report_error("error report {name} is not a u32"))
    Ok(number)
}
jet_error_context_from_json: fn(value: Dyn) -> JetErrorContextFrame JetErrorReportError! {
    fields: jet_error_json_object(value, "context frame")
    Ok(JetErrorContextFrame{text: jet_error_json_text(jet_error_json_field(fields, "text"), "context text"), file: jet_error_json_text(jet_error_json_field(fields, "file"), "context file"), line: jet_error_json_u32(jet_error_json_field(fields, "line"), "context line")})
}
jet_error_journey_from_json: fn(value: Dyn) -> JetErrorJourneyFrame JetErrorReportError! {
    fields: jet_error_json_object(value, "journey frame")
    Ok(JetErrorJourneyFrame{fn_name: jet_error_json_text(jet_error_json_field(fields, "fn_name"), "journey function"), file: jet_error_json_text(jet_error_json_field(fields, "file"), "journey file"), line: jet_error_json_u32(jet_error_json_field(fields, "line"), "journey line"), column: jet_error_json_u32(jet_error_json_field(fields, "column"), "journey column"), note: jet_error_json_text(jet_error_json_field(fields, "note"), "journey note"), hops: jet_error_json_u32(jet_error_json_field(fields, "hops"), "journey hops")})
}
jet_error_conversion_from_json: fn(value: Dyn) -> JetErrorConversion JetErrorReportError! {
    fields: jet_error_json_object(value, "conversion")
    Ok(JetErrorConversion{source: jet_error_json_text(jet_error_json_field(fields, "source"), "conversion source"), target: jet_error_json_text(jet_error_json_field(fields, "target"), "conversion target")})
}
jet_error_details_from_json: fn(value: Dyn) -> JetErrorDetails JetErrorReportError! {
    fields: jet_error_json_object(value, "details")
    field_values := [JetErrorField]{}
    loop entry in jet_error_json_object(jet_error_json_field(fields, "fields"), "detail fields") -> field_values.push(JetErrorField{name: entry.key, value: jet_error_json_encode_value(entry.value)})
    span_value: jet_error_json_field(fields, "source_span")
    source_span: if span_value == {
        .Null -> None
        .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> {
            span: jet_error_json_object(span_value, "source span")
            // The Rust original writes every usize but reads back only a u32.
            Val(JetErrorSpan{start: jet_error_json_u32(jet_error_json_field(span, "start"), "span start"), end: jet_error_json_u32(jet_error_json_field(span, "end"), "span end")})
        }
    }
    Ok(JetErrorDetails{variant: jet_error_json_text(jet_error_json_field(fields, "variant"), "detail variant"), fields: field_values, source_span: source_span})
}
jet_error_report_from_json: fn(value: Dyn) -> JetErrorReport JetErrorReportError! {
    fields: jet_error_json_object(value, "report")
    if jet_error_json_text(jet_error_json_field(fields, "schema"), "schema") != "jet.err/v1" -> return Err(jet_error_report_error("unsupported error report schema"))
    message: jet_error_json_text(jet_error_json_field(fields, "message"), "message")
    code_value: jet_error_json_field(fields, "code")
    code: if code_value == {
        .Null -> None
        .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> Val(jet_error_json_text(code_value, "code"))
    }
    causes := [JetErrorReport]{}
    if jet_error_json_field(fields, "cause") == {
        .Null -> {}
        .Object(_) -> causes.push(jet_error_report_from_json(jet_error_json_field(fields, "cause")))
        .Array(values) -> { loop cause_value in values -> causes.push(jet_error_report_from_json(cause_value)) }
        .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) -> return Err(jet_error_report_error("error report cause is not null, an object, or an array"))
    }
    typed_identity: jet_error_json_optional_text(fields, "typed_identity")
    context := [JetErrorContextFrame]{}
    loop context_value in jet_error_json_optional_array(fields, "context_frames") -> context.push(jet_error_context_from_json(context_value))
    origin: if jet_error_json_lookup(fields, "origin") == {
        .Val(origin_value) -> Val(jet_error_journey_from_json(origin_value))
        .None -> None
    }
    journey := [JetErrorJourneyFrame]{}
    loop journey_value in jet_error_json_optional_array(fields, "source_journey") -> journey.push(jet_error_journey_from_json(journey_value))
    conversions := [JetErrorConversion]{}
    loop conversion_value in jet_error_json_optional_array(fields, "conversion_history") -> conversions.push(jet_error_conversion_from_json(conversion_value))
    details: if jet_error_json_lookup(fields, "details") == {
        .Val(details_value) -> Val(jet_error_details_from_json(details_value))
        .None -> None
    }
    Ok(JetErrorReport{code: code, message: message, typed_identity: typed_identity, causes: causes, context_frames: context, origin: origin, source_journey: journey, conversion_history: conversions, details: details})
}
// `jet_error_json_encode_value`: protocol quoting (every Unicode control
// escaped) and Rust f64 Display, in the object's own field order. A number
// lexeme with a fraction or exponent is the Float the Rust reader read, so
// `1.0` re-encodes as `1`; an integer lexeme stays exact.
jet_error_json_encode_value: fn(value: Dyn) -> String Never! {
    if value == {
        .Null -> "null"
        .Bool(flag) -> if flag -> "true" else -> "false"
        .Int(number) -> "{number}"
        .Float(number) -> foundation_float_display(number)
        .Text(text) -> foundation_json_quote(text)
        .Number(lexeme) -> {
            if !lexeme.contains(".") && !lexeme.contains("e") && !lexeme.contains("E") -> return lexeme.copy()
            number: Float.parse(lexeme) ?? return lexeme.copy()
            foundation_float_display(number)
        }
        // Bytes encode as their base64 text, a DateTime as its RFC 3339 text.
        .Bytes(_) -> foundation_json_quote(value.to_text() ?? "")
        .DateTime(_) -> foundation_json_quote(value.to_text() ?? "")
        .Array(values) -> {
            encoded := [String]{}
            loop child in values -> encoded.push(jet_error_json_encode_value(child))
            "[{encoded.join(",")}]"
        }
        .Object(fields) -> {
            encoded := [String]{}
            loop entry in fields -> encoded.push("{foundation_json_quote(entry.key)}:{jet_error_json_encode_value(entry.value)}")
            "{{{encoded.join(",")}}}"
        }
    }
}
