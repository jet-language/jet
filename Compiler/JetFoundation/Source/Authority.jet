// Rust: crates/jet-foundation/src/Authority.rs:788
pub struct GateLedger {
    rows: [GateEntry]
    diagnostic_rows: [GateDiagnostic]
    pub fn default() -> GateLedger Never! { GateLedger{rows: [], diagnostic_rows: []} }
    // Rust: crates/jet-foundation/src/Authority.rs:794
    pub fn entries(self) -> View<GateEntry> from self { self.rows[0..<self.rows.len()] }
    // Rust: crates/jet-foundation/src/Authority.rs:798
    pub fn diagnostics(self) -> View<GateDiagnostic> from self { self.diagnostic_rows[0..<self.diagnostic_rows.len()] }
    // Rust: crates/jet-foundation/src/Authority.rs:802
    pub fn set_diagnostics(&self, diagnostics: ^[GateDiagnostic]) -> { self.diagnostic_rows = ^diagnostics }
    // Rust: crates/jet-foundation/src/Authority.rs:808
    pub fn push(&self, incoming: ^GateEntry) -> {
        entry := ^incoming
        if entry.provenance.len() == 0 -> &entry.provenance.push(entry.source)
        loop index in 0..<self.rows.len() {
            if !same_fact(self.rows[index], entry) -> next
            loop provenance in entry.provenance {
                if !self.rows[index].provenance.contains(provenance) -> &self.rows[index].provenance.push(provenance)
            }
            if self.rows[index].reason == None -> self.rows[index].reason = ^entry.reason
            if self.rows[index].status == None -> self.rows[index].status = ^entry.status
            &self.rows[index].provenance.sort()
            return
        }
        &entry.provenance.sort()
        &self.rows.push(^entry)
    }
    // Rust: crates/jet-foundation/src/Authority.rs:835
    pub fn sort(&self) -> {
        &self.rows.sort_by((left: GateEntry, right: GateEntry) -> {
            left_key :: (!left.kind.is_security(), left.kind.display_order(), left.kind.name(), left.source,
                left.span.map((span: Span) -> span.start) ?? Int.MAX, left.span.map((span: Span) -> span.end) ?? Int.MAX, left.subject, left.detail)
            right_key :: (!right.kind.is_security(), right.kind.display_order(), right.kind.name(), right.source,
                right.span.map((span: Span) -> span.start) ?? Int.MAX, right.span.map((span: Span) -> span.end) ?? Int.MAX, right.subject, right.detail)
            left_key <=> right_key
        })
    }
}
// Rust: crates/jet-foundation/src/Authority.rs:861
fn same_fact(left: GateEntry, right: GateEntry) -> Bool Never! {
    if left.kind != right.kind || left.domain != right.domain || left.scope != right.scope || left.subject != right.subject || left.detail != right.detail -> return false
    if (left.span, right.span) == {
        (None, None) -> true
        (.Val(left_span), .Val(right_span)) -> left_span == right_span && left.source == right.source
        else -> false
    }
}
// Rust: crates/jet-foundation/src/Authority.rs:877
pub fn builtin_effect(name: String) -> Effect? Never! {
    if IMPURE_BUILTINS.contains(name) -> Val(Effect.IO) else -> None
}
// Rust: crates/jet-foundation/src/Authority.rs:884
pub fn is_impure_core(module: String, method: String) -> Bool Never! {
    module == "core.term" && if method == { "stdin" | "input" | "confirm" | "choose" | "input_secret" | "read_all_input" -> true else -> false }
}
