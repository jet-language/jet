impl ApplicationAuthority {
    // Rust: crates/jet-foundation/src/Authority.rs:283
    pub fn default() -> ApplicationAuthority Never! { ApplicationAuthority.ambient_basics() }
    // Rust: crates/jet-foundation/src/Authority.rs:499
    pub fn policy_refusal(self) -> Diagnostic Never! {
        denied :: self.denied_required_effects()
        what :: if denied.len() == 0 -> "application authority is undecided for `{self.undecided_effects().join(", ")}`" else -> "application authority denies `{denied.join(", ")}`"
        diagnostic :: Diagnostic.error("E1803", what, self.policy_why(), self.policy_fix(), None)
        detailed :: diagnostic_with_detail(^diagnostic, self.policy_facts())
        diagnostic_with_rights(^detailed, "authority", [], [String]{self.authority}, None)
    }
    // Rust: crates/jet-foundation/src/Authority.rs:521
    pub fn policy_diagnostic(self) -> Diagnostic? Never! {
        if self.is_allowed() -> None else -> Val(self.policy_refusal())
    }
}
