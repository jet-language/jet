// Rust: crates/jet-foundation/src/Authority.rs:534
pub fn repl_refusal_why(authority: ApplicationAuthority, reason: String) -> String Never! {
    chars := reason.chars()
    capitalized :: if chars.next() == { .Val(first) -> "{first.to_uppercase()}{chars.as_str()}" else -> "" }
    if authority.is_allowed() -> "{capitalized}, so the host operation did not run."
    else -> "{authority.policy_why()} {capitalized}, so the host operation did not run."
}
