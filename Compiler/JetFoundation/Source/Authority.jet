// Rust: crates/jet-foundation/src/Authority.rs:662
pub enum GateKind {
    Unsafe Impure DependencyGrant BuildFlag SessionFlag TrustGrant ForcePin TaintScrub DutyDrop StateTransition PrecisionDemotion Nondeterministic Structure
    // Rust: crates/jet-foundation/src/Authority.rs:679
    pub fn name(self) -> String Never! {
        if self == {
            .Unsafe -> "unsafe" .Impure -> "impure" .DependencyGrant -> "dependency_grant" .BuildFlag -> "build_flag"
            .SessionFlag -> "session_flag" .TrustGrant -> "trust_grant" .ForcePin -> "force_pin" .TaintScrub -> "taint_scrub"
            .DutyDrop -> "duty_drop" .StateTransition -> "state_transition" .PrecisionDemotion -> "precision_demotion"
            .Nondeterministic -> "nondeterministic" .Structure -> "structure"
        }
    }
    // Rust: crates/jet-foundation/src/Authority.rs:697
    pub fn parse(value: String) -> GateKind? Never! {
        trimmed := value.trim() // #4303
        if trimmed.to_ascii_lower() == {
            "unsafe" | "unsafe_region" | "unsafe_fn" -> Val(.Unsafe)
            "impure" -> Val(.Impure)
            "dependency" | "dependency_grant" | "grant" -> Val(.DependencyGrant)
            "build" | "build_flag" -> Val(.BuildFlag)
            "session" | "session_flag" -> Val(.SessionFlag)
            "trust" | "trust_grant" -> Val(.TrustGrant)
            "force" | "force_pin" -> Val(.ForcePin)
            "scrub" | "taint" | "taint_scrub" -> Val(.TaintScrub)
            "drop" | "detach" | "duty" | "duty_drop" -> Val(.DutyDrop)
            "state" | "transition" | "state_transition" -> Val(.StateTransition)
            "approx" | "precision" | "precision_demotion" | "rounded" | "wrapping" | "saturating" | "checked" -> Val(.PrecisionDemotion)
            "nondeterministic" | "determinism" -> Val(.Nondeterministic)
            "structure" -> Val(.Structure)
            else -> None
        }
    }
    // Rust: crates/jet-foundation/src/Authority.rs:717
    pub fn is_security(self) -> Bool Never! {
        if self == { .Unsafe | .Impure | .DependencyGrant | .BuildFlag | .SessionFlag | .TrustGrant | .ForcePin | .Nondeterministic -> true else -> false }
    }
    // Rust: crates/jet-foundation/src/Authority.rs:731
    pub fn is_rights_kind(self) -> Bool Never! { self.is_security() }
    // Rust: crates/jet-foundation/src/Authority.rs:735
    fn display_order(self) -> U8 Never! {
        if self == {
            .Unsafe -> 0 .Impure -> 1 .Nondeterministic -> 2 .DependencyGrant -> 3 .BuildFlag -> 4 .SessionFlag -> 5
            .TrustGrant -> 6 .ForcePin -> 7 .TaintScrub -> 8 .DutyDrop -> 9 .StateTransition -> 10 .PrecisionDemotion -> 11 .Structure -> 12
        }
    }
}
