pub fn is_declared_irreversible(right: String) -> Bool Never! {
    canonical := authority_parse_right(right) ?? right.trim() // #4303
    loop declaration in FoundationEmbeddedCore{}.effect_declarations() {
        if declaration.irreversible && authority_covers(declaration.name, canonical) -> return true
    }
    false
}
