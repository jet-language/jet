impl MIRHostImportFact {
    // Rust: crates/jet-foundation/src/Authority.rs:230
    pub fn new(id: String, operation: String, required_right: String, parameter_type_ids: [String], result_type_id: String?) -> MIRHostImportFact Never! {
        MIRHostImportFact{id: id, operation: operation, required_right: required_right, parameter_type_ids: parameter_type_ids, result_type_id: result_type_id}
    }
    // Rust: crates/jet-foundation/src/Authority.rs:248
    pub fn payload_type_ids(self) -> HostPayloadTypeIds from self { HostPayloadTypeIds{fact: @self, at: 0} }
    // Rust: crates/jet-foundation/src/Authority.rs:255
    pub fn required_grant(self) -> @String from self { @self.required_right }
}
pub struct HostPayloadTypeIds { pub fact: @MIRHostImportFact, pub at: Int }
impl HostPayloadTypeIds.Iterator {
    type Item = @String
    fn next(&self) -> (@String)? from self {
        index :: self.at
        if index < self.fact.parameter_type_ids.len() {
            self.at += 1
            return Val(@self.fact.parameter_type_ids[index])
        }
        if index == self.fact.parameter_type_ids.len() {
            self.at += 1
            if self.fact.result_type_id == .Val(result) -> return Val(@result)
        }
        None
    }
}
