pub struct AuthorityRights { pub rows: View<String>, pub at: Int }
impl AuthorityRights.Iterator {
    type Item = @String
    fn next(&self) -> (@String)? from self {
        if self.at >= self.rows.len() -> return None
        index :: self.at
        self.at += 1
        Val(@self.rows[index])
    }
}
