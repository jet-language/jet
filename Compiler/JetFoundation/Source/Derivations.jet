// Canonical derivation relations retained by Source facts and typed payloads.
// IDs match the native FactsDerivation framing algorithm.

pub struct DerivationIdentity {
    pub source: String
    pub build: String
    pub run: String
    pub target: String
}

pub struct DerivationObservation {
    pub event_id: String?
    pub counterexample_id: String?
}

pub enum DerivationPayload { FrameSchedule(schedule: MIRFrameSchedule) }

pub struct DerivationRecord {
    pub id: String
    pub subject: String
    pub claim: String
    pub producer: String
    pub method: MIRDerivationMethod
    pub rule: String
    pub premises: [String]
    pub identity: DerivationIdentity
    pub assumptions: [String]
    pub disposition: MIRDerivationDisposition
    pub observation: DerivationObservation?
    pub payload: DerivationPayload?
}

pub struct DerivationStore { pub records: [DerivationRecord] }

pub fn derivation_identity(source: String, build: String, run: String, target: String) -> DerivationIdentity Never! {
    DerivationIdentity{source: source, build: build, run: run, target: target}
}

pub fn derivation_record(subject: String, claim: String, producer: String, method: MIRDerivationMethod, rule: String, premises: [String], identity: DerivationIdentity) -> DerivationRecord Never! {
    sorted_premises := derivation_strings_sorted_unique(premises)
    record := DerivationRecord{
        id: "",
        subject: subject,
        claim: claim,
        producer: producer,
        method: method,
        rule: rule,
        premises: sorted_premises,
        identity: identity,
        assumptions: [String]{},
        disposition: MIRDerivationDisposition.Current,
        observation: None,
        payload: None,
    }
    record.id = derivation_record_id(record)
    record
}

pub fn derivation_record_with_payload(record: ^DerivationRecord, payload: DerivationPayload) -> DerivationRecord Never! {
    updated := record
    updated.payload = Val(payload)
    updated.id = derivation_record_id(updated)
    updated
}

pub fn derivation_record_reference(record: DerivationRecord) -> MIRDerivationRef Never! {
    MIRDerivationRef{id: record.id}
}

// Rust FactsDerivation.rs::DerivationRecord::invalidate_if_identity_changed.
pub fn derivation_record_invalidate_if_identity_changed(record: &DerivationRecord, current: DerivationIdentity) -> Bool Never! {
    if record.disposition != MIRDerivationDisposition.Current -> return false
    if record.identity.source == current.source && record.identity.build == current.build && record.identity.run == current.run && record.identity.target == current.target -> return false
    record.disposition = MIRDerivationDisposition.Stale
    true
}

pub fn derivation_record_validate(record: DerivationRecord) -> Bool Never! {
    record.id == derivation_record_id(record)
}

pub fn derivation_payload_json(payload: DerivationPayload) -> String Never! {
    if payload == {
        .FrameSchedule(schedule) -> mir_frame_schedule_json(schedule)
    }
}

pub fn derivation_record_json(record: DerivationRecord) -> String Never! {
    premises := derivation_json_strings(record.premises)
    assumptions := derivation_json_strings(record.assumptions)
    observation := "null"
    if record.observation != None {
        item :: record.observation ?? DerivationObservation{event_id: None, counterexample_id: None}
        counterexample := if item.counterexample_id == None -> "null" else -> derivation_record_quote(item.counterexample_id ?? "")
        event := if item.event_id == None -> "null" else -> derivation_record_quote(item.event_id ?? "")
        observation = "{{\"counterexample\":{counterexample},\"event\":{event}}}"
    }
    payload := derivation_optional_payload_json(record.payload, "null")
    "{{\"assumptions\":[{assumptions}],\"claim\":{derivation_record_quote(record.claim)},\"disposition\":{derivation_disposition_name(record.disposition)},\"id\":{derivation_record_quote(record.id)},\"identity\":{{\"build\":{derivation_record_quote(record.identity.build)},\"run\":{derivation_record_quote(record.identity.run)},\"source\":{derivation_record_quote(record.identity.source)},\"target\":{derivation_record_quote(record.identity.target)}}},\"method\":{derivation_method_name(record.method)},\"observation\":{observation},\"payload\":{payload},\"premises\":[{premises}],\"producer\":{derivation_record_quote(record.producer)},\"rule\":{derivation_record_quote(record.rule)},\"subject\":{derivation_record_quote(record.subject)}}}"
}
fn derivation_optional_payload_json(payload: DerivationPayload?, absent: String) -> String Never! {
    value :: payload ?? return ~absent
    derivation_payload_json(value)
}

// FactsDerivation.rs::DerivationRecord::to_json: typed projection beside the
// canonical record/payload owners. Report quoting is intentionally distinct
// from the raw Foundation protocol; never parse the raw JSON to build this.
pub fn derivation_record_status_value(record: DerivationRecord) -> StatusValue Never! {
    observation := StatusValue.Null
    if record.observation == .Val(item) {
        observation = StatusValue.Object{fields: StatusFields.new()
            .with("counterexample", derivation_status_optional_string(item.counterexample_id))
            .with("event", derivation_status_optional_string(item.event_id))}
    }
    payload := StatusValue.Null
    if record.payload == .Val(item) -> payload = derivation_payload_status_value(item)
    identity :: StatusValue.Object{fields: StatusFields.new()
        .with("build", StatusValue.String{value: record.identity.build})
        .with("run", StatusValue.String{value: record.identity.run})
        .with("source", StatusValue.String{value: record.identity.source})
        .with("target", StatusValue.String{value: record.identity.target})}
    StatusValue.Object{fields: StatusFields.new()
        .with("assumptions", derivation_status_strings(record.assumptions))
        .with("claim", StatusValue.String{value: record.claim})
        .with("disposition", StatusValue.String{value: derivation_disposition_text(record.disposition)})
        .with("id", StatusValue.String{value: record.id})
        .with("identity", identity)
        .with("method", StatusValue.String{value: derivation_method_raw(record.method)})
        .with("observation", observation)
        .with("payload", payload)
        .with("premises", derivation_status_strings(record.premises))
        .with("producer", StatusValue.String{value: record.producer})
        .with("rule", StatusValue.String{value: record.rule})
        .with("subject", StatusValue.String{value: record.subject})}
}

fn derivation_status_optional_string(value: String?) -> StatusValue Never! {
    if value == {
        .Val(text) -> StatusValue.String{value: text}
        .None -> StatusValue.Null
    }
}
fn derivation_status_strings(values: [String]) -> StatusValue Never! {
    items := [StatusValue]{}
    loop value in values -> &items.push(StatusValue.String{value: value})
    StatusValue.Array{values: items}
}

// FactsDerivation.rs::DerivationPayload::to_json delegates to the SAME
// schedule owner as the raw wire; every field and omission remains typed.
fn derivation_payload_status_value(payload: DerivationPayload) -> StatusValue Never! {
    if payload == {
        .FrameSchedule(schedule) -> mir_frame_schedule_status_value(schedule)
    }
}

// ResourceSchedule.rs::JetFrameSchedule::canonical_json and encode_*.
fn mir_frame_schedule_status_value(schedule: MIRFrameSchedule) -> StatusValue Never! {
    operations := [StatusValue]{}
    dependencies := [StatusValue]{}
    transfers := [StatusValue]{}
    reuse := [StatusValue]{}
    retentions := [StatusValue]{}
    loop row in schedule.operations -> &operations.push(mir_frame_operation_status_value(row))
    loop row in schedule.dependencies {
        &dependencies.push(StatusValue.Object{fields: StatusFields.new()
            .with("before", StatusValue.String{value: row.before.to_string()})
            .with("after", StatusValue.String{value: row.after.to_string()})
            .with("resource", StatusValue.String{value: row.resource})
            .with("reason", StatusValue.String{value: row.reason})})
    }
    loop row in schedule.transfers {
        &transfers.push(StatusValue.Object{fields: StatusFields.new()
            .with("before", StatusValue.String{value: row.before.to_string()})
            .with("after", StatusValue.String{value: row.after.to_string()})
            .with("resource", StatusValue.String{value: row.resource})
            .with("from_device", StatusValue.String{value: row.from_device})
            .with("to_device", StatusValue.String{value: row.to_device})})
    }
    loop row in schedule.reuse {
        &reuse.push(StatusValue.Object{fields: StatusFields.new()
            .with("previous_resource", StatusValue.String{value: row.previous_resource})
            .with("next_resource", StatusValue.String{value: row.next_resource})
            .with("previous_last_use", StatusValue.String{value: row.previous_last_use.to_string()})
            .with("next_first_use", StatusValue.String{value: row.next_first_use.to_string()})
            .with("legal", StatusValue.Bool{value: row.legal})
            .with("reason", StatusValue.String{value: row.reason})})
    }
    loop row in schedule.retentions {
        &retentions.push(StatusValue.Object{fields: StatusFields.new()
            .with("resource", StatusValue.String{value: row.resource})
            .with("operation", StatusValue.String{value: row.operation.to_string()})
            .with("owner", StatusValue.String{value: row.owner})
            .with("completion_token", derivation_status_optional_string(row.completion_token))
            .with("completed", StatusValue.Bool{value: row.completed})})
    }
    StatusValue.Object{fields: StatusFields.new()
        .with("schema", StatusValue.String{value: "jet.frame_schedule/v1"})
        .with("operations", StatusValue.Array{values: operations})
        .with("dependencies", StatusValue.Array{values: dependencies})
        .with("transfers", StatusValue.Array{values: transfers})
        .with("reuse", StatusValue.Array{values: reuse})
        .with("retentions", StatusValue.Array{values: retentions})
        .with("conservative", derivation_status_strings(schedule.conservative))}
}

fn mir_frame_operation_status_value(operation: MIRFrameOperation) -> StatusValue Never! {
    accesses := [StatusValue]{}
    loop access in operation.accesses {
        identity := StatusFields.new()
        if access.resource == {
            .Named(name) -> identity = ^identity.with("kind", StatusValue.String{value: "named"}).with("value", StatusValue.String{value: name})
            .Unknown -> identity = ^identity.with("kind", StatusValue.String{value: "unknown"})
        }
        region := StatusFields.new()
        if access.region == {
            .Whole -> region = ^region.with("kind", StatusValue.String{value: "whole"})
            .Unknown -> region = ^region.with("kind", StatusValue.String{value: "unknown"})
            .Bytes(start, length) -> region = ^region.with("kind", StatusValue.String{value: "bytes"})
                .with("start", StatusValue.String{value: start.to_string()})
                .with("length", StatusValue.String{value: length.to_string()})
        }
        layout := StatusValue.Null
        if access.layout == .Val(value) {
            layout = StatusValue.Object{fields: StatusFields.new()
                .with("size", StatusValue.String{value: value.size.to_string()})
                .with("align", StatusValue.String{value: value.align.to_string()})
                .with("layout", StatusValue.String{value: value.layout})
                .with("device", StatusValue.String{value: value.device})}
        }
        &accesses.push(StatusValue.Object{fields: StatusFields.new()
            .with("resource", StatusValue.Object{fields: identity})
            .with("mode", StatusValue.String{value: mir_resource_mode_name(access.mode)})
            .with("region", StatusValue.Object{fields: region})
            .with("layout", layout)
            .with("temporary", StatusValue.Bool{value: access.temporary})})
    }
    completion := StatusFields.new()
    if operation.completion == {
        .Synchronous -> completion = ^completion.with("kind", StatusValue.String{value: "synchronous"})
        .Pending(token) -> completion = ^completion.with("kind", StatusValue.String{value: "pending"}).with("token", StatusValue.String{value: token})
        .Event(token) -> completion = ^completion.with("kind", StatusValue.String{value: "event"}).with("token", StatusValue.String{value: token})
    }
    fields := StatusFields.new()
        .with("name", StatusValue.String{value: operation.name})
        .with("source_index", StatusValue.String{value: operation.source_index.to_string()})
        .with("accesses", StatusValue.Array{values: accesses})
        .with("completion", StatusValue.Object{fields: completion})
        .with("external_effect", StatusValue.Bool{value: operation.external_effect})
    if operation.completion_provider == .Val(provider) -> fields = ^fields.with("completion_provider", StatusValue.String{value: provider})
    StatusValue.Object{fields: fields}
}

pub fn derivation_store_empty() -> DerivationStore Never! {
    DerivationStore{records: [DerivationRecord]{}}
}

// Invalid non-canonical records are not interned. Existing IDs resolve to the
// first canonical record, preserving idempotent evidence collection.
pub fn derivation_store_intern(store: &DerivationStore, record: DerivationRecord) -> MIRDerivationRef? {
    if !derivation_record_validate(record) -> return None
    loop existing in store.records {
        if existing.id == record.id -> return Val(derivation_record_reference(existing))
    }
    &store.records.push(record)
    derivation_store_sort(&store)
    Val(derivation_record_reference(record))
}

fn derivation_store_sort(store: &DerivationStore) Never! {
    loop i in 1..<store.records.len() {
        value := store.records[i]
        j := i
        loop j > 0 && store.records[j - 1].id > value.id {
            store.records[j] = store.records[j - 1]
            j -= 1
        }
        store.records[j] = value
    }
}

fn derivation_strings_sorted_unique(values: [String]) -> [String] Never! {
    sorted := values
    loop i in 1..<sorted.len() {
        value := sorted[i]
        j := i
        loop j > 0 && sorted[j - 1] > value {
            sorted[j] = sorted[j - 1]
            j -= 1
        }
        sorted[j] = value
    }
    result := [String]{}
    loop value in sorted {
        if result.len() == 0 || result[result.len() - 1] != value -> &result.push(value)
    }
    result
}

fn derivation_method_name(method: MIRDerivationMethod) -> String Never! {
    foundation_json_quote(derivation_method_raw(method))
}

fn derivation_disposition_name(disposition: MIRDerivationDisposition) -> String Never! {
    foundation_json_quote(derivation_disposition_text(disposition))
}
pub fn derivation_disposition_text(disposition: MIRDerivationDisposition) -> String Never! {
    if disposition == {
        .Current -> "current"
        .Stale -> "stale"
        .Expired -> "expired"
        .Redacted -> "redacted"
        .Unavailable -> "unavailable"
        .Unsupported -> "unsupported"
        .BudgetExhausted -> "budget_exhausted"
        .Unknown -> "unknown"
    }
}

fn derivation_json_strings(values: [String]) -> String Never! {
    rows := [String]{}
    loop value in values -> &rows.push(derivation_record_quote(value))
    rows.join(",")
}

fn derivation_record_quote(value: String) -> String Never! {
    carriage_return :: String.from_bytes([U8]{13}) ?? ""
    escaped :: value.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace(carriage_return, "\\r").replace("\t", "\\t")
    "\"{escaped}\""
}

fn derivation_record_id(record: DerivationRecord) -> String Never! {
    payload := derivation_optional_payload_json(record.payload, "")
    separator :: String.from_bytes([U8]{0}) ?? ""
    premises := record.premises.join(separator)
    state := DerivationHashState{first: U64{0xcbf29ce484222325}, second: U64{0x9e3779b185ebca87}}
    derivation_hash_frame(&state, record.subject)
    derivation_hash_frame(&state, record.claim)
    derivation_hash_frame(&state, record.producer)
    derivation_hash_frame(&state, derivation_method_raw(record.method))
    derivation_hash_frame(&state, record.rule)
    derivation_hash_frame(&state, premises)
    derivation_hash_frame(&state, record.identity.source)
    derivation_hash_frame(&state, record.identity.build)
    derivation_hash_frame(&state, record.identity.run)
    derivation_hash_frame(&state, record.identity.target)
    derivation_hash_frame(&state, payload)
    derivation_hash_hex(state)
}

pub struct DerivationHashState { pub first: U64, pub second: U64 }

pub fn derivation_method_raw(method: MIRDerivationMethod) -> String Never! {
    if method == {
        .StaticDerivation -> "static_derivation"
        .FormalProof -> "formal_proof"
        .RecordedExecution -> "recorded_execution"
        .SampledAgreement -> "sampled_agreement"
        .ExternalAssumption -> "external_assumption"
    }
}

fn derivation_hash_frame(state: &DerivationHashState, value: String) Never! {
    bytes := value.bytes()
    length := bytes.len()
    loop index in 0..<8 -> derivation_hash_byte(&state, U8{(length >> ((7 - index) * 8)) & 255})
    loop byte in bytes -> derivation_hash_byte(&state, byte)
}

fn derivation_hash_byte(state: &DerivationHashState, byte: U8) Never! {
    value :: U64.from_u8(byte)
    state.first = (state.first ~| value).wrapping_mul(U64{0x100000001b3})
    state.second = (state.second ~| state.first.rotate_left(17) ~| value).wrapping_mul(U64{0x9e3779b185ebca87})
}

fn derivation_hash_hex(state: DerivationHashState) -> String Never! {
    digits := "0123456789abcdef".bytes()
    first :: Int.from_u64(state.first)
    second :: Int.from_u64(state.second)
    output := [U8]{}
    loop shift in ([Int]{60, 56, 52, 48, 44, 40, 36, 32, 28, 24, 20, 16, 12, 8, 4, 0}) -> &output.push(digits[(first >> shift) & 15])
    loop shift in ([Int]{60, 56, 52, 48, 44, 40, 36, 32, 28, 24, 20, 16, 12, 8, 4, 0}) -> &output.push(digits[(second >> shift) & 15])
    String.from_bytes(output) ?? ""
}


fn mir_frame_schedule_json(schedule: MIRFrameSchedule) -> String Never! {
    operations := [String]{}
    dependencies := [String]{}
    transfers := [String]{}
    reuse := [String]{}
    retentions := [String]{}
    conservative := [String]{}
    loop operation in schedule.operations -> &operations.push(mir_frame_operation_json(operation))
    loop dependency in schedule.dependencies -> &dependencies.push(mir_frame_dependency_json(dependency))
    loop transfer in schedule.transfers -> &transfers.push(mir_frame_transfer_json(transfer))
    loop row in schedule.reuse -> &reuse.push(mir_frame_reuse_json(row))
    loop row in schedule.retentions -> &retentions.push(mir_frame_retention_json(row))
    loop reason in schedule.conservative -> &conservative.push(foundation_json_quote(reason))
    operations_json :: operations.join(",")
    dependencies_json :: dependencies.join(",")
    transfers_json :: transfers.join(",")
    reuse_json :: reuse.join(",")
    retentions_json :: retentions.join(",")
    conservative_json :: conservative.join(",")
    "{{\"schema\":\"jet.frame_schedule/v1\",\"operations\":[{operations_json}],\"dependencies\":[{dependencies_json}],\"transfers\":[{transfers_json}],\"reuse\":[{reuse_json}],\"retentions\":[{retentions_json}],\"conservative\":[{conservative_json}]}}"
}

fn mir_frame_operation_json(operation: MIRFrameOperation) -> String Never! {
    accesses := [String]{}
    loop access in operation.accesses -> &accesses.push(mir_resource_access_json(access))
    provider := if operation.completion_provider == None -> "" else -> ",\"completion_provider\":{foundation_json_quote(operation.completion_provider ?? "")}"
    accesses_json :: accesses.join(",")
    "{{\"name\":{foundation_json_quote(operation.name)},\"source_index\":{foundation_json_quote(operation.source_index.to_string())},\"accesses\":[{accesses_json}],\"completion\":{mir_frame_completion_json(operation.completion)},\"external_effect\":{derivation_json_bool(operation.external_effect)}{provider}}}"
}

fn mir_resource_access_json(access: MIRResourceAccess) -> String Never! {
    "{{\"resource\":{mir_resource_identity_json(access.resource)},\"mode\":{foundation_json_quote(mir_resource_mode_name(access.mode))},\"region\":{mir_resource_region_json(access.region)},\"layout\":{mir_resource_layout_json(access.layout)},\"temporary\":{derivation_json_bool(access.temporary)}}}"
}

fn mir_resource_identity_json(identity: MIRResourceIdentity) -> String Never! {
    if identity == {
        .Named(name) -> "{{\"kind\":\"named\",\"value\":{foundation_json_quote(name)}}}"
        .Unknown -> "{{\"kind\":\"unknown\"}}"
    }
}

fn mir_resource_mode_name(mode: MIRResourceAccessMode) -> String Never! {
    if mode == {
        .Read -> "read"
        .Write -> "write"
        .Move -> "move"
    }
}

fn mir_resource_region_json(region: MIRResourceRegion) -> String Never! {
    if region == {
        .Whole -> "{{\"kind\":\"whole\"}}"
        .Unknown -> "{{\"kind\":\"unknown\"}}"
        .Bytes(start, length) -> "{{\"kind\":\"bytes\",\"start\":{foundation_json_quote(start.to_string())},\"length\":{foundation_json_quote(length.to_string())}}}"
    }
}

fn mir_resource_layout_json(layout: MIRResourceLayout?) -> String Never! {
    value :: layout ?? return "null"
    "{{\"size\":{foundation_json_quote(value.size.to_string())},\"align\":{foundation_json_quote(value.align.to_string())},\"layout\":{foundation_json_quote(value.layout)},\"device\":{foundation_json_quote(value.device)}}}"
}

fn mir_frame_completion_json(completion: MIRFrameCompletion) -> String Never! {
    if completion == {
        .Synchronous -> "{{\"kind\":\"synchronous\"}}"
        .Pending(token) -> "{{\"kind\":\"pending\",\"token\":{foundation_json_quote(token)}}}"
        .Event(token) -> "{{\"kind\":\"event\",\"token\":{foundation_json_quote(token)}}}"
    }
}

fn mir_frame_dependency_json(row: MIRFrameDependency) -> String Never! {
    "{{\"before\":{foundation_json_quote(row.before.to_string())},\"after\":{foundation_json_quote(row.after.to_string())},\"resource\":{foundation_json_quote(row.resource)},\"reason\":{foundation_json_quote(row.reason)}}}"
}

fn mir_frame_transfer_json(row: MIRFrameTransfer) -> String Never! {
    "{{\"before\":{foundation_json_quote(row.before.to_string())},\"after\":{foundation_json_quote(row.after.to_string())},\"resource\":{foundation_json_quote(row.resource)},\"from_device\":{foundation_json_quote(row.from_device)},\"to_device\":{foundation_json_quote(row.to_device)}}}"
}

fn mir_frame_reuse_json(row: MIRFrameReuse) -> String Never! {
    "{{\"previous_resource\":{foundation_json_quote(row.previous_resource)},\"next_resource\":{foundation_json_quote(row.next_resource)},\"previous_last_use\":{foundation_json_quote(row.previous_last_use.to_string())},\"next_first_use\":{foundation_json_quote(row.next_first_use.to_string())},\"legal\":{derivation_json_bool(row.legal)},\"reason\":{foundation_json_quote(row.reason)}}}"
}

fn mir_frame_retention_json(row: MIRFrameRetention) -> String Never! {
    token := if row.completion_token == None -> "null" else -> foundation_json_quote(row.completion_token ?? "")
    "{{\"resource\":{foundation_json_quote(row.resource)},\"operation\":{foundation_json_quote(row.operation.to_string())},\"owner\":{foundation_json_quote(row.owner)},\"completion_token\":{token},\"completed\":{derivation_json_bool(row.completed)}}}"
}

fn derivation_json_bool(value: Bool) -> String Never! {
    if value -> "true" else -> "false"
}
