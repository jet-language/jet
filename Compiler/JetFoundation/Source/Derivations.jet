// Canonical derivation relations retained by Source facts and typed payloads.
// IDs match the native FactsDerivation framing algorithm.

pub struct DerivationIdentity {
    pub source: String
    pub build: String
    pub run: String
    pub target: String
}

pub struct DerivationObservation {
    pub event_id: String?
    pub counterexample_id: String?
}

pub enum DerivationPayload { FrameSchedule(schedule: MirFrameSchedule) }

pub struct DerivationRecord {
    pub id: String
    pub subject: String
    pub claim: String
    pub producer: String
    pub method: MirDerivationMethod
    pub rule: String
    pub premises: [String]
    pub identity: DerivationIdentity
    pub assumptions: [String]
    pub disposition: MirDerivationDisposition
    pub observation: DerivationObservation?
    pub payload: DerivationPayload?
}

pub struct DerivationStore { pub records: [DerivationRecord] }

pub fn derivation_identity(source: String, build: String, run: String, target: String) -> DerivationIdentity {
    DerivationIdentity{source: source, build: build, run: run, target: target}
}

pub fn derivation_record(subject: String, claim: String, producer: String, method: MirDerivationMethod, rule: String, premises: [String], identity: DerivationIdentity) -> DerivationRecord {
    sorted_premises := derivation_strings_sorted_unique(premises)
    record := DerivationRecord{
        id: "",
        subject: subject,
        claim: claim,
        producer: producer,
        method: method,
        rule: rule,
        premises: sorted_premises,
        identity: identity,
        assumptions: [String]{},
        disposition: MirDerivationDisposition.Current,
        observation: None,
        payload: None,
    }
    record.id = derivation_record_id(record)
    record
}

pub fn derivation_record_with_payload(record: ^DerivationRecord, payload: DerivationPayload) -> DerivationRecord {
    updated := record
    updated.payload = Val(payload)
    updated.id = derivation_record_id(updated)
    updated
}

pub fn derivation_record_reference(record: DerivationRecord) -> MirDerivationRef {
    MirDerivationRef{id: record.id}
}

pub fn derivation_record_validate(record: DerivationRecord) -> Bool {
    record.id == derivation_record_id(record)
}

pub fn derivation_payload_json(payload: DerivationPayload) -> String {
    if payload == {
        .FrameSchedule(schedule) -> mir_frame_schedule_json(schedule)
    }
}

pub fn derivation_record_json(record: DerivationRecord) -> String {
    premises := derivation_json_strings(record.premises)
    assumptions := derivation_json_strings(record.assumptions)
    observation := "null"
    if record.observation != None {
        item :: record.observation ?? DerivationObservation{event_id: None, counterexample_id: None}
        counterexample := if item.counterexample_id == None -> "null" else -> derivation_record_quote(item.counterexample_id ?? "")
        event := if item.event_id == None -> "null" else -> derivation_record_quote(item.event_id ?? "")
        observation = "{{\"counterexample\":{counterexample},\"event\":{event}}}"
    }
    payload := derivation_optional_payload_json(record.payload, "null")
    "{{\"assumptions\":[{assumptions}],\"claim\":{derivation_record_quote(record.claim)},\"disposition\":{derivation_disposition_name(record.disposition)},\"id\":{derivation_record_quote(record.id)},\"identity\":{{\"build\":{derivation_record_quote(record.identity.build)},\"run\":{derivation_record_quote(record.identity.run)},\"source\":{derivation_record_quote(record.identity.source)},\"target\":{derivation_record_quote(record.identity.target)}}},\"method\":{derivation_method_name(record.method)},\"observation\":{observation},\"payload\":{payload},\"premises\":[{premises}],\"producer\":{derivation_record_quote(record.producer)},\"rule\":{derivation_record_quote(record.rule)},\"subject\":{derivation_record_quote(record.subject)}}}"
}
fn derivation_optional_payload_json(payload: DerivationPayload?, absent: String) -> String {
    if payload == None -> return absent
    value :: payload ?? return absent
    derivation_payload_json(value)
}

pub fn derivation_store_empty() -> DerivationStore {
    DerivationStore{records: [DerivationRecord]{}}
}

// Invalid non-canonical records are not interned. Existing IDs resolve to the
// first canonical record, preserving idempotent evidence collection.
pub fn derivation_store_intern(store: &DerivationStore, record: DerivationRecord) -> MirDerivationRef? {
    if !derivation_record_validate(record) -> return None
    loop existing in store.records {
        if existing.id == record.id -> return Val(derivation_record_reference(existing))
    }
    &store.records.push(record)
    derivation_store_sort(store)
    Val(derivation_record_reference(record))
}

fn derivation_store_sort(store: &DerivationStore) {
    loop i in 1..<store.records.len() {
        value := store.records[i]
        j := i
        loop j > 0 && store.records[j - 1].id > value.id {
            store.records[j] = store.records[j - 1]
            j -= 1
        }
        store.records[j] = value
    }
}

fn derivation_strings_sorted_unique(values: [String]) -> [String] {
    sorted := values
    loop i in 1..<sorted.len() {
        value := sorted[i]
        j := i
        loop j > 0 && sorted[j - 1] > value {
            sorted[j] = sorted[j - 1]
            j -= 1
        }
        sorted[j] = value
    }
    result := [String]{}
    loop value in sorted {
        if result.len() == 0 || result[result.len() - 1] != value -> &result.push(value)
    }
    result
}

fn derivation_method_name(method: MirDerivationMethod) -> String {
    if method == {
        .StaticDerivation -> derivation_json_quote("static_derivation")
        .FormalProof -> derivation_json_quote("formal_proof")
        .RecordedExecution -> derivation_json_quote("recorded_execution")
        .SampledAgreement -> derivation_json_quote("sampled_agreement")
        .ExternalAssumption -> derivation_json_quote("external_assumption")
    }
}

fn derivation_disposition_name(disposition: MirDerivationDisposition) -> String {
    if disposition == {
        .Current -> derivation_json_quote("current")
        .Stale -> derivation_json_quote("stale")
        .Expired -> derivation_json_quote("expired")
        .Redacted -> derivation_json_quote("redacted")
        .Unavailable -> derivation_json_quote("unavailable")
        .Unsupported -> derivation_json_quote("unsupported")
        .BudgetExhausted -> derivation_json_quote("budget_exhausted")
        .Unknown -> derivation_json_quote("unknown")
    }
}

fn derivation_json_strings(values: [String]) -> String {
    rows := [String]{}
    loop value in values -> &rows.push(derivation_record_quote(value))
    rows.join(",")
}

fn derivation_record_quote(value: String) -> String {
    carriage_return :: String.from_bytes([U8]{13}) ?? ""
    "\"" + &value.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace(carriage_return, "\\r").replace("\t", "\\t") + "\""
}

fn derivation_record_id(record: DerivationRecord) -> String {
    payload := derivation_optional_payload_json(record.payload, "")
    separator :: String.from_bytes([U8]{0}) ?? ""
    premises := record.premises.join(separator)
    state := DerivationHashState{first: 0xcbf29ce484222325, second: 0x9e3779b185ebca87}
    derivation_hash_frame(&state, record.subject)
    derivation_hash_frame(&state, record.claim)
    derivation_hash_frame(&state, record.producer)
    derivation_hash_frame(&state, derivation_method_raw(record.method))
    derivation_hash_frame(&state, record.rule)
    derivation_hash_frame(&state, premises)
    derivation_hash_frame(&state, record.identity.source)
    derivation_hash_frame(&state, record.identity.build)
    derivation_hash_frame(&state, record.identity.run)
    derivation_hash_frame(&state, record.identity.target)
    derivation_hash_frame(&state, payload)
    derivation_hash_hex(state)
}

pub struct DerivationHashState { pub first: Int, pub second: Int }

fn derivation_method_raw(method: MirDerivationMethod) -> String {
    if method == {
        .StaticDerivation -> "static_derivation"
        .FormalProof -> "formal_proof"
        .RecordedExecution -> "recorded_execution"
        .SampledAgreement -> "sampled_agreement"
        .ExternalAssumption -> "external_assumption"
    }
}

fn derivation_hash_frame(state: &DerivationHashState, value: String) {
    bytes := value.bytes()
    length := bytes.len()
    loop index in 0..<8 -> derivation_hash_byte(state, U8{(length >> ((7 - index) * 8)) & 255})
    loop byte in bytes -> derivation_hash_byte(state, byte)
}

fn derivation_hash_byte(state: &DerivationHashState, byte: U8) {
    mask := 0xffffffffffffffff
    value := Int.from_u8(byte)
    state.first = ((state.first ^ value) * 0x100000001b3) & mask
    rotated := ((state.first << 17) | (state.first >> 47)) & mask
    state.second = ((state.second ^ rotated ^ value) * 0x9e3779b185ebca87) & mask
}

fn derivation_hash_hex(state: DerivationHashState) -> String {
    digits := "0123456789abcdef".bytes()
    output := [U8]{}
    loop shift in ([Int]{60, 56, 52, 48, 44, 40, 36, 32, 28, 24, 20, 16, 12, 8, 4, 0}) -> &output.push(digits[(state.first >> shift) & 15])
    loop shift in ([Int]{60, 56, 52, 48, 44, 40, 36, 32, 28, 24, 20, 16, 12, 8, 4, 0}) -> &output.push(digits[(state.second >> shift) & 15])
    String.from_bytes(output) ?? ""
}

fn derivation_json_quote(value: String) -> String {
    bytes := value.bytes()
    output := "\""
    index := 0
    loop index < bytes.len() {
        byte := Int.from_u8(bytes[index])
        if byte == 34 {
            output += "\\\""
            index += 1
            next
        }
        if byte == 92 {
            output += "\\\\"
            index += 1
            next
        }
        if byte == 10 {
            output += "\\n"
            index += 1
            next
        }
        if byte == 13 {
            output += "\\r"
            index += 1
            next
        }
        if byte == 9 {
            output += "\\t"
            index += 1
            next
        }
        if byte < 32 {
            output += "\\u00" + derivation_hex_byte(byte)
            index += 1
            next
        }
        if byte == 194 && index + 1 < bytes.len() {
            following :: Int.from_u8(bytes[index + 1])
            if following >= 128 && following <= 159 {
                output += "\\u00" + derivation_hex_byte(following)
                index += 2
                next
            }
        }
        if byte == 127 {
            output += "\\u007f"
            index += 1
            next
        }
        width := if {
            byte < 128 -> 1
            byte < 224 -> 2
            byte < 240 -> 3
            else -> 4
        }
        output += String.from_bytes(bytes.slice(index, index + width)) ?? ""
        index += width
    }
    output + "\""
}

fn derivation_hex_byte(value: Int) -> String {
    digits := "0123456789abcdef".bytes()
    String.from_bytes([U8]{digits[(value >> 4) & 15], digits[value & 15]}) ?? "00"
}

fn mir_frame_schedule_json(schedule: MirFrameSchedule) -> String {
    operations := [String]{}
    dependencies := [String]{}
    transfers := [String]{}
    reuse := [String]{}
    retentions := [String]{}
    conservative := [String]{}
    loop operation in schedule.operations -> &operations.push(mir_frame_operation_json(operation))
    loop dependency in schedule.dependencies -> &dependencies.push(mir_frame_dependency_json(dependency))
    loop transfer in schedule.transfers -> &transfers.push(mir_frame_transfer_json(transfer))
    loop row in schedule.reuse -> &reuse.push(mir_frame_reuse_json(row))
    loop row in schedule.retentions -> &retentions.push(mir_frame_retention_json(row))
    loop reason in schedule.conservative -> &conservative.push(derivation_json_quote(reason))
    operations_json :: operations.join(",")
    dependencies_json :: dependencies.join(",")
    transfers_json :: transfers.join(",")
    reuse_json :: reuse.join(",")
    retentions_json :: retentions.join(",")
    conservative_json :: conservative.join(",")
    "{{\"schema\":\"jet.frame_schedule/v1\",\"operations\":[{operations_json}],\"dependencies\":[{dependencies_json}],\"transfers\":[{transfers_json}],\"reuse\":[{reuse_json}],\"retentions\":[{retentions_json}],\"conservative\":[{conservative_json}]}}"
}

fn mir_frame_operation_json(operation: MirFrameOperation) -> String {
    accesses := [String]{}
    loop access in operation.accesses -> &accesses.push(mir_resource_access_json(access))
    provider := if operation.completion_provider == None -> "" else -> ",\"completion_provider\":" + derivation_json_quote(operation.completion_provider ?? "")
    accesses_json :: accesses.join(",")
    "{{\"name\":{derivation_json_quote(operation.name)},\"source_index\":{derivation_json_quote(operation.source_index.to_string())},\"accesses\":[{accesses_json}],\"completion\":{mir_frame_completion_json(operation.completion)},\"external_effect\":{derivation_json_bool(operation.external_effect)}{provider}}}"
}

fn mir_resource_access_json(access: MirResourceAccess) -> String {
    "{{\"resource\":{mir_resource_identity_json(access.resource)},\"mode\":{derivation_json_quote(mir_resource_mode_name(access.mode))},\"region\":{mir_resource_region_json(access.region)},\"layout\":{mir_resource_layout_json(access.layout)},\"temporary\":{derivation_json_bool(access.temporary)}}}"
}

fn mir_resource_identity_json(identity: MirResourceIdentity) -> String {
    if identity == {
        .Named(name) -> "{{\"kind\":\"named\",\"value\":{derivation_json_quote(name)}}}"
        .Unknown -> "{{\"kind\":\"unknown\"}}"
    }
}

fn mir_resource_mode_name(mode: MirResourceAccessMode) -> String {
    if mode == {
        .Read -> "read"
        .Write -> "write"
        .Move -> "move"
    }
}

fn mir_resource_region_json(region: MirResourceRegion) -> String {
    if region == {
        .Whole -> "{{\"kind\":\"whole\"}}"
        .Unknown -> "{{\"kind\":\"unknown\"}}"
        .Bytes(start, length) -> "{{\"kind\":\"bytes\",\"start\":{derivation_json_quote(start.to_string())},\"length\":{derivation_json_quote(length.to_string())}}}"
    }
}

fn mir_resource_layout_json(layout: MirResourceLayout?) -> String {
    if layout == None -> return "null"
    value :: layout ?? MirResourceLayout{size: 0, align: 0, layout: "", device: ""}
    "{{\"size\":{derivation_json_quote(value.size.to_string())},\"align\":{derivation_json_quote(value.align.to_string())},\"layout\":{derivation_json_quote(value.layout)},\"device\":{derivation_json_quote(value.device)}}}"
}

fn mir_frame_completion_json(completion: MirFrameCompletion) -> String {
    if completion == {
        .Synchronous -> "{{\"kind\":\"synchronous\"}}"
        .Pending(token) -> "{{\"kind\":\"pending\",\"token\":{derivation_json_quote(token)}}}"
        .Event(token) -> "{{\"kind\":\"event\",\"token\":{derivation_json_quote(token)}}}"
    }
}

fn mir_frame_dependency_json(row: MirFrameDependency) -> String {
    "{{\"before\":{derivation_json_quote(row.before.to_string())},\"after\":{derivation_json_quote(row.after.to_string())},\"resource\":{derivation_json_quote(row.resource)},\"reason\":{derivation_json_quote(row.reason)}}}"
}

fn mir_frame_transfer_json(row: MirFrameTransfer) -> String {
    "{{\"before\":{derivation_json_quote(row.before.to_string())},\"after\":{derivation_json_quote(row.after.to_string())},\"resource\":{derivation_json_quote(row.resource)},\"from_device\":{derivation_json_quote(row.from_device)},\"to_device\":{derivation_json_quote(row.to_device)}}}"
}

fn mir_frame_reuse_json(row: MirFrameReuse) -> String {
    "{{\"previous_resource\":{derivation_json_quote(row.previous_resource)},\"next_resource\":{derivation_json_quote(row.next_resource)},\"previous_last_use\":{derivation_json_quote(row.previous_last_use.to_string())},\"next_first_use\":{derivation_json_quote(row.next_first_use.to_string())},\"legal\":{derivation_json_bool(row.legal)},\"reason\":{derivation_json_quote(row.reason)}}}"
}

fn mir_frame_retention_json(row: MirFrameRetention) -> String {
    token := if row.completion_token == None -> "null" else -> derivation_json_quote(row.completion_token ?? "")
    "{{\"resource\":{derivation_json_quote(row.resource)},\"operation\":{derivation_json_quote(row.operation.to_string())},\"owner\":{derivation_json_quote(row.owner)},\"completion_token\":{token},\"completed\":{derivation_json_bool(row.completed)}}}"
}

fn derivation_json_bool(value: Bool) -> String {
    if value -> "true" else -> "false"
}
