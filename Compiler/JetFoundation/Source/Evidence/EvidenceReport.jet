// Pure EvidenceReport operations reused from origin/port/compiler.
EVIDENCE_REPORT_SCHEMA: "jet.evidence"

EVIDENCE_REPORT_VERSION: U16{3}

EVIDENCE_REPORT_MAGIC: "JETEVID3"

EvidenceReport: struct {
    schema_version: U16
    identity: EvidenceIdentity
    producer: EvidenceProducerKind
    source: EvidenceSource
    build: EvidenceBuild
    revision: EvidenceRevision
    records: [EvidenceRecord]
    derivations: [DerivationRecord]
    attachments: [EvidenceAttachment]
    diagnostics: [EvidenceDiagnostic]
    completeness: EvidenceCompleteness
}

EvidenceProjection: struct {
    evidence_id: String
    claim_id: String
    kind: EvidenceKind
    facet: EvidenceFacet
    producer: EvidenceProducerKind
    expectation: EvidenceExpectation
    outcome: EvidenceOutcome
    source: EvidenceSource
    completeness: EvidenceCompleteness
    chain: [EvidenceChainLink]
    derivation: DerivationRef?
}

#Error
EvidenceMergeError: enum {
    Empty
    SchemaConflict(expected: U16, found: U16)
    IdentityConflict(field: String, expected: String, found: String)
    RecordConflict(String)
    MissingDerivation(evidence_id: String, derivation_id: String)
    InvalidDerivation(String)
    InvalidExpectation(expectation: EvidenceExpectation, outcome: EvidenceOutcome)
}

#Error
EvidenceCodecError: struct {
    message: String
}

evidence_producer_code: fn(value: EvidenceProducerKind) -> Int Never! {
    if value == {
        .Test -> 0
        .Prove -> 1
        .Compile -> 2
        .Runtime -> 3
    }
}

evidence_producer_from_code: fn(code: Int) -> EvidenceProducerKind? Never! {
    if code == {
        0 -> Val(EvidenceProducerKind.Test)
        1 -> Val(EvidenceProducerKind.Prove)
        2 -> Val(EvidenceProducerKind.Compile)
        3 -> Val(EvidenceProducerKind.Runtime)
        else -> None
    }
}

evidence_producer_name: fn(value: EvidenceProducerKind) -> String Never! {
    if value == {
        .Test -> "jet-test"
        .Prove -> "jet-prove"
        .Compile -> "jet-compile"
        .Runtime -> "jet-runtime"
    }
}

evidence_kind_code: fn(value: EvidenceKind) -> Int Never! {
    if value == {
        .Unit -> 0
        .Contract -> 1
        .Runtime -> 2
        .Property -> 3
        .Doctest -> 4
    }
}

evidence_kind_from_code: fn(code: Int) -> EvidenceKind? Never! {
    if code == {
        0 -> Val(EvidenceKind.Unit)
        1 -> Val(EvidenceKind.Contract)
        2 -> Val(EvidenceKind.Runtime)
        3 -> Val(EvidenceKind.Property)
        4 -> Val(EvidenceKind.Doctest)
        else -> None
    }
}

evidence_kind_name: fn(value: EvidenceKind) -> String Never! {
    if value == {
        .Unit -> "unit"
        .Contract -> "contract"
        .Runtime -> "runtime"
        .Property -> "property"
        .Doctest -> "doctest"
    }
}

evidence_facet_code: fn(value: EvidenceFacet) -> Int Never! {
    if value == {
        .All -> 0
        .Refinements -> 1
        .Effects -> 2
        .Taint -> 3
        .Contracts -> 4
        .Tests -> 5
        .Budgets -> 6
        .Replay -> 7
        .Solver -> 8
    }
}

evidence_facet_from_code: fn(code: Int) -> EvidenceFacet? Never! {
    if code == {
        0 -> Val(EvidenceFacet.All)
        1 -> Val(EvidenceFacet.Refinements)
        2 -> Val(EvidenceFacet.Effects)
        3 -> Val(EvidenceFacet.Taint)
        4 -> Val(EvidenceFacet.Contracts)
        5 -> Val(EvidenceFacet.Tests)
        6 -> Val(EvidenceFacet.Budgets)
        7 -> Val(EvidenceFacet.Replay)
        8 -> Val(EvidenceFacet.Solver)
        else -> None
    }
}

evidence_facet_name: fn(value: EvidenceFacet) -> String Never! {
    if value == {
        .All -> "all"
        .Refinements -> "refinements"
        .Effects -> "effects"
        .Taint -> "taint"
        .Contracts -> "contracts"
        .Tests -> "tests"
        .Budgets -> "budgets"
        .Replay -> "replay"
        .Solver -> "solver"
    }
}

evidence_facet_for_kind: fn(kind: EvidenceKind) -> EvidenceFacet Never! {
    if kind == EvidenceKind.Contract -> EvidenceFacet.Contracts else -> EvidenceFacet.Tests
}

evidence_outcome_code: fn(value: EvidenceOutcome) -> Int Never! {
    if value == {
        .Proved -> 0
        .Generated -> 1
        .Passed -> 2
        .Failed -> 3
        .Checked -> 4
        .Unchecked -> 5
        .Unavailable -> 6
        .Incomplete -> 7
        .NotObserved -> 8
        .Skipped -> 9
        .Error -> 10
    }
}

evidence_outcome_from_code: fn(code: Int) -> EvidenceOutcome? Never! {
    if code == {
        0 -> Val(EvidenceOutcome.Proved)
        1 -> Val(EvidenceOutcome.Generated)
        2 -> Val(EvidenceOutcome.Passed)
        3 -> Val(EvidenceOutcome.Failed)
        4 -> Val(EvidenceOutcome.Checked)
        5 -> Val(EvidenceOutcome.Unchecked)
        6 -> Val(EvidenceOutcome.Unavailable)
        7 -> Val(EvidenceOutcome.Incomplete)
        8 -> Val(EvidenceOutcome.NotObserved)
        9 -> Val(EvidenceOutcome.Skipped)
        10 -> Val(EvidenceOutcome.Error)
        else -> None
    }
}

evidence_outcome_from_test_state: fn(state: Int) -> EvidenceOutcome? Never! {
    if state == {
        0 -> Val(EvidenceOutcome.Passed)
        1 -> Val(EvidenceOutcome.Failed)
        2 -> Val(EvidenceOutcome.Skipped)
        3 -> Val(EvidenceOutcome.Unavailable)
        4 -> Val(EvidenceOutcome.Error)
        else -> None
    }
}

evidence_outcome_test_state: fn(value: EvidenceOutcome) -> Int? Never! {
    if value == {
        .Passed -> Val(0)
        .Failed -> Val(1)
        .Skipped -> Val(2)
        .Unavailable -> Val(3)
        .Error -> Val(4)
        .Proved | .Generated | .Checked | .Unchecked | .Incomplete | .NotObserved -> None
    }
}

evidence_expectation_code: fn(value: EvidenceExpectation) -> Int Never! {
    if value == EvidenceExpectation.Ordinary -> 0 else -> 1
}

evidence_merge_error_text: fn(error: EvidenceMergeError) -> String Never! {
    if error == {
        .Empty -> "cannot merge an empty evidence report set"
        .SchemaConflict(expected, found) -> "evidence report schema conflict: {expected} versus {found}"
        .IdentityConflict(field, expected, found) -> "evidence report identity conflict for {field}: {expected} versus {found}"
        .RecordConflict(id) -> "evidence record conflict for {id}"
        .MissingDerivation(id, reason) -> "evidence record {id} references missing derivation {reason}"
        .InvalidDerivation(message) -> "invalid derivation: {message}"
        .InvalidExpectation(expectation, outcome) -> evidence_expectation_error_text(EvidenceExpectationError.InvalidOutcome{expectation: expectation, outcome: outcome})
    }
}

evidence_merge_error_from_expectation: fn(error: EvidenceExpectationError) -> EvidenceMergeError Never! {
    if error == {
        .InvalidOutcome(expectation, outcome) -> EvidenceMergeError.InvalidExpectation{expectation: expectation, outcome: outcome}
    }
}

evidence_completeness_code: fn(value: EvidenceCompleteness) -> Int Never! {
    if value == {
        .Complete -> 0
        .Incomplete(_) -> 1
        .Unavailable(_) -> 2
    }
}

evidence_completeness_state: fn(value: EvidenceCompleteness) -> String Never! {
    if value == {
        .Complete -> "complete"
        .Incomplete(_) -> "incomplete"
        .Unavailable(_) -> "unavailable"
    }
}

evidence_completeness_reason: fn(value: EvidenceCompleteness) -> String? Never! {
    if value == {
        .Complete -> None
        .Incomplete(reason) -> Val(reason)
        .Unavailable(reason) -> Val(reason)
    }
}

evidence_completeness_merge: fn(value: &EvidenceCompleteness, other: EvidenceCompleteness) Never! {
    // copy: the merged completeness (owner: `value`, the merged report) takes the more severe state
    // while `other` stays with its record (owner: the caller's record or report, read again
    // afterwards).
    if evidence_completeness_code(other) > evidence_completeness_code(value) -> value = other.copy()
}

evidence_source_empty: fn() -> EvidenceSource Never! {
    EvidenceSource{path: "", line: U32{0}, column: U32{0}}
}

evidence_build_empty: fn() -> EvidenceBuild Never! {
    EvidenceBuild{toolchain: "", target: "", profile: ""}
}

evidence_revision_empty: fn() -> EvidenceRevision Never! {
    EvidenceRevision{source: "", build: "", revision: ""}
}

// Rust stable_token: reuse the identical canonical derivation framed hash.
evidence_identity_for_record: fn(report_id: String, claim_id: String, producer: EvidenceProducerKind, kind: EvidenceKind, source: EvidenceSource, count: U64, detail: String) -> EvidenceIdentity Never! {
    state := DerivationHashState{first: U64{0xcbf29ce484222325}, second: U64{0x9e3779b185ebca87}}
    derivation_hash_frame(state, report_id)
    derivation_hash_frame(state, claim_id)
    derivation_hash_frame(state, evidence_producer_name(producer))
    derivation_hash_frame(state, evidence_kind_name(kind))
    derivation_hash_frame(state, source.path)
    derivation_hash_frame(state, source.line.to_string())
    derivation_hash_frame(state, source.column.to_string())
    derivation_hash_frame(state, count.to_string())
    derivation_hash_frame(state, detail)
    EvidenceIdentity{report_id: report_id, claim_id: claim_id, evidence_id: derivation_hash_hex(state)}
}

evidence_record_new: fn(identity: EvidenceIdentity, kind: EvidenceKind, producer: EvidenceProducerKind, outcome: EvidenceOutcome, count: U64, source: EvidenceSource, build: EvidenceBuild, revision: EvidenceRevision) -> EvidenceRecord Never! {
    completeness: if {
        outcome == EvidenceOutcome.Unavailable -> EvidenceCompleteness.Unavailable{reason: "producer unavailable"}
        evidence_outcome_is_incomplete(outcome) -> EvidenceCompleteness.Incomplete{reason: evidence_outcome_name(outcome)}
        else -> EvidenceCompleteness.Complete
    }
    EvidenceRecord{identity: identity, kind: kind, facet: evidence_facet_for_kind(kind), producer: producer, outcome: outcome, expectation: EvidenceExpectation.Ordinary, count: count, source: source, build: build, revision: revision, detail: "", attachments: [EvidenceAttachment]{}, diagnostics: [EvidenceDiagnostic]{}, completeness: completeness, chain: [EvidenceChainLink]{}, derivation: None}
}

evidence_record_set_expectation: fn(record: &EvidenceRecord, expectation: EvidenceExpectation) EvidenceExpectationError! {
    evidence_expectation_validate(expectation, record.outcome)
    record.expectation = expectation
    return
}

evidence_record_with_expectation: fn(record: &&EvidenceRecord, expectation: EvidenceExpectation) -> EvidenceRecord EvidenceExpectationError! {
    value := record
    evidence_record_set_expectation(value, expectation)
    Ok(value)
}

evidence_record_set_derivation: fn(record: &EvidenceRecord, derivation: DerivationRecord) Never! {
    record.derivation = Val(derivation_record_reference(derivation))
}

evidence_record_checked_derivation: fn(record: EvidenceRecord) -> DerivationRecord Never! {
    method: if record.kind == EvidenceKind.Property -> DerivationMethod.SampledAgreement else -> DerivationMethod.RecordedExecution
    value := derivation_record(record.identity.evidence_id, record.identity.claim_id, evidence_producer_name(record.producer), method, "evidence-record", [String]{record.identity.claim_id, record.identity.evidence_id}, derivation_identity(record.revision.source, record.revision.build, record.revision.revision, record.build.target))
    if evidence_outcome_is_incomplete(record.outcome) || record.outcome == EvidenceOutcome.Unchecked {
        value.disposition = DerivationDisposition.Unavailable
    }
    value
}

evidence_report_new: fn(report_id: String, producer: EvidenceProducerKind, source: EvidenceSource, build: EvidenceBuild, revision: EvidenceRevision) -> EvidenceReport Never! {
    EvidenceReport{schema_version: EVIDENCE_REPORT_VERSION, identity: EvidenceIdentity{report_id: report_id, claim_id: "", evidence_id: ""}, producer: producer, source: source, build: build, revision: revision, records: [EvidenceRecord]{}, derivations: [DerivationRecord]{}, attachments: [EvidenceAttachment]{}, diagnostics: [EvidenceDiagnostic]{}, completeness: EvidenceCompleteness.Complete}
}

evidence_report_derivation: fn(report: EvidenceReport, reference: DerivationRef) -> DerivationRecord? Never! {
    loop item in report.derivations {
        if item.id == reference.id -> return Val(item)
    }
    None
}

evidence_report_intern_derivation: fn(report: &EvidenceReport, derivation: &&DerivationRecord) -> DerivationRef Never! {
    loop item in report.derivations {
        if item.id == derivation.id -> return derivation_record_reference(item)
    }
    reference: derivation_record_reference(derivation)
    report.derivations.push(derivation)
    report.derivations = loop fresh_item in report.derivations -> fresh_item
    report.derivations.sort_by((left: DerivationRecord, right: DerivationRecord) -> left.id <=> right.id)
    reference
}

evidence_report_add_record_with_derivation: fn(report: &EvidenceReport, record: &&EvidenceRecord, derivation: &&DerivationRecord) EvidenceMergeError! {
    if !derivation_record_validate(derivation) {
        return Err(EvidenceMergeError.InvalidDerivation("derivation {derivation.id} has a non-canonical identity"))
    }
    value := record
    value.derivation = Val(evidence_report_intern_derivation(report, derivation))
    evidence_report_add_record(report, value)
}

evidence_report_add_record: fn(report: &EvidenceReport, record: &&EvidenceRecord) EvidenceMergeError! {
    if evidence_record_validate(record) == {
        .Err(error) -> return Err(evidence_merge_error_from_expectation(error))
        .Ok(_) -> {}
    }
    if record.identity.report_id != report.identity.report_id {
        return Err(EvidenceMergeError.IdentityConflict{field: "report_id", expected: report.identity.report_id, found: record.identity.report_id})
    }
    if record.derivation == {
        .Val(reference) -> {
            derivation: evidence_report_derivation(report, reference) ?? return Err(EvidenceMergeError.MissingDerivation{evidence_id: record.identity.evidence_id, derivation_id: reference.id})
            if derivation.identity != derivation_identity(record.revision.source, record.revision.build, record.revision.revision, record.build.target) {
                return Err(EvidenceMergeError.InvalidDerivation("derivation {derivation.id} provenance does not match evidence {record.identity.evidence_id}"))
            }
        }
        .None -> {}
    }
    loop existing in report.records {
        if existing.identity.evidence_id == record.identity.evidence_id {
            if existing == record {
                return
            }
            return Err(EvidenceMergeError.RecordConflict(record.identity.evidence_id))
        }
    }
    evidence_completeness_merge(report.completeness, record.completeness)
    report.records.push(record)
    report.records = loop fresh_item in report.records -> fresh_item
    report.records.sort_by((left: EvidenceRecord, right: EvidenceRecord) -> evidence_record_order(left, right))
    return
}

evidence_report_try_from_records: fn(report_id: String, records: &&[EvidenceRecord], derivations: &&[DerivationRecord]) -> EvidenceReport EvidenceMergeError! {
    report := evidence_report_new(report_id, EvidenceProducerKind.Test, evidence_source_empty(), evidence_build_empty(), evidence_revision_empty())
    if records.len() > 0 {
        report.producer = records[0].producer
        report.source = records[0].source.copy()
        report.build = records[0].build.copy()
        report.revision = records[0].revision.copy()
    }
    loop derivation_item in derivations {
        if !derivation_record_validate(derivation_item) {
            return Err(EvidenceMergeError.InvalidDerivation("derivation {derivation_item.id} has a non-canonical identity"))
        }
        _: evidence_report_intern_derivation(report, derivation_item)
    }
    loop record_item in records {
        if record_item.derivation != None -> evidence_report_add_record(report, record_item) else {
            derivation: evidence_record_checked_derivation(record_item)
            evidence_report_add_record_with_derivation(report, record_item, derivation)
        }
    }
    Ok(report)
}

// Infallible construction is an assertion, not a fabricated empty report or a
// swallowed merge error.
evidence_report_from_records: fn(report_id: String, records: &&[EvidenceRecord]) -> EvidenceReport Never! {
    evidence_report_try_from_records(report_id, records, [DerivationRecord]{}) ?? panic("evidence records in one report must share report identity")
}

evidence_report_is_complete: fn(report: EvidenceReport) -> Bool Never! {
    if report.completeness != EvidenceCompleteness.Complete -> return false
    loop record in report.records {
        if record.completeness != EvidenceCompleteness.Complete -> return false
    }
    true
}

evidence_report_query: fn(report: EvidenceReport, claim_id: String?) -> [EvidenceProjection] Never! {
    rows := [EvidenceProjection]{}
    loop record in report.records {
        if claim_id == {
            .Val(claim) -> {
                if claim != record.identity.claim_id -> next
            }
            .None -> {}
        }
        rows.push(evidence_projection_from_record(record))
    }
    rows.sort_by((left: EvidenceProjection, right: EvidenceProjection) -> evidence_projection_order(left, right))
    rows
}

evidence_projection_from_record: fn(record: EvidenceRecord) -> EvidenceProjection Never! {
    chain := record.chain.copy()
    chain = loop fresh_item in chain -> fresh_item
    chain.sort_by((left: EvidenceChainLink, right: EvidenceChainLink) -> evidence_chain_order(left, right))
    EvidenceProjection{evidence_id: record.identity.evidence_id, claim_id: record.identity.claim_id, kind: record.kind, facet: record.facet, producer: record.producer, expectation: record.expectation, outcome: record.outcome, source: record.source, completeness: record.completeness, chain: chain, derivation: record.derivation}
}

evidence_source_order: fn(left: EvidenceSource, right: EvidenceSource) -> Ordering Never! {
    order: left.path <=> right.path
    if order != Ordering.Equal -> return order
    line: left.line <=> right.line
    if line != Ordering.Equal -> return line
    left.column <=> right.column
}

evidence_record_order: fn(left: EvidenceRecord, right: EvidenceRecord) -> Ordering Never! {
    source: evidence_source_order(left.source, right.source)
    if source != Ordering.Equal -> return source
    producer: evidence_producer_code(left.producer) <=> evidence_producer_code(right.producer)
    if producer != Ordering.Equal -> return producer
    kind: evidence_kind_code(left.kind) <=> evidence_kind_code(right.kind)
    if kind != Ordering.Equal -> return kind
    facet: evidence_facet_code(left.facet) <=> evidence_facet_code(right.facet)
    if facet != Ordering.Equal -> return facet
    left.identity.evidence_id <=> right.identity.evidence_id
}

evidence_projection_order: fn(left: EvidenceProjection, right: EvidenceProjection) -> Ordering Never! {
    source: evidence_source_order(left.source, right.source)
    if source != Ordering.Equal -> return source
    producer: evidence_producer_code(left.producer) <=> evidence_producer_code(right.producer)
    if producer != Ordering.Equal -> return producer
    facet: evidence_facet_code(left.facet) <=> evidence_facet_code(right.facet)
    if facet != Ordering.Equal -> return facet
    left.evidence_id <=> right.evidence_id
}

evidence_attachment_order: fn(left: EvidenceAttachment, right: EvidenceAttachment) -> Ordering Never! {
    (left.name <=> right.name).then(left.value <=> right.value)
}

evidence_chain_order: fn(left: EvidenceChainLink, right: EvidenceChainLink) -> Ordering Never! {
    (left.evidence_id <=> right.evidence_id).then(left.relation <=> right.relation)
}

evidence_diagnostic_order: fn(left: EvidenceDiagnostic, right: EvidenceDiagnostic) -> Ordering Never! {
    code: left.code <=> right.code
    if code != Ordering.Equal -> return code
    message: left.message <=> right.message
    if message != Ordering.Equal -> return message
    if left.source == {
        .None -> {
            if right.source == .None -> return Ordering.Equal
            return Ordering.Less

        }
        .Val(source) -> {
            other: right.source ?? return Ordering.Greater
            return evidence_source_order(source, other)

        }
    }
}

// Sorted index vectors borrow payloads; canonical output never clones records.
evidence_sorted_record_indices: fn(report: EvidenceReport) -> [Int] Never! {
    indices := [Int]{}
    loop index in 0..<report.records.len() -> indices.push(index)
    indices.sort_by((left: Int, right: Int) -> evidence_record_order(report.records[left], report.records[right]))
    indices
}

// record_from_test_codes, with the host's environment-derived provenance
// supplied explicitly. Encoding/inspection needs no Core.files.
evidence_record_from_test_codes: fn(kind_code: Int, state: Int, name: String, message: String, file: String, line: U32, report_id: String, build: EvidenceBuild, revision: EvidenceRevision) -> EvidenceRecord EvidenceCodecError! {
    kind: evidence_kind_from_code(kind_code) ?? return Err(evidence_codec_error("unknown evidence kind {kind_code}"))
    outcome: if kind == EvidenceKind.Property && state == 0 -> EvidenceOutcome.Generated else -> evidence_outcome_from_test_state(state) ?? return Err(evidence_codec_error("unknown evidence state {state}"))
    source: EvidenceSource{path: file, line: if kind == EvidenceKind.Property -> U32{0} else -> line, column: U32{1}}
    count: if kind == EvidenceKind.Property -> U64{Int.from_u32(line)} else -> U64{1}
    identity: evidence_identity_for_record(report_id, if name == "" -> "<anonymous>" else -> name, EvidenceProducerKind.Test, kind, source, count, message)
    record := evidence_record_new(identity, kind, EvidenceProducerKind.Test, outcome, count, source, build, revision)
    record.detail = message
    if message != "" -> record.attachments.push(EvidenceAttachment{name: "detail", value: message})
    if evidence_outcome_is_failure(outcome) {
        code: if kind == EvidenceKind.Runtime && name.starts_with("E") -> name else -> "E3001"
        record.diagnostics.push(EvidenceDiagnostic{code: code, message: message, source: Val(source)})
    }
    Ok(record)
}
