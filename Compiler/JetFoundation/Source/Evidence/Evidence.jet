// Canonical typed evidence (crates/jet-foundation/src/Evidence.rs): the
// record shape and its outcome/expectation law. Evidence never implies a
// stronger claim than the producer actually observed.

pub enum EvidenceProducerKind { Test Prove Compile Runtime }

pub enum EvidenceKind { Unit Contract Runtime Property Doctest }

pub enum EvidenceFacet { All Refinements Effects Taint Contracts Tests Budgets Replay Solver }

pub enum EvidenceOutcome { Proved Generated Passed Failed Checked Unchecked Unavailable Incomplete NotObserved Skipped Error }

pub enum EvidenceExpectation { Ordinary ExpectedFailure }

pub enum EvidenceCompleteness {
    Complete
    Incomplete(reason: String)
    Unavailable(reason: String)
}

pub struct EvidenceIdentity {
    pub report_id: String
    pub claim_id: String
    pub evidence_id: String
}

pub struct EvidenceSource {
    pub path: String
    pub line: U32
    pub column: U32
}

pub struct EvidenceBuild {
    pub toolchain: String
    pub target: String
    pub profile: String
}

pub struct EvidenceRevision {
    pub source: String
    pub build: String
    pub revision: String
}

pub struct EvidenceAttachment {
    pub name: String
    pub value: String
}

pub struct EvidenceDiagnostic {
    pub code: String
    pub message: String
    pub source: EvidenceSource?
}

pub struct EvidenceChainLink {
    pub evidence_id: String
    pub relation: String
}

pub struct EvidenceRecord {
    pub identity: EvidenceIdentity
    pub kind: EvidenceKind
    pub facet: EvidenceFacet
    pub producer: EvidenceProducerKind
    pub outcome: EvidenceOutcome
    pub expectation: EvidenceExpectation
    pub count: U64
    pub source: EvidenceSource
    pub build: EvidenceBuild
    pub revision: EvidenceRevision
    pub detail: String
    pub attachments: [EvidenceAttachment]
    pub diagnostics: [EvidenceDiagnostic]
    pub completeness: EvidenceCompleteness
    pub chain: [EvidenceChainLink]
    // Interned reason link; the containing report holds the canonical payload.
    pub derivation: MIRDerivationRef?
}

#Error
pub enum EvidenceExpectationError {
    InvalidOutcome(expectation: EvidenceExpectation, outcome: EvidenceOutcome)
}

// Rust `EvidenceOutcome::as_str`.
pub fn evidence_outcome_name(value: EvidenceOutcome) -> String Never! {
    if value == {
        .Proved -> "proved"
        .Generated -> "generated"
        .Passed -> "passed"
        .Failed -> "failed"
        .Checked -> "checked"
        .Unchecked -> "unchecked"
        .Unavailable -> "unavailable"
        .Incomplete -> "incomplete"
        .NotObserved -> "not_observed"
        .Skipped -> "skipped"
        .Error -> "error"
    }
}

// Rust `EvidenceOutcome::is_failure`.
pub fn evidence_outcome_is_failure(value: EvidenceOutcome) -> Bool Never! {
    if value == {
        .Failed | .Error -> true
        else -> false
    }
}

// Rust `EvidenceOutcome::is_incomplete`.
pub fn evidence_outcome_is_incomplete(value: EvidenceOutcome) -> Bool Never! {
    if value == {
        .Unavailable | .Incomplete | .NotObserved | .Skipped -> true
        else -> false
    }
}

// Rust `EvidenceExpectation::as_str`.
pub fn evidence_expectation_name(value: EvidenceExpectation) -> String Never! {
    if value == {
        .Ordinary -> "ordinary"
        .ExpectedFailure -> "expected_failure"
    }
}

// Rust `EvidenceExpectation::validate`: an expected failure describes only a
// failed or (unexpectedly) passed observation.
pub fn evidence_expectation_validate(expectation: EvidenceExpectation, outcome: EvidenceOutcome) EvidenceExpectationError! {
    if expectation == EvidenceExpectation.ExpectedFailure && outcome != EvidenceOutcome.Failed && outcome != EvidenceOutcome.Passed {
        return Err(EvidenceExpectationError.InvalidOutcome{expectation: expectation, outcome: outcome})
    }
}

// Rust `Display for EvidenceExpectationError`.
pub fn evidence_expectation_error_text(error: EvidenceExpectationError) -> String Never! {
    if error == {
        .InvalidOutcome(expectation, outcome) -> "evidence expectation {evidence_expectation_name(expectation)} cannot describe outcome {evidence_outcome_name(outcome)}"
    }
}

// Rust `EvidenceRecord::validate`.
pub fn evidence_record_validate(record: EvidenceRecord) EvidenceExpectationError! {
    evidence_expectation_validate(record.expectation, record.outcome)
}

// Rust `EvidenceRecord::is_expected_failure`.
pub fn evidence_record_is_expected_failure(record: EvidenceRecord) -> Bool Never! {
    record.outcome == EvidenceOutcome.Failed && record.expectation == EvidenceExpectation.ExpectedFailure
}

// Rust `EvidenceRecord::is_unexpected_pass`.
pub fn evidence_record_is_unexpected_pass(record: EvidenceRecord) -> Bool Never! {
    record.outcome == EvidenceOutcome.Passed && record.expectation == EvidenceExpectation.ExpectedFailure
}
