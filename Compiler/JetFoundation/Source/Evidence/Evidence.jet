// Canonical typed evidence: the record shape and its outcome/expectation law.
// Evidence never implies a stronger claim than the producer actually observed.

EvidenceProducerKind: enum { Test Prove Compile Runtime }

EvidenceKind: enum { Unit Contract Runtime Property Doctest }

EvidenceFacet: enum { All Refinements Effects Taint Contracts Tests Budgets Replay Solver }

EvidenceOutcome: enum { Proved Generated Passed Failed Checked Unchecked Unavailable Incomplete NotObserved Skipped Error }

EvidenceExpectation: enum { Ordinary ExpectedFailure }

EvidenceCompleteness: enum {
    Complete
    Incomplete(reason: String)
    Unavailable(reason: String)
}

EvidenceIdentity: struct {
    report_id: String
    claim_id: String
    evidence_id: String
}

EvidenceSource: struct {
    path: String
    line: U32
    column: U32
}

EvidenceBuild: struct {
    toolchain: String
    target: String
    profile: String
}

EvidenceRevision: struct {
    source: String
    build: String
    revision: String
}

EvidenceAttachment: struct {
    name: String
    value: String
}

EvidenceDiagnostic: struct {
    code: String
    message: String
    source: EvidenceSource?
}

EvidenceChainLink: struct {
    evidence_id: String
    relation: String
}

EvidenceRecord: struct {
    identity: EvidenceIdentity
    kind: EvidenceKind
    facet: EvidenceFacet
    producer: EvidenceProducerKind
    outcome: EvidenceOutcome
    expectation: EvidenceExpectation
    count: U64
    source: EvidenceSource
    build: EvidenceBuild
    revision: EvidenceRevision
    detail: String
    attachments: [EvidenceAttachment]
    diagnostics: [EvidenceDiagnostic]
    completeness: EvidenceCompleteness
    chain: [EvidenceChainLink]
    // Interned reason link; the containing report holds the canonical payload.
    derivation: DerivationRef?
}

#Error
EvidenceExpectationError: enum {
    InvalidOutcome(expectation: EvidenceExpectation, outcome: EvidenceOutcome)
}

// Rust `EvidenceOutcome::as_str`.
evidence_outcome_name: fn(value: EvidenceOutcome) -> String Never! {
    if value == {
        .Proved -> "proved"
        .Generated -> "generated"
        .Passed -> "passed"
        .Failed -> "failed"
        .Checked -> "checked"
        .Unchecked -> "unchecked"
        .Unavailable -> "unavailable"
        .Incomplete -> "incomplete"
        .NotObserved -> "not_observed"
        .Skipped -> "skipped"
        .Error -> "error"
    }
}

// Rust `EvidenceOutcome::is_failure`.
evidence_outcome_is_failure: fn(value: EvidenceOutcome) -> Bool Never! {
    if value == {
        .Failed | .Error -> true
        .Proved | .Generated | .Passed | .Checked | .Unchecked | .Unavailable | .Incomplete | .NotObserved | .Skipped -> false
    }
}

// Rust `EvidenceOutcome::is_incomplete`.
evidence_outcome_is_incomplete: fn(value: EvidenceOutcome) -> Bool Never! {
    if value == {
        .Unavailable | .Incomplete | .NotObserved | .Skipped -> true
        .Proved | .Generated | .Passed | .Failed | .Checked | .Unchecked | .Error -> false
    }
}

// Rust `EvidenceExpectation::as_str`.
evidence_expectation_name: fn(value: EvidenceExpectation) -> String Never! {
    if value == {
        .Ordinary -> "ordinary"
        .ExpectedFailure -> "expected_failure"
    }
}

// Rust `EvidenceExpectation::validate`: an expected failure describes only a
// failed or (unexpectedly) passed observation.
evidence_expectation_validate: fn(expectation: EvidenceExpectation, outcome: EvidenceOutcome) EvidenceExpectationError! {
    if expectation == EvidenceExpectation.ExpectedFailure && outcome != EvidenceOutcome.Failed && outcome != EvidenceOutcome.Passed {
        return Err(EvidenceExpectationError.InvalidOutcome{expectation: expectation, outcome: outcome})
    }
}

// Rust `Display for EvidenceExpectationError`.
evidence_expectation_error_text: fn(error: EvidenceExpectationError) -> String Never! {
    if error == {
        .InvalidOutcome(expectation, outcome) -> "evidence expectation {evidence_expectation_name(expectation)} cannot describe outcome {evidence_outcome_name(outcome)}"
    }
}

// Rust `EvidenceRecord::validate`.
evidence_record_validate: fn(record: EvidenceRecord) EvidenceExpectationError! {
    evidence_expectation_validate(record.expectation, record.outcome)
}

// Rust `EvidenceRecord::is_expected_failure`.
evidence_record_is_expected_failure: fn(record: EvidenceRecord) -> Bool Never! {
    record.outcome == EvidenceOutcome.Failed && record.expectation == EvidenceExpectation.ExpectedFailure
}

// Rust `EvidenceRecord::is_unexpected_pass`.
evidence_record_is_unexpected_pass: fn(record: EvidenceRecord) -> Bool Never! {
    record.outcome == EvidenceOutcome.Passed && record.expectation == EvidenceExpectation.ExpectedFailure
}
