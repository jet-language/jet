// Host edges of Evidence.rs: the environment that names a report and its build
// provenance, and whole-report file IO. The codec itself stays host-free.
use core.sys as evidence_sys
use core.files as evidence_files

EVIDENCE_REPORT_ENV :: "JET_EVIDENCE_REPORT"
EVIDENCE_REPORT_ID_ENV :: "JET_EVIDENCE_REPORT_ID"
EVIDENCE_TOOLCHAIN_ENV :: "JET_EVIDENCE_TOOLCHAIN"
EVIDENCE_TARGET_ENV :: "JET_EVIDENCE_TARGET"
EVIDENCE_PROFILE_ENV :: "JET_EVIDENCE_PROFILE"
EVIDENCE_SOURCE_REVISION_ENV :: "JET_EVIDENCE_SOURCE_REVISION"
EVIDENCE_BUILD_REVISION_ENV :: "JET_EVIDENCE_BUILD_REVISION"
EVIDENCE_REVISION_ENV :: "JET_EVIDENCE_REVISION"

// EvidenceBuild::from_environment: an unset variable is the empty string.
fn evidence_build_from_environment() -[Env]> EvidenceBuild Never! {
    EvidenceBuild{toolchain: evidence_sys.get(EVIDENCE_TOOLCHAIN_ENV) ?? "", target: evidence_sys.get(EVIDENCE_TARGET_ENV) ?? "", profile: evidence_sys.get(EVIDENCE_PROFILE_ENV) ?? ""}
}

// EvidenceRevision::from_environment.
fn evidence_revision_from_environment() -[Env]> EvidenceRevision Never! {
    EvidenceRevision{source: evidence_sys.get(EVIDENCE_SOURCE_REVISION_ENV) ?? "", build: evidence_sys.get(EVIDENCE_BUILD_REVISION_ENV) ?? "", revision: evidence_sys.get(EVIDENCE_REVISION_ENV) ?? ""}
}

// The report id a test producer stamps on its records; "test-run" when unset.
fn evidence_report_id_from_environment() -[Env]> String Never! {
    evidence_sys.get(EVIDENCE_REPORT_ID_ENV) ?? "test-run"
}

// EvidenceRecord::from_test_codes with its provenance read from the environment.
fn evidence_record_from_test_environment(kind_code: Int, state: Int, name: String, message: String, file: String, line: U32) -[Env]> EvidenceRecord EvidenceCodecError! {
    evidence_record_from_test_codes(kind_code, state, name, message, file, line, evidence_report_id_from_environment(), evidence_build_from_environment(), evidence_revision_from_environment())
}

// EvidenceReport::read.
fn evidence_report_read(path: String) -[FS.Read]> EvidenceReport EvidenceCodecError! {
    bytes :: if evidence_files.read_bytes(path) == {
        .Ok(value) -> value
        .Err(error) -> { return Err(evidence_codec_error("{error}")) }
    }
    evidence_report_from_bytes(bytes, U64.MAX)
}

// EvidenceReport::write.
fn evidence_report_write(report: EvidenceReport, path: String) EvidenceCodecError! -[FS.Write]> {
    bytes :: evidence_report_encode(report)
    if evidence_files.write_bytes(path, bytes) == {
        .Ok(_) -> return
        .Err(error) -> { return Err(evidence_codec_error("{error}")) }
    }
}

// Rust Evidence.rs:24 `MAX_REPORT_BYTES`.
EVIDENCE_MAX_REPORT_BYTES :: 16777216

// The capture context a test producer stamps on its records: the running
// test's declared expectation and whether a property case catches its stops.
// Rust keeps both in thread-locals scoped by `jet_evidence_with_expectation`
// and `jet_evidence_with_property_case` (Evidence.rs:1315-1351); Core has no
// task-local storage, so the harness that runs the test passes them in.
struct EvidenceCaptureContext {
    expectation: EvidenceExpectation
    property_case: Bool
}

fn evidence_capture_context(expected_failure: Bool, property_case: Bool) -> EvidenceCaptureContext Never! {
    EvidenceCaptureContext{expectation: if expected_failure -> EvidenceExpectation.ExpectedFailure else -> EvidenceExpectation.Ordinary, property_case: property_case}
}

// Rust Evidence.rs:2092 `stable_token`: the framed FNV/golden-ratio pair.
fn evidence_stable_token(parts: [String]) -> String Never! {
    state := DerivationHashState{first: U64{0xcbf29ce484222325}, second: U64{0x9e3779b185ebca87}}
    loop part in parts -> derivation_hash_frame(&state, part)
    derivation_hash_hex(state)
}

// Rust Evidence.rs:1354 `write_record_from_codes`.
fn evidence_write_record_from_codes(path: String, kind: Int, state: Int, name: String, message: String, file: String, line: U32, context: EvidenceCaptureContext) EvidenceCodecError! -[FS, Env]> {
    record := evidence_record_from_test_environment(kind, state, name, message, file, line)
    if record.outcome == EvidenceOutcome.Passed || record.outcome == EvidenceOutcome.Failed {
        if evidence_record_set_expectation(&record, context.expectation) == .Err(error) -> return Err(evidence_codec_error(evidence_expectation_error_text(error)))
    }
    if (record.kind == EvidenceKind.Runtime || record.kind == EvidenceKind.Contract) && context.property_case {
        &record.attachments.push(EvidenceAttachment{name: "caught_by", value: "property_case"})
        // The same site can stop in both a sampled case and an ordinary test.
        // Those observations have different capture provenance, so they must
        // remain distinct records rather than conflict during report merging.
        record.identity.evidence_id = evidence_stable_token([String]{record.identity.evidence_id, "caught_by", "property_case"})
    }
    derivation :: evidence_record_checked_derivation(record)
    evidence_record_set_derivation(&record, derivation)
    evidence_write_record_with_derivation(path, record, derivation)
}

// Rust Evidence.rs:1385 `write_record_with_derivation`.
fn evidence_write_record_with_derivation(path: String, record: EvidenceRecord, derivation: DerivationRecord) EvidenceCodecError! -[FS, Env]> {
    frame := [U8]{}
    evidence_encode_record_with_derivation(record, derivation, &frame)
    evidence_append_frame(path, frame)
}

// Generated test and contract code calls this producer (Rust Evidence.rs:1400
// `jet_evidence_record_write`): no report path, no record; a failed write is
// dropped, as in Rust.
fn evidence_record_write(kind: Int, state: Int, name: String, message: String, file: String, line: U32, context: EvidenceCaptureContext) Never! -[FS, Env]> {
    path :: evidence_sys.get(EVIDENCE_REPORT_ENV) ?? return
    evidence_write_record_from_codes(path, kind, state, name, message, file, line, context).drop("evidence is best effort; the test outcome stands without it")
}

// Rust Evidence.rs:1480 `append_frame`: one frame appended under the report's
// exclusive lock, writing the header into an empty report and refusing a
// report whose header is another schema. Rust serializes the appends of one
// process with a mutex; the exclusive OS lock on the report also serializes
// concurrent test processes sharing it.
fn evidence_append_frame(path: String, frame: [U8]) EvidenceCodecError! -[FS, Env]> {
    if frame.len() > EVIDENCE_MAX_REPORT_BYTES -> return Err(evidence_codec_error("evidence record exceeds the 16 MiB limit"))
    writer := if evidence_files.append(path) == {
        .Ok(opened) -> opened
        .Err(error) -> { return Err(evidence_codec_error("{error}")) }
    }
    guard :: if evidence_files.lock(path) == {
        .Ok(held) -> held
        .Err(error) -> {
            close(^writer)
            return Err(evidence_codec_error("{error}"))
        }
    }
    result :: evidence_append_locked(path, &writer, frame)
    close(^writer)
    close(^guard)
    result
}

fn evidence_append_locked(path: String, writer: &evidence_files.FileWriter, frame: [U8]) EvidenceCodecError! -[FS]> {
    info :: writer.stat() ?? return Err(evidence_codec_error("{err}"))
    if info.size == 0 {
        header := EVIDENCE_REPORT_MAGIC.bytes()
        evidence_put_number(&header, U64.from_u16(EVIDENCE_REPORT_VERSION), 2)
        writer.write_all(header) ?? return Err(evidence_codec_error("{err}"))
    } else if info.size < 10 {
        return Err(evidence_codec_error("truncated evidence report header"))
    } else {
        header :: evidence_read_header(path) ?? return Err(evidence_codec_error("{err}"))
        expected := EVIDENCE_REPORT_MAGIC.bytes()
        evidence_put_number(&expected, U64.from_u16(EVIDENCE_REPORT_VERSION), 2)
        if header != expected -> return Err(evidence_codec_error("evidence report schema conflict"))
    }
    writer.write_all(frame) ?? return Err(evidence_codec_error("{err}"))
    writer.flush() ?? return Err(evidence_codec_error("{err}"))
}

// The first ten bytes of the report (Rust `read_exact` into `[u8; 10]`).
fn evidence_read_header(path: String) -[FS.Read]> [U8] IOError! {
    reader :: evidence_files.open(path)
    header := [U8]{}
    loop header.len() < 10 {
        chunk :: reader.read(10 - header.len())
        if chunk.len() == 0 -> break
        &header.extend(chunk)
    }
    close(^reader)
    Ok(header)
}
