// Canonical evidence codec error and bidirectional derivation code tables.
// Shared by EvidenceEncode and EvidenceCodec; unchanged wire mappings.

fn evidence_codec_error(message: String) -> EvidenceCodecError Never! {
    EvidenceCodecError{message: message}
}

fn evidence_derivation_method_code(value: DerivationMethod) -> Int Never! {
    if value == {
        .StaticDerivation -> 0
        .FormalProof -> 1
        .RecordedExecution -> 2
        .SampledAgreement -> 3
        .ExternalAssumption -> 4
    }
}

fn evidence_derivation_method_from_code(code: Int) -> DerivationMethod EvidenceCodecError! {
    if code == {
        0 -> Ok(DerivationMethod.StaticDerivation)
        1 -> Ok(DerivationMethod.FormalProof)
        2 -> Ok(DerivationMethod.RecordedExecution)
        3 -> Ok(DerivationMethod.SampledAgreement)
        4 -> Ok(DerivationMethod.ExternalAssumption)
        else -> Err(evidence_codec_error("unknown derivation method {code}"))
    }
}

fn evidence_derivation_disposition_code(value: DerivationDisposition) -> Int Never! {
    if value == {
        .Current -> 0
        .Stale -> 1
        .Expired -> 2
        .Redacted -> 3
        .Unavailable -> 4
        .Unsupported -> 5
        .BudgetExhausted -> 6
        .Unknown -> 7
    }
}

fn evidence_derivation_disposition_from_code(code: Int) -> DerivationDisposition EvidenceCodecError! {
    if code == {
        0 -> Ok(DerivationDisposition.Current)
        1 -> Ok(DerivationDisposition.Stale)
        2 -> Ok(DerivationDisposition.Expired)
        3 -> Ok(DerivationDisposition.Redacted)
        4 -> Ok(DerivationDisposition.Unavailable)
        5 -> Ok(DerivationDisposition.Unsupported)
        6 -> Ok(DerivationDisposition.BudgetExhausted)
        7 -> Ok(DerivationDisposition.Unknown)
        else -> Err(evidence_codec_error("unknown derivation disposition {code}"))
    }
}
