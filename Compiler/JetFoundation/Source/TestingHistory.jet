pub enum HistoryValue { Integer(I64) Boolean(Bool) Text(String) Handle(HandleId) Redacted(String) }
impl HistoryValue {
    // Rust: crates/jet-foundation/src/TestingHistory.rs:229
    pub fn public_text(value: String) -> Self Never! { Self.Text(^value) }
    // Rust: crates/jet-foundation/src/TestingHistory.rs:235
    pub fn redacted(label: String) -> Self Never! { Self.Redacted(^label) }
    // Rust: crates/jet-foundation/src/TestingHistory.rs:241
    pub fn secret(_value: String, label: String) -> Self Never! { Self.redacted(^label) }
    // Rust: crates/jet-foundation/src/TestingHistory.rs:245
    fn handles(self) -> HandleId? Never! { if self == { .Handle(handle) -> Val(handle) else -> None } }
    // Rust: crates/jet-foundation/src/TestingHistory.rs:252
    fn json(self) -> String Never! {
        if self == {
            .Integer(value) -> value.to_string()
            .Boolean(value) -> value.to_string()
            .Text(value) -> quote(value)
            .Handle(handle) -> handle.value.to_string()
            .Redacted(label) -> "{\"redacted\":" + quote(label) + "}"
        }
    }
    // Rust: crates/jet-foundation/src/TestingHistory.rs:262
    fn shrinks(self) -> [Self] Never! {
        if self == {
            .Integer(value) -> {
                values := [Self.Integer(0)]
                if value != 0 -> &values.push(Self.Integer(value / 2))
                &values.dedup()
                ^values
            }
            .Boolean(value) -> if value { [Self.Boolean(false)] } else { [] }
            .Handle(_) | .Redacted(_) -> []
            .Text(value) -> {
                if value.is_empty() -> return []
                half :: value.chars().take(value.chars().count() / 2).collect_string()
                [Self.Text(""), Self.Text(half)]
            }
        }
    }
}
