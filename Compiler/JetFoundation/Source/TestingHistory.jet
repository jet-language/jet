            (name, argument, command) :: if distributions[choice].operation == {
                "add" -> { value :: &local.below(17) as I64 - 8; ("add", Val(value), CounterCommand.Add(value)) }
                "sub" -> { value :: &local.below(17) as I64 - 8; ("sub", Val(value), CounterCommand.Sub(value)) }
