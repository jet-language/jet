// Compiler-private weak metadata indexes. The exact registered callable must
// remain borrowed throughout read; its allocation ticket prevents address reuse.
// GATE #4494: weak callable environment ownership and lifetime-erased indexing.
pub struct HistoryCallbackReader<R> { reader: Weak<() -> R Never!> }
impl<R> HistoryCallbackReader<R> {
    // Rust: crates/jet-foundation/src/TestingHistory.rs:35
    #Unsafe("The registered callable owns this typed reader for its entire lifetime")
    pub fn new(reader: &Rc<() -> R Never!>) -> Self Never! {
        Self{reader: Rc.downgrade(reader)}
    }
    // Rust: crates/jet-foundation/src/TestingHistory.rs:46
    #Unsafe("Caller borrows the exact registered callable until the read returns")
    pub fn read(self) -> R? Never! {
        reader :: self.reader.upgrade() ?? return None
        Val(reader())
    }
}
