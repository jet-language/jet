            if operation.name.is_empty() || operation.name.len() > MAX_STRING_BYTES -> return Err(HistoryError.InvalidCase("operation {operation.index} has an invalid name"))
            if operation.arguments.len() > 64 || operation.creates.len() > MAX_RESOURCES || operation.consumes.len() > MAX_RESOURCES || operation.preconditions.len() > 64 || operation.depends_on.len() > 64 -> return Err(HistoryError.InvalidCase("operation {operation.index} exceeds its metadata bound"))
            loop argument in operation.arguments {
                if argument == {
                    .Text(value) -> if value.len() > MAX_STRING_BYTES { return Err(HistoryError.InvalidCase("operation {operation.index} has an oversized argument")) }
                    .Redacted(value) -> if value.is_empty() || value.len() > MAX_STRING_BYTES { return Err(HistoryError.InvalidCase("operation {operation.index} has an invalid redacted argument")) }
                    .Handle(handle) -> if !live.has_key(handle) { return Err(HistoryError.InvalidCase("operation {operation.index} requires non-live argument handle {handle.value}")) }
                    .Integer(_) | .Boolean(_) -> {}
                }
            }
            dependencies := [U32:Bool]{}
            loop dependency in operation.depends_on {
                if dependency >= operation.index || dependencies.has_key(dependency) -> return Err(HistoryError.InvalidCase("operation {operation.index} has a duplicate or forward dependency"))
                dependencies[dependency] = true
            }
            loop precondition in operation.preconditions {
                if precondition == {
                    .HandleLive(handle) -> if !live.has_key(handle) { return Err(HistoryError.InvalidCase("operation {operation.index} requires non-live handle {handle.value}")) }
                    .HandleState(handle, state) -> {
                        if state.is_empty() || state.len() > MAX_STRING_BYTES -> return Err(HistoryError.InvalidCase("operation {operation.index} has an invalid handle state"))
                        if !live.has_key(handle) -> return Err(HistoryError.InvalidCase("operation {operation.index} requires non-live handle {handle.value}"))
                    }
                    .TaskCompleted(task) -> if !completed_tasks.has_key(task) { return Err(HistoryError.InvalidCase("operation {operation.index} requires incomplete task {task.value}")) }
                    .EventAvailable(event) -> if !available_events.has_key(event) { return Err(HistoryError.InvalidCase("operation {operation.index} requires unavailable event {event.value}")) }
                }
            }
            creates := [HandleId:Bool]{}
            loop handle in operation.creates { creates[handle] = true }
            if creates.len() != operation.creates.len() -> return Err(HistoryError.InvalidCase("operation {operation.index} creates a handle more than once"))
            consumes := [HandleId:Bool]{}
            loop handle in operation.consumes { consumes[handle] = true }
            if consumes.len() != operation.consumes.len() -> return Err(HistoryError.InvalidCase("operation {operation.index} consumes a handle more than once"))
            loop handle in creates.keys() { if consumes.has_key(handle) -> return Err(HistoryError.InvalidCase("operation {operation.index} creates and consumes one handle")) }
            loop handle in operation.consumes {
                if &live.remove(handle) == None -> return Err(HistoryError.InvalidCase("operation {operation.index} consumes non-live handle {handle.value}"))
            }
            loop handle in operation.creates {
