        if self.operations.is_empty() -> return Err(HistoryError.InvalidCase("case must contain at least one operation"))
        if self.operations.len() > MAX_STEPS -> return Err(HistoryError.InvalidCase("operation count exceeds the history bound"))
        live := [HandleId:Bool]{}
