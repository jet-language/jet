pub struct HistoryCase { pub case_id: String, pub seed: U64, pub operations: [HistoryOperation], pub schedule: [HistoryScheduleChoice] }
impl HistoryCase {
    // Rust: crates/jet-foundation/src/TestingHistory.rs:485
    pub fn new(case_id: String, seed: U64) -> Self Never! { Self{case_id: ^case_id, seed: seed, operations: [], schedule: []} }
