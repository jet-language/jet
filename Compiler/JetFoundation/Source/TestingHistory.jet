pub fn validate_history_bounds(seed: I64, cases: I64) -> (U64, USize) Err! {
    // GATE #4483: selected-target usize conversion, cases precede seed.
    count :: USize.try_from(cases).map_err(fn(_) { HISTORY_CASE_BOUND_INVALID_REASON })?
    value :: U64.try_from(seed).map_err(fn(_) { HISTORY_SEED_INVALID_REASON })?
    (value, count)
}
