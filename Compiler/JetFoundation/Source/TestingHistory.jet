//RS 
//RS // Compiler-private weak metadata indexes. Capture storage stays in the native
//RS // callable environment, including its ordinary checked Rust references. Only
//RS // the index erases a reader lifetime; it never owns or projects a referent.
//RS //
//RS // SAFETY CONTRACT: the native registry may call a reader only while borrowing
//RS // the exact registered callable. That callable owns the typed reader and its
//RS // allocation ticket. Dead tickets cannot match a reused allocation address.
//RS macro_rules! history_callback_reader {
//RS     ($name:ident, $owner:ident, $weak:ident $(, $bound:ident)*) => {
//RS         #[derive(Clone)]
//RS         pub struct $name<R: 'static>($weak<dyn Fn() -> R $(+ $bound)*>);
//RS         impl<R: 'static> $name<R> {
//RS             /// The registered callable must own this reader for its entire
//RS             /// lifetime, and every read must borrow that same callable.
//RS             pub unsafe fn new<'a>(reader: &$owner<dyn Fn() -> R $(+ $bound)* + 'a>) -> Self {
//RS                 let weak = <$owner<_>>::downgrade(reader);
//RS                 // SAFETY: Weak owns no capture. Its lifetime is restored by
//RS                 // the caller's live-callable requirement on read().
//RS                 Self(unsafe { std::mem::transmute::<
//RS                     $weak<dyn Fn() -> R $(+ $bound)* + 'a>,
//RS                     $weak<dyn Fn() -> R $(+ $bound)* + 'static>,
//RS                 >(weak) })
//RS             }
//RS             /// The exact callable used at registration must remain borrowed
//RS             /// until this call returns, keeping its typed reader alive.
//RS             pub unsafe fn read(&self) -> Option<R> {
//RS                 self.0.upgrade().map(|reader| reader())
//RS             }
//RS         }
//RS     };
//RS }
//RS use std::rc::{Rc as HistoryReaderRc, Weak as HistoryReaderWeak};
//RS use std::sync::{Arc as HistoryReaderArc, Weak as HistorySendReaderWeak};
//RS history_callback_reader!(HistoryCallbackReader, HistoryReaderRc, HistoryReaderWeak);
//RS history_callback_reader!(HistorySendCallbackReader, HistoryReaderArc, HistorySendReaderWeak, Send, Sync);
