                known[handle] = true
                live[handle] = true
            }
            if operation.task == Val(task) -> completed_tasks[task] = true
            if operation.event == Val(event) -> available_events[event] = true
        }
        if known.len() > MAX_RESOURCES -> return Err(HistoryError.InvalidCase("resource count exceeds the history bound"))
        loop choice in self.schedule {
            operation :: self.operations.get(choice.operation as USize) ?? return Err(HistoryError.InvalidCase("schedule references missing operation {choice.operation}"))
            if choice.task == Val(task) { if operation.task != Val(task) -> return Err(HistoryError.InvalidCase("schedule task does not match operation {choice.operation}")) }
            if choice.event == Val(event) { if operation.event != Val(event) -> return Err(HistoryError.InvalidCase("schedule event does not match operation {choice.operation}")) }
            if choice.choice.is_empty() || choice.choice.len() > MAX_STRING_BYTES -> return Err(HistoryError.InvalidCase("schedule choice must be non-empty and bounded"))
        }
    }
