    pub fn input_id(self) -> String Never! { SHA256.sha256_hex(self.canonical_json().as_bytes()) }
    // Rust: crates/jet-foundation/src/TestingHistory.rs:720
    pub fn json(self) -> String Never! { self.canonical_json() }
    // Rust: crates/jet-foundation/src/TestingHistory.rs:724
    fn canonical_json(self) -> String Never! {
        operations :: self.operations.iter().map(fn(operation) { operation.json() }).collect_vec().join(",")
        schedule :: self.schedule.iter().map(fn(choice) { choice.json() }).collect_vec().join(",")
        "{\"caseId\":" + quote(self.case_id) + ",\"operations\":[" + operations + "],\"schedule\":[" + schedule + "],\"seed\":" + self.seed.to_string() + "}"
    }
    // Rust: crates/jet-foundation/src/TestingHistory.rs:746
    fn without_indices(self, requested: &[U32:Bool]) -> Self? Never! {
        if requested.is_empty() || requested.len() >= self.operations.len() -> return None
        removed := ~requested
        loop {
            handles := [HandleId:Bool]{}
            loop index in removed.keys() {
                if self.operations.get(index as USize) == Val(operation) { loop handle in operation.creates { handles[handle] = true } }
            }
            changed := false
            loop operation in self.operations {
                if removed.has_key(operation.index) -> continue
                if operation.depends_on.iter().any(fn(dependency) { removed.has_key(dependency) }) || operation.references_any_handle(&handles) {
                    removed[operation.index] = true
                    changed = true
                }
            }
            if !changed -> break
        }
        if removed.len() >= self.operations.len() -> return None
        remap := [U32:U32]{}
        operations := [HistoryOperation]{}
        loop operation in self.operations {
            if removed.has_key(operation.index) -> continue
            next :: U32.try_from(operations.len()).ok() ?? return None
            remap[operation.index] = next
            &operations.push(~operation)
        }
        loop operation in &operations {
            operation.index = remap.get(operation.index) ?? return None
            operation.depends_on = operation.depends_on.iter().filter_map(fn(dependency) { remap.get(dependency) }).collect_vec()
        }
        schedule := [HistoryScheduleChoice]{}
        loop choice in self.schedule {
            if remap.get(choice.operation) == Val(index) {
                mapped := ~choice
                mapped.operation = index
                &schedule.push(^mapped)
            }
        }
        Val(Self{case_id: ~self.case_id, seed: self.seed, operations: ^operations, schedule: ^schedule})
    }
    // Rust: crates/jet-foundation/src/TestingHistory.rs:811
    fn with_argument(self, operation_index: USize, argument_index: USize, value: HistoryValue) -> Self? Never! {
        candidate := ~self
        if operation_index >= candidate.operations.len() -> return None
        if argument_index >= candidate.operations[operation_index].arguments.len() -> return None
        candidate.operations[operation_index].arguments[argument_index] = ^value
        Val(^candidate)
    }
}
