    fn valid(self, value: &HistoryValue) -> Bool Never! {
        if (self, value) == {
            (.Integer(lo, hi), .Integer(value)) -> lo <= value && value <= hi
            (.Boolean, .Boolean(_)) | (.Text, .Text(_)) -> true
            (.Char, .Text(value)) -> value.chars().count() == 1
            else -> false
        }
    }
}
