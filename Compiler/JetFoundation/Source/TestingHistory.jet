impl HistorySchemaField {
    // Rust: crates/jet-foundation/src/TestingHistory.rs:1466
    fn generate(self, rng: &HistoryRng, case_index: USize, step_index: USize) -> HistoryValue? Never! {
        if self == {
            .Integer(lo, hi) -> {
                if lo > hi -> return None
                width :: (hi as I128 - lo as I128 + 1) as U128
                value :: if width <= U64.MAX as U128 { lo as I128 + &rng.below(width as U64) as I128 } else { lo as I128 }
                Val(HistoryValue.Integer(value as I64))
            }
            .Boolean -> Val(HistoryValue.Boolean(&rng.coin()))
            .Text -> Val(HistoryValue.Text("history-{case_index}-{step_index}"))
            .Char -> { value :: (U8{97} + &rng.below(26) as U8) as Char; Val(HistoryValue.Text(value.to_string())) }
        }
    }
