    fn valid(self, case: &TypedHistoryCase<CounterCommand>) -> Bool Never! {
        if !case.case.validate().is_ok() -> return false
        loop (operation, command) in case.case.operations.iter().zip(&case.commands) {
            if (operation.name, command) == {
