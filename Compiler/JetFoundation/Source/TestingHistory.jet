        consumes :: self.consumes.iter().map(fn(handle) { handle.value.to_string() }).collect_vec().join(",")
        preconditions :: self.preconditions.iter().map(precondition_json).collect_vec().join(",")
        dependencies :: self.depends_on.iter().map(fn(value) { value.to_string() }).collect_vec().join(",")
        "{\"arguments\":[" + arguments + "],\"consumes\":[" + consumes + "],\"creates\":[" + creates + "],\"dependsOn\":[" + dependencies + "],\"event\":" + optional_u32(self.event.map(fn(event) { event.value })) + ",\"index\":" + self.index.to_string() + ",\"name\":" + quote(self.name) + ",\"preconditions\":[" + preconditions + "],\"task\":" + optional_u32(self.task.map(fn(task) { task.value })) + "}"
    }
}
// Rust: crates/jet-foundation/src/TestingHistory.rs:412
fn optional_u32(value: U32?) -> String Never! { if value == { .Val(value) -> value.to_string() .None -> "null" } }
// Rust: crates/jet-foundation/src/TestingHistory.rs:416
fn precondition_json(precondition: HistoryPrecondition) -> String Never! {
    if precondition == {
        .HandleLive(handle) -> "{\"kind\":\"handle_live\",\"handle\":" + handle.value.to_string() + "}"
        .HandleState(handle, state) -> "{\"handle\":" + handle.value.to_string() + ",\"kind\":\"handle_state\",\"state\":" + quote(state) + "}"
        .TaskCompleted(task) -> "{\"kind\":\"task_completed\",\"task\":" + task.value.to_string() + "}"
        .EventAvailable(event) -> "{\"event\":" + event.value.to_string() + ",\"kind\":\"event_available\"}"
    }
}
