}
// Rust: crates/jet-foundation/src/TestingHistory.rs:1752
fn history_value_data_tree(value: &HistoryValue) -> DataTree Never! {
    if value == {
        .Integer(value) -> DataTree.Int(value)
        .Boolean(value) -> DataTree.Bool(value)
        .Text(value) -> DataTree.Text(~value)
        .Handle(handle) -> DataTree.Int(handle.value as I64)
        .Redacted(label) -> DataTree.Object([("redacted", DataTree.Text(~label))])
    }
}
// Rust: crates/jet-foundation/src/TestingHistory.rs:1767
fn history_schema_command_data_tree(command: &HistorySchemaCommand) -> DataTree Never! {
    DataTree.Object([
        ("operation", DataTree.Text(~command.operation)),
        ("arguments", DataTree.Array(command.arguments.iter().map(history_value_data_tree).collect_vec())),
        ("creates", DataTree.Array(command.creates.iter().map(fn(handle) { DataTree.Int(handle.value as I64) }).collect_vec())),
        ("consumes", DataTree.Array(command.consumes.iter().map(fn(handle) { DataTree.Int(handle.value as I64) }).collect_vec()))
    ])
}
