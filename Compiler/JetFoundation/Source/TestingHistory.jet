pub struct HistoryProvenance { pub source: String, pub tool: String, pub target: String }
// Rust: crates/jet-foundation/src/TestingHistory.rs:141
pub fn history_callback_value_fingerprint(function_identity: String, canonical_capture_bytes: &[U8]) -> String HistoryError! {
    if function_identity.is_empty() -> return Err(HistoryError.InvalidConfig("history callback has no checked function identity"))
    payload := [U8]{}
    loop bytes in ["jet.history.callback.value.v1".as_bytes(), function_identity.as_bytes(), canonical_capture_bytes] {
        &payload.extend(bytes.len().to_string().as_bytes())
        &payload.push(U8{58})
        &payload.extend(bytes)
    }
    SHA256.sha256_hex(&payload)
}
impl HistoryProvenance {
    // Rust: crates/jet-foundation/src/TestingHistory.rs:164
    pub fn bind_callbacks(self, callbacks: &[(String, String)]) -> Self HistoryError! {
        if self.source.is_empty() || self.tool.is_empty() || self.target.is_empty() -> return Err(HistoryError.InvalidConfig("history provenance is incomplete"))
        sorted := callbacks.to_vec()
        loop (role, identity) in sorted {
            if role.is_empty() || identity.is_empty() || role.len() > MAX_STRING_BYTES || identity.len() > MAX_STRING_BYTES -> return Err(HistoryError.InvalidConfig("history callback provenance is incomplete"))
        }
        &sorted.sort_unstable_by(fn(left, right) { left.0.cmp(right.0) })
        loop pair in sorted.windows(2) {
            if pair[0].0 == pair[1].0 || pair[0].1 == pair[1].1 -> return Err(HistoryError.InvalidConfig("history callback provenance contains a duplicate identity"))
        }
        payload := [U8]{}
        // Rust: crates/jet-foundation/src/TestingHistory.rs:197
        fn frame(payload: &[U8], value: String) -> Void Never! {
            &payload.extend(value.len().to_string().as_bytes())
            &payload.push(U8{58})
            &payload.extend(value.as_bytes())
        }
        frame(&payload, "jet.history.provenance.v1")
        frame(&payload, self.source)
        loop (role, identity) in sorted { frame(&payload, role); frame(&payload, identity) }
        Self{source: SHA256.sha256_hex(&payload), tool: ~self.tool, target: ~self.target}
    }
}
