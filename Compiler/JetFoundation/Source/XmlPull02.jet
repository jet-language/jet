            "declaration" => {
                exact_keys(event, ["$xml_event", "version", "encoding", "standalone", "lexical"])
                if self.declaration || self.doctype || self.root_seen -> return Err(Error.state("XML declaration is out of order"))
                version :: required_text(event, "version") catch reason { return Err(Error.shape(reason)) }
                if version != "1.0" -> return Err(Error.at_kind(0, Reason.Unsupported, "only XML version 1.0 is supported"))
                declared :: optional_text_field(event, "encoding") catch reason { return Err(Error.shape(reason)) }
                if declared is Val(name) -> validate_declared_encoding(name, self.encoding)
                standalone :: match field(event, "standalone") {
                    Val(Value.Null) => null
                    Val(Value.Bool(value)) => Val(value)
                    _ => return Err(Error.shape("declaration standalone must be Bool or Null"))
                }
                self.declaration = true
                deterministic = "<?xml version=\"{version}\""
                if declared != null -> deterministic += " encoding=\"{encoding_declaration(self.encoding)}\""
                if standalone is Val(value) -> deterministic += if value -> " standalone=\"yes\"" else -> " standalone=\"no\""
                deterministic += "?>"
            }
            "document_whitespace" => {
                exact_keys(event, ["$xml_event", "value", "lexical"])
                if self.root_seen && !self.root_closed -> return Err(Error.state("document_whitespace is not legal inside an element"))
                value :: required_text(event, "value") catch reason { return Err(Error.shape(reason)) }
                if value.is_empty() || !value.chars().all(c => c == ' ' || c == '\t' || c == '\r' || c == '\n') -> return Err(Error.shape("document_whitespace contains a non-XML-S character"))
                deterministic = value
            }
            "doctype" => {
                exact_keys(event, ["$xml_event", "name", "public_id", "system_id", "internal_subset", "lexical"])
                if self.doctype || self.root_seen -> return Err(Error.state("XML DOCTYPE is out of order"))
                self.doctype = true
                deterministic = deterministic_event_node(event, "doctype")
            }
            "element_start" => {
                exact_keys(event, ["$xml_event", "name", "namespaces", "attributes", "empty_style", "open_lexical"])
