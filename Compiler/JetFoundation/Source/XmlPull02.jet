}

// Rust: crates/jet-foundation/src/XmlPull.rs:2042
pub fn render_document_bytes(value: Value, encoding: RenderEncoding, lexical: LexicalPolicy) -> [U8] Error! {
    events :: unfold_events(value)
    writer := StreamWriter.new(encoding, lexical)
    output := [U8]{}
    loop event in events -> output.extend(writer.write(event))
    output
}
