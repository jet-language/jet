            source :: optional_text_field(event, "encoding") catch reason { return Err(Error.shape(reason)) }
            bom :: byte_array(field(event, "bom") ?? return Err(Error.shape("document_start lacks bom")))
            self.source_matches = source_encoding_matches(source, bom, self.encoding)
            self.started = true
            return target_bom(self.encoding)
        }
        if !self.started -> return Err(Error.state("XML writer expects document_start first"))
