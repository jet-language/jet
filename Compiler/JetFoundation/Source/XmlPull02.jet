                deterministic = deterministic_event_node(event, tag)
            }
            "comment" | "processing_instruction" => {
                exact_leaf_keys(event, tag)
                deterministic = deterministic_event_node(event, tag)
            }
            _ => return Err(Error.shape("unknown XML event `{tag}`"))
