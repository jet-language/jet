// Rust: crates/jet-foundation/src/XmlPull.rs:2065
fn exact_keys(value: Value, expected: [String]) Error! {
    if !(value is Value.Object(entries)) -> return Err(Error.shape("XML event must be an Object"))
    if entries.len() != expected.len() -> return Err(Error.shape("XML event has missing, duplicate, or unknown keys"))
    loop key in expected {
        count := 0
        loop (candidate, _) in entries { if candidate == key -> count += 1 }
        if count != 1 -> return Err(Error.shape("XML event has missing, duplicate, or unknown keys"))
    }
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2085
fn exact_leaf_keys(value: Value, tag: String) Error! {
    match tag {
        "text" | "cdata" | "comment" => exact_keys(value, ["$xml_event", "value", "lexical"])
        "entity_ref" => exact_keys(value, ["$xml_event", "name", "resolved_value", "lexical"])
        "processing_instruction" => exact_keys(value, ["$xml_event", "target", "value", "lexical"])
        _ => return Err(Error.shape("unknown XML leaf event"))
    }
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2096
fn byte_array(value: Value) -> [U8] Error! {
    if !(value is Value.Array(values)) -> return Err(Error.shape("XML byte value must be an Array<Int>"))
    bytes := [U8]{}
    loop item in values {
        if !(item is Value.Int(byte)) -> return Err(Error.shape("XML byte value must contain only Int"))
        converted :: U8.from_int(byte) ?? return Err(Error.shape("XML byte is outside 0..255"))
        bytes.push(converted)
    }
    bytes
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2111
fn base_namespaces() -> [String?:String] Never! {
    [String?:String]{Val("xml"): "http://www.w3.org/XML/1998/namespace"}
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2118
fn parse_name(value: Value) -> Name Error! {
    exact_keys(value, ["raw", "prefix", "local", "namespace_uri"])
    raw :: required_text(value, "raw") catch reason { return Err(Error.shape(reason)) }
    prefix :: optional_text_field(value, "prefix") catch reason { return Err(Error.shape(reason)) }
    local :: required_text(value, "local") catch reason { return Err(Error.shape(reason)) }
    namespace_uri :: optional_text_field(value, "namespace_uri") catch reason { return Err(Error.shape(reason)) }
    if !valid_name(raw) || !valid_name(local) || prefix.map(p => !valid_name(p)) == Val(true) -> return Err(Error.at_kind(0, Reason.InvalidName, "invalid XML expanded name"))
    expected :: if prefix is Val(p) -> "{p}:{local}" else -> local
    if raw != expected -> return Err(Error.at_kind(0, Reason.InvalidName, "XML name raw/prefix/local fields disagree"))
    Name{raw: raw, prefix: prefix, local: local, namespace_uri: namespace_uri}
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2159
fn validate_start(event: Value, name: Name, inherited: ^[String?:String]) -> [String?:String] Error! {
    context := ^inherited
    if !(field(event, "namespaces") is Val(Value.Array(namespaces))) -> return Err(Error.shape("element namespaces must be an Array"))
    declared := [String?:Bool]{}
    loop namespace in namespaces {
        exact_keys(namespace, ["$xml", "prefix", "namespace_uri", "quote", "lexical"])
        tag :: required_text(namespace, "$xml") catch reason { return Err(Error.shape(reason)) }
        if tag != "namespace" -> return Err(Error.shape("namespaces contains a non-namespace node"))
        prefix :: optional_text_field(namespace, "prefix") catch reason { return Err(Error.shape(reason)) }
        uri :: required_text(namespace, "namespace_uri") catch reason { return Err(Error.shape(reason)) }
        quote :: required_text(namespace, "quote") catch reason { return Err(Error.shape(reason)) }
        if quote != "single" && quote != "double" -> return Err(Error.shape("namespace quote must be single or double"))
        if declared.contains_key(prefix) -> return Err(Error.at_kind(0, Reason.Namespace, "duplicate namespace prefix declaration"))
        declared[prefix] = true
        context[prefix] = uri
        if prefix == Val("xmlns") || (prefix == Val("xml") && uri != "http://www.w3.org/XML/1998/namespace") -> return Err(Error.at_kind(0, Reason.Namespace, "reserved XML namespace binding"))
    }
    resolved :: context.get(name.prefix)
    if resolved != name.namespace_uri -> return Err(Error.at_kind(0, Reason.Namespace, "element expanded name disagrees with namespace bindings"))
    if !(field(event, "attributes") is Val(Value.Array(attributes))) -> return Err(Error.shape("element attributes must be an Array"))
    // GATE #4499: tuple expanded-name equality is retained.
    expanded := [(String?, String):Bool]{}
    loop attribute in attributes {
        exact_keys(attribute, ["$xml", "name", "parts", "normalized_value", "quote", "lexical"])
        tag :: required_text(attribute, "$xml") catch reason { return Err(Error.shape(reason)) }
        if tag != "attribute" -> return Err(Error.shape("attributes contains a non-attribute node"))
        attr :: parse_name(field(attribute, "name") ?? return Err(Error.shape("attribute lacks name")))
        resolved :: if attr.prefix is Val(prefix) -> context.get(Val(prefix)) else -> null
        if resolved != attr.namespace_uri -> return Err(Error.at_kind(0, Reason.Namespace, "attribute expanded name disagrees with namespace bindings"))
        key :: (attr.namespace_uri, attr.local)
        if expanded.contains_key(key) -> return Err(Error.at_kind(0, Reason.DuplicateAttribute, "duplicate expanded attribute name"))
        expanded[key] = true
        quote :: required_text(attribute, "quote") catch reason { return Err(Error.shape(reason)) }
        if quote != "single" && quote != "double" -> return Err(Error.shape("attribute quote must be single or double"))
        if !(field(attribute, "parts") is Val(Value.Array(parts))) -> return Err(Error.shape("attribute parts must be an Array"))
        loop part in parts {
            tag :: required_text(part, "$xml") catch reason { return Err(Error.shape(reason)) }
            if tag != "text" && tag != "entity_ref" -> return Err(Error.shape("attribute parts contains an illegal node"))
        }
    }
    ^context
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2287
fn event_element_node(event: Value) -> Value Error! {
    object([
        ("$xml", text("element")),
        ("name", field(event, "name") ?? return Err(Error.shape("element lacks name"))),
        ("namespaces", field(event, "namespaces") ?? return Err(Error.shape("element lacks namespaces"))),
        ("attributes", field(event, "attributes") ?? return Err(Error.shape("element lacks attributes"))),
        ("empty_style", field(event, "empty_style") ?? return Err(Error.shape("element lacks empty_style"))),
    ])
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2317
fn deterministic_event_node(event: Value, tag: String) -> String Error! {
    if !(event is Value.Object(entries)) -> return Err(Error.shape("XML event must be an Object"))
    fields := [(String, Value)]{("$xml", text(tag))}
    loop (key, value) in entries {
        if key != "$xml_event" && key != "lexical" && key != "open_lexical" && key != "close_lexical" -> fields.push((key, ~value))
    }
    deterministic_leaf(Value.Object(^fields), tag) catch reason { return Err(Error.shape(reason)) }
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2336
fn valid_event_raw_bytes(event: Value, tag: String) -> [U8]? Never! {
    key :: match tag {
        "element_start" => "open_lexical"
        "element_end" => "close_lexical"
        "document_start" | "document_end" => return null
        _ => "lexical"
    }
    lexical :: field(event, key) ?? return null
    expected :: lexical_semantic(event, key) ?? return null
    if !lexical_evidence_matches(lexical, expected) -> return null
    bytes :: byte_array(field(lexical, "raw_bytes") ?? return null) catch _ { return null }
    Val(bytes)
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2351
fn source_encoding_matches(source: String?, bom: [U8], target: RenderEncoding) -> Bool Never! {
    match target {
        .UTF8 => source == Val("UTF-8") && bom.is_empty()
        .UTF8Bom => source == Val("UTF-8") && bom == [U8]{U8{0xef}, U8{0xbb}, U8{0xbf}}
        .Utf16Le => source == Val("UTF-16LE") && bom == [U8]{U8{0xff}, U8{0xfe}}
        .Utf16Be => source == Val("UTF-16BE") && bom == [U8]{U8{0xfe}, U8{0xff}}
    }
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2360
fn target_bom(target: RenderEncoding) -> [U8] Never! {
    match target {
        .UTF8 => [U8]{}
        .UTF8Bom => [U8]{U8{0xef}, U8{0xbb}, U8{0xbf}}
        .Utf16Le => [U8]{U8{0xff}, U8{0xfe}}
        .Utf16Be => [U8]{U8{0xfe}, U8{0xff}}
    }
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2368
fn encoding_declaration(target: RenderEncoding) -> String Never! {
    match target {
        .UTF8 | .UTF8Bom => "UTF-8"
        .Utf16Le | .Utf16Be => "UTF-16"
    }
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2374
fn validate_declared_encoding(name: String, target: RenderEncoding) Error! {
    ok :: match target {
        .UTF8 | .UTF8Bom => name.eq_ignore_ascii_case("UTF-8")
        .Utf16Le | .Utf16Be => name.eq_ignore_ascii_case("UTF-16") || name.eq_ignore_ascii_case("UTF-16LE") || name.eq_ignore_ascii_case("UTF-16BE")
    }
    if !ok -> return Err(Error.at_kind(0, Reason.InvalidEncoding, "XML declaration conflicts with selected output encoding"))
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2393
fn encode_text(value: String, target: RenderEncoding) -> [U8] Never! {
    if target == RenderEncoding.UTF8 || target == RenderEncoding.UTF8Bom -> return value.to_bytes()
    output := [U8]{}
    loop word in value.encode_utf16() {
        bytes :: if target == RenderEncoding.Utf16Le -> word.to_le_bytes() else -> word.to_be_bytes()
        output.extend(bytes)
    }
    output
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2402
pub enum CanonicalMode { Inclusive11 Exclusive10 }
// Rust: crates/jet-foundation/src/XmlPull.rs:2408
pub struct CanonicalOptions { pub mode: CanonicalMode, pub comments: Bool, pub inclusive_prefixes: [String] }
// Rust: crates/jet-foundation/src/XmlPull.rs:2416
pub fn canonical_document(value: Value, options: CanonicalOptions) -> String Error! {
    if options.mode == CanonicalMode.Inclusive11 && !options.inclusive_prefixes.is_empty() -> return Err(Error.shape("inclusive_prefixes is legal only for Exclusive10"))
    tag :: required_text(value, "$xml") catch reason { return Err(Error.shape(reason)) }
    if tag != "document" -> return Err(Error.shape("XML canonical input must be a document"))
    if !(field(value, "children") is Val(Value.Array(children))) -> return Err(Error.shape("XML document children must be an array"))
    roots := 0
    loop child in children {
        child_tag :: required_text(child, "$xml") catch _ { continue }
        if child_tag == "element" -> roots += 1
    }
    if roots != 1 -> return Err(Error.shape("XML canonical input must contain exactly one root element"))
    output := ""
    root_seen := false
    base :: base_namespaces()
    rendered :: [String?:String]{}
    loop child in children {
        tag :: required_text(child, "$xml") catch reason { return Err(Error.shape(reason)) }
        match tag {
            "declaration" | "doctype" | "document_whitespace" => {}
            "element" => {
                root_seen = true
                canonical_node(child, options, base, rendered, &output)
            }
            "comment" | "processing_instruction" => {
                if tag == "comment" && !options.comments -> continue
                if root_seen -> output += "\n"
                canonical_leaf(child, tag, &output)
                if !root_seen -> output += "\n"
            }
            _ => return Err(Error.shape("illegal node outside XML root element"))
        }
    }
    output
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2475
fn canonical_node(value: Value, options: CanonicalOptions, parent_scope: [String?:String], parent_rendered: [String?:String], output: &String) Error! {
    tag :: required_text(value, "$xml") catch reason { return Err(Error.shape(reason)) }
    if tag != "element" -> return canonical_leaf(value, tag, output)
    name :: parse_name(field(value, "name") ?? return Err(Error.shape("element lacks name")))
    scope := ~parent_scope
    if !(field(value, "namespaces") is Val(Value.Array(namespaces))) -> return Err(Error.shape("element namespaces must be an array"))
    loop namespace in namespaces {
        prefix :: optional_text_field(namespace, "prefix") catch reason { return Err(Error.shape(reason)) }
        uri :: required_text(namespace, "namespace_uri") catch reason { return Err(Error.shape(reason)) }
        if !uri.is_empty() && !uri.contains(":") -> return Err(Error.at_kind(0, Reason.Namespace, "relative namespace URI cannot be canonicalized"))
        scope[prefix] = uri
    }
    if scope.get(name.prefix) != name.namespace_uri -> return Err(Error.at_kind(0, Reason.Namespace, "element expanded name disagrees with namespace bindings"))
    if !(field(value, "attributes") is Val(Value.Array(attributes))) -> return Err(Error.shape("element attributes must be an array"))
    attrs := [(String, String, String, String)]{}
    visible := [String?:Bool]{}
    if name.prefix is Val(prefix) { visible[Val(prefix)] = true }
    else if name.namespace_uri != null { visible[null] = true }
    loop attribute in attributes {
        attr_name :: parse_name(field(attribute, "name") ?? return Err(Error.shape("attribute lacks name")))
        if attr_name.prefix is Val(prefix) -> visible[Val(prefix)] = true
        resolved :: if attr_name.prefix is Val(prefix) -> scope.get(Val(prefix)) else -> null
        if resolved != attr_name.namespace_uri -> return Err(Error.at_kind(0, Reason.Namespace, "attribute expanded name disagrees with namespace bindings"))
        content :: canonical_attribute_value(attribute)
        attrs.push((attr_name.namespace_uri ?? "", attr_name.local, attr_name.raw, content))
    }
    loop prefix in options.inclusive_prefixes -> visible[if prefix == "#default" -> null else -> Val(prefix)] = true
    declarations := [(String?, String)]{}
    keys := scope.keys().to_list()
    keys.sort_by((a, b) => match (a, b) {
        (null, null) => 0
        (null, _) => -1
        (_, null) => 1
        (Val(a), Val(b)) => a.compare(b)
    })
    loop prefix in keys {
        uri :: scope[prefix]
        if prefix == Val("xml") -> continue
        selected :: options.mode == CanonicalMode.Inclusive11 || visible.contains_key(prefix)
        if selected && parent_rendered.get(prefix) != Val(uri) -> declarations.push((prefix, uri))
    }
    attrs.sort_by((a, b) => if a.0 == b.0 -> a.1.compare(b.1) else -> a.0.compare(b.0))
    output += "<{name.raw}"
    rendered := ~parent_rendered
    loop (prefix, uri) in declarations {
        output += " xmlns"
        if prefix is Val(p) -> output += ":{p}"
        output += "=\"{canonical_attr_escape(uri)}\""
        rendered[prefix] = uri
    }
    loop (_, _, raw, content) in attrs -> output += " {raw}=\"{canonical_attr_escape(content)}\""
    output += ">"
    if !(field(value, "children") is Val(Value.Array(children))) -> return Err(Error.shape("element children must be an array"))
    loop child in children {
        tag :: required_text(child, "$xml") catch reason { return Err(Error.shape(reason)) }
        if tag == "comment" && !options.comments -> continue
        canonical_node(child, options, scope, rendered, output)
    }
    output += "</{name.raw}>"
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2624
fn canonical_attribute_value(attribute: Value) -> String Error! {
    normalized :: optional_text_field(attribute, "normalized_value") catch reason { return Err(Error.shape(reason)) }
    if normalized is Val(content) -> return content
    if !(field(attribute, "parts") is Val(Value.Array(parts))) -> return Err(Error.shape("attribute parts must be an array"))
    output := ""
    loop part in parts {
        tag :: required_text(part, "$xml") catch reason { return Err(Error.shape(reason)) }
        match tag {
            "text" => { output += required_text(part, "value") catch reason { return Err(Error.shape(reason)) } }
            "entity_ref" => {
                resolved :: optional_text_field(part, "resolved_value") catch reason { return Err(Error.shape(reason)) }
                output += resolved ?? return Err(Error.at_kind(0, Reason.Canonicalization, "unresolved entity cannot be canonicalized"))
            }
            _ => return Err(Error.shape("illegal XML attribute part"))
        }
    }
    output
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2652
fn canonical_leaf(value: Value, tag: String, output: &String) Error! {
    match tag {
        "text" | "cdata" => {
            content :: required_text(value, "value") catch reason { return Err(Error.shape(reason)) }
            output += canonical_text_escape(content)
        }
        "entity_ref" => {
            resolved :: optional_text_field(value, "resolved_value") catch reason { return Err(Error.shape(reason)) }
            content :: resolved ?? return Err(Error.at_kind(0, Reason.Canonicalization, "unresolved entity cannot be canonicalized"))
            output += canonical_text_escape(content)
        }
        "comment" => {
            content :: required_text(value, "value") catch reason { return Err(Error.shape(reason)) }
            output += "<!--{normalize_lines(content)}-->"
        }
        "processing_instruction" => {
            target :: required_text(value, "target") catch reason { return Err(Error.shape(reason)) }
            content :: required_text(value, "value") catch reason { return Err(Error.shape(reason)) }
            body :: normalize_lines(content)
            output += "<?{target}"
            if !body.is_empty() -> output += " {body}"
            output += "?>"
        }
        _ => return Err(Error.shape("unsupported canonical XML node {tag}"))
    }
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2694
fn normalize_lines(value: String) -> String Never! { value.replace("\r\n", "\n").replace("\r", "\n") }
// Rust: crates/jet-foundation/src/XmlPull.rs:2697
fn canonical_text_escape(value: String) -> String Never! {
    normalize_lines(value).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2703
fn canonical_attr_escape(value: String) -> String Never! {
    value.replace("&", "&amp;").replace("<", "&lt;").replace("\"", "&quot;").replace("\t", "&#x9;").replace("\n", "&#xA;").replace("\r", "&#xD;")
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2714
fn xml_tag_of(value: Value) -> String? Never! {
    match field(value, "$xml") { Val(Value.Text(tag)) => Val(tag), _ => null }
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2721
fn projection_err(path: String, reason: String) -> Error Never! {
    Error{kind: Reason.Shape, offset: 0, line: null, column: null, path: path, reason: reason}
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2732
fn entity_err(path: String, reason: String) -> Error Never! {
    Error{kind: Reason.Entity, offset: 0, line: null, column: null, path: path, reason: reason}
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2743
fn clark_key(local: String, namespace_uri: String?) -> String Never! {
    if namespace_uri is Val(uri) && !uri.is_empty() -> return "{{{uri}}}{local}"
    local
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2750
fn read_name_parts(name: Value, path: String) -> (String, String?, String, String?) Error! {
    raw :: required_text(name, "raw") catch reason { return Err(projection_err(path, reason)) }
    prefix :: optional_text_field(name, "prefix") catch reason { return Err(projection_err(path, reason)) }
    local :: required_text(name, "local") catch reason { return Err(projection_err(path, reason)) }
    namespace_uri :: optional_text_field(name, "namespace_uri") catch reason { return Err(projection_err(path, reason)) }
    (raw, prefix, local, namespace_uri)
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2769
fn selector_matches(local: String, namespace_uri: String?, selector: String) -> Bool Never! {
    if selector.strip_prefix("{") is Val(rest) {
        (uri, sel_local) :: rest.split_once("}") ?? return false
        return local == sel_local && namespace_uri == Val(uri)
    }
    // A prefix:local spelling is never a namespace-prefix selector.
    local == selector && (namespace_uri == null || namespace_uri == Val(""))
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2780
fn text_like_chars(node: Value) -> String? Error! {
    match xml_tag_of(node) {
        Val("text") | Val("cdata") => {
            content :: required_text(node, "value") catch reason { return Err(projection_err("$", reason)) }
            Val(content)
        }
        Val("entity_ref") => optional_text_field(node, "resolved_value") catch reason { return Err(projection_err("$", reason)) }
        _ => null
    }
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2797
fn is_simple_content(children: [Value]) -> Bool Never! {
    loop child in children {
        tag :: xml_tag_of(child)
        if tag != Val("text") && tag != Val("cdata") && tag != Val("entity_ref") -> return false
        if tag == Val("entity_ref") && !(field(child, "resolved_value") is Val(Value.Text(_))) -> return false
    }
    true
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2808
pub fn document_root(document: Value) -> Value Error! {
    if xml_tag_of(document) != Val("document") -> return Err(projection_err("$", "XML root expects a document node"))
    content :: field(document, "children") ?? return Err(projection_err("$", "XML document children missing"))
    if !(content is Value.Array(children)) -> return Err(projection_err("$", "XML document children must be an array"))
    root := null
    loop child in children {
        if xml_tag_of(child) == Val("element") {
            if root != null -> return Err(projection_err("$", "XML document must contain exactly one root element"))
            root = Val(~child)
        }
    }
    root ?? return Err(projection_err("$", "XML document must contain exactly one root element"))
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2836
pub fn expanded_name_parts(node: Value) -> (String, String?, String, String?) Error! {
    match xml_tag_of(node) {
        Val("element") | Val("attribute") | Val("namespace") => {}
        Val(other) => return Err(projection_err("$", "expanded_name requires an element, attribute, or namespace node; found {other}"))
        null => return Err(projection_err("$", "expanded_name requires a tagged XML node"))
    }
    name :: field(node, "name") ?? return Err(projection_err("$", "XML name object missing"))
    read_name_parts(name, "$")
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2856
pub fn lookup_attribute(element: Value, name: String) -> String? Error! {
    if xml_tag_of(element) != Val("element") -> return Err(projection_err("$", "attribute helper requires an element node"))
    content :: field(element, "attributes") ?? return Err(projection_err("$", "XML element attributes missing"))
    if !(content is Value.Array(attributes)) -> return Err(projection_err("$", "XML element attributes must be an array"))
    loop attribute in attributes {
        if xml_tag_of(attribute) != Val("attribute") -> return Err(projection_err("$", "XML attributes array must contain attribute nodes"))
        attr_name :: field(attribute, "name") ?? return Err(projection_err("$", "XML attribute name missing"))
        (_, _, local, namespace_uri) :: read_name_parts(attr_name, "$")
        if !selector_matches(local, namespace_uri, name) -> continue
        normalized :: optional_text_field(attribute, "normalized_value") catch reason { return Err(projection_err("$", reason)) }
        if normalized is Val(content) -> return Val(content)
        return Err(entity_err("@{clark_key(local, namespace_uri)}", "attribute has an unresolved entity"))
    }
    null
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2900
pub fn element_content(element: Value) -> [Value] Error! {
    if xml_tag_of(element) != Val("element") -> return Err(projection_err("$", "content helper requires an element node"))
    content :: field(element, "children") ?? return Err(projection_err("$", "XML element children missing"))
    if !(content is Value.Array(children)) -> return Err(projection_err("$", "XML element children must be an array"))
    ~children
}
// Rust: crates/jet-foundation/src/XmlPull.rs:2915
fn project_element_value(element: Value, path: String) -> Value Error! {
    if xml_tag_of(element) != Val("element") -> return Err(projection_err(path, "Codable projection requires an element node"))
    attr_value :: field(element, "attributes") ?? return Err(projection_err(path, "XML element attributes missing"))
    if !(attr_value is Value.Array(attributes)) -> return Err(projection_err(path, "XML element attributes must be an array"))
    child_value :: field(element, "children") ?? return Err(projection_err(path, "XML element children missing"))
    if !(child_value is Value.Array(children)) -> return Err(projection_err(path, "XML element children must be an array"))
    entries := [(String, Value)]{}
    loop attribute in attributes {
        if xml_tag_of(attribute) != Val("attribute") -> return Err(projection_err(path, "XML attributes array must contain attribute nodes"))
        attr_name :: field(attribute, "name") ?? return Err(projection_err(path, "XML attribute name missing"))
        (_, _, local, namespace_uri) :: read_name_parts(attr_name, path)
        key :: "@{clark_key(local, namespace_uri)}"
        child_path :: if path == "$" -> key else -> "{path}.{key}"
        normalized :: optional_text_field(attribute, "normalized_value") catch reason { return Err(projection_err(child_path, reason)) }
        content :: normalized ?? return Err(entity_err(child_path, "attribute has an unresolved entity"))
        entries.push((key, Value.Text(content)))
    }
    if is_simple_content(children) {
        content := ""
        loop child in children -> content += text_like_chars(child) ?? return Err(entity_err(path, "simple content has an unresolved entity"))
        if entries.is_empty() -> return Value.Text(content)
        entries.push(("$text", Value.Text(content)))
        return Value.Object(^entries)
    }
    child_keys := [(String, Value)]{}
    key_index := [String:Int]{}
    content := [Value]{}
    loop child in children {
        content.push(~child)
        if xml_tag_of(child) != Val("element") -> continue
        name :: field(child, "name") ?? return Err(projection_err(path, "XML child element name missing"))
        (_, _, local, namespace_uri) :: read_name_parts(name, path)
        key :: clark_key(local, namespace_uri)
        child_path :: if path == "$" -> key else -> "{path}.{key}"
        projected :: project_element_value(child, child_path)
        if key_index.get(key) is Val(index) {
            prior := ^child_keys[index].1
            match prior {
                Value.Array(items) => {
                    values := ^items
                    values.push(projected)
                    child_keys[index].1 = Value.Array(^values)
                }
                other => { child_keys[index].1 = Value.Array([Value]{^other, projected}) }
            }
        } else {
            key_index[key] = child_keys.len()
            child_keys.push((key, projected))
        }
    }
    entries.extend(^child_keys)
    entries.push(("$content", Value.Array(^content)))
    Value.Object(^entries)
}
// Rust: crates/jet-foundation/src/XmlPull.rs:3030
pub fn project_document_for_decode(document: Value) -> Value Error! {
    root :: document_root(document)
    project_element_value(root, "$")
}

