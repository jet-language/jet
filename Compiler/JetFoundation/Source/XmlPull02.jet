pub struct StreamWriter {
    encoding: RenderEncoding
    lexical: LexicalPolicy
    started: Bool
    declaration: Bool
    doctype: Bool
    root_seen: Bool
    root_closed: Bool
    ended: Bool
    source_matches: Bool
