// Canonical SHA-256 for compiler-owned identity bytes.
//
// The implementation follows Foundation's SHA256 utility: UTF-8 input is
// padded with the standard big-endian bit length, compression runs on `U32`
// words with wrapping addition, and the public identity helper emits
// lowercase hexadecimal. The round constants stay `Int` tables and are
// widened to `U32` once per digest.

MIR_SHA256_LENGTH_MASK :: prep { 0xffffffffffffffff }
MIR_SHA256_K :: prep { [Int]{
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
} }
MIR_SHA256_H0 :: prep { [Int]{
    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
} }

fn mir_sha256_word(bytes: View<U8>, offset: Int) -> U32 Never! {
    (U32.from_u8(bytes[offset]) << 24) | (U32.from_u8(bytes[offset + 1]) << 16) | (U32.from_u8(bytes[offset + 2]) << 8) | U32.from_u8(bytes[offset + 3])
}

fn mir_sha256_compress(state: &[U32], words: &[U32], k: View<U32>, block: View<U8>) Never! {
    loop index in 0..<16 -> words[index] = mir_sha256_word(block, index * 4)
    loop index in 16..<64 {
        s0 :: words[index - 15].rotate_right(7) ~| words[index - 15].rotate_right(18) ~| (words[index - 15] >> 3)
        s1 :: words[index - 2].rotate_right(17) ~| words[index - 2].rotate_right(19) ~| (words[index - 2] >> 10)
        words[index] = words[index - 16].wrapping_add(s0).wrapping_add(words[index - 7]).wrapping_add(s1)
    }

    a := state[0]
    b := state[1]
    c := state[2]
    d := state[3]
    e := state[4]
    f := state[5]
    g := state[6]
    h := state[7]
    loop index in 0..<64 {
        s1 :: e.rotate_right(6) ~| e.rotate_right(11) ~| e.rotate_right(25)
        ch :: (e & f) ~| ((e ~| U32{0xffffffff}) & g)
        temp1 :: h.wrapping_add(s1).wrapping_add(ch).wrapping_add(k[index]).wrapping_add(words[index])
        s0 :: a.rotate_right(2) ~| a.rotate_right(13) ~| a.rotate_right(22)
        maj :: (a & b) ~| (a & c) ~| (b & c)
        temp2 :: s0.wrapping_add(maj)
        h = g
        g = f
        f = e
        e = d.wrapping_add(temp1)
        d = c
        c = b
        b = a
        a = temp1.wrapping_add(temp2)
    }
    state[0] = state[0].wrapping_add(a)
    state[1] = state[1].wrapping_add(b)
    state[2] = state[2].wrapping_add(c)
    state[3] = state[3].wrapping_add(d)
    state[4] = state[4].wrapping_add(e)
    state[5] = state[5].wrapping_add(f)
    state[6] = state[6].wrapping_add(g)
    state[7] = state[7].wrapping_add(h)
}

// SHA256.rs::sha256: one compression owner for whole inputs and incremental
// framing. Storage is bounded independently of input length.
pub struct MIRSHA256 {
    state: [U32]
    words: [U32]
    constants: [U32]
    block: [U8]
    used: Int
    length: U64
}

pub fn mir_sha256_new() -> MIRSHA256 Never! {
    state := [U32]{}
    loop word in MIR_SHA256_H0 -> &state.push(U32{word})
    constants := [U32]{}
    loop word in MIR_SHA256_K -> &constants.push(U32{word})
    words := [U32]{}
    loop _ in 0..<64 -> &words.push(U32{0})
    block := [U8]{}
    loop _ in 0..<64 -> &block.push(U8{0})
    MIRSHA256{state: state, words: words, constants: constants, block: block, used: 0, length: U64{0}}
}

pub fn mir_sha256_update(hash: &MIRSHA256, data: View<U8>) Never! {
    hash.length = hash.length.wrapping_add(U64{data.len()})
    offset := 0
    if hash.used != 0 {
        loop offset < data.len() && hash.used < 64 {
            hash.block[hash.used] = data[offset]
            hash.used += 1
            offset += 1
        }
        if hash.used == 64 {
            mir_sha256_compress(&hash.state, &hash.words, hash.constants[0..<hash.constants.len()], hash.block[0..<64])
            hash.used = 0
        }
    }
    loop data.len() - offset >= 64 {
        mir_sha256_compress(&hash.state, &hash.words, hash.constants[0..<hash.constants.len()], data[offset..<offset + 64])
        offset += 64
    }
    loop offset < data.len() {
        hash.block[hash.used] = data[offset]
        hash.used += 1
        offset += 1
    }
}

pub fn mir_sha256_finish(state: ^MIRSHA256) -> [U8] Never! {
    hash := ^state
    hash.block[hash.used] = U8{128}
    hash.used += 1
    loop index in hash.used..<64 -> hash.block[index] = U8{0}
    if hash.used > 56 {
        mir_sha256_compress(&hash.state, &hash.words, hash.constants[0..<hash.constants.len()], hash.block[0..<64])
        loop index in 0..<64 -> hash.block[index] = U8{0}
    }
    bit_length :: hash.length.wrapping_mul(U64{8})
    loop index in 0..<8 -> hash.block[56 + index] = U8.from_u64((bit_length >> (8 * (7 - index))) & U64{255}) ?? U8{0}
    mir_sha256_compress(&hash.state, &hash.words, hash.constants[0..<hash.constants.len()], hash.block[0..<64])
    output := [U8]{}
    loop lane in hash.state {
        word :: Int.from_u32(lane)
        &output.push(U8{(word >> 24) & 255})
        &output.push(U8{(word >> 16) & 255})
        &output.push(U8{(word >> 8) & 255})
        &output.push(U8{word & 255})
    }
    output
}

pub fn mir_sha256_bytes(data: View<U8>) -> [U8] Never! {
    hash := mir_sha256_new()
    mir_sha256_update(&hash, data)
    mir_sha256_finish(^hash)
}

pub fn mir_sha256_hex_bytes(bytes: View<U8>) -> String Never! {
    output := [U8]{}
    loop byte in bytes {
        value :: Int.from_u8(byte)
        high :: (value >> 4) & 15
        low :: value & 15
        &output.push(U8{if high < 10 -> 48 + high else -> 87 + high})
        &output.push(U8{if low < 10 -> 48 + low else -> 87 + low})
    }
    String.from_bytes(output) ?? panic("hexadecimal is ASCII")
}

pub fn mir_sha256_hex(value: String) -> String Never! {
    bytes :: value.bytes()
    digest :: mir_sha256_bytes(bytes[0..<bytes.len()])
    mir_sha256_hex_bytes(digest[0..<digest.len()])
}

