// Canonical SHA-256 for compiler-owned identity bytes.
//
// The implementation follows Foundation's SHA256 utility: UTF-8 input is
// padded with the standard big-endian bit length, compression arithmetic is
// reduced to u32 after every operation, and the public identity helper emits
// lowercase hexadecimal.

MIR_SHA256_MASK :: prep { 0xffffffff }
MIR_SHA256_LENGTH_MASK :: prep { 0xffffffffffffffff }
MIR_SHA256_K :: prep { [Int]{
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
} }
MIR_SHA256_H0 :: prep { [Int]{
    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
} }

fn mir_sha256_word(bytes: [U8], offset: Int) -> Int Never! {
    ((Int.from_u8(bytes[offset]) << 24) | (Int.from_u8(bytes[offset + 1]) << 16) | (Int.from_u8(bytes[offset + 2]) << 8) | Int.from_u8(bytes[offset + 3])) & MIR_SHA256_MASK
}

fn mir_sha256_rotr(value: Int, shift: Int) -> Int Never! {
    ((value >> shift) | (value << (32 - shift))) & MIR_SHA256_MASK
}

fn mir_sha256_compress(state: &[Int], block: [U8]) Never! {
    words := [Int]{}
    loop _ in 0..<64 -> &words.push(0)
    loop index in 0..<16 -> words[index] = mir_sha256_word(block, index * 4)
    loop index in 16..<64 {
        s0 :: mir_sha256_rotr(words[index - 15], 7) ~| mir_sha256_rotr(words[index - 15], 18) ~| (words[index - 15] >> 3)
        s1 :: mir_sha256_rotr(words[index - 2], 17) ~| mir_sha256_rotr(words[index - 2], 19) ~| (words[index - 2] >> 10)
        words[index] = (words[index - 16] + s0 + words[index - 7] + s1) & MIR_SHA256_MASK
    }

    a := state[0]
    b := state[1]
    c := state[2]
    d := state[3]
    e := state[4]
    f := state[5]
    g := state[6]
    h := state[7]
    loop index in 0..<64 {
        s1 :: mir_sha256_rotr(e, 6) ~| mir_sha256_rotr(e, 11) ~| mir_sha256_rotr(e, 25)
        ch :: ((e & f) ~| ((MIR_SHA256_MASK ~| e) & g)) & MIR_SHA256_MASK
        temp1 :: (h + s1 + ch + MIR_SHA256_K[index] + words[index]) & MIR_SHA256_MASK
        s0 :: mir_sha256_rotr(a, 2) ~| mir_sha256_rotr(a, 13) ~| mir_sha256_rotr(a, 22)
        maj :: ((a & b) ~| (a & c) ~| (b & c)) & MIR_SHA256_MASK
        temp2 :: (s0 + maj) & MIR_SHA256_MASK
        h = g
        g = f
        f = e
        e = (d + temp1) & MIR_SHA256_MASK
        d = c
        c = b
        b = a
        a = (temp1 + temp2) & MIR_SHA256_MASK
    }
    state[0] = (state[0] + a) & MIR_SHA256_MASK
    state[1] = (state[1] + b) & MIR_SHA256_MASK
    state[2] = (state[2] + c) & MIR_SHA256_MASK
    state[3] = (state[3] + d) & MIR_SHA256_MASK
    state[4] = (state[4] + e) & MIR_SHA256_MASK
    state[5] = (state[5] + f) & MIR_SHA256_MASK
    state[6] = (state[6] + g) & MIR_SHA256_MASK
    state[7] = (state[7] + h) & MIR_SHA256_MASK
}

fn mir_sha256_bytes(data: [U8]) -> [U8] Never! {
    state := MIR_SHA256_H0
    msg := [U8]{}
    loop byte in data -> &msg.push(byte)
    &msg.push(U8{128})
    loop msg.len() % 64 != 56 -> &msg.push(U8{0})
    bit_length :: (data.len() * 8) & MIR_SHA256_LENGTH_MASK
    index := 7
    loop index >= 0 {
        length_byte :: (bit_length >> (8 * index)) & 255
        &msg.push(U8{length_byte})
        index -= 1
    }
    offset := 0
    loop offset < msg.len() {
        block :: loop position in 0..<64 -> msg[offset + position]
        mir_sha256_compress(&state, block)
        offset += 64
    }
    output := [U8]{}
    loop word in state {
        first :: (word >> 24) & 255
        second :: (word >> 16) & 255
        third :: (word >> 8) & 255
        fourth :: word & 255
        &output.push(U8{first})
        &output.push(U8{second})
        &output.push(U8{third})
        &output.push(U8{fourth})
    }
    output
}

fn mir_sha256_hex_digit(value: Int) -> String Never! {
    if value < 10 -> String.from_bytes([U8{48 + value}]) ?? "0"
    else -> String.from_bytes([U8{87 + value}]) ?? "0"
}

pub fn mir_sha256_hex_bytes(bytes: [U8]) -> String Never! {
    output := ""
    loop byte in bytes {
        value :: Int.from_u8(byte)
        output = "{output}{mir_sha256_hex_digit((value >> 4) & 15)}{mir_sha256_hex_digit(value & 15)}"
    }
    output
}

pub fn mir_sha256_hex(value: String) -> String Never! {
    mir_sha256_hex_bytes(mir_sha256_bytes(value.bytes()))
}

