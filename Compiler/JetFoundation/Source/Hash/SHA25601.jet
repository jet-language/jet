// Tree identity is a hostile-input boundary. Keep the per-file read and the
// total accepted payload bounded while hashing from a fixed-size buffer.
// Rust: crates/jet-foundation/src/SHA256.rs:21
pub MAX_TREE_FILE_BYTES :: prep { U64{512 * 1024 * 1024} }
// Rust: crates/jet-foundation/src/SHA256.rs:22
pub MAX_TREE_TOTAL_BYTES :: prep { U64{4 * 1024 * 1024 * 1024} }
// Rust: crates/jet-foundation/src/SHA256.rs:23
pub MAX_TREE_FILES :: prep { 1_000_000 }
// Rust: crates/jet-foundation/src/SHA256.rs:24
pub MAX_TREE_NODES :: prep { 2_000_000 }
// Rust: crates/jet-foundation/src/SHA256.rs:25
pub MAX_TREE_DEPTH :: prep { 256 }

