// One JSON parser for the embedded Prelude and comptime adapters.
use DataTree.[DataTree]
use EncodingErrors
use JSONNumber.[validate_json_number]

// Rust: crates/jet-foundation/src/EncodingJson.rs:5
pub MAX_JSON_DEPTH :: prep { 64 }
// Rust: crates/jet-foundation/src/EncodingJson.rs:60
#Error
pub struct Error { pub line: I64, pub message: String }
// Rust: crates/jet-foundation/src/EncodingJson.rs:65
pub fn parse_json(text: String, reject_duplicate_keys: Bool) -> DataTree Error! {
    parse_json_with_modes(text, reject_duplicate_keys, false, false)
}
// Rust: crates/jet-foundation/src/EncodingJson.rs:69
pub fn parse_json_exact_numbers(text: String, reject_duplicate_keys: Bool) -> DataTree Error! {
    parse_json_with_modes(text, reject_duplicate_keys, true, false)
}
// Rust: crates/jet-foundation/src/EncodingJson.rs:76
pub fn parse_json_typed(text: String, reject_duplicate_keys: Bool) -> DataTree Error! {
    parse_json_with_modes(text, reject_duplicate_keys, true, true)
}
// Rust: crates/jet-foundation/src/EncodingJson.rs:83
fn parse_json_with_modes(text: String, reject_duplicate_keys: Bool, preserve_numbers: Bool, preserve_strings: Bool) -> DataTree Error! {
    parser := Parser{chars: text.chars().collect(), pos: 0, reject_duplicate_keys: reject_duplicate_keys, preserve_numbers: preserve_numbers, preserve_strings: preserve_strings}
    value :: parser.value(0)?
    parser.ws()
    if parser.pos != parser.chars.len() -> return err(parser.err(EncodingErrors.JSON_EXTRA_TEXT))
    ^value
}
// Rust: crates/jet-foundation/src/EncodingJson.rs:104
pub fn is_json_structural_whitespace(c: Char) -> Bool { c == ' ' || c == '\t' || c == '\r' || c == '\n' }

// Rust: crates/jet-foundation/src/EncodingJson.rs:108
struct Parser {
    chars: [Char]
    pos: Int
    reject_duplicate_keys: Bool
    preserve_numbers: Bool
    preserve_strings: Bool

    // Rust: crates/jet-foundation/src/EncodingJson.rs:117
    fn err(self: Parser, message: String) -> Error {
        line :: I64{self.chars.slice(0, self.pos.min(self.chars.len())).iter().filter(|c| -> c == '\n').count()} + 1
        Error{line: line, message: ~message}
    }
    // Rust: crates/jet-foundation/src/EncodingJson.rs:129
    fn peek(self: Parser) -> Char? { self.chars.get(self.pos) }
    // Rust: crates/jet-foundation/src/EncodingJson.rs:133
    fn ws(self: &Parser) -> {
        loop self.pos < self.chars.len() && is_json_structural_whitespace(self.chars[self.pos]) { self.pos += 1 }
    }
    // Rust: crates/jet-foundation/src/EncodingJson.rs:139
    fn value(self: &Parser, depth: Int) -> DataTree Error! {
        self.ws()
        match self.peek() {
            Val('n') => self.word("null", DataTree.Null)
            Val('t') => self.word("true", DataTree.Bool(true))
            Val('f') => self.word("false", DataTree.Bool(false))
            Val('"') => {
                text :: self.string()?
                if self.preserve_strings -> DataTree.TypedText(^text) else -> DataTree.Text(^text)
            }
            Val('[') => self.array(depth)
            Val('{') => self.object(depth)
            Val('-') | Val('0'..='9') => self.number()
            _ => err(self.err(EncodingErrors.JSON_EXPECTED_VALUE))
        }
    }
    // Rust: crates/jet-foundation/src/EncodingJson.rs:160
    fn word(self: &Parser, word: String, value: DataTree) -> DataTree Error! {
        loop ch in word.chars() {
            if self.peek() != Val(ch) -> return err(self.err(EncodingErrors.JSON_EXPECTED_WORD))
            self.pos += 1
        }
        ^value
    }
    // Rust: crates/jet-foundation/src/EncodingJson.rs:170
    fn string(self: &Parser) -> String Error! {
        if self.peek() != Val('"') -> return err(self.err(EncodingErrors.JSON_EXPECTED_QUOTED_TEXT))
        self.pos += 1
        out := ""
        loop {
            c :: self.peek() ?? break
            self.pos += 1
            match c {
                '"' => return ^out
                '\\' => {
                    escape :: self.peek() ?? return err(self.err(EncodingErrors.JSON_UNFINISHED_ESCAPE))
                    self.pos += 1
                    match escape {
                        '"' => out.push('"')
                        '\\' => out.push('\\')
                        '/' => out.push('/')
                        'b' => out.push('\u{0008}')
                        'f' => out.push('\u{000c}')
                        'n' => out.push('\n')
                        'r' => out.push('\r')
                        't' => out.push('\t')
                        'u' => self.unicode_escape(&out)?
                        _ => return err(self.err(EncodingErrors.JSON_INVALID_ESCAPE))
                    }
                }
                c if U32{c} < 0x20 => return err(self.err(EncodingErrors.JSON_CONTROL_CHARACTER))
                other => out.push(other)
            }
        }
        err(self.err(EncodingErrors.JSON_MISSING_CLOSING_QUOTE))
    }
    // Rust: crates/jet-foundation/src/EncodingJson.rs:207
    fn unicode_escape(self: &Parser, out: &String) -> Unit Error! {
        code_point :: self.hex4()?
        if code_point >= 0xD800 && code_point <= 0xDBFF {
            if self.peek() != Val('\\') -> return err(self.err(EncodingErrors.JSON_UNPAIRED_SURROGATE))
            self.pos += 1
            if self.peek() != Val('u') -> return err(self.err(EncodingErrors.JSON_UNPAIRED_SURROGATE))
            self.pos += 1
            low :: self.hex4()?
            if low < 0xDC00 || low > 0xDFFF -> return err(self.err(EncodingErrors.JSON_UNPAIRED_SURROGATE))
            combined :: 0x10000 + ((code_point - 0xD800) << 10) + (low - 0xDC00)
            ch :: Char.from_u32(combined) ?? return err(self.err(EncodingErrors.JSON_INVALID_UNICODE_ESCAPE))
            out.push(ch)
        } else if code_point >= 0xDC00 && code_point <= 0xDFFF {
            return err(self.err(EncodingErrors.JSON_UNPAIRED_SURROGATE))
        } else {
            ch :: Char.from_u32(code_point) ?? return err(self.err(EncodingErrors.JSON_INVALID_UNICODE_ESCAPE))
            out.push(ch)
        }
    }
    // Rust: crates/jet-foundation/src/EncodingJson.rs:242
    fn hex4(self: &Parser) -> U32 Error! {
        value := U32{0}
        loop _ in 0..4 {
            ch :: self.peek() ?? return err(self.err(EncodingErrors.JSON_TRUNCATED_UNICODE_ESCAPE))
            digit :: ch.to_digit(16) ?? return err(self.err(EncodingErrors.JSON_INVALID_UNICODE_ESCAPE))
            value = value * 16 + digit
            self.pos += 1
        }
        value
    }
    // Rust: crates/jet-foundation/src/EncodingJson.rs:257
    fn number(self: &Parser) -> DataTree Error! {
        start :: self.pos
        if self.peek() == Val('-') { self.pos += 1 }
        match self.peek() {
            Val('0') => { self.pos += 1 }
            Val('1'..='9') => {
                self.pos += 1
                loop self.peek().is_some_and(|c| -> c >= '0' && c <= '9') { self.pos += 1 }
            }
            _ => return err(self.err(EncodingErrors.JSON_BAD_NUMBER))
        }
        if self.peek() == Val('.') {
            self.pos += 1
            if !self.peek().is_some_and(|c| -> c >= '0' && c <= '9') -> return err(self.err(EncodingErrors.JSON_BAD_NUMBER))
            loop self.peek().is_some_and(|c| -> c >= '0' && c <= '9') { self.pos += 1 }
        }
        if self.peek() == Val('e') || self.peek() == Val('E') {
            self.pos += 1
            if self.peek() == Val('+') || self.peek() == Val('-') { self.pos += 1 }
            if !self.peek().is_some_and(|c| -> c >= '0' && c <= '9') -> return err(self.err(EncodingErrors.JSON_BAD_NUMBER))
            loop self.peek().is_some_and(|c| -> c >= '0' && c <= '9') { self.pos += 1 }
        }
        text: String :: self.chars.slice(start, self.pos).iter().collect()
        is_integer :: !text.contains('.') && !text.contains('e') && !text.contains('E')
        if self.preserve_numbers {
            validate_json_number(text) catch message -> return err(self.err(message))
            return DataTree.Number(^text)
        }
        if is_integer {
            if value :: text.parse<I64>().ok() -> return DataTree.Int(value)
            validate_json_number(text) catch message -> return err(self.err(message))
            return DataTree.Number(^text)
        }
        value :: text.parse<F64>() catch _ -> return err(self.err(EncodingErrors.JSON_BAD_NUMBER))
        if !value.is_finite() -> return err(self.err(EncodingErrors.JSON_BAD_NUMBER))
        DataTree.Float(value)
    }
    // Rust: crates/jet-foundation/src/EncodingJson.rs:317
    fn array(self: &Parser, depth: Int) -> DataTree Error! {
        if depth >= MAX_JSON_DEPTH -> return err(self.err("JSON value is nested too deeply"))
        self.pos += 1
        values := [DataTree]{}
        loop {
            self.ws()
            if self.peek() == Val(']') { self.pos += 1; return DataTree.Array(^values) }
            values.push(self.value(depth + 1)?)
            self.ws()
            match self.peek() {
                Val(',') => {
                    self.pos += 1
                    self.ws()
                    if self.peek() == Val(']') -> return err(self.err(EncodingErrors.JSON_EXPECTED_ARRAY_SEPARATOR))
                }
                Val(']') => {}
                _ => return err(self.err(EncodingErrors.JSON_EXPECTED_ARRAY_SEPARATOR))
            }
        }
    }
    // Rust: crates/jet-foundation/src/EncodingJson.rs:347
    fn object(self: &Parser, depth: Int) -> DataTree Error! {
        if depth >= MAX_JSON_DEPTH -> return err(self.err("JSON value is nested too deeply"))
        self.pos += 1
        fields := [(String, DataTree)]{}
        loop {
            self.ws()
            if self.peek() == Val('}') { self.pos += 1; return DataTree.Object(^fields) }
            key :: self.string()?
            self.ws()
            if self.peek() != Val(':') -> return err(self.err(EncodingErrors.JSON_EXPECTED_OBJECT_COLON))
            self.pos += 1
            if self.reject_duplicate_keys && fields.iter().any(|(field, _)| -> field == key) -> return err(self.err("{EncodingErrors.JSON_DUPLICATE_OBJECT_KEY} `{key}`"))
            value :: self.value(depth + 1)?
            if current :: fields.iter_mut().find(|(field, _)| -> field == key) { current.1 = ^value }
            else { fields.push((^key, ^value)) }
            self.ws()
            match self.peek() {
                Val(',') => {
                    self.pos += 1
                    self.ws()
                    if self.peek() == Val('}') -> return err(self.err(EncodingErrors.JSON_EXPECTED_OBJECT_SEPARATOR))
                }
                Val('}') => {}
                _ => return err(self.err(EncodingErrors.JSON_EXPECTED_OBJECT_SEPARATOR))
            }
        }
    }
}
// Rust: crates/jet-foundation/src/EncodingJson.rs:396
pub fn render_json(j: DataTree, pretty: Bool, depth: Int) -> String {
    match j {
        DataTree.Null => "null"
        DataTree.Bool(value) => value.to_string()
        DataTree.Int(value) => value.to_string()
        DataTree.Float(value) => { assert(value.is_finite(), "JSON cannot encode a non-finite Float"); value.debug() }
        DataTree.Number(value) => ~value
        DataTree.TypedText(value) | DataTree.Text(value) => quote_json(value)
        DataTree.Bytes(_) => panic("JSON cannot encode Bytes")
        DataTree.Array(items) => {
            if items.is_empty() -> return "[]"
            if !pretty {
                parts :: items.iter().map(|x| -> render_json(x, false, depth)).collect()
                return "[" + parts.join(",") + "]"
            }
            pad :: "  ".repeat(depth + 1)
            end :: "  ".repeat(depth)
            parts :: items.iter().map(|x| -> pad + render_json(x, true, depth + 1)).collect()
            "[\n" + parts.join(",\n") + "\n" + end + "]"
        }
        DataTree.Object(entries) => {
            if entries.is_empty() -> return "{}"
            if !pretty {
                parts :: entries.iter().map(|(key, value)| -> quote_json(key) + ":" + render_json(value, false, depth)).collect()
                return "{" + parts.join(",") + "}"
            }
            pad :: "  ".repeat(depth + 1)
            end :: "  ".repeat(depth)
            parts :: entries.iter().map(|(key, value)| -> pad + quote_json(key) + ": " + render_json(value, true, depth + 1)).collect()
            "{\n" + parts.join(",\n") + "\n" + end + "}"
        }
    }
}
// Rust: crates/jet-foundation/src/EncodingJson.rs:456
pub fn quote_json(s: String) -> String {
    out := "\""
    loop c in s.chars() {
        match c {
            '"' => out.push_str("\\\"")
            '\\' => out.push_str("\\\\")
            '\u{0008}' => out.push_str("\\b")
            '\u{000c}' => out.push_str("\\f")
            '\n' => out.push_str("\\n")
            '\r' => out.push_str("\\r")
            '\t' => out.push_str("\\t")
            c if U32{c} < 0x20 => { out.push_str("\\u"); out.push_str(U32{c}.to_radix_string(16).pad_left(4, '0')) }
            _ => out.push(c)
        }
    }
    out.push('"')
    ^out
}
