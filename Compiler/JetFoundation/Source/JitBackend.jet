// Foundation-owned execution seam: adapters depend on this owner, never on the
// driver. Completed output must be byte-identical to the compiled program.
use JetFoundation.Diagnostics.[Diagnostic]
use JetFoundation.MIR.[MirArtifactId, MirProgram]
// Rust: crates/jet-foundation/src/JitBackend.rs:18
pub enum RunOutcome {
    Ran(stdout: String, stderr: String, exit_code: I32)
    Problems(diagnostics: [Diagnostic])
}
// Rust: crates/jet-foundation/src/JitBackend.rs:36
pub trait JitBackend {
    // Invocation-local policy is projected by concrete adapters; no package
    // model dependency or backend-global policy is introduced in Foundation.
    type InvocationPolicy
    // Rust: crates/jet-foundation/src/JitBackend.rs:47
    fn run(&self, program: MirProgram, artifact: MirArtifactId, try_anyway: Bool,
        policy: Self.InvocationPolicy) -> RunOutcome
    // Rust: crates/jet-foundation/src/JitBackend.rs:63
    // Compatibility already checked by sema. Errors are run diagnostics.
    fn hot_swap(&self, module_name: String, program: MirProgram, artifact: MirArtifactId,
        try_anyway: Bool, policy: Self.InvocationPolicy) -> Result<RunOutcome,[Diagnostic]>
    // Rust: crates/jet-foundation/src/JitBackend.rs:76
    fn restart(&self, program: MirProgram, artifact: MirArtifactId, try_anyway: Bool,
        policy: Self.InvocationPolicy) -> RunOutcome
}
