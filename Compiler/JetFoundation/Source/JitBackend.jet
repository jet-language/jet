//RS #[derive(Debug, Clone)]
//RS pub enum RunOutcome {
//RS     /// The program ran to completion. `stdout`/`stderr`/`exit_code` are
//RS     /// byte-identical to the compiled program (Q2 — enforced by the
//RS     /// differential battery in `tests/dev.rs`).
//RS     Ran {
//RS         stdout: String,
//RS         stderr: String,
//RS         exit_code: i32,
//RS     },
//RS     /// Front-end or runtime diagnostics, including E2202 fuel stops and
//RS     /// canonical-evaluator refusals.
//RS     Problems(Vec<Diagnostic>),
//RS }
//RS 
//RS /// The execution seam shared by every tier (interpreter now, Cranelift later).
//RS ///
//RS /// Callers hold a `&mut dyn JitBackend` and never name a concrete engine, so
//RS /// a future tier-1 (or c140 bytecode VM / c141 native JIT) is a drop-in.
//RS pub trait JitBackend {
//RS     /// The canonical, invocation-local policy carried by this backend.
//RS     ///
//RS     /// Foundation cannot depend on the package model without creating a
//RS     /// dependency cycle, so the concrete adapters bind this projection to
//RS     /// `ReleaseDevtoolsPolicy` themselves.  The policy is deliberately an
//RS     /// input to every execution transition rather than backend-global state.
//RS     type InvocationPolicy: ?Sized;
//RS 
//RS     /// Run an optimized canonical MIR artifact to completion.
//RS     /// `try_anyway` is an invocation option passed to the canonical evaluator.
//RS     fn run(
//RS         &mut self,
//RS         program: &MirProgram,
//RS         artifact: MirArtifactId,
//RS         try_anyway: bool,
//RS         policy: &Self::InvocationPolicy,
//RS     ) -> RunOutcome;
//RS 
//RS     /// Apply a type-stable edit to `module_name` and run the new artifact.
//RS     ///
//RS     /// The caller has already confirmed type stability via
//RS     /// `Sema::HotSwap::type_stable_check`. `Err` means the run produced
//RS     /// diagnostics (e.g. E2202 fuel stop), not a type mismatch.
//RS     ///
//RS     /// Cranelift tier-1 re-links the changed module in the resident process,
//RS     /// preserving live heap state. Tier-0 re-evaluates from scratch.
//RS     fn hot_swap(
//RS         &mut self,
//RS         module_name: &str,
//RS         program: &MirProgram,
//RS         artifact: MirArtifactId,
//RS         try_anyway: bool,
//RS         policy: &Self::InvocationPolicy,
//RS     ) -> Result<RunOutcome, Vec<Diagnostic>>;
//RS 
//RS     /// Restart cleanly on a type/layout-changing edit and run the new artifact.
//RS     ///
//RS     /// Tier-0: same as `run`. Tier-1: tear down the resident process, rebuild,
//RS     /// and announce the restart per D-HOTSWAP1.
//RS     fn restart(
//RS         &mut self,
//RS         program: &MirProgram,
//RS         artifact: MirArtifactId,
//RS         try_anyway: bool,
//RS         policy: &Self::InvocationPolicy,
