//RS pub const RENAME_ALL_KEBAB: &str = "kebab"; // D-SERDE3
//RS pub const RENAME_ALL_SCREAMING: &str = "screaming"; // D-SERDE3
//RS 
//RS // ── Maturity metadata values (D-MARK-META1=B, ratified 2026-07-12) ──────────
//RS // Closed values for `#Meta(maturity: .Experimental | .Tested | .Hardened)`.
//RS // They are not standalone markers and therefore are absent from marker-plane
//RS // registries. No sema/codegen effect.
//RS pub const MARKER_EXPERIMENTAL: &str = "Experimental"; // D-MARK-META1
//RS pub const MARKER_TESTED: &str = "Tested"; // D-MARK-META1
//RS pub const MARKER_HARDENED: &str = "Hardened"; // D-MARK-META1
//RS 
//RS // ── Explicit discard (D-IGNORERET2=A, ratified 2026-06-28; amended by
//RS // D-MARK-DISCARD1=A, ratified 2026-07-11, card #498) ─────────────────────────
//RS // `.drop("reason")` — method-style terminal that silences E0402 for a
//RS // fallible or #MustUse result. It is now the SOLE discard spelling; the
//RS // `#Suppress(MustUse) { … }` lexical-scope form is retired outright
//RS // (ordinary unknown-marker error — no MARKER_SUPPRESS registration).
//RS pub const METHOD_DROP: &str = "drop"; // D-IGNORERET2 method; distinct from consume builtin
//RS 
//RS // ──────────────────────────────────────────────────────────────────────────────
//RS // Canonical keyword/type/builtin tables (c44: single source of truth).
//RS //
//RS // These slices are the authoritative lists for the LSP, formatter, TextMate
//RS // grammar, and any other consumer that needs to enumerate Jet's keyword surface.
//RS // Add a word here (with its decision ID) rather than in each consumer.
//RS //
//RS // Rules for each list:
//RS //   JET_KEYWORD_LIST  — real Jet keywords a user can type; FOREIGN_* teaching
//RS //                       words must NOT appear here.
//RS //   JET_TYPE_LIST     — built-in primitive / collection type names for completion
//RS //                       and rename-guard. Only types a user writes in source.
//RS //   IMPURE_BUILTINS   — bare-name builtins that write to I/O or read from stdin;
//RS //                       used by both Sema/Purity and Comptime/Purity.
//RS // ──────────────────────────────────────────────────────────────────────────────
//RS 
//RS /// Canonical list of real Jet keywords for LSP completion and rename validation.
//RS ///
//RS /// Every entry corresponds to a `KW_*`, `LIT_*`, or `BUILTIN_*` constant above.
//RS /// FOREIGN_* teaching-error words must NOT appear here — they are recognized only
//RS /// to emit a diagnostic, not valid syntax.
//RS pub const JET_KEYWORD_LIST: &[&str] = &[
//RS     // Core structure (S1, S18, D-VISDEFAULT2, S16, S50, U3)
//RS     KW_FN,
//RS     KW_PUB,
//RS     KW_PRIV,
//RS     KW_USE,
//RS     KW_AS,
//RS     KW_EXTERN,
//RS     KW_MODULE,
//RS     // Control flow (M1, S19, S23, M1/M2)
//RS     KW_IF,
//RS     KW_ELSE,
//RS     KW_LOOP,
//RS     KW_IN,
//RS     KW_BREAK,
//RS     KW_RETURN,
//RS     KW_DEFER,
//RS     // Types and declarations (M2, S30, S27, M2, S28, S55, S57, D-DIST1)
//RS     KW_STRUCT,
//RS     KW_ENUM,
//RS     KW_ALIAS,
//RS     KW_IMPL,
//RS     KW_POLICY,
//RS     KW_WRAP,
//RS     KW_TRAIT,
//RS     KW_TAG,
//RS     KW_EFFECT_DECL,
//RS     KW_DERIVE,
//RS     // D-VERDICT-1308-1: `comptime` is retired teaching-only (E0374 → `@`).
//RS     KW_DISTINCT,
//RS     // Schema migrations (D-MIGRATE1 / D-MIGRATE2)
//RS     KW_MIGRATION,
//RS     KW_RENAME,
//RS     KW_ADD,
//RS     KW_REMOVE,
//RS     KW_CHANGE,
//RS     KW_VIA,
//RS     // Ownership / borrow keywords (S10, M2). D-MEM1 retired KW_MUTATE/KW_MOVE
//RS     // in favor of the `&`/`^` sigils, and D-SHAPE-COPY1=A retired KW_COPY in
//RS     // favor of the `~` sigil — they live only as teaching errors (E0056/E0057/
//RS     // E0991) now, so none of them are in the keyword list. The retired
//RS     // `ref[label]` field spelling (once taught via KW_STORED) is gone
//RS     // outright with stored-reference fields (D-MEM1/S3) — `ref` is an
//RS     // ordinary identifier again.
//RS     KW_SELF,
//RS     // Memory / expert tier (S58, D-REGION1, D-CTX1, D-TERM1, D-CTEFFECT1)
//RS     KW_UNSAFE,
//RS     KW_IMPURE,
//RS     CTX_BLOCK,
//RS     // D-CONC-SPAWN1=D: one reserved word owns task spawning and fan-out.
//RS     KW_CONC_TASK,
//RS     // D-CONC-FREEZE1=A: immutable task-crossing snapshot verb.
//RS     KW_FREEZE,
//RS     // D-CONC-SHARE1=A: shared-cell construction is contextual syntax.
//RS     KW_SHARED,
//RS     // Transactions (D-TXN1–D-TXN4): `#Transact(name) { … }`
//RS     KW_TRANSACT,
//RS     // Schedule-as-code (D-SCHEDULE1, card #505): `#Job fn` — `#Every(…)`
//RS     // stays out of this list, matching MARKER_TARGET/MARKER_META (paren-arg
//RS     // config markers aren't bare completion words).
//RS     KW_JOB,
//RS     // Test / tooling (S43, S60, D-TOOL2)
//RS     KW_TEST,
//RS     KW_TODO,
//RS     // D-TAG-SURFACE1=A retired `Tainted`/`Sanitizer`; direct declared tags and
//RS     // `#Scrub(Tag)` come from the applied-rule registry.
//RS     // Typestate (D-STATE1 / D-STATE-HOME1 / D-STATE-REQ / D-STATE-TRANS)
//RS     KW_STATE,
//RS     KW_TRANSITION,
//RS     KW_STATE_DECL,
//RS     // Session/protocol types (D-PROTO1 / D-PROTO2)
//RS     KW_PROTOCOL,
//RS     PROTO_CLIENT,
//RS     PROTO_SERVER,
//RS     // Rule declarations (D-META-NAME1 / D-META-FORM1 / D-MARKER-SITES1)
//RS     KW_MARKER,
//RS     // In-body struct validation (D-VALIDATE1, card #506)
//RS     KW_VALIDATE_BLOCK,
//RS     VALIDATE_CHECK_FN,
//RS     // Reserved literals: boolean (S11), option (S32), synthetic (M4).
//RS     // Result `Ok`/`Err` and Optional `Val` are contextual identifiers, so their
//RS     // canonical LIT_* constants intentionally stay outside this keyword list.
//RS     LIT_TRUE,
//RS     LIT_FALSE,
//RS     LIT_NULL,
//RS     KW_IT,
//RS     // Binding sigils (SIGIL_BIND_IMMUT / SIGIL_BIND_MUT) are not words; omitted.
//RS ];
//RS 
//RS /// Canonical list of built-in type names for LSP completion and rename guard.
//RS ///
//RS /// Only types a user writes in source. `Result` is the legacy fallible type
//RS /// (S34) kept for teaching errors; it is intentionally excluded here since
//RS /// failure contracts use the prefix spelling `!E` (or `!(E1 | E2)`).
//RS pub const JET_TYPE_LIST: &[&str] = &[
//RS     TYPE_INT,
