// Rust: crates/jet-foundation/src/Syntax/package_files.rs:50
// COMMAND_FILE_TEST is owned by Syntax/Spellings.jet.
// Rust: crates/jet-foundation/src/Syntax/package_files.rs:51
// COMMAND_ROLE_FILES is owned by Syntax/Spellings.jet in the original order.

// Rust: crates/jet-foundation/src/Syntax/package_files.rs:59
pub fn command_role_file(command: String) -> String? Never! {
    match command {
        "run" => Val(COMMAND_FILE_RUN)
        "build" => Val(COMMAND_FILE_BUILD)
        "dev" => Val(COMMAND_FILE_DEV)
        "test" => Val(COMMAND_FILE_TEST)
        _ => null
    }
}

