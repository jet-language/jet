//RS /// D-DETACH1 (ratified; D-DETACH1 = A): consumes a Task handle without joining
//RS /// — fire-and-forget daemon semantics. Main may return while the task runs.
//RS /// Only valid on owned tasks; capturing a `view` borrow is rejected at spawn
//RS /// time (E1102) and flagged again at the detach site (E1103).
//RS pub const TASK_DETACH: &str = "detach"; // D-DETACH1
//RS 
//RS /// D-REPRC1 (ratified; D-REPRC1 = B) / D-PLACE1=A / D-LAYOUT-ALIGN1=A:
//RS /// `#Layout(…)` struct attribute controls the memory layout of the generated
//RS /// Rust struct. `#Layout(c)` stamps `#[repr(C)]` for C interop;
//RS /// `#Layout(c, align(N))` requests a portable profile-supported power-of-two
//RS /// byte alignment, while `#Layout(c, align(target, N))` opts into the selected
//RS /// target profile for larger proven boundaries. Field order is preserved as
//RS /// written. Growable fields (`[T]`, `Map`, `String`) are rejected (E1104);
//RS /// unsupported or unproven alignment values are rejected by sema (E1119).
//RS /// PascalCase per D-MARKERCASE1=A.
//RS pub const MARKER_LAYOUT: &str = "Layout"; // D-REPRC1 / D-MARKERCASE1
//RS /// D-REPRC1: the C-compatible layout variant — `#Layout(c)` → `#[repr(C)]`.
//RS pub const LAYOUT_C: &str = "c"; // D-REPRC1
//RS /// D-REPRC1: `packed` and first-argument `align` remain reserved.
//RS pub const LAYOUT_PACKED: &str = "packed"; // D-REPRC1 (reserved)
//RS /// D-PLACE1=A: explicit alignment is the second argument of `#Layout(c)`.
//RS pub const LAYOUT_ALIGN: &str = "align"; // D-PLACE1
//RS /// D-SOA1 / D-SOA2A=C (implemented): the struct-of-arrays layout variant —
//RS /// `#Layout(columnar) struct S` stores a `[S]` collection column-per-field.
//RS /// Whole-struct only in v1 (D-SOA2B); the partial form `#Layout(columnar: …)`
//RS /// is rejected (E1109) and the per-container prefix `columnar [T]` is reserved
//RS /// (D-SOA2C, E1107).
//RS pub const LAYOUT_COLUMNAR: &str = "columnar"; // D-SOA1 / D-SOA2A
//RS 
//RS // ── Serde derive markers + attributes (D-SERDE2–8, D-ENC1; bracket form D-ATTR2) ──
//RS // Derive markers (PascalCase per D-CASING1, written `#[…]` before a struct/enum,
//RS // D-VERDICT-732-1, formerly D-MARKERMOVE1=B): `#[Codable]` derives BOTH
//RS // directions (sugar for `#[Encode, Decode]`); `#[Encode]` is write-only;
//RS // `#[Decode]` is read-only. Owner (D-SERDE4 = B, modified): the
//RS // collapsed umbrella is `Codable`, with `Encode`/`Decode` as the one-way markers.
//RS pub const MARKER_CODABLE: &str = "Codable"; // D-SERDE4
//RS pub const MARKER_RECEIPT: &str = "Receipt"; // D-FOUND-RECEIPT1
//RS pub const MARKER_ENCODE: &str = "Encode"; // D-SERDE4
//RS pub const MARKER_DECODE: &str = "Decode"; // D-SERDE4
//RS                                           // D-VERDICT-732-1 (formerly D-MARKERMOVE3, B, ratified 2026-07-02): the
//RS                                           // other built-in derive markers that join Codable/Encode/Decode — all on
//RS                                           // `#`, the sole rule prefix.
//RS                                           // D-META-AUTO1=A / D-AUTODERIVE-SYNTAX1=D: all six structural
//RS                                           // auto-derive controls accept the same leading `!` refusal, including
//RS                                           // `#!Codable`. User derives (`derive T.Wire { … }`, applied as
//RS                                           // `#[Wire]`) also stay `#` — built-in and user derives share the
//RS                                           // same prefix; only the derive name tells them apart.
//RS pub const MARKER_COMPARABLE: &str = "Comparable"; // D-VERDICT-732-1 (formerly D-MARKERMOVE3)
//RS                                                   // Per-field attributes (D-SERDE5 = A), written `#[…]` before a field.
//RS pub const MARKER_RENAME: &str = "Rename"; // D-SERDE5  #[Rename("wire_key")]
//RS pub const MARKER_SKIP: &str = "Skip"; // D-SERDE5  #[Skip]
//RS pub const MARKER_DEFAULT: &str = "Default"; // D-SERDE5  #[Default] / #[Default(expr)]
//RS pub const MARKER_FLATTEN: &str = "Flatten"; // D-SERDE5  #[Flatten]
//RS                                             // Container attributes (D-SERDE3/7/8), written `#[…]` before a struct/enum.
//RS pub const MARKER_RENAME_ALL: &str = "RenameAll"; // D-SERDE3  #[RenameAll(camel)]
//RS pub const MARKER_DENY_UNKNOWN_FIELDS: &str = "DenyUnknownFields"; // D-SERDE8
//RS /// D-MARKER-NAME-HYGIENE1=A: serde's internal discriminant field is not a
//RS /// compile-time fact tag.
//RS pub const MARKER_TAG: &str = "Discriminant"; // D-SERDE7, D-MARKER-NAME-HYGIENE1
//RS pub const MARKER_UNTAGGED: &str = "Untagged"; // D-SERDE7  #[Untagged]
//RS                                               // D-SERDE3 (= C) RenameAll casing keywords — closed typed menu, own-case args.
//RS pub const RENAME_ALL_CAMEL: &str = "camel"; // D-SERDE3
//RS pub const RENAME_ALL_SNAKE: &str = "snake"; // D-SERDE3
