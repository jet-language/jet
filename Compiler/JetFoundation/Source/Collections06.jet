//RS /// Canonical list of impure builtins (write stdout/stderr or read stdin).
//RS ///
//RS /// Used by Sema/Purity and Comptime/Purity to detect I/O calls inside
//RS /// `pure fn` or comptime contexts. Both consumers must agree on this set;
//RS /// having it here prevents silent divergence.
//RS pub const IMPURE_BUILTINS: &[&str] = &[
//RS     BUILTIN_PRINT,
//RS     "eprint",
//RS     "print",
//RS     BUILTIN_INPUT,
//RS     "read_all_input",
//RS ];
//RS 
//RS // ── Marker plane (current law: D-VERDICT-732-1, ratified 2026-07-23, card #732) ──
//RS //
//RS // `#` is the sole prefix for attributes, instructions, and properties: every
//RS // typed rule, built-in or user derive, wire marker, and compile-time
//RS // instruction lives on `#`. D-ONCE-AT1=D assigns prefix `@` to compile-time
//RS // names and fact reads; infix `@` remains the package-source separator.
//RS // A leading `@Rule` is E0063 with the canonical `#Rule` fix.
//RS //
//RS // D-VERDICT-732-1 supersedes the earlier two-plane sigil law: D-SHAPE2's
//RS // original `@`/`#` split and D-MARKER-FAMILY1/D-MARKERMOVE1/2/3 (which had
//RS // moved `Pure`, `MustUse`, `Codable`, `Debug`, and others onto `@`) are
//RS // historical spelling-reconciliation notes only — every one of those markers
//RS // is back on `#` today. Do not reintroduce `@Pure`-style markers from reading
//RS // old comments or docs; check Docs/spec/syntax-decisions.md for the live law
//RS // before trusting any comment that predates 2026-07-23.
//RS use super::{
//RS     BUILTIN_INPUT, BUILTIN_PRINT, CTX_BLOCK, KW_ALIAS, KW_AS, KW_BREAK, KW_CONC_TASK, KW_DEFER,
//RS     KW_DERIVE, KW_EFFECT_DECL, KW_ELSE, KW_ENUM, KW_EXTERN, KW_FN, KW_FREEZE, KW_IF, KW_IMPL,
//RS     KW_IMPURE, KW_IN, KW_IT, KW_JOB, KW_LOOP, KW_MARKER, KW_MODULE, KW_POLICY, KW_PRIV,
//RS     KW_PROTOCOL, KW_PUB, KW_RETURN, KW_SELF, KW_SHARED, KW_STATE, KW_STATE_DECL, KW_STRUCT, KW_TAG,
//RS     KW_TEST, KW_TODO, KW_TRAIT, KW_TRANSACT, KW_TRANSITION, KW_UNSAFE, KW_USE, KW_WRAP, LIT_FALSE,
//RS     LIT_NULL, LIT_TRUE, PROTO_CLIENT, PROTO_SERVER, TYPE_BITS, TYPE_BOOL, TYPE_BTREE_MAP,
//RS     TYPE_BYTES, TYPE_CHAR, TYPE_CONDITION, TYPE_F32, TYPE_F64, TYPE_FLOAT, TYPE_HASH_MAP, TYPE_I16,
//RS     TYPE_I32, TYPE_I64, TYPE_I8, TYPE_INT, TYPE_LRU, TYPE_MAP, TYPE_PRIORITY_QUEUE, TYPE_QUEUE,
//RS     TYPE_RANK, TYPE_RECEIVER, TYPE_SENDER, TYPE_SET, TYPE_SHARED, TYPE_SHARED_GUARD,
//RS     TYPE_SHARED_REVISION_ERROR, TYPE_SHARED_SNAPSHOT, TYPE_SHARED_WEAK, TYPE_STRING, TYPE_TALLY,
//RS     TYPE_TASK, TYPE_TASK_FAILURE, TYPE_U16, TYPE_U32,
//RS     TYPE_U64, TYPE_U8, TYPE_UNIT, TYPE_VIEW_ITER,
//RS };
// END-PORT-PENDING 0101 crates/jet-foundation/src/Syntax/package_files.rs:1-732

