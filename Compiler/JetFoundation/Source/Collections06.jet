//RS     TYPE_PRIORITY_QUEUE,
//RS     TYPE_LRU,
//RS     TYPE_TALLY,
//RS     TYPE_BITS,
//RS     TYPE_BYTES,
//RS     TYPE_VIEW_ITER,
//RS     TYPE_I8,
//RS     TYPE_I16,
//RS     TYPE_I32,
//RS     TYPE_I64,
//RS     TYPE_U8,
//RS     TYPE_U16,
//RS     TYPE_U32,
