//RS pub const RETIRED_BUILD_FIELD_ENV: &str = "env";
//RS /// D-BUILDSCOPE1=A: standing programmable-build authority grant.
//RS pub const BUILD_FIELD_ALLOW: &str = "allow";
//RS 
//RS /// D-JPK-ADAPTNAME1=A (ratified 2026-07-03): canonical adapter declaration
