//RS     TYPE_F32,
//RS     TYPE_F64,
//RS ];
//RS 
//RS /// D-BUILDPROFILE1 (ratified 2026-06-25): the `build { }` block in `pkg.jet`
//RS /// where named build profiles are defined. A profile is a `Build{ optimize: … }`
//RS /// value; blessed names `release`/`debug` carry built-in defaults; all others
//RS /// must be declared here. Active profile is chosen by `--release` (sugar for
//RS /// `--profile=release`) or `--profile=<name>` — never by ambient environment.
//RS pub const MANIFEST_BLOCK_BUILD: &str = "build"; // D-BUILDPROFILE1
