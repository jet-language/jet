// The watch policy `jet dev` and `jet run --watch` share: what a save does to
// the running program.
enum WatchPolicy { Auto Restart Swap Once }

// Only exact recognized flags affect the policy; a later recognized flag wins.
fn watch_policy_from(raw: [String], default: WatchPolicy) -> WatchPolicy Never! {
    policy := default
    loop argument in raw {
        if argument == {
            "--restart" -> policy = WatchPolicy.Restart
            "--swap" -> policy = WatchPolicy.Swap
            "--watch=off" -> policy = WatchPolicy.Once
            else -> {}
        }
    }
    policy
}
