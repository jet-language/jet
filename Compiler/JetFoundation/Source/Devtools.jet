        JetDevtoolsEventSinkRegistry(next_id: U64{1}, sinks: [])
    }
}
// Rust: crates/jet-foundation/src/Devtools.rs:983
pub struct JetDevtoolsEventSinkGuard { id: U64 }
// Rust: crates/jet-foundation/src/Devtools.rs:989
impl JetDevtoolsEventSinkGuard.Drop {
    fn drop(&self) -> Unit {
        if self.id == U64{0} { return }
        registry := JET_DEVTOOLS_EVENT_SINKS.lock().expect("devtools event sink registry poisoned")
        &registry.sinks.retain(fn(registration) { registration.id != self.id })
    }
}
// Rust: crates/jet-foundation/src/Devtools.rs:1000
JET_DEVTOOLS_EVENT_SINKS :: LazyLock.new(fn() {
    Mutex.new(JetDevtoolsEventSinkRegistry.default())
})
// Rust: crates/jet-foundation/src/Devtools.rs:1007
pub fn jet_devtools_install_event_sink(sink: ^JetDevtoolsEventSinkHandle) -> JetDevtoolsEventSinkGuard {
    registry := JET_DEVTOOLS_EVENT_SINKS.lock().expect("devtools event sink registry poisoned")
    id := registry.next_id
    registry.next_id = registry.next_id.saturating_add(U64{1}).max(U64{1})
    &registry.sinks.push(JetDevtoolsEventSinkRegistration(id: id, sink: ^sink))
    JetDevtoolsEventSinkGuard(id: id)
}
// Rust: crates/jet-foundation/src/Devtools.rs:1022
pub fn jet_devtools_publish_event(event: ^JetDevtoolsEvent) -> Unit {
    sinks := {
        registry := JET_DEVTOOLS_EVENT_SINKS.lock().expect("devtools event sink registry poisoned")
        snapshot := [JetDevtoolsEventSinkHandle]{}
        for registration in registry.sinks { &snapshot.push(~registration.sink) }
        ^snapshot
    }
    for sink in sinks { sink.publish(~event) }
}

