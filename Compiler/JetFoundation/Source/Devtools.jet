//RS         &self.source
//RS     }
//RS 
//RS     pub fn kind(&self) -> &str {
//RS         &self.kind
//RS     }
//RS 
//RS     pub fn entity(&self) -> &str {
//RS         &self.entity
//RS     }
//RS     pub fn body(&self) -> Option<&JetDevtoolsEventBody> {
//RS         self.body.as_ref()
//RS     }
