//RS         let kind = body.family().to_string();
//RS         let entity = body.entity().to_string();
//RS         let fields = render_body_fields(&body)?;
//RS         let mut event = Self::from_parts(timestamp_ms, source, kind, entity, fields)?;
//RS         event.body = Some(body);
//RS         Ok(event)
//RS     }
//RS 
//RS     /// Reconstruct a typed event from its flat wire projection.
//RS     ///
//RS     /// The supplied fields must be the canonical rendering of `body`; this
//RS     /// keeps wire compatibility while rejecting a body/identity mismatch.
//RS     pub fn from_wire(
//RS         sequence: u64,
//RS         timestamp_ms: u64,
//RS         source: impl Into<String>,
//RS         body: JetDevtoolsEventBody,
//RS         fields_json: impl Into<String>,
//RS         payload_json: Option<String>,
//RS     ) -> Result<Self, String> {
//RS         if sequence == 0 {
//RS             return Err("jet.devtools.v1 event sequence must be positive".to_string());
//RS         }
//RS         let fields = fields_json.into();
//RS         let mut event = Self::try_new(timestamp_ms, source, body)?;
//RS         validate_json_object(&fields, "fields")?;
//RS         event.fields = fields;
//RS         if let Some(payload) = payload_json.as_deref() {
//RS             validate_json_object(payload, "payload")?;
//RS         }
//RS         event.sequence = sequence;
//RS         event.payload = payload_json;
//RS         Ok(event)
//RS     }
//RS 
//RS 
//RS     /// Construct a host-marshalled event. `fields_json` must be one JSON
//RS     /// object; values are attached only through the typed `publish` gate.
//RS     pub fn from_parts(
//RS         timestamp_ms: u64,
//RS         source: impl Into<String>,
//RS         kind: impl Into<String>,
//RS         entity: impl Into<String>,
//RS         fields_json: impl Into<String>,
//RS     ) -> Result<Self, String> {
//RS         Self::from_parts_with_payload(
//RS             timestamp_ms,
//RS             source,
//RS             kind,
//RS             entity,
//RS             fields_json,
//RS             None,
//RS         )
//RS     }
//RS 
//RS     /// Game and package adapters use this boundary for their already-typed
//RS     /// payload object. The shared serializer validates the object framing and
//RS     /// keeps protocol/version outside the package payload.
//RS     pub fn from_parts_with_payload(
//RS         timestamp_ms: u64,
//RS         source: impl Into<String>,
//RS         kind: impl Into<String>,
//RS         entity: impl Into<String>,
//RS         fields_json: impl Into<String>,
//RS         payload_json: Option<String>,
//RS     ) -> Result<Self, String> {
//RS         let source = source.into();
//RS         let kind = kind.into();
//RS         let entity = entity.into();
//RS         let fields = fields_json.into();
//RS         validate_text(&source, "source")?;
//RS         validate_text(&kind, "kind")?;
//RS         validate_text(&entity, "entity")?;
//RS         validate_json_object(&fields, "fields")?;
//RS         if let Some(payload) = payload_json.as_deref() {
//RS             validate_json_object(payload, "payload")?;
//RS         }
//RS         Ok(Self {
//RS             sequence: 0,
