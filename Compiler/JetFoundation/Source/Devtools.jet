//RS /// One canonical event record. The wire shape is deliberately flat so every
//RS /// host can project the same `kind`/`entity`/`fields`/`payload` record while
//RS /// producers and in-process consumers retain the typed body.
//RS #[derive(Clone, Debug, PartialEq, Eq)]
//RS pub struct JetDevtoolsEvent {
//RS     sequence: u64,
//RS     pub timestamp_ms: u64,
//RS     pub source: String,
//RS     pub kind: String,
//RS     pub entity: String,
//RS     fields: String,
//RS     payload: Option<String>,
//RS     body: Option<JetDevtoolsEventBody>,
//RS }
//RS 
//RS impl JetDevtoolsEvent {
//RS     pub fn try_new(
//RS         timestamp_ms: u64,
//RS         source: impl Into<String>,
//RS         body: JetDevtoolsEventBody,
