//RS             source,
//RS             kind,
//RS             entity,
//RS             fields,
//RS             payload: payload_json,
//RS             body: None,
//RS         })
//RS     }
//RS 
//RS     /// Explicit publication is the only path that attaches values to an
//RS     /// event. Ordinary event constructors never capture locals or data.
//RS     pub fn publish(mut self, payload: JetDevtoolsPayload) -> Result<Self, String> {
//RS         let mut rendered = String::new();
//RS         render_payload(&payload, &mut rendered)?;
//RS         self.payload = Some(rendered);
//RS         Ok(self)
