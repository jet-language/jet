// Rust: crates/jet-foundation/src/Devtools.rs:221
pub type JetLiveValueUpdateSink = fn(JetLiveValueDecision) -> Unit
// Rust: crates/jet-foundation/src/Devtools.rs:223
struct JetLiveValueSinkRegistration { id: U64, sink: JetLiveValueUpdateSink }
// Rust: crates/jet-foundation/src/Devtools.rs:228
struct JetLiveValueSinkRegistry { next_id: U64, sinks: [JetLiveValueSinkRegistration] }
// Rust: crates/jet-foundation/src/Devtools.rs:234
impl JetLiveValueSinkRegistry {
    fn default() -> JetLiveValueSinkRegistry {
        JetLiveValueSinkRegistry(next_id: U64{1}, sinks: [])
    }
}
// Rust: crates/jet-foundation/src/Devtools.rs:242
pub struct JetLiveValueSinkGuard { id: U64 }
// Rust: crates/jet-foundation/src/Devtools.rs:247
impl JetLiveValueSinkGuard.Drop {
    fn drop(&self) -> Unit {
        if self.id == U64{0} { return }
        // Poisoned live-value registry is intentionally ignored, unlike the event registry.
        if JET_LIVE_VALUE_SINKS.lock() == .Ok(registry) {
            &registry.sinks.retain(fn(registration) { registration.id != self.id })
        }
    }
}
// Rust: crates/jet-foundation/src/Devtools.rs:257
JET_LIVE_VALUE_SINKS :: LazyLock.new(fn() {
    Mutex.new(JetLiveValueSinkRegistry.default())
})
// Rust: crates/jet-foundation/src/Devtools.rs:263
pub fn jet_devtools_install_live_value_sink(sink: JetLiveValueUpdateSink) -> JetLiveValueSinkGuard {
    registry := JET_LIVE_VALUE_SINKS.lock().expect("live value sink registry poisoned")
    id := registry.next_id
    registry.next_id = registry.next_id.saturating_add(U64{1}).max(U64{1})
    &registry.sinks.push(JetLiveValueSinkRegistration(id: id, sink: sink))
    JetLiveValueSinkGuard(id: id)
}
// Rust: crates/jet-foundation/src/Devtools.rs:277
// jet_live_value_text_valid -> Observation.jet:353 (byte length and Unicode control policy).
// Rust: crates/jet-foundation/src/Devtools.rs:282
// jet_live_value_identity_valid -> Observation.jet:354.
// Rust: crates/jet-foundation/src/Devtools.rs:286
// jet_live_value_sensitive -> Observation.jet:355-363 (ASCII-only lowercasing).
// Rust: crates/jet-foundation/src/Devtools.rs:294
pub fn jet_observe_live_value_update(key: String, type_identity: String, rendered: String?) -> Unit {
    decision := jet_devtools_live_value_decision(key, type_identity, rendered) ?? { return }
    sinks := {
        registry := JET_LIVE_VALUE_SINKS.lock() == {
            .Ok(value) -> value
            .Err(_) -> { return }
        }
        snapshot := [JetLiveValueUpdateSink]{}
        for registration in registry.sinks { &snapshot.push(registration.sink) }
        ^snapshot
    }
    // Lock is released before invoking callbacks: registrations may change reentrantly.
    for sink in sinks { sink(~decision) }
}

