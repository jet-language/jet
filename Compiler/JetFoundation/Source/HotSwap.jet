// Backend-neutral facts for one live source edit. Sema owns compatibility and
// retention decisions; adapters must never compare source/type shapes again.
use JetFoundation.Game.[JetGameChangeFact]
use JetFoundation.SchemaMigration.[SchemaMigrationPlan]
// Rust: crates/jet-foundation/src/HotSwap.rs:11
pub enum HotSwapCompatibility { Compatible Incompatible(reason: String) }
impl HotSwapCompatibility {
    // Rust: crates/jet-foundation/src/HotSwap.rs:20
    pub fn is_compatible(self) -> Bool Never! { self == .Compatible }
    // Rust: crates/jet-foundation/src/HotSwap.rs:25
    pub fn reason(self) -> String? Never! {
        if self == { .Compatible -> None .Incompatible(reason) -> Val(reason) }
    }
}
// Rust: crates/jet-foundation/src/HotSwap.rs:34
pub enum StateRetentionDecision { Preserve Fresh(reason: String) }
// Rust: crates/jet-foundation/src/HotSwap.rs:43
pub struct StateRetentionFact { pub key: String, pub decision: StateRetentionDecision }
impl StateRetentionFact {
    // Rust: crates/jet-foundation/src/HotSwap.rs:52
    pub fn preserve(key: String) -> StateRetentionFact Never! {
        StateRetentionFact{key: key, decision: .Preserve}
    }
    // Rust: crates/jet-foundation/src/HotSwap.rs:60
    pub fn fresh(key: String, reason: String) -> StateRetentionFact Never! {
        StateRetentionFact{key: key, decision: .Fresh(reason)}
    }
    // Rust: crates/jet-foundation/src/HotSwap.rs:70
    pub fn is_preserved(self) -> Bool Never! { self.decision == .Preserve }
}
// Rust: crates/jet-foundation/src/HotSwap.rs:83
pub struct HotSwapDecision {
    pub module: String
    pub compatibility: HotSwapCompatibility
    pub changed: [String]
    pub changed_functions: [String]
    pub state: [StateRetentionFact]
    pub schema_migrations: [SchemaMigrationPlan]
    pub rechecked_items: [String]
    pub change_facts: [JetGameChangeFact]
}
impl HotSwapDecision {
    // Rust: crates/jet-foundation/src/HotSwap.rs:102
    pub fn is_compatible(self) -> Bool Never! { self.compatibility.is_compatible() }
    // Rust: crates/jet-foundation/src/HotSwap.rs:107
    pub fn requires_restart(self) -> Bool Never! { !self.is_compatible() }
    // Rust: crates/jet-foundation/src/HotSwap.rs:112
    pub fn with_rechecked_items(self: ^HotSwapDecision, items: ^[String]) -> HotSwapDecision Never! {
        items.sort()
        items.dedup()
        self.rechecked_items = ^items
        ^self
    }
    // Rust: crates/jet-foundation/src/HotSwap.rs:120
    pub fn with_change_facts(self: ^HotSwapDecision, facts: ^[JetGameChangeFact]) -> HotSwapDecision Never! {
        facts.sort_by(fn(left, right) {
            order :: left.path.cmp(right.path)
            if order == .Equal { left.kind.cmp(right.kind) } else { order }
        })
        self.change_facts = ^facts
        ^self
    }
    // Rust: crates/jet-foundation/src/HotSwap.rs:131
    pub fn with_schema_migrations(self: ^HotSwapDecision, plans: ^[SchemaMigrationPlan]) -> HotSwapDecision Never! {
        plans.sort_by(fn(left, right) { left.type_name.cmp(right.type_name) })
        self.schema_migrations = ^plans
        ^self
    }
    // Rust: crates/jet-foundation/src/HotSwap.rs:138
    pub fn schema_migrations(self) -> View<SchemaMigrationPlan> Never! from self { self.schema_migrations.view() }
    // Rust: crates/jet-foundation/src/HotSwap.rs:143
    pub fn change_facts(self) -> View<JetGameChangeFact> Never! from self { self.change_facts.view() }
    // Rust: crates/jet-foundation/src/HotSwap.rs:148
    pub fn state_facts(self) -> View<StateRetentionFact> Never! from self { self.state.view() }
    // Rust: crates/jet-foundation/src/HotSwap.rs:153
    pub fn rechecked(self) -> View<String> Never! from self { self.rechecked_items.view() }
}
