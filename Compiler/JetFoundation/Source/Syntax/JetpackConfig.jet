//RS 
//RS /// D-CONF-GENSPELL1=A (ratified 2026-08-06): generic modules use `<…>` for
//RS /// type parameters, `(…)` for typed value parameters, and `::` for aliases.
//RS /// `module cache<K>(capacity: Int) { … }` and
//RS /// `module int_cache :: cache<Int>(64)` are the canonical forms.
//RS /// Reuses existing `<`/`>` angle-bracket tokens (no new sigil, I7 satisfied).
//RS pub const GENMOD_OPEN: &str = "<"; // reuses OP_LT
//RS pub const GENMOD_CLOSE: &str = ">"; // reuses OP_GT
//RS 
//RS /// U3 / D-SHAPE-MODULEINTERNAL1=A (ratified 2026-07-15): a leading underscore
//RS /// keeps `module _name { … }` out of automatic discovery and merge. Explicit
//RS /// imports remain allowed under ordinary access rules; this is not privacy.
//RS pub const MODULE_INTERNAL_PREFIX: &str = "_";
//RS 
//RS /// D-SHAPE-MODULEINTERNAL1=A: project-local explicit module opt-in.
//RS pub const PROJECT_IMPORT_ROOT: &str = "project";
//RS pub const PROJECT_IMPORT_PREFIX: &str = "project.";
//RS 
//RS /// S84 (ratified 2026-06-16): *dashed names* — the kebab-case naming rule for
//RS /// package / module / system / image / env **names** (and `from: system.<name>`
//RS /// references). The grammar is `ident (-ident)*`: a `-` joins two segments only
//RS /// when it is span-adjacent to both (no surrounding whitespace), matching
//RS /// nixpkgs/npm package-name convention (e.g. `image.halcyon-iso`,
//RS /// `system.my-host`). No new sigil — this reuses the existing `-`/Minus token;
//RS /// span adjacency is what keeps a spaced `a - b` as subtraction, so the rule
//RS /// never bleeds into the expression grammar. No leading, trailing, or doubled
//RS /// hyphen. Code identifiers (variables, fields, types, functions) stay plain
//RS /// `ident`. Enforced in `parser.rs::expect_dashed_name`.
//RS pub const NAME_SEGMENT_SEP: &str = "-";
