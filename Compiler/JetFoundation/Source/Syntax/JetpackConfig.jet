//RS 
//RS /// D-TGT1/D-TGT2 (ratified 2026-06-21): a package's build targets, replacing the
//RS /// removed `kind:` (U10). The five shipped targets — `library` is imported for its
//RS /// code, `executable` installs a binary on PATH, `test`/`example` build their own
//RS /// artifacts, and `sandbox` (c81, D-PLUGIN1/D-DEP-WASM1) builds an isolated WASM Component Model
//RS /// module. Written as a bare keyword (`deploy: executable`, D-TGT3) or inside a
//RS /// `{ targets: [ … ] }` list.
//RS pub const TARGET_LIBRARY: &str = "library";
//RS pub const TARGET_EXECUTABLE: &str = "executable";
//RS pub const TARGET_TEST: &str = "test";
//RS pub const TARGET_EXAMPLE: &str = "example";
//RS /// D-PLUGIN1=B / D-DEP-WASM1=A (ratified 2026-06-25; backend shipped c81): a
//RS /// package built as `sandbox` compiles to an isolated `wasm32` Component Model
//RS /// module (wasmtime host, typed `.wit` contract) instead of a native binary.
//RS /// Safe by default — no `#Unsafe` gate (I1 holds by construction: the sandbox
//RS /// is the safety boundary). Its exported surface is named by the `export:`
//RS /// target field (`TARGET_FIELD_EXPORT`, D-PLUGIN-EXPORT1).
//RS pub const TARGET_SANDBOX: &str = "sandbox";
//RS /// D-ONCE-SANDBOX1=A: the former package target spelling. `jet fmt` and
//RS /// `jet fix` rewrite it to `TARGET_SANDBOX` and print the retirement notice.
//RS pub const RETIRED_TARGET_PLUGIN: &str = "plugin";
//RS 
//RS /// D-TGT2 (ratified 2026-06-21): target keywords reserved for a future increment —
//RS /// recognized but rejected (no backend yet) until their tooling lands.
//RS /// `sandbox` shipped (c81). Empty until the next reserved target is proposed.
//RS pub const TARGET_RESERVED: &[&str] = &[];
//RS 
//RS /// D-TGT1 (ratified 2026-06-21): the per-package field listing build targets —
//RS /// `app: { targets: [library, executable { entry: "src/cli.jet" }] }`. A bare
//RS /// keyword value (`app: library`) is the single-target shorthand (D-TGT3). The
//RS /// former `kind:` field is removed; using it is a teaching error (E1211).
//RS pub const PACKAGE_FIELD_TARGETS: &str = "targets";
//RS 
//RS /// D-TGT1 (ratified 2026-06-21): the removed per-package kind field. Recognized
//RS /// only to emit a migration teaching error pointing at `targets:`.
//RS pub const PACKAGE_FIELD_KIND_REMOVED: &str = "kind";
//RS 
//RS /// D-TGT3/D-TGT4 (ratified 2026-06-21): fields a target block may carry —
//RS /// `entry:` (D-TGT4 entry module), `name:` (output/bin name). Parsed when
//RS /// present; behavior lands with the realize pipeline. `api:` (D-CAP4) is
//RS /// retired by D-MEM1/S2 — a target block carrying it hits the ordinary
//RS /// unknown-field error like any other typo'd key.
//RS pub const TARGET_FIELD_ENTRY: &str = "entry";
//RS pub const TARGET_FIELD_NAME: &str = "name";
//RS /// D-PLUGIN-EXPORT1=A (ratified 2026-06-25): names a `sandbox` target's exported
//RS /// surface (the `.wit` world name). Only meaningful on `sandbox { export: "…" }`;
//RS /// defaults to the package name when omitted.
//RS pub const TARGET_FIELD_EXPORT: &str = "export";
//RS 
//RS /// D-CAP1-words (historical, ratified 2026-06-21, tombstoned): the original
//RS /// four-capability word vocabulary — `view`/`edit`/`take`/`share`. `view` and
//RS /// `take` rode the S10 ownership keywords, since superseded by D-CAP7's
//RS /// capability sigils (memory model v5: bare/`&`/`^`). `edit` and `share`
//RS /// never left reserved-spelling status under that word law and are not wired
//RS /// into the parser; check Docs/spec/syntax-decisions.md's Authority
//RS /// section for current sigil-based capability law before reusing these.
//RS pub const CAPABILITY_EDIT: &str = "edit";
//RS pub const CAPABILITY_SHARE: &str = "share";
//RS 
//RS /// D-REL3 (ratified 2026-06-16): the project compatibility marker —
//RS /// `edition: "2026"` in the `payload: { … }` block of `pkg.jet`. An edition
//RS /// opts a project into a specific era of Jet syntax; a toolchain advertises the
//RS /// editions it supports and rejects a future edition it can't provide (E2001).
//RS /// Single-file `jet run file.jet` has no edition marker and always uses the
//RS /// newest stable edition (E2-V4). Not an `S`/`N`/`U` surface decision, so it is
//RS /// not enforced by tests/decisions.rs; it is a release-policy key recorded here
//RS /// per I7.
//RS pub const MANIFEST_FIELD_EDITION: &str = "edition";
