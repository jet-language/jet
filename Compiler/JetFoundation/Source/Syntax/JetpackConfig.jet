//RS     Some(match suffix {
//RS         "ns" | "B" => 1,
//RS         "us" => 1_000,
//RS         "ms" => 1_000_000,
//RS         "s" => 1_000_000_000,
//RS         "KiB" => 1_024,
//RS         "MiB" => 1_048_576,
//RS         "GiB" => 1_073_741_824,
//RS         _ => return None,
//RS     })
//RS }
