#Derive(Clone, Copy, Debug, Eq)
pub enum SimdLaneKind { F32; F64; I8; I16; I32; I64; U8; U16; U32; U64 }
// Rust: crates/jet-foundation/src/Syntax/math_layout.rs:48
pub SIMD_LANE_TYPE_NAMES :: prep { [String]{
    SIMD_F32X4_TYPE, SIMD_F64X2_TYPE, SIMD_F32X8_TYPE, SIMD_F64X4_TYPE,
    "I8x16", "I16x8", "I32x4", "I64x2", "U8x16", "U16x8", "U32x4", "U64x2",
