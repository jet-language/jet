//RS /// S22 (ratified): inclusive range between two `Int` ends — `1..10`.
//RS pub const OP_RANGE: &str = "..";
//RS 
//RS /// D-RANGE-EXCL1=C (ratified): exclusive / half-open range — `0..<n` runs
//RS /// `0` through `n - 1` and is empty when the start is not less than the end.
