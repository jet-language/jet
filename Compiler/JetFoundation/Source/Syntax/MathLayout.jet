//RS pub const OP_SLASH_PERCENT: &str = "/%";
//RS /// D-MODSEM1=A (ratified 2026-08-05): `%` is the floored modulo — its answer
//RS /// takes the divisor's sign, so `-7 % 2` is 1. It is the partner of `/%`.
//RS pub const OP_PERCENT: &str = "%";
//RS /// D-MODSEM1=A (ratified 2026-08-05): `%%` is the truncated remainder — its
//RS /// answer takes the dividend's sign, so `-7 %% 2` is -1. It partners `/`.
//RS pub const OP_PERCENT_PERCENT: &str = "%%";
//RS pub const OP_AMP: &str = "&";
