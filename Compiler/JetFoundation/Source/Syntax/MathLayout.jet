//RS 
//RS /// D-CTIO1 (ratified 2026-06-22): the sanctioned build-time I/O builtins.
//RS /// `embed_file("path") -> String` bakes a file's UTF-8 text into the binary;
//RS /// `embed_bytes("path") -> [U8]` bakes its raw bytes (binary-safe). The path
//RS /// must be a string literal, resolved relative to the source file, with no
//RS /// `..`-escape past the project root. Only valid in a `comptime` binding.
//RS /// D-CTFIND1/2: `find(glob) -> [String]` returns sorted relative file paths and
//RS /// records each matched file hash for `.jet/lock`.
//RS pub const BUILTIN_EMBED_FILE: &str = "embed_file";
//RS pub const BUILTIN_EMBED_BYTES: &str = "embed_bytes";
//RS /// D-CTEFFECT1 / D-PRELUDE-LAW1=A: gated build-time network fetch.
//RS pub const BUILTIN_FETCH: &str = "fetch";
//RS 
//RS /// S43 (ratified M6; PascalCase marker D-CASING1 follow-on 2026-06-21):
//RS /// top-level test-declaration block, written as the marker `#Test("name") { … }`.
//RS /// D-TESTPAREN1=A (ratified 2026-06-26): the name is now a parenthesized string
//RS /// argument, matching the `#FX(…)` marker family.
//RS /// D-TESTFAULT1=A (ratified 2026-08-12): the optional `faults: [Effect]`
//RS /// argument names effect-root call sites for the deterministic test harness.
//RS /// The bare lowercase `test` keyword (FOREIGN_TEST) is the retired spelling,
//RS /// recognized only to emit the E0052 teaching error pointing at `#Test("name")`.
//RS pub const KW_TEST: &str = "Test";
//RS pub const TEST_FAULTS_PARAM: &str = "faults";
//RS pub const TEST_EXPECTED_FAIL_PARAM: &str = "expected_fail";
//RS 
//RS /// D-DOTSCOPE1 (ratified 2026-07-02): scope-member vocabulary for `#Test`.
//RS /// Inside a `#Test { … }` body a statement-position `.name { … }` /
//RS /// `.name(args) { … }` (I8: the ONE spelling for scope vocabulary) resolves
//RS /// against this list. `.setup` runs first (init region), `.expect_fail` marks
//RS /// a region that must fail, `.timeout(dur)` bounds a region's elapsed time,
//RS /// `.skip` skips a region (or the whole test when it is the first statement),
//RS /// `.measure` selects measurement, and `.cases(rows)` supplies per-row claims.
//RS pub const SCOPE_TEST_SETUP: &str = "setup";
//RS pub const SCOPE_TEST_EXPECT_FAIL: &str = "expect_fail";
//RS pub const SCOPE_TEST_TIMEOUT: &str = "timeout";
//RS pub const SCOPE_TEST_SKIP: &str = "skip";
//RS /// D-CLAIM-BENCH1=A (ratified 2026-08-07, card #1641): measurement is a
//RS /// test member, selected by `jet test --measure`.
//RS pub const SCOPE_TEST_MEASURE: &str = "measure";
//RS /// D-CLAIM-CASES1=B (ratified 2026-08-07, card #1641): table-driven claims
//RS /// use the same member grammar; the optional explicit row name is handled by
//RS /// the member head and defaults to `AMBIENT_CASE`.
//RS pub const SCOPE_TEST_CASES: &str = "cases";
//RS 
//RS /// D-JOB-NAME1=A / D-JOB-SUBCMD1=C: `#Job fn` — a top-level function Jet can
//RS /// invoke as an argv subcommand, living beside `fn run()`. The word is `job`
//RS /// everywhere (marker, `jet jobs`, diagnostics). Bare marker defaults to `.Dev`.
//RS pub const KW_JOB: &str = "Job";
//RS 
//RS /// D-JOB-SUBCMD1=C: the closed scope menu accepted by `#Job(<scope>)`.
//RS pub const JOB_SCOPE_VARIANTS: &[&str] = &["Dev", "Ship", "Internal"];
//RS 
//RS /// D-JOB-NAMES1=A (amends D-JOB-SUBCMD1=C): the only names a `#Job fn` cannot
//RS /// take. `run`, `dev`, `build`, and `test` are Jet's lifecycle entries
//RS /// (D-JPK-TASKRUN1=A); a built program's own argument parser answers `help`
//RS /// and `version`. Jobs run under `jet jobs <name>` (D-JOB-ARGV1=A), so every
//RS /// other Jet command word is an ordinary job name. Sema rejects these as E0928.
//RS pub const JOB_RESERVED_NAMES: &[&str] = &["run", "dev", "build", "test", "help", "version"];
//RS 
//RS /// D-SCHEDULE1: `#Every(…)` — a declarative schedule marker on a `#Job fn`.
//RS /// Legal only alongside `#Job` (E0925 otherwise).
//RS pub const MARKER_EVERY: &str = "Every";
//RS 
//RS /// D-DOTSCOPE1: the scope-member vocabulary an applied-rule block declares, or
//RS /// `None` if the marker declares no members. Each marker that grows a member
//RS /// vocabulary is added here (an API decision, not a syntax one — the `.name { }`
//RS /// grammar is fixed). `#Test` is the only marker with members today; every
//RS /// other block marker declares none, so a member statement inside it is
//RS /// rejected against this empty vocabulary.
//RS pub fn scope_members(marker: &str) -> Option<&'static [&'static str]> {
//RS     match marker {
//RS         KW_TEST => Some(&[
//RS             SCOPE_TEST_SETUP,
//RS             SCOPE_TEST_EXPECT_FAIL,
//RS             SCOPE_TEST_TIMEOUT,
//RS             SCOPE_TEST_SKIP,
//RS             SCOPE_TEST_MEASURE,
//RS             SCOPE_TEST_CASES,
//RS         ]),
//RS         _ => None,
//RS     }
//RS }
