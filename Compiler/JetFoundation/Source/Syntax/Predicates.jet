// Rust: crates/jet-foundation/src/Syntax/predicates.rs:183
pub fn reflect_handle_rust_type(name: String) -> String? Never! { if name == { "Value" -> Val("JetReflectValue"), "Field" -> Val("JetReflectField"), else -> None } }
// Rust: crates/jet-foundation/src/Syntax/predicates.rs:195
pub fn binary_text_handle_rust_type(name: String) -> String? Never! {
