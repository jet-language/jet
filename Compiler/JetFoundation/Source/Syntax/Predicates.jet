// Rust: crates/jet-foundation/src/Syntax/predicates.rs:290
pub fn edit_distance(a: String, b: String) -> Int Never! {
    a_chars :: a.chars().collect()
    b_chars :: b.chars().collect()
    prev := [Int]{}
    loop j in 0..=b_chars.len() -> &prev.push(j)
    cur := [Int].with_capacity(b_chars.len() + 1)
    loop i in 1..=a_chars.len() {
        &cur.clear()
        &cur.push(i)
        loop j in 1..=b_chars.len() {
            cost :: if a_chars[i - 1] == b_chars[j - 1] -> 0 else -> 1
            &cur.push((prev[j] + 1).min(cur[j - 1] + 1).min(prev[j - 1] + cost))
        }
        &prev.swap(&cur)
    }
    prev[b_chars.len()]
}

// Rust: crates/jet-foundation/src/Syntax/predicates.rs:316
// GENERATED_NAME_PREFIX is canonically owned by Spellings.jet.
// Rust: crates/jet-foundation/src/Syntax/predicates.rs:318
pub fn generated_name(name: String) -> String Never! { if name.starts_with(GENERATED_NAME_PREFIX) -> name else -> "{GENERATED_NAME_PREFIX}{name}" }
// Rust: crates/jet-foundation/src/Syntax/predicates.rs:333
fn encode_generated_path(name: String) -> String Never! {
    hex :: "0123456789abcdef".bytes()
    encoded := [U8].with_capacity(name.len())
    loop byte in name.bytes() {
        if byte.is_ascii_alphanumeric() { &encoded.push(byte); continue }
        &encoded.push(95)
        if byte == {
            95 -> &encoded.push(117)
            46 -> &encoded.push(100)
            58 -> &encoded.push(99)
            47 -> &encoded.push(115)
            92 -> &encoded.push(98)
            45 -> &encoded.push(104)
            else -> {
                &encoded.push(120)
                &encoded.push(hex[Int.from_u8(byte >> 4)])
                &encoded.push(hex[Int.from_u8(byte & 15)])
            }
        }
    }
    String.from_utf8(encoded).unwrap()
}
// Rust: crates/jet-foundation/src/Syntax/predicates.rs:364
fn hex_value(byte: U8) -> U8? Never! {
    if byte >= 48 && byte <= 57 -> return Val(byte - 48)
    if byte >= 97 && byte <= 102 -> return Val(byte - 97 + 10)
    if byte >= 65 && byte <= 70 -> return Val(byte - 65 + 10)
    None
}
// Rust: crates/jet-foundation/src/Syntax/predicates.rs:363
pub fn decode_generated_path_suffix(suffix: String) -> String? Never! {
    bytes :: suffix.bytes()
    decoded := [U8].with_capacity(bytes.len())
    index := 0
    loop index < bytes.len() {
        if bytes[index].is_ascii_alphanumeric() { &decoded.push(bytes[index]); index += 1; continue }
        if bytes[index] != 95 || index + 1 >= bytes.len() -> return None
        if bytes[index + 1] == {
            117 -> &decoded.push(95)
            100 -> &decoded.push(46)
            99 -> &decoded.push(58)
            115 -> &decoded.push(47)
            98 -> &decoded.push(92)
            104 -> &decoded.push(45)
            120 -> {
                if index + 3 >= bytes.len() -> return None
                high :: hex_value(bytes[index + 2]) ?? return None
                low :: hex_value(bytes[index + 3]) ?? return None
                &decoded.push(high * 16 + low)
                index += 2
            }
            else -> return None
        }
        index += 2
    }
    if String.from_utf8(decoded) == { .Ok(text) -> Val(text), .Err(_) -> None }
}
// Rust: crates/jet-foundation/src/Syntax/predicates.rs:405
pub fn generated_path(name: String) -> String Never! { "{GENERATED_NAME_PREFIX}{encode_generated_path(name)}" }
// Rust: crates/jet-foundation/src/Syntax/predicates.rs:409
pub fn generated_suffix(name: String) -> String Never! {
    if name.starts_with(GENERATED_NAME_PREFIX) {
        suffix := name.after(GENERATED_NAME_PREFIX) // #4303
        return suffix
    }
    name
}
// Rust: crates/jet-foundation/src/Syntax/predicates.rs:414
pub fn sanitize_crate_name(raw: String) -> String Never! {
    bytes := [U8]{}
    loop ch in raw.chars() {
        if ch.is_ascii_alphanumeric() || ch == '_' -> &bytes.push(ch.as_u8()) else -> &bytes.push(95)
    }
    if bytes.is_empty() -> return "out"
    if bytes[0].is_ascii_digit() -> &bytes.insert(0, 95)
    String.from_utf8(bytes).unwrap()
}
// Rust: crates/jet-foundation/src/Syntax/predicates.rs:437
// IdentifierClass and classify_identifier are canonically owned by Spellings.jet.
// Rust: crates/jet-foundation/src/Syntax/predicates.rs:462
pub fn is_reserved_generated_name(name: String) -> Bool Never! {
    (JET_KEYWORD_NAMES.contains(name) && name != KW_STATE_DECL)
        || name == KW_MUTATE || name == KW_MOVE || name == KW_COPY || name == KW_CONST || name == FOREIGN_MATCH || name == LIT_NULL
        || JET_TYPE_NAMES.contains(name) || Collections.is_reserved_type(name) || CoreModuleExports.is_core_type_name(name)
        || name == TYPE_DATA || name == TYPE_JSON || name == TYPE_REGEX || name == TYPE_URL || name == TYPE_PATH || name == TYPE_DATETIME || name == CLOCK_TYPE || name == TYPE_INSTANT || name == TYPE_FRACTION || name == TYPE_RESULT || name == TYPE_ERR || name == TYPE_NEVER || name == RETIRED_TYPE_ERROR
}
// Rust: crates/jet-foundation/src/Syntax/predicates.rs:492
pub fn sanitize_generated_name(raw: String, case: NameCase, fallback: String) -> String Never! {
    trimmed := raw.trim_start_matches(['@', '$']) // #4303
    raw_body := if trimmed.starts_with("{") -> trimmed.after("{") else -> trimmed // #4303
    normalized := ""
    previous_lower_or_digit := false
    loop ch in raw_body.chars() {
        if ch == '_' {
            if !normalized.ends_with("_") -> &normalized.push('_')
            previous_lower_or_digit = false
        } else if ch.is_alphanumeric() {
            folding :: case == NameCase.Snake || case == NameCase.Screaming
            if folding && ch.is_uppercase() && previous_lower_or_digit && !normalized.ends_with("_") -> &normalized.push('_')
            if folding {
                loop lower in ch.to_lowercase().take(1) -> &normalized.push(lower)
            }
            if case == NameCase.Pascal -> &normalized.push(ch)
            previous_lower_or_digit = ch.is_lowercase() || ch.is_ascii_digit()
        } else if normalized.is_empty() -> previous_lower_or_digit = false
        else if !normalized.ends_with("_") { &normalized.push('_'); previous_lower_or_digit = false }
    }
    loop normalized.ends_with("_") -> _ :: &normalized.pop()
    if normalized.is_empty() -> normalized = fallback
    result := canonical_name_case(normalized, case)
    loop result.ends_with("_") -> _ :: &result.pop()
    if result.is_empty() -> result = canonical_name_case(fallback, case)
    body := if result.starts_with("_") -> result.after("_") else -> result // #4303
    if body.chars().next() == .Val(ch) {
        if !ch.is_alphabetic() -> result = body
    }
    if result.is_empty() -> result = canonical_name_case(fallback, case)
    start := if result.starts_with("_") -> result.after("_") else -> result // #4303
    if start.chars().next() == .Val(ch) {
        if !ch.is_alphabetic() {
            prefix :: if case == { .Pascal -> "Type", .Snake -> "field_", .Screaming -> "FIELD_" }
            result = "{prefix}{result}"
        }
    }
    suffix :: if case == { .Pascal -> "Type", .Snake -> "_field", .Screaming -> "_FIELD" }
    loop result == "_" || result.starts_with("__") || is_reserved_generated_name(result) -> &result.push_str(suffix)
    result
}
