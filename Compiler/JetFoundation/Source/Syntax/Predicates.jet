// Rust: crates/jet-foundation/src/Syntax/predicates.rs:107
pub fn canonical_ring_module(name: String) -> String Never! {
    if name == "raylib" -> "core.game.raylib" else -> "core.{name}"
}
// Rust: crates/jet-foundation/src/Syntax/predicates.rs:115
pub fn is_ring_module(name: String) -> Bool Never! {
    if name == { "log" -> true, "crypto" -> true, "http" -> true, "regex" -> true, "reactive" -> true, "archive" -> true, "raylib" -> true, "db" -> true, "time" -> true, "plugin" -> true, else -> false }
}
// Rust: crates/jet-foundation/src/Syntax/predicates.rs:129
pub TOOLCHAIN_OBJECT_ENV :: prep { "JET_TOOLCHAIN_FIXTURE" }
