// Rust: crates/jet-foundation/src/Syntax/predicates.rs:142
pub fn is_ring_module_staged(name: String) -> Bool Never! { staged_ring_artifact(name) != None }
// Rust: crates/jet-foundation/src/Syntax/predicates.rs:148
pub fn staged_ring_artifact(name: String) -> OSPath? Never! {
    if !is_ring_module(name) -> return None
    dir :: env.var_os(TOOLCHAIN_OBJECT_ENV) ?? return None // GATE #4494
    artifact :: path.Path.new(dir).join("ring").join(name) // GATE #4494
    if artifact.exists() -> Val(artifact) else -> None // GATE #4494
}
// Rust: crates/jet-foundation/src/Syntax/predicates.rs:157
pub fn is_legacy_std_import(name: String) -> Bool Never! { name == "std" || name.starts_with("std.") || name == "jet.std" || name.starts_with("jet.std.") }
// Rust: crates/jet-foundation/src/Syntax/predicates.rs:162
