// Rust: crates/jet-foundation/src/Syntax/predicates.rs:3
pub fn is_applied_rule(name: String) -> Bool Never! {
    if Policy.applied_rule(name) == .Val(row) -> return row.status == Policy.RuleStatus.Active
    false
}
