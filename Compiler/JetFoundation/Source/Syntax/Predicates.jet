    if name == { "Arena" -> Val("jet_mem::JetArena"), "Bump" -> Val("jet_mem::JetBump"), "Pool" -> Val("jet_mem::JetPool"), "Fixed" -> Val("jet_mem::JetFixed"), else -> None }
}
