// Rust Syntax/core_surface.rs and Syntax/package_files.rs: shared path spellings.
pub FILE_EXT :: prep { "jet" }
pub UNIFIED_LOCK_FILE :: prep { ".jet/lock" }


// Rust Syntax/predicates.rs and Syntax.rs::is_memo_storage_name.
pub GENERATED_NAME_PREFIX :: prep { "__jet_" }
pub fn is_memo_storage_name(name: String) -> Bool Never! {
    if !name.starts_with(GENERATED_NAME_PREFIX) -> return false
    suffix := name.slice(GENERATED_NAME_PREFIX.len(), name.len()) // #4303
    suffix.starts_with("__memo_")
}
// Rust Syntax/predicates.rs classify_identifier: only the underscore prefix
// affects source visibility. Bare `_` remains an ordinary binding spelling.
pub enum IdentifierClass {
    Ordinary
    SoftPublic
    Reserved
}

pub fn classify_identifier(name: String) -> IdentifierClass Never! {
    if name.starts_with("__") -> return IdentifierClass.Reserved
    // After the ASCII `_` prefix, a second scalar also means >1 UTF-8 bytes.
    if name.starts_with("_") && name.len() > 1 -> return IdentifierClass.SoftPublic
    IdentifierClass.Ordinary
}

// Rust Syntax/package_files.rs JET_KEYWORD_LIST/JET_TYPE_LIST: ordered current
// completion/rename catalogs, not lexer teaching words or internal type names.
JET_KEYWORD_NAMES :: prep { [String]{
    "fn", "pub", "priv", "use", "as", "extern", "module",
    "if", "else", "loop", "in", "break", "return", "defer",
    "struct", "enum", "alias", "impl", "policy", "wrap", "trait", "tag", "effect", "derive", "distinct",
    "migration", "rename", "add", "remove", "change", "via", "self",
    "Unsafe", "Impure", "Context", "task", "freeze", "shared", "Transact", "Job", "Test", "Todo",
    "State", "Transition", "state", "protocol", "client", "server", "marker", "validate", "check",
    "true", "false", "None", "it"
} }

JET_TYPE_NAMES :: prep { [String]{
    "Int", "Float", "Bool", "String", "()", "Char", "Err",
    "Shared", "SharedSnapshot", "SharedRevisionError", "SharedGuard", "Shared.Weak", "Condition",
    "Task", "Receiver", "Sender", "TaskFailure", "HashMap", "BTreeMap", "Map", "Queue", "Set", "Rank",
    "PriorityQueue", "Cache", "Tally", "Bits", "Bytes", "ViewIter",
    "I8", "I16", "I32", "I64", "U8", "U16", "U32", "U64", "F32", "F64"
} }

pub fn jet_keyword_names() -> [String] Never! { ~JET_KEYWORD_NAMES }
pub fn jet_type_names() -> [String] Never! { ~JET_TYPE_NAMES }

