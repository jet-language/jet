// Rust `REF_PROVIDERS` (retirements.rs:693-698): one provider registry home.
pub REF_PROVIDERS :: prep { REF_SOURCE_PROVIDERS }

// Rust `retirement` (retirements.rs:700-703).
pub fn syntax_retirement(id: String) -> SyntaxRetirement? Never! {
    loop row in SYNTAX_RETIREMENTS {
        if row.id == id -> return Val(row)
    }
    None
}

// Rust `retired_core_module` (retirements.rs:705-718).
pub fn syntax_retired_core_module(name: String) -> SyntaxRetirement? Never! {
    found := SyntaxRetirement?{None}
    best := -1
    loop row in SYNTAX_RETIREMENTS {
        if row.kind != SyntaxRetirementKind.Semantic || row.code != Val("E1001") -> next
        if row.retired != name && !name.starts_with("{row.retired}.") -> next
        if row.retired.len() >= best {
            best = row.retired.len()
            found = Val(row)
        }
    }
    found
}

// Rust `retired_core_module_diagnostic` (retirements.rs:720-735).
pub fn syntax_retired_core_module_diagnostic(name: String, span: Span) -> Diagnostic? Never! {
    row :: syntax_retired_core_module(name) ?? return None
    Val(diagnostic_from_registry("E1001", Val(span),
        "core module `{name}` was retired",
        "{row.decision} removed this free namespace; the canonical home is {row.canonical}",
        "use one of: {row.canonical}"))
}

// Rust `rename_target` (retirements.rs:737-745).
pub fn syntax_rename_target(retired: String) -> String? Never! {
    loop row in SYNTAX_RETIREMENTS {
        if row.kind == SyntaxRetirementKind.Rename && row.retired == retired -> return Val(row.canonical)
    }
    None
}

// Rust `law_violations` (retirements.rs:747-752).
pub fn syntax_retirement_law_violations() -> [String] Never! {
    syntax_retirement_law_violations_of(SYNTAX_RETIREMENTS)
}

// Rust `law_violations_of` (retirements.rs:754-811). Keep row and pair order.
// Rust str::len is a UTF-8 byte count, even though date validation deliberately
// checks only length and two hyphens rather than calendar validity.
pub fn syntax_retirement_law_violations_of(rows: [SyntaxRetirement]) -> [String] Never! {
    out := [String]{}
    loop (index, row) in rows {
        if row.retired.len() == 0 || row.canonical.len() == 0 -> &out.push("{row.id}: a row names an empty spelling")
        if row.retired == row.canonical -> &out.push("{row.id}: retires the form it names as canonical")
        if row.decision.len() == 0 -> &out.push("{row.id}: names no decision")
        hyphens := 0
        since_bytes :: row.since.bytes()
        loop byte in since_bytes {
            if byte == (U8{45}) -> hyphens += 1
        }
        if since_bytes.len() != 10 || hyphens != 2 -> &out.push("{row.id}: `{row.since}` is not a YYYY-MM-DD date")
        if row.kind == {
            .Rename -> {
                if row.code == Val(code) -> &out.push("{row.id}: a rename rewrites and refuses nothing, so it must name no code (`{code}`)")
            }
            .Semantic -> {
                if row.code == {
                    .None -> &out.push("{row.id}: a semantic change is refused, so it must name its code")
                    .Val(code) -> {
                        code_bytes :: code.bytes()
                        registered := code_bytes.len() == 5 && code.starts_with("E")
                        loop (position, byte) in code_bytes {
                            if position > 0 && (byte < U8{48} || byte > U8{57}) -> registered = false
                        }
                        if !registered -> &out.push("{row.id}: `{code}` is not a registered code")
                    }
                }
            }
        }
        loop other_index in index + 1..<rows.len() {
            other :: rows[other_index]
            if other.id == row.id -> &out.push("{row.id}: two rows claim this id")
            if other.retired == row.retired -> &out.push("{row.id}: `{row.retired}` is retired twice, so the two rows can disagree")
        }
    }
    out
}
