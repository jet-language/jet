// A retirement is code, not a memo (Rust Syntax/retirements.rs).
// This table owns the spelling, replacement, decision, date, and refusal code;
// Core namespace resolution and formatter renames are projections of its rows.

// Rust `RetirementKind` (retirements.rs:55-64).
pub enum SyntaxRetirementKind {
    Rename
    Semantic
}

// Rust `Retirement` (retirements.rs:66-83).
pub struct SyntaxRetirement {
    pub id: String
    pub retired: String
    pub canonical: String
    pub kind: SyntaxRetirementKind
    pub decision: String
    pub since: String
    pub code: String?
}

