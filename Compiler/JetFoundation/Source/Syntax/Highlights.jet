// Rust: crates/jet-foundation/src/Syntax/highlights.rs:916
pub fn highlighted_tokens_sorted() -> [HighlightToken] {
    tokens := JET_HIGHLIGHT_TOKENS.to_vec()
    loop row in APPLIED_RULES.iter().filter(fn(row) { row.status == .Active }) {
        &tokens.push(HighlightToken{text: row.name, class: .MarkerRule})
    }
    &tokens.sort_by(fn(a, b) { a.class.cmp(b.class).then(a.text.cmp(b.text)) }) // GATE #4499: declaration-order enum comparison.
    &tokens.dedup_by(fn(a, b) { a.text == b.text && a.class == b.class })
    tokens
}
// Rust: crates/jet-foundation/src/Syntax/highlights.rs:932
pub fn render_vscode_generated_highlights() -> String {
    out := ""
    &out.push_str("      \"comment\": \"{HIGHLIGHT_GENERATED_START}\",\n")
    &out.push_str("      \"patterns\": [\n")
    classes :: [HighlightClass.KeywordControl, .KeywordDeclaration, .KeywordOwnership, .KeywordOther, .Literal, .TypeBuiltin, .Builtin, .MarkerRule, .Sigil, .Operator]
    first := true
    loop class in classes {
        words :: class_words(class)
        symbols :: class_symbols(class)
        (global_words, contextual_words) :: split_vscode_keyword_words(class, words)
        if !global_words.is_empty() {
            pattern :: if class == {
                .MarkerRule -> "#\\[?({global_words.join("|")})\\b"
                .Builtin -> "(?<![.A-Za-z0-9_])({global_words.join("|")})(?=\\s*\\()"
                .KeywordControl | .KeywordDeclaration | .KeywordOther | .KeywordOwnership -> "(?<![.A-Za-z0-9_])({global_words.join("|")})(?![A-Za-z0-9_])"
                else -> "\\b({global_words.join("|")})\\b"
            }
            push_vscode_pattern(&out, &first, class.textmate_scope(), pattern)
        }
        if !contextual_words.is_empty() {
            // Identifier-like keywords color declaration shapes, not ordinary names.
            as_word := false
            rest := []
            loop word in contextual_words {
                if word == "as" { as_word = true } else { &rest.push(word) }
            }
            if as_word { push_vscode_pattern(&out, &first, class.textmate_scope(), "(?<![.A-Za-z0-9_])as(?=\\s+[A-Za-z_][A-Za-z0-9_]*)") }
            if !rest.is_empty() {
                push_vscode_pattern(&out, &first, class.textmate_scope(), "(?<![.A-Za-z0-9_])({rest.join("|")})(?=\\s*(?:\\{{|[A-Za-z_][A-Za-z0-9_]*\\s*:))")
            }
        }
        if !symbols.is_empty() { push_vscode_pattern(&out, &first, class.textmate_scope(), "({symbols.join("|")})") }
    }
    &out.push_str("\n      ],\n")
    &out.push_str("      \"endComment\": \"{HIGHLIGHT_GENERATED_END}\"\n")
    out
}
// Rust: crates/jet-foundation/src/Syntax/highlights.rs:1034
pub fn render_tree_sitter_generated_highlights() -> String {
    out := ""
    &out.push_str("// {HIGHLIGHT_GENERATED_START}\n")
    loop class in [HighlightClass.KeywordControl, .KeywordDeclaration, .KeywordOwnership, .KeywordOther, .Literal, .TypeBuiltin, .Builtin, .MarkerRule, .Sigil, .Operator] {
        values :: class_texts(class)
        quoted :: values.iter().map(fn(s) { "{s:?}" }).collect().join(", ") // GATE #4409: Rust-compatible debug text.
        &out.push_str("const {tree_sitter_const_name(class)} = [{quoted}];\n")
    }
    &out.push_str("// {HIGHLIGHT_GENERATED_END}\n")
    out
}
// Rust: crates/jet-foundation/src/Syntax/highlights.rs:1064
pub fn render_zed_generated_highlights() -> String {
    out := ""
    &out.push_str("; {HIGHLIGHT_GENERATED_START}\n")
    loop class in [HighlightClass.KeywordControl, .KeywordDeclaration, .KeywordOwnership, .KeywordOther, .Literal, .TypeBuiltin, .Builtin, .MarkerRule, .Sigil, .Operator] {
        values :: class_texts(class)
        &out.push_str("; {class.label()}: {values.join(" ")}\n")
        if class == .MarkerRule { continue }
        query_words :: values.iter().filter(fn(s) { is_word_token(s) && is_zed_anonymous_word_token(s) }).filter(fn(s) {
            if class == { .KeywordControl | .KeywordDeclaration | .KeywordOwnership | .KeywordOther -> vscode_global_keyword_word(s) else -> true }
        }).map(fn(s) { "  {s:?}" }).collect() // GATE #4409
        if !query_words.is_empty() {
            &out.push_str("[\n")
            &out.push_str(query_words.join("\n"))
            &out.push_str("\n] {class.zed_capture()}\n\n")
        }
    }
    &out.push_str("; {HIGHLIGHT_GENERATED_END}\n")
    out
}
// Rust: crates/jet-foundation/src/Syntax/highlights.rs:1106
fn push_vscode_pattern(out: &String, first: &Bool, scope: String, pattern: String) -> {
    if !first { &out.push_str(",\n") }
    first = false
    &out.push_str("        {{\n")
    &out.push_str("          \"name\": \"{scope}\",\n")
    &out.push_str("          \"match\": \"{json_escape(pattern)}\"\n")
    &out.push_str("        }}")
}
// Rust: crates/jet-foundation/src/Syntax/highlights.rs:1120
fn class_texts(class: HighlightClass) -> [String] {
    values := highlighted_tokens_sorted().into_iter().filter(fn(token) { token.class == class }).filter(fn(token) { !is_bracket_token(token.text) }).map(fn(token) { token.text }).collect()
    &values.sort()
    &values.dedup()
    values
}
// Rust: crates/jet-foundation/src/Syntax/highlights.rs:1132
fn class_words(class: HighlightClass) -> [String] {
    class_texts(class).into_iter().filter(is_word_token).map(regex_escape).collect()
}
// Rust: crates/jet-foundation/src/Syntax/highlights.rs:1140
fn class_symbols(class: HighlightClass) -> [String] {
    class_texts(class).into_iter().filter(fn(s) { !is_word_token(s) && !is_bracket_token(s) }).map(regex_escape).collect()
}
// Rust: crates/jet-foundation/src/Syntax/highlights.rs:1150
// Brackets belong to grammar nesting, not operator scopes.
fn is_bracket_token(s: String) -> Bool { if s == { "{{" | "}}" | "[" | "]" | "(" | ")" -> true else -> false } }
// Rust: crates/jet-foundation/src/Syntax/highlights.rs:1156
fn vscode_global_keyword_word(word: String) -> Bool {
    if word == {
        "fn" | "pub" | "priv" | "if" | "else" | "in" | "break" | "true" | "false" |
        "mutate" | "move" | "copy" | "struct" | "enum" | "impl" | "trait" | "tag" |
        "effect" | "derive" | "self" | "it" | "null" | "const" | "comptime" |
        "return" | "loop" | "yield" | "use" | "extern" | "module" -> true
        else -> false
    }
}
// Rust: crates/jet-foundation/src/Syntax/highlights.rs:1167
fn split_vscode_keyword_words(class: HighlightClass, words: [String]) -> ([String], [String]) {
    if class == {
        .KeywordControl | .KeywordDeclaration | .KeywordOther | .KeywordOwnership -> {
            global := []
            contextual := []
            loop word in words { if vscode_global_keyword_word(word) { &global.push(word) } else { &contextual.push(word) } }
            (global, contextual)
        }
        else -> (words, [])
    }
}
// Rust: crates/jet-foundation/src/Syntax/highlights.rs:1191
fn is_word_token(s: String) -> Bool {
    s.chars().all(fn(c) { c == '_' || c.is_ascii_alphanumeric() }) && s.chars().next().is_some_and(fn(c) { c == '_' || c.is_ascii_alphabetic() })
}
// Rust: crates/jet-foundation/src/Syntax/highlights.rs:1198
fn is_zed_anonymous_word_token(s: String) -> Bool {
    // Queries may only name anonymous tree-sitter tokens, not named-node words.
    if s == {
        "Bool" | "Char" | "Err" | "F32" | "F64" | "Float" | "I16" | "I32" | "I64" | "I8" |
        "Int" | "List" | "Map" | "String" | "Test" | "U16" | "U32" | "U64" | "U8" |
        "add" | "alias" | "as" | "break" | "change" | "comptime" | "continue" | "copy" |
        "defer" | "derive" | "distinct" | "else" | "enum" | "extern" | "false" | "fn" |
        "if" | "impl" | "in" | "loop" | "marker" | "migration" | "module" | "pub" |
        "remove" | "rename" | "return" | "rust" | "self" | "state" | "step" | "struct" |
        "tag" | "task" | "trait" | "true" | "use" | "via" -> true
        else -> false
    }
}
// Rust: crates/jet-foundation/src/Syntax/highlights.rs:1265
fn regex_escape(s: String) -> String {
    out := ""
    loop ch in s.chars() {
        if ch == { '\\' | '.' | '+' | '*' | '?' | '^' | '$' | '(' | ')' | '[' | ']' | '{' | '}' | '|' | '/' | '-' -> &out.push('\\') else -> {} }
        &out.push(ch)
    }
    out
}
// Rust: crates/jet-foundation/src/Syntax/highlights.rs:1293
fn tree_sitter_const_name(class: HighlightClass) -> String {
    if class == {
        .KeywordControl -> "JET_HIGHLIGHT_KEYWORD_CONTROL"
        .KeywordDeclaration -> "JET_HIGHLIGHT_KEYWORD_DECLARATION"
        .KeywordOwnership -> "JET_HIGHLIGHT_KEYWORD_OWNERSHIP"
        .KeywordOther -> "JET_HIGHLIGHT_KEYWORD_OTHER"
        .Literal -> "JET_HIGHLIGHT_LITERAL"
        .TypeBuiltin -> "JET_HIGHLIGHT_TYPE_BUILTIN"
        .Builtin -> "JET_HIGHLIGHT_BUILTIN"
        .MarkerRule -> "JET_HIGHLIGHT_MARKER_RULE"
        .Operator -> "JET_HIGHLIGHT_OPERATOR"
        .Sigil -> "JET_HIGHLIGHT_SIGIL"
    }
}
