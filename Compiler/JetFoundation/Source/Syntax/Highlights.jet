// Rust: crates/jet-foundation/src/Syntax/highlights.rs:3
// Editor grammars compare their owned sections against fresh renderer output.
pub const HIGHLIGHT_GENERATED_START: String = "BEGIN GENERATED JET SYNTAX HIGHLIGHTS"
// Rust: crates/jet-foundation/src/Syntax/highlights.rs:4
pub const HIGHLIGHT_GENERATED_END: String = "END GENERATED JET SYNTAX HIGHLIGHTS"
// Rust: crates/jet-foundation/src/Syntax/highlights.rs:7
pub enum HighlightClass {
    KeywordControl
    KeywordDeclaration
    KeywordOwnership
    KeywordOther
    Literal
    TypeBuiltin
    Builtin
    MarkerRule
    Operator
    Sigil
}
// Rust: crates/jet-foundation/src/Syntax/highlights.rs:21
pub struct HighlightToken { pub text: String, pub class: HighlightClass }
// Rust: crates/jet-foundation/src/Syntax/highlights.rs:27
impl HighlightClass {
    // Rust: crates/jet-foundation/src/Syntax/highlights.rs:28
    pub fn textmate_scope(self) -> String {
        if self == {
            .KeywordControl -> "keyword.control.jet"
            .KeywordDeclaration -> "keyword.declaration.jet"
            .KeywordOwnership -> "keyword.other.ownership.jet"
            .KeywordOther -> "keyword.other.jet"
            .Literal -> "constant.language.jet"
            .TypeBuiltin -> "storage.type.builtin.jet"
            .Builtin -> "support.function.builtin.jet"
            .MarkerRule -> "entity.name.tag.rule.jet"
            .Operator -> "keyword.operator.jet"
            .Sigil -> "keyword.operator.sigil.jet"
        }
    }
    // Rust: crates/jet-foundation/src/Syntax/highlights.rs:43
    pub fn zed_capture(self) -> String {
        if self == {
            .KeywordControl -> "@keyword.control"
            .KeywordDeclaration | .KeywordOwnership | .KeywordOther -> "@keyword"
            .Literal -> "@constant.builtin"
            .TypeBuiltin -> "@type.builtin"
            .Builtin -> "@function.builtin"
            .MarkerRule -> "@attribute"
            .Operator | .Sigil -> "@operator"
        }
    }
    // Rust: crates/jet-foundation/src/Syntax/highlights.rs:57
    fn label(self) -> String {
        if self == {
            .KeywordControl -> "keyword.control"
            .KeywordDeclaration -> "keyword.declaration"
            .KeywordOwnership -> "keyword.ownership"
            .KeywordOther -> "keyword.other"
            .Literal -> "literal"
            .TypeBuiltin -> "type.builtin"
            .Builtin -> "builtin"
            .MarkerRule -> "marker.rule"
            .Operator -> "operator"
            .Sigil -> "sigil"
        }
    }
}
