// Rust Syntax/core_calls.rs: shared UI capability vocabulary.
pub UI_CAPABILITY_NAMES :: prep { [String]{"UI.FileDialog", "UI.Clipboard", "UI.Ime", "UI.DragDrop", "UI.Shortcuts", "UI.Accessibility", "UI.FontShaping"} }

pub fn syntax_is_ui_capability(name: String) -> Bool Never! {
    UI_CAPABILITY_NAMES.contains(name)
}
