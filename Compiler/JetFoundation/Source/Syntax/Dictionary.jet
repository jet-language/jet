//RS 
//RS /// One meaning of a token at one kind of position. A sigil or operator can
//RS /// mean different things before a name, between two values, or inside a
//RS /// signature; each meaning carries its own example and what to expect after.
//RS #[derive(Clone, Debug, Eq, PartialEq)]
//RS pub struct SyntaxMeaning {
//RS     /// Where the token sits, in plain words ("Before a name"). Empty for
//RS     /// tokens whose meaning does not depend on position.
//RS     pub position: String,
//RS     pub text: String,
//RS     /// A short example, one statement per line.
//RS     pub example: String,
//RS     /// What the reader should expect after this use. May be empty.
//RS     pub afterwards: String,
//RS     pub related_codes: Vec<String>,
//RS }
//RS 
