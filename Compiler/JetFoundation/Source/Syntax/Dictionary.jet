// User-facing syntax dictionary; canonical Syntax constants own the token vocabulary.
use JetFoundation.Syntax as syntax
use JetFoundation.Registry as registry
use JetFoundation.Syntax.[highlighted_tokens_sorted, HighlightClass, HighlightToken, JET_KEYWORD_LIST]
// GATE #4494: process-global lazy initialization and compile-time source embedding.
use std.sync.LazyLock
use std.include_str

// Rust: crates/jet-foundation/src/Syntax/dictionary.rs:12
pub enum SyntaxDictionaryKind { Keyword Marker Operator Sigil Literal Type Builtin }
// Rust: crates/jet-foundation/src/Syntax/dictionary.rs:26
pub struct SyntaxMeaning {
    pub position: String
    pub text: String
    pub example: String
    pub afterwards: String
    pub related_codes: [String]
}
// Rust: crates/jet-foundation/src/Syntax/dictionary.rs:39
pub struct SyntaxDictionaryRow {
    pub token: String
    pub name: String
    pub decision: String
    pub meanings: [SyntaxMeaning]
    pub kind: SyntaxDictionaryKind
}
// Rust: crates/jet-foundation/src/Syntax/dictionary.rs:49
ROWS :: LazyLock<[SyntaxDictionaryRow]>.new(build_rows)
// Rust: crates/jet-foundation/src/Syntax/dictionary.rs:51
pub fn rows() -> [SyntaxDictionaryRow] { ROWS.get() }
// Rust: crates/jet-foundation/src/Syntax/dictionary.rs:55
pub fn lookup(query: String) -> SyntaxDictionaryRow? {
    query := query.trim() // #4303
    loop row in rows() {
        if row.token.eq_ignore_ascii_case(query) || display(row).eq_ignore_ascii_case(query) ||
            row.kind == .Marker && row.token.eq_ignore_ascii_case(query.strip_prefix("#") ?? query) -> return Val(row)
    }
    None
}
// Rust: crates/jet-foundation/src/Syntax/dictionary.rs:67
pub fn nearest(query: String) -> SyntaxDictionaryRow? {
    query := query.trim() // #4303
    lower :: query.to_ascii_lowercase()
    best := None as SyntaxDictionaryRow?
    distance := Int.MAX
    loop row in rows() {
        score :: levenshtein(lower, display(row).to_ascii_lowercase())
        if score < distance { best = Val(row); distance = score }
    }
    best
}
// Rust: crates/jet-foundation/src/Syntax/dictionary.rs:77
pub fn looks_like_query(query: String) -> Bool {
    query := query.trim() // #4303
    if query.starts_with("package-overlay:") || is_package_ref(query) -> return false
    if query.starts_with("@") || query.starts_with("#") || query.starts_with("::") || query.starts_with(":=") -> return true
    loop ch in query.chars() {
        if !ch.is_ascii_alphanumeric() && ch != '_' && ch != '.' && ch != '-' && ch != '/' && ch != '@' -> return true
    }
    false
}
// Rust: crates/jet-foundation/src/Syntax/dictionary.rs:94
fn is_package_ref(query: String) -> Bool {
    if query.contains("@") && !query.starts_with("@") -> return true
    if pair :: query.split_once(":") {
        (prefix, suffix) :: pair
        if prefix.is_empty() || suffix.is_empty() -> return false
        loop ch in prefix.chars() {
            if !ch.is_ascii_alphanumeric() && ch != '_' && ch != '-' && ch != '.' && ch != '/' -> return false
        }
        loop ch in suffix.chars() { if ch.is_ascii_alphanumeric() -> return true }
    }
    false
}
// Rust: crates/jet-foundation/src/Syntax/dictionary.rs:108
fn build_rows() -> [SyntaxDictionaryRow] {
    decisions :: source_decisions()
    acronym_decision :: source_header_decision(include_str("crates/jet-foundation/src/Syntax/acronyms.rs"))
    result := [SyntaxDictionaryRow]{}
    tokens := highlighted_tokens_sorted()
    present := [String:Bool]{}
    loop token in tokens { present[token.text] = true }
    loop text in [syntax.MARKER_REGION, syntax.MARKER_LIVE, syntax.MARKER_NONDETERMINISTIC] {
        if !present.contains_key(text) { &tokens.push(HighlightToken{text: text, class: .MarkerRule}); present[text] = true }
    }
    loop text in JET_KEYWORD_LIST {
        if !present.contains_key(text) { &tokens.push(HighlightToken{text: text, class: .KeywordOther}); present[text] = true }
    }
    loop row in registry.rows() {
        if row.kind() == registry.RowKind.Marker && !present.contains_key(row.name) {
            &tokens.push(HighlightToken{text: row.name, class: .MarkerRule}); present[row.name] = true
        }
    }
    seen := [String:Bool]{}
    loop token in tokens {
        if seen.contains_key(token.text) -> next
        seen[token.text] = true
        row_kind :: kind(token.class)
        (name, decision) :: metadata(decisions, token.text, row_kind, acronym_decision)
        &result.push(SyntaxDictionaryRow{token: token.text, name: name, decision: decision, meanings: meanings(token.text, row_kind), kind: row_kind})
    }
    result
}
// Rust: crates/jet-foundation/src/Syntax/dictionary.rs:164
fn metadata(decisions: [(String, (String, String))], token: String, row_kind: SyntaxDictionaryKind, acronym_decision: String?) -> (String, String) {
    fallback := None as (String, String)?
    loop (value, data) in decisions {
        if value != token || data.1 == "Syntax.rs" -> next
        if constant_matches_kind(data.0, row_kind) -> return data
        if fallback == None -> fallback = Val(data)
    }
    if candidate :: fallback -> return candidate
    if row :: registry.row(token) -> return (token, row.decision)
    if is_acronym(token) { if decision :: acronym_decision -> return (token, decision) }
    (token, "Syntax.rs")
}
// Rust: crates/jet-foundation/src/Syntax/dictionary.rs:194
fn constant_matches_kind(name: String, row_kind: SyntaxDictionaryKind) -> Bool {
    if row_kind == {
        .Keyword -> name.starts_with("KW_") || name.starts_with("LIT_") || name.starts_with("BUILTIN_")
        .Marker -> name.starts_with("MARKER_") || name.starts_with("RULE_")
        .Operator -> name.starts_with("OP_")
        .Sigil -> name.starts_with("SIGIL_") || name.ends_with("_PREFIX") || name.ends_with("_MARK") || name == "TYPE_FIXED_SIZE_SEP"
        .Literal -> name.starts_with("LIT_")
        .Type -> name.starts_with("TYPE_") || name.ends_with("_TYPE")
        .Builtin -> name.starts_with("BUILTIN_")
    }
}
// Rust: crates/jet-foundation/src/Syntax/dictionary.rs:213
fn source_header_decision(source: String) -> String? {
    count := 0
    loop line in source.lines() {
        if count == 24 -> break
        count += 1
        if id :: decision_id(line) -> return Val(id)
    }
    None
}
// Rust: crates/jet-foundation/src/Syntax/dictionary.rs:221
fn is_acronym(token: String) -> Bool {
    uppercase := 0
    lowercase := false
    loop ch in token.chars() {
        if ch.is_ascii_uppercase() -> uppercase += 1
        if ch.is_ascii_lowercase() -> lowercase = true
    }
    uppercase >= 2 && lowercase
}
// Rust: crates/jet-foundation/src/Syntax/dictionary.rs:226
fn kind(class: HighlightClass) -> SyntaxDictionaryKind {
    if class == {
        .KeywordControl | .KeywordDeclaration | .KeywordOwnership | .KeywordOther -> .Keyword
        .MarkerRule -> .Marker
        .Operator -> .Operator
        .Sigil -> .Sigil
        .Literal -> .Literal
        .TypeBuiltin -> .Type
        .Builtin -> .Builtin
    }
}
// Rust: crates/jet-foundation/src/Syntax/dictionary.rs:245
pub fn plain_text(row: SyntaxDictionaryRow) -> String {
    out := ""
    loop (index, meaning) in row.meanings.enumerate() {
        if index > 0 -> out += "\n"
        indent := ""
        if !meaning.position.is_empty() { out += meaning.position + ":\n"; indent = "  " }
        out += indent + meaning.text + "\n" + indent + "Example:\n"
        loop line in meaning.example.lines() { out += indent + "  " + line + "\n" }
        if !meaning.afterwards.is_empty() -> out += indent + "Afterwards: " + meaning.afterwards + "\n"
        if !meaning.related_codes.is_empty() -> out += indent + "Related: " + meaning.related_codes.join(", ") + "\n"
    }
    out
}
// Rust: crates/jet-foundation/src/Syntax/dictionary.rs:276
type Curated = (String, String, String, String, [String])
// Rust: crates/jet-foundation/src/Syntax/dictionary.rs:284
COMPOUND_AFTER :: "The name must be mutable (`:=`) or a place marked `&`; its new value is used from here on."
