pub BUILD_FIELD_OPTIMIZE :: prep { "optimize" }
pub BUILD_FIELD_DEBUG_INFO :: prep { "debug_info" }
pub BUILD_FIELD_SMALL :: prep { "small" }
pub BUILD_FIELD_PANIC :: prep { "panic" }
pub BUILD_FIELD_SETTINGS :: prep { "settings" }
pub BUILD_OPTIMIZE_NONE :: prep { "none" }
pub BUILD_OPTIMIZE_BASIC :: prep { "basic" }
pub BUILD_OPTIMIZE_FULL :: prep { "full" }
pub BUILD_PANIC_ABORT :: prep { "abort" }
pub BUILD_PANIC_UNWIND :: prep { "unwind" }
pub BUILD_PROFILE_RELEASE :: prep { "release" }
pub RETIRED_BUILD_FIELD_FEATURES :: prep { "features" }
pub RETIRED_BUILD_FIELD_ENV :: prep { "env" }
pub INLINE_PACKAGE_DECL :: prep { "package" }
pub PKG_ADAPT :: prep { "Pkg.adapt" }
pub ADAPTER_FIELD_NAME :: prep { "name" }
pub ADAPTER_FIELD_SOURCE :: prep { "source" }
pub ADAPTER_FIELD_DEPS :: prep { "deps" }
pub ADAPTER_FIELD_RECIPE :: prep { "recipe" }
pub RECIPE_COPY :: prep { "Recipe.copy" }
pub RECIPE_PREBUILT :: prep { "Recipe.prebuilt" }
pub RECIPE_FIELD_BIN :: prep { "bin" }
pub RECIPE_FIELD_AS :: prep { "as" }
pub RECIPE_FIELD_AS_NAME :: prep { "as_name" }
pub RECIPE_BUILD :: prep { "Recipe.build" }
pub RECIPE_FIELD_STEPS :: prep { "steps" }
pub RECIPE_STEP_FETCH :: prep { ".fetch" }
pub RECIPE_STEP_EXEC :: prep { ".exec" }
pub RECIPE_STEP_INSTALL :: prep { ".install" }
pub RECIPE_STEP_INSTALL_TREE :: prep { ".install_tree" }
pub RECIPE_STEP_FIELD_URL :: prep { "url" }
pub RECIPE_STEP_FIELD_SHA256 :: prep { "sha256" }
pub RECIPE_STEP_FIELD_TOOL :: prep { "tool" }
pub RECIPE_STEP_FIELD_ARGS :: prep { "args" }
pub RECIPE_STEP_FIELD_SRC :: prep { "src" }
pub RECIPE_STEP_FIELD_DEST :: prep { "dest" }

pub fn syntax_command_role_file(command: String) -> String? Never! {
    if command == {
        "run" -> Val(COMMAND_FILE_RUN)
        "build" -> Val(COMMAND_FILE_BUILD)
        "dev" -> Val(COMMAND_FILE_DEV)
        "test" -> Val(COMMAND_FILE_TEST)
        else -> None
    }
}
