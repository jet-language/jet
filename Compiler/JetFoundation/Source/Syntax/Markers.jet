//RS pub const MARKER_DEPRECATED: &str = "Deprecated";
//RS 
//RS /// D-FAILURE-FOUNDATION1=A: marks a named type as an allowed explicit error
//RS /// domain for a `!Error` callable contract.
//RS pub const MARKER_ERROR: &str = "Error";
