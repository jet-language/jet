//RS /// D-VERDICT-732-1: the sole prefix for applying a typed rule. A rule may target a
//RS /// declaration, expression, or brace scope when that rule declares the target
//RS /// legal. D-ONCE-AT1=D supersedes the former marker-plane reservation: prefix
//RS /// `@` marks compile-time names and facts, while infix `@` remains the
//RS /// package-source reference.
//RS ///
//RS /// `#` has two other jobs, told apart by parser position only (no lookahead
//RS /// heuristics): inside a bracketed type, `[T#N]`, it is the fixed-size-list
//RS /// separator (S76/D-FIXARR1, `TYPE_FIXED_SIZE_SEP` in `package_files.rs`);
//RS /// after a package name it is the version-pin separator (`pkg#1.2.0`, same
//RS /// constant). D-ONCE-HASH1=B keeps all three jobs on one token.
//RS pub const RULE_PREFIX: &str = "#"; // D-VERDICT-732-1
//RS 
//RS /// D-PREPOST1 / D-CONTRACTCASE1: precondition contract on a function
//RS /// signature — `#Pre(cond, "msg")`. The condition is a pure expression (same
//RS /// checker as `#Pure`). Checked in every build by default; per-module
//RS /// build-policy strip is the explicit opt-out.
//RS pub const MARKER_PRE: &str = "Pre"; // D-PREPOST1
//RS /// D-PREPOST1 / D-CONTRACTCASE1: postcondition contract — `#Post(cond,
//RS /// "msg")`; `result` names the return value inside `cond`.
//RS pub const MARKER_POST: &str = "Post"; // D-PREPOST1
//RS 
//RS /// D-MEMO1=A / D-FIELDMEMO1=A: stores a pure function result or a computed
//RS /// field result until its checked inputs change. Functions use the bounded
//RS /// default or `bound: none`; the field form is bare `#Memo` before
//RS /// `name: T -> expr`.
//RS pub const MARKER_MEMO: &str = "Memo"; // D-MEMO1=A, D-FIELDMEMO1=A
//RS 
//RS /// D-COMPUTE-KERNEL-SURFACE1=B: explicit safe kernel declaration —
//RS /// `#Kernel(.parallel) fn …`. The mode is intentionally a closed marker
//RS /// argument, so adding another execution mode needs a new owner ruling.
//RS pub const MARKER_KERNEL: &str = "Kernel"; // D-COMPUTE-KERNEL-SURFACE1
//RS 
//RS /// D-PERSIST1 / D-CONTRACTCASE1: dev-tier contract on a module-level
//RS /// binding — the value survives `jet dev` hot reloads (identity = module
//RS /// path + binding name). Inert in release builds.
//RS pub const MARKER_PERSIST: &str = "Persist"; // D-PERSIST1
//RS 
//RS /// D-METHODMACRO1=A / D-CONTRACTCASE1: `#Inline fn` / `#Inline` method — a
//RS /// soft hint that this function/method should be inlined (`#[inline]` in
//RS /// codegen). Never rejected by sema; the compiler is free to ignore it.
//RS /// Methods stay ordinary functions — no macro-rewrite hooks (D-METHODMACRO1).
//RS pub const MARKER_INLINE: &str = "Inline"; // D-METHODMACRO1
//RS /// D-SIMD3=B: native auto-vectorization is the default for native AOT builds;
//RS /// `#Scalar` is the explicit per-function/method opt-out.
//RS pub const MARKER_SCALAR: &str = "Scalar"; // D-SIMD3
//RS /// D-FOUND-OPMIX1=A: derives the reverse lookup for a typed Add/Mul impl.
//RS pub const MARKER_COMMUTATIVE: &str = "Commutative"; // D-FOUND-OPMIX1
//RS pub const MARKER_STATIC: &str = "Static"; // D-META-STAGE1
//RS /// D-CAPBUNDLE1 / D-CONTRACTCASE1: operation bundles on a nominal distinct
//RS /// type — each re-exposes a curated slice of the base type's operations
//RS /// while keeping nominal identity. Stackable. The `numeric` bundle merged
//RS /// into `MARKER_NUMERIC` (`#Numeric`, D-VERDICT-732-1, formerly
//RS /// D-MARKERMOVE1) — there is no `MARKER_BUNDLE_NUMERIC` constant.
//RS pub const MARKER_BUNDLE_COMPARABLE: &str = "Comparable"; // D-CAPBUNDLE1
//RS pub const MARKER_BUNDLE_PRINTABLE: &str = "Printable"; // D-CAPBUNDLE1
//RS pub const MARKER_BUNDLE_CODABLE_AS_BASE: &str = "CodableAsBase"; // D-CAPBUNDLE1
//RS 
//RS /// D-CLIFLAG1 / D-SHAPE-CLI1 / D-CLI-GLOBAL1=E (rides
//RS /// D-CONTRACTCASE1/D-VERDICT-732-1, formerly D-MARKERMOVE1):
//RS /// struct-level CLI derive marker — `#CLI`. A resolved `fn run(args: T)`
//RS /// parameter type owns parsing, defaults, help, completion, validation, and
//RS /// audit facts. In E, one marked program struct also owns root flags and
//RS /// callable-member commands. The marker is optional because plain `fn run()`
//RS /// remains a complete entry.
//RS pub const MARKER_CLI: &str = "CLI"; // D-CLIFLAG1, D-SHAPE-CLI1, D-CLI-GLOBAL1=E
