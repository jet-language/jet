// AST adapters for shared binary matching and the separate text matcher.
use JetFoundation.AST.[BinEndian, BinMatchPart, BinSpec, StrMatchPart, Type]
use JetFoundation.Numeric.[CtBigInt]
use JetFoundation.Prelude.MatchScan as bin_kernel
use JetCodegen.Prelude.Core.InlineRange as inline_range_semantics
// Rust: crates/jet-foundation/src/MatchScan.rs:16
// Shared kernel remains canonical; callers import it directly, not reexports.
// Rust: crates/jet-foundation/src/MatchScan.rs:27
pub enum BinBind { Int(value: Int) Rest(bytes: [U8]) }
// Rust: crates/jet-foundation/src/MatchScan.rs:35
pub fn str_match_scan(subject: String, parts: [StrMatchPart], consume_prefix: Bool) -> [(String,Type,String)]? Never! {
    i := 0
    binds := [(String,Type,String)]{}
    loop (pi, part) in parts {
        if part == {
            .Lit(lit) -> {
                tail := subject.slice(i..<subject.len()) // #4303: byte offsets, borrowed text.
                if !tail.starts_with(lit) -> return None
                i += lit.len()
            }
            .Hole(name, ty, _) -> {
                end := subject.len()
                if parts.get(pi + 1) == .Val(.Lit(next)) {
                    tail := subject.slice(i..<subject.len()) // #4303
                    end = i + (tail.find(next) ?? return None)
                }
                raw := subject.slice(i..<end) // #4303
                if !str_hole_admits(ty, raw) -> return None
                binds.push((name, ty ?? Type.String, raw.to_string()))
                i = end
            }
        }
    }
    if !consume_prefix && i != subject.len() -> return None
    Val(^binds)
}
// Rust: crates/jet-foundation/src/MatchScan.rs:78
fn str_hole_admits(ty: Type?, raw: String) -> Bool Never! {
    if ty == {
        .Val(.Int) -> CtBigInt.from_str(raw).is_ok()
        .Val(.IntN(_, _)) -> raw.parse<Int>().is_ok()
        .Val(.InlineRange(lo, hi, _)) -> {
            if raw.parse<Int>() == {
                .Ok(value) -> inline_range_semantics.jet_inline_range_from_int(value, lo, hi).is_ok()
                .Err(_) -> false
            }
        }
        .Val(.Float) | .Val(.Float32) -> raw.parse<F64>().is_ok()
        .Val(.Bool) -> raw == "true" || raw == "false" || raw == "True" || raw == "False" || raw == "0" || raw == "1"
        else -> true
    }
}
// Rust: crates/jet-foundation/src/MatchScan.rs:97
pub fn str_match_consumed(subject: String, parts: [StrMatchPart]) -> Int? Never! {
    i := 0
    loop (pi, part) in parts {
        if part == {
            .Lit(lit) -> {
                tail := subject.slice(i..<subject.len()) // #4303
                if !tail.starts_with(lit) -> return None
                i += lit.len()
            }
            .Hole(_, ty, _) -> {
                end := subject.len()
                if parts.get(pi + 1) == .Val(.Lit(next)) {
                    tail := subject.slice(i..<subject.len()) // #4303
                    end = i + (tail.find(next) ?? return None)
                }
                raw := subject.slice(i..<end) // #4303
                if !str_hole_admits(ty, raw) -> return None
                i = end
            }
        }
    }
    Val(i)
}
// Rust: crates/jet-foundation/src/MatchScan.rs:126
fn bin_bits_type(width: U8) -> Type Never! {
    bits :: if width <= 8 { 8 } else if width <= 16 { 16 } else if width <= 32 { 32 } else { 64 }
    Type.IntN(signed: false, bits: bits)
}
// Rust: crates/jet-foundation/src/MatchScan.rs:144
pub fn bin_match_scan(subject: View<U8>, parts: [BinMatchPart], consume_prefix: Bool) -> (Int,[(String,Type,BinBind)])? Never! {
    kernel_parts := [bin_kernel.JetBinMatchPart]{}
    loop part in parts {
        if part == {
            .Lit(bytes) -> kernel_parts.push(.Lit(bytes.view()))
            .Hole(_, spec, _) -> {
                if spec == {
                    .Bits(width, endian) -> kernel_parts.push(.Bits(width: width as Int, little: endian == BinEndian.Little))
                    .Rest -> kernel_parts.push(.Rest)
                }
            }
        }
    }
    (bit_pos, values) :: bin_kernel.jet_bin_match_scan(subject, kernel_parts.view(), consume_prefix) ?? return None
    values_iter := values.into_iter()
    binds := [(String,Type,BinBind)]{}
    loop part in parts {
        if part == .Hole(name, spec, _) {
            value :: values_iter.next() ?? return None
            (ty, bind) :: if (spec, value) == {
                (.Bits(width, _), .Int(value)) -> (bin_bits_type(width), BinBind.Int(value as Int))
                (.Rest, .Rest(bytes)) -> (Type.List(Type.IntN(signed: false, bits: 8)), BinBind.Rest(^bytes))
                else -> return None
            }
            binds.push((name, ty, ^bind))
        }
    }
    Val((bit_pos, ^binds))
}
