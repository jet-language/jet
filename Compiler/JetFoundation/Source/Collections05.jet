// Rust: crates/jet-foundation/src/Registry.rs:331
fn schema_field(name: String, value_type: MetadataValueType, cardinality: MetadataFieldCardinality, availability: MetadataAvailability) -> MetadataFieldSchema Never! {
    error_type := if cardinality == { .FallibleOne | .FallibleList -> Val(MetadataRecord.MetadataError) .One | .Optional | .List -> None }
    MetadataFieldSchema{name: name, value_type: value_type, cardinality: cardinality, error_type: error_type, availability: availability}
}
// Rust: crates/jet-foundation/src/Registry.rs:353
fn field(name: String, value_type: MetadataValueType) -> MetadataFieldSchema Never! { schema_field(name, value_type, MetadataFieldCardinality.One, MetadataAvailability.CheckedSnapshot) }
// Rust: crates/jet-foundation/src/Registry.rs:362
fn optional_field(name: String, value_type: MetadataValueType) -> MetadataFieldSchema Never! { schema_field(name, value_type, MetadataFieldCardinality.Optional, MetadataAvailability.CheckedSnapshot) }
// Rust: crates/jet-foundation/src/Registry.rs:374
fn list_field(name: String, value_type: MetadataValueType) -> MetadataFieldSchema Never! { schema_field(name, value_type, MetadataFieldCardinality.List, MetadataAvailability.CheckedSnapshot) }
// Rust: crates/jet-foundation/src/Registry.rs:386
fn fallible_field(name: String, value_type: MetadataValueType) -> MetadataFieldSchema Never! { schema_field(name, value_type, MetadataFieldCardinality.FallibleOne, MetadataAvailability.ProducerReported) }
// Rust: crates/jet-foundation/src/Registry.rs:398
fn fallible_list_field(name: String, value_type: MetadataValueType, stage: CompilerStage) -> MetadataFieldSchema Never! { schema_field(name, value_type, MetadataFieldCardinality.FallibleList, MetadataAvailability.AtStage{stage: stage}) }
// Rust: crates/jet-foundation/src/Registry.rs:411
fn target_fallible_field(name: String, value_type: MetadataValueType) -> MetadataFieldSchema Never! { schema_field(name, value_type, MetadataFieldCardinality.FallibleOne, MetadataAvailability.TargetDependent) }
// Rust: crates/jet-foundation/src/Registry.rs:423
fn retained_field(name: String, value_type: MetadataValueType, cardinality: MetadataFieldCardinality) -> MetadataFieldSchema Never! { schema_field(name, value_type, cardinality, MetadataAvailability.RuntimeRetained) }
