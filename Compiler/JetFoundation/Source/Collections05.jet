// Rust: crates/jet-foundation/src/Registry.rs:159
pub enum MetaprogrammingOperation { Generate Register RegisterExpansion RegisterSpecialization Session RetainMetadata RetainProgramMetadata }
// Rust: crates/jet-foundation/src/Registry.rs:170
pub enum MetaprogrammingOperationGate { Standard ApprovedRootRegistration RegisteredProvider }
// Rust: crates/jet-foundation/src/Registry.rs:180
pub enum MetaprogrammingOperationEffect { AdditivePublication ExplicitRegistration ProviderSession ReadOnlyRetention }
// Rust: crates/jet-foundation/src/Registry.rs:187
impl MetaprogrammingOperation {
    // Rust: crates/jet-foundation/src/Registry.rs:188
    pub fn spelling(self: MetaprogrammingOperation) -> String Never! {
        if self == {
            .Generate -> Syntax.COMPILER_GENERATE
            .Register -> Syntax.COMPILER_ADVANCED_REGISTER
            .RegisterExpansion -> Syntax.COMPILER_ADVANCED_REGISTER_EXPANSION
            .RegisterSpecialization -> Syntax.COMPILER_ADVANCED_REGISTER_SPECIALIZATION
            .Session -> Syntax.COMPILER_ADVANCED_SESSION
            .RetainMetadata -> "compiler.metadata.retain"
            .RetainProgramMetadata -> "compiler.metadata.retain_program"
        }
    }
}
