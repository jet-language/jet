// Text-level scans of Rust source: comments and literals are masked byte for
// byte.

// The byte at `at` as an Int, or -1 past either end.
rust_source_byte: fn(raw: [U8], at: Int) -> Int Never! {
    if at < 0 || at >= raw.len() -> return -1
    Int{raw[at]}
}

// Where the Rust lexer is while masking.
RustSourceMaskState: enum {
    Code,
    LineComment,
    BlockComment(Int),
    Str(Bool),
    RawStr(Int),
    Char(Bool),
}

// `source` with comments, strings and character literals replaced by spaces,
// byte for byte; newlines inside them are kept so lines stay aligned.
rust_code_mask: fn(source: String) -> String Never! {
    bytes: source.bytes()
    escaped_char_ends := [Int]{}
    out := [U8]{}
    state := RustSourceMaskState.Code
    index := 0
    loop index < bytes.len() {
        byte: bytes[index]
        code: Int{byte}
        blank: if code == 10 -> byte else -> U8{32}
        if state == {
            .Code -> {
                if code == 39 && rust_source_byte(bytes, index + 1) == 92 && escaped_char_ends.len() == 0 {
                    escaped_char_ends = rust_source_escaped_char_ends(bytes)
                }
                raw_start: rust_source_raw_string_start(bytes, index)
                if {
                    code == 47 && rust_source_byte(bytes, index + 1) == 47 -> {
                        rust_source_push_spaces(out, 2)
                        index += 2
                        state = RustSourceMaskState.LineComment
                    }
                    code == 47 && rust_source_byte(bytes, index + 1) == 42 -> {
                        rust_source_push_spaces(out, 2)
                        index += 2
                        state = RustSourceMaskState.BlockComment(1)
                    }
                    raw_start != None -> {
                        found: raw_start
                        rust_source_push_spaces(out, found.prefix_len)
                        index += found.prefix_len
                        state = RustSourceMaskState.RawStr(found.hashes)
                    }
                    code == 34 || (code == 98 && rust_source_byte(bytes, index + 1) == 34) -> {
                        width: if code == 98 -> 2 else -> 1
                        rust_source_push_spaces(out, width)
                        index += width
                        state = RustSourceMaskState.Str(false)
                    }
                    code == 39 && rust_source_char_literal_end(bytes, index, escaped_char_ends) != None -> {
                        out.push(U8{32})
                        index += 1
                        state = RustSourceMaskState.Char(false)
                    }
                    else -> {
                        out.push(byte)
                        index += 1
                    }
                }
            }
            .LineComment -> {
                out.push(blank)
                if code == 10 -> state = RustSourceMaskState.Code
                index += 1
            }
            .BlockComment(nesting) -> {
                if {
                    code == 47 && rust_source_byte(bytes, index + 1) == 42 -> {
                        rust_source_push_spaces(out, 2)
                        index += 2
                        state = RustSourceMaskState.BlockComment(nesting + 1)
                    }
                    code == 42 && rust_source_byte(bytes, index + 1) == 47 -> {
                        rust_source_push_spaces(out, 2)
                        index += 2
                        state = if nesting == 1 -> RustSourceMaskState.Code else -> RustSourceMaskState.BlockComment(nesting - 1)
                    }
                    else -> {
                        out.push(blank)
                        index += 1
                    }
                }
            }
            .Str(escaped) -> {
                out.push(blank)
                index += 1
                if {
                    escaped -> state = RustSourceMaskState.Str(false)
                    code == 92 -> state = RustSourceMaskState.Str(true)
                    code == 34 -> state = RustSourceMaskState.Code
                    else -> {}
                }
            }
            .RawStr(hashes) -> {
                closes: code == 34 && rust_source_all_hashes(bytes, index + 1, hashes)
                out.push(blank)
                index += 1
                if closes {
                    rust_source_push_spaces(out, hashes)
                    index += hashes
                    state = RustSourceMaskState.Code
                }
            }
            .Char(escaped) -> {
                out.push(U8{32})
                index += 1
                if {
                    escaped -> state = RustSourceMaskState.Char(false)
                    code == 92 -> state = RustSourceMaskState.Char(true)
                    code == 39 -> state = RustSourceMaskState.Code
                    else -> {}
                }
            }
        }
    }
    // Valid UTF-8: `source`'s own bytes, with every byte inside a string, char or comment (each opened and closed by ASCII) replaced by an ASCII space, so the lossy decode keeps every byte.
    String.from_bytes_lossy(out)
}

rust_source_push_spaces: fn(out: ^[U8], count: Int) Never! {
    loop _ in 0..<count -> out.push(U8{32})
}

// Whether `bytes[start..<start + count]` exists and is all `#`.
rust_source_all_hashes: fn(bytes: [U8], start: Int, count: Int) -> Bool Never! {
    if start + count > bytes.len() -> return false
    loop offset in 0..<count {
        if (Int{bytes[start + offset]}) != 35 -> return false
    }
    true
}

RustSourceRawStringStart: struct {
    prefix_len: Int,
    hashes: Int,
}

// A raw string opener at `at` (`r"`, `r#"`, `br##"`, ...): the opener's byte
// length and its hash count.
rust_source_raw_string_start: fn(bytes: [U8], at: Int) -> RustSourceRawStringStart? Never! {
    first: rust_source_byte(bytes, at)
    byte_string: first == 98 && rust_source_byte(bytes, at + 1) == 114
    if first != 114 && !byte_string -> return None
    start: if byte_string -> 2 else -> 1
    index := start
    loop rust_source_byte(bytes, at + index) == 35 -> index += 1
    if rust_source_byte(bytes, at + index) != 34 -> return None
    Val(RustSourceRawStringStart{prefix_len: index + 1, hashes: index - start})
}

// The offset (from `at`) of the closing quote of a character literal opening
// at `at`, or None when the quote is a lifetime or label.
rust_source_char_literal_end: fn(bytes: [U8], at: Int, escaped_ends: [Int]) -> Int? Never! {
    if rust_source_byte(bytes, at) != 39 -> return None
    second: rust_source_byte(bytes, at + 1)
    if second != 92 {
        width: if {
            second >= 0 && second <= 0x7F -> 1
            second >= 0xC0 && second <= 0xDF -> 2
            second >= 0xE0 && second <= 0xEF -> 3
            second >= 0xF0 && second <= 0xF7 -> 4
            else -> {
                return None
            }
        }
        end: 1 + width
        if at + end > bytes.len() -> return None
        // Decode only this scalar, never the remaining source per quote.
        _: String.from_bytes(bytes[at + 1..<at + end]) ?? return None
        if rust_source_byte(bytes, at + end) == 39 -> return Val(end)
        return None
    }
    end: escaped_ends[bytes.len() - at - 2]
    if end < 0 -> return None
    Val(end - at)
}

// Reverse DP: each suffix is read once even with many invalid escaped-char
// openers on one long line. Entries are reverse indexed.
rust_source_escaped_char_ends: fn(bytes: [U8]) -> [Int] Never! {
    ends := [Int]{}
    normal := -1
    escaped := -1
    index := bytes.len() - 1
    loop index >= 0 {
        byte: rust_source_byte(bytes, index)
        next_normal: if {
            byte == 39 -> index
            byte == 10 -> -1
            byte == 92 -> escaped
            else -> normal
        }
        escaped = normal
        normal = next_normal
        ends.push(normal)
        index -= 1
    }
    ends
}
