use Compiler.JetFoundation.Source.Devtools.Control.[JetDevtoolsCommandReceipt]

// Rust: crates/jet-foundation/src/DevtoolsControl.rs:658
fn command_receipt_queued(command: &JetDevtoolsCommand) -> JetDevtoolsCommandReceipt {
    JetDevtoolsCommandReceipt {
        sequence: NEXT_COMMAND_RECEIPT_SEQUENCE.fetch_add(U64{1}, Ordering.Relaxed),
        session_id: jet_devtools_command_session_id(command).to_string(),
        request_id: jet_devtools_command_request_id(command).to_string(),
        kind: jet_devtools_command_kind(command).to_string(),
        status: "queued", error: None
    }
}
// Rust: crates/jet-foundation/src/DevtoolsControl.rs:668
pub fn jet_devtools_command_receipt_for_command(command: &JetDevtoolsCommand, status: String, error: String?) -> JetDevtoolsCommandReceipt {
    JetDevtoolsCommandReceipt {
        sequence: NEXT_COMMAND_RECEIPT_SEQUENCE.fetch_add(U64{1}, Ordering.Relaxed),
        session_id: jet_devtools_command_session_id(command).to_string(),
        request_id: jet_devtools_command_request_id(command).to_string(),
        kind: jet_devtools_command_kind(command).to_string(),
        status: ^status, error: ^error
    }
}
// Rust: crates/jet-foundation/src/DevtoolsControl.rs:684
// Rust: crates/jet-foundation/src/DevtoolsControl.rs:695
use Compiler.JetFoundation.Source.Devtools.Control.[jet_devtools_command_receipt_validate, jet_devtools_command_receipt_render_json]

// Rust: crates/jet-foundation/src/DevtoolsControl.rs:712
// GATE #4494: process-wide atomics, lazy initialization and mutex ownership.
use std.sync.atomic.[AtomicU64, Ordering]
use std.sync.[LazyLock, Mutex]
use std.collections.[VecDeque]
static NEXT_COMMAND_RECEIPT_SEQUENCE: AtomicU64 = AtomicU64.new(U64{1})
// Rust: crates/jet-foundation/src/DevtoolsControl.rs:713
static JET_DEVTOOLS_COMMAND_RECEIPTS: LazyLock<Mutex<[String: VecDeque<JetDevtoolsCommandReceipt>]>> = LazyLock.new(|| Mutex.new([:]))

// Rust: crates/jet-foundation/src/DevtoolsControl.rs:717
fn command_receipt_cleanup(receipts: &[String: VecDeque<JetDevtoolsCommandReceipt>], session_id: String) -> Unit {
    if receipts.get(session_id).is_some_and(|queue| queue.is_empty()) {
        _ :: receipts.remove(session_id)
    }
}
// Rust: crates/jet-foundation/src/DevtoolsControl.rs:730
pub fn jet_devtools_update_command_receipt(session_id: String, request_id: String, status: String, error: String?) -> Unit Err! {
    jet_devtools_validate_command_text(session_id, "command receipt session_id")?
    jet_devtools_validate_command_text(request_id, "command receipt request_id")?
    jet_devtools_validate_command_text(status, "command receipt status")?
    if error is Some(text) { jet_devtools_validate_command_text(text, "command receipt error")? }
    mut receipts := JET_DEVTOOLS_COMMAND_RECEIPTS.lock()
        .map_err(|_| "jet.devtools.v1 command receipt queue is poisoned")?
    receipt := receipts.get_mut(session_id)
        .and_then(|queue| queue.iter_mut().rev().find(|receipt| receipt.request_id == request_id))
        .ok_or("jet.devtools.v1 command receipt was not retained")?
    receipt.status = ^status
    receipt.error = ^error
}
// Rust: crates/jet-foundation/src/DevtoolsControl.rs:758
pub fn jet_devtools_record_command_receipt(receipt: JetDevtoolsCommandReceipt) -> Unit Err! {
    jet_devtools_command_receipt_validate(receipt)?
    session_id := receipt.session_id.clone()
    mut receipts := JET_DEVTOOLS_COMMAND_RECEIPTS.lock()
        .map_err(|_| "jet.devtools.v1 command receipt queue is poisoned")?
    queue := receipts.entry(session_id).or_insert_with(|| VecDeque.new())
    if queue.len() >= JET_DEVTOOLS_MAX_COMMANDS {
        return Err("jet.devtools.v1 command receipt queue is full")
    }
    queue.push_back(^receipt)
}
// Rust: crates/jet-foundation/src/DevtoolsControl.rs:775
pub fn jet_devtools_poll_command_receipt(session_id: String) -> JetDevtoolsCommandReceipt? {
    mut receipts := JET_DEVTOOLS_COMMAND_RECEIPTS.lock().ok()?
    receipt := receipts.get_mut(session_id)?.pop_front()
    command_receipt_cleanup(&receipts, session_id)
    receipt
}
// Rust: crates/jet-foundation/src/DevtoolsControl.rs:784
pub fn jet_devtools_command_receipt_count(session_id: String) -> Int {
    JET_DEVTOOLS_COMMAND_RECEIPTS.lock().ok()
        .and_then(|receipts| receipts.get(session_id).map(|queue| queue.len())).unwrap_or(0)
}
// Rust: crates/jet-foundation/src/DevtoolsControl.rs:794
pub fn jet_devtools_command_receipts(session_id: String) -> [JetDevtoolsCommandReceipt] {
    JET_DEVTOOLS_COMMAND_RECEIPTS.lock().ok()
        .and_then(|receipts| receipts.get(session_id).map(|queue| queue.iter().cloned().collect()))
        .unwrap_or_default()
}
// Rust: crates/jet-foundation/src/DevtoolsControl.rs:808
pub fn jet_devtools_clear_command_receipts(session_id: String) -> Unit {
    if JET_DEVTOOLS_COMMAND_RECEIPTS.lock() is Ok(receipts) {
        _ :: receipts.remove(session_id)
    }
}
// Rust: crates/jet-foundation/src/DevtoolsControl.rs:815
// GATE #4494: one process FIFO per session shared by every command family.
static JET_DEVTOOLS_COMMAND_QUEUES: LazyLock<Mutex<[String: VecDeque<JetDevtoolsCommand>]>> = LazyLock.new(|| Mutex.new([:]))
// Rust: crates/jet-foundation/src/DevtoolsControl.rs:819
fn command_queue_cleanup(queues: &[String: VecDeque<JetDevtoolsCommand>], session_id: String) -> Unit {
    if queues.get(session_id).is_some_and(|queue| queue.is_empty()) {
        _ :: queues.remove(session_id)
    }
}
// Rust: crates/jet-foundation/src/DevtoolsControl.rs:832
pub fn jet_devtools_enqueue_command(command: JetDevtoolsCommand) -> Unit Err! {
    jet_devtools_command_validate(command)?
    session_id := jet_devtools_command_session_id(command).to_string()
    receipt := command_receipt_queued(command)
    // Keep receipt admission and command admission atomic; lock order matches Rust.
    mut receipts := JET_DEVTOOLS_COMMAND_RECEIPTS.lock()
        .map_err(|_| "jet.devtools.v1 command receipt queue is poisoned")?
    if receipts.get(session_id).is_some_and(|queue| queue.len() >= JET_DEVTOOLS_MAX_COMMANDS) {
        return Err("jet.devtools.v1 command receipt queue is full")
    }
    mut queues := JET_DEVTOOLS_COMMAND_QUEUES.lock()
        .map_err(|_| "jet.devtools.v1 command queue is poisoned")?
    queue := queues.entry(session_id.clone()).or_insert_with(|| VecDeque.new())
    if queue.len() >= JET_DEVTOOLS_MAX_COMMANDS { return Err("jet.devtools.v1 command queue is full") }
    queue.push_back(^command)
    receipts.entry(session_id).or_insert_with(|| VecDeque.new()).push_back(^receipt)
}
// Rust: crates/jet-foundation/src/DevtoolsControl.rs:861
pub fn jet_devtools_requeue_command_front(command: JetDevtoolsCommand) -> Unit Err! {
    jet_devtools_command_validate(command)?
    session_id := jet_devtools_command_session_id(command).to_string()
    mut queues := JET_DEVTOOLS_COMMAND_QUEUES.lock()
        .map_err(|_| "jet.devtools.v1 command queue is poisoned")?
    queue := queues.entry(session_id).or_insert_with(|| VecDeque.new())
    if queue.len() >= JET_DEVTOOLS_MAX_COMMANDS { return Err("jet.devtools.v1 command queue is full") }
    queue.push_front(^command)
}
// Rust: crates/jet-foundation/src/DevtoolsControl.rs:876
pub fn jet_devtools_poll_command(session_id: String) -> JetDevtoolsCommand? {
    mut queues := JET_DEVTOOLS_COMMAND_QUEUES.lock().ok()?
    command := queues.get_mut(session_id)?.pop_front()
    command_queue_cleanup(&queues, session_id)
    command
}
// Rust: crates/jet-foundation/src/DevtoolsControl.rs:884
pub fn jet_devtools_command_count(session_id: String) -> Int {
    JET_DEVTOOLS_COMMAND_QUEUES.lock().ok()
        .and_then(|queues| queues.get(session_id).map(|queue| queue.len())).unwrap_or(0)
}
// Rust: crates/jet-foundation/src/DevtoolsControl.rs:894
pub fn jet_devtools_poll_database_explain(session_id: String) -> JetDevtoolsDatabaseExplainRequest? {
    mut queues := JET_DEVTOOLS_COMMAND_QUEUES.lock().ok()?
    queue := queues.get_mut(session_id)?
    index := queue.iter().position(|command| command is JetDevtoolsCommand.DatabaseExplain(_))?
    command := queue.remove(index)?
    command_queue_cleanup(&queues, session_id)
    match command {
        JetDevtoolsCommand.DatabaseExplain(request) -> Some(^request)
        JetDevtoolsCommand.GameControl(_), JetDevtoolsCommand.ProjectRebuild(_) -> None
    }
}
// Rust: crates/jet-foundation/src/DevtoolsControl.rs:912
pub fn jet_devtools_poll_game_control(session_id: String) -> JetDevtoolsGameControlRequest? {
    mut queues := JET_DEVTOOLS_COMMAND_QUEUES.lock().ok()?
    queue := queues.get_mut(session_id)?
    index := queue.iter().position(|command| command is JetDevtoolsCommand.GameControl(_))?
    command := queue.remove(index)?
    command_queue_cleanup(&queues, session_id)
    match command {
        JetDevtoolsCommand.GameControl(request) -> Some(^request)
        JetDevtoolsCommand.DatabaseExplain(_), JetDevtoolsCommand.ProjectRebuild(_) -> None
    }
}
// Rust: crates/jet-foundation/src/DevtoolsControl.rs:929
pub fn jet_devtools_clear_commands(session_id: String) -> Unit {
    if JET_DEVTOOLS_COMMAND_QUEUES.lock() is Ok(queues) { _ :: queues.remove(session_id) }
    jet_devtools_clear_command_receipts(session_id)
}
// Rust: crates/jet-foundation/src/DevtoolsControl.rs:938
pub fn jet_devtools_enqueue_game_control(request: JetDevtoolsGameControlRequest) -> Unit Err! {
    jet_devtools_enqueue_command(JetDevtoolsCommand.GameControl(^request))
}
