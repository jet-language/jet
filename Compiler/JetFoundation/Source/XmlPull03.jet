// Rust: crates/jet-foundation/src/XmlPull.rs:5410
fn name_start(c: Char) -> Bool Never! {
    n :: c as U32
    c == ':' || (c >= 'A' && c <= 'Z') || c == '_' || (c >= 'a' && c <= 'z') ||
    (n >= 0xC0 && n <= 0xD6) || (n >= 0xD8 && n <= 0xF6) || (n >= 0xF8 && n <= 0x2FF) ||
    (n >= 0x370 && n <= 0x37D) || (n >= 0x37F && n <= 0x1FFF) || (n >= 0x200C && n <= 0x200D) ||
    (n >= 0x2070 && n <= 0x218F) || (n >= 0x2C00 && n <= 0x2FEF) || (n >= 0x3001 && n <= 0xD7FF) ||
    (n >= 0xF900 && n <= 0xFDCF) || (n >= 0xFDF0 && n <= 0xFFFD) || (n >= 0x10000 && n <= 0xEFFFF)
}
// Rust: crates/jet-foundation/src/XmlPull.rs:5414
fn name_char(c: Char) -> Bool Never! {
    n :: c as U32
    name_start(c) || c == '-' || c == '.' || (c >= '0' && c <= '9') || n == 0xB7 || (n >= 0x0300 && n <= 0x036F) || (n >= 0x203F && n <= 0x2040)
}
// Rust: crates/jet-foundation/src/XmlPull.rs:5419
fn valid_name(s: String) -> Bool Never! {
    cs := s.chars()
    cs.next().is_some_and(name_start) && cs.all(name_char) && s.matches(':').count() <= 1
}
// Rust: crates/jet-foundation/src/XmlPull.rs:5423
fn valid_xml_char(character: Char) -> Bool Never! {
    n :: character as U32
    n == 0x9 || n == 0xA || n == 0xD || (n >= 0x20 && n <= 0xD7FF) || (n >= 0xE000 && n <= 0xFFFD) || (n >= 0x10000 && n <= 0x10FFFF)
}
