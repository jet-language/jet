// The compiler's thread runtime.
//
// A phase that splits into independent jobs asks `compiler_threads_admit`
// how many threads it may use and cuts its jobs into that many consecutive
// parts at the bounds `compiler_threads_partition` returns. It moves each
// part out of its job list by popping from the end, so a part holds its jobs
// last-first and its thread pops them first-first; runs one `task` per part
// inside a `task.group`; and joins the tasks in part order. Parts are
// consecutive and joined in order, so every result, diagnostic, and emitted
// byte is the same for any thread count. When one thread is admitted the
// phase runs the same jobs inline, in the same order, on the calling thread.
//
// Jobs move into their task and results move back, so no job is copied. A
// thread receives only the small read-only rows its jobs need; the program's
// shared tables stay with the caller.

// How many threads the compiler may use. The host fills it: `cap` is the
// user's `--threads N` (N >= 1), or the host's default when the flag is
// absent (the CLI's is one thread per CPU of its affinity mask); `None` lets admission
// start at `cores`. `cores` is the number of CPUs the process may use;
// `memory_available` is the memory free for new work, in bytes, when the
// host can read it. The cap limits the compiler only, never the threads of a
// program it builds or runs.
CompilerThreads: struct {
    cap: Int?,
    cores: Int,
    memory_available: Int?,
}

// One thread: every phase runs its jobs inline, in order.
compiler_threads_single: fn() -> CompilerThreads Never! {
    CompilerThreads{cap: Val(1), cores: 1, memory_available: None}
}

// The threads one parallel step may use for `items` independent jobs that
// together hold `work` units (bytes, instructions, ...). Admission starts at
// the cap, or at the reported cores when there is no cap, and never exceeds
// the cores. It admits a thread only for useful work, at least
// `min_work_per_thread` units each, so small programs stay on one thread, and
// only while the memory the step needs to run in parallel fits in the memory
// the host reported free: `parallel_scratch` bytes once (the step's jobs
// copied out for their threads, say) plus `scratch_per_thread` bytes for each
// thread.
compiler_threads_admit: fn(threads: CompilerThreads, items: Int, work: Int, min_work_per_thread: Int, scratch_per_thread: Int, parallel_scratch: Int) -> Int Never! {
    limit := compiler_threads_limit(threads)
    if limit > items -> limit = items
    loop limit > 1 && limit * min_work_per_thread > work -> limit -= 1
    if threads.memory_available == .Val(free) {
        loop limit > 1 && parallel_scratch + limit * scratch_per_thread > free -> limit -= 1
    }
    if limit < 1 -> return 1
    limit
}

// The most threads `threads` admits for any step: its cap, or its cores when
// it has none, never more than the cores and at least one; while other
// compiles run in this process (compiler_threads_join), this compile's share
// of that (compiler_threads_share).
compiler_threads_limit: fn(threads: CompilerThreads) -> Int Never! {
    cores: if threads.cores < 1 -> 1 else -> threads.cores
    limit := threads.cap ?? cores
    if limit > cores -> limit = cores
    if limit < 1 -> limit = 1
    permit: COMPILER_THREADS_COMPILES.guard_read()
    compiler_threads_share(limit, permit.value)
}

// The compiles of this process that run at once on its threads, each
// counted from its compiler_threads_join to its compiler_threads_leave. A
// process compiles one program at a time unless it says otherwise: a
// `jet build` compiling two targets at once (BuildExecute.jet), the toolchain's
// runtime library beside its Core library (Request.jet
// jet_cli_runtime_with_core). Each such compile admits its share of the
// limit at every step, so together they never take more than the limit,
// and one left alone takes the whole of it from its next step on.
COMPILER_THREADS_COMPILES: Shared{0}

// One more compile runs at once with the others of this process.
compiler_threads_join: fn() Never! {
    held := COMPILER_THREADS_COMPILES.guard_edit()
    held.value += 1
}

// A compile that joined (compiler_threads_join) ends, or waits on work
// outside the compiler holding none of its threads.
compiler_threads_leave: fn() Never! {
    held := COMPILER_THREADS_COMPILES.guard_edit()
    if held.value > 0 -> held.value -= 1
}

// One of `compiles` compiles' share of `limit` threads: an equal part,
// rounded down, at least one; the whole limit for a compile alone.
compiler_threads_share: fn(limit: Int, compiles: Int) -> Int Never! {
    if compiles < 2 -> return limit
    share: limit /% compiles
    if share < 1 -> return 1
    share
}

// `threads` capped at `count` threads (at least one).
compiler_threads_capped: fn(threads: CompilerThreads, count: Int) -> CompilerThreads Never! {
    limit := compiler_threads_limit(threads)
    if count < limit -> limit = count
    if limit < 1 -> limit = 1
    CompilerThreads{cap: Val(limit), cores: threads.cores, memory_available: threads.memory_available}
}

// The threads a step may use beside another step that holds `held` of
// `threads`: what is left of the limit, at least one. Two steps that run
// together and each admit the whole limit leave tasks waiting for a carrier,
// and the runtime then asks busy threads to take turns at their loops' polls
// (JetRuntime Scheduler.jet scheduler_checks_arm_turns), which costs CPU and
// gains no wall time.
compiler_threads_beside: fn(threads: CompilerThreads, held: Int) -> CompilerThreads Never! {
    compiler_threads_capped(threads, compiler_threads_limit(threads) - held)
}

#Test("a step beside another takes what the other leaves of the limit, at least one thread") {
    threads: CompilerThreads{cap: Val(16), cores: 32, memory_available: None}
    assert_eq(compiler_threads_limit(threads), 16)
    assert_eq(compiler_threads_limit(compiler_threads_beside(threads, 4)), 12)
    assert_eq(compiler_threads_limit(compiler_threads_beside(threads, 16)), 1)
    assert_eq(compiler_threads_limit(compiler_threads_capped(CompilerThreads{cap: None, cores: 8, memory_available: None}, 2)), 2)
    assert_eq(compiler_threads_limit(compiler_threads_capped(CompilerThreads{cap: Val(40), cores: 8, memory_available: None}, 64)), 8)
}

#Test("compiles at once share the limit, and one alone takes all of it") {
    assert_eq(compiler_threads_share(32, 0), 32)
    assert_eq(compiler_threads_share(32, 1), 32)
    assert_eq(compiler_threads_share(32, 2), 16)
    assert_eq(compiler_threads_share(32, 3), 10)
    assert_eq(compiler_threads_share(1, 2), 1)
    assert_eq(compiler_threads_share(3, 8), 1)
    // Together the shares never take more than the limit while it covers
    // one thread each.
    loop limit in 1..<65 {
        loop compiles in 1..<9 {
            if limit >= compiles -> assert(compiler_threads_share(limit, compiles) * compiles <= limit, "{compiles} compiles over {limit} threads take more than the limit")
        }
    }
}

// Consecutive parts for `workers` threads over jobs of the given `weights`:
// `bounds[p]` is the first job of part `p` and `bounds[workers]` is the job
// count. Each part holds about an equal share of the total weight (a job
// weighs at least 1); a part is empty when one heavy job covers its share.
compiler_threads_partition: fn(weights: [Int], workers: Int) -> [Int] Never! {
    total := 0
    loop weight in weights -> total += if weight < 1 -> 1 else -> weight
    bounds := [Int]{0}
    reached := 0
    part := 1
    loop (index, weight) in weights {
        loop part < workers && reached * workers >= total * part {
            bounds.push(index)
            part += 1
        }
        reached += if weight < 1 -> 1 else -> weight
    }
    loop part < workers {
        bounds.push(weights.len())
        part += 1
    }
    bounds.push(weights.len())
    bounds
}

// The jobs of the given `weights` in claim order for a dynamically scheduled
// step: heaviest first, equal weights in job order (a stable merge of the
// indexes), so a heavy job starts while light ones remain to fill the
// threads' tails. `order[rank]` is the job index claimed at `rank`.
compiler_threads_heaviest_first: fn(weights: [Int]) -> [Int] Never! {
    count: weights.len()
    order := [Int]{}
    loop index in 0..<count -> order.push(index)
    if count < 2 -> return order
    scratch := [Int]{}
    loop _ in 0..<count -> scratch.push(0)
    width := 1
    loop width < count {
        start := 0
        loop start < count {
            middle := start + width
            if middle > count -> middle = count
            end := start + width + width
            if end > count -> end = count
            left := start
            right := middle
            out := start
            loop left < middle && right < end {
                if weights[order[right]] > weights[order[left]] {
                    scratch[out] = order[right]
                    right += 1
                } else {
                    scratch[out] = order[left]
                    left += 1
                }
                out += 1
            }
            loop left < middle {
                scratch[out] = order[left]
                left += 1
                out += 1
            }
            loop right < end {
                scratch[out] = order[right]
                right += 1
                out += 1
            }
            start = end
        }
        loop index in 0..<count -> order[index] = scratch[index]
        width += width
    }
    order
}

// A failed compiler thread's panic text, re-raised on the caller unchanged so
// an internal error reads the same with any thread count.
compiler_threads_failure_text: fn(failure: TaskFailure) -> String Never! {
    if failure == {
        .Panicked(reason) -> reason
        .DeadlineBlown -> "a compiler thread passed its deadline"
        .Canceled -> "a compiler thread was canceled"
    }
}

// Joins a compiler thread's task and returns its value. Every phase joins
// through here. A failed join re-raises the worker's own failure on the
// caller, with its text unchanged (compiler_threads_failure_text), as the same
// internal error: this checks nothing about the input, it only carries a stop
// that already happened on the worker back to the thread that ends the compile.
compiler_threads_joined: fn<T>(handle: ^^Task<T>) -> T Never! {
    handle.join() ?? panic(compiler_threads_failure_text(err))
}
