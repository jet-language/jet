// Single reader for Jet's JSON machine-output door.
use JetFoundation.DataTree.[DataTree]
use JetFoundation.Report.[NoFixReasonKind, REPORT_SCHEMA, STATUS_SCHEMA]
use JetFoundation.JSON as json
// Rust: crates/jet-foundation/src/MachineOutput.rs:7
pub enum MachineRecord { Report Status BrowserRelay }
// Rust: crates/jet-foundation/src/MachineOutput.rs:13
pub fn read_machine_line(text: String) -> MachineRecord Err! {
    trimmed := text.trim() // #4303
    value :: json.parse(trimmed)?
    object :: value.as_object()?
    schema :: (field(object, "schema") ?? return Err("machine record is missing `schema`")).as_str()?
    if schema == REPORT_SCHEMA {
        validate_report(object)?
        return MachineRecord.Report
    }
    if schema == STATUS_SCHEMA {
        validate_status(object)?
        action := ""
        if field(object, "action") == .Val(value) { action = value.as_str().ok() ?? "" }
        return if action == "browser.relay" { MachineRecord.BrowserRelay } else { MachineRecord.Status }
    }
    Err("machine record uses `{schema}`; expected `{REPORT_SCHEMA}` or `{STATUS_SCHEMA}`")
}
// Rust: crates/jet-foundation/src/MachineOutput.rs:41
fn field(object: View<(String,DataTree)>, key: String) -> (@DataTree)? Never! from object {
    loop (name, value) in object { if name == key -> return Val(@value) }
    None
}
// Rust: crates/jet-foundation/src/MachineOutput.rs:46
fn validate_report(object: View<(String,DataTree)>) Err! {
    loop key in [String]{"moment", "severity", "code", "what", "why", "fix"} {
        _ :: (field(object, key) ?? return Err("report record is missing `{key}`")).as_str()?
    }
    has_edits :: field(object, "fix_edits") != None
    has_reason :: field(object, "no_fix_reason") != None
    if has_edits && has_reason -> return Err("report record cannot contain both `fix_edits` and `no_fix_reason`")
    if field(object, "fix_edits") == .Val(value) {
        edits :: value.as_array()?
        loop value in edits {
            edit :: value.as_object()?
            _ :: (field(edit, "file") ?? return Err("report edit is missing `file`")).as_str()?
            span :: (field(edit, "span") ?? return Err("report edit is missing `span`")).as_object()?
            loop key in [String]{"start", "end"} {
                _ :: field(span, key) ?? return Err("report edit span is missing `{key}`")
            }
            _ :: (field(edit, "new_text") ?? return Err("report edit is missing `new_text`")).as_str()?
            _ :: (field(edit, "safety") ?? return Err("report edit is missing `safety`")).as_str()?
        }
    }
    if field(object, "no_fix_reason") == .Val(value) {
        reason :: value.as_object()?
        kind :: (field(reason, "kind") ?? return Err("no-fix reason is missing `kind`")).as_str()?
        _ :: NoFixReasonKind.parse(kind)?
        next :: (field(reason, "next") ?? return Err("no-fix reason is missing `next`")).as_str()?
        trimmed := next.trim() // #4303
        if trimmed.is_empty() || next.chars().any(fn(ch) { ch.is_control() }) {
            return Err("no-fix reason `next` must be a reviewed printable action")
        }
    }
}
// Rust: crates/jet-foundation/src/MachineOutput.rs:95
fn validate_status(object: View<(String,DataTree)>) Err! {
    action :: (field(object, "action") ?? return Err("status record is missing `action`")).as_str()?
    if action.is_empty() || action.chars().any(fn(ch) { ch.is_control() }) {
        return Err("status record `action` must be a non-empty printable string")
    }
    if field(object, "status") != None -> return Err("status record must not contain the legacy `status` key")
    if field(object, "ok") == {
        .Val(.Bool(_)) -> {}
        .Val(_) -> return Err("status record field `ok` is not boolean")
        .None -> return Err("status record is missing `ok`")
    }
    reports :: (field(object, "reports") ?? return Err("status record is missing `reports`")).as_array()?
    loop value in reports {
        report :: value.as_object()?
        schema :: (field(report, "schema") ?? return Err("status report is missing `schema`")).as_str()?
        if schema != REPORT_SCHEMA -> return Err("status report uses `{schema}`; expected `{REPORT_SCHEMA}`")
        validate_report(report)?
    }
}
// Rust: crates/jet-foundation/src/MachineOutput.rs:128
pub fn read_machine_output(text: String) -> [MachineRecord] Err! {
    records := [MachineRecord]{}
    loop (index, line) in text.lines() {
        trimmed := line.trim() // #4303
        if trimmed.is_empty() -> continue
        record :: if read_machine_line(line) == {
            .Ok(value) -> value
            .Err(error) -> return Err("machine record {index + 1}: {error}")
        }
        records.push(record)
    }
    if records.is_empty() -> return Err("machine output contains no records")
    records
}
