// Dependency-free, lossless JSON-number projection shared by execution tiers.
// Token grammar is checked by the tokenizer; these helpers preserve exact text
// and enforce shared resource limits without a binary-float round trip.

// Rust: crates/jet-foundation/src/JSONNumber.rs:7
pub const JSON_NUMBER_MAX_DIGITS: Int = 1_000_000
// Rust: crates/jet-foundation/src/JSONNumber.rs:8
pub const JSON_NUMBER_MAX_EXPONENT: I64 = 1_000_000

// Rust: crates/jet-foundation/src/JSONNumber.rs:10
pub fn validate_json_number(text: String) -> Err! {
    digits :: text.bytes().filter(fn(byte) { byte.is_ascii_digit() }).count()
    if digits > JSON_NUMBER_MAX_DIGITS -> throw "JSON number exceeds the {JSON_NUMBER_MAX_DIGITS}-digit limit"
    exponent := I64{0}
    if text.find(fn(ch) { ch == 'e' || ch == 'E' }) == .Val(index) {
        exponent = try { I64.parse(text[index + 1..])! } catch _ { throw "JSON number exponent is out of range" }
    }
    if exponent.unsigned_abs() > U64{JSON_NUMBER_MAX_EXPONENT} -> throw "JSON number exponent exceeds the ±{JSON_NUMBER_MAX_EXPONENT} limit"
}

// Rust: crates/jet-foundation/src/JSONNumber.rs:33
// Return sign, integer mantissa digits and decimal scale. Caller owns '+' law.
pub fn json_decimal_lexeme(s: String) -> (Bool, [U8], U32) Err! {
    t := s.trim() // #4303: retain trim view.
    if t.is_empty() -> throw "empty decimal number"
    negative :: t.starts_with('-')
    body := if negative || t.starts_with('+') -> t[1..] else -> t // #4303
    mantissa := body // #4303
    exponent := I64{0}
    if body.find(fn(ch) { ch == 'e' || ch == 'E' }) == .Val(index) {
        exponent = try { I64.parse(body[index + 1..])! } catch _ { throw "decimal exponent is out of range" }
        mantissa = body[..index] // #4303
    }
    parts := mantissa.split('.')
    int_part := parts.next() ?? "" // #4303
    frac_part := parts.next() ?? "" // #4303
    if parts.next().is_some() || int_part.is_empty() && frac_part.is_empty() || !int_part.bytes().all(fn(byte) { byte.is_ascii_digit() }) || !frac_part.bytes().all(fn(byte) { byte.is_ascii_digit() }) -> throw "invalid decimal number `{s}`"
    raw_digits :: int_part.len().saturating_add(frac_part.len())
    if raw_digits > JSON_NUMBER_MAX_DIGITS -> throw "decimal number exceeds the {JSON_NUMBER_MAX_DIGITS}-digit limit"
    if exponent.unsigned_abs() > U64{JSON_NUMBER_MAX_EXPONENT} -> throw "decimal exponent exceeds the ±{JSON_NUMBER_MAX_EXPONENT} limit"
    frac_len :: I64.try_from(frac_part.len()) ?? throw "decimal scale is out of range"
    scale :: frac_len.checked_sub(exponent) ?? throw "decimal scale is out of range"
    digits := int_part.bytes().chain(frac_part.bytes()).map(fn(byte) { byte - U8{48} }).collect<[U8]>()
    if digits.is_empty() -> &digits.push(U8{0})
    if scale < 0 {
        zeros :: Int.try_from(-scale) ?? throw "decimal scale is out of range"
        total :: digits.len().checked_add(zeros) ?? throw "decimal number is too large"
        if total > JSON_NUMBER_MAX_DIGITS -> throw "decimal number exceeds the {JSON_NUMBER_MAX_DIGITS}-digit limit"
        &digits.resize(total, U8{0})
    }
    if digits.iter().position(fn(digit) { digit != U8{0} }) == .Val(first_nonzero) {
        if first_nonzero > 0 -> _ :: &digits.drain(..first_nonzero)
    } else {
        &digits.truncate(1)
    }
    checked_scale :: U32.try_from(scale.max(I64{0})) ?? throw "decimal scale is out of range"
    checked_negative :: negative && digits.iter().any(fn(digit) { digit != U8{0} })
    (checked_negative, ^digits, checked_scale)
}

// Rust: crates/jet-foundation/src/JSONNumber.rs:119
// Native small Decimal projection. None selects arbitrary precision; successful
// small values allocate nothing, and validation matches json_decimal_lexeme.
pub fn json_decimal_small(s: String) -> (Bool, I128, U32)? Err! {
    t := s.trim() // #4303
    if t.is_empty() -> throw "empty decimal number"
    negative :: t.starts_with('-')
    body := if negative || t.starts_with('+') -> t[1..] else -> t // #4303
    mantissa := body // #4303
    exponent := I64{0}
    if body.find(fn(ch) { ch == 'e' || ch == 'E' }) == .Val(index) {
        exponent = try { I64.parse(body[index + 1..])! } catch _ { throw "decimal exponent is out of range" }
        mantissa = body[..index] // #4303
    }
    parts := mantissa.split('.')
    int_part := parts.next() ?? "" // #4303
    frac_part := parts.next() ?? "" // #4303
    if parts.next().is_some() || int_part.is_empty() && frac_part.is_empty() -> throw "invalid decimal number `{s}`"
    valid := true
    value := I128{0}
    significant := 0
    nonzero := false
    fits := true
    loop digit in int_part.bytes().chain(frac_part.bytes()) {
        if !digit.is_ascii_digit() {
            valid = false
            continue
        }
        if !nonzero {
            if digit == U8{48} -> continue
            nonzero = true
        }
        significant += 1
        if fits {
            next :: value.checked_mul(I128{10}).and_then(fn(current) { current.checked_add(I128{digit - U8{48}}) }) ?? {
                fits = false
                continue
            }
            value = next
        }
    }
    if !valid -> throw "invalid decimal number `{s}`"
    raw_digits :: int_part.len().saturating_add(frac_part.len())
    if raw_digits > JSON_NUMBER_MAX_DIGITS -> throw "decimal number exceeds the {JSON_NUMBER_MAX_DIGITS}-digit limit"
    if exponent.unsigned_abs() > U64{JSON_NUMBER_MAX_EXPONENT} -> throw "decimal exponent exceeds the ±{JSON_NUMBER_MAX_EXPONENT} limit"
    frac_len :: I64.try_from(frac_part.len()) ?? throw "decimal scale is out of range"
    scale := frac_len.checked_sub(exponent) ?? throw "decimal scale is out of range"
    if scale < 0 {
        zeros :: Int.try_from(-scale) ?? throw "decimal scale is out of range"
        total :: raw_digits.checked_add(zeros) ?? throw "decimal number is too large"
        if total > JSON_NUMBER_MAX_DIGITS -> throw "decimal number exceeds the {JSON_NUMBER_MAX_DIGITS}-digit limit"
    }
    if !nonzero {
        checked_scale :: U32.try_from(scale.max(I64{0})) ?? throw "decimal scale is out of range"
        return Val((false, I128{0}, checked_scale))
    }
    if !fits -> return None
    if scale < 0 {
        zeros :: Int.try_from(-scale) ?? throw "decimal scale is out of range"
        if significant.checked_add(zeros).map_or(true, fn(digits) { digits > 39 }) -> return None
        loop _ in 0..zeros {
            next :: value.checked_mul(I128{10}) ?? return None
            value = next
        }
        scale = I64{0}
    }
    checked_scale :: U32.try_from(scale) ?? throw "decimal scale is out of range"
    Val((negative && value != I128{0}, value, checked_scale))
}

// Rust: crates/jet-foundation/src/JSONNumber.rs:240
// Signed integer text for mathematically integral JSON numbers. Only destination
// range checks differ between default Int and fixed-width integer consumers.
pub fn json_exact_integer_text(s: String) -> String Err! {
    (negative, digits, scale) :: json_decimal_lexeme(s)!
    fractional :: Int.try_from(scale) ?? Int.MAX
    if fractional > 0 && digits.iter().rev().take(fractional).any(fn(digit) { digit != U8{0} }) -> throw "JSON number `{s}` is not an exact integer"
    keep :: digits.len().saturating_sub(fractional)
    integer := String.with_capacity(keep.max(1) + if negative -> 1 else -> 0)
    if negative -> &integer.push('-')
    if keep == 0 { &integer.push('0') }
    else { &integer.extend(digits[..keep].iter().map(fn(digit) { Char.from_u32(U32{U8{48} + digit}) ?? unreachable() })) }
    ^integer
}
