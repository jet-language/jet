// Canonical published-schema facts and shared runtime step application.
use jet_foundation.MIR.[MIRRuntimeValue, MIRRuntimeField]
// Rust: crates/jet-foundation/src/SchemaMigration.rs:13
pub struct SchemaMigrationPlan { pub type_name: String, pub historical_shapes: [[String]], pub steps: [SchemaMigrationStep] }
impl SchemaMigrationPlan {
    // Rust: crates/jet-foundation/src/SchemaMigration.rs:22
    pub fn new(type_name: ^String, historical_shapes: ^[[String]], steps: ^[SchemaMigrationStep]) -> SchemaMigrationPlan Never! {
        SchemaMigrationPlan{type_name: ^type_name, historical_shapes: ^historical_shapes, steps: ^steps}
    }
    // Rust: crates/jet-foundation/src/SchemaMigration.rs:35
    pub fn current_shape(self) -> Int Never! { self.steps.len() }
    // Rust: crates/jet-foundation/src/SchemaMigration.rs:42
    pub fn apply_wire_step(self, value: MIRRuntimeValue, default: &(String, String) -> MIRRuntimeValue Err!, convert: &(String, String, String, MIRRuntimeValue) -> MIRRuntimeValue Err!) -> SchemaMigrationResult SchemaMigrationError! {
        (type_name, input) :: if value == {
            .Struct(type_name, fields) -> (type_name, fields)
            else -> return Err(SchemaMigrationError.NotRecord)
        }
        if type_name != self.type_name -> return Err(SchemaMigrationError.TypeMismatch{expected: ~self.type_name, actual: ~type_name})
        wire_keys := [String:Bool]{}
        loop field in input -> wire_keys[~field.name] = true
        current :: self.current_shape_keys()
        current_shape :: self.current_shape_name()
        if wire_keys == current -> return Ok(SchemaMigrationResult{value: ~value, receipt: SchemaMigrationReceipt.kept(self.type_name, current_shape)})
        start := Int?{None}
        loop index in 0..<self.historical_shapes.len() {
            shape := [String:Bool]{}
            loop key in self.historical_shapes[index] -> shape[~key] = true
            if shape == wire_keys { start = Val(index); break }
        }
        first :: start ?? {
            keys := wire_keys.keys().to_list()
            &keys.sort()
            return Err(SchemaMigrationError.UnknownShape{type_name: ~self.type_name, keys: ^keys})
        }
        fields := [String:MIRRuntimeValue]{}
        loop field in input -> fields[~field.name] = ~field.value
        from_shape :: if self.steps.get(first) == {
            .Val(step) -> ~step.from_shape
            else -> self.historical_shape_name(first) ?? ~current_shape
        }
        receipt := SchemaMigrationReceipt.migrated(self.type_name, from_shape, current_shape)
        loop index in first..<self.steps.len() {
            step :: self.steps[index]
            loop op in step.ops {
                if op == {
                    .Rename(from_key, to_key) -> {
                        old :: &fields.remove(from_key) ?? return Err(SchemaMigrationError.MissingField{step: step.name(), field: ~from_key})
                        if fields.has_key(to_key) -> return Err(SchemaMigrationError.DuplicateField{step: step.name(), field: ~to_key})
                        fields[~to_key] = ^old
                        &receipt.swapped.push("{from_key}->{to_key}")
                        &receipt.migrated.push(~to_key)
                    }
                    .Remove(key) -> {
                        if &fields.remove(key) == None -> return Err(SchemaMigrationError.MissingField{step: step.name(), field: ~key})
                        &receipt.migrated.push(~key)
                    }
                    .Add(key, type_name, default_fn) -> {
                        if fields.has_key(key) -> return Err(SchemaMigrationError.DuplicateField{step: step.name(), field: ~key})
                        added :: if default(default_fn, type_name) == {
                            .Ok(result) -> ^result
                            .Err(detail) -> return Err(SchemaMigrationError.Callback{step: step.name(), field: ~key, detail: ^detail})
                        }
                        fields[~key] = ^added
                        &receipt.migrated.push(~key)
                    }
                    .Change(key, from_type, to_type, converter_fn) -> {
                        old :: fields.get(key) ?? return Err(SchemaMigrationError.MissingField{step: step.name(), field: ~key})
                        changed :: if convert(converter_fn, from_type, to_type, old) == {
                            .Ok(result) -> ^result
                            .Err(detail) -> return Err(SchemaMigrationError.Callback{step: step.name(), field: ~key, detail: ^detail})
                        }
                        fields[~key] = ^changed
                        &receipt.migrated.push(~key)
                    }
                }
            }
            if index + 1 == self.steps.len() -> break
        }
        names := fields.keys().to_list()
        &names.sort()
        migrated := [String:Bool]{}
        loop key in receipt.migrated -> migrated[~key] = true
        rows := [MIRRuntimeField]{}
        loop key in names {
            if !migrated.has_key(key) -> &receipt.kept.push(~key)
            &rows.push(MIRRuntimeField{name: ~key, value: &fields.remove(key).expect("indexed migration key")})
        }
        Ok(SchemaMigrationResult{value: MIRRuntimeValue.Struct{type_name: ~type_name, fields: ^rows}, receipt: ^receipt})
    }
    // Rust: crates/jet-foundation/src/SchemaMigration.rs:185
    pub fn current_shape_keys(self) -> [String:Bool] Never! {
        keys := [String:Bool]{}
        if self.historical_shapes.first() == .Val(shape) { loop key in shape -> keys[~key] = true }
        loop step in self.steps {
            loop op in step.ops {
                if op == {
                    .Rename(from_key, to_key) -> { _ :: &keys.remove(from_key); keys[~to_key] = true }
                    .Remove(key) -> _ :: &keys.remove(key)
                    .Add(key, _, _) -> keys[~key] = true
                    .Change(_, _, _, _) -> {}
                }
            }
        }
        ^keys
    }
    // Rust: crates/jet-foundation/src/SchemaMigration.rs:213
    fn historical_shape_name(self, index: Int) -> String? Never! {
        if self.steps.get(index) == { .Val(step) -> Val(~step.from_shape) else -> Val("v{index + 1}") }
    }
    // Rust: crates/jet-foundation/src/SchemaMigration.rs:220
    pub fn current_shape_name(self) -> String Never! {
        if self.steps.last() == { .Val(step) -> ~step.to_shape else -> "current" }
    }
}
// Rust: crates/jet-foundation/src/SchemaMigration.rs:228
pub struct SchemaMigrationStep { pub from_shape: String, pub to_shape: String, pub ops: [SchemaMigrationOp] }
impl SchemaMigrationStep {
    // Rust: crates/jet-foundation/src/SchemaMigration.rs:235
    pub fn new(from_shape: ^String, to_shape: ^String, ops: ^[SchemaMigrationOp]) -> SchemaMigrationStep Never! { SchemaMigrationStep{from_shape: ^from_shape, to_shape: ^to_shape, ops: ^ops} }
    // Rust: crates/jet-foundation/src/SchemaMigration.rs:247
    fn name(self) -> String Never! { "{self.from_shape}->{self.to_shape}" }
}
// Rust: crates/jet-foundation/src/SchemaMigration.rs:254
pub enum SchemaMigrationOp {
    Rename(from_key: String, to_key: String)
    Remove(key: String)
    Add(key: String, type_name: String, default_fn: String)
    Change(key: String, from_type: String, to_type: String, converter_fn: String)
}
// Rust: crates/jet-foundation/src/SchemaMigration.rs:278
pub struct SchemaMigrationResult { pub value: MIRRuntimeValue, pub receipt: SchemaMigrationReceipt }
// Rust: crates/jet-foundation/src/SchemaMigration.rs:287
pub struct SchemaMigrationReceipt {
    pub type_name: String, pub from_shape: String, pub to_shape: String,
    pub swapped: [String], pub kept: [String], pub migrated: [String], pub restarting: String?
}
impl SchemaMigrationReceipt {
    // Rust: crates/jet-foundation/src/SchemaMigration.rs:298
    pub fn kept(type_name: String, shape: String) -> SchemaMigrationReceipt Never! {
        SchemaMigrationReceipt{type_name: ~type_name, from_shape: ~shape, to_shape: ~shape, swapped: [], kept: [], migrated: [], restarting: None}
    }
    // Rust: crates/jet-foundation/src/SchemaMigration.rs:310
    pub fn migrated(type_name: String, from: String, to: String) -> SchemaMigrationReceipt Never! {
        SchemaMigrationReceipt{type_name: ~type_name, from_shape: ~from, to_shape: ~to, swapped: [], kept: [], migrated: [], restarting: None}
    }
    // Rust: crates/jet-foundation/src/SchemaMigration.rs:322
    pub fn restarting(type_name: String, reason: ^String) -> SchemaMigrationReceipt Never! {
        SchemaMigrationReceipt{type_name: ~type_name, from_shape: "", to_shape: "", swapped: [], kept: [], migrated: [], restarting: Val(^reason)}
    }
}
// Rust: crates/jet-foundation/src/SchemaMigration.rs:338
#Error
pub enum SchemaMigrationError {
    NotRecord
    TypeMismatch(expected: String, actual: String)
    UnknownShape(type_name: String, keys: [String])
    MissingField(step: String, field: String)
    DuplicateField(step: String, field: String)
    Callback(step: String, field: String, detail: String)
}
impl SchemaMigrationError {
    // Rust: crates/jet-foundation/src/SchemaMigration.rs:364
    pub fn display(self) -> String Never! {
        if self == {
            .NotRecord -> "published-schema value is not a record"
            .TypeMismatch(expected, actual) -> "published-schema type `{actual}` does not match `{expected}`"
            .UnknownShape(type_name, keys) -> {
                rendered := [U8]{91}
                loop index in 0..<keys.len() {
                    if index > 0 { &rendered.push(U8{44}); &rendered.push(U8{32}) }
                    // GATE #4499: canonical Rust string Debug escaping.
                    core.text.runtime.kernel_escape_debug.debug_str_into(&rendered, keys[index])
                }
                &rendered.push(U8{93})
                names :: String.from_bytes(^rendered).expect("debug escape emits UTF-8")
                "published-schema `{type_name}` has unknown wire keys {names}"
            }
            .MissingField(step, field) -> "migration {step} needs wire field `{field}`"
            .DuplicateField(step, field) -> "migration {step} would duplicate wire field `{field}`"
            .Callback(step, field, detail) -> "migration {step} failed for `{field}`: {detail}"
        }
    }
}
// Rust: crates/jet-foundation/src/SchemaMigration.rs:386
// std::error::Error is carried by #Error on SchemaMigrationError.
