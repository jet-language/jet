// One XML operation kernel for compiled, comptime, and interpreter adapters.
use JetFoundation.XmlPull as xml

// Rust: crates/jet-foundation/src/XmlKernel.rs:5
fn without_untrusted_lexical_evidence(value: xml.Value) -> xml.Value Never! {
    clean := ^value
    xml.invalidate_untrusted_lexical_evidence(&clean)
    ^clean
}
// Rust: crates/jet-foundation/src/XmlKernel.rs:10
fn checked(value: &xml.Value) -> xml.Value Never! {
    without_untrusted_lexical_evidence(value.clone())
}
// Rust: crates/jet-foundation/src/XmlKernel.rs:14
pub fn parse_document(text: String) -> xml.Value xml.Error! {
    without_untrusted_lexical_evidence(xml.parse_document(text))
}
// Rust: crates/jet-foundation/src/XmlKernel.rs:18
pub fn parse_document_with(text: String, options: &xml.ParseOptions) -> xml.Value xml.Error! {
    without_untrusted_lexical_evidence(xml.parse_document_with(text, options))
}
// Rust: crates/jet-foundation/src/XmlKernel.rs:25
pub fn parse_document_bytes_with(bytes: View<U8>, options: &xml.ParseOptions) -> xml.Value xml.Error! {
    without_untrusted_lexical_evidence(xml.parse_document_bytes_with(bytes, options))
}
// Rust: crates/jet-foundation/src/XmlKernel.rs:32
pub fn parse_document_bytes(bytes: View<U8>) -> xml.Value xml.Error! {
    options :: xml.ParseOptions.safe()
    parse_document_bytes_with(bytes, &options)
}
// Rust: crates/jet-foundation/src/XmlKernel.rs:36
pub fn render_document(value: &xml.Value) -> String xml.Error! {
    clean :: checked(value)
    xml.render_document(&clean) catch { reason -> return Err(xml.Error{
        kind: xml.Reason.Shape, offset: 0, line: None, column: None, path: "", reason: reason
    }) }
}
// Rust: crates/jet-foundation/src/XmlKernel.rs:47
pub fn render_document_bytes(value: &xml.Value, encoding: xml.RenderEncoding, lexical: xml.LexicalPolicy) -> [U8] xml.Error! {
    clean :: checked(value)
    xml.render_document_bytes(&clean, encoding, lexical)
}
// Rust: crates/jet-foundation/src/XmlKernel.rs:55
pub fn canonical_document(value: &xml.Value, options: &xml.CanonicalOptions) -> String xml.Error! {
    clean :: checked(value)
    xml.canonical_document(&clean, options)
}
// Rust: crates/jet-foundation/src/XmlKernel.rs:62
pub fn document_root(value: &xml.Value) -> xml.Value xml.Error! {
    clean :: checked(value)
    xml.document_root(&clean)
}
// Rust: crates/jet-foundation/src/XmlKernel.rs:66
pub fn expanded_name_parts(value: &xml.Value) -> (String, String?, String, String?) xml.Error! {
    clean :: checked(value)
    xml.expanded_name_parts(&clean)
}
// Rust: crates/jet-foundation/src/XmlKernel.rs:72
pub fn lookup_attribute(value: &xml.Value, name: String) -> String? xml.Error! {
    clean :: checked(value)
    xml.lookup_attribute(&clean, name)
}
// Rust: crates/jet-foundation/src/XmlKernel.rs:76
pub fn element_content(value: &xml.Value) -> [xml.Value] xml.Error! {
    clean :: checked(value)
    xml.element_content(&clean)
}
