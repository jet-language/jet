pub fn current_digest(label: String) -[Env, FS.Read]> String? Never! {
    if label.strip_prefix("file:") == .Val(path) {
        native :: OSPath.from_text(path) // GATE #4494: native string-to-path ingress.
        result :: check_reads_fs.read(native)
        return Val(digest_io(result, check_reads_hash_bytes))
