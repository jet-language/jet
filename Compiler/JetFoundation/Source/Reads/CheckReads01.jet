fn record(label: String, digest: String) Never! {
    guard := recorder()
    if guard.depth == 0 -> return
    if guard.reads.get(label) == .Val(previous) {
        if previous != digest -> guard.reads[label] = "conflict"
    } else -> guard.reads[label] = digest
}
