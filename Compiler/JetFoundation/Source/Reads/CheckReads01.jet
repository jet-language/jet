fn check_reads_directory_paths(path: OSPath) -[FS.Read]> [OSPath] IOError! {
    // GATE #4494: real native stream, per-entry errors, and descriptor cleanup.
    entries :: check_reads_fs.read_dir(path)
    paths := [OSPath]{}
    loop result in entries {
        entry :: result
        &paths.push(entry.path())
    }
    &paths.sort()
    ^paths
}
