pub fn read(path: OSPath) -[FS.Read]> [U8] IOError! {
    // GATE #4494: native filesystem read consumes the original encoded OSPath.
    result :: check_reads_fs.read(path)
    record(file_label(path), digest_io(result, check_reads_hash_bytes))
    result
}
