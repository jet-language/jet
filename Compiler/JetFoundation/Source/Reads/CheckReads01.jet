fn digest_io<T>(result: T IOError!, digest: fn(T) -> String) -> String Never! {
    if result == {
        .Ok(value) -> digest(value)
        .Err(error) -> {
            // GATE #4409: preserve original ErrorKind, including all Debug names.
            if error.kind() == IOErrorKind.NotFound -> CHECK_READS_MISSING else -> "unreadable:{error.kind():Debug}"
        }
    }
}
fn check_reads_hash_bytes(bytes: [U8]) -> String Never! {
    digest :: mir_sha256_bytes(bytes.view(0..<bytes.len()))
    mir_sha256_hex_bytes(digest.view(0..<digest.len()))
}
