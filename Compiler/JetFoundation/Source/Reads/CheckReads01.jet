    if label.strip_prefix("dir:") == .Val(path) {
        native :: OSPath.from_text(path) // GATE #4494.
        result :: check_reads_directory_paths(native)
        return Val(digest_io(result, listing_digest))
    }
    if label.strip_prefix("env:") == .Val(name) -> return Val(env_digest(check_reads_env.var_os(name)))
