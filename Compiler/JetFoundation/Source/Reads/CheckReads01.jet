fn listing_digest(paths: [OSPath]) -> String Never! {
    names := [String]{}
    loop path in paths {
        name :: if path.file_name() == .Val(value) -> value.to_string_lossy() else -> ""
        &names.push(name)
    }
    mir_sha256_hex(names.join("\n"))
}
