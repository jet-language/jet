// crates/jet-foundation/src/JSON.rs string quoting.

// Rust `JSON::json_escape`: `"`, `\`, LF, CR and TAB use short escapes; every
// other Unicode control scalar (Cc: U+0000-U+001F, U+007F-U+009F) becomes
// `\u00xx`; all other scalars are copied verbatim.
pub fn foundation_json_escape(value: String) -> String Never! {
    bytes :: value.bytes()
    hex :: "0123456789abcdef".bytes()
    out := [U8]{}
    index := 0
    loop index < bytes.len() {
        byte :: Int.from_u8(bytes[index])
        // U+0080-U+009F encode as C2 80 .. C2 9F.
        control :: if {
            byte < 32 || byte == 127 -> byte
            byte == 194 && index + 1 < bytes.len() && Int.from_u8(bytes[index + 1]) <= 159 -> Int.from_u8(bytes[index + 1])
            else -> -1
        }
        if {
            byte == 34 -> foundation_json_append(&out, "\\\"")
            byte == 92 -> foundation_json_append(&out, "\\\\")
            byte == 10 -> foundation_json_append(&out, "\\n")
            byte == 13 -> foundation_json_append(&out, "\\r")
            byte == 9 -> foundation_json_append(&out, "\\t")
            control >= 0 -> {
                foundation_json_append(&out, "\\u00")
                &out.push(hex[control >> 4])
                &out.push(hex[control & 15])
                if byte == 194 -> index += 1
            }
            else -> &out.push(bytes[index])
        }
        index += 1
    }
    String.from_bytes(out) ?? panic("JSON escaping preserves UTF-8")
}

// Rust `JSON::quote`.
pub fn foundation_json_quote(value: String) -> String Never! {
    "\"{foundation_json_escape(value)}\""
}

fn foundation_json_append(out: &[U8], text: String) Never! {
    loop byte in text.bytes() -> &out.push(byte)
}
