    fn abs_sub(self, rhs: BigInt) -> BigInt Never! {
        out := [U32]{}
        borrow := I64{0}
        loop i in 0..<self.limbs.len() {
            n := I64{self.limbs[i]} - I64{rhs.limbs.get(i) ?? U32{0}} - borrow
            if n < 0 { n += 1000000000; borrow = 1 } else -> borrow = 0
            &out.push(U32{n})
        }
        value := BigInt{sign: 1, limbs: out}
        &value.normalize()
        value
    }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:425
    pub fn add(self, rhs: BigInt) -> BigInt Never! {
        if self.sign == 0 -> return rhs
        if rhs.sign == 0 -> return self
        if self.sign == rhs.sign { out := self.abs_add(rhs); out.sign = self.sign; return out }
        if self.abs_cmp(rhs) == {
            .Greater -> { out := self.abs_sub(rhs); out.sign = self.sign; out }
            .Less -> { out := rhs.abs_sub(self); out.sign = rhs.sign; out }
            .Equal -> BigInt.zero()
        }
    }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:452
    pub fn sub(self, rhs: BigInt) -> BigInt Never! { self.add(rhs.neg()) }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:455
    pub fn mul(self, rhs: BigInt) -> BigInt Never! {
        if self.is_zero() || rhs.is_zero() -> return BigInt.zero()
        out := [U64]{}
        loop _ in 0..<(self.limbs.len() + rhs.limbs.len()) -> &out.push(U64{0})
        loop (i, a) in self.limbs {
            carry := U64{0}
            loop (j, b) in rhs.limbs {
                at :: i + j
                n :: out[at] + U64{a} * U64{b} + carry
                out[at] = n % 1000000000
                carry = n / 1000000000
            }
            out[i + rhs.limbs.len()] += carry
        }
        value := BigInt{sign: self.sign * rhs.sign, limbs: out.map(v -> U32{v})}
        &value.normalize()
        value
    }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:478
    fn mul_small(self, rhs: U32) -> BigInt Never! {
        if rhs == 0 || self.is_zero() -> return BigInt.zero()
        out := [U32]{}
        carry := U64{0}
        loop a in self.limbs {
            n :: U64{a} * U64{rhs} + carry
            &out.push(U32{n % 1000000000})
            carry = n / 1000000000
        }
        if carry > 0 -> &out.push(U32{carry})
        BigInt{sign: 1, limbs: out}
    }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:497
    pub fn div_rem_abs(self, rhs: BigInt) -> (BigInt, BigInt) Err! {
        if rhs.is_zero() -> return Err("integer division by zero")
        divisor :: rhs.abs()
        dividend :: self.abs()
        if dividend.abs_cmp(divisor) == Ordering.Less -> return Ok((BigInt.zero(), dividend))
        quotient := [U32]{}
        loop _ in dividend.limbs -> &quotient.push(U32{0})
        remainder := BigInt.zero()
        i := dividend.limbs.len()
        loop i > 0 {
            i -= 1
            &remainder.limbs.insert(0, dividend.limbs[i])
            remainder.sign = 1
            &remainder.normalize()
            lo := U32{0}
            hi := U32{999999999}
            loop lo < hi {
                mid :: lo + (hi - lo) / 2 + 1
                if divisor.mul_small(mid).abs_cmp(remainder) != Ordering.Greater -> lo = mid else -> hi = mid - 1
            }
            quotient[i] = lo
            if lo != 0 -> remainder = remainder.abs_sub(divisor.mul_small(lo))
        }
        q := BigInt{sign: 1, limbs: quotient}
        &q.normalize()
        Ok((q, remainder))
    }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:538
    pub fn exact_div(self, rhs: BigInt) -> BigInt Err! {
        (quotient, r) :: self.div_rem_abs(rhs)
        if !r.is_zero() -> return Err("integer division is not exact")
        q := quotient
        q.sign = self.sign * rhs.sign
        &q.normalize()
        Ok(q)
    }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:547
    pub fn gcd(left: BigInt, right: BigInt) -> BigInt Err! {
        a := left.abs()
        b := right.abs()
        loop !b.is_zero() { (_, r) :: a.div_rem_abs(b); a = b; b = r }
        Ok(a)
    }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:559
    pub fn to_string(self) -> String Never! {
        if self.sign == 0 -> return "0"
        pieces := [String]{}
        if self.sign < 0 -> &pieces.push("-")
        i := self.limbs.len() - 1
        &pieces.push("{self.limbs[i]}")
        loop i > 0 { i -= 1; &pieces.push("{self.limbs[i]:09}") }
        pieces.join("")
    }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:575
    pub fn cmp(self, rhs: BigInt) -> Ordering Never! {
        if self.sign != rhs.sign -> return self.sign <=> rhs.sign
        order :: self.abs_cmp(rhs)
        if self.sign < 0 -> order.reverse() else -> order
    }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:586
    pub fn partial_cmp(self, rhs: BigInt) -> Ordering? Never! { Val(self.cmp(rhs)) }
}

// Rust: crates/jet-foundation/src/PerformanceBudget.rs:592
pub struct Rational {
    pub num: BigInt
    pub den: BigInt
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:598
    pub fn new(num: I128, den: I128) -> Rational Err! { Rational.from_bigints(BigInt.from_i128(num), BigInt.from_i128(den)) }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:601
    pub fn parse(num: String, den: String) -> Rational Err! { Rational.from_bigints(BigInt.parse(num), BigInt.parse(den)) }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:604
    pub fn parse_source(num: String, den: String) -> Rational Err! { Rational.from_bigints(BigInt.parse_source(num), BigInt.parse_source(den)) }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:607
    pub fn from_bigints(num: BigInt, den: BigInt) -> Rational Err! {
        if den.is_zero() -> return Err("rational denominator is zero")
        n := num
        d := den
        if d.is_negative() { n = n.neg(); d = d.neg() }
        if n.is_zero() -> return Ok(Rational.zero())
        divisor :: BigInt.gcd(n, d)
        Ok(Rational{num: n.exact_div(divisor), den: d.exact_div(divisor)})
    }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:624
    pub fn zero() -> Rational Never! { Rational{num: BigInt.zero(), den: BigInt.one()} }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:630
    pub fn integer(value: I128) -> Rational Never! { Rational{num: BigInt.from_i128(value), den: BigInt.one()} }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:636
    pub fn add(self, rhs: Rational) -> Rational Err! { Rational.from_bigints(self.num.mul(rhs.den).add(rhs.num.mul(self.den)), self.den.mul(rhs.den)) }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:642
    pub fn sub(self, rhs: Rational) -> Rational Err! { self.add(rhs.neg()) }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:645
    pub fn mul(self, rhs: Rational) -> Rational Err! { Rational.from_bigints(self.num.mul(rhs.num), self.den.mul(rhs.den)) }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:648
    pub fn div(self, rhs: Rational) -> Rational Err! {
        if rhs.num.is_zero() -> return Err("rational division by zero")
        Rational.from_bigints(self.num.mul(rhs.den), self.den.mul(rhs.num))
    }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:654
    pub fn neg(self) -> Rational Never! { Rational{num: self.num.neg(), den: self.den} }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:660
    pub fn abs(self) -> Rational Never! { Rational{num: self.num.abs(), den: self.den} }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:666
    pub fn max_zero(self) -> Rational Never! { if self.num.is_negative() -> Rational.zero() else -> self }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:673
    pub fn to_json(self) -> CanonicalJSON Never! {
        CanonicalJSON.Object([CanonicalJSONField]{CanonicalJSONField{key: "den", value: CanonicalJSON.Integer(self.den.to_string())}, CanonicalJSONField{key: "num", value: CanonicalJSON.Integer(self.num.to_string())}})
    }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:683
    pub fn cmp(self, rhs: Rational) -> Ordering Never! { self.num.mul(rhs.den).cmp(rhs.num.mul(self.den)) }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:688
    pub fn partial_cmp(self, rhs: Rational) -> Ordering? Never! { Val(self.cmp(rhs)) }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:695
    pub fn to_string(self) -> String Never! {
        if self.den == BigInt.one() -> self.num.to_string() else -> "{self.num.to_string()}/{self.den.to_string()}"
    }
}

// Rust: crates/jet-foundation/src/PerformanceBudget.rs:704
pub struct Statistics { pub p50: Rational pub p90: Rational pub p95: Rational pub p99: Rational pub p999: Rational pub mean: Rational pub mad: Rational }
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:714
pub fn statistics(samples: [Rational]) -> Statistics Err! {
    if samples.is_empty() -> return Err("statistics require at least one sample")
    sorted := samples
    &sorted.sort_by((a, b) -> a.cmp(b))
    p50 :: nearest_rank(sorted, 500, 1000)
    sum := Rational.zero()
    loop sample in sorted -> sum = sum.add(sample)
    mean :: sum.div(Rational.integer(I128{sorted.len()}))
    deviations := [Rational]{}
    loop sample in sorted -> &deviations.push(sample.sub(p50).abs())
    &deviations.sort_by((a, b) -> a.cmp(b))
    Ok(Statistics{p50: p50, p90: nearest_rank(sorted, 900, 1000), p95: nearest_rank(sorted, 950, 1000), p99: nearest_rank(sorted, 990, 1000), p999: nearest_rank(sorted, 999, 1000), mean: mean, mad: nearest_rank(deviations, 500, 1000)})
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:742
fn nearest_rank(sorted: [Rational], numerator: Int, denominator: Int) -> Rational Err! {
    if sorted.is_empty() -> return Err("rank requires at least one value")
    product :: sorted.len().checked_mul(numerator) ?? return Err("rank overflow")
    rank :: product.div_ceil(denominator)
    Ok(sorted[max(1, rank) - 1])
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:758
pub enum Percentile { P50 P90 P95 P99 P999 }
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:766
pub fn estimator(samples: [Rational], percentile: Percentile?) -> Rational Err! {
    if samples.len() == 1 && percentile == None -> return Ok(samples[0])
    stats :: statistics(samples)
    Ok(if (percentile ?? Percentile.P50) == { .P50 -> stats.p50 .P90 -> stats.p90 .P95 -> stats.p95 .P99 -> stats.p99 .P999 -> stats.p999 })
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:780
pub enum Direction { LowerIsBetter HigherIsBetter }
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:785
pub enum LimitDirection { AtMost AtLeast }
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:790
pub enum RelativeGoal { RegressionAtMost ImprovementAtLeast }
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:795
pub enum Evidence { Pass Regression Inconclusive Unavailable }
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:802
pub enum Enforcement { Warn Fail }
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:807
pub enum PolicyOutcome { Pass Warn Fail }
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:814
pub enum Comparison {
    Absolute(limit: Rational, direction: LimitDirection)
    AbsoluteFrom(limit: Rational, direction: LimitDirection)
    RelativeTo(limit_basis_points: BigInt, goal: RelativeGoal)
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:831
pub struct MeasurementPolicy { pub bootstrap_resamples: Int pub lower_rank: Int pub upper_rank: Int }
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:838
pub struct Evaluation { pub point: Rational pub lower95: Rational? pub upper95: Rational? pub evidence: Evidence pub outcome: PolicyOutcome pub bootstrap: [Rational] }
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:848
pub fn evaluate(evidence_id: String, context_key: String, baseline_report_ids: [String], candidate: [Rational], baseline: [Rational], percentile: Percentile?, comparison: Comparison, direction: Direction, enforcement: Enforcement, policy: MeasurementPolicy?) -> Evaluation Err! {
    if candidate.is_empty() -> return Err("candidate samples are empty")
    candidate_point :: estimator(candidate, percentile)
    point :: if comparison == {
        .Absolute(limit, limit_direction) -> {
            pass :: if limit_direction == LimitDirection.AtMost -> candidate_point.cmp(limit) != Ordering.Greater else -> candidate_point.cmp(limit) != Ordering.Less
            return Ok(finish(candidate_point, None, None, if pass -> Evidence.Pass else -> Evidence.Regression, enforcement, []))
        }
        .AbsoluteFrom(limit, limit_direction) -> {
            value :: if limit_direction == LimitDirection.AtMost -> candidate_point.sub(limit) else -> limit.sub(candidate_point)
            _ :: policy ?? return Err("AbsoluteFrom requires a measurement policy")
            value
        }
        .RelativeTo(limit_basis_points, goal) -> {
            if baseline.is_empty() -> return Err("RelativeTo baseline samples are empty")
            baseline_point :: estimator(baseline, percentile)
            if baseline_point == Rational.zero() -> return Ok(finish(Rational.zero(), None, None, Evidence.Unavailable, enforcement, []))
            value :: relative_stat(candidate_point, baseline_point, limit_basis_points, goal, direction)
            _ :: policy ?? return Err("RelativeTo requires a measurement policy")
            value
        }
    }
    selected :: policy ?? panic("statistical branches require policy")
    bootstrap :: bootstrap_values(evidence_id, context_key, baseline_report_ids, candidate, if comparison == .AbsoluteFrom(_, _) -> [] else -> baseline, percentile, comparison, direction, selected)
    if selected.lower_rank == 0 || selected.upper_rank == 0 || selected.lower_rank > bootstrap.len() || selected.upper_rank > bootstrap.len() -> return Err("bootstrap ranks are outside the replicate set")
    lower :: bootstrap[selected.lower_rank - 1]
    upper :: bootstrap[selected.upper_rank - 1]
    evidence :: if upper.cmp(Rational.zero()) != Ordering.Greater -> Evidence.Pass else if lower.cmp(Rational.zero()) == Ordering.Greater -> Evidence.Regression else -> Evidence.Inconclusive
    Ok(finish(point, Val(lower), Val(upper), evidence, enforcement, bootstrap))
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:972
fn finish(point: Rational, lower95: Rational?, upper95: Rational?, evidence: Evidence, enforcement: Enforcement, bootstrap: [Rational]) -> Evaluation Never! {
    outcome :: if evidence == Evidence.Pass -> PolicyOutcome.Pass else if enforcement == Enforcement.Warn -> PolicyOutcome.Warn else -> PolicyOutcome.Fail
    Evaluation{point: point, lower95: lower95, upper95: upper95, evidence: evidence, outcome: outcome, bootstrap: bootstrap}
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:996
fn bootstrap_values(evidence_id: String, context_key: String, baseline_report_ids: [String], candidate: [Rational], baseline: [Rational], percentile: Percentile?, comparison: Comparison, direction: Direction, policy: MeasurementPolicy) -> [Rational] Err! {
    if policy.bootstrap_resamples == 0 -> return Err("bootstrap requires at least one replicate")
    values := [Rational]{}
    loop replicate in 0..<policy.bootstrap_resamples {
        stream := ShaStream.new(evidence_id, context_key, baseline_report_ids, U64{replicate})
        candidate_resample :: resample(candidate, candidate.len(), &stream)
        candidate_estimator :: estimator(candidate_resample, percentile)
        value :: if comparison == {
            .AbsoluteFrom(limit, limit_direction) -> if limit_direction == LimitDirection.AtMost -> candidate_estimator.sub(limit) else -> limit.sub(candidate_estimator)
            .RelativeTo(limit_basis_points, goal) -> {
                baseline_resample :: resample(baseline, baseline.len(), &stream)
                baseline_estimator :: estimator(baseline_resample, percentile)
                if baseline_estimator == Rational.zero() -> return Err("RelativeTo bootstrap baseline estimator is zero")
                relative_stat(candidate_estimator, baseline_estimator, limit_basis_points, goal, direction)
            }
            .Absolute(_, _) -> return Err("Absolute does not bootstrap")
        }
        &values.push(value)
    }
    &values.sort_by((a, b) -> a.cmp(b))
    Ok(values)
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1050
fn relative_stat(candidate: Rational, baseline: Rational, limit_basis_points: BigInt, goal: RelativeGoal, direction: Direction) -> Rational Err! {
    forward :: (goal == RelativeGoal.RegressionAtMost && direction == Direction.LowerIsBetter) || (goal == RelativeGoal.ImprovementAtLeast && direction == Direction.HigherIsBetter)
    delta :: (if forward -> candidate.sub(baseline) else -> baseline.sub(candidate)).max_zero()
    basis_points :: delta.mul(Rational.integer(10000)).div(baseline)
    limit :: Rational.from_bigints(limit_basis_points, BigInt.one())
    if goal == RelativeGoal.RegressionAtMost -> basis_points.sub(limit) else -> limit.sub(basis_points)
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1075
let BOOTSTRAP_DOMAIN: String = "jet.performance-budget.bootstrap.v1" + TEXT_NUL
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1076
struct ShaStream {
    evidence_id: String
    context_key: String
    baseline_ids: [String]
    replicate: U64
    block: U64
    words: [U64]
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:1085
    fn new(evidence_id: String, context_key: String, baseline_ids: [String], replicate: U64) -> ShaStream Never! {
        ShaStream{evidence_id: evidence_id, context_key: context_key, baseline_ids: baseline_ids, replicate: replicate, block: 0, words: []}
    }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:1100
    fn word(&self) -> U64 Never! {
        if self.words.is_empty() {
            input := BOOTSTRAP_DOMAIN.bytes()
            &input.extend(self.evidence_id.bytes())
            &input.extend(self.context_key.bytes())
            loop id in self.baseline_ids -> &input.extend(id.bytes())
            &input.extend(self.replicate.to_be_bytes())
            &input.extend(self.block.to_be_bytes())
            self.block += 1
            digest :: mir_sha256_bytes(input)
            chunk := 4
            loop chunk > 0 {
                chunk -= 1
                value := U64{0}
                loop i in (chunk * 8)..<(chunk * 8 + 8) -> value = (value << 8) | U64{digest[i]}
                &self.words.push(value)
            }
        }
        &self.words.pop() ?? panic("digest contains four words")
    }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:1120
    fn index(&self, population: Int) -> Int Err! {
        if population == 0 -> return Err("cannot sample an empty population")
        k :: U64{population}
        threshold :: ((U128{U64.MAX} + 1) / U128{k}) * U128{k}
        loop { word :: &self.word(); if U128{word} < threshold -> return Ok(Int{word % k}) }
    }
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1134
fn resample(values: [Rational], count: Int, stream: &ShaStream) -> [Rational] Err! {
    out := [Rational]{}
    loop _ in 0..<count -> &out.push(values[&stream.index(values.len())])
    Ok(out)
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1149
pub struct Trend { pub report_ids: [String] pub estimators: [Rational] pub score: Rational? pub label: TrendLabel }
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1156
pub enum TrendLabel { Improving Stable Regressing Insufficient }
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1162
pub fn trend(report_ids: [String], estimators: [Rational], direction: Direction) -> Trend Err! {
    if report_ids.len() != estimators.len() -> return Err("trend ids and estimators differ in length")
    if estimators.len() < 3 -> return Ok(Trend{report_ids: report_ids, estimators: estimators, score: None, label: TrendLabel.Insufficient})
    slopes := [Rational]{}
    loop left in 0..<estimators.len() {
        loop right in (left + 1)..<estimators.len() {
            numerator :: if direction == Direction.LowerIsBetter -> estimators[left].sub(estimators[right]) else -> estimators[right].sub(estimators[left])
            &slopes.push(numerator.div(Rational.integer(I128{right - left})))
        }
    }
    &slopes.sort_by((a, b) -> a.cmp(b))
    score :: nearest_rank(slopes, 500, 1000)
    label :: if score.cmp(Rational.zero()) == Ordering.Greater -> TrendLabel.Improving else if score.cmp(Rational.zero()) == Ordering.Less -> TrendLabel.Regressing else -> TrendLabel.Stable
    Ok(Trend{report_ids: report_ids, estimators: estimators, score: Val(score), label: label})
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1205
pub fn stable_id(content: CanonicalJSON) -> String Never! { canonical_json_sha256(content) }
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1208
pub fn verify_stable_id(content: CanonicalJSON, claimed: String) Err! {
    actual :: stable_id(content)
    if actual != claimed -> return Err("content hash mismatch: claimed {claimed}, recomputed {actual}")
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1219
pub fn budget_report(content: CanonicalJSON) -> CanonicalJSON Never! {
    report_id :: stable_id(content)
    CanonicalJSON.Object([CanonicalJSONField]{
        CanonicalJSONField{key: "content", value: content},
        CanonicalJSONField{key: "report_id", value: CanonicalJSON.String(report_id)},
        CanonicalJSONField{key: "schema", value: CanonicalJSON.String("jet.budget-report")},
        CanonicalJSONField{key: "version", value: CanonicalJSON.Integer("1")},
    })
}

// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1233
pub fn verify_budget_report(bytes: [U8]) -> CanonicalJSON Err! {
    report :: if canonical_json_parse(bytes) == { .Ok(v) -> v .Err(e) -> return Err(e.message) }
    fields :: budget_json_fields(report, "budget report wrapper")
    expected :: [String]{"content", "report_id", "schema", "version"}
    if fields.len() != expected.len() || !expected.all(key -> fields.has_key(key)) -> return Err("budget report wrapper has missing or unknown keys")
    if fields.get("schema") != Val(CanonicalJSON.String("jet.budget-report")) || fields.get("version") != Val(CanonicalJSON.Integer("1")) -> return Err("unsupported budget report schema/version")
    content :: fields["content"]
    validate_report_content(content)
    claimed :: if fields["report_id"] == { .String(id) -> id else -> return Err("budget report_id is not text") }
    if claimed.len() != 64 || !claimed.bytes().all(byte -> byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase()) -> return Err("budget report_id is not lowercase Hex64")
    verify_stable_id(content, claimed)
    Ok(report)
}

// CanonicalJSON owns sorted field arrays; validators use a linear indexed
// projection so repeated key reads never become a quadratic field scan.
fn budget_json_fields(value: CanonicalJSON, name: String) -> [String:CanonicalJSON] Err! {
    fields :: if value == { .Object(v) -> v else -> return Err("{name} is not an object") }
    out := [String:CanonicalJSON]{}
    loop field in fields -> &out.set(field.key, field.value)
    Ok(out)
}
fn budget_json_from_fields(fields: [String:CanonicalJSON]) -> CanonicalJSON Never! {
    keys := fields.keys().to_list()
    &keys.sort()
    CanonicalJSON.Object(keys.map(key -> CanonicalJSONField{key: key, value: fields[key]}))
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1265
fn object(value: CanonicalJSON, name: String, keys: [String]) -> [String:CanonicalJSON] Err! {
    fields :: budget_json_fields(value, name)
    if fields.len() != keys.len() || !keys.all(key -> fields.has_key(key)) -> return Err("{name} has missing or unknown fields")
    Ok(fields)
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1279
fn text(value: CanonicalJSON, name: String) -> String Err! {
    if value == { .String(v) -> Ok(v) else -> Err("{name} is not text") }
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1285
fn integer(value: CanonicalJSON, name: String) -> BigInt Err! {
    if value == {
        .Integer(v) -> if BigInt.parse(v) == { .Ok(n) -> Ok(n) .Err(_) -> Err("{name} is not a canonical integer") }
        else -> Err("{name} is not an integer")
    }
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1293
fn unsigned(value: CanonicalJSON, name: String) -> BigInt Err! {
    v :: integer(value, name)
    if v.is_negative() -> return Err("{name} is negative")
    Ok(v)
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1301
fn boolean(value: CanonicalJSON, name: String) -> Bool Err! {
    if value == { .Bool(v) -> Ok(v) else -> Err("{name} is not boolean") }
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1307
fn array(value: CanonicalJSON, name: String) -> [CanonicalJSON] Err! {
    if value == { .Array(v) -> Ok(v) else -> Err("{name} is not an array") }
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1313
fn hex64(value: CanonicalJSON, name: String) -> String Err! {
    v :: text(value, name)
    if v.len() != 64 || !v.bytes().all(b -> b.is_ascii_hexdigit() && !b.is_ascii_uppercase()) -> return Err("{name} is not lowercase Hex64")
    Ok(v)
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1324
fn nullable(value: CanonicalJSON, validate: fn(CanonicalJSON) Err!) Err! {
    if value != CanonicalJSON.Null -> validate(value)
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1334
fn one_of(value: CanonicalJSON, name: String, allowed: [String]) Err! {
    v :: text(value, name)
    if !allowed.contains(v) -> return Err("{name} has unknown value `{v}`")
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1343
fn validate_rational(value: CanonicalJSON, quantity: Bool, name: String) -> Rational Err! {
    f :: object(value, name, ["num", "den"])
    n :: integer(f["num"], "{name}.num")
    d :: integer(f["den"], "{name}.den")
    if d.is_zero() || d.is_negative() -> return Err("{name}.den must be positive")
    if quantity && n.is_negative() -> return Err("{name} quantity is negative")
    reduced :: Rational.from_bigints(n, d)
    if reduced.num != n || reduced.den != d -> return Err("{name} is not gcd-reduced")
    Ok(reduced)
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1363
fn validate_policy(value: CanonicalJSON) Err! {
    f :: object(value, "measurement policy", ["min_candidate_samples", "min_baseline_samples", "baseline_generations", "bootstrap_resamples", "lower_rank", "upper_rank", "stale_after_seconds", "trend_generations"])
    keys := f.keys().to_list()
    &keys.sort()
    loop key in keys -> _ :: unsigned(f[key], "measurement policy.{key}")
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1383
fn validate_statistics(value: CanonicalJSON) Err! {
    f :: object(value, "statistics", ["count", "sorted_samples", "p50", "p90", "p95", "p99", "p999", "mean", "mad"])
    count :: unsigned(f["count"], "statistics.count")
    raw :: array(f["sorted_samples"], "statistics.sorted_samples")
    samples := [Rational]{}
    loop sample in raw -> &samples.push(validate_rational(sample, true, "statistics sample"))
    loop i in 1..<samples.len() { if samples[i - 1].cmp(samples[i]) == Ordering.Greater -> return Err("statistics.sorted_samples is not sorted") }
    if count.to_string() != "{samples.len()}" -> return Err("statistics.count does not match sorted_samples")
    actual :: statistics(samples)
    loop (key, want) in [(String, Rational)]{("p50", actual.p50), ("p90", actual.p90), ("p95", actual.p95), ("p99", actual.p99), ("p999", actual.p999), ("mean", actual.mean), ("mad", actual.mad)} {
        if validate_rational(f[key], true, "statistics.{key}") != want -> return Err("statistics.{key} does not match independent recomputation")
    }
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1429
fn validate_history(value: CanonicalJSON) Err! {
    f :: object(value, "history selection", ["state_id", "report_ids"])
    _ :: hex64(f["state_id"], "history.state_id")
    loop id in array(f["report_ids"], "history.report_ids") -> _ :: hex64(id, "history report id")
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1437
fn validate_baseline(value: CanonicalJSON) Err! {
    f :: object(value, "statistical baseline", ["history", "pooled_samples", "statistics", "policy"])
    validate_history(f["history"])
    loop q in array(f["pooled_samples"], "baseline.pooled_samples") -> _ :: validate_rational(q, true, "baseline sample")
    validate_statistics(f["statistics"])
    validate_policy(f["policy"])
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1450
fn validate_trend(value: CanonicalJSON) Err! {
    f :: object(value, "trend", ["label", "report_ids", "estimators", "score"])
    one_of(f["label"], "trend.label", ["improving", "stable", "regressing", "insufficient"])
    ids :: array(f["report_ids"], "trend.report_ids")
    loop id in ids -> _ :: hex64(id, "trend report id")
    estimators :: array(f["estimators"], "trend.estimators")
    if ids.len() != estimators.len() -> return Err("trend inputs are not index-aligned")
    loop q in estimators -> _ :: validate_rational(q, true, "trend estimator")
    nullable(f["score"], (v) -> { _ :: validate_rational(v, false, "trend.score") })
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1476
fn validate_decision(value: CanonicalJSON) Err! {
    f :: object(value, "decision", ["evidence", "reason", "point", "lower95", "upper95", "trend", "policy_outcome"])
    one_of(f["evidence"], "decision.evidence", ["pass", "regression", "inconclusive", "unavailable"])
    nullable(f["reason"], (v) -> { _ :: text(v, "decision.reason") })
    nullable(f["point"], (v) -> { _ :: validate_rational(v, false, "decision.point") })
    nullable(f["lower95"], (v) -> { _ :: validate_rational(v, false, "decision.lower95") })
    nullable(f["upper95"], (v) -> { _ :: validate_rational(v, false, "decision.upper95") })
    validate_trend(f["trend"])
    one_of(f["policy_outcome"], "decision.policy_outcome", ["pass", "warn", "fail"])
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1512
fn validate_metric(value: CanonicalJSON) Err! {
    f :: object(value, "metric", ["name", "percentile"])
    _ :: text(f["name"], "metric.name")
    nullable(f["percentile"], (v) -> one_of(v, "metric.percentile", ["p50", "p90", "p95", "p99", "p999"]))
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1523
fn validate_provider(value: CanonicalJSON) Err! {
    f :: object(value, "provider", ["kind", "identity", "version", "isolation", "cpu_arch", "cpu_model", "logical_cpus", "memory_bytes", "os", "kernel", "power_governor", "hardware_fingerprint"])
    loop key in [String]{"kind", "identity", "version", "isolation", "cpu_arch", "cpu_model", "os", "kernel", "power_governor"} -> _ :: text(f[key], "provider.{key}")
    _ :: unsigned(f["logical_cpus"], "provider.logical_cpus")
    _ :: unsigned(f["memory_bytes"], "provider.memory_bytes")
    _ :: hex64(f["hardware_fingerprint"], "provider.hardware_fingerprint")
    unhashed := f
    _ :: &unhashed.remove("hardware_fingerprint", .Slot)
    if verify_stable_id(budget_json_from_fields(unhashed), text(f["hardware_fingerprint"], "provider.hardware_fingerprint")) == { .Err(_) -> return Err("provider hardware_fingerprint mismatch") .Ok(_) -> {} }
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1566
fn validate_comparison(value: CanonicalJSON) Err! {
    fields :: budget_json_fields(value, "comparison")
    kind :: text(fields.get("kind") ?? return Err("comparison missing kind"), "comparison.kind")
    if kind == {
        "absolute" -> {
            f :: object(value, "absolute comparison", ["kind", "limit", "direction"])
            _ :: validate_rational(f["limit"], true, "comparison.limit")
            one_of(f["direction"], "comparison.direction", ["at_most", "at_least"])
        }
        "absolute_from" -> {
            f :: object(value, "absolute_from comparison", ["kind", "baseline", "limit", "direction"])
            _ :: text(f["baseline"], "comparison.baseline")
            _ :: validate_rational(f["limit"], true, "comparison.limit")
            one_of(f["direction"], "comparison.direction", ["at_most", "at_least"])
        }
        "relative_to" -> {
            f :: object(value, "relative_to comparison", ["kind", "baseline", "limit_basis_points", "goal", "direction"])
            _ :: text(f["baseline"], "comparison.baseline")
            _ :: unsigned(f["limit_basis_points"], "comparison.limit_basis_points")
            one_of(f["goal"], "comparison.goal", ["regression_at_most", "improvement_at_least"])
            one_of(f["direction"], "comparison.direction", ["lower_is_better", "higher_is_better"])
        }
        else -> return Err("comparison has unknown kind `{kind}`")
    }
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1631
fn validate_measurement(value: CanonicalJSON) Err! {
    fields :: budget_json_fields(value, "measurement")
    required :: [String]{"budget_id", "budget_spec", "budget_spec_sha256", "source", "metric", "target_class", "unit", "direction", "provider", "comparison", "enforcement", "context_key", "policy", "samples", "statistics", "history", "baseline", "decision"}
    has_compile :: fields.has_key("compile")
    if fields.len() != required.len() + (if has_compile -> 1 else -> 0) || !required.all(key -> fields.has_key(key)) || fields.keys().any(key -> key != "compile" && !required.contains(key)) -> return Err("measurement has missing or unknown fields")
    _ :: text(fields["budget_id"], "measurement.budget_id")
    if fields["budget_spec"] != .Object(_) -> return Err("measurement.budget_spec is not an object")
    _ :: hex64(fields["budget_spec_sha256"], "measurement.budget_spec_sha256")
    if verify_stable_id(fields["budget_spec"], text(fields["budget_spec_sha256"], "measurement.budget_spec_sha256")) == { .Err(_) -> return Err("measurement budget_spec_sha256 mismatch") .Ok(_) -> {} }
    _ :: text(fields["source"], "measurement.source")
    validate_metric(fields["metric"])
    _ :: text(fields["target_class"], "measurement.target_class")
    _ :: text(fields["unit"], "measurement.unit")
    one_of(fields["direction"], "measurement.direction", ["lower_is_better", "higher_is_better"])
    validate_provider(fields["provider"])
    validate_comparison(fields["comparison"])
    one_of(fields["enforcement"], "measurement.enforcement", ["warn", "fail"])
    _ :: hex64(fields["context_key"], "measurement.context_key")
    nullable(fields["policy"], validate_policy)
    loop q in array(fields["samples"], "measurement.samples") -> _ :: validate_rational(q, true, "measurement sample")
    nullable(fields["statistics"], validate_statistics)
    nullable(fields["history"], validate_history)
    nullable(fields["baseline"], validate_baseline)
    nullable(fields["decision"], validate_decision)
    provider :: budget_json_fields(fields["provider"], "provider")
    provider_kind :: text(provider["kind"], "provider.kind")
    if has_compile {
        metric :: budget_json_fields(fields["metric"], "metric")
        if text(metric["name"], "metric.name") != "CompileTime" || provider_kind != "CompilerProbe" || fields["unit"] != CanonicalJSON.String("Duration") || metric["percentile"] == CanonicalJSON.Null -> return Err("compile metadata requires the CompilerProbe provider, CompileTime percentile, and Duration unit")
        validate_compile_metadata(fields["compile"], fields["samples"])
    } else if provider_kind == "CompilerProbe" -> return Err("CompilerProbe measurement has no compile metadata")
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1732
fn validate_compile_metadata(value: CanonicalJSON, measurement_samples: CanonicalJSON) Err! {
    fields :: object(value, "compile metadata", ["backend", "cache_state", "clock", "compiler_digest", "core_digest", "edit_bytes", "edit_sha256", "host", "linker", "peak_rss_bytes", "phase_totals", "profile", "sample_records", "samples", "source_tree_sha256", "target", "variance", "warmups", "workload_bytes"])
    _ :: text(fields["backend"], "compile.backend")
    one_of(fields["cache_state"], "compile.cache_state", ["Clean", "NoChange", "Edit"])
    one_of(fields["clock"], "compile.clock", ["process_cpu"])
    _ :: hex64(fields["compiler_digest"], "compile.compiler_digest")
    _ :: hex64(fields["core_digest"], "compile.core_digest")
    _ :: unsigned(fields["edit_bytes"], "compile.edit_bytes")
    _ :: hex64(fields["edit_sha256"], "compile.edit_sha256")
    _ :: text(fields["host"], "compile.host")
    _ :: text(fields["linker"], "compile.linker")
    _ :: unsigned(fields["peak_rss_bytes"], "compile.peak_rss_bytes")
    _ :: text(fields["profile"], "compile.profile")
    _ :: hex64(fields["source_tree_sha256"], "compile.source_tree_sha256")
    _ :: text(fields["target"], "compile.target")
    loop (key, name) in [(String, String)]{("backend", "compile.backend"), ("host", "compile.host"), ("linker", "compile.linker"), ("profile", "compile.profile"), ("target", "compile.target")} {
        if text(fields[key], name).is_empty() -> return Err("{name} is empty")
    }
    samples :: usize_wire(fields["samples"], "compile.samples")
    warmups :: usize_wire(fields["warmups"], "compile.warmups")
    if samples != 20 || warmups != 1 -> return Err("compile metadata does not use the pinned warmup/sample policy")
    records :: array(fields["sample_records"], "compile.sample_records")
    if records.len() != samples -> return Err("compile.sample_records count does not match compile.samples")
    elapsed := [Rational]{}
    aggregate := [String:BigInt]{}
    peak_rss_bytes := BigInt.zero()
    loop record in records -> validate_compile_record(record, fields, &aggregate, &elapsed, &peak_rss_bytes)
    if peak_rss_bytes != unsigned(fields["peak_rss_bytes"], "compile.peak_rss_bytes") -> return Err("compile.peak_rss_bytes does not equal the maximum per-sample peak RSS")
    measured_samples :: array(measurement_samples, "measurement.samples")
    if measured_samples.len() != elapsed.len() -> return Err("measurement.samples count does not match compile.sample_records")
    loop (index, sample) in measured_samples {
        if validate_rational(sample, true, "measurement.samples[{index}]") != elapsed[index] -> return Err("measurement.samples does not match compile.sample_records")
    }
    root_phases :: validate_phase_totals(fields["phase_totals"], "compile.phase_totals")
    if root_phases != aggregate -> return Err("compile.phase_totals does not equal the per-sample phase totals")
    sum := Rational.zero()
    loop value in elapsed -> sum = sum.add(value)
    mean :: sum.div(Rational.integer(I128{elapsed.len()}))
    squares := Rational.zero()
    loop value in elapsed { delta :: value.sub(mean); squares = squares.add(delta.mul(delta)) }
    variance :: squares.div(Rational.integer(I128{elapsed.len()}))
    if validate_rational(fields["variance"], true, "compile.variance") != variance -> return Err("compile.variance does not match elapsed samples")
}
