pub struct BigInt {
    sign: Int
    limbs: [U32]
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:282
    pub fn zero() -> BigInt Never! { BigInt{sign: 0, limbs: []} }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:288
    pub fn one() -> BigInt Never! { BigInt.from_i128(1) }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:291
    pub fn from_i128(value: I128) -> BigInt Never! {
        if BigInt.parse("{value}") == { .Ok(v) -> v .Err(_) -> panic("i128 decimal is canonical") }
    }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:294
    pub fn parse(text: String) -> BigInt Err! {
        if !canonical_json_valid_integer(text) -> return Err("non-canonical integer `{text}`")
        negative :: text.starts_with("-")
        digits :: if negative -> text[1..] else -> text
        if digits == "0" -> return Ok(BigInt.zero())
        limbs := [U32]{}
        end := digits.len()
        loop end != 0 {
            start :: max(0, end - 9)
            limb :: U32.parse(digits[start..<end]) ?? return Err("invalid integer")
            &limbs.push(limb)
            end = start
        }
        Ok(BigInt{sign: if negative -> -1 else -> 1, limbs: limbs})
    }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:318
    pub fn parse_source(text: String) -> BigInt Err! {
        negative :: text.starts_with("-")
        unsigned :: if negative -> text[1..] else -> text
        radix :: if unsigned.starts_with("0x") -> 16 else if unsigned.starts_with("0o") -> 8 else if unsigned.starts_with("0b") -> 2 else -> 10
        digits :: if radix == 10 -> unsigned else -> unsigned[2..]
        value := BigInt.zero()
        saw_digit := false
        loop ch in digits.chars() {
            if ch == DIGIT_SEPARATOR -> next
            digit :: ch.to_digit(radix) ?? return Err("invalid base-{radix} integer `{text}`")
            value = value.mul_small(U32{radix}).add(BigInt.from_i128(I128{digit}))
            saw_digit = true
        }
        if !saw_digit -> return Err("invalid integer `{text}`")
        Ok(if negative -> value.neg() else -> value)
    }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:351
    pub fn is_zero(self) -> Bool Never! { self.sign == 0 }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:354
    pub fn is_negative(self) -> Bool Never! { self.sign < 0 }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:357
    pub fn abs(self) -> BigInt Never! { out := self; if out.sign < 0 -> out.sign = 1; out }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:364
    pub fn neg(self) -> BigInt Never! { out := self; out.sign = -out.sign; out }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:369
    fn normalize(&self) Never! {
        loop self.limbs.last() == Val(U32{0}) -> _ :: &self.limbs.pop()
        if self.limbs.is_empty() -> self.sign = 0
    }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:377
    fn abs_cmp(self, rhs: BigInt) -> Ordering Never! {
        if self.limbs.len() != rhs.limbs.len() -> return self.limbs.len() <=> rhs.limbs.len()
        index := self.limbs.len()
        loop index > 0 {
            index -= 1
            if self.limbs[index] != rhs.limbs[index] -> return self.limbs[index] <=> rhs.limbs[index]
        }
        Ordering.Equal
    }
    // Rust: crates/jet-foundation/src/PerformanceBudget.rs:383
    fn abs_add(self, rhs: BigInt) -> BigInt Never! {
        out := [U32]{}
        carry := U64{0}
        loop i in 0..<max(self.limbs.len(), rhs.limbs.len()) {
            n :: U64{self.limbs.get(i) ?? U32{0}} + U64{rhs.limbs.get(i) ?? U32{0}} + carry
            &out.push(U32{n % 1000000000})
            carry = n / 1000000000
        }
        if carry != 0 -> &out.push(U32{carry})
        BigInt{sign: 1, limbs: out}
    }
