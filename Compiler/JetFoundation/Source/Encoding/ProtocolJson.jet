// JSON.rs::parse_json: the Foundation protocol boundary is 1 MiB and
// 64 containers, with i64 integers. Core owns the parser; this boundary
// validates the narrower protocol domain, as in origin/port/compiler's
// foundation_parse_protocol_json_with_limit, without a second parser.
use core.encoding.json as protocol_json

FOUNDATION_PROTOCOL_JSON_MAX_BYTES :: 1048576

#Error
struct FoundationJSONError {
    message: String
}

// JSON with the provider-facing error text over the protocol domain: the
// 1 MiB ceiling, 64 containers and i64 integers.
fn foundation_json_parse(text: String) -> Dyn FoundationJSONError! {
    if text.bytes().len() > FOUNDATION_PROTOCOL_JSON_MAX_BYTES -> return Err(FoundationJSONError{message: "JSON input exceeds the 1 MiB limit"})
    value :: protocol_json.parse(text) ?? return Err(FoundationJSONError{message: err.reason})
    if foundation_protocol_json_integer_error(value) == .Val(message) -> return Err(FoundationJSONError{message: message})
    if !foundation_protocol_json_valid(value, 0) -> return Err(FoundationJSONError{message: "JSON exceeds maximum nesting depth"})
    Ok(value)
}

fn foundation_parse_protocol_json(text: String) -> Dyn? Never! {
    foundation_parse_protocol_json_with_limit(text, FOUNDATION_PROTOCOL_JSON_MAX_BYTES)
}

// A caller-selected message ceiling: the debug adapter's 16 MiB frames do not
// widen the shared 1 MiB default.
fn foundation_parse_protocol_json_with_limit(text: String, max_bytes: Int) -> Dyn? Never! {
    if text.bytes().len() > max_bytes -> return None
    value :: protocol_json.parse(text) ?? return None
    if !foundation_protocol_json_valid(value, 0) -> return None
    Val(value)
}

// The first integer outside i64, refused as the protocol parser refuses it.
fn foundation_protocol_json_integer_error(value: Dyn) -> String? Never! {
    if value == {
        .Int(number) -> {
            if number < -9223372036854775808 || number > 9223372036854775807 -> return Val("invalid number `{number}`")
        }
        .Array(values) -> {
            loop child in values {
                error :: foundation_protocol_json_integer_error(child)
                if error != None -> return error
            }
        }
        .Object(fields) -> {
            loop entry in fields {
                error :: foundation_protocol_json_integer_error(entry.value)
                if error != None -> return error
            }
        }
        else -> {}
    }
    None
}

fn foundation_protocol_json_valid(value: Dyn, depth: Int) -> Bool Never! {
    if value == {
        .Int(number) -> number >= -9223372036854775808 && number <= 9223372036854775807
        .Array(values) -> {
            if depth >= 64 -> return false
            loop child in values {
                if !foundation_protocol_json_valid(child, depth + 1) -> return false
            }
            true
        }
        .Object(fields) -> {
            if depth >= 64 -> return false
            loop entry in fields {
                if !foundation_protocol_json_valid(entry.value, depth + 1) -> return false
            }
            true
        }
        else -> true
    }
}
