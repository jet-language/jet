use JetFoundation.Encoding.CanonicalJson.[CanonicalJSON, CanonicalJSONField, canonical_json_object, canonical_json_bytes]
use JetFoundation.SHA256.sha256_hex

// CanonicalJSON.Object stores sorted fields. Keep lookup logarithmic and borrowed,
// rather than making a second JSON representation or allocating object maps.
fn budget_json_field(fields: View<CanonicalJSONField>, key: String) -> @CanonicalJSON Never! from fields {
    low := 0
    high := fields.len()
    loop low < high {
        mid :: low + (high - low) / 2
        if fields[mid].key < key -> low = mid + 1 else -> high = mid
    }
    if low == fields.len() || fields[low].key != key -> panic("validated budget field is missing: {key}")
    @fields[low].value
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1849
fn validate_compile_record(value: CanonicalJSON, root: View<CanonicalJSONField>, aggregate: &[String:BigInt], elapsed: &[Rational], peak_rss_bytes: &BigInt) Err! {
    _ :: unsigned(budget_json_field(root, "workload_bytes"), "compile.workload_bytes")
    fields :: object(value, "compile sample record", ["backend", "cache_state", "clock", "compiler_digest", "core_digest", "edit_bytes", "elapsed_ns", "host", "linker", "peak_rss_bytes", "phase_totals", "profile", "source_tree_sha256", "target", "workload_bytes"])
    loop key in ["backend", "cache_state", "clock", "compiler_digest", "core_digest", "edit_bytes", "host", "linker", "profile", "source_tree_sha256", "target", "workload_bytes"] {
        if budget_json_field(fields, key) != budget_json_field(root, key) -> return Err("compile sample record `{key}` does not match its row identity")
    }
    _ :: hex64(budget_json_field(fields, "compiler_digest"), "compile sample compiler_digest")
    _ :: hex64(budget_json_field(fields, "core_digest"), "compile sample core_digest")
    _ :: hex64(budget_json_field(fields, "source_tree_sha256"), "compile sample source_tree_sha256")
    ns :: unsigned(budget_json_field(fields, "elapsed_ns"), "compile sample elapsed_ns")
    elapsed.push(Rational.from_bigints(ns.clone(), BigInt.one()))
    rss := unsigned(budget_json_field(fields, "peak_rss_bytes"), "compile sample peak_rss_bytes")
    if rss > peak_rss_bytes -> peak_rss_bytes = ^rss
    phases :: validate_phase_totals(budget_json_field(fields, "phase_totals"), "compile sample phase_totals")
    // BTreeMap order: sort keys once before aggregation.
    keys := phases.keys().collect()
    keys.sort()
    loop name in keys {
        slot :: aggregate.get(name) ?? BigInt.zero()
        aggregate[name] = slot.add(phases[name])
    }
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1918
fn validate_phase_totals(value: CanonicalJSON, name: String) -> [String:BigInt] Err! {
    entries :: array(value, name)
    prior := None as (@String)?
    totals := [String:BigInt]{}
    loop entry in entries {
        fields :: object(entry, "{name} entry", ["name", "ns"])
        phase :: text(budget_json_field(fields, "name"), "{name}.name")
        if phase.is_empty() -> return Err("{name} is not sorted by phase name")
        if prior == .Val(previous) { if previous >= phase -> return Err("{name} is not sorted by phase name") }
        prior = Val(phase)
        ns :: unsigned(budget_json_field(fields, "ns"), "{name}.ns")
        if totals.insert(phase.clone(), ^ns) != None -> return Err("{name} contains a duplicate phase")
    }
    if totals.is_empty() -> return Err("{name} is empty")
    Ok(^totals)
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:1942
fn validate_report_content(value: CanonicalJSON) Err! {
    f :: object(value, "report content", ["subject", "toolchain", "evidence_id", "measurements", "summary", "privacy"])
    subject :: object(budget_json_field(f, "subject"), "subject", ["target_id", "member_sources", "target_triple", "target_class", "profile", "artifact", "measured_start", "measured_end"])
    loop key in ["target_id", "target_triple", "target_class", "profile", "measured_start", "measured_end"] { _ :: text(budget_json_field(subject, key), "subject.{key}") }
    prior := None as (@String, @String)?
    loop source in array(budget_json_field(subject, "member_sources"), "subject.member_sources") {
        sf :: object(source, "member source", ["path", "sha256"])
        path :: text(budget_json_field(sf, "path"), "member source.path")
        hash :: hex64(budget_json_field(sf, "sha256"), "member source.sha256")
        if prior == .Val(p) { if p > (path, hash) -> return Err("member_sources is not sorted") }
        prior = Val((path, hash))
    }
    nullable(budget_json_field(subject, "artifact"), fn(v) {
        a :: object(v, "artifact", ["sha256", "bytes"])
        _ :: hex64(budget_json_field(a, "sha256"), "artifact.sha256")
        _ :: unsigned(budget_json_field(a, "bytes"), "artifact.bytes")
    })
    tool :: object(budget_json_field(f, "toolchain"), "toolchain", ["jet_version", "compiler_build_id", "stdlib_id", "runner_id", "digest"])
    loop key in ["jet_version", "compiler_build_id", "stdlib_id", "runner_id"] { _ :: text(budget_json_field(tool, key), "toolchain.{key}") }
    _ :: hex64(budget_json_field(tool, "digest"), "toolchain.digest")
    digest_fields := [CanonicalJSONField]{}
    loop key in ["jet_version", "compiler_build_id", "stdlib_id", "runner_id"] { digest_fields.push(CanonicalJSONField{key: key, value: budget_json_field(tool, key).clone()}) }
    digest_content :: canonical_json_object(^digest_fields)
    if verify_stable_id(digest_content, text(budget_json_field(tool, "digest"), "toolchain.digest")) == Err(_) -> return Err("toolchain digest mismatch")
    evidence :: hex64(budget_json_field(f, "evidence_id"), "evidence_id")
    measurements :: array(budget_json_field(f, "measurements"), "measurements")
    order := None as (@String, @String)?
    loop measurement in measurements {
        validate_measurement(measurement)
        if measurement == .Object(mf) {
            fields :: mf.view(0..<mf.len())
            key :: (text(budget_json_field(fields, "budget_id"), "budget_id"), text(budget_json_field(fields, "source"), "source"))
            if order == .Val(p) { if p > key -> return Err("measurements is not sorted by budget_id then source") }
            order = Val(key)
            validate_context_key(subject, tool, fields)
            verify_wire_evaluation(evidence, fields)
        } else -> panic("validated measurement is an object")
    }
    sanitized_measurements := [CanonicalJSON]{}
    loop measurement in measurements { sanitized_measurements.push(sanitize_measurement(measurement)) }
    sanitized :: canonical_json_object([
        CanonicalJSONField{key: "measurements", value: .Array(^sanitized_measurements)},
        CanonicalJSONField{key: "subject", value: budget_json_field(f, "subject").clone()},
        CanonicalJSONField{key: "toolchain", value: budget_json_field(f, "toolchain").clone()}])
    if verify_stable_id(sanitized, evidence) == Err(_) -> return Err("evidence_id mismatch")
    summary :: object(budget_json_field(f, "summary"), "summary", ["outcome", "pass", "warn", "fail"])
    _ :: one_of(budget_json_field(summary, "outcome"), "summary.outcome", ["pass", "warn", "fail"])
    loop key in ["pass", "warn", "fail"] { _ :: unsigned(budget_json_field(summary, key), "summary.{key}") }
    privacy :: object(budget_json_field(f, "privacy"), "privacy", ["schema", "workspace_paths_only", "retained", "excluded"])
    if budget_json_field(privacy, "schema") != CanonicalJSON.Integer("1") || !boolean(budget_json_field(privacy, "workspace_paths_only"), "privacy.workspace_paths_only") -> return Err("unsupported privacy schema/policy")
    loop key in ["retained", "excluded"] {
        vals :: array(budget_json_field(privacy, key), "privacy.{key}")
        previous := None as (@String)?
        loop v in vals {
            current :: text(v, "privacy.{key} item")
            if previous == .Val(p) { if p > current -> return Err("privacy.{key} is not sorted") }
            previous = Val(current)
        }
    }
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:2091
fn sanitize_measurement(value: CanonicalJSON) -> CanonicalJSON Err! {
    if value == .Object(v) {
        fields := v.clone()
        loop key in ["history", "baseline", "decision"] {
            low := 0
            high := fields.len()
            loop low < high {
                mid :: low + (high - low) / 2
                if fields[mid].key < key -> low = mid + 1 else -> high = mid
            }
            if low < fields.len() && fields[low].key == key -> fields[low].value = .Null
            else -> fields.insert(low, CanonicalJSONField{key: key, value: .Null})
        }
        return Ok(.Object(^fields))
    }
    Err("measurement is not object")
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:2101
fn frame(input: &[U8], value: String) Never! { input.extend_from_slice((value.len() as U64).to_be_bytes()); input.extend_from_slice(value.bytes()) }
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:2105
fn wire_text(value: CanonicalJSON) -> String Never! {
    if value == {
        .String(v) | .Integer(v) -> v.clone()
        .Null -> String.new()
        else -> { encoded :: String.from_bytes(canonical_json_bytes(value)) ?? panic("canonical JSON UTF-8"); trimmed := encoded.trim_end() // #4303
            trimmed.to_string() }
    }
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:2115
fn validate_context_key(subject: View<CanonicalJSONField>, tool: View<CanonicalJSONField>, measurement: View<CanonicalJSONField>) Err! {
    metric_value :: budget_json_field(measurement, "metric")
    provider_value :: budget_json_field(measurement, "provider")
    if metric_value == .Object(metric) {
        if provider_value == .Object(provider) {
            mf :: metric.view(0..<metric.len())
            pf :: provider.view(0..<provider.len())
            input := "jet-budget-context-v1".bytes().to_list()
            input.push(U8{0}) // Rust byte NUL, not a Jet text escape.
            loop value in [budget_json_field(subject, "target_id"), budget_json_field(mf, "name"), budget_json_field(mf, "percentile"), budget_json_field(measurement, "target_class"), budget_json_field(subject, "target_triple"), budget_json_field(subject, "profile")] { frame(&input, wire_text(value)) }
            loop key in ["jet_version", "compiler_build_id", "stdlib_id", "runner_id", "digest"] { frame(&input, wire_text(budget_json_field(tool, key))) }
            loop key in ["kind", "identity", "version", "isolation", "cpu_arch", "cpu_model", "logical_cpus", "memory_bytes", "os", "kernel", "power_governor", "hardware_fingerprint"] { frame(&input, wire_text(budget_json_field(pf, key))) }
            actual :: sha256_hex(input)
            if text(budget_json_field(measurement, "context_key"), "context_key") != actual -> return Err("measurement context_key mismatch")
            return
        }
        return Err("provider is not object")
    }
    Err("metric is not object")
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:2171
fn usize_wire(value: CanonicalJSON, name: String) -> Int Err! {
    integer :: unsigned(value, name).to_string()
    if Int.parse(integer) == { Ok(result) -> Ok(result), Err(_) -> Err("{name} exceeds implementation resource limit") }
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:2177
fn rational_or_none(value: CanonicalJSON, name: String) -> Rational? Err! { if value == .Null -> Ok(None) else -> Ok(Val(validate_rational(value, false, name))) }
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:2184
fn parse_percentile(value: CanonicalJSON) -> Percentile? Err! {
    if value == {
        .Null -> Ok(None)
        .String(v) -> if v == { "p50" -> Ok(Val(.P50)), "p90" -> Ok(Val(.P90)), "p95" -> Ok(Val(.P95)), "p99" -> Ok(Val(.P99)), "p999" -> Ok(Val(.P999)), else -> Err("unknown percentile") }
        else -> Err("percentile is not text or null")
    }
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:2198
fn parse_direction(value: CanonicalJSON) -> Direction Err! { if text(value, "direction") == { "lower_is_better" -> Ok(.LowerIsBetter), "higher_is_better" -> Ok(.HigherIsBetter), else -> Err("unknown direction") } }
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:2205
fn parse_enforcement(value: CanonicalJSON) -> Enforcement Err! { if text(value, "enforcement") == { "warn" -> Ok(.Warn), "fail" -> Ok(.Fail), else -> Err("unknown enforcement") } }
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:2212
fn parse_comparison(value: CanonicalJSON) -> Comparison Err! {
    if value == .Object(fields) {
        f :: fields.view(0..<fields.len())
        kind :: text(budget_json_field(f, "kind"), "comparison.kind")
        if kind == ("absolute" | "absolute_from") {
            limit :: validate_rational(budget_json_field(f, "limit"), true, "comparison.limit")
            direction :: if text(budget_json_field(f, "direction"), "comparison.direction") == { "at_most" -> LimitDirection.AtMost, "at_least" -> LimitDirection.AtLeast, else -> return Err("unknown limit direction") }
            return Ok(if kind == "absolute" -> .Absolute(limit: ^limit, direction: direction) else -> .AbsoluteFrom(limit: ^limit, direction: direction))
        }
        if kind == "relative_to" {
            limit :: unsigned(budget_json_field(f, "limit_basis_points"), "comparison.limit_basis_points")
            goal :: if text(budget_json_field(f, "goal"), "comparison.goal") == { "regression_at_most" -> RelativeGoal.RegressionAtMost, "improvement_at_least" -> RelativeGoal.ImprovementAtLeast, else -> return Err("unknown relative goal") }
            return Ok(.RelativeTo(limit_basis_points: ^limit, goal: goal))
        }
        return Err("unknown comparison kind")
    }
    Err("comparison is not object")
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:2248
fn parse_policy(value: CanonicalJSON) -> MeasurementPolicy? Err! {
    if value == .Null -> return Ok(None)
    if value == .Object(fields) {
        f :: fields.view(0..<fields.len())
        return Ok(Val(MeasurementPolicy{bootstrap_resamples: usize_wire(budget_json_field(f, "bootstrap_resamples"), "policy.bootstrap_resamples"), lower_rank: usize_wire(budget_json_field(f, "lower_rank"), "policy.lower_rank"), upper_rank: usize_wire(budget_json_field(f, "upper_rank"), "policy.upper_rank")}))
    }
    Err("policy is not object")
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:2262
fn quantities(value: CanonicalJSON, name: String) -> [Rational] Err! { out := [Rational]{}; loop v in array(value, name) { out.push(validate_rational(v, true, name)) }; Ok(^out) }
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:2268
fn history_ids(value: CanonicalJSON) -> [String] Err! {
    if value == .Null -> return Ok([])
    if value == .Object(fields) {
        f :: fields.view(0..<fields.len())
        out := [String]{}
        loop v in array(budget_json_field(f, "report_ids"), "history.report_ids") { out.push(text(v, "history report id").to_string()) }
        return Ok(^out)
    }
    Err("history is not object")
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:2281
fn evidence_enum(value: CanonicalJSON) -> Evidence Err! { if text(value, "decision.evidence") == { "pass" -> Ok(.Pass), "regression" -> Ok(.Regression), "inconclusive" -> Ok(.Inconclusive), "unavailable" -> Ok(.Unavailable), else -> Err("unknown evidence") } }
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:2290
fn outcome_enum(value: CanonicalJSON) -> PolicyOutcome Err! { if text(value, "decision.policy_outcome") == { "pass" -> Ok(.Pass), "warn" -> Ok(.Warn), "fail" -> Ok(.Fail), else -> Err("unknown policy outcome") } }
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:2298
fn trend_label_enum(value: CanonicalJSON) -> TrendLabel Err! { if text(value, "trend.label") == { "improving" -> Ok(.Improving), "stable" -> Ok(.Stable), "regressing" -> Ok(.Regressing), "insufficient" -> Ok(.Insufficient), else -> Err("unknown trend label") } }
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:2307
fn verify_wire_evaluation(evidence_id: String, m: View<CanonicalJSONField>) Err! {
    decision :: budget_json_field(m, "decision")
    if decision == .Null -> return
    if decision == .Object(df) {
        d :: df.view(0..<df.len())
        direction :: parse_direction(budget_json_field(m, "direction"))
        enforcement :: parse_enforcement(budget_json_field(m, "enforcement"))
        comparison :: parse_comparison(budget_json_field(m, "comparison"))
        policy :: parse_policy(budget_json_field(m, "policy"))
        candidate :: quantities(budget_json_field(m, "samples"), "measurement.samples")
        baseline_value :: budget_json_field(m, "baseline")
        (baseline, ids) :: if baseline_value == .Object(b) -> (quantities(budget_json_field(b.view(0..<b.len()), "pooled_samples"), "baseline.pooled_samples"), history_ids(budget_json_field(b.view(0..<b.len()), "history"))) else -> ([Rational]{}, history_ids(budget_json_field(m, "history")))
        stored_evidence :: evidence_enum(budget_json_field(d, "evidence"))
        stored_outcome :: outcome_enum(budget_json_field(d, "policy_outcome"))
        needs_baseline :: if comparison == { .AbsoluteFrom(_, _) | .RelativeTo(_, _) -> true, else -> false }
        if baseline.is_empty() && needs_baseline && stored_evidence == .Unavailable {
            expected :: if enforcement == .Warn -> PolicyOutcome.Warn else -> PolicyOutcome.Fail
            if stored_outcome != expected -> return Err("unavailable decision policy outcome mismatch")
        } else {
            metric_value :: budget_json_field(m, "metric")
            if metric_value == .Object(metric) {
                actual :: evaluate(evidence_id, text(budget_json_field(m, "context_key"), "context_key"), ids, candidate, baseline, parse_percentile(budget_json_field(metric.view(0..<metric.len()), "percentile")), comparison, direction, enforcement, policy)
                if rational_or_none(budget_json_field(d, "point"), "decision.point") != Val(actual.point) || rational_or_none(budget_json_field(d, "lower95"), "decision.lower95") != actual.lower95 || rational_or_none(budget_json_field(d, "upper95"), "decision.upper95") != actual.upper95 || stored_evidence != actual.evidence || stored_outcome != actual.outcome -> return Err("persisted decision does not match independent evaluator recomputation")
            } else -> panic("validated metric is an object")
        }
        trend_value :: budget_json_field(d, "trend")
        if trend_value == .Object(tf) {
            t :: tf.view(0..<tf.len())
            history :: canonical_json_object([CanonicalJSONField{key: "state_id", value: .String("0".repeat(64))}, CanonicalJSONField{key: "report_ids", value: budget_json_field(t, "report_ids").clone()}])
            tids :: history_ids(history)
            estimators :: quantities(budget_json_field(t, "estimators"), "trend.estimators")
            actual :: trend(tids, estimators, direction)
            if trend_label_enum(budget_json_field(t, "label")) != actual.label || rational_or_none(budget_json_field(t, "score"), "trend.score") != actual.score -> return Err("persisted trend does not match independent recomputation")
        } else -> panic("validated trend is an object")
        return
    }
    panic("validated decision is an object")
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:2393
pub fn verify_evaluation(expected: Evaluation, inputs: EvaluationInputs) Err! {
    actual :: evaluate(inputs.evidence_id, inputs.context_key, inputs.baseline_report_ids, inputs.candidate, inputs.baseline, inputs.percentile, inputs.comparison, inputs.direction, inputs.enforcement, inputs.policy)
    if actual != expected -> return Err("persisted budget evaluation does not match independent recomputation")
}
// Rust: crates/jet-foundation/src/PerformanceBudget.rs:2416
// GATE #4500: evaluation inputs borrow caller-owned samples and comparison.
pub struct EvaluationInputs {
    pub evidence_id: @String, pub context_key: @String,
    pub baseline_report_ids: View<String>, pub candidate: View<Rational>, pub baseline: View<Rational>,
    pub percentile: Percentile?, pub comparison: @Comparison, pub direction: Direction,
    pub enforcement: Enforcement, pub policy: (@MeasurementPolicy)?
}
