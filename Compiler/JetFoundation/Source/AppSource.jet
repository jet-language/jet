use unicode: core.text

// Retained authority snapshot for convention-routing discovery. The host
// supplies the complete immediate listing; an empty list is a real empty dir.
AppAuthorizedDirectoryEntry: struct {
    name: String
    path: String
    is_directory: Bool
    // Rust `_` opt-out applies only to a Unicode basename, never lossy text.
    name_is_unicode: Bool
}
AppAuthorizedDirectory: struct {
    path: String
    entries: [AppAuthorizedDirectoryEntry]
}

// One `.routes(from:)` root a module names. The driver resolves `root`
// against the module's directory in the authorized snapshot: `found` is
// false when the snapshot holds no such directory, and `files` lists every
// `.jet` file below it, sorted, relative to the root.
AppRouteRoot: struct {
    root: String
    found: Bool
    files: [AppRouteFile]
}

// One convention file: its root-relative path, and whether it parses to a
// top-level `page: fn`.
AppRouteFile: struct {
    path: String
    has_page: Bool
}

// The address of a convention page file at `relative` (relative to its
// `.routes(from:)` root). Each folder and file name is read as words,
// lowercased and joined by hyphens; a terminal stem whose words are exactly
// `index` or `page` answers its folder's address; a whole `[Name]` part
// captures one address part as `:name`, the snake_case word key.
// `bad_part` names a bracket part that is not one whole `[name]`.
AppRouteAddress: struct {
    path: String
    bad_part: String?
}

app_route_file_address: fn(relative: String) -> AppRouteAddress {
    stem: if relative.ends_with(".jet") -> relative.slice(0, relative.len() - 4) else -> relative
    parts := [String]{}
    loop part in stem.split("/") {
        if part != "" -> &parts.push(part)
    }
    if parts.len() > 0 {
        last: app_route_file_words(parts[parts.len() - 1])
        if last == "index" || last == "page" -> _ := &parts.pop()
    }
    if parts.len() == 0 -> return AppRouteAddress{path: "/", bad_part: None}
    path := ""
    loop part in parts {
        if !part.contains("[") && !part.contains("]") {
            path = "{path}/{app_route_file_words(part)}"
            next
        }
        if !part.starts_with("[") || !part.ends_with("]") || part.len() < 3 -> return AppRouteAddress{path: "", bad_part: Val(part)}
        name: part.slice(1, part.len() - 1)
        loop scalar in unicode.scalars(name) {
            if !sema_casing_is_alphanumeric(scalar) && scalar != "_" -> return AppRouteAddress{path: "", bad_part: Val(part)}
        }
        words := [String]{}
        loop word in sema_casing_split_words(name) -> &words.push(unicode.lower(word))
        path = "{path}/:{words.join("_")}"
    }
    AppRouteAddress{path: path, bad_part: None}
}

// One path component's words, lowercased and joined by hyphens. Underscores,
// hyphens and case changes split words; any other character, such as the
// dot in `sitemap.xml`, stays in place.
app_route_file_words: fn(component: String) -> String {
    out := ""
    run := ""
    loop scalar in unicode.scalars(component) {
        if sema_casing_is_alphanumeric(scalar) || scalar == "_" || scalar == "-" {
            run = "{run}{scalar}"
            next
        }
        out = "{out}{app_route_file_run_words(run)}{unicode.lower(scalar)}"
        run = ""
    }
    "{out}{app_route_file_run_words(run)}"
}

app_route_file_run_words: fn(run: String) -> String {
    words := [String]{}
    loop piece in run.split("-") {
        loop word in sema_casing_split_words(piece) -> &words.push(unicode.lower(word))
    }
    words.join("-")
}
