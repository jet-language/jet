// Retained authority snapshot for convention-routing discovery. The host
// supplies the complete immediate listing; an empty list is a real empty dir.
pub struct AppAuthorizedDirectoryEntry {
    pub name: String
    pub path: String
    pub is_directory: Bool
    // Rust `_` opt-out applies only to a Unicode basename, never lossy text.
    pub name_is_unicode: Bool
}
pub struct AppAuthorizedDirectory {
    pub path: String
    pub entries: [AppAuthorizedDirectoryEntry]
}
