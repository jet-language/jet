// Lowercase hexadecimal byte encoding. Decode accepts either case, never
// signs/whitespace/non-ASCII; callers own stricter alphabets/error shapes.
// Rust: crates/jet-foundation/src/Hex.rs:8
const DIGITS: String = "0123456789abcdef"
// Rust: crates/jet-foundation/src/Hex.rs:11
pub fn encode(bytes: View<U8>) -> String Never! {
    text := String.with_capacity(bytes.len() * 2)
    loop byte in bytes {
        text.push(DIGITS[(byte >> 4) as Int] as Char)
        text.push(DIGITS[(byte & 0x0f) as Int] as Char)
    }
    text
}
// Rust: crates/jet-foundation/src/Hex.rs:21
pub fn nibble(byte: U8) -> U8? Never! {
    if byte >= 48 && byte <= 57 -> return Val(byte - 48)
    if byte >= 97 && byte <= 102 -> return Val(byte - 97 + 10)
    if byte >= 65 && byte <= 70 -> return Val(byte - 65 + 10)
    None
}
// Rust: crates/jet-foundation/src/Hex.rs:31
pub fn decode(text: String) -> [U8]? Never! {
    bytes :: text.bytes()
    if bytes.len() % 2 != 0 -> return None
    decoded := [U8].with_capacity(bytes.len() / 2)
    loop at in (0..<bytes.len()).step_by(2) {
        hi :: nibble(bytes[at]) ?? return None
        lo :: nibble(bytes[at + 1]) ?? return None
        decoded.push((hi << 4) | lo)
    }
    Val(^decoded)
}
