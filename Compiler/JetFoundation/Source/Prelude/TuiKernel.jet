pub fn capabilities(profile: TUIColorProfile, width: Int, height: Int) -> TUICapabilities Never! {
    is_ascii :: profile == TUIColorProfile.ASCII
    TUICapabilities{color_profile: profile, color: !is_ascii, unicode: !is_ascii, mouse: !is_ascii, resize: !is_ascii, clipboard: !is_ascii, width: width.max(1), height: height.max(1)}
}
// Rust: crates/jet-foundation/src/Prelude/TuiKernel.rs:36 Color -> core.tui.TUIColor
