// Portable terminal presentation kernel; public carriers remain at their canonical Core owners.
use core.tui.[TUIColorProfile, TUICapabilities, TUIColor, TUIStyle, TUIConstraint, TUIDirection]
use core.ui.[Rect]
// Rust: crates/jet-foundation/src/Prelude/TuiKernel.rs:2 ColorProfile -> core.tui.TUIColorProfile
