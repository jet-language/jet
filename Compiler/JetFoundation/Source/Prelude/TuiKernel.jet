pub fn color_ansi16(index: I64) -> TUIColor Never! { TUIColor.ANSI16(Int{index.clamp(I64{0}, I64{15})}) }
// Rust: crates/jet-foundation/src/Prelude/TuiKernel.rs:46
pub fn color_ansi256(index: I64) -> TUIColor Never! { TUIColor.ANSI256(Int{index.clamp(I64{0}, I64{255})}) }
// Rust: crates/jet-foundation/src/Prelude/TuiKernel.rs:50
pub fn color_rgb(red: I64, green: I64, blue: I64) -> TUIColor Never! {
    TUIColor.RGB(Int{red.clamp(I64{0}, I64{255})}, Int{green.clamp(I64{0}, I64{255})}, Int{blue.clamp(I64{0}, I64{255})})
}
// Rust: crates/jet-foundation/src/Prelude/TuiKernel.rs:58
fn rgb_ansi256(red: Int, green: Int, blue: Int) -> Int Never! {
    cube :: fn(value: Int) -> Int Never! {
        if value < 48 -> 0 else if value < 115 -> 1 else -> ((value - 55) / 40).min(5)
    }
    16 + 36 * cube(red) + 6 * cube(green) + cube(blue)
}
// Rust: crates/jet-foundation/src/Prelude/TuiKernel.rs:71
fn rgb_ansi16(red: Int, green: Int, blue: Int) -> Int Never! {
    bright :: if red.max(green).max(blue) > 170 -> 1 else -> 0
    index := 0
    if red > 96 -> index |= 1
    if green > 96 -> index |= 2
    if blue > 96 -> index |= 4
    if index == 0 && red.max(green).max(blue) > 48 -> index = 7
    index + bright * 8
}
// Rust: crates/jet-foundation/src/Prelude/TuiKernel.rs:89
fn color_code(color: TUIColor, profile: TUIColorProfile, background: Bool) -> String Never! {
    base :: if background -> 48 else -> 38
    if profile == TUIColorProfile.ASCII -> return ""
    if color == {
        .RGB(red, green, blue) -> {
            if profile == TUIColorProfile.TrueColor -> return "{base};2;{red};{green};{blue}"
            if profile == TUIColorProfile.ANSI256 -> return "{base};5;{rgb_ansi256(red, green, blue)}"
            color_code(TUIColor.ANSI16(rgb_ansi16(red, green, blue)), profile, background)
        }
        .ANSI256(index) -> {
            if profile != TUIColorProfile.ANSI16 -> return "{base};5;{index}"
            color_code(TUIColor.ANSI16(index % 16), profile, background)
        }
        .ANSI16(raw_index) -> {
            index :: raw_index % 16
            if profile != TUIColorProfile.ANSI16 -> return "{base};5;{index}"
            if index < 8 -> "{base - 8 + index}" else -> "{base + 44 + index}"
        }
    }
}
// Rust: crates/jet-foundation/src/Prelude/TuiKernel.rs:125 Style -> core.tui.TUIStyle
// Rust: crates/jet-foundation/src/Prelude/TuiKernel.rs:133
pub fn style_text(text: String, style: TUIStyle, capabilities: TUICapabilities) -> String Never! {
    rendered :: if capabilities.unicode -> text.to_string() else -> ascii(text)
    if !capabilities.color || capabilities.color_profile == TUIColorProfile.ASCII -> return ^rendered
    codes := [String]{}
    if style.bold -> &codes.push("1")
    if style.dim -> &codes.push("2")
    if style.underline -> &codes.push("4")
    if style.foreground == .Val(color) -> &codes.push(color_code(color, capabilities.color_profile, false))
    if style.background == .Val(color) -> &codes.push(color_code(color, capabilities.color_profile, true))
    if codes.is_empty() -> return ^rendered
    escape :: String.from_bytes([U8]{U8{27}}) ?? panic("ASCII escape is UTF-8")
    "{escape}[{codes.join(";")}m{rendered}{escape}[0m"
}
// Rust: crates/jet-foundation/src/Prelude/TuiKernel.rs:165
pub fn ascii(text: String) -> String Never! {
    output := ""
    loop ch in text.chars() {
        replacement :: if ch == {
            '─' -> '-', '━' -> '-', '═' -> '-'
            '│' -> '|', '┃' -> '|', '║' -> '|'
            '┌' -> '+', '┏' -> '+', '╔' -> '+', '┐' -> '+', '┓' -> '+', '╗' -> '+'
            '└' -> '+', '┗' -> '+', '╚' -> '+', '┘' -> '+', '┛' -> '+', '╝' -> '+'
            '├' -> '+', '┤' -> '+', '┬' -> '+', '┴' -> '+', '┼' -> '+', '╋' -> '+', '╬' -> '+'
            '→' -> '>', '⇒' -> '>', '➜' -> '>'
            '←' -> '<', '⇐' -> '<', '↑' -> '^', '⇑' -> '^', '↓' -> 'v', '⇓' -> 'v'
            else -> if ch.is_ascii() -> ch else -> '?'
        }
        &output.push(replacement)
    }
    ^output
}
// Rust: crates/jet-foundation/src/Prelude/TuiKernel.rs:182
pub fn strip_ansi(text: String) -> String Never! {
    output := String.with_capacity(text.bytes().len())
    escape := false
    loop ch in text.chars() {
        if escape {
            if ch.is_ascii_alphabetic() || ch == '@' -> escape = false
            next
        }
        if U32{ch} == U32{27} -> escape = true
        else -> &output.push(ch)
    }
    ^output
}
// Rust: crates/jet-foundation/src/Prelude/TuiKernel.rs:201
pub fn char_width(ch: Char) -> Int Never! {
    c :: U32{ch}
    if ch.is_control()
        || (c >= U32{0x0300} && c <= U32{0x036f})
        || (c >= U32{0x0483} && c <= U32{0x0489})
        || (c >= U32{0x0591} && c <= U32{0x05bd})
        || (c >= U32{0x0610} && c <= U32{0x061a})
        || (c >= U32{0x064b} && c <= U32{0x065f})
        || (c >= U32{0x1ab0} && c <= U32{0x1aff})
        || (c >= U32{0x1dc0} && c <= U32{0x1dff})
        || (c >= U32{0x20d0} && c <= U32{0x20ff})
        || (c >= U32{0xfe20} && c <= U32{0xfe2f}) -> return 0
    if (c >= U32{0x1100} && c <= U32{0x115f})
        || (c >= U32{0x2329} && c <= U32{0x232a})
        || (c >= U32{0x2e80} && c <= U32{0x303e})
        || (c >= U32{0x3040} && c <= U32{0xa4cf})
        || (c >= U32{0xac00} && c <= U32{0xd7a3})
        || (c >= U32{0xf900} && c <= U32{0xfaff})
        || (c >= U32{0xfe10} && c <= U32{0xfe19})
        || (c >= U32{0xfe30} && c <= U32{0xfe6f})
        || (c >= U32{0xff00} && c <= U32{0xff60})
        || (c >= U32{0xffe0} && c <= U32{0xffe6})
        || (c >= U32{0x1f300} && c <= U32{0x1faff}) -> 2
    else -> 1
}
// Rust: crates/jet-foundation/src/Prelude/TuiKernel.rs:238
pub fn display_width(text: String) -> Int Never! {
    total := 0
    loop ch in strip_ansi(text).chars() -> total += char_width(ch)
    total
}
// Rust: crates/jet-foundation/src/Prelude/TuiKernel.rs:242
pub fn truncate(text: String, width: Int) -> String Never! {
    if width == 0 -> return ""
    output := ""
    used := 0
    loop ch in strip_ansi(text).chars() {
        size :: char_width(ch)
        if used + size > width -> break
        &output.push(ch)
        used += size
    }
    ^output
}
// Rust: crates/jet-foundation/src/Prelude/TuiKernel.rs:259
pub fn pad(text: String, width: Int) -> String Never! {
    clipped :: truncate(text, width)
    padding :: (width - display_width(clipped)).max(0)
    "{clipped}{" ".repeat(padding)}"
}
// Rust: crates/jet-foundation/src/Prelude/TuiKernel.rs:266 Constraint -> core.tui.TUIConstraint
// Rust: crates/jet-foundation/src/Prelude/TuiKernel.rs:274
pub fn length(value: Float) -> TUIConstraint Never! { TUIConstraint.Length(nonnegative(value)) }
// Rust: crates/jet-foundation/src/Prelude/TuiKernel.rs:278
pub fn min(value: Float) -> TUIConstraint Never! { TUIConstraint.Min(nonnegative(value)) }
// Rust: crates/jet-foundation/src/Prelude/TuiKernel.rs:282
pub fn max(value: Float) -> TUIConstraint Never! { TUIConstraint.Max(nonnegative(value)) }
// Rust: crates/jet-foundation/src/Prelude/TuiKernel.rs:286
pub fn percent(value: Float) -> TUIConstraint Never! {
    TUIConstraint.Percent(if value.is_finite() -> value.clamp(0.0, 100.0) else -> 0.0)
}
// Rust: crates/jet-foundation/src/Prelude/TuiKernel.rs:294
pub fn fill(weight: Float) -> TUIConstraint Never! {
    bounded :: if weight.is_finite() -> weight.max(0.0).round().min(65535.0) else -> 0.0
    TUIConstraint.Fill(bounded)
}
// Rust: crates/jet-foundation/src/Prelude/TuiKernel.rs:302
fn nonnegative(value: Float) -> Float Never! { if value.is_finite() -> value.max(0.0) else -> 0.0 }
// Rust: crates/jet-foundation/src/Prelude/TuiKernel.rs:311 Rect -> core.ui.Rect
// Rust: crates/jet-foundation/src/Prelude/TuiKernel.rs:319 Direction -> core.tui.TUIDirection
// Rust: crates/jet-foundation/src/Prelude/TuiKernel.rs:324
pub fn layout(area: Rect, direction: TUIDirection, constraints: View<TUIConstraint>) -> [Rect] Never! {
    if constraints.is_empty() -> return []
    total :: if direction == { .Horizontal -> nonnegative(area.width), .Vertical -> nonnegative(area.height) }
    sizes := [Float].with_capacity(constraints.len())
    desired_total := 0.0
    fill_weight := 0.0
    loop constraint in constraints {
        desired :: if constraint == {
            .Length(value) -> nonnegative(value)
            .Min(value) -> nonnegative(value)
            .Max(value) -> nonnegative(value)
            .Percent(value) -> total * nonnegative(value).min(100.0) / 100.0
            .Fill(weight) -> { fill_weight += weight; 0.0 }
        }
        &sizes.push(desired)
        desired_total += desired
    }
    scale :: if desired_total > total && desired_total > 0.0 -> total / desired_total else -> 1.0
    scaled_total := 0.0
    loop index in 0..<sizes.len() { sizes[index] *= scale; scaled_total += sizes[index] }
    remaining :: (total - scaled_total).max(0.0)
    if fill_weight > 0.0 {
        loop index in 0..<sizes.len() {
            if constraints[index] == .Fill(weight) -> sizes[index] = remaining * weight / fill_weight
        }
    }
    cursor := 0.0
    frames := [Rect].with_capacity(sizes.len())
    loop size in sizes {
        frame :: if direction == {
            .Horizontal -> Rect{x: area.x + cursor, y: area.y, width: size, height: area.height}
            .Vertical -> Rect{x: area.x, y: area.y + cursor, width: area.width, height: size}
        }
        cursor += size
        &frames.push(frame)
    }
    ^frames
}
