// One typed text/binary pattern scan kernel shared by compiler execution routes.
use core.sys.target as match_target // GATE #4483: checked arithmetic follows selected usize width.

// Rust: crates/jet-foundation/src/Prelude/MatchScan.rs:11
pub enum JetPatternCapture {
    Text(String)
    Int(I64)
    Float(F64)
    Bool(Bool)
    Bytes([U8])
}
// Rust: crates/jet-foundation/src/Prelude/MatchScan.rs:22
pub enum JetTextHoleKind { Text, Int, Float, Bool, InlineRange(lo: I64, hi: I64) }
// Rust: crates/jet-foundation/src/Prelude/MatchScan.rs:31
pub enum JetTextMatchPart { Literal(String), Hole(kind: JetTextHoleKind) }
// Rust: crates/jet-foundation/src/Prelude/MatchScan.rs:36
fn jet_text_capture(kind: JetTextHoleKind, raw: String) -> JetPatternCapture? Never! {
    if kind == {
        .Text -> Val(JetPatternCapture.Text(raw.to_string()))
        .Int -> { value :: raw.parse<I64>() ?? return None; Val(JetPatternCapture.Int(value)) }
        .Float -> { value :: raw.parse<F64>() ?? return None; Val(JetPatternCapture.Float(value)) }
        .Bool -> if raw == {
            "true" -> Val(JetPatternCapture.Bool(true))
            "True" -> Val(JetPatternCapture.Bool(true))
            "1" -> Val(JetPatternCapture.Bool(true))
            "false" -> Val(JetPatternCapture.Bool(false))
            "False" -> Val(JetPatternCapture.Bool(false))
            "0" -> Val(JetPatternCapture.Bool(false))
            else -> None
        }
        .InlineRange(lo, hi) -> {
            value :: raw.parse<I64>() ?? return None
            if value < lo || value > hi -> return None
            Val(JetPatternCapture.Int(value))
        }
    }
}
// Rust: crates/jet-foundation/src/Prelude/MatchScan.rs:59
// Offsets are byte offsets, including prefix cursor advancement.
pub fn jet_text_match_scan(subject: String, parts: View<JetTextMatchPart>, consume_prefix: Bool) -> (offset: Int, captures: [JetPatternCapture])? Never! {
    cursor := 0
    captures := [JetPatternCapture]{}
    loop index in 0..<parts.len() {
        if parts[index] == {
            .Literal(literal) -> {
                tail := subject.get(cursor..<subject.bytes().len()) ?? return None // #4303
                if !tail.starts_with(literal) -> return None
                if Int{literal.bytes().len()} > Int{match_target.usize_max()} - cursor -> return None
                cursor += literal.bytes().len()
            }
            .Hole(kind) -> {
                end := subject.bytes().len()
                if index + 1 < parts.len() {
                    if parts[index + 1] == .Literal(next_literal) {
                        tail := subject.get(cursor..<subject.bytes().len()) ?? return None // #4303
                        offset :: tail.index_of(next_literal) ?? return None
                        end = cursor + offset
                    }
                }
                raw := subject.get(cursor..<end) ?? return None // #4303
                capture :: jet_text_capture(kind, raw) ?? return None
                &captures.push(^capture)
                cursor = end
            }
        }
    }
    if !consume_prefix && cursor != subject.bytes().len() -> return None
    Val((cursor, ^captures))
}
// Rust: crates/jet-foundation/src/Prelude/MatchScan.rs:95
pub fn jet_text_pattern_match(subject: String, parts: View<JetTextMatchPart>) -> [JetPatternCapture]? Never! {
    result :: jet_text_match_scan(subject, parts, false) ?? return None
    Val(^result.captures)
}
// Rust: crates/jet-foundation/src/Prelude/MatchScan.rs:104
pub fn jet_binary_pattern_match(subject: View<U8>, parts: View<JetBinMatchPart>) -> [JetPatternCapture]? Never! {
    result :: jet_bin_match_scan(subject, parts, false) ?? return None
    captures := [JetPatternCapture].with_capacity(result.values.len())
    loop value in result.values {
        if value == {
            .Int(integer) -> &captures.push(JetPatternCapture.Int(I64.from_bits(integer)))
            .Rest(bytes) -> &captures.push(JetPatternCapture.Bytes(^bytes))
        }
    }
    Val(^captures)
}
// Rust: crates/jet-foundation/src/Prelude/MatchScan.rs:119
pub enum JetBinMatchPart { Lit(View<U8>), Bits(width: Int, little: Bool), Rest }
// Rust: crates/jet-foundation/src/Prelude/MatchScan.rs:126
pub enum JetBinMatchValue { Int(U64), Rest([U8]) }
// Rust: crates/jet-foundation/src/Prelude/MatchScan.rs:135
pub fn jet_bin_match_scan(subject: View<U8>, parts: View<JetBinMatchPart>, consume_prefix: Bool) -> (bits: Int, values: [JetBinMatchValue])? Never! {
    usize_max :: Int{match_target.usize_max()}
    if subject.len() > usize_max / 8 -> return None
    total :: subject.len() * 8
    bit_pos := 0
    values := [JetBinMatchValue]{}
    loop part in parts {
        if part == {
            .Lit(bytes) -> {
                if bit_pos % 8 != 0 -> return None
                byte_pos :: bit_pos / 8
                if bytes.len() > usize_max - byte_pos -> return None
                end :: byte_pos + bytes.len()
                if end > subject.len() || subject.view(byte_pos..<end) != bytes -> return None
                if bytes.len() > usize_max / 8 || bytes.len() * 8 > usize_max - bit_pos -> return None
                bit_pos += bytes.len() * 8
            }
            .Bits(width, little) -> {
                if width < 0 || width > usize_max - bit_pos -> return None
                end :: bit_pos + width
                if end > total -> return None
                value := U64{0}
                if bit_pos % 8 == 0 && width % 8 == 0 && width <= 64 {
                    byte_pos :: bit_pos / 8
                    bytes :: width / 8
                    if bytes > usize_max - byte_pos -> return None
                    byte_end :: byte_pos + bytes
                    if byte_end > subject.len() -> return None
                    if little {
                        loop index in 0..<bytes -> value |= U64{subject[byte_pos + index]} << (8 * index)
                    } else {
                        loop index in byte_pos..<byte_end -> value = (value << 8) | U64{subject[index]}
                    }
                } else {
                    loop offset in 0..<width {
                        position :: bit_pos + offset
                        byte :: subject[position / 8]
                        bit :: 7 - position % 8
                        value = (value << 1) | U64{(byte >> bit) & U8{1}}
                    }
                    if little && width % 8 == 0 {
                        bytes :: width / 8
                        swapped := U64{0}
                        loop index in 0..<bytes {
                            swapped |= ((value >> (8 * index)) & U64{255}) << (8 * (bytes - 1 - index))
                        }
                        value = swapped
                    }
                }
                bit_pos = end
                &values.push(JetBinMatchValue.Int(value))
            }
            .Rest -> {
                if bit_pos % 8 != 0 -> return None
                &values.push(JetBinMatchValue.Rest(subject.view(bit_pos / 8..<subject.len()).to_array()))
                bit_pos = total
            }
        }
    }
    if !consume_prefix && bit_pos != total {
        has_rest := false
        loop part in parts {
            if part == .Rest { has_rest = true; break }
        }
        if !has_rest -> return None
    }
    if consume_prefix && bit_pos % 8 != 0 -> return None
    Val((bit_pos, ^values))
}
