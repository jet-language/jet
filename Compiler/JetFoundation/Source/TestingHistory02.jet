    }
    // Rust: crates/jet-foundation/src/TestingHistory.rs:2759
    pub fn run_with_validity(self, generate: &(&HistoryRng, Int) -> HistoryCase? Never!, valid: &(HistoryCase) -> Bool Never!, observe: &(HistoryCase) -> ComparisonRecord Never!) -> HistoryRun HistoryError! {
        rng := HistoryRng.new(self.config.seed)
        explored_cases := 0
        discarded_cases := 0
        vacuous_preconditions := 0
        loop case_index in 0..<self.config.cases {
            case :: generate(&rng, case_index) ?? {
                discarded_cases += 1
                if discarded_cases > self.config.bounds.max_discarded_cases -> return Err(HistoryError.InvalidConfig("discarded cases exceeded the configured bound"))
                continue
            }
            if case.validate().is_err() || !case_within_bounds(case, self.config.bounds) || !valid(case) {
                discarded_cases += 1
                if discarded_cases > self.config.bounds.max_discarded_cases -> return Err(HistoryError.InvalidConfig("discarded cases exceeded the configured bound"))
                continue
            }
            vacuous_preconditions += case.vacuous_preconditions()
            record :: observe(case)
            if record.status == {
                .InvalidOracle | .Contaminated -> return Err(HistoryError.InvalidOracle(record.reason ?? "comparison rejected the oracle"))
                .Mismatch -> {
                    (reduced_case, reduced_record) :: shrink_history_with_validity(case, self.config.bounds, valid, observe)?
                    artifact :: HistoryArtifact.new(self.config, ^reduced_case, ^reduced_record, discarded_cases)?
                    return Ok(HistoryRun{seed: self.config.seed, cases: self.config.cases, bounds: self.config.bounds, distributions: ~self.config.distributions, explored_cases: explored_cases + 1, discarded_cases: discarded_cases, vacuous_preconditions: vacuous_preconditions, failure: Val(^artifact)})
                }
                .Matched -> explored_cases += 1
                .Empty | .Unsupported | .Unavailable | .Timeout | .Cancelled -> {
                    explored_cases += 1; discarded_cases += 1
                    if discarded_cases > self.config.bounds.max_discarded_cases -> return Err(HistoryError.InvalidConfig("discarded cases exceeded the configured bound"))
                }
            }
        }
        Ok(HistoryRun{seed: self.config.seed, cases: self.config.cases, bounds: self.config.bounds, distributions: ~self.config.distributions, explored_cases: explored_cases, discarded_cases: discarded_cases, vacuous_preconditions: vacuous_preconditions, failure: None})
    }
    // Rust: crates/jet-foundation/src/TestingHistory.rs:2862
    pub fn run_strategy<Command: HistoryCommand, Strategy: HistoryStrategyBehavior<Command>>(self, strategy: Strategy, observe: &(TypedHistoryCase<Command>) -> ComparisonRecord Never!) -> HistoryRun HistoryError! {
        if self.config.command_type != strategy.command_type() -> return Err(HistoryError.InvalidConfig("history command type `{self.config.command_type}` does not match strategy `{strategy.command_type()}`"))
        if strategy.unsupported_reason() == .Val(reason) -> return Err(HistoryError.InvalidConfig(~reason))
        expected_distributions :: strategy.distributions()
        if self.config.distributions != expected_distributions -> return Err(HistoryError.InvalidConfig("history distributions do not match the command strategy"))
        self.run_with_validity(
            fn(rng, index) { strategy.generate(rng, index, self.config.bounds.max_steps).map(fn(typed) { ^typed.case }) },
            fn(case) { strategy.rebuild(case).is_some_and(fn(typed) { strategy.valid(typed) }) },
            fn(case) {
                if strategy.rebuild(case) == {
                    .Val(typed) -> observe(typed)
                    .None -> ComparisonRecord.terminal(~self.config.relation, ComparisonStatus.Unavailable, "history strategy could not rebuild a typed operation")
                }
            })
    }
}
// Rust: crates/jet-foundation/src/TestingHistory.rs:2910
fn push_booking_operation(case: &HistoryCase, name: String, argument: HandleId?, creates: HandleId?, consumes: HandleId?, state: String?) -> Unit Never! {
    index :: U32(case.operations.len())
    task :: TaskId{value: index % 2}
    event :: EventId{value: index + 1}
    operation := HistoryOperation.new(index, ~name).scheduled_on(task, event)
    if index > 0 {
        previous :: index - 1
        operation = operation.depends_on(previous).requires(HistoryPrecondition.TaskCompleted(TaskId{value: previous % 2})).requires(HistoryPrecondition.EventAvailable(EventId{value: previous + 1}))
    }
    if argument == .Val(value) -> operation = operation.with_argument(HistoryValue.Handle(value))
    if creates == .Val(value) -> operation = operation.creates(value)
    if consumes == .Val(value) -> operation = operation.consumes(value)
    if state == .Val(value) { if argument == .Val(handle) -> operation = operation.requires(HistoryPrecondition.HandleState{handle: handle, state: ~value}) }
    case.push(^operation)
    choice :: if name == "timeout" { "deliver-late" } else { "fifo" }
    case.schedule(HistoryScheduleChoice.new(index, choice).for_task_event(task, event))
}
// Rust: crates/jet-foundation/src/TestingHistory.rs:2963
pub fn generate_booking_history_case(rng: &HistoryRng, case_index: Int, max_steps: Int) -> HistoryCase? Never! {
    if max_steps < 3 -> return None
    case_seed :: rng.next_u64()
    local := HistoryRng.new(case_seed)
    case := HistoryCase.new("booking-{case_index}", case_seed)
    next_handle := U32{1}
    active := [HandleId]{}
    terminal := [(HandleId, String)]{}
    first :: HandleId{value: next_handle}; next_handle += 1
    push_booking_operation(&case, "reserve", None, Val(first), None, None)
    push_booking_operation(&case, "timeout", Val(first), None, None, Val("active"))
    &terminal.push((first, "timed_out"))
    second :: HandleId{value: next_handle}; next_handle += 1
    push_booking_operation(&case, "retry", Val(first), Val(second), Val(first), Val("timed_out"))
    &active.push(second)
    loop case.operations.len() < max_steps {
        choice :: local.below(8)
        if choice < 3 || (active.is_empty() && terminal.is_empty()) {
            handle :: HandleId{value: next_handle}; next_handle += 1
            push_booking_operation(&case, "reserve", None, Val(handle), None, None)
            &active.push(handle)
        } else if choice < 5 && !active.is_empty() {
            index :: Int(local.below(U64(active.len())))
            handle :: active[index]
            push_booking_operation(&case, "cancel", Val(handle), None, None, Val("active"))
            _ :: &active.swap_remove(index)
            &terminal.push((handle, "cancelled"))
        } else if choice < 7 && !active.is_empty() {
            index :: Int(local.below(U64(active.len())))
            handle :: active[index]
            push_booking_operation(&case, "timeout", Val(handle), None, None, Val("active"))
            _ :: &active.swap_remove(index)
            &terminal.push((handle, "timed_out"))
        } else if !terminal.is_empty() {
            index :: Int(local.below(U64(terminal.len())))
            (handle, retry_state) :: &terminal.swap_remove(index)
            replacement :: HandleId{value: next_handle}; next_handle += 1
            push_booking_operation(&case, "retry", Val(handle), Val(replacement), Val(handle), Val(retry_state))
            &active.push(replacement)
        } else {
            handle :: HandleId{value: next_handle}; next_handle += 1
            push_booking_operation(&case, "reserve", None, Val(handle), None, None)
            &active.push(handle)
        }
    }
    Val(^case)
}
// Rust: crates/jet-foundation/src/TestingHistory.rs:3060
fn booking_case_is_valid(case: HistoryCase) -> Bool Never! {
    if case.validate().is_err() || case.schedule.len() != case.operations.len() -> return false
    states := [HandleId:String]{}
    loop position in 0..<case.operations.len() {
        operation :: case.operations[position]
        index :: U32(position)
        if operation.task != Val(TaskId{value: index % 2}) || operation.event != Val(EventId{value: index + 1}) -> return false
        if position > 0 {
            if operation.depends_on != [index - 1] -> return false
            if !operation.preconditions.any(fn(precondition) { if precondition == { .TaskCompleted(task) -> task == TaskId{value: (index - 1) % 2} else -> false } }) -> return false
            if !operation.preconditions.any(fn(precondition) { if precondition == { .EventAvailable(event) -> event == EventId{value: index} else -> false } }) -> return false
        }
        choice :: case.schedule[position]
        expected_choice :: if operation.name == "timeout" { "deliver-late" } else { "fifo" }
        if choice.operation != index || choice.task != operation.task || choice.event != operation.event || choice.choice != expected_choice -> return false
        handle :: operation.arguments.find_map(fn(value) { value.handles() })
        if operation.name == {
            "reserve" -> {
                if operation.creates.len() != 1 || handle.is_some() || !operation.consumes.is_empty() -> return false
                states[operation.creates[0]] = "active"
            }
            "cancel" | "timeout" -> {
                value :: handle ?? return false
                expected_state :: if operation.name == "cancel" { "active" } else { "active" }
                if states.get(value) != Val(expected_state) || !operation.creates.is_empty() || !operation.consumes.is_empty() -> return false
                if !operation.preconditions.any(fn(precondition) { if precondition == { .HandleState{handle: h, state: s} -> h == value && s == expected_state else -> false } }) -> return false
                states[value] = if operation.name == "cancel" { "cancelled" } else { "timed_out" }
            }
            "retry" -> {
                value :: handle ?? return false
                state :: states.get(value) ?? return false
                if (state != "cancelled" && state != "timed_out") || operation.creates.len() != 1 || operation.consumes != [value] -> return false
                if !operation.preconditions.any(fn(precondition) { if precondition == { .HandleState{handle: h, state: s} -> h == value && (s == "cancelled" || s == "timed_out") else -> false } }) -> return false
                _ :: &states.remove(value)
                states[operation.creates[0]] = "active"
            }
            else -> return false
        }
    }
    true
}
// Rust: crates/jet-foundation/src/TestingHistory.rs:3178
enum BookingState { Active Cancelled TimedOut }
// Rust: crates/jet-foundation/src/TestingHistory.rs:3185
struct BookingWorld { states: [HandleId:BookingState]; effects: [String] }
impl BookingWorld {
    // Rust: crates/jet-foundation/src/TestingHistory.rs:3184 (derived Default)
    fn default() -> BookingWorld Never! { BookingWorld{states: [:], effects: []} }
    // Rust: crates/jet-foundation/src/TestingHistory.rs:3191
    fn apply_reference(self: &BookingWorld, operation: HistoryOperation) -> Unit Never! {
        handle :: operation.arguments.find_map(fn(value) { value.handles() })
        if operation.name == {
            "reserve" -> { if operation.creates.first() == .Val(created) { self.states[created] = BookingState.Active; &self.effects.push("reserve:{created.value}") } }
            "cancel" -> { if handle == .Val(value) { self.states[value] = BookingState.Cancelled; &self.effects.push("cancel:{value.value}") } }
            "timeout" -> { if handle == .Val(value) { self.states[value] = BookingState.TimedOut; &self.effects.push("timeout:{value.value}") } }
            "retry" -> { if handle == .Val(value) { if operation.creates.first() == .Val(created) { _ :: &self.states.remove(value); self.states[created] = BookingState.Active; &self.effects.push("retry:{value.value}->{created.value}") } } }
            else -> {}
        }
    }
    // Rust: crates/jet-foundation/src/TestingHistory.rs:3226
    fn apply_candidate(self: &BookingWorld, operation: HistoryOperation, injected_defect: Bool) -> Unit Never! {
        handle :: operation.arguments.find_map(fn(value) { value.handles() })
        if operation.name == {
            "reserve" -> { if operation.creates.first() == .Val(created) { self.states[created] = BookingState.Active; &self.effects.push("reserve:{created.value}") } }
            "cancel" -> { if handle == .Val(value) { self.states[value] = BookingState.Cancelled; &self.effects.push("cancel:{value.value}") } }
            "timeout" -> { if handle == .Val(value) { self.states[value] = BookingState.TimedOut; &self.effects.push("timeout:{value.value}") } }
            "retry" -> { if handle == .Val(value) { if operation.creates.first() == .Val(created) {
                timed_out :: self.states.get(value) == Val(BookingState.TimedOut)
                if !(injected_defect && timed_out) -> _ :: &self.states.remove(value)
                self.states[created] = BookingState.Active
                &self.effects.push("retry:{value.value}->{created.value}")
            } } }
            else -> {}
        }
    }
    // Rust: crates/jet-foundation/src/TestingHistory.rs:3264
    fn observation(self) -> ComparisonObservation Never! {
        keys := self.states.keys().to_list()
        &keys.sort()
        rows := [String]{}
        loop handle in keys {
            state :: if self.states[handle] == { .Active -> "active" .Cancelled -> "cancelled" .TimedOut -> "timed_out" }
            &rows.push("{handle.value}={state}")
        }
        ComparisonObservation.failure(rows.join(","), "booking_state").with_mutation("booking lifecycle").with_effects(~self.effects).with_cleanup(["booking handles released"])
    }
}
// Rust: crates/jet-foundation/src/TestingHistory.rs:3286
pub fn compare_booking_case(case: HistoryCase, injected_defect: Bool) -> ComparisonRecord HistoryError! {
    if !booking_case_is_valid(case) -> return Err(HistoryError.InvalidCase("booking case violates a state precondition"))
    reference := BookingWorld.default()
    candidate := BookingWorld.default()
    loop operation in case.operations { reference.apply_reference(operation); candidate.apply_candidate(operation, injected_defect) }
    identity := ComparisonIdentity.new(~case.case_id, case.input_id(), "Examples/features/tooling/test_history/run.jet", HISTORY_ENGINE, "booking")
    identity.seed = Val(case.seed)
    Ok(compare_samples(ObservationRelation.OrderedEffects, [ComparisonSample.new(^identity, reference.observation(), candidate.observation())]))
}
// Rust: crates/jet-foundation/src/TestingHistory.rs:3322
pub fn run_booking_history_campaign(seed: U64, cases: Int, injected_defect: Bool) -> HistoryRun HistoryError! {
    bounds :: HistoryBounds{max_steps: 8, max_resources: 32, max_shrink_attempts: 10000, max_discarded_cases: cases}
    strategy :: BookingHistoryStrategy.new()
    config := HistoryConfig.new(seed, cases, bounds, "Examples/features/tooling/test_history/run.jet", HISTORY_ENGINE, "booking", ObservationRelation.OrderedEffects, OracleDeclaration.independent("booking.reference")).with_command_type(strategy.command_type())
    loop distribution in HistoryStrategyBehavior<BookingCommand>.distributions(strategy) -> config = config.with_distribution(^distribution)
    runner :: HistoryRunner.new(^config)?
    runner.run_strategy<BookingCommand, BookingHistoryStrategy>(strategy, fn(typed) {
        case :: typed.case
        if compare_booking_case(case, injected_defect) == {
            .Ok(record) -> ^record
            .Err(error) -> {
                identity :: ComparisonIdentity.new(~case.case_id, case.input_id(), "Examples/features/tooling/test_history/run.jet", HISTORY_ENGINE, "booking")
                ComparisonRecord{schema_version: TEST_COMPARISON_SCHEMA_VERSION, status: ComparisonStatus.InvalidOracle, relation: ObservationRelation.OrderedEffects, samples: [ComparisonSample.new(^identity, ComparisonObservation.failure("invalid", "history_error"), ComparisonObservation.failure(error.to_string(), "history_error"))], discarded_cases: 0, first_difference: None, reduced_counterexample: None, contamination: None, reason: Val(error.to_string()), universal_proof: false}
            }
        }
    })
}
