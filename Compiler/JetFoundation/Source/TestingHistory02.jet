    mutation :: if observation.mutation == { .Val(value) -> quote(value) .None -> "null" }
    failure :: if observation.typed_failure == { .Val(value) -> quote(value) .None -> "null" }
    "{{\"cleanup\":[{cleanup}],\"mutation\":{mutation},\"orderedEffects\":[{effects}],\"raw\":{quote(observation.raw)},\"typedFailure\":{failure}}}"
}
// Rust: crates/jet-foundation/src/TestingHistory.rs:2590
pub fn shrink_history(original: HistoryCase, bounds: HistoryBounds, observe: &(HistoryCase) -> ComparisonRecord Never!) -> (HistoryCase, ComparisonRecord) HistoryError! {
    shrink_history_with_validity(original, bounds, fn(_) { true }, observe)
}
// Rust: crates/jet-foundation/src/TestingHistory.rs:2604
fn case_within_bounds(case: HistoryCase, bounds: HistoryBounds) -> Bool Never! {
    if case.operations.len() > bounds.max_steps -> return false
    resources := [HandleId:Bool]{}
    loop operation in case.operations { loop handle in operation.creates -> resources[handle] = true }
    resources.len() <= bounds.max_resources
}
// Rust: crates/jet-foundation/src/TestingHistory.rs:2616
pub fn shrink_history_with_validity(original: HistoryCase, bounds: HistoryBounds, valid: &(HistoryCase) -> Bool Never!, observe: &(HistoryCase) -> ComparisonRecord Never!) -> (HistoryCase, ComparisonRecord) HistoryError! {
    bounds.validate()?
    original.validate()?
    if !case_within_bounds(original, bounds) -> return Err(HistoryError.InvalidCase("starting case exceeds configured history bounds"))
    if !valid(original) -> return Err(HistoryError.InvalidCase("cannot shrink an invalid starting case"))
    initial :: observe(original)
    if initial.status == {
        .Mismatch -> {}
        .InvalidOracle | .Contaminated -> return Err(HistoryError.InvalidOracle(initial.reason ?? "comparison rejected the oracle"))
        else -> return Err(HistoryError.NoFailure)
    }
    current := ~original
    current_record := ~initial
    attempts := 0
    loop {
        changed := false
        loop index in 0..<current.operations.len() {
            if attempts >= bounds.max_shrink_attempts -> break
            remove := [U32:Bool]{U32(index): true}
            candidate :: current.without_indices(remove) ?? continue
            attempts += 1
            if candidate.validate().is_err() || !case_within_bounds(candidate, bounds) || !valid(candidate) -> continue
            candidate_record :: observe(candidate)
            if preserves_failure(current_record, candidate_record) {
                current = ^candidate; current_record = ^candidate_record; changed = true; break
            }
        }
        if changed -> continue
        exhausted := false
        loop operation_index in 0..<current.operations.len() {
            argument_count :: current.operations[operation_index].arguments.len()
            loop argument_index in 0..<argument_count {
                values :: current.operations[operation_index].arguments[argument_index].shrinks()
                loop value in values {
                    if attempts >= bounds.max_shrink_attempts { exhausted = true; break }
                    candidate :: current.with_argument(operation_index, argument_index, ^value) ?? continue
                    attempts += 1
                    if candidate.validate().is_err() || !case_within_bounds(candidate, bounds) || !valid(candidate) -> continue
                    candidate_record :: observe(candidate)
                    if preserves_failure(current_record, candidate_record) {
                        current = ^candidate; current_record = ^candidate_record; changed = true; break
                    }
                }
                if changed || exhausted -> break
            }
            if changed || exhausted -> break
        }
        if !changed -> break
    }
    Ok((^current, ^current_record))
}
// Rust: crates/jet-foundation/src/TestingHistory.rs:2721
fn preserves_failure(previous: ComparisonRecord, candidate: ComparisonRecord) -> Bool Never! {
    if candidate.status != ComparisonStatus.Mismatch || previous.relation != candidate.relation -> return false
    previous_sample :: previous.first_mismatch() ?? return false
    candidate_sample :: candidate.first_mismatch() ?? return false
    previous_sample.reference.typed_failure == candidate_sample.reference.typed_failure && previous_sample.candidate.typed_failure == candidate_sample.candidate.typed_failure && previous_sample.reference.mutation == candidate_sample.reference.mutation && previous_sample.candidate.mutation == candidate_sample.candidate.mutation && previous_sample.reference.cleanup == candidate_sample.reference.cleanup && previous_sample.candidate.cleanup == candidate_sample.candidate.cleanup
}
// Rust: crates/jet-foundation/src/TestingHistory.rs:2741
pub struct HistoryRunner { config: HistoryConfig }
impl HistoryRunner {
    // Rust: crates/jet-foundation/src/TestingHistory.rs:2746
    pub fn new(config: ^HistoryConfig) -> HistoryRunner HistoryError! { config.validate()?; Ok(HistoryRunner{config: ^config}) }
    // Rust: crates/jet-foundation/src/TestingHistory.rs:2751
