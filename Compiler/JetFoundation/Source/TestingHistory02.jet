    reference_replay :: if sample.reference_replay == { .Val(value) -> observation_json(value) .None -> "null" }
    "{{\"candidate\":{observation_json(sample.candidate)},\"candidateReplay\":{candidate_replay},\"identity\":{identity_json(sample.identity)},\"reference\":{observation_json(sample.reference)},\"referenceReplay\":{reference_replay}}}"
}
// Rust: crates/jet-foundation/src/TestingHistory.rs:2559
fn observation_json(observation: ComparisonObservation) -> String Never! {
    effects :: observation.ordered_effects.map(quote).join(",")
