    "{{\"caseId\":{quote(identity.case_id)},\"inputId\":{quote(identity.input_id)},\"seed\":{seed},\"source\":{quote(identity.source)},\"target\":{quote(identity.target)},\"tool\":{quote(identity.tool)}}}"
