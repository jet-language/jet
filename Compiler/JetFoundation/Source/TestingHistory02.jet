fn comparison_json(comparison: ComparisonRecord) -> String Never! {
    samples :: comparison.samples.map(sample_json).join(",")
    contamination :: if comparison.contamination == { .Val(value) -> quote(value) .None -> "null" }
    difference :: if comparison.first_difference == { .Val(value) -> value.to_string() .None -> "null" }
    reason :: if comparison.reason == { .Val(value) -> quote(value) .None -> "null" }
    "{{\"contamination\":{contamination},\"discardedCases\":{comparison.discarded_cases},\"firstDifference\":{difference},\"reason\":{reason},\"relation\":{quote(comparison.relation.as_str())},\"samples\":[{samples}],\"status\":{quote(comparison.status.as_str())},\"universalProof\":{comparison.universal_proof}}}"
}
