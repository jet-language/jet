// Rust: crates/jet-foundation/src/TestingHistory.rs:2252
pub struct HistoryArtifact {
    pub artifact_id: String; pub identity: ComparisonIdentity; pub case: HistoryCase
    pub cases: Int; pub bounds: HistoryBounds; pub distributions: [HistoryDistribution]
    pub discarded_cases: Int; pub vacuous_preconditions: Int; pub command_type: String
    pub oracle: OracleDeclaration; pub comparison: ComparisonRecord
