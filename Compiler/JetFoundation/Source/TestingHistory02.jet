impl HistoryArtifact {
    // Rust: crates/jet-foundation/src/TestingHistory.rs:2267
    fn new(config: HistoryConfig, case: ^HistoryCase, comparison: ^ComparisonRecord, discarded_cases: Int) -> HistoryArtifact HistoryError! {
        sample :: comparison.first_mismatch() ?? return Err(HistoryError.NoFailure)
        identity := ~sample.identity
        identity.seed = Val(case.seed)
        vacuous :: case.vacuous_preconditions()
        artifact := HistoryArtifact{artifact_id: "", identity: ^identity, case: ^case, cases: config.cases, bounds: config.bounds, distributions: ~config.distributions, discarded_cases: discarded_cases, vacuous_preconditions: vacuous, command_type: ~config.command_type, oracle: ~config.oracle, comparison: ^comparison}
        artifact.artifact_id = SHA256.sha256_hex(artifact.payload_json().as_bytes())
        artifact.validate()?
        Ok(^artifact)
    }
    // Rust: crates/jet-foundation/src/TestingHistory.rs:2297
    pub fn validate(self) -> Unit HistoryError! {
        self.case.validate()?
        if !case_within_bounds(self.case, self.bounds) -> return Err(HistoryError.InvalidCase("artifact case exceeds its recorded history bounds"))
        self.oracle.validate_independence()?
        if !self.identity.is_complete() -> return Err(HistoryError.InvalidCase("artifact identity is incomplete"))
        if self.identity.seed != Val(self.case.seed) -> return Err(HistoryError.InvalidCase("artifact identity seed does not match the replay case"))
        if self.command_type.is_empty() || self.command_type.len() > MAX_STRING_BYTES -> return Err(HistoryError.InvalidCase("artifact command type must be non-empty and bounded"))
        if self.vacuous_preconditions != self.case.vacuous_preconditions() -> return Err(HistoryError.InvalidCase("artifact vacuous-precondition count does not match its case"))
        if self.comparison.status != ComparisonStatus.Mismatch -> return Err(HistoryError.InvalidCase("history artifact must retain a comparison mismatch"))
        if self.comparison.universal_proof -> return Err(HistoryError.InvalidCase("finite history cannot be marked as universal proof"))
        if self.identity.case_id != self.case.case_id -> return Err(HistoryError.InvalidCase("artifact identity case does not match the replay case"))
        if self.identity.input_id != self.case.input_id() -> return Err(HistoryError.InvalidCase("artifact identity input does not match the replay case"))
        sample :: self.comparison.first_mismatch() ?? return Err(HistoryError.InvalidCase("history artifact has no mismatch sample"))
        if sample.identity != self.identity -> return Err(HistoryError.InvalidCase("artifact identity does not match the mismatch sample"))
        expected_id :: SHA256.sha256_hex(self.payload_json().as_bytes())
        if self.artifact_id != expected_id -> return Err(HistoryError.InvalidCase("artifact identity hash does not match its payload"))
        Ok(())
    }
    // Rust: crates/jet-foundation/src/TestingHistory.rs:2366
    pub fn json(self) -> String Never! {
        payload :: self.payload_json()
        body := payload.strip_prefix('{') ?? payload // #4303
        "{{\"artifactId\":{quote(self.artifact_id)},{body}"
    }
    // Rust: crates/jet-foundation/src/TestingHistory.rs:2378
    pub fn write_json(self, path: OSPath) -> Unit HistoryError! {
        self.validate()?
        contents :: "{self.json()}\n"
        // GATE #4494: retained filesystem descriptors, exclusive creation, fsync and atomic rename.
        metadata_result :: fs.symlink_metadata(path)
        if metadata_result == .Ok(metadata) {
            if metadata.file_type().is_symlink() || !metadata.is_file() -> return Err(HistoryError.Io("artifact path is not a regular file: {path.display()}"))
            existing :: fs.read(path).map_err(fn(error) { HistoryError.Io(error.to_string()) })?
            if existing == contents.as_bytes() -> return Ok(())
            return Err(HistoryError.Io("refusing to overwrite differing artifact: {path.display()}"))
        }
        if path.parent() == .Val(parent) -> fs.create_dir_all(parent).map_err(fn(error) { HistoryError.Io(error.to_string()) })?
        digest :: SHA256.sha256_hex(contents.as_bytes())
        temporary :: path.with_extension("json.tmp.{process.id()}.{digest[0..<8]}")
        write_result :: (fn() -> Unit HistoryError! {
            file := fs.OpenOptions.new().write(true).create_new(true).open(temporary).map_err(fn(error) { HistoryError.Io(error.to_string()) })?
            &file.write_all(contents.as_bytes()).map_err(fn(error) { HistoryError.Io(error.to_string()) })?
            file.sync_all().map_err(fn(error) { HistoryError.Io(error.to_string()) })?
            Ok(())
        })()
        if write_result == .Err(error) { _ :: fs.remove_file(temporary); return Err(^error) }
        fs.rename(temporary, path).map_err(fn(error) { _ :: fs.remove_file(temporary); HistoryError.Io(error.to_string()) })?
        if path.parent() == .Val(parent) -> fs.File.open(parent).map_err(fn(error) { HistoryError.Io(error.to_string()) })?.sync_all().map_err(fn(error) { HistoryError.Io(error.to_string()) })?
        Ok(())
    }
    // Rust: crates/jet-foundation/src/TestingHistory.rs:2434
    fn payload_json(self) -> String Never! {
        operations :: self.case.operations.map(fn(operation) { operation.json() }).join(",")
        schedule :: self.case.schedule.map(fn(choice) { choice.json() }).join(",")
        distributions :: self.distributions.map(fn(distribution) { distribution.json() }).join(",")
        "{{\"bounds\":{{\"maxDiscardedCases\":{self.bounds.max_discarded_cases},\"maxResources\":{self.bounds.max_resources},\"maxSteps\":{self.bounds.max_steps},\"maxShrinkAttempts\":{self.bounds.max_shrink_attempts}}},\"case\":{quote(self.case.case_id)},\"cases\":{self.cases},\"commandType\":{quote(self.command_type)},\"comparison\":{comparison_json(self.comparison)},\"discardedCases\":{self.discarded_cases},\"distributions\":[{distributions}],\"identity\":{identity_json(self.identity)},\"operations\":[{operations}],\"oracle\":{oracle_json(self.oracle)},\"schedule\":[{schedule}],\"schema\":{quote(HISTORY_SCHEMA)},\"seed\":{self.case.seed},\"vacuousPreconditions\":{self.vacuous_preconditions},\"version\":{HISTORY_VERSION}}}"
    }
}
