    // Rust: crates/jet-foundation/src/TestingHistory.rs:1896
    pub fn validate(self) -> Unit HistoryError! {
        if self.max_steps == 0 || self.max_steps > MAX_STEPS -> return Err(HistoryError.InvalidConfig("max_steps must be between 1 and the history limit"))
        if self.max_resources == 0 || self.max_resources > MAX_RESOURCES -> return Err(HistoryError.InvalidConfig("max_resources must be between 1 and the history limit"))
        if self.max_shrink_attempts == 0 || self.max_shrink_attempts > MAX_SHRINK_ATTEMPTS -> return Err(HistoryError.InvalidConfig("max_shrink_attempts must be between 1 and the history limit"))
        if self.max_discarded_cases > MAX_CASES -> return Err(HistoryError.InvalidConfig("max_discarded_cases exceeds the history limit"))
        Ok(())
    }
}
