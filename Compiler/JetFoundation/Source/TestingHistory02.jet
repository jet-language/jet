// Rust: crates/jet-foundation/src/TestingHistory.rs:1996
pub struct OracleDeclaration { pub root: String; pub dependencies: [OracleDependency] }
impl OracleDeclaration {
    // Rust: crates/jet-foundation/src/TestingHistory.rs:2002
    pub fn independent(root: ^String) -> OracleDeclaration Never! { OracleDeclaration{root: ^root, dependencies: []} }
    // Rust: crates/jet-foundation/src/TestingHistory.rs:2009
    pub fn with_dependency(self: ^OracleDeclaration, dependency: ^OracleDependency) -> OracleDeclaration Never! { &self.dependencies.push(^dependency); ^self }
    // Rust: crates/jet-foundation/src/TestingHistory.rs:2014
    pub fn validate_independence(self) -> Unit HistoryError! {
        if self.root.is_empty() || self.root.len() > MAX_STRING_BYTES -> return Err(HistoryError.InvalidOracle("oracle root must be non-empty and bounded"))
        reachable := [~self.root]
        visited := [String:Bool]{}
        loop {
            node :: &reachable.pop() ?? break
            if visited.has_key(node) -> continue
            visited[~node] = true
            loop dependency in self.dependencies {
                if dependency.from != node -> continue
                if dependency.from == dependency.to -> return Err(HistoryError.InvalidOracle("oracle dependency `{dependency.from}` is self-confirming"))
                if dependency.kind == {
                    .Independent -> &reachable.push(~dependency.to)
                    .ProductionBehavior -> return Err(HistoryError.InvalidOracle("oracle `{dependency.from}` reaches production behavior `{dependency.to}`"))
                    .Opaque | .Unknown -> return Err(HistoryError.InvalidOracle("oracle dependency `{dependency.from}` -> `{dependency.to}` is not certifiably independent ({dependency.kind.as_str()})"))
                }
            }
        }
        Ok(())
    }
}
