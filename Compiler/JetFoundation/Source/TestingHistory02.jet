        Ok(())
    }
}
// Rust: crates/jet-foundation/src/TestingHistory.rs:2161
pub struct HistoryRng { state: U64 }
impl HistoryRng {
    // Rust: crates/jet-foundation/src/TestingHistory.rs:2166
    pub fn new(seed: U64) -> HistoryRng Never! { HistoryRng{state: seed} }
    // Rust: crates/jet-foundation/src/TestingHistory.rs:2170
    pub fn state(self) -> U64 Never! { self.state }
    // Rust: crates/jet-foundation/src/TestingHistory.rs:2174
    pub fn replace_state(self: &HistoryRng, state: U64) -> Unit Never! { self.state = state }
    // Rust: crates/jet-foundation/src/TestingHistory.rs:2178
    pub fn next_u64(self: &HistoryRng) -> U64 Never! {
        self.state = self.state.wrapping_add(U64{0x9E3779B97F4A7C15})
        value := self.state
        value = (value ^ (value >> 30)).wrapping_mul(U64{0xBF58476D1CE4E5B9})
        value = (value ^ (value >> 27)).wrapping_mul(U64{0x94D049BB133111EB})
        value ^ (value >> 31)
    }
    // Rust: crates/jet-foundation/src/TestingHistory.rs:2186
    pub fn below(self: &HistoryRng, bound: U64) -> U64 Never! { if bound == 0 -> return 0; self.next_u64() % bound }
    // Rust: crates/jet-foundation/src/TestingHistory.rs:2193
    pub fn coin(self: &HistoryRng) -> Bool Never! { self.below(2) == 0 }
    // Rust: crates/jet-foundation/src/TestingHistory.rs:2200
    pub fn choose_distribution(self: &HistoryRng, distributions: [HistoryDistribution]) -> Int? Never! {
        total := U64{0}
        loop distribution in distributions {
            weight :: U64.try_from(distribution.weight).ok() ?? return None
            total = total.checked_add(weight) ?? return None
        }
        if total == 0 -> return None
        choice := self.below(total)
        loop index in 0..<distributions.len() {
            weight :: U64.try_from(distributions[index].weight).ok() ?? return None
            if choice < weight -> return Val(index)
            choice -= weight
        }
        None
    }
}
