//RS /// Whether a built-in method mutates its receiver (needs `var` binding).
//RS pub fn builtin_method_mutates(recv_ty: &Type, method: &str) -> bool {
//RS     if let Type::Tagged { inner, .. } = recv_ty {
//RS         return builtin_method_mutates(inner, method);
//RS     }
//RS     match recv_ty {
//RS         // An ordinary fallible binding exposes its success payload to the
//RS         // enclosing function. Keep its mutation contract aligned with the
//RS         // payload table while pre-sema lowering still sees the carrier.
//RS         Type::Result { ok, .. } => builtin_method_mutates(ok, method),
//RS         Type::List(_) | Type::FixedList { .. } => matches!(
//RS             method,
//RS             "push"
//RS                 | "append"
//RS                 | "try_push"
//RS                 | "try_reserve"
//RS                 | "pop"
//RS                 | "insert"
//RS                 | "remove"
//RS                 | "extend"
//RS                 | "reverse"
//RS                 | "sort"
//RS                 | "sort_by"
//RS                 | "sort_desc"
//RS                 | "sort_by_desc"
//RS                 | "clear"
//RS                 | "update_first"
//RS                 | "split_write"
//RS                 | "get_disjoint_write"
//RS                 | "edit_disjoint"
//RS         ),
//RS         Type::Map { .. } => matches!(
//RS             method,
//RS             "add"
//RS                 | "replace"
//RS                 | "try_insert"
//RS                 | "add_new"
//RS                 | "setdefault"
//RS                 | "remove"
//RS                 | "pop"
//RS                 | "pop_first"
//RS                 | "clear"
//RS                 | "update"
//RS         ),
//RS         Type::String => method == "try_push",
//RS         // D-COLLBREADTH1=A: Set mutating methods.
//RS         Type::Apply { name, .. } if name == "Set" => {
//RS             matches!(
//RS                 method,
//RS                 "add"
//RS                     | "remove"
//RS                     | "discard"
