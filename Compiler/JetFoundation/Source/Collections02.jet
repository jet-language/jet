//RS 
//RS /// Whether receiver convention for a built-in call must be `mut`.
//RS pub fn builtin_needs_mut_receiver(recv_ty: &Type, method: &str) -> bool {
//RS     builtin_method_mutates(recv_ty, method)
//RS }
//RS 
//RS /// Generated Rust receiver-borrow form for a builtin call. This is shared by
//RS /// sema's call-loan timing and TIR lowering so the two cannot drift.
//RS #[derive(Debug, Clone, Copy, PartialEq, Eq)]
//RS pub enum BuiltinReceiverBorrow {
//RS     Read,
//RS     TwoPhaseWrite,
//RS     EagerWrite,
//RS     Move,
//RS }
//RS 
//RS pub fn builtin_receiver_borrow(recv_ty: &Type, method: &str) -> BuiltinReceiverBorrow {
//RS     fn is_list_receiver(ty: &Type) -> bool {
//RS         match ty {
//RS             Type::List(_) | Type::FixedList { .. } => true,
//RS             Type::Tagged { inner, .. } | Type::Result { ok: inner, .. } => {
//RS                 is_list_receiver(inner)
//RS             }
//RS             _ => false,
//RS         }
//RS     }
