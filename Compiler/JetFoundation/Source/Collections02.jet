//RS /// D-COLLBREADTH1=A: `Set<T>` methods (hash-backed unordered set).
//RS fn set_method_return(elem: &Type, method: &str, nargs: usize) -> Option<Option<Type>> {
//RS     let set_of_elem = || Type::Apply {
//RS         name: "Set".to_string(),
//RS         args: vec![elem.clone()],
//RS     };
//RS     match (method, nargs) {
//RS         ("len", 0) => Some(Some(Type::Int)),
//RS         ("is_empty", 0) => Some(Some(Type::Bool)),
//RS         ("add", 1) => Some(Some(Type::Bool)),
//RS         ("remove" | "clear", _) => Some(None),
//RS         ("has", 1) => Some(Some(Type::Bool)),
//RS         ("union", 1) => Some(Some(set_of_elem())),
//RS         ("intersection" | "difference" | "symmetric_difference", 1) => Some(Some(set_of_elem())),
//RS         ("is_subset" | "issubset" | "is_superset" | "issuperset" | "is_disjoint" | "isdisjoint", 1) => Some(Some(Type::Bool)),
//RS         ("to_list", 0) => Some(Some(Type::List(Box::new(elem.clone())))),
//RS         // #1478: remaining Set surface (non-closure).
//RS         ("copy" | "to_set", 0) => Some(Some(set_of_elem())),
//RS         ("discard" | "update" | "difference_update" | "intersection_update" | "symmetric_difference_update", 1) => Some(None),
//RS         ("equal", 1) => Some(Some(Type::Bool)),
//RS         ("capacity", 0) => Some(Some(Type::Int)),
//RS         ("first", 0) => Some(Some(Type::Option(Box::new(elem.clone())))),
//RS         // #1478: ledger closes on Set's remaining order-agnostic surface.
//RS         // `values` is the lazy alias of `to_list` (I8, mirrors `Map.values`).
//RS         ("values", 0) => Some(Some(iter_ty(elem.clone()))),
//RS         // D-ONCE-VERB1=A: Set.pop/take remove and return a matching value.
//RS         ("pop" | "take", 1) => Some(Some(Type::Option(Box::new(elem.clone())))),
//RS         // Rust HashSet::replace inserts the value and returns the displaced equal value.
//RS         ("replace", 1) => Some(Some(Type::Option(Box::new(elem.clone())))),
//RS         ("all", 1) => Some(Some(Type::Bool)),
//RS         ("each", 1) => Some(None),
//RS         ("filter", 1) => Some(Some(Type::List(Box::new(elem.clone())))),
//RS         ("min" | "max", 0) => Some(Some(Type::Option(Box::new(elem.clone())))),
//RS         // `map`/`fold`/`flat_map` placeholders — sema refines from the
//RS         // closure body's actual return type, same as the List surface.
//RS         ("map", 1) => Some(Some(Type::List(Box::new(Type::Int)))),
//RS         ("fold", 2) => Some(Some(Type::Int)),
//RS         ("flat_map", 1) => Some(Some(iter_ty(Type::Int))),
//RS         // D-SET-DECLINE1=C: `sort`/`shuffle` turn an unordered Set into an
//RS         // ordered `List`, the same to-list-then-List machinery `filter`/`map`/
//RS         // `fold`/`each`/`all`/`min`/`max` already run. Neither mutates the Set.
//RS         ("sort" | "shuffle", 0) => Some(Some(Type::List(Box::new(elem.clone())))),
//RS         // #1478: `flatten` declined — E0506 forbids a Set element type that
//RS         // is itself a List/Set (Set elements must be Hash+Eq), so no legal
//RS         // `Set<T>` can ever satisfy `flatten`'s nested-container precondition.
//RS         // `indexof`/`indexed` also declined — a hash Set keeps no stable
//RS         // position for `index_of`/`indexed` to answer. See the D-SET-DECLINE1
//RS         // ballot for the full declined-name rationale.
//RS         _ => None,
//RS     }
//RS }
//RS 
