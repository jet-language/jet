        ("is_empty" | "eof" | "is_ascii", 0) | ("contains" | "starts_with" | "ends_with", 1) -> Val(Val(Type.Bool))
        ("clear" | "rewind" | "flush" | "close" | "shutdown", 0) | ("seek" | "copy_to" | "write_to", 1) -> Val(None)
        ("to_bytes" | "get_buffer" | "buffer", 0) -> Val(Val(Type.List{element: u8t()}))
        ("to_string" | "string", 0) -> Val(Val(Type.String))
        ("trim" | "trim_start" | "trim_end" | "to_lower" | "to_upper" | "to_title" | "title" | "clone" | "copy", 0) | ("join", 1) | ("replace", 2) -> Val(Val(Type.Named{name: Syntax.TYPE_BYTES}))
        ("lines", 0) | ("split", 1) -> Val(Val(Type.List{element: Type.String}))
        ("first" | "next" | "read_byte", 0) | ("get", 1) -> Val(Val(Type.Option{inner: u8t()}))
        ("read", 0) | ("read_bytes", 1) -> Val(Val(Type.Option{inner: Type.List{element: u8t()}}))
        ("read_string", 1) -> Val(Val(Type.Option{inner: Type.String}))
        ("index_of" | "last_index_of", 1) -> Val(Val(Type.Option{inner: Type.Int}))
        ("partition", 1) -> Val(Val(Type.Result{ok: Type.List{element: Type.Named{name: Syntax.TYPE_BYTES}}, err: Type.String}))
        ("equal", 1) -> Val(Val(Type.Bool))
        ("compare", 1) -> Val(Val(Type.Int))
        ("parse", 0) -> Val(Val(Type.Result{ok: Type.Int, err: Type.String}))
        ("write_u8" | "write_byte" | "write_i8" | "write_u16_le" | "write_u16_be" | "write_i16_le" | "write_i16_be" | "write_u32_le" | "write_u32_be" | "write_i32_le" | "write_i32_be" | "write_u64_le" | "write_u64_be" | "write_i64_le" | "write_i64_be" | "write_f32_le" | "write_f32_be" | "write_f64_le" | "write_f64_be" | "write_bytes" | "write", 1) -> Val(None)
        else -> None
    }
}
// Rust: crates/jet-foundation/src/Collections.rs:2688
fn bag_method_return(_elem: Type, method: String, nargs: Int) -> Type?? Never! {
    if (method, nargs) == { ("len", 0) | ("count", 1) -> Val(Val(Type.Int)) ("is_empty", 0) | ("add" | "has" | "any", 1) -> Val(Val(Type.Bool)) ("remove", 1) -> Val(None) else -> None }
}
// Rust: crates/jet-foundation/src/Collections.rs:2702
fn deque_method_return(elem: Type, method: String, nargs: Int) -> Type?? Never! {
    if (method, nargs) == {
        ("len" | "capacity", 0) -> Val(Val(Type.Int))
        ("is_empty", 0) | ("contains", 1) -> Val(Val(Type.Bool))
        ("push_front" | "push_back" | "clear" | "delete" | "reverse", _) -> Val(None)
        ("pop_front" | "pop_back" | "peek_front" | "peek_back", 0) | ("get", 1) -> Val(Val(Type.Option{inner: ~elem}))
        ("to_list", 0) -> Val(Val(Type.List{element: ~elem}))
        ("join", 1) -> Val(Val(Type.String))
        ("split", 1) -> Val(Val(Type.Apply{name: Syntax.TYPE_QUEUE, args: [Type]{~elem}}))
        else -> None
    }
}

// Rust: crates/jet-foundation/src/Collections.rs:2724
pub fn builtin_method_mutates(recv_ty: Type, method: String) -> Bool Never! {
    if recv_ty == {
        .Tagged(_, inner) | .Result(inner, _) -> builtin_method_mutates(inner, method)
        .List(_) | .FixedList(_, _) -> if method == { "push" | "append" | "try_push" | "try_reserve" | "pop" | "insert" | "remove" | "extend" | "reverse" | "sort" | "sort_by" | "sort_desc" | "sort_by_desc" | "clear" | "update_first" | "split_write" | "get_disjoint_write" | "edit_disjoint" -> true else -> false }
        .Map(_, _, _) -> if method == { "add" | "replace" | "try_insert" | "add_new" | "setdefault" | "remove" | "pop" | "pop_first" | "clear" | "update" -> true else -> false }
        .String -> method == "try_push"
        .Apply(name, _) if name == "Set" -> if method == { "add" | "remove" | "discard" | "update" | "difference_update" | "intersection_update" | "symmetric_difference_update" | "pop" | "replace" | "clear" -> true else -> false }
        .Apply(name, _) if name == Syntax.TYPE_RANK -> if method == { "add" | "remove" | "clear" -> true else -> false }
        .Apply(name, _) if name == Syntax.TYPE_PRIORITY_QUEUE -> if method == { "push" | "pop" | "clear" -> true else -> false }
        .Apply(name, _) if name == Syntax.TYPE_LRU -> if method == { "add" | "add_new" | "get" | "remove" | "clear" -> true else -> false }
        .Named(name) if name == Syntax.TYPE_BITS -> if method == { "add" | "remove" | "clear" -> true else -> false }
        .Named(name) if name == Syntax.TYPE_BYTES -> if method == { "write_u8" | "write_byte" | "write_i8" | "write_u16_le" | "write_u16_be" | "write_i16_le" | "write_i16_be" | "write_u32_le" | "write_u32_be" | "write_i32_le" | "write_i32_be" | "write_u64_le" | "write_u64_be" | "write_i64_le" | "write_i64_be" | "write_f32_le" | "write_f32_be" | "write_f64_le" | "write_f64_be" | "write_bytes" | "write" | "write_to" | "clear" | "seek" | "rewind" | "next" | "read" | "read_byte" | "read_bytes" | "read_string" | "flush" | "close" | "shutdown" | "copy_to" -> true else -> false }
        .Apply(name, _) if name == Syntax.TYPE_TALLY -> if method == { "add" | "remove" | "clear" -> true else -> false }
        .Apply(name, _) if name == Syntax.TYPE_QUEUE -> if method == { "push_front" | "push_back" | "pop_front" | "pop_back" | "clear" | "delete" | "reverse" | "split" -> true else -> false }
        .Apply(_, _) if is_iter_type(recv_ty) -> method == "next"
        .Named(name) if name == Syntax.CLOCK_TYPE -> if method == { "tick" | "advance" | "wait" -> true else -> false }
        .Named(name) if name == Syntax.RNG_TYPE -> if method == { "int" | "float" | "float_range" | "bool" | "normal" | "exponential" | "bytes" | "split" | "pick" | "weighted_pick" | "sample" | "shuffle" -> true else -> false }
        .Named("HistoryRNG") -> if method == { "next_u64" | "below" -> true else -> false }
        .Named(name) if name == Syntax.FAKE_TYPE -> if method == { "name" | "email" | "host" | "address" -> true else -> false }
        .Named(name) if name == Syntax.SOLVER_TYPE -> method == "require"
        else -> false
    }
}

// Rust: crates/jet-foundation/src/Collections.rs:2886
pub fn builtin_method_arg_types(recv_ty: Type, method: String) -> [Type]? Never! {
    if recv_ty == .Tagged(_, inner) -> return builtin_method_arg_types(inner, method)
    if Syntax.numeric_conversion_source(method) == .Val(source_name) {
        if Numeric.precise_conversion_return(recv_ty, method, 1) == .Val(_) {
            source := if source_name == {
                "Int" -> Type.Int
                "Float" -> Type.Float
                name if Numeric.is_exact_type_name(name) -> Type.Named{name: ~name}
                else -> return None
            }
            return Val([Type]{^source})
        }
    }
    if recv_ty.is_numeric() {
        if recv_ty == .IntN(_, _) && numeric_overflow_method(method, 1) == .Val(_) -> return Val([Type]{~recv_ty})
        if Syntax.numeric_conversion_source(method) == .Val(source_name) {
            if AST.numeric_type_from_name(source_name) == .Val(source) -> return Val([Type]{^source})
        }
    }
    if recv_ty == .Apply(name, args) {
        if name == "Atomic" && args.len() == 1 -> return atomic_method_arg_types(args[0], method)
    }
    if recv_ty == {
        .Named(n) if n == Syntax.TYPE_AUTHORITY && (method == "with" || method == "without") -> Val([Type]{Type.String})
        .Named(n) if n == Syntax.TYPE_ORDERING -> if method == {
            "then" -> Val([Type]{Type.Named{name: Syntax.TYPE_ORDERING}})
            "reverse" -> Val([Type]{})
            else -> None
        }
        .Named(n) if n == Syntax.TYPE_RANGE && method == "contains" -> Val([Type]{Type.Int})
        .Named("WrappedVaultKey") if method == "from_bytes" -> Val([Type]{Type.List{element: Type.IntN{signed: false, bits: 8}}})
        .Named("KeyUnlock") if method == "Recipient" -> Val([Type]{Type.Named{name: "X25519SecretKey"}})
        .Named("KeyUnlock") if method == "Passphrase" -> Val([Type]{Type.Named{name: "Secret"}})
        .Named(n) if n == Syntax.DURATION_TYPE && method == Syntax.METHOD_DURATION_IN -> Val([Type]{Type.Named{name: Syntax.DURATION_UNIT_TYPE}})
        .Named(n) if n == Syntax.DURATION_TYPE && method == "difference" -> Val([Type]{Type.Named{name: Syntax.DURATION_TYPE}})
        .Named(n) if n == Syntax.DURATION_TYPE && method == "total_in" -> Val([Type]{Type.String})
        .Named(n) if n == Syntax.DURATION_TYPE && method == "round" -> Val([Type]{Type.String, Type.Int, Type.String})
        .Named("WrappedVaultKey") -> Val([Type]{})
        .Named(n) if n == Syntax.TYPE_BUILD_CONTEXT -> if method == {
            "generate" | "find" | "embed" -> Val([Type]{Type.String})
            "fetch" | "plugin" -> Val([Type]{Type.String, Type.String})
            "action" -> Val([Type]{Type.String, Type.List{element: Type.String}, Type.List{element: Type.String}, Type.List{element: Type.String}, Type.List{element: Type.String}, Type.Named{name: Syntax.TYPE_BUILD_TOOLCHAIN}, Type.List{element: Type.Named{name: Syntax.TYPE_BUILD_PROBE}}})
            "legacy" -> Val([Type]{Type.String, Type.String, Type.List{element: Type.String}, Type.List{element: Type.String}, Type.List{element: Type.String}, Type.List{element: Type.String}})
            "add_executable" | "add_library" | "add_test" | "add_asset_bundle" | "add_doc" | "add_install" | "add_package" | "add_publish" -> Val([Type]{Type.String, Type.List{element: Type.String}, Type.List{element: Type.Named{name: Syntax.TYPE_BUILD_ACTION}}})
            "toolchain" -> Val([Type]{Type.String, Type.String})
            "probe" -> Val([Type]{Type.String, Type.String, Type.String})
            "error" -> Val([Type]{Type.Named{name: Syntax.TYPE_SOURCE_SPAN}, Type.String, Type.String, Type.String, Type.String})
            "plan" -> Val([Type]{Type.Named{name: Syntax.TYPE_BUILD_TARGET}})
            else -> None
        }
        .Named(n) if n == Syntax.TYPE_PROGRAM_INFO -> Val([Type]{})
        .Named(n) if n == Syntax.TYPE_TYPE_INFO && (method == "implements" || method == "has_method" || method == "has_marker") -> Val([Type]{Type.String})
        .Named("FieldInfo" | "MethodInfo") if method == "has_marker" -> Val([Type]{Type.String})
        .Named("CompilerLexed") if method == "source" || method == "tokens" || method == "diagnostics" -> Val([Type]{})
        .Named("CompilerSyntaxTree") if method == "source" || method == "items" || method == "diagnostics" -> Val([Type]{})
        .Named("CompilerChecked") if method == "source" || method == "syntax" || method == "functions" || method == "effects" || method == "diagnostics" || method == "semantic_index" -> Val([Type]{})
        .Named("CompilerSourceMap") if method == "sources" || method == "generated_lines" -> Val([Type]{})
        .Named("FunctionInfo") if method == "reaches_panic" -> Val([Type]{})
        .Named("EffectInfo") if method == "has" -> Val([Type]{Type.String})
        .Apply(name, args) if (name == Syntax.TYPE_ITER || name == Syntax.TYPE_VIEW_ITER) && args.len() == 1 -> {
            if method == "to_list" || method == "collect" -> return Val([Type]{})
            builtin_method_arg_types(Type.List{element: ~args[0]}, method)
        }
        .List(inner) -> if method == {
            "try_new" -> Val([Type]{})
            "try_with_capacity" | "try_reserve" | "get" | "split_write" -> Val([Type]{Type.Int})
            "push" | "append" | "try_push" | "contains" | "index_of" | "index" | "count" -> Val([Type]{~inner})
            "insert" -> Val([Type]{Type.Int, ~inner})
            "remove" -> Val([Type]{~inner, Type.Named{name: Syntax.TYPE_REMOVE_BY}})
            "extend" | "concat" -> Val([Type]{Type.List{element: ~inner}})
            "get_disjoint_write" -> Val([Type]{Type.List{element: Type.Int}})
            "edit_disjoint" -> Val([Type]{Type.List{element: Type.Int}, sema_collection_fn([Type]{Type.Apply{name: "ViewMut", args: [Type]{~inner}}, Type.Apply{name: "ViewMut", args: [Type]{~inner}}}, None)})
            "join" -> Val([Type]{Type.String})
            // Open callback returns preserve sema refinement and implicit failure rows.
            "map" | "filter" | "each" | "min_by" | "max_by" | "group_by" | "count_by" | "flat_map" | "filter_map" | "para_map" | "dedup_by" | "is_sorted_by" | "binary_search_by" | "min_max_by" -> Val([Type]{sema_collection_fn([Type]{~inner}, None)})
            "find" | "any" | "all" | "count_where" | "take_while" | "skip_while" | "position" | "partition" | "para_filter" | "para_partition" -> Val([Type]{sema_collection_fn([Type]{~inner}, Val(Type.Bool))})
            "update_first" -> Val([Type]{sema_collection_fn([Type]{~inner}, Val(Type.Bool)), ~inner})
            "sort_by" | "sort_by_desc" -> Val([Type]{sort_by_callback_type(inner, false)})
            "reduce" | "fold" | "scan" -> Val([Type]{Type.Int, sema_collection_fn([Type]{Type.Int, ~inner}, Val(Type.Int))})
            "para_fold" -> Val([Type]{sema_collection_fn([Type]{}, None), sema_collection_fn([Type]{Type.Int, ~inner}, Val(Type.Int)), sema_collection_fn([Type]{Type.Int, Type.Int}, Val(Type.Int))})
            "take" | "skip" | "step_by" | "chunks" | "windows" | "repeat" | "drop_last" | "split" | "cycle" -> Val([Type]{Type.Int})
            "intersperse" | "last_index_of" | "binary_search" -> Val([Type]{~inner})
            "replace" -> Val([Type]{Type.Int, ~inner})
            "compare" | "starts_with" | "ends_with" | "equal" | "union" | "intersection" | "difference" -> Val([Type]{Type.List{element: ~inner}})
            "slice" | "view" -> Val([Type]{Type.Int, Type.Int})
            "zip" | "dedup" | "indexed" | "indexes" | "sum" | "product" | "min" | "max" | "flatten" | "unzip" | "is_sorted" | "shuffle" | "average" | "to_set" | "copy" | "random" | "min_max" | "counts" -> Val([Type]{})
            "chunk_while" -> Val([Type]{sema_collection_fn([Type]{~inner, ~inner}, Val(Type.Bool))})
            else -> Val([Type]{})
        }
        .Map(key, _, value) -> if method == {
            "add" | "try_insert" | "add_new" -> Val([Type]{~key, ~value})
            "get" | "remove" | "pop" | "has_key" -> Val([Type]{~key})
            "contains_value" -> Val([Type]{~value})
            "merge" | "equal" | "intersection" | "update" -> Val([Type]{Type.Map{key: ~key, key_span: None, value: ~value}})
            "slice" -> Val([Type]{Type.List{element: ~key}})
            "top_n" -> Val([Type]{Type.Int})
            "any" | "all" | "filter" -> Val([Type]{sema_collection_fn([Type]{~key, ~value}, Val(Type.Bool))})
            "map" | "flat_map" | "each" -> Val([Type]{sema_collection_fn([Type]{~key, ~value}, None)})
            "fold" -> Val([Type]{Type.Int, sema_collection_fn([Type]{Type.Int, ~key, ~value}, Val(Type.Int))})
            else -> Val([Type]{})
        }
        .String -> if method == {
            "try_push" | "contains" | "starts_with" | "startswith" | "ends_with" | "endswith" | "split" | "rsplit" | "index_of" | "index" | "rindex" | "count" | "find" | "rfind" | "partition" | "rpartition" | "split_once" | Syntax.METHOD_CUT_LAST | "removeprefix" | "removesuffix" | "after" | "before" | "last_index_of" | "compare" | "equal" | "matches" | "match" -> Val([Type]{Type.String})
            "zfill" | "expandtabs" | "repeat" -> Val([Type]{Type.Int})
            "center" | "ljust" | "rjust" | "pad_start" | "pad_end" -> Val([Type]{Type.Int, Type.String})
            "from_bytes" | "from_bytes_lossy" -> Val([Type]{Type.List{element: u8t()}})
            "replace" -> Val([Type]{Type.String, Type.String})
            "slice" -> Val([Type]{Type.Int, Type.Int})
            else -> None
        }
        .Int | .Float -> if method == {
            "parse" -> Val([Type]{Type.String})
            Syntax.METHOD_DIV_EUCLID | Syntax.METHOD_REM_EUCLID | "to_radix" if recv_ty == Type.Int -> Val([Type]{Type.Int})
            "from_radix" if recv_ty == Type.Int -> Val([Type]{Type.String, Type.Int})
            else -> None
        }
        .Option(inner) -> if method == {
            "or_err" -> Val([Type]{Type.String})
            "map" -> Val([Type]{sema_collection_fn([Type]{~inner}, None)})
            else -> Val([Type]{})
        }
        .Apply("Sender", args) -> if method == { "send" -> Val([Type]{args.first() ?? Type.Int}) else -> Val([Type]{}) }
        .Apply("Task", _) -> Val([Type]{})
        .Apply("Cell", args) -> {
            t := args.first() ?? Type.Int
            if method == {
                "set" | "replace" -> Val([Type]{~t})
                "get_or_set" -> {
                    value := if t == { .Option(inner) -> ~inner else -> ^t }
                    Val([Type]{sema_collection_fn([Type]{}, Val(^value))})
                }
                "read" | "edit" -> Val([Type]{sema_collection_fn([Type]{^t}, None)})
                else -> Val([Type]{})
            }
        }
        .Apply("CellReadGuard" | "CellEditGuard", args) -> {
            t := args.first() ?? Type.Int
            if method == {
                "set" -> Val([Type]{~t})
                "read" | "edit" | "map" -> Val([Type]{sema_collection_fn([Type]{^t}, None)})
                "split" -> Val([Type]{sema_collection_fn([Type]{~t}, None), sema_collection_fn([Type]{^t}, None)})
                else -> Val([Type]{})
            }
        }
        // Preserve Rust arm order: this Rank arm precedes the later wider arm.
        .Apply(name, args) if name == Syntax.TYPE_RANK -> if method == {
            "add" | "remove" | "has" -> Val([Type]{args.first() ?? Type.Int})
            "union" -> Val([Type]{Type.Apply{name: Syntax.TYPE_RANK, args: [Type]{args.first() ?? Type.Int}}})
            else -> Val([Type]{})
        }
        .Apply(name, args) if name == Syntax.TYPE_PRIORITY_QUEUE -> if method == {
            "push" -> Val([Type]{args.first() ?? Type.Int})
            "remove" -> Val([Type]{args.first() ?? Type.Int, Type.Named{name: Syntax.TYPE_REMOVE_BY}})
            else -> Val([Type]{})
        }
        .Apply(name, args) if name == Syntax.TYPE_LRU && args.len() >= 2 -> if method == {
            "add" | "add_new" -> Val([Type]{~args[0], ~args[1]})
            "get" | "remove" | "has_key" -> Val([Type]{~args[0]})
            else -> Val([Type]{})
        }
        .Named(n) if n == Syntax.TYPE_BITS -> if method == { "add" | "remove" | "has" -> Val([Type]{Type.Int}) else -> Val([Type]{}) }
        .Named(n) if n == Syntax.TYPE_BYTES -> if method == {
            "write_bytes" | "write" -> Val([Type]{Type.List{element: u8t()}})
            "write_u8" | "write_byte" -> Val([Type]{u8t()})
            "write_i8" -> Val([Type]{Type.IntN{signed: true, bits: 8}})
            "write_u16_le" | "write_u16_be" -> Val([Type]{Type.IntN{signed: false, bits: 16}})
            "write_i16_le" | "write_i16_be" -> Val([Type]{Type.IntN{signed: true, bits: 16}})
            "write_u32_le" | "write_u32_be" -> Val([Type]{Type.IntN{signed: false, bits: 32}})
            "write_i32_le" | "write_i32_be" -> Val([Type]{Type.IntN{signed: true, bits: 32}})
            "write_u64_le" | "write_u64_be" -> Val([Type]{Type.IntN{signed: false, bits: 64}})
            "write_i64_le" | "write_i64_be" -> Val([Type]{Type.IntN{signed: true, bits: 64}})
            "write_f32_le" | "write_f32_be" -> Val([Type]{Type.Float32})
            "write_f64_le" | "write_f64_be" -> Val([Type]{Type.Float})
            "seek" | "read_bytes" | "read_string" | "get" -> Val([Type]{Type.Int})
            "contains" | "starts_with" | "ends_with" | "split" | "index_of" | "last_index_of" -> Val([Type]{Type.String})
            "partition" | "equal" | "compare" | "copy_to" | "write_to" -> Val([Type]{Type.Named{name: Syntax.TYPE_BYTES}})
            "replace" -> Val([Type]{Type.String, Type.String})
            "join" -> Val([Type]{Type.List{element: Type.String}})
            else -> Val([Type]{})
        }
        .Apply(name, args) if name == Syntax.TYPE_SIGNAL -> if method == { "set" -> Val([Type]{args.first() ?? Type.Int}) else -> Val([Type]{}) }
        .Apply(name, _) if name == Syntax.TYPE_DERIVED -> Val([Type]{})
        .Apply(name, _) if name == Syntax.TYPE_COMPUTED -> Val([Type]{})
        .Apply(name, args) if name == Syntax.TYPE_EVENT -> {
            payload := args.first() ?? Type.Int
            if method == {
                "on" | "once" -> Val([Type]{Type.Named{name: Syntax.TYPE_EVENT_SCOPE}, sema_collection_fn([Type]{^payload}, None)})
                "on_priority" -> Val([Type]{Type.Named{name: Syntax.TYPE_EVENT_SCOPE}, Type.Int, sema_collection_fn([Type]{^payload}, None)})
                "emit" -> Val([Type]{^payload})
                else -> Val([Type]{})
            }
        }
        .Apply(name, args) if name == Syntax.TYPE_ASYNC_EVENT -> {
            payload := args.first() ?? Type.Int
            error := args.get(1) ?? Type.String
            handler_ret := Type.Result{ok: Type.Named{name: Syntax.INTERNAL_UNIT_TYPE}, err: ^error}
            if method == {
                "on" | "once" -> Val([Type]{Type.Named{name: Syntax.TYPE_EVENT_SCOPE}, sema_collection_fn([Type]{^payload}, Val(^handler_ret))})
                "on_priority" -> Val([Type]{Type.Named{name: Syntax.TYPE_EVENT_SCOPE}, Type.Int, sema_collection_fn([Type]{^payload}, Val(^handler_ret))})
                "emit_async" -> Val([Type]{^payload})
                else -> Val([Type]{})
            }
        }
        .Apply(name, args) if name == Syntax.TYPE_HOOK -> {
            payload := args.first() ?? Type.Int
            result := args.get(1) ?? Type.Int
            if method == {
                "on" | "once" -> Val([Type]{Type.Named{name: Syntax.TYPE_EVENT_SCOPE}, sema_collection_fn([Type]{^payload}, Val(^result))})
                "on_priority" -> Val([Type]{Type.Named{name: Syntax.TYPE_EVENT_SCOPE}, Type.Int, sema_collection_fn([Type]{^payload}, Val(^result))})
                "run" -> Val([Type]{^payload, ^result})
                else -> Val([Type]{})
            }
        }
        .Apply(name, args) if name == Syntax.TYPE_DECISION_HOOK -> {
            payload := args.first() ?? Type.Int
            error := args.get(1) ?? Type.String
            decision := Type.Apply{name: Syntax.TYPE_HOOK_DECISION, args: [Type]{~payload, ^error}}
            if method == {
                "on" | "once" -> Val([Type]{Type.Named{name: Syntax.TYPE_EVENT_SCOPE}, sema_collection_fn([Type]{^payload}, Val(^decision))})
                "on_priority" -> Val([Type]{Type.Named{name: Syntax.TYPE_EVENT_SCOPE}, Type.Int, sema_collection_fn([Type]{^payload}, Val(^decision))})
                "run" -> Val([Type]{^payload})
                else -> Val([Type]{})
            }
        }
        .Named(n) if n == Syntax.TYPE_EFFECT || n == Syntax.TYPE_SUBSCRIPTION || n == Syntax.TYPE_EVENT_SCOPE || n == Syntax.TYPE_EVENT_TRACE -> Val([Type]{})
        .Named(n) if n == Syntax.TYPE_WATCH_HANDLE -> if method == {
            "on" | "once" -> Val([Type]{Type.Named{name: Syntax.TYPE_EVENT_SCOPE}, sema_collection_fn([Type]{Type.Named{name: Syntax.TYPE_WATCH_EVENT}}, None)})
            else -> Val([Type]{})
        }
        .Named(n) if n == Syntax.TYPE_WATCH_SET -> if method == {
            "add" -> Val([Type]{Type.Named{name: Syntax.TYPE_WATCH_HANDLE}})
            else -> Val([Type]{})
        }
        .Apply("Set", args) -> {
            elem := args.first() ?? Type.Int
            if method == {
                "add" | "has" | "remove" | "discard" | "pop" -> Val([Type]{~elem})
                "equal" | "union" | "intersection" | "difference" | "symmetric_difference" | "update" | "difference_update" | "intersection_update" | "symmetric_difference_update" | "is_subset" | "issubset" | "is_superset" | "issuperset" | "is_disjoint" | "isdisjoint" -> Val([Type]{Type.Apply{name: "Set", args: [Type]{~elem}}})
                "filter" | "each" | "map" | "flat_map" -> Val([Type]{sema_collection_fn([Type]{~elem}, None)})
                "all" -> Val([Type]{sema_collection_fn([Type]{~elem}, Val(Type.Bool))})
                "fold" -> Val([Type]{Type.Int, sema_collection_fn([Type]{Type.Int, ~elem}, Val(Type.Int))})
                else -> Val([Type]{})
            }
        }
        .Apply(name, args) if name == Syntax.TYPE_RANK -> {
            elem := args.first() ?? Type.Int
            if method == {
                "add" | "has" | "remove" -> Val([Type]{~elem})
                "union" | "intersection" | "difference" | "symmetric_difference" | "is_subset" | "is_superset" | "is_disjoint" -> Val([Type]{Type.Apply{name: Syntax.TYPE_RANK, args: [Type]{^elem}}})
                else -> Val([Type]{})
            }
        }
        .Apply(name, args) if name == Syntax.TYPE_TALLY -> {
            elem := args.first() ?? Type.Int
            if method == {
                "add" | "remove" | "has" | "count" -> Val([Type]{^elem})
                "any" -> Val([Type]{sema_collection_fn([Type]{^elem}, Val(Type.Bool))})
                else -> Val([Type]{})
            }
        }
        .Apply(name, args) if name == Syntax.TYPE_QUEUE -> {
            elem := args.first() ?? Type.Int
            if method == {
                "push_front" | "push_back" | "contains" | "delete" -> Val([Type]{^elem})
                "get" | "split" -> Val([Type]{Type.Int})
                "join" -> Val([Type]{Type.String})
                else -> Val([Type]{})
            }
        }
        .Apply("View" | "ViewMut", args) -> {
            elem := args.first() ?? Type.Int
            if method == {
                "get" -> Val([Type]{Type.Int})
                "contains" | "index_of" -> Val([Type]{^elem})
                "join" -> Val([Type]{Type.String})
                "fold" -> Val([Type]{Type.Int, sema_collection_fn([Type]{Type.Int, ^elem}, Val(Type.Int))})
                "map" -> Val([Type]{sema_collection_fn([Type]{^elem}, None)})
                else -> Val([Type]{})
            }
        }
        .Named(n) if n == Syntax.CLOCK_TYPE -> if method == {
            "new" | "tick" | "advance" -> Val([Type]{Type.Int})
            "wait" -> Val([Type]{Type.Named{name: Syntax.DURATION_TYPE}})
            else -> Val([Type]{})
        }
        .Named(n) if n == Syntax.RNG_TYPE -> if method == {
            "int" -> Val([Type]{Type.Int, Type.Int})
            "float_range" | "normal" -> Val([Type]{Type.Float, Type.Float})
            "bool" | "exponential" -> Val([Type]{Type.Float})
            "bytes" -> Val([Type]{Type.Int})
            else -> Val([Type]{})
        }
        .Named("HistoryRNG") -> if method == { "below" -> Val([Type]{Type.IntN{signed: false, bits: 64}}) else -> Val([Type]{}) }
        .Named(n) if n == Syntax.FAKE_TYPE -> if method == { "locale" -> Val([Type]{Type.String}) else -> Val([Type]{}) }
        .Named(n) if n == Syntax.SOLVER_TYPE -> if method == { "new" -> Val([Type]{Type.Int}) "require" -> Val([Type]{Type.Bool}) else -> Val([Type]{}) }
        .Named(n) if n == Syntax.DURATION_TYPE -> Val([Type]{})
        else -> None
    }
}

// Rust: crates/jet-foundation/src/Collections.rs:3874
pub fn builtin_needs_mut_receiver(recv_ty: Type, method: String) -> Bool Never! {
    builtin_method_mutates(recv_ty, method)
}
// Rust: crates/jet-foundation/src/Collections.rs:3881
pub enum BuiltinReceiverBorrow { Read TwoPhaseWrite EagerWrite Move }
// Rust: crates/jet-foundation/src/Collections.rs:3888
pub fn builtin_receiver_borrow(recv_ty: Type, method: String) -> BuiltinReceiverBorrow Never! {
    // Rust: crates/jet-foundation/src/Collections.rs:3889
    fn is_list_receiver(ty: Type) -> Bool Never! {
        if ty == {
            .List(_) | .FixedList(_, _) -> true
            .Tagged(_, inner) | .Result(inner, _) -> is_list_receiver(inner)
            else -> false
        }
    }
    if is_iter_type(recv_ty) -> return if method == "next" -> BuiltinReceiverBorrow.EagerWrite else -> BuiltinReceiverBorrow.Move
    if !builtin_method_mutates(recv_ty, method) -> return BuiltinReceiverBorrow.Read
    eager_list := is_list_receiver(recv_ty) && if method == { "remove" | "sort_by" | "sort_desc" | "sort_by_desc" | "update_first" | "edit_disjoint" -> true else -> false }
    eager_capability := if recv_ty == { .Named(name) -> name == Syntax.CLOCK_TYPE || name == Syntax.RNG_TYPE || name == "HistoryRNG" || name == Syntax.FAKE_TYPE || name == Syntax.SOLVER_TYPE else -> false }
    // Helper first-argument writes activate immediately; ordinary method writes reserve first.
    if eager_list || eager_capability -> BuiltinReceiverBorrow.EagerWrite else -> BuiltinReceiverBorrow.TwoPhaseWrite
}
