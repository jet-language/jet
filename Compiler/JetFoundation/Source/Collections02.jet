        ("first", 0) -> Val(Val(Type.Option{inner: ~key}))
        ("to_list" | "items", 0) | ("top_n", 1) -> Val(Val(Type.List{element: Type.Tuple{fields: [TypeTupleField]{TypeTupleField{name: "key", ty: ~key}, TypeTupleField{name: "value", ty: ~value}}}}))
