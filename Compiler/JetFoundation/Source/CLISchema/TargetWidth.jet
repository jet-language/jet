// Compiler-private metadata reader bound. Layout facts use the selected build
// target, never the compiler process environment or the inspected file's ISA.
#Layout(c)
struct JetCompilerMetadataPointer { pointer: *Int }

// A function, not a constant: sema folds the `$layout` fact read in a body to a
// literal, so the bound needs no compile-time execution host.
fn jet_compiler_target_usize_max() -> U64 Never! {
    pointer_size :: JetCompilerMetadataPointer.$layout.size ?? panic("compiler target has no concrete pointer layout")
    if pointer_size <= 0 || pointer_size > 8 -> panic("compiler target pointer width does not fit the U64 metadata carrier")
    if pointer_size == 8 -> return U64{0xffffffffffffffff}
    (U64{1} << (8 * pointer_size)) - U64{1}
}
