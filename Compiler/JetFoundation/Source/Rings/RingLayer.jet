fn jet_ring_is_namespace_only(module_name: String) -> Bool Never! {
    if module_name == {
        "core.mem.scope" | "core.net.mime" | "core.net.url" | "core.time.expiring" -> true
        else -> false
    }
}

fn jet_ring_is_closure_marker(usage: String) -> Bool Never! {
    usage.starts_with("__core_source::") || usage.starts_with("__core_intrinsic::")
}

fn jet_ring_layer_rank(layer: RuntimeLayer) -> Int Never! {
    if layer == {
        .Core -> 0
        .Alloc -> 1
        .Std -> 2
    }
}

fn jet_ring_layer_name(layer: RuntimeLayer) -> String Never! {
    if layer == {
        .Core -> "core"
        .Alloc -> "alloc"
        .Std -> "hosted"
    }
}

fn jet_ring_parse_manifest_layer(value: String) -> RuntimeLayer? {
    trimmed :: value.trim()
    if trimmed == {
        "core" -> Val(RuntimeLayer.Core)
        "alloc" -> Val(RuntimeLayer.Alloc)
        "hosted" -> Val(RuntimeLayer.Std)
        else -> None
    }
}

fn jet_ring_layer_of_module(module_name: String) -> RuntimeLayer Never! {
    if module_name == {
        "core" | "core.prelude" | "core.math" | "core.units" | "core.perf" | "core.mem.scope" -> RuntimeLayer.Core
        "core.mem" | "core.math.random" | "core.crypto" | "core.crypto.random" | "core.crypto.uuid" | "core.crypto.vault" | "core.encoding" | "core.encoding.json" | "core.encoding.jsonl" | "core.encoding.csv" | "core.encoding.toml" | "core.encoding.yaml" | "core.encoding.xml" | "core.encoding.cbor" | "core.encoding.hex" | "core.encoding.base64" | "core.encoding.base32" | "core.text" | "core.text.fmt" | "core.reflect" | "core.compiler" | "core.game" | "core.reactive.loadable" | "core.event" | "core.compute" | "core.compute.solve" | "core.time.expiring" | "core.reactive" | "core.data" | "core.data.plot" | "core.data.sketch.hll" | "core.data.sketch.tdigest" | "core.data.sketch.cms" | "core.data.sketch.reservoir" | "core.log" | "core.regex" | "core.net.url" | "core.net.mime" -> RuntimeLayer.Alloc
        else -> RuntimeLayer.Std
    }
}

fn jet_ring_core_module_layer(module_name: String) -> RuntimeLayer Never! {
    jet_ring_layer_of_module(module_name)
}

fn jet_ring_helper_layer(module_name: String, helper: String) -> RuntimeLayer? {
    if helper.len() == 0 -> return None
    if module_name == {
        "core.math" | "core.units" | "core.perf" | "core.mem.scope" -> Val(RuntimeLayer.Core)
        "core.mem" -> if helper == {
            "Ptr" | "from_addr" | "volatile_read" | "volatile_write" | "address_of" | "pin" | "Pin" -> Val(RuntimeLayer.Core)
            else -> None
        }
        "core.text" -> if helper == {
            "Cursor" | "caseless_eq" | "display_width" | "scalar_count" | "byte_count" | "is_alphabetic" | "is_numeric" | "is_whitespace" | "is_ascii" | "starts_any" | "ends_any" -> Val(RuntimeLayer.Core)
            else -> None
        }
        "core.time" -> if helper == {
            "from_unix_ms" | "from_unix_seconds" | "from_unix_microseconds" | "from_unix_nanoseconds" | "from_timestamp" | "days_in_month" | "is_leap_year" | "period" | "period_days" | "period_months" | "period_years" | "utc" -> Val(RuntimeLayer.Core)
            else -> None
        }
        "core.net" -> if helper == {
            "ip_addr" | "ip_to_string" | "ip_is_ipv4" | "socket_addr" | "socket_addr_parse" | "socket_host" | "socket_port" | "socket_to_string" | "error_operation" | "error_address" | "error_name" | "error_message" | "error_os_code" -> Val(RuntimeLayer.Alloc)
            else -> None
        }
        "core.net.url" | "core.net.mime" -> Val(RuntimeLayer.Alloc)
        "core.files" -> if helper == {
            "typed_head" | "path_from" | "path_join" | "path_parent" | "path_extension" | "path_stem" | "path_normalize" -> Val(RuntimeLayer.Alloc)
            else -> None
        }
        "core.crypto" -> if helper == {
            "__nominal__" | "Secret" | "SigningKey" | "VerifyKey" | "X25519SecretKey" | "X25519PublicKey" | "SharedSecret" | "Signature" | "Digest256" | "Digest512" | "sha256" | "blake3" | "sha512" | "constant_time_equal_bytes" | "constant_time_equal" | "verify" | "sign" -> Val(RuntimeLayer.Core)
            "file_seal" | "file_open" -> Val(RuntimeLayer.Std)
            else -> None
        }
        "core.archive" -> if helper == {
            "zip_decompress" | "crc32" | "adler32" | "deflate" | "inflate" | "zip_names_json" | "tar_names_json" -> Val(RuntimeLayer.Alloc)
            else -> None
        }
        "core.email" -> if helper == {
            "Address" | "Message" | "Attachment" | "Envelope" | "RecipientPolicy" | "Limits" | "address" | "attachment" | "message" | "envelope" | "serialize" -> Val(RuntimeLayer.Alloc)
            else -> None
        }
        else -> None
    }
}

fn jet_ring_core_usage_layer(usage: String) -> RuntimeLayer Never! {
    if usage.starts_with("core::") {
        bytes :: usage.bytes()
        rest :: String.from_bytes(bytes.slice(6, bytes.len())) ?? ""
        return if rest == {
            "json" | "bytes" -> RuntimeLayer.Alloc
            "from_bytes" | "from_bytes_lossy" -> RuntimeLayer.Core
            else -> RuntimeLayer.Std
        }
    }
    parts := usage.split("::").to_list()
    module_name := parts[0]
    helper := ""
    if parts.len() > 1 {
        helper_parts := [String]{}
        loop index in 1..<parts.len() -> &helper_parts.push(parts[index])
        helper = helper_parts.join("::")
    }
    jet_ring_helper_layer(module_name, helper) ?? jet_ring_layer_of_module(module_name)
}

fn jet_ring_dependency_keys(usage: String) -> [String] Never! {
    parts := usage.split("::").to_list()
    module_name := parts[0]
    helper := ""
    if parts.len() > 1 {
        helper_parts := [String]{}
        loop index in 1..<parts.len() -> &helper_parts.push(parts[index])
        helper = helper_parts.join("::")
    }
    dependencies := [String]{}
    loop row in jet_ring_dependency_rows() {
        if row.module_name == module_name {
            loop dependency in row.dependencies -> jet_ring_insert_string(&dependencies, dependency)
            break
        }
    }
    if helper.len() > 0 && module_name != "core" -> jet_ring_insert_string(&dependencies, module_name)
    if usage == "core::json" -> jet_ring_insert_string(&dependencies, "core.encoding.json")
    if usage == "core::bytes" -> jet_ring_insert_string(&dependencies, "core.encoding")
    if usage == "core.crypto::file_seal" || usage == "core.crypto::file_open" -> jet_ring_insert_string(&dependencies, "core.files")
    if !jet_ring_is_namespace_only(module_name) {
        module_parts := module_name.split(".").to_list()
        if module_parts.len() > 1 {
            parent_parts := [String]{}
            loop index in 0..<module_parts.len() - 1 -> &parent_parts.push(module_parts[index])
            parent := parent_parts.join(".")
            if parent.starts_with("core") -> jet_ring_insert_string(&dependencies, parent)
        }
    }
    dependencies
}

fn jet_ring_insert_string(rows: &[String], value: String) Never! {
    index := 0
    loop index < rows.len() {
        if rows[index] == value -> return
        if value < rows[index] -> break
        index += 1
    }
    &rows.push(value)
    cursor := rows.len() - 1
    loop cursor > index {
        rows[cursor] = rows[cursor - 1]
        cursor -= 1
    }
    rows[index] = value
}

// Stable scalar-position ordering, using the same key comparison as publication.
// Rust: crates/jet-foundation/src/RingLayer.rs::classify_prelude_closure
fn jet_ring_closure_order(rows: [JetRingLayerFact]) -> [Int] Never! {
    order := [Int]{}
    loop index in 0..<rows.len() -> &order.push(index)
    width := 1
    loop width < order.len() {
        merged := [Int]{}
        start := 0
        loop start < order.len() {
            middle :: if start + width < order.len() -> start + width else -> order.len()
            end :: if start + 2 * width < order.len() -> start + 2 * width else -> order.len()
            left := start
            right := middle
            loop left < middle || right < end {
                if right >= end || (left < middle && !(rows[order[right]].key < rows[order[left]].key)) {
                    &merged.push(order[left])
                    left += 1
                } else {
                    &merged.push(order[right])
                    right += 1
                }
            }
            start = end
        }
        order = merged
        width = width * 2
    }
    order
}

// Rust: crates/jet-foundation/src/RingLayer.rs::classify_prelude_closure
fn jet_ring_classify_prelude_closure(roots: [String]) -> [JetRingLayerFact] Never! {
    pending := [String]{}
    pending_keys := [String:Bool]{}
    classified := [String:Bool]{}
    loop root in roots {
        if !jet_ring_is_closure_marker(root) && !(pending_keys.get(root) ?? false) {
            &pending.push(root)
            pending_keys[root] = true
        }
    }
    closure := [JetRingLayerFact]{}
    cursor := 0
    loop cursor < pending.len() {
        current :: pending[cursor]
        cursor += 1
        pending_keys[current] = false
        classified[current] = true
        &closure.push(JetRingLayerFact{key: current, layer: jet_ring_core_usage_layer(current)})
        loop dependency in jet_ring_dependency_keys(current) {
            if !(pending_keys.get(dependency) ?? false) && !(classified.get(dependency) ?? false) {
                &pending.push(dependency)
                pending_keys[dependency] = true
            }
        }
    }
    ordered :: loop index in jet_ring_closure_order(closure) -> closure[index]
    ordered
}

fn jet_ring_prelude_closure_keys(roots: [String]) -> [String] Never! {
    keys :: loop row in jet_ring_classify_prelude_closure(roots) -> row.key
    keys
}

fn jet_ring_prelude_closure_layer(roots: [String]) -> RuntimeLayer Never! {
    layer := RuntimeLayer.Core
    loop row in jet_ring_classify_prelude_closure(roots) {
        if jet_ring_layer_rank(row.layer) > jet_ring_layer_rank(layer) -> layer = row.layer
    }
    layer
}
