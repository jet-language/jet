fn jet_ring_is_namespace_only(module_name: String) -> Bool Never! {
    if module_name == {
        "core.mem.scope" | "core.net.mime" | "core.net.url" | "core.time.expiring" -> true
        else -> false
    }
}

fn jet_ring_is_closure_marker(usage: String) -> Bool Never! {
    usage.starts_with("__core_source::") || usage.starts_with("__core_intrinsic::")
}

fn jet_ring_layer_rank(layer: MirRuntimeLayer) -> Int Never! {
    if layer == {
        .Core -> 0
        .Alloc -> 1
        .Std -> 2
    }
}

pub fn jet_ring_layer_name(layer: MirRuntimeLayer) -> String Never! {
    if layer == {
        .Core -> "core"
        .Alloc -> "alloc"
        .Std -> "hosted"
    }
}

pub fn jet_ring_parse_manifest_layer(value: String) -> MirRuntimeLayer? {
    trimmed :: value.trim()
    if trimmed == {
        "core" -> Val(MirRuntimeLayer.Core)
        "alloc" -> Val(MirRuntimeLayer.Alloc)
        "hosted" -> Val(MirRuntimeLayer.Std)
        else -> None
    }
}

fn jet_ring_layer_of_module(module_name: String) -> MirRuntimeLayer Never! {
    if module_name == {
        "core" | "core.prelude" | "core.math" | "core.units" | "core.perf" | "core.mem.scope" -> MirRuntimeLayer.Core
        "core.mem" | "core.math.random" | "core.crypto" | "core.crypto.random" | "core.crypto.uuid" | "core.crypto.vault" | "core.encoding" | "core.encoding.json" | "core.encoding.jsonl" | "core.encoding.csv" | "core.encoding.toml" | "core.encoding.yaml" | "core.encoding.xml" | "core.encoding.cbor" | "core.encoding.hex" | "core.encoding.base64" | "core.encoding.base32" | "core.text" | "core.text.fmt" | "core.reflect" | "core.compiler" | "core.game" | "core.reactive.loadable" | "core.event" | "core.compute" | "core.compute.solve" | "core.time.expiring" | "core.reactive" | "core.data" | "core.data.plot" | "core.data.sketch.hll" | "core.data.sketch.tdigest" | "core.data.sketch.cms" | "core.data.sketch.reservoir" | "core.log" | "core.regex" | "core.net.url" | "core.net.mime" -> MirRuntimeLayer.Alloc
        else -> MirRuntimeLayer.Std
    }
}

pub fn jet_ring_core_module_layer(module_name: String) -> MirRuntimeLayer Never! {
    jet_ring_layer_of_module(module_name)
}

fn jet_ring_helper_layer(module_name: String, helper: String) -> MirRuntimeLayer? {
    if helper.len() == 0 -> return None
    if module_name == {
        "core.math" | "core.units" | "core.perf" | "core.mem.scope" -> Val(MirRuntimeLayer.Core)
        "core.mem" -> if helper == {
            "Ptr" | "from_addr" | "volatile_read" | "volatile_write" | "address_of" | "pin" | "Pin" -> Val(MirRuntimeLayer.Core)
            else -> None
        }
        "core.text" -> if helper == {
            "Cursor" | "caseless_eq" | "display_width" | "scalar_count" | "byte_count" | "is_alphabetic" | "is_numeric" | "is_whitespace" | "is_ascii" | "starts_any" | "ends_any" -> Val(MirRuntimeLayer.Core)
            else -> None
        }
        "core.time" -> if helper == {
            "from_unix_ms" | "from_unix_seconds" | "from_unix_microseconds" | "from_unix_nanoseconds" | "from_timestamp" | "days_in_month" | "is_leap_year" | "period" | "period_days" | "period_months" | "period_years" | "utc" -> Val(MirRuntimeLayer.Core)
            else -> None
        }
        "core.net" -> if helper == {
            "ip_addr" | "ip_to_string" | "ip_is_ipv4" | "socket_addr" | "socket_addr_parse" | "socket_host" | "socket_port" | "socket_to_string" | "error_operation" | "error_address" | "error_name" | "error_message" | "error_os_code" -> Val(MirRuntimeLayer.Alloc)
            else -> None
        }
        "core.net.url" | "core.net.mime" -> Val(MirRuntimeLayer.Alloc)
        "core.files" -> if helper == {
            "typed_head" | "path_from" | "path_join" | "path_parent" | "path_extension" | "path_stem" | "path_normalize" -> Val(MirRuntimeLayer.Alloc)
            else -> None
        }
        "core.crypto" -> if helper == {
            "__nominal__" | "Secret" | "SigningKey" | "VerifyKey" | "X25519SecretKey" | "X25519PublicKey" | "SharedSecret" | "Signature" | "Digest256" | "Digest512" | "sha256" | "blake3" | "sha512" | "constant_time_equal_bytes" | "constant_time_equal" | "verify" | "sign" -> Val(MirRuntimeLayer.Core)
            "file_seal" | "file_open" -> Val(MirRuntimeLayer.Std)
            else -> None
        }
        "core.archive" -> if helper == {
            "zip_decompress" | "crc32" | "adler32" | "deflate" | "inflate" | "zip_names_json" | "tar_names_json" -> Val(MirRuntimeLayer.Alloc)
            else -> None
        }
        "core.email" -> if helper == {
            "Address" | "Message" | "Attachment" | "Envelope" | "RecipientPolicy" | "Limits" | "address" | "attachment" | "message" | "envelope" | "serialize" -> Val(MirRuntimeLayer.Alloc)
            else -> None
        }
        else -> None
    }
}

pub fn jet_ring_core_usage_layer(usage: String) -> MirRuntimeLayer Never! {
    if usage.starts_with("core::") {
        bytes :: usage.bytes()
        rest :: String.from_bytes(bytes.slice(6, bytes.len())) ?? ""
        return if rest == {
            "json" | "bytes" -> MirRuntimeLayer.Alloc
            "from_bytes" | "from_bytes_lossy" -> MirRuntimeLayer.Core
            else -> MirRuntimeLayer.Std
        }
    }
    parts := usage.split("::").to_list()
    module_name := parts[0]
    helper := ""
    if parts.len() > 1 {
        helper_parts := [String]{}
        loop index in 1..<parts.len() -> &helper_parts.push(parts[index])
        helper = helper_parts.join("::")
    }
    jet_ring_helper_layer(module_name, helper) ?? jet_ring_layer_of_module(module_name)
}

fn jet_ring_dependency_keys(usage: String) -> [String] Never! {
    parts := usage.split("::").to_list()
    module_name := parts[0]
    helper := ""
    if parts.len() > 1 {
        helper_parts := [String]{}
        loop index in 1..<parts.len() -> &helper_parts.push(parts[index])
        helper = helper_parts.join("::")
    }
    dependencies := [String]{}
    loop row in jet_ring_dependency_rows() {
        if row.module_name == module_name {
            loop dependency in row.dependencies -> jet_ring_insert_string(&dependencies, dependency)
            break
        }
    }
    if helper.len() > 0 && module_name != "core" -> jet_ring_insert_string(&dependencies, module_name)
    if usage == "core::json" -> jet_ring_insert_string(&dependencies, "core.encoding.json")
    if usage == "core::bytes" -> jet_ring_insert_string(&dependencies, "core.encoding")
    if usage == "core.crypto::file_seal" || usage == "core.crypto::file_open" -> jet_ring_insert_string(&dependencies, "core.files")
    if !jet_ring_is_namespace_only(module_name) {
        module_parts := module_name.split(".").to_list()
        if module_parts.len() > 1 {
            parent_parts := [String]{}
            loop index in 0..<module_parts.len() - 1 -> &parent_parts.push(module_parts[index])
            parent := parent_parts.join(".")
            if parent.starts_with("core") -> jet_ring_insert_string(&dependencies, parent)
        }
    }
    dependencies
}

fn jet_ring_insert_string(rows: &[String], value: String) Never! {
    index := 0
    loop index < rows.len() {
        if rows[index] == value -> return
        if value < rows[index] -> break
        index += 1
    }
    &rows.push(value)
    cursor := rows.len() - 1
    loop cursor > index {
        rows[cursor] = rows[cursor - 1]
        cursor -= 1
    }
    rows[index] = value
}

fn jet_ring_has_string(rows: [String], value: String) -> Bool Never! {
    loop row in rows {
        if row == value -> return true
    }
    false
}

fn jet_ring_insert_layer_fact(rows: &[JetRingLayerFact], key: String, layer: MirRuntimeLayer) Never! {
    index := 0
    loop index < rows.len() {
        if rows[index].key == key -> return
        if key < rows[index].key -> break
        index += 1
    }
    &rows.push(JetRingLayerFact{key: key, layer: layer})
    cursor := rows.len() - 1
    loop cursor > index {
        rows[cursor] = rows[cursor - 1]
        cursor -= 1
    }
    rows[index] = JetRingLayerFact{key: key, layer: layer}
}

pub fn jet_ring_classify_prelude_closure(roots: [String]) -> [JetRingLayerFact] Never! {
    pending := [String]{}
    loop root in roots {
        if !jet_ring_is_closure_marker(root) -> jet_ring_insert_string(&pending, root)
    }
    closure := [JetRingLayerFact]{}
    loop pending.len() > 0 {
        current := pending[0]
        loop index in 1..<pending.len() -> pending[index - 1] = pending[index]
        _ := &pending.pop()
        already_classified := false
        loop row in closure {
            if row.key == current -> already_classified = true
        }
        if already_classified -> next
        jet_ring_insert_layer_fact(&closure, current, jet_ring_core_usage_layer(current))
        loop dependency in jet_ring_dependency_keys(current) {
            if !jet_ring_has_string(pending, dependency) {
                found := false
                loop row in closure {
                    if row.key == dependency -> found = true
                }
                if !found -> jet_ring_insert_string(&pending, dependency)
            }
        }
    }
    closure
}

pub fn jet_ring_prelude_closure_keys(roots: [String]) -> [String] Never! {
    keys :: loop row in jet_ring_classify_prelude_closure(roots) -> row.key
    keys
}

pub fn jet_ring_prelude_closure_layer(roots: [String]) -> MirRuntimeLayer Never! {
    layer := MirRuntimeLayer.Core
    loop row in jet_ring_classify_prelude_closure(roots) {
        if jet_ring_layer_rank(row.layer) > jet_ring_layer_rank(layer) -> layer = row.layer
    }
    layer
}

fn jet_ring_usage_matches(used_core: [String], prefixes: [String]) -> Bool Never! {
    loop usage in used_core {
        loop prefix in prefixes {
            if usage == prefix || usage.starts_with("{prefix}::") || usage.starts_with("{prefix}.") -> return true
        }
    }
    false
}

fn jet_ring_runtime_part_order(part: MirRuntimePartId) -> Int Never! {
    if part == {
        .Gc -> 0
        .Event -> 1
        .Realtime -> 2
        .EmbeddedHardware -> 3
        .Ui -> 4
        .Devtools -> 5
        .Gtk -> 6
        .Apps -> 7
        .Email -> 8
        .Game -> 9
        .Files -> 10
        .Interrupt -> 11
        .FsRuntime -> 12
        .Process -> 13
        .Crypto -> 14
        .Math -> 15
        .Encoding -> 16
        .Data -> 17
        .Fmt -> 18
        .DataFmt -> 19
        .Compute -> 20
        .Http -> 21
        .WebSocket -> 22
        .Browser -> 23
        .Args -> 24
        .Reflect -> 25
        .AuthTokens -> 26
        .AuthSession -> 27
        .Sync -> 28
        .Services -> 29
        .Mod -> 30
    }
}

fn jet_ring_insert_runtime_part(rows: &[MirRuntimePartId], part: MirRuntimePartId) Never! {
    order :: jet_ring_runtime_part_order(part)
    index := 0
    loop index < rows.len() {
        if rows[index] == part -> return
        if order < jet_ring_runtime_part_order(rows[index]) -> break
        index += 1
    }
    &rows.push(part)
    cursor := rows.len() - 1
    loop cursor > index {
        rows[cursor] = rows[cursor - 1]
        cursor -= 1
    }
    rows[index] = part
}

pub fn jet_ring_runtime_parts_for_used_core(used_core: [String]) -> [MirRuntimePartId] Never! {
    parts := [MirRuntimePartId]{}
    if jet_ring_usage_matches(used_core, [String]{"core.event"}) -> jet_ring_insert_runtime_part(&parts, MirRuntimePartId.Event)
    if jet_ring_usage_matches(used_core, [String]{"core.rt", "core.realtime"}) -> jet_ring_insert_runtime_part(&parts, MirRuntimePartId.Realtime)
    if jet_ring_usage_matches(used_core, [String]{"core.hardware", "core.embedded", "core.board", "core.device"}) -> jet_ring_insert_runtime_part(&parts, MirRuntimePartId.EmbeddedHardware)
    if jet_ring_usage_matches(used_core, [String]{"core.ui", "core.font", "core.web", "app", "core.args"}) -> jet_ring_insert_runtime_part(&parts, MirRuntimePartId.Ui)
    if jet_ring_usage_matches(used_core, [String]{"core.ui", "core.devtools", "core.web", "app"}) -> jet_ring_insert_runtime_part(&parts, MirRuntimePartId.Devtools)
    if jet_ring_usage_matches(used_core, [String]{"core.ui::gtk_backend", "core.ui.gtk_backend"}) -> jet_ring_insert_runtime_part(&parts, MirRuntimePartId.Gtk)
    if jet_ring_usage_matches(used_core, [String]{"app", "core.web", "core.http", "core.http.client", "core.http.server", "core.web.devserver", "core.web.browser"}) -> jet_ring_insert_runtime_part(&parts, MirRuntimePartId.Apps)
    if jet_ring_usage_matches(used_core, [String]{"core.email"}) -> jet_ring_insert_runtime_part(&parts, MirRuntimePartId.Email)
    if jet_ring_usage_matches(used_core, [String]{"core.game", "core.game.raylib", "core.raylib"}) -> jet_ring_insert_runtime_part(&parts, MirRuntimePartId.Game)
    if jet_ring_usage_matches(used_core, [String]{"core.files", "core.watcher", "core.term", "core.sys", "core.process"}) -> jet_ring_insert_runtime_part(&parts, MirRuntimePartId.Files)
    if jet_ring_usage_matches(used_core, [String]{"core.sys::on_interrupt", "core.sys.on_interrupt", "core.process::on_signal", "core.process.on_signal"}) -> jet_ring_insert_runtime_part(&parts, MirRuntimePartId.Interrupt)
    if jet_ring_usage_matches(used_core, [String]{"core.files", "core.watcher", "core.term", "core.sys", "core.process", "core.args", "core.testing", "core.perf", "core.mem.scope"}) -> jet_ring_insert_runtime_part(&parts, MirRuntimePartId.FsRuntime)
    if jet_ring_usage_matches(used_core, [String]{"core.crypto"}) -> jet_ring_insert_runtime_part(&parts, MirRuntimePartId.Crypto)
    if jet_ring_usage_matches(used_core, [String]{"core.math", "core.math.random", "core.time", "core.time.expiring", "core.units"}) -> jet_ring_insert_runtime_part(&parts, MirRuntimePartId.Math)
    if jet_ring_usage_matches(used_core, [String]{"core.encoding", "core.encoding.json", "core.encoding.jsonl", "core.encoding.csv", "core.encoding.toml", "core.encoding.yaml", "core.encoding.xml", "core.encoding.cbor", "core.encoding.hex", "core.archive.gzip", "core.archive.zstd"}) -> jet_ring_insert_runtime_part(&parts, MirRuntimePartId.Encoding)
    if jet_ring_usage_matches(used_core, [String]{"core.data", "core.data.sketch.hll", "core.data.sketch.tdigest", "core.data.sketch.cms", "core.data.sketch.reservoir", "core.db", "core.encoding.csv"}) -> jet_ring_insert_runtime_part(&parts, MirRuntimePartId.Data)
    if jet_ring_usage_matches(used_core, [String]{"core.text.fmt"}) -> jet_ring_insert_runtime_part(&parts, MirRuntimePartId.Fmt)
    if jet_ring_usage_matches(used_core, [String]{"core.data", "core.data.sketch.hll", "core.data.sketch.tdigest", "core.data.sketch.cms", "core.data.sketch.reservoir", "core.db", "core.encoding", "core.encoding.json", "core.encoding.jsonl", "core.encoding.csv", "core.encoding.toml", "core.encoding.yaml", "core.encoding.xml", "core.encoding.cbor", "core.encoding.hex", "core.archive.gzip", "core.archive.zstd"}) -> jet_ring_insert_runtime_part(&parts, MirRuntimePartId.DataFmt)
    if jet_ring_usage_matches(used_core, [String]{"core.compute"}) -> jet_ring_insert_runtime_part(&parts, MirRuntimePartId.Compute)
    if jet_ring_usage_matches(used_core, [String]{"core.http", "core.http.client", "core.http.server", "core.web", "core.web.devserver"}) -> jet_ring_insert_runtime_part(&parts, MirRuntimePartId.Http)
    if jet_ring_usage_matches(used_core, [String]{"core.net.ws", "app", "core.web", "core.db", "core.http", "core.http.client", "core.http.server", "core.web.browser"}) -> jet_ring_insert_runtime_part(&parts, MirRuntimePartId.WebSocket)
    if jet_ring_usage_matches(used_core, [String]{"core.web.browser", "core.web", "core.web.storage", "core.web.storage.local", "core.web.storage.session"}) -> jet_ring_insert_runtime_part(&parts, MirRuntimePartId.Browser)
    if jet_ring_usage_matches(used_core, [String]{"core.args"}) -> jet_ring_insert_runtime_part(&parts, MirRuntimePartId.Args)
    if jet_ring_usage_matches(used_core, [String]{"core.reflect", "core.compiler.lang"}) -> jet_ring_insert_runtime_part(&parts, MirRuntimePartId.Reflect)
    if jet_ring_usage_matches(used_core, [String]{"core.auth"}) || jet_ring_has_runtime_part(parts, MirRuntimePartId.Crypto) -> jet_ring_insert_runtime_part(&parts, MirRuntimePartId.AuthTokens)
    if jet_ring_usage_matches(used_core, [String]{"core.auth", "app", "core.web"}) -> jet_ring_insert_runtime_part(&parts, MirRuntimePartId.AuthSession)
    if jet_ring_usage_matches(used_core, [String]{"core.sync", "app", "core.web", "core.db"}) -> jet_ring_insert_runtime_part(&parts, MirRuntimePartId.Sync)
    if jet_ring_usage_matches(used_core, [String]{"core.service", "core.jobs"}) -> jet_ring_insert_runtime_part(&parts, MirRuntimePartId.Services)
    if jet_ring_usage_matches(used_core, [String]{"core.mod"}) -> jet_ring_insert_runtime_part(&parts, MirRuntimePartId.Mod)
    parts
}

fn jet_ring_has_runtime_part(parts: [MirRuntimePartId], part: MirRuntimePartId) -> Bool Never! {
    loop item in parts {
        if item == part -> return true
    }
    false
}
