// Canonical runtime-layer and semantic Prelude-closure facts ported from RingLayer.rs.
// Module names classify conservatively; namespace spelling alone never adds a
// dependency beyond the checked closure table below.

pub struct JetRingLayerFact {
    pub key: String
    pub layer: MirRuntimeLayer
}

struct JetRingDependencyRow {
    module_name: String
    dependencies: [String]
}

