//RS // ── JetInt: owned one-word exact integer carrier ────────────────────────────
//RS //
//RS // Inline values remain their signed 63-bit payload. A spilled value is an
//RS // owned pointer to an immutable node. The pointer is still one machine word,
//RS // so it can cross the scalar ABI without exposing the node layout. Cloning and
//RS // dropping the carrier are the only operations that change node ownership.
//RS //
//RS // Atomic loads use the hazard domain below before retaining a node observed
//RS // through an AtomicU64. This makes the one-word atomic representation safe
//RS // against replacement and address reuse without a lock or a participant cap.
//RS const JET_INT_INLINE_MIN: i64 = -(1_i64 << 62);
//RS const JET_INT_INLINE_MAX: i64 = (1_i64 << 62) - 1;
//RS const JET_INT_POINTER_TAG: u64 = 1_u64 << 62;
//RS const JET_INT_TAG_MASK: u64 = 3_u64 << 62;
//RS const JET_INT_POINTER_MASK: u64 = JET_INT_POINTER_TAG - 1;
//RS 
//RS struct JetIntNode {
//RS     refs: AtomicUsize,
//RS     retired_next: AtomicPtr<JetIntNode>,
//RS     value: CtBigInt,
//RS }
//RS 
//RS unsafe impl Send for JetIntNode {}
//RS unsafe impl Sync for JetIntNode {}
//RS 
//RS /// One hazard record belongs to one thread and is linked into a process-wide
//RS /// append-only registry. Records are never freed: a scanner may run after a
//RS /// thread exits, and retaining the record is cheaper and safer than a
//RS /// use-after-free. Numeric nodes themselves remain fully reclaimable.
//RS struct JetIntHazardRecord {
//RS     hazard: AtomicPtr<JetIntNode>,
//RS     next: AtomicPtr<JetIntHazardRecord>,
//RS }
//RS 
//RS unsafe impl Send for JetIntHazardRecord {}
//RS unsafe impl Sync for JetIntHazardRecord {}
//RS 
//RS static JET_INT_HAZARDS: AtomicPtr<JetIntHazardRecord> = AtomicPtr::new(ptr::null_mut());
//RS 
//RS thread_local! {
//RS     static JET_INT_HAZARD_RECORD: Cell<*mut JetIntHazardRecord> =
//RS         const { Cell::new(ptr::null_mut()) };
//RS }
//RS 
//RS fn jet_int_hazard_record() -> *mut JetIntHazardRecord {
//RS     JET_INT_HAZARD_RECORD.with(|slot| {
//RS         if let Some(record) = NonNull::new(slot.get()) {
//RS             return record.as_ptr();
//RS         }
//RS         let record = Box::into_raw(Box::new(JetIntHazardRecord {
//RS             hazard: AtomicPtr::new(ptr::null_mut()),
//RS             next: AtomicPtr::new(ptr::null_mut()),
//RS         }));
//RS         loop {
//RS             let head = JET_INT_HAZARDS.load(Ordering::Acquire);
//RS             // SAFETY: the record is private until the release CAS publishes it.
//RS             unsafe { (*record).next.store(head, Ordering::Relaxed) };
//RS             if JET_INT_HAZARDS
//RS                 .compare_exchange_weak(head, record, Ordering::Release, Ordering::Acquire)
//RS                 .is_ok()
//RS             {
//RS                 break;
//RS             }
//RS         }
//RS         slot.set(record);
//RS         record
//RS     })
//RS }
