//RS 
//RS #[inline]
//RS fn jet_int_is_pointer(raw: u64) -> bool {
//RS     if (raw & JET_INT_TAG_MASK) != JET_INT_POINTER_TAG {
//RS         return false;
//RS     }
//RS     // Bit 62 also appears in IEEE-754 values in [2, 4). Zip optional packing
//RS     // and other raw i64 words can therefore look tagged. A real node pointer
//RS     // is never null and is aligned to JetIntNode.
//RS     let pointer = raw & JET_INT_POINTER_MASK;
//RS     pointer != 0 && pointer % (std::mem::align_of::<JetIntNode>() as u64) == 0
//RS }
//RS 
//RS #[inline]
//RS fn jet_int_pointer(raw: u64) -> *mut JetIntNode {
//RS     (raw & JET_INT_POINTER_MASK) as *mut JetIntNode
