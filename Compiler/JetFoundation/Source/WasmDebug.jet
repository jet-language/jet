// Std-only Wasm DWARF line-table reader and sourceMappingURL custom section.
use std.str as str

// Rust: crates/jet-foundation/src/WasmDebug.rs:9
pub struct WasmLineRow {
    pub address: U64
    pub file: String
    pub line: U32
    pub column: U32
    pub is_stmt: Bool
    pub end_sequence: Bool
}
// Rust: crates/jet-foundation/src/WasmDebug.rs:19
#Error
pub enum WasmDebugError { Malformed(String) }

// Rust: crates/jet-foundation/src/WasmDebug.rs:24
pub fn code_section_payload_offset(wasm: View<U8>) -> Int? WasmDebugError! {
    if wasm.len() < 8 || wasm[0..<8] != [U8]{0, 97, 115, 109, 1, 0, 0, 0}.view() -> return Err(.Malformed("unsupported Wasm header"))
    at := 8
    while at < wasm.len() {
        id :: wasm.get(at) ?? return Err(.Malformed("truncated section id"))
        at += 1
        size :: read_uleb(wasm, &at)
        payload_start :: at
        end :: at.checked_add(size) ?? return Err(.Malformed("section size overflow"))
        if end > wasm.len() -> return Err(.Malformed("section extends past file"))
        if id == 10 -> return Val(payload_start)
        at = end
    }
    None
}
// Rust: crates/jet-foundation/src/WasmDebug.rs:51
pub fn parse_debug_line(wasm: View<U8>) -> [WasmLineRow] WasmDebugError! {
    rows := [WasmLineRow]{}
    loop payload in custom_section_payloads(wasm, ".debug_line".bytes()) {
        decode_debug_line_section(payload, &rows)
    }
    ^rows
}
// Rust: crates/jet-foundation/src/WasmDebug.rs:60
pub fn embed_source_mapping_url(wasm: &[U8], url: String) WasmDebugError! {
    if wasm.len() < 8 || wasm[0..<8] != [U8]{0, 97, 115, 109, 1, 0, 0, 0}.view() -> return Err(.Malformed("unsupported Wasm header"))
    _ :: custom_section_payloads(wasm.view(), [U8]{}.view())
    NAME :: "sourceMappingURL"
    payload := [U8]{}
    put_uleb(&payload, NAME.len())
    payload.extend_from_slice(NAME.bytes())
    payload.extend_from_slice(url.bytes())
    wasm.push(0)
    put_uleb(wasm, payload.len())
    wasm.extend_from_slice(payload.view())
}
// Rust: crates/jet-foundation/src/WasmDebug.rs:77
pub fn custom_section_payloads(wasm: View<U8>, want_name: View<U8>) -> [View<U8>] WasmDebugError! from wasm {
    if wasm.len() < 8 || wasm[0..<8] != [U8]{0, 97, 115, 109, 1, 0, 0, 0}.view() -> return Err(.Malformed("unsupported Wasm header"))
    at := 8
    found := [View<U8>]{}
    while at < wasm.len() {
        id :: wasm.get(at) ?? return Err(.Malformed("truncated section id"))
        at += 1
        size :: read_uleb(wasm, &at)
        end :: at.checked_add(size) ?? return Err(.Malformed("section size overflow"))
        if end > wasm.len() -> return Err(.Malformed("section extends past file"))
        payload :: wasm[at..<end]
        if id == 0 {
            name_at := 0
            name_len :: read_uleb(payload, &name_at)
            name_end :: name_at.checked_add(name_len) ?? return Err(.Malformed("custom name overflow"))
            if name_end > payload.len() -> return Err(.Malformed("custom name past payload"))
            name :: payload[name_at..<name_end]
            if want_name.is_empty() || name == want_name -> found.push(payload[name_end..])
        }
        at = end
    }
    ^found
}
// Rust: crates/jet-foundation/src/WasmDebug.rs:118
fn decode_debug_line_section(section: View<U8>, rows: &[WasmLineRow]) WasmDebugError! {
    at := 0
    while at < section.len() {
        unit_start :: at
        (unit_len, dwarf64) :: read_initial_length(section, &at)
        header_end :: unit_start.checked_add(if dwarf64 { 12 } else { 4 }) ?? return Err(.Malformed("line unit length overflow"))
        unit_end :: header_end.checked_add(unit_len) ?? return Err(.Malformed("line unit length overflow"))
        if unit_end > section.len() -> return Err(.Malformed("line unit past section"))
        version :: read_u16(section, &at)
        if version < 2 || version > 5 -> return Err(.Malformed("unsupported .debug_line version"))
        prologue_length :: if dwarf64 { read_u64(section, &at) as Int } else { read_u32(section, &at) as Int }
        prologue_limit :: at.checked_add(prologue_length) ?? return Err(.Malformed("prologue length overflow"))
        if prologue_limit > unit_end -> return Err(.Malformed("prologue past unit"))
        minimum_instruction_length :: section.get(at) ?? return Err(.Malformed("missing min_inst_length"))
        at += 1
        if minimum_instruction_length == 0 -> return Err(.Malformed("min_inst_length is zero"))
        maximum_operations_per_instruction :: if version >= 4 {
            v :: section.get(at) ?? return Err(.Malformed("missing max_ops_per_inst"))
            at += 1
            if v == 0 -> return Err(.Malformed("max_ops_per_inst is zero"))
            v
        } else { 1 as U8 }
        default_is_stmt :: (section.get(at) ?? return Err(.Malformed("missing default_is_stmt"))) != 0
        at += 1
        line_base :: (section.get(at) ?? return Err(.Malformed("missing line_base"))) as I8
        at += 1
        line_range :: section.get(at) ?? return Err(.Malformed("missing line_range"))
        at += 1
        if line_range == 0 -> return Err(.Malformed("line_range is zero"))
        opcode_base :: section.get(at) ?? return Err(.Malformed("missing opcode_base"))
        at += 1
        standard_opcode_lengths := [U8]{}
        loop _ in 1..<opcode_base {
            len :: section.get(at) ?? return Err(.Malformed("truncated opcode lengths"))
            at += 1
            standard_opcode_lengths.push(len)
        }
        include_directories := [String]{""}
        loop {
            dir :: read_cstring(section, &at)
            if dir.is_empty() -> break
            include_directories.push(^dir)
        }
        file_names := [String]{}
        loop {
            name :: read_cstring(section, &at)
            if name.is_empty() -> break
            dir_index :: read_uleb(section, &at)
            _mod_time :: read_uleb(section, &at)
            _length :: read_uleb(section, &at)
            dir :: include_directories.get(dir_index).cloned() ?? ""
            path :: if dir.is_empty() { ^name } else { "{dir}/{name}" }
            file_names.push(^path)
        }
        // Skip remaining prologue bytes (DWARF5 / producer padding).
        at = prologue_limit
        address := 0 as U64
        op_index := 0 as U32
        file := 1 as U32
        line := 1 as I64
        column := 0 as U32
        is_stmt := default_is_stmt
        basic_block := false
        prologue_end := false
        epilogue_begin := false
        discriminator := 0 as U32
        // Rust: crates/jet-foundation/src/WasmDebug.rs:237
        emit :: fn(rows: &[WasmLineRow], address: U64, file: U32, line: I64, column: U32,
                   is_stmt: Bool, end_sequence: Bool, file_names: View<String>) Never! {
            if line <= 0 -> return
            file_name :: file_names.get(file.saturating_sub(1) as Int).cloned() ?? ""
            rows.push(WasmLineRow{address: address, file: file_name, line: line as U32,
                column: column, is_stmt: is_stmt, end_sequence: end_sequence})
        }
        while at < unit_end {
            op :: section.get(at) ?? return Err(.Malformed("truncated line op"))
            at += 1
            if op == 0 {
                len :: read_uleb(section, &at)
                ext_end :: at.checked_add(len) ?? return Err(.Malformed("ext op length overflow"))
                if ext_end > unit_end -> return Err(.Malformed("ext op past unit"))
                if len == 0 -> continue
                ext :: section.get(at) ?? return Err(.Malformed("missing ext opcode"))
                at += 1
                if ext == {
                    1 -> {
                        emit(rows, address, file, line, column, is_stmt, true, file_names.view())
                        address = 0; op_index = 0; file = 1; line = 1; column = 0
                        is_stmt = default_is_stmt
                        basic_block = false; prologue_end = false; epilogue_begin = false; discriminator = 0
                    }
                    2 -> {
                        // DW_LNE_set_address
                        addr_bytes :: ext_end - at
                        address = if addr_bytes == {
                            4 -> read_u32(section, &at) as U64
                            8 -> read_u64(section, &at)
                            _ -> return Err(.Malformed("unsupported set_address size"))
                        }
                        op_index = 0
                    }
                    3 -> {
                        // DW_LNE_define_file — skip for wasm rustc output.
                        _ :: read_cstring(section, &at)
                        _ :: read_uleb(section, &at)
                        _ :: read_uleb(section, &at)
                        _ :: read_uleb(section, &at)
                    }
                    4 -> { discriminator = read_uleb(section, &at) as U32 }
                    _ -> {}
                }
                at = ext_end
                _ :: (basic_block, prologue_end, epilogue_begin, discriminator)
            } else if op < opcode_base {
                if op == {
                    1 -> {
                        emit(rows, address, file, line, column, is_stmt, false, file_names.view())
                        basic_block = false; prologue_end = false; epilogue_begin = false; discriminator = 0
                    }
                    2 -> {
                        op_advance :: read_uleb(section, &at) as U32
                        advance_pc(&address, &op_index, op_advance, minimum_instruction_length, maximum_operations_per_instruction)
                    }
                    3 -> { line += read_sleb(section, &at) }
                    4 -> { file = read_uleb(section, &at) as U32 }
                    5 -> { column = read_uleb(section, &at) as U32 }
                    6 -> { is_stmt = !is_stmt }
                    7 -> { basic_block = true }
                    8 -> {
                        advance :: (255 - opcode_base as U32) / line_range as U32
                        advance_pc(&address, &op_index, advance, minimum_instruction_length, maximum_operations_per_instruction)
                    }
                    9 -> {
                        operand :: read_u16(section, &at) as U64
                        address += operand
                        op_index = 0
                    }
                    10 -> { prologue_end = true }
                    11 -> { epilogue_begin = true }
                    12 -> { _isa :: read_uleb(section, &at) }
                    _ -> {
                        idx :: (op as Int).saturating_sub(1)
                        args :: standard_opcode_lengths.get(idx) ?? return Err(.Malformed("unknown standard opcode"))
                        loop _ in 0..<args { _ :: read_uleb(section, &at) }
                    }
                }
            } else {
                adjusted :: op - opcode_base
                line_delta :: line_base as I64 + (adjusted % line_range) as I64
                op_advance :: (adjusted / line_range) as U32
                advance_pc(&address, &op_index, op_advance, minimum_instruction_length, maximum_operations_per_instruction)
                line += line_delta
                emit(rows, address, file, line, column, is_stmt, false, file_names.view())
                basic_block = false; prologue_end = false; epilogue_begin = false; discriminator = 0
            }
        }
        at = unit_end
    }
}
// Rust: crates/jet-foundation/src/WasmDebug.rs:445
fn advance_pc(address: &U64, op_index: &U32, op_advance: U32, min_inst_length: U8, max_ops: U8) Never! {
    new_op :: (op_index as U64) + op_advance as U64
    address += (new_op / max_ops as U64) * min_inst_length as U64
    op_index = (new_op % max_ops as U64) as U32
}
// Rust: crates/jet-foundation/src/WasmDebug.rs:458
fn read_initial_length(buf: View<U8>, at: &Int) -> (Int, Bool) WasmDebugError! {
    first :: read_u32(buf, at)
    if first == 0xffffffff { (read_u64(buf, at) as Int, true) }
    else if first >= 0xfffffff0 { Err(.Malformed("reserved initial length")) }
    else { (first as Int, false) }
}
// Rust: crates/jet-foundation/src/WasmDebug.rs:469
fn read_u16(buf: View<U8>, at: &Int) -> U16 WasmDebugError! {
    end :: at.checked_add(2) ?? return Err(.Malformed("u16 overflow"))
    if at < 0 || end > buf.len() -> return Err(.Malformed("truncated u16"))
    bytes :: buf[at..<end]
    at = end
    (bytes[0] as U16) | ((bytes[1] as U16) << 8)
}
// Rust: crates/jet-foundation/src/WasmDebug.rs:480
fn read_u32(buf: View<U8>, at: &Int) -> U32 WasmDebugError! {
    end :: at.checked_add(4) ?? return Err(.Malformed("u32 overflow"))
    if at < 0 || end > buf.len() -> return Err(.Malformed("truncated u32"))
    bytes :: buf[at..<end]
    at = end
    (bytes[0] as U32) | ((bytes[1] as U32) << 8) | ((bytes[2] as U32) << 16) | ((bytes[3] as U32) << 24)
}
// Rust: crates/jet-foundation/src/WasmDebug.rs:491
fn read_u64(buf: View<U8>, at: &Int) -> U64 WasmDebugError! {
    end :: at.checked_add(8) ?? return Err(.Malformed("u64 overflow"))
    if at < 0 || end > buf.len() -> return Err(.Malformed("truncated u64"))
    bytes :: buf[at..<end]
    at = end
    (bytes[0] as U64) | ((bytes[1] as U64) << 8) | ((bytes[2] as U64) << 16) | ((bytes[3] as U64) << 24)
        | ((bytes[4] as U64) << 32) | ((bytes[5] as U64) << 40) | ((bytes[6] as U64) << 48) | ((bytes[7] as U64) << 56)
}
// Rust: crates/jet-foundation/src/WasmDebug.rs:504
fn read_uleb(buf: View<U8>, at: &Int) -> Int WasmDebugError! {
    result := 0 as U64
    shift := 0 as U32
    loop {
        byte :: buf.get(at) ?? return Err(.Malformed("truncated ULEB"))
        at += 1
        result |= (byte & 0x7f) as U64 << shift
        if byte & 0x80 == 0 -> break
        shift += 7
        if shift > 63 -> return Err(.Malformed("ULEB too large"))
    }
    // GATE #4483: usize conversion uses the execution target width, not host facts.
    Int.try_from(result) catch { _ -> return Err(.Malformed("ULEB exceeds usize")) }
}
// Rust: crates/jet-foundation/src/WasmDebug.rs:524
fn read_sleb(buf: View<U8>, at: &Int) -> I64 WasmDebugError! {
    result := 0 as I64
    shift := 0 as U32
    loop {
        byte :: buf.get(at) ?? return Err(.Malformed("truncated SLEB"))
        at += 1
        result |= (byte & 0x7f) as I64 << shift
        shift += 7
        if byte & 0x80 == 0 {
            if shift < 64 && (byte & 0x40) != 0 -> result |= !(0 as I64) << shift
            return result
        }
        if shift >= 64 -> return Err(.Malformed("SLEB too large"))
    }
}
// Rust: crates/jet-foundation/src/WasmDebug.rs:546
fn read_cstring(buf: View<U8>, at: &Int) -> String WasmDebugError! {
    start :: at
    while at < buf.len() && buf[at] != 0 { at += 1 }
    if at >= buf.len() -> return Err(.Malformed("unterminated cstring"))
    text :: str.from_utf8(buf[start..<at]) catch { _ -> return Err(.Malformed("cstring is not utf-8")) }
    s :: text.to_string()
    at += 1
    s
}
// Rust: crates/jet-foundation/src/WasmDebug.rs:561
fn put_uleb(out: &[U8], value: Int) Never! {
    remaining := value
    loop {
        byte := (remaining & 0x7f) as U8
        remaining >>= 7
        if remaining != 0 -> byte |= 0x80
        out.push(byte)
        if remaining == 0 -> break
    }
}
