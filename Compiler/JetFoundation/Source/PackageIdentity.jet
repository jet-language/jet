//RS /// Fingerprint of a whole item, bodies included. Whitespace, comments, and
//RS /// source positions never change it; any edit to the item's syntax does.
//RS /// This is the input fingerprint of the item's own check.
//RS pub fn item_source_fingerprint(item: &Item) -> String {
//RS     sha256_hex(&crate::CanonicalAST::canonical_fragment(item))
//RS }
//RS 
//RS /// Fingerprint of what importers see of an item, or `None` when the item is
//RS /// not part of the package interface. Bodies are erased except the ones
//RS /// importers consume: generic and `#Inline(Always)` functions and trait
//RS /// default methods. Private inherent methods are dropped. A body edit that
//RS /// changes an inferred fact reaches importers through the checker's
//RS /// summaries, not through this fingerprint.
