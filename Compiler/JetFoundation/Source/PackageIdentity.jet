// PORT-PENDING 2136 crates-jet-foundation-src-packageidentity: crates/jet-foundation/src/PackageIdentity.rs:1-670
// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! #2517 stage S1: package identity, the package graph, and the
//RS //! fingerprints that key persisted package checks.
//RS //!
//RS //! The package is the unit of incremental checking (owner ruling of
//RS //! 2026-09-30). A package is a directory with `package.jet` (its member files
//RS //! share one namespace, D-MOD-CYCLE1=A), the embedded Core library, or a
//RS //! single file outside any package. Identities are stable semantic labels,
//RS //! never checkout paths or loader aliases, so two checkouts of one tree
//RS //! produce equal keys and digests.
//RS //!
//RS //! Keys use one field framing that JetFoundation mirrors byte for byte: each
//RS //! field is a UTF-8 string written as a LEB128 byte length followed by its
//RS //! bytes, and a key is the lowercase SHA-256 hex of the concatenation.
//RS //! Digests enter as 64-character lowercase hex and counts as decimal text.
//RS 
//RS use std::collections::BTreeMap;
//RS use std::path::{Component, Path, PathBuf};
//RS 
//RS use crate::AST::{Func, ImportDecl, Item, LoadedModule, ProgramBundle};
//RS use crate::RecordCodec::{digest_hex, record_digest, record_map, RecordSection, RecordValue};
//RS use crate::SHA256::sha256_hex;
//RS 
