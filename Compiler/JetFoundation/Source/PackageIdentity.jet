//RS pub const TARGET_FACTS_SCHEMA: &str = "jet.target-facts/v1";
//RS pub const CHECK_KEY_SCHEMA: &str = "jet.pkg-check-key/v1";
//RS pub const INTERFACE_SCHEMA: &str = "jet.iface/v1";
//RS 
