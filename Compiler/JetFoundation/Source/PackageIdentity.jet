// Package identities are semantic labels, never checkout paths or loader aliases.
// Shared framing: each UTF-8 field has a LEB128 byte length, then its bytes.
use AST.[Func, ImportDecl, Item, LoadedModule, ProgramBundle, TraitImplBlock]
use Names.[NameLedger]
use RecordCodec.[digest_hex, record_digest, record_map, RecordSection, RecordValue]
use SHA256.[sha256_hex]
use CanonicalAST.[canonical_fragment]
use std.path.[Component]

// Rust: crates/jet-foundation/src/PackageIdentity.rs:23
pub CORE_PACKAGE :: prep { "core" }
// Rust: crates/jet-foundation/src/PackageIdentity.rs:25
pub SOURCE_DIGEST_SCHEMA :: prep { "jet.pkg-source/v1" }
// Rust: crates/jet-foundation/src/PackageIdentity.rs:26
pub TARGET_FACTS_SCHEMA :: prep { "jet.target-facts/v1" }
// Rust: crates/jet-foundation/src/PackageIdentity.rs:27
pub CHECK_KEY_SCHEMA :: prep { "jet.pkg-check-key/v1" }
// Rust: crates/jet-foundation/src/PackageIdentity.rs:28
pub INTERFACE_SCHEMA :: prep { "jet.iface/v1" }
// Rust: crates/jet-foundation/src/PackageIdentity.rs:31
pub IFACE_SECTION_HEADER :: prep { U64{1} }
// Rust: crates/jet-foundation/src/PackageIdentity.rs:32
pub IFACE_SECTION_DECLARATIONS :: prep { U64{2} }
// Rust: crates/jet-foundation/src/PackageIdentity.rs:33
pub IFACE_SECTION_REEXPORTS :: prep { U64{3} }
// Rust: crates/jet-foundation/src/PackageIdentity.rs:34
pub IFACE_SECTION_SUMMARIES :: prep { U64{4} }

// Rust: crates/jet-foundation/src/PackageIdentity.rs:37
pub struct KeyHasher {
    bytes: [U8]
    // Rust: crates/jet-foundation/src/PackageIdentity.rs:42
    pub fn new(schema: String) -> KeyHasher {
        hasher := KeyHasher{bytes: []}
        _ :: hasher.field(schema)
        ^hasher
    }
    // Rust: crates/jet-foundation/src/PackageIdentity.rs:48
    pub fn field(self: &KeyHasher, value: String) -> &KeyHasher {
        len := U64{value.as_bytes().len()}
        loop {
            byte :: U8{len & 0x7f}
            len >>= 7
            if len == 0 { self.bytes.push(byte); break }
            self.bytes.push(byte | 0x80)
        }
        self.bytes.extend_from_slice(value.as_bytes())
        &self
    }
    // Rust: crates/jet-foundation/src/PackageIdentity.rs:63
    pub fn count(self: &KeyHasher, count: Int) -> &KeyHasher { self.field(count.to_string()) }
    // Rust: crates/jet-foundation/src/PackageIdentity.rs:67
    pub fn finish(self: KeyHasher) -> String { sha256_hex(self.bytes) }
}

// Rust: crates/jet-foundation/src/PackageIdentity.rs:74
pub fn source_digest(files: [(String, [U8])], manifest: [U8]?) -> String {
    ordered := files.iter().map(|(path, bytes)| -> (~path, sha256_hex(bytes))).collect()
    ordered.sort_by(|left, right| -> left.0.as_bytes().cmp(right.0.as_bytes()))
    hasher := KeyHasher.new(SOURCE_DIGEST_SCHEMA)
    _ :: hasher.field("files").count(ordered.len())
    loop (path, digest) in ordered { _ :: hasher.field(path).field(digest) }
    _ :: hasher.field("manifest").field(manifest.map(|bytes| -> sha256_hex(bytes)).unwrap_or_default())
    hasher.finish()
}
// Rust: crates/jet-foundation/src/PackageIdentity.rs:92
pub fn target_facts_digest(pairs: [(String, String)]) -> String {
    ordered := pairs.iter().collect()
    ordered.sort_by(|left, right| -> left.0.as_bytes().cmp(right.0.as_bytes()))
    hasher := KeyHasher.new(TARGET_FACTS_SCHEMA)
    _ :: hasher.count(ordered.len())
    loop (name, value) in ordered { _ :: hasher.field(name).field(value) }
    hasher.finish()
}
// Rust: crates/jet-foundation/src/PackageIdentity.rs:106
pub fn package_check_key(compiler_identity: String, target_facts_digest: String, package_identity: String, source_digest: String, dependencies: [(String, String)]) -> String {
    ordered := dependencies.iter().collect()
    ordered.sort_by(|left, right| -> left.0.as_bytes().cmp(right.0.as_bytes()))
    hasher := KeyHasher.new(CHECK_KEY_SCHEMA)
    _ :: hasher.field(compiler_identity).field(target_facts_digest).field(package_identity).field(source_digest).count(ordered.len())
    loop (identity, interface) in ordered { _ :: hasher.field(identity).field(interface) }
    hasher.finish()
}
// Rust: crates/jet-foundation/src/PackageIdentity.rs:133
pub fn target_fact_pairs(bundle: ProgramBundle) -> [(String, String)] {
    build_facts := ~bundle.build_facts
    build_facts.stamp.at.clear()
    build_facts.contributions.clear()
    build_facts.setting_provenance.clear()
    [("os", bundle.active_os.debug()), ("edition", ~bundle.edition),
     ("web_partition", bundle.web_partition_enforced.to_string()),
     ("layer_ceiling", bundle.layer_ceiling.debug()),
     ("build_facts", sha256_hex(canonical_fragment(build_facts)))]
}

// Rust: crates/jet-foundation/src/PackageIdentity.rs:159
pub enum PackageKind { Core, Manifest, File }
// Rust: crates/jet-foundation/src/PackageIdentity.rs:170
pub struct PackageNode {
    pub identity: String
    pub kind: PackageKind
    pub root: OSPath?
    pub modules: [Int]
    pub dependencies: [Int]
}
// Rust: crates/jet-foundation/src/PackageIdentity.rs:185
pub struct PackageGraph {
    pub packages: [PackageNode] = []
    module_package: [Int] = []

    // Rust: crates/jet-foundation/src/PackageIdentity.rs:241
    pub fn from_bundle(bundle: ProgramBundle) -> PackageGraph { PackageGraph.from_ledger(bundle, bundle.name_ledger) }
    // Rust: crates/jet-foundation/src/PackageIdentity.rs:247
    pub fn from_ledger(bundle: ProgramBundle, ledger: NameLedger) -> PackageGraph {
        groups := [String: (PackageKind, OSPath?, [Int])]{}
        module_identity := [String]{}
        loop (index, module) in bundle.modules.iter().enumerate() {
            identity: String
            kind: PackageKind
            root: OSPath?
            if module.is_core_source() {
                identity = CORE_PACKAGE; kind = PackageKind.Core; root = None
            } else if namespace :: ledger.module_namespace(index) {
                directory :: OSPath.from(namespace)
                label :: stable_label(bundle, directory)
                identity = if label.starts_with("dep:") -> label else -> "pkg:{label}"
                kind = PackageKind.Manifest; root = Val(directory)
            } else {
                identity = "file:{stable_label(bundle, module.path)}"
                kind = PackageKind.File; root = None
            }
            if !groups.contains_key(identity) { groups[~identity] = (kind, ^root, []) }
            groups[identity].2.push(index)
            module_identity.push(^identity)
        }
        identities := groups.keys().collect()
        identities.sort()
        index_of := [String: Int]{}
        loop (index, identity) in identities.iter().enumerate() { index_of[~identity] = index }
        module_package :: module_identity.iter().map(|identity| -> index_of[identity]).collect()
        core :: index_of.get(CORE_PACKAGE)
        packages := [PackageNode]{}
        loop identity in identities {
            (kind, root, modules) :: groups.remove(identity).unwrap()
            packages.push(PackageNode{identity: ^identity, kind: kind, root: ^root, modules: ^modules, dependencies: []})
        }
        loop (from_module, to_module) in ledger.import_edges() {
            from :: module_package.get(from_module) ?? continue
            to :: module_package.get(to_module) ?? continue
            if from != to { packages[from].dependencies.push(to) }
        }
        loop (index, package) in packages.iter_mut().enumerate() {
            if core_index :: core { if core_index != index { package.dependencies.push(core_index) } }
            package.dependencies.sort_unstable()
            package.dependencies.dedup()
        }
        PackageGraph{packages: ^packages, module_package: ^module_package}
    }
    // Rust: crates/jet-foundation/src/PackageIdentity.rs:319
    pub fn package_of(self: PackageGraph, module: Int) -> Int? { self.module_package.get(module) }
    // Rust: crates/jet-foundation/src/PackageIdentity.rs:326
    pub fn components(self: PackageGraph) -> [[Int]] {
        count :: self.packages.len()
        state := PackageComponentState{graph: self, next: 0, index: [Int?].filled(count, None), low: [Int].filled(count, 0), stack: [], on_stack: [Bool].filled(count, false), components: []}
        loop node in 0..count { if state.index[node] == None { visit(&state, node) } }
        ^state.components
    }
    // Rust: crates/jet-foundation/src/PackageIdentity.rs:388
    pub fn is_acyclic(self: PackageGraph) -> Bool { self.components().iter().all(|component| -> component.len() == 1) }
    // Rust: crates/jet-foundation/src/PackageIdentity.rs:393
    pub fn member_label(self: PackageGraph, bundle: ProgramBundle, module: Int) -> String {
        loaded :: bundle.modules[module]
        package :: self.package_of(module).map(|index| -> self.packages[index])
        root :: package.and_then(|node| -> node.root)
        if directory :: root {
            match normalize(loaded.path).strip_prefix(normalize(directory)) {
                Ok(relative) => slash(relative)
                Err(_) => stable_label(bundle, loaded.path)
            }
        } else if loaded.is_core_source() -> slash(loaded.path)
        else -> stable_label(bundle, loaded.path)
    }
    // Rust: crates/jet-foundation/src/PackageIdentity.rs:409
    pub fn source_digest(self: PackageGraph, bundle: ProgramBundle, package: Int, manifest: [U8]?) -> String {
        files :: self.packages[package].modules.iter().map(|module| -> (self.member_label(bundle, module), bundle.modules[module].source.as_bytes())).collect()
        source_digest(files, manifest)
    }
    // Rust: crates/jet-foundation/src/PackageIdentity.rs:426
    pub fn interface_digest(self: PackageGraph, bundle: ProgramBundle, package: Int, summaries: [String: String]) -> String {
        node :: self.packages[package]
        declarations := [(String, String, String)]{}
        reexports := [(String, String)]{}
        loop module in node.modules {
            loaded :: bundle.modules[module]
            label :: self.member_label(bundle, module)
            loop (name, fingerprint) in module_interface(loaded) { declarations.push((~label, ^name, ^fingerprint)) }
            loop import in loaded.imports {
                if import.is_pub || import.is_package_pub { reexports.push((~label, import_fingerprint(import))) }
            }
        }
        declarations.sort()
        reexports.sort()
        summary_keys := summaries.keys().collect()
        summary_keys.sort()
        sections :: [
            RecordSection.new(IFACE_SECTION_HEADER, [record_map([("package", RecordValue.str(node.identity))])]),
            RecordSection.new(IFACE_SECTION_DECLARATIONS, declarations.iter().map(|(module, name, fingerprint)| -> record_map([("module", RecordValue.Str(~module)), ("name", RecordValue.Str(~name)), ("fingerprint", RecordValue.Str(~fingerprint))])).collect()),
            RecordSection.new(IFACE_SECTION_REEXPORTS, reexports.iter().map(|(module, fingerprint)| -> record_map([("module", RecordValue.Str(~module)), ("fingerprint", RecordValue.Str(~fingerprint))])).collect()),
            RecordSection.new(IFACE_SECTION_SUMMARIES, summary_keys.iter().map(|identity| -> record_map([("identity", RecordValue.str(identity)), ("value", RecordValue.str(summaries[identity]))])).collect())
        ]
        digest :: record_digest(INTERFACE_SCHEMA, sections).expect("interface sections have distinct tags")
        digest_hex(digest)
    }
}

// Rust: crates/jet-foundation/src/PackageIdentity.rs:191
fn normalize(path: OSPath) -> OSPath {
    out := OSPath.new()
    loop component in path.components() {
        match component {
            Component.ParentDir => { _ :: out.pop() }
            Component.CurDir => {}
            other => out.push(other.as_os_str())
        }
    }
    ^out
}
// Rust: crates/jet-foundation/src/PackageIdentity.rs:205
fn slash(path: OSPath) -> String {
    text :: path.to_string_lossy().replace('\\', "/")
    if text.is_empty() -> "." else -> text
}
// Rust: crates/jet-foundation/src/PackageIdentity.rs:216
fn stable_label(bundle: ProgramBundle, path: OSPath) -> String {
    normalized :: normalize(path)
    if normalized.is_relative() -> return slash(normalized)
    root :: normalize(bundle.project_root)
    if relative :: normalized.strip_prefix(root).ok() -> return slash(relative)
    dependencies := bundle.dep_roots.keys().collect()
    dependencies.sort()
    loop name in dependencies {
        if relative :: normalized.strip_prefix(normalize(bundle.dep_roots[name])).ok() -> return "dep:{name}/{slash(relative)}"
    }
    slash(normalized)
}
// Rust: crates/jet-foundation/src/PackageIdentity.rs:329
struct PackageComponentState {
    graph: PackageGraph
    next: Int
    index: [Int?]
    low: [Int]
    stack: [Int]
    on_stack: [Bool]
    components: [[Int]]
}
// Rust: crates/jet-foundation/src/PackageIdentity.rs:338
fn visit(state: &PackageComponentState, node: Int) -> {
    state.index[node] = Val(state.next)
    state.low[node] = state.next
    state.next += 1
    state.stack.push(node)
    state.on_stack[node] = true
    loop dependency in state.graph.packages[node].dependencies {
        match state.index[dependency] {
            None => { visit(&state, dependency); state.low[node] = state.low[node].min(state.low[dependency]) }
            Val(index) => { if state.on_stack[dependency] { state.low[node] = state.low[node].min(index) } }
        }
    }
    if Val(state.low[node]) == state.index[node] {
        component := [Int]{}
        loop {
            member :: state.stack.pop() ?? break
            state.on_stack[member] = false
            component.push(member)
            if member == node -> break
        }
        component.sort_unstable()
        state.components.push(^component)
    }
}

// Rust: crates/jet-foundation/src/PackageIdentity.rs:501
pub fn item_source_fingerprint(item: Item) -> String { sha256_hex(canonical_fragment(item)) }
// Rust: crates/jet-foundation/src/PackageIdentity.rs:511
pub fn item_interface_fingerprint(item: Item, pub_file: Bool) -> String? {
    erased :: interface_item(item, pub_file) ?? return None
    Val(sha256_hex(canonical_fragment(erased)))
}
// Rust: crates/jet-foundation/src/PackageIdentity.rs:516
fn exported(is_pub: Bool, is_package_pub: Bool, pub_file: Bool) -> Bool { is_pub || is_package_pub || pub_file }
// Rust: crates/jet-foundation/src/PackageIdentity.rs:520
fn keeps_body(func: Func) -> Bool { !func.type_params.is_empty() || func.is_inline_always }
// Rust: crates/jet-foundation/src/PackageIdentity.rs:524
fn erase_func(func: &Func) -> { if !keeps_body(func) { func.body.clear() } }
// Rust: crates/jet-foundation/src/PackageIdentity.rs:530
fn erase_inherent_methods(methods: &[Func], pub_file: Bool) -> {
    methods.retain(|method| -> exported(method.is_pub, method.is_package_pub, pub_file))
    loop method in methods.iter_mut() { erase_func(&method) }
}
// Rust: crates/jet-foundation/src/PackageIdentity.rs:535
fn erase_trait_impls(blocks: &[TraitImplBlock]) -> {
    loop block in blocks.iter_mut() { loop method in block.methods.iter_mut() { erase_func(&method) } }
}
// Rust: crates/jet-foundation/src/PackageIdentity.rs:541
fn interface_item(original: Item, pub_file: Bool) -> Item? {
    item := ~original
    keep :: match &item {
        Item.Func(func) => { erase_func(&func); exported(func.is_pub, func.is_package_pub, pub_file) }
        Item.Struct(def) => { erase_inherent_methods(&def.methods, pub_file); erase_trait_impls(&def.trait_impls); exported(def.is_pub, def.is_package_pub, pub_file) }
        Item.Enum(def) => { erase_inherent_methods(&def.methods, pub_file); erase_trait_impls(&def.trait_impls); exported(def.is_pub, def.is_package_pub, pub_file) }
        Item.Impl(def) => {
            if def.trait_name != None { loop method in def.methods.iter_mut() { erase_func(&method) } }
            else { erase_inherent_methods(&def.methods, pub_file) }
            true
        }
        Item.CodeModule(module) => {
            if body :: module.body { module.body = Val(body.iter().filter_map(|child| -> interface_item(child, pub_file)).collect()) }
            exported(module.is_pub, module.is_package_pub, pub_file)
        }
        Item.Distinct(def) => exported(def.is_pub, def.is_package_pub, pub_file)
        Item.TypeAlias(def) => exported(def.is_pub, def.is_package_pub, pub_file)
        Item.UnitFamily(def) => exported(def.is_pub, def.is_package_pub, pub_file)
        Item.Trait(def) => exported(def.is_pub, def.is_package_pub, pub_file)
        Item.Tag(def) => exported(def.is_pub, def.is_package_pub, pub_file)
        Item.Const(def) => exported(def.is_pub, def.is_package_pub, pub_file)
        Item.ProtocolDecl(def) => exported(def.is_pub, def.is_package_pub, pub_file)
        Item.GenericModule(def) => exported(def.is_pub, def.is_package_pub, pub_file)
        Item.ModuleAlias(def) => exported(def.is_pub, def.is_package_pub, pub_file)
        Item.Test(_) => false
        // These declarations register package-wide facts and retain their bodies.
        Item.EffectDecl(_) | Item.ExternRust(_) | Item.Module(_) | Item.CModule(_) | Item.ErrorConv(_) | Item.Migration(_) | Item.UserDerive(_) | Item.TemplateLoop(_) | Item.MarkerDecl(_) | Item.FactDecl(_) => true
    }
    if keep -> Val(^item) else -> None
}
// Rust: crates/jet-foundation/src/PackageIdentity.rs:602
fn item_name(item: Item) -> String {
    match item {
        Item.Func(func) => "fn {func.name}"
        Item.Struct(def) => "struct {def.name}"
        Item.Enum(def) => "enum {def.name}"
        Item.Distinct(def) => "distinct {def.name}"
        Item.TypeAlias(def) => "alias {def.name}"
        Item.Trait(def) => "trait {def.name}"
        Item.Tag(def) => "tag {def.name}"
        Item.Const(def) => "const {def.name}"
        Item.ProtocolDecl(def) => "protocol {def.name}"
        Item.CodeModule(def) => "module {def.name}"
        Item.GenericModule(def) => "module {def.name}"
        Item.ModuleAlias(def) => "module {def.name}"
        Item.EffectDecl(def) => "effect {def.name}"
        Item.MarkerDecl(def) => "marker {def.name}"
        Item.FactDecl(def) => "fact {def.name}"
        Item.Impl(def) => match def.trait_name {
            Val(trait_name) => "impl {def.type_name}: {trait_name}"
            None => "impl {def.type_name}"
        }
        other => "item {item_source_fingerprint(other)}"
    }
}
// Rust: crates/jet-foundation/src/PackageIdentity.rs:630
pub fn module_interface(module: LoadedModule) -> [(String, String)] {
    module.items.iter().filter_map(|item| -> item_interface_fingerprint(item, module.pub_file).map(|fingerprint| -> (item_name(item), fingerprint))).collect()
}
// Rust: crates/jet-foundation/src/PackageIdentity.rs:640
fn import_fingerprint(import: ImportDecl) -> String { sha256_hex(canonical_fragment(import)) }
