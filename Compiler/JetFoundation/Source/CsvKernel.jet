// Dependency-free CSV engine shared by whole-value and streaming readers.
// Record lines identify the physical opening line, including multiline fields.
use std.mem.[take, size_of]

// Rust: crates/jet-foundation/src/CsvKernel.rs:7
pub struct CsvOptions { pub delimiter: Char, pub header: Bool, pub skip_blank: Bool }
impl CsvOptions {
    // Rust: crates/jet-foundation/src/CsvKernel.rs:14
    pub fn default() -> CsvOptions Never! { CsvOptions{delimiter: ',', header: false, skip_blank: false} }
}
// Rust: crates/jet-foundation/src/CsvKernel.rs:24
pub struct CsvRecord { pub fields: [String], pub line: Int }
// Rust: crates/jet-foundation/src/CsvKernel.rs:30
pub enum CsvErrorKind { Syntax Truncated }
// Rust: crates/jet-foundation/src/CsvKernel.rs:36
#Error
pub struct CsvError {
    pub kind: CsvErrorKind
    pub record: Int
    pub line: Int
    pub column: Int
    pub field: Int
    pub reason: String
}
impl CsvError {
    // Rust: crates/jet-foundation/src/CsvKernel.rs:46
    pub fn message(self) -> String Never! {
        "E2701: CSV row {self.record}, line {self.line}, column {self.column} — {self.reason}"
    }
}
// Rust: crates/jet-foundation/src/CsvKernel.rs:54
pub fn delimiter(value: String) -> Char Err! {
    chars := value.chars()
    ch :: chars.next() ?? return Err(delimiter_error())
    if chars.next() != None || ch == '"' || ch == '\r' || ch == '\n' -> return Err(delimiter_error())
    ch
}
// Rust: crates/jet-foundation/src/CsvKernel.rs:65
fn delimiter_error() -> String Never! {
    "E2701: CSV delimiter must be exactly one character other than quote or line ending"
}
// Rust: crates/jet-foundation/src/CsvKernel.rs:69
fn delimiter_name(delimiter: Char) -> String Never! {
    if delimiter == ',' { "comma" } else { "delimiter" }
}
// Rust: crates/jet-foundation/src/CsvKernel.rs:77
pub struct CsvParser {
    options: CsvOptions
    fields: [String]
    field: String
    quoted: Bool
    after_quote: Bool
    pending_cr: Bool
    pending_cr_line: Int
    pending_cr_column: Int
    record: Int
    physical_line: Int
    physical_column: Int
    record_line: Int
    record_has_content: Bool
    ended_record: Bool
    saw_input: Bool
}
impl CsvParser {
    // Rust: crates/jet-foundation/src/CsvKernel.rs:96
    pub fn new(options: CsvOptions) -> CsvParser Err! {
        if options.delimiter == '"' || options.delimiter == '\r' || options.delimiter == '\n' -> return Err(delimiter_error())
        CsvParser{options: options, fields: [], field: "", quoted: false, after_quote: false,
            pending_cr: false, pending_cr_line: 1, pending_cr_column: 1, record: 1,
            physical_line: 1, physical_column: 0, record_line: 1,
            record_has_content: false, ended_record: false, saw_input: false}
    }
    // Rust: crates/jet-foundation/src/CsvKernel.rs:119
    pub fn field_len_bytes(self) -> Int Never! { self.field.len() }
    // Rust: crates/jet-foundation/src/CsvKernel.rs:123
    pub fn current_field(self) -> Int Never! { self.fields.len() }
    // Rust: crates/jet-foundation/src/CsvKernel.rs:127
    pub fn current_record(self) -> Int Never! { self.record }
    // Rust: crates/jet-foundation/src/CsvKernel.rs:131
    pub fn line(self) -> Int Never! { self.physical_line }
    // Rust: crates/jet-foundation/src/CsvKernel.rs:135
    pub fn column(self) -> Int Never! { self.physical_column }
    // Rust: crates/jet-foundation/src/CsvKernel.rs:145
    pub fn append_len_bytes(self, ch: Char) -> Int Never! {
        if self.pending_cr {
            return if self.quoted && ch == '\n' { 2 } else { 0 }
        }
        if self.quoted {
            if self.after_quote -> return if ch == '"' { 1 } else { 0 }
            return if ch != '"' { ch.len_utf8() } else { 0 }
        }
        if ch == '"' || ch == '\r' || ch == '\n' || ch == self.options.delimiter { 0 }
        else { ch.len_utf8() }
    }
    // Rust: crates/jet-foundation/src/CsvKernel.rs:163
    pub fn would_append(self, ch: Char) -> Bool Never! { self.append_len_bytes(ch) != 0 }
    // Rust: crates/jet-foundation/src/CsvKernel.rs:167
    pub fn capacity_bytes(self) -> Int Never! {
        // GATE #4494 retained allocation capacity; #4483 selected-target String layout.
        retained := 0
        loop field in self.fields { retained += field.capacity() }
        self.field.capacity().saturating_add(self.fields.capacity().saturating_mul(size_of<String>()))
            .saturating_add(retained)
    }
    // Rust: crates/jet-foundation/src/CsvKernel.rs:183
    pub fn push(&self, ch: Char) -> CsvRecord? CsvError! {
        self.saw_input = true
        if self.pending_cr {
            if ch != '\n' {
                return Err(self.error_at(CsvErrorKind.Syntax, self.pending_cr_line,
                    self.pending_cr_column, "bare CR is not a record ending"))
            }
            self.pending_cr = false
            self.physical_column += 1
            self.physical_line += 1
            self.physical_column = 0
            if self.quoted {
                self.field.push('\r')
                self.field.push('\n')
                return None
            }
            return self.finish_record()
        }
        self.ended_record = false
        self.physical_column += 1
        if self.quoted {
            if self.after_quote {
                if ch == '"' {
                    self.field.push('"')
                    self.after_quote = false
                    return None
                }
                if ch == self.options.delimiter {
                    self.fields.push(take(&self.field))
                    self.quoted = false
                    self.after_quote = false
                    return None
                }
                if ch == '\r' {
                    self.quoted = false
                    self.after_quote = false
                    self.pending_cr = true
                    self.pending_cr_line = self.physical_line
                    self.pending_cr_column = self.physical_column
                    return None
                }
                if ch == '\n' {
                    self.quoted = false
                    self.after_quote = false
                    self.physical_line += 1
                    self.physical_column = 0
                    return self.finish_record()
                }
                return Err(self.error(CsvErrorKind.Syntax,
                    "only quote, {delimiter_name(self.options.delimiter)}, CRLF, LF, or EOF may follow a closing quote"))
            }
            if ch == '"' { self.after_quote = true }
            else {
                self.field.push(ch)
                if ch == '\n' {
                    self.physical_line += 1
                    self.physical_column = 0
                }
            }
            return None
        }
        if ch == '"' {
            if !self.field.is_empty() -> return Err(self.error(CsvErrorKind.Syntax, "quote inside an unquoted field"))
            self.quoted = true
            self.record_has_content = true
            return None
        }
        if ch == self.options.delimiter {
            self.fields.push(take(&self.field))
            return None
        }
        if ch == '\r' {
            self.pending_cr = true
            self.pending_cr_line = self.physical_line
            self.pending_cr_column = self.physical_column
            return None
        }
        if ch == '\n' {
            self.physical_line += 1
            self.physical_column = 0
            return self.finish_record()
        }
        self.field.push(ch)
        self.record_has_content = true
        None
    }
    // Rust: crates/jet-foundation/src/CsvKernel.rs:292
    pub fn finish(&self) -> CsvRecord? CsvError! {
        if self.pending_cr {
            return Err(self.error_at(CsvErrorKind.Syntax, self.pending_cr_line,
                self.pending_cr_column, "bare CR is not a record ending"))
        }
        if self.quoted && !self.after_quote {
            return Err(self.error_at(CsvErrorKind.Truncated, self.physical_line,
                self.physical_column + 1, "quoted field ended before its closing quote"))
        }
        if self.ended_record || !self.saw_input -> return None
        self.quoted = false
        self.after_quote = false
        self.finish_record()
    }
    // Rust: crates/jet-foundation/src/CsvKernel.rs:317
    fn finish_record(&self) -> CsvRecord? Never! {
        self.fields.push(take(&self.field))
        number :: self.record
        line :: self.record_line
        has_content :: self.record_has_content
        self.record += 1
        self.record_line = self.physical_line
        self.record_has_content = false
        self.ended_record = true
        if self.options.header && number == 1 {
            self.fields.clear()
            return None
        }
        if self.options.skip_blank && !has_content {
            self.fields.clear()
            return None
        }
        Val(CsvRecord{fields: take(&self.fields), line: line})
    }
    // Rust: crates/jet-foundation/src/CsvKernel.rs:341
    fn error(self, kind: CsvErrorKind, reason: String) -> CsvError Never! {
        CsvError{kind: kind, record: self.record, line: self.physical_line,
            column: self.physical_column, field: self.fields.len(), reason: reason}
    }
    // Rust: crates/jet-foundation/src/CsvKernel.rs:352
    fn error_at(self, kind: CsvErrorKind, line: Int, column: Int, reason: String) -> CsvError Never! {
        CsvError{kind: kind, record: self.record, line: line, column: column,
            field: self.fields.len(), reason: reason}
    }
}
// Rust: crates/jet-foundation/src/CsvKernel.rs:364
pub fn parse(text: String, options: CsvOptions) -> [CsvRecord] Err! {
    parser := CsvParser.new(options)?
    records := [CsvRecord]{}
    loop ch in text.chars() {
        record :: if parser.push(ch) == { .Ok(value) -> value .Err(error) -> return Err(error.message()) }
        if record == .Val(value) { records.push(^value) }
    }
    record :: if parser.finish() == { .Ok(value) -> value .Err(error) -> return Err(error.message()) }
    if record == .Val(value) { records.push(^value) }
    records
}
// Rust: crates/jet-foundation/src/CsvKernel.rs:378
pub fn render(rows: [[String]]) -> String Never! {
    rendered := [String]{}
    loop row in rows {
        fields := [String]{}
        loop field in row {
            if field.contains(",") || field.contains("\"") || field.contains("\n") || field.contains("\r") {
                fields.push("\"{field.replace("\"", "\"\"")}\"")
            } else { fields.push(field) }
        }
        rendered.push(fields.join(","))
    }
    rendered.join("\n")
}
