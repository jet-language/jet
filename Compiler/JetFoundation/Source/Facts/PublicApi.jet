// One row of a package's public API: what a dependent can name and rely on.
// Sema produces the rows (sema_public_api); `jet registry publish` writes them
// to the package's API snapshot and diffs them for the SemVer gate (E1218).
// `kind` is "fn", "struct", "enum", "trait", "impl", "type", "distinct",
// "unit" or "const"; `name` is the dotted path a dependent spells, and
// `signature` the canonical one-line text that changes exactly when the
// contract does.
struct PublicAPIItem {
    kind: String
    name: String
    signature: String
}
