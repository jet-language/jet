// Frozen typed cost evidence, shared by lowering and its reporting consumers.
// Mirrors the Rust reference's cost_fact_for_expr; never inspect generated adapter text.
TCOST_I128_MIN: -170141183460469231731687303715884105728

TCOST_I128_MAX: 170141183460469231731687303715884105727

TCOST_INLINE_MIN: -4611686018427387904

TCOST_INLINE_MAX: 4611686018427387903

checked_cost_bounded: fn(lo: Int, hi: Int) -> TIntegerBounds? Never! {
    if lo < TCOST_I128_MIN || hi > TCOST_I128_MAX -> return None
    Val(TIntegerBounds{lo: lo, hi: hi})
}

checked_cost_type_bounds: fn(ty: Type) -> TIntegerBounds? Never! {
    if ty == {
        .InlineRange(_, lo, hi) -> checked_cost_bounded(lo, hi)
        .IntN(signed, bits) -> {
            if bits <= 0 || bits > 128 || (!signed && bits == 128) -> return None
            if signed {
                limit: 1 << (bits - 1)
                return Val(TIntegerBounds{lo: -limit, hi: limit - 1})
            }
            Val(TIntegerBounds{lo: 0, hi: (1 << bits) - 1})
        }
        .Tagged(_, inner) -> checked_cost_type_bounds(inner)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
}

checked_cost_min: fn(left: Int, right: Int) -> Int Never! { if left < right -> left else -> right }

checked_cost_max: fn(left: Int, right: Int) -> Int Never! { if left > right -> left else -> right }

checked_cost_combine_bounds: fn(op: TBinaryOp, left: TIntegerBounds, right: TIntegerBounds) -> TIntegerBounds? Never! {
    if op == {
        .Add -> return checked_cost_bounded(checked_cost_min(left.lo + right.lo, 0), checked_cost_max(left.hi + right.hi, 0))
        .Sub -> return checked_cost_bounded(checked_cost_min(left.lo - right.hi, 0), checked_cost_max(left.hi - right.lo, 0))
        .Mul -> {
            first: left.lo * right.lo
            second: left.lo * right.hi
            third: left.hi * right.lo
            fourth: left.hi * right.hi
            return checked_cost_bounded(checked_cost_min(checked_cost_min(first, second), checked_cost_min(third, fourth)), checked_cost_max(checked_cost_max(first, second), checked_cost_max(third, fourth)))
        }
        .FloorDiv -> {
            if right.lo <= 0 && right.hi >= 0 -> return None
            if left.lo == TCOST_I128_MIN && right.lo <= -1 && right.hi >= -1 -> return None
            first: left.lo /% right.lo
            second: left.lo /% right.hi
            third: left.hi /% right.lo
            fourth: left.hi /% right.hi
            return checked_cost_bounded(checked_cost_min(checked_cost_min(first, second), checked_cost_min(third, fourth)), checked_cost_max(checked_cost_max(first, second), checked_cost_max(third, fourth)))
        }
        .Mod | .Rem -> {
            if right.lo <= 0 && right.hi >= 0 -> return None
            if left.lo == 0 && left.hi == 0 -> return Val(integer_bounds_exact(0))
            if right.lo == TCOST_I128_MIN || right.hi == TCOST_I128_MIN -> return None
            low_abs: if right.lo < 0 -> -right.lo else -> right.lo
            high_abs: if right.hi < 0 -> -right.hi else -> right.hi
            magnitude: checked_cost_max(low_abs, high_abs) - 1
            if right.hi < 0 -> return Val(TIntegerBounds{lo: -magnitude, hi: 0})
            return Val(TIntegerBounds{lo: 0, hi: magnitude})
        }
        .Div | .Pow | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Gt | .Le | .Ge | .Compare | .And | .Or -> return None
    }
}

checked_builtin_mutates_receiver: fn(operation: TBuiltinOp) -> Bool Never! {
    if operation == {
        .Push | .TryPush | .TryReserve | .TryInsertMap | .TryStringPush | .StringEdit(_) | .Pop | .InsertMap | .AddNewMap | .MapUpdate | .InsertList | .RemoveMap | .RemoveList(_, _) | .MapPopFirst | .ExtendList | .Reverse | .SwapList | .ListFill | .ListFillRepeat | .ListReplace | .Sort | .SortDesc | .Clear | .SetInsert | .SetUpdate | .SetDifferenceUpdate | .SetIntersectionUpdate | .SetSymmetricDifferenceUpdate | .SetRemove | .SetPop | .SetReplace | .SortedSetInsert | .SortedSetRemove | .BitSetAdd | .BitSetRemove | .BagAdd | .BagRemove | .LRUPut | .LRUAddNew | .LRUGet | .LRURemove | .DequePushFront | .DequePushBack | .DequePopFront | .DequePopBack | .DequeDelete | .DequeReverse | .DequeSplit | .SplitWrite | .GetDisjointWrite | .PriorityQueuePop | .PriorityQueueRemove(_, _) | .IterNext -> return true
        .ByteBufferWrite(_) -> return true
        .ByteBufferMethod(symbol) -> return builtin_byte_buffer_row(symbol).access == AccessConvention.Write
        .AtomicMethod(_) | .LenString | .LenList | .IsEmpty | .ListTryNew | .ListTryWithCapacity | .MapMerge | .MapMergeWith | .CountList | .Counts | .ConcatList | .GetMap | .GetList | .First | .Last | .Contains | .IndexOf | .OrderingThen | .OrderingReverse | .JoinSep | .Sum(_, _) | .Product(_) | .Min(_) | .Max(_) | .Flatten | .Intersperse | .Unzip | .Chars | .Bytes(_) | .StringFromBytes | .StringFromBytesLossy | .StringWithCapacity | .Trim | .TrimStart | .TrimEnd | .PadStart | .PadEnd | .StringIndexOf | .StringCount | .StringIsAlphabetic | .StringIsNumeric | .StringIsWhitespace | .StringIsASCII | .StringToTitle | .StringMethod(_) | .StringSplitOnce | .StringCutLast | .Split | .Lines | .ParseInt | .ParseFloat | .IntToRadix | .IntFromRadix | .StartsWith | .EndsWith | .Replace | .ToUpper | .ToLower | .ToASCIILower | .ToASCIIUpper | .Repeat | .Slice(_) | .After | .Before | .TrimView | .AfterView | .BeforeView | .Keys | .Values | .ContainsKey | .ToString | .Take | .Skip | .IterToList | .IterCollect | .ListLazy | .StepBy | .Dedup | .Chunks | .Windows | .IterRepeat | .IterCycle | .IterDropLast | .IterShuffle | .IterIsSorted | .IterLastIndexOf | .IterAverage(_) | .IterCompare | .IterSplit | .ListSlice | .ListEqual | .ListBinarySearch | .ListUnion | .ListIntersection | .ListDifference | .ListRandom | .ListMinMax | .MapEqual | .MapFirst | .MapToList | .MapTopN | .MapMin | .MapMax | .MapIntersection | .MapSliceKeys | .MapFromKeys | .MapContainsValue | .Indexed | .Indexes | .Zip(_, _, _, _, _, _) | .OptionZip(_) | .SetFrom | .SetToList | .SetUnion | .SetIntersection | .SetDifference | .SetSymmetricDifference | .SetIsSubset | .SetIsSuperset | .SetIsDisjoint | .SetEqual | .SetCapacity | .SetFirst | .SetValues | .SetSort | .SetShuffle | .SortedSetFrom | .SortedSetToList | .SortedSetUnion | .SortedSetIntersection | .SortedSetDifference | .SortedSetSymmetricDifference | .SortedSetIsSubset | .SortedSetIsSuperset | .SortedSetIsDisjoint | .PriorityQueueFrom | .PriorityQueuePeek | .PriorityQueueToSortedList | .KeyOrdered(_, _) | .LRUCapacity | .LRUKeys | .BitSetCount | .BitSetToList | .ByteBufferFrom | .ByteBufferToBytes | .ByteBufferWithCapacity | .BagHas | .BagCount | .DequePeekFront | .DequePeekBack | .DequeCapacity | .DequeContains | .DequeGet | .DequeToList | .DequeJoin | .DequeFrom | .TryCollect | .ViewNew(_) -> return false
    }
}

// One checked expression's run-time cost: what it may do on a hot path and
// whether a typed proof removed it. `written` marks a cost that is the own
// work of a call the source writes (`text.lines()` copying each line out),
// not a copy the source doesn't show.
TCostFact: struct {
    kind: TCostKind,
    state: TCostState,
    written: Bool{false},
}

// The checked type of node `id` of `tree`, when the tree files one.
body_cost_type: fn(tree: BodyTree, id: Int) -> Type? Never! {
    row: checked_expr_type_id(tree.expr_types, id) ?? return None
    Val(tree.types.types[row])
}

// Whether `bounds` stays on the packed Int rail, which never spills.
checked_cost_fits_inline: fn(bounds: TIntegerBounds) -> Bool Never! {
    bounds.lo >= TCOST_INLINE_MIN && bounds.hi <= TCOST_INLINE_MAX
}

// The values node `id` of a checked body may take, proved as JetSema
// CostTree.jet checked_cost_integer_bounds proves them over the checked tree:
// a literal, a local's recorded bounds or its range loop's
// (body_cost_loop_counter_bounds), an inline-range or `i64` conversion,
// a negation or arithmetic of bounded operands, a `??` of bounded sides; else
// the bounds of the node's type.
body_cost_integer_bounds: fn(tree: BodyTree, id: Int) -> TIntegerBounds? Never! {
    node: body_node(tree, id)
    bounds := TIntegerBounds?{None}
    if node.kind == .IntLit(value, _) -> bounds = Val(integer_bounds_exact(value)) else if node.kind == .CtLit(value) {
        if value == .Int(number) -> bounds = Val(integer_bounds_exact(number))
    } else if node.kind == .Local(local) {
        bounds = local.integer_bounds
        if bounds == None -> bounds = body_cost_loop_counter_bounds(tree, local)
    } else if node.kind == .NumericMethod(receiver, operation) {
        if operation == .InlineRange(lo, hi, _) -> bounds = Val(TIntegerBounds{lo: lo, hi: hi}) else if operation == .CastAs(destination) {
            if destination == "i64" && body_cost_integer_bounds(tree, receiver) == .Val(original) && original.lo >= -9223372036854775808 && original.hi <= 9223372036854775807 {
                bounds = Val(original)
            }
        }
    } else if node.kind == .Unary(op, operand) {
        if op == TUnaryOp.Neg && body_cost_integer_bounds(tree, operand) == .Val(inner) {
            bounds = checked_cost_bounded(-inner.hi, -inner.lo)
        }
    } else if node.kind == .Binary(op, _, _, left, right) {
        if body_cost_integer_bounds(tree, left) == .Val(lhs) && body_cost_integer_bounds(tree, right) == .Val(rhs) {
            bounds = checked_cost_combine_bounds(op, lhs, rhs)
        }
    } else if node.kind == .OrFallback(value, fallback, _) {
        success := TIntegerBounds?{None}
        if body_cost_type(tree, value) == .Val(carrier) {
            if carrier == .Option(inner) -> success = checked_cost_type_bounds(inner) else if carrier == .Result(ok, _) {
                success = checked_cost_type_bounds(ok)
            }
        }
        if fallback == .Value(alternative) {
            if success == .Val(normal) && body_cost_integer_bounds(tree, alternative) == .Val(other) {
                bounds = Val(TIntegerBounds{lo: checked_cost_min(normal.lo, other.lo), hi: checked_cost_max(normal.hi, other.hi)})
            }
        } else { bounds = success }
    }
    if bounds != None -> return bounds
    ty: body_cost_type(tree, id) ?? return None
    checked_cost_type_bounds(ty)
}

// The values the counter `local` of a range loop of `tree` takes in its body
// (JetIR ir_range_loop): from its start up to its end when the step is
// positive or absent, down to it when the step is negative, and between the
// two when the step's sign is unknown; one short of the end when the range
// excludes it. None for a local no range loop counts with.
body_cost_loop_counter_bounds: fn(tree: BodyTree, local: TLocal) -> TIntegerBounds? Never! {
    if local.mutable || local.ty != Type.Int || local.symbol_id == None -> return None
    loop statement in tree.stmts {
        if statement == .ForRange(_, counter, start, end, step, exclusive, _, _, _) && counter.symbol_id == local.symbol_id {
            return body_cost_range_bounds(tree, start, end, step, if exclusive -> 1 else -> 0)
        }
        if statement == .Range(_, counter, source, start, end, step, exclusive, _, _, _) && source == None && counter.symbol_id == local.symbol_id {
            return body_cost_range_bounds(tree, start, end, step, if exclusive -> 1 else -> 0)
        }
    }
    None
}

// The values a range loop's counter takes from `start` to `end` by `step`,
// stopping `short` before the end (body_cost_loop_counter_bounds).
body_cost_range_bounds: fn(tree: BodyTree, start: Int, end: Int, step: Int?, short: Int) -> TIntegerBounds? Never! {
    first: body_cost_integer_bounds(tree, start) ?? return None
    last: body_cost_integer_bounds(tree, end) ?? return None
    if step == .Val(stride) {
        by: body_cost_integer_bounds(tree, stride) ?? return checked_cost_bounded(checked_cost_min(first.lo, last.lo), checked_cost_max(first.hi, last.hi))
        if by.hi <= -1 -> return checked_cost_bounded(last.lo + short, first.hi)
        if by.lo < 1 -> return checked_cost_bounded(checked_cost_min(first.lo, last.lo), checked_cost_max(first.hi, last.hi))
    }
    checked_cost_bounded(first.lo, last.hi - short)
}

// An exact Int operation's cost: removed when its operands and its result
// all stay on the packed Int rail, else a possible spill to a bigint.
checked_cost_int_fact: fn(operands: [TIntegerBounds?], result: TIntegerBounds?) -> TCostFact Never! {
    removed := result != None
    if result == .Val(bounds) && !checked_cost_fits_inline(bounds) -> removed = false
    loop operand in operands {
        if operand == .Val(bounds) {
            if !checked_cost_fits_inline(bounds) -> removed = false
        } else { removed = false }
    }
    TCostFact{kind: TCostKind.ExactIntSpill, state: if removed -> TCostState.OptimizerRemoved else -> TCostState.SemanticRemainder}
}

// The cost of node `node` of a checked body, as the Rust reference's
// cost_fact_for_expr reads a typed expression: a read-only view made owned
// (a view local stored into an owned slot, or `text.lines()`, which copies
// each line of `text` out into an owned String as the written call's own
// work), a copy sema made without
// one being written that allocates (a share site's copy of a value still
// used later, or a materialized argument; a bitwise copy or a Shared
// handle's count bump is Scalar and no site), an edit of a map's possibly
// shared backing store, exact Int `+`, `-`, `*` (written, or under
// `wrapping`/`saturating`) or negation, a list read through the generic
// representation, or an operation that builds an Option or a Result. The
// `Ok` checking wraps a fallible function's plain result in spans exactly its
// payload; no construction is written there, so it is no site. A view made
// owned where the source writes the copy (a written `copy`, `freeze(view)`)
// spans more than the view, so it is no hidden copy and no site either.
body_cost_fact: fn(tree: BodyTree, node: BodyNode) -> TCostFact? Never! {
    ty: body_cost_type(tree, node.id) ?? return None
    if node.kind == .MaterializeView(value) {
        view: body_node(tree, value).span
        if view.start != node.span.start || view.end != node.span.end -> return None
        return Val(TCostFact{kind: TCostKind.ViewMaterialization, state: TCostState.SemanticRemainder})
    }
    if node.kind == .Clone(_, fact) {
        if fact == CopyFact.Share || fact == CopyFact.Materialize {
            return Val(TCostFact{kind: TCostKind.ImplicitCopy, state: TCostState.SemanticRemainder})
        }
    }
    if node.kind == .BuiltinMethod(receiver, operation, _) && body_cost_type(tree, receiver) == .Val(receiver_type) {
        if checked_builtin_mutates_receiver(operation) && receiver_type == .Map(_, _, _) {
            return Val(TCostFact{kind: TCostKind.CollectionCopyOnWrite, state: TCostState.SemanticRemainder})
        }
        if operation == TBuiltinOp.Lines && receiver_type == Type.String {
            return Val(TCostFact{kind: TCostKind.ViewMaterialization, state: TCostState.SemanticRemainder, written: true})
        }
    }
    if ty == Type.Int {
        if node.kind == .Binary(op, _, _, left, right) {
            if op == TBinaryOp.Add || op == TBinaryOp.Sub || op == TBinaryOp.Mul {
                return Val(body_cost_int_operation_fact(tree, op, left, right))
            }
        } else if node.kind == .OverflowOpt(prefix, operation, _, left, right) {
            if body_cost_int_policy_operator(prefix, operation) == .Val(op) {
                return Val(body_cost_int_operation_fact(tree, op, left, right))
            }
        } else if node.kind == .Unary(op, operand) {
            if op == TUnaryOp.Neg {
                inner: body_cost_integer_bounds(tree, operand)
                result := TIntegerBounds?{None}
                if inner == .Val(bounds) -> result = checked_cost_bounded(-bounds.hi, -bounds.lo)
                return Val(checked_cost_int_fact([TIntegerBounds?]{inner}, result))
            }
        }
    }
    if node.kind == .Index(base, _, kind, _, _, _) {
        if kind != TIndexKind.Map && body_cost_type(tree, base) == .Val(base_type) {
            fallback: TCostFact{kind: TCostKind.RepresentationFallback, state: TCostState.SemanticRemainder}
            if base_type == .List(_) -> return Val(fallback)
            if base_type == .FixedList(_, _) -> return Val(fallback)
        }
    }
    if node.kind == .Ok(value) {
        payload: body_node(tree, value).span
        if payload.start == node.span.start && payload.end == node.span.end -> return None
    }
    if body_cost_builds_outcome(node.kind) {
        outcome: TCostFact{kind: TCostKind.OutcomeConstruction, state: TCostState.SemanticRemainder}
        if ty == .Option(_) -> return Val(outcome)
        if ty == .Result(_, _) -> return Val(outcome)
    }
    None
}

// The cost of the exact Int `left op right`, `op` `+`, `-` or `*`
// (body_cost_fact).
body_cost_int_operation_fact: fn(tree: BodyTree, op: TBinaryOp, left: Int, right: Int) -> TCostFact Never! {
    lhs: body_cost_integer_bounds(tree, left)
    rhs: body_cost_integer_bounds(tree, right)
    result := TIntegerBounds?{None}
    if lhs == .Val(first) && rhs == .Val(second) {
        result = checked_cost_combine_bounds(op, first, second)
    }
    checked_cost_int_fact([TIntegerBounds?]{lhs, rhs}, result)
}

// The operator a `wrapping(…)` or `saturating(…)` of an Int `+`, `-` or `*`
// (an `.OverflowOpt` node, `prefix` the word and `operation` the operator's
// name) computes: on an unbounded Int either word is the exact operator
// itself (JetIR ir_overflow_opt), so it grows as the operator does. None
// for any other word or operator.
body_cost_int_policy_operator: fn(prefix: String, operation: String) -> TBinaryOp? Never! {
    if prefix != "wrapping" && prefix != "saturating" -> return None
    if operation == {
        "add" -> Val(TBinaryOp.Add)
        "sub" -> Val(TBinaryOp.Sub)
        "mul" -> Val(TBinaryOp.Mul)
        else -> None
    }
}

// Whether a node of kind `kind` builds the Option or Result it has: a
// constructor, a call or a fallible conversion, not a read of one held.
body_cost_builds_outcome: fn(kind: NodeKind) -> Bool Never! {
    if kind == {
        .Absent | .Present(_) | .Ok(_) | .Err(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .ClosureMethod(_, _, _) | .HandleMethod(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .DecodeUnder(_, _) | .OptionLift2(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) -> true
        .DistinctConvert(_, _, _, _, fallible) -> fallible
        .UnitConvert(_, _, _, _, fallible, _, _, _) -> fallible
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) | .GlobalShared(_, _) | .DistinctCtor(_) | .TraitBox(_, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .OrFallback(_, _, _) | .PatternMatches(_, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .CoreClosureCall(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .TypePath(_) -> false
    }
}
