

// Frozen typed cost evidence, shared by lowering and its reporting consumers.
// Mirrors the Rust reference's cost_fact_for_expr; never inspect generated adapter text.
TCOST_I128_MIN: -170141183460469231731687303715884105728

TCOST_I128_MAX: 170141183460469231731687303715884105727

TCOST_INLINE_MIN: -4611686018427387904

TCOST_INLINE_MAX: 4611686018427387903

checked_cost_bounded: fn(lo: Int, hi: Int) -> TIntegerBounds? Never! {
    if lo < TCOST_I128_MIN || hi > TCOST_I128_MAX -> return None
    Val(TIntegerBounds{lo: lo, hi: hi})
}

checked_cost_type_bounds: fn(ty: Type) -> TIntegerBounds? Never! {
    if ty == {
        .InlineRange(_, lo, hi) -> checked_cost_bounded(lo, hi)
        .IntN(signed, bits) -> {
            if bits <= 0 || bits > 128 || (!signed && bits == 128) -> return None
            if signed {
                limit: 1 << (bits - 1)
                return Val(TIntegerBounds{lo: -limit, hi: limit - 1})
            }
            Val(TIntegerBounds{lo: 0, hi: (1 << bits) - 1})
        }
        .Tagged(_, inner) -> checked_cost_type_bounds(inner)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
}

checked_cost_min: fn(left: Int, right: Int) -> Int Never! { if left < right -> left else -> right }

checked_cost_max: fn(left: Int, right: Int) -> Int Never! { if left > right -> left else -> right }

checked_cost_combine_bounds: fn(op: TBinaryOp, left: TIntegerBounds, right: TIntegerBounds) -> TIntegerBounds? Never! {
    if op == {
        .Add -> return checked_cost_bounded(checked_cost_min(left.lo + right.lo, 0), checked_cost_max(left.hi + right.hi, 0))
        .Sub -> return checked_cost_bounded(checked_cost_min(left.lo - right.hi, 0), checked_cost_max(left.hi - right.lo, 0))
        .Mul -> {
            first: left.lo * right.lo
            second: left.lo * right.hi
            third: left.hi * right.lo
            fourth: left.hi * right.hi
            return checked_cost_bounded(checked_cost_min(checked_cost_min(first, second), checked_cost_min(third, fourth)), checked_cost_max(checked_cost_max(first, second), checked_cost_max(third, fourth)))
        }
        .FloorDiv -> {
            if right.lo <= 0 && right.hi >= 0 -> return None
            if left.lo == TCOST_I128_MIN && right.lo <= -1 && right.hi >= -1 -> return None
            first: left.lo /% right.lo
            second: left.lo /% right.hi
            third: left.hi /% right.lo
            fourth: left.hi /% right.hi
            return checked_cost_bounded(checked_cost_min(checked_cost_min(first, second), checked_cost_min(third, fourth)), checked_cost_max(checked_cost_max(first, second), checked_cost_max(third, fourth)))
        }
        .Mod | .Rem -> {
            if right.lo <= 0 && right.hi >= 0 -> return None
            if left.lo == 0 && left.hi == 0 -> return Val(integer_bounds_exact(0))
            if right.lo == TCOST_I128_MIN || right.hi == TCOST_I128_MIN -> return None
            low_abs: if right.lo < 0 -> -right.lo else -> right.lo
            high_abs: if right.hi < 0 -> -right.hi else -> right.hi
            magnitude: checked_cost_max(low_abs, high_abs) - 1
            if right.hi < 0 -> return Val(TIntegerBounds{lo: -magnitude, hi: 0})
            return Val(TIntegerBounds{lo: 0, hi: magnitude})
        }
        .Div | .Pow | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Gt | .Le | .Ge | .Compare | .And | .Or -> return None
    }
}

checked_builtin_mutates_receiver: fn(operation: TBuiltinOp) -> Bool Never! {
    if operation == {
        .Push | .TryPush | .TryReserve | .TryInsertMap | .TryStringPush | .StringEdit(_) | .Pop
        | .InsertMap | .AddNewMap | .MapSetDefault | .MapUpdate | .InsertList | .RemoveMap
        | .RemoveList(_, _) | .MapPopFirst | .ExtendList | .Reverse | .SwapList | .ListFill | .ListFillRepeat | .ListReplace
        | .Sort | .SortDesc | .Clear
        | .SetInsert | .SetUpdate | .SetDifferenceUpdate | .SetIntersectionUpdate
        | .SetSymmetricDifferenceUpdate | .SetRemove | .SetPop | .SetReplace | .SortedSetInsert
        | .SortedSetRemove | .BitSetAdd | .BitSetRemove | .BagAdd | .BagRemove | .LRUPut
        | .LRUAddNew | .LRUGet | .LRURemove | .DequePushFront | .DequePushBack | .DequePopFront
        | .DequePopBack | .DequeDelete | .DequeReverse | .DequeSplit | .SplitWrite | .GetDisjointWrite
        | .PriorityQueuePop | .PriorityQueueRemove(_, _) | .IterNext -> return true
        .ByteBufferWrite(_) -> return true
        .ByteBufferMethod(method) -> return method == "clear" || method == "seek" || method == "rewind" || method == "next" || method == "read" || method == "read_byte" || method == "read_bytes" || method == "read_string" || method == "flush" || method == "close" || method == "shutdown" || method == "copy_to" || method == "write_to"
        .AtomicMethod(_) | .LenString | .LenList | .IsEmpty | .ListTryNew | .ListTryWithCapacity | .MapMerge | .MapMergeWith | .CountList | .Counts | .ConcatList | .GetMap | .GetList | .First | .Last | .Contains | .IndexOf | .OrderingThen | .OrderingReverse | .JoinSep | .Sum(_, _) | .Product(_) | .Min(_) | .Max(_) | .Flatten | .Intersperse | .Unzip | .Chars | .Bytes(_) | .StringFromBytes | .StringFromBytesLossy | .StringWithCapacity | .Trim | .TrimStart | .TrimEnd | .PadStart | .PadEnd | .StringIndexOf | .StringCount | .StringIsAlphabetic | .StringIsNumeric | .StringIsWhitespace | .StringIsASCII | .StringToTitle | .StringMethod(_) | .StringSplitOnce | .StringCutLast | .Split | .Lines | .ParseInt | .ParseFloat | .IntToRadix | .IntFromRadix | .StartsWith | .EndsWith | .Replace | .ToUpper | .ToLower | .ToASCIILower | .ToASCIIUpper | .Repeat | .Slice(_) | .After | .Before | .TrimView | .AfterView | .BeforeView | .Keys | .Values | .ContainsKey | .ToString | .Take | .Skip | .IterToList | .IterCollect | .ListLazy | .StepBy | .Dedup | .Chunks | .Windows | .IterRepeat | .IterCycle | .IterDropLast | .IterShuffle | .IterIsSorted | .IterLastIndexOf | .IterAverage(_) | .IterCompare | .IterSplit | .ListSlice | .ListEqual | .ListBinarySearch | .ListUnion | .ListIntersection | .ListDifference | .ListRandom | .ListMinMax | .MapEqual | .MapFirst | .MapToList | .MapTopN | .MapMin | .MapMax | .MapIntersection | .MapSliceKeys | .MapFromKeys | .MapContainsValue | .ListReplace | .Indexed | .Indexes | .Zip(_, _, _, _, _, _) | .OptionZip(_) | .SetFrom | .SetToList | .SetUnion | .SetIntersection | .SetDifference | .SetSymmetricDifference | .SetIsSubset | .SetIsSuperset | .SetIsDisjoint | .SetEqual | .SetCapacity | .SetFirst | .SetValues | .SetSort | .SetShuffle | .SortedSetFrom | .SortedSetToList | .SortedSetUnion | .SortedSetIntersection | .SortedSetDifference | .SortedSetSymmetricDifference | .SortedSetIsSubset | .SortedSetIsSuperset | .SortedSetIsDisjoint | .PriorityQueueFrom | .PriorityQueuePeek | .PriorityQueueToSortedList | .KeyOrdered(_, _) | .LRUCapacity | .LRUKeys | .BitSetCount | .BitSetToList | .ByteBufferFrom | .ByteBufferToBytes | .ByteBufferWithCapacity | .BagHas | .BagCount | .DequePeekFront | .DequePeekBack | .DequeCapacity | .DequeContains | .DequeGet | .DequeToList | .DequeJoin | .DequeFrom | .TryCollect | .ViewNew(_) -> return false
    }
}
