body_codec_get_expr: fn(bytes: [U8], input: ^BodyCodecIn) -> Expr Never! {
    position: body_codec_get_tag(bytes, input, 51, 0)
    if position == {
        1 -> {
            f0: body_codec_get_list_strmatchpart(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_int(bytes, input)
            Expr.StrMatchLit{parts: f0, span: f1, id: f2}
        }
        2 -> {
            f0: body_codec_get_list_binmatchpart(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_int(bytes, input)
            Expr.BinMatchLit{parts: f0, span: f1, id: f2}
        }
        3 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_opt_integerwidth(bytes, input)
            f3: body_codec_get_opt_string(bytes, input)
            f4: body_codec_get_int(bytes, input)
            Expr.Int{value: f0, span: f1, width: f2, raw: f3, id: f4}
        }
        4 -> {
            f0: body_codec_get_float(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_bool(bytes, input)
            f3: body_codec_get_opt_string(bytes, input)
            f4: body_codec_get_int(bytes, input)
            Expr.Float{value: f0, span: f1, is_f32: f2, raw: f3, id: f4}
        }
        5 -> {
            f0: body_codec_get_bool(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_int(bytes, input)
            Expr.Bool{value: f0, span: f1, id: f2}
        }
        6 -> {
            f0: body_codec_get_span(bytes, input)
            f1: body_codec_get_int(bytes, input)
            Expr.Unit{span: f0, id: f1}
        }
        7 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_int(bytes, input)
            Expr.Char{value: f0, span: f1, id: f2}
        }
        8 -> {
            f0: body_codec_get_list_expr(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_int(bytes, input)
            Expr.ListLit{elements: f0, span: f1, id: f2}
        }
        9 -> {
            f0: body_codec_get_expr(bytes, input)
            f1: body_codec_get_list_exprmember(bytes, input)
            f2: body_codec_get_span(bytes, input)
            f3: body_codec_get_int(bytes, input)
            Expr.MemberSpread{base: f0, members: f1, span: f2, id: f3}
        }
        10 -> {
            f0: body_codec_get_expr(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_int(bytes, input)
            Expr.Spread{value: f0, span: f1, id: f2}
        }
        11 -> {
            f0: body_codec_get_list_exprpair(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_int(bytes, input)
            Expr.MapLit{entries: f0, span: f1, id: f2}
        }
        12 -> {
            f0: body_codec_get_expr(bytes, input)
            f1: body_codec_get_expr(bytes, input)
            f2: body_codec_get_span(bytes, input)
            f3: body_codec_get_indexkind(bytes, input)
            f4: body_codec_get_int(bytes, input)
            Expr.Index{base: f0, index: f1, span: f2, kind: f3, id: f4}
        }
        13 -> {
            f0: body_codec_get_expr(bytes, input)
            f1: body_codec_get_expr(bytes, input)
            f2: body_codec_get_expr(bytes, input)
            f3: body_codec_get_opt_expr(bytes, input)
            f4: body_codec_get_span(bytes, input)
            f5: body_codec_get_int(bytes, input)
            Expr.Slice{base: f0, start: f1, end: f2, range: f3, span: f4, id: f5}
        }
        14 -> {
            f0: body_codec_get_expr(bytes, input)
            f1: body_codec_get_expr(bytes, input)
            f2: body_codec_get_bool(bytes, input)
            f3: body_codec_get_span(bytes, input)
            f4: body_codec_get_int(bytes, input)
            Expr.Range{start: f0, end: f1, exclusive: f2, span: f3, id: f4}
        }
        15 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_int(bytes, input)
            Expr.Ident{name: f0, span: f1, id: f2}
        }
        16 -> {
            f0: body_codec_get_call(bytes, input)
            f1: body_codec_get_int(bytes, input)
            Expr.Call{call: f0, id: f1}
        }
        17 -> {
            f0: body_codec_get_unop(bytes, input)
            f1: body_codec_get_expr(bytes, input)
            f2: body_codec_get_span(bytes, input)
            f3: body_codec_get_int(bytes, input)
            Expr.Unary{op: f0, operand: f1, span: f2, id: f3}
        }
        18 -> {
            f0: body_codec_get_binop(bytes, input)
            f1: body_codec_get_expr(bytes, input)
            f2: body_codec_get_expr(bytes, input)
            f3: body_codec_get_span(bytes, input)
            f4: body_codec_get_int(bytes, input)
            Expr.Binary{op: f0, left: f1, right: f2, span: f3, id: f4}
        }
        19 -> {
            f0: body_codec_get_list_expr(bytes, input)
            f1: body_codec_get_list_binop(bytes, input)
            f2: body_codec_get_list_bool(bytes, input)
            f3: body_codec_get_span(bytes, input)
            f4: body_codec_get_int(bytes, input)
            Expr.CompareChain{operands: f0, ops: f1, hooks: f2, span: f3, id: f4}
        }
        20 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_opt_int(bytes, input)
            f2: body_codec_get_opt_float(bytes, input)
            f3: body_codec_get_string(bytes, input)
            f4: body_codec_get_span(bytes, input)
            f5: body_codec_get_span(bytes, input)
            f6: body_codec_get_int(bytes, input)
            Expr.UnitLit{raw: f0, int: f1, float: f2, suffix: f3, suffix_span: f4, span: f5, id: f6}
        }
        21 -> {
            f0: body_codec_get_expr(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_int(bytes, input)
            Expr.Deref{value: f0, span: f1, id: f2}
        }
        22 -> {
            f0: body_codec_get_expr(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_int(bytes, input)
            Expr.RawOf{value: f0, span: f1, id: f2}
        }
        23 -> {
            f0: body_codec_get_expr(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_int(bytes, input)
            Expr.Copy{value: f0, span: f1, id: f2}
        }
        24 -> {
            f0: body_codec_get_expr(bytes, input)
            f1: body_codec_get_placeaccess(bytes, input)
            f2: body_codec_get_span(bytes, input)
            f3: body_codec_get_int(bytes, input)
            Expr.Place{value: f0, access: f1, span: f2, id: f3}
        }
        25 -> {
            f0: body_codec_get_expr(bytes, input)
            f1: body_codec_get_string(bytes, input)
            f2: body_codec_get_span(bytes, input)
            f3: body_codec_get_int(bytes, input)
            Expr.Field{base: f0, member: f1, span: f2, id: f3}
        }
        26 -> {
            f0: body_codec_get_expr(bytes, input)
            f1: body_codec_get_string(bytes, input)
            f2: body_codec_get_span(bytes, input)
            f3: body_codec_get_bool(bytes, input)
            f4: body_codec_get_span(bytes, input)
            f5: body_codec_get_int(bytes, input)
            Expr.OptField{base: f0, member: f1, member_span: f2, flatten: f3, span: f4, id: f5}
        }
        27 -> {
            f0: body_codec_get_expr(bytes, input)
            f1: body_codec_get_string(bytes, input)
            f2: body_codec_get_span(bytes, input)
            f3: body_codec_get_list_type(bytes, input)
            f4: body_codec_get_list_type(bytes, input)
            f5: body_codec_get_list_callarg(bytes, input)
            f6: body_codec_get_int(bytes, input)
