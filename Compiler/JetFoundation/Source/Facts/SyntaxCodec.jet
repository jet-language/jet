    f7: body_codec_get_span(bytes, input)
    f8: body_codec_get_list_marker(bytes, input)
    f9: body_codec_get_opt_modulecap(bytes, input)
    GenericModuleDef{name: f0, name_span: f1, is_pub: f2, is_package_pub: f3, params: f4, imports: f5, body: f6, span: f7, markers: f8, cap: f9}
}

body_codec_put_genericmoduleparam: fn(out: ^BodyCodecOut, value: GenericModuleParam) Never! {
    if value == {
        .Type(p0, p1, p2) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_opt_type(out, p2)
        }
        .Value(p0, p1, p2) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_type(out, p2)
        }
    }
}

body_codec_get_genericmoduleparam: fn(bytes: [U8], input: ^BodyCodecIn) -> GenericModuleParam Never! {
    position: body_codec_get_tag(bytes, input, 2, 0)
    if position == {
        1 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_type(bytes, input)
            GenericModuleParam.Value{name: f0, name_span: f1, ty: f2}
        }
        else -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_opt_type(bytes, input)
            GenericModuleParam.Type{name: f0, name_span: f1, bound: f2}
        }
    }
}

