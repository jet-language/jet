    f17: body_codec_get_bool(bytes, input)
    f18: body_codec_get_bool(bytes, input)
    f19: body_codec_get_opt_span(bytes, input)
    f20: body_codec_get_bool(bytes, input)
    f21: body_codec_get_opt_type(bytes, input)
