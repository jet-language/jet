    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_bindname(out, value)
}

body_codec_get_list_bindname: fn(bytes: [U8], input: ^BodyCodecIn) -> [BindName] Never! {
    count: body_codec_get_count(bytes, input, 1)
    ^values: [BindName]{}
    loop _ in 0..<count -> values.push(body_codec_get_bindname(bytes, input))
    values
}

body_codec_put_bindpattern: fn(out: ^BodyCodecOut, value: BindPattern) Never! {
    if value == {
        .Struct(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_list_bindname(out, p2)
            body_codec_put_opt_span(out, p3)
            body_codec_put_span(out, p4)
        }
        .List(p0, p1) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_list_bindname(out, p0)
            body_codec_put_span(out, p1)
        }
        .Tuple(p0, p1) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_list_bindname(out, p0)
            body_codec_put_span(out, p1)
        }
        .Refutable(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 3)
            body_codec_put_pattern(out, p0)
            body_codec_put_orfallback(out, p1)
            body_codec_put_list_bindname(out, p2)
            body_codec_put_span(out, p3)
        }
    }
}

body_codec_get_bindpattern: fn(bytes: [U8], input: ^BodyCodecIn) -> BindPattern Never! {
    position: body_codec_get_tag(bytes, input, 4, 0)
    if position == {
        1 -> {
            f0: body_codec_get_list_bindname(bytes, input)
            f1: body_codec_get_span(bytes, input)
            BindPattern.List{elems: f0, span: f1}
        }
        2 -> {
            f0: body_codec_get_list_bindname(bytes, input)
            f1: body_codec_get_span(bytes, input)
            BindPattern.Tuple{elems: f0, span: f1}
        }
        3 -> {
            f0: body_codec_get_pattern(bytes, input)
            f1: body_codec_get_orfallback(bytes, input)
            f2: body_codec_get_list_bindname(bytes, input)
            f3: body_codec_get_span(bytes, input)
            BindPattern.Refutable{pattern: f0, fallback: f1, names: f2, span: f3}
        }
        else -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_list_bindname(bytes, input)
            f3: body_codec_get_opt_span(bytes, input)
            f4: body_codec_get_span(bytes, input)
            BindPattern.Struct{type_name: f0, type_span: f1, fields: f2, rest: f3, span: f4}
        }
    }
}

body_codec_put_opt_bindnamerename: fn(out: ^BodyCodecOut, value: BindNameRename?) Never! {
