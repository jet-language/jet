            body_codec_put_constdef(out, p0)
        }
        .Test(p0) -> {
            body_codec_put_tag(out, 11)
            body_codec_put_testdef(out, p0)
        }
        .ExternRust(p0) -> {
            body_codec_put_tag(out, 12)
            body_codec_put_externrustblock(out, p0)
