        2 -> TryConvert.DefaultErr
        3 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_type(bytes, input)
            f2: body_codec_get_type(bytes, input)
            TryConvert.Typed{fn_name: f0, source: f1, target: f2}
        }
        4 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_string(bytes, input)
            TryConvert.WidenUnion{enum_name: f0, tag: f1}
        }
        else -> TryConvert.NoConversion
    }
}

