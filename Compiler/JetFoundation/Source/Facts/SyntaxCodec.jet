    f24: body_codec_get_opt_viewprovenancemap(bytes, input)
    f25: body_codec_get_opt_list_string(bytes, input)
    f26: body_codec_get_bool(bytes, input)
    f27: body_codec_get_opt_type(bytes, input)
    f28: body_codec_get_opt_string(bytes, input)
    f29: body_codec_get_opt_frameschedule(bytes, input)
    f30: body_codec_get_opt_derivationrecord(bytes, input)
    LambdaMeta{escapes: f0, runtime_erased: f1, http_route_source: f2, bound_write: f3, needs_fn_mut: f4, mut_captures: f5, cloned_captures: f6, effect_direct: f7, effect_solved: f8, effect_call_edges: f9, effect_maximal: f10, effect_direct_spans: f11, frozen_captures: f12, materialized_captures: f13, moved_captures: f14, collecting_loop: f15, collect_item_type: f16, result_loop: f17, requires_exhaustion_route: f18, exhaustion_span: f19, exhaustion_route_attached: f20, loop_result_type: f21, loop_label: f22, guard_projection: f23, return_view_provenance: f24, cell_projection_path: f25, fallible_propagation: f26, fallible_carrier: f27, frame_schedule_explanation: f28, frame_schedule: f29, frame_schedule_derivation: f30}
}

