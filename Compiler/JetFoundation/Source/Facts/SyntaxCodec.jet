body_codec_put_opt_unitdimensiondecl: fn(out: ^BodyCodecOut, value: UnitDimensionDecl?) Never! {
    if value == .Val(inner) {
        body_codec_put_bool(out, true)
        body_codec_put_unitdimensiondecl(out, inner)
        return
    }
    body_codec_put_bool(out, false)
}

body_codec_get_opt_unitdimensiondecl: fn(bytes: [U8], input: ^BodyCodecIn) -> UnitDimensionDecl? Never! {
    if body_codec_get_bool(bytes, input) {
        return Val(body_codec_get_unitdimensiondecl(bytes, input))
    }
    None
}

