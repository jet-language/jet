}

body_codec_put_unitdimensiondecl: fn(out: ^BodyCodecOut, value: UnitDimensionDecl) Never! {
    if value == {
        .Base(p0) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_span(out, p0)
        }
        .Derived(p0) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_expr(out, p0)
        }
    }
}

body_codec_get_unitdimensiondecl: fn(bytes: [U8], input: ^BodyCodecIn) -> UnitDimensionDecl Never! {
    position: body_codec_get_tag(bytes, input, 2, 0)
    if position == {
        1 -> {
            f0: body_codec_get_expr(bytes, input)
            UnitDimensionDecl.Derived{expr: f0}
        }
        else -> {
            f0: body_codec_get_span(bytes, input)
            UnitDimensionDecl.Base{span: f0}
        }
    }
}

body_codec_put_unitfamilymember: fn(out: ^BodyCodecOut, value: UnitFamilyMember) Never! {
    body_codec_put_string(out, value.name)
    body_codec_put_span(out, value.name_span)
    body_codec_put_unitratio(out, value.scale)
    body_codec_put_unitscaleprovenance(out, value.scale_provenance)
    body_codec_put_unitratio(out, value.offset)
}

body_codec_get_unitfamilymember: fn(bytes: [U8], input: ^BodyCodecIn) -> UnitFamilyMember Never! {
    f0: body_codec_get_string(bytes, input)
    f1: body_codec_get_span(bytes, input)
    f2: body_codec_get_unitratio(bytes, input)
    f3: body_codec_get_unitscaleprovenance(bytes, input)
    f4: body_codec_get_unitratio(bytes, input)
    UnitFamilyMember{name: f0, name_span: f1, scale: f2, scale_provenance: f3, offset: f4}
}

