body_codec_put_opt_list_item: fn(out: ^BodyCodecOut, value: [Item]?) Never! {
    if value == .Val(inner) {
        body_codec_put_bool(out, true)
        body_codec_put_list_item(out, inner)
        return
    }
    body_codec_put_bool(out, false)
}

body_codec_get_opt_list_item: fn(bytes: [U8], input: ^BodyCodecIn) -> [Item]? Never! {
    if body_codec_get_bool(bytes, input) -> return Val(body_codec_get_list_item(bytes, input))
    None
}

