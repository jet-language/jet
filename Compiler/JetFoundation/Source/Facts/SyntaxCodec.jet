}

body_codec_put_protocoldirection: fn(out: ^BodyCodecOut, value: ProtocolDirection) Never! {
    if value == {
        .ClientToServer -> { body_codec_put_tag(out, 0) }
        .ServerToClient -> body_codec_put_tag(out, 1)
    }
}

body_codec_get_protocoldirection: fn(bytes: [U8], input: ^BodyCodecIn) -> ProtocolDirection Never! {
    position: body_codec_get_tag(bytes, input, 2, 0)
    if position == {
        1 -> ProtocolDirection.ServerToClient
        else -> ProtocolDirection.ClientToServer
    }
}

