// The syntax codec, generated by Compiler/Toolchain/BodyCodec; do not edit.
// Regenerate it from the checkout root with `jet Compiler/Toolchain/BodyCodec/Main.jet --write`.
// It stays committed: the seed builds the compiler from the checkout, and
// `jet check` reads it before any build step runs.
// Each struct and enum a parsed program (Program) holds, besides those of a
// checked body (BodyCodec.jet), has a put, which writes its fields in
// declaration order (an enum its variant's position first), and a get, which
// reads them back in that order. The hand-written halves are in
// BodyCodecRows.jet.

body_codec_put_list_importdecl: fn(out: ^BodyCodecOut, values: [ImportDecl]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_importdecl(out, value)
}

body_codec_get_list_importdecl: fn(bytes: [U8], input: ^BodyCodecIn) -> [ImportDecl] Never! {
    count: body_codec_get_count(bytes, input, 1)
    ^values: [ImportDecl]{}
    loop _ in 0..<count -> values.push(body_codec_get_importdecl(bytes, input))
    values
}

