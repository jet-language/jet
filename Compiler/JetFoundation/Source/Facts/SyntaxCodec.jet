body_codec_get_importeditem: fn(bytes: [U8], input: ^BodyCodecIn) -> ImportedItem Never! {
    f0: body_codec_get_string(bytes, input)
    f1: body_codec_get_opt_string(bytes, input)
    ImportedItem{original: f0, alias: f1}
}

body_codec_put_inlineversion: fn(out: ^BodyCodecOut, value: InlineVersion) Never! {
