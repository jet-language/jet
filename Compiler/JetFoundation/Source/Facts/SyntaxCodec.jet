    body_codec_put_bool(out, value.result_loop)
    body_codec_put_bool(out, value.requires_exhaustion_route)
    body_codec_put_opt_span(out, value.exhaustion_span)
    body_codec_put_bool(out, value.exhaustion_route_attached)
    body_codec_put_opt_type(out, value.loop_result_type)
    body_codec_put_opt_namedspan(out, value.loop_label)
    body_codec_put_opt_list_string(out, value.guard_projection)
    body_codec_put_opt_viewprovenancemap(out, value.return_view_provenance)
    body_codec_put_opt_list_string(out, value.cell_projection_path)
    body_codec_put_bool(out, value.fallible_propagation)
    body_codec_put_opt_type(out, value.fallible_carrier)
    body_codec_put_opt_string(out, value.frame_schedule_explanation)
    body_codec_put_opt_frameschedule(out, value.frame_schedule)
    body_codec_put_opt_derivationrecord(out, value.frame_schedule_derivation)
