body_codec_put_importdecl: fn(out: ^BodyCodecOut, value: ImportDecl) Never! {
    body_codec_put_importkind(out, value.kind)
    body_codec_put_string(out, value.alias)
    body_codec_put_span(out, value.alias_span)
    body_codec_put_span(out, value.span)
    body_codec_put_list_span(out, value.item_spans)
    body_codec_put_list_span(out, value.local_spans)
    body_codec_put_bool(out, value.is_pub)
    body_codec_put_bool(out, value.is_package_pub)
    body_codec_put_opt_inlineversion(out, value.inline_version)
    body_codec_put_opt_span(out, value.comptime_span)
}

