        1 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            EveryArg.WallClock{text: f0, text_span: f1}
        }
        2 -> {
            f0: body_codec_get_expr(bytes, input)
            EveryArg.Expression{value: f0}
        }
        else -> {
            f0: body_codec_get_opt_int(bytes, input)
            f1: body_codec_get_opt_float(bytes, input)
            f2: body_codec_get_string(bytes, input)
            f3: body_codec_get_span(bytes, input)
            EveryArg.Duration{int: f0, float: f1, suffix: f2, suffix_span: f3}
        }
    }
}

body_codec_put_everyschedule: fn(out: ^BodyCodecOut, value: EverySchedule) Never! {
    if value == {
        .Duration(p0) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_int(out, p0)
        }
        .WallClockTime(p0, p1) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_int(out, p0)
            body_codec_put_int(out, p1)
        }
    }
}

body_codec_get_everyschedule: fn(bytes: [U8], input: ^BodyCodecIn) -> EverySchedule Never! {
    position: body_codec_get_tag(bytes, input, 2, 0)
    if position == {
        1 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_int(bytes, input)
            EverySchedule.WallClockTime{hour: f0, minute: f1}
        }
        else -> {
            f0: body_codec_get_int(bytes, input)
            EverySchedule.Duration{nanos: f0}
        }
    }
}

body_codec_put_maturitytag: fn(out: ^BodyCodecOut, value: MaturityTag) Never! {
    if value == {
        .Experimental -> { body_codec_put_tag(out, 0) }
        .Tested -> { body_codec_put_tag(out, 1) }
        .Hardened -> body_codec_put_tag(out, 2)
    }
}

body_codec_get_maturitytag: fn(bytes: [U8], input: ^BodyCodecIn) -> MaturityTag Never! {
    position: body_codec_get_tag(bytes, input, 3, 0)
    if position == {
        1 -> MaturityTag.Tested
        2 -> MaturityTag.Hardened
        else -> MaturityTag.Experimental
    }
}

