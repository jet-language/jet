    f3: body_codec_get_span(bytes, input)
    f4: body_codec_get_list_span(bytes, input)
    f5: body_codec_get_list_span(bytes, input)
    f6: body_codec_get_bool(bytes, input)
    f7: body_codec_get_bool(bytes, input)
    f8: body_codec_get_opt_inlineversion(bytes, input)
    f9: body_codec_get_opt_span(bytes, input)
    ImportDecl{kind: f0, alias: f1, alias_span: f2, span: f3, item_spans: f4, local_spans: f5, is_pub: f6, is_package_pub: f7, inline_version: f8, comptime_span: f9}
}

