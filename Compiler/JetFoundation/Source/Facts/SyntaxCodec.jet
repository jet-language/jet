body_codec_put_rulesite: fn(out: ^BodyCodecOut, value: RuleSite) Never! {
    if value == {
        .Package -> { body_codec_put_tag(out, 0) }
        .File -> { body_codec_put_tag(out, 1) }
        .Module -> { body_codec_put_tag(out, 2) }
        .Function -> { body_codec_put_tag(out, 3) }
        .Method -> { body_codec_put_tag(out, 4) }
        .Block -> { body_codec_put_tag(out, 5) }
        .Statement -> { body_codec_put_tag(out, 6) }
        .Expression -> { body_codec_put_tag(out, 7) }
        .Type -> { body_codec_put_tag(out, 8) }
        .Impl -> { body_codec_put_tag(out, 9) }
        .Trait -> { body_codec_put_tag(out, 10) }
        .Declaration -> { body_codec_put_tag(out, 11) }
        .Constant -> { body_codec_put_tag(out, 12) }
        .Field -> { body_codec_put_tag(out, 13) }
        .Variant -> { body_codec_put_tag(out, 14) }
        .Parameter -> { body_codec_put_tag(out, 15) }
        .Test -> { body_codec_put_tag(out, 16) }
        .Operation -> { body_codec_put_tag(out, 17) }
        .Text -> { body_codec_put_tag(out, 18) }
        .Arm -> { body_codec_put_tag(out, 19) }
        .TypeUse -> body_codec_put_tag(out, 20)
    }
}

body_codec_get_rulesite: fn(bytes: [U8], input: ^BodyCodecIn) -> RuleSite Never! {
    position: body_codec_get_tag(bytes, input, 21, 0)
    if position == {
        1 -> RuleSite.File
        2 -> RuleSite.Module
        3 -> RuleSite.Function
        4 -> RuleSite.Method
        5 -> RuleSite.Block
        6 -> RuleSite.Statement
        7 -> RuleSite.Expression
        8 -> RuleSite.Type
        9 -> RuleSite.Impl
        10 -> RuleSite.Trait
        11 -> RuleSite.Declaration
        12 -> RuleSite.Constant
        13 -> RuleSite.Field
        14 -> RuleSite.Variant
        15 -> RuleSite.Parameter
        16 -> RuleSite.Test
        17 -> RuleSite.Operation
        18 -> RuleSite.Text
        19 -> RuleSite.Arm
        20 -> RuleSite.TypeUse
        else -> RuleSite.Package
    }
}

