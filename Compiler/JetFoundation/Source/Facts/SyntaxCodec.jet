body_codec_get_bindnamerename: fn(bytes: [U8], input: ^BodyCodecIn) -> BindNameRename Never! {
    f0: body_codec_get_string(bytes, input)
    f1: body_codec_get_span(bytes, input)
    BindNameRename{name: f0, span: f1}
}

