    ^values: [TypedNamedField]{}
    loop _ in 0..<count -> values.push(body_codec_get_typednamedfield(bytes, input))
    values
}

body_codec_put_protocolmessage: fn(out: ^BodyCodecOut, value: ProtocolMessage) Never! {
    body_codec_put_protocoldirection(out, value.direction)
