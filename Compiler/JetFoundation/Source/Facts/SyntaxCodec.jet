    body_codec_put_int(out, value.numerator)
    body_codec_put_int(out, value.denominator)
}

body_codec_get_unitratio: fn(bytes: [U8], input: ^BodyCodecIn) -> UnitRatio Never! {
    f0: body_codec_get_int(bytes, input)
    f1: body_codec_get_int(bytes, input)
    UnitRatio{numerator: f0, denominator: f1}
}

body_codec_put_unitscaleprovenance: fn(out: ^BodyCodecOut, value: UnitScaleProvenance) Never! {
    if value == {
        .Rational -> { body_codec_put_tag(out, 0) }
        .SymbolicPi(p0, p1) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_unitratio(out, p0)
            body_codec_put_unitratio(out, p1)
        }
        .Conventional(p0, p1) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_string(out, p0)
            body_codec_put_string(out, p1)
        }
        .Measured(p0, p1, p2) -> {
            body_codec_put_tag(out, 3)
            body_codec_put_string(out, p0)
            body_codec_put_string(out, p1)
            body_codec_put_string(out, p2)
        }
    }
}

body_codec_get_unitscaleprovenance: fn(bytes: [U8], input: ^BodyCodecIn) -> UnitScaleProvenance Never! {
    position: body_codec_get_tag(bytes, input, 4, 0)
    if position == {
        1 -> {
            f0: body_codec_get_unitratio(bytes, input)
            f1: body_codec_get_unitratio(bytes, input)
            UnitScaleProvenance.SymbolicPi{numerator: f0, denominator: f1}
        }
        2 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_string(bytes, input)
            UnitScaleProvenance.Conventional{value: f0, source: f1}
        }
        3 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_string(bytes, input)
            f2: body_codec_get_string(bytes, input)
            UnitScaleProvenance.Measured{central_value: f0, standard_uncertainty: f1, source: f2}
        }
        else -> UnitScaleProvenance.Rational
    }
}

