    f1: body_codec_get_ctvalue(bytes, input)
    CtEnumArg{label: f0, value: f1}
}

body_codec_put_ctreport: fn(out: ^BodyCodecOut, value: CtReport) Never! {
    if value == {
        .Clean(p0) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_type(out, p0)
        }
        .Told(p0) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_ctvalue(out, p0)
        }
    }
}

body_codec_get_ctreport: fn(bytes: [U8], input: ^BodyCodecIn) -> CtReport Never! {
    position: body_codec_get_tag(bytes, input, 2, 0)
    if position == {
        1 -> {
            f0: body_codec_get_ctvalue(bytes, input)
            CtReport.Told{value: f0}
        }
        else -> {
            f0: body_codec_get_type(bytes, input)
            CtReport.Clean{ty: f0}
        }
    }
}

