    f3: body_codec_get_span(bytes, input)
    f4: body_codec_get_list_protocolmessage(bytes, input)
    f5: body_codec_get_span(bytes, input)
    ProtocolDecl{is_pub: f0, is_package_pub: f1, name: f2, name_span: f3, messages: f4, span: f5}
}

