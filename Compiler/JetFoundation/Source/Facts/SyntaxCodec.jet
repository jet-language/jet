}

body_codec_get_metaattr: fn(bytes: [U8], input: ^BodyCodecIn) -> MetaAttr Never! {
    f0: body_codec_get_list_metafield(bytes, input)
    f1: body_codec_get_span(bytes, input)
    MetaAttr{fields: f0, span: f1}
}

body_codec_put_opt_expr: fn(out: ^BodyCodecOut, value: Expr?) Never! {
    if value == .Val(inner) {
        body_codec_put_bool(out, true)
        body_codec_put_expr(out, inner)
        return
    }
    body_codec_put_bool(out, false)
}

body_codec_get_opt_expr: fn(bytes: [U8], input: ^BodyCodecIn) -> Expr? Never! {
    if body_codec_get_bool(bytes, input) -> return Val(body_codec_get_expr(bytes, input))
    None
}

body_codec_put_metafield: fn(out: ^BodyCodecOut, value: MetaField) Never! {
    if value == {
        .Category(p0, p1) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_expr(out, p0)
            body_codec_put_span(out, p1)
        }
        .Tunable(p0) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_span(out, p0)
        }
        .Maturity(p0, p1) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_expr(out, p0)
            body_codec_put_span(out, p1)
        }
        .Unknown(p0, p1, p2) -> {
            body_codec_put_tag(out, 3)
            body_codec_put_string(out, p0)
            body_codec_put_opt_expr(out, p1)
            body_codec_put_span(out, p2)
        }
    }
}

body_codec_get_metafield: fn(bytes: [U8], input: ^BodyCodecIn) -> MetaField Never! {
    position: body_codec_get_tag(bytes, input, 4, 1)
    if position == {
        0 -> {
            f0: body_codec_get_expr(bytes, input)
            f1: body_codec_get_span(bytes, input)
            MetaField.Category{value: f0, span: f1}
        }
        2 -> {
            f0: body_codec_get_expr(bytes, input)
            f1: body_codec_get_span(bytes, input)
            MetaField.Maturity{value: f0, span: f1}
        }
        3 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_opt_expr(bytes, input)
            f2: body_codec_get_span(bytes, input)
            MetaField.Unknown{name: f0, value: f1, span: f2}
        }
        else -> {
            f0: body_codec_get_span(bytes, input)
            MetaField.Tunable{span: f0}
        }
    }
}

