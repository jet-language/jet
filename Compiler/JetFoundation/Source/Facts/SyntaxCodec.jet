body_codec_put_program: fn(out: ^BodyCodecOut, value: Program) Never! {
    body_codec_put_list_importdecl(out, value.imports)
    body_codec_put_list_item(out, value.items)
    body_codec_put_list_stmt(out, value.script_body)
    body_codec_put_list_span(out, value.block_spans)
    body_codec_put_list_fencedstatement(out, value.fenced_statements)
    body_codec_put_opt_webbucket(out, value.web_target_ceiling)
    body_codec_put_bool(out, value.no_prelude)
    body_codec_put_opt_string(out, value.default_target)
    body_codec_put_opt_string(out, value.html_path)
    body_codec_put_list_policydeclaration(out, value.policy_declarations)
    body_codec_put_list_userpolicydecl(out, value.user_policy_declarations)
    body_codec_put_list_appliedruleapplication(out, value.applied_rules)
    body_codec_put_list_appliedruleapplication(out, value.rule_facts)
    body_codec_put_list_elsearmspan(out, value.else_arms)
    body_codec_put_list_string(out, value.used_import_names)
    body_codec_put_list_debugtracesite(out, value.debug_sites)
    body_codec_put_list_approuteroot(out, value.app_route_roots)
    body_codec_put_list_string(out, value.app_missing_assets)
    body_codec_put_opt_modulecap(out, value.file_cap)
    body_codec_put_list_string(out, value.entry_locals)
    body_codec_put_asttables(out, value.tables)
    body_codec_put_bool(out, value.has_scope_member)
}

body_codec_get_program: fn(bytes: [U8], input: ^BodyCodecIn) -> Program Never! {
    f0: body_codec_get_list_importdecl(bytes, input)
    f1: body_codec_get_list_item(bytes, input)
    f2: body_codec_get_list_stmt(bytes, input)
    f3: body_codec_get_list_span(bytes, input)
    f4: body_codec_get_list_fencedstatement(bytes, input)
    f5: body_codec_get_opt_webbucket(bytes, input)
    f6: body_codec_get_bool(bytes, input)
    f7: body_codec_get_opt_string(bytes, input)
    f8: body_codec_get_opt_string(bytes, input)
    f9: body_codec_get_list_policydeclaration(bytes, input)
    f10: body_codec_get_list_userpolicydecl(bytes, input)
    f11: body_codec_get_list_appliedruleapplication(bytes, input)
    f12: body_codec_get_list_appliedruleapplication(bytes, input)
    f13: body_codec_get_list_elsearmspan(bytes, input)
    f14: body_codec_get_list_string(bytes, input)
    f15: body_codec_get_list_debugtracesite(bytes, input)
    f16: body_codec_get_list_approuteroot(bytes, input)
    f17: body_codec_get_list_string(bytes, input)
    f18: body_codec_get_opt_modulecap(bytes, input)
    f19: body_codec_get_list_string(bytes, input)
    f20: body_codec_get_asttables(bytes, input)
    f21: body_codec_get_bool(bytes, input)
    Program{imports: f0, items: f1, script_body: f2, block_spans: f3, fenced_statements: f4, web_target_ceiling: f5, no_prelude: f6, default_target: f7, html_path: f8, policy_declarations: f9, user_policy_declarations: f10, applied_rules: f11, rule_facts: f12, else_arms: f13, used_import_names: f14, debug_sites: f15, app_route_roots: f16, app_missing_assets: f17, file_cap: f18, entry_locals: f19, tables: f20, has_scope_member: f21}
}

