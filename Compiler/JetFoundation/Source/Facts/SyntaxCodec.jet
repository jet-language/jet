    f1: body_codec_get_span(bytes, input)
    f2: body_codec_get_opt_bindnamerename(bytes, input)
    f3: body_codec_get_bool(bytes, input)
    BindName{name: f0, span: f1, rename: f2, mutable: f3}
}

body_codec_put_bindnamerename: fn(out: ^BodyCodecOut, value: BindNameRename) Never! {
