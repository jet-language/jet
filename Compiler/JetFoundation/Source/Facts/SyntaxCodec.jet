body_codec_put_failurecontract: fn(out: ^BodyCodecOut, value: FailureContract) Never! {
    if value == {
        .Default(p0, p1) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_type(out, p0)
            body_codec_put_type(out, p1)
        }
        .Optional(p0) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_type(out, p0)
        }
        .DeclaredNever -> { body_codec_put_tag(out, 2) }
        .Explicit(p0, p1) -> {
            body_codec_put_tag(out, 3)
            body_codec_put_type(out, p0)
            body_codec_put_type(out, p1)
        }
        .Converted(p0, p1, p2) -> {
            body_codec_put_tag(out, 4)
            body_codec_put_type(out, p0)
            body_codec_put_type(out, p1)
            body_codec_put_type(out, p2)
        }
        .ProvenUnreachable(p0) -> {
            body_codec_put_tag(out, 5)
            body_codec_put_type(out, p0)
        }
        .InferredNever(p0) -> {
            body_codec_put_tag(out, 6)
            body_codec_put_type(out, p0)
        }
        .Inferred(p0, p1) -> {
            body_codec_put_tag(out, 7)
            body_codec_put_type(out, p0)
            body_codec_put_type(out, p1)
        }
    }
}

body_codec_get_failurecontract: fn(bytes: [U8], input: ^BodyCodecIn) -> FailureContract Never! {
    position: body_codec_get_tag(bytes, input, 8, 2)
    if position == {
        0 -> {
            f0: body_codec_get_type(bytes, input)
            f1: body_codec_get_type(bytes, input)
            FailureContract.Default{success: f0, error: f1}
        }
        1 -> {
            f0: body_codec_get_type(bytes, input)
            FailureContract.Optional{success: f0}
        }
        3 -> {
            f0: body_codec_get_type(bytes, input)
            f1: body_codec_get_type(bytes, input)
            FailureContract.Explicit{success: f0, error: f1}
        }
        4 -> {
            f0: body_codec_get_type(bytes, input)
            f1: body_codec_get_type(bytes, input)
            f2: body_codec_get_type(bytes, input)
            FailureContract.Converted{success: f0, source: f1, target: f2}
        }
        5 -> {
            f0: body_codec_get_type(bytes, input)
            FailureContract.ProvenUnreachable{success: f0}
        }
        6 -> {
            f0: body_codec_get_type(bytes, input)
            FailureContract.InferredNever{success: f0}
        }
        7 -> {
            f0: body_codec_get_type(bytes, input)
            f1: body_codec_get_type(bytes, input)
            FailureContract.Inferred{success: f0, error: f1}
        }
        else -> FailureContract.DeclaredNever
    }
}

