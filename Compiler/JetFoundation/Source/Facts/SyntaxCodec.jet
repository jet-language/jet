body_codec_put_importkind: fn(out: ^BodyCodecOut, value: ImportKind) Never! {
    if value == {
        .File(p0, p1) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
        }
        .Module(p0, p1) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
        }
        .Unqualified(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_list_importeditem(out, p2)
            body_codec_put_span(out, p3)
            body_codec_put_span(out, p4)
        }
    }
}

body_codec_get_importkind: fn(bytes: [U8], input: ^BodyCodecIn) -> ImportKind Never! {
    position: body_codec_get_tag(bytes, input, 3, 0)
    if position == {
        1 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            ImportKind.Module{name: f0, span: f1}
        }
        2 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_list_importeditem(bytes, input)
            f3: body_codec_get_span(bytes, input)
            f4: body_codec_get_span(bytes, input)
            ImportKind.Unqualified{module_alias: f0, module_alias_span: f1, items: f2, items_span: f3, span: f4}
        }
        else -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            ImportKind.File{path: f0, span: f1}
        }
    }
}

body_codec_put_importeditem: fn(out: ^BodyCodecOut, value: ImportedItem) Never! {
