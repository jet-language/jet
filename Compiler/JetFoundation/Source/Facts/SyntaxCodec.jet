body_codec_put_expr: fn(out: ^BodyCodecOut, value: Expr) Never! {
    if value == {
        .Str(p0, p1, p2) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_list_strpart(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_int(out, p2)
        }
        .StrMatchLit(p0, p1, p2) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_list_strmatchpart(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_int(out, p2)
        }
        .BinMatchLit(p0, p1, p2) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_list_binmatchpart(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_int(out, p2)
        }
        .Int(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 3)
            body_codec_put_int(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_opt_integerwidth(out, p2)
            body_codec_put_opt_string(out, p3)
            body_codec_put_int(out, p4)
        }
        .Float(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 4)
            body_codec_put_float(out, p0)
