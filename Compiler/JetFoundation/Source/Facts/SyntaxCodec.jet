    f6: body_codec_get_opt_webbucket(bytes, input)
    f7: body_codec_get_opt_moduleinstanceidentity(bytes, input)
    f8: body_codec_get_span(bytes, input)
    f9: body_codec_get_opt_modulecap(bytes, input)
    f10: body_codec_get_list_marker(bytes, input)
    CodeModule{name: f0, name_span: f1, is_pub: f2, is_package_pub: f3, body: f4, imports: f5, web_target: f6, instance_identity: f7, span: f8, cap: f9, markers: f10}
}

