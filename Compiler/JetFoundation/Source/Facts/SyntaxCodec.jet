body_codec_put_func: fn(out: ^BodyCodecOut, value: Func) Never! {
    body_codec_put_span(out, value.span)
    body_codec_put_bool(out, value.is_pub)
    body_codec_put_bool(out, value.is_package_pub)
    body_codec_put_bool(out, value.is_comptime)
    body_codec_put_opt_namedspan(out, value.external_type)
    body_codec_put_string(out, value.name)
    body_codec_put_span(out, value.name_span)
    body_codec_put_opt_metaattr(out, value.meta)
    body_codec_put_list_typeparam(out, value.type_params)
    body_codec_put_opt_pattern(out, value.head_pattern)
    body_codec_put_list_param(out, value.params)
    body_codec_put_opt_type(out, value.return_type)
    body_codec_put_opt_span(out, value.return_type_span)
    body_codec_put_opt_viewprovenancemap(out, value.return_view_provenance)
    body_codec_put_opt_viewprovenancemap(out, value.declared_return_view_provenance)
    body_codec_put_bool(out, value.gc_return)
    body_codec_put_bool(out, value.diverges)
    body_codec_put_bool(out, value.gc_scope)
    body_codec_put_bool(out, value.is_unsafe)
    body_codec_put_opt_string(out, value.unsafe_reason)
    body_codec_put_opt_span(out, value.unsafe_span)
    body_codec_put_bool(out, value.is_pure)
    body_codec_put_opt_string(out, value.scrub_tag)
    body_codec_put_opt_list_effectrowentry(out, value.declared_effects)
    body_codec_put_opt_namedspan(out, value.effect_via)
    body_codec_put_bool(out, value.is_reactive)
    body_codec_put_list_string(out, value.reactive_upgrades)
    body_codec_put_bool(out, value.is_replayable)
    body_codec_put_opt_span(out, value.replayable_span)
    body_codec_put_bool(out, value.is_job)
    body_codec_put_opt_span(out, value.job_span)
    body_codec_put_opt_jobmetadata(out, value.job_metadata)
    body_codec_put_opt_everymarker(out, value.every)
    body_codec_put_bool(out, value.is_must_use)
    body_codec_put_opt_span(out, value.must_use_span)
    body_codec_put_opt_maturitytag(out, value.maturity)
    body_codec_put_opt_span(out, value.maturity_span)
    body_codec_put_opt_kernelmarker(out, value.kernel)
    body_codec_put_bool(out, value.is_inline)
    body_codec_put_bool(out, value.is_inline_always)
    body_codec_put_opt_span(out, value.inline_span)
    body_codec_put_opt_webpartitionmarker(out, value.web_marker)
    body_codec_put_list_contractclause(out, value.pre)
    body_codec_put_list_contractclause(out, value.post)
    body_codec_put_opt_inlineforeign(out, value.inline_foreign)
    body_codec_put_opt_namedspan(out, value.undo)
    body_codec_put_list_marker(out, value.markers)
    body_codec_put_bool(out, value.compiler_generated)
    body_codec_put_list_stmt(out, value.body)
    body_codec_put_list_modulecap(out, value.module_caps)
    body_codec_put_string(out, value.definition_module)
    body_codec_put_list_string(out, value.site_names)
    body_codec_put_int(out, value.max_depth)
    body_codec_put_list_statetypeuse(out, value.state_types)
    body_codec_put_bool(out, value.marker_check)
}

