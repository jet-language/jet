    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_mappatentry(out, value)
}

body_codec_get_list_mappatentry: fn(bytes: [U8], input: ^BodyCodecIn) -> [MapPatEntry] Never! {
    count: body_codec_get_count(bytes, input, 1)
    ^values: [MapPatEntry]{}
    loop _ in 0..<count -> values.push(body_codec_get_mappatentry(bytes, input))
    values
}

body_codec_put_pattern: fn(out: ^BodyCodecOut, value: Pattern) Never! {
    if value == {
        .Variant(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_string(out, p0)
            body_codec_put_list_patslot(out, p1)
            body_codec_put_bool(out, p2)
            body_codec_put_span(out, p3)
        }
        .Present(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_opt_pattern(out, p2)
            body_codec_put_span(out, p3)
        }
        .Absent(p0) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_span(out, p0)
        }
        .Ok(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 3)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_opt_pattern(out, p2)
            body_codec_put_span(out, p3)
        }
        .Err(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 4)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_opt_pattern(out, p2)
            body_codec_put_span(out, p3)
        }
        .Range(p0, p1, p2) -> {
            body_codec_put_tag(out, 5)
            body_codec_put_int(out, p0)
            body_codec_put_int(out, p1)
            body_codec_put_span(out, p2)
        }
        .Or(p0, p1) -> {
            body_codec_put_tag(out, 6)
            body_codec_put_list_pattern(out, p0)
            body_codec_put_span(out, p1)
        }
        .Struct(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 7)
            body_codec_put_list_structpatfield(out, p0)
            body_codec_put_opt_span(out, p1)
            body_codec_put_span(out, p2)
            body_codec_put_opt_patterntypehead(out, p3)
        }
        .List(p0, p1, p2) -> {
            body_codec_put_tag(out, 8)
            body_codec_put_list_patslot(out, p0)
            body_codec_put_opt_listpatrest(out, p1)
            body_codec_put_span(out, p2)
        }
        .Map(p0, p1, p2) -> {
            body_codec_put_tag(out, 9)
            body_codec_put_list_mappatentry(out, p0)
            body_codec_put_opt_span(out, p1)
            body_codec_put_span(out, p2)
        }
        .StrMatch(p0, p1) -> {
            body_codec_put_tag(out, 10)
            body_codec_put_list_strmatchpart(out, p0)
            body_codec_put_span(out, p1)
        }
        .BinMatch(p0, p1) -> {
            body_codec_put_tag(out, 11)
            body_codec_put_list_binmatchpart(out, p0)
            body_codec_put_span(out, p1)
        }
    }
}

body_codec_get_pattern: fn(bytes: [U8], input: ^BodyCodecIn) -> Pattern Never! {
    position: body_codec_get_tag(bytes, input, 12, 0)
    if position == {
        1 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_opt_pattern(bytes, input)
            f3: body_codec_get_span(bytes, input)
            Pattern.Present{binding: f0, binding_span: f1, inner: f2, span: f3}
        }
        2 -> {
            f0: body_codec_get_span(bytes, input)
            Pattern.Absent{span: f0}
        }
        3 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_opt_pattern(bytes, input)
            f3: body_codec_get_span(bytes, input)
            Pattern.Ok{binding: f0, binding_span: f1, inner: f2, span: f3}
        }
        4 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_opt_pattern(bytes, input)
            f3: body_codec_get_span(bytes, input)
            Pattern.Err{binding: f0, binding_span: f1, inner: f2, span: f3}
        }
        5 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_int(bytes, input)
            f2: body_codec_get_span(bytes, input)
            Pattern.Range{lo: f0, hi: f1, span: f2}
        }
        6 -> {
            f0: body_codec_get_list_pattern(bytes, input)
            f1: body_codec_get_span(bytes, input)
            Pattern.Or{alternatives: f0, span: f1}
        }
        7 -> {
            f0: body_codec_get_list_structpatfield(bytes, input)
            f1: body_codec_get_opt_span(bytes, input)
            f2: body_codec_get_span(bytes, input)
            f3: body_codec_get_opt_patterntypehead(bytes, input)
            Pattern.Struct{fields: f0, rest: f1, span: f2, type_name: f3}
        }
        8 -> {
            f0: body_codec_get_list_patslot(bytes, input)
            f1: body_codec_get_opt_listpatrest(bytes, input)
            f2: body_codec_get_span(bytes, input)
            Pattern.List{items: f0, rest: f1, span: f2}
        }
        9 -> {
            f0: body_codec_get_list_mappatentry(bytes, input)
            f1: body_codec_get_opt_span(bytes, input)
            f2: body_codec_get_span(bytes, input)
            Pattern.Map{entries: f0, rest: f1, span: f2}
        }
        10 -> {
            f0: body_codec_get_list_strmatchpart(bytes, input)
            f1: body_codec_get_span(bytes, input)
            Pattern.StrMatch{parts: f0, span: f1}
        }
        11 -> {
            f0: body_codec_get_list_binmatchpart(bytes, input)
            f1: body_codec_get_span(bytes, input)
            Pattern.BinMatch{parts: f0, span: f1}
        }
        else -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_list_patslot(bytes, input)
            f2: body_codec_get_bool(bytes, input)
            f3: body_codec_get_span(bytes, input)
            Pattern.Variant{variant: f0, bindings: f1, leading_dot: f2, span: f3}
        }
    }
}

body_codec_put_patslot: fn(out: ^BodyCodecOut, value: PatSlot) Never! {
    if value == {
        .Wildcard -> { body_codec_put_tag(out, 0) }
        .Bind(p0, p1) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
        }
        .Range(p0, p1) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_int(out, p0)
            body_codec_put_int(out, p1)
        }
        .Nested(p0) -> {
            body_codec_put_tag(out, 3)
            body_codec_put_pattern(out, p0)
        }
        .Named(p0, p1, p2) -> {
            body_codec_put_tag(out, 4)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_patslot(out, p2)
        }
        .Rest(p0) -> {
            body_codec_put_tag(out, 5)
            body_codec_put_span(out, p0)
        }
        .Value(p0) -> {
            body_codec_put_tag(out, 6)
            body_codec_put_expr(out, p0)
        }
    }
}

body_codec_get_patslot: fn(bytes: [U8], input: ^BodyCodecIn) -> PatSlot Never! {
    position: body_codec_get_tag(bytes, input, 7, 0)
    if position == {
        1 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            PatSlot.Bind{name: f0, span: f1}
        }
        2 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_int(bytes, input)
            PatSlot.Range{lo: f0, hi: f1}
        }
        3 -> {
            f0: body_codec_get_pattern(bytes, input)
            PatSlot.Nested{pattern: f0}
        }
        4 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_patslot(bytes, input)
            PatSlot.Named{field: f0, field_span: f1, slot: f2}
        }
        5 -> {
            f0: body_codec_get_span(bytes, input)
            PatSlot.Rest{span: f0}
        }
        6 -> {
            f0: body_codec_get_expr(bytes, input)
            PatSlot.Value{value: f0}
        }
        else -> PatSlot.Wildcard
    }
}

body_codec_put_structpatfield: fn(out: ^BodyCodecOut, value: StructPatField) Never! {
    if value == {
        .Bind(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_string(out, p2)
            body_codec_put_span(out, p3)
        }
        .Value(p0, p1, p2) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_expr(out, p2)
        }
        .Nested(p0, p1, p2) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_pattern(out, p2)
        }
    }
}

body_codec_get_structpatfield: fn(bytes: [U8], input: ^BodyCodecIn) -> StructPatField Never! {
    position: body_codec_get_tag(bytes, input, 3, 0)
    if position == {
        1 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_expr(bytes, input)
            StructPatField.Value{field: f0, field_span: f1, value: f2}
        }
        2 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_pattern(bytes, input)
            StructPatField.Nested{field: f0, field_span: f1, pattern: f2}
        }
        else -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_string(bytes, input)
            f3: body_codec_get_span(bytes, input)
            StructPatField.Bind{field: f0, field_span: f1, local: f2, local_span: f3}
        }
    }
}

body_codec_put_patterntypehead: fn(out: ^BodyCodecOut, value: PatternTypeHead) Never! {
    body_codec_put_string(out, value.name)
    body_codec_put_span(out, value.span)
}

body_codec_get_patterntypehead: fn(bytes: [U8], input: ^BodyCodecIn) -> PatternTypeHead Never! {
    f0: body_codec_get_string(bytes, input)
    f1: body_codec_get_span(bytes, input)
    PatternTypeHead{name: f0, span: f1}
}

body_codec_put_opt_bindname: fn(out: ^BodyCodecOut, value: BindName?) Never! {
    if value == .Val(inner) {
        body_codec_put_bool(out, true)
        body_codec_put_bindname(out, inner)
        return
    }
    body_codec_put_bool(out, false)
}

body_codec_get_opt_bindname: fn(bytes: [U8], input: ^BodyCodecIn) -> BindName? Never! {
    if body_codec_get_bool(bytes, input) -> return Val(body_codec_get_bindname(bytes, input))
    None
}

body_codec_put_listpatrest: fn(out: ^BodyCodecOut, value: ListPatRest) Never! {
    body_codec_put_opt_bindname(out, value.name)
    body_codec_put_span(out, value.span)
}

body_codec_get_listpatrest: fn(bytes: [U8], input: ^BodyCodecIn) -> ListPatRest Never! {
    f0: body_codec_get_opt_bindname(bytes, input)
    f1: body_codec_get_span(bytes, input)
    ListPatRest{name: f0, span: f1}
}

body_codec_put_mappatentry: fn(out: ^BodyCodecOut, value: MapPatEntry) Never! {
    body_codec_put_expr(out, value.key)
    body_codec_put_bool(out, value.optional)
    body_codec_put_patslot(out, value.slot)
    body_codec_put_span(out, value.span)
}

body_codec_get_mappatentry: fn(bytes: [U8], input: ^BodyCodecIn) -> MapPatEntry Never! {
    f0: body_codec_get_expr(bytes, input)
    f1: body_codec_get_bool(bytes, input)
    f2: body_codec_get_patslot(bytes, input)
    f3: body_codec_get_span(bytes, input)
    MapPatEntry{key: f0, optional: f1, slot: f2, span: f3}
}

body_codec_put_orfallback: fn(out: ^BodyCodecOut, value: OrFallback) Never! {
    if value == {
        .Value(p0) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_expr(out, p0)
        }
        .Block(p0, p1, p2) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_list_stmt(out, p0)
            body_codec_put_opt_expr(out, p1)
            body_codec_put_span(out, p2)
        }
        .Return(p0, p1) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_opt_expr(out, p0)
            body_codec_put_span(out, p1)
        }
        .Panic(p0, p1) -> {
            body_codec_put_tag(out, 3)
            body_codec_put_span(out, p0)
            body_codec_put_list_callarg(out, p1)
        }
        .Break(p0) -> {
            body_codec_put_tag(out, 4)
            body_codec_put_span(out, p0)
        }
        .Continue(p0) -> {
            body_codec_put_tag(out, 5)
            body_codec_put_span(out, p0)
        }
        .BreakLabel(p0, p1) -> {
            body_codec_put_tag(out, 6)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
        }
        .ContinueLabel(p0, p1) -> {
            body_codec_put_tag(out, 7)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
        }
    }
}

body_codec_get_orfallback: fn(bytes: [U8], input: ^BodyCodecIn) -> OrFallback Never! {
    position: body_codec_get_tag(bytes, input, 8, 0)
    if position == {
        1 -> {
            f0: body_codec_get_list_stmt(bytes, input)
            f1: body_codec_get_opt_expr(bytes, input)
            f2: body_codec_get_span(bytes, input)
            OrFallback.Block{body: f0, value: f1, span: f2}
        }
        2 -> {
            f0: body_codec_get_opt_expr(bytes, input)
            f1: body_codec_get_span(bytes, input)
            OrFallback.Return{value: f0, span: f1}
        }
        3 -> {
            f0: body_codec_get_span(bytes, input)
            f1: body_codec_get_list_callarg(bytes, input)
            OrFallback.Panic{name_span: f0, args: f1}
        }
        4 -> {
            f0: body_codec_get_span(bytes, input)
            OrFallback.Break{span: f0}
        }
        5 -> {
            f0: body_codec_get_span(bytes, input)
            OrFallback.Continue{span: f0}
        }
        6 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            OrFallback.BreakLabel{name: f0, span: f1}
        }
        7 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            OrFallback.ContinueLabel{name: f0, span: f1}
        }
        else -> {
            f0: body_codec_get_expr(bytes, input)
            OrFallback.Value{value: f0}
        }
    }
}

body_codec_put_list_gcpromotionedge: fn(out: ^BodyCodecOut, values: [GCPromotionEdge]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_gcpromotionedge(out, value)
}

body_codec_get_list_gcpromotionedge: fn(bytes: [U8], input: ^BodyCodecIn) -> [GCPromotionEdge] Never! {
    count: body_codec_get_count(bytes, input, 1)
    ^values: [GCPromotionEdge]{}
    loop _ in 0..<count -> values.push(body_codec_get_gcpromotionedge(bytes, input))
    values
}

body_codec_put_gcpromotion: fn(out: ^BodyCodecOut, value: GCPromotion) Never! {
    body_codec_put_span(out, value.span)
    body_codec_put_string(out, value.scope)
    body_codec_put_string(out, value.policy_provenance)
    body_codec_put_string(out, value.reason)
    body_codec_put_list_gcpromotionedge(out, value.edges)
    body_codec_put_opt_int(out, value.collection_len)
}

body_codec_get_gcpromotion: fn(bytes: [U8], input: ^BodyCodecIn) -> GCPromotion Never! {
    f0: body_codec_get_span(bytes, input)
    f1: body_codec_get_string(bytes, input)
    f2: body_codec_get_string(bytes, input)
    f3: body_codec_get_string(bytes, input)
    f4: body_codec_get_list_gcpromotionedge(bytes, input)
    f5: body_codec_get_opt_int(bytes, input)
    GCPromotion{span: f0, scope: f1, policy_provenance: f2, reason: f3, edges: f4, collection_len: f5}
}

body_codec_put_gcpromotionedge: fn(out: ^BodyCodecOut, value: GCPromotionEdge) Never! {
    body_codec_put_string(out, value.binding)
    body_codec_put_string(out, value.slot)
    body_codec_put_int(out, value.group)
}

body_codec_get_gcpromotionedge: fn(bytes: [U8], input: ^BodyCodecIn) -> GCPromotionEdge Never! {
    f0: body_codec_get_string(bytes, input)
    f1: body_codec_get_string(bytes, input)
    f2: body_codec_get_int(bytes, input)
    GCPromotionEdge{binding: f0, slot: f1, group: f2}
}

body_codec_put_lvalue: fn(out: ^BodyCodecOut, value: LValue) Never! {
    if value == {
        .Local(p0, p1) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
        }
        .Index(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_expr(out, p0)
            body_codec_put_expr(out, p1)
            body_codec_put_span(out, p2)
            body_codec_put_indexkind(out, p3)
        }
        .Field(p0, p1, p2) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_expr(out, p0)
            body_codec_put_string(out, p1)
            body_codec_put_span(out, p2)
        }
    }
}

body_codec_get_lvalue: fn(bytes: [U8], input: ^BodyCodecIn) -> LValue Never! {
    position: body_codec_get_tag(bytes, input, 3, 0)
    if position == {
        1 -> {
            f0: body_codec_get_expr(bytes, input)
            f1: body_codec_get_expr(bytes, input)
            f2: body_codec_get_span(bytes, input)
            f3: body_codec_get_indexkind(bytes, input)
            LValue.Index{base: f0, index: f1, span: f2, kind: f3}
        }
        2 -> {
            f0: body_codec_get_expr(bytes, input)
            f1: body_codec_get_string(bytes, input)
            f2: body_codec_get_span(bytes, input)
            LValue.Field{base: f0, field: f1, span: f2}
        }
        else -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            LValue.Local{name: f0, name_span: f1}
        }
    }
}

body_codec_put_forkind: fn(out: ^BodyCodecOut, value: ForKind) Never! {
    if value == {
        .Range(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_expr(out, p0)
            body_codec_put_expr(out, p1)
            body_codec_put_opt_expr(out, p2)
            body_codec_put_bool(out, p3)
        }
        .In(p0, p1) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_expr(out, p0)
            body_codec_put_opt_expr(out, p1)
        }
    }
}

body_codec_get_forkind: fn(bytes: [U8], input: ^BodyCodecIn) -> ForKind Never! {
    position: body_codec_get_tag(bytes, input, 2, 0)
    if position == {
        1 -> {
            f0: body_codec_get_expr(bytes, input)
            f1: body_codec_get_opt_expr(bytes, input)
            ForKind.In{collection: f0, step: f1}
        }
        else -> {
            f0: body_codec_get_expr(bytes, input)
            f1: body_codec_get_expr(bytes, input)
            f2: body_codec_get_opt_expr(bytes, input)
            f3: body_codec_get_bool(bytes, input)
            ForKind.Range{start: f0, end: f1, step: f2, exclusive: f3}
        }
    }
}

body_codec_put_switcharm: fn(out: ^BodyCodecOut, value: SwitchArm) Never! {
    body_codec_put_expr(out, value.cond)
    body_codec_put_list_stmt(out, value.body)
    body_codec_put_span(out, value.span)
    body_codec_put_opt_span(out, value.through)
}

body_codec_get_switcharm: fn(bytes: [U8], input: ^BodyCodecIn) -> SwitchArm Never! {
    f0: body_codec_get_expr(bytes, input)
    f1: body_codec_get_list_stmt(bytes, input)
    f2: body_codec_get_span(bytes, input)
    f3: body_codec_get_opt_span(bytes, input)
    SwitchArm{cond: f0, body: f1, span: f2, through: f3}
}

body_codec_put_policydeclaration: fn(out: ^BodyCodecOut, value: PolicyDeclaration) Never! {
    body_codec_put_policykey(out, value.key)
    body_codec_put_policyvalue(out, value.value)
    body_codec_put_policyscope(out, value.scope)
    body_codec_put_span(out, value.span)
    body_codec_put_opt_span(out, value.target)
    body_codec_put_string(out, value.source)
}

body_codec_get_policydeclaration: fn(bytes: [U8], input: ^BodyCodecIn) -> PolicyDeclaration Never! {
    f0: body_codec_get_policykey(bytes, input)
    f1: body_codec_get_policyvalue(bytes, input)
    f2: body_codec_get_policyscope(bytes, input)
    f3: body_codec_get_span(bytes, input)
    f4: body_codec_get_opt_span(bytes, input)
    f5: body_codec_get_string(bytes, input)
    PolicyDeclaration{key: f0, value: f1, scope: f2, span: f3, target: f4, source: f5}
}

body_codec_put_policykey: fn(out: ^BodyCodecOut, value: PolicyKey) Never! {
    if value == {
        .Unsafe -> { body_codec_put_tag(out, 0) }
        .Impure -> { body_codec_put_tag(out, 1) }
        .Nondeterministic -> { body_codec_put_tag(out, 2) }
        .DependencyGrant -> { body_codec_put_tag(out, 3) }
        .BuildFlag -> { body_codec_put_tag(out, 4) }
        .SessionFlag -> { body_codec_put_tag(out, 5) }
        .TrustGrant -> { body_codec_put_tag(out, 6) }
        .ForcePin -> { body_codec_put_tag(out, 7) }
        .TaintScrub -> { body_codec_put_tag(out, 8) }
        .DutyDrop -> { body_codec_put_tag(out, 9) }
        .StateTransition -> { body_codec_put_tag(out, 10) }
        .PrecisionDemotion -> { body_codec_put_tag(out, 11) }
        .Structure -> { body_codec_put_tag(out, 12) }
        .LintAllow -> { body_codec_put_tag(out, 13) }
        .CheckRemoval -> { body_codec_put_tag(out, 14) }
        .LinkOverride -> { body_codec_put_tag(out, 15) }
        .HostFacts -> { body_codec_put_tag(out, 16) }
        .ScopedGC -> { body_codec_put_tag(out, 17) }
        .ExplicitUnits -> { body_codec_put_tag(out, 18) }
        .Copies -> { body_codec_put_tag(out, 19) }
        .Sentries -> { body_codec_put_tag(out, 20) }
        .Arithmetic -> { body_codec_put_tag(out, 21) }
        .Failures -> { body_codec_put_tag(out, 22) }
        .Runtime -> body_codec_put_tag(out, 23)
    }
}

body_codec_get_policykey: fn(bytes: [U8], input: ^BodyCodecIn) -> PolicyKey Never! {
    position: body_codec_get_tag(bytes, input, 24, 0)
    if position == {
        1 -> PolicyKey.Impure
        2 -> PolicyKey.Nondeterministic
        3 -> PolicyKey.DependencyGrant
        4 -> PolicyKey.BuildFlag
        5 -> PolicyKey.SessionFlag
        6 -> PolicyKey.TrustGrant
        7 -> PolicyKey.ForcePin
        8 -> PolicyKey.TaintScrub
        9 -> PolicyKey.DutyDrop
        10 -> PolicyKey.StateTransition
        11 -> PolicyKey.PrecisionDemotion
        12 -> PolicyKey.Structure
        13 -> PolicyKey.LintAllow
        14 -> PolicyKey.CheckRemoval
        15 -> PolicyKey.LinkOverride
        16 -> PolicyKey.HostFacts
        17 -> PolicyKey.ScopedGC
        18 -> PolicyKey.ExplicitUnits
        19 -> PolicyKey.Copies
        20 -> PolicyKey.Sentries
        21 -> PolicyKey.Arithmetic
        22 -> PolicyKey.Failures
        23 -> PolicyKey.Runtime
        else -> PolicyKey.Unsafe
    }
}

body_codec_put_policyvalue: fn(out: ^BodyCodecOut, value: PolicyValue) Never! {
    if value == {
        .Enabled -> { body_codec_put_tag(out, 0) }
        .Limit(p0) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_int(out, p0)
        }
        .Forbid -> { body_codec_put_tag(out, 2) }
        .Default -> { body_codec_put_tag(out, 3) }
        .GateOnly -> { body_codec_put_tag(out, 4) }
        .Obligations -> { body_codec_put_tag(out, 5) }
        .Relaxed -> { body_codec_put_tag(out, 6) }
        .PerSite -> { body_codec_put_tag(out, 7) }
        .Track -> { body_codec_put_tag(out, 8) }
        .Skip -> { body_codec_put_tag(out, 9) }
        .Allow -> { body_codec_put_tag(out, 10) }
        .On -> { body_codec_put_tag(out, 11) }
        .Off -> { body_codec_put_tag(out, 12) }
        .Explicit -> { body_codec_put_tag(out, 13) }
        .Arithmetic(p0) -> {
            body_codec_put_tag(out, 14)
            body_codec_put_arithmeticmode(out, p0)
        }
        .NoEager -> { body_codec_put_tag(out, 15) }
        .Only -> body_codec_put_tag(out, 16)
    }
}

body_codec_get_policyvalue: fn(bytes: [U8], input: ^BodyCodecIn) -> PolicyValue Never! {
    position: body_codec_get_tag(bytes, input, 17, 0)
    if position == {
        1 -> {
            f0: body_codec_get_int(bytes, input)
            PolicyValue.Limit{value: f0}
        }
        2 -> PolicyValue.Forbid
        3 -> PolicyValue.Default
        4 -> PolicyValue.GateOnly
        5 -> PolicyValue.Obligations
        6 -> PolicyValue.Relaxed
        7 -> PolicyValue.PerSite
        8 -> PolicyValue.Track
        9 -> PolicyValue.Skip
        10 -> PolicyValue.Allow
        11 -> PolicyValue.On
        12 -> PolicyValue.Off
        13 -> PolicyValue.Explicit
        14 -> {
            f0: body_codec_get_arithmeticmode(bytes, input)
            PolicyValue.Arithmetic{mode: f0}
        }
        15 -> PolicyValue.NoEager
        16 -> PolicyValue.Only
        else -> PolicyValue.Enabled
    }
}

body_codec_put_arithmeticmode: fn(out: ^BodyCodecOut, value: ArithmeticMode) Never! {
    if value == {
        .Checked -> { body_codec_put_tag(out, 0) }
        .Wrapping -> { body_codec_put_tag(out, 1) }
        .Saturating -> body_codec_put_tag(out, 2)
    }
