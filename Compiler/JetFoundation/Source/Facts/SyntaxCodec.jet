    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_imagefield(out, value)
}

body_codec_get_list_imagefield: fn(bytes: [U8], input: ^BodyCodecIn) -> [ImageField] Never! {
    count: body_codec_get_count(bytes, input, 1)
    ^values: [ImageField]{}
    loop _ in 0..<count -> values.push(body_codec_get_imagefield(bytes, input))
    values
}

