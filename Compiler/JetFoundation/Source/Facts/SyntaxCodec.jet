        }
        .Loop(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_expr(out, p2)
            body_codec_put_list_derivebodyitem(out, p3)
            body_codec_put_span(out, p4)
        }
        .If(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 3)
            body_codec_put_expr(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_list_derivebodyitem(out, p2)
            body_codec_put_opt_list_derivebodyitem(out, p3)
            body_codec_put_span(out, p4)
        }
    }
}

body_codec_get_derivebodyitem: fn(bytes: [U8], input: ^BodyCodecIn) -> DeriveBodyItem Never! {
    position: body_codec_get_tag(bytes, input, 4, 2)
    if position == {
        0 -> {
            f0: body_codec_get_item(bytes, input)
            DeriveBodyItem.Item{value: f0}
        }
        1 -> {
            f0: body_codec_get_stmt(bytes, input)
            DeriveBodyItem.Stmt{value: f0}
        }
        3 -> {
            f0: body_codec_get_expr(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_list_derivebodyitem(bytes, input)
            f3: body_codec_get_opt_list_derivebodyitem(bytes, input)
            f4: body_codec_get_span(bytes, input)
            DeriveBodyItem.If{cond: f0, cond_span: f1, then_body: f2, else_body: f3, span: f4}
        }
        else -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_expr(bytes, input)
            f3: body_codec_get_list_derivebodyitem(bytes, input)
            f4: body_codec_get_span(bytes, input)
            DeriveBodyItem.Loop{var: f0, var_span: f1, source: f2, body: f3, span: f4}
        }
    }
}

body_codec_put_list_switcharm: fn(out: ^BodyCodecOut, values: [SwitchArm]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_switcharm(out, value)
}

body_codec_get_list_switcharm: fn(bytes: [U8], input: ^BodyCodecIn) -> [SwitchArm] Never! {
    count: body_codec_get_count(bytes, input, 1)
    ^values: [SwitchArm]{}
    loop _ in 0..<count -> values.push(body_codec_get_switcharm(bytes, input))
    values
}

body_codec_put_opt_list_stmt: fn(out: ^BodyCodecOut, value: [Stmt]?) Never! {
    if value == .Val(inner) {
        body_codec_put_bool(out, true)
        body_codec_put_list_stmt(out, inner)
        return
    }
    body_codec_put_bool(out, false)
}

body_codec_get_opt_list_stmt: fn(bytes: [U8], input: ^BodyCodecIn) -> [Stmt]? Never! {
    if body_codec_get_bool(bytes, input) -> return Val(body_codec_get_list_stmt(bytes, input))
    None
}

body_codec_put_opt_stmt: fn(out: ^BodyCodecOut, value: Stmt?) Never! {
    if value == .Val(inner) {
        body_codec_put_bool(out, true)
        body_codec_put_stmt(out, inner)
        return
    }
    body_codec_put_bool(out, false)
}

body_codec_get_opt_stmt: fn(bytes: [U8], input: ^BodyCodecIn) -> Stmt? Never! {
    if body_codec_get_bool(bytes, input) -> return Val(body_codec_get_stmt(bytes, input))
    None
}

body_codec_put_list_namedspan: fn(out: ^BodyCodecOut, values: [NamedSpan]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_namedspan(out, value)
}

body_codec_get_list_namedspan: fn(bytes: [U8], input: ^BodyCodecIn) -> [NamedSpan] Never! {
    count: body_codec_get_count(bytes, input, 1)
    ^values: [NamedSpan]{}
    loop _ in 0..<count -> values.push(body_codec_get_namedspan(bytes, input))
    values
}

body_codec_put_opt_bool: fn(out: ^BodyCodecOut, value: Bool?) Never! {
    if value == .Val(inner) {
        body_codec_put_bool(out, true)
        body_codec_put_bool(out, inner)
        return
    }
    body_codec_put_bool(out, false)
}

body_codec_get_opt_bool: fn(bytes: [U8], input: ^BodyCodecIn) -> Bool? Never! {
    if body_codec_get_bool(bytes, input) -> return Val(body_codec_get_bool(bytes, input))
    None
}

body_codec_put_list_contextfield: fn(out: ^BodyCodecOut, values: [ContextField]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_contextfield(out, value)
}

body_codec_get_list_contextfield: fn(bytes: [U8], input: ^BodyCodecIn) -> [ContextField] Never! {
    count: body_codec_get_count(bytes, input, 1)
    ^values: [ContextField]{}
    loop _ in 0..<count -> values.push(body_codec_get_contextfield(bytes, input))
    values
}

body_codec_put_stmt: fn(out: ^BodyCodecOut, value: Stmt) Never! {
    if value == {
        .Expr(p0) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_expr(out, p0)
        }
        .Val(p0) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_binding(out, p0)
        }
        .Assign(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_lvalue(out, p0)
            body_codec_put_opt_binop(out, p1)
            body_codec_put_span(out, p2)
            body_codec_put_expr(out, p3)
        }
        .Return(p0, p1) -> {
            body_codec_put_tag(out, 3)
            body_codec_put_opt_expr(out, p0)
            body_codec_put_span(out, p1)
        }
        .While(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 4)
            body_codec_put_expr(out, p0)
            body_codec_put_list_stmt(out, p1)
            body_codec_put_span(out, p2)
            body_codec_put_bool(out, p3)
            body_codec_put_opt_namedspan(out, p4)
        }
        .For(p0, p1, p2, p3, p4, p5, p6, p7, p8) -> {
            body_codec_put_tag(out, 5)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_opt_namedspan(out, p2)
            body_codec_put_forkind(out, p3)
            body_codec_put_list_stmt(out, p4)
            body_codec_put_span(out, p5)
            body_codec_put_bool(out, p6)
            body_codec_put_opt_namedspan(out, p7)
            body_codec_put_opt_autovectorizationfacts(out, p8)
        }
        .Switch(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 6)
            body_codec_put_expr(out, p0)
            body_codec_put_list_switcharm(out, p1)
            body_codec_put_opt_list_stmt(out, p2)
            body_codec_put_span(out, p3)
        }
        .Break(p0) -> {
            body_codec_put_tag(out, 7)
            body_codec_put_span(out, p0)
        }
        .BreakValue(p0, p1) -> {
            body_codec_put_tag(out, 8)
            body_codec_put_expr(out, p0)
            body_codec_put_span(out, p1)
        }
        .Continue(p0) -> {
            body_codec_put_tag(out, 9)
            body_codec_put_span(out, p0)
        }
        .BreakLabel(p0, p1) -> {
            body_codec_put_tag(out, 10)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
        }
        .BreakLabelValue(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 11)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_expr(out, p2)
            body_codec_put_span(out, p3)
        }
        .ContinueLabel(p0, p1) -> {
            body_codec_put_tag(out, 12)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
        }
        .Loop(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 13)
            body_codec_put_list_stmt(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_bool(out, p2)
            body_codec_put_opt_namedspan(out, p3)
        }
        .CountedLoop(p0, p1, p2, p3, p4, p5, p6) -> {
            body_codec_put_tag(out, 14)
            body_codec_put_binding(out, p0)
            body_codec_put_expr(out, p1)
            body_codec_put_opt_stmt(out, p2)
            body_codec_put_list_stmt(out, p3)
            body_codec_put_span(out, p4)
            body_codec_put_bool(out, p5)
            body_codec_put_opt_namedspan(out, p6)
        }
        .Unsafe(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 15)
            body_codec_put_opt_string(out, p0)
            body_codec_put_opt_expr(out, p1)
            body_codec_put_list_stmt(out, p2)
            body_codec_put_span(out, p3)
        }
        .Impure(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 16)
            body_codec_put_opt_string(out, p0)
            body_codec_put_opt_expr(out, p1)
            body_codec_put_list_stmt(out, p2)
            body_codec_put_span(out, p3)
        }
        .Reactive(p0, p1) -> {
            body_codec_put_tag(out, 17)
            body_codec_put_list_stmt(out, p0)
            body_codec_put_span(out, p1)
        }
        .Shield(p0, p1) -> {
            body_codec_put_tag(out, 18)
            body_codec_put_list_stmt(out, p0)
            body_codec_put_span(out, p1)
        }
        .Switched(p0, p1, p2) -> {
            body_codec_put_tag(out, 19)
            body_codec_put_marker(out, p0)
            body_codec_put_list_stmt(out, p1)
            body_codec_put_span(out, p2)
        }
        .Region(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 20)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_list_stmt(out, p2)
            body_codec_put_span(out, p3)
        }
        .Policy(p0, p1, p2) -> {
            body_codec_put_tag(out, 21)
            body_codec_put_list_policydeclaration(out, p0)
            body_codec_put_list_stmt(out, p1)
            body_codec_put_span(out, p2)
        }
        .TaskGroup(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 22)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_taskgroupargs(out, p2)
            body_codec_put_list_stmt(out, p3)
            body_codec_put_span(out, p4)
        }
        .Layout(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 23)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_list_stmt(out, p2)
            body_codec_put_span(out, p3)
        }
        .AuthorityScope(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 24)
            body_codec_put_list_namedspan(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_opt_namedspan(out, p2)
            body_codec_put_list_stmt(out, p3)
            body_codec_put_span(out, p4)
        }
        .ComptimeIf(p0, p1, p2, p3, p4, p5) -> {
            body_codec_put_tag(out, 25)
            body_codec_put_expr(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_list_stmt(out, p2)
            body_codec_put_opt_list_stmt(out, p3)
            body_codec_put_span(out, p4)
            body_codec_put_opt_bool(out, p5)
        }
        .ComptimeSwitch(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 26)
            body_codec_put_expr(out, p0)
            body_codec_put_list_switcharm(out, p1)
            body_codec_put_opt_list_stmt(out, p2)
            body_codec_put_span(out, p3)
        }
        .ComptimeBlock(p0, p1, p2) -> {
            body_codec_put_tag(out, 27)
            body_codec_put_list_stmt(out, p0)
            body_codec_put_bool(out, p1)
            body_codec_put_span(out, p2)
        }
        .ContextBlock(p0, p1, p2) -> {
            body_codec_put_tag(out, 28)
            body_codec_put_list_contextfield(out, p0)
            body_codec_put_list_stmt(out, p1)
            body_codec_put_span(out, p2)
        }
        .Live(p0, p1) -> {
            body_codec_put_tag(out, 29)
            body_codec_put_list_stmt(out, p0)
            body_codec_put_span(out, p1)
        }
        .AssumeDet(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 30)
            body_codec_put_string(out, p0)
            body_codec_put_expr(out, p1)
            body_codec_put_list_stmt(out, p2)
            body_codec_put_span(out, p3)
        }
        .Transact(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 31)
            body_codec_put_opt_string(out, p0)
            body_codec_put_opt_span(out, p1)
            body_codec_put_list_stmt(out, p2)
            body_codec_put_bool(out, p3)
            body_codec_put_span(out, p4)
        }
        .Yield(p0, p1) -> {
            body_codec_put_tag(out, 32)
            body_codec_put_expr(out, p0)
            body_codec_put_span(out, p1)
        }
        .ScopeMember(p0, p1, p2, p3, p4, p5, p6, p7) -> {
            body_codec_put_tag(out, 33)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_list_expr(out, p2)
            body_codec_put_opt_span(out, p3)
            body_codec_put_list_stmt(out, p4)
            body_codec_put_bool(out, p5)
            body_codec_put_span(out, p6)
            body_codec_put_span(out, p7)
        }
        .DeferClose(p0, p1) -> {
            body_codec_put_tag(out, 34)
            body_codec_put_expr(out, p0)
            body_codec_put_span(out, p1)
        }
        .Defer(p0, p1) -> {
            body_codec_put_tag(out, 35)
            body_codec_put_list_stmt(out, p0)
            body_codec_put_span(out, p1)
        }
    }
}

body_codec_get_stmt: fn(bytes: [U8], input: ^BodyCodecIn) -> Stmt Never! {
    position: body_codec_get_tag(bytes, input, 36, 0)
    if position == {
        1 -> {
            f0: body_codec_get_binding(bytes, input)
            Stmt.Val{binding: f0}
        }
        2 -> {
            f0: body_codec_get_lvalue(bytes, input)
            f1: body_codec_get_opt_binop(bytes, input)
            f2: body_codec_get_span(bytes, input)
            f3: body_codec_get_expr(bytes, input)
            Stmt.Assign{target: f0, op: f1, op_span: f2, value: f3}
        }
        3 -> {
            f0: body_codec_get_opt_expr(bytes, input)
            f1: body_codec_get_span(bytes, input)
            Stmt.Return{value: f0, span: f1}
        }
        4 -> {
            f0: body_codec_get_expr(bytes, input)
            f1: body_codec_get_list_stmt(bytes, input)
            f2: body_codec_get_span(bytes, input)
            f3: body_codec_get_bool(bytes, input)
            f4: body_codec_get_opt_namedspan(bytes, input)
            Stmt.While{cond: f0, body: f1, span: f2, arrow_body: f3, label: f4}
        }
        5 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_opt_namedspan(bytes, input)
            f3: body_codec_get_forkind(bytes, input)
            f4: body_codec_get_list_stmt(bytes, input)
            f5: body_codec_get_span(bytes, input)
            f6: body_codec_get_bool(bytes, input)
            f7: body_codec_get_opt_namedspan(bytes, input)
            f8: body_codec_get_opt_autovectorizationfacts(bytes, input)
            Stmt.For{var: f0, var_span: f1, var2: f2, kind: f3, body: f4, span: f5, arrow_body: f6, label: f7, auto_vectorization: f8}
        }
        6 -> {
            f0: body_codec_get_expr(bytes, input)
            f1: body_codec_get_list_switcharm(bytes, input)
            f2: body_codec_get_opt_list_stmt(bytes, input)
            f3: body_codec_get_span(bytes, input)
            Stmt.Switch{subject: f0, arms: f1, else_body: f2, span: f3}
        }
        7 -> {
            f0: body_codec_get_span(bytes, input)
            Stmt.Break{span: f0}
        }
        8 -> {
            f0: body_codec_get_expr(bytes, input)
            f1: body_codec_get_span(bytes, input)
            Stmt.BreakValue{value: f0, span: f1}
        }
        9 -> {
            f0: body_codec_get_span(bytes, input)
            Stmt.Continue{span: f0}
        }
        10 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            Stmt.BreakLabel{name: f0, span: f1}
        }
        11 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_expr(bytes, input)
            f3: body_codec_get_span(bytes, input)
            Stmt.BreakLabelValue{name: f0, name_span: f1, value: f2, span: f3}
        }
        12 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            Stmt.ContinueLabel{name: f0, span: f1}
        }
        13 -> {
            f0: body_codec_get_list_stmt(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_bool(bytes, input)
            f3: body_codec_get_opt_namedspan(bytes, input)
            Stmt.Loop{body: f0, span: f1, arrow_body: f2, label: f3}
        }
        14 -> {
            f0: body_codec_get_binding(bytes, input)
            f1: body_codec_get_expr(bytes, input)
            f2: body_codec_get_opt_stmt(bytes, input)
            f3: body_codec_get_list_stmt(bytes, input)
            f4: body_codec_get_span(bytes, input)
            f5: body_codec_get_bool(bytes, input)
            f6: body_codec_get_opt_namedspan(bytes, input)
            Stmt.CountedLoop{init: f0, cond: f1, step: f2, body: f3, span: f4, arrow_body: f5, label: f6}
        }
        15 -> {
            f0: body_codec_get_opt_string(bytes, input)
            f1: body_codec_get_opt_expr(bytes, input)
            f2: body_codec_get_list_stmt(bytes, input)
            f3: body_codec_get_span(bytes, input)
            Stmt.Unsafe{audit: f0, audit_expr: f1, body: f2, span: f3}
        }
        16 -> {
            f0: body_codec_get_opt_string(bytes, input)
            f1: body_codec_get_opt_expr(bytes, input)
            f2: body_codec_get_list_stmt(bytes, input)
            f3: body_codec_get_span(bytes, input)
            Stmt.Impure{reason: f0, reason_expr: f1, body: f2, span: f3}
        }
        17 -> {
            f0: body_codec_get_list_stmt(bytes, input)
            f1: body_codec_get_span(bytes, input)
            Stmt.Reactive{body: f0, span: f1}
        }
        18 -> {
            f0: body_codec_get_list_stmt(bytes, input)
            f1: body_codec_get_span(bytes, input)
            Stmt.Shield{body: f0, span: f1}
        }
        19 -> {
            f0: body_codec_get_marker(bytes, input)
            f1: body_codec_get_list_stmt(bytes, input)
            f2: body_codec_get_span(bytes, input)
            Stmt.Switched{marker: f0, body: f1, span: f2}
        }
        20 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_list_stmt(bytes, input)
            f3: body_codec_get_span(bytes, input)
            Stmt.Region{name: f0, name_span: f1, body: f2, span: f3}
        }
        21 -> {
            f0: body_codec_get_list_policydeclaration(bytes, input)
            f1: body_codec_get_list_stmt(bytes, input)
            f2: body_codec_get_span(bytes, input)
            Stmt.Policy{declarations: f0, body: f1, span: f2}
        }
        22 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_taskgroupargs(bytes, input)
            f3: body_codec_get_list_stmt(bytes, input)
            f4: body_codec_get_span(bytes, input)
            Stmt.TaskGroup{name: f0, name_span: f1, args: f2, body: f3, span: f4}
        }
        23 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_list_stmt(bytes, input)
            f3: body_codec_get_span(bytes, input)
            Stmt.Layout{name: f0, name_span: f1, body: f2, span: f3}
        }
        24 -> {
            f0: body_codec_get_list_namedspan(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_opt_namedspan(bytes, input)
            f3: body_codec_get_list_stmt(bytes, input)
            f4: body_codec_get_span(bytes, input)
            Stmt.AuthorityScope{caps: f0, caps_span: f1, binding: f2, body: f3, span: f4}
        }
        25 -> {
            f0: body_codec_get_expr(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_list_stmt(bytes, input)
            f3: body_codec_get_opt_list_stmt(bytes, input)
            f4: body_codec_get_span(bytes, input)
            f5: body_codec_get_opt_bool(bytes, input)
            Stmt.ComptimeIf{cond: f0, cond_span: f1, then_body: f2, else_body: f3, span: f4, selected_then: f5}
        }
        26 -> {
            f0: body_codec_get_expr(bytes, input)
            f1: body_codec_get_list_switcharm(bytes, input)
            f2: body_codec_get_opt_list_stmt(bytes, input)
            f3: body_codec_get_span(bytes, input)
