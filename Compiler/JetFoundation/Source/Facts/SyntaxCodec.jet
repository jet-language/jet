body_codec_put_modulearg: fn(out: ^BodyCodecOut, value: ModuleArg) Never! {
    if value == {
        .Type(p0, p1) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_type(out, p0)
            body_codec_put_span(out, p1)
        }
        .Value(p0, p1) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_expr(out, p0)
            body_codec_put_span(out, p1)
        }
    }
}

body_codec_get_modulearg: fn(bytes: [U8], input: ^BodyCodecIn) -> ModuleArg Never! {
    position: body_codec_get_tag(bytes, input, 2, 0)
    if position == {
        1 -> {
            f0: body_codec_get_expr(bytes, input)
            f1: body_codec_get_span(bytes, input)
            ModuleArg.Value{expr: f0, span: f1}
        }
        else -> {
            f0: body_codec_get_type(bytes, input)
            f1: body_codec_get_span(bytes, input)
            ModuleArg.Type{ty: f0, span: f1}
        }
    }
}

