    f2: body_codec_get_string(bytes, input)
    f3: body_codec_get_list_list_u8(bytes, input)
    f4: body_codec_get_list_string(bytes, input)
    f5: body_codec_get_list_list_string(bytes, input)
    f6: body_codec_get_span(bytes, input)
    f7: body_codec_get_list_moduleinstanceapplication(bytes, input)
    ModuleInstanceIdentity{full_key: f0, fingerprint: f1, definition_id: f2, argument_keys: f3, argument_values: f4, argument_provenance: f5, template_span: f6, applications: f7}
}

