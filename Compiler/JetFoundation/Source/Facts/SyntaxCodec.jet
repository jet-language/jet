    body_codec_put_string(out, value.type_name)
    body_codec_put_span(out, value.type_span)
    body_codec_put_list_migrationop(out, value.ops)
    body_codec_put_span(out, value.span)
}

body_codec_get_migrationdecl: fn(bytes: [U8], input: ^BodyCodecIn) -> MigrationDecl Never! {
    f0: body_codec_get_string(bytes, input)
    f1: body_codec_get_span(bytes, input)
    f2: body_codec_get_list_migrationop(bytes, input)
    f3: body_codec_get_span(bytes, input)
    MigrationDecl{type_name: f0, type_span: f1, ops: f2, span: f3}
}

body_codec_put_migrationop: fn(out: ^BodyCodecOut, value: MigrationOp) Never! {
    if value == {
        .Rename(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_string(out, p2)
            body_codec_put_span(out, p3)
        }
        .Add(p0, p1, p2, p3, p4, p5, p6) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_type(out, p2)
            body_codec_put_span(out, p3)
            body_codec_put_expr(out, p4)
            body_codec_put_span(out, p5)
            body_codec_put_opt_string(out, p6)
        }
        .Remove(p0, p1) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
        }
        .Change(p0, p1, p2, p3, p4, p5, p6, p7, p8) -> {
            body_codec_put_tag(out, 3)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_type(out, p2)
            body_codec_put_span(out, p3)
            body_codec_put_type(out, p4)
            body_codec_put_span(out, p5)
            body_codec_put_opt_expr(out, p6)
            body_codec_put_opt_span(out, p7)
            body_codec_put_opt_string(out, p8)
        }
    }
}

body_codec_get_migrationop: fn(bytes: [U8], input: ^BodyCodecIn) -> MigrationOp Never! {
    position: body_codec_get_tag(bytes, input, 4, 0)
    if position == {
        1 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_type(bytes, input)
            f3: body_codec_get_span(bytes, input)
            f4: body_codec_get_expr(bytes, input)
            f5: body_codec_get_span(bytes, input)
            f6: body_codec_get_opt_string(bytes, input)
            MigrationOp.Add{field: f0, field_span: f1, ty: f2, ty_span: f3, default: f4, default_span: f5, default_fn: f6}
        }
        2 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            MigrationOp.Remove{field: f0, field_span: f1}
        }
        3 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_type(bytes, input)
            f3: body_codec_get_span(bytes, input)
            f4: body_codec_get_type(bytes, input)
            f5: body_codec_get_span(bytes, input)
            f6: body_codec_get_opt_expr(bytes, input)
            f7: body_codec_get_opt_span(bytes, input)
            f8: body_codec_get_opt_string(bytes, input)
            MigrationOp.Change{field: f0, field_span: f1, from_ty: f2, from_span: f3, to_ty: f4, to_span: f5, converter: f6, converter_span: f7, conv_fn: f8}
        }
        else -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_string(bytes, input)
            f3: body_codec_get_span(bytes, input)
            MigrationOp.Rename{from: f0, from_span: f1, to: f2, to_span: f3}
        }
    }
}

