    body_codec_put_opt_span(out, value.explicit_type)
    body_codec_put_list_imagefield(out, value.fields)
    body_codec_put_span(out, value.span)
}

body_codec_get_imagelit: fn(bytes: [U8], input: ^BodyCodecIn) -> ImageLit Never! {
    f0: body_codec_get_opt_span(bytes, input)
    f1: body_codec_get_list_imagefield(bytes, input)
    f2: body_codec_get_span(bytes, input)
    ImageLit{explicit_type: f0, fields: f1, span: f2}
}

body_codec_put_imagefield: fn(out: ^BodyCodecOut, value: ImageField) Never! {
    body_codec_put_string(out, value.name)
    body_codec_put_span(out, value.name_span)
    body_codec_put_imagefieldvalue(out, value.value)
    body_codec_put_span(out, value.span)
}

body_codec_get_imagefield: fn(bytes: [U8], input: ^BodyCodecIn) -> ImageField Never! {
    f0: body_codec_get_string(bytes, input)
    f1: body_codec_get_span(bytes, input)
    f2: body_codec_get_imagefieldvalue(bytes, input)
    f3: body_codec_get_span(bytes, input)
    ImageField{name: f0, name_span: f1, value: f2, span: f3}
}

body_codec_put_imagefieldvalue: fn(out: ^BodyCodecOut, value: ImageFieldValue) Never! {
    if value == {
        .From(p0, p1) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_imagefromref(out, p0)
            body_codec_put_span(out, p1)
        }
        .Platform(p0, p1, p2) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_string(out, p0)
            body_codec_put_string(out, p1)
            body_codec_put_span(out, p2)
        }
        .Other(p0) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_expr(out, p0)
        }
    }
}

body_codec_get_imagefieldvalue: fn(bytes: [U8], input: ^BodyCodecIn) -> ImageFieldValue Never! {
    position: body_codec_get_tag(bytes, input, 3, 1)
    if position == {
        0 -> {
            f0: body_codec_get_imagefromref(bytes, input)
            f1: body_codec_get_span(bytes, input)
            ImageFieldValue.From{source: f0, span: f1}
        }
        2 -> {
            f0: body_codec_get_expr(bytes, input)
            ImageFieldValue.Other{value: f0}
        }
        else -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_string(bytes, input)
            f2: body_codec_get_span(bytes, input)
            ImageFieldValue.Platform{os: f0, arch: f1, span: f2}
        }
    }
}

body_codec_put_imagefromref: fn(out: ^BodyCodecOut, value: ImageFromRef) Never! {
    if value == {
        .Package(p0) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_string(out, p0)
        }
        .Environment(p0) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_string(out, p0)
        }
    }
}

body_codec_get_imagefromref: fn(bytes: [U8], input: ^BodyCodecIn) -> ImageFromRef Never! {
    position: body_codec_get_tag(bytes, input, 2, 0)
    if position == {
        1 -> {
            f0: body_codec_get_string(bytes, input)
            ImageFromRef.Environment{name: f0}
        }
        else -> {
            f0: body_codec_get_string(bytes, input)
            ImageFromRef.Package{name: f0}
        }
    }
}

