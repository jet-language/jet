// Maintained by hand. The first version was generated from the JetSema checker
// tree (Sema/Tree.jet), so every variant mirrors a checker tree variant.
//
// The flat checked body sema publishes per function (Cutover B). A function's
// expressions are rows of its BodyTree, keyed by node id: an expression's AST
// NodeId (>= 0), or a function-local id (<= TEXPR_FIRST_LOCAL_ID) for a node
// no source expression produced. Expression fields are node ids into the same
// tree; statement fields are indices into BodyTree.stmts. Every variant keeps
// its TExprKind name and payload order.

// One function's (or one standalone expression's) flat rows: nodes and the
// expression-type column sorted by id, statements in post order. The
// expression-type rows name their types by index into `types`, which holds
// each distinct type once (type_table_intern).
BodyTree: struct {
    nodes: [BodyNode]
    stmts: [StmtKind]
    expr_types: [TExprType]
    types: TypeTable{TypeTable{}}
    // A nested check's arena continues its enclosing check's rows: its first
    // node row is index `node_base` and its first statement row `stmt_base`,
    // and every row index into it subtracts them. Every other tree starts at 0.
    node_base: Int{0}
    stmt_base: Int{0}
}

// One expression: its node id, its checked form and its source span. Its type
// is the tree's expression-type row (body_type).
BodyNode: struct {
    id: Int
    kind: NodeKind
    span: Span
}

// A standalone checked expression (a comptime request) and its tree.
BodyExpr: struct {
    root: Int
    tree: BodyTree
}

body_tree_new: fn() -> BodyTree Never! {
    BodyTree{nodes: [BodyNode]{}, stmts: [StmtKind]{}, expr_types: [TExprType]{}}
}

// The row of node `id`.
body_node: fn(tree: BodyTree, id: Int) -> BodyNode Never! {
    low := 0
    high := tree.nodes.len()
    loop low < high {
        middle: (low + high) /% 2
        if tree.nodes[middle].id < id -> low = middle + 1 else -> high = middle
    }
    if low < tree.nodes.len() && tree.nodes[low].id == id -> return tree.nodes[low]
    panic("body tree has no node {id}")
}

// The checked type of node `id`.
body_type: fn(tree: BodyTree, id: Int) -> Type Never! {
    tree.types.types[body_type_id(tree, id)]
}

// The index in `tree.types` of node `id`'s checked type.
body_type_id: fn(tree: BodyTree, id: Int) -> Int Never! {
    checked_expr_type_id(tree.expr_types, id) ?? panic("body tree has no expression-type row for node {id}")
}

// Statement `index`.
body_stmt: fn(tree: BodyTree, index: Int) -> StmtKind Never! {
    tree.stmts[index - tree.stmt_base]
}

BodyStrPart: enum {
    Literal(text: String)
    Interpolation(value: Int, format: TStrFormat)
}

// A unit conversion's rounding: its mode and the digits expression's node.
BodyUnitRounding: struct {
    mode: TUnitRoundingMode
    digits: Int
}

BodyCallArg: struct {
    value: Int
    template_items: [SymbolID]
    borrow: Bool
    mut_borrow: Bool
    fn_coerce: TFnCoerce?
    widen_to_vec: Bool
    widen_to_union: Type?
    box_as_trait: Type?
    label: String?
    spread: Bool
}

BodyEnumArg: struct {
    value: Int
}

BodyEnumPayload: enum {
    Unit
    Positional(args: [BodyEnumArg])
    Named(fields: [BodyNamedEnumArg])
}

BodyNamedEnumArg: struct {
    name: String
    value: BodyEnumArg
}

BodyPatternShape: enum {
    Variant(variant: String, bindings: [BodyPatternBinding], leading_dot: Bool, span: Span)
    // S31: `inner` is a nested payload pattern (`.Val(.Rect(w, h))`).
    Present(binding: String, binding_span: Span, inner: BodyNestedPattern?, span: Span)
    Absent(span: Span)
    Ok(binding: String, binding_span: Span, inner: BodyNestedPattern?, span: Span)
    Err(binding: String, binding_span: Span, inner: BodyNestedPattern?, span: Span)
    Range(lo: Int, hi: Int, span: Span)
    Or(alternatives: [BodyPatternShape], span: Span)
    Struct(fields: [BodyPatternField], span: Span)
    List(items: [BodyPatternBinding], rest: TListPatternRest?, span: Span)
    Map(entries: [BodyMapPatternEntry], rest: Bool, span: Span)
    Text(parts: [TTextPatternPart], span: Span)
    Binary(parts: [TBinaryPatternPart], span: Span)
}

// S31: a checked nested payload pattern with the payload type's owner.
BodyNestedPattern: struct {
    shape: BodyPatternShape
    enum_type: SymbolID?
}

BodyPattern: struct {
    shape: BodyPatternShape
    bindings: [TPatternBindingFact]
    enum_type: SymbolID?
    position: TPatternPosition
    mutable: Bool
    boxed: Bool
}

BodyPatternBinding: enum {
    Wildcard
    Bind(name: String, span: Span)
    Range(lo: Int, hi: Int)
    Nested(pattern: BodyNestedPattern)
    Value(value: Int)
}

BodyPatternField: enum {
    Bind(field: String, local: String, span: Span)
    Value(field: String, value: Int, span: Span)
    Nested(field: String, pattern: BodyNestedPattern, span: Span)
}

BodyMapPatternEntry: struct {
    key: Int
    optional: Bool
    slot: BodyPatternBinding
    span: Span
}

BodyMatchArm: struct {
    pattern: BodyPattern
    body: [Int]
}

BodyIfCond: enum {
    Plain(value: Int)
    And(left: BodyIfCond, right: BodyIfCond)
    IfLet(pattern: BodyPattern, subj: Int)
}

BodyContract: struct {
    kind: TContractKind
    condition: Int
    message: Int
    file: String
    line: Int
    span: Span
    disposition: TContractDisposition
    site: TContractSite
}

// `task.group g(limit: n, stack: bytes)`'s argument node ids.
BodyTaskGroupArgs: struct {
    limit: Int?
    stack: Int?
}

BodyRangeArm: struct {
    lo: Int
    hi: Int
    body: [Int]
}

BodyMixedArm: struct {
    condition: Int
    body: [Int]
}

BodyContextGuard: struct {
    field: String
    value: Int
}

NodeKind: enum {
    IntLit(value: Int, width: TIntegerWidth?)
    FloatLit(value: Float)
    BoolLit(value: Bool)
    CharLit(value: Int)
    StrLit(parts: [BodyStrPart])
    Local(local: TLocal)
    Unit
    InlineBlock(body: [Int])
    Uninit
    CtLit(value: TComptimeValue)
    ConstRef(symbol: SymbolID)
    // `T.name` for a trait constant over a type parameter: the build reads
    // the constant of the implementation of `trait_name` (its short name)
    // that the concrete `owner` has.
    TraitConst(owner: Type, trait_name: String, name: String)
    // `N`, a `<N: Int>` number parameter read as an Int: `param` is
    // the parameter as a type (`Type.Named`), which each instance's type
    // rows bind to its Type.Measure number, so the build reads a constant.
    NumberParam(param: Type)
    // `#phase` in ordinary code: the `Phase` enum `owner` and its three unit
    // variants. Each compiled copy of the body builds the variant of its own
    // phase: the compile-time copy `preparation`, the build entry's copy
    // `build`, and the program `runtime`.
    CopyPhase(owner: SymbolID, preparation: SymbolID, build: SymbolID, runtime: SymbolID)
    GlobalShared(initializer: DeclID, lifetime: SharedLifetime)
    Call(callee: DeclID, type_args: [Type], args: [BodyCallArg])
    IndirectCall(callee: Int, type_args: [Type], args: [BodyCallArg], signature: Type)
    MethodCall(receiver: Int, method: TMethodRef, type_args: [Type], args: [BodyCallArg])
    DistinctCtor(argument: Int)
    DistinctConvert(owner: SymbolID, argument: Int, operation: TNumericOp, range: TIntegerBounds?, fallible: Bool)
    TraitBox(value: Int, target: Type)
    UnitConvert(argument: Int, scale: String, offset: String, rounding: BodyUnitRounding?, fallible: Bool, relative_uncertainty: Float?, file: String, line: Int)
    MathBuiltin(type_name: String, function: String, args: [Int])
    PreciseBuiltin(type_name: String, function: String, args: [Int])
    Print(value: Int)
    Drop(value: Int)
    Close(value: Int)
    Move(value: Int)
    RequireStop(kind: BodyRequireKind, location: TPanicLoc, always_stops: Bool)
    Binary(op: TBinaryOp, overflow: Bool, line: Int, lhs: Int, rhs: Int)
    CompareChain(operands: [Int], operators: [TBinaryOp], hooks: [Bool])
    Unary(op: TUnaryOp, operand: Int)
    StructLit(fields: [BodyStructFieldValue])
    Field(receiver: Int, field: TFieldRef)
    Index(base: Int, index: Int, kind: TIndexKind, access: AccessConvention, checked_call: SymbolID?, location: TPanicLoc)
    Slice(base: Int, start: Int, end: Int, range: Int?, location: TPanicLoc)
    Range(start: Int, end: Int, exclusive: Bool)
    Tuple(values: [Int])
    List(values: [Int], trait_coercion: Type?)
    Map(entries: [BodyMapEntry])
    EnumCtor(owner: SymbolID, variant: SymbolID, payload: BodyEnumPayload)
    Try(value: Int, conversion: TTryConvert, failure: TFailureCarrier)
    TryWithContext(inner: Int, note: Int?, convert: TTryConvert, file: String, line: Int, function: String)
    Lambda(value: BodyLambda)
    Borrow(place: Int, access: AccessConvention)
    RawAddressOf(place: BodyPlace)
    Deref(value: Int)
    PtrFromAddr(address: Int, element: Type)
    LayoutLiteral(value: Int)
    LayoutCompare(op: TBinaryOp, lhs: Int, rhs: Int)
    SharedGuardValue(guard: Int)
    SharedGuardMap(guard: Int, path: [TFieldRef], editable: Bool)
    SharedGuardSplit(guard: Int, first: [TFieldRef], second: [TFieldRef], editable: Bool)
    SharedGuardWait(guard: Int, condition: Int, predicate: BodyLambda)
    ConditionNotify(condition: Int, all: Bool)
    CoreCall(record: CoreCallRecord, args: [Int], source_span: Span, type_args: [Type], widen_to_vec: [Bool], fallibility: TFailureCarrier)
    HostCall(call: BodyHostCall)
    AllocNew(ctor: TAllocCtor, args: [BodyCallArg])
    EnumLit(enum_type: String, variant: String, payload: BodyEnumPayload)
    JSONLit(variant: String, arg: Int?, clone_arg: Bool)
    ListLit(values: [Int])
    ListSpread(parts: [BodyListSpreadPart])
    MapLit(entries: [BodyMapEntry])
    PoolSlot(pool: Int, id: Int, mutable: Bool, field: String?, line: Int, source_line: String)
    // #4318: `fact` is the sema decision behind the copy.
    Clone(value: Int, fact: CopyFact)
    ExplicitCopy(value: Int)
    MaterializeView(value: Int)
    StaticCall(owner: TStaticOwner, owner_type: Type?, method: TMethodRef, type_args: [Type], args: [BodyCallArg])
    DecodeUnder(segment: Int, inner: Int)
    BuiltinMethod(receiver: Int, operation: TBuiltinOp, args: [Int])
    IfExpr(cond: BodyIfCond, then_body: [Int], then_value: Int, else_body: [Int], else_value: Int)
    RawOf(value: Int)
    InvariantViolation(construct: String, span: Span)
    DistinctRaw(value: Int)
    Present(value: Int)
    Absent
    Ok(value: Int)
    Err(value: Int)
    OrFallback(value: Int, fallback: BodyOrFallback, ambient_err: TLocal?)
    OptField(base: Int, member: String, flatten: Bool)
    OptMethodCall(base: Int, binding: TLocal, call: Int, flatten: Bool)
    PatternMatches(subject: Int, pattern: BodyPattern)
    OptionLift2(function: Int, left: Int, right: Int)
    ClosureMethod(receiver: Int, operation: TClosureOp, args: [Int])
    NumericMethod(receiver: Int, operation: TNumericOp)
    NumericBinaryMethod(receiver: Int, operation: TNumericOp, argument: Int)
    OverflowOpt(prefix: String, operation: String, line: Int, lhs: Int, rhs: Int)
    HandleMethod(receiver: Int, operation: BodyHandleOp, args: [Int])
    CoreClosureCall(kind: BodyCoreClosureKind)
    TaskGroupAll(tasks: Int)
    TaskGroupRace(tasks: Int)
    TaskGroupAny(tasks: Int)
    SelectStart
    SelectRecv(builder: Int, channel: Int)
    SelectAfter(builder: Int, duration: Int, value: Int?)
    SelectWait(builder: Int, nonblocking: Bool)
    FnValue(kind: BodyFnValueKind)
    // A stop with no value, `reason` naming it ("todo" for a `#Todo` goal);
    // `line` is a `#Todo` goal's 1-based source line, 0 for any other stop.
    Never(reason: String, line: Int)
    // Whether generic type `subject` (a type parameter) is
    // exactly `target` in the instance being built. Only an `if` condition
    // holds one, and the IR folds that `if` to the arm its instance keeps.
    TypeTest(subject: Type, target: Type)
}

