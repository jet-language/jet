}

BodyLambda: struct {
    executable: BodyLambdaBody
    source_span: Span
    frame_schedule: FrameSchedule?
    frame_schedule_derivation: DerivationRef?
    capture_facts: TCaptureFacts
    failure_carrier: TFailureCarrier
    effects: TEffectFacts
    host_param_conventions: [AccessConvention]?
    source_params: [String]
    source_param_symbols: [SymbolID]
    param_types: [Type]
    ret: Type?
    is_move: Bool
    boxed: Bool
    rc: Bool
    captures: [TCapture]
    materialized_captures: [String]
    frozen_captures: [String]
    uses_stack_sentry: Bool
    // As FnBody.effect_scope, for a lambda with its own written row; an
    // inline loop body has none (it builds into its owner's code).
    effect_scope: String{""}
}

BodyLambdaBody: enum {
    Expr(value: Int)
    Block(body: [Int])
}

FnBody: struct {
    name: String
    module_name: String
    module_identity: String
    key: String
    source_file: String
    source_span: Span
    failure_carrier: TFailureCarrier
    effects: TEffectFacts
    web_bucket: WebBucket?
    // Why the web partition (JetSema WebPartition.jet) put this function in
    // `web_bucket`, for `jet inspect choices`; "" when the program does not
    // opt in to the partition.
    web_reason: String{""}
    web_marker: WebPartitionMarker?
    visibility: TVisibility
    foreign: TForeignProvenance?
    params: [BodyParameter]
    web_param_reconstructions: [TWebParamReconstruction]
    ret: Type?
    gc_return: Bool
    gc_scope: Bool
    return_view_provenance: ViewProvenanceMap?
    generic_params: [TGenericParam]
    is_main: Bool
    line: Int
    synthetic: Bool
    is_unsafe: Bool
    unsafe_gate: TUnsafeGate?
    is_pure: Bool
    memo_bound: Int?
    memo_unbounded: Bool
    is_reactive: Bool
    reactive_upgrades: [String]
    is_inline: Bool
    is_inline_always: Bool
    is_scalar: Bool
    kernel_proof: KernelProof?
    uses_stack_sentry: Bool
    // For a function nothing calls (an entry is one): the worst-case heap
    // every call path from it may take, by the proof `!Mem.Alloc(above: N)`
    // checks (JetSema Effects/Checks.jet sema_effect_heap_bounds): "N B" of
    // arena storage, or "unbounded, <why> via <path>"; else "".
    heap: String{""}
    // For a function nothing calls: the worst-case stack every call path
    // from it may take, by the proof `!Mem.Stack(above: N)` checks (JetSema
    // Effects/Checks.jet sema_effect_stack_bounds): "N B via <path>", each
    // step with its frame bound, or "unbounded, <why> via <path>"; else "".
    stack: String{""}
    // The bytes sema's frame model (Target/Frame.jet) bounds this function's
    // own frame by when a `!Mem.Stack(above: N)` denial reaches it; the
    // backend checks its real frame against that. -1 when no stack denial
    // reaches it or a value in it has no known size.
    frame_bound: Int{-1}
    body: [Int]
    kind: TFuncKind
    origin_facts: [TOriginProjection]{[TOriginProjection]{}}
    typed_goals: [TTypedGoal]{[TTypedGoal]{}}
    // The fixed-list indexes sema proved in range, and the function's checked
    // `#Pre` clauses; only the solver reads them.
    index_proofs: [TIndexProof]{[TIndexProof]{}}
    pre: [BodyContract]{[BodyContract]{}}
    // The branches on a `timing: .Fixed` value that sema masked (JetSema
    // Taint.jet sema_taint_mask_branch), by span: the IR builds each with
    // no jump (JetIR BuildMask.jet).
    masked: [Span]{[Span]{}}
    // The `timing: .Fixed` tags of the function's module (JetSema Taint.jet
    // sema_taint_fixed_tags) when one of the body's checked types carries
    // one, else empty: the IR builder marks each slot of such a type fixed
    // (JetIR IRFunction.slot_fixed).
    fixed_tags: [String]{[String]{}}
    // The run-time half of a written row that scopes FS or Net (JetRuntime
    // Authority.jet "Effect-scope frames"): the function's name, then the
    // row's FS and Net entries, one per line (a denial keeps its `!`), for a
    // function whose row scopes one of them; `@` and the published effect
    // for a Core scope publisher (effect_scope_published_effect); else "".
    // The scoped `#FX(…)` caps over it (its module's, type's or trait's)
    // come first, one frame each, frames separated by a blank line (JetSema
    // sema_effect_cap_frames). The IR builder enters every frame, outermost
    // first, on entry and leaves them on every exit (JetIR
    // ir_effect_scope_frame).
    effect_scope: String{""}
    // The frames of the body's `#FX(…)` blocks whose caps scope FS or Net,
    // each keyed by its block's span (the lowered region's): the IR builder
    // enters one around its block (JetIR ir_effect_scope_region).
    effect_scope_regions: [BodyEffectScopeRegion]{[BodyEffectScopeRegion]{}}
    // The function's nodes, statements and expression-type column.
    tree: BodyTree
}

// One `#FX(…)` block's effect-scope frame (FnBody.effect_scope_regions): the
// block's span and its descriptor, spelled as a function's is.
BodyEffectScopeRegion: struct {
    span: Span
    descriptor: String
}

// Whether a body of `functions` holds a `timing: .Fixed` value
// (FnBody.fixed_tags): a package that sets `policy.harden` admits such a
// program only on a host its vendor confirms (core.sys.timing_host).
body_fixed_timing: fn(functions: [FnBody]) -> Bool Never! {
    loop function in functions {
        if function.fixed_tags.len() > 0 -> return true
    }
    false
}

BodyParameter: struct {
    local: TLocal
    name: String
    span: Span
    ty: Type
    convention: AccessConvention
    public_label: String
    zone: ParamZone
    default: Int?
    variadic: Bool
}

BodyPlace: enum {
    Local(local: TLocal)
    Expr(value: Int)
}

// Child walkers: each visits the node id of every expression reachable from
// the value without passing through another expression (statement blocks are
// entered), in field order, as sema's Tree.jet walkers visit child TExprs.
body_each_str_part_child: fn(tree: BodyTree, value: BodyStrPart, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Interpolation(f0, _) -> {
            visit(f0)
        }
        .Literal(_) -> {}
    }
}

body_each_call_arg_child: fn(tree: BodyTree, value: BodyCallArg, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    visit(value.value)
}

body_each_enum_arg_child: fn(tree: BodyTree, value: BodyEnumArg, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    visit(value.value)
}

body_each_enum_payload_child: fn(tree: BodyTree, value: BodyEnumPayload, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Positional(f0) -> {
            loop item in f0 {
                body_each_enum_arg_child(tree, item, visit)
            }
        }
        .Named(f0) -> {
            loop item in f0 {
                body_each_named_enum_arg_child(tree, item, visit)
            }
        }
        .Unit -> {}
    }
}

body_each_named_enum_arg_child: fn(tree: BodyTree, value: BodyNamedEnumArg, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    body_each_enum_arg_child(tree, value.value, visit)
}

body_each_pattern_shape_child: fn(tree: BodyTree, value: BodyPatternShape, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Variant(_, f1, _, _) -> {
            loop item in f1 {
                body_each_pattern_binding_child(tree, item, visit)
            }
        }
        .Present(_, _, f2, _) -> {
            if f2 == .Val(inner) {
                body_each_nested_pattern_child(tree, inner, visit)
            }
        }
        .Ok(_, _, f2, _) -> {
            if f2 == .Val(inner) {
                body_each_nested_pattern_child(tree, inner, visit)
            }
        }
        .Err(_, _, f2, _) -> {
            if f2 == .Val(inner) {
                body_each_nested_pattern_child(tree, inner, visit)
            }
        }
        .Or(f0, _) -> {
            loop item in f0 {
                body_each_pattern_shape_child(tree, item, visit)
            }
        }
        .Struct(f0, _) -> {
            loop item in f0 {
                body_each_pattern_field_child(tree, item, visit)
            }
        }
        .List(f0, _, _) -> {
            loop item in f0 {
                body_each_pattern_binding_child(tree, item, visit)
            }
        }
        .Map(f0, _, _) -> {
            loop item in f0 {
                body_each_map_pattern_entry_child(tree, item, visit)
            }
        }
        .Absent(_) | .Range(_, _, _) | .Text(_, _) | .Binary(_, _) -> {}
    }
}

body_each_nested_pattern_child: fn(tree: BodyTree, value: BodyNestedPattern, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    body_each_pattern_shape_child(tree, value.shape, visit)
}

body_each_pattern_child: fn(tree: BodyTree, value: BodyPattern, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    body_each_pattern_shape_child(tree, value.shape, visit)
}

body_each_pattern_binding_child: fn(tree: BodyTree, value: BodyPatternBinding, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Nested(f0) -> {
            body_each_nested_pattern_child(tree, f0, visit)
        }
        .Value(f0) -> {
            visit(f0)
        }
        .Wildcard | .Bind(_, _) | .Range(_, _) -> {}
    }
}

body_each_pattern_field_child: fn(tree: BodyTree, value: BodyPatternField, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Value(_, f1, _) -> {
            visit(f1)
        }
        .Nested(_, f1, _) -> {
            body_each_nested_pattern_child(tree, f1, visit)
        }
        .Bind(_, _, _) -> {}
    }
}

body_each_map_pattern_entry_child: fn(tree: BodyTree, value: BodyMapPatternEntry, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    visit(value.key)
    body_each_pattern_binding_child(tree, value.slot, visit)
}

body_each_match_arm_child: fn(tree: BodyTree, value: BodyMatchArm, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    body_each_pattern_child(tree, value.pattern, visit)
    loop item in value.body {
        body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
    }
}

body_each_if_cond_child: fn(tree: BodyTree, value: BodyIfCond, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Plain(f0) -> {
            visit(f0)
        }
        .And(f0, f1) -> {
            body_each_if_cond_child(tree, f0, visit)
            body_each_if_cond_child(tree, f1, visit)
        }
        .IfLet(f0, f1) -> {
            body_each_pattern_child(tree, f0, visit)
            visit(f1)
        }
    }
}

body_each_contract_child: fn(tree: BodyTree, value: BodyContract, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    visit(value.condition)
    visit(value.message)
}

body_each_stmt_child: fn(tree: BodyTree, value: StmtKind, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Contract(f0) -> {
            body_each_contract_child(tree, f0, visit)
        }
        .ContractScope(f0, f1, f2, _, _) -> {
            loop item in f0 {
                body_each_contract_child(tree, item, visit)
            }
            loop item in f1 {
                body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
            }
            loop item in f2 {
                body_each_contract_child(tree, item, visit)
            }
        }
        .Let(_, _, f2, _, _, _) -> {
            visit(f2)
        }
        .RefutableBind(f0, f1, f2, _) -> {
            body_each_pattern_child(tree, f0, visit)
            visit(f1)
            loop item in f2 {
                body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
            }
        }
        .TupleDestructure(_, f1, _, _, _) -> {
            visit(f1)
        }
        .StructDestructure(_, f1, _, _, _) -> {
            visit(f1)
        }
        .ListDestructure(_, f1, _, _, _, _) -> {
            visit(f1)
        }
        .Assign(f0, _, f2, _, _) -> {
            body_each_place_child(tree, f0, visit)
            visit(f2)
        }
        .CountedLoop(_, f1, f2, f3, _, f5, _) -> {
            body_each_stmt_child(tree, tree.stmts[f1 - tree.stmt_base], visit)
            visit(f2)
            if f3 == .Val(inner) {
                body_each_stmt_child(tree, tree.stmts[inner - tree.stmt_base], visit)
            }
            loop item in f5 {
                body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
            }
        }
        .ForRange(_, _, f2, f3, f4, _, f6, _, _) -> {
            visit(f2)
            visit(f3)
            if f4 == .Val(inner) {
                visit(inner)
            }
            loop item in f6 {
                body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
            }
        }
        .Range(_, _, f2, f3, f4, f5, _, _, f8, _) -> {
            if f2 == .Val(inner) {
                visit(inner)
            }
            visit(f3)
            visit(f4)
            if f5 == .Val(inner) {
                visit(inner)
            }
            loop item in f8 {
                body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
            }
        }
        .ExprStmt(f0, _) -> {
            visit(f0)
        }
        .Return(f0, _) -> {
            if f0 == .Val(inner) {
                visit(inner)
            }
        }
        .TaskGroup(_, f1, f2, _) -> {
            if f1.limit == .Val(inner) {
                visit(inner)
            }
            if f1.stack == .Val(inner) {
                visit(inner)
            }
            loop item in f2 {
                body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
            }
        }
        .DeferClose(f0, _, _) -> {
            visit(f0)
        }
        .If(f0, f1, f2, _, _) -> {
            body_each_if_cond_child(tree, f0, visit)
            loop item in f1 {
                body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
            }
            if f2 == .Val(inner) {
                loop item in inner {
                    body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
                }
            }
        }
        .Loop(_, f1, _) -> {
            loop item in f1 {
                body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
            }
        }
        .While(_, f1, f2, _) -> {
            visit(f1)
            loop item in f2 {
                body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
            }
        }
        .BreakValue(_, f1, _) -> {
            visit(f1)
        }
        .Match(f0, f1, _, _) -> {
            visit(f0)
            loop item in f1 {
                body_each_match_arm_child(tree, item, visit)
            }
        }
        .EnumMatch(f0, f1, f2, _, _) -> {
            visit(f0)
            loop item in f1 {
                body_each_match_arm_child(tree, item, visit)
            }
            if f2 == .Val(inner) {
                loop item in inner {
                    body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
                }
            }
        }
        .RangeSwitch(f0, f1, f2, _) -> {
            visit(f0)
            loop item in f1 {
                body_each_range_arm_child(tree, item, visit)
            }
            loop item in f2 {
                body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
            }
        }
        .ForIn(_, _, _, f3, f4, f5, _, _, _, _, f10, _) -> {
            visit(f3)
            visit(f4)
            if f5 == .Val(inner) {
                visit(inner)
            }
            loop item in f10 {
                body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
            }
        }
        .Inline(f0, _) -> {
            loop item in f0 {
                body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
            }
        }
        .DebugOnly(f0, _) -> {
            loop item in f0 {
                body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
            }
        }
        .MixedSwitch(f0, _, f2, f3, _) -> {
            visit(f0)
            loop item in f2 {
                body_each_mixed_arm_child(tree, item, visit)
            }
            if f3 == .Val(inner) {
                loop item in inner {
                    body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
                }
            }
        }
        .Unsafe(_, f1) -> {
            loop item in f1 {
                body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
            }
        }
        .UnsafeBlock(_, f1, _) -> {
            loop item in f1 {
                body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
            }
        }
        .SentryPolicy(_, f1, _) -> {
            loop item in f1 {
                body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
            }
        }
        .Impure(f0, _) -> {
            loop item in f0 {
                body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
            }
        }
        .Reactive(f0, _) -> {
            body_each_lambda_child(tree, f0, visit)
        }
        .Region(f0, _) -> {
            loop item in f0 {
                body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
            }
        }
        .Layout(_, _, f2, _) -> {
            loop item in f2 {
                body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
            }
        }
        .ContextBlock(f0, f1, _) -> {
            loop item in f0 {
                body_each_context_guard_child(tree, item, visit)
            }
            loop item in f1 {
                body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
            }
        }
        .Live(f0, _) -> {
            loop item in f0 {
                body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
            }
        }
        .Shield(f0, _) -> {
            loop item in f0 {
                body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
            }
        }
        .ScopeMember(f0, f1, _) -> {
            body_each_scope_member_kind_child(tree, f0, visit)
            loop item in f1 {
                body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
            }
        }
        .Transact(_, _, _, f3, _) -> {
            loop item in f3 {
                body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
            }
        }
        .GCEdit(_, _, _, _, f4, f5, _) -> {
            if f4 == .Val(inner) {
                visit(inner)
            }
            body_each_stmt_child(tree, tree.stmts[f5 - tree.stmt_base], visit)
        }
        .Break(_, _) | .Continue(_, _) -> {}
    }
}

body_each_range_arm_child: fn(tree: BodyTree, value: BodyRangeArm, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    loop item in value.body {
        body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
    }
}

body_each_mixed_arm_child: fn(tree: BodyTree, value: BodyMixedArm, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    visit(value.condition)
    loop item in value.body {
        body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
    }
}

body_each_context_guard_child: fn(tree: BodyTree, value: BodyContextGuard, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    visit(value.value)
}

body_each_node_kind_child: fn(tree: BodyTree, value: NodeKind, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .StrLit(f0) -> {
            loop item in f0 {
                body_each_str_part_child(tree, item, visit)
            }
        }
        .InlineBlock(f0) -> {
            loop item in f0 {
                body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
            }
        }
        .Call(_, _, f2) -> {
            loop item in f2 {
                body_each_call_arg_child(tree, item, visit)
            }
        }
        .IndirectCall(f0, _, f2, _) -> {
            visit(f0)
            loop item in f2 {
                body_each_call_arg_child(tree, item, visit)
            }
        }
        .MethodCall(f0, _, _, f3) -> {
            visit(f0)
            loop item in f3 {
                body_each_call_arg_child(tree, item, visit)
            }
        }
        .DistinctCtor(f0) -> {
            visit(f0)
        }
        .DistinctConvert(_, f1, _, _, _) -> {
            visit(f1)
        }
        .TraitBox(f0, _) -> {
            visit(f0)
        }
        .UnitConvert(f0, _, _, f3, _, _, _, _) -> {
            visit(f0)
            if f3 == .Val(rounding) -> visit(rounding.digits)
        }
        .MathBuiltin(_, _, f2) -> {
            loop item in f2 {
                visit(item)
            }
        }
        .PreciseBuiltin(_, _, f2) -> {
            loop item in f2 {
                visit(item)
            }
        }
        .Print(f0) -> {
            visit(f0)
        }
        .Drop(f0) -> {
            visit(f0)
        }
        .Close(f0) -> {
            visit(f0)
        }
        .Move(f0) -> {
            visit(f0)
        }
        .RequireStop(f0, _, _) -> {
            body_each_require_kind_child(tree, f0, visit)
        }
        .Binary(_, _, _, f3, f4) -> {
            visit(f3)
            visit(f4)
        }
        .CompareChain(f0, _, _) -> {
            loop item in f0 {
                visit(item)
            }
        }
        .Unary(_, f1) -> {
            visit(f1)
        }
        .StructLit(f0) -> {
            loop item in f0 {
                body_each_struct_field_value_child(tree, item, visit)
            }
        }
        .Field(f0, _) -> {
            visit(f0)
        }
        .Index(f0, f1, _, _, _, _) -> {
            visit(f0)
            visit(f1)
        }
        .Slice(f0, f1, f2, f3, _) -> {
            visit(f0)
            visit(f1)
            visit(f2)
            if f3 == .Val(inner) {
                visit(inner)
            }
        }
        .Range(f0, f1, _) -> {
            visit(f0)
            visit(f1)
        }
        .Tuple(f0) -> {
            loop item in f0 {
                visit(item)
            }
        }
        .List(f0, _) -> {
            loop item in f0 {
                visit(item)
            }
        }
        .Map(f0) -> {
            loop item in f0 {
                body_each_map_entry_child(tree, item, visit)
            }
        }
        .EnumCtor(_, _, f2) -> {
            body_each_enum_payload_child(tree, f2, visit)
        }
        .Try(f0, _, _) -> {
            visit(f0)
        }
        .TryWithContext(f0, f1, _, _, _, _) -> {
            visit(f0)
            if f1 == .Val(inner) {
                visit(inner)
            }
        }
        .Lambda(f0) -> {
            body_each_lambda_child(tree, f0, visit)
        }
        .Borrow(f0, _) -> {
            visit(f0)
        }
        .RawAddressOf(f0) -> {
            body_each_place_child(tree, f0, visit)
        }
        .Deref(f0) -> {
            visit(f0)
        }
        .PtrFromAddr(f0, _) -> {
            visit(f0)
        }
        .LayoutLiteral(f0) -> {
            visit(f0)
        }
        .LayoutCompare(_, f1, f2) -> {
            visit(f1)
            visit(f2)
        }
        .SharedGuardValue(f0) -> {
            visit(f0)
        }
        .SharedGuardMap(f0, _, _) -> {
            visit(f0)
        }
        .SharedGuardSplit(f0, _, _, _) -> {
            visit(f0)
        }
        .SharedGuardWait(f0, f1, f2) -> {
            visit(f0)
            visit(f1)
            body_each_lambda_child(tree, f2, visit)
        }
        .ConditionNotify(f0, _) -> {
            visit(f0)
        }
        .CoreCall(_, f1, _, _, _, _) -> {
            loop item in f1 {
                visit(item)
            }
        }
        .HostCall(f0) -> {
            body_each_host_call_child(tree, f0, visit)
        }
        .AllocNew(_, f1) -> {
            loop item in f1 {
                body_each_call_arg_child(tree, item, visit)
            }
        }
        .EnumLit(_, _, f2) -> {
            body_each_enum_payload_child(tree, f2, visit)
        }
        .JSONLit(_, f1, _) -> {
            if f1 == .Val(inner) {
                visit(inner)
            }
        }
        .ListLit(f0) -> {
            loop item in f0 {
                visit(item)
            }
        }
        .ListSpread(f0) -> {
            loop item in f0 {
                body_each_list_spread_part_child(tree, item, visit)
            }
        }
        .MapLit(f0) -> {
            loop item in f0 {
                body_each_map_entry_child(tree, item, visit)
            }
        }
        .PoolSlot(f0, f1, _, _, _, _) -> {
            visit(f0)
            visit(f1)
        }
        .Clone(f0, _) -> {
            visit(f0)
        }
        .ExplicitCopy(f0) -> {
            visit(f0)
        }
        .MaterializeView(f0) -> {
            visit(f0)
        }
        .StaticCall(_, _, _, _, f4) -> {
            loop item in f4 {
                body_each_call_arg_child(tree, item, visit)
            }
        }
        .DecodeUnder(f0, f1) -> {
            visit(f0)
            visit(f1)
        }
        .BuiltinMethod(f0, _, f2) -> {
            visit(f0)
            loop item in f2 {
                visit(item)
            }
        }
        .IfExpr(f0, f1, f2, f3, f4) -> {
            body_each_if_cond_child(tree, f0, visit)
            loop item in f1 {
                body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
            }
            visit(f2)
            loop item in f3 {
                body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
            }
            visit(f4)
        }
        .RawOf(f0) -> {
            visit(f0)
        }
        .DistinctRaw(f0) -> {
            visit(f0)
        }
        .Present(f0) -> {
            visit(f0)
        }
        .Ok(f0) -> {
            visit(f0)
        }
        .Err(f0) -> {
            visit(f0)
        }
        .OrFallback(f0, f1, _) -> {
            visit(f0)
            body_each_or_fallback_child(tree, f1, visit)
        }
        .OptField(f0, _, _) -> {
            visit(f0)
        }
        .OptMethodCall(f0, _, f2, _) -> {
            visit(f0)
            visit(f2)
        }
        .PatternMatches(f0, f1) -> {
            visit(f0)
            body_each_pattern_child(tree, f1, visit)
        }
        .OptionLift2(f0, f1, f2) -> {
            visit(f0)
            visit(f1)
            visit(f2)
        }
        .ClosureMethod(f0, _, f2) -> {
            visit(f0)
            loop item in f2 {
                visit(item)
            }
        }
        .NumericMethod(f0, _) -> {
            visit(f0)
        }
        .NumericBinaryMethod(f0, _, f2) -> {
            visit(f0)
            visit(f2)
        }
        .OverflowOpt(_, _, _, f3, f4) -> {
            visit(f3)
            visit(f4)
        }
        .HandleMethod(f0, _, f2) -> {
            visit(f0)
            loop item in f2 {
                visit(item)
            }
        }
        .CoreClosureCall(f0) -> {
            body_each_core_closure_kind_child(tree, f0, visit)
        }
        .TaskGroupAll(f0) -> {
            visit(f0)
        }
        .TaskGroupRace(f0) -> {
            visit(f0)
        }
        .TaskGroupAny(f0) -> {
            visit(f0)
        }
        .SelectRecv(f0, f1) -> {
            visit(f0)
            visit(f1)
        }
        .SelectAfter(f0, f1, f2) -> {
            visit(f0)
            visit(f1)
            if f2 == .Val(inner) {
                visit(inner)
            }
        }
        .SelectWait(f0, _) -> {
            visit(f0)
        }
        .FnValue(f0) -> {
            body_each_fn_value_kind_child(tree, f0, visit)
        }
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .Local(_) | .Unit | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .InvariantViolation(_, _) | .Absent | .SelectStart | .Never(_, _) | .TypeTest(_, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> {}
    }
}

body_each_expr_child: fn(tree: BodyTree, value: BodyNode, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    body_each_node_kind_child(tree, value.kind, visit)
}

body_each_struct_field_value_child: fn(tree: BodyTree, value: BodyStructFieldValue, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    visit(value.value)
}

body_each_map_entry_child: fn(tree: BodyTree, value: BodyMapEntry, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    visit(value.key)
    visit(value.value)
}

body_each_list_spread_part_child: fn(tree: BodyTree, value: BodyListSpreadPart, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Element(f0) -> {
            visit(f0)
        }
        .Spread(f0) -> {
            visit(f0)
        }
    }
}

body_each_scope_member_kind_child: fn(tree: BodyTree, value: BodyScopeMemberKind, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Timeout(f0) -> {
            visit(f0)
        }
        .Setup | .ExpectFail(_, _) | .Measure | .Skip -> {}
    }
}

body_each_or_fallback_child: fn(tree: BodyTree, value: BodyOrFallback, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Value(f0) -> {
            visit(f0)
        }
        .Return(f0) -> {
            if f0 == .Val(inner) {
                visit(inner)
            }
        }
        .Panic(f0, _) -> {
            visit(f0)
        }
        .Break | .Continue | .BreakLabel(_) | .ContinueLabel(_) -> {}
    }
}

body_each_host_call_child: fn(tree: BodyTree, value: BodyHostCall, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Method(f0, _, f2) -> {
            visit(f0)
            loop item in f2 {
                visit(item)
            }
        }
        .CellGuardProject(f0, _, _, _, _) -> {
            visit(f0)
        }
        .OptionProbe(f0, _) -> {
            visit(f0)
        }
        .TupleIndex(f0, _) -> {
            visit(f0)
        }
        .YieldSend(f0) -> {
            visit(f0)
        }
        .ComptimeInput(_, f1, _) -> {
            visit(f1)
        }
        .SwitchSubjectValue | .NumericBounds(_, _) | .MemoStats(_, _) | .ContextRead(_) -> {}
    }
}

body_each_core_closure_kind_child: fn(tree: BodyTree, value: BodyCoreClosureKind, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Spawn(f0, _, _, f3) -> {
            if f0 == .Val(inner) {
                visit(inner)
            }
            body_each_lambda_child(tree, f3, visit)
        }
        .Realtime(f0, f1, f2) -> {
            visit(f0)
            visit(f1)
            body_each_lambda_child(tree, f2, visit)
        }
        .Guard(f0) -> {
            body_each_lambda_child(tree, f0, visit)
        }
        .OnCommit(_, f1) -> {
            body_each_lambda_child(tree, f1, visit)
        }
        .OnRollback(_, f1) -> {
            body_each_lambda_child(tree, f1, visit)
        }
        .UIClickSlot(f0) -> {
            body_each_lambda_child(tree, f0, visit)
        }
        .UITextInputOnDrop(f0, f1, f2) -> {
            visit(f0)
            visit(f1)
            body_each_lambda_child(tree, f2, visit)
        }
        .ReactiveDerived(f0) -> {
            body_each_lambda_child(tree, f0, visit)
        }
        .ReactiveEffect(f0) -> {
            body_each_lambda_child(tree, f0, visit)
        }
        .UIReactiveRender(f0) -> {
            body_each_lambda_child(tree, f0, visit)
        }
    }
}

body_each_fn_value_kind_child: fn(tree: BodyTree, value: BodyFnValueKind, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .NamedFn(_, f1) -> {
            if f1 == .Val(inner) {
                body_each_lambda_child(tree, inner, visit)
            }
        }
        .Policy(_, f1, _, _, _, f5) -> {
            loop item in f1 {
                body_each_call_arg_child(tree, item, visit)
            }
            visit(f5)
        }
        .Call(f0, f1) -> {
            visit(f0)
            loop item in f1 {
                body_each_call_arg_child(tree, item, visit)
            }
        }
        .Send(f0) -> {
            visit(f0)
        }
    }
}

body_each_require_kind_child: fn(tree: BodyTree, value: BodyRequireKind, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Require(f0, f1) -> {
            visit(f0)
            if f1 == .Val(inner) {
                visit(inner)
            }
        }
        .RequireEq(f0, f1, _) -> {
            visit(f0)
            visit(f1)
        }
        .Panic(f0) -> {
            visit(f0)
        }
    }
}

body_each_lambda_child: fn(tree: BodyTree, value: BodyLambda, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    body_each_lambda_body_child(tree, value.executable, visit)
}

body_each_lambda_body_child: fn(tree: BodyTree, value: BodyLambdaBody, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Expr(f0) -> {
            visit(f0)
        }
        .Block(f0) -> {
            loop item in f0 {
                body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], visit)
            }
        }
    }
}

body_each_place_child: fn(tree: BodyTree, value: BodyPlace, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Expr(f0) -> {
            visit(f0)
        }
        .Local(_) -> {}
    }
}
