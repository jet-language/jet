    DBPoolReady
    DBPoolDrain
    DBPoolReceipt
    DBLeaseClose
    ServiceRuntimeSend
    ServiceRuntimeRetry
    ServiceRuntimeDeadLetter
    ServiceRuntimeRetain
    ServiceRuntimeCommit
    DBQuery(metadata: TDBQueryMetadata?)
    DBQueryOne(metadata: TDBQueryMetadata?)
    DBExecute(metadata: TDBQueryMetadata?)
    DBLive
    DBBegin
    DBCommit
    DBRollback
    DBClose
    DBValueInt
    DBValueFloat
    DBValueText
    DBValueBool
    DBValueBlob
    DBValueIsNull
    PluginInvoke(export_name: String, signature: ComponentSignatureDescriptor)
    ReaderOver(owned: Bool)
    ReaderReadU8
    ReaderReadI8
    ReaderReadU16Le
    ReaderReadU16Be
    ReaderReadI16Le
    ReaderReadI16Be
    ReaderReadU32Le
    ReaderReadU32Be
    ReaderReadI32Le
    ReaderReadI32Be
    ReaderReadU64Le
    ReaderReadU64Be
    ReaderReadI64Le
    ReaderReadI64Be
    ReaderReadF32Le
    ReaderReadF32Be
    ReaderReadF64Le
    ReaderReadF64Be
    ReaderPeek
    ReaderSeek
    ReaderSkip
    ReaderTake
    ReaderRemaining
    ReaderAtEnd
    CursorOver
    CursorTakeUntil
    CursorSkipWs
    CursorTakePattern(parts: [StrMatchPart], canonical: [TCanonicalField])
    ReaderTakePattern(parts: [BinMatchPart], canonical: [TCanonicalField])
    ProcessLines
}

enum BodyRequireKind {
    Require(cond: Int, msg: Int?)
    RequireEq(left: Int, right: Int)
    Panic(msg: Int)
}

struct BodyLambda {
    executable: BodyLambdaBody
    source_span: Span
    frame_schedule: FrameSchedule?
    frame_schedule_derivation: DerivationRef?
    capture_facts: TCaptureFacts
    failure_carrier: TFailureCarrier
    effects: TEffectFacts
    host_param_conventions: [AccessConvention]?
    source_params: [String]
    source_param_symbols: [SymbolID]
    param_types: [Type]
    ret: Type?
    is_move: Bool
    boxed: Bool
    rc: Bool
    captures: [TCapture]
    materialized_captures: [String]
    frozen_captures: [String]
    uses_stack_sentry: Bool
}

enum BodyLambdaBody {
    Expr(value: Int)
    Block(body: [Int])
}

struct FnBody {
    name: String
    module_name: String
    module_identity: String
    key: String
    source_file: String
    source_span: Span
    failure_carrier: TFailureCarrier
    effects: TEffectFacts
    target_applicability: TTargetApplicability
    web_bucket: WebBucket?
    web_marker: WebPartitionMarker?
    visibility: TVisibility
    foreign: TForeignProvenance?
    params: [BodyParameter]
    web_param_reconstructions: [TWebParamReconstruction]
    ret: Type?
    gc_return: Bool
    gc_scope: Bool
    return_view_provenance: ViewProvenanceMap?
    generic_params: [TGenericParam]
    is_main: Bool
    line: Int
    synthetic: Bool
    is_unsafe: Bool
    unsafe_gate: TUnsafeGate?
    is_pure: Bool
    memo_bound: Int?
    memo_unbounded: Bool
    is_reactive: Bool
    reactive_upgrades: [String]
    is_inline: Bool
    is_inline_always: Bool
    is_scalar: Bool
    kernel_proof: KernelProof?
    uses_stack_sentry: Bool
    body: [Int]
    kind: TFuncKind
    origin_facts: [TOriginProjection]{[TOriginProjection]{}}
    typed_goals: [TTypedGoal]{[TTypedGoal]{}}
    // The function's nodes, statements and expression-type column.
    tree: BodyTree
}

struct BodyParameter {
    local: TLocal
    name: String
    span: Span
    ty: Type
    convention: AccessConvention
    public_label: String
    zone: ParamZone
    default: Int?
    variadic: Bool
}

enum BodyPlace {
    Local(local: TLocal)
    Expr(value: Int)
}

// Child walkers: each visits the node id of every expression reachable from
// the value without passing through another expression (statement blocks are
// entered), in field order, as TIR's tir_each_*_child walkers visit child TExprs.
fn body_each_str_part_child(tree: BodyTree, value: BodyStrPart, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Interpolation(f0, _) -> {
            visit(f0)
        }
        else -> {}
    }
}

fn body_each_call_arg_child(tree: BodyTree, value: BodyCallArg, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    visit(value.value)
}

fn body_each_enum_arg_child(tree: BodyTree, value: BodyEnumArg, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    visit(value.value)
}

fn body_each_enum_payload_child(tree: BodyTree, value: BodyEnumPayload, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Positional(f0) -> {
            loop item in f0 {
                body_each_enum_arg_child(tree, item, visit)
            }
        }
        .Named(f0) -> {
            loop item in f0 {
                body_each_named_enum_arg_child(tree, item, visit)
            }
        }
        else -> {}
    }
}

fn body_each_named_enum_arg_child(tree: BodyTree, value: BodyNamedEnumArg, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    body_each_enum_arg_child(tree, value.value, visit)
}

fn body_each_pattern_shape_child(tree: BodyTree, value: BodyPatternShape, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Variant(_, f1, _, _) -> {
            loop item in f1 {
                body_each_pattern_binding_child(tree, item, visit)
            }
        }
        .Present(_, _, f2, _) -> {
            if f2 == .Val(inner) {
                body_each_nested_pattern_child(tree, inner, visit)
            }
        }
        .Ok(_, _, f2, _) -> {
            if f2 == .Val(inner) {
                body_each_nested_pattern_child(tree, inner, visit)
            }
        }
        .Err(_, _, f2, _) -> {
            if f2 == .Val(inner) {
                body_each_nested_pattern_child(tree, inner, visit)
            }
        }
        .Or(f0, _) -> {
            loop item in f0 {
                body_each_pattern_shape_child(tree, item, visit)
            }
        }
        .Struct(f0, _) -> {
            loop item in f0 {
                body_each_pattern_field_child(tree, item, visit)
            }
        }
        .List(f0, _, _) -> {
            loop item in f0 {
                body_each_pattern_binding_child(tree, item, visit)
            }
        }
        .Map(f0, _, _) -> {
            loop item in f0 {
                body_each_map_pattern_entry_child(tree, item, visit)
            }
        }
        else -> {}
    }
}

fn body_each_nested_pattern_child(tree: BodyTree, value: BodyNestedPattern, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    body_each_pattern_shape_child(tree, value.shape, visit)
}

fn body_each_pattern_child(tree: BodyTree, value: BodyPattern, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    body_each_pattern_shape_child(tree, value.shape, visit)
}

fn body_each_pattern_binding_child(tree: BodyTree, value: BodyPatternBinding, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Nested(f0) -> {
            body_each_nested_pattern_child(tree, f0, visit)
        }
        .Value(f0) -> {
            visit(f0)
        }
        else -> {}
    }
}

fn body_each_pattern_field_child(tree: BodyTree, value: BodyPatternField, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Value(_, f1, _) -> {
            visit(f1)
        }
        .Nested(_, f1, _) -> {
            body_each_nested_pattern_child(tree, f1, visit)
        }
        else -> {}
    }
}

fn body_each_map_pattern_entry_child(tree: BodyTree, value: BodyMapPatternEntry, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    visit(value.key)
    body_each_pattern_binding_child(tree, value.slot, visit)
}

fn body_each_match_arm_child(tree: BodyTree, value: BodyMatchArm, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    body_each_pattern_child(tree, value.pattern, visit)
    loop item in value.body {
        body_each_stmt_child(tree, tree.stmts[item], visit)
    }
}

fn body_each_if_cond_child(tree: BodyTree, value: BodyIfCond, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Plain(f0) -> {
            visit(f0)
        }
        .And(f0, f1) -> {
            body_each_if_cond_child(tree, f0, visit)
            body_each_if_cond_child(tree, f1, visit)
        }
        .IfLet(f0, f1) -> {
            body_each_pattern_child(tree, f0, visit)
            visit(f1)
        }
        else -> {}
    }
}

fn body_each_contract_child(tree: BodyTree, value: BodyContract, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    visit(value.condition)
    visit(value.message)
}

fn body_each_stmt_child(tree: BodyTree, value: StmtKind, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Contract(f0) -> {
            body_each_contract_child(tree, f0, visit)
        }
        .ContractScope(f0, f1, f2, _, _) -> {
            loop item in f0 {
                body_each_contract_child(tree, item, visit)
            }
            loop item in f1 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
            loop item in f2 {
                body_each_contract_child(tree, item, visit)
            }
        }
        .Let(_, _, f2, _, _, _) -> {
            visit(f2)
        }
        .RefutableBind(f0, f1, f2, _) -> {
            body_each_pattern_child(tree, f0, visit)
            visit(f1)
            loop item in f2 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
        }
        .TupleDestructure(_, f1, _, _, _) -> {
            visit(f1)
        }
        .StructDestructure(_, f1, _, _, _) -> {
            visit(f1)
        }
        .ListDestructure(_, f1, _, _, _, _) -> {
            visit(f1)
        }
        .Assign(f0, _, f2, _, _) -> {
            body_each_place_child(tree, f0, visit)
            visit(f2)
        }
        .CountedLoop(_, f1, f2, f3, _, f5, _) -> {
            body_each_stmt_child(tree, tree.stmts[f1], visit)
            visit(f2)
            if f3 == .Val(inner) {
                body_each_stmt_child(tree, tree.stmts[inner], visit)
            }
            loop item in f5 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
        }
        .ForRange(_, _, f2, f3, f4, _, f6, _, _) -> {
            visit(f2)
            visit(f3)
            if f4 == .Val(inner) {
                visit(inner)
            }
            loop item in f6 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
        }
        .Range(_, _, f2, f3, f4, f5, _, _, f8, _) -> {
            if f2 == .Val(inner) {
                visit(inner)
            }
            visit(f3)
            visit(f4)
            if f5 == .Val(inner) {
                visit(inner)
            }
            loop item in f8 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
        }
        .ExprStmt(f0, _) -> {
            visit(f0)
        }
        .Return(f0, _) -> {
            if f0 == .Val(inner) {
                visit(inner)
            }
        }
        .TaskGroup(_, f1, f2, _) -> {
            if f1 == .Val(inner) {
                visit(inner)
            }
            loop item in f2 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
        }
        .DeferClose(f0, _, _) -> {
            visit(f0)
        }
        .If(f0, f1, f2, _, _) -> {
            body_each_if_cond_child(tree, f0, visit)
            loop item in f1 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
            if f2 == .Val(inner) {
                loop item in inner {
                    body_each_stmt_child(tree, tree.stmts[item], visit)
                }
            }
        }
        .Loop(_, f1, _) -> {
            loop item in f1 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
        }
        .While(_, f1, f2, _) -> {
            visit(f1)
            loop item in f2 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
        }
        .BreakValue(_, f1, _) -> {
            visit(f1)
        }
        .Match(f0, f1, _, _) -> {
            visit(f0)
            loop item in f1 {
                body_each_match_arm_child(tree, item, visit)
            }
        }
        .EnumMatch(f0, f1, f2, _, _) -> {
            visit(f0)
            loop item in f1 {
                body_each_match_arm_child(tree, item, visit)
            }
            if f2 == .Val(inner) {
                loop item in inner {
                    body_each_stmt_child(tree, tree.stmts[item], visit)
                }
            }
        }
        .RangeSwitch(f0, f1, f2, _) -> {
            visit(f0)
            loop item in f1 {
                body_each_range_arm_child(tree, item, visit)
            }
            loop item in f2 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
        }
        .ForIn(_, _, _, f3, f4, f5, _, _, _, _, f10, _) -> {
            visit(f3)
            visit(f4)
            if f5 == .Val(inner) {
                visit(inner)
            }
            loop item in f10 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
        }
        .Inline(f0, _) -> {
            loop item in f0 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
        }
        .DebugOnly(f0, _) -> {
            loop item in f0 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
        }
        .MixedSwitch(f0, _, f2, f3, _) -> {
            visit(f0)
            loop item in f2 {
                body_each_mixed_arm_child(tree, item, visit)
            }
            if f3 == .Val(inner) {
                loop item in inner {
                    body_each_stmt_child(tree, tree.stmts[item], visit)
                }
            }
        }
        .Unsafe(_, f1) -> {
            loop item in f1 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
        }
        .UnsafeBlock(_, f1, _) -> {
            loop item in f1 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
        }
        .SentryPolicy(_, f1, _) -> {
            loop item in f1 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
        }
        .Impure(f0, _) -> {
            loop item in f0 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
        }
        .Reactive(f0, _) -> {
            body_each_lambda_child(tree, f0, visit)
        }
        .Region(f0, _) -> {
            loop item in f0 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
        }
        .Layout(_, _, f2, _) -> {
            loop item in f2 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
        }
        .ContextBlock(f0, f1, _) -> {
            loop item in f0 {
                body_each_context_guard_child(tree, item, visit)
            }
            loop item in f1 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
        }
        .Live(f0, _) -> {
            loop item in f0 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
        }
        .Shield(f0, _) -> {
            loop item in f0 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
        }
        .ScopeMember(f0, f1, _) -> {
            body_each_scope_member_kind_child(tree, f0, visit)
            loop item in f1 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
        }
        .Transact(_, _, _, f3, _) -> {
            loop item in f3 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
        }
        .GCEdit(_, _, _, _, f4, f5, _) -> {
            if f4 == .Val(inner) {
                visit(inner)
            }
            body_each_stmt_child(tree, tree.stmts[f5], visit)
        }
        else -> {}
    }
}

fn body_each_range_arm_child(tree: BodyTree, value: BodyRangeArm, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    loop item in value.body {
        body_each_stmt_child(tree, tree.stmts[item], visit)
    }
}

fn body_each_mixed_arm_child(tree: BodyTree, value: BodyMixedArm, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    visit(value.condition)
    loop item in value.body {
        body_each_stmt_child(tree, tree.stmts[item], visit)
    }
}

fn body_each_context_guard_child(tree: BodyTree, value: BodyContextGuard, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    visit(value.value)
}

fn body_each_node_kind_child(tree: BodyTree, value: NodeKind, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .StrLit(f0) -> {
            loop item in f0 {
                body_each_str_part_child(tree, item, visit)
            }
        }
        .InlineBlock(f0) -> {
            loop item in f0 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
        }
        .Call(_, _, f2) -> {
            loop item in f2 {
                body_each_call_arg_child(tree, item, visit)
            }
        }
        .IndirectCall(f0, _, f2, _) -> {
            visit(f0)
            loop item in f2 {
                body_each_call_arg_child(tree, item, visit)
            }
        }
        .MethodCall(f0, _, _, f3) -> {
            visit(f0)
            loop item in f3 {
                body_each_call_arg_child(tree, item, visit)
            }
        }
        .DistinctCtor(f0) -> {
            visit(f0)
        }
        .DistinctConvert(_, f1, _, _, _) -> {
            visit(f1)
        }
        .TraitBox(f0, _) -> {
            visit(f0)
        }
        .UnitConvert(f0, _, _, f3, _, _, _, _) -> {
            visit(f0)
            if f3 == .Val(rounding) -> visit(rounding.digits)
        }
        .MathBuiltin(_, _, f2) -> {
            loop item in f2 {
                visit(item)
            }
        }
        .PreciseBuiltin(_, _, f2) -> {
            loop item in f2 {
                visit(item)
            }
        }
        .Print(f0) -> {
            visit(f0)
        }
        .Drop(f0) -> {
            visit(f0)
        }
        .Close(f0) -> {
            visit(f0)
        }
        .Move(f0) -> {
            visit(f0)
        }
        .AmbientInput(f0) -> {
            if f0 == .Val(inner) {
                visit(inner)
            }
        }
        .RequireStop(f0, _, _) -> {
            body_each_require_kind_child(tree, f0, visit)
        }
        .Binary(_, _, _, f3, f4) -> {
            visit(f3)
            visit(f4)
        }
        .CompareChain(f0, _, _) -> {
            loop item in f0 {
                visit(item)
            }
        }
        .Unary(_, f1) -> {
            visit(f1)
        }
        .StructLit(f0) -> {
            loop item in f0 {
                body_each_struct_field_value_child(tree, item, visit)
            }
        }
        .Field(f0, _) -> {
            visit(f0)
        }
        .Index(f0, f1, _, _, _, _) -> {
            visit(f0)
            visit(f1)
        }
        .Slice(f0, f1, f2, f3, _) -> {
            visit(f0)
            visit(f1)
            visit(f2)
            if f3 == .Val(inner) {
                visit(inner)
            }
        }
        .Range(f0, f1, _) -> {
            visit(f0)
            visit(f1)
        }
        .Tuple(f0) -> {
            loop item in f0 {
                visit(item)
            }
        }
        .List(f0, _) -> {
            loop item in f0 {
                visit(item)
            }
        }
        .Map(f0) -> {
            loop item in f0 {
                body_each_map_entry_child(tree, item, visit)
            }
        }
        .EnumCtor(_, _, f2) -> {
            body_each_enum_payload_child(tree, f2, visit)
        }
        .Try(f0, _, _) -> {
            visit(f0)
        }
        .TryWithContext(f0, f1, _, _, _, _) -> {
            visit(f0)
            if f1 == .Val(inner) {
                visit(inner)
            }
        }
        .Lambda(f0) -> {
            body_each_lambda_child(tree, f0, visit)
        }
        .Borrow(f0, _) -> {
            visit(f0)
        }
        .RawAddressOf(f0) -> {
            body_each_place_child(tree, f0, visit)
        }
        .Deref(f0) -> {
            visit(f0)
        }
        .PtrFromAddr(f0, _) -> {
            visit(f0)
        }
        .LayoutLiteral(f0) -> {
            visit(f0)
        }
        .LayoutCompare(_, f1, f2) -> {
            visit(f1)
            visit(f2)
        }
        .SharedGuardValue(f0) -> {
            visit(f0)
        }
        .SharedGuardMap(f0, _, _) -> {
            visit(f0)
        }
        .SharedGuardSplit(f0, _, _, _) -> {
            visit(f0)
        }
        .SharedGuardWait(f0, f1, f2) -> {
            visit(f0)
            visit(f1)
            body_each_lambda_child(tree, f2, visit)
        }
        .ConditionNotify(f0, _) -> {
            visit(f0)
        }
        .CoreCall(_, f1, _, _, _, _) -> {
            loop item in f1 {
                visit(item)
            }
        }
        .HostCall(f0) -> {
            body_each_host_call_child(tree, f0, visit)
        }
        .AllocNew(_, f1) -> {
            loop item in f1 {
                body_each_call_arg_child(tree, item, visit)
            }
        }
        .EnumLit(_, _, f2) -> {
            body_each_enum_payload_child(tree, f2, visit)
        }
        .JSONLit(_, f1, _) -> {
            if f1 == .Val(inner) {
                visit(inner)
            }
        }
        .DBValueLit(_, f1, _) -> {
            if f1 == .Val(inner) {
                visit(inner)
            }
        }
        .ListLit(f0) -> {
            loop item in f0 {
                visit(item)
            }
        }
        .ListSpread(f0) -> {
            loop item in f0 {
                body_each_list_spread_part_child(tree, item, visit)
            }
        }
        .MapLit(f0) -> {
            loop item in f0 {
                body_each_map_entry_child(tree, item, visit)
            }
        }
        .PoolSlot(f0, f1, _, _, _, _) -> {
            visit(f0)
            visit(f1)
        }
        .MathLaneIndex(_, f1, f2, _) -> {
            visit(f1)
            visit(f2)
        }
        .MathSwizzleRead(_, f1, _) -> {
            visit(f1)
        }
        .Clone(f0, _) -> {
            visit(f0)
        }
        .ExplicitCopy(f0) -> {
            visit(f0)
        }
        .MaterializeView(f0) -> {
            visit(f0)
        }
        .StaticCall(_, _, _, _, f4) -> {
            loop item in f4 {
                body_each_call_arg_child(tree, item, visit)
            }
        }
        .DecodeUnder(f0, f1) -> {
            visit(f0)
            visit(f1)
        }
        .BuiltinMethod(f0, _, f2) -> {
            visit(f0)
            loop item in f2 {
                visit(item)
            }
        }
        .IfExpr(f0, f1, f2, f3, f4) -> {
            body_each_if_cond_child(tree, f0, visit)
            loop item in f1 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
            visit(f2)
            loop item in f3 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
            visit(f4)
        }
        .ResultHandler(f0, f1, f2, f3, f4, f5, f6, f7) -> {
            visit(f0)
            body_each_pattern_child(tree, f1, visit)
            loop item in f2 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
            visit(f3)
            body_each_pattern_child(tree, f4, visit)
            loop item in f5 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
            visit(f6)
            visit(f7)
        }
        .RawOf(f0) -> {
            visit(f0)
        }
        .DistinctRaw(f0) -> {
            visit(f0)
        }
        .Present(f0) -> {
            visit(f0)
        }
        .Ok(f0) -> {
            visit(f0)
        }
        .Err(f0) -> {
            visit(f0)
        }
        .OrFallback(f0, f1, _) -> {
            visit(f0)
            body_each_or_fallback_child(tree, f1, visit)
        }
        .OptField(f0, _, _) -> {
            visit(f0)
        }
        .OptMethodCall(f0, _, f2, _) -> {
            visit(f0)
            visit(f2)
        }
        .PatternMatches(f0, f1) -> {
            visit(f0)
            body_each_pattern_child(tree, f1, visit)
        }
        .OptionLift2(f0, f1, f2) -> {
            visit(f0)
            visit(f1)
            visit(f2)
        }
        .ClosureMethod(f0, _, f2) -> {
            visit(f0)
            loop item in f2 {
                visit(item)
            }
        }
        .HostBorrowCallback(f0, _) -> {
            visit(f0)
        }
        .NumericMethod(f0, _) -> {
            visit(f0)
        }
        .NumericBinaryMethod(f0, _, f2) -> {
            visit(f0)
            visit(f2)
        }
        .OverflowOpt(_, _, _, f3, f4) -> {
            visit(f3)
            visit(f4)
        }
        .HandleMethod(f0, f1, f2) -> {
            visit(f0)
            body_each_handle_op_child(tree, f1, visit)
            loop item in f2 {
                visit(item)
            }
        }
        .CoreClosureCall(f0) -> {
            body_each_core_closure_kind_child(tree, f0, visit)
        }
        .TaskGroupAll(f0) -> {
            visit(f0)
        }
        .TaskGroupRace(f0) -> {
            visit(f0)
        }
        .TaskGroupAny(f0) -> {
            visit(f0)
        }
        .SelectRecv(f0, f1) -> {
            visit(f0)
            visit(f1)
        }
        .SelectAfter(f0, f1, f2) -> {
            visit(f0)
            visit(f1)
            if f2 == .Val(inner) {
                visit(inner)
            }
        }
        .SelectWait(f0, _) -> {
            visit(f0)
        }
        .FnValue(f0) -> {
            body_each_fn_value_kind_child(tree, f0, visit)
        }
        else -> {}
    }
}

fn body_each_expr_child(tree: BodyTree, value: BodyNode, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    body_each_node_kind_child(tree, value.kind, visit)
}

fn body_each_struct_field_value_child(tree: BodyTree, value: BodyStructFieldValue, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    visit(value.value)
}

fn body_each_map_entry_child(tree: BodyTree, value: BodyMapEntry, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    visit(value.key)
    visit(value.value)
}

fn body_each_list_spread_part_child(tree: BodyTree, value: BodyListSpreadPart, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Element(f0) -> {
            visit(f0)
        }
        .Spread(f0) -> {
            visit(f0)
        }
        else -> {}
    }
}

fn body_each_scope_member_kind_child(tree: BodyTree, value: BodyScopeMemberKind, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Timeout(f0) -> {
            visit(f0)
        }
        else -> {}
    }
}

fn body_each_or_fallback_child(tree: BodyTree, value: BodyOrFallback, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Value(f0) -> {
            visit(f0)
        }
        .Return(f0) -> {
            if f0 == .Val(inner) {
                visit(inner)
            }
        }
        .Panic(f0, _) -> {
            visit(f0)
        }
        else -> {}
    }
}

fn body_each_host_call_child(tree: BodyTree, value: BodyHostCall, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Method(f0, _, f2) -> {
            visit(f0)
            loop item in f2 {
                visit(item)
            }
        }
        .CellGuardProject(f0, _, _, _, _) -> {
            visit(f0)
        }
        .TypedText(_, f1) -> {
            visit(f1)
        }
        .OptionProbe(f0, _) -> {
            visit(f0)
        }
        .TupleIndex(f0, _) -> {
            visit(f0)
        }
        .YieldSend(f0) -> {
            visit(f0)
        }
        .TypedTextInterp(_, _, f2, _) -> {
            loop item in f2 {
                visit(item)
            }
        }
        else -> {}
    }
}

fn body_each_core_closure_kind_child(tree: BodyTree, value: BodyCoreClosureKind, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Spawn(f0, _, _, f3) -> {
            if f0 == .Val(inner) {
                visit(inner)
            }
            body_each_lambda_child(tree, f3, visit)
        }
        .Realtime(f0, f1, f2) -> {
            visit(f0)
            visit(f1)
            body_each_lambda_child(tree, f2, visit)
        }
        .Guard(f0) -> {
            body_each_lambda_child(tree, f0, visit)
        }
        .OnCommit(_, f1) -> {
            body_each_lambda_child(tree, f1, visit)
        }
        .OnRollback(_, f1) -> {
            body_each_lambda_child(tree, f1, visit)
        }
        .UIButtonOnClick(f0, f1, f2, f3) -> {
            visit(f0)
            visit(f1)
            visit(f2)
            body_each_lambda_child(tree, f3, visit)
        }
        .UITextInputOnDrop(f0, f1, f2) -> {
            visit(f0)
            visit(f1)
            body_each_lambda_child(tree, f2, visit)
        }
        .ReactiveDerived(f0) -> {
            body_each_lambda_child(tree, f0, visit)
        }
        .ReactiveEffect(f0) -> {
            body_each_lambda_child(tree, f0, visit)
        }
        .UIReactiveRender(f0) -> {
            body_each_lambda_child(tree, f0, visit)
        }
        else -> {}
    }
}

fn body_each_fn_value_kind_child(tree: BodyTree, value: BodyFnValueKind, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .NamedFn(_, f1) -> {
            if f1 == .Val(inner) {
                body_each_lambda_child(tree, inner, visit)
            }
        }
        .Policy(_, f1, _, _, _, f5) -> {
            loop item in f1 {
                body_each_call_arg_child(tree, item, visit)
            }
            visit(f5)
        }
        .Call(f0, f1) -> {
            visit(f0)
            loop item in f1 {
                body_each_call_arg_child(tree, item, visit)
            }
        }
        .Send(f0) -> {
            visit(f0)
        }
        else -> {}
    }
}

fn body_each_handle_op_child(tree: BodyTree, value: BodyHandleOp, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .HTTPRouterRegister(_, f1, _, _, _, _) -> {
            visit(f1)
        }
        else -> {}
    }
}

fn body_each_require_kind_child(tree: BodyTree, value: BodyRequireKind, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Require(f0, f1) -> {
            visit(f0)
            if f1 == .Val(inner) {
                visit(inner)
            }
        }
        .RequireEq(f0, f1) -> {
            visit(f0)
            visit(f1)
        }
        .Panic(f0) -> {
            visit(f0)
        }
        else -> {}
    }
}

fn body_each_lambda_child(tree: BodyTree, value: BodyLambda, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    body_each_lambda_body_child(tree, value.executable, visit)
}

fn body_each_lambda_body_child(tree: BodyTree, value: BodyLambdaBody, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Expr(f0) -> {
            visit(f0)
        }
        .Block(f0) -> {
            loop item in f0 {
                body_each_stmt_child(tree, tree.stmts[item], visit)
            }
        }
        else -> {}
    }
}

fn body_each_place_child(tree: BodyTree, value: BodyPlace, visit: fn(Int) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if value == {
        .Expr(f0) -> {
            visit(f0)
        }
        else -> {}
    }
}
