            f3: body_codec_get_opt_list_callcontractrow(bytes, input)
            f4: body_codec_get_opt_functioncallmetadata(bytes, input)
            f5: body_codec_get_opt_viewprovenancemap(bytes, input)
            Type.Fn{params: f0, ret: f1, effect_bound: f2, param_contract: f3, call_metadata: f4, return_view_provenance: f5}
        }
        11 -> {
            f0: body_codec_get_string(bytes, input)
            Type.Named{name: f0}
        }
        12 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_list_type(bytes, input)
            Type.Apply{name: f0, args: f1}
        }
        13 -> {
            f0: body_codec_get_list_string(bytes, input)
            Type.TraitObject{bounds: f0}
        }
        14 -> {
            f0: body_codec_get_list_typetuplefield(bytes, input)
            Type.Tuple{fields: f0}
        }
        15 -> {
            f0: body_codec_get_type(bytes, input)
            f1: body_codec_get_measure(bytes, input)
            Type.FixedList{elem: f0, len: f1}
        }
        16 -> {
            f0: body_codec_get_bool(bytes, input)
            f1: body_codec_get_int(bytes, input)
            Type.IntN{signed: f0, bits: f1}
        }
        17 -> {
            f0: body_codec_get_type(bytes, input)
            f1: body_codec_get_int(bytes, input)
            f2: body_codec_get_int(bytes, input)
