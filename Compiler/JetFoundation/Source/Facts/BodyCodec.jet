    f1: body_codec_get_string(bytes, input)
    f2: body_codec_get_bool(bytes, input)
    f3: body_codec_get_opt_symbolid(bytes, input)
    f4: body_codec_get_opt_string(bytes, input)
    TMethodRef{symbol: f0, name: f1, mangled: f2, trait_owner: f3, operator_identity: f4}
}

body_codec_put_tnumericop: fn(out: &BodyCodecOut, value: TNumericOp) Never! {
    if value == {
        .Predicate(p0) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_string(out, p0)
        }
        .BitCount(p0, p1) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_string(out, p0)
            body_codec_put_int(out, p1)
        }
        .CastAs(p0) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_string(out, p0)
        }
        .CheckedIntToFloat(p0, p1, p2) -> {
            body_codec_put_tag(out, 3)
            body_codec_put_bool(out, p0)
            body_codec_put_bool(out, p1)
            body_codec_put_int(out, p2)
        }
        .CheckedIntToFixed(p0, p1) -> {
            body_codec_put_tag(out, 4)
            body_codec_put_int(out, p0)
            body_codec_put_int(out, p1)
        }
        .FixedNarrow(p0, p1) -> {
            body_codec_put_tag(out, 5)
            body_codec_put_tnarrowoutcome(out, p0)
            body_codec_put_int(out, p1)
        }
        .TryFrom(p0) -> {
            body_codec_put_tag(out, 6)
            body_codec_put_int(out, p0)
        }
        .FloatExact(p0, p1) -> {
            body_codec_put_tag(out, 7)
            body_codec_put_tnarrowoutcome(out, p0)
            body_codec_put_int(out, p1)
        }
        .FloatNarrow -> { body_codec_put_tag(out, 8) }
        .InlineRange(p0, p1, p2) -> {
            body_codec_put_tag(out, 9)
            body_codec_put_int(out, p0)
            body_codec_put_int(out, p1)
            body_codec_put_bool(out, p2)
        }
        .ToShow -> { body_codec_put_tag(out, 10) }
        .EuclideanDiv -> { body_codec_put_tag(out, 11) }
        .EuclideanRem -> { body_codec_put_tag(out, 12) }
        .CharFromScalar -> body_codec_put_tag(out, 13)
    }
}

body_codec_get_tnumericop: fn(bytes: [U8], input: &BodyCodecIn) -> TNumericOp Never! {
    position: body_codec_get_tag(bytes, input, 14, 8)
    if position == {
        0 -> {
            f0: body_codec_get_string(bytes, input)
            TNumericOp.Predicate{name: f0}
        }
        1 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_int(bytes, input)
            TNumericOp.BitCount{method: f0, width: f1}
        }
        2 -> {
            f0: body_codec_get_string(bytes, input)
            TNumericOp.CastAs{dst_rust: f0}
        }
        3 -> {
            f0: body_codec_get_bool(bytes, input)
            f1: body_codec_get_bool(bytes, input)
            f2: body_codec_get_int(bytes, input)
            TNumericOp.CheckedIntToFloat{source_signed: f0, target_f32: f1, line: f2}
        }
        4 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_int(bytes, input)
            TNumericOp.CheckedIntToFixed{host_kind: f0, line: f1}
        }
        5 -> {
            f0: body_codec_get_tnarrowoutcome(bytes, input)
            f1: body_codec_get_int(bytes, input)
            TNumericOp.FixedNarrow{outcome: f0, line: f1}
        }
        6 -> {
            f0: body_codec_get_int(bytes, input)
            TNumericOp.TryFrom{host_kind: f0}
        }
        7 -> {
            f0: body_codec_get_tnarrowoutcome(bytes, input)
            f1: body_codec_get_int(bytes, input)
            TNumericOp.FloatExact{outcome: f0, line: f1}
        }
        9 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_int(bytes, input)
            f2: body_codec_get_bool(bytes, input)
            TNumericOp.InlineRange{lo: f0, hi: f1, fallible: f2}
        }
        10 -> TNumericOp.ToShow
        11 -> TNumericOp.EuclideanDiv
        12 -> TNumericOp.EuclideanRem
        13 -> TNumericOp.CharFromScalar
        else -> TNumericOp.FloatNarrow
    }
}

body_codec_put_tnarrowoutcome: fn(out: &BodyCodecOut, value: TNarrowOutcome) Never! {
    if value == {
        .Stop -> { body_codec_put_tag(out, 0) }
        .Wrap -> { body_codec_put_tag(out, 1) }
        .Saturate -> { body_codec_put_tag(out, 2) }
        .Absent -> body_codec_put_tag(out, 3)
    }
}

body_codec_get_tnarrowoutcome: fn(bytes: [U8], input: &BodyCodecIn) -> TNarrowOutcome Never! {
