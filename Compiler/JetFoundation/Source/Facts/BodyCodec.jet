}

body_codec_put_derivationdisposition: fn(out: ^BodyCodecOut, value: DerivationDisposition) Never! {
    if value == {
        .Current -> { body_codec_put_tag(out, 0) }
        .Stale -> { body_codec_put_tag(out, 1) }
        .Expired -> { body_codec_put_tag(out, 2) }
        .Redacted -> { body_codec_put_tag(out, 3) }
        .Unavailable -> { body_codec_put_tag(out, 4) }
        .Unsupported -> { body_codec_put_tag(out, 5) }
        .BudgetExhausted -> { body_codec_put_tag(out, 6) }
        .Unknown -> body_codec_put_tag(out, 7)
    }
}

body_codec_get_derivationdisposition: fn(bytes: [U8], input: ^BodyCodecIn) -> DerivationDisposition Never! {
    position: body_codec_get_tag(bytes, input, 8, 0)
    if position == {
        1 -> DerivationDisposition.Stale
        2 -> DerivationDisposition.Expired
        3 -> DerivationDisposition.Redacted
        4 -> DerivationDisposition.Unavailable
        5 -> DerivationDisposition.Unsupported
        6 -> DerivationDisposition.BudgetExhausted
        7 -> DerivationDisposition.Unknown
        else -> DerivationDisposition.Current
    }
}

body_codec_put_derivationobservation: fn(out: ^BodyCodecOut, value: DerivationObservation) Never! {
