    count: body_codec_get_count(bytes, input, 1)
    values := [TBinaryPatternPart]{}
    loop _ in 0..<count -> values.push(body_codec_get_tbinarypatternpart(bytes, input))
    values
}

body_codec_put_bodypatternshape: fn(out: &BodyCodecOut, value: BodyPatternShape) Never! {
    if value == {
        .Variant(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_string(out, p0)
            body_codec_put_list_bodypatternbinding(out, p1)
            body_codec_put_bool(out, p2)
            body_codec_put_span(out, p3)
        }
        .Present(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_opt_bodynestedpattern(out, p2)
            body_codec_put_span(out, p3)
        }
        .Absent(p0) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_span(out, p0)
        }
        .Ok(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 3)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_opt_bodynestedpattern(out, p2)
            body_codec_put_span(out, p3)
        }
        .Err(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 4)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
            body_codec_put_opt_bodynestedpattern(out, p2)
            body_codec_put_span(out, p3)
        }
        .Range(p0, p1, p2) -> {
            body_codec_put_tag(out, 5)
            body_codec_put_int(out, p0)
            body_codec_put_int(out, p1)
            body_codec_put_span(out, p2)
        }
        .Or(p0, p1) -> {
            body_codec_put_tag(out, 6)
            body_codec_put_list_bodypatternshape(out, p0)
            body_codec_put_span(out, p1)
        }
        .Struct(p0, p1) -> {
            body_codec_put_tag(out, 7)
            body_codec_put_list_bodypatternfield(out, p0)
            body_codec_put_span(out, p1)
        }
        .List(p0, p1, p2) -> {
            body_codec_put_tag(out, 8)
            body_codec_put_list_bodypatternbinding(out, p0)
            body_codec_put_opt_tlistpatternrest(out, p1)
            body_codec_put_span(out, p2)
        }
        .Map(p0, p1, p2) -> {
            body_codec_put_tag(out, 9)
            body_codec_put_list_bodymappatternentry(out, p0)
            body_codec_put_bool(out, p1)
            body_codec_put_span(out, p2)
        }
        .Text(p0, p1) -> {
            body_codec_put_tag(out, 10)
            body_codec_put_list_ttextpatternpart(out, p0)
            body_codec_put_span(out, p1)
        }
        .Binary(p0, p1) -> {
            body_codec_put_tag(out, 11)
            body_codec_put_list_tbinarypatternpart(out, p0)
            body_codec_put_span(out, p1)
        }
    }
}

body_codec_get_bodypatternshape: fn(bytes: [U8], input: &BodyCodecIn) -> BodyPatternShape Never! {
    position: body_codec_get_tag(bytes, input, 12, 0)
    if position == {
        1 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_opt_bodynestedpattern(bytes, input)
            f3: body_codec_get_span(bytes, input)
            BodyPatternShape.Present{binding: f0, binding_span: f1, inner: f2, span: f3}
        }
        2 -> {
            f0: body_codec_get_span(bytes, input)
            BodyPatternShape.Absent{span: f0}
        }
        3 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_opt_bodynestedpattern(bytes, input)
            f3: body_codec_get_span(bytes, input)
            BodyPatternShape.Ok{binding: f0, binding_span: f1, inner: f2, span: f3}
        }
        4 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            f2: body_codec_get_opt_bodynestedpattern(bytes, input)
            f3: body_codec_get_span(bytes, input)
            BodyPatternShape.Err{binding: f0, binding_span: f1, inner: f2, span: f3}
        }
        5 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_int(bytes, input)
            f2: body_codec_get_span(bytes, input)
            BodyPatternShape.Range{lo: f0, hi: f1, span: f2}
        }
        6 -> {
            f0: body_codec_get_list_bodypatternshape(bytes, input)
            f1: body_codec_get_span(bytes, input)
            BodyPatternShape.Or{alternatives: f0, span: f1}
        }
        7 -> {
            f0: body_codec_get_list_bodypatternfield(bytes, input)
            f1: body_codec_get_span(bytes, input)
            BodyPatternShape.Struct{fields: f0, span: f1}
        }
        8 -> {
            f0: body_codec_get_list_bodypatternbinding(bytes, input)
            f1: body_codec_get_opt_tlistpatternrest(bytes, input)
            f2: body_codec_get_span(bytes, input)
            BodyPatternShape.List{items: f0, rest: f1, span: f2}
        }
        9 -> {
            f0: body_codec_get_list_bodymappatternentry(bytes, input)
            f1: body_codec_get_bool(bytes, input)
            f2: body_codec_get_span(bytes, input)
            BodyPatternShape.Map{entries: f0, rest: f1, span: f2}
        }
        10 -> {
            f0: body_codec_get_list_ttextpatternpart(bytes, input)
            f1: body_codec_get_span(bytes, input)
            BodyPatternShape.Text{parts: f0, span: f1}
        }
        11 -> {
            f0: body_codec_get_list_tbinarypatternpart(bytes, input)
            f1: body_codec_get_span(bytes, input)
            BodyPatternShape.Binary{parts: f0, span: f1}
        }
        else -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_list_bodypatternbinding(bytes, input)
            f2: body_codec_get_bool(bytes, input)
            f3: body_codec_get_span(bytes, input)
            BodyPatternShape.Variant{variant: f0, bindings: f1, leading_dot: f2, span: f3}
        }
    }
}

body_codec_put_bodypatternbinding: fn(out: &BodyCodecOut, value: BodyPatternBinding) Never! {
    if value == {
        .Wildcard -> { body_codec_put_tag(out, 0) }
        .Bind(p0, p1) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_string(out, p0)
            body_codec_put_span(out, p1)
        }
        .Range(p0, p1) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_int(out, p0)
            body_codec_put_int(out, p1)
        }
        .Nested(p0) -> {
            body_codec_put_tag(out, 3)
            body_codec_put_bodynestedpattern(out, p0)
        }
        .Value(p0) -> {
            body_codec_put_tag(out, 4)
            body_codec_put_int(out, p0)
        }
    }
}

body_codec_get_bodypatternbinding: fn(bytes: [U8], input: &BodyCodecIn) -> BodyPatternBinding Never! {
    position: body_codec_get_tag(bytes, input, 5, 0)
    if position == {
        1 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            BodyPatternBinding.Bind{name: f0, span: f1}
        }
        2 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_int(bytes, input)
            BodyPatternBinding.Range{lo: f0, hi: f1}
        }
        3 -> {
            f0: body_codec_get_bodynestedpattern(bytes, input)
            BodyPatternBinding.Nested{pattern: f0}
        }
        4 -> {
            f0: body_codec_get_int(bytes, input)
            BodyPatternBinding.Value{value: f0}
        }
        else -> BodyPatternBinding.Wildcard
    }
}

body_codec_put_bodynestedpattern: fn(out: &BodyCodecOut, value: BodyNestedPattern) Never! {
    body_codec_put_bodypatternshape(out, value.shape)
    body_codec_put_opt_symbolid(out, value.enum_type)
}

body_codec_get_bodynestedpattern: fn(bytes: [U8], input: &BodyCodecIn) -> BodyNestedPattern Never! {
    f0: body_codec_get_bodypatternshape(bytes, input)
    f1: body_codec_get_opt_symbolid(bytes, input)
    BodyNestedPattern{shape: f0, enum_type: f1}
}

body_codec_put_bodypatternfield: fn(out: &BodyCodecOut, value: BodyPatternField) Never! {
    if value == {
        .Bind(p0, p1, p2) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_string(out, p0)
            body_codec_put_string(out, p1)
            body_codec_put_span(out, p2)
        }
        .Value(p0, p1, p2) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_string(out, p0)
            body_codec_put_int(out, p1)
            body_codec_put_span(out, p2)
        }
        .Nested(p0, p1, p2) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_string(out, p0)
            body_codec_put_bodynestedpattern(out, p1)
            body_codec_put_span(out, p2)
        }
    }
}

body_codec_get_bodypatternfield: fn(bytes: [U8], input: &BodyCodecIn) -> BodyPatternField Never! {
    position: body_codec_get_tag(bytes, input, 3, 0)
    if position == {
        1 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_int(bytes, input)
            f2: body_codec_get_span(bytes, input)
            BodyPatternField.Value{field: f0, value: f1, span: f2}
        }
        2 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_bodynestedpattern(bytes, input)
            f2: body_codec_get_span(bytes, input)
            BodyPatternField.Nested{field: f0, pattern: f1, span: f2}
        }
        else -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_string(bytes, input)
            f2: body_codec_get_span(bytes, input)
            BodyPatternField.Bind{field: f0, local: f1, span: f2}
        }
    }
}

body_codec_put_tlistpatternrest: fn(out: &BodyCodecOut, value: TListPatternRest) Never! {
    body_codec_put_opt_string(out, value.name)
    body_codec_put_span(out, value.span)
}

body_codec_get_tlistpatternrest: fn(bytes: [U8], input: &BodyCodecIn) -> TListPatternRest Never! {
    f0: body_codec_get_opt_string(bytes, input)
    f1: body_codec_get_span(bytes, input)
    TListPatternRest{name: f0, span: f1}
}

body_codec_put_bodymappatternentry: fn(out: &BodyCodecOut, value: BodyMapPatternEntry) Never! {
    body_codec_put_int(out, value.key)
    body_codec_put_bool(out, value.optional)
    body_codec_put_bodypatternbinding(out, value.slot)
    body_codec_put_span(out, value.span)
}

body_codec_get_bodymappatternentry: fn(bytes: [U8], input: &BodyCodecIn) -> BodyMapPatternEntry Never! {
    f0: body_codec_get_int(bytes, input)
    f1: body_codec_get_bool(bytes, input)
    f2: body_codec_get_bodypatternbinding(bytes, input)
    f3: body_codec_get_span(bytes, input)
    BodyMapPatternEntry{key: f0, optional: f1, slot: f2, span: f3}
}

body_codec_put_ttextpatternpart: fn(out: &BodyCodecOut, value: TTextPatternPart) Never! {
    if value == {
        .Literal(p0) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_string(out, p0)
        }
        .Hole(p0, p1, p2) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_string(out, p0)
            body_codec_put_type(out, p1)
            body_codec_put_span(out, p2)
        }
    }
}

body_codec_get_ttextpatternpart: fn(bytes: [U8], input: &BodyCodecIn) -> TTextPatternPart Never! {
    position: body_codec_get_tag(bytes, input, 2, 0)
    if position == {
        1 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_type(bytes, input)
            f2: body_codec_get_span(bytes, input)
            TTextPatternPart.Hole{name: f0, ty: f1, span: f2}
        }
        else -> {
            f0: body_codec_get_string(bytes, input)
            TTextPatternPart.Literal{value: f0}
        }
    }
}

body_codec_put_tbinarypatternpart: fn(out: &BodyCodecOut, value: TBinaryPatternPart) Never! {
    if value == {
        .Literal(p0) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_list_u8(out, p0)
        }
        .Bits(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_string(out, p0)
            body_codec_put_int(out, p1)
            body_codec_put_bool(out, p2)
            body_codec_put_type(out, p3)
            body_codec_put_span(out, p4)
        }
        .Rest(p0, p1, p2) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_string(out, p0)
            body_codec_put_type(out, p1)
            body_codec_put_span(out, p2)
        }
    }
}

body_codec_get_tbinarypatternpart: fn(bytes: [U8], input: &BodyCodecIn) -> TBinaryPatternPart Never! {
    position: body_codec_get_tag(bytes, input, 3, 0)
    if position == {
        1 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_int(bytes, input)
            f2: body_codec_get_bool(bytes, input)
            f3: body_codec_get_type(bytes, input)
            f4: body_codec_get_span(bytes, input)
            TBinaryPatternPart.Bits{name: f0, width: f1, big_endian: f2, ty: f3, span: f4}
        }
        2 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_type(bytes, input)
            f2: body_codec_get_span(bytes, input)
            TBinaryPatternPart.Rest{name: f0, ty: f1, span: f2}
        }
        else -> {
            f0: body_codec_get_list_u8(bytes, input)
            TBinaryPatternPart.Literal{value: f0}
        }
    }
}

body_codec_put_tpatternbindingfact: fn(out: &BodyCodecOut, value: TPatternBindingFact) Never! {
    body_codec_put_string(out, value.name)
    body_codec_put_span(out, value.span)
    body_codec_put_type(out, value.ty)
    body_codec_put_bool(out, value.mutable)
    body_codec_put_opt_symbolid(out, value.symbol_id)
}

body_codec_get_tpatternbindingfact: fn(bytes: [U8], input: &BodyCodecIn) -> TPatternBindingFact Never! {
    f0: body_codec_get_string(bytes, input)
    f1: body_codec_get_span(bytes, input)
    f2: body_codec_get_type(bytes, input)
    f3: body_codec_get_bool(bytes, input)
    f4: body_codec_get_opt_symbolid(bytes, input)
    TPatternBindingFact{name: f0, span: f1, ty: f2, mutable: f3, symbol_id: f4}
}

body_codec_put_tpatternposition: fn(out: &BodyCodecOut, value: TPatternPosition) Never! {
    if value == {
        .Binding -> { body_codec_put_tag(out, 0) }
        .Arm -> body_codec_put_tag(out, 1)
    }
}

body_codec_get_tpatternposition: fn(bytes: [U8], input: &BodyCodecIn) -> TPatternPosition Never! {
    position: body_codec_get_tag(bytes, input, 2, 0)
    if position == {
        1 -> TPatternPosition.Arm
        else -> TPatternPosition.Binding
    }
}

body_codec_put_bodyorfallback: fn(out: &BodyCodecOut, value: BodyOrFallback) Never! {
    if value == {
        .Value(p0) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_int(out, p0)
        }
        .Return(p0) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_opt_int(out, p0)
        }
        .Panic(p0, p1) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_int(out, p0)
            body_codec_put_tpanicloc(out, p1)
        }
        .Break -> { body_codec_put_tag(out, 3) }
        .Continue -> { body_codec_put_tag(out, 4) }
        .BreakLabel(p0) -> {
            body_codec_put_tag(out, 5)
            body_codec_put_string(out, p0)
        }
        .ContinueLabel(p0) -> {
            body_codec_put_tag(out, 6)
            body_codec_put_string(out, p0)
        }
    }
}

body_codec_get_bodyorfallback: fn(bytes: [U8], input: &BodyCodecIn) -> BodyOrFallback Never! {
    position: body_codec_get_tag(bytes, input, 7, 3)
    if position == {
        0 -> {
            f0: body_codec_get_int(bytes, input)
            BodyOrFallback.Value{value: f0}
        }
        1 -> {
            f0: body_codec_get_opt_int(bytes, input)
            BodyOrFallback.Return{value: f0}
        }
        2 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_tpanicloc(bytes, input)
            BodyOrFallback.Panic{message: f0, location: f1}
        }
        4 -> BodyOrFallback.Continue
        5 -> {
            f0: body_codec_get_string(bytes, input)
            BodyOrFallback.BreakLabel{label: f0}
        }
        6 -> {
            f0: body_codec_get_string(bytes, input)
            BodyOrFallback.ContinueLabel{label: f0}
        }
        else -> BodyOrFallback.Break
    }
}

body_codec_put_tclosureop: fn(out: &BodyCodecOut, value: TClosureOp) Never! {
    if value == {
        .EditDisjoint -> { body_codec_put_tag(out, 0) }
        .Map -> { body_codec_put_tag(out, 1) }
        .MapMut -> { body_codec_put_tag(out, 2) }
        .TryMap -> { body_codec_put_tag(out, 3) }
        .Filter -> { body_codec_put_tag(out, 4) }
        .TryFilter -> { body_codec_put_tag(out, 5) }
        .Each -> { body_codec_put_tag(out, 6) }
        .EachMut -> { body_codec_put_tag(out, 7) }
        .TryEach -> { body_codec_put_tag(out, 8) }
        .EachMap -> { body_codec_put_tag(out, 9) }
        .MapAny -> { body_codec_put_tag(out, 10) }
        .MapAll -> { body_codec_put_tag(out, 11) }
        .MapFilter -> { body_codec_put_tag(out, 12) }
        .MapMap -> { body_codec_put_tag(out, 13) }
        .MapFold -> { body_codec_put_tag(out, 14) }
        .MapFlatMap -> { body_codec_put_tag(out, 15) }
        .ListBinarySearchBy -> { body_codec_put_tag(out, 16) }
        .ListMinMaxBy -> { body_codec_put_tag(out, 17) }
        .Find -> { body_codec_put_tag(out, 18) }
        .Any -> { body_codec_put_tag(out, 19) }
        .BagAny -> { body_codec_put_tag(out, 20) }
        .All -> { body_codec_put_tag(out, 21) }
        .CountWhere -> { body_codec_put_tag(out, 22) }
        .SortBy -> { body_codec_put_tag(out, 23) }
        .SortByDesc -> { body_codec_put_tag(out, 24) }
        .TrySortBy -> { body_codec_put_tag(out, 25) }
        .TrySortByDesc -> { body_codec_put_tag(out, 26) }
        .SortByCompare -> { body_codec_put_tag(out, 27) }
        .Reduce -> { body_codec_put_tag(out, 28) }
        .TakeWhile -> { body_codec_put_tag(out, 29) }
        .SkipWhile -> { body_codec_put_tag(out, 30) }
        .FlatMap -> { body_codec_put_tag(out, 31) }
        .Scan -> { body_codec_put_tag(out, 32) }
        .Position -> { body_codec_put_tag(out, 33) }
        .MinBy -> { body_codec_put_tag(out, 34) }
        .MaxBy -> { body_codec_put_tag(out, 35) }
        .Fold -> { body_codec_put_tag(out, 36) }
        .GroupBy -> { body_codec_put_tag(out, 37) }
        .CountBy -> { body_codec_put_tag(out, 38) }
        .UpdateFirst -> { body_codec_put_tag(out, 39) }
        .Partition -> { body_codec_put_tag(out, 40) }
        .DedupBy -> { body_codec_put_tag(out, 41) }
        .IsSortedBy -> { body_codec_put_tag(out, 42) }
        .ChunkWhile -> { body_codec_put_tag(out, 43) }
        .FilterMap -> { body_codec_put_tag(out, 44) }
        .ParaMap -> { body_codec_put_tag(out, 45) }
        .ParaFilter -> { body_codec_put_tag(out, 46) }
        .ParaPartition -> { body_codec_put_tag(out, 47) }
        .ParaFold -> { body_codec_put_tag(out, 48) }
        .OptionMap -> { body_codec_put_tag(out, 49) }
        .ViewFold -> { body_codec_put_tag(out, 50) }
        .ViewMap -> body_codec_put_tag(out, 51)
    }
}

body_codec_get_tclosureop: fn(bytes: [U8], input: &BodyCodecIn) -> TClosureOp Never! {
    position: body_codec_get_tag(bytes, input, 52, 0)
    if position == {
        1 -> TClosureOp.Map
        2 -> TClosureOp.MapMut
        3 -> TClosureOp.TryMap
        4 -> TClosureOp.Filter
        5 -> TClosureOp.TryFilter
        6 -> TClosureOp.Each
        7 -> TClosureOp.EachMut
        8 -> TClosureOp.TryEach
        9 -> TClosureOp.EachMap
        10 -> TClosureOp.MapAny
        11 -> TClosureOp.MapAll
        12 -> TClosureOp.MapFilter
        13 -> TClosureOp.MapMap
        14 -> TClosureOp.MapFold
        15 -> TClosureOp.MapFlatMap
        16 -> TClosureOp.ListBinarySearchBy
        17 -> TClosureOp.ListMinMaxBy
        18 -> TClosureOp.Find
        19 -> TClosureOp.Any
        20 -> TClosureOp.BagAny
        21 -> TClosureOp.All
        22 -> TClosureOp.CountWhere
        23 -> TClosureOp.SortBy
        24 -> TClosureOp.SortByDesc
        25 -> TClosureOp.TrySortBy
        26 -> TClosureOp.TrySortByDesc
        27 -> TClosureOp.SortByCompare
        28 -> TClosureOp.Reduce
        29 -> TClosureOp.TakeWhile
        30 -> TClosureOp.SkipWhile
        31 -> TClosureOp.FlatMap
        32 -> TClosureOp.Scan
        33 -> TClosureOp.Position
        34 -> TClosureOp.MinBy
        35 -> TClosureOp.MaxBy
        36 -> TClosureOp.Fold
        37 -> TClosureOp.GroupBy
        38 -> TClosureOp.CountBy
        39 -> TClosureOp.UpdateFirst
        40 -> TClosureOp.Partition
        41 -> TClosureOp.DedupBy
        42 -> TClosureOp.IsSortedBy
        43 -> TClosureOp.ChunkWhile
        44 -> TClosureOp.FilterMap
        45 -> TClosureOp.ParaMap
        46 -> TClosureOp.ParaFilter
        47 -> TClosureOp.ParaPartition
        48 -> TClosureOp.ParaFold
        49 -> TClosureOp.OptionMap
        50 -> TClosureOp.ViewFold
        51 -> TClosureOp.ViewMap
        else -> TClosureOp.EditDisjoint
    }
}

body_codec_put_list_strmatchpart: fn(out: &BodyCodecOut, values: [StrMatchPart]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_strmatchpart(out, value)
}

body_codec_get_list_strmatchpart: fn(bytes: [U8], input: &BodyCodecIn) -> [StrMatchPart] Never! {
    count: body_codec_get_count(bytes, input, 1)
    values := [StrMatchPart]{}
    loop _ in 0..<count -> values.push(body_codec_get_strmatchpart(bytes, input))
    values
}

body_codec_put_list_tcanonicalfield: fn(out: &BodyCodecOut, values: [TCanonicalField]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_tcanonicalfield(out, value)
}

body_codec_get_list_tcanonicalfield: fn(bytes: [U8], input: &BodyCodecIn) -> [TCanonicalField] Never! {
    count: body_codec_get_count(bytes, input, 1)
    values := [TCanonicalField]{}
    loop _ in 0..<count -> values.push(body_codec_get_tcanonicalfield(bytes, input))
    values
}

body_codec_put_list_binmatchpart: fn(out: &BodyCodecOut, values: [BinMatchPart]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_binmatchpart(out, value)
}

body_codec_get_list_binmatchpart: fn(bytes: [U8], input: &BodyCodecIn) -> [BinMatchPart] Never! {
    count: body_codec_get_count(bytes, input, 1)
    values := [BinMatchPart]{}
    loop _ in 0..<count -> values.push(body_codec_get_binmatchpart(bytes, input))
    values
}

