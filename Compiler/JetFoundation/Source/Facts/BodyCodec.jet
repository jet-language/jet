        }
        .DistinctRaw(p0) -> {
            body_codec_put_tag(out, 73)
            body_codec_put_int(out, p0)
        }
        .Present(p0) -> {
            body_codec_put_tag(out, 74)
            body_codec_put_int(out, p0)
        }
        .Absent -> { body_codec_put_tag(out, 75) }
        .Ok(p0) -> {
            body_codec_put_tag(out, 76)
            body_codec_put_int(out, p0)
        }
        .Err(p0) -> {
            body_codec_put_tag(out, 77)
            body_codec_put_int(out, p0)
        }
        .OrFallback(p0, p1, p2) -> {
