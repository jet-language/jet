    None
}

body_codec_put_bodyrequirekind: fn(out: &BodyCodecOut, value: BodyRequireKind) Never! {
    if value == {
        .Require(p0, p1) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_int(out, p0)
            body_codec_put_opt_int(out, p1)
        }
        .RequireEq(p0, p1, p2) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_int(out, p0)
            body_codec_put_int(out, p1)
            body_codec_put_opt_tmethodref(out, p2)
        }
        .Panic(p0) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_int(out, p0)
        }
    }
}

body_codec_get_bodyrequirekind: fn(bytes: [U8], input: &BodyCodecIn) -> BodyRequireKind Never! {
    position: body_codec_get_tag(bytes, input, 3, 0)
    if position == {
        1 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_int(bytes, input)
            f2: body_codec_get_opt_tmethodref(bytes, input)
            BodyRequireKind.RequireEq{left: f0, right: f1, hook: f2}
        }
        2 -> {
            f0: body_codec_get_int(bytes, input)
            BodyRequireKind.Panic{msg: f0}
        }
        else -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_opt_int(bytes, input)
            BodyRequireKind.Require{cond: f0, msg: f1}
        }
    }
}

body_codec_put_list_tpaniclocal: fn(out: &BodyCodecOut, values: [TPanicLocal]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_tpaniclocal(out, value)
}

body_codec_get_list_tpaniclocal: fn(bytes: [U8], input: &BodyCodecIn) -> [TPanicLocal] Never! {
    count: body_codec_get_count(bytes, input, 1)
    values := [TPanicLocal]{}
    loop _ in 0..<count -> values.push(body_codec_get_tpaniclocal(bytes, input))
    values
}

body_codec_put_tpanicloc: fn(out: &BodyCodecOut, value: TPanicLoc) Never! {
    body_codec_put_string(out, value.file)
    body_codec_put_string(out, value.source_line)
    body_codec_put_int(out, value.line)
    body_codec_put_int(out, value.column)
    body_codec_put_int(out, value.caret)
    body_codec_put_string(out, value.function)
    body_codec_put_list_tpaniclocal(out, value.locals)
}

body_codec_get_tpanicloc: fn(bytes: [U8], input: &BodyCodecIn) -> TPanicLoc Never! {
    f0: body_codec_get_string(bytes, input)
    f1: body_codec_get_string(bytes, input)
    f2: body_codec_get_int(bytes, input)
    f3: body_codec_get_int(bytes, input)
    f4: body_codec_get_int(bytes, input)
    f5: body_codec_get_string(bytes, input)
    f6: body_codec_get_list_tpaniclocal(bytes, input)
    TPanicLoc{file: f0, source_line: f1, line: f2, column: f3, caret: f4, function: f5, locals: f6}
}

body_codec_put_tpaniclocal: fn(out: &BodyCodecOut, value: TPanicLocal) Never! {
    body_codec_put_string(out, value.display_name)
    body_codec_put_tlocal(out, value.local)
