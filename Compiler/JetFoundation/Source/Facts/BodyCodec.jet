body_codec_put_span: fn(out: ^BodyCodecOut, value: Span) Never! {
    body_codec_put_int(out, value.start)
    body_codec_put_int(out, value.end)
}

body_codec_get_span: fn(bytes: [U8], input: ^BodyCodecIn) -> Span Never! {
    f0: body_codec_get_int(bytes, input)
    f1: body_codec_get_int(bytes, input)
    Span{start: f0, end: f1}
}

body_codec_put_tfailurecarrier: fn(out: ^BodyCodecOut, value: TFailureCarrier) Never! {
    if value == {
        .Infallible -> { body_codec_put_tag(out, 0) }
        .Result(p0, p1) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_type(out, p0)
            body_codec_put_type(out, p1)
        }
        .Optional(p0) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_type(out, p0)
        }
        .Diverges(p0) -> {
            body_codec_put_tag(out, 3)
            body_codec_put_type(out, p0)
        }
    }
}

body_codec_get_tfailurecarrier: fn(bytes: [U8], input: ^BodyCodecIn) -> TFailureCarrier Never! {
    position: body_codec_get_tag(bytes, input, 4, 0)
    if position == {
        1 -> {
            f0: body_codec_get_type(bytes, input)
            f1: body_codec_get_type(bytes, input)
            TFailureCarrier.Result{success: f0, error: f1}
        }
        2 -> {
            f0: body_codec_get_type(bytes, input)
            TFailureCarrier.Optional{value: f0}
        }
        3 -> {
            f0: body_codec_get_type(bytes, input)
            TFailureCarrier.Diverges{value: f0}
        }
        else -> TFailureCarrier.Infallible
    }
}

