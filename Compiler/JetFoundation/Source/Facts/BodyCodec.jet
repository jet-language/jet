            f0: body_codec_get_string(bytes, input)
            FrameCompletion.Pending{token: f0}
        }
        2 -> {
            f0: body_codec_get_string(bytes, input)
            FrameCompletion.Event{token: f0}
        }
        else -> FrameCompletion.Synchronous
    }
}

