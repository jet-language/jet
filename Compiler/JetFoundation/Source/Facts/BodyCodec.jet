}

body_codec_put_resourceidentity: fn(out: ^BodyCodecOut, value: ResourceIdentity) Never! {
    if value == {
        .Named(p0) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_string(out, p0)
        }
        .Unknown -> body_codec_put_tag(out, 1)
    }
}

body_codec_get_resourceidentity: fn(bytes: [U8], input: ^BodyCodecIn) -> ResourceIdentity Never! {
    position: body_codec_get_tag(bytes, input, 2, 1)
    if position == {
        0 -> {
            f0: body_codec_get_string(bytes, input)
            ResourceIdentity.Named{name: f0}
        }
        else -> ResourceIdentity.Unknown
    }
}

body_codec_put_resourceregion: fn(out: ^BodyCodecOut, value: ResourceRegion) Never! {
    if value == {
        .Whole -> { body_codec_put_tag(out, 0) }
        .Bytes(p0, p1) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_int(out, p0)
            body_codec_put_int(out, p1)
        }
        .Unknown -> body_codec_put_tag(out, 2)
    }
}

body_codec_get_resourceregion: fn(bytes: [U8], input: ^BodyCodecIn) -> ResourceRegion Never! {
    position: body_codec_get_tag(bytes, input, 3, 0)
    if position == {
        1 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_int(bytes, input)
            ResourceRegion.Bytes{start: f0, length: f1}
        }
        2 -> ResourceRegion.Unknown
        else -> ResourceRegion.Whole
    }
}

