body_codec_put_stmtkind: fn(out: ^BodyCodecOut, value: StmtKind) Never! {
    if value == {
        .Contract(p0) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_bodycontract(out, p0)
        }
        .ContractScope(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_list_bodycontract(out, p0)
            body_codec_put_list_int(out, p1)
            body_codec_put_list_bodycontract(out, p2)
            body_codec_put_tcontractresult(out, p3)
            body_codec_put_span(out, p4)
        }
        .Let(p0, p1, p2, p3, p4, p5) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_tlocal(out, p0)
            body_codec_put_tletty(out, p1)
            body_codec_put_int(out, p2)
            body_codec_put_opt_tgcpromotion(out, p3)
            body_codec_put_bool(out, p4)
            body_codec_put_span(out, p5)
        }
        .RefutableBind(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 3)
            body_codec_put_bodypattern(out, p0)
            body_codec_put_int(out, p1)
            body_codec_put_list_int(out, p2)
            body_codec_put_span(out, p3)
        }
        .TupleDestructure(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 4)
            body_codec_put_tlocal(out, p0)
            body_codec_put_int(out, p1)
            body_codec_put_bool(out, p2)
            body_codec_put_list_tdestructurebinding(out, p3)
            body_codec_put_span(out, p4)
        }
        .StructDestructure(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 5)
            body_codec_put_tlocal(out, p0)
            body_codec_put_int(out, p1)
            body_codec_put_bool(out, p2)
            body_codec_put_list_tdestructurebinding(out, p3)
            body_codec_put_span(out, p4)
        }
        .ListDestructure(p0, p1, p2, p3, p4, p5) -> {
            body_codec_put_tag(out, 6)
            body_codec_put_tlocal(out, p0)
            body_codec_put_int(out, p1)
            body_codec_put_int(out, p2)
            body_codec_put_int(out, p3)
            body_codec_put_list_tlocal(out, p4)
            body_codec_put_span(out, p5)
        }
        .Assign(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 7)
            body_codec_put_bodyplace(out, p0)
            body_codec_put_opt_binop(out, p1)
            body_codec_put_int(out, p2)
            body_codec_put_int(out, p3)
            body_codec_put_span(out, p4)
        }
        .CountedLoop(p0, p1, p2, p3, p4, p5, p6) -> {
            body_codec_put_tag(out, 8)
            body_codec_put_opt_string(out, p0)
            body_codec_put_int(out, p1)
            body_codec_put_int(out, p2)
            body_codec_put_opt_int(out, p3)
            body_codec_put_opt_autovectorizationfacts(out, p4)
            body_codec_put_list_int(out, p5)
            body_codec_put_span(out, p6)
        }
        .ForRange(p0, p1, p2, p3, p4, p5, p6, p7, p8) -> {
            body_codec_put_tag(out, 9)
            body_codec_put_opt_string(out, p0)
            body_codec_put_tlocal(out, p1)
            body_codec_put_int(out, p2)
            body_codec_put_int(out, p3)
            body_codec_put_opt_int(out, p4)
            body_codec_put_bool(out, p5)
            body_codec_put_list_int(out, p6)
            body_codec_put_opt_autovectorizationfacts(out, p7)
            body_codec_put_span(out, p8)
        }
        .Range(p0, p1, p2, p3, p4, p5, p6, p7, p8, p9) -> {
            body_codec_put_tag(out, 10)
            body_codec_put_opt_string(out, p0)
            body_codec_put_tlocal(out, p1)
            body_codec_put_opt_int(out, p2)
            body_codec_put_int(out, p3)
            body_codec_put_int(out, p4)
            body_codec_put_opt_int(out, p5)
            body_codec_put_bool(out, p6)
            body_codec_put_opt_autovectorizationfacts(out, p7)
            body_codec_put_list_int(out, p8)
            body_codec_put_span(out, p9)
        }
        .ExprStmt(p0, p1) -> {
            body_codec_put_tag(out, 11)
            body_codec_put_int(out, p0)
            body_codec_put_span(out, p1)
        }
        .Return(p0, p1) -> {
            body_codec_put_tag(out, 12)
            body_codec_put_opt_int(out, p0)
            body_codec_put_span(out, p1)
        }
        .TaskGroup(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 13)
            body_codec_put_tlocal(out, p0)
            body_codec_put_bodytaskgroupargs(out, p1)
            body_codec_put_list_int(out, p2)
            body_codec_put_span(out, p3)
        }
        .DeferClose(p0, p1, p2) -> {
            body_codec_put_tag(out, 14)
            body_codec_put_int(out, p0)
            body_codec_put_symbolid(out, p1)
            body_codec_put_span(out, p2)
        }
        .If(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 15)
            body_codec_put_bodyifcond(out, p0)
            body_codec_put_list_int(out, p1)
            body_codec_put_opt_list_int(out, p2)
            body_codec_put_bool(out, p3)
            body_codec_put_span(out, p4)
        }
        .Loop(p0, p1, p2) -> {
            body_codec_put_tag(out, 16)
            body_codec_put_opt_string(out, p0)
            body_codec_put_list_int(out, p1)
            body_codec_put_span(out, p2)
        }
        .While(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 17)
            body_codec_put_opt_string(out, p0)
            body_codec_put_int(out, p1)
            body_codec_put_list_int(out, p2)
            body_codec_put_span(out, p3)
        }
        .Break(p0, p1) -> {
            body_codec_put_tag(out, 18)
            body_codec_put_opt_string(out, p0)
            body_codec_put_span(out, p1)
        }
        .BreakValue(p0, p1, p2) -> {
            body_codec_put_tag(out, 19)
            body_codec_put_opt_string(out, p0)
            body_codec_put_int(out, p1)
            body_codec_put_span(out, p2)
        }
        .Continue(p0, p1) -> {
            body_codec_put_tag(out, 20)
            body_codec_put_opt_string(out, p0)
            body_codec_put_span(out, p1)
        }
        .Match(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 21)
            body_codec_put_int(out, p0)
            body_codec_put_list_bodymatcharm(out, p1)
            body_codec_put_bool(out, p2)
            body_codec_put_span(out, p3)
        }
        .EnumMatch(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 22)
            body_codec_put_int(out, p0)
            body_codec_put_list_bodymatcharm(out, p1)
            body_codec_put_opt_list_int(out, p2)
            body_codec_put_bool(out, p3)
            body_codec_put_span(out, p4)
        }
        .RangeSwitch(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 23)
            body_codec_put_int(out, p0)
            body_codec_put_list_bodyrangearm(out, p1)
            body_codec_put_list_int(out, p2)
            body_codec_put_span(out, p3)
        }
        .ForIn(p0, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11) -> {
            body_codec_put_tag(out, 24)
            body_codec_put_opt_string(out, p0)
            body_codec_put_tlocal(out, p1)
            body_codec_put_opt_tlocal(out, p2)
            body_codec_put_int(out, p3)
            body_codec_put_int(out, p4)
            body_codec_put_opt_int(out, p5)
            body_codec_put_opt_tforinmethod(out, p6)
            body_codec_put_bool(out, p7)
            body_codec_put_bool(out, p8)
            body_codec_put_bool(out, p9)
            body_codec_put_list_int(out, p10)
            body_codec_put_span(out, p11)
        }
        .Inline(p0, p1) -> {
            body_codec_put_tag(out, 25)
            body_codec_put_list_int(out, p0)
            body_codec_put_span(out, p1)
        }
        .DebugOnly(p0, p1) -> {
            body_codec_put_tag(out, 26)
            body_codec_put_list_int(out, p0)
            body_codec_put_span(out, p1)
        }
        .DeepCheck(p0, p1) -> {
            body_codec_put_tag(out, 27)
            body_codec_put_list_int(out, p0)
            body_codec_put_span(out, p1)
        }
        .MixedSwitch(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 28)
            body_codec_put_int(out, p0)
            body_codec_put_tbranchclass(out, p1)
            body_codec_put_list_bodymixedarm(out, p2)
            body_codec_put_opt_list_int(out, p3)
            body_codec_put_span(out, p4)
        }
        .Unsafe(p0, p1) -> {
            body_codec_put_tag(out, 29)
            body_codec_put_tunsafegate(out, p0)
            body_codec_put_list_int(out, p1)
        }
        .UnsafeBlock(p0, p1, p2) -> {
            body_codec_put_tag(out, 30)
            body_codec_put_tunsafegate(out, p0)
            body_codec_put_list_int(out, p1)
            body_codec_put_span(out, p2)
        }
        .SentryPolicy(p0, p1, p2) -> {
            body_codec_put_tag(out, 31)
            body_codec_put_bool(out, p0)
            body_codec_put_list_int(out, p1)
            body_codec_put_span(out, p2)
        }
        .Impure(p0, p1) -> {
            body_codec_put_tag(out, 32)
            body_codec_put_list_int(out, p0)
            body_codec_put_span(out, p1)
        }
        .Reactive(p0, p1) -> {
            body_codec_put_tag(out, 33)
            body_codec_put_bodylambda(out, p0)
            body_codec_put_span(out, p1)
        }
        .Region(p0, p1) -> {
            body_codec_put_tag(out, 34)
            body_codec_put_list_int(out, p0)
            body_codec_put_span(out, p1)
        }
        .Layout(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 35)
            body_codec_put_tlocal(out, p0)
            body_codec_put_string(out, p1)
            body_codec_put_list_int(out, p2)
            body_codec_put_span(out, p3)
        }
        .ContextBlock(p0, p1, p2) -> {
            body_codec_put_tag(out, 36)
            body_codec_put_list_bodycontextguard(out, p0)
            body_codec_put_list_int(out, p1)
            body_codec_put_span(out, p2)
        }
        .Live(p0, p1) -> {
            body_codec_put_tag(out, 37)
            body_codec_put_list_int(out, p0)
            body_codec_put_span(out, p1)
        }
        .Shield(p0, p1) -> {
            body_codec_put_tag(out, 38)
            body_codec_put_list_int(out, p0)
            body_codec_put_span(out, p1)
        }
        .Defer(p0, p1) -> {
            body_codec_put_tag(out, 39)
            body_codec_put_list_int(out, p0)
            body_codec_put_span(out, p1)
        }
        .ScopeMember(p0, p1, p2) -> {
            body_codec_put_tag(out, 40)
            body_codec_put_bodyscopememberkind(out, p0)
            body_codec_put_list_int(out, p1)
            body_codec_put_span(out, p2)
        }
        .Transact(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 41)
            body_codec_put_opt_tlocal(out, p0)
            body_codec_put_list_ttransactionsnapshot(out, p1)
            body_codec_put_opt_tlocal(out, p2)
            body_codec_put_list_int(out, p3)
            body_codec_put_span(out, p4)
        }
        .GCEdit(p0, p1, p2, p3, p4, p5, p6) -> {
            body_codec_put_tag(out, 42)
            body_codec_put_string(out, p0)
            body_codec_put_string(out, p1)
            body_codec_put_list_string(out, p2)
            body_codec_put_bool(out, p3)
            body_codec_put_opt_int(out, p4)
            body_codec_put_int(out, p5)
            body_codec_put_span(out, p6)
        }
    }
}

body_codec_get_stmtkind: fn(bytes: [U8], input: ^BodyCodecIn) -> StmtKind Never! {
    position: body_codec_get_tag(bytes, input, 43, 4)
    if position == {
        0 -> {
            f0: body_codec_get_bodycontract(bytes, input)
            StmtKind.Contract{contract: f0}
        }
        1 -> {
            f0: body_codec_get_list_bodycontract(bytes, input)
            f1: body_codec_get_list_int(bytes, input)
            f2: body_codec_get_list_bodycontract(bytes, input)
            f3: body_codec_get_tcontractresult(bytes, input)
            f4: body_codec_get_span(bytes, input)
            StmtKind.ContractScope{pre: f0, body: f1, post: f2, result: f3, span: f4}
        }
        2 -> {
            f0: body_codec_get_tlocal(bytes, input)
            f1: body_codec_get_tletty(bytes, input)
            f2: body_codec_get_int(bytes, input)
            f3: body_codec_get_opt_tgcpromotion(bytes, input)
            f4: body_codec_get_bool(bytes, input)
            f5: body_codec_get_span(bytes, input)
            StmtKind.Let{local: f0, let_ty: f1, init: f2, gc_promotion: f3, gc_transferred: f4, span: f5}
        }
        3 -> {
            f0: body_codec_get_bodypattern(bytes, input)
            f1: body_codec_get_int(bytes, input)
            f2: body_codec_get_list_int(bytes, input)
            f3: body_codec_get_span(bytes, input)
            StmtKind.RefutableBind{pattern: f0, init: f1, fallback: f2, span: f3}
        }
        5 -> {
            f0: body_codec_get_tlocal(bytes, input)
            f1: body_codec_get_int(bytes, input)
            f2: body_codec_get_bool(bytes, input)
            f3: body_codec_get_list_tdestructurebinding(bytes, input)
            f4: body_codec_get_span(bytes, input)
            StmtKind.StructDestructure{temp: f0, init: f1, move_fields: f2, binds: f3, span: f4}
        }
        6 -> {
            f0: body_codec_get_tlocal(bytes, input)
            f1: body_codec_get_int(bytes, input)
            f2: body_codec_get_int(bytes, input)
            f3: body_codec_get_int(bytes, input)
            f4: body_codec_get_list_tlocal(bytes, input)
            f5: body_codec_get_span(bytes, input)
            StmtKind.ListDestructure{temp: f0, init: f1, count: f2, line: f3, elements: f4, span: f5}
        }
        7 -> {
            f0: body_codec_get_bodyplace(bytes, input)
            f1: body_codec_get_opt_binop(bytes, input)
            f2: body_codec_get_int(bytes, input)
            f3: body_codec_get_int(bytes, input)
            f4: body_codec_get_span(bytes, input)
            StmtKind.Assign{place: f0, op: f1, value: f2, line: f3, span: f4}
        }
        8 -> {
            f0: body_codec_get_opt_string(bytes, input)
            f1: body_codec_get_int(bytes, input)
            f2: body_codec_get_int(bytes, input)
            f3: body_codec_get_opt_int(bytes, input)
            f4: body_codec_get_opt_autovectorizationfacts(bytes, input)
            f5: body_codec_get_list_int(bytes, input)
            f6: body_codec_get_span(bytes, input)
            StmtKind.CountedLoop{label: f0, init: f1, condition: f2, step: f3, vectorization: f4, body: f5, span: f6}
        }
        9 -> {
            f0: body_codec_get_opt_string(bytes, input)
            f1: body_codec_get_tlocal(bytes, input)
            f2: body_codec_get_int(bytes, input)
            f3: body_codec_get_int(bytes, input)
            f4: body_codec_get_opt_int(bytes, input)
            f5: body_codec_get_bool(bytes, input)
            f6: body_codec_get_list_int(bytes, input)
            f7: body_codec_get_opt_autovectorizationfacts(bytes, input)
            f8: body_codec_get_span(bytes, input)
            StmtKind.ForRange{label: f0, local: f1, start: f2, end: f3, step: f4, exclusive: f5, body: f6, vectorization: f7, span: f8}
        }
        10 -> {
            f0: body_codec_get_opt_string(bytes, input)
            f1: body_codec_get_tlocal(bytes, input)
            f2: body_codec_get_opt_int(bytes, input)
            f3: body_codec_get_int(bytes, input)
            f4: body_codec_get_int(bytes, input)
            f5: body_codec_get_opt_int(bytes, input)
            f6: body_codec_get_bool(bytes, input)
            f7: body_codec_get_opt_autovectorizationfacts(bytes, input)
            f8: body_codec_get_list_int(bytes, input)
            f9: body_codec_get_span(bytes, input)
            StmtKind.Range{label: f0, variable: f1, source: f2, start: f3, end: f4, step: f5, exclusive: f6, vectorization: f7, body: f8, span: f9}
        }
        11 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_span(bytes, input)
            StmtKind.ExprStmt{value: f0, span: f1}
        }
        12 -> {
            f0: body_codec_get_opt_int(bytes, input)
            f1: body_codec_get_span(bytes, input)
            StmtKind.Return{value: f0, span: f1}
        }
        13 -> {
            f0: body_codec_get_tlocal(bytes, input)
            f1: body_codec_get_bodytaskgroupargs(bytes, input)
            f2: body_codec_get_list_int(bytes, input)
            f3: body_codec_get_span(bytes, input)
            StmtKind.TaskGroup{group: f0, args: f1, body: f2, span: f3}
        }
        14 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_symbolid(bytes, input)
            f2: body_codec_get_span(bytes, input)
            StmtKind.DeferClose{close: f0, resource: f1, span: f2}
        }
        15 -> {
            f0: body_codec_get_bodyifcond(bytes, input)
            f1: body_codec_get_list_int(bytes, input)
            f2: body_codec_get_opt_list_int(bytes, input)
            f3: body_codec_get_bool(bytes, input)
            f4: body_codec_get_span(bytes, input)
            StmtKind.If{condition: f0, then_body: f1, else_body: f2, else_is_elseif: f3, span: f4}
        }
        16 -> {
            f0: body_codec_get_opt_string(bytes, input)
            f1: body_codec_get_list_int(bytes, input)
            f2: body_codec_get_span(bytes, input)
            StmtKind.Loop{label: f0, body: f1, span: f2}
        }
        17 -> {
            f0: body_codec_get_opt_string(bytes, input)
            f1: body_codec_get_int(bytes, input)
            f2: body_codec_get_list_int(bytes, input)
            f3: body_codec_get_span(bytes, input)
            StmtKind.While{label: f0, condition: f1, body: f2, span: f3}
        }
        18 -> {
            f0: body_codec_get_opt_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            StmtKind.Break{label: f0, span: f1}
        }
        19 -> {
            f0: body_codec_get_opt_string(bytes, input)
            f1: body_codec_get_int(bytes, input)
            f2: body_codec_get_span(bytes, input)
            StmtKind.BreakValue{label: f0, value: f1, span: f2}
        }
        20 -> {
            f0: body_codec_get_opt_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            StmtKind.Continue{label: f0, span: f1}
        }
        21 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_list_bodymatcharm(bytes, input)
            f2: body_codec_get_bool(bytes, input)
            f3: body_codec_get_span(bytes, input)
            StmtKind.Match{subject: f0, arms: f1, exhaustive: f2, span: f3}
        }
        22 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_list_bodymatcharm(bytes, input)
            f2: body_codec_get_opt_list_int(bytes, input)
            f3: body_codec_get_bool(bytes, input)
            f4: body_codec_get_span(bytes, input)
            StmtKind.EnumMatch{scrutinee: f0, arms: f1, else_body: f2, fallthrough: f3, span: f4}
        }
        23 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_list_bodyrangearm(bytes, input)
            f2: body_codec_get_list_int(bytes, input)
            f3: body_codec_get_span(bytes, input)
            StmtKind.RangeSwitch{subject: f0, arms: f1, else_body: f2, span: f3}
        }
        24 -> {
            f0: body_codec_get_opt_string(bytes, input)
            f1: body_codec_get_tlocal(bytes, input)
            f2: body_codec_get_opt_tlocal(bytes, input)
            f3: body_codec_get_int(bytes, input)
            f4: body_codec_get_int(bytes, input)
            f5: body_codec_get_opt_int(bytes, input)
            f6: body_codec_get_opt_tforinmethod(bytes, input)
            f7: body_codec_get_bool(bytes, input)
            f8: body_codec_get_bool(bytes, input)
            f9: body_codec_get_bool(bytes, input)
            f10: body_codec_get_list_int(bytes, input)
            f11: body_codec_get_span(bytes, input)
            StmtKind.ForIn{label: f0, variable: f1, variable_two: f2, source: f3, collection: f4, step: f5, method_kind: f6, columnar: f7, by_value: f8, source_stable: f9, body: f10, span: f11}
        }
        25 -> {
            f0: body_codec_get_list_int(bytes, input)
            f1: body_codec_get_span(bytes, input)
            StmtKind.Inline{body: f0, span: f1}
        }
        26 -> {
            f0: body_codec_get_list_int(bytes, input)
            f1: body_codec_get_span(bytes, input)
            StmtKind.DebugOnly{body: f0, span: f1}
        }
        27 -> {
            f0: body_codec_get_list_int(bytes, input)
            f1: body_codec_get_span(bytes, input)
            StmtKind.DeepCheck{body: f0, span: f1}
        }
        28 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_tbranchclass(bytes, input)
            f2: body_codec_get_list_bodymixedarm(bytes, input)
            f3: body_codec_get_opt_list_int(bytes, input)
            f4: body_codec_get_span(bytes, input)
            StmtKind.MixedSwitch{subject: f0, class: f1, arms: f2, else_body: f3, span: f4}
        }
        29 -> {
            f0: body_codec_get_tunsafegate(bytes, input)
            f1: body_codec_get_list_int(bytes, input)
            StmtKind.Unsafe{gate: f0, body: f1}
        }
        30 -> {
            f0: body_codec_get_tunsafegate(bytes, input)
            f1: body_codec_get_list_int(bytes, input)
            f2: body_codec_get_span(bytes, input)
            StmtKind.UnsafeBlock{gate: f0, body: f1, span: f2}
        }
        31 -> {
            f0: body_codec_get_bool(bytes, input)
            f1: body_codec_get_list_int(bytes, input)
            f2: body_codec_get_span(bytes, input)
            StmtKind.SentryPolicy{enabled: f0, body: f1, span: f2}
        }
        32 -> {
            f0: body_codec_get_list_int(bytes, input)
            f1: body_codec_get_span(bytes, input)
            StmtKind.Impure{body: f0, span: f1}
        }
        33 -> {
            f0: body_codec_get_bodylambda(bytes, input)
            f1: body_codec_get_span(bytes, input)
            StmtKind.Reactive{executable: f0, span: f1}
        }
        34 -> {
            f0: body_codec_get_list_int(bytes, input)
            f1: body_codec_get_span(bytes, input)
            StmtKind.Region{body: f0, span: f1}
        }
        35 -> {
            f0: body_codec_get_tlocal(bytes, input)
            f1: body_codec_get_string(bytes, input)
            f2: body_codec_get_list_int(bytes, input)
            f3: body_codec_get_span(bytes, input)
            StmtKind.Layout{handle: f0, label: f1, body: f2, span: f3}
        }
        36 -> {
            f0: body_codec_get_list_bodycontextguard(bytes, input)
            f1: body_codec_get_list_int(bytes, input)
            f2: body_codec_get_span(bytes, input)
            StmtKind.ContextBlock{guards: f0, body: f1, span: f2}
        }
        37 -> {
            f0: body_codec_get_list_int(bytes, input)
            f1: body_codec_get_span(bytes, input)
            StmtKind.Live{body: f0, span: f1}
        }
        38 -> {
            f0: body_codec_get_list_int(bytes, input)
            f1: body_codec_get_span(bytes, input)
            StmtKind.Shield{body: f0, span: f1}
        }
        39 -> {
            f0: body_codec_get_list_int(bytes, input)
            f1: body_codec_get_span(bytes, input)
            StmtKind.Defer{body: f0, span: f1}
        }
        40 -> {
            f0: body_codec_get_bodyscopememberkind(bytes, input)
            f1: body_codec_get_list_int(bytes, input)
            f2: body_codec_get_span(bytes, input)
            StmtKind.ScopeMember{kind: f0, body: f1, span: f2}
        }
        41 -> {
            f0: body_codec_get_opt_tlocal(bytes, input)
            f1: body_codec_get_list_ttransactionsnapshot(bytes, input)
            f2: body_codec_get_opt_tlocal(bytes, input)
            f3: body_codec_get_list_int(bytes, input)
            f4: body_codec_get_span(bytes, input)
            StmtKind.Transact{handle: f0, snapshots: f1, stm: f2, body: f3, span: f4}
        }
        42 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_string(bytes, input)
            f2: body_codec_get_list_string(bytes, input)
            f3: body_codec_get_bool(bytes, input)
            f4: body_codec_get_opt_int(bytes, input)
            f5: body_codec_get_int(bytes, input)
            f6: body_codec_get_span(bytes, input)
            StmtKind.GCEdit{root: f0, slot: f1, edges: f2, replace_all: f3, index_temp: f4, statement: f5, span: f6}
        }
        else -> {
            f0: body_codec_get_tlocal(bytes, input)
            f1: body_codec_get_int(bytes, input)
            f2: body_codec_get_bool(bytes, input)
            f3: body_codec_get_list_tdestructurebinding(bytes, input)
            f4: body_codec_get_span(bytes, input)
            StmtKind.TupleDestructure{temp: f0, init: f1, move_fields: f2, binds: f3, span: f4}
        }
    }
}

body_codec_put_tcontractresult: fn(out: ^BodyCodecOut, value: TContractResult) Never! {
    body_codec_put_type(out, value.carrier_ty)
    body_codec_put_type(out, value.binding_ty)
    body_codec_put_tlocal(out, value.carrier_local)
    body_codec_put_tlocal(out, value.binding_local)
    body_codec_put_tcontractresultmode(out, value.mode)
}

body_codec_get_tcontractresult: fn(bytes: [U8], input: ^BodyCodecIn) -> TContractResult Never! {
    f0: body_codec_get_type(bytes, input)
    f1: body_codec_get_type(bytes, input)
    f2: body_codec_get_tlocal(bytes, input)
    f3: body_codec_get_tlocal(bytes, input)
    f4: body_codec_get_tcontractresultmode(bytes, input)
    TContractResult{carrier_ty: f0, binding_ty: f1, carrier_local: f2, binding_local: f3, mode: f4}
}

body_codec_put_tcontractresultmode: fn(out: ^BodyCodecOut, value: TContractResultMode) Never! {
    if value == {
        .Direct -> { body_codec_put_tag(out, 0) }
        .ResultPayload -> { body_codec_put_tag(out, 1) }
        .OptionPayload -> body_codec_put_tag(out, 2)
    }
}

body_codec_get_tcontractresultmode: fn(bytes: [U8], input: ^BodyCodecIn) -> TContractResultMode Never! {
    position: body_codec_get_tag(bytes, input, 3, 0)
    if position == {
        1 -> TContractResultMode.ResultPayload
        2 -> TContractResultMode.OptionPayload
        else -> TContractResultMode.Direct
    }
}

body_codec_put_tletty: fn(out: ^BodyCodecOut, value: TLetTy) Never! {
    if value == {
        .Inferred -> { body_codec_put_tag(out, 0) }
        .StrView -> { body_codec_put_tag(out, 1) }
        .Annotated(p0, p1) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_type(out, p0)
            body_codec_put_tletwrapper(out, p1)
        }
    }
}

body_codec_get_tletty: fn(bytes: [U8], input: ^BodyCodecIn) -> TLetTy Never! {
    position: body_codec_get_tag(bytes, input, 3, 0)
    if position == {
        1 -> TLetTy.StrView
        2 -> {
            f0: body_codec_get_type(bytes, input)
            f1: body_codec_get_tletwrapper(bytes, input)
            TLetTy.Annotated{ty: f0, wrapper: f1}
        }
        else -> TLetTy.Inferred
    }
}

body_codec_put_tletwrapper: fn(out: ^BodyCodecOut, value: TLetWrapper) Never! {
    if value == {
        .Plain -> { body_codec_put_tag(out, 0) }
        .AutomaticRoot -> body_codec_put_tag(out, 1)
    }
}

body_codec_get_tletwrapper: fn(bytes: [U8], input: ^BodyCodecIn) -> TLetWrapper Never! {
    position: body_codec_get_tag(bytes, input, 2, 0)
    if position == {
        1 -> TLetWrapper.AutomaticRoot
        else -> TLetWrapper.Plain
    }
}

body_codec_put_list_tgcpromotionedge: fn(out: ^BodyCodecOut, values: [TGCPromotionEdge]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_tgcpromotionedge(out, value)
}

body_codec_get_list_tgcpromotionedge: fn(bytes: [U8], input: ^BodyCodecIn) -> [TGCPromotionEdge] Never! {
    count: body_codec_get_count(bytes, input, 1)
    ^values: [TGCPromotionEdge]{}
    loop _ in 0..<count -> values.push(body_codec_get_tgcpromotionedge(bytes, input))
    values
}

body_codec_put_tgcpromotion: fn(out: ^BodyCodecOut, value: TGCPromotion) Never! {
    body_codec_put_span(out, value.span)
    body_codec_put_string(out, value.scope)
    body_codec_put_string(out, value.policy_provenance)
    body_codec_put_string(out, value.reason)
    body_codec_put_list_tgcpromotionedge(out, value.edges)
    body_codec_put_opt_int(out, value.collection_len)
}

body_codec_get_tgcpromotion: fn(bytes: [U8], input: ^BodyCodecIn) -> TGCPromotion Never! {
    f0: body_codec_get_span(bytes, input)
    f1: body_codec_get_string(bytes, input)
    f2: body_codec_get_string(bytes, input)
    f3: body_codec_get_string(bytes, input)
    f4: body_codec_get_list_tgcpromotionedge(bytes, input)
    f5: body_codec_get_opt_int(bytes, input)
    TGCPromotion{span: f0, scope: f1, policy_provenance: f2, reason: f3, edges: f4, collection_len: f5}
}

body_codec_put_tgcpromotionedge: fn(out: ^BodyCodecOut, value: TGCPromotionEdge) Never! {
    body_codec_put_string(out, value.binding)
    body_codec_put_string(out, value.slot)
    body_codec_put_int(out, value.group)
}

body_codec_get_tgcpromotionedge: fn(bytes: [U8], input: ^BodyCodecIn) -> TGCPromotionEdge Never! {
    f0: body_codec_get_string(bytes, input)
    f1: body_codec_get_string(bytes, input)
    f2: body_codec_get_int(bytes, input)
    TGCPromotionEdge{binding: f0, slot: f1, group: f2}
}

body_codec_put_tdestructurebinding: fn(out: ^BodyCodecOut, value: TDestructureBinding) Never! {
    body_codec_put_tlocal(out, value.local)
    body_codec_put_string(out, value.field)
}

