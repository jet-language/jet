    body_codec_put_list_string(out, value.materialized)
    body_codec_put_list_string(out, value.moved)
    body_codec_put_list_int(out, value.lent)
}

body_codec_get_tcapturefacts: fn(bytes: [U8], input: ^BodyCodecIn) -> TCaptureFacts Never! {
    f0: body_codec_get_bool(bytes, input)
