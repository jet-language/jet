            Type.Union{members: f0}
        }
        21 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_type(bytes, input)
            Type.Case{name: f0, payload: f1}
        }
        22 -> {
            f0: body_codec_get_type(bytes, input)
            f1: body_codec_get_dimension(bytes, input)
            Type.Quantity{base: f0, dimension: f1}
        }
        23 -> {
            f0: body_codec_get_measure(bytes, input)
