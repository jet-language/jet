        .OptField(p0, p1, p2) -> {
            body_codec_put_tag(out, 79)
            body_codec_put_int(out, p0)
            body_codec_put_string(out, p1)
            body_codec_put_bool(out, p2)
        }
        .OptMethodCall(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 80)
            body_codec_put_int(out, p0)
            body_codec_put_tlocal(out, p1)
            body_codec_put_int(out, p2)
            body_codec_put_bool(out, p3)
        }
        .PatternMatches(p0, p1) -> {
            body_codec_put_tag(out, 81)
            body_codec_put_int(out, p0)
            body_codec_put_bodypattern(out, p1)
        }
        .OptionLift2(p0, p1, p2) -> {
            body_codec_put_tag(out, 82)
            body_codec_put_int(out, p0)
            body_codec_put_int(out, p1)
            body_codec_put_int(out, p2)
        }
        .ClosureMethod(p0, p1, p2) -> {
            body_codec_put_tag(out, 83)
            body_codec_put_int(out, p0)
            body_codec_put_tclosureop(out, p1)
            body_codec_put_list_int(out, p2)
        }
        .NumericMethod(p0, p1) -> {
            body_codec_put_tag(out, 84)
            body_codec_put_int(out, p0)
            body_codec_put_tnumericop(out, p1)
        }
        .NumericBinaryMethod(p0, p1, p2) -> {
            body_codec_put_tag(out, 85)
            body_codec_put_int(out, p0)
            body_codec_put_tnumericop(out, p1)
            body_codec_put_int(out, p2)
        }
        .OverflowOpt(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 86)
            body_codec_put_string(out, p0)
            body_codec_put_string(out, p1)
            body_codec_put_int(out, p2)
            body_codec_put_int(out, p3)
            body_codec_put_int(out, p4)
        }
        .HandleMethod(p0, p1, p2) -> {
            body_codec_put_tag(out, 87)
            body_codec_put_int(out, p0)
            body_codec_put_bodyhandleop(out, p1)
            body_codec_put_list_int(out, p2)
        }
        .CoreClosureCall(p0) -> {
            body_codec_put_tag(out, 88)
            body_codec_put_bodycoreclosurekind(out, p0)
        }
        .TaskGroupAll(p0) -> {
            body_codec_put_tag(out, 89)
            body_codec_put_int(out, p0)
        }
        .TaskGroupRace(p0) -> {
            body_codec_put_tag(out, 90)
            body_codec_put_int(out, p0)
        }
        .TaskGroupAny(p0) -> {
            body_codec_put_tag(out, 91)
            body_codec_put_int(out, p0)
        }
        .SelectStart -> { body_codec_put_tag(out, 92) }
        .SelectRecv(p0, p1) -> {
            body_codec_put_tag(out, 93)
            body_codec_put_int(out, p0)
            body_codec_put_int(out, p1)
        }
        .SelectAfter(p0, p1, p2) -> {
            body_codec_put_tag(out, 94)
            body_codec_put_int(out, p0)
            body_codec_put_int(out, p1)
            body_codec_put_opt_int(out, p2)
        }
        .SelectWait(p0, p1) -> {
            body_codec_put_tag(out, 95)
            body_codec_put_int(out, p0)
            body_codec_put_bool(out, p1)
        }
        .FnValue(p0) -> {
            body_codec_put_tag(out, 96)
            body_codec_put_bodyfnvaluekind(out, p0)
        }
        .Never(p0, p1) -> {
            body_codec_put_tag(out, 97)
            body_codec_put_string(out, p0)
            body_codec_put_int(out, p1)
        }
        .TypeTest(p0, p1) -> {
            body_codec_put_tag(out, 98)
            body_codec_put_type(out, p0)
            body_codec_put_type(out, p1)
        }
    }
}

