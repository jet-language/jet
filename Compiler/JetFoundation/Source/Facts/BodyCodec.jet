body_codec_put_thardwarecall: fn(out: &BodyCodecOut, value: THardwareCall) Never! {
    if value == {
        .RegisterRead(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_string(out, p0)
            body_codec_put_string(out, p1)
            body_codec_put_string(out, p2)
            body_codec_put_registerwidth(out, p3)
        }
        .RegisterWrite(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_string(out, p0)
            body_codec_put_string(out, p1)
            body_codec_put_string(out, p2)
            body_codec_put_registerwidth(out, p3)
        }
        .DMAStart(p0, p1, p2) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_string(out, p0)
            body_codec_put_string(out, p1)
            body_codec_put_type(out, p2)
        }
        .DMAWait(p0, p1, p2) -> {
            body_codec_put_tag(out, 3)
            body_codec_put_string(out, p0)
            body_codec_put_string(out, p1)
            body_codec_put_type(out, p2)
        }
    }
}

body_codec_get_thardwarecall: fn(bytes: [U8], input: &BodyCodecIn) -> THardwareCall Never! {
    position: body_codec_get_tag(bytes, input, 4, 2)
    if position == {
        0 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_string(bytes, input)
            f2: body_codec_get_string(bytes, input)
            f3: body_codec_get_registerwidth(bytes, input)
            THardwareCall.RegisterRead{profile_id: f0, block: f1, register: f2, width: f3}
        }
        1 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_string(bytes, input)
            f2: body_codec_get_string(bytes, input)
            f3: body_codec_get_registerwidth(bytes, input)
            THardwareCall.RegisterWrite{profile_id: f0, block: f1, register: f2, width: f3}
        }
        3 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_string(bytes, input)
            f2: body_codec_get_type(bytes, input)
            THardwareCall.DMAWait{profile_id: f0, channel: f1, buffer_ty: f2}
        }
        else -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_string(bytes, input)
            f2: body_codec_get_type(bytes, input)
            THardwareCall.DMAStart{profile_id: f0, channel: f1, buffer_ty: f2}
        }
    }
}

body_codec_put_registerwidth: fn(out: &BodyCodecOut, value: RegisterWidth) Never! {
    if value == {
        .U8 -> { body_codec_put_tag(out, 0) }
        .U16 -> { body_codec_put_tag(out, 1) }
        .U32 -> { body_codec_put_tag(out, 2) }
        .U64 -> body_codec_put_tag(out, 3)
    }
}

body_codec_get_registerwidth: fn(bytes: [U8], input: &BodyCodecIn) -> RegisterWidth Never! {
    position: body_codec_get_tag(bytes, input, 4, 0)
    if position == {
        1 -> RegisterWidth.U16
        2 -> RegisterWidth.U32
        3 -> RegisterWidth.U64
        else -> RegisterWidth.U8
    }
}

body_codec_put_list_componenttypedescriptor: fn(out: &BodyCodecOut, values: [ComponentTypeDescriptor]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_componenttypedescriptor(out, value)
}

body_codec_get_list_componenttypedescriptor: fn(bytes: [U8], input: &BodyCodecIn) -> [ComponentTypeDescriptor] Never! {
    count: body_codec_get_count(bytes, input, 1)
    values := [ComponentTypeDescriptor]{}
    loop _ in 0..<count -> values.push(body_codec_get_componenttypedescriptor(bytes, input))
    values
}

body_codec_put_componentsignaturedescriptor: fn(out: &BodyCodecOut, value: ComponentSignatureDescriptor) Never! {
    body_codec_put_list_componenttypedescriptor(out, value.params)
    body_codec_put_componenttypedescriptor(out, value.result)
}

body_codec_get_componentsignaturedescriptor: fn(bytes: [U8], input: &BodyCodecIn) -> ComponentSignatureDescriptor Never! {
    f0: body_codec_get_list_componenttypedescriptor(bytes, input)
    f1: body_codec_get_componenttypedescriptor(bytes, input)
    ComponentSignatureDescriptor{params: f0, result: f1}
}

body_codec_put_list_componenttypefield: fn(out: &BodyCodecOut, values: [ComponentTypeField]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_componenttypefield(out, value)
}

body_codec_get_list_componenttypefield: fn(bytes: [U8], input: &BodyCodecIn) -> [ComponentTypeField] Never! {
    count: body_codec_get_count(bytes, input, 1)
    values := [ComponentTypeField]{}
    loop _ in 0..<count -> values.push(body_codec_get_componenttypefield(bytes, input))
    values
}

body_codec_put_componenttypedescriptor: fn(out: &BodyCodecOut, value: ComponentTypeDescriptor) Never! {
    if value == {
        .Int -> { body_codec_put_tag(out, 0) }
        .Float -> { body_codec_put_tag(out, 1) }
        .Bool -> { body_codec_put_tag(out, 2) }
        .String -> { body_codec_put_tag(out, 3) }
        .List(p0) -> {
            body_codec_put_tag(out, 4)
            body_codec_put_componenttypedescriptor(out, p0)
        }
        .Option(p0) -> {
            body_codec_put_tag(out, 5)
            body_codec_put_componenttypedescriptor(out, p0)
        }
        .Result(p0, p1) -> {
            body_codec_put_tag(out, 6)
            body_codec_put_componenttypedescriptor(out, p0)
            body_codec_put_componenttypedescriptor(out, p1)
        }
        .Record(p0, p1) -> {
            body_codec_put_tag(out, 7)
            body_codec_put_string(out, p0)
            body_codec_put_list_componenttypefield(out, p1)
        }
    }
}

body_codec_get_componenttypedescriptor: fn(bytes: [U8], input: &BodyCodecIn) -> ComponentTypeDescriptor Never! {
    position: body_codec_get_tag(bytes, input, 8, 0)
    if position == {
        1 -> ComponentTypeDescriptor.Float
        2 -> ComponentTypeDescriptor.Bool
        3 -> ComponentTypeDescriptor.String
        4 -> {
            f0: body_codec_get_componenttypedescriptor(bytes, input)
            ComponentTypeDescriptor.List{inner: f0}
        }
        5 -> {
            f0: body_codec_get_componenttypedescriptor(bytes, input)
            ComponentTypeDescriptor.Option{inner: f0}
        }
        6 -> {
            f0: body_codec_get_componenttypedescriptor(bytes, input)
            f1: body_codec_get_componenttypedescriptor(bytes, input)
            ComponentTypeDescriptor.Result{ok: f0, err: f1}
        }
        7 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_list_componenttypefield(bytes, input)
            ComponentTypeDescriptor.Record{name: f0, fields: f1}
        }
        else -> ComponentTypeDescriptor.Int
    }
}

body_codec_put_componenttypefield: fn(out: &BodyCodecOut, value: ComponentTypeField) Never! {
    body_codec_put_int(out, value.index)
    body_codec_put_string(out, value.name)
    body_codec_put_componenttypedescriptor(out, value.ty)
