}

body_codec_put_tcomptimevalue: fn(out: &BodyCodecOut, value: TComptimeValue) Never! {
    if value == {
        .Int(p0) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_int(out, p0)
        }
        .Float(p0, p1) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_float(out, p0)
            body_codec_put_int(out, p1)
        }
        .Bool(p0) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_bool(out, p0)
        }
        .Char(p0) -> {
            body_codec_put_tag(out, 3)
            body_codec_put_int(out, p0)
        }
        .String(p0) -> {
            body_codec_put_tag(out, 4)
            body_codec_put_string(out, p0)
        }
        .BigInt(p0) -> {
            body_codec_put_tag(out, 5)
            body_codec_put_string(out, p0)
        }
        .Bytes(p0) -> {
            body_codec_put_tag(out, 6)
            body_codec_put_list_u8(out, p0)
        }
        .List(p0) -> {
            body_codec_put_tag(out, 7)
            body_codec_put_list_tcomptimevalue(out, p0)
        }
        .Map(p0) -> {
            body_codec_put_tag(out, 8)
            body_codec_put_list_tcomptimemapentry(out, p0)
        }
        .Struct(p0, p1) -> {
            body_codec_put_tag(out, 9)
            body_codec_put_string(out, p0)
            body_codec_put_list_tcomptimefield(out, p1)
        }
        .Enum(p0, p1, p2) -> {
            body_codec_put_tag(out, 10)
            body_codec_put_string(out, p0)
            body_codec_put_string(out, p1)
            body_codec_put_list_tcomptimeenumarg(out, p2)
        }
        .Present(p0) -> {
            body_codec_put_tag(out, 11)
            body_codec_put_tcomptimevalue(out, p0)
        }
        .Failed(p0) -> {
            body_codec_put_tag(out, 12)
            body_codec_put_tcomptimereport(out, p0)
        }
        .Unit -> { body_codec_put_tag(out, 13) }
        .Function(p0) -> {
            body_codec_put_tag(out, 14)
            body_codec_put_string(out, p0)
        }
    }
}

body_codec_get_tcomptimevalue: fn(bytes: [U8], input: &BodyCodecIn) -> TComptimeValue Never! {
    position: body_codec_get_tag(bytes, input, 15, 13)
    if position == {
        0 -> {
            f0: body_codec_get_int(bytes, input)
            TComptimeValue.Int{value: f0}
        }
        1 -> {
            f0: body_codec_get_float(bytes, input)
            f1: body_codec_get_int(bytes, input)
            TComptimeValue.Float{value: f0, bits: f1}
        }
        2 -> {
            f0: body_codec_get_bool(bytes, input)
            TComptimeValue.Bool{value: f0}
        }
        3 -> {
            f0: body_codec_get_int(bytes, input)
            TComptimeValue.Char{value: f0}
        }
        4 -> {
            f0: body_codec_get_string(bytes, input)
            TComptimeValue.String{value: f0}
        }
        5 -> {
            f0: body_codec_get_string(bytes, input)
            TComptimeValue.BigInt{decimal: f0}
        }
        6 -> {
            f0: body_codec_get_list_u8(bytes, input)
            TComptimeValue.Bytes{value: f0}
        }
        7 -> {
            f0: body_codec_get_list_tcomptimevalue(bytes, input)
            TComptimeValue.List{values: f0}
        }
        8 -> {
            f0: body_codec_get_list_tcomptimemapentry(bytes, input)
            TComptimeValue.Map{entries: f0}
        }
        9 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_list_tcomptimefield(bytes, input)
            TComptimeValue.Struct{type_name: f0, fields: f1}
        }
        10 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_string(bytes, input)
            f2: body_codec_get_list_tcomptimeenumarg(bytes, input)
            TComptimeValue.Enum{type_name: f0, variant: f1, args: f2}
        }
        11 -> {
            f0: body_codec_get_tcomptimevalue(bytes, input)
            TComptimeValue.Present{value: f0}
        }
        12 -> {
            f0: body_codec_get_tcomptimereport(bytes, input)
            TComptimeValue.Failed{report: f0}
        }
        14 -> {
            f0: body_codec_get_string(bytes, input)
            TComptimeValue.Function{key: f0}
        }
        else -> TComptimeValue.Unit
    }
}

