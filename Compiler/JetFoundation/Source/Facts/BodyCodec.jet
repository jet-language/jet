        .RawOf(p0) -> {
            body_codec_put_tag(out, 71)
            body_codec_put_int(out, p0)
        }
        .InvariantViolation(p0, p1) -> {
            body_codec_put_tag(out, 72)
            body_codec_put_string(out, p0)
