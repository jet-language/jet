body_codec_put_bodycoreclosurekind: fn(out: ^BodyCodecOut, value: BodyCoreClosureKind) Never! {
    if value == {
        .Spawn(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_opt_int(out, p0)
            body_codec_put_int(out, p1)
            body_codec_put_opt_string(out, p2)
            body_codec_put_bodylambda(out, p3)
        }
        .Guard(p0) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_bodylambda(out, p0)
        }
        .OnCommit(p0, p1) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_string(out, p0)
            body_codec_put_bodylambda(out, p1)
        }
        .OnRollback(p0, p1) -> {
            body_codec_put_tag(out, 3)
            body_codec_put_string(out, p0)
            body_codec_put_bodylambda(out, p1)
        }
        .UIClickSlot(p0) -> {
            body_codec_put_tag(out, 4)
            body_codec_put_bodylambda(out, p0)
        }
        .UIDropSlot(p0) -> {
            body_codec_put_tag(out, 5)
            body_codec_put_bodylambda(out, p0)
        }
        .ReactiveDerived(p0) -> {
            body_codec_put_tag(out, 6)
            body_codec_put_bodylambda(out, p0)
        }
        .ReactiveEffect(p0) -> {
            body_codec_put_tag(out, 7)
            body_codec_put_bodylambda(out, p0)
        }
        .UIReactiveRender(p0) -> {
            body_codec_put_tag(out, 8)
            body_codec_put_bodylambda(out, p0)
        }
    }
}

body_codec_get_bodycoreclosurekind: fn(bytes: [U8], input: ^BodyCodecIn) -> BodyCoreClosureKind Never! {
    position: body_codec_get_tag(bytes, input, 9, 0)
    if position == {
        1 -> {
            f0: body_codec_get_bodylambda(bytes, input)
            BodyCoreClosureKind.Guard{executable: f0}
        }
        2 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_bodylambda(bytes, input)
            BodyCoreClosureKind.OnCommit{handle_name: f0, executable: f1}
        }
        3 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_bodylambda(bytes, input)
            BodyCoreClosureKind.OnRollback{handle_name: f0, executable: f1}
        }
        4 -> {
            f0: body_codec_get_bodylambda(bytes, input)
            BodyCoreClosureKind.UIClickSlot{executable: f0}
        }
        5 -> {
            f0: body_codec_get_bodylambda(bytes, input)
            BodyCoreClosureKind.UIDropSlot{executable: f0}
        }
        6 -> {
            f0: body_codec_get_bodylambda(bytes, input)
            BodyCoreClosureKind.ReactiveDerived{executable: f0}
        }
        7 -> {
            f0: body_codec_get_bodylambda(bytes, input)
            BodyCoreClosureKind.ReactiveEffect{executable: f0}
        }
        8 -> {
            f0: body_codec_get_bodylambda(bytes, input)
            BodyCoreClosureKind.UIReactiveRender{executable: f0}
        }
        else -> {
            f0: body_codec_get_opt_int(bytes, input)
            f1: body_codec_get_int(bytes, input)
            f2: body_codec_get_opt_string(bytes, input)
            f3: body_codec_get_bodylambda(bytes, input)
            BodyCoreClosureKind.Spawn{group: f0, site: f1, label: f2, executable: f3}
        }
    }
}

body_codec_put_opt_declid: fn(out: ^BodyCodecOut, value: DeclID?) Never! {
    if value == .Val(inner) {
        body_codec_put_bool(out, true)
        body_codec_put_declid(out, inner)
        return
    }
    body_codec_put_bool(out, false)
}

body_codec_get_opt_declid: fn(bytes: [U8], input: ^BodyCodecIn) -> DeclID? Never! {
    if body_codec_get_bool(bytes, input) -> return Val(body_codec_get_declid(bytes, input))
    None
}

body_codec_put_opt_bodylambda: fn(out: ^BodyCodecOut, value: BodyLambda?) Never! {
    if value == .Val(inner) {
        body_codec_put_bool(out, true)
        body_codec_put_bodylambda(out, inner)
        return
    }
    body_codec_put_bool(out, false)
}

body_codec_get_opt_bodylambda: fn(bytes: [U8], input: ^BodyCodecIn) -> BodyLambda? Never! {
    if body_codec_get_bool(bytes, input) -> return Val(body_codec_get_bodylambda(bytes, input))
    None
}

body_codec_put_bodyfnvaluekind: fn(out: ^BodyCodecOut, value: BodyFnValueKind) Never! {
    if value == {
        .NamedFn(p0, p1) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_opt_declid(out, p0)
            body_codec_put_opt_bodylambda(out, p1)
        }
        .Policy(p0, p1, p2, p3, p4, p5) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_type(out, p0)
            body_codec_put_list_bodycallarg(out, p1)
            body_codec_put_list_accessconvention(out, p2)
            body_codec_put_opt_declid(out, p3)
            body_codec_put_list_tcapture(out, p4)
            body_codec_put_int(out, p5)
        }
        .Call(p0, p1) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_int(out, p0)
            body_codec_put_list_bodycallarg(out, p1)
        }
        .Send(p0) -> {
            body_codec_put_tag(out, 3)
            body_codec_put_int(out, p0)
        }
    }
}

body_codec_get_bodyfnvaluekind: fn(bytes: [U8], input: ^BodyCodecIn) -> BodyFnValueKind Never! {
    position: body_codec_get_tag(bytes, input, 4, 0)
    if position == {
        1 -> {
            f0: body_codec_get_type(bytes, input)
            f1: body_codec_get_list_bodycallarg(bytes, input)
            f2: body_codec_get_list_accessconvention(bytes, input)
            f3: body_codec_get_opt_declid(bytes, input)
            f4: body_codec_get_list_tcapture(bytes, input)
            f5: body_codec_get_int(bytes, input)
            BodyFnValueKind.Policy{fn_type: f0, policy_args: f1, policy_conventions: f2, wrapper: f3, captures: f4, callee: f5}
        }
        2 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_list_bodycallarg(bytes, input)
            BodyFnValueKind.Call{callee: f0, args: f1}
        }
        3 -> {
            f0: body_codec_get_int(bytes, input)
            BodyFnValueKind.Send{value: f0}
        }
        else -> {
            f0: body_codec_get_opt_declid(bytes, input)
            f1: body_codec_get_opt_bodylambda(bytes, input)
            BodyFnValueKind.NamedFn{function: f0, lambda: f1}
        }
    }
}

body_codec_put_opt_tgcpromotion: fn(out: ^BodyCodecOut, value: TGCPromotion?) Never! {
    if value == .Val(inner) {
        body_codec_put_bool(out, true)
