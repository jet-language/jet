body_codec_put_tunitroundingmode: fn(out: ^BodyCodecOut, value: TUnitRoundingMode) Never! {
    if value == {
        .TowardZero -> { body_codec_put_tag(out, 0) }
        .Floor -> { body_codec_put_tag(out, 1) }
        .Ceiling -> { body_codec_put_tag(out, 2) }
        .NearestEven -> body_codec_put_tag(out, 3)
    }
}

body_codec_get_tunitroundingmode: fn(bytes: [U8], input: ^BodyCodecIn) -> TUnitRoundingMode Never! {
    position: body_codec_get_tag(bytes, input, 4, 0)
    if position == {
        1 -> TUnitRoundingMode.Floor
        2 -> TUnitRoundingMode.Ceiling
        3 -> TUnitRoundingMode.NearestEven
        else -> TUnitRoundingMode.TowardZero
    }
}

body_codec_put_opt_tmethodref: fn(out: ^BodyCodecOut, value: TMethodRef?) Never! {
    if value == .Val(inner) {
        body_codec_put_bool(out, true)
        body_codec_put_tmethodref(out, inner)
        return
    }
    body_codec_put_bool(out, false)
}

body_codec_get_opt_tmethodref: fn(bytes: [U8], input: ^BodyCodecIn) -> TMethodRef? Never! {
    if body_codec_get_bool(bytes, input) -> return Val(body_codec_get_tmethodref(bytes, input))
    None
}

body_codec_put_bodyrequirekind: fn(out: ^BodyCodecOut, value: BodyRequireKind) Never! {
    if value == {
        .Require(p0, p1) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_int(out, p0)
            body_codec_put_opt_int(out, p1)
        }
        .RequireEq(p0, p1, p2) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_int(out, p0)
            body_codec_put_int(out, p1)
            body_codec_put_opt_tmethodref(out, p2)
        }
        .Panic(p0) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_int(out, p0)
        }
    }
}

body_codec_get_bodyrequirekind: fn(bytes: [U8], input: ^BodyCodecIn) -> BodyRequireKind Never! {
    position: body_codec_get_tag(bytes, input, 3, 0)
    if position == {
        1 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_int(bytes, input)
            f2: body_codec_get_opt_tmethodref(bytes, input)
            BodyRequireKind.RequireEq{left: f0, right: f1, hook: f2}
        }
        2 -> {
            f0: body_codec_get_int(bytes, input)
            BodyRequireKind.Panic{msg: f0}
        }
        else -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_opt_int(bytes, input)
            BodyRequireKind.Require{cond: f0, msg: f1}
        }
    }
}

