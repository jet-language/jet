    if value == {
        .Whole -> { body_codec_put_tag(out, 0) }
        .Bytes(p0, p1) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_int(out, p0)
            body_codec_put_int(out, p1)
        }
        .Unknown -> body_codec_put_tag(out, 2)
    }
}

