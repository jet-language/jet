body_codec_get_list_bodycallarg: fn(bytes: [U8], input: &BodyCodecIn) -> [BodyCallArg] Never! {
    count: body_codec_get_count(bytes, input, 1)
    values := [BodyCallArg]{}
    loop _ in 0..<count -> values.push(body_codec_get_bodycallarg(bytes, input))
    values
}

