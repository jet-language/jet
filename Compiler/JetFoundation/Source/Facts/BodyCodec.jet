body_codec_put_tmethodref: fn(out: ^BodyCodecOut, value: TMethodRef) Never! {
    body_codec_put_symbolid(out, value.symbol)
    body_codec_put_string(out, value.name)
    body_codec_put_bool(out, value.mangled)
    body_codec_put_opt_symbolid(out, value.trait_owner)
    body_codec_put_opt_string(out, value.operator_identity)
}

