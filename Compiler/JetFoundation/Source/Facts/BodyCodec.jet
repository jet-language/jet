body_codec_put_tindexkind: fn(out: ^BodyCodecOut, value: TIndexKind) Never! {
    if value == {
        .List -> { body_codec_put_tag(out, 0) }
        .Range -> { body_codec_put_tag(out, 1) }
        .FixedListProof -> { body_codec_put_tag(out, 2) }
        .Map -> { body_codec_put_tag(out, 3) }
        .Lane(p0) -> {
            body_codec_put_tag(out, 4)
            body_codec_put_string(out, p0)
        }
        .User(p0) -> {
            body_codec_put_tag(out, 5)
            body_codec_put_string(out, p0)
        }
        .LayoutField(p0) -> {
            body_codec_put_tag(out, 6)
            body_codec_put_string(out, p0)
        }
        .Pool -> { body_codec_put_tag(out, 7) }
        .MapOr -> body_codec_put_tag(out, 8)
    }
}

body_codec_get_tindexkind: fn(bytes: [U8], input: ^BodyCodecIn) -> TIndexKind Never! {
    position: body_codec_get_tag(bytes, input, 9, 0)
    if position == {
        1 -> TIndexKind.Range
        2 -> TIndexKind.FixedListProof
        3 -> TIndexKind.Map
        4 -> {
            f0: body_codec_get_string(bytes, input)
            TIndexKind.Lane{name: f0}
        }
        5 -> {
            f0: body_codec_get_string(bytes, input)
            TIndexKind.User{name: f0}
        }
        6 -> {
            f0: body_codec_get_string(bytes, input)
            TIndexKind.LayoutField{name: f0}
        }
        7 -> TIndexKind.Pool
        8 -> TIndexKind.MapOr
        else -> TIndexKind.List
    }
}

