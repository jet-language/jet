body_codec_put_nodekind: fn(out: &BodyCodecOut, value: NodeKind) Never! {
    if value == {
        .IntLit(p0, p1) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_int(out, p0)
            body_codec_put_opt_tintegerwidth(out, p1)
        }
        .FloatLit(p0) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_float(out, p0)
        }
        .BoolLit(p0) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_bool(out, p0)
        }
        .CharLit(p0) -> {
            body_codec_put_tag(out, 3)
            body_codec_put_int(out, p0)
        }
        .StrLit(p0) -> {
            body_codec_put_tag(out, 4)
            body_codec_put_list_bodystrpart(out, p0)
        }
        .Local(p0) -> {
            body_codec_put_tag(out, 5)
            body_codec_put_tlocal(out, p0)
        }
        .Unit -> { body_codec_put_tag(out, 6) }
        .InlineBlock(p0) -> {
            body_codec_put_tag(out, 7)
            body_codec_put_list_int(out, p0)
        }
        .Uninit -> { body_codec_put_tag(out, 8) }
        .CtLit(p0) -> {
            body_codec_put_tag(out, 9)
            body_codec_put_tcomptimevalue(out, p0)
        }
        .ConstRef(p0) -> {
            body_codec_put_tag(out, 10)
            body_codec_put_symbolid(out, p0)
        }
        .TraitConst(p0, p1, p2) -> {
            body_codec_put_tag(out, 11)
            body_codec_put_type(out, p0)
            body_codec_put_string(out, p1)
            body_codec_put_string(out, p2)
        }
        .NumberParam(p0) -> {
            body_codec_put_tag(out, 12)
            body_codec_put_type(out, p0)
        }
        .CopyPhase(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 13)
            body_codec_put_symbolid(out, p0)
            body_codec_put_symbolid(out, p1)
            body_codec_put_symbolid(out, p2)
            body_codec_put_symbolid(out, p3)
        }
        .GlobalShared(p0, p1) -> {
            body_codec_put_tag(out, 14)
            body_codec_put_declid(out, p0)
            body_codec_put_sharedlifetime(out, p1)
        }
        .Call(p0, p1, p2) -> {
            body_codec_put_tag(out, 15)
            body_codec_put_declid(out, p0)
            body_codec_put_list_type(out, p1)
            body_codec_put_list_bodycallarg(out, p2)
        }
        .IndirectCall(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 16)
            body_codec_put_int(out, p0)
            body_codec_put_list_type(out, p1)
            body_codec_put_list_bodycallarg(out, p2)
            body_codec_put_type(out, p3)
        }
        .MethodCall(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 17)
            body_codec_put_int(out, p0)
            body_codec_put_tmethodref(out, p1)
            body_codec_put_list_type(out, p2)
            body_codec_put_list_bodycallarg(out, p3)
        }
        .DistinctCtor(p0) -> {
            body_codec_put_tag(out, 18)
            body_codec_put_int(out, p0)
        }
        .DistinctConvert(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 19)
            body_codec_put_symbolid(out, p0)
            body_codec_put_int(out, p1)
            body_codec_put_tnumericop(out, p2)
            body_codec_put_opt_tintegerbounds(out, p3)
            body_codec_put_bool(out, p4)
        }
        .TraitBox(p0, p1) -> {
            body_codec_put_tag(out, 20)
            body_codec_put_int(out, p0)
            body_codec_put_type(out, p1)
        }
        .UnitConvert(p0, p1, p2, p3, p4, p5, p6, p7) -> {
            body_codec_put_tag(out, 21)
            body_codec_put_int(out, p0)
            body_codec_put_string(out, p1)
            body_codec_put_string(out, p2)
            body_codec_put_opt_bodyunitrounding(out, p3)
            body_codec_put_bool(out, p4)
            body_codec_put_opt_float(out, p5)
            body_codec_put_string(out, p6)
            body_codec_put_int(out, p7)
        }
        .MathBuiltin(p0, p1, p2) -> {
            body_codec_put_tag(out, 22)
            body_codec_put_string(out, p0)
            body_codec_put_string(out, p1)
            body_codec_put_list_int(out, p2)
        }
        .PreciseBuiltin(p0, p1, p2) -> {
            body_codec_put_tag(out, 23)
            body_codec_put_string(out, p0)
            body_codec_put_string(out, p1)
            body_codec_put_list_int(out, p2)
        }
        .Print(p0) -> {
            body_codec_put_tag(out, 24)
            body_codec_put_int(out, p0)
        }
        .Drop(p0) -> {
            body_codec_put_tag(out, 25)
            body_codec_put_int(out, p0)
        }
        .Close(p0) -> {
            body_codec_put_tag(out, 26)
            body_codec_put_int(out, p0)
        }
        .Move(p0) -> {
            body_codec_put_tag(out, 27)
            body_codec_put_int(out, p0)
        }
        .RequireStop(p0, p1, p2) -> {
            body_codec_put_tag(out, 28)
            body_codec_put_bodyrequirekind(out, p0)
            body_codec_put_tpanicloc(out, p1)
            body_codec_put_bool(out, p2)
        }
        .Binary(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 29)
            body_codec_put_tbinaryop(out, p0)
            body_codec_put_bool(out, p1)
            body_codec_put_int(out, p2)
            body_codec_put_int(out, p3)
            body_codec_put_int(out, p4)
        }
        .CompareChain(p0, p1, p2) -> {
            body_codec_put_tag(out, 30)
            body_codec_put_list_int(out, p0)
            body_codec_put_list_tbinaryop(out, p1)
            body_codec_put_list_bool(out, p2)
        }
        .Unary(p0, p1) -> {
            body_codec_put_tag(out, 31)
            body_codec_put_tunaryop(out, p0)
            body_codec_put_int(out, p1)
        }
        .StructLit(p0) -> {
            body_codec_put_tag(out, 32)
            body_codec_put_list_bodystructfieldvalue(out, p0)
        }
        .Field(p0, p1) -> {
            body_codec_put_tag(out, 33)
            body_codec_put_int(out, p0)
            body_codec_put_tfieldref(out, p1)
        }
        .Index(p0, p1, p2, p3, p4, p5) -> {
            body_codec_put_tag(out, 34)
            body_codec_put_int(out, p0)
            body_codec_put_int(out, p1)
            body_codec_put_tindexkind(out, p2)
            body_codec_put_accessconvention(out, p3)
            body_codec_put_opt_symbolid(out, p4)
            body_codec_put_tpanicloc(out, p5)
        }
        .Slice(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 35)
            body_codec_put_int(out, p0)
            body_codec_put_int(out, p1)
            body_codec_put_int(out, p2)
            body_codec_put_opt_int(out, p3)
            body_codec_put_tpanicloc(out, p4)
        }
        .Range(p0, p1, p2) -> {
            body_codec_put_tag(out, 36)
            body_codec_put_int(out, p0)
            body_codec_put_int(out, p1)
            body_codec_put_bool(out, p2)
        }
        .Tuple(p0) -> {
            body_codec_put_tag(out, 37)
            body_codec_put_list_int(out, p0)
        }
        .List(p0, p1) -> {
            body_codec_put_tag(out, 38)
            body_codec_put_list_int(out, p0)
            body_codec_put_opt_type(out, p1)
        }
        .Map(p0) -> {
            body_codec_put_tag(out, 39)
            body_codec_put_list_bodymapentry(out, p0)
        }
        .EnumCtor(p0, p1, p2) -> {
            body_codec_put_tag(out, 40)
            body_codec_put_symbolid(out, p0)
            body_codec_put_symbolid(out, p1)
            body_codec_put_bodyenumpayload(out, p2)
        }
        .Try(p0, p1, p2) -> {
            body_codec_put_tag(out, 41)
            body_codec_put_int(out, p0)
            body_codec_put_ttryconvert(out, p1)
            body_codec_put_tfailurecarrier(out, p2)
        }
        .TryWithContext(p0, p1, p2, p3, p4, p5) -> {
            body_codec_put_tag(out, 42)
            body_codec_put_int(out, p0)
            body_codec_put_opt_int(out, p1)
            body_codec_put_ttryconvert(out, p2)
            body_codec_put_string(out, p3)
            body_codec_put_int(out, p4)
            body_codec_put_string(out, p5)
        }
        .Lambda(p0) -> {
            body_codec_put_tag(out, 43)
            body_codec_put_bodylambda(out, p0)
        }
        .Borrow(p0, p1) -> {
            body_codec_put_tag(out, 44)
            body_codec_put_int(out, p0)
            body_codec_put_accessconvention(out, p1)
        }
        .RawAddressOf(p0) -> {
            body_codec_put_tag(out, 45)
            body_codec_put_bodyplace(out, p0)
        }
        .Deref(p0) -> {
            body_codec_put_tag(out, 46)
            body_codec_put_int(out, p0)
        }
        .PtrFromAddr(p0, p1) -> {
            body_codec_put_tag(out, 47)
            body_codec_put_int(out, p0)
            body_codec_put_type(out, p1)
        }
        .LayoutLiteral(p0) -> {
            body_codec_put_tag(out, 48)
            body_codec_put_int(out, p0)
        }
        .LayoutCompare(p0, p1, p2) -> {
            body_codec_put_tag(out, 49)
            body_codec_put_tbinaryop(out, p0)
            body_codec_put_int(out, p1)
            body_codec_put_int(out, p2)
        }
        .SharedGuardValue(p0) -> {
            body_codec_put_tag(out, 50)
            body_codec_put_int(out, p0)
        }
        .SharedGuardMap(p0, p1, p2) -> {
            body_codec_put_tag(out, 51)
            body_codec_put_int(out, p0)
            body_codec_put_list_tfieldref(out, p1)
            body_codec_put_bool(out, p2)
        }
        .SharedGuardSplit(p0, p1, p2, p3) -> {
            body_codec_put_tag(out, 52)
            body_codec_put_int(out, p0)
            body_codec_put_list_tfieldref(out, p1)
            body_codec_put_list_tfieldref(out, p2)
            body_codec_put_bool(out, p3)
        }
        .SharedGuardWait(p0, p1, p2) -> {
            body_codec_put_tag(out, 53)
            body_codec_put_int(out, p0)
            body_codec_put_int(out, p1)
            body_codec_put_bodylambda(out, p2)
        }
        .ConditionNotify(p0, p1) -> {
            body_codec_put_tag(out, 54)
            body_codec_put_int(out, p0)
            body_codec_put_bool(out, p1)
        }
        .CoreCall(p0, p1, p2, p3, p4, p5) -> {
            body_codec_put_tag(out, 55)
            body_codec_put_corecallrecord(out, p0)
            body_codec_put_list_int(out, p1)
            body_codec_put_span(out, p2)
            body_codec_put_list_type(out, p3)
            body_codec_put_list_bool(out, p4)
            body_codec_put_tfailurecarrier(out, p5)
        }
        .HostCall(p0) -> {
            body_codec_put_tag(out, 56)
            body_codec_put_bodyhostcall(out, p0)
        }
        .AllocNew(p0, p1) -> {
            body_codec_put_tag(out, 57)
            body_codec_put_tallocctor(out, p0)
            body_codec_put_list_bodycallarg(out, p1)
        }
        .EnumLit(p0, p1, p2) -> {
            body_codec_put_tag(out, 58)
            body_codec_put_string(out, p0)
            body_codec_put_string(out, p1)
            body_codec_put_bodyenumpayload(out, p2)
        }
        .JSONLit(p0, p1, p2) -> {
            body_codec_put_tag(out, 59)
            body_codec_put_string(out, p0)
            body_codec_put_opt_int(out, p1)
            body_codec_put_bool(out, p2)
        }
        .ListLit(p0) -> {
            body_codec_put_tag(out, 60)
            body_codec_put_list_int(out, p0)
        }
        .ListSpread(p0) -> {
            body_codec_put_tag(out, 61)
            body_codec_put_list_bodylistspreadpart(out, p0)
        }
        .MapLit(p0) -> {
            body_codec_put_tag(out, 62)
            body_codec_put_list_bodymapentry(out, p0)
        }
        .PoolSlot(p0, p1, p2, p3, p4, p5) -> {
            body_codec_put_tag(out, 63)
            body_codec_put_int(out, p0)
            body_codec_put_int(out, p1)
            body_codec_put_bool(out, p2)
            body_codec_put_opt_string(out, p3)
            body_codec_put_int(out, p4)
            body_codec_put_string(out, p5)
        }
        .Clone(p0, p1) -> {
            body_codec_put_tag(out, 64)
            body_codec_put_int(out, p0)
            body_codec_put_copyfact(out, p1)
        }
        .ExplicitCopy(p0) -> {
            body_codec_put_tag(out, 65)
            body_codec_put_int(out, p0)
        }
        .MaterializeView(p0) -> {
            body_codec_put_tag(out, 66)
            body_codec_put_int(out, p0)
        }
        .StaticCall(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 67)
            body_codec_put_tstaticowner(out, p0)
            body_codec_put_opt_type(out, p1)
            body_codec_put_tmethodref(out, p2)
            body_codec_put_list_type(out, p3)
            body_codec_put_list_bodycallarg(out, p4)
        }
        .DecodeUnder(p0, p1) -> {
            body_codec_put_tag(out, 68)
            body_codec_put_int(out, p0)
            body_codec_put_int(out, p1)
        }
        .BuiltinMethod(p0, p1, p2) -> {
            body_codec_put_tag(out, 69)
            body_codec_put_int(out, p0)
            body_codec_put_tbuiltinop(out, p1)
            body_codec_put_list_int(out, p2)
        }
        .IfExpr(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 70)
            body_codec_put_bodyifcond(out, p0)
