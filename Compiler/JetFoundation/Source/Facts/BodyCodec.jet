    if value == {
        .User(p0) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_string(out, p0)
        }
        .Internal(p0) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_internaltag(out, p0)
        }
    }
}

body_codec_get_tagmarker: fn(bytes: [U8], input: &BodyCodecIn) -> TagMarker Never! {
    position: body_codec_get_tag(bytes, input, 2, 0)
    if position == {
        1 -> {
            f0: body_codec_get_internaltag(bytes, input)
            TagMarker.Internal{internal_tag: f0}
        }
        else -> {
            f0: body_codec_get_string(bytes, input)
            TagMarker.User{name: f0}
        }
    }
}

body_codec_put_internaltag: fn(out: &BodyCodecOut, value: InternalTag) Never! {
    if value == {
        .CoreCryptoNominal -> { body_codec_put_tag(out, 0) }
        .DeterministicClock -> { body_codec_put_tag(out, 1) }
        .SystemClock -> { body_codec_put_tag(out, 2) }
        .ExpiringSecretLoan -> { body_codec_put_tag(out, 3) }
        .SharedGuardRead -> { body_codec_put_tag(out, 4) }
        .SharedGuardEdit -> { body_codec_put_tag(out, 5) }
        .TerminalFactSet -> { body_codec_put_tag(out, 6) }
        .CppCallbackABI -> { body_codec_put_tag(out, 7) }
        .AllocatorView -> body_codec_put_tag(out, 8)
    }
}

body_codec_get_internaltag: fn(bytes: [U8], input: &BodyCodecIn) -> InternalTag Never! {
    position: body_codec_get_tag(bytes, input, 9, 0)
    if position == {
        1 -> InternalTag.DeterministicClock
        2 -> InternalTag.SystemClock
        3 -> InternalTag.ExpiringSecretLoan
        4 -> InternalTag.SharedGuardRead
        5 -> InternalTag.SharedGuardEdit
        6 -> InternalTag.TerminalFactSet
        7 -> InternalTag.CppCallbackABI
        8 -> InternalTag.AllocatorView
        else -> InternalTag.CoreCryptoNominal
    }
}

