        19 -> {
            f0: body_codec_get_opt_string(bytes, input)
            f1: body_codec_get_int(bytes, input)
            f2: body_codec_get_span(bytes, input)
            StmtKind.BreakValue{label: f0, value: f1, span: f2}
        }
        20 -> {
            f0: body_codec_get_opt_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            StmtKind.Continue{label: f0, span: f1}
        }
        21 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_list_bodymatcharm(bytes, input)
            f2: body_codec_get_bool(bytes, input)
            f3: body_codec_get_span(bytes, input)
            StmtKind.Match{subject: f0, arms: f1, exhaustive: f2, span: f3}
        }
        22 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_list_bodymatcharm(bytes, input)
            f2: body_codec_get_opt_list_int(bytes, input)
            f3: body_codec_get_bool(bytes, input)
            f4: body_codec_get_span(bytes, input)
            StmtKind.EnumMatch{scrutinee: f0, arms: f1, else_body: f2, fallthrough: f3, span: f4}
        }
        23 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_list_bodyrangearm(bytes, input)
            f2: body_codec_get_list_int(bytes, input)
            f3: body_codec_get_span(bytes, input)
            StmtKind.RangeSwitch{subject: f0, arms: f1, else_body: f2, span: f3}
        }
        24 -> {
            f0: body_codec_get_opt_string(bytes, input)
            f1: body_codec_get_tlocal(bytes, input)
            f2: body_codec_get_opt_tlocal(bytes, input)
            f3: body_codec_get_int(bytes, input)
            f4: body_codec_get_int(bytes, input)
            f5: body_codec_get_opt_int(bytes, input)
            f6: body_codec_get_opt_tforinmethod(bytes, input)
            f7: body_codec_get_bool(bytes, input)
            f8: body_codec_get_bool(bytes, input)
            f9: body_codec_get_bool(bytes, input)
            f10: body_codec_get_list_int(bytes, input)
            f11: body_codec_get_span(bytes, input)
            StmtKind.ForIn{label: f0, variable: f1, variable_two: f2, source: f3, collection: f4, step: f5, method_kind: f6, columnar: f7, by_value: f8, source_stable: f9, body: f10, span: f11}
        }
        25 -> {
            f0: body_codec_get_list_int(bytes, input)
            f1: body_codec_get_span(bytes, input)
            StmtKind.Inline{body: f0, span: f1}
        }
        26 -> {
            f0: body_codec_get_list_int(bytes, input)
            f1: body_codec_get_span(bytes, input)
            StmtKind.DebugOnly{body: f0, span: f1}
        }
        27 -> {
            f0: body_codec_get_list_int(bytes, input)
            f1: body_codec_get_span(bytes, input)
            StmtKind.DeepCheck{body: f0, span: f1}
        }
        28 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_tbranchclass(bytes, input)
            f2: body_codec_get_list_bodymixedarm(bytes, input)
            f3: body_codec_get_opt_list_int(bytes, input)
            f4: body_codec_get_span(bytes, input)
            StmtKind.MixedSwitch{subject: f0, class: f1, arms: f2, else_body: f3, span: f4}
        }
        29 -> {
            f0: body_codec_get_tunsafegate(bytes, input)
            f1: body_codec_get_list_int(bytes, input)
            StmtKind.Unsafe{gate: f0, body: f1}
        }
        30 -> {
            f0: body_codec_get_tunsafegate(bytes, input)
            f1: body_codec_get_list_int(bytes, input)
            f2: body_codec_get_span(bytes, input)
            StmtKind.UnsafeBlock{gate: f0, body: f1, span: f2}
        }
        31 -> {
            f0: body_codec_get_bool(bytes, input)
            f1: body_codec_get_list_int(bytes, input)
            f2: body_codec_get_span(bytes, input)
            StmtKind.SentryPolicy{enabled: f0, body: f1, span: f2}
        }
        32 -> {
            f0: body_codec_get_list_int(bytes, input)
            f1: body_codec_get_span(bytes, input)
            StmtKind.Impure{body: f0, span: f1}
        }
        33 -> {
            f0: body_codec_get_bodylambda(bytes, input)
            f1: body_codec_get_span(bytes, input)
            StmtKind.Reactive{executable: f0, span: f1}
        }
        34 -> {
            f0: body_codec_get_list_int(bytes, input)
            f1: body_codec_get_span(bytes, input)
            StmtKind.Region{body: f0, span: f1}
        }
        35 -> {
            f0: body_codec_get_tlocal(bytes, input)
            f1: body_codec_get_string(bytes, input)
            f2: body_codec_get_list_int(bytes, input)
            f3: body_codec_get_span(bytes, input)
            StmtKind.Layout{handle: f0, label: f1, body: f2, span: f3}
        }
        36 -> {
            f0: body_codec_get_list_bodycontextguard(bytes, input)
            f1: body_codec_get_list_int(bytes, input)
            f2: body_codec_get_span(bytes, input)
            StmtKind.ContextBlock{guards: f0, body: f1, span: f2}
        }
        37 -> {
            f0: body_codec_get_list_int(bytes, input)
            f1: body_codec_get_span(bytes, input)
            StmtKind.Live{body: f0, span: f1}
        }
        38 -> {
            f0: body_codec_get_list_int(bytes, input)
            f1: body_codec_get_span(bytes, input)
            StmtKind.Shield{body: f0, span: f1}
        }
        39 -> {
            f0: body_codec_get_list_int(bytes, input)
            f1: body_codec_get_span(bytes, input)
            StmtKind.Defer{body: f0, span: f1}
        }
        40 -> {
            f0: body_codec_get_bodyscopememberkind(bytes, input)
            f1: body_codec_get_list_int(bytes, input)
            f2: body_codec_get_span(bytes, input)
            StmtKind.ScopeMember{kind: f0, body: f1, span: f2}
        }
        41 -> {
            f0: body_codec_get_opt_tlocal(bytes, input)
            f1: body_codec_get_list_ttransactionsnapshot(bytes, input)
            f2: body_codec_get_opt_tlocal(bytes, input)
            f3: body_codec_get_list_int(bytes, input)
            f4: body_codec_get_span(bytes, input)
            StmtKind.Transact{handle: f0, snapshots: f1, stm: f2, body: f3, span: f4}
        }
        42 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_string(bytes, input)
            f2: body_codec_get_list_string(bytes, input)
            f3: body_codec_get_bool(bytes, input)
            f4: body_codec_get_opt_int(bytes, input)
            f5: body_codec_get_int(bytes, input)
            f6: body_codec_get_span(bytes, input)
            StmtKind.GCEdit{root: f0, slot: f1, edges: f2, replace_all: f3, index_temp: f4, statement: f5, span: f6}
        }
        else -> {
            f0: body_codec_get_tlocal(bytes, input)
            f1: body_codec_get_int(bytes, input)
            f2: body_codec_get_bool(bytes, input)
            f3: body_codec_get_list_tdestructurebinding(bytes, input)
            f4: body_codec_get_span(bytes, input)
            StmtKind.TupleDestructure{temp: f0, init: f1, move_fields: f2, binds: f3, span: f4}
        }
    }
}

body_codec_put_tcontractresult: fn(out: &BodyCodecOut, value: TContractResult) Never! {
    body_codec_put_type(out, value.carrier_ty)
    body_codec_put_type(out, value.binding_ty)
    body_codec_put_tlocal(out, value.carrier_local)
    body_codec_put_tlocal(out, value.binding_local)
    body_codec_put_tcontractresultmode(out, value.mode)
}

body_codec_get_tcontractresult: fn(bytes: [U8], input: &BodyCodecIn) -> TContractResult Never! {
    f0: body_codec_get_type(bytes, input)
    f1: body_codec_get_type(bytes, input)
    f2: body_codec_get_tlocal(bytes, input)
    f3: body_codec_get_tlocal(bytes, input)
    f4: body_codec_get_tcontractresultmode(bytes, input)
    TContractResult{carrier_ty: f0, binding_ty: f1, carrier_local: f2, binding_local: f3, mode: f4}
}

body_codec_put_tcontractresultmode: fn(out: &BodyCodecOut, value: TContractResultMode) Never! {
    if value == {
        .Direct -> { body_codec_put_tag(out, 0) }
        .ResultPayload -> { body_codec_put_tag(out, 1) }
        .OptionPayload -> body_codec_put_tag(out, 2)
    }
}

body_codec_get_tcontractresultmode: fn(bytes: [U8], input: &BodyCodecIn) -> TContractResultMode Never! {
    position: body_codec_get_tag(bytes, input, 3, 0)
    if position == {
        1 -> TContractResultMode.ResultPayload
        2 -> TContractResultMode.OptionPayload
        else -> TContractResultMode.Direct
    }
}

body_codec_put_tletty: fn(out: &BodyCodecOut, value: TLetTy) Never! {
    if value == {
        .Inferred -> { body_codec_put_tag(out, 0) }
        .StrView -> { body_codec_put_tag(out, 1) }
        .Annotated(p0, p1) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_type(out, p0)
            body_codec_put_tletwrapper(out, p1)
        }
    }
}

body_codec_get_tletty: fn(bytes: [U8], input: &BodyCodecIn) -> TLetTy Never! {
    position: body_codec_get_tag(bytes, input, 3, 0)
    if position == {
        1 -> TLetTy.StrView
        2 -> {
            f0: body_codec_get_type(bytes, input)
            f1: body_codec_get_tletwrapper(bytes, input)
            TLetTy.Annotated{ty: f0, wrapper: f1}
        }
        else -> TLetTy.Inferred
    }
}

body_codec_put_tletwrapper: fn(out: &BodyCodecOut, value: TLetWrapper) Never! {
    if value == {
        .Plain -> { body_codec_put_tag(out, 0) }
        .AutomaticRoot -> body_codec_put_tag(out, 1)
    }
}

body_codec_get_tletwrapper: fn(bytes: [U8], input: &BodyCodecIn) -> TLetWrapper Never! {
    position: body_codec_get_tag(bytes, input, 2, 0)
    if position == {
        1 -> TLetWrapper.AutomaticRoot
        else -> TLetWrapper.Plain
    }
}

body_codec_put_list_tgcpromotionedge: fn(out: &BodyCodecOut, values: [TGCPromotionEdge]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_tgcpromotionedge(out, value)
}

body_codec_get_list_tgcpromotionedge: fn(bytes: [U8], input: &BodyCodecIn) -> [TGCPromotionEdge] Never! {
    count: body_codec_get_count(bytes, input, 1)
    values := [TGCPromotionEdge]{}
    loop _ in 0..<count -> values.push(body_codec_get_tgcpromotionedge(bytes, input))
    values
}

body_codec_put_tgcpromotion: fn(out: &BodyCodecOut, value: TGCPromotion) Never! {
    body_codec_put_span(out, value.span)
    body_codec_put_string(out, value.scope)
    body_codec_put_string(out, value.policy_provenance)
    body_codec_put_string(out, value.reason)
    body_codec_put_list_tgcpromotionedge(out, value.edges)
    body_codec_put_opt_int(out, value.collection_len)
}

body_codec_get_tgcpromotion: fn(bytes: [U8], input: &BodyCodecIn) -> TGCPromotion Never! {
    f0: body_codec_get_span(bytes, input)
    f1: body_codec_get_string(bytes, input)
    f2: body_codec_get_string(bytes, input)
    f3: body_codec_get_string(bytes, input)
    f4: body_codec_get_list_tgcpromotionedge(bytes, input)
    f5: body_codec_get_opt_int(bytes, input)
    TGCPromotion{span: f0, scope: f1, policy_provenance: f2, reason: f3, edges: f4, collection_len: f5}
}

body_codec_put_tgcpromotionedge: fn(out: &BodyCodecOut, value: TGCPromotionEdge) Never! {
    body_codec_put_string(out, value.binding)
    body_codec_put_string(out, value.slot)
    body_codec_put_int(out, value.group)
}

body_codec_get_tgcpromotionedge: fn(bytes: [U8], input: &BodyCodecIn) -> TGCPromotionEdge Never! {
    f0: body_codec_get_string(bytes, input)
    f1: body_codec_get_string(bytes, input)
    f2: body_codec_get_int(bytes, input)
    TGCPromotionEdge{binding: f0, slot: f1, group: f2}
}

