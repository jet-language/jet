body_codec_put_list_tfieldref: fn(out: ^BodyCodecOut, values: [TFieldRef]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_tfieldref(out, value)
}

body_codec_get_list_tfieldref: fn(bytes: [U8], input: ^BodyCodecIn) -> [TFieldRef] Never! {
    count: body_codec_get_count(bytes, input, 1)
    ^values: [TFieldRef]{}
    loop _ in 0..<count -> values.push(body_codec_get_tfieldref(bytes, input))
    values
