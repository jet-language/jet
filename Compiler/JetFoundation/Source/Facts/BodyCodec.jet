body_codec_put_tlistremovemode: fn(out: ^BodyCodecOut, value: TListRemoveMode) Never! {
    if value == {
        .Value -> { body_codec_put_tag(out, 0) }
        .Slot -> { body_codec_put_tag(out, 1) }
        .Dynamic -> body_codec_put_tag(out, 2)
    }
}

body_codec_get_tlistremovemode: fn(bytes: [U8], input: ^BodyCodecIn) -> TListRemoveMode Never! {
    position: body_codec_get_tag(bytes, input, 3, 0)
    if position == {
        1 -> TListRemoveMode.Slot
        2 -> TListRemoveMode.Dynamic
        else -> TListRemoveMode.Value
    }
}

body_codec_put_tzipmode: fn(out: ^BodyCodecOut, value: TZipMode) Never! {
    if value == {
        .Strict -> { body_codec_put_tag(out, 0) }
        .Short -> { body_codec_put_tag(out, 1) }
        .Pad -> body_codec_put_tag(out, 2)
    }
}

body_codec_get_tzipmode: fn(bytes: [U8], input: ^BodyCodecIn) -> TZipMode Never! {
    position: body_codec_get_tag(bytes, input, 3, 0)
    if position == {
        1 -> TZipMode.Short
        2 -> TZipMode.Pad
        else -> TZipMode.Strict
    }
}

body_codec_put_tzipfillmode: fn(out: ^BodyCodecOut, value: TZipFillMode) Never! {
    if value == {
        .DefaultNone -> { body_codec_put_tag(out, 0) }
        .Common -> { body_codec_put_tag(out, 1) }
        .Columns -> body_codec_put_tag(out, 2)
    }
}

body_codec_get_tzipfillmode: fn(bytes: [U8], input: ^BodyCodecIn) -> TZipFillMode Never! {
    position: body_codec_get_tag(bytes, input, 3, 0)
    if position == {
        1 -> TZipFillMode.Common
        2 -> TZipFillMode.Columns
        else -> TZipFillMode.DefaultNone
    }
}

body_codec_put_bodyifcond: fn(out: ^BodyCodecOut, value: BodyIfCond) Never! {
    if value == {
        .Plain(p0) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_int(out, p0)
        }
        .And(p0, p1) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_bodyifcond(out, p0)
            body_codec_put_bodyifcond(out, p1)
        }
        .IfLet(p0, p1) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_bodypattern(out, p0)
            body_codec_put_int(out, p1)
        }
    }
}

body_codec_get_bodyifcond: fn(bytes: [U8], input: ^BodyCodecIn) -> BodyIfCond Never! {
    position: body_codec_get_tag(bytes, input, 3, 0)
    if position == {
        1 -> {
            f0: body_codec_get_bodyifcond(bytes, input)
            f1: body_codec_get_bodyifcond(bytes, input)
            BodyIfCond.And{left: f0, right: f1}
        }
        2 -> {
            f0: body_codec_get_bodypattern(bytes, input)
            f1: body_codec_get_int(bytes, input)
            BodyIfCond.IfLet{pattern: f0, subj: f1}
        }
        else -> {
            f0: body_codec_get_int(bytes, input)
            BodyIfCond.Plain{value: f0}
        }
    }
}

body_codec_put_list_tpatternbindingfact: fn(out: ^BodyCodecOut, values: [TPatternBindingFact]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_tpatternbindingfact(out, value)
}

body_codec_get_list_tpatternbindingfact: fn(bytes: [U8], input: ^BodyCodecIn) -> [TPatternBindingFact] Never! {
    count: body_codec_get_count(bytes, input, 1)
    ^values: [TPatternBindingFact]{}
    loop _ in 0..<count -> values.push(body_codec_get_tpatternbindingfact(bytes, input))
    values
}

body_codec_put_bodypattern: fn(out: ^BodyCodecOut, value: BodyPattern) Never! {
    body_codec_put_bodypatternshape(out, value.shape)
    body_codec_put_list_tpatternbindingfact(out, value.bindings)
    body_codec_put_opt_symbolid(out, value.enum_type)
    body_codec_put_tpatternposition(out, value.position)
    body_codec_put_bool(out, value.mutable)
    body_codec_put_bool(out, value.boxed)
}

body_codec_get_bodypattern: fn(bytes: [U8], input: ^BodyCodecIn) -> BodyPattern Never! {
    f0: body_codec_get_bodypatternshape(bytes, input)
    f1: body_codec_get_list_tpatternbindingfact(bytes, input)
    f2: body_codec_get_opt_symbolid(bytes, input)
    f3: body_codec_get_tpatternposition(bytes, input)
    f4: body_codec_get_bool(bytes, input)
    f5: body_codec_get_bool(bytes, input)
    BodyPattern{shape: f0, bindings: f1, enum_type: f2, position: f3, mutable: f4, boxed: f5}
}

body_codec_put_list_bodypatternbinding: fn(out: ^BodyCodecOut, values: [BodyPatternBinding]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_bodypatternbinding(out, value)
}

body_codec_get_list_bodypatternbinding: fn(bytes: [U8], input: ^BodyCodecIn) -> [BodyPatternBinding] Never! {
    count: body_codec_get_count(bytes, input, 1)
    ^values: [BodyPatternBinding]{}
    loop _ in 0..<count -> values.push(body_codec_get_bodypatternbinding(bytes, input))
    values
}

body_codec_put_opt_bodynestedpattern: fn(out: ^BodyCodecOut, value: BodyNestedPattern?) Never! {
    if value == .Val(inner) {
        body_codec_put_bool(out, true)
        body_codec_put_bodynestedpattern(out, inner)
        return
    }
    body_codec_put_bool(out, false)
}

body_codec_get_opt_bodynestedpattern: fn(bytes: [U8], input: ^BodyCodecIn) -> BodyNestedPattern? Never! {
    if body_codec_get_bool(bytes, input) {
        return Val(body_codec_get_bodynestedpattern(bytes, input))
    }
    None
}

body_codec_put_list_bodypatternshape: fn(out: ^BodyCodecOut, values: [BodyPatternShape]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_bodypatternshape(out, value)
