            f7: body_codec_get_opt_autovectorizationfacts(bytes, input)
            f8: body_codec_get_list_int(bytes, input)
            f9: body_codec_get_span(bytes, input)
            StmtKind.Range{label: f0, variable: f1, source: f2, start: f3, end: f4, step: f5, exclusive: f6, vectorization: f7, body: f8, span: f9}
        }
        11 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_span(bytes, input)
            StmtKind.ExprStmt{value: f0, span: f1}
        }
        12 -> {
            f0: body_codec_get_opt_int(bytes, input)
            f1: body_codec_get_span(bytes, input)
            StmtKind.Return{value: f0, span: f1}
        }
        13 -> {
            f0: body_codec_get_tlocal(bytes, input)
            f1: body_codec_get_bodytaskgroupargs(bytes, input)
            f2: body_codec_get_list_int(bytes, input)
            f3: body_codec_get_span(bytes, input)
            StmtKind.TaskGroup{group: f0, args: f1, body: f2, span: f3}
        }
        14 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_symbolid(bytes, input)
            f2: body_codec_get_span(bytes, input)
            StmtKind.DeferClose{close: f0, resource: f1, span: f2}
        }
        15 -> {
            f0: body_codec_get_bodyifcond(bytes, input)
            f1: body_codec_get_list_int(bytes, input)
            f2: body_codec_get_opt_list_int(bytes, input)
            f3: body_codec_get_bool(bytes, input)
            f4: body_codec_get_span(bytes, input)
            StmtKind.If{condition: f0, then_body: f1, else_body: f2, else_is_elseif: f3, span: f4}
        }
        16 -> {
            f0: body_codec_get_opt_string(bytes, input)
            f1: body_codec_get_list_int(bytes, input)
            f2: body_codec_get_span(bytes, input)
            StmtKind.Loop{label: f0, body: f1, span: f2}
