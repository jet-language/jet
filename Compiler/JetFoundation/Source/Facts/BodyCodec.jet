body_codec_get_bodyhostcall: fn(bytes: [U8], input: ^BodyCodecIn) -> BodyHostCall Never! {
    position: body_codec_get_tag(bytes, input, 12, 4)
    if position == {
        0 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_string(bytes, input)
            f2: body_codec_get_list_int(bytes, input)
            BodyHostCall.Method{receiver: f0, method: f1, args: f2}
        }
        1 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_list_list_string(bytes, input)
            f2: body_codec_get_type(bytes, input)
            f3: body_codec_get_bool(bytes, input)
            f4: body_codec_get_bool(bytes, input)
            BodyHostCall.CellGuardProject{receiver: f0, paths: f1, result_type: f2, editable: f3, edit_paths_disjoint: f4}
        }
        2 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_toptionprobe(bytes, input)
            BodyHostCall.OptionProbe{inner: f0, kind: f1}
        }
        3 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_int(bytes, input)
            BodyHostCall.TupleIndex{base: f0, index: f1}
        }
        5 -> {
            f0: body_codec_get_int(bytes, input)
            BodyHostCall.YieldSend{value: f0}
        }
        6 -> {
            f0: body_codec_get_type(bytes, input)
            f1: body_codec_get_string(bytes, input)
            BodyHostCall.NumericBounds{ty: f0, member: f1}
        }
        7 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_int(bytes, input)
            f2: body_codec_get_opt_string(bytes, input)
            BodyHostCall.ComptimeInput{builtin: f0, path: f1, pin: f2}
        }
        8 -> {
            f0: body_codec_get_declid(bytes, input)
            f1: body_codec_get_string(bytes, input)
            BodyHostCall.MemoStats{function: f0, bound: f1}
        }
        9 -> {
            f0: body_codec_get_string(bytes, input)
            BodyHostCall.ContextRead{field: f0}
        }
        10 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_int(bytes, input)
            f2: body_codec_get_bool(bytes, input)
            BodyHostCall.ContextGet{key: f0, default: f1, equatable: f2}
        }
        11 -> {
            f0: body_codec_get_int(bytes, input)
            BodyHostCall.DebugTrace{write: f0}
        }
        else -> BodyHostCall.SwitchSubjectValue
    }
}

