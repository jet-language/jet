            NodeKind.HandleMethod{receiver: f0, operation: f1, args: f2}
        }
        88 -> {
            f0: body_codec_get_bodycoreclosurekind(bytes, input)
            NodeKind.CoreClosureCall{kind: f0}
        }
        89 -> {
            f0: body_codec_get_int(bytes, input)
            NodeKind.TaskGroupAll{tasks: f0}
        }
        90 -> {
            f0: body_codec_get_int(bytes, input)
            NodeKind.TaskGroupRace{tasks: f0}
        }
        91 -> {
            f0: body_codec_get_int(bytes, input)
            NodeKind.TaskGroupAny{tasks: f0}
        }
        92 -> NodeKind.SelectStart
        93 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_int(bytes, input)
            NodeKind.SelectRecv{builder: f0, channel: f1}
        }
        94 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_int(bytes, input)
            f2: body_codec_get_opt_int(bytes, input)
            NodeKind.SelectAfter{builder: f0, duration: f1, value: f2}
        }
        95 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_bool(bytes, input)
            NodeKind.SelectWait{builder: f0, nonblocking: f1}
        }
        96 -> {
            f0: body_codec_get_bodyfnvaluekind(bytes, input)
            NodeKind.FnValue{kind: f0}
        }
        97 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_int(bytes, input)
            NodeKind.Never{reason: f0, line: f1}
        }
        98 -> {
            f0: body_codec_get_type(bytes, input)
            f1: body_codec_get_type(bytes, input)
            NodeKind.TypeTest{subject: f0, target: f1}
        }
        else -> NodeKind.Unit
    }
}

