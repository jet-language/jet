body_codec_put_tfunckind: fn(out: &BodyCodecOut, value: TFuncKind) Never! {
    if value == {
        .TopLevel -> { body_codec_put_tag(out, 0) }
        .Method(p0, p1) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_opt_accessconvention(out, p0)
            body_codec_put_type(out, p1)
        }
        .TraitMethod(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_bool(out, p0)
            body_codec_put_opt_accessconvention(out, p1)
            body_codec_put_type(out, p2)
            body_codec_put_symbolid(out, p3)
            body_codec_put_opt_tserdecodec(out, p4)
        }
    }
}

body_codec_get_tfunckind: fn(bytes: [U8], input: &BodyCodecIn) -> TFuncKind Never! {
    position: body_codec_get_tag(bytes, input, 3, 0)
    if position == {
        1 -> {
            f0: body_codec_get_opt_accessconvention(bytes, input)
            f1: body_codec_get_type(bytes, input)
            TFuncKind.Method{self_convention: f0, owner_type: f1}
        }
        2 -> {
            f0: body_codec_get_bool(bytes, input)
            f1: body_codec_get_opt_accessconvention(bytes, input)
            f2: body_codec_get_type(bytes, input)
            f3: body_codec_get_symbolid(bytes, input)
            f4: body_codec_get_opt_tserdecodec(bytes, input)
            TFuncKind.TraitMethod{is_unsafe: f0, self_convention: f1, owner_type: f2, trait_name: f3, serde_codec: f4}
        }
        else -> TFuncKind.TopLevel
    }
}

body_codec_put_tserdecodec: fn(out: &BodyCodecOut, value: TSerdeCodec) Never! {
    if value == {
        .Encode -> { body_codec_put_tag(out, 0) }
        .Decode -> body_codec_put_tag(out, 1)
    }
}

body_codec_get_tserdecodec: fn(bytes: [U8], input: &BodyCodecIn) -> TSerdeCodec Never! {
    position: body_codec_get_tag(bytes, input, 2, 0)
    if position == {
        1 -> TSerdeCodec.Decode
        else -> TSerdeCodec.Encode
    }
}

body_codec_put_toriginprojection: fn(out: &BodyCodecOut, value: TOriginProjection) Never! {
    body_codec_put_opt_string(out, value.receiver)
    body_codec_put_span(out, value.span)
    body_codec_put_tcomptimevalue(out, value.value)
}

body_codec_get_toriginprojection: fn(bytes: [U8], input: &BodyCodecIn) -> TOriginProjection Never! {
    f0: body_codec_get_opt_string(bytes, input)
    f1: body_codec_get_span(bytes, input)
    f2: body_codec_get_tcomptimevalue(bytes, input)
    TOriginProjection{receiver: f0, span: f1, value: f2}
}

body_codec_put_list_u8: fn(out: &BodyCodecOut, values: [U8]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_u8(out, value)
}

body_codec_get_list_u8: fn(bytes: [U8], input: &BodyCodecIn) -> [U8] Never! {
    count: body_codec_get_count(bytes, input, 1)
    values := [U8]{}
    loop _ in 0..<count -> values.push(body_codec_get_u8(bytes, input))
