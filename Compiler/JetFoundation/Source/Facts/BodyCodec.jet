body_codec_put_tintegerwidth: fn(out: ^BodyCodecOut, value: TIntegerWidth) Never! {
    body_codec_put_bool(out, value.signed)
    body_codec_put_int(out, value.bits)
}

body_codec_get_tintegerwidth: fn(bytes: [U8], input: ^BodyCodecIn) -> TIntegerWidth Never! {
    f0: body_codec_get_bool(bytes, input)
    f1: body_codec_get_int(bytes, input)
