        }
        35 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_int(bytes, input)
            f2: body_codec_get_int(bytes, input)
            f3: body_codec_get_opt_int(bytes, input)
            f4: body_codec_get_tpanicloc(bytes, input)
            NodeKind.Slice{base: f0, start: f1, end: f2, range: f3, location: f4}
        }
        36 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_int(bytes, input)
            f2: body_codec_get_bool(bytes, input)
            NodeKind.Range{start: f0, end: f1, exclusive: f2}
        }
        37 -> {
            f0: body_codec_get_list_int(bytes, input)
            NodeKind.Tuple{values: f0}
        }
        38 -> {
            f0: body_codec_get_list_int(bytes, input)
            f1: body_codec_get_opt_type(bytes, input)
            NodeKind.List{values: f0, trait_coercion: f1}
        }
        39 -> {
            f0: body_codec_get_list_bodymapentry(bytes, input)
            NodeKind.Map{entries: f0}
        }
        40 -> {
            f0: body_codec_get_symbolid(bytes, input)
            f1: body_codec_get_symbolid(bytes, input)
            f2: body_codec_get_bodyenumpayload(bytes, input)
            NodeKind.EnumCtor{owner: f0, variant: f1, payload: f2}
        }
        41 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_ttryconvert(bytes, input)
            f2: body_codec_get_tfailurecarrier(bytes, input)
            NodeKind.Try{value: f0, conversion: f1, failure: f2}
        }
        42 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_opt_int(bytes, input)
