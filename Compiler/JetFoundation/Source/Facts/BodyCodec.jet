        3 -> CopyFact.Scalar
        4 -> CopyFact.ViewMaterialize
        else -> CopyFact.Explicit
    }
}

body_codec_put_list_tpreludearg: fn(out: ^BodyCodecOut, values: [TPreludeArg]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_tpreludearg(out, value)
}

body_codec_get_list_tpreludearg: fn(bytes: [U8], input: ^BodyCodecIn) -> [TPreludeArg] Never! {
    count: body_codec_get_count(bytes, input, 1)
    ^values: [TPreludeArg]{}
    loop _ in 0..<count -> values.push(body_codec_get_tpreludearg(bytes, input))
    values
}

