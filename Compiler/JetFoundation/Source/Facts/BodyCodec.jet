    f2: body_codec_get_opt_tmethodref(bytes, input)
    f3: body_codec_get_opt_tmethodref(bytes, input)
    TTransactionSnapshot{local: f0, rollback_type: f1, snapshot_method: f2, restore_method: f3}
}

