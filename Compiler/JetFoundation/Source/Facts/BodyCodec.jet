    if value == .Val(inner) {
        body_codec_put_bool(out, true)
        body_codec_put_bodyunitrounding(out, inner)
        return
    }
    body_codec_put_bool(out, false)
}

body_codec_get_opt_bodyunitrounding: fn(bytes: [U8], input: ^BodyCodecIn) -> BodyUnitRounding? Never! {
    if body_codec_get_bool(bytes, input) {
        return Val(body_codec_get_bodyunitrounding(bytes, input))
    }
    None
}

body_codec_put_opt_float: fn(out: ^BodyCodecOut, value: Float?) Never! {
    if value == .Val(inner) {
        body_codec_put_bool(out, true)
        body_codec_put_float(out, inner)
        return
    }
    body_codec_put_bool(out, false)
}

body_codec_get_opt_float: fn(bytes: [U8], input: ^BodyCodecIn) -> Float? Never! {
    if body_codec_get_bool(bytes, input) -> return Val(body_codec_get_float(bytes, input))
    None
}

body_codec_put_list_binop: fn(out: ^BodyCodecOut, values: [BinOp]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_binop(out, value)
}

body_codec_get_list_binop: fn(bytes: [U8], input: ^BodyCodecIn) -> [BinOp] Never! {
    count: body_codec_get_count(bytes, input, 1)
    ^values: [BinOp]{}
    loop _ in 0..<count -> values.push(body_codec_get_binop(bytes, input))
    values
}

body_codec_put_list_bodystructfieldvalue: fn(out: ^BodyCodecOut, values: [BodyStructFieldValue]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_bodystructfieldvalue(out, value)
}

body_codec_get_list_bodystructfieldvalue: fn(bytes: [U8], input: ^BodyCodecIn) -> [BodyStructFieldValue] Never! {
    count: body_codec_get_count(bytes, input, 1)
    ^values: [BodyStructFieldValue]{}
    loop _ in 0..<count -> values.push(body_codec_get_bodystructfieldvalue(bytes, input))
    values
}

body_codec_put_list_bodymapentry: fn(out: ^BodyCodecOut, values: [BodyMapEntry]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_bodymapentry(out, value)
}

body_codec_get_list_bodymapentry: fn(bytes: [U8], input: ^BodyCodecIn) -> [BodyMapEntry] Never! {
    count: body_codec_get_count(bytes, input, 1)
    ^values: [BodyMapEntry]{}
    loop _ in 0..<count -> values.push(body_codec_get_bodymapentry(bytes, input))
    values
