body_codec_put_ttryconvert: fn(out: &BodyCodecOut, value: TTryConvert) Never! {
    if value == {
        .NoConversion -> { body_codec_put_tag(out, 0) }
        .Never -> { body_codec_put_tag(out, 1) }
        .DefaultErr -> { body_codec_put_tag(out, 2) }
        .Typed(p0, p1, p2) -> {
            body_codec_put_tag(out, 3)
            body_codec_put_string(out, p0)
            body_codec_put_type(out, p1)
            body_codec_put_type(out, p2)
        }
        .WidenUnion(p0, p1) -> {
            body_codec_put_tag(out, 4)
            body_codec_put_string(out, p0)
            body_codec_put_string(out, p1)
        }
        .RewidenUnion(p0) -> {
            body_codec_put_tag(out, 5)
            body_codec_put_string(out, p0)
        }
        .TypedIntoUnion(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 6)
            body_codec_put_string(out, p0)
            body_codec_put_type(out, p1)
            body_codec_put_type(out, p2)
            body_codec_put_string(out, p3)
            body_codec_put_string(out, p4)
        }
    }
}

body_codec_get_ttryconvert: fn(bytes: [U8], input: &BodyCodecIn) -> TTryConvert Never! {
    position: body_codec_get_tag(bytes, input, 7, 0)
    if position == {
        1 -> TTryConvert.Never
        2 -> TTryConvert.DefaultErr
        3 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_type(bytes, input)
            f2: body_codec_get_type(bytes, input)
            TTryConvert.Typed{fn_name: f0, source: f1, target: f2}
        }
        4 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_string(bytes, input)
            TTryConvert.WidenUnion{enum_name: f0, tag: f1}
        }
        5 -> {
            f0: body_codec_get_string(bytes, input)
            TTryConvert.RewidenUnion{enum_name: f0}
        }
        6 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_type(bytes, input)
            f2: body_codec_get_type(bytes, input)
            f3: body_codec_get_string(bytes, input)
            f4: body_codec_get_string(bytes, input)
            TTryConvert.TypedIntoUnion{fn_name: f0, source: f1, target: f2, enum_name: f3, tag: f4}
        }
        else -> TTryConvert.NoConversion
    }
}

