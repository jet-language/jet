    f2: body_codec_get_list_int(bytes, input)
    BodyRangeArm{lo: f0, hi: f1, body: f2}
}

body_codec_put_tforinmethod: fn(out: &BodyCodecOut, value: TForInMethod) Never! {
    if value == {
        .Chars -> { body_codec_put_tag(out, 0) }
        .LinesFile -> { body_codec_put_tag(out, 1) }
        .LinesStdin -> { body_codec_put_tag(out, 2) }
        .LinesProcessStream -> { body_codec_put_tag(out, 3) }
        .ChannelReceiver -> { body_codec_put_tag(out, 4) }
        .EncodingReader(p0) -> {
            body_codec_put_tag(out, 5)
            body_codec_put_string(out, p0)
        }
        .Iterable(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 6)
            body_codec_put_string(out, p0)
            body_codec_put_string(out, p1)
            body_codec_put_string(out, p2)
            body_codec_put_string(out, p3)
            body_codec_put_type(out, p4)
        }
    }
}

body_codec_get_tforinmethod: fn(bytes: [U8], input: &BodyCodecIn) -> TForInMethod Never! {
    position: body_codec_get_tag(bytes, input, 7, 0)
    if position == {
        1 -> TForInMethod.LinesFile
        2 -> TForInMethod.LinesStdin
        3 -> TForInMethod.LinesProcessStream
        4 -> TForInMethod.ChannelReceiver
        5 -> {
            f0: body_codec_get_string(bytes, input)
            TForInMethod.EncodingReader{reader_type: f0}
        }
        6 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_string(bytes, input)
            f2: body_codec_get_string(bytes, input)
            f3: body_codec_get_string(bytes, input)
            f4: body_codec_get_type(bytes, input)
            TForInMethod.Iterable{coll_type: f0, iter_type: f1, iter_symbol: f2, next_symbol: f3, item_type: f4}
        }
        else -> TForInMethod.Chars
    }
}

body_codec_put_tbranchclass: fn(out: &BodyCodecOut, value: TBranchClass) Never! {
    if value == {
        .Enum -> { body_codec_put_tag(out, 0) }
        .DenseInt -> body_codec_put_tag(out, 1)
    }
}

body_codec_get_tbranchclass: fn(bytes: [U8], input: &BodyCodecIn) -> TBranchClass Never! {
    position: body_codec_get_tag(bytes, input, 2, 0)
    if position == {
        1 -> TBranchClass.DenseInt
        else -> TBranchClass.Enum
    }
}

