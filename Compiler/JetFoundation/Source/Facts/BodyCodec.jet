    f8: body_codec_get_list_string(bytes, input)
    f9: body_codec_get_derivationdisposition(bytes, input)
    f10: body_codec_get_opt_derivationobservation(bytes, input)
    f11: body_codec_get_opt_derivationpayload(bytes, input)
    DerivationRecord{id: f0, subject: f1, claim: f2, producer: f3, method: f4, rule: f5, premises: f6, identity: f7, assumptions: f8, disposition: f9, observation: f10, payload: f11}
}

body_codec_put_derivationmethod: fn(out: ^BodyCodecOut, value: DerivationMethod) Never! {
    if value == {
        .StaticDerivation -> { body_codec_put_tag(out, 0) }
        .FormalProof -> { body_codec_put_tag(out, 1) }
        .RecordedExecution -> { body_codec_put_tag(out, 2) }
        .SampledAgreement -> { body_codec_put_tag(out, 3) }
        .ExternalAssumption -> body_codec_put_tag(out, 4)
    }
}

body_codec_get_derivationmethod: fn(bytes: [U8], input: ^BodyCodecIn) -> DerivationMethod Never! {
    position: body_codec_get_tag(bytes, input, 5, 0)
    if position == {
        1 -> DerivationMethod.FormalProof
        2 -> DerivationMethod.RecordedExecution
        3 -> DerivationMethod.SampledAgreement
        4 -> DerivationMethod.ExternalAssumption
        else -> DerivationMethod.StaticDerivation
    }
}

