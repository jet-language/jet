    body_codec_put_bool(out, value.spread)
}

body_codec_get_bodycallarg: fn(bytes: [U8], input: &BodyCodecIn) -> BodyCallArg Never! {
    f0: body_codec_get_int(bytes, input)
    f1: body_codec_get_list_symbolid(bytes, input)
    f2: body_codec_get_bool(bytes, input)
    f3: body_codec_get_bool(bytes, input)
    f4: body_codec_get_opt_tfncoerce(bytes, input)
    f5: body_codec_get_bool(bytes, input)
    f6: body_codec_get_opt_type(bytes, input)
    f7: body_codec_get_opt_type(bytes, input)
    f8: body_codec_get_opt_string(bytes, input)
    f9: body_codec_get_bool(bytes, input)
    BodyCallArg{value: f0, template_items: f1, borrow: f2, mut_borrow: f3, fn_coerce: f4, widen_to_vec: f5, widen_to_union: f6, box_as_trait: f7, label: f8, spread: f9}
}

