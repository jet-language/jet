}

body_codec_get_bodytree: fn(bytes: [U8], input: &BodyCodecIn) -> BodyTree Never! {
    f0: body_codec_get_list_bodynode(bytes, input)
    f1: body_codec_get_list_stmtkind(bytes, input)
    f2: body_codec_get_list_texprtype(bytes, input)
    f3: body_codec_get_typetable(bytes, input)
    f4: body_codec_get_int(bytes, input)
    f5: body_codec_get_int(bytes, input)
    f6: body_codec_get_symbollocalkeys(bytes, input)
    BodyTree{nodes: f0, stmts: f1, expr_types: f2, types: f3, node_base: f4, stmt_base: f5, symbols: f6}
}

body_codec_put_bodynode: fn(out: &BodyCodecOut, value: BodyNode) Never! {
    body_codec_put_int(out, value.id)
    body_codec_put_nodekind(out, value.kind)
    body_codec_put_span(out, value.span)
}

body_codec_get_bodynode: fn(bytes: [U8], input: &BodyCodecIn) -> BodyNode Never! {
    f0: body_codec_get_int(bytes, input)
    f1: body_codec_get_nodekind(bytes, input)
    f2: body_codec_get_span(bytes, input)
    BodyNode{id: f0, kind: f1, span: f2}
}

body_codec_put_opt_tintegerwidth: fn(out: &BodyCodecOut, value: TIntegerWidth?) Never! {
    if value == .Val(inner) {
        body_codec_put_bool(out, true)
        body_codec_put_tintegerwidth(out, inner)
        return
    }
    body_codec_put_bool(out, false)
}

body_codec_get_opt_tintegerwidth: fn(bytes: [U8], input: &BodyCodecIn) -> TIntegerWidth? Never! {
    if body_codec_get_bool(bytes, input) -> return Val(body_codec_get_tintegerwidth(bytes, input))
    None
}

body_codec_put_list_bodystrpart: fn(out: &BodyCodecOut, values: [BodyStrPart]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_bodystrpart(out, value)
}

body_codec_get_list_bodystrpart: fn(bytes: [U8], input: &BodyCodecIn) -> [BodyStrPart] Never! {
    count: body_codec_get_count(bytes, input, 1)
    values := [BodyStrPart]{}
    loop _ in 0..<count -> values.push(body_codec_get_bodystrpart(bytes, input))
    values
}

body_codec_put_list_bodycallarg: fn(out: &BodyCodecOut, values: [BodyCallArg]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_bodycallarg(out, value)
