body_codec_put_list_tdestructurebinding: fn(out: ^BodyCodecOut, values: [TDestructureBinding]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_tdestructurebinding(out, value)
}

body_codec_get_list_tdestructurebinding: fn(bytes: [U8], input: ^BodyCodecIn) -> [TDestructureBinding] Never! {
    count: body_codec_get_count(bytes, input, 1)
    ^values: [TDestructureBinding]{}
    loop _ in 0..<count -> values.push(body_codec_get_tdestructurebinding(bytes, input))
    values
}

body_codec_put_list_tlocal: fn(out: ^BodyCodecOut, values: [TLocal]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_tlocal(out, value)
}

body_codec_get_list_tlocal: fn(bytes: [U8], input: ^BodyCodecIn) -> [TLocal] Never! {
    count: body_codec_get_count(bytes, input, 1)
    ^values: [TLocal]{}
    loop _ in 0..<count -> values.push(body_codec_get_tlocal(bytes, input))
    values
}

