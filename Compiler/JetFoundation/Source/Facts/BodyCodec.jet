        17 -> {
            f0: body_codec_get_opt_string(bytes, input)
            f1: body_codec_get_int(bytes, input)
            f2: body_codec_get_list_int(bytes, input)
            f3: body_codec_get_span(bytes, input)
            StmtKind.While{label: f0, condition: f1, body: f2, span: f3}
        }
        18 -> {
            f0: body_codec_get_opt_string(bytes, input)
            f1: body_codec_get_span(bytes, input)
            StmtKind.Break{label: f0, span: f1}
