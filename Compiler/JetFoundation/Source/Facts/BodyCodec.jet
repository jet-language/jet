body_codec_put_bodystrpart: fn(out: ^BodyCodecOut, value: BodyStrPart) Never! {
    if value == {
        .Literal(p0) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_string(out, p0)
        }
        .Interpolation(p0, p1) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_int(out, p0)
            body_codec_put_bool(out, p1)
        }
    }
}

body_codec_get_bodystrpart: fn(bytes: [U8], input: ^BodyCodecIn) -> BodyStrPart Never! {
    position: body_codec_get_tag(bytes, input, 2, 0)
    if position == {
