    body_codec_put_span(out, value.span)
    body_codec_put_string(out, value.descriptor)
}

body_codec_get_bodyeffectscoperegion: fn(bytes: [U8], input: ^BodyCodecIn) -> BodyEffectScopeRegion Never! {
    f0: body_codec_get_span(bytes, input)
    f1: body_codec_get_string(bytes, input)
    BodyEffectScopeRegion{span: f0, descriptor: f1}
}

body_codec_put_list_bodynode: fn(out: ^BodyCodecOut, values: [BodyNode]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_bodynode(out, value)
}

body_codec_get_list_bodynode: fn(bytes: [U8], input: ^BodyCodecIn) -> [BodyNode] Never! {
    count: body_codec_get_count(bytes, input, 1)
    ^values: [BodyNode]{}
    loop _ in 0..<count -> values.push(body_codec_get_bodynode(bytes, input))
    values
}

body_codec_put_list_stmtkind: fn(out: ^BodyCodecOut, values: [StmtKind]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_stmtkind(out, value)
