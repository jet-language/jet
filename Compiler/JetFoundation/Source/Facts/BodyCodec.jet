body_codec_get_tpaniclocal: fn(bytes: [U8], input: &BodyCodecIn) -> TPanicLocal Never! {
    f0: body_codec_get_string(bytes, input)
    f1: body_codec_get_tlocal(bytes, input)
    TPanicLocal{display_name: f0, local: f1}
}

body_codec_put_tbinaryop: fn(out: &BodyCodecOut, value: TBinaryOp) Never! {
    if value == {
        .Add -> { body_codec_put_tag(out, 0) }
        .Sub -> { body_codec_put_tag(out, 1) }
        .Mul -> { body_codec_put_tag(out, 2) }
        .Div -> { body_codec_put_tag(out, 3) }
        .FloorDiv -> { body_codec_put_tag(out, 4) }
        .Mod -> { body_codec_put_tag(out, 5) }
        .Rem -> { body_codec_put_tag(out, 6) }
        .Pow -> { body_codec_put_tag(out, 7) }
        .BitAnd -> { body_codec_put_tag(out, 8) }
        .BitOr -> { body_codec_put_tag(out, 9) }
        .BitXor -> { body_codec_put_tag(out, 10) }
        .Shl -> { body_codec_put_tag(out, 11) }
        .Shr -> { body_codec_put_tag(out, 12) }
        .Eq -> { body_codec_put_tag(out, 13) }
        .Ne -> { body_codec_put_tag(out, 14) }
        .Lt -> { body_codec_put_tag(out, 15) }
        .Gt -> { body_codec_put_tag(out, 16) }
        .Le -> { body_codec_put_tag(out, 17) }
        .Ge -> { body_codec_put_tag(out, 18) }
        .Compare -> { body_codec_put_tag(out, 19) }
        .And -> { body_codec_put_tag(out, 20) }
        .Or -> body_codec_put_tag(out, 21)
    }
}

body_codec_get_tbinaryop: fn(bytes: [U8], input: &BodyCodecIn) -> TBinaryOp Never! {
    position: body_codec_get_tag(bytes, input, 22, 0)
    if position == {
        1 -> TBinaryOp.Sub
        2 -> TBinaryOp.Mul
        3 -> TBinaryOp.Div
        4 -> TBinaryOp.FloorDiv
        5 -> TBinaryOp.Mod
        6 -> TBinaryOp.Rem
        7 -> TBinaryOp.Pow
        8 -> TBinaryOp.BitAnd
        9 -> TBinaryOp.BitOr
        10 -> TBinaryOp.BitXor
        11 -> TBinaryOp.Shl
        12 -> TBinaryOp.Shr
        13 -> TBinaryOp.Eq
        14 -> TBinaryOp.Ne
        15 -> TBinaryOp.Lt
        16 -> TBinaryOp.Gt
        17 -> TBinaryOp.Le
        18 -> TBinaryOp.Ge
        19 -> TBinaryOp.Compare
        20 -> TBinaryOp.And
        21 -> TBinaryOp.Or
        else -> TBinaryOp.Add
    }
}

body_codec_put_tunaryop: fn(out: &BodyCodecOut, value: TUnaryOp) Never! {
    if value == {
        .Neg -> { body_codec_put_tag(out, 0) }
        .Not -> body_codec_put_tag(out, 1)
    }
}

body_codec_get_tunaryop: fn(bytes: [U8], input: &BodyCodecIn) -> TUnaryOp Never! {
    position: body_codec_get_tag(bytes, input, 2, 0)
    if position == {
        1 -> TUnaryOp.Not
        else -> TUnaryOp.Neg
    }
}

