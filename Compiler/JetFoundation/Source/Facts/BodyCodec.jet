body_codec_get_bodyhandleop: fn(bytes: [U8], input: &BodyCodecIn) -> BodyHandleOp Never! {
    position: body_codec_get_tag(bytes, input, 260, 2)
    if position == {
        0 -> {
            f0: body_codec_get_thardwarecall(bytes, input)
            BodyHandleOp.Hardware{operation: f0}
        }
        1 -> {
            f0: body_codec_get_string(bytes, input)
            f1: body_codec_get_bool(bytes, input)
            BodyHandleOp.DurationNew{unit: f0, float: f1}
        }
        3 -> {
            f0: body_codec_get_bool(bytes, input)
            BodyHandleOp.FileReaderRead{into: f0}
        }
        4 -> BodyHandleOp.FileReaderSeek
        5 -> BodyHandleOp.FileReaderPath
        6 -> BodyHandleOp.MappedFileWindow
        7 -> BodyHandleOp.MappedFileWindowLen
        8 -> BodyHandleOp.MappedFileLines
        9 -> BodyHandleOp.LinesIter
        10 -> BodyHandleOp.MappedFileLen
        11 -> BodyHandleOp.MappedFileIsEmpty
        12 -> BodyHandleOp.FileWriterWriteLine
        13 -> BodyHandleOp.FileWriterFlush
        14 -> BodyHandleOp.FileWriterWriteAll
        15 -> BodyHandleOp.FileWriterFsync
        16 -> BodyHandleOp.FileWriterPath
        17 -> BodyHandleOp.JSONReaderNext
        18 -> BodyHandleOp.JSONWriterWrite
        19 -> BodyHandleOp.JSONWriterFlush
        20 -> BodyHandleOp.JSONWriterFinish
        21 -> BodyHandleOp.JSONLReaderNext
        22 -> BodyHandleOp.JSONLWriterWrite
        23 -> BodyHandleOp.JSONLWriterFlush
