        }
        else -> {
            f0: body_codec_get_string(bytes, input)
            BodyStrPart.Literal{text: f0}
        }
    }
}

body_codec_put_sharedlifetime: fn(out: ^BodyCodecOut, value: SharedLifetime) Never! {
    if value == {
        .Process -> { body_codec_put_tag(out, 0) }
        .World -> { body_codec_put_tag(out, 1) }
        .Thread -> { body_codec_put_tag(out, 2) }
        .Attempt -> body_codec_put_tag(out, 3)
    }
}

body_codec_get_sharedlifetime: fn(bytes: [U8], input: ^BodyCodecIn) -> SharedLifetime Never! {
    position: body_codec_get_tag(bytes, input, 4, 0)
    if position == {
        1 -> SharedLifetime.World
        2 -> SharedLifetime.Thread
        3 -> SharedLifetime.Attempt
        else -> SharedLifetime.Process
    }
}

body_codec_put_opt_tfncoerce: fn(out: ^BodyCodecOut, value: TFnCoerce?) Never! {
    if value == .Val(inner) {
        body_codec_put_bool(out, true)
        body_codec_put_tfncoerce(out, inner)
        return
    }
    body_codec_put_bool(out, false)
}

body_codec_get_opt_tfncoerce: fn(bytes: [U8], input: ^BodyCodecIn) -> TFnCoerce? Never! {
    if body_codec_get_bool(bytes, input) -> return Val(body_codec_get_tfncoerce(bytes, input))
    None
}

body_codec_put_bodycallarg: fn(out: ^BodyCodecOut, value: BodyCallArg) Never! {
    body_codec_put_int(out, value.value)
    body_codec_put_list_symbolid(out, value.template_items)
    body_codec_put_bool(out, value.borrow)
    body_codec_put_bool(out, value.mut_borrow)
    body_codec_put_opt_tfncoerce(out, value.fn_coerce)
    body_codec_put_bool(out, value.widen_to_vec)
    body_codec_put_opt_type(out, value.widen_to_union)
    body_codec_put_opt_type(out, value.box_as_trait)
    body_codec_put_opt_string(out, value.label)
    body_codec_put_bool(out, value.spread)
}

body_codec_get_bodycallarg: fn(bytes: [U8], input: ^BodyCodecIn) -> BodyCallArg Never! {
    f0: body_codec_get_int(bytes, input)
    f1: body_codec_get_list_symbolid(bytes, input)
