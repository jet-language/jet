        return
    }
    body_codec_put_bool(out, false)
}

body_codec_get_opt_accessconvention: fn(bytes: [U8], input: ^BodyCodecIn) -> AccessConvention? Never! {
    if body_codec_get_bool(bytes, input) {
        return Val(body_codec_get_accessconvention(bytes, input))
    }
    None
}

body_codec_put_opt_tserdecodec: fn(out: ^BodyCodecOut, value: TSerdeCodec?) Never! {
    if value == .Val(inner) {
        body_codec_put_bool(out, true)
        body_codec_put_tserdecodec(out, inner)
        return
    }
    body_codec_put_bool(out, false)
}

body_codec_get_opt_tserdecodec: fn(bytes: [U8], input: ^BodyCodecIn) -> TSerdeCodec? Never! {
    if body_codec_get_bool(bytes, input) -> return Val(body_codec_get_tserdecodec(bytes, input))
    None
}

body_codec_put_tfunckind: fn(out: ^BodyCodecOut, value: TFuncKind) Never! {
    if value == {
        .TopLevel -> { body_codec_put_tag(out, 0) }
        .Method(p0, p1) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_opt_accessconvention(out, p0)
            body_codec_put_type(out, p1)
        }
        .TraitMethod(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_bool(out, p0)
            body_codec_put_opt_accessconvention(out, p1)
            body_codec_put_type(out, p2)
            body_codec_put_symbolid(out, p3)
            body_codec_put_opt_tserdecodec(out, p4)
        }
    }
}

body_codec_get_tfunckind: fn(bytes: [U8], input: ^BodyCodecIn) -> TFuncKind Never! {
    position: body_codec_get_tag(bytes, input, 3, 0)
    if position == {
        1 -> {
            f0: body_codec_get_opt_accessconvention(bytes, input)
            f1: body_codec_get_type(bytes, input)
            TFuncKind.Method{self_convention: f0, owner_type: f1}
        }
        2 -> {
            f0: body_codec_get_bool(bytes, input)
            f1: body_codec_get_opt_accessconvention(bytes, input)
            f2: body_codec_get_type(bytes, input)
            f3: body_codec_get_symbolid(bytes, input)
            f4: body_codec_get_opt_tserdecodec(bytes, input)
            TFuncKind.TraitMethod{is_unsafe: f0, self_convention: f1, owner_type: f2, trait_name: f3, serde_codec: f4}
        }
        else -> TFuncKind.TopLevel
    }
}

body_codec_put_tserdecodec: fn(out: ^BodyCodecOut, value: TSerdeCodec) Never! {
    if value == {
        .Encode -> { body_codec_put_tag(out, 0) }
        .Decode -> body_codec_put_tag(out, 1)
    }
}

body_codec_get_tserdecodec: fn(bytes: [U8], input: ^BodyCodecIn) -> TSerdeCodec Never! {
    position: body_codec_get_tag(bytes, input, 2, 0)
    if position == {
        1 -> TSerdeCodec.Decode
        else -> TSerdeCodec.Encode
    }
}

body_codec_put_toriginprojection: fn(out: ^BodyCodecOut, value: TOriginProjection) Never! {
    body_codec_put_opt_string(out, value.receiver)
    body_codec_put_span(out, value.span)
    body_codec_put_tcomptimevalue(out, value.value)
}

body_codec_get_toriginprojection: fn(bytes: [U8], input: ^BodyCodecIn) -> TOriginProjection Never! {
    f0: body_codec_get_opt_string(bytes, input)
    f1: body_codec_get_span(bytes, input)
    f2: body_codec_get_tcomptimevalue(bytes, input)
    TOriginProjection{receiver: f0, span: f1, value: f2}
}

body_codec_put_ttypedgoal: fn(out: ^BodyCodecOut, value: TTypedGoal) Never! {
    body_codec_put_span(out, value.span)
    body_codec_put_string(out, value.expected)
    body_codec_put_list_string(out, value.candidates)
}

body_codec_get_ttypedgoal: fn(bytes: [U8], input: ^BodyCodecIn) -> TTypedGoal Never! {
    f0: body_codec_get_span(bytes, input)
    f1: body_codec_get_string(bytes, input)
    f2: body_codec_get_list_string(bytes, input)
    TTypedGoal{span: f0, expected: f1, candidates: f2}
}

body_codec_put_tindexproof: fn(out: ^BodyCodecOut, value: TIndexProof) Never! {
    body_codec_put_span(out, value.span)
    body_codec_put_int(out, value.lo)
    body_codec_put_int(out, value.hi)
    body_codec_put_int(out, value.len)
}

body_codec_get_tindexproof: fn(bytes: [U8], input: ^BodyCodecIn) -> TIndexProof Never! {
    f0: body_codec_get_span(bytes, input)
    f1: body_codec_get_int(bytes, input)
    f2: body_codec_get_int(bytes, input)
    f3: body_codec_get_int(bytes, input)
    TIndexProof{span: f0, lo: f1, hi: f2, len: f3}
}

body_codec_put_bodycontract: fn(out: ^BodyCodecOut, value: BodyContract) Never! {
    body_codec_put_tcontractkind(out, value.kind)
    body_codec_put_int(out, value.condition)
    body_codec_put_int(out, value.message)
    body_codec_put_string(out, value.file)
    body_codec_put_int(out, value.line)
    body_codec_put_span(out, value.span)
    body_codec_put_tcontractdisposition(out, value.disposition)
    body_codec_put_tcontractsite(out, value.site)
}

body_codec_get_bodycontract: fn(bytes: [U8], input: ^BodyCodecIn) -> BodyContract Never! {
    f0: body_codec_get_tcontractkind(bytes, input)
    f1: body_codec_get_int(bytes, input)
    f2: body_codec_get_int(bytes, input)
    f3: body_codec_get_string(bytes, input)
    f4: body_codec_get_int(bytes, input)
    f5: body_codec_get_span(bytes, input)
    f6: body_codec_get_tcontractdisposition(bytes, input)
    f7: body_codec_get_tcontractsite(bytes, input)
    BodyContract{kind: f0, condition: f1, message: f2, file: f3, line: f4, span: f5, disposition: f6, site: f7}
}

body_codec_put_tcontractkind: fn(out: ^BodyCodecOut, value: TContractKind) Never! {
    if value == {
        .Pre -> { body_codec_put_tag(out, 0) }
        .Post -> body_codec_put_tag(out, 1)
    }
}

body_codec_get_tcontractkind: fn(bytes: [U8], input: ^BodyCodecIn) -> TContractKind Never! {
    position: body_codec_get_tag(bytes, input, 2, 0)
    if position == {
        1 -> TContractKind.Post
        else -> TContractKind.Pre
    }
}

body_codec_put_tcontractdisposition: fn(out: ^BodyCodecOut, value: TContractDisposition) Never! {
    if value == {
        .Check -> { body_codec_put_tag(out, 0) }
        .Proven -> { body_codec_put_tag(out, 1) }
        .Stripped -> body_codec_put_tag(out, 2)
    }
}

body_codec_get_tcontractdisposition: fn(bytes: [U8], input: ^BodyCodecIn) -> TContractDisposition Never! {
    position: body_codec_get_tag(bytes, input, 3, 0)
    if position == {
        1 -> TContractDisposition.Proven
        2 -> TContractDisposition.Stripped
        else -> TContractDisposition.Check
    }
}

body_codec_put_tcontractsite: fn(out: ^BodyCodecOut, value: TContractSite) Never! {
    body_codec_put_string(out, value.file)
    body_codec_put_int(out, value.line)
    body_codec_put_int(out, value.column)
    body_codec_put_bool(out, value.core)
}

body_codec_get_tcontractsite: fn(bytes: [U8], input: ^BodyCodecIn) -> TContractSite Never! {
    f0: body_codec_get_string(bytes, input)
    f1: body_codec_get_int(bytes, input)
    f2: body_codec_get_int(bytes, input)
    f3: body_codec_get_bool(bytes, input)
    TContractSite{file: f0, line: f1, column: f2, core: f3}
}

