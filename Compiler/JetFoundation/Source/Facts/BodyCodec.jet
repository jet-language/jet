    body_codec_put_opt_webpartitionmarker(out, value.web_marker)
    body_codec_put_string(out, value.endpoint)
    body_codec_put_string(out, value.system_run)
    body_codec_put_string(out, value.role)
    body_codec_put_namevisibility(out, value.visibility)
    body_codec_put_opt_tforeignprovenance(out, value.foreign)
    body_codec_put_list_bodyparameter(out, value.params)
    body_codec_put_list_twebparamreconstruction(out, value.web_param_reconstructions)
    body_codec_put_opt_type(out, value.ret)
    body_codec_put_bool(out, value.gc_return)
    body_codec_put_bool(out, value.gc_scope)
    body_codec_put_opt_viewprovenancemap(out, value.return_view_provenance)
    body_codec_put_opt_list_string(out, value.receiver_footprint)
    body_codec_put_list_tgenericparam(out, value.generic_params)
    body_codec_put_bool(out, value.is_main)
    body_codec_put_int(out, value.line)
    body_codec_put_bool(out, value.synthetic)
    body_codec_put_bool(out, value.is_unsafe)
    body_codec_put_opt_tunsafegate(out, value.unsafe_gate)
    body_codec_put_bool(out, value.is_pure)
    body_codec_put_opt_int(out, value.memo_bound)
    body_codec_put_bool(out, value.memo_unbounded)
    body_codec_put_bool(out, value.is_reactive)
    body_codec_put_list_string(out, value.reactive_upgrades)
    body_codec_put_bool(out, value.is_inline)
    body_codec_put_bool(out, value.is_inline_always)
    body_codec_put_bool(out, value.is_scalar)
    body_codec_put_opt_kernelproof(out, value.kernel_proof)
    body_codec_put_bool(out, value.uses_stack_sentry)
    body_codec_put_string(out, value.heap)
    body_codec_put_string(out, value.stack)
    body_codec_put_int(out, value.frame_bound)
    body_codec_put_int(out, value.max_depth)
    body_codec_put_list_int(out, value.body)
    body_codec_put_tfunckind(out, value.kind)
    body_codec_put_list_toriginprojection(out, value.origin_facts)
    body_codec_put_list_ttypedgoal(out, value.typed_goals)
    body_codec_put_list_tindexproof(out, value.index_proofs)
    body_codec_put_list_bodycontract(out, value.pre)
    body_codec_put_list_span(out, value.masked)
    body_codec_put_list_string(out, value.fixed_tags)
    body_codec_put_string(out, value.effect_scope)
    body_codec_put_list_bodyeffectscoperegion(out, value.effect_scope_regions)
    body_codec_put_bool(out, value.stand_in)
