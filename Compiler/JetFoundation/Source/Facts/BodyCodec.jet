body_codec_put_list_list_string: fn(out: ^BodyCodecOut, values: [[String]]) Never! {
    body_codec_put_count(out, values.len())
    loop value in values -> body_codec_put_list_string(out, value)
}

body_codec_get_list_list_string: fn(bytes: [U8], input: ^BodyCodecIn) -> [[String]] Never! {
    count: body_codec_get_count(bytes, input, 1)
    ^values: [[String]]{}
    loop _ in 0..<count -> values.push(body_codec_get_list_string(bytes, input))
    values
}

body_codec_put_bodyhostcall: fn(out: ^BodyCodecOut, value: BodyHostCall) Never! {
    if value == {
        .Method(p0, p1, p2) -> {
            body_codec_put_tag(out, 0)
            body_codec_put_int(out, p0)
            body_codec_put_string(out, p1)
            body_codec_put_list_int(out, p2)
        }
        .CellGuardProject(p0, p1, p2, p3, p4) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_int(out, p0)
            body_codec_put_list_list_string(out, p1)
            body_codec_put_type(out, p2)
            body_codec_put_bool(out, p3)
            body_codec_put_bool(out, p4)
        }
        .OptionProbe(p0, p1) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_int(out, p0)
            body_codec_put_toptionprobe(out, p1)
        }
        .TupleIndex(p0, p1) -> {
            body_codec_put_tag(out, 3)
            body_codec_put_int(out, p0)
            body_codec_put_int(out, p1)
        }
        .SwitchSubjectValue -> { body_codec_put_tag(out, 4) }
        .YieldSend(p0) -> {
            body_codec_put_tag(out, 5)
            body_codec_put_int(out, p0)
        }
        .NumericBounds(p0, p1) -> {
            body_codec_put_tag(out, 6)
            body_codec_put_type(out, p0)
            body_codec_put_string(out, p1)
        }
        .ComptimeInput(p0, p1, p2) -> {
            body_codec_put_tag(out, 7)
            body_codec_put_string(out, p0)
            body_codec_put_int(out, p1)
            body_codec_put_opt_string(out, p2)
        }
        .MemoStats(p0, p1) -> {
            body_codec_put_tag(out, 8)
            body_codec_put_declid(out, p0)
            body_codec_put_string(out, p1)
        }
        .ContextRead(p0) -> {
            body_codec_put_tag(out, 9)
            body_codec_put_string(out, p0)
        }
        .ContextGet(p0, p1, p2) -> {
            body_codec_put_tag(out, 10)
            body_codec_put_string(out, p0)
            body_codec_put_int(out, p1)
            body_codec_put_bool(out, p2)
        }
        .DebugTrace(p0) -> {
            body_codec_put_tag(out, 11)
