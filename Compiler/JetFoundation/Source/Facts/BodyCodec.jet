body_codec_get_list_bodypatternshape: fn(bytes: [U8], input: ^BodyCodecIn) -> [BodyPatternShape] Never! {
    count: body_codec_get_count(bytes, input, 1)
    ^values: [BodyPatternShape]{}
    loop _ in 0..<count -> values.push(body_codec_get_bodypatternshape(bytes, input))
    values
}

