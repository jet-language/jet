    body_codec_put_list_int(out, value.proven_indexes)
}

body_codec_get_autovectorizationfacts: fn(bytes: [U8], input: &BodyCodecIn) -> AutoVectorizationFacts Never! {
    f0: body_codec_get_type(bytes, input)
    f1: body_codec_get_bool(bytes, input)
    f2: body_codec_get_bool(bytes, input)
    f3: body_codec_get_bool(bytes, input)
    f4: body_codec_get_bool(bytes, input)
    f5: body_codec_get_opt_int(bytes, input)
    f6: body_codec_get_list_int(bytes, input)
    AutoVectorizationFacts{element_type: f0, no_aliasing: f1, no_early_exit: f2, effect_free_body: f3, no_cross_iteration_deps: f4, extent: f5, proven_indexes: f6}
}

