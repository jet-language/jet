body_codec_put_bodyscopememberkind: fn(out: ^BodyCodecOut, value: BodyScopeMemberKind) Never! {
    if value == {
        .Setup -> { body_codec_put_tag(out, 0) }
        .ExpectFail(p0, p1) -> {
            body_codec_put_tag(out, 1)
            body_codec_put_opt_string(out, p0)
            body_codec_put_opt_string(out, p1)
        }
        .Timeout(p0) -> {
            body_codec_put_tag(out, 2)
            body_codec_put_int(out, p0)
        }
        .Measure -> { body_codec_put_tag(out, 3) }
        .Skip -> body_codec_put_tag(out, 4)
    }
}

body_codec_get_bodyscopememberkind: fn(bytes: [U8], input: ^BodyCodecIn) -> BodyScopeMemberKind Never! {
    position: body_codec_get_tag(bytes, input, 5, 0)
    if position == {
        1 -> {
            f0: body_codec_get_opt_string(bytes, input)
            f1: body_codec_get_opt_string(bytes, input)
            BodyScopeMemberKind.ExpectFail{code: f0, message: f1}
        }
        2 -> {
            f0: body_codec_get_int(bytes, input)
            BodyScopeMemberKind.Timeout{duration: f0}
        }
        3 -> BodyScopeMemberKind.Measure
        4 -> BodyScopeMemberKind.Skip
        else -> BodyScopeMemberKind.Setup
    }
}

