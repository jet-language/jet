    }
}

body_codec_get_copyfact: fn(bytes: [U8], input: ^BodyCodecIn) -> CopyFact Never! {
    position: body_codec_get_tag(bytes, input, 5, 0)
    if position == {
        1 -> CopyFact.Materialize
