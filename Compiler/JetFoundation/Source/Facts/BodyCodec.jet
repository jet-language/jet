body_codec_get_nodekind: fn(bytes: [U8], input: ^BodyCodecIn) -> NodeKind Never! {
    position: body_codec_get_tag(bytes, input, 99, 6)
    if position == {
        0 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_opt_tintegerwidth(bytes, input)
            NodeKind.IntLit{value: f0, width: f1}
        }
        1 -> {
            f0: body_codec_get_float(bytes, input)
            NodeKind.FloatLit{value: f0}
        }
        2 -> {
            f0: body_codec_get_bool(bytes, input)
            NodeKind.BoolLit{value: f0}
        }
        3 -> {
            f0: body_codec_get_int(bytes, input)
            NodeKind.CharLit{value: f0}
        }
        4 -> {
            f0: body_codec_get_list_bodystrpart(bytes, input)
            NodeKind.StrLit{parts: f0}
        }
        5 -> {
            f0: body_codec_get_tlocal(bytes, input)
            NodeKind.Local{local: f0}
        }
        7 -> {
            f0: body_codec_get_list_int(bytes, input)
            NodeKind.InlineBlock{body: f0}
        }
        8 -> NodeKind.Uninit
        9 -> {
            f0: body_codec_get_tcomptimevalue(bytes, input)
            NodeKind.CtLit{value: f0}
        }
        10 -> {
            f0: body_codec_get_symbolid(bytes, input)
            NodeKind.ConstRef{symbol: f0}
        }
        11 -> {
            f0: body_codec_get_type(bytes, input)
            f1: body_codec_get_string(bytes, input)
            f2: body_codec_get_string(bytes, input)
            NodeKind.TraitConst{owner: f0, trait_name: f1, name: f2}
        }
        12 -> {
            f0: body_codec_get_type(bytes, input)
            NodeKind.NumberParam{param: f0}
        }
        13 -> {
            f0: body_codec_get_symbolid(bytes, input)
            f1: body_codec_get_symbolid(bytes, input)
            f2: body_codec_get_symbolid(bytes, input)
            f3: body_codec_get_symbolid(bytes, input)
            NodeKind.CopyPhase{owner: f0, preparation: f1, build: f2, runtime: f3}
        }
        14 -> {
            f0: body_codec_get_declid(bytes, input)
            f1: body_codec_get_sharedlifetime(bytes, input)
            NodeKind.GlobalShared{initializer: f0, lifetime: f1}
        }
        15 -> {
            f0: body_codec_get_declid(bytes, input)
            f1: body_codec_get_list_type(bytes, input)
            f2: body_codec_get_list_bodycallarg(bytes, input)
            NodeKind.Call{callee: f0, type_args: f1, args: f2}
        }
        16 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_list_type(bytes, input)
            f2: body_codec_get_list_bodycallarg(bytes, input)
            f3: body_codec_get_type(bytes, input)
            NodeKind.IndirectCall{callee: f0, type_args: f1, args: f2, signature: f3}
        }
        17 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_tmethodref(bytes, input)
            f2: body_codec_get_list_type(bytes, input)
            f3: body_codec_get_list_bodycallarg(bytes, input)
            NodeKind.MethodCall{receiver: f0, method: f1, type_args: f2, args: f3}
        }
        18 -> {
            f0: body_codec_get_int(bytes, input)
            NodeKind.DistinctCtor{argument: f0}
        }
        19 -> {
            f0: body_codec_get_symbolid(bytes, input)
            f1: body_codec_get_int(bytes, input)
            f2: body_codec_get_tnumericop(bytes, input)
            f3: body_codec_get_opt_tintegerbounds(bytes, input)
            f4: body_codec_get_bool(bytes, input)
            NodeKind.DistinctConvert{owner: f0, argument: f1, operation: f2, range: f3, fallible: f4}
        }
        20 -> {
            f0: body_codec_get_int(bytes, input)
            f1: body_codec_get_type(bytes, input)
            NodeKind.TraitBox{value: f0, target: f1}
        }
        21 -> {
            f0: body_codec_get_int(bytes, input)
