// Compile-time values: what comptime evaluation hands to the checker, the
// evaluator and the backends. They hold no checked-tree nodes.

TComptimeMapEntry: struct {
    key: TComptimeKey,
    value: TComptimeValue,
}

TComptimeKey: enum {
    Int(value: Int),
    BigInt(decimal: String),
    String(value: String),
    Bool(value: Bool),
    Char(value: Int),
    Tuple(fields: [TComptimeKeyField]),
    Struct(type_name: String, fields: [TComptimeKeyField]),
    Enum(type_name: String, variant: String),
}

// An Int outside the i64 word is keyed by its BigInt decimal.
checked_comptime_integer_key: fn(number: Int) -> TComptimeKey Never! {
    if number < -9223372036854775807 - 1 || number > 9223372036854775807 {
        return TComptimeKey.BigInt{decimal: "{number}"}
    }
    TComptimeKey.Int{value: number}
}

TComptimeKeyField: struct {
    name: String,
    key: TComptimeKey,
}

TComptimeField: struct {
    name: String,
    value: TComptimeValue,
}

TComptimeEnumArg: struct {
    name: String?,
    value: TComptimeValue,
}

TComptimeReport: enum {
    Clean(ty: Type),
    Told(value: TComptimeValue),
}

// `Function` is a named function as a value (`f: double`), by its function
// key: the program makes the function value where it reads the constant.
TComptimeValue: enum {
    Int(value: Int),
    Float(value: Float, bits: Int),
    Bool(value: Bool),
    Char(value: Int),
    String(value: String),
    BigInt(decimal: String),
    Bytes(value: [U8]),
    List(values: [TComptimeValue]),
    Map(entries: [TComptimeMapEntry]),
    Struct(type_name: String, fields: [TComptimeField]),
    Enum(type_name: String, variant: String, args: [TComptimeEnumArg]),
    Present(value: TComptimeValue),
    Failed(report: TComptimeReport),
    Unit,
    Function(key: String),
}

// The UTF-8 text of a comptime Char's Unicode scalar value, as
// `core.text.fmt.display` renders it.
comptime_char_text: fn(code: Int) -> String Never! {
    ^bytes: [U8]{}
    if {
        code < 128 -> bytes.push(U8{code})
        code < 2048 -> {
            bytes.push(U8{(192) | (code >> 6)})
            bytes.push(U8{(128) | ((code) & 63)})
        }
        code < 65536 -> {
            bytes.push(U8{(224) | (code >> 12)})
            bytes.push(U8{(128) | (((code >> 6)) & 63)})
            bytes.push(U8{(128) | ((code) & 63)})
        }
        else -> {
            bytes.push(U8{(240) | (code >> 18)})
            bytes.push(U8{(128) | (((code >> 12)) & 63)})
            bytes.push(U8{(128) | (((code >> 6)) & 63)})
            bytes.push(U8{(128) | ((code) & 63)})
        }
    }
    String.from_bytes(bytes) ?? ""
}

// A compile-time TypeId: a handle to its type's row in the compilation's
// Interner, the row of the type keyed by the checker's canonical key, and
// the table that issued it (COMPTIME_TYPE_ID_COMPILATION, the compilation's
// own). Each fact of the type is read from that row, never held here.
COMPTIME_TYPE_ID_COMPILATION: 0

comptime_type_id: fn(id: TypeID) -> TComptimeValue Never! {
    TComptimeValue.Struct{
        type_name: "TypeId",
        fields: [TComptimeField]{
            TComptimeField{name: "handle", value: TComptimeValue.Int{value: Int{id.id}}},
            TComptimeField{name: "table", value: TComptimeValue.Int{value: COMPTIME_TYPE_ID_COMPILATION}},
        },
    }
}

// The type row a compile-time TypeId (comptime_type_id) names; None for any
// other value and for a TypeId another table issued.
comptime_type_id_row: fn(value: TComptimeValue) -> TypeID? Never! {
    ^row: 0
    ^table: -1
    if value == .Struct(type_name, fields) && type_name == "TypeId" {
        loop field in fields {
            if field.name == "handle" && field.value == .Int(number) -> row = number
            if field.name == "table" && field.value == .Int(number) -> table = number
        }
    }
    if table == COMPTIME_TYPE_ID_COMPILATION && row > 0 -> return Val(TypeID{id: U32{row}})
    None
}

// Renumbers each TypeId handle `value` holds, at any depth, that names a
// worker's own row through `remap` (interner_merge_delta): a worker made it
// while checking, and its row moved into the compilation's interner.
comptime_value_remap_types: fn(value: ^TComptimeValue, remap: InternerRemap) Never! {
    if value.in_place() == {
        .Struct(type_name, fields) -> {
            loop index in 0..<fields.len() {
                if {
                    type_name != "TypeId" || fields[index].name != "handle" -> {
                        comptime_value_remap_types(fields[index].value, remap)
                    }
                    fields[index].value == .Int(row) && row >= remap.marks.types -> {
                        fields[index].value = TComptimeValue.Int{value: Int{remap.types[row - remap.marks.types].id}}
                    }
                    else -> {}
                }
            }
        }
        .List(values) -> {
            loop index in 0..<values.len() -> comptime_value_remap_types(values[index], remap)
        }
        .Map(entries) -> {
            loop index in 0..<entries.len() {
                comptime_value_remap_types(entries[index].value, remap)
            }
        }
        .Enum(_, _, args) -> {
            loop index in 0..<args.len() -> comptime_value_remap_types(args[index].value, remap)
        }
        .Present(inner) -> { comptime_value_remap_types(inner, remap) }
        .Failed(report) -> {
            if report.in_place() == .Told(told) -> comptime_value_remap_types(told, remap)
        }
        .Int(_) | .Float(_, _) | .Bool(_) | .Char(_) | .String(_) | .BigInt(_) | .Bytes(_) | .Unit | .Function(_) -> {}
    }
}

// Whether `value` holds, at any depth, a TypeId handle at or past row `mark`:
// one a worker's own rows name until they merge.
comptime_value_holds_types_from: fn(value: TComptimeValue, mark: Int) -> Bool Never! {
    if value == {
        .Struct(type_name, fields) -> {
            loop field in fields {
                if type_name == "TypeId" && field.name == "handle" && field.value == .Int(row) && row >= mark {
                    return true
                }
                if comptime_value_holds_types_from(field.value, mark) -> return true
            }
        }
        .List(values) -> {
            loop item in values {
                if comptime_value_holds_types_from(item, mark) -> return true
            }
        }
        .Map(entries) -> {
            loop entry in entries {
                if comptime_value_holds_types_from(entry.value, mark) -> return true
            }
        }
        .Enum(_, _, args) -> {
            loop arg in args {
                if comptime_value_holds_types_from(arg.value, mark) -> return true
            }
        }
        .Present(inner) -> return comptime_value_holds_types_from(inner, mark)
        .Failed(report) -> {
            if report == .Told(told) -> return comptime_value_holds_types_from(told, mark)
        }
        .Int(_) | .Float(_, _) | .Bool(_) | .Char(_) | .String(_) | .BigInt(_) | .Bytes(_) | .Unit | .Function(_) -> {}
    }
    false
}

#Test("a merge renumbers a worker's TypeId handles at any depth in a compile-time value") {
    remap: InternerRemap{marks: InternerMarks{types: 100}, names: [Name]{}, types: [TypeID]{TypeID{id: U32{40}}, TypeID{id: U32{41}}}}
    ^value: TComptimeValue.Struct{
        type_name: "TypeInfo",
        fields: [TComptimeField]{
            TComptimeField{name: "identity", value: comptime_type_id(TypeID{id: U32{101}})},
            TComptimeField{name: "fields", value: TComptimeValue.List{values: [TComptimeValue]{TComptimeValue.Present{value: comptime_type_id(TypeID{id: U32{7}})}, comptime_type_id(TypeID{id: U32{100}})}}},
        },
    }
    assert(comptime_value_holds_types_from(value, 100))
    comptime_value_remap_types(value, remap)
    assert(!comptime_value_holds_types_from(value, 100))
    expected: TComptimeValue.Struct{
        type_name: "TypeInfo",
        fields: [TComptimeField]{
            TComptimeField{name: "identity", value: comptime_type_id(TypeID{id: U32{41}})},
            TComptimeField{name: "fields", value: TComptimeValue.List{values: [TComptimeValue]{TComptimeValue.Present{value: comptime_type_id(TypeID{id: U32{7}})}, comptime_type_id(TypeID{id: U32{40}})}}},
        },
    }
    assert(value == expected)
    assert_eq(comptime_type_id_row(comptime_type_id(TypeID{id: U32{7}})), Val(TypeID{id: U32{7}}))
    assert(comptime_type_id_row(TComptimeValue.Int{value: 7}) == None)
}
