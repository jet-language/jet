// Compile-time values: what comptime evaluation hands to the checker, the
// evaluator and the backends. They hold no checked-tree nodes.

TComptimeMapEntry: struct {
    key: TComptimeKey
    value: TComptimeValue
}

TComptimeKey: enum {
    Int(value: Int)
    BigInt(decimal: String)
    String(value: String)
    Bool(value: Bool)
    Char(value: Int)
    Tuple(fields: [TComptimeKeyField])
    Struct(type_name: String, fields: [TComptimeKeyField])
    Enum(type_name: String, variant: String)
}

// An Int outside the i64 word is keyed by its BigInt decimal.
checked_comptime_integer_key: fn(number: Int) -> TComptimeKey Never! {
    if number < -9223372036854775807 - 1 || number > 9223372036854775807 -> return TComptimeKey.BigInt{decimal: "{number}"}
    TComptimeKey.Int{value: number}
}

TComptimeKeyField: struct {
    name: String
    key: TComptimeKey
}

TComptimeField: struct {
    name: String
    value: TComptimeValue
}

TComptimeEnumArg: struct {
    name: String?
    value: TComptimeValue
}

TComptimeReport: enum {
    Clean(ty: Type)
    Told(value: TComptimeValue)
}

TComptimeValue: enum {
    Int(value: Int)
    Float(value: Float, bits: Int)
    Bool(value: Bool)
    Char(value: Int)
    String(value: String)
    BigInt(decimal: String)
    Bytes(value: [U8])
    List(values: [TComptimeValue])
    Map(entries: [TComptimeMapEntry])
    Struct(type_name: String, fields: [TComptimeField])
    Enum(type_name: String, variant: String, args: [TComptimeEnumArg])
    Present(value: TComptimeValue)
    Failed(report: TComptimeReport)
    Unit
}

// The UTF-8 text of a comptime Char's Unicode scalar value, as
// `core.text.fmt.display` renders it.
comptime_char_text: fn(code: Int) -> String Never! {
    bytes := [U8]{}
    if {
        code < 128 -> bytes.push(U8{code})
        code < 2048 -> {
            bytes.push(U8{(192).bit_or((code >> 6))})
            bytes.push(U8{(128).bit_or(((code).bit_and(63)))})
        }
        code < 65536 -> {
            bytes.push(U8{(224).bit_or((code >> 12))})
            bytes.push(U8{(128).bit_or((((code >> 6)).bit_and(63)))})
            bytes.push(U8{(128).bit_or(((code).bit_and(63)))})
        }
        else -> {
            bytes.push(U8{(240).bit_or((code >> 18))})
            bytes.push(U8{(128).bit_or((((code >> 12)).bit_and(63)))})
            bytes.push(U8{(128).bit_or((((code >> 6)).bit_and(63)))})
            bytes.push(U8{(128).bit_or(((code).bit_and(63)))})
        }
    }
    String.from_bytes(bytes) ?? ""
}
