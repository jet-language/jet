// Declaration facts the checker records for effects, types, traits, impls and
// constants. They hold no checked-tree nodes.

TEffectSpan: struct {
    name: String
    span: Span
    // A state write (TEffectFacts.module_writes) through a cell the body
    // holds, `name` being the parameter or local, rather than a module
    // binding written by name.
    held: Bool{false}
}

TEffectFacts: struct {
    direct: [String]
    solved: [String]
    call_edges: [String]
    maximal: Bool
    direct_spans: [TEffectSpan]
    // Where this function's own body made its row maximal (a call with no
    // known body), when it did.
    maximal_span: Span?{None}
    // The functions this body takes as values (a named function read, a
    // trait-object dispatch's implementations), which it may call later through
    // the value. They are not calls, so they never widen this row; the
    // application's effect list follows them as well as `call_edges`.
    value_edges: [String]{[String]{}}
    // The state this body writes (`name` and the write's span): a module
    // `:=` binding, a module `Shared` holder or `Cell`, or a cell held in a
    // parameter or local (`held`). It is no effect, but a pure function may
    // not reach one.
    module_writes: [TEffectSpan]{[TEffectSpan]{}}
}

TVisibility: enum {
    Private
    Package
    Public
}

TForeignProvenance: struct {
    language: String
    abi: String
    symbol: String
    span: Span
}

TGenericParam: struct {
    name: String
    bounds: [SymbolID]
    // A `<N: Int>` number parameter: an instance binds it to a
    // Type.Measure length, and a body reads `N` as that Int.
    number: Bool{false}
}
TDeclarationFacts: struct {
    type_defs: [TTypeDef]
    traits: [TTraitDef]
    impls: [TImplDef]
    constants: [TConstantDef]
    core_builtin_owners: [TCoreBuiltinOwner]
}

TDeclarationOwnership: enum {
    Owned
    ReadBorrow
    WriteBorrow
    Move
}
TCoreBuiltinOwner: struct {
    symbol: SymbolID
    module_identity: String?
    name: String
    ownership: TDeclarationOwnership
}

TStructLayout: enum {
    C
    CAligned(alignment: Int, target: Bool)
    Columnar
}

TCEnumTag: enum {
    CInt
    U8
    I8
    U16
    I16
    U32
    I32
    U64
    I64
}

TLayoutAlignmentFact: struct {
    requested_alignment: Int
    effective_alignment: Int
    target_mode: Bool
    target_profile: String
    fact_identity: String
}

TShapeFieldNames: struct {
    text: String
    json: String?
    cbor: String?
    csv: String?
    toml: String?
    yaml: String?
    xml: String?
    args: String
    env: String
    db: String?
    layout: String?
}

TIntegerRange: struct {
    lo: Int
    hi: Int
}

TSerdeAttributeKind: enum {
    RenameAll
    Tag
    Untagged
    DenyUnknownFields
}

TSerdeAttribute: struct {
    kind: TSerdeAttributeKind
    value: String?
    span: Span
}

TFunctionRef: struct {
    key: String
    module_identity: String
    name: String
    span: Span
    visibility: TVisibility
}
TCLIBinding: struct {
    name: String
    span: Span
    function_key: String
    markers: [String]
}

TField: struct {
    name: String
    shape_names: TShapeFieldNames
    skip: Bool
    ty: Type
    span: Span
    public: Bool
    package_public: Bool
    computed: Bool
    has_default: Bool
    redact: Bool
}

TVariantPayload: enum {
    Unit
    Single(value: Type)
    Named(fields: [TField])
}

TVariant: struct {
    name: String
    wire_name: String
    span: Span
    payload: TVariantPayload
    discriminant: Int?
}

TTypeDefKind: enum {
    Struct(fields: [TField], methods: [String])
    Enum(variants: [TVariant], methods: [String])
    Distinct(base: Type, range: TIntegerRange?)
    Alias(target: Type)
    // `base`: the member a dimensioned quantity is shown in.
    UnitFamily(members: [String], base: String?)
}
TCompilerBuiltin: enum { DefaultErr }

TTypeDef: struct {
    module_identity: String
    key: String
    name: String
    span: Span
    public: Bool
    package_public: Bool
    generic_params: [TGenericParam]
    derives: [String]
    auto_derive_default: Bool
    auto_printable: Bool
    published_schema: Bool
    single_use: Bool
    must_use: Bool
    layout: TStructLayout?
    c_layout_tag: TCEnumTag?
    enum_layout: LayoutFacts?
    layout_alignment: TLayoutAlignmentFact?
    serde: [TSerdeAttribute]
    cli_bindings: [TCLIBinding]
    ownership: TDeclarationOwnership
    boxed_edges: [String]
    compiler_builtin: TCompilerBuiltin?
    // A `#Specified` enum: every case states its number, and a Set of it
    // stored as bits crosses with each case as its own value.
    specified: Bool{false}
    kind: TTypeDefKind
}

TAssociatedTypeDecl: struct {
    name: String
    span: Span
}

TAssociatedTypeValue: struct {
    name: String
    ty: Type
    span: Span
}

TDeclarationParam: struct {
    index: Int
    name: String
    span: Span
    ty: Type
    access: AccessConvention
    ownership: TDeclarationOwnership
    public_label: String
    variadic: Bool
    default_present: Bool
}

TTraitMethod: struct {
    key: String
    name: String
    span: Span
    self_access: AccessConvention?
    params: [TDeclarationParam]
    declared_return: Type?
    return_type: Type
    failure: TFailureCarrier
    is_pure: Bool
    declared_effects: [TEffectSpan]?
    return_view_provenance: ViewProvenanceMap?
    declared_return_view_provenance: ViewProvenanceMap?
    default_function_key: String?
}

TTraitDef: struct {
    module_identity: String
    key: String
    name: String
    span: Span
    visibility: TVisibility
    associated_types: [TAssociatedTypeDecl]
    methods: [TTraitMethod]
}

// The OSes a build runs on: the one list `#Target(OS.*)`, a `#build.target.os`
// dispatch and the `os` build option read. Linux, macOS and Windows are the
// native OSes; a web build runs in the browser, a Wasm build on a WebAssembly
// host such as WASI, and a freestanding build on bare metal with no OS.
TTargetOS: enum {
    Linux
    MacOS
    Windows
    Web
    Wasm
    Freestanding
}

TARGET_OS_ALL: #run { [TTargetOS]{TTargetOS.Linux, TTargetOS.MacOS, TTargetOS.Windows, TTargetOS.Web, TTargetOS.Wasm, TTargetOS.Freestanding} }

// `OS.MacOS` is `MacOS`.
target_os_name: fn(os: TTargetOS) -> String Never! {
    if os == {
        .Linux -> "Linux"
        .MacOS -> "MacOS"
        .Windows -> "Windows"
        .Web -> "Web"
        .Wasm -> "Wasm"
        .Freestanding -> "Freestanding"
    }
}

// The gates of the list, as `#Target` writes them: `OS.Linux`, `OS.MacOS`, … .
target_os_gates: fn() -> String Never! {
    gates: loop os in TARGET_OS_ALL -> "`OS.{target_os_name(os)}`"
    gates.join(", ")
}

// The `os` build option value and the impl gate spelling: `macos`.
target_os_key: fn(os: TTargetOS) -> String Never! {
    target_os_name(os).lower()
}

// Whether a host triple can name `os`: Linux, macOS and Windows are native;
// a web, Wasm or freestanding build names its OS through its target.
target_os_native: fn(os: TTargetOS) -> Bool Never! {
    if os == {
        .Linux | .MacOS | .Windows -> true
        .Web | .Wasm | .Freestanding -> false
    }
}

// The OS a bare variant name (`MacOS`) names.
target_os_named: fn(name: String) -> TTargetOS? Never! {
    loop os in TARGET_OS_ALL {
        if target_os_name(os) == name -> return Val(os)
    }
    None
}

// The OS a variant name (`MacOS`), a qualified one (`OS.MacOS`) or a key
// (`macos`) names; None for any other text.
target_os_parse: fn(text: String) -> TTargetOS? Never! {
    bare: if text.starts_with("OS.") -> text.slice(3, text.len()) else -> text
    loop os in TARGET_OS_ALL {
        if bare == target_os_name(os) || bare == target_os_key(os) -> return Val(os)
    }
    None
}

TOperatorMarker: enum {
    Commutative
}

TImplDef: struct {
    module_identity: String
    key: String
    span: Span
    self_type: Type
    trait_name: String?
    trait_ref: String?
    associated_types: [TAssociatedTypeValue]
    // Every constant of the implemented trait: the value the implementation
    // writes, else the trait's default.
    constants: [TTraitConstantValue]
    methods: [String]
    delegation_field: String?
    compiler_generated: Bool
    serde: TSerdeCodec?
    operator_rhs: Type?
    operator_marker: TOperatorMarker?
    target_os: TTargetOS?
}

TTraitConstantValue: struct {
    name: String
    ty: Type
    value: TComptimeValue
    span: Span
}

TConstantDef: struct {
    module_identity: String
    key: String
    name: String
    span: Span
    visibility: TVisibility
    ty: Type
    is_comptime: Bool
    is_storage: Bool
    value: TComptimeValue
    // A module `Shared{X}` holder: `value` is the payload the build folded
    // and `ty` the holder's Shared type; the program allocates the cell on
    // its first read and every read shares it.
    shared_holder: Bool{false}
}
