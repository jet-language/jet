// Checked facts that sema attaches to checked bodies and that IR lowering reads: codec traits,
// shared lifetimes, authority decisions, component descriptors, typed literal heads, copy facts.

TraitID: struct { value: U64 }

trait_ref_id: fn(identity: String) -> TraitID Never! { TraitID{value: stable_id("trait", identity)} }

SerdeCodec: enum { Encode Decode }

TraitRef: struct { id: TraitID, name: String }

trait_ref_named: fn(name: String) -> TraitRef Never! {
    TraitRef{id: trait_ref_id(name), name: name}
}

// The registered native Codec definitions, shared by checking and lowering.
builtin_codec_trait_name: fn(codec: SerdeCodec) -> String Never! {
    if codec == {
        .Encode -> "Encode"
        .Decode -> "Decode"
    }
}

builtin_codec_trait_ref: fn(codec: SerdeCodec) -> TraitRef Never! {
    trait_ref_named(builtin_codec_trait_name(codec))
}

HostImportFact: struct {
    id: String
    operation: String
    required_right: String
    parameter_type_ids: [String]
    result_type_id: String?
}

AuthorityDecision: struct {
    import: HostImportFact
    authority_argument: Int?
    inherited: Bool
}

// Core publication sites use the same Global path as module storage. The
// initializer declaration, not a callsite, supplies their identity.
SharedLifetime: enum { Process World Thread Attempt }

shared_lifetime_core_member: fn(name: String) -> SharedLifetime? Never! {
    if name == {
        "__process_shared" -> Val(SharedLifetime.Process)
        "__world_shared" -> Val(SharedLifetime.World)
        "__thread_shared" -> Val(SharedLifetime.Thread)
        "__attempt_shared" -> Val(SharedLifetime.Attempt)
        else -> None
    }
}

// Both decimals are canonical BigInt keys, so sign, digit count, then lexical
// order compare their exact numeric values without parsing or allocating limbs.
big_integer_key_compare: fn(left: String, right: String) -> Int Never! {
    left_negative: left.starts_with("-")
    right_negative: right.starts_with("-")
    if left_negative != right_negative -> return if left_negative -> -1 else -> 1
    order: if left.len() < right.len() -> -1 else -> if left.len() > right.len() -> 1 else -> if left < right -> -1 else -> if left > right -> 1 else -> 0
    if left_negative -> -order else -> order
}

ComponentTypeDescriptor: enum {
    Int
    Float
    Bool
    String
    List(inner: ComponentTypeDescriptor)
    Option(inner: ComponentTypeDescriptor)
    Result(ok: ComponentTypeDescriptor, err: ComponentTypeDescriptor)
    Record(name: String, fields: [ComponentTypeField])
}

ComponentTypeField: struct {
    index: Int
    name: String
    ty: ComponentTypeDescriptor
}

ComponentSignatureDescriptor: struct {
    params: [ComponentTypeDescriptor]
    result: ComponentTypeDescriptor
}

// The built-in boundary typed heads; boundary_head_owner_module names each
// one's owner module.
BOUNDARY_TYPED_HEADS: [String]{"Path", "URL", "DateTime", "HTML", "Sh", "SQL"}

// The Core module whose runtime serves a boundary typed head (its usage and
// linkage key), not necessarily a record of the same type.
boundary_head_owner_module: fn(name: String) -> String? {
    if name == "Path" -> return Val("core.files")
    boundary_head_carrier_module(name)
}

// The Core module whose same-named record is the built-in value. Path stays
// the native boundary carrier, distinct from core.files.path's record.
boundary_head_carrier_module: fn(name: String) -> String? {
    if name == "URL" -> return Val("core.net.url")
    if name == "DateTime" -> return Val("core.time")
    if name == "HTML" -> return Val("core.text.html")
    if name == "Sh" -> return Val("core.process")
    if name == "SQL" -> return Val("core.db")
    None
}

// #4318: why a checked clone duplicates its operand. Every copy carries the
// sema decision that made it; lowering and backends never print a clone
// without one.
CopyFact: enum { Explicit Materialize Share Scalar ViewMaterialize }

// Checked facts sema publishes beside each function's flat body (Facts/Body.jet):
// locals, method and call facts, constants, type and impl rows. The checker's
// own expression tree is private to JetSema (Sema/Tree.jet).

TAddressLifetime: enum {
    Stack
    Heap
    Static
    Borrowed
    Foreign
    Unknown
}

TIntegerBounds: struct {
    lo: Int
    hi: Int
}

integer_bounds_exact: fn(value: Int) -> TIntegerBounds Never! {
    TIntegerBounds{lo: value, hi: value}
}

// A binder (or a read of one): `ty` is its checked type in its function's
// own terms (a generic function's type parameters unbound). Lowering reads
// a binder's slot type from `ty`; it never takes it from the initializer.
TLocal: struct {
    name: String
    symbol_id: SymbolID?{None}
    span: Span
    ty: Type
    generated: Bool
    deref: Bool
    address_lifetime: TAddressLifetime?
    persist_key: String?
    persist_ty: Type?
    mutable: Bool
    string_bytes_source: TLocal?
    integer_bounds: TIntegerBounds?
    uninit_scalar: Bool
    uninit_fixed: Bool
    // The checked `p.move()` of a match payload binding whose subject sema marked
    // partially moved (sema_ownership_move_pattern_payload): lowering may
    // take the payload out of the subject's storage instead of copying it.
    payload_take: Bool{false}
    // A read-only binding of a place (`x: rows[i]`) that reads the place
    // itself instead of a copy: sema proved neither the binding nor the
    // variable the place reads is written, moved or captured while it lives
    // (JetSema Ownership/PlaceBorrows.jet).
    place_borrow: Bool{false}
    // Why an immutable `name: value` binder that calls code is computed at
    // run time: compiling could not compute it (it stops, runs out of steps,
    // reaches the outside world, or can't run while compiling).
    run_time_reason: String?{None}
}

checked_user_local: fn(name: String, span: Span, ty: Type) -> TLocal Never! {
    TLocal{name: name, span: span, ty: ty, generated: false, deref: false, address_lifetime: None, persist_key: None, persist_ty: None, mutable: false, string_bytes_source: None, integer_bounds: None, uninit_scalar: false, uninit_fixed: false}
}

checked_symbol_local: fn(name: String, span: Span, symbol_id: SymbolID, ty: Type) -> TLocal Never! {
    local := checked_user_local(name, span, ty)
    local.symbol_id = Val(symbol_id)
    local
}

checked_generated_local: fn(name: String, span: Span, ty: Type) -> TLocal Never! {
    TLocal{name: name, span: span, ty: ty, generated: true, deref: false, address_lifetime: None, persist_key: None, persist_ty: None, mutable: false, string_bytes_source: None, integer_bounds: None, uninit_scalar: false, uninit_fixed: false}
}

checked_persistent_local: fn(name: String, module_name: String, ty: Type, span: Span) -> TLocal Never! {
    TLocal{name: name, span: span, ty: ty.copy(), generated: false, deref: false, address_lifetime: Val(TAddressLifetime.Static), persist_key: Val("{module_name}::{name}"), persist_ty: Val(ty), mutable: false, string_bytes_source: None, integer_bounds: None, uninit_scalar: false, uninit_fixed: false}
}

