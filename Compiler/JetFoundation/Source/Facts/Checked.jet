// The index in the tree's `types` that a body's sorted rows
// (BodyTree.expr_types) file for node id `id`.
fn tir_expr_type_id(rows: [TExprType], id: Int) -> Int? Never! {
    low := 0
    high := rows.len()
    loop low < high {
        middle :: (low + high) /% 2
        if rows[middle].id < id -> low = middle + 1 else -> high = middle
    }
    if low < rows.len() && rows[low].id == id -> return Val(rows[low].ty)
    None
}

// The first function-local id the checker hands out (sema_check_record_expr_id).
TEXPR_FIRST_LOCAL_ID :: -2

// The first flat-local id the flattener (body_flat_expr) hands a node the
// checker gave no id, far below the checker's function-local ids.
TEXPR_FIRST_FLAT_ID :: -549755813888
