}

struct ComponentSignatureDescriptor {
    params: [ComponentTypeDescriptor]
    result: ComponentTypeDescriptor
}

enum HTTPRouteMethod { Get Post Put Delete Patch Head Options }

enum TypedHeadKind { SQL HTML Sh URL Path DateTime }

// The shared boundary-head classification, mirrored by Syntax::typed_head_kind.
fn typed_head_kind_of(head: Type) -> TypedHeadKind? {
    if head == {
        .Named(name) -> {
            if name == "SQL" -> return Val(TypedHeadKind.SQL)
            if name == "HTML" -> return Val(TypedHeadKind.HTML)
            if name == "Sh" -> return Val(TypedHeadKind.Sh)
            if name == "URL" -> return Val(TypedHeadKind.URL)
            if name == "Path" -> return Val(TypedHeadKind.Path)
            if name == "DateTime" -> return Val(TypedHeadKind.DateTime)
        }
        else -> {}
    }
    None
}

// The Core module whose runtime serves a boundary typed head (its usage and
// linkage key), not necessarily a record of the same type.
fn boundary_head_owner_module(name: String) -> String? {
    if name == "URL" -> return Val("core.net.url")
    if name == "Path" -> return Val("core.files")
    if name == "DateTime" -> return Val("core.time")
    None
}

// The Core module whose same-named record is the built-in value. URL and
// DateTime use their checked source carriers; Path stays the native boundary
// carrier, distinct from core.files.path's record.
fn boundary_head_carrier_module(name: String) -> String? {
    if name == "URL" -> return Val("core.net.url")
    if name == "DateTime" -> return Val("core.time")
    None
}

// #4318: why a checked clone duplicates its operand. Every copy carries the
// sema decision that made it; lowering and backends never print a clone
// without one.
enum CopyFact { Explicit Materialize Share Scalar ViewMaterialize }

// Checked facts sema publishes beside each function's flat body (Facts/Body.jet):
// locals, method and call facts, constants, type and impl rows. The checker's
// own expression tree is private to JetSema (Sema/Tree.jet).

TIR_SCHEMA_VERSION :: 8

enum TAddressLifetime {
    Stack
    Heap
    Static
    Borrowed
    Foreign
    Unknown
}

struct TIntegerBounds {
    lo: Int
    hi: Int
}

fn integer_bounds_exact(value: Int) -> TIntegerBounds Never! {
    TIntegerBounds{lo: value, hi: value}
}

struct TLocal {
    name: String
    symbol_id: SymbolID?{None}
    span: Span
    generated: Bool
    deref: Bool
    address_lifetime: TAddressLifetime?
    persist_key: String?
    persist_ty: Type?
    mutable: Bool
    string_bytes_source: TLocal?
    integer_bounds: TIntegerBounds?
    uninit_scalar: Bool
    uninit_fixed: Bool
    // The checked `^p` of a match payload binding whose subject sema marked
    // partially moved (sema_ownership_move_pattern_payload): lowering may
    // take the payload out of the subject's storage instead of copying it.
    payload_take: Bool{false}
    // A read-only binding of a place (`x :: rows[i]`) that reads the place
    // itself instead of a copy: sema proved neither the binding nor the
    // variable the place reads is written, moved or captured while it lives
    // (JetSema Ownership/PlaceBorrows.jet).
    place_borrow: Bool{false}
}

fn tir_user_local(name: String, span: Span) -> TLocal Never! {
    TLocal{name: name, span: span, generated: false, deref: false, address_lifetime: None, persist_key: None, persist_ty: None, mutable: false, string_bytes_source: None, integer_bounds: None, uninit_scalar: false, uninit_fixed: false}
}

fn tir_symbol_local(name: String, span: Span, symbol_id: SymbolID) -> TLocal Never! {
    local := tir_user_local(name, span)
    local.symbol_id = Val(symbol_id)
    local
}

fn tir_generated_local(name: String, span: Span) -> TLocal Never! {
    TLocal{name: name, span: span, generated: true, deref: false, address_lifetime: None, persist_key: None, persist_ty: None, mutable: false, string_bytes_source: None, integer_bounds: None, uninit_scalar: false, uninit_fixed: false}
}

fn tir_persistent_local(name: String, module_name: String, ty: Type, span: Span) -> TLocal Never! {
    TLocal{name: name, span: span, generated: false, deref: false, address_lifetime: Val(TAddressLifetime.Static), persist_key: Val("{module_name}::{name}"), persist_ty: Val(ty), mutable: false, string_bytes_source: None, integer_bounds: None, uninit_scalar: false, uninit_fixed: false}
}

