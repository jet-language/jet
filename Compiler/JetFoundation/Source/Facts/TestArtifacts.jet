enum TTestKind { Unit Property }

struct TTestParamFact {
    index: Int
    name: String
    span: Span
    ty: Type
    convention: AccessConvention
    label: String
    zone: ParamZone
    variadic: Bool
    default_present: Bool
}

struct TTestFact {
    key: String
    function: TFunctionRef
    name: String
    span: Span
    kind: TTestKind
    parameters: [TTestParamFact]
    faults: [String]
    expected_failure: Bool
    contract_generated: Bool
    eligibility: TFunctionRef?
    generation_unavailable_reason: String?
}

struct TOutputCheckFact {
    key: String
    name: String
    function: TFunctionRef
}

fn checked_test_artifact_key(module_identity: String, test: TestDef) -> String Never! {
    name := test.name ?? "anonymous"
    local := "test::{name}@{test.span.start}..{test.span.end}"
    if module_identity == "" -> local else -> "{module_identity}::{local}"
}

fn checked_test_artifact_function_ref(module_identity: String, test: TestDef) -> TFunctionRef Never! {
    key := checked_test_artifact_key(module_identity, test)
    TFunctionRef{
        key: key,
        module_identity: module_identity,
        name: key,
        span: test.span,
        visibility: TVisibility.Private,
    }
}

// D-TEST-XFAIL1=A (materialize_test_expected_fail): the checked
// `expected_fail:` marker argument is the test's flag. As with the test name,
// only a literal argument is materialized here.
fn checked_test_expected_fail(test: TestDef) -> Bool Never! {
    if test.expected_fail_expr == .Val(expression) {
        if expression == .Bool(value, _, _) -> return value
    }
    test.expected_fail
}

// D-TESTFAULT1=A: the checked `faults:` marker list's effect paths (`Rand`,
// `FS.Read`) are the test's selectors. Sema reports E0119 for an unknown
// root, so each checked element is an effect path.
fn checked_test_faults(test: TestDef) -> [String] Never! {
    if test.faults_expr == .Val(expression) {
        if expression == .ListLit(elements, _, _) {
            faults := [String]{}
            loop element in elements {
                if checked_test_fault_path(element) == .Val(path) -> &faults.push(path)
            }
            return faults
        }
    }
    test.faults
}

fn checked_test_fault_path(expression: Expr) -> String? Never! {
    if expression == {
        .Ident(name, _, _) -> Val(name)
        .Field(base, member, _, _) -> {
            path :: checked_test_fault_path(base) ?? return None
            Val("{path}.{member}")
        }
        else -> None
    }
}

fn checked_test_artifact_fact(module_identity: String, test: TestDef) -> TTestFact Never! {
    parameters := [TTestParamFact]{}
    index := 0
    loop parameter in test.params {
        &parameters.push(TTestParamFact{
            index: index,
            name: parameter.name,
            span: parameter.name_span,
            ty: parameter.ty,
            convention: parameter.convention,
            label: parameter.public_label.map((label) -> label.name) ?? parameter.name,
            zone: parameter.zone,
            variadic: parameter.variadic,
            default_present: parameter.default != None,
        })
        index += 1
    }
    key := checked_test_artifact_key(module_identity, test)
    TTestFact{
        key: key,
        function: checked_test_artifact_function_ref(module_identity, test),
        name: test.name ?? key,
        span: test.span,
        kind: if test.params.len() == 0 -> TTestKind.Unit else -> TTestKind.Property,
        parameters: parameters,
        faults: checked_test_faults(test),
        expected_failure: checked_test_expected_fail(test),
        contract_generated: false,
        eligibility: None,
        generation_unavailable_reason: None,
    }
}
