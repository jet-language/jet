TTestKind: enum { Unit Property }

TTestParamFact: struct {
    index: Int
    name: String
    span: Span
    ty: Type
    convention: AccessConvention
    label: String
    zone: ParamZone
    variadic: Bool
    default_present: Bool
}

TTestFact: struct {
    key: String
    function: TFunctionRef
    name: String
    span: Span
    kind: TTestKind
    parameters: [TTestParamFact]
    faults: [String]
    expected_failure: Bool
    contract_generated: Bool
    eligibility: TFunctionRef?
    generation_unavailable_reason: String?
    // A property test's law; None for a unit test.
    law: TTestLawFact?{None}
}

// A property test's law (#6015 c5), each part as its source text: the `#Pre`
// markers a generated case must meet to run (`precondition`), the parameters
// its generators draw (`partitions`, `name: Type`), the assertions its body
// makes (`relation`) and the functions and methods its body calls
// (`surfaces`, sorted). The run adds its seed and the cases the precondition
// rejected (JetCli TestOutcome.jet jet_cli_test_law_attachments).
TTestLawFact: struct {
    precondition: [String]
    partitions: [String]
    relation: [String]
    surfaces: [String]
}

// Collects a property body's assertions (`assert`, `assert_eq` and an
// `expect(…)` method) and the other names it calls, over `source`.
TTestLawVisitor: struct {
    source: [U8]
    relation: [String]
    surfaces: [String]
    visit: fn(&self, expression: Expr) Never! -[Mem.Alloc, Mem.Rc, Time.Wait]> {
        if expression == {
            .Call(call, _) -> {
                if call.name == "assert" || call.name == "assert_eq" {
                    self.relation.push(checked_test_call_text(self.source, call.name_span.start, call.name_span.end))
                } else if call.name != "expect" && !self.surfaces.contains(call.name) {
                    self.surfaces.push(call.name)
                }
            }
            .MethodCall(receiver, method, method_span, _, _, _, _) -> {
                expected := false
                if receiver == .Call(inner, _) {
                    if inner.name == "expect" {
                        expected = true
                        self.relation.push(checked_test_call_text(self.source, inner.name_span.start, method_span.end))
                    }
                }
                surface: ".{method}"
                if !expected && !self.surfaces.contains(surface) -> self.surfaces.push(surface)
            }
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
        }
    }
}

TOutputCheckFact: struct {
    key: String
    name: String
    function: TFunctionRef
}

checked_test_artifact_key: fn(module_identity: String, test: TestDef) -> String Never! {
    name := test.name ?? "anonymous"
    local := "test::{name}@{test.span.start}..{test.span.end}"
    if module_identity == "" -> local else -> "{module_identity}::{local}"
}

checked_test_artifact_function_ref: fn(module_identity: String, test: TestDef) -> TFunctionRef Never! {
    key := checked_test_artifact_key(module_identity, test)
    TFunctionRef{
        key: key,
        module_identity: module_identity,
        name: key,
        span: test.span,
        visibility: TVisibility.Private,
    }
}

// The checked
// `expected_fail:` marker argument is the test's flag. As with the test name,
// only a literal argument is materialized here.
checked_test_expected_fail: fn(test: TestDef) -> Bool Never! {
    if test.expected_fail_expr == .Val(expression) {
        if expression == .Bool(value, _, _) -> return value
    }
    test.expected_fail
}

// The checked `faults:` marker list's effect paths (`Rand`,
// `FS.Read`) are the test's selectors. Sema reports E0119 for an unknown
// root, so each checked element is an effect path.
checked_test_faults: fn(test: TestDef) -> [String] Never! {
    if test.faults_expr == .Val(expression) {
        if expression == .ListLit(elements, _, _) {
            faults := [String]{}
            loop element in elements {
                if checked_test_fault_path(element) == .Val(path) -> faults.push(path)
            }
            return faults
        }
    }
    test.faults
}

checked_test_fault_path: fn(expression: Expr) -> String? Never! {
    if expression == {
        .Ident(name, _, _) -> Val(name)
        .Field(base, member, _, _) -> {
            path: checked_test_fault_path(base) ?? return None
            Val("{path}.{member}")
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

// The text of a call whose callee ends at `after` in `source`: from `start`
// through its balanced argument parentheses (string literals skipped), or
// to `after` when no `(` follows; "" when the span isn't in `source`.
checked_test_call_text: fn(source: [U8], start: Int, after: Int) -> String Never! {
    if start < 0 || after < start || after > source.len() -> return ""
    at := after
    loop at < source.len() && source[at] == (U8{32}) -> at += 1
    end := after
    if at < source.len() && source[at] == (U8{40}) {
        depth := 0
        quote := U8{0}
        loop at < source.len() {
            byte: source[at]
            at += 1
            if quote != (U8{0}) {
                if byte == (U8{92}) {
                    at += 1
                } else if byte == quote {
                    quote = U8{0}
                }
                next
            }
            if byte == (U8{34}) || byte == (U8{96}) {
                quote = byte
            } else if byte == (U8{40}) {
                depth += 1
            } else if byte == (U8{41}) {
                depth -= 1
                if depth == 0 {
                    end = at
                    break
                }
            }
        }
    }
    String.from_bytes(source.slice(start, end)) ?? ""
}

// A `#Pre(cond, msg)` marker's text, from its `#` at `start` in `source`.
checked_test_marker_text: fn(source: [U8], start: Int) -> String Never! {
    if start < 0 || start >= source.len() -> return ""
    at := start
    if source[at] == (U8{35}) -> at += 1
    loop at < source.len() && checked_test_name_byte(source[at]) -> at += 1
    checked_test_call_text(source, start, at)
}

// An ASCII letter, digit or `_`: a byte of a marker's name.
checked_test_name_byte: fn(byte: U8) -> Bool Never! {
    (byte >= (U8{48}) && byte <= (U8{57})) || (byte >= (U8{65}) && byte <= (U8{90})) || (byte >= (U8{97}) && byte <= (U8{122})) || byte == (U8{95})
}

// The law of the property test `test` (#6015 c5), read from its module's
// `source` text.
checked_test_law: fn(test: TestDef, source: String) -> TTestLawFact Never! {
    bytes: source.bytes()
    precondition := [String]{}
    loop clause in test.pre -> precondition.push(checked_test_marker_text(bytes, clause.span.start))
    partitions := [String]{}
    loop parameter in test.params -> partitions.push("{parameter.name}: {type_name(parameter.ty)}")
    visitor := TTestLawVisitor{source: bytes, relation: [String]{}, surfaces: [String]{}}
    loop statement in test.body -> ast_visit_statement(statement, fn(expression: Expr) { visitor.visit(expression) }, false)
    visitor.surfaces.sort()
    TTestLawFact{precondition: precondition, partitions: partitions, relation: visitor.relation, surfaces: visitor.surfaces}
}

// The checked fact of `test` in the module `module_identity`, whose source
// text is `source`.
checked_test_artifact_fact: fn(module_identity: String, test: TestDef, source: String) -> TTestFact Never! {
    parameters := [TTestParamFact]{}
    index := 0
    loop parameter in test.params {
        parameters.push(TTestParamFact{
            index: index,
            name: parameter.name,
            span: parameter.name_span,
            ty: parameter.ty,
            convention: parameter.convention,
            label: parameter.public_label.map(fn(label) { label.name }) ?? parameter.name,
            zone: parameter.zone,
            variadic: parameter.variadic,
            default_present: parameter.default != None,
        })
        index += 1
    }
    key := checked_test_artifact_key(module_identity, test)
    TTestFact{
        key: key,
        function: checked_test_artifact_function_ref(module_identity, test),
        name: test.name ?? key,
        span: test.span,
        kind: if test.params.len() == 0 -> TTestKind.Unit else -> TTestKind.Property,
        parameters: parameters,
        faults: checked_test_faults(test),
        expected_failure: checked_test_expected_fail(test),
        contract_generated: false,
        eligibility: None,
        generation_unavailable_reason: None,
        law: if test.params.len() == 0 -> None else -> Val(checked_test_law(test, source)),
    }
}
