// Shared validation for the typed service-tree builder.
// Rust: crates/jet-foundation/src/ServiceTree.rs:3
pub const MAX_NAME_BYTES: Int = 256
// Rust: crates/jet-foundation/src/ServiceTree.rs:5
pub fn valid_name(value: String) -> Bool Never! {
    trimmed := value.trim() // #4303
    !trimmed.is_empty() && !value.chars().any((c) -> c.is_control()) && value.bytes().len() <= MAX_NAME_BYTES
}
