// Rust: crates/jet-foundation/src/Syntax.rs:691
pub fn numeric_conversion_source(method: String) -> String? {
    loop (name, source) in NUMERIC_CONVERSION_SOURCES { if name == method -> return Val(source) }
    None
}
// Rust: crates/jet-foundation/src/Syntax.rs:697
pub fn numeric_conversion_method(source: String) -> String? {
    loop (method, name) in NUMERIC_CONVERSION_SOURCES { if name == source -> return Val(method) }
    None
}
// Rust: crates/jet-foundation/src/Syntax.rs:703
pub fn conversion_method_for_source(source: String) -> String {
    if numeric_conversion_method(source) == .Val(method) -> return ~method
    "from_{canonical_name_case(source, .Snake)}"
}
// Rust: crates/jet-foundation/src/Syntax.rs:711
// Migration diagnostic only; these source-owned methods are not accepted.
pub fn retired_numeric_conversion_target(method: String) -> String? {
    if method == {
        "to_i8" -> Val("I8")
        "to_i16" -> Val("I16")
        "to_i32" -> Val("I32")
        "to_i64" | "to_int" -> Val("Int")
        "to_u8" -> Val("U8")
        "to_u16" -> Val("U16")
        "to_u32" -> Val("U32")
        "to_u64" -> Val("U64")
        "to_f32" -> Val("F32")
        "to_f64" | "to_float" -> Val("Float")
        else -> None
    }
}
