// Rust: crates/jet-foundation/src/Syntax.rs:737
pub fn unit_rounding_mode(name: String) -> UnitRoundingMode? {
    if name == { ROUND_TOWARD_ZERO -> Val(.TowardZero); ROUND_FLOOR -> Val(.Floor); ROUND_CEILING -> Val(.Ceiling); ROUND_NEAREST_EVEN -> Val(.NearestEven); else -> None }
}

