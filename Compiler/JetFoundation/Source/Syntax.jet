// Rust: crates/jet-foundation/src/Syntax.rs:544
pub fn validate_http_route_pattern(pattern: String) -> Err! {
    if !pattern.starts_with('/') -> return Err("routes must start with `/`")
    segments :: pattern.split('/').skip(1).collect()
    names := [String:Bool]{}
    loop (index, segment) in segments {
        if segment.is_empty() {
            if segments.len() == 1 -> next
            return Err("empty path segments are not allowed")
        }
        if segment.contains('{') || segment.contains('}') -> return Err("use `:name` or final `*name`; braces are not route markers")
        if segment == "*" -> return Err("write a named catch-all such as `*wildcard`")
        name :: segment.strip_prefix(':').or_else(() -> segment.strip_prefix('*'))
        if name == .Val(name) {
            if segment.starts_with('*') && index + 1 != segments.len() -> return Err("`*name` catch-all must be final")
            if !valid_name(name) -> return Err("{if segment.starts_with('*') -> "catch-all" else -> "parameter"} names must match `[A-Za-z_][A-Za-z0-9_]*`")
            if names.contains_key(name) -> return Err("duplicate parameter `{name}`")
            &names.insert(~name, true)
        } else -> decode_static(segment)
    }
}
// Rust: crates/jet-foundation/src/Syntax.rs:547
fn valid_name(name: String) -> Bool {
    chars := name.chars()
    first :: &chars.next() ?? return false
    if first != '_' && !first.is_ascii_alphabetic() -> return false
    chars.all(c -> c == '_' || c.is_ascii_alphanumeric())
}
// Rust: crates/jet-foundation/src/Syntax.rs:553
fn decode_static(segment: String) -> Err! {
    bytes :: segment.bytes()
    decoded := [U8]{}.with_capacity(bytes.len())
    index := 0
    loop index < bytes.len() {
        if bytes[index] != U8{37} { &decoded.push(bytes[index]); index += 1; next }
        high :: bytes.get(index + 1).and_then(byte -> route_hex(byte)) ?? return Err("invalid percent escape")
        low :: bytes.get(index + 2).and_then(byte -> route_hex(byte)) ?? return Err("invalid percent escape")
        byte :: high * U8{16} + low
        if byte == U8{47} -> return Err("encoded slash is ambiguous")
        &decoded.push(byte)
        index += 3
    }
    text :: String.from_bytes(^decoded) ?? return Err("route segment is not valid UTF-8")
    if text == "." || text == ".." -> return Err("dot traversal segment is not allowed")
}
// Rust: crates/jet-foundation/src/Syntax.rs:563
fn route_hex(byte: U8) -> U8? {
    if { byte >= U8{48} && byte <= U8{57} -> Val(byte - U8{48}); byte >= U8{97} && byte <= U8{102} -> Val(byte - U8{97} + U8{10}); byte >= U8{65} && byte <= U8{70} -> Val(byte - U8{65} + U8{10}); else -> None }
}

