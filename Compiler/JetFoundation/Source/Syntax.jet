//RS /// D-CALLDUAL1=E: sema-only metadata carried on `Expr::MethodCall` until TIR
//RS /// lowers a resolved `#Root` call to the ordinary free-function/module-call
//RS /// shape. These strings are never source syntax.
//RS pub const INTERNAL_ROOT_CALL_LOCAL: &str = "__jet_root_call_local";
//RS pub const INTERNAL_ROOT_CALL_IMPORT_PREFIX: &str = "__jet_root_call_import:";
//RS pub const INTERNAL_ROOT_CALL_CORE_PREFIX: &str = "__jet_root_call_core:";
//RS 
//RS /// D-CALLVALUE1=B: sema-only marker for the builtin function-value `.call(...)`
//RS /// projection. It is never a source spelling; TIR lowers it to the same
//RS /// function-value call node as `Expr::CallValue`.
//RS pub const INTERNAL_CALL_VALUE: &str = "__jet_call_value";
