//RS pub const INTERNAL_CHANNEL_BOUNDED_METHOD: &str = "\0jet.channel.bounded";
//RS /// D-CONC-CHAN1=A: receiver endpoint type is nameable in signatures.
//RS pub const TYPE_RECEIVER: &str = "Receiver";
//RS /// D-CONC-CHAN1=A: sender endpoint type is nameable in signatures.
//RS pub const TYPE_SENDER: &str = "Sender";
//RS /// D-CONC-CHAN1=A / D-CONC-CHAN2=D: loop source form for channel draining.
//RS pub const LOOP_CHANNEL_DRAIN: &str = "loop value in receiver";
//RS /// D-CONC-CHAN2=D: contextual timeout arm in a readiness table.
//RS pub const READINESS_AFTER: &str = "after";
//RS /// Compiler-private field used while a readiness arm is carried through the
//RS /// existing one-field tuple AST node. It cannot be written by source code.
//RS pub const INTERNAL_SELECT_AFTER_FIELD: &str = "\0jet.select.after";
//RS 
//RS /// D-CONC-SHARE1=A: prefix for construction of a shared cell.
//RS pub const KW_SHARED: &str = "shared";
//RS 
//RS /// D-CONC-JOIN1=A / D-CONC-FAIL1=A: consuming task result operation.
//RS pub const TASK_JOIN: &str = "join";
//RS /// D-CONC-FAIL1=A: one error type for joined task failures.
//RS pub const TYPE_TASK_FAILURE: &str = "TaskFailure";
//RS /// D-CONC-FAIL1=A: cancellation failure variant.
//RS pub const TASK_FAILURE_CANCELLED: &str = "Cancelled";
//RS /// D-CONC-FAIL1=A: deadline failure variant.
//RS pub const TASK_FAILURE_DEADLINE_BLOWN: &str = "DeadlineBlown";
//RS /// D-CONC-FAIL1=A: panic failure variant.
//RS pub const TASK_FAILURE_PANICKED: &str = "Panicked";
