// PORT-PENDING 2121 crates-jet-foundation-src-syntax: crates/jet-foundation/src/Syntax.rs:1-970
// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! OWNER-CONTROLLED SURFACE.
//RS //!
//RS //! Every keyword, sigil, and built-in name a user can type lives in this
//RS //! file and nowhere else (invariant I7). Each constant maps to a decision
//RS //! ID in Docs/spec/syntax-decisions.md. Changing a provisional choice means:
//RS //! change it here, update Docs/spec/syntax-decisions.md, re-bless the ui snapshots. Done.
//RS //!
//RS //! Agents: do NOT add an entry here without a decision ID approved by the
//RS //! owner in Docs/spec/syntax-decisions.md.
//RS /// One machine-readable row for the owner-controlled lexical ledger (I7).
//RS /// Surface audits and future front ends consume this table instead of
//RS /// maintaining a second spelling/decision inventory.
//RS #[derive(Clone, Copy, Debug, Eq, PartialEq)]
//RS pub struct LexicalEntry {
//RS     pub spelling: &'static str,
//RS     pub meaning: &'static str,
//RS     pub decision: &'static str,
//RS }
//RS 
//RS pub const LEXICAL_LEDGER: &[LexicalEntry] = &[
//RS     LexicalEntry { spelling: "::", meaning: "immutable binding", decision: "D-BIND1" },
//RS     LexicalEntry { spelling: ":=", meaning: "mutable binding", decision: "D-BIND1" },
//RS     LexicalEntry { spelling: "#", meaning: "attached marker; #[A, B] stacks", decision: "D-VERDICT-732-1; D-MARK-STACK1" },
//RS     LexicalEntry { spelling: "#DevPanel", meaning: "exported typed devtools panel marker", decision: "D-DX-PLUGIN1=D" },
//RS     LexicalEntry { spelling: "web.form(Model, action: handler)", meaning: "struct-derived headless form with progressive action", decision: "D-DX-FORM1" },
//RS     LexicalEntry { spelling: "#Layout(c, align(N)) / #Layout(c, align(target, N))", meaning: "C layout with portable or target-supported explicit alignment", decision: "D-PLACE1=A; D-LAYOUT-ALIGN1=A" },
//RS     LexicalEntry { spelling: "#Align", meaning: "retired standalone alignment marker", decision: "D-PLACE1=A" },
//RS     LexicalEntry { spelling: "Atomic<T>", meaning: "safe lock-free scalar cell", decision: "D-PLACE1=A; D-ATOMIC-WIDTH1=A" },
//RS     LexicalEntry { spelling: "@", meaning: "live link (D-MEMREF1); retired compile-time `@NAME :: value` constant teaches E0388 with `NAME :: prep { value }`; retired `@` template name splices teach E0388 with `$`; retired `@` fact spellings teach E0003 with `$`", decision: "D-MEMREF1=A; D-AT-INFIX1=A; D-PREP-SURFACE2=A; D-COMPILER-NS1=A; D-NAME-SPLICE1=B" },
//RS     LexicalEntry { spelling: KW_PREP, meaning: "explicit shared-preparation block `prep { … }`; `NAME :: prep { value }` is the only compile-time binding; `@ { … }` is retired", decision: "D-PREP-SURFACE2=A" },
//RS     LexicalEntry { spelling: "prep if", meaning: "build-time branch; unchosen arms are name-checked only", decision: "D-PREP-BRANCH1=A" },
//RS     LexicalEntry { spelling: "prep loop", meaning: "build-time loop over statements or declarations", decision: "D-PREP-BRANCH1=A; D-STRUCT-ONCE1=A" },
//RS     LexicalEntry { spelling: "prep fn", meaning: "build-time literal-hook method", decision: "D-PREP-FN1=A; D-FOUND-LITERAL1=A" },
//RS     LexicalEntry { spelling: "<prep N: Int>", meaning: "compile-time number parameter declaration", decision: "D-CONSTGEN2=A" },
//RS     LexicalEntry { spelling: "$", meaning: "compiler fact: `T.$layout`, `f.$effects`, `value.$origin`; marker/fact declaration metadata `$sites:`; template name splice `fn $method`, `self.$field`, `.$left`; `@` spellings teach E0003 or E0388", decision: "D-COMPILER-NS1=A; D-META-ROOT3=A; D-DECL-META1=A; D-NAME-SPLICE1=B" },
//RS     LexicalEntry { spelling: "$build", meaning: "build fact root: `$build.os`, `.profile`, `.settings.*`, `.stamp.*`", decision: "D-BUILD-FACT3=A" },
//RS     LexicalEntry { spelling: "$package", meaning: "package fact root: `$package.name`, `.version`", decision: "D-BUILD-FACT3=A; D-META-REFLECT2=A" },
//RS     LexicalEntry { spelling: "$phase", meaning: "total evaluation-site phase fact", decision: "D-PREP-SURFACE2=A; D-META-ROOT3=A" },
//RS     LexicalEntry { spelling: "$program", meaning: "authorized checked-program fact root", decision: "D-META-REFLECT2=A; D-META-ROOT3=A" },
//RS     LexicalEntry { spelling: META_QUERY_SOURCE, meaning: "lexical source-snapshot metadata query (no ratified `$` root yet)", decision: "D-META-REFLECT2=A" },
//RS     LexicalEntry { spelling: META_QUERY_TYPES, meaning: "retained runtime type-catalog query (no ratified `$` root yet)", decision: "D-META-REFLECT2=A" },
//RS     LexicalEntry { spelling: COMPILER_GENERATE, meaning: "explicit shared-preparation publication of Generated items", decision: "D-META-PUBLISH2=A" },
//RS     LexicalEntry { spelling: COMPILER_ADVANCED_REGISTER, meaning: "explicit opt-in provider registration for declared targets", decision: "D-META-CONTROL2=A; D-META-OPTIN2=A" },
//RS     LexicalEntry { spelling: COMPILER_ADVANCED_REGISTER_EXPANSION, meaning: "explicit opt-in call-expansion provider registration", decision: "D-META-CONTROL2=A; D-META-OPTIN2=A" },
//RS     LexicalEntry { spelling: COMPILER_ADVANCED_REGISTER_SPECIALIZATION, meaning: "explicit opt-in specialization provider registration", decision: "D-META-CONTROL2=A; D-META-OPTIN2=A" },
//RS     LexicalEntry { spelling: COMPILER_ADVANCED_SESSION, meaning: "authorized session within a registered provider", decision: "D-META-CONTROL2=A; D-META-OPTIN2=A" },
//RS     LexicalEntry { spelling: "-[…]", meaning: "effect row on a callable", decision: "D-EFF1" },
//RS     LexicalEntry { spelling: "!", meaning: "error-contract mark after its error type (`E!`, `(A | B)!`); deny-only root in an effect row", decision: "D-TYPE-SUFFIX1=A; D-EFF4" },
//RS     LexicalEntry { spelling: "?", meaning: "optional type mark after its type (`T?`)", decision: "D-TYPE-SUFFIX1=A" },
//RS     LexicalEntry { spelling: "??", meaning: "fallback", decision: "D-RESULT-DECON2" },
//RS     LexicalEntry { spelling: "&place.method(…) / ^place.method(…)", meaning: "receiver place mark: `&`/`^` on the maximal named place a method call writes or takes; fresh receivers stay unmarked; a line starting `&name`/`^name` begins a statement", decision: "D-CAP-RECEIVER1=D" },
//RS     LexicalEntry { spelling: "T{expr}", meaning: "field default", decision: "D-DEFAULT-SHAPE1" },
//RS     LexicalEntry { spelling: "Name{\"…\"}", meaning: "checked text head", decision: "S8; D-CHECKED-TEXT1" },
//RS     LexicalEntry { spelling: ".{ … }", meaning: "typed anonymous value", decision: "D-POLICY-WORD1" },
//RS     LexicalEntry { spelling: "`", meaning: "raw ordinary String fence", decision: "D-RAWSTR1" },
//RS     LexicalEntry { spelling: ",", meaning: "separator with optional trailing item in every comma list", decision: "D-TRAILCOMMA1" },
//RS     LexicalEntry { spelling: "r\"…\", raw\"…\", $\"…\"", meaning: "unclaimed raw-string prefixes", decision: "" },
//RS     LexicalEntry { spelling: ";", meaning: "retired explicit statement terminator", decision: "D-SEMI1" },
//RS     LexicalEntry { spelling: "_name", meaning: "ordinary identifier", decision: "" },
//RS     LexicalEntry { spelling: "__core_intrinsic", meaning: "compiler-only namespace", decision: "D-CORE-CALL1" },
//RS     LexicalEntry { spelling: "<:", meaning: "open a lock-step statement-expansion fence", decision: "D-EACH1=C; D-FENCE2=A; D-FENCE-RANGE1=A" },
//RS     LexicalEntry { spelling: ":>", meaning: "close a lock-step statement-expansion fence", decision: "D-EACH1=C; D-FENCE2=A; D-FENCE-RANGE1=A" },
//RS     LexicalEntry { spelling: "@[ … ]@", meaning: "retired fence spelling; E-FENCE-SPELLING teaches `<: … :>`", decision: "D-FENCE2=A" },
//RS ];
//RS 
//RS /// D-PREP-SURFACE2=A: a shared preparation block always has an explicit body.
//RS pub const KW_PREP: &str = "prep";
//RS /// D-META-REFLECT2=A: checked compiler metadata queries that D-META-ROOT3=A
//RS /// has not yet given a `$` root. `$phase`, `$program` and `$package` are the
//RS /// fact roots in `Syntax/core_surface.rs`; type, function, method, closure and
//RS /// value facts are `$` members of their subject (`T.$fields`).
//RS pub const META_QUERY_SOURCE: &str = "@SOURCE";
//RS pub const META_QUERY_TYPES: &str = "@TYPES";
//RS /// D-META-PUBLISH2=A: publication remains explicit and uses the existing Generated value.
//RS pub const COMPILER_GENERATE: &str = "compiler.generate";
//RS /// D-META-CONTROL2=A / D-META-OPTIN2=A: advanced providers are root-opted-in and target-registered.
//RS pub const COMPILER_ADVANCED_REGISTER: &str = "compiler.advanced.register";
//RS pub const COMPILER_ADVANCED_REGISTER_EXPANSION: &str = "compiler.advanced.register_expansion";
//RS pub const COMPILER_ADVANCED_REGISTER_SPECIALIZATION: &str =
//RS     "compiler.advanced.register_specialization";
//RS /// A session is available only inside an authorized registered provider.
//RS pub const COMPILER_ADVANCED_SESSION: &str = "compiler.advanced.session";
//RS /// D-PLACE1=A: the old standalone marker gets a dedicated teaching diagnostic;
//RS /// it is not part of the active marker registry.
//RS pub const MARKER_ALIGN_LEGACY: &str = "Align";
//RS 
//RS // D-WRAP-SCOPE1=A (owner outcome, card #2171): MARKER_ARITHMETIC is the one
//RS // lexical fixed-width arithmetic policy; its menu is Checked, Wrapping, or
//RS // Saturating and its scope is function, method, or block.
//RS // D-CORE-USELIST1=A (ratified 2026-08-06, card #1575): grouped `use` imports
//RS // use one `.[…]` list with an optional `as` beside each member. Brace groups
//RS // and wildcard imports are retired.
//RS // D-TESTFAULT1=A: TEST_FAULTS_PARAM is the named configuration slot on the
//RS // existing KW_TEST marker; it introduces no token or new grammar category.
//RS // D-META-REG1=A / D-META-NAME1=A / D-META-FORM1=A / D-MARKER-SITES1=B:
//RS // KW_MARKER is the one
//RS // declaring word, and `Registry::rows` is the one registration table behind it —
//RS // a marker rule, a knowledge plane, a right, and a build fact are rows of the
//RS // same table, separated only by what they attach to. Facts about a rule ride the
//RS // declaration's own named-parameter list under the compile-time mark
//RS // (`$sites: [Site]`, `$repeatable: true`); no clause form and no second keyword
//RS // enter the grammar. Every row states its safe direction and its gate words
//RS // (D-FACT-LAW1=B); a prover may publish a read-only row (D-FACT-OWN1=A).
//RS // Marker-plane reconciliation anchors: MARKER_PUB_FILE, MARKER_NO_PRELUDE, MARKER_TARGET,
//RS // MARKER_LAYOUT, MARKER_CODABLE, Policy::APPLIED_RULES, Registry::rows, KW_FX (#FX),
//RS // KW_COMPTIME, KW_DERIVE, MARKER_TRACK, MARKER_LOCAL, MARKER_SHARED. Constants live in the private modules
//RS // below; keep this root file mentioning them so I7 audits can check one
//RS // canonical surface entrypoint.
//RS // D-TRACK-ORIGIN1=A (owner outcome): #Track origin is the typed compiler fact
//RS // `value.$origin`, with no runtime projection; its canonical constant lives in
//RS // `Syntax::COMPILER_FACT_ORIGIN`.
//RS // D-BOUND-UNDO1=A: MARKER_UNDO owns the `#Undo(inverse)` binding contract.
//RS // D-FFI-CAP1=A: MARKER_CLOSE owns the `#Close(close)` foreign-handle contract.
//RS // D-MEMO1=A: MARKER_MEMO owns `#Memo` and TYPE_MEMO_STATS owns `name.cache()`.
//RS // D-GENERIC-CALL1=A: GENERIC_CALL_OPEN and GENERIC_CALL_CLOSE own the adjacent
//RS // call-site type-argument markers; they reuse the existing angle tokens.
//RS // D-META-CODE1=A / D-META-BODY1=A: `derive T.Trait { … }` and
//RS // `b.generate(name) { … }` are typed item-template bodies. Their user-visible
//RS // members and compile-time holes use the ordinary item/statement grammar;
//RS // neither spelling accepts a source string or re-lexes generated text.
//RS // D-FAIL-ERROR1=A: core_surface::TYPE_ERR owns the shared default-error type
//RS // and constructor name. core_surface::RETIRED_TYPE_ERROR exists only for the
//RS // E0432 teaching diagnostic; it never resolves as a type.
//RS // D-FAIL-BIND1=A (amended by D-ERR-DECON1=A): core_surface::AMBIENT_ERR owns
//RS // the contextual lowercase `err` binder inside a fallible `??` fallback. It
//RS // is not a lexer keyword.
//RS // D-ERR-DECON1=A (ratified 2026-08-19, card #2041): the existing `??` block
//RS // accepts ordinary statements followed by either one bare value or one real
//RS // diverging tail (`return`, `next`, `break`, or `panic(...)`). No new token or
//RS // binder is added; the old `return value` block-value reading is retired.
//RS // D-TEXTHEAD-TYPE1=A: a checked text declaration is an ordinary nominal
//RS // String-backed type with one ordinary `CheckedText` implementation. Its
//RS // associated error, pure `check(String)`, and pure generic `encode_hole` are
//RS // resolved by the ordinary trait registry; no marker contract or head registry
//RS // owns the surface.
//RS // D-RESULT-DECON2=B (ratified 2026-08-25, card #2173): the existing `?`, `!`,
//RS // and `->` tokens also delimit one fixed exhaustive Result handler:
//RS // `result ? ok -> success ! error -> failure`. It is parser sugar for the
//RS // existing `.Ok`/`.Err` pattern tests; no new keyword, sigil, carrier, or
//RS // runtime handler enters the surface.
//RS // Card #1641, ratified 2026-08-07: D-RUN-LAW1=A names one run/one claim;
//RS // D-CLAIM-WORD1=B names `assert`/`assert_eq`; D-CLAIM-BENCH1=A and
//RS // D-CLAIM-CASES1=B add `.measure`/`.cases` to the D-DOTSCOPE1 member menu;
//RS // D-RUN-WATCH1=A adds `--watch`; D-RUN-RECORD1=A adds `--record=` and
//RS // `--replay=`; D-RUN-SESSION1=A claims the exact `r/R/t/f/q` session keys.
//RS // Their canonical rows live in the private surface modules below and are
//RS // re-exported through this file; no parser or execution engine owns a copy.
//RS // D-FAIL-EXIT1=A / D-FAIL-EDGE1=A (ratified 2026-08-06, cards #1533/#1536)
//RS // add no token: `fn run()` is the default-fallible entry, and the build target
//RS // selects the final report boundary. CLI, web, wasm, and service adapters
//RS // carry one report with target-native delivery.
//RS // D-FAIL-CONV2=A (ratified 2026-08-17, card #2018) adds no token: the standard
//RS // library ships one `impl <CoreError> -> Err` per family member on the
//RS // D-FAIL-CONV1 rail. Sema injects only the conversions a module's `?`
//RS // operators exercise. A program's own error type still needs its own
//RS // declaration.
//RS //
//RS // D-LITCARRIER1=D (owner, 2026-08-24; card #2164): numeric literals have two
//RS // suffix mechanisms. Carrier suffix `f` selects Float; component suffixes
//RS // `i`, `j`, and `k` build imaginary or vector components. Expected-type
//RS // inference remains the default, and these reserved suffixes precede
//RS // #UnitFamily resolution.
//RS //
//RS // D-APILABEL1=A adds the two parameter-zone separators
//RS // PARAM_ZONE_POSITIONAL_ONLY (`/`) and PARAM_ZONE_LABEL_ONLY (`*`), written in
//RS // a parameter list rather than as operators. It also gives a parameter an
//RS // optional public label ahead of its local name (`timeout seconds: Int`),
//RS // which needs no new token. Retires the S61 fixed-position label rule.
//RS // D-CALLPOS1=A adds no spelling: bare arguments fill one unambiguous callable
//RS // left to right; labels deconflict candidate bodies and the editor supplies
//RS // their names as inlay hints.
//RS //
//RS // D-CONF-WORD1=A gives the word `profile` one meaning, the optimize bundle
//RS // behind `--profile` and its `--release` sugar. The machine axis is
//RS // `--target`, which now takes a declared machine name (`board.<name>`) beside
//RS // a rustc triple. A named environment composition is a preset:
//RS // ENV_FIELD_PRESETS (`presets:`) and ENV_FLAG_PRESET (`--preset`) replace the
//RS // retired environment `profiles:` field, while package/user prose uses
//RS // generations. The environment selector is `--env`; ENV_FLAG_PROFILE_RETIRED
//RS // exists only to teach `--preset`.
//RS // D-CONF-KEY1=A (ratified 2026-08-06, card #1519) gives `settings:` its one
//RS // typed package/profile surface. BUILD_FIELD_SETTINGS and the retired
//RS // features/env teaching names live in package_files and are re-exported by
//RS // this root; no second configuration spelling is allowed.
//RS //
//RS // D-TRAILBLOCK2=A adds no token: retires D-TRAILBLOCK1 trailing `{ }` sugar.
//RS // Code arguments are ordinary `() -> { … }` lambdas inside call parentheses;
//RS // a bare `{` after a call is E0335.
//RS // D-BIND-BARE1=A adds no token: bindings are always bare `name :: value` /
//RS // `name := value`; types ride values (`Type{ … }`) or live on signatures
//RS // and fields. Retires `name: Type ::` / `name: Type :=`.
//RS // D-ALIAS-OP1=B (ratified 2026-08-06, card #1513; amends D-TYPEALIAS1): alias
//RS // declarations bind with the existing `::` mark; no token or grammar category
//RS // is added. The retired `=` spelling is diagnostic-only.
//RS // D-UNINIT-SENTINEL2=A amends D-UNINIT-SENTINEL1: `uninit` is legal only as
//RS // the whole body of a `Type{ uninit }` head (`name := Type{ uninit }`).
//RS // Retires annotated `name: Type := uninit`. KW_UNINIT stays the same token.
//RS // D-SHAPE-CLI1 reuses the existing `fn run` / `#CLI` surface: a resolved
//RS // entry-parameter type owns typed shell inputs, while zero-parameter `fn run()`
//RS // stays valid. D-CLI-GLOBAL1=E (ratified 2026-08-10, card #1858) reuses the
//RS // existing struct fields, callable members, markers, and `=` binding form:
//RS // scalar fields are shared root flags and callable members are commands.
//RS // `#CLI(Standard)` selects the standard flag pack. D-CLI-POS1=A adds field
//RS // marker `Flag` (`MARKER_FLAG`): required value fields fill positionally by
//RS // declaration order; `#[Flag]` keeps a field flag-only. D-CLI-FIELD-MARKERS1=A
//RS // adds `Short` (`MARKER_SHORT`) and `Env` (`MARKER_ENV`) to that same field
//RS // marker list. D-SHAPE6 adds no Jet source token; grouped tool commands remain
//RS // owned by the single registry in crates/jet-cli/src/CLI.rs.
//RS // D-ECO-DECL1=A adds no spelling: ecosystem entries reuse ordinary named
//RS // fields and D-LIT-DOT1 `Type{ ... }` construction. D-ECO-ROOTNAME1 still
//RS // owns the root noun; #560 owns executable source and tooling behavior.
//RS // D-ECO-INLINEPACKAGE1=A: `package { … }` is a contextual leading carrier,
//RS // not a second keyword family. Its structural shell is owned by the loader and
//RS // editor grammar; PackageFacts remains the only field parser.
//RS // D-ECO-GRAPH1=A (ratified 2026-08-23, card #532) adds no spelling: Package
//RS // owns one semantic graph and one lock identity; JetOS projects its typed
//RS // system/fleet facts from that graph. Filename, merge, and receipt storage
//RS // choices stay with their existing decisions.
//RS // D-MEM-VIEWRET1=B adds no token, sigil, lifetime spelling, or grammar rule.
//RS // It reuses the existing named-type spellings `View`, `ViewMut`, and the
//RS // restricted `str` element spelling at public string-view boundaries; sema
//RS // infers and publishes their owner provenance.
//RS // D-MEMPROVENANCE3=A adds contextual `from` after a return type (VIEW_FROM),
//RS // with optional `static.<path>` sources (VIEW_FROM_STATIC). Inference stays
//RS // the beginner default; the clause is opt-in expert declaration.
//RS // D-SPREAD1=A reuses `.[` (OP_MEMBER_SPREAD) for member spread
//RS // `prefix.[a, b, c]` → `[prefix.a, prefix.b, prefix.c]`. Call fan-out stays
//RS // removed (D-VERDICT-1324-1).
//RS // D-SHAPE-RESOURCE2=A adds contextual `defer` only at statement head in the
//RS // exact form `defer close(^resource)`; KW_DEFER/RESOURCE_CLOSE are canonical.
//RS // D-SHAPE3a=A adds no token: expected-type `.new(...)` reuses MEM_ALLOC_NEW
//RS // and ordinary call punctuation, with the receiver resolved by sema.
//RS // D-SCRIPT-ENTRY1=A adds no token: byte-zero `#!/...` is OS launch metadata;
//RS // the lexer skips the opaque line.
//RS // D-SUBJECT-CALL1=A adds no token: bare lower-case `.member` chains reuse the
//RS // existing dot punctuation and lower to ordinary one-parameter lambdas.
//RS // D-GENERIC-CALL1=A adds no token: `call<T>(...)` reuses the existing angle and
//RS // call tokens for explicit type arguments on every generic call family.
//RS // D-SHAPE-OPAQUE-INFER1=A adds no token: `Type.new(...)` may omit generic
//RS // receiver arguments only when ordinary input/expected-type inference is unique.
//RS // D-SHAPE-CTORVERB1=C closes fresh-value construction under the `new` prefix:
//RS // MEM_ALLOC_NEW owns deterministic construction; METHOD_FRESH_NEW_RANDOM owns
//RS // entropy-drawing construction; CLOCK_TYPE and EXPIRING_VALUE_TYPE own the
//RS // migrated type names. Lowercase module factories and `generate` are retired.
//RS // D-UNSAFE-OBLIG1=A adds contextual `assert valid_ptr, aligned, no_alias`,
//RS // the `obligations: .Track/.Skip` #Unsafe field, and ENV_ORG_UNSAFE_POLICY.
//RS // D-SHAPE-INTERNAL1=A and D-SHAPE-DUNDER2=A add no token: the canonical
//RS // IdentifierClass prefix policy makes `_name` soft-public and reserves every
//RS // source-written `__name` for Jet and generated tooling.
//RS // D-SHAPE-MODULEINTERNAL1=A adds no token: MODULE_INTERNAL_PREFIX is the
//RS // automatic-discovery opt-out for `module _name`; explicit imports still use
//RS // ordinary resolution and access rules.
//RS // D-SHAPE-CASE1=C owns the identifier category table and its two enforced
//RS // shapes. D-SHAPE-CASE2=A exempts foreign names inside FFI binding modules.
//RS // D-ARROW-UNIFY1=B (ratified 2026-08-19): OP_UNIFIED_ARROW (`->`) defines
//RS // callable results and control arms/bodies in every position.
//RS // D-ARROW-RESPELL1=A (ratified 2026-08-21): `->` is canonical; `:>` and `=>`
//RS // are retired teaching spellings with no alias.
//RS // D-SIG-AFTER1=A (ratified 2026-09-18, card #3503): return facts follow the
//RS // one arrow (`-> T`, `-[Effects]> T`). Named function and method bodies always
//RS // use braces. Bare type after the parameter list is a teaching diagnostic.
//RS // D-CALLABLE-ONE1=A is amended: the plain arrow is present when a non-unit
//RS // success result is declared; unit bodies keep bare braces.
//RS // D-EFFECT-ROW2=B (ratified 2026-08-21, card #2144): effect ceilings keep the
//RS // `-[` / `]>` spelling, including pure `-[]>`; D-LAMBDA-IFACE1=A gives lambdas
//RS // the same interface suffixes.
//RS // D-ARMHEAD-PAREN1=A, D-SUBJECT-COHERE1=A, and D-DEFAULT-SHAPE1=B (ratified
//RS // 2026-08-21, card #2144) add no token: arm grouping, subject chains, and
//RS // declaration defaults reuse the existing parentheses, dot, and typed-value
//RS // forms.
//RS // D-TYPE-SUFFIX1=A (ratified 2026-09-28, card #3687) amends
//RS // D-FAILURE-FOUNDATION1=A, D-OPT1, and S34: both type marks follow the type
//RS // they mark. `Entry?` is optional (`[Int?]` differs from `[Int]?`, and
//RS // `Box<Int?>` from `Box<Int>?`); the typed head is `Int?{…}`. The error
//RS // contract follows the success type: `-> Int ParseError!`,
//RS // `-> Entry? (DBError | TimeoutError)!`, unit-fallible `SaveError!`, and
//RS // `Err!` pins the default. A missing contract is the beginner route: the
//RS // callable is fallible with the implicit default `Err`. `A | B!` is taught as
//RS // `(A | B)!` (E-ERR-UNION); prefix `?T`, `!E`, and `!(A | B)` are teaching
//RS // diagnostics with a machine-applicable fix (E-TYPE-PREFIX), never aliases.
//RS // Effect denials (`-[!Mem.Alloc]>`), `?(text)`, `??`, `!x`, and `!=` keep
//RS // their spelling.
//RS // D-NEVER2=B (ratified 2026-09-02, card #2437): the existing `Never`
//RS // failure-domain name also occupies callable success-return slots
//RS // (`fn usage() Never`, `fn serve(addr: String) Never NetError!`, and
//RS // `fn() Never`). It remains uninhabited in ordinary value positions; a
//RS // declared function must have no normal path.
//RS // D-STRUCT-PLANE1=A and D-STRUCT-LIVE1=A add no spelling: structure facts use
//RS // the existing fact registry, and liveness uses the existing `_name` ladder
//RS // (D-NAME-SIGIL1). D-STRUCT-ONCE1=A adds no spelling: it extends the existing
//RS // `@loop` reach and keeps its existing compile-time mark.
//RS // D-ENTRY-VALUE1=B (card #1446) adds no token: `fn run` is the one entry, and
//RS // its return value is the program. A returned App is served at the runtime
//RS // edge; there is no hidden app-name convention or synthesized run overlay.
//RS // D-ROLEFILE1=A / D-CMDOVERRIDE1=A (card #1866) add no source token: the four
//RS // optional package-root command homes are `@run.jet`, `@build.jet`, `@dev.jet`,
//RS // and `@test.jet`, and ordinary `fn run|build|dev|test` overrides use the
//RS // existing function surface. `--show-default` selects the stock behavior.
//RS // D-CMD-OVERRIDE1=C (card #1451) remains the older test-suite API detail.
//RS // D-JOB-NAME1=A (ratified 2026-08-05, card #1448) adds no token: the marker
//RS // and every command use `job`. Canonical CLI is `jet run <entry> -- <name>`
//RS // and `jet jobs`. Retired spellings have no alias or fallback. Help,
//RS // completions, diagnostics, docs, examples, and tests use the same word.
//RS // KW_JOB / JOB_SCOPE_VARIANTS live in math_layout and are re-exported here.
//RS // EFFECT_ARROW_OPEN/CLOSE (`-[` / `]>`) add effect ceilings. The unified
//RS // arrow selects dispatch/guard values, yields finite-loop items, and marks a
//RS // one-line effect `if`/`loop` body. D-LOOP-STMT-ARROW1=C (ratified
//RS // 2026-08-13, card #1453) gives every statement-position loop header this
//RS // body form. D-TAIL-RETURN1=A amends D-BODY-LAST1: `->` remains the
//RS // one-expression function-body marker, braces hold statements, and the sole
//RS // unadorned final expression supplies a value when the block expects one.
//RS // `::` remains the name-binding sigil, and `=` remains for slot-filling
//RS // declarations such as extern bindings.
//RS // D-LOOP-COMMA1=A (ratified 2026-07-30, card #1336) uses `(key, value)` for a
//RS // two-name source binding. D-LOOP-IN1=A (card #2153) joins a source binding to
//RS // its source with reserved keyword `in`; commas remain for later clauses such
//RS // as a stride. Expression-position `x in xs` has no operator spelling.
//RS // D-LOOP-GUARD1=A (ratified 2026-08-20, card #1416) keeps yielding-loop
//RS // guards comma-less: `loop name in source if condition -> value`; `, if` is
//RS // E0379, never a stride.
//RS // D-TIME-IN1=C (ratified 2026-08-28, card #2283) keeps bare `in` reserved for
//RS // source-loop parsing while the postfix lexer/parser carve-out admits it after
//RS // `.`. Thus `duration.in(.Seconds)` is a normal method call without making
//RS // `in` a general identifier.
//RS // D-LOOPREAD1=A (ratified 2026-09-04, card #2896) keeps the state-loop
//RS // initializer one-shot. A condition that reads unchanged header state can
//RS // repeat forever; L0529 teaches repeated input with the existing source-loop
//RS // `in` form and the body-first `if test { break }` exit shape. No new loop
//RS // syntax enters.
//RS // D-LOOPSTATE1 owns break/next target arguments, and
//RS // D-COMPREHENSION1 fixes yielding-loop results to eager List.
//RS // D-IFGUARD1=A adds no spelling: subjectless statement/value guard tables
//RS // reuse KW_IF, KW_ELSE, OP_UNIFIED_ARROW, braces, and ordinary Bool expressions.
//RS // D-IFDIST1=A (ratified 2026-07-28, card #1305) adds no token: any comparison
//RS // (`== != < > <= >=`) may mark `if subject OP { … }` dispatch. Bare arm atoms
//RS // desugar to `subject OP atom`; `|` unions those atoms; `&&`/`||` combine.
//RS // The same table is a ()-or-value expression in expression position.
//RS // D-LOOP-SUBJECT1=A adds no token: bindingless source loops reuse Syntax::KW_IT
//RS // as their implicit subject; scalar and `(key, value)` sources retain named bindings.
//RS // D-BRANCH-PREF1=A / D-BRANCH-ONELINE1=A / D-BRANCH-ELSEIF1=A /
//RS // D-BRANCH-LINT1=A / D-BRANCH-VALUE1=A / D-BRANCH-FMT1=C /
//RS // D-BRANCH-TEACH1=A (ratified 2026-07-28, card #1259) add no token:
//RS // multi-line braced branches and `else if` chains get L0507, while one-line
//RS // effect and value forms stay quiet. Fmt preserves the author's branch shape.
//RS // D-EFFECT-DECL1=A (ratified 2026-07-28, card #1299) mints KW_EFFECT_DECL:
//RS // `effect Root.Leaf` adds one package-view fact and erases before TIR.
//RS // D-AUTHORITY-ROOTS1=A (ratified 2026-08-06, card #1567) keeps the closed
//RS // grantable root table at thirteen and serves foreign-language leaves through
//RS // BUILTIN_EFFECT_LEAVES (`FFI.Go`, `FFI.Py`, `FFI.Octave`, and the other
//RS // supported binders). `Panic` and `Mem` are deny-only rows, not roots.
//RS // D-ABILITY-NAME2=A (ratified 2026-08-25, card #2187) retires the old
//RS // vocabulary: the fact menu is `Effect`, the carried rights value is
//RS // `Authority`, and the block marker is `#FX`. Browser `.abilities()` remains a
//RS // protocol value; build tooling reports the FX graph instead.
//RS // D-EACH1=C (ratified 2026-07-28, card #1239) mints SIGIL_FENCE_OPEN /
//RS // SIGIL_FENCE_CLOSE and D-FENCE-GLYPH1=A (card #1516) opens expression-position
//RS // fences to expression entries: the statement is copied once per entry, fences
//RS // advance in lock-step. D-FENCE2=A (ratified 2026-09-28, card #3662) respells
//RS // the fence `<: a, b :>` and reclaims `:>` from the D-ARROW-RESPELL1 retired
//RS // arrow; a stray `:>` teaches `->` through E0070. RETIRED_FENCE_OPEN/CLOSE
//RS // (`@[`/`]@`) remain only for the E-FENCE-SPELLING teaching diagnostic.
//RS // D-SHAPE-CONVERT1=A adds no punctuation: explicit conversion is always a
//RS // destination-owned `Target.from_source(value)` static method. Text remains
//RS // the existing `Target.parse(text)` operation; source-owned `to_*` aliases are
//RS // not part of the language surface.
//RS // D-OPDEF1=A adds no punctuation: `impl Type.Add`/`.Sub`/`.Mul`/`.Div`,
//RS // `.Equatable`, and `.Comparable` reuse ordinary trait-impl dot syntax.
//RS // D-META-AUTO1=A / D-AUTODERIVE1=E / D-AUTODERIVE-SYNTAX1=D (ratified
//RS // 2026-07-29, cards #1267/#1545) amend S55 and D-MARK-DEBUG1. Every
//RS // structurally derivable built-in capability — Printable, Equatable, Debug,
//RS // Comparable, Encode, and Decode — auto-derives when fields qualify. The
//RS // package default is refused through the named `policy.lints.deny` entry
//RS // `auto_derive`. At a type site, ordinary marker names opt in and a leading
//RS // Bang opts out (`#!Printable`, `#!Codable`, `#[!Debug, Equatable]`). Missing
//RS // traits follow the package default; a hand-written impl always wins.
//RS // D-HTTP-ROUTE-SYNTAX2=A owns the two route-pattern markers carried inside
//RS // ordinary String values. They are not lexer tokens; the HTTP router consumes
//RS // them after String evaluation.
//RS // D-FLOWTYPE1=A adds no token: after a stable immutable `?T` name is checked
//RS // with `x != None` (true) or `x == None` (false/else), sema refines that name
//RS // to `T` for the proven branch and records an S31 Present unwrap for TIR.
//RS // Mutable locals, fields, indexes, aliases, and calls stay `?T`; bind with
//RS // `x == Val(v)` instead. Facts reach the right side of `&&` only, not `||`.
//RS // D-OPT-LIFT1=A adds no token: a plain `T` fills any slot whose checked type
//RS // is `T?` (returns, arguments, fields, list/map items, typed bindings,
//RS // reassignment) and `x == 5` compares a `?T` with a present `T`; sema adds
//RS // one `Present`. The full rule lives on `LIT_VALUE` in `Syntax/core_surface.rs`.
//RS // D-UNIONTYPE1=A reuses the existing `|` token (TokKind::Pipe / BitOr) in type
//RS // position as TYPE_UNION_SEP. `T !(E1 | E2)` parses as `T !(E1 | E2)`.
//RS // D-BITOREXPR1=A (ratified 2026-08-28, card #2299) admits the same token in
//RS // value position as bitwise OR. It binds tighter than comparisons; type
//RS // position remains the union grammar above.
//RS // D-REGEX-LIT1=D adds no punctuation. Regex patterns use the universal
//RS // `Type{ body }` / inferred `{ body }` form from D-LIT-DOT1.
//RS // D-RANGE-VALUE1=A makes `a..b` and `a..<b` construct one nominal Range
//RS // value. Range carries end inclusivity; arm heads and distinct constraints
//RS // keep their literal-only grammar.
//RS // D-TYPE2-SPELL1=A makes `Int(lo..hi)` the structural inline refinement in
//RS // every type position. `TYPE_INLINE_RANGE` is re-exported from math_layout.
//RS // D-FMT-INTERP1=A adds `Fixed` to the closed interpolation-selector set:
//RS // `{value:Fixed(n)}` uses the colon rail and ordinary integer-call parentheses.
//RS // D-FMT-PLAIN1=A adds `Grouped(n)` as the explicit human-grouping escape while
//RS // `Fixed(n)` and `core.text.fmt.decimal` remain machine-plain.
//RS // D-FMT-PRETTY1=A (ratified 2026-08-14, card #1966) adds `Pretty` to the same
//RS // rail; it expands canonical Debug output with stable two-space indentation.
//RS // D-FMT-INTERP3=B (ratified 2026-08-27, card #2257) adds the closed selector
//RS // family `Hex(n)`, `Pad(n[, "fill"])`, `PadLeft(n[, "fill"])`, `Sci(n)`,
//RS // `Percent(n)`, `Bin`, and `Oct`. Each selector lowers to one shared
//RS // `core.text.fmt` function; all execution tiers must preserve the exact output.
//RS // D-FMT-INTERP3=B: `Hex(n)` is the lowercase hexadecimal integer selector.
//RS // D-FMT-INTERP3=B: `Pad(n[, "fill"])` is the right-padding text selector.
//RS // D-FMT-INTERP3=B: `PadLeft(n[, "fill"])` is the left-padding text selector.
//RS // D-FMT-INTERP3=B: `Sci(n)` is the scientific-notation number selector.
//RS // D-FMT-INTERP3=B: `Percent(n)` is the percentage number selector.
//RS // D-FMT-INTERP3=B: `Bin` is the binary integer selector.
//RS // D-FMT-INTERP3=B: `Oct` is the octal integer selector.
//RS // D-FMT-INTERP2=A: trailing `=` in a hole reprints the expression source,
//RS // then " = ", then the value — `{count=}` → `count = 3`. Composes with
//RS // selectors: `{count=:Debug}`.
//RS // D-QUANTITY-PRINT1 adds `Unit(name)` and `Unit(bare)` to that same selector
//RS // rail. Bare interpolation keeps the declared symbol as the default.
//RS // D-FACTMODEL1=A: tag, state, taint-kind, and effect leaves are one erased
//RS // compile-time fact model with one segment-aware subsumption rule.
//RS // D-TAG-SURFACE1=A: `tag Name { deny: [...], from: [...] }`, direct `#Name`
//RS // value/type facts, and `#Scrub(Name)` are the sole dataflow-tag surface.
//RS // D-STATE-NS1=A: state facts have the reserved `T.State.Name` qualified plane;
//RS // bare names are sugar only inside `#State` and `#Transition`.
//RS // D-STATE-HOME1=A (amends D-STATE-NS1): the one state set is written as
//RS // `state { Name, ... }` inside its named `struct` owner. The retired sibling
//RS // `state Type { ... }` spelling is recognized only for E0157 and never creates
//RS // a second runtime type.
//RS // D-STATE-TERMINAL1=A: a checked state with no outgoing transition is a
//RS // terminal reflection fact. Entry reachability is reported only when `_ -> State`
//RS // transitions exist; this outcome adds no user-facing syntax.
//RS // D-RULEARG-TYPES1=A + D-LANGNS-NAME1=A: compiler marker vocabularies are
//RS // generated enums in `core.compiler.lang`, derived from Policy::APPLIED_RULES.
//RS // D-MARKER-NAME-HYGIENE1=A: `#Discriminant("field")` owns serde internal
//RS // discriminants and `#Job fn` owns scheduled entry functions. `#Tag` and
//RS // `#Task` are retired spellings.
//RS 
//RS // D-ADOPT-GUEST1=A: the native library edge uses matching `#Import(c)` and
//RS // `#Export(c)` spellings. The C ABI and the sema-owned guest surface are one
//RS // contract in both directions.
//RS pub const MARKER_IMPORT: &str = "Import";
//RS pub const MARKER_EXPORT: &str = "Export";
//RS 
//RS // Concurrency surface — thirteen ratified D-CONC-* outcomes on card #1505.
//RS // Rows for forms that implementation cards will make parseable belong here
//RS // now; parser and sema support land on those cards.
//RS // D-CONC-UNIT1=A and D-CONC-CROSS1=A change compiler facts only. D-CONC-STM1=A
//RS // keeps #Transact, D-CONC-SCHED1=A keeps Job/Every/Duration, and
//RS // D-CONC-STREAM1=A keeps yield/Stream. D-CONC-OUTCOME1=A is retired by
//RS // D-CONC-FAIL1=A; TaskOutcome, TaskStatus, trace, and exception have no rows.
//RS /// D-CONC-SPAWN1=D: the one reserved word for structured task spawning.
//RS pub const KW_CONC_TASK: &str = "task";
//RS /// D-CONC-FREEZE1=A (ratified 2026-08-12, card #1889): prefix verb that
//RS /// creates a deeply immutable owned snapshot for a task crossing.
//RS pub const KW_FREEZE: &str = "freeze";
//RS // D-CONC-FREEZE1=A adds no second token for consuming captures: `task ^name`
//RS // reuses SIGIL_MOVE (`^`, D-MEM1) as task-capture syntax on a group child.
//RS // The child owns the value; later use of the name is ordinary E0121.
//RS /// D-CONC-SPAWN1=D / D-CONC-ALLNAMED1=A: `task.all` is the one fan-out
//RS /// selector that accepts either positional branches or uniformly named
//RS /// branches; named branches return the existing anonymous tuple carrier.
//RS pub const TASK_ALL: &str = "task.all";
//RS /// D-CONC-SPAWN1=D: qualified fan-out selector.
//RS pub const TASK_RACE: &str = "task.race";
//RS /// D-CONC-SPAWN1=D: qualified fan-out selector.
//RS pub const TASK_ANY: &str = "task.any";
//RS /// D-CONC-SPAWN1=D: qualified fan-out selector.
//RS pub const TASK_GROUP: &str = "task.group";
//RS 
//RS /// D-CONC-JOIN1=A / D-CONC-SPAWN1=D: the nameable child-handle type.
//RS pub const TYPE_TASK: &str = "Task";
//RS 
