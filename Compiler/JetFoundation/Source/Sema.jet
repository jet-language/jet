// Backend-neutral rights rows and the one semantic walker.
use JetFoundation.Authority
use JetFoundation.Authority.[Holds, Scope, Verdict]
use JetFoundation.Syntax

// Rust: crates/jet-foundation/src/sema.rs:12
pub enum RightsRowKind { Callable, Pure, Replayable, Comptime, Invocation, Transaction }
extend RightsRowKind {
    // Rust: crates/jet-foundation/src/sema.rs:22
    pub fn name(self) -> String Never! {
        match self {
            Callable => "callable", Pure => "pure", Replayable => "replayable",
            Comptime => "comptime", Invocation => "invocation", Transaction => "transaction"
        }
    }
}
// Rust: crates/jet-foundation/src/sema.rs:37
pub struct RightsProvenance { pub source: String, pub reason: String }
extend RightsProvenance {
    // Rust: crates/jet-foundation/src/sema.rs:43
    pub fn new(source: String, reason: String) -> RightsProvenance Never! {
        RightsProvenance{source: ^source, reason: ^reason}
    }
}
// Rust: crates/jet-foundation/src/sema.rs:54
pub struct RightsRow {
    pub kind: RightsRowKind
    pub allow: Holds?
    pub deny: Holds
    pub provenance: RightsProvenance
}
extend RightsRow {
    // Rust: crates/jet-foundation/src/sema.rs:62
    pub fn new(kind: RightsRowKind, allow: Holds?, deny: Holds, provenance: RightsProvenance) -> RightsRow Never! {
        normalized: Holds? := None
        if allow is Some(rights) { normalized = Some(normalize_holds(&rights)) }
        RightsRow{kind: kind, allow: ^normalized, deny: normalize_holds(&deny), provenance: ^provenance}
    }
    // Rust: crates/jet-foundation/src/sema.rs:77
    pub fn callable(provenance: RightsProvenance) -> RightsRow Never! {
        RightsRow.new(RightsRowKind.Callable, None, Holds.new(), ^provenance)
    }
    // Rust: crates/jet-foundation/src/sema.rs:82
    pub fn pure(provenance: RightsProvenance) -> RightsRow Never! {
        RightsRow.new(RightsRowKind.Pure, Some(Holds.new()), Holds.new(), ^provenance)
    }
    // Rust: crates/jet-foundation/src/sema.rs:93
    pub fn replayable(provenance: RightsProvenance) -> RightsRow Never! {
        RightsRow.new(RightsRowKind.Replayable, None, Holds.from(["Time", "Rand", "Net", "IO"]), ^provenance)
    }
    // Rust: crates/jet-foundation/src/sema.rs:108
    pub fn comptime(provenance: RightsProvenance) -> RightsRow Never! {
        RightsRow.new(RightsRowKind.Comptime, Some(Holds.from(["Mem"])), Holds.new(), ^provenance)
    }
    // Rust: crates/jet-foundation/src/sema.rs:120
    pub fn invocation(allow: View<String>, deny: View<String>, provenance: RightsProvenance) -> RightsRow Never! {
        RightsRow.new(RightsRowKind.Invocation, Some(expand_leaves(allow)), expand_leaves(deny), ^provenance)
    }
    // Rust: crates/jet-foundation/src/sema.rs:138
    pub fn transaction(provenance: RightsProvenance) -> RightsRow Never! {
        RightsRow.new(RightsRowKind.Transaction, None, irreversible_effects(), ^provenance)
    }
    // Rust: crates/jet-foundation/src/sema.rs:148
    pub fn preset(kind: RightsRowKind, provenance: RightsProvenance) -> RightsRow Never! {
        match kind {
            Callable => RightsRow.callable(^provenance), Pure => RightsRow.pure(^provenance),
            Replayable => RightsRow.replayable(^provenance), Comptime => RightsRow.comptime(^provenance),
            Invocation => RightsRow.invocation([], [], ^provenance), Transaction => RightsRow.transaction(^provenance)
        }
    }
    // Rust: crates/jet-foundation/src/sema.rs:163
    pub fn decide(self: &RightsRow, right: String) -> Verdict Never! {
        if Authority.covers_any(&self.deny, right) { return Verdict.Denied }
        if self.allow is Some(allow) {
            if !Authority.covers_any(&allow, right) { return Verdict.Missing }
        }
        Verdict.Allowed
    }
    // Rust: crates/jet-foundation/src/sema.rs:179
    pub fn walk(self: &RightsRow, effects: &Holds, call_chain: View<String>, scope_chain: View<ScopeFrame>) -> RightsWalk Never! {
        denials: [RightsDenial] := []
        verdict := Verdict.Allowed
        // Holds is a sorted set; preserve stable BTreeSet iteration.
        for right in effects {
            answer :: self.decide(right)
            if answer != Verdict.Allowed {
                denials.push(RightsDenial{right: right.clone(), verdict: answer, row: self.provenance.clone(),
                    chain: DenialChain.new(right, call_chain, scope_chain)})
                if answer == Verdict.Denied { verdict = Verdict.Denied }
                else if verdict != Verdict.Denied { verdict = Verdict.Missing }
            }
        }
        RightsWalk{kind: self.kind, verdict: verdict, denials: ^denials}
    }
    // Rust: crates/jet-foundation/src/sema.rs:220
    pub fn observe(self: &RightsRow, callable: String, effects: &Holds, call_chain: View<String>, scope_chain: View<ScopeFrame>, legacy: fn(String) -> Verdict Never!) -> RightsWalk RightsMismatch! {
        result :: self.walk(effects, call_chain, scope_chain)
        differences: [RightsDifference] := []
        for right in effects {
            canonical :: self.decide(right)
            observed :: legacy(right)
            if canonical != observed {
                differences.push(RightsDifference{right: right.clone(), canonical: canonical, legacy: observed})
            }
        }
        if differences.is_empty() { return ^result }
        Err(RightsMismatch{callable: ^callable, kind: self.kind, row: self.provenance.clone(), differences: ^differences})
    }
}
// Rust: crates/jet-foundation/src/sema.rs:259
pub struct ScopeFrame {
    pub scope: Scope
    pub name: String
    pub grants: Holds
    pub provenance: RightsProvenance
}
extend ScopeFrame {
    // Rust: crates/jet-foundation/src/sema.rs:267
    pub fn new(scope: Scope, name: String, grants: Holds, provenance: RightsProvenance) -> ScopeFrame Never! {
        ScopeFrame{scope: scope, name: ^name, grants: normalize_holds(&grants), provenance: ^provenance}
    }
}
// Rust: crates/jet-foundation/src/sema.rs:284
pub struct DenialChain {
    pub right: String
    pub call_chain: [String]
    pub scope_chain: [ScopeFrame]
    pub nearest_granting_scope: ScopeFrame?
}
extend DenialChain {
    // Rust: crates/jet-foundation/src/sema.rs:292
    pub fn new(right: String, call_chain: View<String>, scope_chain: View<ScopeFrame>) -> DenialChain Never! {
        nearest: ScopeFrame? := None
        for frame in scope_chain.iter().rev() {
            if Authority.covers_any(&frame.grants, right) { nearest = Some(frame.clone()); break }
        }
        DenialChain{right: right.clone(), call_chain: call_chain.to_vec(), scope_chain: scope_chain.to_vec(), nearest_granting_scope: ^nearest}
    }
}
// Rust: crates/jet-foundation/src/sema.rs:309
pub struct RightsDenial { pub right: String, pub verdict: Verdict, pub row: RightsProvenance, pub chain: DenialChain }
// Rust: crates/jet-foundation/src/sema.rs:318
pub struct RightsWalk { pub kind: RightsRowKind, pub verdict: Verdict, pub denials: [RightsDenial] }
extend RightsWalk {
    // Rust: crates/jet-foundation/src/sema.rs:326
    pub fn allowed(self: &RightsWalk) -> Bool Never! { self.verdict == Verdict.Allowed }
}
// Rust: crates/jet-foundation/src/sema.rs:333
pub struct RightsDifference { pub right: String, pub canonical: Verdict, pub legacy: Verdict }
// Rust: crates/jet-foundation/src/sema.rs:341
#Error
pub struct RightsMismatch { pub callable: String, pub kind: RightsRowKind, pub row: RightsProvenance, pub differences: [RightsDifference] }
// Rust: crates/jet-foundation/src/sema.rs:350
pub fn walk(row: &RightsRow, effects: &Holds, call_chain: View<String>, scope_chain: View<ScopeFrame>) -> RightsWalk Never! {
    row.walk(effects, call_chain, scope_chain)
}
// Rust: crates/jet-foundation/src/sema.rs:361
pub fn expand_leaves(rights: View<String>) -> Holds Never! {
    known_leaves := Syntax.BUILTIN_EFFECT_LEAVES.to_vec()
    for declaration in Authority.effect_declarations() {
        if declaration.name.contains(".") { known_leaves.push(declaration.name) }
    }
    expanded := Holds.new()
    for right in rights {
        trimmed := right.trim() // #4303
        canonical :: Authority.parse_right(right).unwrap_or_else(fn() { trimmed.to_string() })
        expanded.insert(canonical.clone())
        for leaf in &known_leaves {
            if Authority.covers(canonical, leaf) { expanded.insert(leaf.to_string()) }
        }
    }
    ^expanded
}
// Rust: crates/jet-foundation/src/sema.rs:391
pub fn irreversible_effects() -> Holds Never! {
    effects := Holds.new()
    for declaration in Authority.effect_declarations() {
        if declaration.irreversible { effects.insert(declaration.name.to_string()) }
    }
    ^effects
}
// Rust: crates/jet-foundation/src/sema.rs:399
pub fn is_irreversible(right: String) -> Bool Never! { Authority.is_declared_irreversible(right) }
// Rust: crates/jet-foundation/src/sema.rs:403
fn normalize_holds(rights: &Holds) -> Holds Never! {
    normalized := Holds.new()
    for right in rights {
        trimmed := right.trim() // #4303
        normalized.insert(Authority.parse_right(right).unwrap_or_else(fn() { trimmed.to_string() }))
    }
    ^normalized
}
