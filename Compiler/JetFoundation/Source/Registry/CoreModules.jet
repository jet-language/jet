struct CoreModuleExportNames {
    module_name: String
    members: [String]
    type_exports: [String]
}

enum CoreLeafKind {
    Plain
    Enum(variants: [String])
    Generic(arity: Int)
    CryptoNominal
}

struct CoreModuleTypeExport {
    name: String
    kind: CoreLeafKind
}

// One variant of a compiler-owned Core enum family (authored in
// CoreEnumPayloadRows.jet): its payload types in slot order (an empty payload
// is a unit variant) and, for a named payload, each slot's field label (empty
// for a positional payload).
struct CoreEnumPayloadRow {
    enum_name: String
    variant: String
    payload: [Type]
    labels: [String]
}

struct CoreModuleDeclaration {
    module_name: String
    members: [String]
    type_exports: [CoreModuleTypeExport]
    dependencies: [String]
}

fn core_module_export(module_name: String) -> CoreModuleExportNames? {
    core_module_export_in(CORE_MODULE_EXPORTS, module_name)
}

// The table is a read parameter, so the scan reads its rows in place.
fn core_module_export_in(rows: [CoreModuleExportNames], module_name: String) -> CoreModuleExportNames? {
    loop row in rows {
        if row.module_name == module_name -> return Val(row)
    }
    None
}

fn core_module_export_has_name(names: [String], name: String) -> Bool Never! {
    loop item in names {
        if item == name -> return true
    }
    false
}

fn core_module_has_member(module_name: String, member: String) -> Bool Never! {
    row :: core_module_export(module_name) ?? return false
    core_module_export_has_name(row.members, member)
}

fn core_module_has_type(module_name: String, name: String) -> Bool Never! {
    row :: core_module_export(module_name) ?? return false
    core_module_export_has_name(row.type_exports, name)
}

fn core_module_type_leaf(name: String) -> String Never! {
    bytes :: name.bytes()
    namespace_separator := -1
    module_separator := -1
    index := 0
    loop index < bytes.len() {
        if {
            index + 1 < bytes.len() && bytes[index] == (U8{58}) && bytes[index + 1] == (U8{58}) -> {
                namespace_separator = index
                index += 1
            }
            else -> {
                if bytes[index] == (U8{46}) -> module_separator = index
                index += 1
            }
        }
    }
    if {
        namespace_separator >= 0 -> String.from_bytes(bytes[namespace_separator + 2..<bytes.len()]) ?? name
        module_separator >= 0 -> String.from_bytes(bytes[module_separator + 1..<bytes.len()]) ?? name
        else -> name
    }
}

fn core_type_modules(name: String) -> [String] Never! {
    core_type_modules_in(CORE_MODULE_EXPORTS, core_module_type_leaf(name))
}

// The table is a read parameter, so the scan reads its rows in place.
fn core_type_modules_in(rows: [CoreModuleExportNames], leaf: String) -> [String] Never! {
    modules := [String]{}
    loop row in rows {
        if core_module_export_has_name(row.type_exports, leaf) -> &modules.push(row.module_name)
    }
    modules
}

// Rust `CoreModuleExports::core_enum_variants`: the canonical variant names of
// a Core enum leaf. Payload shape stays with the checked source declaration.
fn core_enum_variants(name: String) -> [String]? {
    core_enum_variants_in(CORE_ENUM_ROWS, name)
}

fn core_enum_variants_in(rows: [CoreModuleTypeExport], name: String) -> [String]? {
    loop row in rows {
        if row.name != name -> next
        if row.kind == .Enum(variants) -> return Val(variants)
    }
    None
}

// One source-owned Core nominal (`source_module … types { … }` in
// Prelude/Core.jet; Rust `CoreModuleExports::CoreSourceOwnedType`).
struct CoreSourceOwnedType {
    path: String
    name: String
}

// Rust `CoreModuleExports::core_source_owns_type`: whether a checked Core
// identity (`<corelib>/core.net.url::URL`) names a source-owned
// Core nominal, including exact registered source value-hook owners. An owned
// type remains the Jet declaration on every tier, never a native projection.
fn core_source_owns_type(name: String) -> Bool Never! {
    core_source_owns_type_in(CORE_SOURCE_OWNED_TYPES, name)
        || core_source_value_hook(name, "clone") != None
        || core_source_value_hook(name, "show") != None
        || core_source_value_hook(name, "debug") != None
}

// The table is a read parameter, so the scan reads its rows in place.
fn core_source_owns_type_in(rows: [CoreSourceOwnedType], name: String) -> Bool Never! {
    module_name :: core_identity_module(name) ?? return false
    parts :: name.split("::").to_list()
    if parts.len() < 2 -> return false
    leaf :: parts[parts.len() - 1]
    file :: core_module_source_path(module_name) ?? return false
    loop row in rows {
        if row.name == leaf && row.path == file -> return true
    }
    false
}

// The existing public bool(p) arity targets one reserved source
// method. This is not an overload mechanism or a native receiver route.
CORE_SOURCE_BOOL_P_OWNER :: [CoreSourceOwnedType]{
    {path: "Core/Math/Random.jet", name: "RNG"},
}
fn core_source_receiver_method(identity: String, method: String, nargs: Int) -> String Never! {
    if method == "bool" && nargs == 1 && core_source_owns_type(identity) && core_source_owns_type_in(CORE_SOURCE_BOOL_P_OWNER, identity) -> return "__bool_p"
    method.copy()
}

// Exact Rust CoreModuleExports table: an established bare spelling's
// declaring source owner, never a general public-alias re-export mechanism.
struct CoreBareSourceModule {
    name: String
    module_name: String
}
CORE_BARE_SOURCE_MODULES :: [CoreBareSourceModule]{
    {name: "URL", module_name: "core.net.url"},
    {name: "Perf", module_name: "core.perf"},
    {name: "RNG", module_name: "core.testing"},
    {name: "Vec2", module_name: "core.math"},
    {name: "Vec3", module_name: "core.math"},
    {name: "Vec4", module_name: "core.math"},
    {name: "Mat3", module_name: "core.math"},
    {name: "Mat4", module_name: "core.math"},
    {name: "F64x4", module_name: "core.math"},
    {name: "ScreenPoint", module_name: "core.math"},
    {name: "ScreenDelta", module_name: "core.math"},
    {name: "WorldPoint", module_name: "core.math"},
    {name: "WorldDelta", module_name: "core.math"},
    {name: "ViewPoint", module_name: "core.math"},
    {name: "ViewDelta", module_name: "core.math"},
    {name: "CameraPoint", module_name: "core.math"},
    {name: "CameraDelta", module_name: "core.math"},
    {name: "DevicePoint", module_name: "core.math"},
    {name: "DeviceDelta", module_name: "core.math"},
    {name: "Point2", module_name: "core.math"},
    {name: "Delta2", module_name: "core.math"},
    {name: "TransformError", module_name: "core.math"},
    {name: "Transform", module_name: "core.math"},
    {name: "Transform2", module_name: "core.math"},
    {name: "Ray2", module_name: "core.math"},
    {name: "Fraction", module_name: "core.math"},
    {name: "Decimal", module_name: "core.math"},
    {name: "Complex", module_name: "core.math"},
}
fn core_bare_source_module(name: String) -> String? Never! {
    loop row in CORE_BARE_SOURCE_MODULES {
        if row.name == name -> return Val(row.module_name)
    }
    None
}

// Rust `CoreModuleExports::CORE_ROOT_TYPES`: the Core value types a bare
// spelling names wherever Core is loaded, so a parameterless Core alias of one
// of them stays a candidate owner of that bare name.
CORE_ROOT_TYPES :: [String]{"Date", "LocalDate", "LocalTime", "Decimal", "Fraction", "Duration", "Instant", "Authority"}
fn core_root_type(name: String) -> Bool Never! {
    CORE_ROOT_TYPES.contains(name)
}

// Private semantic routes belong to an exact source declaration, never a
// short nominal spelling. They do not add public trait implementations.
fn core_source_value_hook(name: String, operation: String) -> String? Never! {
    if !name.starts_with("<corelib>/") -> return None
    if !core_identity_is(name, "core.compute.solve", "Solver") -> return None
    if operation == {
        "show" -> Val("__show")
        "debug" -> Val("__debug")
        else -> None
    }
}
// The variant names of a compiler-owned Core enum family with payload rows
// (`IOError`, `IOOperation`, `ProcessStreamMode`, ...), in table order.
fn core_enum_payload_variants(name: String) -> [String]? {
    variants := [String]{}
    loop row in CORE_ENUM_PAYLOAD_ROWS {
        if row.enum_name == name -> &variants.push(row.variant)
    }
    if variants.len() == 0 -> None else -> Val(variants)
}

// The positional payload types of `name.variant` for a Core enum: the
// payload rows of a compiler-owned family, otherwise a Core.jet enum leaf's
// unit variant (Rust `core_declared_enum_variants`). `None` when the enum or
// its variant is not a Core enum case.
fn core_enum_variant_payload(name: String, variant: String) -> [Type]? {
    family := false
    loop row in CORE_ENUM_PAYLOAD_ROWS {
        if row.enum_name != name -> next
        if row.variant == variant -> return Val(row.payload)
        family = true
    }
    if family -> return None
    declared :: core_enum_variants(name) ?? return None
    if declared.contains(variant) -> Val([Type]{}) else -> None
}

// The field labels of `name.variant`'s named payload, in slot order. `None`
// when the variant is not a compiler-owned case with a named payload.
fn core_enum_variant_labels(name: String, variant: String) -> [String]? {
    loop row in CORE_ENUM_PAYLOAD_ROWS {
        if row.enum_name == name && row.variant == variant -> return if row.labels.len() == 0 -> None else -> Val(row.labels)
    }
    None
}

// The variants of the enum `name` that the Core module `module_name` exports:
// the module's catalog row authenticates the export, and the generator keeps
// every enum leaf's variant list identical across the modules that export it.
// `None` when that module does not export `name` or `name` is not an enum.
fn core_module_enum_variants(module_name: String, name: String) -> [String]? {
    if !core_module_has_type(module_name, name) -> return None
    if core_enum_payload_variants(name) == .Val(variants) -> return Val(variants)
    core_enum_variants(name)
}

// One field of a builtin Core record; rows are authored in CoreRecordRows.jet
// and the first match wins.
struct CoreRecordFieldRow {
    owner: String
    field: String
    ty: Type
}

// The declared field list of a Core record users can build with a struct
// literal (Rust `core_constructable_fields`), in declaration order.
struct CoreRecordLiteralRow {
    owner: String
    fields: [TypeTupleField]
    core_only: Bool{false}
}

// The Core module a Core declaration key or module identity names
// (`<corelib>/core.crypto.vault::Secret` -> `core.crypto.vault`).
fn core_identity_module(key: String) -> String? Never! {
    if !key.starts_with("<corelib>/") -> return None
    rest :: key.slice("<corelib>/".len(), key.len())
    if rest.split_once("::") == .Val(parts) -> return Val(parts.before)
    Val(rest)
}

// The source path of Core module `module_name` (`core.crypto.vault` ->
// `Core/Crypto/Vault.jet`), from the Core source table.
fn core_module_source_path(module_name: String) -> String? Never! {
    loop row in CORE_SOURCE_OWNED_ROWS {
        if row.module_name == module_name -> return Val(row.path)
    }
    None
}

// Whether `key` is exactly the declaration `leaf` of Core module `module_name`.
fn core_identity_is(key: String, module_name: String, leaf: String) -> Bool Never! {
    expected :: "<corelib>/{module_name}::{leaf}"
    key == expected
}

// Whether a Core module identity or declaration key belongs to Core module
// `module_name` (`core.sync`) or one of its submodules (`core.sync.rows`).
fn core_identity_in_module(key: String, module_name: String) -> Bool Never! {
    prefix :: "<corelib>/{module_name}"
    key == prefix || key.starts_with("{prefix}::") || key.starts_with("{prefix}.")
}

// Corelib nominal types carry a source identity; the record oracle is keyed
// by the declared leaf (`<corelib>/core.process::ProcessReceipt`).
fn core_record_leaf(owner: String) -> String Never! {
    if !owner.starts_with("<corelib>/") -> return "{owner}"
    parts :: owner.split("::").to_list()
    "{parts[parts.len() - 1]}"
}

fn core_record_field(owner: String, field: String) -> Type? {
    core_record_field_in(CORE_RECORD_FIELD_ROWS, core_record_leaf(owner), field)
}

// The table is a read parameter, so the scan reads its rows in place.
fn core_record_field_in(rows: [CoreRecordFieldRow], owner: String, field: String) -> Type? {
    loop row in rows {
        if row.owner == owner && row.field == field -> return Val(row.ty)
    }
    None
}

fn core_record_literal_fields(owner: String) -> [TypeTupleField]? {
    core_record_literal_fields_in(CORE_RECORD_LITERAL_ROWS, core_record_leaf(owner))
}

fn core_record_literal_is_core_only(owner: String) -> Bool Never! {
    leaf :: core_record_leaf(owner)
    loop row in CORE_RECORD_LITERAL_ROWS {
        if row.owner == leaf -> return row.core_only
    }
    false
}

fn core_record_literal_fields_in(rows: [CoreRecordLiteralRow], owner: String) -> [TypeTupleField]? {
    loop row in rows {
        if row.owner == owner -> return Val(row.fields)
    }
    None
}
