pub struct CoreModuleExportNames {
    pub module_name: String
    pub members: [String]
    pub type_exports: [String]
}

pub enum CoreLeafKind {
    Plain
    Enum(variants: [String])
    Generic(arity: Int)
    CryptoNominal
}

pub struct CoreModuleTypeExport {
    pub name: String
    pub kind: CoreLeafKind
}

pub struct CoreModuleDeclaration {
    pub module_name: String
    pub members: [String]
    pub type_exports: [CoreModuleTypeExport]
    pub dependencies: [String]
}

fn core_module_export(module_name: String) -> CoreModuleExportNames? {
    loop row in @CORE_MODULE_EXPORTS {
        if row.module_name == module_name -> return Val(row)
    }
    None
}

fn core_module_export_has_name(names: [String], name: String) -> Bool {
    loop item in names {
        if item == name -> return true
    }
    false
}

pub fn core_module_has_member(module_name: String, member: String) -> Bool {
    row :: core_module_export(module_name) ?? return false
    core_module_export_has_name(row.members, member)
}

pub fn core_module_has_type(module_name: String, name: String) -> Bool {
    row :: core_module_export(module_name) ?? return false
    core_module_export_has_name(row.type_exports, name)
}

fn core_module_type_leaf(name: String) -> String {
    bytes :: name.bytes()
    namespace_separator := -1
    module_separator := -1
    index := 0
    loop index < bytes.len() {
        if {
            index + 1 < bytes.len() && bytes[index] == (U8{58}) && bytes[index + 1] == (U8{58}) -> {
                namespace_separator = index
                index += 1
            }
            else -> {
                if bytes[index] == (U8{46}) -> module_separator = index
                index += 1
            }
        }
    }
    if {
        namespace_separator >= 0 -> String.from_bytes(bytes[namespace_separator + 2..bytes.len()]) ?? name
        module_separator >= 0 -> String.from_bytes(bytes[module_separator + 1..bytes.len()]) ?? name
        else -> name
    }
}

pub fn core_type_modules(name: String) -> [String] {
    leaf :: core_module_type_leaf(name)
    modules := [String]{}
    loop row in @CORE_MODULE_EXPORTS {
        if core_module_export_has_name(row.type_exports, leaf) -> &modules.push(row.module_name)
    }
    modules
}
fn core_module_source_declaration_line(source_text: String, module_name: String) -> String? {
    prefix := "module " + module_name + " "
    source_bytes := source_text.bytes()
    line_start := 0
    loop line_start < source_bytes.len() {
        line_end := line_start
        loop line_end < source_bytes.len() && source_bytes[line_end] != (U8{10}) -> line_end += 1
        line :: String.from_bytes(source_bytes[line_start..line_end]) ?? return None
        trimmed := line.trim()
        if trimmed.starts_with(prefix) -> return Val(trimmed)
        line_start = line_end + 1
    }
    None
}

fn core_module_source_brace_clause(line: String, name: String) -> String? {
    prefix := name + " " + "{{"
    parts := line.split(prefix).to_list()
    if parts.len() != 2 -> return None
    bytes := parts[1].bytes()
    end := 0
    loop end < bytes.len() {
        if bytes[end] == (U8{125}) {
            return Val(String.from_bytes(bytes[0..end]) ?? "")
        }
        end += 1
    }
    None
}

fn core_module_source_bracket_clause(line: String, name: String) -> String? {
    prefix := name + " ["
    parts := line.split(prefix).to_list()
    if parts.len() != 2 -> return None
    bytes := parts[1].bytes()
    end := 0
    loop end < bytes.len() {
        if bytes[end] == (U8{93}) {
            return Val(String.from_bytes(bytes[0..end]) ?? "")
        }
        end += 1
    }
    None
}

fn core_module_source_names(text: String) -> [String] {
    names := [String]{}
    if text.trim() == "" -> return names
    loop part in text.split(",") {
        name := part.trim()
        if name != "" -> &names.push(name)
    }
    names
}

fn core_module_source_names_equal(left: [String], right: [String]) -> Bool {
    if left.len() != right.len() -> return false
    loop index in 0..<left.len() {
        if left[index] != right[index] -> return false
    }
    true
}

fn core_module_source_leaf_kind(text: String) -> CoreLeafKind? {
    value := text.trim()
    if value == "plain" -> return Val(CoreLeafKind.Plain)
    if value == "crypto_nominal" -> return Val(CoreLeafKind.CryptoNominal)
    if value.starts_with("plain(") && value.ends_with(")") {
        bytes := value.bytes()
        variants_text :: String.from_bytes(bytes[6..bytes.len() - 1]) ?? return None
        variants := [String]{}
        if variants_text.trim() != "" {
            loop variant in variants_text.split("|") {
                name := variant.trim()
                if name == "" -> return None
                &variants.push(name)
            }
        }
        return Val(CoreLeafKind.Enum{variants: variants})
    }
    if value.starts_with("generic(") && value.ends_with(")") {
        bytes := value.bytes()
        arity_text :: String.from_bytes(bytes[8..bytes.len() - 1]) ?? return None
        arity :: Int.parse(arity_text.trim()) ?? return None
        if arity < 0 -> return None
        return Val(CoreLeafKind.Generic{arity: arity})
    }
    None
}

fn core_module_source_type_export(text: String) -> CoreModuleTypeExport? {
    parts := text.split(":").to_list()
    if parts.len() != 2 -> return None
    name := parts[0].trim()
    if name == "" -> return None
    kind :: core_module_source_leaf_kind(parts[1]) ?? return None
    Val(CoreModuleTypeExport{name: name, kind: kind})
}

// Parse the generated module declaration syntax directly from canonical
// Prelude/Core.jet text. Export-name rows cross-check this specialized view.
pub fn core_module_declaration_from_source(source_text: String, module_name: String) -> CoreModuleDeclaration? {
    registry :: core_module_export(module_name) ?? return None
    line :: core_module_source_declaration_line(source_text, module_name) ?? return None
    exports :: core_module_source_brace_clause(line, "exports") ?? return None
    type_text :: core_module_source_brace_clause(line, "types") ?? return None
    dependency_text :: core_module_source_bracket_clause(line, "depends_on") ?? return None
    members := core_module_source_names(exports)
    if !core_module_source_names_equal(members, registry.members) -> return None
    type_exports := [CoreModuleTypeExport]{}
    type_names := [String]{}
    if type_text.trim() != "" {
        loop raw in type_text.split(",") {
            row :: core_module_source_type_export(raw) ?? return None
            &type_names.push(row.name)
            &type_exports.push(row)
        }
    }
    if !core_module_source_names_equal(type_names, registry.type_exports) -> return None
    CoreModuleDeclaration{
        module_name: module_name,
        members: members,
        type_exports: type_exports,
        dependencies: core_module_source_names(dependency_text),
    }
}
