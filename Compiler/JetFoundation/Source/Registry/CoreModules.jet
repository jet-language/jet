pub struct CoreModuleExportNames {
    pub module_name: String
    pub members: [String]
    pub type_exports: [String]
}

pub enum CoreLeafKind {
    Plain
    Enum(variants: [String])
    Generic(arity: Int)
    CryptoNominal
}

pub struct CoreModuleTypeExport {
    pub name: String
    pub kind: CoreLeafKind
}

pub struct CoreModuleDeclaration {
    pub module_name: String
    pub members: [String]
    pub type_exports: [CoreModuleTypeExport]
    pub dependencies: [String]
}

// Routing metadata does not retain or construct embedded package source text.
pub struct CoreSourceModule {
    pub module_name: String
    pub alias: String
    pub path: String
    pub owned_members: [String]
}

pub struct CoreBootstrapStep {
    pub name: String
    pub dependencies: [String]
}

pub fn core_module_export(module_name: String) -> CoreModuleExportNames? {
    core_module_export_in(CORE_MODULE_EXPORTS, module_name)
}

// The table is a read parameter, so the scan reads its rows in place.
fn core_module_export_in(rows: [CoreModuleExportNames], module_name: String) -> CoreModuleExportNames? {
    loop row in rows {
        if row.module_name == module_name -> return Val(row)
    }
    None
}

// A removed Core namespace and its canonical home (Rust `Syntax::RETIREMENTS`
// semantic rows with code E1001).
pub struct CoreModuleRetirement {
    pub retired: String
    pub canonical: String
    pub decision: String
}

pub fn core_module_retirements() -> [CoreModuleRetirement] Never! {
    // Rust: Syntax::retired_core_module. Preserve this distinct consumer
    // projection without maintaining a second retirement vocabulary.
    result := [CoreModuleRetirement]{}
    loop row in RETIREMENTS {
        if row.kind == RetirementKind.Semantic && row.code == (Val("E1001")) -> &result.push(CoreModuleRetirement{retired: row.retired, canonical: row.canonical, decision: row.decision})
    }
    result
}

// Rust `retired_core_module`: the longest retired namespace that is `name`
// itself or a dotted prefix of it.
pub fn core_module_retirement(name: String) -> CoreModuleRetirement? {
    found := CoreModuleRetirement?{None}
    best := -1
    loop row in core_module_retirements() {
        if row.retired != name && !name.starts_with("{row.retired}.") -> next
        if row.retired.len() >= best {
            best = row.retired.len()
            found = Val(row)
        }
    }
    found
}

pub fn core_module_export_has_name(names: [String], name: String) -> Bool Never! {
    loop item in names {
        if item == name -> return true
    }
    false
}

pub fn core_module_has_member(module_name: String, member: String) -> Bool Never! {
    row :: core_module_export(module_name) ?? return false
    core_module_export_has_name(row.members, member)
}

pub fn core_module_has_type(module_name: String, name: String) -> Bool Never! {
    row :: core_module_export(module_name) ?? return false
    core_module_export_has_name(row.type_exports, name)
}

pub fn core_module_type_leaf(name: String) -> String Never! {
    bytes :: name.bytes()
    namespace_separator := -1
    module_separator := -1
    index := 0
    loop index < bytes.len() {
        if {
            index + 1 < bytes.len() && bytes[index] == (U8{58}) && bytes[index + 1] == (U8{58}) -> {
                namespace_separator = index
                index += 1
            }
            else -> {
                if bytes[index] == (U8{46}) -> module_separator = index
                index += 1
            }
        }
    }
    if {
        namespace_separator >= 0 -> String.from_bytes(bytes[namespace_separator + 2..<bytes.len()]) ?? name
        module_separator >= 0 -> String.from_bytes(bytes[module_separator + 1..<bytes.len()]) ?? name
        else -> name
    }
}

pub fn core_type_modules(name: String) -> [String] Never! {
    core_type_modules_in(CORE_MODULE_EXPORTS, core_module_type_leaf(name))
}

// The table is a read parameter, so the scan reads its rows in place.
fn core_type_modules_in(rows: [CoreModuleExportNames], leaf: String) -> [String] Never! {
    modules := [String]{}
    loop row in rows {
        if core_module_export_has_name(row.type_exports, leaf) -> &modules.push(row.module_name)
    }
    modules
}

// Rust `CoreModuleExports::core_enum_variants`: the canonical variant names of
// a Core enum leaf. Payload shape stays with the checked source declaration.
pub fn core_enum_variants(name: String) -> ?View<String> {
    loop declaration in CORE_MODULE_DECLARATIONS {
        loop row in declaration.type_exports {
            if row.name != name -> next
            if row.kind == .Enum(variants) -> return Val(variants[0..<variants.len()])
        }
    }
    None
}
fn core_module_source_declaration_line(source_text: String, module_name: String) -> String? {
    prefix := "module {module_name} "
    source_bytes := source_text.bytes()
    line_start := 0
    loop line_start < source_bytes.len() {
        line_end := line_start
        loop line_end < source_bytes.len() && source_bytes[line_end] != (U8{10}) -> line_end += 1
        line :: String.from_bytes(source_bytes[line_start..<line_end]) ?? return None
        trimmed := line.trim() // #4303: trim view flows into String calls.
        if trimmed.starts_with(prefix) -> return Val(trimmed)
        line_start = line_end + 1
    }
    None
}

fn core_module_source_brace_clause(line: String, name: String) -> String? {
    prefix := "{name} {{"
    parts := line.split(prefix).to_list()
    if parts.len() != 2 -> return None
    bytes := parts[1].bytes()
    end := 0
    loop end < bytes.len() {
        if bytes[end] == (U8{125}) {
            return Val(String.from_bytes(bytes[0..<end]) ?? "")
        }
        end += 1
    }
    None
}

fn core_module_source_bracket_clause(line: String, name: String) -> String? {
    prefix := "{name} ["
    parts := line.split(prefix).to_list()
    if parts.len() != 2 -> return None
    bytes := parts[1].bytes()
    end := 0
    loop end < bytes.len() {
        if bytes[end] == (U8{93}) {
            return Val(String.from_bytes(bytes[0..<end]) ?? "")
        }
        end += 1
    }
    None
}

fn core_module_source_names(text: String) -> [String] Never! {
    names := [String]{}
    if text.trim() == "" -> return names
    loop part in text.split(",") {
        name := part.trim() // #4303: trim view flows into String calls.
        if name != "" -> &names.push(name)
    }
    names
}

fn core_module_source_names_equal(left: [String], right: [String]) -> Bool Never! {
    if left.len() != right.len() -> return false
    loop index in 0..<left.len() {
        if left[index] != right[index] -> return false
    }
    true
}

fn core_module_source_leaf_kind(text: String) -> CoreLeafKind? {
    value := text.trim() // #4303: trim view flows into String calls.
    if value == "plain" -> return Val(CoreLeafKind.Plain)
    if value == "crypto_nominal" -> return Val(CoreLeafKind.CryptoNominal)
    if value.starts_with("plain(") && value.ends_with(")") {
        bytes := value.bytes()
        variants_text :: String.from_bytes(bytes[6..<bytes.len() - 1]) ?? return None
        variants := [String]{}
        if variants_text.trim() != "" {
            loop variant in variants_text.split("|") {
                name := variant.trim() // #4303: trim view flows into String calls.
                if name == "" -> return None
                &variants.push(name)
            }
        }
        return Val(CoreLeafKind.Enum{variants: variants})
    }
    if value.starts_with("generic(") && value.ends_with(")") {
        bytes := value.bytes()
        arity_text :: String.from_bytes(bytes[8..<bytes.len() - 1]) ?? return None
        arity :: Int.parse(arity_text.trim()) ?? return None
        if arity < 0 -> return None
        return Val(CoreLeafKind.Generic{arity: arity})
    }
    None
}

fn core_module_source_type_export(text: String) -> CoreModuleTypeExport? {
    parts := text.split(":").to_list()
    if parts.len() != 2 -> return None
    name := parts[0].trim() // #4303: trim view flows into String calls.
    if name == "" -> return None
    kind :: core_module_source_leaf_kind(parts[1]) ?? return None
    Val(CoreModuleTypeExport{name: name, kind: kind})
}

// Parse the generated module declaration syntax directly from canonical
// Prelude/Core.jet text. Export-name rows cross-check this specialized view.
pub fn core_module_declaration_from_source(source_text: String, module_name: String) -> CoreModuleDeclaration? {
    registry :: core_module_export(module_name) ?? return None
    line :: core_module_source_declaration_line(source_text, module_name) ?? return None
    exports :: core_module_source_brace_clause(line, "exports") ?? return None
    type_text :: core_module_source_brace_clause(line, "types") ?? return None
    dependency_text :: core_module_source_bracket_clause(line, "depends_on") ?? return None
    members := core_module_source_names(exports)
    if !core_module_source_names_equal(members, registry.members) -> return None
    type_exports := [CoreModuleTypeExport]{}
    type_names := [String]{}
    if type_text.trim() != "" {
        loop raw in type_text.split(",") {
            row :: core_module_source_type_export(raw) ?? return None
            &type_names.push(row.name)
            &type_exports.push(row)
        }
    }
    if !core_module_source_names_equal(type_names, registry.type_exports) -> return None
    Val(CoreModuleDeclaration{
        module_name: module_name,
        members: members,
        type_exports: type_exports,
        dependencies: core_module_source_names(dependency_text),
    })
}

// Rust CoreModuleExports::lookup. The first matching module decides the result,
// even when its leaf is absent; later same-named rows never override it.
fn core_module_leaf_kind_in(table: [CoreModuleDeclaration], module_name: String, leaf: String) -> ?@CoreLeafKind from table {
    loop index in 0..<table.len() {
        if table[index].module_name != module_name -> next
        loop type_index in 0..<table[index].type_exports.len() {
            if table[index].type_exports[type_index].name == leaf -> return Val(@table[index].type_exports[type_index].kind)
        }
        return None
    }
    None
}

pub fn core_leaf_kind(module_name: String, leaf: String) -> ?@CoreLeafKind {
    core_module_leaf_kind_in(CORE_MODULE_DECLARATIONS, module_name, leaf)
}

fn core_generic_arity_in(table: [CoreModuleDeclaration], name: String) -> Int? Never! {
    arity := Int?{None}
    loop declaration in table {
        loop row in declaration.type_exports {
            if row.name != name -> next
            if row.kind == .Generic(count) {
                if arity == .Val(previous) && previous != count -> return None
                arity = Val(count)
            }
        }
    }
    arity
}

pub fn core_generic_arity(name: String) -> Int? Never! {
    core_generic_arity_in(CORE_MODULE_DECLARATIONS, name)
}

pub fn is_core_type_name(name: String) -> Bool Never! {
    if core_module_export_has_name(CORE_ROOT_TYPES, name) -> return true
    loop row in CORE_MODULE_EXPORTS {
        if core_module_export_has_name(row.type_exports, name) -> return true
    }
    false
}

pub fn core_modules() -> View<CoreModuleDeclaration> Never! {
    CORE_MODULE_DECLARATIONS[0..<CORE_MODULE_DECLARATIONS.len()]
}

pub fn core_source_modules() -> View<CoreSourceModule> Never! {
    CORE_SOURCE_MODULES[0..<CORE_SOURCE_MODULES.len()]
}

pub fn core_source_module(module_name: String) -> ?@CoreSourceModule {
    loop index in 0..<CORE_SOURCE_MODULES.len() {
        if CORE_SOURCE_MODULES[index].module_name == module_name -> return Val(@CORE_SOURCE_MODULES[index])
    }
    None
}

pub fn core_source_module_by_alias(alias: String) -> ?@CoreSourceModule {
    loop index in 0..<CORE_SOURCE_MODULES.len() {
        if CORE_SOURCE_MODULES[index].alias == alias -> return Val(@CORE_SOURCE_MODULES[index])
    }
    None
}

// Transparent math aliases keep the fixed infallible provider, at every tier.
pub fn core_source_owns(module_name: String, member: String) -> Bool Never! {
    if module_name == "core.math" {
        if member == "cmp" || member == "cos" || member == "exp" || member == "fabs" ||
            member == "is_finite" || member == "ln" || member == "sin" || member == "sqrt" -> return false
    }
    source :: core_source_module(module_name) ?? return false
    core_module_export_has_name(source.owned_members, member)
}

// D-VERDICT-1321-1: only the one-argument term wrappers are source-owned.
pub fn core_source_owns_call(module_name: String, member: String, argc: Int) -> Bool Never! {
    if module_name == "core.term" && (member == "print" || member == "eprint" || member == "progress") && argc != 1 -> return false
    core_source_owns(module_name, member)
}

pub fn core_bootstrap_order() -> View<CoreBootstrapStep> Never! {
    CORE_BOOTSTRAP_ORDER[0..<CORE_BOOTSTRAP_ORDER.len()]
}

