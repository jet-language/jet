core_bare_source_module: fn(name: String) -> String? Never! {
    core_bare_source_module_in(CORE_BARE_SOURCE_MODULES, CORE_BARE_SOURCE_KEYS, CORE_BARE_SOURCE_KEY_ROWS, name)
}

// The tables are read parameters, so the search reads their rows in place.
core_bare_source_module_in: fn(rows: [CoreBareSourceModule], keys: [String], key_rows: [Int], name: String) -> String? Never! {
    row: ir_key_row(keys, key_rows, name) ?? return None
    Val(rows[row].module_name)
}

// `input.<method>(…)`, a method the ambient `input` (Iter<String>) lacks: the
// Core function filling the row's jet_builtins role in the row's module
// (`input.csv<Row>()` is core.encoding.csv's InputCSV). The Loader loads the
// module where the source spells the call; Sema checks the call as that
// function's, with `input` as its first argument.
CoreInputMethod: struct {
    method: String,
    role: String,
    module_name: String,
}

CORE_INPUT_METHODS: [CoreInputMethod]{
    {method: "csv", role: "InputCSV", module_name: "core.encoding.csv"},
    {method: "json", role: "InputJSON", module_name: "core.encoding.json"},
    {method: "edit", role: "InputEdit", module_name: "core.term"},
}

// The role that `input.<method>` calls, when `method` is one of these methods.
core_input_method_role: fn(method: String) -> String? Never! {
    loop row in CORE_INPUT_METHODS {
        if row.method == method -> return Val(row.role)
    }
    None
}

// The Core module that declares `input.<method>`, when `method` is one of
// these methods.
core_input_method_module: fn(method: String) -> String? Never! {
    loop row in CORE_INPUT_METHODS {
        if row.method == method -> return Val(row.module_name)
    }
    None
}

// The Core type a prelude rename spells bare (`Date` -> `LocalDate`), when
// `name` is one.
core_bare_source_declared: fn(name: String) -> String? Never! {
    loop row in CORE_BARE_SOURCE_MODULES {
        if row.name == name && row.declared != "" -> return Val(row.declared)
    }
    None
}

// The Core module an unknown module-style name most likely meant to import:
// one whose last segment is the name (`mem`, `archive`), or the conventional
// short alias of a module (`fs`, `ar`, `gz`, `re`).
core_module_for_alias: fn(name: String) -> String? {
    if name == "fs" -> return Val("core.files")
    if name == "ar" -> return Val("core.archive")
    if name == "gz" -> return Val("core.archive.gzip")
    if name == "re" -> return Val("core.regex")
    suffix: ".{name}"
    loop row in CORE_MODULE_EXPORTS {
        if row.module_name.starts_with("core.") && row.module_name.ends_with(suffix) {
            return Val(row.module_name.copy())
        }
    }
    None
}

// Whether `name` is seen bare wherever Core is loaded: a Core root value type
// (Core.rows `root_types`), or the owner of a typed-decode role
// (CORE_TYPED_DECODE_ROLES), which the decode bodies generated for a
// `#Codable` type name in the type's own module.
core_root_type: fn(name: String) -> Bool Never! {
    if CORE_ROOT_TYPES.contains(name) -> return true
    loop row in CORE_TYPED_DECODE_ROLES {
        if row.owner == name -> return true
    }
    false
}

// The jet_builtins roles (Core/Builtins/Builtins.jet RoleKind) of the
// core.encoding declarations a generated decode names: the trait a streaming
// `__read` reads from, the read of one value at a source's cursor, and the
// constructor of a Dyn tree's source.
CORE_ROLE_TYPED_DECODE_SOURCE: "TypedDecodeSource"

CORE_ROLE_TYPED_DECODE_READ: "TypedDecodeRead"

CORE_ROLE_TYPED_DECODE_TREE: "TypedDecodeTree"

// A Core declaration that fills a role, as a generated body spells it: the
// trait or type `owner` and, for a method, its name `member` ("" for the
// trait or type itself).
CoreRoleSpelling: struct {
    role: String,
    owner: String,
    member: String,
}

// The typed-decode roles' declarations, read from the `#Builtin.Role(.X)`
// markers of Core/Encoding/Encoding.jet while the compiler builds, so the
// compiler spells only the roles. A role nothing there fills stops the build.
CORE_TYPED_DECODE_ROLES: #run core_role_spellings(embed_file("toolchain:Core/Encoding/Encoding.jet"), [String]{CORE_ROLE_TYPED_DECODE_SOURCE, CORE_ROLE_TYPED_DECODE_READ, CORE_ROLE_TYPED_DECODE_TREE})

// The trait or type that holds the declaration filling `role`, one of
// CORE_TYPED_DECODE_ROLES' roles.
core_role_owner: fn(role: String) -> String Never! {
    loop row in CORE_TYPED_DECODE_ROLES {
        if row.role == role -> return "{row.owner}"
    }
    ""
}

// The method that fills `role`, one of CORE_TYPED_DECODE_ROLES' roles; ""
// when the trait or type itself fills it.
core_role_member: fn(role: String) -> String Never! {
    loop row in CORE_TYPED_DECODE_ROLES {
        if row.role == role -> return "{row.member}"
    }
    ""
}

// A jet_builtins role marker at the start of a declaration line.
CORE_ROLE_MARKER: "#Builtin.Role(."

// The declarations of `source` whose `#Builtin.Role(.X)` marker names one of
// `roles`, as a generated body spells them: a trait's or type's marker
// starts its declaration line at the margin, and a method's starts its
// indented line inside the block of the type declared last at the margin.
// A role of `roles` that no declaration fills stops the build.
core_role_spellings: fn(source: String, roles: [String]) -> [CoreRoleSpelling] Never! {
    found := [CoreRoleSpelling]{}
    owner := ""
    loop line in source.split("\n") {
        indented: line.starts_with(" ")
        pair: line.trim_start().split_once(": ") ?? next
        declared: core_role_declaration(pair.before, pair.after)
        if !indented && declared.name != "" -> owner = "{declared.name}"
        if declared.role == "" || declared.name == "" || !roles.contains(declared.role) -> next
        spelling: if {
            indented -> CoreRoleSpelling{role: declared.role, owner: "{owner}", member: declared.name}
            else -> CoreRoleSpelling{role: declared.role, owner: declared.name, member: ""}
        }
        found.push(spelling)
    }
    loop role in roles {
        if !core_role_spelled(found, role) {
            build_time_refused("Core/Encoding/Encoding.jet marks no declaration with `#Builtin.Role(.{role})`, which the decode bodies generated for a `#Codable` type name")
        }
    }
    found
}

// The role and the name of a declaration line split at its first `: `, `head`
// before it (`#Builtin.Role(.X) priv Name`, `read`) and `kind` after it
// (`trait {`, `fn<…`). The role is "" when no role marker starts the line,
// and the name "" when the line declares no function, method, trait or type.
core_role_declaration: fn(head: String, kind: String) -> {role: String, name: String} Never! {
    if !kind.starts_with("fn") && !kind.starts_with("trait") && !kind.starts_with("struct") && !kind.starts_with("enum") {
        return {role: "", name: ""}
    }
    if head.starts_with(CORE_ROLE_MARKER) {
        marked: head.removeprefix(CORE_ROLE_MARKER).split_once(") ") ?? return {role: "", name: ""}
        return {role: "{marked.before}", name: core_role_declared_name(marked.after)}
    }
    {role: "", name: core_role_declared_name(head)}
}

// The name `declared` declares (`priv Name`, `read`), or "" when it is no
// name.
core_role_declared_name: fn(declared: String) -> String Never! {
    name: declared.removeprefix("priv ").removeprefix("pub ")
    if name == "" || name.contains(" ") || name.starts_with("#") || name.starts_with("/") -> return ""
    "{name}"
}

// Whether `found` holds a declaration filling `role`.
core_role_spelled: fn(found: [CoreRoleSpelling], role: String) -> Bool Never! {
    loop row in found {
        if row.role == role -> return true
    }
    false
}

// Private semantic routes belong to an exact source declaration, never a
// short nominal spelling. They do not add public trait implementations.
core_source_value_hook: fn(name: String, operation: String) -> String? Never! {
    if !name.starts_with("<corelib>/") -> return None
    if !core_identity_is(name, "core.compute.solve", "Solver") -> return None
    if operation == {
        "show" -> Val("__show")
        "debug" -> Val("__debug")
        else -> None
    }
}

// The variant names of a Core enum family with payloads, in declaration
// order: a compiler-owned family's CORE_ENUM_PAYLOAD_ROWS (`IOError`), else a
// Core.rows enum leaf whose case list carries payloads (`Key`, `DataEvent`:
// CORE_ENUM_CASE_PAYLOADS).
core_enum_payload_variants: fn(name: String) -> [String]? {
    variants := [String]{}
    loop row in CORE_ENUM_PAYLOAD_ROWS {
        if row.enum_name == name -> variants.push(row.variant)
    }
    if variants.len() > 0 -> return Val(variants)
    loop (index, row) in CORE_ENUM_CASE_ROWS {
        if row.name != name -> next
        if CORE_ENUM_CASE_PAYLOADS[index].len() == 0 -> return None
        if row.kind == .Enum(cases) -> return Val(cases)
        return None
    }
    None
}

// The positional payload types of `name.variant` for a Core enum: the
// compiler-owned family's payload rows, otherwise the Core.rows enum leaf's
// case payload, none for a unit case or a list that carries no payloads. `None`
// when the enum or its variant is not a Core enum case.
core_enum_variant_payload: fn(name: String, variant: String) -> [Type]? {
    family := false
    loop row in CORE_ENUM_PAYLOAD_ROWS {
        if row.enum_name != name -> next
        if row.variant == variant -> return Val(row.payload)
        family = true
    }
    if family -> return None
    loop (index, row) in CORE_ENUM_CASE_ROWS {
        if row.name != name -> next
        if row.kind == .Enum(cases) {
            at: cases.index_of(variant) ?? return None
            if CORE_ENUM_CASE_PAYLOADS[index].len() == 0 -> return Val([Type]{})
            return Val(CORE_ENUM_CASE_PAYLOADS[index][at])
        }
        return None
    }
    None
}

// The cases of the enum `name` that the Core module `module_name` exports:
// the module's catalog row authenticates the export, and the build keeps
// every enum leaf's case list identical across the modules that export it.
// `None` when that module does not export `name` or `name` is not an enum.
core_module_enum_cases: fn(module_name: String, name: String) -> [String]? {
    if !core_module_has_type(module_name, name) -> return None
    if core_enum_payload_variants(name) == .Val(variants) -> return Val(variants)
    core_enum_cases(name)
}

// One field of a builtin Core record; rows are authored in CoreRecordRows.jet
// and the first match wins. A `core_only` field is private storage: only Core
// source reads or writes it, and user code sees no such field.
CoreRecordFieldRow: struct {
    owner: String,
    field: String,
    ty: Type,
    core_only: Bool{false},
}

// The declared field list of a Core record users can build with a struct
// literal, in declaration order.
CoreRecordLiteralRow: struct {
    owner: String,
    fields: [TypeTupleField],
    core_only: Bool{false},
}

// The Core module a dotted Core path names or starts with: its longest
// prefix, cut at a `.`, that Core.rows declares or that is a loaded Core
// source of its own, a private part or a runtime unit (`core.archive.gzip`
// -> `core.archive.gzip`, `core.time.sleep` -> `core.time`,
// `__core_crypto_aead.GCMKey` -> `__core_crypto_aead`); None when no prefix
// is a Core module.
core_path_module: fn(path: String) -> String? Never! {
    bytes: path.bytes()
    end := bytes.len()
    loop {
        head: foundation_byte_text(bytes, 0, end)
        if core_module_export(head) != None || core_module_source_path(head) != None {
            return Val(head)
        }
        loop end > 0 && bytes[end - 1] != (U8{46}) -> end -= 1
        if end == 0 -> return None
        end -= 1
    }
}

CorePathParts: struct {
    module_name: String,
    // The member path after the module (`Atomic.extra`), or "" when the path
    // names the module itself.
    member: String,
}

// A dotted Core path cut into its Core module (core_path_module) and the
// member path after it (`core.mem.Atomic.extra` -> `core.mem`,
// `Atomic.extra`); a path no Core module starts is a module of its own.
core_path_parts: fn(path: String) -> CorePathParts Never! {
    module_name: core_path_module(path) ?? return CorePathParts{module_name: path.copy(), member: ""}
    member: if module_name.len() == path.len() -> "" else -> path.slice(module_name.len() + 1, path.len())
    CorePathParts{module_name: module_name, member: member}
}

// The Core module a Core declaration key or module identity names
// (`<corelib>/core.crypto.vault.Secret` -> `core.crypto.vault`).
core_identity_module: fn(key: String) -> String? Never! {
    if !key.starts_with("<corelib>/") -> return None
    rest: key.slice("<corelib>/".len(), key.len())
    Val(core_path_parts(rest).module_name)
}

// Whether `identity` is a Core module's own identity (`<corelib>/core.files`),
// not a declaration inside one.
core_identity_is_module: fn(identity: String) -> Bool Never! {
    if !identity.starts_with("<corelib>/") -> return false
    module_name: identity.slice("<corelib>/".len(), identity.len())
    (core_path_module(module_name) ?? return false) == module_name
}

// The source path of Core module `module_name` (`core.crypto.vault` ->
// `Core/Crypto/Vault.jet`), from the Core source table.
core_module_source_path: fn(module_name: String) -> String? Never! {
    loop row in CORE_SOURCE_OWNED_ROWS {
        if row.module_name == module_name -> return Val(row.path)
    }
    None
}

// Whether `key` is exactly the declaration `leaf` of Core module `module_name`.
core_identity_is: fn(key: String, module_name: String, leaf: String) -> Bool Never! {
    expected: "<corelib>/{module_name}.{leaf}"
    key == expected
}

// Whether a Core module identity or declaration key belongs to Core module
// `module_name` (`core.sync`) or one of its submodules (`core.sync.rows`).
core_identity_in_module: fn(key: String, module_name: String) -> Bool Never! {
    prefix: "<corelib>/{module_name}"
    key == prefix || key.starts_with("{prefix}.")
}

// Corelib nominal types carry a source identity; the record oracle is keyed
// by the declared leaf (`<corelib>/core.process.ProcessReceipt`).
core_record_leaf: fn(owner: String) -> String Never! {
    if !owner.starts_with("<corelib>/") -> return "{owner}"
    parts: owner.split(".").to_list()
    "{parts[parts.len() - 1]}"
}

core_record_field: fn(owner: String, field: String) -> Type? {
    core_record_field_in(CORE_RECORD_FIELD_ROWS, core_record_leaf(owner), field)
}

// Whether `owner.field` is private storage only Core source may touch.
core_record_field_is_core_only: fn(owner: String, field: String) -> Bool Never! {
    leaf: core_record_leaf(owner)
    loop row in CORE_RECORD_FIELD_ROWS {
        if row.owner == leaf && row.field == field -> return row.core_only
    }
    false
}

// The table is a read parameter, so the scan reads its rows in place.
core_record_field_in: fn(rows: [CoreRecordFieldRow], owner: String, field: String) -> Type? {
    loop row in rows {
        if row.owner == owner && row.field == field -> return Val(row.ty)
    }
    None
}

// The types of Core record `owner`'s fields, one per field name in row order
// (the first row of a field wins, as in core_record_field). None when no row
// names the record.
core_record_field_types: fn(owner: String) -> [Type]? {
    leaf: core_record_leaf(owner)
    taken := [Int]{}
    types := [Type]{}
    loop (index, row) in CORE_RECORD_FIELD_ROWS {
        if row.owner != leaf || core_record_field_taken(taken, row.field) -> next
        taken.push(index)
        // copy: the global row table can't be moved from.
        types.push(row.ty.copy())
    }
    if types.len() == 0 -> return None
    Val(types)
}

// Whether one of the CORE_RECORD_FIELD_ROWS at `taken` names `field`.
core_record_field_taken: fn(taken: [Int], field: String) -> Bool Never! {
    loop index in taken {
        if CORE_RECORD_FIELD_ROWS[index].field == field -> return true
    }
    false
}

// The field types of many Core records in one pass over the rows:
// `table[k][f]` is the first matching row's type of `owners[k]`.`fields[k][f]`,
// None when no row types it. `owners` are distinct record leaves. JetIR adds
// about 140 compiler-owned records to every program, and core_record_field
// would rescan the rows from the top for each of their fields.
core_record_field_table: fn(owners: [String], fields: [[String]]) -> [[Type?]] Never! {
    at := [String:Int]{}
    table := [[Type?]]{}
    loop (k, owner) in owners {
        at[owner] = k
        table.push(loop _ in fields[k] -> Type?{None})
    }
    loop row in CORE_RECORD_FIELD_ROWS {
        k: at.get(row.owner) ?? next
        loop (f, field) in fields[k] {
            if field == row.field && table[k][f] == None -> table[k][f] = Val(row.ty)
        }
    }
    table
}

core_record_literal_fields: fn(owner: String) -> [TypeTupleField]? {
    core_record_literal_fields_in(CORE_RECORD_LITERAL_ROWS, core_record_leaf(owner))
}

core_record_literal_is_core_only: fn(owner: String) -> Bool Never! {
    leaf: core_record_leaf(owner)
    loop row in CORE_RECORD_LITERAL_ROWS {
        if row.owner == leaf -> return row.core_only
    }
    false
}

core_record_literal_fields_in: fn(rows: [CoreRecordLiteralRow], owner: String) -> [TypeTupleField]? {
    loop row in rows {
        if row.owner == owner -> return Val(row.fields)
    }
    None
}
