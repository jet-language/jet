CoreModuleExportNames: struct {
    module_name: String
    members: [String]
    type_exports: [String]
}

CoreLeafKind: enum {
    Plain
    Enum(variants: [String])
    Generic(arity: Int)
    CryptoNominal
}

CoreModuleTypeExport: struct {
    name: String
    kind: CoreLeafKind
}

// One variant of a compiler-owned Core enum family (authored in
// CoreEnumPayloadRows.jet): its payload types in slot order (an empty payload
// is a unit variant) and, for a named payload, each slot's field label (empty
// for a positional payload).
CoreEnumPayloadRow: struct {
    enum_name: String
    variant: String
    payload: [Type]
    labels: [String]
}

// One Core.rows `module` line; `line` is its Core.rows line.
CoreModuleDeclaration: struct {
    module_name: String
    members: [String]
    type_exports: [CoreModuleTypeExport]
    dependencies: [String]
    line: Int
}

core_module_export: fn(module_name: String) -> CoreModuleExportNames? {
    core_module_export_in(CORE_MODULE_EXPORTS, module_name)
}

// The table is a read parameter, so the scan reads its rows in place.
core_module_export_in: fn(rows: [CoreModuleExportNames], module_name: String) -> CoreModuleExportNames? {
    loop row in rows {
        if row.module_name == module_name -> return Val(row)
    }
    None
}

core_module_export_has_name: fn(names: [String], name: String) -> Bool Never! {
    loop item in names {
        if item == name -> return true
    }
    false
}

core_module_has_member: fn(module_name: String, member: String) -> Bool Never! {
    row: core_module_export(module_name) ?? return false
    core_module_export_has_name(row.members, member)
}

core_module_has_type: fn(module_name: String, name: String) -> Bool Never! {
    row: core_module_export(module_name) ?? return false
    core_module_export_has_name(row.type_exports, name)
}

core_module_type_leaf: fn(name: String) -> String Never! {
    bytes: name.bytes()
    namespace_separator := -1
    module_separator := -1
    index := 0
    loop index < bytes.len() {
        if {
            index + 1 < bytes.len() && bytes[index] == (U8{58}) && bytes[index + 1] == (U8{58}) -> {
                namespace_separator = index
                index += 1
            }
            else -> {
                if bytes[index] == (U8{46}) -> module_separator = index
                index += 1
            }
        }
    }
    if {
        namespace_separator >= 0 -> String.from_bytes(bytes[namespace_separator + 2..<bytes.len()]) ?? name
        module_separator >= 0 -> String.from_bytes(bytes[module_separator + 1..<bytes.len()]) ?? name
        else -> name
    }
}

core_type_modules: fn(name: String) -> [String] Never! {
    core_type_modules_in(CORE_MODULE_EXPORTS, core_module_type_leaf(name))
}

// The table is a read parameter, so the scan reads its rows in place.
core_type_modules_in: fn(rows: [CoreModuleExportNames], leaf: String) -> [String] Never! {
    modules := [String]{}
    loop row in rows {
        if core_module_export_has_name(row.type_exports, leaf) -> modules.push(row.module_name)
    }
    modules
}

// Rust `CoreModuleExports::core_enum_variants`: the canonical variant names of
// a Core enum leaf. Payload shape stays with the checked source declaration.
core_enum_variants: fn(name: String) -> [String]? {
    core_enum_variants_in(CORE_ENUM_ROWS, name)
}

core_enum_variants_in: fn(rows: [CoreModuleTypeExport], name: String) -> [String]? {
    loop row in rows {
        if row.name != name -> next
        if row.kind == .Enum(variants) -> return Val(variants)
    }
    None
}

// One source-owned Core nominal (`source_module … types { … }` in
// Prelude/Core.rows; Rust `CoreModuleExports::CoreSourceOwnedType`).
CoreSourceOwnedType: struct {
    path: String
    name: String
}

// Rust `CoreModuleExports::core_source_owns_type`: whether a checked Core
// identity (`<corelib>/core.net.url::URL`) names a source-owned
// Core nominal, including exact registered source value-hook owners. An owned
// type remains the Jet declaration on every tier, never a native projection.
core_source_owns_type: fn(name: String) -> Bool Never! {
    core_source_owns_type_in(CORE_SOURCE_OWNED_TYPES, name)
        || core_source_value_hook(name, "clone") != None
        || core_source_value_hook(name, "show") != None
        || core_source_value_hook(name, "debug") != None
}

// The table is a read parameter, so the scan reads its rows in place.
core_source_owns_type_in: fn(rows: [CoreSourceOwnedType], name: String) -> Bool Never! {
    module_name: core_identity_module(name) ?? return false
    parts: name.split("::").to_list()
    if parts.len() < 2 -> return false
    leaf: parts[parts.len() - 1]
    file: core_module_source_path(module_name) ?? return false
    loop row in rows {
        if row.name == leaf && row.path == file -> return true
    }
    false
}

// Whether a checked Core identity names a nominal of a private Core source part
// (a `CoreSourceParts.tsv` row, which names its owner module). A part has no
// runtime carrier and no types column, so every nominal it declares, generic
// ones included, is its Jet declaration.
core_source_part_owns_type: fn(name: String) -> Bool Never! {
    if !name.contains("::") -> return false
    module_name: core_identity_module(name) ?? return false
    loop row in CORE_SOURCE_OWNED_ROWS {
        if row.module_name == module_name -> return row.owner != "" && !row.runtime
    }
    false
}

// The existing public bool(p) arity targets one reserved source
// method. This is not an overload mechanism or a native receiver route.
CORE_SOURCE_BOOL_P_OWNER: [CoreSourceOwnedType]{
    {path: "Core/Math/Random.jet", name: "RNG"},
}
// The public HTTP message builders keep their setter arities: `header(n, v)`
// on either message, and `body(text)` / `json(value)` on a request, target
// the reserved `__with_*` source methods beside the getters of those names.
CORE_SOURCE_HTTP_REQUEST_OWNER: [CoreSourceOwnedType]{
    {path: "Core/Http/Http.jet", name: "HTTPRequest"},
}
CORE_SOURCE_HTTP_MESSAGE_OWNERS: [CoreSourceOwnedType]{
    {path: "Core/Http/Http.jet", name: "HTTPRequest"},
    {path: "Core/Http/Http.jet", name: "HTTPResponse"},
}
// The use-site rule builder whose `check(…, at: field, …)`
// Sema checks against the validated type's fields.
CORE_SOURCE_VALIDATE_OWNER: [CoreSourceOwnedType]{
    {path: "Core/Encoding/Validate.jet", name: "Validate"},
}
core_source_is_validate: fn(identity: String) -> Bool Never! {
    core_source_owns_type_in(CORE_SOURCE_VALIDATE_OWNER, identity)
}

// Whether `method` at `nargs` may target a reserved source method, so the
// caller resolves the receiver's checked identity first.
core_source_receiver_method_routes: fn(method: String, nargs: Int) -> Bool Never! {
    if nargs == 2 -> return method == "header"
    nargs == 1 && (method == "bool" || method == "body" || method == "json")
}

core_source_receiver_method: fn(identity: String, method: String, nargs: Int) -> String Never! {
    if method == "bool" && nargs == 1 && core_source_owns_type(identity) && core_source_owns_type_in(CORE_SOURCE_BOOL_P_OWNER, identity) -> return "__bool_p"
    if method == "header" && nargs == 2 && core_source_owns_type_in(CORE_SOURCE_HTTP_MESSAGE_OWNERS, identity) -> return "__with_header"
    if nargs == 1 && (method == "body" || method == "json") && core_source_owns_type_in(CORE_SOURCE_HTTP_REQUEST_OWNER, identity) -> return "__with_{method}"
    method.copy()
}

// Exact Rust CoreModuleExports table: an established bare spelling's
// declaring source owner, never a general public-alias re-export mechanism.
// `declared` is set when the prelude renames the declaration (`Date` is
// `pub use Date: core.time.LocalDate`); otherwise the bare spelling is the
// declared name.
CoreBareSourceModule: struct {
    name: String
    module_name: String
    declared: String{""}
}
CORE_BARE_SOURCE_MODULES: [CoreBareSourceModule]{
