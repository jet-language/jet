pub CORE_ROOT_TYPES :: [String]{"Date", "LocalDate", "LocalTime", "Decimal", "Fraction", "Duration", "Instant", "Authority"}
pub CORE_BOOTSTRAP_ORDER :: [CoreBootstrapStep]{
    CoreBootstrapStep{name: "Syntax", dependencies: [String]{}},
    CoreBootstrapStep{name: "Effects", dependencies: [String]{"Syntax"}},
    CoreBootstrapStep{name: "Core", dependencies: [String]{"Effects"}},
    CoreBootstrapStep{name: "Derives", dependencies: [String]{"Core"}},
}

// The module-name projection borrows the existing name-only registry.
pub struct CoreModuleNames { at: Int }
impl CoreModuleNames.Iterator {
    type Item = @String
    fn next(&self) -> (@String)? from self {
        if self.at >= CORE_MODULE_EXPORTS.len() -> return None
        index :: self.at
        self.at += 1
        Val(@CORE_MODULE_EXPORTS[index].module_name)
    }
}
pub fn core_module_names() -> CoreModuleNames Never! { CoreModuleNames{at: 0} }
