core_bare_source_module: fn(name: String) -> String? Never! {
    loop row in CORE_BARE_SOURCE_MODULES {
        if row.name == name -> return Val(row.module_name)
    }
    None
}

// `input.<method>(…)`, a method the ambient `input` (Iter<String>) lacks, is
// the Core function `__input_<method>` (core_input_method_member) of the first
// of these modules that declares it: core.term, else the encoding module the
// method names (`input.csv<Row>()` is core.encoding.csv `__input_csv`). The
// Loader loads the encoding module where the source spells the call; Sema
// checks the call as that function's, with `input` as its first argument.
core_input_method_modules: fn(method: String) -> [String] Never! {
    [String]{"core.term", "core.encoding.{method}"}
}

core_input_method_member: fn(method: String) -> String Never! {
    "__input_{method}"
}

// The Core type a prelude rename spells bare (`Date` -> `LocalDate`), when
// `name` is one.
core_bare_source_declared: fn(name: String) -> String? Never! {
    loop row in CORE_BARE_SOURCE_MODULES {
        if row.name == name && row.declared != "" -> return Val(row.declared)
    }
    None
}

// The Core module an unknown module-style name most likely meant to import:
// one whose last segment is the name (`mem`, `archive`), or the conventional
// short alias of a module (`fs`, `ar`, `gz`, `re`).
core_module_for_alias: fn(name: String) -> String? {
    if name == "fs" -> return Val("core.files")
    if name == "ar" -> return Val("core.archive")
    if name == "gz" -> return Val("core.archive.gzip")
    if name == "re" -> return Val("core.regex")
    suffix: ".{name}"
    loop row in CORE_MODULE_EXPORTS {
        if row.module_name.starts_with("core.") && row.module_name.ends_with(suffix) -> return Val(row.module_name.copy())
    }
    None
}

core_root_type: fn(name: String) -> Bool Never! {
    CORE_ROOT_TYPES.contains(name)
}

// Private semantic routes belong to an exact source declaration, never a
// short nominal spelling. They do not add public trait implementations.
core_source_value_hook: fn(name: String, operation: String) -> String? Never! {
    if !name.starts_with("<corelib>/") -> return None
    if !core_identity_is(name, "core.compute.solve", "Solver") -> return None
    if operation == {
        "show" -> Val("__show")
        "debug" -> Val("__debug")
        else -> None
    }
}
// The variant names of a compiler-owned Core enum family with payload rows
// (`IOError`, `IOOperation`, `ProcessStreamMode`, ...), in table order.
core_enum_payload_variants: fn(name: String) -> [String]? {
    variants := [String]{}
    loop row in CORE_ENUM_PAYLOAD_ROWS {
        if row.enum_name == name -> variants.push(row.variant)
    }
    if variants.len() == 0 -> None else -> Val(variants)
}

// The positional payload types of `name.variant` for a Core enum: the
// payload rows of a compiler-owned family, otherwise a Core.rows enum leaf's
// unit variant (Rust `core_declared_enum_variants`). `None` when the enum or
// its variant is not a Core enum case.
core_enum_variant_payload: fn(name: String, variant: String) -> [Type]? {
    family := false
    loop row in CORE_ENUM_PAYLOAD_ROWS {
        if row.enum_name != name -> next
        if row.variant == variant -> return Val(row.payload)
        family = true
    }
    if family -> return None
    declared: core_enum_variants(name) ?? return None
    if declared.contains(variant) -> Val([Type]{}) else -> None
}

// The field labels of `name.variant`'s named payload, in slot order. `None`
// when the variant is not a compiler-owned case with a named payload.
core_enum_variant_labels: fn(name: String, variant: String) -> [String]? {
    loop row in CORE_ENUM_PAYLOAD_ROWS {
        if row.enum_name == name && row.variant == variant -> return if row.labels.len() == 0 -> None else -> Val(row.labels)
    }
    None
}

// The variants of the enum `name` that the Core module `module_name` exports:
// the module's catalog row authenticates the export, and the generator keeps
// every enum leaf's variant list identical across the modules that export it.
// `None` when that module does not export `name` or `name` is not an enum.
core_module_enum_variants: fn(module_name: String, name: String) -> [String]? {
    if !core_module_has_type(module_name, name) -> return None
    if core_enum_payload_variants(name) == .Val(variants) -> return Val(variants)
    core_enum_variants(name)
}

// One field of a builtin Core record; rows are authored in CoreRecordRows.jet
// and the first match wins. A `core_only` field is private storage: only Core
// source reads or writes it, and user code sees no such field.
CoreRecordFieldRow: struct {
    owner: String
    field: String
    ty: Type
    core_only: Bool{false}
}

// The declared field list of a Core record users can build with a struct
// literal (Rust `core_constructable_fields`), in declaration order.
CoreRecordLiteralRow: struct {
    owner: String
    fields: [TypeTupleField]
    core_only: Bool{false}
}

// The Core module a Core declaration key or module identity names
// (`<corelib>/core.crypto.vault::Secret` -> `core.crypto.vault`).
core_identity_module: fn(key: String) -> String? Never! {
    if !key.starts_with("<corelib>/") -> return None
    rest: key.slice("<corelib>/".len(), key.len())
    if rest.split_once("::") == .Val(parts) -> return Val(parts.before)
    Val(rest)
}

// The source path of Core module `module_name` (`core.crypto.vault` ->
// `Core/Crypto/Vault.jet`), from the Core source table.
core_module_source_path: fn(module_name: String) -> String? Never! {
    loop row in CORE_SOURCE_OWNED_ROWS {
        if row.module_name == module_name -> return Val(row.path)
    }
    None
}

// Whether `key` is exactly the declaration `leaf` of Core module `module_name`.
core_identity_is: fn(key: String, module_name: String, leaf: String) -> Bool Never! {
    expected: "<corelib>/{module_name}::{leaf}"
    key == expected
}

// Whether a Core module identity or declaration key belongs to Core module
// `module_name` (`core.sync`) or one of its submodules (`core.sync.rows`).
core_identity_in_module: fn(key: String, module_name: String) -> Bool Never! {
    prefix: "<corelib>/{module_name}"
    key == prefix || key.starts_with("{prefix}::") || key.starts_with("{prefix}.")
}

// Corelib nominal types carry a source identity; the record oracle is keyed
// by the declared leaf (`<corelib>/core.process::ProcessReceipt`).
core_record_leaf: fn(owner: String) -> String Never! {
    if !owner.starts_with("<corelib>/") -> return "{owner}"
    parts: owner.split("::").to_list()
    "{parts[parts.len() - 1]}"
}

core_record_field: fn(owner: String, field: String) -> Type? {
    core_record_field_in(CORE_RECORD_FIELD_ROWS, core_record_leaf(owner), field)
}

// Whether `owner.field` is private storage only Core source may touch.
core_record_field_is_core_only: fn(owner: String, field: String) -> Bool Never! {
    leaf: core_record_leaf(owner)
    loop row in CORE_RECORD_FIELD_ROWS {
        if row.owner == leaf && row.field == field -> return row.core_only
    }
    false
}

// The table is a read parameter, so the scan reads its rows in place.
core_record_field_in: fn(rows: [CoreRecordFieldRow], owner: String, field: String) -> Type? {
    loop row in rows {
        if row.owner == owner && row.field == field -> return Val(row.ty)
    }
    None
}

// The types of Core record `owner`'s fields, one per field name in row order
// (the first row of a field wins, as in core_record_field). None when no row
// names the record.
core_record_field_types: fn(owner: String) -> [Type]? {
    leaf: core_record_leaf(owner)
    fields := [String]{}
    types := [Type]{}
    loop row in CORE_RECORD_FIELD_ROWS {
        if row.owner != leaf || fields.contains(row.field) -> next
        // copy: the global row table can't be moved from.
        fields.push(row.field.copy())
        types.push(row.ty.copy())
    }
    if types.len() == 0 -> return None
    Val(types)
}

// The field types of many Core records in one pass over the rows:
// `table[k][f]` is the first matching row's type of `owners[k]`.`fields[k][f]`,
// None when no row types it. `owners` are distinct record leaves. JetIR adds
// about 140 compiler-owned records to every program, and core_record_field
// would rescan the rows from the top for each of their fields.
core_record_field_table: fn(owners: [String], fields: [[String]]) -> [[Type?]] Never! {
    at := [String:Int]{}
    table := [[Type?]]{}
    loop (k, owner) in owners {
        at[owner] = k
        table.push(loop _ in fields[k] -> Type?{None})
    }
    loop row in CORE_RECORD_FIELD_ROWS {
        k: at.get(row.owner) ?? next
        loop (f, field) in fields[k] {
            if field == row.field && table[k][f] == None -> table[k][f] = Val(row.ty)
        }
    }
    table
}

core_record_literal_fields: fn(owner: String) -> [TypeTupleField]? {
    core_record_literal_fields_in(CORE_RECORD_LITERAL_ROWS, core_record_leaf(owner))
}

core_record_literal_is_core_only: fn(owner: String) -> Bool Never! {
    leaf: core_record_leaf(owner)
    loop row in CORE_RECORD_LITERAL_ROWS {
        if row.owner == leaf -> return row.core_only
    }
    false
}

core_record_literal_fields_in: fn(rows: [CoreRecordLiteralRow], owner: String) -> [TypeTupleField]? {
    loop row in rows {
        if row.owner == owner -> return Val(row.fields)
    }
    None
}
