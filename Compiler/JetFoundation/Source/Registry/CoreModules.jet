pub struct CoreModuleExportNames {
    pub module_name: String
    pub members: [String]
    pub type_exports: [String]
}

pub enum CoreLeafKind {
    Plain
    Enum(variants: [String])
    Generic(arity: Int)
    CryptoNominal
}

pub struct CoreModuleTypeExport {
    pub name: String
    pub kind: CoreLeafKind
}

// One variant of a compiler-owned Core enum family (Rust
// `resolve_enum_variants_cloned` tables) and its positional payload types;
// an empty payload is a unit variant.
pub struct CoreEnumPayloadRow {
    pub enum_name: String
    pub variant: String
    pub payload: [Type]
}

pub struct CoreModuleDeclaration {
    pub module_name: String
    pub members: [String]
    pub type_exports: [CoreModuleTypeExport]
    pub dependencies: [String]
}

pub fn core_module_export(module_name: String) -> CoreModuleExportNames? {
    core_module_export_in(CORE_MODULE_EXPORTS, module_name)
}

// The table is a read parameter, so the scan reads its rows in place.
fn core_module_export_in(rows: [CoreModuleExportNames], module_name: String) -> CoreModuleExportNames? {
    loop row in rows {
        if row.module_name == module_name -> return Val(row)
    }
    None
}

// A removed Core namespace and its canonical home (Rust `Syntax::RETIREMENTS`
// semantic rows with code E1001).
pub struct CoreModuleRetirement {
    pub retired: String
    pub canonical: String
    pub decision: String
}

fn core_module_retirement_row(retired: String, canonical: String) -> CoreModuleRetirement Never! {
    CoreModuleRetirement{retired: retired, canonical: canonical, decision: "D-CORE-TREE1=A"}
}

pub fn core_module_retirements() -> [CoreModuleRetirement] Never! {
    [CoreModuleRetirement]{
        CoreModuleRetirement{retired: "core.path.join/parent/extension/normalize", canonical: "Path.from(value).join(part), .parent(), .extension(), .normalize()", decision: "D-CORE-PATH1"},
        core_module_retirement_row("core.io", "core.term, core.process, or the prelude"),
        core_module_retirement_row("core.path", "core.files"),
        core_module_retirement_row("core.time.date", "core.time"),
        core_module_retirement_row("core.time.datetime", "core.time"),
        core_module_retirement_row("core.text.unicode", "core.text"),
        core_module_retirement_row("core.fmt", "core.text.fmt"),
        core_module_retirement_row("core.random", "core.math.random"),
        core_module_retirement_row("core.env", "core.sys"),
        core_module_retirement_row("core.os", "core.sys"),
        core_module_retirement_row("core.tls", "core.net.tls"),
        core_module_retirement_row("core.ws", "core.net.ws"),
        core_module_retirement_row("core.url", "core.net.url"),
        core_module_retirement_row("core.mime", "core.net.mime"),
        core_module_retirement_row("core.uuid", "core.crypto.uuid"),
        core_module_retirement_row("core.vault", "core.crypto.vault"),
        core_module_retirement_row("core.raylib", "core.game.raylib"),
        core_module_retirement_row("core.browser", "core.web.browser"),
        core_module_retirement_row("core.solve", "core.compute.solve"),
        core_module_retirement_row("core.sketch", "core.data.sketch.*"),
        core_module_retirement_row("core.sketch.hll", "core.data.sketch.hll"),
        core_module_retirement_row("core.sketch.tdigest", "core.data.sketch.tdigest"),
        core_module_retirement_row("core.sketch.reservoir", "core.data.sketch.reservoir"),
        core_module_retirement_row("core.sketch.cms", "core.data.sketch.cms"),
        core_module_retirement_row("core.compress", "core.archive.gzip or core.archive.zstd"),
        core_module_retirement_row("core.compress.gzip", "core.archive.gzip"),
        core_module_retirement_row("core.compress.zstd", "core.archive.zstd"),
        core_module_retirement_row("core.science.measurement", "core.units"),
        core_module_retirement_row("core.mem.alloc", "core.mem"),
        core_module_retirement_row("core.scope", "core.mem.scope"),
        core_module_retirement_row("core.lang", "core.compiler.lang"),
        core_module_retirement_row("core.binary", "core.encoding and core.term.Reader"),
    }
}

// Rust `retired_core_module`: the longest retired namespace that is `name`
// itself or a dotted prefix of it.
pub fn core_module_retirement(name: String) -> CoreModuleRetirement? {
    found := CoreModuleRetirement?{None}
    best := -1
    loop row in core_module_retirements() {
        if row.retired != name && !name.starts_with("{row.retired}.") -> next
        if row.retired.len() >= best {
            best = row.retired.len()
            found = Val(row)
        }
    }
    found
}

pub fn core_module_export_has_name(names: [String], name: String) -> Bool Never! {
    loop item in names {
        if item == name -> return true
    }
    false
}

pub fn core_module_has_member(module_name: String, member: String) -> Bool Never! {
    row :: core_module_export(module_name) ?? return false
    core_module_export_has_name(row.members, member)
}

pub fn core_module_has_type(module_name: String, name: String) -> Bool Never! {
    row :: core_module_export(module_name) ?? return false
    core_module_export_has_name(row.type_exports, name)
}

pub fn core_module_type_leaf(name: String) -> String Never! {
    bytes :: name.bytes()
    namespace_separator := -1
    module_separator := -1
    index := 0
    loop index < bytes.len() {
        if {
            index + 1 < bytes.len() && bytes[index] == (U8{58}) && bytes[index + 1] == (U8{58}) -> {
                namespace_separator = index
                index += 1
            }
            else -> {
                if bytes[index] == (U8{46}) -> module_separator = index
                index += 1
            }
        }
    }
    if {
        namespace_separator >= 0 -> String.from_bytes(bytes[namespace_separator + 2..<bytes.len()]) ?? name
        module_separator >= 0 -> String.from_bytes(bytes[module_separator + 1..<bytes.len()]) ?? name
        else -> name
    }
}

pub fn core_type_modules(name: String) -> [String] Never! {
    core_type_modules_in(CORE_MODULE_EXPORTS, core_module_type_leaf(name))
}

// The table is a read parameter, so the scan reads its rows in place.
fn core_type_modules_in(rows: [CoreModuleExportNames], leaf: String) -> [String] Never! {
    modules := [String]{}
    loop row in rows {
        if core_module_export_has_name(row.type_exports, leaf) -> &modules.push(row.module_name)
    }
    modules
}

// Rust `CoreModuleExports::core_enum_variants`: the canonical variant names of
// a Core enum leaf. Payload shape stays with the checked source declaration.
pub fn core_enum_variants(name: String) -> [String]? {
    core_enum_variants_in(CORE_ENUM_ROWS, name)
}

fn core_enum_variants_in(rows: [CoreModuleTypeExport], name: String) -> [String]? {
    loop row in rows {
        if row.name != name -> next
        if row.kind == .Enum(variants) -> return Val(variants)
    }
    None
}

// The variant names of a compiler-owned Core enum family with payload rows
// (`IOError`, `IOOperation`, `ProcessStreamMode`, ...), in table order.
pub fn core_enum_payload_variants(name: String) -> [String]? {
    variants := [String]{}
    loop row in CORE_ENUM_PAYLOAD_ROWS {
        if row.enum_name == name -> &variants.push(row.variant)
    }
    if variants.len() == 0 -> None else -> Val(variants)
}

// The positional payload types of `name.variant` for a Core enum: the
// payload rows of a compiler-owned family, otherwise a Core.jet enum leaf's
// unit variant (Rust `core_declared_enum_variants`). `None` when the enum or
// its variant is not a Core enum case.
pub fn core_enum_variant_payload(name: String, variant: String) -> [Type]? {
    family := false
    loop row in CORE_ENUM_PAYLOAD_ROWS {
        if row.enum_name != name -> next
        if row.variant == variant -> return Val(row.payload)
        family = true
    }
    if family -> return None
    declared :: core_enum_variants(name) ?? return None
    if declared.contains(variant) -> Val([Type]{}) else -> None
}
fn core_module_source_declaration_line(source_text: String, module_name: String) -> String? {
    prefix := "module {module_name} "
    source_bytes := source_text.bytes()
    line_start := 0
    loop line_start < source_bytes.len() {
        line_end := line_start
        loop line_end < source_bytes.len() && source_bytes[line_end] != (U8{10}) -> line_end += 1
        line :: String.from_bytes(source_bytes[line_start..<line_end]) ?? return None
        trimmed := line.trim()
        if trimmed.starts_with(prefix) -> return Val(trimmed)
        line_start = line_end + 1
    }
    None
}

fn core_module_source_brace_clause(line: String, name: String) -> String? {
    prefix := "{name} {{"
    parts := line.split(prefix).to_list()
    if parts.len() != 2 -> return None
    bytes := parts[1].bytes()
    end := 0
    loop end < bytes.len() {
        if bytes[end] == (U8{125}) {
            return Val(String.from_bytes(bytes[0..<end]) ?? "")
        }
        end += 1
    }
    None
}

fn core_module_source_bracket_clause(line: String, name: String) -> String? {
    prefix := "{name} ["
    parts := line.split(prefix).to_list()
    if parts.len() != 2 -> return None
    bytes := parts[1].bytes()
    end := 0
    loop end < bytes.len() {
        if bytes[end] == (U8{93}) {
            return Val(String.from_bytes(bytes[0..<end]) ?? "")
        }
        end += 1
    }
    None
}

fn core_module_source_names(text: String) -> [String] Never! {
    names := [String]{}
    if text.trim() == "" -> return names
    loop part in text.split(",") {
        name := part.trim()
        if name != "" -> &names.push(name)
    }
    names
}

fn core_module_source_names_equal(left: [String], right: [String]) -> Bool Never! {
    if left.len() != right.len() -> return false
    loop index in 0..<left.len() {
        if left[index] != right[index] -> return false
    }
    true
}

fn core_module_source_leaf_kind(text: String) -> CoreLeafKind? {
    value := text.trim()
    if value == "plain" -> return Val(CoreLeafKind.Plain)
    if value == "crypto_nominal" -> return Val(CoreLeafKind.CryptoNominal)
    if value.starts_with("plain(") && value.ends_with(")") {
        bytes := value.bytes()
        variants_text :: String.from_bytes(bytes[6..<bytes.len() - 1]) ?? return None
        variants := [String]{}
        if variants_text.trim() != "" {
            loop variant in variants_text.split("|") {
                name := variant.trim()
                if name == "" -> return None
                &variants.push(name)
            }
        }
        return Val(CoreLeafKind.Enum{variants: variants})
    }
    if value.starts_with("generic(") && value.ends_with(")") {
        bytes := value.bytes()
        arity_text :: String.from_bytes(bytes[8..<bytes.len() - 1]) ?? return None
        arity :: Int.parse(arity_text.trim()) ?? return None
        if arity < 0 -> return None
        return Val(CoreLeafKind.Generic{arity: arity})
    }
    None
}

fn core_module_source_type_export(text: String) -> CoreModuleTypeExport? {
    parts := text.split(":").to_list()
    if parts.len() != 2 -> return None
    name := parts[0].trim()
    if name == "" -> return None
    kind :: core_module_source_leaf_kind(parts[1]) ?? return None
    Val(CoreModuleTypeExport{name: name, kind: kind})
}

// Parse the generated module declaration syntax directly from canonical
// Prelude/Core.jet text. Export-name rows cross-check this specialized view.
pub fn core_module_declaration_from_source(source_text: String, module_name: String) -> CoreModuleDeclaration? {
    registry :: core_module_export(module_name) ?? return None
    line :: core_module_source_declaration_line(source_text, module_name) ?? return None
    exports :: core_module_source_brace_clause(line, "exports") ?? return None
    type_text :: core_module_source_brace_clause(line, "types") ?? return None
    dependency_text :: core_module_source_bracket_clause(line, "depends_on") ?? return None
    members := core_module_source_names(exports)
    if !core_module_source_names_equal(members, registry.members) -> return None
    type_exports := [CoreModuleTypeExport]{}
    type_names := [String]{}
    if type_text.trim() != "" {
        loop raw in type_text.split(",") {
            row :: core_module_source_type_export(raw) ?? return None
            &type_names.push(row.name)
            &type_exports.push(row)
        }
    }
    if !core_module_source_names_equal(type_names, registry.type_exports) -> return None
    Val(CoreModuleDeclaration{
        module_name: module_name,
        members: members,
        type_exports: type_exports,
        dependencies: core_module_source_names(dependency_text),
    })
}

// One field of a builtin Core record (Rust `core_struct_field`); rows are
// generated into CoreRecordRows.jet in the oracle's first-match order.
pub struct CoreRecordFieldRow {
    pub owner: String
    pub field: String
    pub ty: Type
}

// The declared field list of a Core record users can build with a struct
// literal (Rust `core_constructable_fields`), in declaration order.
pub struct CoreRecordLiteralRow {
    pub owner: String
    pub fields: [TypeTupleField]
}

// Corelib nominal types carry a source identity; the record oracle is keyed
// by the declared leaf (`<corelib>/Core/process::...::ProcessReceipt`).
fn core_record_leaf(owner: String) -> String Never! {
    if !owner.starts_with("<corelib>/") -> return "{owner}"
    parts :: owner.split("::").to_list()
    "{parts[parts.len() - 1]}"
}

pub fn core_record_field(owner: String, field: String) -> Type? {
    core_record_field_in(CORE_RECORD_FIELD_ROWS, core_record_leaf(owner), field)
}

// The table is a read parameter, so the scan reads its rows in place.
fn core_record_field_in(rows: [CoreRecordFieldRow], owner: String, field: String) -> Type? {
    loop row in rows {
        if row.owner == owner && row.field == field -> return Val(row.ty)
    }
    None
}

pub fn core_record_literal_fields(owner: String) -> [TypeTupleField]? {
    core_record_literal_fields_in(CORE_RECORD_LITERAL_ROWS, core_record_leaf(owner))
}

fn core_record_literal_fields_in(rows: [CoreRecordLiteralRow], owner: String) -> [TypeTupleField]? {
    loop row in rows {
        if row.owner == owner -> return Val(row.fields)
    }
    None
}
