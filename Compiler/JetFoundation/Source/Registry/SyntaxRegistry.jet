// This file is generated by Tools/Agent/JetpackSyntax.jet from Compiler/JetFoundation/Data/Syntax; do not edit.
// It stays committed: the seed builds the compiler from the checkout, and
// `jet check` reads it before any build step runs.
// Each constant is the registry's, with its comments; the tool keeps
// exactly those the jet_foundation package's sources name or packages import.

/// S5 (ratified): line comments run from this prefix to end of line.
COMMENT_PREFIX: "//"

/// S49 (ratified): a doc comment is a line comment that opens with this
/// prefix. Its text is plain prose, and `jet test` runs its examples.
DOC_COMMENT_PREFIX: "///"

/// S5 (ratified 2026-06-15): block comments `/* … */`, nesting allowed so a
/// region containing other comments can always be commented out.
BLOCK_COMMENT_OPEN: "/*"

BLOCK_COMMENT_CLOSE: "*/"

/// M1/M2: return from a function. Foundational keyword predating the
/// S-numbered decision log (card #447 KW_DECISION_ID_EXEMPT).
KW_RETURN: "return"

/// (ratified): `defer statement` or `defer { block }` runs its body when the
/// enclosing block ends, on every exit, the latest defer first; the body can't
/// leave its block (E0509) or pass a failure on (E0512). `defer
/// close(resource)` stays the one closing form. `defer` is contextual so
/// ordinary identifiers keep their existing meaning outside statement-head
/// position.
KW_DEFER: "defer"

PERF_BUDGET_METRICS: [String]{
    "BinarySize",
    "ArtifactSize",
    "GeneratedUnsafe",
    "PublicApiItems",
    "DependencyCount",
    "EffectCount",
    "AllocationCount",
    "AllocationBytes",
    "StartupTime",
    "FrameTime",
    "Latency",
    "Throughput",
    "MemoryHighWater",
    "BenchTime",
    "ServiceReadiness",
    "SceneAssetBytes",
    "DrawCalls",
    "CompileTime",
}

PERF_BUDGET_PERCENTILES: [String]{"P50", "P90", "P95", "P99", "P999"}

PERF_BUDGET_TARGET_CLASSES: [String]{"Native", "Web", "Freestanding", "Plugin", "OSImage"}

/// S23 (ratified) + loop control. Bare payloads return from the innermost
/// loop; `break(name[, value])` and `next(name)` select named loop targets.
KW_BREAK: "break"

/// (ratified 2026-08-07, card #1641): measurement is a
/// test member, selected by `jet test --measure`.
SCOPE_TEST_MEASURE: "measure"
