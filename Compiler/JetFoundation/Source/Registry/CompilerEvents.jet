// The public moments of a compile and a build: the one list of their names,
// their `core.compiler.Event` variants and their payloads. `#On` hooks, the
// ordered `stages()` view, the driver's event sink and `jet build --json`
// name a moment only through these rows, and `jet inspect events --schema`
// prints the `--json` schema rendered from them (compiler_event_schema);
// Core/Compiler/Compiler.jet declares the same enum and payload structs for
// Jet code. A new moment is a new row, a new variant and, when its payload is
// new, a new payload row: a versioned public change.

// One moment: its dotted name (`compiler.settled`), its `Event` variant and
// the payload struct the variant carries.
CompilerEvent: struct {
    name: String,
    variant: String,
    payload: String,
}

// One field of a payload struct: its name and its type as Core spells it
// (`String`, `Int`, `Bool`, `[String]`, or another payload, `CheckedProgram`).
CompilerEventField: struct {
    name: String,
    ty: String,
}

// One payload struct and its fields, in declaration order.
CompilerEventPayload: struct {
    name: String,
    fields: [CompilerEventField],
}

COMPILER_EVENT_PARSED: "compiler.parsed"

COMPILER_EVENT_IMPORTED: "compiler.imported"

COMPILER_EVENT_DECLARED: "compiler.declared"

COMPILER_EVENT_CHECKED: "compiler.checked"

COMPILER_EVENT_SETTLED: "compiler.settled"

COMPILER_EVENT_EMITTED: "compiler.emitted"

COMPILER_EVENT_FINISHED: "compiler.finished"

COMPILER_EVENT_BUILD_PLANNED: "build.planned"

COMPILER_EVENT_BUILD_ASSET: "build.asset"

COMPILER_EVENT_BUILD_LINK: "build.link"

COMPILER_EVENT_BUILD_BEFORE_WRITE: "build.before_write"

COMPILER_EVENT_BUILD_AFTER_WRITE: "build.after_write"

// Every moment, compile moments in the order a compile reaches them, then the
// build's.
COMPILER_EVENTS: [CompilerEvent]{
    CompilerEvent{name: COMPILER_EVENT_PARSED, variant: "Parsed", payload: "File"},
    CompilerEvent{name: COMPILER_EVENT_IMPORTED, variant: "Imported", payload: "Module"},
    CompilerEvent{name: COMPILER_EVENT_DECLARED, variant: "Declared", payload: "Declaration"},
    CompilerEvent{name: COMPILER_EVENT_CHECKED, variant: "Checked", payload: "CheckedProgram"},
    CompilerEvent{name: COMPILER_EVENT_SETTLED, variant: "Settled", payload: "Round"},
    CompilerEvent{name: COMPILER_EVENT_EMITTED, variant: "Emitted", payload: "Artifact"},
    CompilerEvent{name: COMPILER_EVENT_FINISHED, variant: "Finished", payload: "Outcome"},
    CompilerEvent{name: COMPILER_EVENT_BUILD_PLANNED, variant: "Planned", payload: "Plan"},
    CompilerEvent{name: COMPILER_EVENT_BUILD_ASSET, variant: "Asset", payload: "Asset"},
    CompilerEvent{name: COMPILER_EVENT_BUILD_LINK, variant: "Link", payload: "LinkInputs"},
    CompilerEvent{name: COMPILER_EVENT_BUILD_BEFORE_WRITE, variant: "BeforeWrite", payload: "Artifact"},
    CompilerEvent{name: COMPILER_EVENT_BUILD_AFTER_WRITE, variant: "AfterWrite", payload: "Artifact"},
}

// Every payload struct the moments carry, each before the payloads that hold
// it.
COMPILER_EVENT_PAYLOADS: [CompilerEventPayload]{
    CompilerEventPayload{
        name: "File",
        fields: [CompilerEventField]{
            CompilerEventField{name: "path", ty: "String"},
            CompilerEventField{name: "module", ty: "String"},
        },
    },
    CompilerEventPayload{
        name: "Module",
        fields: [CompilerEventField]{
            CompilerEventField{name: "name", ty: "String"},
            CompilerEventField{name: "files", ty: "[String]"},
        },
    },
    CompilerEventPayload{
        name: "Declaration",
        fields: [CompilerEventField]{
            CompilerEventField{name: "name", ty: "String"},
            CompilerEventField{name: "module", ty: "String"},
            CompilerEventField{name: "calls", ty: "[String]"},
            CompilerEventField{name: "complete", ty: "Bool"},
        },
    },
    CompilerEventPayload{
        name: "CheckedProgram",
        fields: [CompilerEventField]{
            CompilerEventField{name: "declarations", ty: "[Declaration]"},
        },
    },
    CompilerEventPayload{
        name: "Round",
        fields: [CompilerEventField]{
            CompilerEventField{name: "round", ty: "Int"},
            CompilerEventField{name: "program", ty: "CheckedProgram"},
            CompilerEventField{name: "new_items", ty: "[Declaration]"},
        },
    },
    CompilerEventPayload{
        name: "Artifact",
        fields: [CompilerEventField]{
            CompilerEventField{name: "output", ty: "String"},
            CompilerEventField{name: "path", ty: "String"},
            CompilerEventField{name: "next", ty: "String"},
        },
    },
    CompilerEventPayload{
        name: "Outcome",
        fields: [CompilerEventField]{
            CompilerEventField{name: "ok", ty: "Bool"},
            CompilerEventField{name: "errors", ty: "Int"},
            CompilerEventField{name: "warnings", ty: "Int"},
        },
    },
    CompilerEventPayload{
        name: "Plan",
        fields: [CompilerEventField]{
            CompilerEventField{name: "outputs", ty: "[String]"},
            CompilerEventField{name: "steps", ty: "[String]"},
        },
    },
    CompilerEventPayload{
        name: "Asset",
        fields: [CompilerEventField]{
            CompilerEventField{name: "path", ty: "String"},
            CompilerEventField{name: "kind", ty: "String"},
        },
    },
    CompilerEventPayload{
        name: "LinkInputs",
        fields: [CompilerEventField]{
            CompilerEventField{name: "objects", ty: "[String]"},
            CompilerEventField{name: "libraries", ty: "[String]"},
            CompilerEventField{name: "args", ty: "[String]"},
            CompilerEventField{name: "output_name", ty: "String"},
            CompilerEventField{name: "output", ty: "String"},
            CompilerEventField{name: "default", ty: "[String]"},
        },
    },
}

// The Core enum every moment is a variant of, `core.compiler.Event`; each
// payload is the core.compiler struct its row names.
COMPILER_EVENT_TYPE: "<corelib>/core.compiler::Event"

// One moment as a compile met it: its row name and its payload, a value of
// the payload row's struct whose fields are the row's, in row order. The
// compile result carries them in the order `stages()` and `jet build
// --json` give them: `stages()` hands each to Jet code as its `Event`
// (compiler_event_stage), and `jet build --json` writes each as JSON
// (compiler_event_json).
CompilerEventRecord: struct {
    name: String,
    data: TComptimeValue,
}

// The payload struct the moment `name` carries; "" for a name no row has.
compiler_event_payload_name: fn(name: String) -> String Never! {
    loop row in COMPILER_EVENTS {
        if row.name == name -> return row.payload
    }
    ""
}

// The value of payload struct `payload`: its row's fields, in row order,
// holding the values of `values` in turn.
compiler_event_payload: fn(payload: String, values: &&[TComptimeValue]) -> TComptimeValue Never! {
    at := -1
    loop (index, row) in COMPILER_EVENT_PAYLOADS {
        if row.name == payload -> at = index
    }
    fields := [TComptimeField]{}
    if at >= 0 {
        loop value in values.move() {
            if fields.len() >= COMPILER_EVENT_PAYLOADS[at].fields.len() -> break
            fields.push(TComptimeField{name: COMPILER_EVENT_PAYLOADS[at].fields[fields.len()].name, value: value})
        }
    }
    TComptimeValue.Struct{type_name: "<corelib>/core.compiler::{payload}", fields: fields}
}

// The record of the moment `name`, its payload's field values given in the
// payload row's field order.
compiler_event_record: fn(name: String, values: &&[TComptimeValue]) -> CompilerEventRecord Never! {
    CompilerEventRecord{name: name, data: compiler_event_payload(compiler_event_payload_name(name), values.move())}
}

// The `core.compiler.Event` of the moment `name` with payload `data`: the
// variant its row names, carrying `data` as its one field.
compiler_event_stage: fn(name: String, data: &&TComptimeValue) -> TComptimeValue Never! {
    variant := ""
    loop row in COMPILER_EVENTS {
        if row.name == name -> variant = row.variant
    }
    TComptimeValue.Enum{type_name: COMPILER_EVENT_TYPE, variant: variant, args: [TComptimeEnumArg]{TComptimeEnumArg{name: None, value: data.move()}}}
}

// The JSON object of `record` that `jet build --json` lists and the session
// wire sends: `{"event":<name>,"data":<payload object>}`, the payload's
// fields in row order.
compiler_event_json: fn(record: CompilerEventRecord) -> String Never! {
    "{{\"event\":{foundation_json_quote(record.name)},\"data\":{compiler_event_value_json(record.data)}}}"
}

// The JSON of one payload value: a String, Int or Bool field as a JSON
// string, integer or boolean, a list as an array and a payload struct as an
// object of its fields. A payload holds nothing else; anything else is null.
compiler_event_value_json: fn(value: TComptimeValue) -> String Never! {
    if value == {
        .String(text) -> foundation_json_quote(text)
        .Int(number) -> "{number}"
        .Bool(flag) -> if flag -> "true" else -> "false"
        .List(values) -> {
            items := [String]{}
            loop item in values -> items.push(compiler_event_value_json(item))
            "[{items.join(",")}]"
        }
        .Struct(_, fields) -> {
            members := [String]{}
            loop field in fields {
                members.push("{foundation_json_quote(field.name)}:{compiler_event_value_json(field.value)}")
            }
            "{{{members.join(",")}}}"
        }
        .Float(_, _) | .Char(_) | .BigInt(_) | .Bytes(_) | .Map(_) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit | .Function(_) -> "null"
    }
}

// The JSON Schema (draft 2020-12) of the object `compiler_event_json`
// writes, rendered from the rows: one of the moments, each `{"event":
// <name>, "data": <its payload>}`, and each payload a closed object of its
// row's fields. A field of type String, Int or Bool is a JSON string,
// integer or boolean, `[T]` an array of T, and any other type the payload
// of that name. `jet inspect events --schema` prints it.
compiler_event_schema: fn() -> String Never! {
    refs := [String]{}
    defs := [String]{}
    loop row in COMPILER_EVENTS {
        refs.push("    {{\"$ref\": {foundation_json_quote("#/$defs/{row.name}")}}}")
        properties: "        \"event\": {{\"const\": {foundation_json_quote(row.name)}}},\n        \"data\": {{\"$ref\": {foundation_json_quote("#/$defs/{row.payload}")}}}"
        defs.push(compiler_event_schema_object(row.name, properties, [String]{"\"event\"", "\"data\""}))
    }
    loop payload in COMPILER_EVENT_PAYLOADS {
        properties := [String]{}
        required := [String]{}
        loop field in payload.fields {
            properties.push("        {foundation_json_quote(field.name)}: {compiler_event_schema_type(field.ty)}")
            required.push(foundation_json_quote(field.name))
        }
        defs.push(compiler_event_schema_object(payload.name, properties.join(",\n"), required))
    }
    head: "{{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"compiler event\",\n  \"description\": \"One moment of a compile or a build: an item of the events array in the build.effects status of jet build --json.\",\n"
    "{head}  \"oneOf\": [\n{refs.join(",\n")}\n  ],\n  \"$defs\": {{\n{defs.join(",\n")}\n  }}\n}}\n"
}

// The `$defs` member `name`: a closed object with the rendered `properties`
// members, each of the `required` names (already JSON strings) present.
compiler_event_schema_object: fn(name: String, properties: String, required: [String]) -> String Never! {
    "    {foundation_json_quote(name)}: {{\n      \"type\": \"object\",\n      \"properties\": {{\n{properties}\n      }},\n      \"required\": [{required.join(", ")}],\n      \"additionalProperties\": false\n    }}"
}

// The JSON Schema of a payload field of row type `ty`.
compiler_event_schema_type: fn(ty: String) -> String Never! {
    if ty == {
        "String" -> return "{{\"type\": \"string\"}}"
        "Int" -> return "{{\"type\": \"integer\"}}"
        "Bool" -> return "{{\"type\": \"boolean\"}}"
        else -> {}
    }
    if ty.starts_with("[") && ty.ends_with("]") {
        return "{{\"type\": \"array\", \"items\": {compiler_event_schema_type(ty.removeprefix("[").removesuffix("]"))}}}"
    }
    "{{\"$ref\": {foundation_json_quote("#/$defs/{ty}")}}}"
}
