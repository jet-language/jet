sors, write-all loops, and deterministic\n// request framing live in Jet. The `core.net` cells are typed OS transport\n// leaves; a missing provider is reported as an IOError rather than converted\n// into an empty or successful result.\nmodule url\nmodule mime\nmodule tls\nmodule ws\nmodule ip\n\npub struct SocketAddr {{\n    pub host: String\n    pub port: Int\n}}\n\npub struct TCPStream {{\n    fd: Int\n    host: String\n    port: Int\n}}\n\npub struct TCPListener {{\n    fd: Int\n    host: String\n    port: Int\n}}\n\npub struct UDPSocket {{\n    pub fd: Int\n    pub host: String\n    pub port: Int\n}}\n\npub struct UDPPacket {{\n    pub data: [U8]\n    pub host: String\n    pub port: Int\n    pub original_len: Int\n    pub truncated: Bool\n}}\n\npub struct UnixStream {{\n    pub fd: Int\n    pub path: String\n}}\n\npub struct UnixListener {{\n    pub fd: Int\n    pub path: String\n}}\n\n\npub struct SRVRecord {{\n    pub target: String\n    pub port: Int\n    pub priority: Int\n    pub weight: Int\n}}\n\npub fn gethostname() -> String Never! {{ core.net.gethostname() }}\n\npub fn ip_addr(text: String) -[Net, Time.Wait]> IPAddr NetError! {{\n    if !valid_text(text) -> return Err(net_err(\"ip_addr\", text, \"IP address is empty or contains control bytes\"))\n    core.net.ip_addr(text)\n}}\n\nfn ip_to_string_impl(addr: IPAddr) -> String Never! {{\n    core.net.ip_to_string(addr)\n}}\npub fn ip_to_string(addr: IPAddr) -> String Never! {{ ip_to_string_impl(addr) }}\npub fn ip_is_ipv4(addr: IPAddr) -> Bool Never! {{ core.net.ip_is_ipv4(addr) }}\n\npub fn socket_addr(host: String, port: Int) -[Net, Time.Wait]> SocketAddr NetError! {{\n    if !valid_host_text(host) -> return Err(net_err(\"socket_addr\", host, \"socket host is empty or contains invalid bytes\"))\n    if !valid_port(port) -> return Err(net_err(\"socket_addr\", host, \"port must be in 0..=65535\"))\n    host_text := host\n    if contains_byte(host, 58) && !starts_with(host, \"[\") -> host_text = \"[{{host}}]\"\n    core.net.socket_addr(host_text, port)\n}}\n\npub fn socket_addr_parse(text: String) -[Net, Time.Wait]> SocketAddr NetError! {{\n    if !valid_text(text) -> return Err(net_err(\"socket_addr_parse\", text, \"socket address is empty or contains control bytes\"))\n    core.net.socket_addr_parse(text)\n}}\n\npub fn socket_host(addr: SocketAddr) -> String Never! {{ core.net.socket_host(addr) }}\npub fn socket_port(addr: SocketAddr) -> Int Never! {{ core.net.socket_port(addr) }}\nfn socket_to_string_impl(addr: SocketAddr) -> String Never! {{\n    core.net.socket_to_string(addr)\n}}\npub fn socket_to_string(addr: SocketAddr) -> String Never! {{ socket_to_string_impl(addr) }}\npub fn socket_type(stream: TCPStream) -> String Never! {{ \"stream\" }}\n\npub fn tcp_listen(addr: String) -[Net, Time.Wait]> TCPListener NetError! {{\n    if !valid_text(addr) -> return Err(net_err(\"tcp_listen\", addr, \"listen address is empty or contains control bytes\"))\n    core.net.tcp_listen(addr)\n}}\n\npub fn tcp_listen_addr(addr: SocketAddr) -[Net, Time.Wait]> TCPListener NetError! {{\n    core.net.tcp_listen_addr(addr)\n}}\n\npub fn tcp_accept(listener: TCPListener) -[Net, Time.Wait]> TCPStream NetError! {{\n    core.net.tcp_accept(listener)\n}}\n\npub fn tcp_connect(addr: String) -[Net, Time.Wait]> TCPStream NetError! {{\n    if !valid_text(addr) -> return Err(net_err(\"tcp_connect\", addr, \"connect address is empty or contains control bytes\"))\n    core.net.tcp_connect(addr)\n}}\n\npub fn tcp_connect_addr(addr: SocketAddr) -[Net, Time.Wait]> TCPStream NetError! {{\n    core.net.tcp_connect_addr(addr)\n}}\n\npub fn tcp_connect_timeout(addr: SocketAddr, timeout_ms: Int) -[Net, Time.Wait]> TCPStream NetError! {{\n    if !valid_timeout(timeout_ms) -> return Err(net_err(\"tcp_connect_timeout\", socket_to_string_impl(addr), \"timeout must be non-negative\"))\n    core.net.tcp_connect_timeout(addr, timeout_ms)\n}}\n\npub fn tcp_connect_happy(host: String, port: Int, timeout_ms: Int) -[Net, Time.Wait]> TCPStream NetError! {{\n    if !valid_host_text(host) -> return Err(net_err(\"tcp_connect_happy\", host, \"connect host is empty or contains invalid bytes\"))\n    if !valid_port(port) -> return Err(net_err(\"tcp_connect_happy\", host, \"port must be in 0..=65535\"))\n    if !valid_timeout(timeout_ms) -> return Err(net_err(\"tcp_connect_happy\", host, \"timeout must be non-negative\"))\n    core.net.tcp_connect_happy(host, port, timeout_ms)\n}}\n\npub fn create_connection(host: String, port: Int) -[Net, Time.Wait]> TCPStream NetError! {{\n    if !valid_host_text(host) -> return Err(net_err(\"create_connection\", host, \"connect host is empty or contains invalid bytes\"))\n    if !valid_port(port) -> return Err(net_err(\"create_connection\", host, \"port must be in 0..=65535\"))\n    tcp_connect(format_host_port(host, port))\n}}\n\npub fn create_server(host: String, port: Int) -[Net, Time.Wait]> TCPListener NetError! {{\n    if !valid_host_text(host) -> return Err(net_err(\"create_server\", host, \"listen host is empty or contains invalid bytes\"))\n    if !valid_port(port) -> return Err(net_err(\"create_server\", host, \"port must be in 0..=65535\"))\n    tcp_listen(format_host_port(host, port))\n}}\npub fn send(stream: TCPStream, text: String) -[Net, Time.Wait]> Int NetError! {{\n    stream.write(text)\n}}\n\npub fn tcp_read(stream: TCPStream) -[Net, Time.Wait]> String NetError! {{\n    stream.read_text(8192)\n}}\n\npub fn tcp_write(stream: TCPStream, text: String) NetError! -[Net, Time.Wait]> {{\n    return stream.write_text(text)\n}}\npub fn tcp_read_bytes(stream: TCPStream, n: Int) -[Net, Time.Wait]> [U8] NetError! {{\n    if n < 0 -> return Err(net_err(\"tcp_read_bytes\", \"\", \"read limit must be non-negative\"))\n    stream.read(n)\n}}\n\npub fn tcp_read_text(stream: TCPStream, n: Int) -[Net, Time.Wait]> String NetError! {{\n    if n < 0 -> return Err(net_err(\"tcp_read_text\", \"\", \"read limit must be non-negative\"))\n    stream.read_text(n)\n}}\n\npub fn tcp_write_bytes(stream: TCPStream, bytes: [U8]) -[Net, Time.Wait]> Int NetError! {{\n    stream.write(bytes)\n}}\n\npub fn tcp_write_all_bytes(stream: TCPStream, bytes: [U8]) NetError! -[Net, Time.Wait]> {{\n    return stream.write_all(bytes)\n}}\n\npub fn tcp_write_text(stream: TCPStream, text: String) NetError! -[Net, Time.Wait]> {{\n    return stream.write_text(text)\n}}\n\npub fn tcp_shutdown(stream: TCPStream, how: NetShutdown) NetError! -[Net, Time.Wait]> {{\n    return stream.shutdown(how)\n}}\n\npub fn tcp_close(stream: TCPStream) NetError! -[Net, Time.Wait]> {{\n    return stream.close()\n}}\npub fn tcp_ready(stream: TCPStream, interest: NetReadyInterest, deadline_ms: Int) -[Net, Time.Wait]> NetReady NetError! {{\n    if !valid_timeout(deadline_ms) -> return Err(net_err(\"tcp_ready\", \"\", \"deadline must be non-negative\"))\n    deadline :: Duration.milliseconds(deadline_ms) ?? return Err(net_err(\"tcp_ready\", \"\", \"deadline is too large\"))\n    stream.ready(interest, deadline: deadline)\n}}\n\npub fn ready_readable(ready: NetReady) -> Bool Never! {{ core.net.ready_readable(ready) }}\npub fn ready_writable(ready: NetReady) -> Bool Never! {{ core.net.ready_writable(ready) }}\n\npub fn tcp_local_addr(stream: TCPStream) -[Net, Time.Wait]> String NetError! {{\n    stream.local_addr()\n}}\n\npub fn tcp_peer_addr(stream: TCPStream) -[Net, Time.Wait]> String NetError! {{\n    stream.peer_addr()\n}}\n\npub fn tcp_local_socket_addr(stream: TCPStream) -[Net, Time.Wait]> SocketAddr NetError! {{\n    core.net.tcp_local_socket_addr(stream)\n}}\n\npub fn tcp_peer_socket_addr(stream: TCPStream) -[Net, Time.Wait]> SocketAddr NetError! {{\n    core.net.tcp_peer_socket_addr(stream)\n}}\n\npub fn listener_local_socket_addr(listener: TCPListener) -[Net, Time.Wait]> SocketAddr NetError! {{\n    core.net.listener_local_socket_addr(listener)\n}}\n\npub fn tcp_reply(stream: TCPStream, status: String, body: String) NetError! -[Net, Time.Wait]> {{\n    if !valid_status(status) -> return Err(net_err(\"tcp_reply\", \"\", \"status must be a three-digit HTTP status without control bytes\"))\n    core.net.tcp_reply(^stream, status, body)\n}}\n\npub fn set_timeout(stream: TCPStream, timeout_ms: Int) NetError! -[Net, Time.Wait]> {{\n    if !valid_timeout(timeout_ms) -> return Err(net_err(\"set_timeout\", \"\", \"timeout must be non-negative\"))\n    working := stream\n    core.net.set_timeout(&working, timeout_ms)\n}}\n\npub fn set_read_timeout(stream: TCPStream, timeout_ms: Int) NetError! -[Net, Time.Wait]> {{\n    if !valid_timeout(timeout_ms) -> return Err(net_err(\"set_read_timeout\", \"\", \"timeout must be non-negative\"))\n    working := stream\n    core.net.set_read_timeout(&working, timeout_ms)\n}}\n\npub fn set_write_timeout(stream: TCPStream, timeout_ms: Int) NetError! -[Net, Time.Wait]> {{\n    if !valid_timeout(timeout_ms) -> return Err(net_err(\"set_write_timeout\", \"\", \"timeout must be non-negative\"))\n    working := stream\n    core.net.set_write_timeout(&working, timeout_ms)\n}}\n\npub fn nodelay(stream: TCPStream) -[Net, Time.Wait]> Bool NetError! {{\n    core.net.nodelay(stream)\n}}\n\npub fn set_nodelay(stream: TCPStream, on: Bool) NetError! -[Net, Time.Wait]> {{\n    working := stream\n    core.net.set_nodelay(&working, on)\n}}\n\npub fn ttl(stream: TCPStream) -[Net, Time.Wait]> Int NetError! {{\n    core.net.ttl(stream)\n}}\npub fn set_ttl(stream: TCPStream, hops: Int) NetError! -[Net, Time.Wait]> {{\n    if hops < 0 || hops > 4294967295 -> return Err(net_err(\"set_ttl\", \"\", \"ttl must fit u32\"))\n    working := stream\n    core.net.set_ttl(&working, hops)\n}}\n\npub fn sendfile(stream: TCPStream, path: String) -[Net, FS, Time.Wait]> Int NetError! {{\n    if !valid_text(path) -> return Err(net_err(\"sendfile\", path, \"path is empty or contains control bytes\"))\n    working := stream\n    core.net.sendfile(&working, path)\n}}\n\npub fn udp_bind(addr: String) -[Net, Time.Wait]> UDPSocket NetError! {{\n    if !valid_text(addr) -> return Err(net_err(\"udp_bind\", addr, \"bind address is empty or contains control bytes\"))\n    core.net.udp_bind(addr)\n}}\n\npub fn udp_bind_addr(addr: SocketAddr) -[Net, Time.Wait]> UDPSocket NetError! {{\n    core.net.udp_bind_addr(addr)\n}}\n\npub fn udp_local_addr(socket: UDPSocket) -[Net, Time.Wait]> SocketAddr NetError! {{\n    core.net.udp_local_addr(socket)\n}}\n\npub fn udp_set_timeout(socket: UDPSocket, timeout_ms: Int) NetError! -[Net, Time.Wait]> {{\n    if !valid_timeout(timeout_ms) -> return Err(net_err(\"udp_set_timeout\", \"\", \"timeout must be non-negative\"))\n    core.net.udp_set_timeout(socket, timeout_ms)\n}}\n\npub fn udp_send_to(socket: UDPSocket, text: String, addr: SocketAddr) -[Net, Time.Wait]> Int NetError! {{\n    core.net.udp_send_to(socket, text, addr)\n}}\n\npub fn udp_recv_from(socket: UDPSocket, limit: Int) -[Net, Time.Wait]> UDPPacket NetError! {{\n    if limit <= 0 -> return Err(net_err(\"udp_recv_from\", \"\", \"receive limit must be positive\"))\n    core.net.udp_recv_from(socket, limit)\n}}\n\npub fn udp_send_bytes_to(socket: UDPSocket, bytes: [U8], addr: SocketAddr) -[Net, Time.Wait]> Int NetError! {{\n    core.net.udp_send_bytes_to(socket, bytes, addr)\n}}\n\npub fn udp_receive(socket: UDPSocket, limit: Int) -[Net, Time.Wait]> UDPPacket NetError! {{\n    if limit < 0 -> return Err(net_err(\"udp_receive\", \"\", \"receive limit must be non-negative\"))\n    core.net.udp_receive(socket, limit)\n}}\n\npub fn udp_packet_data(packet: UDPPacket) -> String Never! {{ core.net.udp_packet_data(packet) }}\npub fn udp_packet_addr(packet: UDPPacket) -> SocketAddr Never! {{ core.net.udp_packet_addr(packet) }}\npub fn udp_packet_bytes(packet: UDPPacket) -> [U8] Never! {{ core.net.udp_packet_bytes(packet) }}\npub fn udp_packet_original_len(packet: UDPPacket) -> Int Never! {{ core.net.udp_packet_original_len(packet) }}\npub fn udp_packet_truncated(packet: UDPPacket) -> Bool Never! {{ core.net.udp_packet_truncated(packet) }}\n\npub fn unix_listen(path: String) -[Net, FS, Time.Wait]> UnixListener NetError! {{\n    if !valid_text(path) -> return Err(net_err(\"unix_listen\", path, \"socket path is empty or contains control bytes\"))\n    core.net.unix_listen(path)\n}}\n\npub fn unix_accept(listener: UnixListener) -[Net, Time.Wait]> UnixStream NetError! {{\n    core.net.unix_accept(listener)\n}}\n\npub fn unix_connect(path: String) -[Net, FS, Time.Wait]> UnixStream NetError! {{\n    if !valid_text(path) -> return Err(net_err(\"unix_connect\", path, \"socket path is empty or contains control bytes\"))\n    core.net.unix_connect(path)\n}}\n\npub fn unix_read(stream: UnixStream) -[Net, Time.Wait]> String NetError! {{\n    working := stream\n    core.net.unix_read(&working)\n}}\n\npub fn unix_write(stream: UnixStream, text: String) NetError! -[Net, Time.Wait]> {{\n    working := stream\n    core.net.unix_write(&working, text)\n}}\n\npub fn unix_read_bytes(stream: UnixStream, n: Int) -[Net, Time.Wait]> [U8] NetError! {{\n    if n <= 0 -> return Err(net_err(\"unix_read_bytes\", \"\", \"read limit must be positive\"))\n    working := stream\n    core.net.unix_read_bytes(&working, n)\n}}\n\npub fn unix_write_all_bytes(stream: UnixStream, bytes: [U8]) NetError! -[Net, Time.Wait]> {{\n    working := stream\n    core.net.unix_write_all_bytes(&working, bytes)\n}}\n\npub fn unix_shutdown(stream: UnixStream, how: NetShutdown) NetError! -[Net, Time.Wait]> {{\n    working := stream\n    core.net.unix_shutdown(&working, how)\n}}\n\npub fn unix_close(stream: UnixStream) NetError! -[Net, Time.Wait]> {{\n    working := stream\n    core.net.unix_close(&working)\n}}\n\npub fn dns_a(name: String, ms: Int) -[Net, Time.Wait]> [IPAddr] NetError! {{\n    if !valid_text(name) -> return Err(net_err(\"dns_a\", name, \"DNS name is empty or contains control bytes\"))\n    if !valid_timeout(ms) -> return Err(net_err(\"dns_a\", name, \"DNS timeout must be non-negative\"))\n    core.net.dns_a(name, ms)\n}}\n\npub fn dns_aaaa(name: String, ms: Int) -[Net, Time.Wait]> [IPAddr] NetError! {{\n    if !valid_text(name) -> return Err(net_err(\"dns_aaaa\", name, \"DNS name is empty or contains control bytes\"))\n    if !valid_timeout(ms) -> return Err(net_err(\"dns_aaaa\", name, \"DNS timeout must be non-negative\"))\n    core.net.dns_aaaa(name, ms)\n}}\n\npub fn dns_a_at(server: String, name: String, ms: Int) -[Net, Time.Wait]> [IPAddr] NetError! {{\n    if !valid_text(server) || !valid_text(name) -> return Err(net_err(\"dns_a_at\", name, \"DNS server/name is empty or contains control bytes\"))\n    if !valid_timeout(ms) -> return Err(net_err(\"dns_a_at\", name, \"DNS timeout must be non-negative\"))\n    _ :: socket_addr_parse(server) ?? return Err(net_err(\"dns_a_at\", server, \"DNS server must be an IP socket address\"))\n    core.net.dns_a_at(server, name, ms)\n}}\n\npub fn dns_aaaa_at(server: String, name: String, ms: Int) -[Net, Time.Wait]> [IPAddr] NetError! {{\n    if !valid_text(server) || !valid_text(name) -> return Err(net_err(\"dns_aaaa_at\", name, \"DNS server/name is empty or contains control bytes\"))\n    if !valid_timeout(ms) -> return Err(net_err(\"dns_aaaa_at\", name, \"DNS timeout must be non-negative\"))\n    _ :: socket_addr_parse(server) ?? return Err(net_err(\"dns_aaaa_at\", server, \"DNS server must be an IP socket address\"))\n    core.net.dns_aaaa_at(server, name, ms)\n}}\n\npub fn dns_txt(name: String, ms: Int) -[Net, Time.Wait]> [String] NetError! {{\n    if !valid_text(name) -> return Err(net_err(\"dns_txt\", name, \"DNS name is empty or contains control bytes\"))\n    if !valid_timeout(ms) -> return Err(net_err(\"dns_txt\", name, \"DNS timeout must be non-negative\"))\n    core.net.dns_txt(name, ms)\n}}\n\npub fn dns_txt_at(server: String, name: String, ms: Int) -[Net, Time.Wait]> [String] NetError! {{\n    if !valid_text(server) || !valid_text(name) -> return Err(net_err(\"dns_txt_at\", name, \"DNS server/name is empty or contains control bytes\"))\n    if !valid_timeout(ms) -> return Err(net_err(\"dns_txt_at\", name, \"DNS timeout must be non-negative\"))\n    _ :: socket_addr_parse(server) ?? return Err(net_err(\"dns_txt_at\", server, \"DNS server must be an IP socket address\"))\n    core.net.dns_txt_at(server, name, ms)\n}}\n\npub fn dns_ptr(addr: String, ms: Int) -[Net, Time.Wait]> [String] NetError! {{\n    if !valid_text(addr) -> return Err(net_err(\"dns_ptr\", addr, \"DNS address is empty or contains control bytes\"))\n    if !valid_timeout(ms) -> return Err(net_err(\"dns_ptr\", addr, \"DNS timeout must be non-negative\"))\n    core.net.dns_ptr(addr, ms)\n}}\n\npub fn dns_srv(name: String, ms: Int) -[Net, Time.Wait]> [DNSSRV] NetError! {{\n    if !valid_text(name) -> return Err(net_err(\"dns_srv\", name, \"DNS name is empty or contains control bytes\"))\n    if !valid_timeout(ms) -> return Err(net_err(\"dns_srv\", name, \"DNS timeout must be non-negative\"))\n    core.net.dns_srv(name, ms)\n}}\n\npub fn dns_srv_at(server: String, name: String, ms: Int) -[Net, Time.Wait]> [DNSSRV] NetError! {{\n    if !valid_text(server) || !valid_text(name) -> return Err(net_err(\"dns_srv_at\", name, \"DNS server/name is empty or contains control bytes\"))\n    if !valid_timeout(ms) -> return Err(net_err(\"dns_srv_at\", name, \"DNS timeout must be non-negative\"))\n    _ :: socket_addr_parse(server) ?? return Err(net_err(\"dns_srv_at\", server, \"DNS server must be an IP socket address\"))\n    core.net.dns_srv_at(server, name, ms)\n}}\n\npub fn gethostbyname(name: String) -[Net, Time.Wait]> String NetError! {{\n    hosts :: dns_a(name, 5000)\n    if hosts.len() == 0 -> return Err(net_err(\"gethostbyname\", name, \"no address\"))\n    ip_to_string_impl(hosts[0])\n}}\n\npub fn gethostbyaddr(addr: String) -[Net, Time.Wait]> String NetError! {{\n    names :: dns_ptr(addr, 5000)\n    if names.len() == 0 -> return Err(net_err(\"gethostbyaddr\", addr, \"no name\"))\n    names[0]\n}}\n\npub fn dns_srv_target(record: DNSSRV) -> String Never! {{ core.net.dns_srv_target(record) }}\npub fn dns_srv_port(record: DNSSRV) -> Int Never! {{ core.net.dns_srv_port(record) }}\npub fn dns_srv_priority(record: DNSSRV) -> Int Never! {{ core.net.dns_srv_priority(record) }}\npub fn dns_srv_weight(record: DNSSRV) -> Int Never! {{ core.net.dns_srv_weight(record) }}\n\npub fn getservbyname(name: String) -[Net, Time.Wait]> Int NetError! {{\n    if !valid_text(name) -> return Err(net_err(\"getservbyname\", name, \"service name is empty or contains control bytes\"))\n    core.net.getservbyname(name)\n}}\n\npub fn getservbyport(port: Int) -[Net, Time.Wait]> String NetError! {{\n    if !valid_port(port) -> return Err(net_err(\"getservbyport\", \"{{port}}\", \"port must be in 0..=65535\"))\n    core.net.getservbyport(port)\n}}\n\npub fn error_operation(err: NetError) -> String Never! {{ return core.net.error_operation(err) }}\npub fn error_message(err: NetError) -> String Never! {{ return core.net.error_message(err) }}\npub fn error_address(err: NetError) -> String? Never! {{ return core.net.error_address(err) }}\npub fn error_name(err: NetError) -> String? Never! {{ return core.net.error_name(err) }}\npub fn error_os_code(err: NetError) -> Int? Never! {{ return core.net.error_os_code(err) }}\n\npub fn addressfamily(addr: SocketAddr) -> String Never! {{\n    if contains_byte(addr.host, 58) -> \"IPv6\" else -> \"IPv4\"\n}}\n\nfn net_err(op: String, addr: String, message: String) -> NetError Never! {{\n    NetError.InvalidInput(NetErrorDetail{{\n        operation: op,\n        address: Val(addr),\n        name: None,\n        message: message,\n        os_code: None,\n    }})\n}}\n\n\n\n\nfn valid_text(text: String) -> Bool Never! {{\n    raw :: text.bytes()\n    if raw.len() == 0 -> return false\n    loop b in raw {{\n        n :: Int.from_u8(b)\n        if n <= 31 || n == 127 -> return false\n    }}\n    true\n}}\n\nfn valid_status(status: String) -> Bool Never! {{\n    raw :: status.bytes()\n    if raw.len() < 3 -> return false\n    if Int.from_u8(raw[0]) < 48 || Int.from_u8(raw[0]) > 57 || Int.from_u8(raw[1]) < 48 || Int.from_u8(raw[1]) > 57 || Int.from_u8(raw[2]) < 48 || Int.from_u8(raw[2]) > 57 -> return false\n    if raw.len() > 3 && raw[3] != (U8{{32}}) -> return false\n    loop b in raw {{\n        n :: Int.from_u8(b)\n        if n == 10 || n == 13 -> return false\n    }}\n    true\n}}\n\nfn valid_host_text(host: String) -> Bool Never! {{\n    raw :: host.bytes()\n    if raw.len() == 0 -> return false\n    if raw[0] == (U8{{91}}) && (raw.len() < 3 || raw[raw.len() - 1] != (U8{{93}})) -> return false\n    i := 0\n    loop i < raw.len() {{\n        n :: Int.from_u8(raw[i])\n        if n <= 32 || n == 127 || n == 47 || n == 63 || n == 35 || n == 64 -> return false\n        if n == 91 && i != 0 -> return false\n        if n == 93 && (i == 0 || raw[0] != (U8{{91}}) || i != raw.len() - 1) -> return false\n        i = i + 1\n    }}\n    true\n}}\n\nfn valid_port(port: Int) -> Bool Never! {{ port >= 0 && port <= 65535 }}\n\nfn valid_timeout(timeout_ms: Int) -> Bool Never! {{ timeout_ms >= 0 }}\n\nfn starts_with(text: String, prefix: String) -> Bool Never! {{\n    a :: text.bytes()\n    b :: prefix.bytes()\n    if b.len() > a.len() -> return false\n    loop i in 0..<b.len() {{\n        if a[i] != b[i] -> return false\n    }}\n    true\n}}\n\nfn duration_millis(duration: Duration) -> Int Never! {{\n    if duration.ns < 0 -> return -1\n    duration.ns /% 1000000\n}}\n\nfn format_host_port(host: String, port: Int) -> String Never! {{\n    raw :: host.bytes()\n    if raw.len() > 0 && raw[0] == (U8{{91}}) -> return \"{{host}}:{{port}}\"\n    if contains_byte(host, 58) -> return \"[{{host}}]:{{port}}\"\n    \"{{host}}:{{port}}\"\n}}\n\nfn contains_byte(text: String, needle: Int) -> Bool Never! {{\n    loop b in text.bytes() {{\n        if Int.from_u8(b) == needle -> return true\n    }}\n    false\n}}\n\nfn index_of(raw: [U8], b: Int) -> Int Never! {{\n    loop i in 0..<raw.len() {{\n        if Int.from_u8(raw[i]) == b -> return i\n    }}\n    -1\n}}\n\nfn last_index(raw: [U8], b: Int) -> Int Never! {{\n    i := raw.len() - 1\n    loop i >= 0 {{\n        if Int.from_u8(raw[i]) == b -> return i\n        i = i - 1\n    }}\n    -1\n}}\n\nfn parse_port(text: String) -> Int? Never! {{\n    raw :: text.bytes()\n    if raw.len() == 0 -> return None\n    n := 0\n    loop b in raw {{\n        d :: Int.from_u8(b)\n        if d < 48 || d > 57 -> return None\n        n = n * 10 + (d - 48)\n        if n > 65535 -> return None\n    }}\n    Val(n)\n}}\n\nfn ascii_lower(text: String) -> String Never! {{\n    out := [U8]{{}}\n    loop b in text.bytes() {{\n        n :: Int.from_u8(b)\n        if n >= 65 && n <= 90 -> &out.push(U8{{n + 32}}) else -> &out.push(b)\n    }}\n    String.from_bytes(out) ?? \"\"\n}}\n\nfn slice(raw: [U8], start: Int, end: Int) -> String Never! {{\n    String.from_bytes(slice_bytes(raw, start, end)) ?? \"\"\n}}\n\nfn slice_bytes(raw: [U8], start: Int, end: Int) -> [U8] Never! {{\n    out := [U8]{{}}\n    limit := if end < raw.len() -> end else -> raw.len()\n    if start < 0 || start >= limit -> return out\n    loop i in start..<limit -> &out.push(raw[i])\n    out\n}}\n"}
}

fn foundation_embedded_core_source_61() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.net.mime", alias: "core_core_net_mime", path: "Core/net/mime.jet", owner: "", owned_members: [String]{"extension", "from_extension", "parse"}, source: "// core.net.mime — `type/subtype` values and a small extension table.\n//\n// `parse` accepts `type/subtype` plus `; name=value` parameters. Type\n// subtype, and parameter names are folded to lowercase. The extension\n// table is the same one CoreLib uses for static HTTP files; unknown\n// extensions are absent, never `application/octet-stream`.\n#Error\npub enum MIMEError {{\n    Syntax\n}}\n\npub struct MIME {{\n    pub top: String\n    pub sub: String\n    parameters: [[String]]\n}}\n\nimpl MIME {{\n    /// The lowercase top-level type, such as `text`.\n    pub fn media_type(self) -> String Never! {{ ~self.top }}\n\n    /// The lowercase subtype, such as `html`.\n    pub fn subtype(self) -> String Never! {{ ~self.sub }}\n\n    /// `type/subtype` without parameters.\n    pub fn essence(self) -> String Never! {{ \"{{self.top}}/{{self.sub}}\" }}\n\n    /// The value of the named parameter; names compare case-insensitively.\n    pub fn param(self, name: String) -> String? Never! {{\n        key :: ascii_lower(name)\n        loop row in self.parameters {{\n            if row[0] == key -> return Val(~row[1])\n        }}\n        None\n    }}\n\n    /// Validated `[name, value]` parameter rows in source order.\n    pub fn params(self) -> [[String]] Never! {{ ~self.parameters }}\n}}\n\npub fn parse(text: String) -> MIME MIMEError! {{\n    raw :: trim_ascii(text)\n    bytes :: raw.bytes()\n    semi := bytes.len()\n    i := 0\n    loop i < bytes.len() {{\n        if bytes[i] == (U8{{59}}) {{\n            semi = i\n            break\n        }}\n        i = i + 1\n    }}\n    essence :: slice(bytes, 0, semi)\n    slash := -1\n    i = 0\n    loop i < essence.bytes().len() {{\n        if essence.bytes()[i] == (U8{{47}}) {{\n            if slash >= 0 -> return Err(MIMEError.Syntax)\n            slash = i\n        }}\n        i = i + 1\n    }}\n    if slash <= 0 -> return Err(MIMEError.Syntax)\n    top :: ascii_lower(trim_ascii(slice(essence.bytes(), 0, slash)))\n    sub :: ascii_lower(trim_ascii(slice(essence.bytes(), slash + 1, essence.bytes().len())))\n    if !mime_token(top) || !mime_token(sub) -> return Err(MIMEError.Syntax)\n\n    parameters := [[String]]{{}}\n    start := semi + 1\n    i = start\n    loop i <= bytes.len() {{\n        if i == bytes.len() || bytes[i] == (U8{{59}}) {{\n            parameter :: trim_ascii(slice(bytes, start, i))\n            if parameter.bytes().len() > 0 {{\n                eq := index_of(parameter.bytes(), 61)\n                if eq <= 0 -> return Err(MIMEError.Syntax)\n                name :: ascii_lower(trim_ascii(slice(parameter.bytes(), 0, eq)))\n                if !mime_token(name) -> return Err(MIMEError.Syntax)\n                raw_value :: trim_ascii(slice(parameter.bytes(), eq + 1, parameter.bytes().len()))\n                vb :: raw_value.bytes()\n                quoted :: vb.len() >= 2 && vb[0] == (U8{{34}}) && vb[vb.len() - 1] == (U8{{34}})\n                value :: if quoted -> slice(vb, 1, vb.len() - 1) else -> raw_value\n                &parameters.push([String]{{name, value}})\n            }}\n            start = i + 1\n        }}\n        i = i + 1\n    }}\n    Ok(MIME{{top: top, sub: sub, parameters: parameters}})\n}}\n\npub fn from_extension(ext: String) -> String? Never! {{\n    key :: ascii_lower(trim_dot(ext))\n    if key == {{\n        \"html\" | \"htm\" -> Val(\"text/html\")\n        \"css\" -> Val(\"text/css\")\n        \"csv\" -> Val(\"text/csv\")\n        \"txt\" | \"text\" -> Val(\"text/plain\")\n        \"md\" -> Val(\"text/markdown\")\n        \"json\" -> Val(\"application/json\")\n        \"js\" | \"mjs\" -> Val(\"text/javascript\")\n        \"wasm\" -> Val(\"application/wasm\")\n        \"pdf\" -> Val(\"application/pdf\")\n        \"png\" -> Val(\"image/png\")\n        \"jpg\" | \"jpeg\" -> Val(\"image/jpeg\")\n        \"gif\" -> Val(\"image/gif\")\n        \"svg\" -> Val(\"image/svg+xml\")\n        \"webp\" -> Val(\"image/webp\")\n        \"ico\" -> Val(\"image/x-icon\")\n        \"mp3\" -> Val(\"audio/mpeg\")\n        \"mp4\" -> Val(\"video/mp4\")\n        \"xml\" -> Val(\"application/xml\")\n        \"zip\" -> Val(\"application/zip\")\n        \"gz\" -> Val(\"application/gzip\")\n        \"tar\" -> Val(\"application/x-tar\")\n        else -> None\n    }}\n}}\n\npub fn extension(mime: String) -> String? Never! {{\n    essence :: ascii_lower(trim_params(mime))\n    if essence == {{\n        \"text/html\" -> Val(\"html\")\n        \"text/css\" -> Val(\"css\")\n        \"text/csv\" -> Val(\"csv\")\n        \"text/plain\" -> Val(\"txt\")\n        \"text/markdown\" -> Val(\"md\")\n        \"text/javascript\" | \"application/javascript\" -> Val(\"js\")\n        \"application/wasm\" -> Val(\"wasm\")\n        \"application/pdf\" -> Val(\"pdf\")\n        \"image/png\" -> Val(\"png\")\n        \"image/jpeg\" -> Val(\"jpg\")\n        \"image/gif\" -> Val(\"gif\")\n        \"image/svg+xml\" -> Val(\"svg\")\n        \"image/webp\" -> Val(\"webp\")\n        \"image/x-icon\" -> Val(\"ico\")\n        \"audio/mpeg\" -> Val(\"mp3\")\n        \"video/mp4\" -> Val(\"mp4\")\n        \"application/xml\" | \"text/xml\" -> Val(\"xml\")\n        \"application/zip\" -> Val(\"zip\")\n        \"application/gzip\" -> Val(\"gz\")\n        \"application/x-tar\" -> Val(\"tar\")\n        else -> None\n    }}\n}}\n\nfn trim_dot(ext: String) -> String Never! {{\n    raw :: (~ext).bytes()\n    i := 0\n    loop i < raw.len() && raw[i] == (U8{{46}}) -> i = i + 1\n    if i > 0 -> return slice(raw, i, raw.len())\n    return ~ext\n}}\n\nfn trim_params(mime: String) -> String Never! {{\n    raw :: (~mime).bytes()\n    loop i in 0..<raw.len() {{\n        if raw[i] == (U8{{59}}) -> return trim_ascii(slice(raw, 0, i))\n    }}\n    trim_ascii(mime)\n}}\n\nfn trim_ascii(text: String) -> String Never! {{\n    raw :: text.bytes()\n    start := 0\n    end := raw.len()\n    loop {{\n        if start >= end -> return \"\"\n        n :: Int.from_u8(raw[start])\n        if n == 32 || n == 9 || n == 10 || n == 13 -> start = start + 1 else -> break\n    }}\n    loop {{\n        if end <= start -> return \"\"\n        n :: Int.from_u8(raw[end - 1])\n        if n == 32 || n == 9 || n == 10 || n == 13 -> end = end - 1 else -> break\n    }}\n    slice(raw, start, end)\n}}\n\nfn ascii_lower(text: String) -> String Never! {{\n    out := [U8]{{}}\n    loop b in text.bytes() {{\n        n :: b\n        if n >= 65 && n <= 90 -> &out.push(U8{{n + 32}}) else -> &out.push(b)\n    }}\n    String.from_bytes(out) ?? \"\"\n}}\n\nfn mime_token(text: String) -> Bool Never! {{\n    raw :: text.bytes()\n    if raw.len() == 0 -> return false\n    loop b in raw {{\n        n :: Int.from_u8(b)\n        if (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || (n >= 48 && n <= 57) {{\n            next\n        }}\n        if n == 33 || n == 35 || n == 36 || n == 38 || n == 45 || n == 94 || n == 95 || n == 46 || n == 43 {{\n            next\n        }}\n        return false\n    }}\n    true\n}}\n\nfn index_of(raw: [U8], needle: Int) -> Int Never! {{\n    loop i in 0..<raw.len() {{\n        if Int.from_u8(raw[i]) == needle -> return i\n    }}\n    -1\n}}\n\nfn slice(raw: [U8], start: Int, end: Int) -> String Never! {{\n    out := [U8]{{}}\n    i := start\n    loop {{\n        if i >= end -> return String.from_bytes(out) ?? \"\"\n        &out.push(raw[i])\n        i = i + 1\n    }}\n}}\n"}
}

fn foundation_embedded_core_source_62() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.net.tls", alias: "core_core_net_tls", path: "Core/net/tls.jet", owner: "", owned_members: [String]{"alpn_h2", "client", "close", "config", "connect_host", "flags", "has_alpn", "identity", "is_tls12", "is_tls13", "parse_version", "peer_port", "read", "read_text", "roots", "sni", "unwrap", "version_name", "with_alpn", "write", "write_all", "write_text"}, source: "use core as core\nuse core.net as net\n\n// core.net.tls — TLS byte streams with Jet-owned input/config semantics.\n//\n// The provider owns socket setup and the TLS state machine. Jet owns endpoint\n// validation, configuration carriers, ALPN checks, and the explicit boundary\n// where a provider cannot consume a source-level configuration.\n\npub struct ClientConfig {{ pub host: String, pub alpn: [String] }}\npub struct ClientIdentity {{ pub cert: String, pub key: String }}\npub struct RootCertificates {{ pub path: String }}\npub struct TLSCertificate {{\n    pub der: [U8]\n    pub sha256: [U8]\n    pub spki_sha256: [U8]\n    pub dns_names: [String]\n    pub valid_from_unix_ms: Int\n    pub valid_until_unix_ms: Int\n    pub subject: String\n    pub issuer: String\n}}\npub struct TLSPeerIdentity {{\n    pub verified_server_name: String\n    pub leaf: TLSCertificate\n    pub certificate_chain: [TLSCertificate]\n    pub cipher_suite: String\n    pub tls_version: TLSVersion\n}}\npub enum TLSVersion {{\n    TLS12\n    TLS13\n}}\n\n// The two-argument native leaf consumes a connected TCPStream and a server\n// name. Do not manufacture a descriptor or call the leaf with host/port text:\n// the transport and TLS capabilities are separate typed boundaries.\npub fn client(host: String, port: Int) -[Net, Time.Wait]> TLSStream IOError! {{\n    if !valid_host(host) -> return Err(tls_error(\"client\", host, \"host is empty or contains invalid endpoint syntax\"))\n    if port <= 0 || port > 65535 -> return Err(tls_error(\"client\", host, \"port must be in 1..=65535\"))\n    tcp :: if net.tcp_connect(format_host_port(host, port)) == {{\n        .Ok(stream) -> stream\n        .Err(_) -> {{ return Err(tls_error(\"client\", host, \"transport connect failed\")) }}\n    }}\n    core.net.tls.client(^tcp, host)\n}}\n\npub fn read(stream: TLSStream, n: Int) -[Net, Time.Wait]> [U8] IOError! {{\n    if n <= 0 -> return Err(tls_error(\"read\", \"\", \"read limit must be positive\"))\n    working := stream\n    core.net.tls.read(&working, n)\n}}\n\npub fn read_text(stream: TLSStream, n: Int) -[Net, Time.Wait]> String IOError! {{\n    if n <= 0 -> return Err(tls_error(\"read_text\", \"\", \"read limit must be positive\"))\n    bytes :: read(stream, n)\n    Ok(String.from_bytes(bytes) ?? return Err(tls_error(\"read_text\", \"\", \"read bytes are not UTF-8\")))\n}}\n\npub fn write(stream: TLSStream, bytes: [U8]) -[Net, Time.Wait]> Int IOError! {{\n    working := stream\n    core.net.tls.write(&working, bytes)\n}}\n\npub fn write_all(stream: TLSStream, bytes: [U8]) IOError! {{\n    working := stream\n    core.net.tls.write_all(&working, bytes)\n}}\n\npub fn write_text(stream: TLSStream, text: String) IOError! {{\n    working := stream\n    core.net.tls.write_text(&working, text)\n}}\n\npub fn close(stream: TLSStream) IOError! {{\n    working := stream\n    working.close()\n}}\n\npub fn sni(stream: TLSStream) -[Net]> String Never! {{\n    peer :: stream.peer_identity()\n    peer.verified_server_name\n}}\n\n// TLSStream deliberately does not expose a transport socket address. Keeping\n// a source-level port field would be an invalid nominal identity for the native\n// provider, so report the missing capability instead of fabricating a value.\npub fn peer_port(stream: TLSStream) -[Net]> Int IOError! {{\n    Err(tls_error(\"peer_port\", \"\", \"TLS provider does not expose the peer port\"))\n}}\n\n// A TLS stream deliberately cannot be downgraded: doing so would make the\n// caller believe plaintext bytes are protected by the old connection state.\npub fn unwrap(stream: TLSStream) -[Net]> TCPStream IOError! {{\n    Err(tls_error(\"unwrap\", \"\", \"TLS stream cannot be downgraded\"))\n}}\npub fn version_name(v: TLSVersion) -> String Never! {{\n    if v == TLSVersion.TLS12 -> return \"TLSv1.2\"\n    return \"TLSv1.3\"\n}}\n\npub fn parse_version(name: String) -> TLSVersion? Never! {{\n    n := ascii_lower(trim_ascii(name))\n    if n == {{\n        \"tlsv1.2\" | \"tls1.2\" | \"1.2\" | \"tls12\" -> Val(TLSVersion.TLS12)\n        \"tlsv1.3\" | \"tls1.3\" | \"1.3\" | \"tls13\" -> Val(TLSVersion.TLS13)\n        else -> None\n    }}\n}}\n\npub fn is_tls13(v: TLSVersion) -> Bool Never! {{ v == TLSVersion.TLS13 }}\n\npub fn is_tls12(v: TLSVersion) -> Bool Never! {{ v == TLSVersion.TLS12 }}\n\n// Constructors are pure carriers. Endpoint, ALPN, identity, and root policy\n// is checked at the operation boundary instead of being silently dropped.\npub fn config(host: String) -> ClientConfig Never! {{ ClientConfig{{host: host, alpn: [String]{{}}}} }}\n\npub fn with_alpn(cfg: ClientConfig, proto: String) -> ClientConfig Never! {{\n    alpn := [String]{{}}\n    loop p in cfg.alpn -> &alpn.push(p)\n    // Keep the requested value visible. connect_host validates the complete\n    // list before crossing into the provider, so invalid input cannot become a\n    // successful handshake or disappear as a no-op.\n    &alpn.push(proto)\n    ClientConfig{{host: cfg.host, alpn: alpn}}\n}}\n\npub fn alpn_h2(cfg: ClientConfig) -> ClientConfig Never! {{\n    with_alpn(with_alpn(cfg, \"h2\"), \"http/1.1\")\n}}\n\npub fn identity(cert: String, key: String) -> ClientIdentity Never! {{\n    ClientIdentity{{cert: cert, key: key}}\n}}\n\npub fn roots(path: String) -> RootCertificates Never! {{\n    RootCertificates{{path: path}}\n}}\n\n// This legacy carrier has no native leaf that accepts the source ClientConfig\n// (ALPN, identity, and root stores). Refuse configured policy explicitly rather\n// than connecting with a silently downgraded system-only configuration.\npub fn connect_host(cfg: ClientConfig, port: Int) -[Net, Time.Wait]> TLSStream IOError! {{\n    if !valid_host(cfg.host) -> return Err(tls_error(\"connect_host\", cfg.host, \"host is empty or contains invalid endpoint syntax\"))\n    if port <= 0 || port > 65535 -> return Err(tls_error(\"connect_host\", cfg.host, \"port must be in 1..=65535\"))\n    if !valid_alpn_list(cfg.alpn) -> return Err(tls_error(\"connect_host\", cfg.host, \"ALPN protocol must contain 1..255 non-control bytes\"))\n    if cfg.alpn.len() > 0 {{\n        return Err(tls_error(\"connect_host\", cfg.host, \"configured ALPN requires the native ClientConfig provider\"))\n    }}\n    client(cfg.host, port)\n}}\n\npub fn flags(cfg: ClientConfig) -> [String] Never! {{ cfg.alpn }}\n\npub fn has_alpn(cfg: ClientConfig, proto: String) -> Bool Never! {{\n    loop p in cfg.alpn {{\n        if p == proto -> return true\n    }}\n    false\n}}\n\nfn tls_error(operation: String, address: String, message: String) -> IOError Never! {{\n    is_unsupported := operation == \"peer_port\" ||\n        operation == \"unwrap\" ||\n        message == \"configured ALPN requires the native ClientConfig provider\"\n    if operation == \"read\" || operation == \"read_text\" {{\n        context := IOContext{{operation: .Read, resource: Val(~address), os_code: None, cause: Val(~message)}}\n        if is_unsupported -> return IOError.Other(context)\n        return IOError.InvalidInput(context)\n    }}\n    if operation == \"write\" || operation == \"write_all\" || operation == \"write_text\" {{\n        context := IOContext{{operation: .Write, resource: Val(~address), os_code: None, cause: Val(~message)}}\n        if is_unsupported -> return IOError.Other(context)\n        return IOError.InvalidInput(context)\n    }}\n    if operation == \"close\" {{\n        context := IOContext{{operation: .Close, resource: Val(~address), os_code: None, cause: Val(~message)}}\n        if is_unsupported -> return IOError.Other(context)\n        return IOError.InvalidInput(context)\n    }}\n    if operation == \"client\" || operation == \"connect_host\" {{\n        context := IOContext{{operation: .Connect, resource: Val(~address), os_code: None, cause: Val(~message)}}\n        if is_unsupported -> return IOError.Other(context)\n        return IOError.InvalidInput(context)\n    }}\n    context := IOContext{{operation: .Resolve, resource: Val(~address), os_code: None, cause: Val(~message)}}\n    if is_unsupported -> return IOError.Other(context)\n    IOError.InvalidInput(context)\n}}\n\nfn valid_host(host: String) -> Bool Never! {{\n    raw :: host.bytes()\n    if raw.len() == 0 || raw.len() > 253 -> return false\n    if raw[0] == (U8{{91}}) && (raw.len() < 3 || raw[raw.len() - 1] != (U8{{93}})) -> return false\n    colons := 0\n    i := 0\n    loop i < raw.len() {{\n        n :: Int.from_u8(raw[i])\n        if n <= 32 || n == 127 || n == 47 || n == 63 || n == 35 || n == 64 -> return false\n        if n == 58 -> colons = colons + 1\n        if n == 91 && i != 0 -> return false\n        if n == 93 && (i == 0 || raw[0] != (U8{{91}}) || i != raw.len() - 1) -> return false\n        i = i + 1\n    }}\n    if colons == 1 -> return false\n    if colons == 0 -> return valid_dns_name(raw)\n    true\n}}\n\nfn valid_dns_name(raw: [U8]) -> Bool Never! {{\n    label_start := 0\n    loop i in 0..<raw.len() {{\n        n :: Int.from_u8(raw[i])\n        if n == 46 {{\n            label_len := i - label_start\n            if label_len == 0 {{\n                return i == raw.len() - 1 && i > 0 && raw[i - 1] != (U8{{46}})\n            }}\n            if raw[label_start] == (U8{{45}}) || raw[i - 1] == (U8{{45}}) -> return false\n            label_start = i + 1\n        }} else {{\n            if !((n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || n == 45 || n >= 128) -> return false\n            if i - label_start >= 63 -> return false\n        }}\n    }}\n    label_len := raw.len() - label_start\n    if label_len == 0 {{\n        if raw.len() < 2 -> return false\n        return raw[raw.len() - 2] != (U8{{46}})\n    }}\n    if raw[label_start] == (U8{{45}}) || raw[raw.len() - 1] == (U8{{45}}) -> return false\n    true\n}}\n\nfn format_host_port(host: String, port: Int) -> String Never! {{\n    raw :: host.bytes()\n    if raw.len() > 0 && raw[0] == (U8{{91}}) -> return \"{{host}}:{{port}}\"\n    if contains_byte(host, 58) -> return \"[{{host}}]:{{port}}\"\n    \"{{host}}:{{port}}\"\n}}\n\nfn contains_byte(text: String, needle: Int) -> Bool Never! {{\n    loop b in text.bytes() {{\n        if Int.from_u8(b) == needle -> return true\n    }}\n    false\n}}\n\nfn valid_alpn_list(protocols: [String]) -> Bool Never! {{\n    loop protocol in protocols {{\n        raw :: protocol.bytes()\n        if raw.len() == 0 || raw.len() > 255 -> return false\n        loop b in raw {{\n            n :: Int.from_u8(b)\n            if n <= 32 || n == 127 -> return false\n        }}\n    }}\n    true\n}}\n\nfn trim_ascii(text: String) -> String Never! {{\n    raw :: text.bytes()\n    start := 0\n    end := raw.len()\n    loop start < end {{\n        n :: Int.from_u8(raw[start])\n        if n == 32 || n == 9 || n == 13 || n == 10 -> start = start + 1 else -> break\n    }}\n    loop end > start {{\n        n :: Int.from_u8(raw[end - 1])\n        if n == 32 || n == 9 || n == 13 || n == 10 -> end = end - 1 else -> break\n    }}\n    if end <= start -> return \"\"\n    result :: String.from_bytes(raw[start..(end - 1)]) ?? \"\"\n    return result\n}}\nfn ascii_lower(text: String) -> String Never! {{\n    out := [U8]{{}}\n    loop b in text.bytes() {{\n        n :: Int.from_u8(b)\n        if n >= 65 && n <= 90 -> &out.push(U8{{n + 32}}) else -> &out.push(b)\n    }}\n    decoded :: String.from_bytes(out) ?? return ~text\n    return decoded\n}}\n"}
}

fn foundation_embedded_core_source_63() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.net.url", alias: "core_core_net_url", path: "Core/net/url.jet", owner: "", owned_members: [String]{"data", "file", "from_parts", "geturl", "parse", "percent_decode", "percent_encode", "query", "unparse", "urljoin", "parse_qsl", "urlencode", "split_fragment", "quote", "quote_from_bytes", "quote_plus", "unquote", "unquote_to_bytes", "unquote_plus", "urlparse", "urlsplit", "urlunparse", "urlunsplit", "urldefrag", "parse_qs"}, source: "// core.net.url — RFC 3986 URLs and component escaping.\n//\n// URL structure, authority validation, dot-segment removal, query ordering,\n// and the percent codecs are deterministic Jet code. The value is intentionally\n// kept as the existing `URL` carrier used by the Core registry.\n//\n// Non-ASCII host labels are lowercased byte-wise and Punycode-encoded\n// (RFC 3492, `xn--` prefix); no IDNA mapping table is applied. An explicit\n// authority port is remembered so rendering keeps it even when it equals the\n// scheme default; `port` itself follows the default-port convention.\nuse core.net.mime.[MIME]\n#Error\npub enum URLError {{\n    Syntax\n    Percent\n}}\n\npub struct URL {{\n    pub scheme: String\n    user_text: String\n    password_text: String\n    pub host: String\n    pub port: Int\n    port_explicit: Bool\n    pub path: String\n    pub query: String\n    pub fragment: String\n    pub raw: String\n}}\n\nimpl URL {{\n    /// Render the URL; an explicit authority port is kept.\n    pub fn to_string(self) -> String Never! {{ unparse(self) }}\n\n    /// The decoded user name, or empty when absent.\n    pub fn username(self) -> String Never! {{ ~self.user_text }}\n\n    /// The decoded password, or empty when absent.\n    pub fn password(self) -> String Never! {{ ~self.password_text }}\n\n    /// `user:password`, `user`, or empty.\n    pub fn userinfo(self) -> String Never! {{ userinfo_text(self) }}\n\n    /// `userinfo@host:port` with the port only when it was written explicitly.\n    pub fn authority(self) -> String Never! {{\n        if self.host.bytes().len() == 0 -> return \"\"\n        out := \"\"\n        info :: userinfo_text(self)\n        if info.bytes().len() > 0 -> out = \"{{info}}@\"\n        out = \"{{out}}{{render_host(self.host)}}\"\n        if self.port_explicit && self.port >= 0 -> out = \"{{out}}:{{self.port}}\"\n        out\n    }}\n\n    /// The registered default port for the scheme, when it has one.\n    pub fn default_port(self) -> Int? Never! {{\n        port :: scheme_default_port(self.scheme)\n        if port < 0 -> return None\n        Val(port)\n    }}\n\n    /// Decoded, non-empty path segments.\n    pub fn path_segments(self) -> [String] Never! {{\n        raw :: self.path.bytes()\n        out := [String]{{}}\n        start := 0\n        loop i in 0..<(raw.len() + 1) {{\n            if i == raw.len() || raw[i] == (U8{{47}}) {{\n                if i > start -> &out.push(slice(raw, start, i))\n                start = i + 1\n            }}\n        }}\n        out\n    }}\n\n    /// Decoded repeated query pairs, in order.\n    pub fn query_pairs(self) -> [[String]] Never! {{ parse_qsl(self.query) ?? [[String]]{{}} }}\n\n    /// A copy with a lowercase scheme, ASCII host, and dot segments removed.\n    pub fn normalize(self) -> URL Never! {{\n        scheme :: ascii_lower(self.scheme)\n        path := self.path\n        if scheme != \"data\" -> path = normalize_path(self.path, self.host.bytes().len() > 0 || starts(self.path, \"/\"))\n        URL{{\n            scheme: scheme,\n            user_text: self.user_text,\n            password_text: self.password_text,\n            host: host_to_ascii(ascii_lower(self.host)),\n            port: self.port,\n            port_explicit: self.port_explicit,\n            path: path,\n            query: self.query,\n            fragment: self.fragment,\n            raw: \"\",\n        }}\n    }}\n\n    /// Resolve a relative reference against this URL.\n    pub fn join(self, relative: String) -> URL URLError! {{ join_url(self, relative) }}\n}}\n\nfn userinfo_text(url: URL) -> String Never! {{\n    if url.password_text.bytes().len() == 0 -> return ~url.user_text\n    \"{{url.user_text}}:{{url.password_text}}\"\n}}\n\n\npub fn parse(text: String) -> URL URLError! {{\n    input :: trim_ascii(text)\n    raw :: input.bytes()\n    if raw.len() == 0 -> return Err(URLError.Syntax)\n    colon := scheme_colon(raw)\n    if colon <= 0 -> return Err(URLError.Syntax)\n    scheme :: ascii_lower(slice(raw, 0, colon))\n    if !valid_scheme(scheme) -> return Err(URLError.Syntax)\n\n    rest_i := colon + 1\n    user := \"\"\n    password := \"\"\n    host := \"\"\n    port := scheme_default_port(scheme)\n    port_explicit := false\n\n    if rest_i + 1 < raw.len() && raw[rest_i] == (U8{{47}}) && raw[rest_i + 1] == (U8{{47}}) {{\n        rest_i = rest_i + 2\n        auth_end := rest_i\n        loop auth_end < raw.len() {{\n            n :: Int.from_u8(raw[auth_end])\n            if n == 47 || n == 63 || n == 35 -> break\n            auth_end = auth_end + 1\n        }}\n        authority :: slice(raw, rest_i, auth_end)\n        if authority.bytes().len() == 0 -> return Err(URLError.Syntax)\n        at := last_index(authority.bytes(), 64)\n        hostport := ~authority\n        if at >= 0 {{\n            info :: slice(authority.bytes(), 0, at)\n            sep := index_of(info.bytes(), 58)\n            if sep >= 0 {{\n                user = percent_decode(slice(info.bytes(), 0, sep)) ?? return Err(URLError.Percent)\n                password = percent_decode(slice(info.bytes(), sep + 1, info.bytes().len())) ?? return Err(URLError.Percent)\n            }} else {{\n                user = percent_decode(info) ?? return Err(URLError.Percent)\n            }}\n            hostport = slice(authority.bytes(), at + 1, authority.bytes().len())\n        }}\n        if hostport.bytes().len() == 0 -> return Err(URLError.Syntax)\n        hp :: hostport.bytes()\n        if hp[0] == (U8{{91}}) {{\n            rb := index_of(hp, 93)\n            if rb < 0 -> return Err(URLError.Syntax)\n            host = ascii_lower(slice(hp, 1, rb))\n            if rb + 1 < hp.len() {{\n                if hp[rb + 1] != (U8{{58}}) -> return Err(URLError.Syntax)\n                port = parse_port(slice(hp, rb + 2, hp.len())) ?? return Err(URLError.Syntax)\n                port_explicit = true\n            }}\n        }} else {{\n            col := last_index(hp, 58)\n            if col >= 0 {{\n                if index_of(hp, 58) != col -> return Err(URLError.Syntax)\n                host = host_to_ascii(ascii_lower(slice(hp, 0, col)))\n                port = parse_port(slice(hp, col + 1, hp.len())) ?? return Err(URLError.Syntax)\n                port_explicit = true\n            }} else {{\n                host = host_to_ascii(ascii_lower(hostport))\n            }}\n        }}\n        if !valid_url_host(host) -> return Err(URLError.Syntax)\n        rest_i = auth_end\n    }} else if scheme == \"http\" || scheme == \"https\" || scheme == \"ws\" || scheme == \"wss\" {{\n        return Err(URLError.Syntax)\n    }}\n\n    hash := raw.len()\n    loop i in rest_i..<raw.len() {{\n        if raw[i] == (U8{{35}}) {{\n            hash = i\n            break\n        }}\n    }}\n    qpos := hash\n    loop i in rest_i..<hash {{\n        if raw[i] == (U8{{63}}) {{\n            qpos = i\n            break\n        }}\n    }}\n    path_raw :: slice(raw, rest_i, qpos)\n    if !valid_percent(path_raw) -> return Err(URLError.Percent)\n    path := if scheme == \"data\" -> path_raw else -> percent_decode(path_raw) ?? return Err(URLError.Percent)\n    path = if scheme == \"data\" -> path else -> normalize_path(path, host.bytes().len() > 0)\n    if path.bytes().len() == 0 && host.bytes().len() > 0 -> path = \"/\"\n    query := \"\"\n    if qpos < hash -> query = escape_query(slice(raw, qpos + 1, hash))\n    fragment := \"\"\n    if hash < raw.len() -> fragment = percent_decode(slice(raw, hash + 1, raw.len())) ?? return Err(URLError.Percent)\n    Ok(URL{{scheme: scheme, user_text: user, password_text: password, host: host, port: port, port_explicit: port_explicit, path: path, query: query, fragment: fragment, raw: input}})\n}}\n\npub fn from_parts(scheme: String, host: String, path: String, query: [[String]], fragment: String) -> URL URLError! {{\n    scheme_l :: ascii_lower(scheme)\n    if !valid_scheme(scheme_l) -> return Err(URLError.Syntax)\n    if host.bytes().len() == 0 && (scheme_l == \"http\" || scheme_l == \"https\" || scheme_l == \"ws\" || scheme_l == \"wss\") {{\n        return Err(URLError.Syntax)\n    }}\n    if host.bytes().len() > 0 && !valid_url_host(ascii_lower(host)) -> return Err(URLError.Syntax)\n    p := path\n    if host.bytes().len() > 0 && p.bytes().len() == 0 -> p = \"/\"\n    if host.bytes().len() > 0 && p.bytes().len() > 0 && p.bytes()[0] != (U8{{47}}) -> p = \"/{{p}}\"\n    q :: encode_query(query)\n    raw := \"{{scheme_l}}:\"\n    if host.bytes().len() > 0 {{\n        rendered_host := ascii_lower(host)\n        if contains_byte(host, 58) && !starts(host, \"[\") -> rendered_host = \"[{{rendered_host}}]\"\n        raw = \"{{raw}}//{{rendered_host}}\"\n    }}\n    raw = \"{{raw}}{{p}}\"\n    if q.bytes().len() > 0 -> raw = \"{{raw}}?{{q}}\"\n    if fragment.bytes().len() > 0 -> raw = \"{{raw}}#{{percent_encode(fragment)}}\"\n    parse(raw)\n}}\n\npub fn file(path: String) -> URL Never! {{\n    p := path\n    if p.bytes().len() == 0 -> p = \"/\"\n    if p.bytes()[0] != (U8{{47}}) -> p = \"/{{p}}\"\n    URL{{scheme: \"file\", user_text: \"\", password_text: \"\", host: \"\", port: -1, port_explicit: false, path: normalize_path(p, true), query: \"\", fragment: \"\", raw: \"\"}}\n}}\n\npub fn data(mime: MIME, payload: String) -> URL Never! {{\n    encoded :: percent_encode(payload)\n    URL{{scheme: \"data\", user_text: \"\", password_text: \"\", host: \"\", port: -1, port_explicit: false, path: \"{{mime.top}}/{{mime.sub}},{{encoded}}\", query: \"\", fragment: \"\", raw: \"\"}}\n}}\n\nfn scheme_default_port(scheme: String) -> Int Never! {{\n    if scheme == {{\n        \"http\" | \"ws\" -> 80\n        \"https\" | \"wss\" -> 443\n        \"ftp\" -> 21\n        \"ssh\" -> 22\n        \"smtp\" -> 25\n        \"pop3\" -> 110\n        \"imap\" -> 143\n        else -> -1\n    }}\n}}\n\npub fn query(pairs: [[String]]) -> String Never! {{ encode_query(pairs) }}\n\nfn encode_query(pairs: [[String]]) -> String Never! {{\n    out := \"\"\n    first := true\n    loop row in pairs {{\n        if row.len() == 0 -> next\n        key :: percent_encode(row[0])\n        value := \"\"\n        if row.len() > 1 -> value = percent_encode(row[1])\n        piece :: \"{{key}}={{value}}\"\n        if first {{\n            out = piece\n            first = false\n        }} else {{\n            out = \"{{out}}&{{piece}}\"\n        }}\n    }}\n    out\n}}\n\npub fn percent_encode(text: String) -> String Never! {{\n    encode_component(text, false, false)\n}}\n\npub fn percent_decode(text: String) -> String URLError! {{\n    raw :: text.bytes()\n    out := [U8]{{}}\n    i := 0\n    loop {{\n        if i >= raw.len() -> break\n        if raw[i] == (U8{{37}}) {{\n            if i + 2 >= raw.len() -> return Err(URLError.Percent)\n            hi :: hex_value(raw[i + 1]) ?? return Err(URLError.Percent)\n            lo :: hex_value(raw[i + 2]) ?? return Err(URLError.Percent)\n            &out.push(U8{{hi * 16 + lo}})\n            i = i + 3\n        }} else {{\n            &out.push(raw[i])\n            i = i + 1\n        }}\n    }}\n    String.from_bytes(out) ?? return Err(URLError.Percent)\n}}\n\npub fn geturl(url: URL) -> String Never! {{ unparse(url) }}\n\npub fn unparse(url: URL) -> String Never! {{\n    scheme :: ascii_lower(url.scheme)\n    authority := \"\"\n    if url.host.bytes().len() > 0 {{\n        host :: render_host(url.host)\n        authority = ~host\n        if url.user_text.bytes().len() > 0 {{\n            authority = percent_encode(url.user_text)\n            if url.password_text.bytes().len() > 0 -> authority = \"{{authority}}:{{percent_encode(url.password_text)}}\"\n            authority = \"{{authority}}@{{host}}\"\n        }}\n        if url.port >= 0 && (url.port_explicit || url.port != scheme_default_port(scheme)) -> authority = \"{{authority}}:{{url.port}}\"\n    }}\n    path := url.path\n    if authority.bytes().len() > 0 && path.bytes().len() == 0 -> path = \"/\"\n    path_text :: if scheme == \"data\" -> path else -> encode_component(path, true, false)\n    query_text := \"\"\n    if url.query.bytes().len() > 0 -> query_text = \"?{{url.query}}\"\n    fragment_text := \"\"\n    if url.fragment.bytes().len() > 0 -> fragment_text = \"#{{percent_encode(url.fragment)}}\"\n    if authority.bytes().len() > 0 -> return \"{{scheme}}://{{authority}}{{path_text}}{{query_text}}{{fragment_text}}\"\n    if scheme == \"file\" -> return \"file://{{path_text}}{{query_text}}{{fragment_text}}\"\n    return \"{{scheme}}:{{path_text}}{{query_text}}{{fragment_text}}\"\n}}\n\npub fn urljoin(base: String, rel: String) -> String URLError! {{\n    parsed :: parse(base)\n    joined :: join_url(parsed, rel)\n    unparse(joined)\n}}\n\nfn join_url(parsed: URL, rel: String) -> URL URLError! {{\n    if rel.bytes().len() == 0 -> return with_parts(parsed, parsed.path, parsed.query, parsed.fragment)\n    if has_scheme(rel) -> return parse(rel)\n    if starts(rel, \"//\") -> return parse(\"{{parsed.scheme}}:{{rel}}\")\n    if rel.bytes()[0] == (U8{{35}}) {{\n        fragment :: percent_decode(slice(rel.bytes(), 1, rel.bytes().len())) ?? return Err(URLError.Percent)\n        return with_parts(parsed, parsed.path, parsed.query, fragment)\n    }}\n    if rel.bytes()[0] == (U8{{63}}) {{\n        query :: slice(rel.bytes(), 1, rel.bytes().len())\n        if !valid_percent(query) -> return Err(URLError.Percent)\n        return with_parts(parsed, parsed.path, escape_query(query), \"\")\n    }}\n    hash := index_of(rel.bytes(), 35)\n    rel_no_frag := if hash >= 0 -> slice(rel.bytes(), 0, hash) else -> rel\n    frag_raw := if hash >= 0 -> slice(rel.bytes(), hash + 1, rel.bytes().len()) else -> \"\"\n    frag :: percent_decode(frag_raw) ?? return Err(URLError.Percent)\n    qpos := index_of(rel_no_frag.bytes(), 63)\n    rel_path_raw := if qpos >= 0 -> slice(rel_no_frag.bytes(), 0, qpos) else -> rel_no_frag\n    rel_path :: percent_decode(rel_path_raw) ?? return Err(URLError.Percent)\n    rel_query := if qpos >= 0 -> slice(rel_no_frag.bytes(), qpos + 1, rel_no_frag.bytes().len()) else -> \"\"\n    if !valid_percent(rel_query) -> return Err(URLError.Percent)\n    path := parsed.path\n    query := parsed.query\n    if rel_path.bytes().len() == 0 {{\n        if qpos >= 0 -> query = escape_query(rel_query)\n    }} else if rel_path.bytes()[0] == (U8{{47}}) {{\n        path = normalize_path(rel_path, parsed.host.bytes().len() > 0)\n        query = escape_query(rel_query)\n    }} else {{\n        dir :: dirname_url(parsed.path)\n        path = normalize_path(\"{{dir}}{{rel_path}}\", parsed.host.bytes().len() > 0)\n        query = escape_query(rel_query)\n    }}\n    with_parts(parsed, path, query, frag)\n}}\n\nfn with_parts(url: URL, path: String, query: String, fragment: String) -> URL Never! {{\n    URL{{\n        scheme: url.scheme,\n        user_text: url.user_text,\n        password_text: url.password_text,\n        host: url.host,\n        port: url.port,\n        port_explicit: url.port_explicit,\n        path: path,\n        query: query,\n        fragment: fragment,\n        raw: \"\",\n    }}\n}}\n\nfn render_host(host: String) -> String Never! {{\n    if contains_byte(host, 58) && !starts(host, \"[\") -> return \"[{{host}}]\"\n    ~host\n}}\n\n// Percent-encode query bytes that RFC 3986 does not allow unescaped; existing\n// `%XX` escapes, sub-delimiters, `:`, `@`, `/`, and `?` are kept.\nfn escape_query(text: String) -> String Never! {{\n    out := [U8]{{}}\n    loop b in text.bytes() {{\n        n :: Int.from_u8(b)\n        if unreserved(b) || n == 37 || n == 33 || n == 36 || (n >= 38 && n <= 44) || n == 47 || n == 58 || n == 59 || n == 61 || n == 63 || n == 64 {{\n            &out.push(b)\n        }} else {{\n            &out.push(U8{{37}})\n            &out.push(hex_nibble(n /% 16))\n            &out.push(hex_nibble(n %% 16))\n        }}\n    }}\n    String.from_bytes(out) ?? \"\"\n}}\n\n// Lowercase-ASCII host to its ASCII form: labels with non-ASCII bytes become\n// `xn--` Punycode labels (RFC 3492). Malformed UTF-8 is left unchanged so the\n// host validator rejects or keeps it as before.\nfn host_to_ascii(host: String) -> String Never! {{\n    raw :: host.bytes()\n    ascii := true\n    loop b in raw {{\n        if Int.from_u8(b) >= 128 -> ascii = false\n    }}\n    if ascii -> return ~host\n    out := \"\"\n    start := 0\n    loop i in 0..<(raw.len() + 1) {{\n        if i == raw.len() || raw[i] == (U8{{46}}) {{\n            label :: slice(raw, start, i)\n            encoded := label\n            points :: utf8_points(label.bytes()) ?? return ~host\n            non_ascii := false\n            loop cp in points {{\n                if cp >= 128 -> non_ascii = true\n            }}\n            if non_ascii -> encoded = \"xn--{{punycode(points)}}\"\n            if i < raw.len() -> out = \"{{out}}{{encoded}}.\" else -> out = \"{{out}}{{encoded}}\"\n            start = i + 1\n        }}\n    }}\n    out\n}}\n\nfn utf8_points(raw: [U8]) -> [Int]? {{\n    out := [Int]{{}}\n    i := 0\n    loop i < raw.len() {{\n        b :: Int.from_u8(raw[i])\n        width := 1\n        cp := b\n        if b >= 240 {{\n            width = 4\n            cp = b & 7\n        }} else if b >= 224 {{\n            width = 3\n            cp = b & 15\n        }} else if b >= 192 {{\n            width = 2\n            cp = b & 31\n        }} else if b >= 128 {{\n            return None\n        }}\n        if i + width > raw.len() -> return None\n        loop k in 1..<width {{\n            next :: Int.from_u8(raw[i + k])\n            if next < 128 || next >= 192 -> return None\n            cp = cp * 64 + (next & 63)\n        }}\n        &out.push(cp)\n        i = i + width\n    }}\n    Val(out)\n}}\n\nfn punycode(points: [Int]) -> String Never! {{\n    out := [U8]{{}}\n    loop cp in points {{\n        if cp < 128 -> &out.push(U8{{cp}})\n    }}\n    basic :: out.len()\n    handled := basic\n    if basic > 0 && handled < points.len() -> &out.push(U8{{45}})\n    n := 128\n    delta := 0\n    bias := 72\n    loop handled < points.len() {{\n        m := -1\n        loop cp in points {{\n            if cp >= n && (m < 0 || cp < m) -> m = cp\n        }}\n        delta = delta + (m - n) * (handled + 1)\n        n = m\n        loop cp in points {{\n            if cp < n -> delta = delta + 1\n            if cp == n {{\n                q := delta\n                k := 36\n                loop {{\n                    t := k - bias\n                    if k <= bias -> t = 1\n                    if k >= bias + 26 -> t = 26\n                    if q < t -> break\n                    &out.push(punycode_digit(t + (q - t) %% (36 - t)))\n                    q = (q - t) /% (36 - t)\n                    k = k + 36\n                }}\n                &out.push(punycode_digit(q))\n                bias = punycode_adapt(delta, handled + 1, handled == basic)\n                delta = 0\n                handled = handled + 1\n            }}\n        }}\n        delta = delta + 1\n        n = n + 1\n    }}\n    String.from_bytes(out) ?? \"\"\n}}\n\nfn punycode_digit(d: Int) -> U8 Never! {{\n    if d < 26 -> return U8{{97 + d}}\n    U8{{22 + d}}\n}}\n\nfn punycode_adapt(delta_in: Int, points: Int, first: Bool) -> Int Never! {{\n    delta := if first -> delta_in /% 700 else -> delta_in /% 2\n    delta = delta + delta /% points\n    k := 0\n    loop delta > 455 {{\n        delta = delta /% 35\n        k = k + 36\n    }}\n    k + (36 * delta) /% (delta + 38)\n}}\n\npub fn parse_qsl(query: String) -> [[String]] URLError! {{\n    rows := [[String]]{{}}\n    raw :: query.bytes()\n    if raw.len() == 0 -> return rows\n    start := 0\n    if raw[0] == (U8{{63}}) -> start = 1\n    i := start\n    loop i <= raw.len() {{\n        if i == raw.len() || raw[i] == (U8{{38}}) {{\n            piece :: slice(raw, start, i)\n            if piece.bytes().len() > 0 {{\n                eq :: index_of(piece.bytes(), 61)\n                if eq >= 0 {{\n                    k :: form_percent_decode(slice(piece.bytes(), 0, eq))\n                    v :: form_percent_decode(slice(piece.bytes(), eq + 1, piece.bytes().len()))\n                    &rows.push([String]{{k, v}})\n                }} else {{\n                    &rows.push([String]{{form_percent_decode(piece), \"\"}})\n                }}\n            }}\n            start = i + 1\n        }}\n        i = i + 1\n    }}\n    rows\n}}\n\npub fn urlencode(pairs: [[String]]) -> String Never! {{ encode_query(pairs) }}\n\npub fn split_fragment(url: String) -> (fragment: String, url: String) Never! {{\n    raw :: url.bytes()\n    i := index_of(raw, 35)\n    if i < 0 -> return (fragment: \"\", url: url)\n    (fragment: slice(raw, i + 1, raw.len()), url: slice(raw, 0, i))\n}}\n\npub fn quote(text: String) -> String Never! {{ encode_component(text, true, false) }}\npub fn quote_from_bytes(data: [U8]) -> String Never! {{ encode_component(String.from_bytes(data) ?? \"\", true, false) }}\npub fn quote_plus(text: String) -> String Never! {{ encode_component(text, false, true) }}\npub fn unquote(text: String) -> String URLError! {{ percent_decode(text) }}\n\npub fn unquote_to_bytes(text: String) -> [U8] URLError! {{\n    decoded :: percent_decode(text)\n    decoded.bytes()\n}}\n\npub fn unquote_plus(text: String) -> String URLError! {{\n    percent_decode(form_to_percent(text))\n}}\n\npub fn urlparse(text: String) -> URL URLError! {{ parse(text) }}\npub fn urlsplit(text: String) -> URL URLError! {{ parse(text) }}\npub fn urlunparse(url: URL) -> String Never! {{ unparse(url) }}\npub fn urlunsplit(url: URL) -> String Never! {{ unparse(url) }}\n\npub fn urldefrag(text: String) -> (url: String, fragment: String) Never! {{\n    raw :: text.bytes()\n    i := index_of(raw, 35)\n    if i < 0 -> return (url: text, fragment: \"\")\n    (url: slice(raw, 0, i), fragment: slice(raw, i + 1, raw.len()))\n}}\n\npub fn parse_qs(query: String) -> [[String]] URLError! {{ parse_qsl(query) }}\n\nfn encode_component(text: String, allow_slash: Bool, plus_space: Bool) -> String Never! {{\n    out := [U8]{{}}\n    loop b in text.bytes() {{\n        n :: Int.from_u8(b)\n        if plus_space && n == 32 -> &out.push(U8{{43}})\n        else if unreserved(b) || (allow_slash && n == 47) -> &out.push(b)\n        else {{\n            &out.push(U8{{37}})\n            &out.push(hex_nibble(n /% 16))\n            &out.push(hex_nibble(n %% 16))\n        }}\n    }}\n    String.from_bytes(out) ?? \"\"\n}}\n\nfn form_to_percent(text: String) -> String Never! {{\n    out := [U8]{{}}\n    loop b in text.bytes() {{\n        if b == (U8{{43}}) {{\n            &out.push(U8{{37}})\n            &out.push(U8{{50}})\n            &out.push(U8{{48}})\n        }} else {{\n            &out.push(b)\n        }}\n    }}\n    String.from_bytes(out) ?? \"\"\n}}\n\nfn form_percent_decode(text: String) -> String URLError! {{\n    percent_decode(form_to_percent(text))\n}}\n\nfn unreserved(b: U8) -> Bool Never! {{\n    n :: Int.from_u8(b)\n    if n >= 65 && n <= 90 -> return true\n    if n >= 97 && n <= 122 -> return true\n    if n >= 48 && n <= 57 -> return true\n    n == 45 || n == 46 || n == 95 || n == 126\n}}\n\nfn hex_nibble(n: Int) -> U8 Never! {{\n    if n < 10 -> return U8{{48 + n}}\n    return U8{{65 + n - 10}}\n}}\n\nfn hex_value(b: U8) -> Int? {{\n    n :: Int.from_u8(b)\n    if n >= 48 && n <= 57 -> return Val(n - 48)\n    if n >= 65 && n <= 70 -> return Val(n - 55)\n    if n >= 97 && n <= 102 -> return Val(n - 87)\n    None\n}}\n\nfn ascii_lower(text: String) -> String Never! {{\n    out := [U8]{{}}\n    loop b in text.bytes() {{\n        n :: Int.from_u8(b)\n        if n >= 65 && n <= 90 -> &out.push(U8{{n + 32}}) else -> &out.push(b)\n    }}\n    String.from_bytes(out) ?? \"\"\n}}\n\nfn valid_scheme(text: String) -> Bool Never! {{\n    raw :: text.bytes()\n    if raw.len() == 0 -> return false\n    first :: Int.from_u8(raw[0])\n    if !((first >= 65 && first <= 90) || (first >= 97 && first <= 122)) -> return false\n    i := 1\n    loop i < raw.len() {{\n        n :: Int.from_u8(raw[i])\n        if !((n >= 65 && n <= 90) || (n >= 97 && n <= 122) || (n >= 48 && n <= 57) || n == 43 || n == 45 || n == 46) -> return false\n        i = i + 1\n    }}\n    true\n}}\n\nfn scheme_colon(raw: [U8]) -> Int Never! {{\n    i := 0\n    loop i < raw.len() {{\n        n :: Int.from_u8(raw[i])\n        if n == 58 -> return i\n        if n == 47 || n == 63 || n == 35 -> return -1\n        i = i + 1\n    }}\n    -1\n}}\n\nfn has_scheme(text: String) -> Bool Never! {{ scheme_colon(text.bytes()) > 0 }}\n\nfn parse_port(text: String) -> Int? {{\n    raw :: text.bytes()\n    if raw.len() == 0 -> return None\n    n := 0\n    loop b in raw {{\n        d :: Int.from_u8(b)\n        if d < 48 || d > 57 -> return None\n        n = n * 10 + d - 48\n        if n > 65535 -> return None\n    }}\n    Val(n)\n}}\n\nfn trim_ascii(text: String) -> String Never! {{\n    raw :: text.bytes()\n    start := 0\n    end := raw.len()\n    loop start < end {{\n        n :: Int.from_u8(raw[start])\n        if n == 32 || n == 9 || n == 10 || n == 13 -> start = start + 1 else -> break\n    }}\n    loop end > start {{\n        n :: Int.from_u8(raw[end - 1])\n        if n == 32 || n == 9 || n == 10 || n == 13 -> end = end - 1 else -> break\n    }}\n    if end <= start -> return \"\"\n    slice(raw, start, end)\n}}\n\nfn valid_percent(text: String) -> Bool Never! {{\n    raw :: text.bytes()\n    i := 0\n    loop i < raw.len() {{\n        if raw[i] == (U8{{37}}) {{\n            if i + 2 >= raw.len() || !is_hex_byte(raw[i + 1]) || !is_hex_byte(raw[i + 2]) -> return false\n            i = i + 3\n        }} else {{\n            i = i + 1\n        }}\n    }}\n    true\n}}\n\nfn valid_url_host(host: String) -> Bool Never! {{\n    raw :: host.bytes()\n    if raw.len() == 0 -> return false\n    label := 0\n    non_dot := false\n    i := 0\n    loop i < raw.len() {{\n        n :: Int.from_u8(raw[i])\n        if n == 46 {{\n            if label == 0 && i < raw.len() - 1 -> return false\n            label = 0\n        }} else {{\n            if n <= 32 || n == 127 || n == 47 || n == 63 || n == 35 || n == 64 || n == 91 || n == 93 -> return false\n            label = label + 1\n            if label > 63 -> return false\n            non_dot = true\n        }}\n        i = i + 1\n    }}\n    if !non_dot -> return false\n    if label == 0 && raw[raw.len() - 1] != (U8{{46}}) -> return false\n    true\n}}\n\nfn is_hex_byte(b: U8) -> Bool Never! {{\n    n :: Int.from_u8(b)\n    (n >= 48 && n <= 57) || (n >= 65 && n <= 70) || (n >= 97 && n <= 102)\n}}\n\nfn normalize_path(path: String, absolute: Bool) -> String Never! {{\n    raw :: path.bytes()\n    segments := [String]{{}}\n    start := 0\n    i := 0\n    loop i <= raw.len() {{\n        if i == raw.len() || raw[i] == (U8{{47}}) {{\n            segment :: slice(raw, start, i)\n            if segment == \"..\" {{\n                if segments.len() > 0 && segments[segments.len() - 1] != \"..\" {{\n                    _ :: &segments.pop()\n                }} else if !absolute {{\n                    &segments.push(\"..\")\n                }}\n            }} else if segment != \"\" && segment != \".\" {{\n                &segments.push(segment)\n            }}\n            start = i + 1\n        }}\n        i = i + 1\n    }}\n    out := \"\"\n    if absolute -> out = \"/\"\n    loop segment in segments {{\n        if out.bytes().len() > 0 && out.bytes()[out.bytes().len() - 1] != (U8{{47}}) -> out = \"{{out}}/\"\n        out = \"{{out}}{{segment}}\"\n    }}\n    if path.bytes().len() > 0 && path.bytes()[path.bytes().len() - 1] == (U8{{47}}) && out.bytes().len() > 0 && out.bytes()[out.bytes().len() - 1] != (U8{{47}}) -> out = \"{{out}}/\"\n    if out.bytes().len() == 0 && absolute -> return \"/\"\n    out\n}}\n\nfn dirname_url(path: String) -> String Never! {{\n    raw :: path.bytes()\n    if raw.len() == 0 -> return \"/\"\n    i := raw.len()\n    loop i > 0 {{\n        i = i - 1\n        if raw[i] == (U8{{47}}) -> return slice(raw, 0, i + 1)\n    }}\n    \"/\"\n}}\n\nfn contains_byte(text: String, needle: Int) -> Bool Never! {{\n    loop b in text.bytes() {{\n        if Int.from_u8(b) == needle -> return true\n    }}\n    false\n}}\n\nfn starts(text: String, prefix: String) -> Bool Never! {{\n    a :: text.bytes()\n    b :: prefix.bytes()\n    if b.len() > a.len() -> return false\n    loop i in 0..<b.len() {{\n        if a[i] != b[i] -> return false\n    }}\n    true\n}}\n\nfn index_of(raw: [U8], b: Int) -> Int Never! {{\n    loop i in 0..<raw.len() {{\n        if Int.from_u8(raw[i]) == b -> return i\n    }}\n    -1\n}}\n\nfn last_index(raw: [U8], b: Int) -> Int Never! {{\n    i := raw.len() - 1\n    loop i >= 0 {{\n        if Int.from_u8(raw[i]) == b -> return i\n        i = i - 1\n    }}\n    -1\n}}\n\nfn slice(raw: [U8], start: Int, end: Int) -> String Never! {{\n    String.from_bytes(slice_bytes(raw, start, end)) ?? \"\"\n}}\n\nfn slice_bytes(raw: [U8], start: Int, end: Int) -> [U8] Never! {{\n    out := [U8]{{}}\n    limit := if end < raw.len() -> end else -> raw.len()\n    if start < 0 || start >= limit -> return out\n    loop i in start..<limit -> &out.push(raw[i])\n    out\n}}\n"}
}

fn foundation_embedded_core_source_64() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.net.ws", alias: "core_core_net_ws", path: "Core/net/ws.jet", owner: "", owned_members: [String]{"connect", "upgrade"}, source: "use core as core\nuse core.net.url as url\n#Error\npub enum WsError {{\n    InvalidURL\n    InvalidHandshake\n    Protocol\n    Timeout\n    Closed\n    Cancelled\n    UnsupportedTarget\n    MessageTooLarge(limit: Int)\n    IO(operation: String)\n}}\n\n// The provider owns socket I/O, entropy, and frame codec. Jet validates the\n// URL and handshake shape before crossing the typed boundary.\npub fn connect(url_text: String) -[Net]> WsConn WsError! {{\n    parsed :: url.parse(url_text) ?? return Err(WsError.InvalidURL)\n    if parsed.scheme != \"ws\" -> return Err(WsError.UnsupportedTarget)\n    if parsed.host.bytes().len() == 0 || parsed.userinfo().bytes().len() > 0 {{\n        return Err(WsError.InvalidURL)\n    }}\n    fragment := parsed.fragment\n    if fragment.bytes().len() > 0 -> return Err(WsError.InvalidURL)\n    core.net.ws.connect(url.unparse(parsed))\n}}\n\npub fn upgrade(request: HTTPRequest) -[Net]> WsConn WsError! {{\n    if request.method() != \"GET\" -> return Err(WsError.InvalidHandshake)\n    upgrade_header :: &request.header(\"upgrade\") ?? return Err(WsError.InvalidHandshake)\n    if !header_has_token(upgrade_header, \"websocket\") -> return Err(WsError.InvalidHandshake)\n    connection_header :: &request.header(\"connection\") ?? return Err(WsError.InvalidHandshake)\n    if !header_has_token(connection_header, \"upgrade\") -> return Err(WsError.InvalidHandshake)\n    version :: &request.header(\"sec-websocket-version\") ?? return Err(WsError.InvalidHandshake)\n    if trim_ascii(version) != \"13\" -> return Err(WsError.InvalidHandshake)\n    key :: &request.header(\"sec-websocket-key\") ?? return Err(WsError.InvalidHandshake)\n    if key.bytes().len() == 0 || key.bytes().len() > 256 -> return Err(WsError.InvalidHandshake)\n    core.net.ws.upgrade(request)\n}}\n\nfn header_has_token(value: String, wanted: String) -> Bool Never! {{\n    raw :: ascii_lower(value).bytes()\n    target :: ascii_lower(wanted)\n    start := 0\n    i := 0\n    loop i <= raw.len() {{\n        if i == raw.len() || raw[i] == (U8{{44}}) {{\n            piece :: trim_ascii(slice(raw, start, i))\n            if piece == target -> return true\n            start = i + 1\n        }}\n        i = i + 1\n    }}\n    false\n}}\n\nfn trim_ascii(text: String) -> String Never! {{\n    raw :: text.bytes()\n    start := 0\n    end := raw.len()\n    loop start < end {{\n        n :: Int.from_u8(raw[start])\n        if n == 32 || n == 9 || n == 10 || n == 13 -> start = start + 1 else -> break\n    }}\n    loop end > start {{\n        n :: Int.from_u8(raw[end - 1])\n        if n == 32 || n == 9 || n == 10 || n == 13 -> end = end - 1 else -> break\n    }}\n    if end <= start -> return \"\"\n    slice(raw, start, end)\n}}\n\nfn ascii_lower(text: String) -> String Never! {{\n    out := [U8]{{}}\n    loop b in text.bytes() {{\n        n :: Int.from_u8(b)\n        if n >= 65 && n <= 90 -> &out.push(U8{{n + 32}}) else -> &out.push(b)\n    }}\n    String.from_bytes(out) ?? \"\"\n}}\n\nfn slice(raw: [U8], start: Int, end: Int) -> String Never! {{\n    out := [U8]{{}}\n    i := start\n    loop {{\n        if i >= end -> return String.from_bytes(out) ?? \"\"\n        &out.push(raw[i])\n        i = i + 1\n    }}\n}}\n\n"}
}

fn foundation_embedded_core_source_65() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.net.ip", alias: "core_core_net_ip", path: "Core/net/ip.jet", owner: "", owned_members: [String]{"ipv4", "ipv4_from_int", "ipv4_int", "ipv4_to_string", "ipv6_is_link_local", "ipv6_is_loopback", "ipv6_is_unspecified", "ipv6_to_string", "is_global", "is_link_local", "is_loopback", "is_multicast", "is_private", "is_reserved", "is_unspecified", "network", "network_broadcast", "network_contains", "network_hosts", "parse_ipv4", "parse_ipv6", "packed_ipv4", "from_packed_ipv4", "reverse_pointer", "with_prefixlen", "with_netmask", "with_hostmask", "num_addresses", "network_first", "network_last", "network_overlaps", "subnet_of", "supernet_of", "supernet", "subnets", "hosts", "interface", "is_carrier_grade_nat", "is_benchmarking", "is_documentation", "is_shared", "ipv6_is_multicast", "ipv6_is_private", "ipv6_is_global", "ipv6_packed", "ipv6_compressed", "compare_ipv4", "ipv4_equals"}, source: "package {{\n    name: \"core.net.ip\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"core.net.ip core library.\"\n    license: \"MIT\"\n    outputs: {{\n        ip: .Library{{ entry: ip }}\n    }}\n}}\n// core.net.ip — IPv4/IPv6 addresses and CIDR networks.\n//\n// Python `ipaddress` is the bar: parse, classify, and ask whether a host\n// sits in a network. IPv6 parsing accepts compressed `::` form. Invalid\n// input is `IOError` so callers share the `core.net` error type.\npub struct IPv4 {{\n    pub a: Int\n    pub b: Int\n    pub c: Int\n    pub d: Int\n}}\n\npub struct IPv6 {{\n    pub words: [Int]\n}}\n\npub struct Network {{\n    pub addr: IPv4\n    pub prefix: Int\n}}\n\npub fn ipv4(a: Int, b: Int, c: Int, d: Int) -> IPv4 IOError! {{\n    if a < 0 || a > 255 || b < 0 || b > 255 || c < 0 || c > 255 || d < 0 || d > 255 {{\n        return Err(net_err(\"octet out of range\"))\n    }}\n    Ok(IPv4{{a: a, b: b, c: c, d: d}})\n}}\n\npub fn parse_ipv4(text: String) -> IPv4 IOError! {{\n    parts := split_dot(text)\n    if parts.len() != 4 -> return Err(net_err(\"IPv4 needs four dotted octets\"))\n    a :: parse_oct(parts[0]) ?? return Err(net_err(\"bad IPv4 octet\"))\n    b :: parse_oct(parts[1]) ?? return Err(net_err(\"bad IPv4 octet\"))\n    c :: parse_oct(parts[2]) ?? return Err(net_err(\"bad IPv4 octet\"))\n    d :: parse_oct(parts[3]) ?? return Err(net_err(\"bad IPv4 octet\"))\n    ipv4(a, b, c, d)\n}}\n\npub fn ipv4_to_string(addr: IPv4) -> String Never! {{ \"{{addr.a}}.{{addr.b}}.{{addr.c}}.{{addr.d}}\" }}\n\npub fn ipv4_int(addr: IPv4) -> Int Never! {{ ((addr.a * 256 + addr.b) * 256 + addr.c) * 256 + addr.d }}\n\npub fn ipv4_from_int(n: Int) -> IPv4 IOError! {{\n    if n < 0 || n > 4294967295 -> return Err(net_err(\"IPv4 integer out of range\"))\n    d :: n %% 256\n    c :: (n /% 256) %% 256\n    b :: (n /% 65536) %% 256\n    a :: (n /% 16777216) %% 256\n    ipv4(a, b, c, d)\n}}\n\npub fn is_private(addr: IPv4) -> Bool Never! {{\n    if addr.a == 10 -> return true\n    if addr.a == 192 && addr.b == 168 -> return true\n    if addr.a == 172 && addr.b >= 16 && addr.b <= 31 -> return true\n    false\n}}\n\npub fn is_loopback(addr: IPv4) -> Bool Never! {{ addr.a == 127 }}\n\npub fn is_link_local(addr: IPv4) -> Bool Never! {{ addr.a == 169 && addr.b == 254 }}\n\npub fn is_multicast(addr: IPv4) -> Bool Never! {{ addr.a >= 224 && addr.a <= 239 }}\n\npub fn is_reserved(addr: IPv4) -> Bool Never! {{ addr.a == 240 || addr.a == 0 }}\n\npub fn is_unspecified(addr: IPv4) -> Bool Never! {{\n    addr.a == 0 && addr.b == 0 && addr.c == 0 && addr.d == 0\n}}\n\npub fn is_global(addr: IPv4) -> Bool Never! {{\n    !is_private(addr) && !is_loopback(addr) && !is_link_local(addr) && !is_multicast(addr) && !is_reserved(addr) && !is_unspecified(addr)\n}}\n\npub fn network(cidr: String) -> Network IOError! {{\n    slash := -1\n    raw :: cidr.bytes()\n    loop i in 0..<raw.len() {{\n        if raw[i] == (U8{{47}}) {{\n            if slash >= 0 -> return Err(net_err(\"CIDR may contain only one prefix slash\"))\n            slash = i\n        }}\n    }}\n    if slash < 0 -> return Err(net_err(\"CIDR needs prefix /n\"))\n    host :: String.from_bytes(slice_u(raw, 0, slash)) ?? \"\"\n    pref :: parse_int(String.from_bytes(slice_u(raw, slash + 1, raw.len())) ?? \"\") ?? return Err(net_err(\"bad prefix\"))\n    if pref < 0 || pref > 32 -> return Err(net_err(\"prefix must be 0..=32\"))\n    addr :: parse_ipv4(host) ?? return Err(net_err(\"bad IPv4 address\"))\n    masked :: ipv4_from_int(ipv4_int(addr) & prefix_mask(pref)) ?? return Err(net_err(\"bad network address\"))\n    Ok(Network{{addr: masked, prefix: pref}})\n}}\n\npub fn network_contains(net: Network, addr: IPv4) -> Bool Never! {{\n    if net.prefix < 0 || net.prefix > 32 -> return false\n    mask :: prefix_mask(net.prefix)\n    (ipv4_int(addr) & mask) == (ipv4_int(net.addr) & mask)\n}}\n\npub fn network_broadcast(net: Network) -> IPv4 Never! {{\n    if net.prefix < 0 || net.prefix > 32 -> return net.addr\n    mask :: prefix_mask(net.prefix)\n    bcast :: (ipv4_int(net.addr) & mask) | (4294967295 - mask)\n    ipv4_from_int(bcast) ?? net.addr\n}}\n\npub fn network_hosts(net: Network) -> Int Never! {{\n    if net.prefix < 0 || net.prefix > 32 || net.prefix >= 31 -> return 0\n    int_pow2(32 - net.prefix) - 2\n}}\n\npub fn parse_ipv6(text: String) -> IPv6 IOError! {{\n    raw :: text.bytes()\n    if raw.len() == 0 -> return Err(net_err(\"empty IPv6\"))\n    dbl := find_dcolon(text)\n    if dbl >= 0 {{\n        tail :: slice_u(raw, dbl + 2, raw.len())\n        if find_dcolon(String.from_bytes(tail) ?? \"\") >= 0 -> return Err(net_err(\"IPv6 may contain only one ::\"))\n    }}\n    left := String.from_bytes(raw) ?? \"\"\n    right := \"\"\n    compressed := dbl >= 0\n    if compressed {{\n        left = String.from_bytes(slice_u(raw, 0, dbl)) ?? \"\"\n        right = String.from_bytes(slice_u(raw, dbl + 2, raw.len())) ?? \"\"\n    }}\n    lw :: split_colon(left)\n    rw :: split_colon(right)\n    total :: lw.len() + rw.len()\n    if compressed {{\n        if total >= 8 -> return Err(net_err(\"IPv6 :: must replace at least one group\"))\n    }} else if total != 8 {{\n        return Err(net_err(\"IPv6 needs 8 groups or a ::\"))\n    }}\n    words := [Int]{{}}\n    loop w in lw {{\n        n :: parse_hex4(w) ?? return Err(net_err(\"bad IPv6 group\"))\n        &words.push(n)\n    }}\n    pad := 0\n    if compressed -> pad = 8 - total\n    loop pad > 0 {{\n        &words.push(0)\n        pad = pad - 1\n    }}\n    loop w in rw {{\n        n :: parse_hex4(w) ?? return Err(net_err(\"bad IPv6 group\"))\n        &words.push(n)\n    }}\n    if words.len() != 8 -> return Err(net_err(\"IPv6 needs 8 groups\"))\n    Ok(IPv6{{words: words}})\n}}\n\npub fn ipv6_to_string(addr: IPv6) -> String Never! {{\n    s := \"\"\n    i := 0\n    loop i < addr.words.len() {{\n        piece :: hex4(addr.words[i])\n        if i == 0 -> s = piece else -> s = \"{{s}}:{{piece}}\"\n        i = i + 1\n    }}\n    s\n}}\npub fn ipv6_is_loopback(addr: IPv6) -> Bool Never! {{\n    if addr.words.len() != 8 -> return false\n    i := 0\n    loop i < 7 {{\n        if addr.words[i] != 0 -> return false\n        i = i + 1\n    }}\n    addr.words[7] == 1\n}}\n\npub fn ipv6_is_unspecified(addr: IPv6) -> Bool Never! {{\n    if addr.words.len() != 8 -> return false\n    loop w in addr.words {{\n        if w != 0 -> return false\n    }}\n    true\n}}\n\npub fn ipv6_is_link_local(addr: IPv6) -> Bool Never! {{\n    addr.words.len() == 8 && addr.words[0] & 65472 == 65152\n}}\n\nfn prefix_mask(prefix: Int) -> Int Never! {{\n    if prefix <= 0 -> return 0\n    if prefix >= 32 -> return 4294967295\n    (int_pow2(prefix) - 1) * int_pow2(32 - prefix)\n}}\n\nfn int_pow2(n: Int) -> Int Never! {{\n    acc := 1\n    i := 0\n    loop i < n {{\n        acc = acc * 2\n        i = i + 1\n    }}\n    acc\n}}\n\nfn split_dot(text: String) -> [String] Never! {{ split_byte(text, 46) }}\n\nfn split_colon(text: String) -> [String] Never! {{\n    raw :: text.bytes()\n    if raw.len() == 0 -> return [String]{{}}\n    split_byte(String.from_bytes(raw) ?? \"\", 58)\n}}\nfn split_byte(text: String, code: Int) -> [String] Never! {{\n    raw :: text.bytes()\n    out := [String]{{}}\n    start := 0\n    i := 0\n    loop i <= raw.len() {{\n        n := 0\n        if i < raw.len() -> n = Int.from_u8(raw[i])\n        if i == raw.len() || n == code {{\n            &out.push(String.from_bytes(slice_u(raw, start, i)) ?? \"\")\n            start = i + 1\n        }}\n        i = i + 1\n    }}\n    out\n}}\n\nfn parse_oct(text: String) -> Int? {{\n    raw :: text.bytes()\n    if raw.len() == 0 || raw.len() > 3 -> return None\n    if raw.len() > 1 && raw[0] == (U8{{48}}) -> return None\n    n := 0\n    loop b in raw {{\n        d :: Int.from_u8(b)\n        if d < 48 || d > 57 -> return None\n        n = n * 10 + (d - 48)\n        if n > 255 -> return None\n    }}\n    Val(n)\n}}\n\nfn parse_int(text: String) -> Int? {{\n    raw :: text.bytes()\n    if raw.len() == 0 -> return None\n    n := 0\n    loop b in raw {{\n        d :: Int.from_u8(b)\n        if d < 48 || d > 57 -> return None\n        digit :: d - 48\n        if n > (9223372036854775807 - digit) /% 10 -> return None\n        n = n * 10 + digit\n    }}\n    Val(n)\n}}\n\nfn parse_hex4(text: String) -> Int? {{\n    raw :: text.bytes()\n    if raw.len() == 0 || raw.len() > 4 -> return None\n    n := 0\n    loop b in raw {{\n        d :: hex_val(b)\n        if d < 0 -> return None\n        n = n * 16 + d\n    }}\n    Val(n)\n}}\n\nfn hex_val(b: U8) -> Int Never! {{\n    n :: Int.from_u8(b)\n    if n >= 48 && n <= 57 -> return n - 48\n    if n >= 65 && n <= 70 -> return n - 55\n    if n >= 97 && n <= 102 -> return n - 87\n    return -1\n}}\n\nfn hex4(n: Int) -> String {{\n    v := n\n    if v < 0 -> v = 0\n    out := [U8]{{}}\n    shift := 12\n    loop shift >= 0 {{\n        d :: (v /% int_pow2(shift)) %% 16\n        if d < 10 -> &out.push(U8{{48 + d}}) else -> &out.push(U8{{97 + (d - 10)}})\n        shift = shift - 4\n    }}\n    String.from_bytes(out) ?? \"0000\"\n}}\n\nfn find_dcolon(text: String) -> Int Never! {{\n    raw :: text.bytes()\n    if raw.len() < 2 -> return -1\n    i := 0\n    loop i + 1 < raw.len() {{\n        if raw[i] == (U8{{58}}) && raw[i + 1] == (U8{{58}}) -> return i\n        i = i + 1\n    }}\n    -1\n}}\n\nfn slice_u(raw: [U8], start: Int, end: Int) -> [U8] Never! {{\n    out := [U8]{{}}\n    limit := if end < raw.len() -> end else -> raw.len()\n    if start < 0 || start >= limit -> return out\n    loop i in start..<limit -> &out.push(raw[i])\n    out\n}}\n\nfn slice_str(text: String, start: Int, end: Int) -> String Never! {{\n    String.from_bytes(slice_u(text.bytes(), start, end)) ?? \"\"\n}}\n\nfn net_err(message: String) -> IOError Never! {{\n    IOError.InvalidInput(IOContext{{\n        operation: .Resolve,\n        resource: None,\n        os_code: None,\n        cause: Val(message),\n    }})\n}}\n\npub struct IPv4Interface {{\n    pub addr: IPv4\n    pub network: Network\n}}\n\npub fn packed_ipv4(addr: IPv4) -> [U8] Never! {{\n    [U8]{{(U8{{addr.a}}), (U8{{addr.b}}), (U8{{addr.c}}), (U8{{addr.d}})}}\n}}\n\npub fn from_packed_ipv4(bytes: [U8]) -> IPv4 IOError! {{\n    if bytes.len() != 4 -> return Err(net_err(\"IPv4 packed needs 4 bytes\"))\n    ipv4(Int.from_u8(bytes[0]), Int.from_u8(bytes[1]), Int.from_u8(bytes[2]), Int.from_u8(bytes[3]))\n}}\n\npub fn reverse_pointer(addr: IPv4) -> String Never! {{ \"{{addr.d}}.{{addr.c}}.{{addr.b}}.{{addr.a}}.in-addr.arpa\" }}\n\npub fn with_prefixlen(net: Network) -> String Never! {{ return \"{{ipv4_to_string(net.addr)}}/{{net.prefix}}\" }}\n\npub fn with_netmask(net: Network) -> String Never! {{\n    mask :: ipv4_from_int(prefix_mask(net.prefix)) ?? net.addr\n    return \"{{ipv4_to_string(net.addr)}}/{{ipv4_to_string(mask)}}\"\n}}\n\npub fn with_hostmask(net: Network) -> String Never! {{\n    host :: ipv4_from_int(4294967295 - prefix_mask(net.prefix)) ?? net.addr\n    return \"{{ipv4_to_string(net.addr)}}/{{ipv4_to_string(host)}}\"\n}}\n\npub fn num_addresses(net: Network) -> Int Never! {{\n    if net.prefix < 0 || net.prefix > 32 -> return 0\n    int_pow2(32 - net.prefix)\n}}\npub fn network_first(net: Network) -> IPv4 Never! {{ net.addr }}\n\npub fn network_last(net: Network) -> IPv4 Never! {{ network_broadcast(net) }}\n\npub fn network_overlaps(a: Network, b: Network) -> Bool Never! {{\n    network_contains(a, b.addr) || network_contains(b, a.addr)\n}}\n\npub fn subnet_of(inner: Network, outer: Network) -> Bool Never! {{\n    if inner.prefix < outer.prefix -> return false\n    network_contains(outer, inner.addr)\n}}\n\npub fn supernet_of(outer: Network, inner: Network) -> Bool Never! {{ subnet_of(inner, outer) }}\n\npub fn supernet(net: Network) -> Network Never! {{\n    p := net.prefix - 1\n    if p < 0 -> p = 0\n    masked :: ipv4_from_int(ipv4_int(net.addr) & prefix_mask(p)) ?? net.addr\n    {{addr: masked, prefix: p}}\n}}\n\npub fn subnets(net: Network, new_prefix: Int) -> [Network] Never! {{\n    out := [Network]{{}}\n    if net.prefix < 0 || net.prefix > 32 || new_prefix <= net.prefix || new_prefix > 32 -> return out\n    step :: int_pow2(32 - new_prefix)\n    start :: ipv4_int(net.addr)\n    end :: start + int_pow2(32 - net.prefix)\n    n := start\n    loop n < end {{\n        addr :: ipv4_from_int(n) ?? net.addr\n        &out.push(Network{{addr: addr, prefix: new_prefix}})\n        n = n + step\n    }}\n    out\n}}\n\npub fn hosts(net: Network) -> [IPv4] Never! {{\n    out := [IPv4]{{}}\n    if net.prefix < 0 || net.prefix > 32 -> return out\n    if net.prefix >= 31 {{\n        &out.push(net.addr)\n        if net.prefix == 31 -> &out.push(network_broadcast(net))\n        return out\n    }}\n    start :: ipv4_int(net.addr) + 1\n    stop :: ipv4_int(network_broadcast(net))\n    n := start\n    loop n < stop {{\n        &out.push(ipv4_from_int(n) ?? net.addr)\n        n = n + 1\n    }}\n    out\n}}\n\npub fn interface(text: String) -> IPv4Interface IOError! {{\n    network_value :: network(~text) ?? return Err(net_err(\"invalid interface network\"))\n    slash := -1\n    raw :: (~text).bytes()\n    loop i in 0..<raw.len() {{\n        if raw[i] == (U8{{47}}) {{\n            slash = i\n            break\n        }}\n    }}\n    host := text\n    if slash >= 0 -> host = slice_str(~text, 0, slash)\n    addr :: parse_ipv4(host) ?? return Err(net_err(\"invalid interface address\"))\n    Ok(IPv4Interface{{addr: addr, network: network_value}})\n}}\n\npub fn is_carrier_grade_nat(addr: IPv4) -> Bool Never! {{ addr.a == 100 && addr.b >= 64 && addr.b <= 127 }}\n\npub fn is_benchmarking(addr: IPv4) -> Bool Never! {{ addr.a == 198 && (addr.b == 18 || addr.b == 19) }}\n\npub fn is_documentation(addr: IPv4) -> Bool Never! {{\n    if addr.a == 192 && addr.b == 0 && addr.c == 2 -> return true\n    if addr.a == 198 && addr.b == 51 && addr.c == 100 -> return true\n    if addr.a == 203 && addr.b == 0 && addr.c == 113 -> return true\n    false\n}}\n\npub fn is_shared(addr: IPv4) -> Bool Never! {{ is_carrier_grade_nat(addr) }}\n\npub fn ipv6_is_multicast(addr: IPv6) -> Bool Never! {{\n    addr.words.len() == 8 && addr.words[0] & 65280 == 65280\n}}\n\npub fn ipv6_is_private(addr: IPv6) -> Bool Never! {{\n    // Unique-local addresses are fc00::/7.\n    addr.words.len() == 8 && addr.words[0] & 65024 == 64512\n}}\n\npub fn ipv6_is_global(addr: IPv6) -> Bool Never! {{\n    !ipv6_is_loopback(addr) && !ipv6_is_unspecified(addr) && !ipv6_is_link_local(addr) && !ipv6_is_multicast(addr) && !ipv6_is_private(addr)\n}}\n\npub fn ipv6_packed(addr: IPv6) -> [U8] Never! {{\n    if addr.words.len() != 8 -> return [U8]{{}}\n    out := [U8]{{}}\n    loop w in addr.words {{\n        &out.push(to_u8((w /% 256) %% 256))\n        &out.push(to_u8(w %% 256))\n    }}\n    out\n}}\n\nfn to_u8(n: Int) -> U8 Never! {{\n    v :: n & 255\n    (U8{{v}})\n}}\n\npub fn ipv6_compressed(addr: IPv6) -> String Never! {{\n    if addr.words.len() != 8 -> return ipv6_to_string(addr)\n    best_i := -1\n    best_n := 0\n    i := 0\n    loop i < 8 {{\n        if addr.words[i] == 0 {{\n            j := i\n            loop j < 8 && addr.words[j] == 0 -> j = j + 1\n            n :: j - i\n            if n > best_n {{\n                best_i = i\n                best_n = n\n            }}\n            i = j\n        }} else {{\n            i = i + 1\n        }}\n    }}\n    if best_n < 2 -> return ipv6_to_string(addr)\n    s := \"\"\n    i = 0\n    loop i < 8 {{\n        if i == best_i {{\n            if s.bytes().len() == 0 -> s = \"::\" else -> s = \"{{s}}::\"\n            i = i + best_n\n            next\n        }}\n        if s.bytes().len() > 0 && !ends_colon_str(s) -> s = \"{{s}}:\"\n        s = \"{{s}}{{hex_trim(addr.words[i])}}\"\n        i = i + 1\n    }}\n    s\n}}\n\npub fn compare_ipv4(a: IPv4, b: IPv4) -> Int Never! {{\n    na :: ipv4_int(a)\n    nb :: ipv4_int(b)\n    if na < nb -> return -1\n    if na > nb -> return 1\n    0\n}}\n\npub fn ipv4_equals(a: IPv4, b: IPv4) -> Bool Never! {{ ipv4_int(a) == ipv4_int(b) }}\n\nfn hex_trim(n: Int) -> String {{\n    v := n\n    if v < 0 -> v = 0\n    if v == 0 -> return \"0\"\n    out := [U8]{{}}\n    started := false\n    shift := 12\n    loop shift >= 0 {{\n        d :: (v /% int_pow2(shift)) %% 16\n        if d != 0 || started || shift == 0 {{\n            started = true\n            if d < 10 -> &out.push(U8{{48 + d}}) else -> &out.push(U8{{97 + (d - 10)}})\n        }}\n        shift = shift - 4\n    }}\n    result :: String.from_bytes(out) ?? \"0\"\n    return result\n}}\nfn ends_colon_str(text: String) -> Bool {{\n    found := false\n    loop b in text.bytes() {{\n        found = Int.from_u8(b) == 58\n    }}\n    return found\n}}\n"}
}

fn foundation_embedded_core_source_66() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.perf", alias: "core_core_perf", path: "Core/perf/perf.jet", owner: "", owned_members: [String]{"default_fidelity", "fidelity", "is_full", "is_low", "of", "override_fidelity", "reset_fidelity", "scale"}, source: "package {{\n    name: \"core.perf\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"Runtime fidelity signal.\"\n    license: \"MIT\"\n    outputs: {{\n        perf: .Library{{ entry: perf }}\n    }}\n}}\nuse core as core\n\n// core.perf — a process-global 0.0..=1.0 fidelity knob for adaptive work.\n// Values outside the unit interval are rejected with `PerfError.OutOfRange`.\n// The cell is host; clamp and defaulting are Jet.\npub struct Perf {{\n    pub fidelity: Float\n}}\n\n/// D-PERF-ERR1=A: the one way to set fidelity wrongly is a number outside\n/// 0.0..=1.0 (NaN included); the case carries the rejected number.\n#Error\npub enum PerfError {{\n    OutOfRange(Float)\n}}\n\npub fn fidelity() -[Env]> Float Never! {{ host_fidelity() }}\n\npub fn default_fidelity() -> Float Never! {{ 1.0 }}\n\npub fn override_fidelity(value: Float) PerfError! -[Env]> {{\n    if core.math.is_nan(value) || value < 0.0 || value > 1.0 -> return Err(PerfError.OutOfRange(value))\n    // The host applies the same range check, so an in-range value never fails there.\n    if core.perf.override_fidelity(value) == {{\n        .Ok(_) -> {{}}\n        .Err(_) -> return Err(PerfError.OutOfRange(value))\n    }}\n}}\n\npub fn reset_fidelity() Never! -[Env]> {{ core.perf.reset_fidelity() }}\n\nfn host_fidelity() -[Env]> Float {{ core.perf.fidelity() }}\n\npub fn of(fidelity: Float) -> Perf Never! {{\n    v := fidelity\n    if core.math.is_nan(v) -> v = 1.0\n    if v < 0.0 -> v = 0.0\n    if v > 1.0 -> v = 1.0\n    {{fidelity: v}}\n}}\n\npub fn is_full(perf: Perf) -> Bool Never! {{ perf.fidelity >= 1.0 }}\n\npub fn is_low(perf: Perf) -> Bool Never! {{ perf.fidelity < 0.25 }}\n\npub fn scale(perf: Perf, work: Int) -> Int Never! {{\n    n :: Int{{(Float{{work}}) * perf.fidelity}}\n    if n < 0 -> return 0\n    n\n}}\n"}
}

fn foundation_embedded_core_source_67() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.prelude", alias: "core_core_prelude", path: "Core/prelude/prelude.jet", owner: "", owned_members: [String]{"always", "const_bool", "const_int", "identity", "identity_bool", "identity_float", "identity_int", "keep", "max_int", "min_int", "not_bool"}, source: "package {{\n    name: \"core.prelude\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"Always-imported identity and scalar helpers.\"\n    license: \"MIT\"\n    outputs: {{\n        prelude: .Library{{ entry: prelude }}\n    }}\n}}\n\n// core.prelude contains only total value helpers.  `keep` is the compiler's\n// identity/use-site barrier; every other declaration is an ordinary Jet\n// function with the same value in and value out.\npub fn keep<T>(value: T) -> T Never! {{ value }}\n\npub fn identity(value: ^String) -> String Never! {{ value }}\n\npub fn always(value: Bool) -> Bool Never! {{ value }}\n\npub fn identity_int(value: Int) -> Int Never! {{ value }}\n\npub fn identity_float(value: Float) -> Float Never! {{ value }}\n\npub fn identity_bool(value: Bool) -> Bool Never! {{ value }}\n\npub fn const_int(value: Int, ignored: Int) -> Int Never! {{\n    _ :: ignored\n    value\n}}\n\npub fn const_bool(value: Bool, ignored: Bool) -> Bool Never! {{\n    _ :: ignored\n    value\n}}\n\npub fn not_bool(value: Bool) -> Bool Never! {{\n    if value -> return false\n    true\n}}\n\npub fn min_int(a: Int, b: Int) -> Int Never! {{\n    if a <= b -> return a\n    b\n}}\n\npub fn max_int(a: Int, b: Int) -> Int Never! {{\n    if a >= b -> return a\n    b\n}}\n"}
}

fn foundation_embedded_core_source_68() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.process", alias: "core_process", path: "Core/process/process.jet", owner: "", owned_members: [String]{"status_ok", "arg", "args", "args_extend", "argv", "call", "capture", "check", "check_call", "check_output", "cmd", "combined_output", "current_pid", "cwd", "env", "env_get", "env_get_or", "env_keys", "env_set", "env_truthy", "exit", "exited", "failed", "getoutput", "getstatusoutput", "list2cmdline", "on_signal", "pipeline", "run_spec", "shell", "signal_number", "stderr_lines", "stdin_text", "stdout_lines", "which"}, source: "\npackage {{\n    name: \"core.process\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"Process builders and receipt helpers.\"\n    license: \"MIT\"\n    outputs: {{\n        process: .Library{{ entry: process }}\n    }}\n}}\nuse core as core\nuse core.files as files\n\n\npub fn args() -[Exec.Args]> [String] Never! {{ core.process.args() }}\n\npub fn argv() -[Exec.Args]> [String] Never! {{ core.process.argv() }}\n\npub fn check(receipt: ProcessReceipt) IOError! {{\n    if receipt.success -> return Ok()\n    limit_hit :: receipt.limit_hit\n    if limit_hit == {{\n        .None -> {{ _ := 0 }}\n        .Val(limit) -> return Err(IOError.ResourceLimit(limit))\n        else -> {{ _ := 0 }}\n    }}\n    if receipt.timed_out {{\n        return Err(IOError.TimedOut(IOContext{{\n            operation: .Resolve,\n            resource: Val(receipt.executable_identity),\n            os_code: None,\n            cause: Val(\"process timed out\"),\n        }}))\n    }}\n    cause := \"process exited unsuccessfully: code={{receipt.code}}\"\n    signal :: ~receipt.signal\n    if signal == {{\n        .None -> {{ _ := 0 }}\n        .Val(number) -> cause = \"{{cause}}; signal={{number}}\"\n    }}\n    return Err(IOError.Other(IOContext{{\n        operation: .Resolve,\n        resource: Val(receipt.executable_identity),\n        os_code: None,\n        cause: Val(cause),\n    }}))\n}}\n\n\npub fn stdin_text(spec: ProcessSpec, text: String) IOError! -[Exec, Time.Wait]> {{\n    child :: spec.stdin(.Stream).spawn()\n    child.stdin.write(text)\n    child.stdin.close()\n    receipt :: child.wait()\n    check(receipt)\n}}\n\npub fn getoutput(spec: ProcessSpec) -[Exec, Time.Wait]> String IOError! {{\n    receipt :: spec.run()\n    receipt.output\n}}\n\npub fn getstatusoutput(spec: ProcessSpec) -[Exec, Time.Wait]> (status: Int, output: String) IOError! {{\n    receipt :: spec.run()\n    (status: receipt.code, output: combined_output(receipt))\n}}\n\npub fn shell(line: String) -[Exec, Env]> ProcessSpec Never! {{\n    if core.sys.family() == \"windows\" -> return cmd([String]{{\"cmd\", \"/C\", line}})\n    cmd([String]{{\"sh\", \"-c\", line}})\n}}\n\npub fn arg(spec: ProcessSpec, extra: String) -> ProcessSpec Never! {{\n    spec.arg(extra)\n}}\n\npub fn args_extend(spec: ProcessSpec, extra: [String]) -> ProcessSpec Never! {{\n    spec.args_extend(extra)\n}}\n\n\npub fn cmd(argv: [String]) -[Exec]> ProcessSpec Never! {{ core.process.cmd(argv) }}\n\npub fn current_pid() -[Env]> Int Never! {{ core.sys.getpid() }}\n\npub fn cwd(spec: ProcessSpec, path: String) -> ProcessSpec Never! {{ spec.cwd(path) }}\n\npub fn env(spec: ProcessSpec, key: String, value: String) -> ProcessSpec Never! {{\n    spec.env(key, value)\n}}\n\npub fn env_get(name: String) -[Env]> String? Never! {{ core.sys.get(name) }}\n\npub fn exit(code: Int) -[Exec]> Never Never! {{\n    core.process.exit(code)\n    loop {{}}\n}}\n\npub fn on_signal(signal: ProcessSignal) Never! -[Exec]> {{ core.process.on_signal(signal) }}\n\npub fn pipeline(steps: [ProcessSpec]) -[Exec, Time.Wait]> ProcessReceipt IOError! {{\n    core.process.pipeline(steps)\n}}\n\npub fn run_spec(spec: ProcessSpec) -[Exec, Time.Wait]> ProcessReceipt IOError! {{\n    spec.run()\n}}\n\npub fn status_ok(receipt: ProcessReceipt) -> Bool Never! {{\n    receipt.success\n}}\n\n\npub fn which(name: String) -[FS, Env]> String? Never! {{\n    if name.len() == 0 -> return None\n    if contains_path_separator(name) || path_is_absolute(name) {{\n        if path_is_file(name) -> return Val(name)\n        return None\n    }}\n    path :: core.sys.get(\"PATH\") ?? return None\n    family :: core.sys.family() ?? return None\n    separator :: path_separator_for_platform(family)\n    loop directory in path_parts(path, separator) {{\n        candidate :: path_join(directory, name)\n        if path_is_file(candidate) -> return Val(candidate)\n    }}\n    None\n}}\nfn path_is_absolute(path: String) -> Bool Never! {{\n    raw :: path.bytes()\n    if raw.len() == 0 -> return false\n    if raw[0] == (U8{{47}}) || raw[0] == (U8{{92}}) -> return true\n    raw.len() >= 3 &&\n        ((raw[0] >= (U8{{65}}) && raw[0] <= (U8{{90}})) ||\n            (raw[0] >= (U8{{97}}) && raw[0] <= (U8{{122}}))) &&\n        raw[1] == (U8{{58}}) &&\n        (raw[2] == (U8{{47}}) || raw[2] == (U8{{92}}))\n}}\n\nfn path_is_file(path: String) -[FS]> Bool Never! {{\n    stat :: core.files.stat(path) ?? return false\n    stat.is_file\n}}\n\nfn path_join(base: String, name: String) -> String Never! {{\n    if name.len() == 0 -> return ~base\n    if path_is_absolute(name) || base.len() == 0 -> return ~name\n    last :: base.bytes()[base.bytes().len() - 1]\n    if last == (U8{{47}}) || last == (U8{{92}}) -> return \"{{base}}{{name}}\"\n    \"{{base}}/{{name}}\"\n}}\n\nfn path_separator_for_platform(family: String) -> U8 Never! {{\n    if family == \"windows\" -> return U8{{59}}\n    U8{{58}}\n}}\n\n\n\n\npub fn call(spec: ProcessSpec) -[Exec, Time.Wait]> Int IOError! {{\n    receipt :: spec.run()\n    receipt.code\n}}\n\npub fn capture(spec: ProcessSpec) -[Exec, Time.Wait]> ProcessReceipt IOError! {{\n    spec.run()\n}}\n\npub fn check_call(spec: ProcessSpec) -[Exec, Time.Wait]> ProcessReceipt IOError! {{\n    spec.run_checked()\n}}\n\npub fn check_output(spec: ProcessSpec) -[Exec, Time.Wait]> String IOError! {{\n    receipt :: check_call(spec)\n    receipt.output\n}}\n\n\npub fn combined_output(receipt: ProcessReceipt) -> String Never! {{\n    if receipt.output.len() == 0 -> return receipt.errors\n    if receipt.errors.len() == 0 -> return receipt.output\n    \"{{receipt.output}}\\n{{receipt.errors}}\"\n}}\n\npub fn env_get_or(name: String, fallback: String) -[Env]> String Never! {{\n    core.sys.get(name) ?? return fallback\n}}\n\npub fn env_keys() -[Env]> [String] EnvError! {{ core.sys.vars() }}\n\npub fn env_set(spec: ProcessSpec, key: String, value: String) -> ProcessSpec Never! {{\n    spec.env(key, value)\n}}\n\npub fn env_truthy(name: String) -[Env]> Bool Never! {{\n    value :: core.sys.get(name) ?? return false\n    lowered :: core.text.lower(value)\n    lowered == \"1\" || lowered == \"true\" || lowered == \"yes\" || lowered == \"on\"\n}}\n\npub fn failed(receipt: ProcessReceipt) -> Bool Never! {{ !receipt.success }}\n\n\npub fn list2cmdline(argv: [String]) -> String Never! {{\n    out := \"\"\n    first := true\n    loop item in argv {{\n        if !first -> out = \"{{out}} \"\n        out = \"{{out}}{{quote_arg(item)}}\"\n        first = false\n    }}\n    out\n}}\n\npub fn signal_number(signal: ProcessSignal) -> Int Never! {{\n    if signal == {{\n        .Interrupt -> 2\n        .Terminate -> 15\n        .Hangup -> 1\n        .Child -> 17\n        .User1 -> 10\n        .User2 -> 12\n        else -> 0\n    }}\n}}\n\npub fn stderr_lines(receipt: ProcessReceipt) -> [String] Never! {{\n    split_lines(receipt.errors)\n}}\n\npub fn stdout_lines(receipt: ProcessReceipt) -> [String] Never! {{\n    split_lines(receipt.output)\n}}\n\npub fn exited(receipt: ProcessReceipt) -> Bool Never! {{\n    receipt.signal == None && !receipt.timed_out\n}}\nfn contains_path_separator(value: String) -> Bool Never! {{\n    loop byte in value.bytes() {{\n        if byte == (U8{{47}}) || byte == (U8{{92}}) -> return true\n    }}\n    false\n}}\n\nfn path_separator(value: String) -> U8 {{\n    raw :: value.bytes()\n    if raw.len() > 0 -> return raw[0]\n    U8{{58}}\n}}\n\nfn path_parts(value: String, separator: U8) -> [String] Never! {{\n    raw :: value.bytes()\n    out := [String]{{}}\n    start := 0\n    i := 0\n    loop i <= raw.len() {{\n        if i == raw.len() || raw[i] == separator {{\n            if i == start -> &out.push(\".\") else {{\n                &out.push(String.from_bytes(slice_u8(raw, start, i)) ?? \"\")\n            }}\n            start = i + 1\n        }}\n        i = i + 1\n    }}\n    out\n}}\n\nfn split_lines(value: String) -> [String] {{\n    raw :: value.bytes()\n    out := [String]{{}}\n    start := 0\n    i := 0\n    loop i < raw.len() {{\n        if raw[i] == (U8{{10}}) || raw[i] == (U8{{13}}) {{\n            &out.push(String.from_bytes(slice_u8(raw, start, i)) ?? \"\")\n            if raw[i] == (U8{{13}}) && i + 1 < raw.len() && raw[i + 1] == (U8{{10}}) {{\n                i = i + 2\n            }} else {{\n                i = i + 1\n            }}\n            start = i\n        }} else {{\n            i = i + 1\n        }}\n    }}\n    if start < raw.len() -> &out.push(String.from_bytes(slice_u8(raw, start, raw.len())) ?? \"\")\n    out\n}}\n\nfn quote_arg(value: String) -> String {{\n    raw :: value.bytes()\n    needs_quote := raw.len() == 0\n    loop byte in raw {{\n        if byte == (U8{{9}}) || byte == (U8{{10}}) || byte == (U8{{13}}) || byte == (U8{{32}}) {{\n            needs_quote = true\n        }}\n    }}\n    out := [U8]{{}}\n    if needs_quote -> &out.push(U8{{34}})\n    backslashes := 0\n    loop byte in raw {{\n        if byte == (U8{{92}}) {{\n            backslashes = backslashes + 1\n            next\n        }}\n        if byte == (U8{{34}}) {{\n            count := backslashes * 2 + 1\n            loop count > 0 {{\n                &out.push(U8{{92}})\n                count = count - 1\n            }}\n            &out.push(U8{{34}})\n        }} else {{\n            loop backslashes > 0 {{\n                &out.push(U8{{92}})\n                backslashes = backslashes - 1\n            }}\n            &out.push(byte)\n        }}\n        backslashes = 0\n    }}\n    if needs_quote {{\n        loop backslashes > 0 {{\n            &out.push(U8{{92}})\n            &out.push(U8{{92}})\n            backslashes = backslashes - 1\n        }}\n        &out.push(U8{{34}})\n    }} else {{\n        loop backslashes > 0 {{\n            &out.push(U8{{92}})\n            backslashes = backslashes - 1\n        }}\n    }}\n    String.from_bytes(out) ?? ~value\n}}\n\nfn slice_u8(raw: [U8], start: Int, end: Int) -> [U8] Never! {{\n    out := [U8]{{}}\n    i := start\n    loop i < end {{\n        &out.push(raw[i])\n        i = i + 1\n    }}\n    out\n}}\n\n"}
}

fn foundation_embedded_core_source_69() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.reactive", alias: "core_core_reactive", path: "Core/reactive/reactive.jet", owner: "", owned_members: [String]{"computed_get", "computed_set", "effect_last", "effect_run", "get", "set", "update", "version", "set_if_changed", "changed", "computed_update", "computed_version", "effect_run_if", "effect_changed"}, source: "package {{\n    name: \"core.reactive\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"Signals, derived values, and effects.\"\n    license: \"MIT\"\n    outputs: {{\n        reactive: .Library{{ entry: reactive }}\n    }}\n}}\nmodule loadable\n\n// Reactive values are immutable Jet carriers. The runtime provider owns the\n// `signal`, `computed`, `derived` and `effect` constructors, which return\n// shared, dependency-tracked cells; keeping the transition rules here makes\n// the source-level API deterministic as well.\npub struct Signal<T> {{\n    pub value: T\n    pub version: Int\n}}\n\npub struct Computed<T> {{\n    pub value: T\n    pub version: Int\n}}\n\npub struct Derived<T> {{\n    pub value: T\n    pub version: Int\n}}\n\npub struct Effect {{\n    pub last: Int\n    pub active: Bool\n}}\n\npub fn unsubscribe(e: Effect) -> Effect Never! {{\n    Effect{{last: e.last, active: false}}\n}}\n\npub fn is_active(e: Effect) -> Bool Never! {{ e.active }}\n\npub fn set<T>(sig: Signal<T>, value: T) -> Signal<T> Never! {{\n    Signal<T>{{value: value, version: sig.version + 1}}\n}}\n\npub fn set_if_changed(sig: Signal<Int>, value: Int) -> Signal<Int> Never! {{\n    if sig.value == value -> return ~sig\n    set(sig, value)\n}}\n\npub fn changed(sig: Signal<Int>, value: Int) -> Bool Never! {{ sig.value != value }}\n\npub fn computed_update(c: Computed<Int>, delta: Int) -> Computed<Int> Never! {{\n    computed_set(c, c.value + delta)\n}}\n\npub fn computed_version<T>(c: Computed<T>) -> Int Never! {{ c.version }}\n\npub fn effect_run_if(e: Effect, value: Int) -> Effect Never! {{\n    if e.active && e.last == value -> return ~e\n    effect_run(e, value)\n}}\n\npub fn effect_changed(e: Effect, value: Int) -> Bool Never! {{ !e.active || e.last != value }}\n\npub fn get<T>(sig: Signal<T>) -> T Never! {{ sig.value }}\n\npub fn version<T>(sig: Signal<T>) -> Int Never! {{ sig.version }}\n\npub fn update(sig: Signal<Int>, delta: Int) -> Signal<Int> Never! {{ set(sig, sig.value + delta) }}\n\npub fn computed_get<T>(c: Computed<T>) -> T Never! {{ c.value }}\n\npub fn computed_set<T>(c: Computed<T>, value: T) -> Computed<T> Never! {{\n    Computed<T>{{value: value, version: c.version + 1}}\n}}\n\npub fn effect_run(e: Effect, value: Int) -> Effect Never! {{\n    if !e.active || e.last != value -> return Effect{{last: value, active: true}}\n    ~e\n}}\n\npub fn effect_last(e: Effect) -> Int Never! {{ e.last }}\n"}
}

fn foundation_embedded_core_source_70() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.reactive.loadable", alias: "core_core_reactive_loadable", path: "Core/reactive/loadable.jet", owner: "", owned_members: [String]{"failed", "idle", "loaded", "loading", "is_idle", "is_loading", "is_loaded", "is_failed", "value", "reason", "retry"}, source: "// core.reactive.loadable — bounded async slot states.\n// The provider owns scheduling and transport; this carrier owns the legal\n// state transitions and never manufactures a success value from an error.\npub enum Loadable<T, E> {{\n    Idle\n    Loading\n    Loaded(T)\n    Failed(E)\n}}\n\npub fn idle<T, E>() -> Loadable<T, E> Never! {{ Loadable.Idle }}\n\npub fn loading<T, E>() -> Loadable<T, E> Never! {{ Loadable.Loading }}\n\npub fn loaded<T, E>(value: T) -> Loadable<T, E> Never! {{ Loadable.Loaded(value) }}\n\npub fn failed<T, E>(reason: E) -> Loadable<T, E> Never! {{ Loadable.Failed(reason) }}\n\npub fn is_idle<T, E>(state: Loadable<T, E>) -> Bool Never! {{\n    if state == {{\n        .Idle -> true\n        else -> false\n    }}\n}}\npub fn is_loading<T, E>(state: Loadable<T, E>) -> Bool Never! {{\n    if state == {{\n        .Loading -> true\n        else -> false\n    }}\n}}\npub fn is_loaded<T, E>(state: Loadable<T, E>) -> Bool Never! {{\n    if state == {{\n        .Loaded(_) -> true\n        else -> false\n    }}\n}}\npub fn is_failed<T, E>(state: Loadable<T, E>) -> Bool Never! {{\n    if state == {{\n        .Failed(_) -> true\n        else -> false\n    }}\n}}\n\npub fn value<T, E>(state: Loadable<T, E>) -> T? Never! {{\n    if state == {{\n        .Loaded(value) -> Val(value)\n        else -> None\n    }}\n}}\n\npub fn reason<T, E>(state: Loadable<T, E>) -> E? Never! {{\n    if state == {{\n        .Failed(message) -> Val(message)\n        else -> None\n    }}\n}}\n\n// Retry starts a fresh attempt only from an idle or failed state.  A loaded\n// result is stable, and retrying an in-flight request must not discard it.\npub fn retry<T, E>(state: Loadable<T, E>) -> Loadable<T, E> Never! {{\n    if is_failed<T, E>(state) || is_idle<T, E>(state) -> return Loadable.Loading\n    ~state\n}}\n"}
}

fn foundation_embedded_core_source_71() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.reflect", alias: "core_core_reflect", path: "Core/reflect/reflect.jet", owner: "", owned_members: [String]{"inspect"}, source: "package {{\n    name: \"core.reflect\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"Runtime type names for values.\"\n    license: \"MIT\"\n    outputs: {{\n        reflect: .Library{{ entry: reflect }}\n    }}\n}}\n\n// core.reflect — typed runtime reflection and explicit text inspection.\n\n// `inspect` classifies caller-supplied text. The compiler-owned `of` intrinsic\n// projects typed values and is intentionally not implemented by this module.\n\npub struct ReflectValue {{\n    pub type_name: String\n    pub display: String\n}}\n\npub fn inspect(value: String) -> ReflectValue Never! {{ classify(value) }}\n\nfn classify(value: String) -> ReflectValue {{\n    t :: trim(value)\n    if t.len() == 0 -> return (ReflectValue{{type_name: \"Empty\", display: t}})\n    raw :: t.bytes()\n    if raw.len() >= 2 && raw[0] == (U8{{34}}) && raw[raw.len() - 1] == (U8{{34}}) -> return (ReflectValue{{type_name: \"String\", display: t}})\n    if raw.len() >= 2 && raw[0] == (U8{{39}}) && raw[raw.len() - 1] == (U8{{39}}) -> return (ReflectValue{{type_name: \"Char\", display: t}})\n    if t == {{\n        \"true\" | \"false\" -> return (ReflectValue{{type_name: \"Bool\", display: t}})\n        \"None\" -> return (ReflectValue{{type_name: \"Option\", display: t}})\n        \"null\" -> return (ReflectValue{{type_name: \"Null\", display: t}})\n        else -> {{ _ := 0 }}\n    }}\n    if starts(t, \"Some(\") -> return (ReflectValue{{type_name: \"Option\", display: t}})\n    if starts(t, \"Ok(\") || starts(t, \"Err(\") -> return (ReflectValue{{type_name: \"Result\", display: t}})\n    if raw[0] == (U8{{91}}) -> return (ReflectValue{{type_name: \"List\", display: t}})\n    if raw[0] == (U8{{123}}) -> return (ReflectValue{{type_name: \"Struct\", display: t}})\n    if is_number(t) -> return (ReflectValue{{type_name: \"Int\", display: t}})\n    if Float.parse(t) == {{\n        .Ok(_) -> return (ReflectValue{{type_name: \"Float\", display: t}})\n        else -> {{ _ := 0 }}\n    }}\n    name := ident_prefix(t)\n    if name.len() > 0 -> return (ReflectValue{{type_name: name, display: t}})\n    ReflectValue{{type_name: \"Value\", display: t}}\n}}\n\nfn starts(text: String, prefix: String) -> Bool {{\n    a :: text.bytes()\n    b :: prefix.bytes()\n    if b.len() > a.len() -> return false\n    loop i in 0..<b.len() {{\n        if a[i] != b[i] -> return false\n    }}\n    true\n}}\n\nfn trim(text: String) -> String {{\n    raw :: text.bytes()\n    s := 0\n    e := raw.len()\n    loop s < e {{\n        n :: raw[s]\n        if {{\n            n == (U8{{32}}) || n == (U8{{9}}) || n == (U8{{10}}) || n == (U8{{13}}) -> s += 1\n            else -> break\n        }}\n    }}\n    loop e > s {{\n        n :: raw[e - 1]\n        if {{\n            n == (U8{{32}}) || n == (U8{{9}}) || n == (U8{{10}}) || n == (U8{{13}}) -> e -= 1\n            else -> break\n        }}\n    }}\n    out := [U8]{{}}\n    loop i in s..<e -> &out.push(raw[i])\n    String.from_bytes(out) ?? \"\"\n}}\n\nfn is_number(text: String) -> Bool {{\n    raw :: text.bytes()\n    if raw.len() == 0 -> return false\n    i := 0\n    if raw[0] == (U8{{45}}) || raw[0] == (U8{{43}}) {{\n        if raw.len() == 1 -> return false\n        i = 1\n    }}\n    loop i < raw.len() {{\n        n :: raw[i]\n        if n < (U8{{48}}) || n > (U8{{57}}) -> return false\n        i += 1\n    }}\n    true\n}}\n\nfn ident_prefix(text: String) -> String {{\n    raw :: text.bytes()\n    out := [U8]{{}}\n    loop i in 0..<raw.len() {{\n        n :: raw[i]\n        ok :: (n >= (U8{{65}}) && n <= (U8{{90}})) || (n >= (U8{{97}}) && n <= (U8{{122}})) || n == (U8{{95}}) || (i > 0 && n >= (U8{{48}}) && n <= (U8{{57}}))\n        if !ok -> break\n        &out.push(raw[i])\n    }}\n    String.from_bytes(out) ?? \"\"\n}}\n"}
}

fn foundation_embedded_core_source_72() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.regex", alias: "core_core_regex", path: "Core/regex/regex.jet", owner: "", owned_members: [String]{"compile", "compile_with", "escape", "expand", "find", "find_all", "finditer", "flags", "full_match", "is_match", "match", "matches", "purge", "replace", "replace_first", "split", "split_limit", "regex", "join", "search", "findall", "fullmatch", "sub", "subn"}, source: "package {{\n    name: \"core.regex\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"Checked regular expressions.\"\n    license: \"MIT\"\n    outputs: {{\n        regex: .Library{{ entry: regex }}\n    }}\n}}\n\n// core.regex — one engine, compile-checked literals, fallible runtime.\n//\n// `r\"...\"` literals are a compiler feature. `compile` is for patterns that\n// arrive at run time. This file is a bounded backtracking NFA over UTF-8\n// bytes: concatenation, `|`, `()` , `*` `+` `?` `{{n,m}}`, `.`, `^`, `$`,\n// `[]`/`[^]` and the usual `\\d\\w\\s` classes. Flags: `ignore_case` (ASCII),\n// `multiline`, and `dot_matches_newline`. Every execution consumes an\n// explicit finite budget, so hostile nested quantifiers terminate; a pattern\n// that does not compile fails with RegexError, never a panic.\n\n#Error\npub enum RegexError {{\n    Syntax\n    Cache\n}}\n\npub struct RegexFlags {{\n    pub ignore_case: Bool\n    pub multiline: Bool\n    pub dot_matches_newline: Bool\n}}\n\npub struct Pattern {{\n    pub pattern: String\n}}\n\npub struct RegexFlag {{\n    pub name: String\n    pub value: Int\n}}\n\npub struct Regex {{\n    pub pattern: String\n    pub flags: RegexFlags\n    pub nodes: [Node]\n    pub root: Int\n}}\n\npub struct Match {{\n    pub start: Int\n    pub end: Int\n    pub text: String\n    pub groups: [String]\n}}\n\npub struct Node {{\n    pub kind: String\n    pub s: String\n    pub a: Int\n    pub b: Int\n    pub left: Int\n    pub right: Int\n    pub neg: Bool\n}}\n\npub fn flags(ignore_case: Bool, multiline: Bool, dot_matches_newline: Bool) -> RegexFlags Never! {{\n    RegexFlags{{\n    ignore_case: ignore_case,\n    multiline: multiline,\n    dot_matches_newline: dot_matches_newline,\n    }}\n}}\n\n/// Quote regex metacharacters in `text` so it matches as a literal.\npub fn escape(text: String) -> String Never! {{\n    out := [U8]{{}}\n    loop b in text.bytes() {{\n        if is_meta(b) -> &out.push(U8{{92}})\n        &out.push(b)\n    }}\n    String.from_bytes(out) ?? \"\"\n}}\n\npub fn compile(pattern: String) -> Regex RegexError! {{ compile_with(pattern, flags(false, false, false)) }}\n\npub fn compile_with(pattern: String, flags: RegexFlags) -> Regex RegexError! {{\n    p := Parser{{bytes: pattern.bytes(), i: 0, flags: flags, nodes: [Node]{{}}}}\n    root :: &p.parse_alt()\n    if p.i != p.bytes.len() -> return Err(RegexError.Syntax)\n    Ok(Regex{{pattern: pattern, flags: flags, nodes: p.nodes, root: root}})\n}}\n\npub fn is_match(pattern: Regex, text: String) -> Bool Never! {{\n    m :: find(pattern, text)\n    m != None\n}}\n\npub fn full_match(pattern: Regex, text: String) -> Bool Never! {{\n    raw :: text.bytes()\n    caps := [CaptureSpan]{{}}\n    if run_exec(pattern, raw, 0, pattern.root, &caps) != raw.len() -> return false\n    true\n}}\n\npub fn match(pattern: Regex, text: String) -> Match? Never! {{ find_match(pattern, text) }}\npub fn finditer(pattern: Regex, text: String) -> [Match] Never! {{ matches(pattern, text) }}\n\n/// The source-owned engine has no process-global cache to mutate. Report that\n/// capability explicitly instead of pretending a purge happened.\npub fn purge() RegexError! {{\n    return Err(RegexError.Cache)\n}}\n\npub fn find(pattern: Regex, text: String) -> String? Never! {{\n    m :: find_match(pattern, text) ?? return None\n    Val(m.text)\n}}\n\npub fn find_all(pattern: Regex, text: String) -> [String] Never! {{\n    out := [String]{{}}\n    loop m in matches(pattern, text) -> &out.push(m.text)\n    out\n}}\n\npub fn matches(pattern: Regex, text: String) -> [Match] Never! {{\n    raw :: text.bytes()\n    out := [Match]{{}}\n    i := 0\n    loop i <= raw.len() {{\n        caps := [CaptureSpan]{{}}\n        end :: run_exec(pattern, raw, i, pattern.root, &caps)\n        if end >= i && (end > i || empty_ok(pattern)) {{\n            &out.push(make_match(raw, i, end, caps))\n            if end == i {{\n                i = i + scalar_width(raw, i)\n            }} else {{\n                i = end\n            }}\n        }} else {{\n            i = i + scalar_width(raw, i)\n        }}\n        if out.len() > raw.len() + 1 -> break\n    }}\n    out\n}}\n\npub fn split(pattern: Regex, text: String) -> [String] Never! {{ split_limit(pattern, text, 0) }}\n\npub fn split_limit(pattern: Regex, text: String, n: Int) -> [String] Never! {{\n    raw :: text.bytes()\n    ms :: matches(pattern, text)\n    out := [String]{{}}\n    cur := 0\n    used := 0\n    loop m in ms {{\n        if n > 0 && used + 1 >= n -> break\n        &out.push(slice(raw, cur, m.start))\n        cur = m.end\n        used = used + 1\n    }}\n    &out.push(slice(raw, cur, raw.len()))\n    out\n}}\n\npub fn replace(pattern: Regex, text: String, replacement: String) -> String Never! {{ replace_n(pattern, text, replacement, false) }}\n\n/// Expand numbered capture references in a replacement template.\n/// Supported forms are `\\1` through `\\9`, `\\g<1>`, `$1`, `${{1}}`, and `\\\\`.\npub fn expand(m: Match, template: String) -> String Never! {{\n    raw :: template.bytes()\n    out := [U8]{{}}\n    i := 0\n    loop i < raw.len() {{\n        marker :: raw[i]\n        if marker != (U8{{92}}) && marker != (U8{{36}}) {{\n            &out.push(marker)\n            i = i + 1\n            next\n        }}\n        i = i + 1\n        if i >= raw.len() {{\n            &out.push(marker)\n            break\n        }}\n        n :: raw[i]\n        if (marker == (U8{{92}}) || marker == (U8{{36}})) && n >= 49 && n <= 57 {{\n            index := n - 49\n            if index < m.groups.len() {{\n                loop b in m.groups[index].bytes() -> &out.push(b)\n            }}\n            i = i + 1\n            next\n        }}\n        if marker == (U8{{36}}) && n == (U8{{123}}) {{\n            j := i + 1\n            index := 0\n            found := false\n            loop j < raw.len() {{\n                d :: raw[j]\n                if d == (U8{{125}}) {{\n                    found = true\n                    break\n                }}\n                if d < 48 || d > 57 -> break\n                index = index * 10 + d - 48\n                j = j + 1\n            }}\n            if found && index > 0 && index - 1 < m.groups.len() {{\n                loop b in m.groups[index - 1].bytes() -> &out.push(b)\n                i = j + 1\n                next\n            }}\n        }}\n        if marker == (U8{{92}}) && n == (U8{{103}}) && i + 1 < raw.len() && raw[i + 1] == (U8{{60}}) {{\n            j := i + 2\n            index := 0\n            found := false\n            loop j < raw.len() {{\n                d :: raw[j]\n                if d == (U8{{62}}) {{\n                    found = true\n                    break\n                }}\n                if d < 48 || d > 57 -> break\n                index = index * 10 + d - 48\n                j = j + 1\n            }}\n            if found && index > 0 && index - 1 < m.groups.len() {{\n                loop b in m.groups[index - 1].bytes() -> &out.push(b)\n                i = j + 1\n                next\n            }}\n        }}\n        &out.push(marker)\n        &out.push(n)\n        i = i + 1\n    }}\n    String.from_bytes(out) ?? \"\"\n}}\n\npub fn replace_first(pattern: Regex, text: String, replacement: String) -> String Never! {{ replace_n(pattern, text, replacement, true) }}\n\nfn replace_n(pattern: Regex, text: String, replacement: String, first_only: Bool) -> String {{\n    raw :: text.bytes()\n    ms :: matches(pattern, text)\n    out := [U8]{{}}\n    cur := 0\n    loop m in ms {{\n        loop b in slice(raw, cur, m.start).bytes() -> &out.push(b)\n        expanded :: expand(m, replacement)\n        loop b in expanded.bytes() -> &out.push(b)\n        cur = m.end\n        if first_only -> break\n    }}\n    loop b in slice(raw, cur, raw.len()).bytes() -> &out.push(b)\n    String.from_bytes(out) ?? \"\"\n}}\n\nstruct Parser {{\n    bytes: [U8]\n    i: Int\n    flags: RegexFlags\n    nodes: [Node]\n}}\n\nstruct CaptureSpan {{\n    start: Int\n    end: Int\n}}\n\nimpl Parser {{\n    fn parse_alt(&self) -> Int RegexError! {{\n        left :: &self.parse_seq()\n        next_byte :: self.peek() ?? (U8{{0}})\n        if next_byte != (U8{{124}}) -> return Ok(left)\n        _ :: &self.bump()\n        right :: &self.parse_alt()\n        Ok(&self.emit(\"alt\", \"\", 0, 0, left, right, false))\n    }}\n\n    fn parse_seq(&self) -> Int RegexError! {{\n        ids := [Int]{{}}\n        loop {{\n            b :: self.peek() ?? break\n            n :: b\n            if n == 124 || n == 41 -> break\n            &ids.push(&self.parse_atom())\n        }}\n        if ids.len() == 0 -> return Ok(&self.emit(\"empty\", \"\", 0, 0, -1, -1, false))\n        if ids.len() == 1 -> return Ok(ids[0])\n        acc := ids[0]\n        loop i in 1..<ids.len() {{\n            acc = &self.emit(\"seq\", \"\", 0, 0, acc, ids[i], false)\n        }}\n        Ok(acc)\n    }}\n\n    fn parse_atom(&self) -> Int RegexError! {{\n        id :: &self.parse_piece()\n        b :: self.peek() ?? return Ok(id)\n        n :: b\n        if n == 42 {{\n            _ :: &self.bump()\n            return Ok(&self.emit(\"rep\", \"\", 0, -1, id, -1, false))\n        }}\n        if n == 43 {{\n            _ :: &self.bump()\n            return Ok(&self.emit(\"rep\", \"\", 1, -1, id, -1, false))\n        }}\n        if n == 63 {{\n            _ :: &self.bump()\n            return Ok(&self.emit(\"rep\", \"\", 0, 1, id, -1, false))\n        }}\n        if n == 123 {{\n            _ :: &self.bump()\n            lo :: &self.num()\n            hi := lo\n            comma :: self.peek() ?? (U8{{0}})\n            if comma == (U8{{44}}) {{\n                _ :: &self.bump()\n                quant_close :: self.peek() ?? (U8{{0}})\n                if quant_close == (U8{{125}}) {{\n                    hi = -1\n                }} else {{\n                    hi = &self.num()\n                }}\n            }}\n            if hi >= 0 && hi < lo -> return Err(RegexError.Syntax)\n            quant_end :: self.peek() ?? (U8{{0}})\n            if quant_end != (U8{{125}}) -> return Err(RegexError.Syntax)\n            _ :: &self.bump()\n            return Ok(&self.emit(\"rep\", \"\", lo, hi, id, -1, false))\n        }}\n        Ok(id)\n    }}\n\n    fn parse_piece(&self) -> Int RegexError! {{\n        b :: &self.bump() ?? return Err(RegexError.Syntax)\n        n :: b\n        if n == {{\n            46 -> return Ok(&self.emit(\"dot\", \"\", 0, 0, -1, -1, false))\n            94 -> return Ok(&self.emit(\"start\", \"\", 0, 0, -1, -1, false))\n            36 -> return Ok(&self.emit(\"end\", \"\", 0, 0, -1, -1, false))\n            else -> {{ _ := 0 }}\n        }}\n        if n == 40 -> return &self.parse_group()\n        if n == 91 -> return &self.parse_class()\n        if n == 92 -> return &self.parse_escape()\n        if n == 41 || n == 124 || n == 42 || n == 43 || n == 63 || n == 123 {{\n            return Err(RegexError.Syntax)\n        }}\n        Ok(&self.emit(\"lit\", String.from_bytes([U8]{{b}}) ?? \"\", 0, 0, -1, -1, false))\n    }}\n\n    fn parse_group(&self) -> Int RegexError! {{\n        name := \"\"\n        marker :: self.peek() ?? (U8{{0}})\n        if marker == (U8{{63}}) {{\n            _ :: &self.bump()\n            kind :: &self.bump() ?? return Err(RegexError.Syntax)\n            if kind == (U8{{58}}) {{\n                inner :: &self.parse_alt()\n                group_close :: self.peek() ?? (U8{{0}})\n                if group_close != (U8{{41}}) -> return Err(RegexError.Syntax)\n                _ :: &self.bump()\n                return Ok(inner)\n            }}\n            if kind != (U8{{60}}) -> return Err(RegexError.Syntax)\n            raw_name := [U8]{{}}\n            loop {{\n                c :: &self.bump() ?? return Err(RegexError.Syntax)\n                if c == (U8{{62}}) -> break\n                if !is_group_name_char(c) -> return Err(RegexError.Syntax)\n                &raw_name.push(c)\n            }}\n            if raw_name.len() == 0 -> return Err(RegexError.Syntax)\n            name = String.from_bytes(raw_name) ?? \"\"\n        }}\n        inner :: &self.parse_alt()\n        group_close :: self.peek() ?? (U8{{0}})\n        if group_close != (U8{{41}}) -> return Err(RegexError.Syntax)\n        _ :: &self.bump()\n        Ok(&self.emit(\"group\", name, 0, 0, inner, -1, false))\n    }}\n\n    fn parse_escape(&self) -> Int RegexError! {{\n        b :: &self.bump() ?? return Err(RegexError.Syntax)\n        n :: b\n        if n == {{\n            100 -> return Ok(&self.emit(\"class\", \"0-9\", 0, 0, -1, -1, false))\n            68 -> return Ok(&self.emit(\"class\", \"0-9\", 0, 0, -1, -1, true))\n            119 -> return Ok(&self.emit(\"class\", \"A-Za-z0-9_\", 0, 0, -1, -1, false))\n            87 -> return Ok(&self.emit(\"class\", \"A-Za-z0-9_\", 0, 0, -1, -1, true))\n            115 -> return Ok(&self.emit(\"class\", String.from_bytes([U8]{{32, 9, 10, 13, 11, 12}}) ?? \"\", 0, 0, -1, -1, false))\n            83 -> return Ok(&self.emit(\"class\", String.from_bytes([U8]{{32, 9, 10, 13, 11, 12}}) ?? \"\", 0, 0, -1, -1, true))\n            110 -> return Ok(&self.emit(\"lit\", \"\\n\", 0, 0, -1, -1, false))\n            114 -> return Ok(&self.emit(\"lit\", String.from_bytes([U8]{{13}}) ?? \"\", 0, 0, -1, -1, false))\n            116 -> return Ok(&self.emit(\"lit\", \"\\t\", 0, 0, -1, -1, false))\n            else -> {{ _ := 0 }}\n        }}\n        Ok(&self.emit(\"lit\", String.from_bytes([U8]{{b}}) ?? \"\", 0, 0, -1, -1, false))\n    }}\n\n    fn parse_class(&self) -> Int RegexError! {{\n        neg := false\n        class_first :: self.peek() ?? (U8{{0}})\n        if class_first == (U8{{94}}) {{\n            neg = true\n            _ :: &self.bump()\n        }}\n        body := [U8]{{}}\n        first := true\n        escaped := false\n        loop {{\n            b :: &self.bump() ?? return Err(RegexError.Syntax)\n            if escaped {{\n                &body.push(b)\n                escaped = false\n                first = false\n                next\n            }}\n            if b == (U8{{92}}) {{\n                &body.push(b)\n                escaped = true\n                first = false\n                next\n            }}\n            if b == (U8{{93}}) {{\n                // `]` is a literal when it is the first class member, so\n                // `[^]]` is a valid negated class rather than an empty one.\n                if first {{\n                    &body.push(b)\n                    first = false\n                    next\n                }}\n                break\n            }}\n            &body.push(b)\n            first = false\n        }}\n        if escaped || body.len() == 0 -> return Err(RegexError.Syntax)\n        Ok(&self.emit(\"class\", String.from_bytes(body) ?? \"\", 0, 0, -1, -1, neg))\n    }}\n\n    fn emit(&self, kind: String, s: String, a: Int, b: Int, left: Int, right: Int, neg: Bool) -> Int Never! {{\n        &self.nodes.push(Node{{kind: kind, s: s, a: a, b: b, left: left, right: right, neg: neg}})\n        self.nodes.len() - 1\n    }}\n\n    fn num(&self) -> Int RegexError! {{\n        n := 0\n        got := false\n        loop {{\n            b :: self.peek() ?? break\n            d :: b\n            if d < 48 || d > 57 -> break\n            // Keep the existing 4096 quantifier limit, but check before\n            // multiplying so an arbitrarily long hostile number cannot\n            // overflow Int and escape validation.\n            if n > 409 || (n == 409 && d > 54) -> return Err(RegexError.Syntax)\n            _ :: &self.bump()\n            n = n * 10 + (d - 48)\n            got = true\n        }}\n        if !got -> return Err(RegexError.Syntax)\n        Ok(n)\n    }}\n\n\n    fn peek(self) -> U8? {{\n        if self.i >= self.bytes.len() -> return None\n        Val(self.bytes[self.i])\n    }}\n\n    fn bump(&self) -> U8? {{\n        if self.i >= self.bytes.len() -> return None\n        b :: self.bytes[self.i]\n        self.i = self.i + 1\n        Val(b)\n    }}\n}}\n\nstruct MatchBudget {{\n    remaining: Int\n}}\n\nfn budget_limit(re: Regex, text: [U8]) -> Int Never! {{\n    nodes := re.nodes.len()\n    bytes := text.len()\n    n := nodes\n    if n > 4096 -> n = 4096\n    m := bytes\n    if m > 4096 -> m = 4096\n    limit := (n + 1) * (m + 1) * 32\n    if limit < 4096 -> return 4096\n    if limit > 1000000 -> return 1000000\n    limit\n}}\n\nfn scalar_width(raw: [U8], i: Int) -> Int Never! {{\n    if i < 0 || i >= raw.len() -> return 1\n    n :: raw[i]\n    if n < 128 -> return 1\n    need := 0\n    if n >= 194 && n <= 223 {{\n        need = 1\n    }} else if n >= 224 && n <= 239 {{\n        need = 2\n    }} else if n >= 240 && n <= 244 {{\n        need = 3\n    }} else {{\n        return 1\n    }}\n    if i + need >= raw.len() -> return 1\n    loop k in 1..<(need + 1) {{\n        c :: raw[i + k]\n        if c < 128 || c > 191 -> return 1\n    }}\n    need + 1\n}}\n\nfn trim_caps(caps: &[CaptureSpan], keep: Int) Never! {{\n    loop caps.len() > keep -> _ :: &caps.pop()\n}}\n\nfn run_exec(re: Regex, text: [U8], i: Int, node: Int, caps: &[CaptureSpan]) -> Int Never! {{\n    budget := MatchBudget{{remaining: budget_limit(re, text)}}\n    exec(re, text, i, node, &caps, &budget)\n}}\n\nfn flatten_seq(re: Regex, node: Int, parts: &[Int]) Never! {{\n    if node < 0 || node >= re.nodes.len() -> return\n    n :: re.nodes[node]\n    if n.kind == \"seq\" {{\n        flatten_seq(re, n.left, &parts)\n        flatten_seq(re, n.right, &parts)\n        return\n    }}\n    &parts.push(node)\n}}\n\nfn exec_sequence(re: Regex, text: [U8], i: Int, node: Int, caps: &[CaptureSpan], budget: &MatchBudget) -> Int Never! {{\n    parts := [Int]{{}}\n    flatten_seq(re, node, &parts)\n    exec_parts(re, text, i, parts, 0, &caps, &budget)\n}}\n\nfn exec_parts(re: Regex, text: [U8], pos: Int, parts: [Int], index: Int, caps: &[CaptureSpan], budget: &MatchBudget) -> Int Never! {{\n    if index >= parts.len() -> return pos\n    n :: re.nodes[parts[index]]\n    if n.kind == \"rep\" -> return exec_rep_tail(re, text, pos, n, parts, index + 1, &caps, &budget, 0)\n    if n.kind == \"alt\" -> return exec_alt_tail(re, text, pos, n, parts, index + 1, &caps, &budget)\n    end :: exec(re, text, pos, parts[index], &caps, &budget)\n    if end < 0 -> return -1\n    exec_parts(re, text, end, parts, index + 1, &caps, &budget)\n}}\n\nfn exec_alt_tail(re: Regex, text: [U8], pos: Int, n: Node, parts: [Int], next: Int, caps: &[CaptureSpan], budget: &MatchBudget) -> Int Never! {{\n    saved := caps.len()\n    left :: exec(re, text, pos, n.left, &caps, &budget)\n    if left >= 0 {{\n        end :: exec_parts(re, text, left, parts, next, &caps, &budget)\n        if end >= 0 -> return end\n    }}\n    trim_caps(&caps, saved)\n    right :: exec(re, text, pos, n.right, &caps, &budget)\n    if right < 0 -> return -1\n    exec_parts(re, text, right, parts, next, &caps, &budget)\n}}\n\nfn exec_rep_tail(re: Regex, text: [U8], pos: Int, n: Node, parts: [Int], next: Int, caps: &[CaptureSpan], budget: &MatchBudget, count: Int) -> Int Never! {{\n    if n.b >= 0 && count >= n.b -> return exec_parts(re, text, pos, parts, next, &caps, &budget)\n    if count >= n.a {{\n        saved := caps.len()\n        nxt :: exec(re, text, pos, n.left, &caps, &budget)\n        if nxt >= 0 && nxt != pos {{\n            deeper :: exec_rep_tail(re, text, nxt, n, parts, next, &caps, &budget, count + 1)\n            if deeper >= 0 -> return deeper\n            trim_caps(&caps, saved)\n        }} else {{\n            trim_caps(&caps, saved)\n        }}\n        return exec_parts(re, text, pos, parts, next, &caps, &budget)\n    }}\n    saved := caps.len()\n    nxt :: exec(re, text, pos, n.left, &caps, &budget)\n    if nxt < 0 || nxt == pos {{\n        trim_caps(&caps, saved)\n        return -1\n    }}\n    end :: exec_rep_tail(re, text, nxt, n, parts, next, &caps, &budget, count + 1)\n    if end < 0 -> trim_caps(&caps, saved)\n    end\n}}\n\nfn exec(re: Regex, text: [U8], i: Int, node: Int, caps: &[CaptureSpan], budget: &MatchBudget) -> Int Never! {{\n    saved := caps.len()\n    if budget.remaining <= 0 -> return -1\n    budget.remaining = budget.remaining - 1\n    if i < 0 || node < 0 || node >= re.nodes.len() -> return -1\n    n :: re.nodes[node]\n    if n.kind == \"empty\" -> return i\n    if n.kind == \"lit\" {{\n        lit :: n.s.bytes()\n        if i + lit.len() > text.len() -> return -1\n        loop k in 0..<lit.len() {{\n            a :: fold(text[i + k], re.flags.ignore_case)\n            b :: fold(lit[k], re.flags.ignore_case)\n            if a != b -> return -1\n        }}\n        return i + lit.len()\n    }}\n    if n.kind == \"dot\" {{\n        if i >= text.len() -> return -1\n        if text[i] == (U8{{10}}) && !re.flags.dot_matches_newline -> return -1\n        return i + scalar_width(text, i)\n    }}\n    if n.kind == \"start\" {{\n        if i == 0 -> return i\n        if re.flags.multiline && i > 0 && text[i - 1] == (U8{{10}}) -> return i\n        return -1\n    }}\n    if n.kind == \"end\" {{\n        if i == text.len() -> return i\n        if re.flags.multiline && i < text.len() && text[i] == (U8{{10}}) -> return i\n        return -1\n    }}\n    if n.kind == \"seq\" {{\n        end :: exec_sequence(re, text, i, node, &caps, &budget)\n        if end < 0 -> trim_caps(&caps, saved)\n        return end\n    }}\n    if n.kind == \"alt\" {{\n        left_saved := caps.len()\n        a :: exec(re, text, i, n.left, &caps, &budget)\n        if a >= 0 -> return a\n        trim_caps(&caps, left_saved)\n        return exec(re, text, i, n.right, &caps, &budget)\n    }}\n    if n.kind == \"group\" {{\n        slot := caps.len()\n        &caps.push(CaptureSpan{{start: i, end: -1}})\n        end :: exec(re, text, i, n.left, &caps, &budget)\n        if end >= 0 {{\n            caps[slot] = CaptureSpan{{start: i, end: end}}\n            return end\n        }}\n        trim_caps(&caps, saved)\n        return -1\n    }}\n    if n.kind == \"class\" {{\n        if i >= text.len() -> return -1\n        width :: scalar_width(text, i)\n        if text[i] > (U8{{127}}) && !n.neg -> return -1\n        ok :: class_hit(n.s, text[i], re.flags.ignore_case)\n        if n.neg {{\n            if ok -> return -1\n            return i + width\n        }}\n        if ok -> return i + width\n        return -1\n    }}\n    if n.kind == \"rep\" {{\n        end :: exec_rep(re, text, i, n, &caps, 0, &budget)\n        if end < 0 -> trim_caps(&caps, saved)\n        return end\n    }}\n    -1\n}}\n\nfn exec_rep(re: Regex, text: [U8], i: Int, n: Node, caps: &[CaptureSpan], count: Int, budget: &MatchBudget) -> Int Never! {{\n    if n.b >= 0 && count == n.b -> return i\n    if count >= n.a {{\n        rest :: exec_rep_more(re, text, i, n, &caps, count, &budget)\n        if rest >= 0 -> return rest\n        return i\n    }}\n    saved := caps.len()\n    nxt :: exec(re, text, i, n.left, &caps, &budget)\n    if nxt < 0 || (nxt == i && n.b != 0) {{\n        trim_caps(&caps, saved)\n        return -1\n    }}\n    end :: exec_rep(re, text, nxt, n, &caps, count + 1, &budget)\n    if end < 0 -> trim_caps(&caps, saved)\n    end\n}}\n\nfn exec_rep_more(re: Regex, text: [U8], i: Int, n: Node, caps: &[CaptureSpan], count: Int, budget: &MatchBudget) -> Int Never! {{\n    if n.b >= 0 && count >= n.b -> return -1\n    saved := caps.len()\n    nxt :: exec(re, text, i, n.left, &caps, &budget)\n    if nxt < 0 || nxt == i {{\n        trim_caps(&caps, saved)\n        return -1\n    }}\n    after_child := caps.len()\n    deeper :: exec_rep_more(re, text, nxt, n, &caps, count + 1, &budget)\n    if deeper >= 0 -> return deeper\n    trim_caps(&caps, after_child)\n    nxt\n}}\n\nfn class_hit(spec: String, b: U8, fold_case: Bool) -> Bool Never! {{\n    ch :: fold(b, fold_case)\n    raw :: spec.bytes()\n    i := 0\n    loop i < raw.len() {{\n        if raw[i] == (U8{{92}}) && i + 1 < raw.len() {{\n            escaped :: raw[i + 1]\n            if escaped == (U8{{100}}) {{\n                if b >= (U8{{48}}) && b <= (U8{{57}}) -> return true\n                i = i + 2\n                next\n            }}\n            if escaped == (U8{{119}}) {{\n                if ((b >= (U8{{48}}) && b <= (U8{{57}})) ||\n                    (b >= (U8{{65}}) && b <= (U8{{90}})) ||\n                    (b >= (U8{{97}}) && b <= (U8{{122}})) ||\n                    b == (U8{{95}})) -> return true\n                i = i + 2\n                next\n            }}\n            if escaped == (U8{{115}}) {{\n                if b == (U8{{32}}) || b == (U8{{9}}) || b == (U8{{10}}) ||\n                    b == (U8{{13}}) || b == (U8{{11}}) || b == (U8{{12}}) -> return true\n                i = i + 2\n                next\n            }}\n            if fold(escaped, fold_case) == ch -> return true\n            i = i + 2\n            next\n        }}\n        if i + 2 < raw.len() && raw[i + 1] == (U8{{45}}) {{\n            lo :: fold(raw[i], fold_case)\n            hi :: fold(raw[i + 2], fold_case)\n            if ch >= lo && ch <= hi -> return true\n            i = i + 3\n        }} else {{\n            if fold(raw[i], fold_case) == ch -> return true\n            i = i + 1\n        }}\n    }}\n    false\n}}\n\nfn fold(b: U8, on: Bool) -> Int Never! {{\n    n :: b\n    if on && n >= 65 && n <= 90 -> return n + 32\n    n\n}}\n\nfn find_match(pattern: Regex, text: String) -> Match? {{\n    raw :: text.bytes()\n    i := 0\n    loop i <= raw.len() {{\n        caps := [CaptureSpan]{{}}\n        end :: run_exec(pattern, raw, i, pattern.root, &caps)\n        if end >= i {{\n            return Val(make_match(raw, i, end, caps))\n        }}\n        i = i + scalar_width(raw, i)\n    }}\n    None\n}}\n\nfn make_match(raw: [U8], start: Int, end: Int, caps: [CaptureSpan]) -> Match Never! {{\n    groups := [String]{{}}\n    loop g in caps -> &groups.push(slice(raw, g.start, g.end))\n    Match{{start: start, end: end, text: slice(raw, start, end), groups: groups}}\n}}\n\nfn empty_ok(pattern: Regex) -> Bool {{ true }}\n\nfn slice(raw: [U8], start: Int, end: Int) -> String Never! {{\n    out := [U8]{{}}\n    i := start\n    loop {{\n        if i >= end || i >= raw.len() -> return String.from_bytes(out) ?? \"\"\n        &out.push(raw[i])\n        i = i + 1\n    }}\n}}\n\nfn is_group_name_char(b: U8) -> Bool Never! {{\n    n :: b\n    n == 95 ||\n        (n >= 48 && n <= 57) ||\n        (n >= 65 && n <= 90) ||\n        (n >= 97 && n <= 122)\n}}\n\nfn is_meta(b: U8) -> Bool {{\n    n :: b\n    n == 92 || n == 46 || n == 94 || n == 36 || n == 42 || n == 43 || n == 63 || n == 40 || n == 41 || n == 91 || n == 93 || n == 123 || n == 125 || n == 124\n}}\n/// Python-style constructor spelling for a runtime pattern.\npub fn regex(pattern: String) -> Regex RegexError! {{ compile(pattern) }}\n\n/// Return the canonical source pattern represented by a compiled regex.\npub fn join(pattern: Regex) -> String Never! {{ pattern.pattern }}\n/// Python `re` spellings over the same compiled Regex carrier.\npub fn search(pattern: Regex, text: String) -> Match? Never! {{ match(pattern, text) }}\npub fn findall(pattern: Regex, text: String) -> [String] Never! {{ find_all(pattern, text) }}\npub fn fullmatch(pattern: Regex, text: String) -> Bool Never! {{ full_match(pattern, text) }}\npub fn sub(pattern: Regex, text: String, replacement: String) -> String Never! {{\n    replace(pattern, text, replacement)\n}}\npub fn subn(pattern: Regex, text: String, replacement: String) -> (text: String, count: Int) Never! {{\n    ms :: matches(pattern, text)\n    (text: replace(pattern, text, replacement), count: ms.len())\n}}\n"}
}

fn foundation_embedded_core_source_73() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.rt", alias: "core_core_rt", path: "Core/rt/rt.jet", owner: "", owned_members: [String]{"callback"}, source: "\npackage {{\n    name: \"core.rt\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"Realtime callback streams.\"\n    license: \"MIT\"\n    outputs: {{\n        rt: .Library{{ entry: rt }}\n    }}\n}}\nuse core as core\n\n/// Start a fixed-rate callback stream. The callback receives one reusable\n/// sample buffer per invocation and must keep its work bounded.\npub fn callback(rate_hz: Int, frames_per_buffer: Int, callback: fn([Float])) -> RealtimeStream Never! {{\n    core.rt.callback(rate_hz, frames_per_buffer, callback)\n}}"}
}

fn foundation_embedded_core_source_74() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.service", alias: "core_core_service", path: "Core/service/service.jet", owner: "", owned_members: [String]{"tree", "runtime", "state_store", "restart_one_for_one", "restart_one_for_all", "restart_rest_for_one", "delivery_at_most_once", "delivery_durable"}, source: "package {{\n    name: \"core.service\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"Typed service topology, delivery, and workflow handles.\"\n    license: \"MIT\"\n    outputs: {{\n        service: .Library{{ entry: service }}\n    }}\n}}\n\nuse core as core\n\n// core.service is the typed Jet facade for the registered service provider.\n// Topology, authority, delivery, state, and workflow values are provider\n// handles; this source module does not recreate their runtime state.\n\npub fn tree(name: String) -> ServiceTree Never! {{\n    core.service.tree(name)\n}}\n\npub fn runtime(store: String, retention: Duration) -> ServiceRuntime Never! {{\n    core.service.runtime(store, retention: retention)\n}}\n\npub fn state_store(path: String) -> ServiceStateStore ServiceError! {{\n    core.service.state_store(path)\n}}\n\npub fn restart_one_for_one() -> ServiceRestart Never! {{\n    core.service.restart_one_for_one()\n}}\n\npub fn restart_one_for_all() -> ServiceRestart Never! {{\n    core.service.restart_one_for_all()\n}}\n\npub fn restart_rest_for_one() -> ServiceRestart Never! {{\n    core.service.restart_rest_for_one()\n}}\n\npub fn delivery_at_most_once() -> ServiceDelivery Never! {{\n    core.service.delivery_at_most_once()\n}}\n\npub fn delivery_durable() -> ServiceDelivery Never! {{\n    core.service.delivery_durable()\n}}\n"}
}

fn foundation_embedded_core_source_75() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.sync", alias: "core_core_sync", path: "Core/sync/sync.jet", owner: "", owned_members: [String]{"counter_inc", "counter_merge", "counter_new", "counter_value", "list_merge", "list_new", "list_push", "list_show", "map_get", "map_merge", "map_new", "map_set", "map_show", "policy_allows", "policy_new", "policy_show", "text_edit", "text_merge", "text_metadata", "text_new", "text_set", "text_show", "counter_for", "map_for", "map_delete", "map_contains", "map_keys", "list_for", "list_remove", "list_contains", "text_for", "text_append", "text_clock", "text_replica", "policy_grant", "policy_deny", "policy_revoke"}, source: "package {{\n    name: \"core.sync\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"CRDT counters, maps, lists, and text.\"\n    license: \"MIT\"\n    outputs: {{\n        sync: .Library{{ entry: sync }}\n    }}\n}}\n// core.sync — state-based CRDTs. G-counters, LWW-registers in a map\n// RGA-ish lists (id + value + tombstone), and LWW text. Merge is a\n// join: max per replica, last-writer-wins by timestamp.\npub struct SyncCounter {{\n    pub replica: String\n    pub counts: [String:Int]\n}}\n\npub struct SyncMap {{\n    pub replica: String\n    pub clock: Int\n    pub entries: [String:LWW]\n}}\n\npub struct LWW {{\n    pub value: String\n    pub ts: Int\n    pub replica: String\n    pub deleted: Bool\n}}\n\npub struct SyncList {{\n    pub replica: String\n    pub clock: Int\n    pub items: [RGAItem]\n}}\n\npub struct RGAItem {{\n    pub id: String\n    pub value: String\n    pub tombstone: Bool\n}}\n\npub struct SyncText {{\n    pub replica: String\n    pub clock: Int\n    pub value: String\n    pub ts: Int\n}}\n\npub struct RowPolicy {{\n    pub allow: [String]\n    pub deny: [String]\n}}\n\npub fn counter_new() -> SyncCounter Never! {{ counter_for(\"local\") }}\n\npub fn counter_for(replica: String) -> SyncCounter Never! {{\n    id := replica\n    if id.len() == 0 -> id = \"local\"\n    if !valid_sync_text(id, 1048576, false) -> id = \"\"\n    SyncCounter{{replica: id, counts: [String:Int]{{}}}}\n}}\n\npub fn counter_inc(counter: SyncCounter) -> SyncCounter Never! {{\n    if !valid_sync_text(counter.replica, 1048576, false) -> return ~counter\n    cur :: counter.counts.get(counter.replica) ?? 0\n    if cur >= 2147483646 -> return ~counter\n    if counter.counts.len() >= 4096 && counter.counts.get(counter.replica) == None -> return ~counter\n    counts := counter.counts\n    _ :: &counts.add(counter.replica, cur + 1)\n    SyncCounter{{replica: counter.replica, counts: counts}}\n}}\n\npub fn counter_merge(left: SyncCounter, right: SyncCounter) -> SyncCounter Never! {{\n    out := left.counts\n    loop k in right.counts.keys() {{\n        rv :: right.counts.get(k) ?? 0\n        lv :: out.get(k) ?? 0\n        if rv > lv -> _ :: &out.add(k, rv)\n    }}\n    SyncCounter{{replica: left.replica, counts: out}}\n}}\n\npub fn counter_value(counter: SyncCounter) -> Int Never! {{\n    n := 0\n    loop k in counter.counts.keys() -> n += (counter.counts.get(k) ?? 0)\n    n\n}}\n\npub fn map_new() -> SyncMap Never! {{ map_for(\"local\") }}\n\npub fn map_for(replica: String) -> SyncMap Never! {{\n    id := replica\n    if id.len() == 0 -> id = \"local\"\n    if !valid_sync_text(id, 1048576, false) -> id = \"\"\n    SyncMap{{replica: id, clock: 0, entries: [String:LWW]{{}}}}\n}}\n\npub fn map_set(map: SyncMap, key: String, value: String) -> SyncMap Never! {{\n    invalid := !valid_sync_text(map.replica, 1048576, false)\n        || !valid_sync_text(key, 1048576, false)\n        || !valid_sync_text(value, 1048576, true)\n        || map.clock >= 2147483646\n        || (map.entries.len() >= 100000 && map.entries.get(key) == None)\n    if invalid -> return ~map\n    ts :: map.clock + 1\n    e :: LWW{{value: value, ts: ts, replica: ~map.replica, deleted: false}}\n    entries := map.entries\n    _ :: &entries.add(key, e)\n    SyncMap{{replica: ~map.replica, clock: ts, entries: entries}}\n}}\n\npub fn map_delete(map: SyncMap, key: String) -> SyncMap Never! {{\n    invalid := !valid_sync_text(map.replica, 1048576, false)\n        || !valid_sync_text(key, 1048576, false)\n        || map.clock >= 2147483646\n        || (map.entries.len() >= 100000 && map.entries.get(key) == None)\n    if invalid -> return ~map\n    ts :: map.clock + 1\n    entries := map.entries\n    _ :: &entries.add(key, LWW{{value: \"\", ts: ts, replica: ~map.replica, deleted: true}})\n    SyncMap{{replica: ~map.replica, clock: ts, entries: entries}}\n}}\n\npub fn map_contains(map: SyncMap, key: String) -> Bool Never! {{\n    map_get(map, key) != .None\n}}\n\npub fn map_keys(map: SyncMap) -> [String] Never! {{\n    out := [String]{{}}\n    loop key in map.entries.keys() {{\n        entry :: map.entries.get(key) ?? next\n        if !entry.deleted -> &out.push(key)\n    }}\n    out\n}}\n\npub fn map_get(map: SyncMap, key: String) -> String? Never! {{\n    e :: map.entries.get(key) ?? return None\n    if e.deleted -> return None\n    Val(e.value)\n}}\npub fn map_merge(left: SyncMap, right: SyncMap) -> SyncMap Never! {{\n    out := left.entries\n    loop k in right.entries.keys() {{\n        rv :: right.entries.get(k) ?? next\n        lv :: out.get(k)\n        if lv == .None {{\n            _ :: &out.add(k, rv)\n        }} else {{\n            l :: lv\n            // Equal timestamps need a stable order even when a replica forks.\n            // A deletion wins a same-replica fork; otherwise order by value.\n            right_wins := rv.ts > l.ts\n            if rv.ts == l.ts {{\n                if rv.replica > l.replica {{\n                    right_wins = true\n                }} else if rv.replica == l.replica {{\n                    if rv.deleted != l.deleted {{\n                        right_wins = rv.deleted\n                    }} else if rv.value > l.value {{\n                        right_wins = true\n                    }}\n                }}\n            }}\n            if right_wins -> _ :: &out.add(k, rv)\n        }}\n    }}\n    clock := left.clock\n    if right.clock > clock -> clock = right.clock\n    SyncMap{{replica: left.replica, clock: clock, entries: out}}\n}}\n\npub fn map_show(map: SyncMap) -> String Never! {{\n    out := \"{{{{\"\n    first := true\n    loop k in map.entries.keys() {{\n        e :: map.entries.get(k) ?? next\n        if e.deleted -> next\n        if !first -> out = \"{{out}},\"\n        first = false\n        out = \"{{out}}{{k}}:{{e.value}}\"\n    }}\n    \"{{out}}}}}}\"\n}}\n\npub fn list_new() -> SyncList Never! {{ list_for(\"local\") }}\n\npub fn list_for(replica: String) -> SyncList Never! {{\n    id := replica\n    if id.len() == 0 -> id = \"local\"\n    if !valid_sync_text(id, 1048576, false) -> id = \"\"\n    SyncList{{replica: id, clock: 0, items: [RGAItem]{{}}}}\n}}\n\npub fn list_push(list: SyncList, value: String) -> SyncList Never! {{\n    invalid := !valid_sync_text(list.replica, 1048576, false)\n        || !valid_sync_text(value, 1048576, true)\n        || list.clock >= 2147483646\n        || list.items.len() >= 100000\n    if invalid -> return ~list\n    clock :: list.clock + 1\n    id :: \"{{list.replica}}:{{clock}}\"\n    items := [RGAItem]{{}}\n    loop item in list.items -> &items.push(item)\n    &items.push(RGAItem{{id: id, value: value, tombstone: false}})\n    SyncList{{replica: list.replica, clock: clock, items: items}}\n}}\n\npub fn list_remove(list: SyncList, id: String) -> SyncList Never! {{\n    if id.len() == 0 || !valid_sync_text(list.replica, 1048576, false) -> return ~list\n    items := [RGAItem]{{}}\n    found := false\n    changed := false\n    loop item in ~list.items {{\n        if item.id == id {{\n            found = true\n            if item.tombstone {{\n                &items.push(item)\n            }} else {{\n                &items.push(RGAItem{{id: item.id, value: item.value, tombstone: true}})\n                changed = true\n            }}\n        }} else {{\n            &items.push(item)\n        }}\n    }}\n    if !found || !changed || list.clock >= 2147483646 -> return ~list\n    SyncList{{replica: list.replica, clock: list.clock + 1, items: items}}\n}}\n\npub fn list_contains(list: SyncList, id: String) -> Bool Never! {{\n    loop item in ~list.items {{\n        if item.id == id && !item.tombstone -> return true\n    }}\n    false\n}}\n\npub fn list_merge(left: SyncList, right: SyncList) -> SyncList Never! {{\n    seen := [String:RGAItem]{{}}\n    order := [String]{{}}\n    loop item in left.items {{\n        old :: seen.get(item.id)\n        if old == .None {{\n            _ :: &seen.add(~item.id, ~item)\n            &order.push(item.id)\n        }} else {{\n            current :: old\n            if item.tombstone && !current.tombstone {{\n                _ :: &seen.add(~item.id, ~item)\n            }} else if item.tombstone == current.tombstone && item.value > current.value {{\n                _ :: &seen.add(~item.id, ~item)\n            }}\n        }}\n    }}\n    loop item in right.items {{\n        old :: seen.get(item.id)\n        if old == .None {{\n            _ :: &seen.add(~item.id, ~item)\n            &order.push(item.id)\n        }} else {{\n            current :: old\n            if item.tombstone && !current.tombstone {{\n                _ :: &seen.add(~item.id, ~item)\n            }} else if item.tombstone == current.tombstone && item.value > current.value {{\n                _ :: &seen.add(~item.id, ~item)\n            }}\n        }}\n    }}\n    i := 1\n    loop i < order.len() {{\n        key :: ~order[i]\n        j := i\n        loop j > 0 && order[j - 1] > key {{\n            order[j] = order[j - 1]\n            j -= 1\n        }}\n        order[j] = key\n        i += 1\n    }}\n    items := [RGAItem]{{}}\n    loop id in order -> &items.push(seen.get(id) ?? RGAItem{{id: id, value: \"\", tombstone: true}})\n    clock := left.clock\n    if right.clock > clock -> clock = right.clock\n    SyncList{{replica: left.replica, clock: clock, items: items}}\n}}\n\npub fn list_show(list: SyncList) -> String Never! {{\n    out := \"[\"\n    first := true\n    loop item in list.items {{\n        if item.tombstone -> next\n        if !first -> out = \"{{out}},\"\n        first = false\n        out = \"{{out}}{{item.value}}\"\n    }}\n    \"{{out}}]\"\n}}\n\npub fn text_new() -> SyncText Never! {{ text_for(\"local\") }}\n\npub fn text_for(replica: String) -> SyncText Never! {{\n    id := replica\n    if id.len() == 0 -> id = \"local\"\n    if !valid_sync_text(id, 1048576, false) -> id = \"\"\n    SyncText{{replica: id, clock: 0, value: \"\", ts: 0}}\n}}\npub fn text_set(text: SyncText, value: String) -> SyncText Never! {{\n    invalid := !valid_sync_text(text.replica, 1048576, false)\n        || !valid_sync_text(value, 1048576, true)\n        || text.clock >= 2147483646\n    if invalid -> return ~text\n    ts :: text.clock + 1\n    SyncText{{replica: text.replica, clock: ts, value: value, ts: ts}}\n}}\n\npub fn text_edit(text: SyncText, value: String) -> SyncText Never! {{ text_set(text, value) }}\n\npub fn text_merge(left: SyncText, right: SyncText) -> SyncText Never! {{\n    invalid := !valid_sync_text(left.replica, 1048576, false)\n        || !valid_sync_text(right.replica, 1048576, false)\n    if invalid -> return ~left\n    if right.ts > left.ts || (right.ts == left.ts && right.replica > left.replica) {{\n        clock := left.clock\n        if right.clock > clock -> clock = right.clock\n        return SyncText{{replica: left.replica, clock: clock, value: right.value, ts: right.ts}}\n    }}\n    clock := left.clock\n    if right.clock > clock -> clock = right.clock\n    SyncText{{replica: left.replica, clock: clock, value: left.value, ts: left.ts}}\n}}\n\npub fn text_append(text: SyncText, suffix: String) -> SyncText Never! {{\n    if text.value.len() + suffix.len() > 1048576 -> return ~text\n    text_set(text, \"{{text.value}}{{suffix}}\")\n}}\n\npub fn text_clock(text: SyncText) -> Int Never! {{ text.clock }}\npub fn text_replica(text: SyncText) -> String Never! {{ text.replica }}\n\npub fn policy_grant(policy: RowPolicy, action: String) -> RowPolicy Never! {{\n    if action.len() == 0 || contains(policy.allow, action) -> return ~policy\n    allow := ~policy.allow\n    &allow.push(action)\n    RowPolicy{{allow: allow, deny: ~policy.deny}}\n}}\n\npub fn policy_deny(policy: RowPolicy, action: String) -> RowPolicy Never! {{\n    if action.len() == 0 || contains(policy.deny, action) -> return ~policy\n    deny := ~policy.deny\n    &deny.push(action)\n    RowPolicy{{allow: ~policy.allow, deny: deny}}\n}}\n\npub fn policy_revoke(policy: RowPolicy, action: String) -> RowPolicy Never! {{\n    allow := [String]{{}}\n    loop item in ~policy.allow {{\n        if item != action -> &allow.push(item)\n    }}\n    deny := [String]{{}}\n    loop item in ~policy.deny {{\n        if item != action -> &deny.push(item)\n    }}\n    RowPolicy{{allow: allow, deny: deny}}\n}}\n\nfn valid_sync_text(text: String, limit: Int, allow_empty: Bool) -> Bool {{\n    if !allow_empty && text.len() == 0 -> return false\n    if text.len() > limit -> return false\n    loop b in text.bytes() {{\n        n :: Int.from_u8(b)\n        if n < 32 || n == 127 -> return false\n    }}\n    true\n}}\n\nfn contains(items: [String], value: String) -> Bool {{\n    loop item in items {{\n        if item == value -> return true\n    }}\n    false\n}}\n\npub fn text_show(text: SyncText) -> String Never! {{ text.value }}\n\npub fn text_metadata(text: SyncText) -> String Never! {{ \"{{text.replica}}@{{text.ts}}\" }}\n\npub fn policy_new() -> RowPolicy Never! {{ RowPolicy{{allow: [String]{{}}, deny: [String]{{}}}} }}\n\npub fn policy_allows(policy: RowPolicy, action: String) -> Bool Never! {{\n    loop d in policy.deny {{\n        if d == action || d == \"*\" -> return false\n    }}\n    if policy.allow.len() == 0 -> return true\n    loop a in policy.allow {{\n        if a == action || a == \"*\" -> return true\n    }}\n    false\n}}\n\npub fn policy_show(policy: RowPolicy) -> String Never! {{\n    \"allow={{policy.allow.len()}} deny={{policy.deny.len()}}\"\n}}\n"}
}

fn foundation_embedded_core_source_76() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.sys", alias: "core_sys", path: "Core/sys/sys.jet", owner: "", owned_members: [String]{"success", "arch", "close_fd", "cpu_count", "current_dir", "executable", "exitcode", "expand", "family", "fork", "get", "getegid", "getenv", "geteuid", "getgid", "getgroups", "getpgid", "getpgrp", "getpid", "getppid", "getpriority", "getsid", "getuid", "home_dir", "hostname", "initgroups", "is_linux", "is_macos", "is_unix", "is_windows", "kill", "linesep", "loadavg", "machine", "mkfifo", "name", "pathsep", "pid", "pipe", "platform", "release", "set", "set_current_dir", "setgid", "setpgid", "setpgrp", "setpriority", "setsid", "setuid", "stop", "sync", "sysname", "temp_dir", "times", "umask", "uname", "unset", "uptime", "username", "utime", "vars", "version", "wait", "waitpid"}, source: "package {{\n    name: \"core.sys\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"System environment and process operations.\"\n    license: \"MIT\"\n    outputs: {{\n        sys: .Library{{ entry: sys }}\n    }}\n}}\nuse core as core\n\n\npub fn get(name: String) -[Env]> String? Never! {{ core.sys.get(name) }}\n\npub fn set(name: String, value: String) Never! -[Env]> {{ core.sys.set(name, value) }}\n\npub fn unset(name: String) -[Env]> Bool EnvError! {{ core.sys.unset(name) }}\n\npub fn vars() -[Env]> [String] EnvError! {{ core.sys.vars() }}\n\npub fn current_dir() -[FS, Env]> String IOError! {{ core.sys.current_dir() }}\n\npub fn home_dir() -[Env]> String? Never! {{\n    home :: get(\"HOME\")\n    if home != None -> return Val(home)\n    get(\"USERPROFILE\")\n}}\n\npub fn name() -[Env]> String Never! {{ core.sys.name() }}\n\npub fn family() -[Env]> String Never! {{\n    platform_name :: ascii_lower(name())\n    if platform_name == \"windows\" || platform_name.starts_with(\"windows\") -> return \"windows\"\n    if platform_name == \"linux\" || platform_name == \"darwin\" || platform_name == \"macos\" || platform_name == \"osx\" || platform_name == \"freebsd\" || platform_name == \"openbsd\" || platform_name == \"netbsd\" || platform_name == \"android\" {{\n        return \"unix\"\n    }}\n    platform_name\n}}\n\npub fn arch() -[Env]> String Never! {{ core.sys.arch() }}\n\npub fn temp_dir() -[Env]> String Never! {{\n    tmp :: get(\"TMPDIR\")\n    if tmp != None -> return tmp\n    temp :: get(\"TEMP\")\n    if temp != None -> return temp\n    fallback :: get(\"TMP\")\n    if fallback != None -> return fallback\n    \"/tmp\"\n}}\n\npub fn executable() -[Env]> String Never! {{ core.sys.executable() }}\n\npub fn hostname() -[Env]> String Never! {{ core.sys.hostname() }}\n\npub fn username() -[Env]> String Never! {{\n    user :: get(\"USER\")\n    if user != None -> return user\n    username :: get(\"USERNAME\")\n    if username != None -> return username\n    core.sys.username()\n}}\n\npub fn release() -[Env]> String Never! {{ core.sys.release() }}\n\npub fn version() -[Env]> String Never! {{ core.sys.version() }}\n\npub fn expand(value: String) -[Env]> String Never! {{\n    raw :: value.bytes()\n    out := [U8]{{}}\n    i := 0\n    loop {{\n        if i >= raw.len() -> return String.from_bytes(out) ?? value\n        byte :: raw[i]\n        if byte == (U8{{36}}) {{\n            if i + 1 < raw.len() && raw[i + 1] == (U8{{36}}) {{\n                &out.push(U8{{36}})\n                i = i + 2\n                next\n            }}\n            if i + 1 < raw.len() && raw[i + 1] == (U8{{123}}) {{\n                j := i + 2\n                loop {{\n                    if j >= raw.len() -> break\n                    if raw[j] == (U8{{125}}) -> break\n                    j = j + 1\n                }}\n                if j >= raw.len() {{\n                    &out.push(byte)\n                    i = i + 1\n                    next\n                }}\n                key :: slice_ascii(raw, i + 2, j)\n                replacement :: get(key) ?? \"\"\n                loop item in replacement.bytes() -> &out.push(item)\n                i = j + 1\n                next\n            }}\n            j := i + 1\n            loop {{\n                if j >= raw.len() || !is_env_ident(raw[j]) -> break\n                j = j + 1\n            }}\n            if j == i + 1 {{\n                &out.push(byte)\n                i = i + 1\n                next\n            }}\n            key :: slice_ascii(raw, i + 1, j)\n            replacement :: get(key) ?? \"\"\n            loop item in replacement.bytes() -> &out.push(item)\n            i = j\n            next\n        }}\n        if byte == (U8{{37}}) {{\n            j := i + 1\n            loop {{\n                if j >= raw.len() -> break\n                if raw[j] == (U8{{37}}) -> break\n                j = j + 1\n            }}\n            if j < raw.len() && raw[j] == (U8{{37}}) && j > i + 1 {{\n                key :: slice_ascii(raw, i + 1, j)\n                replacement :: get(key) ?? \"\"\n                loop item in replacement.bytes() -> &out.push(item)\n                i = j + 1\n                next\n            }}\n        }}\n        &out.push(byte)\n        i = i + 1\n    }}\n}}\n\npub fn pid() -[Env]> Int Never! {{ core.sys.getpid() }}\n\npub fn getpid() -[Env]> Int Never! {{ core.sys.getpid() }}\n\npub fn cpu_count() -[Env]> Int Never! {{\n    count :: core.sys.cpu_count()\n    if count < 1 -> return 1\n    count\n}}\n\npub fn getppid() -[Env]> Int Never! {{ core.sys.getppid() }}\n\npub fn getuid() -[Env]> Int Never! {{ core.sys.getuid() }}\n\npub fn geteuid() -[Env]> Int Never! {{ core.sys.geteuid() }}\n\npub fn getgid() -[Env]> Int Never! {{ core.sys.getgid() }}\n\npub fn getegid() -[Env]> Int Never! {{ core.sys.getegid() }}\n\npub fn getpgrp() -[Env]> Int Never! {{ core.sys.getpgrp() }}\n\npub fn umask(mask: Int) -[FS, Env]> Int Never! {{\n    #Unsafe(\"posix umask: change the process file-creation mask\") {{\n        return core.sys.umask(mask)\n    }}\n}}\npub fn exitcode(code: Int) -> Int Never! {{ code }}\n\npub fn success(code: Int) -> Bool Never! {{ code == 0 }}\n\npub fn uptime() -[Time, Env]> Float Never! {{ core.sys.uptime() }}\n\npub fn getgroups() -[Env]> [Int] Never! {{ core.sys.getgroups() }}\n\npub fn loadavg() -[Env]> [Float] Never! {{ core.sys.loadavg() }}\n\npub fn times() -[Env]> [Float] Never! {{ core.sys.times() }}\n\npub fn getpgid(pid: Int) -[Env]> Int IOError! {{\n    #Unsafe(\"posix getpgid: inspect a process group\") {{\n        return core.sys.getpgid(pid)\n    }}\n}}\n\npub fn getsid(pid: Int) -[Env]> Int IOError! {{\n    #Unsafe(\"posix getsid: inspect a process session\") {{\n        return core.sys.getsid(pid)\n    }}\n}}\n\npub fn getpriority(which: Int) -[Env]> Int IOError! {{\n    #Unsafe(\"posix getpriority: read process scheduling priority\") {{\n        return core.sys.getpriority(which)\n    }}\n}}\n\npub fn setpriority(which: Int, priority: Int) IOError! -[Env]> {{\n    #Unsafe(\"posix setpriority: change process scheduling priority\") {{\n        return core.sys.setpriority(which, priority)\n    }}\n}}\n\npub fn utime(path: String, atime: Int, mtime: Int) IOError! -[FS, Env]> {{\n    #Unsafe(\"posix utime: change file timestamps\") {{\n        return core.sys.utime(path, atime, mtime)\n    }}\n}}\n\npub fn sync() Never! -[FS, Env]> {{ core.sys.sync() }}\n\npub fn stop(code: Int) Never! -[Env]> {{\n    #Unsafe(\"posix stop: terminate the process with an exit code\") {{\n        core.sys.stop(code)\n    }}\n}}\n\npub fn set_current_dir(path: String) IOError! -[FS, Env]> {{\n    return core.sys.set_current_dir(path)\n}}\npub fn pipe() -[FS, Env]> [Int] IOError! {{\n    #Unsafe(\"posix pipe: create process file descriptors\") {{\n        return core.sys.pipe()\n    }}\n}}\n\npub fn close_fd(fd: Int) Never! -[FS, Env]> {{\n    #Unsafe(\"posix close_fd: close a process file descriptor\") {{\n        core.sys.close_fd(fd)\n    }}\n}}\n\npub fn mkfifo(path: String, mode: Int) IOError! -[FS, Env]> {{\n    #Unsafe(\"posix mkfifo: create a named pipe\") {{\n        return core.sys.mkfifo(path, mode)\n    }}\n}}\n\npub fn fork() -[Env]> Int IOError! {{\n    #Unsafe(\"posix fork: create a child process\") {{\n        return core.sys.fork()\n    }}\n}}\n\npub fn setsid() -[Env]> Int IOError! {{\n    #Unsafe(\"posix setsid: create a process session\") {{\n        return core.sys.setsid()\n    }}\n}}\n\npub fn wait() -[Env, Time.Wait]> Int IOError! {{\n    #Unsafe(\"posix wait: reap a child process\") {{\n        return core.sys.wait()\n    }}\n}}\n\npub fn waitpid(pid: Int, options: Int) -[Env, Time.Wait]> Int IOError! {{\n    #Unsafe(\"posix waitpid: reap a selected child process\") {{\n        return core.sys.waitpid(pid, options)\n    }}\n}}\n\npub fn setuid(uid: Int) IOError! -[Env]> {{\n    #Unsafe(\"posix setuid: change process credentials\") {{\n        return core.sys.setuid(uid)\n    }}\n}}\n\npub fn setgid(gid: Int) IOError! -[Env]> {{\n    #Unsafe(\"posix setgid: change process credentials\") {{\n        return core.sys.setgid(gid)\n    }}\n}}\n\npub fn setpgrp() IOError! -[Env]> {{\n    #Unsafe(\"posix setpgrp: change process group topology\") {{\n        return core.sys.setpgrp()\n    }}\n}}\n\npub fn setpgid(pid: Int, pgid: Int) IOError! -[Env]> {{\n    #Unsafe(\"posix setpgid: change process group topology\") {{\n        return core.sys.setpgid(pid, pgid)\n    }}\n}}\n\npub fn kill(pid: Int, signal: Int) IOError! -[Env]> {{\n    #Unsafe(\"posix kill: send a signal to a process\") {{\n        return core.sys.kill(pid, signal)\n    }}\n}}\n\npub fn initgroups(user: String, group: Int) IOError! -[Env]> {{\n    #Unsafe(\"posix initgroups: change supplementary groups\") {{\n        return core.sys.initgroups(user, group)\n    }}\n}}\n\n\npub fn platform() -[Env]> String Never! {{ \"{{name()}}-{{arch()}}\" }}\n\npub fn is_windows() -[Env]> Bool Never! {{ family() == \"windows\" }}\n\npub fn is_unix() -[Env]> Bool Never! {{ family() == \"unix\" }}\n\npub fn is_linux() -[Env]> Bool Never! {{\n    platform_name :: ascii_lower(name())\n    platform_name == \"linux\"\n}}\n\npub fn is_macos() -[Env]> Bool Never! {{\n    platform_name :: ascii_lower(name())\n    platform_name == \"macos\" || platform_name == \"darwin\" || platform_name == \"osx\"\n}}\n\npub fn uname() -[Env]> String Never! {{ \"{{name()}} {{release()}} {{version()}} {{arch()}}\" }}\n\npub fn sysname() -[Env]> String Never! {{ name() }}\n\npub fn machine() -[Env]> String Never! {{ arch() }}\n\npub fn getenv(name: String) -[Env]> String? Never! {{ get(name) }}\n\npub fn pathsep() -[Env]> String Never! {{\n    if is_windows() -> return \";\"\n    \":\"\n}}\n\npub fn linesep() -[Env]> String Never! {{\n    if is_windows() -> return String.from_bytes([U8]{{13, 10}}) ?? \"\"\n    \"\\n\"\n}}\nfn is_env_ident(byte: U8) -> Bool {{\n    n :: byte\n    if n >= 65 && n <= 90 -> return true\n    if n >= 97 && n <= 122 -> return true\n    if n >= 48 && n <= 57 -> return true\n    n == 95\n}}\n\nfn slice_ascii(raw: [U8], start: Int, end: Int) -> String {{\n    out := [U8]{{}}\n    i := start\n    loop {{\n        if i >= end -> return String.from_bytes(out) ?? \"\"\n        &out.push(raw[i])\n        i = i + 1\n    }}\n}}\n\nfn ascii_lower(text: String) -> String {{\n    out := [U8]{{}}\n    loop byte in text.bytes() {{\n        n :: byte\n        if n >= 65 && n <= 90 -> &out.push(U8{{n + 32}}) else -> &out.push(byte)\n    }}\n    String.from_bytes(out) ?? text\n}}\n"}
}

fn foundation_embedded_core_source_77() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.tasks", alias: "core_core_tasks", path: "Core/tasks/tasks.jet", owner: "", owned_members: [String]{"acquire", "after", "channel", "clear", "current_task", "delay_ms", "get", "interval", "is_interval", "is_timer", "lock", "notify", "put", "recv", "release", "reset", "result", "run", "shutdown", "start", "stop", "wait", "waitall", "waitany", "yield_now", "is_cancelled", "is_ready", "timeout", "sleep", "try_recv", "cancel", "is_closed", "is_locked", "size", "capacity", "generation", "spawn_name"}, source: "package {{\n    name: \"core.tasks\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"Tasks, timers, and the current trace id.\"\n    license: \"MIT\"\n    outputs: {{\n        tasks: .Library{{ entry: tasks }}\n    }}\n}}\nuse core as core\nuse core.time as time\n\n\n// core.tasks — cooperative tasks on the Jet scheduler.\n//\n// `after` is a one-shot timer channel: after the supplied duration it yields\n// `value`. `interval` yields 1, 2, 3, … on the period. `yield_now` returns\n// control without sleeping. The live builtins are generic; this source\n// records the `Int` specialisation used by the convenience wrappers below.\n//\n// Timer creation and channel parking are host scheduler cells; the stateful\n// TaskState helpers remain pure Jet.\n\n\n\npub struct TaskState {{\n    pub values: [Int]\n    pub capacity: Int\n    pub closed: Bool\n    pub locked: Bool\n    pub generation: Int\n}}\n\npub fn channel(capacity: Int) -> TaskState Never! {{\n    cap := capacity\n    if cap < 0 -> cap = 0\n    TaskState{{values: [Int]{{}}, capacity: cap, closed: false, locked: false, generation: 0}}\n}}\n\npub fn put(state: TaskState, value: Int) -> TaskState Never! {{\n    if state.closed -> return ~state\n    if state.capacity > 0 && state.values.len() >= state.capacity -> return ~state\n    values := ~state.values\n    &values.push(value)\n    TaskState{{\n        values: values,\n        capacity: state.capacity,\n        closed: state.closed,\n        locked: state.locked,\n        generation: state.generation + 1,\n    }}\n}}\n\npub fn clear(state: TaskState) -> TaskState Never! {{\n    if state.values.len() == 0 -> return ~state\n    TaskState{{values: [Int]{{}}, capacity: state.capacity, closed: state.closed, locked: state.locked, generation: state.generation + 1}}\n}}\n\npub fn shutdown(state: TaskState) -> TaskState Never! {{\n    if state.closed -> return ~state\n    TaskState{{values: ~state.values, capacity: state.capacity, closed: true, locked: state.locked, generation: state.generation + 1}}\n}}\n\npub fn stop(state: TaskState) -> TaskState Never! {{ shutdown(state) }}\n\npub fn reset(state: TaskState) -> TaskState Never! {{\n    TaskState{{values: [Int]{{}}, capacity: state.capacity, closed: false, locked: false, generation: state.generation + 1}}\n}}\n\npub fn lock() -> TaskState Never! {{ channel(1) }}\n\npub fn acquire(state: TaskState) -> TaskState Never! {{\n    if state.closed || state.locked -> return ~state\n    TaskState{{values: ~state.values, capacity: state.capacity, closed: state.closed, locked: true, generation: state.generation + 1}}\n}}\n\npub fn release(state: TaskState) -> TaskState Never! {{\n    if !state.locked -> return ~state\n    TaskState{{values: ~state.values, capacity: state.capacity, closed: state.closed, locked: false, generation: state.generation + 1}}\n}}\n\npub fn notify(state: TaskState) -> TaskState Never! {{\n    TaskState{{values: ~state.values, capacity: state.capacity, closed: state.closed, locked: state.locked, generation: state.generation + 1}}\n}}\n\npub fn start(rx: Receiver<Int>) -> Receiver<Int> Never! {{ ~rx }}\n\npub fn run() Never! -[Time.Wait]> {{\n    yield_now()\n}}\n\npub fn waitall(receivers: [Receiver<Int>]) -[Time.Wait]> [Int] Never! {{\n    out := [Int]{{}}\n    loop rx in receivers -> &out.push(wait(rx))\n    out\n}}\n\npub fn waitany(receivers: [Receiver<Int>]) -[Time.Wait]> Int Never! {{\n    if receivers.len() == 0 -> return -1\n    // Receiver readiness is owned by the scheduler's opaque handle. This\n    // convenience rail keeps the deterministic first-arm selection; callers\n    // needing a true race should use the host select surface.\n    wait(receivers[0])\n}}\n\npub fn after(delay: time.Duration, value: Int{{0}}) -[Time]> Receiver<Int> Never! {{\n    core.tasks.after(delay, value)\n}}\n\npub fn interval(period: time.Duration) -[Time]> Receiver<Int> Never! {{\n    core.tasks.interval(period)\n}}\n\npub fn yield_now() Never! -[Time.Wait]> {{ host_yield() }}\n\npub fn current_task() -> String Never! {{ host_task_id() }}\n\n/// Receive from the host scheduler channel. A closed channel maps to the\n/// existing integer sentinel because this convenience rail is non-fallible.\npub fn recv(rx: Receiver<Int>) -[Time.Wait]> Int Never! {{\n    value :: rx.receive() ?? return -1\n    value\n}}\n\n/// Blocking receive spellings used by queue/future adapters.\npub fn get(rx: Receiver<Int>) -[Time.Wait]> Int Never! {{ recv(rx) }}\n\npub fn result(rx: Receiver<Int>) -[Time.Wait]> Int Never! {{ recv(rx) }}\n\npub fn wait(rx: Receiver<Int>) -[Time.Wait]> Int Never! {{ recv(rx) }}\n\n\nfn host_sleep_ms(ms: Int) -[Time]> {{\n    _ :: recv(core.tasks.after(Duration.milliseconds(ms) ?? panic(\"sleep duration is outside Duration's range\"), 0))\n}}\n\n\nfn host_yield() -[Time.Wait]> {{ core.tasks.yield_now() }}\n\nfn host_task_id() -> String {{ core.tasks.current_task() }}\n\n/// Receiver metadata is owned by the scheduler's typed handle.\npub fn is_timer(rx: Receiver<Int>) -> Bool Never! {{ rx.is_timer() }}\n\npub fn is_interval(rx: Receiver<Int>) -> Bool Never! {{ rx.is_interval() }}\n\npub fn is_cancelled(rx: Receiver<Int>) -> Bool Never! {{ rx.is_cancelled() }}\n\npub fn is_ready(rx: Receiver<Int>) -> Bool Never! {{ rx.is_ready() }}\n\npub fn delay_ms(rx: Receiver<Int>) -> Int Never! {{ rx.delay_ms() }}\n\npub fn timeout(delay: time.Duration) Never! -[Time]> {{\n    _ :: recv(core.tasks.after(delay, 0))\n}}\n\npub fn sleep(ms: Int) Never! -[Time]> {{\n    delay := ms\n    if delay < 0 -> delay = 0\n    host_sleep_ms(delay)\n}}\n\npub fn try_recv(rx: Receiver<Int>) -> Int? Never! {{ rx.try_receive() }}\n\n/// Closing the receiver wakes blocked consumers and is the host cancellation\n/// operation. The returned handle remains usable for identity/ownership.\npub fn cancel(rx: Receiver<Int>) -[Time]> Receiver<Int> Never! {{\n    rx.close()\n    ~rx\n}}\n\npub fn is_closed(state: TaskState) -> Bool Never! {{ state.closed }}\npub fn is_locked(state: TaskState) -> Bool Never! {{ state.locked }}\npub fn size(state: TaskState) -> Int Never! {{ state.values.len() }}\npub fn capacity(state: TaskState) -> Int Never! {{ state.capacity }}\npub fn generation(state: TaskState) -> Int Never! {{ state.generation }}\n\npub fn spawn_name(name: String) -> String Never! {{\n    ~name\n}}\n\n\n"}
}

fn foundation_embedded_core_source_78() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.term", alias: "core_core_term", path: "Core/term/term.jet", owner: "", owned_members: [String]{"binread", "binwrite", "buffered", "choose", "confirm", "eprint", "input", "input_secret", "print", "progress", "read_all_input", "read_key", "read_until", "readline", "stderr", "stdin", "stdout", "style", "style_force", "terminal_height", "terminal_width"}, source: "package {{\n    name: \"core.term\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"Stdio, prompts, and terminal style.\"\n    license: \"MIT\"\n    outputs: {{\n        term: .Library{{ entry: term }}\n    }}\n}}\nuse core as core\n// core.term — the connected terminal.\n//\n// `print` / `eprint` write UTF-8. `input` / `readline` / `read_until` read\n// lines. `input_secret` disables echo. `style` is a no-op when stdout is not\n// a TTY unless `style_force` is used. Width and height fall back to 80x24.\n//\n// ANSI SGR parsing is Jet. Byte IO is host (fd 0/1/2).\npub struct Reader {{\n    pub fd: Int\n}}\n\npub struct Writer {{\n    pub fd: Int\n}}\n\npub struct StdinHandle {{\n    pub fd: Int\n}}\n\npub struct Stdout {{\n    pub fd: Int\n}}\n\npub struct Stderr {{\n    pub fd: Int\n}}\n\npub enum Key {{\n    Char(String)\n    Escape\n    Backspace\n    Tab\n    Up\n    Down\n    Left\n    Right\n    Unknown\n}}\npub fn print(text: String) Never! -[IO, Time.Wait]> {{\n    out :: core.term.stdout()\n    &out.write_line(text).drop(\"stdout write\")\n}}\n\npub fn eprint(text: String) Never! -[IO]> {{ core.term.eprint(text) }}\n\npub fn input(prompt: String{{\"\"}}) -[IO, Time.Wait]> String IOError! {{\n    core.term.input(prompt)\n}}\n\npub fn input_secret(prompt: String) -[IO, Time.Wait]> String IOError! {{\n    core.term.input_secret(prompt)\n}}\n\npub fn read_all_input() -[IO, Time.Wait]> String IOError! {{ core.term.read_all_input() }}\n\npub fn readline() -[IO, Time.Wait]> String IOError! {{ core.term.readline() }}\n\npub fn read_until(delimiter: String) -[IO, Time.Wait]> String IOError! {{\n    if delimiter.len() == 0 -> return Err(term_input_error(\"read_until\", delimiter, \"delimiter must not be empty\"))\n    core.term.read_until(delimiter)\n}}\n\npub fn binread(path: String) -[IO, Time.Wait]> [U8] IOError! {{\n    core.term.binread(path)\n}}\n\npub fn binwrite(path: String, bytes: [U8]) IOError! -[IO, Time.Wait]> {{\n    core.term.binwrite(path, bytes)\n}}\n\npub fn confirm(prompt: String) -[IO, Time.Wait]> Bool Never! {{ core.term.confirm(prompt) }}\n\npub fn choose(prompt: String, options: [String]) -[IO, Time.Wait]> String IOError! {{\n    if options.len() == 0 -> return Err(term_input_error(\"choose\", prompt, \"choose needs at least one item\"))\n    core.term.choose(prompt, options)\n}}\n\npub fn stdin() -> StdinHandle Never! {{ core.term.stdin() }}\n\npub fn stdout() -> Stdout Never! {{ core.term.stdout() }}\n\npub fn stderr() -> Stderr Never! {{ core.term.stderr() }}\n\npub fn buffered() -> StdinHandle Never! {{ core.term.buffered() }}\n\npub fn terminal_width() -[IO]> Int Never! {{ core.term.terminal_width() }}\n\npub fn terminal_height() -[IO]> Int Never! {{ core.term.terminal_height() }}\n\npub fn style(style: String, text: String) -[IO]> String Never! {{ core.term.style(style, text) }}\n\npub fn style_force(style: String, text: String) -> String Never! {{\n    codes :: sgr(style)\n    if codes.len() == 0 -> return ~text\n    esc :: String.from_bytes([U8]{{27}}) ?? \"\"\n    return \"{{esc}}[{{codes}}m{{text}}{{esc}}[0m\"\n}}\n\n\npub fn read_key() -[IO, Time.Wait]> Key Never! {{ core.term.read_key() }}\n\npub struct WinSize {{\n    pub w: Int\n    pub h: Int\n}}\npub fn progress(label: String) IOError! -[IO, Time.Wait]> {{ core.term.progress(label) }}\n\nfn term_input_error(operation: String, resource: String, cause: String) -> IOError Never! {{\n    IOError.InvalidInput(IOContext{{\n        operation: .Read,\n        resource: Val(resource),\n        os_code: None,\n        cause: Val(\"{{operation}}: {{cause}}\"),\n    }})\n}}\nfn sgr(spec: String) -> String {{\n    parts := [String]{{}}\n    cur := [U8]{{}}\n    loop b in spec.bytes() {{\n        if b == (U8{{32}}) || b == (U8{{44}}) || b == (U8{{59}}) {{\n            token :: ascii_lower(String.from_bytes(cur) ?? \"\")\n            cur = [U8]{{}}\n            code :: token_code(token)\n            if code.len() > 0 -> &parts.push(code)\n        }} else {{ &cur.push(b) }}\n    }}\n    token :: ascii_lower(String.from_bytes(cur) ?? \"\")\n    code :: token_code(token)\n    if code.len() > 0 -> &parts.push(code)\n    out := \"\"\n    loop i in 0..<parts.len() {{\n        if i > 0 -> out = \"{{out}};\"\n        out = \"{{out}}{{parts[i]}}\"\n    }}\n    out\n}}\n\nfn token_code(token: String) -> String {{\n    numeric :: parse_int(token) ?? -1\n    if numeric >= 0 && numeric <= 109 -> return \"{{numeric}}\"\n    if token == {{\n        \"bold\" -> \"1\"\n        \"dim\" -> \"2\"\n        \"italic\" -> \"3\"\n        \"underline\" -> \"4\"\n        \"inverse\" | \"reverse\" -> \"7\"\n        \"strike\" | \"strikethrough\" -> \"9\"\n        \"black\" -> \"30\"\n        \"red\" -> \"31\"\n        \"green\" -> \"32\"\n        \"yellow\" -> \"33\"\n        \"blue\" -> \"34\"\n        \"magenta\" -> \"35\"\n        \"cyan\" -> \"36\"\n        \"white\" -> \"37\"\n        \"bg-black\" -> \"40\"\n        \"bg-red\" -> \"41\"\n        \"bg-green\" -> \"42\"\n        \"bg-yellow\" -> \"43\"\n        \"bg-blue\" -> \"44\"\n        \"bg-magenta\" -> \"45\"\n        \"bg-cyan\" -> \"46\"\n        \"bg-white\" -> \"47\"\n        \"reset\" -> \"0\"\n        else -> \"\"\n    }}\n}}\n\nfn chomp(text: String) -> String {{\n    raw :: text.bytes()\n    n := raw.len()\n    if n > 0 && raw[n - 1] == (U8{{10}}) -> n = n - 1\n    if n > 0 && raw[n - 1] == (U8{{13}}) -> n = n - 1\n    slice_bytes(raw, 0, n)\n}}\n\nfn slice_bytes(raw: [U8], start: Int, end: Int) -> String {{\n    out := [U8]{{}}\n    i := start\n    loop {{\n        if i >= end -> return String.from_bytes(out) ?? \"\"\n        &out.push(raw[i])\n        i = i + 1\n    }}\n}}\n\nfn ends_with_bytes(hay: [U8], needle: [U8]) -> Bool {{\n    if needle.len() > hay.len() -> return false\n    off :: hay.len() - needle.len()\n    loop i in 0..<needle.len() {{\n        if hay[off + i] != needle[i] -> return false\n    }}\n    true\n}}\n\nfn ascii_lower(text: String) -> String {{\n    out := [U8]{{}}\n    loop b in text.bytes() {{\n        n :: b\n        if n >= 65 && n <= 90 -> &out.push(U8{{n + 32}}) else -> &out.push(b)\n    }}\n    String.from_bytes(out) ?? text\n}}\n\nfn parse_int(text: String) -> Int? {{\n    n := 0\n    any := false\n    loop b in text.bytes() {{\n        d :: b\n        if d < 48 || d > 57 -> return None\n        if n > 922337203685477580 || (n == 922337203685477580 && d > 7) -> return None\n        n = n * 10 + (d - 48)\n        any = true\n    }}\n    if !any -> return None\n    Val(n)\n}}\n\n"}
}

fn foundation_embedded_core_source_79() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.testing", alias: "core_core_testing", path: "Core/testing/testing.jet", owner: "", owned_members: [String]{"assert_equal", "compare", "corpus", "fake_clock", "fake_data", "fake_rng", "fixture", "golden", "snap", "status", "temp_dir", "test_suite", "world"}, source: "package {{\n    name: \"core.testing\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"Assertions, fixtures, goldens, and fake clocks.\"\n    license: \"MIT\"\n    outputs: {{\n        testing: .Library{{ entry: testing }}\n    }}\n}}\nuse core as core\n\n// core.testing — deterministic tests and comparison records.\n//\n// Fixture, golden, world, fake-data, and suite state remain host-owned;\n// callback comparison and bounded history generation stay portable Jet code.\n\npub fn assert_equal(comparison: TestComparison) -> Bool Never! {{\n    // The typed provider also requires recorded samples; the source twin can\n    // validate only the scalar proof fields exposed by the declaration.\n    comparison.status == \"matched\" && !comparison.universal_proof && comparison.first_difference < 0\n}}\n\n/// D-CALLBACK-ERR1=A: both callbacks share one failure type `E`, which the\n/// comparison passes up; two callbacks that cannot fail make it `Never`.\npub fn compare<E>(cases: [DataTree], reference: fn(DataTree) -> DataTree E!, candidate: fn(DataTree) -> DataTree E!, relation: String) -> TestComparison E! {{\n    normalized := relation\n    if normalized.len() == 0 -> normalized = \"typed_equality\"\n    if normalized == \"ordered_effects\" || normalized == \"typed_failure\" {{\n        return terminal_comparison(normalized, \"relation requires recorded observations\")\n    }}\n    if cases.len() == 0 -> return terminal_comparison(normalized, \"comparison needs at least one case\")\n    inputs := [DataTree]{{}}\n    reference_values := [DataTree]{{}}\n    candidate_values := [DataTree]{{}}\n    case_ids := [String]{{}}\n    first_difference := -1\n    loop i in 0..<cases.len() {{\n        input :: cases[i]\n        expected :: reference(input)\n        actual :: candidate(input)\n        &inputs.push(input)\n        &reference_values.push(expected)\n        &candidate_values.push(actual)\n        &case_ids.push(\"case-{{i}}\")\n        if first_difference < 0 && !expected.equal_unordered(actual) -> first_difference = i\n    }}\n    status := \"matched\"\n    reason := \"comparison matched all cases\"\n    if first_difference >= 0 {{\n        status = \"mismatch\"\n        reason = \"reference and candidate differ at case-{{first_difference}}\"\n    }}\n    TestComparison{{\n        status: status,\n        relation: normalized,\n        source: \"core.testing\",\n        tool: \"jet\",\n        target: \"embedded-prelude\",\n        seed: None,\n        case_ids: case_ids,\n        inputs: inputs,\n        reference: reference_values,\n        candidate: candidate_values,\n        first_difference: first_difference,\n        reason: reason,\n        universal_proof: false,\n    }}\n}}\n\nfn terminal_comparison(relation: String, reason: String) -> TestComparison {{\n    TestComparison{{\n        status: \"unavailable\",\n        relation: relation,\n        source: \"core.testing\",\n        tool: \"jet\",\n        target: \"embedded-prelude\",\n        seed: None,\n        case_ids: [String]{{}},\n        inputs: [DataTree]{{}},\n        reference: [DataTree]{{}},\n        candidate: [DataTree]{{}},\n        first_difference: -1,\n        reason: reason,\n        universal_proof: false,\n    }}\n}}\n\n/// Compare or create a host-managed snapshot for `name`.\npub fn snap(name: String, value: String) -[FS]> Bool Never! {{ core.testing.snap(name, value) }}\n\npub fn golden(name: String, value: String) -[FS]> Bool Never! {{\n    core.testing.golden(name, value)\n}}\n\npub fn fixture(name: String) -[FS]> String Never! {{ core.testing.fixture(name) }}\n\npub fn temp_dir(prefix: String) -[FS]> String Never! {{ core.testing.temp_dir(prefix) }}\n\npub fn corpus(glob: String) -[FS]> [String] Never! {{ core.testing.corpus(glob) }}\n\n/// The test-facing spelling of the deterministic Prelude `Clock` built by `Clock.new`.\npub fn fake_clock(unix_ms: Int) -> Clock Never! {{ Clock.new(unix_ms) }}\n\n/// A deterministic Prelude `Rng` seeded by the provider constructor.\npub fn fake_rng(seed: Int) -> RNG Never! {{ core.testing.fake_rng(seed) }}\n\n/// The deterministic Prelude `Fake` data capability built by the provider constructor.\npub fn fake_data(seed: Int) -> Fake Never! {{ core.testing.fake_data(seed) }}\n\n/// The Prelude `TestSuite` carrying the current harness iteration and result.\npub fn test_suite() -> TestSuite Never! {{ core.testing.test_suite() }}\n\npub fn world(body: fn(DeterministicWorld)) Never! {{ core.testing.world(body) }}\n\npub fn status(comparison: TestComparison) -> String Never! {{ comparison.status }}\n\n"}
}

fn foundation_embedded_core_source_80() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.text", alias: "core_text", path: "Core/text/text.jet", owner: "", owned_members: [String]{"byte_count", "byte_views", "casefold", "caseless_eq", "center", "char_indices", "cursor", "cursor_advance", "display_width", "ends_any", "grapheme_views", "graphemes", "inspect", "is_alphabetic", "is_ascii", "is_numeric", "is_whitespace", "line_views", "lower", "nfc", "nfd", "nfkc", "nfkd", "pad_end", "pad_start", "rsplitn", "scalar_count", "scalars", "sentences", "splitn", "starts_any", "trim", "trim_end", "trim_start", "upper", "word_views", "words"}, source: "package {{\n    name: \"core.text\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"Unicode text, ASCII helpers, and display formatting.\"\n    license: \"MIT\"\n    outputs: {{\n        text: .Library{{ entry: text }}\n    }}\n}}\n\n// core.text — strings as Unicode scalar sequences.\n//\n// Jet `String` is UTF-8. Counting, trimming, and case mapping are defined on\n// scalars, not raw bytes, except where a function is named `byte_*`. UTF-8\n// decode, Hangul NFD/NFC, UAX #29 grapheme/word segmentation (extended\n// grapheme clusters, WB simple alphanumerics), East-Asian width, and Latin-1\n// case mapping are Jet. Full Unicode case-fold tables beyond Latin-1 map\n// identity (C+F for ASCII/Latin-1 still applied).\n//\n// Predicates on the empty string are false (`is_alphabetic(\"\")` is false).\n// `splitn` / `rsplitn` take a maximum part count, matching Rust `splitn`.\n\n\nmodule fmt\nmodule parse\nmodule wrap\nmodule html\nmodule combinators\n\n/// Byte-offset cursor into UTF-8 text. Line and column are 1-based.\npub struct Cursor {{\n    pub offset: Int\n    pub line: Int\n    pub column: Int\n}}\n\n/// Cursor at the start of `text` (offset 0, line 1, column 1).\npub fn cursor(_text: String) -> Cursor Never! {{\n    Cursor{{offset: 0, line: 1, column: 1}}\n}}\n\n/// Advance `cur` by one UTF-8 scalar in `text`. Past the end is a no-op.\npub fn cursor_advance(text: String, cur: Cursor) -> Cursor Never! {{\n    raw :: text.bytes()\n    if cur.offset < 0 -> return Cursor{{offset: 0, line: 1, column: 1}}\n    if cur.offset >= raw.len() -> return ~cur\n    width :: utf8_width_at(raw, cur.offset)\n    next :: cur.offset + width\n    if raw[cur.offset] == (U8{{10}}) -> return Cursor{{offset: next, line: cur.line + 1, column: 1}}\n    Cursor{{offset: next, line: cur.line, column: cur.column + 1}}\n}}\n\n/// Byte length of UTF-8 `text`. Equal to `text.bytes().len()`.\npub fn byte_count(text: String) -> Int Never! {{ text.bytes().len() }}\n\npub fn is_ascii(text: String) -> Bool Never! {{\n    loop b in text.bytes() {{\n        if b > (U8{{127}}) -> return false\n    }}\n    true\n}}\n\n/// Unicode scalar count (replacement character U+FFFD counts as one).\npub fn scalar_count(text: String) -> Int Never! {{ decode_scalars(text).len() }}\n\npub fn scalars(text: String) -> [String] Never! {{\n    out := [String]{{}}\n    loop cp in decode_scalars(text) -> &out.push(encode_cp(cp))\n    out\n}}\n\npub fn lower(text: String) -> String Never! {{ map_case(text, false) }}\n\npub fn upper(text: String) -> String Never! {{ map_case(text, true) }}\n\n/// Unicode C+F case folding. Latin-1 folds through `lower`; other scalars identity.\npub fn casefold(text: String) -> String Never! {{ lower(text) }}\n\npub fn caseless_eq(left: String, right: String) -> Bool Never! {{ casefold(left) == casefold(right) }}\n\npub fn nfc(text: String) -> String Never! {{ compose(decompose(text, false)) }}\npub fn nfd(text: String) -> String Never! {{ encode_cps(decompose(text, false)) }}\npub fn nfkc(text: String) -> String Never! {{ compose(decompose(text, true)) }}\npub fn nfkd(text: String) -> String Never! {{ encode_cps(decompose(text, true)) }}\n\npub fn graphemes(text: String) -> [String] Never! {{ split_graphemes(text) }}\npub fn words(text: String) -> [String] Never! {{ split_words(text) }}\npub fn sentences(text: String) -> [String] Never! {{ split_sentences(text) }}\npub fn inspect(text: String) -> [String] Never! {{\n    out := [String]{{}}\n    loop cp in decode_scalars(text) -> &out.push(hex_cp(cp))\n    out\n}}\n\n/// `\"index:scalar\"` pairs, index in bytes.\npub fn char_indices(text: String) -> [String] Never! {{\n    out := [String]{{}}\n    loop pair in decode_indexed(text) -> &out.push(\"{{pair.index}}:{{encode_cp(pair.cp)}}\")\n    out\n}}\n\npub fn display_width(text: String) -> Int Never! {{\n    total := 0\n    loop cluster in split_graphemes(text) -> total = total + cluster_width(decode_scalars(cluster))\n    total\n}}\n\npub fn grapheme_views(text: String) -> [String] Never! {{ graphemes(text) }}\npub fn word_views(text: String) -> [String] Never! {{ words(text) }}\npub fn line_views(text: String) -> [String] Never! {{ split_lines(text) }}\npub fn byte_views(text: String) -> [String] Never! {{\n    out := [String]{{}}\n    loop b in text.bytes() -> &out.push(\"{{b}}\")\n    out\n}}\n\npub fn is_alphabetic(text: String) -> Bool Never! {{\n    if text.bytes().len() == 0 -> return false\n    if is_ascii(text) {{\n        loop b in text.bytes() {{\n            if !ascii_alpha(b) -> return false\n        }}\n        return true\n    }}\n    loop cp in decode_scalars(text) {{\n        if !is_alpha_cp(cp) -> return false\n    }}\n    true\n}}\n\npub fn is_numeric(text: String) -> Bool Never! {{\n    if text.bytes().len() == 0 -> return false\n    loop cp in decode_scalars(text) {{\n        if !is_digit_cp(cp) -> return false\n    }}\n    true\n}}\n\npub fn is_whitespace(text: String) -> Bool Never! {{\n    if text.bytes().len() == 0 -> return false\n    loop cp in decode_scalars(text) {{\n        if !is_space_cp(cp) -> return false\n    }}\n    true\n}}\n\npub fn trim(text: String) -> String Never! {{ trim_end(trim_start(text)) }}\n\npub fn trim_start(text: String) -> String Never! {{\n    pairs :: decode_indexed(text)\n    i := 0\n    loop i < pairs.len() {{\n        if !is_space_cp(pairs[i].cp) -> break\n        i = i + 1\n    }}\n    if i >= pairs.len() -> return \"\"\n    slice_bytes(text.bytes(), pairs[i].index, text.bytes().len())\n}}\n\npub fn trim_end(text: String) -> String Never! {{\n    pairs :: decode_indexed(text)\n    end := text.bytes().len()\n    i := pairs.len() - 1\n    loop i >= 0 {{\n        if !is_space_cp(pairs[i].cp) {{\n            end = pairs[i].index + utf8_width_at(text.bytes(), pairs[i].index)\n            break\n        }}\n        i = i - 1\n    }}\n    slice_bytes(text.bytes(), 0, end)\n}}\n\n/// Pad on the left until `width` UTF-8 scalars. Empty `fill` returns text unchanged.\npub fn pad_start(text: String, width: Int, fill: String) -> String Never! {{ pad_side(text, width, fill, true) }}\n\npub fn pad_end(text: String, width: Int, fill: String) -> String Never! {{ pad_side(text, width, fill, false) }}\n\npub fn center(text: String, width: Int, fill: String) -> String Never! {{\n    extra :: width - scalar_count(text)\n    if extra <= 0 || scalar_count(fill) == 0 -> return ~text\n    left :: extra /% 2\n    pad_end(pad_start(text, scalar_count(text) + left, fill), width, fill)\n}}\n\npub fn starts_any(text: String, prefixes: [String]) -> Bool Never! {{\n    loop p in prefixes {{\n        if starts_with(text, p) -> return true\n    }}\n    false\n}}\n\npub fn ends_any(text: String, suffixes: [String]) -> Bool Never! {{\n    loop s in suffixes {{\n        if ends_with(text, s) -> return true\n    }}\n    false\n}}\n\n/// At most `n` parts. `n <= 0` yields an empty list.\npub fn splitn(text: String, sep: String, n: Int) -> [String] Never! {{ split_limit(text, sep, n, false) }}\n\npub fn rsplitn(text: String, sep: String, n: Int) -> [String] Never! {{ split_limit(text, sep, n, true) }}\n\nfn ascii_alpha(b: U8) -> Bool {{\n    n :: b\n    (n >= 65 && n <= 90) || (n >= 97 && n <= 122)\n}}\n\nfn ascii_space(b: U8) -> Bool {{\n    n :: b\n    n == 32 || n == 9 || n == 10 || n == 11 || n == 12 || n == 13\n}}\n\nfn ascii_lower(text: String) -> String {{\n    out := [U8]{{}}\n    loop b in text.bytes() {{\n        n :: b\n        if n >= 65 && n <= 90 {{\n            &out.push(U8{{n + 32}})\n        }} else {{\n            &out.push(b)\n        }}\n    }}\n    String.from_bytes(out) ?? \"\"\n}}\n\nfn ascii_upper(text: String) -> String {{\n    out := [U8]{{}}\n    loop b in text.bytes() {{\n        n :: b\n        if n >= 97 && n <= 122 {{\n            &out.push(U8{{n - 32}})\n        }} else {{\n            &out.push(b)\n        }}\n    }}\n    String.from_bytes(out) ?? \"\"\n}}\n\nfn slice_bytes(raw: [U8], start: Int, end: Int) -> String {{\n    out := [U8]{{}}\n    lo := start\n    hi := end\n    if lo < 0 -> lo = 0\n    if hi > raw.len() -> hi = raw.len()\n    if hi < lo -> hi = lo\n    i := lo\n    loop {{\n        if i >= hi -> return String.from_bytes(out) ?? \"\"\n        &out.push(raw[i])\n        i = i + 1\n    }}\n}}\n\nfn starts_with(text: String, prefix: String) -> Bool {{\n    a :: text.bytes()\n    b :: prefix.bytes()\n    if b.len() > a.len() -> return false\n    loop i in 0..<b.len() {{\n        if a[i] != b[i] -> return false\n    }}\n    true\n}}\n\nfn ends_with(text: String, suffix: String) -> Bool {{\n    a :: text.bytes()\n    b :: suffix.bytes()\n    if b.len() > a.len() -> return false\n    off :: a.len() - b.len()\n    loop i in 0..<b.len() {{\n        if a[off + i] != b[i] -> return false\n    }}\n    true\n}}\n\nfn pad_side(text: String, width: Int, fill: String, left: Bool) -> String {{\n    extra :: width - scalar_count(text)\n    units :: scalars(fill)\n    if extra <= 0 || units.len() == 0 -> return ~text\n    added := [String]{{}}\n    i := 0\n    loop added.len() < extra {{\n        &added.push(units[i])\n        i = (i + 1) % units.len()\n    }}\n    prefix := \"\"\n    suffix := \"\"\n    loop part in added {{\n        if left -> prefix = \"{{prefix}}{{part}}\" else -> suffix = \"{{suffix}}{{part}}\"\n    }}\n    \"{{prefix}}{{text}}{{suffix}}\"\n}}\n\nfn split_limit(text: String, sep: String, n: Int, from_right: Bool) -> [String] {{\n    if n <= 0 -> return [String]{{}}\n    if n == 1 || sep.bytes().len() == 0 -> return [String]{{text}}\n    parts := [String]{{}}\n    rest := text\n    loop {{\n        if parts.len() + 1 >= n {{\n            &parts.push(rest)\n            return ~parts\n        }}\n        at :: find_sep(rest, sep, from_right)\n        if at < 0 {{\n            &parts.push(rest)\n            return ~parts\n        }}\n        if from_right {{\n            &parts.push(slice_bytes(rest.bytes(), at + sep.bytes().len(), rest.bytes().len()))\n            rest = slice_bytes(rest.bytes(), 0, at)\n        }} else {{\n            &parts.push(slice_bytes(rest.bytes(), 0, at))\n            rest = slice_bytes(rest.bytes(), at + sep.bytes().len(), rest.bytes().len())\n        }}\n    }}\n}}\n\nfn find_sep(text: String, sep: String, from_right: Bool) -> Int {{\n    hay :: text.bytes()\n    needle :: sep.bytes()\n    if needle.len() == 0 || needle.len() > hay.len() -> return -1\n    last :: hay.len() - needle.len()\n    if from_right {{\n        i := last\n        loop {{\n            if i < 0 -> return -1\n            if match_at(hay, needle, i) -> return i\n            i = i - 1\n        }}\n    }}\n    loop i in 0..<(last + 1) {{\n        if match_at(hay, needle, i) -> return i\n    }}\n    -1\n}}\n\nfn match_at(hay: [U8], needle: [U8], start: Int) -> Bool {{\n    loop i in 0..<needle.len() {{\n        if hay[start + i] != needle[i] -> return false\n    }}\n    true\n}}\n\npub struct IndexedCp {{\n    pub index: Int\n    pub cp: Int\n}}\n\nfn decode_scalars(text: String) -> [Int] Never! {{\n    pairs :: decode_indexed(text)\n    out := [Int]{{}}\n    loop p in pairs -> &out.push(p.cp)\n    out\n}}\n\nfn decode_indexed(text: String) -> [IndexedCp] Never! {{\n    raw :: text.bytes()\n    out := [IndexedCp]{{}}\n    i := 0\n    loop {{\n        if i >= raw.len() -> return ~out\n        start := i\n        first := Int.from_