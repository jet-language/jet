fn foundation_embedded_core_source_59() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.mod", alias: "core_core_mod", path: "Core/mod/mod.jet", owner: "", owned_members: [String]{"is_loaded", "load", "path", "unload"}, source: "package {{\n    name: \"core.mod\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"Load a compiled Jet compiled from disk.\"\n    license: \"MIT\"\n    outputs: {{\n        mod: .Library{{ entry: mod }}\n    }}\n}}\nuse core as core\nuse core.text.parse as parse\n\n// core.mod — a compiled Jet unit loaded under an explicit read grant.\n//\n// The provider owns artifact validation, staging, ABI checks, and handle\n// lifetime.  The returned `Mod` is opaque; dropping it releases the native\n// module, so source cannot manufacture a detached or already-unloaded handle.\n\n/// D-MOD-ERR1=A: each case asks the caller for a different action. `Denied`:\n/// the grant refuses the path or an effect the library declares. `NotFound`:\n/// nothing is at the path. `Invalid`: the file is damaged or is not a\n/// library. `Unsupported`: another Jet version, ABI or platform built it, or\n/// loading is not available here. Each case holds the provider's reason.\n#Error\npub enum ModError {{\n    Denied(String)\n    NotFound(String)\n    Invalid(String)\n    Unsupported(String)\n}}\n\npub fn load(path: String, grant: ModGrant) -[FS, Exec]> Mod ModError! {{\n    if core.mod.load(path, grant: grant) == {{\n        .Ok(loaded) -> Ok(loaded)\n        .Err(reason) -> Err(mod_error(reason))\n    }}\n}}\npub struct CompiledModule {{\n    pub path: String\n    pub handle: Int\n}}\n\n// The provider exposes no `jet_mod_unload` operation.  `Mod` owns its native\n// handle and unloads on drop; a legacy value cannot truthfully be turned into\n// a detached carrier, so preserve the export as a typed refusal.\npub fn unload(compiled: CompiledModule) -[FS]> CompiledModule ModError! {{\n    Err(ModError.Unsupported(\"core.mod.unload is unavailable: loaded Mod handles are provider-owned and unload on drop\"))\n}}\n\n// The provider reports a refusal as `<Case>: <reason>` (Top/Mod.rs\n// `JetModFailure`); an untagged reason is a malformed request, so `Invalid`.\nfn mod_error(reason: String) -> ModError Never! {{\n    if reason.starts_with(\"Denied: \") -> return ModError.Denied(parse.strip_prefix(reason, \"Denied: \"))\n    if reason.starts_with(\"NotFound: \") -> return ModError.NotFound(parse.strip_prefix(reason, \"NotFound: \"))\n    if reason.starts_with(\"Invalid: \") -> return ModError.Invalid(parse.strip_prefix(reason, \"Invalid: \"))\n    if reason.starts_with(\"Unsupported: \") -> return ModError.Unsupported(parse.strip_prefix(reason, \"Unsupported: \"))\n    ModError.Invalid(reason)\n}}\n\npub fn is_loaded(compiled: CompiledModule) -> Bool Never! {{\n    compiled.handle > 0\n}}\n\npub fn path(compiled: CompiledModule) -> String Never! {{\n    compiled.path\n}}\n\n"}
}

