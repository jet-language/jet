n    found :: files.which(name) ?? return None\n    Val(Path{{raw: found}})\n}}\n\n\npub fn open_read(path: Path) -[FS]> FileReader IOError! {{ files.open(~path.raw) }}\n\n\npub fn open_write(path: Path) -[FS]> FileWriter IOError! {{ files.create(~path.raw) }}\n\n\npub fn show(path: Path) -> String Never! {{ ~path.raw }}\n\n\npub fn equals(a: Path, b: Path) -> Bool Never! {{ files.collapse(~a.raw) == files.collapse(~b.raw) }}\n\n\nfn starts_dotdot(text: String) -> Bool {{\n    raw :: text.bytes()\n    if raw.len() < 2 -> return false\n    if raw[0] != (U8{{46}}) || raw[1] != (U8{{46}}) -> return false\n    raw.len() == 2 || raw[2] == (U8{{47}})\n}}\n"}
