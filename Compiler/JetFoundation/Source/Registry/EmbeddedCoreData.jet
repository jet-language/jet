    FoundationCoreSource{module_name: "core.web.storage.local", alias: "core_core_web_storage_local", path: "Core/web/storage/local.jet", owner: "", owned_members: [String]{"clear", "get", "get_or", "has", "remove", "set"}, source: "use core as core\n\n// core.web.storage.local — origin-local key/value store.\npub fn get(key: String) -> String? Never! {{ core.web.storage.local.get(key) }}\n\npub fn set(key: String, value: String) Never! {{ core.web.storage.local.set(key, value) }}\n\npub fn remove(key: String) Never! {{ core.web.storage.local.remove(key) }}\n\npub fn clear() Never! {{ core.web.storage.local.clear() }}\n\npub fn get_or(key: String, fallback: String) -> String Never! {{ get(key) ?? fallback }}\n\npub fn has(key: String) -> Bool Never! {{ get(key) != None }}\n\n"}
