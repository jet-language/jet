fn foundation_embedded_core_source_46() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.font", alias: "core_core_font", path: "Core/font/font.jet", owner: "", owned_members: [String]{"shape", "shape_with", "system"}, source: "package {{\n    name: \"core.font\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"Font faces and glyph shaping.\"\n    license: \"MIT\"\n    outputs: {{\n        font: .Library{{ entry: font }}\n    }}\n    authority: {{ needs: [UI.FontShaping] }}\n}}\nuse core as core\n\n// core.font — one face/run model across native and headless tiers.\n//\n// `shape` is the provider seam: the host owns real shaping and returns a\n// canonical run.  `shape_with` is the explicit portable fallback for callers\n// that need deterministic, approximate advances without a shaping provider.\npub enum FontStyle {{\n    Body\n    Title\n    Monospace\n}}\n\npub enum GlyphShaper {{\n    HarfBuzz\n    HeadlessFallback\n}}\n\npub struct FontFace {{\n    pub family: String\n    pub size: Float\n    pub style: FontStyle\n}}\n\npub struct Glyph {{\n    pub id: Int\n    pub cluster: Int\n    pub x: Float\n    pub y: Float\n    pub advance_x: Float\n    pub advance_y: Float\n}}\n\npub struct GlyphRun {{\n    pub glyphs: [Glyph]\n    pub advance_x: Float\n    pub advance_y: Float\n    pub shaper: GlyphShaper\n    pub deterministic: Bool\n    pub approximate: Bool\n}}\n\npub fn system(style: FontStyle) -> FontFace Never! {{\n    core.font.system(style)\n}}\n\npub fn shape(text: String, face: FontFace) -> GlyphRun Never! {{\n    core.font.shape(text, face)\n}}\n\npub fn shape_with(face: FontFace, text: String) -> GlyphRun Never! {{\n    // This is the explicit opt-in for deterministic approximate metrics.\n    // `shape` is the only path that requests the FontShaping capability.\n    shape_fallback(face, text)\n}}\n\nfn shape_fallback(face: FontFace, text: String) -> GlyphRun {{\n    glyphs := [Glyph]{{}}\n    advance := Float{{0.0}}\n    raw :: text.bytes()\n    i := 0\n    loop i < raw.len() {{\n        pair :: decode_cp(raw, i)\n        width :: glyph_advance(face, pair.cp)\n        &glyphs.push(Glyph{{\n            id: pair.cp,\n            cluster: i,\n            x: advance,\n            y: 0.0,\n            advance_x: width,\n            advance_y: 0.0,\n        }})\n        advance += width\n        i = pair.next\n    }}\n    GlyphRun{{\n        glyphs: glyphs,\n        advance_x: advance,\n        advance_y: 0.0,\n        shaper: GlyphShaper.HeadlessFallback,\n        deterministic: true,\n        approximate: true,\n    }}\n}}\n\nfn glyph_advance(face: FontFace, cp: Int) -> Float {{\n    if cp == 10 -> return 0.0\n    if cp < 128 -> return face.size * 0.6\n    face.size\n}}\n\nstruct DecodePair {{\n    cp: Int\n    next: Int\n}}\n\nfn decode_cp(raw: [U8], i: Int) -> DecodePair {{\n    if i >= raw.len() -> return DecodePair{{cp: 0, next: i}}\n    first :: Int.from_u8(raw[i])\n    if first < 128 -> return DecodePair{{cp: first, next: i + 1}}\n\n    width := 0\n    cp := 0\n    if first >= 194 && first <= 223 {{\n        width = 2\n        cp = first & 31\n    }}\n    if first >= 224 && first <= 239 {{\n        width = 3\n        cp = first & 15\n    }}\n    if first >= 240 && first <= 244 {{\n        width = 4\n        cp = first & 7\n    }}\n    if width == 0 || i + width > raw.len() -> return DecodePair{{cp: 65533, next: i + 1}}\n\n    second :: Int.from_u8(raw[i + 1])\n    // Reject overlong encodings and UTF-16 surrogate prefixes before the\n    // continuation loop so malformed bytes consume one byte at a time.\n    if (first == 224 && second < 160) || (first == 237 && second >= 160) {{\n        return DecodePair{{cp: 65533, next: i + 1}}\n    }}\n    if (first == 240 && second < 144) || (first == 244 && second >= 144) {{\n        return DecodePair{{cp: 65533, next: i + 1}}\n    }}\n\n    k := 1\n    loop k < width {{\n        byte :: Int.from_u8(raw[i + k])\n        if byte < 128 || byte >= 192 -> return DecodePair{{cp: 65533, next: i + 1}}\n        cp = (cp << 6) | (byte & 63)\n        k += 1\n    }}\n    if cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {{\n        return DecodePair{{cp: 65533, next: i + 1}}\n    }}\n    DecodePair{{cp: cp, next: i + width}}\n}}\n\n"}
}

