    FoundationCoreSource{module_name: "core.text.parse", alias: "core_text_parse", path: "Core/text/parse.jet", owner: "", owned_members: [String]{"capitalize", "capwords", "center", "contains", "count", "encode", "ends_with", "endswith", "expandtabs", "find", "find_from", "index", "is_alnum", "isalpha", "isalnum", "isascii", "isdecimal", "is_digit", "isdigit", "is_identifier", "isidentifier", "is_lower", "islower", "isprintable", "is_space", "isspace", "is_title", "istitle", "is_upper", "isupper", "join", "ljust", "lower", "lstrip", "parse", "parse_bool", "parse_float", "parse_int", "parse_int_base", "parse_kv", "partition", "removeprefix", "removesuffix", "replace", "rfind", "rfind_from", "rindex", "rjust", "rpartition", "rstrip", "split", "split_once", "split_ws", "splitlines", "starts_with", "startswith", "strip", "strip_prefix", "strip_suffix", "swapcase", "title", "unescape_c", "upper", "zfill", "rsplit", "is_ascii", "isnumeric", "escape_c"}, source: "package {{\n    name: \"core.text.parse\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"core.text.parse core library.\"\n    license: \"MIT\"\n    outputs: {{\n        parse: .Library{{ entry: parse }}\n    }}\n}}\nuse core.text as unicode\n\n// core.text.parse — scanning, splitting, and number parsers.\n//\n// These sit beside Unicode segmentation in `core.text`. Python's `str.split`\n// `partition`, `find`, `replace`, `int()`, and `float()` are the bar; Jet\n// returns `None` instead of raising on a bad number.\npub fn split(text: String, sep: String) -> [String] Never! {{\n    if sep.bytes().len() == 0 -> return chars(text)\n    out := [String]{{}}\n    raw :: text.bytes()\n    needle :: sep.bytes()\n    start := 0\n    i := 0\n    loop i + needle.len() <= raw.len() {{\n        if match_at(raw, i, needle) {{\n            &out.push(slice_b(raw, start, i))\n            i = i + needle.len()\n            start = i\n            next\n        }}\n        i = i + 1\n    }}\n    &out.push(slice_b(raw, start, raw.len()))\n    out\n}}\n\npub fn rsplit(text: String, sep: String, maxsplit: Int) -> [String] Never! {{\n    parts :: split(text, sep)\n    if maxsplit < 0 || parts.len() <= maxsplit + 1 -> return parts\n    keep := parts.len() - maxsplit\n    head := \"\"\n    i := 0\n    loop i < keep {{\n        if i == 0 -> head = parts[0] else -> head = \"{{head}}{{sep}}{{parts[i]}}\"\n        i = i + 1\n    }}\n    out := [String]{{head}}\n    i = keep\n    loop i < parts.len() {{\n        &out.push(parts[i])\n        i = i + 1\n    }}\n    out\n}}\n\npub fn split_once(text: String, sep: String) -> (found: Bool, head: String, tail: String) Never! {{\n    i :: find(text, sep)\n    if i < 0 -> return (head: text, tail: \"\", found: false)\n    n :: sep.bytes().len()\n    (head: slice_str(text, 0, i), tail: slice_str(text, i + n, text.bytes().len()), found: true)\n}}\n\npub fn partition(text: String, sep: String) -> (head: String, sep: String, tail: String) Never! {{\n    i :: find(text, sep)\n    if i < 0 -> return (head: text, sep: \"\", tail: \"\")\n    n :: sep.bytes().len()\n    (head: slice_str(text, 0, i), sep: sep, tail: slice_str(text, i + n, text.bytes().len()))\n}}\n\npub fn rpartition(text: String, sep: String) -> (head: String, sep: String, tail: String) Never! {{\n    i :: rfind(text, sep)\n    if i < 0 -> return (head: \"\", sep: \"\", tail: text)\n    n :: sep.bytes().len()\n    (head: slice_str(text, 0, i), sep: sep, tail: slice_str(text, i + n, text.bytes().len()))\n}}\n\npub fn find(text: String, needle: String) -> Int Never! {{\n    if needle.bytes().len() == 0 -> return 0\n    raw :: text.bytes()\n    nd :: needle.bytes()\n    if nd.len() > raw.len() -> return -1\n    loop i in 0..<(raw.len() - nd.len() + 1) {{\n        if match_at(raw, i, nd) -> return i\n    }}\n    -1\n}}\n\npub fn rfind(text: String, needle: String) -> Int Never! {{\n    if needle.bytes().len() == 0 -> return text.bytes().len()\n    raw :: text.bytes()\n    nd :: needle.bytes()\n    if nd.len() > raw.len() -> return -1\n    i := raw.len() - nd.len()\n    loop i >= 0 {{\n        if match_at(raw, i, nd) -> return i\n        i = i - 1\n    }}\n    -1\n}}\n\npub fn count(text: String, needle: String) -> Int Never! {{\n    if needle.bytes().len() == 0 -> return text.bytes().len() + 1\n    n := 0\n    i := 0\n    step :: needle.bytes().len()\n    loop {{\n        j :: find(slice_str(text, i, text.bytes().len()), needle)\n        if j < 0 -> return n\n        n = n + 1\n        i = i + j + step\n    }}\n}}\n\npub fn replace(text: String, old: String, new: String, count: Int) -> String Never! {{\n    if old.bytes().len() == 0 -> return ~text\n    out := \"\"\n    i := 0\n    done := 0\n    loop {{\n        rest :: slice_str(text, i, text.bytes().len())\n        j :: find(rest, old)\n        if j < 0 || (count >= 0 && done >= count) -> return \"{{out}}{{rest}}\"\n        out = \"{{out}}{{slice_str(rest, 0, j)}}{{new}}\"\n        i = i + j + old.bytes().len()\n        done = done + 1\n    }}\n}}\n\npub fn starts_with(text: String, prefix: String) -> Bool Never! {{\n    a :: text.bytes()\n    b :: prefix.bytes()\n    if b.len() > a.len() -> return false\n    loop i in 0..<b.len() {{\n        if a[i] != b[i] -> return false\n    }}\n    true\n}}\n\npub fn ends_with(text: String, suffix: String) -> Bool Never! {{\n    a :: text.bytes()\n    b :: suffix.bytes()\n    if b.len() > a.len() -> return false\n    off :: a.len() - b.len()\n    loop i in 0..<b.len() {{\n        if a[off + i] != b[i] -> return false\n    }}\n    true\n}}\n\npub fn strip_prefix(text: String, prefix: String) -> String Never! {{\n    if starts_with(text, prefix) -> return slice_str(text, prefix.bytes().len(), text.bytes().len())\n    return ~text\n}}\n\npub fn strip_suffix(text: String, suffix: String) -> String Never! {{\n    if ends_with(text, suffix) {{\n        return slice_str(text, 0, text.bytes().len() - suffix.bytes().len())\n    }}\n    return ~text\n}}\n\npub fn parse_int(text: String) -> Int? Never! {{ parse_int_base(text, 10) }}\n\n/// Parse the canonical integer representation used by String.parse.\npub fn parse(text: String) -> Int? Never! {{ parse_int(text) }}\n\npub fn parse_int_base(text: String, base: Int) -> Int? Never! {{\n    if base < 2 || base > 36 -> return None\n    raw :: text.bytes()\n    if raw.len() == 0 -> return None\n    sign := 1\n    i := 0\n    if {{\n        raw[0] == (U8{{45}}) -> {{\n            sign = -1\n            i = 1\n        }}\n        raw[0] == (U8{{43}}) -> {{ i = 1 }}\n    }}\n    if i >= raw.len() -> return None\n    n := 0\n    any := false\n    loop i < raw.len() {{\n        d :: digit_value(raw[i])\n        if d < 0 || d >= base -> return None\n        n = n * base + d\n        any = true\n        i = i + 1\n    }}\n    if !any -> return None\n    Val(sign * n)\n}}\n\npub fn parse_float(text: String) -> Float? Never! {{\n    raw :: text.bytes()\n    if raw.len() == 0 -> return None\n    sign := Float{{1}}\n    i := 0\n    if {{\n        raw[0] == (U8{{45}}) -> {{\n            sign = Float{{-1}}\n            i = 1\n        }}\n        raw[0] == (U8{{43}}) -> {{ i = 1 }}\n    }}\n    acc := Float{{0}}\n    seen := false\n    loop i < raw.len() {{\n        n :: raw[i]\n        if n == 46 -> break\n        d :: n\n        if d < 48 || d > 57 -> return None\n        acc = acc * Float{{10}} + Float{{d - 48}}\n        seen = true\n        i = i + 1\n    }}\n    if i < raw.len() && raw[i] == (U8{{46}}) {{\n        i = i + 1\n        place := Float{{1}} / Float{{10}}\n        loop i < raw.len() {{\n            n :: raw[i]\n            if n == 101 || n == 69 -> break\n            d :: n\n            if d < 48 || d > 57 -> return None\n            acc = acc + Float{{d - 48}} * place\n            place = place / Float{{10}}\n            seen = true\n            i = i + 1\n        }}\n    }}\n    if i < raw.len() && (raw[i] == (U8{{101}}) || raw[i] == (U8{{69}})) {{\n        i = i + 1\n        exp_sign := 1\n        if {{\n            i < raw.len() && raw[i] == (U8{{45}}) -> {{\n                exp_sign = -1\n                i = i + 1\n            }}\n            i < raw.len() && raw[i] == (U8{{43}}) -> {{ i = i + 1 }}\n        }}\n        exp := 0\n        if i >= raw.len() -> return None\n        loop i < raw.len() {{\n            d :: raw[i]\n            if d < 48 || d > 57 -> return None\n            exp = exp * 10 + (d - 48)\n            if exp > 10000 -> return None\n            i = i + 1\n        }}\n        pow := Float{{1}}\n        k := 0\n        loop k < exp {{\n            pow = pow * Float{{10}}\n            k = k + 1\n        }}\n        if exp_sign < 0 -> acc = acc / pow else -> acc = acc * pow\n    }}\n    if !seen || i != raw.len() -> return None\n    Val(sign * acc)\n}}\n\npub fn is_digit(text: String) -> Bool Never! {{\n    if text.bytes().len() == 0 -> return false\n    loop b in text.bytes() {{\n        n :: b\n        if n < 48 || n > 57 -> return false\n    }}\n    true\n}}\n\npub fn is_alnum(text: String) -> Bool Never! {{\n    if text.bytes().len() == 0 -> return false\n    loop b in text.bytes() {{\n        n :: b\n        letter := (n >= 65 && n <= 90) || (n >= 97 && n <= 122)\n        digit := n >= 48 && n <= 57\n        if !letter && !digit -> return false\n    }}\n    true\n}}\n\nfn chars(text: String) -> [String] Never! {{ unicode.scalars(text) }}\n\n\nfn match_at(raw: [U8], i: Int, needle: [U8]) -> Bool {{\n    loop j in 0..<needle.len() {{\n        if raw[i + j] != needle[j] -> return false\n    }}\n    true\n}}\n\nfn slice_b(raw: [U8], start: Int, end: Int) -> String {{\n    out := [U8]{{}}\n    i := start\n    loop {{\n        if i >= end || i >= raw.len() -> return String.from_bytes(out) ?? \"\"\n        &out.push(raw[i])\n        i = i + 1\n    }}\n}}\n\nfn slice_str(text: String, start: Int, end: Int) -> String {{ slice_b(text.bytes(), start, end) }}\n\nfn digit_value(b: U8) -> Int Never! {{\n    n :: b\n    if n >= 48 && n <= 57 -> return n - 48\n    if n >= 65 && n <= 90 -> return n - 55\n    if n >= 97 && n <= 122 -> return n - 87\n    return -1\n}}\n\npub fn join(parts: [String], sep: String) -> String Never! {{\n    s := \"\"\n    i := 0\n    loop i < parts.len() {{\n        if i == 0 -> s = parts[0] else -> s = \"{{s}}{{sep}}{{parts[i]}}\"\n        i = i + 1\n    }}\n    s\n}}\n\npub fn splitlines(text: String, keepends: Bool) -> [String] Never! {{\n    raw :: text.bytes()\n    out := [String]{{}}\n    start := 0\n    i := 0\n    loop i < raw.len() {{\n        n :: raw[i]\n        if n == 10 || n == 13 {{\n            end := i\n            eat := 1\n            if n == 13 && i + 1 < raw.len() && raw[i + 1] == (U8{{10}}) -> eat = 2\n            if keepends -> &out.push(slice_b(raw, start, i + eat)) else {{\n                &out.push(slice_b(raw, start, end))\n            }}\n            i = i + eat\n            start = i\n            next\n        }}\n        i = i + 1\n    }}\n    if start <= raw.len() -> &out.push(slice_b(raw, start, raw.len()))\n    out\n}}\n\npub fn lstrip(text: String) -> String Never! {{\n    raw :: text.bytes()\n    i := 0\n    loop i < raw.len() {{\n        n :: raw[i]\n        if n != 32 && n != 9 && n != 10 && n != 13 -> return slice_b(raw, i, raw.len())\n        i = i + 1\n    }}\n    \"\"\n}}\n\npub fn rstrip(text: String) -> String Never! {{\n    raw :: text.bytes()\n    i := raw.len()\n    loop i > 0 {{\n        n :: raw[i - 1]\n        if n != 32 && n != 9 && n != 10 && n != 13 -> return slice_b(raw, 0, i)\n        i = i - 1\n    }}\n    \"\"\n}}\n\npub fn strip(text: String) -> String Never! {{ lstrip(rstrip(text)) }}\n\npub fn ljust(text: String, width: Int, fill: String) -> String Never! {{\n    pad :: fill_to(fill)\n    n := width - text.bytes().len()\n    if n <= 0 -> return ~text\n    \"{{text}}{{repeat_char(pad, n)}}\"\n}}\n\npub fn rjust(text: String, width: Int, fill: String) -> String Never! {{\n    pad :: fill_to(fill)\n    n := width - text.bytes().len()\n    if n <= 0 -> return ~text\n    \"{{repeat_char(pad, n)}}{{text}}\"\n}}\n\npub fn center(text: String, width: Int, fill: String) -> String Never! {{\n    pad :: fill_to(fill)\n    n := width - text.bytes().len()\n    if n <= 0 -> return ~text\n    left :: n /% 2\n    \"{{repeat_char(pad, left)}}{{text}}{{repeat_char(pad, n - left)}}\"\n}}\n\npub fn zfill(text: String, width: Int) -> String Never! {{\n    raw :: text.bytes()\n    sign := \"\"\n    rest := text\n    if raw.len() > 0 && (raw[0] == (U8{{45}}) || raw[0] == (U8{{43}})) {{\n        sign = slice_b(raw, 0, 1)\n        rest = slice_b(raw, 1, raw.len())\n    }}\n    n := width - text.bytes().len()\n    if n <= 0 -> return ~text\n    \"{{sign}}{{repeat_char(\"0\", n)}}{{rest}}\"\n}}\n\npub fn capitalize(text: String) -> String Never! {{\n    raw :: text.bytes()\n    if raw.len() == 0 -> return ~text\n    first :: ascii_case(raw[0], true)\n    out := [U8]{{first}}\n    i := 1\n    loop i < raw.len() {{\n        &out.push(ascii_case(raw[i], false))\n        i = i + 1\n    }}\n    String.from_bytes(out) ?? text\n}}\n\npub fn title(text: String) -> String Never! {{\n    raw :: text.bytes()\n    out := [U8]{{}}\n    word := true\n    loop b in raw {{\n        n :: b\n        letter := (n >= 65 && n <= 90) || (n >= 97 && n <= 122)\n        if letter {{\n            &out.push(ascii_case(b, word))\n            word = false\n        }} else {{\n            &out.push(b)\n            word = true\n        }}\n    }}\n    String.from_bytes(out) ?? text\n}}\n\n/// Python `string.capwords`: collapse whitespace and capitalize each word.\npub fn capwords(text: String) -> String Never! {{\n    parts := split_ws(text)\n    i := 0\n    loop i < parts.len() {{\n        parts[i] = capitalize(parts[i])\n        i = i + 1\n    }}\n    join(parts, \" \")\n}}\n\npub fn swapcase(text: String) -> String Never! {{\n    out := [U8]{{}}\n    loop b in text.bytes() {{\n        n :: b\n        if {{\n            n >= 65 && n <= 90 -> {{ &out.push(U8{{n + 32}}) }}\n            n >= 97 && n <= 122 -> {{ &out.push(U8{{n - 32}}) }}\n            else -> {{ &out.push(b) }}\n        }}\n    }}\n    String.from_bytes(out) ?? text\n}}\n\npub fn lower(text: String) -> String Never! {{\n    out := [U8]{{}}\n    loop b in text.bytes() {{\n        n :: b\n        if n >= 65 && n <= 90 -> &out.push(U8{{n + 32}}) else -> &out.push(b)\n    }}\n    String.from_bytes(out) ?? text\n}}\n\npub fn upper(text: String) -> String Never! {{\n    out := [U8]{{}}\n    loop b in text.bytes() {{\n        n :: b\n        if n >= 97 && n <= 122 -> &out.push(U8{{n - 32}}) else -> &out.push(b)\n    }}\n    String.from_bytes(out) ?? text\n}}\n\npub fn is_space(text: String) -> Bool Never! {{\n    if text.bytes().len() == 0 -> return false\n    loop b in text.bytes() {{\n        n :: b\n        if n != 32 && n != 9 && n != 10 && n != 13 -> return false\n    }}\n    true\n}}\n\npub fn is_lower(text: String) -> Bool Never! {{\n    any := false\n    loop b in text.bytes() {{\n        n :: b\n        if n >= 65 && n <= 90 -> return false\n        if n >= 97 && n <= 122 -> any = true\n    }}\n    any\n}}\n\npub fn is_upper(text: String) -> Bool Never! {{\n    any := false\n    loop b in text.bytes() {{\n        n :: b\n        if n >= 97 && n <= 122 -> return false\n        if n >= 65 && n <= 90 -> any = true\n    }}\n    any\n}}\n\npub fn is_title(text: String) -> Bool Never! {{ text == title(text) && text.bytes().len() > 0 }}\n\npub fn is_ascii(text: String) -> Bool Never! {{\n    loop b in text.bytes() {{\n        n :: b\n        if n > 127 -> return false\n    }}\n    true\n}}\n\npub fn is_identifier(text: String) -> Bool Never! {{\n    raw :: text.bytes()\n    if raw.len() == 0 -> return false\n    n0 :: raw[0]\n    ok0 := n0 == 95 || (n0 >= 65 && n0 <= 90) || (n0 >= 97 && n0 <= 122)\n    if !ok0 -> return false\n    loop b in raw {{\n        n :: b\n        if n == 95 -> next\n        if n >= 48 && n <= 57 -> next\n        if n >= 65 && n <= 90 -> next\n        if n >= 97 && n <= 122 -> next\n        return false\n    }}\n    true\n}}\n\n/// Python `str` spellings over the same UTF-8 byte-preserving primitives.\npub fn startswith(text: String, prefix: String) -> Bool Never! {{ starts_with(text, prefix) }}\npub fn endswith(text: String, suffix: String) -> Bool Never! {{ ends_with(text, suffix) }}\npub fn removeprefix(text: String, prefix: String) -> String Never! {{ strip_prefix(text, prefix) }}\npub fn removesuffix(text: String, suffix: String) -> String Never! {{ strip_suffix(text, suffix) }}\npub fn rindex(text: String, needle: String) -> Int Never! {{ rfind(text, needle) }}\npub fn encode(text: String) -> [U8] Never! {{ text.bytes() }}\npub fn isalpha(text: String) -> Bool Never! {{\n    if text.bytes().len() == 0 -> return false\n    loop b in text.bytes() {{\n        n :: b\n        if !((n >= 65 && n <= 90) || (n >= 97 && n <= 122)) -> return false\n    }}\n    true\n}}\npub fn isdecimal(text: String) -> Bool Never! {{ is_digit(text) }}\npub fn isnumeric(text: String) -> Bool Never! {{ is_digit(text) }}\npub fn isalnum(text: String) -> Bool Never! {{ is_alnum(text) }}\npub fn isascii(text: String) -> Bool Never! {{ is_ascii(text) }}\npub fn isdigit(text: String) -> Bool Never! {{ is_digit(text) }}\npub fn isidentifier(text: String) -> Bool Never! {{ is_identifier(text) }}\npub fn islower(text: String) -> Bool Never! {{ is_lower(text) }}\npub fn isspace(text: String) -> Bool Never! {{ is_space(text) }}\npub fn istitle(text: String) -> Bool Never! {{ is_title(text) }}\npub fn isupper(text: String) -> Bool Never! {{ is_upper(text) }}\npub fn isprintable(text: String) -> Bool Never! {{\n    loop b in text.bytes() {{\n        n :: b\n        if n < 32 || n > 126 -> return false\n    }}\n    true\n}}\npub fn expandtabs(text: String, tabsize: Int) -> String Never! {{\n    out := \"\"\n    column := 0\n    width := tabsize\n    if width < 0 -> width = 0\n    loop b in text.bytes() {{\n        n :: b\n        if {{\n            n == 9 -> {{\n                spaces := 0\n                if width > 0 -> spaces = width - (column % width)\n                loop _ in 0..<spaces -> out = \"{{out}} \"\n                column = column + spaces\n            }}\n            else -> {{\n                ch :: String.from_bytes([U8]{{b}}) ?? \"\"\n                out = \"{{out}}{{ch}}\"\n                if n == 10 || n == 13 -> column = 0 else -> column = column + 1\n            }}\n        }}\n    }}\n    out\n}}\n\n\npub fn find_from(text: String, needle: String, start: Int) -> Int Never! {{\n    s := start\n    if s < 0 -> s = 0\n    rest :: slice_str(text, s, text.bytes().len())\n    j :: find(rest, needle)\n    if j < 0 -> return -1\n    s + j\n}}\n\npub fn rfind_from(text: String, needle: String, end: Int) -> Int Never! {{\n    e := end\n    if e > text.bytes().len() -> e = text.bytes().len()\n    rfind(slice_str(text, 0, e), needle)\n}}\n\npub fn index(text: String, needle: String) -> Int Never! {{\n    i :: find(text, needle)\n    if i < 0 -> return -1\n    i\n}}\n\npub fn contains(text: String, needle: String) -> Bool Never! {{ find(text, needle) >= 0 }}\n\npub fn parse_bool(text: String) -> Bool? Never! {{\n    stripped :: strip(text) ?? return None\n    t :: lower(stripped) ?? return None\n    if t == {{\n        \"true\" | \"1\" | \"yes\" | \"on\" -> Val(true)\n        \"false\" | \"0\" | \"no\" | \"off\" -> Val(false)\n        else -> None\n    }}\n}}\n\npub fn parse_kv(text: String, sep: String) -> (key: String, ok: Bool, value: String) Never! {{\n    p :: partition(text, sep)\n    if p.sep.bytes().len() == 0 -> return (key: strip(text), value: \"\", ok: false)\n    (key: strip(p.head), value: strip(p.tail), ok: true)\n}}\n\npub fn split_ws(text: String) -> [String] Never! {{\n    raw :: text.bytes()\n    out := [String]{{}}\n    start := -1\n    i := 0\n    loop i <= raw.len() {{\n        space := false\n        if i == raw.len() -> space = true else {{\n            n :: raw[i]\n            space = n == 32 || n == 9 || n == 10 || n == 13\n        }}\n        if {{\n            space -> {{\n                if start >= 0 {{\n                    &out.push(slice_b(raw, start, i))\n                    start = -1\n                }}\n            }}\n            start < 0 -> {{ start = i }}\n        }}\n        i = i + 1\n    }}\n    out\n}}\n\npub fn unescape_c(text: String) -> String Never! {{\n    raw :: text.bytes()\n    out := [U8]{{}}\n    i := 0\n    loop i < raw.len() {{\n        if raw[i] == (U8{{92}}) && i + 1 < raw.len() {{\n            n :: raw[i + 1]\n            if {{\n                n == 110 -> {{ &out.push(U8{{10}}) }}\n                n == 116 -> {{ &out.push(U8{{9}}) }}\n                n == 114 -> {{ &out.push(U8{{13}}) }}\n                n == 92 -> {{ &out.push(U8{{92}}) }}\n                n == 34 -> {{ &out.push(U8{{34}}) }}\n                else -> {{ &out.push(raw[i + 1]) }}\n            }}\n            i = i + 2\n            next\n        }}\n        &out.push(raw[i])\n        i = i + 1\n    }}\n    String.from_bytes(out) ?? text\n}}\n\npub fn escape_c(text: String) -> String Never! {{\n    out := \"\"\n    loop b in text.bytes() {{\n        n :: b\n        if {{\n            n == 10 -> {{ out = \"{{out}}\\\\n\" }}\n            n == 9 -> {{ out = \"{{out}}\\\\t\" }}\n            n == 13 -> {{ out = \"{{out}}\\\\r\" }}\n            n == 92 -> {{ out = \"{{out}}\\\\\\\\\" }}\n            n == 34 -> {{ out = \"{{out}}\\\\\\\"\" }}\n            else -> {{ out = \"{{out}}{{String.from_bytes([U8]{{b}}) ?? \"\"}}\" }}\n        }}\n    }}\n    out\n}}\n\nfn fill_to(fill: String) -> String {{\n    if fill.bytes().len() == 0 -> return \" \"\n    slice_b(fill.bytes(), 0, 1)\n}}\n\nfn repeat_char(ch: String, n: Int) -> String {{\n    s := \"\"\n    i := 0\n    loop i < n {{\n        s = \"{{s}}{{ch}}\"\n        i = i + 1\n    }}\n    s\n}}\n\nfn ascii_case(b: U8, upper: Bool) -> U8 {{\n    n :: b\n    if upper {{\n        if n >= 97 && n <= 122 -> return (U8{{n - 32}})\n        return b\n    }}\n    if n >= 65 && n <= 90 -> return (U8{{n + 32}})\n    b\n}}\n"}
