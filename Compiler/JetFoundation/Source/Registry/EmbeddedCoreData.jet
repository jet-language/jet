fn foundation_embedded_core_source_107() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.web.store", alias: "core_core_web_store", path: "Core/web/store.jet", owner: "", owned_members: [String]{"back", "batch", "clear_history", "current_generation", "cursor", "derived", "event_json", "events", "events_since", "facts_json", "forward", "get", "history", "history_at", "history_enabled", "history_limit", "inspect", "jump", "new", "optimistic", "patch", "patch_active", "patch_commit", "patch_generation", "patch_rollback", "patch_transaction", "restore", "scrub", "selector", "set", "set_history_limit", "set_state", "signal", "state_signal", "subscribe", "subscribe_selector", "subscription_active", "subscription_unsubscribe", "transaction", "update", "value", "with_history"}, source: "C_MAX_STORE_NAME :: 256\nC_MAX_STORE_SUBSCRIBERS :: 1000000\n\n\n// core.web.store — typed state history, transactions, and patches.\n\n#Error\npub enum WebStoreError {{\n    NotFound\n    Invalid\n}}\n\npub struct WebStore<T> {{\n    pub name: String\n    pub value: T\n    pub history: [T]\n    pub cursor: Int\n    pub generation: Int\n    pub history_enabled: Bool\n    pub history_limit: Int\n    pub subs: Int\n}}\n\npub struct WebStoreEvent {{\n    pub kind: String\n    pub cursor: Int\n    pub generation: Int\n    pub diff: String\n}}\n\npub struct WebStoreTransaction<T> {{\n    pub label: String\n    pub value: T\n}}\n\npub struct WebStorePatch<T> {{\n    pub store: WebStore<T>\n    pub backup: T\n    pub active: Bool\n}}\n\npub struct WebStoreSubscription {{\n    pub id: Int\n    pub active: Bool\n    pub selector: String\n}}\n\npub struct WebStoreInspection {{\n    pub name: String\n    pub cursor: Int\n    pub generation: Int\n    pub history_len: Int\n}}\n\npub struct Derived<T> {{\n    pub value: T\n}}\n\npub fn new<T>(name: String, value: T) -> WebStore<T> Never! {{\n    WebStore<T>{{name: name, value: value, history: [T]{{value}}, cursor: 0, generation: 1, history_enabled: true, history_limit: 1000, subs: 0}}\n}}\n\npub fn with_history<T>(name: String, value: T, limit: Int) -> WebStore<T> Never! {{\n    store := new<T>(name, value)\n    n := limit\n    if n < 1 -> n = 1\n    if n > 1000 -> n = 1000\n    store.history_limit = n\n    store\n}}\n\npub fn value<T>(store: WebStore<T>) -> T Never! {{ store.value }}\npub fn get<T>(store: WebStore<T>) -> T Never! {{ store.value }}\npub fn signal<T>(store: WebStore<T>) -> String Never! {{ \"{{store.name}}:{{store.generation}}\" }}\npub fn state_signal<T>(store: WebStore<T>) -> String Never! {{ signal<T>(store) }}\n\npub fn transaction<T>(store: &WebStore<T>, label: String, values: [String], apply: fn(T)) -> WebStoreTransaction<T> Never! {{\n    apply(store.value)\n    record<T>(&store)\n    WebStoreTransaction<T>{{label: label, value: store.value}}\n}}\n\npub fn update<T>(store: &WebStore<T>, label: String, values: [String], apply: fn(T)) -> WebStoreTransaction<T> Never! {{\n    transaction<T>(&store, label, values, apply)\n}}\n\npub fn batch<T>(store: &WebStore<T>, label: String, values: [String], apply: fn(T)) -> WebStoreTransaction<T> Never! {{\n    transaction<T>(&store, label, values, apply)\n}}\n\npub fn set<T>(store: &WebStore<T>, value: T) -> WebStoreTransaction<T> Never! {{\n    store.value = value\n    record<T>(&store)\n    WebStoreTransaction<T>{{label: \"set\", value: store.value}}\n}}\n\npub fn set_state<T>(store: &WebStore<T>, value: T) -> WebStoreTransaction<T> Never! {{ set<T>(&store, value) }}\n\npub fn optimistic<T>(store: &WebStore<T>, label: String, values: [String], apply: fn(T)) -> WebStorePatch<T> Never! {{\n    backup := store.value\n    apply(store.value)\n    record<T>(&store)\n    WebStorePatch<T>{{store: ~store, backup: backup, active: true}}\n}}\n\npub fn patch<T>(store: &WebStore<T>, label: String, values: [String], apply: fn(T)) -> WebStorePatch<T> Never! {{\n    optimistic<T>(&store, label, values, apply)\n}}\n\npub fn patch_generation<T>(patch: WebStorePatch<T>) -> Int Never! {{ patch.store.generation }}\npub fn patch_active<T>(patch: WebStorePatch<T>) -> Bool Never! {{ patch.active }}\n\npub fn patch_transaction<T>(patch: WebStorePatch<T>) -> WebStoreTransaction<T> Never! {{\n    WebStoreTransaction<T>{{label: \"patch\", value: patch.store.value}}\n}}\n\npub fn patch_commit<T>(patch: &WebStorePatch<T>) -> WebStoreTransaction<T> Never! {{\n    patch.active = false\n    WebStoreTransaction<T>{{label: \"patch_commit\", value: patch.store.value}}\n}}\n\npub fn patch_rollback<T>(patch: &WebStorePatch<T>) -> WebStore<T>? Never! {{\n    if !patch.active -> return None\n    store := patch.store\n    store.value = patch.backup\n    _ :: record<T>(&store)\n    patch.active = false\n    Val(store)\n}}\n\npub fn back<T>(store: &WebStore<T>) -> WebStore<T>? Never! {{\n    cursor :: store.cursor\n    jump<T>(&store, cursor - 1)\n}}\npub fn forward<T>(store: &WebStore<T>) -> WebStore<T>? Never! {{\n    cursor :: store.cursor\n    jump<T>(&store, cursor + 1)\n}}\npub fn restore<T>(store: &WebStore<T>) -> WebStore<T>? Never! {{\n    cursor :: store.cursor\n    jump<T>(&store, cursor)\n}}\n\npub fn jump<T>(store: &WebStore<T>, index: Int) -> WebStore<T>? Never! {{\n    if index < 0 || index >= store.history.len() -> return None\n    store.value = store.history[index]\n    store.cursor = index\n    store.generation = store.generation + 1\n    Val(store)\n}}\n\npub fn scrub<T>(store: &WebStore<T>, index: Int) -> WebStore<T>? Never! {{ jump<T>(&store, index) }}\n\npub fn history<T>(store: WebStore<T>) -> [WebStoreTransaction<T>] Never! {{\n    out := [WebStoreTransaction<T>]{{ }}\n    loop value in store.history -> &out.push(WebStoreTransaction<T>{{label: \"history\", value: value}})\n    out\n}}\n\npub fn history_at<T>(store: WebStore<T>, index: Int) -> WebStoreTransaction<T>? Never! {{\n    if index < 0 || index >= store.history.len() -> return None\n    Val(WebStoreTransaction<T>{{label: \"history\", value: store.history[index]}})\n}}\n\npub fn events<T>(store: WebStore<T>) -> [WebStoreEvent] Never! {{\n    out := [WebStoreEvent]{{ }}\n    loop i in 0..<store.history.len() -> &out.push(WebStoreEvent{{kind: \"commit\", cursor: i, generation: store.generation - (store.history.len() - 1 - i), diff: \"history\"}})\n    out\n}}\n\npub fn events_since<T>(store: WebStore<T>, cursor: Int) -> [WebStoreEvent] Never! {{\n    out := [WebStoreEvent]{{ }}\n    loop event in events<T>(store) {{\n        if event.cursor >= cursor -> &out.push(event)\n    }}\n    out\n}}\n\npub fn clear_history<T>(store: &WebStore<T>) Never! {{\n    store.history = [T]{{store.value}}\n    store.cursor = 0\n    store.generation = store.generation + 1\n}}\n\npub fn set_history_limit<T>(store: &WebStore<T>, limit: Int) Never! {{\n    n := limit\n    if n < 1 -> n = 1\n    if n > 1000 -> n = 1000\n    if n == store.history_limit -> return\n    store.history_limit = n\n    if store.history.len() > n -> store.history = tail<T>(store.history, n)\n    if store.cursor >= store.history.len() -> store.cursor = store.history.len() - 1\n    store.generation = store.generation + 1\n}}\n\npub fn history_enabled<T>(store: WebStore<T>) -> Bool Never! {{ store.history_enabled }}\npub fn history_limit<T>(store: WebStore<T>) -> Int Never! {{ store.history_limit }}\npub fn cursor<T>(store: WebStore<T>) -> Int Never! {{ store.cursor }}\npub fn current_generation<T>(store: WebStore<T>) -> Int Never! {{ store.generation }}\n\npub fn subscribe<T>(store: &WebStore<T>, callback: fn(T)) -> WebStoreSubscription Never! {{\n    if store.subs >= C_MAX_STORE_SUBSCRIBERS -> return WebStoreSubscription{{id: store.subs, active: false, selector: \"\"}}\n    callback(store.value)\n    store.subs = store.subs + 1\n    WebStoreSubscription{{id: store.subs, active: true, selector: \"\"}}\n}}\n\npub fn subscription_unsubscribe(subscription: &WebStoreSubscription) Never! {{ subscription.active = false }}\npub fn subscription_active(subscription: WebStoreSubscription) -> Bool Never! {{ subscription.active }}\n\npub fn subscribe_selector<T, U, E>(store: &WebStore<T>, project: fn(T) -> U E!, callback: fn(U)) -> WebStoreSubscription E! {{\n    if store.subs >= C_MAX_STORE_SUBSCRIBERS -> return WebStoreSubscription{{id: store.subs, active: false, selector: \"derived\"}}\n    callback(project(store.value))\n    store.subs = store.subs + 1\n    WebStoreSubscription{{id: store.subs, active: true, selector: \"derived\"}}\n}}\n\npub fn derived<T, U, E>(store: WebStore<T>, project: fn(T) -> U E!) -> Derived<U> E! {{ Derived<U>{{value: project(store.value)}} }}\npub fn selector<T, U, E>(store: WebStore<T>, project: fn(T) -> U E!) -> Derived<U> E! {{ derived<T, U, E>(store, project) }}\n\npub fn inspect<T>(store: WebStore<T>) -> WebStoreInspection Never! {{\n    WebStoreInspection{{name: store.name, cursor: store.cursor, generation: store.generation, history_len: store.history.len()}}\n}}\n\npub fn facts_json<T>(store: WebStore<T>) -> String Never! {{\n    \"{{{{\\\"name\\\":\\\"{{esc_json(store.name)}}\\\",\\\"cursor\\\":{{store.cursor}},\\\"generation\\\":{{store.generation}},\\\"history\\\":{{store.history.len()}}}}}}\"\n}}\n\npub fn event_json<T>(store: WebStore<T>) -> String Never! {{\n    \"{{{{\\\"name\\\":\\\"{{esc_json(store.name)}}\\\",\\\"cursor\\\":{{store.cursor}},\\\"generation\\\":{{store.generation}}}}}}\"\n}}\n\nfn record<T>(store: &WebStore<T>) Never! {{\n    store.generation = store.generation + 1\n    if !store.history_enabled -> return\n    if store.cursor + 1 < store.history.len() {{\n        kept := [T]{{}}\n        loop i in 0..<(store.cursor + 1) -> &kept.push(store.history[i])\n        store.history = kept\n    }}\n    &store.history.push(store.value)\n    if store.history.len() > store.history_limit -> store.history = tail<T>(store.history, store.history_limit)\n    store.cursor = store.history.len() - 1\n}}\n\nfn tail<T>(values: [T], count: Int) -> [T] Never! {{\n    start := values.len() - count\n    if start < 0 -> start = 0\n    out := [T]{{ }}\n    loop i in start..<values.len() -> &out.push(values[i])\n    out\n}}\nfn esc_json(text: String) -> String {{\n    out := \"\"\n    loop b in text.bytes() {{\n        if b == (U8{{34}}) {{\n            out = \"{{out}}\\\\\\\"\"\n        }} else if b == (U8{{92}}) {{\n            out = \"{{out}}\\\\\\\\\"\n        }} else if b == (U8{{10}}) {{\n            out = \"{{out}}\\\\n\"\n        }} else if b == (U8{{13}}) {{\n            out = \"{{out}}\\\\r\"\n        }} else if b == (U8{{9}}) {{\n            out = \"{{out}}\\\\t\"\n        }} else {{\n            out = \"{{out}}{{String.from_bytes([U8]{{b}}) ?? \"\"}}\"\n        }}\n    }}\n    out\n}}\n"}
}

fn foundation_embedded_core_source_108() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.web.table", alias: "core_core_web_table", path: "Core/web/table.jet", owner: "", owned_members: [String]{"clear_focus", "clear_selection", "column", "facts", "filter", "filter_by", "first_page", "focus", "focused_key", "insert_row", "keys", "last_page", "new", "new_keyed", "next_page", "page", "page_state", "paginate", "remove_row", "replace_row", "selected_keys", "selected_rows", "set_rows", "set_selected", "sort", "sort_by", "state", "toggle_selection", "update_row", "visible_rows", "with_column", "with_server_page"}, source: "// core.web.table — typed rows, sorting, filtering, and paging.\nC_MAX_TABLE_PAGE_SIZE :: 4096\n\nC_MAX_TABLE_COLUMNS :: 256\n\nC_MAX_TABLE_ROWS :: 1048576\nC_MAX_TABLE_INDEX :: 2147483647\n\n\n\n#Error\npub enum WebTableError {{\n    NotFound\n    Invalid\n}}\n\npub enum WebTableSortDirection {{\n    Ascending\n    Descending\n}}\n\npub enum WebTablePageMode {{\n    Client\n    Server\n}}\n\npub struct WebTableSort {{\n    pub column: String\n    pub descending: Bool\n}}\n\npub struct WebTableFilter {{\n    pub column: String\n    pub value: String\n}}\n\npub struct WebTableColumn<T> {{\n    pub name: String\n    pub label: String\n    pub project: fn(T) -> String Never!\n}}\n\npub struct WebTableRow<T> {{\n    pub key: String\n    pub value: T\n}}\n\npub struct WebTablePage<T> {{\n    pub rows: [WebTableRow<T>]\n    pub index: Int\n    pub size: Int\n    pub total: Int\n}}\n\npub struct WebTableState {{\n    pub sort: WebTableSort\n    pub filter: WebTableFilter\n    pub page_index: Int\n    pub page_size: Int\n    pub selected: [String]\n    pub focus: String\n    pub page_mode: WebTablePageMode\n}}\n\npub struct WebTable<T> {{\n    pub columns: [WebTableColumn<T>]\n    pub rows: [WebTableRow<T>]\n    pub state: WebTableState\n}}\n\npub fn new<T>(columns: String, rows: [T]) -> WebTable<T> Never! {{\n    cols := parse_columns<T>(columns)\n    keyed := [WebTableRow<T>]{{ }}\n    loop i in 0..<rows.len() -> &keyed.push(WebTableRow<T>{{key: \"{{i}}\", value: rows[i]}})\n    WebTable<T>{{columns: cols, rows: keyed, state: default_state()}}\n}}\n\npub fn new_keyed<T, E>(columns: String, rows: [T], key_fn: fn(T) -> String E!) -> WebTable<T> E! {{\n    cols := parse_columns<T>(columns)\n    keyed := [WebTableRow<T>]{{ }}\n    loop row in rows -> &keyed.push(WebTableRow<T>{{key: key_fn(row), value: row}})\n    WebTable<T>{{columns: cols, rows: keyed, state: default_state()}}\n}}\n\npub fn column<T>(name: String, label: String, project: ^fn(T) -> String Never!) -> WebTableColumn<T> Never! {{\n    WebTableColumn<T>{{name: name, label: label, project: project}}\n}}\n\npub fn with_column<T>(table: &WebTable<T>, col: WebTableColumn<T>) -> WebTable<T> Never! {{\n    if col.name.len() == 0 || table.columns.len() >= C_MAX_TABLE_COLUMNS -> return ~table\n    loop existing in table.columns {{\n        if existing.name == col.name -> return ~table\n    }}\n    cols := copy_columns<T>(table.columns)\n    &cols.push(col)\n    table.columns = cols\n    ~table\n}}\n\npub fn with_server_page<T, E>(table: &WebTable<T>, fetch: fn(WebTableState) -> WebTablePage<T> E!) -> WebTable<T> E! {{\n    page :: fetch(table.state)\n    if page.index < 0 || page.index > C_MAX_TABLE_INDEX || page.size < 1 || page.size > C_MAX_TABLE_PAGE_SIZE || page.total < 0 || page.total > C_MAX_TABLE_ROWS || page.rows.len() > C_MAX_TABLE_ROWS || page.rows.len() > page.total {{\n        return ~table\n    }}\n    table.rows = page.rows\n    table.state.page_index = page.index\n    table.state.page_size = page.size\n    table.state.page_mode = WebTablePageMode.Server\n    ~table\n}}\n\npub fn state<T>(table: WebTable<T>) -> WebTableState Never! {{ table.state }}\n\npub fn facts<T>(table: WebTable<T>) -> String Never! {{\n    \"{{{{\\\"rows\\\":{{table.rows.len()}},\\\"page\\\":{{table.state.page_index}},\\\"page_size\\\":{{table.state.page_size}}}}}}\"\n}}\n\npub fn keys<T>(table: WebTable<T>) -> [String] WebTableError! {{\n    out := [String]{{ }}\n    loop row in table.rows -> &out.push(row.key)\n    Ok(out)\n}}\n\npub fn page_state<T>(table: WebTable<T>) -> WebTablePage<T> WebTableError! {{\n    if table.state.page_size < 1 || table.state.page_size > C_MAX_TABLE_PAGE_SIZE || table.state.page_index < 0 || table.state.page_index > C_MAX_TABLE_INDEX -> return Err(WebTableError.Invalid)\n    rows := projected_rows<T>(table)\n    start := table.state.page_index * table.state.page_size\n    if start > rows.len() -> start = rows.len()\n    finish := start + table.state.page_size\n    if finish > rows.len() -> finish = rows.len()\n    visible := [WebTableRow<T>]{{}}\n    loop i in start..<finish -> &visible.push(rows[i])\n    Ok(WebTablePage<T>{{rows: visible, index: table.state.page_index, size: table.state.page_size, total: rows.len()}})\n}}\n\npub fn sort<T, E>(rows: [T], descending: Bool, key_fn: fn(T) -> String E!) -> [T] E! {{\n    out := copy_values<T>(rows)\n    n := out.len()\n    if n < 2 -> return out\n    loop i in 0..<n {{\n        loop j in 0..<(n - 1) {{\n            a := key_fn(out[j])\n            b := key_fn(out[j + 1])\n            swap := a > b\n            if descending -> swap = a < b\n            if swap {{\n                tmp := out[j]\n                out[j] = out[j + 1]\n                out[j + 1] = tmp\n            }}\n        }}\n    }}\n    out\n}}\n\npub fn filter<T, E>(rows: [T], predicate: fn(T) -> Bool E!) -> [T] E! {{\n    out := [T]{{ }}\n    loop row in rows {{\n        if predicate(row) -> &out.push(row)\n    }}\n    out\n}}\n\npub fn page<T>(rows: [T], index: Int, size: Int) -> WebTablePage<T> WebTableError! {{\n    if size < 1 || size > C_MAX_TABLE_PAGE_SIZE || index < 0 || index > C_MAX_TABLE_INDEX -> return Err(WebTableError.Invalid)\n    start := index * size\n    if start > rows.len() -> start = rows.len()\n    finish := start + size\n    if finish > rows.len() -> finish = rows.len()\n    out := [WebTableRow<T>]{{ }}\n    loop i in start..<finish -> &out.push(WebTableRow<T>{{key: \"{{i}}\", value: rows[i]}})\n    Ok(WebTablePage<T>{{rows: out, index: index, size: size, total: rows.len()}})\n}}\n\npub fn sort_by<T>(table: &WebTable<T>, name: String, direction: WebTableSortDirection) -> WebTable<T> Never! {{\n    table.state.sort = WebTableSort{{column: name, descending: direction == WebTableSortDirection.Descending}}\n    table.state.page_index = 0\n    ~table\n}}\n\npub fn filter_by<T>(table: &WebTable<T>, name: String, value: String) -> WebTable<T> Never! {{\n    table.state.filter = WebTableFilter{{column: name, value: value}}\n    table.state.page_index = 0\n    ~table\n}}\n\npub fn paginate<T>(table: &WebTable<T>, index: Int, size: Int) -> WebTable<T> Never! {{\n    i := index\n    if i < 0 -> i = 0\n    if i > C_MAX_TABLE_INDEX -> i = C_MAX_TABLE_INDEX\n    n := size\n    if n < 1 -> n = 25\n    if n > C_MAX_TABLE_PAGE_SIZE -> n = C_MAX_TABLE_PAGE_SIZE\n    table.state.page_index = i\n    table.state.page_size = n\n    ~table\n}}\n\npub fn set_rows<T>(table: &WebTable<T>, rows: [T]) WebTableError! {{\n    if rows.len() > C_MAX_TABLE_ROWS -> return Err(WebTableError.Invalid)\n    keyed := [WebTableRow<T>]{{ }}\n    loop i in 0..<rows.len() -> &keyed.push(WebTableRow<T>{{key: \"{{i}}\", value: rows[i]}})\n    table.rows = keyed\n    table.state.page_index = 0\n    table.state.selected = [String]{{}}\n    table.state.focus = \"\"\n    return Ok()\n}}\n\npub fn set_selected<T>(table: &WebTable<T>, key: String, on: Bool) -> WebTable<T> WebTableError! {{\n    if !has_key<T>(table.rows, key) -> return Err(WebTableError.NotFound)\n    selected := [String]{{ }}\n    loop item in table.state.selected {{\n        if item != key -> &selected.push(item)\n    }}\n    if on -> &selected.push(key)\n    table.state.selected = selected\n    Ok(~table)\n}}\n\npub fn toggle_selection<T>(table: &WebTable<T>, key: String) -> WebTable<T> WebTableError! {{\n    enabled := true\n    loop item in table.state.selected {{\n        if item == key -> enabled = false\n    }}\n    set_selected<T>(&table, key, enabled)\n}}\n\npub fn focus<T>(table: &WebTable<T>, key: String) -> WebTable<T> WebTableError! {{\n    if !has_key<T>(table.rows, key) -> return Err(WebTableError.NotFound)\n    table.state.focus = key\n    Ok(~table)\n}}\n\npub fn clear_focus<T>(table: &WebTable<T>) -> WebTable<T> Never! {{\n    table.state.focus = \"\"\n    ~table\n}}\n\npub fn focused_key<T>(table: WebTable<T>) -> String? Never! {{\n    if table.state.focus.len() == 0 -> return None\n    Val(table.state.focus)\n}}\n\npub fn clear_selection<T>(table: &WebTable<T>) -> WebTable<T> Never! {{\n    table.state.selected = [String]{{ }}\n    ~table\n}}\n\npub fn selected_keys<T>(table: WebTable<T>) -> [String] Never! {{ table.state.selected }}\n\npub fn selected_rows<T>(table: WebTable<T>) -> [WebTableRow<T>] WebTableError! {{\n    out := [WebTableRow<T>]{{ }}\n    seen := [String]{{}}\n    loop key in table.state.selected {{\n        if contains_key(seen, key) -> next\n        loop row in table.rows {{\n            if row.key == key {{\n                &out.push(row)\n                &seen.push(~key)\n                break\n            }}\n        }}\n    }}\n    Ok(out)\n}}\n\npub fn insert_row<T>(table: &WebTable<T>, row: T) -> String WebTableError! {{\n    if table.rows.len() >= C_MAX_TABLE_ROWS -> return Err(WebTableError.Invalid)\n    key := \"{{table.rows.len()}}\"\n    loop {{\n        if !has_key<T>(table.rows, key) -> break\n        key = \"{{table.rows.len() + 1}}\"\n    }}\n    &table.rows.push(WebTableRow<T>{{key: key, value: row}})\n    Ok(key)\n}}\n\npub fn replace_row<T>(table: &WebTable<T>, key: String, row: T) WebTableError! {{\n    loop i in 0..<table.rows.len() {{\n        if table.rows[i].key == key {{\n            table.rows[i] = WebTableRow<T>{{key: key, value: row}}\n            return Ok()\n        }}\n    }}\n    return Err(WebTableError.NotFound)\n}}\n\npub fn update_row<T: Clone>(table: &WebTable<T>, key: String, transform: fn(T) -> T) WebTableError! {{\n    loop i in 0..<table.rows.len() {{\n        if table.rows[i].key == key {{\n            updated :: transform(~table.rows[i].value) ?? ~table.rows[i].value\n            table.rows[i] = WebTableRow<T>{{key: ~table.rows[i].key, value: updated}}\n            return Ok()\n        }}\n    }}\n    return Err(WebTableError.NotFound)\n}}\n\npub fn remove_row<T>(table: &WebTable<T>, key: String) -> T WebTableError! {{\n    if table.rows.len() == 0 -> return Err(WebTableError.NotFound)\n    remaining := [WebTableRow<T>]{{}}\n    found := false\n    removed := table.rows[0].value\n    loop row in table.rows {{\n        if row.key == key {{\n            removed = row.value\n            found = true\n        }} else {{\n            &remaining.push(row)\n        }}\n    }}\n    if !found -> return Err(WebTableError.NotFound)\n    table.rows = remaining\n    selected := [String]{{}}\n    loop item in table.state.selected {{\n        if item != key -> &selected.push(item)\n    }}\n    table.state.selected = selected\n    if table.state.focus == key -> table.state.focus = \"\"\n    if table.state.page_index > 0 {{\n        visible := projected_rows<T>(~table)\n        page_size := table.state.page_size\n        if page_size < 1 -> page_size = 25\n        if page_size > C_MAX_TABLE_PAGE_SIZE -> page_size = C_MAX_TABLE_PAGE_SIZE\n        table.state.page_size = page_size\n        pages := (visible.len() + page_size - 1) /% page_size\n        if pages < 1 -> pages = 1\n        if table.state.page_index >= pages -> table.state.page_index = pages - 1\n    }}\n    Ok(removed)\n}}\n\npub fn first_page<T>(table: &WebTable<T>) -> WebTable<T> Never! {{\n    table.state.page_index = 0\n    ~table\n}}\n\npub fn next_page<T>(table: &WebTable<T>) -> WebTable<T> Never! {{\n    if table.state.page_size < 1 -> table.state.page_size = 25\n    if table.state.page_size > C_MAX_TABLE_PAGE_SIZE -> table.state.page_size = C_MAX_TABLE_PAGE_SIZE\n    rows := projected_rows<T>(~table)\n    pages := (rows.len() + table.state.page_size - 1) /% table.state.page_size\n    if pages < 1 -> pages = 1\n    if table.state.page_index + 1 < pages -> table.state.page_index = table.state.page_index + 1\n    ~table\n}}\n\npub fn last_page<T>(table: &WebTable<T>) -> WebTable<T> WebTableError! {{\n    if table.state.page_size < 1 || table.state.page_size > C_MAX_TABLE_PAGE_SIZE -> return Err(WebTableError.Invalid)\n    rows := projected_rows<T>(~table)\n    pages := (rows.len() + table.state.page_size - 1) /% table.state.page_size\n    if pages < 1 -> pages = 1\n    table.state.page_index = pages - 1\n    Ok(~table)\n}}\n\npub fn visible_rows<T>(table: WebTable<T>, plan: WebVirtualPlan) -> [WebTableRow<T>] WebTableError! {{\n    projected := projected_rows<T>(table)\n    start := plan.start\n    if start < 0 -> start = 0\n    if start > projected.len() -> start = projected.len()\n    end := plan.end\n    if end < start -> end = start\n    if end > projected.len() -> end = projected.len()\n    if end - start > C_MAX_TABLE_PAGE_SIZE -> end = start + C_MAX_TABLE_PAGE_SIZE\n    if end > projected.len() -> end = projected.len()\n    out := [WebTableRow<T>]{{ }}\n    loop i in start..<end -> &out.push(projected[i])\n    Ok(out)\n}}\nfn projected_rows<T>(table: WebTable<T>) -> [WebTableRow<T>] Never! {{\n    rows := [WebTableRow<T>]{{}}\n    filter_index := column_index<T>(table.columns, table.state.filter.column)\n    loop row in table.rows {{\n        if filter_index < 0 || table.state.filter.value.len() == 0 {{\n            &rows.push(row)\n        }} else {{\n            text := table.columns[filter_index].project(row.value)\n            if contains_text(text, table.state.filter.value) -> &rows.push(row)\n        }}\n    }}\n    sort_index := column_index<T>(table.columns, table.state.sort.column)\n    if sort_index >= 0 && rows.len() > 1 {{\n        loop i in 0..<rows.len() {{\n            loop j in 0..<(rows.len() - 1) {{\n                left := table.columns[sort_index].project(rows[j].value)\n                right := table.columns[sort_index].project(rows[j + 1].value)\n                swap := left > right\n                if table.state.sort.descending -> swap = left < right\n                if swap {{\n                    temp := rows[j]\n                    rows[j] = rows[j + 1]\n                    rows[j + 1] = temp\n                }}\n            }}\n        }}\n    }}\n    rows\n}}\n\nfn column_index<T>(columns: [WebTableColumn<T>], name: String) -> Int Never! {{\n    if name.len() == 0 -> return -1\n    loop i in 0..<columns.len() {{\n        if columns[i].name == name -> return i\n    }}\n    -1\n}}\n\nfn contains_text(text: String, needle: String) -> Bool Never! {{\n    if needle.len() == 0 -> return true\n    a := text.bytes()\n    b := needle.bytes()\n    if b.len() > a.len() -> return false\n    loop i in 0..<(a.len() - b.len() + 1) {{\n        match := true\n        loop j in 0..<b.len() {{\n            if a[i + j] != b[j] -> match = false\n        }}\n        if match -> return true\n    }}\n    false\n}}\nfn contains_key(items: [String], key: String) -> Bool Never! {{\n    loop item in items {{\n        if item == key -> return true\n    }}\n    false\n}}\nfn has_control_text(text: String) -> Bool {{\n    loop b in text.bytes() {{\n        n :: Int.from_u8(b)\n        if n < 32 || n == 127 -> return true\n    }}\n    false\n}}\n\nfn default_state() -> WebTableState {{\n    WebTableState{{sort: WebTableSort{{column: \"\", descending: false}}, filter: WebTableFilter{{column: \"\", value: \"\"}}, page_index: 0, page_size: 25, selected: [String]{{ }}, focus: \"\", page_mode: WebTablePageMode.Client}}\n}}\nfn parse_columns<T>(text: String) -> [WebTableColumn<T>] {{\n    out := [WebTableColumn<T>]{{ }}\n    loop raw_name in split_commas(text) {{\n        name :: trim(~raw_name)\n        if out.len() >= C_MAX_TABLE_COLUMNS -> next\n        if name.len() > 0 && name.len() <= 128 && !has_control_text(name) -> &out.push(WebTableColumn<T>{{name: ~name, label: ~name, project: default_project}})\n    }}\n    out\n}}\nfn default_project<T: Printable>(value: T) -> String Never! {{ \"{{value}}\" }}\n\nfn split_commas(text: String) -> [String] {{\n    raw := text.bytes()\n    out := [String]{{ }}\n    start := 0\n    loop i in 0..<raw.len() {{\n        if raw[i] == (U8{{44}}) {{\n            &out.push(slice_text(text, start, i))\n            start = i + 1\n        }}\n    }}\n    if start <= raw.len() -> &out.push(slice_text(text, start, raw.len()))\n    out\n}}\n\nfn copy_values<T>(values: [T]) -> [T] {{\n    out := [T]{{ }}\n    loop value in values -> &out.push(value)\n    out\n}}\n\nfn copy_columns<T>(columns: [WebTableColumn<T>]) -> [WebTableColumn<T>] {{\n    out := [WebTableColumn<T>]{{ }}\n    loop column in columns -> &out.push(column)\n    out\n}}\n\nfn trim(text: String) -> String {{\n    raw := text.bytes()\n    start := 0\n    end := raw.len()\n    loop start < end {{\n        n :: Int.from_u8(raw[start])\n        if n == 32 || n == 9 -> start = start + 1 else -> break\n    }}\n    loop end > start {{\n        n :: Int.from_u8(raw[end - 1])\n        if n == 32 || n == 9 -> end = end - 1 else -> break\n    }}\n    slice_text(text, start, end)\n}}\nfn has_key<T>(rows: [WebTableRow<T>], key: String) -> Bool Never! {{\n    loop row in rows {{\n        if row.key == key -> return true\n    }}\n    false\n}}\n\nfn slice_text(text: String, start: Int, end: Int) -> String {{\n    raw := text.bytes()\n    out := [U8]{{ }}\n    i := start\n    loop {{\n        if i < 0 || i >= end || i >= raw.len() -> return String.from_bytes(out) ?? \"\"\n        &out.push(raw[i])\n        i = i + 1\n    }}\n}}\n"}
}

fn foundation_embedded_core_source_109() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.web.virtual", alias: "core_core_web_virtual", path: "Core/web/virtual.jet", owner: "", owned_members: [String]{"indices", "plan", "plan_facts", "plan_from_sizes", "plan_indices", "plan_measure", "plan_measured", "plan_resize", "plan_scroll_to", "plan_slice", "plan_viewport", "plan_viewport_measure", "plan_viewport_state", "slice", "window", "window_measured"}, source: "// core.web.virtual — windowed list geometry.\n//\n// A virtual window is a compact layout fact. It never allocates one entry\n// per source row: even a 100_000-row table produces only the bounded\n// visible range. Overscan is in rows; sizes are the renderer's units.\nC_MAX_VISIBLE :: 4096\n\nC_MAX_MEASURE :: 4096\nC_MAX_VIRTUAL_EXTENT :: 9223372036854775807\n\n\npub struct WebVirtualWindow {{\n    pub total_count: Int\n    pub scroll_offset: Int\n    pub viewport_size: Int\n    pub estimated_item_size: Int\n    pub overscan: Int\n    pub start: Int\n    pub end: Int\n    pub total_size: Int\n    pub measured_count: Int\n}}\n\npub struct WebVirtualPlan {{\n    pub total_count: Int\n    pub scroll_offset: Int\n    pub viewport_width: Int\n    pub viewport_height: Int\n    pub estimated_item_size: Int\n    pub overscan: Int\n    pub start: Int\n    pub end: Int\n    pub total_size: Int\n    pub measured_count: Int\n    pub anchor_index: Int\n    pub anchor_offset: Int\n}}\n\npub struct WebVirtualPlanViewport {{\n    pub plan: WebVirtualPlan\n}}\n\n/// Build one bounded virtual range.\npub fn window(total_count: Int, scroll_offset: Int, viewport_size: Int, estimated_item_size: Int, overscan: Int) -> WebVirtualWindow Never! {{\n    total := bounded_nonnegative(total_count)\n    view := bounded_nonnegative(viewport_size)\n    est := estimated_item_size\n    if est < 1 -> est = 1\n    if est > C_MAX_VIRTUAL_EXTENT -> est = C_MAX_VIRTUAL_EXTENT\n    over := overscan\n    if over < 0 -> over = 0\n    if over > C_MAX_VISIBLE -> over = C_MAX_VISIBLE\n    total_size := bounded_mul(total, est)\n    max_off := total_size - view\n    if max_off < 0 -> max_off = 0\n    off := scroll_offset\n    if off < 0 -> off = 0\n    if off > max_off -> off = max_off\n    first := 0\n    if total > 0 -> first = off /% est\n\n    if first > total -> first = total\n    visible := 0\n    if view > 0 {{\n        visible = bounded_add(view, est - 1) /% est\n        if visible > C_MAX_VISIBLE -> visible = C_MAX_VISIBLE\n    }}\n    last := bounded_add(first, visible)\n    if last > total -> last = total\n    start := first - over\n    if start < 0 -> start = 0\n    end := bounded_add(last, over)\n    if end > total -> end = total\n    if end - start > C_MAX_VISIBLE {{\n        start = first - (C_MAX_VISIBLE /% 2)\n\n        if start < 0 -> start = 0\n        if start > total -> start = total\n        end = bounded_add(start, C_MAX_VISIBLE)\n        if end > total -> end = total\n    }}\n    {{\n        total_count: total,\n        scroll_offset: off,\n        viewport_size: view,\n        estimated_item_size: est,\n        overscan: over,\n        start: start,\n        end: end,\n        total_size: total_size,\n        measured_count: 0,\n    }}\n}}\n\npub fn window_measured(total_count: Int, scroll_offset: Int, viewport_size: Int, fallback_item_size: Int, overscan: Int, measurements: [Int]) -> WebVirtualWindow Never! {{\n    sum := 0\n    count := 0\n    loop s in measurements {{\n        if s > 0 && count < C_MAX_MEASURE {{\n            sum = bounded_add(sum, bounded_nonnegative(s))\n            count = count + 1\n        }}\n    }}\n    est := fallback_item_size\n    if est < 1 -> est = 1\n    if est > C_MAX_VIRTUAL_EXTENT -> est = C_MAX_VIRTUAL_EXTENT\n    if count > 0 -> est = sum /% count\n\n    if est < 1 -> est = 1\n    w :: window(total_count, scroll_offset, viewport_size, est, overscan)\n    out := WebVirtualWindow{{\n        total_count: w.total_count,\n        scroll_offset: w.scroll_offset,\n        viewport_size: w.viewport_size,\n        estimated_item_size: w.estimated_item_size,\n        overscan: w.overscan,\n        start: w.start,\n        end: w.end,\n        total_size: w.total_size,\n        measured_count: count,\n    }}\n    out\n}}\n\n\npub fn slice<T>(rows: [T], w: WebVirtualWindow) -> [T] Never! {{\n    start := w.start\n    if start < 0 -> start = 0\n    if start > rows.len() -> start = rows.len()\n    end := w.end\n    if end < start -> end = start\n    if end > rows.len() -> end = rows.len()\n    if end - start > C_MAX_VISIBLE -> end = start + C_MAX_VISIBLE\n    if end > rows.len() -> end = rows.len()\n    out := [T]{{}}\n    loop i in start..<end -> &out.push(rows[i])\n    out\n}}\n\npub fn indices(w: WebVirtualWindow) -> [Int] Never! {{\n    out := [Int]{{}}\n    start := w.start\n    if start < 0 -> start = 0\n    if start >= w.end -> return out\n    end := w.end\n    limit := bounded_add(start, C_MAX_VISIBLE)\n    if end > limit -> end = limit\n    loop i in start..<end -> &out.push(i)\n    out\n}}\n\npub fn plan(total_count: Int, scroll_offset: Int, viewport_width: Int, viewport_height: Int, estimated_item_size: Int, overscan: Int) -> WebVirtualPlan Never! {{\n    w :: window(total_count, scroll_offset, viewport_height, estimated_item_size, overscan)\n    WebVirtualPlan{{total_count: w.total_count, scroll_offset: w.scroll_offset, viewport_width: max0(viewport_width), viewport_height: w.viewport_size, estimated_item_size: w.estimated_item_size, overscan: w.overscan, start: w.start, end: w.end, total_size: w.total_size, measured_count: 0, anchor_index: w.start, anchor_offset: 0}}\n}}\n\npub fn plan_measured(total_count: Int, scroll_offset: Int, viewport_width: Int, viewport_height: Int, fallback_item_size: Int, overscan: Int, measurements: [Int]) -> WebVirtualPlan Never! {{\n    w :: window_measured(total_count, scroll_offset, viewport_height, fallback_item_size, overscan, measurements)\n    WebVirtualPlan{{total_count: w.total_count, scroll_offset: w.scroll_offset, viewport_width: max0(viewport_width), viewport_height: w.viewport_size, estimated_item_size: w.estimated_item_size, overscan: w.overscan, start: w.start, end: w.end, total_size: w.total_size, measured_count: w.measured_count, anchor_index: w.start, anchor_offset: 0}}\n}}\n\npub fn plan_from_sizes(total_count: Int, scroll_offset: Int, viewport_width: Int, viewport_height: Int, fallback_item_size: Int, overscan: Int, sizes: [Int]) -> WebVirtualPlan Never! {{\n    plan_measured(total_count, scroll_offset, viewport_width, viewport_height, fallback_item_size, overscan, sizes)\n}}\n\npub fn plan_slice<T>(rows: [T], p: WebVirtualPlan) -> [T] Never! {{\n    w := WebVirtualWindow{{total_count: p.total_count, scroll_offset: p.scroll_offset, viewport_size: p.viewport_height, estimated_item_size: p.estimated_item_size, overscan: p.overscan, start: p.start, end: p.end, total_size: p.total_size, measured_count: p.measured_count}}\n    slice<T>(rows, w)\n}}\n\npub fn plan_indices(p: WebVirtualPlan) -> [Int] Never! {{\n    w := WebVirtualWindow{{total_count: p.total_count, scroll_offset: p.scroll_offset, viewport_size: p.viewport_height, estimated_item_size: p.estimated_item_size, overscan: p.overscan, start: p.start, end: p.end, total_size: p.total_size, measured_count: p.measured_count}}\n    indices(w)\n}}\n\npub fn plan_viewport(p: WebVirtualPlan) -> WebVirtualPlanViewport Never! {{ {{plan: p}} }}\n\npub fn plan_measure(p: WebVirtualPlan, index: Int, size: Int) -> WebVirtualPlan Never! {{\n    if index < 0 || index >= p.total_count || size <= 0 || size > C_MAX_VIRTUAL_EXTENT -> return ~p\n    if p.measured_count >= C_MAX_MEASURE -> return ~p\n    count := p.measured_count + 1\n    total := bounded_add(bounded_mul(p.estimated_item_size, p.measured_count), size)\n    est := total /% count\n    if est < 1 -> est = 1\n    w :: window(p.total_count, p.scroll_offset, p.viewport_height, est, p.overscan)\n    WebVirtualPlan{{total_count: w.total_count, scroll_offset: w.scroll_offset, viewport_width: p.viewport_width, viewport_height: w.viewport_size, estimated_item_size: est, overscan: w.overscan, start: w.start, end: w.end, total_size: w.total_size, measured_count: count, anchor_index: p.anchor_index, anchor_offset: p.anchor_offset}}\n}}\n\npub fn plan_viewport_state(v: WebVirtualPlanViewport) -> WebVirtualPlan Never! {{ v.plan }}\n\npub fn plan_scroll_to(v: &WebVirtualPlanViewport, scroll_offset: Int) Never! {{\n    w :: window(v.plan.total_count, scroll_offset, v.plan.viewport_height, v.plan.estimated_item_size, v.plan.overscan)\n    v.plan.scroll_offset = w.scroll_offset\n    v.plan.start = w.start\n    v.plan.end = w.end\n    v.plan.total_size = w.total_size\n    v.plan.anchor_index = w.start\n    v.plan.anchor_offset = 0\n}}\n\npub fn plan_resize(v: &WebVirtualPlanViewport, viewport_width: Int, viewport_height: Int) Never! {{\n    v.plan.viewport_width = max0(viewport_width)\n    v.plan.viewport_height = max0(viewport_height)\n    w :: window(v.plan.total_count, v.plan.scroll_offset, v.plan.viewport_height, v.plan.estimated_item_size, v.plan.overscan)\n    v.plan.start = w.start\n    v.plan.end = w.end\n    v.plan.total_size = w.total_size\n}}\n\npub fn plan_viewport_measure(v: &WebVirtualPlanViewport, index: Int, size: Int) Never! {{\n    v.plan = plan_measure(v.plan, index, size)\n}}\n\npub fn plan_facts(p: WebVirtualPlan) -> String Never! {{\n    vis := p.end - p.start\n    if vis < 0 -> vis = 0\n    \"{{{{\\\"total_count\\\":{{p.total_count}},\\\"start\\\":{{p.start}},\\\"end\\\":{{p.end}},\\\"visible\\\":{{vis}},\\\"estimated_item_size\\\":{{p.estimated_item_size}}}}}}\"\n}}\n\nfn max0(n: Int) -> Int {{\n    if n < 0 -> return 0\n    n\n}}\nfn bounded_nonnegative(n: Int) -> Int {{\n    if n < 0 -> return 0\n    if n > C_MAX_VIRTUAL_EXTENT -> return C_MAX_VIRTUAL_EXTENT\n    n\n}}\n\nfn bounded_add(a: Int, b: Int) -> Int {{\n    if a <= 0 -> return bounded_nonnegative(b)\n    if b <= 0 -> return a\n    if a > C_MAX_VIRTUAL_EXTENT - b -> return C_MAX_VIRTUAL_EXTENT\n    a + b\n}}\n\nfn bounded_mul(a: Int, b: Int) -> Int {{\n    if a <= 0 || b <= 0 -> return 0\n    if a > C_MAX_VIRTUAL_EXTENT /% b -> return C_MAX_VIRTUAL_EXTENT\n    a * b\n}}\n"}
}

fn foundation_embedded_core_source_110() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "__core_text_string", alias: "__core_text_string", path: "Core/text/string.jet", owner: "core.text", owned_members: [String]{}, source: "// Compiler-owned String receiver methods.\n//\n// This source part is scheduled with `core.text` but is deliberately not a\n// public Core module. Receiver-first functions keep the canonical primitive\n// `String` identity while giving the standard method surface a Jet-owned body.\n\n// S41: `len` counts Unicode scalars, the items `loop c in s.chars()` visits.\n// UTF-8 byte length is `count_bytes()` (or `text.byte_count`).\nfn len(receiver: String) -> Int {{\n    receiver.chars().len()\n}}\n"}
}
