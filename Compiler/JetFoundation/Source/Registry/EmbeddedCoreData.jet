    FoundationCoreSource{module_name: "core.http", alias: "core_core_http", path: "Core/http/http.jet", owner: "", owned_members: [String]{"body_as_text", "body_bytes", "body_empty", "body_text", "headers", "headers_all", "headers_append", "headers_encode", "headers_get", "headers_parse", "headers_remove", "headers_set", "is_client_error", "is_informational", "is_redirect", "is_server_error", "is_success", "method_parse", "method_text", "status", "status_accepted", "status_already_reported", "status_bad_gateway", "status_bad_request", "status_conflict", "status_continue", "status_created", "status_expectation_failed", "status_failed_dependency", "status_forbidden", "status_found", "status_gateway_timeout", "status_gone", "status_http_version", "status_legal", "status_length_required", "status_locked", "status_method_not_allowed", "status_moved", "status_multi_status", "status_no_content", "status_non_authoritative", "status_not_acceptable", "status_not_found", "status_not_implemented", "status_not_modified", "status_ok", "status_partial", "status_payload_too_large", "status_payment_required", "status_permanent", "status_precondition_failed", "status_precondition_required", "status_range_unsat", "status_reset_content", "status_see_other", "status_server_error", "status_switching", "status_teapot", "status_temporary", "status_timeout", "status_too_early", "status_too_many", "status_unauthorized", "status_unavailable", "status_unprocessable", "status_unsupported_media", "status_upgrade_required", "status_uri_too_long", "version_parse", "version_text", "body_as_bytes", "body_len", "reason_phrase", "get", "post", "put", "patch", "delete", "head", "serve", "exchange", "send_request", "parse_response", "parse_request", "query", "query_get", "query_all", "query_set", "query_encode", "query_decode", "form_encode", "form_decode", "cookie", "cookie_encode", "cookies_parse", "basic_auth", "bearer_auth", "with_header", "with_body", "with_query", "status_class", "request_with", "response_ok", "response_json_headers", "response_text_headers", "has_header", "content_length"}, source: "package {{\n    name: \"core.http\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"HTTP client and server over core.net.\"\n    license: \"MIT\"\n    outputs: {{\n        http: .Library{{ entry: http }}\n    }}\n}}\n\nuse core as core\nuse core.http.client as provider\nuse core.net.url as http_url\nC_MAX_BODY_BYTES :: 1048576\nC_MAX_HEADER_BYTES :: 32768\nC_MAX_HEADER_LINE_BYTES :: 8192\nC_MAX_HEADER_COUNT :: 100\nC_MAX_REQUEST_LINE_BYTES :: 8192\nC_MAX_URL_BYTES :: 8192\n// core.http — bounded HTTP/1.1 message semantics.\n//\n// The host bridge remains only a typed request/response transport leaf.\n// Method parsing, header/query/cookie codecs, request framing, response\n// parsing, limits, and all deterministic convenience behavior are Jet.\nmodule client\nmodule server\n#Error\npub enum HTTPError {{\n    InvalidMethod\n    InvalidURL\n    InvalidHeader\n    InvalidStatus\n    BodyConsumed\n    InvalidFraming\n    UnsupportedEncoding\n    Cancelled\n    BodyTooLarge(limit: Int)\n    Resolve(host: String)\n    Connect(address: String)\n    TLS(stage: String)\n    Timeout(phase: String)\n    Proxy(stage: String)\n    Redirect(reason: String)\n    Protocol(version: String)\n    IO(operation: String)\n    Policy(reason: String)\n    ResourceUnavailable(resource: String)\n    Internal(incident_id: String)\n    UnsupportedTarget(operation: HTTPOperation)\n}}\n\npub enum Method {{\n    Get\n    Head\n    Post\n    Put\n    Patch\n    Delete\n    Options\n    Trace\n    Connect\n    Custom(String)\n}}\n\npub enum Version {{\n    HTTP10\n    HTTP11\n    HTTP2\n    HTTP3\n}}\n\npub struct Status {{\n    pub code: Int\n    pub reason: String\n}}\n\npub struct Header {{\n    pub name: String\n    pub value: String\n}}\n\npub struct Headers {{\n    pub fields: [Header]\n}}\n\npub enum Body {{\n    Empty\n    Text(String)\n    Bytes([U8])\n}}\n\n\n\n\npub fn method_parse(token: String) -> Method Never! {{\n    u :: ascii_upper(token)\n    if u == {{\n        \"GET\" -> Method.Get\n        \"HEAD\" -> Method.Head\n        \"POST\" -> Method.Post\n        \"PUT\" -> Method.Put\n        \"PATCH\" -> Method.Patch\n        \"DELETE\" -> Method.Delete\n        \"OPTIONS\" -> Method.Options\n        \"TRACE\" -> Method.Trace\n        \"CONNECT\" -> Method.Connect\n        else -> Method.Custom(token)\n    }}\n}}\n\npub fn method_text(method: Method) -> String Never! {{\n    if method == {{\n        Method.Get -> \"GET\"\n        Method.Head -> \"HEAD\"\n        Method.Post -> \"POST\"\n        Method.Put -> \"PUT\"\n        Method.Patch -> \"PATCH\"\n        Method.Delete -> \"DELETE\"\n        Method.Options -> \"OPTIONS\"\n        Method.Trace -> \"TRACE\"\n        Method.Connect -> \"CONNECT\"\n        .Custom(s) -> s\n        else -> \"GET\"\n    }}\n}}\n\npub fn version_text(v: Version) -> String Never! {{\n    if v == {{\n        Version.HTTP10 -> \"HTTP/1.0\"\n        Version.HTTP11 -> \"HTTP/1.1\"\n        Version.HTTP2 -> \"HTTP/2\"\n        Version.HTTP3 -> \"HTTP/3\"\n        else -> \"HTTP/3\"\n    }}\n}}\n\npub fn version_parse(token: String) -> Version Never! {{\n    if token == {{\n        \"HTTP/1.0\" -> Version.HTTP10\n        \"HTTP/2\" -> Version.HTTP2\n        \"HTTP/3\" -> Version.HTTP3\n        \"HTTP/1.1\" -> Version.HTTP11\n        else -> Version.HTTP11\n    }}\n}}\n\npub fn status(code: Int) -> Status Never! {{ Status{{code: code, reason: reason_phrase(code)}} }}\npub fn status_ok() -> Status Never! {{ status(200) }}\npub fn status_created() -> Status Never! {{ status(201) }}\npub fn status_no_content() -> Status Never! {{ status(204) }}\npub fn status_moved() -> Status Never! {{ status(301) }}\npub fn status_found() -> Status Never! {{ status(302) }}\npub fn status_bad_request() -> Status Never! {{ status(400) }}\npub fn status_unauthorized() -> Status Never! {{ status(401) }}\npub fn status_forbidden() -> Status Never! {{ status(403) }}\npub fn status_not_found() -> Status Never! {{ status(404) }}\npub fn status_timeout() -> Status Never! {{ status(408) }}\npub fn status_server_error() -> Status Never! {{ status(500) }}\npub fn status_continue() -> Status Never! {{ status(100) }}\npub fn status_switching() -> Status Never! {{ status(101) }}\npub fn status_accepted() -> Status Never! {{ status(202) }}\npub fn status_non_authoritative() -> Status Never! {{ status(203) }}\npub fn status_reset_content() -> Status Never! {{ status(205) }}\npub fn status_partial() -> Status Never! {{ status(206) }}\npub fn status_multi_status() -> Status Never! {{ status(207) }}\npub fn status_already_reported() -> Status Never! {{ status(208) }}\npub fn status_see_other() -> Status Never! {{ status(303) }}\npub fn status_not_modified() -> Status Never! {{ status(304) }}\npub fn status_temporary() -> Status Never! {{ status(307) }}\npub fn status_permanent() -> Status Never! {{ status(308) }}\npub fn status_payment_required() -> Status Never! {{ status(402) }}\npub fn status_method_not_allowed() -> Status Never! {{ status(405) }}\npub fn status_not_acceptable() -> Status Never! {{ status(406) }}\npub fn status_conflict() -> Status Never! {{ status(409) }}\npub fn status_gone() -> Status Never! {{ status(410) }}\npub fn status_length_required() -> Status Never! {{ status(411) }}\npub fn status_precondition_failed() -> Status Never! {{ status(412) }}\npub fn status_payload_too_large() -> Status Never! {{ status(413) }}\npub fn status_uri_too_long() -> Status Never! {{ status(414) }}\npub fn status_unsupported_media() -> Status Never! {{ status(415) }}\npub fn status_range_unsat() -> Status Never! {{ status(416) }}\npub fn status_expectation_failed() -> Status Never! {{ status(417) }}\npub fn status_teapot() -> Status Never! {{ status(418) }}\npub fn status_unprocessable() -> Status Never! {{ status(422) }}\npub fn status_locked() -> Status Never! {{ status(423) }}\npub fn status_failed_dependency() -> Status Never! {{ status(424) }}\npub fn status_too_early() -> Status Never! {{ status(425) }}\npub fn status_upgrade_required() -> Status Never! {{ status(426) }}\npub fn status_precondition_required() -> Status Never! {{ status(428) }}\npub fn status_too_many() -> Status Never! {{ status(429) }}\npub fn status_legal() -> Status Never! {{ status(451) }}\npub fn status_not_implemented() -> Status Never! {{ status(501) }}\npub fn status_bad_gateway() -> Status Never! {{ status(502) }}\npub fn status_unavailable() -> Status Never! {{ status(503) }}\npub fn status_gateway_timeout() -> Status Never! {{ status(504) }}\npub fn status_http_version() -> Status Never! {{ status(505) }}\n\npub fn is_informational(s: Status) -> Bool Never! {{ s.code >= 100 && s.code < 200 }}\npub fn is_success(s: Status) -> Bool Never! {{ s.code >= 200 && s.code < 300 }}\npub fn is_redirect(s: Status) -> Bool Never! {{ s.code >= 300 && s.code < 400 }}\npub fn is_client_error(s: Status) -> Bool Never! {{ s.code >= 400 && s.code < 500 }}\npub fn is_server_error(s: Status) -> Bool Never! {{ s.code >= 500 && s.code < 600 }}\n\npub fn headers() -> Headers Never! {{ Headers{{fields: [Header]{{}}}} }}\n\npub fn headers_get(h: Headers, name: String) -> String? Never! {{\n    want :: ascii_lower(name)\n    loop f in h.fields {{\n        if ascii_lower(f.name) == want -> return Val(f.value)\n    }}\n    None\n}}\n\npub fn headers_all(h: Headers, name: String) -> [String] Never! {{\n    want :: ascii_lower(name)\n    out := [String]{{}}\n    loop f in h.fields {{\n        if ascii_lower(f.name) == want -> &out.push(f.value)\n    }}\n    out\n}}\n\npub fn headers_set(h: Headers, name: String, value: String) -> Headers Never! {{\n    if !valid_header_name(name) || has_ctl(value.bytes()) -> return ~h\n    want :: ascii_lower(name)\n    fields := [Header]{{}}\n    replaced := false\n    loop f in h.fields {{\n        if ascii_lower(f.name) == want {{\n            if !replaced {{\n                &fields.push(Header{{name: name, value: trim(value)}})\n                replaced = true\n            }}\n        }} else {{\n            &fields.push(f)\n        }}\n    }}\n    if !replaced -> &fields.push(Header{{name: name, value: trim(value)}})\n    Headers{{fields: fields}}\n}}\n\npub fn headers_append(h: Headers, name: String, value: String) -> Headers Never! {{\n    if !valid_header_name(name) || has_ctl(value.bytes()) -> return ~h\n    fields := [Header]{{}}\n    loop f in h.fields -> &fields.push(f)\n    &fields.push(Header{{name: name, value: trim(value)}})\n    Headers{{fields: fields}}\n}}\n\npub fn headers_remove(h: Headers, name: String) -> Headers Never! {{\n    want :: ascii_lower(name)\n    fields := [Header]{{}}\n    loop f in h.fields {{\n        if ascii_lower(f.name) != want -> &fields.push(f)\n    }}\n    Headers{{fields: fields}}\n}}\n\npub fn headers_encode(h: Headers) -> [String] Never! {{\n    out := [String]{{}}\n    loop f in h.fields -> &out.push(\"{{f.name}}: {{f.value}}\")\n    out\n}}\n\npub fn headers_parse(lines: [String]) -> Headers Never! {{\n    h := headers()\n    if !headers_lines_bounded(lines) -> return h\n    loop line in lines {{\n        raw :: line.bytes()\n        col := index_byte(raw, 58)\n        if col <= 0 -> next\n        name_bytes :: slice_b(raw, 0, col)\n        value :: slice_b(raw, col + 1, raw.len())\n        name :: String.from_bytes(name_bytes) ?? \"\"\n        if valid_header_name(name) && !has_ctl(value) -> h = headers_append(h, name, String.from_bytes(value) ?? \"\")\n    }}\n    h\n}}\n\npub fn body_empty() -> Body Never! {{ Body.Empty }}\npub fn body_text(text: String) -> Body Never! {{\n    if text.bytes().len() == 0 -> return Body.Empty\n    Body.Text(text)\n}}\npub fn body_bytes(bytes: [U8]) -> Body Never! {{\n    if bytes.len() == 0 -> return Body.Empty\n    Body.Bytes(bytes)\n}}\n\npub fn body_as_text(body: Body) -> String Never! {{\n    if body == Body.Empty -> return \"\"\n    if body == {{\n        .Text(s) -> return s\n        .Bytes(xs) -> return String.from_bytes(xs) ?? \"\"\n        else -> return \"\"\n    }}\n    \"\"\n}}\n\npub fn body_as_bytes(body: Body) -> [U8] Never! {{\n    if body == {{\n        .Empty -> return [U8]{{}}\n        .Text(s) -> return body_as_text(Body.Text(s)).bytes()\n        .Bytes(xs) -> return xs\n        else -> return [U8]{{}}\n    }}\n    [U8]{{}}\n}}\npub fn body_len(body: Body) -> Int Never! {{ body_as_bytes(body).len() }}\n\npub fn reason_phrase(code: Int) -> String Never! {{\n    if code == {{\n        100 -> return \"Continue\"\n        101 -> return \"Switching Protocols\"\n        102 -> return \"Processing\"\n        103 -> return \"Early Hints\"\n        200 -> return \"OK\"\n        201 -> return \"Created\"\n        202 -> return \"Accepted\"\n        203 -> return \"Non-Authoritative Information\"\n        204 -> return \"No Content\"\n        205 -> return \"Reset Content\"\n        206 -> return \"Partial Content\"\n        207 -> return \"Multi-Status\"\n        208 -> return \"Already Reported\"\n        226 -> return \"IM Used\"\n        300 -> return \"Multiple Choices\"\n        301 -> return \"Moved Permanently\"\n        302 -> return \"Found\"\n        303 -> return \"See Other\"\n        304 -> return \"Not Modified\"\n        305 -> return \"Use Proxy\"\n        307 -> return \"Temporary Redirect\"\n        308 -> return \"Permanent Redirect\"\n        400 -> return \"Bad Request\"\n        401 -> return \"Unauthorized\"\n        402 -> return \"Payment Required\"\n        403 -> return \"Forbidden\"\n        404 -> return \"Not Found\"\n        405 -> return \"Method Not Allowed\"\n        406 -> return \"Not Acceptable\"\n        407 -> return \"Proxy Authentication Required\"\n        408 -> return \"Request Timeout\"\n        409 -> return \"Conflict\"\n        410 -> return \"Gone\"\n        411 -> return \"Length Required\"\n        412 -> return \"Precondition Failed\"\n        413 -> return \"Payload Too Large\"\n        414 -> return \"URI Too Long\"\n        415 -> return \"Unsupported Media Type\"\n        416 -> return \"Range Not Satisfiable\"\n        417 -> return \"Expectation Failed\"\n        418 -> return \"I'm a teapot\"\n        421 -> return \"Misdirected Request\"\n        422 -> return \"Unprocessable Entity\"\n        423 -> return \"Locked\"\n        424 -> return \"Failed Dependency\"\n        425 -> return \"Too Early\"\n        426 -> return \"Upgrade Required\"\n        428 -> return \"Precondition Required\"\n        429 -> return \"Too Many Requests\"\n        431 -> return \"Request Header Fields Too Large\"\n        451 -> return \"Unavailable For Legal Reasons\"\n        500 -> return \"Internal Server Error\"\n        501 -> return \"Not Implemented\"\n        502 -> return \"Bad Gateway\"\n        503 -> return \"Service Unavailable\"\n        504 -> return \"Gateway Timeout\"\n        505 -> return \"HTTP Version Not Supported\"\n        506 -> return \"Variant Also Negotiates\"\n        507 -> return \"Insufficient Storage\"\n        508 -> return \"Loop Detected\"\n        510 -> return \"Not Extended\"\n        511 -> return \"Network Authentication Required\"\n        else -> {{ _ := 0 }}\n    }}\n    if code >= 500 -> return \"Error\"\n    if code >= 400 -> return \"Bad Request\"\n    if code >= 300 -> return \"Redirect\"\n    return \"OK\"\n}}\n\nfn ascii_upper(text: String) -> String Never! {{\n    out := [U8]{{}}\n    loop b in text.bytes() {{\n        n :: Int.from_u8(b)\n        if n >= 97 && n <= 122 -> &out.push(U8{{n - 32}}) else -> &out.push(b)\n    }}\n    String.from_bytes(out) ?? text\n}}\n\nfn ascii_lower(text: String) -> String Never! {{\n    out := [U8]{{}}\n    loop b in text.bytes() {{\n        n :: Int.from_u8(b)\n        if n >= 65 && n <= 90 -> &out.push(U8{{n + 32}}) else -> &out.push(b)\n    }}\n    String.from_bytes(out) ?? text\n}}\n\nfn trim(text: String) -> String Never! {{\n    raw :: text.bytes()\n    start := 0\n    end := raw.len()\n    loop start < end {{\n        n :: Int.from_u8(raw[start])\n        if n == 32 || n == 9 || n == 13 || n == 10 -> start = start + 1 else -> break\n    }}\n    loop end > start {{\n        n :: Int.from_u8(raw[end - 1])\n        if n == 32 || n == 9 || n == 13 || n == 10 -> end = end - 1 else -> break\n    }}\n    if end <= start -> return \"\"\n    String.from_bytes(slice_b(raw, start, end)) ?? \"\"\n}}\n\n\npub fn get(url: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {{\n    if !valid_url(url) -> return Err(.InvalidURL)\n    provider.get(url)\n}}\n\npub fn post(url: String, body: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {{\n    if !valid_url(url) -> return Err(.InvalidURL)\n    if body.bytes().len() > C_MAX_BODY_BYTES -> return Err(.BodyTooLarge{{limit: C_MAX_BODY_BYTES}})\n    provider.post(url, body)\n}}\n\npub fn put(url: String, body: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {{\n    if !valid_url(url) -> return Err(.InvalidURL)\n    if body.bytes().len() > C_MAX_BODY_BYTES -> return Err(.BodyTooLarge{{limit: C_MAX_BODY_BYTES}})\n    req := core.http.client.request(\"PUT\", url)\n    send_request(req.body(body))\n}}\n\npub fn patch(url: String, body: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {{\n    if !valid_url(url) -> return Err(.InvalidURL)\n    if body.bytes().len() > C_MAX_BODY_BYTES -> return Err(.BodyTooLarge{{limit: C_MAX_BODY_BYTES}})\n    req := core.http.client.request(\"PATCH\", url)\n    send_request(req.body(body))\n}}\n\npub fn delete(url: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {{\n    if !valid_url(url) -> return Err(.InvalidURL)\n    req := core.http.client.request(\"DELETE\", url)\n    send_request(req)\n}}\n\npub fn head(url: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {{\n    if !valid_url(url) -> return Err(.InvalidURL)\n    req := core.http.client.request(\"HEAD\", url)\n    send_request(req)\n}}\n\npub fn serve(addr: String, mux: HTTPMux) HTTPError! {{\n    core.http.server.serve(addr, mux) ?? return\n}}\n\n\npub fn exchange(method: String, url: String, body: String, header_lines: [String]) -[Net, Time.Wait]> HTTPResponse HTTPError! {{\n    if !valid_method_token(method) -> return Err(.InvalidMethod)\n    if !valid_url(url) -> return Err(.InvalidURL)\n    if body.bytes().len() > C_MAX_BODY_BYTES -> return Err(.BodyTooLarge{{limit: C_MAX_BODY_BYTES}})\n    if !headers_lines_bounded(header_lines) || !headers_lines_valid(header_lines) -> return Err(.InvalidHeader)\n    parsed :: headers_parse(header_lines)\n    send_request(request_with(method_parse(method), url, parsed, body_text(body)))\n}}\n\npub fn send_request(req: HTTPRequest) -[Net, Time.Wait]> HTTPResponse HTTPError! {{\n    provider.send(req)\n}}\n\npub fn parse_response(url: String, raw: [U8]) -> HTTPResponse HTTPError! {{\n    split := find_double_crlf(raw)\n    if split < 0 -> return Err(.InvalidFraming)\n    if !strict_crlf(raw, split) -> return Err(.InvalidFraming)\n    head_end :: header_text_end(raw, split)\n    if head_end > C_MAX_HEADER_BYTES -> return Err(.InvalidHeader)\n    head :: String.from_bytes(slice_b(raw, 0, head_end)) ?? return Err(.Protocol{{version: \"HTTP\"}})\n    body_raw :: slice_b(raw, split, raw.len())\n    if body_raw.len() > C_MAX_BODY_BYTES -> return Err(.BodyTooLarge{{limit: C_MAX_BODY_BYTES}})\n    lines :: split_lines(head)\n    if lines.len() == 0 || lines[0].bytes().len() > C_MAX_REQUEST_LINE_BYTES -> return Err(.InvalidStatus)\n    parsed :: parse_status_line(lines[0]) ?? return Err(.InvalidStatus)\n    hdr_lines := [String]{{}}\n    loop i in 1..<lines.len() {{\n        if lines[i].bytes().len() > 0 -> &hdr_lines.push(lines[i])\n    }}\n    if !headers_lines_bounded(hdr_lines) || !headers_lines_valid(hdr_lines) -> return Err(.InvalidHeader)\n    h := headers_parse(hdr_lines)\n    if has_ambiguous_framing(h) -> return Err(.InvalidFraming)\n    if has_unsupported_encoding(h) -> return Err(.UnsupportedEncoding)\n    if response_forbids_content_length(parsed.status.code) && has_header(h, \"content-length\") -> return Err(.InvalidFraming)\n    expected :: content_length(h)\n    if parsed.status.code != 304 && (expected > C_MAX_BODY_BYTES || (expected >= 0 && expected != body_raw.len())) -> return Err(.InvalidFraming)\n    if response_forbids_body(parsed.status.code) && body_raw.len() > 0 -> return Err(.InvalidFraming)\n    body_text :: String.from_bytes(body_raw) ?? return Err(.UnsupportedEncoding)\n    response := core.http.server.response(parsed.status.code, body_text)\n    loop line in hdr_lines {{\n        col := index_byte(line.bytes(), 58)\n        name :: String.from_bytes(slice_b(line.bytes(), 0, col)) ?? return Err(.InvalidHeader)\n        value :: String.from_bytes(slice_b(line.bytes(), col + 1, line.bytes().len())) ?? return Err(.InvalidHeader)\n        response = &response.header(name, trim(value))\n    }}\n    Ok(response)\n}}\n\npub fn parse_request(raw: [U8]) -> HTTPRequest HTTPError! {{\n    split := find_double_crlf(raw)\n    if split < 0 -> return Err(.InvalidFraming)\n    if !strict_crlf(raw, split) -> return Err(.InvalidFraming)\n    head_end :: header_text_end(raw, split)\n    if head_end > C_MAX_HEADER_BYTES -> return Err(.InvalidHeader)\n    head :: String.from_bytes(slice_b(raw, 0, head_end)) ?? return Err(.Protocol{{version: \"HTTP\"}})\n    body_raw :: slice_b(raw, split, raw.len())\n    if body_raw.len() > C_MAX_BODY_BYTES -> return Err(.BodyTooLarge{{limit: C_MAX_BODY_BYTES}})\n    lines :: split_lines(head)\n    if lines.len() == 0 || lines[0].bytes().len() > C_MAX_REQUEST_LINE_BYTES -> return Err(.InvalidMethod)\n    parts :: split_space_line(lines[0])\n    if parts.len() != 3 -> return Err(.InvalidMethod)\n    if !valid_method(parts[0]) -> return Err(.InvalidMethod)\n    if parts[0] == \"CONNECT\" {{\n        if !valid_connect_target(parts[1]) -> return Err(.InvalidURL)\n    }} else {{\n        if !valid_target(parts[1]) -> return Err(.InvalidURL)\n        if parts[1] == \"*\" && parts[0] != \"OPTIONS\" -> return Err(.InvalidURL)\n    }}\n    parsed_version :: version_parse(parts[2])\n    if version_text(parsed_version) != parts[2] -> return Err(.Protocol{{version: parts[2]}})\n    if parsed_version == Version.HTTP2 || parsed_version == Version.HTTP3 -> return Err(.Protocol{{version: parts[2]}})\n    hlines := [String]{{}}\n    loop i in 1..<lines.len() {{\n        if lines[i].bytes().len() > 0 -> &hlines.push(lines[i])\n    }}\n    if !headers_lines_bounded(hlines) || !headers_lines_valid(hlines) -> return Err(.InvalidHeader)\n    h := headers_parse(hlines)\n    hosts := headers_all(h, \"host\")\n    if parsed_version == Version.HTTP11 {{\n        if hosts.len() != 1 || !valid_host_value(hosts[0]) -> return Err(.InvalidHeader)\n    }} else {{\n        loop host in hosts {{\n            if !valid_host_value(host) -> return Err(.InvalidHeader)\n        }}\n    }}\n    if has_ambiguous_framing(h) -> return Err(.InvalidFraming)\n    if has_unsupported_encoding(h) -> return Err(.UnsupportedEncoding)\n    expected :: content_length(h)\n    if expected > C_MAX_BODY_BYTES || (expected >= 0 && expected != body_raw.len()) || (expected < 0 && body_raw.len() > 0) -> return Err(.InvalidFraming)\n    req := core.http.client.request(method_text(method_parse(parts[0])), parts[1])\n    loop line in hlines {{\n        col := index_byte(line.bytes(), 58)\n        name :: String.from_bytes(slice_b(line.bytes(), 0, col)) ?? return Err(.InvalidHeader)\n        value :: String.from_bytes(slice_b(line.bytes(), col + 1, line.bytes().len())) ?? return Err(.InvalidHeader)\n        req = &req.header(name, trim(value))\n    }}\n    if body_raw.len() > 0 {{\n        body_text :: String.from_bytes(body_raw) ?? return Err(.UnsupportedEncoding)\n        req = req.body(body_text)\n    }}\n    Ok(req)\n}}\n\npub struct StatusLine {{\n    pub version: Version\n    pub status: Status\n}}\n\nfn parse_status_line(line: String) -> StatusLine? {{\n    if has_line_ctl(line.bytes()) -> return None\n    parts :: split_space_line(line)\n    if parts.len() < 2 -> return None\n    parsed_version :: version_parse(parts[0])\n    if version_text(parsed_version) != parts[0] -> return None\n    if parsed_version == Version.HTTP2 || parsed_version == Version.HTTP3 -> return None\n    if parts[1].bytes().len() != 3 -> return None\n    code :: parse_decimal(parts[1]) ?? return None\n    if code < 100 || code > 599 -> return None\n    reason := reason_phrase(code)\n    if parts.len() > 2 {{\n        reason = parts[2]\n        i := 3\n        loop i < parts.len() {{\n            reason = \"{{reason}} {{parts[i]}}\"\n            i = i + 1\n        }}\n    }}\n    Val(StatusLine{{version: parsed_version, status: Status{{code: code, reason: reason}}}})\n}}\n\nfn split_space_line(text: String) -> [String] Never! {{\n    raw :: text.bytes()\n    out := [String]{{}}\n    if raw.len() == 0 -> return out\n    start := 0\n    i := 0\n    loop i < raw.len() {{\n        n :: Int.from_u8(raw[i])\n        if n == 32 {{\n            if i == start -> return [String]{{}}\n            &out.push(String.from_bytes(slice_b(raw, start, i)) ?? \"\")\n            start = i + 1\n        }} else if n < 32 || n == 127 {{\n            return [String]{{}}\n        }}\n        i = i + 1\n    }}\n    if start == raw.len() -> return [String]{{}}\n    &out.push(String.from_bytes(slice_b(raw, start, raw.len())) ?? \"\")\n    out\n}}\n\nfn find_double_crlf(raw: [U8]) -> Int Never! {{\n    if raw.len() < 4 -> return -1\n    i := 0\n    loop i + 3 < raw.len() {{\n        if raw[i] == (U8{{13}}) && raw[i + 1] == (U8{{10}}) && raw[i + 2] == (U8{{13}}) && raw[i + 3] == (U8{{10}}) -> return i + 4\n        i = i + 1\n    }}\n    -1\n}}\n\n\nfn header_text_end(raw: [U8], split: Int) -> Int Never! {{\n    if split >= 4 && raw[split - 4] == (U8{{13}}) -> return split - 4\n    split - 2\n}}\nfn strict_crlf(raw: [U8], end: Int) -> Bool Never! {{\n    i := 0\n    loop i < end {{\n        if raw[i] == (U8{{13}}) {{\n            if i + 1 >= end || raw[i + 1] != (U8{{10}}) -> return false\n        }} else if raw[i] == (U8{{10}}) {{\n            if i == 0 || raw[i - 1] != (U8{{13}}) -> return false\n        }}\n        i = i + 1\n    }}\n    true\n}}\n\nfn split_lines(text: String) -> [String] Never! {{\n    raw :: text.bytes()\n    out := [String]{{}}\n    start := 0\n    i := 0\n    loop i < raw.len() {{\n        if raw[i] == (U8{{10}}) {{\n            end := i\n            if end > start && raw[end - 1] == (U8{{13}}) -> end = end - 1\n            &out.push(String.from_bytes(slice_b(raw, start, end)) ?? \"\")\n            start = i + 1\n        }}\n        i = i + 1\n    }}\n    if start < raw.len() -> &out.push(String.from_bytes(slice_b(raw, start, raw.len())) ?? \"\")\n    out\n}}\n\n\npub struct Cookie {{\n    pub name: String\n    pub value: String\n    pub domain: String\n    pub path: String\n    pub secure: Bool\n    pub http_only: Bool\n    pub same_site: String\n    pub max_age: Int\n}}\n\npub struct Query {{\n    pub pairs: [QueryPair]\n}}\n\npub struct QueryPair {{\n    pub key: String\n    pub value: String\n}}\n\npub fn query() -> Query Never! {{ Query{{pairs: [QueryPair]{{}}}} }}\n\npub fn query_get(q: Query, key: String) -> String? Never! {{\n    loop p in q.pairs {{\n        if p.key == key -> return Val(p.value)\n    }}\n    None\n}}\n\npub fn query_all(q: Query, key: String) -> [String] Never! {{\n    out := [String]{{}}\n    loop p in q.pairs {{\n        if p.key == key -> &out.push(p.value)\n    }}\n    out\n}}\n\npub fn query_set(q: Query, key: String, value: String) -> Query Never! {{\n    pairs := [QueryPair]{{}}\n    replaced := false\n    loop p in q.pairs {{\n        if p.key == key {{\n            if !replaced {{\n                &pairs.push(QueryPair{{key: key, value: value}})\n                replaced = true\n            }}\n        }} else {{\n            &pairs.push(p)\n        }}\n    }}\n    if !replaced {{\n        &pairs.push(QueryPair{{key: key, value: value}})\n    }}\n    Query{{pairs: pairs}}\n}}\n\npub fn query_encode(q: Query) -> String Never! {{\n    s := \"\"\n    first := true\n    loop p in q.pairs {{\n        piece :: \"{{percent_encode(p.key)}}={{percent_encode(p.value)}}\"\n        piece_len := piece.bytes().len()\n        if piece_len > C_MAX_BODY_BYTES -> return \"\"\n        if first {{\n            s = piece\n            first = false\n        }} else {{\n            if s.bytes().len() + piece_len + 1 > C_MAX_BODY_BYTES -> return \"\"\n            s = \"{{s}}&{{piece}}\"\n        }}\n    }}\n    s\n}}\n\npub fn query_decode(text: String) -> Query Never! {{\n    q := query()\n    raw :: text.bytes()\n    if raw.len() == 0 || raw.len() > C_MAX_BODY_BYTES -> return q\n    start := 0\n    if raw[0] == (U8{{63}}) -> start = 1\n    i := start\n    loop i <= raw.len() {{\n        if i == raw.len() || raw[i] == (U8{{38}}) {{\n            if i > start {{\n                eq := -1\n                j := start\n                loop j < i {{\n                    if raw[j] == (U8{{61}}) {{\n                        eq = j\n                        break\n                    }}\n                    j = j + 1\n                }}\n                key_end := if eq >= 0 -> eq else -> i\n                value_start := if eq >= 0 -> eq + 1 else -> i\n                key :: String.from_bytes(slice_b(raw, start, key_end)) ?? \"\"\n                value :: String.from_bytes(slice_b(raw, value_start, i)) ?? \"\"\n                pairs := ~q.pairs\n                &pairs.push(QueryPair{{key: percent_decode(key), value: percent_decode(value)}})\n                q = Query{{pairs: pairs}}\n            }}\n            start = i + 1\n        }}\n        i = i + 1\n    }}\n    q\n}}\n\npub fn form_encode(q: Query) -> String Never! {{ query_encode(q) }}\npub fn form_decode(text: String) -> Query Never! {{ query_decode(text) }}\n\npub fn cookie(name: String, value: String) -> Cookie Never! {{\n    Cookie{{name: name, value: value, domain: \"\", path: \"/\", secure: false, http_only: false, same_site: \"Lax\", max_age: -1}}\n}}\n\npub fn cookie_encode(c: Cookie) -> String Never! {{\n    if !valid_cookie_token(c.name) || !valid_cookie_value(c.value) -> return \"\"\n    s := \"{{c.name}}={{c.value}}\"\n    if c.domain.bytes().len() > 0 {{\n        if !valid_cookie_attribute(c.domain) -> return \"\"\n        s = \"{{s}}; Domain={{c.domain}}\"\n    }}\n    if c.path.bytes().len() > 0 {{\n        if !valid_cookie_attribute(c.path) -> return \"\"\n        s = \"{{s}}; Path={{c.path}}\"\n    }}\n    if c.max_age >= 0 -> s = \"{{s}}; Max-Age={{c.max_age}}\"\n    if c.http_only -> s = \"{{s}}; HttpOnly\"\n    if c.secure -> s = \"{{s}}; Secure\"\n    if c.same_site == \"Strict\" || c.same_site == \"Lax\" || c.same_site == \"None\" -> s = \"{{s}}; SameSite={{c.same_site}}\"\n    if s.bytes().len() > C_MAX_HEADER_LINE_BYTES -> return \"\"\n    s\n}}\n\npub fn cookies_parse(header: String) -> [Cookie] Never! {{\n    out := [Cookie]{{}}\n    raw :: header.bytes()\n    if raw.len() > C_MAX_HEADER_LINE_BYTES -> return out\n    start := 0\n    i := 0\n    first := true\n    loop i <= raw.len() {{\n        if i == raw.len() || raw[i] == (U8{{59}}) {{\n            piece :: trim(String.from_bytes(slice_b(raw, start, i)) ?? \"\")\n            eq := index_byte_str(piece, 61)\n            if eq > 0 {{\n                n :: trim(slice_str(piece, 0, eq))\n                v :: trim(slice_str(piece, eq + 1, piece.bytes().len()))\n                lower :: ascii_lower(n)\n                if first || (lower != \"domain\" && lower != \"path\" && lower != \"max-age\" && lower != \"expires\" && lower != \"secure\" && lower != \"httponly\" && lower != \"samesite\") {{\n                    if valid_cookie_token(n) && valid_cookie_value(v) -> &out.push(cookie(n, v))\n                }}\n            }}\n            first = false\n            start = i + 1\n        }}\n        i = i + 1\n    }}\n    out\n}}\n\npub fn basic_auth(user: String, password: String) -> String Never! {{\n    credentials := \"{{user}}:{{password}}\"\n    \"Basic {{base64_encode(credentials.bytes())}}\"\n}}\n\npub fn bearer_auth(token: String) -> String Never! {{ \"Bearer {{token}}\" }}\npub fn with_header(req: HTTPRequest, name: String, value: String) -> HTTPRequest Never! {{\n    if !valid_header_name(name) || has_ctl(value.bytes()) -> return ~req\n    &req.header(name, value)\n}}\n\npub fn with_body(req: HTTPRequest, body: Body) -> HTTPRequest Never! {{\n    req.body(body_as_text(body))\n}}\n\npub fn with_query(url: String, q: Query) -> String Never! {{\n    enc :: query_encode(q)\n    if enc.bytes().len() == 0 -> return ~url\n    frag :: split_fragment(url)\n    base :: frag.url\n    sep := if index_byte_str(base, 63) >= 0 -> \"&\" else -> \"?\"\n    suffix := \"\"\n    if frag.fragment.bytes().len() > 0 -> suffix = \"#{{frag.fragment}}\"\n    \"{{base}}{{sep}}{{enc}}{{suffix}}\"\n}}\n\npub fn status_class(s: Status) -> String Never! {{\n    if is_informational(s) -> return \"informational\"\n    if is_success(s) -> return \"success\"\n    if is_redirect(s) -> return \"redirect\"\n    if is_client_error(s) -> return \"client_error\"\n    if is_server_error(s) -> return \"server_error\"\n    \"unknown\"\n}}\n\npub fn request_with(method: Method, url: String, h: Headers, body: Body) -> HTTPRequest Never! {{\n    req := core.http.client.request(method_text(method), url)\n    loop f in h.fields -> req = &req.header(f.name, f.value)\n    with_body(req, body)\n}}\n\npub fn response_ok(body: Body) -> HTTPResponse Never! {{\n    core.http.server.response(200, body_as_text(body))\n}}\n\npub fn response_json_headers() -> Headers Never! {{ headers_set(headers(), \"content-type\", \"application/json; charset=utf-8\") }}\npub fn response_text_headers() -> Headers Never! {{ headers_set(headers(), \"content-type\", \"text/plain; charset=utf-8\") }}\npub fn has_header(h: Headers, name: String) -> Bool Never! {{ headers_get(h, name) != None }}\n\npub fn content_length(h: Headers) -> Int Never! {{\n    values :: headers_all(h, \"content-length\")\n    if values.len() == 0 -> return -1\n    first := -1\n    loop value in values {{\n        n :: parse_content_length_value(value) ?? return -1\n        if first >= 0 && n != first -> return -1\n        first = n\n    }}\n    first\n}}\n\nfn valid_url(url: String) -> Bool Never! {{\n    raw :: url.bytes()\n    if raw.len() < 8 || raw.len() > C_MAX_URL_BYTES || has_url_ctl(raw) -> return false\n    parsed :: http_url.parse(url) ?? return false\n    if parsed.scheme != \"http\" && parsed.scheme != \"https\" -> return false\n    if parsed.host.bytes().len() == 0 || parsed.userinfo().bytes().len() > 0 -> return false\n    colon := index_byte(raw, 58)\n    if colon <= 0 || colon + 2 >= raw.len() -> return false\n    if raw[colon + 1] != (U8{{47}}) || raw[colon + 2] != (U8{{47}}) -> return false\n    start := colon + 3\n    end := start\n    loop end < raw.len() {{\n        if raw[end] == (U8{{47}}) || raw[end] == (U8{{63}}) || raw[end] == (U8{{35}}) -> break\n        n :: Int.from_u8(raw[end])\n        if n <= 32 || n >= 127 || n == 34 || n == 92 -> return false\n        end = end + 1\n    }}\n    end > start\n}}\n\nfn parse_content_length_value(text: String) -> Int? {{\n    raw :: text.bytes()\n    if raw.len() == 0 -> return None\n    first := -1\n    start := 0\n    i := 0\n    loop i <= raw.len() {{\n        if i == raw.len() || raw[i] == (U8{{44}}) {{\n            token :: trim(String.from_bytes(slice_b(raw, start, i)) ?? \"\")\n            n :: parse_decimal(token) ?? return None\n            if first >= 0 && first != n -> return None\n            first = n\n            start = i + 1\n        }}\n        i = i + 1\n    }}\n    if first < 0 -> return None\n    Val(first)\n}}\n\nfn has_url_ctl(bytes: [U8]) -> Bool Never! {{\n    loop b in bytes {{\n        n :: Int.from_u8(b)\n        if n < 32 || n == 127 -> return true\n    }}\n    false\n}}\n\nfn has_line_ctl(bytes: [U8]) -> Bool Never! {{\n    loop b in bytes {{\n        n :: Int.from_u8(b)\n        if n < 32 || n == 127 -> return true\n    }}\n    false\n}}\n\nfn response_forbids_body(code: Int) -> Bool Never! {{\n    (code >= 100 && code < 200) || code == 204 || code == 205 || code == 304\n}}\nfn response_forbids_content_length(code: Int) -> Bool Never! {{\n    (code >= 100 && code < 200) || code == 204\n}}\n\nfn valid_method_token(method: String) -> Bool Never! {{ valid_method(method) }}\n\nfn valid_method(method: String) -> Bool Never! {{\n    raw :: method.bytes()\n    if raw.len() == 0 -> return false\n    loop b in raw {{\n        if !token_char(Int.from_u8(b)) -> return false\n    }}\n    true\n}}\n\nfn valid_target(target: String) -> Bool Never! {{\n    raw :: target.bytes()\n    if raw.len() == 0 -> return false\n    if target != \"*\" && raw[0] != (U8{{47}}) -> return false\n    loop b in raw {{\n        n :: Int.from_u8(b)\n        if n <= 32 || n == 127 || n == 35 -> return false\n    }}\n    true\n}}\n\nfn valid_connect_target(target: String) -> Bool Never! {{\n    raw :: target.bytes()\n    if raw.len() == 0 || has_url_ctl(raw) || index_byte(raw, 58) <= 0 -> return false\n    loop b in raw {{\n        n :: Int.from_u8(b)\n        if n >= 127 || n == 34 || n == 92 -> return false\n    }}\n    parsed :: http_url.parse(\"http://{{target}}\") ?? return false\n    parsed.host.bytes().len() > 0 && parsed.userinfo().bytes().len() == 0 && parsed.path == \"/\" && parsed.query.bytes().len() == 0 && parsed.fragment.bytes().len() == 0\n}}\n\nfn valid_host_value(value: String) -> Bool Never! {{\n    raw :: trim(value)\n    if raw.bytes().len() == 0 || has_url_ctl(raw.bytes()) -> return false\n    loop b in raw.bytes() {{\n        n :: Int.from_u8(b)\n        if n >= 127 || n == 34 || n == 92 -> return false\n    }}\n    parsed :: http_url.parse(\"http://{{raw}}\") ?? return false\n    parsed.host.bytes().len() > 0 && parsed.userinfo().bytes().len() == 0 && parsed.path == \"/\" && parsed.query.bytes().len() == 0 && parsed.fragment.bytes().len() == 0\n}}\nfn token_char(n: Int) -> Bool Never! {{\n    (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || (n >= 48 && n <= 57) || n == 33 || n == 35 || n == 36 || n == 37 || n == 38 || n == 39 || n == 42 || n == 43 || n == 45 || n == 46 || n == 94 || n == 95 || n == 96 || n == 124 || n == 126\n}}\n\nfn has_ambiguous_framing(h: Headers) -> Bool Never! {{\n    first := -1\n    loop value in headers_all(h, \"content-length\") {{\n        n :: parse_content_length_value(value) ?? return true\n        if first >= 0 && n != first -> return true\n        first = n\n    }}\n    has_header(h, \"content-length\") && has_header(h, \"transfer-encoding\")\n}}\n\nfn has_unsupported_encoding(h: Headers) -> Bool Never! {{\n    if has_header(h, \"transfer-encoding\") -> return true\n    loop value in headers_all(h, \"content-encoding\") {{\n        encoding := ascii_lower(trim(value))\n        if encoding != \"identity\" -> return true\n    }}\n    false\n}}\n\n\n\n\nfn valid_header_line(line: String) -> Bool Never! {{\n    raw :: line.bytes()\n    col := index_byte(raw, 58)\n    if col <= 0 -> return false\n    name :: String.from_bytes(slice_b(raw, 0, col)) ?? return false\n    value :: slice_b(raw, col + 1, raw.len())\n    valid_header_name(name) && !has_ctl(value)\n}}\n\nfn headers_lines_bounded(lines: [String]) -> Bool Never! {{\n    if lines.len() > C_MAX_HEADER_COUNT -> return false\n    total := 0\n    loop line in lines {{\n        n := line.bytes().len()\n        if n + 2 > C_MAX_HEADER_BYTES || n > C_MAX_HEADER_LINE_BYTES -> return false\n        total = total + n + 2\n        if total > C_MAX_HEADER_BYTES -> return false\n    }}\n    true\n}}\n\nfn headers_lines_valid(lines: [String]) -> Bool Never! {{\n    if !headers_lines_bounded(lines) -> return false\n    loop line in lines {{\n        if !valid_header_line(line) -> return false\n    }}\n    true\n}}\n\nfn valid_header_name(name: String) -> Bool Never! {{\n    raw :: name.bytes()\n    if raw.len() == 0 -> return false\n    loop b in raw {{\n        if !token_char(Int.from_u8(b)) -> return false\n    }}\n    true\n}}\nfn has_ctl(bytes: [U8]) -> Bool Never! {{\n    loop b in bytes {{\n        n :: Int.from_u8(b)\n        if n < 32 && n != 9 -> return true\n        if n == 127 -> return true\n    }}\n    false\n}}\n\nfn valid_cookie_token(name: String) -> Bool {{\n    raw :: name.bytes()\n    if raw.len() == 0 -> return false\n    loop b in raw {{\n        n :: Int.from_u8(b)\n        if n <= 32 || n >= 127 || n == 34 || n == 40 || n == 41 || n == 44 || n == 47 || n == 58 || n == 59 || n == 60 || n == 61 || n == 62 || n == 63 || n == 64 || n == 91 || n == 92 || n == 93 || n == 123 || n == 125 -> return false\n    }}\n    true\n}}\n\nfn valid_cookie_value(value: String) -> Bool {{\n    loop b in value.bytes() {{\n        n :: Int.from_u8(b)\n        if n <= 32 || n >= 127 || n == 34 || n == 44 || n == 59 || n == 92 -> return false\n    }}\n    true\n}}\n\nfn valid_cookie_attribute(value: String) -> Bool {{\n    loop b in value.bytes() {{\n        n :: Int.from_u8(b)\n        if n <= 32 || n >= 127 || n == 59 -> return false\n    }}\n    true\n}}\n\nfn parse_decimal(text: String) -> Int? {{\n    raw :: text.bytes()\n    if raw.len() == 0 || raw.len() > 10 -> return None\n    n := 0\n    loop b in raw {{\n        d :: Int.from_u8(b)\n        if d < 48 || d > 57 -> return None\n        n = n * 10 + d - 48\n    }}\n    Val(n)\n}}\n\nfn percent_encode(text: String) -> String {{\n    out := [U8]{{}}\n    loop b in text.bytes() {{\n        n :: Int.from_u8(b)\n        unreserved := (n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || n == 45 || n == 46 || n == 95 || n == 126\n        if unreserved -> &out.push(b)\n        else if n == 32 -> &out.push(U8{{43}})\n        else {{\n            &out.push(U8{{37}})\n            &out.push(hex_digit(n /% 16))\n            &out.push(hex_digit(n %% 16))\n        }}\n    }}\n    String.from_bytes(out) ?? text\n}}\n\nfn percent_decode(text: String) -> String {{\n    raw :: text.bytes()\n    out := [U8]{{}}\n    i := 0\n    loop i < raw.len() {{\n        if raw[i] == (U8{{43}}) {{\n            &out.push(U8{{32}})\n            i = i + 1\n            next\n        }}\n        if raw[i] == (U8{{37}}) && i + 2 < raw.len() {{\n            hi :: from_hex(raw[i + 1])\n            lo :: from_hex(raw[i + 2])\n            if hi >= 0 && lo >= 0 {{\n                &out.push(U8{{hi * 16 + lo}})\n                i = i + 3\n                next\n            }}\n        }}\n        &out.push(raw[i])\n        i = i + 1\n    }}\n    String.from_bytes(out) ?? text\n}}\nfn base64_encode(bytes: [U8]) -> String Never! {{\n    alphabet :: \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\".bytes()\n    out := [U8]{{}}\n    i := 0\n    loop i < bytes.len() {{\n        a :: Int.from_u8(bytes[i])\n        b := 0\n        c := 0\n        have_b := i + 1 < bytes.len()\n        have_c := i + 2 < bytes.len()\n        if have_b -> b = Int.from_u8(bytes[i + 1])\n        if have_c -> c = Int.from_u8(bytes[i + 2])\n        block :: (a * 65536) + (b * 256) + c\n        &out.push(alphabet[(block /% 262144) %% 64])\n        &out.push(alphabet[(block /% 4096) %% 64])\n        if have_b -> &out.push(alphabet[(block /% 64) %% 64]) else -> &out.push(U8{{61}})\n        if have_c -> &out.push(alphabet[block %% 64]) else -> &out.push(U8{{61}})\n        i = i + 3\n    }}\n    String.from_bytes(out) ?? \"\"\n}}\n\nfn hex_digit(n: Int) -> U8 {{\n    if n < 10 -> return U8{{48 + n}}\n    U8{{65 + n - 10}}\n}}\n\nfn from_hex(b: U8) -> Int {{\n    n :: Int.from_u8(b)\n    if n >= 48 && n <= 57 -> return n - 48\n    if n >= 65 && n <= 70 -> return n - 55\n    if n >= 97 && n <= 102 -> return n - 87\n    return -1\n}}\n\nfn index_byte(text: [U8], code: Int) -> Int Never! {{\n    loop i in 0..<text.len() {{\n        if Int.from_u8(text[i]) == code -> return i\n    }}\n    -1\n}}\n\nfn index_byte_str(text: String, code: Int) -> Int {{ index_byte(text.bytes(), code) }}\n\nfn last_index(raw: [U8], code: Int) -> Int {{\n    i := raw.len() - 1\n    loop i >= 0 {{\n        if Int.from_u8(raw[i]) == code -> return i\n        i = i - 1\n    }}\n    -1\n}}\n\nfn starts(text: String, prefix: String) -> Bool {{\n    a :: text.bytes()\n    b :: prefix.bytes()\n    if b.len() > a.len() -> return false\n    loop i in 0..<b.len() {{\n        if a[i] != b[i] -> return false\n    }}\n    true\n}}\n\nstruct FragmentSplit {{\n    url: String\n    fragment: String\n}}\n\nfn split_fragment(text: String) -> FragmentSplit {{\n    at := index_byte_str(text, 35)\n    if at < 0 -> return FragmentSplit{{url: text, fragment: \"\"}}\n    FragmentSplit{{url: slice_str(text, 0, at), fragment: slice_str(text, at + 1, text.bytes().len())}}\n}}\n\nfn contains_byte(text: String, code: Int) -> Bool {{ index_byte(text.bytes(), code) >= 0 }}\n\nfn slice_str(text: String, start: Int, end: Int) -> String {{\n    String.from_bytes(slice_b(text.bytes(), start, end)) ?? \"\"\n}}\n\nfn slice_b(raw: [U8], start: Int, end: Int) -> [U8] Never! {{\n    out := [U8]{{}}\n    i := start\n    loop {{\n        if i >= end || i >= raw.len() -> return ~out\n        &out.push(raw[i])\n        i = i + 1\n    }}\n}}\n\n"}
}

fn foundation_embedded_core_source_50() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.http.client", alias: "core_core_http_client", path: "Core/http/client.jet", owner: "", owned_members: [String]{"accept", "bearer", "content_type", "cookie_header", "header", "redirect_limit", "session", "session_auth", "session_cookie", "session_delete", "session_form", "session_get", "session_head", "session_header", "session_json", "session_patch", "session_post", "session_proxy", "session_put", "session_redirects", "session_request", "session_retries", "session_timeout", "set_header", "timeout_redirects", "user_agent", "with_proxy", "get", "post", "request", "send"}, source: "// core.http.client — configured HTTP client.\n//\n// The canonical request/response carriers and transport builders come from\n// core.http.client. This source module owns deterministic configuration and\n// session policy around those provider leaves.\n\nuse core as core\nuse core.http as http\nuse core.http.[HTTPError, HTTPRequest, HTTPResponse]\nuse core.http.client as provider\nuse core.net.url as http_url\nC_MAX_BODY_BYTES :: 1048576\nC_MAX_URL_BYTES :: 8192\nC_MAX_REDIRECTS :: 10\nC_MAX_RETRIES :: 1\n\npub struct Client {{\n    pub method: String\n    pub url: String\n    pub headers: [String]\n    pub redirects: Int\n    pub proxy: String\n}}\n\npub struct Proxy {{ pub url: String }}\npub enum RedirectPolicy {{\n    Disabled\n    Limited\n    All\n}}\n\npub struct Session {{\n    pub headers: [String]\n    pub cookies: [String]\n    pub timeout_ms: Int\n    pub retries: Int\n    pub redirects: Int\n    pub user: String\n    pub password: String\n    pub proxy: String\n}}\npub fn get(url: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {{\n    core.http.client.get(url)\n}}\n\npub fn post(url: String, body: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {{\n    core.http.client.post(url, body)\n}}\n\npub fn request(method: String, url: String) -> HTTPRequest Never! {{\n    core.http.client.request(method, url)\n}}\n\npub fn send(req: HTTPRequest) -[Net, Time.Wait]> HTTPResponse HTTPError! {{\n    req.send()\n}}\n\npub fn header(client: Client, line: String) -> Client Never! {{\n    _ :: header_name(line) ?? return ~client\n    _ :: header_value(line) ?? return ~client\n    Client{{\n        method: ~client.method,\n        url: ~client.url,\n        headers: append_header(~client.headers, line),\n        redirects: client.redirects,\n        proxy: ~client.proxy,\n    }}\n}}\n\npub fn set_header(client: Client, name: String, value: String) -> Client Never! {{\n    Client{{\n        method: ~client.method,\n        url: ~client.url,\n        headers: set_header_line(~client.headers, name, value),\n        redirects: client.redirects,\n        proxy: ~client.proxy,\n    }}\n}}\npub fn with_proxy(client: Client, proxy: Proxy) -> Client Never! {{\n    Client{{method: ~client.method, url: ~client.url, headers: ~client.headers, redirects: client.redirects, proxy: ~proxy.url}}\n}}\n\n\npub fn timeout_redirects(client: Client, n: Int) -> Client Never! {{\n    limit := n\n    if limit < 0 -> limit = 0\n    if limit > C_MAX_REDIRECTS -> limit = C_MAX_REDIRECTS\n    Client{{method: ~client.method, url: ~client.url, headers: ~client.headers, redirects: limit, proxy: ~client.proxy}}\n}}\n\npub fn session() -> Session Never! {{\n    Session{{\n        headers: [String]{{}},\n        cookies: [String]{{}},\n        timeout_ms: 30000,\n        retries: 0,\n        redirects: C_MAX_REDIRECTS,\n        user: \"\",\n        password: \"\",\n        proxy: \"\",\n    }}\n}}\n\npub fn session_header(s: Session, name: String, value: String) -> Session Never! {{\n    Session{{\n        headers: set_header_line(~s.headers, name, value),\n        cookies: ~s.cookies,\n        timeout_ms: s.timeout_ms,\n        retries: s.retries,\n        redirects: s.redirects,\n        user: ~s.user,\n        password: ~s.password,\n        proxy: ~s.proxy,\n    }}\n}}\n\npub fn session_timeout(s: Session, ms: Int) -> Session Never! {{\n    t := ms\n    if t < 0 -> t = 0\n    Session{{headers: ~s.headers, cookies: ~s.cookies, timeout_ms: t, retries: s.retries, redirects: s.redirects, user: ~s.user, password: ~s.password, proxy: ~s.proxy}}\n}}\n\npub fn session_retries(s: Session, n: Int) -> Session Never! {{\n    r := n\n    if r < 0 -> r = 0\n    if r > C_MAX_RETRIES -> r = C_MAX_RETRIES\n    Session{{headers: ~s.headers, cookies: ~s.cookies, timeout_ms: s.timeout_ms, retries: r, redirects: s.redirects, user: ~s.user, password: ~s.password, proxy: ~s.proxy}}\n}}\n\npub fn session_redirects(s: Session, n: Int) -> Session Never! {{\n    r := n\n    if r < 0 -> r = 0\n    if r > C_MAX_REDIRECTS -> r = C_MAX_REDIRECTS\n    Session{{headers: ~s.headers, cookies: ~s.cookies, timeout_ms: s.timeout_ms, retries: s.retries, redirects: r, user: ~s.user, password: ~s.password, proxy: ~s.proxy}}\n}}\n\npub fn session_auth(s: Session, user: String, password: String) -> Session Never! {{\n    Session{{headers: ~s.headers, cookies: ~s.cookies, timeout_ms: s.timeout_ms, retries: s.retries, redirects: s.redirects, user: user, password: password, proxy: ~s.proxy}}\n}}\n\npub fn session_proxy(s: Session, url: String) -> Session Never! {{\n    Session{{headers: ~s.headers, cookies: ~s.cookies, timeout_ms: s.timeout_ms, retries: s.retries, redirects: s.redirects, user: ~s.user, password: ~s.password, proxy: url}}\n}}\n\npub fn session_cookie(s: Session, cookie: String) -> Session Never! {{\n    if !valid_cookie_pair(cookie) -> return ~s\n    cookies := [String]{{}}\n    name :: cookie_name(cookie) ?? return ~s\n    replaced := false\n    loop c in s.cookies {{\n        current :: cookie_name(c) ?? next\n        if current == name {{\n            &cookies.push(~cookie)\n            replaced = true\n        }} else {{\n            &cookies.push(c)\n        }}\n    }}\n    if !replaced -> &cookies.push(cookie)\n    Session{{headers: ~s.headers, cookies: cookies, timeout_ms: s.timeout_ms, retries: s.retries, redirects: s.redirects, user: ~s.user, password: ~s.password, proxy: ~s.proxy}}\n}}\n\npub fn cookie_header(cookies: [String]) -> String Never! {{\n    s := \"\"\n    first := true\n    loop c in cookies {{\n        if !valid_cookie_pair(c) -> next\n        if first {{\n            s = c\n            first = false\n        }} else {{\n            s = \"{{s}}; {{c}}\"\n        }}\n    }}\n    s\n}}\n\npub fn session_request(s: Session, method: String, url: String, body: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {{\n    if !valid_method(method) -> return Err(.InvalidMethod)\n    if !valid_url(url) -> return Err(.InvalidURL)\n    if body.bytes().len() > C_MAX_BODY_BYTES -> return Err(.BodyTooLarge{{limit: C_MAX_BODY_BYTES}})\n    if s.proxy.bytes().len() > 0 && !valid_url(s.proxy) -> return Err(.Proxy{{stage: \"invalid proxy\"}})\n    h := session_headers(s)\n    resp :: request_with_retries(s, method, url, body, h)\n    session_follow(s, method, url, body, h, resp)\n}}\n\nfn session_follow(s: Session, method: String, url: String, body: String, h: [String], first: HTTPResponse) -[Net, Time.Wait]> HTTPResponse HTTPError! {{\n    hops := 0\n    resp := first\n    current_method := method\n    current_url := url\n    current_body := body\n    headers := ~h\n    loop {{\n        code := resp.status()\n        if code < 300 || code >= 400 -> return Ok(~resp)\n        if code != 301 && code != 302 && code != 303 && code != 307 && code != 308 -> return Ok(~resp)\n        if hops >= s.redirects -> return Ok(~resp)\n        loc :: &resp.header(\"Location\") ?? return Ok(~resp)\n        next :: resolve_location(current_url, loc) ?? return Err(.InvalidURL)\n        if is_https_downgrade(current_url, next) -> return Err(.Redirect{{reason: \"https downgrade\"}})\n        on_same_origin := same_origin(current_url, next)\n        preserve := code == 307 || code == 308\n        if !preserve {{\n            current_method = \"GET\"\n            current_body = \"\"\n            headers = redirect_headers(headers, !on_same_origin)\n        }} else if !on_same_origin {{\n            headers = redirect_headers(headers, true)\n        }}\n        retry :: request_with_retries(s, current_method, next, current_body, headers)\n        resp = retry\n        current_url = next\n        hops = hops + 1\n    }}\n}}\n\nfn request_with_retries(s: Session, method: String, url: String, body: String, headers: [String]) -[Net, Time.Wait]> HTTPResponse HTTPError! {{\n    attempts := 0\n    loop {{\n        if request_once(s, method, url, body, headers) == {{\n            .Ok(response) -> return Ok(response)\n            .Err(error) -> {{\n                if attempts >= s.retries || !retryable_method(method) || !retryable_error(error) -> return Err(error)\n                attempts = attempts + 1\n            }}\n        }}\n    }}\n}}\n\nfn retryable_method(method: String) -> Bool Never! {{\n    u :: ascii_upper(method)\n    u == \"GET\" || u == \"HEAD\" || u == \"OPTIONS\" || u == \"TRACE\" || u == \"PUT\" || u == \"DELETE\"\n}}\n\nfn retryable_error(error: HTTPError) -> Bool Never! {{\n    if error == {{\n        .IO(_) -> true\n        else -> false\n    }}\n}}\n\npub fn redirect_limit(policy: RedirectPolicy, fallback: Int) -> Int Never! {{\n    if policy == {{\n        RedirectPolicy.Disabled -> return 0\n        RedirectPolicy.All -> return C_MAX_REDIRECTS\n        else -> {{ _ := 0 }}\n    }}\n    if fallback < 0 -> return 0\n    if fallback > C_MAX_REDIRECTS -> return C_MAX_REDIRECTS\n    fallback\n}}\npub fn session_get(s: Session, url: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {{ session_request(s, \"GET\", url, \"\") }}\npub fn session_post(s: Session, url: String, body: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {{ session_request(s, \"POST\", url, body) }}\npub fn session_put(s: Session, url: String, body: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {{ session_request(s, \"PUT\", url, body) }}\npub fn session_patch(s: Session, url: String, body: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {{ session_request(s, \"PATCH\", url, body) }}\npub fn session_delete(s: Session, url: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {{ session_request(s, \"DELETE\", url, \"\") }}\npub fn session_head(s: Session, url: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {{ session_request(s, \"HEAD\", url, \"\") }}\n\npub fn session_json(s: Session, url: String, body: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {{\n    h := session_header(s, \"Content-Type\", \"application/json\")\n    h2 := session_header(h, \"Accept\", \"application/json\")\n    session_post(h2, url, body)\n}}\n\npub fn session_form(s: Session, url: String, body: String) -[Net, Time.Wait]> HTTPResponse HTTPError! {{\n    h := session_header(s, \"Content-Type\", \"application/x-www-form-urlencoded\")\n    session_post(h, url, body)\n}}\n\nfn request_once(s: Session, method: String, url: String, body: String, headers: [String]) -[Net, Time.Wait]> HTTPResponse HTTPError! {{\n    req := provider.request(method, url)\n    req = req.redirects(0)\n    req = req.timeout(s.timeout_ms)\n    if s.proxy.bytes().len() > 0 -> req = req.proxy(s.proxy)\n    loop line in headers {{\n        name :: header_name(line) ?? return Err(.InvalidHeader)\n        value :: header_value(line) ?? return Err(.InvalidHeader)\n        req = &req.header(name, value)\n    }}\n    if body.bytes().len() > C_MAX_BODY_BYTES -> return Err(.BodyTooLarge{{limit: C_MAX_BODY_BYTES}})\n    if body.bytes().len() > 0 -> req = req.body(body)\n    req.send()\n}}\n\npub fn user_agent(client: Client, name: String) -> Client Never! {{ set_header(client, \"User-Agent\", name) }}\npub fn bearer(client: Client, token: String) -> Client Never! {{ set_header(client, \"Authorization\", http.bearer_auth(token)) }}\npub fn accept(client: Client, mime: String) -> Client Never! {{ set_header(client, \"Accept\", mime) }}\npub fn content_type(client: Client, mime: String) -> Client Never! {{ set_header(client, \"Content-Type\", mime) }}\n\n\nfn session_headers(s: Session) -> [String] Never! {{\n    h := ~s.headers\n    if s.user.bytes().len() > 0 -> h = set_header_line(h, \"Authorization\", http.basic_auth(s.user, s.password))\n    jar :: cookie_header(~s.cookies)\n    if jar.bytes().len() > 0 -> h = set_header_line(h, \"Cookie\", jar)\n    h\n}}\n\nfn header_name(line: String) -> String? {{\n    raw :: line.bytes()\n    col := index_byte(raw, 58)\n    if col <= 0 -> return None\n    name :: slice_text(line, 0, col)\n    if !valid_header_name(name) -> return None\n    Val(name)\n}}\n\nfn header_value(line: String) -> String? {{\n    raw :: line.bytes()\n    col := index_byte(raw, 58)\n    if col <= 0 -> return None\n    value :: slice_text(line, col + 1, raw.len())\n    if has_ctl(value.bytes()) -> return None\n    Val(trim(value))\n}}\n\nfn append_header(headers: [String], line: String) -> [String] {{\n    out := ~headers\n    &out.push(line)\n    out\n}}\n\nfn set_header_line(headers: [String], name: String, value: String) -> [String] Never! {{\n    if !valid_header_name(name) || has_ctl(value.bytes()) -> return ~headers\n    out := [String]{{}}\n    want :: ascii_lower(name)\n    replaced := false\n    loop line in headers {{\n        current :: header_name(line) ?? next\n        if ascii_lower(current) == want {{\n            if !replaced {{\n                &out.push(\"{{name}}: {{value}}\")\n                replaced = true\n            }}\n        }} else {{\n            &out.push(line)\n        }}\n    }}\n    if !replaced -> &out.push(\"{{name}}: {{value}}\")\n    out\n}}\n\nfn redirect_headers(headers: [String], strip_credentials: Bool) -> [String] Never! {{\n    out := [String]{{}}\n    loop line in headers {{\n        name :: header_name(line) ?? next\n        lower :: ascii_lower(name)\n        credential := lower == \"authorization\" || lower == \"proxy-authorization\" || lower == \"cookie\" || lower == \"host\"\n        body_header := lower == \"content-length\" || lower == \"content-type\" || lower == \"content-encoding\" || lower == \"transfer-encoding\" || lower == \"expect\"\n        if !body_header && (!strip_credentials || !credential) -> &out.push(line)\n    }}\n    out\n}}\n\nfn valid_cookie_pair(cookie: String) -> Bool Never! {{\n    eq := index_byte(cookie.bytes(), 61)\n    if eq <= 0 -> return false\n    name :: slice_text(cookie, 0, eq)\n    value :: slice_text(cookie, eq + 1, cookie.bytes().len())\n    valid_cookie_token(name) && valid_cookie_value(value)\n}}\n\nfn cookie_name(cookie: String) -> String? {{\n    eq := index_byte(cookie.bytes(), 61)\n    if eq <= 0 -> return None\n    Val(slice_text(cookie, 0, eq))\n}}\n\nfn valid_cookie_token(name: String) -> Bool Never! {{\n    raw :: name.bytes()\n    if raw.len() == 0 -> return false\n    loop b in raw {{\n        n :: Int.from_u8(b)\n        if n <= 32 || n >= 127 || n == 34 || n == 40 || n == 41 || n == 44 || n == 47 || n == 58 || n == 59 || n == 60 || n == 61 || n == 62 || n == 63 || n == 64 || n == 91 || n == 92 || n == 93 || n == 123 || n == 125 -> return false\n    }}\n    true\n}}\n\nfn valid_cookie_value(value: String) -> Bool Never! {{\n    loop b in value.bytes() {{\n        n :: Int.from_u8(b)\n        if n <= 32 || n >= 127 || n == 34 || n == 44 || n == 59 || n == 92 -> return false\n    }}\n    true\n}}\n\nfn resolve_location(base: String, location: String) -> String? {{\n    if location.bytes().len() == 0 -> return None\n    joined :: http_url.urljoin(base, location) ?? return None\n    hash := index_byte(joined.bytes(), 35)\n    clean := if hash >= 0 -> slice_text(joined, 0, hash) else -> joined\n    if !valid_url(clean) -> return None\n    Val(clean)\n}}\n\nfn is_https_downgrade(base: String, next: String) -> Bool Never! {{\n    from :: http_url.parse(base) ?? return false\n    to :: http_url.parse(next) ?? return false\n    from.scheme == \"https\" && to.scheme == \"http\"\n}}\n\nfn same_origin(left: String, right: String) -> Bool Never! {{\n    a :: http_url.parse(left) ?? return false\n    b :: http_url.parse(right) ?? return false\n    a.scheme == b.scheme && a.host == b.host && a.port == b.port\n}}\n\nfn slice_text(text: String, start: Int, end: Int) -> String Never! {{\n    raw :: text.bytes()\n    out := [U8]{{}}\n    i := start\n    loop {{\n        if i < 0 || i >= end || i >= raw.len() -> return String.from_bytes(out) ?? \"\"\n        &out.push(raw[i])\n        i = i + 1\n    }}\n}}\n\n\nfn ascii_upper(text: String) -> String Never! {{\n    out := [U8]{{}}\n    loop b in text.bytes() {{\n        n :: Int.from_u8(b)\n        if n >= 97 && n <= 122 -> &out.push(U8{{n - 32}}) else -> &out.push(b)\n    }}\n    String.from_bytes(out) ?? text\n}}\nfn ascii_lower(text: String) -> String Never! {{\n    out := [U8]{{}}\n    loop b in text.bytes() {{\n        n :: Int.from_u8(b)\n        if n >= 65 && n <= 90 -> &out.push(U8{{n + 32}}) else -> &out.push(b)\n    }}\n    String.from_bytes(out) ?? text\n}}\n\nfn trim(text: String) -> String Never! {{\n    raw :: text.bytes()\n    start := 0\n    end := raw.len()\n    loop start < end {{\n        n :: Int.from_u8(raw[start])\n        if n == 32 || n == 9 || n == 13 || n == 10 -> start = start + 1 else -> break\n    }}\n    loop end > start {{\n        n :: Int.from_u8(raw[end - 1])\n        if n == 32 || n == 9 || n == 13 || n == 10 -> end = end - 1 else -> break\n    }}\n    if end <= start -> return \"\"\n    slice_text(text, start, end)\n}}\n\nfn index_byte(raw: [U8], target: Int) -> Int Never! {{\n    loop i in 0..<raw.len() {{\n        if Int.from_u8(raw[i]) == target -> return i\n    }}\n    -1\n}}\n\nfn valid_header_name(name: String) -> Bool Never! {{\n    raw :: name.bytes()\n    if raw.len() == 0 -> return false\n    loop b in raw {{\n        if !token_char(Int.from_u8(b)) -> return false\n    }}\n    true\n}}\n\nfn token_char(n: Int) -> Bool Never! {{\n    (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || (n >= 48 && n <= 57) || n == 33 || n == 35 || n == 36 || n == 37 || n == 38 || n == 39 || n == 42 || n == 43 || n == 45 || n == 46 || n == 94 || n == 95 || n == 96 || n == 124 || n == 126\n}}\n\nfn valid_method(method: String) -> Bool Never! {{\n    raw :: method.bytes()\n    if raw.len() == 0 -> return false\n    loop b in raw {{\n        if !token_char(Int.from_u8(b)) -> return false\n    }}\n    true\n}}\n\nfn has_ctl(raw: [U8]) -> Bool Never! {{\n    loop b in raw {{\n        n :: Int.from_u8(b)\n        if (n < 32 && n != 9) || n == 127 -> return true\n    }}\n    false\n}}\n\nfn valid_url(url: String) -> Bool Never! {{\n    raw :: url.bytes()\n    if raw.len() < 8 || raw.len() > C_MAX_URL_BYTES || has_url_ctl(raw) -> return false\n    parsed :: http_url.parse(url) ?? return false\n    if parsed.scheme != \"http\" && parsed.scheme != \"https\" -> return false\n    if parsed.host.bytes().len() == 0 || parsed.userinfo().bytes().len() > 0 -> return false\n    colon := index_byte(raw, 58)\n    if colon <= 0 || colon + 2 >= raw.len() -> return false\n    if raw[colon + 1] != (U8{{47}}) || raw[colon + 2] != (U8{{47}}) -> return false\n    start := colon + 3\n    end := start\n    loop end < raw.len() {{\n        if raw[end] == (U8{{47}}) || raw[end] == (U8{{63}}) || raw[end] == (U8{{35}}) -> break\n        n :: Int.from_u8(raw[end])\n        if n <= 32 || n >= 127 || n == 34 || n == 92 -> return false\n        end = end + 1\n    }}\n    end > start\n}}\n\nfn has_url_ctl(raw: [U8]) -> Bool Never! {{\n    loop b in raw {{\n        n :: Int.from_u8(b)\n        if n < 32 || n == 127 -> return true\n    }}\n    false\n}}\n"}
}

fn foundation_embedded_core_source_51() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.http.server", alias: "core_core_http_server", path: "Core/http/server.jet", owner: "", owned_members: [String]{"access_log", "cors", "cors_policy", "json", "mux", "request_id", "response", "serve_once", "serve_once_listener", "sse", "static_file", "static_file_range", "static_files", "tls"}, source: "use core as core\nuse core.http.[HTTPError, HTTPRequest, HTTPResponse]\nuse core.http.server as provider\n\n// core.http.server — typed HTTP server provider boundary.\n//\n// The native leaf owns sockets, request dispatch, and response construction.\n// Keep this module as the canonical source-facing contract instead of\n// rebuilding HTTP carriers or transport framing here.\n//\n// `bind` and `serve` stay native rows: their label-only `tls:` and\n// `deadline:` options take the payload directly and default to absent, a\n// contract a Jet `T?` parameter can't state without `Val(...)` at every call.\n\npub fn mux() -> HTTPMux Never! {{\n    provider.mux()\n}}\n\npub fn serve_once(addr: String, mux: HTTPMux) HTTPError! {{\n    provider.serve_once(addr, mux) ?? return\n}}\n\npub fn serve_once_listener(listener: TCPListener, mux: HTTPMux) HTTPError! {{\n    provider.serve_once_listener(listener, mux) ?? return\n}}\n\npub fn response(status: Int, body: String) -> HTTPResponse Never! {{\n    provider.response(status, body)\n}}\n\npub fn json<T: Encode>(status: Int, body: T) -> HTTPResponse Never! {{\n    provider.json<T>(status, body)\n}}\n\npub fn static_file(path: String, content_type: String) -[FS, Net, Time.Wait]> HTTPResponse HTTPError! {{\n    provider.static_file(path, content_type)\n}}\n\npub fn static_file_range(request: HTTPRequest, path: String, content_type: String) -[FS, Net, Time.Wait]> HTTPResponse HTTPError! {{\n    provider.static_file_range(request, path, content_type)\n}}\n\npub fn static_files(mux: HTTPMux, prefix: String, root: String) Never! {{\n    provider.static_files(mux, prefix, root)\n}}\n\npub fn tls(cert: String, key: String) -> HTTPServerTLS Never! {{\n    provider.tls(cert, key)\n}}\n\npub fn sse(body: String) -> HTTPResponse Never! {{\n    provider.sse(body)\n}}\n\npub fn cors_policy(origins: [String]) -> HTTPCorsPolicy HTTPError! {{\n    provider.cors_policy(origins)\n}}\n\npub fn cors(mux: HTTPMux, policy: HTTPCorsPolicy) Never! {{\n    provider.cors(mux, policy)\n}}\n\npub fn access_log(request: HTTPRequest, status: Int) -> String Never! {{\n    provider.access_log(request, status)\n}}\n\npub fn request_id(mux: HTTPMux) Never! {{\n    provider.request_id(mux)\n}}\n"}
}

fn foundation_embedded_core_source_52() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.jobs", alias: "core_core_jobs", path: "Core/jobs/jobs.jet", owner: "", owned_members: [String]{"ack", "cancel", "claim", "enqueue", "fail", "named", "queue", "status", "with_max_attempts", "queue_name", "state", "attempts", "payload", "event", "events", "is_terminal", "is_cancelled"}, source: "package {{\n    name: \"core.jobs\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"Durable job queues.\"\n    license: \"MIT\"\n    outputs: {{\n        jobs: .Library{{ entry: jobs }}\n    }}\n}}\n\n// core.jobs — an in-memory at-least-once queue.\n//\n// `queue` is the constructor. Enqueue assigns a monotonic id. `claim` moves\n// Queued → Running; `ack` completes; `fail` retries until `max_attempts`\n// then dead-letters. Persistence is a later host cell; the state machine\n// is Jet so tests do not need a broker.\n\n#Error\npub enum JobError {{\n    Empty\n    Duplicate\n    Failed\n    Missing\n}}\n\npub enum JobQueueDeliveryPolicy {{\n    AtLeastOnce\n}}\n\npub enum JobQueueState {{\n    Queued\n    Running\n    Retrying\n    Completed\n    Failed\n    DeadLettered\n    Cancelled\n}}\n\npub struct JobPayload {{ pub body: String }}\npub struct JobResult {{ pub ok: Bool, pub detail: String }}\npub struct JobQueueReceipt {{ pub id: String }}\npub struct JobQueueClaim {{ pub id: String, pub payload: String }}\npub struct JobQueueEvent {{ pub kind: String, pub id: String }}\npub struct JobQueueRecord {{\n    pub id: String\n    pub payload: String\n    pub state: JobQueueState\n    pub attempts: Int\n}}\npub struct JobQueueStatus {{\n    pub queued: Int\n    pub running: Int\n    pub done: Int\n    pub failed: Int\n}}\n\npub struct JobQueue {{\n    pub name: String\n    pub next_id: Int\n    pub max_attempts: Int\n    pub policy: JobQueueDeliveryPolicy\n    pub records: [JobQueueRecord]\n}}\n\npub fn queue() -> JobQueue Never! {{\n    JobQueue{{name: \"default\", next_id: 1, max_attempts: 8, policy: JobQueueDeliveryPolicy.AtLeastOnce, records: [JobQueueRecord]{{}}}}\n}}\n\n/// Return a queue with a bounded retry budget. A non-positive budget is\n/// normalized to one attempt so a failed claim cannot loop forever.\npub fn with_max_attempts(q: JobQueue, max_attempts: Int) -> JobQueue Never! {{\n    limit := max_attempts\n    if limit < 1 -> limit = 1\n    if limit > 1000000 -> limit = 1000000\n    JobQueue{{\n        name: q.name,\n        next_id: q.next_id,\n        max_attempts: limit,\n        policy: q.policy,\n        records: ~q.records,\n    }}\n}}\n\npub fn queue_name(q: JobQueue) -> String Never! {{ q.name }}\npub fn named(name: String) -> JobQueue JobError! {{\n    if !valid_queue_name(name) -> return Err(JobError.Empty)\n    q :: queue()\n    JobQueue{{name: name, next_id: 1, max_attempts: q.max_attempts, policy: q.policy, records: [JobQueueRecord]{{}}}}\n}}\n\n\npub fn enqueue(q: JobQueue, job: String) -> (queue: JobQueue, receipt: JobQueueReceipt) JobError! {{\n    if !valid_job_payload(job) -> return Err(JobError.Empty)\n    if q.next_id < 1 || q.next_id >= 9223372036854775807 -> return Err(JobError.Failed)\n    id :: \"{{q.next_id}}\"\n    recs := copy_recs(q.records)\n    &recs.push(JobQueueRecord{{id: id, payload: job, state: JobQueueState.Queued, attempts: 0}})\n    nq :: JobQueue{{name: q.name, next_id: q.next_id + 1, max_attempts: q.max_attempts, policy: q.policy, records: recs}}\n    (queue: nq, receipt: JobQueueReceipt{{id: id}})\n}}\n\npub fn claim(q: JobQueue) -> (queue: JobQueue, taken: JobQueueClaim?) Never! {{\n    recs := copy_recs(q.records)\n    limit := q.max_attempts\n    if limit < 1 -> limit = 1\n    changed := false\n    loop i in 0..<recs.len() {{\n        st :: recs[i].state\n        if st == JobQueueState.Queued || st == JobQueueState.Retrying {{\n            if recs[i].attempts < 0 -> recs[i].attempts = 0\n            if st == JobQueueState.Retrying && recs[i].attempts >= limit {{\n                recs[i].state = JobQueueState.DeadLettered\n                changed = true\n                next\n            }}\n            if recs[i].attempts >= 9223372036854775807 {{\n                recs[i].state = JobQueueState.DeadLettered\n                changed = true\n                next\n            }}\n            recs[i] = JobQueueRecord{{\n                id: recs[i].id,\n                payload: recs[i].payload,\n                state: JobQueueState.Running,\n                attempts: recs[i].attempts + 1,\n            }}\n            nq :: JobQueue{{\n                name: q.name,\n                next_id: q.next_id,\n                max_attempts: limit,\n                policy: q.policy,\n                records: ~recs,\n            }}\n            return (queue: nq, taken: Val(JobQueueClaim{{id: ~recs[i].id, payload: ~recs[i].payload}}))\n        }}\n    }}\n    if changed {{\n        return (queue: JobQueue{{name: q.name, next_id: q.next_id, max_attempts: limit, policy: q.policy, records: ~recs}}, taken: None)\n    }}\n    (queue: q, taken: None)\n}}\n\npub fn ack(q: JobQueue, id: String) -> JobQueue JobError! {{\n    set_state(q, id, JobQueueState.Completed)\n}}\n\npub fn fail(q: JobQueue, id: String) -> JobQueue JobError! {{\n    if !valid_job_id(id) -> return Err(JobError.Missing)\n    recs := copy_recs(q.records)\n    limit := q.max_attempts\n    if limit < 1 -> limit = 1\n    loop i in 0..<recs.len() {{\n        if recs[i].id != id -> next\n        if recs[i].state != JobQueueState.Running -> return Err(JobError.Failed)\n        next_state :: if recs[i].attempts >= limit -> JobQueueState.DeadLettered else -> JobQueueState.Retrying\n        recs[i] = JobQueueRecord{{\n            id: ~recs[i].id,\n            payload: ~recs[i].payload,\n            state: next_state,\n            attempts: recs[i].attempts,\n        }}\n        return Ok(JobQueue{{\n            name: q.name,\n            next_id: q.next_id,\n            max_attempts: limit,\n            policy: q.policy,\n            records: ~recs,\n        }})\n    }}\n    Err(JobError.Missing)\n}}\n\npub fn cancel(q: JobQueue, id: String) -> JobQueue JobError! {{\n    if !valid_job_id(id) -> return Err(JobError.Missing)\n    set_state(q, id, JobQueueState.Cancelled)\n}}\npub fn status(q: JobQueue) -> JobQueueStatus Never! {{\n    queued := 0\n    running := 0\n    done := 0\n    failed := 0\n    loop r in q.records {{\n        if r.state == JobQueueState.Queued || r.state == JobQueueState.Retrying -> queued += 1\n        if r.state == JobQueueState.Running -> running += 1\n        if r.state == JobQueueState.Completed -> done += 1\n        if r.state == JobQueueState.Failed || r.state == JobQueueState.DeadLettered -> failed += 1\n    }}\n    JobQueueStatus{{queued: queued, running: running, done: done, failed: failed}}\n}}\n\nfn set_state(q: JobQueue, id: String, state: JobQueueState) -> JobQueue JobError! {{\n    if !valid_job_id(id) -> return Err(JobError.Missing)\n    recs := copy_recs(q.records)\n\n    loop i in 0..<recs.len() {{\n        if recs[i].id != id -> next\n        current :: recs[i].state\n        if current == state -> return Err(JobError.Duplicate)\n        if state == JobQueueState.Completed && current != JobQueueState.Running {{\n            return Err(JobError.Failed)\n        }}\n        if state == JobQueueState.Cancelled {{\n            if current != JobQueueState.Queued && current != JobQueueState.Running && current != JobQueueState.Retrying {{\n                return Err(JobError.Failed)\n            }}\n        }}\n        recs[i] = JobQueueRecord{{id: ~recs[i].id, payload: ~recs[i].payload, state: state, attempts: recs[i].attempts}}\n        return Ok(JobQueue{{name: q.name, next_id: q.next_id, max_attempts: q.max_attempts, policy: q.policy, records: ~recs}})\n    }}\n    Err(JobError.Missing)\n}}\npub fn state(q: JobQueue, id: String) -> JobQueueState? Never! {{\n    loop record in ~q.records {{\n        if record.id == id -> return Val(record.state)\n    }}\n    None\n}}\n\npub fn attempts(q: JobQueue, id: String) -> Int Never! {{\n    loop record in ~q.records {{\n        if record.id == id -> return record.attempts\n    }}\n    0\n}}\n\npub fn payload(q: JobQueue, id: String) -> String? Never! {{\n    loop record in ~q.records {{\n        if record.id == id -> return Val(record.payload)\n    }}\n    None\n}}\n\npub fn event(q: JobQueue, id: String) -> JobQueueEvent? Never! {{\n    st :: state(q, id) ?? return None\n    Val(JobQueueEvent{{kind: state_name(st), id: id}})\n}}\n\npub fn events(q: JobQueue) -> [JobQueueEvent] Never! {{\n    out := [JobQueueEvent]{{}}\n    loop record in ~q.records {{\n        &out.push(JobQueueEvent{{kind: state_name(record.state), id: record.id}})\n    }}\n    out\n}}\n\npub fn is_terminal(state: JobQueueState) -> Bool Never! {{\n    state == JobQueueState.Completed\n        || state == JobQueueState.Failed\n        || state == JobQueueState.DeadLettered\n        || state == JobQueueState.Cancelled\n}}\n\npub fn is_cancelled(state: JobQueueState) -> Bool Never! {{\n    state == JobQueueState.Cancelled\n}}\n\nfn state_name(state: JobQueueState) -> String Never! {{\n    if state == JobQueueState.Queued -> return \"queued\"\n    if state == JobQueueState.Running -> return \"running\"\n    if state == JobQueueState.Retrying -> return \"retrying\"\n    if state == JobQueueState.Completed -> return \"completed\"\n    if state == JobQueueState.Failed -> return \"failed\"\n    if state == JobQueueState.DeadLettered -> return \"dead-lettered\"\n    \"cancelled\"\n}}\n\nfn copy_recs(xs: [JobQueueRecord]) -> [JobQueueRecord] Never! {{\n    out := [JobQueueRecord]{{}}\n    loop x in xs -> &out.push(x)\n    out\n}}\nfn valid_queue_name(value: String) -> Bool Never! {{\n    trimmed :: value.trim()\n    trimmed != \"\" && trimmed.len() <= 256 && value == trimmed && !has_control(value)\n}}\n\nfn valid_job_payload(value: String) -> Bool Never! {{\n    value.len() > 0 && value.len() <= 1048576\n}}\n\nfn valid_job_id(value: String) -> Bool Never! {{\n    if value.len() == 0 -> return false\n    loop byte in value.bytes() {{\n        n :: Int.from_u8(byte)\n        if n < 48 || n > 57 -> return false\n    }}\n    true\n}}\n\nfn has_control(value: String) -> Bool Never! {{\n    loop byte in value.bytes() {{\n        n :: Int.from_u8(byte)\n        if n < 32 || n == 127 -> return true\n    }}\n    false\n}}\n"}
}

fn foundation_embedded_core_source_53() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.log", alias: "core_core_log", path: "Core/log/log.jet", owner: "", owned_members: [String]{"bool", "close", "counter", "critical", "debug", "debug_fields", "disable", "enabled", "enter", "error", "error_fields", "fatal", "field", "float", "flush", "format", "formatter", "handle", "handler", "handler_format", "info", "info_fields", "int", "log", "otlp_file", "record", "redact", "sample_every", "set_level", "set_sink", "set_trace_id", "setup", "span", "warn", "warn_fields", "warning", "add", "group", "time", "clear"}, source: "package {{\n    name: \"core.log\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"Structured logs, spans, and sinks.\"\n    license: \"MIT\"\n    outputs: {{\n        log: .Library{{ entry: log }}\n    }}\n}}\nuse core as core\n\n// core.log — one structured logger for the process.\n//\n// Levels are `debug`, `info`, `warn`, `error`, `critical`, `fatal`. Fields\n// are typed (`field` / `int` / `float` / `bool`); `redact` marks a key so\n// sinks must not print its value. Spans are `span` + `enter` / `close`.\n// This is not a tracing SDK; OTLP file export is the one optional bridge.\n//\n// Filtering, sampling, JSON line layout, and redaction are Jet. The sink\n// write and the process-global level/trace cells are host.\npub struct LogField {{\n    pub key: String\n    pub value: String\n    pub kind: String\n    pub redacted: Bool\n}}\n\npub fn debug(message: String) Never! -[Log]> {{ emit(\"debug\", message, [LogField]{{}}) }}\n\npub fn info(message: String) Never! -[Log]> {{ emit(\"info\", message, [LogField]{{}}) }}\n\npub fn warn(message: String) Never! -[Log]> {{ emit(\"warn\", message, [LogField]{{}}) }}\n\npub fn error(message: String) Never! -[Log]> {{ emit(\"error\", message, [LogField]{{}}) }}\n/// Emit a message at a caller-selected level.\npub fn log(level: String, message: String) Never! -[Log]> {{ emit(level, message, [LogField]{{}}) }}\n\n/// Python-compatible warning spelling.\npub fn warning(message: String) Never! -[Log]> {{ warn(message) }}\n\n\npub fn critical(message: String) Never! -[Log]> {{ emit(\"critical\", message, [LogField]{{}}) }}\n\npub fn fatal(message: String) Never! -[Log]> {{ emit(\"fatal\", message, [LogField]{{}}) }}\n\npub fn debug_fields(message: String, fields: [LogField]) Never! -[Log]> {{ emit(\"debug\", message, fields) }}\n\npub fn info_fields(message: String, fields: [LogField]) Never! -[Log]> {{ emit(\"info\", message, fields) }}\n\npub fn warn_fields(message: String, fields: [LogField]) Never! -[Log]> {{ emit(\"warn\", message, fields) }}\n\npub fn error_fields(message: String, fields: [LogField]) Never! -[Log]> {{ emit(\"error\", message, fields) }}\n\npub fn field(key: String, value: String) -> LogField Never! {{\n    LogField{{key: key, value: value, kind: \"string\", redacted: false}}\n}}\n\npub fn int(key: String, value: Int) -> LogField Never! {{\n    LogField{{key: key, value: \"{{value}}\", kind: \"int\", redacted: false}}\n}}\n\npub fn float(key: String, value: Float) -> LogField Never! {{\n    LogField{{key: key, value: \"{{value}}\", kind: \"float\", redacted: false}}\n}}\n\npub fn bool(key: String, value: Bool) -> LogField Never! {{\n    LogField{{key: key, value: \"{{value}}\", kind: \"bool\", redacted: false}}\n}}\n\npub fn redact(key: String) -> LogField Never! {{\n    LogField{{key: key, value: \"[redacted]\", kind: \"redacted\", redacted: true}}\n}}\n\npub fn span(name: String) -[Log]> LogSpan Never! {{ core.log.span(name) }}\n\npub fn enter(span: LogSpan) Never! -[Log]> {{ core.log.enter(span) }}\n\npub fn close(span: LogSpan) Never! -[Log]> {{ core.log.close(span) }}\n\n/// Select the record sink. `stderr` (JSON lines on stderr) and the `json`,\n/// `jsonl` and `text` file sinks are supported. An unsupported kind, or a\n/// file sink without a path, leaves the sink unchanged and logs an error\n/// record that names the rejected setting instead of returning silently.\npub fn set_sink(kind: String, path: String) Never! -[Log]> {{\n    normalized :: ascii_lower(trim(kind))\n    if normalized == \"stderr\" -> return core.log.set_sink(\"json\", \"\")\n    if normalized != \"json\" && normalized != \"jsonl\" && normalized != \"text\" {{\n        return reject_setting(\"log.set_sink: unsupported sink kind `{{kind}}`; the sink is unchanged (supported: stderr, json, jsonl, text)\")\n    }}\n    if (normalized == \"jsonl\" || normalized == \"text\") && trim(~path).len() == 0 {{\n        return reject_setting(\"log.set_sink: the `{{normalized}}` sink needs a file path; the sink is unchanged\")\n    }}\n    core.log.set_sink(normalized, path)\n}}\n\npub fn sample_every(n: Int) Never! -[Log]> {{\n    if n > 0 -> core.log.sample_every(n)\n}}\n\npub fn counter(name: String, value: Int) -> LogField Never! {{ core.log.counter(name, value) }}\n\npub fn otlp_file(path: String) Never! -[Log, FS]> {{\n    if trim(~path).len() > 0 -> core.log.otlp_file(path)\n}}\n\npub fn set_level(level: String) Never! -[Log]> {{\n    normalized :: canon_level(level)\n    if normalized.len() > 0 -> core.log.set_level(normalized)\n}}\n\npub fn set_trace_id(id: String) Never! -[Log]> {{\n    if trim(~id).len() > 0 -> core.log.set_trace_id(id)\n}}\n\n/// Apply comma-separated settings without handing the whole grammar to the\n/// host. Each setting is `key=value` (`level`, `format`, `sink`, `file` or\n/// `path`, `sample` or `sample_every`, `trace_id`); a bare `auto`, `json` or\n/// `text` selects the record format (D-LOGFMT1). An unknown setting or value\n/// is reported as an error record and otherwise ignored. The host owns the\n/// sink and process-global cells; Jet owns normalization and dispatch.\npub fn setup(spec: String) Never! -[Log]> {{\n    loop raw in split_csv(spec) {{\n        if trim(raw).len() == 0 -> next\n        pair :: split_once(raw, \"=\")\n        key :: ascii_lower(trim(pair.left))\n        value :: trim(pair.right)\n        if {{\n            value.len() == 0 && is_format(key) -> core.log.setup(key)\n            key == \"level\" && canon_level(value).len() > 0 -> set_level(value)\n            key == \"format\" && is_format(ascii_lower(value)) -> core.log.setup(ascii_lower(value))\n            key == \"sink\" -> {{\n                sink :: ascii_lower(value)\n                if sink == \"stderr\" || sink == \"stdout\" -> set_sink(sink, \"\") else -> set_sink(\"jsonl\", value)\n            }}\n            (key == \"file\" || key == \"path\") && value.len() > 0 -> set_sink(\"jsonl\", value)\n            (key == \"sample\" || key == \"sample_every\") && (parse_int(value) ?? 0) > 0 -> sample_every(parse_int(value) ?? 0)\n            key == \"trace_id\" && value.len() > 0 -> set_trace_id(value)\n            else -> reject_setting(\"log.setup: unsupported setting `{{trim(raw)}}`; it was ignored\")\n        }}\n    }}\n}}\n\nfn is_format(name: String) -> Bool {{\n    name == \"auto\" || name == \"json\" || name == \"text\"\n}}\n\nfn reject_setting(message: String) -[Log]> {{\n    emit(\"error\", message, [LogField]{{}})\n}}\n\npub fn disable() Never! -[Log]> {{ core.log.disable() }}\n\npub fn flush() Never! -[Log]> {{ core.log.flush() }}\n\npub fn enabled(level: String) -[Log]> Bool Never! {{\n    normalized :: canon_level(level)\n    if normalized.len() == 0 -> return false\n    core.log.enabled(normalized)\n}}\n\nfn emit(level: String, message: String, fields: [LogField]) -[Log]> {{\n    normalized :: canon_level(level)\n    if normalized.len() == 0 -> return\n    if !core.log.enabled(normalized) -> return\n    normalized_fields := fields\n    if normalized_fields.len() > 0 -> normalized_fields = normalize_fields(normalized_fields)\n    if normalized == {{\n        \"debug\" -> {{\n            if normalized_fields.len() > 0 -> return core.log.debug_fields(message, normalized_fields)\n            return core.log.debug(message)\n        }}\n        \"info\" -> {{\n            if normalized_fields.len() > 0 -> return core.log.info_fields(message, normalized_fields)\n            return core.log.info(message)\n        }}\n        \"warn\" -> {{\n            if normalized_fields.len() > 0 -> return core.log.warn_fields(message, normalized_fields)\n            return core.log.warn(message)\n        }}\n        \"error\" -> {{\n            if normalized_fields.len() > 0 -> return core.log.error_fields(message, normalized_fields)\n            return core.log.error(message)\n        }}\n        \"critical\" -> {{\n            line := message\n            if normalized_fields.len() > 0 -> line = render_json(record(normalized, message, normalized_fields))\n            return core.log.critical(line)\n        }}\n        \"fatal\" -> {{\n            line := message\n            if normalized_fields.len() > 0 -> line = render_json(record(normalized, message, normalized_fields))\n            return core.log.fatal(line)\n        }}\n        else -> return\n    }}\n}}\nfn normalize_fields(fields: [LogField]) -> [LogField] {{\n    needs_normalization := false\n    loop i in 0..<fields.len() {{\n        if fields[i].redacted || (fields[i].kind != \"string\" && fields[i].kind != \"int\" && fields[i].kind != \"float\" && fields[i].kind != \"bool\" && fields[i].kind != \"counter\") {{\n            needs_normalization = true\n            break\n        }}\n    }}\n    if !needs_normalization -> return ~fields\n    out := [LogField]{{}}\n    loop field in fields {{\n        if field.redacted {{\n            &out.push(LogField{{key: field.key, value: \"[redacted]\", kind: \"redacted\", redacted: true}})\n        }} else if field.kind != \"string\" && field.kind != \"int\" && field.kind != \"float\" && field.kind != \"bool\" && field.kind != \"counter\" {{\n            &out.push(LogField{{key: field.key, value: field.value, kind: \"string\", redacted: false}})\n        }} else {{\n            &out.push(field)\n        }}\n    }}\n    out\n}}\n\nfn rank(level: String) -> Int {{\n    n :: canon_level(level)\n    if n == {{\n        \"debug\" -> 10\n        \"info\" -> 20\n        \"warn\" -> 30\n        \"error\" -> 40\n        \"critical\" -> 50\n        \"fatal\" -> 60\n        else -> -1\n    }}\n}}\n\nfn canon_level(level: String) -> String {{\n    n :: ascii_lower(trim(level))\n    if n == {{\n        \"warning\" -> return \"warn\"\n        \"err\" -> return \"error\"\n        \"crit\" -> return \"critical\"\n        \"debug\" | \"info\" | \"warn\" | \"error\" | \"critical\" | \"fatal\" -> return n\n        else -> \"\"\n    }}\n}}\n\nfn default_level(level: String) -> String {{\n    normalized :: canon_level(level)\n    if normalized.len() == 0 -> return \"info\"\n    normalized\n}}\n\nfn canon_mode(mode: String) -> String {{\n    normalized :: ascii_lower(trim(mode))\n    if normalized == \"text\" -> return \"text\"\n    \"json\"\n}}\n\nfn escape(text: String) -> String {{\n    out := [U8]{{}}\n    loop b in text.bytes() {{\n        n :: b\n        if n == 92 {{\n            &out.push(U8{{92}})\n            &out.push(U8{{92}})\n            next\n        }}\n        if n == 34 {{\n            &out.push(U8{{92}})\n            &out.push(U8{{34}})\n            next\n        }}\n        if n == 8 || n == 9 || n == 10 || n == 12 || n == 13 {{\n            &out.push(U8{{92}})\n            if n == {{\n                8 -> &out.push(U8{{98}})\n                9 -> &out.push(U8{{116}})\n                10 -> &out.push(U8{{110}})\n                12 -> &out.push(U8{{102}})\n                13 -> &out.push(U8{{114}})\n                else -> {{ _ := 0 }}\n            }}\n            next\n        }}\n        if n < 32 {{\n            &out.push(U8{{92}})\n            &out.push(U8{{117}})\n            &out.push(U8{{48}})\n            &out.push(U8{{48}})\n            &out.push(hex_digit(n >> 4))\n            &out.push(hex_digit(n & 15))\n            next\n        }}\n        &out.push(b)\n    }}\n    String.from_bytes(out) ?? text\n}}\n\nfn hex_digit(value: Int) -> U8 {{\n    n :: value & 15\n    if n < 10 -> return U8{{48 + n}}\n    U8{{87 + n}}\n}}\nfn trim(text: String) -> String {{\n    raw :: text.bytes()\n    a := 0\n    b := raw.len()\n    loop {{\n        if a >= b -> return \"\"\n        if !is_space(raw[a]) -> break\n        a += 1\n    }}\n    loop {{\n        if b <= a -> return \"\"\n        if !is_space(raw[b - 1]) -> break\n        b -= 1\n    }}\n    out := [U8]{{}}\n    i := a\n    loop {{\n        if i >= b -> return String.from_bytes(out) ?? \"\"\n        &out.push(raw[i])\n        i += 1\n    }}\n}}\n\nfn is_space(b: U8) -> Bool {{\n    n :: b\n    n == 32 || n == 9 || n == 10 || n == 13\n}}\n\nfn split_csv(text: String) -> [String] {{\n    out := [String]{{}}\n    cur := [U8]{{}}\n    loop b in text.bytes() {{\n        if {{\n            b == (U8{{44}}) -> {{\n                &out.push(String.from_bytes(cur) ?? \"\")\n                cur = [U8]{{}}\n            }}\n            else -> &cur.push(b)\n        }}\n    }}\n    &out.push(String.from_bytes(cur) ?? \"\")\n    out\n}}\n\n/// A structured log event shared by formatters and handlers.\npub struct LogRecord {{\n    pub level: String\n    pub message: String\n    pub fields: [LogField]\n}}\n\n/// A deterministic formatter. `text` is human-readable; every other mode is\n/// the canonical JSON line used by `emit`.\npub struct Formatter {{\n    pub mode: String\n}}\n\n/// A level-filtered sink. `handle` applies the threshold before formatting.\npub struct Handler {{\n    pub minimum: String\n    pub mode: String\n}}\n\npub fn record(level: String, message: String, fields: [LogField]) -> LogRecord Never! {{\n    LogRecord{{level: default_level(level), message: message, fields: fields}}\n}}\n\npub fn formatter(mode: String) -> Formatter Never! {{\n    Formatter{{mode: canon_mode(mode)}}\n}}\n\npub fn handler(level: String) -> Handler Never! {{\n    Handler{{minimum: default_level(level), mode: \"json\"}}\n}}\n\npub fn handler_format(target: Handler, mode: String) -> Handler Never! {{\n    Handler{{minimum: default_level(target.minimum), mode: canon_mode(mode)}}\n}}\n\npub fn format(target: Formatter, event: LogRecord) -> String Never! {{\n    mode :: canon_mode(target.mode)\n    if mode == \"text\" -> return render_text(event)\n    render_json(event)\n}}\n\npub fn handle(target: Handler, event: LogRecord) Never! -[Log]> {{\n    minimum :: default_level(target.minimum)\n    if rank(event.level) < rank(minimum) -> return\n    formatter :: Formatter{{mode: canon_mode(target.mode)}}\n    if formatter.mode == \"text\" {{\n        emit(event.level, format(formatter, event), [LogField]{{}})\n    }} else {{\n        emit(event.level, event.message, event.fields)\n    }}\n}}\n\n\nfn render_text(event: LogRecord) -> String {{\n    line := \"{{event.level}}: {{event.message}}\"\n    loop field in event.fields {{\n        value := field.value\n        if field.redacted -> value = \"[redacted]\"\n        line = \"{{line}} {{field.key}}={{value}}\"\n    }}\n    line\n}}\n\nfn render_json(event: LogRecord) -> String {{\n    line := \"{{{{\\\"level\\\":\\\"{{escape(event.level)}}\\\",\\\"msg\\\":\\\"{{escape(event.message)}}\\\"\"\n    loop field in event.fields {{\n        if field.redacted {{\n            line = \"{{line}},\\\"{{escape(field.key)}}\\\":\\\"[redacted]\\\"\"\n        }} else if field.kind == \"int\" || field.kind == \"float\" || field.kind == \"bool\" || field.kind == \"counter\" {{\n            line = \"{{line}},\\\"{{escape(field.key)}}\\\":{{field.value}}\"\n        }} else {{\n            line = \"{{line}},\\\"{{escape(field.key)}}\\\":\\\"{{escape(field.value)}}\\\"\"\n        }}\n    }}\n    line = \"{{line}}}}}}\"\n    line\n}}\n\npub struct Pair {{\n    pub left: String\n    pub right: String\n}}\n\nfn split_once(text: String, sep: String) -> Pair {{\n    hay :: text.bytes()\n    nd :: sep.bytes()\n    if nd.len() == 0 || nd.len() > hay.len() -> return {{left: text, right: \"\"}}\n    loop i in 0..<(hay.len() - nd.len() + 1) {{\n        if matches_at(hay, nd, i) {{\n            return {{left: slice_ascii(hay, 0, i), right: slice_ascii(hay, i + nd.len(), hay.len())}}\n        }}\n    }}\n    {{left: text, right: \"\"}}\n}}\n\nfn matches_at(hay: [U8], needle: [U8], offset: Int) -> Bool {{\n    loop j in 0..<needle.len() {{\n        if hay[offset + j] != needle[j] -> return false\n    }}\n    true\n}}\n\nfn slice_ascii(raw: [U8], start: Int, end: Int) -> String {{\n    out := [U8]{{}}\n    i := start\n    loop {{\n        if i >= end -> return String.from_bytes(out) ?? \"\"\n        &out.push(raw[i])\n        i += 1\n    }}\n}}\n\nfn ascii_lower(text: String) -> String {{\n    out := [U8]{{}}\n    loop b in text.bytes() {{\n        n :: b\n        if n >= 65 && n <= 90 -> &out.push(U8{{n + 32}}) else -> &out.push(b)\n    }}\n    String.from_bytes(out) ?? text\n}}\n\nfn parse_int(text: String) -> Int? {{\n    n := 0\n    any := false\n    loop b in text.bytes() {{\n        d :: b\n        if d < 48 || d > 57 -> return None\n        if n > 922337203685477580 || (n == 922337203685477580 && d > 7) -> return None\n        n = n * 10 + (d - 48)\n        any = true\n    }}\n    if !any -> return None\n    Val(n)\n}}\npub fn add(event: LogRecord, field: LogField) -> LogRecord Never! {{\n    fields := event.fields\n    &fields.push(field)\n    LogRecord{{level: event.level, message: event.message, fields: fields}}\n}}\n\npub fn group(event: LogRecord, prefix: String) -> LogRecord Never! {{\n    fields := [LogField]{{}}\n    loop field in event.fields -> &fields.push(LogField{{key: \"{{prefix}}.{{field.key}}\", value: field.value, kind: field.kind, redacted: field.redacted}})\n    LogRecord{{level: event.level, message: event.message, fields: fields}}\n}}\n\npub fn time(event: LogRecord, timestamp: Int) -> LogRecord Never! {{ add(event, int(\"time\", timestamp)) }}\n\npub fn clear(event: LogRecord) -> LogRecord Never! {{ record(event.level, event.message, [LogField]{{}}) }}\n"}
}

fn foundation_embedded_core_source_54() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.math", alias: "core_math", path: "Core/math/math.jet", owner: "", owned_members: [String]{"abs", "abs_float", "min", "max", "clamp", "is_even", "is_odd", "sign", "isqrt", "gcd", "lcm", "acos", "acosh", "asin", "asinh", "atan", "atan2", "atanh", "cbrt", "ceil", "checked_abs", "checked_add", "checked_div", "checked_mul", "checked_neg", "checked_pow", "checked_rem", "checked_sub", "conj", "copysign", "cos", "cosh", "cot", "degrees", "e", "erf", "erfc", "exp", "exp2", "exp_m1", "expm1", "fabs", "factorial", "float32", "float64", "floor", "fma", "fract", "frexp", "from_bits", "gamma", "hypot", "ilogb", "imag", "infinity", "int_pow", "inv", "is_canonical", "is_finite", "is_inf", "is_integer", "is_nan", "is_normal", "is_signed", "is_subnormal", "is_zero", "isfinite", "isinf", "isnan", "ldexp", "lerp", "lgamma", "ln", "ln_1p", "log", "log10", "log1p", "log2", "logb", "modf", "muladd", "nan", "next_after", "next_down", "next_up", "pi", "pow", "radians", "radix", "real", "round", "saturating_add", "saturating_mul", "saturating_sub", "scaleb", "sign_bit", "significand", "signum", "sin", "sin_cos", "sinh", "sqrt", "tan", "tanh", "tau", "tau_const", "to_bits", "trunc", "truncate", "ulp", "zero", "binomial", "comb", "perm", "gcd_many", "lcm_many", "powmod", "div_mod", "div_rem", "digits", "leading_ones", "trailing_ones", "cmp", "abs_diff", "even", "odd", "xor", "in_range", "sum_int", "prod_int", "prod", "fmod", "remainder", "isclose", "dist", "hypot3", "clamp_float", "min_float", "max_float", "midpoint", "fsum", "sumprod", "random", "fraction", "decimal"}, source: "package {{\n    name: \"core.math\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"Integer math implemented in Jet.\"\n    license: \"MIT\"\n    outputs: {{\n        math: .Library{{ entry: math }}\n    }}\n}}\nuse core as core\nfn round_provider(n: Float) -> Int {{ core.math.round(n) }}\npub fn abs(n: Int) -> Int Never! {{\n    if n < 0 -> return -n\n    n\n}}\n\npub fn abs_float(n: Float) -> Float Never! {{ core.math.fabs(n) }}\n\n\npub fn min(a: Int, b: Int) -> Int Never! {{\n    if a < b -> return a\n    b\n}}\n\npub fn max(a: Int, b: Int) -> Int Never! {{\n    if a > b -> return a\n    b\n}}\n\npub fn clamp(x: Int, lo: Int, hi: Int) -> Int Never! {{\n    lower := lo\n    upper := hi\n    if lower > upper {{\n        swap := lower\n        lower = upper\n        upper = swap\n    }}\n    if x < lower -> return lower\n    if x > upper -> return upper\n    x\n}}\n\npub fn is_even(n: Int) -> Bool Never! {{ n % 2 == 0 }}\npub fn is_odd(n: Int) -> Bool Never! {{ n % 2 != 0 }}\n\npub fn sign(n: Int) -> Int Never! {{\n    if n > 0 -> return 1\n    if n < 0 -> return -1\n    0\n}}\n\npub fn isqrt(n: Int) -> Int? Never! {{\n    if n < 0 -> return None\n    if n < 2 -> return Val(n)\n    lo := 1\n    hi := n\n    ans := 1\n    loop lo <= hi {{\n        mid :: lo + (hi - lo) /% 2\n        // Compare through division so `mid * mid` cannot overflow.\n        if mid > n /% mid {{\n            hi = mid - 1\n        }} else {{\n            ans = mid\n            if mid == n /% mid && n %% mid == 0 -> return Val(mid)\n            lo = mid + 1\n        }}\n    }}\n    Val(ans)\n}}\n\npub fn gcd(a: Int, b: Int) -> Int Never! {{\n    x := abs(a)\n    y := abs(b)\n    loop y != 0 {{\n        next :: x % y\n        x = y\n        y = next\n    }}\n    x\n}}\n\npub fn lcm(a: Int, b: Int) -> Int Never! {{\n    if a == 0 || b == 0 -> return 0\n    abs(a /% gcd(a, b) * b)\n}}\n// Floating-point entry points remain thin Jet APIs over the existing\n// deterministic Core primitives.  Keeping the call qualified is deliberate:\n// inside this source package it selects the primitive Core route rather than\n// recursively calling the source implementation being defined.\npub fn acos(n: Float) -> Float Never! {{ core.math.acos(n) }}\npub fn acosh(n: Float) -> Float Never! {{ core.math.acosh(n) }}\npub fn asin(n: Float) -> Float Never! {{ core.math.asin(n) }}\npub fn asinh(n: Float) -> Float Never! {{ core.math.asinh(n) }}\npub fn atan(n: Float) -> Float Never! {{ core.math.atan(n) }}\npub fn atan2(a: Float, b: Float) -> Float Never! {{ core.math.atan2(a, b) }}\npub fn atanh(n: Float) -> Float Never! {{ core.math.atanh(n) }}\npub fn cbrt(n: Float) -> Float Never! {{ core.math.cbrt(n) }}\npub fn cos(n: Float) -> Float Never! {{ core.math.cos(n) }}\npub fn cosh(n: Float) -> Float Never! {{ core.math.cosh(n) }}\npub fn exp(n: Float) -> Float Never! {{ core.math.exp(n) }}\npub fn exp2(n: Float) -> Float Never! {{ core.math.exp2(n) }}\npub fn exp_m1(n: Float) -> Float Never! {{ core.math.exp_m1(n) }}\npub fn expm1(n: Float) -> Float Never! {{ exp_m1(n) }}\npub fn erf(n: Float) -> Float Never! {{ core.math.erf(n) }}\npub fn erfc(n: Float) -> Float Never! {{ core.math.erfc(n) }}\npub fn floor(n: Float) -> Float Never! {{ core.math.floor(n) }}\npub fn ceil(n: Float) -> Float Never! {{ core.math.ceil(n) }}\npub fn fract(n: Float) -> Float Never! {{ core.math.fract(n) }}\npub fn gamma(n: Float) -> Float Never! {{ core.math.gamma(n) }}\npub fn lgamma(n: Float) -> Float Never! {{ core.math.lgamma(n) }}\npub fn hypot(a: Float, b: Float) -> Float Never! {{ core.math.hypot(a, b) }}\npub fn ln(n: Float) -> Float Never! {{ core.math.ln(n) }}\npub fn ln_1p(n: Float) -> Float Never! {{ core.math.ln_1p(n) }}\npub fn log1p(n: Float) -> Float Never! {{ ln_1p(n) }}\npub fn log(n: Float, base: Float) -> Float Never! {{ core.math.log(n, base) }}\npub fn log10(n: Float) -> Float Never! {{ core.math.log10(n) }}\npub fn log2(n: Float) -> Float Never! {{ core.math.log2(n) }}\npub fn logb(n: Float) -> Float Never! {{ core.math.logb(n) }}\npub fn pow(a: Float, b: Float) -> Float Never! {{ core.math.pow(a, b) }}\npub fn sin(n: Float) -> Float Never! {{ core.math.sin(n) }}\npub fn sinh(n: Float) -> Float Never! {{ core.math.sinh(n) }}\npub fn sqrt(n: Float) -> Float Never! {{ core.math.sqrt(n) }}\npub fn tan(n: Float) -> Float Never! {{ core.math.tan(n) }}\npub fn tanh(n: Float) -> Float Never! {{ core.math.tanh(n) }}\npub fn trunc(n: Float) -> Float Never! {{ core.math.trunc(n) }}\npub fn truncate(n: Float) -> Float Never! {{ trunc(n) }}\n\npub fn cot(n: Float) -> Float Never! {{ core.math.cot(n) }}\npub fn copysign(value: Float, sign_value: Float) -> Float Never! {{\n    core.math.copysign(value, sign_value)\n}}\npub fn fma(a: Float, b: Float, c: Float) -> Float Never! {{ core.math.fma(a, b, c) }}\npub fn muladd(a: Float, b: Float, c: Float) -> Float Never! {{ fma(a, b, c) }}\npub fn inv(n: Float) -> Float Never! {{ core.math.inv(n) }}\npub fn signum(n: Float) -> Float Never! {{ core.math.signum(n) }}\npub fn degrees(n: Float) -> Float Never! {{ core.math.degrees(n) }}\npub fn radians(n: Float) -> Float Never! {{ core.math.radians(n) }}\npub fn lerp(a: Float, b: Float, t: Float) -> Float Never! {{ core.math.lerp(a, b, t) }}\npub fn float32(n: Float) -> Float Never! {{ core.math.float32(n) }}\npub fn float64(n: Float) -> Float Never! {{ core.math.float64(n) }}\npub fn fabs(n: Float) -> Float Never! {{ core.math.fabs(n) }}\npub fn real(n: Float) -> Float Never! {{ n }}\npub fn imag(n: Float) -> Float Never! {{ Float{{0.0}} }}\npub fn conj(n: Float) -> Float Never! {{ n }}\n\npub fn is_nan(n: Float) -> Bool Never! {{ core.math.is_nan(n) }}\npub fn is_inf(n: Float) -> Bool Never! {{ core.math.is_inf(n) }}\npub fn is_finite(n: Float) -> Bool Never! {{ core.math.is_finite(n) }}\npub fn isnan(n: Float) -> Bool Never! {{ is_nan(n) }}\npub fn isinf(n: Float) -> Bool Never! {{ is_inf(n) }}\npub fn isfinite(n: Float) -> Bool Never! {{ is_finite(n) }}\npub fn is_normal(n: Float) -> Bool Never! {{ core.math.is_normal(n) }}\npub fn is_subnormal(n: Float) -> Bool Never! {{ core.math.is_subnormal(n) }}\npub fn is_canonical(n: Float) -> Bool Never! {{ core.math.is_canonical(n) }}\npub fn is_signed(n: Float) -> Bool Never! {{ core.math.is_signed(n) }}\npub fn is_zero(n: Float) -> Bool Never! {{ core.math.is_zero(n) }}\npub fn is_integer(n: Float) -> Bool Never! {{ core.math.is_integer(n) }}\npub fn sign_bit(n: Float) -> Bool Never! {{ core.math.sign_bit(n) }}\n\npub fn next_up(n: Float) -> Float Never! {{ core.math.next_up(n) }}\npub fn next_down(n: Float) -> Float Never! {{ core.math.next_down(n) }}\npub fn next_after(n: Float, toward: Float) -> Float Never! {{\n    core.math.next_after(n, toward)\n}}\npub fn nextafter(n: Float, toward: Float) -> Float Never! {{ next_after(n, toward) }}\npub fn significand(n: Float) -> Float Never! {{ core.math.significand(n) }}\npub fn ulp(n: Float) -> Float Never! {{ core.math.ulp(n) }}\npub fn ilogb(n: Float) -> Int? Never! {{ core.math.ilogb(n) }}\npub fn ldexp(n: Float, exponent: Int) -> Float Never! {{ core.math.ldexp(n, exponent) }}\npub fn scaleb(n: Float, exponent: Int) -> Float Never! {{ ldexp(n, exponent) }}\npub fn radix(n: Float) -> Int Never! {{ core.math.radix(n) }}\n\npub fn pi() -> Float Never! {{ Float{{3.14159265358979323846264338327950288}} }}\npub fn e() -> Float Never! {{ Float{{2.7182818284590452354}} }}\npub fn tau() -> Float Never! {{ Float{{6.2831853071795864769}} }}\npub fn tau_const() -> Float Never! {{ tau() }}\npub fn infinity() -> Float Never! {{ (Float{{1.0}}) / (Float{{0.0}}) }}\npub fn nan() -> Float Never! {{ (Float{{0.0}}) / (Float{{0.0}}) }}\npub fn zero() -> Float Never! {{ Float{{0.0}} }}\n\npub fn round(n: Float) -> Int Never! {{ round_provider(n) }}\npub fn to_bits(n: Float) -> Int Never! {{ core.math.to_bits(n) }}\npub fn from_bits(bits: Int) -> Float Never! {{ core.math.from_bits(bits) }}\npub fn sin_cos(n: Float) -> (cos: Float, sin: Float) Never! {{\n    pair :: core.math.sin_cos(n)\n    (cos: pair.cos, sin: pair.sin)\n}}\npub fn modf(n: Float) -> (fract: Float, whole: Float) Never! {{\n    core.math.modf(n)\n}}\npub fn frexp(n: Float) -> (exp: Int, frac: Float) Never! {{\n    pair :: core.math.frexp(n)\n    (exp: pair.exp, frac: pair.frac)\n}}\n\npub fn checked_abs(n: Int) -> Int? Never! {{\n    if n < 0 -> return Val(0 - n)\n    Val(n)\n}}\n\npub fn checked_neg(n: Int) -> Int? Never! {{ Val(0 - n) }}\n\npub fn checked_add(a: Int, b: Int) -> Int? Never! {{ Val(a + b) }}\n\npub fn checked_sub(a: Int, b: Int) -> Int? Never! {{ Val(a - b) }}\n\npub fn checked_mul(a: Int, b: Int) -> Int? Never! {{ Val(a * b) }}\n\npub fn checked_div(a: Int, b: Int) -> Int? Never! {{\n    if b == 0 -> return None\n    remainder :: a %% b\n    Val((a - remainder) /% b)\n}}\n\npub fn checked_rem(a: Int, b: Int) -> Int? Never! {{\n    if b == 0 -> return None\n    Val(a %% b)\n}}\n\npub fn checked_pow(base: Int, exponent: Int) -> Int? Never! {{\n    if exponent < 0 -> return None\n    result := 1\n    factor := base\n    power := exponent\n    loop power > 0 {{\n        if (power & 1) != 0 {{\n            result = checked_mul(result, factor) ?? return None\n        }}\n        power = power /% 2\n        if power > 0 -> factor = checked_mul(factor, factor) ?? return None\n    }}\n    Val(result)\n}}\n\npub fn int_pow(base: Int, exponent: Int) -> Int Never! {{\n    if exponent < 0 -> return 0\n    result := 1\n    factor := base\n    power := exponent\n    loop power > 0 {{\n        if (power & 1) != 0 {{\n            result = result * factor\n        }}\n        power = power /% 2\n        if power > 0 -> factor = factor * factor\n    }}\n    result\n}}\n\npub fn saturating_add(a: Int, b: Int) -> Int Never! {{ a + b }}\n\npub fn saturating_sub(a: Int, b: Int) -> Int Never! {{ a - b }}\n\npub fn saturating_mul(a: Int, b: Int) -> Int Never! {{ a * b }}\n\npub fn factorial(n: Int) -> Int? Never! {{\n    if n < 0 -> return None\n    acc := 1\n    i := 2\n    loop i <= n {{\n        acc = checked_mul(acc, i) ?? return None\n        i = i + 1\n    }}\n    Val(acc)\n}}\n\npub fn binomial(n: Int, k: Int) -> Int? Never! {{\n    if n < 0 || k < 0 || k > n -> return None\n    choose_k := k\n    if choose_k > n - choose_k -> choose_k = n - choose_k\n    acc := 1\n    i := 1\n    loop i <= choose_k {{\n        factor :: n - choose_k + i\n        acc = checked_mul(acc, factor) ?? return None\n        acc = acc /% i\n        i = i + 1\n    }}\n    Val(acc)\n}}\n\npub fn comb(n: Int, k: Int) -> Int? Never! {{ binomial(n, k) }}\n\npub fn perm(n: Int, k: Int) -> Int? Never! {{\n    if n < 0 || k < 0 || k > n -> return None\n    acc := 1\n    i := 0\n    loop i < k {{\n        acc = checked_mul(acc, n - i) ?? return None\n        i = i + 1\n    }}\n    Val(acc)\n}}\n\npub fn gcd_many(values: [Int]) -> Int Never! {{\n    acc := 0\n    loop value in values -> acc = gcd(acc, value)\n    acc\n}}\n\npub fn lcm_many(values: [Int]) -> Int Never! {{\n    if values.len() == 0 -> return 0\n    acc := values[0]\n    i := 1\n    loop i < values.len() {{\n        acc = lcm(acc, values[i])\n        i = i + 1\n    }}\n    acc\n}}\n\npub fn powmod(base: Int, exponent: Int, modulus: Int) -> Int? Never! {{\n    if modulus <= 0 || exponent < 0 -> return None\n    result := 1 %% modulus\n    factor := base %% modulus\n    if factor < 0 -> factor = factor + modulus\n    power := exponent\n    loop power > 0 {{\n        if (power & 1) != 0 {{\n            product :: checked_mul(result, factor) ?? return None\n            result = product %% modulus\n        }}\n        power = power /% 2\n        square :: checked_mul(factor, factor) ?? return None\n        factor = square %% modulus\n    }}\n    Val(result)\n}}\n\npub fn div_mod(a: Int, b: Int) -> (quot: Int, rem: Int) Never! {{\n    rem := a %% b\n    if rem < 0 {{\n        if b > 0 -> rem = rem + b\n        if b < 0 -> rem = rem - b\n    }}\n    (quot: (a - rem) /% b, rem: rem)\n}}\n\npub fn div_rem(a: Int, b: Int) -> (quot: Int, rem: Int) Never! {{\n    rem :: a %% b\n    (quot: (a - rem) /% b, rem: rem)\n}}\n\npub fn digits(n: Int) -> Int Never! {{ core.math.digits(n) }}\npub fn leading_ones(n: Int) -> Int Never! {{ core.math.leading_ones(n) }}\npub fn trailing_ones(n: Int) -> Int Never! {{ core.math.trailing_ones(n) }}\npub fn cmp(a: Float, b: Float) -> Int Never! {{ core.math.cmp(a, b) }}\n\npub fn abs_diff(a: Int, b: Int) -> Int Never! {{\n    if a >= b -> return a - b\n    b - a\n}}\n\npub fn even(n: Int) -> Bool Never! {{ is_even(n) }}\npub fn odd(n: Int) -> Bool Never! {{ is_odd(n) }}\npub fn xor(a: Int, b: Int) -> Int Never! {{ core.math.xor(a, b) }}\npub fn in_range(value: Int, low: Int, high: Int) -> Bool Never! {{\n    value >= low && value < high\n}}\n\npub fn sum_int(values: [Int]) -> Int Never! {{\n    acc := 0\n    loop value in values -> acc = saturating_add(acc, value)\n    acc\n}}\n\npub fn prod_int(values: [Int]) -> Int Never! {{\n    acc := 1\n    loop value in values -> acc = saturating_mul(acc, value)\n    acc\n}}\n\npub fn prod(values: [Int]) -> Int Never! {{ prod_int(values) }}\npub fn fmod(a: Float, b: Float) -> Float Never! {{ core.math.fmod(a, b) }}\npub fn remainder(a: Float, b: Float) -> Float Never! {{ core.math.remainder(a, b) }}\npub fn isclose(a: Float, b: Float, rel_tol: Float, abs_tol: Float) -> Bool Never! {{\n    core.math.isclose(a, b, rel_tol, abs_tol)\n}}\n\npub fn dist(left: [Float], right: [Float]) -> Float Never! {{\n    core.math.dist(left, right)\n}}\n\npub fn hypot3(a: Float, b: Float, c: Float) -> Float Never! {{\n    core.math.hypot3(a, b, c)\n}}\n\npub fn clamp_float(value: Float, low: Float, high: Float) -> Float Never! {{\n    core.math.clamp_float(value, low, high)\n}}\n\npub fn min_float(a: Float, b: Float) -> Float Never! {{ core.math.min_float(a, b) }}\npub fn max_float(a: Float, b: Float) -> Float Never! {{ core.math.max_float(a, b) }}\npub fn midpoint(a: Float, b: Float) -> Float Never! {{ core.math.midpoint(a, b) }}\n\npub fn fsum(values: [Float]) -> Float Never! {{\n    total := Float{{0.0}}\n    compensation := Float{{0.0}}\n    loop value in values {{\n        corrected :: value - compensation\n        next_total :: total + corrected\n        compensation = (next_total - total) - corrected\n        total = next_total\n    }}\n    total\n}}\n\npub fn sumprod(left: [Float], right: [Float]) -> Float Never! {{\n    total := Float{{0.0}}\n    n := left.len()\n    if right.len() < n -> n = right.len()\n    loop i in 0..<n -> total = total + left[i] * right[i]\n    total\n}}\n\npub fn random() -> Float Never! {{ core.math.random() }}\n\npub fn fraction(numerator: Int, denominator: Int) -> Fraction? Never! {{\n    core.math.fraction(numerator, denominator)\n}}\n\npub fn decimal(text: String) -> Decimal Never! {{\n    core.math.decimal(text)\n}}\n"}
