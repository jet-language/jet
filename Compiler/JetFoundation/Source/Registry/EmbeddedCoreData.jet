fn foundation_embedded_core_source_55() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.math.random", alias: "core_core_math_random", path: "Core/math/random.jet", owner: "", owned_members: [String]{"betavariate", "binomialvariate", "bool", "bytes", "choice", "choices", "exponential", "expovariate", "float", "float_range", "gammavariate", "gauss", "getrandbits", "int", "lognormvariate", "normal", "normalvariate", "paretovariate", "pick", "randbytes", "randint", "random", "randrange", "rng", "sample", "seed", "shuffle", "split", "triangular", "uniform", "vonmisesvariate", "weibullvariate", "weighted_pick"}, source: "// core.math.random — deterministic, seedable RNG for simulations and tests.\n//\n// This is not a CSPRNG. `core.crypto.random` is the fail-closed OS generator.\n// Every ambient draw carries `Rand`; seeding the same stream and replaying the\n// same calls produces the same values on every tier. Invalid scalar parameters\n// retain the existing infallible API contract: bounded draws return their\n// lower bound and distributions return their documented degenerate value.\n// Empty collections return `None` (or an empty collection) without advancing\n// the stream.\nuse core.math as math\nuse core as core\nfn nonfinite(value: Float) -> Bool Never! {{\n    if math.is_finite(value) -> return false\n    true\n}}\n\n\nC_MASK32 :: 4294967295\nC_BASE32 :: 4294967296\nC_MASK63 :: 9223372036854775807\nC_BASE63 :: 9223372036854775808\nC_BASE53_FLOAT :: 9007199254740992.0\n\n// Draw one non-negative 63-bit word from the shared deterministic provider.\n// The provider's getrandbits(63) is the only host boundary; all composition,\n// rejection, and distribution logic below is Jet-owned.\nfn next_bits63() -[Rand]> Int Never! {{ core.math.random.getrandbits(63) }}\n\n// A 53-bit draw is exactly representable, so the unit float needs no lossy\n// Int-to-Float crossing.\nfn unit() -[Rand]> Float Never! {{\n    Float{{core.math.random.getrandbits(53)}} / C_BASE53_FLOAT\n}}\n\nfn unit_open() -[Rand]> Float {{\n    u :: unit()\n    if u <= (Float{{0.0}}) -> return (Float{{1.0}}) / C_BASE53_FLOAT\n    u\n}}\n\nfn full_word64() -[Rand]> Int Never! {{\n    hi :: next_bits63() & C_MASK32\n    lo :: next_bits63() & C_MASK32\n    (hi * C_BASE32) + lo\n}}\n\n// Unbiased offset in 0..<span. Rejection over base-2^63 digits covers every\n// representable range without modulo bias.\nfn bounded(span: Int) -[Rand]> Int Never! {{\n    if span <= 1 -> return 0\n    if span <= C_BASE63 {{\n        limit :: C_BASE63 - (C_BASE63 %% span)\n        loop {{\n            draw :: next_bits63()\n            if draw < limit -> return draw %% span\n        }}\n    }}\n    space := C_BASE63\n    loop space < span -> space = space * C_BASE63\n    limit :: space - (space %% span)\n    loop {{\n        draw := 0\n        factor := 1\n        loop factor < space {{\n            draw = draw + next_bits63() * factor\n            factor = factor * C_BASE63\n        }}\n        if draw < limit -> return draw %% span\n    }}\n}}\nfn normalize_angle(angle: Float) -> Float Never! {{\n    tau :: math.tau()\n    reduced := math.fmod(angle, tau)\n    if reduced < (Float{{0.0}}) -> return reduced + tau\n    reduced\n}}\n\n\n/// Install `value` as the deterministic stream seed.\npub fn seed(value: Int) Never! -[Rand]> {{\n    core.math.random.seed(value)\n}}\n\n/// Construct a deterministic, caller-owned RNG capability.\npub fn rng(seed_value: Int) -> RNG Never! {{\n    core.math.random.rng(seed_value)\n}}\n\n/// Construct a deterministic child capability from `seed_value` while mixing\n/// one word from the ambient stream. The explicit effect documents that mix.\npub fn split(seed_value: Int) -[Rand]> RNG Never! {{\n    core.math.random.split(seed_value)\n}}\n\n/// Inclusive integer range. An empty range (`lo > hi`) returns `lo` and does\n/// not consume the stream.\npub fn int(lo: Int, hi: Int) -[Rand]> Int Never! {{\n    if lo >= hi -> return lo\n    span :: hi - lo + 1\n    if span <= 0 {{\n        // The only overflowing inclusive width is the complete signed domain.\n        return lo + full_word64()\n    }}\n    lo + bounded(span)\n}}\n\n/// Uniform in `[0, 1)`, using the full precision available from 63 source bits.\npub fn float() -[Rand]> Float Never! {{ unit() }}\n\n/// Uniform in `[lo, hi)`. Invalid or reversed bounds return `lo` without a draw.\npub fn float_range(lo: Float, hi: Float) -[Rand]> Float Never! {{\n    if nonfinite(lo) || nonfinite(hi) || hi <= lo -> return lo\n    u :: unit()\n    if lo >= (Float{{0.0}}) || hi <= (Float{{0.0}}) -> return lo + (hi - lo) * u\n    negative := -lo\n    positive := hi\n    if positive >= negative {{\n        probability :: (Float{{1.0}}) / ((Float{{1.0}}) + negative / positive)\n        if u < probability -> return positive * (u / probability)\n        return lo * ((u - probability) / ((Float{{1.0}}) - probability))\n    }}\n    ratio :: positive / negative\n    probability :: ratio / ((Float{{1.0}}) + ratio)\n    if u < probability -> return positive * (u / probability)\n    lo * ((u - probability) / ((Float{{1.0}}) - probability))\n}}\n\npub fn bool() -[Rand]> Bool Never! {{ (next_bits63() % 2) == 1 }}\n\n/// Seeded pseudo-random bytes. Negative lengths are an empty request.\npub fn bytes(n: Int) -[Rand]> [U8] Never! {{\n    out := [U8]{{}}\n    if n <= 0 -> return ~out\n    loop {{\n        if out.len() >= n -> return ~out\n        word :: full_word64()\n        loop k in 0..<8 {{\n            if out.len() >= n -> return ~out\n            &out.push(to_u8(word >> (k * 8)))\n        }}\n    }}\n}}\n\npub fn pick(items: [String]) -[Rand]> String? Never! {{\n    if items.len() == 0 -> return None\n    Val(items[int(0, items.len() - 1)])\n}}\n\n/// Weighted selection. Length mismatches, negative/non-finite weights, and a\n/// zero total are absent. Zero weights remain valid and are never selected.\npub fn weighted_pick(items: [String], weights: [Float]) -[Rand]> String? Never! {{\n    if items.len() == 0 || items.len() != weights.len() -> return None\n    maximum := Float{{0.0}}\n    loop w in weights {{\n        if nonfinite(w) || w < (Float{{0.0}}) -> return None\n        if w > maximum -> maximum = w\n    }}\n    if maximum <= (Float{{0.0}}) -> return None\n    total := Float{{0.0}}\n    loop w in weights -> total = total + w / maximum\n    if nonfinite(total) || total <= (Float{{0.0}}) -> return None\n    draw :: unit() * total\n    acc := Float{{0.0}}\n    last := -1\n    loop i in 0..<items.len() {{\n        w :: weights[i]\n        if w <= (Float{{0.0}}) -> next\n        scaled :: w / maximum\n        acc = acc + scaled\n        last = i\n        if draw < acc -> return Val(items[i])\n    }}\n    if last < 0 -> return None\n    Val(items[last])\n}}\n\n/// Fisher–Yates. Mutates `items` in place.\npub fn shuffle(items: &[Int]) Never! -[Rand]> {{\n    n :: items.len()\n    if n < 2 -> return\n    i := n - 1\n    loop i > 0 {{\n        j :: int(0, i)\n        tmp :: Int{{items[i]}}\n        items[i] = items[j]\n        items[j] = tmp\n        i = i - 1\n    }}\n}}\n\n/// Uniform sample without replacement. The source is copied once and only the\n/// requested prefix is shuffled, so asking for a small sample is O(n) memory\n/// and O(k) draws.\npub fn sample(items: [Int], n: Int) -[Rand]> [Int] Never! {{\n    out := [Int]{{}}\n    if n <= 0 || items.len() == 0 -> return out\n    pool := [Int]{{}}\n    loop x in items -> &pool.push(x)\n    want := n\n    if want > pool.len() -> want = pool.len()\n    i := 0\n    loop i < want {{\n        j :: int(i, pool.len() - 1)\n        tmp :: Int{{pool[i]}}\n        pool[i] = pool[j]\n        pool[j] = tmp\n        &out.push(pool[i])\n        i = i + 1\n    }}\n    out\n}}\n\n/// Box–Muller normal draw. Invalid parameters return a finite degenerate value.\npub fn normal(mean: Float, stddev: Float) -[Rand]> Float Never! {{\n    if nonfinite(mean) -> return (Float{{0.0}})\n    if nonfinite(stddev) || stddev <= (Float{{0.0}}) -> return mean\n    u1 :: unit_open()\n    u2 :: unit()\n    mean + stddev * math.sqrt((Float{{-2.0}}) * math.ln(u1)) * math.cos(math.tau() * u2)\n}}\n\npub fn exponential(lambda: Float) -[Rand]> Float Never! {{\n    if nonfinite(lambda) || lambda <= (Float{{0.0}}) -> return (Float{{0.0}})\n    return -math.ln(unit_open()) / lambda\n}}\n\n/// Python `random` spellings over the same deterministic stream.\npub fn random() -[Rand]> Float Never! {{ float() }}\npub fn randint(lo: Int, hi: Int) -[Rand]> Int Never! {{ int(lo, hi) }}\npub fn uniform(lo: Float, hi: Float) -[Rand]> Float Never! {{ float_range(lo, hi) }}\npub fn normalvariate(mean: Float, stddev: Float) -[Rand]> Float Never! {{ normal(mean, stddev) }}\npub fn gauss(mean: Float, stddev: Float) -[Rand]> Float Never! {{ normal(mean, stddev) }}\npub fn expovariate(lambda: Float) -[Rand]> Float Never! {{ exponential(lambda) }}\npub fn randbytes(n: Int) -[Rand]> [U8] Never! {{ bytes(n) }}\n\n/// Draw `k` low-order random bits. Non-positive widths return zero.\npub fn getrandbits(k: Int) -[Rand]> Int Never! {{\n    if k <= 0 -> return 0\n    out := 0\n    remaining := k\n    loop remaining > 0 {{\n        chunk := remaining\n        if chunk > 63 -> chunk = 63\n        out = (out << chunk) ~| (next_bits63() & ((1 << chunk) - 1))\n        remaining = remaining - chunk\n    }}\n    out\n}}\n\npub fn randrange(start: Int, stop: Int) -[Rand]> Int Never! {{\n    if stop <= start -> return start\n    int(start, stop - 1)\n}}\n\npub fn choice(items: [Int]) -[Rand]> Int? Never! {{\n    if items.len() == 0 -> return None\n    Val(items[int(0, items.len() - 1)])\n}}\n\npub fn choices(items: [Int], n: Int) -[Rand]> [Int] Never! {{\n    out := [Int]{{}}\n    if items.len() == 0 || n <= 0 -> return out\n    loop _ in 0..<n {{\n        value :: choice(items) ?? return out\n        &out.push(value)\n    }}\n    out\n}}\n\npub fn triangular(low: Float, high: Float, mode: Float) -[Rand]> Float Never! {{\n    if nonfinite(low) || nonfinite(high) -> return (Float{{0.0}})\n    if high <= low -> return low\n    peak := mode\n    if peak != peak || nonfinite(peak) -> peak = low / (Float{{2.0}}) + high / (Float{{2.0}})\n    if peak < low -> peak = low\n    if peak > high -> peak = high\n    scale := math.fabs(low)\n    if math.fabs(high) > scale -> scale = math.fabs(high)\n    if scale <= (Float{{0.0}}) -> return low\n    lower :: low / scale\n    upper :: high / scale\n    apex :: peak / scale\n    u :: unit()\n    cut :: (apex - lower) / (upper - lower)\n    if u <= cut -> return (lower + math.sqrt(u * (upper - lower) * (apex - lower))) * scale\n    (upper - math.sqrt(((Float{{1.0}}) - u) * (upper - lower) * (upper - apex))) * scale\n}}\n\npub fn gammavariate(alpha: Float, beta: Float) -[Rand]> Float Never! {{\n    one :: Float{{1.0}}\n    three :: Float{{3.0}}\n    zero :: Float{{0.0}}\n    nine :: Float{{9.0}}\n    half :: Float{{0.5}}\n    epsilon :: Float{{0.0331}}\n    if nonfinite(alpha) || nonfinite(beta) || alpha <= zero || beta <= zero -> return zero\n    if alpha < one {{\n        return gammavariate(alpha + one, beta) * math.exp(math.ln(unit_open()) / alpha)\n    }}\n    d :: alpha - one / three\n    c :: one / math.sqrt(nine * d)\n    loop {{\n        x :: normal(zero, one)\n        v0 :: one + c * x\n        if v0 <= zero -> next\n        sample_scale :: v0 * v0 * v0\n        u :: unit_open()\n        if u < one - epsilon * x * x * x * x -> return beta * d * sample_scale\n        if math.ln(u) < half * x * x + d * (one - sample_scale + math.ln(sample_scale)) {{\n            return beta * d * sample_scale\n        }}\n    }}\n}}\n\npub fn betavariate(alpha: Float, beta: Float) -[Rand]> Float Never! {{\n    if nonfinite(alpha) || nonfinite(beta) || alpha <= (Float{{0.0}}) || beta <= (Float{{0.0}}) {{\n        return (Float{{0.0}})\n    }}\n    a :: gammavariate(alpha, (Float{{1.0}}))\n    b :: gammavariate(beta, (Float{{1.0}}))\n    scale := a\n    if b > scale -> scale = b\n    if scale <= (Float{{0.0}}) || nonfinite(scale) -> return (Float{{0.0}})\n    an :: a / scale\n    bn :: b / scale\n    if an + bn <= (Float{{0.0}}) -> return (Float{{0.0}})\n    an / (an + bn)\n}}\n\npub fn lognormvariate(mean: Float, sigma: Float) -[Rand]> Float Never! {{\n    if nonfinite(mean) || nonfinite(sigma) -> return (Float{{0.0}})\n    math.exp(normal(mean, sigma))\n}}\n\npub fn paretovariate(alpha: Float) -[Rand]> Float Never! {{\n    if nonfinite(alpha) || alpha <= (Float{{0.0}}) -> return (Float{{0.0}})\n    math.exp(-math.ln(unit_open()) / alpha)\n}}\n\npub fn weibullvariate(alpha: Float, beta: Float) -[Rand]> Float Never! {{\n    if nonfinite(alpha) || nonfinite(beta) || alpha <= (Float{{0.0}}) || beta <= (Float{{0.0}}) {{\n        return (Float{{0.0}})\n    }}\n    alpha * math.exp(math.ln(-math.ln(unit_open())) / beta)\n}}\n\npub fn vonmisesvariate(mu: Float, kappa: Float) -[Rand]> Float Never! {{\n    if mu != mu || nonfinite(mu) -> return (Float{{0.0}})\n    if kappa != kappa || nonfinite(kappa) || kappa < (Float{{0.0}}) -> return normalize_angle(mu)\n    if kappa <= (Float{{0.00000001}}) {{\n        return normalize_angle(mu + math.tau() * ((Float{{2.0}}) * unit() - (Float{{1.0}})))\n    }}\n    s :: (Float{{0.5}}) / kappa\n    r :: s + math.sqrt((Float{{1.0}}) + s * s)\n    loop {{\n        u1 :: unit()\n        z :: math.cos(math.pi() * u1)\n        f :: ((Float{{1.0}}) + r * z) / (r + z)\n        c :: kappa * (r - f)\n        u2 :: unit()\n        if u2 >= c * ((Float{{2.0}}) - c) && u2 > c * math.exp((Float{{1.0}}) - c) -> next\n        angle := mu\n        if unit() > (Float{{0.5}}) -> angle = angle + math.acos(f) else -> angle = angle - math.acos(f)\n        return normalize_angle(angle)\n    }}\n}}\n\npub fn binomialvariate(n: Int, p: Float) -[Rand]> Int Never! {{\n    if n <= 0 || nonfinite(p) || p <= (Float{{0.0}}) -> return 0\n    if p >= (Float{{1.0}}) -> return n\n    successes := 0\n    loop _ in 0..<n {{\n        if unit() < p -> successes += 1\n    }}\n    successes\n}}\n\n/// Low byte of `n`. The mask runs in `Int`, so a wide value never reaches the\n/// checked `U8{{}}` conversion.\nfn to_u8(n: Int) -> U8 Never! {{\n    v :: n & 255\n    (U8{{v}})\n}}\n"}
}

fn foundation_embedded_core_source_56() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.math.combinatorics", alias: "core_core_math_combinatorics", path: "Core/math/combinatorics.jet", owner: "", owned_members: [String]{"batched", "binomial", "cartesian", "chain", "chain_from", "combinations", "combinations_count", "combinations_with_replacement", "compress", "count_from", "drop", "dropwhile", "factorial", "falling_factorial", "multinomial", "ncr", "npr", "pairwise", "permutations", "permutations_count", "product", "repeat", "rising_factorial", "takewhile", "unique", "take_n", "count", "filterfalse", "islice", "groupby", "starmap", "tee", "cycle", "zip_longest", "accumulate", "powerset", "windows", "reverse", "flatten"}, source: "use core.math as math\n\n// core.math.combinatorics — counting, ranking, and generation.\n//\n// `permutations` / `combinations` / `product` materialise the full\n// collection (Python `itertools` without lazy iterators). Counts use\n// exact `Int`. Generation is return-based so array values stay consistent.\npub fn factorial(n: Int) -> Int? Never! {{ math.factorial(n) }}\n\npub fn binomial(n: Int, k: Int) -> Int? Never! {{ math.binomial(n, k) }}\n\npub fn permutations_count(n: Int, k: Int) -> Int? Never! {{\n    if n < 0 || k < 0 || k > n -> return None\n    math.perm(n, k)\n}}\n\npub fn combinations_count(n: Int, k: Int) -> Int? Never! {{ math.binomial(n, k) }}\n\npub fn permutations(items: [Int], k: Int) -> [[Int]] Never! {{\n    n :: items.len()\n    if k < 0 || k > n -> return [[Int]]{{}}\n    used := [Bool]{{}}\n    loop i in 0..<n -> &used.push(false)\n    perm_rec(items, k, used, [Int]{{}})\n}}\n\npub fn combinations(items: [Int], k: Int) -> [[Int]] Never! {{\n    n :: items.len()\n    if k < 0 || k > n -> return [[Int]]{{}}\n    comb_rec(items, k, 0, [Int]{{}})\n}}\n\npub fn combinations_with_replacement(items: [Int], k: Int) -> [[Int]] Never! {{\n    if k < 0 -> return [[Int]]{{}}\n    comb_rep_rec(items, k, 0, [Int]{{}})\n}}\n\npub fn product(items: [Int], repeat: Int) -> [[Int]] Never! {{\n    if repeat <= 0 -> return [[Int]]{{[Int]{{}}}}\n    out := [[Int]]{{[Int]{{}}}}\n    r := 0\n    loop r < repeat {{\n        nxt := [[Int]]{{}}\n        loop row in out {{\n            loop x in items {{\n                cloned := [Int]{{}}\n                loop v in row -> &cloned.push(v)\n                &cloned.push(x)\n                &nxt.push(cloned)\n            }}\n        }}\n        out = nxt\n        r = r + 1\n    }}\n    out\n}}\n\npub fn cartesian(left: [Int], right: [Int]) -> [[Int]] Never! {{\n    out := [[Int]]{{}}\n    loop a in left {{\n        loop b in right -> &out.push([Int]{{a, b}})\n    }}\n    out\n}}\n\nfn perm_rec(items: [Int], k: Int, used: [Bool], cur: [Int]) -> [[Int]] {{\n    if cur.len() == k {{\n        cloned := [Int]{{}}\n        loop v in cur -> &cloned.push(v)\n        return [[Int]]{{cloned}}\n    }}\n    out := [[Int]]{{}}\n    i := 0\n    loop i < items.len() {{\n        if used[i] == false {{\n            next_used := [Bool]{{}}\n            loop u in used -> &next_used.push(u)\n            next_used[i] = true\n            next_cur := [Int]{{}}\n            loop v in cur -> &next_cur.push(v)\n            &next_cur.push(items[i])\n            kids :: perm_rec(items, k, next_used, next_cur)\n            loop row in kids -> &out.push(row)\n        }}\n        i = i + 1\n    }}\n    out\n}}\n\nfn comb_rec(items: [Int], k: Int, start: Int, cur: [Int]) -> [[Int]] {{\n    if cur.len() == k {{\n        cloned := [Int]{{}}\n        loop v in cur -> &cloned.push(v)\n        return [[Int]]{{cloned}}\n    }}\n    out := [[Int]]{{}}\n    i := start\n    loop i < items.len() {{\n        next_cur := [Int]{{}}\n        loop v in cur -> &next_cur.push(v)\n        &next_cur.push(items[i])\n        kids :: comb_rec(items, k, i + 1, next_cur)\n        loop row in kids -> &out.push(row)\n        i = i + 1\n    }}\n    out\n}}\n\nfn comb_rep_rec(items: [Int], k: Int, start: Int, cur: [Int]) -> [[Int]] {{\n    if cur.len() == k {{\n        cloned := [Int]{{}}\n        loop v in cur -> &cloned.push(v)\n        return [[Int]]{{cloned}}\n    }}\n    out := [[Int]]{{}}\n    i := start\n    loop i < items.len() {{\n        next_cur := [Int]{{}}\n        loop v in cur -> &next_cur.push(v)\n        &next_cur.push(items[i])\n        kids :: comb_rep_rec(items, k, i, next_cur)\n        loop row in kids -> &out.push(row)\n        i = i + 1\n    }}\n    out\n}}\n\npub fn npr(n: Int, k: Int) -> Int? Never! {{ permutations_count(n, k) }}\n\npub fn ncr(n: Int, k: Int) -> Int? Never! {{ combinations_count(n, k) }}\n\npub fn multinomial(parts: [Int]) -> Int? Never! {{\n    n := 0\n    loop p in parts {{\n        if p < 0 -> return None\n        n = n + p\n    }}\n    acc := 1\n    loop p in parts {{\n        c :: math.binomial(n, p) ?? return None\n        acc = acc * c\n        n = n - p\n    }}\n    Val(acc)\n}}\n\npub fn falling_factorial(n: Int, k: Int) -> Int? Never! {{ permutations_count(n, k) }}\n\npub fn rising_factorial(n: Int, k: Int) -> Int? Never! {{\n    if k < 0 -> return None\n    acc := 1\n    i := 0\n    loop i < k {{\n        acc = acc * (n + i)\n        i = i + 1\n    }}\n    Val(acc)\n}}\n\npub fn pairwise(items: [Int]) -> [[Int]] Never! {{\n    out := [[Int]]{{}}\n    if items.len() < 2 -> return out\n    i := 0\n    loop i < items.len() - 1 {{\n        &out.push([Int]{{items[i], items[i + 1]}})\n        i = i + 1\n    }}\n    out\n}}\n\npub fn batched(items: [Int], n: Int) -> [[Int]] Never! {{\n    out := [[Int]]{{}}\n    if n <= 0 -> return out\n    batch := [Int]{{}}\n    loop x in items {{\n        &batch.push(x)\n        if batch.len() == n {{\n            &out.push(batch)\n            batch = [Int]{{}}\n        }}\n    }}\n    if batch.len() > 0 -> &out.push(batch)\n    out\n}}\n\npub fn chain(left: [Int], right: [Int]) -> [Int] Never! {{\n    out := [Int]{{}}\n    loop x in left -> &out.push(x)\n    loop x in right -> &out.push(x)\n    out\n}}\n\npub fn chain_from(groups: [[Int]]) -> [Int] Never! {{\n    out := [Int]{{}}\n    loop g in groups {{\n        loop x in g -> &out.push(x)\n    }}\n    out\n}}\n\npub fn compress(items: [Int], mask: [Bool]) -> [Int] Never! {{\n    out := [Int]{{}}\n    i := 0\n    loop i < items.len() {{\n        if i < mask.len() && mask[i] -> &out.push(items[i])\n        i = i + 1\n    }}\n    out\n}}\n\npub fn drop(items: [Int], n: Int) -> [Int] Never! {{\n    out := [Int]{{}}\n    skip := n\n    if skip < 0 -> skip = 0\n    i := 0\n    loop i < items.len() {{\n        if i >= skip -> &out.push(items[i])\n        i = i + 1\n    }}\n    out\n}}\npub fn take_n(items: [Int], n: Int) -> [Int] Never! {{\n    out := [Int]{{}}\n    if n <= 0 -> return out\n    limit := n\n    if limit > items.len() -> limit = items.len()\n    loop i in 0..<limit -> &out.push(items[i])\n    out\n}}\n// `take` is retired because it is a Jet keyword; use `take_n`.\n\n\npub fn takewhile(items: [Int], pred_nonneg: Bool) -> [Int] Never! {{\n    out := [Int]{{}}\n    loop x in items {{\n        ok := x >= 0\n        if {{\n            pred_nonneg && ok == false -> return ~out\n            pred_nonneg == false && ok -> return ~out\n        }}\n        &out.push(x)\n    }}\n    out\n}}\n\npub fn dropwhile(items: [Int], pred_nonneg: Bool) -> [Int] Never! {{\n    out := [Int]{{}}\n    skipping := true\n    loop x in items {{\n        ok := x >= 0\n        keep := false\n        if pred_nonneg && ok -> keep = true\n        if pred_nonneg == false && ok == false -> keep = true\n        if skipping && keep -> next\n        skipping = false\n        &out.push(x)\n    }}\n    out\n}}\n\npub fn unique(items: [Int]) -> [Int] Never! {{\n    out := [Int]{{}}\n    loop x in items {{\n        seen := false\n        loop y in out {{\n            if y == x -> seen = true\n        }}\n        if seen == false -> &out.push(x)\n    }}\n    out\n}}\n\npub fn repeat(value: Int, times: Int) -> [Int] Never! {{\n    out := [Int]{{}}\n    i := 0\n    loop i < times {{\n        &out.push(value)\n        i = i + 1\n    }}\n    out\n}}\n\npub fn count_from(start: Int, step: Int, n: Int) -> [Int] Never! {{\n    out := [Int]{{}}\n    v := start\n    i := 0\n    loop i < n {{\n        &out.push(v)\n        v = v + step\n        i = i + 1\n    }}\n    out\n}}\npub fn count(start: Int, step: Int, n: Int) -> [Int] Never! {{ count_from(start, step, n) }}\n\npub fn filterfalse(items: [Int], pred_nonneg: Bool) -> [Int] Never! {{\n    out := [Int]{{}}\n    loop x in items {{\n        selected := if pred_nonneg -> x < 0 else -> x >= 0\n        if selected -> &out.push(x)\n    }}\n    out\n}}\n\npub fn islice(items: [Int], start: Int, stop: Int, step: Int) -> [Int] Never! {{\n    out := [Int]{{}}\n    stride := step\n    if stride <= 0 -> return out\n    i := start\n    if i < 0 -> i = 0\n    limit := stop\n    if limit > items.len() -> limit = items.len()\n    loop i < limit {{\n        &out.push(items[i])\n        i += stride\n    }}\n    out\n}}\n\npub fn groupby(items: [Int]) -> [[Int]] Never! {{\n    out := [[Int]]{{}}\n    if items.len() == 0 -> return out\n    group := [Int]{{items[0]}}\n    i := 1\n    loop i < items.len() {{\n        if {{\n            items[i] == items[i - 1] -> &group.push(items[i])\n            else -> {{\n                &out.push(group)\n                group = [Int]{{items[i]}}\n            }}\n        }}\n        i += 1\n    }}\n    &out.push(group)\n    out\n}}\n\npub fn starmap(items: [[Int]]) -> [Int] Never! {{\n    out := [Int]{{}}\n    loop row in items {{\n        total := 0\n        loop value in row -> total += value\n        &out.push(total)\n    }}\n    out\n}}\n\npub fn tee(items: [Int], copies: Int) -> [[Int]] Never! {{\n    out := [[Int]]{{}}\n    if copies <= 0 -> return out\n    loop _ in 0..<copies {{\n        clone := [Int]{{}}\n        loop value in items -> &clone.push(value)\n        &out.push(clone)\n    }}\n    out\n}}\n\npub fn cycle(items: [Int], times: Int) -> [Int] Never! {{\n    out := [Int]{{}}\n    t := 0\n    loop t < times {{\n        loop x in items -> &out.push(x)\n        t = t + 1\n    }}\n    out\n}}\n\npub fn zip_longest(left: [Int], right: [Int], fill: Int) -> [[Int]] Never! {{\n    out := [[Int]]{{}}\n    n := left.len()\n    if right.len() > n -> n = right.len()\n    i := 0\n    loop i < n {{\n        a := fill\n        b := fill\n        if i < left.len() -> a = left[i]\n        if i < right.len() -> b = right[i]\n        &out.push([Int]{{a, b}})\n        i = i + 1\n    }}\n    out\n}}\n\npub fn accumulate(items: [Int]) -> [Int] Never! {{\n    out := [Int]{{}}\n    acc := 0\n    loop x in items {{\n        acc = acc + x\n        &out.push(acc)\n    }}\n    out\n}}\n\npub fn powerset(items: [Int]) -> [[Int]] Never! {{\n    out := [[Int]]{{[Int]{{}}}}\n    loop x in items {{\n        nxt := [[Int]]{{}}\n        loop row in out {{\n            cloned := [Int]{{}}\n            loop v in row -> &cloned.push(v)\n            &nxt.push(cloned)\n            grown := [Int]{{}}\n            loop v in row -> &grown.push(v)\n            &grown.push(x)\n            &nxt.push(grown)\n        }}\n        out = nxt\n    }}\n    out\n}}\n\npub fn windows(items: [Int], size: Int) -> [[Int]] Never! {{\n    out := [[Int]]{{}}\n    if size <= 0 || size > items.len() -> return out\n    i := 0\n    loop i + size <= items.len() {{\n        row := [Int]{{}}\n        j := 0\n        loop j < size {{\n            &row.push(items[i + j])\n            j = j + 1\n        }}\n        &out.push(row)\n        i = i + 1\n    }}\n    out\n}}\n\npub fn reverse(items: [Int]) -> [Int] Never! {{\n    out := [Int]{{}}\n    i := items.len() - 1\n    loop i >= 0 {{\n        &out.push(items[i])\n        i = i - 1\n    }}\n    out\n}}\n\npub fn flatten(groups: [[Int]]) -> [Int] Never! {{ chain_from(groups) }}\n"}
}

fn foundation_embedded_core_source_57() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.math.stats", alias: "core_core_math_stats", path: "Core/math/stats.jet", owner: "", owned_members: [String]{"correlation", "covariance", "cumsum", "fmean", "geometric_mean", "harmonic_mean", "kde", "kde_random", "linear_regression", "max", "mean", "median", "median_grouped", "median_high", "median_low", "min", "mode", "multimode", "percentile", "prod", "pstdev", "pvariance", "quantile", "range", "stdev", "sum", "variance", "zscore", "normal_dist", "count", "sumprod", "weighted_mean", "quantiles", "iqr", "mad", "mean_abs_deviation", "skew", "kurtosis", "moving_average", "ewma", "cumprod", "diff", "rank", "spearman", "r_squared", "residuals", "histogram", "describe", "clip", "winsorize", "pearson", "covariance_population"}, source: "use core.math as math\nuse core.math.random as random\n\n// core.math.stats — descriptive statistics in exact Int / software Float.\n//\n// Scalar statistics return `None` for empty, mismatched, non-finite, or\n// mathematically undefined inputs. Population variants divide by n; sample\n// variants divide by n - 1. Collection transforms return an empty collection\n// for invalid dimensions/parameters. Ties in mode and rank preserve the\n// first-seen order. Random KDE sampling carries the explicit Rand effect.\n\npub struct SlopeIntercept {{\n    pub slope: Float\n    pub intercept: Float\n}}\n\npub struct NormalDist {{\n    pub mu: Float\n    pub sigma: Float\n}}\n\nstruct CovarianceTerms {{\n    x_scale: Float\n    y_scale: Float\n    sx: Float\n    sy: Float\n    xx: Float\n    yy: Float\n    xy: Float\n}}\n\nstruct CentralTerms {{\n    n: Int\n    s2: Float\n    s3: Float\n    s4: Float\n}}\n\nfn nonfinite(value: Float) -> Bool Never! {{\n    if math.is_finite(value) -> return false\n    true\n}}\nfn abs_value(value: Float) -> Float Never! {{\n    if value < (Float{{0.0}}) -> return Float{{0.0}} - value\n    value\n}}\nfn sqrt_value(value: Float) -> Float Never! {{\n    math.sqrt(value)\n}}\nfn ln_value(value: Float) -> Float Never! {{\n    math.ln(value)\n}}\nfn exp_value(value: Float) -> Float Never! {{\n    math.exp(value)\n}}\n\nfn valid_sample(xs: [Float]) -> Bool Never! {{\n    loop x in xs {{\n        if nonfinite(x) -> return false\n    }}\n    true\n}}\nfn invalid_sample(xs: [Float]) -> Bool Never! {{\n    if valid_sample(xs) -> return false\n    true\n}}\n\nfn copy_floats(xs: [Float]) -> [Float] Never! {{\n    out := [Float]{{}}\n    loop x in xs -> &out.push(x)\n    out\n}}\nfn stable_mean(xs: [Float]) -> Float? {{\n    if xs.len() == 0 || invalid_sample(xs) -> return None\n    scale := Float{{0.0}}\n    loop x in xs {{\n        magnitude :: abs_value(x)\n        if magnitude > scale -> scale = magnitude\n    }}\n    if scale <= (Float{{0.0}}) -> return Val(Float{{0.0}})\n    acc := Float{{0.0}}\n    loop x in xs -> acc = acc + x / scale\n    Val((acc / (Float{{xs.len()}})) * scale)\n}}\n\n\nfn compensated_sum(xs: [Float]) -> Float Never! {{\n    acc := Float{{0.0}}\n    correction := Float{{0.0}}\n    positive_inf := false\n    negative_inf := false\n    loop x in xs {{\n        if math.is_nan(x) -> return x\n        if math.is_inf(x) {{\n            if x > (Float{{0.0}}) -> positive_inf = true else -> negative_inf = true\n            next\n        }}\n        if math.is_inf(acc) -> next\n        t :: acc + x\n        if abs_value(acc) >= abs_value(x) {{\n            correction = correction + ((acc - t) + x)\n        }} else {{\n            correction = correction + ((x - t) + acc)\n        }}\n        acc = t\n    }}\n    if positive_inf && negative_inf -> return math.nan()\n    if positive_inf -> return math.infinity()\n    if negative_inf -> return -math.infinity()\n    acc + correction\n}}\n\nfn sift_down(xs: &[Float], start: Int, end: Int) Never! {{\n    root := start\n    loop {{\n        child :: root * 2 + 1\n        if child > end -> return\n        candidate := root\n        if xs[candidate] < xs[child] -> candidate = child\n        right :: child + 1\n        if right <= end && xs[candidate] < xs[right] -> candidate = right\n        if candidate == root -> return\n        tmp :: Float{{xs[root]}}\n        xs[root] = xs[candidate]\n        xs[candidate] = tmp\n        root = candidate\n    }}\n}}\n\nfn sorted(xs: [Float]) -> [Float] Never! {{\n    out := copy_floats(xs)\n    n :: out.len()\n    if n < 2 -> return out\n    start := (n - 2) /% 2\n    loop {{\n        sift_down(&out, start, n - 1)\n        if start == 0 -> break\n        start = start - 1\n    }}\n    end := n - 1\n    loop end > 0 {{\n        tmp :: Float{{out[0]}}\n        out[0] = out[end]\n        out[end] = tmp\n        end = end - 1\n        sift_down(&out, 0, end)\n    }}\n    out\n}}\n\nfn interpolate(a: Float, b: Float, fraction: Float) -> Float Never! {{\n    if (a >= (Float{{0.0}}) && b >= (Float{{0.0}})) || (a <= (Float{{0.0}}) && b <= (Float{{0.0}})) {{\n        return a + (b - a) * fraction\n    }}\n    a * ((Float{{1.0}}) - fraction) + b * fraction\n}}\n\nfn quantile_sorted(s: [Float], p: Float) -> Float? {{\n    if s.len() == 0 || p != p || p < (Float{{0.0}}) || p > (Float{{1.0}}) -> return None\n    if p <= (Float{{0.0}}) -> return Val(s[0])\n    if p >= (Float{{1.0}}) -> return Val(s[s.len() - 1])\n    position :: p * (Float{{s.len() - 1}})\n    lower :: Int{{position}}\n    upper :: lower + 1\n    if upper >= s.len() -> return Val(s[s.len() - 1])\n    fraction :: position - (Float{{lower}})\n    Val(interpolate(s[lower], s[upper], fraction))\n}}\n\nfn compensated_sum_scaled(xs: [Float], scale: Float) -> Float Never! {{\n    acc := Float{{0.0}}\n    correction := Float{{0.0}}\n    loop x in xs {{\n        value :: x / scale\n        t :: acc + value\n        if abs_value(acc) >= abs_value(value) {{\n            correction = correction + ((acc - t) + value)\n        }} else {{\n            correction = correction + ((value - t) + acc)\n        }}\n        acc = t\n    }}\n    acc + correction\n}}\nfn covariance_terms(xs: [Float], ys: [Float]) -> CovarianceTerms? {{\n    n :: xs.len()\n    if n == 0 || ys.len() != n || invalid_sample(xs) || invalid_sample(ys) -> return None\n    x_scale := Float{{0.0}}\n    y_scale := Float{{0.0}}\n    loop x in xs {{\n        magnitude :: abs_value(x)\n        if magnitude > x_scale -> x_scale = magnitude\n    }}\n    loop y in ys {{\n        magnitude :: abs_value(y)\n        if magnitude > y_scale -> y_scale = magnitude\n    }}\n    if x_scale <= (Float{{0.0}}) || y_scale <= (Float{{0.0}}) {{\n        return Val(CovarianceTerms{{x_scale: x_scale, y_scale: y_scale, sx: Float{{0.0}}, sy: Float{{0.0}}, xx: Float{{0.0}}, yy: Float{{0.0}}, xy: Float{{0.0}}}})\n    }}\n    mx :: compensated_sum_scaled(xs, x_scale) / (Float{{n}})\n    my :: compensated_sum_scaled(ys, y_scale) / (Float{{n}})\n    sx := Float{{0.0}}\n    sy := Float{{0.0}}\n    loop i in 0..<n {{\n        dx :: abs_value(xs[i] / x_scale - mx)\n        dy :: abs_value(ys[i] / y_scale - my)\n        if dx > sx -> sx = dx\n        if dy > sy -> sy = dy\n    }}\n    xx := Float{{0.0}}\n    yy := Float{{0.0}}\n    xy := Float{{0.0}}\n    loop i in 0..<n {{\n        dx := Float{{0.0}}\n        dy := Float{{0.0}}\n        if sx > (Float{{0.0}}) -> dx = (xs[i] / x_scale - mx) / sx\n        if sy > (Float{{0.0}}) -> dy = (ys[i] / y_scale - my) / sy\n        xx = xx + dx * dx\n        yy = yy + dy * dy\n        xy = xy + dx * dy\n    }}\n    Val(CovarianceTerms{{x_scale: x_scale, y_scale: y_scale, sx: sx, sy: sy, xx: xx, yy: yy, xy: xy}})\n}}\n\n\nfn central_terms(xs: [Float]) -> CentralTerms? {{\n    n :: xs.len()\n    if n == 0 || invalid_sample(xs) -> return None\n    scale := Float{{0.0}}\n    loop x in xs {{\n        magnitude :: abs_value(x)\n        if magnitude > scale -> scale = magnitude\n    }}\n    if scale <= (Float{{0.0}}) -> return None\n    m :: compensated_sum_scaled(xs, scale) / (Float{{n}})\n    s2 := Float{{0.0}}\n    s3 := Float{{0.0}}\n    s4 := Float{{0.0}}\n    loop x in xs {{\n        z :: x / scale - m\n        z2 :: z * z\n        s2 = s2 + z2\n        s3 = s3 + z2 * z\n        s4 = s4 + z2 * z2\n    }}\n    Val(CentralTerms{{n: n, s2: s2, s3: s3, s4: s4}})\n}}\n\nfn variance_den(xs: [Float], den: Int) -> Float? {{\n    if den <= 0 || xs.len() == 0 || invalid_sample(xs) -> return None\n    scale := Float{{0.0}}\n    loop x in xs {{\n        magnitude :: abs_value(x)\n        if magnitude > scale -> scale = magnitude\n    }}\n    if scale <= (Float{{0.0}}) -> return Val(Float{{0.0}})\n    m :: compensated_sum_scaled(xs, scale) / (Float{{xs.len()}})\n    acc := Float{{0.0}}\n    loop x in xs {{\n        z :: x / scale - m\n        acc = acc + z * z\n    }}\n    normalized := acc / (Float{{den}})\n    if normalized < (Float{{0.0}}) -> return Val(Float{{0.0}})\n    deviation := sqrt_value(normalized) * scale\n    if nonfinite(deviation) -> return None\n    value := deviation * deviation\n    if nonfinite(value) -> return None\n    Val(value)\n}}\n\n\npub fn sum(xs: [Float]) -> Float Never! {{ compensated_sum(xs) }}\n\npub fn prod(xs: [Float]) -> Float Never! {{\n    acc := Float{{1.0}}\n    loop x in xs -> acc = acc * x\n    acc\n}}\n\npub fn mean(xs: [Float]) -> Float? Never! {{\n    m :: stable_mean(xs) ?? return None\n    Val(m)\n}}\n\npub fn fmean(xs: [Float]) -> Float? Never! {{ mean(xs) }}\n\npub fn geometric_mean(xs: [Float]) -> Float? Never! {{\n    if xs.len() == 0 || invalid_sample(xs) -> return None\n    acc := Float{{0.0}}\n    i := 0\n    loop x in xs {{\n        if x <= (Float{{0.0}}) -> return None\n        log_x :: ln_value(x)\n        acc = acc + (log_x - acc) / (Float{{i + 1}})\n        i = i + 1\n    }}\n    Val(exp_value(acc))\n}}\n\npub fn harmonic_mean(xs: [Float]) -> Float? Never! {{\n    if xs.len() == 0 || invalid_sample(xs) -> return None\n    minimum := ~xs[0]\n    loop x in xs {{\n        if x <= (Float{{0.0}}) -> return None\n        if x < minimum -> minimum = ~x\n    }}\n    acc := Float{{0.0}}\n    loop x in xs -> acc = acc + minimum / x\n    if acc <= (Float{{0.0}}) -> return None\n    Val((Float{{xs.len()}}) * minimum / acc)\n}}\n\npub fn median(xs: [Float]) -> Float? Never! {{\n    if xs.len() == 0 || invalid_sample(xs) -> return None\n    s :: sorted(xs)\n    n :: s.len()\n    mid :: n /% 2\n    if n % 2 == 1 -> return Val(s[mid])\n    Val(interpolate(s[mid - 1], s[mid], (Float{{0.5}})))\n}}\n\npub fn median_grouped(xs: [Float], interval: Float) -> Float? Never! {{\n    if xs.len() == 0 || invalid_sample(xs) || nonfinite(interval) || interval <= (Float{{0.0}}) {{\n        return None\n    }}\n    s :: sorted(xs)\n    n :: s.len()\n    mid :: n /% 2\n    x :: s[mid]\n    lower :: x - interval / (Float{{2.0}})\n    upper :: lower + interval\n    below := 0\n    frequency := 0\n    loop value in s {{\n        if value < lower -> below += 1\n        if value >= lower && value < upper -> frequency += 1\n    }}\n    if frequency == 0 -> return Val(x)\n    Val(lower + interval * ((Float{{n}}) / (Float{{2.0}}) - (Float{{below}})) / (Float{{frequency}}))\n}}\n\npub fn median_low(xs: [Float]) -> Float? Never! {{\n    if xs.len() == 0 || invalid_sample(xs) -> return None\n    s :: sorted(xs)\n    n :: s.len()\n    if n % 2 == 1 -> return Val(s[n /% 2])\n    Val(s[n /% 2 - 1])\n}}\n\npub fn median_high(xs: [Float]) -> Float? Never! {{\n    if xs.len() == 0 || invalid_sample(xs) -> return None\n    s :: sorted(xs)\n    Val(s[s.len() /% 2])\n}}\n\npub fn quantile(xs: [Float], p: Float) -> Float? Never! {{\n    if xs.len() == 0 || invalid_sample(xs) -> return None\n    quantile_sorted(sorted(xs), p)\n}}\n\npub fn percentile(xs: [Float], pct: Float) -> Float? Never! {{\n    if pct != pct -> return None\n    quantile(xs, pct / (Float{{100.0}}))\n}}\n\npub fn mode(xs: [Float]) -> Float? Never! {{\n    if xs.len() == 0 || invalid_sample(xs) -> return None\n    best := ~xs[0]\n    best_n := 0\n    loop x in xs {{\n        n := 0\n        loop y in xs {{\n            if y == x -> n = n + 1\n        }}\n        if n > best_n {{\n            best = ~x\n            best_n = n\n        }}\n    }}\n    Val(best)\n}}\n\npub fn multimode(xs: [Float]) -> [Float] Never! {{\n    out := [Float]{{}}\n    if xs.len() == 0 || invalid_sample(xs) -> return out\n    best := 0\n    loop x in xs {{\n        n := 0\n        loop y in xs {{\n            if y == x -> n = n + 1\n        }}\n        if n > best -> best = n\n    }}\n    loop x in xs {{\n        n := 0\n        loop y in xs {{\n            if y == x -> n = n + 1\n        }}\n        if n == best {{\n            seen := false\n            loop z in out {{\n                if z == x -> seen = true\n            }}\n            if seen == false -> &out.push(x)\n        }}\n    }}\n    out\n}}\n\npub fn pvariance(xs: [Float]) -> Float? Never! {{ variance_den(xs, xs.len()) }}\n\npub fn pstdev(xs: [Float]) -> Float? Never! {{\n    v :: pvariance(xs) ?? return None\n    Val(sqrt_value(v))\n}}\n\npub fn variance(xs: [Float]) -> Float? Never! {{\n    if xs.len() < 2 -> return None\n    variance_den(xs, xs.len() - 1)\n}}\n\npub fn stdev(xs: [Float]) -> Float? Never! {{\n    v :: variance(xs) ?? return None\n    Val(sqrt_value(v))\n}}\n\npub fn covariance(xs: [Float], ys: [Float]) -> Float? Never! {{\n    n :: xs.len()\n    if n < 2 || ys.len() != n -> return None\n    t :: covariance_terms(xs, ys) ?? return None\n    if t.sx <= (Float{{0.0}}) || t.sy <= (Float{{0.0}}) -> return Val(Float{{0.0}})\n    x_deviation := t.sx * t.x_scale\n    y_deviation := t.sy * t.y_scale\n    if nonfinite(x_deviation) || nonfinite(y_deviation) -> return None\n    value := (t.xy / (Float{{n - 1}})) * x_deviation * y_deviation\n    if nonfinite(value) -> return None\n    Val(value)\n}}\n\npub fn correlation(xs: [Float], ys: [Float]) -> Float? Never! {{\n    n :: xs.len()\n    if n < 2 || ys.len() != n -> return None\n    t :: covariance_terms(xs, ys) ?? return None\n    if t.xx <= (Float{{0.0}}) || t.yy <= (Float{{0.0}}) -> return None\n    value := t.xy / sqrt_value(t.xx * t.yy)\n    if nonfinite(value) -> return None\n    if value < (Float{{-1.0}}) -> return Val(Float{{-1.0}})\n    if value > (Float{{1.0}}) -> return Val(Float{{1.0}})\n    Val(value)\n}}\n\npub fn linear_regression(xs: [Float], ys: [Float]) -> SlopeIntercept? Never! {{\n    n :: xs.len()\n    if n < 2 || ys.len() != n -> return None\n    t :: covariance_terms(xs, ys) ?? return None\n    if t.sx <= (Float{{0.0}}) || t.xx <= (Float{{0.0}}) -> return None\n    x_deviation := t.sx * t.x_scale\n    y_deviation := t.sy * t.y_scale\n    if nonfinite(x_deviation) || nonfinite(y_deviation) || x_deviation <= (Float{{0.0}}) {{\n        return None\n    }}\n    slope := (t.xy / t.xx) * (y_deviation / x_deviation)\n    mx :: stable_mean(xs) ?? return None\n    my :: stable_mean(ys) ?? return None\n    intercept := my - slope * mx\n    if nonfinite(slope) || nonfinite(intercept) -> return None\n    Val(SlopeIntercept{{slope: slope, intercept: intercept}})\n}}\n\npub fn normal_dist(mu: Float, sigma: Float) -> NormalDist Never! {{\n    NormalDist{{mu: mu, sigma: sigma}}\n}}\n\npub fn kde(xs: [Float], bandwidth: Float) -> [Float] Never! {{\n    out := [Float]{{}}\n    if xs.len() == 0 || invalid_sample(xs) || nonfinite(bandwidth) || bandwidth <= (Float{{0.0}}) {{\n        return out\n    }}\n    normalizer :: (Float{{1.0}}) / ((Float{{xs.len()}}) * bandwidth * sqrt_value((Float{{2.0}}) * math.pi()))\n    loop point in xs {{\n        total := Float{{0.0}}\n        loop value in xs {{\n            z :: (point - value) / bandwidth\n            total = total + exp_value((Float{{-0.5}}) * z * z)\n        }}\n        &out.push(total * normalizer)\n    }}\n    out\n}}\n\npub fn kde_random(xs: [Float], bandwidth: Float, n: Int) -[Rand]> [Float] Never! {{\n    out := [Float]{{}}\n    if xs.len() == 0 || invalid_sample(xs) || nonfinite(bandwidth) || bandwidth <= (Float{{0.0}}) || n <= 0 {{\n        return out\n    }}\n    loop _ in 0..<n {{\n        index :: random.int(0, xs.len() - 1)\n        value := xs[index] + random.normal((Float{{0.0}}), bandwidth)\n        if nonfinite(value) -> return [Float]{{}}\n        &out.push(value)\n    }}\n    out\n}}\n\npub fn zscore(xs: [Float]) -> [Float] Never! {{\n    out := [Float]{{}}\n    if xs.len() == 0 || invalid_sample(xs) -> return out\n    scale := Float{{0.0}}\n    loop x in xs {{\n        magnitude :: abs_value(x)\n        if magnitude > scale -> scale = magnitude\n    }}\n    if scale <= (Float{{0.0}}) -> return out\n    m :: compensated_sum_scaled(xs, scale) / (Float{{xs.len()}})\n    acc := Float{{0.0}}\n    loop x in xs {{\n        z :: x / scale - m\n        acc = acc + z * z\n    }}\n    spread :: sqrt_value(acc / (Float{{xs.len()}}))\n    if spread <= (Float{{0.0}}) -> return out\n    loop x in xs -> &out.push((x / scale - m) / spread)\n    out\n}}\n\npub fn min(xs: [Float]) -> Float? Never! {{\n    if xs.len() == 0 || invalid_sample(xs) -> return None\n    m := ~xs[0]\n    loop x in xs {{\n        if x < m -> m = ~x\n    }}\n    Val(m)\n}}\n\npub fn max(xs: [Float]) -> Float? Never! {{\n    if xs.len() == 0 || invalid_sample(xs) -> return None\n    m := ~xs[0]\n    loop x in xs {{\n        if x > m -> m = ~x\n    }}\n    Val(m)\n}}\n\npub fn range(xs: [Float]) -> Float? Never! {{\n    lo :: min(xs) ?? return None\n    hi :: max(xs) ?? return None\n    value := hi - lo\n    if nonfinite(value) -> return None\n    Val(value)\n}}\npub fn cumsum(xs: [Float]) -> [Float] Never! {{\n    out := [Float]{{}}\n    if invalid_sample(xs) -> return out\n    acc := Float{{0.0}}\n    correction := Float{{0.0}}\n    loop x in xs {{\n        t :: acc + x\n        if abs_value(acc) >= abs_value(x) {{\n            correction = correction + ((acc - t) + x)\n        }} else {{\n            correction = correction + ((x - t) + acc)\n        }}\n        acc = t\n        value :: acc + correction\n        if nonfinite(value) -> return [Float]{{}}\n        &out.push(value)\n    }}\n    out\n}}\n\npub fn count(xs: [Float]) -> Int Never! {{ xs.len() }}\n\npub fn sumprod(xs: [Float], ys: [Float]) -> Float? Never! {{\n    if xs.len() != ys.len() || invalid_sample(xs) || invalid_sample(ys) -> return None\n    acc := Float{{0.0}}\n    correction := Float{{0.0}}\n    loop i in 0..<xs.len() {{\n        x :: xs[i] * ys[i]\n        t :: acc + x\n        if abs_value(acc) >= abs_value(x) {{\n            correction = correction + ((acc - t) + x)\n        }} else {{\n            correction = correction + ((x - t) + acc)\n        }}\n        acc = t\n    }}\n    value := acc + correction\n    if nonfinite(value) -> return None\n    Val(value)\n}}\npub fn weighted_mean(xs: [Float], weights: [Float]) -> Float? Never! {{\n    if xs.len() == 0 || xs.len() != weights.len() || invalid_sample(xs) -> return None\n    maximum_weight := Float{{0.0}}\n    value_scale := Float{{0.0}}\n    loop i in 0..<xs.len() {{\n        w :: weights[i]\n        if nonfinite(w) || w < (Float{{0.0}}) -> return None\n        if w > maximum_weight -> maximum_weight = w\n        magnitude :: abs_value(xs[i])\n        if magnitude > value_scale -> value_scale = magnitude\n    }}\n    if maximum_weight <= (Float{{0.0}}) -> return None\n    if value_scale <= (Float{{0.0}}) -> return Val(Float{{0.0}})\n    numerator := Float{{0.0}}\n    denominator := Float{{0.0}}\n    loop i in 0..<xs.len() {{\n        scaled_weight :: weights[i] / maximum_weight\n        numerator = numerator + (xs[i] / value_scale) * scaled_weight\n        denominator = denominator + scaled_weight\n    }}\n    if denominator <= (Float{{0.0}}) -> return None\n    value := (numerator / denominator) * value_scale\n    if nonfinite(value) -> return None\n    Val(value)\n}}\n\npub fn quantiles(xs: [Float], n: Int) -> [Float] Never! {{\n    out := [Float]{{}}\n    if n <= 1 || xs.len() == 0 || invalid_sample(xs) -> return out\n    s :: sorted(xs)\n    i := 1\n    loop i < n {{\n        q :: quantile_sorted(s, (Float{{i}}) / (Float{{n}})) ?? return [Float]{{}}\n        &out.push(q)\n        i = i + 1\n    }}\n    out\n}}\n\npub fn iqr(xs: [Float]) -> Float? Never! {{\n    q1 :: quantile(xs, (Float{{0.25}})) ?? return None\n    q3 :: quantile(xs, (Float{{0.75}})) ?? return None\n    value := q3 - q1\n    if nonfinite(value) -> return None\n    Val(value)\n}}\n\npub fn mad(xs: [Float]) -> Float? Never! {{\n    if xs.len() == 0 || invalid_sample(xs) -> return None\n    m :: median(xs) ?? return None\n    scale := Float{{0.0}}\n    loop x in xs {{\n        magnitude :: abs_value(x)\n        if magnitude > scale -> scale = magnitude\n    }}\n    if scale <= (Float{{0.0}}) -> return Val(Float{{0.0}})\n    center := m / scale\n    dev := [Float]{{}}\n    loop x in xs -> &dev.push(abs_value(x / scale - center))\n    d :: median(dev) ?? return None\n    value := d * scale\n    if nonfinite(value) -> return None\n    Val(value)\n}}\n\npub fn mean_abs_deviation(xs: [Float]) -> Float? Never! {{\n    if xs.len() == 0 || invalid_sample(xs) -> return None\n    scale := Float{{0.0}}\n    loop x in xs {{\n        magnitude :: abs_value(x)\n        if magnitude > scale -> scale = magnitude\n    }}\n    if scale <= (Float{{0.0}}) -> return Val(Float{{0.0}})\n    m :: compensated_sum_scaled(xs, scale) / (Float{{xs.len()}})\n    acc := Float{{0.0}}\n    loop x in xs -> acc = acc + abs_value(x / scale - m)\n    value := (acc / (Float{{xs.len()}})) * scale\n    if nonfinite(value) -> return None\n    Val(value)\n}}\n\npub fn skew(xs: [Float]) -> Float? Never! {{\n    n :: xs.len()\n    if n < 3 -> return None\n    t :: central_terms(xs) ?? return None\n    variance :: t.s2 / (Float{{t.n}})\n    if variance <= (Float{{0.0}}) -> return None\n    root :: sqrt_value(variance)\n    Val((t.s3 / (Float{{t.n}})) / (root * root * root))\n}}\n\npub fn kurtosis(xs: [Float]) -> Float? Never! {{\n    n :: xs.len()\n    if n < 4 -> return None\n    t :: central_terms(xs) ?? return None\n    variance :: t.s2 / (Float{{t.n}})\n    if variance <= (Float{{0.0}}) -> return None\n    Val((t.s4 / (Float{{t.n}})) / (variance * variance) - (Float{{3.0}}))\n}}\n\npub fn moving_average(xs: [Float], window: Int) -> [Float] Never! {{\n    out := [Float]{{}}\n    if window <= 0 || invalid_sample(xs) -> return out\n    acc := Float{{0.0}}\n    i := 0\n    loop i < xs.len() {{\n        acc = acc + xs[i]\n        if i >= window -> acc = acc - xs[i - window]\n        if nonfinite(acc) -> return [Float]{{}}\n        width := i + 1\n        if width > window -> width = window\n        value := acc / (Float{{width}})\n        if nonfinite(value) -> return [Float]{{}}\n        &out.push(value)\n        i = i + 1\n    }}\n    out\n}}\n\npub fn ewma(xs: [Float], alpha: Float) -> [Float] Never! {{\n    out := [Float]{{}}\n    if xs.len() == 0 || invalid_sample(xs) || nonfinite(alpha) -> return out\n    a := alpha\n    if a < (Float{{0.0}}) -> a = (Float{{0.0}})\n    if a > (Float{{1.0}}) -> a = (Float{{1.0}})\n    acc := ~xs[0]\n    &out.push(acc)\n    i := 1\n    loop i < xs.len() {{\n        acc = a * xs[i] + ((Float{{1.0}}) - a) * acc\n        if nonfinite(acc) -> return [Float]{{}}\n        &out.push(acc)\n        i = i + 1\n    }}\n    out\n}}\n\npub fn cumprod(xs: [Float]) -> [Float] Never! {{\n    out := [Float]{{}}\n    if invalid_sample(xs) -> return out\n    acc := Float{{1.0}}\n    loop x in xs {{\n        acc = acc * x\n        if nonfinite(acc) -> return [Float]{{}}\n        &out.push(acc)\n    }}\n    out\n}}\n\npub fn diff(xs: [Float]) -> [Float] Never! {{\n    out := [Float]{{}}\n    if xs.len() < 2 || invalid_sample(xs) -> return out\n    i := 1\n    loop i < xs.len() {{\n        value := xs[i] - xs[i - 1]\n        if nonfinite(value) -> return [Float]{{}}\n        &out.push(value)\n        i = i + 1\n    }}\n    out\n}}\n\npub fn rank(xs: [Float]) -> [Float] Never! {{\n    out := [Float]{{}}\n    if invalid_sample(xs) -> return out\n    n :: xs.len()\n    loop i in 0..<n {{\n        before := 1\n        ties := 0\n        loop j in 0..<n {{\n            if xs[j] < xs[i] -> before = before + 1\n            if xs[j] == xs[i] -> ties = ties + 1\n        }}\n        &out.push((Float{{before}}) + (Float{{ties - 1}}) / (Float{{2.0}}))\n    }}\n    out\n}}\n\npub fn spearman(xs: [Float], ys: [Float]) -> Float? Never! {{\n    if xs.len() != ys.len() -> return None\n    correlation(rank(xs), rank(ys))\n}}\n\npub fn r_squared(xs: [Float], ys: [Float]) -> Float? Never! {{\n    n :: xs.len()\n    if n < 2 || ys.len() != n -> return None\n    _ :: linear_regression(xs, ys) ?? return None\n    r :: correlation(xs, ys) ?? return None\n    Val(r * r)\n}}\n\npub fn residuals(xs: [Float], ys: [Float]) -> [Float] Never! {{\n    out := [Float]{{}}\n    if xs.len() != ys.len() || invalid_sample(xs) || invalid_sample(ys) -> return out\n    fit :: linear_regression(xs, ys) ?? return out\n    loop i in 0..<xs.len() {{\n        value := ys[i] - (fit.slope * xs[i] + fit.intercept)\n        if nonfinite(value) -> return [Float]{{}}\n        &out.push(value)\n    }}\n    out\n}}\n\npub fn histogram(xs: [Float], bins: Int) -> [Int] Never! {{\n    out := [Int]{{}}\n    if bins <= 0 || xs.len() == 0 || invalid_sample(xs) -> return out\n    lo :: min(xs) ?? return out\n    hi :: max(xs) ?? return out\n    loop _ in 0..<bins -> &out.push(0)\n    if lo == hi {{\n        out[0] = xs.len()\n        return out\n    }}\n    scale := abs_value(lo)\n    if abs_value(hi) > scale -> scale = abs_value(hi)\n    loop x in xs {{\n        t := Float{{0.0}}\n        if scale > (Float{{0.0}}) {{\n            lower :: lo / scale\n            upper :: hi / scale\n            value :: x / scale\n            t = (value - lower) / (upper - lower)\n        }}\n        idx := Int{{t * (Float{{bins}})}}\n        if idx < 0 -> idx = 0\n        if idx >= bins -> idx = bins - 1\n        out[idx] = out[idx] + 1\n    }}\n    out\n}}\n\npub fn describe(xs: [Float]) -> (max: Float, mean: Float, median: Float, min: Float, n: Int, q1: Float, q3: Float, stdev: Float) Never! {{\n    empty := (max: (Float{{0.0}}), mean: (Float{{0.0}}), median: (Float{{0.0}}), min: (Float{{0.0}}), n: 0, q1: (Float{{0.0}}), q3: (Float{{0.0}}), stdev: (Float{{0.0}}))\n    if xs.len() == 0 || invalid_sample(xs) -> return empty\n    return (\n        max: max(xs) ?? (Float{{0.0}}),\n        mean: mean(xs) ?? (Float{{0.0}}),\n        median: median(xs) ?? (Float{{0.0}}),\n        min: min(xs) ?? (Float{{0.0}}),\n        n: xs.len(),\n        q1: quantile(xs, (Float{{0.25}})) ?? (Float{{0.0}}),\n        q3: quantile(xs, (Float{{0.75}})) ?? (Float{{0.0}}),\n        stdev: stdev(xs) ?? (Float{{0.0}}),\n    )\n}}\n\npub fn clip(xs: [Float], lo: Float, hi: Float) -> [Float] Never! {{\n    out := [Float]{{}}\n    if invalid_sample(xs) || nonfinite(lo) || nonfinite(hi) -> return out\n    lower := lo\n    upper := hi\n    if lower > upper {{\n        swap := ~lower\n        lower = upper\n        upper = swap\n    }}\n    loop x in xs {{\n        v := ~x\n        if v < lower -> v = lower\n        if v > upper -> v = upper\n        &out.push(v)\n    }}\n    out\n}}\n\npub fn winsorize(xs: [Float], p: Float) -> [Float] Never! {{\n    if invalid_sample(xs) || p != p || p < (Float{{0.0}}) || p > (Float{{0.5}}) -> return [Float]{{}}\n    lo :: quantile(xs, p) ?? return [Float]{{}}\n    hi :: quantile(xs, (Float{{1.0}}) - p) ?? return [Float]{{}}\n    clip(xs, lo, hi)\n}}\n\npub fn pearson(xs: [Float], ys: [Float]) -> Float? Never! {{ correlation(xs, ys) }}\n\npub fn covariance_population(xs: [Float], ys: [Float]) -> Float? Never! {{\n    n :: xs.len()\n    if n == 0 || ys.len() != n -> return None\n    t :: covariance_terms(xs, ys) ?? return None\n    if t.sx <= (Float{{0.0}}) || t.sy <= (Float{{0.0}}) -> return Val(Float{{0.0}})\n    x_deviation := t.sx * t.x_scale\n    y_deviation := t.sy * t.y_scale\n    if nonfinite(x_deviation) || nonfinite(y_deviation) -> return None\n    value := (t.xy / (Float{{n}})) * x_deviation * y_deviation\n    if nonfinite(value) -> return None\n    Val(value)\n}}\n"}
