    FoundationCoreSource{module_name: "core.game", alias: "core_core_game", path: "Core/game/game.jet", owner: "", owned_members: [String]{}, source: "package {{\n    name: \"core.game\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"Backend-neutral game scene, replay, and frame loop.\"\n    license: \"MIT\"\n    outputs: {{\n        game: .Library{{ entry: game }}\n    }}\n}}\n\n// core.game — canonical scene/replay/backend handles.\n//\n// The runtime owns frame scheduling, input snapshots, and presentation.\n// Source constructors remain useful in the portable model and never invent\n// a successful frame when a provider is unavailable.\nmodule raylib\n\npub struct Scene {{\n    pub name: String\n    pub max_frames: Int\n    pub tick: Int\n}}\n\npub struct Replay {{\n    pub path: String\n}}\n\npub struct Backend {{\n    pub name: String\n    pub running: Bool\n}}\n\nimpl Scene {{\n    pub fn new(name: String) -> Scene Never! {{\n        Scene{{name: name, max_frames: 0, tick: 0}}\n    }}\n}}\n\nimpl Replay {{\n    pub fn record(path: String) -> Replay Never! {{ Replay{{path: path}} }}\n}}\n\nimpl Backend {{\n    pub fn headless() -> Backend Never! {{\n        Backend{{name: \"headless\", running: true}}\n    }}\n}}\n"}
}

fn foundation_embedded_core_source_48() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.game.raylib", alias: "core_core_game_raylib", path: "Core/game/raylib.jet", owner: "", owned_members: [String]{"begin_drawing", "clear_background", "close_window", "color", "draw_rectangle", "draw_sprite", "draw_text", "end_drawing", "gamepad_axis", "gamepad_down", "key_down", "load_sound", "load_texture_atlas", "play_sound", "set_target_fps", "window_open", "window_ready", "window_should_close"}, source: "use core as core\n\n// core.game.raylib — display-gated raylib bridge (D-RAYLIB1=A).\n//\n// This module owns no host fallback.  Window, input, drawing, texture, and\n// audio state are provider-owned; availability is exposed through the\n// provider's typed handles and status queries rather than fabricated locally.\npub struct RaylibWindow {{\n    pub width: Int\n    pub height: Int\n    pub title: String\n    pub open: Bool\n    pub drawing: Bool\n    pub should_close: Bool\n    pub fps: Int\n    pub commands: [String]\n}}\n\npub struct RaylibColor {{\n    pub r: Int\n    pub g: Int\n    pub b: Int\n    pub a: Int\n}}\n\npub struct RaylibTextureAtlas {{\n    pub path: String\n}}\n\npub struct RaylibSound {{\n    pub path: String\n}}\n\npub fn color(r: Int, g: Int, b: Int, a: Int) -> RaylibColor Never! {{\n    RaylibColor{{r: clamp8(r), g: clamp8(g), b: clamp8(b), a: clamp8(a)}}\n}}\n\npub fn window_open(width: Int, height: Int, title: String) -[GPU]> RaylibWindow Never! {{\n    w := clamp_dimension(width)\n    h := clamp_dimension(height)\n    core.game.raylib.window_open(w, h, title)\n}}\n\npub fn window_should_close(window: RaylibWindow) -[GPU]> Bool Never! {{\n    core.game.raylib.window_should_close(window)\n}}\n\npub fn window_ready(window: RaylibWindow) -[GPU]> Bool Never! {{\n    core.game.raylib.window_ready(window)\n}}\n\npub fn close_window(window: RaylibWindow) Never! -[GPU]> {{\n    core.game.raylib.close_window(window)\n}}\n\npub fn begin_drawing(window: RaylibWindow) Never! -[GPU]> {{\n    core.game.raylib.begin_drawing(window)\n}}\n\npub fn end_drawing() Never! -[GPU]> {{\n    core.game.raylib.end_drawing()\n}}\n\npub fn clear_background(color: RaylibColor) Never! -[GPU]> {{\n    core.game.raylib.clear_background(color)\n}}\n\npub fn draw_rectangle(x: Int, y: Int, width: Int, height: Int, color: RaylibColor) Never! -[GPU]> {{\n    core.game.raylib.draw_rectangle(x, y, width, height, color)\n}}\n\npub fn draw_text(text: String, x: Int, y: Int, size: Int, color: RaylibColor) Never! -[GPU]> {{\n    core.game.raylib.draw_text(text, x, y, size, color)\n}}\n\npub fn draw_sprite(atlas: RaylibTextureAtlas, source: String, x: Int, y: Int) Never! -[GPU]> {{\n    core.game.raylib.draw_sprite(atlas, source, x, y)\n}}\n\npub fn set_target_fps(fps: Int) Never! -[GPU]> {{\n    core.game.raylib.set_target_fps(clamp_fps(fps))\n}}\n\npub fn key_down(key: String) -[GPU]> Bool Never! {{\n    core.game.raylib.key_down(key)\n}}\n\npub fn gamepad_down(gamepad: Int, button: String) -[GPU]> Bool Never! {{\n    core.game.raylib.gamepad_down(gamepad, button)\n}}\n\npub fn gamepad_axis(gamepad: Int, axis: String) -[GPU]> Float Never! {{\n    core.game.raylib.gamepad_axis(gamepad, axis)\n}}\n\npub fn load_texture_atlas(path: String) -[FS, GPU]> RaylibTextureAtlas Never! {{\n    core.game.raylib.load_texture_atlas(path)\n}}\n\npub fn load_sound(path: String) -[FS, GPU]> RaylibSound Never! {{\n    core.game.raylib.load_sound(path)\n}}\n\npub fn play_sound(sound: RaylibSound) -[GPU]> Bool Never! {{\n    core.game.raylib.play_sound(sound)\n}}\n\nfn clamp8(value: Int) -> Int {{\n    if value < 0 -> return 0\n    if value > 255 -> return 255\n    value\n}}\n\nfn clamp_dimension(value: Int) -> Int {{\n    if value < 1 -> return 1\n    if value > 2147483647 -> return 2147483647\n    value\n}}\n\nfn clamp_fps(value: Int) -> Int {{\n    if value < 1 -> return 1\n    if value > 240 -> return 240\n    value\n}}\n"}
}

