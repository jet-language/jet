fn foundation_embedded_core_source_44() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.encoding.yaml", alias: "core_core_encoding_yaml", path: "Core/encoding/yaml.jet", owner: "", owned_members: [String]{"parse"}, source: "use core.encoding.[DataTree, EncodingError, EncodingErrorKind, EncodingFormat]\n\nfn syntax_error(format: EncodingFormat, offset: Int, line: Int, column: Int, path: String, reason: String) -> EncodingError Never! {{\n    {{\n        format: format,\n        kind: EncodingErrorKind.Syntax,\n        byte_offset: offset,\n        line: Val(line),\n        column: Val(column),\n        path: path,\n        reason: reason,\n        cause: None,\n    }}\n}}\nuse core.encoding.json as json\n\n// core.encoding.yaml — JSON-compatible YAML 1.2 plus simple block maps/lists.\n//\n// This source codec covers JSON, `key: value` maps, `- item` lists,\n// `|` / `>` folded scalars, and `#` comments. Unknown syntax fails closed\n// instead of guessing; unsupported YAML features are not silently delegated.\npub fn parse(text: String) -> DataTree EncodingError! {{ parse_yaml(text) }}\n\npub fn decode(text: String) -> DataTree EncodingError! {{ parse_yaml(text) }}\n\nfn parse_yaml(text: String) -> DataTree EncodingError! {{\n    trimmed :: trim_yaml(text)\n    if trimmed.len() == 0 -> return Ok(DataTree.Null)\n    if looks_json(trimmed) -> return json.parse(trimmed)\n    parse_block(trimmed)\n}}\n\nfn looks_json(text: String) -> Bool Never! {{\n    loop b in text.bytes() {{\n        n :: b\n        if n == 32 || n == 9 || n == 10 || n == 13 -> next\n        return n == 123 || n == 91\n    }}\n    false\n}}\n\nfn parse_block(text: String) -> DataTree EncodingError! {{\n    rows := [String]{{}}\n    buf := [U8]{{}}\n    loop b in text.bytes() {{\n        if b == (U8{{10}}) {{\n            &rows.push(String.from_bytes(buf) ?? return Err(syntax_error(EncodingFormat.YAML, 0, 1, 1, \"\", \"invalid UTF-8 in YAML input\")))\n            buf = [U8]{{}}\n            next\n        }}\n        if b == (U8{{13}}) -> next\n        &buf.push(b)\n    }}\n    if buf.len() > 0 -> &rows.push(String.from_bytes(buf) ?? return Err(syntax_error(EncodingFormat.YAML, 0, 1, 1, \"\", \"invalid UTF-8 in YAML input\")))\n    if rows.len() == 0 -> return Ok(DataTree.Null)\n    first := \"\"\n    first_index := 0\n    loop row_index in 0..<rows.len() {{\n        row :: rows[row_index]\n        if !is_blank_or_comment(row) {{\n            first = row\n            first_index = row_index\n            break\n        }}\n    }}\n    if first.len() == 0 -> return Ok(DataTree.Null)\n    first_body :: trim_yaml(strip_inline_comment(first))\n    if first_body == \"|\" || first_body == \">\" {{\n        block :: parse_block_scalar(rows, first_index, leading_spaces(first), first_body == \">\")\n        return Ok(DataTree.Text(block.value))\n    }}\n    if starts_list(first) -> return parse_list(rows, leading_spaces(first))\n    if split_once(lstrip(first), 58).before == lstrip(first) -> return Ok(parse_scalar(trim_yaml(first)))\n    parse_map(rows, leading_spaces(first))\n}}\n\nfn starts_list(line: String) -> Bool Never! {{\n    s :: lstrip(line)\n    bytes :: s.bytes()\n    if bytes.len() < 2 -> return false\n    bytes[0] == (U8{{45}}) && (bytes[1] == (U8{{32}}) || bytes[1] == (U8{{9}}))\n}}\n\nfn parse_block_scalar(rows: [String], start: Int, parent_indent: Int, folded: Bool) -> (value: String, next: Int) Never! {{\n    lines := [String]{{}}\n    i := start + 1\n    content_indent := -1\n    loop i < rows.len() {{\n        line :: rows[i]\n        if line.len() == 0 {{\n            &lines.push(\"\")\n            i += 1\n            next\n        }}\n        pad :: leading_spaces(line)\n        if pad <= parent_indent -> break\n        if content_indent < 0 -> content_indent = pad\n        if pad < content_indent -> break\n        &lines.push(strip_indent(line, content_indent))\n        i += 1\n    }}\n    out := \"\"\n    loop j in 0..<lines.len() {{\n        if j > 0 {{\n            previous :: lines[j - 1]\n            if folded && previous.len() > 0 && lines[j].len() > 0 {{\n                out = \"{{out}} \"\n            }} else {{\n                out = \"{{out}}\\n\"\n            }}\n        }}\n        out = \"{{out}}{{lines[j]}}\"\n    }}\n    if lines.len() > 0 -> out = \"{{out}}\\n\"\n    (value: out, next: i)\n}}\n\nfn strip_indent(text: String, columns: Int) -> String Never! {{\n    raw :: text.bytes()\n    consumed := 0\n    i := 0\n    loop i < raw.len() && consumed < columns {{\n        if raw[i] == (U8{{32}}) {{\n            consumed += 1\n            i += 1\n            next\n        }}\n        if raw[i] == (U8{{9}}) {{\n            consumed += 2\n            i += 1\n            next\n        }}\n        break\n    }}\n    if i >= raw.len() -> return \"\"\n    String.from_bytes(raw[i..raw.len() - 1]) ?? \"\"\n}}\n\n\nfn parse_map(rows: [String], indent: Int) -> DataTree EncodingError! {{\n    entries := [String:DataTree]{{}}\n    i := 0\n    loop i < rows.len() {{\n        line :: rows[i]\n        if is_blank_or_comment(line) {{\n            i += 1\n            next\n        }}\n        pad :: leading_spaces(line)\n        if pad < indent -> break\n        if pad > indent -> return Err(syntax_error(EncodingFormat.YAML, 0, 1, 1, \"\", \"unexpected indentation in YAML map\"))\n        body :: lstrip(line)\n        cut :: split_once(body, 58)\n        if cut.before == body -> return Err(syntax_error(EncodingFormat.YAML, 0, 1, 1, \"\", \"YAML map entry needs ':'\"))\n        key :: trim_yaml(cut.before)\n        if key.len() == 0 -> return Err(syntax_error(EncodingFormat.YAML, 0, 1, 1, \"\", \"YAML map key is empty\"))\n        if entries.has_key(key) -> return Err(syntax_error(EncodingFormat.YAML, 0, 1, 1, \"\", \"duplicate YAML map key\"))\n        rest :: trim_yaml(strip_inline_comment(cut.after))\n        i += 1\n        if rest == \"|\" || rest == \">\" {{\n            block :: parse_block_scalar(rows, i - 1, pad, rest == \">\")\n            _ :: &entries.add(key, DataTree.Text(block.value))\n            i = block.next\n        }} else if rest.len() == 0 {{\n            child_rows := [String]{{}}\n            loop i < rows.len() {{\n                child :: rows[i]\n                if is_blank_or_comment(child) {{\n                    i += 1\n                    next\n                }}\n                if leading_spaces(child) <= pad -> break\n                &child_rows.push(child)\n                i += 1\n            }}\n            _ :: &entries.add(key, parse_block(join_lines(child_rows)))\n        }} else {{\n            _ :: &entries.add(key, parse_scalar(rest))\n        }}\n    }}\n    Ok(DataTree.Object(entries))\n}}\n\nfn parse_list(rows: [String], indent: Int) -> DataTree EncodingError! {{\n    items := [DataTree]{{}}\n    i := 0\n    loop i < rows.len() {{\n        line :: rows[i]\n        if is_blank_or_comment(line) {{\n            i += 1\n            next\n        }}\n        pad :: leading_spaces(line)\n        if pad < indent -> break\n        if pad > indent -> return Err(syntax_error(EncodingFormat.YAML, 0, 1, 1, \"\", \"unexpected indentation in YAML list\"))\n        body :: lstrip(line)\n        bytes :: body.bytes()\n        if bytes.len() == 0 || bytes[0] != (U8{{45}}) -> return Err(syntax_error(EncodingFormat.YAML, 0, 1, 1, \"\", \"YAML list item needs '-'\"))\n        rest := \"\"\n        if bytes.len() > 1 -> rest = trim_yaml(drop_prefix(body, 2))\n        i += 1\n        if rest == \"|\" || rest == \">\" {{\n            block :: parse_block_scalar(rows, i - 1, pad, rest == \">\")\n            &items.push(DataTree.Text(block.value))\n            i = block.next\n        }} else if rest.len() == 0 {{\n            child_rows := [String]{{}}\n            loop i < rows.len() {{\n                child :: rows[i]\n                if is_blank_or_comment(child) {{\n                    i += 1\n                    next\n                }}\n                if leading_spaces(child) <= pad -> break\n                &child_rows.push(child)\n                i += 1\n            }}\n            &items.push(parse_block(join_lines(child_rows)))\n        }} else if split_once(rest, 58).before != rest {{\n            map_rows := [String]{{rest}}\n            loop i < rows.len() {{\n                child :: rows[i]\n                if is_blank_or_comment(child) {{\n                    &map_rows.push(\"\")\n                    i += 1\n                    next\n                }}\n                if leading_spaces(child) <= pad -> break\n                &map_rows.push(strip_indent(child, pad + 2))\n                i += 1\n            }}\n            &items.push(parse_map(map_rows, 0))\n        }} else {{\n            &items.push(parse_scalar(strip_inline_comment(rest)))\n        }}\n    }}\n    Ok(DataTree.Array(items))\n}}\n\nfn parse_scalar(text: String) -> DataTree Never! {{\n    clean :: trim_yaml(strip_inline_comment(text))\n    if clean == {{\n        \"null\" | \"~\" -> return DataTree.Null\n        \"true\" -> return DataTree.Bool(true)\n        \"false\" -> return DataTree.Bool(false)\n        else -> {{ _ := 0 }}\n    }}\n    if Int.parse(clean) == {{\n        .Ok(n) -> return DataTree.Int(n)\n        else -> {{ _ := 0 }}\n    }}\n    if Float.parse(clean) == {{\n        .Ok(n) -> return DataTree.Float(n)\n        else -> {{ _ := 0 }}\n    }}\n    DataTree.Text(unquote(clean))\n}}\n\nfn render_yaml(value: DataTree, indent: Int) -> String {{\n    if value == {{\n        .Null -> return \"null\"\n        .Bool(v) -> {{\n            if v -> return \"true\"\n            return \"false\"\n        }}\n        .Int(n) -> return \"{{n}}\"\n        .Float(n) -> return \"{{n}}\"\n        .Text(s) -> return yaml_scalar(s)\n        .Array(items) -> return render_yaml_array(items, indent)\n        .Object(entries) -> return render_yaml_object(entries, indent)\n    }}\n}}\n\nfn render_yaml_array(items: [DataTree], indent: Int) -> String {{\n    out := \"\"\n    loop item in items -> out = \"{{out}}{{spaces(indent)}}- {{render_yaml(item, indent + 2)}}\\n\"\n    out\n}}\n\nfn render_yaml_object(entries: [String:DataTree], indent: Int) -> String {{\n    out := \"\"\n    loop pair in entries -> out = \"{{out}}{{spaces(indent)}}{{pair.key}}: {{render_yaml(pair.value, indent + 2)}}\\n\"\n    out\n}}\n\nfn trim_yaml(text: String) -> String Never! {{\n    raw :: text.bytes()\n    start := 0\n    end := raw.len()\n    loop start < end {{\n        n :: raw[start]\n        if n == 32 || n == 9 || n == 10 || n == 13 {{\n            start += 1\n            next\n        }}\n        break\n    }}\n    loop end > start {{\n        n :: raw[end - 1]\n        if n == 32 || n == 9 || n == 10 || n == 13 {{\n            end -= 1\n            next\n        }}\n        break\n    }}\n    if end <= start -> return \"\"\n    String.from_bytes(raw[start..end - 1]) ?? \"\"\n}}\n\nfn strip_inline_comment(text: String) -> String Never! {{\n    raw :: text.bytes()\n    quote := 0\n    i := 0\n    loop i < raw.len() {{\n        n :: raw[i]\n        if quote != 0 {{\n            if n == quote -> quote = 0\n        }} else if n == 34 || n == 39 {{\n            quote = n\n        }} else if n == 35 && (i == 0 || raw[i - 1] == 32 || raw[i - 1] == 9) {{\n            if i == 0 -> return \"\"\n            return String.from_bytes(raw[0..i - 1]) ?? \"\"\n        }}\n        i += 1\n    }}\n    ~text\n}}\n\nfn yaml_scalar(text: String) -> String {{\n    raw :: text.bytes()\n    needs := raw.len() == 0\n    i := 0\n    loop i < raw.len() {{\n        n :: raw[i]\n        if n == 32 || n == 9 || n == 35 || n == 58 || n == 91 || n == 93 || n == 123 || n == 125 || n == 44 || n == 34 || n == 39 || n == 10 || n == 13 -> needs = true\n        i += 1\n    }}\n    if !needs && text != \"null\" && text != \"true\" && text != \"false\" && !parses_as_number(text) -> return ~text\n    out := \"\\\"\"\n    loop b in raw {{\n        if b == (U8{{92}}) -> out = \"{{out}}\\\\\\\\\"\n        else if b == (U8{{34}}) -> out = \"{{out}}\\\\\\\"\"\n        else if b == (U8{{10}}) -> out = \"{{out}}\\\\n\"\n        else if b == (U8{{13}}) -> out = \"{{out}}\\\\r\"\n        else if b == (U8{{9}}) -> out = \"{{out}}\\\\t\"\n        else -> out = \"{{out}}{{String.from_bytes([U8]{{b}}) ?? \"\"}}\"\n    }}\n    \"{{out}}\\\"\"\n}}\n\nfn parses_as_number(text: String) -> Bool Never! {{\n    if Int.parse(text) == {{\n        .Ok(_) -> return true\n        else -> {{ _ := 0 }}\n    }}\n    if Float.parse(text) == {{\n        .Ok(_) -> return true\n        else -> {{ _ := 0 }}\n    }}\n    false\n}}\n\nfn lstrip(text: String) -> String Never! {{\n    raw :: text.bytes()\n    start := 0\n    loop start < raw.len() {{\n        n :: raw[start]\n        if n == 32 || n == 9 {{\n            start += 1\n            next\n        }}\n        break\n    }}\n    if start >= raw.len() -> return \"\"\n    String.from_bytes(raw[start..raw.len() - 1]) ?? \"\"\n}}\n\nfn leading_spaces(text: String) -> Int Never! {{\n    n := 0\n    loop b in text.bytes() {{\n        if b == (U8{{32}}) {{\n            n += 1\n            next\n        }}\n        if b == (U8{{9}}) {{\n            n += 2\n            next\n        }}\n        break\n    }}\n    n\n}}\n\nfn is_blank_or_comment(line: String) -> Bool Never! {{\n    s :: lstrip(line)\n    if s.len() == 0 -> return true\n    s.bytes()[0] == (U8{{35}})\n}}\n\nfn split_once(text: String, sep: U8) -> (after: String, before: String) Never! {{\n    raw :: text.bytes()\n    loop i in 0..<raw.len() {{\n        if raw[i] == sep {{\n            before := \"\"\n            if i > 0 -> before = String.from_bytes(raw[0..i - 1]) ?? \"\"\n            after := \"\"\n            if i + 1 < raw.len() -> after = String.from_bytes(raw[i + 1..raw.len() - 1]) ?? \"\"\n            return (before: before, after: after)\n        }}\n    }}\n    (before: ~text, after: \"\")\n}}\n\nfn drop_prefix(text: String, n: Int) -> String Never! {{\n    raw :: text.bytes()\n    if raw.len() <= n -> return \"\"\n    String.from_bytes(raw[n..raw.len() - 1]) ?? \"\"\n}}\n\nfn join_lines(rows: [String]) -> String Never! {{\n    out := \"\"\n    loop i in 0..<rows.len() {{\n        if i > 0 -> out = \"{{out}}\\n\"\n        out = \"{{out}}{{rows[i]}}\"\n    }}\n    out\n}}\n\nfn spaces(n: Int) -> String {{\n    out := \"\"\n    loop _ in 0..<n -> out = \"{{out}} \"\n    out\n}}\n\nfn unquote(text: String) -> String Never! {{\n    raw :: text.bytes()\n    if raw.len() < 2 -> return ~text\n    if (raw[0] != (U8{{34}}) && raw[0] != (U8{{39}})) || raw[raw.len() - 1] != raw[0] -> return ~text\n    out := [U8]{{}}\n    i := 1\n    loop i < raw.len() - 1 {{\n        if raw[0] == (U8{{34}}) && raw[i] == (U8{{92}}) && i + 1 < raw.len() - 1 {{\n            i += 1\n            if raw[i] == (U8{{110}}) -> &out.push(U8{{10}})\n            else if raw[i] == (U8{{114}}) -> &out.push(U8{{13}})\n            else if raw[i] == (U8{{116}}) -> &out.push(U8{{9}})\n            else if raw[i] == (U8{{34}}) || raw[i] == (U8{{92}}) -> &out.push(raw[i])\n            else -> &out.push(raw[i])\n        }} else {{\n            &out.push(raw[i])\n        }}\n        i += 1\n    }}\n    String.from_bytes(out) ?? ~text\n}}\n"}
}

fn foundation_embedded_core_source_45() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.files.path", alias: "core_core_files_path", path: "Core/files/path.jet", owner: "", owned_members: [String]{"absolute", "anchor", "append_text", "as_posix", "as_uri", "as_windows", "chmod", "collapse", "copy_file", "copy_into", "cwd", "drive", "ensure_dir", "exists", "expanduser", "from_parts", "glob", "hardlink_to", "home", "is_absolute", "is_dir", "is_empty", "is_file", "is_relative", "is_relative_to", "is_symlink", "iterdir", "join", "join_many", "join_path", "match_glob", "match_path", "mkdir", "mtime", "name", "of", "parent", "parents", "parts", "read_bytes", "read_lines", "read_text", "readlink", "relative_to", "rename", "replace", "resolve", "resolve_pure", "rglob", "rmdir", "rmtree", "root", "samefile", "size", "stat", "stem", "suffix", "suffixes", "symlink_to", "touch", "unlink", "with_name", "with_segments", "with_stem", "with_suffix", "write_bytes", "write_lines", "write_text", "path", "walk", "which", "open_read", "open_write", "show", "equals"}, source: "package {{\n    name: \"core.files.path\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"Object paths that beat Python pathlib.\"\n    license: \"MIT\"\n    outputs: {{\n        path: .Library{{ entry: path }}\n    }}\n}}\nuse core as core\nuse core.files as files\n\n// core.files.path — pathlib-style paths that beat Python's `pathlib`.\n//\n// Construction and string math are pure. Existence queries are `-[FS]>`.\n// Join never inserts duplicate separators. `..` and `.` collapse through\n// `collapse`. Windows drive letters (`C:`) count as absolute.\n//\n// Beyond PurePath/Path: `join_many`, `parents`, `is_relative_to`, `rglob`\n// `ensure_dir`, `read_lines`/`write_lines`, `samefile`, `with_segments`\n// `as_uri`, suffix lists, and POSIX/Windows separator conversion.\n\npub struct Path {{\n    pub raw: String\n}}\n\n\npub fn of(raw: String) -> Path Never! {{ Path{{raw: ~raw}} }}\n\n\n/// Construct a path from its platform-neutral textual spelling.\npub fn path(raw: String) -> Path Never! {{ of(raw) }}\n\n\npub fn from_parts(parts: [String]) -> Path Never! {{\n    acc := \"\"\n    loop p in parts {{\n        if acc.bytes().len() == 0 {{\n            acc = p\n        }} else {{\n            acc = files.join(acc, p)\n        }}\n    }}\n    Path{{raw: acc}}\n}}\n\n\npub fn cwd() -[FS, Env]> Path IOError! {{\n    p :: files.cwd()\n    Ok(Path{{raw: p}})\n}}\n\n\npub fn home() -[FS, Env]> Path IOError! {{\n    p :: files.home()\n    Ok(Path{{raw: p}})\n}}\n\n\npub fn join(base: Path, other: String) -> Path Never! {{ Path{{raw: files.join(~base.raw, other)}} }}\n\n\npub fn join_path(base: Path, other: Path) -> Path Never! {{ Path{{raw: files.join(~base.raw, ~other.raw)}} }}\n\n\npub fn join_many(base: Path, parts: [String]) -> Path Never! {{\n    acc := base\n    loop p in parts -> acc = join(acc, p)\n    acc\n}}\n\n\npub fn parent(path: Path) -> Path Never! {{ Path{{raw: files.dirname(~path.raw)}} }}\n\n\nfn ends_colon(text: String) -> Bool {{\n    raw :: text.bytes()\n    if raw.len() == 0 -> return false\n    raw[raw.len() - 1] == (U8{{58}})\n}}\n\n\npub fn parents(path: Path) -> [Path] Never! {{\n    out := [Path]{{}}\n    cur := parent(~path)\n    seen := ~path.raw\n    loop {{\n        if cur.raw == seen || cur.raw.bytes().len() == 0 -> return ~out\n        &out.push(~cur)\n        if cur.raw == \"/\" || (cur.raw.bytes().len() == 2 && ends_colon(cur.raw)) -> return ~out\n        seen = ~cur.raw\n        nxt := parent(~cur)\n        if nxt.raw == cur.raw -> return ~out\n        cur = nxt\n    }}\n}}\n\n\npub fn name(path: Path) -> String Never! {{ files.basename(~path.raw) }}\n\n\npub fn stem(path: Path) -> String Never! {{ files.stem(~path.raw) }}\n\n\npub fn suffix(path: Path) -> String Never! {{ files.suffix(~path.raw) }}\n\n\nfn files_slice(raw: [U8], start: Int, end: Int) -> String {{\n    out := [U8]{{}}\n    i := start\n    loop {{\n        if i >= end || i < 0 || i >= raw.len() -> return String.from_bytes(out) ?? \"\"\n        &out.push(raw[i])\n        i = i + 1\n    }}\n}}\n\n\npub fn suffixes(path: Path) -> [String] Never! {{\n    n :: files.basename(~path.raw)\n    raw :: n.bytes()\n    out := [String]{{}}\n    start := -1\n    i := 1\n    loop i < raw.len() {{\n        if raw[i] == (U8{{46}}) {{\n            if start >= 0 -> &out.push(files_slice(raw, start, i))\n            start = i\n        }}\n        i = i + 1\n    }}\n    if start >= 0 -> &out.push(files_slice(raw, start, raw.len()))\n    out\n}}\n\n\npub fn with_name(path: Path, name: String) -> Path Never! {{ Path{{raw: files.with_name(~path.raw, name)}} }}\n\n\npub fn with_suffix(path: Path, suffix: String) -> Path Never! {{ Path{{raw: files.with_suffix(~path.raw, suffix)}} }}\n\n\npub fn with_stem(path: Path, stem: String) -> Path Never! {{ Path{{raw: files.with_name(~path.raw, \"{{stem}}{{files.suffix(~path.raw)}}\")}} }}\n\n\npub fn with_segments(path: Path, segments: [String]) -> Path Never! {{ from_parts(segments) }}\n\n\npub fn parts(path: Path) -> [String] Never! {{ files.split_slash(~path.raw) }}\n\n\nfn is_letter(b: U8) -> Bool {{\n    n :: b\n    (n >= 65 && n <= 90) || (n >= 97 && n <= 122)\n}}\n\n\npub fn drive(path: Path) -> String Never! {{\n    raw :: (~path.raw).bytes()\n    if raw.len() >= 2 && is_letter(raw[0]) && raw[1] == (U8{{58}}) {{\n        return files_slice(raw, 0, 2)\n    }}\n    \"\"\n}}\n\n\npub fn is_absolute(path: Path) -> Bool Never! {{ files.is_absolute(~path.raw) }}\n\n\npub fn root(path: Path) -> String Never! {{\n    if is_absolute(~path) {{\n        d :: drive(~path)\n        if d.bytes().len() > 0 -> return \"{{d}}/\"\n        return \"/\"\n    }}\n    \"\"\n}}\n\n\npub fn anchor(path: Path) -> String Never! {{\n    d :: drive(~path)\n    r :: root(~path)\n    if d.bytes().len() > 0 -> return r\n    r\n}}\n\n\npub fn is_relative(path: Path) -> Bool Never! {{ !files.is_absolute(~path.raw) }}\n\n\npub fn is_empty(path: Path) -> Bool Never! {{ (~path.raw).bytes().len() == 0 || path.raw == \".\" }}\n\n\npub fn as_posix(path: Path) -> String Never! {{\n    out := [U8]{{}}\n    loop b in (~path.raw).bytes() {{\n        if b == (U8{{92}}) {{\n            &out.push(U8{{47}})\n        }} else {{\n            &out.push(b)\n        }}\n    }}\n    String.from_bytes(out) ?? ~path.raw\n}}\n\n\npub fn as_windows(path: Path) -> String Never! {{\n    out := [U8]{{}}\n    loop b in (~path.raw).bytes() {{\n        if b == (U8{{47}}) {{\n            &out.push(U8{{92}})\n        }} else {{\n            &out.push(b)\n        }}\n    }}\n    String.from_bytes(out) ?? ~path.raw\n}}\n\n\npub fn collapse(path: Path) -> Path Never! {{ Path{{raw: files.collapse(~path.raw)}} }}\n\n\npub fn resolve_pure(path: Path) -> Path Never! {{ collapse(path) }}\n\n\nfn starts_slash(text: String) -> Bool {{\n    raw :: text.bytes()\n    raw.len() > 0 && raw[0] == (U8{{47}})\n}}\n\n\npub fn as_uri(path: Path) -> String Never! {{\n    posix :: as_posix(resolve_pure(path))\n    if starts_slash(posix) -> return \"file://{{posix}}\"\n    \"file:///{{posix}}\"\n}}\n\n\npub fn resolve(path: Path) -[FS, Env]> Path IOError! {{\n    abs :: files.absolute(~path.raw)\n    Ok(Path{{raw: abs}})\n}}\n\n\npub fn absolute(path: Path) -[FS, Env]> Path IOError! {{ resolve(path) }}\n\n\npub fn expanduser(path: Path) -[FS, Env]> Path IOError! {{\n    raw :: files.expanduser(~path.raw)\n    Ok(Path{{raw: raw}})\n}}\n\n\npub fn relative_to(path: Path, start: Path) -> Path Never! {{ Path{{raw: files.relative(~path.raw, ~start.raw)}} }}\n\n\npub fn is_relative_to(path: Path, start: Path) -> Bool Never! {{\n    target :: files.collapse(~path.raw)\n    base :: files.collapse(~start.raw)\n    common :: files.commonpath([String]{{~target, ~base}})\n    if common != base -> return false\n    if base == \".\" && starts_dotdot(~target) -> return false\n    true\n}}\n\n\npub fn match_glob(path: Path, pattern: String) -> Bool Never! {{ files.fnmatch(name(~path), pattern) }}\n\n\npub fn m