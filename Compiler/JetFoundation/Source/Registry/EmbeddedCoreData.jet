fn foundation_embedded_core_source_81() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.text.fmt", alias: "core_text_fmt", path: "Core/text/fmt.jet", owner: "", owned_members: [String]{"bin", "bytes", "decimal", "duration", "grouped", "hex", "number", "oct", "ordinal", "pad", "pad_center", "pad_left", "pad_right", "percent", "plural", "pretty", "sci"}, source: "use core.text as unicode\n// core.text.fmt — deterministic number, quantity, and display formatting.\n// Radix helpers use lowercase digits; text padding counts UTF-8 scalars.\npub fn number(n: Int) -> String Never! {{ grouped_int(n) }}\npub fn bin(n: Int) -> String Never! {{ radix_signed(n, 2) }}\npub fn oct(n: Int) -> String Never! {{ radix_signed(n, 8) }}\n\n/// `width` is the minimum digit count, zero-padded. Negative `n` keeps sign.\npub fn hex(n: Int, width: Int) -> String Never! {{ radix_signed_width(n, 16, width) }}\n\npub fn ordinal(n: Int) -> String Never! {{\n    abs :: abs_int(n)\n    mod100 :: abs % 100\n    suffix := \"th\"\n    if mod100 < 11 || mod100 > 13 {{\n        m :: abs % 10\n        if m == 1 -> suffix = \"st\"\n        if m == 2 -> suffix = \"nd\"\n        if m == 3 -> suffix = \"rd\"\n    }}\n    \"{{grouped_int(n)}}{{suffix}}\"\n}}\n\npub fn plural(n: Int, singular: String, many: String) -> String Never! {{\n    word :: if abs_int(n) == 1 -> singular else -> many\n    \"{{grouped_int(n)}} {{word}}\"\n}}\n\npub fn pad_left(text: String, width: Int, fill: String) -> String Never! {{ pad_mode(text, width, fill, 0) }}\npub fn pad_right(text: String, width: Int, fill: String) -> String Never! {{ pad_mode(text, width, fill, 1) }}\npub fn pad_center(text: String, width: Int, fill: String) -> String Never! {{ pad_mode(text, width, fill, 2) }}\npub fn pad(text: String, width: Int, fill: String) -> String Never! {{ pad_right(text, width, fill) }}\n\npub fn grouped(n: Float, frac: Int) -> String Never! {{ group_decimal(float_fixed(n, frac)) }}\npub fn decimal(n: Float, frac: Int) -> String Never! {{ float_fixed(n, frac) }}\npub fn percent(n: Float, frac: Int) -> String Never! {{ \"{{float_fixed(n * 100.0, frac)}}%\" }}\npub fn sci(n: Float, frac: Int) -> String Never! {{\n    if n == 0.0 -> return \"{{float_fixed(0.0, frac)}}e+00\"\n    sign := \"\"\n    value := n\n    if value < 0.0 {{\n        sign = \"-\"\n        value = -value\n    }}\n    exponent := 0\n    loop value >= 10.0 {{\n        value = value / 10.0\n        exponent = exponent + 1\n    }}\n    loop value < 1.0 {{\n        value = value * 10.0\n        exponent = exponent - 1\n    }}\n    exp_sign := if exponent < 0 -> \"-\" else -> \"+\"\n    exp_abs :: abs_int(exponent)\n    exp_text := radix(exp_abs, 10)\n    if exp_text.bytes().len() < 2 -> exp_text = \"0{{exp_text}}\"\n    \"{{sign}}{{float_fixed(value, frac)}}e{{exp_sign}}{{exp_text}}\"\n}}\n\npub fn pretty(value: String) -> String Never! {{\n    out := \"\"\n    indent := 0\n    quoted := false\n    escaped := false\n    loop ch in unicode.scalars(value) {{\n        if quoted {{\n            out = \"{{out}}{{ch}}\"\n            if escaped -> escaped = false\n            else if ch == \"\\\\\" -> escaped = true\n            else if ch == \"\\\"\" -> quoted = false\n            next\n        }}\n        if ch == \"\\\"\" {{\n            quoted = true\n            out = \"{{out}}{{ch}}\"\n        }} else if ch == \"{{{{\" || ch == \"[\" {{\n            indent = indent + 2\n            out = \"{{out}}{{ch}}\\n{{spaces(indent)}}\"\n        }} else if ch == \"}}}}\" || ch == \"]\" {{\n            indent = indent - 2\n            if indent < 0 -> indent = 0\n            out = \"{{trim_right(out)}}\\n{{spaces(indent)}}{{ch}}\"\n        }} else if ch == \",\" {{\n            out = \"{{trim_right(out)}},\\n{{spaces(indent)}}\"\n        }} else {{\n            out = \"{{out}}{{ch}}\"\n        }}\n    }}\n    trim_right(out)\n}}\n\npub fn bytes(n: Int) -> String Never! {{\n    sign := \"\"\n    value := n\n    if value < 0 {{\n        sign = \"-\"\n        value = -value\n    }}\n    if value < 1024 -> return \"{{sign}}{{value}} B\"\n    if value < 1048576 -> return \"{{sign}}{{value / 1024}} KiB\"\n    if value < 1073741824 -> return \"{{sign}}{{value / 1048576}} MiB\"\n    if value < 1099511627776 -> return \"{{sign}}{{value / 1073741824}} GiB\"\n    \"{{sign}}{{value / 1099511627776}} TiB\"\n}}\n\n/// `n` is milliseconds. Composite output is bounded to three non-zero units.\npub fn duration(n: Int) -> String Never! {{\n    sign := \"\"\n    rest := n\n    if rest < 0 {{\n        sign = \"-\"\n        rest = -rest\n    }}\n    if rest < 1000 -> return \"{{sign}}{{rest}}ms\"\n    days := rest / 86400000\n    rest = rest %% 86400000\n    hours := rest / 3600000\n    rest = rest %% 3600000\n    minutes := rest / 60000\n    rest = rest %% 60000\n    seconds := rest / 1000\n    parts := [String]{{}}\n    if days > 0 -> &parts.push(\"{{days}}d\")\n    if hours > 0 -> &parts.push(\"{{hours}}h\")\n    if minutes > 0 -> &parts.push(\"{{minutes}}m\")\n    if seconds > 0 || parts.len() == 0 -> &parts.push(\"{{seconds}}s\")\n    out := \"\"\n    limit := parts.len()\n    if limit > 3 -> limit = 3\n    i := 0\n    loop i < limit {{\n        if i > 0 -> out = \"{{out}} \"\n        out = \"{{out}}{{parts[i]}}\"\n        i = i + 1\n    }}\n    \"{{sign}}{{out}}\"\n}}\n\nfn abs_int(n: Int) -> Int {{\n    if n < 0 -> return -n\n    n\n}}\n\nfn grouped_int(n: Int) -> String {{\n    sign := \"\"\n    rest := n\n    if rest < 0 {{\n        sign = \"-\"\n        rest = -rest\n    }}\n    digits :: radix(rest, 10)\n    raw :: digits.bytes()\n    out := [U8]{{}}\n    i := 0\n    loop i < raw.len() {{\n        remaining :: raw.len() - i\n        if i > 0 && remaining % 3 == 0 -> &out.push(U8{{44}})\n        &out.push(raw[i])\n        i = i + 1\n    }}\n    \"{{sign}}{{String.from_bytes(out) ?? digits}}\"\n}}\n\nfn radix_signed(n: Int, base: Int) -> String {{ radix_signed_width(n, base, 0) }}\n\nfn radix_signed_width(n: Int, base: Int, width: Int) -> String {{\n    sign := \"\"\n    value := n\n    if value < 0 {{\n        sign = \"-\"\n        value = -value\n    }}\n    digits :: radix(value, base)\n    \"{{sign}}{{pad_left(digits, width, \"0\")}}\"\n}}\n\nfn radix(n: Int, base: Int) -> String {{\n    if n == 0 -> return \"0\"\n    digits := [U8]{{}}\n    x := n\n    loop x > 0 {{\n        d :: x % base\n        if d < 10 -> &digits.push(U8{{48 + d}}) else -> &digits.push(U8{{87 + d}})\n        x = x /% base\n    }}\n    out := [U8]{{}}\n    i := digits.len() - 1\n    loop i >= 0 {{\n        &out.push(digits[i])\n        i = i - 1\n    }}\n    String.from_bytes(out) ?? \"0\"\n}}\n\nfn float_fixed(n: Float, frac: Int) -> String Never! {{\n    precision := frac\n    if precision < 0 -> precision = 0\n    scale := Float{{1}}\n    i := 0\n    loop i < precision {{\n        scale = scale * Float{{10}}\n        i = i + 1\n    }}\n    scaled := n * scale\n    rounded := if scaled < 0.0 -> Int{{scaled - 0.5}} else -> Int{{scaled + 0.5}}\n    sign := \"\"\n    if rounded < 0 {{\n        sign = \"-\"\n        rounded = -rounded\n    }}\n    digits :: radix(rounded, 10)\n    if precision == 0 -> return \"{{sign}}{{digits}}\"\n    body := pad_left(digits, precision + 1, \"0\")\n    split :: body.bytes().len() - precision\n    \"{{sign}}{{slice(body, 0, split)}}.{{slice(body, split, body.bytes().len())}}\"\n}}\n\nfn group_decimal(text: String) -> String {{\n    raw :: text.bytes()\n    sign := \"\"\n    start := 0\n    if raw.len() > 0 && (raw[0] == (U8{{45}}) || raw[0] == (U8{{43}})) {{\n        sign = String.from_bytes([U8]{{raw[0]}}) ?? \"\"\n        start = 1\n    }}\n    dot := raw.len()\n    i := start\n    loop i < raw.len() {{\n        if raw[i] == (U8{{46}}) {{\n            dot = i\n            break\n        }}\n        i = i + 1\n    }}\n    whole := String.from_bytes(slice_b(raw, start, dot)) ?? \"0\"\n    frac := if dot < raw.len() -> String.from_bytes(slice_b(raw, dot, raw.len())) ?? \"\" else -> \"\"\n    \"{{sign}}{{grouped_digits(whole)}}{{frac}}\"\n}}\n\nfn grouped_digits(text: String) -> String {{\n    raw :: text.bytes()\n    out := [U8]{{}}\n    i := 0\n    loop i < raw.len() {{\n        remain :: raw.len() - i\n        if i > 0 && remain % 3 == 0 -> &out.push(U8{{44}})\n        &out.push(raw[i])\n        i = i + 1\n    }}\n    String.from_bytes(out) ?? text\n}}\n\nfn pad_mode(text: String, width: Int, fill: String, mode: Int) -> String Never! {{\n    need := width - unicode.scalar_count(text)\n    units :: unicode.scalars(fill)\n    if need <= 0 || units.len() == 0 -> return ~text\n    added := \"\"\n    i := 0\n    loop i < need {{\n        added = \"{{added}}{{units[i % units.len()]}}\"\n        i = i + 1\n    }}\n    if mode == 0 -> return \"{{added}}{{text}}\"\n    if mode == 1 -> return \"{{text}}{{added}}\"\n    left :: need /% 2\n    \"{{slice(added, 0, left)}}{{text}}{{slice(added, left, unicode.scalar_count(added))}}\"\n}}\n\nfn spaces(n: Int) -> String {{\n    out := \"\"\n    i := 0\n    loop i < n {{\n        out = \"{{out}} \"\n        i = i + 1\n    }}\n    out\n}}\n\nfn trim_right(text: String) -> String {{\n    raw :: text.bytes()\n    i := raw.len()\n    loop i > 0 && (raw[i - 1] == (U8{{32}}) || raw[i - 1] == (U8{{10}}) || raw[i - 1] == (U8{{9}})) -> i = i - 1\n    String.from_bytes(slice_b(raw, 0, i)) ?? text\n}}\n\nfn slice(text: String, start: Int, end: Int) -> String Never! {{\n    units :: unicode.scalars(text)\n    out := \"\"\n    i := start\n    loop i < end && i < units.len() {{\n        if i >= 0 -> out = \"{{out}}{{units[i]}}\"\n        i = i + 1\n    }}\n    out\n}}\n\nfn slice_b(raw: [U8], start: Int, end: Int) -> [U8] {{\n    out := [U8]{{}}\n    i := start\n    loop {{\n        if i >= end || i < 0 || i >= raw.len() -> return ~out\n        &out.push(raw[i])\n        i = i + 1\n    }}\n}}\n"}
