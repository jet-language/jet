fn foundation_embedded_core_source_37() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.encoding.ini", alias: "core_core_encoding_ini", path: "Core/encoding/ini.jet", owner: "", owned_members: [String]{"defaults", "empty", "get", "get_bool", "get_float", "get_int", "get_or", "has_option", "has_section", "items", "options", "parse", "remove_option", "remove_section", "sections", "set", "to_string"}, source: "package {{\n    name: \"core.encoding.ini\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"INI / ConfigParser documents as ordered sections.\"\n    license: \"MIT\"\n    outputs: {{\n        ini: .Library{{ entry: ini }}\n    }}\n}}\n\n// core.encoding.ini — Python `configparser` without interpolation.\n//\n// Sections keep source order. Duplicate keys in a section keep the last\n// value. Comments are `#` and `;` to end of line. Values may be quoted.\n// `DEFAULT` is a section name, not a magic fallback, unless `get_or` is used\n// with a caller-supplied default. This codec is pure.\n#Error\npub struct INIError {{\n    pub line: Int\n    pub reason: String\n}}\n\nimpl INIError {{\n    pub fn new(line: Int, reason: String) -> INIError Never! {{\n        INIError{{line: line, reason: reason}}\n    }}\n}}\n\n\npub struct Pair {{\n    pub key: String\n    pub value: String\n}}\n\npub struct Section {{\n    pub name: String\n    pub pairs: [Pair]\n}}\n\npub struct Ini {{\n    pub sections: [Section]\n}}\n\npub fn empty() -> Ini Never! {{ Ini{{sections: [Section]{{}}}} }}\n\npub fn parse(text: String) -> Ini INIError! {{\n    doc := empty()\n    current := \"\"\n    line := 0\n    loop raw_line in split_lines(text) {{\n        line += 1\n        trimmed :: trim(strip_comment(raw_line))\n        if trimmed.bytes().len() == 0 -> next\n        raw :: trimmed.bytes()\n        if raw[0] == (U8{{91}}) {{\n            if raw[raw.len() - 1] != (U8{{93}}) -> return Err(INIError{{line: line, reason: \"ini section is missing a closing bracket\"}})\n            current = trim(String.from_bytes(slice_b(raw, 1, raw.len() - 1)) ?? \"\")\n            if current.bytes().len() == 0 -> return Err(INIError{{line: line, reason: \"ini section name is empty\"}})\n            doc = ensure_section(doc, current)\n            next\n        }}\n        eq :: index_of(raw, 61)\n        colon := index_of(raw, 58)\n        sep := eq\n        if sep < 0 || (colon >= 0 && colon < sep) -> sep = colon\n        if sep <= 0 -> return Err(INIError{{line: line, reason: \"ini line is not a key=value pair\"}})\n        key :: trim(String.from_bytes(slice_b(raw, 0, sep)) ?? \"\")\n        value_text :: trim(String.from_bytes(slice_b(raw, sep + 1, raw.len())) ?? \"\")\n        value_raw :: value_text.bytes()\n        if value_raw.len() > 0 && (value_raw[0] == (U8{{34}}) || value_raw[0] == (U8{{39}})) {{\n            if value_raw.len() < 2 || value_raw[value_raw.len() - 1] != value_raw[0] {{\n                return Err(INIError{{line: line, reason: \"ini quoted value is missing its closing quote\"}})\n            }}\n        }}\n        value :: unquote(value_text)\n        if key.bytes().len() == 0 -> return Err(INIError{{line: line, reason: \"ini key is empty\"}})\n        if current.bytes().len() == 0 -> current = \"DEFAULT\"\n        doc = set(doc, current, key, value)\n    }}\n    Ok(doc)\n}}\n\npub fn to_string(doc: Ini) -> String Never! {{\n    out := \"\"\n    loop section in doc.sections {{\n        out = \"{{out}}[{{section.name}}]\\n\"\n        loop p in section.pairs -> out = \"{{out}}{{p.key}} = {{ini_value(p.value)}}\\n\"\n        out = \"{{out}}\\n\"\n    }}\n    out\n}}\n\npub fn sections(doc: Ini) -> [String] Never! {{\n    names := [String]{{}}\n    loop s in doc.sections -> &names.push(s.name)\n    names\n}}\n\npub fn has_section(doc: Ini, name: String) -> Bool Never! {{\n    loop s in doc.sections {{\n        if s.name == name -> return true\n    }}\n    false\n}}\n\npub fn has_option(doc: Ini, section: String, key: String) -> Bool Never! {{ get(doc, section, key) != None }}\n\npub fn get(doc: Ini, section: String, key: String) -> String? Never! {{\n    loop s in doc.sections {{\n        if s.name == section {{\n            loop p in s.pairs {{\n                if p.key == key -> return Val(p.value)\n            }}\n        }}\n    }}\n    None\n}}\n\npub fn get_or(doc: Ini, section: String, key: String, fallback: String) -> String Never! {{ get(doc, section, key) ?? fallback }}\n\npub fn get_int(doc: Ini, section: String, key: String) -> Int? Never! {{\n    text :: get(doc, section, key) ?? return None\n    parse_int(text)\n}}\n\npub fn get_bool(doc: Ini, section: String, key: String) -> Bool? Never! {{\n    text :: get(doc, section, key) ?? return None\n    t :: ascii_lower(trim(text))\n    if t == {{\n        \"1\" | \"true\" | \"yes\" | \"on\" -> return Val(true)\n        \"0\" | \"false\" | \"no\" | \"off\" -> return Val(false)\n        else -> return None\n    }}\n}}\n\npub fn get_float(doc: Ini, section: String, key: String) -> Float? Never! {{\n    text :: get(doc, section, key) ?? return None\n    parse_float(text)\n}}\n\npub fn items(doc: Ini, section: String) -> [Pair] Never! {{\n    loop s in doc.sections {{\n        if s.name == section -> return s.pairs\n    }}\n    [Pair]{{}}\n}}\n\npub fn options(doc: Ini, section: String) -> [String] Never! {{\n    keys := [String]{{}}\n    loop p in items(doc, section) -> &keys.push(p.key)\n    keys\n}}\n\npub fn set(doc: Ini, section: String, key: String, value: String) -> Ini Never! {{\n    sections := [Section]{{}}\n    found_section := false\n    loop s in doc.sections {{\n        if s.name == section {{\n            found_section = true\n            pairs := [Pair]{{}}\n            found_key := false\n            loop p in s.pairs {{\n                if p.key == key {{\n                    &pairs.push(Pair{{key: key, value: value}})\n                    found_key = true\n                }} else {{\n                    &pairs.push(p)\n                }}\n            }}\n            if !found_key -> &pairs.push(Pair{{key: key, value: value}})\n            &sections.push(Section{{name: s.name, pairs: pairs}})\n        }} else {{\n            &sections.push(s)\n        }}\n    }}\n    if !found_section {{\n        &sections.push(Section{{name: section, pairs: [Pair]{{Pair{{key: key, value: value}}}}}})\n    }}\n    Ini{{sections: sections}}\n}}\n\npub fn remove_option(doc: Ini, section: String, key: String) -> Ini Never! {{\n    sections := [Section]{{}}\n    loop s in doc.sections {{\n        if s.name == section {{\n            pairs := [Pair]{{}}\n            loop p in s.pairs {{\n                if p.key != key -> &pairs.push(p)\n            }}\n            &sections.push(Section{{name: s.name, pairs: pairs}})\n        }} else {{\n            &sections.push(s)\n        }}\n    }}\n    Ini{{sections: sections}}\n}}\n\npub fn remove_section(doc: Ini, section: String) -> Ini Never! {{\n    sections := [Section]{{}}\n    loop s in doc.sections {{\n        if s.name != section -> &sections.push(s)\n    }}\n    Ini{{sections: sections}}\n}}\n\npub fn defaults(doc: Ini) -> [Pair] Never! {{ items(doc, \"DEFAULT\") }}\n\nfn ensure_section(doc: Ini, name: String) -> Ini Never! {{\n    if has_section(doc, name) -> return ~doc\n    sections := [Section]{{}}\n    loop s in doc.sections -> &sections.push(s)\n    &sections.push(Section{{name: name, pairs: [Pair]{{}}}})\n    Ini{{sections: sections}}\n}}\n\nfn strip_comment(line: String) -> String Never! {{\n    raw :: line.bytes()\n    i := 0\n    in_quote := false\n    q := 0\n    loop i < raw.len() {{\n        n :: raw[i]\n        if in_quote {{\n            if n == q -> in_quote = false\n        }} else if n == 34 || n == 39 {{\n            in_quote = true\n            q = n\n        }} else if n == 35 || n == 59 {{\n            return String.from_bytes(slice_b(raw, 0, i)) ?? \"\"\n        }}\n        i = i + 1\n    }}\n    ~line\n}}\n\nfn unquote(text: String) -> String Never! {{\n    raw :: text.bytes()\n    if raw.len() >= 2 {{\n        a :: raw[0]\n        b :: raw[raw.len() - 1]\n        if (a == 34 && b == 34) || (a == 39 && b == 39) {{\n            body := [U8]{{}}\n            i := 1\n            loop i < raw.len() - 1 {{\n                if raw[i] == (U8{{92}}) && i + 1 < raw.len() - 1 {{\n                    i += 1\n                    if raw[i] == (U8{{110}}) -> &body.push(U8{{10}})\n                    else if raw[i] == (U8{{114}}) -> &body.push(U8{{13}})\n                    else if raw[i] == (U8{{116}}) -> &body.push(U8{{9}})\n                    else -> &body.push(raw[i])\n                }} else {{\n                    &body.push(raw[i])\n                }}\n                i += 1\n            }}\n            return String.from_bytes(body) ?? ~text\n        }}\n    }}\n    ~text\n}}\n\nfn ini_value(text: String) -> String {{\n    raw :: text.bytes()\n    quote := raw.len() == 0\n    i := 0\n    loop i < raw.len() {{\n        n :: raw[i]\n        if n == 32 || n == 9 || n == 35 || n == 59 || n == 34 || n == 39 || n == 10 || n == 13 || n == 92 -> quote = true\n        i += 1\n    }}\n    if !quote -> return ~text\n    out := \"\\\"\"\n    loop b in raw {{\n        if b == (U8{{92}}) -> out = \"{{out}}\\\\\\\\\"\n        else if b == (U8{{10}}) -> out = \"{{out}}\\\\n\"\n        else if b == (U8{{13}}) -> out = \"{{out}}\\\\r\"\n        else if b == (U8{{9}}) -> out = \"{{out}}\\\\t\"\n        else if b == (U8{{34}}) -> out = \"{{out}}\\\\\\\"\"\n        else -> out = \"{{out}}{{String.from_bytes([U8]{{b}}) ?? \"\"}}\"\n    }}\n    \"{{out}}\\\"\"\n}}\n\nfn split_lines(text: String) -> [String] Never! {{\n    raw :: text.bytes()\n    out := [String]{{}}\n    start := 0\n    i := 0\n    loop i < raw.len() {{\n        if raw[i] == (U8{{10}}) {{\n            end := i\n            if end > start && raw[end - 1] == (U8{{13}}) -> end = end - 1\n            &out.push(String.from_bytes(slice_b(raw, start, end)) ?? \"\")\n            start = i + 1\n        }}\n        i = i + 1\n    }}\n    if start <= raw.len() -> &out.push(String.from_bytes(slice_b(raw, start, raw.len())) ?? \"\")\n    out\n}}\n\nfn trim(text: String) -> String Never! {{\n    raw :: text.bytes()\n    a := 0\n    b := raw.len()\n    loop a < b {{\n        n :: raw[a]\n        if n == 32 || n == 9 -> a = a + 1\n        else -> break\n    }}\n    loop b > a {{\n        n :: raw[b - 1]\n        if n == 32 || n == 9 -> b = b - 1\n        else -> break\n    }}\n    String.from_bytes(slice_b(raw, a, b)) ?? \"\"\n}}\n\nfn index_of(raw: [U8], code: Int) -> Int Never! {{\n    loop i in 0..<raw.len() {{\n        n :: raw[i]\n        if n == code -> return i\n    }}\n    -1\n}}\n\nfn slice_b(raw: [U8], start: Int, end: Int) -> [U8] Never! {{\n    out := [U8]{{}}\n    i := start\n    loop i < end && i >= 0 && i < raw.len() {{\n        &out.push(raw[i])\n        i = i + 1\n    }}\n    out\n}}\n\nfn ascii_lower(text: String) -> String Never! {{\n    out := [U8]{{}}\n    loop b in text.bytes() {{\n        n :: b\n        if n >= 65 && n <= 90 {{\n            &out.push(U8{{n + 32}})\n        }} else {{\n            &out.push(b)\n        }}\n    }}\n    String.from_bytes(out) ?? ~text\n}}\n\nfn parse_int(text: String) -> Int? {{\n    raw :: trim(text).bytes()\n    if raw.len() == 0 -> return None\n    i := 0\n    sign := 1\n    if raw[0] == (U8{{45}}) {{\n        sign = -1\n        i = 1\n    }}\n    if i >= raw.len() -> return None\n    n := 0\n    loop i < raw.len() {{\n        d :: raw[i]\n        if d < 48 || d > 57 -> return None\n        n = n * 10 + (d - 48)\n        i = i + 1\n    }}\n    Val(n * sign)\n}}\n\nfn parse_float(text: String) -> Float? {{\n    t :: trim(text)\n    raw :: t.bytes()\n    if raw.len() == 0 -> return None\n    i := 0\n    sign := Float{{1}}\n    if raw[0] == (U8{{45}}) {{\n        sign = Float{{-1}}\n        i = 1\n    }}\n    whole := Float{{0}}\n    seen := false\n    loop i < raw.len() {{\n        d :: raw[i]\n        if d == 46 -> break\n        if d < 48 || d > 57 -> return None\n        whole = whole * Float{{10}} + Float{{d - 48}}\n        seen = true\n        i = i + 1\n    }}\n    frac := Float{{0}}\n    place := Float{{1}} / Float{{10}}\n    if i < raw.len() && raw[i] == (U8{{46}}) {{\n        i = i + 1\n        loop i < raw.len() {{\n            d :: raw[i]\n            if d < 48 || d > 57 -> return None\n            frac = frac + Float{{d - 48}} * place\n            place = place * (Float{{1}} / Float{{10}})\n            seen = true\n            i = i + 1\n        }}\n    }}\n    if !seen || i != raw.len() -> return None\n    Val(sign * (whole + frac))\n}}\n"}
}

fn foundation_embedded_core_source_38() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.encoding.json", alias: "core_core_encoding_json", path: "Core/encoding/json.jet", owner: "", owned_members: [String]{"canonical", "dump", "dumps", "events", "load", "loads", "parse", "parse_allow_duplicates", "patch", "patch_with_limits", "pointer", "reader", "reader_allow_duplicates", "writer"}, source: "\n// core.encoding.json — RFC 8259 JSON as DataTree.\n//\n// `parse` is the strict codec: objects keep insertion order, whole numbers\n// become `DataTree.Int` (exact `Int`, not binary64), fractions become\n// `DataTree.Float`, and `NaN` / `Infinity` are syntax errors. `decode` is the\n// same tree with the historical lenient name; typed `decode<T>` stays a\n// compiler lowering over this tree and is not reimplemented here.\n//\n// `to_string` is compact. `to_string_pretty` uses two-space indent. Neither\n// emits a trailing newline, sorts keys, or is a hashing contract: insertion\n// order is the document order. `canonical` is the one byte-exact form, RFC 8785\n// JCS (D-JSONCANON1=A): keys sorted by UTF-16 code units, ECMAScript shortest\n// numbers, and explicit `EncodingError`s for values JCS cannot encode.\n//\n// Duplicate object names (D-CORE-JSON-DUP1=A): `parse`, `decode`, and\n// `reader` reject them with the key's path, line, and column. The named\n// `parse_allow_duplicates` keeps the later value in the first key's position;\n// `reader_allow_duplicates` reports every occurrence as events. The duplicate\n// check uses the object's own key map, so the input bound\n// (`EncodingLimits.safe().max_item_bytes`) also bounds it.\n//\n// `pointer` is RFC 6901 selection (D-CORE-JSON-POINTER1=A) and `patch` is RFC\n// 6902 application (D-CORE-JSON-PATCH1=A). Both leave their inputs unchanged.\n//\n// Allocates one output tree plus the decoded strings. Depth defaults to\n// `EncodingLimits.safe().max_depth` (256); `parse_with_limits` and\n// `parse_allow_duplicates_with_limits` accept an explicit container bound.\n// Error reasons and failure lines follow Rust EncodingJson.rs. Whole integer\n// tokens stay exact Int even outside i64 (D-JSON, #4306).\n\n\nuse core.encoding.[DataEvent, DataTree, EncodingError, EncodingErrorKind, EncodingFormat, EncodingLimits]\nuse core.math as math\n\nfn syntax_error(format: EncodingFormat, offset: Int, line: Int, column: Int, path: String, reason: String) -> EncodingError Never! {{\n    {{\n        format: format,\n        kind: EncodingErrorKind.Syntax,\n        byte_offset: offset,\n        line: Val(line),\n        column: Val(column),\n        path: path,\n        reason: reason,\n        cause: None,\n    }}\n}}\n\nfn limit_error(format: EncodingFormat, offset: Int, reason: String) -> EncodingError Never! {{\n    {{\n        format: format,\n        kind: EncodingErrorKind.Limit,\n        byte_offset: offset,\n        line: None,\n        column: None,\n        path: \"\",\n        reason: reason,\n        cause: None,\n    }}\n}}\n\nfn safe_limits() -> EncodingLimits Never! {{\n    {{\n        buffer_bytes: 65536,\n        max_depth: 256,\n        max_item_bytes: 16777216,\n        max_total_bytes: None,\n        max_expansion_depth: 32,\n        max_expansion_bytes: 8388608,\n    }}\n}}\n/// Strict JSON → `DataTree`.\npub fn parse(text: String) -> DataTree EncodingError! {{ parse_with_limits(text, safe_limits()) }}\n\n/// Strict JSON → `DataTree`, except that a repeated object name keeps the later\n/// value at the first name's position.\npub fn parse_allow_duplicates(text: String) -> DataTree EncodingError! {{ parse_allow_duplicates_with_limits(text, safe_limits()) }}\n\n/// Strict JSON under caller-selected limits. A container opens only when the\n/// number of enclosing containers is below `max_depth` (root depth is zero).\n/// `max_item_bytes` bounds the UTF-8 input; other fields govern streaming and\n/// expansion APIs, not this whole-value parser.\npub fn parse_with_limits(text: String, limits: EncodingLimits) -> DataTree EncodingError! {{\n    parse_json(text, false, limits)\n}}\n\n/// Same limits as `parse_with_limits`, keeping the later duplicate value at\n/// the first key's insertion position.\npub fn parse_allow_duplicates_with_limits(text: String, limits: EncodingLimits) -> DataTree EncodingError! {{\n    parse_json(text, true, limits)\n}}\n\n/// Same as `parse`. Kept as the documented sibling verb for typed lowering.\npub fn decode(text: String) -> DataTree EncodingError! {{ parse(text) }}\n/// Python-compatible spelling for JSON parsing.\npub fn loads(text: String) -> DataTree EncodingError! {{ parse(text) }}\n\n/// Python-compatible file-shaped spelling for JSON parsing.\npub fn load(text: String) -> DataTree EncodingError! {{ parse(text) }}\n/// Compact JSON text. Object keys keep insertion order.\npub fn to_string(value: DataTree) -> String Never! {{ render_json(value, false) }}\n/// Python-compatible spelling for compact JSON serialization.\npub fn dumps(value: DataTree) -> String Never! {{ render_json(value, false) }}\n/// Python-compatible file-shaped spelling for JSON serialization.\npub fn dump(value: DataTree) -> String Never! {{ render_json(value, false) }}\n\n/// Two-space indented JSON text.\npub fn to_string_pretty(value: DataTree) -> String Never! {{ render_json(value, true) }}\n\n/// RFC 8785 JSON Canonicalization Scheme bytes (D-JSONCANON1=A): compact,\n/// object keys sorted by unsigned UTF-16 code units, ECMAScript `Number`\n/// spelling, `-0.0` as `0`. Rejects NaN and infinities, an `Int` that binary64\n/// cannot hold exactly, and repeated keys, naming the failing value's JSON\n/// Pointer. Nesting is bounded by `EncodingLimits.safe().max_depth`.\npub fn canonical(value: DataTree) -> String EncodingError! {{\n    out := [U8]{{}}\n    path := [String]{{}}\n    write_canonical(&out, value, &path, 1) ?? return Err(err)\n    Ok(String.from_bytes(out) ?? \"\")\n}}\n\n/// Streaming pull parser over `text`.  The first call validates and\n/// materializes the value, then subsequent calls walk its event sequence.\npub fn reader(text: String) -> JSONReader Never! {{ JSONReader{{parser: Parser.new(text.bytes(), false, false, safe_limits())}} }}\n\n/// Pull reader that reports every occurrence of a repeated object name as its\n/// own `Key` event instead of rejecting the document.\npub fn reader_allow_duplicates(text: String) -> JSONReader Never! {{ JSONReader{{parser: Parser.new(text.bytes(), true, true, safe_limits())}} }}\n\n/// RFC 6901 JSON Pointer selection (D-CORE-JSON-POINTER1=A). `\"\"` is the whole\n/// value and `/` the empty-named member; `~0` and `~1` escape `~` and `/`;\n/// array steps are canonical decimal indices (no `-`). JSON `null` is a value,\n/// not absence. A missing member, bad index, bad escape, or step into a scalar\n/// fails with the pointer prefix through the failing step. The walk borrows\n/// each ancestor; only the selected subtree is returned as an owned value.\n/// A pointer may have at most `EncodingLimits.safe().max_depth` steps.\npub fn pointer(tree: DataTree, path: String) -> DataTree EncodingError! {{\n    segments :: pointer_segments(path)\n    if segments.len() > safe_limits().max_depth {{\n        return Err(value_error(EncodingErrorKind.Limit, \"\", \"JSON Pointer has more than max_depth {{safe_limits().max_depth}} steps\"))\n    }}\n    pointer_select(tree, segments, 0)\n}}\n\n/// RFC 6902 JSON Patch (D-CORE-JSON-PATCH1=A) under `EncodingLimits.safe()`.\n/// See `patch_with_limits`.\npub fn patch(doc: DataTree, ops: DataTree) -> DataTree EncodingError! {{ patch_with_limits(doc, ops, safe_limits()) }}\n\n/// Apply an RFC 6902 operation array (`add`, `remove`, `replace`, `move`,\n/// `copy`, `test`) and return the patched value. The whole array is validated\n/// first; the operations then build a new value, so `doc` is unchanged when\n/// any operation fails. Errors name the operation as a pointer into `ops`\n/// (`/2`, `/2/from`) and quote the target path. `test` uses JSON equality:\n/// numbers compare by value, objects ignore member order. Limits:\n/// `max_item_bytes` bounds the compact size of `ops`, `max_depth` bounds each\n/// path and the result's nesting, `max_expansion_bytes` bounds the bytes that\n/// `copy` duplicates across the patch, and `max_total_bytes` (when set) bounds\n/// the compact size of the result.\npub fn patch_with_limits(doc: DataTree, ops: DataTree, limits: EncodingLimits) -> DataTree EncodingError! {{\n    if limits.max_depth < 1 || limits.max_item_bytes < 1 || limits.max_expansion_bytes < 0 {{\n        return Err(value_error(EncodingErrorKind.Limit, \"\", \"EncodingLimits.max_depth and max_item_bytes must be positive and max_expansion_bytes nonnegative\"))\n    }}\n    if render_json(ops, false).bytes().len() > limits.max_item_bytes {{\n        return Err(value_error(EncodingErrorKind.Limit, \"\", \"JSON Patch document exceeds max_item_bytes {{limits.max_item_bytes}}\"))\n    }}\n    operations :: patch_operations(ops, limits)\n    working := doc\n    expansion := 0\n    loop index in 0..<operations.len() {{\n        op :: operations[index]\n        target :: pointer_text(op.path, op.path.len())\n        if op.kind == PATCH_COPY {{\n            copied :: pointer_select(working, op.from, 0) ?? return Err(value_error(err.kind, \"/{{index}}\", \"operation {{index}} `copy` from `{{pointer_text(op.from, op.from.len())}}`: {{err.reason}}\"))\n            expansion += render_json(copied, false).bytes().len()\n            if expansion > limits.max_expansion_bytes {{\n                return Err(value_error(EncodingErrorKind.Limit, \"/{{index}}\", \"operation {{index}} `copy` duplicates more than max_expansion_bytes {{limits.max_expansion_bytes}}\"))\n            }}\n        }}\n        next_doc :: patch_step(working, op) ?? return Err(value_error(err.kind, \"/{{index}}\", \"operation {{index}} `{{op.name}}` at `{{target}}`: {{err.reason}}\"))\n        working = next_doc\n    }}\n    if tree_depth(working) > limits.max_depth {{\n        return Err(value_error(EncodingErrorKind.Limit, \"\", \"patched document nests deeper than max_depth {{limits.max_depth}}\"))\n    }}\n    if limits.max_total_bytes == {{\n        .Val(max) -> {{\n            if render_json(working, false).bytes().len() > max -> return Err(value_error(EncodingErrorKind.Limit, \"\", \"patched document exceeds max_total_bytes {{max}}\"))\n        }}\n        .None -> {{ _ := 0 }}\n    }}\n    Ok(working)\n}}\n\n/// Convert a parsed tree to the canonical streaming event sequence.\npub fn events(value: DataTree) -> [DataEvent] Never! {{ append_events(value) }}\n\npub fn writer() -> JSONWriter Never! {{ JSONWriter{{pretty: false, parts: [U8]{{}}}} }}\n\npub struct JSONReader {{\n    pub parser: Parser\n}}\n\nimpl JSONReader {{\n    pub fn next(&self) -> DataEvent EncodingError! {{ &self.parser.next_event() }}\n}}\n\npub struct JSONWriter {{\n    pub pretty: Bool\n    pub parts: [U8]\n}}\n\nimpl JSONWriter {{\n    pub fn write(&self, value: DataTree) Never! {{\n        chunk :: render_json(value, self.pretty).bytes()\n        loop b in chunk -> &self.parts.push(b)\n    }}\n\n    pub fn to_string(self) -> String Never! {{ String.from_bytes(self.parts) ?? \"\" }}\n}}\n\nstruct Parser {{\n    bytes: [U8]\n    index: Int\n    line: Int\n    column: Int\n    depth: Int\n    limits: EncodingLimits\n    path: [String]\n    pending: [DataEvent]\n    pending_index: Int\n    parsed: Bool\n    allow_duplicates: Bool\n    // Reader mode: append each value's events to `pending` as it is parsed,\n    // so a repeated object name appears once per occurrence.\n    recording: Bool\n}}\n\nimpl Parser {{\n    fn new(bytes: [U8], allow_duplicates: Bool, recording: Bool, limits: EncodingLimits) -> Parser Never! {{\n        Parser{{\n            bytes: bytes,\n            index: 0,\n            line: 1,\n            column: 1,\n            depth: 0,\n            limits: limits,\n            path: [String]{{}},\n            pending: [DataEvent]{{}},\n            pending_index: 0,\n            parsed: false,\n            allow_duplicates: allow_duplicates,\n            recording: recording,\n        }}\n    }}\n\n    fn eof(self) -> Bool Never! {{ self.index >= self.bytes.len() }}\n\n    fn peek(self) -> U8? {{\n        if self.eof() -> return None\n        Val(self.bytes[self.index])\n    }}\n\n    fn bump(&self) -> U8? {{\n        b :: self.peek() ?? return None\n        self.index += 1\n        if b == (U8{{10}}) {{\n            self.line += 1\n            self.column = 1\n        }} else {{\n            self.column += 1\n        }}\n        Val(b)\n    }}\n\n    fn err(self, reason: String) -> EncodingError Never! {{\n        return syntax_error(\n            EncodingFormat.JSON,\n            self.index,\n            self.line,\n            self.column,\n            \"/{{self.path.join(\"/\")}}\",\n            reason,\n        )\n    }}\n\n    fn skip_ws(&self) -> Bool EncodingError! {{\n        if self.index < 0 -> return Err(self.err(\"JSON parser index became negative\"))\n        loop {{\n            if self.peek() == {{\n                .None -> return true\n                .Val(b) -> {{\n                    n :: Int.from_u8(b)\n                    if n == 32 || n == 9 || n == 10 || n == 13 {{\n                        self.index += 1\n                        if n == 10 {{\n                            self.line += 1\n                            self.column = 1\n                        }} else {{\n                            self.column += 1\n                        }}\n                    }} else {{\n                        return true\n                    }}\n                }}\n            }}\n        }}\n        true\n    }}\n\n    fn expect(&self, want: U8) -> Bool Never! {{\n        b :: self.peek() ?? return false\n        if b != want -> return false\n        _ :: &self.bump()\n        true\n    }}\n\n\n    // Rust `Parser::value` (EncodingJson.rs:139-158).\n    fn parse_value(&self) -> DataTree EncodingError! {{\n        &self.skip_ws() ?? return Err(self.err(\"failed while scanning JSON whitespace\"))\n        b :: self.peek() ?? return Err(self.err(\"expected a JSON value\"))\n        n :: b\n        if n == {{\n            91 -> return &self.parse_array()\n            123 -> return &self.parse_object()\n            else -> {{ _ := 0 }}\n        }}\n        value := DataTree.Null\n        if n == 110 {{\n            value = &self.parse_literal(\"null\", DataTree.Null)\n        }} else {{\n            if n == 116 {{\n                value = &self.parse_literal(\"true\", DataTree.Bool(true))\n            }} else {{\n                if n == 102 {{\n                    value = &self.parse_literal(\"false\", DataTree.Bool(false))\n                }} else {{\n                    if n == 34 {{\n                        s :: &self.parse_string()\n                        value = DataTree.Text(s)\n                    }} else {{\n                        if n != 45 && (n < 48 || n > 57) -> return Err(self.err(\"expected a JSON value\"))\n                        value = &self.parse_number()\n                    }}\n                }}\n            }}\n        }}\n        if self.recording {{\n            loop event in append_events(value) -> &self.pending.push(event)\n        }}\n        Ok(value)\n    }}\n\n    // Rust `Parser::word` (EncodingJson.rs:160-168).\n    fn parse_literal(&self, spelling: String, value: DataTree) -> DataTree EncodingError! {{\n        loop b in spelling.bytes() {{\n            got :: self.peek() ?? return Err(self.err(\"expected a JSON word\"))\n            if got != b -> return Err(self.err(\"expected a JSON word\"))\n            _ :: &self.bump()\n        }}\n        Ok(value)\n    }}\n\n    // Rust `Parser::string` / `unicode_escape` (EncodingJson.rs:170-240).\n    fn parse_string(&self) -> String EncodingError! {{\n        if !&self.expect(U8{{34}}) -> return Err(self.err(\"expected quoted text\"))\n        out := [U8]{{}}\n        loop {{\n            b :: &self.bump() ?? return Err(self.err(\"missing closing quote\"))\n            n :: b\n            if n == 34 {{\n                s :: String.from_bytes(out) ?? return Err(self.err(\"invalid UTF-8 in string\"))\n                return Ok(s)\n            }}\n            if n < 32 -> return Err(self.err(\"control character in string\"))\n            if n != 92 {{\n                &out.push(b)\n                next\n            }}\n            esc :: &self.bump() ?? return Err(self.err(\"unfinished escape\"))\n            e :: esc\n            if e == 34 || e == 92 || e == 47 {{\n                &out.push(esc)\n                next\n            }}\n            if e == 98 {{\n                &out.push(U8{{8}})\n                next\n            }}\n            if e == 102 {{\n                &out.push(U8{{12}})\n                next\n            }}\n            if e == 110 {{\n                &out.push(U8{{10}})\n                next\n            }}\n            if e == 114 {{\n                &out.push(U8{{13}})\n                next\n            }}\n            if e == 116 {{\n                &out.push(U8{{9}})\n                next\n            }}\n            if e == 117 {{\n                cp := &self.parse_hex4()\n                if cp >= 55296 && cp <= 57343 {{\n                    if cp > 56319 -> return Err(self.err(\"unpaired surrogate in string\"))\n                    if !&self.expect(U8{{92}}) -> return Err(self.err(\"unpaired surrogate in string\"))\n                    if !&self.expect(U8{{117}}) -> return Err(self.err(\"unpaired surrogate in string\"))\n                    low :: &self.parse_hex4()\n                    if low < 56320 || low > 57343 -> return Err(self.err(\"unpaired surrogate in string\"))\n                    cp = 65536 + ((cp - 55296) << 10) + (low - 56320)\n                }}\n                utf8 := utf8_bytes(cp)\n                loop byte in utf8 -> &out.push(byte)\n                next\n            }}\n            return Err(self.err(\"invalid escape in string\"))\n        }}\n    }}\n\n    // Rust `Parser::hex4` (EncodingJson.rs:242-255).\n    fn parse_hex4(&self) -> Int EncodingError! {{\n        n := 0\n        loop _ in 0..<4 {{\n            b :: self.peek() ?? return Err(self.err(\"truncated unicode escape\"))\n            d :: hex_digit(b) ?? return Err(self.err(\"invalid unicode escape\"))\n            _ :: &self.bump()\n            n = n * 16 + d\n        }}\n        Ok(n)\n    }}\n\n    // Rust `Parser::number` (EncodingJson.rs:257-315), with exact Int rather\n    // than the retired Number carrier for integers outside i64 (#4306).\n    fn parse_number(&self) -> DataTree EncodingError! {{\n        start :: self.index\n        if (self.peek() ?? (U8{{0}})) == (U8{{45}}) -> _ :: &self.bump()\n        first :: self.peek() ?? return Err(self.err(\"bad number\"))\n        first_digit :: first\n        if first_digit < 48 || first_digit > 57 -> return Err(self.err(\"bad number\"))\n        if first_digit == 48 {{\n            _ :: &self.bump()\n        }} else {{\n            loop {{\n                n :: self.peek() ?? break\n                d :: n\n                if d >= 48 && d <= 57 {{\n                    _ :: &self.bump()\n                }} else {{\n                    break\n                }}\n            }}\n        }}\n        fractional := false\n        if (self.peek() ?? (U8{{0}})) == (U8{{46}}) {{\n            fractional = true\n            _ :: &self.bump()\n            digit :: self.peek() ?? return Err(self.err(\"bad number\"))\n            dn :: digit\n            if dn < 48 || dn > 57 -> return Err(self.err(\"bad number\"))\n            loop {{\n                n :: self.peek() ?? break\n                d :: n\n                if d >= 48 && d <= 57 {{\n                    _ :: &self.bump()\n                }} else {{\n                    break\n                }}\n            }}\n        }}\n        exp := false\n        ebyte :: self.peek() ?? (U8{{0}})\n        en :: ebyte\n        if en == 101 || en == 69 {{\n            exp = true\n            _ :: &self.bump()\n            sign :: self.peek() ?? (U8{{0}})\n            sn :: sign\n            if sn == 43 || sn == 45 -> _ :: &self.bump()\n            digit :: self.peek() ?? return Err(self.err(\"bad number\"))\n            dn :: digit\n            if dn < 48 || dn > 57 -> return Err(self.err(\"bad number\"))\n            loop {{\n                n :: self.peek() ?? break\n                d :: n\n                if d >= 48 && d <= 57 {{\n                    _ :: &self.bump()\n                }} else {{\n                    break\n                }}\n            }}\n        }}\n        // Rust validates the digit limit only for integers outside i64 in\n        // parse_json mode. Any integer this long is necessarily outside i64.\n        // Check before constructing the arbitrary-precision Int.\n        if !fractional && !exp {{\n            digits :: self.index - start - (if self.bytes[start] == (U8{{45}}) -> 1 else -> 0)\n            if digits > 1000000 -> return Err(self.err(\"JSON number exceeds the 1000000-digit limit\"))\n        }}\n        token :: String.from_bytes(self.bytes[start..self.index - 1]) ?? return Err(self.err(\"bad number\"))\n        if fractional || exp {{\n            f :: Float.parse(token) ?? return Err(self.err(\"bad number\"))\n            if !math.is_finite(f) -> return Err(self.err(\"bad number\"))\n            return Ok(DataTree.Float(f))\n        }}\n        n :: Int.parse(token) ?? return Err(self.err(\"bad number\"))\n        Ok(DataTree.Int(n))\n    }}\n\n    // Rust `Parser::array` (EncodingJson.rs:317-345).\n    fn parse_array(&self) -> DataTree EncodingError! {{\n        if !&self.enter() -> return Err(self.err(\"JSON value is nested too deeply\"))\n        _ :: &self.bump()\n        if self.recording -> &self.pending.push(DataEvent.ArrayStart)\n        items := [DataTree]{{}}\n        &self.skip_ws() ?? return Err(self.err(\"failed while scanning JSON whitespace\"))\n        if (self.peek() ?? (U8{{0}})) == (U8{{93}}) {{\n            _ :: &self.bump()\n            self.depth -= 1\n            if self.recording -> &self.pending.push(DataEvent.ArrayEnd)\n            return Ok(DataTree.Array(items))\n        }}\n        index := 0\n        loop {{\n            &self.path.push(\"{{index}}\")\n            value :: &self.parse_value()\n            _ :: &self.path.pop()\n            &items.push(value)\n            &self.skip_ws() ?? return Err(self.err(\"failed while scanning JSON whitespace\"))\n            b :: self.peek() ?? return Err(self.err(\"expected `,` or `]`\"))\n            if b == (U8{{93}}) {{\n                _ :: &self.bump()\n                self.depth -= 1\n                if self.recording -> &self.pending.push(DataEvent.ArrayEnd)\n                return Ok(DataTree.Array(items))\n            }}\n            if b != (U8{{44}}) -> return Err(self.err(\"expected `,` or `]`\"))\n            _ :: &self.bump()\n            &self.skip_ws() ?? return Err(self.err(\"failed while scanning JSON whitespace\"))\n            if (self.peek() ?? (U8{{0}})) == (U8{{93}}) -> return Err(self.err(\"expected `,` or `]`\"))\n            index += 1\n        }}\n    }}\n\n    // Rust `Parser::object` (EncodingJson.rs:347-394).\n    fn parse_object(&self) -> DataTree EncodingError! {{\n        if !&self.enter() -> return Err(self.err(\"JSON value is nested too deeply\"))\n        _ :: &self.bump()\n        if self.recording -> &self.pending.push(DataEvent.ObjectStart)\n        entries := [String: DataTree]{{}}\n        &self.skip_ws() ?? return Err(self.err(\"failed while scanning JSON whitespace\"))\n        if (self.peek() ?? (U8{{0}})) == (U8{{125}}) {{\n            _ :: &self.bump()\n            self.depth -= 1\n            if self.recording -> &self.pending.push(DataEvent.ObjectEnd)\n            return Ok(DataTree.Object(entries))\n        }}\n        loop {{\n            &self.skip_ws() ?? return Err(self.err(\"failed while scanning JSON whitespace\"))\n            key :: &self.parse_string()\n            &self.skip_ws() ?? return Err(self.err(\"failed while scanning JSON whitespace\"))\n            if !&self.expect(U8{{58}}) -> return Err(self.err(\"expected `:` after object key\"))\n            &self.path.push(key)\n            if self.recording -> &self.pending.push(DataEvent.Key(key))\n            if entries.has_key(key) {{\n                if !self.allow_duplicates {{\n                    error :: self.err(\"duplicate object key `{{key}}`\")\n                    _ :: &self.path.pop()\n                    return Err(error)\n                }}\n                later :: &self.parse_value()\n                entries = object_with(entries, key, later)\n            }} else {{\n                value :: &self.parse_value()\n                _ :: &entries.add(key, value)\n            }}\n            _ :: &self.path.pop()\n            &self.skip_ws() ?? return Err(self.err(\"failed while scanning JSON whitespace\"))\n            b :: self.peek() ?? return Err(self.err(\"expected `,` or `}}}}`\"))\n            if b == (U8{{125}}) {{\n                _ :: &self.bump()\n                self.depth -= 1\n                if self.recording -> &self.pending.push(DataEvent.ObjectEnd)\n                return Ok(DataTree.Object(entries))\n            }}\n            if b != (U8{{44}}) -> return Err(self.err(\"expected `,` or `}}}}`\"))\n            _ :: &self.bump()\n            &self.skip_ws() ?? return Err(self.err(\"failed while scanning JSON whitespace\"))\n            if (self.peek() ?? (U8{{0}})) == (U8{{125}}) -> return Err(self.err(\"expected `,` or `}}}}`\"))\n        }}\n    }}\n\n    fn enter(&self) -> Bool Never! {{\n        if self.depth >= self.limits.max_depth -> return false\n        self.depth += 1\n        true\n    }}\n    fn next_event(&self) -> DataEvent EncodingError! {{\n        if !self.parsed {{\n            if self.bytes.len() > self.limits.max_item_bytes {{\n                return Err(limit_error(EncodingFormat.JSON, 0, \"JSON input exceeds EncodingLimits.safe().max_item_bytes\"))\n            }}\n            &self.skip_ws() ?? return Err(self.err(\"failed while scanning JSON whitespace\"))\n            value :: &self.parse_value()\n            &self.skip_ws() ?? return Err(self.err(\"failed while scanning JSON whitespace\"))\n            if !self.eof() -> return Err(self.err(\"extra text after JSON value\"))\n            if !self.recording -> self.pending = append_events(value)\n            self.parsed = true\n        }}\n        if self.pending_index >= self.pending.len() {{\n            return Err(self.err(\"JSON reader is exhausted\"))\n        }}\n        ev :: self.pending[self.pending_index]\n        self.pending_index += 1\n        Ok(ev)\n    }}\n}}\n\n// Rust `parse_json_with_modes` (EncodingJson.rs:83-102), one limits-parameterized parser.\nfn parse_json(text: String, allow_duplicates: Bool, limits: EncodingLimits) -> DataTree EncodingError! {{\n    raw :: text.bytes()\n    if raw.len() > limits.max_item_bytes {{\n        return Err(limit_error(EncodingFormat.JSON, 0, \"JSON input exceeds EncodingLimits.safe().max_item_bytes\"))\n    }}\n    p := Parser.new(raw, allow_duplicates, false, limits)\n    value :: &p.parse_value()\n    &p.skip_ws() ?? return Err(p.err(\"failed while scanning JSON whitespace\"))\n    if !p.eof() -> return Err(p.err(\"extra text after JSON value\"))\n    Ok(value)\n}}\n\n// Rebuild an object with `key` bound to `value`, keeping member order: an\n// existing key keeps its position, a new key goes last.\nfn object_with(entries: [String: DataTree], key: String, value: DataTree) -> [String: DataTree] Never! {{\n    out := [String: DataTree]{{}}\n    found := false\n    loop pair in entries {{\n        if pair.key == key {{\n            found = true\n            _ :: &out.add(key, value)\n        }} else {{\n            _ :: &out.add(pair.key, pair.value)\n        }}\n    }}\n    if !found -> _ :: &out.add(key, value)\n    out\n}}\n\nfn append_events(value: DataTree) -> [DataEvent] Never! {{\n    out := [DataEvent]{{}}\n    if value == {{\n        .Null -> &out.push(DataEvent.Null)\n        .Bool(v) -> &out.push(DataEvent.Bool(v))\n        .Int(n) -> &out.push(DataEvent.Int(n))\n        .Float(n) -> &out.push(DataEvent.Float(n))\n        .Text(s) -> &out.push(DataEvent.Text(s))\n        .Array(items) -> {{\n            &out.push(DataEvent.ArrayStart)\n            loop item in items {{\n                chunk := append_events(item)\n                loop event in chunk -> &out.push(event)\n            }}\n            &out.push(DataEvent.ArrayEnd)\n        }}\n        .Object(entries) -> {{\n            &out.push(DataEvent.ObjectStart)\n            loop pair in entries {{\n                &out.push(DataEvent.Key(pair.key))\n                chunk := append_events(pair.value)\n                loop event in chunk -> &out.push(event)\n            }}\n            &out.push(DataEvent.ObjectEnd)\n        }}\n    }}\n    out\n}}\n\nfn hex_digit(b: U8) -> Int? {{\n    n :: u8_int(b)\n    if n >= 48 && n <= 57 -> return Val(n - 48)\n    if n >= 97 && n <= 102 -> return Val(n - 87)\n    if n >= 65 && n <= 70 -> return Val(n - 55)\n    None\n}}\nfn u8_int(b: U8) -> Int Never! {{ Int.from_u8(b) }}\nfn utf8_bytes(cp: Int) -> [U8] Never! {{\n    out := [U8]{{}}\n    if cp < 128 {{\n        &out.push(U8{{cp}})\n        return out\n    }}\n    if cp < 2048 {{\n        &out.push(U8{{192 | (cp >> 6)}})\n        &out.push(U8{{128 | (cp & 63)}})\n        return out\n    }}\n    if cp < 65536 {{\n        &out.push(U8{{224 | (cp >> 12)}})\n        &out.push(U8{{128 | ((cp >> 6) & 63)}})\n        &out.push(U8{{128 | (cp & 63)}})\n        return out\n    }}\n    &out.push(U8{{240 | (cp >> 18)}})\n    &out.push(U8{{128 | ((cp >> 12) & 63)}})\n    &out.push(U8{{128 | ((cp >> 6) & 63)}})\n    &out.push(U8{{128 | (cp & 63)}})\n    out\n}}\n\nfn render_json(value: DataTree, pretty: Bool) -> String Never! {{\n    out := [U8]{{}}\n    write_json(&out, value, pretty, 0)\n    String.from_bytes(out) ?? \"\"\n}}\n\nfn value_error(kind: EncodingErrorKind, path: String, reason: String) -> EncodingError Never! {{\n    {{\n        format: EncodingFormat.JSON,\n        kind: kind,\n        byte_offset: 0,\n        line: None,\n        column: None,\n        path: path,\n        reason: reason,\n        cause: None,\n    }}\n}}\n\nfn write_canonical(out: &[U8], value: DataTree, path: &[String], depth: Int) -> Bool EncodingError! {{\n    if depth > safe_limits().max_depth {{\n        return Err(value_error(EncodingErrorKind.Limit, pointer_text(path, path.len()), \"max_depth {{safe_limits().max_depth}} exceeded\"))\n    }}\n    if value == {{\n        .Null -> write_ascii(&out, \"null\")\n        .Bool(v) -> {{\n            if v -> write_ascii(&out, \"true\")\n            else -> write_ascii(&out, \"false\")\n        }}\n        .Int(n) -> {{\n            if !int_is_binary64(n) {{\n                return Err(value_error(EncodingErrorKind.Unsupported, pointer_text(path, path.len()), \"JCS requires Int exactly representable as IEEE 754 binary64; encode this integer as Text\"))\n            }}\n            write_ascii(&out, jcs_number(Float{{n}}))\n        }}\n        .Float(n) -> {{\n            if !math.is_finite(n) {{\n                return Err(value_error(EncodingErrorKind.Unsupported, pointer_text(path, path.len()), \"JCS cannot encode a non-finite Float\"))\n            }}\n            write_ascii(&out, jcs_number(n))\n        }}\n        .Text(s) -> write_json_string(&out, s)\n        .Array(items) -> {{\n            &out.push(U8{{91}})\n            loop i in 0..<items.len() {{\n                if i > 0 -> &out.push(U8{{44}})\n                &path.push(\"{{i}}\")\n                write_canonical(&out, items[i], &path, depth + 1) ?? return Err(err)\n                _ :: &path.pop()\n            }}\n            &out.push(U8{{93}})\n        }}\n        .Object(entries) -> {{\n            keys := [String]{{}}\n            values := [DataTree]{{}}\n            units := [[Int]]{{}}\n            loop pair in entries {{\n                &keys.push(pair.key)\n                &values.push(pair.value)\n                &units.push(utf16_units(pair.key))\n            }}\n            order :: sort_by_units(units)\n            &out.push(U8{{123}})\n            loop i in 0..<order.len() {{\n                at :: order[i]\n                &path.push(keys[at])\n                if i > 0 {{\n                    if compare_units(units[order[i - 1]], units[at]) == 0 {{\n                        return Err(value_error(EncodingErrorKind.Syntax, pointer_text(path, path.len()), \"JCS requires unique object keys\"))\n                    }}\n                    &out.push(U8{{44}})\n                }}\n                write_json_string(&out, keys[at])\n                &out.push(U8{{58}})\n                write_canonical(&out, values[at], &path, depth + 1) ?? return Err(err)\n                _ :: &path.pop()\n            }}\n            &out.push(U8{{125}})\n        }}\n    }}\n    true\n}}\n\n// RFC 8785 admits an Int only when binary64 holds it exactly: its odd part\n// must fit in the 53-bit significand.\nfn int_is_binary64(n: Int) -> Bool Never! {{\n    odd := n\n    loop odd != 0 && odd %% 2 == 0 {{\n        odd = odd /% 2\n    }}\n    if odd < 0 -> odd = -odd\n    odd <= 9007199254740992\n}}\n\n// ECMAScript Number::toString (ECMA-262 7.1.12.1) for a finite binary64, as\n// RFC 8785 requires. `\"{{value}}\"` supplies the shortest round-trip digits; this\n// function only re-spells them: exponent form below 1e-6 and from 1e21,\n// positional otherwise, `e+`/`e-` exponents, and `-0` as `0`.\nfn jcs_number(value: Float) -> String Never! {{\n    if value == (Float{{0.0}}) -> return \"0\"\n    negative :: value < (Float{{0.0}})\n    magnitude := value\n    if negative -> magnitude = -value\n    digits := [U8]{{}}\n    exponent_bytes := [U8]{{}}\n    decimal := -1\n    in_exponent := false\n    loop b in \"{{magnitude}}\".bytes() {{\n        if in_exponent {{\n            &exponent_bytes.push(b)\n            next\n        }}\n        if b == (U8{{101}}) || b == (U8{{69}}) {{\n            in_exponent = true\n            next\n        }}\n        if b == (U8{{46}}) {{\n            decimal = digits.len()\n            next\n        }}\n        &digits.push(b)\n    }}\n    if decimal < 0 -> decimal = digits.len()\n    exponent := 0\n    if exponent_bytes.len() > 0 -> exponent = Int.parse(String.from_bytes(exponent_bytes) ?? \"0\") ?? 0\n    leading := 0\n    loop leading < digits.len() && digits[leading] == (U8{{48}}) {{\n        leading += 1\n    }}\n    significant := [U8]{{}}\n    loop i in leading..<digits.len() -> &significant.push(digits[i])\n    loop significant.len() > 1 && significant[significant.len() - 1] == (U8{{48}}) {{\n        _ :: &significant.pop()\n    }}\n    n :: decimal + exponent - leading\n    k :: significant.len()\n    out := [U8]{{}}\n    if negative -> &out.push(U8{{45}})\n    if n > 0 && n <= 21 {{\n        if k <= n {{\n            loop b in significant -> &out.push(b)\n            loop _ in 0..<(n - k) -> &out.push(U8{{48}})\n        }} else {{\n            loop i in 0..<n -> &out.push(significant[i])\n            &out.push(U8{{46}})\n            loop i in n..<k -> &out.push(significant[i])\n        }}\n        return String.from_bytes(out) ?? \"\"\n    }}\n    if n > -6 && n <= 0 {{\n        write_ascii(&out, \"0.\")\n        loop _ in 0..<(0 - n) -> &out.push(U8{{48}})\n        loop b in significant -> &out.push(b)\n        return String.from_bytes(out) ?? \"\"\n    }}\n    &out.push(significant[0])\n    if k > 1 {{\n        &out.push(U8{{46}})\n        loop i in 1..<k -> &out.push(significant[i])\n    }}\n    &out.push(U8{{101}})\n    e :: n - 1\n    if e >= 0 -> &out.push(U8{{43}})\n    write_ascii(&out, \"{{e}}\")\n    String.from_bytes(out) ?? \"\"\n}}\n\n// UTF-16 code units of a key, the RFC 8785 sort order.\nfn utf16_units(text: String) -> [Int] Never! {{\n    units := [Int]{{}}\n    raw :: text.bytes()\n    i := 0\n    loop i < raw.len() {{\n        b :: Int.from_u8(raw[i])\n        cp := b\n        width := 1\n        if b >= 240 {{\n            cp = ((b & 7) << 18) | ((Int.from_u8(raw[i + 1]) & 63) << 12) | ((Int.from_u8(raw[i + 2]) & 63) << 6) | (Int.from_u8(raw[i + 3]) & 63)\n            width = 4\n        }}\n        if b >= 224 && b < 240 {{\n            cp = ((b & 15) << 12) | ((Int.from_u8(raw[i + 1]) & 63) << 6) | (Int.from_u8(raw[i + 2]) & 63)\n            width = 3\n        }}\n        if b >= 192 && b < 224 {{\n            cp = ((b & 31) << 6) | (Int.from_u8(raw[i + 1]) & 63)\n            width = 2\n        }}\n        if cp >= 65536 {{\n            &units.push(55296 + ((cp - 65536) >> 10))\n            &units.push(56320 + ((cp - 65536) & 1023))\n        }} else {{\n            &units.push(cp)\n        }}\n        i += width\n    }}\n    units\n}}\n\nfn compare_units(left: [Int], right: [Int]) -> Int Never! {{\n    n := left.len()\n    if right.len() < n -> n = right.len()\n    loop i in 0..<n {{\n        if left[i] < right[i] -> return -1\n        if left[i] > right[i] -> return 1\n    }}\n    if left.len() < right.len() -> return -1\n    if left.len() > right.len() -> return 1\n    0\n}}\n\n// Stable bottom-up merge sort of key indices: O(n log n) comparisons.\nfn sort_by_units(units: [[Int]]) -> [Int] Never! {{\n    order := [Int]{{}}\n    loop i in 0..<units.len() -> &order.push(i)\n    width := 1\n    loop width < order.len() {{\n        merged := [Int]{{}}\n        start := 0\n        loop start < order.len() {{\n            middle := start + width\n            if middle > order.len() -> middle = order.len()\n            end := start + 2 * width\n            if end > order.len() -> end = order.len()\n            left := start\n            right := middle\n            loop left < middle || right < end {{\n                take_left := right >= end\n                if !take_left && left < middle -> take_left = compare_units(units[order[left]], units[order[right]]) <= 0\n                if take_left {{\n                    &merged.push(order[left])\n                    left += 1\n                }} else {{\n                    &merged.push(order[right])\n                    right += 1\n                }}\n            }}\n            start = end\n        }}\n        order = merged\n        width = width * 2\n    }}\n    order\n}}\n\nfn write_json(out: &[U8], value: DataTree, pretty: Bool, indent: Int) Never! {{\n    if value == {{\n        .Null -> write_ascii(&out, \"null\")\n        .Bool(v) -> {{\n            if v -> write_ascii(&out, \"true\")\n            else -> write_ascii(&out, \"false\")\n        }}\n        .Int(n) -> write_ascii(&out, \"{{n}}\")\n        .Float(n) -> write_json_float(&out, n)\n        .Text(s) -> write_json_string(&out, s)\n        .Array(items) -> {{\n            &out.push(U8{{91}})\n            if items.len() == 0 {{\n                &out.push(U8{{93}})\n                return\n            }}\n            loop i in 0..<items.len() {{\n                if pretty {{\n                    &out.push(U8{{10}})\n                    write_indent(&out, indent + 1)\n                }}\n                write_json(&out, items[i], pretty, indent + 1)\n                if i + 1 < items.len() -> &out.push(U8{{44}})\n            }}\n            if pretty {{\n                &out.push(U8{{10}})\n                write_indent(&out, indent)\n            }}\n            &out.push(U8{{93}})\n        }}\n        .Object(entries) -> {{\n            &out.push(U8{{123}})\n            if entries.len() == 0 {{\n                &out.push(U8{{125}})\n                return\n            }}\n            i := 0\n            loop pair in entries {{\n                if pretty {{\n                    &out.push(U8{{10}})\n                    write_indent(&out, indent + 1)\n                }}\n                write_json_string(&out, pair.key)\n                &out.push(U8{{58}})\n                if pretty -> &out.push(U8{{32}})\n                write_json(&out, pair.value, pretty, indent + 1)\n                i += 1\n                if i < entries.len() -> &out.push(U8{{44}})\n            }}\n            if pretty {{\n                &out.push(U8{{10}})\n\n                write_indent(&out, indent)\n            }}\n            &out.push(U8{{125}})\n        }}\n    }}\n}}\nfn write_json_float(out: &[U8], n: Float) Never! {{\n    if math.is_finite(n) -> write_ascii(&out, \"{{n}}\") else -> write_ascii(&out, \"null\")\n}}\n\nfn write_ascii(out: &[U8], text: String) Never! {{\n    loop b in text.bytes() -> &out.push(b)\n}}\n\nfn write_indent(out: &[U8], n: Int) Never! {{\n    loop _ in 0..<n {{\n        &out.push(U8{{32}})\n        &out.push(U8{{32}})\n    }}\n}}\n\nfn write_json_string(out: &[U8], text: String) Never! {{\n    &out.push(U8{{34}})\n    loop b in text.bytes() {{\n        n :: b\n        if n == 34 {{\n            write_ascii(&out, \"\\\\\\\"\")\n            next\n        }}\n        if n == 92 {{\n            write_ascii(&out, \"\\\\\\\\\")\n            next\n        }}\n        if n == 8 {{\n            write_ascii(&out, \"\\\\b\")\n            next\n        }}\n        if n == 12 {{\n            write_ascii(&out, \"\\\\f\")\n            next\n        }}\n        if n == 10 {{\n            write_ascii(&out, \"\\\\n\")\n            next\n        }}\n        if n == 13 {{\n            write_ascii(&out, \"\\\\r\")\n            next\n        }}\n        if n == 9 {{\n            write_ascii(&out, \"\\\\t\")\n            next\n        }}\n        if n < 32 {{\n            write_ascii(&out, \"\\\\u00\")\n            &out.push(nibble(Int.from_u8(n) /% 16))\n            &out.push(nibble(Int.from_u8(n) %% 16))\n            next\n        }}\n        &out.push(b)\n    }}\n    &out.push(U8{{34}})\n}}\n\nfn nibble(n: Int) -> U8 Never! {{\n    if n < 10 -> return (U8{{48 + n}})\n    (U8{{87 + n}})\n}}\n\n// ---- RFC 6901 JSON Pointer ----\n\nfn pointer_escape(segment: String) -> String Never! {{\n    out := [U8]{{}}\n    loop b in segment.bytes() {{\n        if b == (U8{{126}}) {{\n            &out.push(U8{{126}})\n            &out.push(U8{{48}})\n            next\n        }}\n        if b == (U8{{47}}) {{\n            &out.push(U8{{126}})\n            &out.push(U8{{49}})\n            next\n        }}\n        &out.push(b)\n    }}\n    String.from_bytes(out) ?? \"\"\n}}\n\n// Pointer text for the first `count` decoded steps.\nfn pointer_text(segments: [String], count: Int) -> String Never! {{\n    out := \"\"\n    loop i in 0..<count -> out = \"{{out}}/{{pointer_escape(segments[i])}}\"\n    out\n}}\n\n// Decode pointer text into its unescaped steps. Patch paths reuse it.\nfn pointer_segments(path: String) -> [String] EncodingError! {{\n    segments := [String]{{}}\n    raw :: path.bytes()\n    if raw.len() == 0 -> return Ok(segments)\n    if raw[0] != (U8{{47}}) -> return Err(value_error(EncodingErrorKind.Syntax, \"\", \"a JSON Pointer is empty or starts with `/`\"))\n    current := [U8]{{}}\n    i := 1\n    loop i < raw.len() {{\n        b :: raw[i]\n        if b == (U8{{47}}) {{\n            &segments.push(String.from_bytes(current) ?? \"\")\n            current = [U8]{{}}\n            i += 1\n            next\n        }}\n        if b == (U8{{126}}) {{\n            escape := U8{{0}}\n            if i + 1 < raw.len() -> escape = raw[i + 1]\n            if escape == (U8{{48}}) {{\n                &current.push(U8{{126}})\n            }} else {{\n                if escape != (U8{{49}}) {{\n                    through := [U8]{{}}\n                    loop k in 0..<(i + 2) {{\n                        if k < raw.len() -> &through.push(raw[k])\n                    }}\n                    return Err(value_error(EncodingErrorKind.Syntax, String.from_bytes(through) ?? \"\", \"`~` in a JSON Pointer must be `~0` or `~1`\"))\n                }}\n                &current.push(U8{{47}})\n            }}\n            i += 2\n            next\n        }}\n        &current.push(b)\n        i += 1\n    }}\n    &segments.push(String.from_bytes(current) ?? \"\")\n    Ok(segments)\n}}\n\n// A canonical array index: `0` or a digit string without a leading zero.\nfn pointer_index(segment: String) -> Int? {{\n    raw :: segment.bytes()\n    if raw.len() == 0 || raw.len() > 18 -> return None\n    if raw.len() > 1 && raw[0] == (U8{{48}}) -> return None\n    n := 0\n    loop b in raw {{\n        d :: Int.from_u8(b)\n        if d < 48 || d > 57 -> return None\n        n = n * 10 + (d - 48)\n    }}\n    Val(n)\n}}\n\n// Walk by borrowing each ancestor; only the final node is returned.\nfn pointer_select(node: DataTree, segments: [String], depth: Int) -> DataTree EncodingError! {{\n    if depth == segments.len() -> return Ok(node)\n    segment :: segments[depth]\n    at :: pointer_text(segments, depth + 1)\n    if node == {{\n        .Object(entries) -> {{\n            child :: entries.get(segment) ?? return Err(value_error(EncodingErrorKind.Syntax, at, \"no object member named `{{segment}}`\"))\n            return pointer_select(child, segments, depth + 1)\n        }}\n        .Array(items) -> {{\n            index :: pointer_index(segment) ?? return Err(value_error(EncodingErrorKind.Syntax, at, \"array index `{{segment}}` is not a canonical nonnegative integer\"))\n            if index >= items.len() -> return Err(value_error(EncodingErrorKind.Syntax, at, \"array index {{index}} is out of range for length {{items.len()}}\"))\n            return pointer_select(items[index], segments, depth + 1)\n        }}\n        else -> {{ _ := 0 }}\n    }}\n    Err(value_error(EncodingErrorKind.Syntax, at, \"cannot select `{{segment}}` inside a scalar value\"))\n}}\n\nfn pointer_is_proper_prefix(prefix: [String], path: [String]) -> Bool Never! {{\n    if prefix.len() >= path.len() -> return false\n    loop i in 0..<prefix.len() {{\n        if prefix[i] != path[i] -> return false\n    }}\n    true\n}}\n\nfn pointer_equal(left: [String], right: [String]) -> Bool Never! {{\n    if left.len() != right.len() -> return false\n    loop i in 0..<left.len() {{\n        if left[i] != right[i] -> return false\n    }}\n    true\n}}\n\n// ---- RFC 6902 JSON Patch ----\n\nPATCH_ADD :: 0\nPATCH_REMOVE :: 1\nPATCH_REPLACE :: 2\nPATCH_MOVE :: 3\nPATCH_COPY :: 4\nPATCH_TEST :: 5\n\nstruct PatchOp {{\n    kind: Int\n    name: String\n    path: [String]\n    from: [String]\n    value: DataTree\n}}\n\nfn patch_field(members: [String: DataTree], index: Int, name: String) -> DataTree EncodingError! {{\n    value :: members.get(name) ?? return Err(value_error(EncodingErrorKind.Syntax, \"/{{index}}\", \"operation {{index}} needs a `{{name}}` member\"))\n    Ok(value)\n}}\n\nfn patch_pointer_field(members: [String: DataTree], index: Int, name: String, limits: EncodingLimits) -> [String] EncodingError! {{\n    raw :: patch_field(members, index, name)\n    text := \"\"\n    valid := false\n    if raw == {{\n        .Text(s) -> {{\n            text = s\n            valid = true\n        }}\n        else -> {{ _ := 0 }}\n    }}\n    if !valid -> return Err(value_error(EncodingErrorKind.Syntax, \"/{{index}}/{{name}}\", \"operation {{index}} `{{name}}` must be a JSON Pointer string\"))\n    segments :: pointer_segments(text) ?? return Err(value_error(EncodingErrorKind.Syntax, \"/{{index}}/{{name}}\", \"operation {{index}} `{{name}}`: {{err.reason}}\"))\n    if segments.len() > limits.max_depth -> return Err(value_error(EncodingErrorKind.Limit, \"/{{index}}/{{name}}\", \"operation {{index}} `{{name}}` has more than max_depth {{limits.max_depth}} steps\"))\n    Ok(segments)\n}}\n\n// Validate the whole operation array before any operation runs.\nfn patch_operations(ops: DataTree, limits: EncodingLimits) -> [PatchOp] EncodingError! {{\n    items := [DataTree]{{}}\n    is_array := false\n    if ops == {{\n        .Array(values) -> {{\n            items = values\n            is_array = true\n        }}\n        else -> {{ _ := 0 }}\n    }}\n    if !is_array -> return Err(value_error(EncodingErrorKind.Syntax, \"\", \"a JSON Patch document is an array of operation objects\"))\n    list := [PatchOp]{{}}\n    loop index in 0..<items.len() {{\n        members := [String: DataTree]{{}}\n        is_object := false\n        if items[index] == {{\n            .Object(fields) -> {{\n                members = fields\n                is_object = true\n            }}\n            else -> {{ _ := 0 }}\n        }}\n        if !is_object -> return Err(value_error(EncodingErrorKind.Syntax, \"/{{index}}\", \"operation {{index}} must be an object\"))\n        name := \"\"\n        op_value :: patch_field(members, index, \"op\")\n        if op_value == {{\n            .Text(s) -> name = s\n            else -> {{ _ := 0 }}\n        }}\n        kind := -1\n        if name == \"add\" -> kind = PATCH_ADD\n        if name == \"remove\" -> kind = PATCH_REMOVE\n        if name == \"replace\" -> kind = PATCH_REPLACE\n        if name == \"move\" -> kind = PATCH_MOVE\n        if name == \"copy\" -> kind = PATCH_COPY\n        if name == \"test\" -> kind = PATCH_TEST\n        if kind < 0 -> return Err(value_error(EncodingErrorKind.Syntax, \"/{{index}}/op\", \"operation {{index}} has unknown op `{{name}}`; use add, remove, replace, move, copy, or test\"))\n        path :: patch_pointer_field(members, index, \"path\", limits)\n        from := [String]{{}}\n        if kind == PATCH_MOVE || kind == PATCH_COPY -> from = patch_pointer_field(members, index, \"from\", limits)\n        value := DataTree.Null\n        if kind == PATCH_ADD || kind == PATCH_REPLACE || kind == PATCH_TEST -> value = patch_field(members, index, \"value\")\n        if kind == PATCH_MOVE && pointer_is_proper_prefix(from, path) {{\n            return Err(value_error(EncodingErrorKind.Syntax, \"/{{index}}/from\", \"operation {{index}} cannot move `{{pointer_text(from, from.len())}}` into its own descendant `{{pointer_text(path, path.len())}}`\"))\n        }}\n        &list.push(PatchOp{{kind: kind, name: name, path: path, from: from, value: value}})\n    }}\n    Ok(list)\n}}\n\n// Return `node` rebuilt along `segments` with one add/remove/replace applied.\n// Siblings off the path are shared, not rewritten.\nfn patch_edit(node: DataTree, segments: [String], depth: Int, kind: Int, value: DataTree) -> DataTree EncodingError! {{\n    if segments.len() == 0 {{\n        if kind == PATCH_REMOVE -> return Err(value_error(EncodingErrorKind.Syntax, \"\", \"cannot remove the document root\"))\n        return Ok(value)\n    }}\n    segment :: segments[depth]\n    at :: pointer_text(segments, depth + 1)\n    last :: depth + 1 == segments.len()\n    if node == {{\n        .Object(entries) -> {{\n            out := [String: DataTree]{{}}\n            found := false\n            loop pair in entries {{\n                if pair.key != segment {{\n                    _ :: &out.add(pair.key, pair.value)\n                    next\n                }}\n                found = true\n                if !last {{\n                    child :: patch_edit(pair.value, segments, depth + 1, kind, value)\n                    _ :: &out.add(pair.key, child)\n                    next\n                }}\n                if kind != PATCH_REMOVE -> _ :: &out.add(pair.key, value)\n            }}\n            if !found {{\n                if !last || kind != PATCH_ADD -> return Err(value_error(EncodingErrorKind.Syntax, at, \"no object member named `{{segment}}`\"))\n                _ :: &out.add(segment, value)\n            }}\n            return Ok(DataTree.Object(out))\n        }}\n        .Array(items) -> {{\n            appending :: last && kind == PATCH_ADD && segment == \"-\"\n            index := items.len()\n            if !appending -> index = pointer_index(segment) ?? return Err(value_error(EncodingErrorKind.Syntax, at, \"array index `{{segment}}` is not a canonical nonnegative integer\"))\n            bound := items.len()\n            if last && kind == PATCH_ADD -> bound = items.len() + 1\n            if index >= bound -> return Err(value_error(EncodingErrorKind.Syntax, at, \"array index {{index}} is out of range for length {{items.len()}}\"))\n            out := [DataTree]{{}}\n            loop i in 0..<items.len() {{\n                if i != index {{\n                    &out.push(items[i])\n                    next\n                }}\n                if !last {{\n                    child :: patch_edit(items[i], segments, depth + 1, kind, value)\n                    &out.push(child)\n                    next\n                }}\n                if kind == PATCH_ADD {{\n                    &out.push(value)\n                    &out.push(items[i])\n                    next\n                }}\n                if kind == PATCH_REPLACE -> &out.push(value)\n            }}\n            if last && kind == PATCH_ADD && index == items.len() -> &out.push(value)\n            return Ok(DataTree.Array(out))\n        }}\n        else -> {{ _ := 0 }}\n    }}\n    Err(value_error(EncodingErrorKind.Syntax, at, \"cannot address `{{segment}}` inside a scalar value\"))\n}}\n\n// RFC 6902 `test` equality: numbers by value, arrays in order, objects by\n// member set regardless of order.\nfn json_equal(left: DataTree, right: DataTree) -> Bool Never! {{\n    if left == {{\n        .Null -> {{\n            if right == {{\n                .Null -> return true\n                else -> return false\n            }}\n        }}\n        .Bool(a) -> {{\n            if right == {{\n                .Bool(b) -> return a == b\n                else -> return false\n            }}\n        }}\n        .Int(a) -> {{\n            if right == {{\n                .Int(b) -> return a == b\n                .Float(b) -> return Float{{a}} == b\n                else -> return false\n            }}\n        }}\n        .Float(a) -> {{\n            if right == {{\n                .Float(b) -> return a == b\n                .Int(b) -> return a == Float{{b}}\n                else -> return false\n            }}\n        }}\n        .Text(a) -> {{\n            if right == {{\n                .Text(b) -> return a == b\n                else -> return false\n            }}\n        }}\n        .Array(a) -> {{\n            if right == {{\n                .Array(b) -> {{\n                    if a.len() != b.len() -> return false\n                    loop i in 0..<a.len() {{\n                        if !json_equal(a[i], b[i]) -> return false\n                    }}\n                    return true\n                }}\n                else -> return false\n            }}\n        }}\n        .Object(a) -> {{\n            if right == {{\n                .Object(b) -> {{\n                    if a.len() != b.len() -> return false\n                    loop pair in a {{\n                        other :: b.get(pair.key) ?? return false\n                        if !json_equal(pair.value, other) -> return false\n                    }}\n                    return true\n                }}\n                else -> return false\n            }}\n        }}\n    }}\n    false\n}}\n\nfn tree_depth(value: DataTree) -> Int Never! {{\n    deepest := 0\n    if value == {{\n        .Array(items) -> {{\n            loop item in items {{\n                d :: tree_depth(item)\n                if d > deepest -> deepest = d\n            }}\n            return deepest + 1\n        }}\n        .Object(entries) -> {{\n            loop pair in entries {{\n                d :: tree_depth(pair.value)\n                if d > deepest -> deepest = d\n            }}\n            return deepest + 1\n        }}\n        else -> {{ _ := 0 }}\n    }}\n    0\n}}\n\nfn patch_step(doc: DataTree, op: PatchOp) -> DataTree EncodingError! {{\n    if op.kind == PATCH_TEST {{\n        actual :: pointer_select(doc, op.path, 0)\n        if !json_equal(actual, op.value) -> return Err(value_error(EncodingErrorKind.Syntax, pointer_text(op.path, op.path.len()), \"test failed: the value differs\"))\n        return Ok(doc)\n    }}\n    if op.kind == PATCH_MOVE {{\n        if pointer_equal(op.from, op.path) -> return Ok(doc)\n        moved :: pointer_select(doc, op.from, 0)\n        removed :: patch_edit(doc, op.from, 0, PATCH_REMOVE, DataTree.Null)\n        return patch_edit(removed, op.path, 0, PATCH_ADD, moved)\n    }}\n    if op.kind == PATCH_COPY {{\n        copied :: pointer_select(doc, op.from, 0)\n        return patch_edit(doc, op.path, 0, PATCH_ADD, copied)\n    }}\n    patch_edit(doc, op.path, 0, op.kind, op.value)\n}}\n"}
}

fn foundation_embedded_core_source_39() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.encoding.jsonl", alias: "core_core_encoding_jsonl", path: "Core/encoding/jsonl.jet", owner: "", owned_members: [String]{"append_line", "count_rows", "dumps", "first", "loads", "parse", "reader", "to_string", "writer"}, source: "// core.encoding.jsonl — JSON Lines (one JSON value per LF-terminated record).\n//\n// A record is one line; `\\r\\n` endings lose their `\\r`. Blank records (only\n// spaces or tabs) are skipped. Each other record must hold exactly one complete\n// JSON value, parsed by `core.encoding.json.parse`; two values on one line\n// (`{{}} {{}}`) are a syntax error, not two records, and a value may not span\n// lines. A record error keeps the JSON kind and reason and reports the stream\n// position: `line` is the record's line in the whole text, `byte_offset` counts\n// from the start of the text, and `path` starts with the record index among\n// non-blank records (`/2/name`).\n//\n// `parse`, `first`, `count_rows`, and `reader(text)` work on a `String` the\n// caller already holds, so the whole text is in memory; `reader(text)` only\n// defers the per-record parse. Bounded incremental reading from a file is the\n// `EncodingLimits` reader over `^files.FileReader` (encoding-decisions.md,\n// D-ENCSTREAM-SURFACE1=A), which buffers one record at a time.\n//\n// `to_string` writes one compact JSON value per record and a trailing newline so\n// concatenation of documents stays a valid JSONL stream. There is no pretty\n// form; pretty JSON contains newlines and would break the line protocol.\nuse core.encoding.[DataTree, EncodingError, EncodingFormat]\nuse core.encoding.json as json\n\n/// Parse every non-empty record as JSON. Allocates one `DataTree` per record.\npub fn parse(text: String) -> [DataTree] EncodingError! {{\n    rows := [DataTree]{{}}\n    index := 0\n    loop record in records_of(text) {{\n        if is_blank(record.text) -> next\n        &rows.push(parse_record(record, index))\n        index += 1\n    }}\n    Ok(rows)\n}}\n\n/// Compact JSONL text. Always ends with a newline when `rows` is non-empty.\npub fn to_string(rows: [DataTree]) -> String Never! {{\n    out := \"\"\n    loop row in rows -> out = \"{{out}}{{json.to_string(row)}}\\n\"\n    out\n}}\n\npub struct JSONLReader {{\n    pub rows: [String]\n    pub lines: [Int]\n    pub offsets: [Int]\n    pub index: Int\n    pub records_read: Int\n\n    /// The next non-blank record, or `None` after the last one.\n    pub fn next(&self) -> DataTree? EncodingError! {{\n        loop self.index < self.rows.len() {{\n            record :: JSONLRecord{{text: self.rows[self.index], line: self.lines[self.index], offset: self.offsets[self.index]}}\n            self.index += 1\n            if is_blank(record.text) -> next\n            value :: parse_record(record, self.records_read)\n            self.records_read += 1\n            return Val(value)\n        }}\n        Ok(None)\n    }}\n}}\n\npub struct JSONLWriter {{\n    pub parts: [String]\n\n    pub fn write(&self, value: DataTree) Never! {{ &self.parts.push(json.to_string(value)) }}\n\n    pub fn to_string(self) -> String Never! {{\n        out := \"\"\n        loop row in self.parts -> out = \"{{out}}{{row}}\\n\"\n        out\n    }}\n}}\n\npub fn reader(text: String) -> JSONLReader Never! {{\n    rows := [String]{{}}\n    lines := [Int]{{}}\n    offsets := [Int]{{}}\n    loop record in records_of(text) {{\n        &rows.push(record.text)\n        &lines.push(record.line)\n        &offsets.push(record.offset)\n    }}\n    {{rows: rows, lines: lines, offsets: offsets, index: 0, records_read: 0}}\n}}\n\npub fn writer() -> JSONLWriter Never! {{ {{parts: [String]{{}}}} }}\n\npub fn loads(text: String) -> [DataTree] EncodingError! {{ parse(text) }}\n\npub fn dumps(rows: [DataTree]) -> String Never! {{ to_string(rows) }}\n\npub fn count_rows(text: String) -> Int Never! {{\n    n := 0\n    loop record in records_of(text) {{\n        if !is_blank(record.text) -> n += 1\n    }}\n    n\n}}\n\npub fn append_line(text: String, value: DataTree) -> String Never! {{\n    if text.bytes().len() == 0 -> return \"{{json.to_string(value)}}\\n\"\n    last :: text.bytes()[text.bytes().len() - 1]\n    if last == (U8{{10}}) -> return \"{{text}}{{json.to_string(value)}}\\n\"\n    \"{{text}}\\n{{json.to_string(value)}}\\n\"\n}}\n\npub fn first(text: String) -> DataTree? EncodingError! {{\n    loop record in records_of(text) {{\n        if is_blank(record.text) -> next\n        return Val(parse_record(record, 0))\n    }}\n    Ok(None)\n}}\n\n// One line of the stream: its text without the line ending, its 1-based line\n// number, and the byte offset of its first byte in the whole text.\nstruct JSONLRecord {{\n    text: String\n    line: Int\n    offset: Int\n}}\n\nfn parse_record(record: JSONLRecord, index: Int) -> DataTree EncodingError! {{\n    value :: json.parse(record.text) ?? return Err(record_error(err, record, index))\n    Ok(value)\n}}\n\n// Re-anchor a record-local JSON error to the stream.\nfn record_error(error: EncodingError, record: JSONLRecord, index: Int) -> EncodingError Never! {{\n    inner := error.path\n    if inner == \"/\" -> inner = \"\"\n    {{\n        format: EncodingFormat.JSONL,\n        kind: error.kind,\n        byte_offset: record.offset + error.byte_offset,\n        line: Val(record.line),\n        column: error.column,\n        path: \"/{{index}}{{inner}}\",\n        reason: error.reason,\n        cause: error.cause,\n    }}\n}}\n\nfn is_blank(text: String) -> Bool Never! {{\n    if text.len() == 0 -> return true\n    loop b in text.bytes() {{\n        n :: b\n        if n != 32 && n != 9 -> return false\n    }}\n    true\n}}\n\nfn records_of(text: String) -> [JSONLRecord] Never! {{\n    records := [JSONLRecord]{{}}\n    raw :: text.bytes()\n    buf := [U8]{{}}\n    line := 1\n    start := 0\n    loop i in 0..<raw.len() {{\n        b :: raw[i]\n        if b != (U8{{10}}) {{\n            &buf.push(b)\n            next\n        }}\n        if buf.len() > 0 && buf[buf.len() - 1] == (U8{{13}}) -> _ :: &buf.pop()\n        &records.push(JSONLRecord{{text: String.from_bytes(buf) ?? \"\", line: line, offset: start}})\n        buf = [U8]{{}}\n        line += 1\n        start = i + 1\n    }}\n    if start < raw.len() {{\n        if buf.len() > 0 && buf[buf.len() - 1] == (U8{{13}}) -> _ :: &buf.pop()\n        &records.push(JSONLRecord{{text: String.from_bytes(buf) ?? \"\", line: line, offset: start}})\n    }}\n    records\n}}\n"}
}

fn foundation_embedded_core_source_40() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.encoding.toml", alias: "core_core_encoding_toml", path: "Core/encoding/toml.jet", owner: "", owned_members: [String]{"load", "loads", "parse"}, source: "// core.encoding.toml — TOML v1.0 values as DataTree.\n//\n// Implements the common document: comments, dotted keys, [tables]\n// [[arrays of tables]], strings (basic and literal), integers, floats\n// booleans, and inline tables/arrays. Datetimes stay text so this module\n// does not take a `core.time` dependency. Unsupported TOML constructs fail\n// closed with `EncodingError` rather than being delegated implicitly.\n//\n// `to_string` emits a minimal table document; it does not preserve comments.\n\nuse core.encoding.[DataTree, EncodingError, EncodingErrorKind, EncodingFormat]\n\nfn syntax_error(format: EncodingFormat, offset: Int, line: Int, column: Int, path: String, reason: String) -> EncodingError Never! {{\n    {{\n        format: format,\n        kind: EncodingErrorKind.Syntax,\n        byte_offset: offset,\n        line: Val(line),\n        column: Val(column),\n        path: path,\n        reason: reason,\n        cause: None,\n    }}\n}}\npub fn parse(text: String) -> DataTree EncodingError! {{ parse_toml(text) }}\n\npub fn decode(text: String) -> DataTree EncodingError! {{ parse_toml(text) }}\npub fn loads(text: String) -> DataTree EncodingError! {{ parse(text) }}\npub fn load(text: String) -> DataTree EncodingError! {{ parse(text) }}\n\npub fn to_string(value: DataTree) -> String Never! {{ render_toml(value) }}\n\nfn parse_toml(text: String) -> DataTree EncodingError! {{\n    p := TOMLParser{{bytes: text.bytes(), index: 0, line: 1, column: 1, root: [String:DataTree]{{}}}}\n    _ :: &p.document() ?? return Err(p.fail(\"TOML document could not be parsed\"))\n    Ok(DataTree.Object(p.root))\n}}\n\nstruct TOMLParser {{\n    bytes: [U8]\n    index: Int\n    line: Int\n    column: Int\n    root: [String:DataTree]\n}}\n\nimpl TOMLParser {{\n    fn eof(self) -> Bool Never! {{ self.index >= self.bytes.len() }}\n\n    fn peek(self) -> U8? {{\n        if self.eof() -> return None\n        Val(self.bytes[self.index])\n    }}\n\n    fn bump(&self) -> U8? {{\n        b :: self.peek() ?? return None\n        self.index += 1\n        if b == (U8{{10}}) {{\n            self.line += 1\n            self.column = 1\n        }} else {{ self.column += 1 }}\n        Val(b)\n    }}\n\n    fn fail(self, reason: String) -> EncodingError Never! {{\n        return syntax_error(\n        EncodingFormat.TOML,\n        self.index,\n        self.line,\n        self.column,\n        \"\",\n        reason,\n        )\n    }}\n\n    fn skip_ws(&self) -> Bool EncodingError! {{\n        if self.index < 0 -> return Err(self.fail(\"TOML parser index became negative\"))\n        loop {{\n            if self.peek() == {{\n                .None -> return true\n                .Val(b) -> {{\n                    n :: Int.from_u8(b)\n                    if n == 32 || n == 9 {{\n                        self.index += 1\n                        self.column += 1\n                        next\n                    }}\n                    if n == 35 {{\n                        loop {{\n                            if self.peek() == {{\n                                .None -> return true\n                                .Val(c) -> {{\n                                    cn :: Int.from_u8(c)\n                                    self.index += 1\n                                    if cn == 10 {{\n                                        self.line += 1\n                                        self.column = 1\n                                        return true\n                                    }}\n                                    self.column += 1\n                                }}\n                            }}\n                        }}\n                    }}\n                    return true\n                }}\n            }}\n        }}\n        true\n    }}\n\n    fn skip_space(&self) -> Bool EncodingError! {{\n        &self.skip_ws() ?? return Err(self.fail(\"TOML whitespace scan failed\"))\n        loop {{\n            if self.peek() == {{\n                .None -> return true\n                .Val(b) -> {{\n                    n :: Int.from_u8(b)\n                    if n == 10 || n == 13 {{\n                        self.index += 1\n                        self.line += 1\n                        self.column = 1\n                        &self.skip_ws() ?? return Err(self.fail(\"TOML whitespace scan failed\"))\n                        next\n                    }}\n                    return true\n                }}\n            }}\n        }}\n        true\n    }}\n\n    fn document(&self) -> Bool EncodingError! {{\n        current := [String]{{}}\n        &self.skip_space() ?? return Err(self.fail(\"TOML whitespace scan failed\"))\n        loop self.eof() == false {{\n            &self.skip_space() ?? return Err(self.fail(\"TOML whitespace scan failed\"))\n            if self.eof() -> return true\n            b :: self.peek() ?? return true\n            if b == (U8{{91}}) {{\n                header :: &self.parse_header()\n                current = header\n                next\n            }}\n            keys :: &self.parse_dotted_key()\n            &self.skip_ws() ?? return Err(self.fail(\"TOML whitespace scan failed\"))\n            got :: &self.bump() ?? return Err(self.fail(\"expected '=' after a key\"))\n            if got != (U8{{61}}) -> return Err(self.fail(\"expected '=' after a key\"))\n            &self.skip_ws() ?? return Err(self.fail(\"TOML whitespace scan failed\"))\n            value :: &self.parse_value()\n            _ :: &self.assign(current, keys, value) ?? return Err(self.fail(\"TOML assignment failed\"))\n            &self.skip_space() ?? return Err(self.fail(\"TOML whitespace scan failed\"))\n        }}\n        true\n    }}\n\n    fn parse_header(&self) -> [String] EncodingError! {{\n        _ :: &self.bump()\n        array := false\n        b0 :: self.peek() ?? (U8{{0}})\n        if b0 == (U8{{91}}) {{\n            array = true\n            _ :: &self.bump()\n        }}\n        keys := [String]{{}}\n        key :: &self.parse_key()\n        &keys.push(key)\n        loop {{\n            b :: self.peek() ?? (U8{{0}})\n            if b != (U8{{46}}) -> break\n            _ :: &self.bump()\n            key2 :: &self.parse_key()\n            &keys.push(key2)\n        }}\n        &self.skip_ws() ?? return Err(self.fail(\"TOML whitespace scan failed\"))\n        close :: &self.bump() ?? return Err(self.fail(\"unterminated TOML table header\"))\n        if close != (U8{{93}}) -> return Err(self.fail(\"expected ']' after a TOML table header\"))\n        if array {{\n            close2 :: &self.bump() ?? return Err(self.fail(\"unterminated TOML array-of-tables header\"))\n            if close2 != (U8{{93}}) -> return Err(self.fail(\"expected ']]' after a TOML array-of-tables header\"))\n        }}\n        if array {{\n            self.root = ensure_array_path(self.root, keys, 0)\n        }} else {{\n            self.root = ensure_table_path(self.root, keys, 0)\n        }}\n        Ok(keys)\n    }}\n\n    fn parse_key(&self) -> String EncodingError! {{\n        &self.skip_ws() ?? return Err(self.fail(\"TOML whitespace scan failed\"))\n        b :: self.peek() ?? return Err(self.fail(\"expected a key\"))\n        if b == (U8{{34}}) -> return &self.parse_basic_string()\n        out := [U8]{{}}\n        loop {{\n            c :: self.peek() ?? break\n            n :: c\n            bare :: (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || (n >= 48 && n <= 57) || n == 95 || n == 45\n            if bare == false -> break\n            &out.push(c)\n            _ :: &self.bump()\n        }}\n        if out.len() == 0 -> return Err(self.fail(\"expected a bare key or quoted key\"))\n        Ok(String.from_bytes(out) ?? \"\")\n    }}\n\n    fn parse_dotted_key(&self) -> [String] EncodingError! {{\n        keys := [String]{{}}\n        key :: &self.parse_key()\n        &keys.push(key)\n        loop {{\n            b :: self.peek() ?? (U8{{0}})\n            if b != (U8{{46}}) -> break\n            _ :: &self.bump()\n            next_key :: &self.parse_key()\n            &keys.push(next_key)\n        }}\n        Ok(keys)\n    }}\n\n    fn parse_value(&self) -> DataTree EncodingError! {{\n        &self.skip_ws() ?? return Err(self.fail(\"TOML whitespace scan failed\"))\n        b :: self.peek() ?? return Err(self.fail(\"expected a value\"))\n        n :: b\n        if n == 10 || n == 13 -> return Err(self.fail(\"expected a value before the end of the TOML line\"))\n        if n == {{\n            34 -> {{\n                s :: &self.parse_basic_string()\n                return Ok(DataTree.Text(s))\n            }}\n            39 -> {{\n                s :: &self.parse_literal_string()\n                return Ok(DataTree.Text(s))\n            }}\n            91 -> return &self.parse_array()\n            123 -> return &self.parse_inline_table()\n            116 -> return &self.parse_word(\"true\", DataTree.Bool(true))\n            102 -> return &self.parse_word(\"false\", DataTree.Bool(false))\n            else -> &self.parse_number_or_text()\n        }}\n    }}\n\n    fn parse_word(&self, spelling: String, value: DataTree) -> DataTree EncodingError! {{\n        loop b in spelling.bytes() {{\n            got :: &self.bump() ?? return Err(self.fail(\"expected `{{spelling}}`\"))\n            if got != b -> return Err(self.fail(\"expected `{{spelling}}`\"))\n        }}\n        next :: self.peek() ?? (U8{{0}})\n        n :: next\n        if (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || (n >= 48 && n <= 57) || n == 95 || n == 45 {{\n            return Err(self.fail(\"TOML bare values must be delimited\"))\n        }}\n        Ok(value)\n    }}\n\n    fn parse_basic_string(&self) -> String EncodingError! {{\n        _ :: &self.bump()\n        out := [U8]{{}}\n        loop {{\n            b :: &self.bump() ?? return Err(self.fail(\"unterminated TOML string\"))\n            if b == (U8{{34}}) {{\n                s :: String.from_bytes(out) ?? return Err(self.fail(\"invalid UTF-8 in TOML string\"))\n                return Ok(s)\n            }}\n            if b == (U8{{10}}) || b == (U8{{13}}) -> return Err(self.fail(\"newline is not allowed in a basic TOML string\"))\n            if b == (U8{{92}}) {{\n                esc :: &self.bump() ?? return Err(self.fail(\"truncated escape\"))\n                if esc == (U8{{98}}) -> &out.push(U8{{8}})\n                else if esc == (U8{{116}}) -> &out.push(U8{{9}})\n                else if esc == (U8{{110}}) -> &out.push(U8{{10}})\n                else if esc == (U8{{102}}) -> &out.push(U8{{12}})\n                else if esc == (U8{{114}}) -> &out.push(U8{{13}})\n                else if esc == (U8{{34}}) || esc == (U8{{92}}) -> &out.push(esc)\n                else -> return Err(self.fail(\"unknown TOML basic-string escape\"))\n                next\n            }}\n            &out.push(b)\n        }}\n    }}\n\n    fn parse_literal_string(&self) -> String EncodingError! {{\n        _ :: &self.bump()\n        out := [U8]{{}}\n        loop {{\n            b :: &self.bump() ?? return Err(self.fail(\"unterminated literal string\"))\n            if b == (U8{{39}}) {{\n                s :: String.from_bytes(out) ?? return Err(self.fail(\"invalid UTF-8 in TOML string\"))\n                return Ok(s)\n            }}\n            &out.push(b)\n        }}\n    }}\n\n    fn parse_array(&self) -> DataTree EncodingError! {{\n        _ :: &self.bump()\n        items := [DataTree]{{}}\n        loop {{\n            &self.skip_space() ?? return Err(self.fail(\"TOML whitespace scan failed\"))\n            b0 :: self.peek() ?? (U8{{0}})\n            if b0 == (U8{{93}}) {{\n                _ :: &self.bump()\n                return Ok(DataTree.Array(items))\n            }}\n            value :: &self.parse_value()\n            &items.push(value)\n            &self.skip_space() ?? return Err(self.fail(\"TOML whitespace scan failed\"))\n            b :: self.peek() ?? return Err(self.fail(\"unterminated TOML array\"))\n            if b == (U8{{93}}) {{\n                _ :: &self.bump()\n                return Ok(DataTree.Array(items))\n            }}\n            if b != (U8{{44}}) -> return Err(self.fail(\"expected ',' or ']' after a TOML array value\"))\n            _ :: &self.bump()\n        }}\n    }}\n\n    fn parse_inline_table(&self) -> DataTree EncodingError! {{\n        _ :: &self.bump()\n        entries := [String:DataTree]{{}}\n        loop {{\n            &self.skip_ws() ?? return Err(self.fail(\"TOML whitespace scan failed\"))\n            b0 :: self.peek() ?? (U8{{0}})\n            if b0 == (U8{{125}}) {{\n                _ :: &self.bump()\n                return Ok(DataTree.Object(entries))\n            }}\n            key :: &self.parse_key()\n            if entries.has_key(key) -> return Err(self.fail(\"duplicate key in TOML inline table\"))\n            eq :: &self.bump() ?? return Err(self.fail(\"expected '='\"))\n            if eq != (U8{{61}}) -> return Err(self.fail(\"expected '='\"))\n            value :: &self.parse_value()\n            _ :: &entries.add(key, value)\n            &self.skip_ws() ?? return Err(self.fail(\"TOML whitespace scan failed\"))\n            b :: self.peek() ?? return Err(self.fail(\"unterminated TOML inline table\"))\n            if b == (U8{{125}}) {{\n                _ :: &self.bump()\n                return Ok(DataTree.Object(entries))\n            }}\n            if b != (U8{{44}}) -> return Err(self.fail(\"expected ',' or '}}}}' after a TOML inline-table value\"))\n            _ :: &self.bump()\n        }}\n    }}\n\n    fn parse_number_or_text(&self) -> DataTree EncodingError! {{\n        start :: self.index\n        loop {{\n            b :: self.peek() ?? break\n            n :: b\n            stop :: n == 32 || n == 9 || n == 10 || n == 13 || n == 44 || n == 93 || n == 125 || n == 35\n            if stop -> break\n            _ :: &self.bump()\n        }}\n        if self.index <= start -> return Err(self.fail(\"expected a TOML value\"))\n        token :: String.from_bytes(self.bytes[start..self.index - 1]) ?? \"\"\n        clean :: remove_underscores(token)\n        if parse_radix_int(clean) == {{\n            .Val(n) -> return Ok(DataTree.Int(n))\n            else -> {{ _ := 0 }}\n        }}\n        if Int.parse(clean) == {{\n            .Ok(n) -> return Ok(DataTree.Int(n))\n            else -> {{ _ := 0 }}\n        }}\n        if Float.parse(clean) == {{\n            .Ok(n) -> return Ok(DataTree.Float(n))\n            else -> {{ _ := 0 }}\n        }}\n        if looks_toml_datetime(clean) -> return Ok(DataTree.Text(token))\n        return Err(self.fail(\"unsupported TOML bare value; quote text or use a TOML number, boolean, or datetime\"))\n    }}\n\n    fn ensure_table(&self, keys: [String]) {{\n        self.root = ensure_table_path(self.root, keys, 0)\n    }}\n\n    fn ensure_array_table(&self, keys: [String]) {{\n        self.root = ensure_array_path(self.root, keys, 0)\n    }}\n\n    fn assign(&self, table: [String], key: [String], value: DataTree) -> Bool EncodingError! {{\n        path := [String]{{}}\n        loop k in table -> &path.push(k)\n        loop k in key -> &path.push(k)\n        if has_path(self.root, path, 0) -> return Err(self.fail(\"duplicate TOML key\"))\n        self.root = put_path(self.root, path, 0, value)\n        true\n    }}\n}}\n\nfn remove_underscores(text: String) -> String Never! {{\n    out := [U8]{{}}\n    loop b in text.bytes() {{\n        if b != (U8{{95}}) -> &out.push(b)\n    }}\n    String.from_bytes(out) ?? text\n}}\n\nfn looks_toml_datetime(text: String) -> Bool Never! {{\n    raw :: text.bytes()\n    if valid_toml_date(raw, 0, raw.len()) -> return true\n    if valid_toml_time(raw, 0, raw.len()) -> return true\n    if raw.len() < 19 || !valid_toml_date(raw, 0, 10) -> return false\n    if raw[10] != (U8{{84}}) && raw[10] != (U8{{116}}) -> return false\n\n    time_end := 19\n    if raw.len() > time_end && raw[time_end] == (U8{{46}}) {{\n        time_end += 1\n        fraction_start := time_end\n        loop time_end < raw.len() {{\n            n :: raw[time_end]\n            if n < 48 || n > 57 -> break\n            time_end += 1\n        }}\n        if time_end == fraction_start -> return false\n    }}\n    if !valid_toml_time(raw, 11, time_end) -> return false\n    if time_end == raw.len() -> return true\n    if time_end + 1 == raw.len() && raw[time_end] == (U8{{90}}) -> return true\n    if time_end + 6 != raw.len() || (raw[time_end] != (U8{{43}}) && raw[time_end] != (U8{{45}})) || raw[time_end + 3] != (U8{{58}}) {{\n        return false\n    }}\n    hour :: toml_two_digits(raw, time_end + 1, raw.len()) ?? return false\n    minute :: toml_two_digits(raw, time_end + 4, raw.len()) ?? return false\n    hour <= 23 && minute <= 59\n}}\n\nfn valid_toml_date(raw: [U8], start: Int, end: Int) -> Bool Never! {{\n    if start < 0 || end > raw.len() || start + 10 != end -> return false\n    if raw[start + 4] != (U8{{45}}) || raw[start + 7] != (U8{{45}}) -> return false\n    year :: toml_four_digits(raw, start, end) ?? return false\n    month :: toml_two_digits(raw, start + 5, end) ?? return false\n    day :: toml_two_digits(raw, start + 8, end) ?? return false\n    if month < 1 || month > 12 || day < 1 -> return false\n    max_day := 31\n    if month == 4 || month == 6 || month == 9 || month == 11 -> max_day = 30\n    if month == 2 {{\n        max_day = 28\n        if year %% 4 == 0 && (year %% 100 != 0 || year %% 400 == 0) -> max_day = 29\n    }}\n    day <= max_day\n}}\n\nfn valid_toml_time(raw: [U8], start: Int, end: Int) -> Bool Never! {{\n    if start < 0 || end > raw.len() || start + 8 > end -> return false\n    if raw[start + 2] != (U8{{58}}) || raw[start + 5] != (U8{{58}}) -> return false\n    hour :: toml_two_digits(raw, start, end) ?? return false\n    minute :: toml_two_digits(raw, start + 3, end) ?? return false\n    second :: toml_two_digits(raw, start + 6, end) ?? return false\n    if hour > 23 || minute > 59 || second > 59 -> return false\n    if start + 8 == end -> return true\n    if raw[start + 8] != (U8{{46}}) || start + 9 >= end -> return false\n    loop i in (start + 9)..<end {{\n        if raw[i] < 48 || raw[i] > 57 -> return false\n    }}\n    true\n}}\n\nfn toml_two_digits(raw: [U8], start: Int, end: Int) -> Int? {{\n    if start < 0 || end > raw.len() || start + 2 > end -> return None\n    a :: Int.from_u8(raw[start])\n    b :: Int.from_u8(raw[start + 1])\n    if a < 48 || a > 57 || b < 48 || b > 57 -> return None\n    Val((a - 48) * 10 + (b - 48))\n}}\n\nfn toml_four_digits(raw: [U8], start: Int, end: Int) -> Int? {{\n    if start < 0 || end > raw.len() || start + 4 > end -> return None\n    value := 0\n    loop i in start..<(start + 4) {{\n        n :: raw[i]\n        if n < 48 || n > 57 -> return None\n        value = value * 10 + (n - 48)\n    }}\n    Val(value)\n}}\nfn parse_radix_int(text: String) -> Int? {{\n    raw :: text.bytes()\n    if raw.len() < 3 -> return None\n    sign := 1\n    start := 0\n    if raw[0] == (U8{{43}}) || raw[0] == (U8{{45}}) {{\n        if raw[0] == (U8{{45}}) -> sign = -1\n        start = 1\n    }}\n    if start + 2 > raw.len() || raw[start] != (U8{{48}}) -> return None\n    base := 0\n    if raw[start + 1] == (U8{{120}}) -> base = 16\n    if raw[start + 1] == (U8{{111}}) -> base = 8\n    if raw[start + 1] == (U8{{98}}) -> base = 2\n    if base == 0 -> return None\n    if start + 2 >= raw.len() -> return None\n    n := 0\n    i := start + 2\n    loop i < raw.len() {{\n        d :: radix_digit(raw[i], base)\n        if d < 0 -> return None\n        n = n * base + d\n        i += 1\n    }}\n    Val(sign * n)\n}}\n\nfn radix_digit(b: U8, base: Int) -> Int Never! {{\n    n :: Int.from_