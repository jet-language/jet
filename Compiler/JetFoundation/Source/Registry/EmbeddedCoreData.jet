<= 191 && third >= 128 && third <= 191 && fourth >= 128 && fourth <= 191 {{\n                if first != 240 || second >= 144 {{\n                    if first != 244 || second <= 143 -> return 4\n                }}\n            }}\n        }}\n    }}\n    1\n}}\nfn encode_cp(cp: Int) -> String {{\n    n := cp\n    if n < 0 || n > 1114111 || (n >= 55296 && n <= 57343) -> n = 65533\n    out := [U8]{{}}\n    if n < 128 {{\n        &out.push(U8{{n}})\n    }} else if n < 2048 {{\n        &out.push(U8{{Int{{192}} | (n >> 6)}})\n        &out.push(U8{{Int{{128}} | (n & Int{{63}})}})\n    }} else if n < 65536 {{\n        &out.push(U8{{Int{{224}} | (n >> 12)}})\n        &out.push(U8{{Int{{128}} | ((n >> 6) & Int{{63}})}})\n        &out.push(U8{{Int{{128}} | (n & Int{{63}})}})\n    }} else {{\n        &out.push(U8{{Int{{240}} | (n >> 18)}})\n        &out.push(U8{{Int{{128}} | ((n >> 12) & Int{{63}})}})\n        &out.push(U8{{Int{{128}} | ((n >> 6) & Int{{63}})}})\n        &out.push(U8{{Int{{128}} | (n & Int{{63}})}})\n    }}\n    String.from_bytes(out) ?? \"\"\n}}\n\nfn encode_cps(cps: [Int]) -> String {{\n    out := \"\"\n    loop cp in cps -> out = \"{{out}}{{encode_cp(cp)}}\"\n    out\n}}\n\nfn map_case(text: String, to_upper: Bool) -> String {{\n    out := \"\"\n    loop cp in decode_scalars(text) -> out = \"{{out}}{{case_string(cp, to_upper)}}\"\n    out\n}}\n\nfn case_string(cp: Int, to_upper: Bool) -> String {{\n    if to_upper {{\n        if cp == 223 || cp == 7838 -> return \"SS\"\n        if cp >= 97 && cp <= 122 -> return encode_cp(cp - 32)\n        if cp >= 224 && cp <= 254 && cp != 247 -> return encode_cp(cp - 32)\n        if cp == 255 -> return encode_cp(376)\n        if cp >= 945 && cp <= 961 -> return encode_cp(cp - 32)\n        if cp >= 963 && cp <= 969 -> return encode_cp(cp - 32)\n        if cp >= 1072 && cp <= 1103 -> return encode_cp(cp - 32)\n        return encode_cp(cp)\n    }}\n    if cp >= 65 && cp <= 90 -> return encode_cp(cp + 32)\n    if cp >= 192 && cp <= 222 && cp != 215 -> return encode_cp(cp + 32)\n    if cp == 376 -> return encode_cp(255)\n    if cp >= 913 && cp <= 929 -> return encode_cp(cp + 32)\n    if cp >= 931 && cp <= 939 -> return encode_cp(cp + 32)\n    if cp >= 1040 && cp <= 1071 -> return encode_cp(cp + 32)\n    encode_cp(cp)\n}}\n\nfn fold_case(text: String) -> String {{\n    out := \"\"\n    loop cp in decode_scalars(text) {{\n        if cp == 223 || cp == 7838 {{\n            out = \"{{out}}ss\"\n        }} else if cp == 304 {{\n            out = \"{{out}}i{{encode_cp(775)}}\"\n        }} else if cp == 962 {{\n            out = \"{{out}}{{encode_cp(963)}}\"\n        }} else if cp == 8490 {{\n            out = \"{{out}}k\"\n        }} else if cp == 8491 {{\n            out = \"{{out}}{{encode_cp(229)}}\"\n        }} else {{\n            out = \"{{out}}{{case_string(cp, false)}}\"\n        }}\n    }}\n    out\n}}\n\nfn is_alpha_cp(cp: Int) -> Bool {{\n    if (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122) -> return true\n    if (cp >= 192 && cp <= 214) || (cp >= 216 && cp <= 246) || (cp >= 248 && cp <= 255) -> return true\n    if cp >= 256 && cp <= 687 -> return true\n    if cp >= 880 && cp <= 1023 -> return true\n    if cp >= 1024 && cp <= 1279 -> return true\n    if cp >= 1329 && cp <= 1366 -> return true\n    if cp >= 1377 && cp <= 1415 -> return true\n    if cp >= 1424 && cp <= 1469 -> return true\n    if cp >= 1471 && cp <= 1471 -> return true\n    if cp >= 1488 && cp <= 1514 -> return true\n    if cp >= 1568 && cp <= 1747 -> return true\n    if cp >= 1810 && cp <= 1866 -> return true\n    if cp >= 1994 && cp <= 2026 -> return true\n    if cp >= 2304 && cp <= 2423 -> return true\n    if cp >= 2437 && cp <= 2444 -> return true\n    if cp >= 2561 && cp <= 2576 -> return true\n    if cp >= 3585 && cp <= 3632 -> return true\n    if cp >= 4256 && cp <= 4293 -> return true\n    if cp >= 4304 && cp <= 4346 -> return true\n    if cp >= 4352 && cp <= 4607 -> return true\n    if cp >= 7680 && cp <= 7935 -> return true\n    if cp >= 7936 && cp <= 8191 -> return true\n    if cp >= 8448 && cp <= 8521 -> return true\n    if cp >= 11264 && cp <= 11310 -> return true\n    if cp >= 11312 && cp <= 11358 -> return true\n    if cp >= 19968 && cp <= 40959 -> return true\n    if cp >= 44032 && cp <= 55203 -> return true\n    if cp >= 65313 && cp <= 65338 -> return true\n    if cp >= 65345 && cp <= 65370 -> return true\n    if cp >= 66560 && cp <= 66639 -> return true\n    false\n}}\n\nfn is_digit_cp(cp: Int) -> Bool {{\n    if cp >= 48 && cp <= 57 -> return true\n    if cp >= 1632 && cp <= 1641 -> return true\n    if cp >= 1776 && cp <= 1785 -> return true\n    if cp >= 1984 && cp <= 1993 -> return true\n    if cp >= 2406 && cp <= 2415 -> return true\n    if cp >= 2534 && cp <= 2543 -> return true\n    if cp >= 2662 && cp <= 2671 -> return true\n    if cp >= 2790 && cp <= 2799 -> return true\n    if cp >= 2918 && cp <= 2927 -> return true\n    if cp >= 3046 && cp <= 3055 -> return true\n    if cp >= 3174 && cp <= 3183 -> return true\n    if cp >= 3302 && cp <= 3311 -> return true\n    if cp >= 3430 && cp <= 3439 -> return true\n    if cp >= 3558 && cp <= 3567 -> return true\n    if cp >= 3664 && cp <= 3673 -> return true\n    if cp >= 3792 && cp <= 3801 -> return true\n    if cp >= 3872 && cp <= 3881 -> return true\n    if cp >= 4160 && cp <= 4169 -> return true\n    if cp >= 4240 && cp <= 4249 -> return true\n    if cp >= 6112 && cp <= 6121 -> return true\n    if cp >= 6470 && cp <= 6479 -> return true\n    if cp >= 65296 && cp <= 65305 -> return true\n    false\n}}\n\nfn is_space_cp(cp: Int) -> Bool {{\n    if cp >= 9 && cp <= 13 -> return true\n    if cp == 32 || cp == 133 || cp == 160 -> return true\n    if cp == 5760 || cp == 8239 || cp == 8287 || cp == 12288 -> return true\n    if cp >= 8192 && cp <= 8202 -> return true\n    if cp == 8232 || cp == 8233 -> return true\n    false\n}}\n\nfn combining_class(cp: Int) -> Int {{\n    if cp >= 768 && cp <= 879 -> return 230\n    if cp >= 7616 && cp <= 7679 -> return 230\n    if cp >= 8400 && cp <= 8432 -> return 230\n    if cp >= 65056 && cp <= 65071 -> return 230\n    0\n}}\n\nfn is_extend(cp: Int) -> Bool {{ combining_class(cp) != 0 || (cp >= 0xFE00 && cp <= 0xFE0F) || (cp >= 0x1F3FB && cp <= 0x1F3FF) || cp == 0x200C || cp == 0x200D || cp == 0xFF9E || cp == 0xFF9F }}\n\nC_SBASE :: 44032\nC_LBASE :: 4352\nC_VBASE :: 4449\nC_TBASE :: 4519\nC_LCOUNT :: 19\nC_VCOUNT :: 21\nC_TCOUNT :: 28\nC_NCOUNT :: 588\nC_SCOUNT :: 11172\n\nfn hangul_decompose(cp: Int) -> [Int] {{\n    sindex :: cp - C_SBASE\n    if sindex < 0 || sindex >= C_SCOUNT -> return [Int]{{cp}}\n    l :: C_LBASE + sindex /% C_NCOUNT\n    v :: C_VBASE + (sindex % C_NCOUNT) /% C_TCOUNT\n    t :: C_TBASE + sindex % C_TCOUNT\n    if t == C_TBASE -> return [Int]{{l, v}}\n    [Int]{{l, v, t}}\n}}\n\nfn hangul_compose(a: Int, b: Int) -> Int? {{\n    lindex :: a - C_LBASE\n    if lindex >= 0 && lindex < C_LCOUNT {{\n        vindex :: b - C_VBASE\n        if vindex >= 0 && vindex < C_VCOUNT -> return Val(C_SBASE + (lindex * C_VCOUNT + vindex) * C_TCOUNT)\n    }}\n    sindex :: a - C_SBASE\n    if sindex >= 0 && sindex < C_SCOUNT && sindex % C_TCOUNT == 0 {{\n        tindex :: b - C_TBASE\n        if tindex > 0 && tindex < C_TCOUNT -> return Val(a + tindex)\n    }}\n    None\n}}\n\nfn decompose(text: String, compat: Bool) -> [Int] {{\n    raw := [Int]{{}}\n    loop cp in decode_scalars(text) {{\n        pieces :: decompose_cp(cp, compat)\n        loop p in pieces -> &raw.push(p)\n    }}\n    canon_order(raw)\n}}\n\nfn decompose_cp(cp: Int, compat: Bool) -> [Int] {{\n    if cp >= C_SBASE && cp < C_SBASE + C_SCOUNT -> return hangul_decompose(cp)\n    if cp == 192 -> return [Int]{{65, 768}}\n    if cp == 193 -> return [Int]{{65, 769}}\n    if cp == 194 -> return [Int]{{65, 770}}\n    if cp == 195 -> return [Int]{{65, 771}}\n    if cp == 196 -> return [Int]{{65, 776}}\n    if cp == 197 -> return [Int]{{65, 778}}\n    if cp == 199 -> return [Int]{{67, 807}}\n    if cp == 200 -> return [Int]{{69, 768}}\n    if cp == 201 -> return [Int]{{69, 769}}\n    if cp == 202 -> return [Int]{{69, 770}}\n    if cp == 203 -> return [Int]{{69, 776}}\n    if cp == 204 -> return [Int]{{73, 768}}\n    if cp == 205 -> return [Int]{{73, 769}}\n    if cp == 206 -> return [Int]{{73, 770}}\n    if cp == 207 -> return [Int]{{73, 776}}\n    if cp == 209 -> return [Int]{{78, 771}}\n    if cp == 210 -> return [Int]{{79, 768}}\n    if cp == 211 -> return [Int]{{79, 769}}\n    if cp == 212 -> return [Int]{{79, 770}}\n    if cp == 213 -> return [Int]{{79, 771}}\n    if cp == 214 -> return [Int]{{79, 776}}\n    if cp == 217 -> return [Int]{{85, 768}}\n    if cp == 218 -> return [Int]{{85, 769}}\n    if cp == 219 -> return [Int]{{85, 770}}\n    if cp == 220 -> return [Int]{{85, 776}}\n    if cp == 221 -> return [Int]{{89, 769}}\n    if cp == 224 -> return [Int]{{97, 768}}\n    if cp == 225 -> return [Int]{{97, 769}}\n    if cp == 226 -> return [Int]{{97, 770}}\n    if cp == 227 -> return [Int]{{97, 771}}\n    if cp == 228 -> return [Int]{{97, 776}}\n    if cp == 229 -> return [Int]{{97, 778}}\n    if cp == 231 -> return [Int]{{99, 807}}\n    if cp == 232 -> return [Int]{{101, 768}}\n    if cp == 233 -> return [Int]{{101, 769}}\n    if cp == 234 -> return [Int]{{101, 770}}\n    if cp == 235 -> return [Int]{{101, 776}}\n    if cp == 236 -> return [Int]{{105, 768}}\n    if cp == 237 -> return [Int]{{105, 769}}\n    if cp == 238 -> return [Int]{{105, 770}}\n    if cp == 239 -> return [Int]{{105, 776}}\n    if cp == 241 -> return [Int]{{110, 771}}\n    if cp == 242 -> return [Int]{{111, 768}}\n    if cp == 243 -> return [Int]{{111, 769}}\n    if cp == 244 -> return [Int]{{111, 770}}\n    if cp == 245 -> return [Int]{{111, 771}}\n    if cp == 246 -> return [Int]{{111, 776}}\n    if cp == 249 -> return [Int]{{117, 768}}\n    if cp == 250 -> return [Int]{{117, 769}}\n    if cp == 251 -> return [Int]{{117, 770}}\n    if cp == 252 -> return [Int]{{117, 776}}\n    if cp == 253 -> return [Int]{{121, 769}}\n    if cp == 255 -> return [Int]{{121, 776}}\n    if cp == 304 -> return [Int]{{73, 775}}\n    if compat {{\n        if cp >= 65281 && cp <= 65374 -> return [Int]{{cp - 65248}}\n        if cp == 338 -> return [Int]{{79, 69}}\n        if cp == 339 -> return [Int]{{111, 101}}\n        if cp == 64256 -> return [Int]{{102, 102}}\n        if cp == 64257 -> return [Int]{{102, 105}}\n        if cp == 64258 -> return [Int]{{102, 108}}\n        if cp == 64259 -> return [Int]{{102, 102, 105}}\n        if cp == 64260 -> return [Int]{{102, 102, 108}}\n        if cp == 64261 -> return [Int]{{115, 116}}\n        if cp == 64262 -> return [Int]{{115, 116}}\n        if cp == 185 -> return [Int]{{49}}\n        if cp == 178 -> return [Int]{{50}}\n        if cp == 179 -> return [Int]{{51}}\n    }}\n    [Int]{{cp}}\n}}\n\nfn canon_order(cps: [Int]) -> [Int] {{\n    out := [Int]{{}}\n    loop c in cps -> &out.push(c)\n    i := 1\n    loop {{\n        if i >= out.len() -> return ~out\n        cc :: combining_class(out[i])\n        prev :: combining_class(out[i - 1])\n        if cc != 0 && prev > cc {{\n            tmp := out[i]\n            out[i] = out[i - 1]\n            out[i - 1] = tmp\n            if i > 1 {{\n                i = i - 1\n                next\n            }}\n        }}\n        i = i + 1\n    }}\n}}\n\nfn compose(cps: [Int]) -> String {{\n    if cps.len() == 0 -> return \"\"\n    out := [Int]{{}}\n    starter := -1\n    last_class := -1\n    loop cp in cps {{\n        cc :: combining_class(cp)\n        if starter >= 0 {{\n            composed :: compose_pair(out[starter], cp)\n            if composed != None && last_class < cc {{\n                out[starter] = composed\n                next\n            }}\n        }}\n        &out.push(cp)\n        if cc == 0 {{\n            starter = out.len() - 1\n            last_class = -1\n        }} else {{\n            last_class = cc\n        }}\n    }}\n    encode_cps(out)\n}}\n\nfn compose_pair(a: Int, b: Int) -> Int? {{\n    h :: hangul_compose(a, b)\n    if h != None -> return Val(h)\n    if b == 768 {{\n        if a == 65 -> return Val(192)\n        if a == 69 -> return Val(200)\n        if a == 73 -> return Val(204)\n        if a == 79 -> return Val(210)\n        if a == 85 -> return Val(217)\n        if a == 97 -> return Val(224)\n        if a == 101 -> return Val(232)\n        if a == 105 -> return Val(236)\n        if a == 111 -> return Val(242)\n        if a == 117 -> return Val(249)\n    }}\n    if b == 769 {{\n        if a == 65 -> return Val(193)\n        if a == 69 -> return Val(201)\n        if a == 73 -> return Val(205)\n        if a == 79 -> return Val(211)\n        if a == 85 -> return Val(218)\n        if a == 89 -> return Val(221)\n        if a == 97 -> return Val(225)\n        if a == 101 -> return Val(233)\n        if a == 105 -> return Val(237)\n        if a == 111 -> return Val(243)\n        if a == 117 -> return Val(250)\n        if a == 121 -> return Val(253)\n    }}\n    if b == 770 {{\n        if a == 65 -> return Val(194)\n        if a == 69 -> return Val(202)\n        if a == 73 -> return Val(206)\n        if a == 79 -> return Val(212)\n        if a == 85 -> return Val(219)\n        if a == 97 -> return Val(226)\n        if a == 101 -> return Val(234)\n        if a == 105 -> return Val(238)\n        if a == 111 -> return Val(244)\n        if a == 117 -> return Val(251)\n    }}\n    if b == 771 {{\n        if a == 65 -> return Val(195)\n        if a == 78 -> return Val(209)\n        if a == 79 -> return Val(213)\n        if a == 97 -> return Val(227)\n        if a == 110 -> return Val(241)\n        if a == 111 -> return Val(245)\n    }}\n    if b == 775 && a == 73 -> return Val(304)\n    if b == 776 {{\n        if a == 65 -> return Val(196)\n        if a == 69 -> return Val(203)\n        if a == 73 -> return Val(207)\n        if a == 79 -> return Val(214)\n        if a == 85 -> return Val(220)\n        if a == 97 -> return Val(228)\n        if a == 101 -> return Val(235)\n        if a == 105 -> return Val(239)\n        if a == 111 -> return Val(246)\n        if a == 117 -> return Val(252)\n        if a == 121 -> return Val(255)\n    }}\n    if b == 778 {{\n        if a == 65 -> return Val(197)\n        if a == 97 -> return Val(229)\n    }}\n    if b == 807 {{\n        if a == 67 -> return Val(199)\n        if a == 99 -> return Val(231)\n    }}\n    None\n}}\n\nfn split_graphemes(text: String) -> [String] {{\n    cps :: decode_scalars(text)\n    if cps.len() == 0 -> return [String]{{}}\n    out := [String]{{}}\n    cluster := [Int]{{cps[0]}}\n    ri_run := if is_ri(cps[0]) -> 1 else -> 0\n    i := 1\n    loop {{\n        if i >= cps.len() {{\n            &out.push(encode_cps(cluster))\n            return ~out\n        }}\n        prev :: cluster[cluster.len() - 1]\n        cur :: cps[i]\n        break_here := grapheme_break(prev, cur)\n        // GB11 needs a pictographic Extend* prefix before the ZWJ.\n        if prev == 0x200D && is_emoji(cur) -> break_here = !has_emoji_zwj_prefix(cluster)\n        if is_ri(prev) && is_ri(cur) && ri_run % 2 == 0 -> break_here = true\n        if break_here {{\n            &out.push(encode_cps(cluster))\n            cluster = [Int]{{cur}}\n            ri_run = if is_ri(cur) -> 1 else -> 0\n        }} else {{\n            &cluster.push(cur)\n            if is_ri(cur) -> ri_run = ri_run + 1 else -> ri_run = 0\n        }}\n        i = i + 1\n    }}\n}}\n\nfn grapheme_break(prev: Int, cur: Int) -> Bool {{\n    // GB3 CR × LF\n    if prev == 13 && cur == 10 -> return false\n    // GB4 / GB5\n    if prev == 13 || prev == 10 || is_control(prev) -> return true\n    if cur == 13 || cur == 10 || is_control(cur) -> return true\n    // GB6-8 Hangul\n    if is_l(prev) && (is_l(cur) || is_v(cur) || is_lv(cur) || is_lvt(cur)) -> return false\n    if (is_lv(prev) || is_v(prev)) && (is_v(cur) || is_t(cur)) -> return false\n    if (is_lvt(prev) || is_t(prev)) && is_t(cur) -> return false\n    // GB9 Extend / ZWJ\n    if is_extend(cur) || cur == 0x200D -> return false\n    // GB9a SpacingMark (approx: Mc)\n    if cur >= 0x0903 && cur <= 0x0903 -> return false\n    // GB12/13 RI × RI\n    if is_ri(prev) && is_ri(cur) -> return false\n    true\n}}\nfn has_emoji_zwj_prefix(cluster: [Int]) -> Bool {{\n    i := cluster.len() - 2\n    loop i >= 0 {{\n        cp :: cluster[i]\n        if cp == 0x200D -> return false\n        if !is_extend(cp) -> return is_emoji(cp)\n        i = i - 1\n    }}\n    false\n}}\n\n\nfn is_control(cp: Int) -> Bool {{ (cp < 32 && cp != 9 && cp != 10 && cp != 13) || (cp >= 127 && cp <= 159) }}\nfn is_l(cp: Int) -> Bool {{ cp >= C_LBASE && cp < C_LBASE + C_LCOUNT }}\nfn is_v(cp: Int) -> Bool {{ cp >= C_VBASE && cp < C_VBASE + C_VCOUNT }}\nfn is_t(cp: Int) -> Bool {{ cp >= C_TBASE + 1 && cp < C_TBASE + C_TCOUNT }}\nfn is_lv(cp: Int) -> Bool {{\n    s :: cp - C_SBASE\n    s >= 0 && s < C_SCOUNT && s % C_TCOUNT == 0\n}}\nfn is_lvt(cp: Int) -> Bool {{\n    s :: cp - C_SBASE\n    s >= 0 && s < C_SCOUNT && s % C_TCOUNT != 0\n}}\nfn is_ri(cp: Int) -> Bool {{ cp >= 127462 && cp <= 127487 }}\nfn is_emoji(cp: Int) -> Bool {{ (cp >= 0x1F300 && cp <= 0x1FAFF) || (cp >= 0x2600 && cp <= 0x27BF) }}\n\nfn split_words(text: String) -> [String] {{\n    out := [String]{{}}\n    cur := [Int]{{}}\n    loop cp in decode_scalars(text) {{\n        if is_alpha_cp(cp) || is_digit_cp(cp) || cp == 95 {{\n            &cur.push(cp)\n            next\n        }}\n        if cp == 39 && cur.len() > 0 {{\n            &cur.push(cp)\n            next\n        }}\n        if cur.len() > 0 {{\n            &out.push(encode_cps(cur))\n            cur = [Int]{{}}\n        }}\n    }}\n    if cur.len() > 0 -> &out.push(encode_cps(cur))\n    out\n}}\n\nfn is_word_cp(cp: Int) -> Bool {{ is_alpha_cp(cp) || is_digit_cp(cp) || cp == 95 || cp == 39 }}\n\nfn split_sentences(text: String) -> [String] {{\n    out := [String]{{}}\n    cur := [Int]{{}}\n    loop cp in decode_scalars(text) {{\n        &cur.push(cp)\n        if cp == 46 || cp == 33 || cp == 63 || cp == 0x3002 || cp == 0xFF01 || cp == 0xFF1F {{\n            sentence :: trim(encode_cps(cur))\n            if sentence.bytes().len() > 0 -> &out.push(sentence)\n            cur = [Int]{{}}\n        }}\n    }}\n    if cur.len() > 0 {{\n        sentence :: trim(encode_cps(cur))\n        if sentence.bytes().len() > 0 -> &out.push(sentence)\n    }}\n    out\n}}\n\nfn split_lines(text: String) -> [String] {{\n    raw :: text.bytes()\n    if raw.len() == 0 -> return [String]{{}}\n    out := [String]{{}}\n    start := 0\n    i := 0\n    loop i < raw.len() {{\n        if raw[i] == (U8{{10}}) || raw[i] == (U8{{13}}) {{\n            &out.push(slice_bytes(raw, start, i))\n            if raw[i] == (U8{{13}}) && i + 1 < raw.len() && raw[i + 1] == (U8{{10}}) -> i = i + 1\n            i = i + 1\n            start = i\n            next\n        }}\n        i = i + 1\n    }}\n    if start < raw.len() -> &out.push(slice_bytes(raw, start, raw.len()))\n    out\n}}\n\nfn cluster_width(cps: [Int]) -> Int {{\n    if cps.len() == 0 -> return 0\n    wide := false\n    pictographic := false\n    keycap := false\n    visible := false\n    variation := false\n    loop cp in cps {{\n        if cp == 0x20E3 -> keycap = true\n        if cp == 0xFE0F -> variation = true\n        if is_emoji(cp) -> pictographic = true\n        w :: east_asian_width(cp)\n        if w > 1 -> wide = true\n        if w > 0 && !is_extend(cp) -> visible = true\n    }}\n    if keycap || wide || pictographic || (variation && visible) -> return 2\n    if !visible -> return 0\n    1\n}}\n\nfn east_asian_width(cp: Int) -> Int {{\n    if combining_class(cp) != 0 -> return 0\n    if cp < 32 || (cp >= 127 && cp <= 159) -> return 0\n    if (cp >= 0x1100 && cp <= 0x115F) || (cp >= 0x2329 && cp <= 0x232A) -> return 2\n    if (cp >= 0x2E80 && cp <= 0xA4CF) && cp != 0x303F -> return 2\n    if cp >= 0xAC00 && cp <= 0xD7A3 -> return 2\n    if cp >= 0xF900 && cp <= 0xFAFF -> return 2\n    if cp >= 0xFE10 && cp <= 0xFE19 -> return 2\n    if cp >= 0xFE30 && cp <= 0xFE6F -> return 2\n    if cp >= 0xFF00 && cp <= 0xFF60 -> return 2\n    if cp >= 0xFFE0 && cp <= 0xFFE6 -> return 2\n    if cp >= 0x1F300 && cp <= 0x1FAFF -> return 2\n    1\n}}\n\nfn hex_cp(cp: Int) -> String {{\n    hex := \"0123456789ABCDEF\"\n    hb :: hex.bytes()\n    n := cp\n    digits := [U8]{{}}\n    if n == 0 -> &digits.push(U8{{48}})\n    loop {{\n        if n == 0 -> break\n        &digits.push(hb[n % 16])\n        n = n /% 16\n    }}\n    // pad to 4\n    loop {{\n        if digits.len() >= 4 -> break\n        &digits.push(U8{{48}})\n    }}\n    out := [U8]{{85, 43}} // U+\n    i := digits.len() - 1\n    loop {{\n        if i < 0 -> return String.from_bytes(out) ?? \"\"\n        &out.push(digits[i])\n        i = i - 1\n    }}\n}}\n"}
