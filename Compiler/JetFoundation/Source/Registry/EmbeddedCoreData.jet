}

fn foundation_embedded_core_source_41() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.encoding.xml", alias: "core_core_encoding_xml", path: "Core/encoding/xml.jet", owner: "", owned_members: [String]{"attribute", "canonical", "content", "parse", "parse_bytes", "parse_with", "reader", "root", "to_bytes", "to_string"}, source: "use core.encoding.[DataTree, EncodingError, EncodingErrorKind, EncodingFormat]\n\nfn syntax_error(format: EncodingFormat, offset: Int, line: Int, column: Int, path: String, reason: String) -> EncodingError Never! {{\n    {{\n        format: format,\n        kind: EncodingErrorKind.Syntax,\n        byte_offset: offset,\n        line: Val(line),\n        column: Val(column),\n        path: path,\n        reason: reason,\n        cause: None,\n    }}\n}}\n\nfn unsupported_error(format: EncodingFormat, offset: Int, reason: String) -> EncodingError Never! {{\n    {{\n        format: format,\n        kind: EncodingErrorKind.Unsupported,\n        byte_offset: offset,\n        line: None,\n        column: None,\n        path: \"\",\n        reason: reason,\n        cause: None,\n    }}\n}}\n\n\nfn safe_xml_limits() -> XMLLimits Never! {{\n    {{\n        max_depth: 256,\n        max_nodes: 1000000,\n        max_attributes_per_element: 1024,\n        max_name_bytes: 1024,\n        max_text_bytes: 16777216,\n        max_entity_declarations: 0,\n        max_entity_depth: 0,\n        max_entity_replacement_bytes: 0,\n    }}\n}}\n\n// core.encoding.xml — well-formed XML 1.0 without DTDs.\n//\n// The Jet codec parses elements, attributes, text, comments, and empty tags\n// into a `DataTree` object `{{ name, attrs, children }}`. DTDs, parameter\n// entities, XInclude, and namespace rewriting are rejected. Hostile entity\n// expansion cannot occur because this parser never defines named entities;\n// only the five XML predefined names and numeric character references decode.\n//\n// Canonicalization, encoding declarations, and namespace rewriting are\n// intentionally outside this small source codec. `parse` remains the\n// portable, bounded door and rejects unsupported constructs explicitly.\npub enum XMLReason {{\n    Syntax\n    Truncated\n    ForbiddenDTD\n    UnknownEntity\n}}\n\n#Error\npub struct XMLError {{\n    pub kind: XMLReason\n    pub byte_offset: Int?\n    pub line: Int?\n    pub column: Int?\n    pub path: String\n    pub reason: String\n}}\n\npub struct XMLLimits {{\n    pub max_depth: Int\n    pub max_nodes: Int\n    pub max_attributes_per_element: Int\n    pub max_name_bytes: Int\n    pub max_text_bytes: Int\n    pub max_entity_declarations: Int\n    pub max_entity_depth: Int\n    pub max_entity_replacement_bytes: Int\n}}\n\npub enum XMLCanonicalMode {{\n    Inclusive\n    Exclusive\n}}\n\npub enum XMLEncoding {{\n    UTF8\n    UTF16\n}}\n\npub enum XMLEntityPolicy {{\n    PredefinedOnly\n    Reject\n}}\n\npub struct XMLCanonical {{\n    pub mode: XMLCanonicalMode\n    pub comments: Bool\n    pub inclusive_prefixes: [String]\n}}\n\npub struct XMLLexicalPolicy {{\n    pub keep_whitespace: Bool\n}}\n\npub struct XMLParseOptions {{\n    pub entities: XMLEntityPolicy\n    pub limits: XMLLimits\n}}\n\npub struct XMLRenderOptions {{\n    pub encoding: XMLEncoding\n    pub lexical: XMLLexicalPolicy\n}}\n\npub struct XMLReader {{\n    pub root: DataTree\n    pub yielded: Bool\n}}\n\nimpl XMLReader {{\n    pub fn next(&self) -> DataTree? Never! {{\n        if self.yielded -> return None\n        self.yielded = true\n        Val(self.root)\n    }}\n}}\n\npub fn parse(text: String) -> DataTree EncodingError! {{ parse_xml(text) }}\n\npub fn decode(text: String) -> DataTree EncodingError! {{ parse_xml(text) }}\n\npub fn parse_bytes(bytes: [U8]) -> DataTree EncodingError! {{\n    text :: String.from_bytes(bytes) ?? return Err(syntax_error(EncodingFormat.XML, 0, 1, 1, \"\", \"XML input is not valid UTF-8\"))\n    parse_xml(text)\n}}\n\npub fn parse_with(text: String, limits: XMLLimits) -> DataTree EncodingError! {{\n    if limits.max_depth < 1 -> return Err(unsupported_error(EncodingFormat.XML, 0, \"XMLLimits.max_depth must be positive\"))\n    if limits.max_nodes < 1 -> return Err(unsupported_error(EncodingFormat.XML, 0, \"XMLLimits.max_nodes must be positive\"))\n    if limits.max_attributes_per_element < 0 -> return Err(unsupported_error(EncodingFormat.XML, 0, \"XMLLimits.max_attributes_per_element cannot be negative\"))\n    if limits.max_name_bytes < 1 -> return Err(unsupported_error(EncodingFormat.XML, 0, \"XMLLimits.max_name_bytes must be positive\"))\n    if limits.max_text_bytes < 0 -> return Err(unsupported_error(EncodingFormat.XML, 0, \"XMLLimits.max_text_bytes cannot be negative\"))\n    if limits.max_entity_declarations < 0 -> return Err(unsupported_error(EncodingFormat.XML, 0, \"XMLLimits.max_entity_declarations cannot be negative\"))\n    if limits.max_entity_depth < 0 -> return Err(unsupported_error(EncodingFormat.XML, 0, \"XMLLimits.max_entity_depth cannot be negative\"))\n    if limits.max_entity_replacement_bytes < 0 -> return Err(unsupported_error(EncodingFormat.XML, 0, \"XMLLimits.max_entity_replacement_bytes cannot be negative\"))\n    if text.bytes().len() > limits.max_text_bytes {{\n        return Err(unsupported_error(EncodingFormat.XML, 0, \"XML document exceeds XMLLimits.max_text_bytes\"))\n    }}\n    parse_xml_limited(text, limits)\n}}\n\n\npub fn to_string(value: DataTree) -> String Never! {{ render_xml(value) }}\n\npub fn to_bytes(value: DataTree) -> [U8] Never! {{ to_string(value).bytes() }}\n\npub fn canonical(text: String) -> String EncodingError! {{ to_string(parse_xml(text)) }}\n\npub fn reader(text: String) -> XMLReader EncodingError! {{\n    root :: parse_xml(text)\n    Ok(XMLReader{{root: root, yielded: false}})\n}}\n\npub fn attribute(name: String, value: String) -> DataTree Never! {{\n    DataTree.Object([\"name\": DataTree.Text(~name), \"value\": DataTree.Text(~value)])\n}}\n\npub fn content(text: String) -> DataTree Never! {{ DataTree.Text(~text) }}\n\npub fn expanded_name(name: String) -> String Never! {{ ~name }}\n\npub fn root(value: DataTree) -> DataTree Never! {{ ~value }}\n\n\npub struct XMLWriter {{\n    pub parts: [U8]\n}}\nimpl XMLWriter {{\n    pub fn write(&self, value: DataTree) Never! {{\n        chunk :: render_xml(value).bytes()\n        loop b in chunk -> &self.parts.push(b)\n    }}\n\n    pub fn to_string(self) -> String Never! {{ String.from_bytes(self.parts) ?? \"\" }}\n\n    pub fn flush(&self) Never! {{}}\n\n    pub fn finish(&self) Never! {{}}\n}}\n\nfn parse_xml(text: String) -> DataTree EncodingError! {{\n    parse_xml_limited(text, safe_xml_limits())\n}}\n\nfn parse_xml_limited(text: String, limits: XMLLimits) -> DataTree EncodingError! {{\n    if text.bytes().len() > limits.max_text_bytes {{\n        return Err(unsupported_error(EncodingFormat.XML, 0, \"XML document exceeds XMLLimits.max_text_bytes\"))\n    }}\n    p := XMLParser{{\n        bytes: text.bytes(),\n        index: 0,\n        line: 1,\n        column: 1,\n        depth: 0,\n        max_depth: limits.max_depth,\n        nodes: 0,\n        max_nodes: limits.max_nodes,\n        max_attributes_per_element: limits.max_attributes_per_element,\n        max_name_bytes: limits.max_name_bytes,\n    }}\n    _ :: &p.skip_misc() ?? return Err(p.fail(\"XML preamble could not be parsed\"))\n    node :: &p.parse_element()\n    _ :: &p.skip_misc() ?? return Err(p.fail(\"XML trailing content could not be parsed\"))\n    if !p.eof() -> return Err(p.fail(\"unexpected trailing data after the root element\"))\n    Ok(node)\n}}\n\nfn element_tree(name: String, attrs: [DataTree], children: [DataTree]) -> DataTree Never! {{\n    entries := [String:DataTree]{{}}\n    _ :: &entries.add(\"name\", DataTree.Text(~name))\n    _ :: &entries.add(\"attrs\", DataTree.Array(~attrs))\n    _ :: &entries.add(\"children\", DataTree.Array(~children))\n    DataTree.Object(entries)\n}}\n\nstruct XMLParser {{\n    bytes: [U8]\n    index: Int\n    line: Int\n    column: Int\n    depth: Int\n    max_depth: Int\n    nodes: Int\n    max_nodes: Int\n    max_attributes_per_element: Int\n    max_name_bytes: Int\n}}\n\nimpl XMLParser {{\n    fn eof(self) -> Bool Never! {{ self.index >= self.bytes.len() }}\n\n    fn peek(self) -> U8? {{\n        if self.eof() -> return None\n        Val(self.bytes[self.index])\n    }}\n\n    fn bump(&self) -> U8? {{\n        b :: self.peek() ?? return None\n        self.index += 1\n        if b == (U8{{10}}) {{\n            self.line += 1\n            self.column = 1\n        }} else {{ self.column += 1 }}\n        Val(b)\n    }}\n\n    fn fail(self, reason: String) -> EncodingError Never! {{\n        return syntax_error(\n        EncodingFormat.XML,\n        self.index,\n        self.line,\n        self.column,\n        \"\",\n        reason,\n        )\n    }}\n    fn skip_ws(&self) -> Bool EncodingError! {{\n        loop {{\n            b :: self.peek() ?? return true\n            n :: b\n            if n == 32 || n == 9 || n == 10 || n == 13 {{\n                _ :: &self.bump() ?? return Err(self.fail(\"XML whitespace scan failed\"))\n            }} else {{\n                return true\n            }}\n        }}\n        true\n    }}\n\n    fn skip_misc(&self) -> Bool EncodingError! {{\n        loop {{\n            _ :: &self.skip_ws() ?? return Err(self.fail(\"XML whitespace scan failed\"))\n            b :: self.peek() ?? return true\n            if b != (U8{{60}}) -> return true\n            if self.starts_with(\"<?\") {{\n                _ :: &self.skip_until(\"?>\") ?? return Err(self.fail(\"XML declaration scan failed\"))\n                next\n            }}\n            if self.starts_with(\"<!--\") {{\n                _ :: &self.skip_until(\"-->\") ?? return Err(self.fail(\"XML comment scan failed\"))\n                next\n            }}\n            if self.starts_with(\"<!DOCTYPE\") {{\n                return Err(self.fail(\"DTDs are forbidden in Core XML; pass a well-formed fragment without a DOCTYPE\"))\n            }}\n            return true\n        }}\n        true\n    }}\n\n    fn starts_with(self, token: String) -> Bool Never! {{\n        raw :: token.bytes()\n        if self.index + raw.len() > self.bytes.len() -> return false\n        loop i in 0..<raw.len() {{\n            if self.bytes[self.index + i] != raw[i] -> return false\n        }}\n        true\n    }}\n\n    fn skip_until(&self, token: String) -> Bool EncodingError! {{\n        raw :: token.bytes()\n        loop {{\n            if self.starts_with(token) {{\n                loop _ in 0..<raw.len() {{\n                    _ :: &self.bump() ?? return Err(self.fail(\"input ended while scanning for `{{token}}`\"))\n                }}\n                return true\n            }}\n            _ :: &self.bump() ?? return Err(self.fail(\"input ended while scanning for `{{token}}`\"))\n        }}\n        true\n    }}\n    fn parse_name(&self) -> String EncodingError! {{\n        out := [U8]{{}}\n        at_start := true\n        loop {{\n            b :: self.peek() ?? break\n            n :: b\n            letter :: (n >= 65 && n <= 90) || (n >= 97 && n <= 122)\n            ok :: letter || n == 95 || (!at_start && ((n >= 48 && n <= 57) || n == 45 || n == 58 || n == 46))\n            if ok == false -> break\n            if out.len() >= self.max_name_bytes {{\n                return Err(unsupported_error(EncodingFormat.XML, self.index, \"XML name exceeds XMLLimits.max_name_bytes\"))\n            }}\n            &out.push(b)\n            _ :: &self.bump()\n            at_start = false\n        }}\n        if out.len() == 0 -> return Err(self.fail(\"expected an XML name beginning with a letter or underscore\"))\n        Ok(String.from_bytes(out) ?? \"\")\n    }}\n    fn parse_element(&self) -> DataTree EncodingError! {{\n        self.depth += 1\n        if self.depth > self.max_depth {{\n            return Err(unsupported_error(EncodingFormat.XML, self.index, \"XML nesting exceeds XMLLimits.max_depth\"))\n        }}\n        self.nodes += 1\n        if self.nodes > self.max_nodes {{\n            return Err(unsupported_error(EncodingFormat.XML, self.index, \"XML node count exceeds XMLLimits.max_nodes\"))\n        }}\n\n        lt :: &self.bump() ?? return Err(self.fail(\"expected '<'\"))\n        if lt != (U8{{60}}) -> return Err(self.fail(\"expected '<'\"))\n        name :: &self.parse_name()\n        attrs := [DataTree]{{}}\n        loop {{\n            _ :: &self.skip_ws() ?? return Err(self.fail(\"XML whitespace scan failed\"))\n            b :: self.peek() ?? return Err(self.fail(\"unterminated start tag\"))\n            if b == (U8{{62}}) {{\n                _ :: &self.bump()\n                break\n            }}\n            if b == (U8{{47}}) {{\n                _ :: &self.bump()\n                _ :: &self.expect(U8{{62}}, \"'>' to close an empty tag\") ?? return Err(self.fail(\"invalid empty XML tag\"))\n                self.depth -= 1\n                return Ok(element_tree(name, attrs, [DataTree]{{}}))\n            }}\n            attr_name :: &self.parse_name()\n            _ :: &self.skip_ws() ?? return Err(self.fail(\"XML whitespace scan failed\"))\n            _ :: &self.expect(U8{{61}}, \"'=' in an attribute\") ?? return Err(self.fail(\"invalid XML attribute\"))\n            _ :: &self.skip_ws() ?? return Err(self.fail(\"XML whitespace scan failed\"))\n            attr_value :: &self.parse_quoted()\n            loop prior in attrs {{\n                prior_name :: tree_field_or(prior, \"name\", DataTree.Text(\"\"))\n                if (prior_name.to_text() ?? \"\") == attr_name {{\n                    return Err(self.fail(\"duplicate XML attribute `{{attr_name}}`\"))\n                }}\n            }}\n            &attrs.push(attribute(attr_name, attr_value))\n            if attrs.len() > self.max_attributes_per_element {{\n                return Err(unsupported_error(EncodingFormat.XML, self.index, \"XML attribute count exceeds XMLLimits.max_attributes_per_element\"))\n            }}\n        }}\n        children := [DataTree]{{}}\n        loop {{\n            if self.starts_with(\"</\") {{\n                loop _ in 0..<2 -> _ :: &self.bump()\n                end_name :: &self.parse_name()\n                _ :: &self.skip_ws() ?? return Err(self.fail(\"XML whitespace scan failed\"))\n                _ :: &self.expect(U8{{62}}, \"'>' of an end tag\") ?? return Err(self.fail(\"invalid XML end tag\"))\n                if end_name != name {{\n                    return Err(self.fail(\"end tag `{{end_name}}` does not match `{{name}}`\"))\n                }}\n                self.depth -= 1\n                return Ok(element_tree(name, attrs, children))\n            }}\n            if self.starts_with(\"<!--\") {{\n                _ :: &self.skip_until(\"-->\") ?? return Err(self.fail(\"XML comment scan failed\"))\n                next\n            }}\n            if (self.peek() ?? (U8{{0}})) == (U8{{60}}) {{\n                child :: &self.parse_element()\n                &children.push(child)\n                next\n            }}\n            text :: &self.parse_text()\n            if text.len() > 0 -> &children.push(DataTree.Text(text))\n            if self.eof() -> return Err(self.fail(\"unterminated element `{{name}}`\"))\n        }}\n        return Err(self.fail(\"unterminated element `{{name}}`\"))\n    }}\n    fn parse_quoted(&self) -> String EncodingError! {{\n        q :: &self.bump() ?? return Err(self.fail(\"expected a quoted attribute\"))\n        if q != (U8{{34}}) && q != (U8{{39}}) {{\n            return Err(self.fail(\"attribute values must be quoted\"))\n        }}\n        out := [U8]{{}}\n        loop {{\n            b :: &self.bump() ?? return Err(self.fail(\"unterminated attribute value\"))\n            if b == q {{\n                raw :: String.from_bytes(out) ?? return Err(self.fail(\"invalid UTF-8 in attribute value\"))\n                return decode_entities(raw)\n            }}\n            &out.push(b)\n        }}\n    }}\n\n    fn parse_text(&self) -> String EncodingError! {{\n        out := [U8]{{}}\n        loop {{\n            b :: self.peek() ?? break\n            if b == (U8{{60}}) -> break\n            &out.push(b)\n            _ :: &self.bump()\n        }}\n        raw :: String.from_bytes(out) ?? return Err(self.fail(\"invalid UTF-8 in element text\"))\n        decode_entities(raw)\n    }}\n\n    fn expect(&self, want: U8, what: String) -> Bool EncodingError! {{\n        b :: &self.bump() ?? return Err(self.fail(\"input ended while reading {{what}}\"))\n        if b != want -> return Err(self.fail(\"expected {{what}}\"))\n        true\n    }}\n}}\n\nfn decode_entities(text: String) -> String EncodingError! {{\n    raw :: text.bytes()\n    out := [U8]{{}}\n    i := 0\n    loop i < raw.len() {{\n        if raw[i] != (U8{{38}}) {{\n            &out.push(raw[i])\n            i += 1\n            next\n        }}\n        j := i + 1\n        loop j < raw.len() && raw[j] != (U8{{59}}) -> j += 1\n        if j >= raw.len() -> return Err(syntax_error(EncodingFormat.XML, i, 1, i + 1, \"\", \"XML entity reference must end with ';'\"))\n        if j == i + 1 -> return Err(syntax_error(EncodingFormat.XML, i, 1, i + 1, \"\", \"empty XML entity reference\"))\n        name :: String.from_bytes(raw[i + 1..j - 1]) ?? return Err(syntax_error(EncodingFormat.XML, i, 1, i + 1, \"\", \"invalid XML entity name\"))\n        if name == {{\n            \"lt\" -> &out.push(U8{{60}})\n            \"gt\" -> &out.push(U8{{62}})\n            \"amp\" -> &out.push(U8{{38}})\n            \"apos\" -> &out.push(U8{{39}})\n            \"quot\" -> &out.push(U8{{34}})\n            else -> {{\n                n := 0\n                digit_base := 10\n                start := 0\n                bytes :: name.bytes()\n                if bytes.len() > 1 && bytes[0] == (U8{{35}}) {{\n                    start = 1\n                    if bytes.len() > 2 && (bytes[1] == (U8{{120}}) || bytes[1] == (U8{{88}})) {{\n                        digit_base = 16\n                        start = 2\n                    }}\n                    if start >= bytes.len() -> return Err(syntax_error(EncodingFormat.XML, i, 1, i + 1, \"\", \"empty XML character reference\"))\n                    k := start\n                    loop k < bytes.len() {{\n                        d := xml_entity_digit(bytes[k], digit_base)\n                        if d < 0 -> return Err(syntax_error(EncodingFormat.XML, i, 1, i + 1, \"\", \"invalid XML character reference\"))\n                        n = n * digit_base + d\n                        k += 1\n                    }}\n                    if n == 0 || n > 1114111 || (n >= 55296 && n <= 57343) || (n < 32 && n != 9 && n != 10 && n != 13) {{\n                        return Err(syntax_error(EncodingFormat.XML, i, 1, i + 1, \"\", \"XML character reference is outside XML 1.0\"))\n                    }}\n                    _ :: push_xml_utf8(&out, n) ?? return Err(syntax_error(EncodingFormat.XML, i, 1, i + 1, \"\", \"XML character reference encoding failed\"))\n                }} else {{\n                    return Err(syntax_error(EncodingFormat.XML, i, 1, i + 1, \"\", \"unknown XML entity reference\"))\n                }}\n            }}\n        }}\n        i = j + 1\n    }}\n    Ok(String.from_bytes(out) ?? ~text)\n}}\n\nfn xml_entity_digit(b: U8, base: Int) -> Int Never! {{\n    n :: Int.from_u8(b)\n    if n >= 48 && n <= 57 {{\n        d := n - 48\n        if d < base -> return d\n    }}\n    if base == 16 {{\n        if n >= 65 && n <= 70 -> return n - 55\n        if n >= 97 && n <= 102 -> return n - 87\n    }}\n    -1\n}}\n\nfn push_xml_utf8(out: &[U8], cp: Int) -> Bool EncodingError! {{\n    if cp < 128 {{\n        &out.push(U8{{cp}})\n    }} else if cp < 2048 {{\n        &out.push(U8{{192 | (cp >> 6)}})\n        &out.push(U8{{128 | (cp & 63)}})\n    }} else if cp < 65536 {{\n        &out.push(U8{{224 | (cp >> 12)}})\n        &out.push(U8{{128 | ((cp >> 6) & 63)}})\n        &out.push(U8{{128 | (cp & 63)}})\n    }} else {{\n        &out.push(U8{{240 | (cp >> 18)}})\n        &out.push(U8{{128 | ((cp >> 12) & 63)}})\n        &out.push(U8{{128 | ((cp >> 6) & 63)}})\n        &out.push(U8{{128 | (cp & 63)}})\n    }}\n    true\n}}\n\nfn tree_field_or(value: DataTree, name: String, fallback: DataTree) -> DataTree Never! {{\n    if &value.field(name) == {{\n        .Ok(tree) -> return tree\n        .Err(_) -> return ~fallback\n    }}\n    ~fallback\n}}\n\nfn render_xml(value: DataTree) -> String Never! {{\n    name_tree :: tree_field_or(value, \"name\", DataTree.Text(\"root\"))\n    name :: name_tree.to_text() ?? \"root\"\n    out := \"<{{name}}\"\n    attrs :: tree_field_or(value, \"attrs\", DataTree.Array([DataTree]{{}}))\n    out = \"{{out}}{{render_xml_attrs(attrs)}}\"\n    out = \"{{out}}>\"\n    children :: tree_field_or(value, \"children\", DataTree.Array([DataTree]{{}}))\n    out = \"{{out}}{{render_xml_children(children)}}\"\n    \"{{out}}</{{name}}>\"\n}}\n\nfn render_xml_attrs(tree: DataTree) -> String Never! {{\n    if tree == {{\n        .Array(items) -> {{\n            out := \"\"\n            loop item in items {{\n                attr_name :: tree_field_or(item, \"name\", DataTree.Text(\"\"))\n                attr_value :: tree_field_or(item, \"value\", DataTree.Text(\"\"))\n                name :: attr_name.to_text() ?? \"\"\n                value :: attr_value.to_text() ?? \"\"\n                if name.len() > 0 -> out = \"{{out}} {{name}}=\\\"{{escape_xml_attr(value)}}\\\"\"\n            }}\n            return out\n        }}\n        else -> return \"\"\n    }}\n}}\n\nfn render_xml_children(tree: DataTree) -> String Never! {{\n    if tree == {{\n        .Array(items) -> return render_xml_array(items)\n        else -> return \"\"\n    }}\n}}\n\nfn render_xml_array(items: [DataTree]) -> String Never! {{\n    out := \"\"\n    loop item in items {{\n        if item == {{\n            .Text(s) -> out = \"{{out}}{{escape_xml(s)}}\"\n            else -> out = \"{{out}}{{render_xml(item)}}\"\n        }}\n    }}\n    out\n}}\n\nfn escape_xml(text: String) -> String Never! {{\n    out := \"\"\n    loop b in text.bytes() {{\n        n :: b\n        if {{\n            n == 60 -> out = \"{{out}}&lt;\"\n            n == 62 -> out = \"{{out}}&gt;\"\n            n == 38 -> out = \"{{out}}&amp;\"\n            else -> out = \"{{out}}{{String.from_bytes([U8]{{b}}) ?? \"\"}}\"\n        }}\n    }}\n    out\n}}\n\nfn escape_xml_attr(text: String) -> String Never! {{\n    out := \"\"\n    loop b in text.bytes() {{\n        n :: b\n        if {{\n            n == 60 -> out = \"{{out}}&lt;\"\n            n == 62 -> out = \"{{out}}&gt;\"\n            n == 38 -> out = \"{{out}}&amp;\"\n            n == 34 -> out = \"{{out}}&quot;\"\n            n == 39 -> out = \"{{out}}&apos;\"\n            else -> out = \"{{out}}{{String.from_bytes([U8]{{b}}) ?? \"\"}}\"\n        }}\n    }}\n    out\n}}\n"}
}

fn foundation_embedded_core_source_42() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.event", alias: "core_core_event", path: "Core/event/event.jet", owner: "", owned_members: [String]{"async_result", "decision_hook", "hook", "new", "policy_sync", "scope", "with_policy"}, source: "package {{\n    name: \"core.event\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"Typed events, hooks, and scheduler-backed dispatch.\"\n    license: \"MIT\"\n    outputs: {{\n        event: .Library{{ entry: event }}\n    }}\n}}\n\nuse core as core\n\n// D-EVENT1 / D-EVENT2=A / D-EVENT-CONTINUE1=C:\n// the public event family is compiler-known and its runtime state belongs to\n// the provider. This module keeps the library spelling stable while forwarding\n// typed constructors; it must not manufacture a second string-backed event\n// model or turn an unavailable provider result into a successful value.\n\npub fn scope() -> EventScope Never! {{\n    core.event.scope()\n}}\n\npub fn new<T>() -> Event<T> Never! {{\n    core.event.new<T>()\n}}\n\npub fn with_policy<T>(policy: EventPolicy) -> Event<T> Never! {{\n    core.event.with_policy<T>(policy)\n}}\n\npub fn hook<T, R>(fallback: R) -> Hook<T, R> Never! {{\n    core.event.hook<T, R>(fallback)\n}}\n\npub fn decision_hook<T, E>(policy: HookPolicy) -> DecisionHook<T, E> Never! {{\n    core.event.decision_hook<T, E>(policy)\n}}\n\npub fn policy_sync() -> EventPolicy Never! {{\n    core.event.policy_sync()\n}}\n\npub fn async_result<T, E>(policy: AsyncPolicy, failures: FailurePolicy) -> AsyncEvent<T, E> EventConfigError! {{\n    core.event.async_result<T, E>(policy, failures)\n}}\n"}
}

fn foundation_embedded_core_source_43() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.files", alias: "core_core_files", path: "Core/files/files.jet", owner: "", owned_members: [String]{"basename", "is_absolute", "is_file", "scope", "stem", "suffix", "with_name", "with_suffix", "is_abs", "split_slash", "collapse", "join", "dirname", "glob_match", "relative", "is_symlink", "cwd", "home", "expanduser", "touch", "relocate", "replace", "relativeto", "chmod", "copy2", "copyfile", "mkdir", "rmdir", "unlink", "joinpath", "getcwd", "chdir", "scandir", "gettempdir", "getenv", "read_lines", "write_lines", "commonpath", "fnmatch", "which", "splitext", "split", "normpath", "getsize", "getmtime", "lexists", "samefile", "commonprefix", "expandvars", "move", "rmtree", "makedirs", "listdir", "glob_recursive", "fnmatch_filter", "is_mount", "ensure_parent", "readdir", "walkdir", "truncate", "createdirectory", "filesize", "delete", "cp", "rm", "realpath", "pwd", "tmpdir", "topath", "cd"}, source: "package {{\n    name: \"core.files\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"Filesystem handles, paths, and whole-file convenience.\"\n    license: \"MIT\"\n    outputs: {{\n        files: .Library{{ entry: files }}\n    }}\n}}\nuse core as core\nuse core.text as unicode\n\n\nuse core.sys as sys\n// core.files — one filesystem surface.\n//\n// Whole-file helpers (`read`, `write`, `write_bytes`, `append_all`) and\n// streaming constructors (`open`, `create`, `append`) share this namespace.\n// `append_all` is the whole-file twin so it does not collide with a handle\n// `.append` method. Each filesystem call names the leaf it needs: reads and\n// queries are `-[FS.Read]>`, changes are `-[FS.Write]>`, and a call that does\n// both keeps `-[FS]>`; current-directory and environment helpers additionally\n// carry `-[Env]>`. Missing files,\n// permission denials, and type mismatches are `IOError`; nothing here panics\n// on a bad path.\n//\n// `exists` / `is_dir` return booleans rather than errors: a path that cannot\n// be observed is treated as absent. `walk` / `walk_files` / `walk_parallel`\n// take an optional ignore-file name (`.gitignore` style).\n//\n// The OS door is the typed `core.files` provider: open/read/write/stat,\n// directory, link, temp, lock, and metadata calls route through it. Walk,\n// glob, copy composition, and path math remain Jet.\n// Open readers, writers, temporary files and directories, and locks own their\n// provider resources until their lexical scope exits or they are consumed by\n// `close(^handle)`. A writer's explicit `flush()` remains fallible.\n// Directory copies preserve that boundary: only regular files are copied;\n// symlink and other special entries are never dereferenced.\n\n\npub struct DirEntry {{\n    pub name: String\n    pub path: String\n    pub is_dir: Bool\n}}\n\npub struct Stat {{\n    pub size: Int\n    pub modified_ms: Int\n    pub created_ms: Int\n    pub readonly: Bool\n    pub is_file: Bool\n    pub is_dir: Bool\n    pub is_symlink: Bool\n    pub kind: String\n    pub mode: Int\n}}\n\npub struct WalkEntry {{\n    pub path: String\n    pub relative: String\n    pub is_dir: Bool\n    pub depth: Int\n}}\n\npub struct FileScope {{\n    pub authority: Authority\n}}\n\npub struct MappedFile {{\n    pub path: String\n    pub bytes: [U8]\n}}\n\npub struct TempDir {{\n    path: String\n}}\n\npub struct TempFile {{\n    path: String\n}}\n\npub struct FileLock {{\n    path: String\n}}\n\npub struct FileReader {{\n    path: String\n}}\n\npub struct FileWriter {{\n    path: String\n}}\n\n\npub fn scope(authority: Authority) -[FS]> FileScope Never! {{ {{authority: authority}} }}\n\n\npub fn open(path: String) -[FS.Read]> FileReader IOError! {{ core.files.open(path) }}\n\n\npub fn create(path: String) -[FS.Write]> FileWriter IOError! {{ core.files.create(path) }}\n\n\npub fn append(path: String) -[FS.Write]> FileWriter IOError! {{ core.files.append(path) }}\n\n\n\nfn io_err(operation: String, path: String, message: String) -> IOError Never! {{\n    if operation == \"write\" || operation == \"mkdir\" || operation == \"truncate\" {{\n        return IOError.InvalidInput(IOContext{{\n            operation: .Write,\n            resource: Val(path),\n            os_code: None,\n            cause: Val(message),\n        }})\n    }}\n    if operation == \"resolve\" || operation == \"home\" || operation == \"samefile\" {{\n        return IOError.InvalidInput(IOContext{{\n            operation: .Resolve,\n            resource: Val(path),\n            os_code: None,\n            cause: Val(message),\n        }})\n    }}\n    IOError.InvalidInput(IOContext{{\n        operation: .Read,\n        resource: Val(path),\n        os_code: None,\n        cause: Val(message),\n    }})\n}}\n\n\npub fn read_bytes(path: String) -[FS.Read]> [U8] IOError! {{ core.files.read_bytes(path) }}\n\n\npub fn read(path: String) -[FS.Read]> String IOError! {{\n    bytes :: read_bytes(~path)\n    Ok(String.from_bytes(bytes) ?? return Err(io_err(\"read\", path, \"file is not valid UTF-8\")))\n}}\n\n\npub fn map(path: String) -[FS.Read]> MappedFile IOError! {{ core.files.map(path) }}\n\n\npub fn write(path: String, text: String) IOError! -[FS.Write]> {{ core.files.write(path, text) }}\n\n\npub fn write_bytes(path: String, bytes: [U8]) IOError! -[FS.Write]> {{ core.files.write_bytes(path, bytes) }}\n\n\npub fn append_all(path: String, text: String) IOError! -[FS.Write]> {{ core.files.append_all(path, text) }}\n\n\npub fn write_atomic(path: String, bytes: [U8]) IOError! -[FS.Write]> {{\n    core.files.write_atomic(path, bytes)\n}}\n\n\npub fn read_at(path: String, offset: Int, count: Int) -[FS.Read]> [U8] IOError! {{\n    core.files.read_at(path, offset, count)\n}}\n\n\npub fn write_at(path: String, offset: Int, bytes: [U8]) IOError! -[FS.Write]> {{\n    core.files.write_at(path, offset, bytes)\n}}\n\n\npub fn fsync(path: String) IOError! -[FS.Write]> {{ core.files.fsync(path) }}\n\n\nfn exists_impl(path: String) -> Bool Never! {{ core.files.exists(path) }}\n\n\npub fn exists(path: String) -[FS]> Bool Never! {{ exists_impl(path) }}\n\n\npub fn is_dir(path: String) -[FS.Read]> Bool Never! {{ core.files.is_dir(path) }}\n\n\npub fn stat(path: String) -[FS.Read]> Stat IOError! {{ core.files.stat(path) }}\n\n\npub fn set_mode(path: String, mode: Int) IOError! -[FS.Write]> {{ core.files.set_mode(path, mode) }}\n\n\nfn anchor_for_parts(drive: String, absolute: Bool) -> String Never! {{\n    if drive.bytes().len() > 0 -> return ~drive\n    if absolute -> return \"/\"\n    \"\"\n}}\n\n\nfn join_parts(parts: [String]) -> String Never! {{\n    s := \"\"\n    first := true\n    loop p in parts {{\n        if p.bytes().len() == 0 -> next\n        if first {{\n            s = p\n            first = false\n        }} else {{ s = \"{{s}}/{{p}}\" }}\n    }}\n    s\n}}\n\n\nfn compose(anchor: String, parts: [String]) -> String Never! {{\n    s :: join_parts(parts)\n    if anchor == \"/\" {{\n        if s.bytes().len() == 0 -> return \"/\"\n        return \"/{{s}}\"\n    }}\n    if anchor.bytes().len() > 0 {{\n        if s.bytes().len() == 0 -> return \"{{anchor}}/\"\n        return \"{{anchor}}/{{s}}\"\n    }}\n    if s.bytes().len() == 0 -> return \".\"\n    s\n}}\n\n\nfn is_letter(b: U8) -> Bool Never! {{\n    n :: b\n    (n >= 65 && n <= 90) || (n >= 97 && n <= 122)\n}}\n\n\nfn is_abs_impl(path: String) -> Bool Never! {{\n    raw :: (~path).bytes()\n    if raw.len() == 0 -> return false\n    if raw[0] == (U8{{47}}) || raw[0] == (U8{{92}}) -> return true\n    raw.len() >= 2 && is_letter(raw[0]) && raw[1] == (U8{{58}})\n}}\n\npub fn is_abs(path: String) -> Bool Never! {{ is_abs_impl(path) }}\n\n\nfn is_separator(b: U8) -> Bool Never! {{ b == (U8{{47}}) || b == (U8{{92}}) }}\n\n\nfn slice(raw: [U8], start: Int, end: Int) -> String Never! {{\n    out := [U8]{{}}\n    i := start\n    loop {{\n        if i >= end || i < 0 || i >= raw.len() -> return String.from_bytes(out) ?? \"\"\n        &out.push(raw[i])\n        i = i + 1\n    }}\n}}\n\n\nfn split_slash_impl(path: String) -> [String] Never! {{\n    raw :: (~path).bytes()\n    out := [String]{{}}\n    start := 0\n    i := 0\n    loop i < raw.len() {{\n        n :: raw[i]\n        if n == 47 || n == 92 {{\n            &out.push(slice(raw, start, i))\n            start = i + 1\n        }}\n        i = i + 1\n    }}\n    &out.push(slice(raw, start, raw.len()))\n    out\n}}\n\npub fn split_slash(path: String) -> [String] Never! {{ split_slash_impl(path) }}\n\n\nfn collapse_impl(path: String) -> String Never! {{\n    raw :: (~path).bytes()\n    if raw.len() == 0 -> return \".\"\n    absolute := is_abs_impl(path)\n    drive := \"\"\n    start := 0\n    if raw.len() >= 2 && is_letter(raw[0]) && raw[1] == (U8{{58}}) {{\n        drive = slice(raw, 0, 2)\n        start = 2\n        if start < raw.len() && is_separator(raw[start]) -> start = start + 1\n    }} else if absolute {{\n        start = 1\n        loop start < raw.len() && is_separator(raw[start]) -> start = start + 1\n    }}\n    tail :: slice(raw, start, raw.len())\n    out := [String]{{}}\n    loop p in split_slash_impl(tail) {{\n        if p == \"\" || p == \".\" -> next\n        if p == \"..\" {{\n            if out.len() > 0 {{\n                prev :: out[out.len() - 1]\n                if prev != \"..\" {{\n                    _ :: &out.pop()\n                    next\n                }}\n            }}\n            if !absolute -> &out.push(\"..\")\n            next\n        }}\n        &out.push(p)\n    }}\n    compose(anchor_for_parts(drive, absolute), out)\n}}\n\npub fn collapse(path: String) -> String Never! {{ collapse_impl(path) }}\n\n\nfn strip_leading_separators(path: String) -> String Never! {{\n    raw :: (~path).bytes()\n    i := 0\n    loop i < raw.len() && is_separator(raw[i]) -> i = i + 1\n    slice(raw, i, raw.len())\n}}\n\n\nfn join_impl(a: String, b: String) -> String Never! {{\n    if b.bytes().len() == 0 -> return ~a\n    if is_abs_impl(b) -> return ~b\n    if a.bytes().len() == 0 -> return ~b\n    clean_b :: strip_leading_separators(b)\n    if clean_b.bytes().len() == 0 -> return ~a\n    last :: a.bytes()[a.bytes().len() - 1]\n    if is_separator(last) -> return \"{{a}}{{clean_b}}\"\n    \"{{a}}/{{clean_b}}\"\n}}\n\npub fn join(a: String, b: String) -> String Never! {{ join_impl(a, b) }}\n\n\npub fn absolute(path: String) -[FS, Env]> String IOError! {{\n    if is_abs_impl(~path) -> return Ok(collapse_impl(~path))\n    cwd :: sys.current_dir()\n    Ok(collapse_impl(join_impl(cwd, path)))\n}}\n\n\npub fn canonicalize(path: String) -[FS, Env]> String IOError! {{\n    core.files.canonicalize(path)\n}}\n\n\npub fn list_dir(path: String) -[FS.Read]> [DirEntry] IOError! {{ core.files.list_dir(path) }}\n\n\npub fn create_dir(path: String) IOError! -[FS.Write]> {{ core.files.create_dir(path) }}\n\n\nfn dirname_impl(path: String) -> String Never! {{\n    raw :: (~path).bytes()\n    if raw.len() == 0 -> return \"\"\n    end := raw.len()\n    loop end > 1 && is_separator(raw[end - 1]) {{\n        end = end - 1\n    }}\n    if end == 0 -> return \"/\"\n    i := end - 1\n    loop i >= 0 {{\n        if is_separator(raw[i]) {{\n            if i == 0 -> return \"/\"\n            prefix := slice(raw, 0, i)\n            if prefix.bytes().len() == 2 && prefix.bytes()[1] == (U8{{58}}) {{\n                return \"{{prefix}}/\"\n            }}\n            return prefix\n        }}\n        i = i - 1\n    }}\n    if end >= 2 && is_letter(raw[0]) && raw[1] == (U8{{58}}) -> return slice(raw, 0, 2)\n    \"\"\n}}\n\npub fn dirname(path: String) -> String Never! {{ dirname_impl(path) }}\n\n\npub fn create_dir_all(path: String) IOError! -[FS]> {{\n    if (~path).bytes().len() == 0 -> return Ok()\n    if exists(~path) ?? panic(\"exists failed\") {{\n        info :: stat(~path)\n        if info.is_dir -> return Ok()\n        return Err(io_err(\"mkdir\", path, \"path exists and is not a directory\"))\n    }}\n    parent :: dirname_impl(~path)\n    if parent.bytes().len() > 0 && parent != path -> create_dir_all(parent)\n    if !(exists(~path) ?? panic(\"exists failed\")) -> core.files.create_dir(path)\n    return Ok()\n}}\n\n\npub fn remove(path: String) IOError! -[FS.Write]> {{ core.files.remove(path) }}\n\n\npub fn remove_dir(path: String) IOError! -[FS.Write]> {{ core.files.remove_dir(path) }}\n\n\npub fn remove_all(path: String) IOError! -[FS]> {{\n    if is_dir(~path) ?? panic(\"is_dir failed\") {{\n        entries :: list_dir(~path)\n        loop e in entries -> remove_all(e.path)\n    }}\n    if lexists(~path) ?? panic(\"lexists failed\") -> core.files.remove(path)\n    return Ok()\n}}\n\n\nfn copy_file_impl(from: String, to: String) IOError! -[FS]> {{\n    bytes :: core.files.read_bytes(from)\n    parent :: dirname_impl(~to)\n    if parent.bytes().len() > 0 -> core.files.create_dir_all(parent)\n    core.files.write_bytes(~to, bytes)\n}}\n\n\npub fn copy_dir(from: String, to: String) IOError! -[FS]> {{\n    create_dir_all(~to)\n    entries :: list_dir(from)\n    loop e in entries {{\n        dest :: join_impl(~to, e.name)\n        if e.is_dir {{\n            copy_dir(e.path, dest)\n        }} else {{\n            info :: stat(e.path)\n            if info.is_file && !info.is_symlink -> copy_file_impl(e.path, dest)\n        }}\n    }}\n    return Ok()\n}}\n\n\npub fn rename(from: String, to: String) IOError! -[FS.Write]> {{ core.files.rename(from, to) }}\n\n\n/// Create `link` as a symbolic link naming `original`. The link text is stored\n/// as given and is not resolved; later path operations follow it, so lexical\n/// `Path.is_within` cannot see an escape through a link — compare\n/// `canonicalize` results instead.\npub fn symlink(original: String, link: String) IOError! -[FS.Write]> {{ core.files.symlink(original, link) }}\n\n\npub fn hard_link(original: String, link: String) IOError! -[FS.Write]> {{ core.files.hard_link(original, link) }}\n\n\npub fn read_link(path: String) -[FS.Read]> String IOError! {{ core.files.read_link(path) }}\n\n\nfn split_lines(text: String) -> [String] Never! {{\n    raw :: (~text).bytes()\n    out := [String]{{}}\n    start := 0\n    i := 0\n    loop i < raw.len() {{\n        if raw[i] == (U8{{10}}) {{\n            line := slice(raw, start, i)\n            if line.bytes().len() > 0 && line.bytes()[line.bytes().len() - 1] == (U8{{13}}) {{\n                line = slice(line.bytes(), 0, line.bytes().len() - 1)\n            }}\n            &out.push(line)\n            start = i + 1\n        }}\n        i = i + 1\n    }}\n    if start < raw.len() -> &out.push(slice(raw, start, raw.len()))\n    out\n}}\n\n\nfn trim(text: String) -> String Never! {{\n    raw :: (~text).bytes()\n    a := 0\n    b := raw.len()\n    loop a < b {{\n        n :: raw[a]\n        if n == 32 || n == 9 -> a = a + 1 else -> break\n    }}\n    loop b > a {{\n        n :: raw[b - 1]\n        if n == 32 || n == 9 -> b = b - 1 else {{ break }}\n    }}\n    slice(raw, a, b)\n}}\n\n\nfn glob_bytes(pat: [U8], pi: Int, name: [U8], ni: Int) -> Bool Never! {{\n    if pi >= pat.len() -> return ni >= name.len()\n    if pat[pi] == (U8{{42}}) {{\n        if glob_bytes(pat, pi + 1, name, ni) -> return true\n        if ni < name.len() -> return glob_bytes(pat, pi, name, ni + 1)\n        return false\n    }}\n    if ni >= name.len() -> return false\n    if pat[pi] == (U8{{63}}) -> return glob_bytes(pat, pi + 1, name, ni + 1)\n    if pat[pi] == (U8{{91}}) {{\n        j := pi + 1\n        negated := false\n        if j < pat.len() && (pat[j] == (U8{{33}}) || pat[j] == (U8{{94}})) {{\n            negated = true\n            j = j + 1\n        }}\n        matched := false\n        closed := false\n        loop j < pat.len() {{\n            if pat[j] == (U8{{93}}) {{\n                closed = true\n                break\n            }}\n            if j + 2 < pat.len() && pat[j + 1] == (U8{{45}}) && pat[j + 2] != (U8{{93}}) {{\n                if name[ni] >= pat[j] && name[ni] <= pat[j + 2] -> matched = true\n                j = j + 3\n            }} else {{\n                if name[ni] == pat[j] -> matched = true\n                j = j + 1\n            }}\n        }}\n        if !closed -> return pat[pi] == name[ni] && glob_bytes(pat, pi + 1, name, ni + 1)\n        if negated -> matched = !matched\n        if !matched -> return false\n        return glob_bytes(pat, j + 1, name, ni + 1)\n    }}\n    if pat[pi] == name[ni] -> return glob_bytes(pat, pi + 1, name, ni + 1)\n    false\n}}\n\n\nfn glob_seg(pat: String, name: String) -> Bool Never! {{ glob_bytes(pat.bytes(), 0, name.bytes(), 0) }}\n\n\nfn glob_parts(pat: [String], pi: Int, tgt: [String], ti: Int) -> Bool Never! {{\n    if pi >= pat.len() -> return ti >= tgt.len()\n    if pat[pi] == \"**\" {{\n        if glob_parts(pat, pi + 1, tgt, ti) -> return true\n        if ti < tgt.len() -> return glob_parts(pat, pi, tgt, ti + 1)\n        return false\n    }}\n    if ti >= tgt.len() -> return false\n    if !glob_seg(pat[pi], tgt[ti]) -> return false\n    glob_parts(pat, pi + 1, tgt, ti + 1)\n}}\n\n\nfn glob_parts_for(path: String) -> [String] Never! {{\n    raw :: (~path).bytes()\n    out := [String]{{}}\n    drive := \"\"\n    absolute := is_abs_impl(path)\n    start := 0\n    if raw.len() >= 2 && is_letter(raw[0]) && raw[1] == (U8{{58}}) {{\n        drive = slice(raw, 0, 2)\n        start = 2\n        if start < raw.len() && is_separator(raw[start]) -> start = start + 1\n    }} else if absolute {{\n        &out.push(\"/\")\n        start = 1\n        loop start < raw.len() && is_separator(raw[start]) -> start = start + 1\n    }}\n    if drive.bytes().len() > 0 -> &out.push(drive)\n    loop p in split_slash_impl(slice(raw, start, raw.len())) {{\n        if p.bytes().len() > 0 -> &out.push(p)\n    }}\n    out\n}}\n\n\nfn glob_match_impl(pattern: String, path: String) -> Bool Never! {{\n    pp :: glob_parts_for(pattern)\n    tt :: glob_parts_for(path)\n    glob_parts(pp, 0, tt, 0)\n}}\n\npub fn glob_match(pattern: String, path: String) -> Bool Never! {{ glob_match_impl(pattern, path) }}\n\n\nfn has_separator(path: String) -> Bool Never! {{\n    loop b in (~path).bytes() {{\n        if is_separator(b) -> return true\n    }}\n    false\n}}\n\n\nfn anchor_of(path: String) -> String Never! {{\n    raw :: (~path).bytes()\n    if raw.len() >= 2 && is_letter(raw[0]) && raw[1] == (U8{{58}}) -> return slice(raw, 0, 2)\n    if raw.len() > 0 && is_separator(raw[0]) -> return \"/\"\n    \"\"\n}}\n\n\nfn path_parts(path: String) -> [String] Never! {{\n    raw :: (~path).bytes()\n    start := 0\n    if raw.len() >= 2 && is_letter(raw[0]) && raw[1] == (U8{{58}}) {{\n        start = 2\n        if start < raw.len() && is_separator(raw[start]) -> start = start + 1\n    }} else if raw.len() > 0 && is_separator(raw[0]) {{\n        start = 1\n        loop start < raw.len() && is_separator(raw[start]) -> start = start + 1\n    }}\n    out := [String]{{}}\n    loop p in split_slash_impl(slice(raw, start, raw.len())) {{\n        if p.bytes().len() > 0 -> &out.push(p)\n    }}\n    out\n}}\n\n\nfn relative_impl(path: String, start: String) -> String Never! {{\n    a :: collapse_impl(path)\n    b :: collapse_impl(start)\n    if anchor_of(a) != anchor_of(b) -> return a\n    ap :: path_parts(a)\n    bp :: path_parts(b)\n    i := 0\n    loop i < ap.len() && i < bp.len() {{\n        if ap[i] != bp[i] -> break\n        i = i + 1\n    }}\n    out := [String]{{}}\n    j := i\n    loop j < bp.len() {{\n        &out.push(\"..\")\n        j = j + 1\n    }}\n    loop i < ap.len() {{\n        &out.push(ap[i])\n        i = i + 1\n    }}\n    s :: join_parts(out)\n    if s.bytes().len() == 0 -> return \".\"\n    s\n}}\n\npub fn relative(path: String, start: String) -> String Never! {{ relative_impl(path, start) }}\n\n\nfn ignored(name: String, path: String, root: String, skip: [String]) -> Bool Never! {{\n    rel :: relative_impl(path, root)\n    loop pat in skip {{\n        if has_separator(pat) {{\n            if glob_match_impl(pat, rel) -> return true\n        }} else if glob_seg(pat, name) -> return true\n    }}\n    false\n}}\n\n\nfn walk_rec(path: String, root: String, skip: [String], files_only: Bool) -[FS]> [WalkEntry] IOError! {{\n    out := [WalkEntry]{{}}\n    entries :: core.files.list_dir(~path)\n    loop e in entries {{\n        if ignored(e.name, ~e.path, ~root, ~skip) -> next\n        rel :: relative_impl(~e.path, ~root)\n        depth := 1\n        loop b in rel.bytes() {{\n            if is_separator(b) -> depth = depth + 1\n        }}\n        if e.is_dir {{\n            if !files_only -> &out.push(WalkEntry{{path: e.path, relative: rel, is_dir: true, depth: depth}})\n            kids :: walk_rec(~e.path, ~root, ~skip, files_only)\n            loop k in kids -> &out.push(k)\n        }} else if !files_only || !e.is_dir {{\n            &out.push(WalkEntry{{path: e.path, relative: rel, is_dir: false, depth: depth}})\n        }}\n    }}\n    Ok(out)\n}}\n\n\nfn walk_impl(root: String, ignore: String?, files_only: Bool) -[FS]> [WalkEntry] IOError! {{\n    skip := [String]{{}}\n    ign :: ignore ?? \"\"\n    if ign.bytes().len() > 0 {{\n        text :: core.files.read(join_impl(~root, ~ign))\n        loop line in split_lines(text) {{\n            t :: trim(line)\n            if t.bytes().len() == 0 -> next\n            if t.bytes()[0] == (U8{{35}}) -> next\n            &skip.push(t)\n        }}\n        &skip.push(ign)\n    }}\n    entries :: walk_rec(~root, ~root, ~skip, files_only)\n    Ok(entries)\n}}\n\n\npub fn walk(root: String, ignore: String?) -[FS]> [WalkEntry] IOError! {{\n    walk_impl(root, ignore, false)\n}}\n\n\npub fn walk_parallel(root: String, ignore: String?) -[FS]> [WalkEntry] IOError! {{\n    // Cooperative Jet has no thread pool yet; the walk is the same walk.\n    walk_impl(root, ignore, false)\n}}\n\n\npub fn walk_files(root: String, ignore: String?) -[FS]> [WalkEntry] IOError! {{\n    walk_impl(root, ignore, true)\n}}\n\n\nfn has_meta(seg: String) -> Bool Never! {{\n    loop b in seg.bytes() {{\n        n :: b\n        if n == 42 || n == 63 || n == 91 -> return true\n    }}\n    false\n}}\n\n\nfn glob_root(pattern: String) -> String Never! {{\n    parts :: split_slash_impl(pattern)\n    static := [String]{{}}\n    i := 0\n    loop i < parts.len() {{\n        if has_meta(parts[i]) -> break\n        &static.push(parts[i])\n        i = i + 1\n    }}\n    if !is_abs_impl(pattern) {{\n        root :: join_parts(static)\n        if root.bytes().len() == 0 -> return \".\"\n        return root\n    }}\n    drive := \"\"\n    raw :: pattern.bytes()\n    if raw.len() >= 2 && is_letter(raw[0]) && raw[1] == (U8{{58}}) -> drive = slice(raw, 0, 2)\n    body := [String]{{}}\n    j := 0\n    if drive.bytes().len() > 0 && static.len() > 0 && static[0] == drive -> j = 1\n    loop j < static.len() {{\n        &body.push(static[j])\n        j = j + 1\n    }}\n    compose(anchor_for_parts(drive, true), body)\n}}\n\n\npub fn glob(pattern: String) -[FS]> [String] IOError! {{\n    if !has_meta(~pattern) {{\n        if exists_impl(~pattern) -> return Ok([String]{{~pattern}})\n        return Ok([String]{{}})\n    }}\n    root :: glob_root(~pattern)\n    entries :: core.files.walk(~root)\n    out := [String]{{}}\n    loop e in entries {{\n        candidate := e.path\n        relative_candidate := ~candidate\n        cbytes :: candidate.bytes()\n        if cbytes.len() >= 2 && cbytes[0] == (U8{{46}}) && is_separator(cbytes[1]) {{\n            relative_candidate = slice(cbytes, 2, cbytes.len())\n        }}\n        if glob_match_impl(~pattern, ~candidate) || glob_match_impl(~pattern, relative_candidate) {{\n            &out.push(candidate)\n        }}\n    }}\n    Ok(out)\n}}\n\n\npub fn temp_dir(prefix: String) -[FS]> TempDir IOError! {{ core.files.temp_dir(prefix) }}\n\n\npub fn temp_file(prefix: String) -[FS]> TempFile IOError! {{ core.files.temp_file(prefix) }}\n\n\n/// Take an exclusive lock by creating `path` (create-new). A second `lock` on\n/// a held path fails with an `IOError`; the lock file is removed when the\n/// returned `FileLock` leaves scope, which makes the path available again.\npub fn lock(path: String) -[FS]> FileLock IOError! {{ core.files.lock(path) }}\n\n\npub fn basename(path: String) -> String Never! {{\n    raw :: (~path).bytes()\n    i := raw.len() - 1\n    loop i >= 0 {{\n        if raw[i] == (U8{{47}}) || raw[i] == (U8{{92}}) -> return slice(raw, i + 1, raw.len())\n        i = i - 1\n    }}\n    ~path\n}}\n\n\npub fn suffix(path: String) -> String Never! {{\n    name :: basename(path)\n    raw :: name.bytes()\n    i := raw.len() - 1\n    loop i > 0 {{\n        if raw[i] == (U8{{46}}) -> return slice(raw, i, raw.len())\n        i = i - 1\n    }}\n    \"\"\n}}\n\n\npub fn stem(path: String) -> String Never! {{\n    name :: basename(path)\n    raw :: name.bytes()\n    i := raw.len() - 1\n    loop i > 0 {{\n        if raw[i] == (U8{{46}}) -> return slice(raw, 0, i)\n        i = i - 1\n    }}\n    ~name\n}}\n\n\npub fn with_suffix(path: String, next: String) -> String Never! {{\n    dir :: dirname(path)\n    base :: stem(path)\n    joined :: \"{{base}}{{next}}\"\n    if dir.bytes().len() == 0 -> return joined\n    join(dir, joined)\n}}\n\n\npub fn with_name(path: String, name: String) -> String Never! {{\n    dir :: dirname(path)\n    if dir.bytes().len() == 0 -> return ~name\n    join(dir, name)\n}}\n\n\npub fn is_absolute(path: String) -> Bool Never! {{ is_abs(path) }}\n\n\nfn is_file_impl(path: String) -> Bool Never! {{\n    info :: core.files.stat(path) ?? return false\n    info.is_file\n}}\n\npub fn is_file(path: String) -[FS]> Bool Never! {{ is_file_impl(path) }}\n\n\npub fn is_symlink(path: String) -[FS]> Bool Never! {{\n    info :: core.files.stat(path) ?? return false\n    info.is_symlink\n}}\n\n\npub fn cwd() -[FS, Env]> String IOError! {{ sys.current_dir() }}\n\n\npub fn home() -[FS, Env]> String IOError! {{\n    core.sys.home_dir() ?? return Err(io_err(\"home\", \"\", \"home directory unavailable\"))\n}}\n\n\npub fn expanduser(path: String) -[FS, Env]> String IOError! {{\n    raw :: (~path).bytes()\n    if raw.len() == 0 || raw[0] != (U8{{126}}) -> return Ok(~path)\n    h :: home()\n    if raw.len() == 1 -> return Ok(h)\n    if raw[1] == (U8{{47}}) || raw[1] == (U8{{92}}) -> return Ok(join_impl(h, slice(raw, 2, raw.len())))\n    Ok(~path)\n}}\n\n\npub fn touch(path: String) IOError! -[FS]> {{\n    if exists_impl(~path) {{\n        core.files.fsync(path)\n        return Ok()\n    }}\n    parent :: dirname_impl(~path)\n    if parent.bytes().len() > 0 -> core.files.create_dir_all(parent)\n    core.files.write_bytes(path, [U8]{{}})\n}}\n\n\npub fn relocate(from: String, to: String) IOError! -[FS]> {{ core.files.rename(from, to) }}\n\n\n/// Python-compatible spelling for an atomic replacement rename.\npub fn replace(from: String, to: String) IOError! -[FS]> {{ relocate(from, to) }}\n\n\n/// Return `path` relative to `start`, using the same normalized path rules.\npub fn relativeto(path: String, start: String) -> String Never! {{ relative(path, start) }}\n\n\n/// Python-compatible spelling for `set_mode`.\npub fn chmod(path: String, mode: Int) IOError! -[FS]> {{ core.files.set_mode(path, mode) }}\n\n\n/// Copy the bytes of `from` to `to`, creating missing parent directories.\n/// Unlike Python's `shutil.copy2`, permission bits and timestamps are not\n/// copied: the new file takes the default mode.\npub fn copy2(from: String, to: String) IOError! -[FS]> {{ copy_file_impl(from, to) }}\n\n\n/// Python-compatible spelling for a single-file copy.\npub fn copyfile(from: String, to: String) IOError! -[FS]> {{ copy2(from, to) }}\n\n\n/// Create one directory, or all missing parents when `parents` is true.\npub fn mkdir(path: String, parents: Bool) IOError! -[FS]> {{\n    if parents -> return core.files.create_dir_all(path)\n    core.files.create_dir(path)\n}}\n\n\npub fn rmdir(path: String) IOError! -[FS]> {{ core.files.remove_dir(path) }}\n\n\npub fn unlink(path: String) IOError! -[FS]> {{ core.files.remove(path) }}\n\n\npub fn joinpath(a: String, b: String) -> String Never! {{ join(a, b) }}\n\n\n/// Python `os` spellings backed by the same checked filesystem surface.\npub fn getcwd() -[FS, Env]> String IOError! {{ cwd() }}\n\n\npub fn chdir(path: String) IOError! -[FS, Env]> {{ sys.set_current_dir(path) }}\n\n\npub fn scandir(path: String) -[FS]> [DirEntry] IOError! {{ core.files.list_dir(path) }}\n\n\npub fn gettempdir() -[Env]> String Never! {{ sys.temp_dir() }}\n\n\npub fn getenv(name: String) -[Env]> String? Never! {{ sys.get(name) }}\n\n\npub fn read_lines(path: String) -[FS]> [String] IOError! {{\n    text :: core.files.read(path)\n    Ok(split_lines(text))\n}}\n\n\npub fn write_lines(path: String, lines: [String]) IOError! -[FS]> {{\n    s := \"\"\n    loop line in lines -> s = \"{{s}}{{line}}\\n\"\n    core.files.write(path, s)\n}}\n\n\npub fn commonpath(paths: [String]) -> String Never! {{\n    if paths.len() == 0 -> return \"\"\n    first :: collapse_impl(paths[0])\n    anchor := anchor_of(first)\n    parts := path_parts(first)\n    loop p in paths {{\n        cur :: collapse_impl(p)\n        if anchor_of(cur) != anchor -> return \"\"\n        next :: path_parts(cur)\n        n := parts.len()\n        if next.len() < n -> n = next.len()\n        k := 0\n        loop k < n {{\n            if parts[k] != next[k] -> break\n            k = k + 1\n        }}\n        kept := [String]{{}}\n        i := 0\n        loop i < k {{\n            &kept.push(parts[i])\n            i = i + 1\n        }}\n        parts = kept\n    }}\n    compose(anchor, parts)\n}}\n\n\npub fn fnmatch(name: String, pattern: String) -> Bool Never! {{ glob_match(pattern, name) }}\n\n\nfn split_path_env(text: String) -> [String] Never! {{\n    raw :: (~text).bytes()\n    out := [String]{{}}\n    start := 0\n    i := 0\n    sep := 58\n    loop b in raw {{\n        if b == (U8{{59}}) {{\n            sep = 59\n            break\n        }}\n    }}\n    loop i <= raw.len() {{\n        n := 0\n        if i < raw.len() -> n = raw[i]\n        if i == raw.len() || n == sep {{\n            &out.push(slice(raw, start, i))\n            start = i + 1\n        }}\n        i = i + 1\n    }}\n    out\n}}\n\n\npub fn which(name: String) -[FS, Env]> String? Never! {{\n    if is_abs_impl(~name) {{\n        if is_file_impl(~name) -> return Val(~name)\n        return None\n    }}\n    path_var :: sys.get(\"PATH\") ?? \"\"\n    loop dir in split_path_env(path_var) {{\n        base := dir\n        if base.bytes().len() == 0 -> base = \".\"\n        cand :: join_impl(~base, ~name)\n        if is_file_impl(cand) -> return Val(cand)\n    }}\n    None\n}}\n\n\nfn slice_path(text: String, start: Int, end: Int) -> String Never! {{\n    raw :: (~text).bytes()\n    out := [U8]{{}}\n    i := start\n    loop {{\n        if i >= end || i < 0 || i >= raw.len() -> return String.from_bytes(out) ?? \"\"\n        &out.push(raw[i])\n        i = i + 1\n    }}\n}}\n\n\npub fn splitext(path: String) -> (ext: String, root: String) Never! {{\n    ext :: suffix(~path)\n    if ext.bytes().len() == 0 -> return (root: ~path, ext: \"\")\n    root :: slice_path(~path, 0, (~path).bytes().len() - ext.bytes().len())\n    (root: root, ext: ext)\n}}\n\n\npub fn split(path: String) -> (dir: String, name: String) Never! {{\n    (dir: dirname(path), name: basename(path))\n}}\n\n\npub fn normpath(path: String) -> String Never! {{ collapse(path) }}\n\n\npub fn getsize(path: String) -[FS]> Int IOError! {{\n    s :: core.files.stat(path)\n    Ok(s.size)\n}}\n\n\npub fn getmtime(path: String) -[FS]> Int IOError! {{\n    s :: core.files.stat(path)\n    Ok(s.modified_ms)\n}}\n\n\npub fn lexists(path: String) -[FS]> Bool Never! {{ exists_impl(~path) || is_symlink(~path) }}\n\n\npub fn samefile(a: String, b: String) -[FS]> Bool IOError! {{\n    sa :: core.files.stat(a)\n    sb :: core.files.stat(b)\n    _ :: sa\n    _ :: sb\n    Err(io_err(\"samefile\", a, \"file identity requires provider inode/device support\"))\n}}\n\n\npub fn commonprefix(paths: [String]) -> String Never! {{\n    if paths.len() == 0 -> return \"\"\n    pref := ~paths[0]\n    loop p in paths {{\n        n := pref.bytes().len()\n        if p.bytes().len() < n -> n = p.bytes().len()\n        i := 0\n        loop i < n {{\n            if pref.bytes()[i] != p.bytes()[i] -> break\n            i = i + 1\n        }}\n        pref = slice_path(pref, 0, i)\n    }}\n    pref\n}}\n\n\npub fn expandvars(path: String) -[Env]> String IOError! {{\n    raw :: (~path).bytes()\n    out := \"\"\n    i := 0\n    loop i < raw.len() {{\n        if raw[i] == (U8{{36}}) {{\n            i = i + 1\n            braced := false\n            if i < raw.len() && raw[i] == (U8{{123}}) {{\n                braced = true\n                i = i + 1\n            }}\n            start := i\n            loop i < raw.len() {{\n                n :: raw[i]\n                if braced && n == 125 -> break\n                letter := (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || n == 95 || (n >= 48 && n <= 57)\n                if !braced && !letter -> break\n                i = i + 1\n            }}\n            key :: slice_path(path, start, i)\n            if braced && i < raw.len() && raw[i] == (U8{{125}}) -> i = i + 1\n            val :: sys.get(key) ?? \"\"\n            out = \"{{out}}{{val}}\"\n            next\n        }}\n        out = \"{{out}}{{String.from_bytes([U8]{{raw[i]}}) ?? \"\"}}\"\n        i = i + 1\n    }}\n    Ok(out)\n}}\n\n\npub fn move(from: String, to: String) IOError! -[FS]> {{ core.files.rename(from, to) }}\n\n\npub fn rmtree(path: String) IOError! -[FS]> {{ core.files.remove_all(path) }}\n\n\npub fn makedirs(path: String) IOError! -[FS]> {{ core.files.create_dir_all(path) }}\n\n\npub fn listdir(path: String) -[FS]> [String] IOError! {{\n    entries :: core.files.list_dir(path)\n    out := [String]{{}}\n    loop e in entries -> &out.push(e.name)\n    Ok(out)\n}}\n\n\npub fn glob_recursive(pattern: String) -[FS]> [String] IOError! {{ core.files.glob(pattern) }}\n\n\npub fn fnmatch_filter(names: [String], pattern: String) -> [String] Never! {{\n    out := [String]{{}}\n    loop n in names {{\n        if fnmatch(n, pattern) -> &out.push(n)\n    }}\n    out\n}}\n\n\npub fn is_mount(path: String) -[FS]> Bool Never! {{\n    if !core.files.is_dir(~path) -> return false\n    parent :: dirname(~path)\n    if parent == path -> return true\n    false\n}}\n\n\npub fn ensure_parent(path: String) IOError! -[FS]> {{ core.files.create_dir_all(dirname_impl(path)) }}\n\n\nfn slice_bytes(raw: [U8], start: Int, end: Int) -> [U8] Never! {{\n    out := [U8]{{}}\n    i := start\n    loop {{\n        if i >= end || i < 0 || i >= raw.len() -> return ~out\n        &out.push(raw[i])\n        i = i + 1\n    }}\n}}\n\n\npub fn readdir(path: String) -[FS]> [DirEntry] IOError! {{ core.files.list_dir(path) }}\n\n\npub fn walkdir(root: String, ignore: String?) -[FS]> [WalkEntry] IOError! {{ walk_impl(root, ignore, false) }}\n\n\npub fn truncate(path: String, size: Int) IOError! -[FS]> {{\n    if size < 0 -> return Err(io_err(\"truncate\", path, \"negative size\"))\n    bytes :: core.files.read_bytes(~path)\n    if size < bytes.len() {{\n        core.files.write_bytes(~path, slice_bytes(bytes, 0, size))\n    }} else {{\n        out := bytes\n        loop out.len() < size -> &out.push(U8{{0}})\n        core.files.write_bytes(~path, out)\n    }}\n}}\n\n\npub fn createdirectory(path: String) IOError! -[FS]> {{ core.files.create_dir(path) }}\n\n\npub fn filesize(path: String) -[FS]> Int IOError! {{\n    info :: core.files.stat(path)\n    Ok(info.size)\n}}\n\n\npub fn delete(path: String) IOError! -[FS]> {{ core.files.remove(path) }}\n\n\npub fn cp(from: String, to: String) IOError! -[FS]> {{ copy2(from, to) }}\n\n\npub fn rm(path: String) IOError! -[FS]> {{ core.files.remove(path) }}\n\n\npub fn realpath(path: String) -[FS, Env]> String IOError! {{ core.files.canonicalize(path) }}\n\n\npub fn pwd() -[FS, Env]> String IOError! {{ cwd() }}\n\n\npub fn tmpdir(prefix: String) -[FS]> String IOError! {{\n    temp :: core.files.temp_dir(prefix)\n    Ok(temp.path)\n}}\n\n\npub fn topath(path: String) -[FS, Env]> String IOError! {{ core.files.canonicalize(path) }}\n\n\npub fn cd(path: String) IOError! -[FS, Env]> {{ sys.set_current_dir(path) }}\n\n\n"}
