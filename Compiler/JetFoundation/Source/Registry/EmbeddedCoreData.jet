tring:DataTree]{{}})\n        if out.get(key) == {{\n            .Val(existing) -> {{\n                if existing == {{\n                    .Array(items) -> {{\n                        mutable := ~items\n                        &mutable.push(item)\n                        _ :: &out.add(key, DataTree.Array(mutable))\n                    }}\n                    .Object(obj) -> {{\n                        _ :: &out.add(key, DataTree.Array([DataTree]{{DataTree.Object(obj), item}}))\n                    }}\n                    else -> _ :: &out.add(key, DataTree.Array([DataTree]{{item}}))\n                }}\n            }}\n            else -> _ :: &out.add(key, DataTree.Array([DataTree]{{item}}))\n        }}\n        return out\n    }}\n    child := [String:DataTree]{{}}\n    existing_array := false\n    array_items := [DataTree]{{}}\n    if out.get(key) == {{\n        .Val(existing) -> {{\n            if existing == {{\n                .Object(obj) -> child = obj\n                .Array(items) -> {{\n                    existing_array = true\n                    if items.len() > 0 {{\n                        last_item :: items[items.len() - 1]\n                        if last_item == {{\n                            .Object(obj) -> child = obj\n                            else -> {{ _ := 0 }}\n                        }}\n                    }}\n                    array_items = ~items\n                }}\n                else -> {{ _ := 0 }}\n            }}\n        }}\n        else -> {{ _ := 0 }}\n    }}\n    nested :: ensure_array_path(child, path, i + 1)\n    if existing_array {{\n        if array_items.len() == 0 {{\n            &array_items.push(DataTree.Object(nested))\n        }} else {{\n            array_items[array_items.len() - 1] = DataTree.Object(nested)\n        }}\n        _ :: &out.add(key, DataTree.Array(array_items))\n    }} else {{\n        _ :: &out.add(key, DataTree.Object(nested))\n    }}\n    out\n}}\n\nfn has_path(entries: [String:DataTree], path: [String], i: Int) -> Bool Never! {{\n    if i >= path.len() -> return false\n    key :: path[i]\n    if i == path.len() - 1 -> return entries.has_key(key)\n    child :: entries.get(key) ?? return false\n    if child == {{\n        .Object(obj) -> return has_path(obj, path, i + 1)\n        .Array(items) -> {{\n            if items.len() == 0 -> return false\n            last :: items[items.len() - 1]\n            if last == {{\n                .Object(obj) -> return has_path(obj, path, i + 1)\n                else -> return false\n            }}\n        }}\n        else -> return false\n    }}\n}}\n\nfn put_path(entries: [String:DataTree], path: [String], i: Int, value: DataTree) -> [String:DataTree] Never! {{\n    out := ~entries\n    key :: path[i]\n    if i == path.len() - 1 {{\n        _ :: &out.add(key, value)\n        return out\n    }}\n    child := [String:DataTree]{{}}\n    if out.get(key) == {{\n        .Val(existing) -> {{\n            if existing == {{\n                .Object(obj) -> child = obj\n                .Array(items) -> {{\n                    if items.len() > 0 {{\n                        mutable := ~items\n                        last_index := mutable.len() - 1\n                        if mutable[last_index] == {{\n                            .Object(obj) -> {{\n                                nested :: put_path(obj, path, i + 1, value)\n                                mutable[last_index] = DataTree.Object(nested)\n                                _ :: &out.add(key, DataTree.Array(mutable))\n                                return out\n                            }}\n                            else -> {{ _ := 0 }}\n                        }}\n                    }}\n                }}\n                else -> {{ _ := 0 }}\n            }}\n        }}\n        else -> {{ _ := 0 }}\n    }}\n    nested :: put_path(child, path, i + 1, value)\n    _ :: &out.add(key, DataTree.Object(nested))\n    out\n}}\n\nfn render_toml(value: DataTree) -> String {{\n    if value == {{\n        .Object(entries) -> return render_toml_table(entries, \"\")\n        else -> return toml_leaf(value)\n    }}\n}}\n\nfn render_toml_table(entries: [String:DataTree], prefix: String) -> String {{\n    out := \"\"\n    loop pair in entries {{\n        if pair.value == {{\n            .Object(_) -> next\n            .Array(items) -> {{\n                if all_objects(items) -> next\n            }}\n            else -> {{ _ := 0 }}\n        }}\n        out = \"{{out}}{{toml_key(pair.key)}} = {{toml_leaf(pair.value)}}\\n\"\n    }}\n    loop pair in entries {{\n        if pair.value == {{\n            .Object(obj) -> {{\n                path :: join_key(prefix, pair.key)\n                out = \"{{out}}\\n[{{path}}]\\n{{render_toml_table(obj, path)}}\"\n            }}\n            .Array(items) -> {{\n                if all_objects(items) {{\n                    path :: join_key(prefix, pair.key)\n                    loop item in items {{\n                        if item == {{\n                            .Object(obj) -> out = \"{{out}}\\n[[{{path}}]]\\n{{render_toml_table(obj, path)}}\"\n                            else -> {{ _ := 0 }}\n                        }}\n                    }}\n                }}\n            }}\n            else -> {{ _ := 0 }}\n        }}\n    }}\n    out\n}}\n\nfn all_objects(items: [DataTree]) -> Bool {{\n    if items.len() == 0 -> return false\n    loop item in items {{\n        if item == {{\n            .Object(_) -> next\n            else -> return false\n        }}\n    }}\n    true\n}}\n\nfn join_key(prefix: String, key: String) -> String {{\n    if prefix.len() == 0 -> return toml_key(key)\n    \"{{prefix}}.{{toml_key(key)}}\"\n}}\n\nfn toml_key(key: String) -> String {{\n    raw :: key.bytes()\n    if raw.len() > 0 {{\n        valid := true\n        loop b in raw {{\n            n :: b\n            if !((n >= 65 && n <= 90) || (n >= 97 && n <= 122) || (n >= 48 && n <= 57) || n == 95 || n == 45) {{