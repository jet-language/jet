    FoundationCoreSource{module_name: "core.text.html", alias: "core_text_html", path: "Core/text/html.jet", owner: "", owned_members: [String]{"attr_escape", "escape", "escape_quote", "strip_tags", "text_escape", "unescape", "unescape_and_strip"}, source: "package {{\n    name: \"core.text.html\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"HTML escaping, entity decoding, and tag stripping.\"\n    license: \"MIT\"\n    outputs: {{\n        html: .Library{{ entry: html }}\n    }}\n}}\n\nuse core.text as unicode\n\n// XML-safe escaping and bounded entity decoding. Unknown entities remain\n// unchanged; tag stripping is deliberately a span operation, not a parser.\npub fn escape(text: String) -> String Never! {{ escape_quote(text, true) }}\n\npub fn escape_quote(text: String, quote: Bool) -> String Never! {{\n    out := \"\"\n    loop ch in unicode.scalars(text) {{\n        if ch == \"&\" -> out = \"{{out}}&amp;\"\n        else if ch == \"<\" -> out = \"{{out}}&lt;\"\n        else if ch == \">\" -> out = \"{{out}}&gt;\"\n        else if quote && ch == \"\\\"\" -> out = \"{{out}}&quot;\"\n        else if quote && ch == \"'\" -> out = \"{{out}}&#x27;\"\n        else -> out = \"{{out}}{{ch}}\"\n    }}\n    out\n}}\n\npub fn unescape(text: String) -> String Never! {{\n    raw :: text.bytes()\n    out := \"\"\n    i := 0\n    loop i < raw.len() {{\n        if raw[i] != (U8{{38}}) {{\n            width :: utf8_width(raw, i)\n            out = \"{{out}}{{slice_b(raw, i, i + width)}}\"\n            i = i + width\n            next\n        }}\n        semi := i + 1\n        loop semi < raw.len() && semi - i <= 32 {{\n            if raw[semi] == (U8{{59}}) -> break\n            semi = semi + 1\n        }}\n        if semi < raw.len() && raw[semi] == (U8{{59}}) {{\n            name :: String.from_bytes(slice_b(raw, i + 1, semi)) ?? \"\"\n            decoded :: entity(name)\n            if decoded.bytes().len() > 0 {{\n                out = \"{{out}}{{decoded}}\"\n                i = semi + 1\n                next\n            }}\n        }}\n        out = \"{{out}}&\"\n        i = i + 1\n    }}\n    out\n}}\n\npub fn strip_tags(text: String) -> String Never! {{\n    raw :: text.bytes()\n    out := [U8]{{}}\n    i := 0\n    loop i < raw.len() {{\n        if raw[i] != (U8{{60}}) {{\n            &out.push(raw[i])\n            i = i + 1\n            next\n        }}\n        close := i + 1\n        loop close < raw.len() && raw[close] != (U8{{62}}) -> close = close + 1\n        if close >= raw.len() {{\n            &out.push(raw[i])\n            i = i + 1\n            next\n        }}\n        i = close + 1\n    }}\n    String.from_bytes(out) ?? text\n}}\n\npub fn unescape_and_strip(text: String) -> String Never! {{ unescape(strip_tags(text)) }}\npub fn attr_escape(text: String) -> String Never! {{ escape_quote(text, true) }}\npub fn text_escape(text: String) -> String Never! {{ escape_quote(text, false) }}\n\nfn entity(name: String) -> String {{\n    if name == \"amp\" -> return \"&\"\n    if name == \"lt\" -> return \"<\"\n    if name == \"gt\" -> return \">\"\n    if name == \"quot\" -> return \"\\\"\"\n    if name == \"apos\" -> return \"'\"\n    if name == \"nbsp\" -> return \" \"\n    if name == \"copy\" -> return \"©\"\n    if name == \"reg\" -> return \"®\"\n    if name == \"trade\" -> return \"™\"\n    if name == \"mdash\" -> return \"—\"\n    if name == \"ndash\" -> return \"–\"\n    if name == \"hellip\" -> return \"…\"\n    raw :: name.bytes()\n    if raw.len() < 2 || raw[0] != (U8{{35}}) -> return \"\"\n    n := 0\n    i := 1\n    base := 10\n    if raw[1] == (U8{{120}}) || raw[1] == (U8{{88}}) {{\n        base = 16\n        i = 2\n    }}\n    if i >= raw.len() -> return \"\"\n    loop i < raw.len() {{\n        digit := if base == 16 -> hex_val(raw[i]) else -> decimal_val(raw[i])\n        d :: digit ?? return \"\"\n        n = n * base + d\n        i = i + 1\n    }}\n    scalar(n)\n}}\n\nfn scalar(n: Int) -> String {{\n    if n == 0 || n > 1114111 || (n >= 55296 && n <= 57343) -> return \"�\"\n    out := [U8]{{}}\n    if n < 128 -> &out.push(U8{{n}})\n    else if n < 2048 {{\n        &out.push(U8{{192 | (n >> 6)}})\n        &out.push(U8{{128 | (n & 63)}})\n    }} else if n < 65536 {{\n        &out.push(U8{{224 | (n >> 12)}})\n        &out.push(U8{{128 | ((n >> 6) & 63)}})\n        &out.push(U8{{128 | (n & 63)}})\n    }} else {{\n        &out.push(U8{{240 | (n >> 18)}})\n        &out.push(U8{{128 | ((n >> 12) & 63)}})\n        &out.push(U8{{128 | ((n >> 6) & 63)}})\n        &out.push(U8{{128 | (n & 63)}})\n    }}\n    String.from_bytes(out) ?? \"�\"\n}}\n\nfn decimal_val(b: U8) -> Int? {{\n    n :: Int.from_u8(b)\n    if n < 48 || n > 57 -> return None\n    Val(n - 48)\n}}\n\nfn hex_val(b: U8) -> Int? {{\n    n :: Int.from_u8(b)\n    if n >= 48 && n <= 57 -> return Val(n - 48)\n    if n >= 65 && n <= 70 -> return Val(n - 55)\n    if n >= 97 && n <= 102 -> return Val(n - 87)\n    None\n}}\n\nfn utf8_width(raw: [U8], at: Int) -> Int {{\n    if at < 0 || at >= raw.len() -> return 1\n    b :: raw[at]\n    if b < 128 -> return 1\n    if b >= 194 && b <= 223 && at + 1 < raw.len() && raw[at + 1] >= 128 && raw[at + 1] <= 191 -> return 2\n    if b >= 224 && b <= 239 && at + 2 < raw.len() && raw[at + 1] >= 128 && raw[at + 1] <= 191 && raw[at + 2] >= 128 && raw[at + 2] <= 191 -> return 3\n    if b >= 240 && b <= 244 && at + 3 < raw.len() && raw[at + 1] >= 128 && raw[at + 1] <= 191 && raw[at + 2] >= 128 && raw[at + 2] <= 191 && raw[at + 3] >= 128 && raw[at + 3] <= 191 -> return 4\n    1\n}}\n\nfn slice_b(raw: [U8], start: Int, end: Int) -> [U8] {{\n    out := [U8]{{}}\n    i := start\n    loop {{\n        if i >= end || i < 0 || i >= raw.len() -> return ~out\n        &out.push(raw[i])\n        i = i + 1\n    }}\n}}\n"}
