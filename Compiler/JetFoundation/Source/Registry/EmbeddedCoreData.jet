fn foundation_embedded_core_source_84() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.text.wrap", alias: "core_text_wrap", path: "Core/text/wrap.jet", owner: "", owned_members: [String]{"dedent", "expand_tabs", "fill", "fill_with", "hanging_indent", "html_escape", "html_unescape", "indent", "indent_with", "shorten", "wrap", "wrap_paragraphs", "wrap_with", "wrapper"}, source: "package {{\n    name: \"core.text.wrap\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"core.text.wrap core library.\"\n    license: \"MIT\"\n    outputs: {{\n        wrap: .Library{{ entry: wrap }}\n    }}\n}}\nuse core.text as unicode\n// core.text.wrap — paragraph filling, indent, and HTML escaping.\n//\n// Python `textwrap` plus display-column-safe width, indentation, and escaping.\n// Width is measured in terminal display columns using `core.text`.\npub fn wrap(text: String, width: Int) -> [String] Never! {{\n    spec :: wrapper(width)\n    wrap_with(text, spec)\n}}\n\npub fn fill(text: String, width: Int) -> String Never! {{\n    lines :: wrap(text, width)\n    s := \"\"\n    i := 0\n    loop i < lines.len() {{\n        if i == 0 -> s = lines[0] else -> s = \"{{s}}\\n{{lines[i]}}\"\n        i = i + 1\n    }}\n    s\n}}\n\npub fn shorten(text: String, width: Int, placeholder: String) -> String Never! {{\n    if width <= 0 -> return \"\"\n    if unicode.display_width(text) <= width -> return ~text\n    shorten_text(text, width, placeholder, false)\n}}\n\npub fn indent(text: String, prefix: String) -> String Never! {{\n    lines :: split_lines(text)\n    s := \"\"\n    i := 0\n    loop i < lines.len() {{\n        piece :: \"{{prefix}}{{lines[i]}}\"\n        if i == 0 -> s = piece else -> s = \"{{s}}\\n{{piece}}\"\n        i = i + 1\n    }}\n    s\n}}\n\npub fn dedent(text: String) -> String Never! {{\n    lines :: split_lines(text)\n    margin := -1\n    loop line in lines {{\n        if is_blank(line) -> next\n        m :: leading_spaces(line)\n        if margin < 0 || m < margin -> margin = m\n    }}\n    if margin <= 0 -> return ~text\n    s := \"\"\n    i := 0\n    loop i < lines.len() {{\n        line := lines[i]\n        if !is_blank(line) && line.bytes().len() >= margin {{\n            line = slice_b(line.bytes(), margin, line.bytes().len())\n        }}\n        if i == 0 -> s = line else -> s = \"{{s}}\\n{{line}}\"\n        i = i + 1\n    }}\n    s\n}}\n\npub fn expand_tabs(text: String, tabsize: Int) -> String Never! {{\n    size := tabsize\n    if size <= 0 -> size = 8\n    out := \"\"\n    col := 0\n    cr :: String.from_bytes([U8]{{13}}) ?? \"\"\n    crlf :: \"{{cr}}\\n\"\n    loop cluster in unicode.graphemes(text) {{\n        if cluster == \"\\t\" {{\n            n := size - (col % size)\n            i := 0\n            loop i < n {{\n                out = \"{{out}} \"\n                i = i + 1\n            }}\n            col = col + n\n        }} else {{\n            out = \"{{out}}{{cluster}}\"\n            if cluster == \"\\n\" || cluster == cr || cluster == crlf {{\n                col = 0\n            }} else {{\n                col = col + unicode.display_width(cluster)\n            }}\n        }}\n    }}\n    out\n}}\n\npub fn html_escape(text: String, quote: Bool) -> String Never! {{\n    out := \"\"\n    loop scalar in unicode.scalars(text) {{\n        if scalar == \"&\" -> out = \"{{out}}&amp;\"\n        else if scalar == \"<\" -> out = \"{{out}}&lt;\"\n        else if scalar == \">\" -> out = \"{{out}}&gt;\"\n        else if quote && scalar == \"\\\"\" -> out = \"{{out}}&quot;\"\n        else if quote && scalar == \"'\" -> out = \"{{out}}&#x27;\"\n        else -> out = \"{{out}}{{scalar}}\"\n    }}\n    out\n}}\n\npub fn html_unescape(text: String) -> String Never! {{\n    s := replace_all(text, \"&amp;\", \"&\")\n    s = replace_all(s, \"&lt;\", \"<\")\n    s = replace_all(s, \"&gt;\", \">\")\n    s = replace_all(s, \"&quot;\", \"\\\"\")\n    s = replace_all(s, \"&#x27;\", \"'\")\n    s = replace_all(s, \"&apos;\", \"'\")\n    s\n}}\n\nfn split_ws(text: String) -> [String] Never! {{\n    out := [String]{{}}\n    current := \"\"\n    loop scalar in unicode.scalars(text) {{\n        if unicode.is_whitespace(scalar) {{\n            if current.bytes().len() > 0 {{\n                &out.push(current)\n                current = \"\"\n            }}\n        }} else {{\n            current = \"{{current}}{{scalar}}\"\n        }}\n    }}\n    if current.bytes().len() > 0 -> &out.push(current)\n    out\n}}\n\nfn split_ws_preserving(text: String) -> [String] Never! {{\n    out := [String]{{}}\n    current := \"\"\n    current_whitespace := false\n    has_current := false\n    loop scalar in unicode.scalars(text) {{\n        whitespace := unicode.is_whitespace(scalar)\n        if has_current && whitespace != current_whitespace {{\n            &out.push(current)\n            current = \"\"\n            has_current = false\n        }}\n        current = \"{{current}}{{scalar}}\"\n        current_whitespace = whitespace\n        has_current = true\n    }}\n    if has_current -> &out.push(current)\n    out\n}}\n\nfn split_lines(text: String) -> [String] {{\n    raw :: text.bytes()\n    out := [String]{{}}\n    start := 0\n    i := 0\n    loop i < raw.len() {{\n        if raw[i] == (U8{{10}}) {{\n            end := i\n            if end > start && raw[end - 1] == (U8{{13}}) -> end = end - 1\n            &out.push(slice_b(raw, start, end))\n            start = i + 1\n        }}\n        i = i + 1\n    }}\n    &out.push(slice_b(raw, start, raw.len()))\n    out\n}}\n\nfn is_blank(text: String) -> Bool {{\n    loop b in text.bytes() {{\n        n :: b\n        if n != 32 && n != 9 -> return false\n    }}\n    true\n}}\n\nfn leading_spaces(text: String) -> Int {{\n    n := 0\n    loop b in text.bytes() {{\n        if b == (U8{{32}}) || b == (U8{{9}}) -> n = n + 1 else -> return n\n    }}\n    n\n}}\n\nfn slice_b(raw: [U8], start: Int, end: Int) -> String {{\n    out := [U8]{{}}\n    i := start\n    loop {{\n        if i >= end || i < 0 || i >= raw.len() -> return String.from_bytes(out) ?? \"\"\n        &out.push(raw[i])\n        i = i + 1\n    }}\n}}\n\nfn replace_all(text: String, old: String, new: String) -> String {{\n    if old.bytes().len() == 0 -> return ~text\n    out := \"\"\n    i := 0\n    loop {{\n        rest :: slice_b(text.bytes(), i, text.bytes().len())\n        j :: find_at(rest, old)\n        if j < 0 -> return \"{{out}}{{rest}}\"\n        out = \"{{out}}{{slice_b(rest.bytes(), 0, j)}}{{new}}\"\n        i = i + j + old.bytes().len()\n    }}\n}}\n\nfn find_at(text: String, needle: String) -> Int {{\n    raw :: text.bytes()\n    nd :: needle.bytes()\n    if nd.len() == 0 -> return 0\n    if nd.len() > raw.len() -> return -1\n    loop i in 0..<(raw.len() - nd.len() + 1) {{\n        ok := true\n        loop j in 0..<nd.len() {{\n            if raw[i + j] != nd[j] -> ok = false\n        }}\n        if ok -> return i\n    }}\n    -1\n}}\n\npub struct Wrapper {{\n    pub width: Int\n    pub initial_indent: String\n    pub subsequent_indent: String\n    pub expand_tabs: Bool\n    pub drop_whitespace: Bool\n    pub break_long_words: Bool\n    pub break_on_hyphens: Bool\n    pub max_lines: Int\n    pub placeholder: String\n    pub tabsize: Int\n}}\n\npub fn wrapper(width: Int) -> Wrapper Never! {{\n    {{\n        width: width,\n        initial_indent: \"\",\n        subsequent_indent: \"\",\n        expand_tabs: true,\n        drop_whitespace: true,\n        break_long_words: true,\n        break_on_hyphens: true,\n        max_lines: 0,\n        placeholder: \" [...]\",\n        tabsize: 8,\n    }}\n}}\n\npub fn wrap_with(text: String, spec: Wrapper) -> [String] Never! {{\n    if spec.width <= 0 -> return [String]{{text}}\n    body := text\n    if spec.expand_tabs -> body = expand_tabs(body, spec.tabsize)\n    words := split_ws(body)\n    if !spec.drop_whitespace -> words = split_ws_preserving(body)\n    out := [String]{{}}\n    line_indent := spec.initial_indent\n    indent_width := unicode.display_width(line_indent)\n    line := ~line_indent\n    line_has_text := false\n    loop piece in words {{\n        if spec.drop_whitespace && is_blank(piece) -> next\n        if line_has_text {{\n            separator := \" \"\n            if !spec.drop_whitespace -> separator = \"\"\n            trial :: \"{{line}}{{separator}}{{piece}}\"\n            if unicode.display_width(trial) <= spec.width {{\n                line = trial\n                next\n            }}\n            &out.push(line)\n            line_indent = spec.subsequent_indent\n            indent_width = unicode.display_width(line_indent)\n            line = ~line_indent\n            line_has_text = false\n        }}\n        capacity := spec.width - indent_width\n        if capacity <= 0 -> capacity = 1\n        piece_width := unicode.display_width(piece)\n        if piece_width <= capacity || !spec.break_long_words {{\n            line = \"{{line_indent}}{{piece}}\"\n            line_has_text = true\n        }} else {{\n            remaining := piece\n            loop remaining.bytes().len() > 0 {{\n                chunks :: break_word(remaining, capacity, spec.break_on_hyphens)\n                if chunks.len() == 0 {{\n                    line = \"{{line_indent}}{{remaining}}\"\n                    line_has_text = true\n                    remaining = \"\"\n                }} else if chunks.len() == 1 {{\n                    line = \"{{line_indent}}{{chunks[0]}}\"\n                    line_has_text = true\n                    remaining = \"\"\n                }} else {{\n                    &out.push(\"{{line_indent}}{{chunks[0]}}\")\n                    remaining = join_chunks(chunks, 1)\n                    line_indent = spec.subsequent_indent\n                    indent_width = unicode.display_width(line_indent)\n                    line = ~line_indent\n                    line_has_text = false\n                    capacity = spec.width - indent_width\n                    if capacity <= 0 -> capacity = 1\n                }}\n            }}\n        }}\n    }}\n    if line_has_text -> &out.push(line)\n    if spec.max_lines > 0 && out.len() > spec.max_lines {{\n        keep := [String]{{}}\n        i := 0\n        loop i < spec.max_lines {{\n            if i + 1 == spec.max_lines {{\n                last_indent := spec.initial_indent\n                if i > 0 -> last_indent = spec.subsequent_indent\n                &keep.push(line_with_placeholder(out[i], last_indent, spec.width, spec.placeholder))\n            }} else {{\n                &keep.push(out[i])\n            }}\n            i = i + 1\n        }}\n        return keep\n    }}\n    out\n}}\n\npub fn fill_with(text: String, spec: Wrapper) -> String Never! {{ join_lines(wrap_with(text, spec)) }}\n\npub fn indent_with(text: String, prefix: String, predicate_nonblank: Bool) -> String Never! {{\n    lines :: split_lines(text)\n    s := \"\"\n    i := 0\n    loop i < lines.len() {{\n        line := lines[i]\n        if !predicate_nonblank || !is_blank(line) -> line = \"{{prefix}}{{line}}\"\n        if i == 0 -> s = line else -> s = \"{{s}}\\n{{line}}\"\n        i = i + 1\n    }}\n    s\n}}\n\npub fn wrap_paragraphs(text: String, width: Int) -> String Never! {{\n    paras :: split_paragraphs(text)\n    s := \"\"\n    i := 0\n    loop i < paras.len() {{\n        filled :: fill(paras[i], width)\n        if i == 0 -> s = filled else -> s = \"{{s}}\\n\\n{{filled}}\"\n        i = i + 1\n    }}\n    s\n}}\n\npub fn hanging_indent(text: String, first: String, rest: String, width: Int) -> String Never! {{\n    spec :: Wrapper{{\n        width: width,\n        initial_indent: first,\n        subsequent_indent: rest,\n        expand_tabs: true,\n        drop_whitespace: true,\n        break_long_words: true,\n        break_on_hyphens: true,\n        max_lines: 0,\n        placeholder: \" [...]\",\n        tabsize: 8,\n    }}\n    fill_with(text, spec)\n}}\n\nfn break_word(word: String, width: Int, break_on_hyphens: Bool) -> [String] Never! {{\n    if width <= 0 -> return [String]{{word}}\n    units :: unicode.graphemes(word)\n    out := [String]{{}}\n    if units.len() == 0 -> return out\n    start := 0\n    loop start < units.len() {{\n        i := start\n        current_width := 0\n        last_hyphen := -1\n        overflowed := false\n        loop i < units.len() {{\n            unit :: units[i]\n            unit_width :: unicode.display_width(unit)\n            if i > start && current_width + unit_width > width {{\n                overflowed = true\n                break\n            }}\n            if i == start && current_width + unit_width > width {{\n                i = i + 1\n                overflowed = true\n                break\n            }}\n            current_width = current_width + unit_width\n            if unit == \"-\" -> last_hyphen = i + 1\n            i = i + 1\n        }}\n        if i <= start -> i = start + 1\n        end := i\n        if overflowed && break_on_hyphens && last_hyphen > start && last_hyphen < i {{\n            end = last_hyphen\n        }}\n        if end <= start -> end = start + 1\n        &out.push(join_units(units, start, end))\n        start = end\n    }}\n    out\n}}\n\nfn join_units(units: [String], start: Int, end: Int) -> String {{\n    out := \"\"\n    i := start\n    loop i < end {{\n        out = \"{{out}}{{units[i]}}\"\n        i = i + 1\n    }}\n    out\n}}\n\nfn join_chunks(chunks: [String], start: Int) -> String {{\n    out := \"\"\n    i := start\n    loop i < chunks.len() {{\n        out = \"{{out}}{{chunks[i]}}\"\n        i = i + 1\n    }}\n    out\n}}\n\nfn shorten_text(text: String, width: Int, placeholder: String, force_placeholder: Bool) -> String Never! {{\n    if width <= 0 -> return \"\"\n    placeholder_width := unicode.display_width(placeholder)\n    text_width := unicode.display_width(text)\n    if !force_placeholder && text_width <= width -> return ~text\n    if force_placeholder && text_width + placeholder_width <= width -> return \"{{text}}{{placeholder}}\"\n    if placeholder_width > width -> return take_width(placeholder, width)\n    available := width - placeholder_width\n    prefix := word_prefix(text, available)\n    \"{{prefix}}{{placeholder}}\"\n}}\n\nfn word_prefix(text: String, width: Int) -> String Never! {{\n    if width <= 0 -> return \"\"\n    words :: split_ws(text)\n    if words.len() == 0 -> return \"\"\n    current := \"\"\n    i := 0\n    loop i < words.len() {{\n        candidate := words[i]\n        if current.bytes().len() > 0 -> candidate = \"{{current}} {{words[i]}}\"\n        if unicode.display_width(candidate) <= width {{\n            current = candidate\n        }} else {{\n            if current.bytes().len() == 0 -> return take_width(words[i], width)\n            return ~current\n        }}\n        i = i + 1\n    }}\n    current\n}}\n\nfn take_width(text: String, width: Int) -> String Never! {{\n    if width <= 0 -> return \"\"\n    out := \"\"\n    current_width := 0\n    clusters :: unicode.graphemes(text)\n    i := 0\n    loop i < clusters.len() {{\n        cluster :: clusters[i]\n        cluster_width :: unicode.display_width(cluster)\n        if current_width + cluster_width > width -> return ~out\n        out = \"{{out}}{{cluster}}\"\n        current_width = current_width + cluster_width\n        i = i + 1\n    }}\n    out\n}}\n\nfn line_with_placeholder(line: String, line_indent: String, width: Int, placeholder: String) -> String Never! {{\n    capacity := width - unicode.display_width(line_indent)\n    if capacity <= 0 -> return ~line_indent\n    indent_bytes := line_indent.bytes().len()\n    content := line\n    if line.bytes().len() >= indent_bytes -> content = slice_b(line.bytes(), indent_bytes, line.bytes().len())\n    \"{{line_indent}}{{shorten_text(content, capacity, placeholder, true)}}\"\n}}\n\nfn join_lines(lines: [String]) -> String {{\n    s := \"\"\n    i := 0\n    loop i < lines.len() {{\n        if i == 0 -> s = lines[0] else -> s = \"{{s}}\\n{{lines[i]}}\"\n        i = i + 1\n    }}\n    s\n}}\n\nfn split_paragraphs(text: String) -> [String] {{\n    lines :: split_lines(text)\n    out := [String]{{}}\n    cur := \"\"\n    started := false\n    loop line in lines {{\n        if is_blank(line) {{\n            if started {{\n                &out.push(cur)\n                cur = \"\"\n                started = false\n            }}\n            next\n        }}\n        if started -> cur = \"{{cur}} {{line}}\" else {{\n            cur = line\n            started = true\n        }}\n    }}\n    if started -> &out.push(cur)\n    out\n}}\n"}
}

fn foundation_embedded_core_source_85() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.time", alias: "core_time", path: "Core/time/time.jet", owner: "", owned_members: [String]{"unix_seconds", "unix_ns", "start", "elapsed", "asctime", "ctime", "gmtime", "utcoffset", "weekday", "isoformat_date", "isoformat_time", "isoformat", "strftime", "unix_ms", "add_days", "add_duration", "since", "duration_seconds", "duration_ms", "duration_ns", "duration_as_seconds", "compare_date", "date_equals", "combine", "date_of", "time_of", "replace_date", "replace_time", "isoweekday", "weekday_sun0", "duration_minutes", "duration_hours", "duration_days", "duration_as_ms", "duration_as_minutes", "duration_as_hours", "add_seconds", "add_minutes", "add_hours", "start_of_day", "end_of_day", "date_before", "date_after", "between", "duration_zero", "duration_is_zero", "duration_abs", "duration_add", "duration_sub", "min_date", "max_date", "days_between", "fromhours", "before", "after", "dayofweek", "todate", "totime"}, source: "package {{\n    name: \"core.time\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"Civil calendars, instants, and clocks.\"\n    license: \"MIT\"\n    outputs: {{\n        time: .Library{{ entry: time }}\n    }}\n}}\nuse core as core\n\n\n// core.time — Gregorian civil time over the runtime civil-time carriers.\n//\n// `DateTime`, `LocalDate`, `LocalTime`, `Zone`, `ZonedDateTime`, and `Period`\n// are the Prelude carriers; the runtime owns their construction, parsing,\n// zone resolution, and calendar arithmetic, so `datetime`, `new`, `parse`,\n// `zone`, `period`, `now`, and the other constructors are the Prelude rows.\n// This module adds the helpers the runtime has no row for, written over the\n// carrier methods, so every tier reads one implementation.\n//\n// `start` and `unix_ns` sample the host wall clock as Unix nanoseconds;\n// `sleep` waits through the host sleep kernel. `instant` and `sleep_until` are\n// compiler-owned: `Instant` is the monotonic Time point quantity, so\n// `t + 5min` is an Instant and `b - a` is a Duration. Wall-clock Unix\n// nanoseconds come only from `unix_ns()`. Everything else is pure.\n#Error\npub struct TimeError {{\n    pub reason: String\n}}\n\nimpl TimeError {{\n    pub fn new(reason: String) -> TimeError Never! {{ TimeError{{reason: reason}} }}\n}}\n\n/// A running stopwatch started at a Unix-nanosecond wall-clock sample.\npub struct Stopwatch {{\n    pub start_ns: Int\n}}\n\nimpl Stopwatch {{\n    /// Whole milliseconds since `start()`.\n    pub fn elapsed_millis(self) -[Time]> Int Never! {{ duration_as_ms(elapsed(self)) }}\n}}\n\n/// The offset of `zone` from UTC in seconds at the Unix epoch. Numeric and UTC\n/// zones have exactly one offset.\npub fn utcoffset(zone: Zone) -> Int Never! {{\n    core.time.zoned(core.time.from_unix_seconds(0), zone).offset_seconds()\n}}\n\npub fn gmtime(seconds: Int) -> DateTime Never! {{ core.time.from_unix_seconds(seconds) }}\n\npub fn ctime(seconds: Int) -> String Never! {{ asctime(gmtime(seconds)) }}\n\npub fn asctime(dt: DateTime) -> String Never! {{\n    days :: [\"Sun\", \"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\"]\n    months :: [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"]\n    date :: dt.date()\n    \"{{days[date.weekday()]}} {{months[date.month() - 1]}} {{pad2(date.day(), 2)}} {{pad2(dt.hour(), 2)}}:{{pad2(dt.minute(), 2)}}:{{pad2(dt.second(), 2)}} {{date.year()}}\"\n}}\n\npub fn start() -[Time]> Stopwatch Never! {{ Stopwatch{{start_ns: unix_ns()}} }}\n\npub fn sleep(duration: Duration) Never! -[Time]> {{\n    if duration.ns > 0 -> host_sleep_ns(duration.ns)\n}}\n\n/// Wall-clock time as Unix nanoseconds. `time.instant()` is the monotonic\n/// point for measuring; this is the timestamp for stamps, nonces, and expiry.\npub fn unix_ns() -[Time]> Int Never! {{\n    core.time.now_utc().to_unix_ns() ?? panic(\"the wall clock is outside the Unix nanosecond range\")\n}}\n\n// Host kernel: the Duration sleep.\nfn host_sleep_ns(ns: Int) -[Time]> {{ core.time.sleep(duration_ns(ns)) }}\n\nfn time_int_min() -> Int Never! {{ -9223372036854775808 }}\nfn time_int_max() -> Int Never! {{ 9223372036854775807 }}\n\nfn saturating_add_ns(a: Int, b: Int) -> Int Never! {{\n    if b > 0 && a > time_int_max() - b -> return time_int_max()\n    if b < 0 && a < time_int_min() - b -> return time_int_min()\n    a + b\n}}\n\nfn saturating_sub_ns(a: Int, b: Int) -> Int {{\n    if b > 0 && a < time_int_min() + b -> return time_int_min()\n    if b < 0 && a > time_int_max() + b -> return time_int_max()\n    a - b\n}}\n\nfn saturating_scale_ns(value: Int, scale: Int) -> Int Never! {{\n    if value == 0 -> return 0\n    if value > 0 && value > time_int_max() /% scale -> return time_int_max()\n    if value < 0 && value < time_int_min() /% scale -> return time_int_min()\n    value * scale\n}}\n\n/// Weekday index with Sunday as 0.\npub fn weekday(date: LocalDate) -> Int Never! {{ date.weekday() }}\n\npub fn isoformat_date(date: LocalDate) -> String Never! {{ \"{{pad2(date.year(), 4)}}-{{pad2(date.month(), 2)}}-{{pad2(date.day(), 2)}}\" }}\n\npub fn isoformat_time(t: LocalTime) -> String Never! {{\n    base :: \"{{pad2(t.hour(), 2)}}:{{pad2(t.minute(), 2)}}:{{pad2(t.second(), 2)}}\"\n    if t.nanosecond() == 0 -> return base\n    \"{{base}}.{{pad2(t.nanosecond(), 9)}}\"\n}}\n\npub fn isoformat(dt: DateTime) -> String Never! {{ \"{{isoformat_date(dt.date())}}T{{isoformat_time(dt.time())}}\" }}\n\npub fn strftime(format: String, dt: DateTime) -> String Never! {{\n    days :: [\"Sun\", \"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\"]\n    days_long :: [\"Sunday\", \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\"]\n    months_short :: [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"]\n    months_long :: [\"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"]\n    date :: dt.date()\n    day :: date.weekday()\n    day_of_year :: date.day_of_year()\n    jan1_sun0 :: core.time.new(date.year(), 1, 1).weekday()\n    jan1_mon0 :: (jan1_sun0 + 6) %% 7\n    raw :: format.bytes()\n    out := \"\"\n    i := 0\n    loop i < raw.len() {{\n        if raw[i] != (U8{{37}}) {{\n            out = \"{{out}}{{String.from_bytes([U8]{{raw[i]}}) ?? \"\"}}\"\n            i = i + 1\n            next\n        }}\n        if i + 1 >= raw.len() {{\n            out = \"{{out}}%\"\n            break\n        }}\n        code :: raw[i + 1]\n        piece :: if code == {{\n            37 -> \"%\"\n            65 -> days_long[day]\n            97 -> days[day]\n            98 -> months_short[date.month() - 1]\n            66 -> months_long[date.month() - 1]\n            99 -> asctime(dt)\n            100 -> pad2(date.day(), 2)\n            102 -> pad2(dt.microsecond(), 6)\n            72 -> pad2(dt.hour(), 2)\n            73 -> pad2(((dt.hour() + 11) %% 12) + 1, 2)\n            106 -> pad2(day_of_year, 3)\n            109 -> pad2(date.month(), 2)\n            77 -> pad2(dt.minute(), 2)\n            85 -> pad2((day_of_year - 1 + jan1_sun0) /% 7, 2)\n            87 -> pad2((day_of_year - 1 + jan1_mon0) /% 7, 2)\n            119 -> \"{{day}}\"\n            121 -> pad2(date.year() %% 100, 2)\n            89 -> \"{{date.year()}}\"\n            90 -> \"UTC\"\n            else -> \"%{{String.from_bytes([U8]{{code}}) ?? \"\"}}\"\n        }}\n        out = \"{{out}}{{piece}}\"\n        i = i + 2\n    }}\n    out\n}}\n\n\npub fn unix_seconds(dt: DateTime) -> Int Never! {{ dt.to_timestamp() }}\n\npub fn unix_ms(dt: DateTime) -> Int Never! {{ dt.to_unix_ms() }}\n\npub fn add_days(date: LocalDate, days: Int) -> LocalDate Never! {{ date.add_days(days) }}\n\npub fn add_duration(dt: DateTime, duration: Duration) -> DateTime Never! {{ dt.plus_duration(duration) }}\n\npub fn since(later: DateTime, earlier: DateTime) -> Duration Never! {{ later.difference(earlier) }}\n\npub fn duration_seconds(seconds: Int) -> Duration Never! {{ duration_ns(saturating_scale_ns(seconds, 1000000000)) }}\n\npub fn duration_ms(ms: Int) -> Duration Never! {{ duration_ns(saturating_scale_ns(ms, 1000000)) }}\n\n/// `Duration` is the compiler-owned nanosecond quantity, so it is built\n/// through its checked constructor; every Int is a valid nanosecond count.\npub fn duration_ns(ns: Int) -> Duration Never! {{ Duration.nanoseconds(ns) ?? panic(\"every Int is a nanosecond Duration\") }}\n\npub fn duration_as_seconds(d: Duration) -> Int Never! {{ d.ns /% 1000000000 }}\n\npub fn elapsed(watch: Stopwatch) -[Time]> Duration Never! {{\n    duration_ns(saturating_sub_ns(unix_ns(), watch.start_ns))\n}}\n\npub fn compare_date(a: LocalDate, b: LocalDate) -> Int Never! {{\n    days :: a.diff_days(b)\n    if days < 0 -> return -1\n    if days > 0 -> return 1\n    0\n}}\n\npub fn date_equals(a: LocalDate, b: LocalDate) -> Bool Never! {{ a == b }}\n\nfn pad2(n: Int, width: Int) -> String {{\n    s := \"{{n}}\"\n    loop s.bytes().len() < width -> s = \"0{{s}}\"\n    s\n}}\n\npub fn combine(date: LocalDate, t: LocalTime) -> DateTime Never! {{\n    core.time.datetime(date.year(), date.month(), date.day(), t.hour(), t.minute(), t.second()).add_nanoseconds(t.nanosecond())\n}}\n\npub fn date_of(dt: DateTime) -> LocalDate Never! {{ dt.date() }}\n\npub fn time_of(dt: DateTime) -> LocalTime Never! {{ dt.time() }}\n\npub fn replace_date(dt: DateTime, date: LocalDate) -> DateTime Never! {{ combine(date, dt.time()) }}\n\npub fn replace_time(dt: DateTime, t: LocalTime) -> DateTime Never! {{ combine(dt.date(), t) }}\n\npub fn isoweekday(date: LocalDate) -> Int Never! {{ date.iso_weekday() }}\n\npub fn weekday_sun0(date: LocalDate) -> Int Never! {{ date.weekday() }}\n\npub fn duration_minutes(minutes: Int) -> Duration Never! {{ duration_ns(saturating_scale_ns(minutes, 60000000000)) }}\n\npub fn duration_hours(hours: Int) -> Duration Never! {{ duration_ns(saturating_scale_ns(hours, 3600000000000)) }}\n\npub fn duration_days(days: Int) -> Duration Never! {{ duration_ns(saturating_scale_ns(days, 86400000000000)) }}\n\npub fn duration_as_ms(d: Duration) -> Int Never! {{ d.ns /% 1000000 }}\n\npub fn duration_as_minutes(d: Duration) -> Int Never! {{ d.ns /% 60000000000 }}\n\npub fn duration_as_hours(d: Duration) -> Int Never! {{ d.ns /% 3600000000000 }}\n\npub fn add_seconds(dt: DateTime, seconds: Int) -> DateTime Never! {{ add_duration(dt, duration_seconds(seconds)) }}\n\npub fn add_minutes(dt: DateTime, minutes: Int) -> DateTime Never! {{ add_duration(dt, duration_minutes(minutes)) }}\n\npub fn add_hours(dt: DateTime, hours: Int) -> DateTime Never! {{ add_duration(dt, duration_hours(hours)) }}\n\npub fn start_of_day(date: LocalDate) -> DateTime Never! {{ core.time.datetime(date.year(), date.month(), date.day(), 0, 0, 0) }}\n\npub fn end_of_day(date: LocalDate) -> DateTime Never! {{\n    core.time.datetime(date.year(), date.month(), date.day(), 23, 59, 59).add_nanoseconds(999999999)\n}}\n\npub fn date_before(a: LocalDate, b: LocalDate) -> Bool Never! {{ a < b }}\n\npub fn date_after(a: LocalDate, b: LocalDate) -> Bool Never! {{ a > b }}\n\npub fn between(dt: DateTime, start: DateTime, end: DateTime) -> Bool Never! {{ dt >= start && dt <= end }}\n\npub fn duration_zero() -> Duration Never! {{ duration_ns(0) }}\n\npub fn duration_is_zero(d: Duration) -> Bool Never! {{ d.ns == 0 }}\n\npub fn duration_abs(d: Duration) -> Duration Never! {{\n    if d.ns == time_int_min() -> return duration_ns(time_int_max())\n    if d.ns < 0 -> return duration_ns(0 - d.ns)\n    ~d\n}}\n\npub fn duration_add(a: Duration, b: Duration) -> Duration Never! {{\n    duration_ns(saturating_add_ns(a.ns, b.ns))\n}}\n\npub fn duration_sub(a: Duration, b: Duration) -> Duration Never! {{\n    duration_ns(saturating_sub_ns(a.ns, b.ns))\n}}\n\npub fn min_date(a: LocalDate, b: LocalDate) -> LocalDate Never! {{\n    if a <= b -> return ~a\n    ~b\n}}\n\npub fn max_date(a: LocalDate, b: LocalDate) -> LocalDate Never! {{\n    if a >= b -> return ~a\n    ~b\n}}\n\npub fn days_between(a: LocalDate, b: LocalDate) -> Int Never! {{ b.diff_days(a) }}\n// Compatibility spellings shared by Python-style date/time surfaces.\npub fn fromhours(hours: Int) -> Duration Never! {{ duration_hours(hours) }}\n\npub fn before(a: LocalDate, b: LocalDate) -> Bool Never! {{ date_before(a, b) }}\n\npub fn after(a: LocalDate, b: LocalDate) -> Bool Never! {{ date_after(a, b) }}\n\npub fn dayofweek(date: LocalDate) -> Int Never! {{ weekday(date) }}\n\npub fn todate(dt: DateTime) -> LocalDate Never! {{ date_of(dt) }}\n\npub fn totime(dt: DateTime) -> LocalTime Never! {{ time_of(dt) }}\n"}
}

fn foundation_embedded_core_source_86() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.time.calendar", alias: "core_core_time_calendar", path: "Core/time/calendar.jet", owner: "", owned_members: [String]{"day_abbr", "day_name", "formatmonth", "formatyear", "isleap", "leapdays", "month_abbr", "month_name", "monthcalendar", "monthcalendar_start", "monthrange", "timegm", "weekday", "weekheader", "yearcalendar"}, source: "use core.time as time\n// core.time.calendar — Python `calendar` without locale tables.\n//\n// Weeks start on Monday (`MONDAY = 0`) unless a function takes `firstweekday`.\n// Day `0` in a month matrix is a slot outside the month. Names are English\n// and fixed; there is no locale override.\nMONDAY :: 0\n\nTUESDAY :: 1\n\nWEDNESDAY :: 2\n\nTHURSDAY :: 3\n\nFRIDAY :: 4\n\nSATURDAY :: 5\n\nSUNDAY :: 6\nfn floor_div(a: Int, b: Int) -> Int {{\n    q := a /% b\n    r :: a %% b\n    if r != 0 && ((r < 0) != (b < 0)) -> q = q - 1\n    q\n}}\n\n\npub fn isleap(year: Int) -> Bool Never! {{ time.is_leap_year(year) }}\n\npub fn leapdays(y1: Int, y2: Int) -> Int Never! {{\n    a := y1\n    b := y2\n    if b < a {{\n        t := a\n        a = b\n        b = t\n    }}\n    by4 :: leap_multiple_count(a, b, 4)\n    by100 :: leap_multiple_count(a, b, 100)\n    by400 :: leap_multiple_count(a, b, 400)\n    by4 - by100 + by400\n}}\n\nfn leap_multiple_count(start: Int, end: Int, divisor: Int) -> Int {{\n    floor_before(end, divisor) - floor_before(start, divisor)\n}}\n\nfn floor_before(value: Int, divisor: Int) -> Int {{\n    // `value - 1` is not representable at Int's lower bound.  floor_div\n    // already accounts for the negative remainder; only an exact multiple\n    // needs one additional step for the exclusive upper bound.\n    if value == -9223372036854775808 {{\n        q :: floor_div(value, divisor)\n        if value %% divisor == 0 -> return q - 1\n        return q\n    }}\n    floor_div(value - 1, divisor)\n}}\npub fn weekday(year: Int, month: Int, day: Int) -> Int Never! {{\n    // Sakamoto: 0 = Sunday. Convert to Monday = 0.\n    y := year\n    m := month\n    if m < 1 -> m = 1\n    if m > 12 -> m = 12\n    t := [Int]{{0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4}}\n    if m < 3 -> y = y - 1\n    sun0 := (y + floor_div(y, 4) - floor_div(y, 100) + floor_div(y, 400) + t[m - 1] + day) %% 7\n    if sun0 < 0 -> sun0 = sun0 + 7\n    (sun0 + 6) %% 7\n\n}}\npub fn monthrange(year: Int, month: Int) -> (days: Int, weekday: Int) Never! {{\n    days :: time.days_in_month(year, month)\n    if days == 0 -> return (days: 0, weekday: 0)\n    (days: days, weekday: weekday(year, month, 1))\n}}\n\npub fn monthcalendar(year: Int, month: Int) -> [[Int]] Never! {{ monthcalendar_start(year, month, 0) }}\npub fn monthcalendar_start(year: Int, month: Int, firstweekday: Int) -> [[Int]] Never! {{\n    range :: monthrange(year, month)\n    if range.days == 0 -> return [[Int]]{{}}\n    first := firstweekday %% 7\n    if first < 0 -> first = first + 7\n    start := (range.weekday - first) %% 7\n    if start < 0 -> start = start + 7\n    weeks := [[Int]]{{}}\n    week := [Int]{{}}\n    loop _ in 0..<start -> &week.push(0)\n    d := 1\n    loop d <= range.days {{\n        &week.push(d)\n        if week.len() == 7 {{\n            &weeks.push(week)\n            week = [Int]{{}}\n        }}\n        d = d + 1\n    }}\n    if week.len() > 0 {{\n        loop week.len() < 7 -> &week.push(0)\n        &weeks.push(week)\n    }}\n    weeks\n}}\n\n\npub fn yearcalendar(year: Int) -> [[[Int]]] Never! {{\n    months := [[[Int]]]{{}}\n    m := 1\n    loop m <= 12 {{\n        &months.push(monthcalendar(year, m))\n        m = m + 1\n    }}\n    months\n}}\n\npub fn day_name(weekday: Int) -> String Never! {{\n    i := weekday\n    if i < 0 -> i = 0\n    if i > 6 -> i = 6\n    if i == {{\n        0 -> \"Monday\"\n        1 -> \"Tuesday\"\n        2 -> \"Wednesday\"\n        3 -> \"Thursday\"\n        4 -> \"Friday\"\n        5 -> \"Saturday\"\n        else -> \"Sunday\"\n    }}\n}}\n\npub fn day_abbr(weekday: Int) -> String Never! {{\n    i := weekday\n    if i < 0 -> i = 0\n    if i > 6 -> i = 6\n    if i == {{\n        0 -> \"Mon\"\n        1 -> \"Tue\"\n        2 -> \"Wed\"\n        3 -> \"Thu\"\n        4 -> \"Fri\"\n        5 -> \"Sat\"\n        else -> \"Sun\"\n    }}\n}}\n\npub fn month_name(month: Int) -> String Never! {{\n    i := month\n    if i < 1 -> i = 1\n    if i > 12 -> i = 12\n    if i == {{\n        1 -> \"January\"\n        2 -> \"February\"\n        3 -> \"March\"\n        4 -> \"April\"\n        5 -> \"May\"\n        6 -> \"June\"\n        7 -> \"July\"\n        8 -> \"August\"\n        9 -> \"September\"\n        10 -> \"October\"\n        11 -> \"November\"\n        else -> \"December\"\n    }}\n}}\n\npub fn month_abbr(month: Int) -> String Never! {{\n    i := month\n    if i < 1 -> i = 1\n    if i > 12 -> i = 12\n    if i == {{\n        1 -> \"Jan\"\n        2 -> \"Feb\"\n        3 -> \"Mar\"\n        4 -> \"Apr\"\n        5 -> \"May\"\n        6 -> \"Jun\"\n        7 -> \"Jul\"\n        8 -> \"Aug\"\n        9 -> \"Sep\"\n        10 -> \"Oct\"\n        11 -> \"Nov\"\n        else -> \"Dec\"\n    }}\n}}\n\npub fn weekheader(width: Int, firstweekday: Int) -> [String] Never! {{\n    w := width\n    if w < 1 -> w = 1\n    first := firstweekday %% 7\n    if first < 0 -> first = first + 7\n    out := [String]{{}}\n    i := 0\n    loop i < 7 {{\n        name :: day_abbr((i + first) %% 7)\n        &out.push(clip(name, w))\n        i = i + 1\n    }}\n    out\n}}\n\npub fn formatmonth(year: Int, month: Int, width: Int) -> String Never! {{\n    w := width\n    if w < 2 -> w = 2\n    title :: \"{{month_name(month)}} {{year}}\"\n    out := \"{{center(title, w * 7 + 6)}}\\n{{join_row(weekheader(w, 0), w)}}\\n\"\n    loop week in monthcalendar(year, month) {{\n        row := [String]{{}}\n        loop d in week {{\n            if d == 0 -> &row.push(pad(\"\", w)) else -> &row.push(pad(\"{{d}}\", w))\n        }}\n        out = \"{{out}}{{join_row(row, w)}}\\n\"\n    }}\n    out\n}}\n\npub fn formatyear(year: Int) -> String Never! {{\n    out := \"\"\n    m := 1\n    loop m <= 12 {{\n        out = \"{{out}}{{formatmonth(year, m, 3)}}\\n\"\n        m = m + 1\n    }}\n    out\n}}\n\npub fn timegm(year: Int, month: Int, day: Int, hour: Int, minute: Int, second: Int) -> Int Never! {{\n    dt :: time.datetime(year, month, day, hour, minute, second)\n    time.unix_seconds(dt)\n}}\n\n\nfn clip(text: String, width: Int) -> String {{\n    raw :: text.bytes()\n    if raw.len() <= width -> return pad(text, width)\n    out := [U8]{{}}\n    i := 0\n    loop i < width {{\n        &out.push(raw[i])\n        i = i + 1\n    }}\n    String.from_bytes(out) ?? ~text\n}}\n\nfn pad(text: String, width: Int) -> String {{\n    raw :: text.bytes()\n    if raw.len() >= width -> return ~text\n    out := text\n    n := width - raw.len()\n    loop n > 0 {{\n        out = \" {{out}}\"\n        n = n - 1\n    }}\n    out\n}}\n\nfn center(text: String, width: Int) -> String {{\n    raw :: text.bytes()\n    if raw.len() >= width -> return ~text\n    left := (width - raw.len()) /% 2\n    right := width - raw.len() - left\n    out := \"\"\n    loop left > 0 {{\n        out = \"{{out}} \"\n        left = left - 1\n    }}\n    out = \"{{out}}{{text}}\"\n    loop right > 0 {{\n        out = \"{{out}} \"\n        right = right - 1\n    }}\n    out\n}}\n\nfn join_row(cells: [String], width: Int) -> String {{\n    _ :: width\n    out := \"\"\n    i := 0\n    loop i < cells.len() {{\n        if i > 0 -> out = \"{{out}} \"\n        out = \"{{out}}{{cells[i]}}\"\n        i = i + 1\n    }}\n    out\n}}\n\n"}
}

fn foundation_embedded_core_source_87() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.time.expiring", alias: "core_time_expiring", path: "Core/time/expiring.jet", owner: "", owned_members: [String]{"expired", "remaining_ms"}, source: "// core.time.expiring — pure deadline comparison for clock-bound values.\n//\n// The caller owns the absolute millisecond deadline.  A TTL is applied before\n// calling these helpers (`deadline_ms = start_ms + ttl_ms`); this module does\n// not own a clock or mutate the value, so refresh is an explicit new deadline.\n//\n// Expiry is an open boundary: the value is valid at its deadline and expires\n// only on a later tick.  A zero TTL is therefore valid at its starting tick;\n// a negative TTL is already expired there.  The same rule makes every\n// non-positive remaining interval return zero.\n/// True only when `now_ms` is strictly after `expires_at_ms`.\npub fn expired(expires_at_ms: Int, now_ms: Int) -> Bool Never! {{ now_ms > expires_at_ms }}\n\n/// Remaining milliseconds, clamped at zero and saturated at `Int`'s maximum.\npub fn remaining_ms(expires_at_ms: Int, now_ms: Int) -> Int Never! {{\n    if now_ms >= expires_at_ms -> return 0\n    // When `now_ms` is negative, subtraction can exceed the positive Int\n    // range even though the interval is valid.  Saturate instead of wrapping.\n    if now_ms < 0 && expires_at_ms > 9223372036854775807 + now_ms {{\n        return 9223372036854775807\n    }}\n    expires_at_ms - now_ms\n}}\n"}
}

fn foundation_embedded_core_source_88() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.ui", alias: "core_core_ui", path: "Core/ui/ui.jet", owner: "", owned_members: [String]{"aria_role_button", "aria_role_container", "aria_role_label", "aria_role_text_input", "box", "constraint", "desktop", "gtk_backend", "key_event", "node", "node_accessibility", "node_color", "node_role", "node_shortcut", "null_backend", "phone", "point", "rect", "resize_event", "size", "tablet", "text", "tui_backend"}, source: "package {{\n    name: \"core.ui\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"Immediate-mode UI nodes, previews, and host dialogs.\"\n    license: \"MIT\"\n    outputs: {{\n        ui: .Library{{ entry: ui }}\n    }}\n}}\nuse core as core\n\n// core.ui — one portable tree consumed by every backend.\n//\n// Geometry and node values are deliberately backend-neutral.  Opening a\n// window, painting, and event delivery remain provider operations; these\n// constructors only build values that can be measured and rendered.\nmodule host\n\npub enum UIPreviewDevice {{\n    Phone\n    Tablet\n    Desktop\n}}\n\npub enum UIPreviewKind {{\n    Preview\n    Playground\n}}\n\npub enum UIIMEMode {{\n    Native\n    Disabled\n}}\n\npub enum UIAriaRole {{\n    Button\n    Container\n    Label\n    TextInput\n}}\n\npub enum UINodeKind {{\n    Custom\n    Text\n    Box\n    Button\n    TextInput\n}}\n\npub struct Point {{\n    pub x: Float\n    pub y: Float\n}}\n\npub struct Size {{\n    pub width: Float\n    pub height: Float\n}}\n\npub struct Rect {{\n    pub x: Float\n    pub y: Float\n    pub width: Float\n    pub height: Float\n}}\n\n\npub enum InputEvent {{\n    Key(code: String)\n    Resize(size: Size)\n}}\n\n\n\n\npub fn point(x: Float, y: Float) -> Point Never! {{ core.ui.point(x, y) }}\npub fn size(width: Float, height: Float) -> Size Never! {{\n    core.ui.size(width, height)\n}}\npub fn rect(x: Float, y: Float, width: Float, height: Float) -> Rect Never! {{\n    core.ui.rect(x, y, width, height)\n}}\npub fn constraint(min_width: Float, min_height: Float, max_width: Float, max_height: Float) -> SizeConstraint Never! {{\n    core.ui.constraint(min_width, min_height, max_width, max_height)\n}}\n\npub fn node(label: String, width: Float, height: Float) -> UINode Never! {{\n    core.ui.node(label, width, height)\n}}\n\npub fn box(children: [UINode]) -> UINode Never! {{\n    core.ui.box(children)\n}}\n\npub fn text(value: String) -> UINode Never! {{\n    core.ui.text(value)\n}}\n\npub fn desktop() -> UIPreviewViewport Never! {{ core.ui.desktop() }}\npub fn phone() -> UIPreviewViewport Never! {{ core.ui.phone() }}\npub fn tablet() -> UIPreviewViewport Never! {{ core.ui.tablet() }}\n\npub fn key_event(code: String) -> InputEvent Never! {{ core.ui.key_event(code) }}\npub fn resize_event(width: Float, height: Float) -> InputEvent Never! {{\n    core.ui.resize_event(width, height)\n}}\n\n\npub fn gtk_backend() -> GtkBackend Never! {{ core.ui.gtk_backend() }}\npub fn tui_backend() -> TUIBackend Never! {{ core.ui.tui_backend() }}\npub fn null_backend() -> NullBackend Never! {{ core.ui.null_backend() }}\n\npub fn aria_role_button() -> UIAriaRole Never! {{ core.ui.aria_role_button() }}\npub fn aria_role_container() -> UIAriaRole Never! {{ core.ui.aria_role_container() }}\npub fn aria_role_label() -> UIAriaRole Never! {{ core.ui.aria_role_label() }}\npub fn aria_role_text_input() -> UIAriaRole Never! {{ core.ui.aria_role_text_input() }}\n\npub fn node_accessibility(n: UINode, metadata: UIAccessibility) -> UINode Never! {{\n    core.ui.node_accessibility(n, metadata)\n}}\n\npub fn node_color(label: String, width: Float, height: Float, color: String) -> UINode Never! {{\n    core.ui.node_color(label, width, height, color)\n}}\n\npub fn node_role(label: String, width: Float, height: Float, role: UIAriaRole) -> UINode Never! {{\n    core.ui.node_role(label, width, height, role)\n}}\n\npub fn node_shortcut(n: UINode, shortcut: UIShortcut) -> UINode Never! {{\n    core.ui.node_shortcut(n, shortcut)\n}}\n\n"}
}

fn foundation_embedded_core_source_89() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.tui", alias: "core_core_tui", path: "Core/tui/tui.jet", owner: "", owned_members: [String]{"ascii", "capabilities", "close_event", "color_ansi16", "color_ansi256", "color_rgb", "display_width", "fill", "focus_event", "horizontal", "interrupt_event", "io_event", "key_event", "key_event_modifiers", "layout", "length", "list", "list_state", "list_state_offset", "list_state_select", "list_state_selected", "max", "min", "percent", "resize_event", "style", "style_background", "style_bold", "style_dim", "style_foreground", "style_text", "style_underline", "table", "timer_event", "vertical"}, source: "package {{\n    name: \"core.tui\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"Terminal UI layout, color, and events.\"\n    license: \"MIT\"\n    outputs: {{\n        tui: .Library{{ entry: tui }}\n    }}\n}}\nuse core as core\nuse core.ui as ui\nuse core.ui.[Rect, UINode]\n\n// core.tui — the portable terminal presentation layer.\n//\n// Models and layout are pure.  Terminal dimensions are the sole provider\n// seam; drawing remains owned by the selected UI backend.\n\npub enum TUIEvent {{\n    Key(code: String, modifiers: Int)\n    Resize(size: ui.Size)\n    Timer(id: String, elapsed_ms: Int)\n    IO(channel: String, payload: [U8])\n    Focus(focused: Bool)\n    Interrupt\n    Close\n}}\n\npub enum TUIColorProfile {{\n    ANSI16\n    ANSI256\n    TrueColor\n    ASCII\n}}\n\npub enum TUIColor {{\n    ANSI16(Int)\n    ANSI256(Int)\n    RGB(red: Int, green: Int, blue: Int)\n}}\n\npub enum TUIDirection {{\n    Horizontal\n    Vertical\n}}\n\npub enum TUIConstraint {{\n    Length(Float)\n    Min(Float)\n    Max(Float)\n    Percent(Float)\n    Fill(Float)\n}}\n\npub struct TUICapabilities {{\n    pub color_profile: TUIColorProfile\n    pub color: Bool\n    pub unicode: Bool\n    pub mouse: Bool\n    pub resize: Bool\n    pub clipboard: Bool\n    pub width: Int\n    pub height: Int\n}}\n\npub struct TUIStyle {{\n    pub foreground: TUIColor?\n    pub background: TUIColor?\n    pub bold: Bool\n    pub dim: Bool\n    pub underline: Bool\n}}\n\npub struct TUIListState {{\n    pub selected: Int\n    pub offset: Int\n}}\n\npub fn capabilities() -> TUICapabilities Never! {{\n    core.tui.capabilities()\n}}\n\npub fn ascii(value: String) -> String Never! {{ core.tui.ascii(value) }}\npub fn color_ansi16(index: Int) -> TUIColor Never! {{ core.tui.color_ansi16(index) }}\npub fn color_ansi256(index: Int) -> TUIColor Never! {{ core.tui.color_ansi256(index) }}\npub fn color_rgb(red: Int, green: Int, blue: Int) -> TUIColor Never! {{\n    core.tui.color_rgb(red, green, blue)\n}}\n\npub fn style() -> TUIStyle Never! {{ core.tui.style() }}\npub fn style_bold(s: TUIStyle, enabled: Bool) -> TUIStyle Never! {{\n    core.tui.style_bold(^s, enabled)\n}}\npub fn style_dim(s: TUIStyle, enabled: Bool) -> TUIStyle Never! {{\n    core.tui.style_dim(^s, enabled)\n}}\npub fn style_underline(s: TUIStyle, enabled: Bool) -> TUIStyle Never! {{\n    core.tui.style_underline(^s, enabled)\n}}\npub fn style_foreground(s: TUIStyle, color: TUIColor) -> TUIStyle Never! {{\n    core.tui.style_foreground(^s, color)\n}}\npub fn style_background(s: TUIStyle, color: TUIColor) -> TUIStyle Never! {{\n    core.tui.style_background(^s, color)\n}}\npub fn style_text(value: String, s: TUIStyle, caps: TUICapabilities) -> String Never! {{\n    core.tui.style_text(value, s, caps)\n}}\npub fn display_width(value: String) -> Int Never! {{ core.tui.display_width(value) }}\n\npub fn length(value: Float) -> TUIConstraint Never! {{ core.tui.length(value) }}\npub fn min(value: Float) -> TUIConstraint Never! {{ core.tui.min(value) }}\npub fn max(value: Float) -> TUIConstraint Never! {{ core.tui.max(value) }}\npub fn percent(value: Float) -> TUIConstraint Never! {{ core.tui.percent(value) }}\npub fn fill(weight: Float) -> TUIConstraint Never! {{ core.tui.fill(weight) }}\npub fn horizontal() -> TUIDirection Never! {{ core.tui.horizontal() }}\npub fn vertical() -> TUIDirection Never! {{ core.tui.vertical() }}\n\npub fn layout(area: Rect, direction: TUIDirection, constraints: [TUIConstraint]) -> [Rect] Never! {{\n    core.tui.layout(area, direction, ^constraints)\n}}\n\npub fn list(items: [String]) -> UINode Never! {{\n    core.tui.list(^items)\n}}\n\npub fn table(headers: [String], rows: [[String]]) -> ui.UINode Never! {{\n    core.tui.table(^headers, ^rows)\n}}\n\npub fn list_state() -> TUIListState Never! {{ core.tui.list_state() }}\npub fn list_state_select(state: TUIListState, index: Int) -> TUIListState Never! {{\n    core.tui.list_state_select(^state, index)\n}}\npub fn list_state_selected(state: TUIListState) -> Int Never! {{\n    core.tui.list_state_selected(state)\n}}\npub fn list_state_offset(state: TUIListState, offset: Int) -> TUIListState Never! {{\n    core.tui.list_state_offset(^state, offset)\n}}\n\npub fn key_event(code: String) -> TUIEvent Never! {{ core.tui.key_event(code) }}\npub fn key_event_modifiers(code: String, modifiers: Int) -> TUIEvent Never! {{\n    core.tui.key_event_modifiers(code, modifiers)\n}}\npub fn resize_event(width: Float, height: Float) -> TUIEvent Never! {{\n    core.tui.resize_event(width, height)\n}}\npub fn timer_event(id: String, elapsed_ms: Int) -> TUIEvent Never! {{\n    core.tui.timer_event(id, elapsed_ms)\n}}\npub fn io_event(channel: String, payload: [U8]) -> TUIEvent Never! {{\n    core.tui.io_event(channel, ^payload)\n}}\npub fn focus_event(focused: Bool) -> TUIEvent Never! {{ core.tui.focus_event(focused) }}\npub fn interrupt_event() -> TUIEvent Never! {{ core.tui.interrupt_event() }}\npub fn close_event() -> TUIEvent Never! {{ core.tui.close_event() }}\n\n"}
}

fn foundation_embedded_core_source_90() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.ui.host", alias: "core_core_ui_host", path: "Core/ui/host.jet", owner: "", owned_members: [String]{"accessibility", "capabilities", "file_filter", "file_filter_text", "fs_grant", "fs_rights_read", "fs_rights_read_write", "fs_rights_write", "open_file", "open_request", "save_file", "save_request", "shortcut"}, source: "use core as core\n// core.ui.host — typed host capability leaves for dialogs and metadata.\n//\n// Every operation that crosses the process boundary is forwarded to the\n// scoped provider.  Request construction and validation remain pure Jet code;\n// cancellation, headless, and denied outcomes stay typed.\n\npub enum UICapability {{\n    FileDialog\n    Clipboard\n    IME\n    DragDrop\n    Shortcuts\n    Accessibility\n    FontShaping\n}}\n\npub enum UICancellation {{\n    User\n    Closed\n    Headless\n    Superseded\n    Programmatic\n}}\n\npub enum UIFileDialogKind {{\n    Open\n    Save\n}}\n\npub enum UIFSAccess {{\n    Read\n    Write\n}}\n\n#Error\npub enum UIHostError {{\n    Cancelled\n    Headless\n    Denied\n    Missing\n    InvalidRequest\n    CapabilityUnavailable\n    CapabilityDenied\n    HostFailure\n    ResourceDenied\n    ShortcutConflict\n    QueueFull\n}}\n\npub struct UICapabilityFact {{\n    pub capability: UICapability\n    pub available: Bool\n}}\n\npub struct UICapabilityFacts {{\n    pub facts: [UICapabilityFact]\n}}\n\npub struct UIFSRights {{\n    pub read: Bool\n    pub write: Bool\n}}\n\npub struct UIFSGrant {{\n    pub root: String\n    pub rights: UIFSRights\n}}\n\npub struct UIGrantedPath {{\n    pub path: String\n    pub grant_root: String\n    pub access: UIFSAccess\n}}\n\npub struct UIFileFilter {{\n    pub label: String\n    pub extensions: [String]\n    pub mime_types: [String]\n}}\n\npub struct UIFileDialogRequest {{\n    pub kind: UIFileDialogKind\n    pub title: String\n    pub grant: UIFSGrant\n    pub initial_directory: UIGrantedPath?\n    pub filters: [UIFileFilter]\n    pub allow_multiple: Bool\n}}\n\npub struct UIFileDialogSelection {{\n    pub files: [UIGrantedPath]\n}}\n\npub struct UIShortcutModifiers {{\n    pub bits: Int\n}}\n\npub struct UIShortcut {{\n    pub key: String\n    pub modifiers: UIShortcutModifiers\n}}\npub struct UITextRange {{\n    pub start: Int\n    pub end: Int\n}}\n\npub struct UIClipboardText {{\n    pub text: String\n    pub selection: UITextRange?\n}}\n\npub struct UIClipboardWrite {{\n    pub characters: Int\n}}\n\npub struct UINodeID {{\n    pub value: String\n}}\n\npub struct UIAccessibilityProjection {{\n    pub lines: [String]\n}}\npub struct UIShortcutBinding {{\n    pub shortcut: UIShortcut\n    pub action: String\n    pub node: UINodeID?\n}}\n\npub enum UIShortcutDispatch {{\n    Dispatched(UIShortcutBinding)\n    Unhandled\n}}\n\n\n\npub fn capabilities() -> UICapabilityFacts Never! {{ core.ui.host.capabilities() }}\n\npub fn open_file(request: UIFileDialogRequest) -[FS]> UIFileDialogSelection UIHostError! {{\n    core.ui.host.open_file(request)\n}}\n\npub fn save_file(request: UIFileDialogRequest) -[FS]> UIFileDialogSelection UIHostError! {{\n    core.ui.host.save_file(request)\n}}\n\npub fn open_request(grant: UIFSGrant) -> UIFileDialogRequest Never! {{\n    core.ui.host.open_request(grant)\n}}\n\npub fn save_request(grant: UIFSGrant) -> UIFileDialogRequest Never! {{\n    core.ui.host.save_request(grant)\n}}\n\npub fn file_filter(label: String, extensions: [String], mime_types: [String]) -> UIFileFilter UIHostError! {{\n    if label.len() == 0 && extensions.len() == 0 && mime_types.len() == 0 -> return Err(UIHostError.InvalidRequest)\n    loop extension in extensions {{\n        if extension.len() == 0 -> return Err(UIHostError.InvalidRequest)\n    }}\n    loop mime in mime_types {{\n        if mime.len() == 0 -> return Err(UIHostError.InvalidRequest)\n    }}\n    core.ui.host.file_filter(label, extensions, mime_types)\n}}\n\npub fn file_filter_text() -> UIFileFilter Never! {{\n    core.ui.host.file_filter_text()\n}}\n\npub fn fs_grant(path: String, rights: UIFSRights) -> UIFSGrant UIHostError! {{\n    if path.trim() == \"\" || (!rights.read && !rights.write) -> return Err(UIHostError.InvalidRequest)\n    core.ui.host.fs_grant(path, rights)\n}}\n\npub fn fs_rights_read() -> UIFSRights Never! {{ core.ui.host.fs_rights_read() }}\npub fn fs_rights_write() -> UIFSRights Never! {{ core.ui.host.fs_rights_write() }}\npub fn fs_rights_read_write() -> UIFSRights Never! {{ core.ui.host.fs_rights_read_write() }}\n\npub fn shortcut(key: String, modifiers: UIShortcutModifiers) -[IO]> UIShortcut UIHostError! {{\n    if key.trim() == \"\" -> return Err(UIHostError.InvalidRequest)\n    core.ui.host.shortcut(key, modifiers)\n}}\n\npub fn accessibility(role: String, label: String) -[IO]> UIAccessibility UIHostError! {{\n    if role.trim() == \"\" || label.trim() == \"\" -> return Err(UIHostError.InvalidRequest)\n    core.ui.host.accessibility(role, label)\n}}\n\n"}
}

fn foundation_embedded_core_source_91() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.ui.host.clipboard", alias: "core_core_ui_host_clipboard", path: "Core/ui/host/clipboard.jet", owner: "", owned_members: [String]{"clear", "is_empty", "read_text", "write_text"}, source: "use core as core\nuse core.ui.host.[UIClipboardText, UIClipboardWrite, UIHostError]\n\n// core.ui.host.clipboard — typed UTF-8 clipboard provider.\npub fn read_text() -[IO]> UIClipboardText UIHostError! {{\n    core.ui.host.clipboard.read_text()\n}}\n\npub fn write_text(text: String) -[IO]> UIClipboardWrite UIHostError! {{\n    core.ui.host.clipboard.write_text(text)\n}}\n\npub fn clear() -[IO]> UIClipboardWrite UIHostError! {{\n    write_text(\"\")\n}}\n\npub fn is_empty() -[IO]> Bool UIHostError! {{\n    read_text().text.len() == 0\n}}\n"}
}

fn foundation_embedded_core_source_92() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.ui.host.ime", alias: "core_core_ui_host_ime", path: "Core/ui/host/ime.jet", owner: "", owned_members: [String]{"poll"}, source: "use core as core\nuse core.ui.host.[UIHostError, UINodeID, UITextRange]\n\n// core.ui.host.ime — typed input-method editor events.\npub enum UIIMEPhase {{\n    Start\n    Update\n    Commit\n    Cancel\n}}\n\npub struct UIIMEComposition {{\n    pub text: String\n    pub selection: UITextRange\n    pub marked: UITextRange?\n}}\n\npub struct UIIMEEvent {{\n    pub target: UINodeID\n    pub phase: UIIMEPhase\n    pub composition: UIIMEComposition?\n}}\n\npub fn poll() -[IO]> UIIMEEvent? UIHostError! {{\n    core.ui.host.ime.poll()\n}}\n"}
}

fn foundation_embedded_core_source_93() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.ui.host.drag_drop", alias: "core_core_ui_host_drag_drop", path: "Core/ui/host/drag_drop.jet", owner: "", owned_members: [String]{"poll"}, source: "use core as core\nuse core.ui.host.[UIGrantedPath, UIHostError, UINodeID]\n\n// core.ui.host.drag_drop — typed file/text drop events.\npub enum UIDragPhase {{\n    Enter\n    Over\n    Drop\n    Leave\n    Cancel\n}}\n\npub enum UIDragOperation {{\n    Copy\n    Move\n    Link\n}}\n\npub enum UIDropItem {{\n    Text(value: String)\n    URI(value: String)\n    File(value: UIGrantedPath)\n}}\n\npub struct UIDragEvent {{\n    pub target: UINodeID\n    pub phase: UIDragPhase\n    pub operation: UIDragOperation\n    pub items: [UIDropItem]\n}}\n\npub fn poll() -[IO]> UIDragEvent? UIHostError! {{\n    core.ui.host.drag_drop.poll()\n}}\n"}
}

fn foundation_embedded_core_source_94() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.ui.host.shortcuts", alias: "core_core_ui_host_shortcuts", path: "Core/ui/host/shortcuts.jet", owner: "", owned_members: [String]{"binding", "dispatch", "register"}, source: "use core as core\nuse core.ui.host.[UIHostError, UIShortcut, UIShortcutBinding, UIShortcutDispatch]\n\n// core.ui.host.shortcuts — provider-backed shortcut registration/dispatch.\npub fn binding(shortcut: UIShortcut, action: String) -> UIShortcutBinding UIHostError! {{\n    if action.trim() == \"\" -> return Err(UIHostError.InvalidRequest)\n    core.ui.host.shortcuts.binding(shortcut, action)\n}}\n\npub fn register(binding: UIShortcutBinding) -[IO]> UIShortcutBinding UIHostError! {{\n    core.ui.host.shortcuts.register(binding)\n}}\n\npub fn dispatch(shortcut: UIShortcut) -[IO]> UIShortcutDispatch UIHostError! {{\n    core.ui.host.shortcuts.dispatch(shortcut)\n}}\n"}
}

fn foundation_embedded_core_source_95() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.ui.host.accessibility", alias: "core_core_ui_host_accessibility", path: "Core/ui/host/accessibility.jet", owner: "", owned_members: [String]{"attach", "project"}, source: "use core as core\nuse core.ui.[UINode]\nuse core.ui.host.[UIAccessibility, UIAccessibilityProjection, UIHostError, UINodeID]\n\n// core.ui.host.accessibility — route canonical node metadata through the host.\npub fn attach(node: UINode, metadata: UIAccessibility) UIHostError! -[IO]> {{\n    core.ui.host.accessibility.attach(node, metadata)\n}}\n\npub fn project(node: UINode, node_id: UINodeID) -[IO]> UIAccessibilityProjection? UIHostError! {{\n    core.ui.host.accessibility.project(node, node_id)\n}}\n"}
}

fn foundation_embedded_core_source_96() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.units", alias: "core_units", path: "Core/units/units.jet", owner: "", owned_members: [String]{"from", "abs", "add", "bytes_of", "convert", "div", "equals", "grams", "is_zero", "kibibytes", "kilograms", "kilometers", "meters", "milliseconds", "mul", "ratio", "scale", "seconds", "show", "si", "sub", "to_si", "metres", "kilometres"}, source: "package {{\n    name: \"core.units\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"Measured quantities.\"\n    license: \"MIT\"\n    outputs: {{\n        units: .Library{{ entry: units }}\n    }}\n}}\nuse core as core\nuse core.math as math\npub fn from(magnitude: Float, unit: Float) -> Measurement<Float> Never! {{\n    // Measurements carry an SI value and uncertainty; the unit scale is\n    // applied at construction because the carrier has no unit field.\n    measurement(magnitude * unit, uncertainty: 0.0)\n}}\n\npub fn si(magnitude: Float) -> Measurement<Float> Never! {{ measurement(magnitude, uncertainty: 0.0) }}\n\nNANO :: 0.000000001\n\nMICRO :: 0.000001\n\nMILLI :: 0.001\n\nCENTI :: 0.01\n\nKILO :: 1000.0\n\nMEGA :: 1000000.0\n\nGIGA :: 1000000000.0\n\npub fn scale(m: Measurement<Float>, factor: Float) -> Measurement<Float> Never! {{\n    uncertainty := m.uncertainty * math.abs_float(factor)\n    measurement(m.value * factor, uncertainty: uncertainty)\n}}\n\npub fn add(a: Measurement<Float>, b: Measurement<Float>) -> Measurement<Float> Never! {{ a + b }}\n\npub fn sub(a: Measurement<Float>, b: Measurement<Float>) -> Measurement<Float> Never! {{ a - b }}\n\npub fn mul(a: Measurement<Float>, n: Float) -> Measurement<Float> Never! {{\n    a * measurement(n, uncertainty: Float{{0.0}})\n}}\n\npub fn div(a: Measurement<Float>, n: Float) -> Measurement<Float> Never! {{\n    a / measurement(n, uncertainty: Float{{0.0}})\n}}\n\npub fn convert(m: Measurement<Float>, new_unit: Float) -> Measurement<Float> Never! {{\n    // A unit scale must be finite and non-zero.  Rejecting an invalid target\n    // as an identity conversion keeps the non-fallible public carrier intact\n    // without manufacturing an infinite or NaN measurement.\n    if !math.is_finite(new_unit) || new_unit == (Float{{0.0}}) -> return ~m\n    factor :: Float{{1.0}} / new_unit\n    if !math.is_finite(factor) -> return ~m\n    converted := scale(m, factor)\n    if !math.is_finite(converted.value) || !math.is_finite(converted.uncertainty) -> return ~m\n    converted\n}}\n\npub fn to_si(m: Measurement<Float>) -> Float Never! {{ m.value }}\n\npub fn abs(m: Measurement<Float>) -> Measurement<Float> Never! {{\n    if m.value < (Float{{0.0}}) -> return measurement(Float{{0.0}} - m.value, uncertainty: m.uncertainty)\n    ~m\n}}\n\npub fn show(m: Measurement<Float>) -> String Never! {{ \"{{m.value}} ± {{m.uncertainty}}\" }}\n\nMETER :: 1.0\n// British spellings remain source-compatible with the original Core surface.\nMETRE :: 1.0\n\nGRAM :: 0.001\n\nSECOND :: 1.0\n\nBYTE_UNIT :: 1.0\n\nKIBIBYTE :: 1024.0\n\nMEBIBYTE :: 1048576.0\n\nGIBIBYTE :: 1073741824.0\n\npub fn meters(n: Float) -> Measurement<Float> Never! {{ from(n, 1.0) }}\n\npub fn kilometers(n: Float) -> Measurement<Float> Never! {{ from(n, 1000.0) }}\npub fn metres(n: Float) -> Measurement<Float> Never! {{ meters(n) }}\n\npub fn kilometres(n: Float) -> Measurement<Float> Never! {{ kilometers(n) }}\n\npub fn grams(n: Float) -> Measurement<Float> Never! {{ from(n, 0.001) }}\n\npub fn kilograms(n: Float) -> Measurement<Float> Never! {{ from(n, 1.0) }}\n\npub fn seconds(n: Float) -> Measurement<Float> Never! {{ from(n, 1.0) }}\n\npub fn milliseconds(n: Float) -> Measurement<Float> Never! {{ from(n, 0.001) }}\n\npub fn bytes_of(n: Float) -> Measurement<Float> Never! {{ from(n, 1.0) }}\n\npub fn kibibytes(n: Float) -> Measurement<Float> Never! {{ from(n, 1024.0) }}\n\npub fn equals(a: Measurement<Float>, b: Measurement<Float>) -> Bool Never! {{\n    left :: to_si(a)\n    right :: to_si(b)\n    d := left - right\n    if d < 0.0 -> d = -d\n    d < 0.000000001\n}}\n\npub fn ratio(a: Measurement<Float>, b: Measurement<Float>) -> Float Never! {{\n    den :: to_si(b)\n    if den == 0.0 -> return 0.0\n    to_si(a) / den\n}}\n\npub fn is_zero(m: Measurement<Float>) -> Bool Never! {{\n    v :: to_si(m)\n    if v < 0.0 -> return v > -0.000000001\n    v < 0.000000001\n}}\n"}
}

fn foundation_embedded_core_source_97() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.watcher", alias: "core_core_watcher", path: "Core/watcher/watcher.jet", owner: "", owned_members: [String]{"add", "contains", "files", "kind", "len", "port", "process_pid", "remove", "set", "target", "recursive", "debounce", "poll", "events", "cancel", "is_active", "summary", "drain"}, source: "package {{\n    name: \"core.watcher\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"Filesystem, process, and port watches.\"\n    license: \"MIT\"\n    outputs: {{\n        watcher: .Library{{ entry: watcher }}\n    }}\n}}\n\nuse core as core\nuse core.files as files\n\npub struct WatchHandle {{ pub kind: String, pub target: String }}\npub struct WatchSet {{ pub handles: [WatchHandle] }}\n\npub fn files(path: String) -[FS]> WatchHandle IOError! {{\n    if path.bytes().len() == 0 {{\n        return Err(IOError.InvalidInput(IOContext{{\n            operation: .Resolve,\n            resource: Val(path),\n            os_code: None,\n            cause: Val(\"empty path\"),\n        }}))\n    }}\n    core.watcher.files(path)\n}}\n\npub fn process_pid(pid: Int) -> WatchHandle Never! {{\n    core.watcher.process_pid(pid)\n}}\n\npub fn port(host: String, port: Int) -[Net]> WatchHandle Never! {{\n    core.watcher.port(host, port)\n}}\n\npub fn set() -> WatchSet Never! {{ core.watcher.set() }}\n\n\npub fn add(set: WatchSet, handle: WatchHandle) -[IO]> WatchSet Never! {{\n    set.add(handle)\n    ~set\n}}\n\npub fn remove(set: WatchSet, target: String) -> WatchSet IOError! {{\n    if target.len() == 0 {{\n        return Err(IOError.InvalidInput(IOContext{{\n            operation: .Resolve,\n            resource: Val(target),\n            os_code: None,\n            cause: Val(\"empty target\"),\n        }}))\n    }}\n    Err(IOError.Other(IOContext{{\n        operation: .Resolve,\n        resource: Val(target),\n        os_code: None,\n        cause: Val(\"watch sets do not support removal\"),\n    }}))\n}}\n\npub fn contains(set: WatchSet, target: String) -> Bool IOError! {{\n    if target.len() == 0 -> return Ok(false)\n    Err(IOError.Other(IOContext{{\n        operation: .Resolve,\n        resource: Val(target),\n        os_code: None,\n        cause: Val(\"watch sets do not expose target lookup\"),\n    }}))\n}}\n\npub fn len(set: WatchSet) -> Int Never! {{\n    summary_count(set.summary())\n}}\n\npub fn kind(handle: WatchHandle) -> String Never! {{\n    summary_kind(handle.summary())\n}}\n\npub fn target(handle: WatchHandle) -> String Never! {{\n    summary_target(handle.summary())\n}}\n\n\npub enum WatchDomain {{\n    File\n    Process\n    Port\n}}\n\npub enum WatchEventKind {{\n    Created\n    Modified\n    Removed\n    Error\n    Exited\n    Ready\n}}\n\npub struct WatchEvent {{\n    pub domain: WatchDomain\n    pub kind: WatchEventKind\n    pub path: String\n    pub detail: String\n    pub pid: Int\n    pub port: Int\n}}\n\npub fn recursive(path: String) -[FS]> WatchHandle IOError! {{\n    // The host file watcher already snapshots directories recursively.\n    files(path)\n}}\n\npub fn debounce(handle: WatchHandle, ms: Int) -> WatchHandle IOError! {{\n    if ms < 0 {{\n        return Err(IOError.InvalidInput(IOContext{{\n            operation: .Resolve,\n            resource: Val(target(handle)),\n            os_code: None,\n            cause: Val(\"negative debounce interval\"),\n        }}))\n    }}\n    Err(IOError.Other(IOContext{{\n        operation: .Resolve,\n        resource: Val(target(handle)),\n        os_code: None,\n        cause: Val(\"debounce is not supported by the host watcher\"),\n    }}))\n}}\n\npub fn poll(handle: WatchHandle) -[IO]> [WatchEvent] Never! {{ handle.poll() }}\n\npub fn events(handle: WatchHandle) -[IO]> [WatchEvent] Never! {{ handle.events() }}\n\npub fn cancel(handle: WatchHandle) Never! -[IO]> {{ handle.cancel() }}\n\npub fn is_active(handle: WatchHandle) -> Bool Never! {{ handle.is_active() }}\n\npub fn summary(handle: WatchHandle) -> String Never! {{ handle.summary() }}\n\npub fn drain(set: WatchSet) -[IO]> [WatchEvent] Never! {{ set.poll() }}\n\nfn summary_kind(text: String) -> String {{\n    if has_prefix(text, \"watch file \") -> return \"file\"\n    if has_prefix(text, \"watch process \") -> return \"process\"\n    if has_prefix(text, \"watch port \") -> return \"port\"\n    \"watch\"\n}}\n\nfn summary_target(text: String) -> String Never! {{\n    if has_prefix(text, \"watch file \") -> return suffix(text, 11)\n    if has_prefix(text, \"watch process \") -> return suffix(text, 14)\n    if has_prefix(text, \"watch port \") -> return suffix(text, 11)\n    \"\"\n}}\n\nfn summary_count(text: String) -> Int {{\n    seen := false\n    n := 0\n    loop b in text.bytes() {{\n        if seen {{\n            if b < 48 || b > 57 -> return n\n            n = n * 10 + (b - 48)\n        }} else if b == 61 {{\n            seen = true\n        }}\n    }}\n    n\n}}\n\nfn has_prefix(text: String, prefix: String) -> Bool Never! {{\n    raw := text.bytes()\n    want := prefix.bytes()\n    if want.len() > raw.len() -> return false\n    loop i in 0..<want.len() {{\n        if raw[i] != want[i] -> return false\n    }}\n    true\n}}\n\nfn suffix(text: String, start: Int) -> String Never! {{\n    raw := text.bytes()\n    out := [U8]{{}}\n    i := start\n    loop {{\n        if i >= raw.len() -> return String.from_bytes(out) ?? \"\"\n        &out.push(raw[i])\n        i = i + 1\n    }}\n}}\n\n"}
}

fn foundation_embedded_core_source_98() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.web", alias: "core_core_web", path: "Core/web/web.jet", owner: "", owned_members: [String]{"app", "auth", "auth_oauth", "auth_routes", "auth_show", "form", "invalidate", "live", "live_get", "live_show", "live_stats", "on", "openapi", "page", "signal_push", "storage", "subscribe", "sync", "transact_invalidate", "value"}, source: "package {{\n    name: \"core.web\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"App, pages, live queries, forms, and browser tests.\"\n    license: \"MIT\"\n    outputs: {{\n        web: .Library{{ entry: web }}\n    }}\n}}\n\nuse core as core\nuse core.web.forms.[WebFormError, WebFormInput, WebFormTyped]\n\n// core.web — server-rendered apps on `core.http`.\n//\n// An `App` owns routes, live-query keys, and session auth. Nested modules\n// own router, store, forms, table, virtual windows, storage, and browser\n// tests. Nothing here talks to a browser; `core.http` is the wire.\n\nmodule browser\nmodule devserver\nmodule forms\nmodule query\nmodule router\nmodule storage\nmodule store\nmodule table\nmodule virtual\n\npub struct App {{\n    pub name: String\n    pub pages: [WebPage]\n    pub live: [LiveQuery]\n    pub sessions: [Session]\n}}\n\npub struct WebPage {{\n    pub title: String\n    pub body: String\n}}\n\npub struct WebEvent {{\n    pub path: String\n    pub title: String\n    pub payload: String\n}}\n\npub struct Context {{\n    pub path: String\n    pub method: String\n    pub session: String\n}}\n\npub struct Mount {{\n    pub path: String\n    pub page: String\n}}\n\npub struct Auth {{\n    pub kind: String\n    pub client_id: String\n}}\n\npub struct Session {{\n    pub id: String\n    pub user_id: String\n}}\n\npub struct LiveQuery {{\n    pub key: String\n    pub data: String\n    pub generation: Int\n    pub subscribers: Int\n}}\n\npub fn app() -> App Never! {{ App{{name: \"app\", pages: [WebPage]{{}}, live: [LiveQuery]{{}}, sessions: [Session]{{}}}} }}\n\npub fn page(title: String, body: String) -> WebPage Never! {{ WebPage{{title: title, body: body}} }}\n\npub fn form(input: WebFormInput, action: String) -> WebFormTyped WebFormError! {{\n    core.web.forms.typed(input, action)\n}}\n\n\npub fn on(path: String, title: String, handler: fn(WebEvent)) Never! -[Browser]> {{\n    core.web.on(path, title, handler)\n}}\n\npub fn openapi(router: HTTPRouter) -> String Never! {{\n    core.web.openapi(router)\n}}\n\npub fn value(key: String) -[Browser]> String Never! {{ core.web.value(key) }}\n\npub fn storage() -> String Never! {{ \"local\" }}\n\npub fn auth(kind: String) -> Auth Never! {{ Auth{{kind: kind, client_id: \"\"}} }}\n\npub fn auth_oauth(auth: Auth, client_id: String) -> Auth Never! {{\n    Auth{{kind: \"oauth\", client_id: client_id}}\n}}\n\npub fn auth_routes(auth: Auth) -> [String] Never! {{\n    if {{\n        auth.kind == \"oauth\" -> return [String]{{\"/auth/login\", \"/auth/callback\", \"/auth/logout\"}}\n        else -> [String]{{\"/login\", \"/logout\"}}\n    }}\n}}\n\npub fn auth_show(auth: Auth) -> String Never! {{ \"{{auth.kind}}:{{auth.client_id}}\" }}\n\npub fn live(key: String, data: String) -> LiveQuery Never! {{ LiveQuery{{key: key, data: data, generation: 1, subscribers: 0}} }}\n\npub fn subscribe(key: String) -> LiveQuery Never! {{ LiveQuery{{key: key, data: \"\", generation: 1, subscribers: 1}} }}\n\npub fn invalidate(key: String) -> Int Never! {{ key_token(key) }}\n\npub fn transact_invalidate(key: String) -> Int Never! {{ key_token(key) + 1 }}\n\npub fn live_get(q: LiveQuery) -> String Never! {{ q.data }}\n\npub fn live_show(q: LiveQuery) -> String Never! {{ \"{{q.key}}@{{q.generation}}\" }}\n\npub fn live_stats() -> String Never! {{ core.web.live_stats() }}\n\npub fn signal_push(q: LiveQuery, payload: String) -> LiveQuery Never! {{ sync_query(q, payload) }}\n\npub fn sync(key: String, data: String) -> String Never! {{\n    \"{{key}}:{{data}}\"\n}}\n\nfn sync_query(q: LiveQuery, data: String) -> LiveQuery {{\n    LiveQuery{{key: q.key, data: data, generation: q.generation + 1, subscribers: q.subscribers}}\n}}\n\nfn key_token(key: String) -> Int {{\n    n := 5381\n    loop b in key.bytes() -> n = ((n * 33) + b) %% 2147483647\n    n\n}}\n\n"}
}

fn foundation_embedded_core_source_99() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.web.browser", alias: "core_core_web_browser", path: "Core/web/browser.jet", owner: "", owned_members: [String]{"begin_named", "config", "config_from_env", "connect", "connect_browser_profile", "fixture_context", "fixture_page", "fixture_source", "generate_source", "locked", "make_profile", "report_add_case", "report_exit_code", "report_html", "report_json", "report_new", "report_text", "selected", "server_logs", "server_start", "server_stop", "server_url", "timeout", "watch_changed", "write_report"}, source: "use core as core\n\n// core.web.browser — headed/headless browser control for tests.\n//\n// Connect talks to a host CDP/WebDriver cell. Reports, fixtures, and\n// generated source are Jet: they never need a real browser. Headless CI\n// uses `connect` which may return `BrowserError.Headless`.\n\nC_MAX_SOURCE_BYTES :: 1048576\n\nC_MAX_SOURCE_NAME :: 256\n\n#Error\npub enum BrowserError {{\n    Connect\n    Headless\n    Timeout\n    Protocol\n    Closed\n}}\n\npub enum BrowserPrivacy {{\n    Default\n    Isolated\n}}\n\npub enum BrowserProtocol {{\n    CDP\n    WebDriver\n}}\n\npub struct BrowserTimeout {{\n    pub ms: Int\n}}\n\npub struct BrowserProfile {{\n    pub name: String\n    pub privacy: BrowserPrivacy\n    pub headless: Bool\n}}\n\npub struct BrowserAbilities {{\n    pub javascript: Bool\n    pub screenshots: Bool\n}}\n\npub struct Browser {{\n    pub id: Int\n    pub browser_profile: BrowserProfile\n    pub url: String\n    pub closed: Bool\n}}\n\npub struct BrowserContext {{\n    pub id: Int\n    pub browser: Int\n}}\n\npub struct BrowserPage {{\n    pub id: Int\n    pub url: String\n    pub title: String\n}}\n\npub struct BrowserFrame {{\n    pub id: Int\n    pub page_id: Int\n    pub url: String\n}}\n\npub struct BrowserLocator {{\n    pub selector: String\n    pub page_id: Int\n}}\n\npub struct BrowserLocked {{\n    pub reason: String\n}}\n\npub struct BrowserIntercept {{\n    pub url: String\n    pub status: Int\n}}\n\npub struct BrowserEvent {{\n    pub kind: String\n    pub target: String\n}}\n\npub struct BrowserReceipt {{\n    pub ok: Bool\n    pub detail: String\n}}\n\npub struct BrowserTrace {{\n    pub events: [String]\n}}\n\npub struct BrowserTestConfig {{\n    pub headless: Bool\n    pub timeout_ms: Int\n    pub base_url: String\n}}\n\npub struct BrowserTestCase {{\n    pub name: String\n    pub ok: Bool\n    pub detail: String\n}}\n\npub struct BrowserReport {{\n    pub title: String\n    pub cases: [BrowserTestCase]\n}}\n\npub struct BrowserServer {{\n    pub url: String\n    pub running: Bool\n    pub logs: String\n    native: BrowserTestServer?\n}}\n\npub fn config() -> BrowserTestConfig BrowserError! {{\n    core.web.browser.config()\n}}\n\npub fn config_from_env() -[Env, FS]> BrowserTestConfig BrowserError! {{\n    core.web.browser.config_from_env()\n}}\n\n\npub fn make_profile(name: String) -> BrowserProfile Never! {{\n    BrowserProfile{{name: name, privacy: BrowserPrivacy.Isolated, headless: true}}\n}}\n\npub fn timeout(ms: Int) -> BrowserTimeout BrowserError! {{\n    core.web.browser.timeout(ms)\n}}\n\npub fn locked(engine: String) -[FS, IO]> BrowserLocked BrowserError! {{\n    core.web.browser.locked(engine)\n\n}}\npub fn connect() -[Net]> Browser BrowserError! {{ core.web.browser.connect(\"default\") }}\n\npub fn connect_browser_profile(p: BrowserProfile, t: BrowserTimeout) -[Net]> Browser BrowserError! {{\n    endpoint := \"{{p.name}}\"\n    core.web.browser.connect_profile(endpoint, p, t)\n}}\n\n\n\npub fn selected(page: BrowserPage, selector: String) -> BrowserLocator Never! {{\n    BrowserLocator{{selector: selector, page_id: page.id}}\n}}\npub fn begin_named(config: BrowserTestConfig, test: String, engine: String, attempt: Int, source_path: String, line: Int, column: Int) -[Net]> BrowserTestFixture BrowserError! {{\n    core.web.browser.begin_named(config, test, engine, attempt, source_path, line, column)\n}}\n\npub fn fixture_context(browser: Browser) -> BrowserContext Never! {{ BrowserContext{{id: browser.id, browser: browser.id}} }}\n\npub fn fixture_page(ctx: BrowserContext, url: String) -> BrowserPage Never! {{\n    BrowserPage{{id: ctx.id, url: url, title: \"\"}}\n}}\n\n\npub fn fixture_source(name: String, body: String) -> String BrowserError! {{\n    generate_source(name, body, \"\")\n}}\n\npub fn generate_source(name: String, body: String, base_url: String) -> String BrowserError! {{\n    if name.len() == 0 || name.len() > C_MAX_SOURCE_NAME || body.len() > C_MAX_SOURCE_BYTES || base_url.len() > C_MAX_SOURCE_BYTES {{\n        return Err(BrowserError.Protocol)\n    }}\n    url := base_url\n    if url.len() == 0 -> url = \"/\"\n    test_name := source_name(name)\n    escaped :: esc_source(url)\n    out := \"// generated browser test\\nfn {{test_name}}() {{{{\\n    _ :: \\\"{{escaped}}\\\"\\n    {{body}}\\n}}}}\\n\"\n    if out.len() > C_MAX_SOURCE_BYTES -> return Err(BrowserError.Protocol)\n    Ok(out)\n}}\n\npub fn report_new(title: String) -> BrowserReport Never! {{ BrowserReport{{title: title, cases: [BrowserTestCase]{{}}}} }}\n\npub fn report_add_case(report: BrowserReport, name: String, ok: Bool) -> BrowserReport Never! {{\n    cases := [BrowserTestCase]{{}}\n    loop c in report.cases -> &cases.push(c)\n    &cases.push(BrowserTestCase{{name: name, ok: ok, detail: \"\"}})\n    BrowserReport{{title: report.title, cases: cases}}\n}}\n\npub fn report_html(report: BrowserReport) -> String Never! {{\n    out := \"<!doctype html><html><head><title>{{esc(report.title)}}</title></head><body><h1>{{esc(report.title)}}</h1><ol>\"\n    loop c in report.cases {{\n        cls := \"pass\"\n        if !c.ok -> cls = \"fail\"\n        out = \"{{out}}<li class=\\\"{{cls}}\\\">{{esc(c.name)}}</li>\"\n    }}\n    out = \"{{out}}</ol></body></html>\"\n    out\n}}\n\npub fn report_json(report: BrowserReport) -> String Never! {{\n    out := \"{{{{\\\"title\\\":\\\"{{esc_json(report.title)}}\\\",\\\"passed\\\":{{passed(report)}},\\\"failed\\\":{{failed(report)}},\\\"cases\\\":[\"\n    loop i in 0..<report.cases.len() {{\n        c :: report.cases[i]\n        if i > 0 -> out = \"{{out}},\"\n        ok := \"true\"\n        if !c.ok -> ok = \"false\"\n        out = \"{{out}}{{{{\\\"name\\\":\\\"{{esc_json(c.name)}}\\\",\\\"ok\\\":{{ok}}}}}}\"\n    }}\n    \"{{out}}]}}}}\"\n}}\n\npub fn report_text(report: BrowserReport) -> String Never! {{\n    out := \"{{report.title}}\\n\"\n    loop c in report.cases {{\n        mark := \"ok\"\n        if !c.ok -> mark = \"FAIL\"\n        out = \"{{out}}[{{mark}}] {{c.name}}\\n\"\n    }}\n    out = \"{{out}}{{passed(report)}} passed, {{failed(report)}} failed\\n\"\n    out\n}}\n\npub fn report_exit_code(report: BrowserReport) -> Int Never! {{\n    if failed(report) > 0 -> return 1\n    0\n}}\n\npub fn write_report(report: BrowserReport, path: String) IOError! {{\n    core.files.write(path, report_text(report))\n}}\n\npub fn server_start(root: String) -[Net]> BrowserServer BrowserError! {{\n    if root.len() > C_MAX_SOURCE_BYTES -> return Err(BrowserError.Protocol)\n    cfg := BrowserTestConfig{{headless: true, timeout_ms: 5000, base_url: root}}\n    native :: core.web.browser.server_start(cfg)\n    Ok(BrowserServer{{url: native.url(), running: true, logs: native.logs(), native: Val(native)}})\n}}\npub fn watch_changed(path: String) -[FS, Net]> Bool BrowserError! {{\n    // The public carrier has no prior mtime.  A negative baseline is the\n    // provider's explicit \"no snapshot\" value; zero would fabricate one.\n    core.web.browser.watch_changed(path, -1)\n}}\n\npub fn server_stop(server: BrowserServer) -> BrowserServer Never! {{\n    if server.native == None -> return BrowserServer{{url: server.url, running: false, logs: server.logs, native: None}}\n    native :: server.native ?? return BrowserServer{{url: server.url, running: false, logs: server.logs, native: None}}\n    _ :: core.web.browser.server_stop(native)\n    BrowserServer{{url: server.url, running: false, logs: server.logs, native: None}}\n}}\n\npub fn server_url(server: BrowserServer) -> String Never! {{ server.url }}\n\npub fn server_logs(server: BrowserServer) -> String Never! {{ server.logs }}\n\n\n\nfn passed(report: BrowserReport) -> Int Never! {{\n    n := 0\n    loop c in report.cases {{\n        if c.ok -> n = n + 1\n    }}\n    n\n}}\n\nfn failed(report: BrowserReport) -> Int Never! {{ report.cases.len() - passed(report) }}\n\nfn esc(text: String) -> String {{\n    raw :: text.bytes()\n    out := [U8]{{}}\n    loop b in raw {{\n        n :: b\n        if n == 38 {{\n            push_str(&out, \"&amp;\")\n        }} else {{\n            if n == 60 {{\n                push_str(&out, \"&lt;\")\n            }} else {{\n                if n == 62 {{\n                    push_str(&out, \"&gt;\")\n                }} else {{\n                    if n == 34 {{\n                        push_str(&out, \"&quot;\")\n                    }} else {{\n                        if n == 39 -> push_str(&out, \"&#39;\") else -> &out.push(b)\n                    }}\n                }}\n            }}\n        }}\n    }}\n    String.from_bytes(out) ?? \"\"\n}}\n\nfn esc_json(text: String) -> String {{\n    raw :: text.bytes()\n    out := [U8]{{}}\n    loop b in raw {{\n        n :: b\n        if n == 34 || n == 92 {{\n            &out.push(U8{{92}})\n            &out.push(b)\n        }} else {{\n            if n == 10 {{\n                push_str(&out, \"\\\\n\")\n            }} else {{\n                if n == 13 {{\n                    push_str(&out, \"\\\\r\")\n                }} else {{\n                    if n == 9 -> push_str(&out, \"\\\\t\") else -> &out.push(b)\n                }}\n            }}\n        }}\n    }}\n    String.from_bytes(out) ?? \"\"\n}}\n\nfn push_str(out: &[U8], s: String) Never! {{\n    loop b in s.bytes() -> &out.push(b)\n}}\nfn source_name(text: String) -> String Never! {{\n    raw :: text.bytes()\n    out := [U8]{{}}\n    loop i in 0..<raw.len() {{\n        n :: raw[i]\n        ok := (n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || n == 95\n        if ok {{\n            if i == 0 && n >= 48 && n <= 57 -> &out.push(U8{{95}})\n            &out.push(n)\n        }} else {{\n            &out.push(U8{{95}})\n        }}\n    }}\n    if out.len() == 0 -> return \"generated_browser_test\"\n    String.from_bytes(out) ?? \"generated_browser_test\"\n}}\n\nfn esc_source(text: String) -> String Never! {{\n    raw :: text.bytes()\n    out := [U8]{{}}\n    loop b in raw {{\n        if b == (U8{{92}}) || b == (U8{{34}}) {{\n            &out.push(U8{{92}})\n            &out.push(b)\n        }} else {{\n            if b == (U8{{10}}) {{\n                push_str(&out, \"\\\\n\")\n            }} else {{\n                if b == (U8{{13}}) -> push_str(&out, \"\\\\r\") else -> &out.push(b)\n            }}\n        }}\n    }}\n    String.from_bytes(out) ?? \"\"\n}}\n\n"}
}

fn foundation_embedded_core_source_100() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.web.devserver", alias: "core_core_web_devserver", path: "Core/web/devserver.jet", owner: "", owned_members: [String]{"app", "for_app", "is_local", "url"}, source: "// core.web.devserver — hot-reload wrapper around an App.\npub struct DevServer {{\n    pub app_name: String\n    pub url: String\n    pub watching: Bool\n}}\n\npub fn app() -> DevServer Never! {{ {{app_name: \"app\", url: \"http://127.0.0.1:3000\", watching: true}} }}\n\npub fn for_app(name: String) -> DevServer Never! {{\n    {{app_name: name, url: \"http://127.0.0.1:3000\", watching: true}}\n}}\n\npub fn url(host: String, port: Int) -> String Never! {{ \"http://{{host}}:{{port}}\" }}\n\npub fn is_local(host: String) -> Bool Never! {{\n    host == \"127.0.0.1\" || host == \"localhost\" || host == \"::1\"\n}}\n"}
}

fn foundation_embedded_core_source_101() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.web.forms", alias: "core_core_web_forms", path: "Core/web/forms.jet", owner: "", owned_members: [String]{"action_error", "action_field_error", "action_form_error", "blur", "field", "html", "input", "input_exclude", "input_group", "input_rename", "input_replace", "new", "no_script", "set", "show", "submit", "typed", "typed_blur", "typed_cancel", "typed_decode_post", "typed_errors", "typed_focus", "typed_html", "typed_lifecycle", "typed_no_script", "typed_post", "typed_select_field", "typed_set", "typed_set_action", "typed_set_async_validator", "typed_show", "typed_state", "typed_submission_cancel", "typed_submission_wait", "typed_submit", "typed_submit_async", "typed_validate", "typed_validate_async", "typed_validate_field", "typed_validation_cancel", "typed_validation_render", "typed_validation_wait", "validate", "validate_async"}, source: "// core.web.forms — typed HTML forms and validation carriers.\n\nC_MAX_FORM_BYTES :: 1048576\n\nC_MAX_FORM_FIELDS :: 256\n\nC_MAX_FORM_TEXT :: 1048576\n\n#Error\npub enum WebFormError {{\n    Invalid\n    Missing\n    Validation\n}}\n\npub enum WebFormValueType {{\n    String\n    Int\n    Bool\n    Float\n}}\n\npub enum WebFormControl {{\n    Text\n    Email\n    URL\n    Password\n    Number\n    Date\n    Checkbox\n    Hidden\n}}\n\npub enum WebFormStatus {{\n    Idle\n    Dirty\n    Validating\n    Invalid\n    Submitting\n    Submitted\n    Error\n}}\n\npub enum WebFormValidationTiming {{\n    Immediate\n    Debounced\n    OnBlur\n}}\n\npub struct WebFormFieldSpec {{\n    pub name: String\n    pub value_type: WebFormValueType\n    pub required: Bool\n    pub default: String?\n    pub label: String\n    pub control: WebFormControl\n    pub group: String?\n    pub wire_name: String\n}}\n\npub struct WebFormFieldState {{\n    pub name: String\n    pub value_type: WebFormValueType\n    pub required: Bool\n    pub value: String\n    pub touched: Bool\n    pub validating: Bool\n    pub errors: [String]\n}}\n\npub struct WebForm {{\n    pub action: String\n    pub method: String\n    pub fields: [WebFormFieldState]\n    pub status: WebFormStatus\n    pub form_error: String\n    pub focused: String\n}}\n\npub struct WebFormState {{\n    pub status: WebFormStatus\n    pub fields: [String:WebFormFieldState]\n    pub action: String\n    pub method: String\n    pub result: String\n    pub error: String\n    pub submission_count: Int\n}}\n\npub struct WebFormInput {{\n    pub type_name: String\n    pub fields: [WebFormFieldSpec]\n}}\n\npub struct WebFormTyped {{\n    pub form: WebForm\n    pub action: String\n    pub input: WebFormInput\n}}\n\npub struct WebFormActionError {{\n    pub field_errors: [String:[String]]\n    pub form_errors: [String]\n}}\n\npub struct WebFormDecodedInput {{\n    pub type_name: String\n    pub values: [String:String]\n    pub wire_values: [String:String]\n}}\n\npub struct WebFormValidationChain {{\n    pub form: WebFormTyped\n    pub field: String\n    pub valid: Bool\n}}\n\npub struct WebFormValidation {{\n    pub form: WebFormTyped\n    pub pending: Bool\n}}\n\npub struct WebFormTypedSubmission {{\n    pub form: WebFormTyped\n    pub pending: Bool\n}}\n\npub struct WebFormErrorState {{\n    pub fields: [String:[String]]\n    pub form: [String]\n}}\n\npub enum WebFormLifecycleStatus {{\n    Idle\n    Pending\n    Submitting\n    Success\n    Failure\n    Cancelled\n}}\n\npub struct WebFormLifecycle {{\n    pub status: WebFormLifecycleStatus\n    pub result: String\n    pub error: String\n    pub generation: Int\n}}\n\npub fn new(action: String) -> WebForm Never! {{\n    WebForm{{action: action, method: \"POST\", fields: [WebFormFieldState]{{}}, status: WebFormStatus.Idle, form_error: \"\", focused: \"\"}}\n}}\n\npub fn field(form: WebForm, name: String, kind: String, required: Bool) -> WebForm WebFormError! {{\n    if name.len() == 0 || name.len() > 128 || !valid_name(~name) || !valid_kind(~kind) -> return Err(WebFormError.Invalid)\n    out := ~form\n    loop item in out.fields {{\n        if item.name == name -> return Err(WebFormError.Invalid)\n    }}\n    if out.fields.len() >= C_MAX_FORM_FIELDS -> return Err(WebFormError.Invalid)\n    &out.fields.push(WebFormFieldState{{name: ~name, value_type: parse_kind(~kind), required: required, value: \"\", touched: false, validating: false, errors: [String]{{}}}})\n    Ok(out)\n}}\n\npub fn set(form: &WebForm, name: String, value: String) WebFormError! {{\n    if value.len() > C_MAX_FORM_TEXT -> return Err(WebFormError.Invalid)\n    loop i in 0..<form.fields.len() {{\n        if form.fields[i].name == name {{\n            form.fields[i].value = ~value\n            form.fields[i].errors = [String]{{}}\n            form.fields[i].touched = true\n            form.fields[i].validating = false\n            form.status = WebFormStatus.Dirty\n            return Ok()\n        }}\n    }}\n    return Err(WebFormError.Missing)\n}}\n\npub fn blur(form: &WebForm, name: String) WebFormError! {{\n    found := false\n    valid := false\n    loop field in form.fields {{\n        if field.name == name {{\n            found = true\n            valid = validate_field_form(&form, ~name)\n            break\n        }}\n    }}\n    if !found -> return Err(WebFormError.Missing)\n    if !valid -> return Err(WebFormError.Validation)\n    form.status = WebFormStatus.Dirty\n    form.focused = \"\"\n    return Ok()\n}}\n\npub fn validate(form: &WebForm) WebFormError! {{\n    if !apply_validation(&form) -> return Err(WebFormError.Validation)\n    return Ok()\n}}\n\npub fn validate_async(form: WebForm) -> WebForm Never! {{\n    out := ~form\n    out.status = WebFormStatus.Validating\n    out\n}}\n\npub fn submit(form: &WebForm) -> String WebFormError! {{\n    if !apply_validation(&form) -> return Err(WebFormError.Validation)\n    form.status = WebFormStatus.Submitted\n    html(~form)\n}}\n\npub fn no_script(form: WebForm) -> String WebFormError! {{ html(form) }}\npub fn html(form: WebForm) -> String Never! {{ render_html(form) }}\npub fn show(form: WebForm) -> String Never! {{ render_html(form) }}\n\npub fn input(name: String, fields: [WebFormFieldSpec]) -> WebFormInput WebFormError! {{\n    if !valid_name(~name) || fields.len() == 0 || fields.len() > C_MAX_FORM_FIELDS -> return Err(WebFormError.Invalid)\n    names := [String]{{}}\n    wires := [String]{{}}\n    loop field in fields {{\n        if !valid_name(field.name) || !valid_name(field.wire_name) -> return Err(WebFormError.Invalid)\n        if field.default == .Val(default) {{\n            if default.len() > C_MAX_FORM_TEXT || has_control_text(~default) -> return Err(WebFormError.Invalid)\n        }}\n        if contains_name(names, field.name) || contains_name(wires, field.wire_name) -> return Err(WebFormError.Invalid)\n        &names.push(field.name)\n        &wires.push(field.wire_name)\n    }}\n    Ok(WebFormInput{{type_name: ~name, fields: copy_fields(fields)}})\n}}\n\npub fn input_rename(input: WebFormInput, old_name: String, new_name: String) -> WebFormInput WebFormError! {{\n    if !valid_name(new_name) -> return Err(WebFormError.Invalid)\n    out := ~input\n    renamed := false\n    loop i in 0..<out.fields.len() {{\n        if out.fields[i].name == old_name {{\n            out.fields[i].name = ~new_name\n            out.fields[i].wire_name = ~new_name\n            renamed = true\n        }}\n    }}\n    if !renamed -> return Err(WebFormError.Missing)\n    if !fields_valid(out.fields) -> return Err(WebFormError.Invalid)\n    Ok(out)\n}}\n\npub fn input_exclude(input: WebFormInput, name: String) -> WebFormInput WebFormError! {{\n    if name.len() == 0 -> return Err(WebFormError.Invalid)\n    fields := [WebFormFieldSpec]{{}}\n    found := false\n    loop item in input.fields {{\n        if item.name == name -> found = true else -> &fields.push(item)\n    }}\n    if !found -> return Err(WebFormError.Missing)\n    if !fields_valid(fields) -> return Err(WebFormError.Invalid)\n    Ok(WebFormInput{{type_name: ~input.type_name, fields: fields}})\n}}\n\npub fn input_group(input: WebFormInput, prefix: String, suffix: String) -> WebFormInput WebFormError! {{\n    if prefix.len() == 0 && suffix.len() == 0 -> return Err(WebFormError.Invalid)\n    fields := [WebFormFieldSpec]{{}}\n    loop item in input.fields {{\n        &fields.push(WebFormFieldSpec{{name: \"{{prefix}}{{item.name}}{{suffix}}\", value_type: item.value_type, required: item.required, default: item.default, label: item.label, control: item.control, group: item.group, wire_name: \"{{prefix}}{{item.wire_name}}{{suffix}}\"}})\n    }}\n    if !fields_valid(fields) -> return Err(WebFormError.Invalid)\n    Ok(WebFormInput{{type_name: ~input.type_name, fields: fields}})\n}}\n\npub fn input_replace(input: WebFormInput, name: String, replacement: WebFormFieldSpec) -> WebFormInput WebFormError! {{\n    if !valid_name(name) || !valid_name(replacement.name) || !valid_name(replacement.wire_name) -> return Err(WebFormError.Invalid)\n    out := ~input\n    found := false\n    loop i in 0..<out.fields.len() {{\n        if out.fields[i].name == name {{\n            out.fields[i] = replacement\n            found = true\n        }}\n    }}\n    if !found -> return Err(WebFormError.Missing)\n    if !fields_valid(out.fields) -> return Err(WebFormError.Invalid)\n    Ok(~out)\n}}\n\npub fn typed(input: WebFormInput, action: String) -> WebFormTyped WebFormError! {{\n    if action.len() == 0 || action.len() > C_MAX_FORM_TEXT || !fields_valid(input.fields) -> return Err(WebFormError.Invalid)\n    states := states_from_specs(input.fields)\n    Ok(WebFormTyped{{form: WebForm{{action: ~action, method: \"POST\", fields: states, status: WebFormStatus.Idle, form_error: \"\", focused: \"\"}}, action: action, input: input}})\n}}\n\npub fn typed_set(form: &WebFormTyped, name: String, value: String) WebFormError! {{\n    set(&form.form, name, value)\n}}\n\npub fn typed_set_async_validator(form: &WebFormTyped, name: String, timing: WebFormValidationTiming, delay_ms: Int, validator: fn(String)) WebFormError! {{\n    _ :: ~timing\n    _ :: delay_ms\n    if name.len() == 0 -> return Err(WebFormError.Missing)\n    loop i in 0..<form.form.fields.len() {{\n        if form.form.fields[i].name == name {{\n            if form.form.fields[i].value.len() > C_MAX_FORM_TEXT -> return Err(WebFormError.Invalid)\n            form.form.fields[i].validating = true\n            form.form.status = WebFormStatus.Validating\n            validator(~form.form.fields[i].value)\n            form.form.fields[i].validating = false\n            valid := validate_field_form(&form.form, name)\n            if valid -> form.form.status = WebFormStatus.Dirty else -> form.form.status = WebFormStatus.Invalid\n            return Ok()\n        }}\n    }}\n    return Err(WebFormError.Missing)\n}}\n\npub fn typed_set_action<E>(form: WebFormTyped, handler: fn(WebFormDecodedInput) -> String E!) E! {{\n    decoded :: decoded_from_input(form)\n    _ :: handler(decoded)\n}}\n\npub fn action_error() -> WebFormActionError Never! {{ WebFormActionError{{field_errors: [String:[String]]{{}}, form_errors: [String]{{}}}} }}\npub fn action_field_error(error: WebFormActionError, field: String, message: String) -> WebFormActionError Never! {{\n    if field.len() == 0 || field.len() > 128 || message.len() == 0 || message.len() > C_MAX_FORM_TEXT -> return ~error\n    out := ~error\n    existing :: out.field_errors.get(field)\n    if existing == None {{\n        _ :: &out.field_errors.add(~field, [String]{{~message}})\n    }} else {{\n        errors := ~existing\n        if errors.len() >= C_MAX_FORM_FIELDS -> return out\n        &errors.push(~message)\n        _ :: &out.field_errors.add(~field, errors)\n    }}\n    out\n}}\n\npub fn action_form_error(error: WebFormActionError, message: String) -> WebFormActionError Never! {{\n    if message.len() == 0 || message.len() > C_MAX_FORM_TEXT -> return ~error\n    out := ~error\n    if out.form_errors.len() < C_MAX_FORM_FIELDS -> &out.form_errors.push(~message)\n    out\n}}\n\n\npub fn typed_blur(form: &WebFormTyped, name: String) WebFormError! {{ blur(&form.form, name) }}\npub fn typed_validate(form: &WebFormTyped) WebFormError! {{ validate(&form.form) }}\npub fn typed_validate_async(form: WebFormTyped) -> WebFormValidation Never! {{\n    out := ~form\n    out.form.status = WebFormStatus.Validating\n    WebFormValidation{{form: out, pending: true}}\n}}\n\npub fn typed_validate_field(form: WebFormTyped, name: String, timing: WebFormValidationTiming, validator: fn(String)) -> WebFormValidationChain Never! {{\n    _ :: ~timing\n    out := ~form\n    valid := false\n    loop i in 0..<out.form.fields.len() {{\n        if out.form.fields[i].name == name {{\n            out.form.fields[i].validating = true\n            out.form.status = WebFormStatus.Validating\n            validator(~out.form.fields[i].value)\n            out.form.fields[i].validating = false\n            valid = validate_field_form(&out.form, ~name)\n            if valid -> out.form.status = WebFormStatus.Dirty else -> out.form.status = WebFormStatus.Invalid\n            break\n        }}\n    }}\n    WebFormValidationChain{{form: out, field: name, valid: valid}}\n}}\n\npub fn typed_validation_render(chain: WebFormValidationChain) -> String Never! {{\n    if chain.valid -> return \"{{chain.field}}:valid\"\n    \"{{chain.field}}:invalid\"\n}}\n\npub fn typed_submit(form: &WebFormTyped) -> String WebFormError! {{\n    if !apply_validation(&form.form) -> return Err(WebFormError.Validation)\n    form.form.status = WebFormStatus.Submitted\n    typed_html(~form)\n}}\npub fn typed_no_script(form: &WebFormTyped) -> String WebFormError! {{ typed_html(~form) }}\npub fn typed_submit_async(form: WebFormTyped) -> WebFormTypedSubmission Never! {{\n    out := ~form\n    out.form.status = WebFormStatus.Submitting\n    WebFormTypedSubmission{{form: out, pending: true}}\n}}\n\npub fn typed_post(form: WebFormTyped, body: String) -> String WebFormError! {{\n    if body.len() > C_MAX_FORM_BYTES || !valid_encoding(~body) -> return Err(WebFormError.Invalid)\n    decoded :: decode_typed_input(form.input, ~body) ?? return Err(WebFormError.Invalid)\n    encode_typed_input(form.input, decoded)\n}}\n\npub fn typed_decode_post(form: WebFormTyped, body: String) -> WebFormDecodedInput WebFormError! {{\n    if body.len() > C_MAX_FORM_BYTES || !valid_encoding(~body) -> return Err(WebFormError.Invalid)\n    decode_typed_input(form.input, ~body) ?? return Err(WebFormError.Invalid)\n}}\n\npub fn typed_html(form: WebFormTyped) -> String Never! {{ render_typed_html(form) }}\npub fn typed_show(form: WebFormTyped) -> String Never! {{ render_typed_html(form) }}\n\npub fn typed_state(form: WebFormTyped) -> String Never! {{ status_name(form.form.status) }}\npub fn typed_lifecycle(form: WebFormTyped) -> WebFormLifecycle Never! {{ lifecycle(form.form.status) }}\n\npub fn typed_errors(form: WebFormTyped) -> WebFormErrorState Never! {{\n    names := [String:[String]]{{ }}\n    loop field in form.form.fields {{\n        if field.errors.len() > 0 -> _ :: &names.add(~field.name, ~field.errors)\n    }}\n    form_errors := [String]{{}}\n    if form.form.form_error.len() > 0 -> &form_errors.push(~form.form.form_error)\n    WebFormErrorState{{fields: names, form: form_errors}}\n}}\n\npub fn typed_focus(form: &WebFormTyped, name: String) WebFormError! {{\n    if name.len() == 0 -> return Err(WebFormError.Missing)\n    loop item in form.form.fields {{\n        if item.name == name {{\n            form.form.focused = ~name\n            return Ok()\n        }}\n    }}\n    return Err(WebFormError.Missing)\n}}\n\npub fn typed_cancel(form: &WebFormTyped) Never! {{\n    form.form.status = WebFormStatus.Idle\n    form.form.form_error = \"\"\n}}\n\npub fn typed_select_field(form: WebFormTyped, name: String) -> WebFormFieldState WebFormError! {{\n    loop field in form.form.fields {{\n        if field.name == name -> return Ok(~field)\n    }}\n    return Err(WebFormError.Missing)\n}}\n\npub fn typed_validation_wait(validation: &WebFormValidation) WebFormError! {{\n    result :: validate(&validation.form.form)\n    validation.pending = false\n    result\n}}\n\npub fn typed_validation_cancel(validation: &WebFormValidation) Never! {{\n    validation.pending = false\n    validation.form.form.status = WebFormStatus.Idle\n}}\n\npub fn typed_submission_wait(submission: &WebFormTypedSubmission) -> String WebFormError! {{\n    result :: typed_submit(&submission.form)\n    submission.pending = false\n    result\n}}\n\npub fn typed_submission_cancel(submission: &WebFormTypedSubmission) Never! {{\n    submission.pending = false\n    submission.form.form.status = WebFormStatus.Idle\n}}\nfn render_typed_html(form: WebFormTyped) -> String Never! {{\n    out := \"<form action=\\\"{{esc(form.form.action)}}\\\" method=\\\"{{esc(form.form.method)}}\\\">\"\n    loop spec in form.input.fields {{\n        value := \"\"\n        errors := [String]{{}}\n        loop field in form.form.fields {{\n            if field.name == spec.name {{\n                value = ~field.value\n                errors = ~field.errors\n                break\n            }}\n        }}\n        typ := \"text\"\n        if spec.control == WebFormControl.Email -> typ = \"email\"\n        if spec.control == WebFormControl.URL -> typ = \"url\"\n        if spec.control == WebFormControl.Password -> typ = \"password\"\n        if spec.control == WebFormControl.Number -> typ = \"number\"\n        if spec.control == WebFormControl.Date -> typ = \"date\"\n        if spec.control == WebFormControl.Checkbox -> typ = \"checkbox\"\n        if spec.control == WebFormControl.Hidden -> typ = \"hidden\"\n        req := \"\"\n        if spec.required -> req = \" required\"\n        checked := \"\"\n        if spec.control == WebFormControl.Checkbox && (value == \"true\" || value == \"1\") -> checked = \" checked\"\n        label := spec.label\n        if label.len() == 0 -> label = spec.name\n        out = \"{{out}}<label>{{esc(label)}}<input name=\\\"{{esc(spec.wire_name)}}\\\" type=\\\"{{typ}}\\\" value=\\\"{{esc(value)}}\\\"{{req}}{{checked}}></label>\"\n        if errors.len() > 0 -> out = \"{{out}}<span class=\\\"error\\\">{{esc(errors[0])}}</span>\"\n    }}\n    if form.form.form_error.len() > 0 -> out = \"{{out}}<p class=\\\"error\\\">{{esc(form.form.form_error)}}</p>\"\n    \"{{out}}<button type=\\\"submit\\\">Submit</button></form>\"\n}}\n\n\n\nfn render_html(form: WebForm) -> String Never! {{\n    out := \"<form action=\\\"{{esc(form.action)}}\\\" method=\\\"{{esc(form.method)}}\\\">\"\n    loop field in form.fields {{\n        typ := \"text\"\n        if field.value_type == WebFormValueType.Int || field.value_type == WebFormValueType.Float -> typ = \"number\"\n        if field.value_type == WebFormValueType.Bool -> typ = \"checkbox\"\n        req := \"\"\n        if field.required -> req = \" required\"\n        checked := \"\"\n        if field.value_type == WebFormValueType.Bool && (field.value == \"true\" || field.value == \"1\") -> checked = \" checked\"\n        out = \"{{out}}<label>{{esc(field.name)}}<input name=\\\"{{esc(field.name)}}\\\" type=\\\"{{typ}}\\\" value=\\\"{{esc(field.value)}}\\\"{{req}}{{checked}}></label>\"\n        if field.errors.len() > 0 -> out = \"{{out}}<span class=\\\"error\\\">{{esc(field.errors[0])}}</span>\"\n    }}\n    if form.form_error.len() > 0 -> out = \"{{out}}<p class=\\\"error\\\">{{esc(form.form_error)}}</p>\"\n    \"{{out}}<button type=\\\"submit\\\">Submit</button></form>\"\n}}\n\nfn valid_kind(kind: String) -> Bool Never! {{\n    kind == \"string\" || kind == \"int\" || kind == \"bool\" || kind == \"float\"\n}}\n\nfn parse_kind(kind: String) -> WebFormValueType Never! {{\n    if kind == \"int\" -> return WebFormValueType.Int\n    if kind == \"bool\" -> return WebFormValueType.Bool\n    if kind == \"float\" -> return WebFormValueType.Float\n    WebFormValueType.String\n}}\n\nfn validation_error(field: WebFormFieldState) -> String Never! {{\n    if field.required && field.value.len() == 0 -> return \"required\"\n    if field.value.len() == 0 -> return \"\"\n    if field.value_type == WebFormValueType.Int && !is_int(field.value) -> return \"int\"\n    if field.value_type == WebFormValueType.Float && !is_float(field.value) -> return \"float\"\n    if field.value_type == WebFormValueType.Bool && !is_bool(field.value) -> return \"bool\"\n    \"\"\n}}\n\nfn apply_validation(form: &WebForm) -> Bool Never! {{\n    ok := true\n    loop i in 0..<form.fields.len() {{\n        err := validation_error(form.fields[i])\n        form.fields[i].errors = [String]{{}}\n        if err.len() > 0 {{\n            &form.fields[i].errors.push(~err)\n            ok = false\n        }}\n        form.fields[i].touched = true\n    }}\n    form.status = WebFormStatus.Dirty\n    if !ok -> form.status = WebFormStatus.Invalid\n    ok\n}}\n\nfn validate_field_form(form: &WebForm, name: String) -> Bool Never! {{\n    loop i in 0..<form.fields.len() {{\n        if form.fields[i].name == name {{\n            err := validation_error(form.fields[i])\n            form.fields[i].errors = [String]{{}}\n            if err.len() > 0 -> &form.fields[i].errors.push(~err)\n            form.fields[i].touched = true\n            return err.len() == 0\n        }}\n    }}\n    false\n}}\n\n\nfn lifecycle(status: WebFormStatus) -> WebFormLifecycle {{\n    lifecycle_status := WebFormLifecycleStatus.Idle\n    if status == WebFormStatus.Validating -> lifecycle_status = WebFormLifecycleStatus.Pending\n    if status == WebFormStatus.Submitting -> lifecycle_status = WebFormLifecycleStatus.Submitting\n    if status == WebFormStatus.Submitted -> lifecycle_status = WebFormLifecycleStatus.Success\n    if status == WebFormStatus.Invalid || status == WebFormStatus.Error -> lifecycle_status = WebFormLifecycleStatus.Failure\n    WebFormLifecycle{{status: lifecycle_status, result: \"\", error: \"\", generation: 0}}\n}}\n\nfn status_name(status: WebFormStatus) -> String {{\n    if status == {{\n        WebFormStatus.Idle -> \"idle\"\n        WebFormStatus.Dirty -> \"dirty\"\n        WebFormStatus.Validating -> \"validating\"\n        WebFormStatus.Invalid -> \"invalid\"\n        WebFormStatus.Submitting -> \"submitting\"\n        WebFormStatus.Submitted -> \"submitted\"\n        else -> \"error\"\n    }}\n}}\n\nfn copy_fields(fields: [WebFormFieldSpec]) -> [WebFormFieldSpec] Never! {{\n    out := [WebFormFieldSpec]{{ }}\n    loop field in fields -> &out.push(field)\n    out\n}}\n\nfn states_from_specs(fields: [WebFormFieldSpec]) -> [WebFormFieldState] Never! {{\n    out := [WebFormFieldState]{{}}\n    loop field in fields {{\n        value := \"\"\n        if field.default != None -> value = field.default ?? \"\"\n        &out.push(WebFormFieldState{{name: field.name, value_type: field.value_type, required: field.required, value: value, touched: false, validating: false, errors: [String]{{}}}})\n    }}\n    out\n}}\n\n\nfn decoded_from_input(form: WebFormTyped) -> WebFormDecodedInput {{\n    values := [String:String]{{}}\n    wire_values := [String:String]{{}}\n    loop spec in form.input.fields {{\n        value := \"\"\n        loop field in form.form.fields {{\n            if field.name == spec.name {{\n                value = field.value\n                break\n            }}\n        }}\n        _ :: &values.add(~spec.name, ~value)\n        _ :: &wire_values.add(~spec.wire_name, ~value)\n    }}\n    WebFormDecodedInput{{type_name: form.input.type_name, values: values, wire_values: wire_values}}\n}}\n\nfn encode_typed_input(input: WebFormInput, decoded: WebFormDecodedInput) -> String Never! {{\n    out := \"\"\n    loop i in 0..<input.fields.len() {{\n        if i > 0 -> out = \"{{out}}&\"\n        spec :: input.fields[i]\n        value :: decoded.wire_values.get(spec.wire_name) ?? \"\"\n        out = \"{{out}}{{url_encode(spec.wire_name)}}={{url_encode(value)}}\"\n    }}\n    out\n}}\n\nfn decode_typed_input(input: WebFormInput, body: String) -> WebFormDecodedInput? {{\n    states := states_from_specs(input.fields)\n    seen := [String]{{}}\n    if body.len() > 0 {{\n        pairs := split_amp(body)\n        if pairs.len() > C_MAX_FORM_FIELDS -> return None\n        loop pair in pairs {{\n            if pair.len() == 0 -> return None\n            eq := find_byte(pair, 61)\n            if eq <= 0 -> return None\n            key := url_decode(slice_text(pair, 0, eq))\n            value := url_decode(slice_text(pair, eq + 1, pair.len()))\n            if !valid_name(key) || has_control_text(key) || has_control_text(value) || value.len() > C_MAX_FORM_TEXT -> return None\n            if contains_name(seen, key) -> return None\n            index := wire_index(input.fields, key)\n            if index < 0 -> return None\n            states[index].value = ~value\n            &seen.push(~key)\n        }}\n    }}\n    loop i in 0..<input.fields.len() {{\n        spec :: input.fields[i]\n        if spec.required && !contains_name(seen, spec.wire_name) -> return None\n    }}\n    values := [String:String]{{}}\n    wire_values := [String:String]{{}}\n    loop i in 0..<input.fields.len() {{\n        spec :: input.fields[i]\n        value :: states[i].value\n        _ :: &values.add(~spec.name, ~value)\n        _ :: &wire_values.add(~spec.wire_name, ~value)\n    }}\n    Val(WebFormDecodedInput{{type_name: input.type_name, values: values, wire_values: wire_values}})\n}}\n\nfn wire_index(fields: [WebFormFieldSpec], wire_name: String) -> Int Never! {{\n    loop i in 0..<fields.len() {{\n        if fields[i].wire_name == wire_name -> return i\n    }}\n    -1\n}}\n\nfn find_byte(text: String, wanted: Int) -> Int Never! {{\n    raw := text.bytes()\n    loop i in 0..<raw.len() {{\n        if Int.from_u8(raw[i]) == wanted -> return i\n    }}\n    -1\n}}\n\nfn split_amp(text: String) -> [String] Never! {{\n    out := [String]{{ }}\n    start := 0\n    raw := text.bytes()\n    loop i in 0..<raw.len() {{\n        if raw[i] == (U8{{38}}) {{\n            &out.push(slice_text(text, start, i))\n            start = i + 1\n        }}\n    }}\n    if start <= raw.len() -> &out.push(slice_text(text, start, raw.len()))\n    out\n}}\n\nfn url_encode(text: String) -> String Never! {{\n    out := \"\"\n    loop b in text.bytes() {{\n        n :: Int.from_u8(b)\n        if (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || (n >= 48 && n <= 57) || n == 45 || n == 46 || n == 95 || n == 126 {{\n            ch := String.from_bytes([U8]{{b}}) ?? \"\"\n            out = \"{{out}}{{ch}}\"\n        }} else if n == 32 {{\n            out = \"{{out}}+\"\n        }} else {{\n            out = \"{{out}}%{{hex(n /% 16)}}{{hex(n %% 16)}}\"\n        }}\n    }}\n    out\n}}\n\nfn url_decode(text: String) -> String Never! {{\n    out := [U8]{{}}\n    raw := text.bytes()\n    i := 0\n    loop {{\n        if i >= raw.len() -> return String.from_bytes(out) ?? text\n        b :: raw[i]\n        if b == (U8{{43}}) {{\n            &out.push(U8{{32}})\n            i = i + 1\n            next\n        }}\n        if b == (U8{{37}}) && i + 2 < raw.len() {{\n            hi := hex_value(raw[i + 1])\n            lo := hex_value(raw[i + 2])\n            if hi >= 0 && lo >= 0 {{\n                &out.push(U8{{hi * 16 + lo}})\n                i = i + 3\n                next\n            }}\n        }}\n        &out.push(b)\n        i = i + 1\n    }}\n}}\nfn valid_encoding(text: String) -> Bool Never! {{\n    raw := text.bytes()\n    i := 0\n    loop i < raw.len() {{\n        if raw[i] == (U8{{37}}) {{\n            if i + 2 >= raw.len() || hex_value(raw[i + 1]) < 0 || hex_value(raw[i + 2]) < 0 -> return false\n            i = i + 3\n        }} else {{\n            i = i + 1\n        }}\n    }}\n    true\n}}\nfn fields_valid(fields: [WebFormFieldSpec]) -> Bool Never! {{\n    if fields.len() == 0 || fields.len() > C_MAX_FORM_FIELDS -> return false\n    names := [String]{{}}\n    wires := [String]{{}}\n    loop field in fields {{\n        if !valid_name(field.name) || !valid_name(field.wire_name) -> return false\n        if field.label.len() > C_MAX_FORM_TEXT -> return false\n        if field.default == .Val(default) {{\n            if default.len() > C_MAX_FORM_TEXT || has_control_text(~default) -> return false\n        }}\n        if contains_name(names, field.name) || contains_name(wires, field.wire_name) -> return false\n        &names.push(field.name)\n        &wires.push(field.wire_name)\n    }}\n    true\n}}\n\nfn valid_name(text: String) -> Bool Never! {{\n    raw := text.bytes()\n    if raw.len() == 0 || raw.len() > 128 -> return false\n    loop b in raw {{\n        n :: Int.from_u8(b)\n        if n < 33 || n == 127 || n == 38 || n == 61 -> return false\n    }}\n    true\n}}\n\nfn contains_name(names: [String], value: String) -> Bool Never! {{\n    loop name in names {{\n        if name == value -> return true\n    }}\n    false\n}}\n\nfn has_control_text(text: String) -> Bool Never! {{\n    loop b in text.bytes() {{\n        n :: Int.from_u8(b)\n        if n < 32 || n == 127 -> return true\n    }}\n    false\n}}\n\nfn hex(n: Int) -> String Never! {{\n    digits := \"0123456789ABCDEF\"\n    slice_text(digits, n, n + 1)\n}}\n\nfn hex_value(b: U8) -> Int Never! {{\n    n :: Int.from_u8(b)\n    if n >= 48 && n <= 57 -> return n - 48\n    if n >= 65 && n <= 70 -> return n - 55\n    if n >= 97 && n <= 102 -> return n - 87\n    return -1\n}}\n\nfn is_int(text: String) -> Bool Never! {{\n    raw := text.bytes()\n    if raw.len() == 0 -> return false\n    i := 0\n    if raw[0] == (U8{{45}}) -> i = 1\n    if i >= raw.len() -> return false\n    loop i < raw.len() {{\n        if raw[i] < 48 || raw[i] > 57 -> return false\n        i = i + 1\n    }}\n    true\n}}\n\nfn is_float(text: String) -> Bool Never! {{\n    raw := text.bytes()\n    if raw.len() == 0 -> return false\n    dots := 0\n    digits := 0\n    loop b in raw {{\n        if b == (U8{{46}}) -> dots = dots + 1 else if b >= 48 && b <= 57 -> digits = digits + 1 else -> return false\n    }}\n    dots <= 1 && digits > 0\n}}\n\nfn is_bool(text: String) -> Bool Never! {{ text == \"true\" || text == \"false\" || text == \"1\" || text == \"0\" }}\n\nfn esc(text: String) -> String Never! {{\n    raw := text.bytes()\n    out := [U8]{{ }}\n    loop b in raw {{\n        if b == 38 -> push_str(&out, \"&amp;\") else if b == 60 -> push_str(&out, \"&lt;\") else if b == 62 -> push_str(&out, \"&gt;\") else if b == 34 -> push_str(&out, \"&quot;\") else -> &out.push(b)\n    }}\n    String.from_bytes(out) ?? \"\"\n}}\n\nfn push_str(out: &[U8], value: String) Never! {{ loop b in value.bytes() -> &out.push(b) }}\n\nfn slice_text(text: String, start: Int, end: Int) -> String Never! {{\n    raw := text.bytes()\n    out := [U8]{{ }}\n    i := start\n    loop {{\n        if i < 0 || i >= end || i >= raw.len() -> return String.from_bytes(out) ?? \"\"\n        &out.push(raw[i])\n        i = i + 1\n    }}\n}}\n"}
}

fn foundation_embedded_core_source_102() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.web.query", alias: "core_core_web_query", path: "Core/web/query.jet", owner: "", owned_members: [String]{"cancel", "facts", "get", "invalidate", "live", "mutate", "mutate_with_invalidations", "mutation_signal", "mutation_state", "new", "queue", "refresh", "retry", "set_mode", "set_online", "show", "state", "state_signal", "subscribe"}, source: "// core.web.query — typed live-query state and mutation transitions.\nC_MAX_QUERY_KEY :: 256\n\nC_MAX_QUERY_PAYLOAD :: 1048576\n\nC_MAX_QUERY_SUBSCRIBERS :: 1000000\n\n\n#Error\npub enum WebQueryError {{\n    Offline\n    Conflict\n    Invalid\n}}\n\npub enum WebQueryStatus {{\n    Pending\n    Fresh\n    Stale\n    Fetching\n    Error\n    Offline\n}}\n\npub enum WebMutationStatus {{\n    Idle\n    Pending\n    Success\n    Error\n    Settled\n}}\n\npub enum WebQueryNetworkMode {{\n    Online\n    Always\n    OfflineFirst\n}}\n\npub struct WebQueryState {{\n    pub status: WebQueryStatus\n    pub generation: Int\n    pub online: Bool\n}}\n\npub struct WebQuery {{\n    pub key: String\n    pub data: String\n    pub status: WebQueryStatus\n    pub error: String\n    pub generation: Int\n    pub mode: WebQueryNetworkMode\n    pub online: Bool\n    pub subscribers: Int\n}}\n\npub struct WebMutationState {{\n    pub status: WebMutationStatus\n    pub data: String\n    pub error: String\n}}\npub struct WebQuerySeed {{\n    pub data: String\n    pub generation: Int\n    pub subscribers: Int\n}}\n\npub fn new(key: String, initial: WebQuerySeed) -> WebQuery Never! {{\n    generation := initial.generation\n    if generation < 1 -> generation = 1\n    subscribers := initial.subscribers\n    if subscribers < 0 -> subscribers = 0\n    if subscribers > C_MAX_QUERY_SUBSCRIBERS -> subscribers = C_MAX_QUERY_SUBSCRIBERS\n    status := WebQueryStatus.Fresh\n    error := \"\"\n    if !valid_key(key) || initial.data.len() > C_MAX_QUERY_PAYLOAD {{\n        status = WebQueryStatus.Error\n        error = \"invalid\"\n    }}\n    WebQuery{{key: ~key, data: initial.data, status: status, error: error, generation: generation, mode: WebQueryNetworkMode.Online, online: true, subscribers: subscribers}}\n}}\n\npub fn live<E>(key: String, data: String, url: String, loader: fn() -> String E!) -> WebQuery E! {{\n    loaded := data\n    if url.len() > 0 -> loaded = loader()\n    status := WebQueryStatus.Fresh\n    error := \"\"\n    if !valid_key(key) || loaded.len() > C_MAX_QUERY_PAYLOAD {{\n        status = WebQueryStatus.Error\n        error = \"invalid\"\n    }}\n    WebQuery{{key: ~key, data: loaded, status: status, error: error, generation: 1, mode: WebQueryNetworkMode.Online, online: true, subscribers: 0}}\n}}\n\npub fn get(q: WebQuery) -> String Never! {{ q.data }}\npub fn show(q: WebQuery) -> String Never! {{ \"{{q.key}}={{q.data}}\" }}\n\npub fn state(q: WebQuery) -> WebQueryState Never! {{\n    WebQueryState{{status: q.status, generation: q.generation, online: q.online}}\n}}\n\npub fn state_signal(q: WebQuery) -> String Never! {{ \"{{q.key}}:{{status_name(q.status)}}:{{q.generation}}\" }}\n\npub fn mutation_state(q: WebQuery) -> WebMutationState Never! {{\n    status := WebMutationStatus.Idle\n    if q.status == WebQueryStatus.Pending || q.status == WebQueryStatus.Fetching -> status = WebMutationStatus.Pending\n    if q.status == WebQueryStatus.Error || q.status == WebQueryStatus.Offline -> status = WebMutationStatus.Error\n    if q.status == WebQueryStatus.Fresh -> status = WebMutationStatus.Success\n    WebMutationState{{status: status, data: q.data, error: q.error}}\n}}\n\npub fn mutation_signal(q: WebQuery) -> String Never! {{ \"{{status_name(q.status)}}:{{q.generation}}\" }}\n\npub fn subscribe(key: String) -> WebQuery Never! {{\n    status := WebQueryStatus.Stale\n    error := \"\"\n    if !valid_key(key) {{\n        status = WebQueryStatus.Error\n        error = \"invalid\"\n    }}\n    WebQuery{{key: ~key, data: \"\", status: status, error: error, generation: 1, mode: WebQueryNetworkMode.Online, online: true, subscribers: 1}}\n}}\n\npub fn invalidate(q: &WebQuery) -> Int Never! {{\n    q.status = WebQueryStatus.Stale\n    q.generation = q.generation + 1\n    q.generation\n}}\n\npub fn refresh(q: &WebQuery) WebQueryError! {{\n    if q.status == WebQueryStatus.Fetching || q.status == WebQueryStatus.Pending -> return Err(WebQueryError.Invalid)\n    if !q.online && q.mode != WebQueryNetworkMode.Always {{\n        q.status = WebQueryStatus.Offline\n        q.error = \"offline\"\n        q.generation = q.generation + 1\n        return Err(WebQueryError.Offline)\n    }}\n    q.status = WebQueryStatus.Fetching\n    q.error = \"\"\n    q.generation = q.generation + 1\n    return Ok()\n}}\n\npub fn cancel(q: &WebQuery) -> Bool Never! {{\n    if q.status == WebQueryStatus.Fetching || q.status == WebQueryStatus.Pending {{\n        q.status = WebQueryStatus.Stale\n        q.error = \"cancelled\"\n        q.generation = q.generation + 1\n        return true\n    }}\n    false\n}}\n\npub fn queue(q: &WebQuery, data: String) -> Int WebQueryError! {{\n    if data.len() > C_MAX_QUERY_PAYLOAD -> return Err(WebQueryError.Invalid)\n    if q.status == WebQueryStatus.Fetching || q.status == WebQueryStatus.Pending -> return Err(WebQueryError.Invalid)\n    q.data = ~data\n    q.status = WebQueryStatus.Pending\n    q.error = \"\"\n    q.generation = q.generation + 1\n    q.generation\n}}\n\npub fn retry(q: &WebQuery, replay: fn(String)) -> Int WebQueryError! {{\n    if q.status == WebQueryStatus.Fetching || q.status == WebQueryStatus.Pending -> return Err(WebQueryError.Invalid)\n    if !q.online && q.mode != WebQueryNetworkMode.Always -> return Err(WebQueryError.Offline)\n    q.status = WebQueryStatus.Fetching\n    q.error = \"\"\n    replay(~q.key)\n    q.generation = q.generation + 1\n    q.generation\n}}\n\npub fn mutate<E>(q: &WebQuery, key: String, expected: String?, mutation: fn(String) -> String E!) -> WebMutationState E! {{\n    if !valid_key(key) || key != q.key {{\n        q.status = WebQueryStatus.Error\n        q.error = \"key\"\n        q.generation = q.generation + 1\n        return WebMutationState{{status: WebMutationStatus.Error, data: q.data, error: q.error}}\n    }}\n    if expected != None {{\n        actual :: expected\n        if actual.len() > C_MAX_QUERY_PAYLOAD || actual != q.data {{\n            q.status = WebQueryStatus.Error\n            q.error = \"conflict\"\n            q.generation = q.generation + 1\n            return WebMutationState{{status: WebMutationStatus.Error, data: q.data, error: q.error}}\n        }}\n    }}\n    if !q.online && q.mode != WebQueryNetworkMode.Always && q.mode != WebQueryNetworkMode.OfflineFirst {{\n        q.status = WebQueryStatus.Offline\n        q.error = \"offline\"\n        q.generation = q.generation + 1\n        return WebMutationState{{status: WebMutationStatus.Error, data: q.data, error: q.error}}\n    }}\n    q.status = WebQueryStatus.Pending\n    q.error = \"\"\n    next := mutation(q.data)\n    if next.len() > C_MAX_QUERY_PAYLOAD {{\n        q.status = WebQueryStatus.Error\n        q.error = \"payload\"\n        q.generation = q.generation + 1\n        return WebMutationState{{status: WebMutationStatus.Error, data: q.data, error: q.error}}\n    }}\n    q.data = ~next\n    q.generation = q.generation + 1\n    if !q.online && q.mode == WebQueryNetworkMode.OfflineFirst {{\n        q.error = \"offline\"\n        return WebMutationState{{status: WebMutationStatus.Pending, data: q.data, error: q.error}}\n    }}\n    q.status = WebQueryStatus.Fresh\n    WebMutationState{{status: WebMutationStatus.Success, data: q.data, error: \"\"}}\n}}\n\npub fn mutate_with_invalidations<E>(q: &WebQuery, key: String, expected: String?, invalidations: [String], mutation: fn(String) -> String E!) -> WebMutationState E! {{\n    if invalidations.len() > C_MAX_QUERY_SUBSCRIBERS {{\n        q.status = WebQueryStatus.Error\n        q.error = \"invalidations\"\n        q.generation = q.generation + 1\n        return WebMutationState{{status: WebMutationStatus.Error, data: q.data, error: q.error}}\n    }}\n    loop target in invalidations {{\n        if !valid_key(target) {{\n            q.status = WebQueryStatus.Error\n            q.error = \"invalidations\"\n            q.generation = q.generation + 1\n            return WebMutationState{{status: WebMutationStatus.Error, data: q.data, error: q.error}}\n        }}\n    }}\n    result :: mutate<E>(&q, key, expected, mutation)\n    if result.status == WebMutationStatus.Success && invalidations.len() > 0 {{\n        return WebMutationState{{status: WebMutationStatus.Settled, data: result.data, error: \"\"}}\n    }}\n    result\n}}\n\npub fn set_online(q: &WebQuery, online: Bool) Never! {{\n    if q.online == online -> return\n    q.online = online\n    q.generation = q.generation + 1\n    if !online {{\n        q.status = WebQueryStatus.Offline\n        q.error = \"offline\"\n    }} else if q.status == WebQueryStatus.Offline {{\n        q.status = WebQueryStatus.Stale\n        q.error = \"\"\n    }}\n}}\n\npub fn set_mode(q: &WebQuery, mode: WebQueryNetworkMode) Never! {{\n    if q.mode == mode -> return\n    q.mode = mode\n    q.generation = q.generation + 1\n    if q.online || mode != WebQueryNetworkMode.Always -> return\n    if q.status == WebQueryStatus.Offline {{\n        q.status = WebQueryStatus.Stale\n        q.error = \"\"\n    }}\n}}\n\n\npub fn facts(q: WebQuery) -> String Never! {{\n    \"{{{{\\\"key\\\":\\\"{{esc_json(q.key)}}\\\",\\\"status\\\":\\\"{{status_name(q.status)}}\\\",\\\"generation\\\":{{q.generation}},\\\"online\\\":{{bool_json(q.online)}},\\\"subscribers\\\":{{q.subscribers}}}}}}\"\n}}\n\nfn valid_key(key: String) -> Bool {{\n    if key.len() == 0 || key.len() > C_MAX_QUERY_KEY -> return false\n    loop b in key.bytes() {{\n        n :: Int.from_u8(b)\n        if n < 33 || n == 127 -> return false\n    }}\n    true\n}}\n\nfn esc_json(text: String) -> String {{\n    out := [U8]{{}}\n    hex :: \"0123456789abcdef\".bytes()\n    loop b in text.bytes() {{\n        n :: Int.from_u8(b)\n        if n == 34 || n == 92 {{\n            &out.push(U8{{92}})\n            &out.push(b)\n        }} else if n == 8 {{\n            &out.push(U8{{92}})\n            &out.push(U8{{98}})\n        }} else if n == 10 {{\n            &out.push(U8{{92}})\n            &out.push(U8{{110}})\n        }} else if n == 12 {{\n            &out.push(U8{{92}})\n            &out.push(U8{{102}})\n        }} else if n == 13 {{\n            &out.push(U8{{92}})\n            &out.push(U8{{114}})\n        }} else if n == 9 {{\n            &out.push(U8{{92}})\n            &out.push(U8{{116}})\n        }} else if n < 32 || n == 127 {{\n            &out.push(U8{{92}})\n            &out.push(U8{{117}})\n            &out.push(U8{{48}})\n            &out.push(U8{{48}})\n            &out.push(hex[n /% 16])\n            &out.push(hex[n %% 16])\n        }} else {{\n            &out.push(b)\n        }}\n    }}\n    String.from_bytes(out) ?? \"\"\n}}\nfn status_name(s: WebQueryStatus) -> String {{\n    if s == {{\n        WebQueryStatus.Pending -> \"pending\"\n        WebQueryStatus.Fresh -> \"fresh\"\n        WebQueryStatus.Stale -> \"stale\"\n        WebQueryStatus.Fetching -> \"fetching\"\n        WebQueryStatus.Error -> \"error\"\n        else -> \"offline\"\n    }}\n}}\n\nfn bool_json(b: Bool) -> String {{\n    if b -> return \"true\"\n    \"false\"\n}}\n"}
}

fn foundation_embedded_core_source_103() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.web.router", alias: "core_core_web_router", path: "Core/web/router.jet", owner: "", owned_members: [String]{"abort", "cache_show", "cache_state", "collect", "current", "invalidate", "link", "navigate", "new", "not_found", "preload", "route", "route_with_search_codec", "stale"}, source: "// core.web.router — typed routes, navigation, and cache state.\n\nC_MAX_ROUTER_PATH :: 4096\n\nC_MAX_ROUTER_ROUTES :: 1024\nC_MAX_ROUTER_FIELDS :: 256\n\n\n#Error\npub enum WebRouterError {{\n    NotFound\n    Callback\n    Invalid\n}}\n\npub enum WebRouterValueType {{\n    String\n    Int\n    Bool\n    Float\n    JSON\n}}\n\npub enum WebRouterSearchCodec {{\n    Query\n    JSON\n}}\n\npub enum WebRouterCacheStatus {{\n    Fresh\n    Stale\n    Invalidated\n    Collected\n}}\n\npub enum WebNavigationStatus {{\n    Idle\n    Preloading\n    Pending\n    Ready\n    Error\n    Aborted\n}}\n\npub struct WebRouterField {{\n    pub name: String\n    pub value: String\n}}\n\npub struct WebNavigation {{\n    pub path: String\n    pub name: String\n    pub params: [WebRouterField]\n    pub search: [WebRouterField]\n    pub status: WebNavigationStatus\n}}\n\npub struct WebNavigationState {{\n    pub path: String\n    pub status: WebNavigationStatus\n}}\n\npub struct WebRoute {{\n    pub pattern: String\n    pub name: String\n    pub fields: [WebRouterField]\n    pub search_fields: [WebRouterField]\n    pub codec: WebRouterSearchCodec\n    pub response: String\n    pub not_found: Bool\n}}\n\npub struct WebRouter {{\n    pub routes: [WebRoute]\n    pub current: String\n    pub status: WebNavigationStatus\n    pub cache: [String]\n    pub cache_status: [WebRouterCacheStatus]\n}}\n\npub fn new() -> WebRouter Never! {{\n    WebRouter{{routes: [WebRoute]{{}}, current: \"/\", status: WebNavigationStatus.Idle, cache: [String]{{}}, cache_status: [WebRouterCacheStatus]{{}}}}\n}}\n\npub fn route(router: WebRouter, pattern: String, fields: [WebRouterField], search: [WebRouterField], handler: fn(WebNavigation) -> String) -> WebRouter WebRouterError! {{\n    add_route(router, pattern, fields, search, WebRouterSearchCodec.Query, handler, false)\n}}\n\npub fn route_with_search_codec(router: WebRouter, pattern: String, fields: [WebRouterField], search: [WebRouterField], codec: WebRouterSearchCodec, handler: fn(WebNavigation) -> String) -> WebRouter WebRouterError! {{\n    add_route(router, pattern, fields, search, codec, handler, false)\n}}\n\npub fn not_found(router: WebRouter, handler: fn(String) -> String) -> WebRouter WebRouterError! {{\n    loop existing in router.routes {{\n        if existing.pattern == \"*\" -> return Err(WebRouterError.Invalid)\n    }}\n    fields := [WebRouterField]{{}}\n    search := [WebRouterField]{{}}\n    body :: handler(\"*\") ?? return Err(WebRouterError.Callback)\n    route := WebRoute{{pattern: \"*\", name: \"not_found\", fields: fields, search_fields: search, codec: WebRouterSearchCodec.Query, response: body, not_found: true}}\n    routes := copy_routes(router.routes) ?? panic(\"copy_routes failed\")\n    if routes.len() >= C_MAX_ROUTER_ROUTES -> return Err(WebRouterError.Invalid)\n    &routes.push(route)\n    Ok(WebRouter{{routes: routes, current: router.current, status: router.status, cache: router.cache, cache_status: router.cache_status}})\n}}\n\npub fn navigate(router: WebRouter, path: String) -> WebNavigation WebRouterError! {{\n    if path.len() == 0 || path.len() > C_MAX_ROUTER_PATH || !(valid_percent_encoding(path) ?? false) -> return Err(WebRouterError.Invalid)\n    nav :: match_path(router, path) ?? return Err(WebRouterError.NotFound)\n    Ok(nav)\n}}\n\npub fn preload(router: &WebRouter, path: String) -> WebNavigation WebRouterError! {{\n    if path.len() == 0 || path.len() > C_MAX_ROUTER_PATH || !(valid_percent_encoding(path) ?? false) -> return Err(WebRouterError.Invalid)\n    nav := match_path(~router, path) ?? return Err(WebRouterError.NotFound)\n    nav.status = WebNavigationStatus.Preloading\n    router.current = ~path\n    router.status = WebNavigationStatus.Preloading\n    if cache_path(&router, path, WebRouterCacheStatus.Stale) < 0 -> return Err(WebRouterError.Invalid)\n    Ok(nav)\n}}\n\npub fn abort(router: &WebRouter) -> Bool Never! {{\n    if router.status != WebNavigationStatus.Preloading && router.status != WebNavigationStatus.Pending -> return false\n    router.status = WebNavigationStatus.Aborted\n    true\n}}\n\npub fn stale(router: WebRouter, path: String) -> Int Never! {{\n    if cache_state(router, path) == WebRouterCacheStatus.Stale -> return 1\n    0\n}}\n\npub fn invalidate(router: &WebRouter, path: String) -> Int Never! {{\n    idx := cache_index(router.cache, path)\n    if idx < 0 -> return 0\n    _ :: cache_path(&router, path, WebRouterCacheStatus.Invalidated)\n    1\n}}\n\npub fn collect(router: &WebRouter, path: String) -> Int Never! {{\n    idx := cache_index(router.cache, path)\n    if idx < 0 -> return 0\n    _ :: cache_path(&router, path, WebRouterCacheStatus.Collected)\n    1\n}}\n\n\npub fn current(router: WebRouter) -> WebNavigationState Never! {{\n    WebNavigationState{{path: router.current, status: router.status}}\n}}\n\npub fn link(router: WebRouter, name: String, params: [String:String], search: [String:String]) -> String WebRouterError! {{\n    if name.len() == 0 -> return Err(WebRouterError.Invalid)\n    loop r in router.routes {{\n        if r.name == name {{\n            loop field in r.fields {{\n                if !map_has(params, field.name) -> return Err(WebRouterError.Invalid)\n            }}\n            loop key in params.keys() {{\n                if !field_name_allowed(r.fields, key) -> return Err(WebRouterError.Invalid)\n            }}\n            loop key in search.keys() {{\n                if !field_name_allowed(r.search_fields, key) -> return Err(WebRouterError.Invalid)\n            }}\n            out := fill_pattern(r.pattern, params, search, r.codec)\n            if out.len() > C_MAX_ROUTER_PATH -> return Err(WebRouterError.Invalid)\n            return Ok(out)\n        }}\n    }}\n    Err(WebRouterError.NotFound)\n}}\n\npub fn cache_show(router: WebRouter) -> String Never! {{\n    out := \"\"\n    loop i in 0..<router.cache.len() {{\n        if i > 0 -> out = \"{{out}},\"\n        out = \"{{out}}{{router.cache[i]}}\"\n    }}\n    out\n}}\n\npub fn cache_state(router: WebRouter, path: String) -> WebRouterCacheStatus Never! {{\n    idx := cache_index(router.cache, path)\n    if idx < 0 || idx >= router.cache_status.len() -> return WebRouterCacheStatus.Collected\n    router.cache_status[idx]\n}}\n\nfn add_route(router: WebRouter, pattern: String, fields: [WebRouterField], search: [WebRouterField], codec: WebRouterSearchCodec, handler: fn(WebNavigation) -> String, fallback: Bool) -> WebRouter WebRouterError! {{\n    if pattern.len() == 0 || pattern.len() > C_MAX_ROUTER_PATH || !(valid_percent_encoding(pattern) ?? false) -> return Err(WebRouterError.Invalid)\n    if !(route_fields_valid(pattern, fields, search) ?? false) -> return Err(WebRouterError.Invalid)\n    loop existing in router.routes {{\n        if existing.pattern == pattern -> return Err(WebRouterError.Invalid)\n    }}\n    nav := WebNavigation{{path: pattern, name: \"\", params: fields, search: search, status: WebNavigationStatus.Pending}}\n    body :: handler(nav) ?? return Err(WebRouterError.Callback)\n    route := WebRoute{{pattern: pattern, name: pattern, fields: fields, search_fields: search, codec: codec, response: body, not_found: fallback}}\n    routes := copy_routes(router.routes) ?? panic(\"copy_routes failed\")\n    if routes.len() >= C_MAX_ROUTER_ROUTES -> return Err(WebRouterError.Invalid)\n    &routes.push(route)\n    Ok(WebRouter{{routes: routes, current: router.current, status: router.status, cache: router.cache, cache_status: router.cache_status}})\n}}\n\nfn match_path(router: WebRouter, path: String) -> WebNavigation? {{\n    best_score := -1\n    best := WebNavigation{{path: \"\", name: \"\", params: [WebRouterField]{{}}, search: [WebRouterField]{{}}, status: WebNavigationStatus.Idle}}\n    found := false\n    clean := path_only(path)\n    loop r in router.routes {{\n        params :: match_pattern(r.pattern, clean) ?? next\n        search := [WebRouterField]{{}}\n        if !r.not_found {{\n            parsed :: query_fields(path, r.search_fields, r.codec) ?? next\n            search = parsed\n        }}\n        score := route_score(r.pattern)\n        if score > best_score {{\n            best = WebNavigation{{path: path, name: r.name, params: params, search: search, status: WebNavigationStatus.Ready}}\n            best_score = score\n            found = true\n        }}\n    }}\n    if found -> return Val(best)\n    None\n}}\n\nfn match_pattern(pattern: String, path: String) -> [WebRouterField]? {{\n    if pattern == \"*\" -> return Val([WebRouterField]{{}})\n    segs_p :: split_slash(pattern)\n    segs_u :: split_slash(path)\n    wildcard := segs_p.len() > 0 && segs_p[segs_p.len() - 1] == \"*\"\n    if wildcard {{\n        if segs_u.len() < segs_p.len() - 1 -> return None\n    }} else {{\n        if segs_p.len() != segs_u.len() -> return None\n    }}\n    params := [WebRouterField]{{}}\n    limit := segs_p.len()\n    if wildcard -> limit = limit - 1\n    loop i in 0..<limit {{\n        p :: segs_p[i]\n        u :: segs_u[i]\n        if !(valid_percent_encoding(u) ?? false) -> return None\n        raw :: p.bytes()\n        if raw.len() > 0 && raw[0] == (U8{{58}}) {{\n            decoded :: percent_decode(u, false) ?? return None\n            if has_control_text(decoded) -> return None\n            &params.push(WebRouterField{{name: slice_text(p, 1, p.len()), value: decoded}})\n        }} else {{\n            literal :: percent_decode(u, false) ?? return None\n            if has_control_text(literal) || p != literal -> return None\n        }}\n    }}\n    Val(params)\n}}\n\nfn route_score(pattern: String) -> Int Never! {{\n    score := 0\n    segs :: split_slash(pattern)\n    loop s in segs {{\n        raw :: s.bytes()\n        if s == \"*\" -> next\n        if raw.len() > 0 && raw[0] == (U8{{58}}) {{\n            score = score + 100\n        }} else {{\n            score = score + 1000\n        }}\n    }}\n    score + segs.len()\n}}\n\nfn fill_pattern(pattern: String, params: [String:String], search: [String:String], codec: WebRouterSearchCodec) -> String Never! {{\n    if pattern == \"*\" -> return \"/\"\n    segs :: split_slash(pattern)\n    out := \"\"\n    loop s in segs {{\n        out = \"{{out}}/\"\n        raw :: s.bytes()\n        if raw.len() > 0 && raw[0] == (U8{{58}}) {{\n            key :: slice_text(s, 1, s.len())\n            value :: map_get(params, key) ?? \"\"\n            out = \"{{out}}{{percent_encode(value)}}\"\n        }} else {{\n            out = \"{{out}}{{s}}\"\n        }}\n    }}\n    if codec == WebRouterSearchCodec.Query {{\n        first := true\n        loop key in search.keys() {{\n            value :: search.get(key) ?? \"\"\n            if first {{\n                out = \"{{out}}?\"\n                first = false\n            }} else {{\n                out = \"{{out}}&\"\n            }}\n            out = \"{{out}}{{percent_encode(key)}}={{percent_encode(value)}}\"\n        }}\n    }} else if search.len() > 0 {{\n        out = \"{{out}}?{{{{\"\n        first := true\n        loop key in search.keys() {{\n            value :: search.get(key) ?? \"\"\n            if first -> first = false else -> out = \"{{out}},\"\n            out = \"{{out}}\\\"{{json_escape(key)}}\\\":\\\"{{json_escape(value)}}\\\"\"\n        }}\n        out = \"{{out}}}}}}\"\n    }}\n    out\n}}\n\nfn query_fields(path: String, fields: [WebRouterField], codec: WebRouterSearchCodec) -> [WebRouterField]? {{\n    out := [WebRouterField]{{}}\n    query :: query_text(path)\n    if query.len() == 0 -> return Val(out)\n    if codec == WebRouterSearchCodec.JSON -> return parse_json_query(query, fields)\n    if fields.len() == 0 -> return None\n    seen := [String]{{}}\n    loop piece in split_amp(query) {{\n        if piece.len() == 0 -> return None\n        eq :: find_byte(~piece, 61)\n        if eq < 1 || !(valid_percent_encoding(~piece) ?? false) -> return None\n        key :: percent_decode(slice_text(~piece, 0, eq), true) ?? return None\n        value :: percent_decode(slice_text(~piece, eq + 1, piece.len()), true) ?? return None\n        if !valid_router_name(key) || !field_name_allowed(fields, key) || contains_text(seen, key) || has_control_text(value) -> return None\n        &seen.push(~key)\n        &out.push(WebRouterField{{name: key, value: value}})\n    }}\n    Val(out)\n}}\nfn parse_json_query(text: String, fields: [WebRouterField]) -> [WebRouterField]? {{\n    raw := text.bytes()\n    if raw.len() < 2 || raw[0] != (U8{{123}}) || raw[raw.len() - 1] != (U8{{125}}) -> return None\n    inner := slice_text(text, 1, text.len() - 1)\n    if trim_json(inner).len() == 0 -> return Val([WebRouterField]{{}})\n    seen := [String]{{}}\n    out := [WebRouterField]{{}}\n    loop member in split_json_members(inner) {{\n        piece := trim_json(~member)\n        if piece.len() == 0 -> return None\n        colon := find_byte(~piece, 58)\n        if colon <= 0 -> return None\n        key_text := trim_json(slice_text(~piece, 0, colon))\n        value_text := trim_json(slice_text(~piece, colon + 1, piece.len()))\n        key :: json_unquote(key_text) ?? return None\n        value :: json_unquote(value_text) ?? return None\n        if !valid_router_name(~key) || !field_name_allowed(fields, ~key) || contains_text(seen, ~key) || has_control_text(~value) -> return None\n        &seen.push(~key)\n        &out.push(WebRouterField{{name: ~key, value: ~value}})\n    }}\n    Val(out)\n}}\n\nfn split_json_members(text: String) -> [String] Never! {{\n    raw := text.bytes()\n    out := [String]{{}}\n    start := 0\n    quoted := false\n    escaped := false\n    loop i in 0..<raw.len() {{\n        b :: raw[i]\n        if b == (U8{{92}}) && quoted {{\n            escaped = !escaped\n            next\n        }}\n        if b == (U8{{34}}) && !escaped -> quoted = !quoted\n        if b == (U8{{44}}) && !quoted {{\n            &out.push(slice_text(text, start, i))\n            start = i + 1\n        }}\n        escaped = false\n    }}\n    &out.push(slice_text(text, start, raw.len()))\n    out\n}}\n\nfn json_unquote(text: String) -> String? {{\n    raw := text.bytes()\n    if raw.len() < 2 || raw[0] != (U8{{34}}) || raw[raw.len() - 1] != (U8{{34}}) -> return None\n    out := [U8]{{}}\n    i := 1\n    limit := raw.len() - 1\n    loop i < limit {{\n        b :: raw[i]\n        if b == (U8{{92}}) {{\n            if i + 1 >= limit -> return None\n            escaped :: raw[i + 1]\n            if escaped == (U8{{34}}) || escaped == (U8{{92}}) || escaped == (U8{{47}}) {{\n                &out.push(escaped)\n            }} else if escaped == (U8{{110}}) {{\n                &out.push(U8{{10}})\n            }} else if escaped == (U8{{114}}) {{\n                &out.push(U8{{13}})\n            }} else if escaped == (U8{{116}}) {{\n                &out.push(U8{{9}})\n            }} else {{\n                return None\n            }}\n            i = i + 2\n            next\n        }}\n        if b < 32 -> return None\n        &out.push(b)\n        i = i + 1\n    }}\n    decoded :: String.from_bytes(out) ?? return None\n    Val(decoded)\n}}\n\nfn json_escape(text: String) -> String Never! {{\n    out := \"\"\n    loop b in text.bytes() {{\n        if b == (U8{{34}}) {{\n            out = \"{{out}}\\\\\\\"\"\n        }} else if b == (U8{{92}}) {{\n            out = \"{{out}}\\\\\\\\\"\n        }} else if b == (U8{{10}}) {{\n            out = \"{{out}}\\\\n\"\n        }} else if b == (U8{{13}}) {{\n            out = \"{{out}}\\\\r\"\n        }} else if b == (U8{{9}}) {{\n            out = \"{{out}}\\\\t\"\n        }} else {{\n            out = \"{{out}}{{String.from_bytes([U8]{{b}}) ?? \"\"}}\"\n        }}\n    }}\n    out\n}}\n\nfn trim_json(text: String) -> String Never! {{\n    raw := text.bytes()\n    start := 0\n    end := raw.len()\n    loop start < end {{\n        n :: Int.from_u8(raw[start])\n        if n == 32 || n == 9 || n == 10 || n == 13 -> start = start + 1 else -> break\n    }}\n    loop end > start {{\n        n :: Int.from_u8(raw[end - 1])\n        if n == 32 || n == 9 || n == 10 || n == 13 -> end = end - 1 else -> break\n    }}\n    slice_text(text, start, end)\n}}\nfn route_fields_valid(pattern: String, fields: [WebRouterField], search: [WebRouterField]) -> Bool {{\n    if fields.len() > C_MAX_ROUTER_FIELDS || search.len() > C_MAX_ROUTER_FIELDS -> return false\n    path_names := [String]{{}}\n    loop segment in split_slash(pattern) {{\n        raw :: segment.bytes()\n        if raw.len() > 0 && raw[0] == (U8{{58}}) {{\n            name := slice_text(segment, 1, segment.len())\n            if !valid_router_name(name) || contains_text(path_names, name) -> return false\n            &path_names.push(~name)\n        }}\n    }}\n    seen_fields := [String]{{}}\n    loop field in fields {{\n        if !valid_router_name(field.name) || contains_text(seen_fields, field.name) || !contains_text(path_names, field.name) {{\n            return false\n        }}\n        &seen_fields.push(field.name)\n    }}\n    if seen_fields.len() != path_names.len() -> return false\n    seen_search := [String]{{}}\n    loop field in search {{\n        if !valid_router_name(field.name)\n            || contains_text(seen_search, field.name)\n            || contains_text(path_names, field.name) {{\n            return false\n        }}\n        &seen_search.push(field.name)\n    }}\n    true\n}}\n\nfn valid_router_name(name: String) -> Bool Never! {{\n    raw := name.bytes()\n    if raw.len() == 0 || raw.len() > 128 -> return false\n    loop i in 0..<raw.len() {{\n        b :: Int.from_u8(raw[i])\n        if i == 0 && !((b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95) -> return false\n        if !((b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 95 || b == 45) -> return false\n    }}\n    true\n}}\n\nfn contains_text(items: [String], value: String) -> Bool Never! {{\n    loop item in items {{\n        if item == value -> return true\n    }}\n    false\n}}\nfn has_control_text(text: String) -> Bool Never! {{\n    loop b in text.bytes() {{\n        n :: Int.from_u8(b)\n        if n < 32 || n == 127 -> return true\n    }}\n    false\n}}\n\n\nfn valid_percent_encoding(text: String) -> Bool Never! {{\n    raw := text.bytes()\n    i := 0\n    loop i < raw.len() {{\n        if raw[i] == (U8{{37}}) {{\n            if i + 2 >= raw.len() || hex_value(raw[i + 1]) < 0 || hex_value(raw[i + 2]) < 0 -> return false\n            i = i + 3\n        }} else {{\n            i = i + 1\n        }}\n    }}\n    true\n}}\n\n\nfn field_name_allowed(fields: [WebRouterField], name: String) -> Bool Never! {{\n    loop field in fields {{\n        if field.name == name -> return true\n    }}\n    false\n}}\n\nfn cache_path(router: &WebRouter, path: String, state: WebRouterCacheStatus) -> Int Never! {{\n    if path.len() == 0 || path.len() > C_MAX_ROUTER_PATH || !valid_percent_encoding(path) -> return -1\n    idx := cache_index(router.cache, path)\n    if idx >= 0 {{\n        if idx < router.cache_status.len() -> router.cache_status[idx] = state\n        return idx\n    }}\n    if router.cache.len() >= 256 -> return -1\n    &router.cache.push(~path)\n    &router.cache_status.push(state)\n    router.cache.len() - 1\n}}\n\nfn percent_decode(text: String, plus_as_space: Bool) -> String? {{\n    out := [U8]{{}}\n    raw := text.bytes()\n    i := 0\n    loop {{\n        if i >= raw.len() {{\n            decoded :: String.from_bytes(out) ?? return None\n            return Val(decoded)\n        }}\n        if raw[i] == (U8{{37}}) && i + 2 < raw.len() {{\n            hi := hex_value(raw[i + 1])\n            lo := hex_value(raw[i + 2])\n            if hi >= 0 && lo >= 0 {{\n                &out.push(U8{{hi * 16 + lo}})\n                i = i + 3\n                next\n            }}\n        }}\n        if raw[i] == (U8{{43}}) && plus_as_space -> &out.push(U8{{32}}) else -> &out.push(raw[i])\n        i = i + 1\n    }}\n}}\n\nfn hex_value(b: U8) -> Int Never! {{\n    n :: Int.from_u8(b)\n    if n >= 48 && n <= 57 -> return n - 48\n    if n >= 65 && n <= 70 -> return n - 55\n    if n >= 97 && n <= 102 -> return n - 87\n    return -1\n}}\n\nfn copy_routes(routes: [WebRoute]) -> [WebRoute] {{\n    out := [WebRoute]{{}}\n    loop r in routes -> &out.push(r)\n    return out\n}}\n\nfn cache_index(xs: [String], value: String) -> Int Never! {{\n    loop i in 0..<xs.len() {{\n        if xs[i] == value -> return i\n    }}\n    return -1\n}}\n\nfn split_slash(text: String) -> [String] Never! {{\n    raw :: text.bytes()\n    out := [String]{{}}\n    cur := [U8]{{}}\n    loop i in 0..<raw.len() {{\n        if raw[i] == (U8{{47}}) {{\n            if cur.len() > 0 {{\n                &out.push(String.from_bytes(cur) ?? \"\")\n                cur = [U8]{{}}\n            }}\n        }} else {{\n            &cur.push(raw[i])\n        }}\n    }}\n    if cur.len() > 0 -> &out.push(String.from_bytes(cur) ?? \"\")\n    out\n}}\n\nfn path_only(path: String) -> String Never! {{\n    raw :: path.bytes()\n    end := raw.len()\n    loop i in 0..<raw.len() {{\n        if raw[i] == (U8{{63}}) || raw[i] == (U8{{35}}) {{\n            end = i\n            break\n        }}\n    }}\n    value := slice_text(path, 0, end)\n    if value.len() == 0 -> return \"/\"\n    value\n}}\n\nfn query_text(path: String) -> String Never! {{\n    raw :: path.bytes()\n    start := -1\n    loop i in 0..<raw.len() {{\n        if raw[i] == (U8{{63}}) {{\n            start = i + 1\n            break\n        }}\n    }}\n    if start < 0 -> return \"\"\n    end := raw.len()\n    loop i in start..<raw.len() {{\n        if raw[i] == (U8{{35}}) {{\n            end = i\n            break\n        }}\n    }}\n    slice_text(path, start, end)\n}}\n\nfn split_amp(text: String) -> [String] Never! {{\n    raw :: text.bytes()\n    out := [String]{{}}\n    start := 0\n    loop i in 0..<raw.len() {{\n        if raw[i] == (U8{{38}}) {{\n            &out.push(slice_text(text, start, i))\n            start = i + 1\n        }}\n    }}\n    if start <= raw.len() -> &out.push(slice_text(text, start, raw.len()))\n    out\n}}\n\nfn find_byte(text: String, want: Int) -> Int Never! {{\n    raw :: text.bytes()\n    loop i in 0..<raw.len() {{\n        if raw[i] == (U8{{want}}) -> return i\n    }}\n    -1\n}}\n\nfn map_get(m: [String:String], key: String) -> String? {{ m.get(key) }}\n\nfn slice_text(text: String, start: Int, end: Int) -> String Never! {{\n    raw :: text.bytes()\n    out := [U8]{{}}\n    i := start\n    loop {{\n        if i < 0 || i >= end || i >= raw.len() -> return String.from_bytes(out) ?? \"\"\n        &out.push(raw[i])\n        i = i + 1\n    }}\n}}\n\nfn map_has(m: [String:String], key: String) -> Bool Never! {{\n    m.get(key) != None\n}}\nfn percent_encode(text: String) -> String Never! {{\n    out := \"\"\n    loop b in text.bytes() {{\n        n :: Int.from_u8(b)\n        if (n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || n == 45 || n == 46 || n == 95 || n == 126 {{\n            ch := String.from_bytes([U8]{{b}}) ?? \"\"\n            out = \"{{out}}{{ch}}\"\n        }} else {{\n            out = \"{{out}}%{{hex_digit(n /% 16)}}{{hex_digit(n %% 16)}}\"\n        }}\n    }}\n    out\n}}\n\nfn hex_digit(n: Int) -> String Never! {{\n    slice_text(\"0123456789ABCDEF\", n, n + 1)\n}}\n"}
}

fn foundation_embedded_core_source_104() -> FoundationCoreSource Never! {
    FoundationCoreSource{module_name: "core.web.storage", alias: "core_web_storage", path: "Core/web/storage.jet", owner: "", owned_members: [String]{"local", "session", "kind_local", "kind_session"}, source: "package {{\n    name: \"core.web.storage\"\n    version: \"0.0.1\"\n    edition: \"2026\"\n    description: \"Portable browser storage namespaces.\"\n    license: \"MIT\"\n    outputs: {{\n        storage: .Library{{ entry: storage }}\n    }}\n}}\n\n// core.web.storage — web storage namespaces.\n\n\npub struct WebStorage {{\n    pub ns: String\n}}\n\npub fn local() -> WebStorage Never! {{ {{ns: \"local\"}} }}\n\npub fn session() -> WebStorage Never! {{ {{ns: \"session\"}} }}\n\npub fn kind_local() -> String Never! {{ \"local\" }}\n\npub fn kind_session() -> String Never! {{ \"session\" }}\n"}
