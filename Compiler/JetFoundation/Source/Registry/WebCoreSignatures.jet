// Source projection of CheckerCoreLib::web_fixed_sig. Keep this table exact:
// it is independent from CoreCallRecord's erased arity/access metadata and
// preserves the concrete argument and result types used by typed Core calls.

fn core_web_type_parameter(name: String) -> CoreCallTypeParameter {
    CoreCallTypeParameter{name: name, bounds: [String]{}, constraint: CoreCallTypeConstraint.Any}
}

fn core_web_type_parameters(names: [String]) -> [CoreCallTypeParameter] {
    result := [CoreCallTypeParameter]{}
    loop name in names -> result.push(core_web_type_parameter(name))
    result
}

fn core_web_parameter(access: AccessConvention, ty: Type) -> CoreCallTypedParameter {
    CoreCallTypedParameter{
        name: "",
        label: "",
        zone: ParamZone.PositionalOnly,
        access: access,
        ty: ty,
        default: None,
    }
}

fn core_web_parameters(types: [Type], moved_index: ?Int) -> [CoreCallTypedParameter] {
    result := [CoreCallTypedParameter]{}
    loop (index, ty) in types {
        access := if moved_index == (Val(index)) -> AccessConvention.Move else -> AccessConvention.Read
        result.push(core_web_parameter(access, ty))
    }
    result
}

fn core_web_typed_signature(module_name: String, member: String, parameter_types: [Type], return_type: Type, type_parameters: [String], moved_index: ?Int) -> CoreTypedCallSignature {
    parameters := core_web_parameters(parameter_types, moved_index)
    CoreTypedCallSignature{
        module_name: module_name,
        member: member,
        min_arity: parameters.len(),
        max_arity: parameters.len(),
        parameters: parameters,
        return_type: Val(return_type),
        type_parameters: core_web_type_parameters(type_parameters),
        result_rule: CoreCallResultRule.Declared,
    }
}

fn core_web_named(name: String) -> Type {
    Type.Named(name)
}

fn core_web_list(inner: Type) -> Type {
    Type.List(inner)
}

fn core_web_map_string() -> Type {
    Type.Map(Type.String, None, Type.String)
}

fn core_web_fn0(result: Type) -> Type {
    Type.Fn([Type]{}, Val(result), None, None, None, None)
}

fn core_web_fn1(parameter: Type, result: Type) -> Type {
    Type.Fn([Type]{parameter}, Val(result), None, None, None, None)
}

fn core_web_apply(name: String, argument: Type) -> Type {
    Type.Apply(name, [Type]{argument})
}

fn core_web_result_error(ok: Type, error: String) -> Type {
    Type.Result(ok, core_web_named(error))
}

fn core_web_unit() -> Type {
    core_web_named("Unit")
}

// Mirrors every arm in native web_fixed_sig, including the two data.sketch
// entries that are physically owned by that native table.
pub fn core_web_fixed_signature(module_name: String, member: String) -> ?CoreTypedCallSignature {
    if module_name == "core.data.sketch" {
        if member == "empty" -> return Val(core_web_typed_signature(module_name, member, [Type]{}, Type.String, [String]{}, None))
        if member == "merge" -> return Val(core_web_typed_signature(module_name, member, [Type]{Type.String, Type.String}, Type.String, [String]{}, None))
        return None
    }
    if module_name == "core.web.storage" {
        if member == "local" || member == "session" -> return Val(core_web_typed_signature(module_name, member, [Type]{}, core_web_named("WebStorage"), [String]{}, None))
        if member == "kind_local" || member == "kind_session" -> return Val(core_web_typed_signature(module_name, member, [Type]{}, Type.String, [String]{}, None))
        return None
