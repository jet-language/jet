    if module_name == "core.web.virtual" {
        t := core_web_named("T")
        window := core_web_named("WebVirtualWindow")
        plan := core_web_named("WebVirtualPlan")
        viewport := core_web_named("WebVirtualPlanViewport")
        if member == "window" -> return Val(core_web_typed_signature(module_name, member, [Type]{Type.Int, Type.Int, Type.Int, Type.Int, Type.Int}, window, [String]{}, None))
