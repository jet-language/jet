        if member == "slice" -> return Val(core_web_typed_signature(module_name, member, [Type]{core_web_list(t), window}, core_web_list(t), [String]{"T"}, None))
        if member == "indices" -> return Val(core_web_typed_signature(module_name, member, [Type]{window}, core_web_list(Type.Int), [String]{}, None))
        if member == "plan" -> return Val(core_web_typed_signature(module_name, member, [Type]{Type.Int, Type.Int, Type.Int, Type.Int, Type.Int, Type.Int}, plan, [String]{}, None))
        if member == "plan_measured" -> return Val(core_web_typed_signature(module_name, member, [Type]{
            Type.Int, Type.Int, Type.Int, Type.Int, Type.Int, Type.Int,
            core_web_list(Type.Tuple([TypeTupleField]{
                TypeTupleField{name: "index", ty: Type.Int},
                TypeTupleField{name: "size", ty: Type.Int},
