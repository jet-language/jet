        }, plan, [String]{}, None))
        if member == "plan_from_sizes" -> return Val(core_web_typed_signature(module_name, member, [Type]{Type.Int, Type.Int, Type.Int, Type.Int, Type.Int, Type.Int, core_web_list(Type.Int)}, plan, [String]{}, None))
        if member == "plan_measure" -> return Val(core_web_typed_signature(module_name, member, [Type]{plan, Type.Int, Type.Int}, plan, [String]{}, None))
        if member == "plan_slice" -> return Val(core_web_typed_signature(module_name, member, [Type]{core_web_list(t), plan}, core_web_list(t), [String]{"T"}, None))
        if member == "plan_indices" -> return Val(core_web_typed_signature(module_name, member, [Type]{plan}, core_web_list(Type.Int), [String]{}, None))
        if member == "plan_viewport" -> return Val(core_web_typed_signature(module_name, member, [Type]{plan}, viewport, [String]{}, None))
        if member == "plan_viewport_state" -> return Val(core_web_typed_signature(module_name, member, [Type]{viewport}, plan, [String]{}, None))
        if member == "plan_scroll_to" -> return Val(core_web_typed_signature(module_name, member, [Type]{viewport, Type.Int}, core_web_unit(), [String]{}, None))
        if member == "plan_resize" -> return Val(core_web_typed_signature(module_name, member, [Type]{viewport, Type.Int, Type.Int}, core_web_unit(), [String]{}, None))
        if member == "plan_viewport_measure" -> return Val(core_web_typed_signature(module_name, member, [Type]{viewport, Type.Int, Type.Int}, core_web_unit(), [String]{}, None))
        return None
    }
    if module_name == "core.web.store" {
        t := core_web_named("T")
        u := core_web_named("U")
        store := core_web_apply("WebStore", t)
        transaction := core_web_apply("WebStoreTransaction", t)
        patch := core_web_apply("WebStorePatch", t)
        if member == "value" -> return Val(core_web_typed_signature(module_name, member, [Type]{store}, t, [String]{"T"}, None))
        if member == "signal" || member == "state_signal" -> return Val(core_web_typed_signature(module_name, member, [Type]{store}, Type.String, [String]{"T"}, None))
        if member == "new" -> return Val(core_web_typed_signature(module_name, member, [Type]{Type.String, t}, store, [String]{"T"}, None))
        if member == "with_history" -> return Val(core_web_typed_signature(module_name, member, [Type]{Type.String, t, Type.Int}, store, [String]{"T"}, None))
        if member == "transaction" || member == "update" || member == "batch" -> return Val(core_web_typed_signature(module_name, member, [Type]{store, Type.String, core_web_list(Type.String), core_web_fn1(t, core_web_unit())}, transaction, [String]{"T"}, None))
        if member == "set" || member == "set_state" -> return Val(core_web_typed_signature(module_name, member, [Type]{store, t}, transaction, [String]{"T"}, None))
        if member == "optimistic" || member == "patch" -> return Val(core_web_typed_signature(module_name, member, [Type]{store, Type.String, core_web_list(Type.String), core_web_fn1(t, core_web_unit())}, patch, [String]{"T"}, None))
        if member == "patch_generation" -> return Val(core_web_typed_signature(module_name, member, [Type]{patch}, Type.Int, [String]{"T"}, None))
        if member == "patch_transaction" -> return Val(core_web_typed_signature(module_name, member, [Type]{patch}, transaction, [String]{"T"}, None))
        if member == "patch_active" -> return Val(core_web_typed_signature(module_name, member, [Type]{patch}, Type.Bool, [String]{"T"}, None))
        if member == "patch_commit" -> return Val(core_web_typed_signature(module_name, member, [Type]{patch}, transaction, [String]{"T"}, Val(0)))
        if member == "patch_rollback" -> return Val(core_web_typed_signature(module_name, member, [Type]{patch}, Type.Option(t), [String]{"T"}, Val(0)))
        if member == "back" || member == "forward" || member == "restore" -> return Val(core_web_typed_signature(module_name, member, [Type]{store}, Type.Option(t), [String]{"T"}, None))
        if member == "jump" || member == "scrub" -> return Val(core_web_typed_signature(module_name, member, [Type]{store, Type.Int}, Type.Option(t), [String]{"T"}, None))
        if member == "history" -> return Val(core_web_typed_signature(module_name, member, [Type]{store}, core_web_list(transaction), [String]{"T"}, None))
        if member == "history_at" -> return Val(core_web_typed_signature(module_name, member, [Type]{store, Type.Int}, Type.Option(transaction), [String]{"T"}, None))
        if member == "events" -> return Val(core_web_typed_signature(module_name, member, [Type]{store}, core_web_list(core_web_named("WebStoreEvent")), [String]{"T"}, None))
        if member == "events_since" -> return Val(core_web_typed_signature(module_name, member, [Type]{store, Type.Int}, core_web_list(core_web_named("WebStoreEvent")), [String]{"T"}, None))
        if member == "clear_history" -> return Val(core_web_typed_signature(module_name, member, [Type]{store}, core_web_unit(), [String]{"T"}, None))
        if member == "set_history_limit" -> return Val(core_web_typed_signature(module_name, member, [Type]{store, Type.Int}, core_web_unit(), [String]{"T"}, None))
        if member == "history_enabled" -> return Val(core_web_typed_signature(module_name, member, [Type]{store}, Type.Bool, [String]{"T"}, None))
        if member == "history_limit" || member == "cursor" || member == "current_generation" -> return Val(core_web_typed_signature(module_name, member, [Type]{store}, Type.Int, [String]{"T"}, None))
        if member == "subscribe" -> return Val(core_web_typed_signature(module_name, member, [Type]{store, core_web_fn1(t, core_web_unit())}, core_web_named("WebStoreSubscription"), [String]{"T"}, None))
        if member == "subscription_unsubscribe" -> return Val(core_web_typed_signature(module_name, member, [Type]{core_web_named("WebStoreSubscription")}, core_web_unit(), [String]{}, None))
        if member == "subscription_active" -> return Val(core_web_typed_signature(module_name, member, [Type]{core_web_named("WebStoreSubscription")}, Type.Bool, [String]{}, None))
        if member == "subscribe_selector" -> return Val(core_web_typed_signature(module_name, member, [Type]{store, core_web_fn1(t, u), core_web_fn1(u, core_web_unit())}, core_web_named("WebStoreSubscription"), [String]{"T", "U"}, None))
        if member == "derived" || member == "selector" -> return Val(core_web_typed_signature(module_name, member, [Type]{store, core_web_fn1(t, u)}, core_web_apply("Derived", u), [String]{"T", "U"}, None))
        if member == "inspect" -> return Val(core_web_typed_signature(module_name, member, [Type]{store}, core_web_named("WebStoreInspection"), [String]{"T"}, None))
        if member == "facts_json" || member == "event_json" -> return Val(core_web_typed_signature(module_name, member, [Type]{store}, Type.String, [String]{"T"}, None))
        return None
    }
    None
}
