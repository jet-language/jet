// Source projection of CheckerCoreLib::web_fixed_sig. Keep this table exact:
// it is independent from CoreCallRecord's erased arity/access metadata and
// preserves the concrete argument and result types used by typed Core calls.
// It mirrors every arm in native web_fixed_sig, including the two data.sketch
// entries that are physically owned by that native table. Rows use the
// grammar of `core_sig_row_lookup` (CorePlatformSignatures.jet).

pub fn core_web_fixed_signature(module_name: String, member: String) -> CoreTypedCallSignature? {
    rows :: """
core.data.sketch empty - String
core.data.sketch merge String,String String
core.web.storage local|session - WebStorage
core.web.storage kind_local|kind_session - String
