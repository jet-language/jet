// The Core ABI rows: Core.jet's dispatcher rows in order, then
// CORE_CALL_EXTENSIONS in its order. Lookups take the first row per
// core_call_key and IR canonicalization refuses a duplicate, so an extension
// row may not repeat an earlier key; the build stops when one does.
CORE_CALLS: comptime { core_call_rows(CORE_DECLARATIONS, CORE_CALL_EXTENSIONS) }

// Module/member/type names follow Core.jet module declaration order.
CORE_MODULE_EXPORTS: comptime { core_module_export_rows(CORE_DECLARATIONS) }

core_module_export_rows: fn(declared: CoreDeclarations) -> [CoreModuleExportNames] Never! {
    rows := [CoreModuleExportNames]{}
    loop entry in declared.modules {
        types: loop leaf in entry.types -> leaf.name.copy()
        rows.push(CoreModuleExportNames{module_name: entry.name.copy(), members: entry.members.copy(), type_exports: types})
    }
    rows
}

core_call_rows: fn(declared: CoreDeclarations, extensions: [CoreCallRecord]) -> [CoreCallRecord] {
    rows := [CoreCallRecord]{}
    owners := [String: String]{}
    loop row in declared.dispatchers {
        owners[core_call_key(row.record)] = "Core.jet"
        rows.push(row.record.copy())
    }
    loop row in extensions {
        key: core_call_key(row)
        if owners.get(key) == .Val(owner) -> panic("{CORE_CALL_EXTENSIONS_PATH}: row `{key}` repeats a {owner} row; drop the extension row")
        owners[key] = CORE_CALL_EXTENSIONS_PATH
        rows.push(row.copy())
    }
    rows
}
