pub fn diagnostic_registry_with_source_derived_suggestion(diagnostic: ^Diagnostic, span: Span, new_text: String) -> Diagnostic {
    updated := diagnostic
    if updated.edit != None -> return panic("updated `{updated.code}` already carries an edit")
    row :: diagnostic_registry_row(updated.code) ?? return panic("updated `{updated.code}` has no generated Source registry row")
    if row.no_fix_reason == None -> return panic("updated `{updated.code}` has no explanatory row reason to replace")
    updated.no_fix_reason = None
    updated.applicability = Val(DiagnosticFixApplicability.Suggested)
    updated.safety = Val(DiagnosticFixSafety.NeedsReview)
    updated.edit = Val(TextEdit{span: span, new_text: new_text})
    updated
}

pub fn diagnostic_registry_with_alternative_edit(diagnostic: ^Diagnostic, edit: TextEdit) -> Diagnostic {
    updated := diagnostic
    if updated.no_fix_reason != None -> return panic("updated `{updated.code}` cannot carry an edit and no-fix reason")
    if updated.edit == None || updated.applicability == None || updated.safety == None -> return panic("updated `{updated.code}` needs a graded primary edit before an alternative")
    if updated.structured == None {
        updated.structured = Val(DiagnosticStructured.SuggestedEdits{edits: [TextEdit]{edit}})
        return updated
    }
    structured :: updated.structured ?? return updated
    if structured == {
        .SuggestedEdits(edits) -> {
            &edits.push(edit)
            updated.structured = Val(DiagnosticStructured.SuggestedEdits{edits: edits})
            updated
        }
        else -> panic("updated `{updated.code}` cannot carry source edit alternatives with another structured payload")
    }
}

