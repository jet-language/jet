use diagnostic_unicode: core.text

// A retired row is never reported; it stays so `jet explain` reads old logs.
DiagnosticRegistryStatus: enum {
    Active,
    Reserved,
    Retired,
}

// Which commands a row's report fails: a copy of Core's `DiagnosticTier`
// (Core/Prelude/Prelude.jet is its one home; the closed-list mirror ledger
// holds the copy to the home's members in order). A compiler row may state
// one as its `tier` constant (`.Error` when it states
// none). On an `.Error` row a report is an error when its severity is, and a
// lint is advice unless a package denies it. A `.Tidy` row is a lint about
// untidy code that still runs: `jet check` and `jet build` list it and fail,
// while `jet run`, `jet dev` and `jet test` never stop for it and show it
// only under `--verbose` (diagnostic_is_tidy). A `.Report` row is a lint
// whose finding is advice a reader weighs: `jet lint <file>` lists it and
// fails nothing, and no other command prints it (diagnostic_is_report,
// JetDriverCompileResult.advice).
DiagnosticTier: enum {
    Error,
    Tidy,
    Report,
}

DiagnosticRegistryFix: enum {
    SourceEdit,
    SuggestedSourceEdit,
    CryptoMisuse,
    Replace(from: String, to: String),
    Remove(text: String),
    GeneratedMarkerGroup,
    GeneratedMissingArms,
    GeneratedScriptRun,
    GeneratedRedundantTailReturn,
}

// This is a generated view of the Diagnostic impls in
// Compiler/Prelude/Diagnostics.jet; Tools/Agent/DiagnosticRows.jet renders
// DiagnosticRows.jet from them. This file owns the Source-side projection and
// canonical construction rules. Human wording at a raise site remains
// authored input, while moment, severity, row edits, grades, and no-fix facts
// come from the generated row. `name` is the diagnostic's type name.
DiagnosticRegistryRow: struct {
    code: String,
    name: String,
    lint_name: String?,
    stage: String,
    severity: Int,
    tier: DiagnosticTier,
    moment: DiagnosticMoment,
    status: DiagnosticRegistryStatus,
    meaning: String,
    what: String,
    why: String,
    fix: String,
    detail: Bool,
    structured_fix: DiagnosticRegistryFix?,
    fix_safety: DiagnosticFixSafety?,
    no_fix_reason: DiagnosticNoFixReason?,

    has_stage: fn(self, stage: String) -> Bool Never! {
        loop component in self.stage.split("/") {
            if component == stage -> return true
        }
        false
    }
}

// The closed set of values a row's stage column may hold. A stage names the
// part of the toolchain that reports the row; a joined value such as
// `parse/sema` names every part that does. Status is its own column.
DIAGNOSTIC_STAGES: [String]{
    "build",
    "comptime",
    "compile",
    "driver",
    "jet",
    "jetpack",
    "lex",
    "lex/sema",
    "load",
    "parse",
    "parse/sema",
    "repl",
    "runtime",
    "sema",
    "sema/build",
    "sema/jetpack",
    "sema/runtime",
    "tooling",
}

diagnostic_stage_is_registered: fn(stage: String) -> Bool Never! {
    loop known in DIAGNOSTIC_STAGES {
        if known == stage -> return true
    }
    false
}

diagnostic_byte_at: fn(source: [U8], index: Int) -> Int Never! {
    if index < 0 || index >= source.len() -> return -1
    Int{source[index]}
}

diagnostic_utf8_width: fn(source: [U8], index: Int) -> Int Never! {
    width := foundation_utf8_lead_width(diagnostic_byte_at(source, index))
    if width <= 1 -> return width
    width = foundation_utf8_width(width, diagnostic_byte_at(source, index + 1))
    if width <= 2 -> return width
    width = foundation_utf8_width(width, diagnostic_byte_at(source, index + 2))
    if width <= 3 -> return width
    foundation_utf8_width(width, diagnostic_byte_at(source, index + 3))
}

diagnostic_scalar_at: fn(source: [U8], index: Int) -> String Never! {
    width: diagnostic_utf8_width(source, index)
    if width <= 0 -> return ""
    out := [U8]{}
    loop offset in 0..<width {
        if index + offset >= source.len() -> break
        out.push(source[index + offset])
    }
    String.from_bytes(out) ?? ""
}

diagnostic_is_whitespace_at: fn(source: [U8], index: Int) -> Bool Never! {
    value: diagnostic_byte_at(source, index)
    if {
        value < 0 -> false
        value < 128 -> value == 9 || value == 10 || value == 11 || value == 12 || value == 13 || value == 32
        else -> diagnostic_unicode.is_whitespace(diagnostic_scalar_at(source, index))
    }
}

diagnostic_is_sentence_digit: fn(value: Int) -> Bool Never! { value >= 48 && value <= 57 }

diagnostic_sentence_case_line: fn(value: String) -> String Never! {
    bytes := value.bytes()
    first := -1
    token_len := 0
    is_fn := false
    preserve := false
    period := false
    finished := false
    index := 0
    loop index < bytes.len() {
        width: diagnostic_utf8_width(bytes, index)
        if finished {
            index += width
            next
        }
        character: diagnostic_byte_at(bytes, index)
        if first < 0 {
            if diagnostic_is_whitespace_at(bytes, index) || character == 42 || character == 126 || character == 95 {
                index += width
                next
            }
            if character < 97 || character > 122 {
                finished = true
                index += width
                next
            }
            first = index
            token_len = 1
            is_fn = character == 102
            index += width
            next
        }
        if diagnostic_is_whitespace_at(bytes, index) || character == 44 || character == 59 || character == 58 || character == 40 || character == 41 || character == 91 || character == 93 || character == 33 {
            // A call chain (`relay → inc writes …`) opens with a function
            // name, which keeps its own case.
            if character == 32 && diagnostic_byte_at(bytes, index + 1) == 226 && diagnostic_byte_at(bytes, index + 2) == 134 && diagnostic_byte_at(bytes, index + 3) == 146 {
                preserve = true
            }
            finished = true
            index += width
            next
        }
        if period -> preserve = true
        period = character == 46
        if period {
            index += width
            next
        }
        token_len += 1
        if token_len != 2 || character != 110 -> is_fn = false
        if diagnostic_is_sentence_digit(character) || character == 95 || character == 47 || character == 92 || character == 64 || character == 35 {
            preserve = true
        }
        index += width
    }
    if first >= 0 && !preserve && !(is_fn && token_len == 2) {
        bytes[first] = U8{diagnostic_byte_at(bytes, first) - 32}
    }
    String.from_bytes(bytes) ?? value
}

// One type identity in diagnostic prose: `module:<len>:<package>:<path>.Name`
// (the driver's key for a source type) or `<corelib>/<module>.Name` (a Core
// type). `start..end` is its whole spelling and `name` the name the source
// wrote, after the last `.`. `head` is the name's first identifier, which a
// clash compares, and `qualifier` the module as the user writes it: `crypto`
// for `<corelib>/core.crypto.Secret`, the file stem for a source module.
DiagnosticIdentity: struct {
    start: Int,
    end: Int,
    name: String,
    head: String,
    qualifier: String,
}

// A message names a type by its plain name. Only when two different types in
// one message share that name does each print as `module.Name`.
diagnostic_display_identities: fn(value: String, clashes: [String]) -> String Never! {
    bytes: value.bytes()
    identities: diagnostic_identities_in(bytes)
    // copy: the caller keeps its text; the displayed line is a new value.
    if identities.len() == 0 -> return value.copy()
    out := [U8]{}
    index := 0
    loop identity in identities {
        loop index < identity.start {
            out.push(bytes[index])
            index += 1
        }
        if clashes.contains(identity.head) && identity.qualifier != "" {
            loop byte in identity.qualifier.bytes() -> out.push(byte)
            loop byte in ".".bytes() -> out.push(byte)
        }
        loop byte in identity.name.bytes() -> out.push(byte)
        index = identity.end
    }
    loop index < bytes.len() {
        out.push(bytes[index])
        index += 1
    }
    String.from_bytes(out) ?? value.copy()
}

// The names in `context` (a whole message) that two different types share:
// two identities from different modules, or an identity and a type the
// message already prints by its plain name.
diagnostic_identity_clashes: fn(context: [U8]) -> [String] Never! {
    identities: diagnostic_identities_in(context)
    clashes := [String]{}
    loop identity in identities {
        if clashes.contains(identity.head) -> next
        clash := diagnostic_identity_plain_use(context, identities, identity.head)
        loop other in identities {
            if other.head == identity.head && other.qualifier != identity.qualifier -> clash = true
        }
        if clash -> clashes.push(identity.head.copy())
    }
    clashes
}

diagnostic_identities_in: fn(bytes: [U8]) -> [DiagnosticIdentity] Never! {
    found := [DiagnosticIdentity]{}
    index := 0
    loop index < bytes.len() {
        end: diagnostic_identity_push(bytes, index, found)
        index = if end > index -> end else -> index + 1
    }
    found
}

// Reads the identity starting at `index` into `found` and returns its end, or
// -1 when no identity starts there. A module identity's package part is
// skipped by its length prefix, since it may hold `:`; its path is a `.jet`
// file, so the name starts after the first `.jet.` in the path's last
// segment. A Core identity's module is its longest Core-module prefix
// (core_path_module), or all before its last `.` when Core has none.
diagnostic_identity_push: fn(bytes: [U8], index: Int, found: &[DiagnosticIdentity]) -> Int Never! {
    // Both forms start with `m` or `<`; every other byte position returns
    // before any prefix bytes are built.
    first: diagnostic_byte_at(bytes, index)
    if first != 109 && first != 60 -> return -1
    module_form: diagnostic_bytes_at(bytes, index, "module:")
    if !module_form && !diagnostic_bytes_at(bytes, index, "<corelib>/") -> return -1
    path_start := index + 10
    if module_form {
        cursor := index + 7
        length := 0
        digits := 0
        loop diagnostic_is_sentence_digit(diagnostic_byte_at(bytes, cursor)) {
            length = length * 10 + diagnostic_byte_at(bytes, cursor) - 48
            digits += 1
            cursor += 1
        }
        if digits == 0 || diagnostic_byte_at(bytes, cursor) != 58 -> return -1
        cursor += 1 + length
        if diagnostic_byte_at(bytes, cursor) != 58 -> return -1
        path_start = cursor + 1
    }
    end := path_start
    loop end < bytes.len() && !diagnostic_identity_ends(diagnostic_byte_at(bytes, end)) -> end += 1
    leaf := -1
    qualifier := ""
    if module_form {
        stem_start := path_start
        loop at in path_start..<end {
            if diagnostic_byte_at(bytes, at) == 47 -> stem_start = at + 1
        }
        at := stem_start
        loop leaf < 0 && at + 5 < end {
            if diagnostic_bytes_at(bytes, at, ".jet.") -> leaf = at + 5
            at += 1
        }
        if leaf < 0 -> return -1
        qualifier = foundation_byte_text(bytes, stem_start, leaf - 5)
    } else {
        path: foundation_byte_text(bytes, path_start, end)
        // Not a Core module: the module is the path before its last `.`.
        module_name := core_path_module(path) ?? ""
        if module_name == "" {
            dot := end - 1
            loop dot >= path_start && diagnostic_byte_at(bytes, dot) != 46 -> dot -= 1
            if dot < path_start -> return -1
            module_name = foundation_byte_text(bytes, path_start, dot)
        }
        module_end: path_start + module_name.count_bytes()
        leaf = module_end + 1
        qualifier_start := module_end
        loop qualifier_start > path_start && diagnostic_byte_at(bytes, qualifier_start - 1) != 46 {
            qualifier_start -= 1
        }
        qualifier = foundation_byte_text(bytes, qualifier_start, module_end)
    }
    if leaf >= end -> return -1
    head_end := leaf
    loop head_end < end && diagnostic_byte_at(bytes, head_end) != 46 -> head_end += 1
    found.push(DiagnosticIdentity{start: index, end: end, name: foundation_byte_text(bytes, leaf, end), head: foundation_byte_text(bytes, leaf, head_end), qualifier: qualifier})
    end
}

// Whether `head` also appears in `context` as a plain type name outside every
// identity: a whole word, not part of a path (`.`, `/`, `:` before it, or a
// member after it, as in `Logger.get`), not a prose compound
// (`Secret-bearing`), and not the head of a literal in quoted source
// (`{NoDebug{ value: 2 }}`), which spells the value the code wrote in its own
// scope rather than printing a second type.
diagnostic_identity_plain_use: fn(context: [U8], identities: [DiagnosticIdentity], head: String) -> Bool Never! {
    word: head.bytes()
    if word.len() == 0 -> return false
    index := 0
    loop index + word.len() <= context.len() {
        inside := false
        loop identity in identities {
            if index >= identity.start && index < identity.end -> inside = true
        }
        if !inside && diagnostic_bytes_match(context, index, word) {
            before: diagnostic_byte_at(context, index - 1)
            after: diagnostic_byte_at(context, index + word.len())
            member: after == 46 && diagnostic_is_word_byte(diagnostic_byte_at(context, index + word.len() + 1))
            literal: after == 123
            if !diagnostic_is_word_byte(before) && before != 46 && before != 47 && before != 58 && !diagnostic_is_word_byte(after) && after != 45 && after != 58 && !member && !literal {
                return true
            }
        }
        index += 1
    }
    false
}

diagnostic_bytes_at: fn(bytes: [U8], index: Int, text: String) -> Bool Never! {
    diagnostic_bytes_match(bytes, index, text.bytes())
}

// Whether `bytes` holds `expected` at `index`.
diagnostic_bytes_match: fn(bytes: [U8], index: Int, expected: [U8]) -> Bool Never! {
    if index < 0 || index + expected.len() > bytes.len() -> return false
    loop offset in 0..<expected.len() {
        if bytes[index + offset] != expected[offset] -> return false
    }
    true
}

diagnostic_is_word_byte: fn(value: Int) -> Bool Never! {
    (value >= 48 && value <= 57) || (value >= 65 && value <= 90) || (value >= 97 && value <= 122) || value == 95
}

// A byte that ends a type name in prose: whitespace, a quote, or punctuation
// around a type (`<>`, `()`, `[]`, `{}`, `,`, `|`, `?`, `!`).
diagnostic_identity_ends: fn(value: Int) -> Bool Never! {
    value < 0 || value <= 32 || value == 96 || value == 34 || value == 39 || value == 60 || value == 62 || value == 40 || value == 41 || value == 91 || value == 93 || value == 123 || value == 125 || value == 44 || value == 124 || value == 63 || value == 33
}

diagnostic_registry_row_in: fn(rows: [DiagnosticRegistryRow], code: String) -> DiagnosticRegistryRow? Never! {
    loop row in rows {
        if row.code == code -> return Val(row)
    }
    None
}

diagnostic_registry_row: fn(code: String) -> DiagnosticRegistryRow? Never! {
    diagnostic_registry_row_in(DIAGNOSTIC_ROWS, code)
}

// The row whose name is `name` (`Jet.UnknownName`).
diagnostic_registry_row_named: fn(name: String) -> DiagnosticRegistryRow? Never! {
    loop row in DIAGNOSTIC_ROWS {
        if row.name == name -> return Val(row)
    }
    None
}

// What a report's header prints for `code`: a registered row's name
// (`Jet.UnknownName`), of which the code is only a stable alias; any other
// code is already a library's type path (`web.BadPath`).
diagnostic_display_name: fn(code: String) -> String Never! {
    if diagnostic_registry_row(code) == .Val(row) -> return row.name
    code.copy()
}

// A tidy error (DiagnosticTier.Tidy): a lint whose registered row is on the
// tidy tier.
diagnostic_is_tidy: fn(diagnostic: Diagnostic) -> Bool Never! {
    if diagnostic.severity != DIAGNOSTIC_LINT -> return false
    row: diagnostic_registry_row(diagnostic.code) ?? return false
    row.tier == DiagnosticTier.Tidy
}

// Advice `jet lint <file>` lists (DiagnosticTier.Report): a lint whose
// registered row is on the report tier.
diagnostic_is_report: fn(diagnostic: Diagnostic) -> Bool Never! {
    if diagnostic.severity != DIAGNOSTIC_LINT -> return false
    row: diagnostic_registry_row(diagnostic.code) ?? return false
    row.tier == DiagnosticTier.Report
}

// A report that reads as a warning: a lint that is no tidy error.
diagnostic_is_warning: fn(diagnostic: Diagnostic) -> Bool Never! {
    diagnostic.severity == DIAGNOSTIC_LINT && !diagnostic_is_tidy(diagnostic)
}

// Every registry row in source order, retired rows included.
diagnostic_registry_rows: fn() -> [DiagnosticRegistryRow] Never! { DIAGNOSTIC_ROWS }

diagnostic_registry_static_edit: fn(row: DiagnosticRegistryRow, span: Span) -> TextEdit? {
    fix: row.structured_fix ?? return None
    if fix == {
        .Replace(_, replacement) -> Val(TextEdit{span: span, new_text: replacement})
        .Remove(_) -> Val(TextEdit{span: span, new_text: ""})
        .SourceEdit | .SuggestedSourceEdit | .CryptoMisuse | .GeneratedMarkerGroup | .GeneratedMissingArms | .GeneratedScriptRun | .GeneratedRedundantTailReturn -> None
    }
}

diagnostic_registry_applicability: fn(row: DiagnosticRegistryRow, has_edit: Bool) -> DiagnosticFixApplicability? {
    if !has_edit -> return None
    safety: row.fix_safety ?? return None
    if safety == {
        .Formatting | .BehaviorPreserving -> Val(DiagnosticFixApplicability.Safe)
        .APIChanging | .TargetChanging | .NeedsReview -> Val(DiagnosticFixApplicability.Suggested)
    }
}

diagnostic_registry_project_row: fn(diagnostic: &&Diagnostic, row: DiagnosticRegistryRow) -> Diagnostic Never! {
    updated := diagnostic
    if updated.span != None {
        span: updated.span ?? return updated
        edit: diagnostic_registry_static_edit(row, span)
        if edit == Val(static_edit) {
            updated.edit = Val(static_edit)
            updated.applicability = diagnostic_registry_applicability(row, true)
            updated.safety = row.fix_safety
        }
    }
    updated.no_fix_reason = row.no_fix_reason
    updated
}

// Canonical Source-side constructor. The raise site owns the filled prose and
// span; the generated registry row owns protocol metadata and static edits.
// Every type in the prose prints by the shared display rule
// (diagnostic_display_identities), with clashes judged over the whole message.
diagnostic_from_registry: fn(code: String, span: Span?, what: String, why: String, fix: String) -> Diagnostic Never! {
    row: diagnostic_registry_row(code) ?? panic("diagnostic `{code}` has no generated Source registry row")
    if row.status == DiagnosticRegistryStatus.Retired {
        panic("diagnostic `{code}` is retired and is never reported")
    }
    clashes: diagnostic_identity_clashes("{what}\n{why}\n{fix}".bytes())
    diagnostic: Diagnostic{
        moment: row.moment,
        severity: row.severity,
        code: code,
        span: span,
        what: diagnostic_sentence_case_line(diagnostic_display_identities(what, clashes)),
        why: diagnostic_sentence_case_line(diagnostic_display_identities(why, clashes)),
        fix: diagnostic_sentence_case_line(diagnostic_display_identities(fix, clashes)),
    }
    diagnostic_registry_project_row(diagnostic, row)
}

// Dynamic Source edits are authorized and graded by the generated row. This
// preserves the exact replacement/span authored by the producer without
// deriving safety from human Fix prose.
diagnostic_registry_with_edit: fn(diagnostic: &&Diagnostic, edit: TextEdit) -> Diagnostic Never! {
    updated := diagnostic
    row: diagnostic_registry_row(updated.code) ?? panic("updated `{updated.code}` has no generated Source registry row")
    if updated.no_fix_reason != None || row.no_fix_reason != None {
        panic("updated `{updated.code}` cannot carry an edit and a registry no-fix reason")
    }
    fix: row.structured_fix ?? panic("updated `{updated.code}` has no registry-owned edit channel")
    if !diagnostic_registry_is_source_edit(fix) {
        panic("updated `{updated.code}` has no Source edit registry channel")
    }
    updated.edit = Val(edit)
    updated.applicability = diagnostic_registry_applicability(row, true)
    updated.safety = row.fix_safety
    updated
}

diagnostic_registry_is_source_edit: fn(fix: DiagnosticRegistryFix) -> Bool Never! {
    if fix == {
        .SourceEdit | .SuggestedSourceEdit -> true
        .CryptoMisuse | .Replace(_, _) | .Remove(_) | .GeneratedMarkerGroup | .GeneratedMissingArms | .GeneratedScriptRun | .GeneratedRedundantTailReturn -> false
    }
}

diagnostic_registry_is_generated_edit: fn(fix: DiagnosticRegistryFix) -> Bool Never! {
    if fix == {
        .GeneratedMarkerGroup | .GeneratedMissingArms | .GeneratedScriptRun | .GeneratedRedundantTailReturn -> true
        .SourceEdit | .SuggestedSourceEdit | .CryptoMisuse | .Replace(_, _) | .Remove(_) -> false
    }
}

diagnostic_registry_safety_auto_apply: fn(safety: DiagnosticFixSafety) -> Bool Never! {
    if safety == {
        .Formatting | .BehaviorPreserving -> true
        .APIChanging | .TargetChanging | .NeedsReview -> false
    }
}

diagnostic_registry_with_edit_grade: fn(diagnostic: &&Diagnostic, edit: TextEdit, applicability: DiagnosticFixApplicability, safety: DiagnosticFixSafety) -> Diagnostic Never! {
    updated := diagnostic
    row: diagnostic_registry_row(updated.code) ?? panic("updated `{updated.code}` has no generated Source registry row")
    if updated.no_fix_reason != None || row.no_fix_reason != None {
        panic("updated `{updated.code}` cannot carry an edit and a registry no-fix reason")
    }
    fix: row.structured_fix ?? panic("updated `{updated.code}` has no registry-owned edit channel")
    if !diagnostic_registry_is_source_edit(fix) {
        panic("updated `{updated.code}` has no Source edit registry channel")
    }
    if applicability == DiagnosticFixApplicability.Safe && !diagnostic_registry_safety_auto_apply(safety) {
        panic("safe updated edit `{updated.code}` must have an auto-applicable safety grade")
    }
    updated.edit = Val(edit)
    updated.applicability = Val(applicability)
    updated.safety = Val(safety)
    updated
}

diagnostic_registry_with_structured_edit: fn(diagnostic: &&Diagnostic, edit: TextEdit) -> Diagnostic Never! {
    updated := diagnostic
    row: diagnostic_registry_row(updated.code) ?? panic("updated `{updated.code}` has no generated Source registry row")
    if updated.no_fix_reason != None || row.no_fix_reason != None {
        panic("updated `{updated.code}` cannot carry an edit and a registry no-fix reason")
    }
    fix: row.structured_fix ?? panic("updated `{updated.code}` has no registry-owned generated edit channel")
    if !diagnostic_registry_is_generated_edit(fix) {
        panic("updated `{updated.code}` has no generated structured edit registry channel")
    }
    updated.edit = Val(edit)
    updated.applicability = diagnostic_registry_applicability(row, true)
    updated.safety = row.fix_safety
    updated
}

diagnostic_registry_with_source_derived_suggestion: fn(diagnostic: &&Diagnostic, span: Span, new_text: String) -> Diagnostic Never! {
    updated := diagnostic
    if updated.edit != None -> panic("updated `{updated.code}` already carries an edit")
    row: diagnostic_registry_row(updated.code) ?? panic("updated `{updated.code}` has no generated Source registry row")
    if row.no_fix_reason == None {
        panic("updated `{updated.code}` has no explanatory row reason to replace")
    }
    updated.no_fix_reason = None
    updated.applicability = Val(DiagnosticFixApplicability.Suggested)
    updated.safety = Val(DiagnosticFixSafety.NeedsReview)
    updated.edit = Val(TextEdit{span: span, new_text: new_text})
    updated
}

// A language change's registered rewrite of source an earlier release
// accepted. The change defines the new text, so `jet fix` applies it as a
// behavior-preserving edit, whatever the row grades the diagnostic's own
// fixes; the row's no-fix reason covers only the other sources of the error.
diagnostic_registry_with_migration_edit: fn(diagnostic: &&Diagnostic, edit: TextEdit) -> Diagnostic Never! {
    updated := diagnostic
    if updated.edit != None -> panic("updated `{updated.code}` already carries an edit")
    if diagnostic_registry_row(updated.code) == None {
        panic("updated `{updated.code}` has no generated Source registry row")
    }
    updated.no_fix_reason = None
    updated.applicability = Val(DiagnosticFixApplicability.Safe)
    updated.safety = Val(DiagnosticFixSafety.BehaviorPreserving)
    updated.edit = Val(edit)
    updated
}

diagnostic_registry_with_alternative_edit: fn(diagnostic: &&Diagnostic, edit: TextEdit) -> Diagnostic Never! {
    updated := diagnostic
    if updated.no_fix_reason != None {
        panic("updated `{updated.code}` cannot carry an edit and no-fix reason")
    }
    if updated.edit == None || updated.applicability == None || updated.safety == None {
        panic("updated `{updated.code}` needs a graded primary edit before an alternative")
    }
    if updated.structured == None {
        updated.structured = Val(DiagnosticStructured.SuggestedEdits{edits: [TextEdit]{edit}})
        return updated
    }
    structured: updated.structured ?? return updated
    if structured == {
        .SuggestedEdits(edits) -> {
            alternatives := edits.copy()
            alternatives.push(edit.copy())
            updated.structured = Val(DiagnosticStructured.SuggestedEdits{edits: alternatives})
            updated
        }
        .CryptoMisuse(_, _, _, _) | .BuildError(_) | .RuntimeHostFault(_) -> panic("updated `{updated.code}` cannot carry source edit alternatives with another structured payload")
    }
}
