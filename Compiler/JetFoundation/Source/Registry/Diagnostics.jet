use core.text as diagnostic_unicode

enum DiagnosticRegistryStatus { Active Reserved }

enum DiagnosticRegistryFix {
    SourceEdit
    SuggestedSourceEdit
    CryptoMisuse
    Replace(from: String, to: String)
    Remove(text: String)
    GeneratedMarkerGroup
    GeneratedMissingArms
    GeneratedScriptRun
    GeneratedCallValue
    GeneratedRedundantTailReturn
}

// This is a generated view of Compiler/Prelude/Diagnostics.jet.
// DiagnosticRows.jet owns the data; this file owns the Source-side projection
// and canonical construction rules. Human wording at a raise site remains
// authored input, while moment, severity, row edits, grades, and no-fix facts
// come from the generated row.
struct DiagnosticRegistryRow {
    code: String
    lint_name: String?
    stage: String
    severity: Int
    moment: DiagnosticMoment
    status: DiagnosticRegistryStatus
    meaning: String
    what: String
    why: String
    fix: String
    detail: Bool
    structured_fix: DiagnosticRegistryFix?
    fix_safety: DiagnosticFixSafety?
    no_fix_reason: DiagnosticNoFixReason?
}

impl DiagnosticRegistryRow {
    fn has_stage(self, stage: String) -> Bool Never! {
        loop component in self.stage.split("/") {
            if component == stage -> return true
        }
        false
    }
}

fn diagnostic_byte_at(source: [U8], index: Int) -> Int Never! {
    if index < 0 || index >= source.len() -> return -1
    Int.from_u8(source[index])
}

fn diagnostic_utf8_width(source: [U8], index: Int) -> Int Never! {
    width := foundation_utf8_lead_width(diagnostic_byte_at(source, index))
    if width <= 1 -> return width
    width = foundation_utf8_width(width, diagnostic_byte_at(source, index + 1))
    if width <= 2 -> return width
    width = foundation_utf8_width(width, diagnostic_byte_at(source, index + 2))
    if width <= 3 -> return width
    foundation_utf8_width(width, diagnostic_byte_at(source, index + 3))
}

fn diagnostic_scalar_at(source: [U8], index: Int) -> String Never! {
    width :: diagnostic_utf8_width(source, index)
    if width <= 0 -> return ""
    out := [U8]{}
    loop offset in 0..<width {
        if index + offset >= source.len() -> break
        &out.push(source[index + offset])
    }
    String.from_bytes(out) ?? ""
}

fn diagnostic_is_whitespace_at(source: [U8], index: Int) -> Bool Never! {
    value :: diagnostic_byte_at(source, index)
    if {
        value < 0 -> false
        value < 128 -> value == 9 || value == 10 || value == 11 || value == 12 || value == 13 || value == 32
        else -> diagnostic_unicode.is_whitespace(diagnostic_scalar_at(source, index))
    }
}

fn diagnostic_is_sentence_digit(value: Int) -> Bool Never! {
    value >= 48 && value <= 57
}

fn diagnostic_sentence_case_line(value: String) -> String Never! {
    bytes := value.bytes()
    first := -1
    token_len := 0
    is_fn := false
    preserve := false
    period := false
    finished := false
    index := 0
    loop index < bytes.len() {
        width :: diagnostic_utf8_width(bytes, index)
        if finished {
            index += width
            next
        }
        character :: diagnostic_byte_at(bytes, index)
        if first < 0 {
            if diagnostic_is_whitespace_at(bytes, index) || character == 42 || character == 126 || character == 95 {
                index += width
                next
            }
            if character < 97 || character > 122 {
                finished = true
                index += width
                next
            }
            first = index
            token_len = 1
            is_fn = character == 102
            index += width
            next
        }
        if diagnostic_is_whitespace_at(bytes, index) || character == 44 || character == 59 || character == 58 || character == 40 || character == 41 || character == 91 || character == 93 || character == 33 {
            finished = true
            index += width
            next
        }
        if period -> preserve = true
        period = character == 46
        if period {
            index += width
            next
        }
        token_len += 1
        if token_len != 2 || character != 110 -> is_fn = false
        if diagnostic_is_sentence_digit(character) || character == 95 || character == 47 || character == 92 || character == 64 || character == 35 -> preserve = true
        index += width
    }
    if first >= 0 && !preserve && !(is_fn && token_len == 2) {
        bytes[first] = U8{diagnostic_byte_at(bytes, first) - 32}
    }
    String.from_bytes(bytes) ?? value
}

// One type identity in diagnostic prose: `module:<len>:<package>:<path>::Name`
// (the driver's key for a source type) or `<corelib>/<module>::Name` (a Core
// type). `start..end` is its whole spelling and `name` the name the source
// wrote, after the last `::`. `head` is the name's first identifier, which a
// clash compares, and `qualifier` the module as the user writes it: `crypto`
// for `<corelib>/core.crypto::Secret`, the file stem for a source module.
struct DiagnosticIdentity {
    start: Int
    end: Int
    name: String
    head: String
    qualifier: String
}

// A message names a type by its plain name. Only when two different types in
// one message share that name does each print as `module.Name`.
fn diagnostic_display_identities(value: String, clashes: [String]) -> String Never! {
    bytes :: value.bytes()
    identities :: diagnostic_identities_in(bytes)
    // copy: the caller keeps its text; the displayed line is a new value.
    if identities.len() == 0 -> return value.copy()
    out := [U8]{}
    index := 0
    loop identity in identities {
        loop index < identity.start {
            &out.push(bytes[index])
            index += 1
        }
        if clashes.contains(identity.head) && identity.qualifier != "" {
            loop byte in identity.qualifier.bytes() -> &out.push(byte)
            loop byte in ".".bytes() -> &out.push(byte)
        }
        loop byte in identity.name.bytes() -> &out.push(byte)
        index = identity.end
    }
    loop index < bytes.len() {
        &out.push(bytes[index])
        index += 1
    }
    String.from_bytes(out) ?? value.copy()
}

// The names in `context` (a whole message) that two different types share:
// two identities from different modules, or an identity and a type the
// message already prints by its plain name.
fn diagnostic_identity_clashes(context: [U8]) -> [String] Never! {
    identities :: diagnostic_identities_in(context)
    clashes := [String]{}
    loop identity in identities {
        if clashes.contains(identity.head) -> next
        clash := diagnostic_identity_plain_use(context, identities, identity.head)
        loop other in identities {
            if other.head == identity.head && other.qualifier != identity.qualifier -> clash = true
        }
        if clash -> &clashes.push(identity.head.copy())
    }
    clashes
}

fn diagnostic_identities_in(bytes: [U8]) -> [DiagnosticIdentity] Never! {
    found := [DiagnosticIdentity]{}
    index := 0
    loop index < bytes.len() {
        end :: diagnostic_identity_push(bytes, index, &found)
        index = if end > index -> end else -> index + 1
    }
    found
}

// Reads the identity starting at `index` into `found` and returns its end, or
// -1 when no identity starts there. A module identity's package part is
// skipped by its length prefix, since it may hold `:`.
fn diagnostic_identity_push(bytes: [U8], index: Int, found: &[DiagnosticIdentity]) -> Int Never! {
    module_form :: diagnostic_bytes_at(bytes, index, "module:")
    if !module_form && !diagnostic_bytes_at(bytes, index, "<corelib>/") -> return -1
    cursor := -1
    qualifier := ""
    if module_form {
        cursor = index + 7
        length := 0
        digits := 0
        loop diagnostic_is_sentence_digit(diagnostic_byte_at(bytes, cursor)) {
            length = length * 10 + diagnostic_byte_at(bytes, cursor) - 48
            digits += 1
            cursor += 1
        }
        if digits == 0 || diagnostic_byte_at(bytes, cursor) != 58 -> return -1
        cursor += 1 + length
        if diagnostic_byte_at(bytes, cursor) != 58 -> return -1
        cursor += 1
        path_start :: cursor
        loop cursor < bytes.len() && !diagnostic_identity_ends(diagnostic_byte_at(bytes, cursor)) && !diagnostic_bytes_at(bytes, cursor, "::") -> cursor += 1
        stem_start := path_start
        stem_end := cursor
        loop at in path_start..<cursor {
            if diagnostic_byte_at(bytes, at) == 47 -> stem_start = at + 1
        }
        loop at in stem_start..<cursor {
            if diagnostic_byte_at(bytes, at) == 46 -> stem_end = at
        }
        qualifier = diagnostic_bytes_text(bytes, stem_start, stem_end)
    } else {
        cursor = index + 10
        segment := cursor
        loop cursor < bytes.len() && !diagnostic_identity_ends(diagnostic_byte_at(bytes, cursor)) && !diagnostic_bytes_at(bytes, cursor, "::") && diagnostic_byte_at(bytes, cursor) != 47 {
            if diagnostic_byte_at(bytes, cursor) == 46 -> segment = cursor + 1
            cursor += 1
        }
        qualifier = diagnostic_bytes_text(bytes, segment, cursor)
    }
    leaf := -1
    loop cursor < bytes.len() && !diagnostic_identity_ends(diagnostic_byte_at(bytes, cursor)) {
        if diagnostic_bytes_at(bytes, cursor, "::") {
            leaf = cursor + 2
            cursor += 2
            next
        }
        cursor += 1
    }
    if leaf < 0 || leaf >= cursor -> return -1
    head_end := leaf
    loop head_end < cursor && diagnostic_byte_at(bytes, head_end) != 46 -> head_end += 1
    &found.push(DiagnosticIdentity{start: index, end: cursor, name: diagnostic_bytes_text(bytes, leaf, cursor), head: diagnostic_bytes_text(bytes, leaf, head_end), qualifier: qualifier})
    cursor
}

// Whether `head` also appears in `context` as a plain type name outside every
// identity: a whole word, not part of a path (`.`, `/`, `:` before it) and not
// a prose compound (`Secret-bearing`).
fn diagnostic_identity_plain_use(context: [U8], identities: [DiagnosticIdentity], head: String) -> Bool Never! {
    word :: head.bytes()
    if word.len() == 0 -> return false
    index := 0
    loop index + word.len() <= context.len() {
        inside := false
        loop identity in identities {
            if index >= identity.start && index < identity.end -> inside = true
        }
        if !inside && diagnostic_bytes_at(context, index, head) {
            before :: diagnostic_byte_at(context, index - 1)
            after :: diagnostic_byte_at(context, index + word.len())
            if !diagnostic_is_word_byte(before) && before != 46 && before != 47 && before != 58 && !diagnostic_is_word_byte(after) && after != 45 && after != 58 -> return true
        }
        index += 1
    }
    false
}

fn diagnostic_bytes_at(bytes: [U8], index: Int, text: String) -> Bool Never! {
    expected :: text.bytes()
    if index < 0 || index + expected.len() > bytes.len() -> return false
    loop offset in 0..<expected.len() {
        if bytes[index + offset] != expected[offset] -> return false
    }
    true
}

fn diagnostic_is_word_byte(value: Int) -> Bool Never! {
    (value >= 48 && value <= 57) || (value >= 65 && value <= 90) || (value >= 97 && value <= 122) || value == 95
}

// A byte that ends a type name in prose: whitespace, a quote, or punctuation
// around a type (`<>`, `()`, `[]`, `{}`, `,`, `|`, `?`, `!`).
fn diagnostic_identity_ends(value: Int) -> Bool Never! {
    value < 0 || value <= 32 || value == 96 || value == 34 || value == 39 || value == 60 || value == 62 || value == 40 || value == 41 || value == 91 || value == 93 || value == 123 || value == 125 || value == 44 || value == 124 || value == 63 || value == 33
}

fn diagnostic_registry_row_in(rows: [DiagnosticRegistryRow], code: String) -> DiagnosticRegistryRow? Never! {
    loop row in rows {
        if row.code == code -> return Val(row)
    }
    None
}

fn diagnostic_registry_row(code: String) -> DiagnosticRegistryRow? Never! {
    diagnostic_registry_row_in(DIAGNOSTIC_ROWS, code)
}

// Every registry row in source order (Registry.rs `diagnostic_rows`).
fn diagnostic_registry_rows() -> [DiagnosticRegistryRow] Never! { DIAGNOSTIC_ROWS }

fn diagnostic_registry_static_edit(row: DiagnosticRegistryRow, span: Span) -> TextEdit? {
    fix :: row.structured_fix ?? return None
    if fix == {
        .Replace(_, replacement) -> Val(TextEdit{span: span, new_text: replacement})
        .Remove(_) -> Val(TextEdit{span: span, new_text: ""})
        else -> None
    }
}

fn diagnostic_registry_applicability(row: DiagnosticRegistryRow, has_edit: Bool) -> DiagnosticFixApplicability? {
    if !has_edit -> return None
    safety :: row.fix_safety ?? return None
    if safety == {
        .Formatting | .BehaviorPreserving -> Val(DiagnosticFixApplicability.Safe)
        else -> Val(DiagnosticFixApplicability.Suggested)
    }
}

fn diagnostic_registry_project_row(diagnostic: ^Diagnostic, row: DiagnosticRegistryRow) -> Diagnostic Never! {
    updated := diagnostic
    if updated.span != None {
        span :: updated.span ?? return updated
        edit :: diagnostic_registry_static_edit(row, span)
        if edit == Val(static_edit) {
            updated.edit = Val(static_edit)
            updated.applicability = diagnostic_registry_applicability(row, true)
            updated.safety = row.fix_safety
        }
    }
    updated.no_fix_reason = row.no_fix_reason
    updated
}

// Canonical Source-side constructor. The raise site owns the filled prose and
// span; the generated registry row owns protocol metadata and static edits.
// Every type in the prose prints by the shared display rule
// (diagnostic_display_identities), with clashes judged over the whole message.
fn diagnostic_from_registry(code: String, span: Span?, what: String, why: String, fix: String) -> Diagnostic Never! {
    row :: diagnostic_registry_row(code) ?? panic("diagnostic `{code}` has no generated Source registry row")
    clashes :: diagnostic_identity_clashes("{what}\n{why}\n{fix}".bytes())
    diagnostic :: Diagnostic{
        moment: row.moment,
        severity: row.severity,
        code: code,
        span: span,
        what: diagnostic_sentence_case_line(diagnostic_display_identities(what, clashes)),
        why: diagnostic_sentence_case_line(diagnostic_display_identities(why, clashes)),
        fix: diagnostic_sentence_case_line(diagnostic_display_identities(fix, clashes)),
    }
    diagnostic_registry_project_row(^diagnostic, row)
}

// Dynamic Source edits are authorized and graded by the generated row. This
// preserves the exact replacement/span authored by the producer without
// deriving safety from human Fix prose.
fn diagnostic_registry_with_edit(diagnostic: ^Diagnostic, edit: TextEdit) -> Diagnostic Never! {
    updated := diagnostic
    row :: diagnostic_registry_row(updated.code) ?? panic("updated `{updated.code}` has no generated Source registry row")
    if updated.no_fix_reason != None || row.no_fix_reason != None -> panic("updated `{updated.code}` cannot carry an edit and a registry no-fix reason")
    fix :: row.structured_fix ?? panic("updated `{updated.code}` has no registry-owned edit channel")
    if !diagnostic_registry_is_source_edit(fix) -> panic("updated `{updated.code}` has no Source edit registry channel")
    updated.edit = Val(edit)
    updated.applicability = diagnostic_registry_applicability(row, true)
    updated.safety = row.fix_safety
    updated
}

fn diagnostic_registry_is_source_edit(fix: DiagnosticRegistryFix) -> Bool Never! {
    if fix == {.SourceEdit | .SuggestedSourceEdit -> true else -> false}
}

fn diagnostic_registry_is_generated_edit(fix: DiagnosticRegistryFix) -> Bool Never! {
    if fix == {
        .GeneratedMarkerGroup
        | .GeneratedMissingArms
        | .GeneratedScriptRun
        | .GeneratedCallValue
        | .GeneratedRedundantTailReturn -> true
        else -> false
    }
}

fn diagnostic_registry_safety_auto_apply(safety: DiagnosticFixSafety) -> Bool Never! {
    if safety == {
        .Formatting | .BehaviorPreserving -> true
        else -> false
    }
}

fn diagnostic_registry_with_edit_grade(diagnostic: ^Diagnostic, edit: TextEdit, applicability: DiagnosticFixApplicability, safety: DiagnosticFixSafety) -> Diagnostic Never! {
    updated := diagnostic
    row :: diagnostic_registry_row(updated.code) ?? panic("updated `{updated.code}` has no generated Source registry row")
    if updated.no_fix_reason != None || row.no_fix_reason != None -> panic("updated `{updated.code}` cannot carry an edit and a registry no-fix reason")
    fix :: row.structured_fix ?? panic("updated `{updated.code}` has no registry-owned edit channel")
    if !diagnostic_registry_is_source_edit(fix) -> panic("updated `{updated.code}` has no Source edit registry channel")
    if applicability == DiagnosticFixApplicability.Safe && !diagnostic_registry_safety_auto_apply(safety) -> panic("safe updated edit `{updated.code}` must have an auto-applicable safety grade")
    updated.edit = Val(edit)
    updated.applicability = Val(applicability)
    updated.safety = Val(safety)
    updated
}

fn diagnostic_registry_with_structured_edit(diagnostic: ^Diagnostic, edit: TextEdit) -> Diagnostic Never! {
    updated := diagnostic
    row :: diagnostic_registry_row(updated.code) ?? panic("updated `{updated.code}` has no generated Source registry row")
    if updated.no_fix_reason != None || row.no_fix_reason != None -> panic("updated `{updated.code}` cannot carry an edit and a registry no-fix reason")
    fix :: row.structured_fix ?? panic("updated `{updated.code}` has no registry-owned generated edit channel")
    if !diagnostic_registry_is_generated_edit(fix) -> panic("updated `{updated.code}` has no generated structured edit registry channel")
    updated.edit = Val(edit)
    updated.applicability = diagnostic_registry_applicability(row, true)
    updated.safety = row.fix_safety
    updated
}

fn diagnostic_registry_with_source_derived_suggestion(diagnostic: ^Diagnostic, span: Span, new_text: String) -> Diagnostic Never! {
    updated := diagnostic
    if updated.edit != None -> panic("updated `{updated.code}` already carries an edit")
    row :: diagnostic_registry_row(updated.code) ?? panic("updated `{updated.code}` has no generated Source registry row")
    if row.no_fix_reason == None -> panic("updated `{updated.code}` has no explanatory row reason to replace")
    updated.no_fix_reason = None
    updated.applicability = Val(DiagnosticFixApplicability.Suggested)
    updated.safety = Val(DiagnosticFixSafety.NeedsReview)
    updated.edit = Val(TextEdit{span: span, new_text: new_text})
    updated
}

fn diagnostic_registry_with_alternative_edit(diagnostic: ^Diagnostic, edit: TextEdit) -> Diagnostic Never! {
    updated := diagnostic
    if updated.no_fix_reason != None -> panic("updated `{updated.code}` cannot carry an edit and no-fix reason")
    if updated.edit == None || updated.applicability == None || updated.safety == None -> panic("updated `{updated.code}` needs a graded primary edit before an alternative")
    if updated.structured == None {
        updated.structured = Val(DiagnosticStructured.SuggestedEdits{edits: [TextEdit]{edit}})
        return updated
    }
    structured :: updated.structured ?? return updated
    if structured == {
        .SuggestedEdits(edits) -> {
            alternatives := edits.copy()
            &alternatives.push(edit)
            updated.structured = Val(DiagnosticStructured.SuggestedEdits{edits: alternatives})
            updated
        }
        else -> panic("updated `{updated.code}` cannot carry source edit alternatives with another structured payload")
    }
}

