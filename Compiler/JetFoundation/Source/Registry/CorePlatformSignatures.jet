// Typed source projection of CheckerCoreLib::core_fixed_sig_impl arms 4365–6487.
// This table keeps the native fixed signatures' concrete types and access modes.

// The fixed Core signature tables are row data read by one lookup instead of
// one branch per member, so the compiler and its emitted code stay linear in
// the table size. One row per line: `module member[|member…] params return
// [type_parameter|…]`, fields separated by one space. `params` is `-` (none)
// or a comma list of positional parameter types, each optionally prefixed `^`
// (moved) or `&` (written); `return` is `-` (none) or a type; the optional
// fifth field names the signature's unconstrained type parameters. Types:
// `String` `Int` `Float` `Bool` `Char`; `u8` / `i32` (IntN); `[T]` list;
// `[K:V]` map; `T?` option; `Result<T,E>`; `Union<A,B,…>`; `Name<T,…>`
// (Apply); `fn(A,B)` and `fn(A,B;R)` (no effect row or call metadata);
// `(name:T,…)` tuple; `callback` (`core_host_callback_type`); any other name
// is Named. The first row whose module and member match wins; no row is None.
fn core_sig_row_lookup(rows: String, module_name: String, member: String) -> CoreTypedCallSignature? {
    prefix :: "{module_name} "
    loop line in rows.split("\n") {
        if !line.starts_with(prefix) -> next
        fields :: line.split(" ").to_list()
        if (fields.len() != 4 && fields.len() != 5) || !core_sig_one_of(member, fields[1].split("|").to_list()) -> next
        parameters := [CoreCallTypedParameter]{}
        if fields[2] != "-" {
            loop text in core_sig_row_parameters(fields[2]) {
                bytes :: text.bytes()
                access := AccessConvention.Read
                start := 0
                if core_sig_row_code(bytes, 0) == 94 {
                    access = AccessConvention.Move
                    start = 1
                }
                if core_sig_row_code(bytes, 0) == 38 {
                    access = AccessConvention.Write
                    start = 1
                }
                &parameters.push(core_sig_positional(core_sig_row_type(text, start), access))
            }
        }
        return_type :: if fields[3] == "-" -> Type?{None} else -> Val(core_sig_row_type(fields[3], 0))
        signature := core_sig(module_name, member, parameters, return_type)
        if fields.len() == 5 {
            type_parameters := [CoreCallTypeParameter]{}
            loop name in fields[4].split("|") -> &type_parameters.push(core_sig_type_parameter(name, CoreCallTypeConstraint.Any))
            signature.type_parameters = type_parameters
        }
        return Val(signature)
    }
    None
}

// One parsed row type and the byte offset just past it.
struct CoreSigRowType {
    ty: Type
    next: Int
}

// Comma-separated row types and the byte offset just past their closer.
struct CoreSigRowTypes {
    types: [Type]
    next: Int
}

fn core_sig_row_code(bytes: [U8], index: Int) -> Int Never! {
    if index >= bytes.len() -> return -1
    Int.from_u8(bytes[index])
}

fn core_sig_row_is_name_code(code: Int) -> Bool Never! {
    (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95
}

// The top-level comma-separated parameter spellings of a `params` field.
fn core_sig_row_parameters(field: String) -> [String] Never! {
    bytes :: field.bytes()
    out := [String]{}
    depth := 0
    start := 0
    loop (index, byte) in bytes {
        code :: Int.from_u8(byte)
        if code == 91 || code == 60 || code == 40 -> depth += 1
        if code == 93 || code == 62 || code == 41 -> depth -= 1
        if code == 44 && depth == 0 {
            &out.push(String.from_bytes(bytes.slice(start, index)) ?? "")
            start = index + 1
        }
    }
    &out.push(String.from_bytes(bytes.slice(start, bytes.len())) ?? "")
    out
}

fn core_sig_row_type(text: String, start: Int) -> Type Never! {
    bytes :: text.bytes()
    parsed :: core_sig_row_type_at(bytes, start)
    if parsed.next != bytes.len() -> panic("Core signature row type `{text}` has trailing text")
    parsed.ty
}

fn core_sig_row_type_at(bytes: [U8], start: Int) -> CoreSigRowType Never! {
    parsed := core_sig_row_atom_at(bytes, start)
    loop core_sig_row_code(bytes, parsed.next) == 63 -> parsed = CoreSigRowType{ty: Type.Option{inner: parsed.ty}, next: parsed.next + 1}
    parsed
}

// The types from `start` up to the closer `close` (`>` or `)`).
fn core_sig_row_types_at(bytes: [U8], start: Int, close: Int) -> CoreSigRowTypes Never! {
    types := [Type]{}
    next := start
    done := core_sig_row_code(bytes, next) == close
    if done -> next += 1
    loop !done {
        parsed :: core_sig_row_type_at(bytes, next)
        &types.push(parsed.ty)
        done = core_sig_row_code(bytes, parsed.next) != 44
        next = parsed.next + 1
    }
    CoreSigRowTypes{types: types, next: next}
}

fn core_sig_row_atom_at(bytes: [U8], start: Int) -> CoreSigRowType Never! {
    first :: core_sig_row_code(bytes, start)
    if first == 91 {
        element :: core_sig_row_type_at(bytes, start + 1)
        if core_sig_row_code(bytes, element.next) == 58 {
            value :: core_sig_row_type_at(bytes, element.next + 1)
            return CoreSigRowType{ty: Type.Map{key: element.ty, key_span: None, value: value.ty}, next: value.next + 1}
        }
        return CoreSigRowType{ty: Type.List{element: element.ty}, next: element.next + 1}
    }
    if first == 40 {
        fields := [TypeTupleField]{}
        next := start + 1
        done := core_sig_row_code(bytes, next) == 41
        if done -> next += 1
        loop !done {
            name_end := next
            loop core_sig_row_code(bytes, name_end) != 58 -> name_end += 1
            field :: core_sig_row_type_at(bytes, name_end + 1)
            &fields.push(TypeTupleField{name: String.from_bytes(bytes.slice(next, name_end)) ?? "", ty: field.ty})
            done = core_sig_row_code(bytes, field.next) != 44
            next = field.next + 1
        }
        return CoreSigRowType{ty: Type.Tuple{fields: fields}, next: next}
    }
    end := start
    loop core_sig_row_is_name_code(core_sig_row_code(bytes, end)) -> end += 1
    name :: String.from_bytes(bytes.slice(start, end)) ?? ""
    if name == "fn" {
        params := [Type]{}
        ret := Type?{None}
        next := end + 1
        done := core_sig_row_code(bytes, next) == 41
        if done -> next += 1
        loop !done {
            if core_sig_row_code(bytes, next) == 59 {
                result :: core_sig_row_type_at(bytes, next + 1)
                ret = Val(result.ty)
                next = result.next + 1
                done = true
            } else {
                param :: core_sig_row_type_at(bytes, next)
                &params.push(param.ty)
                code :: core_sig_row_code(bytes, param.next)
                done = code == 41
                next = if code == 44 -> param.next + 1 else -> param.next
                if done -> next += 1
            }
        }
        return CoreSigRowType{ty: Type.Fn{params: params, ret: ret, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}, next: next}
    }
    if core_sig_row_code(bytes, end) == 60 {
        args :: core_sig_row_types_at(bytes, end + 1, 62)
        if name == "Result" -> return CoreSigRowType{ty: Type.Result{ok: args.types[0], err: args.types[1]}, next: args.next}
        if name == "Union" -> return CoreSigRowType{ty: Type.Union{members: args.types}, next: args.next}
        return CoreSigRowType{ty: Type.Apply{name: name, args: args.types}, next: args.next}
    }
    if name == {
        "String" -> return CoreSigRowType{ty: Type.String, next: end}
        "Int" -> return CoreSigRowType{ty: Type.Int, next: end}
        "Float" -> return CoreSigRowType{ty: Type.Float, next: end}
        "Bool" -> return CoreSigRowType{ty: Type.Bool, next: end}
        "Char" -> return CoreSigRowType{ty: Type.Char, next: end}
        "callback" -> return CoreSigRowType{ty: core_host_callback_type(), next: end}
        else -> {}
    }
    if (first == 105 || first == 117) && end > start + 1 {
        bits := 0
        digits := true
        loop byte in bytes.slice(start + 1, end) {
            code :: Int.from_u8(byte)
            if code < 48 || code > 57 -> digits = false
            bits = bits * 10 + code - 48
        }
        if digits -> return CoreSigRowType{ty: Type.IntN{signed: first == 105, bits: bits}, next: end}
    }
    CoreSigRowType{ty: Type.Named{name: name}, next: end}
}

