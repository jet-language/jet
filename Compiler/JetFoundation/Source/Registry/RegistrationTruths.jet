// Jet-owned corpus-truth rows, migrated from Registry/FactReads02.jet.
// These are the registration table's published home/renderer/guard identities;
// a path in a row is report data, not a runtime dependency on that file.
pub struct RegistrationTruthRow {
    pub name: String
    pub home: String
    pub renderers: [String]
    pub guard_test: String
    pub guard_file: String
    pub guard_proof: String
    pub decision: String
}
fn registration_truth(name: String, home: String, renderers: [String], test: String, file: String, proof: String, decision: String) -> RegistrationTruthRow Never! {
    RegistrationTruthRow{name: name, home: home, renderers: renderers, guard_test: test, guard_file: file, guard_proof: proof, decision: decision}
}
pub REGISTRATION_TRUTH_ROWS :: prep { [RegistrationTruthRow]{
    registration_truth("RegistrationTable", "crates/jet-foundation/src/Registry.rs", [String]{"jet explain", "jet inspect types", "compile-time reflection"}, "every_row_states_the_one_way_law", "tests/marker_registry_coverage.rs", "counts definition sites", "D-META-REG1"),
    registration_truth("JitHostSymbols", "crates/jet-jit/src/jit/runtime_host.rs", [String]{"host_fns! declarations", "JIT lowering call_host"}, "all_host_symbols_declared_match_all_registered", "crates/jet-jit/src/jit/runtime_host.rs", "counts definition sites", "D-ONCE-LAW1"),
    registration_truth("CoreCalls", "crates/jet-foundation/src/Syntax/core_calls.rs", [String]{"sema/TIR/AOT/comptime projections of every plain core.* call", "effect and sink facts for every plain core.* call"}, "core_projection_is_complete_both_directions", "tests/core_call_table.rs", "counts definition sites", "D-ONCE-LAW1"),
    registration_truth("ExactIntSnip", "crates/jet-foundation/src/Numeric.rs", [String]{"compile-time evaluation", "JIT encoding", "the Prelude"}, "comptime_exact_int_matches_runtime", "tests/comptime_diff.rs", "diffs behavior", "D-ONCE-LAW1"),
    registration_truth("Scheduler", "crates/jet-codegen/src/Prelude/Scheduler.rs", [String]{"AOT programs", "the JIT scheduler host"}, "the_jit_scheduler_is_the_prelude_scheduler", "crates/jet-codegen/src/SchedulerHost.rs", "counts definition sites", "D-ONCE-LAW1"),
    registration_truth("IceReport", "crates/jet-foundation/src/Diagnostics.rs", [String]{"the jet binary panic hook", "the ice! macro", "compile driver reports"}, "no_hand_typed_ice_banner_outside_the_one_home", "tests/ice_report_single_home.rs", "counts definition sites", "D-ONCE-LAW1"),
    registration_truth("Retirements", "crates/jet-foundation/src/Syntax/retirements.rs", [String]{"jet fmt", "jet fix", "the retirement diagnostics"}, "adoption_ratchets_toward_zero", "tests/retirement_ratchet.rs", "counts definition sites", "D-ONCE-RETIRE1"),
    registration_truth("JetVocabulary", "Docs/spec/vocabulary.md", [String]{"Markdown docs"}, "vocabulary_page_has_one_definition_and_no_retired_senses", "tests/truthfulness.rs", "counts definition sites", "D-ONCE-WORD1=A"),
} }
