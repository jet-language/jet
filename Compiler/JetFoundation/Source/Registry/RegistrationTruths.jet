// Jet-owned corpus-truth rows: each truth's one home, what renders from it,
// and the guard that proves there is no second copy. A row exists only while
// its guard does; a path in a row is report data, not a runtime dependency.
struct RegistrationTruthRow {
    name: String
    home: String
    renderers: [String]
    guard_test: String
    guard_file: String
    guard_proof: String
}
REGISTRATION_TRUTH_ROWS :: comptime { [RegistrationTruthRow]{
    {name: "CoreCalls", home: "Compiler/Prelude/Core.jet", renderers: [String]{"the CoreCallRows.jet call table the checker and backend read for every plain core.* call", "effect and sink facts for every plain core.* call"}, guard_test: "check-core-surface-ledger --check-core-call-registry", guard_file: "Tools/agent/check-core-surface-ledger.mjs", guard_proof: "regenerates the call table from Core.jet and CoreCallExtensions.jet and diffs it"},
    {name: "JetVocabulary", home: "Docs/spec/vocabulary.md", renderers: [String]{"Markdown docs"}, guard_test: "vocabulary_page_has_one_definition_and_no_retired_senses", guard_file: "tests/guards/truthfulness.jet", guard_proof: "counts definition sites"},
} }
