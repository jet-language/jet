// Owning an opaque impl or a compiler enum menu does not create an export.
// Qualified-annotation suffixes: the CORE_SOURCE_OWNED_ROWS impl types, then
// the enum names above, each once in first-occurrence order.
JET_CORE_OWNER_ANNOTATION_SUFFIXES: #run core_owner_annotation_suffixes(CORE_SOURCE_OWNED_ROWS, CORE_ENUM_PAYLOAD_ROWS)

core_owner_annotation_suffixes: fn(rows: [CoreSourceOwnedRow], payloads: [CoreEnumPayloadRow]) -> [String] Never! {
    suffixes := [String]{}
    loop row in rows {
        loop name in row.impl_types {
            if !suffixes.contains(".{name}") -> suffixes.push(".{name}")
        }
    }
    loop payload in payloads {
        if !suffixes.contains(".{payload.enum_name}") -> suffixes.push(".{payload.enum_name}")
    }
    suffixes
}
