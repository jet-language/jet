// Compiler-owned Core enum families with payloads: no Core source declares
// them, so these rows are their declaration. Each row is one variant and its
// positional payload types in slot order (none for a unit variant). IOError
// is the host IO error the runtime raises, its tags the HostEnums carrier
// ordinals; PreparedValue is the comptime value a prepared constant holds.
// Both stay here until Core source declares the family. A family Core source
// declares takes its payloads from its Core.rows case list instead
// (CORE_ENUM_CASE_PAYLOADS).
CORE_ENUM_PAYLOAD_ROWS: [CoreEnumPayloadRow]{
    CoreEnumPayloadRow{enum_name: "IOError", variant: "InvalidInput", payload: [Type]{Type.Named{name: "IOContext"}}},
    CoreEnumPayloadRow{enum_name: "IOError", variant: "NotFound", payload: [Type]{Type.Named{name: "IOContext"}}},
    CoreEnumPayloadRow{enum_name: "IOError", variant: "PermissionDenied", payload: [Type]{Type.Named{name: "IOContext"}}},
    CoreEnumPayloadRow{enum_name: "IOError", variant: "TimedOut", payload: [Type]{Type.Named{name: "IOContext"}}},
    CoreEnumPayloadRow{enum_name: "IOError", variant: "Cancelled", payload: [Type]{Type.Named{name: "IOContext"}}},
    CoreEnumPayloadRow{enum_name: "IOError", variant: "Closed", payload: [Type]{Type.Named{name: "IOContext"}}},
    CoreEnumPayloadRow{enum_name: "IOError", variant: "Protocol", payload: [Type]{Type.Named{name: "IOContext"}}},
    CoreEnumPayloadRow{enum_name: "IOError", variant: "Other", payload: [Type]{Type.Named{name: "IOContext"}}},
    CoreEnumPayloadRow{enum_name: "IOError", variant: "ResourceLimit", payload: [Type]{Type.Named{name: "ProcessResourceLimit"}}},
    CoreEnumPayloadRow{enum_name: "IOError", variant: "AlreadyExists", payload: [Type]{Type.Named{name: "IOContext"}}},
    CoreEnumPayloadRow{enum_name: "IOError", variant: "Unsupported", payload: [Type]{Type.Named{name: "IOContext"}}},
    CoreEnumPayloadRow{enum_name: "PreparedValue", variant: "Int", payload: [Type]{Type.Int}},
    CoreEnumPayloadRow{enum_name: "PreparedValue", variant: "Float", payload: [Type]{Type.Float}},
    CoreEnumPayloadRow{enum_name: "PreparedValue", variant: "Bool", payload: [Type]{Type.Bool}},
    CoreEnumPayloadRow{enum_name: "PreparedValue", variant: "Char", payload: [Type]{Type.Char}},
    CoreEnumPayloadRow{enum_name: "PreparedValue", variant: "String", payload: [Type]{Type.String}},
    CoreEnumPayloadRow{enum_name: "PreparedValue", variant: "Enum", payload: [Type]{Type.Named{name: "PreparedCase"}}},
    CoreEnumPayloadRow{enum_name: "PreparedValue", variant: "List", payload: [Type]{Type.List{element: Type.Named{name: "PreparedValue"}}}},
    CoreEnumPayloadRow{enum_name: "PreparedValue", variant: "Struct", payload: [Type]{Type.Named{name: "PreparedStruct"}}},
    CoreEnumPayloadRow{enum_name: "PreparedValue", variant: "Unit", payload: [Type]{}},
}

// Owning an opaque impl or a compiler enum menu does not create an export.
// Qualified-annotation suffixes: the CORE_SOURCE_OWNED_ROWS impl types, then
// the enum names above, then each Core enum leaf whose case list carries
// payloads, each once in first-occurrence order.
JET_CORE_OWNER_ANNOTATION_SUFFIXES: #run core_owner_annotation_suffixes(CORE_SOURCE_OWNED_ROWS, CORE_ENUM_PAYLOAD_ROWS, CORE_ENUM_CASE_ROWS, CORE_ENUM_CASE_PAYLOADS)

core_owner_annotation_suffixes: fn(rows: [CoreSourceOwnedRow], payloads: [CoreEnumPayloadRow], cases: [CoreModuleTypeExport], case_payloads: [[[Type]]]) -> [String] Never! {
    suffixes := [String]{}
    loop row in rows {
        loop name in row.impl_types {
            if !suffixes.contains(".{name}") -> suffixes.push(".{name}")
        }
    }
    loop payload in payloads {
        if !suffixes.contains(".{payload.enum_name}") -> suffixes.push(".{payload.enum_name}")
    }
    loop (index, leaf) in cases {
        if case_payloads[index].len() > 0 && !suffixes.contains(".{leaf.name}") {
            suffixes.push(".{leaf.name}")
        }
    }
    suffixes
}
