// Compiler-owned Core enum families with payloads. Each row is one variant
// and its positional payload types in slot order (none for a unit variant).
// The rows were frozen at the Rust-removal cutover from the bootstrap
// checker's `resolve_enum_variants_cloned` tables, in their resolution order.
// A family Core source also declares (Key, DataEvent) lists every case of
// that declaration, in its order.
CORE_ENUM_PAYLOAD_ROWS: [CoreEnumPayloadRow]{
    CoreEnumPayloadRow{enum_name: "Key", variant: "Char", payload: [Type]{Type.Char}},
    CoreEnumPayloadRow{enum_name: "Key", variant: "Enter", payload: [Type]{}},
    CoreEnumPayloadRow{enum_name: "Key", variant: "Escape", payload: [Type]{}},
    CoreEnumPayloadRow{enum_name: "Key", variant: "Backspace", payload: [Type]{}},
    CoreEnumPayloadRow{enum_name: "Key", variant: "Tab", payload: [Type]{}},
    CoreEnumPayloadRow{enum_name: "Key", variant: "Delete", payload: [Type]{}},
    CoreEnumPayloadRow{enum_name: "Key", variant: "Insert", payload: [Type]{}},
    CoreEnumPayloadRow{enum_name: "Key", variant: "Up", payload: [Type]{}},
    CoreEnumPayloadRow{enum_name: "Key", variant: "Down", payload: [Type]{}},
    CoreEnumPayloadRow{enum_name: "Key", variant: "Left", payload: [Type]{}},
    CoreEnumPayloadRow{enum_name: "Key", variant: "Right", payload: [Type]{}},
    CoreEnumPayloadRow{enum_name: "Key", variant: "Home", payload: [Type]{}},
    CoreEnumPayloadRow{enum_name: "Key", variant: "End", payload: [Type]{}},
    CoreEnumPayloadRow{enum_name: "Key", variant: "PageUp", payload: [Type]{}},
    CoreEnumPayloadRow{enum_name: "Key", variant: "PageDown", payload: [Type]{}},
    CoreEnumPayloadRow{enum_name: "Key", variant: "Shift", payload: [Type]{}},
    CoreEnumPayloadRow{enum_name: "Key", variant: "Control", payload: [Type]{}},
    CoreEnumPayloadRow{enum_name: "Key", variant: "Alt", payload: [Type]{}},
    CoreEnumPayloadRow{enum_name: "Key", variant: "Super", payload: [Type]{}},
    CoreEnumPayloadRow{enum_name: "Key", variant: "CapsLock", payload: [Type]{}},
    CoreEnumPayloadRow{enum_name: "Key", variant: "F", payload: [Type]{Type.Int}},
    CoreEnumPayloadRow{enum_name: "Key", variant: "Ctrl", payload: [Type]{Type.Char}},
    CoreEnumPayloadRow{enum_name: "Key", variant: "Unknown", payload: [Type]{}},
    CoreEnumPayloadRow{enum_name: "IOError", variant: "InvalidInput", payload: [Type]{Type.Named{name: "IOContext"}}},
    CoreEnumPayloadRow{enum_name: "IOError", variant: "NotFound", payload: [Type]{Type.Named{name: "IOContext"}}},
    CoreEnumPayloadRow{enum_name: "IOError", variant: "PermissionDenied", payload: [Type]{Type.Named{name: "IOContext"}}},
    CoreEnumPayloadRow{enum_name: "IOError", variant: "TimedOut", payload: [Type]{Type.Named{name: "IOContext"}}},
    CoreEnumPayloadRow{enum_name: "IOError", variant: "Cancelled", payload: [Type]{Type.Named{name: "IOContext"}}},
    CoreEnumPayloadRow{enum_name: "IOError", variant: "Closed", payload: [Type]{Type.Named{name: "IOContext"}}},
    CoreEnumPayloadRow{enum_name: "IOError", variant: "Protocol", payload: [Type]{Type.Named{name: "IOContext"}}},
    CoreEnumPayloadRow{enum_name: "IOError", variant: "Other", payload: [Type]{Type.Named{name: "IOContext"}}},
    CoreEnumPayloadRow{enum_name: "IOError", variant: "ResourceLimit", payload: [Type]{Type.Named{name: "ProcessResourceLimit"}}},
    CoreEnumPayloadRow{enum_name: "IOError", variant: "AlreadyExists", payload: [Type]{Type.Named{name: "IOContext"}}},
    CoreEnumPayloadRow{enum_name: "IOError", variant: "Unsupported", payload: [Type]{Type.Named{name: "IOContext"}}},
    CoreEnumPayloadRow{enum_name: "DataEvent", variant: "Null", payload: [Type]{}},
    CoreEnumPayloadRow{enum_name: "DataEvent", variant: "Bool", payload: [Type]{Type.Bool}},
    CoreEnumPayloadRow{enum_name: "DataEvent", variant: "Int", payload: [Type]{Type.Int}},
    CoreEnumPayloadRow{enum_name: "DataEvent", variant: "Float", payload: [Type]{Type.Float}},
    CoreEnumPayloadRow{enum_name: "DataEvent", variant: "Number", payload: [Type]{Type.String}},
    CoreEnumPayloadRow{enum_name: "DataEvent", variant: "Text", payload: [Type]{Type.String}},
    CoreEnumPayloadRow{enum_name: "DataEvent", variant: "Bytes", payload: [Type]{Type.List{element: Type.IntN{signed: false, bits: 8}}}},
    CoreEnumPayloadRow{enum_name: "DataEvent", variant: "ArrayStart", payload: [Type]{}},
    CoreEnumPayloadRow{enum_name: "DataEvent", variant: "ArrayEnd", payload: [Type]{}},
    CoreEnumPayloadRow{enum_name: "DataEvent", variant: "ObjectStart", payload: [Type]{}},
    CoreEnumPayloadRow{enum_name: "DataEvent", variant: "Key", payload: [Type]{Type.String}},
    CoreEnumPayloadRow{enum_name: "DataEvent", variant: "ObjectEnd", payload: [Type]{}},
    CoreEnumPayloadRow{enum_name: "PreparedValue", variant: "Int", payload: [Type]{Type.Int}},
    CoreEnumPayloadRow{enum_name: "PreparedValue", variant: "Float", payload: [Type]{Type.Float}},
    CoreEnumPayloadRow{enum_name: "PreparedValue", variant: "Bool", payload: [Type]{Type.Bool}},
    CoreEnumPayloadRow{enum_name: "PreparedValue", variant: "Char", payload: [Type]{Type.Char}},
    CoreEnumPayloadRow{enum_name: "PreparedValue", variant: "String", payload: [Type]{Type.String}},
    CoreEnumPayloadRow{enum_name: "PreparedValue", variant: "Enum", payload: [Type]{Type.Named{name: "PreparedCase"}}},
    CoreEnumPayloadRow{enum_name: "PreparedValue", variant: "List", payload: [Type]{Type.List{element: Type.Named{name: "PreparedValue"}}}},
    CoreEnumPayloadRow{enum_name: "PreparedValue", variant: "Struct", payload: [Type]{Type.Named{name: "PreparedStruct"}}},
    CoreEnumPayloadRow{enum_name: "PreparedValue", variant: "Unit", payload: [Type]{}},
}

// Owning an opaque impl or a compiler enum menu does not create an export.
// Qualified-annotation suffixes: the CORE_SOURCE_OWNED_ROWS impl types, then
// the enum names above, each once in first-occurrence order.
JET_CORE_OWNER_ANNOTATION_SUFFIXES: #run core_owner_annotation_suffixes(CORE_SOURCE_OWNED_ROWS, CORE_ENUM_PAYLOAD_ROWS)

core_owner_annotation_suffixes: fn(rows: [CoreSourceOwnedRow], payloads: [CoreEnumPayloadRow]) -> [String] Never! {
    suffixes := [String]{}
    loop row in rows {
        loop name in row.impl_types {
            if !suffixes.contains(".{name}") -> suffixes.push(".{name}")
        }
    }
    loop payload in payloads {
        if !suffixes.contains(".{payload.enum_name}") -> suffixes.push(".{payload.enum_name}")
    }
    suffixes
}
