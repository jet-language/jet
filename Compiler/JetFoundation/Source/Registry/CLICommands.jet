    {form: "<workspace with a computed `members:` expression>", ported: false, card: 6632, argv: [String]{}},
    {form: "<workspace whose `find` directory is missing>", ported: false, card: 6632, argv: [String]{}},
    {form: "<workspace member outside the workspace root>", ported: false, card: 6632, argv: [String]{}},
    {form: "<workspace with a missing member>", ported: false, card: 6632, argv: [String]{}},
    {form: "<workspace member without package.jet>", ported: false, card: 6632, argv: [String]{}},
    {form: "<workspace with a duplicate or nested member>", ported: false, card: 6632, argv: [String]{}},
    {form: "<workspace with two members of one name>", ported: false, card: 6632, argv: [String]{}},
    {form: "<project with a workspace lock>", ported: false, card: 6632, argv: [String]{}},
    {form: "<lock with a foreign source>", ported: false, card: 6632, argv: [String]{}},
    {form: "<lock with a `[[workspace_member]]` record>", ported: false, card: 6632, argv: [String]{}},
    {form: "<lock with a `[[browser]]` record>", ported: false, card: 6632, argv: [String]{}},
    {form: "<lock with a `[[build.contribution]]` record>", ported: false, card: 6632, argv: [String]{}},
    {form: "<lock with a `[[workspace_overlay]]` record>", ported: false, card: 6632, argv: [String]{}},
    {form: "<lock with a `[[workspace_overlay_package]]` record>", ported: false, card: 6632, argv: [String]{}},
    {form: "<lock with a `[[workspace_build_grant]]` record>", ported: false, card: 6632, argv: [String]{}},
    {form: "<lock with a `workspace_source_digest` row>", ported: false, card: 6632, argv: [String]{}},
