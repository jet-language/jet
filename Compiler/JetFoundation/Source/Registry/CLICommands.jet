        frequency_rank: 25,
        exhaustive: false,
        usage: Val("import <language> <dir> [--dry-run|--update]"),
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "new",
        summary: "Create a Jet project",
        frequency_rank: 16,
        exhaustive: false,
        usage: Val("new <name> [--template cli|ui|web|overrides]"),
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "fmt",
        summary: "Format Jet and configured project files",
        frequency_rank: 6,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "fix",
        summary: "Apply safe automatic fixes, including `fix memory`",
        frequency_rank: 11,
        exhaustive: false,
        usage: Val("fix <file.jet|dir>"),
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "audit",
        summary: "Inspect implicit copies, exercised memory witnesses, or dependencies",
        frequency_rank: 24,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "lint",
        summary: "Run optional code-quality checks",
        frequency_rank: 34,
        exhaustive: false,
        usage: Val("lint --a11y|--complexity <file.jet>"),
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "doc",
        summary: "Generate reference documentation",
        frequency_rank: 28,
        exhaustive: false,
        usage: Val("doc [--json|--check] [<file.jet|dir>]"),
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "explain",
        summary: "Explain a diagnostic code, build fact, generic-module value, or typed cost",
        frequency_rank: 7,
        exhaustive: false,
        usage: Val("explain <CODE|FACT> [file]"),
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "env",
        summary: "Open the project development shell",
        frequency_rank: 21,
        exhaustive: false,
        usage: None,
        // These are the shipped
        // `jetpack env` subverbs exposed through Jet's environment front door. `env`
        // stays non-exhaustive because `export` is a private callback used by the shell
        // hook and must continue downstream.
        actions: [JetCLIActionSpec]{
            {name: "test", usage: "test [-- command]", summary: "Run environment checks in a clean environment", handler: "Env", also_canonical_top_level: true},
            {name: "hook", usage: "hook <bash|zsh|fish>", summary: "Print the shell auto-activation hook", handler: "Env", also_canonical_top_level: false},
            {name: "sync", usage: "sync", summary: "Apply typed managed environment files", handler: "Env", also_canonical_top_level: false},
            {name: "info", usage: "info", summary: "Show the typed environment plan", handler: "Env", also_canonical_top_level: false},
            {name: "fetch-toolchain", usage: "fetch-toolchain", summary: "Download this jet's C toolchain pack for offline C builds", handler: "Env", also_canonical_top_level: false},
            {name: "vars", usage: "vars [--command=COMMAND] [--json] [-- FLAGS]", summary: "List the compiler controls with each one's value and the source that set it", handler: "Env", also_canonical_top_level: false},
        },
    },
    {
        name: "cache",
        summary: "Manage the machine-wide artifact store",
        frequency_rank: 49,
        exhaustive: true,
        usage: None,
        actions: [JetCLIActionSpec]{
            {name: "status", usage: "status", summary: "Show machine-wide artifact store usage", handler: "Cache", also_canonical_top_level: true},
            {name: "prune", usage: "prune --to <size>", summary: "Prune the artifact store to a target size", handler: "Cache", also_canonical_top_level: false},
            {name: "limit", usage: "limit --host <size>", summary: "Set the host-wide artifact store limit", handler: "Cache", also_canonical_top_level: false},
        },
    },
    {
        name: "remote",
        summary: "Manage host-owned remote builders",
        frequency_rank: 56,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    // #1659 criterion 1: `push`/`bridge`/`services` are `jet os` nested
    // actions (see OS_ACTIONS below) — declared once there, not here too.
    {
        name: "trust",
        summary: "Review or change trusted authority",
        frequency_rank: 45,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "image",
        summary: "Build a declared container image",
        frequency_rank: 35,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "os",
        summary: "Manage Jetos machines and images",
        frequency_rank: 12,
        exhaustive: false,
        usage: None,
        // `push`/`bridge`/`services`/`config` move under `jet os`.
        // This group is *not* exhaustive (see `CommandSpec::exhaustive`) — jetos's
        // own native verbs (`check`/`build`/`switch`/…) stay entirely
        // owned by the `jet os` dispatcher and are not modeled here.
        actions: [JetCLIActionSpec]{
            {name: "push", usage: "push", summary: "Deploy one or more Jetos machines", handler: "Push", also_canonical_top_level: false},
            {name: "bridge", usage: "bridge", summary: "Convert an existing system configuration to Jet", handler: "Bridge", also_canonical_top_level: false},
            {name: "services", usage: "services", summary: "Manage development services", handler: "Services", also_canonical_top_level: false},
            {name: "config", usage: "config", summary: "Manage Jet settings and trust", handler: "Config", also_canonical_top_level: false},
        },
    },
    {
        name: "add",
        summary: "Add and download a dependency",
        frequency_rank: 30,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "remove",
        summary: "Remove a dependency",
        frequency_rank: 57,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "fetch",
        summary: "Download locked dependencies",
        frequency_rank: 14,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "search",
        summary: "Search the local package catalog",
        frequency_rank: 51,
        exhaustive: false,
        usage: Val("search <query>"),
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "find",
        summary: "Find code by type, effect, or example",
        frequency_rank: 44,
        exhaustive: false,
        usage: Val("find [--effect <effect>] [--example <input -> output>] [<query>] [<file.jet|dir>]"),
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "update",
        summary: "Update dependency or toolchain pins",
        frequency_rank: 26,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "init",
        summary: "Create package settings in this directory",
        frequency_rank: 29,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "split",
        summary: "Extract closed Package facts into Configs or members",
        frequency_rank: 48,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "fold",
        summary: "Reverse a recorded Package source transition",
        frequency_rank: 43,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    // #1659 criterion 1: `config` is a `jet os` nested action (OS_ACTIONS).
    {
        name: "gc",
        summary: "Show values moved into automatic memory management",
        frequency_rank: 37,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{
            {name: "report", usage: "report", summary: "Show values moved into automatic memory management", handler: "GcReport", also_canonical_top_level: false},
        },
    },
    {
        name: "clean",
        summary: "Remove unused package-store data",
        frequency_rank: 47,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    // #1659 criterion 1: `publish`/`yank`/`keygen`/`key`/`vendor` are `jet
    // registry` nested actions (REGISTRY_ACTIONS); `audit`/`sbom` are `jet
    // inspect` nested actions (INSPECT_ACTIONS) — declared once there.
    {
        name: "emit",
        summary: "Print generated build output",
        frequency_rank: 27,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "eval",
        summary: "Evaluate pure Jet and print the value (`--json` for JSON)",
        frequency_rank: 22,
        exhaustive: false,
        usage: Val("eval <file.jet|expression>"),
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "budget",
        summary: "Check performance limits or update baselines",
        frequency_rank: 20,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "perf",
        summary: "Collect and inspect performance traces",
        frequency_rank: 18,
        exhaustive: true,
        usage: None,
        // `jet perf` owns collection/view/compare/export. `run` and
        // `test` stay canonical top-level intents and also live here so the group help
        // lists the full family. Measurement remains a mode of the canonical test
        // intent, not another perf-session action.
        actions: [JetCLIActionSpec]{
            {name: "run", usage: "run", summary: "Run a program and write a .jettrace", handler: "Perf", also_canonical_top_level: true},
            {name: "test", usage: "test", summary: "Run tests and write a .jettrace", handler: "Perf", also_canonical_top_level: true},
            {name: "attach", usage: "attach", summary: "Attach to a running process and write a .jettrace", handler: "Perf", also_canonical_top_level: false},
            {name: "view", usage: "view", summary: "Show a .jettrace summary", handler: "Perf", also_canonical_top_level: false},
            {name: "compare", usage: "compare", summary: "Compare two .jettrace artifacts", handler: "Perf", also_canonical_top_level: false},
            {name: "export", usage: "export", summary: "Export a loss-declared projection of a .jettrace", handler: "Perf", also_canonical_top_level: false},
        },
    },
    {
        name: "version",
        summary: "Show the Jet version",
        frequency_rank: 41,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "help",
        summary: "Show command help",
        frequency_rank: 19,
        exhaustive: false,
        usage: Val("help [<command>] [--sort frequency|az|za]"),
        actions: [JetCLIActionSpec]{},
    },
} }

// One form of the command model: the words after `jet` that select a
// command (`db`), a group action (`self lsp`), a flag of a command (`build
// --lib`), a flag value (`build --target wasm.wasi`) or, starting with `<`, a
// shape of a project or invocation any command can meet (`<workspace with a
// missing member>`). In a form `=` is a space and a `<...>` word stands for
// any one word that is not a flag. `ported` says whether this `jet` runs the
// form; while it does not, `card` is the Tower card that owns its port. A
// form no row decides is ported. `argv` is the invocation the command-model
// census runs (`<file>` is a scratch program); a form it cannot reach from an
// empty directory has none.
JetCLIFormSpec: struct {
    form: String
    ported: Bool
    card: Int
    argv: [String]
}

// The command model. The usage page, completions and man leave out every form
// a row marks unported (a group's own help page lists its whole family); the
// E2104 "not built yet" report names the row's card, and `jet help --all`
// lists the rows. A row names only a form with no implementation: `jet perf`
// lists its family, so the rows are its actions.
JET_CLI_FORMS: #run { [JetCLIFormSpec]{
    // Whole commands.
    {form: "db", ported: false, card: 6418, argv: [String]{"db"}},
    {form: "generate", ported: false, card: 6418, argv: [String]{"generate"}},
    {form: "package", ported: false, card: 6418, argv: [String]{"package"}},
    {form: "flash", ported: false, card: 6418, argv: [String]{"flash"}},
    {form: "notebook", ported: false, card: 6418, argv: [String]{"notebook"}},
    // Group actions.
    {form: "self update", ported: false, card: 6418, argv: [String]{"self", "update"}},
    {form: "self lsp", ported: true, card: 0, argv: [String]{"self", "lsp"}},
    {form: "self exec", ported: false, card: 6418, argv: [String]{"self", "exec"}},
    {form: "self devtools bless", ported: false, card: 5454, argv: [String]{"self", "devtools", "bless"}},
    {form: "os push", ported: false, card: 6604, argv: [String]{"os", "push"}},
    {form: "registry publish --to", ported: false, card: 6632, argv: [String]{"registry", "publish", "--to", "x"}},
    {form: "new service", ported: false, card: 6418, argv: [String]{"new", "service", "x"}},
    {form: "new route", ported: false, card: 6418, argv: [String]{"new", "route", "x"}},
    {form: "new job", ported: false, card: 6418, argv: [String]{"new", "job", "x"}},
    {form: "new migration", ported: false, card: 6418, argv: [String]{"new", "migration", "x"}},
    // Bindings: a C header, a data schema and a foreign-language source bind;
    // a named binding plan does not yet.
    {form: "bind <name>", ported: false, card: 6418, argv: [String]{"bind", "mylib"}},
    {form: "bind --shape", ported: false, card: 6418, argv: [String]{"bind", "mylib", "--shape", "native"}},
    {form: "bind --freeze", ported: false, card: 6418, argv: [String]{"bind", "mylib", "--freeze"}},
    {form: "bind --policy", ported: false, card: 6418, argv: [String]{"bind", "--policy", "frozen"}},
    {form: "bind --update", ported: false, card: 6418, argv: [String]{"bind", "mylib", "--update", "--preview"}},
    {form: "inspect bind <name>", ported: false, card: 6418, argv: [String]{"inspect", "bind", "mylib"}},
    // A Windows host only; elsewhere it is E3260.
    {form: "inspect bind com", ported: false, card: 6418, argv: [String]{}},
    // Needs a project root.
    {form: "inspect sbom", ported: false, card: 6418, argv: [String]{}},
    {form: "inspect --replay", ported: false, card: 6418, argv: [String]{}},
    {form: "inspect expand <all lenses>", ported: false, card: 6418, argv: [String]{}},
    {form: "inspect <plane> --profile <name>", ported: false, card: 6418, argv: [String]{}},
    {form: "explain --reload", ported: false, card: 6418, argv: [String]{"explain", "--reload", "<file>"}},
    {form: "explain --cost", ported: false, card: 6652, argv: [String]{"explain", "--cost", "<file>"}},
    {form: "lint --cost", ported: false, card: 6652, argv: [String]{"lint", "--cost", "<file>"}},
    {form: "prove --save", ported: false, card: 6418, argv: [String]{"prove", "--save=x", "<file>"}},
    {form: "prove --unsave", ported: false, card: 6418, argv: [String]{"prove", "--unsave=x", "<file>"}},
    {form: "repl --console", ported: false, card: 6418, argv: [String]{"repl", "--console"}},
    {form: "repl --sandbox", ported: false, card: 6418, argv: [String]{"repl", "--sandbox", "data"}},
    {form: "repl --console-ttl", ported: false, card: 6418, argv: [String]{"repl", "--console-ttl", "5"}},
    // REPL session commands.
    {form: "repl ?<language or Core name>", ported: false, card: 6418, argv: [String]{}},
    {form: "repl :rerun", ported: false, card: 6418, argv: [String]{}},
    {form: "repl :history", ported: false, card: 6418, argv: [String]{}},
    {form: "debug --dap", ported: false, card: 6386, argv: [String]{"debug", "--dap", "<file>"}},
    {form: "debug --raw-frames", ported: false, card: 6386, argv: [String]{"debug", "--raw-frames", "<file>"}},
    {form: "debug --record", ported: false, card: 6418, argv: [String]{"debug", "--record=x", "<file>"}},
    {form: "debug --replay", ported: false, card: 6418, argv: [String]{"debug", "--replay=x", "<file>"}},
    {form: "jobs --graph", ported: false, card: 6632, argv: [String]{"jobs", "--graph"}},
    {form: "jobs --status", ported: false, card: 6632, argv: [String]{"jobs", "--status"}},
    {form: "jobs --explain", ported: false, card: 6632, argv: [String]{"jobs", "--explain"}},
    {form: "jobs --watch", ported: false, card: 6632, argv: [String]{"jobs", "--watch"}},
    // Build flags, targets and profiles.
    {form: "build --lib", ported: false, card: 6418, argv: [String]{"build", "--lib", "<file>"}},
    {form: "build --verify", ported: false, card: 6418, argv: [String]{"build", "--verify", "x"}},
    {form: "build --import", ported: false, card: 6418, argv: [String]{"build", "--import", "<file>"}},
    {form: "build --builder", ported: false, card: 6418, argv: [String]{"build", "--builder=x", "<file>"}},
    {form: "build --output", ported: false, card: 6418, argv: [String]{"build", "--output=x", "<file>"}},
    // Refused until the shared watch engine drives `jet build`, never a silent single build.
    {form: "build --watch", ported: false, card: 6418, argv: [String]{"build", "--watch", "<file>"}},
    {form: "build --target <name>", ported: false, card: 6418, argv: [String]{"build", "--target=hosted", "<file>"}},
    {form: "build --target web", ported: true, card: 0, argv: [String]{"build", "--target=web", "<file>"}},
    {form: "build --target wasm.browser", ported: false, card: 5201, argv: [String]{"build", "--target=wasm.browser", "<file>"}},
    {form: "build --target wasm.no-os", ported: false, card: 5201, argv: [String]{"build", "--target=wasm.no-os", "<file>"}},
    {form: "build --target wasm.wasi", ported: false, card: 5201, argv: [String]{"build", "--target=wasm.wasi", "<file>"}},
    {form: "build --profile ci", ported: false, card: 6418, argv: [String]{"build", "--profile=ci", "<file>"}},
    {form: "build --profile hardened", ported: true, card: 6418, argv: [String]{"build", "--profile=hardened", "<file>"}},
    {form: "run --profile ci", ported: false, card: 6418, argv: [String]{"run", "--profile=ci", "<file>"}},
    {form: "run --profile hardened", ported: true, card: 6418, argv: [String]{"run", "--profile=hardened", "<file>"}},
    {form: "dev --profile ci", ported: false, card: 6418, argv: [String]{"dev", "--profile=ci", "<file>"}},
    {form: "dev --profile hardened", ported: true, card: 6418, argv: [String]{"dev", "--profile=hardened", "<file>"}},
    {form: "test --profile ci", ported: false, card: 6418, argv: [String]{"test", "--profile=ci", "<file>"}},
    {form: "test --profile hardened", ported: true, card: 6418, argv: [String]{"test", "--profile=hardened", "<file>"}},
    // `jet run` flags (JET_CLI_RUN_PORTED_FLAGS lists the ported ones).
    {form: "run --env", ported: false, card: 6418, argv: [String]{"run", "--env=x", "<file>"}},
    {form: "run --fixtures", ported: false, card: 6418, argv: [String]{"run", "--fixtures=x", "<file>"}},
    {form: "run --gc-trace", ported: false, card: 6418, argv: [String]{"run", "--gc-trace", "<file>"}},
    {form: "run --locked", ported: false, card: 6418, argv: [String]{"run", "--locked", "<file>"}},
    {form: "run --observe", ported: true, card: 0, argv: [String]{"run", "--observe", "<file>"}},
    {form: "run --log", ported: true, card: 0, argv: [String]{"run", "--log=warn", "<file>"}},
    {form: "dev --log", ported: true, card: 0, argv: [String]{"dev", "--log=warn", "<file>"}},
    {form: "run --deep-checks", ported: true, card: 0, argv: [String]{"run", "--deep-checks", "<file>"}},
    {form: "dev --deep-checks", ported: true, card: 0, argv: [String]{"dev", "--deep-checks", "<file>"}},
    {form: "run --offline", ported: false, card: 6418, argv: [String]{"run", "--offline", "<file>"}},
    {form: "run --output", ported: false, card: 6418, argv: [String]{"run", "--output=x", "<file>"}},
    {form: "run --preset", ported: false, card: 6418, argv: [String]{"run", "--preset=x", "<file>"}},
    {form: "run --record", ported: false, card: 6418, argv: [String]{"run", "--record=x", "<file>"}},
    {form: "run --target", ported: false, card: 6418, argv: [String]{"run", "--target=x", "<file>"}},
    {form: "run --watch", ported: false, card: 6418, argv: [String]{"run", "--watch", "<file>"}},
    {form: "run <package>@nixpkgs", ported: false, card: 6632, argv: [String]{"run", "hello@nixpkgs"}},
    // `jet dev` hosts and flags.
    {form: "dev --canvas", ported: true, card: 0, argv: [String]{"dev", "--canvas", "<file>"}},
    {form: "dev --app", ported: false, card: 6386, argv: [String]{"dev", "--app=f", "<file>"}},
    {form: "dev --share", ported: false, card: 6386, argv: [String]{"dev", "--share=lan", "<file>"}},
    {form: "dev --canvas-audit", ported: false, card: 6386, argv: [String]{"dev", "--canvas-audit", "<file>"}},
    {form: "dev --canvas-authority", ported: false, card: 6386, argv: [String]{"dev", "--canvas-authority=x", "<file>"}},
    {form: "dev --canvas-host", ported: true, card: 0, argv: [String]{"dev", "--canvas", "--canvas-host=x", "<file>"}},
    {form: "dev --canvas-port", ported: true, card: 0, argv: [String]{"dev", "--canvas", "--canvas-port=1", "<file>"}},
    {form: "dev --canvas-transport", ported: false, card: 6386, argv: [String]{"dev", "--canvas-transport=x", "<file>"}},
    {form: "dev --env", ported: false, card: 6386, argv: [String]{"dev", "--env=x", "<file>"}},
    {form: "dev --fixtures", ported: false, card: 6386, argv: [String]{"dev", "--fixtures=x", "<file>"}},
    {form: "dev --gc-trace", ported: false, card: 6386, argv: [String]{"dev", "--gc-trace", "<file>"}},
    {form: "dev --output", ported: false, card: 6386, argv: [String]{"dev", "--output=x", "<file>"}},
    {form: "dev --no-capture", ported: false, card: 6386, argv: [String]{"dev", "--no-capture", "<file>"}},
    {form: "dev --offline", ported: false, card: 6386, argv: [String]{"dev", "--offline", "<file>"}},
    {form: "dev --preset", ported: false, card: 6386, argv: [String]{"dev", "--preset=x", "<file>"}},
    {form: "dev --record", ported: false, card: 6386, argv: [String]{"dev", "--record=x", "<file>"}},
    {form: "dev --restart", ported: false, card: 6386, argv: [String]{"dev", "--restart", "<file>"}},
    {form: "dev --swap", ported: false, card: 6386, argv: [String]{"dev", "--swap", "<file>"}},
    {form: "dev --target", ported: false, card: 6386, argv: [String]{"dev", "--target=x", "<file>"}},
    {form: "dev --token", ported: false, card: 6386, argv: [String]{"dev", "--token=x", "<file>"}},
    {form: "dev --try-anyway", ported: false, card: 6386, argv: [String]{"dev", "--try-anyway", "<file>"}},
    // `jet test` flags; an unported test setting (TestSettings.jet) has its flag's row here.
    {form: "test --where", ported: false, card: 6418, argv: [String]{"test", "--where=x", "<file>"}},
    {form: "test --watch", ported: false, card: 6418, argv: [String]{"test", "--watch", "<file>"}},
    {form: "test --time", ported: false, card: 6015, argv: [String]{"test", "--time=5", "<file>"}},
    {form: "test --corpus", ported: false, card: 6015, argv: [String]{"test", "--corpus=d", "<file>"}},
    {form: "test --browser", ported: false, card: 4954, argv: [String]{"test", "--browser=x", "<file>"}},
    {form: "test --browser-retries", ported: false, card: 4954, argv: [String]{"test", "--browser-retries=2", "<file>"}},
    {form: "test --browser-reporter", ported: false, card: 4954, argv: [String]{"test", "--browser-reporter=x", "<file>"}},
    {form: "test --browser-ui", ported: false, card: 4954, argv: [String]{"test", "--browser-ui", "<file>"}},
    {form: "test --browser-visual", ported: false, card: 4954, argv: [String]{"test", "--browser-visual", "<file>"}},
    {form: "test --browser-trace", ported: false, card: 4954, argv: [String]{"test", "--browser-trace", "<file>"}},
    {form: "test --browser-scaffold", ported: false, card: 6418, argv: [String]{"test", "--browser-scaffold", "<file>"}},
    // Shapes: what the command meets, after the words that name the command.
    // A bare `--shuffle` seeds from the clock, which the Jet host does not read yet.
    {form: "<--shuffle without a seed>", ported: false, card: 6418, argv: [String]{"test", "--shuffle", "<file>"}},
    // Only a native test run is instrumented; a corpus row never is.
    {form: "<corpus run with --coverage>", ported: false, card: 6418, argv: [String]{}},
    {form: "<package build with --sbom>", ported: false, card: 6418, argv: [String]{}},
    {form: "<package whose run default names no output>", ported: false, card: 6418, argv: [String]{}},
    {form: "<project without an entry>", ported: false, card: 6418, argv: [String]{}},
