            {name: "hook", usage: "hook <bash|zsh|fish>", summary: "Print the shell auto-activation hook", handler: "Env", also_canonical_top_level: false},
            {name: "sync", usage: "sync", summary: "Apply typed managed environment files", handler: "Env", also_canonical_top_level: false},
            {name: "info", usage: "info", summary: "Show the typed environment plan", handler: "Env", also_canonical_top_level: false},
        },
    },
    {
        name: "shared-store",
        summary: "Manage the optional shared package broker",
        headline: false,
        frequency_rank: 61,
        exhaustive: true,
        usage: None,
        actions: [JetCLIActionSpec]{
            {name: "install", usage: "install", summary: "Install the optional shared package broker", handler: "SharedStore", also_canonical_top_level: false},
            {name: "enroll", usage: "enroll <uid> [--read-only]", summary: "Grant a user shared-store broker access", handler: "SharedStore", also_canonical_top_level: false},
            {name: "status", usage: "status", summary: "Show shared-store broker configuration", handler: "SharedStore", also_canonical_top_level: false},
            {name: "broker", usage: "broker [--fd <n>]", summary: "Serve one shared-store broker request", handler: "SharedStore", also_canonical_top_level: false},
        },
    },
    {
        name: "cache",
        summary: "Manage the machine-wide artifact store",
        headline: false,
        frequency_rank: 52,
        exhaustive: true,
        usage: None,
        actions: [JetCLIActionSpec]{
            {name: "status", usage: "status", summary: "Show machine-wide artifact store usage", handler: "Cache", also_canonical_top_level: true},
            {name: "prune", usage: "prune --to <size>", summary: "Prune the artifact store to a target size", handler: "Cache", also_canonical_top_level: false},
            {name: "limit", usage: "limit --host <size>", summary: "Set the host-wide artifact store limit", handler: "Cache", also_canonical_top_level: false},
        },
    },
    {
        name: "remote",
        summary: "Manage host-owned remote builders",
        headline: false,
        frequency_rank: 54,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    // #1659 criterion 1: `push`/`bridge`/`services` are `jet os` nested
    // actions (see OS_ACTIONS below) — declared once there, not here too.
    {
        name: "trust",
        summary: "Review or change trusted authority",
        headline: false,
        frequency_rank: 44,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "image",
        summary: "Build a declared container image",
        headline: false,
        frequency_rank: 27,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "os",
        summary: "Manage Jetos machines and images",
        headline: false,
        frequency_rank: 11,
        exhaustive: false,
        usage: None,
        // `push`/`bridge`/`services`/`config` move under `jet os`.
        // This group is *not* exhaustive (see `CommandSpec::exhaustive`) — jetos's
        // own native verbs (`check`/`build`/`switch`/…) stay entirely
        // owned by the `jet os` dispatcher and are not modeled here.
        actions: [JetCLIActionSpec]{
            {name: "push", usage: "push", summary: "Deploy one or more Jetos machines", handler: "Push", also_canonical_top_level: false},
            {name: "bridge", usage: "bridge", summary: "Convert an existing system configuration to Jet", handler: "Bridge", also_canonical_top_level: false},
            {name: "services", usage: "services", summary: "Manage development services", handler: "Services", also_canonical_top_level: false},
            {name: "config", usage: "config", summary: "Manage Jet settings and trust", handler: "Config", also_canonical_top_level: false},
        },
    },
    {
        name: "add",
        summary: "Add and download a dependency",
        headline: false,
        frequency_rank: 34,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "remove",
        summary: "Remove a dependency",
        headline: false,
        frequency_rank: 58,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "fetch",
        summary: "Download locked dependencies",
        headline: false,
        frequency_rank: 14,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "search",
        summary: "Search the local package catalog",
        headline: false,
        frequency_rank: 49,
        exhaustive: false,
        usage: Val("search <query>"),
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "find",
        summary: "Find code by type, effect, or example",
        headline: false,
        frequency_rank: 43,
        exhaustive: false,
        usage: Val("find [--effect <effect>] [--example <input -> output>] [<query>] [<file.jet|dir>]"),
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "update",
        summary: "Update dependency or toolchain pins",
        headline: false,
        frequency_rank: 22,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "init",
        summary: "Create package settings in this directory",
        headline: false,
        frequency_rank: 25,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "split",
        summary: "Extract closed Package facts into Configs or members",
        headline: false,
        frequency_rank: 51,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "fold",
        summary: "Reverse a recorded Package source transition",
        headline: false,
        frequency_rank: 50,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    // #1659 criterion 1: `config` is a `jet os` nested action (OS_ACTIONS).
    {
        name: "gc",
        summary: "Show values moved into automatic memory management",
        headline: false,
        frequency_rank: 31,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{
            {name: "report", usage: "report", summary: "Show values moved into automatic memory management", handler: "GcReport", also_canonical_top_level: false},
        },
    },
    {
        name: "clean",
        summary: "Remove unused package-store data",
        headline: false,
        frequency_rank: 32,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    // #1659 criterion 1: `publish`/`yank`/`keygen`/`key`/`vendor` are `jet
    // registry` nested actions (REGISTRY_ACTIONS); `audit`/`sbom` are `jet
    // inspect` nested actions (INSPECT_ACTIONS) — declared once there.
    {
        name: "emit",
        summary: "Print generated build output",
        headline: false,
        frequency_rank: 30,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "eval",
        summary: "Evaluate pure Jet and print the value (`--json` for JSON)",
        headline: false,
        frequency_rank: 23,
        exhaustive: false,
        usage: Val("eval <file.jet|expression>"),
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "budget",
        summary: "Check performance limits or update baselines",
        headline: false,
        frequency_rank: 20,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "perf",
        summary: "Collect and inspect performance traces",
        headline: false,
        frequency_rank: 19,
        exhaustive: true,
        usage: None,
        // `jet perf` owns collection/view/compare/export. `run` and
        // `test` stay canonical top-level intents and also live here so the group help
        // lists the full family. Measurement remains a mode of the canonical test
        // intent, not another perf-session action.
        actions: [JetCLIActionSpec]{
            {name: "run", usage: "run", summary: "Run a program and write a .jettrace", handler: "Perf", also_canonical_top_level: true},
            {name: "test", usage: "test", summary: "Run tests and write a .jettrace", handler: "Perf", also_canonical_top_level: true},
            {name: "attach", usage: "attach", summary: "Attach to a running process and write a .jettrace", handler: "Perf", also_canonical_top_level: false},
            {name: "view", usage: "view", summary: "Show a .jettrace summary", handler: "Perf", also_canonical_top_level: false},
            {name: "compare", usage: "compare", summary: "Compare two .jettrace artifacts", handler: "Perf", also_canonical_top_level: false},
            {name: "export", usage: "export", summary: "Export a loss-declared projection of a .jettrace", handler: "Perf", also_canonical_top_level: false},
        },
    },
    {
        name: "fuzz",
        summary: "Find failing inputs for property tests",
        headline: false,
        frequency_rank: 40,
        exhaustive: false,
        usage: Val("fuzz <file.jet> [<test>]"),
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "version",
        summary: "Show the Jet version",
        headline: false,
        frequency_rank: 39,
        exhaustive: false,
        usage: None,
        actions: [JetCLIActionSpec]{},
    },
    {
        name: "help",
        summary: "Show command help",
        headline: false,
        frequency_rank: 21,
        exhaustive: false,
        usage: Val("help [<command>] [--sort frequency|az|za]"),
        actions: [JetCLIActionSpec]{},
    },
} }

JET_CLI_FLAGS :: prep { [JetCLIFlagSpec]{
    {long: "--live", help: "With inspect: Process id for a live plane scope"},
    {long: "--observe", help: "With run: Expose bounded live runtime facts for attachment"},
    {long: "--raw-frames", help: "With debug: Show generated Rust frames and scopes (expert)"},
    {long: "--dap", help: "With debug: Speak the Debug Adapter Protocol over stdio"},
    {long: "--gc-trace", help: "With run/dev: Record bounded automatic GC-promotion evidence"},
    {long: "--structural", help: "With diff/merge: Compare checked definitions by semantic identity"},
    {long: "--base-receipt", help: "With review: Proof receipt for the base change-set side"},
    {long: "--receipt", help: "With review: Proof receipt for the reviewed change-set side"},
    {long: "--out", help: "With structural merge: Write the checked result to this path"},
    {long: "--repo", help: "With merge install-driver: Git worktree to configure"},
    {long: "--json", help: "Emit machine-readable facts or diagnostics"},
    {long: "--topic", help: "With inspect digest: Emit one digest topic"},
    {long: "--to", help: "With publish/cache/db migrate: Foreign registry, prune target size, or migration target version"},
    {long: "--list-topics", help: "With inspect digest: List digest topics"},
    {long: "--kind", help: "With inspect gates/package: Filter one gate or bundle kind"},
    // #1659 criterion 3: one spelling, every command. Suppresses non-error
    // status/progress output (watch banners, hot-swap notices,
    // confirmations); never suppresses errors or requested data.
    {long: "--quiet", help: "Suppress non-error status output"},
    {long: "--color", help: "Color: auto | always | never"},
    {long: "--version", help: "With package/new: Set bundle or migration version; global flag prints compiler version"},
    {long: "--endpoint", help: "With self-update: Signed toolchain channel endpoint"},
    {long: "--channel", help: "With self-update: Toolchain channel name"},
    {long: "--platform", help: "With self-update: Toolchain target triple"},
    {long: "--trust-key", help: "With self-update: Public trust-key file"},
    {long: "--apply", help: "With self-update/generate/new: Apply the verified artifact or planned source writes"},
    {long: "--preview", help: "With new: Preview deterministic backend source writes without applying them"},
    {long: "--remove", help: "With new: Remove only unchanged outputs recorded by the scaffold receipt"},
    {long: "--path", help: "With new: Route or output path, defaulting to `/<name>`"},
    {long: "--route", help: "With new: Alias for `--path`"},
    {long: "--model", help: "With new: Model name recorded beside the route source"},
    {long: "--allow-unofficial", help: "With self-update: Explicitly allow a local keyless channel"},
    {long: "--check", help: "With fmt: Check without changing files (CI gate)"},
    {long: "--lang", help: "With fmt: Delegate non-Jet files to the environment formatter for this language"},
    {long: "--restore-role-files", help: "With init: Restore the exact pre-package.jet role files"},
    {long: "--diff", help: "With fmt --check: Also print unified diffs for each changed file"},
    {long: "--simplify", help: "With fmt: Rewrite to the simplest canonical spelling"},
    {long: "--changed", help: "With fmt: Format only VCS-changed .jet files (requires git)"},
    {long: "--explicit-copies", help: "With fmt: Materialize implicit read-view copies as `.copy()`"},
    {long: "--skipped", help: "With project parts: Show modules omitted from automatic discovery"},
    {long: "--stdin-path", help: "With fmt -: Path label used in diagnostics when reading from stdin"},
    {long: "--small", help: "With build/run/jobs: Favor a smaller binary"},
    {long: "--lib", help: "With build: Emit the native Library and C header"},
    {long: "--output", help: "With build/run/dev/jobs/package: Select a named output (build --lib selects a Library; Canvas uses it as the initial selection)"},
    {long: "--locked", help: "With build/fetch/jobs/run: Require locked dependency and provenance facts"},
    {long: "--effect", help: "With find: Require an effect such as FS.Read"},
    {long: "--example", help: "With find: Search by input/output example"},
    // Script locking folds into `fetch`, not a separate verb.
    {long: "--lock", help: "With fetch/db migrate/new: Lock dependency fetching or choose a migration/scaffold lock policy"},
    {long: "--read-only", help: "With shared-store enroll: Grant read-only broker access"},
    {long: "--host", help: "With cache limit: Host-wide store cap"},
    {long: "--fd", help: "With shared-store broker: Inherited broker socket descriptor"},
    // Select one workspace member.
    {long: "-p", help: "With run/dev/debug/check/build/jobs: Pick a workspace member by name"},
    {long: "--annotated", help: "With new: Include commented example deps"},
    {long: "--force", help: "With publish: Bypass pre-publish gate (with warning)"},
    // #1659 criterion 1 (round 2): these 8 flags previously lived only in
    // usage-string prose (`NestedCommandSpec::usage`), invisible to
    // `is_known_flag`/`closest_flag` (E2102 "did you mean"), the man page,
    // and shell completions. Real rows here fix all three renderers at once.
    {long: "--no-sign", help: "With publish: Skip the optional author signature (registry metadata is still signed)"},
    {long: "--registry", help: "With keygen/key: Registry name to generate or manage a signing key for"},
    {long: "--pkg", help: "With bind: Library name for the generated binding module"},
    {long: "--shape", help: "With bind: Binding facade shape: automatic or native"},
    {long: "--freeze", help: "With bind: Record the resolved binding plan in the project lock"},
    {long: "--policy", help: "With bind: Binding policy: automatic or frozen"},
    {long: "--accept", help: "With bind --update: Accept exactly this candidate plan digest"},
    {long: "--import", help: "With build: Import and inspect an existing foreign build graph"},
    {long: "--clang", help: "With bind cpp: Path to the clang binary used to parse the header"},
    {long: "--ar", help: "With bind cpp: Path to the ar archiver used to build the static library"},
    {long: "--before", help: "With schema squash: Re-baseline migrations before this version"},
    {long: "--spdx", help: "With sbom: Emit SPDX tag-value format (default)"},
    {long: "--cyclonedx", help: "With sbom: Emit CycloneDX JSON format"},
    {long: "--advisory-db", help: "With audit: Path to advisory database file"},
    {long: "--vendor-dir", help: "With vendor: Directory to copy dependencies into (default vendor/)"},
    {long: "--sbom", help: "With build: Also write an SPDX SBOM next to the binary"},
    {long: "--verbose", help: "With build/jobs: Print the bridge steps; with check: print the status line, proof rows, and receipt notices; with run/dev/test: show advisory lints; with explain: show a syntax token's registry name and decision"},
    {long: "--template", help: "With new: Start from a named template: cli, ui, web, or overrides"},
    {long: "--sort", help: "With help: Order commands by use (frequency, the default), A to Z (az), or Z to A (za)"},
    {long: "--online", help: "With doctor: Allow network checks"},
    {long: "--fix", help: "With doctor: Apply auto-fixable problems"},
    {long: "--dry-run", help: "With package/rewrite commands/generate: Preview changes without writing"},
    {long: "--entry", help: "With generate: Source file containing the generator job"},
    {long: "--keep", help: "With try: Keep a clean speculative edit"},
    {long: "--edition", help: "With fix: Apply edition migration rewrites --edition=<year>"},
    {long: "--all", help: "With fix: Apply safety classes beyond formatting and behavior-preserving"},
    {long: "--try-anyway", help: "With dev --canvas: Evaluate past unsupported features (no guarantees)"},
    {long: "--restart", help: "With dev: Always rerun from scratch after a save"},
    {long: "--swap", help: "With dev: Hot-swap compatible edits and restart after type changes"},
    {long: "--reload", help: "With explain: Explain the checked reload decision for a source or project path"},
    {long: "--watch", help: "With run/dev/test/jobs: Re-run on dependency changes; test default off with r=failed, a=all, o=output; jobs accepts --watch[=<on|off>]; --watch=off runs once"},
    {long: "--graph", help: "With jobs: Show the checked job dependency graph"},
    {long: "--status", help: "With jobs: Show fresh or stale status for declared jobs"},
    {long: "--explain", help: "With jobs/package: Explain dependencies, phases, cache identity, and admission facts"},
    {long: "--canvas", help: "With dev: Open the full Canvas IDE over this dev session"},
    {long: "--app", help: "With dev: Select a checked local-app function"},
    {long: "--share", help: "With dev: Select local-app sharing authority: loopback or lan"},
    {long: "--canvas-host", help: "With dev: With --canvas, bind host (loopback by default)"},
    {long: "--canvas-port", help: "With dev: With --canvas, bind an explicit port"},
    {long: "--canvas-transport", help: "With dev: With --canvas, select the named transport"},
    {long: "--canvas-authority", help: "With dev: With --canvas, select loopback or remote authority"},
    {long: "--canvas-audit", help: "With dev: With --canvas, enable request/rebuild audit output"},
    // E2-M18 REPL flags.
    {long: "--project", help: "With repl: Load package settings and imports from this directory"},
    {long: "--console", help: "With repl: Open the project-loaded capability-gated console"},
    {long: "--sandbox", help: "With repl: Use the reversible data sandbox (`--sandbox data`)"},
    {long: "--console-ttl", help: "With repl: Expire console authority after this many milliseconds"},
    // E3 interactive scripting flags.
    {long: "--protocol", help: "With notebook: Use the bounded headless JSONL/script session"},
    {long: "--headless", help: "With notebook: Use the bounded headless session"},
    {long: "--bind", help: "With notebook: Bind the local HTTP client to this address"},
    {long: "--token", help: "With notebook/dev: Require a bearer token for the session"},
    // E2-M16 flags.
    // `jet run` delegates project environment realization
    // to Jetpack unless the caller explicitly opts out.
    {long: "--no-prepare", help: "With run: Refuse Jetpack project environment preparation"},
    {long: "--pure", help: "With eval: Reject code with side effects"},
    {long: "--allow", help: "With run/build/jobs/repl/db: Allow comma-separated effect roots or leaves as --allow=RIGHTS"},
    {long: "--deny", help: "With run/build/jobs/repl/db: Deny comma-separated effect roots or leaves as --deny=RIGHTS"},
    {long: "--offline", help: "With env/run/dev/test/cc/c++: Reuse only cached signed toolchain and package data"},
    {long: "--fixtures", help: "With env/run/dev/test/cc/c++: Use an explicit fixture bundle"},
    {long: "--project-root", help: "With cc/c++: Scope source paths to a project directory"},
    {long: "--build-root", help: "With cc/c++: Scope output paths to a build directory"},
    {long: "-c", help: "With cc/c++: Compile sources without linking"},
    {long: "-o", help: "With cc/c++: Choose the output path"},
    {long: "-MMD", help: "With cc/c++: Emit user-header dependency data"},
    {long: "-MD", help: "With cc/c++: Emit dependency data"},
    {long: "-MF", help: "With cc/c++: Choose the dependency-file path"},
    {long: "-MT", help: "With cc/c++: Choose the dependency target"},
    {long: "--sysroot", help: "With cc/c++: Reserved; target selects the pinned sysroot"},
    {long: "-I", help: "With cc/c++: Add a project-relative include path"},
    {long: "-D", help: "With cc/c++: Define a preprocessor symbol"},
    {long: "-L", help: "With cc/c++: Add a project-relative library path"},
    {long: "-l", help: "With cc/c++: Link a declared library"},
    {long: "-std", help: "With cc/c++: Select the language standard"},
    {long: "-dumpmachine", help: "With cc/c++: Print the pinned target triple"},
    {long: "-print-sysroot", help: "With cc/c++: Print the pinned virtual sysroot"},
    {long: "-dumpversion", help: "With cc/c++: Print the pinned compiler version"},
    {long: "-v", help: "With cc/c++: Print pinned toolchain details or compile verbosely"},
    // One invocation gate surface covers every audited escape.
    {long: "--gate", help: "With build/run/dev/jobs: Allow one audited gate as --gate name=allow"},
    {long: "--target", help: "With build/run/dev/jobs/package/cc/c++/flash: Select a target (triple, board.<name>, or named database target)"},
    {long: "--up", help: "With db migrate/new: Checked forward SQL"},
    {long: "--sql", help: "With db migrate/new: Alias for checked forward SQL"},
    {long: "--down", help: "With db migrate/new: Checked inverse SQL for rollback"},
    {long: "--database", help: "With db migrate: Project-relative database path (receipt identity is redacted)"},
    {long: "--risk", help: "With db migrate/new: Data-risk note shown before writes"},
    {long: "--step", help: "With db migrate: Number of ordered migrations to apply or roll back"},
    // Bounded SQL console options share the canonical flag
    // registry with migration options and generated help/completions.
    {long: "--format", help: "With db: Output format: human, text, json, jsonl, or csv"},
    {long: "--csv", help: "With db: Select deterministic CSV output"},
    {long: "--jsonl", help: "With db: Emit one JSON value per row"},
    {long: "--machine", help: "With db: Select machine-readable output"},
    {long: "--human", help: "With db: Select human-readable output"},
    {long: "--no-color", help: "With db: Disable color in console output"},
    {long: "--force-color", help: "With db: Force color in console output"},
    {long: "--query", help: "With db: Execute one SQL query"},
    {long: "--script", help: "With db: Execute SQL from a script path"},
    {long: "--table", help: "With db: Set an explicit table identity as NAME=PATH"},
    {long: "--max-rows", help: "With db: Bound decoded input rows"},
    {long: "--max-bytes", help: "With db: Bound source or script bytes"},
    {long: "--max-output-bytes", help: "With db: Bound one rendered result"},
    {long: "--image", help: "With flash: Firmware image to program"},
    {long: "--audit", help: "With flash: Target audit JSON for the image"},
    {long: "--adapter", help: "With flash: Flash adapter: probe-rs, openocd, or emulator"},
    {long: "--package", help: "With package: Set the bundle package identifier"},
    {long: "--name", help: "With package: Set the bundle executable name"},
    {long: "--executable", help: "With package: Path to the executable to bundle"},
    {long: "--icon", help: "With package: Path to the bundle icon"},
    {long: "--icon-format", help: "With package: Icon format: png, icns, ico, or svg"},
    {long: "--icon-size", help: "With package: Icon size in pixels"},
    {long: "--publisher", help: "With package: Publisher metadata"},
    {long: "--description", help: "With package: Application description metadata"},
    {long: "--update-channel", help: "With package: Updater channel"},
    {long: "--update-url", help: "With package: Updater URL"},
    {long: "--game", help: "With package: Build a game bundle"},
    {long: "--source", help: "With package: Project source or package root for a game bundle"},
    {long: "--phase", help: "With package: Comma-separated game phases: build, cook, stage, package, export, deploy, run"},
    {long: "--backend", help: "With package: Game build backend: aot"},
    {long: "--renderer", help: "With package: Game renderer authority: headless or raylib"},
    {long: "--cook", help: "With package: Alias for --cook-mode"},
    {long: "--cook-mode", help: "With package: Asset cooking mode: fast, reproducible, or scripts-only"},
    {long: "--export", help: "With package: Export phase or named export preset"},
    {long: "--export-preset", help: "With package: Named export preset: default, store, or headless"},
    {long: "--deploy", help: "With package: Include the deploy phase"},
    {long: "--deploy-to", help: "With package: Explicit deployment destination"},
    {long: "--crash-reporter", help: "With package: Crash reporter policy: off, on, or opt-in"},
    {long: "--crash-consent", help: "With package: Crash reporter consent: not-requested, granted, or denied"},
    {long: "--cancel", help: "With package: Cancel owned game staging"},
    {long: "--resume", help: "With package: Resume an owned game stage"},
    {long: "--clean", help: "With package: Force-clean owned game cache/staging"},
    {long: "--force-clean", help: "With package: Alias for --clean"},
    {long: "--scripts-only", help: "With package: Cook only script assets"},
    {long: "--run-now", help: "With package: Explicitly opt into the run phase"},
    {long: "--run", help: "With package: Include the run phase"},
    // `--env` selects one environment module; it never names a
    // preset and has no retired-spelling alias.
    {long: "--env", help: "With env/run/dev/test: Select one declared env.<name> module"},
    // `--preset` selects a named environment composition.
    {long: "--preset", help: "With env/run/dev/test: Select one declared environment preset"},
    {long: "--explain-partition", help: "With build --target=web: Show which code becomes JavaScript or WebAssembly"},
    {long: "--fresh", help: "With test: Bypass only cached test results (default off); the build cache remains reusable"},
    {long: "--docs", help: "With test: Run checked documentation examples only (default off)"},
    {long: "--where", help: "With test: Filter recorded package, dependency, path, tag, or status facts (default all) as --where=<expr>"},
    {long: "--capture", help: "With test: Capture output as failed, all, or none (default failed); watch key o cycles it"},
    {long: "--no-capture", help: "With dev: Disable automatic replay capture for this session"},
    {long: "--update-snapshots", help: "With test: Replace expected snapshot output"},
    {long: "--update", help: "With import: Merge generated Jet into an existing target"},
    {long: "--coverage", help: "With test/inspect build: Show function or diagnostic coverage"},
    {long: "--verify", help: "With build: Rebuild and compare one indexed receipt artifact"},
    {long: "--rust", help: "With emit: Print generated Rust source"},
    // Jet-only emit tiers (owner-directed 2026-10-15); the frozen Rust host
    // table never gains them (Compiler/Bootstrap/check-command-table.mjs).
    {long: "--ast", help: "With emit: Print the parsed syntax tree"},
    {long: "--mir", help: "With emit: Print the checked MIR"},
    {long: "--lir", help: "With emit: Print the LIR the native backend lowers, before its optimization passes"},
    {long: "--fn", help: "With emit --ast/--mir/--lir: Print only the named function"},
    {long: "--emit-generated", help: "With build: Copy generated Jet sources into `.jet/generated/`"},
    {long: "-u", help: "Short form of --update-snapshots"},
    // (ratified 2026-06-25): named optimization bundles.
    {long: "--release", help: "With build/run/dev/jobs/test: Optimize for release"},
    {long: "--profile", help: "With build/run/dev/jobs/package/test: How hard to optimize: release, debug, ci, hardened, or a named optimization bundle"},
    // Command-line contribution to one typed package setting.
    {long: "--set", help: "With build/run/dev/jobs/test: Set one declared package setting as key=value"},
    // The compiler's thread cap; never the program's own threads.
    {long: "--threads", help: "With build/run/check/test/dev/inspect: Use at most N compiler threads (1 = one thread); without it jet picks a safe number of compiler threads"},
    // Jet-only (owner-directed 2026-10-16): the compiler's streaming trace,
    // the flag form of JET_TRACE_FILE; the frozen Rust host table never gains
    // it (Compiler/Bootstrap/check-command-table.mjs).
    {long: "--trace", help: "With build/run/check/test/emit: Stream the compiler's phases and progress to stderr, or to FILE with --trace=FILE"},
    {long: "--builder", help: "With build/jobs: Select a previously bound remote builder"},
    // (c134 Phase 6): accessibility is an opt-in lint category.
    {long: "--a11y", help: "With lint: Check roles, labels, and other accessibility basics"},
    {long: "--complexity", help: "With lint: Report per-function cognitive complexity"},
    {long: "--cost", help: "With lint/explain: Show typed hidden-copy and fallback costs"},
    {long: "--max", help: "With lint --complexity: Fail when a function exceeds this score"},
    {long: "--scope", help: "With inspect: Choose a ledger or trust scope"},
    {long: "--core", help: "With inspect structure: Show the canonical core module export facts"},
    // The shared test name-selection flag.
    {long: "--filter", help: "With test: Only run claims whose name contains --filter=<substr>"},
    {long: "--grade", help: "With test: Select the generated property-test grade as --grade=generated"},
    {long: "--shuffle", help: "With test: Run tests in random (or --shuffle=<seed>) order"},
    {long: "--serial", help: "With test: Run tests one at a time instead of the parallel default"},
    {long: "--show-default", help: "With run/build/dev/test: Use and report the stock default"},
    {long: "--measure", help: "With test: Measure `.measure` claims"},
    // Native cross-browser test controls.
    {long: "--browser", help: "With test/db: Select browser engines for tests or serve a loopback database inspector"},
    {long: "--browser-retries", help: "With test: Retry each browser attempt up to five times"},
    {long: "--browser-reporter", help: "With test: Browser report format: text, json, or html"},
    {long: "--browser-ui", help: "With test: Write/open the local browser report viewer"},
    {long: "--browser-visual", help: "With test: Capture screenshots for passing browser attempts"},
    {long: "--browser-trace", help: "With test: Keep redacted BiDi trace entries for every browser attempt"},
    {long: "--browser-scaffold", help: "With test: Create an isolated browser-test project as --browser-scaffold=<name>"},
    {long: "--record", help: "With run/dev/test/debug: Record a named replay as --record=<name>"},
    {long: "--replay", help: "With inspect/debug: Consume a named replay artifact"},
    // `jet fuzz` (its own bespoke flags below are validated by
    // `owns_flag_vocabulary`; these two are listed for completions/the man page).
    {long: "--iterations", help: "With fuzz: Case budget --iterations=<n> (default 1000)"},
    {long: "--time", help: "With fuzz: Wall-clock budget in seconds --time=<n>"},
    {long: "--seed", help: "With fuzz: Base PRNG seed --seed=<n> (default: fixed, reproducible)"},
    {long: "--corpus", help: "With fuzz: Corpus directory --corpus=<dir> (default: .jet/fuzz/<test>)"},
    {long: "--lens", help: "With prove: Project the human report by an exact evidence facet"},
    // #1659 criterion 1 (round 2): see the block above --message for the
    // other 7 formerly usage-string-only flags.
    {long: "--facts", help: "With expand: Project inline, memory, web, effects, layout, derive, templates, or callable-signature facts --facts=<lens>"},
    {long: "--annotations", help: "With budget: CI annotations auto, none, or github"},
    {long: "--baseline", help: "With budget update: Selected baseline name"},
    {long: "--bootstrap", help: "With budget update: Create absent or stale baseline history"},
    {long: "--accept-regression", help: "With budget update: Explicitly accept a regression"},
    {long: "--reason", help: "With exceptional budget update: Checked-in reason"},
    {long: "--yes", help: "With budget update: Apply a valid non-interactive plan"},
    {long: "-y", help: "Short form of --yes"},
} }
