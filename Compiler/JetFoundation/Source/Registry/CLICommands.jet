// The shared command registry owns help, completion and semantic job-name
// reservation. This file is the one command table.
JET_CLI_JOB_INVOCATION_HELP: "\nRun a project job: jet [jet flags] <name> [job args...]\nJet flags go before the job name; every word after it belongs to the job.\n"

// `jet help input`: every name a program reads its input through, one example
// each; `jet help run` ends with JET_CLI_RUN_INPUT_HELP, which points here.
JET_CLI_INPUT_HELP: "jet help input — What a program reads\n\n`input` is every line of the program's input: the files its arguments name,\nin order, else standard input. The names below read it the same way in a\nscript and in `jet -e CODE [<files>]`.\n\n  input                  Each line, read as it is needed\n                           jet -e 'input.map(fn(l) {{ l.upper() }})' notes.txt\n  input.csv<Row>()       The lines as one CSV table, header first, decoded into [Row];\n                         a field Row lacks is a compile error\n                           input.csv<Sale>().map(fn(s) {{ s.amount }}).sum()\n  input.json<Row>()      Each JSON value, one per line or across lines, decoded into [Row]\n                           input.json<Event>().filter(fn(e) {{ e.level == \"error\" }})\n  input.edit(change)     Each named file rewritten in place, every line through change;\n                         with no file named, standard input printed changed\n                           jet -e 'input.edit(fn(l) {{ l.replace(\"http:\", \"https:\") }})' *.md\n  line.words()           The words of a line, split on whitespace\n                           jet -e 'input.map(fn(l) {{ l.words()[1] }})' log.txt\n  line.split(sep)        The fields of a line, split on sep\n                           jet -e 'input.map(fn(l) {{ l.split(\",\")[0] }})' data.txt\n  readline(prompt)       One line of standard input after a prompt (core.term)\n                           name: readline(\"name? \")\n"

JET_CLI_RUN_INPUT_HELP: "\nA program reads its input through `input`; `jet help input` lists each way.\n"

// One flag. A `With <cmd>[/<cmd>…]: ` help prefix scopes it to those commands;
// `--json`, `--quiet`, and `--color` apply to every command. Each flag a
// command takes is also that command's setting `<command>.<flag>`
// (Compiler/JetCli/Source/Cli/CommandSettings.jet) unless `typed` names the
// JET_CLI_FLAG_TYPED_REASONS row that says why it is typed each time instead;
// `value` is how it and its setting are written.
JetCLIFlagSpec: struct {
    long: String
    help: String
    value: JetCLIFlagValue{JetCLIFlagValue.Switch}
    typed: String{""}
}

// How a flag is written on the command line, and its setting's value.
// Switch: the bare flag (`--check`); the setting true adds it, false leaves it
// out. Bool: the bare flag or `=false` (`--small`, `--small=false`); the
// setting true or false. Value: one value (`--color=always`, `-p server`);
// the setting a string. Optional: bare or with one value (`--watch`,
// `--watch=off`); the setting true, false or a string. Repeated: one value per
// flag, as often as needed (`--deny=Net --deny=FS`); the setting a list of
// strings.
JetCLIFlagValue: enum {
    Switch
    Bool
    Value
    Optional
    Repeated
}

// One reason a flag is typed on each command line that means it, and is never
// a setting: a flag row's `typed` is its `name`, and E2117 says its `reason`.
JetCLIFlagTypedReason: struct {
    name: String
    reason: String
}

JET_CLI_FLAG_TYPED_REASONS: #run { [JetCLIFlagTypedReason]{
    // It deletes, overwrites or skips a safeguard (`--force`, `--yes`).
    {name: "destructive", reason: "it deletes, overwrites or skips a safeguard"},
    // It names what this one run works on (`-e CODE`, `--query SQL`, `-o PATH`).
    {name: "operand", reason: "it names what one run works on"},
    // It gives permissions, which are never saved (`--allow`, `-A`, `--gate`,
    // `--token`, `--allow-unofficial`, and `--trust-key`, whose key decides
    // which signer `jet self update` accepts).
    {name: "authority", reason: "permissions are given on the command line each run"},
} }

// The reason row `name` names, if one does.
jet_cli_flag_typed_reason: fn(name: String) -> JetCLIFlagTypedReason? Never! {
    loop row in JET_CLI_FLAG_TYPED_REASONS {
        if row.name == name -> return Val(row.copy()) // copy: the registry keeps its row.
    }
    None
}

// One dispatcher seam a nested action reaches. `key` names the Rust host's
// `HandlerKey` variant; `dispatch_word` is the handler word a grouped argv
// is normalized to unless `keeps_group` keeps the group word in front.
JetCLIHandlerSpec: struct {
    key: String
    dispatch_word: String
    keeps_group: Bool
}

// One canonical nested spelling under a group (`jet registry publish`).
// `usage` holds one form per line; `handler` is a `JetCLIHandlerSpec.key`.
JetCLIActionSpec: struct {
    name: String
    usage: String
    summary: String
    handler: String
    also_canonical_top_level: Bool
}

// One top-level command: a bare leaf (`build`) or a group with nested
// actions (`registry`).
// `exhaustive` (groups only) means every subword is modeled by `actions`;
// `os`, `env`, and `db` expose a wider downstream verb surface.
// `usage` is the positional shape; None renders the generic `[args]`.
JetCLICommandSpec: struct {
    name: String
    summary: String
    frequency_rank: Int
    exhaustive: Bool
    usage: String?
    actions: [JetCLIActionSpec]
}

JET_CLI_HANDLERS: #run { [JetCLIHandlerSpec]{
