    {long: "--step", help: "With db migrate: Number of ordered migrations to apply or roll back", value: JetCLIFlagValue.Value, typed: "operand"},
    // Bounded SQL console options share the canonical flag
    // registry with migration options and generated help/completions.
    {long: "--format", help: "With db: Output format: human, text, json, jsonl, or csv", value: JetCLIFlagValue.Value},
    {long: "--csv", help: "With db: Select deterministic CSV output"},
    {long: "--jsonl", help: "With db: Emit one JSON value per row"},
    {long: "--machine", help: "With db: Select machine-readable output"},
    {long: "--human", help: "With db: Select human-readable output"},
    {long: "--no-color", help: "With db/run/test/help: Disable color in console output"},
    {long: "--force-color", help: "With db: Force color in console output"},
    {long: "--query", help: "With db: Execute one SQL query", value: JetCLIFlagValue.Value, typed: "operand"},
    {long: "--script", help: "With db: Execute SQL from a script path", value: JetCLIFlagValue.Value, typed: "operand"},
    {long: "--table", help: "With db: Set an explicit table identity as NAME=PATH", value: JetCLIFlagValue.Repeated, typed: "operand"},
    {long: "--max-rows", help: "With db: Bound decoded input rows", value: JetCLIFlagValue.Value},
    {long: "--max-bytes", help: "With db: Bound source or script bytes", value: JetCLIFlagValue.Value},
    {long: "--max-output-bytes", help: "With db: Bound one rendered result", value: JetCLIFlagValue.Value},
    {long: "--image", help: "With flash: Firmware image to program", value: JetCLIFlagValue.Value, typed: "operand"},
    {long: "--audit", help: "With flash: Target audit JSON for the image", value: JetCLIFlagValue.Value, typed: "operand"},
    {long: "--adapter", help: "With flash: Flash adapter: probe-rs, openocd, or emulator", value: JetCLIFlagValue.Value},
    {long: "--package", help: "With package: Set the bundle package identifier", value: JetCLIFlagValue.Value},
    {long: "--name", help: "With package: Set the bundle executable name", value: JetCLIFlagValue.Value},
    {long: "--executable", help: "With package: Path to the executable to bundle", value: JetCLIFlagValue.Value},
    {long: "--icon", help: "With package: Path to the bundle icon", value: JetCLIFlagValue.Value},
    {long: "--icon-format", help: "With package: Icon format: png, icns, ico, or svg", value: JetCLIFlagValue.Value},
    {long: "--icon-size", help: "With package: Icon size in pixels", value: JetCLIFlagValue.Value},
    {long: "--publisher", help: "With package: Publisher metadata", value: JetCLIFlagValue.Value},
    {long: "--description", help: "With package: Application description metadata", value: JetCLIFlagValue.Value},
    {long: "--update-channel", help: "With package: Updater channel", value: JetCLIFlagValue.Value},
    {long: "--update-url", help: "With package: Updater URL", value: JetCLIFlagValue.Value},
    {long: "--game", help: "With package: Build a game bundle"},
    {long: "--source", help: "With package: Project source or package root for a game bundle", value: JetCLIFlagValue.Value},
    {long: "--phase", help: "With package: Comma-separated game phases: build, cook, stage, package, export, deploy, run", value: JetCLIFlagValue.Value},
    {long: "--backend", help: "With package: Game build backend: aot", value: JetCLIFlagValue.Value},
    {long: "--renderer", help: "With package: Game renderer authority: headless or ui", value: JetCLIFlagValue.Value},
    {long: "--cook", help: "With package: Alias for --cook-mode", value: JetCLIFlagValue.Value},
    {long: "--cook-mode", help: "With package: Asset cooking mode: fast, reproducible, or scripts-only", value: JetCLIFlagValue.Value},
    {long: "--export", help: "With package: Export phase or named export preset", value: JetCLIFlagValue.Optional},
    {long: "--export-preset", help: "With package: Named export preset: default, store, or headless", value: JetCLIFlagValue.Value},
    {long: "--deploy", help: "With package: Include the deploy phase"},
    {long: "--deploy-to", help: "With package: Explicit deployment destination", value: JetCLIFlagValue.Value},
    {long: "--crash-reporter", help: "With package: Crash reporter policy: off, on, or opt-in", value: JetCLIFlagValue.Value},
    {long: "--crash-consent", help: "With package: Crash reporter consent: not-requested, granted, or denied", value: JetCLIFlagValue.Value},
    {long: "--cancel", help: "With package: Cancel owned game staging", typed: "destructive"},
    {long: "--resume", help: "With package: Resume an owned game stage", typed: "operand"},
    {long: "--clean", help: "With package: Force-clean owned game cache/staging", typed: "destructive"},
    {long: "--force-clean", help: "With package: Alias for --clean", typed: "destructive"},
    {long: "--scripts-only", help: "With package: Cook only script assets"},
    {long: "--run-now", help: "With package: Explicitly opt into the run phase"},
    {long: "--run", help: "With package: Include the run phase"},
    // `--env` selects one environment module; it never names a
    // preset and has no retired-spelling alias.
    {long: "--env", help: "With env/run/dev/test: Select one declared env.<name> module", value: JetCLIFlagValue.Value},
    // `--preset` selects a named environment composition.
    {long: "--preset", help: "With env/run/dev/test: Select one declared environment preset", value: JetCLIFlagValue.Value},
    {long: "--explain-partition", help: "With build --target=web: Show which code becomes JavaScript or WebAssembly"},
    {long: "--no-capture", help: "With dev: Disable automatic replay capture for this session"},
    {long: "--update", help: "With import: Merge generated Jet into an existing target", typed: "destructive"},
    {long: "--coverage", help: "With test/inspect build: Show function or diagnostic coverage"},
    {long: "--times", help: "With inspect build: Show how long each step and target of the last build took"},
    {long: "--estimate", help: "With inspect decisions: Show the stored and zstd-estimated size of each large raw value"},
    {long: "--verify", help: "With build: Rebuild and compare one indexed receipt artifact", value: JetCLIFlagValue.Value, typed: "operand"},
    // The emit tiers (owner-directed 2026-10-15).
    {long: "--ast", help: "With emit: Print the parsed syntax tree"},
    {long: "--ir", help: "With emit: Print the slot IR the native backend builds"},
    {long: "--fn", help: "With emit --ast/--ir: Print only the named function", value: JetCLIFlagValue.Value, typed: "operand"},
    {long: "-u", help: "Short form of --update-snapshots"},
    // (ratified 2026-06-25): named optimization bundles.
    {long: "--release", help: "With build/run/dev/jobs/test/inspect: Optimize for release"},
    {long: "--profile", help: "With build/run/dev/jobs/package/test/check: How hard to optimize: release, debug, or a named optimization bundle", value: JetCLIFlagValue.Value},
    // Command-line contribution to one typed package setting.
    {long: "--set", help: "With build/run/dev/jobs/test/check: Set one declared package setting as key=value", value: JetCLIFlagValue.Repeated},
    // The compiler's thread cap; never the program's own threads.
    {long: "--threads", help: "With build/run/check/test/dev/inspect: Use at most N compiler threads (1 = one thread); without it jet picks a safe number of compiler threads", value: JetCLIFlagValue.Value},
    // The compiler controls' rows (CLIControls.jet) follow this one.
    {long: "--builder", help: "With build/jobs: Select a previously bound remote builder", value: JetCLIFlagValue.Value},
    // (c134 Phase 6): accessibility is an opt-in lint category.
    {long: "--a11y", help: "With lint: Check roles, labels, and other accessibility basics"},
    {long: "--complexity", help: "With lint: Report per-function cognitive complexity"},
    {long: "--cost", help: "With lint/explain: Show typed hidden-copy and fallback costs"},
    {long: "--max", help: "With lint --complexity: Fail when a function exceeds this score", value: JetCLIFlagValue.Value},
    {long: "--scope", help: "With inspect: Choose a ledger or trust scope", value: JetCLIFlagValue.Value},
    {long: "--core", help: "With inspect structure: Show the canonical core module export facts"},
    {long: "--show-default", help: "With run/build/dev/test: Use and report the stock default"},
    // Native cross-browser test controls.
    {long: "--browser", help: "With test/db: Select browser engines for tests or serve a loopback database inspector", value: JetCLIFlagValue.Optional},
    {long: "--browser-scaffold", help: "With test: Create an isolated browser-test project as --browser-scaffold=<name>", value: JetCLIFlagValue.Value, typed: "operand"},
    {long: "--record", help: "With run/dev/test/debug: Record a named replay as --record=<name>", value: JetCLIFlagValue.Value, typed: "operand"},
    {long: "--replay", help: "With inspect/debug: Consume a named replay artifact", value: JetCLIFlagValue.Value, typed: "operand"},
    {long: "--lens", help: "With prove: Project the human report by an exact evidence facet", value: JetCLIFlagValue.Value},
    // #1659 criterion 1 (round 2): see the block above --message for the
    // other 7 formerly usage-string-only flags.
    {long: "--facts", help: "With expand: Project inline, memory, web, effects, layout, derive, templates, or callable-signature facts --facts=<lens>", value: JetCLIFlagValue.Value},
    {long: "--annotations", help: "With budget: CI annotations auto, none, or github", value: JetCLIFlagValue.Value},
    {long: "--baseline", help: "With budget update: Selected baseline name", value: JetCLIFlagValue.Value},
    {long: "--bootstrap", help: "With budget update: Create absent or stale baseline history", typed: "destructive"},
    {long: "--accept-regression", help: "With budget update: Explicitly accept a regression", typed: "destructive"},
    {long: "--reason", help: "With exceptional budget update: Checked-in reason", value: JetCLIFlagValue.Value, typed: "operand"},
    {long: "--yes", help: "With budget update: Apply a valid non-interactive plan", typed: "destructive"},
    {long: "-y", help: "Short form of --yes"},
    // A Compiler/Prelude source checked as the compiler embeds it (LaneCheck).
    {long: "--prelude", help: "With check: Check a Compiler/Prelude file as the compiler embeds it"},
    // The opt-in style checks (#6561) and, with fix, their moves; impl
    // placement (L0535) is the first.
    {long: "--style", help: "With check/fix: Run the opt-in style checks, such as impl placement; fix applies their moves"},
} }
