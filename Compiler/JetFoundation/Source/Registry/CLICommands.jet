    {form: "<lock with a root authority row>", ported: false, card: 6632, argv: [String]{}},
    {form: "<lock with a Nix closure record>", ported: false, card: 6632, argv: [String]{}},
} }

// Every jet flag: the fixed rows, with one row per build option
// (BuildOptions.jet) after `--profile`, the short level flags `-O0`, `-O1`
// and `-O2` after `--optimize`, one per `jet test` setting
// (TestSettings.jet) after `--explain-partition`, and one per compiler
// control (CLIControls.jet) after `--threads`. A setting whose flag is a
// fixed row shared with other commands keeps that row; one whose flag is a
// build option's (`--optimize`) shares that option's row, which says both.
JET_CLI_FLAGS: #run jet_cli_flag_rows()

jet_cli_flag_rows: fn() -> [JetCLIFlagSpec] Never! {
    rows := [JetCLIFlagSpec]{}
    loop spec in JET_CLI_FIXED_FLAGS {
        rows.push(spec.copy())
        if spec.long == "--profile" {
            loop option in JET_BUILD_OPTIONS {
                flag: build_option_flag(option.name)
                help := "With build/run/dev/test/inspect: {option.help}"
                if jet_cli_test_setting_of_flag(flag) == .Val(row) -> help = "{help}; with test: {jet_cli_test_setting_text(row)}"
                rows.push(JetCLIFlagSpec{long: flag, help: help, value: jet_cli_build_option_value(option)})
                if option.name != "optimize" -> next
                loop (level, value) in option.values -> rows.push(JetCLIFlagSpec{long: "-O{level}", help: "Short form of {flag}={value}"})
            }
        }
        if spec.long == "--threads" {
            loop control in JET_CLI_CONTROLS -> rows.push(jet_cli_control_flag_row(control))
        }
        if spec.long != "--explain-partition" -> next
        loop setting in JET_TEST_SETTINGS {
            flag: test_setting_flag(setting.name)
            // The lambdas take their own names: a capture moves the name it reads.
            fixed_flag: flag.copy() // copy: the fixed-row lambda's own name.
            if JET_CLI_FIXED_FLAGS.any(fn(fixed) { fixed.long == fixed_flag }) -> next
            option_flag: flag.copy() // copy: the build-option lambda's own name.
            if JET_BUILD_OPTIONS.any(fn(option) { build_option_flag(option.name) == option_flag }) -> next
            rows.push(JetCLIFlagSpec{long: flag, help: jet_cli_test_setting_help(setting), value: jet_cli_test_setting_value(setting), typed: setting.typed})
        }
    }
    rows
}

// How a build option's flag is written: a Bool row with no third value
// (`--small`, `--small=false`) is Bool, a List row one flag per item, any
// other row one value (`--optimize=full`, `--debug-info=split`).
jet_cli_build_option_value: fn(option: BuildOptionRow) -> JetCLIFlagValue Never! {
    if option.kind == .List -> return JetCLIFlagValue.Repeated
    if option.kind == .Bool && option.values.len() == 2 -> return JetCLIFlagValue.Bool
    JetCLIFlagValue.Value
}

// How a `jet test` setting's flag is written: a Switch row is Bool
// (`--serial`, `--serial=false`), any other row one value (`--shard=3/8`).
jet_cli_test_setting_value: fn(setting: TestSettingRow) -> JetCLIFlagValue Never! {
    if setting.kind == .Switch -> return JetCLIFlagValue.Bool
    JetCLIFlagValue.Value
}

// The `jet test` setting whose flag is `flag`, if one is.
jet_cli_test_setting_of_flag: fn(flag: String) -> TestSettingRow? Never! {
    loop setting in JET_TEST_SETTINGS {
        if test_setting_flag(setting.name) == flag -> return Val(setting.copy()) // copy: the registry keeps its row.
    }
    None
}

#Test("--optimize is one flag row that says what it does for a build and for jet test") {
    rows: JET_CLI_FLAGS.filter(fn(row) { row.long == "--optimize" })
    assert_eq(rows.len(), 1)
    assert(rows[0].help.starts_with("With build/run/dev/test/inspect: How hard to optimize: none, basic or full; with test: Run the tests at each listed optimize level"))
}

#Test("-O0, -O1 and -O2 are the short forms of the three optimize levels") {
    rows: JET_CLI_FLAGS.filter(fn(row) { row.long.starts_with("-O") })
    assert_eq(rows.len(), 3)
    assert_eq(rows[0].help, "Short form of --optimize=none")
    assert_eq(rows[1].help, "Short form of --optimize=basic")
    assert_eq(rows[2].help, "Short form of --optimize=full")
}

// A setting's help line: what it does and its three spellings.
jet_cli_test_setting_help: fn(setting: TestSettingRow) -> String Never! {
    "With test: {jet_cli_test_setting_text(setting)}"
}

// A setting's help after its `With test: ` scope. Help leaves out the flag of
// an unported setting through the command model (JET_CLI_FORMS).
jet_cli_test_setting_text: fn(setting: TestSettingRow) -> String Never! {
    "{setting.help}; {test_setting_spellings(setting)}"
}

