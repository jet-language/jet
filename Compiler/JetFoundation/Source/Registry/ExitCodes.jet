// The stable process exit-code table (E2-M3), the statuses' one home. The
// numbers are part of the public contract that scripts and CI read; they
// never change meaning. Tools/Agent/RuntimeGenerators.jet generates the
// runtime's, the test kit's and Core's copies and the table of
// Docs/Spec/release-policy.md ("Exit codes") from these rows, each row's
// comment its meaning, and fails on a bare 70 or 101 in an exit position
// anywhere else. The compiler's driver and CLI and Jetpack name these
// constants.

// Success.
EXIT_OK: 0

// An unhandled entry error report or a driver-reported user problem.
EXIT_USER_ERROR: 1

// The command line was wrong: an unknown command or a missing, invalid, or
// unknown argument or flag.
EXIT_USAGE: 2

// A built program stopped at runtime through `panic`, `require`, an index
// fault, or another program-side fault.
EXIT_RUNTIME_PANIC: 70

// A program stopped because its configuration did not decode (sysexits
// EX_CONFIG): an app's settings record (E2416).
EXIT_CONFIG: 78

// Jet's own compiler defect: the compiler reached an impossible state
// (invariant I2), never a user-program exit.
EXIT_ICE: 101
