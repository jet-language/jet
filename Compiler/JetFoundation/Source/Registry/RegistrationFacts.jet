// The one registration table (D-META-REG1=A). Marker rules, knowledge
// planes, rights and build facts are each one row of REGISTRATION_ROWS, told
// apart by what they attach to: a marker rule attaches at the sites its row
// lists, and a fact plane attaches to a value, a scope or the build. The rows
// are read while the compiler builds, from the two Prelude texts that declare
// them (Prelude/Markers.jet through MarkerSource.jet, Prelude/Facts.jet
// through FactSource.jet), so a compile never scans either text. Every
// reader of a marker rule or a fact plane reads this table; no second copy
// of either is kept.

// A copy of `FactTarget` in Core/Prelude/Prelude.jet, in its order (the
// closed-list mirror ledger): edit `FactTarget`, then copy it here.
RegistrationFactTarget: enum {
    Value,
    Scope,
    Build,
}

// One fact plane's laws, as its `impl Fact` block states them.
RegistrationFactRow: struct {
    name: String,
    target: RegistrationFactTarget,
    identity_bearing: Bool,
    safe_direction: String,
    gates: [String],
    published_by: String?,
}

RegistrationRow: enum {
    // A marker rule, attached at `rule.sites`.
    Marker(rule: TAppliedRule),
    // A knowledge plane (`.Value`), a right (`.Scope`) or a build fact
    // (`.Build`), attached to `fact.target`.
    Fact(fact: RegistrationFactRow),
}

REGISTRATION_ROWS: #run registration_read(MARKER_SOURCE, FACT_SOURCE)

// The registration rows of the marker text `markers` then the fact text
// `facts`, each in source order. A fact gate that names a marker must name
// one of the marker rows read first.
registration_read: fn(markers: String, facts: String) -> [RegistrationRow] Never! {
    rules: marker_source_read(markers)
    rows := loop rule in rules -> RegistrationRow.Marker{rule: rule}
    loop fact in fact_source_read(facts, rules) -> rows.push(RegistrationRow.Fact{fact: fact})
    rows
}

// The registered marker rule `name`, None when no row has that name.
registration_marker_rule: fn(name: String) -> TAppliedRule? Never! {
    loop row in REGISTRATION_ROWS {
        if row == .Marker(rule) {
            if rule.name == name -> return Val(rule)
        }
    }
    None
}

// The registered fact plane `name`, None when no row has that name.
registration_fact_row: fn(name: String) -> RegistrationFactRow? Never! {
    loop row in REGISTRATION_ROWS {
        if row == .Fact(fact) {
            if fact.name == name -> return Val(fact)
        }
    }
    None
}

// Every marker rule row, in registration order.
registration_marker_rules: fn() -> [TAppliedRule] Never! {
    rules := [TAppliedRule]{}
    loop row in REGISTRATION_ROWS {
        if row == .Marker(rule) -> rules.push(rule)
    }
    rules
}

// Every fact plane row, in registration order.
registration_fact_rows: fn() -> [RegistrationFactRow] Never! {
    facts := [RegistrationFactRow]{}
    loop row in REGISTRATION_ROWS {
        if row == .Fact(fact) -> facts.push(fact)
    }
    facts
}

// `#build.cpu.cache_line`, the selected CPU's cache-line
// size in bytes. Jet has no CPU selection, so every target is generic and
// reads this value: sema for the fact read, the parser for
// `#Layout(c, align(#build.cpu.cache_line))`.
COMPILER_BUILD_CPU_CACHE_LINE_GENERIC: 64
