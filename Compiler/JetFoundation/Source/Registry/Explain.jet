// `jet explain <NAME>`: the offline essay for one registered diagnostic, found
// by its name or the code that aliases it.
// `index`, `lookup`, and `render`. Every registry row explains itself (I4: no
// code without an explain); a row with a detailed what/why/fix template gets
// the richer essay. Retired rows explain too, so old build logs stay readable.

DiagnosticExplanation: struct {
    code: String,
    // Pipeline stage (`jet` / `parse` / `sema` / ...) from the registry row.
    stage: String,
    // One-line meaning from the registry row (always present).
    meaning: String,
    what: String?,
    why: String?,
    fix: String?,
    // A short worked example for rows that need more than prose.
    example: String?,
}

diagnostic_explanation_example: fn(code: String) -> String? Never! {
    if code == "E0003" -> return Val("save: fn(path: String) IOError! {{\n    print(path)\n}}")
    None
}

// Look up one diagnostic by its code (surrounding space and letter case
// ignored) or by its name (`Jet.UnknownName`), which the code aliases.
diagnostic_explanation: fn(code: String) -> DiagnosticExplanation? Never! {
    trimmed: code.trim()
    row: diagnostic_registry_row(trimmed.to_upper()) ?? (diagnostic_registry_row_named(trimmed) ?? return None)
    ^what: String?{None}
    ^why: String?{None}
    ^fix: String?{None}
    if row.detail {
        what = Val(diagnostic_sentence_case_line(row.what))
        why = Val(diagnostic_sentence_case_line(row.why))
        fix = Val(diagnostic_sentence_case_line(row.fix))
    }
    Val(DiagnosticExplanation{
        code: row.code,
        stage: row.stage,
        meaning: row.meaning,
        what: what,
        why: why,
        fix: fix,
        example: diagnostic_explanation_example(row.code),
    })
}

// Split at `\n`, drop one `\r` before it, and yield no empty line after a final
// line ending.
diagnostic_text_lines: fn(text: String) -> [String] Never! {
    bytes: text.bytes()
    ^lines: [String]{}
    ^start: 0
    loop index in 0..<bytes.len() {
        if bytes[index] == (U8{10}) {
            ^end: index
            if end > start && bytes[end - 1] == (U8{13}) -> end -= 1
            lines.push(foundation_byte_text(bytes, start, end))
            start = index + 1
        }
    }
    if start < bytes.len() -> lines.push(foundation_byte_text(bytes, start, bytes.len()))
    lines
}

// The essay with beginner-friendly headers; `color` styles the title and
// headers on a terminal. A registered row's title is its name
// (`Jet.FailureTrail`), which its code only aliases.
diagnostic_explanation_render: fn(explanation: DiagnosticExplanation, color: Bool) -> String Never! {
    ^out: "{diagnostic_theme_accent(color, diagnostic_display_name(explanation.code))}\n\n"
    what: explanation.what ?? explanation.meaning
    out = "{out}{diagnostic_theme_bold(color, "What this means:")}\n"
    loop line in diagnostic_text_lines(what) {
        if line.len() > 0 -> out = "{out}  {line}"
        out = "{out}\n"
    }
    out = "{out}\n"
    if explanation.why == .Val(why) {
        out = "{out}{diagnostic_theme_bold(color, "Why Jet enforces it:")}\n  {why}\n\n"
    }
    if explanation.fix == .Val(fix) {
        out = "{out}{diagnostic_theme_bold(color, "How to fix it:")}\n  {fix}\n\n"
    }
    if explanation.example == .Val(example) {
        out = "{out}{diagnostic_theme_bold(color, "Example:")}\n"
        loop line in diagnostic_text_lines(example) -> out = "{out}  {line}\n"
        out = "{out}\n"
    }
    if explanation.what == None {
        // No detailed block yet: show the stage so the entry is still useful.
        if explanation.stage.len() > 0 -> out = "{out}Stage: {explanation.stage}\n\n"
        out = "{out}A longer explanation will land with the detailed typed row.\n\n"
    }
    if explanation.stage == "syntax registry" {
        return "{out}This explanation comes from Jet's syntax dictionary.\n"
    }
    if explanation.stage == "library" {
        return "{out}This explanation comes from the type's `Diagnostic` impl.\n"
    }
    if explanation.stage == "derivation relation" {
        return "{out}This explanation comes from the checked program's derivation relation.\n"
    }
    "{out}This explanation comes from jet's diagnostics reference.\n"
}
