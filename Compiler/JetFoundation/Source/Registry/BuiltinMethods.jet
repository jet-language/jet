    BuiltinMethodRow{receiver: BuiltinMethodReceiver.Atomic, name: "store", parameters: [Type]{Type.Named{name: "T"}}, result: Type.Named{name: "Unit"}, access: AccessConvention.Read, lowering: BuiltinMethodLowering.Atomic},
    BuiltinMethodRow{receiver: BuiltinMethodReceiver.Atomic, name: "publish", parameters: [Type]{Type.Named{name: "T"}}, result: Type.Named{name: "Unit"}, access: AccessConvention.Read, lowering: BuiltinMethodLowering.Atomic},
    BuiltinMethodRow{receiver: BuiltinMethodReceiver.AtomicAdd, name: "add", parameters: [Type]{Type.Named{name: "T"}}, result: Type.Named{name: "T"}, access: AccessConvention.Read, lowering: BuiltinMethodLowering.Atomic},
    BuiltinMethodRow{receiver: BuiltinMethodReceiver.AtomicInt, name: "try_add", parameters: [Type]{Type.Int}, result: Type.Result{ok: Type.Int, err: Type.Named{name: "AllocError"}}, access: AccessConvention.Read, lowering: BuiltinMethodLowering.Atomic},
    BuiltinMethodRow{receiver: BuiltinMethodReceiver.Atomic, name: "compare_exchange", parameters: [Type]{Type.Named{name: "T"}, Type.Named{name: "T"}}, result: Type.Bool, access: AccessConvention.Read, lowering: BuiltinMethodLowering.Atomic}
} }

fn builtin_method_strip_tags(ty: Type) -> Type Never! {
    if ty == {
        .Tagged(_, inner) -> builtin_method_strip_tags(inner)
        else -> ty
    }
}

// The `Atomic<T>` scalar a receiver carries, if it is a lock-free atomic.
fn builtin_method_atomic_scalar(receiver: Type) -> Type? {
    if builtin_method_strip_tags(receiver) == {
        .Apply(name, args) -> {
            if name == "Atomic" && args.len() == 1 && jet_target_layout_atomic_scalar_type(args[0]) -> return Val(args[0])
            None
        }
        else -> None
    }
}

fn builtin_method_receiver_accepts(family: BuiltinMethodReceiver, receiver: Type) -> Bool Never! {
    ty := builtin_method_strip_tags(receiver)
    if family == {
        .String -> ty == Type.String
        .Bytes -> ty == (Type.Named{name: "Bytes"})
        .Scalar -> if ty == {
            .Int | .Float | .Bool | .Char | .IntN(_, _) | .Float32 | .InlineRange(_, _, _) -> true
            else -> false
        }
        .Float -> ty == Type.Float || ty == Type.Float32
        .Integer -> if ty == {
            .Int | .IntN(_, _) -> true
            else -> false
        }
        .ExactInt -> ty == Type.Int
        .FixedInt -> if ty == {
            .IntN(_, _) -> true
            else -> false
        }
        .Ordering -> ty == (Type.Named{name: "Ordering"})
        .Range -> ty == (Type.Named{name: "Range"})
        .Atomic -> builtin_method_atomic_scalar(ty) != None
        .AtomicAdd -> {
            scalar :: builtin_method_atomic_scalar(ty) ?? return false
            jet_target_layout_atomic_add_type(scalar)
        }
        .AtomicInt -> {
            scalar :: builtin_method_atomic_scalar(ty) ?? return false
            builtin_method_strip_tags(scalar) == Type.Int && jet_target_layout_atomic_add_type(scalar)
        }
    }
}

// The one lookup: the row for this receiver, method and argument count.
fn builtin_method_row(receiver: Type, method: String, argument_count: Int) -> BuiltinMethodRow? {
    builtin_method_row_in(BUILTIN_METHOD_ROWS, receiver, method, argument_count)
}

// The table is a read parameter, so the scan reads its rows in place.
fn builtin_method_row_in(rows: [BuiltinMethodRow], receiver: Type, method: String, argument_count: Int) -> BuiltinMethodRow? {
    loop row in rows {
        if row.name == method && row.parameters.len() == argument_count && builtin_method_receiver_accepts(row.receiver, receiver) -> return Val(row)
    }
    None
}

// Replace the `Self` and `T` placeholders with the receiver's types.
fn builtin_method_bind(ty: Type, receiver: Type) -> Type Never! {
    self_type := builtin_method_strip_tags(receiver)
    if ty == {
        .Named(name) -> {
            if name == "Self" -> return self_type
            if name == "T" -> return builtin_method_atomic_scalar(self_type) ?? ty
            ty
        }
        .Option(inner) -> Type.Option{inner: builtin_method_bind(inner, receiver)}
        else -> ty
    }
}
