    builtin_atomic(BuiltinMethodReceiver.Atomic, "load", [Type]{}, Type.Named{name: "T"}),
    builtin_atomic(BuiltinMethodReceiver.Atomic, "observe", [Type]{}, Type.Named{name: "T"}),
