// Built-in value receiver methods: `String`, `Bytes`, the numeric scalars,
// `Ordering`, and `Atomic<T>`. Collection receivers keep their own table in
// Collections.jet (COLLECTION_OPERATIONS).
//
// The rows mirror the bootstrap's `Collections::builtin_method_return`, its
// `builtin_method_arg_types` entries, `builtin_receiver_borrow`, and the TIR
// operation `resolve_builtin_op` / `resolve_numeric_op` select. A row is keyed
// by receiver family, method name and argument count; an absent row is not a
// built-in method. Parameter and result types may name two placeholders:
// `Self` is the (untagged) receiver type and `T` is the `Atomic<T>` scalar.

enum BuiltinMethodReceiver {
    String
    Bytes
    // Int, Float, Bool, Char, the fixed widths, F32 and inline ranges.
    Scalar
    // Float and F32.
    Float
    // Int and the fixed-width integers.
    Integer
    // Exact Int only.
    ExactInt
    // Fixed-width integers only (`IntN`).
    FixedInt
    Ordering
    // The `Range` value (`lo..hi`).
    Range
    // `Atomic<T>` over a lock-free scalar; `AtomicAdd` also needs an addable
    // scalar and `AtomicInt` an exact Int.
    Atomic
    AtomicAdd
    AtomicInt
}

enum BuiltinMethodLowering {
    Builtin(operation: TBuiltinOp)
    // `s.slice(a, b)`: TBuiltinOp.Slice carrying the receiver line.
    StringSlice
    // `s.slice(range)`: the checked Range slice expression.
    StringRangeSlice
    // Optional `(before, after)` splits; the op names the result tuple struct.
    StringSplitOnce
    StringCutLast
    // `n.to_radix(base)`: TBuiltinOp.IntToRadix carrying the call line.
    IntToRadix
    // `to_string` on a scalar: numeric receivers show through TNumericOp.ToShow,
    // Bool, Char and inline ranges through TBuiltinOp.ToString.
    Show
    // Float predicates and integer bit-population queries.
    Predicate
    BitCount
    // D-SIGIL-ALGEBRA1=B: checked by sema_expr_check_binary / numeric unary.
    Arithmetic(operation: TBinaryOp)
    BitNot
    // Exact Int Euclidean quotient and remainder (NumericBinaryMethod).
    Euclidean(remainder: Bool)
    // Fixed-width overflow policy (`checked_add`, `wrapping_mul`, `rotate_left`, …).
    Overflow(prefix: String, operation: String)
    Atomic
}

struct BuiltinMethodRow {
    receiver: BuiltinMethodReceiver
    name: String
    parameters: [Type]
    result: Type
    // Write rows mutate the receiver in place and record `Mem`.
    access: AccessConvention
    lowering: BuiltinMethodLowering
}

// Rows are literal struct data so the table lands without a compile-time
// execution host. A `TBuiltinOp.StringMethod` row's route name is the method
// spelling; an overflow row's checked form returns `Self?`.

BUILTIN_METHOD_ROWS :: prep { [BuiltinMethodRow]{
    // String: measures and predicates. `len` counts characters, as the
    // bootstrap's `LenString` does; `count_bytes` counts UTF-8 bytes.
    BuiltinMethodRow{receiver: BuiltinMethodReceiver.String, name: "len", parameters: [Type]{}, result: Type.Int, access: AccessConvention.Read, lowering: BuiltinMethodLowering.Builtin{operation: TBuiltinOp.LenString}},
    BuiltinMethodRow{receiver: BuiltinMethodReceiver.String, name: "count_bytes", parameters: [Type]{}, result: Type.Int, access: AccessConvention.Read, lowering: BuiltinMethodLowering.Builtin{operation: TBuiltinOp.StringMethod{method: "count_bytes"}}},
    BuiltinMethodRow{receiver: BuiltinMethodReceiver.String, name: "is_empty", parameters: [Type]{}, result: Type.Bool, access: AccessConvention.Read, lowering: BuiltinMethodLowering.Builtin{operation: TBuiltinOp.IsEmpty}},
    BuiltinMethodRow{receiver: BuiltinMethodReceiver.String, name: "try_push", parameters: [Type]{Type.String}, result: Type.Result{ok: Type.Named{name: "Unit"}, err: Type.Named{name: "AllocError"}}, access: AccessConvention.Write, lowering: BuiltinMethodLowering.Builtin{operation: TBuiltinOp.TryStringPush}},
