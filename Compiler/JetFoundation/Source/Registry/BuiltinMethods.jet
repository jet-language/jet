    BuiltinMethodRow{receiver: BuiltinMethodReceiver.String, name: "endswith", parameters: [Type]{Type.String}, result: Type.Bool, access: AccessConvention.Read, lowering: BuiltinMethodLowering.Builtin{operation: TBuiltinOp.EndsWith}},
