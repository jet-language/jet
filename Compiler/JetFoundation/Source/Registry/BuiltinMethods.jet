// Built-in value receiver methods: `String`, `Bytes`, the numeric scalars,
// `Ordering`, and `Atomic<T>`. Collection receivers keep their own table in
// Collections.jet (COLLECTION_OPERATIONS).
//
// The rows mirror the bootstrap's `Collections::builtin_method_return`, its
// `builtin_method_arg_types` entries, `builtin_receiver_borrow`, and the TIR
// operation `resolve_builtin_op` / `resolve_numeric_op` select. A row is keyed
// by receiver family, method name and argument count; an absent row is not a
// built-in method. Parameter and result types may name two placeholders:
// `Self` is the (untagged) receiver type and `T` is the `Atomic<T>` scalar.

pub enum BuiltinMethodReceiver {
    String
    Bytes
    // Int, Float, Bool, Char, the fixed widths, F32 and inline ranges.
    Scalar
    // Float and F32.
    Float
    // Int and the fixed-width integers.
    Integer
    // Exact Int only.
    ExactInt
    // Fixed-width integers only (`IntN`).
    FixedInt
    Ordering
    // The `Range` value (`lo..hi`).
    Range
    // `Atomic<T>` over a lock-free scalar; `AtomicAdd` also needs an addable
    // scalar and `AtomicInt` an exact Int.
    Atomic
    AtomicAdd
    AtomicInt
}

pub enum BuiltinMethodLowering {
    Builtin(operation: TBuiltinOp)
    // `s.slice(a, b)`: TBuiltinOp.Slice carrying the receiver line.
    StringSlice
    // `s.slice(range)`: the checked Range slice expression.
    StringRangeSlice
    // Optional `(before, after)` splits; the op names the result tuple struct.
    StringSplitOnce
    StringCutLast
    // `n.to_radix(base)`: TBuiltinOp.IntToRadix carrying the call line.
    IntToRadix
    // `to_string` on a scalar: numeric receivers show through TNumericOp.ToShow,
    // Bool, Char and inline ranges through TBuiltinOp.ToString.
    Show
    // Float predicates and integer bit-population queries.
    Predicate
    BitCount
    // Exact Int Euclidean quotient and remainder (NumericBinaryMethod).
    Euclidean(remainder: Bool)
    // Fixed-width overflow policy (`checked_add`, `wrapping_mul`, `rotate_left`, …).
    Overflow(prefix: String, operation: String)
    Atomic
}

pub struct BuiltinMethodRow {
    pub receiver: BuiltinMethodReceiver
    pub name: String
    pub parameters: [Type]
    pub result: Type
    // Write rows mutate the receiver in place and record `Mem`.
    pub access: AccessConvention
    pub lowering: BuiltinMethodLowering
}

fn builtin_method(receiver: BuiltinMethodReceiver, name: String, parameters: [Type], result: Type, lowering: BuiltinMethodLowering) -> BuiltinMethodRow Never! {
    BuiltinMethodRow{receiver: receiver, name: name, parameters: parameters, result: result, access: AccessConvention.Read, lowering: lowering}
}

fn builtin_method_write(row: ^BuiltinMethodRow) -> BuiltinMethodRow Never! {
    updated := row
    updated.access = AccessConvention.Write
    updated
}

fn builtin_string_op(name: String, parameters: [Type], result: Type, operation: TBuiltinOp) -> BuiltinMethodRow Never! {
    builtin_method(BuiltinMethodReceiver.String, name, parameters, result, BuiltinMethodLowering.Builtin{operation: operation})
}

// A `TBuiltinOp.StringMethod` row whose route name is the method spelling.
fn builtin_string_method(name: String, parameters: [Type], result: Type) -> BuiltinMethodRow Never! {
    builtin_string_op(name, parameters, result, TBuiltinOp.StringMethod{method: name})
}

fn builtin_bytes(name: String, parameters: [Type], result: Type) -> BuiltinMethodRow Never! {
    builtin_method(BuiltinMethodReceiver.Bytes, name, parameters, result, BuiltinMethodLowering.Builtin{operation: TBuiltinOp.ByteBufferMethod{method: name}})
}

fn builtin_bytes_write(name: String, parameter: Type) -> BuiltinMethodRow Never! {
    builtin_method_write(builtin_method(BuiltinMethodReceiver.Bytes, name, [Type]{parameter}, Type.Named{name: "Unit"}, BuiltinMethodLowering.Builtin{operation: TBuiltinOp.ByteBufferWrite{method: name}}))
}

fn builtin_overflow(name: String, prefix: String, operation: String, checked: Bool) -> BuiltinMethodRow Never! {
    self_type := Type.Named{name: "Self"}
    builtin_method(BuiltinMethodReceiver.FixedInt, name, [Type]{self_type}, if checked -> Type.Option{inner: self_type} else -> self_type, BuiltinMethodLowering.Overflow{prefix: prefix, operation: operation})
}

fn builtin_atomic(receiver: BuiltinMethodReceiver, name: String, parameters: [Type], result: Type) -> BuiltinMethodRow Never! {
    builtin_method(receiver, name, parameters, result, BuiltinMethodLowering.Atomic)
}

fn builtin_u8() -> Type Never! {
    Type.IntN{signed: false, bits: 8}
}

fn builtin_u8_list() -> Type Never! {
    Type.List{element: builtin_u8()}
}

fn builtin_split_pair() -> Type Never! {
    Type.Option{inner: Type.Tuple{fields: [TypeTupleField]{TypeTupleField{name: "before", ty: Type.String}, TypeTupleField{name: "after", ty: Type.String}}}}
}

fn builtin_partition_triple() -> Type Never! {
    Type.Tuple{fields: [TypeTupleField]{TypeTupleField{name: "head", ty: Type.String}, TypeTupleField{name: "sep", ty: Type.String}, TypeTupleField{name: "tail", ty: Type.String}}}
}

BUILTIN_METHOD_ROWS :: prep { [BuiltinMethodRow]{
    // String: measures and predicates. `len` counts characters, as the
    // bootstrap's `LenString` does; `count_bytes` counts UTF-8 bytes.
    builtin_string_op("len", [Type]{}, Type.Int, TBuiltinOp.LenString),
    builtin_string_method("count_bytes", [Type]{}, Type.Int),
    builtin_string_op("is_empty", [Type]{}, Type.Bool, TBuiltinOp.IsEmpty),
    builtin_method_write(builtin_string_op("try_push", [Type]{Type.String}, Type.Result{ok: Type.Named{name: "Unit"}, err: Type.Named{name: "AllocError"}}, TBuiltinOp.TryStringPush)),
    builtin_string_op("contains", [Type]{Type.String}, Type.Bool, TBuiltinOp.Contains),
    builtin_string_op("starts_with", [Type]{Type.String}, Type.Bool, TBuiltinOp.StartsWith),
