use jet_foundation.[Type, AccessConvention, FailureContract]
use jet_codegen.Codegen.Context.[Cx]
use jet_codegen.TIR.[TCallArg, TExpr, TExprKind, TFnValueKind, THostCall, bind_generic_type, generic_method_instance_key, unit_type]
use jet_codegen.TIR.Mir.[never_carrier_success]
use jet_codegen.TIR.Lower.MethodCalls.[lower_serde_encode_node]
use jet_generics.[substitute_type]
use jet_syntax as Syntax

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:13217
fn comptime_host_type_leaf(name: String) -> String {
    (name.rsplit("::").next() ?? name).rsplit('.').next() ?? name
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:13226
fn is_comptime_host_method(ty_name: String, method: String) -> Bool {
    if comptime_host_type_leaf(ty_name) == {
        Syntax.TYPE_BUILD_CONTEXT -> ["generate", "find", "embed", "fetch", "plugin", "action", "legacy", "add_executable", "add_library", "add_test", "add_asset_bundle", "add_doc", "add_install", "add_package", "add_publish", "toolchain", "signing", "probe", "error", "plan", "contribute"].contains(method)
        Syntax.TYPE_PROGRAM_INFO -> ["types", "functions", "packages", "definitions", "references", "call_edges", "structural_nodes"].contains(method)
        Syntax.TYPE_TYPE_INFO | "FieldInfo" | "MethodInfo" -> ["has_marker", "implements", "has_method"].contains(method)
        "CompilerLexed" | "CompilerSyntaxTree" | "CompilerChecked" | "CompilerSourceMap" | "CompilerPackageError" | "CompilerDependency" | "CompilerPackageTarget" | "CompilerPackageOutput" | "CompilerBuildProfile" | "CompilerManifest" | "CompilerPackage" | "CompilerLockedPackage" | "CompilerLock" | "CompilerKeyValue" | "CompilerProfile" | "CompilerProfileSet" -> true
        else -> false
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:13285
pub fn instantiate_method_sig(cx: Cx, type_name: String, method: String, sig: [(AccessConvention, Type)], owner_type_args: [Type], method_type_args: [Type]) -> [(AccessConvention, Type)] {
    subst := [String:Type]{}
    if cx.struct_type_param_order.get(type_name) == Val(owner_params) -> {
        loop (param, actual) in owner_params.zip(owner_type_args) -> &subst.insert(~param, ~actual)
    }
    // GATE #4499: canonical owner/method tuple-key equality and hashing.
    if cx.method_type_params.get((type_name, method)) == Val(method_params) -> {
        loop (param, actual) in method_params.zip(method_type_args) -> &subst.insert(~param.name, ~actual)
    }
    sig.map(fn((conv, ty)) { (conv, substitute_type(ty, subst)) })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:13312
fn instantiate_method_ret(cx: Cx, type_name: String, method: String, owner_type_args: [Type], method_type_args: [Type], resolved_ret: Type?) -> Type? {
    template :: resolved_ret ?? cx.method_rets.get((type_name, method)).flatten() ?? return None
    subst := owner_type_subst(cx, type_name, owner_type_args)
    if cx.method_type_params.get((type_name, method)) == Val(method_params) -> {
        loop (param, actual) in method_params.zip(method_type_args) -> &subst.insert(~param.name, ~actual)
    }
    Val(substitute_type(template, subst))
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:13338
fn resolved_method_type_args(cx: Cx, type_name: String, method: String, sig: [(AccessConvention, Type)], owner_type_args: [Type], args: [TCallArg], explicit_type_args: [Type], resolved_ret: Type?) -> [Type] {
    if !explicit_type_args.is_empty() -> return ~explicit_type_args
    method_params :: cx.method_type_params.get((type_name, method)) ?? return []
    if method_params.is_empty() -> return []
    names := Set[String]{}
    loop param in method_params -> &names.insert(~param.name)
    subst := [String:Type]{}
    loop ((_, template), arg) in sig.zip(args) -> {
        if !bind_generic_type(template, arg.value.ty, names, &subst) -> return []
    }
    if (cx.method_rets.get((type_name, method)).flatten(), resolved_ret) == (Val(template), Val(actual)) -> {
        owner_subst :: owner_type_subst(cx, type_name, owner_type_args)
        owner_template :: substitute_type(template, owner_subst)
        effective_template :: FailureContract.from_return_type(Val(owner_template)).effective_type()
        effective_subst := ~subst
        if bind_generic_type(effective_template, actual, names, &effective_subst) -> subst = ^effective_subst
        else if !bind_generic_type(owner_template, actual, names, &subst) -> return []
    }
    concrete := [Type]{}
    loop param in method_params -> {
        actual :: subst.get(param.name) ?? return []
        &concrete.push(~actual)
    }
    ^concrete
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:13400
fn owner_type_subst(cx: Cx, type_name: String, owner_type_args: [Type]) -> [String:Type] {
    subst := [String:Type]{}
    if cx.struct_type_param_order.get(type_name) == Val(params) -> {
        loop (param, actual) in params.zip(owner_type_args) -> &subst.insert(~param, ~actual)
    }
    ^subst
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:13414
fn prepare_generic_serde_codec(cx: Cx, fn_name: String, module: String, method: String, args: &[TExpr], ret_ty: Type) {
    encoding :: ["core.sys", "core.encoding.json", "core.encoding.toml", "core.encoding.yaml", "core.encoding.csv", "core.encoding.cbor"].contains(module)
    if !encoding -> return
    &cx.jit_canonical_calls.borrow_mut().insert(~fn_name)
    if ["to_string", "to_string_pretty", "to_bytes", "to_bytes_canonical", "query"].contains(method) -> {
        if args.first() == Val(arg) && arg.ty == .Apply{..} -> {
            &cx.jit_method_calls.borrow_mut().insert(generic_method_instance_key(arg.ty, "encode", []), (~arg.ty, "encode", []))
        }
    }
    if method == "decode" || method == "query" -> {
        if ret_ty == .Result(ok, _) -> {
            if cx.migrations.contains_key(ok.name()) -> &cx.jit_canonical_deopt.borrow_mut().insert(~fn_name)
            decode_ty :: if ok == .List(inner) && method == "query" -> inner else -> ok
            if decode_ty == .Apply{..} -> &cx.jit_method_calls.borrow_mut().insert(generic_method_instance_key(decode_ty, "decode", []), (~decode_ty, "decode", []))
        }
    }
    if ["core.encoding.json", "core.encoding.toml", "core.encoding.yaml"].contains(module) && ["to_string", "to_string_pretty"].contains(method) -> {
        if !args.is_empty() -> {
            // Move the input once before replacing its slot with the lowered Encode node.
            value :: args[0].replace(TExpr{ty: unit_type(), kind: TExprKind.Unit})
            args[0] = lower_serde_encode_node(^value, cx)
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:13491
fn name_plain_callback_return(callback: &TExpr) {
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:13492
    fn is_named_function(value: TExpr) -> Bool {
        if value.kind == {
            .FnValue{kind: TFnValueKind.NamedFn{name: Val(_), lambda: None, ..}} -> true
            .HostCall(call) -> if call == THostCall.FnName(_) -> true else -> false
            else -> false
        }
    }
    named :: if callback.kind == .HostBorrowCallback{callable, ..} -> {
        inner_named :: is_named_function(callable)
        if inner_named -> name_plain_callback_return(&callable)
        inner_named
    } else -> is_named_function(callback)
    if !named -> return
    if callback.ty == .Fn{ret: Val(ret), ..} -> {
        if never_carrier_success(ret).filter(fn(success) { !success.is_never() }) == Val(success) -> ret = ~success
    }
}
