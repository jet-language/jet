        lint_name: None,
        stage: "parse",
        severity: 1,
        moment: DiagnosticMoment.Compile,
        status: DiagnosticRegistryStatus.Active,
        meaning: "C25/D-RANGE2: `step` in an arm head — `step` is a loop modifier, not an arm construct",
        what: "`` `step` `` is not allowed in a range arm — range arms test a band, not a sequence.",
        why: "A stride modifies a loop range to skip values (`loop i in 0..10, 2`); an arm head like `1..10` just checks whether the subject is between 1 and 10. A stepped range is not a contiguous band and can't be used for membership testing.",
        fix: "Remove the stride; to match only multiples of N, use a full condition: `subject >= lo && subject <= hi && subject % n == 0 ->`.",
        detail: true,
        structured_fix: None,
        fix_safety: None,
        no_fix_reason: Val(DiagnosticNoFixReason{kind: DiagnosticNoFixReasonKind.Ambiguous, next: "Remove the stride; to match only multiples of N, use a full condition: `subject >= lo && subject <= hi && subject % n == 0 ->`."}),
