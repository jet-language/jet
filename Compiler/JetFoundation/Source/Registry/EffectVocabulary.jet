// The effect vocabulary, derived while the compiler builds from the toolchain
// tree's own effect sources: Compiler/Prelude/Effects.jet
// (the machine effects), then Core/Effects/Effects.jet (Core's service
// effects), then Core/Compiler/Meta.jet (the metaprogramming effects). Each
// declares `Name: struct {` or `Name: enum {` types that implement `Effect`;
// an enum is a family, each case a `Root.Case` leaf. A family whose
// `impl Effect` names a `parent: Root.Case` declared above it holds that
// case's children instead, `Root.Case.Child`, and declares no name of its
// own. A family is irreversible when any of its cases is. An `expert` fact
// marks the effects only the main package holds, and only by naming them
// (authority_expert). A Core or Meta effect has a `#FX` or `#FX(…)` line
// right above it, its entries machine effects: the `kernel` a row naming it
// may use. A source that breaks this form stops the build (E3010) naming the
// file and line.
//
// The compiler's closed `Effect` type, the machine roots alone, is authored
// in Registry/EffectRoots.jet and checked against EFFECT_VOCABULARY_MACHINE_ROOTS
// while the compiler builds; Jetpack's BuildEffect is checked to name only
// roots of EFFECT_VOCABULARY_ROOTS. Both checks read the authored enum with
// effect_vocabulary_enum_cases.

EffectVocabularyRow: struct {
    name: String,
    irreversible: Bool,
    // Empty for a machine effect; for a Core effect, the machine effects
    // the `#FX(…)` above its declaration lists.
    kernel: [String],
    // Never held by default nor through a parent: only a package that names
    // it, or an expert effect above it, holds it.
    expert: Bool{false},
    // What this effect does to kept data: Reads, Adds, or Replaces.
    access: EffectAccess{EffectAccess.Reads},
    // Plain-English action phrase for notices and authority prompts.
    action: String{""},
}

effect_access_rank: fn(access: EffectAccess) -> Int Never! {
    if access == {
        .Reads -> 0
        .Adds -> 1
        .Replaces -> 2
    }
}

// The stronger of two access classes: Replaces > Adds > Reads.
effect_access_max: fn(left: EffectAccess, right: EffectAccess) -> EffectAccess Never! {
    if effect_access_rank(right) > effect_access_rank(left) -> right else -> left
}

effect_access_name: fn(access: EffectAccess) -> String Never! {
    if access == {
        .Reads -> "Reads"
        .Adds -> "Adds"
        .Replaces -> "Replaces"
    }
}

effect_access_parse: fn(text: String) -> EffectAccess? Never! {
    cleaned: text.trim()
    if cleaned == {
        ".Reads" | "EffectAccess.Reads" -> Val(EffectAccess.Reads)
        ".Adds" | "EffectAccess.Adds" -> Val(EffectAccess.Adds)
        ".Replaces" | "EffectAccess.Replaces" -> Val(EffectAccess.Replaces)
        else -> None
    }
}

// The declared access class of built-in effect `name` (root or leaf), or
// Reads when not in the vocabulary.
effect_vocabulary_access: fn(name: String) -> EffectAccess Never! {
    loop row in EFFECT_VOCABULARY_ROWS {
        if row.name == name -> return row.access
    }
    EffectAccess.Reads
}

// The declared plain-English action phrase of built-in effect `name`
// (root or leaf), or "" when not declared.
effect_vocabulary_action: fn(name: String) -> String Never! {
    loop row in EFFECT_VOCABULARY_ROWS {
        if row.name == name -> return row.action
    }
    ""
}

// Every declared root and leaf, in source order.
EFFECT_VOCABULARY_ROWS: #run effect_vocabulary_rows(embed_file("toolchain:Compiler/Prelude/Effects.jet"), embed_file("toolchain:Core/Effects/Effects.jet"), embed_file("toolchain:Core/Compiler/Meta.jet"))

// The declared roots, in source order.
EFFECT_VOCABULARY_ROOTS: #run effect_vocabulary_names(EFFECT_VOCABULARY_ROWS, false)

// The declared leaves (`Root.Member`), in source order.
EFFECT_VOCABULARY_LEAVES: #run effect_vocabulary_names(EFFECT_VOCABULARY_ROWS, true)

// The roots Compiler/Prelude/Effects.jet declares (the machine roots), in
// source order.
EFFECT_VOCABULARY_MACHINE_ROOTS: #run effect_vocabulary_names(effect_vocabulary_source_rows(embed_file("toolchain:Compiler/Prelude/Effects.jet"), EFFECT_VOCABULARY_MACHINE_PATH, None), false)

// The canonical effect module, made while the compiler builds so a compile
// registers it without parsing it: the three files in order, each without
// its trailing blank lines, one blank line between them.
EFFECT_CANONICAL_MODULE: #run effect_vocabulary_canonical_module(embed_file("toolchain:Compiler/Prelude/Effects.jet"), embed_file("toolchain:Core/Effects/Effects.jet"), embed_file("toolchain:Core/Compiler/Meta.jet"))

EFFECT_VOCABULARY_MACHINE_PATH: "Compiler/Prelude/Effects.jet"

// An effect module's text, the byte where each of its lines starts, and the
// effect declarations it holds (EffectVocabularyScan) with spans into the
// text.
EffectModuleSource: struct {
    source: String,
    line_starts: [Int],
    decls: [EffectDecl],
}

effect_vocabulary_canonical_module: fn(machine_source: String, core_source: String, meta_source: String) -> EffectModuleSource {
    machine_text: machine_source.trim_end()
    core_text: core_source.trim_end()
    machine: effect_vocabulary_source_scan(machine_source, EFFECT_VOCABULARY_MACHINE_PATH, None, 0)
    core_base: machine_text.bytes().len() + 2
    core: effect_vocabulary_source_scan(core_source, "Core/Effects/Effects.jet", Val(machine.rows), core_base)
    meta: effect_vocabulary_source_scan(meta_source, "Core/Compiler/Meta.jet", Val(machine.rows), core_base + core_text.bytes().len() + 2)
    ^decls: [EffectDecl]{}
    loop declaration in machine.decls -> decls.push(declaration)
    loop declaration in core.decls -> decls.push(declaration)
    loop declaration in meta.decls -> decls.push(declaration)
    effect_vocabulary_module_source("{machine_text}\n\n{core_text}\n\n{meta_source.trim_end()}\n", decls)
}

// The effect module of one source written as Compiler/Prelude/Effects.jet
// is, with no `#FX` lines.
effect_vocabulary_module: fn(source: String) -> EffectModuleSource {
    effect_vocabulary_module_source(source, effect_vocabulary_source_scan(source, "the effect source", None, 0).decls)
}

effect_vocabulary_module_source: fn(source: String, decls: [EffectDecl]) -> EffectModuleSource {
    ^line_starts: [Int]{0}
    loop (index, byte) in source.bytes() {
        if byte == (U8{10}) -> line_starts.push(index + 1)
    }
    EffectModuleSource{source: source, line_starts: line_starts, decls: decls}
}

// The rows of the three sources, in order.
effect_vocabulary_rows: fn(machine_source: String, core_source: String, meta_source: String) -> [EffectVocabularyRow] {
    machine: effect_vocabulary_source_rows(machine_source, EFFECT_VOCABULARY_MACHINE_PATH, None)
    core_rows: effect_vocabulary_source_rows(core_source, "Core/Effects/Effects.jet", Val(machine))
    ^meta_rows: effect_vocabulary_source_rows(meta_source, "Core/Compiler/Meta.jet", Val(machine))
    ^rows: machine
    rows.extend(core_rows)
    loop meta_rows.len() > 0 {
        row: meta_rows.remove(0, .Slot) ?? break
        loop seen in rows {
            if seen.name == row.name {
                build_time_refused("Core/Compiler/Meta.jet: duplicate effect {row.name}")
            }
        }
        rows.push(row)
    }
    rows
}

// The effect names that are leaves (`Root.Member`) or, with `leaf` false, roots.
effect_vocabulary_names: fn(rows: [EffectVocabularyRow], leaf: Bool) -> [String] Never! {
    loop row in rows if row.name.contains(".") == leaf -> row.name.copy()
}

// The cases of `<type_name>: enum { … }` in `text`: the words of a one-line
// declaration, or those of a block's lines up to its first blank line (where
// the enum's methods start) or its closing brace. None when `text` declares
// no such enum.
effect_vocabulary_enum_cases: fn(text: String, type_name: String) -> [String]? {
    head: "{type_name}: enum {{"
    ^cases: [String]{}
    ^inside: false
    loop line in text.split("\n") {
        if inside {
            if line == "}}" || line.trim() == "" -> return Val(cases)
            loop word in effect_vocabulary_words(line) -> cases.push(word)
            next
        }
        if !line.starts_with(head) -> next
        if line.ends_with("}}") && line != head {
            return Val(effect_vocabulary_words(line.removeprefix(head).removesuffix("}}")))
        }
        if line != head -> return None
        inside = true
    }
    if inside -> Val(cases) else -> None
}

// The names of `found` that `known` does not hold, in `found`'s order.
effect_vocabulary_strays: fn(found: [String], known: [String]) -> [String] Never! {
    loop name in found if !known.contains(name) -> name.copy()
}

// The cases of `<type_name>: enum { … }` in `text` written one case to a
// line, with or without a payload: each line's name up to its payload's `(`
// or `{` or its comma, up to the first blank line or the closing brace.
// None when `text` declares no such enum.
effect_vocabulary_enum_case_heads: fn(text: String, type_name: String) -> [String]? {
    head: "{type_name}: enum {{"
    ^cases: [String]{}
    ^inside: false
    loop line in text.split("\n") {
        if inside {
            if line == "}}" || line.trim() == "" -> return Val(cases)
            trimmed: line.trim()
            if trimmed.starts_with(COMMENT_PREFIX) -> next
            loop word in effect_vocabulary_words(trimmed.replace("(", " ").replace("{{", " ")) {
                cases.push(word)
                break
            }
            next
        }
        if line == head -> inside = true
    }
    if inside -> Val(cases) else -> None
}

// The number of names in `view`, the list `view_name` in the file
// `view_file`, once each name `outside` does not hold is one of
// `vocabulary`, the list `vocabulary_name`; else the build stops naming the
// strays. A view so checked picks from its vocabulary instead of being a
// second home of the same names.
effect_vocabulary_list_view_count: fn(view_file: String, view: [String], view_name: String, vocabulary: [String], vocabulary_name: String, outside: [String]) -> Int {
    strays: effect_vocabulary_strays(effect_vocabulary_strays(view, vocabulary), outside)
    if strays.len() > 0 {
        build_time_refused("{view_file}: {view_name} names {strays.join(", ")}, which {vocabulary_name} does not hold")
    }
    view.len()
}

// effect_vocabulary_list_view_count over the cases of the view enum
// `view_name` in `view`, the text of the file `view_file`.
effect_vocabulary_enum_view_count: fn(view_file: String, view: String, view_name: String, vocabulary: [String], vocabulary_name: String, outside: [String]) -> Int {
    cases: effect_vocabulary_enum_case_heads(view, view_name) ?? build_time_refused("{view_file} declares no `{view_name}: enum {{ … }}`")
    effect_vocabulary_list_view_count(view_file, cases, view_name, vocabulary, vocabulary_name, outside)
}

// effect_vocabulary_enum_view_count against the cases of the enum
// `vocabulary_name` in `vocabulary`, the text of the file `vocabulary_file`.
effect_vocabulary_view_count: fn(view_file: String, view: String, view_name: String, vocabulary_file: String, vocabulary: String, vocabulary_name: String, outside: [String]) -> Int {
    known: effect_vocabulary_enum_case_heads(vocabulary, vocabulary_name) ?? build_time_refused("{vocabulary_file} declares no `{vocabulary_name}: enum {{ … }}`")
    effect_vocabulary_enum_view_count(view_file, view, view_name, known, "`{vocabulary_name}` in {vocabulary_file}", outside)
}

// The cases of the enum `name` in `text`, the text of the file `file`; else
// the build stops. A list view compares its list with these cases.
effect_vocabulary_enum_names: fn(file: String, text: String, name: String) -> [String] {
    effect_vocabulary_enum_case_heads(text, name) ?? build_time_refused("{file} declares no `{name}: enum {{ … }}`")
}

// `names` in lower case: the spelling of a view written in lower case
// against an enum's cases.
effect_vocabulary_lowered: fn(names: [String]) -> [String] {
    loop name in names -> name.lower()
}

// The string literals of the list `<name>: [String]{ … }` in `text`, the
// text of the file `file`, from its head line to the line its closing brace
// ends; else the build stops. A list view reads this way a list in a package
// its own package cannot import.
effect_vocabulary_list_strings: fn(file: String, text: String, name: String) -> [String] {
    head: "{name}: [String]{{"
    ^out: [String]{}
    ^inside: false
    loop line in text.split("\n") {
        if !inside {
            if !line.starts_with(head) -> next
            inside = true
        }
        ^quoted: false
        loop piece in line.split("\"") {
            if quoted -> out.push(piece)
            quoted = !quoted
        }
        if line.ends_with("}}") -> return out
    }
    build_time_refused("{file} declares no `{name}: [String]{{ … }}`")
}

// The words of `text`, split at whitespace and at the commas that end enum
// cases.
effect_vocabulary_words: fn(text: String) -> [String] {
    ^out: [String]{}
    loop word in text.split(" ") {
        loop part in word.split("\t") {
            loop piece in part.split(",") {
                trimmed: piece.trim()
                if trimmed != "" -> out.push(trimmed.copy())
            }
        }
    }
    out
}

// The rows one source declares. With `machine` (the rows of
// Compiler/Prelude/Effects.jet) each type needs its `#FX` line.
effect_vocabulary_source_rows: fn(source: String, path: String, machine: [EffectVocabularyRow]?) -> [EffectVocabularyRow] {
    effect_vocabulary_source_scan(source, path, machine, 0).rows
}

// What one source declares: its rows, and its effect declarations as the
// parser builds them (parser_finish_effect_type), each type's name and then
// each case of a family as `Root.Case`, in source order. A declaration's
// span is its name's, in a text that holds `source` from byte `base`.
EffectVocabularyScan: struct {
    rows: [EffectVocabularyRow],
    decls: [EffectDecl],
}

effect_vocabulary_source_scan: fn(source: String, path: String, machine: [EffectVocabularyRow]?, base: Int) -> EffectVocabularyScan {
    ^rows: [EffectVocabularyRow]{}
    ^decls: [EffectDecl]{}
    lines: source.split("\n").to_list()
    ^type_name: ""
    ^type_span: Span{start: 0, end: 0}
    ^family: false
    ^cases: [String]{}
    ^case_spans: [Span]{}
    ^body: String?{None}
    ^expert_body: String?{None}
    ^access_body: String?{None}
    ^action_body: String?{None}
    ^root_action_text: String?{None}
    ^parent: String?{None}
    ^impl_seen: false
    ^in_impl: false
    ^access_depth: 0
    ^access_lines: [String]{}
    ^kernel: [String]{}
    ^listed: false
    impl_head: "irreversible: fn(self) -> Bool {{ "
    expert_head: "expert: fn(self) -> Bool {{ "
    access_head: "access: fn(self) -> EffectAccess {{ "
    access_open: "access: fn(self) -> EffectAccess {{"
    action_head: "action: fn(self) -> String {{ "
    root_action_head: "root_action: "
    parent_head: "parent: "
    ^offset: base
    loop index in 0..<lines.len() {
        raw: lines[index]
        // The byte where the line's first word starts.
        start: offset + raw.bytes().len() - raw.trim_start().bytes().len()
        offset += raw.bytes().len() + 1
        comment: raw.find(COMMENT_PREFIX)
        line: if comment < 0 -> raw.trim() else -> foundation_byte_text(raw.bytes(), 0, comment).trim()
        if line == "" -> next
        fields: effect_vocabulary_words(line)
        place: "{path}:{index + 1}"
        if type_name == "" {
            if machine == .Val(known) {
                if line == "#FX" && !listed {
                    kernel = [String]{}
                    listed = true
                    next
                }
                if line.starts_with("#FX(") && line.ends_with(")") && !listed {
                    kernel = effect_vocabulary_kernel(line, known, place)
                    listed = true
                    next
                }
                if !listed {
                    build_time_refused("{place}: expected the `#FX` or `#FX(…)` line above a Core effect")
                }
            }
            if fields.len() != 3 || !fields[0].ends_with(":") || (fields[1] != "struct" && fields[1] != "enum") || fields[2] != "{{" {
                build_time_refused("{place}: expected `Name: struct {{` or `Name: enum {{`")
            }
            name: fields[0].removesuffix(":")
            loop seen in rows {
                if seen.name == name -> build_time_refused("{place}: duplicate effect {name}")
            }
            if machine == .Val(known) {
                loop seen in known {
                    if seen.name == name {
                        build_time_refused("{place}: `{name}` is already a machine effect of {EFFECT_VOCABULARY_MACHINE_PATH}")
                    }
                }
            }
            type_span = Span{start: start, end: start + name.bytes().len()}
            type_name = name
            family = fields[1] == "enum"
            cases = [String]{}
            case_spans = [Span]{}
            body = None
            expert_body = None
            access_body = None
            action_body = None
            root_action_text = None
            parent = None
            impl_seen = false
            next
        }
        if in_impl {
            if access_depth > 0 {
                if line == "}}" {
                    access_depth -= 1
                    if access_depth == 0 {
                        access_body = Val(access_lines.join("\n"))
                        access_lines = [String]{}
                        next
                    }
                    access_lines.push(line)
                    next
                }
                if line.ends_with("{{") -> access_depth += 1
                access_lines.push(line)
                next
            }
            if line == "}}" {
                in_impl = false
                next
            }
            if line.starts_with(parent_head) && parent == None && family && cases.len() > 0 && body == None && expert_body == None && access_body == None {
                written: line.removeprefix(parent_head).removesuffix(",").trim()
                if written.split(".").to_list().len() != 2 || effect_vocabulary_row_at(rows, written) < 0 {
                    build_time_refused("{place}: `parent: {written}` names no `Root.Case` effect declared above it")
                }
                if effect_vocabulary_row_at(rows, "{written}.{cases[0]}") >= 0 {
                    build_time_refused("{place}: `{written}` already has cases")
                }
                parent = Val(written)
                next
            }
            if line.starts_with(expert_head) && line.ends_with(" }}") && expert_body == None {
                expert_body = Val(line.removeprefix(expert_head).removesuffix(" }}").trim())
                next
            }
            if line == access_open && access_body == None {
                access_depth = 1
                access_lines = [String]{}
                next
            }
            if line.starts_with(access_head) && line.ends_with(" }}") && access_body == None {
                access_body = Val(line.removeprefix(access_head).removesuffix(" }}").trim())
                next
            }
            if line.starts_with(action_head) && line.ends_with(" }}") && action_body == None {
                action_body = Val(line.removeprefix(action_head).removesuffix(" }}").trim())
                next
            }
            if line.starts_with(root_action_head) && root_action_text == None {
                quoted: line.removeprefix(root_action_head).removesuffix(",").trim()
                parsed: effect_vocabulary_unquote(quoted) ?? build_time_refused("{place}: `root_action` must be a double-quoted string literal")
                root_action_text = Val(parsed)
                next
            }
            if body != None || !line.starts_with(impl_head) || !line.ends_with(" }}") {
                build_time_refused("{place}: expected `parent: Root.Case`, `irreversible: fn(self) -> Bool {{ … }}`, `expert: fn(self) -> Bool {{ … }}`, `access: fn(self) -> EffectAccess {{ … }}`, `action: fn(self) -> String {{ … }}`, or `root_action: \"…\"` in `impl Effect`")
            }
            body = Val(line.removeprefix(impl_head).removesuffix(" }}").trim())
            next
        }
        if line == "impl Effect {{}}" || line == "impl Effect {{" {
            if impl_seen {
                build_time_refused("{place}: `{type_name}` has a second `impl Effect` block")
            }
            impl_seen = true
            in_impl = line == "impl Effect {{"
            next
        }
        if line == "}}" {
            if !impl_seen -> build_time_refused("{place}: `{type_name}` has no `impl Effect` block")
            if family && cases.len() == 0 {
                build_time_refused("{place}: the effect family `{type_name}` has no cases")
            }
            ^parent_access: EffectAccess.Reads
            if parent == .Val(parent_name) {
                parent_index: effect_vocabulary_row_at(rows, parent_name)
                if parent_index >= 0 -> parent_access = rows[parent_index].access
            }
            ^case_facts: [{irreversible: Bool, expert: Bool, access: EffectAccess, action: String}]{}
            ^any: false
            ^root_access: EffectAccess.Reads
            loop member in cases {
                irreversible: effect_vocabulary_fact(body, cases, Val(member)) ?? build_time_refused("{place}: `{type_name}`'s `irreversible` body is not `true`, `false`, `self == .Case` or an `||` of those")
                expert: effect_vocabulary_fact(expert_body, cases, Val(member)) ?? build_time_refused("{place}: `{type_name}`'s `expert` body is not `true`, `false`, `self == .Case` or an `||` of those")
                access: if access_body == None && parent != None -> parent_access else -> (effect_vocabulary_access_fact(access_body, cases, Val(member)) ?? build_time_refused("{place}: `{type_name}`'s `access` body is not `.Reads`, `.Adds`, `.Replaces`, or an `if self == .Case -> …` chain"))
                action: effect_vocabulary_action_fact(action_body, cases, Val(member)) ?? build_time_refused("{place}: `{type_name}`'s `action` body is not a string literal or `if self == .Case -> \"…\" else -> \"…\"`")
                if irreversible -> any = true
                root_access = effect_access_max(root_access, access)
                case_facts.push({irreversible: irreversible, expert: expert, access: access, action: action})
            }
            ^root: any
            ^root_expert: false
            fallback_action: if case_facts.len() > 0 -> case_facts[0].action else -> ""
            ^root_action: root_action_text ?? fallback_action
            if !family {
                root = effect_vocabulary_fact(body, cases, None) ?? build_time_refused("{place}: `{type_name}`'s `irreversible` body is not `true` or `false`")
                root_expert = effect_vocabulary_fact(expert_body, cases, None) ?? build_time_refused("{place}: `{type_name}`'s `expert` body is not `true` or `false`")
                root_access = effect_vocabulary_access_fact(access_body, cases, None) ?? build_time_refused("{place}: `{type_name}`'s `access` body is not `.Reads`, `.Adds`, or `.Replaces`")
                root_action = root_action_text ?? (effect_vocabulary_action_fact(action_body, cases, None) ?? build_time_refused("{place}: `{type_name}`'s `action` body is not a string literal"))
            }
            // A family under a parent case names its cases below that case.
            prefix: parent ?? type_name
            if parent == None {
                decls.push(EffectDecl{name: "{type_name}", name_span: type_span, irreversible: root, span: type_span, access: root_access})
                rows.push(EffectVocabularyRow{name: type_name.copy(), irreversible: root, kernel: kernel.copy(), expert: root_expert, access: root_access, action: root_action})
            }
            loop (at, member) in cases {
                full: "{prefix}.{member}"
                decls.push(EffectDecl{name: "{full}", name_span: case_spans[at], irreversible: case_facts[at].irreversible, span: case_spans[at], access: case_facts[at].access})
                rows.push(EffectVocabularyRow{name: full, irreversible: case_facts[at].irreversible, kernel: kernel.copy(), expert: case_facts[at].expert, access: case_facts[at].access, action: case_facts[at].action})
            }
            type_name = ""
            kernel = [String]{}
            listed = false
            next
        }
        if !family || fields.len() != 1 || impl_seen {
            build_time_refused("{place}: expected an effect family case name, `impl Effect` or `}}`")
        }
        // A case ends at its comma.
        member: line.removesuffix(",")
        if cases.contains(member) {
            build_time_refused("{place}: duplicate effect {type_name}.{member}")
        }
        case_spans.push(Span{start: start, end: start + member.bytes().len()})
        cases.push(member)
    }
    if type_name != "" -> build_time_refused("{path}: `{type_name}` is not closed")
    if rows.len() == 0 -> build_time_refused("{path} declares no effects")
    EffectVocabularyScan{rows: rows, decls: decls}
}

// The machine effects of a `#FX(…)` line above a Core effect: each entry a
// root or leaf of `machine`, listed once.
effect_vocabulary_kernel: fn(line: String, machine: [EffectVocabularyRow], place: String) -> [String] {
    ^kernel: [String]{}
    loop part in line.removeprefix("#FX(").removesuffix(")").split(",") {
        entry: part.trim()
        ^known: false
        loop row in machine {
            if row.name == entry -> known = true
        }
        if !known {
            build_time_refused("{place}: `{entry}` is no machine effect of {EFFECT_VOCABULARY_MACHINE_PATH}")
        }
        if kernel.contains(entry) -> build_time_refused("{place}: `{entry}` is listed twice")
        kernel.push(entry.copy())
    }
    if kernel.len() == 0 -> build_time_refused("{place}: the `#FX(…)` line lists no machine effect")
    kernel
}

// The position of the row named `name` in `rows`, or -1.
effect_vocabulary_row_at: fn(rows: [EffectVocabularyRow], name: String) -> Int {
    loop (at, row) in rows {
        if row.name == name -> return at
    }
    -1
}

// An `irreversible` body's value for one case (None for a struct), or None
// when the body is not the effect fact form. No body is `false`.
effect_vocabulary_fact: fn(body: String?, cases: [String], member: String?) -> Bool? {
    written: body ?? return Val(false)
    ^holds: false
    loop part in written.split("||") {
        term: part.trim()
        if {
            term == "true" -> holds = true
            term == "false" -> {}
            term.starts_with("self == .") -> {
                named: term.after("self == .")
                if member == None || !cases.contains(named.copy()) -> return None
                if member == .Val(case_name) && case_name == named -> holds = true
            }
            else -> return None
        }
    }
    Val(holds)
}

// An `access` body's value for one case (None for a struct), or None when the
// body is not `.Reads`, `.Adds`, `.Replaces`, an `if self == .Case -> …`
// chain, or an `if { self == .Case -> …; else -> … }` arm table. No body
// defaults to `Reads`.
effect_vocabulary_access_fact: fn(body: String?, cases: [String], member: String?) -> EffectAccess? {
    written: body ?? return Val(EffectAccess.Reads)
    if effect_access_parse(written) == .Val(direct) -> return Val(direct)
    if member == None -> return None
    if written.starts_with("if {{") && written.ends_with("}}") {
        inner: written.removeprefix("if {{").removesuffix("}}").trim()
        ^matched: EffectAccess?{None}
        ^fallback: EffectAccess?{None}
        loop raw_arm in inner.split("\n") {
            arm: raw_arm.trim()
            if arm == "" -> next
            arrow: arm.find(" -> ")
            if arrow < 0 -> return None
            cond_text: foundation_byte_text(arm.bytes(), 0, arrow).trim()
            val_text: foundation_byte_text(arm.bytes(), arrow + 4, arm.bytes().len()).trim()
            parsed: effect_access_parse(val_text) ?? return None
            if cond_text == "else" {
                fallback = Val(parsed)
                next
            }
            cond: effect_vocabulary_fact(Val(cond_text), cases, member) ?? return None
            if matched == None && cond -> matched = Val(parsed)
        }
        if matched == .Val(found) -> return Val(found)
        return fallback
    }
    if !written.starts_with("if ") -> return None
    ^rest: written.removeprefix("if ")
    ^matched: EffectAccess?{None}
    loop {
        arrow: rest.find(" -> ")
        if arrow < 0 -> return None
        cond_text: foundation_byte_text(rest.bytes(), 0, arrow).trim()
        cond: effect_vocabulary_fact(Val(cond_text), cases, member) ?? return None
        after_arrow: foundation_byte_text(rest.bytes(), arrow + 4, rest.bytes().len()).trim()
        else_if: after_arrow.find(" else if ")
        else_at: after_arrow.find(" else -> ")
        if else_if >= 0 && (else_at < 0 || else_if < else_at) {
            branch_text: foundation_byte_text(after_arrow.bytes(), 0, else_if).trim()
            branch: effect_access_parse(branch_text) ?? return None
            if matched == None && cond -> matched = Val(branch)
            rest = foundation_byte_text(after_arrow.bytes(), else_if + 9, after_arrow.bytes().len()).trim()
            next
        }
        if else_at < 0 -> return None
        then_text: foundation_byte_text(after_arrow.bytes(), 0, else_at).trim()
        else_text: foundation_byte_text(after_arrow.bytes(), else_at + 9, after_arrow.bytes().len()).trim()
        then_val: effect_access_parse(then_text) ?? return None
        else_val: effect_access_parse(else_text) ?? return None
        if matched == .Val(found) -> return Val(found)
        return Val(if cond -> then_val else -> else_val)
    }
}

effect_vocabulary_unquote: fn(text: String) -> String? Never! {
    cleaned: text.trim()
    bytes: cleaned.bytes()
    if bytes.len() < 2 || bytes[0] != (U8{34}) || bytes[bytes.len() - 1] != (U8{34}) -> return None
    Val(foundation_byte_text(bytes, 1, bytes.len() - 1))
}

// An `action` body's string value for one case (None for a struct), or None
// when the body is not a quoted string literal or an `if self == .Case -> "…" else -> "…"`
// chain. No body defaults to `""`.
effect_vocabulary_action_fact: fn(body: String?, cases: [String], member: String?) -> String? {
    written: body ?? return Val("")
    if effect_vocabulary_unquote(written) == .Val(direct) -> return Val(direct)
    if member == None || !written.starts_with("if ") -> return None
    ^rest: written.removeprefix("if ")
    ^matched: String?{None}
    loop {
        arrow: rest.find(" -> ")
        if arrow < 0 -> return None
        cond_text: foundation_byte_text(rest.bytes(), 0, arrow).trim()
        cond: effect_vocabulary_fact(Val(cond_text), cases, member) ?? return None
        after_arrow: foundation_byte_text(rest.bytes(), arrow + 4, rest.bytes().len()).trim()
        else_if: after_arrow.find(" else if ")
        else_at: after_arrow.find(" else -> ")
        if else_if >= 0 && (else_at < 0 || else_if < else_at) {
            branch_text: foundation_byte_text(after_arrow.bytes(), 0, else_if).trim()
            branch: effect_vocabulary_unquote(branch_text) ?? return None
            if matched == None && cond -> matched = Val(branch)
            rest = foundation_byte_text(after_arrow.bytes(), else_if + 9, after_arrow.bytes().len()).trim()
            next
        }
        if else_at < 0 -> return None
        then_text: foundation_byte_text(after_arrow.bytes(), 0, else_at).trim()
        else_text: foundation_byte_text(after_arrow.bytes(), else_at + 9, after_arrow.bytes().len()).trim()
        then_val: effect_vocabulary_unquote(then_text) ?? return None
        else_val: effect_vocabulary_unquote(else_text) ?? return None
        if matched == .Val(found) -> return Val(found)
        return Val(if cond -> then_val else -> else_val)
    }
}
