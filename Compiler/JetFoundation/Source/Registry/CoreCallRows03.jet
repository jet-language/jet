            unit_receiver := match op { THardwareCall.RegisterRead { .. } | THardwareCall.RegisterWrite { .. } | THardwareCall.DmaStart { .. } => true, _ => false }
            recv := if unit_receiver { TExpr { ty: Type.Named(Syntax.INTERNAL_UNIT_TYPE.to_string()), kind: TExprKind.Unit } } else { lowered_receiver.unwrap_or_else(fn() { lower_expr(receiver, cx, env) }) }
            lowered_args := args.iter().map(fn(arg) { lower_expr(&arg.expr, cx, env) }).collect<[TExpr]>()
            (operation, ty) := match op {
