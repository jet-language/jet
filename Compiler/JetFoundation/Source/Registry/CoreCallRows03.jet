// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:3580
fn lower_app_route_callback(expr: &Expr, cx: &Cx, env: &LowerEnv) -> TExpr Never! {
    params := match expr {
        Expr.Ident(name, _) => cx.fn_types.get(name).and_then(fn(ty) { match ty { Type.Fn { params, .. } => Some(params.clone()), _ => None } })
        _ => None
    }
    if params is Some(types) {
        if lower_named_collection_callback(expr, cx, env, true, Some(types.as_slice())) is Some(callback) {
            return TExpr { ty: callback.ty.clone(), kind: TExprKind.FnValue { kind: TFnValueKind.Send { value: ^callback } } }
        }
    }
    lower_app_callback(expr, cx, env)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:3609
fn app_route_type_name(ty: &Type) -> String Never! {
    match ty { Type.Int => "Int", Type.Float => "Float", Type.Bool => "Bool", Type.String => "String", Type.Named(name) => name.clone(), other => other.show() }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:3628
fn app_route_binding(method: String, handler: &Expr?, cx: &Cx) -> String Never! {
    if handler is Some(Expr.Ident(name, _)) {
        if (cx.fn_param_names.get(name), cx.fn_source_types.get(name)) is (Some(names), Some(Type.Fn { params, .. })) {
            return names.iter().zip(params.iter()).map(fn(pair) {
                (param, source_ty) := pair
                (ty, optional) := match source_ty { Type.Option(inner) => (inner, true), other => (other, false) }
                if param == "data" && method != "loader" { return "d" }
                if ty is Type.Named(record) {
                    if cx.struct_fields.get(record) is Some(fields) {
                        text := fields.iter().map(fn(field) {
                            match field.1 { Type.Option(inner) => "{field.0}={app_route_type_name(inner)}?", other => "{field.0}={app_route_type_name(other)}" }
                        }).collect<[String]>().join(",")
                        return "s=json:{text}"
                    }
                }
                text := app_route_type_name(ty)
                if optional { text = "{text}?" }
                if param == "search" || param == "query" { "s=query:{param}={text}" } else { "p:{param}={text}" }
            }).collect<[String]>().join(";")
        }
    }
    String.new()
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:3675
fn lower_game_handle_receiver(receiver: &Expr, cx: &Cx, env: &LowerEnv) -> TExpr? Never! {
    if receiver is Expr.Field(base, field, _) {
        if tir_recv_jet_ty(base, env) is Some(Type.Named(owner)) {
            target := match (owner, field) { ("GameScene", "assets") => "GameAssets", ("GameScene", "input") => "GameInputMap", ("GameFrame", "input") => "GameInputSnapshot", _ => return None }
            value := lower_expr(base, cx, env)
            return Some(TExpr { ty: Type.Named(target.to_string()), kind: TExprKind.Field { recv: ^value, field: field.clone(), boxed: false } })
        }
    }
    None
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:3700
fn infer_comptime_host_owner(receiver: &Expr, method: String) -> String? Never! {
    if !(receiver is Expr.ComptimeName { .. }) { return None }
    match method {
        "tokens" => Some("CompilerLexed")
        "items" => Some("CompilerSyntaxTree")
        "functions" | "effects" | "semantic_index" | "syntax" => Some("CompilerChecked")
        "generated_lines" | "sources" => Some("CompilerSourceMap")
        "outputs" | "build_profiles" | "dependencies" => Some("CompilerManifest")
        "version" | "schema_version" | "root_dependencies" | "packages" => Some("CompilerLock")
        "profiles" => Some("CompilerProfileSet")
        _ => None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:3720
fn host_named_type(ty: &Type) -> String? Never! {
    match ty {
        Type.Named(name) | Type.Apply { name, .. } => Some(name.clone())
        Type.Option(inner) | Type.Tagged { inner, .. } => host_named_type(inner)
        Type.Result { ok, .. } => host_named_type(ok)
        _ => None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:3729
fn lower_build_generate(receiver: &Expr, method: String, args: &[CallArg], resolved_ret: &Type?, cx: &Cx, env: &LowerEnv, lowered_receiver: TExpr?) -> TExpr? Never! {
    if method != "generate" { return None }
    template := args.iter().find_map(fn(arg) { arg.flags.template_items.as_deref() })
    if template is None { return None }
    source := match format_template_body(template.unwrap(), [:], [:], OSPath.new(".")) {
        Ok(text) => text
        Err(diag) => return Some(invariant_method_expr(args.last().map(fn(arg) { arg.span }).unwrap_or_else(fn() { receiver.span() }), diag.what))
    }
    if args.iter().find(fn(arg) { arg.flags.template_items.is_none() }) is Some(name_arg) {
        return Some(in_own_frame(fn() {
            recv := lowered_receiver.unwrap_or_else(fn() { lower_expr(receiver, cx, env) })
            name := lower_expr(&name_arg.expr, cx, env)
            source_expr := TExpr { ty: Type.String, kind: TExprKind.StrLit([TStrPart.Lit(^source)]) }
            ty := match resolved_ret {
                Some(ty) if ty is Type.Result { .. } => ty.clone()
                _ => builtin_method_return(&Type.Named(Syntax.TYPE_BUILD_CONTEXT.to_string()), "generate", 2, false).flatten().unwrap_or_else(unit_type)
            }
            TExpr { ty: ^ty, kind: TExprKind.HostCall(THostCall.Method { recv: ^recv, method: "generate", args: [^name, ^source_expr] }) }
        }))
    }
    None
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:3790
fn lower_comptime_host_method(receiver: &Expr, method: String, args: &[CallArg], recv_type: &String?, resolved_ret: &Type?, cx: &Cx, env: &LowerEnv, lowered_receiver: TExpr?) -> TExpr? Never! {
    if method == "generate" { return None }
    owner_hint := recv_type.clone().or_else(fn() { tir_recv_jet_ty(receiver, env).and_then(fn(ty) { host_named_type(&ty) }) }).or_else(fn() { infer_comptime_host_owner(receiver, method).map(fn(name) { name.to_string() }) })
    if owner_hint is None { return None }
    ty_name := owner_hint.unwrap()
    if comptime_host_type_leaf(ty_name) == Syntax.TYPE_BUILD_CONTEXT || !is_comptime_host_method(ty_name, method) { return None }
    recv := lowered_receiver.unwrap_or_else(fn() { lower_expr(receiver, cx, env) })
    if host_named_type(&recv.ty) is Some(actual) { if !is_comptime_host_method(actual, method) { return None } }
    owner := host_named_type(&recv.ty).filter(fn(name) { is_comptime_host_method(name, method) }).unwrap_or(^ty_name)
    Some(in_own_frame(fn() {
        targs := args.iter().map(fn(arg) { lower_expr(&arg.expr, cx, env) }).collect()
        ty := resolved_ret.cloned().or_else(fn() { builtin_method_return(&Type.Named(comptime_host_type_leaf(owner).to_string()), method, args.len(), false).flatten() }).unwrap_or_else(unit_type)
        TExpr { ty: ^ty, kind: TExprKind.HostCall(THostCall.Method { recv: ^recv, method: method.to_string(), args: ^targs }) }
    }))
}
