// Rust: crates/jet-foundation/src/Syntax/core_calls.rs:3630
pub fn core_module_for_alias(alias: String) -> String? Never! {
    found := String?{None}
    loop row in CORE_CALLS {
        if !row.receiver_types.is_empty() -> next
        module :: row.module_name
        if (module.rsplit(".").next() ?? module) != alias -> next
        if found == .Val(known) {
            if known != module -> return None
        }
        found = Val(module)
    }
    if found != None -> return found
    loop module in KNOWN_CORE_MODULES {
        if (module.rsplit(".").next() ?? module) != alias -> next
        if found == .Val(known) {
            if known != module -> return None
        }
        found = Val(module)
    }
    found
}
// Rust: crates/jet-foundation/src/Syntax/core_calls.rs:3666
pub fn core_module_for_call(module: String, member: String) -> String? Never! {
    if core_call(module, member) == .Val(row) -> return Val(row.module_name)
    if module == "core.encoding" && core_call_one_of(member, [String]{"parse", "decode", "to_string", "to_string_pretty", "canonical", "events"}) {
        return Val("core.encoding.json")
    }
    None
}
