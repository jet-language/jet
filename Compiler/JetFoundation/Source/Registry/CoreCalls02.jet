use JetFoundation.Syntax.[KNOWN_CORE_MODULES]

// Rust: crates/jet-foundation/src/Syntax/core_calls.rs:1824-3584
// CORE_CALLS is already real Jet at Registry/CoreCallRows.jet:8-1765 (same declaration order,
// from core.prelude.keep through core.web.on). Reuse that canonical table; do not redeclare it.
// Rust native_int_result metadata requires reconciliation at the canonical row/record owner.
// Rust: crates/jet-foundation/src/Syntax/core_calls.rs:3588
fn assert_core_call_coverage() Never! {
    loop row in CORE_CALLS {
        assert((row.coverage.bits & (255 - CORE_CALL_COVERAGE_KNOWN)) == 0,
            "Core-call registry row declares unknown coverage bits")
        if core_call_coverage_contains(row.coverage, CORE_CALL_COVERAGE_INTERPRETER) {
            assert(core_call_interpreter_route_is_executable(row.interpreter_route),
                "Core-call registry row declares interpreter coverage without an executable route")
        }
        if core_call_interpreter_route_is_executable(row.interpreter_route) {
            assert(core_call_coverage_contains(row.coverage, CORE_CALL_COVERAGE_INTERPRETER),
                "Core-call registry row has an executable route without interpreter coverage")
        }
    }
}
// Rust: crates/jet-foundation/src/Syntax/core_calls.rs:3616
CORE_CALL_COVERAGE_ASSERTION :: prep { assert_core_call_coverage() }
// Rust: crates/jet-foundation/src/Syntax/core_calls.rs:3606
