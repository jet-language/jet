// Rust: crates/jet-foundation/src/Syntax/core_calls.rs:3815
// Typed keys preserve exact receiver list identity/order; no encoded composite map keys.
// GATE #4499: enum/array composite key equality and hashing.
enum CoreCallRegistryKey { Plain(String), Receiver(types: [String], member: String) }
fn registry_duplicate_key(row: CoreCallRecord) -> CoreCallRegistryKey Never! {
    if core_call_is_receiver(row) -> CoreCallRegistryKey.Receiver(~row.receiver_types, row.member)
    else -> CoreCallRegistryKey.Plain(core_call_key(row))
}
// Rust: crates/jet-foundation/src/Syntax/core_calls.rs:3758
pub fn core_call_table_violations(rows: View<CoreCallRecord>) -> [String] Never! {
    violations := [String]{}
    counts := [CoreCallRegistryKey:Int]{}
    loop row in rows {
        key :: registry_duplicate_key(row)
        counts[key] = (counts.get(key) ?? 0) + 1
    }
    loop (index, row) in rows {
        if (!core_call_is_receiver(row) && row.module_name.is_empty()) || row.member.is_empty() {
            &violations.push("row {index} has an empty Core key")
        }
        if !core_call_is_receiver(row) && core_call_symbol_name(row.symbol).is_empty() {
            &violations.push("{row.module_name}.{row.member} has no symbol")
        }
        if row.signature.arity != row.signature.borrow_mask.len() || row.signature.arity > row.signature.max_arity {
            &violations.push("{row.module_name}.{row.member} signature arity/range disagrees with its borrow mask")
        }
        loop access in row.frame_accesses {
            if access.argument >= row.signature.arity {
                &violations.push("{row.module_name}.{row.member} frame access argument {access.argument} is outside arity {row.signature.arity}")
            }
        }
        if !row.frame_accesses.is_empty() && row.frame_completion == None {
            &violations.push("{row.module_name}.{row.member} has frame accesses but no completion contract")
        }
        if row.frame_completion == .Val(completion) {
            if completion.provider.is_empty() -> &violations.push("{row.module_name}.{row.member} has an empty frame completion provider")
            if (completion.kind == CoreCallCompletionKind.Pending || completion.kind == CoreCallCompletionKind.Event) && completion.token == None {
                &violations.push("{row.module_name}.{row.member} has asynchronous frame completion without a token")
            }
        }
        if !core_call_capability_is_well_formed(row.capability) {
            &violations.push("{row.module_name}.{row.member} has a malformed capability/provider contract")
        }
        if row.coverage.bits == 0 -> &violations.push("{row.module_name}.{row.member} declares no consumer projection")
        unknown :: row.coverage.bits & (255 - CORE_CALL_COVERAGE_KNOWN)
        if unknown != 0 -> &violations.push("{row.module_name}.{row.member} declares unknown coverage bits 0x{unknown:02x}")
        if core_call_coverage_contains(row.coverage, CORE_CALL_COVERAGE_INTERPRETER) && !core_call_interpreter_route_is_executable(row.interpreter_route) {
            &violations.push("{row.module_name}.{row.member} declares interpreter coverage without an interpreter route")
        }
        // Rust emits one identical diagnostic per later duplicate, in row order.
        key :: registry_duplicate_key(row)
        remaining :: (counts.get(key) ?? 1) - 1
        counts[key] = remaining
        loop _ in 0..<remaining -> &violations.push("{row.module_name}.{row.member} appears twice")
    }
    ^violations
}
// Rust: crates/jet-foundation/src/Syntax/core_calls.rs:3853
pub fn core_call_coverage_violations(rows: View<CoreCallRecord>, projection: Int) -> [String] Never! {
    violations := [String]{}
    loop row in rows {
        if !core_call_coverage_contains(row.coverage, projection) {
            &violations.push("{row.module_name}.{row.member} missing projection 0x{projection:02x}")
        }
        if projection == CORE_CALL_COVERAGE_INTERPRETER && core_call_coverage_contains(row.coverage, CORE_CALL_COVERAGE_INTERPRETER) && !core_call_interpreter_route_is_executable(row.interpreter_route) {
            &violations.push("{row.module_name}.{row.member} declares interpreter coverage without an interpreter route")
        }
    }
    ^violations
}
// Rust: crates/jet-foundation/src/Syntax/core_calls.rs:3878
pub fn core_call_mismatch(rows: View<CoreCallRecord>, consumer: String, consumer_keys: View<(module: String, member: String)>) -> [String] Never! {
    // GATE #4499: exact composite tuple map keys, preserving independent module/member identity.
    declared := [(String, String):Bool]{}
    projected := [(String, String):Bool]{}
    loop key in consumer_keys -> projected[(key.module, key.member)] = true
    violations := [String]{}
    loop row in rows {
        if core_call_is_receiver(row) -> next
        key :: (row.module_name, row.member)
        declared[key] = true
        if !projected.contains_key(key) -> &violations.push("{consumer} does not project {row.module_name}.{row.member}")
    }
    loop key in consumer_keys {
        if !declared.contains_key((key.module, key.member)) -> &violations.push("{consumer} projects unknown {key.module}.{key.member}")
    }
    ^violations
}
