// Rust jet-foundation/src/Registry.rs:2175-2188. Only these registered rows
// carry a callable line break; unknown and all other row names return false.
pub fn callable_marker_needs_line_break(name: String) -> Bool Never! {
    name == "Meta" || name == "Unsafe" || name == "FFI" || name == "Target" || name == "WasmExport"
}
