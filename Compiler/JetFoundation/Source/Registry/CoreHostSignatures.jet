// Typed source-call projection of core_fixed_sig_impl's bounded host rows.
// Keep this table independent from erased CoreCallRecord metadata. Rows use
// the grammar of `core_sig_row_lookup` (CorePlatformSignatures.jet).

core_host_callback_type: fn() -> Type Never! {
    Type.Fn{
        params: [Type]{Type.List{element: Type.Float}},
        ret: None,
        effect_bound: Val([EffectRowEntry]{}),
        param_contract: None,
        call_metadata: Val(FunctionCallMetadata{
            names: [String]{},
            defaults: [FunctionDefaultRef?]{},
            variadic: [Bool]{},
            conventions: [AccessConvention]{AccessConvention.Read},
            policies: CallablePolicyChain{policies: [CallablePolicy]{}},
        }),
        return_view_provenance: None,
    }
}

core_host_fixed_signature: fn(module_name: String, member: String) -> CoreTypedCallSignature? {
    rows: """
    core.files jet_std_files_open_reader_nonblocking String Result<FileReader,IOError>
    core.files __list_directory Int Result<[[u8]],IOError>
    core.http.client jet_http_build_resolve String,Int Result<[[u8]],String>
    core.watcher __event WatchHandle Event<WatchEvent>
    jet_builtins process_child_id ProcessChild Int
    jet_builtins process_child_wait ProcessChild Result<ProcessReceipt,IOError>
    jet_builtins process_child_exited ProcessChild Result<Bool,IOError>
    jet_builtins process_child_kill|process_child_terminate|process_child_interrupt ProcessChild Result<Unit,IOError>
    jet_builtins process_spec_cwd|process_spec_arg|process_spec_env_remove ProcessSpec,String ProcessSpec
    jet_builtins process_spec_args_extend ProcessSpec,[String] ProcessSpec
    jet_builtins process_spec_env ProcessSpec,String,String ProcessSpec
    jet_builtins process_spec_env_clear|process_spec_io_idle|process_spec_detached|process_spec_terminal ProcessSpec ProcessSpec
    jet_builtins process_spec_stdin|process_spec_stdout|process_spec_stderr ProcessSpec,ProcessStreamMode ProcessSpec
    jet_builtins process_spec_timeout|process_spec_cpu_time_limit ProcessSpec,Duration ProcessSpec
    jet_builtins process_spec_output_limit|process_spec_memory_limit|process_spec_memory_scope|process_spec_open_file_limit|process_spec_io_priority ProcessSpec,Int ProcessSpec
    jet_builtins process_spec_cpu_affinity ProcessSpec,[Int] ProcessSpec
    jet_builtins process_spec_terminal_with_policy ProcessSpec,TerminalPolicy ProcessSpec
    jet_builtins process_spec_under ProcessSpec,Authority ProcessSpec
    jet_builtins process_spec_plan ProcessSpec Result<ProcessPlan,IOError>
    jet_builtins process_spec_run|process_spec_run_checked ProcessSpec Result<ProcessReceipt,IOError>
    jet_builtins process_spec_spawn ProcessSpec Result<ProcessChild,IOError>
    core.term take Int Result<[u8],IOError>
    core.term stdout - Stdout
    core.term stderr - Stderr
    core.process __spec_fields [String],Bool,String,Bool,[String],[String],[String],Bool,ProcessStreamMode,ProcessStreamMode,ProcessStreamMode,Bool,Int,Bool,Int,Bool,Int,Bool,Int,Bool,Int,Bool,Bool,TerminalPolicy,Bool,String ProcessSpec
    core.process __spec_parent_death ProcessSpec ProcessSpec
    core.files __directory_fd Int (available:Bool,held:Bool,fd:Int)
    core.process __keep_open_raw ProcessSpec,Int,Int,Bool (spec:ProcessSpec,available:Bool,assigned_fd:Int,errno:Int)
    core.process __signal_add Int,Int,ProcessSignal (available:Bool,value:Int,errno:Int)
    core.process __signal_receiver Int Receiver<ProcessSignal>
    core.crypto.vault get String String?
    core.sync text_new String,String SyncText
    core.sync counter_new String,Int SyncCounter
    core.sync counter_inc SyncCounter,String,Int SyncCounter
    core.sync map_set SyncMap,String,String SyncMap
    core.testing fake_clock Int Clock
    jet_builtins to_bits_f32 F32 Int
    jet_builtins from_bits_f32 Int F32
    core.testing world fn(DeterministicWorld;Unit) Unit
    core.math sqrt|floor|ceil|fabs Float Float
    core.math fmod Float,Float Float
    core.math __numeric_stop String Never
    core.math.random seed Int -
    core.crypto __wipe ^[u8] -
    core.crypto __secret_keep ^[u8] -
    core.rt __callback Int,Int,callback RealtimeStream
    core.tasks after Duration,T Receiver<T> T
    core.game run ^GameScene,GameReplay?,GameBackend?,Int? String
    core.event __scope_new - EventScope
    core.event __policy_sync - EventPolicy
    core.event __event_with_policy EventPolicy Event<T> T
    core.event __hook_new R Hook<T,R> T|R
    core.event __decision_hook_new HookPolicy DecisionHook<T,E> T|E
    core.event __async_new AsyncPolicy,FailurePolicy Result<AsyncEvent<T,E>,EventConfigError> T|E
    core.rt __next_deadline RealtimeStream Instant
    core.rt __coded_stop String,String Never
    core.tasks __interval_ms Int Receiver<Int>
    core.tasks __channel_new - (sender:Sender<T>,receiver:Receiver<T>) T
    core.tasks __channel_bounded Int (sender:Sender<T>,receiver:Receiver<T>) T
    core.prelude __receipt_attach T,String,String,String Unit T
    core.encoding.json canonical Dyn String
    core.net __ip_from_bytes [u8] IPAddr
    core.net __socket_from_parts IPAddr,U16,U32,U32 SocketAddr
    """
    core_sig_row_lookup(rows, module_name, member)
}
