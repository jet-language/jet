// Typed source-call projection of core_fixed_sig_impl's bounded host rows.
// Keep this table independent from erased CoreCallRecord metadata.

fn core_host_typed_signature(module_name: String, member: String, types: [Type], return_type: ?Type, moved_index: ?Int) -> CoreTypedCallSignature {
    parameters := [CoreCallTypedParameter]{}
    loop (index, ty) in types {
        access := if moved_index == Val(index) -> AccessConvention.Move else -> AccessConvention.Read
        parameters.push(core_sig_positional(ty, access))
    }
    core_sig(module_name, member, parameters, return_type)
}

fn core_host_callback_type() -> Type {
    Type.Fn(
        params: [Type]{Type.List(element: Type.Float)},
        ret: None,
        effect_bound: Val([EffectRowEntry]{}),
        param_contract: None,
        call_metadata: Val(FunctionCallMetadata{
            names: [String]{},
            defaults: [?FunctionDefaultRef]{},
            variadic: [Bool]{},
            conventions: [AccessConvention]{AccessConvention.Read},
            policies: CallablePolicyChain{policies: [CallablePolicy]{}},
        }),
        return_view_provenance: None,
    )
}

pub fn core_host_fixed_signature(module_name: String, member: String) -> ?CoreTypedCallSignature {
    integer :: Type.Int
    float :: Type.Float
    boolean :: Type.Bool
    unit :: core_sig_named("Unit")
    io :: core_sig_named("IOError")
    time_error :: core_sig_named("TimeError")
    crypto_error :: core_sig_named("CryptoError")
    encoding_error :: core_sig_named("EncodingError")
    u8 :: Type.IntN(signed: false, bits: 8)
    list_u8 :: Type.List(element: u8)
    list_float :: Type.List(element: float)
    list_int :: Type.List(element: integer)
    list_bool :: Type.List(element: boolean)
    list_list_int :: Type.List(element: list_int)
    list_string :: Type.List(element: Type.String)
    counter :: core_sig_named("Counter")
    deque :: core_sig_named("Deque")
    ordered_map :: core_sig_named("OrderedMap")
    chain :: core_sig_named("Chain")
    string_set :: core_sig_named("StringSet")
    path :: Type.Union(members: [Type]{Type.String, core_sig_named("Path")})
    json :: core_sig_named("DataTree")
    measurement :: core_sig_apply("Measurement", float)
    io_unit :: core_sig_result(unit, io)

    if module_name == "core.files" {
        if member == "scope" -> return Val(core_host_typed_signature(module_name, member, [Type]{core_sig_named("Authority")}, Val(core_sig_named("FileScope")), None))
        if member == "read" -> return Val(core_host_typed_signature(module_name, member, [Type]{path}, Val(core_sig_result(Type.String, io)), None))
        if member == "read_bytes" -> return Val(core_host_typed_signature(module_name, member, [Type]{path}, Val(core_sig_result(list_u8, io)), None))
        if member == "map" -> return Val(core_host_typed_signature(module_name, member, [Type]{path}, Val(core_sig_result(core_sig_named("MappedFile"), io)), None))
        if core_sig_one_of(member, [String]{"write", "append_all"}) -> return Val(core_host_typed_signature(module_name, member, [Type]{path, Type.String}, Val(io_unit), None))
        if member == "write_bytes" -> return Val(core_host_typed_signature(module_name, member, [Type]{path, list_u8}, Val(io_unit), None))
        if core_sig_one_of(member, [String]{"exists", "is_dir"}) -> return Val(core_host_typed_signature(module_name, member, [Type]{path}, Val(boolean), None))
        if core_sig_one_of(member, [String]{"remove", "create_dir", "create_dir_all", "remove_dir", "remove_all"}) -> return Val(core_host_typed_signature(module_name, member, [Type]{path}, Val(core_sig_result(unit, io)), None))
        if core_sig_one_of(member, [String]{"stat", "lstat"}) -> return Val(core_host_typed_signature(module_name, member, [Type]{path}, Val(core_sig_result(core_sig_named("Stat"), io)), None))
        if core_sig_one_of(member, [String]{"is_fifo", "is_socket"}) -> return Val(core_host_typed_signature(module_name, member, [Type]{path}, Val(core_sig_result(boolean, io)), None))
        if member == "chown" -> return Val(core_host_typed_signature(module_name, member, [Type]{path, integer, integer}, Val(core_sig_result(unit, io)), None))
        if member == "mkdtemp" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String}, Val(core_sig_result(Type.String, io)), None))
        if member == "mktemp" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String}, Val(Type.String), None))
        if member == "set_mode" -> return Val(core_host_typed_signature(module_name, member, [Type]{path, integer}, Val(core_sig_result(unit, io)), None))
        if core_sig_one_of(member, [String]{"canonicalize", "absolute"}) -> return Val(core_host_typed_signature(module_name, member, [Type]{path}, Val(core_sig_result(Type.String, io)), None))
        if member == "list_dir" -> return Val(core_host_typed_signature(module_name, member, [Type]{path}, Val(core_sig_result(Type.List(element: core_sig_named("DirEntry")), io)), None))
        if core_sig_one_of(member, [String]{"copy", "rename"}) -> return Val(core_host_typed_signature(module_name, member, [Type]{path, path}, Val(core_sig_result(unit, io)), None))
        if member == "copy_dir" -> return Val(core_host_typed_signature(module_name, member, [Type]{path, path}, Val(core_sig_result(unit, io)), None))
        if core_sig_one_of(member, [String]{"symlink", "hard_link"}) -> return Val(core_host_typed_signature(module_name, member, [Type]{path, path}, Val(core_sig_result(unit, io)), None))
        if member == "read_link" -> return Val(core_host_typed_signature(module_name, member, [Type]{path}, Val(core_sig_result(Type.String, io)), None))
        if core_sig_one_of(member, [String]{"walk", "walk_parallel", "walk_files"}) -> return Val(core_host_typed_signature(module_name, member, [Type]{path, Type.Option(inner: Type.String)}, Val(core_sig_result(Type.List(element: core_sig_named("WalkEntry")), io)), None))
        if member == "glob" -> return Val(core_host_typed_signature(module_name, member, [Type]{path}, Val(core_sig_result(list_string, io)), None))
        if member == "read_at" -> return Val(core_host_typed_signature(module_name, member, [Type]{path, integer, integer}, Val(core_sig_result(list_u8, io)), None))
        if member == "write_at" -> return Val(core_host_typed_signature(module_name, member, [Type]{path, integer, list_u8}, Val(core_sig_result(unit, io)), None))
        if member == "fsync" -> return Val(core_host_typed_signature(module_name, member, [Type]{path}, Val(core_sig_result(unit, io)), None))
        if member == "write_atomic" -> return Val(core_host_typed_signature(module_name, member, [Type]{path, list_u8}, Val(core_sig_result(unit, io)), None))
        if member == "temp_dir" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String}, Val(core_sig_result(core_sig_named("TempDir"), io)), None))
        if member == "temp_file" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String}, Val(core_sig_result(core_sig_named("TempFile"), io)), None))
        if member == "lock" -> return Val(core_host_typed_signature(module_name, member, [Type]{path}, Val(core_sig_result(core_sig_named("FileLock"), io)), None))
        return None
    }
    if module_name == "core.watcher" {
        if member == "files" -> return Val(core_host_typed_signature(module_name, member, [Type]{path}, Val(core_sig_result(core_sig_named("WatchHandle"), io)), None))
        if member == "process_pid" -> return Val(core_host_typed_signature(module_name, member, [Type]{integer}, Val(core_sig_named("WatchHandle")), None))
        if member == "port" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String, integer}, Val(core_sig_named("WatchHandle")), None))
        if member == "set" -> return Val(core_host_typed_signature(module_name, member, [Type]{}, Val(core_sig_named("WatchSet")), None))
        return None
    }
    if module_name == "core.process" {
        if core_sig_one_of(member, [String]{"argv", "args"}) -> return Val(core_host_typed_signature(module_name, member, [Type]{}, Val(list_string), None))
        if member == "check" -> return Val(core_host_typed_signature(module_name, member, [Type]{core_sig_named("ProcessReceipt")}, Val(core_sig_result(unit, io)), None))
        if member == "status_ok" -> return Val(core_host_typed_signature(module_name, member, [Type]{core_sig_named("ProcessReceipt")}, Val(boolean), None))
        if member == "exit" -> return Val(core_host_typed_signature(module_name, member, [Type]{integer}, Val(core_sig_named("Never")), None))
        if member == "on_signal" -> return Val(core_host_typed_signature(module_name, member, [Type]{core_sig_named("ProcessSignal")}, Val(unit), None))
        if member == "cmd" -> return Val(core_host_typed_signature(module_name, member, [Type]{list_string}, Val(core_sig_named("ProcessSpec")), None))
        if member == "pipeline" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.List(element: core_sig_named("ProcessSpec"))}, Val(core_sig_result(core_sig_named("ProcessReceipt"), io)), None))
        return None
    }
    if module_name == "core.term" {
        if member == "confirm" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String}, Val(boolean), None))
        if member == "choose" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String, list_string}, Val(core_sig_result(Type.String, io)), None))
        if member == "input_secret" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String}, Val(core_sig_result(Type.String, io)), None))
        if member == "read_all_input" -> return Val(core_host_typed_signature(module_name, member, [Type]{}, Val(core_sig_result(Type.String, io)), None))
        if member == "readline" -> return Val(core_host_typed_signature(module_name, member, [Type]{}, Val(core_sig_result(Type.String, io)), None))
        if member == "read_until" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String}, Val(core_sig_result(Type.String, io)), None))
        if member == "take" -> return Val(core_host_typed_signature(module_name, member, [Type]{integer}, Val(core_sig_result(list_u8, io)), None))
        if member == "buffered" -> return Val(core_host_typed_signature(module_name, member, [Type]{}, Val(core_sig_named("StdinHandle")), None))
        if member == "binread" -> return Val(core_host_typed_signature(module_name, member, [Type]{path}, Val(core_sig_result(list_u8, io)), None))
        if member == "binwrite" -> return Val(core_host_typed_signature(module_name, member, [Type]{path, list_u8}, Val(core_sig_result(unit, io)), None))
        if member == "stdin" -> return Val(core_host_typed_signature(module_name, member, [Type]{}, Val(core_sig_named("StdinHandle")), None))
        if member == "stdout" -> return Val(core_host_typed_signature(module_name, member, [Type]{}, Val(core_sig_named("Stdout")), None))
        if member == "stderr" -> return Val(core_host_typed_signature(module_name, member, [Type]{}, Val(core_sig_named("Stderr")), None))
        if core_sig_one_of(member, [String]{"terminal_width", "terminal_height"}) -> return Val(core_host_typed_signature(module_name, member, [Type]{}, Val(integer), None))
        if core_sig_one_of(member, [String]{"style", "style_force"}) -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String, Type.String}, Val(Type.String), None))
        if member == "progress" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String}, Val(core_sig_result(unit, io)), None))
        return None
    }
    if module_name == "core.sys" {
        if member == "get" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String}, Val(Type.Option(inner: Type.String)), None))
        if member == "set" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String, Type.String}, None, None))
        if member == "unset" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String}, Val(core_sig_result(boolean, core_sig_named("EnvError"))), None))
        if member == "vars" -> return Val(core_host_typed_signature(module_name, member, [Type]{}, Val(core_sig_result(list_string, core_sig_named("EnvError"))), None))
        if member == "current_dir" -> return Val(core_host_typed_signature(module_name, member, [Type]{}, Val(core_sig_result(Type.String, io)), None))
        if member == "home_dir" -> return Val(core_host_typed_signature(module_name, member, [Type]{}, Val(Type.Option(inner: Type.String)), None))
        if core_sig_one_of(member, [String]{"name", "family", "arch", "temp_dir", "executable", "hostname", "username", "release", "version"}) -> return Val(core_host_typed_signature(module_name, member, [Type]{}, Val(Type.String), None))
        if member == "expand" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String}, Val(Type.String), None))
        if core_sig_one_of(member, [String]{"pid", "getpid", "cpu_count", "getppid", "getuid", "geteuid", "getgid", "getegid", "getpgrp"}) -> return Val(core_host_typed_signature(module_name, member, [Type]{}, Val(integer), None))
        if core_sig_one_of(member, [String]{"umask", "exitcode"}) -> return Val(core_host_typed_signature(module_name, member, [Type]{integer}, Val(integer), None))
        if member == "success" -> return Val(core_host_typed_signature(module_name, member, [Type]{integer}, Val(boolean), None))
        if member == "uptime" -> return Val(core_host_typed_signature(module_name, member, [Type]{}, Val(float), None))
        if member == "getgroups" -> return Val(core_host_typed_signature(module_name, member, [Type]{}, Val(list_int), None))
        if core_sig_one_of(member, [String]{"loadavg", "times"}) -> return Val(core_host_typed_signature(module_name, member, [Type]{}, Val(list_float), None))
        if core_sig_one_of(member, [String]{"getpgid", "getsid"}) -> return Val(core_host_typed_signature(module_name, member, [Type]{integer}, Val(core_sig_result(integer, io)), None))
        if member == "getpriority" -> return Val(core_host_typed_signature(module_name, member, [Type]{integer}, Val(core_sig_result(integer, io)), None))
        if member == "setpriority" -> return Val(core_host_typed_signature(module_name, member, [Type]{integer, integer}, Val(core_sig_result(unit, io)), None))
        if member == "utime" -> return Val(core_host_typed_signature(module_name, member, [Type]{path, integer, integer}, Val(core_sig_result(unit, io)), None))
        if member == "sync" -> return Val(core_host_typed_signature(module_name, member, [Type]{}, None, None))
        if member == "stop" -> return Val(core_host_typed_signature(module_name, member, [Type]{integer}, None, None))
        if member == "set_current_dir" -> return Val(core_host_typed_signature(module_name, member, [Type]{path}, Val(core_sig_result(unit, io)), None))
        if core_sig_one_of(member, [String]{"fork", "setsid", "wait"}) -> return Val(core_host_typed_signature(module_name, member, [Type]{}, Val(core_sig_result(integer, io)), None))
        if member == "waitpid" -> return Val(core_host_typed_signature(module_name, member, [Type]{integer, integer}, Val(core_sig_result(integer, io)), None))
        if core_sig_one_of(member, [String]{"setuid", "setgid"}) -> return Val(core_host_typed_signature(module_name, member, [Type]{integer}, Val(core_sig_result(unit, io)), None))
        if member == "setpgrp" -> return Val(core_host_typed_signature(module_name, member, [Type]{}, Val(core_sig_result(unit, io)), None))
        if core_sig_one_of(member, [String]{"setpgid", "kill"}) -> return Val(core_host_typed_signature(module_name, member, [Type]{integer, integer}, Val(core_sig_result(unit, io)), None))
        if member == "initgroups" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String, integer}, Val(core_sig_result(unit, io)), None))
        if member == "pipe" -> return Val(core_host_typed_signature(module_name, member, [Type]{}, Val(core_sig_result(list_int, io)), None))
        if member == "close_fd" -> return Val(core_host_typed_signature(module_name, member, [Type]{integer}, None, None))
        if member == "mkfifo" -> return Val(core_host_typed_signature(module_name, member, [Type]{path, integer}, Val(core_sig_result(unit, io)), None))
        return None
    }
    if module_name == "core.crypto.vault" && member == "get" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String}, Val(Type.Option(inner: Type.String)), None))
    if module_name == "core.auth" {
        if member == "verify_jwt" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String, list_u8, Type.String, Type.String, core_sig_named("Duration")}, Val(core_sig_result(core_sig_named("Claims"), core_sig_named("AuthError"))), None))
        if member == "verify_paseto" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String, list_u8, Type.String}, Val(core_sig_result(core_sig_named("Claims"), core_sig_named("AuthError"))), None))
        if member == "register_user" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String, Type.String}, Val(core_sig_result(unit, Type.String)), None))
        if core_sig_one_of(member, [String]{"password_login", "oauth_finish"}) -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String, Type.String, integer, integer}, Val(core_sig_result(core_sig_named("Session"), Type.String)), None))
        if member == "magic_link_consume" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String, integer, integer}, Val(core_sig_result(core_sig_named("Session"), Type.String)), None))
        if member == "session_validate" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String, integer}, Val(core_sig_result(core_sig_named("Session"), Type.String)), None))
        if core_sig_one_of(member, [String]{"session_show", "session_user", "session_cookie", "session_id"}) -> return Val(core_host_typed_signature(module_name, member, [Type]{core_sig_named("Session")}, Val(Type.String), None))
        if member == "magic_link_issue" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String, integer, integer}, Val(core_sig_result(Type.String, Type.String)), None))
        if member == "oauth_begin" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String}, Val(core_sig_result(Type.String, Type.String)), None))
        return None
    }
    if module_name == "core.sync" {
        if member == "text_new" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String, Type.String}, Val(core_sig_named("SyncText")), None))
        if member == "text_set" -> return Val(core_host_typed_signature(module_name, member, [Type]{core_sig_named("SyncText"), Type.String, Type.String}, Val(core_sig_named("SyncText")), None))
        if member == "text_merge" -> return Val(core_host_typed_signature(module_name, member, [Type]{core_sig_named("SyncText"), core_sig_named("SyncText")}, Val(core_sig_named("SyncText")), None))
        if member == "text_show" -> return Val(core_host_typed_signature(module_name, member, [Type]{core_sig_named("SyncText")}, Val(Type.String), None))
        if member == "text_edit" -> return Val(core_host_typed_signature(module_name, member, [Type]{core_sig_named("SyncText"), Type.String, integer, integer, Type.String}, Val(core_sig_named("SyncText")), None))
        if member == "text_metadata" -> return Val(core_host_typed_signature(module_name, member, [Type]{core_sig_named("SyncText")}, Val(Type.String), None))
        if member == "counter_new" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String, integer}, Val(core_sig_named("SyncCounter")), None))
        if member == "counter_inc" -> return Val(core_host_typed_signature(module_name, member, [Type]{core_sig_named("SyncCounter"), Type.String, integer}, Val(core_sig_named("SyncCounter")), None))
        if member == "counter_merge" -> return Val(core_host_typed_signature(module_name, member, [Type]{core_sig_named("SyncCounter"), core_sig_named("SyncCounter")}, Val(core_sig_named("SyncCounter")), None))
        if member == "counter_value" -> return Val(core_host_typed_signature(module_name, member, [Type]{core_sig_named("SyncCounter")}, Val(integer), None))
        if member == "map_new" -> return Val(core_host_typed_signature(module_name, member, [Type]{}, Val(core_sig_named("SyncMap")), None))
        if member == "list_new" -> return Val(core_host_typed_signature(module_name, member, [Type]{}, Val(core_sig_named("SyncList")), None))
        if member == "map_set" -> return Val(core_host_typed_signature(module_name, member, [Type]{core_sig_named("SyncMap"), Type.String, Type.String}, Val(core_sig_named("SyncMap")), None))
        if member == "map_get" -> return Val(core_host_typed_signature(module_name, member, [Type]{core_sig_named("SyncMap"), Type.String}, Val(Type.Option(inner: Type.String)), None))
        if member == "map_merge" -> return Val(core_host_typed_signature(module_name, member, [Type]{core_sig_named("SyncMap"), core_sig_named("SyncMap")}, Val(core_sig_named("SyncMap")), None))
        if member == "map_show" -> return Val(core_host_typed_signature(module_name, member, [Type]{core_sig_named("SyncMap")}, Val(Type.String), None))
        if member == "list_push" -> return Val(core_host_typed_signature(module_name, member, [Type]{core_sig_named("SyncList"), Type.String, Type.String}, Val(core_sig_named("SyncList")), None))
        if member == "list_merge" -> return Val(core_host_typed_signature(module_name, member, [Type]{core_sig_named("SyncList"), core_sig_named("SyncList")}, Val(core_sig_named("SyncList")), None))
        if member == "list_show" -> return Val(core_host_typed_signature(module_name, member, [Type]{core_sig_named("SyncList")}, Val(Type.String), None))
        if member == "policy_new" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String, Type.String}, Val(core_sig_result(core_sig_named("RowPolicy"), Type.String)), None))
        if member == "policy_allows" -> return Val(core_host_typed_signature(module_name, member, [Type]{core_sig_named("RowPolicy"), Type.String, Type.String}, Val(boolean), None))
        if member == "policy_show" -> return Val(core_host_typed_signature(module_name, member, [Type]{core_sig_named("RowPolicy")}, Val(Type.String), None))
        return None
    }
    if module_name == "core.testing" {
        if core_sig_one_of(member, [String]{"snap", "golden"}) -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String, Type.String}, Val(boolean), None))
        if core_sig_one_of(member, [String]{"fixture", "temp_dir"}) -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String}, Val(Type.String), None))
        if member == "corpus" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String}, Val(list_string), None))
        if member == "fake_clock" -> return Val(core_host_typed_signature(module_name, member, [Type]{integer}, Val(core_sig_named("Clock")), None))
        if member == "fake_rng" -> return Val(core_host_typed_signature(module_name, member, [Type]{integer}, Val(core_sig_named("Rng")), None))
        if member == "fake_data" -> return Val(core_host_typed_signature(module_name, member, [Type]{integer}, Val(core_sig_named("Fake")), None))
        if member == "test_suite" -> return Val(core_host_typed_signature(module_name, member, [Type]{}, Val(core_sig_named("TestSuite")), None))
        if member == "world" -> return Val(core_host_typed_signature(module_name, member, [Type]{core_sig_fn([Type]{core_sig_named("DeterministicWorld")}, unit)}, Val(unit), None))
        if member == "compare" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.List(element: core_sig_named("DataTree")), core_sig_fn([Type]{core_sig_named("DataTree")}, core_sig_named("DataTree")), core_sig_fn([Type]{core_sig_named("DataTree")}, core_sig_named("DataTree")), Type.String}, Val(core_sig_named("TestComparison")), None))
        if member == "assert_equal" -> return Val(core_host_typed_signature(module_name, member, [Type]{core_sig_named("TestComparison")}, Val(boolean), None))
        if member == "status" -> return Val(core_host_typed_signature(module_name, member, [Type]{core_sig_named("TestComparison")}, Val(Type.String), None))
        return None
