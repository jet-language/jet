        if member == "first" -> return Val(core_host_typed_signature(module_name, member, [Type]{Type.String}, Val(core_sig_result(Type.Option(inner: json), encoding_error)), None))
        if member == "reader" -> return Val(core_host_typed_signature(module_name, member, [Type]{core_sig_named("FileReader"), core_sig_named("EncodingLimits")}, Val(core_sig_result(core_sig_named("JSONLReader"), encoding_error)), Val(0)))
        if member == "writer" -> return Val(core_host_typed_signature(module_name, member, [Type]{core_sig_named("FileWriter"), core_sig_named("EncodingLimits")}, Val(core_sig_result(core_sig_named("JSONLWriter"), encoding_error)), Val(0)))
