        if member == "events" -> return Val(core_host_typed_signature(module_name, member, [Type]{json}, Val(Type.String), None))
        if member == "reader" -> return Val(core_host_typed_signature(module_name, member, [Type]{core_sig_named("FileReader"), core_sig_named("EncodingLimits")}, Val(core_sig_result(core_sig_named("JSONReader"), encoding_error)), Val(0)))
        if member == "writer" -> return Val(core_host_typed_signature(module_name, member, [Type]{core_sig_named("FileWriter"), core_sig_named("EncodingLimits"), boolean}, Val(core_sig_result(core_sig_named("JSONWriter"), encoding_error)), Val(0)))
