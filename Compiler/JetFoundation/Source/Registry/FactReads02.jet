}
// Rust: crates/jet-foundation/src/Registry.rs:3129
fn fact_gates(value: String, line: String) -> [String] Never! {
    rest := value.strip_prefix("[") ?? diagnostic_ice(None, "fact gates must be a list in {line}") // #4303
    inner := rest.strip_suffix("]") ?? diagnostic_ice(None, "fact gates must be a list in {line}") // #4303
