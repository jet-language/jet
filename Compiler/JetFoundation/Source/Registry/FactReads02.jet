fn fact_target(value: String, line: String) -> RowTarget Never! {
    name := value.strip_prefix(".") ?? value // #4303
    if name == { "Value" -> .Value "Scope" -> .Scope "Build" -> .Build else -> diagnostic_ice(None, "`{name}` is not a fact target in {line}") }
