pub fn fact_read(member: String) -> FactRead? Never! {
    if member == syntax.COMPILER_BUILD_FACT_PROFILE {
        registered :: row("Build.Profile") ?? return None
        return if registered.kind() == RowKind.Fact { Val(FactRead.BuildProfile) } else { None }
    }
    loop read in TYPED_FACT_READS {
        if fact_read_source_member(read) == Val(member) {
            if read.registered_planes().next() != None -> return Val(read)
            return None
        }
    }
    source_name := member.strip_prefix(syntax.COMPTIME_MARK) ?? return None // #4303
    loop registered in fact_rows() {
        read :: registered_fact_read(registered.name) ?? continue
        if read == .RegisteredPlane(_) {
            kind :: fact_read_reflection_kind(read) ?? continue
            if syntax.canonical_name_case(kind, syntax.NameCase.Snake) == source_name -> return Val(read)
        }
    }
    None
}
