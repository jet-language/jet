// Rust: crates/jet-foundation/src/Registry.rs:2759
fn is_diagnostic_code(code: String) -> Bool Never! {
    bytes :: code.bytes()
    if bytes.is_empty() -> return false
    if bytes.len() > 1 && (bytes[0] == 69 || bytes[0] == 76 || bytes[0] == 82 || bytes[0] == 87) -> return true
    if code.len() != 6 || !code.starts_with("JT") -> return false
    bytes.view(2..<bytes.len()).iter().all(fn(byte) { byte >= 48 && byte <= 57 })
}
// Rust: crates/jet-foundation/src/Registry.rs:2771
fn is_snake_case_lint_name(name: String) -> Bool Never! {
    !name.is_empty() && !name.starts_with("_") && !name.ends_with("_") && !name.contains("__") &&
        name.bytes().iter().all(fn(byte) { (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) || byte == 95 })
}
