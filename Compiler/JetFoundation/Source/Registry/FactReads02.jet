// Rust: crates/jet-foundation/src/Registry.rs:3151
fn split_top_level(text: String) -> [String] Never! from text {
    entries := [String]{}
    start := 0
    depth := 0
    in_string := false
    escaped := false
    loop (index, byte) in text.bytes() {
        if in_string {
            if escaped { escaped = false }
            else if byte == 92 { escaped = true }
            else if byte == 34 { in_string = false }
            continue
        }
        if byte == 34 { in_string = true }
        else if byte == 91 || byte == 40 || byte == 123 { depth += 1 }
        else if byte == 93 || byte == 41 || byte == 125 { depth -= 1 }
        else if byte == 44 && depth == 0 {
            entry := text.slice(start..<index).trim() // #4303
            entries.push(entry)
            start = index + 1
        }
    }
    last := text.slice(start..<text.len()).trim() // #4303
    if !last.is_empty() { entries.push(last) }
    entries
}
// Rust: crates/jet-foundation/src/Registry.rs:3186
fn unquote(value: String, line: String) -> String Never! {
    rest := value.strip_prefix("\"") ?? diagnostic_ice(None, "fact decision must be quoted in {line}") // #4303
    inner := rest.strip_suffix("\"") ?? diagnostic_ice(None, "fact decision must be quoted in {line}") // #4303
    out := String.with_capacity(inner.len())
    escaped := false
    loop ch in inner.chars() {
        if escaped { out.push(ch); escaped = false }
        else if ch == '\\' { escaped = true }
        else { out.push(ch) }
    }
    out
}
