//RS /// D-ONCE-LAW1=A: how a guard proves there is no second copy.
//RS ///
//RS /// There are two ways and no third. A guard either runs both paths and
//RS /// compares the answers, or it counts the places the truth is defined and
//RS /// holds that count. Checking that the one home still exists proves nothing —
//RS /// a second copy passes that check — so it is not a variant and cannot be
//RS /// written down.
//RS #[derive(Debug, Clone, Copy, PartialEq, Eq)]
//RS pub enum GuardProof {
//RS     /// Runs the truth through every renderer and compares the answers.
//RS     DiffsBehavior,
//RS     /// Counts the definition sites in the corpus and refuses a second one.
//RS     CountsSites,
//RS }
//RS 
//RS impl GuardProof {
//RS     pub const fn name(self) -> &'static str {
//RS         match self {
//RS             Self::DiffsBehavior => "diffs behavior",
//RS             Self::CountsSites => "counts definition sites",
//RS         }
//RS     }
//RS }
//RS 
//RS /// D-ONCE-LAW1=A: the proof that a truth has one home.
//RS #[derive(Debug, Clone, Copy, PartialEq, Eq)]
//RS pub struct Guard {
//RS     /// The test function that runs the proof.
//RS     pub test: &'static str,
//RS     /// The file that holds it.
//RS     pub file: &'static str,
//RS     /// What the proof does. See `GuardProof`.
//RS     pub proof: GuardProof,
//RS }
