//RS     Scope,
//RS     /// What the build knows.
//RS     Build,
//RS     /// D-ONCE-LAW1=A: the compiler's own source. A truth stated once in one
//RS     /// file, rendered from there by everything that needs it.
//RS     Corpus,
//RS     /// D-REPORT-HOME1=A: a typed compile-time diagnostic row.
//RS     Report,
//RS }
