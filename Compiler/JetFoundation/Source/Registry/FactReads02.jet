}
// Rust: crates/jet-foundation/src/Registry.rs:2790
fn diagnostic_row_from_source(line: String) -> DiagnosticRegistryRow Never! {
    fields :: line.split("\t").collect()
    assert(fields.len() == 12 || fields.len() == 13, "diagnostic row needs 12 fields, or 13 with a lint name: {line}")
    assert(fields[0] == "diagnostic", "unknown diagnostic row kind: {line}")
    code :: unescape_source(fields[1])
    lint_name :: if fields.len() == 13 { Val(unescape_source(fields[12])) } else { None }
    stage :: unescape_source(fields[2])
    severity :: if fields[3] == { "error" -> DIAGNOSTIC_ERROR "lint" -> DIAGNOSTIC_LINT else -> diagnostic_ice(None, "unknown diagnostic severity `{fields[3]}` in {line}") }
    assert(is_diagnostic_code(code), "diagnostic code needs a nonempty E/L/R/W/JT identity: {line}")
    assert((severity == DIAGNOSTIC_LINT) == (lint_name != None), "only lint rows carry a stable selector name: {line}")
    if lint_name == .Val(name) { assert(is_snake_case_lint_name(name), "lint selector name must be stable snake_case: {line}") }
    moment :: if fields[4] == {
        "compile" | "compile/entry" -> DiagnosticMoment.Compile
        "run" -> DiagnosticMoment.Run "test" -> DiagnosticMoment.Test "tool" -> DiagnosticMoment.Tool
        else -> diagnostic_ice(None, "unknown diagnostic moment `{fields[4]}` in {line}")
    }
    status :: if fields[5] == {
        "active" -> DiagnosticRegistryStatus.Active "retired" -> DiagnosticRegistryStatus.Retired "reserved" -> DiagnosticRegistryStatus.Reserved
        else -> diagnostic_ice(None, "unknown diagnostic status `{fields[5]}` in {line}")
    }
    meaning :: unescape_source(fields[6])
    what :: unescape_source(fields[7])
    why :: unescape_source(fields[8])
    fix :: unescape_source(fields[9])
    detail :: if fields[10] == { "true" -> true "false" -> false else -> diagnostic_ice(None, "unknown diagnostic detail flag `{fields[10]}` in {line}") }
    structured_fix := None
    fix_safety := None
    no_fix_reason := None
    if fields[11] != "-" {
        marker :: unescape_source(fields[11])
        if no_fix_reason_from_source(marker, line) == .Val(reason) {
            no_fix_reason = Val(reason)
            if marker.starts_with("crypto_misuse|reason:") { structured_fix = Val(structured_fix_from_source(marker, line)) }
        } else {
            structured_fix = Val(structured_fix_from_source(marker, line))
            fix_safety = fix_safety_from_source(marker, line)
        }
    }
    DiagnosticRegistryRow{code: code, lint_name: lint_name, stage: stage, severity: severity,
        moment: moment, status: status, meaning: meaning, what: what, why: why, fix: fix,
        template_holes: template_holes([String]{what, why, fix}), detail: detail,
        structured_fix: structured_fix, fix_safety: fix_safety, no_fix_reason: no_fix_reason}
}
// Rust: crates/jet-foundation/src/Registry.rs:2889
fn no_fix_reason_from_source(value: String, line: String) -> NoFixReason? Never! {
    payload := value.strip_prefix("reason:") // #4303
    if payload == None {
        if value.split_once("|reason:") == .Val((_, found)) { payload = Val(found) }
    }
    text :: payload ?? return None
    (kind, next) :: text.split_once("|") ?? diagnostic_ice(None, "no-fix reason needs `reason:<kind>|<next action>` in {line}")
    trimmed := next.trim() // #4303
    assert(!trimmed.is_empty(), "no-fix reason needs a reviewed next action in {line}")
    parsed :: if NoFixReasonKind.parse(kind) == { .Ok(value) -> value .Err(error) -> diagnostic_ice(None, "{error} in {line}") }
    Val(NoFixReason{kind: parsed, next: next.to_string()})
}
// Rust: crates/jet-foundation/src/Registry.rs:2914
fn structured_fix_from_source(value: String, line: String) -> DiagnosticRegistryFix Never! {
    marker := if value.split_once("|") == { .Val((first, _)) -> first else -> value } // #4303
    if marker == "crypto_misuse" -> return .CryptoMisuse
    if marker == "source_edit" -> return .SourceEdit
    if marker == "suggested_source_edit" -> return .SuggestedSourceEdit
    if marker.strip_prefix("remove:") == .Val(text) {
        assert(!text.is_empty(), "empty structured remove fix in {line}")
        return .Remove(text.to_string())
    }
    if marker.strip_prefix("replace:") == .Val(replacement) {
        (from, to) :: replacement.split_once("=>") ?? diagnostic_ice(None, "structured replace fix needs `=>` in {line}")
        assert(!from.is_empty() && !to.is_empty(), "structured replace fix needs non-empty sides in {line}")
        return .Replace(from.to_string(), to.to_string())
    }
    if marker.strip_prefix("generated:") == .Val(kind) {
        return if kind == {
            "marker_group" -> .GeneratedMarkerGroup "missing_arms" -> .GeneratedMissingArms
            "script_run" -> .GeneratedScriptRun "call_value" -> .GeneratedCallValue "redundant_tail_return" -> .GeneratedRedundantTailReturn
            else -> diagnostic_ice(None, "unknown generated structured fix `{kind}` in {line}")
        }
    }
    diagnostic_ice(None, "unknown structured diagnostic fix `{marker}` in {line}")
}
// Rust: crates/jet-foundation/src/Registry.rs:2958
fn fix_safety_from_source(value: String, line: String) -> FixSafety? Never! {
    marker := if value.split_once("|") == { .Val((first, _)) -> first else -> value } // #4303
    if marker == "crypto_misuse" -> return None
    (_, safety) :: value.rsplit_once("|") ?? diagnostic_ice(None, "structured fix `{value}` has no safety grade in {line}")
    Val(if safety == {
        "formatting" -> FixSafety.Formatting "behavior-preserving" -> FixSafety.BehaviorPreserving
        "api-changing" -> FixSafety.APIChanging "target-changing" -> FixSafety.TargetChanging "needs-review" -> FixSafety.NeedsReview
        else -> diagnostic_ice(None, "unknown fix safety `{safety}` in {line}")
    })
}
// Rust: crates/jet-foundation/src/Registry.rs:2982
fn strip_code_span_fence(value: String) -> String Never! from value {
    if value.strip_prefix("`` ") == .Val(rest) {
        if rest.strip_suffix(" ``") == .Val(inner) -> return inner
    }
    value
}
// Rust: crates/jet-foundation/src/Registry.rs:2989
fn unescape_source(value: String) -> String Never! {
    stripped := strip_code_span_fence(value) // #4303
    out := String.with_capacity(stripped.len())
    escaped := false
    loop ch in stripped.chars() {
        if escaped {
            out.push(if ch == { 'n' -> '\n' 'r' -> '\r' 't' -> '\t' else -> ch })
            escaped = false
        } else if ch == '\\' { escaped = true }
        else { out.push(ch) }
    }
    if escaped { out.push('\\') }
    out
}
// Rust: crates/jet-foundation/src/Registry.rs:3014
fn template_holes(templates: [String]) -> [String] Never! {
    holes := [String]{}
    seen := [String:Bool]{}
    loop template in templates {
        start := 0
        loop start < template.len() {
            tail := template.slice(start..<template.len()) // #4303
            open :: start + (tail.find("{") ?? break)
            suffix := template.slice(open + 1..<template.len()) // #4303
            close :: open + 1 + (suffix.find("}") ?? break)
            hole := template.slice(open + 1..<close) // #4303
            if !hole.is_empty() && hole.bytes().iter().all(fn(byte) { byte.is_ascii_alphanumeric() || byte == 95 }) && !seen.contains_key(hole) {
                seen[hole.to_string()] = true
                holes.push(hole.to_string())
            }
            start = close + 1
        }
    }
    holes
}
