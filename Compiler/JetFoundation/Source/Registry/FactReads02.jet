}
// Rust: crates/jet-foundation/src/Registry.rs:3052
fn fact_declaration(line: String) -> FactDeclaration Never! {
    rest := line.slice(5..<line.len()).trim() // #4303
    open :: rest.find("(") ?? diagnostic_ice(None, "fact declaration without a parameter list: {line}")
