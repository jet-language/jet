// Rust: crates/jet-foundation/src/Registry.rs:3515
pub fn law_violations() -> [String] Never! {
    violations := check(rows())
    index := [String:[@RegistryRow]]{}
    loop candidate in rows() {
        group := index.remove(candidate.name) ?? [@RegistryRow]{}
        group.push(@candidate)
        index[candidate.name] = ^group
    }
    loop declaration in fact_declarations() {
        name :: declaration.name
        matches :: index.get(name) ?? [@RegistryRow]{}
        if matches.len() != 1 {
            violations.push("fact `{name}` has {matches.len()} registry rows; one fact needs one row")
            continue
        }
        candidate :: matches[0]
        if candidate.target != declaration.target {
            violations.push("fact `{name}` target drifted from `{declaration.target.kind().name()}` to `{candidate.kind().name()}`")
        }
        if candidate.identity_bearing != declaration.identity_bearing {
            violations.push("type plane `{name}` identity policy drifted from the one table")
        }
    }
    members :: fact_read_members()
    readable := [FactRead:Bool]{} // GATE #4499 enum/composite equality and hashing.
    loop member in members { if fact_read(member) == .Val(read) { readable[read] = true } }
    loop plane in fact_rows() {
        if plane.kind() != RowKind.Plane -> continue
        if registered_fact_read(plane.name) == {
            .None -> violations.push("plane `{plane.name}` has no FactRead projection")
            .Val(read) -> {
                if !read.registered_planes().any(fn(candidate) { candidate.name == plane.name }) {
                    violations.push("plane `{plane.name}` resolves to the wrong FactRead row")
                }
                if fact_read_reflection_kind(read) != reflection_kind(plane.name) {
                    violations.push("plane `{plane.name}` FactRead kind drifted from its registry row")
                }
                if !readable.contains_key(read) { violations.push("plane `{plane.name}` has no source member-position FactRead") }
            }
        }
    }
    violations
}
// Rust: crates/jet-foundation/src/Registry.rs:3575
fn check(table: View<RegistryRow>) -> [String] Never! {
    violations := [String]{}
    seen := [String:Bool]{}
    spelled := [String:Bool]{}
    loop declaration in fact_declarations() { loop gate in declaration.gates { spelled[gate] = true } }
    loop candidate in table { if candidate.rule != None { spelled[candidate.name] = true } }
    loop candidate in table {
        name :: candidate.name
        if seen.contains_key(name) { violations.push("`{name}` is registered twice; one table means one row per name") }
        else { seen[name] = true }
        if candidate.safe_direction == SafeDirection.None && !candidate.gates.is_empty() {
            violations.push("`{name}` ({candidate.kind().name()}) names a gate word but states no safe direction; a gate loosens a direction, so say which way tightens")
        }
        if name.starts_with("Structure.") && (candidate.safe_direction == SafeDirection.None || candidate.gates.is_empty()) {
            violations.push("structure row `{name}` must state both a safe direction and a gate")
        }
        loop gate in candidate.gates {
            if !spelled.contains_key(gate) { violations.push("`{name}` names the gate word `{gate}`, which nothing spells; a gate is a registered marker or a Prelude gate") }
        }
        if candidate.is_prover_supplied() && candidate.safe_direction != SafeDirection.None {
            violations.push("`{name}` is published by a prover, so it carries no plane algebra and must state safe direction `none` (D-FACT-OWN1=A)")
        }
        is_code :: if candidate.target == { .Code(_) -> true else -> false }
        if is_code != (candidate.rule != None) { violations.push("`{name}` attaches to written code exactly when it carries a marker signature") }
        if (candidate.kind() == RowKind.Diagnostic) != (candidate.diagnostic != None) {
            violations.push("`{name}` is a diagnostic row exactly when it carries a typed diagnostic payload")
        }
        violations.extend(truth_violations(candidate))
    }
    violations
}
// Rust: crates/jet-foundation/src/Registry.rs:3645
fn truth_violations(candidate: RegistryRow) -> [String] Never! {
    violations := [String]{}
    name :: candidate.name
    if candidate.kind() == RowKind.Truth {
        if candidate.guard == None { violations.push("`{name}` is a registered truth with no guard; a truth that nothing proves has one home only until someone writes the second copy") }
        if candidate.home == None { violations.push("`{name}` is a registered truth that names no home; say which file owns it") }
        if candidate.renderers.is_empty() { violations.push("`{name}` is a registered truth that names no renderer; a truth nothing reads is dead code, not a truth") }
        if candidate.safe_direction != SafeDirection.None { violations.push("`{name}` is a corpus truth, so it holds no fact that moves and states safe direction `none`") }
    } else if candidate.home != None || !candidate.renderers.is_empty() || candidate.guard != None {
        violations.push("`{name}` ({candidate.kind().name()}) fills a home, renderer, or guard column; those belong to a corpus truth (D-ONCE-LAW1=A)")
    }
    violations
}
