//RS     Shrink,
//RS     /// Finishing the job is free. Duty: a bound handle owes `join`.
//RS     Discharge,
//RS     /// This row holds no fact that moves, so it states no direction. A rule on
//RS     /// written code is the ordinary case; so is a read-only prover row.
//RS     None,
//RS }
