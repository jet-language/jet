    loop handle in handles -> handle.jet_name.copy() // copy: the global handle tables can't be moved from
}

IR_RUNTIME_HANDLE_KEY_ROWS: #run ir_key_index(ir_runtime_handle_keys(IR_RUNTIME_HANDLES))
IR_RUNTIME_HANDLE_KEYS: #run ir_key_index_keys(ir_runtime_handle_keys(IR_RUNTIME_HANDLES), IR_RUNTIME_HANDLE_KEY_ROWS)

// The row of IR_RUNTIME_HANDLES that `name` keys, if any.
ir_runtime_handle_row: fn(name: String) -> Int? Never! {
    ir_key_row(IR_RUNTIME_HANDLE_KEYS, IR_RUNTIME_HANDLE_KEY_ROWS, name)
}

// The IR type of `MarkerArgInfo.value`, a written marker argument's value: a
// host word in compile-time code (JetIR ir_compiler_owned_core_fields), which
// `info.marker(T)` reads its `T` from. No program can name it.
IR_MARKER_ARG_VALUE: "MarkerArgValue"

// The type of a Prelude marker's record (Compiler/Prelude/Markers.jet), which
// `info.marker(T)` returns for a `T` the program does not declare: a host word
// in compile-time code, whose fields the evaluator answers. No program can
// name it.
IR_PRELUDE_MARKER_RECORD: "PreludeMarkerRecord"

// A compiler value with no declaration that build and comptime code hold
// (the build context and its handles, `Dev`, the ProgramInfo snapshot and
// its reflection records, the `core.compiler` query results and their
// records): a word naming the value in the evaluator's host table, whose
// methods and fields the evaluator answers (JetIR ir_host_method). The IR lays
// it out as that word and the checker copies it as that word.
ir_host_value_name: fn(name: String) -> Bool Never! {
    if name == {
        "Build" | "BuildPlan" | "BuildTarget" | "BuildAction" | "BuildToolchain" | "BuildProbe" | "BuildSigningIdentity" | "BuildFile" | "BuildError" | "Code" | "Compiler" | "Dev" | "SourceSpan" -> true
        "ProgramInfo" | "TypeInfo" | "FunctionInfo" | "PackageInfo" | "ModuleInfo" | "SettingInfo" | "ContributionInfo" | "CommentInfo" | "ForeignInfo" | "ForeignEvidence" | "CompilerDefinition" | "CompilerReference" | "CompilerCall" | "CompilerField" | "CompilerStructuralNode" -> true
        "CompilerSymbolKind" | "CompilerParam" | "CompilerDefinitionAnchor" | "CompilerViewProvenance" | "CompilerViewSourcePath" | "CompilerViewSource" | "CompilerViewProjection" -> true
        "LayoutInfo" | "FieldInfo" | "DefaultInfo" | "ParamInfo" | "MethodInfo" | "CallableSignature" | "ClosureInfo" | "CaptureInfo" | "TypeParamInfo" | "MarkerInfo" | "StateInfo" | "TransitionInfo" | "FactInfo" | "DimensionInfo" | "DimensionAxis" | "EffectInfo" | "ArithmeticOperationInfo" -> true
        "TraitInfo" | "AssociatedTypeInfo" | "ConstantInfo" | "GenericBindingInfo" | "NumericInfo" | "TypeId" | "PreparedCase" | "PreparedStruct" | "PreparedField" -> true
        "CompilerError" | "CompilerDiagnostic" | "CompilerLexed" | "CompilerToken" | "CompilerSyntaxTree" | "CompilerNode" | "CompilerChecked" | "CompilerSemanticIndex" | "CompilerSourceMap" | "CompilerGeneratedLine" -> true
        "CompilerManifest" | "CompilerPackage" | "CompilerPackageError" | "CompilerDependency" | "CompilerPackageTarget" | "CompilerPackageOutput" | "CompilerBuildProfile" -> true
        "CompilerLock" | "CompilerLockedPackage" | "CompilerProfileSet" | "CompilerProfile" | "CompilerKeyValue" -> true
        "MarkerArgValue" | "PreludeMarkerRecord" -> true
        else -> false
    }
}
