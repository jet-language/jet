ir_runtime_handle_keys: fn(handles: [IRRuntimeHandle]) -> [String] Never! {
    loop handle in handles -> handle.jet_name.copy()  // copy: the global handle tables can't be moved from
}

IR_RUNTIME_HANDLE_KEY_ROWS: #run ir_key_index(ir_runtime_handle_keys(IR_RUNTIME_HANDLES))

IR_RUNTIME_HANDLE_KEYS: #run ir_key_index_keys(ir_runtime_handle_keys(IR_RUNTIME_HANDLES), IR_RUNTIME_HANDLE_KEY_ROWS)

// The row of IR_RUNTIME_HANDLES that `name` keys, if any.
ir_runtime_handle_row: fn(name: String) -> Int? Never! {
    ir_key_row(IR_RUNTIME_HANDLE_KEYS, IR_RUNTIME_HANDLE_KEY_ROWS, name)
}

// Opaque native providers: physical ownership ABI only. A Core-declared shape
// here crosses a route as a heap shell of its declared bytes (IR
// ir_route_shell): `KeyRef<T>` from jet_vault_current_impl. The IR consults
// these rows after IR_RUNTIME_HANDLES (ir_runtime_handle), and a jet.runtime
// binding may carry them as handles.
IR_NATIVE_PROVIDER_HANDLES: #run { [IRRuntimeHandle]{
    IRRuntimeHandle{jet_name: "<corelib>/core.crypto.vault.KeyRef", runtime: "JetVaultKeyRef", clone: false, display: false, show: false, debug: false, eq: false},
    IRRuntimeHandle{jet_name: "<corelib>/core.process.ProcessStdoutStream", runtime: "ProcessStdoutStream", clone: true, display: false, show: false, debug: false, eq: false},
    IRRuntimeHandle{jet_name: "ProcessStdoutStream", runtime: "ProcessStdoutStream", clone: true, display: false, show: false, debug: false, eq: false},
    IRRuntimeHandle{jet_name: "<corelib>/core.process.ProcessStdin", runtime: "ProcessStdin", clone: true, display: false, show: false, debug: false, eq: false},
    IRRuntimeHandle{jet_name: "ProcessStdin", runtime: "ProcessStdin", clone: true, display: false, show: false, debug: false, eq: false},
    IRRuntimeHandle{jet_name: "<corelib>/core.process.ProcessStderrStream", runtime: "ProcessStderrStream", clone: true, display: false, show: false, debug: false, eq: false},
    IRRuntimeHandle{jet_name: "ProcessStderrStream", runtime: "ProcessStderrStream", clone: true, display: false, show: false, debug: false, eq: false},
} }

IR_NATIVE_PROVIDER_HANDLE_KEY_ROWS: #run ir_key_index(ir_runtime_handle_keys(IR_NATIVE_PROVIDER_HANDLES))

IR_NATIVE_PROVIDER_HANDLE_KEYS: #run ir_key_index_keys(ir_runtime_handle_keys(IR_NATIVE_PROVIDER_HANDLES), IR_NATIVE_PROVIDER_HANDLE_KEY_ROWS)

// The row of IR_NATIVE_PROVIDER_HANDLES that `name` keys, if any.
ir_native_provider_handle_row: fn(name: String) -> Int? Never! {
    ir_key_row(IR_NATIVE_PROVIDER_HANDLE_KEYS, IR_NATIVE_PROVIDER_HANDLE_KEY_ROWS, name)
}

// The generic Core families a runtime export answers as one handle word,
// whatever their element: a jet.runtime binding result `Receiver<T>` crosses
// as the runtime's channel receiver, `Event<T>` as its event bus.
RUNTIME_GENERIC_HANDLES: #run { [String]{"Event", "Receiver"} }

// The IR type of `MarkerArgInfo.value`, a written marker argument's value: a
// host word in compile-time code (JetIR ir_compiler_owned_core_fields), which
// `info.marker(T)` reads its `T` from. No program can name it.
IR_MARKER_ARG_VALUE: "MarkerArgValue"

// The type of a Prelude marker's record (Compiler/Prelude/Markers.jet), which
// `info.marker(T)` returns for a `T` the program does not declare: a host word
// in compile-time code, whose fields the evaluator answers. No program can
// name it.
IR_PRELUDE_MARKER_RECORD: "PreludeMarkerRecord"

// A compiler value with no declaration that build and comptime code hold
// (a build's `Compiler` value, `BuildError`, `Dev`, the ProgramInfo snapshot and
// its reflection records, the `core.compiler` query results and their
// records): a word naming the value in the evaluator's host table, whose
// methods and fields the evaluator answers (JetIR ir_host_method). The IR lays
// it out as that word and the checker copies it as that word.
ir_host_value_name: fn(name: String) -> Bool Never! {
    if name == {
        "BuildError" | "Code" | "Compiler" | "Dev" -> true
        "ProgramInfo" | "TypeInfo" | "FunctionInfo" | "PackageInfo" | "ModuleInfo" | "SettingInfo" | "ContributionInfo" | "CommentInfo" | "ForeignInfo" | "ForeignEvidence" | "CompilerDefinition" | "CompilerReference" | "CompilerField" | "CompilerStructuralNode" -> true
        "CompilerSymbolKind" | "CompilerParam" | "CompilerDefinitionAnchor" | "CompilerViewProvenance" | "CompilerViewSourcePath" | "CompilerViewSource" | "CompilerViewProjection" -> true
        "CompilerEffect" | "CompilerEffectProvenance" | "CompilerArithmeticOperation" | "CompilerOutput" | "CompilerOutputEntry" -> true
        "CompilerStateGraph" | "CompilerStateNode" | "CompilerStateTransition" | "CompilerFactDeclaration" -> true
        "CompilerDerivationRecord" | "CompilerDerivationIdentity" | "CompilerDerivationObservation" | "CompilerDerivationPayload" -> true
        "LayoutInfo" | "FieldInfo" | "CaseInfo" | "DefaultInfo" | "ParamInfo" | "MethodInfo" | "CallableSignature" | "ClosureInfo" | "CaptureInfo" | "TypeParamInfo" | "MarkerInfo" | "StateInfo" | "TransitionInfo" | "FactInfo" | "DimensionInfo" | "DimensionAxis" | "EffectInfo" | "ArithmeticOperationInfo" -> true
        "TraitInfo" | "AssociatedTypeInfo" | "ConstantInfo" | "GenericBindingInfo" | "PreparedCase" | "PreparedStruct" | "PreparedField" -> true
        "CompilerError" | "CompilerDiagnostic" | "CompilerDiagnosticOrigin" | "CompilerFixEdit" | "CompilerLexed" | "CompilerToken" | "CompilerSyntaxTree" | "CompilerNode" | "CompilerChecked" | "CompilerSemanticIndex" | "CompilerSourceMap" | "CompilerGeneratedLine" -> true
        "CompilerManifest" | "CompilerPackage" | "CompilerPackageError" | "CompilerDependency" | "CompilerPackageTarget" | "CompilerPackageOutput" | "CompilerBuildProfile" -> true
        "CompilerLock" | "CompilerLockedPackage" | "CompilerProfileSet" | "CompilerProfile" | "CompilerKeyValue" -> true
        "MarkerArgValue" | "PreludeMarkerRecord" -> true
        else -> false
    }
}

// The compiler value (ir_host_value_name) type `name` spells, if any: the
// bare name, or the key of its `core.compiler` declaration, whose leaf names
// it. Core declares such a record so its fields are written once; the
// evaluator still answers it as a host word. A bare name is its own leaf.
ir_host_value_leaf: fn(name: String) -> String? Never! {
    if !ir_host_value_name(name) && !core_identity_in_module(name, "core.compiler") -> return None
    leaf: symbol_key_leaf(name)
    if ir_host_value_name(leaf) -> return Val(leaf)
    None
}
