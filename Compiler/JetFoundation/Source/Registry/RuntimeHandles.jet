// Runtime handle registrations, read by both compiler halves: the IR lays a
// handle value out by its row (drop, clone, display and eq routines), and the
// checker reads the same row's `clone` and `eq`, so a handle without a clone
// has one owner and a handle without eq has no `==` (#6581). Authored source:
// keep the table sorted by hand.

// Each row table here and in the IR's RuntimeRoutes.jet is read in place, and
// its lookup is keyed: the table's distinct keys in ascending byte order with
// each key's first row, frozen at build time, searched by halving instead of
// a scan of every row.
ir_key_row: fn(keys: [String], rows: [Int], key: String) -> Int? Never! {
    ^low: I64{0}
    ^high: I64{keys.len()}
    loop low < high {
        middle: (low + high) >> I64{1}
        mid: Int{middle}
        order: keys[mid] <=> key
        if order == {
            .Equal -> return Val(rows[mid])
            .Less -> low = wrapping(middle + I64{1})
            .Greater -> high = middle
        }
    }
    None
}

// The rows of `keys` ordered by key (ascending bytes; stable merge sort,
// preserving duplicate keys in table order).
ir_key_order: fn(keys: [String]) -> [Int] Never! {
    ^order: [Int]{}
    loop index in 0..<keys.len() -> order.push(index)
    ^width: 1
    loop width < order.len() {
        ^merged: [Int]{}
        ^start: 0
        loop start < order.len() {
            middle: if start + width < order.len() -> start + width else -> order.len()
            end: if start + 2 * width < order.len() -> start + 2 * width else -> order.len()
            ^left: start
            ^right: middle
            loop left < middle || right < end {
                if {
                    right >= end || (left < middle && !(keys[order[right]] < keys[order[left]])) -> {
                        merged.push(order[left])
                        left += 1
                    }
                    else -> {
                        merged.push(order[right])
                        right += 1
                    }
                }
            }
            start = end
        }
        order = merged
        width *= 2
    }
    order
}

// First position in sorted `keys` equal to `key`, or -1 when absent.
ir_key_first_at: fn(keys: [String], key: String) -> Int Never! {
    ^low: I64{0}
    ^high: I64{keys.len()}
    loop low < high {
        middle: (low + high) >> I64{1}
        if keys[Int{middle}] < key -> low = wrapping(middle + I64{1}) else -> high = middle
    }
    at: Int{low}
    if at < keys.len() && keys[at] == key -> at else -> -1
}

// The rows of the index ir_key_row searches, computed at build time from a
// table's per-row `keys`: the rows ordered by key (ascending bytes; a stable
// merge sort, so equal keys keep table order), keeping each key's first row.
ir_key_index: fn(keys: [String]) -> [Int] Never! {
    order: ir_key_order(keys)
    ^rows: [Int]{}
    loop row in order {
        if rows.len() > 0 && keys[rows[rows.len() - 1]] == keys[row] -> next
        rows.push(row)
    }
    rows
}

// The keys of an ir_key_index, in its order.
ir_key_index_keys: fn(keys: [String], rows: [Int]) -> [String] Never! {
    loop row in rows -> keys[row].copy()  // copy: the index owns its keys; `keys` stays the caller's
}

// The runtime handle type a Jet type crosses the boundary as, keyed by the Jet
// name the checker spells it with: a table name (`LocalDate`), or a
// declaration's key (`<corelib>/core.net.TCPStream`) whose own Jet shape the
// handle replaces. A declaration, Core's or a package's alike, is carried only
// through a row under its own key. It is dropped by
// `jet_rt_handle_drop_<runtime>`; copied by `jet_rt_handle_clone_<runtime>`
// when `clone`; rendered by `jet_rt_handle_display_<runtime>` /
// `jet_rt_handle_show_<runtime>` / `jet_rt_handle_debug_<runtime>` when
// `display` / `show` / `debug`; compared by `jet_rt_handle_eq_<runtime>` when
// `eq`.
IRRuntimeHandle: struct {
    jet_name: String,
    runtime: String,
    clone: Bool,
    display: Bool,
    show: Bool,
    debug: Bool,
    eq: Bool,
}

