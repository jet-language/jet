// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:1936
fn string_bytes_receiver_is_owned(receiver: TExpr, cx: Cx) -> Bool Never! {
    if receiver.ty != .String -> return false
    if receiver.kind == {
        .StrLit(_) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) -> true
        .Call(name: name, ..) -> {
            callable :: cx.fn_types.get(name) ?? return false
            if callable == { .Fn(return_view_provenance: provenance, ..) -> !provenance.is_some_and(views -> !views.is_empty()), else -> false }
        }
        .BuiltinMethod(op: op, ..) -> op != .TrimView && op != .AfterView && op != .BeforeView
        else -> false
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:1965
fn builtin_arg_takes_ownership(op: TBuiltinOp, index: Int) -> Bool Never! {
    if op == {
        .Push | .TryPush | .TryStringPush | .Intersperse | .SetInsert | .SortedSetInsert | .BagAdd | .DequePushFront | .DequePushBack -> index == 0
        .InsertMap | .TryInsertMap | .AddNewMap | .MapSetDefault | .InsertList -> index == 1
        .LruPut | .LruAddNew -> index < 2
        else -> false
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:1985
fn builtin_arg_is_place(expr: Expr) -> Bool Never! {
    if expr.without_parens() == { .Ident(_, _) | .Field(_, _, _) | .Index(..) -> true, else -> false }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:1992
fn lower_builtin_arg(arg: CallArg, expected: Type?, owns_value: Bool, cx: Cx, env: &LowerEnv) -> TExpr Never! {
    value := if owns_value -> lower_owned_expr(arg.expr, cx, &env) else -> lower_expr(arg.expr, cx, &env)
    if expected == .Val(want) {
        is_list :: if want == { .List(_) | .FixedList(..) -> true, else -> false }
        if is_list && free_type_params(want).is_empty() -> value = preserve_typed_list_shape(^value, want, cx)
        if value.kind == .Absent && free_type_params(want).is_empty() {
            if want == { .Option(_) -> value.ty = ~want, else -> {} }
        }
    }
    resource_take :: if value.kind == { .ResourceTake(_) -> true, else -> false }
    already_owned :: if value.kind == { .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .ResourceTake(_) -> true, else -> false }
    if owns_value && !resource_take && !already_owned && (arg.flags.implicit_clone || builtin_arg_is_place(arg.expr)) && !value.ty.is_scalar() {
        ty :: ~value.ty
        env.note_clone(ty)
        value = TExpr{ty: ^ty, kind: TExprKind.Clone(^value, MirCopyFact.Materialize)}
    }
    ^value
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2050
fn core_widen_to_vec(module: String, method: String, args: [TExpr]) -> [Bool] Never! {
    if module == "core.term" && method == "progress" && args.first().is_some_and(arg -> if arg.ty == { .FixedList(..) -> true, else -> false }) {
        return (0..args.len()).map(index -> index == 0).to_list()
    }
    params :: core_fixed_sig(module, method).map((params, _) -> params) ?? []
    args.enumerate().map((index, arg) -> {
        want :: params.get(index) ?? return false
        if (arg.ty, want.1) == { (.FixedList(elem: actual, ..), .List(want)) -> fixed_list_elem_compatible(actual, want), else -> false }
    }).to_list()
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2076
fn normalize_http_cors_policy_args(args: &[TExpr]) -> Unit Never! {
    if args.is_empty() -> return
    list_ty :: Type.List(Type.String)
    empty_list :: fn() { TExpr{ty: ~list_ty, kind: TExprKind.ListLit([])} }
    origins :: ~args[0]
    (origins_mode, origins_value) :: if origins.kind == {
        .EnumLit(variant: variant, payload: .Unit, ..) if variant == "Any" -> (TExpr{ty: .Int, kind: .IntLit(0, None)}, empty_list())
        .EnumLit(variant: variant, payload: .Positional(values), ..) if variant == "List" && values.len() == 1 -> (TExpr{ty: .Int, kind: .IntLit(1, None)}, ~values[0].value)
        else -> (TExpr{ty: .Int, kind: .IntLit(1, None)}, ^origins)
    }
    methods :: args.get(1).map(value -> ~value) ?? empty_list()
    headers :: args.get(2).map(value -> ~value) ?? empty_list()
    credentials :: args.get(3).map(value -> ~value) ?? TExpr{ty: .Bool, kind: .BoolLit(false)}
    max_age :: args.get(4).map(value -> ~value) ?? TExpr{ty: .Int, kind: .IntLit(86400, None)}
    args = [^origins_mode, ^origins_value, ^methods, ^headers, ^credentials, TExpr{ty: .Int, kind: .IntLit(1, None)}, ^max_age]
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2140
fn normalize_http_static_files_args(args: &[TExpr]) -> Unit Never! {
    loop while args.len() < 6 -> args.push(TExpr{ty: Type.Option(Type.Bool), kind: .Absent})
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2149
fn vault_instance_helper(kind: String, method: String) -> String? Never! {
    if (kind, method) == { ("WrappedVaultKey", "bytes") -> Val("__vault_wrapped_bytes"), else -> None }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2156
fn lower_data_schema_call(receiver: Expr, method: String, method_span: Span, args: [CallArg], resolved_ret: Type?, cx: Cx, env: &LowerEnv) -> TExpr? Never! {
    ret :: resolved_ret ?? return None
    column :: if ret == { .List(column) -> column, else -> return None }
    if column.base_name() != Val("DataColumn") -> return None
    target :: core_module_path_from_receiver(receiver, cx, env).map(module -> (module, ~method)).or_else(fn() {
        if receiver == {
            .Ident(alias, _) if !env.locals.contains_key(alias) -> cx.inline_reexport_core.get((alias, method)).map(row -> ~row)
            else -> None
        }
    }) ?? return None
    if target.0 != "core.data" || target.1 != "schema" -> return None
    if args.len() != 1 -> return Val(invariant_method_expr(method_span, "data.schema without one checked list argument"))
    input := lower_expr(args[0].expr, cx, &env)
    elem :: if input.ty == { .List(elem) | .FixedList(elem: elem, ..) -> elem, else -> return Val(invariant_method_expr(method_span, "data.schema without a checked row type")) }
    row :: fn(name: String) {
        fields :: cx.struct_fields.get(name) ?? return None
        Val((cx.struct_type_param_order.get(name).map(order -> ~order) ?? [], ~fields))
    }
    columns :: schema_columns_for_type(elem, true, row) ?? return Val(invariant_method_expr(method_span, "data.schema without resolved row type arguments"))
    // Retain effects without copying a stored list to inspect checked type metadata.
    is_place :: if input.kind == { .Local(_) | .Field(..) | .Index(..) -> true, else -> false }
    if is_place -> input = TExpr{ty: ~input.ty, kind: TExprKind.Borrow(place: ^input, mutable: false)}
    ty :: Type.List(~column)
    Val(TExpr{ty: ~ty, kind: TExprKind.InlineBlock([TStmt.ExprStmt(^input), TStmt.ExprStmt(TExpr{ty: ^ty, kind: TExprKind.CtLit(CtValue.List(^columns))})])})
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2246
fn lower_vault_instance_fast(receiver: Expr, method: String, method_span: Span, recv_type: String?, resolved_ret: Type?, lowered_receiver: &TExpr?, cx: Cx, env: &LowerEnv) -> TExpr? Never! {
    if static_call_type_name_lower(receiver, env) != None -> return None
    if receiver == { .Ident(name, _) if env.is_gc(name) -> return None, else -> {} }
    recv_name :: recv_type ?? return None
    kind :: recv_name.rsplit(".").next() ?? return None
    helper :: vault_instance_helper(kind, method) ?? return None
    recv :: lowered_receiver.take() ?? lower_expr(receiver, cx, &env)
    args :: [^recv]
    widen_to_vec :: core_widen_to_vec("core.crypto", helper, args)
    ty :: resolved_ret ?? return Val(invariant_method_expr(method_span, "crypto instance call without a resolved return type"))
    record :: if checked_core_record("core.crypto", helper, args.len(), method_span) == { .Ok(record) -> record, .Err(expr) -> return Val(expr) }
    Val(TExpr{ty: ~ty, kind: TExprKind.CoreCall(record: record, args: ^args, source_span: method_span, type_args: [], widen_to_vec: ^widen_to_vec, data_plan: None, fallibility: TFailureCarrier.from_checked_type(ty))})
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2319
fn canonical_codec_owner(ty: Type, cx: Cx) -> Type Never! {
    name :: if ty == { .Named(name) -> name, else -> return ~ty }
    if cx.local_type_identities.get(name) == .Val(identity) -> return Type.Named(~identity)
    if !name.contains(".") -> return ~ty
    if cx.imported_type_metadata_name(name) == {
        .Val(identity) if identity != name -> Type.Named(^identity)
        else -> ~ty
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2341
fn canonical_method_target_owner(cx: Cx, name: String) -> String Never! {
    if cx.jit_local_call_prefix == None {
        if cx.local_type_names.contains(name) -> return ~name
        // Preserve BTreeMap first-match order.
        leaves :: cx.local_type_identities.keys().sorted()
        loop leaf in leaves {
            if cx.local_type_identities[leaf] == name && cx.local_type_names.contains(leaf) -> return ~leaf
        }
    }
    canonical_enum_owner(cx, name)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2355
fn canonicalize_method_receiver_type(ty: &Type, owner: String) -> Unit Never! {
    if ty == {
        .Named(name) | .Apply(name: name, ..) -> name = ~owner
        .Tagged(inner: inner, ..) -> canonicalize_method_receiver_type(&inner, owner)
        else -> {}
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2366
pub fn builtin_codec_name(ty: Type) -> String? Never! {
    if ty.without_user_tags() == {
        .Named(name) if name == "Date" || name == "LocalDate" || name == "LocalTime" || name == "DateTime" || name == "Duration" || name == "Decimal" -> Val(name)
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2380
fn generic_method_instance_leaf(owner: Type, method: String, type_args: [Type]) -> String Never! {
    key :: generic_method_instance_key(owner, method, type_args)
    pair :: key.rsplit_once("::") ?? panic("generic method key includes an owner separator")
    ~pair.1
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2388
fn lower_serde_encode_node(recv: ^TExpr, cx: Cx) -> TExpr Never! {
    recv.ty = canonical_codec_owner(recv.ty, cx)
    if recv.ty == {
        .Apply(..) -> cx.jit_method_calls.borrow_mut().insert(generic_method_instance_key(recv.ty, "encode", []), (~recv.ty, "encode", []))
        else -> {}
    }
    TExpr{ty: Type.Named(Syntax.TYPE_DATA), kind: TExprKind.HandleMethod(recv: ^recv, op: THandleOp.SerdeEncode, args: [])}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2406
fn lower_datatree_decode_node(recv: ^TExpr, target: Type, resolved_ret: Type?, method_span: Span, cx: Cx) -> TExpr Never! {
    owner :: canonical_codec_owner(target, cx)
    if owner == {
        .Apply(..) -> cx.jit_method_calls.borrow_mut().insert(generic_method_instance_key(owner, "decode", []), (~owner, "decode", []))
        else -> {}
    }
    // Generated Codable bodies precede sema resolved-ret writeback.
    ty :: resolved_ret.map(ty -> ~ty) ?? Type.Result(ok: ~owner, err: Type.Named(Syntax.TYPE_ENCODING_ERROR))
    TExpr{ty: ^ty, kind: TExprKind.HandleMethod(recv: ^recv, op: THandleOp.DataTreeDecode(^owner), args: [])}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2440
fn zip_family_mode(method: String) -> TZipMode Never! {
    if method == { "zip_short" -> .Short, "zip_pad" -> .Pad, else -> .Strict }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2448
fn zip_tuple_fields(ty: Type) -> [(String, Type)]? Never! {
    inner :: if ty == {
        .List(inner) -> inner
        .Apply(name: name, args: args) if name == Syntax.TYPE_ITER && args.len() == 1 -> args[0]
        else -> return None
    }
    if inner == { .Tuple(fields) -> Val(fields.map((name, ty) -> (~name, ~ty))), else -> None }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2465
fn zip_sequence_type(ty: Type) -> Bool Never! {
    if ty == {
        .Tagged(inner: inner, ..) -> zip_sequence_type(inner)
        .List(_) | .FixedList(..) -> true
        .Apply(name: name, args: args) if name == Syntax.TYPE_ITER && args.len() == 1 -> true
        else -> false
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2474
fn zip_field_name(index: Int, label: String?) -> String Never! {
    label.map(name -> ~name) ?? (["a", "b", "c", "d", "e", "f"].get(index).map(name -> ~name) ?? "column_{index}")
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2488
pub fn lower_zip_family(receiver: ^TExpr, inputs: ^[TExpr], fills: ^[TExpr], fields: ^[String], method: String, method_span: Span, resolved_ret: Type?) -> TExpr Never! {
    ret :: resolved_ret ?? return invariant_method_expr(method_span, "zip call without a resolved return type")
    input_count :: inputs.len() + 1
    if input_count == 1 {
        if is_iter_type(receiver.ty) -> return ^receiver
        return TExpr{ty: ~ret, kind: TExprKind.BuiltinMethod(recv: ^receiver, op: .ListLazy, args: [])}
    }
    tuple_fields :: zip_tuple_fields(ret) ?? return invariant_method_expr(method_span, "zip call without a checked tuple return shape")
    field_types :: tuple_fields.map((_, ty) -> ~ty)
    fill_mode :: if method != "zip_pad" -> TZipFillMode.DefaultNone else if fills.len() == 1 -> if fills[0].ty == { .Tuple(_) -> TZipFillMode.Columns, else -> TZipFillMode.Common } else -> TZipFillMode.DefaultNone
    inputs.extend(^fills)
    TExpr{ty: ~ret, kind: TExprKind.BuiltinMethod(recv: ^receiver, op: TBuiltinOp.Zip(tuple_struct: tuple_struct_name(tuple_fields), mode: zip_family_mode(method), fields: ^fields, flatten: false, input_count: input_count, fill_mode: fill_mode, field_types: ^field_types), args: ^inputs)}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2547
pub fn lower_empty_zip_family(resolved_ret: Type, method: String, method_span: Span) -> TExpr Never! {
    TExpr{ty: ~resolved_ret, kind: TExprKind.BuiltinMethod(recv: TExpr{ty: Type.List(unit_type()), kind: TExprKind.ListLit([])}, op: .ListLazy, args: [])}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2565
fn wrap_list_as_iter(receiver: ^TExpr) -> TExpr Never! {
    element :: if receiver.ty.without_user_tags() == { .List(element) | .FixedList(elem: element, ..) -> ~element, else -> return ^receiver }
    TExpr{ty: iter_ty(^element), kind: TExprKind.BuiltinMethod(recv: ^receiver, op: .ListLazy, args: [])}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2582
pub fn lower_method_call(receiver: Expr, method: String, method_span: Span, owner_type_args: [Type], type_args: [Type], args: [CallArg], recv_type: String?, operator_rhs: Type?, resolved_ret: Type?, checked_widen: Bool, cx: Cx, env: &LowerEnv, lowered_receiver: TExpr?) -> TExpr Never! {
    lower_method_call_with_sig(receiver, method, method_span, owner_type_args, type_args, args, recv_type, operator_rhs, resolved_ret, checked_widen, cx, &env, lowered_receiver, None)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2615
pub fn lower_method_call_with_sig(receiver: Expr, method: String, method_span: Span, owner_type_args: [Type], type_args: [Type], args: [CallArg], recv_type: String?, operator_rhs: Type?, resolved_ret: Type?, checked_widen: Bool, cx: Cx, env: &LowerEnv, lowered_receiver: TExpr?, instantiated_sig: [(AccessConvention, Type)]?) -> TExpr Never! {
    // Checked memo projection shares the canonical named store across tiers.
    if method == Syntax.METHOD_MEMO_CACHE && args.is_empty() && resolved_ret.is_some_and(ty -> if ty == { .Named(name) -> name == Syntax.TYPE_MEMO_STATS, else -> false }) {
        if receiver == { .Ident(name, _) -> return TExpr{ty: Type.Named(Syntax.TYPE_MEMO_STATS), kind: TExprKind.HostCall(THostCall.MemoStats(name: ~name))}, else -> {} }
    }
    if lower_data_schema_call(receiver, method, method_span, args, resolved_ret, cx, &env) == .Val(lowered) -> return ^lowered
    recv := lowered_receiver
    if lower_vault_instance_fast(receiver, method, method_span, recv_type, resolved_ret, &recv, cx, &env) == .Val(lowered) -> return ^lowered
    lower_method_call_impl(receiver, method, method_span, owner_type_args, type_args, args, recv_type, operator_rhs, resolved_ret, checked_widen, cx, &env, ^recv, instantiated_sig)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2684
fn inline_range_receiver(receiver: Expr) -> (I64, I64)? Never! {
    call :: if receiver == { .Call(call) -> call, else -> return None }
    ty :: call.resolved_ret ?? return None
    if ty == {
        .InlineRange(lo: lo, hi: hi, ..) -> Val((lo, hi))
        .Result(ok: ok, ..) -> if ok == { .InlineRange(lo: lo, hi: hi, ..) -> Val((lo, hi)), else -> None }
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2698
fn route_strip_parens(expr: Expr) -> &Expr Never! {
    current := &expr
    loop {
        if current == { .Paren(inner, _) -> current = &inner, else -> return current }
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2704
fn route_handler_param_names(handler_expr: Expr, cx: Cx) -> [String]? Never! {
    if route_strip_parens(handler_expr) == {
        .Lambda(lambda) -> Val(lambda.params.map(param -> ~param.name))
        .Ident(name, _) -> cx.fn_param_names.get(name).map(params -> params.map(name -> ~name))
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2721
fn route_static_string(expr: Expr, cx: Cx) -> String? Never! {
    if route_strip_parens(expr) == {
        .Str(parts, _) -> {
            value := ""
            loop part in parts {
                if part == { .Lit(text) -> value += text, else -> return None }
            }
            Val(^value)
        }
        .Ident(name, _) -> if cx.const_values.get(name) == { .Val(.Str(value)) -> Val(~value), else -> None }
        .ComptimeName(value: .Val(.Str(value)), ..) -> Val(~value)
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2745
fn route_schema_type(ty: Type, cx: Cx, active: &[String: Bool]) -> MirHttpSchema? Never! {
    if ty == {
        .Int | .IntN(..) -> Val(.Integer)
        .Float | .Float32 -> Val(.Number)
        .Bool -> Val(.Boolean)
        .String | .Char -> Val(.String)
        .List(item) | .FixedList(elem: item, ..) -> Val(.Array(route_schema_type(item, cx, &active) ?? return None))
        .Map(..) -> Val(.Object(properties: [], additional_properties: true))
        .Shared(inner) | .InlineRange(base: inner, ..) | .Quantity(base: inner, ..) | .Tagged(inner: inner, ..) -> route_schema_type(inner, cx, &active)
        .Option(inner) -> Val(.Nullable(route_schema_type(inner, cx, &active) ?? return None))
        .Result(ok: ok, ..) -> route_schema_type(ok, cx, &active)
        .Tuple(fields) -> {
            properties := [MirHttpPropertyFact]{}
            properties.reserve(fields.len())
            loop (name, field_ty) in fields -> properties.push(MirHttpPropertyFact{name: ~name, schema: route_schema_type(field_ty, cx, &active) ?? return None, required: true})
            Val(.Object(properties: ^properties, additional_properties: false))
        }
        .Union(items) -> {
            schemas := [MirHttpSchema]{}
            loop item in items -> schemas.push(route_schema_type(item, cx, &active) ?? return None)
            Val(.OneOf(^schemas))
        }
        .Named(name) | .Apply(name: name, ..) -> {
            if name == {
                "Any" | "JSON" -> return Val(.Any)
                "Null" | "Unit" -> return Val(.Null)
                "String" -> return Val(.String)
                "Bool" -> return Val(.Boolean)
                "Int" | "I8" | "I16" | "I32" | "I64" | "I128" | "U8" | "U16" | "U32" | "U64" | "U128" -> return Val(.Integer)
                "Float" | "F32" | "F64" -> return Val(.Number)
                else -> {}
            }
            if !cx.codable_types.contains(name) || active.contains_key(name) -> return None
            active[name] = true
            fields :: cx.reflection_fields.get(name) ?? return None
            properties := [MirHttpPropertyFact]{}
            properties.reserve(fields.len())
            loop field in fields {
                if !field.is_pub -> continue
                required :: if field.ty == { .Option(_) -> false, else -> true }
                properties.push(MirHttpPropertyFact{name: ~field.name, schema: route_schema_type(field.ty, cx, &active) ?? return None, required: required})
            }
            _ :: active.remove(name)
            Val(.Object(properties: ^properties, additional_properties: false))
        }
        .TraitObject(_) | .Fn(..) | .Measure(_) -> None
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2822
fn route_schema_expr(expr: Expr, cx: Cx, locals: [String: Type]) -> MirHttpSchema? Never! {
    active := [String: Bool]{}
    if route_strip_parens(expr) == {
        .Str(_, _) | .Char(_, _) -> Val(.String)
        .Int(..) -> Val(.Integer)
        .Float(..) -> Val(.Number)
        .Bool(_, _) -> Val(.Boolean)
        .Unit(_) -> Val(.Null)
        .ListLit(items, _) -> Val(.Array(route_schema_expr(items.first() ?? return None, cx, locals) ?? return None))
        .StructLit(type_name: name, ..) -> route_schema_type(Type.Named(name), cx, &active)
        .TupleLit(_, _, .Val(ty)) | .TypedLit(head: .Val(ty), ..) -> route_schema_type(ty, cx, &active)
        .Ident(name, _) -> route_schema_type(locals.get(name) ?? return None, cx, &active)
        .Call(call) -> route_schema_type(call.resolved_ret ?? return None, cx, &active)
        .MethodCall(resolved_ret: .Val(ty), ..) -> route_schema_type(ty, cx, &active)
        .Ok(value, _) | .Try(value, _, _, _) -> route_schema_expr(value, cx, locals)
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2874
fn route_status(expr: Expr, cx: Cx) -> I64? Never! {
    if route_strip_parens(expr) == {
        .Int(value, ..) -> Val(value)
        .Ident(name, _) -> if cx.const_values.get(name) == { .Val(.Int(value)) -> Val(value), else -> None }
        .ComptimeName(value: .Val(.Int(value)), ..) -> Val(value)
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2889
fn route_response_constructor(name: String, args: [CallArg], cx: Cx, locals: [String: Type]) -> [MirHttpResponseFact]? Never! {
    if (name != "response" && name != "json" && name != "empty_response") || args.is_empty() -> return None
    status :: route_status(args[0].expr, cx) ?? return None
    if status < 100 || status > 599 -> return None
    (schema, content_type) :: if name == {
        "response" if args.len() == 2 -> (Val(route_schema_expr(args[1].expr, cx, locals) ?? return None), None)
        "json" if args.len() == 2 -> (Val(route_schema_expr(args[1].expr, cx, locals) ?? return None), Val("application/json"))
        "empty_response" if args.len() == 1 -> (None, None)
        else -> return None
    }
    Val([MirHttpResponseFact{status: status, description: "HTTP response", schema: ^schema, content_type: ^content_type}])
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2921
fn route_response_expr(expr: Expr, cx: Cx, locals: [String: Type], response_aliases: [String: [MirHttpResponseFact]]) -> [MirHttpResponseFact]? Never! {
    if route_strip_parens(expr) == {
        .Ok(value, _) | .Try(value, _, _, _) -> route_response_expr(value, cx, locals, response_aliases)
        .If(then_value: yes, else_value: no, ..) -> {
            responses := route_response_expr(yes, cx, locals, response_aliases) ?? return None
            responses.extend(route_response_expr(no, cx, locals, response_aliases) ?? return None)
            Val(^responses)
        }
        .Ident(name, _) -> response_aliases.get(name).map(rows -> ~rows)
        .Call(call) -> route_response_constructor(call.name.rsplit(".").next() ?? call.name, call.args, cx, locals)
        .MethodCall(receiver: receiver, method: method, args: args, resolved_ret: ret, ..) -> {
            returns_http_response :: if ret == {
                .Val(.Named(name)) -> name == "HTTPResponse"
                .Val(.Result(ok: ok, err: error)) -> error.is_never() && if ok == { .Named(name) -> name == "HTTPResponse", else -> false }
                else -> false
            }
            if returns_http_response && (method == "response" || method == "json" || method == "empty_response") -> return route_response_constructor(method, args, cx, locals)
            // Checked adapters preserve the contract of their response receiver.
            if returns_http_response -> return route_response_expr(receiver, cx, locals, response_aliases)
            None
        }
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:2988
fn route_collect_returns(body: [Stmt], cx: Cx, locals: &[String: Type], response_aliases: &[String: [MirHttpResponseFact]], responses: &[MirHttpResponseFact], allow_opaque_responses: Bool) -> Bool Never! {
    valid := true
    loop stmt in body {
        if stmt == {
            .Val(binding) -> {
                if !binding.name.is_empty() {
                    // Any later binding shadows a prior response alias.
                    _ :: response_aliases.remove(binding.name)
                    if route_response_expr(binding.init, cx, locals, response_aliases) == .Val(found) -> response_aliases[binding.name] = ^found
                }
                if binding.ty == .Val(ty) {
                    if !binding.name.is_empty() -> locals[binding.name] = ~ty
                }
            }
            .Return(.Val(value), _) -> {
                found :: route_response_expr(value, cx, locals, response_aliases) ?? {
                    if !allow_opaque_responses -> valid = false
                    continue
                }
                responses.extend(^found)
            }
            .Return(.None, _) -> valid = false
            .While(body: nested, ..) | .For(body: nested, ..) | .Loop(body: nested, ..)
            | .Unsafe(body: nested, ..) | .Impure(body: nested, ..) | .Reactive(body: nested, ..)
            | .Shield(body: nested, ..) | .Switched(body: nested, ..) | .Region(body: nested, ..)
            | .Policy(body: nested, ..) | .TaskGroup(body: nested, ..) | .Layout(body: nested, ..)
            | .AuthorityScope(body: nested, ..) | .ComptimeBlock(body: nested, ..)
            | .ContextBlock(body: nested, ..) | .Live(body: nested, ..) | .AssumeDet(body: nested, ..)
            | .Transact(body: nested, ..) | .ScopeMember(body: nested, ..) -> {
                child_valid :: route_collect_returns(nested, cx, &locals, &response_aliases, &responses, allow_opaque_responses)
                valid = valid && child_valid
            }
            .Switch(arms: arms, else_body: otherwise, ..) | .ComptimeSwitch(arms: arms, else_body: otherwise, ..) -> {
                loop arm in arms {
                    child_valid :: route_collect_returns(arm.body, cx, &locals, &response_aliases, &responses, allow_opaque_responses)
                    valid = valid && child_valid
                }
                if otherwise == .Val(nested) {
                    child_valid :: route_collect_returns(nested, cx, &locals, &response_aliases, &responses, allow_opaque_responses)
                    valid = valid && child_valid
                }
            }
            .CountedLoop(body: nested, step: step, ..) -> {
                child_valid :: route_collect_returns(nested, cx, &locals, &response_aliases, &responses, allow_opaque_responses)
                valid = valid && child_valid
                if step == .Val(statement) {
                    step_valid :: route_collect_returns([statement], cx, &locals, &response_aliases, &responses, allow_opaque_responses)
                    valid = valid && step_valid
                }
            }
            .ComptimeIf(then_body: yes, else_body: no, ..) -> {
                child_valid :: route_collect_returns(yes, cx, &locals, &response_aliases, &responses, allow_opaque_responses)
                valid = valid && child_valid
                if no == .Val(nested) {
                    child_valid :: route_collect_returns(nested, cx, &locals, &response_aliases, &responses, allow_opaque_responses)
                    valid = valid && child_valid
                }
            }
            else -> {}
        }
    }
    valid
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:3137
fn route_json_type_from_body(body: LambdaBody) -> Type? Never! {
    found := Type?{None}
    visit := fn(expr: Expr) {
        if found != None -> return
        if expr == {
            .MethodCall(method: method, recv_type: recv_type, type_args: type_args, ..) -> {
                if method == "json" && recv_type == Val("HTTPRequest") && type_args.len() == 1 -> found = Val(~type_args[0])
            }
            else -> {}
        }
    }
    if body == {
        .Expr(expr) -> expr.for_each_expr(&visit)
        .Block(stmts) -> { loop stmt in stmts -> stmt.for_each_expr(&visit) }
    }
    ^found
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:3169
fn route_handler_contract(method: MirHttpMethod, path_expr: Expr, handler_expr: Expr, cx: Cx, line: Int, is_mux: Bool) -> String? Never! {
    pattern :: route_static_string(path_expr, cx) ?? return None
    _ :: Syntax.validate_http_route_pattern(pattern) ?? return None
    path := ""
    parameters := [MirHttpParameterFact]{}
    if pattern == "/" -> path.push('/')
    else {
        loop segment in pattern.split("/").skip(1) {
            path.push('/')
            if segment.strip_prefix(":") == .Val(name) {
                path += "{{{name}}}"
                parameters.push(MirHttpParameterFact{name: ~name, location: .Path, required: true, catch_all: false, schema: .String})
            } else if segment.strip_prefix("*") == .Val(name) {
                path += "{{{name}}}"
                parameters.push(MirHttpParameterFact{name: ~name, location: .Path, required: true, catch_all: true, schema: .String})
            } else -> path += segment
        }
    }
    handler :: route_strip_parens(handler_expr)
    (body, param_types) :: if handler == {
        .Lambda(lambda) -> {
            params := [Type]{}
            loop param in lambda.params -> params.push(~(param.ty ?? return None))
            (~lambda.body, ^params)
        }
        .Ident(name, _) -> {
            statements :: cx.fn_bodies.get(name) ?? return None
            signature :: cx.sigs.get(name) ?? return None
            (LambdaBody.Block(~statements), signature.map((_, ty) -> ~ty))
        }
        else -> return None
    }
    locals := [String: Type]{}
    response_aliases := [String: [MirHttpResponseFact]]{}
    handler_param_names := [(String, Type)]{}
    handler_param_names.reserve(param_types.len())
    if handler == {
        .Ident(name, _) -> {
            if cx.fn_param_names.get(name) == .Val(names) {
                loop (param_name, ty) in names.zip(param_types) {
                    handler_param_names.push((~param_name, ~ty))
                    locals[param_name] = ~ty
                }
            }
        }
        .Lambda(lambda) -> {
            loop (param, ty) in lambda.params.zip(param_types) {
                handler_param_names.push((~param.name, ~ty))
                locals[param.name] = ~ty
            }
        }
        else -> {}
    }
    if handler_param_names.len() != param_types.len() -> return None
    names := [String: Bool]{}
    request_count := 0
    loop (name, ty) in handler_param_names {
        if name.is_empty() || names.contains_key(name) -> return None
        names[name] = true
        if ty == { .Named("HTTPRequest") -> request_count += 1, else -> {} }
    }
    if request_count > 1 -> return None
    if !is_mux {
        // Unique name validation above makes this index equivalent to unique matching.
        loop parameter in &parameters {
            if parameter.location != .Path -> continue
            ty :: locals.get(parameter.name) ?? return None
            if ty == { .Named("HTTPRequest") -> return None, else -> {} }
            active := [String: Bool]{}
            parameter.schema = route_schema_type(ty, cx, &active) ?? return None
        }
    }
    path_names := [String: Bool]{}
    loop parameter in parameters {
        if parameter.location == .Path -> path_names[parameter.name] = true
    }
    if method == .Get || method == .Head {
        loop (name, ty) in handler_param_names {
            is_request :: if ty == { .Named("HTTPRequest") -> true, else -> false }
            if path_names.contains_key(name) || is_request -> continue
            active := [String: Bool]{}
            required :: if ty == { .Option(_) -> false, else -> true }
            parameters.push(MirHttpParameterFact{name: ~name, location: .Query, required: required, catch_all: false, schema: route_schema_type(ty, cx, &active) ?? return None})
        }
    } else {
        loop (name, ty) in handler_param_names {
            is_request :: if ty == { .Named("HTTPRequest") -> true, else -> false }
            if !path_names.contains_key(name) && !is_request -> return None
        }
    }
    body_schema :: if route_json_type_from_body(body) == {
        .Val(ty) -> {
            active := [String: Bool]{}
            Val(route_schema_type(ty, cx, &active) ?? return None)
        }
        .None -> None
    }
    if body_schema == .Val(.Object(properties: properties, ..)) {
        parameter_names := [String: Bool]{}
        loop parameter in parameters -> parameter_names[parameter.name] = true
        if properties.any(property -> parameter_names.contains_key(property.name)) -> return None
    }
    request_body :: body_schema.map(schema -> MirHttpRequestBodyFact{required: true, content_type: "application/json", schema: ^schema})
    responses := [MirHttpResponseFact]{}
    valid :: if body == {
        .Expr(expr) -> if route_response_expr(expr, cx, locals, response_aliases) == {
            .Val(found) -> { responses.extend(^found); true }
            .None -> is_mux
        }
        .Block(stmts) -> route_collect_returns(stmts, cx, &locals, &response_aliases, &responses, is_mux)
    }
    if !valid || (!is_mux && responses.is_empty()) -> return None
    responses.sort_by(response -> response.status)
    // Adjacent full-value equality, not status-only de-duplication.
    responses.dedup()
    operation_id :: MirHttpRouteFacts.operation_id(method, path)
    Val(MirHttpRouteFacts{method: method, pattern: ^pattern, path: ^path, operation_id: ^operation_id, summary: None, parameters: ^parameters, request_body: ^request_body, responses: ^responses, security: [], provenance: "{cx.file}:{line}"}.to_wire())
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:3391
fn hardware_method_op(receiver: Expr, method: String, args: [CallArg], recv_type: String?, cx: Cx, env: LowerEnv) -> THardwareCall? Err! {
    profile_id :: cx.hardware_profile_id.filter(id -> !id.is_empty()) ?? return None
    profile :: cx.hardware_profile ?? return err("checked hardware profile facts are missing")
    path :: hardware_expr_path(receiver)
    is_board_receiver :: path.first().is_some_and(root -> cx.core_imports.get(root).is_some_and(profile -> profile.starts_with("board.")))
    if is_board_receiver && path.len() >= 3 {
        block :: profile.register_blocks.find(block -> block.name.eq_ignore_ascii_case(path[1])) ?? return err("checked hardware register block fact is missing for `{path[1]}`")
        register :: block.registers.find(register -> register.name.eq_ignore_ascii_case(path[2])) ?? return err("checked hardware register fact is missing for `{block.name}.{path[2]}`")
        return if method == {
            "read" -> Val(THardwareCall.RegisterRead(profile_id: ~profile_id, block: ~block.name, register: ~register.name, width: register.width))
            "write" | "set" | "clear" -> Val(THardwareCall.RegisterWrite(profile_id: ~profile_id, block: ~block.name, register: ~register.name, width: register.width))
            else -> None
        }
    }
    is_dma :: if receiver == { .Ident("dma", _) -> true, else -> false }
    if method == "start" && is_dma && args.len() >= 2 {
        channel_path :: hardware_expr_path(args[0].expr)
        if channel_path.len() >= 3 && channel_path.first().is_some_and(root -> cx.core_imports.get(root).is_some_and(profile -> profile.starts_with("board."))) {
            channel_key :: "{channel_path[1].to_ascii_uppercase()}_{channel_path[2].to_ascii_uppercase()}"
            channel :: profile.dma_channels.find(fact -> fact.name.eq_ignore_ascii_case(channel_key)) ?? return err("checked hardware DMA channel fact is missing for `{channel_key}`")
            return Val(THardwareCall.DmaStart(profile_id: ~profile_id, channel: ~channel.name, buffer_ty: Type.Named("__JetDmaBuffer")))
        }
    }
    if method == "wait" && recv_type == Val("__JetDmaTransfer") {
        receiver_name :: if receiver == { .Ident(name, _) -> name, else -> return err("checked hardware DMA wait receiver has no transfer binding") }
        channel_name :: env.dma_transfer_channel(receiver_name) ?? return err("checked hardware DMA wait has no channel fact for its transfer binding")
        channel :: profile.dma_channels.find(fact -> fact.name.eq_ignore_ascii_case(channel_name)) ?? return err("checked hardware DMA channel fact is missing for `{channel_name}`")
        return Val(THardwareCall.DmaWait(profile_id: ~profile_id, channel: ~channel.name, buffer_ty: Type.Named("__JetDmaBuffer")))
    }
    None
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:3511
fn hardware_expr_path(expr: Expr) -> [String] Never! {
    if expr == {
        .Ident(name, _) -> [~name]
        .Field(base, member, _) -> {
            path := hardware_expr_path(base)
            path.push(~member)
            ^path
        }
        .Paren(inner, _) -> hardware_expr_path(inner)
        else -> []
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:3524
fn lower_app_callback(expr: Expr, cx: Cx, env: &LowerEnv) -> TExpr Never! {
    value :: lower_expr(expr, cx, &env)
    if value.kind == { .FnValue(kind: .Send(..)) -> return ^value, else -> {} }
    ty :: ~value.ty
    TExpr{ty: ^ty, kind: TExprKind.FnValue(kind: TFnValueKind.Send(value: ^value))}
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:3545
fn lower_http_middleware_callback(expr: Expr, cx: Cx, env: &LowerEnv) -> TExpr Never! {
    value :: if route_strip_parens(expr) == {
        .Lambda(lam) -> {
            middleware_ty :: Type.Fn(params: [Type.Named("HTTPHandler")], ret: Val(Type.Named("HTTPHandler")), effect_bound: None, return_view_provenance: None, param_contract: None, call_metadata: None)
            lowered :: lower_lambda_expecting_callable(lam, cx, &env, middleware_ty)
            TExpr{ty: ^middleware_ty, kind: TExprKind.Lambda(^lowered)}
        }
        else -> lower_expr(expr, cx, &env)
    }
    if value.kind == { .FnValue(kind: .Send(..)) -> return ^value, else -> {} }
    if value.ty == { .Fn(..) -> {}, else -> return ^value }
    force_thread_callback_value(^value, cx)
}

