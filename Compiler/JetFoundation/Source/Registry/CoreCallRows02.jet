// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:1793
fn lower_core_string_source_call(receiver: Expr, method_span: Span, method: String, type_args: [Type], args: [CallArg], recv_type: String?, resolved_ret: Type?, cx: Cx, env: &LowerEnv, lowered_receiver: TExpr?) -> TExpr? Never! {
    // GATE #4499: canonical tuple module/method map keys.
    if recv_type != Val(Syntax.TYPE_STRING) || !cx.core_source_sigs.contains_key((CORE_TEXT_STRING_MODULE, method)) -> return None
    module :: CORE_TEXT_STRING_MODULE
    if !cx.core_source_modules.contains_key(module) -> return Val(invariant_method_expr(method_span, "private String source module is not loaded"))
    source_signature :: cx.core_source_sigs.get((module, method)) ?? return Val(invariant_method_expr(method_span, "private String source method has no loaded signature"))
    (receiver_convention, receiver_ty) :: source_signature.params.first() ?? return Val(invariant_method_expr(method_span, "source String method has no receiver parameter"))
    if receiver_ty != .String -> return Val(invariant_method_expr(method_span, "source String method receiver is not canonical String"))
    recv :: lowered_receiver ?? lower_expr(receiver, cx, &env)
    receiver_arg := TCallArg{value: ^recv, template_items: None, borrow: false, mut_borrow: false, clone: false, arc_clone: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None}
    if receiver_convention == .Read && !receiver_ty.is_scalar() -> receiver_arg.borrow = true
    else if receiver_convention == .Write -> receiver_arg.mut_borrow = true
    lowered_args := [^receiver_arg]
    lowered_args.extend(lower_module_args(args, source_signature.params.get(1..), &env, cx))
    ty :: resolved_ret ?? return Val(invariant_method_expr(method_span, "source String method has no resolved return type"))
    target_return :: if module_call_target_return(cx, Val(ty)) == { .Ok(target) -> Val(target), .Err(error) -> return Val(invariant_method_expr(method_span, error)) }
    Val(TExpr{ty: ~ty, kind: TExprKind.ModuleCall(form: core_source_module_target(source_signature, method), target_return: ^target_return, type_args: ~type_args, args: ^lowered_args)})
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:1891
fn reduce_op_name(expr: Expr) -> String? Never! {
    if expr == {
        .ReduceMarker(name, _) -> Val(~name)
        .EnumLit(type_name: type_name, variant: variant, args: args, ..) -> if (type_name.is_empty() || type_name == Syntax.TYPE_REDUCE_OP) && args.is_empty() -> Val(~variant) else -> None
        else -> None
    }
}
