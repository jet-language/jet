// The shape of OWNED_TRAITS, the traits the compiler owns, and the questions
// every reader asks it. Compiler/Prelude/Traits.jet declares the traits;
// Tools/agent/OwnedTraitRows.jet renders the declarations into
// OwnedTraitRows.jet, so each row is one trait's declaration: the orphan rule
// (`local`), a bare generic bound (`bare_bound`), the raw protocol return
// (`raw_return`), operator identity and hooks, the derive and bundle markers,
// the type-parameter method fallback, and the impl contract check (E0906,
// E0907, E0913). A trait the compiler knows has a row, and the row names its
// contract, so no compiler-owned trait goes unchecked.

// How an owned trait's method takes its receiver.
OwnedReceiver: enum {
    // No receiver: `zero: fn() -> Self`.
    Static
    // `self` with whatever access the impl writes; the trait fixes none.
    Any
    Fixed(access: AccessConvention)
}

OwnedParam: struct {
    name: String
    ty: Type
}

// `Self` and the trait's associated type names resolve per impl.
OwnedMethod: struct {
    name: String
    receiver: OwnedReceiver
    params: [OwnedParam]
    // None: the method returns no value.
    returns: Type?
}

OwnedContract: enum {
    // Fixed methods and associated types. `shares` names the trait whose
    // impl on the same type binds the associated names these methods use
    // (`IndexMut` reads `Index`'s `Key` and `Value`).
    Methods(methods: [OwnedMethod], associated: [String], shares: String?)
    // `fn {hook}(self, rhs: Rhs) -> {result}`; no result admits any declared
    // one (the arithmetic hooks, whose right-hand type may be written).
    Operator(hook: String, result: Type?)
    // `encode: fn(self) -> Dyn` or the static `decode: fn(tree: Dyn) -> T [FieldError]!`.
    Codec(verb: String)
    // `#run from_literal: fn(value: Source) -> T` on the literal's source.
    Literal(source: Type)
    // A `distinct String` type's pure checker and hole encoder; the prelude
    // spells the same declaration for readers.
    CheckedText
    // Derived by the compiler from the type itself; an impl adds no methods
    // the compiler reads.
    Derived
}

OwnedTrait: struct {
    name: String
    // The orphan rule counts the trait as declared by every program (E0902).
    local: Bool
    // A generic bound may name it bare, with no declaring module.
    bare_bound: Bool
    // Its impl methods return their declared type as written, never through
    // the implicit failure carrier.
    raw_return: Bool
    contract: OwnedContract
    // The source operators its hook implements: `==` and `!=` for `Equatable`.
    operators: [String]
    // `#Commutative` on a typed impl also answers the swapped operands.
    commutative: Bool
    // The traits every type with this one also has.
    requires: [String]
    // `#Name` on a struct or enum derives it structurally; `!Name` refuses it.
    auto_derive: Bool
    // The marker that derives it with the family's other traits (`Codable`).
    auto_derive_family: String?
    // `#Name` on a distinct type re-exposes it from the base type.
    bundle: Bool
    // The distinct-type marker that bundles the family (`CodableAsBase`).
    bundle_family: String?
    // A list, map, option or union has it when its elements do.
    through_elements: Bool
}

owned_trait: fn(name: String) -> OwnedTrait? Never! {
    loop owned in OWNED_TRAITS {
        if owned.name == name -> return Val(owned)
    }
    None
}

// Whether the owned trait declares a method of this name.
owned_trait_declares: fn(owned: OwnedTrait, method: String) -> Bool Never! {
    if owned.contract == {
        .Methods(methods, _, _) -> loop declared in methods {
            if declared.name == method -> break true
        } ?? false
        .Operator(hook, _) -> hook == method
        .Codec(verb) -> verb == method
        .Literal(_) -> method == "from_literal"
        .CheckedText -> method == "check" || method == "encode_hole" || method == "build"
        .Derived -> false
    }
}

// The operator hook method an operator trait declares: `add` for `Add`.
owned_trait_operator_hook: fn(trait_name: String) -> String? Never! {
    owned: owned_trait(trait_name) ?? return None
    if owned.contract == .Operator(hook, _) -> return Val(hook)
    None
}

owned_trait_is_operator: fn(trait_name: String) -> Bool Never! {
    owned_trait_operator_hook(trait_name) != None
}

// An owned trait whose impl methods are held to `-[]>` (E0742): the
// operator traits and CheckedText.
owned_trait_bounds_pure: fn(trait_name: String) -> Bool Never! {
    owned: owned_trait(trait_name) ?? return false
    if owned.contract == .Operator(_, _) -> return true
    owned.contract == .CheckedText
}

// The operator trait whose hook is `method`: `Add` for `add`.
owned_trait_for_operator_hook: fn(method: String) -> String? Never! {
    loop owned in OWNED_TRAITS {
        if owned.contract == .Operator(hook, _) && hook == method -> return Val(owned.name)
    }
    None
}

// An operator hook that admits any declared result and a written right-hand
// type: `+`, `-`, `*`, `/`.
owned_trait_arithmetic: fn(trait_name: String) -> Bool Never! {
    owned: owned_trait(trait_name) ?? return false
    if owned.contract == .Operator(_, result) -> return result == None
    false
}

// The arithmetic operator traits for a reader, in table order:
// "Add, Sub, Mul, and Div".
owned_trait_arithmetic_listed: fn() -> String Never! {
    names := [String]{}
    loop owned in OWNED_TRAITS {
        if owned_trait_arithmetic(owned.name) -> names.push(owned.name.copy())
    }
    owned_trait_listed(names)
}

// The traits `trait_name` requires, for a reader: "Add, Sub, Mul, and
// Comparable" for `Numeric`.
owned_trait_requires_listed: fn(trait_name: String) -> String Never! {
    owned: owned_trait(trait_name) ?? return ""
    owned_trait_listed(owned.requires)
}

owned_trait_listed: fn(names: [String]) -> String Never! {
    joined: names.join(", ")
    last: joined.rpartition(", ")
    if last.sep == "" -> return joined
    "{last.head}, and {last.tail}"
}

// An operator trait whose typed impl `#Commutative` may mark: `Add`, `Mul`.
owned_trait_commutative: fn(trait_name: String) -> Bool Never! {
    owned: owned_trait(trait_name) ?? return false
    owned.commutative
}

// An operator hook with a fixed result: `==` and ordering.
owned_trait_structural: fn(trait_name: String) -> Bool Never! {
    owned: owned_trait(trait_name) ?? return false
    if owned.contract == .Operator(_, result) -> return result != None
    false
}

// The structural traits in table order: `Equatable`, `Comparable`.
owned_trait_structural_names: fn() -> [String] Never! {
    names := [String]{}
    loop owned in OWNED_TRAITS {
        if owned_trait_structural(owned.name) -> names.push(owned.name.copy())
    }
    names
}

// A codec trait: `Encode`, `Decode`.
owned_trait_codec: fn(trait_name: String) -> Bool Never! {
    owned: owned_trait(trait_name) ?? return false
    if owned.contract == .Codec(_) -> return true
    false
}

// The codec traits in table order: `Encode`, `Decode`.
owned_trait_codec_names: fn() -> [String] Never! {
    names := [String]{}
    loop owned in OWNED_TRAITS {
        if owned_trait_codec(owned.name) -> names.push(owned.name.copy())
    }
    names
}

// A literal capability: `Literal.Int`, `Literal.Float`.
owned_trait_literal: fn(trait_name: String) -> Bool Never! {
    owned: owned_trait(trait_name) ?? return false
    if owned.contract == .Literal(_) -> return true
    false
}

// The operator trait a source operator calls: `Equatable` for `!=`.
owned_trait_for_operator: fn(symbol: String) -> OwnedTrait? Never! {
    loop owned in OWNED_TRAITS {
        if owned.operators.contains(symbol) -> return Val(owned)
    }
    None
}

// Whether a type with `trait_name` also has `other`: the trait itself or one
// it requires (`Numeric` requires `Add`).
owned_trait_implies: fn(trait_name: String, other: String) -> Bool Never! {
    if trait_name == other -> return true
    owned: owned_trait(trait_name) ?? return false
    owned.requires.contains(other)
}

// The traits that require `trait_name`: a bound on any of them also admits
// `trait_name`'s operators and methods (`Numeric` for `Add`).
owned_trait_requirers: fn(trait_name: String) -> [String] Never! {
    names := [String]{}
    loop owned in OWNED_TRAITS {
        if owned.requires.contains(trait_name) -> names.push(owned.name.copy())
    }
    names
}

// The traits a family marker derives (`auto_derive_family`, `Codable`) or
// bundles (`bundle_family`, `CodableAsBase`), in table order; empty when
// `marker` names no such family.
owned_trait_family: fn(marker: String, bundle: Bool) -> [String] Never! {
    members := [String]{}
    loop owned in OWNED_TRAITS {
        family: if bundle -> owned.bundle_family else -> owned.auto_derive_family
        if family == .Val(name) && name == marker -> members.push(owned.name.copy())
    }
    members
}

// Whether `#{marker}` on a struct or enum is a structural auto-derive
// control: a trait it derives, or a family of them. `!{marker}` refuses it.
owned_trait_auto_derive_marker: fn(marker: String) -> Bool Never! {
    if owned_trait(marker) == .Val(owned) && owned.auto_derive -> return true
    owned_trait_family(marker, false).len() > 0
}

// The traits `#{marker}` on a distinct type re-exposes from its base type:
// the trait itself when it bundles, or the members of a bundle family.
owned_trait_bundle: fn(marker: String) -> [String] Never! {
    if owned_trait(marker) == .Val(owned) && owned.bundle -> return [String]{marker.copy()}
    owned_trait_family(marker, true)
}

// The distinct-type marker that grants `trait_name`: the trait itself when
// it bundles, else its bundle family (`CodableAsBase` for `Encode`).
owned_trait_bundle_marker: fn(trait_name: String) -> String? Never! {
    owned: owned_trait(trait_name) ?? return None
    if owned.bundle -> return Val(owned.name.copy())
    if owned.bundle_family == .Val(family) -> return Val(family.copy())
    None
}

// Whether the derive or marker `marker` gives a type a codec: a codec trait
// or a family whose members are codec traits (`Codable`, `Encode`).
owned_trait_codec_marker: fn(marker: String) -> Bool Never! {
    names := owned_trait_family(marker, false)
    if names.len() == 0 -> return owned_trait_codec(marker)
    loop name in names {
        if !owned_trait_codec(name) -> return false
    }
    true
}

// Whether a list, map, option or union has `trait_name` when its elements do.
owned_trait_through_elements: fn(trait_name: String) -> Bool Never! {
    owned: owned_trait(trait_name) ?? return false
    owned.through_elements
}
