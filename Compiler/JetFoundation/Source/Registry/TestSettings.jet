// D-TEST-INVOKE1=A: the one `jet test` settings table. By one naming rule a
// row is the flag `--shard=3/8` (`_` is `-` in a flag), the TestProfile field
// `shard: 3/8` in package.jet and the call `t.shard(3, 8)` on the `Test` value
// of test.jet's `test: fn`. One order holds, as for build options
// (D-SETTING-ORDER1=A): the selected test profile, then `test: fn`, then the
// flag, each later layer replacing the earlier. `jet test` runs `test: fn` once
// in a plan step to collect its calls before any test runs. A row that is
// not `ported` is refused in all three places (E2104 for the field and the
// call, the not-ported refusal for the flag).
//
// Not rows: `--profile`, `--release`, `--set`, `--env` and `--preset` select
// what is built; `--threads`, `--trace`, `--json`, `--color` and `--quiet` are
// jet-wide; `--help`, `--show-default` and `--browser-scaffold` are actions.

// How a row's value is written. Switch: the bare flag `--serial` (or
// `--serial=false`), the field `serial: true`, the call `t.serial()` (or
// `t.serial(false)`). Count: a whole number of at least 1; Seed: of at least
// 0 (`--shuffle=7`, `shuffle: 7`, `t.shuffle(7)`). Text and Path: nonempty
// text (`--results=r.json`, `results: "r.json"`, `t.results("r.json")`).
// Capture: failed, all or none. Shard: I/N with 1 <= I <= N <= 4096
// (`--shard=3/8`, `shard: 3/8`, `t.shard(3, 8)`). Levels: optimize levels
// (`--optimize=none,full`, `optimize: [none, full]`,
// `t.optimize(["none", "full"])`). Duration: a positive `ms`, `s` or `m`
// duration (`--time-limit=60s`, `time_limit: 60s`, `t.time_limit("60s")`).
// Size: a positive size in `k`, `m` or `g` (also `kib`, `mib`, `gib`) units
// (`--memory=16G`, `memory: 16gib`, `t.memory("16G")`).
TestSettingKind: enum {
    Switch
    Count
    Seed
    Text
    Path
    Capture
    Shard
    Levels
    Duration
    Size
}

TestSettingRow: struct {
    name: String
    kind: TestSettingKind
    ported: Bool
    help: String
}

// One chosen value: its row's name, the canonical value text
// (test_setting_value) and the layer that wrote it (`profile `ui``,
// `test: fn`, `flag`).
TestSetting: struct {
    name: String
    value: String
    source: String
}

// Why settings text can't be read (test_settings_parse_lines).
#Error
TestSettingError: struct {
    message: String
}

// The environment variable that names the plan file of `jet test`'s plan
// step. Each `t.<setting>(…)` call appends `name<TAB>value<NL>` to it; any
// run without it ignores the calls.
TEST_SETTINGS_PLAN_ENV: "JET_TEST_PLAN"
// Set in each child of a run to its settings, one `name<TAB>value<TAB>source`
// line each: the child takes them as decided and runs no plan step of its own.
TEST_SETTINGS_ENV: "JET_TEST_SETTINGS"

JET_TEST_SETTINGS: comptime { [TestSettingRow]{
    {name: "fresh", kind: TestSettingKind.Switch, ported: true, help: "Bypass only cached test results (default off); the build cache remains reusable"},
    {name: "docs", kind: TestSettingKind.Switch, ported: true, help: "Run checked documentation examples only (default off)"},
    {name: "filter", kind: TestSettingKind.Text, ported: true, help: "Only run tests and corpus rows whose name contains the text"},
    {name: "capture", kind: TestSettingKind.Capture, ported: true, help: "Show test output for failed, all, or none of the tests (default failed)"},
    {name: "update_snapshots", kind: TestSettingKind.Switch, ported: true, help: "Replace expected snapshot output and bless every selected corpus row"},
    {name: "shuffle", kind: TestSettingKind.Seed, ported: true, help: "Run tests in the order the seed picks"},
    {name: "serial", kind: TestSettingKind.Switch, ported: true, help: "Run tests one at a time instead of the parallel default"},
    {name: "measure", kind: TestSettingKind.Switch, ported: true, help: "Measure `.measure` claims"},
    {name: "trace_tiers", kind: TestSettingKind.Switch, ported: true, help: "Report the tier each test ran at"},
    // The optimize levels of a test run: none is `jet run`, basic `jet build`
    // and full the release build. More than one runs the tests once per level.
    {name: "optimize", kind: TestSettingKind.Levels, ported: true, help: "Run the tests at each listed optimize level: none, basic or full"},
    {name: "time_limit", kind: TestSettingKind.Duration, ported: true, help: "Bound each test's wall time, such as 60s"},
    {name: "opt_in", kind: TestSettingKind.Switch, ported: true, help: "Also run the corpus rows that are opt-in only"},
    // The same tests land in the same slice for the same tree. A sharded run
    // compares with its baseline but never writes it.
    {name: "shard", kind: TestSettingKind.Shard, ported: true, help: "Run slice I of N of the selected tests and corpus rows, as I/N"},
    {name: "list", kind: TestSettingKind.Switch, ported: true, help: "Print the selected tests after filter and shard, run nothing, exit 0"},
    // Read before the slice: a shard of a list holds the listed rows its slice holds.
    {name: "cases", kind: TestSettingKind.Path, ported: true, help: "Only run the tests and corpus rows the file names, one name or id per line"},
    // The corpus pool's width and memory; 0 (unset) sizes it from the host.
    {name: "jobs", kind: TestSettingKind.Count, ported: true, help: "Run at most this many corpus entries at once (default: from the cores)"},
    {name: "memory", kind: TestSettingKind.Size, ported: true, help: "Bound the memory the running corpus entries claim together, such as 16G"},
    // The ui and lint blessing guard: `update_snapshots` refuses a snapshot
    // that renders fewer diagnostics unless its row is listed here.
    {name: "allow_shrink", kind: TestSettingKind.Text, ported: true, help: "Let `update_snapshots` bless fewer diagnostics for the listed ui rows, comma-separated"},
    {name: "diagnostic_coverage", kind: TestSettingKind.Switch, ported: true, help: "Check the ui suite's emitted and rendered codes against tests/diagnostics_coverage_allowlist.tsv instead of its rows"},
    // One JSON verdict document, written as JET_CI_EVIDENCE_DIR's are.
    {name: "results", kind: TestSettingKind.Path, ported: true, help: "Write every selected test's verdict to the JSON file"},
    // Slicing, baselines and verdicts stay with the running jet.
    {name: "compiler", kind: TestSettingKind.Path, ported: true, help: "Build and run the tests with the named jet"},
    // The engine the corpora's `jetpack` steps and `jet` engine verbs run
    // (exported to each case as JETPACK_BIN).
    {name: "jetpack", kind: TestSettingKind.Path, ported: true, help: "Run the corpora's jetpack steps and engine verbs with the named jetpack"},
    {name: "where", kind: TestSettingKind.Text, ported: false, help: "Filter recorded package, dependency, path, tag, or status facts"},
    {name: "coverage", kind: TestSettingKind.Switch, ported: false, help: "Show function or diagnostic coverage"},
    // The generated grade: each property test runs `iterations` generated
    // cases instead of its default budget, from the base `seed` (a fixed 0
    // unless set, or named by JET_PROP_SEED). `generated` is the one grade.
    {name: "grade", kind: TestSettingKind.Text, ported: true, help: "Select the generated property-test grade: generated"},
    {name: "iterations", kind: TestSettingKind.Count, ported: true, help: "Generated-grade case budget (default 1000)"},
    {name: "time", kind: TestSettingKind.Count, ported: false, help: "Generated-grade wall-clock budget in seconds"},
    {name: "seed", kind: TestSettingKind.Seed, ported: true, help: "Generated-grade base PRNG seed (default: fixed 0, reproducible)"},
    {name: "corpus", kind: TestSettingKind.Path, ported: false, help: "Generated-grade corpus directory (default: .jet/fuzz/<test>)"},
    {name: "watch", kind: TestSettingKind.Switch, ported: false, help: "Re-run on dependency changes"},
    {name: "record", kind: TestSettingKind.Text, ported: false, help: "Record a named replay"},
    {name: "browser", kind: TestSettingKind.Text, ported: false, help: "Select browser engines for tests"},
    {name: "browser_retries", kind: TestSettingKind.Count, ported: false, help: "Retry each browser attempt up to five times"},
    {name: "browser_reporter", kind: TestSettingKind.Text, ported: false, help: "Browser report format: text, json, or html"},
    {name: "browser_ui", kind: TestSettingKind.Switch, ported: false, help: "Write/open the local browser report viewer"},
    {name: "browser_visual", kind: TestSettingKind.Switch, ported: false, help: "Capture screenshots for passing browser attempts"},
    {name: "browser_trace", kind: TestSettingKind.Switch, ported: false, help: "Keep redacted BiDi trace entries for every browser attempt"},
} }

test_setting_row: fn(name: String) -> TestSettingRow? {
    loop row in JET_TEST_SETTINGS {
        if row.name == name -> return Val(row.copy())
    }
    None
}

test_setting_flag: fn(name: String) -> String Never! {
    "--{name.replace("_", "-")}"
}

// The row a flag (`--shard` or `--shard=3/8`, `-u`) names.
test_setting_flag_row: fn(argument: String) -> TestSettingRow? {
    head: argument.split("=").to_list()[0]
    if head == "-u" -> return test_setting_row("update_snapshots")
    loop row in JET_TEST_SETTINGS {
        if test_setting_flag(row.name) == head -> return Val(row.copy())
    }
    None
}

// The three spellings of a row, as `jet help test` shows them.
test_setting_spellings: fn(row: TestSettingRow) -> String Never! {
    flag: test_setting_flag(row.name)
    if row.kind == {
        .Switch -> "{flag}, `{row.name}: true`, `t.{row.name}()`"
        .Count -> "{flag}=<n>, `{row.name}: 4`, `t.{row.name}(4)`"
        .Seed -> "{flag}=<n>, `{row.name}: 7`, `t.{row.name}(7)`"
        .Text | .Path -> "{flag}=<text>, `{row.name}: \"x\"`, `t.{row.name}(\"x\")`"
        .Capture -> "{flag}=all, `{row.name}: all`, `t.{row.name}(\"all\")`"
        .Shard -> "{flag}=3/8, `{row.name}: 3/8`, `t.{row.name}(3, 8)`"
        .Levels -> "{flag}=none,full, `{row.name}: [none, full]`, `t.{row.name}([\"none\", \"full\"])`"
        .Duration -> "{flag}=60s, `{row.name}: 60s`, `t.{row.name}(\"60s\")`"
        .Size -> "{flag}=16G, `{row.name}: 16gib`, `t.{row.name}(\"16G\")`"
    }
}

// What a value of the row must look like, for a refusal's "needs …".
test_setting_hint: fn(row: TestSettingRow) -> String Never! {
    if row.kind == {
        .Switch -> "true or false"
        .Count -> "a whole number of at least 1"
        .Seed -> "a whole number of at least 0"
        .Text -> if row.name == "grade" -> "`generated`" else -> "nonempty text"
        .Path -> "a nonempty path"
        .Capture -> "failed, all or none"
        .Shard -> "I/N with 1 <= I <= N, such as `2/4`"
        .Levels -> "optimize levels from none, basic and full, each at most once"
        .Duration -> "a positive duration such as `60s`, `1500ms` or `2m`"
        .Size -> "a positive size such as `16G`, `8gib` or `512mib`"
    }
}

// The canonical text of `text` as a value of `row`, None when it is none
// (test_setting_hint says what the row takes). Switch is `true`/`false`;
// Count and Seed are decimal; Capture is failed, all or none (failure,
// failures and off are accepted); Shard is `I/N`; Levels is the levels
// joined by `,` (written `none,full`, `[none, full]` or `["none", "full"]`);
// Duration is whole milliseconds, `<n>ms`; Size is whole bytes.
test_setting_value: fn(row: TestSettingRow, text: String) -> String? Never! {
    trimmed: text.trim()
    if row.kind == {
        .Switch -> {
            if trimmed == "true" || trimmed == "false" -> return Val(trimmed.copy())
            None
        }
        .Count | .Seed -> {
            count: test_setting_whole(trimmed) ?? return None
            if row.kind == TestSettingKind.Count && count < 1 -> return None
            Val("{count}")
        }
        .Text | .Path -> {
            if trimmed == "" || trimmed.contains("\n") || trimmed.contains("\t") -> return None
            if row.name == "grade" && trimmed != "generated" -> return None
            Val(trimmed.copy())
        }
        .Capture -> {
            if {
                trimmed == "failed" || trimmed == "failure" || trimmed == "failures" -> Val("failed")
                trimmed == "all" -> Val("all")
                trimmed == "none" || trimmed == "off" -> Val("none")
                else -> None
            }
        }
        .Shard -> {
            parts: trimmed.split("/").to_list()
            if parts.len() != 2 -> return None
            index: test_setting_whole(parts[0].trim()) ?? return None
            count: test_setting_whole(parts[1].trim()) ?? return None
            if index < 1 || index > count || count > 4096 -> return None
            Val("{index}/{count}")
        }
        .Levels -> {
            inner := trimmed.copy()
            if inner.starts_with("[") && inner.ends_with("]") -> inner = inner.slice(1..<inner.len() - 1)
            levels := [String]{}
            loop part in inner.split(",").to_list() {
                level: part.trim().replace("\"", "")
                if level != "none" && level != "basic" && level != "full" -> return None
                if levels.contains(level) -> return None
                &levels.push(level)
            }
            Val(levels.join(","))
        }
        .Duration -> {
            unit := 1000
            digits := trimmed.copy()
            if trimmed.ends_with("ms") {
                unit = 1
                digits = trimmed.removesuffix("ms")
            } else if trimmed.ends_with("s") {
                digits = trimmed.removesuffix("s")
            } else if trimmed.ends_with("m") {
                unit = 60000
                digits = trimmed.removesuffix("m")
            } else {
                return None
            }
            // At most nine digits, so the product stays far inside Int.
            plain: digits.replace("_", "")
            if plain.bytes().len() > 9 -> return None
            count: test_setting_whole(plain) ?? return None
            if count < 1 -> return None
            Val("{count * unit}ms")
        }
        .Size -> {
            loop unit in TEST_SETTING_SIZE_UNITS {
                if !trimmed.ends_with(unit.suffix) -> next
                plain: trimmed.removesuffix(unit.suffix).trim().replace("_", "")
                count: test_setting_whole(plain) ?? return None
                if count < 1 -> return None
                return Val("{count * unit.bytes}")
            }
            None
        }
    }
}

TestSettingSizeUnit: struct {
    suffix: String
    bytes: Int
}

// Longest suffix first, so `gib` is not read as `b`.
TEST_SETTING_SIZE_UNITS: comptime { [TestSettingSizeUnit]{
    {suffix: "GiB", bytes: 1073741824}, {suffix: "gib", bytes: 1073741824}, {suffix: "GB", bytes: 1073741824}, {suffix: "gb", bytes: 1073741824},
    {suffix: "MiB", bytes: 1048576}, {suffix: "mib", bytes: 1048576}, {suffix: "MB", bytes: 1048576}, {suffix: "mb", bytes: 1048576},
    {suffix: "KiB", bytes: 1024}, {suffix: "kib", bytes: 1024}, {suffix: "KB", bytes: 1024}, {suffix: "kb", bytes: 1024},
    {suffix: "G", bytes: 1073741824}, {suffix: "g", bytes: 1073741824}, {suffix: "M", bytes: 1048576}, {suffix: "m", bytes: 1048576},
    {suffix: "K", bytes: 1024}, {suffix: "k", bytes: 1024}, {suffix: "B", bytes: 1}, {suffix: "b", bytes: 1},
} }

// A nonnegative decimal of at most nine digits.
test_setting_whole: fn(text: String) -> Int? Never! {
    if text == "" || text.bytes().len() > 9 -> return None
    loop byte in text.bytes() {
        code: Int.from_u8(byte)
        if code < 48 || code > 57 -> return None
    }
    Val(Int.parse(text) ?? return None)
}

// Writes `setting` into `settings`, replacing an earlier value of its row.
test_settings_put: fn(settings: &[TestSetting], setting: TestSetting) Never! {
    loop index in 0..<settings.len() {
        if settings[index].name == setting.name {
            settings[index] = setting
            return
        }
    }
    &settings.push(setting)
}

// `later` over `earlier`: every row `later` writes replaces the earlier value.
test_settings_layered: fn(earlier: [TestSetting], later: [TestSetting]) -> [TestSetting] Never! {
    // copy: `earlier` stays with the caller; the layered list owns its rows.
    merged := earlier.copy()
    loop setting in later -> test_settings_put(&merged, setting.copy())
    merged
}

test_settings_get: fn(settings: [TestSetting], name: String) -> String? Never! {
    loop setting in settings {
        if setting.name == name -> return Val(setting.value.copy())
    }
    None
}

// A Switch row's value; false when no layer wrote it.
test_settings_on: fn(settings: [TestSetting], name: String) -> Bool Never! {
    (test_settings_get(settings, name) ?? "false") == "true"
}

// The I and the N of the `shard` value, 1 and 1 when unsharded.
test_settings_shard_part: fn(settings: [TestSetting], part: Int) -> Int Never! {
    value: test_settings_get(settings, "shard") ?? return 1
    parts: value.split("/").to_list()
    if parts.len() != 2 -> return 1
    Int.parse(parts[part]) ?? 1
}

test_settings_shard_index: fn(settings: [TestSetting]) -> Int Never! { test_settings_shard_part(settings, 0) }

test_settings_shard_count: fn(settings: [TestSetting]) -> Int Never! { test_settings_shard_part(settings, 1) }

// The levels of the `optimize` value, in order; empty when unset.
test_settings_levels: fn(settings: [TestSetting]) -> [String] Never! {
    value: test_settings_get(settings, "optimize") ?? return [String]{}
    value.split(",").to_list()
}

// The `time_limit` value in milliseconds.
test_settings_time_limit_ms: fn(settings: [TestSetting]) -> Int? Never! {
    value: test_settings_get(settings, "time_limit") ?? return None
    Val(Int.parse(value.removesuffix("ms")) ?? return None)
}

// A Count or Size row's value as a number; 0 when no layer wrote it.
test_settings_number: fn(settings: [TestSetting], name: String) -> Int Never! {
    value: test_settings_get(settings, name) ?? return 0
    Int.parse(value) ?? 0
}

// The settings as `name<TAB>value<TAB>source` lines (TEST_SETTINGS_ENV), and
// back. The plan file's lines are `name<TAB>value`, each from the `source`
// the reader names; one the plan step wrote after `test: fn` called
// `t.run()` starts with TEST_SETTING_AFTER_RUN (JetRuntime TestSuite.jet).
test_settings_lines: fn(settings: [TestSetting]) -> String Never! {
    text := ""
    loop setting in settings -> text = "{text}{setting.name}\t{setting.value}\t{setting.source}\n"
    text
}

// The mark of a plan line whose `t.<name>(…)` call came after `t.run()`.
TEST_SETTING_AFTER_RUN: "!"

// The settings `text` holds; a line without its own source is from
// `source`. Err names the first line that is no setting, no value of its
// row, a row not ported yet, or a call after `t.run()`, as the
// `t.<name>(…)` call that wrote it.
test_settings_parse_lines: fn(text: String, source: String) -> [TestSetting] TestSettingError! {
    settings := [TestSetting]{}
    loop line in text.split("\n").to_list() {
        if line == "" -> next
        late: line.starts_with(TEST_SETTING_AFTER_RUN)
        parts: line.removeprefix(TEST_SETTING_AFTER_RUN).split("\t").to_list()
        row: test_setting_row(parts[0]) ?? return Err(TestSettingError{message: "`{parts[0]}` is not a `jet test` setting"})
        if late -> return Err(TestSettingError{message: "`t.{row.name}(…)` comes after `t.run()`, whose tests already ran without it"})
        raw: if parts.len() > 1 -> parts[1].copy() else -> ""
        value: test_setting_value(row, raw) ?? return Err(TestSettingError{message: "`t.{row.name}(…)` needs {test_setting_hint(row)}, not `{raw}`"})
        if !row.ported -> return Err(TestSettingError{message: "`t.{row.name}(…)` is not ported to the Jet test runner yet"})
        from: if parts.len() > 2 -> parts[2].copy() else -> source.copy()
        test_settings_put(&settings, TestSetting{name: row.name.copy(), value: value, source: from})
    }
    Ok(settings)
}

#Test("a test setting row is one flag, field and call name") {
    row: test_setting_row("update_snapshots") ?? panic("update_snapshots row")
    assert_eq(test_setting_flag(row.name), "--update-snapshots")
    assert_eq((test_setting_flag_row("-u") ?? panic("-u row")).name, "update_snapshots")
    assert_eq((test_setting_flag_row("--shard=3/8") ?? panic("shard row")).name, "shard")
    assert(test_setting_flag_row("--profile") == None)
    assert_eq(test_setting_spellings(test_setting_row("shard") ?? panic("shard row")), "--shard=3/8, `shard: 3/8`, `t.shard(3, 8)`")
}

#Test("test setting values are canonical or name what they need") {
    shard: test_setting_row("shard") ?? panic("shard row")
    assert_eq(test_setting_value(shard, " 3/8 ") ?? "", "3/8")
    assert(test_setting_value(shard, "0/8") == None)
    assert(test_setting_value(shard, "9/8") == None)
    assert_eq(test_setting_hint(shard), "I/N with 1 <= I <= N, such as `2/4`")
    assert_eq(test_setting_value(shard, "1/4097") ?? "refused", "refused")
    levels: test_setting_row("optimize") ?? panic("optimize row")
    assert_eq(test_setting_value(levels, "[none, full]") ?? "", "none,full")
    assert_eq(test_setting_value(levels, "[\"basic\"]") ?? "", "basic")
    assert_eq(test_setting_value(levels, "none,none") ?? "refused", "refused")
    limit: test_setting_row("time_limit") ?? panic("time_limit row")
    assert_eq(test_setting_value(limit, "2m") ?? "", "120000ms")
    assert_eq(test_setting_value(limit, "0s") ?? "refused", "refused")
    capture: test_setting_row("capture") ?? panic("capture row")
    assert_eq(test_setting_value(capture, "off") ?? "", "none")
    seed: test_setting_row("shuffle") ?? panic("shuffle row")
    assert_eq(test_setting_value(seed, "0") ?? "", "0")
    assert_eq(test_setting_value(seed, "-1") ?? "refused", "refused")
    memory: test_setting_row("memory") ?? panic("memory row")
    assert_eq(test_setting_value(memory, "16G") ?? "", "17179869184")
    assert_eq(test_setting_value(memory, "512mib") ?? "", "536870912")
    assert_eq(test_setting_value(memory, "lots") ?? "refused", "refused")
    assert_eq(test_setting_value(memory, "0gib") ?? "refused", "refused")
    grade: test_setting_row("grade") ?? panic("grade row")
    assert_eq(test_setting_value(grade, " generated ") ?? "", "generated")
    assert_eq(test_setting_value(grade, "fast") ?? "refused", "refused")
}

#Test("later test setting layers replace earlier values") {
    profile: [TestSetting]{TestSetting{name: "shard", value: "1/2", source: "profile `ci`"}, TestSetting{name: "serial", value: "true", source: "profile `ci`"}}
    code: test_settings_parse_lines("shard\t3/8\nresults\tr.json\n", "fn test") ?? panic(err.message)
    merged: test_settings_layered(profile, code)
    assert_eq(test_settings_shard_index(merged), 3)
    assert_eq(test_settings_shard_count(merged), 8)
    assert(test_settings_on(merged, "serial"))
    assert_eq(test_settings_get(merged, "results") ?? "", "r.json")
    assert_eq(test_settings_lines(merged), "shard\t3/8\tfn test\nserial\ttrue\tprofile `ci`\nresults\tr.json\tfn test\n")
    assert_eq((test_settings_parse_lines(test_settings_lines(merged), "flag") ?? panic(err.message))[1].source, "profile `ci`")
    assert_eq(test_settings_refusal("levels\t1\n"), "`levels` is not a `jet test` setting")
    assert_eq((test_settings_parse_lines("optimize\t[\"none\", \"full\"]\n", "fn test") ?? panic(err.message))[0].value, "none,full")
    assert_eq(test_settings_refusal("coverage\ttrue\n"), "`t.coverage(…)` is not ported to the Jet test runner yet")
    assert_eq(test_settings_refusal("shard\t9/8\n"), "`t.shard(…)` needs I/N with 1 <= I <= N, such as `2/4`, not `9/8`")
    assert_eq(test_settings_refusal("grade\tfast\n"), "`t.grade(…)` needs `generated`, not `fast`")
    assert_eq(test_settings_refusal("serial\ttrue\n!shard\t3/8\n"), "`t.shard(…)` comes after `t.run()`, whose tests already ran without it")
}

// Why `test: fn`'s plan lines `text` are refused, "" when they aren't.
test_settings_refusal: fn(text: String) -> String Never! {
    _: test_settings_parse_lines(text, "fn test") ?? return err.message
    ""
}
