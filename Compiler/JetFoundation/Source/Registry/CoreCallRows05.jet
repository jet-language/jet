        ("HTTPResponse", "timings") -> Type.List(Type.Int)
        ("HTTPResponse", "reused_connection") -> Type.Bool
        ("Headers", "first") -> Type.Option(Type.String)
        ("Headers", "all") -> Type.List(Type.String)
        ("Headers", "append" | "set") -> Type.Result(ok: Type.Named("Headers"), err: Type.Named("HTTPError"))
        ("Headers", "remove") -> Type.Named("Headers")
        ("HTTPMux", _) -> unit_type()
