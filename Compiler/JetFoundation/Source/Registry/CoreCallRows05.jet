        ("Body", "copy_to") -> Type.Result(ok: Type.Int, err: Type.Named("HTTPError"))
        ("HTTPServer", "local_addr") -> Type.Result(ok: Type.String, err: Type.Named("HTTPError"))
        ("HTTPServer", "serve" | "shutdown" | "wait") -> Type.Result(ok: Type.Named("HTTPShutdownReport"), err: Type.Named("HTTPError"))
        ("WsConn", "send_text" | "send_bytes" | "close") -> Type.Result(ok: unit_type(), err: Type.Named("WsError"))
