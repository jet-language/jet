        ("WsMessage", "bytes") -> Type.Result(ok: Type.List(Type.Named("U8")), err: Type.Named("WsError"))
        ("Browser", "abilities") -> Type.Named("BrowserAbilities")
        ("Browser", "context") -> Type.Result(ok: Type.Named("BrowserContext"), err: Type.Named("BrowserError"))
