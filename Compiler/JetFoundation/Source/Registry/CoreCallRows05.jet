// Called inside the existing reactive route's own frame after lowering receiver.
fn lower_reactive_method_tail(recv_t: TExpr, method: String, args: [CallArg], cx: Cx, env: &LowerEnv) -> TExpr Never! {
    elem :: if recv_t.ty == { .Apply(args, ..) -> args.first().cloned(), _ -> None }.unwrap_or_else(unit_type)
    (op, ty) :: if method == {
        "get" -> (THandleOp.ReactiveGet, ^elem)
        "set" -> (THandleOp.ReactiveSet, unit_type())
        _ -> { panic("is_reactive_method_name admitted only get/set") }
    }
    targs :: args.iter().map(fn(a) { lower_expr(a.expr, cx, &env) }).collect()
    TExpr(ty: ^ty, kind: TExprKind.HandleMethod(recv: ^recv_t, op: op, args: ^targs))
}
