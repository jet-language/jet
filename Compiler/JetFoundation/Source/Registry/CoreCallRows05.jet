        ("HTTPResponse", "header" | "raw_content_encoding") -> Type.Option(Type.String)
        ("HTTPResponse", "cookies" | "redirect_history") -> Type.List(Type.String)
        ("HTTPResponse", "trailers") -> Type.Result(ok: Type.Named("HTTPResponse"), err: Type.Named("HTTPError"))
