// Core records: compiler-defined Core types (the general `Err`, `IOError`,
// `IOContext`) that runtime routes carry as a handle to the runtime's own
// value. The native value keeps its IR layout, so constructors, matches
// and field reads stay native; a route boundary converts it member by member
// through the runtime's record exports:
//
//   jet_rt_record_tag_<R>(h) -> variant index          payload enum
//   jet_rt_record_get_<R>_<field>(h) -> carrier        struct field
//   jet_rt_record_get_<R>_<Variant>(h) -> carrier      Single payload
//   jet_rt_record_new_<R>(fields...) -> h              struct, schema order
//   jet_rt_record_new_<R>_<Variant>(payload) -> h      enum variant
//
// <R> is the runtime type of the type's handle row (RuntimeHandles.jet). A
// getter borrows `h` and returns an owned carrier; an Option getter returns its
// tag and writes the payload through one out pointer. A constructor borrows
// String handles and Option boxes of a String or Int (null is None; the payload
// is the box's first word) and takes nested record handles. A fieldless Core
// enum inside a record crosses as its variant index. The rows below have hand
// exports in the runtime (PluginError in JetRuntime PluginError.jet); every
// other record's schema is an IR_GENERATED_RECORDS row below. A
// hand row matches its type's bare handle row only, so a Core declaration
// with a hand row has no handle row under its canonical identity: that
// identity resolves to the bare row (ir_handle_runtime), and both spellings
// lay out alike. An identity row would carry no schema, and the identity
// spelling would become a runtime handle while the bare one stays laid out.
//
// These rows, the native type rows and ir_handle_laid_opaque are the layout
// facts of runtime handle rows: the IR lays a handle out by them, and sema
// reads the same facts to refuse rendering a value no tier can show.

// The shape the runtime's exports were written for. A Core definition of the
// same name with any other shape is not a record, so a changed Core type is
// reported at its route instead of being marshaled with stale offsets.
IRRecordSchema: struct {
    jet_name: String,
    // An enum's variant names in the runtime's order ("" for a struct).
    variants: String,
    // A struct's stored field names in constructor order ("" for an enum).
    fields: String,
}

IR_RECORD_SCHEMAS: #run { [IRRecordSchema]{
    {jet_name: "Err", variants: "", fields: "message,code,cause"},
    {jet_name: "IOContext", variants: "", fields: "operation,resource,os_code,cause"},
    {jet_name: "IOError", variants: "InvalidInput,NotFound,PermissionDenied,TimedOut,Canceled,Closed,Protocol,Other,ResourceLimit,AlreadyExists,Unsupported", fields: ""},
    {jet_name: "IOOperation", variants: "Read,Write,Flush,Connect,Accept,Close,Resolve,Codec", fields: ""},
    {jet_name: "PluginError", variants: "Guest,Denied,Budget,Defect", fields: ""},
    {jet_name: "ProcessResourceLimit", variants: "WallTime,CPUTime,Memory,OpenFiles,Output", fields: ""},
    {jet_name: "TaskFailure", variants: "Canceled,DeadlineBlown,Panicked", fields: ""},
} }

// A schema entry is `name` or, for a generated row, `name=kind`: the carrier
// the runtime's export reads or writes for that member.
ir_record_entry_name: fn(entry: String) -> String Never! { entry.split("=").to_list()[0] }

// The runtime ordinal of the schema variant `name` (its schema position).
ir_record_variant_position: fn(schema: IRRecordSchema, name: String) -> Int? Never! {
    loop (position, entry) in schema.variants.split(",").to_list() {
        if ir_record_entry_name(entry) == name -> return Val(position)
    }
    None
}

// ProcessReceipt168/ProcessPlan72 are Jet-owned carriers in pack and
// program builds alike (the IR makes the
// compiler-owned process records handles), the compiler-owned `Test` is
// the runtime's JetTestSuite snapshot (TestSuite.jet), and the compiler-owned
// `GameScene`/`GameFrame` are the runtime's game carriers (Game.jet).
// Validate canonical identity and actual member types before lending their
// storage to the typed read/clone glue.
ir_native_runtime_carrier: fn(handle: IRRuntimeHandle, name: String) -> Bool Never! {
    (handle.runtime == "ProcessReceipt" || handle.runtime == "ProcessPlan" || handle.runtime == "ProcessChild" || handle.runtime == "JetTestSuite" || handle.runtime == "JetGameScene" || handle.runtime == "JetGameFrame") && name == handle.jet_name
}

// Whether a value reached through runtime handle row `handle`, by the
// spelling `name` of a declaration keyed `key`, is laid out as the runtime's
// opaque handle rather than as the declaration's own shape: a Jet-owned
// carrier always is, and any other handle the declaration is `carried` by
// is unless a record schema, a native type row or a Core source declaration
// keeps its declared shape. The IR lays a handle out by this fact (its
// handle rows), and sema refuses to render a Core value it holds, since
// only the handle's own display, show or debug export can show it.
ir_handle_laid_opaque: fn(handle: IRRuntimeHandle, name: String, key: String, carried: Bool) -> Bool Never! {
    if ir_native_runtime_carrier(handle, name) -> return true
    owned_shape: ir_record_schema(handle) || ir_native_type(name) != None || core_source_owns_type(name) || (key != name && (ir_native_type(key) != None || core_source_owns_type(key)))
    carried && !owned_shape
}

// Whether a runtime handle row has a record schema: such a type keeps its
// declared layout and converts at a route boundary.
ir_record_schema: fn(handle: IRRuntimeHandle) -> Bool Never! {
    ir_record_schema_row(handle) != None
}

// The record schema of a runtime handle row: a IR_RECORD_SCHEMAS row by its
// Jet name, or a generated row keyed by its runtime type.
ir_record_schema_row: fn(handle: IRRuntimeHandle) -> IRRecordSchema? Never! {
    loop schema in IR_RECORD_SCHEMAS {
        // copy: the row stays in the global table, which can't be moved from.
        if schema.jet_name == handle.jet_name -> return Val(schema.copy())
    }
    loop schema in IR_GENERATED_RECORDS {
        if schema.jet_name == handle.runtime {
            return Val(IRRecordSchema{jet_name: handle.jet_name, variants: schema.variants, fields: schema.fields})
        }
    }
    None
}

// Candidate source identities; the backend validates against the actual native layout.
IRNativeType: struct {
    jet_name: String,
    declaration: String,
    arguments: String,
}

