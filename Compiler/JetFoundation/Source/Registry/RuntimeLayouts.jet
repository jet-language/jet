    IRRecordSchema{jet_name: "CoreVaultError", variants: "InvalidName,NotFound,WrongType,Revoked,Locked,AuthorityDenied,Conflict,UnsupportedProvider,InvalidEncoding,DurabilityUnknown,Crypto=Tag.CryptoError,IO=Text+Text,Internal=Text", fields: ""},
    IRRecordSchema{jet_name: "DataAuthority", variants: "", fields: "scope=Text,revision=Text"},
    IRRecordSchema{jet_name: "DataFormat", variants: "CSV,JSON,JSONL,Parquet,Arrow", fields: ""},
    IRRecordSchema{jet_name: "DataLimits", variants: "", fields: "encoding=Rec.EncodingLimits,max_groups=Int,max_sort_rows=Int,max_join_rows=Int,max_output_rows=Int"},
    IRRecordSchema{jet_name: "DataLoaderKind", variants: "File,URL,Database,Value", fields: ""},
