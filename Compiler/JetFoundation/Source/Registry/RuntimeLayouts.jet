ir_native_type_keys: fn() -> [String] Never! {
    loop row in IR_NATIVE_TYPES -> row.jet_name.copy()  // copy: the global native type table can't be moved from
}

IR_NATIVE_TYPE_KEY_ROWS: #run ir_key_index(ir_native_type_keys())

IR_NATIVE_TYPE_KEYS: #run ir_key_index_keys(ir_native_type_keys(), IR_NATIVE_TYPE_KEY_ROWS)

ir_native_type: fn(name: String) -> IRNativeType? {
    position: ir_key_row(IR_NATIVE_TYPE_KEYS, IR_NATIVE_TYPE_KEY_ROWS, name) ?? return None
    // copy: the caller gets an owned type row, while the row stays in the global IR_NATIVE_TYPES
    // table, which can't be moved from.
    Val(IR_NATIVE_TYPES[position].copy())
}

// Core records the runtime's generated record exports carry (Records.jet),
// keyed by runtime type: a struct's fields in constructor order or an enum's
// variants in index order, each `name=kind` when it carries a member (Text,
// Int, U64, Flag, Float, Tag.<enum>, Rec.<record>, Opt<kind>; a variant's
// named members joined by `+`). Every row is read: its key is a runtime
// handle row's runtime type or a route carrier's, or a member of another
// row; a Core type whose declaration moved to Core source keeps no row here.
IR_GENERATED_RECORDS: #run { [IRRecordSchema]{
    IRRecordSchema{jet_name: "AllocError", variants: "", fields: "requested_bytes=Int,allocator=Text"},
    IRRecordSchema{jet_name: "Closed", variants: "Closed", fields: ""},
