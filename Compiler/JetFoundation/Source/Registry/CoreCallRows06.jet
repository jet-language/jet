            return TExpr{ty: ^result_ty, kind: TExprKind.Ok(^plain)}
        }
        TExpr{ty: ^result_ty, kind: TExprKind.ClosureMethod{recv: ^recv_t, op: ^op, args: ^targs}}
    }))
}

