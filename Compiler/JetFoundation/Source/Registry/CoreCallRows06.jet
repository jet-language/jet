                    reduce_op :: if is_reduce -> Val(args.first().and_then(fn(arg) { reduce_op_name(arg.expr) }) ?? "Add") else -> None
                    value_args :: if is_reduce -> [TExpr]{} else -> (loop a in args -> lower_expr(a.expr, cx, &env))
                    ty :: if is_reduce -> math_scalar_ty(handle) else -> math_method_return(handle, method, args.len()) ?? unit_type()
                    TExpr{ty: ^ty, kind: TExprKind.HandleMethod{recv: ^recv_t, op: THandleOp.MathMethod{type_name: handle, method: method, reduce_op: reduce_op}, args: ^value_args}}
