                seed :: if op is .FloatAddParaFold{..} -> {
                    seed_ast :: args.first().and_then(fn(arg) { if arg.expr == { .Lambda(lam) -> is_pure_zero_arg_lambda(lam); else -> None } })
                    if seed_ast == Val(seed) -> lower_expr(seed, cx, &env) else -> lower_expr(args[0].expr, cx, &env)
