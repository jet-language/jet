// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:9253
fn lower_cell_receiver_methods(cell_receiver: String, recv_t: TExpr, method: String, args: [CallArg], resolved_ret: Type?, cx: Cx, env: &LowerEnv) -> TExpr? Never! {
    inner :: if recv_t.ty == { .Apply{args, ..} if !args.is_empty() -> ~args[0]; else -> Type.Int }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:9256
    if (cell_receiver == "CellReadGuard" || cell_receiver == "CellEditGuard") && ((method == "map" && args.len() == 1) || (method == "split" && args.len() == 2)) {
        return Val(in_own_frame(fn() {
            paths := [[String]].with_capacity(args.len())
            loop arg in args {
                lam :: if arg.expr == .Lambda(lam) -> lam else -> panic("sema requires projection lambdas for Cell guard map/split")
                path :: lam.meta.cell_projection_path.expect("sema records every Cell guard projection path")
                &paths.push(~path)
            }
            ty :: resolved_ret.expect("sema persists exact Cell guard projection return type")
            debug_assert(method != "split" || ty is .Tuple(_))
            TExpr{ty: ~ty, kind: TExprKind.HostCall(THostCall.CellGuardProject{recv: ^recv_t, paths: ^paths,
                result_ty: resolved_ret.expect("sema persists exact Cell guard projection return type"), editable: cell_receiver == "CellEditGuard",
                edit_paths_disjoint: cell_receiver == "CellEditGuard" && method == "split"})}
        }))
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:9293
    if (cell_receiver, method, args.len()) == {
        ("Cell", "get" | "guard_read" | "guard_edit", 0) | ("Cell", "set" | "replace", 1)
        | ("CellReadGuard" | "CellEditGuard", "get", 0) | ("CellEditGuard", "set", 1) -> {
            return Val(in_own_frame(fn() {
                ty :: resolved_ret ?? unit_type()
                targs :: loop arg in args -> lower_expr(arg.expr, cx, &env)
                TExpr{ty: ^ty, kind: TExprKind.HostCall(THostCall.Method{recv: ^recv_t, method: method, args: ^targs})}
            }))
        }
        else -> {}
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:9316
    if (if (cell_receiver, method) == {
        ("Cell", "read" | "edit") | ("CellReadGuard", "read") | ("CellEditGuard", "read" | "edit") -> true
        else -> false
    }) && args.len() == 1 {
        return Val(in_own_frame(fn() {
            lam :: if args[0].expr == .Lambda(lam) -> lam else -> panic("sema requires a lambda for Cell read/edit")
            expected :: [Type]{~inner}
            lowered :: lower_lambda_expecting_host_borrow(lam, cx, env, expected, method == "edit")
            ty :: resolved_ret ?? lambda_body_ty_expecting(lam, cx, env, Val(expected))
            TExpr{ty: ~ty, kind: TExprKind.HostCall(THostCall.Method{recv: ^recv_t, method: method,
                args: [TExpr]{TExpr{ty: Type.Fn{params: [Type]{^inner}, ret: Val(^ty), effect_bound: None,
                    param_contract: None, call_metadata: None, return_view_provenance: None}, kind: TExprKind.Lambda(^lowered)}}})}
        }))
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:9354
    if cell_receiver == "Cell" && method == "get_or_set" && args.len() == 1 {
        return Val(in_own_frame(fn() {
            lam :: if args[0].expr == .Lambda(lam) -> lam else -> panic("sema requires a lambda for Cell.get_or_set")
            value_ty :: resolved_ret ?? (if inner == { .Option(value) -> value; else -> inner })
            lowered :: lower_lambda(lam, cx, env)
            TExpr{ty: ~value_ty, kind: TExprKind.HostCall(THostCall.Method{recv: ^recv_t, method: method,
                args: [TExpr]{TExpr{ty: Type.Fn{params: [], ret: Val(~value_ty), effect_bound: None,
                    param_contract: None, call_metadata: None, return_view_provenance: None}, kind: TExprKind.Lambda(^lowered)}}})}
        }))
    }
    None
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:9385
fn lower_expiring_secret_with(receiver: Expr, recv_peek: Type?, method: String, args: [CallArg], resolved_ret: Type?, is_expiring_secret: Bool, cx: Cx, env: &LowerEnv) -> TExpr? Never! {
    if !is_expiring_secret || method != "with" || args.len() != 1 -> return None
    Val(in_own_frame(fn() {
        recv_shape := recv_peek
        loop { if recv_shape == Val(.Tagged{inner, ..}) -> recv_shape = Val(inner) else -> break }
        inner :: if recv_shape == { Val(.Apply{name, args}) if name == "ExpiringSecret" && !args.is_empty() -> ~args[0]; else -> Type.Int }
        recv_t :: lower_expr(receiver, cx, env)
        lam :: if args[0].expr == .Lambda(lam) -> lam else -> panic("sema requires a lambda for ExpiringSecret.with")
        expected :: [Type]{~inner}
        tl :: lower_lambda_expecting_host_borrow(lam, cx, env, expected, false)
        ty :: resolved_ret ?? Type.Result{ok: lambda_body_ty_expecting(lam, cx, env, Val(expected)), err: Type.Named("Expired")}
        TExpr{ty: ^ty, kind: TExprKind.HostCall(THostCall.Method{recv: ^recv_t, method: "with",
            args: [TExpr]{TExpr{ty: Type.Fn{params: [Type]{^inner}, ret: None, effect_bound: None,
                return_view_provenance: None, param_contract: None, call_metadata: None}, kind: TExprKind.Lambda(^tl)}}})}
    }))
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:9430
fn lower_collection_receiver_method(receiver: Expr, method: String, method_span: Span, args: [CallArg], recv_type: String?, resolved_ret: Type?, cx: Cx, env: &LowerEnv, lowered_receiver: &TExpr?) -> TExpr? Never! {
    checked_list_receiver :: tir_recv_jet_ty(receiver, env).or_else(fn() { lowered_receiver.map(fn(recv) { ~recv.ty }) }).is_some_and(fn(ty) { ty is .List(_) || ty is .FixedList{..} })
