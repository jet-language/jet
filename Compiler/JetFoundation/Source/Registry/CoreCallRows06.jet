        callback_uses_effective_carrier :: if op == { .TryMap | .TryFilter | .TrySortBy | .TrySortByDesc | .EachRef -> true; else -> false }
        if callback_uses_effective_carrier {
            if lower_named_collection_callback(args[0].expr, cx, env, true, callback_params) == Val(callback) && !targs.is_empty() -> targs[0] = ^callback
        } else {
            loop arg in &targs -> name_plain_callback_return(&arg)
        }
        callback_error :: targs.first().and_then(fn(callback) { if callback.ty == {
            .Fn{ret: Val(.Result{err, ..}), ..} -> Val(~err)
            else -> None
        } })
        result_ty :: if callback_uses_effective_carrier && !(source_result_ty is .Result{..}) ->
            callback_error.map(fn(err) { Type.Result{ok: ~source_result_ty, err: ^err} }) ?? ^source_result_ty
            else -> ^source_result_ty
