            }
        }
        // Host callbacks lend inputs once, including scalar and literal-list inputs.
        callback_recv_ty :: if recv_ty == { .FixedList{elem, ..} -> Type.List(~elem); else -> ~recv_ty }
        callback_params := builtin_method_arg_types(callback_recv_ty, method).and_then(fn(types) {
            types.find_map(fn(ty) { if ty == { .Fn{params, ..} -> Val(params); else -> None } })
        })
        if method == "sort_by" && args.first().is_some_and(fn(arg) { if arg.expr == { .Lambda(lam) -> lam.params.len() == 2; else -> false } }) {
            if callback_recv_ty == { .List(inner) | .FixedList{elem: inner, ..} -> callback_params = Val([Type]{~inner, ~inner}); else -> {} }
        }
        if method == "reduce" || method == "fold" || method == "scan" {
            if args.first() == Val(arg) {
