        use_last :: method == "reduce" || method == "fold" || method == "scan" || method == "para_fold"
        callback_arg :: if use_last -> args.last() else -> args.first()
        callback_targ :: if use_last -> targs.last() else -> targs.first()
        callback_needs_fn_mut :: if callback_arg.map(fn(arg) { arg.expr }) == {
            Val(.Lambda(lam)) -> Val(lam.meta.needs_fn_mut)
