            }
            Val([[Type]]{[], [Type]{~acc, ^item}, [Type]{~acc, ^acc}})
        } else -> None
        para_map_callback_return :: if method == "para_map" -> (if source_result_ty == { .List(inner) | .FixedList{elem: inner, ..} -> Val(~inner); else -> None }) else -> None
        targs := loop (index, a) in args.enumerate() {
