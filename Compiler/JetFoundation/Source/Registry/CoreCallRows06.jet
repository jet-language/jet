                if callback_params.as_mut() == Val(params) && !params.is_empty() -> params[0] = ^seed_ty
            }
        }
        para_fold_params :: if method == "para_fold" -> {
            acc :: resolved_ret ?? return invariant_method_expr(method_span, "para_fold without a resolved accumulator type")
            item :: if recv_ty == {
