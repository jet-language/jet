        source_result_ty :: resolved_ret.or_else(fn() { builtin_method_return(recv_ty, method, args.len(), false).map(fn(ty) { ty ?? unit_type() }) })
            ?? return invariant_method_expr(method_span, "closure method without a checked return type")
        if fixed_float_add_receiver {
