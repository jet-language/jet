// The public metadata contract: every fact, operation, phase and failure of
// compile-time preparation, reflection, publishing and advanced program
// control, each with the card that delivers it and the test that witnesses
// its behavior. A Built row's witness is a test file in the repository that
// passes today; an Owed row names the witness its delivery card will add.
// Tests/MetadataContract.jet checks every row.

MetadataSurface: enum { Preparation Reflection Publishing Control }

MetadataItemKind: enum { Fact Operation Phase Failure }

MetadataDelivery: enum { Built Owed }

MetadataContractRow: struct {
    // The public spelling, as a program writes it.
    spelling: String
    kind: MetadataItemKind
    surface: MetadataSurface
    // The card that delivers the row, `#N`.
    owner: String
    // Built: the repository path of the passing witness. Owed: the witness
    // the owner card names.
    witness: String
    delivery: MetadataDelivery
}

