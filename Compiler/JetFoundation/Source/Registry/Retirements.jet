// Rust: retirement/rename_target/retired_core_module.
pub fn retirement(id: String) -> Retirement? Never! {
    loop row in RETIREMENTS { if row.id == id -> return Val(row) }
    None
}
pub fn rename_target(retired: String) -> String? Never! {
    loop row in RETIREMENTS { if row.kind == .Rename && row.retired == retired -> return Val(row.canonical) }
    None
}
pub fn retired_core_module(name: String) -> Retirement? Never! {
    found := Retirement?{None}
    best := -1
    loop row in RETIREMENTS {
        if row.kind != .Semantic || row.code != (Val("E1001")) -> next
        prefix :: "{row.retired}."
        if (row.retired == name || name.starts_with(prefix)) && row.retired.len() > best {
            best = row.retired.len()
            found = Val(row)
        }
    }
    found
}
pub fn retired_core_module_diagnostic(name: String, span: Span) -> Diagnostic? Never! {
    row :: retired_core_module(name) ?? return None
    Val(diagnostic_from_registry("E1001", Val(span), "core module `{name}` was retired", "{row.decision} removed this free namespace; the canonical home is {row.canonical}", "use one of: {row.canonical}"))
}
// Rust: law_violations_of. Keep source-order error text, including duplicates.
pub fn retirement_law_violations() -> [String] Never! { retirement_law_violations_of(RETIREMENTS) }
pub fn retirement_law_violations_of(rows: [Retirement]) -> [String] Never! {
    out := [String]{}
    loop index in 0..<rows.len() {
        row :: rows[index]
        if row.retired == "" || row.canonical == "" -> &out.push("{row.id}: a row names an empty spelling")
        if row.retired == row.canonical -> &out.push("{row.id}: retires the form it names as canonical")
        if row.decision == "" -> &out.push("{row.id}: names no decision")
        hyphens := 0
        loop byte in row.since.bytes() { if byte == (U8{45}) -> hyphens += 1 }
        if row.since.bytes().len() != 10 || hyphens != 2 -> &out.push("{row.id}: `{row.since}` is not a YYYY-MM-DD date")
        if row.kind == .Rename {
            if row.code == .Val(code) -> &out.push("{row.id}: a rename rewrites and refuses nothing, so it must name no code (`{code}`)")
        } else {
            if row.code == .Val(code) {
                bytes :: code.bytes()
                registered := bytes.len() == 5 && bytes[0] == U8{69}
                loop position in 1..<bytes.len() { if bytes[position] < (U8{48}) || bytes[position] > (U8{57}) -> registered = false }
                if !registered -> &out.push("{row.id}: `{code}` is not a registered code")
            } else { &out.push("{row.id}: a semantic change is refused, so it must name its code") }
        }
        loop other in index + 1..<rows.len() {
            if rows[other].id == row.id -> &out.push("{row.id}: two rows claim this id")
            if rows[other].retired == row.retired -> &out.push("{row.id}: `{row.retired}` is retired twice, so the two rows can disagree")
        }
    }
    out
}
