    retirement_rename("jet-time-format", "jet.time.format", "DateTime.format_rfc3339()", "D-ONCE-LAYER1", "2026-08-08"),
    retirement_semantic("operator-plus-plus", "++", "x += 1", "D-INCR1", "2026-09-28", "E0160"),
    retirement_semantic("operator-minus-minus", "--", "x -= 1", "D-INCR1", "2026-09-28", "E0160"),
