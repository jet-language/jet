// Rust: Syntax/retirements.rs. Ratified retirement data, not compatibility.
pub enum RetirementKind { Rename Semantic }
pub struct Retirement {
    pub id: String
    pub retired: String
    pub canonical: String
    pub kind: RetirementKind
    pub decision: String
    pub since: String
    pub code: String?
}
fn retirement_rename(id: String, retired: String, canonical: String, decision: String, since: String) -> Retirement Never! {
    Retirement{id: id, retired: retired, canonical: canonical, kind: .Rename, decision: decision, since: since, code: None}
}
fn retirement_semantic(id: String, retired: String, canonical: String, decision: String, since: String, code: String) -> Retirement Never! {
    Retirement{id: id, retired: retired, canonical: canonical, kind: .Semantic, decision: decision, since: since, code: Val(code)}
}
fn retirement_ffi(id: String, retired: String) -> Retirement Never! {
    retirement_semantic("effect-flat-ffi-{id}", retired, "FFI.{retired}", "D-AUTHORITY-ROOTS1=A", "2026-08-06", "E0119")
}
fn retirement_core(id: String, retired: String, canonical: String) -> Retirement Never! {
    retirement_semantic("core-namespace-{id}", retired, canonical, "D-CORE-TREE1=A", "2026-08-06", "E1001")
}
