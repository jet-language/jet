    retirement_semantic("comptime-constant-mark", "@NAME :: value", "NAME :: prep {{ value }}", "D-PREP-SURFACE2=A", "2026-09-30", "E0388"),
    retirement_semantic("template-name-splice-mark", "fn @method / self.@field / .@left", "fn $method / self.$field / .$left", "D-NAME-SPLICE1=B", "2026-09-30", "E0388"),
