// Canonical typed source-call contracts shared by source sema and the
// Core-call registry. These rows mirror the native Core signature authority;
// an absent row is deliberately uncovered rather than inferred from arity.

// The one argument default a typed Core parameter carries: the parameter's
// struct type built from its declared field defaults.
CoreCallDefault: enum {
    FieldDefaults,
}

CoreCallTypeConstraint: enum {
    Any,
    Floating,
    FloatingOrExact,
    SquareRootInput,
    VaultKey,
}

CoreCallResultRule: enum {
    Declared,
    FloatIfExactElseParameter(parameter_index: Int),
}

CoreCallTypedParameter: struct {
    name: String,
    label: String,
    zone: ParamZone,
    access: AccessConvention,
    ty: Type,
    default: CoreCallDefault?,
}

CoreCallTypeParameter: struct {
    name: String,
    bounds: [String],
    constraint: CoreCallTypeConstraint,
}

CoreTypedCallSignature: struct {
    module_name: String,
    member: String,
    min_arity: Int,
    max_arity: Int,
    parameters: [CoreCallTypedParameter],
    return_type: Type?,
    type_parameters: [CoreCallTypeParameter],
    result_rule: CoreCallResultRule,
    // A labeled tuple return's labels, or a Result return's labeled tuple
    // error's labels, in the native kernel's declared slot order (the order
    // `return_type` writes them in); empty for every other return.
    native_return_labels: [String],
}

CoreCallSignatureRequest: struct {
    module_name: String,
    member: String,
    actual_arity: Int,
    actual_accesses: [AccessConvention],
    type_args: [Type],
}

CoreCallLabelRequirement: struct {
    argument_index: Int,
    label: String,
}

core_sig_parameter: fn(name: String, label: String, zone: ParamZone, access: AccessConvention, ty: Type, default: CoreCallDefault?) -> CoreCallTypedParameter Never! {
    CoreCallTypedParameter{name: name, label: label, zone: zone, access: access, ty: ty, default: default}
}

core_sig_positional: fn(ty: Type, access: AccessConvention) -> CoreCallTypedParameter Never! {
    core_sig_parameter("", "", ParamZone.PositionalOnly, access, ty, None)
}

core_sig_param_type: fn(name: String, label: String, zone: ParamZone, ty: Type) -> CoreCallTypedParameter Never! {
    core_sig_parameter(name, label, zone, AccessConvention.Read, ty, None)
}

core_sig_type_parameter: fn(name: String, constraint: CoreCallTypeConstraint) -> CoreCallTypeParameter Never! {
    CoreCallTypeParameter{name: name, bounds: [String]{}, constraint: constraint}
}

core_sig: fn(module_name: String, member: String, parameters: [CoreCallTypedParameter], return_type: Type?) -> CoreTypedCallSignature Never! {
    CoreTypedCallSignature{
        module_name: module_name,
        member: member,
        min_arity: parameters.len(),
        max_arity: parameters.len(),
        parameters: parameters,
        return_type: return_type,
        type_parameters: [CoreCallTypeParameter]{},
        result_rule: CoreCallResultRule.Declared,
        native_return_labels: [String]{},
    }
}

core_sig_result: fn(ok: Type, err: Type) -> Type Never! { Type.Result{ok: ok, err: err} }

core_sig_named: fn(name: String) -> Type Never! { foundation_named_type(name) }

core_sig_one_of: fn(value: String, choices: [String]) -> Bool Never! {
    loop choice in choices {
        if value == choice -> return true
    }
    false
}

core_sig_apply: fn(name: String, arg: Type) -> Type Never! {
    Type.Apply{name: name, args: [Type]{arg}}
}

core_sig_generic: fn(module_name: String, member: String, parameters: [CoreCallTypedParameter], return_type: Type?, type_parameter: CoreCallTypeParameter) -> CoreTypedCallSignature Never! {
    signature := core_sig(module_name, member, parameters, return_type)
    signature.type_parameters = [CoreCallTypeParameter]{type_parameter}
    signature
}

core_sig_generic_with_result_rule: fn(module_name: String, member: String, parameters: [CoreCallTypedParameter], return_type: Type?, type_parameter: CoreCallTypeParameter, result_rule: CoreCallResultRule) -> CoreTypedCallSignature Never! {
    signature := core_sig_generic(module_name, member, parameters, return_type, type_parameter)
    signature.result_rule = result_rule
    signature
}

core_sig_math_fixed: fn(module_name: String, member: String) -> CoreTypedCallSignature? {
    if module_name != "core.math" -> return None
    read: AccessConvention.Read
    if member == "fabs" {
        return Val(core_sig(module_name, member, [CoreCallTypedParameter]{core_sig_positional(Type.Float, read)}, Val(Type.Float)))
    }
    if member == "decimal" {
        return Val(core_sig(module_name, member, [CoreCallTypedParameter]{core_sig_positional(Type.String, read)}, Val(core_sig_named("Decimal"))))
    }
    if member == "fraction" {
        return Val(core_sig(module_name, member, [CoreCallTypedParameter]{core_sig_positional(Type.Int, read), core_sig_positional(Type.Int, read)}, Val(Type.Option{inner: core_sig_named("Fraction")})))
    }
    None
}

core_sig_numeric_or_default: fn(module_name: String, member: String) -> CoreTypedCallSignature? {
    read: AccessConvention.Read
    integer: Type.Int
    float: Type.Float
    t: core_sig_named("T")
    if module_name != "core.math" -> return None
    if member == "sqrt" {
        return Val(core_sig_generic_with_result_rule(
            module_name,
            member,
            [CoreCallTypedParameter]{core_sig_positional(t, read)},
            Val(t),
            core_sig_type_parameter("T", CoreCallTypeConstraint.SquareRootInput),
            CoreCallResultRule.FloatIfExactElseParameter{parameter_index: 0},
        ))
    }
    if core_sig_one_of(member, [String]{"floor", "ceil", "trunc", "truncate"}) {
        return Val(core_sig_generic(
            module_name,
            member,
            [CoreCallTypedParameter]{core_sig_positional(t, read)},
            Val(t),
            core_sig_type_parameter("T", CoreCallTypeConstraint.Floating),
        ))
    }
    if member == "to_bits" {
        return Val(core_sig(module_name, member, [CoreCallTypedParameter]{core_sig_positional(Type.Union{members: [Type]{float, Type.Float32}}, read)}, Val(integer)))
    }
    if member == "from_bits" {
        return Val(core_sig(module_name, member, [CoreCallTypedParameter]{core_sig_positional(integer, read)}, Val(float)))
    }
    // Core-private binary32 bit copies behind core.math's F32 to_bits/from_bits.
    if member == "__to_bits_f32" {
        return Val(core_sig(module_name, member, [CoreCallTypedParameter]{core_sig_positional(Type.Float32, read)}, Val(integer)))
    }
    if member == "__from_bits_f32" {
        return Val(core_sig(module_name, member, [CoreCallTypedParameter]{core_sig_positional(integer, read)}, Val(Type.Float32)))
    }
    if member == "cmp" {
        return Val(core_sig_generic(module_name, member, [CoreCallTypedParameter]{core_sig_positional(t, read), core_sig_positional(t, read)}, Val(integer), core_sig_type_parameter("T", CoreCallTypeConstraint.Floating)))
    }
    if core_sig_one_of(member, [String]{"fma", "muladd"}) {
        return Val(core_sig_generic_with_result_rule(
            module_name,
            member,
            [CoreCallTypedParameter]{core_sig_positional(t, read), core_sig_positional(t, read), core_sig_positional(t, read)},
            Val(t),
            core_sig_type_parameter("T", CoreCallTypeConstraint.FloatingOrExact),
            CoreCallResultRule.FloatIfExactElseParameter{parameter_index: 0},
        ))
    }
    if member == "fmod" {
        return Val(core_sig(module_name, member, [CoreCallTypedParameter]{core_sig_positional(float, read), core_sig_positional(float, read)}, Val(float)))
    }
    if core_sig_one_of(member, [String]{"is_nan", "is_inf", "is_finite"}) {
        return Val(core_sig_generic(module_name, member, [CoreCallTypedParameter]{core_sig_positional(t, read)}, Val(Type.Bool), core_sig_type_parameter("T", CoreCallTypeConstraint.Floating)))
    }
    None
}

core_sig_network: fn(request: CoreCallSignatureRequest) -> CoreTypedCallSignature? {
    read: AccessConvention.Read
    if request.module_name == "core.net.tls" && request.member == "client" && request.actual_arity == 2 {
        if request.actual_accesses.len() > 0 && request.actual_accesses[0] == AccessConvention.Move {
            return Val(core_sig(
                request.module_name,
                request.member,
                [CoreCallTypedParameter]{
                    core_sig_positional(core_sig_named("TCPStream"), AccessConvention.Move),
                    core_sig_positional(Type.String, read),
                },
                Val(core_sig_result(core_sig_named("TLSStream"), core_sig_named("IOError"))),
            ))
        }
        return Val(core_sig(
            request.module_name,
            request.member,
            [CoreCallTypedParameter]{
                core_sig_positional(Type.String, read),
                core_sig_positional(Type.Int, read),
            },
            Val(core_sig_result(core_sig_named("TLSStream"), core_sig_named("IOError"))),
        ))
    }
    if request.module_name == "core.net.tls" && request.member == "client" && (request.actual_arity == 3 || request.actual_arity == 4) {
        parameters := [CoreCallTypedParameter]{
            core_sig_positional(core_sig_named("TCPStream"), AccessConvention.Move),
            core_sig_param_type("server_name", "server_name", ParamZone.LabelOnly, Type.String),
        }
        if request.actual_arity == 4 {
            parameters.push(core_sig_param_type("config", "config", ParamZone.LabelOnly, core_sig_named("ClientConfig")))
        }
        parameters.push(core_sig_param_type("deadline", "deadline", ParamZone.LabelOnly, core_sig_named("Duration")))
        return Val(core_sig(request.module_name, request.member, parameters, Val(core_sig_result(core_sig_named("TLSStream"), core_sig_named("NetError")))))
    }
    if request.module_name == "core.net" && request.member == "unix_connect" && (request.actual_arity == 1 || request.actual_arity == 2) {
        parameters := [CoreCallTypedParameter]{core_sig_positional(Type.String, read)}
        if request.actual_arity == 2 {
            parameters.push(core_sig_param_type("deadline", "deadline", ParamZone.LabelOnly, core_sig_named("Duration")))
        }
        return Val(core_sig(request.module_name, request.member, parameters, Val(core_sig_result(core_sig_named("UnixStream"), core_sig_named("NetError")))))
    }
    None
}

// `core.crypto.vault.current(name)`: the newest key reference of one sealed
// vault key type `T` (SigningKey or X25519SecretKey; a generic body defers
// the bound to monomorphization), or None.
core_sig_vault: fn(module_name: String, member: String) -> CoreTypedCallSignature? {
    if module_name != "core.crypto.vault" || member != "current" -> return None
    key_ref: core_sig_apply("KeyRef", core_sig_named("T"))
    parameters: [CoreCallTypedParameter]{core_sig_positional(Type.String, AccessConvention.Read)}
    Val(core_sig_generic(module_name, member, parameters, Val(core_sig_result(Type.Option{inner: key_ref}, core_sig_named("VaultError"))), core_sig_type_parameter("T", CoreCallTypeConstraint.VaultKey)))
}

// `core.plugin.load(path, authority, limits:)`. The limits name Core's
// plugin `Limits` by its canonical identity, so a program's own `Limits` or
// `core.image`'s never stands in, and an absent label builds it from its
// declared field defaults.
core_sig_plugin_load: fn(module_name: String, member: String) -> CoreTypedCallSignature? {
    if module_name != "core.plugin" || member != "load" -> return None
    read: AccessConvention.Read
    limits: Type.Named{name: "<corelib>/core.plugin.Limits"}
    parameters := [CoreCallTypedParameter]{
        core_sig_positional(Type.String, read),
        core_sig_positional(core_sig_named("Authority"), read),
        core_sig_parameter("limits", "limits", ParamZone.LabelOnly, read, limits, Val(CoreCallDefault.FieldDefaults)),
    }
    signature := core_sig(module_name, member, parameters, Val(core_sig_named("Plugin")))
    signature.min_arity = 2
    Val(signature)
}

core_sig_fixed: fn(request: CoreCallSignatureRequest) -> CoreTypedCallSignature? {
    if core_sig_vault(request.module_name, request.member) == Val(vault) -> return Val(vault)
    if core_sig_network(request) == Val(network) -> return Val(network)
    if core_sig_math_fixed(request.module_name, request.member) == Val(math_fixed) {
        return Val(math_fixed)
    }
    if core_sig_numeric_or_default(request.module_name, request.member) == Val(numeric) {
        return Val(numeric)
    }
    if core_host_fixed_signature(request.module_name, request.member) == Val(host) {
        return Val(host)
    }
    if core_sig_plugin_load(request.module_name, request.member) == Val(plugin) {
        return Val(plugin)
    }
    core_platform_fixed_signature(request.module_name, request.member)
}

core_call_typed_signature_for: fn(request: CoreCallSignatureRequest) -> CoreTypedCallSignature? {
    row: core_call(request.module_name, request.member) ?? return None
    if !core_call_coverage_contains(row.coverage, CORE_CALL_COVERAGE_SEMA) -> return None
    resolved_signature: core_sig_fixed(request) ?? return None
    if resolved_signature.module_name != request.module_name || resolved_signature.member != request.member {
        return None
    }
    if request.type_args.len() > 0 && request.type_args.len() != resolved_signature.type_parameters.len() {
        return None
    }
    if request.actual_arity < resolved_signature.min_arity || request.actual_arity > resolved_signature.max_arity {
        return None
    }
    Val(resolved_signature)
}

core_call_typed_signature: fn(module_name: String, member: String, actual_arity: Int) -> CoreTypedCallSignature? {
    core_call_typed_signature_for(
        CoreCallSignatureRequest{
            module_name: module_name,
            member: member,
            actual_arity: actual_arity,
            actual_accesses: [AccessConvention]{},
            type_args: [Type]{},
        },
    )
}

// The native return of a labeled tuple: the labels in the kernel's declared
// slot order, so a native route maps each checked tuple member to the kernel
// slot of the same label. Empty when the fixed signature has no labeled tuple
// return.
core_call_native_return_labels: fn(module_name: String, member: String) -> [String] Never! {
    request: CoreCallSignatureRequest{module_name: module_name, member: member, actual_arity: 0, actual_accesses: [AccessConvention]{}, type_args: [Type]{}}
    signature: core_sig_fixed(request) ?? return [String]{}
    if signature.module_name != module_name || signature.member != member -> return [String]{}
    signature.native_return_labels
}
