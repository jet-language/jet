// The typed call contracts of the Core calls no Core declaration types: the
// compiler-owned plugin handle's `plugin.load`, the arity-picked network
// forms of `tls.client` and `net.unix_connect`, and the compiler's raw
// spelling of `files.open_nonblocking`. Every other Core row's call is
// checked against its Core declaration (sema_call_core_check_fixed_record).

// The one argument default a typed Core parameter carries: the parameter's
// struct type built from its declared field defaults.
CoreCallDefault: enum {
    FieldDefaults,
}

CoreCallTypedParameter: struct {
    name: String,
    label: String,
    zone: ParamZone,
    access: AccessConvention,
    ty: Type,
    default: CoreCallDefault?,
}

// A Core call's unbounded type parameter, bound by name.
CoreCallTypeParameter: struct {
    name: String,
}

CoreTypedCallSignature: struct {
    module_name: String,
    member: String,
    min_arity: Int,
    max_arity: Int,
    parameters: [CoreCallTypedParameter],
    return_type: Type?,
    type_parameters: [CoreCallTypeParameter],
}

CoreCallSignatureRequest: struct {
    module_name: String,
    member: String,
    actual_arity: Int,
    actual_accesses: [AccessConvention],
    type_args: [Type],
}

core_sig_parameter: fn(name: String, label: String, zone: ParamZone, access: AccessConvention, ty: Type, default: CoreCallDefault?) -> CoreCallTypedParameter Never! {
    CoreCallTypedParameter{name: name, label: label, zone: zone, access: access, ty: ty, default: default}
}

core_sig_positional: fn(ty: Type, access: AccessConvention) -> CoreCallTypedParameter Never! {
    core_sig_parameter("", "", ParamZone.PositionalOnly, access, ty, None)
}

core_sig_param_type: fn(name: String, label: String, zone: ParamZone, ty: Type) -> CoreCallTypedParameter Never! {
    core_sig_parameter(name, label, zone, AccessConvention.Read, ty, None)
}

core_sig: fn(module_name: String, member: String, parameters: [CoreCallTypedParameter], return_type: Type?) -> CoreTypedCallSignature Never! {
    CoreTypedCallSignature{
        module_name: module_name,
        member: member,
        min_arity: parameters.len(),
        max_arity: parameters.len(),
        parameters: parameters,
        return_type: return_type,
        type_parameters: [CoreCallTypeParameter]{},
    }
}

core_sig_result: fn(ok: Type, err: Type) -> Type Never! { Type.Result{ok: ok, err: err} }

core_sig_named: fn(name: String) -> Type Never! { foundation_named_type(name) }

core_sig_network: fn(request: CoreCallSignatureRequest) -> CoreTypedCallSignature? {
    read: AccessConvention.Read
    if request.module_name == "core.net.tls" && request.member == "client" && request.actual_arity == 2 {
        if request.actual_accesses.len() > 0 && request.actual_accesses[0] == AccessConvention.Move {
            return Val(core_sig(
                request.module_name,
                request.member,
                [CoreCallTypedParameter]{
                    core_sig_positional(core_sig_named("TCPStream"), AccessConvention.Move),
                    core_sig_positional(Type.String, read),
                },
                Val(core_sig_result(core_sig_named("TLSStream"), core_sig_named("IOError"))),
            ))
        }
        return Val(core_sig(
            request.module_name,
            request.member,
            [CoreCallTypedParameter]{
                core_sig_positional(Type.String, read),
                core_sig_positional(Type.Int, read),
            },
            Val(core_sig_result(core_sig_named("TLSStream"), core_sig_named("IOError"))),
        ))
    }
    if request.module_name == "core.net.tls" && request.member == "client" && (request.actual_arity == 3 || request.actual_arity == 4) {
        parameters := [CoreCallTypedParameter]{
            core_sig_positional(core_sig_named("TCPStream"), AccessConvention.Move),
            core_sig_param_type("server_name", "server_name", ParamZone.LabelOnly, Type.String),
        }
        if request.actual_arity == 4 {
            parameters.push(core_sig_param_type("config", "config", ParamZone.LabelOnly, core_sig_named("ClientConfig")))
        }
        parameters.push(core_sig_param_type("deadline", "deadline", ParamZone.LabelOnly, core_sig_named("Duration")))
        return Val(core_sig(request.module_name, request.member, parameters, Val(core_sig_result(core_sig_named("TLSStream"), core_sig_named("NetError")))))
    }
    if request.module_name == "core.net" && request.member == "unix_connect" && (request.actual_arity == 1 || request.actual_arity == 2) {
        parameters := [CoreCallTypedParameter]{core_sig_positional(Type.String, read)}
        if request.actual_arity == 2 {
            parameters.push(core_sig_param_type("deadline", "deadline", ParamZone.LabelOnly, core_sig_named("Duration")))
        }
        return Val(core_sig(request.module_name, request.member, parameters, Val(core_sig_result(core_sig_named("UnixStream"), core_sig_named("NetError")))))
    }
    None
}

// `plugin.load(path, authority, limits: …)`: its result is the
// compiler-owned `Plugin` handle (sema types it from the loaded artifact),
// which no Core declaration can spell; `limits:` may be left out, its
// Limits then built from the struct's field defaults.
core_sig_plugin_load: fn(request: CoreCallSignatureRequest) -> CoreTypedCallSignature? {
    if request.module_name != "core.plugin" || request.member != "load" -> return None
    parameters: [CoreCallTypedParameter]{
        core_sig_positional(Type.String, AccessConvention.Read),
        core_sig_positional(Type.Named{name: "Authority"}, AccessConvention.Read),
        core_sig_parameter("limits", "limits", ParamZone.LabelOnly, AccessConvention.Read, Type.Named{name: "<corelib>/core.plugin.Limits"}, Val(CoreCallDefault.FieldDefaults)),
    }
    signature := core_sig(request.module_name, request.member, parameters, Val(Type.Named{name: "Plugin"}))
    signature.min_arity = 2
    Val(signature)
}

// `files.jet_std_files_open_reader_nonblocking(path)`: the raw spelling the
// compiler's own sources call until they call `files.open_nonblocking`.
core_sig_files_nonblocking: fn(request: CoreCallSignatureRequest) -> CoreTypedCallSignature? {
    if request.module_name != "core.files" || request.member != "jet_std_files_open_reader_nonblocking" -> return None
    Val(core_sig(request.module_name, request.member, [CoreCallTypedParameter]{core_sig_positional(Type.String, AccessConvention.Read)}, Val(core_sig_result(core_sig_named("FileReader"), core_sig_named("IOError")))))
}

core_sig_fixed: fn(request: CoreCallSignatureRequest) -> CoreTypedCallSignature? {
    if core_sig_network(request) == Val(network) -> return Val(network)
    if core_sig_files_nonblocking(request) == Val(files) -> return Val(files)
    core_sig_plugin_load(request)
}

core_call_typed_signature_for: fn(request: CoreCallSignatureRequest) -> CoreTypedCallSignature? {
    row: core_call(request.module_name, request.member) ?? return None
    if !core_call_coverage_contains(row.coverage, CORE_CALL_COVERAGE_SEMA) -> return None
    resolved_signature: core_sig_fixed(request) ?? return None
    if request.type_args.len() > 0 && request.type_args.len() != resolved_signature.type_parameters.len() {
        return None
    }
    if request.actual_arity < resolved_signature.min_arity || request.actual_arity > resolved_signature.max_arity {
        return None
    }
    Val(resolved_signature)
}

core_call_typed_signature: fn(module_name: String, member: String, actual_arity: Int) -> CoreTypedCallSignature? {
    core_call_typed_signature_for(
        CoreCallSignatureRequest{
            module_name: module_name,
            member: member,
            actual_arity: actual_arity,
            actual_accesses: [AccessConvention]{},
            type_args: [Type]{},
        },
    )
}
