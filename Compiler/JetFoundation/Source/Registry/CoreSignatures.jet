// The typed call contract of the one Core call no Core declaration types: the
// compiler-owned plugin handle's `plugin.load`. Every other Core row's call is
// checked against its Core declaration (sema_call_core_check_fixed_record).

// The argument default a typed Core parameter carries: the parameter's struct
// type built from its declared field defaults, or the default the Core
// declaration writes for it.
CoreCallDefault: enum {
    FieldDefaults,
    Declared(FunctionDefaultRef),
}

CoreCallTypedParameter: struct {
    name: String,
    label: String,
    zone: ParamZone,
    access: AccessConvention,
    ty: Type,
    default: CoreCallDefault?,
}

// A Core call's unbounded type parameter, bound by name.
CoreCallTypeParameter: struct {
    name: String,
}

CoreTypedCallSignature: struct {
    module_name: String,
    member: String,
    min_arity: Int,
    max_arity: Int,
    parameters: [CoreCallTypedParameter],
    return_type: Type?,
    type_parameters: [CoreCallTypeParameter],
}

CoreCallSignatureRequest: struct {
    module_name: String,
    member: String,
    actual_arity: Int,
    type_args: [Type],
}

core_sig_parameter: fn(name: String, label: String, zone: ParamZone, access: AccessConvention, ty: Type, default: CoreCallDefault?) -> CoreCallTypedParameter Never! {
    CoreCallTypedParameter{name: name, label: label, zone: zone, access: access, ty: ty, default: default}
}

core_sig_positional: fn(ty: Type, access: AccessConvention) -> CoreCallTypedParameter Never! {
    core_sig_parameter("", "", ParamZone.PositionalOnly, access, ty, None)
}

core_sig: fn(module_name: String, member: String, parameters: [CoreCallTypedParameter], return_type: Type?) -> CoreTypedCallSignature Never! {
    CoreTypedCallSignature{
        module_name: module_name,
        member: member,
        min_arity: parameters.len(),
        max_arity: parameters.len(),
        parameters: parameters,
        return_type: return_type,
        type_parameters: [CoreCallTypeParameter]{},
    }
}

// `plugin.load(path, authority, limits: …)`: its result is the
// compiler-owned `Plugin` handle (sema types it from the loaded artifact),
// which no Core declaration can spell; `limits:` may be left out, its
// Limits then built from the struct's field defaults.
core_sig_plugin_load: fn(request: CoreCallSignatureRequest) -> CoreTypedCallSignature? {
    if request.module_name != "core.plugin" || request.member != "load" -> return None
    parameters: [CoreCallTypedParameter]{
        core_sig_positional(Type.String, AccessConvention.Read),
        core_sig_positional(Type.Named{name: "Authority"}, AccessConvention.Read),
        core_sig_parameter("limits", "limits", ParamZone.LabelOnly, AccessConvention.Read, Type.Named{name: "<corelib>/core.plugin.Limits"}, Val(CoreCallDefault.FieldDefaults)),
    }
    signature := core_sig(request.module_name, request.member, parameters, Val(Type.Named{name: "Plugin"}))
    signature.min_arity = 2
    Val(signature)
}

core_sig_fixed: fn(request: CoreCallSignatureRequest) -> CoreTypedCallSignature? {
    core_sig_plugin_load(request)
}

core_call_typed_signature_for: fn(request: CoreCallSignatureRequest) -> CoreTypedCallSignature? {
    row: core_call(request.module_name, request.member) ?? return None
    if !core_call_coverage_contains(row.coverage, CORE_CALL_COVERAGE_SEMA) -> return None
    resolved_signature: core_sig_fixed(request) ?? return None
    if request.type_args.len() > 0 && request.type_args.len() != resolved_signature.type_parameters.len() {
        return None
    }
    if request.actual_arity < resolved_signature.min_arity || request.actual_arity > resolved_signature.max_arity {
        return None
    }
    Val(resolved_signature)
}

core_call_typed_signature: fn(module_name: String, member: String, actual_arity: Int) -> CoreTypedCallSignature? {
    core_call_typed_signature_for(
        CoreCallSignatureRequest{
            module_name: module_name,
            member: member,
            actual_arity: actual_arity,
            type_args: [Type]{},
        },
    )
}
