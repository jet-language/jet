// The foreign languages Core declares, read while the compiler builds: the
// `root` of each `impl Language` block of Core/Prelude/Prelude.jet, in source
// order. A package declares a language the same way, and the loader reads
// its blocks from the program it loads, so a new root needs no compiler
// change. No local module may take a language's root as its name or alias
// (E1002).
CORE_LANGUAGE_ROOTS: #run trait_impl_strings(embed_file("toolchain:Core/Prelude/Prelude.jet"), "Language", "root")

// The `constant: "…",` value of each `impl Trait {` block of `text` for
// `trait_name`, in source order; a block without one, or a text with no
// block, stops the build.
trait_impl_strings: fn(text: String, trait_name: String, constant: String) -> [String] {
    opener: "impl {trait_name} {{"
    prefix: "{constant}: \""
    values := [String]{}
    open := false
    found := false
    loop line in text.split("\n").to_list() {
        trimmed: line.trim()
        if {
            trimmed == opener -> {
                open = true
                found = false
            }
            open && trimmed.starts_with(prefix) && trimmed.ends_with("\",") -> {
                values.push(trimmed.after(prefix).removesuffix("\","))
                found = true
            }
            open && trimmed == "}}" -> {
                if !found -> build_time_refused("an `impl {trait_name}` block has no `{constant}: \"…\",` line")
                open = false
            }
            else -> {}
        }
    }
    if values.len() == 0 -> build_time_refused("the text declares no `impl {trait_name}` block")
    values
}

#Test("the language roots are each `impl Language` block's root, in order") {
    text: "Language: trait {{\n    root: String,\n}}\n\nGoLanguage: struct {{\n    impl Language {{\n        root: \"go\",\n    }}\n}}\n\nCLanguage: struct {{\n    impl Language {{\n        root: \"c\",\n    }}\n}}\n"
    assert_eq(trait_impl_strings(text, "Language", "root"), [String]{"go", "c"})
    assert(CORE_LANGUAGE_ROOTS.contains("c") && CORE_LANGUAGE_ROOTS.contains("py") && !CORE_LANGUAGE_ROOTS.contains("zig"))
}
