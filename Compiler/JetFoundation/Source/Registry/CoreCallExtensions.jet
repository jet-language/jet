// Core call rows that no Core.rows dispatcher row declares: the extension
// calls the lowering owns directly. CORE_CALLS
// (Compiler/JetFoundation/Source/Registry/CoreCallRows.jet) appends them, in
// this order, after Core.rows's dispatcher rows. This file is their only home.
CORE_CALL_EXTENSIONS_PATH: "Compiler/JetFoundation/Source/Registry/CoreCallExtensions.jet"

CORE_CALL_EXTENSIONS: [CoreCallRecord]{
    CoreCallRecord{module_name: "core.reflect", member: "of", receiver_types: [String]{}, signature: CoreCallSignature{arity: 1, max_arity: 1, borrow_mask: [Bool]{true}}, fallibility: CoreCallFallibility.Sema, effects: [String]{}, capability: CoreCapabilityContract{kind: CoreCapabilityKind.Pure, provider: None, fallback: None, failure: None}, pure_route: CoreCallPureRoute.NoPureRoute, symbol: CoreCallSymbol.Prelude{name: "jet_reflect_of"}, source_target: None, coverage: CoreCallCoverage{bits: 47}, aot_direct: true, authority: None},
    CoreCallRecord{module_name: "core.net", member: "sendfile", receiver_types: [String]{}, signature: CoreCallSignature{arity: 2, max_arity: 2, borrow_mask: [Bool]{true, false}}, fallibility: CoreCallFallibility.Sema, effects: [String]{"Net", "Time.Wait"}, capability: CoreCapabilityContract{kind: CoreCapabilityKind.NativeRequired, provider: Val("core.net"), fallback: None, failure: Val("core.capability.unavailable")}, pure_route: CoreCallPureRoute.NoPureRoute, symbol: CoreCallSymbol.Prelude{name: "jet_net_sendfile"}, source_target: None, coverage: CoreCallCoverage{bits: 47}, aot_direct: true, authority: None},
    CoreCallRecord{module_name: "core.crypto.vault", member: "get", receiver_types: [String]{}, signature: CoreCallSignature{arity: 1, max_arity: 1, borrow_mask: [Bool]{true}}, fallibility: CoreCallFallibility.Sema, effects: [String]{"Secret"}, capability: CoreCapabilityContract{kind: CoreCapabilityKind.NativeRequired, provider: Val("core.crypto.vault"), fallback: None, failure: Val("core.capability.unavailable")}, pure_route: CoreCallPureRoute.NoPureRoute, symbol: CoreCallSymbol.Prelude{name: "jet_vault_get_impl"}, source_target: None, coverage: CoreCallCoverage{bits: 47}, aot_direct: false, authority: None},
    CoreCallRecord{module_name: "core.plugin", member: "__authority_to_wire", receiver_types: [String]{}, signature: CoreCallSignature{arity: 1, max_arity: 1, borrow_mask: [Bool]{true}}, fallibility: CoreCallFallibility.Sema, effects: [String]{}, capability: CoreCapabilityContract{kind: CoreCapabilityKind.Pure, provider: None, fallback: None, failure: None}, pure_route: CoreCallPureRoute.NoPureRoute, symbol: CoreCallSymbol.Prelude{name: "jet_authority_to_wire"}, source_target: None, coverage: CoreCallCoverage{bits: 47}, aot_direct: true, authority: None},
}
