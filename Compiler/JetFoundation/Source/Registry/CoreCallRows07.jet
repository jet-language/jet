            metadata_ty_name :: cx.method_metadata_name(ty_name, method)
            canonical_operator_rhs :: operator_rhs.map(fn(rhs) { if rhs == { .Named(name) -> cx.imported_type_metadata_name(name).map(fn(identity) { Type.Named(identity) }) ?? rhs.clone() else -> rhs.clone() } })
            operator_method :: canonical_operator_rhs.and_then(fn(rhs) { operator_trait_for_method(method).and_then(fn(trait_name) { cx.operator_methods.get(Traits.operator_method_identity(lookup_ty_name, trait_name, method, rhs)) }) })
            raw_sig :: if operator_rhs.is_some() -> operator_method.map(fn(facts) { facts.sig.clone() }) ?? [] else -> cx.method_sigs.get((metadata_ty_name, method)) ?? []
            move_receiver :: cx.method_self_convs.get((metadata_ty_name, method)) == Val(AccessConvention.Move) && (if receiver == { .Ident(name, _) -> env.is_resource(name) else -> false })
            recv := if move_receiver -> lower_owned_expr(receiver, cx, &env) else -> lower_expr(receiver, cx, &env)
            target_owner :: canonical_method_target_owner(cx, ty_name)
            canonicalize_method_receiver_type(&recv.ty, target_owner)
            owner_type_args :: if recv.ty == { .Apply{name: name, args: recv_args} where name == ty_name || name == lookup_ty_name -> recv_args else -> [] }
            sig :: if operator_rhs.is_some() -> raw_sig else -> instantiated_sig.unwrap_or_else(fn() { instantiate_method_sig(cx, metadata_ty_name, method, raw_sig, owner_type_args, type_args) })
            // Rust: crates/jet-codegen/src/Codegen/TIR/lower/method_calls.rs:13082
            if recv.ty == .Named(name) {
                if cx.trait_names.contains(name) {
                    return in_own_frame(fn() {
                        trait_name :: recv.ty.name()
                        recv.ty = Type.TraitObject([trait_name.clone()])
                        targs := lower_method_args(args, sig, &env, cx)
                        retag_empty_collection_args(&targs, sig)
                        ret_ty :: resolved_ret.or_else(fn() { cx.method_rets.get((trait_name, method)) ?? None }).unwrap_or_else(unit_type)
                        TExpr{ty: ret_ty, kind: TExprKind.MethodCall{recv: recv, method: TMethodRef.trait_method(trait_name, method), type_args: type_args.clone(), args: targs, source_first_string_literal: first_string_literal_arg(args), operator_line: None}}
                    })
                }
            }
            distinct_numeric_operator :: cx.distinct_types.get(lookup_ty_name).is_some_and(fn(fact) { fact.1 }) && !cx.distinct_ranges.contains_key(lookup_ty_name) && !cx.method_sigs.contains_key((metadata_ty_name, method)) && operator_method.is_none() && ["add", "sub", "mul", "div"].contains(method) && args.len() == 1
            if distinct_numeric_operator {
                rhs :: lower_expr(args[0].expr, cx, &env)
                ret_ty :: resolved_ret.or_else(fn() { operator_method.and_then(fn(facts) { facts.ret.clone() }) }).unwrap_or_else(unit_type)
                return lower_builtin_binary_method(method, recv, rhs, ret_ty, method_span, cx)
            }
            targs := lower_method_args(args, sig, &env, cx)
            retag_empty_collection_args(&targs, sig)
            resolved_type_args :: if operator_rhs.is_some() -> type_args.clone() else -> resolved_method_type_args(cx, metadata_ty_name, method, sig, owner_type_args, targs, type_args, resolved_ret)
            generic_method :: recv.ty == .Apply{..} || !resolved_type_args.is_empty()
            if generic_method {
                &cx.jit_method_calls.insert(generic_method_instance_key(recv.ty, method, resolved_type_args), (recv.ty.clone(), method.clone(), resolved_type_args.clone()))
            }
            method_ref :: if canonical_operator_rhs == Val(rhs) -> {
                trait_name :: operator_method.map(fn(facts) { facts.trait_name }).or_else(fn() { operator_trait_for_method(method) }) ?? panic("checked operator method has a canonical trait")
                TMethodRef.operator(lookup_ty_name, trait_name, method, rhs)
            } else if cx.trait_methods.contains((metadata_ty_name, method)) -> TMethodRef.bare(method) else if generic_method -> TMethodRef.inherent(generic_method_instance_key(recv.ty, method, resolved_type_args)) else -> TMethodRef.inherent(method)
            ret_ty :: (if operator_rhs.is_some() -> resolved_ret.or_else(fn() { operator_method.and_then(fn(facts) { facts.ret.clone() }) }) else -> instantiate_method_ret(cx, metadata_ty_name, method, owner_type_args, resolved_type_args, resolved_ret)).unwrap_or_else(unit_type)
            TExpr{ty: ret_ty, kind: TExprKind.MethodCall{recv: recv, method: method_ref, type_args: resolved_type_args, args: targs, source_first_string_literal: first_string_literal_arg(args), operator_line: None}}
        } else -> invariant_method_expr(method_span, "method `{method}` receiver type")
    })
}
