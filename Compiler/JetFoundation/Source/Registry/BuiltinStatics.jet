    builtin_static_generic(builtin_static("Map", "fromkeys", [Type]{Type.List{element: Type.Named{name: "K"}}, Type.Named{name: "V"}}, Type.Map{key: Type.Named{name: "K"}, key_span: None, value: Type.Named{name: "V"}}, BuiltinStaticLowering.ArgumentBuiltin{operation: TBuiltinOp.MapFromKeys}), [String]{"K", "V"}, 2),
    builtin_static_arity_code(builtin_static_in("core.compute.solve", builtin_static_generic(builtin_static("Solver", "new", [Type]{Type.Named{name: "T"}}, Type.Named{name: "Solver"}, BuiltinStaticLowering.ArgumentHandle{operation: THandleOp.SolverNew}), [String]{"T"}, 0)), "E0101"),
    builtin_static_crypto("core.crypto", "WrappedVaultKey", "from_bytes", [Type]{builtin_static_u8_list()}, Type.Result{ok: Type.Named{name: "WrappedVaultKey"}, err: Type.Named{name: "KeyWrapError"}}, "__vault_wrapped_from_bytes"),
    builtin_static_crypto("core.crypto", "KeyUnlock", "Recipient", [Type]{builtin_static_crypto_secret("X25519SecretKey")}, Type.Named{name: "KeyUnlock"}, "__vault_unlock_recipient"),
    builtin_static_crypto("core.crypto", "KeyUnlock", "Passphrase", [Type]{builtin_static_crypto_secret("Secret")}, Type.Named{name: "KeyUnlock"}, "__vault_unlock_passphrase"),
    builtin_static_crypto("core.crypto.vault", "WrappedVaultKey", "from_bytes", [Type]{builtin_static_u8_list()}, Type.Result{ok: Type.Named{name: "WrappedVaultKey"}, err: Type.Named{name: "KeyWrapError"}}, "__vault_wrapped_from_bytes"),
    builtin_static_crypto("core.crypto.vault", "KeyUnlock", "Recipient", [Type]{builtin_static_crypto_secret("X25519SecretKey")}, Type.Named{name: "KeyUnlock"}, "__vault_unlock_recipient"),
    builtin_static_crypto("core.crypto.vault", "KeyUnlock", "Passphrase", [Type]{builtin_static_crypto_secret("Secret")}, Type.Named{name: "KeyUnlock"}, "__vault_unlock_passphrase")
} }

// Numeric destination owners (`numeric_type_from_name`) and their host words.
BUILTIN_NUMERIC_KINDS :: prep { [BuiltinNumericKind]{
    BuiltinNumericKind{name: "Int", ty: Type.Int, rust: "i64", integer: true, fixed: false, signed: true, bits: 64},
    BuiltinNumericKind{name: "I8", ty: Type.IntN{signed: true, bits: 8}, rust: "i8", integer: true, fixed: true, signed: true, bits: 8},
    BuiltinNumericKind{name: "I16", ty: Type.IntN{signed: true, bits: 16}, rust: "i16", integer: true, fixed: true, signed: true, bits: 16},
    BuiltinNumericKind{name: "I32", ty: Type.IntN{signed: true, bits: 32}, rust: "i32", integer: true, fixed: true, signed: true, bits: 32},
    BuiltinNumericKind{name: "I64", ty: Type.IntN{signed: true, bits: 64}, rust: "i64", integer: true, fixed: true, signed: true, bits: 64},
    BuiltinNumericKind{name: "U8", ty: Type.IntN{signed: false, bits: 8}, rust: "u8", integer: true, fixed: true, signed: false, bits: 8},
    BuiltinNumericKind{name: "U16", ty: Type.IntN{signed: false, bits: 16}, rust: "u16", integer: true, fixed: true, signed: false, bits: 16},
    BuiltinNumericKind{name: "U32", ty: Type.IntN{signed: false, bits: 32}, rust: "u32", integer: true, fixed: true, signed: false, bits: 32},
    BuiltinNumericKind{name: "U64", ty: Type.IntN{signed: false, bits: 64}, rust: "u64", integer: true, fixed: true, signed: false, bits: 64},
    BuiltinNumericKind{name: "Float", ty: Type.Float, rust: "f64", integer: false, fixed: false, signed: true, bits: 64},
    BuiltinNumericKind{name: "F64", ty: Type.Float, rust: "f64", integer: false, fixed: false, signed: true, bits: 64},
    BuiltinNumericKind{name: "F32", ty: Type.Float32, rust: "f32", integer: false, fixed: false, signed: true, bits: 32}
} }

// D-SHAPE-CONVERT1=A: destination-owned `from_<source>` spellings.
BUILTIN_NUMERIC_SOURCES :: prep { [BuiltinNumericSource]{
    BuiltinNumericSource{method: "from_i8", source: "I8"},
    BuiltinNumericSource{method: "from_i64", source: "I64"},
    BuiltinNumericSource{method: "from_i16", source: "I16"},
    BuiltinNumericSource{method: "from_i32", source: "I32"},
    BuiltinNumericSource{method: "from_int", source: "Int"},
    BuiltinNumericSource{method: "from_u8", source: "U8"},
    BuiltinNumericSource{method: "from_u16", source: "U16"},
    BuiltinNumericSource{method: "from_u32", source: "U32"},
    BuiltinNumericSource{method: "from_u64", source: "U64"},
    BuiltinNumericSource{method: "from_f32", source: "F32"},
    BuiltinNumericSource{method: "from_float", source: "Float"},
    BuiltinNumericSource{method: "from_decimal", source: "Decimal"},
    BuiltinNumericSource{method: "from_fraction", source: "Fraction"}
} }

// Rust Syntax::NUMERIC_CONVERSION_SOURCES and numeric owner names. These are
// projections of the checker/lowering tables, including precise source suffixes.
pub fn numeric_conversion_sources() -> [BuiltinNumericSource] Never! {
    ~BUILTIN_NUMERIC_SOURCES
}

pub fn numeric_conversion_catalog_targets() -> [BuiltinNumericKind] Never! {
    ~BUILTIN_NUMERIC_KINDS
}

fn builtin_numeric_kind(name: String) -> BuiltinNumericKind? {
    loop kind in BUILTIN_NUMERIC_KINDS {
        if kind.name == name -> return Val(kind)
    }
    None
}

fn builtin_numeric_source(method: String) -> String? {
    loop row in BUILTIN_NUMERIC_SOURCES {
        if row.method == method -> return Val(row.source)
    }
    None
}

// The target's value range contains every source value.
fn builtin_numeric_widening(source: BuiltinNumericKind, target: BuiltinNumericKind) -> Bool Never! {
    numeric_conversion_widening(source.signed, source.bits, target.signed, target.bits)
}


fn builtin_numeric_host_kind(kind: BuiltinNumericKind) -> Int Never! {
    offset := if kind.signed -> 0 else -> 4
    step := if kind.bits == 8 -> 0 else -> if kind.bits == 16 -> 1 else -> if kind.bits == 32 -> 2 else -> 3
    offset + step
}

fn builtin_numeric_float_lower(kind: BuiltinNumericKind) -> String Never! {
    if !kind.signed -> return "0.0"
    if kind.bits == 8 -> return "-128.0"
    if kind.bits == 16 -> return "-32768.0"
    if kind.bits == 32 -> return "-2147483648.0"
    "-9223372036854775808.0"
}

fn builtin_numeric_float_upper_exclusive(kind: BuiltinNumericKind) -> String Never! {
    if kind.signed {
        if kind.bits == 8 -> return "128.0"
        if kind.bits == 16 -> return "32768.0"
        if kind.bits == 32 -> return "2147483648.0"
        return "9223372036854775808.0"
    }
    if kind.bits == 8 -> return "256.0"
    if kind.bits == 16 -> return "65536.0"
    if kind.bits == 32 -> return "4294967296.0"
    "18446744073709551616.0"
}

fn builtin_numeric_operation(source: BuiltinNumericKind, target: BuiltinNumericKind) -> TNumericOp Never! {
    if !target.integer {
        if target.ty == Type.Float32 && source.ty == Type.Float -> return TNumericOp.FloatNarrow{dst_spelling: target.name}
        return TNumericOp.CastAs{dst_rust: target.rust}
    }
    // `U64` rides an i64 word; `Int.from_u64` stays on the exact CastAs adapter.
    if target.name == "Int" && source.integer && !source.signed -> return TNumericOp.CastAs{dst_rust: target.rust}
    if source.name == "Int" && target.name != "Int" -> return TNumericOp.TryFrom{host_kind: builtin_numeric_host_kind(target), dst_rust: target.rust, dst_spelling: target.name}
    if source.integer {
        if builtin_numeric_widening(source, target) -> return TNumericOp.CastAs{dst_rust: target.rust}
        return TNumericOp.TryFrom{host_kind: builtin_numeric_host_kind(target), dst_rust: target.rust, dst_spelling: target.name}
    }
    TNumericOp.FloatToInt{host_kind: builtin_numeric_host_kind(target), dst_rust: target.rust, dst_spelling: target.name, lower: builtin_numeric_float_lower(target), upper_exclusive: builtin_numeric_float_upper_exclusive(target)}
}

fn builtin_static_numeric_row(owner: String, method: String) -> BuiltinStaticRow? {
    source_name :: builtin_numeric_source(method) ?? return None
    target_name :: if owner == "F64" -> "Float" else -> owner
    if numeric_precise_conversion_route_index(target_name, source_name) == .Val(index) {
        route :: NUMERIC_PRECISE_ROUTES[index]
        source_type :: if source_name == "Decimal" || source_name == "Fraction" -> Type.Named{name: ~source_name} else -> (builtin_numeric_kind(source_name) ?? panic("registered precise source")).ty
        target_type :: if owner == "Decimal" || owner == "Fraction" -> Type.Named{name: ~owner} else -> (builtin_numeric_kind(owner) ?? panic("registered precise target")).ty
        return Val(builtin_static_precise(~owner, ~method, ^source_type, ^target_type, ~route.owner, ~route.function))
    }
    target :: builtin_numeric_kind(owner) ?? return None
    source :: builtin_numeric_kind(source_name) ?? return None
    result :: numeric_conversion_return(target.ty, method, 1) ?? return None
    Val(builtin_static(~owner, ~method, [Type]{~source.ty}, ^result, BuiltinStaticLowering.Numeric{operation: builtin_numeric_operation(source, target)}))
}

// Every row for `owner.method`, across modules; the caller admits the one
// whose module matches how the owner was named.
pub fn builtin_static_rows(owner: String, method: String) -> [BuiltinStaticRow] Never! {
    rows := builtin_static_rows_in(BUILTIN_STATIC_ROWS, owner, method)
    if builtin_static_numeric_row(owner, method) == .Val(row) -> &rows.push(row)
    rows
}

// The table is a read parameter, so the scan reads its rows in place.
fn builtin_static_rows_in(table: [BuiltinStaticRow], owner: String, method: String) -> [BuiltinStaticRow] Never! {
    rows := [BuiltinStaticRow]{}
    loop row in table {
        if row.owner == owner && row.method == method -> &rows.push(row)
    }
    rows
}

pub fn builtin_static_is_type_param(row: BuiltinStaticRow, name: String) -> Bool Never! {
    loop param in row.type_params {
        if param == name -> return true
    }
    false
}
