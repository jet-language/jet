// Built-in type-owned static calls such as `Int.parse(text)`,
// `U8.from_int(value)`, `Atomic<Int>.new(0)`, and `crypto.Hasher.new()`.
//
// The fixed rows mirror the bootstrap's `Collections::builtin_static_return`,
// its `builtin_method_arg_types` entries, and the TIR node each static lowers
// to. Destination-owned numeric conversions are generated from the
// `numeric_conversion_return` widening law and `resolve_numeric_conversion_op`.
// `Clock.new/system/now`, `Date.today`, and `Path.home` keep their dedicated
// time and stream checkers. An absent row is deliberately uncovered.
//
// A row's `type_params` are placeholders written as `Type.Named(name)` in its
// parameter and return types. The first `owner_type_params` of them bind from
// the owner's explicit type arguments; the rest bind from the checked
// arguments, then the expected result, and otherwise default to `Int`.

pub enum BuiltinStaticLowering {
    // The first value argument becomes the builtin receiver.
    ArgumentBuiltin(operation: TBuiltinOp)
    // `Int.from_radix(text, base)`: the text is the receiver; the op carries the call line.
    IntFromRadix
    // An inert Unit receiver; every value argument stays an argument.
    UnitBuiltin(operation: TBuiltinOp)
    // A Prelude associated function; `generics` are the owner arguments, written
    // over the row type parameters (`Type.Named(name)`) and substituted at the call.
    PreludeStatic(rooted: Bool, path: String, generics: [TPreludeArg])
    // A handle operation whose receiver is the first value argument.
    ArgumentHandle(operation: THandleOp)
    // `Duration.<unit>(value)`: the checked Int or Float value selects the route.
    DurationNew(unit: String)
    // A registered Core call; every value argument is a Core argument.
    CoreCall(module_name: String, member: String)
    ExpiringValueNew
    EmptyMap
    Numeric(operation: TNumericOp)
    Precise(type_name: String, function: String)
}

pub enum BuiltinStaticOwnerRule {
    Inferred
    // `Atomic<T>`: the owner names T explicitly and T is a lock-free scalar.
    AtomicScalar
}

pub struct BuiltinStaticRow {
    // "" is an ambient built-in owner; otherwise the Core module exporting it.
    pub module_name: String
    pub owner: String
    pub method: String
    pub type_params: [String]
    pub owner_type_params: Int
    pub owner_rule: BuiltinStaticOwnerRule
    pub parameters: [Type]
    // How every argument passes: Read, or Move for a row that owns its
    // payload (`shared expr`).
    pub parameter_convention: AccessConvention
    pub return_type: Type
    pub lowering: BuiltinStaticLowering
    pub arity_code: String
}

pub struct BuiltinNumericKind {
    pub name: String
    pub ty: Type
    pub rust: String
    pub integer: Bool
    pub fixed: Bool
    pub signed: Bool
    pub bits: Int
}

pub struct BuiltinNumericSource {
    pub method: String
    pub source: String
}

// Rust Collections::builtin_static_return rows own their checked metadata.
// Consume construction inputs, including lowering, rather than cloning a
// borrowed operation into the owned row (the tools S16 E0120 witness).
fn builtin_static(owner: ^String, method: ^String, parameters: ^[Type], return_type: ^Type, lowering: ^BuiltinStaticLowering) -> BuiltinStaticRow Never! {
    BuiltinStaticRow{
        module_name: "",
        owner: ^owner,
        method: ^method,
        type_params: [String]{},
        owner_type_params: 0,
        owner_rule: BuiltinStaticOwnerRule.Inferred,
        parameters: ^parameters,
        parameter_convention: AccessConvention.Read,
        return_type: ^return_type,
        lowering: ^lowering,
        arity_code: "E0104",
    }
}

fn builtin_static_in(module_name: ^String, row: ^BuiltinStaticRow) -> BuiltinStaticRow Never! {
    updated := ^row
    updated.module_name = ^module_name
    ^updated
}

fn builtin_static_generic(row: ^BuiltinStaticRow, type_params: ^[String], owner_type_params: Int) -> BuiltinStaticRow Never! {
    updated := ^row
    updated.type_params = ^type_params
    updated.owner_type_params = owner_type_params
    ^updated
}

fn builtin_static_atomic(row: ^BuiltinStaticRow) -> BuiltinStaticRow Never! {
    updated := ^row
    updated.type_params = [String]{"T"}
    updated.owner_type_params = 1
    updated.owner_rule = BuiltinStaticOwnerRule.AtomicScalar
    ^updated
}

fn builtin_static_arity_code(row: ^BuiltinStaticRow, arity_code: ^String) -> BuiltinStaticRow Never! {
    updated := ^row
    updated.arity_code = ^arity_code
    ^updated
}

// The row owns its arguments: each one moves into the constructed value.
fn builtin_static_owned(row: ^BuiltinStaticRow) -> BuiltinStaticRow Never! {
    updated := ^row
    updated.parameter_convention = AccessConvention.Move
    ^updated
}

fn builtin_static_u8_list() -> Type Never! {
    Type.List{element: Type.IntN{signed: false, bits: 8}}
}

// The single owner argument `T` of a generic Prelude static.
fn builtin_static_owner_t() -> [TPreludeArg] Never! {
    [TPreludeArg]{TPreludeArg.Jet{ty: Type.Named{name: "T"}}}
}

fn builtin_static_crypto_secret(name: ^String) -> Type Never! {
    Type.Tagged{marker: TagMarker.Internal{internal_tag: InternalTag.CoreCryptoNominal}, inner: Type.Named{name: ^name}}
}

fn builtin_static_crypto(module_name: ^String, owner: ^String, method: ^String, parameters: ^[Type], return_type: ^Type, member: ^String) -> BuiltinStaticRow Never! {
    builtin_static_in(^module_name, builtin_static(^owner, ^method, ^parameters, ^return_type, BuiltinStaticLowering.CoreCall{module_name: "core.crypto", member: ^member}))
}

fn builtin_static_duration(method: ^String, unit: ^String) -> BuiltinStaticRow Never! {
    builtin_static("Duration", ^method, [Type]{Type.Union{members: [Type]{Type.Int, Type.Float}}}, Type.Result{ok: Type.Named{name: "Duration"}, err: Type.Named{name: "RangeError"}}, BuiltinStaticLowering.DurationNew{unit: ^unit})
}

fn builtin_static_precise(owner: ^String, method: ^String, source: ^Type, target: ^Type, type_name: ^String, function: ^String) -> BuiltinStaticRow Never! {
    builtin_static(^owner, ^method, [Type]{^source}, ^target, BuiltinStaticLowering.Precise{type_name: ^type_name, function: ^function})
}

BUILTIN_STATIC_ROWS :: prep { [BuiltinStaticRow]{
    builtin_static("Int", "parse", [Type]{Type.String}, Type.Result{ok: Type.Int, err: Type.Named{name: "ParseError"}}, BuiltinStaticLowering.ArgumentBuiltin{operation: TBuiltinOp.ParseInt}),
    builtin_static("Int", "from_radix", [Type]{Type.String, Type.Int}, Type.Result{ok: Type.Int, err: Type.Named{name: "ParseError"}}, BuiltinStaticLowering.IntFromRadix),
    builtin_static("Float", "parse", [Type]{Type.String}, Type.Result{ok: Type.Float, err: Type.Named{name: "ParseError"}}, BuiltinStaticLowering.ArgumentBuiltin{operation: TBuiltinOp.ParseFloat}),
    builtin_static("F64", "parse", [Type]{Type.String}, Type.Result{ok: Type.Float, err: Type.Named{name: "ParseError"}}, BuiltinStaticLowering.ArgumentBuiltin{operation: TBuiltinOp.ParseFloat}),
    builtin_static("String", "from_bytes", [Type]{builtin_static_u8_list()}, Type.Result{ok: Type.String, err: Type.Named{name: "UTF8Error"}}, BuiltinStaticLowering.ArgumentBuiltin{operation: TBuiltinOp.StringFromBytes}),
    builtin_static("String", "from_bytes_lossy", [Type]{builtin_static_u8_list()}, Type.String, BuiltinStaticLowering.ArgumentBuiltin{operation: TBuiltinOp.StringFromBytesLossy}),
    builtin_static_generic(builtin_static("List", "try_new", [Type]{}, Type.Result{ok: Type.List{element: Type.Named{name: "T"}}, err: Type.Named{name: "AllocError"}}, BuiltinStaticLowering.UnitBuiltin{operation: TBuiltinOp.ListTryNew}), [String]{"T"}, 1),
    builtin_static_generic(builtin_static("List", "try_with_capacity", [Type]{Type.Int}, Type.Result{ok: Type.List{element: Type.Named{name: "T"}}, err: Type.Named{name: "AllocError"}}, BuiltinStaticLowering.UnitBuiltin{operation: TBuiltinOp.ListTryWithCapacity}), [String]{"T"}, 1),
    builtin_static_atomic(builtin_static("Atomic", "new", [Type]{Type.Named{name: "T"}}, Type.Apply{name: "Atomic", args: [Type]{Type.Named{name: "T"}}}, BuiltinStaticLowering.PreludeStatic{rooted: true, path: "JetAtomic", generics: builtin_static_owner_t()})),
    builtin_static_atomic(builtin_static("Atomic", "try_new", [Type]{Type.Named{name: "T"}}, Type.Result{ok: Type.Apply{name: "Atomic", args: [Type]{Type.Named{name: "T"}}}, err: Type.Named{name: "AllocError"}}, BuiltinStaticLowering.PreludeStatic{rooted: true, path: "JetAtomic", generics: builtin_static_owner_t()})),
    builtin_static("Condition", "new", [Type]{}, Type.Named{name: "Condition"}, BuiltinStaticLowering.PreludeStatic{rooted: true, path: "jet_std::JetCondition", generics: [TPreludeArg]{}}),
    // D-CONC-SHARE1=A: `shared expr` (the parser's `Shared.new` call shape)
    // moves its payload into a `JetShared<T>`; T is the payload's own type.
    builtin_static_owned(builtin_static_generic(builtin_static("Shared", "new", [Type]{Type.Named{name: "T"}}, Type.Shared{inner: Type.Named{name: "T"}}, BuiltinStaticLowering.PreludeStatic{rooted: true, path: "jet_std::JetShared", generics: builtin_static_owner_t()}), [String]{"T"}, 0)),
    builtin_static("Authority", "workspace", [Type]{}, Type.Named{name: "Authority"}, BuiltinStaticLowering.PreludeStatic{rooted: true, path: "JetAuthority", generics: [TPreludeArg]{}}),
    builtin_static_duration("nanoseconds", "Nanoseconds"),
    builtin_static_duration("microseconds", "Microseconds"),
    builtin_static_duration("milliseconds", "Milliseconds"),
    builtin_static_duration("seconds", "Seconds"),
    builtin_static_duration("minutes", "Minutes"),
    builtin_static_duration("hours", "Hours"),
    builtin_static_generic(builtin_static("ExpiringValue", "new", [Type]{Type.Named{name: "T"}, Type.Named{name: "Duration"}, Type.Named{name: "Clock"}}, Type.Apply{name: "ExpiringValue", args: [Type]{Type.Named{name: "T"}}}, BuiltinStaticLowering.ExpiringValueNew), [String]{"T"}, 0),
    builtin_static("Bytes", "new", [Type]{}, Type.Named{name: "Bytes"}, BuiltinStaticLowering.PreludeStatic{rooted: true, path: "JetByteBuffer", generics: [TPreludeArg]{}}),
    builtin_static("Bytes", "with_capacity", [Type]{Type.Int}, Type.Named{name: "Bytes"}, BuiltinStaticLowering.ArgumentBuiltin{operation: TBuiltinOp.ByteBufferWithCapacity}),
    builtin_static("Bytes", "from", [Type]{builtin_static_u8_list()}, Type.Named{name: "Bytes"}, BuiltinStaticLowering.ArgumentBuiltin{operation: TBuiltinOp.ByteBufferFrom}),
    builtin_static_generic(builtin_static("Queue", "new", [Type]{}, Type.Apply{name: "Queue", args: [Type]{Type.Named{name: "T"}}}, BuiltinStaticLowering.PreludeStatic{rooted: false, path: "std::collections::VecDeque", generics: builtin_static_owner_t()}), [String]{"T"}, 1),
    builtin_static_generic(builtin_static("Queue", "init", [Type]{Type.List{element: Type.Named{name: "T"}}}, Type.Apply{name: "Queue", args: [Type]{Type.Named{name: "T"}}}, BuiltinStaticLowering.ArgumentBuiltin{operation: TBuiltinOp.DequeFrom}), [String]{"T"}, 1),
    builtin_static_generic(builtin_static("Set", "new", [Type]{}, Type.Apply{name: "Set", args: [Type]{Type.Named{name: "T"}}}, BuiltinStaticLowering.PreludeStatic{rooted: false, path: "std::collections::HashSet", generics: builtin_static_owner_t()}), [String]{"T"}, 1),
    builtin_static_generic(builtin_static("Set", "from", [Type]{Type.List{element: Type.Named{name: "T"}}}, Type.Apply{name: "Set", args: [Type]{Type.Named{name: "T"}}}, BuiltinStaticLowering.ArgumentBuiltin{operation: TBuiltinOp.SetFrom}), [String]{"T"}, 1),
    builtin_static_generic(builtin_static("Rank", "new", [Type]{}, Type.Apply{name: "Rank", args: [Type]{Type.Named{name: "T"}}}, BuiltinStaticLowering.PreludeStatic{rooted: false, path: "std::collections::BTreeSet", generics: builtin_static_owner_t()}), [String]{"T"}, 1),
    // D-TAG1: `Tally<T>` is a counted HashMap from element to count.
    builtin_static_generic(builtin_static("Tally", "new", [Type]{}, Type.Apply{name: "Tally", args: [Type]{Type.Named{name: "T"}}}, BuiltinStaticLowering.PreludeStatic{rooted: false, path: "std::collections::HashMap", generics: [TPreludeArg]{TPreludeArg.Jet{ty: Type.Named{name: "T"}}, TPreludeArg.HostUsize}}), [String]{"T"}, 1),
    builtin_static_generic(builtin_static("Map", "new", [Type]{}, Type.Map{key: Type.Named{name: "K"}, key_span: None, value: Type.Named{name: "V"}}, BuiltinStaticLowering.EmptyMap), [String]{"K", "V"}, 2),
