// Numeric destination owners (`numeric_type_from_name`) and their host words.
BUILTIN_NUMERIC_KINDS: #run { [BuiltinNumericKind]{
    {name: "Int", ty: Type.Int, rust: "i64", integer: true, fixed: false, signed: true, bits: 64},
    {name: "I8", ty: Type.IntN{signed: true, bits: 8}, rust: "i8", integer: true, fixed: true, signed: true, bits: 8},
    {name: "I16", ty: Type.IntN{signed: true, bits: 16}, rust: "i16", integer: true, fixed: true, signed: true, bits: 16},
    {name: "I32", ty: Type.IntN{signed: true, bits: 32}, rust: "i32", integer: true, fixed: true, signed: true, bits: 32},
    {name: "I64", ty: Type.IntN{signed: true, bits: 64}, rust: "i64", integer: true, fixed: true, signed: true, bits: 64},
    {name: "U8", ty: Type.IntN{signed: false, bits: 8}, rust: "u8", integer: true, fixed: true, signed: false, bits: 8},
    {name: "U16", ty: Type.IntN{signed: false, bits: 16}, rust: "u16", integer: true, fixed: true, signed: false, bits: 16},
    {name: "U32", ty: Type.IntN{signed: false, bits: 32}, rust: "u32", integer: true, fixed: true, signed: false, bits: 32},
    {name: "U64", ty: Type.IntN{signed: false, bits: 64}, rust: "u64", integer: true, fixed: true, signed: false, bits: 64},
    {name: "Float", ty: Type.Float, rust: "f64", integer: false, fixed: false, signed: true, bits: 64},
    {name: "F64", ty: Type.Float, rust: "f64", integer: false, fixed: false, signed: true, bits: 64},
    {name: "F32", ty: Type.Float32, rust: "f32", integer: false, fixed: false, signed: true, bits: 32}
} }

// Destination-owned `from_<source>` spellings (`NUMERIC_CONVERSION_SOURCES`;
// the semantic symbol catalog reads it too).
BUILTIN_NUMERIC_SOURCES: #run { [BuiltinNumericSource]{
    {method: "from_i8", source: "I8"},
    {method: "from_i64", source: "I64"},
    {method: "from_i16", source: "I16"},
    {method: "from_i32", source: "I32"},
    {method: "from_int", source: "Int"},
    {method: "from_u8", source: "U8"},
    {method: "from_u16", source: "U16"},
    {method: "from_u32", source: "U32"},
    {method: "from_u64", source: "U64"},
    {method: "from_f32", source: "F32"},
    {method: "from_float", source: "Float"},
    {method: "from_decimal", source: "Decimal"},
    {method: "from_fraction", source: "Fraction"}
} }

builtin_numeric_kind: fn(name: String) -> BuiltinNumericKind? {
    loop kind in BUILTIN_NUMERIC_KINDS {
        if kind.name == name -> return Val(kind)
    }
    None
}

builtin_numeric_source: fn(method: String) -> String? {
    loop row in BUILTIN_NUMERIC_SOURCES {
        if row.method == method -> return Val(row.source)
    }
    None
}

// The target's value range contains every source value.
builtin_numeric_widening: fn(source: BuiltinNumericKind, target: BuiltinNumericKind) -> Bool Never! {
    if source.signed && !target.signed -> return false
    if !source.signed && target.signed -> return source.bits < target.bits
    source.bits <= target.bits
}

builtin_numeric_return: fn(source: BuiltinNumericKind, target: BuiltinNumericKind) -> Type Never! {
    checked := Type.Result{ok: target.ty, err: Type.String}
    if source.name == "Int" && target.fixed -> return checked
    if source.fixed && target.name == "Int" -> return target.ty
    if !source.integer && target.integer -> return checked
    if source.fixed && target.fixed {
        return if builtin_numeric_widening(source, target) -> target.ty else -> checked
    }
    if source.ty == Type.Float && target.ty == Type.Float32 -> return checked
    target.ty
}

builtin_numeric_host_kind: fn(kind: BuiltinNumericKind) -> Int Never! {
    offset := if kind.signed -> 0 else -> 4
    step := if kind.bits == 8 -> 0 else -> if kind.bits == 16 -> 1 else -> if kind.bits == 32 -> 2 else -> 3
    offset + step
}

builtin_numeric_operation: fn(source: BuiltinNumericKind, target: BuiltinNumericKind) -> TNumericOp Never! {
    if !target.integer {
        if target.ty == Type.Float32 && source.ty == Type.Float -> return TNumericOp.FloatNarrow
        // A whole number crosses into Float or F32 by the one checked rule
        // `T{n}` follows: it stops with E3010 when it has
        // no exact value there, and `approx(n)` is the rounding spelling. A
        // fixed source narrower than the target's precision is always exact.
        if source.integer {
            precision: if target.ty == Type.Float32 -> 24 else -> 53
            if source.fixed && source.bits <= precision -> return TNumericOp.CastAs{dst_rust: target.rust}
            return TNumericOp.CheckedIntToFloat{source_signed: source.signed, target_f32: target.ty == Type.Float32, line: 0}
        }
        return TNumericOp.CastAs{dst_rust: target.rust}
    }
    // `U64` rides an i64 word; `Int.from_u64` stays on the exact CastAs adapter.
    if target.name == "Int" && source.integer && !source.signed -> return TNumericOp.CastAs{dst_rust: target.rust}
    if source.name == "Int" && target.name != "Int" -> return TNumericOp.TryFrom{host_kind: builtin_numeric_host_kind(target)}
    if source.integer {
        if builtin_numeric_widening(source, target) -> return TNumericOp.CastAs{dst_rust: target.rust}
        return TNumericOp.TryFrom{host_kind: builtin_numeric_host_kind(target)}
    }
    TNumericOp.FloatToInt{host_kind: builtin_numeric_host_kind(target)}
}

builtin_static_numeric_row: fn(owner: String, method: String) -> BuiltinStaticRow? {
    target: builtin_numeric_kind(owner) ?? return None
    source_name: builtin_numeric_source(method) ?? return None
    source: builtin_numeric_kind(source_name) ?? return None
    Val(builtin_static(owner, method, [Type]{source.ty}, builtin_numeric_return(source, target), BuiltinStaticLowering.Numeric{operation: builtin_numeric_operation(source, target)}))
}

// Every row for `owner.method`, across modules; the caller admits the one
// whose module matches how the owner was named.
builtin_static_rows: fn(owner: String, method: String) -> [BuiltinStaticRow] Never! {
    rows := builtin_static_rows_in(BUILTIN_STATIC_ROWS, owner, method)
    if builtin_static_numeric_row(owner, method) == .Val(row) -> rows.push(row)
    rows
}

// The table is a read parameter, so the scan reads its rows in place.
builtin_static_rows_in: fn(table: [BuiltinStaticRow], owner: String, method: String) -> [BuiltinStaticRow] Never! {
    rows := [BuiltinStaticRow]{}
    loop row in table {
        if row.owner == owner && row.method == method -> rows.push(row.copy())
    }
    rows
}

builtin_static_is_type_param: fn(row: BuiltinStaticRow, name: String) -> Bool Never! {
    loop param in row.type_params {
        if param == name -> return true
    }
    false
}
