// Built-in type-owned static calls such as `Int.parse(text)`,
// `U8.from_int(value)`, `Atomic<Int>.new(0)`, and `crypto.Hasher.new()`.
//
// The fixed rows mirror the bootstrap's `Collections::builtin_static_return`,
// its `builtin_method_arg_types` entries, and the lowered node each static lowers
// to. Destination-owned numeric conversions are generated from the
// `numeric_conversion_return` widening law and `resolve_numeric_conversion_op`.
// `Clock.new/system/now`, `Date.today`, and `Path.home` keep their dedicated
// time and stream checkers. An absent row is deliberately uncovered.
//
// A row's `type_params` are placeholders written as `Type.Named(name)` in its
// parameter and return types. The first `owner_type_params` of them bind from
// the owner's explicit type arguments; the rest bind from the checked
// arguments, then the expected result, and otherwise default to `Int`.

BuiltinStaticLowering: enum {
    // The first value argument becomes the builtin receiver.
    ArgumentBuiltin(operation: TBuiltinOp)
    // `Int.from_radix(text, base)`: the text is the receiver; the op carries the call line.
    IntFromRadix
    // An inert Unit receiver; every value argument stays an argument.
    UnitBuiltin(operation: TBuiltinOp)
    // A Prelude associated function; `generics` are the owner arguments, written
    // over the row type parameters (`Type.Named(name)`) and substituted at the call.
    PreludeStatic(rooted: Bool, path: String, generics: [TPreludeArg])
    // `Duration.<unit>(value)`: the checked Int or Float value selects the route.
    DurationNew(unit: String)
    // A registered Core call; every value argument is a Core argument.
    CoreCall(module_name: String, member: String)
    EmptyMap
    Numeric(operation: TNumericOp)
    Precise(type_name: String, function: String)
}

BuiltinStaticOwnerRule: enum {
    Inferred
    // `Atomic<T>`: the owner names T explicitly and T is a lock-free scalar.
    AtomicScalar
}

BuiltinStaticRow: struct {
    // "" is an ambient built-in owner; otherwise the Core module exporting it.
    module_name: String
    owner: String
    method: String
    type_params: [String]
    owner_type_params: Int
    owner_rule: BuiltinStaticOwnerRule
    parameters: [Type]
    // How every argument passes: Read, or Move for a row that owns its
    // payload (`Shared{expr}`).
    parameter_convention: AccessConvention
    return_type: Type
    lowering: BuiltinStaticLowering
    arity_code: String
}

BuiltinNumericKind: struct {
    name: String
    ty: Type
    rust: String
    integer: Bool
    fixed: Bool
    signed: Bool
    bits: Int
}

BuiltinNumericSource: struct {
    method: String
    source: String
}

builtin_static: fn(owner: String, method: String, parameters: [Type], return_type: Type, lowering: BuiltinStaticLowering) -> BuiltinStaticRow Never! {
    BuiltinStaticRow{
        module_name: "",
        owner: owner,
        method: method,
        type_params: [String]{},
        owner_type_params: 0,
        owner_rule: BuiltinStaticOwnerRule.Inferred,
        parameters: parameters,
        parameter_convention: AccessConvention.Read,
        return_type: return_type,
        lowering: lowering,
        arity_code: "E0104",
    }
}

