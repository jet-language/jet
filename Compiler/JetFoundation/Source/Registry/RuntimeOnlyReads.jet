// The runtime exports that answer from the process they run in, whatever
// effect row they declare: the running task's identity and cancel state, the
// process id, whether a standard stream is a terminal, a World's clock,
// timers, tasks and history and the active World's store cells, the device
// store's cells, the UI host provider's live state, the receipt claim
// sections publish under, the thread a test World runs on, the test
// harness's suite runner and `jet test` plan file, the real-time
// worker a callback stream starts, and the platform family, module loader,
// path syntax and SIMD width of the machine the program runs on. A value
// computed while building would hold the
// compiler's own answer (a cross build would bake the build machine's
// platform into the image), so sema never computes a call that reaches one
// while compiling, a module value included
// (sema_comptime_call_facts_impurity). Listing a read here, not giving it a
// row, keeps it out of its callers' declared rows and package ceilings: a
// Core store kept in the World or on the device, or a UI service, does not
// take on a new effect.
RuntimeOnlyRead: struct {
    symbol: String,
    // What the export reads, as the refusal names it.
    reads: String,
}

RUNTIME_ONLY_READS: #run { [RuntimeOnlyRead]{
    RuntimeOnlyRead{symbol: "jet_rt_task_identity", reads: "the running task's identity"},
    RuntimeOnlyRead{symbol: "jet_scheduler_task_canceled_state", reads: "the running task's cancel state"},
    RuntimeOnlyRead{symbol: "jet_files_atomic_pid_raw", reads: "the running process's id"},
    RuntimeOnlyRead{symbol: "jet_term_stdout_is_terminal", reads: "whether the program's standard output is a terminal"},
    RuntimeOnlyRead{symbol: "jet_term_stderr_is_terminal", reads: "whether the program's standard error is a terminal"},
    RuntimeOnlyRead{symbol: "jet_term_is_terminal_raw", reads: "whether one of the program's streams is a terminal"},
    RuntimeOnlyRead{symbol: "jet_std_os_family", reads: "the platform family of the machine the program runs on"},
    RuntimeOnlyRead{symbol: "jet_files_path_windows_raw", reads: "the path syntax of the machine the program runs on"},
    RuntimeOnlyRead{symbol: "jet_mod_supported_raw", reads: "whether the machine the program runs on loads compiled modules"},
    RuntimeOnlyRead{symbol: "jet_mod_os_raw", reads: "the OS name of the machine the program runs on"},
    RuntimeOnlyRead{symbol: "jet_rt_world_store_load", reads: "the active World's store cells"},
    RuntimeOnlyRead{symbol: "jet_rt_world_store_replace", reads: "the active World's store cells"},
    RuntimeOnlyRead{symbol: "jet_world_now", reads: "a World's clock"},
    RuntimeOnlyRead{symbol: "jet_world_advance", reads: "a World's clock, timers and tasks"},
    RuntimeOnlyRead{symbol: "jet_world_wait_idle", reads: "a World's tasks"},
    RuntimeOnlyRead{symbol: "jet_world_history", reads: "a World's history"},
    RuntimeOnlyRead{symbol: "jet_rt_device_load", reads: "the device store's cells"},
    RuntimeOnlyRead{symbol: "jet_rt_device_replace", reads: "the device store's cells"},
    RuntimeOnlyRead{symbol: "jet_compute_simd_lanes", reads: "the f32 SIMD width of the CPU the program runs on"},
    RuntimeOnlyRead{symbol: "jet_ui_host_capability", reads: "the UI host provider's live state"},
    RuntimeOnlyRead{symbol: "jet_ui_host_clipboard_get", reads: "the UI host provider's live state"},
    RuntimeOnlyRead{symbol: "jet_ui_host_clipboard_set", reads: "the UI host provider's live state"},
    RuntimeOnlyRead{symbol: "jet_ui_host_event_pop", reads: "the UI host provider's live state"},
    RuntimeOnlyRead{symbol: "jet_ui_host_key_claim", reads: "the UI host provider's live state"},
    RuntimeOnlyRead{symbol: "jet_ui_host_dialog_request", reads: "the UI host provider's live state"},
    RuntimeOnlyRead{symbol: "jet_ui_host_dialog_result", reads: "the UI host provider's live state"},
    RuntimeOnlyRead{symbol: "jet_ui_host_save_file", reads: "the UI host provider's live state"},
    RuntimeOnlyRead{symbol: "jet_ui_host_device", reads: "the UI host provider's live state"},
    RuntimeOnlyRead{symbol: "jet_ui_host_device_bytes", reads: "the UI host provider's live state"},
    RuntimeOnlyRead{symbol: "jet_ui_web_attached", reads: "whether a web page attached to the running program"},
    RuntimeOnlyRead{symbol: "jet_ui_web_scene", reads: "the running program's latest web scene"},
    RuntimeOnlyRead{symbol: "jet_ui_click", reads: "the native window's live slot handlers"},
    RuntimeOnlyRead{symbol: "jet_ui_drop", reads: "the native window's live slot handlers"},
    RuntimeOnlyRead{symbol: "jet_ui_change", reads: "the native window's live slot handlers"},
    RuntimeOnlyRead{symbol: "jet_web_live_left", reads: "the live hub's topics whose last watching connection closed"},
    RuntimeOnlyRead{symbol: "jet_receipt_attach", reads: "the running program's receipt claim and directory"},
    RuntimeOnlyRead{symbol: "jet_testing_world_run", reads: "the running thread's World and its tasks"},
    RuntimeOnlyRead{symbol: "jet_test_suite_run", reads: "the test harness's suite runner"},
    RuntimeOnlyRead{symbol: "jet_test_setting", reads: "the `jet test` plan file the environment names"},
    RuntimeOnlyRead{symbol: "jet_rt_callback_start", reads: "the real-time worker thread the stream starts"},
} }

// What runtime export `symbol` reads when it is run-time only, else None. A
// Core row may name its export behind the crate that defines it
// (`jet_std.jet_files_atomic_pid_raw`: the last segment is the export).
runtime_only_read: fn(symbol: String) -> String? Never! {
    bare: symbol_key_leaf(symbol)
    loop row in RUNTIME_ONLY_READS {
        if row.symbol == bare -> return Val(row.reads.copy())
    }
    None
}
