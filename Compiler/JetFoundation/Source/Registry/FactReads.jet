// The typed compiler-fact reads: one table supplies the source `$` member,
// the reflected fact kind, the detail slot and the planes each read covers.
FactRead: enum {
    Layout Name Fields Range Dimension Measure Exactness Classification Obligation
    States Effects Sendability Movedness Attribution Origin ViewProvenance UnitScaleProvenance Maturity Uses
    RegisteredPlane(name: String)
    BuildPackageName BuildPackageVersion BuildOS BuildProfile BuildStampGit BuildStampDirty BuildStampToolchain BuildStampAt
}

FoundationFactReadRow: struct {
    read: FactRead
    member: String?
    reflection: String?
    detail: String?
    planes: [String]
}

foundation_fact_read_row: fn(read: &&FactRead, member: &&String, reflection: &&String, detail: &&String?, planes: &&[String]) -> FoundationFactReadRow Never! {
    FoundationFactReadRow{read: read.move(), member: Val(member.move()), reflection: Val(reflection.move()), detail: detail.move(), planes: planes.move()}
}

// Typed reads in registry order, then the program-wide marker uses, then
// the build profile, then the registered value planes without a dedicated
// carrier in Prelude declaration order.
FOUNDATION_FACT_READ_ROWS: comptime { [FoundationFactReadRow]{
    foundation_fact_read_row(FactRead.Layout, "$layout", "Layout", None, [String]{"Type.Layout"}),
    foundation_fact_read_row(FactRead.Name, "$name", "Nominal", None, [String]{"Type.Nominal"}),
    foundation_fact_read_row(FactRead.Fields, "$fields", "Layout", None, [String]{"Type.Layout"}),
    foundation_fact_read_row(FactRead.Range, "$range", "Range", Val("range"), [String]{"Type.Interval"}),
    foundation_fact_read_row(FactRead.Dimension, "$dimension", "Dimension", Val("dimension"), [String]{"Type.Dimension"}),
    foundation_fact_read_row(FactRead.Measure, "$measure", "Measure", Val("measure"), [String]{"Type.Measure"}),
    foundation_fact_read_row(FactRead.Exactness, "$exactness", "Exactness", Val("exactness"), [String]{"Type.Exactness", "Exactness"}),
    foundation_fact_read_row(FactRead.Classification, "$classification", "Classification", Val("classification"), [String]{"Type.Classification"}),
    foundation_fact_read_row(FactRead.Obligation, "$obligation", "Obligation", Val("obligation"), [String]{"Type.Obligation"}),
    foundation_fact_read_row(FactRead.States, "$states", "States", Val("state"), [String]{"States"}),
    foundation_fact_read_row(FactRead.Effects, "$effects", "Effects", None, [String]{"Effects"}),
    foundation_fact_read_row(FactRead.Sendability, "$sendability", "Sendability", Val("sendability"), [String]{"Sendability"}),
    foundation_fact_read_row(FactRead.Movedness, "$movedness", "Movedness", Val("movedness"), [String]{"Movedness"}),
    foundation_fact_read_row(FactRead.Attribution, "$attribution", "Attribution", Val("attribution"), [String]{"Attribution"}),
    foundation_fact_read_row(FactRead.Origin, "$origin", "Origin", Val("origin"), [String]{"Origin"}),
    foundation_fact_read_row(FactRead.ViewProvenance, "$view_provenance", "ViewProvenance", Val("view_provenance"), [String]{"ViewProvenance"}),
    foundation_fact_read_row(FactRead.UnitScaleProvenance, "$unit_scale_provenance", "UnitScaleProvenance", Val("unit_scale_provenance"), [String]{"UnitScaleProvenance"}),
    foundation_fact_read_row(FactRead.Maturity, "$maturity", "Maturity", Val("maturity"), [String]{"Maturity"}),
    // `M.reflect().uses`: every use of marker struct `M` in the program; no
    // fact plane carries it.
    FoundationFactReadRow{read: FactRead.Uses, member: Val("$uses"), reflection: None, detail: None, planes: [String]{}},
    FoundationFactReadRow{read: FactRead.BuildProfile, member: Val("$profile"), reflection: None, detail: None, planes: [String]{}},
    foundation_fact_read_row(FactRead.RegisteredPlane{name: "Flow"}, "$flow", "Flow", None, [String]{"Flow"}),
    foundation_fact_read_row(FactRead.RegisteredPlane{name: "Taint"}, "$taint", "Taint", None, [String]{"Taint"}),
    foundation_fact_read_row(FactRead.RegisteredPlane{name: "Duty"}, "$duty", "Duty", None, [String]{"Duty"}),
} }

// Every readable `$` member in table order.
fact_read_members: fn() -> [String] Never! {
    members := [String]{}
    loop row in FOUNDATION_FACT_READ_ROWS {
        if row.member == .Val(member) -> members.push(member.copy())
    }
    members
}

fact_read_kind: fn(member: String) -> FactRead? Never! {
    loop row in FOUNDATION_FACT_READ_ROWS {
        if row.member == .Val(source) {
            if source == member -> return Val(row.read.copy())
        }
    }
    None
}

fact_read_source_member: fn(read: FactRead) -> String? Never! {
    if read == .RegisteredPlane(_) -> return None
    loop row in FOUNDATION_FACT_READ_ROWS {
        if row.read == read -> return row.member.copy()
    }
    None
}

fact_read_reflection_kind: fn(read: FactRead) -> String? Never! {
    if read == .RegisteredPlane(name) {
        loop row in FOUNDATION_FACT_READ_ROWS {
            if row.planes.contains(name) -> return row.reflection.copy()
        }
        return None
    }
    loop row in FOUNDATION_FACT_READ_ROWS {
        if row.read == read -> return row.reflection.copy()
    }
    None
}

fact_read_detail_field: fn(read: FactRead) -> String? Never! {
    if read == .RegisteredPlane(_) -> return None
    loop row in FOUNDATION_FACT_READ_ROWS {
        if row.read == read -> return row.detail.copy()
    }
    None
}

// The public type a read reports; only `$origin` is optional provenance.
fact_read_public_read_type: fn(read: FactRead) -> String? Never! {
    if read == FactRead.Origin -> return Val("OriginInfo?")
    None
}
