use std.time.[SystemTime, UNIX_EPOCH]
// Rust: crates/jet-foundation/src/LiveLifecycle.rs:1
fn now_ms() -> U64 Never! {
    // GATE #4494: actual system clock. Rust specifies zero on pre-epoch/overflow.
    if SystemTime.now().duration_since(UNIX_EPOCH) == {
        .Ok(duration) -> U64.try_from(duration.as_millis()).ok() ?? 0
        .Err(_) -> 0
    }
}
// Rust: crates/jet-foundation/src/LiveLifecycle.rs:12
// Tier-neutral generation/cancellation/publication; payloads belong to adapters.
pub struct JetLiveLifecycle {
    pub generation: U64
    pub active: Bool
    pub dirty: Bool
    pub error: String
    pub fresh_at_ms: U64
    pub invalidation_cause: String
    pub refreshing: Bool
    pub cancelled: Bool
}
impl JetLiveLifecycle {
    // Rust: crates/jet-foundation/src/LiveLifecycle.rs:25
    pub fn active(now_ms: U64) -> JetLiveLifecycle Never! {
        JetLiveLifecycle{generation: 1, active: true, dirty: false, error: "",
            fresh_at_ms: now_ms, invalidation_cause: "", refreshing: false, cancelled: false}
    }
    // Rust: crates/jet-foundation/src/LiveLifecycle.rs:38
    pub fn active_now() -> JetLiveLifecycle Never! { JetLiveLifecycle.active(now_ms()) }
    // Rust: crates/jet-foundation/src/LiveLifecycle.rs:42
    pub fn error(error: String) -> JetLiveLifecycle Never! {
        JetLiveLifecycle{generation: 0, active: false, dirty: false, error: error,
            fresh_at_ms: 0, invalidation_cause: "", refreshing: false, cancelled: false}
    }
    // Rust: crates/jet-foundation/src/LiveLifecycle.rs:55
    pub fn is_current(self, generation: U64) -> Bool Never! {
        self.active && !self.cancelled && self.generation == generation
    }
    // Rust: crates/jet-foundation/src/LiveLifecycle.rs:59
    pub fn invalidate(&self, cause: String) -> Bool Never! {
        if !self.active -> return false
        self.generation = self.generation.saturating_add(1)
        self.dirty = true
        self.cancelled = false
        self.error.clear()
        self.invalidation_cause = cause
        true
    }
    // Rust: crates/jet-foundation/src/LiveLifecycle.rs:71
    pub fn begin_refresh(&self, generation: U64) -> Bool Never! {
        if !self.is_current(generation) || self.refreshing -> return false
        self.refreshing = true
        true
    }
    // Rust: crates/jet-foundation/src/LiveLifecycle.rs:79
    pub fn publish(&self, generation: U64, fresh_at_ms: U64) -> Bool Never! {
        current :: self.is_current(generation)
        self.refreshing = false
        if !current -> return false
        self.dirty = false
        self.error.clear()
        self.fresh_at_ms = fresh_at_ms
        true
    }
    // Rust: crates/jet-foundation/src/LiveLifecycle.rs:91
    pub fn fail(&self, generation: U64, error: String) -> Bool Never! {
        current :: self.is_current(generation)
        self.refreshing = false
        if !current -> return false
        self.error = error
        self.dirty = true
        true
    }
    // Rust: crates/jet-foundation/src/LiveLifecycle.rs:102
    pub fn cancel(&self) -> Bool Never! {
        if !self.active -> return false
        self.generation = self.generation.saturating_add(1)
        self.dirty = true
        self.refreshing = false
        self.cancelled = true
        self.invalidation_cause = "cancelled"
        true
    }
    // Rust: crates/jet-foundation/src/LiveLifecycle.rs:114
    pub fn close(&self) -> Bool Never! {
        if !self.active -> return false
        self.active = false
        self.refreshing = false
        self.cancelled = true
        true
    }
    // Rust: crates/jet-foundation/src/LiveLifecycle.rs:124
    pub fn freshness_ms(self) -> U64 Never! { now_ms().saturating_sub(self.fresh_at_ms) }
}
