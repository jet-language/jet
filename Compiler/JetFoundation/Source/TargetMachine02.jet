        if provider.len() == 0 || !self.sha256.starts_with("sha256:") -> return false
        digest := self.sha256.slice(7, self.sha256.len())
        trimmed := digest.trim() // #4303
        if trimmed.len() == 0 -> return false
        loop ch in digest.chars() -> if ch.is_whitespace() -> return false
