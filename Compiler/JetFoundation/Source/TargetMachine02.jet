impl TargetMachineUse {
    // Rust: crates/jet-foundation/src/TargetMachine.rs:3255 (derive Default)
    pub fn default() -> TargetMachineUse Never! {
        TargetMachineUse{stack_bytes: U64{0}, static_ram_bytes: U64{0}, heap_required: false, core_apis: [], mmio: [], required_capabilities: []}
