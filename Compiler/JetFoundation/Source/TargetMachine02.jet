    // Rust: crates/jet-foundation/src/TargetMachine.rs:3269
    pub fn from_core_apis(core_apis: [String]) -> TargetMachineUse Never! {
        usage := TargetMachineUse.default()
        sorted := ~core_apis
        &sorted.sort()
        loop api in sorted {
            if usage.core_apis.len() == 0 || usage.core_apis[usage.core_apis.len() - 1] != api -> &usage.core_apis.push(~api)
        }
        closure :: jet_ring_classify_prelude_closure(usage.core_apis)
        loop row in closure {
            if row.layer == MIRRuntimeLayer.Alloc || row.layer == MIRRuntimeLayer.Std { usage.heap_required = true; break }
        }
        loop api in usage.core_apis {
            loop capability in capabilities_for_core_usage(api) {
                // The capability universe has exactly fourteen entries, as in Rust.
                if !usage.required_capabilities.contains(capability) -> &usage.required_capabilities.push(capability)
            }
        }
