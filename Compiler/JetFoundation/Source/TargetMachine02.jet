        machine.linker = LinkerInput.Generated
        machine.allocator = AllocatorPolicy.None
        machine.panic = PanicPolicy.Abort
        source :: sensor_provider_source_contents(U64{0x40004008}, U64{0x40004004}, U64{0x40004000}, U64{0x40004010}, U64{0xE000E018})
        machine.mmio = MmioPolicy.Provider(builtin_provider("board.sensor_v1.mmio", source))
        machine.wall_clock = ClockPolicy.None
        machine.monotonic_clock = ClockPolicy.Provider(builtin_provider("board.sensor_v1.systick", source))
