// Rust: crates/jet-foundation/src/TargetMachine.rs:3295
fn capabilities_for_core_usage(api: String) -> [TargetCapability] Never! {
    module := api
    helper := ""
    if api.find("::") == .Val(at) {
        module = api.slice(0, at) // #4303
        helper = api.slice(at + 2, api.len()) // #4303
    }
    capabilities := [TargetCapability]{}
    if module == {
        "core.mem" -> if helper == "Atomic" || helper == "atomic" -> &capabilities.push(TargetCapability.Atomic64)
        "core.term" -> {
            if helper == "" || helper == ("input" | "readline" | "read_until" | "read_all_input" | "take" | "buffered" | "stdin" | "binread" | "read_key" | "confirm" | "choose" | "select") -> &capabilities.push(TargetCapability.IoRead)
            if helper == "" || helper == ("print" | "eprint" | "progress" | "binwrite" | "stdout" | "stderr" | "style" | "style_force") -> &capabilities.push(TargetCapability.IoWrite)
        }
        "core.concurrency" | "core.tasks" -> &capabilities.push(TargetCapability.Scheduler)
        "core.time" -> {
            if helper == ("sleep" | "delay" | "yield" | "wait") -> &capabilities.push(TargetCapability.TimeSleep)
            else if helper == ("instant" | "monotonic" | "elapsed" | "elapsed_millis") -> &capabilities.push(TargetCapability.TimeMonotonic)
            else if helper == ("zone" | "zone_data" | "named_zone") -> &capabilities.push(TargetCapability.TimeZoneData)
            else if helper != ("" | "typed_head" | "__duration__" | "duration") -> &capabilities.push(TargetCapability.TimeWall)
        }
        "core.crypto.random" | "core.crypto.uuid" -> &capabilities.push(TargetCapability.Entropy)
        "core.hardware" -> &capabilities.push(TargetCapability.Hardware)
        else -> {}
    }
    ^capabilities
}
