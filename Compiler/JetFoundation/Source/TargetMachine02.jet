    pub fn safety_review(self, usage: TargetMachineUse) -> SafetyReview Never! {
        mmio_gated := true
        mmio_in_region := true
        loop access in usage.mmio {
            if access.unsafe_gate == {
                .None -> mmio_gated = false
                .Val(gate) -> { reason := gate.reason.trim() // #4303
                    if reason.len() == 0 -> mmio_gated = false }
            }
            inside := false
            loop region in self.memory {
                if region.kind == MemoryKind.Mmio && region.contains(access.address, access.size) { inside = true; break }
            }
            if !inside -> mmio_in_region = false
        }
        SafetyReview{no_os: self.no_os,
            panic_explicit: self.panic != PanicPolicy.Unspecified && self.panic != PanicPolicy.HostedDefault,
            allocator_explicit: self.allocator != AllocatorPolicy.Unspecified && self.allocator != AllocatorPolicy.HostedDefault,
            linker_explicit: self.linker != LinkerInput.Unspecified,
            mmio_requires_unsafe: mmio_gated, mmio_inside_declared_regions: mmio_in_region,
            aot_only: self.no_os, transitive_memory_regions: self.memory.len()}
    }
