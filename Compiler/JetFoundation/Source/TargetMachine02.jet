    pub fn audit_json(self) -> String Never! {
        "{{\"provider\":{json_str(self.provider)},\"sha256\":{json_str(self.sha256)},\"provenance\":{json_str(self.provenance)},\"abi\":{self.abi.audit_json()},\"limits\":{self.limits.audit_json()}}}"
    }
}
