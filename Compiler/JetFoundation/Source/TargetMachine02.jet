    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:2835
    pub fn matches_source(self, source: View<U8>) -> Bool Never! {
        digest := mir_sha256_bytes(source)
        self.sha256 == "sha256:{mir_sha256_hex_bytes(digest[0..<digest.len()])}"
    }
    // Rust: crates/jet-foundation/src/TargetMachine.rs:2840
    pub fn with_provenance(^self, ^provenance: String) -> ProviderContract Never! { self.provenance = ^provenance; ^self }
