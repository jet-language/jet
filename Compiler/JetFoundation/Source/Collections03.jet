            &remainder.limbs.insert(0, dividend.limbs[index])
            remainder = remainder.normalize()
            low := U32{0}
            high := U32{CTBI_BASE - U64{1}}
            loop low < high {
                middle :: low + (high - low) / U32{2} + U32{1}
                if divisor.mul_small(middle).cmp_abs(remainder) <= I8{0} -> low = middle
                else -> high = middle - U32{1}
