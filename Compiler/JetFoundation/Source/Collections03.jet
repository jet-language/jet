            quotient[index] = low
            if low != U32{0} -> remainder = remainder.sub_abs(divisor.mul_small(low))
        }
        carried :: CtBigInt{negative: self.negative != other.negative, limbs: ^quotient}.normalize()
        remainder.negative = self.negative && !remainder.is_zero()
