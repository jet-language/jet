// Rust: crates/jet-foundation/src/Numeric.rs:206
pub fn decimal_method_return(method: String, nargs: Int) -> (Type?)? Never! {
    if (method, nargs) == {
        ("add" | "sub" | "mul", 1) -> Val(Val(Type.Named(Syntax.TYPE_DECIMAL)))
        ("div", 1) -> Val(Val(Type.Named(Syntax.TYPE_FRACTION)))
        ("round" | "floor" | "ceil", 0) -> Val(Val(Type.Named(Syntax.TYPE_DECIMAL)))
        ("equal", 1) -> Val(Val(Type.Bool))
        ("compare", 1) -> Val(Val(Type.Named(Syntax.TYPE_ORDERING)))
        ("to_string", 0) -> Val(Val(Type.String))
        ("to_float", 0) -> Val(Val(Type.Float))
        else -> None
    }
}
// Rust: crates/jet-foundation/src/Numeric.rs:222
pub fn fraction_method_return(method: String, nargs: Int) -> (Type?)? Never! {
    if (method, nargs) == {
        ("add" | "sub" | "mul" | "div", 1) -> Val(Val(Type.Named(Syntax.TYPE_FRACTION)))
        ("numerator" | "denominator", 0) -> Val(Val(Type.Int))
        ("to_string", 0) -> Val(Val(Type.String))
        ("to_float", 0) -> Val(Val(Type.Float))
        ("is_zero", 0) | ("equal", 1) -> Val(Val(Type.Bool))
        else -> None
    }
}
