    pub fn isqrt(self) -> CtBigInt? Never! {
        if self.negative -> return None
        if self.is_zero() -> return Val(~self)
        one :: CtBigInt.from_int(I64{1})
        two :: CtBigInt.from_int(I64{2})
        root := ~one
        loop _ in 0..<self.bit_width().saturating_add(1) / 2 -> root = root.mul_small(U32{2})
        loop {
            pair :: self.div_rem(root) ?? return None
            next_pair :: root.add(pair.0).div_rem(two) ?? return None
            next_root :: ^next_pair.0
