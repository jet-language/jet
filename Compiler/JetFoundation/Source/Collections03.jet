// Rust: crates/jet-foundation/src/Numeric.rs:35
pub fn precise_conversion_route(target_name: String, source_name: String) -> (owner: String, method: String)? Never! {
    if (target_name, source_name) == {
        (Syntax.TYPE_DECIMAL, "Int") -> Val((Syntax.TYPE_DECIMAL, "from_int"))
        (Syntax.TYPE_DECIMAL, "Float") -> Val((Syntax.TYPE_DECIMAL, "from_float"))
        (Syntax.TYPE_DECIMAL, Syntax.TYPE_FRACTION) -> Val((Syntax.TYPE_DECIMAL, "from_fraction"))
        (Syntax.TYPE_FRACTION, "Int") -> Val((Syntax.TYPE_FRACTION, "from_int"))
        (Syntax.TYPE_FRACTION, "Float") -> Val((Syntax.TYPE_FRACTION, "from_float"))
        (Syntax.TYPE_FRACTION, Syntax.TYPE_DECIMAL) -> Val((Syntax.TYPE_FRACTION, "from_decimal"))
        ("Float", Syntax.TYPE_DECIMAL) -> Val((Syntax.TYPE_DECIMAL, "to_float"))
        ("Float", Syntax.TYPE_FRACTION) -> Val((Syntax.TYPE_FRACTION, "to_float"))
        ("Int", Syntax.TYPE_DECIMAL) -> Val((Syntax.TYPE_DECIMAL, "to_int"))
        ("Int", Syntax.TYPE_FRACTION) -> Val((Syntax.TYPE_FRACTION, "to_int"))
        else -> None
    }
}
// Rust: crates/jet-foundation/src/Numeric.rs:61
pub fn precise_conversion_return(target: Type, method: String, nargs: Int) -> (Type?)? Never! {
    if nargs != 1 -> return None
    source_name :: Syntax.numeric_conversion_source(method) ?? return None
    target_name :: if target == {
        .Int -> "Int"
        .Float -> "Float"
        .Named(name) -> { if !is_exact_type_name(name) -> return None; name }
        else -> return None
    }
    _ :: precise_conversion_route(target_name, source_name) ?? return None
    Val(Val(~target))
}
