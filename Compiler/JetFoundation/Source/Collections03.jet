    if decimal_delta > I64{400} -> return ctbi_ratio_inf(negative)
    if decimal_delta < I64{-400} -> return ctbi_ratio_zero(negative)
    exponent := ctbi_ratio_exponent(numerator, denominator)
    loop {
        if ctbi_ratio_cmp_pow2(numerator, denominator, exponent) == .Less { exponent -= I64{1}; next }
        if ctbi_ratio_cmp_pow2(numerator, denominator, exponent + I64{1}) != .Less { exponent += I64{1}; next }
        break
    }
    if exponent > I64{1023} -> return ctbi_ratio_inf(negative)
    if exponent < I64{-1075} -> return ctbi_ratio_zero(negative)
    if exponent == I64{-1075} {
        scaled := ~numerator
        ctbi_limb_shift_left(&scaled, 1074)
        ctbi_limb_double(&scaled)
        magnitude :: if ctbi_limb_cmp(scaled, denominator) == .Greater -> F64.from_bits(U64{1}) else -> 0.0
        return if negative -> -magnitude else -> magnitude
    }
    divisor_storage := [U32]{}
    remainder := ~numerator
    if exponent > I64{0} {
        &divisor_storage.extend(~denominator)
        ctbi_limb_shift_left(&divisor_storage, Int{exponent})
    } else if exponent < I64{0} -> ctbi_limb_shift_left(&remainder, Int{exponent.unsigned_abs()})
    divisor :: if exponent > I64{0} -> divisor_storage else -> denominator
    ctbi_limb_sub_assign(&remainder, divisor)
    significand := U64{1} << 52
    loop shift in (0..<52).rev() {
        ctbi_limb_double(&remainder)
        if ctbi_limb_cmp(remainder, divisor) != .Less {
            ctbi_limb_sub_assign(&remainder, divisor)
            significand |= U64{1} << shift
        }
    }
    ctbi_limb_double(&remainder)
    guard :: ctbi_limb_cmp(remainder, divisor) != .Less
    if guard -> ctbi_limb_sub_assign(&remainder, divisor)
    sticky :: !ctbi_limb_is_zero(remainder)
    if guard && (sticky || (significand & U64{1}) != U64{0}) {
        significand += U64{1}
        if significand == (U64{1} << 53) { significand >>= 1; exponent += I64{1} }
