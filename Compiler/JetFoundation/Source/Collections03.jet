    pub fn compare(self, other: CtBigInt) -> Ordering Never! {
        if (self.negative, other.negative) == {
            (false, true) -> .Greater
            (true, false) -> .Less
            (false, false) -> if self.cmp_abs(other) == { I8{1} -> .Greater I8{-1} -> .Less else -> .Equal }
            (true, true) -> if self.cmp_abs(other) == { I8{1} -> .Less I8{-1} -> .Greater else -> .Equal }
        }
