use CLISchema.[CLICommandSchema, CLISubcommandSchema, CLIInputSchema, CLIInputShape, CLIValueKind, CLIDefault, MetadataError, JobFact, JobRegistry, MACH_SECTION, WASM_SECTION, bounds, read_num, usize_num, c_name, command_payload_params]
