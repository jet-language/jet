// Extends the canonical MIR module; declarations mapped below stay in MIR.jet.
use core.sys.target as mir_wire_target
// GATE #4494: Rust std names for shared allocation, pointer identity and poisoned mutex guards.
use std.sync.[Arc, Mutex]

// Rust: crates/jet-foundation/src/MIR.rs:5461
impl MIRLoopSourceKind {
    pub fn from_wire(wire: String) -> MIRLoopSourceKind? Never! {
        if wire == {
            "plain" -> return Val(.Plain)
            "chars" -> return Val(.Chars)
            "lines:file" -> return Val(.LinesFile)
            "lines:stdin" -> return Val(.LinesStdin)
            "lines:process" -> return Val(.LinesProcessStream)
            "channel" -> return Val(.ChannelReceiver)
            else -> {}
        }
        bytes :: wire.bytes()
        if wire.starts_with("encoding:") {
            at := 9
            reader_type :: mir_loop_wire_take(bytes, &at) ?? return None
            if reader_type == "" || at != bytes.len() -> return None
            return Val(.EncodingReader(reader_type))
        }
        if !wire.starts_with("iterable:") -> return None
        at := 9
        coll_type :: mir_loop_wire_take(bytes, &at) ?? return None
        if at >= bytes.len() || bytes[at] != U8{58} -> return None
        at += 1
        iter_type :: mir_loop_wire_take(bytes, &at) ?? return None
        if at >= bytes.len() || bytes[at] != U8{58} -> return None
        at += 1
        iter_symbol :: mir_loop_wire_take(bytes, &at) ?? return None
        if at >= bytes.len() || bytes[at] != U8{58} -> return None
        at += 1
        next_symbol :: mir_loop_wire_take(bytes, &at) ?? return None
        if coll_type == "" || iter_type == "" || iter_symbol == "" || next_symbol == "" || at != bytes.len() -> return None
        Val(.Iterable(coll_type, iter_type, iter_symbol, next_symbol))
    }
}

// Rust: crates/jet-foundation/src/MIR.rs:5462
// Parse unsigned usize exactly (including Rust's optional leading '+'). Byte
// bounds and UTF-8 validation reject split codepoints, overflow and trailing data.
fn mir_loop_wire_take(bytes: [U8], at: &Int) -> String? Never! {
    // GATE #4483: selected usize maximum, never the compiler host width.
    maximum :: mir_wire_target.usize_max()
    cursor := at
    if cursor < bytes.len() && bytes[cursor] == U8{43} -> cursor += 1
    digit_start :: cursor
    length := U64{0}
    loop cursor < bytes.len() && bytes[cursor] != U8{58} {
        byte :: bytes[cursor]
        if byte < U8{48} || byte > U8{57} -> return None
        digit :: U64.from_u8(byte - U8{48})
        if length > (maximum - digit) / U64{10} -> return None
        length = length * U64{10} + digit
        cursor += 1
    }
    if cursor == digit_start || cursor >= bytes.len() -> return None
    if U64{cursor} == maximum -> return None
    start :: cursor + 1
    if length > maximum - U64{start} -> return None
    end :: start + Int.from_u64(length)
    if end > bytes.len() -> return None
    payload :: String.from_bytes(bytes.view(start..<end)) ?? return None
    at = end
    Val(payload)
}

// Rust: crates/jet-foundation/src/MIR.rs:5520
// MirCopyFact -> MIR.jet::MIRCopyFact (all five variants).
// Rust: crates/jet-foundation/src/MIR.rs:5536
// MirCopyFact::as_str -> MIR.jet::mir_copy_fact_name.
