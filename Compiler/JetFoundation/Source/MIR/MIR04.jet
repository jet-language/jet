// Rust: crates/jet-foundation/src/MIR.rs:6318
pub struct MIRArtifactRequest {
    pub target: MIRArtifactTarget
    pub kind: MIRArtifactKind
    pub mode: MIRArtifactBuildMode
    pub name: String?
    // Rust: crates/jet-foundation/src/MIR.rs:6326
    pub fn new(target: MIRArtifactTarget, kind: MIRArtifactKind, mode: MIRArtifactBuildMode) -> MIRArtifactRequest Never! {
        MIRArtifactRequest{target: target, kind: kind, mode: mode, name: None}
    }
    // Rust: crates/jet-foundation/src/MIR.rs:6339
    pub fn with_name(^self, name: String) -> MIRArtifactRequest Never! {
        self.name = Val(^name)
        ^self
    }
}
