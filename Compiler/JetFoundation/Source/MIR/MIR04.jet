// Rust: crates/jet-foundation/src/MIR.rs:5557
// MirOperation -> MIR.jet::MIROperation (every variant, in canonical owner).

// Rust: crates/jet-foundation/src/MIR.rs:5727
impl MIROperation {
    pub fn value_uses(self) -> [MIRValueID] Never! {
        out := [MIRValueID]{}
        if self == {
            .Parameter(_, _) -> {}
            .Capture(_) -> {}
            .Global(_) -> {}
            .Constant(_) -> {}
            .Absent -> {}
            .Todo(_, _, _) -> {}
            .Never(_) -> {}
            .ScopeExit(_) -> {}
            .ScopeEnter(_, member) -> {
                if member == Val(.Timeout(duration)) -> &out.push(duration)
            }
            .Phi(incoming) -> { loop row in incoming -> &out.push(row.value) }
            .ReadPlace(_) -> {}
            .MovePlace(_) -> {}
            .InitializeUninit(_) -> {}
            .WritePlace(_, value) -> &out.push(value)
            .ReplacePlace(_, value) -> &out.push(value)
            .Copy(value, _) -> &out.push(value)
            .Move(value) -> &out.push(value)
            .TraitBox(value, _) -> &out.push(value)
            .Unary(_, value) -> &out.push(value)
            .Deref(value) -> &out.push(value)
            .AttachTag(value, _) -> &out.push(value)
            .Drop(value, _) -> &out.push(value)
            .Present(value) -> &out.push(value)
            .ResultOk(value) -> &out.push(value)
            .ResultErr(value) -> &out.push(value)
            .Binary(_, _, _, left, right) -> { &out.push(left); &out.push(right) }
            .BuildList(values, _) -> { loop value in values -> &out.push(value) }
            .EnumIs(subject, _, _) -> &out.push(subject)
            .EnumPayload(subject, _, _, _) -> &out.push(subject)
            .OptionIsSome(subject) -> &out.push(subject)
            .OptionValue(subject) -> &out.push(subject)
            .ResultIsOk(subject) -> &out.push(subject)
            .ResultValue(subject, _) -> &out.push(subject)
            .PatternCapture(subject, _) -> &out.push(subject)
            .PatternMatched(subject) -> &out.push(subject)
            .BuildString(parts) -> {
                loop part in parts { if part == .Value(value) -> &out.push(value) }
            }
            .BuildMap(entries) -> {
                loop entry in entries { &out.push(entry.key); &out.push(entry.value) }
            }
            .ProjectMembers(base, _) -> &out.push(base)
            .Field(base, _) -> &out.push(base)
            .Index(_, base, index, _, _, _, _) -> { &out.push(base); &out.push(index) }
            .Slice(_, base, start, end, range, _) -> {
                &out.push(base); &out.push(start); &out.push(end)
                if range == Val(value) -> &out.push(value)
            }
            .Range(start, end, _) -> { &out.push(start); &out.push(end) }
            .Struct(_, fields) -> { loop field in fields -> &out.push(field.value) }
            .Tuple(_, fields) -> { loop field in fields -> &out.push(field.value) }
            .Enum(_, _, args) -> { loop arg in args -> &out.push(arg.value) }
            .Call(callee, args, _) -> {
                collect_callee_uses(callee, &out)
                loop arg in args -> &out.push(arg.value)
            }
            .CoreCall(_, _, args, _, _, _) -> { loop arg in args -> &out.push(arg.value) }
            .IndirectCall(callee, args, _) -> {
                &out.push(callee)
                loop arg in args -> &out.push(arg.value)
            }
            .Closure(_, captures, _) -> {
                loop capture in captures { if capture == .Value(value) -> &out.push(value) }
            }
            .PtrFromAddr(addr, _) -> &out.push(addr)
            .RawAddressOf(_) -> {}
            .AddressOf(_, _) -> {}
            .Convert(value, parameters, _, _) -> {
                &out.push(value)
                loop parameter in parameters -> &out.push(parameter)
            }
            .Semantic(operation) -> { loop value in mir_semantic_op_value_uses(operation) -> &out.push(value) }
            .LoopRangeInit(_, start, end, step, _) -> {
                &out.push(start); &out.push(end)
                if step == Val(value) -> &out.push(value)
            }
            .LoopRangeHasNext(_, cursor) -> &out.push(cursor)
            .LoopRangeValue(_, cursor) -> &out.push(cursor)
            .LoopRangeAdvance(_, cursor) -> &out.push(cursor)
            .LoopIterHasNext(_, cursor) -> &out.push(cursor)
            .LoopIterValue(_, cursor) -> &out.push(cursor)
            .LoopIterAdvance(_, cursor) -> &out.push(cursor)
            .LoopIterInit(_, collection, step, _, _) -> {
                &out.push(collection)
                if step == Val(value) -> &out.push(value)
            }
        }
        out
    }
}

// Rust: crates/jet-foundation/src/MIR.rs:5849
fn collect_callee_uses(callee: MIRCallee, out: &[MIRValueID]) Never! {
    if callee == .Indirect(value) -> &out.push(value)
}

