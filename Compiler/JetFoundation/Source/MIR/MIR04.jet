// MirCffiFacts -> MIR.jet::MIRCffiFacts.
impl MIRCffiFacts {
    // Rust: crates/jet-foundation/src/MIR.rs:5964
    pub fn boundary_for(self, library: String) -> ?@MIRFFIBoundaryFacts from self {
        loop index in 0..<self.boundaries.len() {
            if self.boundaries[index].library == library -> return Val(@self.boundaries[index])
        }
        None
    }
    // Rust: crates/jet-foundation/src/MIR.rs:5970
    pub fn validate_boundaries(self) Err! {
        libraries := [String:Bool]{}
        loop boundary in self.boundaries {
            boundary.validate()
            if libraries.get(boundary.library) != None -> return Err("MIR carries duplicate foreign boundary `{boundary.library}`")
            libraries[boundary.library] = true
        }
        return
    }
    // Rust: crates/jet-foundation/src/MIR.rs:5953 (derived Default)
    pub fn default() -> MIRCffiFacts Never! {
        MIRCffiFacts{import_links: [], libs: [], overlay_overrides: [], boundaries: [],
            direct_links: [], transitive_links: [], close_adapters: []}
    }
}

