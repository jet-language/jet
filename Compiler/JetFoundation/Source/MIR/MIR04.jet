// Rust: crates/jet-foundation/src/MIR.rs:6025
// Every cloned token retains the SAME state; native address reuse cannot change
// its identity or permit a second take. Shared pointer and mutex are #4494 gates.
#Clone
pub struct MIRHandleToken {
    state: Arc<MIRHandleTokenState>
    // Rust: crates/jet-foundation/src/MIR.rs:6036
    pub fn new(handle: MIRHandleID, raw: I64) -> MIRHandleToken Never! {
        MIRHandleToken{state: Arc.new(MIRHandleTokenState{handle: handle, raw: Mutex.new(Val(raw))})}
    }
    // Rust: crates/jet-foundation/src/MIR.rs:6045
    pub fn handle_id(self) -> MIRHandleID Never! { self.state.handle }
    // Rust: crates/jet-foundation/src/MIR.rs:6049
    pub fn identity(self) -> U64 Never! {
        // GATE #4494/#4483: Arc pointer identity converted losslessly to usize.
        Arc.as_ptr(self.state).as_usize()
    }
    // Rust: crates/jet-foundation/src/MIR.rs:6053
    pub fn raw(self) -> I64? Never! {
        guard := self.state.raw.lock() ?? err.into_inner()
        ~guard.value
    }
    // Rust: crates/jet-foundation/src/MIR.rs:6062
    pub fn take_raw(self) -> (MIRHandleID, I64)? Never! {
        guard := self.state.raw.lock() ?? err.into_inner()
        raw :: guard.value ?? return None
        guard.value = None
        Val((self.state.handle, raw))
    }
    // Rust: crates/jet-foundation/src/MIR.rs:6072
    pub fn is_taken(self) -> Bool Never! { self.raw() == None }
}
// Rust: crates/jet-foundation/src/MIR.rs:6030
struct MIRHandleTokenState { handle: MIRHandleID, raw: Mutex<I64?> }

