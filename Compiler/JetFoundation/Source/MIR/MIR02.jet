impl MIRDecisionRow {
    // Rust: crates/jet-foundation/src/MIR.rs:2634
    pub fn new(kind: MIRDecisionKind, disposition: MIRDecisionDisposition, function: MIRFunctionID?, function_name: String, span: Span, rule: String, reason: String, producer: String, evidence: String) -> MIRDecisionRow Never! {
        function_id :: if function == .Val(id) -> id.value else -> U64{0}
        identity :: "{kind.as_str()}|{disposition.as_str()}|{function_id}|{span.start}|{span.end}|{rule}|{reason}"
        MIRDecisionRow{id: stable_id("mir-decision", identity), kind: kind, disposition: disposition, function: function, function_name: function_name, span: span, rule: rule, reason: reason, producer: producer, evidence: evidence, edit: None, derivation: None, identity: None, evidence_method: None, derivation_disposition: None}
    }
    // Rust: crates/jet-foundation/src/MIR.rs:2678
    pub fn with_edit(^self, span: Span, replacement: String) -> MIRDecisionRow Never! { self.edit = Val(MIRDecisionEdit{span: span, replacement: replacement}); ^self }
}
// Rust: crates/jet-foundation/src/MIR.rs:2697
pub struct MIRDecisionLedger {
    pub identity: MIRDecisionIdentity
    pub rows: [MIRDecisionRow]
    pub derivations: [DerivationRecord]
}
impl MIRDecisionLedger {
    // Rust: crates/jet-foundation/src/MIR.rs:2704
    pub fn from_rows(identity: MIRDecisionIdentity, rows: ^[MIRDecisionRow]) -> MIRDecisionLedger Never! {
        canonical_rows := [MIRDecisionRow]{}
        indexes := [U64:Int]{}
        loop row in ^rows {
            if indexes.get(row.id) == .Val(index) {
                if canonical_rows[index].edit == None -> canonical_rows[index].edit = ^row.edit
                if canonical_rows[index].evidence.is_empty() -> canonical_rows[index].evidence = ^row.evidence
                continue
            }
            indexes[row.id] = canonical_rows.len()
            &canonical_rows.push(^row)
        }
        derivations := [DerivationRecord]{}
        compact_identity :: identity.derivation_identity()
        loop &row in canonical_rows {
            method :: row.evidence_method ?? (if row.evidence.contains("proof") || row.evidence.contains("static-flow") -> MIRDerivationMethod.FormalProof else -> MIRDerivationMethod.StaticDerivation)
            disposition :: if row.disposition == { .Unavailable -> MIRDerivationDisposition.Unavailable; .NotAttempted -> MIRDerivationDisposition.Unknown; else -> MIRDerivationDisposition.Current }
            subject :: "{row.kind.as_str()}:{row.function_name}:{row.span.start}-{row.span.end}"
            claim :: "{row.kind.as_str()}:{row.disposition.as_str()}:{row.rule}"
            derivation := derivation_record(subject, claim, row.producer, method, row.rule, [String]{row.reason, row.evidence, "row-id={row.id}"}, compact_identity)
            derivation.disposition = disposition
            row.derivation = Val(derivation_record_reference(derivation))
            row.identity = Val(identity)
            row.evidence_method = Val(method)
            row.derivation_disposition = Val(disposition)
            &derivations.push(^derivation)
        }
        MIRDecisionLedger{identity: identity, rows: ^canonical_rows, derivations: ^derivations}
    }
    // Rust: crates/jet-foundation/src/MIR.rs:2785
    pub fn canonical_json(self) -> String Never! {
        rows := [String]{}
        loop row in self.rows -> &rows.push(decision_row_json(row))
        "{{\"identity\":{decision_identity_json(self.identity)},\"rows\":[{rows.join(",")}],\"schema\":\"jet.mir.decisions.v1\"}}"
    }
    // Rust: crates/jet-foundation/src/MIR.rs:2803
    pub fn from_json(payload: String) -> MIRDecisionLedger Err! {
        root :: foundation_parse_protocol_json(payload) ?? return Err("decision ledger payload is not valid JSON")
        root_fields :: if root == .Object(_) -> decision_object(root, "decision ledger payload") else -> return Err("decision ledger payload must be an object")
        schema_ok :: if root_fields.get("schema") == .Val(.Text(schema)) -> schema == "jet.mir.decisions.v1" else -> false
        if root_fields.len() != 3 || !schema_ok -> return Err("decision ledger payload has an unsupported schema")
        identity :: parse_decision_identity(root_fields.get("identity") ?? return Err("decision ledger payload has no identity"))
        rows_value :: root_fields.get("rows") ?? return Err("decision ledger payload has no rows")
        values :: if rows_value == .Array(items) -> items else -> return Err("decision ledger payload rows must be an array")
        if values.len() > 4096 -> return Err("decision ledger payload has too many rows")
        rows := [MIRDecisionRow]{}
        transported := [U64:MIRDecisionRow]{}
        loop value in values {
            row :: parse_decision_row(value)
            if !transported.contains_key(row.id) -> transported[row.id] = row
            &rows.push(row)
        }
        ledger :: MIRDecisionLedger.from_rows(identity, ^rows)
        loop row in ledger.rows {
            source :: transported.get(row.id) ?? return Err("decision ledger payload lost a row during materialization")
            if source.identity != Val(ledger.identity) || source.derivation != row.derivation || source.evidence_method != row.evidence_method || source.derivation_disposition != row.derivation_disposition -> return Err("decision ledger row {row.id} has an untrusted derivation relation")
        }
        if ledger.canonical_json() != payload -> return Err("decision ledger payload is not canonical JSON")
        ledger
    }
    // Rust: crates/jet-foundation/src/MIR.rs:2862
    pub fn row(self, id: U64) -> (@MIRDecisionRow)? Never! from self {
        loop row in self.rows { if row.id == id -> return Val(@row) }
        None
    }
    // Rust: crates/jet-foundation/src/MIR.rs:2867
    pub fn derivation(self, reference: MIRDerivationRef) -> (@DerivationRecord)? Never! from self {
        loop record in self.derivations { if record.id == reference.id -> return Val(@record) }
        None
    }
}
// Rust: crates/jet-foundation/src/MIR.rs:2873
fn decision_json_string(value: String) -> String Never! { foundation_json_quote(value) }
// Rust: crates/jet-foundation/src/MIR.rs:2877
fn decision_identity_json(identity: MIRDecisionIdentity) -> String Never! {
    "{{\"artifact\":{decision_json_string(identity.artifact)},\"configuration\":{decision_json_string(identity.configuration)},\"implementation\":{decision_json_string(identity.implementation)},\"profile\":{decision_json_string(identity.profile)},\"run\":{decision_json_string(identity.run)},\"source\":{decision_json_string(identity.source)},\"target\":{decision_json_string(identity.target)}}}"
}
// Rust: crates/jet-foundation/src/MIR.rs:2890
fn decision_span_json(span: Span) -> String Never! { "{{\"end\":{span.end},\"start\":{span.start}}}" }
// Rust: crates/jet-foundation/src/MIR.rs:2894
fn decision_optional_identity_json(identity: MIRDecisionIdentity?) -> String Never! { if identity == .Val(value) -> decision_identity_json(value) else -> "null" }
// Rust: crates/jet-foundation/src/MIR.rs:2898
fn decision_edit_json(edit: MIRDecisionEdit?) -> String Never! {
    if edit == .Val(value) -> "{{\"replacement\":{decision_json_string(value.replacement)},\"span\":{decision_span_json(value.span)}}}" else -> "null"
}
// Rust: crates/jet-foundation/src/MIR.rs:2911
fn decision_derivation_ref_json(reference: MIRDerivationRef?) -> String Never! {
    if reference == .Val(value) -> "{{\"id\":{decision_json_string(value.id)}}}" else -> "null"
}
// Rust: crates/jet-foundation/src/MIR.rs:2918
fn decision_row_json(row: MIRDecisionRow) -> String Never! {
    function :: if row.function == None -> "null" else -> decision_json_string(row.function_name)
    function_id :: if row.function == .Val(id) -> decision_json_string("{id.value}") else -> "null"
    method :: if row.evidence_method == .Val(value) -> decision_json_string(derivation_method_raw(value)) else -> "null"
    disposition :: if row.derivation_disposition == .Val(value) -> decision_json_string(derivation_disposition_text(value)) else -> "null"
    "{{\"derivation_disposition\":{disposition},\"derivation_ref\":{decision_derivation_ref_json(row.derivation)},\"disposition\":{decision_json_string(row.disposition.as_str())},\"edit\":{decision_edit_json(row.edit)},\"evidence\":{decision_json_string(row.evidence)},\"evidence_method\":{method},\"function\":{function},\"function_id\":{function_id},\"function_name\":{decision_json_string(row.function_name)},\"id\":{decision_json_string("{row.id}")},\"identity\":{decision_optional_identity_json(row.identity)},\"kind\":{decision_json_string(row.kind.as_str())},\"producer\":{decision_json_string(row.producer)},\"reason\":{decision_json_string(row.reason)},\"rule\":{decision_json_string(row.rule)},\"span\":{decision_span_json(row.span)}}}"
}
// Rust: crates/jet-foundation/src/MIR.rs:2955
fn decision_object(value: DataTree, label: String) -> [String:DataTree] Err! {
    if value == .Object(entries) {
        fields := [String:DataTree]{}
        loop entry in entries -> fields[entry.key] = entry.value
        return ^fields
    }
    Err("{label} must be an object")
}
// Rust: crates/jet-foundation/src/MIR.rs:2966
fn decision_text(fields: [String:DataTree], key: String, label: String) -> String Err! {
    if fields.get(key) == .Val(.Text(value)) -> return value
    Err("{label} has invalid `{key}`")
}
// Rust: crates/jet-foundation/src/MIR.rs:2982
fn decision_u64(fields: [String:DataTree], key: String, label: String) -> U64 Err! {
    value :: decision_text(fields, key, label)
    bytes :: value.bytes()
    start :: if bytes.len() > 0 && bytes[0] == U8{43} -> 1 else -> 0
    if start == bytes.len() -> return Err("{label} has invalid `{key}`")
    result := U64{0}
    loop index in start..<bytes.len() {
        byte :: bytes[index]
        if byte < U8{48} || byte > U8{57} -> return Err("{label} has invalid `{key}`")
        digit :: U64.from_u8(byte - U8{48})
        if result > (U64{18446744073709551615} - digit) / U64{10} -> return Err("{label} has invalid `{key}`")
        result = result * U64{10} + digit
    }
    result
}
// Rust: crates/jet-foundation/src/MIR.rs:2998
fn decision_optional_u64(fields: [String:DataTree], key: String, label: String) -> U64? Err! {
    if fields.get(key) == { .Val(.Null) -> None; .Val(_) -> Val(decision_u64(fields, key, label)); .None -> Err("{label} has no `{key}`") }
}
// Rust: crates/jet-foundation/src/MIR.rs:3010
fn parse_decision_identity(value: DataTree) -> MIRDecisionIdentity Err! {
    fields :: decision_object(value, "decision identity")
    keys :: [String]{"artifact", "configuration", "implementation", "profile", "run", "source", "target"}
    if fields.len() != keys.len() -> return Err("decision identity has missing or unsafe fields")
    loop key in keys { if !fields.contains_key(key) -> return Err("decision identity has missing or unsafe fields") }
    MIRDecisionIdentity{artifact: decision_text(fields, "artifact", "decision identity"), configuration: decision_text(fields, "configuration", "decision identity"), implementation: decision_text(fields, "implementation", "decision identity"), profile: decision_text(fields, "profile", "decision identity"), run: decision_text(fields, "run", "decision identity"), source: decision_text(fields, "source", "decision identity"), target: decision_text(fields, "target", "decision identity")}
}
// Rust: crates/jet-foundation/src/MIR.rs:3037
fn parse_decision_span(value: DataTree) -> Span Err! {
    fields :: decision_object(value, "decision span")
    if fields.len() != 2 || !fields.contains_key("start") || !fields.contains_key("end") -> return Err("decision span has missing or unsafe fields")
    start_word :: decision_u64(fields, "start", "decision span")
    // GATE #4483: usize conversion uses selected-target width, never host width.
    bits :: decision_target.selected_pointer_bits()
    if bits < 64 && start_word > ((U64{1} << bits) - U64{1}) -> return Err("decision span start is out of range")
    end_word :: decision_u64(fields, "end", "decision span")
    if bits < 64 && end_word > ((U64{1} << bits) - U64{1}) -> return Err("decision span end is out of range")
    Span{start: Int.from_u64(start_word), end: Int.from_u64(end_word)}
}
// Rust: crates/jet-foundation/src/MIR.rs:3049
fn parse_decision_kind(value: String) -> MIRDecisionKind? Never! {
    if value == { "tier" -> Val(.Tier); "inline" -> Val(.Inline); "vectorize" -> Val(.Vectorize); "parallel" -> Val(.Parallel); "copy" -> Val(.Copy); "bounds" -> Val(.Bounds); "deopt" -> Val(.Deopt); "unreachable" -> Val(.Unreachable); "loop-invariant" -> Val(.LoopInvariant); else -> None }
}
// Rust: crates/jet-foundation/src/MIR.rs:3064
fn parse_decision_disposition(value: String) -> MIRDecisionDisposition? Never! {
    if value == { "accepted" -> Val(.Accepted); "rejected" -> Val(.Rejected); "selected" -> Val(.Selected); "not-attempted" -> Val(.NotAttempted); "unavailable" -> Val(.Unavailable); else -> None }
}
// Rust: crates/jet-foundation/src/MIR.rs:3075
fn parse_decision_optional_identity(value: DataTree?) -> MIRDecisionIdentity? Err! {
    if value == { .None | .Val(.Null) -> None; .Val(item) -> Val(parse_decision_identity(item)) }
}
// Rust: crates/jet-foundation/src/MIR.rs:3084
fn parse_decision_optional_edit(value: DataTree?) -> MIRDecisionEdit? Err! {
    item :: value ?? return Err("decision row has no `edit`")
    if item == .Null -> return None
    fields :: decision_object(item, "decision edit")
    if fields.len() != 2 || !fields.contains_key("replacement") || !fields.contains_key("span") -> return Err("decision edit has missing or unsafe fields")
    Val(MIRDecisionEdit{replacement: decision_text(fields, "replacement", "decision edit"), span: parse_decision_span(fields.get("span") ?? return Err("decision edit has no span"))})
}
// Rust: crates/jet-foundation/src/MIR.rs:3107
fn parse_decision_optional_ref(value: DataTree?) -> MIRDerivationRef? Err! {
    item :: value ?? return Err("decision row has no `derivation_ref`")
    if item == .Null -> return None
    fields :: decision_object(item, "decision derivation reference")
    if fields.len() != 1 || !fields.contains_key("id") -> return Err("decision derivation reference has missing or unsafe fields")
    Val(MIRDerivationRef{id: decision_text(fields, "id", "decision derivation reference")})
}
// Rust: crates/jet-foundation/src/MIR.rs:3127
fn parse_decision_row(value: DataTree) -> MIRDecisionRow Err! {
    fields :: decision_object(value, "decision row")
    keys :: [String]{"derivation_disposition", "derivation_ref", "disposition", "edit", "evidence", "evidence_method", "function", "function_id", "function_name", "id", "identity", "kind", "producer", "reason", "rule", "span"}
    if fields.len() != keys.len() -> return Err("decision row has missing or unsafe fields")
    loop key in keys { if !fields.contains_key(key) -> return Err("decision row has missing or unsafe fields") }
    kind_text :: decision_text(fields, "kind", "decision row")
    kind :: parse_decision_kind(kind_text) ?? return Err("decision row has unsupported kind `{kind_text}`")
    disposition_text :: decision_text(fields, "disposition", "decision row")
    disposition :: parse_decision_disposition(disposition_text) ?? return Err("decision row has unsupported disposition `{disposition_text}`")
    function_name :: decision_text(fields, "function_name", "decision row")
    function_word :: decision_optional_u64(fields, "function_id", "decision row")
    function :: if function_word == .Val(word) -> Val(MIRFunctionID{value: word}) else -> None
    span :: parse_decision_span(fields.get("span") ?? return Err("decision row has no span"))
    row := MIRDecisionRow.new(kind, disposition, function, function_name, span, decision_text(fields, "rule", "decision row"), decision_text(fields, "reason", "decision row"), decision_text(fields, "producer", "decision row"), decision_text(fields, "evidence", "decision row"))
    id :: decision_u64(fields, "id", "decision row")
    if row.id != id -> return Err("decision row id {id} does not match its canonical fields")
    row.edit = parse_decision_optional_edit(fields.get("edit"))
    row.derivation = parse_decision_optional_ref(fields.get("derivation_ref"))
    row.identity = parse_decision_optional_identity(fields.get("identity"))
    row.evidence_method = if fields.get("evidence_method") == {
        .Val(.Null) -> None
        .Val(.Text(method)) -> {
            parsed :: if method == { "static_derivation" -> Val(MIRDerivationMethod.StaticDerivation); "formal_proof" -> Val(MIRDerivationMethod.FormalProof); "recorded_execution" -> Val(MIRDerivationMethod.RecordedExecution); "sampled_agreement" -> Val(MIRDerivationMethod.SampledAgreement); "external_assumption" -> Val(MIRDerivationMethod.ExternalAssumption); else -> None }
            Val(parsed ?? return Err("decision row has unsupported `evidence_method`"))
        }
        .Val(_) -> return Err("decision row has invalid `evidence_method`")
        .None -> return Err("decision row has no `evidence_method`")
    }
    row.derivation_disposition = if fields.get("derivation_disposition") == {
        .Val(.Null) -> None
        .Val(.Text(disposition)) -> {
            parsed :: if disposition == { "current" -> Val(MIRDerivationDisposition.Current); "stale" -> Val(MIRDerivationDisposition.Stale); "expired" -> Val(MIRDerivationDisposition.Expired); "redacted" -> Val(MIRDerivationDisposition.Redacted); "unavailable" -> Val(MIRDerivationDisposition.Unavailable); "unsupported" -> Val(MIRDerivationDisposition.Unsupported); "budget_exhausted" -> Val(MIRDerivationDisposition.BudgetExhausted); "unknown" -> Val(MIRDerivationDisposition.Unknown); else -> None }
            Val(parsed ?? return Err("decision row has unsupported `derivation_disposition`"))
        }
        .Val(_) -> return Err("decision row has invalid `derivation_disposition`")
        .None -> return Err("decision row has no `derivation_disposition`")
    }
    ^row
}
