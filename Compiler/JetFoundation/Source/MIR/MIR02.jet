    // Rust: crates/jet-foundation/src/MIR.rs:3518
    pub fn clear_derived(&self) Never! {
        self.auto_vectorizable = false
        self.no_aliasing = false
        self.no_early_exit = false
        self.no_cross_iteration_dependencies = false
        self.derived_from_digest = None
        &self.pass_ids.clear()
        &self.loop_facts.clear()
        &self.bounds_facts.clear()
        &self.vector_facts.clear()
        &self.fusion_facts.clear()
        &self.acceleration_facts.clear()
    }
    // Rust: crates/jet-foundation/src/MIR.rs:3536
    pub fn pipeline_seal_hex(self) -> String? Never! { self.derived_from_digest }
    // Rust: crates/jet-foundation/src/MIR.rs:3541
    pub fn set_pipeline_seal_hex(&self, seal: String?) Err! {
        if seal == .None { self.derived_from_digest = None; return }
        hex :: seal ?? panic("present seal")
        bytes :: hex.bytes()
        if bytes.len() != 64 -> return Err("MIR pipeline seal `{hex}` is not 64 hex digits")
        digest := [U8]{}
        loop index in 0..<32 {
            first :: Int.from_u8(bytes[index * 2])
            second :: Int.from_u8(bytes[index * 2 + 1])
            // Rust validates UTF-8 on each two-byte pair before numeric parsing.
            if first >= 128 || second >= 128 {
                pair :: [U8]{bytes[index * 2], bytes[index * 2 + 1]}
                if String.from_bytes(pair) == None -> return Err("MIR pipeline seal is not ASCII hex")
                return Err("MIR pipeline seal `{hex}` is not hex")
            }
            // u8::from_str_radix accepts a leading '+' for a one-digit pair.
            high :: if first == 43 -> 0 else -> mir_seal_nibble(first) ?? return Err("MIR pipeline seal `{hex}` is not hex")
            low :: mir_seal_nibble(second) ?? return Err("MIR pipeline seal `{hex}` is not hex")
            &digest.push(U8{high * 16 + low})
        }
        self.derived_from_digest = Val(mir_sha256_hex_bytes(digest.view(0..<digest.len())))
    }
}
fn mir_seal_nibble(byte: Int) -> Int? Never! {
    if { byte >= 48 && byte <= 57 -> Val(byte - 48); byte >= 65 && byte <= 70 -> Val(byte - 65 + 10); byte >= 97 && byte <= 102 -> Val(byte - 97 + 10); else -> None }
}
