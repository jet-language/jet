// Rust: crates/jet-foundation/src/MIR.rs:2439 — MIRDecisionIdentity in MIR.jet.
impl MIRDecisionIdentity {
    // Rust: crates/jet-foundation/src/MIR.rs:2453
    pub fn derivation_identity(self) -> DerivationIdentity Never! {
        build := [U8]{}
        loop value in [String]{self.configuration, self.profile, self.implementation, self.artifact} -> append_decision_identity_frame(&build, value)
        digest :: mir_sha256_bytes(build.view(0..<build.len()))
        derivation_identity(self.source, mir_sha256_hex_bytes(digest.view(0..<digest.len())), self.run, self.target)
    }
    // Rust: crates/jet-foundation/src/MIR.rs:2475
    pub fn from_program(program: MIRProgram, artifact: MIRArtifactID?, profile: String, run: String) -> MIRDecisionIdentity Never! {
        artifact_plan := None
        if artifact == .Val(id) {
            loop candidate in program.artifacts { if candidate.id == id { artifact_plan = Val(@candidate); break } }
        }
        if artifact_plan == None && program.artifacts.len() > 0 -> artifact_plan = Val(@program.artifacts[0])
        source_material := [U8]{}
        source_files := [@MIRSourceFile]{}
        loop source in program.source_files -> &source_files.push(@source)
        &source_files.sort_by((left, right) -> if left.path == right.path -> left.id.value.compare(right.id.value) else -> left.path.compare(right.path))
        loop source in source_files {
            append_decision_identity_frame(&source_material, source.path)
            append_decision_identity_frame(&source_material, mir_sha256_hex(source.source))
        }
        if source_material.len() == 0 -> append_decision_identity_frame(&source_material, program.package_identity)
        digest :: mir_sha256_bytes(source_material.view(0..<source_material.len()))
        source :: mir_sha256_hex_bytes(digest.view(0..<digest.len()))
        runtime_parts := [String]{}
        loop part in program.facts.runtime_parts -> &runtime_parts.push(part.as_str())
        &runtime_parts.sort()
        configuration :: "package={program.package_identity};edition={program.facts.edition};os={program.facts.active_os};layer={program.facts.inferred_layer};allocator={program.facts.allocator};runtime={runtime_parts.join(",")};arrow={program.facts.uses_arrow};hardware={program.facts.hardware_profile_id}"
        selected_profile := profile
        if selected_profile.is_empty() { selected_profile = if artifact_plan == .Val(plan) -> plan.mode.as_str() else -> "unknown" }
        dossier :: program.facts.target_dossier
        triple :: if dossier.machine == .Val(machine) -> machine.triple else -> "hosted-default"
        machine_name :: if dossier.machine == .Val(machine) -> machine.name else -> "hosted-default"
        target_artifact :: if artifact_plan == .Val(plan) -> plan.target.as_str() else -> "unknown"
        target :: "triple={triple};artifact={target_artifact};machine={machine_name}"
        provider :: if artifact_plan == .Val(plan) -> plan.provider_identity else -> dossier.provider_identity
        closure :: if artifact_plan == .Val(plan) -> plan.closure_identity else -> dossier.closure_identity
        implementation :: "compiler={dossier.compiler_identity};provider={provider};closure={closure};linker={dossier.linker_identity};tier={dossier.tier_identity};environment={dossier.environment_identity};dependencies={dossier.dependency_identity}"
        artifact_name := if artifact == .Val(id) -> "artifact:{id.value}" else -> "unavailable"
        if artifact_plan == .Val(plan) { artifact_name = if plan.artifact_identity.is_empty() -> "artifact:{plan.id.value}" else -> plan.artifact_identity }
        MIRDecisionIdentity{source: source, configuration: configuration, profile: selected_profile, target: target, implementation: implementation, artifact: artifact_name, run: if run.is_empty() -> "not-observed" else -> run}
    }
}
// Rust: crates/jet-foundation/src/MIR.rs:2589
fn append_decision_identity_frame(out: &[U8], value: String) Never! {
    bytes :: value.bytes()
    length :: U64{bytes.len()}
    loop index in 0..<8 -> &out.push(U8{(length >> (index * 8)) & U64{255}})
    loop byte in bytes -> &out.push(byte)
}
