impl MIRDBQueryMetadata {
    // Rust: crates/jet-foundation/src/MIR.rs:2153
    pub fn to_wire(self) -> String Never! {
        output := [U8]{}
        mir_wire_text(&output, "JDB1:")
        mir_db_wire_field(&output, self.source_path)
        mir_db_wire_field(&output, "{self.source_file.value}")
        mir_db_wire_field(&output, "{self.source_span.start}")
        mir_db_wire_field(&output, "{self.source_span.end}")
        mir_db_wire_field(&output, self.statement_identity)
        mir_db_wire_field(&output, "{self.table_facts.len()}")
        loop fact in self.table_facts {
            mir_db_wire_field(&output, fact.table_id)
            mir_db_wire_field(&output, if fact.read -> "1" else -> "0")
            mir_db_wire_field(&output, if fact.write -> "1" else -> "0")
        }
        String.from_bytes(^output) ?? panic("wire text is UTF-8")
    }
}
// Rust: crates/jet-foundation/src/MIR.rs:2154
fn mir_db_wire_field(output: &[U8], value: String) Never! {
    mir_wire_text(&output, "{value.bytes().len()}:")
    mir_wire_text(&output, value)
}
fn mir_wire_text(output: &[U8], value: String) Never! { loop byte in value.bytes() -> &output.push(byte) }

// Rust: crates/jet-foundation/src/MIR.rs:2181 — MIRComponentTypeDescriptor in MIR.jet.
impl MIRComponentTypeDescriptor {
    // Rust: crates/jet-foundation/src/MIR.rs:2199
    pub fn wire(self) -> String Never! {
        out := [U8]{}
        self.write_wire(&out)
        String.from_bytes(^out) ?? panic("component wire is UTF-8")
    }
    // Rust: crates/jet-foundation/src/MIR.rs:2205
    fn write_wire(self, out: &[U8]) Never! {
        if self == {
            .Int -> mir_wire_text(&out, "i")
            .Float -> mir_wire_text(&out, "f")
            .Bool -> mir_wire_text(&out, "b")
            .String -> mir_wire_text(&out, "s")
            .List(inner) -> { mir_wire_text(&out, "l"); inner.write_wire(&out) }
            .Option(inner) -> { mir_wire_text(&out, "o"); inner.write_wire(&out) }
            .Result(ok, err) -> { mir_wire_text(&out, "q"); ok.write_wire(&out); err.write_wire(&out) }
            .Record(name, fields) -> {
                mir_wire_text(&out, "r")
                write_component_text(&out, name)
                mir_wire_text(&out, "{fields.len()}:")
                loop field in fields {
                    mir_wire_text(&out, "{field.index}:")
                    write_component_text(&out, field.name)
                    field.ty.write_wire(&out)
                }
            }
        }
    }
    // Rust: crates/jet-foundation/src/MIR.rs:2239
    pub fn wit_type(self) -> String Never! {
        if self == {
            .Int -> "s64"
            .Float -> "f64"
            .Bool -> "bool"
            .String -> "string"
            .List(inner) -> "list<{inner.wit_type()}>"
            .Option(inner) -> "option<{inner.wit_type()}>"
            .Result(ok, err) -> "result<{ok.wit_type()}, {err.wit_type()}>"
            .Record(name, _) -> name.replace("_", "-")
        }
    }
    // Rust: crates/jet-foundation/src/MIR.rs:2254
    fn append_wit_definitions(self, seen: &[String:Bool], definitions: &[String]) Never! {
        if self == {
            .List(inner) | .Option(inner) -> inner.append_wit_definitions(&seen, &definitions)
            .Result(ok, err) -> { ok.append_wit_definitions(&seen, &definitions); err.append_wit_definitions(&seen, &definitions) }
            .Record(original, fields) -> {
                name :: original.replace("_", "-")
                if seen.contains_key(name) -> return
                seen[name] = true
                loop field in fields -> field.ty.append_wit_definitions(&seen, &definitions)
                rows := [String]{}
                loop field in fields -> &rows.push("  {field.name.replace("_", "-")}: {field.ty.wit_type()},")
                &definitions.push("record {name} {{\n{rows.join("\n")}\n}}\n")
            }
            .Int | .Float | .Bool | .String -> {}
        }
    }
}
// Rust: crates/jet-foundation/src/MIR.rs:2289
fn write_component_text(out: &[U8], text: String) Never! { mir_db_wire_field(&out, text) }
// Rust: crates/jet-foundation/src/MIR.rs:2297 — MIRComponentSignatureDescriptor in MIR.jet.
impl MIRComponentSignatureDescriptor {
    // Rust: crates/jet-foundation/src/MIR.rs:2303
    pub fn wire(self) -> String Never! {
        out := [U8]{}
        mir_wire_text(&out, "C{self.params.len()}:")
        loop param in self.params -> param.write_wire(&out)
        mir_wire_text(&out, "r")
        self.result.write_wire(&out)
        String.from_bytes(^out) ?? panic("component signature wire is UTF-8")
    }
    // Rust: crates/jet-foundation/src/MIR.rs:2313
    pub fn wit_definitions(self) -> [String] Never! {
        seen := [String:Bool]{}
        definitions := [String]{}
        loop param in self.params -> param.append_wit_definitions(&seen, &definitions)
        self.result.append_wit_definitions(&seen, &definitions)
        ^definitions
    }
}
