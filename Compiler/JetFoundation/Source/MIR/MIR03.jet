                    if property.required -> &required.push(mir_http_json_quote(property.name))
                    &rendered.push("{mir_http_json_quote(property.name)}:{property.schema.to_wire()}")
                }
                out := [U8]{}
                &out.extend("{{\"type\":\"object\",\"properties\":{{{rendered.join(",")}}},\"additionalProperties\":{additional_properties}".bytes())
                if required.len() != 0 -> &out.extend(",\"required\":[{required.join(",")}]".bytes())
                &out.push(U8{125})
                String.from_bytes(out) ?? panic("schema UTF-8 became invalid")
            }
            .OneOf(items) -> {
                rendered := [String]{}
                loop item in items -> &rendered.push(item.to_wire())
                "{{\"oneOf\":[{rendered.join(",")}]}}"
            }
            .Nullable(item) -> "{{\"anyOf\":[{item.to_wire()},{{\"type\":\"null\"}}]}}"
