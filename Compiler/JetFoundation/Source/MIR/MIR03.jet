        "{{\"method\":{mir_http_json_quote(self.method.as_str())},\"pattern\":{mir_http_json_quote(self.pattern)},\"path\":{mir_http_json_quote(self.path)},\"operation_id\":{mir_http_json_quote(self.operation_id)},\"summary\":{summary},\"parameters\":[{parameters.join(",")}],\"request_body\":{request_body},\"responses\":[{responses.join(",")}],\"security\":[{security.join(",")}],\"provenance\":{mir_http_json_quote(self.provenance)}}}"
