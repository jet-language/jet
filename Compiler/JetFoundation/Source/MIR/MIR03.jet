fn mir_http_json_quote(value: String) -> String Never! {
    out := [U8]{U8{34}}
    digits :: "0123456789abcdef".bytes()
    // Rust char::is_control is exactly U+0000..001F and U+007F..009F.
    // Scan UTF-8 once, preserving all other characters without re-encoding.
    bytes := value.bytes()
    index := 0
    loop index < bytes.len() {
        byte :: bytes[index]
        if byte == U8{34} -> &out.extend("\\\"".bytes())
        else if byte == U8{92} -> &out.extend("\\\\".bytes())
        else if byte == U8{10} -> &out.extend("\\n".bytes())
        else if byte == U8{13} -> &out.extend("\\r".bytes())
        else if byte == U8{9} -> &out.extend("\\t".bytes())
        else if byte < U8{32} || byte == U8{127} {
            &out.extend("\\u00".bytes())
            &out.push(digits[Int.from_u8(byte) >> 4])
            &out.push(digits[Int.from_u8(byte) & 15])
        } else if byte == U8{194} && index + 1 < bytes.len() && bytes[index + 1] >= U8{128} && bytes[index + 1] <= U8{159} {
            index += 1
            control :: Int.from_u8(bytes[index])
            &out.extend("\\u00".bytes())
            &out.push(digits[control >> 4])
            &out.push(digits[control & 15])
        } else -> &out.push(byte)
        index += 1
    }
    &out.push(U8{34})
    String.from_bytes(out) ?? panic("quoted UTF-8 became invalid")
}
