}

enum MIRClockPolicy { HostedDefault Unspecified NoClock Provider(provider: MIRProviderContract) }

enum MIREntropyPolicy { HostedDefault Unspecified NoEntropy Provider(provider: MIRProviderContract) }

enum MIRSchedulerPolicy {
