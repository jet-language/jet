fn mir_terminator_targets(terminator: MIRTerminator) -> [MIRBlockID] Never! {
    if terminator == {
        .Jump(target) -> [MIRBlockID]{target}
        .Branch(_, then_target, else_target) -> [MIRBlockID]{then_target, else_target}
        .Switch(_, arms, otherwise) -> {
            targets := [MIRBlockID]{}
            loop arm in arms -> &targets.push(arm.target)
            &targets.push(otherwise)
            targets
        }
        .Yield(_, resume) -> [MIRBlockID]{resume}
        .Poll(_, resume, stop) -> [MIRBlockID]{resume, stop}
        .Break(target, _) -> [MIRBlockID]{target}
        .Continue(target) -> [MIRBlockID]{target}
        else -> [MIRBlockID]{}
    }
}

fn mir_terminator_value_uses(terminator: MIRTerminator) -> [MIRValueID] Never! {
    if terminator == {
        .Branch(condition, _, _) -> [MIRValueID]{condition}
        .Switch(subject, arms, _) -> {
            values := [MIRValueID]{subject}
            loop arm in arms -> &values.push(arm.condition)
            values
        }
        .Return(value) -> {
            value_id :: value ?? return [MIRValueID]{}
            [MIRValueID]{value_id}
        }
        .Break(_, value) -> {
            value_id :: value ?? return [MIRValueID]{}
            [MIRValueID]{value_id}
        }
        .Yield(value, _) -> [MIRValueID]{value}
        else -> [MIRValueID]{}
    }
}

// These selectors name only facts the operation actually evaluates. Merely
// registering a projected place or a drop flag does not check its bounds.
fn mir_operation_stop_operand(operation: MIROperation) -> MIRValueID? Never! {
    if operation == .Unary(.Neg, value) -> return Val(value)
    None
}

fn mir_operation_stop_place(operation: MIROperation) -> MIRPlaceID? Never! {
    if operation == {
        .ReadPlace(place) | .MovePlace(place) | .WritePlace(place, _) | .ReplacePlace(place, _) -> Val(place)
        else -> None
    }
}

fn mir_fixed_neg_can_trap(ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .IntN(_, bits) -> bits > 0 && bits <= 64
        .InlineRange(base, _, _) | .Tagged(_, base) | .Quantity(base, _) -> mir_fixed_neg_can_trap(base)
        else -> false
    }
}

// User/callback/wait operations can deliver stops. For Prelude routes, Panic
// is a checked registry fact, independent of a returned failure carrier.
fn mir_operation_can_stop(operation: MIROperation, operand_type: MIRType?, accessed_place: MIRPlace?, prelude_calls: [MIRPreludeCall], prelude_positions: [U64:Int]) -> Bool Never! {
    if operation == .Binary(op, _, overflow, _, _) {
        if mir_binary_can_trap(op, overflow) -> return true
    }
    if mir_operation_stop_operand(operation) != None && operand_type == .Val(ty) {
        if mir_fixed_neg_can_trap(ty) -> return true
    }
    if mir_operation_stop_place(operation) != None && accessed_place == .Val(place) {
        writing :: if operation == .WritePlace(_, _) || operation == .ReplacePlace(_, _) -> true else -> false
        loop projection in place.projections {
            if projection == .Index(_, _, call, write_call, _, _, _) {
                position :: prelude_positions.get(call.value)
                if position == .Val(at) && prelude_calls[at].effect_kind == .Val(route_effect) && route_effect == .Panic -> return true
                if writing && write_call == .Val(setter) {
                    setter_position :: prelude_positions.get(setter.value)
                    if setter_position == .Val(at) && prelude_calls[at].effect_kind == .Val(route_effect) && route_effect == .Panic -> return true
                }
            }
        }
    }
    loop call in mir_operation_prelude_calls(operation) {
        position :: prelude_positions.get(call.value) ?? next
        if prelude_calls[position].effect_kind == .Val(route_effect) && route_effect == .Panic -> return true
    }
    if operation == {
        .Call(_, _, _) | .IndirectCall(_, _, _) | .CoreCall(_, _, _, _, _, _) | .ScopeExit(_) -> true
        .LoopIterInit(_, _, _, _, _) | .LoopIterAdvance(_, _) -> true
        .Semantic(semantic) -> if semantic == {
            .ClosureMethod(_, _, _) | .CoreClosureCall(_, _, _, _, _, _) | .PluginInvoke(_, _, _, _, _) | .TaskGroup(_, _, _) | .Select(_, _, _) | .PolicyFunction(_, _) | .InterruptFunction(_, _) | .HostCall(_, _) -> true
            .RequireStop(_, _, _, _, _, _, _) -> true
            else -> false
        }
        else -> false
    }
}

// Existing user/callback/Core operations can panic through the code they invoke.
// ScopeExit alone only forwards an already-delivered stop.
fn mir_operation_can_panic(operation: MIROperation, operand_type: MIRType?, accessed_place: MIRPlace?, prelude_calls: [MIRPreludeCall], prelude_positions: [U64:Int]) -> Bool Never! {
    if operation == .ScopeExit(_) -> return false
    mir_operation_can_stop(operation, operand_type, accessed_place, prelude_calls, prelude_positions)
}

enum MIROperationUseKind { Value Place }

fn mir_operation_value_uses(operation: MIROperation) -> [MIRValueID] Never! {
    uses := [MIRValueID]{}
    if operation == {
        .Phi(rows) -> {
            loop row in rows -> &uses.push(row.value)
        }
        .WritePlace(_, value) -> &uses.push(value)
        .ReplacePlace(_, value) -> &uses.push(value)
        .Copy(value, _) -> &uses.push(value)
        .TraitBox(value, _) -> &uses.push(value)
        .Move(value) -> &uses.push(value)
        .Unary(_, value) -> &uses.push(value)
        .Binary(_, _, _, left, right) -> {
            &uses.push(left)
            &uses.push(right)
        }
        .BuildString(parts) -> {
            loop part in parts {
                if part.kind == {
                    .Literal(_) -> {}
                    .Interpolation(value, _) -> &uses.push(value)
                }
            }
        }
        .BuildList(values, _) -> {
            loop value in values -> &uses.push(value)
        }
        .BuildMap(entries) -> {
            loop entry in entries {
                &uses.push(entry.key)
                &uses.push(entry.value)
            }
        }
        .MapLookup(_, key, _) -> &uses.push(key)
        .EnumIs(subject, _, _) -> &uses.push(subject)
        .EnumPayload(subject, _, _, _) -> &uses.push(subject)
        .OptionIsSome(subject) -> &uses.push(subject)
        .OptionValue(subject) -> &uses.push(subject)
        .ResultIsOk(subject) -> &uses.push(subject)
        .ResultValue(subject, _) -> &uses.push(subject)
        .PatternCapture(matched, _) -> &uses.push(matched)
        .PatternMatched(matched) -> &uses.push(matched)
        .ProjectMembers(base, _) -> &uses.push(base)
        .Index(_, base, index, _, _, _, _) -> {
            &uses.push(base)
            &uses.push(index)
        }
        .Slice(_, base, start, end, range, _) -> {
            &uses.push(base)
            &uses.push(start)
            &uses.push(end)
            if range == Val(range_value) -> &uses.push(range_value)
        }
        .Range(start, end, _) -> {
            &uses.push(start)
            &uses.push(end)
        }
        .Field(base, _) -> &uses.push(base)
        .Struct(_, fields) -> {
            loop field in fields -> &uses.push(field.value)
        }
        .Enum(_, _, args) -> {
            loop arg in args -> &uses.push(arg.value)
        }
        .Tuple(_, fields) -> {
            loop field in fields -> &uses.push(field.value)
        }
        .Present(value) -> &uses.push(value)
        .Convert(value, parameters, _, _) -> {
            &uses.push(value)
            loop parameter in parameters -> &uses.push(parameter)
        }
        .ResultOk(value) -> &uses.push(value)
        .ResultErr(value) -> &uses.push(value)
        .Call(_, args, _) -> {
            loop arg in args -> &uses.push(arg.value)
        }
        .IndirectCall(callee, args, _) -> {
            &uses.push(callee)
            loop arg in args -> &uses.push(arg.value)
        }
        .PtrFromAddr(address, _) -> &uses.push(address)
        .Deref(value) -> &uses.push(value)
        .CoreCall(_, _, args, _, _, _) -> {
            loop arg in args -> &uses.push(arg.value)
        }
        .AttachTag(value, _) -> &uses.push(value)
        .LoopRangeInit(_, start, end, step, _) -> {
            &uses.push(start)
            &uses.push(end)
            if step == Val(step_value) -> &uses.push(step_value)
        }
        .LoopRangeHasNext(_, cursor) -> &uses.push(cursor)
        .LoopRangeValue(_, cursor) -> &uses.push(cursor)
        .LoopRangeAdvance(_, cursor) -> &uses.push(cursor)
        .LoopIterInit(_, collection, step, _, _) -> {
            &uses.push(collection)
            if step == Val(step_value) -> &uses.push(step_value)
        }
        .LoopIterHasNext(_, cursor) -> &uses.push(cursor)
        .LoopIterValue(_, cursor) -> &uses.push(cursor)
        .LoopIterAdvance(_, cursor) -> &uses.push(cursor)
        .Drop(value, _) -> &uses.push(value)
        .ScopeEnter(_, member) -> {
            if member == Val(scope) {
                if scope == .Timeout(duration) -> &uses.push(duration)
            }
        }
        .Semantic(semantic) -> {
            loop value in mir_semantic_op_value_uses(semantic) -> &uses.push(value)
        }
        else -> {}
    }
    uses
}

fn mir_semantic_op_value_uses(operation: MIRSemanticOp) -> [MIRValueID] Never! {
    uses := [MIRValueID]{}
    if operation == {
        .MathBuiltin(_, _, args)
        | .PreciseBuiltin(_, _, args)
        | .TaskGroup(_, _, args)
        | .Select(_, _, args) -> {
            loop value in args -> &uses.push(value)
        }
        .Print(_, value) | .LayoutLiteral(value) -> &uses.push(value)
        .AmbientInput(_, prompt) -> {
            if prompt == Val(prompt_value) -> &uses.push(prompt_value)
        }
        .RequireStop(_, _, condition, _, _, values, _) -> {
            if condition == Val(condition_value) -> &uses.push(condition_value)
            loop value in values -> &uses.push(value)
        }
        .LayoutCompare(_, _, left, right) -> {
            &uses.push(left)
            &uses.push(right)
        }
        .ReflectOf(_, _, display, fields) -> {
            &uses.push(display)
            loop field in fields -> &uses.push(field.value)
        }
        .OptionLift2(_, function, left, right) -> {
            &uses.push(function)
            &uses.push(left)
            &uses.push(right)
        }
        .StructLiteral(_, fields, _, _) -> {
            loop field in fields -> &uses.push(field.value)
        }
        .CellGuardProject(_, _, guard, _, _, _)
        | .SharedGuardMap(_, guard, _, _)
        | .SharedGuardSplit(_, _, guard, _, _, _) -> &uses.push(guard)
        .SharedGuardWait(_, guard, condition, _) -> {
            &uses.push(guard)
            &uses.push(condition)
        }
        .ConditionNotify(_, condition, _) -> &uses.push(condition)
        .AllocNew(_, _, _, args) -> {
            loop arg in args -> &uses.push(arg.value)
        }
        .ColumnarRead(base, index, _, _, _) -> {
            &uses.push(base)
            &uses.push(index)
        }
        .StaticPreludeCall(_, args, _, _) | .HostCall(_, args) -> {
            loop arg in args -> &uses.push(arg.value)
        }
        .DecodeUnder(_, segment, inner) -> {
            &uses.push(segment)
            &uses.push(inner)
        }
        .HardwareCall(_, _, receiver, args) -> {
            if receiver == Val(receiver_value) -> &uses.push(receiver_value)
            loop arg in args -> &uses.push(arg.value)
        }
        .BuiltinMethod(_, receiver, _, args, _) -> {
            &uses.push(receiver)
            loop arg in args -> &uses.push(arg)
        }
        .HandleMethod(_, receiver, args, _, _) -> {
            &uses.push(receiver)
            loop arg in args -> &uses.push(arg)
        }
        .PluginInvoke(_, handle, _, _, args) -> {
            &uses.push(handle)
            loop arg in args -> &uses.push(arg)
        }
        .HTTPRouterRegister(_, receiver, path, handler, _, _, _, _) -> {
            &uses.push(receiver)
            &uses.push(path)
            &uses.push(handler)
        }
        .TextPatternMatch(_, subject, _)
        | .BinaryPatternMatch(_, subject, _) -> {
            &uses.push(subject)
        }
        .CursorTakePattern(receiver, _, _)
        | .ReaderTakePattern(receiver, _, _) -> {
            &uses.push(receiver)
        }
        .ClosureMethod(receiver, args, _) -> {
            &uses.push(receiver)
            loop arg in args -> &uses.push(arg.value)
        }
        .HostBorrowCallback(callable, _) -> {
            &uses.push(callable)
        }
        .PolicyFunction(policy, values)
        | .InterruptFunction(policy, values) -> {
            &uses.push(policy)
            loop value in values -> &uses.push(value)
        }
        .NumericMethod(_, receiver) -> {
            &uses.push(receiver)
        }
        .NumericBinaryMethod(_, receiver, argument)
        | .OverflowOption(_, receiver, argument, _) -> {
            &uses.push(receiver)
            &uses.push(argument)
        }
        .CoreClosureCall(_, _, values, closure, _, _) -> {
            loop value in values -> &uses.push(value)
            if closure == Val(closure_value) -> &uses.push(closure_value)
        }
        .CarrierFact(_, receiver, _, _) -> {
            &uses.push(receiver)
        }
        .GCEdit(_, root, edges, edit, index, _, _) -> {
            &uses.push(root)
            loop edge in edges -> &uses.push(edge)
            &uses.push(edit)
            if index == Val(index_value) -> &uses.push(index_value)
        }
        .TypedTextInterp(_, _, _, holes, _) -> {
            loop hole in holes -> &uses.push(hole)
        }
        .CCallback(_, _, lambda) -> {
            &uses.push(lambda)
        }
    }
    uses
}

fn mir_semantic_op_place_uses(operation: MIRSemanticOp) -> [MIRPlaceID] Never! {
    if operation == {
        .BuiltinMethod(_, _, receiver_place, _, _) -> {
            place :: receiver_place ?? return [MIRPlaceID]{}
            [MIRPlaceID]{place}
        }
        else -> [MIRPlaceID]{}
    }
}

fn mir_operation_place_uses(operation: MIROperation) -> [MIRPlaceID] Never! {
    if operation == {
        .ReadPlace(place) -> [MIRPlaceID]{place}
        .MovePlace(place) -> [MIRPlaceID]{place}
        .WritePlace(place, _) -> [MIRPlaceID]{place}
        .ReplacePlace(place, _) -> [MIRPlaceID]{place}
        .InitializeUninit(place) -> [MIRPlaceID]{place}
        .RawAddressOf(place) -> [MIRPlaceID]{place}
        .AddressOf(place, _) -> [MIRPlaceID]{place}
        .Closure(_, captures, _) -> {
            places := [MIRPlaceID]{}
            loop capture in captures {
                if capture == .Place(place) -> &places.push(place)
            }
            places
        }
        .Semantic(semantic) -> mir_semantic_op_place_uses(semantic)
        else -> [MIRPlaceID]{}
    }
}

fn mir_call_arg_type_uses(args: [MIRCallArg]) -> [MIRTypeID] Never! {
    uses := [MIRTypeID]{}
    loop arg in args {
        if arg.fn_coercion != None {
            coercion :: arg.fn_coercion ?? return uses
            if coercion.ty.identity != None {
                type_id :: coercion.ty.identity ?? return uses
                &uses.push(type_id)
            }
        }
        if arg.widen_to_union != None {
            coercion :: arg.widen_to_union ?? return uses
            &uses.push(coercion.union)
        }
        if arg.box_as_trait != None {
            type_id :: arg.box_as_trait ?? return uses
            &uses.push(type_id)
        }
    }
    uses
}

fn mir_failure_type_uses(failure: MIRFailureCarrier) -> [MIRTypeID] Never! {
    uses := [MIRTypeID]{}
    if failure == {
        .Infallible -> {}
        .Result(success, error) -> {
            if success.identity != None {
                type_id :: success.identity ?? return uses
                &uses.push(type_id)
            }
            if error.identity != None {
                type_id :: error.identity ?? return uses
                &uses.push(type_id)
            }
        }
        .Optional(value) | .Diverges(value) -> {
            if value.identity != None {
                type_id :: value.identity ?? return uses
                &uses.push(type_id)
            }
        }
    }
    uses
}

fn mir_call_fallibility_type_uses(fallibility: MIRCallFallibility) -> [MIRTypeID] Never! {
    if fallibility == {
        .Infallible -> [MIRTypeID]{}
        .Failure(failure) -> mir_failure_type_uses(failure)
    }
}

fn mir_data_plan_type_uses(plan: MIRDataPlan) -> [MIRTypeID] Never! {
    uses := [MIRTypeID]{}
    loop node in plan.logical {
        if node.row_type.identity != None {
            type_id :: node.row_type.identity ?? return uses
            &uses.push(type_id)
        }
        loop column in node.columns {
            if column.ty.identity != None {
                type_id :: column.ty.identity ?? return uses
                &uses.push(type_id)
            }
        }
        if node.callable != None {
            callable :: node.callable ?? return uses
            if callable.parameter.identity != None {
                type_id :: callable.parameter.identity ?? return uses
                &uses.push(type_id)
            }
            if callable.result.identity != None {
                type_id :: callable.result.identity ?? return uses
                &uses.push(type_id)
            }
        }
    }
    uses
}

fn mir_semantic_op_type_uses(operation: MIRSemanticOp) -> [MIRTypeID] Never! {
    uses := [MIRTypeID]{}
    if operation == {
        .MathBuiltin(type_id, _, _) | .PreciseBuiltin(type_id, _, _) -> &uses.push(type_id)
        .StructLiteral(type_id, _, _, _) -> &uses.push(type_id)
        .StaticPreludeCall(_, args, owner_type_args, type_args) -> {
            loop type_id in mir_call_arg_type_uses(args) -> &uses.push(type_id)
            loop type_arg in owner_type_args {
                if type_arg == {
                    .Type(ty) -> {
                        if ty.identity != None {
                            type_id :: ty.identity ?? return uses
                            &uses.push(type_id)
                        }
                    }
                    .HostUsize -> {}
                }
            }
            loop ty in type_args {
                if ty.identity != None {
                    type_id :: ty.identity ?? return uses
                    &uses.push(type_id)
                }
            }
        }
        .HardwareCall(_, _, _, args)
        | .ClosureMethod(_, args, _)
        | .HostCall(_, args) -> {
            loop type_id in mir_call_arg_type_uses(args) -> &uses.push(type_id)
        }
        .HostBorrowCallback(_, params) -> {
            loop ty in params {
                if ty.identity != None {
                    type_id :: ty.identity ?? return uses
                    &uses.push(type_id)
                }
            }
        }
        .TextPatternMatch(_, _, parts)
        | .CursorTakePattern(_, _, parts) -> {
            loop part in parts {
                if part == {
                    .Hole(_, type_id, _) -> &uses.push(type_id)
                    .Literal(_) -> {}
                }
            }
        }
        .BinaryPatternMatch(_, _, parts)
        | .ReaderTakePattern(_, _, parts) -> {
            loop part in parts {
                if part == {
                    .Bits(_, type_id, _, _) | .Rest(type_id, _) -> &uses.push(type_id)
                    .Literal(_) -> {}
                }
            }
        }
        else -> {}
    }
    uses
}

fn mir_operation_type_uses(operation: MIROperation) -> [MIRTypeID] Never! {
    uses := [MIRTypeID]{}
    if operation == {
        .Struct(type_id, _) | .Enum(type_id, _, _) | .Tuple(type_id, _) -> {
            &uses.push(type_id)
        }
        .EnumIs(_, owner, _) | .EnumPayload(_, owner, _, _) -> {
            &uses.push(owner)
        }
        .Convert(_, _, target, conversion) -> {
            if target.identity != None {
                type_id :: target.identity ?? return uses
                &uses.push(type_id)
            }
            if conversion == {
                .Prelude(_, _, fallibility) -> {
                    loop type_id in mir_call_fallibility_type_uses(fallibility) -> &uses.push(type_id)
                }
                .Transparent | .NumericCast | .SendFn -> {}
            }
        }
        .TraitBox(_, target) -> &uses.push(target)
        .Call(callee, args, type_args) -> {
            loop type_id in mir_call_arg_type_uses(args) -> &uses.push(type_id)
            loop ty in type_args {
                if ty.identity != None {
                    type_id :: ty.identity ?? return uses
                    &uses.push(type_id)
                }
            }
            if callee == {
                .Associated(_, owner) | .Method(_, owner) -> {
                    if owner.identity != None {
                        type_id :: owner.identity ?? return uses
                        &uses.push(type_id)
                    }
                }
                .TraitMethod(_, _, receiver) -> {
                    if receiver.identity != None {
                        type_id :: receiver.identity ?? return uses
                        &uses.push(type_id)
                    }
                }
                else -> {}
            }
        }
        .IndirectCall(_, args, type_args) -> {
            loop type_id in mir_call_arg_type_uses(args) -> &uses.push(type_id)
            loop ty in type_args {
                if ty.identity != None {
                    type_id :: ty.identity ?? return uses
                    &uses.push(type_id)
                }
            }
        }
        .CoreCall(_, _, args, type_args, fallibility, data_plan) -> {
            loop type_id in mir_call_arg_type_uses(args) -> &uses.push(type_id)
            loop ty in type_args {
                if ty.identity != None {
                    type_id :: ty.identity ?? return uses
                    &uses.push(type_id)
                }
            }
            loop type_id in mir_call_fallibility_type_uses(fallibility) -> &uses.push(type_id)
            if data_plan == Val(plan) {
                loop type_id in mir_data_plan_type_uses(plan) -> &uses.push(type_id)
            }
        }
        .PtrFromAddr(_, element) -> {
            if element.identity != None {
                type_id :: element.identity ?? return uses
                &uses.push(type_id)
            }
        }
        .Todo(_, _, expected_type) -> {
            if expected_type == Val(ty) {
                if ty.identity == Val(type_id) -> &uses.push(type_id)
            }
        }
        .Semantic(semantic) -> {
            loop type_id in mir_semantic_op_type_uses(semantic) -> &uses.push(type_id)
        }
        else -> {}
    }
    uses
}

fn mir_semantic_op_prelude_calls(operation: MIRSemanticOp) -> [MIRPreludeCallID] Never! {
    calls := [MIRPreludeCallID]{}
    if operation == {
        .Print(call, _)
        | .AmbientInput(call, _)
        | .RequireStop(call, _, _, _, _, _, _)
        | .LayoutCompare(call, _, _, _)
        | .SharedGuardMap(call, _, _, _)
        | .SharedGuardWait(call, _, _, _)
        | .ConditionNotify(call, _, _)
        | .AllocNew(call, _, _, _)
        | .DecodeUnder(call, _, _)
        | .OptionLift2(call, _, _, _)
        | .MathBuiltin(_, call, _)
        | .PreciseBuiltin(_, call, _)
        | .StaticPreludeCall(call, _, _, _)
        | .HardwareCall(call, _, _, _)
        | .BuiltinMethod(call, _, _, _, _)
        | .ClosureMethod(_, _, call)
        | .NumericMethod(call, _)
        | .NumericBinaryMethod(call, _, _)
        | .OverflowOption(call, _, _, _)
        | .HandleMethod(call, _, _, _, _)
        | .PluginInvoke(call, _, _, _, _)
        | .HTTPRouterRegister(call, _, _, _, _, _, _, _)
        | .CoreClosureCall(call, _, _, _, _, _)
        | .TaskGroup(call, _, _)
        | .Select(call, _, _)
        | .HostCall(call, _)
        | .TextPatternMatch(call, _, _)
        | .BinaryPatternMatch(call, _, _) -> {
            &calls.push(call)
        }
        .CarrierFact(call, _, _, _)
        | .GCEdit(call, _, _, _, _, _, _)
        | .TypedTextInterp(call, _, _, _, _)
        | .CCallback(call, _, _) -> {
            &calls.push(call)
        }
        .CellGuardProject(map_call, split_call, _, _, _, _) -> {
            &calls.push(map_call)
            if split_call == Val(call) -> &calls.push(call)
        }
        .SharedGuardSplit(call, map_call, _, _, _, _) -> {
            &calls.push(call)
            &calls.push(map_call)
        }
        else -> {}
    }
    calls
}

fn mir_operation_prelude_calls(operation: MIROperation) -> [MIRPreludeCallID] Never! {
    calls := [MIRPreludeCallID]{}
    if operation == {
        .Call(callee, _, _) -> {
            if callee == {
                .Prelude(call) -> &calls.push(call)
                else -> {}
            }
        }
        .CoreCall(_, route, _, _, _, _)
        | .Todo(route, _, _)
        | .Index(route, _, _, _, _, _, _)
        | .Slice(route, _, _, _, _, _)
        | .LoopRangeInit(route, _, _, _, _)
        | .LoopRangeHasNext(route, _)
        | .LoopRangeValue(route, _)
        | .LoopRangeAdvance(route, _)
        | .LoopIterInit(route, _, _, _, _)
        | .LoopIterHasNext(route, _)
        | .LoopIterValue(route, _)
        | .LoopIterAdvance(route, _) -> &calls.push(route)
        .Convert(_, _, _, conversion) -> {
            if conversion == {
                .Prelude(call, _, _) -> &calls.push(call)
                else -> {}
            }
        }
        .Binary(_, dispatch, _, _, _) -> {
            if dispatch == {
                .Prelude(call, _) -> &calls.push(call)
                else -> {}
            }
        }
        .Semantic(semantic) -> {
            loop call in mir_semantic_op_prelude_calls(semantic) -> &calls.push(call)
        }
        else -> {}
    }
    calls
}

