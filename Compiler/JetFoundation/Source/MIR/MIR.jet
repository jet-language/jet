// #4318: why a MIR Copy duplicates its operand (MIRRust MirCopyFact). Every
// copy carries the sema decision that made it; lowering and backends never
// print a clone without one, and the legality verifier checks the fact
// against the operand's type.
enum MIRCopyFact { Explicit Materialize Share Scalar ViewMaterialize }

// Stable wire name (digests, emitted copy tags).
fn mir_copy_fact_name(fact: MIRCopyFact) -> String Never! {
    if fact == {
        .Explicit -> "explicit"
        .Materialize -> "materialize"
        .Share -> "share"
        .Scalar -> "scalar"
        .ViewMaterialize -> "view_materialize"
    }
}

// Only a NoDrop Copy-ABI value can strip an implicit physical clone.
// The user's `~` and view materialization keep their fact.
fn mir_copy_fact_for_ownership(fact: MIRCopyFact, ownership: MIROwnership) -> MIRCopyFact Never! {
    if ownership.mode == MIROwnershipMode.Copy && ownership.drop == MIRDropKind.NoDrop && (fact == MIRCopyFact.Materialize || fact == MIRCopyFact.Share) -> return MIRCopyFact.Scalar
    fact.copy()
}

