pub enum MIRAccess { Read Write Move }

pub enum MIROwnershipMode { Copy Owned Shared ReadBorrow WriteBorrow Move }

pub enum MIRDropKind { NoDrop Value Shared View ForeignHandle }

pub struct MIROwnership {
    pub mode: MIROwnershipMode
    pub drop: MIRDropKind
    pub moved: Bool
    pub last_use: Bool
    pub gc_root: Bool
}

pub fn mir_copy_ownership() -> MIROwnership Never! {
    MIROwnership{mode: MIROwnershipMode.Copy, drop: MIRDropKind.NoDrop, moved: false, last_use: false, gc_root: false}
}

pub fn mir_owned_ownership() -> MIROwnership Never! {
    MIROwnership{mode: MIROwnershipMode.Owned, drop: MIRDropKind.Value, moved: false, last_use: false, gc_root: false}
}

pub fn mir_ownership_from_access(access: MIRAccess) -> MIROwnership Never! {
    if access == {
        .Read -> MIROwnership{mode: MIROwnershipMode.ReadBorrow, drop: MIRDropKind.NoDrop, moved: false, last_use: false, gc_root: false}
        .Write -> MIROwnership{mode: MIROwnershipMode.WriteBorrow, drop: MIRDropKind.View, moved: false, last_use: false, gc_root: false}
        .Move -> MIROwnership{mode: MIROwnershipMode.Move, drop: MIRDropKind.Value, moved: false, last_use: true, gc_root: false}
    }
}

pub enum MIRMeasureRule { Add Mul Match }

pub enum MIRMeasure {
    Literal(kind: String, value: Int)
    SignedLiteral(kind: String, value: Int)
    Symbol(kind: String, name: String)
    Combined(kind: String, rule: MIRMeasureRule, left: MIRMeasure, right: MIRMeasure)
}

pub fn mir_measure_kind(measure: MIRMeasure) -> String Never! {
    if measure == {
        .Literal(kind, _) -> kind
        .SignedLiteral(kind, _) -> kind
        .Symbol(kind, _) -> kind
        .Combined(kind, _, _, _) -> kind
    }
}

pub fn mir_measure_expression(measure: MIRMeasure) -> String Never! {
    if measure == {
        .Literal(_, value) -> "{value}"
        .SignedLiteral(_, value) -> "{value}"
        .Symbol(_, name) -> name
        .Combined(_, rule, left, right) -> {
            left_name := mir_measure_expression(left)
            right_name := mir_measure_expression(right)
            if rule == {
                .Add -> "({left_name} + {right_name})"
                .Mul -> "({left_name} * {right_name})"
                .Match -> "match({left_name}, {right_name})"
            }
        }
    }
}

pub fn mir_measure_literal_value(measure: MIRMeasure) -> Int? {
    if measure == {
        .Literal(_, value) -> Val(value)
        .Combined(_, rule, left, right) -> {
            if rule == {
                .Add -> {
                    a :: mir_measure_literal_value(left) ?? return None
                    b :: mir_measure_literal_value(right) ?? return None
                    Val(a + b)
                }
                .Mul -> {
                    a :: mir_measure_literal_value(left) ?? return None
                    b :: mir_measure_literal_value(right) ?? return None
                    Val(a * b)
                }
                .Match -> None
            }
        }
        else -> None
    }
}

pub struct MIRDimensionAxis { pub name: String, pub exponent: MIRMeasure }

pub struct MIRDimension { pub axes: [MIRDimensionAxis] }

fn mir_measure_signed_value(measure: MIRMeasure) -> Int? {
    if measure == {
        .Literal(_, value) -> Val(value)
        .SignedLiteral(_, value) -> Val(value)
        .Combined(_, rule, left, right) -> {
            if rule == {
                .Add -> {
                    a :: mir_measure_signed_value(left) ?? return None
                    b :: mir_measure_signed_value(right) ?? return None
                    Val(a + b)
                }
                .Mul -> {
                    a :: mir_measure_signed_value(left) ?? return None
                    b :: mir_measure_signed_value(right) ?? return None
                    Val(a * b)
                }
                .Match -> None
            }
        }
        else -> None
    }
}

pub fn mir_dimension_identity(dimension: MIRDimension) -> String Never! {
    parts := [String]{}
    loop axis in dimension.axes {
        exponent :: mir_measure_signed_value(axis.exponent).map(value -> "{value}") ?? mir_measure_expression(axis.exponent)
        &parts.push("{axis.name}:{exponent}")
    }
    parts.join(";")
}

pub fn mir_dimension_display_name(dimension: MIRDimension) -> String Never! {
    parts := [String]{}
    loop axis in dimension.axes {
        leaf := axis.name.split("::").to_list()
        name :: if leaf.len() == 0 -> axis.name else -> leaf[leaf.len() - 1]
        exponent :: mir_measure_signed_value(axis.exponent)
        rendered :: if {
            (exponent ?? 0) == 1 -> name
            else -> {
                exponent_name :: exponent.map(value -> "{value}") ?? mir_measure_expression(axis.exponent)
                "{name}^{exponent_name}"
            }
        }
        &parts.push(rendered)
    }
    if parts.len() == 0 -> return "Scalar"
    parts.join(" * ")
}

pub enum MIRInternalTag {
    CoreCryptoNominal
    DeterministicClock
    SystemClock
    ExpiringSecretLoan
    SharedGuardRead
    SharedGuardEdit
    TerminalFactSet
    CppCallbackABI
    AllocatorView
}

pub enum MIRTagMarker {
    User(name: String)
    Internal(internal_tag: MIRInternalTag)
}

pub fn mir_tag_is_identity_bearing(marker: MIRTagMarker) -> Bool Never! {
    marker == MIRTagMarker.Internal{internal_tag: MIRInternalTag.CoreCryptoNominal}
}

pub fn mir_tag_name(marker: MIRTagMarker) -> String Never! {
    if marker == {
        .User(name) -> name
        .Internal(internal_tag) -> {
            if internal_tag == {
                .CoreCryptoNominal -> "core.crypto"
                .DeterministicClock -> "clock.deterministic"
                .SystemClock -> "clock.system"
                .ExpiringSecretLoan -> "expiring_secret.loan"
                .SharedGuardRead -> "shared_guard.read"
                .SharedGuardEdit -> "shared_guard.edit"
                .TerminalFactSet -> "terminal.fact_set"
                .CppCallbackABI -> "cpp.callback_abi"
                .AllocatorView -> "allocator.view"
            }
        }
    }
}

pub struct MIRCallContractRow { pub label: String, pub zone: ParamZone }

pub struct MIRCallablePolicy { pub name: String, pub arguments: [String] }

pub struct MIRCallablePolicyChain { pub policies: [MIRCallablePolicy] }

pub struct MIRCallMetadata {
    pub names: [String]
    pub defaults: [Bool]
    pub variadic: [Bool]
    pub conventions: [MIRAccess]
    pub policies: MIRCallablePolicyChain
}

pub fn mir_call_metadata_is_variadic(metadata: MIRCallMetadata) -> Bool Never! {
    loop variadic in metadata.variadic {
        if variadic -> return true
    }
    false
}

pub struct MIRNominalRef { pub id: MIRTypeID, pub name: String }

pub struct MIRTraitRef { pub id: MIRTraitID, pub name: String }

pub fn mir_nominal_ref(name: String) -> MIRNominalRef Never! {
    MIRNominalRef{id: mir_type_id(name), name: name}
}

pub fn mir_trait_ref(name: String) -> MIRTraitRef Never! {
    MIRTraitRef{id: mir_trait_id(name), name: name}
}

pub struct MIRFunctionSignature {
    pub params: [MIRType]
    pub ret: MIRType?
    pub effect_bound: [String]?
    pub param_contract: [MIRCallContractRow]?
    pub call_metadata: MIRCallMetadata?
    pub return_view_provenance: [MIRViewProvenanceEntry]?
}

pub enum MIRScalarKind { Int Float Float32 Bool Char Pointer }

pub enum MIRABI { Scalar(kind: MIRScalarKind) Aggregate Sequence Function Nominal Dynamic Never }

pub enum MIRSize { Static(bytes: Int) Dynamic }

pub struct MIRLayout { pub abi: MIRABI, pub size: MIRSize, pub align: MIRSize }

pub enum MIRTypeKind {
    Int
    Float
    Bool
    String
    Char
    List(inner: MIRType)
    Map(key: MIRType, value: MIRType)
    Shared(inner: MIRType)
    Option(inner: MIRType)
    Result(ok: MIRType, err: MIRType)
    Fn(signature: MIRFunctionSignature)
    SendFn(params: [MIRType], ret: MIRType?, conventions: [MIRAccess])
    Apply(name: MIRNominalRef, args: [MIRType])
    TraitObject(bounds: [MIRTraitRef])
    Tuple(fields: [MIRTupleField])
    FixedList(elem: MIRType, len: MIRMeasure)
    IntN(signed: Bool, bits: Int)
    InlineRange(base: MIRType, lo: Int, hi: Int)
    Float32
    Tagged(marker: MIRTagMarker, inner: MIRType)
    Union(members: [MIRType])
    Quantity(base: MIRType, dimension: MIRDimension)
    Measure(value: MIRMeasure)
}

pub struct MIRTupleField { pub name: String, pub ty: MIRType }

pub struct MIRType { pub kind: MIRTypeKind, pub identity: MIRTypeID?, pub layout: MIRLayout }

pub enum MIRViewCopyKind { String List }

pub fn mir_view_copy_symbol(kind: MIRViewCopyKind) -> String Never! {
    if kind == MIRViewCopyKind.String -> return "jet_string_view_copy"
    "jet_view_copy"
}

pub fn mir_view_copy_kind(source: MIRType) -> MIRViewCopyKind? {
    if source.kind == {
        .String -> return Val(MIRViewCopyKind.String)
        .List(_) | .FixedList(_, _) -> return Val(MIRViewCopyKind.List)
        .Tagged(_, inner) -> return mir_view_copy_kind(inner)
        .Apply(name, args) -> {
            if (name.name == "View" || name.name == "ViewMut") && args.len() == 1 {
                inner := args[0]
                if inner.kind == {
                    .Apply(inner_name, inner_args) -> {
                        if inner_args.len() == 0 && inner_name.name == "str" -> return Val(MIRViewCopyKind.String)
                    }
                    else -> {}
                }
                return Val(MIRViewCopyKind.List)
            }
        }
        else -> {}
    }
    None
}

pub fn mir_view_copy_target_matches(kind: MIRViewCopyKind, target: MIRType) -> Bool Never! {
    if target.kind == .Tagged(_, inner) -> return mir_view_copy_target_matches(kind, inner)
    if target.kind == {
        .Apply(name, args) -> {
            if kind == MIRViewCopyKind.String && args.len() == 0 && name.name == "String" -> return true
            if kind == MIRViewCopyKind.List && args.len() == 1 && name.name == "List" -> return true
        }
        else -> {}
    }
    if kind == MIRViewCopyKind.String -> return target.kind == .String
    if kind == MIRViewCopyKind.List && target.kind == .List(_) -> return true
    false
}

pub fn mir_type_layout(kind: MIRTypeKind) -> MIRLayout Never! {
    if kind == {
        .Int -> MIRLayout{abi: MIRABI.Scalar{kind: MIRScalarKind.Int}, size: MIRSize.Dynamic, align: MIRSize.Static{bytes: 8}}
        .Float -> mir_scalar_layout(MIRScalarKind.Float, 8)
        .Float32 -> mir_scalar_layout(MIRScalarKind.Float32, 4)
        .Bool -> mir_scalar_layout(MIRScalarKind.Bool, 1)
        .Char -> mir_scalar_layout(MIRScalarKind.Char, 4)
        .IntN(_, bits) -> mir_scalar_layout(MIRScalarKind.Int, if bits + 7 < 8 -> 1 else -> (bits + 7) /% 8)
        .InlineRange(base, _, _) -> base.layout
        .Tagged(_, inner) -> inner.layout
        .Quantity(base, _) -> base.layout
        .Fn(_) -> MIRLayout{abi: MIRABI.Function, size: MIRSize.Dynamic, align: MIRSize.Static{bytes: 8}}
        .SendFn(_, _, _) -> MIRLayout{abi: MIRABI.Function, size: MIRSize.Dynamic, align: MIRSize.Static{bytes: 8}}
        .String -> MIRLayout{abi: MIRABI.Sequence, size: MIRSize.Dynamic, align: MIRSize.Static{bytes: 8}}
        .FixedList(_, _) -> MIRLayout{abi: MIRABI.Sequence, size: MIRSize.Dynamic, align: MIRSize.Static{bytes: 8}}
        .List(_) -> MIRLayout{abi: MIRABI.Sequence, size: MIRSize.Dynamic, align: MIRSize.Static{bytes: 8}}
        .Map(_, _) -> MIRLayout{abi: MIRABI.Sequence, size: MIRSize.Dynamic, align: MIRSize.Static{bytes: 8}}
        .Apply(name, args) -> {
            if {
                args.len() == 0 && name.name == "Never" -> MIRLayout{abi: MIRABI.Never, size: MIRSize.Static{bytes: 0}, align: MIRSize.Static{bytes: 1}}
                is_atomic_apply(name.name, args) -> MIRLayout{abi: MIRABI.Scalar{kind: MIRScalarKind.Int}, size: MIRSize.Static{bytes: 8}, align: MIRSize.Static{bytes: 8}}
                else -> MIRLayout{abi: MIRABI.Nominal, size: MIRSize.Dynamic, align: MIRSize.Static{bytes: 8}}
            }
        }
        .TraitObject(_) -> MIRLayout{abi: MIRABI.Nominal, size: MIRSize.Dynamic, align: MIRSize.Static{bytes: 8}}
        .Option(_) -> mir_aggregate_layout()
        .Result(_, _) -> mir_aggregate_layout()
        .Tuple(_) -> mir_aggregate_layout()
        .Union(_) -> mir_aggregate_layout()
        .Shared(_) -> mir_aggregate_layout()
        .Measure(_) -> MIRLayout{abi: MIRABI.Dynamic, size: MIRSize.Dynamic, align: MIRSize.Static{bytes: 8}}
    }
}

fn mir_scalar_layout(kind: MIRScalarKind, bytes: Int) -> MIRLayout Never! {
    MIRLayout{abi: MIRABI.Scalar{kind: kind}, size: MIRSize.Static{bytes: bytes}, align: MIRSize.Static{bytes: if bytes < 8 -> bytes else -> 8}}
}

fn mir_aggregate_layout() -> MIRLayout Never! {
    MIRLayout{abi: MIRABI.Aggregate, size: MIRSize.Dynamic, align: MIRSize.Static{bytes: 8}}
}

fn is_atomic_apply(name: String, args: [MIRType]) -> Bool Never! {
    if !(name == "Atomic" || name.ends_with("::Atomic") || name.ends_with(".Atomic")) || args.len() != 1 -> return false
    if args[0].kind == {
        .Bool -> true
        .Int -> true
        .IntN(signed, bits) -> (signed && bits == 32) || (!signed && (bits == 32 | 64))
        else -> false
    }
}

pub fn mir_type_from_kind(kind: MIRTypeKind) -> MIRType Never! {
    MIRType{kind: kind, identity: None, layout: mir_type_layout(kind)}
}

pub fn mir_type_with_identity(ty: MIRType, identity: MIRTypeID) -> MIRType Never! {
    MIRType{kind: ty.kind, identity: Val(identity), layout: ty.layout}
}

pub fn mir_type_same_checked_type(left: MIRType, right: MIRType) -> Bool Never! {
    if left.identity != None && right.identity != None -> return left.identity == right.identity
    mir_type_kind_same_identity(left, right)
}

fn mir_type_kind_same_identity(left: MIRType, right: MIRType) -> Bool Never! {
    if left.kind == {
        .Tagged(marker, inner) -> {
            if !mir_tag_is_identity_bearing(marker) {
                if right.kind == {
                    .Tagged(other_marker, other_inner) -> {
                        if !mir_tag_is_identity_bearing(other_marker) -> return mir_type_same_checked_type(inner, other_inner)
                    }
                    else -> {}
                }
                return mir_type_kind_same_identity(inner, right)
            }
        }
        else -> {}
    }
    if right.kind == {
        .Tagged(marker, inner) -> {
            if !mir_tag_is_identity_bearing(marker) -> return mir_type_kind_same_identity(left, inner)
        }
        else -> {}
    }
    same := if left.kind == {
        .Int -> right.kind == MIRTypeKind.Int
        .Float -> right.kind == MIRTypeKind.Float
        .Bool -> right.kind == MIRTypeKind.Bool
        .String -> right.kind == MIRTypeKind.String
        .Char -> right.kind == MIRTypeKind.Char
        .Float32 -> right.kind == MIRTypeKind.Float32
        .List(inner) -> if right.kind == {
            .List(other) -> mir_type_same_checked_type(inner, other)
            else -> false
        }
        .Map(key, value) -> if right.kind == {
            .Map(other_key, other_value) -> mir_type_same_checked_type(key, other_key) && mir_type_same_checked_type(value, other_value)
            else -> false
        }
        .Shared(inner) -> if right.kind == {
            .Shared(other) -> mir_type_same_checked_type(inner, other)
            else -> false
        }
        .Option(inner) -> if right.kind == {
            .Option(other) -> mir_type_same_checked_type(inner, other)
            else -> false
        }
        .Result(ok, err) -> if right.kind == {
            .Result(other_ok, other_err) -> mir_type_same_checked_type(ok, other_ok) && mir_type_same_checked_type(err, other_err)
            else -> false
        }
        .Fn(signature) -> if right.kind == {
            .Fn(other) -> mir_function_signature_identity_equal(signature, other)
            else -> false
        }
        .SendFn(params, ret, conventions) -> if right.kind == {
            .SendFn(other_params, other_ret, other_conventions) -> mir_type_array_identity_equal(params, other_params) && mir_optional_type_identity_equal(ret, other_ret) && conventions == other_conventions
            else -> false
        }
        .Apply(name, args) -> if right.kind == {
            .Apply(other_name, other_args) -> name.id == other_name.id && mir_type_array_identity_equal(args, other_args)
            else -> false
        }
        .TraitObject(bounds) -> if right.kind == {
            .TraitObject(other) -> mir_trait_ref_array_identity_equal(bounds, other)
            else -> false
        }
        .Tuple(fields) -> if right.kind == {
            .Tuple(other) -> mir_tuple_fields_identity_equal(fields, other)
            else -> false
        }
        .FixedList(elem, len) -> if right.kind == {
            .FixedList(other_elem, other_len) -> mir_type_same_checked_type(elem, other_elem) && len == other_len
            else -> false
        }
        .IntN(signed, bits) -> if right.kind == {
            .IntN(other_signed, other_bits) -> signed == other_signed && bits == other_bits
            else -> false
        }
        .InlineRange(base, lo, hi) -> if right.kind == {
            .InlineRange(other_base, other_lo, other_hi) -> lo == other_lo && hi == other_hi && mir_type_same_checked_type(base, other_base)
            else -> false
        }
        .Tagged(marker, inner) -> if right.kind == {
            .Tagged(other_marker, other_inner) -> marker == other_marker && mir_type_same_checked_type(inner, other_inner)
            else -> false
        }
        .Union(members) -> if right.kind == {
            .Union(other) -> mir_type_array_identity_equal(members, other)
            else -> false
        }
        .Quantity(base, dimension) -> if right.kind == {
            .Quantity(other_base, other_dimension) -> mir_type_same_checked_type(base, other_base) && dimension == other_dimension
            else -> false
        }
        .Measure(value) -> if right.kind == {
            .Measure(other) -> value == other
            else -> false
        }
        else -> false
    }
    same
}

fn mir_type_array_identity_equal(left: [MIRType], right: [MIRType]) -> Bool Never! {
    if left.len() != right.len() -> return false
    loop (i, ty) in left {
        if !mir_type_same_checked_type(ty, right[i]) -> return false
    }
    true
}

fn mir_optional_type_identity_equal(left: MIRType?, right: MIRType?) -> Bool Never! {
    if left == None -> return right == None
    right_type :: right ?? return false
    mir_type_same_checked_type(left, right_type)
}

fn mir_trait_ref_array_identity_equal(left: [MIRTraitRef], right: [MIRTraitRef]) -> Bool Never! {
    if left.len() != right.len() -> return false
    loop (i, item) in left {
        if item.id != right[i].id -> return false
    }
    true
}

fn mir_tuple_fields_identity_equal(left: [MIRTupleField], right: [MIRTupleField]) -> Bool Never! {
    if left.len() != right.len() -> return false
    loop (i, field) in left {
        if field.name != right[i].name || !mir_type_same_checked_type(field.ty, right[i].ty) -> return false
    }
    true
}

fn mir_function_signature_identity_equal(left: MIRFunctionSignature, right: MIRFunctionSignature) -> Bool Never! {
    if !mir_type_array_identity_equal(left.params, right.params) || !mir_optional_type_identity_equal(left.ret, right.ret) -> return false
    if !mir_call_contract_identity_equal(left.param_contract, right.param_contract) -> return false
    if left.params.len() != right.params.len() -> return false
    loop i in 0..<left.params.len() {
        if mir_signature_convention(left, i) != mir_signature_convention(right, i) -> return false
    }
    left_variadic :: mir_optional_call_metadata_is_variadic(left.call_metadata)
    right_variadic :: mir_optional_call_metadata_is_variadic(right.call_metadata)
    if left_variadic != right_variadic -> return false
    if !left_variadic -> return true
    mir_variadic_identity_equal(left.call_metadata, right.call_metadata)
}

fn mir_signature_convention(signature: MIRFunctionSignature, index: Int) -> MIRAccess Never! {
    if signature.call_metadata != None {
        metadata :: signature.call_metadata ?? return MIRAccess.Read
        if index < metadata.conventions.len() -> return metadata.conventions[index]
    }
    MIRAccess.Read
}

fn mir_call_contract_identity_equal(left: [MIRCallContractRow]?, right: [MIRCallContractRow]?) -> Bool Never! {
    if left == None -> return right == None
    if right == None -> return false
    if left.len() != right.len() -> return false
    loop (i, row) in left {
        if row.label != right[i].label || row.zone != right[i].zone -> return false
    }
    true
}

fn mir_optional_call_metadata_is_variadic(metadata: MIRCallMetadata?) -> Bool Never! {
    value :: metadata ?? return false
    mir_call_metadata_is_variadic(value)
}

fn mir_variadic_identity_equal(left: MIRCallMetadata?, right: MIRCallMetadata?) -> Bool Never! {
    left_metadata :: left ?? return false
    right_metadata :: right ?? return false
    if left_metadata.variadic.len() != right_metadata.variadic.len() -> return false
    loop (i, item) in left_metadata.variadic {
        if item != right_metadata.variadic[i] -> return false
    }
    true
}

pub fn mir_type_identity_key(ty: MIRType) -> String Never! {
    identity :: ty.identity ?? return mir_type_canonical_key(ty)
    "id:{identity.value}"
}

pub fn mir_type_canonical_key(ty: MIRType) -> String Never! {
    kind :: ty.kind
    if kind == {
        .Int -> return "Int"
        .Float -> return "Float"
        .Bool -> return "Bool"
        .String -> return "String"
        .Char -> return "Char"
        .List(inner) -> return "List<{mir_type_canonical_key(inner)}>"
        .Map(key, value) -> return "Map<{mir_type_canonical_key(key)},{mir_type_canonical_key(value)}>"
        .Shared(inner) -> return "Shared<{mir_type_canonical_key(inner)}>"
        .Option(inner) -> return "Option<{mir_type_canonical_key(inner)}>"
        .Result(ok, err) -> return "Result<{mir_type_canonical_key(ok)},{mir_type_canonical_key(err)}>"
        .Fn(signature) -> return mir_function_signature_canonical_key(signature)
        .SendFn(params, ret, conventions) -> return mir_send_function_canonical_key(params, ret, conventions)
        .Apply(name, args) -> return mir_applied_type_canonical_key(name, args)
        .TraitObject(bounds) -> return mir_trait_object_canonical_key(bounds)
        .Tuple(fields) -> return mir_tuple_canonical_key(fields)
        .FixedList(elem, len) -> return "FixedList<{mir_type_canonical_key(elem)};{mir_measure_expression(len)}>"
        .IntN(signed, bits) -> {
            prefix :: if signed -> "I" else -> "U"
            return "{prefix}Int{bits}"
        }
        .InlineRange(base, lo, hi) -> return "Range<{mir_type_canonical_key(base)};{lo}..{hi}>"
        .Float32 -> return "Float32"
        .Tagged(marker, inner) -> {
            if mir_tag_is_identity_bearing(marker) -> return "Tagged({mir_tag_name(marker)};{mir_type_canonical_key(inner)})"
            return mir_type_canonical_key(inner)
        }
        .Union(members) -> return mir_union_canonical_key(members)
        .Quantity(base, dimension) -> return "Quantity<{mir_type_canonical_key(base)};{mir_dimension_identity(dimension)}>"
        .Measure(value) -> return "Measure({mir_measure_kind(value)}:{mir_measure_expression(value)})"
        else -> panic("unsupported MIR type kind in canonical key")
    }
}

fn mir_function_signature_canonical_key(signature: MIRFunctionSignature) -> String Never! {
    params := [String]{}
    loop param in signature.params -> &params.push(mir_type_canonical_key(param))
    result :: signature.ret.map(value -> mir_type_canonical_key(value)) ?? "Unit"
    contract := [String]{}
    contract_rows :: signature.param_contract ?? [MIRCallContractRow]{}
    loop row in contract_rows -> &contract.push("{row.label}:{param_zone_name(row.zone)}")
    conventions := [String]{}
    i := 0
    loop _ in signature.params {
        access := MIRAccess.Read
        if signature.call_metadata != None {
            metadata :: signature.call_metadata ?? MIRCallMetadata{names: [String]{}, defaults: [Bool]{}, variadic: [Bool]{}, conventions: [MIRAccess]{}, policies: MIRCallablePolicyChain{policies: [MIRCallablePolicy]{}}}
            if i < metadata.conventions.len() -> access = metadata.conventions[i]
        }
        &conventions.push(mir_access_code(access))
        i = i + 1
    }
    variadic := [String]{}
    if signature.call_metadata != None {
        metadata :: signature.call_metadata ?? MIRCallMetadata{names: [String]{}, defaults: [Bool]{}, variadic: [Bool]{}, conventions: [MIRAccess]{}, policies: MIRCallablePolicyChain{policies: [MIRCallablePolicy]{}}}
        if {
            mir_call_metadata_is_variadic(metadata) -> {
                loop value in metadata.variadic {
                    code :: if value -> "1" else -> "0"
                    &variadic.push(code)
                }
            }
            else -> {}
        }
    }
    "Fn({params.join(",")})->{result};contract={contract.join(",")};conventions={conventions.join("")};variadic={variadic.join("")}"
}

fn mir_send_function_canonical_key(params: [MIRType], ret: MIRType?, conventions: [MIRAccess]) -> String Never! {
    names := [String]{}
    loop param in params -> &names.push(mir_type_canonical_key(param))
    result :: ret.map(value -> mir_type_canonical_key(value)) ?? "Unit"
    access := [String]{}
    loop item in conventions -> &access.push(mir_access_code(item))
    "SendFn({names.join(",")})->{result};conventions={access.join("")}"
}

fn mir_applied_type_canonical_key(name: MIRNominalRef, args: [MIRType]) -> String Never! {
    if args.len() == 0 -> return name.name
    names := [String]{}
    loop arg in args -> &names.push(mir_type_canonical_key(arg))
    "Apply({name.id.value})<{names.join(",")}>"
}

fn mir_trait_object_canonical_key(bounds: [MIRTraitRef]) -> String Never! {
    ids := [String]{}
    loop bound in bounds -> &ids.push("{bound.id.value}")
    "Trait({ids.join("+")})"
}

fn mir_tuple_canonical_key(fields: [MIRTupleField]) -> String Never! {
    names := [String]{}
    loop field in fields -> &names.push("{field.name}:{mir_type_canonical_key(field.ty)}")
    "Tuple({names.join(",")})"
}

fn mir_union_canonical_key(members: [MIRType]) -> String Never! {
    names := [String]{}
    loop member in members -> &names.push(mir_type_canonical_key(member))
    "Union({names.join("|")})"
}

fn mir_access_code(access: MIRAccess) -> String Never! {
    if access == {
        .Read -> "R"
        .Write -> "W"
        .Move -> "M"
    }
}

pub fn mir_type_display_name(ty: MIRType) -> String Never! {
    if ty.kind == {
        .Int -> "Int"
        .Float -> "Float"
        .Bool -> "Bool"
        .String -> "String"
        .Char -> "Char"
        .List(inner) -> "[{mir_type_display_name(inner)}]"
        .Map(key, value) -> "[{mir_type_display_name(key)}:{mir_type_display_name(value)}]"
        .Shared(inner) -> "Shared<{mir_type_display_name(inner)}>"
        .Option(inner) -> "{mir_marked_display_name(inner)}?"
        .Result(ok, err) -> mir_result_display_name(ok, err)
        .Fn(signature) -> mir_function_signature_display_name(signature)
        .SendFn(params, ret, _) -> {
            names := [String]{}
            loop param in params -> &names.push(mir_type_display_name(param))
            result :: ret.map(value -> mir_type_display_name(value)) ?? "Unit"
            "SendFn({names.join(", ")}) -> {result}"
        }
        .Apply(name, args) -> {
            names := [String]{}
            loop arg in args -> &names.push(mir_type_display_name(arg))
            "{name.name}<{names.join(", ")}>"
        }
        .TraitObject(bounds) -> {
            names := [String]{}
            loop bound in bounds -> &names.push(bound.name)
            names.join(" + ")
        }
        .Tuple(fields) -> {
            names := [String]{}
            loop field in fields -> &names.push("{field.name}: {mir_type_display_name(field.ty)}")
            "({names.join(", ")})"
        }
        .FixedList(elem, len) -> "[{mir_type_display_name(elem)}#{mir_measure_expression(len)}]"
        .IntN(signed, bits) -> {
            prefix :: if signed -> "I" else -> "U"
            "{prefix}{bits}"
        }
        .InlineRange(base, lo, hi) -> "{mir_type_display_name(base)}({lo}..{hi})"
        .Float32 -> "F32"
        .Tagged(marker, inner) -> {
            if marker == {
                .User(name) -> "#{name} {mir_type_display_name(inner)}"
                .Internal(_) -> mir_type_display_name(inner)
            }
        }
        .Union(members) -> {
            names := [String]{}
            loop member in members -> &names.push(mir_type_display_name(member))
            names.join(" | ")
        }
        .Quantity(base, dimension) -> "Quantity<{mir_dimension_display_name(dimension)}, {mir_type_display_name(base)}; {mir_dimension_identity(dimension)}>"
        .Measure(value) -> mir_measure_expression(value)
    }
}

fn mir_result_display_name(ok: MIRType, err: MIRType) -> String Never! {
    is_default_error :: if err.kind == {
        .Apply(name, args) -> args.len() == 0 && name.name == "Err"
        else -> false
    }
    // D-TYPE-SUFFIX1=A: the error contract follows its type: `E!`.
    if mir_type_is_unit(ok) -> return "{mir_marked_display_name(err)}!"
    if !is_default_error -> return "{mir_marked_display_name(ok)} {mir_marked_display_name(err)}!"
    mir_type_display_name(ok)
}

// A type written before a suffix mark is grouped when the mark would
// otherwise bind to its last member.
fn mir_marked_display_name(ty: MIRType) -> String Never! {
    if ty.kind == {
        .Union(_) | .Fn(_) | .SendFn(_, _, _) | .Result(_, _) | .Tagged(_, _) -> "({mir_type_display_name(ty)})"
        else -> mir_type_display_name(ty)
    }
}

pub fn mir_function_signature_display_name(signature: MIRFunctionSignature) -> String Never! {
    params :: mir_signature_parameter_names(signature.params, signature.param_contract)
    out := "fn({params})"
    if signature.ret == .Val(value) {
        if !mir_type_is_unit(value) -> out = "{out} {mir_type_display_name(value)}"
    }
    if signature.effect_bound != None -> out = "{out} -[{(signature.effect_bound ?? [String]{}).join(",")}]>"
    out
}

fn mir_signature_parameter_names(params: [MIRType], param_contract: [MIRCallContractRow]?) -> String Never! {
    names := [String]{}
    contracts :: param_contract ?? [MIRCallContractRow]{}
    star_done := false
    loop (i, param) in params {
        zone_known :: i < contracts.len()
        if zone_known && contracts[i].zone == ParamZone.LabelOnly && !star_done {
            &names.push("*")
            star_done = true
        }
        label :: if zone_known -> contracts[i].label else -> ""
        if label == "" { &names.push(mir_type_display_name(param)) } else { &names.push("{label}: {mir_type_display_name(param)}") }
        positional :: zone_known && contracts[i].zone == ParamZone.PositionalOnly
        next_positional :: i + 1 < contracts.len() && contracts[i + 1].zone == ParamZone.PositionalOnly
        if positional && !next_positional -> &names.push("/")
    }
    names.join(", ")
}

pub fn mir_type_is_integer(ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .Int -> true
        .IntN(_, _) -> true
        .InlineRange(base, _, _) -> mir_type_is_integer(base)
        .Tagged(_, inner) -> mir_type_is_integer(inner)
        else -> false
    }
}

pub fn mir_type_is_float(ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .Float -> true
        .Float32 -> true
        .Tagged(_, inner) -> mir_type_is_float(inner)
        .Quantity(base, _) -> mir_type_is_float(base)
        else -> false
    }
}

pub fn mir_type_is_numeric(ty: MIRType) -> Bool Never! { mir_type_is_integer(ty) || mir_type_is_float(ty) }

pub fn mir_type_has_valid_layout(ty: MIRType) -> Bool Never! { ty.layout == mir_type_layout(ty.kind) }

pub fn mir_type_is_scalar(ty: MIRType) -> Bool Never! { ty.layout.abi == .Scalar(_) }

pub fn mir_type_is_unit(ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .Apply(name, args) -> args.len() == 0 && name.name == "Unit"
        else -> false
    }
}

