// The registered native Codec definitions, shared by checking and lowering.
fn mir_builtin_codec_trait_name(codec: MIRSerdeCodec) -> String Never! {
    if codec == {
        .Encode -> "Encode"
        .Decode -> "Decode"
    }
}

fn mir_builtin_codec_trait_ref(codec: MIRSerdeCodec) -> MIRTraitRef Never! {
    mir_trait_ref(mir_builtin_codec_trait_name(codec))
}

