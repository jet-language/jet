struct MIRExport { symbol: String, function: MIRFunctionID, abi: MIRForeignABI }

// The native Library C export law (owner ruling U3, 2026-10-09): every
// parameter and the result of an `#Export(c)` function is one C primitive,
// independently per position. Fixed widths map 1:1 to their C types; `Int` is
// `int64_t`, `Float` is `double`, `String` is the JetText pointer/length pair.
// The frozen Rust compiler keeps its older homogeneous Library scalar rule;
// this law is Jet-only.
enum MIRCPrimitive { Int Float Bool Text I8 I16 I32 I64 U8 U16 U32 U64 F32 }

fn mir_c_primitive(ty: MIRType) -> MIRCPrimitive? {
    if ty.kind == {
        .Int -> Val(MIRCPrimitive.Int)
        .Float -> Val(MIRCPrimitive.Float)
        .Bool -> Val(MIRCPrimitive.Bool)
        .String -> Val(MIRCPrimitive.Text)
        .Float32 -> Val(MIRCPrimitive.F32)
        .IntN(signed, bits) -> {
            if bits == 8 -> return Val(if signed -> MIRCPrimitive.I8 else -> MIRCPrimitive.U8)
            if bits == 16 -> return Val(if signed -> MIRCPrimitive.I16 else -> MIRCPrimitive.U16)
            if bits == 32 -> return Val(if signed -> MIRCPrimitive.I32 else -> MIRCPrimitive.U32)
            if bits == 64 -> return Val(if signed -> MIRCPrimitive.I64 else -> MIRCPrimitive.U64)
            None
        }
        else -> None
    }
}

// A C `void` result: the checked unit value.
fn mir_c_void(ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .Tuple(fields) -> fields.len() == 0
        .Apply(name, args) -> args.len() == 0 && name.name == "Unit"
        else -> false
    }
}

// The value an export publishes: the success value of a Result carrier (the
// generated boundary exits on failure) or the plain return. Optional and
// diverging carriers have no C result.
fn mir_c_export_result(function: MIRFunction) -> MIRType? {
    if function.failure == {
        .Infallible -> Val(function.return_type)
        // copy: `success` is a payload of read parameter `function`, which keeps the original; the Val carrier owns this one
        .Result(success, _) -> Val(success.copy())
        else -> None
    }
}

// Whether a checked top-level function satisfies the C export law.
fn mir_c_export_signature(function: MIRFunction) -> Bool Never! {
    if function.form != .TopLevel || function.generic_params.len() != 0 || function.capture_params.len() != 0 -> return false
    loop param in function.params {
        if mir_c_primitive(param.ty) == None -> return false
    }
    result :: mir_c_export_result(function) ?? return false
    mir_c_void(result) || mir_c_primitive(result) != None
}

// The sandbox Component export law (D-PLUGIN-EXPORT1=A): every parameter and
// the published result of a sandbox `pub fn` is one recursively closed
// Component Model shape, independently per position: `Int`, `Float`, `Bool`,
// `String`, or a `List`, `Option`, `Result` or `#Codable` record of them. The
// published result is the same `mir_c_export_result` the C law uses, so a
// unit, Optional or diverging result has no Component value. `codable_keys`
// names the checked record types that derive both Encode and Decode: the
// boundary never invents a record layout from a spelling. Fixed widths,
// maps, tuples, unions, handles and generic applications have no Component
// shape here.
fn mir_component_type_descriptor(types: [MIRTypeDef], codable_keys: [String], ty: MIRType, seen: [MIRTypeID]) -> MIRComponentTypeDescriptor? {
    if ty.kind == {
        .Int -> return Val(MIRComponentTypeDescriptor.Int)
        .Float -> return Val(MIRComponentTypeDescriptor.Float)
        .Bool -> return Val(MIRComponentTypeDescriptor.Bool)
        .String -> return Val(MIRComponentTypeDescriptor.String)
        .List(inner) | .FixedList(inner, _) -> return mir_component_type_descriptor(types, codable_keys, inner, seen).map(value -> MIRComponentTypeDescriptor.List{inner: value})
        .Option(inner) -> return mir_component_type_descriptor(types, codable_keys, inner, seen).map(value -> MIRComponentTypeDescriptor.Option{inner: value})
        .InlineRange(inner, _, _) | .Tagged(_, inner) -> return mir_component_type_descriptor(types, codable_keys, inner, seen)
        .Result(ok, err) -> {
            ok_descriptor :: mir_component_type_descriptor(types, codable_keys, ok, seen) ?? return None
            err_descriptor :: mir_component_type_descriptor(types, codable_keys, err, seen) ?? return None
            return Val(MIRComponentTypeDescriptor.Result{ok: ok_descriptor, err: err_descriptor})
        }
        .Apply(name, args) -> {
            if args.len() != 0 -> return None
            loop prior in seen {
                if prior == name.id -> return None
            }
            next_seen := seen
            &next_seen.push(name.id)
            loop definition in types {
                if definition.id != name.id -> next
                if definition.kind == {
                    .Alias(target) -> return mir_component_type_descriptor(types, codable_keys, target, next_seen)
                    .Struct(fields, _) -> {
                        if !codable_keys.contains(definition.key) -> return None
                        component_fields := [MIRComponentTypeField]{}
                        loop index in 0..<fields.len() {
                            field :: fields[index]
                            if field.skip || field.computed -> next
                            descriptor :: mir_component_type_descriptor(types, codable_keys, field.ty, next_seen) ?? return None
                            &component_fields.push(MIRComponentTypeField{index: index, name: field.shape_names.json ?? field.name, ty: descriptor})
                        }
                        return Val(MIRComponentTypeDescriptor.Record{name: definition.name, fields: component_fields})
                    }
                    else -> return None
                }
            }
            return None
        }
        else -> return None
    }
}

// Whether a checked top-level function satisfies the sandbox Component export
// law, and its canonical Component signature when it does.
fn mir_component_export_signature(types: [MIRTypeDef], codable_keys: [String], function: MIRFunction) -> MIRComponentSignatureDescriptor? {
    if function.form != .TopLevel || function.generic_params.len() != 0 || function.capture_params.len() != 0 -> return None
    params := [MIRComponentTypeDescriptor]{}
    loop param in function.params {
        descriptor :: mir_component_type_descriptor(types, codable_keys, param.ty, [MIRTypeID]{}) ?? return None
        &params.push(descriptor)
    }
    result :: mir_c_export_result(function) ?? return None
    result_descriptor :: mir_component_type_descriptor(types, codable_keys, result, [MIRTypeID]{}) ?? return None
    Val(MIRComponentSignatureDescriptor{params: params, result: result_descriptor})
}

