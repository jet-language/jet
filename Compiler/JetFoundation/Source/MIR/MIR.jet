    pub visibility: MIRVisibility
    pub target_applicability: MIRTargetApplicability
    pub web_bucket: MIRWebBucket?
    pub web_marker: MIRWebPartitionMarker?
    pub generic_params: [MIRGenericParam]
    pub capture_params: [MIRCaptureParam]
    pub params: [MIRParam]
    pub declared_return: MIRType?
    pub return_type: MIRType
    pub failure: MIRFailureCarrier
    pub effects: MIREffectFacts
    pub captures: MIRCaptureFacts?
    pub generator: MIRGeneratorFacts?
    pub optimization: MIROptimizationFacts
    pub is_unsafe: Bool
    pub unsafe_gate: MIRUnsafeGate?
    pub is_pure: Bool
    pub memo_bound: Int?
    pub memo_unbounded: Bool
    pub is_reactive: Bool
    pub reactive_upgrades: [String]
