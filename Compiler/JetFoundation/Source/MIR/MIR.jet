    pub managed: Bool
    pub plan_digest: ?String
    pub callback_identity: ?String
}

pub struct MirCImportLink { pub importing_module: String, pub scope: ?String, pub alias: String, pub target_module: String }

pub struct MirCLib { pub lib: String, pub module_name: String }

pub struct MirCOverlayOverride { pub lib: String, pub generated_symbol: String, pub overlay_symbol: String }

pub struct MirCloseAdapter { pub lib: String, pub handle_type: String, pub raw_function: String, pub adapter_function: String }

