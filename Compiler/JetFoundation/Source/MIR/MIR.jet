}

pub struct MIROptimizationFacts {
    pub pure: Bool
    pub replayable: Bool
    pub diverges: Bool
    pub inline: Bool
    pub inline_always: Bool
    pub gc_return: Bool
    pub gc_scope: Bool
    pub kernel: Bool
    pub auto_vectorizable: Bool
    pub no_aliasing: Bool
    pub no_early_exit: Bool
    pub no_cross_iteration_dependencies: Bool
    pub derived_from_digest: String?
    pub decision_rows: [MIRDecisionRow]
    pub pass_ids: [MIROptimizationPassID]
    pub loop_facts: [MIRLoopFact]
    pub bounds_facts: [MIRBoundsFact]
    pub vector_facts: [MIRVectorFact]
    pub checked_vector_facts: [MIRVectorFact]
    pub fusion_facts: [MIRFusionFact]
    pub acceleration_facts: [MIRAccelerationFact]
}

pub fn mir_empty_optimization_facts() -> MIROptimizationFacts Never! {
    MIROptimizationFacts{
        pure: false,
        replayable: false,
        diverges: false,
        inline: false,
        inline_always: false,
        gc_return: false,
        gc_scope: false,
        kernel: false,
        auto_vectorizable: false,
        no_aliasing: false,
        no_early_exit: false,
        no_cross_iteration_dependencies: false,
        derived_from_digest: None,
        decision_rows: [MIRDecisionRow]{},
        pass_ids: [MIROptimizationPassID]{},
        loop_facts: [MIRLoopFact]{},
        bounds_facts: [MIRBoundsFact]{},
        vector_facts: [MIRVectorFact]{},
        checked_vector_facts: [MIRVectorFact]{},
        fusion_facts: [MIRFusionFact]{},
        acceleration_facts: [MIRAccelerationFact]{},
    }
}

