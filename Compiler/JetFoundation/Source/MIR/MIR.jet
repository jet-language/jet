// Canonical semantic MIR. This graph contains checked types, ownership, values,
// places, calls, functions and control flow; target adapters consume these facts
// rather than recreating source-level policy.

// Every MIR identity is a fixed 64-bit word, as in the Rust reference
// (`mir_id!` newtypes over `u64`): a stable FNV-1a hash or, in fixtures, a
// small dense number. Ids never cross into exact `Int`.
struct MIRFunctionID { value: U64 }

struct MIRBlockID { value: U64 }

struct MIRValueID { value: U64 }

struct MIRPlaceID { value: U64 }

struct MIRLocalID { value: U64 }

struct MIROpID { value: U64 }

struct MIRTypeID { value: U64 }

struct MIRCoreCallID { value: U64 }

struct MIRScopeID { value: U64 }

struct MIRModuleID { value: U64 }

struct MIRImportID { value: U64 }

struct MIRTraitID { value: U64 }

struct MIRImplID { value: U64 }

struct MIRConstantID { value: U64 }

struct MIRGCEditSiteID { value: U64 }

struct MIRForeignID { value: U64 }

struct MIRLinkUnitID { value: U64 }

struct MIRCallbackID { value: U64 }

struct MIRHandleID { value: U64 }

struct MIRArtifactID { value: U64 }

struct MIRHarnessID { value: U64 }

struct MIRJobID { value: U64 }

struct MIRTestID { value: U64 }

struct MIRCoveragePointID { value: U64 }

struct MIRTraitMethodID { value: U64 }

struct MIROutputCheckID { value: U64 }

struct MIRDataPlanNodeID { value: U64 }

struct MIRPreludeCallID { value: U64 }

struct MIRFieldID { value: U64 }

struct MIRSourceFileID { value: U64 }

struct MIRSiteID { value: U64 }

// Stable FNV-1a over namespace, NUL, and canonical identity; IDs never depend
// on process hash seeds, allocation order, or a backend's naming scheme.
fn stable_id(namespace: String, identity: String) -> U64 Never! {
    prime :: U64{0x100000001b3}
    // The FNV-1a offset basis 0xcbf29ce484222325, built from two halves that
    // each fit an Int literal: a wider literal is parsed from its decimal
    // text on every call, which dominated this function.
    high :: U64{0xcbf29ce4}
    hash := (high.wrapping_mul(U64{0x100000000})).bit_xor(U64{0x84222325})
    loop byte in namespace.bytes() -> hash = ((hash).bit_xor(U64.from_u8(byte))).wrapping_mul(prime)
    hash = hash.wrapping_mul(prime)
    loop byte in identity.bytes() -> hash = ((hash).bit_xor(U64.from_u8(byte))).wrapping_mul(prime)
    if hash == 0 -> return U64{1}
    hash
}

fn mir_trait_id(identity: String) -> MIRTraitID Never! { MIRTraitID{value: stable_id("mir-trait", identity)} }

fn mir_source_file_id(identity: String) -> MIRSourceFileID Never! {
    MIRSourceFileID{value: stable_id("mir-source-file", identity)}
}

