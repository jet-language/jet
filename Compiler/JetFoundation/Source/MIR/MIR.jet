// #4318: why a MIR Copy duplicates its operand (MIRRust MirCopyFact). Every
// copy carries the sema decision that made it; lowering and backends never
// print a clone without one, and the legality verifier checks the fact
// against the operand's type.
pub enum MIRCopyFact { Explicit Materialize Share Scalar ViewMaterialize }

// Stable wire name (digests, emitted copy tags).
pub fn mir_copy_fact_name(fact: MIRCopyFact) -> String Never! {
    if fact == {
        .Explicit -> "explicit"
        .Materialize -> "materialize"
        .Share -> "share"
        .Scalar -> "scalar"
        .ViewMaterialize -> "view_materialize"
    }
}

// An implicit copy (materialize, share) of a Copy-ABI value is a bitwise read;
// the user's `~` and view materialization keep their fact.
pub fn mir_copy_fact_for_ownership(fact: MIRCopyFact, mode: MIROwnershipMode) -> MIRCopyFact Never! {
    if mode == MIROwnershipMode.Copy && (fact == MIRCopyFact.Materialize || fact == MIRCopyFact.Share) -> return MIRCopyFact.Scalar
    ~fact
}

