// Core publication sites use the same Global path as module storage. The
// initializer declaration, not a callsite, supplies their identity.
enum MIRSharedLifetime { Process World Thread Attempt }
fn mir_shared_lifetime_core_member(name: String) -> MIRSharedLifetime? Never! {
    if name == {
        "__process_shared" -> Val(MIRSharedLifetime.Process)
        "__world_shared" -> Val(MIRSharedLifetime.World)
        "__thread_shared" -> Val(MIRSharedLifetime.Thread)
        "__attempt_shared" -> Val(MIRSharedLifetime.Attempt)
        else -> None
    }
}
struct MIRSharedSite { initializer: MIRFunctionID, lifetime: MIRSharedLifetime }

// The pinned Core image and every dynamic importer use this exact link name.
fn mir_shared_site_getter_symbol(initializer: MIRFunctionID) -> String Never! {
    prefix :: "jet_core_shared_".bytes()
    digits :: "0123456789abcdef".bytes()
    bytes :: loop index in 0..<32 -> if index < 16 -> prefix[index] else -> digits[Int.from_u64((initializer.value >> ((31 - index) * 4)).bit_and(U64{15}))]
    String.from_bytes(bytes) ?? panic("Shared site symbol is not ASCII")
}

