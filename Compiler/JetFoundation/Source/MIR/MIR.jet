pub enum MIRDecisionKind { Tier Inline Vectorize Parallel Copy Bounds Deopt Unreachable LoopInvariant }

pub enum MIRDecisionDisposition { Accepted Rejected Selected NotAttempted Unavailable }

pub enum MIROptimizationRejection { MissingProof MayTrap HasEffects HasEarlyExit MayAlias CrossIterationDependency DynamicTripCount UnknownCopyCost ScalarBoundary ObservableLayout OwnershipObligation UnsupportedOperation }

pub enum MIROptimizationDecision { Eligible Rejected(reason: MIROptimizationRejection) }

pub enum MIRDerivationMethod { StaticDerivation FormalProof RecordedExecution SampledAgreement ExternalAssumption }

pub enum MIRDerivationDisposition { Current Stale Expired Redacted Unavailable Unsupported BudgetExhausted Unknown }

pub struct MIRDerivationRef { pub id: String }

