fn mir_authority_plugin_load() -> MIRAuthorityDecision Never! {
    MIRAuthorityDecision{
        import: MIRHostImportFact{
            id: "core.plugin.authority",
            operation: "core.plugin.host-import",
            required_right: "FS.Read",
            parameter_type_ids: [String]{"String", "Authority"},
            result_type_id: Val("Plugin"),
        },
        authority_argument: Val(1),
        inherited: false,
    }
}

fn mir_authority_plugin_call() -> MIRAuthorityDecision Never! {
    load :: mir_authority_plugin_load()
    MIRAuthorityDecision{import: load.import, authority_argument: None, inherited: true}
}

