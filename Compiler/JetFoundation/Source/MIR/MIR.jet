pub enum MIRVectorRule { Elementwise FieldAccess ConditionalAccumulate EarlyExitSearch Reduction }

pub enum MIRVectorLayout { Flat AosStrided ColumnarDirect }

pub enum MIRVectorAccessRoot { Place(id: MIRPlaceID) Value(id: MIRValueID) }

pub struct MIRVectorAccess {
