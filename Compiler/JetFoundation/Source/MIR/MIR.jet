    Slice(call: MIRPreludeCallID, base: MIRValueID, start: MIRValueID, end: MIRValueID, range: MIRValueID?, location: MIRPanicLoc)
    Range(start: MIRValueID, end: MIRValueID, exclusive: Bool)
    Field(base: MIRValueID, field: MIRFieldID)
