pub struct MirSiteId { pub value: Int }

// Stable FNV-1a over namespace, NUL, and canonical identity; IDs never depend
// on process hash seeds, allocation order, or a backend's naming scheme.
pub fn stable_id(namespace: String, identity: String) -> Int {
    mask :: 0xffffffffffffffff
    hash := 0xcbf29ce484222325
    loop byte in namespace.bytes() -> hash = ((hash ^ Int.from_u8(byte)) * 0x100000001b3) & mask
    hash = (hash * 0x100000001b3) & mask
    loop byte in identity.bytes() -> hash = ((hash ^ Int.from_u8(byte)) * 0x100000001b3) & mask
    if hash == 0 -> return 1
    hash
}

pub fn mir_function_id(identity: String) -> MirFunctionId { MirFunctionId{value: stable_id("mir-function", identity)} }

pub fn mir_type_id(identity: String) -> MirTypeId { MirTypeId{value: stable_id("mir-type", identity)} }

pub fn mir_module_id(identity: String) -> MirModuleId { MirModuleId{value: stable_id("mir-module", identity)} }

pub fn mir_trait_id(identity: String) -> MirTraitId { MirTraitId{value: stable_id("mir-trait", identity)} }

pub fn mir_field_id(identity: String) -> MirFieldId { MirFieldId{value: stable_id("mir-field", identity)} }

pub fn mir_source_file_id(identity: String) -> MirSourceFileId {
    MirSourceFileId{value: stable_id("mir-source-file", identity)}
}

