pub struct MirFfiBoundaryObligation {
    pub name: String
    pub basis: MirFfiEvidenceBasis
    pub checker: String
    pub assumptions: [String]
    pub coverage_digest: String
}

pub struct MirFfiBoundaryFacts {
    pub schema: String
