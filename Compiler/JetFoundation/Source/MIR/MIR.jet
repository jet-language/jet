enum MIRImportKind { File(path: String) Module(path: String) Unqualified(module_id: MIRModuleID, items: [MIRImportItem]) }

struct MIRImportItem { original: String, local: String, item: MIRItemRef }

struct MIRImport { id: MIRImportID, module_id: MIRModuleID, visibility: MIRVisibility, alias: String, kind: MIRImportKind, span: Span, version: String? }

struct MIRModule { id: MIRModuleID, key: String, name: String, path: String, source_file: MIRSourceFileID, imports: [MIRImportID], children: [MIRModuleID], item_order: [MIRItemRef] }

struct MIRSourceFile { id: MIRSourceFileID, path: String, source: String }

enum MIRStructLayout { C CAligned(alignment: Int, target: Bool) Columnar }

enum MIRCEnumTag { CInt U8 I8 U16 I16 U32 I32 U64 I64 }

