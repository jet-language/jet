struct MIRSwitchArm { condition: MIRValueID, target: MIRBlockID, span: Span }

// Stop points of the unified execution host (#4720; Docs/research/jet-backend-design-2026-10-01.md
// "Stop points"). `Check` delivers a pending session interrupt where every live
// value is initialized; `Propagate` directly follows a can-stop operation and
// reads only a stop that operation already delivered. `resume` continues;
// `stop` runs canonical cleanup and ends in `Stopped`, which leaves the
// function with the stop still delivered and no result written.
enum MIRPollKind { Check Propagate }

enum MIRTerminator {
    Jump(target: MIRBlockID)
    Branch(condition: MIRValueID, then_target: MIRBlockID, else_target: MIRBlockID)
    Switch(subject: MIRValueID, arms: [MIRSwitchArm], otherwise: MIRBlockID)
    Return(value: MIRValueID?)
    Yield(value: MIRValueID, resume: MIRBlockID)
    Break(target: MIRBlockID, value: MIRValueID?)
    Continue(target: MIRBlockID)
    Unreachable(reason: String)
    Poll(kind: MIRPollKind, resume: MIRBlockID, stop: MIRBlockID)
    Stopped
}

enum MIRDropEdge { Normal Return Failure(target: MIRBlockID) Unwind(target: MIRBlockID) }

