// Canonical semantic MIR. This graph contains checked types, ownership, values,
// places, calls, functions and control flow; target adapters consume these facts
// rather than recreating source-level policy.

pub MIR_SCHEMA_VERSION :: prep { 6 }

// Every MIR identity is a fixed 64-bit word, as in the Rust reference
// (`mir_id!` newtypes over `u64`): a stable FNV-1a hash or, in fixtures, a
// small dense number. Ids never cross into exact `Int`.
pub struct MIRFunctionID { pub value: U64 }

pub struct MIRBlockID { pub value: U64 }

pub struct MIRValueID { pub value: U64 }

pub struct MIRPlaceID { pub value: U64 }

pub struct MIRLocalID { pub value: U64 }

pub struct MIROpID { pub value: U64 }

pub struct MIRTypeID { pub value: U64 }

pub struct MIRCoreCallID { pub value: U64 }

pub struct MIRScopeID { pub value: U64 }

pub struct MIRClosureID { pub value: U64 }

pub struct MIRModuleID { pub value: U64 }

pub struct MIRImportID { pub value: U64 }

pub struct MIRTraitID { pub value: U64 }

pub struct MIRImplID { pub value: U64 }

pub struct MIRConstantID { pub value: U64 }

pub struct MIRGCEditSiteID { pub value: U64 }

pub struct MIRForeignID { pub value: U64 }

pub struct MIRLinkUnitID { pub value: U64 }

pub struct MIRCallbackID { pub value: U64 }

pub struct MIRHandleID { pub value: U64 }

pub struct MIRArtifactID { pub value: U64 }

pub struct MIRHarnessID { pub value: U64 }

pub struct MIRJobID { pub value: U64 }

pub struct MIRTestID { pub value: U64 }

pub struct MIRCoveragePointID { pub value: U64 }

pub struct MIRTraitMethodID { pub value: U64 }

pub struct MIROutputCheckID { pub value: U64 }

pub struct MIRDataPlanNodeID { pub value: U64 }

pub struct MIRPreludeCallID { pub value: U64 }

pub struct MIRFieldID { pub value: U64 }

pub struct MIRSourceFileID { pub value: U64 }

pub struct MIRSiteID { pub value: U64 }

// Stable FNV-1a over namespace, NUL, and canonical identity; IDs never depend
// on process hash seeds, allocation order, or a backend's naming scheme.
pub fn stable_id(namespace: String, identity: String) -> U64 Never! {
    prime :: U64{0x100000001b3}
    // The FNV-1a offset basis 0xcbf29ce484222325, built from two halves that
    // each fit an Int literal: a wider literal is parsed from its decimal
    // text on every call, which dominated this function.
    high :: U64{0xcbf29ce4}
    hash := high.wrapping_mul(U64{0x100000000}) ~| U64{0x84222325}
    loop byte in namespace.bytes() -> hash = (hash ~| U64.from_u8(byte)).wrapping_mul(prime)
    hash = hash.wrapping_mul(prime)
    loop byte in identity.bytes() -> hash = (hash ~| U64.from_u8(byte)).wrapping_mul(prime)
    if hash == 0 -> return U64{1}
    hash
}

pub fn mir_function_id(identity: String) -> MIRFunctionID Never! { MIRFunctionID{value: stable_id("mir-function", identity)} }

pub fn mir_type_id(identity: String) -> MIRTypeID Never! { MIRTypeID{value: stable_id("mir-type", identity)} }

pub fn mir_module_id(identity: String) -> MIRModuleID Never! { MIRModuleID{value: stable_id("mir-module", identity)} }

pub fn mir_trait_id(identity: String) -> MIRTraitID Never! { MIRTraitID{value: stable_id("mir-trait", identity)} }

pub fn mir_field_id(identity: String) -> MIRFieldID Never! { MIRFieldID{value: stable_id("mir-field", identity)} }

pub fn mir_source_file_id(identity: String) -> MIRSourceFileID Never! {
    MIRSourceFileID{value: stable_id("mir-source-file", identity)}
}

