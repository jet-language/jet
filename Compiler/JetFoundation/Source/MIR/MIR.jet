// Canonical semantic MIR. This graph contains checked types, ownership, values,
// places, calls, functions and control flow; target adapters consume these facts
// rather than recreating source-level policy.

@MIR_SCHEMA_VERSION :: 6

pub struct MirFunctionId { pub value: Int }

pub struct MirBlockId { pub value: Int }

pub struct MirValueId { pub value: Int }

pub struct MirPlaceId { pub value: Int }

pub struct MirLocalId { pub value: Int }

