enum MIRBinaryOp { Add Sub Mul Div FloorDiv Mod Rem Pow BitAnd BitOr BitXor Shl Shr Eq Ne Lt Gt Le Ge Compare And Or }

enum MIRBinaryDispatch { Primitive Prelude(call: MIRPreludeCallID, location: MIRPanicLoc?) }

// `Trap` exactly when the operands are fixed-width integers, the operator can
// overflow (`+ - * / pow << >>`), and the dispatch is that width's trap route
// (`{width}.trap.{op}`). Native MIR carries the trap only in that route, so the
// bootstrap bridge checks this rule going out and re-derives the mode coming back.
enum MIRBinaryOverflow { Unchecked Trap }

// Trap is the checked policy fact; sema never puts it on a proven-total op.
fn mir_binary_can_trap(op: MIRBinaryOp, overflow: MIRBinaryOverflow) -> Bool Never! {
    if overflow != .Trap -> return false
    if op == {
        .Add | .Sub | .Mul | .Div | .FloorDiv | .Mod | .Rem | .Pow | .Shl | .Shr -> true
        else -> false
    }
}

