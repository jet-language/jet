    pub output_type: String
    pub error_type: String
    pub endpoint: String
    pub method: String
    pub csrf: String
    pub effects: [String]
    pub fields: [MIRAppFormFieldFact]
    pub middleware: [String]
    pub provenance: String
    pub span_start: Int
    pub span_end: Int
}

pub struct MIRAppGraph {
    pub entry_file: String
    pub routes: [MIRAppRoute]
    pub actions: [MIRAppAction]
    pub forms: [MIRAppFormFact]
    pub queries: [MIRAppQueryFact]
    pub stores: [MIRAppStoreFact]
    pub mounts: [MIRAppMount]
    pub routes_from: [MIRAppRoutesFrom]
    pub policy: MIRAppPolicy
    pub hydration: String
    pub shared_tir: Bool
}

pub struct MIRPackageFacts {
    pub project_root: String
    pub edition: String
    pub runtime_parts: [MIRRuntimePartID]
    pub uses_arrow: Bool
    pub active_os: String
    pub inferred_layer: String
    pub allocator: String
    pub package_version: String
    pub artifact_target: MIRArtifactTarget?
    pub target_dossier: MIRTargetDossier
    pub web_app: MIRAppGraph?
    pub authority_needs: [String]
    pub hardware_use: MIRTargetHardwareUse
    pub hardware_profile: MIRTargetHardwareFacts?
    pub hardware_profile_id: String
    pub hardware_capabilities: [String]
    pub hardware_setups: [MIRHardwareSetup]
}

pub enum MIRHardwareSetup {
    DMAConfigure(profile_id: String, channel: String, transfer_width: MIRRegisterWidth, ownership: MIRTargetDMAOwnership)
    InterruptBind(profile_id: String, interrupt: String, vector: Int, handler_symbol: String, forbidden_effects: [String])
}

pub struct MIRCoreCall {
    pub id: MIRCoreCallID
    pub key: String
    pub module_name: String
    pub member: String
    pub receiver_types: [String]
    pub arity: Int
    pub max_arity: Int
    pub borrow_mask: [Bool]
    pub fallibility: CoreCallFallibility
    pub effect_kind: Effect?
    pub effect_leaf: String?
    pub sink_class: SinkClass?
    pub pure_route: CoreCallPureRoute
    pub interpreter_route: CoreCallInterpreterRoute
    pub symbol: CoreCallSymbol
    pub coverage_bits: Int
    pub aot_direct: Bool
    pub jit_direct: Bool
    pub jit_symbol: String?
    pub native_int_result: Bool
    pub marker: CoreMarkerApplication?
}

pub struct MIRFunctionRow { pub function: MIRFunction }

pub enum MIRErasureReason { CompileTimeOnly Disabled ExpandedBeforeLowering SemanticIndexOnly }

pub struct MIRUnreachable { pub construct: String, pub span: Span, pub reason: MIRErasureReason }

// Backend-neutral semantic graph used by lowering and all MIR consumers. Native
// artifact/provider activation records remain in their owning backend adapters.
pub struct MIRProgram {
    pub cffi: MIRCffiFacts
    pub schema_version: Int
    pub package_identity: String
    pub facts: MIRPackageFacts
    pub names: MIRNameFacts
    pub modules: [MIRModule]
    pub imports: [MIRImport]
    pub types: [MIRTypeDef]
    pub traits: [MIRTraitDef]
    pub core_owners: [MIRCoreOwner]
    pub impls: [MIRImplDef]
    pub constants: [MIRConstantDef]
    pub fields: [MIRFieldRow]
    pub source_files: [MIRSourceFile]
    pub functions: [MIRFunction]
    pub foreign: [MIRForeign]
    pub links: [MIRLinkUnit]
    pub callbacks: [MIRCallbackAdapter]
    pub handles: [MIRHandleLifecycle]
    pub jobs: [MIRJob]
    pub tests: [MIRTestCase]
    pub harnesses: [MIRHarnessPlan]
    pub artifacts: [MIRArtifactPlan]
    pub core_calls: [MIRCoreCall]
    pub prelude_calls: [MIRPreludeCall]
    pub type_instances: [MIRType]
    pub codec_migrations: [String:MIRSchemaMigrationPlan]
    pub unreachable: [MIRUnreachable]
}
