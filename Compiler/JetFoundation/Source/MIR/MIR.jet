    pub derivation: MIRDerivationRef?
    pub identity: MIRDecisionIdentity?
    pub evidence_method: MIRDerivationMethod?
    pub derivation_disposition: MIRDerivationDisposition?
}

pub enum MIRLoopForm { Unconditional Counted Iterator }

pub enum MIRCopyCost { NoCopy PerIteration(count: Int) Unknown }

