enum MIRTypedHeadKind { SQL HTML Sh URL Path DateTime }

// The shared boundary-head classification, mirrored by Syntax::typed_head_kind.
fn mir_typed_head_kind(head: Type) -> MIRTypedHeadKind? {
    if head == {
        .Named(name) -> {
            if name == "SQL" -> return Val(MIRTypedHeadKind.SQL)
            if name == "HTML" -> return Val(MIRTypedHeadKind.HTML)
            if name == "Sh" -> return Val(MIRTypedHeadKind.Sh)
            if name == "URL" -> return Val(MIRTypedHeadKind.URL)
            if name == "Path" -> return Val(MIRTypedHeadKind.Path)
            if name == "DateTime" -> return Val(MIRTypedHeadKind.DateTime)
        }
        else -> {}
    }
    None
}

// The Core module whose runtime serves a boundary typed head (its usage and
// linkage key), not necessarily a record of the same type.
fn mir_boundary_head_owner_module(name: String) -> String? {
    if name == "URL" -> return Val("core.net.url")
    if name == "Path" -> return Val("core.files")
    if name == "DateTime" -> return Val("core.time")
    None
}

// The Core module whose same-named record is the built-in value. URL and
// DateTime use their checked source carriers; Path stays the native boundary
// carrier, distinct from core.files.path's record.
fn mir_boundary_head_carrier_module(name: String) -> String? {
    if name == "URL" -> return Val("core.net.url")
    if name == "DateTime" -> return Val("core.time")
    None
}

