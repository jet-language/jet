// Backend-neutral semantic graph used by lowering and all MIR consumers.
// native_pack is set only at the explicit native-runtime ABI lowering boundary;
// it is not the stop-point/native-program fact or a host-provider activation.
struct MIRProgram {
    cffi: MIRCffiFacts
    native_pack: Bool
    schema_version: Int
    package_identity: String
    facts: MIRPackageFacts
    names: MIRNameFacts
    modules: [MIRModule]
    imports: [MIRImport]
    types: [MIRTypeDef]
    traits: [MIRTraitDef]
    core_owners: [MIRCoreOwner]
    impls: [MIRImplDef]
    constants: [MIRConstantDef]
    fields: [MIRFieldRow]
    source_files: [MIRSourceFile]
    functions: [MIRFunction]
    foreign: [MIRForeign]
    links: [MIRLinkUnit]
    callbacks: [MIRCallbackAdapter]
    handles: [MIRHandleLifecycle]
    jobs: [MIRJob]
    tests: [MIRTestCase]
    harnesses: [MIRHarnessPlan]
    artifacts: [MIRArtifactPlan]
    core_calls: [MIRCoreCall]
    prelude_calls: [MIRPreludeCall]
    type_instances: [MIRType]
    codec_migrations: [String:MIRSchemaMigrationPlan]
    unreachable: [MIRUnreachable]
    // A consumer-built lookup index, never serialized or digested: the first
    // row of each type id and each type key in `types`, and of each trait key
    // or name in `traits` (JetBackend Lower.jet lower_indexed_program). Empty
    // unless a consumer builds it; when empty, lookups scan `types`/`traits`.
    type_id_rows: [U64:Int]{[U64:Int]{}}
    type_key_rows: [String:Int]{[String:Int]{}}
    trait_name_rows: [String:Int]{[String:Int]{}}
}

// Resolve a private Core value hook through checked nominal and function
// identities. Consumers prepare this once; a short user type name never wins.
fn mir_source_value_hook(program: MIRProgram, ty: MIRType, operation: String) -> MIRFunctionID? Never! {
    if ty.kind == .Tagged(_, inner) -> return mir_source_value_hook(program, inner, operation)
    if ty.kind == .Apply(owner, _) {
        hook :: core_source_value_hook(owner.name, operation) ?? return None
        found := MIRFunctionID?{None}
        loop function in program.functions {
            if function.form == .Method(method_owner, self_access) {
                if self_access != (Val(MIRAccess.Read)) -> next
                if method_owner.kind == .Apply(method_ref, _) {
                    if method_ref.id != owner.id || method_ref.name != owner.name -> next
                    parts :: function.name.split("::").to_list()
                    if parts.len() == 0 || parts[parts.len() - 1] != hook -> next
                    if found != None -> return None
                    found = Val(function.id)
                }
            }
        }
        return found
    }
    None
}
