// operation_kind -> CanonicalPass/MIR.jet::canonical_pass_mir_operation_kind.
// These existing renderers preserve escaping, quoted IDs, null option/dynamic
// size encodings, span/source-line facts and the complete operation-kind match.

// Rust: crates/jet-foundation/src/MIR.rs:7361
pub fn canonical_operation_payload(operation: MIROperation) -> String Never! {
    uses :: loop value in mir_operation_value_uses(operation) -> "\"{value.value}\""
    copy_materialization :: canonical_pass_mir_copy_materialization(operation)
    "{{\"representation\":\"mir\",\"operation_kind\":\"{canonical_pass_mir_operation_kind(operation)}\",\"value_uses\":[{uses.join(",")}]{copy_materialization}}}"
}

