use std.fmt.[Write, Error]

// Rust: crates/jet-foundation/src/MIR.rs:6687
// MirFrameIdentity is MIRFrameIdentity in MIR/NativeCarriers.jet.
// Rust: crates/jet-foundation/src/MIR.rs:6688
pub fn mir_frame_identity_write_canonical<W: Write>(identity: MIRFrameIdentity, out: &W) Error! {
    // GATE #4494: Rust fmt::Write error-preserving writer transport.
    &out.write_str("mir-frame-identity:{identity.schema_version};")
    &out.write_str(mir_execution_identity_canonical_text(identity.execution))
    &out.write_str(";function:{identity.function.value};")
    if identity.block == {
        .Val(block) -> &out.write_str("block:{block.value};")
        .None -> &out.write_str("block:none;")
    }
    &out.write_str("sequence:{identity.sequence};")
}

