// Rust: crates/jet-foundation/src/MIR.rs:6874
// This is a production lookup, not a #[test] despite its Rust name.
pub fn test_scope_member(function: MIRFunction, scope: MIRScopeID) -> MIRTestScopeMember? Never! {
    loop block in function.blocks {
        loop instruction in block.instructions {
            if instruction.operation == {
                .ScopeEnter(candidate, test_member) -> {
                    if candidate == scope && test_member != None -> return test_member
                }
                else -> {}
            }
        }
    }
    None
}

// Rust: crates/jet-foundation/src/MIR.rs:6888
pub fn is_decode_for(function: MIRFunction, target: MIRType) -> Bool Never! {
    if function.form == {
        .TraitMethod(owner, _, self_access, .Val(.Decode)) -> {
            if self_access != None || function.generic_params.len() != 0 -> return false
            if mir_type_same_checked_type(owner, target) -> return true
            owner_name :: function.name.strip_suffix("::decode") ?? return false
            owner_name == mir_type_display_name(target)
        }
        else -> false
    }
}

// Rust: crates/jet-foundation/src/MIR.rs:6909
// MirCoreCall -> MIR/MIR.jet::MIRCoreCall; module -> module_name,
// effect -> effect_kind. native_int_result is part of this canonical row.
// Rust: crates/jet-foundation/src/MIR.rs:6936
pub fn from_record(record: CoreCallRecord) -> MIRCoreCall Never! {
    key :: if record.receiver_types.len() == 0 -> "{record.module_name}.{record.member}" else -> "receiver({record.receiver_types.join("|")}).{record.member}"
    MIRCoreCall{
        id: MIRCoreCallID{value: stable_id("core-call", key)},
        key: ^key,
        module_name: ~record.module_name,
        member: ~record.member,
        receiver_types: ~record.receiver_types,
        arity: record.signature.arity,
        max_arity: record.signature.max_arity,
        borrow_mask: ~record.signature.borrow_mask,
        fallibility: record.fallibility,
        effect_kind: record.effect_kind,
        effect_leaf: ~record.effect_leaf,
        sink_class: record.sink_class,
        pure_route: record.pure_route,
        interpreter_route: record.interpreter_route,
        symbol: record.symbol,
        coverage_bits: record.coverage.bits,
        aot_direct: record.aot_direct,
        jit_direct: record.jit_direct,
        jit_symbol: ~record.jit_symbol,
        native_int_result: record.native_int_result,
        marker: ~record.marker
    }
}

// Rust: crates/jet-foundation/src/MIR.rs:6973
// MirRuntimePartId -> MIR/MIR.jet::MIRRuntimePartID; semantic IDs are retained,
// including GC/UI/FSRuntime/HTTP's canonical Jet capitalization.
// Rust: crates/jet-foundation/src/MIR.rs:7007
pub fn as_str(part: MIRRuntimePartID) -> String Never! {
    if part == {
        .GC -> "gc"
        .Event -> "event"
        .Realtime -> "realtime"
        .EmbeddedHardware -> "embedded-hardware"
        .UI -> "ui"
        .Devtools -> "devtools"
        .Gtk -> "gtk"
        .Apps -> "apps"
        .Email -> "email"
        .Game -> "game"
        .Files -> "files"
        .Interrupt -> "interrupt"
        .FSRuntime -> "fs-runtime"
        .Process -> "process"
        .Crypto -> "crypto"
        .Math -> "math"
        .Encoding -> "encoding"
        .Data -> "data"
        .Fmt -> "fmt"
        .DataFmt -> "data-fmt"
        .Compute -> "compute"
        .HTTP -> "http"
        .WebSocket -> "websocket"
        .Browser -> "browser"
        .Args -> "args"
        .Reflect -> "reflect"
        .AuthTokens -> "auth-tokens"
        .AuthSession -> "auth-session"
        .Sync -> "sync"
        .Services -> "services"
        .Mod -> "mod"
    }
}

