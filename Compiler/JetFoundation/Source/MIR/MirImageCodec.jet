            }
            Val(b'{') -> {
                end := matching_byte(raw.as_bytes(), cursor, b'{', b'}').ok_or_else(fn() { "unclosed struct variant `{name}`" })?
                if variant_suffix_supported(&raw[end + 1..]) {
                    fields := parse_fields(&raw[cursor + 1..end])?
                    for field in &fields { field.public = true }
                    VariantBody.Struct(^fields)
                } else { suffix := raw[end + 1..].trim(); VariantBody.Unsupported(suffix.to_string()) } // #4303
            }
            None -> VariantBody.Unit
            Val(b'=') if variant_suffix_supported(&raw[cursor..]) -> VariantBody.Unit
            _ -> { suffix := raw[cursor..].trim(); VariantBody.Unsupported(suffix.to_string()) } // #4303
        }
        variants.push(Variant { name: ^name, body: ^variant_body })
    }
    Ok(^variants)
}
