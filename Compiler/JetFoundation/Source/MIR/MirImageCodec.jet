// Rust: crates/jet-foundation/build/MirImageCodec.rs:68
pub fn generate(manifest_dir: &OSPath, out_dir: &OSPath) -> {
    source_root := manifest_dir.join("src")
    files: [OSPath] = []
    collect_rust_files(&source_root, &files)
    files.sort()
    schema := Schema.default()
    for path in files {
        println("cargo:rerun-if-changed={path.display()}")
        // GATE #4494: native filesystem boundary.
        source := fs.read_to_string(path).unwrap_or_else(fn(error) { panic("cannot read MIR image schema {path.display()}: {error}") })
        relative := path.strip_prefix(&source_root).expect("collected schema path is under source root")
        module := module_path(&relative)
        masked := mask_comments_and_literals(&source)
        imports := parse_imports(&masked, &module)
        parse_public_uses(&masked, &module, &schema)
        definitions := parse_definitions(&masked, &module, &imports).unwrap_or_else(fn(error) { panic("invalid native MIR image schema {path.display()}: {error}") })
        for definition in ^definitions { schema.definitions.insert(definition.key.clone(), ^definition) }
        if relative == OSPath.new("MIR.rs") {
            for name in parse_mir_id_macro_invocations(&masked) {
                key := "{module}::{name}"
                schema.definitions.insert(key.clone(), Definition {
                    key: ^key, path: "{module}::{name}", module: module.clone(), name: ^name,
                    imports: imports.clone(), body: Body.Tuple([Field { name: "0", ty: TypeExpr.Named("u64"), public: true }]), generic: false
                })
            }
        }
    }
    definition_keys := schema.definitions.keys().cloned().collect(); definition_keys.sort()
    for (public_module, target_module) in schema.wildcards.clone() {
        for key in definition_keys {
            definition := schema.definitions.get(key).unwrap()
            if definition.module == target_module { schema.aliases.insert("{public_module}::{definition.name}", definition.key.clone()) }
        }
    }
    assign_public_paths(&schema)
    reachable := reachable_schema(&schema, "crate::MIR::MirProgram").unwrap_or_else(fn(error) { panic("native MIR image schema is incomplete: {error}") })
    output := emit_codec(&schema, &reachable, &INTERNED_DEFINITIONS).unwrap_or_else(fn(error) { panic("cannot generate native MIR image codec: {error}") })
    // GATE #4494
    fs.write(out_dir.join("mir_program_image_codec.rs"), output).expect("write generated native MIR image codec")
}

// Rust: crates/jet-foundation/build/MirImageCodec.rs:130
fn collect_rust_files(root: &OSPath, output: &[OSPath]) -> {
    // GATE #4494
    for entry in fs.read_dir(root).expect("read Foundation source directory") {
        entry := entry.expect("read Foundation source entry")
        path := entry.path()
        if path.is_dir() { collect_rust_files(&path, output) }
        else { if path.extension().is_some_and(fn(extension) { extension == "rs" }) { output.push(^path) } }
    }
}
// Rust: crates/jet-foundation/build/MirImageCodec.rs:142
fn module_path(relative: &OSPath) -> String {
    components: [String] = []
    for component in relative.components() { if component.as_os_str().to_str() == Val(text) { components.push(text.to_string()) } }
    if components.last().is_some_and(fn(last) { last == "mod.rs" || last == "lib.rs" }) { _ :: components.pop() }
    else { if components.last_mut() == Val(last) { if last.strip_suffix(".rs") == Val(stem) { last = stem.to_string() } } }
    if components.is_empty() { "crate" } else { "crate::{components.join("::")}" }
}
// Rust: crates/jet-foundation/build/MirImageCodec.rs:162
fn mask_comments_and_literals(source: &String) -> String {
    bytes := source.as_bytes(); masked := bytes.to_vec(); index: USize = 0
    while index < bytes.len() {
        if bytes[index..].starts_with(b"//") {
            start := index
            while index < bytes.len() && bytes[index] != b'\n' { index += 1 }
            blank(&masked, start, index)
        } else if bytes[index..].starts_with(b"/*") {
            start := index; index += 2; depth: USize = 1
            while index < bytes.len() && depth != 0 {
                if bytes[index..].starts_with(b"/*") { depth += 1; index += 2 }
                else if bytes[index..].starts_with(b"*/") { depth -= 1; index += 2 }
                else { index += 1 }
            }
            blank(&masked, start, index)
        } else if raw_string_end(bytes, index) == Val(end) { blank(&masked, index, end); index = end }
        else if bytes[index] == b'"' { start := index; index = quoted_end(bytes, index, b'"'); blank(&masked, start, index) }
        else if bytes[index] == b'\'' && char_literal_end(bytes, index).is_some() {
            start := index; index = char_literal_end(bytes, index).expect("checked character literal"); blank(&masked, start, index)
        } else { index += 1 }
    }
    String.from_utf8(^masked).expect("masking preserves UTF-8")
}
