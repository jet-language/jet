        TypeExpr.Tuple(items) -> { for (index, item) in items.iter().enumerate() { out.push_str(&encode_expression(item, &"&({expression}).{index}", writer, schema, reachable, context)?) } }
        TypeExpr.StaticStr -> out.push_str("    {writer}.write_string({expression})?;\n\n")
