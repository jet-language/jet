fn emit_named_encode(out: &String, name: &String, expression: &String, writer: &String, schema: &Schema, reachable: &HashSet<String>, context: &Definition) -> Unit Err! {
    name == {
        "String" -> out.push_str("    {writer}.write_string(({expression}).as_str())?;\n\n")
        "PathBuf" | "std::path::PathBuf" -> out.push_str("    {writer}.write_string(({expression}).to_str().ok_or_else(|| \"native MIR path is not valid UTF-8\".to_string())?)?;\n\n")
