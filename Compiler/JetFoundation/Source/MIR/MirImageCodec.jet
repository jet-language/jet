                    if !statement.starts_with("=") { insert_use_tree(&statement, module, &imports) }
                    cursor = start + end + 1; continue
                }
            }
            _ -> {}
        }
        cursor += 1
    }
    ^imports
}
// Rust: crates/jet-foundation/build/MirImageCodec.rs:340
fn parse_public_uses(source: &String, module: &String, schema: &Schema) -> {
    bytes := source.as_bytes(); cursor: USize = 0; depth: USize = 0
    while cursor < bytes.len() {
        bytes[cursor] == {
            b'{' -> { depth += 1 }
            b'}' -> { depth = depth.saturating_sub(1) }
