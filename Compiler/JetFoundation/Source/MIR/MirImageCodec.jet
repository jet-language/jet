                    }
                    VariantBody.Struct(fields) -> {
                        body := String.new(); pattern_fields: [String] = []; decoded: [String] = []
                        for (index, field) in fields.iter().enumerate() {
                            binding := "__field_{index}"
                            pattern_fields.push("{field.name}: {binding}")
                            body.push_str(&encode_expression(&field.ty, &binding, "writer", schema, reachable, definition)?)
                            decoded.push("{field.name}: {decode_expression(&field.ty, "reader", schema, reachable, definition)?}")
