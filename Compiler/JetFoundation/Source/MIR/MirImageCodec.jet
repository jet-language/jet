fn emit_definition_codec(out: &String, schema: &Schema, reachable: &HashSet<String>, definition: &Definition, interned: &[String]) -> Unit Err! {
    interned := interned.iter().position(fn(key) { key == definition.key })
    (encoder, decoder) := if interned.is_some() { (function_name("encode_entry", &definition.key), function_name("decode_entry", &definition.key)) } else { (function_name("encode", &definition.key), function_name("decode", &definition.key)) }
    path := &definition.path
