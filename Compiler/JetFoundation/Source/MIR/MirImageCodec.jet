        out.push_str("fn {function_name("encode", &definition.key)}(value: &{path}, writer: &mut MirProgramImageWriter<'_>) -> Result<(), String> {{\n    let mut entry = writer.child();\n    {encoder}(value, &mut entry)?;\n    let entry = entry.finish();\n    writer.write_entry({kind}, entry);\n    Ok(())\n}}\nfn {function_name("decode", &definition.key)}(reader: &mut MirProgramImageReader<'_>) -> Result<{path}, String> {{\n    let index = reader.read_index()?;\n    reader.tables.{function_name("interned", &definition.key)}.get(index).cloned().ok_or_else(|| \"native MIR image references an unknown interned value\".to_string())\n}}\n\n")
    }
    definition.body == {
        Body.Struct(fields) -> {
            encode := String.new(); decode: [String] = []
            for field in fields {
                encode.push_str(&encode_expression(&field.ty, &"&value.{field.name}", "writer", schema, reachable, definition)?)
                decode.push("{field.name}: {decode_expression(&field.ty, "reader", schema, reachable, definition)?},")
            }
            out.push_str("fn {encoder}(value: &{path}, writer: &mut MirProgramImageWriter<'_>) -> Result<(), String> {{\n{encode}    Ok(())\n}}\nfn {decoder}(reader: &mut MirProgramImageReader<'_>) -> Result<{path}, String> {{\n    Ok({path} {{\n        {decode.join("\n")}\n    }})\n}}\n\n")
        }
        Body.Tuple(fields) -> {
            encode := String.new(); decode: [String] = []
            for (index, field) in fields.iter().enumerate() {
                encode.push_str(&encode_expression(&field.ty, &"&value.{index}", "writer", schema, reachable, definition)?)
                decode.push(decode_expression(&field.ty, "reader", schema, reachable, definition)?)
            }
            value := "{path}({decode.join(", ")})"
            out.push_str("fn {encoder}(value: &{path}, writer: &mut MirProgramImageWriter<'_>) -> Result<(), String> {{\n{encode}    Ok(())\n}}\nfn {decoder}(reader: &mut MirProgramImageReader<'_>) -> Result<{path}, String> {{\n    Ok({value})\n}}\n\n")
        }
        Body.Unit -> out.push_str("fn {encoder}(_: &{path}, _: &mut MirProgramImageWriter<'_>) -> Result<(), String> {{ Ok(()) }}\nfn {decoder}(_: &mut MirProgramImageReader<'_>) -> Result<{path}, String> {{ Ok({path}) }}\n\n")
        Body.Alias(ty) -> {
            encode := encode_expression(ty, "value", "writer", schema, reachable, definition)?
            decode := decode_expression(ty, "reader", schema, reachable, definition)?
            out.push_str("fn {encoder}(value: &{path}, writer: &mut MirProgramImageWriter<'_>) -> Result<(), String> {{\n{encode}    Ok(())\n}}\nfn {decoder}(reader: &mut MirProgramImageReader<'_>) -> Result<{path}, String> {{\n    Ok({decode})\n}}\n\n")
        }
        Body.Enum(variants) -> {
            encode_arms: [String] = []; decode_arms: [String] = []
            for (tag, variant) in variants.iter().enumerate() {
                tag := U32.try_from(tag).map_err(fn(_) { "enum `{definition.key}` exceeds native MIR tag range" })?
                (pattern, encode_fields, decoded) := variant.body == {
                    VariantBody.Unit -> ("{path}::{variant.name}", String.new(), [])
                    VariantBody.Tuple(fields) -> {
                        bindings := (0..fields.len()).map(fn(index) { "__field_{index}" }).collect()
                        body := String.new(); decoded: [String] = []
                        for (field, binding) in fields.iter().zip(&bindings) { body.push_str(&encode_expression(field, binding, "writer", schema, reachable, definition)?) }
                        for field in fields { decoded.push(decode_expression(field, "reader", schema, reachable, definition)?) }
