        "u8" -> out.push_str("    {writer}.write_u8(*({expression}));\n\n")
        "u16" -> out.push_str("    {writer}.write_u16(*({expression}));\n\n")
        "u32" -> out.push_str("    {writer}.write_u32(*({expression}));\n\n")
        "u64" -> out.push_str("    {writer}.write_u64(*({expression}));\n\n")
        "usize" -> out.push_str("    {writer}.write_u64(u64::try_from(*({expression})).map_err(|_| \"native MIR usize exceeds u64\".to_string())?);\n\n")
        "i8" -> out.push_str("    {writer}.write_u8(*({expression}) as u8);\n\n")
        "i16" | "i32" | "i64" -> out.push_str("    {writer}.write_signed(i64::from(*({expression})));\n\n")
        "isize" -> out.push_str("    {writer}.write_signed(*({expression}) as i64);\n\n")
        "f32" -> out.push_str("    {writer}.write_fixed_u32(({expression}).to_bits());\n\n")
        "f64" -> out.push_str("    {writer}.write_fixed_u64(({expression}).to_bits());\n\n")
        "char" -> out.push_str("    {writer}.write_u32(*({expression}) as u32);\n\n")
        _ -> {
            key := resolve_type_name(schema, context, name)?
            if !reachable.contains(&key) { return Err("native MIR type `{key}` is outside generated codec closure") }
            path := function_name("encode", &key)
            out.push_str("    {path}({expression}, &mut *{writer})?;\n\n")
