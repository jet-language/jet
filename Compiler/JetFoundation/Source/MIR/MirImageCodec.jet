// Rust: crates/jet-foundation/build/MirImageCodec.rs:1692
fn split_top_level(input: &String, delimiter: Char) -> [&String] {
    pieces: [&String] = []; depth: USize = 0; start: USize = 0
    for (index, character) in input.char_indices() {
        character == {
            '<' | '(' | '[' | '{' -> { depth += 1 }
            '>' if index > 0 && input.as_bytes()[index - 1] == b'-' -> {}
            '>' | ')' | ']' | '}' -> { depth = depth.saturating_sub(1) }
