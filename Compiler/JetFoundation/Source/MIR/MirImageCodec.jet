// Rust: crates/jet-foundation/build/MirImageCodec.rs:696
fn parse_type(input: &String) -> TypeExpr Err! {
    input := input.trim() // #4303
    if input == "&'static str" || input == "& str" { return Ok(TypeExpr.StaticStr) }
    if generic_inner(&input, "Option") == Val(inner) { return Ok(TypeExpr.Option(parse_type(&inner)?)) }
    if generic_inner(&input, "Vec") == Val(inner) { return Ok(TypeExpr.Sequence(parse_type(&inner)?)) }
    if generic_inner(&input, "Box") == Val(inner) { return Ok(TypeExpr.Boxed(parse_type(&inner)?)) }
    if generic_inner(&input, "Arc") == Val(inner) { return Ok(TypeExpr.Arc(parse_type(&inner)?)) }
