fn parse_fields(body: &String) -> [Field] Err! {
    fields: [Field] = []
    for raw in split_top_level(body, ',') {
        trimmed := raw.trim() // #4303
        raw := strip_attributes(&trimmed)
        if raw.is_empty() { continue }
        colon := top_level_byte(&raw, b':').ok_or_else(fn() { "struct field has no type: `{raw}`" })?
        declaration := raw[..colon].trim() // #4303
        name := strip_visibility(&declaration).split_whitespace().last().ok_or_else(fn() { "struct field has no name: `{raw}`" })?.to_string()
        field_type := raw[colon + 1..].trim() // #4303
        fields.push(Field { name: ^name, public: declaration.starts_with("pub ") || declaration.starts_with("pub("), ty: parse_type(&field_type)? })
    }
    Ok(^fields)
}
