fn char_literal_end(bytes: &[U8], start: USize) -> USize? {
    if bytes.get(start) != Val(b'\'') { return None }
    cursor := start + 1
    first := bytes.get(cursor) == { Val(first) -> first; None -> { return None } }
    if first == b'\\' {
        cursor += 1
        byte := bytes.get(cursor) == { Val(byte) -> byte; None -> { return None } }
        byte == {
            b'u' -> {
                cursor += 1
                if bytes.get(cursor) != Val(b'{') { return None }
                cursor += 1; digits: USize = 0
                while bytes.get(cursor) == Val(byte) {
                    if byte.is_ascii_hexdigit() { digits += 1 } else if byte != b'_' { break }
                    cursor += 1
                }
                if digits == 0 || digits > 6 || bytes.get(cursor) != Val(b'}') { return None }
                cursor += 1
            }
            b'x' -> {
                cursor += 1
                digits := bytes.get(cursor..cursor + 2) == { Val(digits) -> digits; None -> { return None } }
                if !digits.iter().all(fn(byte) { byte.is_ascii_hexdigit() }) { return None }
                cursor += 2
            }
            b'n' | b'r' | b't' | b'0' | b'\\' | b'\'' | b'"' -> { cursor += 1 }
            _ -> { return None }
        }
    } else {
        width := first == {
            b'\'' | b'\n' | b'\r' -> { return None }
            0..=0x7f -> 1
            0xc2..=0xdf -> 2
            0xe0..=0xef -> 3
            0xf0..=0xf4 -> 4
            _ -> { return None }
        }
        text := bytes.get(cursor..cursor + width) == { Val(text) -> text; None -> { return None } }
        if from_utf8(text).is_err() { return None }
        cursor += width
    }
    if bytes.get(cursor) == Val(b'\'') { Val(cursor + 1) } else { None }
}
