//RS fn emit_named_encode(
//RS     out: &mut String,
//RS     name: &str,
//RS     expression: &str,
//RS     writer: &str,
//RS     schema: &Schema,
//RS     reachable: &BTreeSet<String>,
//RS     context: &Definition,
