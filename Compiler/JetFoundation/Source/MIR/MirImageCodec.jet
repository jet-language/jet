fn raw_string_end(bytes: &[U8], start: USize) -> USize? {
    cursor := start
    if bytes.get(cursor) == Val(b'b') { cursor += 1 }
    if bytes.get(cursor) != Val(b'r') { return None }
    cursor += 1; hashes: USize = 0
    while bytes.get(cursor) == Val(b'#') { hashes += 1; cursor += 1 }
    if bytes.get(cursor) != Val(b'"') { return None }
    cursor += 1
    while cursor < bytes.len() {
        if bytes[cursor] == b'"' && bytes.get(cursor + 1..cursor + 1 + hashes).is_some_and(fn(suffix) { suffix.iter().all(fn(byte) { byte == b'#' }) }) { return Val(cursor + 1 + hashes) }
        cursor += 1
    }
    Val(bytes.len())
}
