//RS /// Definitions the image stores once in its value table: every occurrence in the
//RS /// payload is a varint index into that table. A definition belongs here when
//RS /// its values are large or repeat across the program. In the stage-zero
//RS /// compiler image, 7,431 distinct checked types stand behind 307 MB of type
//RS /// trees; spans, ownership facts and name references repeat per instruction;
//RS /// value, block and place ids are 64-bit stable hashes used several times each.
//RS const INTERNED_DEFINITIONS: &[&str] = &[
//RS     "crate::MIR::MirType",
//RS     "crate::Diagnostics::Span",
//RS     "crate::MIR::MirOwnership",
//RS     "crate::Names::NameReference",
//RS     "crate::MIR::MirValueId",
//RS     "crate::MIR::MirBlockId",
//RS     "crate::MIR::MirPlaceId",
//RS ];
