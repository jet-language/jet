//RS         if !reachable.contains(*key) {
//RS             return Err(format!("interned native MIR definition `{key}` is outside the codec closure"));
//RS         }
//RS     }
//RS     emit_runtime_codec_primitives(&mut out, schema, interned)?;
//RS     let definitions = reachable
//RS         .iter()
//RS         .map(|key| schema.definitions.get(key).expect("reachable definition").clone())
//RS         .collect::<Vec<_>>();
//RS     for definition in &definitions {
//RS         emit_definition_codec(&mut out, schema, reachable, definition, interned)?;
//RS     }
//RS     let root = schema
//RS         .definitions
//RS         .get("crate::MIR::MirProgram")
//RS         .ok_or_else(|| "missing root MirProgram".to_string())?;
//RS     let encode_root = function_name("encode", &root.key);
//RS     let decode_root = function_name("decode", &root.key);
//RS     // The writer validates before encoding; the reader only decodes. Its
//RS     // callers bind the bytes to an integrity seal (the compiler-image
//RS     // checksum) or validate again when they re-encode, so restore does not
//RS     // re-run whole-program validation.
//RS     writeln!(
//RS         out,
//RS         "pub fn mir_program_image_bytes(value: &MirProgram) -> Result<Vec<u8>, String> {{\n    value.validate().map_err(|error| format!(\"invalid MIR image source: {{error}}\"))?;\n    let mut interner = MirProgramImageInterner::default();\n    let mut writer = MirProgramImageWriter {{ bytes: Vec::new(), interner: &mut interner }};\n    {encode_root}(value, &mut writer)?;\n    let body = writer.finish();\n    mir_image_assemble(interner, body)\n}}\npub fn mir_program_from_image_bytes(bytes: &[u8]) -> Result<MirProgram, String> {{\n    let (tables, cursor) = mir_image_read_tables(bytes)?;\n    let mut reader = MirProgramImageReader {{ bytes, cursor, tables: &tables }};\n    let value = {decode_root}(&mut reader)?;\n    reader.finish()?;\n    Ok(value)\n}}\n"
//RS     )
//RS     .map_err(|error| error.to_string())?;
//RS     Ok(out)
//RS }
//RS 
//RS /// The image wire format: unsigned integers, enum tags, counts and lengths are
//RS /// canonical LEB128 varints; signed integers are zigzag varints; floats keep
//RS /// their fixed little-endian bits. The payload opens with the string table and
//RS /// the value table of `INTERNED_DEFINITIONS`, in first-encounter order; strings
//RS /// and interned values in the body are varint indices into those tables. Every
//RS /// collection is encoded in a deterministic order (hash containers by sorted
//RS /// key), so a restored program re-encodes to the identical bytes.
//RS fn emit_runtime_codec_primitives(out: &mut String, schema: &Schema, interned: &[&str]) -> Result<(), String> {
//RS     let mut table_fields = String::new();
//RS     for key in interned {
//RS         let definition = schema
//RS             .definitions
//RS             .get(*key)
//RS             .ok_or_else(|| format!("missing interned native MIR definition `{key}`"))?;
//RS         writeln!(table_fields, "    {}: Vec<{}>,", function_name("interned", key), definition.path)
//RS             .map_err(|error| error.to_string())?;
//RS     }
//RS     let mut decode_entries = String::new();
//RS     for (kind, key) in interned.iter().enumerate() {
//RS         writeln!(
//RS             decode_entries,
//RS             "            {kind} => {{ let value = {}(&mut reader)?; cursor = reader.cursor; tables.{}.push(value); }}",
//RS             function_name("decode_entry", key),
//RS             function_name("interned", key),
//RS         )
//RS         .map_err(|error| error.to_string())?;
//RS     }
//RS     writeln!(
//RS         out,
//RS         "#[derive(Default)]\nstruct MirProgramImageTables {{\n    strings: Vec<String>,\n{table_fields}}}\n#[derive(Default)]\nstruct MirProgramImageInterner {{\n    strings: std::collections::HashMap<String, u64>,\n    string_table: Vec<u8>,\n    entries: std::collections::HashMap<(u32, Vec<u8>), u64>,\n    kind_counts: [u64; {}],\n    entry_table: Vec<u8>,\n    entry_count: u64,\n}}",
//RS         interned.len()
//RS     )
//RS     .map_err(|error| error.to_string())?;
//RS     // Table entries reference only earlier entries (nested values are interned
//RS     // before the value holding them), so one forward pass restores the tables.
