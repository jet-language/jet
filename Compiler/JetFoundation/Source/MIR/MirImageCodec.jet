fn parse_definitions(source: &String, module: &String, imports: &[String:String]) -> [Definition] Err! {
    definitions: [Definition] = []; cursor: USize = 0
    while find_next_definition(source, cursor) == Val((kind, start)) {
        prefix := kind == { "struct" -> "pub struct"; "enum" -> "pub enum"; "type" -> "pub type"; _ -> { panic("unknown native MIR definition kind") } }
        position := start + prefix.len(); skip_space(source, &position)
        if source.as_bytes().get(position) == Val(b'$') { cursor = skip_macro_declaration(source, position); continue }
        name := read_identifier(source, &position)?; skip_space(source, &position)
        generic := source.as_bytes().get(position) == Val(b'<')
        if generic {
            end := matching_byte(source.as_bytes(), position, b'<', b'>').ok_or_else(fn() { "unclosed generic parameter list for `{name}`" })?
            position = end + 1; skip_space(source, &position)
        }
        body := if kind == "type" {
            equals := top_level_byte(&source[position..], b'=').ok_or_else(fn() { "type alias `{name}` has no right-hand side" })?
            rhs_start := position + equals + 1
            end := top_level_byte(&source[rhs_start..], b';').ok_or_else(fn() { "type alias `{name}` has no terminating semicolon" })?
            rhs := source[rhs_start..rhs_start + end].trim() // #4303
            position = rhs_start + end + 1
            Body.Alias(parse_type(&rhs)?)
        } else {
            source.as_bytes().get(position) == {
                Val(b'{') -> {
                    end := matching_byte(source.as_bytes(), position, b'{', b'}').ok_or_else(fn() { "unclosed declaration body for `{name}`" })?
                    text := source[position + 1..end] // #4303
                    body := if kind == "struct" { Body.Struct(parse_fields(&text)?) } else { Body.Enum(parse_variants(&text)?) }
                    position = end + 1; ^body
                }
                Val(b'(') if kind == "struct" -> {
                    end := matching_byte(source.as_bytes(), position, b'(', b')').ok_or_else(fn() { "unclosed tuple struct `{name}`" })?
                    fields: [Field] = []
                    for field in split_top_level(&source[position + 1..end], ',') {
                        field := field.trim() // #4303
                        if field.is_empty() { continue }
                        fields.push(Field { name: fields.len().to_string(), public: field.starts_with("pub ") || field.starts_with("pub("), ty: parse_type(&strip_visibility(&field))? })
                    }
                    position = end + 1; Body.Tuple(^fields)
                }
                Val(b';') if kind == "struct" -> { position += 1; Body.Unit }
                _ -> { return Err("unsupported body for `{name}`") }
            }
        }
        key := "{module}::{name}"
        definitions.push(Definition { key: key.clone(), path: ^key, module: module.to_string(), name: ^name, imports: imports.clone(), body: ^body, generic: generic })
        cursor = position
    }
    Ok(^definitions)
}
// Rust: crates/jet-foundation/build/MirImageCodec.rs:559
fn skip_macro_declaration(source: &String, start: USize) -> USize {
    bytes := source.as_bytes(); cursor := start; depth: USize = 0
    while cursor < bytes.len() {
        bytes[cursor] == {
            b'(' | b'[' | b'{' | b'<' -> { depth += 1 }
            b'>' if cursor > 0 && bytes[cursor - 1] == b'-' -> {}
            b')' | b']' | b'}' | b'>' -> { depth = depth.saturating_sub(1) }
            b';' if depth == 0 -> { return cursor + 1 }
            _ -> {}
        }
        cursor += 1
    }
    bytes.len()
}
// Rust: crates/jet-foundation/build/MirImageCodec.rs:575
fn parse_mir_id_macro_invocations(source: &String) -> [String] {
    output: [String] = []; cursor: USize = 0
    while source[cursor..].find("mir_id!") == Val(index) {
        start := cursor + index + "mir_id!".len()
        open := source[start..].find('(') == { Val(offset) -> start + offset; None -> { break } }
        close := matching_byte(source.as_bytes(), open, b'(', b')') == { Val(close) -> close; None -> { break } }
        name := source[open + 1..close].trim() // #4303
        if is_identifier(&name) { output.push(name.to_string()) }
        cursor = close + 1
    }
    ^output
}
