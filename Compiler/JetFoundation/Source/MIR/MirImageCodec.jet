}
// Rust: crates/jet-foundation/build/MirImageCodec.rs:363
fn insert_use_tree(statement: &String, module: &String, imports: &[String:String]) -> {
    if top_level_byte(statement, b'{') == Val(open) {
        prefix := statement[..open].trim().trim_end_matches(":") // #4303
        close := matching_byte(statement.as_bytes(), open, b'{', b'}') == { Val(close) -> close; None -> { return } }
        for item in split_top_level(&statement[open + 1..close], ',') {
            item := item.trim() // #4303
            if item.is_empty() || item == "*" { continue }
            (name, alias) := split_alias(&item)
            path := normalize_module_path(module, &"{prefix}::{name}")
            local_name := alias.unwrap_or(name.rsplit("::").next().unwrap_or(&name))
            imports.insert(local_name.to_string(), ^path)
        }
    } else {
        statement := statement.trim() // #4303
        (path, alias) := split_alias(&statement)
        path := normalize_module_path(module, &path)
        name := alias.or_else(fn() { path.rsplit("::").next() }).unwrap_or(&path)
        imports.insert(name.to_string(), ^path)
    }
}
// Rust: crates/jet-foundation/build/MirImageCodec.rs:389
fn insert_public_use_tree(statement: &String, module: &String, schema: &Schema) -> {
    if top_level_byte(statement, b'{') == Val(open) {
        prefix := statement[..open].trim().trim_end_matches(":") // #4303
        close := matching_byte(statement.as_bytes(), open, b'{', b'}') == { Val(close) -> close; None -> { return } }
        for item in split_top_level(&statement[open + 1..close], ',') {
            item := item.trim() // #4303
            if item.is_empty() { continue }
            if item == "*" { schema.wildcards.push((module.to_string(), normalize_module_path(module, &prefix))); continue }
            (name, alias) := split_alias(&item)
            target := normalize_module_path(module, &"{prefix}::{name}")
            export := "{module}::{alias.unwrap_or(name.rsplit("::").next().unwrap_or(&name))}"
            schema.aliases.insert(^export, ^target)
        }
    } else {
        statement := statement.trim() // #4303
        if statement.ends_with("::*") {
            prefix := statement.trim_end_matches("::*") // #4303
            schema.wildcards.push((module.to_string(), normalize_module_path(module, &prefix)))
        } else {
            (name, alias) := split_alias(&statement)
            target := normalize_module_path(module, &name)
            export := "{module}::{alias.unwrap_or(name.rsplit("::").next().unwrap_or(&name))}"
            schema.aliases.insert(^export, ^target)
        }
    }
}
// Rust: crates/jet-foundation/build/MirImageCodec.rs:427
fn split_alias(item: &String) -> (&String, &String?) {
    parts := item.splitn(2, " as ")
    name := parts.next().unwrap_or(item).trim() // #4303
    alias := parts.next().map(fn(value) { value.trim() }) // #4303
    (name, alias)
}
// Rust: crates/jet-foundation/build/MirImageCodec.rs:434
fn normalize_module_path(module: &String, path: &String) -> String {
    path := path.trim() // #4303
    if path.starts_with("crate::") || path.starts_with("std::") || path.starts_with("core::") || path == "crate" { return path.to_string() }
    components := module.split("::").map(fn(value) { value.to_string() }).collect()
    if path.starts_with("self::") { components.extend(path[6..].split("::").map(fn(value) { value.to_string() })) }
    else if path.starts_with("super::") {
        while components.len() > 1 && components.last().is_some_and(fn(part) { part == "super" }) { _ :: components.pop() }
        _ :: components.pop()
        components.extend(path[7..].split("::").map(fn(value) { value.to_string() }))
    } else { components.extend(path.split("::").map(fn(value) { value.to_string() })) }
    if components.first().is_some_and(fn(part) { part != "crate" }) { components.insert(0, "crate") }
    components.join("::")
}
