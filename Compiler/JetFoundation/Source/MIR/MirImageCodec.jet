        TypeExpr.Sequence(inner) -> {
            body := encode_expression(inner, "__item", writer, schema, reachable, context)?
            out.push_str("    {writer}.write_u64(u64::try_from(({expression}).len()).map_err(|_| \"native MIR collection exceeds u64\".to_string())?);\n    for __item in ({expression}).iter() {{\n{body}    }}\n\n")
        }
        TypeExpr.Set(inner, hash) -> {
            body := encode_expression(inner, "__item", "(&mut __item_writer)", schema, reachable, context)?
            items := if hash { "{{ let mut __sorted = ({expression}).iter().collect::<Vec<_>>(); __sorted.sort(); __sorted }}" } else { "({expression}).iter()" }
            out.push_str("    {{ let mut __items = Vec::with_capacity(({expression}).len()); for __item in {items} {{ let mut __item_writer = {writer}.child();\n{body}        __items.push(__item_writer.finish()); }} __items.sort(); if __items.windows(2).any(|pair| pair[0] == pair[1]) {{ return Err(\"duplicate native MIR set element encoding\".to_string()); }} {writer}.write_count(__items.len())?; for __item in __items {{ {writer}.write_bytes(&__item)?; }} }}\n\n")
        }
        TypeExpr.Map(key, value, hash) -> {
            key_body := encode_expression(key, "__key", "(&mut __key_writer)", schema, reachable, context)?
            value_body := encode_expression(value, "__value", "(&mut __value_writer)", schema, reachable, context)?
            entries := if hash { "{{ let mut __sorted = ({expression}).iter().collect::<Vec<_>>(); __sorted.sort_by(|left, right| left.0.cmp(right.0)); __sorted }}" } else { "({expression}).iter()" }
            out.push_str("    {{ let mut __entries = Vec::with_capacity(({expression}).len()); for (__key, __value) in {entries} {{ let __key_bytes = {{ let mut __key_writer = {writer}.child();\n{key_body}        __key_writer.finish() }}; let __value_bytes = {{ let mut __value_writer = {writer}.child();\n{value_body}        __value_writer.finish() }}; __entries.push((__key_bytes, __value_bytes)); }} __entries.sort_by(|left, right| left.0.cmp(&right.0)); if __entries.windows(2).any(|pair| pair[0].0 == pair[1].0) {{ return Err(\"duplicate native MIR map key encoding\".to_string()); }} {writer}.write_count(__entries.len())?; for (__key, __value) in __entries {{ {writer}.write_bytes(&__key)?; {writer}.write_bytes(&__value)?; }} }}\n\n")
