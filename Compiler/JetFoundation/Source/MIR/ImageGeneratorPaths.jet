// RuntimeMirCodec.rs1611-1785 exceptional native declaration paths.
fn mir_image_gen_native_path(source: String) -> String Never! {
    if source == {
        "Span" -> "crate::Diagnostics::Span"
        "ParamZone" -> "crate::MIR::MirParamZone"
        "MIRShapeFieldNames" -> "crate::Shape::ShapeFieldNames"
        "MIROperatorMarker" -> "crate::AST::OperatorMarker"
        "CoreMarkerApplication" -> "crate::Syntax::CoreMarkerApplication"
        "Effect" -> "crate::Effects::Effect"
        "SinkClass" -> "crate::Syntax::SinkClass"
        "LayoutFacts" -> "crate::Layout::LayoutFacts"
        "ByteLayout" -> "crate::Layout::ByteLayout"
        "FieldLayoutFacts" -> "crate::Layout::FieldLayoutFacts"
        "MIRFFIEvidenceBasis" -> "crate::AST::FfiEvidenceBasis"
        "MIRFFIBoundaryFacts" -> "crate::AST::FfiBoundaryFacts"
        "MIRFFIBoundaryObligation" -> "crate::AST::FfiBoundaryObligation"
        "MIRTypedHeadKind" -> "crate::Syntax::TypedHeadKind"
        "MIRWebBucket" -> "crate::WebPartition::WebBucket"
        "MIRFFICloseSource" -> "crate::AST::FfiCloseSource"
        "MIRFFIThreadSafety" -> "crate::AST::FfiThreadSafety"
        "MIRHostImportFact" -> "crate::Authority::HostImportFact"
        "MIRNameFacts" -> "crate::MIR::MirNameFacts"
        "CoreCallFallibility" -> "crate::Syntax::CoreCallFallibility"
        "CoreCallPureRoute" -> "crate::Syntax::CoreCallPureRoute"
        "CoreCallInterpreterRoute" -> "crate::Syntax::CoreCallInterpreterRoute"
        "CoreCallSymbol" -> "crate::Syntax::CoreCallSymbol"
        "MIROSTarget" -> "crate::OSTarget::OSTarget"
        "MIRRuntimeLayer" -> "crate::RingLayer::RuntimeLayer"
        "MIRByteSize" -> "crate::TargetMachine::ByteSize"
        "MIRMemoryAccess" -> "crate::TargetMachine::MemoryAccess"
        "MIRMemoryRegion" -> "crate::TargetMachine::MemoryRegion"
        "MIRLinkerInput" -> "crate::TargetMachine::LinkerInput"
        "MIRProviderLimits" -> "crate::TargetMachine::ProviderLimits"
        "MIRProviderContract" -> "crate::TargetMachine::ProviderContract"
        "MIRAllocatorPolicy" -> "crate::TargetMachine::AllocatorPolicy"
        "MIRPanicPolicy" -> "crate::TargetMachine::PanicPolicy"
        "MIRClockPolicy" -> "crate::TargetMachine::ClockPolicy"
        "MIREntropyPolicy" -> "crate::TargetMachine::EntropyPolicy"
        "MIRSchedulerPolicy" -> "crate::TargetMachine::SchedulerPolicy"
        "MIRByteSinkPolicy" -> "crate::TargetMachine::ByteSinkPolicy"
        "MIRStartupPolicy" -> "crate::TargetMachine::StartupPolicy"
        "MIRAuditPolicy" -> "crate::TargetMachine::AuditPolicy"
        "MIRRegisterWidth" -> "crate::TargetMachine::RegisterWidth"
        "MIRTargetRegisterAccessMode" -> "crate::TargetMachine::TargetRegisterAccessMode"
        "MIRTargetRegisterFact" -> "crate::TargetMachine::TargetRegisterFact"
        "MIRTargetRegisterBlockFact" -> "crate::TargetMachine::TargetRegisterBlockFact"
        "MIRTargetRegisterOperation" -> "crate::TargetMachine::TargetRegisterOperation"
        "MIRTargetRegisterAccessFact" -> "crate::TargetMachine::TargetRegisterAccessFact"
        "MIRTargetInterruptFact" -> "crate::TargetMachine::TargetInterruptFact"
        "MIRTargetInterruptHandlerFact" -> "crate::TargetMachine::TargetInterruptHandlerFact"
        "MIRTargetHardwareFacts" -> "crate::TargetMachine::TargetHardwareFacts"
        "MIRTargetHardwareUse" -> "crate::TargetMachine::TargetHardwareUse"
        "MIRTargetHardwareUnresolvedReference" -> "crate::TargetMachine::TargetHardwareUnresolvedReference"
        "MIRTargetProgrammerAdapter" -> "crate::TargetMachine::TargetProgrammerAdapter"
        "MIRTargetProgrammerFacts" -> "crate::TargetMachine::TargetProgrammerFacts"
        "MIRTargetMachine" -> "crate::TargetMachine::TargetMachine"
        "MIRMemoryKind" -> "crate::TargetMachine::MemoryKind"
        "MIRMMIOPolicy" -> "crate::TargetMachine::MmioPolicy"
        "MIRSVDProvenance" -> "crate::TargetMachine::SvdProvenance"
        "MIRTargetDossier" -> "crate::Facts::TargetDossier"
        "MIRComponentSignatureDescriptor" -> "crate::MIR::ComponentSignatureDescriptor"
        "MIRComponentTypeDescriptor" -> "crate::MIR::ComponentTypeDescriptor"
        "MIRProviderABI" -> "crate::TargetMachine::ProviderAbi"
        "MIRTargetDMAOwnership" -> "crate::TargetMachine::TargetDmaOwnership"
        "MIRTargetDMAOperation" -> "crate::TargetMachine::TargetDmaOperation"
        "MIRTargetDMAOwner" -> "crate::TargetMachine::TargetDmaOwner"
        "MIRTargetApplicability" -> "crate::MIR::MirTargetApplicability"
        "MIRAppPendingBoundaryID" -> "crate::App::AppPendingBoundaryId"
        "MIRDataPlanSourceKind" -> "crate::AST::DataPlanSourceKind"
        "MIRDataPlanStreamMode" -> "crate::AST::DataPlanStreamMode"
        "MIRSchemaMigrationPlan" -> "crate::SchemaMigration::SchemaMigrationPlan"
        "MIRSchemaMigrationStep" -> "crate::SchemaMigration::SchemaMigrationStep"
        "MIRSchemaMigrationOp" -> "crate::SchemaMigration::SchemaMigrationOp"
        "MIRDerivationRef" -> "crate::Facts::DerivationRef"
        "MIRDerivationMethod" -> "crate::Facts::DerivationMethod"
        "MIRDerivationDisposition" -> "crate::Facts::DerivationDisposition"
        "MIRWebPartitionMarker" -> "crate::WebPartition::WebPartitionMarker"
        "MIRResourceAccessMode" -> "crate::ResourceSchedule::JetResourceAccessMode"
        "MIRResourceIdentity" -> "crate::ResourceSchedule::JetResourceIdentity"
        "MIRResourceRegion" -> "crate::ResourceSchedule::JetResourceRegion"
        "MIRResourceLayout" -> "crate::ResourceSchedule::JetResourceLayout"
        "MIRResourceAccess" -> "crate::ResourceSchedule::JetResourceAccess"
        "MIRFrameCompletion" -> "crate::ResourceSchedule::JetFrameCompletion"
        "MIRFrameOperation" -> "crate::ResourceSchedule::JetFrameOperation"
        "MIRFrameDependency" -> "crate::ResourceSchedule::JetFrameDependency"
        "MIRFrameTransfer" -> "crate::ResourceSchedule::JetFrameTransfer"
        "MIRFrameReuse" -> "crate::ResourceSchedule::JetFrameReuse"
        "MIRFrameRetention" -> "crate::ResourceSchedule::JetFrameRetention"
        "MIRFrameSchedule" -> "crate::ResourceSchedule::JetFrameSchedule"
        "MIRStructureFact" -> "crate::Names::StructureFact"
        "MIRStructureFactKind" -> "crate::Names::StructureFactKind"
        "MIRFixedReductionTree" -> "crate::MIROptimization::Acceleration::FixedReductionTree"
        "MIRFixedReductionOrder" -> "crate::MIROptimization::Acceleration::FixedReductionOrder"
        "MIRAccelerationTransform" -> "crate::MIROptimization::Acceleration::AccelerationTransform"
        "MIRAccelerationProof" -> "crate::MIROptimization::Acceleration::AccelerationProof"
        "MIRAccelerationWorkloadFacts" -> "crate::MIROptimization::Acceleration::AccelerationWorkloadFacts"
        "MIRLayoutSupportFacts" -> "crate::Layout::LayoutSupportFacts"
        "MIRLayoutCapabilityFacts" -> "crate::Layout::LayoutCapabilityFacts"
        "MIRLayoutAlignmentFact" -> "crate::Layout::LayoutAlignmentFact"
        "MIRTargetDMAChannelFact" -> "crate::TargetMachine::TargetDmaChannelFact"
        "MIRTargetDMAOperationFact" -> "crate::TargetMachine::TargetDmaOperationFact"
        "MIRDataPlanOperation" -> "crate::AST::DataPlanOperationKind"
        "MIRDataPlanPhysicalOperator" -> "crate::AST::DataPlanPhysicalOperatorKind"
        else -> {
            if source.starts_with("MIRName") && source != "MIRNamedSpan" -> return "crate::Names::{source.slice(3, source.len())}"
            if source.starts_with("MIRApp") -> return "crate::App::{source.slice(3, source.len())}"
            suffix :: if source.starts_with("MIR") -> source.slice(3, source.len()) else -> source
            "crate::MIR::Mir{suffix}"
        }
    }
}
fn mir_image_gen_same_name(left: String, right: String) -> Bool Never! {
    a :: left.bytes()
    b :: right.bytes()
    if a.len() != b.len() -> return false
    loop index in 0..<a.len() {
        x :: if a[index] >= U8{65} && a[index] <= U8{90} -> a[index] + U8{32} else -> a[index]
        y :: if b[index] >= U8{65} && b[index] <= U8{90} -> b[index] + U8{32} else -> b[index]
        if x != y -> return false
    }
    true
}
pub fn mir_image_generator_mapping(schema: MIRImageSchema, declarations: [MIRImageSourceDefinition]) -> MIRImageGeneratorMapping MIRImageError! {
    mir_image_generator_unique_source_definitions(declarations)
    source := [String:MIRImageSourceDefinition]{}
    native := [String:String]{}
    loop declaration in declarations {
        source[declaration.name] = declaration
        path :: mir_image_gen_native_path(declaration.name)
        module_parts :: path.split("::").to_list()
        expected :: module_parts[module_parts.len() - 1]
        module_name :: module_parts[0..<module_parts.len() - 1].to_list().join("::")
        found := String?{None}
        loop (key, definition) in schema.definitions {
            public_path :: definition.path
            actual_parts :: public_path.split("::").to_list()
            actual_module :: actual_parts[0..<actual_parts.len() - 1].to_list().join("::")
            if actual_module == module_name && mir_image_gen_same_name(definition.name, expected) {
                if found == .Val(_) -> return Err(MIRImageError{message: "ambiguous native MIR carrier for `{declaration.name}`"})
                found = Val(key)
            }
        }
        if found == .Val(key) -> native[key] = declaration.name
    }
    Ok(MIRImageGeneratorMapping{source: source, native_to_source: native})
}
