fn mir_digest_sort_type_instances(rows: &[MIRType]) Never! {
    loop index in 1..<rows.len() {
        current := rows[index]
        current_id :: current.identity.map(row -> row.value) ?? -1
        cursor := index - 1
        prior_id := rows[cursor].identity.map(row -> row.value) ?? -1
        loop cursor >= 0 && prior_id > current_id {
            rows[cursor + 1] = rows[cursor]
            cursor -= 1
            if cursor >= 0 -> prior_id = rows[cursor].identity.map(row -> row.value) ?? -1
        }
        rows[cursor + 1] = current
    }
}

fn mir_digest_sort_unreachable(rows: &[MIRUnreachable]) Never! {
    loop index in 1..<rows.len() {
        current := rows[index]
        cursor := index - 1
        loop cursor >= 0 && (rows[cursor].span.start > current.span.start || (rows[cursor].span.start == current.span.start && (rows[cursor].span.end > current.span.end || (rows[cursor].span.end == current.span.end && rows[cursor].construct > current.construct)))) {
            rows[cursor + 1] = rows[cursor]
            cursor -= 1
        }
        rows[cursor + 1] = current
    }
}

fn mir_digest_sort_strings(values: &[String]) Never! {
    loop index in 1..<values.len() {
        current := values[index]
        cursor := index - 1
        loop cursor >= 0 && values[cursor] > current {
            values[cursor + 1] = values[cursor]
            cursor -= 1
        }
        values[cursor + 1] = current
    }
}

fn mir_digest_sort_runtime_parts(values: &[MIRRuntimePartID]) Never! {
    loop index in 1..<values.len() {
        current := values[index]
        cursor := index - 1
        loop cursor >= 0 && mir_digest_runtime_order(values[cursor]) > mir_digest_runtime_order(current) {
            values[cursor + 1] = values[cursor]
            cursor -= 1
        }
        values[cursor + 1] = current
    }
}

fn mir_digest_unreachable(writer: &MIRCanonicalWriter, value: MIRUnreachable) Never! {
    mir_digest_string(&writer, value.construct)
    mir_digest_span(&writer, value.span)
    mir_digest_u64(&writer, mir_digest_erasure_reason(value.reason))
}

fn mir_program_bytes_internal(program: MIRProgram) -> [U8] {
    writer := mir_digest_writer()
    mir_program_write(&writer, program)
    writer.bytes
}

fn mir_program_write(writer: &MIRCanonicalWriter, program: MIRProgram) {
    mir_digest_tag(&writer, "mir")
    mir_digest_u16(&writer, program.schema_version)
    mir_digest_string(&writer, program.package_identity)
    facts := program.facts
    mir_digest_string(&writer, facts.project_root)
    mir_digest_string(&writer, facts.edition)
    runtime_parts := facts.runtime_parts
    mir_digest_sort_runtime_parts(&runtime_parts)
    mir_digest_runtime_parts(&writer, runtime_parts)
    mir_digest_string(&writer, facts.active_os)
    mir_digest_string(&writer, facts.inferred_layer)
    mir_digest_string(&writer, facts.allocator)
    target_triple :: facts.target_dossier.machine.map(row -> row.triple) ?? ""
    dossier_bytes :: mir_digest_target_dossier_bytes(facts.target_dossier, target_triple)
    mir_digest_bytes(&writer, dossier_bytes)
    mir_digest_app_graph(&writer, facts.web_app)
    mir_digest_hardware_setup(&writer, facts.hardware_setups)
    mir_digest_string(&writer, facts.hardware_profile_id)
    if facts.hardware_profile == {
        .Val(hardware_profile) -> {
        mir_digest_bool(&writer, true)
        mir_digest_target_hardware_facts(&writer, hardware_profile)
    }
    else -> {
        mir_digest_bool(&writer, false)
    }
}
    mir_digest_target_hardware_use(&writer, facts.hardware_use)
    capabilities := facts.hardware_capabilities
    mir_digest_sort_strings(&capabilities)
    mir_digest_len(&writer, capabilities.len())
    loop capability in capabilities -> mir_digest_string(&writer, capability)

    modules := program.modules
    mir_digest_sort_modules(&modules)
    mir_digest_len(&writer, modules.len())
    loop row in modules -> mir_digest_module(&writer, row)
    imports := program.imports
    mir_digest_sort_imports(&imports)
    mir_digest_len(&writer, imports.len())
    loop row in imports -> mir_digest_import(&writer, row)
    types := program.types
    mir_digest_sort_type_defs(&types)
    mir_digest_len(&writer, types.len())
    loop row in types -> mir_digest_type_def(&writer, row)
    core_owners := program.core_owners
    mir_digest_sort_core_owners(&core_owners)
    mir_digest_len(&writer, core_owners.len())
    loop row in core_owners -> mir_digest_core_owner(&writer, row)
    traits := program.traits
    mir_digest_sort_traits(&traits)
    mir_digest_len(&writer, traits.len())
    loop row in traits -> mir_digest_trait_def(&writer, row)
    impls := program.impls
    mir_digest_sort_impls(&impls)
    mir_digest_len(&writer, impls.len())
    loop row in impls -> mir_digest_impl_def(&writer, row)
    constants := program.constants
    mir_digest_sort_constants(&constants)
    mir_digest_len(&writer, constants.len())
    loop row in constants -> mir_digest_constant_def(&writer, row)
    fields := program.fields
    mir_digest_sort_fields(&fields)
    mir_digest_len(&writer, fields.len())
    loop row in fields {
        mir_digest_u64(&writer, row.id.value)
        mir_digest_u64(&writer, row.owner.value)
        mir_digest_field(&writer, row.field)
    }
    source_files := program.source_files
    mir_digest_sort_source_files(&source_files)
    mir_digest_len(&writer, source_files.len())
    loop row in source_files {
        mir_digest_u64(&writer, row.id.value)
        mir_digest_string(&writer, row.path)
        mir_digest_string(&writer, row.source)
    }
    functions := program.functions
    mir_digest_sort_functions(&functions)
    mir_digest_len(&writer, functions.len())
    loop row in functions -> mir_digest_function(&writer, row)
    foreign := program.foreign
    mir_digest_sort_foreign(&foreign)
    mir_digest_len(&writer, foreign.len())
    loop row in foreign -> mir_digest_foreign(&writer, row)
    links := program.links
    mir_digest_sort_links(&links)
    mir_digest_len(&writer, links.len())
    loop row in links -> mir_digest_link_unit(&writer, row)
    callbacks := program.callbacks
    mir_digest_sort_callbacks(&callbacks)
    mir_digest_len(&writer, callbacks.len())
    loop row in callbacks -> mir_digest_callback(&writer, row)
    handles := program.handles
    mir_digest_sort_handles(&handles)
    mir_digest_len(&writer, handles.len())
    loop row in handles -> mir_digest_handle(&writer, row)
    jobs := program.jobs
    mir_digest_sort_jobs(&jobs)
    mir_digest_len(&writer, jobs.len())
    loop row in jobs -> mir_digest_job(&writer, row)
    tests := program.tests
    mir_digest_sort_tests(&tests)
    mir_digest_len(&writer, tests.len())
    loop row in tests -> mir_digest_test(&writer, row)
    harnesses := program.harnesses
    mir_digest_sort_harnesses(&harnesses)
    mir_digest_len(&writer, harnesses.len())
    loop row in harnesses -> mir_digest_harness(&writer, row)
    artifacts := program.artifacts
    mir_digest_sort_artifacts(&artifacts)
    mir_digest_len(&writer, artifacts.len())
    loop row in artifacts -> mir_digest_artifact(&writer, row)
    core_calls := program.core_calls
    mir_digest_sort_core_calls(&core_calls)
    mir_digest_len(&writer, core_calls.len())
    loop row in core_calls -> mir_digest_core_call(&writer, row)
    prelude_calls := program.prelude_calls
    mir_digest_sort_prelude_calls(&prelude_calls)
    mir_digest_len(&writer, prelude_calls.len())
    loop row in prelude_calls -> mir_digest_prelude_call(&writer, row)
    type_instances := program.type_instances
    mir_digest_sort_type_instances(&type_instances)
    mir_digest_len(&writer, type_instances.len())
    loop row in type_instances -> mir_digest_type(&writer, row)
    unreachable := program.unreachable
    mir_digest_sort_unreachable(&unreachable)
    mir_digest_len(&writer, unreachable.len())
    loop row in unreachable -> mir_digest_unreachable(&writer, row)
}

fn mir_digest_hex_digit(value: Int) -> String Never! {
    if value < 10 -> String.from_bytes([U8{48 + value}]) ?? "0"
    else -> String.from_bytes([U8{87 + value}]) ?? "0"
}

fn mir_digest_hex(bytes: [U8]) -> String Never! {
    output := ""
    loop byte in bytes {
        value :: Int.from_u8(byte)
        output = "{output}{mir_digest_hex_digit((value >> 4) & 15)}{mir_digest_hex_digit(value & 15)}"
    }
    output
}

pub fn mir_program_bytes(program: MIRProgram) -> [U8] {
    mir_program_bytes_internal(program)
}

pub fn mir_program_digest(program: MIRProgram) -> String {
    writer := mir_digest_hash_writer()
    mir_program_write(&writer, program)
    output := [U8]{}
    loop lane in writer.lanes {
        hash :: Int.from_u64(lane)
        loop index in 0..<8 {
            &output.push(U8{(hash >> (8 * index)) & 255})
        }
    }
    mir_digest_hex(output)
}

fn mir_digest_sort_ints(values: &[Int]) Never! {
    loop index in 1..<values.len() {
        current := values[index]
        cursor := index - 1
        loop cursor >= 0 && values[cursor] > current {
            values[cursor + 1] = values[cursor]
            cursor -= 1
        }
        values[cursor + 1] = current
    }
}

