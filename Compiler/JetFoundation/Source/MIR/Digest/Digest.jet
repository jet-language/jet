fn mir_digest_runtime_parts(writer: &MIRCanonicalWriter, values: [MIRRuntimePartID]) Never! {
    mir_digest_len(&writer, values.len())
    loop value in values -> mir_digest_u64(&writer, mir_digest_runtime_part(value))
}

fn mir_digest_register_width(value: MIRRegisterWidth) -> String Never! {
    if value == {
        .U8 -> "u8"
        .U16 -> "u16"
        .U32 -> "u32"
        .U64 -> "u64"
    }
}

fn mir_digest_dma_ownership(value: MIRTargetDMAOwnership) -> String Never! {
    if value == {
        .Borrowed -> "borrowed"
        .Transfer -> "transfer"
    }
}

fn mir_digest_joined_strings_before(left: [String], right: [String]) -> Bool Never! {
    common_len :: if left.len() < right.len() -> left.len() else -> right.len()
    loop index in 0..<common_len {
        if left[index] != right[index] -> return left[index] < right[index]
    }
    left.len() < right.len()
}

fn mir_digest_hardware_setup_before(left: MIRHardwareSetup, right: MIRHardwareSetup) -> Bool Never! {
    if left == {
        .DMAConfigure(left_profile, left_channel, left_width, left_ownership) -> {
            if right == {
                .DMAConfigure(right_profile, right_channel, right_width, right_ownership) -> {
                    if left_profile != right_profile -> return left_profile < right_profile
                    if left_channel != right_channel -> return left_channel < right_channel
                    left_width_name :: mir_digest_register_width(left_width)
                    right_width_name :: mir_digest_register_width(right_width)
                    if left_width_name != right_width_name -> return left_width_name < right_width_name
                    left_ownership_name :: mir_digest_dma_ownership(left_ownership)
                    right_ownership_name :: mir_digest_dma_ownership(right_ownership)
                    left_ownership_name < right_ownership_name
                }
                .InterruptBind(_, _, _, _, _) -> true
            }
        }
        .InterruptBind(left_profile, left_interrupt, left_vector, left_handler, left_effects) -> {
            if right == {
                .DMAConfigure(_, _, _, _) -> false
                .InterruptBind(right_profile, right_interrupt, right_vector, right_handler, right_effects) -> {
                    if {
                        left_profile != right_profile -> left_profile < right_profile
                        left_interrupt != right_interrupt -> left_interrupt < right_interrupt
                        left_vector != right_vector -> left_vector < right_vector
                        left_handler != right_handler -> left_handler < right_handler
                        else -> mir_digest_joined_strings_before(left_effects, right_effects)
                    }
                }
            }
        }
    }
}

fn mir_digest_sort_hardware_setups(values: &[MIRHardwareSetup]) Never! {
    loop index in 1..<values.len() {
        current := values[index]
        cursor := index - 1
        loop cursor >= 0 && mir_digest_hardware_setup_before(current, values[cursor]) {
            values[cursor + 1] = values[cursor]
            cursor -= 1
        }
        values[cursor + 1] = current
    }
}

fn mir_digest_hardware_setup(writer: &MIRCanonicalWriter, values: [MIRHardwareSetup]) Never! {
    sorted := values
    mir_digest_sort_hardware_setups(&sorted)
    mir_digest_len(&writer, sorted.len())
    loop value in sorted {
        if value == {
            .DMAConfigure(profile, channel, width, ownership) -> {
                mir_digest_tag(&writer, "dma-configure")
                mir_digest_string(&writer, profile)
                mir_digest_string(&writer, channel)
                mir_digest_string(&writer, mir_digest_register_width(width))
                mir_digest_string(&writer, mir_digest_dma_ownership(ownership))
            }
            .InterruptBind(profile, interrupt, vector, handler, effects) -> {
                mir_digest_tag(&writer, "interrupt-bind")
                mir_digest_string(&writer, profile)
                mir_digest_string(&writer, interrupt)
                mir_digest_u16(&writer, vector)
                mir_digest_string(&writer, handler)
                sorted_effects := effects
                mir_digest_sort_strings(&sorted_effects)
                mir_digest_len(&writer, sorted_effects.len())
                loop effect_name in sorted_effects -> mir_digest_string(&writer, effect_name)
            }
        }
    }
}

fn mir_digest_job_scope(value: MIRJobScope) -> Int Never! {
    if value == {
        .Dev -> 1
        .Ship -> 2
        .Internal -> 3
    }
}

fn mir_digest_job_dispatch(value: MIRJobDispatch) -> Int Never! {
    if value == {
        .Direct -> 1
        .Spawn -> 2
        .Scheduled -> 3
    }
}

fn mir_digest_job_cache(value: MIRJobCachePolicy) -> Int Never! {
    if value == {
        .Uncached -> 1
        .Local -> 2
        .Shared -> 3
    }
}

fn mir_digest_test_kind(value: MIRTestKind) -> Int Never! {
    if value == {
        .Unit -> 1
        .Property -> 2
    }
}

fn mir_digest_harness_kind(value: MIRHarnessKind) -> Int Never! {
    if value == {
        .Test -> 1
        .Fuzz -> 2
        .Coverage -> 3
    }
}

fn mir_digest_job(writer: &MIRCanonicalWriter, value: MIRJob) {
    mir_digest_u64(&writer, value.id.value)
    mir_digest_u64(&writer, value.function.value)
    mir_digest_string(&writer, value.name)
    mir_digest_u64(&writer, mir_digest_job_scope(value.scope))
    if value.schedule == {
        .Val(schedule) -> {
        if schedule == {
            .Duration(nanos) -> {
                mir_digest_tag(&writer, "duration")
                mir_digest_u64(&writer, nanos)
            }
            .WallClockTime(hour, minute) -> {
                mir_digest_tag(&writer, "wall-clock")
                mir_digest_u64(&writer, hour)
                mir_digest_u64(&writer, minute)
            }
        }
    }
    else -> {
        mir_digest_tag(&writer, "no-schedule")
    }
}
    mir_digest_len(&writer, value.inputs.len())
    loop input in value.inputs -> mir_digest_cli_input(&writer, input)
    mir_digest_u64(&writer, mir_digest_job_dispatch(value.dispatch))
    mir_digest_len(&writer, value.after.len())
    loop dependency in value.after -> mir_digest_string(&writer, dependency)
    mir_digest_u64(&writer, value.parallel)
    mir_digest_len(&writer, value.packages.len())
    loop package in value.packages -> mir_digest_string(&writer, package)
    mir_digest_option_string(&writer, value.working_directory)
    mir_digest_len(&writer, value.input_paths.len())
    loop path in value.input_paths -> mir_digest_string(&writer, path)
    mir_digest_len(&writer, value.output_paths.len())
    loop path in value.output_paths -> mir_digest_string(&writer, path)
    if value.skip == {
        .Val(skip) -> {
        if skip == {
            .Always(reason) -> {
                mir_digest_tag(&writer, "always")
                mir_digest_string(&writer, reason)
            }
            .UnlessPlatform(platform) -> {
                mir_digest_tag(&writer, "unless-platform")
                mir_digest_string(&writer, platform)
            }
        }
    }
    else -> {
        mir_digest_tag(&writer, "no-skip")
    }
}
    mir_digest_u64(&writer, mir_digest_job_cache(value.cache))
    limits := value.limits
    mir_digest_sort_job_limits(&limits)
    mir_digest_len(&writer, limits.len())
    loop limit in limits {
        mir_digest_string(&writer, limit.name)
        mir_digest_string(&writer, limit.value)
    }
}

fn mir_digest_test(writer: &MIRCanonicalWriter, value: MIRTestCase) Never! {
    mir_digest_u64(&writer, value.id.value)
    mir_digest_u64(&writer, value.function.value)
    mir_digest_string(&writer, value.name)
    mir_digest_span(&writer, value.span)
    mir_digest_u64(&writer, mir_digest_test_kind(value.kind))
    mir_digest_bool(&writer, value.contract_generated)
    mir_digest_option_int(&writer, value.eligibility.map(row -> row.value))
    mir_digest_len(&writer, value.parameters.len())
    loop param in value.parameters -> mir_digest_param(&writer, param)
    mir_digest_len(&writer, value.faults.len())
    loop fault in value.faults -> mir_digest_string(&writer, fault)
    mir_digest_bool(&writer, value.expected_failure)
    mir_digest_option_string(&writer, value.generation_unavailable_reason)
}

fn mir_digest_harness(writer: &MIRCanonicalWriter, value: MIRHarnessPlan) Never! {
    mir_digest_u64(&writer, value.id.value)
    mir_digest_u64(&writer, mir_digest_harness_kind(value.kind))
    tests := value.tests.map(row -> row.value)
    mir_digest_sort_ints(&tests)
    mir_digest_len(&writer, tests.len())
    loop test in tests -> mir_digest_u64(&writer, test)
    output_checks := value.output_checks
    mir_digest_sort_output_checks(&output_checks)
    mir_digest_len(&writer, output_checks.len())
    loop check in output_checks {
        mir_digest_u64(&writer, check.id.value)
        mir_digest_string(&writer, check.name)
        mir_digest_u64(&writer, check.function.value)
    }
    mir_digest_option_int(&writer, value.selected_test.map(row -> row.value))
    coverage_points := value.coverage_points
    mir_digest_sort_coverage_points(&coverage_points)
    mir_digest_len(&writer, coverage_points.len())
    loop point in coverage_points {
        mir_digest_u64(&writer, point.id.value)
        mir_digest_u64(&writer, point.function.value)
        mir_digest_u64(&writer, point.block.value)
        mir_digest_span(&writer, point.span)
    }
    mir_digest_bool(&writer, value.command_override)
}

fn mir_digest_artifact_kind(value: MIRArtifactKind) -> Int Never! {
    if value == {
        .NativeExecutable -> 1
        .NativeLibrary -> 2
        .WebApplication -> 3
        .TestExecutable -> 4
        .FuzzExecutable -> 5
        .SandboxPlugin -> 6
        .TestOverride -> 7
    }
}

fn mir_digest_artifact_target(value: MIRArtifactTarget) -> Int Never! {
    if value == {
        .RustAOT -> 1
        .Cranelift -> 2
        .Interpreter -> 3
        .Web -> 4
    }
}

fn mir_digest_artifact_mode(value: MIRArtifactBuildMode) -> Int Never! {
    if value == {
        .Dev -> 1
        .Release -> 2
        .Test -> 3
        .Fuzz -> 4
        .Coverage -> 5
    }
}

fn mir_digest_entry_kind(value: MIREntryKind) -> Int Never! {
    if value == {
        .Library -> 1
        .Command -> 2
        .App -> 3
        .Service -> 4
        .Test -> 5
    }
}

fn mir_digest_entry_output(value: MIREntryOutput) -> Int Never! {
    if value == {
        .NoOutput -> 1
        .ReturnValue -> 2
        .StandardOutput -> 3
        .ExitStatus -> 4
    }
}

fn mir_digest_entry_spec(writer: &MIRCanonicalWriter, value: MIREntrySpec) {
    mir_digest_u64(&writer, mir_digest_entry_kind(value.kind))
    mir_digest_option_int(&writer, value.function.map(row -> row.value))
    if value.cli == {
        .Val(cli) -> {
        mir_digest_bool(&writer, true)
        mir_digest_cli_entry(&writer, cli)
    }
    else -> {
        mir_digest_bool(&writer, false)
    }
}
    mir_digest_u64(&writer, mir_digest_entry_output(value.output))
    mir_digest_bool(&writer, value.initialize_environment)
    mir_digest_bool(&writer, value.initialize_gc)
    mir_digest_bool(&writer, value.serves_until_stopped)
    mir_digest_string(&writer, value.package_version)
}

fn mir_digest_export(writer: &MIRCanonicalWriter, value: MIRExport) Never! {
    mir_digest_string(&writer, value.symbol)
    mir_digest_u64(&writer, value.function.value)
    mir_digest_foreign_abi(&writer, value.abi)
}

fn mir_digest_artifact(writer: &MIRCanonicalWriter, value: MIRArtifactPlan) {
    mir_digest_u64(&writer, value.id.value)
    mir_digest_u64(&writer, mir_digest_artifact_kind(value.kind))
    mir_digest_string(&writer, value.name)
    mir_digest_u64(&writer, mir_digest_artifact_target(value.target))
    mir_digest_u64(&writer, mir_digest_artifact_mode(value.mode))
    modules := value.modules.map(row -> row.value)
    mir_digest_sort_ints(&modules)
    mir_digest_len(&writer, modules.len())
    loop module_id in modules -> mir_digest_u64(&writer, module_id)
    links := value.links.map(row -> row.value)
    mir_digest_sort_ints(&links)
    mir_digest_len(&writer, links.len())
    loop link in links -> mir_digest_u64(&writer, link)
    jobs := value.jobs.map(row -> row.value)
    mir_digest_sort_ints(&jobs)
    mir_digest_len(&writer, jobs.len())
    loop job in jobs -> mir_digest_u64(&writer, job)
    mir_digest_runtime_parts(&writer, value.runtime_parts)
    exports := value.exports
    mir_digest_sort_exports(&exports)
    mir_digest_len(&writer, exports.len())
    loop export in exports -> mir_digest_export(&writer, export)
    mir_digest_string(&writer, value.provider_identity)
    mir_digest_string(&writer, value.closure_identity)
    mir_digest_string(&writer, value.artifact_identity)
    if value.entry == {
        .Val(entry) -> {
        mir_digest_bool(&writer, true)
        mir_digest_entry_spec(&writer, entry)
    }
    else -> {
        mir_digest_bool(&writer, false)
    }
}
    mir_digest_option_int(&writer, value.harness.map(row -> row.value))
}

fn mir_digest_erasure_reason(value: MIRErasureReason) -> Int Never! {
    if value == {
        .CompileTimeOnly -> 1
        .Disabled -> 2
        .ExpandedBeforeLowering -> 3
        .SemanticIndexOnly -> 4
    }
}

fn mir_digest_web_bucket_debug(value: MIRWebBucket?) -> String Never! {
    bucket :: value ?? return "None"
    if bucket == {
        .JS -> "Some(JS)"
        else -> "Some(Wasm)"
    }
}

fn mir_digest_web_marker_debug(value: MIRWebPartitionMarker?) -> String Never! {
    marker :: value ?? return "None"
    if marker == {
        .Wasm -> "Some(Wasm)"
        .JS -> "Some(JS)"
        else -> "Some(WasmExport)"
    }
}

fn mir_digest_function_form(writer: &MIRCanonicalWriter, value: MIRFunctionForm) Never! {
    if value == {
        .TopLevel -> mir_digest_tag(&writer, "top-level")
        .Method(owner, self_access) -> {
            mir_digest_tag(&writer, "method")
            mir_digest_type(&writer, owner)
            mir_digest_access_optional(&writer, self_access)
        }
        .TraitMethod(owner, trait_ref, self_access, serde) -> {
            mir_digest_tag(&writer, "trait-method")
            mir_digest_type(&writer, owner)
            mir_digest_u64(&writer, trait_ref.id.value)
            mir_digest_string(&writer, trait_ref.name)
            mir_digest_access_optional(&writer, self_access)
            mir_digest_serde_codec(&writer, serde)
        }
    }
}

fn mir_digest_web_param_reconstruction(writer: &MIRCanonicalWriter, value: MIRWebParamReconstruction) Never! {
    mir_digest_string(&writer, value.local)
    mir_digest_type(&writer, value.ty)
    mir_digest_len(&writer, value.fields.len())
    loop field in value.fields {
        mir_digest_string(&writer, field.field)
        mir_digest_string(&writer, field.parameter)
        mir_digest_type(&writer, field.ty)
    }
}

fn mir_digest_kernel_facts_debug(value: MIRKernelFacts?) -> String Never! {
    row :: value ?? return "None"
    "Some(MirKernelFacts {{ bounds: {mir_digest_debug_bool(row.bounds)}, alias_free: {mir_digest_debug_bool(row.alias_free)}, captures: {mir_digest_debug_bool(row.captures)}, race_free: {mir_digest_debug_bool(row.race_free)}, barriers_uniform: {mir_digest_debug_bool(row.barriers_uniform)}, control_flow: {mir_digest_debug_bool(row.control_flow)} }})"
}

fn mir_digest_unsafe_gate_debug(value: MIRUnsafeGate?) -> String Never! {
    row :: value ?? return "None"
    "Some(MirUnsafeGate {{ file: {mir_digest_debug_quote(row.file)}, line: {row.line}, reason: {mir_digest_debug_quote(row.reason)}, enabled: {mir_digest_debug_bool(row.enabled)}, fenced: {mir_digest_debug_bool(row.fenced)} }})"
}

fn mir_digest_scope_debug(value: MIRScope) -> String Never! {
    facts :: loop fact in value.facts -> "MirScopeFact {{ key: {mir_digest_debug_quote(fact.key)}, value: {mir_digest_debug_quote(fact.value)} }}"
    "MirScope {{ id: MirScopeId {{ value: {value.id.value} }}, kind: {mir_digest_scope_kind_debug(value.kind)}, span: {value.span.start}..{value.span.end}, name: {mir_digest_debug_option_string(value.name)}, deadline: {mir_digest_debug_int_option(value.deadline.map(row -> row.value))}, facts: [{facts.join(", ")}] }}"
}

fn mir_digest_scope_kind_debug(value: MIRScopeKind) -> String Never! {
    if value == {
        .Unsafe -> "Unsafe"
        .Impure -> "Impure"
        .Reactive -> "Reactive"
        .Shield -> "Shield"
        .Region -> "Region"
        .Policy -> "Policy"
        .TaskGroup -> "TaskGroup"
        .Layout -> "Layout"
        .Authority -> "Authority"
        .Context -> "Context"
        .Live -> "Live"
        .AssumeDeterministic -> "AssumeDeterministic"
        .Transaction -> "Transaction"
        .ScopeMember -> "ScopeMember"
        .DebugOnly -> "DebugOnly"
    }
}

fn mir_digest_place_base(writer: &MIRCanonicalWriter, value: MIRPlaceBase) Never! {
    if value == {
        .Local(local) -> {
            mir_digest_tag(&writer, "local")
            mir_digest_u64(&writer, local.value)
        }
        .Parameter(parameter) -> {
            mir_digest_tag(&writer, "parameter")
            mir_digest_u64(&writer, parameter.value)
        }
        .Capture(capture) -> {
            mir_digest_tag(&writer, "capture")
            mir_digest_u64(&writer, capture.value)
        }
        .Temporary(temporary) -> {
            mir_digest_tag(&writer, "temporary")
            mir_digest_u64(&writer, temporary.value)
        }
        .Static(name) -> {
            mir_digest_tag(&writer, "static")
            mir_digest_string(&writer, name)
        }
    }
}

fn mir_digest_index_debug(value: MIRIndexKind) -> String Never! {
    if value == {
        .List -> "List"
        .FixedListProof -> "FixedListProof"
        .Map -> "Map"
        .Lane -> "Lane"
        .Pool -> "Pool"
    }
}

fn mir_digest_projection(writer: &MIRCanonicalWriter, value: MIRProjection) Never! {
    if value == {
        .Field(field, span) -> {
            mir_digest_tag(&writer, "field")
            mir_digest_u64(&writer, field.value)
            mir_digest_span(&writer, span)
        }
        .Index(kind, index, call, write_call, location, context, span) -> {
            mir_digest_tag(&writer, "index")
            mir_digest_u64(&writer, mir_digest_index_kind_code(kind))
            mir_digest_u64(&writer, index.value)
            mir_digest_u64(&writer, call.value)
            mir_digest_option_int(&writer, write_call.map(row -> row.value))
            mir_digest_string(&writer, mir_digest_panic_location_debug(location))
            mir_digest_string(&writer, mir_digest_panic_context_debug(context ?? MIRPanicContext{function: "", source_line: "", caret: 0, locals: [MIRPanicLocal]{}}))
            mir_digest_span(&writer, span)
        }
        .Deref(span) -> {
            mir_digest_tag(&writer, "deref")
            mir_digest_span(&writer, span)
        }
        .Payload(kind, span) -> {
            mir_digest_tag(&writer, "payload")
            if kind == {
                .Option -> mir_digest_u64(&writer, 1)
                .Result(ok) -> mir_digest_u64(&writer, if ok -> 3 else -> 2)
                .Enum(owner, variant, index) -> {
                    mir_digest_u64(&writer, 4)
                    mir_digest_u64(&writer, owner.value)
                    mir_digest_string(&writer, variant)
                    mir_digest_u64(&writer, index)
                }
            }
            mir_digest_span(&writer, span)
        }
        .Range(range, location, span) -> {
            mir_digest_tag(&writer, "range")
            mir_digest_u64(&writer, range.value)
            mir_digest_string(&writer, mir_digest_panic_location_debug(location))
            mir_digest_span(&writer, span)
        }
    }
}

fn mir_digest_index_kind_code(value: MIRIndexKind) -> Int Never! {
    if value == {
        .List -> 1
        .FixedListProof -> 2
        .Map -> 3
        .Lane -> 4
        .Pool -> 5
    }
}

fn mir_digest_place(writer: &MIRCanonicalWriter, value: MIRPlace) Never! {
    mir_digest_u64(&writer, value.id.value)
    mir_digest_span(&writer, value.span)
    mir_digest_type(&writer, value.ty)
    mir_digest_place_base(&writer, value.base)
    mir_digest_len(&writer, value.projections.len())
    loop projection in value.projections -> mir_digest_projection(&writer, projection)
    mir_digest_string(&writer, mir_digest_access_debug(value.access))
    mir_digest_option_string(&writer, value.persist_key)
}

fn mir_digest_local(writer: &MIRCanonicalWriter, value: MIRLocal) Never! {
    mir_digest_u64(&writer, value.id.value)
    mir_digest_string(&writer, value.name)
    mir_digest_span(&writer, value.span)
    mir_digest_type(&writer, value.ty)
    mir_digest_u64(&writer, value.place.value)
    mir_digest_string(&writer, mir_digest_ownership_debug(value.ownership))
    mir_digest_bool(&writer, value.mutable)
    mir_digest_bool(&writer, value.is_comptime)
    mir_digest_bool(&writer, value.uninit)
    mir_digest_bool(&writer, value.arena_view)
    mir_digest_bool(&writer, value.string_view)
    mir_digest_bool(&writer, value.gc_root)
}

fn mir_digest_terminator_debug(terminator: MIRTerminator) -> String Never! {
    if terminator == {
        .Jump(target) -> "Jump(MirBlockId({target.value}))"
        .Branch(condition, then_target, else_target) -> "Branch(MirValueId({condition.value}), MirBlockId({then_target.value}), MirBlockId({else_target.value}))"
        .Switch(subject, arms, otherwise) -> {
            rendered :: loop arm in arms -> "MirSwitchArm {{ condition: MirValueId {{ value: {arm.condition.value} }}, target: MirBlockId {{ value: {arm.target.value} }}, span: {arm.span.start}..{arm.span.end} }}"
            "Switch(MirValueId({subject.value}), [{rendered.join(", ")}], MirBlockId({otherwise.value}))"
        }
        .Return(value) -> "Return({mir_digest_debug_int_option(value.map(row -> row.value))})"
        .Yield(value, resume) -> "Yield(MirValueId({value.value}), MirBlockId({resume.value}))"
        .Break(target, value) -> "Break(MirBlockId({target.value}), {mir_digest_debug_int_option(value.map(row -> row.value))})"
        .Continue(target) -> "Continue(MirBlockId({target.value}))"
        .Unreachable(reason) -> "Unreachable({mir_digest_debug_quote(reason)})"
    }
}

fn mir_digest_copy_cost_debug(value: MIRCopyCost) -> String Never! {
    if value == {
        .NoCopy -> "NoCopy"
        .PerIteration(count) -> "PerIteration({count})"
        .Unknown -> "Unknown"
    }
}

fn mir_digest_optimization_decision_debug(value: MIROptimizationDecision) -> String Never! {
    if value == {
        .Eligible -> "Eligible"
        .Rejected(reason) -> "Rejected({mir_digest_optimization_rejection_debug(reason)})"
    }
}

fn mir_digest_optimization_rejection_debug(value: MIROptimizationRejection) -> String Never! {
    if value == {
        .MissingProof -> "MissingProof"
        .MayTrap -> "MayTrap"
        .HasEffects -> "HasEffects"
        .HasEarlyExit -> "HasEarlyExit"
        .MayAlias -> "MayAlias"
        .CrossIterationDependency -> "CrossIterationDependency"
        .DynamicTripCount -> "DynamicTripCount"
        .UnknownCopyCost -> "UnknownCopyCost"
        .ScalarBoundary -> "ScalarBoundary"
        .ObservableLayout -> "ObservableLayout"
        .OwnershipObligation -> "OwnershipObligation"
        .UnsupportedOperation -> "UnsupportedOperation"
    }
}

fn mir_digest_loop_facts_debug(values: [MIRLoopFact]) -> String Never! {
    rendered :: loop value in values -> "MirLoopFact {{ header: {value.header.value}, body: {mir_digest_debug_int_option(value.body.map(row -> row.value))}, exit: {mir_digest_debug_int_option(value.exit.map(row -> row.value))}, form: {mir_digest_loop_form_debug(value.form)}, trip_count: {mir_digest_debug_int_option(value.trip_count)}, copy_cost: {mir_digest_copy_cost_debug(value.copy_cost)}, canonical: {mir_digest_debug_bool(value.canonical)}, span: {value.span.start}..{value.span.end}, decision: {mir_digest_optimization_decision_debug(value.decision)} }}"
    "[{rendered.join(", ")}]"
}

fn mir_digest_loop_form_debug(value: MIRLoopForm) -> String Never! {
    if value == {
        .Unconditional -> "Unconditional"
        .Counted -> "Counted"
        .Iterator -> "Iterator"
    }
}

fn mir_digest_vector_rule(value: MIRVectorRule) -> String Never! {
    if value == {
        .Elementwise -> "elementwise"
        .FieldAccess -> "field-access"
        .ConditionalAccumulate -> "conditional-accumulate"
        .EarlyExitSearch -> "early-exit-search"
        .Reduction -> "reduction"
    }
}

fn mir_digest_vector_layout(value: MIRVectorLayout) -> String Never! {
    if value == {
        .Flat -> "flat"
        .AosStrided -> "aos-strided"
        .ColumnarDirect -> "columnar-direct"
    }
}

fn mir_digest_vector_access_debug(value: MIRVectorAccess) -> String Never! {
    root :: if value.root == {
        .Place(id) -> "Place({id.value})"
        .Value(id) -> "Value({id.value})"
    }
    "MirVectorAccess {{ root: {root}, field: {mir_digest_debug_int_option(value.field.map(row -> row.value))}, layout: {mir_digest_vector_layout(value.layout)}, column_index: {mir_digest_debug_int_option(value.column_index)} }}"
}

fn mir_digest_bounds_facts_debug(values: [MIRBoundsFact]) -> String Never! {
    rendered :: loop value in values -> "MirBoundsFact {{ operation: {value.operation.value}, place: {mir_digest_debug_int_option(value.place.map(row -> row.value))}, index: {mir_digest_debug_int_option(value.index.map(row -> row.value))}, kind: {mir_digest_index_debug(value.kind)}, proven: {mir_digest_debug_bool(value.proven)}, elided: {mir_digest_debug_bool(value.elided)}, failure_preserved: {mir_digest_debug_bool(value.failure_preserved)}, span: {value.span.start}..{value.span.end} }}"
    "[{rendered.join(", ")}]"
}

fn mir_digest_vector_fact(writer: &MIRCanonicalWriter, value: MIRVectorFact) Never! {
    mir_digest_u64(&writer, value.loop_header.value)
    mir_digest_option_int(&writer, value.cursor.map(row -> row.value))
    mir_digest_len(&writer, value.body_blocks.len())
    loop block in value.body_blocks -> mir_digest_u64(&writer, block.value)
    mir_digest_option_int(&writer, value.advance_block.map(row -> row.value))
    mir_digest_tag(&writer, mir_digest_vector_rule(value.rule))
    mir_digest_len(&writer, value.accesses.len())
    loop access in value.accesses {
        if access.root == {
            .Place(place) -> {
                mir_digest_tag(&writer, "place")
                mir_digest_u64(&writer, place.value)
            }
            .Value(root_value) -> {
                mir_digest_tag(&writer, "value")
                mir_digest_u64(&writer, root_value.value)
            }
        }
        mir_digest_option_int(&writer, access.field.map(row -> row.value))
        mir_digest_tag(&writer, mir_digest_vector_layout(access.layout))
        mir_digest_option_int(&writer, access.column_index)
    }
    mir_digest_tag(&writer, mir_digest_vector_layout(value.layout))
    mir_digest_option_type(&writer, value.element_type)
    mir_digest_bool(&writer, value.packed)
    mir_digest_option_int(&writer, value.lane_width)
    mir_digest_bool(&writer, value.no_aliasing)
    mir_digest_bool(&writer, value.no_early_exit)
    mir_digest_bool(&writer, value.effect_free_body)
    mir_digest_bool(&writer, value.no_cross_iteration_dependencies)
    if value.fixed_reduction == {
        .Val(reduction) -> {
        mir_digest_bool(&writer, true)
        mir_digest_u64(&writer, reduction.accumulator.value)
        mir_digest_u64(&writer, reduction.addend.value)
        mir_digest_u64(&writer, reduction.seed.value)
        mir_digest_option_int(&writer, reduction.condition.map(row -> row.value))
        mir_digest_len(&writer, reduction.source_operations.len())
        loop operation in reduction.source_operations -> mir_digest_u64(&writer, operation.value)
        mir_digest_u64(&writer, reduction.exit.value)
        mir_digest_u64(&writer, reduction.order.lanes)
        mir_digest_u64(&writer, reduction.order.seed_lane)
        mir_digest_tag(&writer, "adjacent-pairs-then-root")
    }
    else -> {
        mir_digest_bool(&writer, false)
    }
}
    mir_digest_span(&writer, value.span)
    mir_digest_optimization_decision(&writer, value.decision)
}

fn mir_digest_optimization_decision(writer: &MIRCanonicalWriter, value: MIROptimizationDecision) Never! {
    if value == {
        .Eligible -> mir_digest_tag(&writer, "eligible")
        .Rejected(reason) -> {
            mir_digest_tag(&writer, "rejected")
            mir_digest_tag(&writer, mir_digest_optimization_rejection_debug(reason))
        }
    }
}

fn mir_digest_optimization_facts(writer: &MIRCanonicalWriter, value: MIROptimizationFacts) Never! {
    mir_digest_bool(&writer, value.pure)
    mir_digest_bool(&writer, value.replayable)
    mir_digest_bool(&writer, value.diverges)
    mir_digest_bool(&writer, value.inline)
    mir_digest_bool(&writer, value.inline_always)
    mir_digest_bool(&writer, value.gc_return)
    mir_digest_bool(&writer, value.gc_scope)
    mir_digest_bool(&writer, value.kernel)
    mir_digest_bool(&writer, value.auto_vectorizable)
    mir_digest_bool(&writer, value.no_aliasing)
    mir_digest_bool(&writer, value.no_early_exit)
    mir_digest_bool(&writer, value.no_cross_iteration_dependencies)
    mir_digest_string(&writer, mir_digest_debug_string_list(value.pass_ids.map(row -> "{row}")))
    mir_digest_string(&writer, mir_digest_loop_facts_debug(value.loop_facts))
    mir_digest_string(&writer, mir_digest_bounds_facts_debug(value.bounds_facts))
    mir_digest_len(&writer, value.vector_facts.len())
    loop fact in value.vector_facts -> mir_digest_vector_fact(&writer, fact)
    mir_digest_string(&writer, mir_digest_debug_string_list(value.checked_vector_facts.map(row -> "{row.loop_header.value}:{row.span.start}")))
    mir_digest_string(&writer, mir_digest_debug_string_list(value.fusion_facts.map(row -> "{row.first_loop.value}:{row.second_loop.value}")))
    mir_digest_len(&writer, value.acceleration_facts.len())
    loop fact in value.acceleration_facts {
        mir_digest_u64(&writer, fact.loop_header.value)
        mir_digest_tag(&writer, if fact.transform == .TransientColumnCopy -> "transient-column-copy" else -> "pooled-parallel-chunks")
        mir_digest_bool(&writer, fact.workload.nested_reuse)
        mir_digest_bool(&writer, fact.workload.single_pass)
        mir_digest_bool(&writer, fact.proof.source_proven)
        mir_digest_bool(&writer, fact.proof.independent_iterations)
        mir_digest_bool(&writer, fact.proof.no_aliasing)
        mir_digest_bool(&writer, fact.proof.no_cross_iteration_dependencies)
        mir_digest_bool(&writer, fact.proof.no_early_exit)
        mir_digest_bool(&writer, fact.proof.effect_free_body)
        mir_digest_bool(&writer, fact.proof.ownership_safe)
        mir_digest_bool(&writer, fact.proof.failure_order_preserved)
        mir_digest_span(&writer, fact.span)
    }
}

fn mir_digest_instruction(writer: &MIRCanonicalWriter, value: MIRInstruction) {
    mir_digest_u64(&writer, value.id.value)
    mir_digest_span(&writer, value.span)
    mir_digest_string(&writer, mir_digest_debug_int_option(value.source_line))
    mir_digest_option_int(&writer, value.result.map(row -> row.value))
    mir_digest_option_type(&writer, value.ty)
    mir_digest_operation(&writer, value.operation)
}

fn mir_digest_function(writer: &MIRCanonicalWriter, value: MIRFunction) {
    mir_digest_u64(&writer, value.id.value)
    mir_digest_u64(&writer, value.module_id.value)
    mir_digest_u64(&writer, value.source_file.value)
    mir_digest_string(&writer, value.key)
    mir_digest_string(&writer, value.module_name)
    mir_digest_string(&writer, value.name)
    mir_digest_span(&writer, value.span)
    mir_digest_string(&writer, mir_digest_function_kind_debug(value.kind))
    mir_digest_function_form(&writer, value.form)
    mir_digest_string(&writer, mir_digest_visibility_debug(value.visibility))
    mir_digest_target_applicability(&writer, value.target_applicability)
    mir_digest_string(&writer, mir_digest_web_bucket_debug(value.web_bucket))
    mir_digest_string(&writer, mir_digest_web_marker_debug(value.web_marker))
    mir_digest_generic_params(&writer, value.generic_params)
    captures := value.capture_params
    mir_digest_sort_captures(&captures)
    mir_digest_len(&writer, captures.len())
    loop capture in captures -> mir_digest_capture_param(&writer, capture)
    mir_digest_len(&writer, value.params.len())
    loop param in value.params -> mir_digest_param(&writer, param)
    mir_digest_option_type(&writer, value.declared_return)
    mir_digest_type(&writer, value.return_type)
    if value.generator == {
        .Val(generator) -> {
        mir_digest_bool(&writer, true)
        mir_digest_type(&writer, generator.item)
    }
    else -> {
        mir_digest_bool(&writer, false)
    }
}
    mir_digest_failure_carrier(&writer, value.failure)
    mir_digest_string(&writer, mir_digest_effects_debug(value.effects))
    mir_digest_string(&writer, value.captures.map(row -> mir_digest_capture_facts_debug(row)) ?? "None")
    mir_digest_optimization_facts(&writer, value.optimization)
    mir_digest_bool(&writer, value.is_unsafe)
    mir_digest_string(&writer, mir_digest_unsafe_gate_debug(value.unsafe_gate))
    mir_digest_bool(&writer, value.is_pure)
    mir_digest_string(&writer, mir_digest_debug_int_option(value.memo_bound))
    mir_digest_bool(&writer, value.is_reactive)
    mir_digest_string(&writer, mir_digest_debug_string_list(value.reactive_upgrades))
    mir_digest_bool(&writer, value.is_inline)
    mir_digest_bool(&writer, value.is_inline_always)
    mir_digest_bool(&writer, value.is_scalar)
    mir_digest_string(&writer, mir_digest_kernel_facts_debug(value.kernel_proof))
    mir_digest_bool(&writer, value.gc_return)
    mir_digest_string(&writer, mir_digest_view_provenance_option_debug(value.return_view_provenance))
    mir_digest_len(&writer, value.web_param_reconstructions.len())
    loop reconstruction in value.web_param_reconstructions -> mir_digest_web_param_reconstruction(&writer, reconstruction)
    blocks := value.blocks
    mir_digest_sort_blocks(&blocks)
    mir_digest_len(&writer, blocks.len())
    loop block in blocks {
        mir_digest_u64(&writer, block.id.value)
        mir_digest_span(&writer, block.span)
        mir_digest_len(&writer, block.instructions.len())
        loop instruction in block.instructions -> mir_digest_instruction(&writer, instruction)
        mir_digest_string(&writer, mir_digest_terminator_debug(block.terminator))
    }
    locals := value.locals
    mir_digest_sort_locals(&locals)
    mir_digest_len(&writer, locals.len())
    loop local in locals -> mir_digest_local(&writer, local)
    values := value.values
    mir_digest_sort_value_facts(&values)
    mir_digest_len(&writer, values.len())
    loop fact in values {
        mir_digest_u64(&writer, fact.id.value)
        mir_digest_type(&writer, fact.ty)
        mir_digest_span(&writer, fact.span)
        mir_digest_string(&writer, mir_digest_ownership_debug(fact.ownership))
    }
    places := value.places
    mir_digest_sort_places(&places)
    mir_digest_len(&writer, places.len())
    loop place in places -> mir_digest_place(&writer, place)
    scopes := value.scopes
    mir_digest_sort_scopes(&scopes)
    mir_digest_string(&writer, mir_digest_debug_string_list(scopes.map(row -> mir_digest_scope_debug(row))))
    drops := value.drops
    mir_digest_sort_drops(&drops)
    mir_digest_string(&writer, mir_digest_debug_string_list(drops.map(row -> "{row.place.value}:{row.span.start}:{row.span.end}")))
}

fn mir_digest_register_access_mode(value: MIRTargetRegisterAccessMode) -> String Never! {
    if value == {
        .ReadOnly -> "read-only"
        .WriteOnly -> "write-only"
        .ReadWrite -> "read-write"
    }
}

fn mir_digest_target_register_operation(value: MIRTargetRegisterOperation) -> String Never! {
    if value == {
        .Read -> "read"
        .Write -> "write"
    }
}

fn mir_digest_target_dma_operation(value: MIRTargetDMAOperation) -> String Never! {
    if value == {
        .Start -> "start"
        .Wait -> "wait"
        .UseBuffer -> "use-buffer"
    }
}

fn mir_digest_target_dma_owner(value: MIRTargetDMAOwner) -> String Never! {
    if value == {
        .CPU -> "cpu"
        .Device -> "device"
    }
}

fn mir_digest_target_unresolved(writer: &MIRCanonicalWriter, value: MIRTargetHardwareUnresolvedReference) Never! {
    if value == {
        .RegisterBlock(block) -> {
            mir_digest_tag(&writer, "register-block")
            mir_digest_string(&writer, block)
        }
        .Register(block, register) -> {
            mir_digest_tag(&writer, "register")
            mir_digest_string(&writer, block)
            mir_digest_string(&writer, register)
        }
        .DMAChannel(channel) -> {
            mir_digest_tag(&writer, "dma-channel")
            mir_digest_string(&writer, channel)
        }
        .Interrupt(interrupt) -> {
            mir_digest_tag(&writer, "interrupt")
            mir_digest_string(&writer, interrupt)
        }
    }
}

fn mir_digest_bool_order(value: Bool) -> Int Never! {
    if value -> 1 else -> 0
}

fn mir_digest_target_register_after(left: MIRTargetRegisterFact, right: MIRTargetRegisterFact) -> Bool Never! {
    if left.name != right.name -> return left.name > right.name
    if left.offset != right.offset -> return left.offset > right.offset
    left_width :: mir_digest_register_width(left.width)
    right_width :: mir_digest_register_width(right.width)
    if left_width != right_width -> return left_width > right_width
    left_access :: mir_digest_register_access_mode(left.access)
    right_access :: mir_digest_register_access_mode(right.access)
    if left_access != right_access -> return left_access > right_access
    mir_digest_bool_order(left.volatile) > mir_digest_bool_order(right.volatile)
}

fn mir_digest_sort_target_registers(rows: &[MIRTargetRegisterFact]) Never! {
    loop index in 1..<rows.len() {
        current := rows[index]
        cursor := index - 1
        loop cursor >= 0 && mir_digest_target_register_after(rows[cursor], current) {
            rows[cursor + 1] = rows[cursor]
            cursor -= 1
        }
        rows[cursor + 1] = current
    }
}

fn mir_digest_target_block_after(left: MIRTargetRegisterBlockFact, right: MIRTargetRegisterBlockFact) -> Bool Never! {
    if {
        left.name != right.name -> left.name > right.name
        left.base != right.base -> left.base > right.base
        else -> left.size.bytes > right.size.bytes
    }
}

fn mir_digest_sort_target_blocks(rows: &[MIRTargetRegisterBlockFact]) Never! {
    loop index in 1..<rows.len() {
        current := rows[index]
        cursor := index - 1
        loop cursor >= 0 && mir_digest_target_block_after(rows[cursor], current) {
            rows[cursor + 1] = rows[cursor]
            cursor -= 1
        }
        rows[cursor + 1] = current
    }
}

fn mir_digest_target_interrupt_after(left: MIRTargetInterruptFact, right: MIRTargetInterruptFact) -> Bool Never! {
    if left.name != right.name -> left.name > right.name else -> left.vector > right.vector
}

fn mir_digest_sort_target_interrupts(rows: &[MIRTargetInterruptFact]) Never! {
    loop index in 1..<rows.len() {
        current := rows[index]
        cursor := index - 1
        loop cursor >= 0 && mir_digest_target_interrupt_after(rows[cursor], current) {
            rows[cursor + 1] = rows[cursor]
            cursor -= 1
        }
        rows[cursor + 1] = current
    }
}

fn mir_digest_target_channel_after(left: MIRTargetDMAChannelFact, right: MIRTargetDMAChannelFact) -> Bool Never! {
    if left.name != right.name -> return left.name > right.name
    if left.channel != right.channel -> return left.channel > right.channel
    left_width :: mir_digest_register_width(left.transfer_width)
    right_width :: mir_digest_register_width(right.transfer_width)
    if left_width != right_width -> return left_width > right_width
    left_ownership :: mir_digest_dma_ownership(left.ownership)
    right_ownership :: mir_digest_dma_ownership(right.ownership)
    if left_ownership != right_ownership -> return left_ownership > right_ownership
    mir_digest_option_int_order(left.max_transfer_bytes) > mir_digest_option_int_order(right.max_transfer_bytes)
}

fn mir_digest_sort_target_channels(rows: &[MIRTargetDMAChannelFact]) Never! {
    loop index in 1..<rows.len() {
        current := rows[index]
        cursor := index - 1
        loop cursor >= 0 && mir_digest_target_channel_after(rows[cursor], current) {
            rows[cursor + 1] = rows[cursor]
            cursor -= 1
        }
        rows[cursor + 1] = current
    }
}

fn mir_digest_option_int_order(value: Int?) -> Int Never! {
    value ?? -1
}

fn mir_digest_target_hardware_facts(writer: &MIRCanonicalWriter, value: MIRTargetHardwareFacts) Never! {
    if value.svd == {
        None -> mir_digest_bool(&writer, false)
        Val(svd) -> {
            mir_digest_bool(&writer, true)
            mir_digest_string(&writer, svd.source)
            mir_digest_string(&writer, svd.sha256)
        }
    }
    blocks := value.register_blocks
    mir_digest_sort_target_blocks(&blocks)
    mir_digest_len(&writer, blocks.len())
    loop block in blocks {
        mir_digest_string(&writer, block.name)
        mir_digest_u64(&writer, block.base)
        mir_digest_u64(&writer, block.size.bytes)
        registers := block.registers
        mir_digest_sort_target_registers(&registers)
        mir_digest_len(&writer, registers.len())
        loop register in registers {
            mir_digest_string(&writer, register.name)
            mir_digest_u64(&writer, register.offset)
            mir_digest_string(&writer, mir_digest_register_width(register.width))
            mir_digest_string(&writer, mir_digest_register_access_mode(register.access))
            mir_digest_bool(&writer, register.volatile)
        }
    }
    interrupts := value.interrupts
    mir_digest_sort_target_interrupts(&interrupts)
    mir_digest_len(&writer, interrupts.len())
    loop interrupt in interrupts {
        mir_digest_string(&writer, interrupt.name)
        mir_digest_u16(&writer, interrupt.vector)
        mir_digest_len(&writer, interrupt.forbidden_effects.len())
        loop effect_name in interrupt.forbidden_effects -> mir_digest_string(&writer, effect_name)
        mir_digest_bool(&writer, interrupt.bounded)
    }
    channels := value.dma_channels
    mir_digest_sort_target_channels(&channels)
    mir_digest_len(&writer, channels.len())
    loop channel in channels {
        mir_digest_string(&writer, channel.name)
        mir_digest_u16(&writer, channel.channel)
        mir_digest_string(&writer, mir_digest_register_width(channel.transfer_width))
        mir_digest_string(&writer, mir_digest_dma_ownership(channel.ownership))
        mir_digest_option_int(&writer, channel.max_transfer_bytes)
    }
}

fn mir_digest_target_hardware_use(writer: &MIRCanonicalWriter, value: MIRTargetHardwareUse) Never! {
    mir_digest_len(&writer, value.register_accesses.len())
    loop access in value.register_accesses {
        mir_digest_string(&writer, access.block)
        mir_digest_string(&writer, access.register)
        mir_digest_string(&writer, mir_digest_target_register_operation(access.operation))
        mir_digest_string(&writer, mir_digest_register_width(access.width))
    }
    mir_digest_len(&writer, value.interrupt_handlers.len())
    loop handler in value.interrupt_handlers {
        mir_digest_string(&writer, handler.interrupt)
        mir_digest_string(&writer, handler.handler)
        mir_digest_len(&writer, handler.effects.len())
        loop effect_name in handler.effects -> mir_digest_string(&writer, effect_name)
        mir_digest_len(&writer, handler.forbidden_effects.len())
        loop effect_name in handler.forbidden_effects -> mir_digest_string(&writer, effect_name)
        mir_digest_bool(&writer, handler.bounded)
    }
    mir_digest_len(&writer, value.dma_operations.len())
    loop operation in value.dma_operations {
        mir_digest_string(&writer, operation.channel)
        mir_digest_string(&writer, operation.buffer)
        mir_digest_string(&writer, mir_digest_target_dma_operation(operation.operation))
        mir_digest_string(&writer, mir_digest_target_dma_owner(operation.owner))
    }
    mir_digest_len(&writer, value.unresolved_references.len())
    loop reference in value.unresolved_references -> mir_digest_target_unresolved(&writer, reference)
}

fn mir_digest_runtime_layer(value: MIRRuntimeLayer) -> String Never! {
    if value == {
        .Core -> "core"
        .Alloc -> "alloc"
        .Std -> "std"
    }
}

fn mir_digest_cache_frame(bytes: &[U8], value: String) Never! {
    mir_digest_u64_bytes(&bytes, value.bytes().len())
    loop byte in value.bytes() -> &bytes.push(byte)
}

fn mir_digest_u64_bytes(bytes: &[U8], value: Int) Never! {
    loop index in 0..<8 {
        &bytes.push(U8{(value >> (8 * index)) & 255})
    }
}

fn mir_digest_target_dossier_bytes(value: MIRTargetDossier, target_triple: String) -> [U8] Never! {
    bytes := [U8]{}
    loop byte in "jet-target-dossier-v3".bytes() -> &bytes.push(byte)
    &bytes.push(U8{0})
    if value.machine == {
        None -> mir_digest_cache_frame(&bytes, "hosted-default")
        Val(machine) -> {
            mir_digest_cache_frame(&bytes, "selected-machine")
            mir_digest_cache_frame(&bytes, machine.name)
            mir_digest_cache_frame(&bytes, machine.triple)
            mir_digest_cache_frame(&bytes, value.provider_identity)
            mir_digest_cache_frame(&bytes, value.linker_identity)
        }
    }
    mir_digest_cache_frame(&bytes, target_triple)
    mir_digest_cache_frame(&bytes, mir_digest_runtime_layer(value.layer))
    mir_digest_cache_frame(&bytes, value.provider_identity)
    mir_digest_cache_frame(&bytes, value.closure_identity)
    mir_digest_cache_frame(&bytes, value.linker_identity)
    mir_digest_cache_frame(&bytes, value.tier_identity)
    mir_digest_cache_frame(&bytes, value.compiler_identity)
    mir_digest_cache_frame(&bytes, value.environment_identity)
    mir_digest_cache_frame(&bytes, value.dependency_identity)
    bytes
}

fn mir_digest_layout_support_default() -> MIRLayoutSupportFacts Never! {
    MIRLayoutSupportFacts{proven: false, alignments: [Int]{}, max_size: None, max_address: None, abi: None, provenance: ""}
}

fn mir_digest_app_string_list(writer: &MIRCanonicalWriter, values: [String]) Never! {
    mir_digest_len(&writer, values.len())
    loop value in values -> mir_digest_string(&writer, value)
}

fn mir_digest_app_route_fields(writer: &MIRCanonicalWriter, values: [MIRAppRouteField]) Never! {
    mir_digest_len(&writer, values.len())
    loop value in values {
        mir_digest_string(&writer, value.name)
        mir_digest_string(&writer, value.ty)
        mir_digest_string(&writer, value.codec)
        mir_digest_bool(&writer, value.required)
        mir_digest_option_string(&writer, value.default)
    }
}

fn mir_digest_app_render_mode(value: MIRAppRenderMode) -> String Never! {
    if value == {
        .CSR -> "csr"
        .SSR -> "ssr"
        .SSG -> "ssg"
        .Stream -> "stream"
        .Island -> "island"
    }
}

fn mir_digest_app_render_fact_mode(value: MIRAppRenderFactMode) -> String Never! {
    if value == {
        .Static -> "static"
        .Server -> "server"
        .ServerStream -> "server-stream"
        .ServerIsland -> "server-island"
        .Client -> "client"
    }
}

fn mir_digest_app_cache_fact(value: MIRAppCacheFact) -> String Never! {
    if value == {
        .Unspecified -> "unspecified"
        .Immutable -> "immutable"
        .Revalidate -> "revalidate"
        .Private -> "private"
    }
}

fn mir_digest_app_render_facts(writer: &MIRCanonicalWriter, value: MIRAppRenderFacts) Never! {
    mir_digest_string(&writer, mir_digest_app_render_fact_mode(value.mode))
    mir_digest_app_string_list(&writer, value.reason)
    mir_digest_app_string_list(&writer, value.effects)
    mir_digest_bool(&writer, value.interactive)
    mir_digest_option_string(&writer, value.loader)
    mir_digest_option_string(&writer, value.form)
    mir_digest_string(&writer, mir_digest_app_cache_fact(value.cache))
    mir_digest_option_string(&writer, value.override_mode.map(row -> mir_digest_app_render_fact_mode(row)))
    if value.island == {
        .Val(island) -> {
        mir_digest_bool(&writer, true)
        mir_digest_string(&writer, island.identity)
        mir_digest_bool(&writer, island.resume_payload.serializable)
        mir_digest_len(&writer, island.resume_payload.captures.len())
        loop capture in island.resume_payload.captures {
            mir_digest_string(&writer, capture.name)
            mir_digest_string(&writer, capture.ty)
            mir_digest_bool(&writer, capture.serializable)
        }
    }
    else -> {
        mir_digest_bool(&writer, false)
    }
}
}

fn mir_digest_app_graph(writer: &MIRCanonicalWriter, value: MIRAppGraph?) Never! {
    if value == {
        .Val(graph) -> {
        mir_digest_bool(&writer, true)
        mir_digest_string(&writer, graph.entry_file)
        mir_digest_string(&writer, graph.hydration)
        mir_digest_bool(&writer, graph.shared_tir)
        mir_digest_len(&writer, graph.routes.len())
        loop route in graph.routes {
            mir_digest_string(&writer, route.path)
            mir_digest_string(&writer, route.handler)
            mir_digest_string(&writer, route.route_identity)
            mir_digest_app_route_fields(&writer, route.path_params)
            mir_digest_app_route_fields(&writer, route.search_params)
            mir_digest_string(&writer, route.search_codec)
            if route.loader == {
                .Val(loader) -> {
                mir_digest_bool(&writer, true)
                mir_digest_string(&writer, loader.handler)
                mir_digest_string(&writer, loader.data_type)
                mir_digest_string(&writer, loader.dependency)
                mir_digest_bool(&writer, loader.preload)
                mir_digest_string(&writer, loader.cache_identity)
            }
            else -> {
                mir_digest_bool(&writer, false)
            }
        }
            mir_digest_option_string(&writer, route.boundaries.pending)
            mir_digest_option_string(&writer, route.boundaries.not_found)
            mir_digest_option_string(&writer, route.boundaries.error)
            mir_digest_string(&writer, route.precedence)
            mir_digest_string(&writer, mir_digest_app_render_mode(route.render))
            mir_digest_app_render_facts(&writer, route.render_facts)
            mir_digest_string(&writer, route.provenance)
            mir_digest_len(&writer, route.span_start)
            mir_digest_len(&writer, route.span_end)
        }
        mir_digest_len(&writer, graph.actions.len())
        loop action in graph.actions {
            mir_digest_string(&writer, action.name)
            mir_digest_string(&writer, action.handler)
            mir_digest_string(&writer, action.kind)
            mir_digest_string(&writer, action.provenance)
            mir_digest_len(&writer, action.span_start)
            mir_digest_len(&writer, action.span_end)
        }
        mir_digest_len(&writer, graph.mounts.len())
        loop mount in graph.mounts {
            mir_digest_string(&writer, mount.prefix)
            mir_digest_string(&writer, mount.handler)
            mir_digest_app_string_list(&writer, mount.effects)
            mir_digest_app_string_list(&writer, mount.security)
            mir_digest_string(&writer, mount.provenance)
            mir_digest_len(&writer, mount.span_start)
            mir_digest_len(&writer, mount.span_end)
        }
        mir_digest_len(&writer, graph.routes_from.len())
        loop root in graph.routes_from {
            mir_digest_string(&writer, root.root)
            mir_digest_len(&writer, root.span_start)
            mir_digest_len(&writer, root.span_end)
        }
        mir_digest_app_string_list(&writer, graph.policy.security)
        mir_digest_app_string_list(&writer, graph.policy.assets)
        mir_digest_app_string_list(&writer, graph.policy.split)
        mir_digest_app_string_list(&writer, graph.policy.cache)
        mir_digest_app_string_list(&writer, graph.policy.a11y)
        mir_digest_app_string_list(&writer, graph.policy.adapters)
    }
    else -> {
        mir_digest_bool(&writer, false)
    }
}
}

fn mir_digest_sort_modules(rows: &[MIRModule]) Never! {
    loop index in 1..<rows.len() {
        current := rows[index]
        cursor := index - 1
        loop cursor >= 0 && (rows[cursor].id.value > current.id.value || (rows[cursor].id.value == current.id.value && rows[cursor].key > current.key)) {
            rows[cursor + 1] = rows[cursor]
            cursor -= 1
        }
        rows[cursor + 1] = current
    }
}

