// Canonical MIR byte encoding and digest lanes.
//
// The writer is deliberately kept beside MIR rather than in an optimizer
// consumer.  It frames every scalar and row explicitly, and all collection
// order is established by the canonical row sorters below.  The public digest
// seam is added only after the complete schema row set is assembled.

use core.math as math

// A writer either collects the canonical bytes or, for the digest, feeds the
// four FNV-1a lanes as each byte is written, so a digest never materializes
// the byte list.
struct MIRCanonicalWriter {
    pub bytes: [U8]
    pub hashing: Bool
    pub lanes: [U64]
}

fn mir_digest_writer() -> MIRCanonicalWriter Never! {
    MIRCanonicalWriter{bytes: [U8]{}, hashing: false, lanes: [U64]{}}
}

fn mir_digest_hash_writer() -> MIRCanonicalWriter Never! {
    MIRCanonicalWriter{bytes: [U8]{}, hashing: true, lanes: [U64]{U64{0xcbf29ce484222325}, U64{0x84222325cbf29ce4}, U64{0x9e3779b185ebca87}, U64{0xd6e8feb86659fd93}}}
}

fn mir_digest_u8(writer: &MIRCanonicalWriter, value: U8) Never! {
    if writer.hashing {
        byte :: U64.from_u8(value)
        loop index in 0..<writer.lanes.len() {
            writer.lanes[index] = (writer.lanes[index] ~| byte).wrapping_mul(U64{0x100000001b3})
        }
    } else {
        &writer.bytes.push(value)
    }
}

fn mir_digest_u16(writer: &MIRCanonicalWriter, value: Int) Never! {
    mir_digest_u8(&writer, U8{value & 255})
    mir_digest_u8(&writer, U8{(value >> 8) & 255})
}

fn mir_digest_u64(writer: &MIRCanonicalWriter, value: Int) Never! {
    loop index in 0..<8 {
        mir_digest_u8(&writer, U8{(value >> (8 * index)) & 255})
    }
}

fn mir_digest_len(writer: &MIRCanonicalWriter, value: Int) Never! {
    mir_digest_u64(&writer, value)
}

fn mir_digest_bool(writer: &MIRCanonicalWriter, value: Bool) Never! {
    if value -> mir_digest_u8(&writer, U8{1}) else -> mir_digest_u8(&writer, U8{0})
}

fn mir_digest_string(writer: &MIRCanonicalWriter, value: String) Never! {
    bytes :: value.bytes()
    mir_digest_len(&writer, bytes.len())
    loop byte in bytes -> mir_digest_u8(&writer, byte)
}

fn mir_digest_tag(writer: &MIRCanonicalWriter, value: String) Never! {
    mir_digest_string(&writer, value)
}

fn mir_digest_bytes(writer: &MIRCanonicalWriter, value: [U8]) Never! {
    mir_digest_len(&writer, value.len())
    loop byte in value -> mir_digest_u8(&writer, byte)
}

fn mir_digest_span(writer: &MIRCanonicalWriter, span: Span) Never! {
    mir_digest_len(&writer, span.start)
    mir_digest_len(&writer, span.end)
}

fn mir_digest_option_int(writer: &MIRCanonicalWriter, value: Int?) Never! {
    if value == {
        None -> mir_digest_bool(&writer, false)
        Val(number) -> {
            mir_digest_bool(&writer, true)
            mir_digest_u64(&writer, number)
        }
    }
}

fn mir_digest_option_string(writer: &MIRCanonicalWriter, value: String?) Never! {
    if value == {
        None -> mir_digest_bool(&writer, false)
        Val(text) -> {
            mir_digest_bool(&writer, true)
            mir_digest_string(&writer, text)
        }
    }
}

fn mir_digest_option_type(writer: &MIRCanonicalWriter, value: MIRType?) Never! {
    if value == {
        None -> mir_digest_bool(&writer, false)
        Val(ty) -> {
            mir_digest_bool(&writer, true)
            mir_digest_type(&writer, ty)
        }
    }
}

fn mir_digest_debug_quote(value: String) -> String Never! {
    out := "\""
    loop byte in value.bytes() {
        code :: Int.from_u8(byte)
        if code == {
            34 -> out = "{out}\\\""
            92 -> out = "{out}\\\\"
            10 -> out = "{out}\\n"
            13 -> out = "{out}\\r"
            9 -> out = "{out}\\t"
            else -> {
                if code < 32 || code == 127 -> out = "{out}\\u{{{code}}}"
                else -> out = "{out}{String.from_bytes([byte]) ?? ""}"
            }
        }
    }
    "{out}\""
}

fn mir_digest_debug_bool(value: Bool) -> String Never! { if value -> "true" else -> "false" }

fn mir_digest_debug_option_string(value: String?) -> String Never! {
    text :: value ?? return "None"
    "Some({mir_digest_debug_quote(text)})"
}

fn mir_digest_debug_string_list(values: [String]) -> String Never! {
    rendered :: loop value in values -> mir_digest_debug_quote(value)
    "[{rendered.join(", ")}]"
}

fn mir_digest_debug_bool_list(values: [Bool]) -> String Never! {
    rendered :: loop value in values -> mir_digest_debug_bool(value)
    "[{rendered.join(", ")}]"
}

fn mir_digest_debug_int_option(value: Int?) -> String Never! {
    number :: value ?? return "None"
    "Some({number})"
}

fn mir_digest_access_debug(value: MIRAccess) -> String Never! {
    if value == {
        .Read -> "Read"
        .Write -> "Write"
        .Move -> "Move"
    }
}

fn mir_digest_visibility_debug(value: MIRVisibility) -> String Never! {
    if value == {
        .Private -> "Private"
        .Package -> "Package"
        .Public -> "Public"
    }
}

fn mir_digest_ownership_mode_debug(value: MIROwnershipMode) -> String Never! {
    if value == {
        .Copy -> "Copy"
        .Owned -> "Owned"
        .Shared -> "Shared"
        .ReadBorrow -> "ReadBorrow"
        .WriteBorrow -> "WriteBorrow"
        .Move -> "Move"
    }
}

fn mir_digest_drop_kind_debug(value: MIRDropKind) -> String Never! {
    if value == {
        .NoDrop -> "NoDrop"
        .Value -> "Value"
        .Shared -> "Shared"
        .View -> "View"
        .ForeignHandle -> "ForeignHandle"
    }
}

fn mir_digest_function_kind_debug(value: MIRFunctionKind) -> String Never! {
    if value == {
        .Jet -> "Jet"
        .Foreign -> "Foreign"
        .Test -> "Test"
    }
}

fn mir_digest_ownership_debug(value: MIROwnership) -> String Never! {
    "MirOwnership {{ mode: {mir_digest_ownership_mode_debug(value.mode)}, drop: {mir_digest_drop_kind_debug(value.drop)}, moved: {mir_digest_debug_bool(value.moved)}, last_use: {mir_digest_debug_bool(value.last_use)}, gc_root: {mir_digest_debug_bool(value.gc_root)} }}"
}

fn mir_digest_scalar_kind_debug(value: MIRScalarKind) -> String Never! {
    if value == {
        .Int -> "Int"
        .Float -> "Float"
        .Float32 -> "Float32"
        .Bool -> "Bool"
        .Char -> "Char"
        .Pointer -> "Pointer"
    }
}

fn mir_digest_abi_debug(value: MIRABI) -> String Never! {
    if value == {
        .Scalar(kind) -> "Scalar({mir_digest_scalar_kind_debug(kind)})"
        .Aggregate -> "Aggregate"
        .Sequence -> "Sequence"
        .Function -> "Function"
        .Nominal -> "Nominal"
        .Dynamic -> "Dynamic"
        .Never -> "Never"
    }
}

fn mir_digest_size_debug(value: MIRSize) -> String Never! {
    if value == {
        .Static(bytes) -> "Static({bytes})"
        .Dynamic -> "Dynamic"
    }
}

fn mir_digest_layout_debug(value: MIRLayout) -> String Never! {
    "MirLayout {{ abi: {mir_digest_abi_debug(value.abi)}, size: {mir_digest_size_debug(value.size)}, align: {mir_digest_size_debug(value.align)} }}"
}

fn mir_digest_measure_debug(value: MIRMeasure) -> String Never! {
    if value == {
        .Literal(kind, amount) -> "Literal({mir_digest_debug_quote(kind)}, {amount})"
        .SignedLiteral(kind, amount) -> "SignedLiteral({mir_digest_debug_quote(kind)}, {amount})"
        .Symbol(kind, name) -> "Symbol({mir_digest_debug_quote(kind)}, {mir_digest_debug_quote(name)})"
        .Combined(kind, rule, left, right) -> "Combined({mir_digest_debug_quote(kind)}, {mir_digest_measure_rule_debug(rule)}, {mir_digest_measure_debug(left)}, {mir_digest_measure_debug(right)})"
    }
}

fn mir_digest_measure_rule_debug(value: MIRMeasureRule) -> String Never! {
    if value == {
        .Add -> "Add"
        .Mul -> "Mul"
        .Match -> "Match"
    }
}

fn mir_digest_dimension_debug(value: MIRDimension) -> String Never! {
    rendered :: loop axis in value.axes -> "MirDimensionAxis {{ name: {mir_digest_debug_quote(axis.name)}, exponent: {mir_digest_measure_debug(axis.exponent)} }}"
    "MirDimension {{ axes: [{rendered.join(", ")}] }}"
}

fn mir_digest_tag_marker_debug(value: MIRTagMarker) -> String Never! {
    if value == {
        .User(name) -> "User({mir_digest_debug_quote(name)})"
        .Internal(marker_tag) -> "Internal({mir_digest_internal_tag_debug(marker_tag)})"
    }
}

fn mir_digest_internal_tag_debug(value: MIRInternalTag) -> String Never! {
    if value == {
        .CoreCryptoNominal -> "CoreCryptoNominal"
        .DeterministicClock -> "DeterministicClock"
        .SystemClock -> "SystemClock"
        .ExpiringSecretLoan -> "ExpiringSecretLoan"
        .SharedGuardRead -> "SharedGuardRead"
        .SharedGuardEdit -> "SharedGuardEdit"
        .TerminalFactSet -> "TerminalFactSet"
        .CppCallbackABI -> "CppCallbackAbi"
        .AllocatorView -> "AllocatorView"
    }
}

fn mir_digest_param_zone_debug(value: ParamZone) -> String Never! {
    if value == {
        .PositionalOnly -> "PositionalOnly"
        .Either -> "Either"
        .LabelOnly -> "LabelOnly"
    }
}

fn mir_digest_call_contract_debug(value: MIRCallContractRow) -> String Never! {
    "MirCallContractRow {{ label: {mir_digest_debug_quote(value.label)}, zone: {mir_digest_param_zone_debug(value.zone)} }}"
}

fn mir_digest_policy_debug(value: MIRCallablePolicy) -> String Never! {
    "MirCallablePolicy {{ name: {mir_digest_debug_quote(value.name)}, arguments: {mir_digest_debug_string_list(value.arguments)} }}"
}

fn mir_digest_policy_chain_debug(value: MIRCallablePolicyChain) -> String Never! {
    rendered :: loop policy in value.policies -> mir_digest_policy_debug(policy)
    "MirCallablePolicyChain {{ policies: [{rendered.join(", ")}] }}"
}

fn mir_digest_call_metadata_debug(value: MIRCallMetadata) -> String Never! {
    conventions :: loop row in value.conventions -> mir_digest_access_debug(row)
    "MirCallMetadata {{ names: {mir_digest_debug_string_list(value.names)}, defaults: {mir_digest_debug_bool_list(value.defaults)}, variadic: {mir_digest_debug_bool_list(value.variadic)}, conventions: [{conventions.join(", ")}], policies: {mir_digest_policy_chain_debug(value.policies)} }}"
}

fn mir_digest_call_contracts_debug(value: [MIRCallContractRow]?) -> String Never! {
    rows :: value ?? return "None"
    rendered :: loop row in rows -> mir_digest_call_contract_debug(row)
    "Some([{rendered.join(", ")}])"
}

fn mir_digest_view_provenance_entry_debug(value: MIRViewProvenanceEntry) -> String Never! {
    "MirViewProvenanceEntry {{ slot: {mir_digest_debug_string_list(value.slot)}, provenance: {mir_digest_view_provenance_debug(value.provenance)} }}"
}

fn mir_digest_view_provenance_debug(value: MIRViewProvenance) -> String Never! {
    sources :: loop source in value.sources -> mir_digest_view_source_path_debug(source)
    "MirViewProvenance {{ sources: [{sources.join(", ")}], mutable: {mir_digest_debug_bool(value.mutable)} }}"
}

fn mir_digest_view_source_path_debug(value: MIRViewSourcePath) -> String Never! {
    projections :: loop projection in value.projections -> mir_digest_view_projection_debug(projection)
    "MirViewSourcePath {{ source: {mir_digest_view_source_debug(value.source)}, projections: [{projections.join(", ")}] }}"
}

fn mir_digest_view_source_debug(value: MIRViewSource) -> String Never! {
    if value == {
        .Receiver -> "Receiver"
        .Parameter(index) -> "Parameter({index})"
        .Static(module_path, name) -> "Static({mir_digest_debug_quote(module_path)}, {mir_digest_debug_quote(name)})"
    }
}

fn mir_digest_view_projection_debug(value: MIRViewProjection) -> String Never! {
    if value == {
        .Field(name) -> "Field({mir_digest_debug_quote(name)})"
        .Index -> "Index"
        .Range -> "Range"
    }
}

fn mir_digest_view_provenance_option_debug(value: [MIRViewProvenanceEntry]?) -> String Never! {
    rows :: value ?? return "None"
    rendered :: loop row in rows -> mir_digest_view_provenance_entry_debug(row)
    "Some([{rendered.join(", ")}])"
}

fn mir_digest_function_signature_effect_debug(value: [String]?) -> String Never! {
    effects :: value ?? return "None"
    "Some({mir_digest_debug_string_list(effects)})"
}

fn mir_digest_type_kind(writer: &MIRCanonicalWriter, value: MIRTypeKind) Never! {
    if value == {
        .Int -> mir_digest_tag(&writer, "int")
        .Float -> mir_digest_tag(&writer, "float")
        .Bool -> mir_digest_tag(&writer, "bool")
        .String -> mir_digest_tag(&writer, "string")
        .Char -> mir_digest_tag(&writer, "char")
        .List(inner) -> {
            mir_digest_tag(&writer, "list")
            mir_digest_type(&writer, inner)
        }
        .Map(key, map_value) -> {
            mir_digest_tag(&writer, "map")
            mir_digest_type(&writer, key)
            mir_digest_type(&writer, map_value)
        }
        .Shared(inner) -> {
            mir_digest_tag(&writer, "shared")
            mir_digest_type(&writer, inner)
        }
        .Option(inner) -> {
            mir_digest_tag(&writer, "option")
            mir_digest_type(&writer, inner)
        }
        .Result(ok, err) -> {
            mir_digest_tag(&writer, "result")
            mir_digest_type(&writer, ok)
            mir_digest_type(&writer, err)
        }
        .Fn(signature) -> {
            mir_digest_tag(&writer, "fn")
            mir_digest_len(&writer, signature.params.len())
            loop param in signature.params -> mir_digest_type(&writer, param)
            if signature.ret == {
                .Val(returned) -> {
                mir_digest_tag(&writer, "ret")
                mir_digest_type(&writer, returned)
                }
                else -> {
                mir_digest_tag(&writer, "unit-ret")
                }
            }
            mir_digest_string(&writer, mir_digest_function_signature_effect_debug(signature.effect_bound))
            mir_digest_string(&writer, mir_digest_call_contracts_debug(signature.param_contract))
            metadata := "None"
            if signature.call_metadata == .Val(row) {
                metadata = "Some({mir_digest_call_metadata_debug(row)})"
            }
            mir_digest_string(&writer, metadata)
            mir_digest_string(&writer, mir_digest_view_provenance_option_debug(signature.return_view_provenance))
        }
        .SendFn(params, ret, conventions) -> {
            mir_digest_tag(&writer, "send-fn")
            mir_digest_len(&writer, params.len())
            loop param in params -> mir_digest_type(&writer, param)
            if ret == {
                .Val(returned) -> {
                mir_digest_tag(&writer, "ret")
                mir_digest_type(&writer, returned)
                }
                else -> {
                mir_digest_tag(&writer, "unit-ret")
                }
            }
            rendered :: loop convention in conventions -> mir_digest_access_debug(convention)
            mir_digest_string(&writer, "[{rendered.join(", ")}]")
        }
        .Apply(name, args) -> {
            mir_digest_tag(&writer, "apply")
            mir_digest_u64(&writer, name.id.value)
            mir_digest_len(&writer, args.len())
            loop arg in args -> mir_digest_type(&writer, arg)
        }
        .TraitObject(bounds) -> {
            mir_digest_tag(&writer, "trait-object")
            mir_digest_len(&writer, bounds.len())
            loop bound in bounds -> mir_digest_u64(&writer, bound.id.value)
        }
        .Tuple(fields) -> {
            mir_digest_tag(&writer, "tuple")
            mir_digest_len(&writer, fields.len())
            loop field in fields {
                mir_digest_string(&writer, field.name)
                mir_digest_type(&writer, field.ty)
            }
        }
        .FixedList(elem, len) -> {
            mir_digest_tag(&writer, "fixed-list")
            mir_digest_type(&writer, elem)
            mir_digest_string(&writer, mir_digest_measure_debug(len))
        }
        .IntN(signed, bits) -> {
            mir_digest_tag(&writer, "int-n")
            mir_digest_bool(&writer, signed)
            mir_digest_u64(&writer, bits)
        }
        .InlineRange(base, lo, hi) -> {
            mir_digest_tag(&writer, "inline-range")
            mir_digest_type(&writer, base)
            mir_digest_u64(&writer, lo)
            mir_digest_u64(&writer, hi)
        }
        .Float32 -> mir_digest_tag(&writer, "float32")
        .Tagged(marker, inner) -> {
            mir_digest_tag(&writer, "tagged")
            mir_digest_string(&writer, mir_digest_tag_marker_debug(marker))
            mir_digest_type(&writer, inner)
        }
        .Union(members) -> {
            mir_digest_tag(&writer, "union")
            mir_digest_len(&writer, members.len())
            loop member in members -> mir_digest_type(&writer, member)
        }
        .Quantity(base, dimension) -> {
            mir_digest_tag(&writer, "quantity")
            mir_digest_type(&writer, base)
            mir_digest_string(&writer, mir_digest_dimension_debug(dimension))
        }
        .Measure(measure) -> {
            mir_digest_tag(&writer, "measure")
            mir_digest_string(&writer, mir_digest_measure_debug(measure))
        }
    }
}

fn mir_digest_type(writer: &MIRCanonicalWriter, value: MIRType) Never! {
    mir_digest_tag(&writer, "mir-type")
    mir_digest_option_int(&writer, value.identity.map(row -> row.value))
    mir_digest_type_kind(&writer, value.kind)
    mir_digest_string(&writer, mir_digest_layout_debug(value.layout))
}

fn mir_digest_values(writer: &MIRCanonicalWriter, values: [MIRValueID]) Never! {
    mir_digest_len(&writer, values.len())
    loop value in values -> mir_digest_u64(&writer, value.value)
}

fn mir_digest_field_path(writer: &MIRCanonicalWriter, path: [MIRFieldID]) Never! {
    mir_digest_len(&writer, path.len())
    loop field in path -> mir_digest_u64(&writer, field.value)
}

fn mir_digest_field_paths(writer: &MIRCanonicalWriter, paths: [[MIRFieldID]]) Never! {
    mir_digest_len(&writer, paths.len())
    loop path in paths -> mir_digest_field_path(&writer, path)
}

fn mir_digest_access_option(writer: &MIRCanonicalWriter, access: MIRAccess?) Never! {
    if access == {
        .Val(access_value) -> {
        if access_value == {
            .Read -> mir_digest_u64(&writer, 1)
            .Write -> mir_digest_u64(&writer, 2)
            else -> mir_digest_u64(&writer, 3)
        }
        }
        else -> {
        mir_digest_u64(&writer, 0)
        }
    }
}

fn mir_digest_visibility(writer: &MIRCanonicalWriter, value: MIRVisibility) Never! {
    if value == {
        .Private -> mir_digest_u64(&writer, 1)
        .Package -> mir_digest_u64(&writer, 2)
        .Public -> mir_digest_u64(&writer, 3)
    }
}

fn mir_digest_failure_carrier(writer: &MIRCanonicalWriter, value: MIRFailureCarrier) Never! {
    if value == {
        .Infallible -> mir_digest_tag(&writer, "infallible")
        .Result(success, error) -> {
            mir_digest_tag(&writer, "result")
            mir_digest_type(&writer, success)
            mir_digest_type(&writer, error)
        }
        .Optional(inner) -> {
            mir_digest_tag(&writer, "optional")
            mir_digest_type(&writer, inner)
        }
        .Diverges(inner) -> {
            mir_digest_tag(&writer, "diverges")
            mir_digest_type(&writer, inner)
        }
    }
}

fn mir_digest_call_fallibility(writer: &MIRCanonicalWriter, value: MIRCallFallibility) Never! {
    if value == {
        .Infallible -> mir_digest_tag(&writer, "infallible")
        .Failure(carrier) -> {
            mir_digest_tag(&writer, "failure")
            mir_digest_failure_carrier(&writer, carrier)
        }
    }
}

fn mir_digest_callee(writer: &MIRCanonicalWriter, value: MIRCallee) Never! {
    if value == {
        .User(function) -> {
            mir_digest_tag(&writer, "user")
            mir_digest_u64(&writer, function.value)
        }
        .Associated(function, owner) -> {
            mir_digest_tag(&writer, "associated")
            mir_digest_u64(&writer, function.value)
            mir_digest_type(&writer, owner)
        }
        .Method(function, owner) -> {
            mir_digest_tag(&writer, "method")
            mir_digest_u64(&writer, function.value)
            mir_digest_type(&writer, owner)
        }
        .TraitMethod(method, trait_ref, receiver) -> {
            mir_digest_tag(&writer, "trait_method")
            mir_digest_u64(&writer, method.value)
            mir_digest_u64(&writer, trait_ref.id.value)
            mir_digest_string(&writer, trait_ref.name)
            mir_digest_type(&writer, receiver)
        }
        .Core(call) -> {
            mir_digest_tag(&writer, "core")
            mir_digest_u64(&writer, call.value)
        }
        .Prelude(call) -> {
            mir_digest_tag(&writer, "prelude")
            mir_digest_u64(&writer, call.value)
        }
        .Foreign(id) -> {
            mir_digest_tag(&writer, "foreign")
            mir_digest_u64(&writer, id.value)
        }
        .Indirect(callee) -> {
            mir_digest_tag(&writer, "indirect")
            mir_digest_u64(&writer, callee.value)
        }
    }
}

fn mir_digest_debug_u8_list(value: [U8]) -> String Never! {
    rendered :: loop byte in value -> "{Int.from_u8(byte)}"
    "[{rendered.join(", ")}]"
}

fn mir_digest_panic_location(writer: &MIRCanonicalWriter, value: MIRPanicLoc) Never! {
    mir_digest_u64(&writer, value.file.value)
    mir_digest_u64(&writer, value.line)
    mir_digest_u64(&writer, value.column)
}

fn mir_digest_panic_context(writer: &MIRCanonicalWriter, value: MIRPanicContext) Never! {
    mir_digest_string(&writer, value.function)
    mir_digest_string(&writer, value.source_line)
    mir_digest_u64(&writer, value.caret)
    mir_digest_len(&writer, value.locals.len())
    loop local in value.locals {
        mir_digest_string(&writer, local.name)
        mir_digest_u64(&writer, local.local.value)
    }
}

fn mir_digest_call_args(writer: &MIRCanonicalWriter, args: [MIRCallArg]) Never! {
    mir_digest_len(&writer, args.len())
    loop arg in args {
        mir_digest_u64(&writer, arg.value.value)
        mir_digest_option_int(&writer, arg.place.map(row -> row.value))
        mir_digest_string(&writer, mir_digest_access_debug(arg.access))
        mir_digest_span(&writer, arg.span)
        mir_digest_option_string(&writer, arg.label)
        mir_digest_option_int(&writer, arg.source_index)
        mir_digest_option_int(&writer, arg.binder_slot)
        mir_digest_bool(&writer, arg.spread)
        mir_digest_bool(&writer, arg.implicit_clone)
        mir_digest_bool(&writer, arg.shared_auto_clone)
        mir_digest_bool(&writer, arg.owned_last_use)
        mir_digest_bool(&writer, arg.authority_boundary)
        if arg.fn_coercion == {
            None -> mir_digest_bool(&writer, false)
            Val(coercion) -> {
                mir_digest_bool(&writer, true)
                mir_digest_type(&writer, coercion.ty)
                mir_digest_bool(&writer, coercion.already_boxed)
            }
        }
        mir_digest_bool(&writer, arg.widen_fixed_to_list)
        if arg.widen_to_union == {
            None -> mir_digest_bool(&writer, false)
            Val(coercion) -> {
                mir_digest_bool(&writer, true)
                mir_digest_u64(&writer, coercion.union.value)
                mir_digest_string(&writer, coercion.variant)
            }
        }
        mir_digest_option_int(&writer, arg.box_as_trait.map(row -> row.value))
    }
}

fn mir_digest_conversion(writer: &MIRCanonicalWriter, value: MIRConversion) Never! {
    if value == {
        .Transparent -> mir_digest_tag(&writer, "transparent")
        .NumericCast -> mir_digest_tag(&writer, "numeric-cast")
        .SendFn -> mir_digest_tag(&writer, "send-fn")
        .Prelude(call, location, fallibility) -> {
            mir_digest_tag(&writer, "prelude")
            mir_digest_u64(&writer, call.value)
            mir_digest_string(&writer, mir_digest_panic_location_debug(location))
            mir_digest_call_fallibility(&writer, fallibility)
        }
    }
}

fn mir_digest_panic_location_debug(value: MIRPanicLoc) -> String Never! {
    "MirPanicLoc {{ file: MirSourceFileId {{ value: {value.file.value} }}, line: {value.line}, column: {value.column} }}"
}

fn mir_digest_loop_source_kind(writer: &MIRCanonicalWriter, value: MIRLoopSourceKind) Never! {
    if value == {
        .Plain -> mir_digest_tag(&writer, "plain")
        .Chars -> mir_digest_tag(&writer, "chars")
        .LinesFile -> mir_digest_tag(&writer, "lines-file")
        .LinesStdin -> mir_digest_tag(&writer, "lines-stdin")
        .LinesProcessStream -> mir_digest_tag(&writer, "lines-process-stream")
        .ChannelReceiver -> mir_digest_tag(&writer, "channel-receiver")
        .EncodingReader(reader_type) -> {
            mir_digest_tag(&writer, "encoding-reader")
            mir_digest_string(&writer, reader_type)
        }
        .Iterable(coll_type, iter_type, iter_symbol, next_symbol) -> {
            mir_digest_tag(&writer, "iterable")
            mir_digest_string(&writer, coll_type)
            mir_digest_string(&writer, iter_type)
            mir_digest_string(&writer, iter_symbol)
            mir_digest_string(&writer, next_symbol)
        }
    }
}

fn mir_digest_text_hole_kind(writer: &MIRCanonicalWriter, value: MIRTextHoleKind) Never! {
    if value == {
        .Text -> mir_digest_u64(&writer, 1)
        .Int -> mir_digest_u64(&writer, 2)
        .Float -> mir_digest_u64(&writer, 3)
        .Bool -> mir_digest_u64(&writer, 4)
        .InlineRange(lo, hi) -> {
            mir_digest_u64(&writer, 5)
            mir_digest_u64(&writer, lo)
            mir_digest_u64(&writer, hi)
        }
    }
}

fn mir_digest_text_pattern_parts(writer: &MIRCanonicalWriter, values: [MIRTextPatternPart]) Never! {
    mir_digest_len(&writer, values.len())
    loop value in values {
        if value == {
            .Literal(text) -> {
                mir_digest_tag(&writer, "literal")
                mir_digest_string(&writer, text)
            }
            .Hole(kind, ty, span) -> {
                mir_digest_tag(&writer, "hole")
                mir_digest_text_hole_kind(&writer, kind)
                mir_digest_u64(&writer, ty.value)
                mir_digest_span(&writer, span)
            }
        }
    }
}

fn mir_digest_binary_pattern_parts(writer: &MIRCanonicalWriter, values: [MIRBinaryPatternPart]) Never! {
    mir_digest_len(&writer, values.len())
    loop value in values {
        if value == {
            .Literal(bytes) -> {
                mir_digest_tag(&writer, "literal")
                mir_digest_string(&writer, mir_digest_debug_u8_list(bytes))
            }
            .Bits(width, ty, little, span) -> {
                mir_digest_tag(&writer, "bits")
                mir_digest_u64(&writer, Int.from_u8(width))
                mir_digest_u64(&writer, ty.value)
                mir_digest_bool(&writer, little)
                mir_digest_span(&writer, span)
            }
            .Rest(ty, span) -> {
                mir_digest_tag(&writer, "rest")
                mir_digest_u64(&writer, ty.value)
                mir_digest_span(&writer, span)
            }
        }
    }
}

fn mir_digest_component_type(writer: &MIRCanonicalWriter, value: MIRComponentTypeDescriptor) Never! {
    if value == {
        .Int -> mir_digest_tag(&writer, "int")
        .Float -> mir_digest_tag(&writer, "float")
        .Bool -> mir_digest_tag(&writer, "bool")
        .String -> mir_digest_tag(&writer, "string")
        .List(inner) -> {
            mir_digest_tag(&writer, "list")
            mir_digest_component_type(&writer, inner)
        }
        .Option(inner) -> {
            mir_digest_tag(&writer, "option")
            mir_digest_component_type(&writer, inner)
        }
        .Result(ok, err) -> {
            mir_digest_tag(&writer, "result")
            mir_digest_component_type(&writer, ok)
            mir_digest_component_type(&writer, err)
        }
        .Record(name, fields) -> {
            mir_digest_tag(&writer, "record")
            mir_digest_string(&writer, name)
            mir_digest_len(&writer, fields.len())
            loop field in fields {
                mir_digest_len(&writer, field.index)
                mir_digest_string(&writer, field.name)
                mir_digest_component_type(&writer, field.ty)
            }
        }
    }
}

fn mir_digest_component_signature(writer: &MIRCanonicalWriter, value: MIRComponentSignatureDescriptor) Never! {
    mir_digest_tag(&writer, "component-signature")
    mir_digest_len(&writer, value.params.len())
    loop param in value.params -> mir_digest_component_type(&writer, param)
    mir_digest_component_type(&writer, value.result)
}

fn mir_digest_hardware_op(writer: &MIRCanonicalWriter, value: MIRHardwareOp) Never! {
    if value == {
        .RegisterRead(profile, block, register, width)
        | .RegisterWrite(profile, block, register, width) -> {
            mir_digest_tag(&writer, if value == {
                .RegisterRead(_, _, _, _) -> "register-read"
                else -> "register-write"
            })
            mir_digest_string(&writer, profile)
            mir_digest_string(&writer, block)
            mir_digest_string(&writer, register)
            mir_digest_string(&writer, if width == {
                .U8 -> "u8"
                .U16 -> "u16"
                .U32 -> "u32"
                .U64 -> "u64"
            })
        }
        .DMAStart(profile, channel, buffer_type)
        | .DMAWait(profile, channel, buffer_type) -> {
            mir_digest_tag(&writer, if value == {
                .DMAStart(_, _, _) -> "dma-start"
                else -> "dma-wait"
            })
            mir_digest_string(&writer, profile)
            mir_digest_string(&writer, channel)
            mir_digest_type(&writer, buffer_type)
        }
    }
}

fn mir_digest_struct_extra(writer: &MIRCanonicalWriter, value: MIRStructExtra?) Never! {
    if value == None -> mir_digest_u64(&writer, 0) else -> mir_digest_u64(&writer, 1)
}

fn mir_digest_require_kind(writer: &MIRCanonicalWriter, value: MIRRequireKind) Never! {
    if value == {
        .Require -> mir_digest_u64(&writer, 1)
        .RequireEq -> mir_digest_u64(&writer, 2)
        .Panic -> mir_digest_u64(&writer, 3)
    }
}

fn mir_digest_layout_compare(writer: &MIRCanonicalWriter, value: MIRLayoutCompareOp) Never! {
    if value == {
        .Equal -> mir_digest_u64(&writer, 1)
        .LessEqual -> mir_digest_u64(&writer, 2)
        .GreaterEqual -> mir_digest_u64(&writer, 3)
    }
}

fn mir_digest_allocator(writer: &MIRCanonicalWriter, value: MIRAllocatorKind) Never! {
    if value == {
        .Arena -> mir_digest_u64(&writer, 1)
        .Bump -> mir_digest_u64(&writer, 3)
        .Pool -> mir_digest_u64(&writer, 4)
        .Fixed -> mir_digest_u64(&writer, 2)
    }
}

fn mir_digest_task_group(writer: &MIRCanonicalWriter, value: MIRTaskGroupKind) Never! {
    if value == {
        .All -> mir_digest_u64(&writer, 1)
        .Any -> mir_digest_u64(&writer, 2)
        .Race -> mir_digest_u64(&writer, 3)
    }
}

fn mir_digest_select(writer: &MIRCanonicalWriter, value: MIRSelectKind) Never! {
    if value == {
        .Start -> mir_digest_u64(&writer, 1)
        .Receive -> mir_digest_u64(&writer, 2)
        .After -> mir_digest_u64(&writer, 3)
        .Wait -> mir_digest_u64(&writer, 4)
    }
}

fn mir_digest_core_closure(writer: &MIRCanonicalWriter, value: MIRCoreClosureKind) Never! {
    if value == {
        .Spawn -> mir_digest_u64(&writer, 1)
        .Serve -> mir_digest_u64(&writer, 2)
        .OnInterrupt -> mir_digest_u64(&writer, 3)
        .Guard -> mir_digest_u64(&writer, 4)
        .OnCommit -> mir_digest_u64(&writer, 5)
        .OnRollback -> mir_digest_u64(&writer, 6)
        .ReactiveDerived -> mir_digest_u64(&writer, 7)
        .ReactiveEffect -> mir_digest_u64(&writer, 8)
        .UIMount -> mir_digest_u64(&writer, 9)
        .UIAction -> mir_digest_u64(&writer, 10)
        .Realtime -> mir_digest_u64(&writer, 11)
        .UITextInputOnDrop -> mir_digest_u64(&writer, 12)
        .UIPreview(playground, source_file, source_span, source_start_line, source_start_column, source_end_line, source_end_column, build_id, revision) -> {
            mir_digest_u64(&writer, 13)
            mir_digest_bool(&writer, playground)
            mir_digest_string(&writer, source_file)
            mir_digest_span(&writer, source_span)
            mir_digest_u64(&writer, source_start_line)
            mir_digest_u64(&writer, source_start_column)
            mir_digest_u64(&writer, source_end_line)
            mir_digest_u64(&writer, source_end_column)
            mir_digest_string(&writer, build_id)
            mir_digest_string(&writer, revision)
        }
    }
}

fn mir_digest_gc_edit(writer: &MIRCanonicalWriter, value: MIRGCEditKind) Never! {
    if value == {
        .Clear -> mir_digest_u64(&writer, 1)
        .Pop -> mir_digest_u64(&writer, 2)
        .RemoveIndex -> mir_digest_u64(&writer, 3)
        .InsertIndex -> mir_digest_u64(&writer, 4)
        .Prepend -> mir_digest_u64(&writer, 5)
        .Additive -> mir_digest_u64(&writer, 6)
        .Plain -> mir_digest_u64(&writer, 7)
        .EdgeSlot -> mir_digest_u64(&writer, 8)
    }
}

fn mir_digest_typed_head(writer: &MIRCanonicalWriter, value: MIRTypedHeadKind) Never! {
    if value == {
        .SQL -> mir_digest_u64(&writer, 1)
        .HTML -> mir_digest_u64(&writer, 2)
        .Sh -> mir_digest_u64(&writer, 3)
        .URL -> mir_digest_u64(&writer, 4)
        .Path -> mir_digest_u64(&writer, 5)
        .DateTime -> mir_digest_u64(&writer, 6)
    }
}

fn mir_digest_semantic_operation(writer: &MIRCanonicalWriter, value: MIRSemanticOp) Never! {
    if value == {
        .DataEntriesToMap(call, local) -> {
            mir_digest_tag(&writer, "data-entries-to-map")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, local.value)
        }
        .MathBuiltin(type_id, call, args)
        | .PreciseBuiltin(type_id, call, args) -> {
            mir_digest_tag(&writer, if value == {
                .MathBuiltin(_, _, _) -> "math-builtin"
                else -> "precise-builtin"
            })
            mir_digest_u64(&writer, type_id.value)
            mir_digest_u64(&writer, call.value)
            mir_digest_values(&writer, args)
        }
        .Print(call, printed) -> {
            mir_digest_tag(&writer, "print")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, printed.value)
        }
        .AmbientInput(call, prompt) -> {
            mir_digest_tag(&writer, "ambient-input")
            mir_digest_u64(&writer, call.value)
            mir_digest_option_int(&writer, prompt.map(row -> row.value))
        }
        .RequireStop(call, kind, condition, location, context, values, always_stops) -> {
            mir_digest_tag(&writer, "require-stop")
            mir_digest_u64(&writer, call.value)
            mir_digest_require_kind(&writer, kind)
            mir_digest_option_int(&writer, condition.map(row -> row.value))
            mir_digest_panic_location(&writer, location)
            mir_digest_panic_context(&writer, context)
            mir_digest_values(&writer, values)
            mir_digest_bool(&writer, always_stops)
        }
        .LayoutCompare(call, op, left, right) -> {
            mir_digest_tag(&writer, "layout-compare")
            mir_digest_u64(&writer, call.value)
            mir_digest_layout_compare(&writer, op)
            mir_digest_u64(&writer, left.value)
            mir_digest_u64(&writer, right.value)
        }
        .LayoutLiteral(inner) -> {
            mir_digest_tag(&writer, "layout-literal")
            mir_digest_u64(&writer, inner.value)
        }
        .StructLiteral(type_id, fields, extra, trait_coercion, boxed_fields) -> {
            mir_digest_tag(&writer, "struct-literal")
            mir_digest_u64(&writer, type_id.value)
            mir_digest_len(&writer, fields.len())
            loop field in fields {
                mir_digest_u64(&writer, field.field.value)
                mir_digest_u64(&writer, field.value.value)
            }
            mir_digest_struct_extra(&writer, extra)
            mir_digest_option_int(&writer, trait_coercion.map(row -> row.value))
            mir_digest_len(&writer, boxed_fields.len())
            loop field in boxed_fields -> mir_digest_u64(&writer, field.value)
        }
        .ReflectOf(type_name, path, display, fields) -> {
            mir_digest_tag(&writer, "reflect-of")
            mir_digest_string(&writer, type_name)
            mir_digest_string(&writer, path)
            mir_digest_u64(&writer, display.value)
            mir_digest_len(&writer, fields.len())
            loop field in fields {
                mir_digest_string(&writer, field.name)
                mir_digest_string(&writer, field.type_name)
                mir_digest_string(&writer, field.path)
                mir_digest_u64(&writer, field.value.value)
            }
        }
        .CellGuardProject(map_call, split_call, guard, paths, editable, disjoint) -> {
            mir_digest_tag(&writer, "cell-guard-project")
            mir_digest_u64(&writer, map_call.value)
            mir_digest_option_int(&writer, split_call.map(row -> row.value))
            mir_digest_u64(&writer, guard.value)
            mir_digest_field_paths(&writer, paths)
            mir_digest_bool(&writer, editable)
            mir_digest_bool(&writer, disjoint)
        }
        .SharedGuardMap(call, guard, path, editable) -> {
            mir_digest_tag(&writer, "shared-guard-map")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, guard.value)
            mir_digest_field_path(&writer, path)
            mir_digest_bool(&writer, editable)
        }
        .SharedGuardSplit(call, map_call, guard, first, second, editable) -> {
            mir_digest_tag(&writer, "shared-guard-split")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, map_call.value)
            mir_digest_u64(&writer, guard.value)
            mir_digest_len(&writer, 2)
            mir_digest_field_path(&writer, first)
            mir_digest_field_path(&writer, second)
            mir_digest_bool(&writer, editable)
        }
        .SharedGuardWait(call, guard, condition, predicate) -> {
            mir_digest_tag(&writer, "shared-guard-wait")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, guard.value)
            mir_digest_u64(&writer, condition.value)
            mir_digest_u64(&writer, predicate.value)
        }
        .ConditionNotify(call, condition, all) -> {
            mir_digest_tag(&writer, "condition-notify")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, condition.value)
            mir_digest_bool(&writer, all)
        }
        .AllocNew(call, kind, inline_size, args) -> {
            mir_digest_tag(&writer, "alloc-new")
            mir_digest_u64(&writer, call.value)
            mir_digest_allocator(&writer, kind)
            mir_digest_option_int(&writer, inline_size)
            mir_digest_call_args(&writer, args)
        }
        .ColumnarRead(base, index, column, column_index, accessor) -> {
            mir_digest_tag(&writer, "columnar-read")
            mir_digest_u64(&writer, base.value)
            mir_digest_u64(&writer, index.value)
            mir_digest_u64(&writer, column.value)
            mir_digest_len(&writer, column_index)
            mir_digest_u64(&writer, accessor.value)
        }
        .StaticPreludeCall(call, args, owner_type_args, type_args) -> {
            mir_digest_tag(&writer, "static-prelude-call")
            mir_digest_u64(&writer, call.value)
            mir_digest_call_args(&writer, args)
            mir_digest_len(&writer, owner_type_args.len())
            loop type_arg in owner_type_args {
                if type_arg == {
                    .Type(ty) -> {
                        mir_digest_tag(&writer, "type")
                        mir_digest_type(&writer, ty)
                    }
                    .HostUsize -> mir_digest_tag(&writer, "host-usize")
                }
            }
            mir_digest_len(&writer, type_args.len())
            loop type_arg in type_args -> mir_digest_type(&writer, type_arg)
        }
        .DecodeUnder(call, segment, inner) -> {
            mir_digest_tag(&writer, "decode-under")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, segment.value)
            mir_digest_u64(&writer, inner.value)
        }
        .HardwareCall(call, op, receiver, args) -> {
            mir_digest_tag(&writer, "hardware-call")
            mir_digest_u64(&writer, call.value)
            mir_digest_hardware_op(&writer, op)
            mir_digest_option_int(&writer, receiver.map(row -> row.value))
            mir_digest_call_args(&writer, args)
        }
        .BuiltinMethod(call, receiver, receiver_place, args, aggregate_fields) -> {
            mir_digest_tag(&writer, "builtin-method")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, receiver.value)
            mir_digest_option_int(&writer, receiver_place.map(row -> row.value))
            mir_digest_values(&writer, args)
            if aggregate_fields == {
                .Val(aggregate_fields_value) -> {
                mir_digest_bool(&writer, true)
                mir_digest_field_path(&writer, aggregate_fields_value)
            }
            else -> {
                mir_digest_bool(&writer, false)
            }
        }
        }
        .OptionLift2(call, function, left, right) -> {
            mir_digest_tag(&writer, "option-lift2")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, function.value)
            mir_digest_u64(&writer, left.value)
            mir_digest_u64(&writer, right.value)
        }
        .ClosureMethod(receiver, args, call) -> {
            mir_digest_tag(&writer, "closure-method")
            mir_digest_u64(&writer, receiver.value)
            mir_digest_u64(&writer, call.value)
            mir_digest_call_args(&writer, args)
        }
        .HostBorrowCallback(callable, params) -> {
            mir_digest_tag(&writer, "host-borrow-callback")
            mir_digest_u64(&writer, callable.value)
            mir_digest_len(&writer, params.len())
            loop param in params -> mir_digest_type(&writer, param)
        }
        .TextPatternMatch(call, subject, parts) -> {
            mir_digest_tag(&writer, "text-pattern-match")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, subject.value)
            mir_digest_text_pattern_parts(&writer, parts)
        }
        .BinaryPatternMatch(call, subject, parts) -> {
            mir_digest_tag(&writer, "binary-pattern-match")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, subject.value)
            mir_digest_binary_pattern_parts(&writer, parts)
        }
        .CursorTakePattern(receiver, receiver_place, parts) -> {
            mir_digest_tag(&writer, "cursor-take-pattern")
            mir_digest_u64(&writer, receiver.value)
            mir_digest_u64(&writer, receiver_place.value)
            mir_digest_text_pattern_parts(&writer, parts)
        }
        .ReaderTakePattern(receiver, receiver_place, parts) -> {
            mir_digest_tag(&writer, "reader-take-pattern")
            mir_digest_u64(&writer, receiver.value)
            mir_digest_u64(&writer, receiver_place.value)
            mir_digest_binary_pattern_parts(&writer, parts)
        }
        .NumericMethod(call, receiver) -> {
            mir_digest_tag(&writer, "numeric-method")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, receiver.value)
        }
        .NumericBinaryMethod(call, receiver, argument) -> {
            mir_digest_tag(&writer, "numeric-binary-method")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, receiver.value)
            mir_digest_u64(&writer, argument.value)
        }
        .OverflowOption(call, left, right, location) -> {
            mir_digest_tag(&writer, "overflow-option")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, left.value)
            mir_digest_u64(&writer, right.value)
            if location == {
                .Val(location_value) -> {
                mir_digest_bool(&writer, true)
                mir_digest_panic_location(&writer, location_value)
            }
            else -> {
                mir_digest_bool(&writer, false)
            }
        }
        }
        .HandleMethod(call, receiver, args, frame_schedule, frame_schedule_derivation) -> {
            mir_digest_tag(&writer, "handle-method")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, receiver.value)
            mir_digest_values(&writer, args)
            if frame_schedule == {
                .Val(frame_schedule_value) -> {
                mir_digest_bool(&writer, true)
                mir_digest_string(&writer, mir_digest_frame_schedule_text(frame_schedule_value))
            }
            else -> {
                mir_digest_bool(&writer, false)
            }
        }
            mir_digest_option_string(&writer, frame_schedule_derivation.map(row -> row.id))
        }
        .PluginInvoke(call, handle, export_name, signature, args) -> {
            mir_digest_tag(&writer, "plugin-invoke")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, handle.value)
            mir_digest_string(&writer, export_name)
            mir_digest_component_signature(&writer, signature)
            mir_digest_values(&writer, args)
        }
        .HTTPRouterRegister(call, receiver, path, handler, method, names, contract_json, location) -> {
            mir_digest_tag(&writer, "http-router-register")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, receiver.value)
            mir_digest_u64(&writer, path.value)
            mir_digest_u64(&writer, handler.value)
            mir_digest_string(&writer, mir_digest_http_method(method))
            mir_digest_string_list_encode(&writer, names)
            mir_digest_string(&writer, contract_json)
            mir_digest_panic_location(&writer, location)
        }
        .CoreClosureCall(call, kind, values, closure, site, label) -> {
            mir_digest_tag(&writer, "core-closure-call")
            mir_digest_u64(&writer, call.value)
            mir_digest_core_closure(&writer, kind)
            mir_digest_values(&writer, values)
            mir_digest_option_int(&writer, closure.map(row -> row.value))
            mir_digest_u64(&writer, site.value)
            mir_digest_string(&writer, label)
        }
        .TaskGroup(call, kind, tasks) -> {
            mir_digest_tag(&writer, "task-group")
            mir_digest_u64(&writer, call.value)
            mir_digest_task_group(&writer, kind)
            mir_digest_values(&writer, tasks)
        }
        .Select(call, kind, values) -> {
            mir_digest_tag(&writer, "select")
            mir_digest_u64(&writer, call.value)
            mir_digest_select(&writer, kind)
            mir_digest_values(&writer, values)
        }
        .PolicyFunction(policy, values) -> {
            mir_digest_tag(&writer, "policy-function")
            mir_digest_u64(&writer, policy.value)
            mir_digest_values(&writer, values)
        }
        .InterruptFunction(interrupt, values) -> {
            mir_digest_tag(&writer, "interrupt-function")
            mir_digest_u64(&writer, interrupt.value)
            mir_digest_values(&writer, values)
        }
        .CarrierFact(call, receiver, field, notes) -> {
            mir_digest_tag(&writer, "carrier-fact")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, receiver.value)
            mir_digest_u64(&writer, field.value)
            mir_digest_bool(&writer, notes)
        }
        .GCEdit(call, root, edges, edit, index, kind, site) -> {
            mir_digest_tag(&writer, "gc-edit")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, root.value)
            mir_digest_values(&writer, edges)
            mir_digest_u64(&writer, edit.value)
            mir_digest_option_int(&writer, index.map(row -> row.value))
            mir_digest_gc_edit(&writer, kind)
            mir_digest_u64(&writer, site.value)
        }
        .TypedTextInterp(call, kind, literals, holes, trusted_html) -> {
            mir_digest_tag(&writer, "typed-text-interp")
            mir_digest_u64(&writer, call.value)
            mir_digest_typed_head(&writer, kind)
            mir_digest_len(&writer, literals.len())
            loop literal in literals -> mir_digest_string(&writer, literal)
            mir_digest_values(&writer, holes)
            mir_digest_len(&writer, trusted_html.len())
            loop trusted in trusted_html -> mir_digest_bool(&writer, trusted)
        }
        .CCallback(call, callback, lambda) -> {
            mir_digest_tag(&writer, "c-callback")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, callback.value)
            mir_digest_u64(&writer, lambda.value)
        }
        .HostCall(call, args) -> {
            mir_digest_tag(&writer, "host-call")
            mir_digest_call_args(&writer, args)
        }
    }
}

fn mir_digest_http_method(value: MIRHTTPMethod) -> String Never! {
    if value == {
        .Get -> "GET"
        .Post -> "POST"
        .Put -> "PUT"
        .Delete -> "DELETE"
        .Patch -> "PATCH"
        .Head -> "HEAD"
        .Options -> "OPTIONS"
    }
}

fn mir_digest_frame_schedule_text(value: MIRFrameSchedule) -> String Never! {
    operations :: loop operation in value.operations -> "{mir_digest_debug_quote(operation.name)}:{operation.source_index}:{mir_digest_debug_bool(operation.external_effect)}"
    dependencies :: loop dependency in value.dependencies -> "{dependency.before}->{dependency.after}:{mir_digest_debug_quote(dependency.resource)}"
    transfers :: loop transfer in value.transfers -> "{transfer.before}->{transfer.after}:{mir_digest_debug_quote(transfer.resource)}"
    "{operations.join("|")};{dependencies.join("|")};{transfers.join("|")};{value.conservative.join("|")}"
}

fn mir_digest_operation(writer: &MIRCanonicalWriter, operation: MIROperation) {
    if operation == {
        .Parameter(index, name) -> {
            mir_digest_tag(&writer, "parameter")
            mir_digest_len(&writer, index)
            mir_digest_string(&writer, name)
        }
        .Capture(slot) -> {
            mir_digest_tag(&writer, "capture")
            mir_digest_len(&writer, slot)
        }
        .Global(name) -> {
            mir_digest_tag(&writer, "global")
            mir_digest_string(&writer, name)
        }
        .Phi(incoming) -> {
            mir_digest_tag(&writer, "phi")
            mir_digest_len(&writer, incoming.len())
            loop row in incoming {
                mir_digest_u64(&writer, row.block.value)
                mir_digest_u64(&writer, row.value.value)
            }
        }
        .ReadPlace(place) -> {
            mir_digest_tag(&writer, "read-place")
            mir_digest_u64(&writer, place.value)
        }
        .MovePlace(place) -> {
            mir_digest_tag(&writer, "move-place")
            mir_digest_u64(&writer, place.value)
        }
        .WritePlace(place, value) -> {
            mir_digest_tag(&writer, "write-place")
            mir_digest_u64(&writer, place.value)
            mir_digest_u64(&writer, value.value)
        }
        .ReplacePlace(place, value) -> {
            mir_digest_tag(&writer, "replace-place")
            mir_digest_u64(&writer, place.value)
            mir_digest_u64(&writer, value.value)
        }
        .InitializeUninit(place) -> {
            mir_digest_tag(&writer, "initialize-uninit")
            mir_digest_u64(&writer, place.value)
        }
        .TraitBox(value, target) -> {
            mir_digest_tag(&writer, "trait-box")
            mir_digest_u64(&writer, value.value)
            mir_digest_u64(&writer, target.value)
        }
        .Copy(value, materialize_view) -> {
            mir_digest_tag(&writer, "copy")
            mir_digest_u64(&writer, value.value)
            mir_digest_bool(&writer, materialize_view)
        }
        .Move(value) -> {
            mir_digest_tag(&writer, "move")
            mir_digest_u64(&writer, value.value)
        }
        .Constant(constant) -> {
            mir_digest_tag(&writer, "constant")
            mir_digest_constant(&writer, constant)
        }
        .Unary(op, value) -> {
            mir_digest_tag(&writer, "unary")
            mir_digest_string(&writer, mir_digest_unary_debug(op))
            mir_digest_u64(&writer, value.value)
        }
        .Binary(op, dispatch, _, left, right) -> {
            mir_digest_tag(&writer, "binary")
            mir_digest_string(&writer, mir_digest_binary_debug(op))
            mir_digest_string(&writer, mir_digest_binary_dispatch_debug(dispatch))
            mir_digest_u64(&writer, left.value)
            mir_digest_u64(&writer, right.value)
        }
        .BuildString(parts) -> {
            mir_digest_tag(&writer, "build-string")
            mir_digest_len(&writer, parts.len())
            loop part in parts -> mir_digest_string(&writer, mir_digest_string_part_debug(part))
        }
        .BuildList(values, trait_coercion) -> {
            mir_digest_tag(&writer, "build-list")
            mir_digest_values(&writer, values)
            mir_digest_option_int(&writer, trait_coercion.map(row -> row.value))
        }
        .BuildMap(entries) -> {
            mir_digest_tag(&writer, "build-map")
            mir_digest_len(&writer, entries.len())
            loop entry in entries {
                mir_digest_u64(&writer, entry.key.value)
                mir_digest_u64(&writer, entry.value.value)
            }
        }
        .EnumIs(subject, owner, variant) -> {
            mir_digest_tag(&writer, "enum-is")
            mir_digest_u64(&writer, subject.value)
            mir_digest_u64(&writer, owner.value)
            mir_digest_string(&writer, variant)
        }
        .EnumPayload(subject, owner, variant, index) -> {
            mir_digest_tag(&writer, "enum-payload")
            mir_digest_u64(&writer, subject.value)
            mir_digest_u64(&writer, owner.value)
            mir_digest_string(&writer, variant)
            mir_digest_len(&writer, index)
        }
        .OptionIsSome(subject) -> {
            mir_digest_tag(&writer, "option-is-some")
            mir_digest_u64(&writer, subject.value)
        }
        .OptionValue(subject) -> {
            mir_digest_tag(&writer, "option-value")
            mir_digest_u64(&writer, subject.value)
        }
        .ResultIsOk(subject) -> {
            mir_digest_tag(&writer, "result-is-ok")
            mir_digest_u64(&writer, subject.value)
        }
        .ResultValue(subject, ok) -> {
            mir_digest_tag(&writer, "result-value")
            mir_digest_u64(&writer, subject.value)
            mir_digest_bool(&writer, ok)
        }
        .PatternCapture(matched, index) -> {
            mir_digest_tag(&writer, "pattern-capture")
            mir_digest_u64(&writer, matched.value)
            mir_digest_len(&writer, index)
        }
        .PatternMatched(matched) -> {
            mir_digest_tag(&writer, "pattern-matched")
            mir_digest_u64(&writer, matched.value)
        }
        .ProjectMembers(base, members) -> {
            mir_digest_tag(&writer, "project-members")
            mir_digest_u64(&writer, base.value)
            mir_digest_len(&writer, members.len())
            loop member in members -> mir_digest_u64(&writer, member.value)
        }
        .Index(call, base, index, kind, access, location, context) -> {
            mir_digest_tag(&writer, "index")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, base.value)
            mir_digest_u64(&writer, index.value)
            mir_digest_index_kind(&writer, kind)
            mir_digest_string(&writer, mir_digest_access_debug(access))
            mir_digest_panic_location(&writer, location)
            mir_digest_string(&writer, mir_digest_panic_context_debug(context))
        }
        .Slice(call, base, start, end, range, location) -> {
            mir_digest_tag(&writer, "slice")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, base.value)
            mir_digest_u64(&writer, start.value)
            mir_digest_u64(&writer, end.value)
            mir_digest_option_int(&writer, range.map(row -> row.value))
            mir_digest_panic_location(&writer, location)
        }
        .Range(start, end, exclusive) -> {
            mir_digest_tag(&writer, "range")
            mir_digest_u64(&writer, start.value)
            mir_digest_u64(&writer, end.value)
            mir_digest_bool(&writer, exclusive)
        }
        .Field(base, field) -> {
            mir_digest_tag(&writer, "field")
            mir_digest_u64(&writer, base.value)
            mir_digest_u64(&writer, field.value)
        }
        .Struct(type_id, fields) | .Tuple(type_id, fields) -> {
            mir_digest_tag(&writer, if operation == {
                .Struct(_, _) -> "struct"
                else -> "tuple"
            })
            mir_digest_u64(&writer, type_id.value)
            mir_digest_len(&writer, fields.len())
            loop field in fields {
                mir_digest_u64(&writer, field.field.value)
                mir_digest_u64(&writer, field.value.value)
            }
        }
        .Enum(type_id, variant, args) -> {
            mir_digest_tag(&writer, "enum")
            mir_digest_u64(&writer, type_id.value)
            mir_digest_string(&writer, variant)
            mir_digest_len(&writer, args.len())
            loop arg in args {
                mir_digest_option_int(&writer, arg.field.map(row -> row.value))
                mir_digest_u64(&writer, arg.value.value)
                mir_digest_bool(&writer, arg.boxed)
            }
        }
        .Present(value) -> {
            mir_digest_tag(&writer, "present")
            mir_digest_u64(&writer, value.value)
        }
        .Convert(value, parameters, target, conversion) -> {
            mir_digest_tag(&writer, "convert")
            mir_digest_u64(&writer, value.value)
            mir_digest_len(&writer, parameters.len())
            loop parameter in parameters -> mir_digest_u64(&writer, parameter.value)
            mir_digest_type(&writer, target)
            mir_digest_conversion(&writer, conversion)
        }
        .Absent -> mir_digest_tag(&writer, "absent")
        .ResultOk(value) -> {
            mir_digest_tag(&writer, "result-ok")
            mir_digest_u64(&writer, value.value)
        }
        .ResultErr(value) -> {
            mir_digest_tag(&writer, "result-err")
            mir_digest_u64(&writer, value.value)
        }
        .Call(callee, args, type_args) -> {
            mir_digest_tag(&writer, "call")
            mir_digest_callee(&writer, callee)
            mir_digest_call_args(&writer, args)
            mir_digest_len(&writer, type_args.len())
            loop type_arg in type_args -> mir_digest_type(&writer, type_arg)
        }
        .IndirectCall(callee, args, type_args) -> {
            mir_digest_tag(&writer, "indirect-call")
            mir_digest_u64(&writer, callee.value)
            mir_digest_call_args(&writer, args)
            mir_digest_len(&writer, type_args.len())
            loop type_arg in type_args -> mir_digest_type(&writer, type_arg)
        }
        .Closure(function, captures, facts) -> {
            mir_digest_tag(&writer, "closure")
            mir_digest_u64(&writer, function.value)
            mir_digest_len(&writer, captures.len())
            loop capture in captures -> mir_digest_string(&writer, mir_digest_capture_operand_debug(capture))
            mir_digest_string(&writer, mir_digest_capture_facts_debug(facts))
        }
        .PtrFromAddr(address, element) -> {
            mir_digest_tag(&writer, "ptr-from-addr")
            mir_digest_u64(&writer, address.value)
            mir_digest_type(&writer, element)
        }
        .Deref(value) -> {
            mir_digest_tag(&writer, "deref")
            mir_digest_u64(&writer, value.value)
        }
        .RawAddressOf(place) -> {
            mir_digest_tag(&writer, "raw-address-of")
            mir_digest_u64(&writer, place.value)
        }
        .AddressOf(place, access) -> {
            mir_digest_tag(&writer, "address-of")
            mir_digest_u64(&writer, place.value)
            mir_digest_string(&writer, mir_digest_access_debug(access))
        }
        .CoreCall(call, route, args, type_args, fallibility, data_plan) -> {
            mir_digest_tag(&writer, "core-call")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, route.value)
            mir_digest_call_args(&writer, args)
            mir_digest_len(&writer, type_args.len())
            loop type_arg in type_args -> mir_digest_type(&writer, type_arg)
            mir_digest_call_fallibility(&writer, fallibility)
            if data_plan == {
                .Val(plan) -> {
                mir_digest_bool(&writer, true)
                mir_digest_data_plan(&writer, plan)
            }
            else -> {
                mir_digest_bool(&writer, false)
            }
        }
        }
        .AttachTag(value, tag_value) -> {
            mir_digest_tag(&writer, "attach-tag")
            mir_digest_u64(&writer, value.value)
            mir_digest_option_string(&writer, tag_value)
        }
        .Todo(call, location, expected_type) -> {
            mir_digest_tag(&writer, "todo")
            mir_digest_u64(&writer, call.value)
            mir_digest_panic_location(&writer, location)
            mir_digest_option_type(&writer, expected_type)
        }
        .Never(reason) -> {
            mir_digest_tag(&writer, "never")
            mir_digest_string(&writer, reason)
        }
        .Semantic(semantic) -> {
            mir_digest_tag(&writer, "semantic")
            mir_digest_semantic_operation(&writer, semantic)
        }
        .LoopRangeInit(call, start, end, step, exclusive) -> {
            mir_digest_tag(&writer, "loop-range-init")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, start.value)
            mir_digest_u64(&writer, end.value)
            mir_digest_option_int(&writer, step.map(row -> row.value))
            mir_digest_bool(&writer, exclusive)
        }
        .LoopRangeHasNext(call, cursor) -> {
            mir_digest_tag(&writer, "loop-range-has-next")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, cursor.value)
        }
        .LoopRangeValue(call, cursor) -> {
            mir_digest_tag(&writer, "loop-range-value")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, cursor.value)
        }
        .LoopRangeAdvance(call, cursor) -> {
            mir_digest_tag(&writer, "loop-range-advance")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, cursor.value)
        }
        .LoopIterInit(call, collection, step, by_value, source_kind) -> {
            mir_digest_tag(&writer, "loop-iter-init")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, collection.value)
            mir_digest_option_int(&writer, step.map(row -> row.value))
            mir_digest_bool(&writer, by_value)
            mir_digest_loop_source_kind(&writer, source_kind)
        }
        .LoopIterHasNext(call, cursor) -> {
            mir_digest_tag(&writer, "loop-iter-has-next")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, cursor.value)
        }
        .LoopIterValue(call, cursor) -> {
            mir_digest_tag(&writer, "loop-iter-value")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, cursor.value)
        }
        .LoopIterAdvance(call, cursor) -> {
            mir_digest_tag(&writer, "loop-iter-advance")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, cursor.value)
        }
        .ScopeEnter(scope, test_member) -> {
            mir_digest_tag(&writer, "scope-enter")
            mir_digest_u64(&writer, scope.value)
            mir_digest_option_string(&writer, test_member.map(row -> mir_digest_test_scope_member_debug(row)))
        }
        .ScopeExit(scope) -> {
            mir_digest_tag(&writer, "scope-exit")
            mir_digest_u64(&writer, scope.value)
        }
        .Drop(value, kind) -> {
            mir_digest_tag(&writer, "drop")
            mir_digest_u64(&writer, value.value)
            mir_digest_string(&writer, mir_digest_drop_kind_debug(kind))
        }
    }
}

fn mir_digest_string_list_encode(writer: &MIRCanonicalWriter, values: [String]) Never! {
    mir_digest_len(&writer, values.len())
    loop value in values -> mir_digest_string(&writer, value)
}

fn mir_digest_index_kind(writer: &MIRCanonicalWriter, value: MIRIndexKind) Never! {
    if value == {
        .List -> mir_digest_u64(&writer, 1)
        .FixedListProof -> mir_digest_u64(&writer, 2)
        .Map -> mir_digest_u64(&writer, 3)
        .Lane -> mir_digest_u64(&writer, 4)
        .Pool -> mir_digest_u64(&writer, 5)
    }
}

fn mir_digest_panic_context_debug(value: MIRPanicContext) -> String Never! {
    locals :: loop local in value.locals -> "MirPanicLocal {{ name: {mir_digest_debug_quote(local.name)}, local: MirLocalId {{ value: {local.local.value} }} }}"
    "MirPanicContext {{ function: {mir_digest_debug_quote(value.function)}, source_line: {mir_digest_debug_quote(value.source_line)}, caret: {value.caret}, locals: [{locals.join(", ")}] }}"
}

fn mir_digest_unary_debug(value: MIRUnaryOp) -> String Never! {
    if value == {
        .Neg -> "Neg"
        .Not -> "Not"
    }
}

fn mir_digest_binary_debug(value: MIRBinaryOp) -> String Never! {
    if value == {
        .Add -> "Add"
        .Sub -> "Sub"
        .Mul -> "Mul"
        .Div -> "Div"
        .FloorDiv -> "FloorDiv"
        .Mod -> "Mod"
        .Rem -> "Rem"
        .Pow -> "Pow"
        .BitAnd -> "BitAnd"
        .BitOr -> "BitOr"
        .BitXor -> "BitXor"
        .Shl -> "Shl"
        .Shr -> "Shr"
        .Eq -> "Eq"
        .Ne -> "Ne"
        .Lt -> "Lt"
        .Gt -> "Gt"
        .Le -> "Le"
        .Ge -> "Ge"
        .Compare -> "Compare"
        .And -> "And"
        .Or -> "Or"
    }
}

fn mir_digest_binary_dispatch_debug(value: MIRBinaryDispatch) -> String Never! {
    if value == {
        .Primitive -> "Primitive"
        .Prelude(call, location) -> "Prelude(MirPreludeCallId {{ value: {call.value} }}, {if location == .Val(loc) -> "Some({mir_digest_panic_location_debug(loc)})" else -> "None"})"
    }
}

fn mir_digest_string_format_debug(value: MIRStringFormat) -> String Never! {
    if value == {
        .Display -> "Display"
        .Debug -> "Debug"
        .Pretty -> "Pretty"
        .Fixed(digits) -> "Fixed({digits})"
        .Grouped(digits) -> "Grouped({digits})"
        .Hex(digits) -> "Hex({digits})"
        .Pad(width, fill) -> "Pad {{ width: {width}, fill: {mir_digest_debug_quote(fill)} }}"
        .PadLeft(width, fill) -> "PadLeft {{ width: {width}, fill: {mir_digest_debug_quote(fill)} }}"
        .Sci(digits) -> "Sci({digits})"
        .Percent(digits) -> "Percent({digits})"
        .Bin -> "Bin"
        .Oct -> "Oct"
        .Unit(format) -> "Unit({mir_digest_unit_format_debug(format)})"
    }
}

fn mir_digest_unit_format_debug(value: MIRUnitFormat) -> String Never! {
    if value == {
        .Symbol -> "Symbol"
        .Name -> "Name"
        .Bare -> "Bare"
    }
}

fn mir_digest_string_part_debug(value: MIRStringPart) -> String Never! {
    if value.kind == {
        .Literal(text) -> "MirStringPart {{ kind: Literal({mir_digest_debug_quote(text)}) }}"
        .Interpolation(id, format) -> "MirStringPart {{ kind: Interpolation(MirValueId {{ value: {id.value} }}, {mir_digest_string_format_debug(format)}) }}"
    }
}

fn mir_digest_capture_operand_debug(value: MIRCaptureOperand) -> String Never! {
    if value == {
        .Value(id) -> "Value(MirValueId {{ value: {id.value} }})"
        .Place(id) -> "Place(MirPlaceId {{ value: {id.value} }})"
    }
}

fn mir_digest_capture_facts_debug(value: MIRCaptureFacts) -> String Never! {
    "MirCaptureFacts {{ escapes: {mir_digest_debug_bool(value.escapes)}, needs_fn_mut: {mir_digest_debug_bool(value.needs_fn_mut)}, mutable: {mir_digest_debug_string_list(value.mutable)}, cloned: {mir_digest_debug_string_list(value.cloned)}, frozen: {mir_digest_debug_string_list(value.frozen)}, materialized: {mir_digest_debug_string_list(value.materialized)}, moved: {mir_digest_debug_string_list(value.moved)} }}"
}

fn mir_digest_test_scope_member_debug(value: MIRTestScopeMember) -> String Never! {
    if value == {
        .ExpectFail(code) -> "ExpectFail({mir_digest_debug_option_string(code)})"
        .Timeout(duration) -> "Timeout(MirValueId {{ value: {duration.value} }})"
        .Skip(whole_test) -> "Skip({mir_digest_debug_bool(whole_test)})"
        .Measure -> "Measure"
    }
}

fn mir_digest_data_plan_operation_debug(value: MIRDataPlanOperation) -> String Never! {
    if value == {
        .Scan -> "Scan"
        .Filter -> "Filter"
        .SortBy -> "SortBy"
        .InnerJoin -> "InnerJoin"
        .LeftJoin -> "LeftJoin"
        .Group -> "Group"
        .Window -> "Window"
        .Project -> "Project"
        .Collect -> "Collect"
    }
}

fn mir_digest_data_plan_source_debug(value: MIRDataPlanSourceKind) -> String Never! {
    if value == {
        .Table -> "Table"
        .Series -> "Series"
        .CSV -> "Csv"
        .JSON -> "JSON"
        .JSONL -> "Jsonl"
        .Parquet -> "Parquet"
        .Arrow -> "Arrow"
        .Loader -> "Loader"
        .CSVReader -> "CsvReader"
        .JSONReader -> "JsonReader"
    }
}

fn mir_digest_data_plan_stream(writer: &MIRCanonicalWriter, value: MIRDataPlanStreamMode) Never! {
    if value == {
        .Bounded(batch_rows) -> {
            mir_digest_tag(&writer, "bounded")
            mir_digest_option_int(&writer, batch_rows)
        }
        .Materialized(reason) -> {
            mir_digest_tag(&writer, "materialized")
            mir_digest_string(&writer, reason)
        }
    }
}

fn mir_digest_data_plan_physical_debug(value: MIRDataPlanPhysicalOperator) -> String Never! {
    if value == {
        .Scan -> "Scan"
        .Filter -> "Filter"
        .SortBy -> "SortBy"
        .InnerJoin -> "InnerJoin"
        .LeftJoin -> "LeftJoin"
        .Group -> "Group"
        .Window -> "Window"
        .Project -> "Project"
        .Batch -> "Batch"
        .Materialize -> "Materialize"
    }
}

fn mir_digest_data_plan(writer: &MIRCanonicalWriter, value: MIRDataPlan) Never! {
    mir_digest_u64(&writer, value.schema_version)
    mir_digest_string(&writer, mir_digest_data_plan_source_debug(value.source))
    mir_digest_len(&writer, value.logical.len())
    loop node in value.logical {
        mir_digest_u64(&writer, node.id.value)
        mir_digest_string(&writer, mir_digest_data_plan_operation_debug(node.operation))
        mir_digest_len(&writer, node.inputs.len())
        loop input in node.inputs -> mir_digest_u64(&writer, input.value)
        mir_digest_option_string(&writer, node.source.map(row -> mir_digest_data_plan_source_debug(row)))
        mir_digest_type(&writer, node.row_type)
        mir_digest_len(&writer, node.columns.len())
        loop column in node.columns {
            mir_digest_string(&writer, column.name)
            mir_digest_type(&writer, column.ty)
            mir_digest_bool(&writer, column.nullable)
        }
        if node.callable == {
            None -> mir_digest_bool(&writer, false)
            Val(callable) -> {
                mir_digest_bool(&writer, true)
                mir_digest_string(&writer, callable.label)
                mir_digest_type(&writer, callable.parameter)
                mir_digest_type(&writer, callable.result)
                mir_digest_span(&writer, callable.span)
            }
        }
        mir_digest_data_plan_stream(&writer, node.stream)
        mir_digest_span(&writer, node.span)
    }
    mir_digest_len(&writer, value.physical.len())
    loop node in value.physical {
        mir_digest_u64(&writer, node.logical.value)
        mir_digest_string(&writer, mir_digest_data_plan_physical_debug(node.operator))
        mir_digest_data_plan_stream(&writer, node.stream)
        mir_digest_string(&writer, node.reason)
    }
    mir_digest_u64(&writer, value.output.value)
    mir_digest_span(&writer, value.source_span)
}

fn mir_digest_constant(writer: &MIRCanonicalWriter, constant: MIRConstant) {
    if constant == {
        .Int(amount, width, spelling) -> {
            mir_digest_tag(&writer, "int")
            mir_digest_u64(&writer, amount)
            if width == {
                .Val(row) -> {
                mir_digest_bool(&writer, true)
                mir_digest_bool(&writer, row.signed)
                mir_digest_u64(&writer, row.bits)
            }
            else -> {
                mir_digest_bool(&writer, false)
            }
        }
            mir_digest_option_string(&writer, spelling)
        }
        .Float(amount, f32, spelling) -> {
            mir_digest_tag(&writer, "float")
            mir_digest_u64(&writer, math.to_bits(amount))
            mir_digest_bool(&writer, f32)
            mir_digest_option_string(&writer, spelling)
        }
        .Bool(value) -> {
            mir_digest_tag(&writer, "bool")
            mir_digest_bool(&writer, value)
        }
        .Char(value) -> {
            mir_digest_tag(&writer, "char")
            mir_digest_u64(&writer, value)
        }
        .String(value) -> {
            mir_digest_tag(&writer, "string")
            mir_digest_string(&writer, value)
        }
        .Bytes(value) -> {
            mir_digest_tag(&writer, "bytes")
            mir_digest_bytes(&writer, value)
        }
        .Unit -> mir_digest_tag(&writer, "unit")
        .BigInt(value) -> {
            mir_digest_tag(&writer, "bigint")
            mir_digest_string(&writer, value)
        }
        .List(values) -> {
            mir_digest_tag(&writer, "list")
            mir_digest_len(&writer, values.len())
            loop item in values -> mir_digest_constant(&writer, item)
        }
        .Map(values) -> {
            mir_digest_tag(&writer, "map")
            mir_digest_len(&writer, values.len())
            loop item in values {
                mir_digest_const_key(&writer, item.key)
                mir_digest_constant(&writer, item.value)
            }
        }
        .Struct(type_name, fields) -> {
            mir_digest_tag(&writer, "struct")
            mir_digest_string(&writer, type_name)
            mir_digest_len(&writer, fields.len())
            loop field in fields {
                mir_digest_string(&writer, field.name)
                mir_digest_constant(&writer, field.value)
            }
        }
        .Enum(type_name, variant, args) -> {
            mir_digest_tag(&writer, "enum")
            mir_digest_string(&writer, type_name)
            mir_digest_string(&writer, variant)
            mir_digest_len(&writer, args.len())
            loop arg in args {
                mir_digest_option_string(&writer, arg.name)
                mir_digest_constant(&writer, arg.value)
            }
        }
        .Present(inner) -> {
            mir_digest_tag(&writer, "present")
            mir_digest_constant(&writer, inner)
        }
        .Failed(report) -> {
            mir_digest_tag(&writer, "failed")
            if report == {
                .Clean(ty) -> {
                    mir_digest_tag(&writer, "clean")
                    mir_digest_type(&writer, ty)
                }
                .Told(inner) -> {
                    mir_digest_tag(&writer, "told")
                    mir_digest_constant(&writer, inner)
                }
            }
        }
    }
}

fn mir_digest_const_key(writer: &MIRCanonicalWriter, key: MIRConstKey) Never! {
    if key == {
        .Int(amount) -> {
            mir_digest_tag(&writer, "int")
            mir_digest_u64(&writer, amount)
        }
        .String(text) -> {
            mir_digest_tag(&writer, "string")
            mir_digest_string(&writer, text)
        }
        .Bool(value) -> {
            mir_digest_tag(&writer, "bool")
            mir_digest_bool(&writer, value)
        }
        .Char(value) -> {
            mir_digest_tag(&writer, "char")
            mir_digest_u64(&writer, value)
        }
        .Tuple(values) -> {
            mir_digest_tag(&writer, "tuple")
            mir_digest_len(&writer, values.len())
            loop row in values {
                mir_digest_string(&writer, row.name)
                mir_digest_const_key(&writer, row.key)
            }
        }
        .Struct(type_name, fields) -> {
            mir_digest_tag(&writer, "struct")
            mir_digest_string(&writer, type_name)
            mir_digest_len(&writer, fields.len())
            loop row in fields {
                mir_digest_string(&writer, row.name)
                mir_digest_const_key(&writer, row.key)
            }
        }
        .Enum(type_name, variant) -> {
            mir_digest_tag(&writer, "enum")
            mir_digest_string(&writer, type_name)
            mir_digest_string(&writer, variant)
        }
    }
}

fn mir_digest_item_ref(writer: &MIRCanonicalWriter, value: MIRItemRef) Never! {
    if value == {
        .Type(id) -> {
            mir_digest_tag(&writer, "type")
            mir_digest_u64(&writer, id.value)
        }
        .Trait(id) -> {
            mir_digest_tag(&writer, "trait")
            mir_digest_u64(&writer, id.value)
        }
        .Function(id) -> {
            mir_digest_tag(&writer, "function")
            mir_digest_u64(&writer, id.value)
        }
        .Constant(id) -> {
            mir_digest_tag(&writer, "constant")
            mir_digest_u64(&writer, id.value)
        }
        .Impl(id) -> {
            mir_digest_tag(&writer, "impl")
            mir_digest_u64(&writer, id.value)
        }
        .Foreign(id) -> {
            mir_digest_tag(&writer, "foreign")
            mir_digest_u64(&writer, id.value)
        }
        .Import(id) -> {
            mir_digest_tag(&writer, "import")
            mir_digest_u64(&writer, id.value)
        }
    }
}

fn mir_digest_visibility_code(value: MIRVisibility) -> Int Never! {
    if value == {
        .Private -> 1
        .Package -> 2
        .Public -> 3
    }
}

fn mir_digest_access_code(value: MIRAccess) -> Int Never! {
    if value == {
        .Read -> 1
        .Write -> 2
        .Move -> 3
    }
}

fn mir_digest_access_optional(writer: &MIRCanonicalWriter, value: MIRAccess?) Never! {
    if value == {
        .Val(access) -> mir_digest_u64(&writer, mir_digest_access_code(access))
        else -> mir_digest_u64(&writer, 0)
    }
}

fn mir_digest_ownership_mode_code(value: MIROwnershipMode) -> Int Never! {
    if value == {
        .Copy -> 1
        .Owned -> 2
        .Shared -> 3
        .ReadBorrow -> 4
        .WriteBorrow -> 5
        .Move -> 6
    }
}

fn mir_digest_struct_layout(writer: &MIRCanonicalWriter, value: MIRStructLayout?) Never! {
    if value == {
        .Val(layout) -> {
        if layout == {
            .C -> mir_digest_u64(&writer, 1)
            .Columnar -> mir_digest_u64(&writer, 2)
            .CAligned(alignment, target) -> {
                mir_digest_u64(&writer, 3)
                mir_digest_u64(&writer, alignment)
                mir_digest_bool(&writer, target)
            }
        }
        }
        else -> {
        mir_digest_u64(&writer, 0)
        }
    }
}

fn mir_digest_c_enum_tag(writer: &MIRCanonicalWriter, value: MIRCEnumTag?) Never! {
    if value == {
        .Val(enum_tag) -> {
        mir_digest_bool(&writer, true)
        code :: if enum_tag == {
            .CInt -> 1
            .U8 -> 2
            .I8 -> 3
            .U16 -> 4
            .I16 -> 5
            .U32 -> 6
            .I32 -> 7
            .U64 -> 8
            .I64 -> 9
        }
        mir_digest_u64(&writer, code)
    }
    else -> {
        mir_digest_bool(&writer, false)
    }
}
}

fn mir_digest_layout_facts(writer: &MIRCanonicalWriter, value: LayoutFacts?) Never! {
    if value == {
        .Val(facts) -> {
        mir_digest_bool(&writer, true)
        if facts.bytes == {
            .Val(bytes) -> {
            mir_digest_bool(&writer, true)
            mir_digest_u64(&writer, bytes.size)
            mir_digest_u64(&writer, bytes.alignment)
            mir_digest_u64(&writer, bytes.stride)
        }
        else -> {
            mir_digest_bool(&writer, false)
        }
    }
        mir_digest_len(&writer, facts.fields.len())
        loop field in facts.fields {
            mir_digest_string(&writer, field.name)
            mir_digest_option_int(&writer, field.offset)
            mir_digest_option_int(&writer, field.size)
            mir_digest_option_int(&writer, field.alignment)
            mir_digest_option_int(&writer, field.stride)
        }
    }
    else -> {
        mir_digest_bool(&writer, false)
    }
}
}

fn mir_digest_layout_alignment(writer: &MIRCanonicalWriter, value: MIRLayoutAlignmentFact?) Never! {
    if value == {
        .Val(row) -> {
        mir_digest_bool(&writer, true)
        mir_digest_u64(&writer, row.requested_alignment)
        mir_digest_u64(&writer, row.effective_alignment)
        mir_digest_bool(&writer, row.target_mode)
        mir_digest_string(&writer, row.target_profile)
        mir_digest_string(&writer, row.fact_identity)
    }
    else -> {
        mir_digest_bool(&writer, false)
    }
}
}

fn mir_digest_serde_codec(writer: &MIRCanonicalWriter, value: MIRSerdeCodec?) Never! {
    if value == {
        .Val(codec) -> {
        if codec == {
            .Encode -> mir_digest_u64(&writer, 1)
            .Decode -> mir_digest_u64(&writer, 2)
        }
    }
    else -> {
        mir_digest_u64(&writer, 0)
    }
}
}

fn mir_digest_serde_attribute_kind(value: MIRSerdeAttributeKind) -> Int Never! {
    if value == {
        .RenameAll -> 1
        .Tag -> 2
        .Untagged -> 3
        .DenyUnknownFields -> 4
    }
}

fn mir_digest_serde_attributes(writer: &MIRCanonicalWriter, values: [MIRSerdeAttribute]) Never! {
    mir_digest_len(&writer, values.len())
    loop value in values {
        mir_digest_u64(&writer, mir_digest_serde_attribute_kind(value.kind))
        mir_digest_option_string(&writer, value.value)
    }
}

fn mir_digest_target_applicability(writer: &MIRCanonicalWriter, value: MIRTargetApplicability) Never! {
    mir_digest_bool(&writer, value.rust_aot)
    mir_digest_bool(&writer, value.cranelift)
    mir_digest_bool(&writer, value.interpreter)
    mir_digest_bool(&writer, value.web)
}

fn mir_digest_generic_params(writer: &MIRCanonicalWriter, values: [MIRGenericParam]) Never! {
    mir_digest_len(&writer, values.len())
    loop value in values {
        mir_digest_string(&writer, value.name)
        mir_digest_len(&writer, value.bounds.len())
        loop bound in value.bounds {
            mir_digest_u64(&writer, bound.id.value)
            mir_digest_string(&writer, bound.name)
        }
    }
}

fn mir_digest_shape_field_names(writer: &MIRCanonicalWriter, value: MIRShapeFieldNames) Never! {
    mir_digest_string(&writer, value.text)
    mir_digest_option_string(&writer, value.json)
    mir_digest_option_string(&writer, value.cbor)
    mir_digest_option_string(&writer, value.csv)
    mir_digest_option_string(&writer, value.toml)
    mir_digest_option_string(&writer, value.yaml)
    mir_digest_option_string(&writer, value.xml)
    mir_digest_string(&writer, value.args)
    mir_digest_string(&writer, value.env)
    mir_digest_option_string(&writer, value.db)
    mir_digest_option_string(&writer, value.layout)
}

fn mir_digest_field(writer: &MIRCanonicalWriter, value: MIRField) Never! {
    mir_digest_u64(&writer, value.id.value)
    mir_digest_string(&writer, value.name)
    mir_digest_shape_field_names(&writer, value.shape_names)
    mir_digest_bool(&writer, value.skip)
    mir_digest_type(&writer, value.ty)
    mir_digest_span(&writer, value.span)
    mir_digest_bool(&writer, value.public)
    mir_digest_bool(&writer, value.package_public)
    mir_digest_bool(&writer, value.computed)
    mir_digest_bool(&writer, value.has_default)
}

fn mir_digest_variant_payload(writer: &MIRCanonicalWriter, value: MIRVariantPayload) Never! {
    if value == {
        .Unit -> mir_digest_tag(&writer, "unit")
        .Single(ty) -> {
            mir_digest_tag(&writer, "single")
            mir_digest_type(&writer, ty)
        }
        .Named(fields) -> {
            mir_digest_tag(&writer, "named")
            mir_digest_len(&writer, fields.len())
            loop field in fields -> mir_digest_field(&writer, field)
        }
    }
}

fn mir_digest_type_def_kind(writer: &MIRCanonicalWriter, value: MIRTypeDefKind) Never! {
    if value == {
        .Struct(fields, methods) -> {
            mir_digest_tag(&writer, "struct")
            mir_digest_len(&writer, fields.len())
            loop field in fields -> mir_digest_field(&writer, field)
            mir_digest_string(&writer, mir_digest_debug_int_list(methods.map(row -> row.value)))
        }
        .Enum(variants, methods) -> {
            mir_digest_tag(&writer, "enum")
            mir_digest_len(&writer, variants.len())
            loop variant in variants {
                mir_digest_string(&writer, variant.name)
                mir_digest_string(&writer, variant.wire_name)
                mir_digest_span(&writer, variant.span)
                mir_digest_variant_payload(&writer, variant.payload)
                mir_digest_option_int(&writer, variant.discriminant)
            }
            mir_digest_string(&writer, mir_digest_debug_int_list(methods.map(row -> row.value)))
        }
        .Distinct(base, range) -> {
            mir_digest_tag(&writer, "distinct")
            mir_digest_type(&writer, base)
            mir_digest_string(&writer, mir_digest_integer_range_debug(range))
        }
        .Alias(target) -> {
            mir_digest_tag(&writer, "alias")
            mir_digest_type(&writer, target)
        }
        .UnitFamily(members) -> {
            mir_digest_tag(&writer, "unit-family")
            mir_digest_string(&writer, mir_digest_debug_string_list(members))
        }
    }
}

fn mir_digest_param(writer: &MIRCanonicalWriter, value: MIRParam) Never! {
    mir_digest_len(&writer, value.index)
    mir_digest_string(&writer, value.name)
    mir_digest_span(&writer, value.span)
    mir_digest_type(&writer, value.ty)
    mir_digest_string(&writer, mir_digest_access_debug(value.access))
    mir_digest_string(&writer, mir_digest_ownership_debug(value.ownership))
    mir_digest_string(&writer, value.public_label)
}

fn mir_digest_capture_param(writer: &MIRCanonicalWriter, value: MIRCaptureParam) Never! {
    mir_digest_len(&writer, value.slot)
    mir_digest_string(&writer, value.name)
    mir_digest_span(&writer, value.span)
    mir_digest_type(&writer, value.ty)
    mir_digest_string(&writer, mir_digest_access_debug(value.access))
    mir_digest_string(&writer, mir_digest_ownership_debug(value.ownership))
}

fn mir_digest_cli_value_kind(value: MIRCLIValueKind) -> Int Never! {
    if value == {
        .Bool -> 1
        .Int -> 2
        .Float -> 3
        .String -> 4
        .Path -> 5
    }
}

fn mir_digest_param_zone_code(value: ParamZone) -> Int Never! {
    if value == {
        .PositionalOnly -> 1
        .Either -> 2
        .LabelOnly -> 3
    }
}

fn mir_digest_cli_input(writer: &MIRCanonicalWriter, value: MIRCLIInput) {
    mir_digest_len(&writer, value.parameter)
    mir_digest_string(&writer, value.name)
    mir_digest_string(&writer, value.label)
    mir_digest_type(&writer, value.ty)
    mir_digest_u64(&writer, mir_digest_param_zone_code(value.zone))
    mir_digest_option_string(&writer, value.short)
    mir_digest_option_string(&writer, value.env)
    mir_digest_string(&writer, value.help)
    mir_digest_option_string(&writer, value.metavar)
    if value.shape == {
        .Flag -> mir_digest_tag(&writer, "flag")
        .Value(kind, optional, default) -> {
            mir_digest_tag(&writer, "value")
            mir_digest_u64(&writer, mir_digest_cli_value_kind(kind))
            mir_digest_bool(&writer, optional)
            if default == {
                .Val(default_value) -> {
                if default_value == {
                    .TypeDefault -> mir_digest_tag(&writer, "type-default")
                    .Value(constant) -> {
                        mir_digest_tag(&writer, "value-default")
                        mir_digest_constant(&writer, constant)
                    }
                }
            }
            else -> {
                mir_digest_tag(&writer, "no-default")
            }
        }
        }
    }
    mir_digest_option_int(&writer, value.positional)
    mir_digest_bool(&writer, value.variadic)
}

fn mir_digest_cli_entry(writer: &MIRCanonicalWriter, value: MIRCLIEntry) {
    mir_digest_bool(&writer, value.record_inputs)
    mir_digest_option_string(&writer, value.description)
    mir_digest_len(&writer, value.inputs.len())
    loop input in value.inputs -> mir_digest_cli_input(&writer, input)
    mir_digest_len(&writer, value.commands.len())
    loop command in value.commands {
        mir_digest_string(&writer, command.name)
        mir_digest_option_string(&writer, command.description)
        mir_digest_u64(&writer, command.function.value)
        mir_digest_option_int(&writer, command.receiver.map(row -> row.value))
        mir_digest_len(&writer, command.inputs.len())
        loop input in command.inputs -> mir_digest_cli_input(&writer, input)
    }
    mir_digest_bool(&writer, value.standard)
}

fn mir_digest_module(writer: &MIRCanonicalWriter, value: MIRModule) Never! {
    mir_digest_u64(&writer, value.id.value)
    mir_digest_string(&writer, value.key)
    mir_digest_string(&writer, value.name)
    mir_digest_string(&writer, value.path)
    mir_digest_u64(&writer, value.source_file.value)
    imports := value.imports.map(row -> row.value)
    mir_digest_sort_ints(&imports)
    mir_digest_len(&writer, imports.len())
    loop id in imports -> mir_digest_u64(&writer, id)
    mir_digest_len(&writer, value.item_order.len())
    loop item in value.item_order -> mir_digest_item_ref(&writer, item)
}

fn mir_digest_import(writer: &MIRCanonicalWriter, value: MIRImport) Never! {
    mir_digest_u64(&writer, value.id.value)
    mir_digest_u64(&writer, value.module_id.value)
    mir_digest_u64(&writer, mir_digest_visibility_code(value.visibility))
    mir_digest_string(&writer, value.alias)
    mir_digest_span(&writer, value.span)
    if value.kind == {
        .File(path) -> {
            mir_digest_tag(&writer, "file")
            mir_digest_string(&writer, path)
        }
        .Module(path) -> {
            mir_digest_tag(&writer, "module")
            mir_digest_string(&writer, path)
        }
        .Unqualified(module_id, items) -> {
            mir_digest_tag(&writer, "unqualified")
            mir_digest_u64(&writer, module_id.value)
            sorted_items := items
            mir_digest_sort_import_items(&sorted_items)
            mir_digest_len(&writer, sorted_items.len())
            loop item in sorted_items {
                mir_digest_string(&writer, item.original)
                mir_digest_string(&writer, item.local)
                mir_digest_item_ref(&writer, item.item)
            }
        }
    }
}

fn mir_digest_type_def(writer: &MIRCanonicalWriter, value: MIRTypeDef) {
    mir_digest_u64(&writer, value.id.value)
    mir_digest_u64(&writer, value.module_id.value)
    mir_digest_string(&writer, value.key)
    mir_digest_string(&writer, value.name)
    mir_digest_span(&writer, value.span)
    mir_digest_bool(&writer, value.public)
    mir_digest_bool(&writer, value.package_public)
    mir_digest_generic_params(&writer, value.generic_params)
    mir_digest_len(&writer, value.derives.len())
    loop derive_id in value.derives -> mir_digest_u64(&writer, derive_id.value)
    mir_digest_bool(&writer, value.auto_derive_default)
    mir_digest_bool(&writer, value.auto_printable)
    mir_digest_bool(&writer, value.published_schema)
    mir_digest_bool(&writer, value.single_use)
    mir_digest_bool(&writer, value.must_use)
    mir_digest_struct_layout(&writer, value.layout)
    mir_digest_c_enum_tag(&writer, value.c_layout_tag)
    mir_digest_layout_facts(&writer, value.enum_layout)
    mir_digest_layout_alignment(&writer, value.layout_alignment)
    mir_digest_serde_attributes(&writer, value.serde)
    mir_digest_len(&writer, value.cli_bindings.len())
    loop binding in value.cli_bindings {
        mir_digest_string(&writer, binding.name)
        mir_digest_u64(&writer, binding.function.value)
    }
    if value.cli == {
        .Val(cli) -> {
            mir_digest_bool(&writer, true)
            mir_digest_cli_entry(&writer, cli)
        }
        else -> {
            mir_digest_bool(&writer, false)
        }
    }
    mir_digest_u64(&writer, mir_digest_ownership_mode_code(value.ownership))
    mir_digest_len(&writer, value.boxed_edges.len())
    loop edge in value.boxed_edges -> mir_digest_string(&writer, edge)
    if value.compiler_builtin == {
        None -> mir_digest_bool(&writer, false)
        Val(builtin) -> {
            mir_digest_bool(&writer, true)
            if builtin == MIRCompilerBuiltin.DefaultErr -> mir_digest_tag(&writer, "default-err")
        }
    }
    mir_digest_type_def_kind(&writer, value.kind)
}

fn mir_digest_core_owner(writer: &MIRCanonicalWriter, value: MIRCoreOwner) Never! {
    mir_digest_u64(&writer, value.id.value)
    mir_digest_u64(&writer, value.nominal_id.value)
    mir_digest_option_int(&writer, value.module_id.map(row -> row.value))
    mir_digest_string(&writer, value.key)
    mir_digest_string(&writer, value.name)
    mir_digest_u64(&writer, mir_digest_ownership_mode_code(value.ownership))
}

fn mir_digest_trait_method(writer: &MIRCanonicalWriter, value: MIRTraitMethod) Never! {
    mir_digest_u64(&writer, value.id.value)
    mir_digest_string(&writer, value.name)
    mir_digest_span(&writer, value.span)
    mir_digest_access_optional(&writer, value.self_access)
    mir_digest_len(&writer, value.params.len())
    loop param in value.params -> mir_digest_param(&writer, param)
    mir_digest_option_type(&writer, value.declared_return)
    mir_digest_type(&writer, value.return_type)
    mir_digest_failure_carrier(&writer, value.failure)
    mir_digest_string(&writer, mir_digest_effects_debug(value.effects))
    mir_digest_bool(&writer, value.is_pure)
    mir_digest_string(&writer, mir_digest_view_provenance_option_debug(value.return_view_provenance))
    mir_digest_option_int(&writer, value.default.map(row -> row.value))
}

fn mir_digest_trait_def(writer: &MIRCanonicalWriter, value: MIRTraitDef) Never! {
    mir_digest_u64(&writer, value.id.value)
    mir_digest_u64(&writer, value.module_id.value)
    mir_digest_string(&writer, value.key)
    mir_digest_string(&writer, value.name)
    mir_digest_span(&writer, value.span)
    mir_digest_u64(&writer, mir_digest_visibility_code(value.visibility))
    mir_digest_len(&writer, value.associated_types.len())
    loop associated in value.associated_types {
        mir_digest_string(&writer, associated.name)
        mir_digest_span(&writer, associated.span)
    }
    methods := value.methods
    mir_digest_sort_trait_methods(&methods)
    mir_digest_len(&writer, methods.len())
    loop method in methods -> mir_digest_trait_method(&writer, method)
}

fn mir_digest_impl_def(writer: &MIRCanonicalWriter, value: MIRImplDef) Never! {
    mir_digest_u64(&writer, value.id.value)
    mir_digest_u64(&writer, value.module_id.value)
    mir_digest_string(&writer, value.key)
    mir_digest_span(&writer, value.span)
    mir_digest_type(&writer, value.self_type)
    if value.trait_ref == {
        .Val(trait_ref) -> {
        mir_digest_bool(&writer, true)
        mir_digest_u64(&writer, trait_ref.id.value)
        mir_digest_string(&writer, trait_ref.name)
    }
    else -> {
        mir_digest_bool(&writer, false)
    }
}
    associated_types := value.associated_types
    mir_digest_sort_associated_types(&associated_types)
    mir_digest_len(&writer, associated_types.len())
    loop associated in associated_types {
        mir_digest_string(&writer, associated.name)
        mir_digest_type(&writer, associated.ty)
        mir_digest_span(&writer, associated.span)
    }
    methods := value.methods.map(row -> row.value)
    mir_digest_sort_ints(&methods)
    mir_digest_len(&writer, methods.len())
    loop method in methods -> mir_digest_u64(&writer, method)
    mir_digest_option_int(&writer, value.delegation.map(row -> row.value))
    mir_digest_bool(&writer, value.compiler_generated)
    mir_digest_serde_codec(&writer, value.serde)
    if value.operator_rhs == {
        .Val(operator_rhs) -> {
        mir_digest_bool(&writer, true)
        mir_digest_type(&writer, operator_rhs)
    }
    else -> {
        mir_digest_bool(&writer, false)
    }
}
    if value.operator_marker == {
        .Val(_) -> {
        mir_digest_bool(&writer, true)
        mir_digest_tag(&writer, "commutative")
    }
    else -> {
        mir_digest_bool(&writer, false)
    }
}
    mir_digest_target_applicability(&writer, value.target_applicability)
}

fn mir_digest_constant_def(writer: &MIRCanonicalWriter, value: MIRConstantDef) {
    mir_digest_u64(&writer, value.id.value)
    mir_digest_u64(&writer, value.module_id.value)
    mir_digest_string(&writer, value.key)
    mir_digest_string(&writer, value.name)
    mir_digest_span(&writer, value.span)
    mir_digest_u64(&writer, mir_digest_visibility_code(value.visibility))
    mir_digest_type(&writer, value.ty)
    mir_digest_constant(&writer, value.value)
}

fn mir_digest_debug_int_list(values: [Int]) -> String Never! {
    rendered :: loop value in values -> "{value}"
    "[{rendered.join(", ")}]"
}

fn mir_digest_integer_range_debug(value: MIRIntegerRange?) -> String Never! {
    row :: value ?? return "None"
    "Some(MirIntegerRange {{ lo: {row.lo}, hi: {row.hi} }})"
}

fn mir_digest_effects_debug(value: MIREffectFacts) -> String Never! {
    direct := value.direct
    mir_digest_sort_strings(&direct)
    solved := value.solved
    mir_digest_sort_strings(&solved)
    call_edges := value.call_edges
    mir_digest_sort_strings(&call_edges)
    direct_spans := value.direct_spans
    mir_digest_sort_named_spans(&direct_spans)
    rendered_spans := [String]{}
    loop row in direct_spans {
        &rendered_spans.push("{mir_digest_debug_quote(row.name)}: Span {{ start: {row.span.start}, end: {row.span.end} }}")
    }
    "MirEffectFacts {{ direct: {mir_digest_debug_string_list(direct)}, solved: {mir_digest_debug_string_list(solved)}, call_edges: {mir_digest_debug_string_list(call_edges)}, maximal: {mir_digest_debug_bool(value.maximal)}, direct_spans: {{{rendered_spans.join(", ")}}} }}"
}

fn mir_digest_foreign_abi(writer: &MIRCanonicalWriter, value: MIRForeignABI) Never! {
    if value == {
        .C -> mir_digest_u64(&writer, 1)
        .CUnwind -> mir_digest_u64(&writer, 2)
        .System -> mir_digest_u64(&writer, 3)
        .Stdcall -> mir_digest_u64(&writer, 4)
        .Fastcall -> mir_digest_u64(&writer, 5)
        .Vectorcall -> mir_digest_u64(&writer, 6)
        .Rust -> mir_digest_u64(&writer, 7)
        .Platform(name) -> {
            mir_digest_u64(&writer, 8)
            mir_digest_string(&writer, name)
        }
    }
}

fn mir_digest_foreign_language(value: MIRForeignLanguage) -> Int Never! {
    if value == {
        .C -> 1
        .Cpp -> 2
        .Rust -> 3
        .Assembly -> 4
    }
}

fn mir_digest_link_artifact_kind(value: MIRLinkArtifactKind) -> Int Never! {
    if value == {
        .Object -> 1
        .StaticLibrary -> 2
        .DynamicLibrary -> 3
        .Framework -> 4
        .GeneratedSource -> 5
    }
}

fn mir_digest_handle_ownership(value: MIRHandleOwnership) -> Int Never! {
    if value == {
        .Owned -> 1
        .Shared -> 2
        .Borrowed -> 3
    }
}

fn mir_digest_link_unit(writer: &MIRCanonicalWriter, value: MIRLinkUnit) Never! {
    mir_digest_u64(&writer, value.id.value)
    mir_digest_string(&writer, value.crate_spec)
    mir_digest_string(&writer, value.cache_identity)
    mir_digest_target_applicability(&writer, value.target_applicability)
    mir_digest_len(&writer, value.artifacts.len())
    loop artifact in value.artifacts {
        mir_digest_u64(&writer, mir_digest_link_artifact_kind(artifact.kind))
        mir_digest_string(&writer, artifact.path)
    }
    mir_digest_len(&writer, value.dependency_dirs.len())
    loop path in value.dependency_dirs -> mir_digest_string(&writer, path)
    closure := value.link_closure.map(row -> row.value)
    mir_digest_sort_ints(&closure)
    mir_digest_len(&writer, closure.len())
    loop unit in closure -> mir_digest_u64(&writer, unit)
}

fn mir_digest_callback(writer: &MIRCanonicalWriter, value: MIRCallbackAdapter) Never! {
    mir_digest_u64(&writer, value.id.value)
    mir_digest_string(&writer, value.symbol)
    mir_digest_u64(&writer, value.function.value)
    mir_digest_len(&writer, value.params.len())
    loop param in value.params -> mir_digest_param(&writer, param)
    mir_digest_option_type(&writer, value.return_type)
    mir_digest_foreign_abi(&writer, value.abi)
}

fn mir_digest_handle(writer: &MIRCanonicalWriter, value: MIRHandleLifecycle) Never! {
    mir_digest_u64(&writer, value.id.value)
    mir_digest_type(&writer, value.ty)
    mir_digest_u64(&writer, mir_digest_handle_ownership(value.ownership))
    mir_digest_string(&writer, value.payload.library)
    mir_digest_string(&writer, value.payload.typedef_name)
    mir_digest_string(&writer, value.payload.close)
    mir_digest_option_int(&writer, value.close.map(row -> row.value))
    mir_digest_option_int(&writer, value.close_foreign.map(row -> row.value))
    mir_digest_option_int(&writer, value.undo.map(row -> row.value))
    mir_digest_bool(&writer, value.send)
    mir_digest_bool(&writer, value.sync)
}

fn mir_digest_prelude_family(value: MIRPreludeFamily) -> Int Never! {
    if value == {
        .MathBuiltin -> 1
        .PreciseBuiltin -> 2
        .BuiltinMethod -> 3
        .HostBorrowCallback -> 4
        .Overflow -> 5
        .HandleMethod -> 6
        .ClosureMethod -> 7
        .ColumnarAccess -> 8
        .StaticPrelude -> 9
        .Host -> 10
    }
}

fn mir_digest_prelude_abi(value: MIRPreludeABI) -> Int Never! {
    if value == {
        .Value -> 1
        .Aggregate -> 2
        .Control -> 3
        .Effect -> 4
    }
}

fn mir_digest_symbol(writer: &MIRCanonicalWriter, value: MIRSymbol) Never! {
    if value == {
        .Prelude(name) -> {
            mir_digest_tag(&writer, "prelude-symbol")
            mir_digest_string(&writer, name)
        }
        .Runtime(name) -> {
            mir_digest_tag(&writer, "runtime-symbol")
            mir_digest_string(&writer, name)
        }
    }
}

fn mir_digest_call_signature_debug(value: MIRCallSignature) -> String Never! {
    "MirCallSignature {{ arity: {value.arity}, max_arity: {value.max_arity}, borrow_mask: {mir_digest_debug_bool_list(value.borrow_mask)} }}"
}

fn mir_digest_authority(writer: &MIRCanonicalWriter, value: MIRAuthorityDecision?) Never! {
    if value == {
        None -> mir_digest_bool(&writer, false)
        Val(row) -> {
            mir_digest_bool(&writer, true)
            mir_digest_string(&writer, row.import.id)
            mir_digest_string(&writer, row.import.operation)
            mir_digest_string(&writer, row.import.required_right)
            mir_digest_len(&writer, row.import.parameter_type_ids.len())
            loop type_id in row.import.parameter_type_ids -> mir_digest_string(&writer, type_id)
            mir_digest_option_string(&writer, row.import.result_type_id)
            mir_digest_option_int(&writer, row.authority_argument)
            mir_digest_bool(&writer, row.inherited)
        }
    }
}

fn mir_digest_db_metadata_debug(value: MIRDBQueryMetadata?) -> String Never! {
    if value == {
        None -> "None"
        Val(row) -> {
            tables :: loop fact in row.table_facts -> "MirDbTableFact {{ table_id: {mir_digest_debug_quote(fact.table_id)}, read: {mir_digest_debug_bool(fact.read)}, write: {mir_digest_debug_bool(fact.write)} }}"
            "Some(MirDbQueryMetadata {{ source_file: {row.source_file.value}, source_path: {mir_digest_debug_quote(row.source_path)}, source_span: {row.source_span.start}..{row.source_span.end}, statement_identity: {mir_digest_debug_quote(row.statement_identity)}, table_facts: [{tables.join(", ")}] }})"
        }
    }
}

fn mir_digest_prelude_call(writer: &MIRCanonicalWriter, value: MIRPreludeCall) Never! {
    mir_digest_u64(&writer, value.id.value)
    mir_digest_u64(&writer, mir_digest_prelude_family(value.family))
    mir_digest_string(&writer, value.module_name)
    mir_digest_string(&writer, value.member)
    mir_digest_symbol(&writer, value.symbol)
    mir_digest_string(&writer, mir_digest_call_signature_debug(value.signature))
    mir_digest_string(&writer, mir_digest_core_effect_debug(value.effect_kind))
    mir_digest_call_fallibility(&writer, value.fallibility)
    mir_digest_u64(&writer, mir_digest_prelude_abi(value.abi))
    mir_digest_authority(&writer, value.authority)
    mir_digest_string(&writer, mir_digest_db_metadata_debug(value.db_metadata))
}

fn mir_digest_core_call_fallibility(writer: &MIRCanonicalWriter, value: CoreCallFallibility) Never! {
    if value == .Sema -> mir_digest_u64(&writer, 1)
}

fn mir_digest_core_effect_debug(value: Effect?) -> String Never! {
    effect_value :: value ?? return "None"
    name :: if effect_value == {
        .Net -> "Net"
        .FS -> "FS"
        .IO -> "IO"
        .DB -> "DB"
        .Time -> "Time"
        .Rand -> "Rand"
        .Env -> "Env"
        .Exec -> "Exec"
        .Log -> "Log"
        .GPU -> "GPU"
        .Panic -> "Panic"
        .FFI -> "FFI"
        .Browser -> "Browser"
        .Secret -> "Secret"
        .Mem -> "Mem"
    }
    "Some({name})"
}

fn mir_digest_core_sink_debug(value: SinkClass?) -> String Never! {
    if value == None -> return "None"
    "Some(Credential)"
}

fn mir_digest_core_pure_route(writer: &MIRCanonicalWriter, value: CoreCallPureRoute) Never! {
    code :: if value == {
        .NoPureRoute -> 0
        .MIME -> 1
        .Email -> 2
        .EncodingXML -> 3
        .Time -> 4
        .Math -> 5
        .Measurement -> 6
        .Date -> 7
        .DateTime -> 8
        .SketchHLL -> 9
        .SketchTDigest -> 10
        .SketchCMS -> 11
        .SketchReservoir -> 12
        .UI -> 13
        .Raylib -> 14
        .IO -> 15
        .Net -> 16
        .Crypto -> 17
    }
    mir_digest_u64(&writer, code)
}

fn mir_digest_core_interpreter_route(writer: &MIRCanonicalWriter, value: CoreCallInterpreterRoute) Never! {
    if value == {
        .NoRoute -> mir_digest_u64(&writer, 0)
        .Pure(route) -> {
            mir_digest_u64(&writer, 1)
            mir_digest_core_pure_route(&writer, route)
        }
        .Ambient -> mir_digest_u64(&writer, 2)
        .TypedIntrinsic -> mir_digest_u64(&writer, 3)
    }
}

fn mir_digest_core_symbol(writer: &MIRCanonicalWriter, value: CoreCallSymbol) Never! {
    if value == {
        .Prelude(name) -> {
            mir_digest_u64(&writer, 1)
            mir_digest_string(&writer, name)
        }
        .Rust(name) -> {
            mir_digest_u64(&writer, 2)
            mir_digest_string(&writer, name)
        }
    }
}

fn mir_digest_core_marker_debug(value: CoreMarkerApplication?) -> String Never! {
    marker :: value ?? return "None"
    "Some(CoreMarkerApplication {{ member: {mir_digest_debug_quote(marker.member)}, since: {mir_digest_debug_quote(marker.since)}, replacement: {mir_digest_debug_quote(marker.replacement)}, removed_in: {mir_digest_debug_option_string(marker.removed_in)} }})"
}

fn mir_digest_core_call(writer: &MIRCanonicalWriter, value: MIRCoreCall) Never! {
    mir_digest_u64(&writer, value.id.value)
    mir_digest_string(&writer, value.key)
    mir_digest_string(&writer, value.module_name)
    mir_digest_string(&writer, value.member)
    mir_digest_string(&writer, mir_digest_debug_string_list(value.receiver_types))
    mir_digest_len(&writer, value.arity)
    mir_digest_len(&writer, value.max_arity)
    mir_digest_string(&writer, mir_digest_debug_bool_list(value.borrow_mask))
    mir_digest_core_call_fallibility(&writer, value.fallibility)
    mir_digest_string(&writer, mir_digest_core_effect_debug(value.effect_kind))
    mir_digest_string(&writer, mir_digest_debug_option_string(value.effect_leaf))
    mir_digest_string(&writer, mir_digest_core_sink_debug(value.sink_class))
    mir_digest_core_pure_route(&writer, value.pure_route)
    mir_digest_core_interpreter_route(&writer, value.interpreter_route)
    mir_digest_core_symbol(&writer, value.symbol)
    mir_digest_u64(&writer, value.coverage_bits)
    mir_digest_bool(&writer, value.aot_direct)
    mir_digest_bool(&writer, value.jit_direct)
    mir_digest_option_string(&writer, value.jit_symbol)
    mir_digest_string(&writer, mir_digest_core_marker_debug(value.marker))
}

fn mir_digest_foreign(writer: &MIRCanonicalWriter, value: MIRForeign) Never! {
    mir_digest_u64(&writer, value.id.value)
    mir_digest_u64(&writer, value.module_id.value)
    mir_digest_string(&writer, value.key)
    mir_digest_string(&writer, value.module_name)
    mir_digest_string(&writer, value.name)
    mir_digest_span(&writer, value.span)
    mir_digest_string(&writer, value.symbol)
    mir_digest_string(&writer, value.path)
    mir_digest_len(&writer, value.params.len())
    loop param in value.params -> mir_digest_param(&writer, param)
    mir_digest_bool(&writer, value.bridge_eligible)
    mir_digest_option_type(&writer, value.return_type)
    mir_digest_foreign_abi(&writer, value.foreign_abi)
    mir_digest_u64(&writer, mir_digest_foreign_language(value.foreign_language))
    mir_digest_target_applicability(&writer, value.target_applicability)
    mir_digest_string(&writer, mir_digest_effects_debug(value.effects))
    mir_digest_option_int(&writer, value.link.map(row -> row.value))
    mir_digest_option_int(&writer, value.callback.map(row -> row.value))
    mir_digest_option_int(&writer, value.handle.map(row -> row.value))
    mir_digest_option_int(&writer, value.close_function.map(row -> row.value))
    mir_digest_option_int(&writer, value.close_foreign.map(row -> row.value))
    mir_digest_option_int(&writer, value.undo_function.map(row -> row.value))
}

