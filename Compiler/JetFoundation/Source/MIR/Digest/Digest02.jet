// Rust: crates/jet-foundation/src/MIROptimization.rs:14539
fn encode_semantic_operation(writer: &MIRCanonicalWriter, operation: MIRSemanticOp) Never! {
    if operation == {
        .DataEntriesToMap(call, local) -> {
            mir_digest_tag(&writer, "data-entries-to-map")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, local.value)
        }
        .MathBuiltin(type_id, call, args) -> {
            mir_digest_tag(&writer, "math-builtin")
            mir_digest_u64(&writer, type_id.value)
            mir_digest_u64(&writer, call.value)
            mir_digest_values(&writer, args)
        }
        .PreciseBuiltin(type_id, call, args) -> {
            mir_digest_tag(&writer, "precise-builtin")
            mir_digest_u64(&writer, type_id.value)
            mir_digest_u64(&writer, call.value)
            mir_digest_values(&writer, args)
        }
        .Print(call, value) -> {
            mir_digest_tag(&writer, "print")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, value.value)
        }
        .AmbientInput(call, prompt) -> {
            mir_digest_tag(&writer, "ambient-input")
            mir_digest_u64(&writer, call.value)
            mir_digest_option_u64(&writer, prompt.map(value -> value.value))
        }
        .RequireStop(call, kind, condition, location, context, values, always_stops) -> {
            mir_digest_tag(&writer, "require-stop")
            mir_digest_u64(&writer, call.value)
            mir_digest_require_kind(&writer, kind)
            mir_digest_option_u64(&writer, condition.map(value -> value.value))
            mir_digest_panic_location(&writer, location)
            mir_digest_panic_context(&writer, context)
            mir_digest_values(&writer, values)
            mir_digest_bool(&writer, always_stops)
        }
        .LayoutCompare(call, op, left, right) -> {
            mir_digest_tag(&writer, "layout-compare")
            mir_digest_u64(&writer, call.value)
            mir_digest_layout_compare(&writer, op)
            mir_digest_u64(&writer, left.value)
            mir_digest_u64(&writer, right.value)
        }
        .LayoutLiteral(inner) -> {
            mir_digest_tag(&writer, "layout-literal")
            mir_digest_u64(&writer, inner.value)
        }
        .StructLiteral(type_id, fields, extra, trait_coercion, boxed_fields) -> {
            mir_digest_tag(&writer, "struct-literal")
            mir_digest_u64(&writer, type_id.value)
            mir_digest_len(&writer, fields.len())
            loop field in fields {
                mir_digest_u64(&writer, field.field.value)
                mir_digest_u64(&writer, field.value.value)
            }
            mir_digest_struct_extra(&writer, extra)
            mir_digest_option_u64(&writer, trait_coercion.map(ty -> ty.value))
            mir_digest_len(&writer, boxed_fields.len())
            loop field in boxed_fields -> mir_digest_u64(&writer, field.value)
        }
        .ReflectOf(type_name, path, display, fields) -> {
            mir_digest_tag(&writer, "reflect-of")
            mir_digest_string(&writer, type_name)
            mir_digest_string(&writer, path)
            mir_digest_u64(&writer, display.value)
            mir_digest_len(&writer, fields.len())
            loop field in fields {
                mir_digest_string(&writer, field.name)
                mir_digest_string(&writer, field.type_name)
                mir_digest_string(&writer, field.path)
                mir_digest_u64(&writer, field.value.value)
            }
        }
        .CellGuardProject(map_call, split_call, guard, paths, editable, edit_paths_disjoint) -> {
            mir_digest_tag(&writer, "cell-guard-project")
            mir_digest_u64(&writer, map_call.value)
            mir_digest_option_u64(&writer, split_call.map(call -> call.value))
            mir_digest_u64(&writer, guard.value)
            mir_digest_field_paths(&writer, paths)
            mir_digest_bool(&writer, editable)
            mir_digest_bool(&writer, edit_paths_disjoint)
        }
        .SharedGuardMap(call, guard, path, editable) -> {
            mir_digest_tag(&writer, "shared-guard-map")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, guard.value)
            mir_digest_field_path(&writer, path)
            mir_digest_bool(&writer, editable)
        }
        .SharedGuardSplit(call, map_call, guard, first, second, editable) -> {
            mir_digest_tag(&writer, "shared-guard-split")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, map_call.value)
            mir_digest_u64(&writer, guard.value)
            mir_digest_len(&writer, 2)
            mir_digest_field_path(&writer, first)
            mir_digest_field_path(&writer, second)
            mir_digest_bool(&writer, editable)
        }
        .SharedGuardWait(call, guard, condition, predicate) -> {
            mir_digest_tag(&writer, "shared-guard-wait")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, guard.value)
            mir_digest_u64(&writer, condition.value)
            mir_digest_u64(&writer, predicate.value)
        }
        .ConditionNotify(call, condition, all) -> {
            mir_digest_tag(&writer, "condition-notify")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, condition.value)
            mir_digest_bool(&writer, all)
        }
        .AllocNew(call, kind, inline_size, args) -> {
            mir_digest_tag(&writer, "alloc-new")
            mir_digest_u64(&writer, call.value)
            mir_digest_allocator(&writer, kind)
            mir_digest_option_int(&writer, inline_size)
            mir_digest_call_args(&writer, args)
        }
        .ColumnarRead(base, index, column, column_index, accessor) -> {
            mir_digest_tag(&writer, "columnar-read")
            mir_digest_u64(&writer, base.value)
            mir_digest_u64(&writer, index.value)
            mir_digest_u64(&writer, column.value)
            mir_digest_len(&writer, column_index)
            mir_digest_u64(&writer, accessor.value)
        }
        .StaticPreludeCall(call, args, owner_type_args, type_args) -> {
            mir_digest_tag(&writer, "static-prelude-call")
            mir_digest_u64(&writer, call.value)
            mir_digest_call_args(&writer, args)
            mir_digest_len(&writer, owner_type_args.len())
            loop type_arg in owner_type_args {
                if type_arg == {
                    .Type(ty) -> { mir_digest_tag(&writer, "type"); mir_digest_type(&writer, ty) }
                    .HostUsize -> mir_digest_tag(&writer, "host-usize")
                }
            }
            mir_digest_len(&writer, type_args.len())
            loop type_arg in type_args -> mir_digest_type(&writer, type_arg)
        }
        .DecodeUnder(call, segment, inner) -> {
            mir_digest_tag(&writer, "decode-under")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, segment.value)
            mir_digest_u64(&writer, inner.value)
        }
        .HardwareCall(call, op, receiver, args) -> {
            mir_digest_tag(&writer, "hardware-call")
            mir_digest_u64(&writer, call.value)
            mir_digest_hardware_op(&writer, op)
            mir_digest_option_u64(&writer, receiver.map(value -> value.value))
            mir_digest_call_args(&writer, args)
        }
        .BuiltinMethod(call, receiver, receiver_place, args, aggregate_fields) -> {
            mir_digest_tag(&writer, "builtin-method")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, receiver.value)
            mir_digest_option_u64(&writer, receiver_place.map(place -> place.value))
            mir_digest_values(&writer, args)
            if aggregate_fields == {
                Val(fields) -> { mir_digest_bool(&writer, true); mir_digest_field_path(&writer, fields) }
                None -> mir_digest_bool(&writer, false)
            }
        }
        .OptionLift2(call, function, left, right) -> {
            mir_digest_tag(&writer, "option-lift2")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, function.value)
            mir_digest_u64(&writer, left.value)
            mir_digest_u64(&writer, right.value)
        }
        .ClosureMethod(receiver, args, call) -> {
            mir_digest_tag(&writer, "closure-method")
            mir_digest_u64(&writer, receiver.value)
            mir_digest_u64(&writer, call.value)
            mir_digest_call_args(&writer, args)
        }
        .HostBorrowCallback(callable, params) -> {
            mir_digest_tag(&writer, "host-borrow-callback")
            mir_digest_u64(&writer, callable.value)
            mir_digest_len(&writer, params.len())
            loop param in params -> mir_digest_type(&writer, param)
        }
        .TextPatternMatch(call, subject, parts) -> {
            mir_digest_tag(&writer, "text-pattern-match")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, subject.value)
            mir_digest_text_pattern_parts(&writer, parts)
        }
        .BinaryPatternMatch(call, subject, parts) -> {
            mir_digest_tag(&writer, "binary-pattern-match")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, subject.value)
            mir_digest_binary_pattern_parts(&writer, parts)
        }
        .CursorTakePattern(receiver, receiver_place, parts) -> {
            mir_digest_tag(&writer, "cursor-take-pattern")
            mir_digest_u64(&writer, receiver.value)
            mir_digest_u64(&writer, receiver_place.value)
            mir_digest_text_pattern_parts(&writer, parts)
        }
        .ReaderTakePattern(receiver, receiver_place, parts) -> {
            mir_digest_tag(&writer, "reader-take-pattern")
            mir_digest_u64(&writer, receiver.value)
            mir_digest_u64(&writer, receiver_place.value)
            mir_digest_binary_pattern_parts(&writer, parts)
        }
        .NumericMethod(call, receiver) -> {
            mir_digest_tag(&writer, "numeric-method")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, receiver.value)
        }
        .NumericBinaryMethod(call, receiver, argument) -> {
            mir_digest_tag(&writer, "numeric-binary-method")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, receiver.value)
            mir_digest_u64(&writer, argument.value)
        }
        .OverflowOption(call, left, right, location) -> {
            mir_digest_tag(&writer, "overflow-option")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, left.value)
            mir_digest_u64(&writer, right.value)
            if location == {
                Val(location) -> { mir_digest_bool(&writer, true); mir_digest_panic_location(&writer, location) }
                None -> mir_digest_bool(&writer, false)
            }
        }
        .HandleMethod(call, receiver, args, frame_schedule, frame_schedule_derivation) -> {
            mir_digest_tag(&writer, "handle-method")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, receiver.value)
            mir_digest_values(&writer, args)
            if frame_schedule == {
                Val(schedule) -> { mir_digest_bool(&writer, true); mir_digest_string(&writer, mir_frame_schedule_json(schedule)) }
                None -> mir_digest_bool(&writer, false)
            }
            if frame_schedule_derivation == {
                Val(reference) -> { mir_digest_bool(&writer, true); mir_digest_string(&writer, reference.id) }
                None -> mir_digest_bool(&writer, false)
            }
        }
        .PluginInvoke(call, handle, export_name, signature, args) -> {
            mir_digest_tag(&writer, "plugin-invoke")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, handle.value)
            mir_digest_string(&writer, export_name)
            mir_digest_component_signature(&writer, signature)
            mir_digest_values(&writer, args)
        }
        .HTTPRouterRegister(call, receiver, path, handler, method, handler_param_names, contract_json, location) -> {
            mir_digest_tag(&writer, "http-router-register")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, receiver.value)
            mir_digest_u64(&writer, path.value)
            mir_digest_u64(&writer, handler.value)
            mir_digest_string(&writer, mir_digest_http_method(method))
            mir_digest_app_string_list(&writer, handler_param_names)
            mir_digest_string(&writer, contract_json)
            mir_digest_panic_location(&writer, location)
        }
        .CoreClosureCall(call, kind, values, closure, site, label) -> {
            mir_digest_tag(&writer, "core-closure-call")
            mir_digest_u64(&writer, call.value)
            mir_digest_core_closure(&writer, kind)
            mir_digest_values(&writer, values)
            mir_digest_option_u64(&writer, closure.map(value -> value.value))
            mir_digest_u64(&writer, site.value)
            mir_digest_string(&writer, label)
        }
        .TaskGroup(call, kind, tasks) -> {
            mir_digest_tag(&writer, "task-group")
            mir_digest_u64(&writer, call.value)
            mir_digest_task_group(&writer, kind)
            mir_digest_values(&writer, tasks)
        }
        .Select(call, kind, values) -> {
            mir_digest_tag(&writer, "select")
            mir_digest_u64(&writer, call.value)
            mir_digest_select(&writer, kind)
            mir_digest_values(&writer, values)
        }
        .PolicyFunction(policy, values) -> {
            mir_digest_tag(&writer, "policy-function")
            mir_digest_u64(&writer, policy.value)
            mir_digest_values(&writer, values)
        }
        .InterruptFunction(interrupt, values) -> {
            mir_digest_tag(&writer, "interrupt-function")
            mir_digest_u64(&writer, interrupt.value)
            mir_digest_values(&writer, values)
        }
        .CarrierFact(call, receiver, field, notes) -> {
            mir_digest_tag(&writer, "carrier-fact")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, receiver.value)
            mir_digest_u64(&writer, field.value)
            mir_digest_bool(&writer, notes)
        }
        .GCEdit(call, root, edges, edit, index, kind, site) -> {
            mir_digest_tag(&writer, "gc-edit")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, root.value)
            mir_digest_values(&writer, edges)
            mir_digest_u64(&writer, edit.value)
            mir_digest_option_u64(&writer, index.map(value -> value.value))
            mir_digest_gc_edit(&writer, kind)
            mir_digest_u64(&writer, site.value)
        }
        .TypedTextInterp(call, kind, literals, holes, trusted_html) -> {
            mir_digest_tag(&writer, "typed-text-interp")
            mir_digest_u64(&writer, call.value)
            mir_digest_typed_head(&writer, kind)
            mir_digest_len(&writer, literals.len())
            loop literal in literals -> mir_digest_string(&writer, literal)
            mir_digest_values(&writer, holes)
            mir_digest_len(&writer, trusted_html.len())
            loop trusted in trusted_html -> mir_digest_bool(&writer, trusted)
        }
        .CCallback(call, callback, lambda) -> {
            mir_digest_tag(&writer, "c-callback")
            mir_digest_u64(&writer, call.value)
            mir_digest_u64(&writer, callback.value)
            mir_digest_u64(&writer, lambda.value)
        }
        .HostCall(call, args) -> {
            mir_digest_tag(&writer, "host-call")
            mir_digest_u64(&writer, call.value)
            mir_digest_call_args(&writer, args)
        }
    }
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:15072
// encode_shape_field_names -> Digest.jet::mir_digest_shape_field_names (eleven codec names).
// Rust: crates/jet-foundation/src/MIROptimization.rs:15089
// encode_field -> Digest.jet::mir_digest_field (ID/names/type/span and all flags).

// Rust: crates/jet-foundation/src/MIROptimization.rs:15102
fn encode_type_def_kind(writer: &MIRCanonicalWriter, kind: MIRTypeDefKind) Never! {
    if kind == {
        .Struct(fields, methods) -> {
            mir_digest_tag(&writer, "struct")
            mir_digest_len(&writer, fields.len())
            loop field in fields -> mir_digest_field(&writer, field)
            rendered :: loop method in methods -> "MirFunctionId({method.value})"
            mir_digest_string(&writer, "[{rendered.join(", ")}]")
        }
        .Enum(variants, methods) -> {
            mir_digest_tag(&writer, "enum")
            mir_digest_len(&writer, variants.len())
            loop variant in variants {
                mir_digest_string(&writer, variant.name)
                mir_digest_string(&writer, variant.wire_name)
                mir_digest_span(&writer, variant.span)
                mir_digest_variant_payload(&writer, variant.payload)
                mir_digest_option_int(&writer, variant.discriminant)
            }
            rendered :: loop method in methods -> "MirFunctionId({method.value})"
            mir_digest_string(&writer, "[{rendered.join(", ")}]")
        }
        .Distinct(base, range) -> {
            mir_digest_tag(&writer, "distinct")
            mir_digest_type(&writer, base)
            mir_digest_string(&writer, mir_digest_integer_range_debug(range))
        }
        .Alias(target) -> { mir_digest_tag(&writer, "alias"); mir_digest_type(&writer, target) }
        .UnitFamily(members) -> {
            mir_digest_tag(&writer, "unit-family")
            mir_digest_string(&writer, mir_digest_debug_string_list(members))
        }
    }
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:15159
// encode_param -> Digest.jet::mir_digest_param (index/name/span/type/access/ownership/label).
// Rust: crates/jet-foundation/src/MIROptimization.rs:15169
// encode_capture_param -> Digest.jet::mir_digest_capture_param (slot/name/span/type/access/ownership).

// Rust: crates/jet-foundation/src/MIROptimization.rs:15181
fn encode_foreign(writer: &MIRCanonicalWriter, foreign: MIRForeign) Never! {
    mir_digest_u64(&writer, foreign.id.value)
    mir_digest_u64(&writer, foreign.module_id.value)
    mir_digest_string(&writer, foreign.key)
    mir_digest_string(&writer, foreign.module_name)
    mir_digest_string(&writer, foreign.name)
    mir_digest_span(&writer, foreign.span)
    mir_digest_string(&writer, foreign.symbol)
    mir_digest_string(&writer, foreign.path)
    mir_digest_len(&writer, foreign.params.len())
    loop param in foreign.params -> mir_digest_param(&writer, param)
    mir_digest_option_type(&writer, foreign.return_type)
    mir_digest_foreign_abi(&writer, foreign.foreign_abi)
    mir_digest_int(&writer, mir_digest_foreign_language(foreign.foreign_language))
    mir_digest_target_applicability(&writer, foreign.target_applicability)
    encode_effects(&writer, foreign.effects)
    mir_digest_option_u64(&writer, foreign.link.map(link -> link.value))
    mir_digest_option_u64(&writer, foreign.callback.map(callback -> callback.value))
    mir_digest_option_u64(&writer, foreign.handle.map(handle -> handle.value))
    mir_digest_option_u64(&writer, foreign.close_function.map(function -> function.value))
    mir_digest_option_u64(&writer, foreign.close_foreign.map(foreign -> foreign.value))
    mir_digest_option_u64(&writer, foreign.undo_function.map(function -> function.value))
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:15213
// encode_failure_carrier -> Digest.jet::mir_digest_failure_carrier (infallible/result/optional/diverges).
// Rust: crates/jet-foundation/src/MIROptimization.rs:15232
// encode_call_fallibility -> Digest.jet::mir_digest_call_fallibility (infallible/failure).
// Rust: crates/jet-foundation/src/MIROptimization.rs:15242
// encode_core_call_fallibility -> Digest.jet::mir_digest_core_call_fallibility (Sema=1).

// Rust: crates/jet-foundation/src/MIROptimization.rs:15248
fn encode_core_call(writer: &MIRCanonicalWriter, call: MIRCoreCall) Never! {
    mir_digest_u64(&writer, call.id.value)
    mir_digest_string(&writer, call.key)
    mir_digest_string(&writer, call.module_name)
    mir_digest_string(&writer, call.member)
    mir_digest_string(&writer, mir_digest_debug_string_list(call.receiver_types))
    mir_digest_len(&writer, call.arity)
    mir_digest_len(&writer, call.max_arity)
    mir_digest_string(&writer, mir_digest_debug_bool_list(call.borrow_mask))
    mir_digest_core_call_fallibility(&writer, call.fallibility)
    mir_digest_string(&writer, mir_digest_core_effect_debug(call.effect_kind))
    mir_digest_string(&writer, mir_digest_debug_option_string(call.effect_leaf))
    mir_digest_string(&writer, mir_digest_core_sink_debug(call.sink_class))
    mir_digest_core_pure_route(&writer, call.pure_route)
    mir_digest_core_interpreter_route(&writer, call.interpreter_route)
    mir_digest_core_symbol(&writer, call.symbol)
    mir_digest_int(&writer, call.coverage_bits)
    mir_digest_bool(&writer, call.aot_direct)
    mir_digest_bool(&writer, call.jit_direct)
    mir_digest_option_string(&writer, call.jit_symbol)
    mir_digest_bool(&writer, call.native_int_result)
    mir_digest_string(&writer, mir_digest_core_marker_debug(call.marker))
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:15271
// encode_authority -> Digest.jet::mir_digest_authority (import/argument/inheritance fields).

// Rust: crates/jet-foundation/src/MIROptimization.rs:15293
fn encode_prelude_call(writer: &MIRCanonicalWriter, call: MIRPreludeCall) Never! {
    mir_digest_u64(&writer, call.id.value)
    mir_digest_int(&writer, mir_digest_prelude_family(call.family))
    mir_digest_string(&writer, call.module_name)
    mir_digest_string(&writer, call.member)
    mir_digest_symbol(&writer, call.symbol)
    mir_digest_string(&writer, mir_digest_call_signature_debug(call.signature))
    mir_digest_string(&writer, mir_digest_core_effect_debug(call.effect_kind))
    mir_digest_call_fallibility(&writer, call.fallibility)
    mir_digest_int(&writer, mir_digest_prelude_abi(call.abi))
    mir_digest_authority(&writer, call.authority)
    if call.db_metadata == {
        Val(metadata) -> {
            mir_digest_bool(&writer, true)
            mir_digest_u64(&writer, metadata.source_file.value)
            mir_digest_string(&writer, metadata.source_path)
            mir_digest_span(&writer, metadata.source_span)
            mir_digest_string(&writer, metadata.statement_identity)
            mir_digest_len(&writer, metadata.table_facts.len())
            loop fact in metadata.table_facts {
                mir_digest_string(&writer, fact.table_id)
                mir_digest_bool(&writer, fact.read)
                mir_digest_bool(&writer, fact.write)
            }
        }
        None -> mir_digest_bool(&writer, false)
    }
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:15331
// encode_function_form -> Digest.jet::mir_digest_function_form (top-level/method/trait-method).
// Rust: crates/jet-foundation/src/MIROptimization.rs:15357
// encode_web_param_reconstruction -> Digest.jet::mir_digest_web_param_reconstruction (local/type/field rows).
// Rust: crates/jet-foundation/src/MIROptimization.rs:15371
// encode_local -> Digest.jet::mir_digest_local (all ownership, mutability, view and GC flags).
