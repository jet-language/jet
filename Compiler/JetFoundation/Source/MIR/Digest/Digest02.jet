// Rust: crates/jet-foundation/src/MIROptimization.rs:14113
fn encode_artifact(writer: &MIRCanonicalWriter, artifact: MIRArtifactPlan) Never! {
    mir_digest_u64(&writer, artifact.id.value)
    mir_digest_int(&writer, mir_digest_artifact_kind(artifact.kind))
    mir_digest_string(&writer, artifact.name)
    mir_digest_int(&writer, mir_digest_artifact_target(artifact.target))
    mir_digest_int(&writer, mir_digest_artifact_mode(artifact.mode))
    modules :: artifact.modules.map(row -> row.value)
    mir_digest_len(&writer, modules.len())
    loop position in mir_digest_sort_ids(modules) -> mir_digest_u64(&writer, modules[position])
    links :: artifact.links.map(row -> row.value)
    mir_digest_len(&writer, links.len())
    loop position in mir_digest_sort_ids(links) -> mir_digest_u64(&writer, links[position])
    jobs :: artifact.jobs.map(row -> row.value)
    mir_digest_len(&writer, jobs.len())
    loop position in mir_digest_sort_ids(jobs) -> mir_digest_u64(&writer, jobs[position])
    encode_runtime_parts(&writer, artifact.runtime_parts)
    mir_digest_len(&writer, artifact.exports.len())
    loop position in mir_digest_sort_exports(artifact.exports) -> mir_digest_export(&writer, artifact.exports[position])
    mir_digest_string(&writer, artifact.provider_identity)
    mir_digest_string(&writer, artifact.closure_identity)
    mir_digest_string(&writer, artifact.artifact_identity)
    if artifact.entry == {
        Val(entry) -> { mir_digest_bool(&writer, true); mir_digest_entry_spec(&writer, entry) }
        None -> mir_digest_bool(&writer, false)
    }
    mir_digest_option_u64(&writer, artifact.harness.map(row -> row.value))
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:14162
// encode_callee -> Digest.jet::mir_digest_callee (all eight callee arms).
// Rust: crates/jet-foundation/src/MIROptimization.rs:14203
// encode_data_plan_stream -> Digest.jet::mir_digest_data_plan_stream (bounded/materialized).

// Rust: crates/jet-foundation/src/MIROptimization.rs:14219
fn encode_data_plan(writer: &MIRCanonicalWriter, plan: MIRDataPlan) Never! {
    mir_digest_u16(&writer, plan.schema_version)
    mir_digest_string(&writer, encode_data_plan_source_name(plan.source))
    mir_digest_len(&writer, plan.logical.len())
    loop node in plan.logical {
        mir_digest_u64(&writer, node.id.value)
        mir_digest_string(&writer, if node.operation == {
            .Scan -> "scan"
            .Filter -> "filter"
            .SortBy -> "sort_by"
            .InnerJoin -> "inner_join"
            .LeftJoin -> "left_join"
            .Group -> "group"
            .Window -> "window"
            .Project -> "project"
            .Collect -> "collect"
        })
        mir_digest_len(&writer, node.inputs.len())
        loop input in node.inputs -> mir_digest_u64(&writer, input.value)
        mir_digest_option_string(&writer, node.source.map(source -> encode_data_plan_source_name(source)))
        mir_digest_type(&writer, node.row_type)
        mir_digest_len(&writer, node.columns.len())
        loop column in node.columns {
            mir_digest_string(&writer, column.name)
            mir_digest_type(&writer, column.ty)
            mir_digest_bool(&writer, column.nullable)
        }
        if node.callable == {
            Val(callable) -> {
                mir_digest_bool(&writer, true)
                mir_digest_string(&writer, callable.label)
                mir_digest_type(&writer, callable.parameter)
                mir_digest_type(&writer, callable.result)
                mir_digest_span(&writer, callable.span)
            }
            None -> mir_digest_bool(&writer, false)
        }
        mir_digest_data_plan_stream(&writer, node.stream)
        mir_digest_span(&writer, node.span)
    }
    mir_digest_len(&writer, plan.physical.len())
    loop node in plan.physical {
        mir_digest_u64(&writer, node.logical.value)
        mir_digest_string(&writer, if node.operator == {
            .Scan -> "scan"
            .Filter -> "filter"
            .SortBy -> "sort_by"
            .InnerJoin -> "inner_join"
            .LeftJoin -> "left_join"
            .Group -> "group"
            .Window -> "window"
            .Project -> "project"
            .Batch -> "batch"
            .Materialize -> "materialize"
        })
        mir_digest_data_plan_stream(&writer, node.stream)
        mir_digest_string(&writer, node.reason)
    }
    mir_digest_u64(&writer, plan.output.value)
    mir_digest_span(&writer, plan.source_span)
}

// Rust: crates/jet-foundation/src/AST/data_plan.rs:85
fn encode_data_plan_source_name(source: MIRDataPlanSourceKind) -> String Never! {
    if source == {
        .Table -> "table"
        .Series -> "series"
        .CSV -> "csv"
        .JSON -> "json"
        .JSONL -> "jsonl"
        .Parquet -> "parquet"
        .Arrow -> "arrow"
        .Loader -> "loader"
        .CSVReader -> "csv_reader"
        .JSONReader -> "json_reader"
    }
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:14262
// encode_call_args -> Digest.jet::mir_digest_call_args (all coercion/presence fields).

// Rust: crates/jet-foundation/src/MIROptimization.rs:14310
fn encode_conversion(writer: &MIRCanonicalWriter, conversion: MIRConversion) Never! {
    if conversion == {
        .Transparent -> mir_digest_tag(&writer, "transparent")
        .NumericCast -> mir_digest_tag(&writer, "numeric-cast")
        .SendFn -> mir_digest_tag(&writer, "send-fn")
        .Prelude(call, location, fallibility) -> {
            mir_digest_tag(&writer, "prelude")
            mir_digest_u64(&writer, call.value)
            mir_digest_string(&writer, "MirPanicLoc {{ file: MirSourceFileId({location.file.value}), line: {location.line}, column: {location.column} }}")
            mir_digest_call_fallibility(&writer, fallibility)
        }
    }
}

