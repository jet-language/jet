// Canonical MIR encoding continuation. Exact existing encoders remain in Digest.jet;
// the Rust anchors below name those owners instead of duplicating their bodies.
use jet_foundation.[TEXT_NUL, encode_effects]

// Rust: crates/jet-foundation/src/MIROptimization.rs:13607
// encode_handle -> Digest.jet::mir_digest_handle (all lifecycle fields, in wire order).
// Rust: crates/jet-foundation/src/MIROptimization.rs:13621
// encode_cli_input -> Digest.jet::mir_digest_cli_input (shape/default arms and optional fields).
// Rust: crates/jet-foundation/src/MIROptimization.rs:13655
// encode_cli_entry -> Digest.jet::mir_digest_cli_entry (inputs, commands, standard).
// Rust: crates/jet-foundation/src/MIROptimization.rs:13675
// encode_entry_spec -> Digest.jet::mir_digest_entry_spec (CLI presence and initialization flags).

// Rust: crates/jet-foundation/src/MIROptimization.rs:13692
fn encode_runtime_parts(writer: &MIRCanonicalWriter, values: [MIRRuntimePartID]) Never! {
    mir_digest_len(&writer, values.len())
    // Rust receives a BTreeSet: GC is first, independently of its wire code.
    loop position in mir_digest_sort_runtime_parts(values) -> mir_digest_int(&writer, mir_digest_runtime_part(values[position]))
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:13698
fn encode_hardware_setups(writer: &MIRCanonicalWriter, setups: [MIRHardwareSetup]) Never! {
    // The Rust key is formatted text, not a tuple: vector 10 precedes vector 2.
    keys :: loop setup in setups -> if setup == {
        .DMAConfigure(profile_id, channel, transfer_width, ownership) -> "dma-configure{TEXT_NUL}{profile_id}{TEXT_NUL}{channel}{TEXT_NUL}{mir_digest_register_width(transfer_width)}{TEXT_NUL}{mir_digest_dma_ownership(ownership)}"
        .InterruptBind(profile_id, interrupt, vector, handler_symbol, forbidden_effects) -> "interrupt-bind{TEXT_NUL}{profile_id}{TEXT_NUL}{interrupt}{TEXT_NUL}{vector}{TEXT_NUL}{handler_symbol}{TEXT_NUL}{forbidden_effects.join(TEXT_NUL)}"
    }
    mir_digest_len(&writer, setups.len())
    loop position in mir_digest_sort_strings(keys) {
        if setups[position] == {
            .DMAConfigure(profile_id, channel, transfer_width, ownership) -> {
                mir_digest_tag(&writer, "dma-configure")
                mir_digest_string(&writer, profile_id)
                mir_digest_string(&writer, channel)
                mir_digest_string(&writer, mir_digest_register_width(transfer_width))
                mir_digest_string(&writer, mir_digest_dma_ownership(ownership))
            }
            .InterruptBind(profile_id, interrupt, vector, handler_symbol, forbidden_effects) -> {
                mir_digest_tag(&writer, "interrupt-bind")
                mir_digest_string(&writer, profile_id)
                mir_digest_string(&writer, interrupt)
                mir_digest_u16(&writer, vector)
                mir_digest_string(&writer, handler_symbol)
                mir_digest_len(&writer, forbidden_effects.len())
                loop effect in mir_digest_sort_strings(forbidden_effects) -> mir_digest_string(&writer, forbidden_effects[effect])
            }
        }
    }
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:13759
fn encode_target_hardware_facts(writer: &MIRCanonicalWriter, facts: MIRTargetHardwareFacts) Never! {
    if facts.svd == {
        Val(svd) -> {
            mir_digest_bool(&writer, true)
            mir_digest_string(&writer, svd.source)
            mir_digest_string(&writer, svd.sha256)
        }
        None -> mir_digest_bool(&writer, false)
    }
    blocks := [Int]{}
    loop index in 0..<facts.register_blocks.len() -> &blocks.push(index)
    &blocks.sort_by((left: Int, right: Int) -> {
        a :: facts.register_blocks[left]
        b :: facts.register_blocks[right]
        if a.name != b.name -> return a.name <=> b.name
        if a.base != b.base -> return a.base <=> b.base
        a.size.bytes <=> b.size.bytes
    })
    mir_digest_len(&writer, blocks.len())
    loop position in blocks {
        block :: facts.register_blocks[position]
        mir_digest_string(&writer, block.name)
        mir_digest_int(&writer, block.base)
        mir_digest_int(&writer, block.size.bytes)
        registers := [Int]{}
        loop index in 0..<block.registers.len() -> &registers.push(index)
        &registers.sort_by((left: Int, right: Int) -> {
            a :: block.registers[left]
            b :: block.registers[right]
            if a.name != b.name -> return a.name <=> b.name
            if a.offset != b.offset -> return a.offset <=> b.offset
            aw :: mir_digest_register_width(a.width)
            bw :: mir_digest_register_width(b.width)
            if aw != bw -> return aw <=> bw
            aa :: mir_digest_register_access_mode(a.access)
            ba :: mir_digest_register_access_mode(b.access)
            if aa != ba -> return aa <=> ba
            mir_digest_bool_order(a.volatile) <=> mir_digest_bool_order(b.volatile)
        })
        mir_digest_len(&writer, registers.len())
        loop register_position in registers {
            register :: block.registers[register_position]
            mir_digest_string(&writer, register.name)
            mir_digest_int(&writer, register.offset)
            mir_digest_string(&writer, mir_digest_register_width(register.width))
            mir_digest_string(&writer, mir_digest_register_access_mode(register.access))
            mir_digest_bool(&writer, register.volatile)
        }
    }
    interrupts := [Int]{}
    loop index in 0..<facts.interrupts.len() -> &interrupts.push(index)
    &interrupts.sort_by((left: Int, right: Int) -> {
        a :: facts.interrupts[left]
        b :: facts.interrupts[right]
        if a.name != b.name -> return a.name <=> b.name
        a.vector <=> b.vector
    })
    mir_digest_len(&writer, interrupts.len())
    loop position in interrupts {
        interrupt :: facts.interrupts[position]
        mir_digest_string(&writer, interrupt.name)
        mir_digest_u16(&writer, interrupt.vector)
        mir_digest_len(&writer, interrupt.forbidden_effects.len())
        loop effect in interrupt.forbidden_effects -> mir_digest_string(&writer, effect)
        mir_digest_bool(&writer, interrupt.bounded)
    }
    channels := [Int]{}
    loop index in 0..<facts.dma_channels.len() -> &channels.push(index)
    &channels.sort_by((left: Int, right: Int) -> {
        a :: facts.dma_channels[left]
        b :: facts.dma_channels[right]
        if a.name != b.name -> return a.name <=> b.name
        if a.channel != b.channel -> return a.channel <=> b.channel
        aw :: mir_digest_register_width(a.transfer_width)
        bw :: mir_digest_register_width(b.transfer_width)
        if aw != bw -> return aw <=> bw
        ao :: mir_digest_dma_ownership(a.ownership)
        bo :: mir_digest_dma_ownership(b.ownership)
        if ao != bo -> return ao <=> bo
        if a.max_transfer_bytes == {
            None -> if b.max_transfer_bytes == None -> Ordering.Equal else -> Ordering.Less
            Val(av) -> if b.max_transfer_bytes == {
                None -> Ordering.Greater
                Val(bv) -> av <=> bv
            }
        }
    })
    mir_digest_len(&writer, channels.len())
    loop position in channels {
        channel :: facts.dma_channels[position]
        mir_digest_string(&writer, channel.name)
        mir_digest_u16(&writer, channel.channel)
        mir_digest_string(&writer, mir_digest_register_width(channel.transfer_width))
        mir_digest_string(&writer, mir_digest_dma_ownership(channel.ownership))
        mir_digest_option_int(&writer, channel.max_transfer_bytes)
    }
}

