// Deterministic diagnostic repair-coverage facts and ratchet validation.
use JetFoundation.Report.[NoFixReasonKind, ReportEnvelope]
use JetFoundation.JSON.[quote]

// Rust: crates/jet-foundation/src/Coverage.rs:8
pub struct CoverageEntry {
    pub plane: String
    pub fix_edits: Bool
    pub no_fix_reason: NoFixReasonKind?
}
impl CoverageEntry {
    // Rust: crates/jet-foundation/src/Coverage.rs:15
    pub fn new(plane: String, fix_edits: Bool, no_fix_reason: NoFixReasonKind?) -> CoverageEntry Never! {
        CoverageEntry{plane: plane, fix_edits: fix_edits, no_fix_reason: no_fix_reason}
    }
    // Rust: crates/jet-foundation/src/Coverage.rs:27
    pub fn from_report(plane: String, report: ReportEnvelope) -> CoverageEntry Never! {
        reason := None
        if report.no_fix_reason() == .Val(value) { reason = Val(value.kind) }
        CoverageEntry.new(plane, !report.fix_edits().is_empty(), reason)
    }
}
// Rust: crates/jet-foundation/src/Coverage.rs:37
pub struct CoverageFact {
    pub plane: String = ""
    pub rows: Int = 0
    pub edit_covered: Int = 0
    pub reason_covered: Int = 0
    pub behavior_reasons: Int = 0
    pub design_reasons: Int = 0
    pub ambiguous_reasons: Int = 0
    pub uncovered: Int = 0
}
impl CoverageFact {
    // Rust: crates/jet-foundation/src/Coverage.rs:49
    pub fn is_closed(self) -> Bool Never! { self.uncovered == 0 }
    // Rust: crates/jet-foundation/src/Coverage.rs:53
    pub fn json(self) -> String Never! {
        "{{\"plane\":{quote(self.plane)},\"rows\":{self.rows},\"edit_covered\":{self.edit_covered},\"reason_covered\":{self.reason_covered},\"behavior_reasons\":{self.behavior_reasons},\"design_reasons\":{self.design_reasons},\"ambiguous_reasons\":{self.ambiguous_reasons},\"uncovered\":{self.uncovered}}}"
    }
}
// Rust: crates/jet-foundation/src/Coverage.rs:68
pub fn try_facts(entries: [CoverageEntry]) -> [CoverageFact] Err! {
    grouped := [String:CoverageFact]{}
    loop entry in entries {
        plane := entry.plane.trim() // #4303
        if plane.is_empty() -> return Err("diagnostic coverage plane must not be empty")
        if entry.fix_edits && entry.no_fix_reason != None {
            return Err("coverage row in plane `{entry.plane}` has both fix_edits and no_fix_reason")
        }
        fact := grouped.get(entry.plane) ?? CoverageFact{plane: entry.plane}
        fact.rows += 1
        if entry.fix_edits { fact.edit_covered += 1 }
        else if entry.no_fix_reason == .Val(kind) {
            fact.reason_covered += 1
            if kind == {
                .Behavior -> fact.behavior_reasons += 1
                .Design -> fact.design_reasons += 1
                .Ambiguous -> fact.ambiguous_reasons += 1
            }
        } else { fact.uncovered += 1 }
        grouped[entry.plane] = ^fact
    }
    keys := grouped.keys().collect()
    keys.sort()
    out := [CoverageFact]{}
    loop key in keys { out.push(grouped.remove(key) ?? panic("coverage key disappeared")) }
    out
}
// Rust: crates/jet-foundation/src/Coverage.rs:101
pub fn facts(entries: [CoverageEntry]) -> [CoverageFact] Never! {
    try_facts(entries) ?? panic("invalid diagnostic coverage row")
}
// Rust: crates/jet-foundation/src/Coverage.rs:106
pub struct CoverageBaselineRow {
    pub edit_covered: Int = 0
    pub reason_covered: Int = 0
    pub total: Int = 0
}
// Rust: crates/jet-foundation/src/Coverage.rs:113
pub struct CoverageBaseline { pub rows: [String:CoverageBaselineRow] = [:] }
impl CoverageBaseline {
    // Rust: crates/jet-foundation/src/Coverage.rs:118
    pub fn parse(text: String) -> CoverageBaseline Err! {
        baseline := CoverageBaseline{}
        loop (index, raw_line) in text.lines() {
            line := raw_line.trim() // #4303
            if line.is_empty() || line.starts_with("#") -> continue
            fields :: line.split_whitespace().collect()
            if fields.len() != 4 {
                return Err("coverage baseline line {index + 1} must contain plane, edit count, reason count, and total")
            }
            edit :: fields[1].parse<UInt>() ?? return Err("invalid edit count on coverage baseline line {index + 1}")
            reason :: fields[2].parse<UInt>() ?? return Err("invalid reason count on coverage baseline line {index + 1}")
            total :: fields[3].parse<UInt>() ?? return Err("invalid total on coverage baseline line {index + 1}")
            row :: CoverageBaselineRow{edit_covered: edit as Int, reason_covered: reason as Int, total: total as Int}
            if row.edit_covered + row.reason_covered > row.total {
                return Err("coverage baseline line {index + 1} counts more covered rows than total")
            }
            if baseline.rows.contains_key(fields[0]) {
                return Err("duplicate coverage baseline plane `{fields[0]}`")
            }
            baseline.rows[fields[0].to_string()] = row
        }
        baseline
    }
    // Rust: crates/jet-foundation/src/Coverage.rs:156
    pub fn render(self) -> String Never! {
        out := ""
        keys := self.rows.keys().collect()
        keys.sort()
        loop plane in keys {
            row :: self.rows[plane]
            out.push_str("{plane} {row.edit_covered} {row.reason_covered} {row.total}\n")
        }
        out
    }
    // Rust: crates/jet-foundation/src/Coverage.rs:169
    pub fn facts(self) -> [CoverageFact] Never! {
        out := [CoverageFact]{}
        keys := self.rows.keys().collect()
        keys.sort()
        loop plane in keys {
            row :: self.rows[plane]
            out.push(CoverageFact{plane: plane, rows: row.total, edit_covered: row.edit_covered,
                reason_covered: row.reason_covered,
                uncovered: (row.total - row.edit_covered - row.reason_covered).max(0)})
        }
        out
    }
    // Rust: crates/jet-foundation/src/Coverage.rs:186
    pub fn from_facts(facts: [CoverageFact]) -> CoverageBaseline Never! {
        baseline := CoverageBaseline{}
        loop fact in facts {
            baseline.rows[fact.plane] = CoverageBaselineRow{edit_covered: fact.edit_covered,
                reason_covered: fact.reason_covered, total: fact.rows}
        }
        baseline
    }
    // Rust: crates/jet-foundation/src/Coverage.rs:203
    pub fn validate(self, current: [CoverageFact]) Err! {
        indexed := [String:@CoverageFact]{}
        loop fact in current { indexed[fact.plane] = @fact }
        keys := self.rows.keys().collect()
        keys.sort()
        loop plane in keys {
            previous :: self.rows[plane]
            fact :: indexed.get(plane) ?? return Err("coverage plane `{plane}` disappeared")
            row :: CoverageBaselineRow{edit_covered: fact.edit_covered,
                reason_covered: fact.reason_covered, total: fact.rows}
            validate_non_decreasing_row(plane, previous, row)?
            previous_uncovered :: (previous.total - previous.edit_covered - previous.reason_covered).max(0)
            if row.total > previous.total {
                current_uncovered :: (row.total - row.edit_covered - row.reason_covered).max(0)
                if current_uncovered > previous_uncovered {
                    return Err("new row in open coverage plane `{plane}` has neither fix_edits nor no_fix_reason")
                }
            }
        }
        current_keys := indexed.keys().collect()
        current_keys.sort()
        loop plane in current_keys {
            fact :: indexed[plane]
            if !self.rows.contains_key(fact.plane) && fact.uncovered > 0 {
                return Err("new coverage plane `{fact.plane}` has a row with neither fix_edits nor no_fix_reason")
            }
        }
    }
}
// Rust: crates/jet-foundation/src/Coverage.rs:244
pub fn validate_non_decreasing(previous: CoverageFact, current: CoverageFact) Err! {
    if previous.plane != current.plane -> return Err("coverage ratchet compares different planes")
    validate_non_decreasing_row(current.plane,
        CoverageBaselineRow{edit_covered: previous.edit_covered, reason_covered: previous.reason_covered, total: previous.rows},
        CoverageBaselineRow{edit_covered: current.edit_covered, reason_covered: current.reason_covered, total: current.rows})?
}
// Rust: crates/jet-foundation/src/Coverage.rs:263
fn validate_non_decreasing_row(plane: String, previous: CoverageBaselineRow, current: CoverageBaselineRow) Err! {
    if current.edit_covered < previous.edit_covered || current.reason_covered < previous.reason_covered || current.total < previous.total {
        return Err("coverage baseline decreased for plane `{plane}`")
    }
    if current.edit_covered + current.reason_covered > current.total {
        return Err("coverage counts exceed total for plane `{plane}`")
    }
}
// Rust: crates/jet-foundation/src/Coverage.rs:280
pub fn validate_registry_coverage(entries: [CoverageEntry], baseline: CoverageBaseline) -> [CoverageFact] Err! {
    out :: try_facts(entries)?
    baseline.validate(out)?
    out
}
