//RS     r.pos = end;
//RS     Ok(())
//RS }
//RS /// Advance a fixed-width pattern after `jet_reader_region_bounds` has proved
//RS /// the complete `[start, end)` range is resident. The proof is part of the
//RS /// caller contract: keeping this helper unchecked removes the second bounds
//RS /// test from the fixed-pattern hot loop while the public fallible helper above
//RS /// retains its ordinary error behavior for every other caller.
//RS #[inline(always)]
//RS #[allow(dead_code)]
//RS pub(crate) fn jet_reader_take_pattern_checked(
//RS     r: &mut JetReader,
//RS     start: usize,
//RS     end: usize,
//RS ) {
//RS     debug_assert_eq!(r.pos, start);
//RS     debug_assert!(start <= end);
//RS     debug_assert!(end <= r.buf.len());
//RS     r.pos = end;
//RS }
