//RS /// Prove that a fixed-width read region is resident before entering its hot
//RS /// loop. The caller must consume exactly `count` bytes from the returned
//RS /// half-open interval without changing the reader through another operation;
//RS /// the region emitter enforces that condition from TIR. A miss deliberately
//RS /// returns `None` without changing the reader so the ordinary fallible loop
//RS /// can preserve its partial-progress and bounds-error behavior.
//RS #[inline(always)]
//RS pub fn jet_reader_region_bounds(r: &JetReader, count: i64) -> Option<(usize, usize)> {
//RS     let count = usize::try_from(count).ok()?;
//RS     let remaining = r.buf.len().checked_sub(r.pos)?;
//RS     (count <= remaining).then_some((r.pos, r.pos + count))
//RS }
