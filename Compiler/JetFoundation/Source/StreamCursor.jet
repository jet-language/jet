// Rust: crates/jet-foundation/src/StreamCursor.rs:400
pub fn jet_reader_seek(r: &JetReader, position: I64) Err! {
    if position < I64{0} -> return err("Reader.seek: position must not be negative, got {position}")
    // GATE #4483: selected execution target's usize.
    if U64{position} > core.sys.usize_max() -> return err("Reader.seek: position {position} is outside the addressable buffer")
    at :: Int{position}
    if at > r.buf.len() -> return err("Reader.seek: position {position} is beyond end {r.buf.len()}")
    r.pos = at
}
// Rust: crates/jet-foundation/src/StreamCursor.rs:424
pub fn jet_reader_skip(r: &JetReader, count: I64) Err! {
    if count < I64{0} -> return err("Reader.skip: length must not be negative, got {count}")
    // GATE #4483: selected execution target's usize.
    maximum :: Int{core.sys.usize_max()}
    if Int{count} > maximum -> return err("Reader.skip: length {count} is outside the addressable buffer")
    if Int{count} > maximum - r.pos -> return err("Reader.skip: position overflow at {r.pos} plus {count}")
    end :: r.pos + Int{count}
    if end > r.buf.len() -> return err(jet_reader_bounds_error("skip", Int{count}, r))
    r.pos = end
}
// Rust: crates/jet-foundation/src/StreamCursor.rs:450
pub fn jet_reader_take(r: &JetReader, n: I64) -> [U8] Err! {
    if n < I64{0} -> return err("Reader.take: length must not be negative, got {n}")
    // GATE #4483: selected execution target's usize.
    if U64{n} > core.sys.usize_max() -> return err("Reader.take: length {n} is outside the addressable buffer")
    jet_reader_take_fixed(&r, Int{n}, "take")
}
// Rust: crates/jet-foundation/src/StreamCursor.rs:466
pub fn jet_reader_remaining(r: JetReader) -> I64 Never! { I64{r.buf.len() - r.pos} }
// Rust: crates/jet-foundation/src/StreamCursor.rs:470
pub fn jet_reader_at_end(r: JetReader) -> Bool Never! { r.pos >= r.buf.len() }
// Rust: crates/jet-foundation/src/StreamCursor.rs:474
pub fn jet_cursor_over(s: String) -> JetCursor Never! { JetCursor{buf: ~s, pos: 0} }
// Rust: crates/jet-foundation/src/StreamCursor.rs:481
pub fn jet_cursor_take_until(c: &JetCursor, delim: String) -> String Err! {
    tail := c.buf.slice(c.pos, c.buf.bytes().len()) // #4303
    if tail.find(delim) == {
        .Val(index) -> {
            out := tail.slice(0, index) // #4303
            c.pos += index
            ^out
        }
        else -> {
            rendered := [U8]{}
            // GATE #4499: canonical Rust string Debug escaping.
            core.text.runtime.kernel_escape_debug.debug_str_into(&rendered, delim)
            quoted :: String.from_bytes(^rendered).expect("debug escape emits UTF-8")
            return err("Cursor.take_until: {quoted} not found in the remaining text")
        }
    }
}
// Rust: crates/jet-foundation/src/StreamCursor.rs:496
pub fn jet_cursor_skip_ws(c: &JetCursor) Never! {
    tail :: jet_cursor_tail(c)
    skipped :: tail.bytes().len() - tail.trim_start().bytes().len()
    c.pos += skipped
}
// Rust: crates/jet-foundation/src/StreamCursor.rs:509
pub fn jet_cursor_tail(c: JetCursor) -> StringView Never! from c { c.buf.view(c.pos..<c.buf.bytes().len()) }
// Rust: crates/jet-foundation/src/StreamCursor.rs:514
pub fn jet_reader_tail(r: JetReader) -> View<U8> Never! from r { r.buf.view(r.pos..<r.buf.len()) }
// Rust: crates/jet-foundation/src/StreamCursor.rs:519
pub fn jet_cursor_take_pattern(c: &JetCursor, consumed: Int) Never! { c.pos += consumed }
// Rust: crates/jet-foundation/src/StreamCursor.rs:528
pub fn jet_reader_take_pattern(r: &JetReader, consumed: Int) Err! {
    // GATE #4483: selected execution target's usize.
    if consumed > Int{core.sys.usize_max()} - r.pos -> return err("Reader.take_pattern: position overflow")
    end :: r.pos + consumed
    if end > r.buf.len() -> return err("Reader.take_pattern: {consumed} bytes exceeds remaining input")
    r.pos = end
}
// Rust: crates/jet-foundation/src/StreamCursor.rs:549
fn jet_reader_take_pattern_checked(r: &JetReader, start: Int, end: Int) Never! {
    assert(r.pos == start)
    assert(start <= end)
    assert(end <= r.buf.len())
    r.pos = end
}
// Rust: crates/jet-foundation/src/StreamCursor.rs:562
pub fn jet_cursor_pattern_miss(c: JetCursor) -> String Never! { "pattern did not match at cursor position {c.pos}" }
// Rust: crates/jet-foundation/src/StreamCursor.rs:566
pub fn jet_reader_pattern_miss(r: JetReader) -> String Never! { "pattern did not match at reader position {r.pos}" }
