//RS 
//RS // `take_pattern` runs a different match engine on every tier: AOT inlines a
//RS // closure specialized to the pattern, the Cranelift host and the interpreter
//RS // walk the pattern as data. What surrounds the match is the same everywhere,
//RS // so it lives here: what the scan may look at, how far a hit advances, and
//RS // what a miss reports. A tier supplies the match and projects the bindings;
//RS // it decides nothing else.
//RS 
//RS pub fn jet_cursor_tail(c: &JetCursor) -> &str {
//RS     &c.buf[c.pos..]
//RS }
//RS 
//RS #[inline(always)]
//RS pub fn jet_reader_tail(r: &JetReader) -> &[u8] {
//RS     &r.buf[r.pos..]
//RS }
//RS 
//RS /// A matched prefix is consumed. `consumed` counts bytes from the tail.
//RS pub fn jet_cursor_take_pattern(c: &mut JetCursor, consumed: usize) {
//RS     c.pos += consumed;
//RS }
//RS 
//RS /// Consume a matched prefix after checking the byte count against the tail.
//RS ///
//RS /// Reader pattern execution is fallible: a malformed/partial scan must never
//RS /// move the cursor past the resident buffer.
//RS #[inline(always)]
//RS pub fn jet_reader_take_pattern(r: &mut JetReader, consumed: usize) -> Result<(), String> {
//RS     let end = r
