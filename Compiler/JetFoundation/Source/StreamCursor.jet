pub fn jet_reader_bounds_error(method: String, need: Int, r: JetReader) -> String Never! {
    suffix :: if need == 1 -> "" else -> "s"
    remain :: (r.buf.len() - r.pos).max(0)
    "Reader.{method}: needed {need} byte{suffix} at position {r.pos}, only {remain} remain"
}
// Rust: crates/jet-foundation/src/StreamCursor.rs:50
pub fn jet_reader_take_fixed(r: &JetReader, n: Int, method: String) -> [U8] Err! {
    // GATE #4483: execution target's addressable bound.
    if n > Int{core.sys.usize_max()} - r.pos -> return err(jet_reader_bounds_error(method, n, r))
    end :: r.pos + n
    if end > r.buf.len() -> return err(jet_reader_bounds_error(method, n, r))
    out :: r.buf.slice(r.pos, end)
    r.pos = end
    ^out
}
// Rust: crates/jet-foundation/src/StreamCursor.rs:63
pub fn jet_reader_read_u8_fast(r: &JetReader) -> U8? Never! {
    if (r.buf.len() - r.pos).max(0) < 1 -> return None
    pos :: r.pos
    value :: r.buf[pos]
    r.pos = pos + 1
    Val(value)
}
// Rust: crates/jet-foundation/src/StreamCursor.rs:80
pub fn jet_reader_region_bounds(r: JetReader, count: I64) -> (start: Int, end: Int)? Never! {
    // GATE #4483: selected execution-target usize conversion.
    if count < I64{0} || U64{count} > core.sys.usize_max() -> return None
    if r.pos > r.buf.len() -> return None
    remaining :: r.buf.len() - r.pos
    if Int{count} <= remaining -> Val((r.pos, r.pos + Int{count})) else -> None
}
