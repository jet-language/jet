fn wire_bytes(text: String, encoding: WireEncoding) -> [U8] Never! {
    if encoding == WireEncoding.UTF8 -> return text.as_bytes().to_vec()
    out: [U8] = []
    for unit in text.encode_utf16() {
        if encoding == WireEncoding.Utf16Le -> out.extend(unit.to_le_bytes()) else -> out.extend(unit.to_be_bytes())
    }
    ^out
}
