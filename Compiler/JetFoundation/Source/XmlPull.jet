        (_, Val(tag), "lexical") if ["document_whitespace", "declaration", "doctype", "text", "cdata", "entity_ref", "comment", "processing_instruction"].contains(tag) -> {
            if value != .Object(entries) -> return None
            out: [(String, Value)] = []
            for (name, item) in entries {
