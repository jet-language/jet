            for byte in chunk -> digits.push(base64_digit(byte) ?? return None)
            out.push((digits[0] << 2) | ((digits.get(1) ?? 0) >> 4))
            if digits.len() > 2 -> out.push((digits[1] << 4) | (digits[2] >> 2))
            if digits.len() > 3 -> out.push((digits[2] << 6) | digits[3])
