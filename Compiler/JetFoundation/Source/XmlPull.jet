            ("attributes", ~(field(value, "attributes") ?? return None)), ("empty_style", ~(field(value, "empty_style") ?? return None))])))
        (Val("element"), _, "close_lexical") | (_, Val("element_end"), "close_lexical") -> Val(object([("name", ~(field(value, "name") ?? return None))]))
        (Val(tag), _, "lexical") if ["document_whitespace", "declaration", "doctype", "namespace", "attribute", "text", "cdata", "entity_ref", "comment", "processing_instruction"].contains(tag) -> {
