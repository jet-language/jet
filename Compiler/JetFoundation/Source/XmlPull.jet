        semantic :: strip_lexical(value)
        if raw := lexical_raw(value, "lexical", semantic) -> output.push_str(raw) else -> output.push_str(deterministic_leaf(value, tag)?)
    }
    output := ""
    render_node(value, &output)?
    ^output
