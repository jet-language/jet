fn has_canonical_xml_object(value: Value) -> Bool Never! {
    if value != .Object(entries) -> return false
    order :: xml_schema_order(entries) ?? return false
    for (index, entry) in entries.enumerate() { if entry.0 != order[index] -> return false }
