pub fn parse_document_with(source: String, options: ParseOptions) -> Value Error! {
    options.limits.validate()?
    scanner := Scanner.with_options(source, ~options)?
    document_children: [Value] = []
    stack: [ElementFrame] = []
    while event := scanner.next()? {
        node: Value? = if event == {
            .DocumentStart | .DocumentEnd -> continue
            .Declaration(version, encoding, standalone, raw) -> Val(leaf("declaration", [("version", text(version)), ("encoding", optional_text(encoding)), ("standalone", if standalone == { Val(b) -> Value.Bool(b), None -> Value.Null })], raw))
            .DocumentWhitespace(value, raw) -> Val(leaf("document_whitespace", [("value", text(value))], raw))
            .Doctype(name, public_id, system_id, internal_subset, raw) -> Val(leaf("doctype", [("name", text(name)), ("public_id", optional_text(public_id)), ("system_id", optional_text(system_id)), ("internal_subset", optional_text(internal_subset))], raw))
            .ElementStart(name, namespaces, attributes, empty, raw) -> {
                ns: [Value] = []
                for n in namespaces -> ns.push(namespace_value(n))
                attrs: [Value] = []
                for a in attributes -> attrs.push(attribute_value(a))
                frame :: ElementFrame{name: ^name, namespaces: ^ns, attributes: ^attrs, children: [], open_raw: ^raw}
                if empty -> Val(finish_element(^frame, None)) else { stack.push(^frame); None }
            }
            .Text(value, raw) -> Val(leaf("text", [("value", text(value))], raw))
            .Cdata(value, raw) -> Val(leaf("cdata", [("value", text(value))], raw))
            .EntityRef(name, resolved, raw) -> Val(leaf("entity_ref", [("name", text(name)), ("resolved_value", optional_text(resolved))], raw))
            .Comment(value, raw) -> Val(leaf("comment", [("value", text(value))], raw))
            .ProcessingInstruction(target, value, raw) -> Val(leaf("processing_instruction", [("target", text(target)), ("value", text(value))], raw))
            .ElementEnd(_, raw) -> {
                frame :: stack.pop() ?? return err(Error.at(scanner.offset, "element stack underflow"))
                Val(finish_element(^frame, Val(^raw)))
            }
        }
        if item := node {
            if stack.is_empty() -> document_children.push(^item) else -> stack[stack.len() - 1].children.push(^item)
        }
    }
    object([("$xml", text("document")), ("encoding", Value.Null), ("bom", Value.Array([])), ("children", Value.Array(^document_children))])
}
