pub fn xml_schema_order(entries: [(String, Value)]) -> [String]? Never! {
    text_field :: fn(key: String) -> String? Never! {
        if xml_entry(entries, key) == Val(Value.Text(value)) -> Val(value) else -> None
    }
    has :: fn(key: String) -> Bool Never! { xml_entry(entries, key).is_some() }
    order: [String] = []
    if tag := text_field("$xml") {
        order = if tag == {
            "document" -> ["$xml", "encoding", "bom", "children"]
            "document_whitespace" -> if has("lexical") -> ["$xml", "value", "lexical"] else -> ["$xml", "value"]
            "declaration" -> if has("lexical") -> ["$xml", "version", "encoding", "standalone", "lexical"] else -> ["$xml", "version", "encoding", "standalone"]
            "doctype" -> if has("lexical") -> ["$xml", "name", "public_id", "system_id", "internal_subset", "lexical"] else -> ["$xml", "name", "public_id", "system_id", "internal_subset"]
            "element" -> if has("open_lexical") -> ["$xml", "name", "namespaces", "attributes", "children", "empty_style", "open_lexical", "close_lexical"] else -> ["$xml", "name", "namespaces", "attributes", "children", "empty_style"]
            "namespace" -> if has("lexical") -> ["$xml", "prefix", "namespace_uri", "quote", "lexical"] else -> ["$xml", "prefix", "namespace_uri", "quote"]
            "attribute" -> if has("lexical") -> ["$xml", "name", "parts", "normalized_value", "quote", "lexical"] else -> ["$xml", "name", "parts", "normalized_value", "quote"]
            "text" | "cdata" | "comment" -> if has("lexical") -> ["$xml", "value", "lexical"] else -> ["$xml", "value"]
            "entity_ref" -> if has("lexical") -> ["$xml", "name", "resolved_value", "lexical"] else -> ["$xml", "name", "resolved_value"]
            "processing_instruction" -> if has("lexical") -> ["$xml", "target", "value", "lexical"] else -> ["$xml", "target", "value"]
            else -> return None
        }
    } else if tag := text_field("$xml_event") {
        order = if tag == {
            "document_start" -> ["$xml_event", "encoding", "bom"]
            "document_whitespace" -> ["$xml_event", "value", "lexical"]
            "declaration" -> ["$xml_event", "version", "encoding", "standalone", "lexical"]
            "doctype" -> ["$xml_event", "name", "public_id", "system_id", "internal_subset", "lexical"]
            "element_start" -> ["$xml_event", "name", "namespaces", "attributes", "empty_style", "open_lexical"]
            "text" | "cdata" | "comment" -> ["$xml_event", "value", "lexical"]
            "entity_ref" -> ["$xml_event", "name", "resolved_value", "lexical"]
            "processing_instruction" -> ["$xml_event", "target", "value", "lexical"]
            "element_end" -> ["$xml_event", "name", "close_lexical"]
            "document_end" -> ["$xml_event"]
            else -> return None
        }
    } else {
        found := false
        for keys in [["raw", "prefix", "local", "namespace_uri"], ["raw_text", "raw_bytes", "semantic"], ["name", "namespaces", "attributes", "empty_style"], ["encoding", "bom"], ["version", "encoding", "standalone"], ["name", "public_id", "system_id", "internal_subset"], ["name", "resolved_value"], ["target", "value"], ["value"], ["name"]] {
            if has_exact_xml_keys(entries, keys) { order = ~keys; found = true; break }
        }
        if !found -> return None
    }
    if has_exact_xml_keys(entries, order) -> Val(^order) else -> None
}
// Rust: crates/jet-foundation/src/XmlPull.rs:451
fn xml_schema_types_are_valid(entries: [(String, Value)]) -> Bool Never! {
    text :: fn(key: String) -> Bool Never! { xml_entry(entries, key) == Val(Value.Text(_)) }
    optional_text :: fn(key: String) -> Bool Never! { xml_entry(entries, key) == Val(Value.Text(_)) || xml_entry(entries, key) == Val(Value.Null) }
    array :: fn(key: String) -> Bool Never! { xml_entry(entries, key) == Val(Value.Array(_)) }
    object :: fn(key: String) -> Bool Never! { xml_entry(entries, key) == Val(Value.Object(_)) }
    object_or_null :: fn(key: String) -> Bool Never! { object(key) || xml_entry(entries, key) == Val(Value.Null) }
    bool_or_null :: fn(key: String) -> Bool Never! { xml_entry(entries, key) == Val(Value.Bool(_)) || xml_entry(entries, key) == Val(Value.Null) }
    has :: fn(key: String) -> Bool Never! { xml_entry(entries, key).is_some() }
    bytes :: fn(key: String) -> Bool Never! {
        if xml_entry(entries, key) == Val(Value.Array(values)) {
            for value in values { if value == .Int(byte) { if byte < 0 || byte > 255 -> return false } else -> return false }
            return true
        }
        false
    }
    tag :: fn(key: String) -> String? Never! { if xml_entry(entries, key) == Val(Value.Text(value)) -> Val(value) else -> None }
    if kind := tag("$xml") {
        return if kind == {
            "document" -> optional_text("encoding") && bytes("bom") && array("children")
            "document_whitespace" -> text("value") && (!has("lexical") || object("lexical"))
            "declaration" -> text("version") && optional_text("encoding") && bool_or_null("standalone") && (!has("lexical") || object("lexical"))
            "doctype" -> text("name") && optional_text("public_id") && optional_text("system_id") && optional_text("internal_subset") && (!has("lexical") || object("lexical"))
            "element" -> object("name") && array("namespaces") && array("attributes") && array("children") && text("empty_style") && (!has("open_lexical") || (object("open_lexical") && object_or_null("close_lexical")))
            "namespace" -> optional_text("prefix") && text("namespace_uri") && text("quote") && (!has("lexical") || object("lexical"))
            "attribute" -> object("name") && array("parts") && optional_text("normalized_value") && text("quote") && (!has("lexical") || object("lexical"))
            "text" | "cdata" | "comment" -> text("value") && (!has("lexical") || object("lexical"))
            "entity_ref" -> text("name") && optional_text("resolved_value") && (!has("lexical") || object("lexical"))
            "processing_instruction" -> text("target") && text("value") && (!has("lexical") || object("lexical"))
            else -> false
        }
    }
    if kind := tag("$xml_event") {
        return if kind == {
            "document_start" -> optional_text("encoding") && bytes("bom")
            "document_whitespace" -> text("value") && object("lexical")
            "declaration" -> text("version") && optional_text("encoding") && bool_or_null("standalone") && object("lexical")
            "doctype" -> text("name") && optional_text("public_id") && optional_text("system_id") && optional_text("internal_subset") && object("lexical")
            "element_start" -> object("name") && array("namespaces") && array("attributes") && text("empty_style") && object("open_lexical")
            "text" | "cdata" | "comment" -> text("value") && object("lexical")
            "entity_ref" -> text("name") && optional_text("resolved_value") && object("lexical")
            "processing_instruction" -> text("target") && text("value") && object("lexical")
            "element_end" -> object("name") && object("close_lexical")
            "document_end" -> true
            else -> false
        }
    }
    keys: [String] = []
    for (key, _) in entries -> keys.push(key)
    if keys == {
        ["raw", "prefix", "local", "namespace_uri"] -> text("raw") && optional_text("prefix") && text("local") && optional_text("namespace_uri")
        ["raw_text", "raw_bytes", "semantic"] -> true
        ["name", "namespaces", "attributes", "empty_style"] -> object("name") && array("namespaces") && array("attributes") && text("empty_style")
        ["encoding", "bom"] -> optional_text("encoding") && bytes("bom")
        ["version", "encoding", "standalone"] -> text("version") && optional_text("encoding") && bool_or_null("standalone")
        ["name", "public_id", "system_id", "internal_subset"] -> text("name") && optional_text("public_id") && optional_text("system_id") && optional_text("internal_subset")
        ["name", "resolved_value"] -> text("name") && optional_text("resolved_value")
        ["target", "value"] -> text("target") && text("value")
        ["value"] -> text("value")
        ["name"] -> object("name")
        else -> false
    }
}
