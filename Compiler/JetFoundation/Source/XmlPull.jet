    fn base64_digit(byte: U8) -> U8? Never! {
        if byte >= 65 && byte <= 90 -> return Val(byte - 65)
        if byte >= 97 && byte <= 122 -> return Val(byte - 97 + 26)
        if byte >= 48 && byte <= 57 -> return Val(byte - 48 + 52)
        if byte == 43 -> return Val(62)
        if byte == 47 -> return Val(63)
        None
    }
