                ("namespaces", ~(field(value, "namespaces") ?? return err("XML element lacks namespaces"))),
                ("attributes", ~(field(value, "attributes") ?? return err("XML element lacks attributes"))),
                ("empty_style", ~(field(value, "empty_style") ?? return err("XML element lacks empty_style")))]))
            if raw := lexical_raw(value, "open_lexical", open_semantic) -> output.push_str(raw) else -> render_element_open(value, &output)?
            children :: if field(value, "children") == Val(Value.Array(items)) -> items else -> return err("XML element children must be an array")
            for child in children -> render_node(child, &output)?
            close_semantic :: object([("name", ~(field(value, "name") ?? return err("XML element lacks name")))])
            if raw := lexical_raw(value, "close_lexical", close_semantic) -> output.push_str(raw)
            else if required_text(value, "empty_style")? == "explicit" {
                name :: field(value, "name") ?? return err("XML element lacks name")
                output.push_str("</")
                output.push_str(required_text(name, "raw")?)
                output.push('>')
