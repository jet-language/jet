fn lexical_evidence_matches(lexical: Value, expected: Value) -> Bool Never! {
    if lexical != .Object(entries) -> return false
    if entries.len() != 3 || entries[0].0 != "raw_text" || entries[1].0 != "raw_bytes" || entries[2].0 != "semantic" || !has_canonical_xml_shape(expected) -> return false
    semantic :: field(lexical, "semantic") ?? return false
    if !has_canonical_xml_shape(semantic) || semantic != expected -> return false
    if (field(lexical, "raw_text"), field(lexical, "raw_bytes")) == {
        (Val(Value.Text(_)), Val(Value.Null)) | (Val(Value.Null), Val(Value.Null)) -> true
