fn leaf(tag: String, fields: ^[(String, Value)], raw: String) -> Value Never! {
    semantic_fields: [(String, Value)] = [("$xml", text(tag))]
    semantic_fields.extend(~fields)
    semantic :: strip_lexical(object(^semantic_fields))
