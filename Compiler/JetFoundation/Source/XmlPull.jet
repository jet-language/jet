fn render_element_open(value: Value, output: &String) -> Unit Err! {
    name :: field(value, "name") ?? return err("XML element lacks name")
    output.push('<')
    output.push_str(required_text(name, "raw")?)
    namespaces :: if field(value, "namespaces") == Val(Value.Array(items)) -> items else -> return err("XML namespaces must be an array")
    for namespace in namespaces {
        output.push_str(" xmlns")
        if prefix := optional_text_field(namespace, "prefix")? { output.push(':'); output.push_str(prefix) }
        quote :: if required_text(namespace, "quote")? == "single" -> '\'' else -> '"'
        output.push('=')
        output.push(quote)
        output.push_str(escape_attribute(required_text(namespace, "namespace_uri")?, quote))
        output.push(quote)
    }
    attributes :: if field(value, "attributes") == Val(Value.Array(items)) -> items else -> return err("XML attributes must be an array")
    for attribute in attributes {
        attribute_name :: field(attribute, "name") ?? return err("XML attribute lacks name")
        quote :: if required_text(attribute, "quote")? == "single" -> '\'' else -> '"'
        output.push(' ')
        output.push_str(required_text(attribute_name, "raw")?)
        output.push('=')
        output.push(quote)
        if normalized := optional_text_field(attribute, "normalized_value")? -> output.push_str(escape_attribute(normalized, quote))
