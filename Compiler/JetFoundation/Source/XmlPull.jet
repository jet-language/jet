        .Declaration(version, declared, standalone, _) -> {
            fields: [(String, Value)] = [("version", text(version)), ("encoding", optional_text(declared)), ("standalone", if standalone == { Val(b) -> Value.Bool(b), None -> Value.Null })]
            out: [(String, Value)] = [("$xml_event", text("declaration"))]
            out.extend(~fields)
