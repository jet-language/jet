        .DocumentWhitespace(value, _) -> leaf_event("document_whitespace", [("value", text(value))], ~item.raw_bytes)
        .Text(value, _) -> leaf_event("text", [("value", text(value))], ~item.raw_bytes)
        .Cdata(value, _) -> leaf_event("cdata", [("value", text(value))], ~item.raw_bytes)
        .Comment(value, _) -> leaf_event("comment", [("value", text(value))], ~item.raw_bytes)
        .EntityRef(name, resolved, _) -> leaf_event("entity_ref", [("name", text(name)), ("resolved_value", optional_text(resolved))], ~item.raw_bytes)
        .ProcessingInstruction(target, value, _) -> leaf_event("processing_instruction", [("target", text(target)), ("value", text(value))], ~item.raw_bytes)
