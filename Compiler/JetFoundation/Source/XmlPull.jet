            if encoding := optional_text_field(value, "encoding")? -> output.push_str(" encoding=\"{encoding}\"")
            if field(value, "standalone") == {
                Val(Value.Bool(true)) -> output.push_str(" standalone=\"yes\"")
                Val(Value.Bool(false)) -> output.push_str(" standalone=\"no\"")
                Val(Value.Null) -> {}
                else -> return err("XML standalone must be bool or null")
            }
            output.push_str("?>")
            ^output
        }
        "doctype" -> {
            name :: required_text(value, "name")?
            output := "<!DOCTYPE {name}"
            if (optional_text_field(value, "public_id")?, optional_text_field(value, "system_id")?) == {
                (Val(public), Val(system)) -> output.push_str(" PUBLIC \"{public}\" \"{system}\"")
                (None, Val(system)) -> output.push_str(" SYSTEM \"{system}\"")
                (None, None) -> {}
                (Val(_), None) -> return err("XML PUBLIC identifier requires SYSTEM identifier")
            }
            if subset := optional_text_field(value, "internal_subset")? -> output.push_str(" [{subset}]")
            output.push('>')
            ^output
