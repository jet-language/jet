pub fn parse_document_bytes(bytes: [U8]) -> Value Error! { parse_document_bytes_with(bytes, ParseOptions.safe()) }
// Rust: crates/jet-foundation/src/XmlPull.rs:1218
pub fn parse_document_bytes_with(bytes: [U8], options: ParseOptions) -> Value Error! {
    options.limits.validate()?
    scanner := StreamScanner.new(bytes.len().max(4), ~options)?
    scanner.push(bytes)?
