fn reject_parameter_entity_markup(subset: String, base: USize) -> Unit Error! {
    index: USize := 0
    while index < subset.len() {
        if subset.as_bytes()[index] == b'%' {
            name_begin :: index + 1
            name_end := name_begin
            while name_end < subset.len() {
                next :: subset[name_end..].chars().next().unwrap()
                if name_end == name_begin { if !name_start(next) { break } }
                else if !name_char(next) { break }
                name_end += next.len_utf8()
            }
            if name_end > name_begin && subset.as_bytes().get(name_end) == Some(b';') {
                return Err(Error.at_kind(base + index, Reason.Unsupported, "parameter entity references are unsupported"))
            }
        }
        index += subset[index..].chars().next().unwrap().len_utf8()
