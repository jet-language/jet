    // Rust: crates/jet-foundation/src/XmlPull.rs:6369
    fn charge_nodes(self: &Scanner, amount: USize) -> Unit Error! {
        if self.nodes.saturating_add(amount) > self.options.limits.max_nodes {
            return self.limit("XML document exceeds max_nodes ({self.options.limits.max_nodes})")
        }
        self.nodes += amount
    }
    // Rust: crates/jet-foundation/src/XmlPull.rs:6379
    fn charge_event(self: &Scanner, event: &Event) -> Unit Error! {
        match event {
            DocumentStart => self.charge_nodes(1)
            DocumentEnd | ElementEnd{..} => {}
            ElementStart{name, namespaces, attributes, empty, ..} => {
                depth := self.stack.len()
                if empty { depth += 1 }
                if depth > self.options.limits.max_depth {
                    return self.limit("XML element nesting exceeds max_depth ({self.options.limits.max_depth})")
                }
                if attributes.len() > self.options.limits.max_attributes_per_element {
                    return self.limit("XML element exceeds max_attributes_per_element ({self.options.limits.max_attributes_per_element})")
                }
                self.check_name(name.raw, "element name")
                self.check_name(name.local, "local name")
                if name.prefix is Some(prefix) { self.check_name(prefix, "name prefix") }
                if name.namespace_uri is Some(uri) { self.check_name(uri, "namespace URI") }
                for namespace in namespaces {
                    if namespace.prefix is Some(prefix) { self.check_name(prefix, "namespace prefix") }
                    self.check_name(namespace.namespace_uri, "namespace URI")
                }
                for attribute in attributes {
                    self.check_name(attribute.name.raw, "attribute name")
                    self.check_name(attribute.name.local, "attribute local name")
                    if attribute.name.prefix is Some(prefix) { self.check_name(prefix, "attribute prefix") }
                    if attribute.name.namespace_uri is Some(uri) { self.check_name(uri, "attribute namespace URI") }
                    for part in &attribute.parts {
                        if part is Part.Text{value, ..} { self.charge_text(value.len(), "attribute text") }
                    }
                }
                self.charge_nodes(1 + namespaces.len() + attributes.len())
            }
            Declaration{version, encoding, ..} => {
                self.check_name(version, "XML version")
                if encoding is Some(name) { self.check_name(name, "XML encoding") }
                self.charge_nodes(1)
            }
            Doctype{name, public_id, system_id, internal_subset, ..} => {
                self.check_name(name, "DOCTYPE name")
                if public_id is Some(value) { self.check_name(value, "DOCTYPE identifier") }
                if system_id is Some(value) { self.check_name(value, "DOCTYPE identifier") }
                if internal_subset is Some(value) { self.charge_text(value.len(), "DOCTYPE internal subset") }
                self.charge_nodes(1)
            }
            ProcessingInstruction{target, value, ..} => {
                self.check_name(target, "processing instruction target")
                self.charge_text(value.len(), "processing instruction text")
                self.charge_nodes(1)
            }
            DocumentWhitespace{value, ..} | Text{value, ..} | Cdata{value, ..} | Comment{value, ..} => {
                self.charge_text(value.len(), "text")
                self.charge_nodes(1)
            }
            EntityRef{name, ..} => {
                self.check_name(name, "entity name")
                self.charge_nodes(1)
            }
        }
    }
    // Rust: crates/jet-foundation/src/XmlPull.rs:6482
    fn next_inner(self: &Scanner) -> Event? Error! {
        if self.ended { return None }
        if !self.started { self.started = true; return Some(Event.DocumentStart) }
        if self.offset == self.source.len() {
            if !self.stack.is_empty() { return self.fail("XML document ended before closing element") }
            if !self.root_seen { return self.fail("empty XML document") }
            self.ended = true
            return Some(Event.DocumentEnd)
        }
        if self.starts("<!--") {
            (raw, body) :: self.take_until("-->", "unterminated XML comment")
            value :: body[4..].to_string()
            if value.contains("--") { return self.fail("XML comment contains --") }
            return Some(Event.Comment{value: ^value, raw: ^raw})
        }
        if self.starts("<![CDATA[") {
            if self.stack.is_empty() { return self.fail("CDATA outside root element") }
            (raw, body) :: self.take_until("]]>", "unterminated CDATA")
            return Some(Event.Cdata{value: body[9..].to_string(), raw: ^raw})
        }
        if self.starts("<?xml") {
            if self.declaration_seen || self.root_seen || self.offset != 0 { return self.fail("XML declaration is out of order") }
            (raw, body) :: self.take_until("?>", "unterminated XML declaration")
            data := body[5..].trim() // #4303
            (version, encoding, standalone) :: declaration_fields(data)
            if encoding is Some(name) {
                if !declaration_matches_input(name, self.wire_encoding) {
                    return Err(Error.at_kind(0, Reason.InvalidEncoding, "XML declaration conflicts with detected input encoding"))
                }
            }
            self.declaration_seen = true
            return Some(Event.Declaration{version: ^version, encoding: ^encoding, standalone: standalone, raw: ^raw})
        }
        if self.starts("<?") {
            (raw, body) :: self.take_until("?>", "unterminated processing instruction")
            data := body[2..] // #4303
            split :: data.find(fn(character) { character.is_whitespace() }).unwrap_or(data.len())
            target :: data[..split].to_string()
            if !valid_name(target) || target.eq_ignore_ascii_case("xml") { return self.fail("invalid processing instruction target") }
            value := data[split..].trim_start() // #4303
            return Some(Event.ProcessingInstruction{target: ^target, value: value.to_string(), raw: ^raw})
        }
        if self.starts("<!DOCTYPE") {
            if self.doctype_seen || self.root_seen { return self.fail("DOCTYPE is out of order") }
            start :: self.offset
            i := start + 9
            quote: Char? := None
            bracket: I32 := 0
            while i < self.source.len() {
                character :: self.source.as_bytes()[i] as Char
                if quote is Some(q) { if character == q { quote = None } }
                else if character == '\'' || character == '"' { quote = Some(character) }
                else if character == '[' { bracket += 1 }
                else if character == ']' { bracket -= 1 }
                else if character == '>' && bracket == 0 { break }
                i += 1
            }
            if i == self.source.len() { return self.fail("unterminated DOCTYPE") }
            self.validate_characters(start, i + 1)
            self.offset = i + 1
            raw :: self.source[start..self.offset].to_string()
            inside := self.source[start + 9..i].trim() // #4303
            (name, public_id, system_id, internal_subset) :: doctype_fields(inside) catch { error ->
                return Err(Error.at(start + 9 + error.offset, error.reason))
            }
            (declared_entities, declaration_count) :: declared_entity_table(internal_subset) catch { error ->
                mapped := Error.at_kind(start + 9 + error.offset, error.kind, error.reason.clone())
                mapped.path = ^error.path
                return Err(^mapped)
            }
            if declaration_count > self.options.limits.max_entity_declarations {
                return self.limit("XML document exceeds max_entity_declarations ({self.options.limits.max_entity_declarations})")
            }
            ordered := declared_entities.keys().to_vec()
            ordered.sort()
            for entity_name in &ordered { self.check_name(entity_name, "entity name") }
            self.declared_entities = ^declared_entities
            self.doctype_seen = true
            return Some(Event.Doctype{name: ^name, public_id: ^public_id, system_id: ^system_id, internal_subset: ^internal_subset, raw: ^raw})
        }
        if self.starts("</") {
            start :: self.offset
            rel :: match self.source[start..].find('>') { Some(offset) => offset, None => return self.fail("unterminated closing tag") }
            self.validate_characters(start, start + rel + 1)
            raw_name := self.source[start + 2..start + rel].trim() // #4303
            frame :: self.stack.last().cloned().ok_or_else(fn() { Error.at(start, "closing tag without opener") })
            name :: self.resolved_name(raw_name, [], false)
            if name.namespace_uri != frame.name.namespace_uri || name.local != frame.name.local {
                return self.fail("mismatched XML closing tag")
            }
            self.offset = start + rel + 1
            _ :: self.stack.pop()
            if self.stack.is_empty() { self.root_closed = true }
            return Some(Event.ElementEnd{name: ^name, raw: self.source[start..self.offset].to_string()})
        }
        if self.starts("<") {
            if self.root_closed { return self.fail("multiple XML root elements") }
            return Some(self.open())
        }
        if self.starts("&") {
            if self.stack.is_empty() { return self.fail("entity reference outside root element") }
            (raw, name, resolved) :: self.reference()
            return Some(Event.EntityRef{name: ^name, resolved: ^resolved, raw: ^raw})
        }
        start :: self.offset
        rel :: self.source[start..].find(['<', '&']).unwrap_or(self.source.len() - start)
        self.validate_characters(start, start + rel)
        self.offset += rel
        raw :: self.source[start..self.offset].to_string()
        if self.stack.is_empty() {
