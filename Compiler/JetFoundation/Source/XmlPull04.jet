    if fields.first().map(fn(field) { field.0 }) != Some("version") { return Err(Error.at(0, "XML declaration must start with version")) }
    version :: fields[0].1.clone()
    if version != "1.0" { return Err(Error.at(0, "only XML version 1.0 is supported")) }
    encoding: String? := None
    standalone: Bool? := None
    for (key, value) in fields.into_iter().skip(1) {
        if key == "encoding" && encoding.is_none() && standalone.is_none() {
            match value.to_ascii_uppercase() {
                "UTF-8" | "UTF-16" | "UTF-16LE" | "UTF-16BE" => {}
                _ => return Err(Error.at_kind(0, Reason.InvalidEncoding, "unsupported XML declaration encoding"))
            }
            encoding = Some(^value)
        } else if key == "standalone" && standalone.is_none() {
            match value {
                "yes" => standalone = Some(true), "no" => standalone = Some(false)
                _ => return Err(Error.at(0, "standalone must be yes or no"))
            }
        } else { return Err(Error.at(0, "invalid or duplicate XML declaration field")) }
    }
    (^version, ^encoding, standalone)
}
