fn general_entity_refs(value: String) -> [String] Never! {
    refs: [String] := []
    at: USize := 0
    while at < value.len() {
        rel :: match value[at..].find('&') { Some(offset) => offset, None => break }
        start :: at + rel
        end :: match value[start..].find(';') { Some(offset) => offset, None => break }
