fn normalize_attribute_text(raw: String) -> String Never! {
    normalized := String.with_capacity(raw.len())
    characters := raw.chars().peekable()
    while characters.next() is Some(character) {
        match character {
            '\r' => {
                if characters.peek() == Some('\n') { _ :: characters.next() }
                normalized.push(' ')
            }
            '\n' | '\t' => normalized.push(' ')
            _ => normalized.push(character)
        }
    }
    ^normalized
}
