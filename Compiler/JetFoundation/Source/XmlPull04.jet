// Rust: crates/jet-foundation/src/XmlPull.rs:5673
fn visit(node: String, edges: &[String:[String]], color: &[String:Color]) -> Bool Never! {
    color.insert(node.to_string(), Color.Gray)
    if edges.get(node) is Some(targets) {
        for target in targets {
            match color.get(target).unwrap_or(Color.White) {
                Gray => return true
                White => { if visit(target, edges, color) { return true } }
                Black => {}
            }
        }
    }
    color.insert(node.to_string(), Color.Black)
    false
}
