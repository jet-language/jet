fn declaration_fields(data: String) -> (String, String?, Bool?) Error! {
    cursor: USize := 0
    fields: [(String, String)] := []
    while cursor < data.len() {
        while data.as_bytes()[cursor].is_ascii_whitespace() {
            cursor += 1
            if cursor == data.len() { break }
        }
        if cursor == data.len() { break }
        key_start :: cursor
        while cursor < data.len() && !data.as_bytes()[cursor].is_ascii_whitespace() && data.as_bytes()[cursor] != b'=' { cursor += 1 }
