        cursor := start + "<!ENTITY".len()
        while source.as_bytes().get(cursor).is_some_and(fn(byte) { byte.is_ascii_whitespace() }) { cursor += 1 }
        if source.as_bytes().get(cursor) == Some(b'%') {
            return Err(Error.at_kind(start, Reason.Unsupported, "parameter entity declarations are unsupported"))
        }
        name_begin :: cursor
        while cursor < source.len() {
            next :: source[cursor..].chars().next().unwrap()
            if cursor == name_begin { if !name_start(next) { break } }
            else if !name_char(next) { break }
            cursor += next.len_utf8()
        }
        if cursor == name_begin { return Err(Error.at(start, "ENTITY declaration lacks name")) }
        name := source[name_begin..cursor] // #4303
        if !valid_name(name) { return Err(Error.at(start, "invalid ENTITY declaration name")) }
        while source.as_bytes().get(cursor).is_some_and(fn(byte) { byte.is_ascii_whitespace() }) { cursor += 1 }
        kind: DeclaredEntityKind := DeclaredEntityKind.Internal
        if source[cursor..].starts_with("SYSTEM") || source[cursor..].starts_with("PUBLIC") {
            external_start :: cursor
            if source[cursor..].starts_with("PUBLIC") {
                cursor += "PUBLIC".len()
                _ :: take_entity_literal(source, &cursor)
            } else { cursor += "SYSTEM".len() }
            _ :: take_entity_literal(source, &cursor)
            while source.as_bytes().get(cursor).is_some_and(fn(byte) { byte.is_ascii_whitespace() }) { cursor += 1 }
            if source[cursor..].starts_with("NDATA") {
