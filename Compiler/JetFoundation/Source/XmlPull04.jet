fn take_doctype_literal(source: String, cursor: &USize) -> String Error! {
    while source.as_bytes().get(*cursor).is_some_and(fn(byte) { byte.is_ascii_whitespace() }) { *cursor += 1 }
    quote :: source.as_bytes().get(*cursor).ok_or_else(fn() { Error.at(*cursor, "DOCTYPE external identifier lacks quoted value") })
    if quote != b'\'' && quote != b'"' { return Err(Error.at(*cursor, "DOCTYPE external identifier must be quoted")) }
    *cursor += 1
    start :: *cursor
    while source.as_bytes().get(*cursor).is_some_and(fn(byte) { byte != quote }) { *cursor += 1 }
    if *cursor == source.len() { return Err(Error.at(start, "unterminated DOCTYPE external identifier")) }
    value :: source[start..*cursor].to_string()
    *cursor += 1
    ^value
}
