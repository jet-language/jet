fn predefined(name: String) -> String? Never! {
    match name {
        "lt" => Some("<"), "gt" => Some(">"), "amp" => Some("&"),
        "apos" => Some("'"), "quot" => Some("\""),
        _ => {
            number: U32? := None
            if name.starts_with("#x") { number = U32.from_str_radix(name[2..], 16).ok() }
            else if name.starts_with('#') { number = name[1..].parse<U32>().ok() }
            if number is Some(value) {
                if Char.from_u32(value) is Some(character) {
                    if valid_xml_char(character) { return Some(character.to_string()) }
                }
            }
            None
        }
    }
}
