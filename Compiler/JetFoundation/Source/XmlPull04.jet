    // Rust: crates/jet-foundation/src/XmlPull.rs:6686
    pub fn next(self: &Scanner) -> Event? Error! {
        event :: self.next_inner() catch { error ->
            located := ^error
            Scanner.classify(&located)
            return Err(located.located(self.source, self.path()))
        }
        if event is Some(value) {
            self.charge_event(&value) catch { error ->
                located := ^error
                Scanner.classify(&located)
                return Err(located.located(self.source, self.path()))
            }
            return Some(^value)
        }
        None
    }
}

