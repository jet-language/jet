fn entity_reference_graph_has_cycle(edges: &[String:[String]]) -> Bool Never! {
    color: [String:Color] := [:]
    names := edges.keys().to_vec()
    names.sort()
    for name in &names { color.insert(name.clone(), Color.White) }
    for name in &names {
        if color.get(name) == Some(Color.White) && visit(name, edges, &color) { return true }
    }
    false
}
