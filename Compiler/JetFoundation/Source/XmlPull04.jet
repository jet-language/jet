        while cursor < data.len() && data.as_bytes()[cursor].is_ascii_whitespace() { cursor += 1 }
        if data.as_bytes().get(cursor) != Some(b'=') { return Err(Error.at(cursor, "XML declaration field needs =")) }
        cursor += 1
        value :: take_doctype_literal(data, &cursor)
        fields.push((key.to_string(), ^value))
