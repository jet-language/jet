        class: HighlightClass.KeywordControl,
    },
    HighlightToken {
        text: KW_NEXT,
        class: HighlightClass.KeywordControl,
    },
    HighlightToken {
        text: KW_YIELD,
        class: HighlightClass.KeywordControl,
    },
    // D-CONC-SPAWN1=D: only `task` is reserved; qualified selectors remain
    // spellings of the same surface without reserving bare `all`/`race`/etc.
    HighlightToken {
        text: KW_CONC_TASK,
        class: HighlightClass.KeywordControl,
    },
    HighlightToken {
        text: KW_FREEZE,
