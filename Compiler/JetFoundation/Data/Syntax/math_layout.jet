/// S59 (ratified E2-M14): C FFI module path root — `c.<lib>`, `c.<lib>.__bindgen__`.
C_MODULE_ROOT :: "c" // S59

/// S59: reserved final segment for compiler-generated bindgen modules.
C_BINDGEN_SEGMENT :: "__bindgen__" // S59

/// S59 / D-CFFI-CANON1: marker on generated C binding modules — `#Bindgen module`.
MARKER_BINDGEN :: "Bindgen" // S59 / D-CFFI-CANON1

/// D-ADOPT-GUEST1=A: marker on user C import modules — `#Import module`.
/// The same marker name is used by per-function `#Import(c)` declarations.
/// `CModuleKind::Extern` remains an internal AST compatibility name only.
/// D-CFFI-SYNTAX-REOPEN / D-CFFI-CANON1: retired C FFI marker spellings,
/// recognized only for E0060 teaching diagnostics.
MARKER_BINDGEN_RETIRED :: "bindgen"

MARKER_EXTERN_MODULE_RETIRED :: "Extern"

/// D-FFI-INLINE1=A (ratified 2026-07-11, card #501): the inline foreign tier
/// directive marker — `#FFI(<lang>) fn name(sig) { """<foreign source>""" }`.
/// The Jet signature is the checked contract; the body is one string of
/// foreign source the per-language binder compiles on cache miss. Unsafe
/// languages (`c`, `cpp`, `asm`) additionally require the enclosing
/// `#Unsafe("reason")` gate (I1/S58). Spelled fully capitalized (S66).
MARKER_FFI :: "FFI" // D-FFI-INLINE1

/// D-FFI-CPP1=A (ratified 2026-07-11, card #501): C++ foreign root — the
/// `cpp.<lib>` namespace binder and the `#FFI(cpp)` inline-tier language name.
CPP_MODULE_ROOT :: "cpp" // D-FFI-CPP1 / D-FFI-UNIFY1

/// D-FFI-ASM1=A (ratified 2026-07-11, card #501): the assembly inline-tier
/// language name — `#FFI(asm) fn`. Assembly has no library namespace (it is
/// inline-only); it never appears as a `<lang>.<lib>` mount.
ASM_LANG :: "asm" // D-FFI-ASM1

/// D-UNSAFE2 (retired marker): `#Audit("…")` is the old two-line form;
/// now the reason is the argument of `#Unsafe("reason")` itself. Recognized
/// only to emit the E0055 teaching error.
MARKER_AUDIT :: "Audit" // retired, D-UNSAFE2

                                        // D-LOOPLABEL3=A: named loops use `outer :: loop { … }`;
                                        // `break(outer)` / `next(outer)` target them. Retired `@`
                                        // prefix and suffix forms emit E0988.
                                        // D-ATTR3 = B (ratified 2026-06-19): `@` stays for labels; attributes use `#`.
                                        // D-QUAL4=A (ratified 2026-06-26): `#TagName T` is a value-tag qualifier in type
                                        // position. Transparent to type identity (the underlying type is still `T`).
                                        // Documented intent only; does not affect codegen or runtime behaviour.
                                        // Parser: `TokKind::Hash` followed by PascalCase ident → `Type::Tagged { marker, inner }`.
/// S59: cache directory segment under `.jet/` for generated C bindings.
BINDINGS_C_SUBDIR :: "bindings/c" // S59

/// D-FFI-UNIFY1: generated foreign bindings live under `.jet/bindings/<lang>/`.
BINDINGS_ROOT_SUBDIR :: "bindings" // D-FFI-UNIFY1

/// D-S14-PAUSE: retired foreign loop words are recognized only long enough to
/// report an ordinary current-syntax error; none is accepted as Jet syntax.
FOREIGN_WHILE :: "while"

FOREIGN_FOR :: "for"

FOREIGN_DO :: "do"

/// D-S14-PAUSE: `repeat` and `until` are foreign loop words; they are
/// recognized only long enough to report an ordinary current-syntax error.
FOREIGN_REPEAT :: "repeat"

FOREIGN_UNTIL :: "until"

FOREIGN_TRY :: "try"

/// D-S14-PAUSE: foreign declaration and binding words are diagnostic-only;
/// they never enter Jet grammar.
FOREIGN_FUN :: "fun"

FOREIGN_FUNC :: "func"

FOREIGN_DEF :: "def"

FOREIGN_FUNCTION :: "function"

FOREIGN_LET :: "let"

FOREIGN_VAR :: "var"

FOREIGN_CONST :: "const"

FOREIGN_VAL :: "val"

FOREIGN_IMPORT :: "import"

FOREIGN_PRINTLN :: "println"

FOREIGN_TEXT :: "Text"

/// S24: `match` recognized only for a teaching error naming `when`.
FOREIGN_MATCH :: "match"

/// S24 (D-SG1): `switch` recognized only for a teaching error naming `when`
/// (the keyword was `switch` before the 2026-06-15 rename).
FOREIGN_SWITCH :: "switch"

/// S29 (ratified M3): `class` recognized only for teaching error E0021.
FOREIGN_CLASS :: "class"

/// S28 (ratified M9): trait declaration keyword.
/// D-IMPLDOT1=A (ratified 2026-06-26): the trait separator in top-level impl blocks
/// is `.` — `impl Type.Trait { … }` / `impl Type.Trait using field`. The old `:`
/// separator emits E0320 (teaching error). Amends S28/S62; retires `~~` (S83).
KW_TRAIT :: "trait"

/// D-QUAL2 (ratified 2026-06-21): tag declaration keyword — a marker qualifier
/// with no methods that erases at runtime. The beginner rule: methods → trait,
/// no methods → tag. Declaring a method on a `tag` is E0732; using a tag where
/// dispatch is expected is E0731.
KW_TAG :: "tag"

/// S55 (ratified M9): opt-in built-in derive line in a type body.
KW_DERIVE :: "derive"

/// D-VERDICT-1308-1: retired compile-time spelling. The lexer retains a token
/// only so the parser can emit E0374 and offer `@`; this is not live Jet.
KW_COMPTIME :: "comptime"

/// S28: foreign trait spellings for teaching error E0022.
FOREIGN_INTERFACE :: "interface"

FOREIGN_TRAIT :: "trait"

/// D-NAMESPACE1=A: `namespace { }` is declined; in-file grouping uses `module name { }`.
/// Recognized to emit teaching error E0323 (S14-style).
FOREIGN_NAMESPACE :: "namespace"

/// S48 (M9): foreign dynamic-dispatch spellings for teaching error E0036.
FOREIGN_DYN :: "dyn"

FOREIGN_BOX :: "Box"

/// S24 (ratified M3): foreign switch arm spellings for teaching error E0023.
FOREIGN_CASE :: "case"

FOREIGN_DEFAULT :: "default"

/// S10 (ratified M2): foreign read/write forms for teaching errors.
FOREIGN_READ :: "read"

FOREIGN_WRITE :: "write"

FOREIGN_OWNED :: "owned"

/// S34 (ratified M4): old fallible type constructor, kept only for diagnostics.
TYPE_RESULT :: "Result"

/// S34 / D-SHAPE3b (ratified): Result variants are `Ok` / `Err`, including `.Ok` / `.Err`
/// when the expected result type is known.
LIT_OK :: "Ok"

LIT_ERR :: "Err"

/// S35 (ratified M4; spelling updated by S71/D-SG6; D-ERR-DECON1=A): the
/// fallback operator supplies a value or route (`return`, `next`, `break`, or
/// `panic`) when a `?T` is absent or a `T !E` failed. A block route may run
/// ordinary statements before its final value or diverging tail. Spelled `??`
/// since the 2026-06-15 rename (was the word `or`).
OP_FALLBACK :: "??"

/// S71 (ratified 2026-06-15, D-SG6): optional chaining — `a?.b` yields a `?T`
/// and short-circuits to absent on the first missing link.
OP_OPTIONAL_CHAIN :: "?."

/// S71 (ratified 2026-06-15, D-SG6): the retired word fallback, kept only for
/// the teaching error that points at `??`.
FOREIGN_OR_FALLBACK :: "or"

/// S36 (ratified M4): bug-stop builtins (like `print`).
BUILTIN_PANIC :: "panic"

/// D-META-USER1=A: a checked rule body rejects with a registered project
/// diagnostic: `reject(code:, what:, why:, fix:)`.
BUILTIN_REJECT :: "reject"

/// D-INTBIG1/D-NUMOPS1: default `Int` is exact. Fixed-width per-op overflow
/// opt-ins wrap one integer `+`/`-`/`*`/`/`: `wrapping(…)` wraps around,
/// `saturating(…)` clamps to the type's range, and `checked(…) -> ?T` returns
/// `null` on overflow. Fixed-width receiver methods use the same policy.
BUILTIN_WRAPPING :: "wrapping"

BUILTIN_SATURATING :: "saturating"

BUILTIN_CHECKED :: "checked"

INTERNAL_ARITHMETIC_CHECKED :: "__jet_arithmetic_checked"

/// D-NUMWIDEN-CROSS1=E (ratified 2026-07-28): accept a possibly inexact
/// integer-to-float crossing at one use site.
BUILTIN_APPROX :: "approx"

/// D-CLAIM-WORD1=B (ratified 2026-08-07, card #1641): the one assertion
/// family for code, tests, and scripts. The rich diff and one stop family
/// remain.
BUILTIN_ASSERT :: "assert"

BUILTIN_ASSERT_EQ :: "assert_eq"

/// D-CTIO1 (ratified 2026-06-22): the sanctioned build-time I/O builtins.
/// `embed_file("path") -> String` bakes a file's UTF-8 text into the binary;
/// `embed_bytes("path") -> [U8]` bakes its raw bytes (binary-safe). The path
/// must be a string literal, resolved relative to the source file, with no
/// `..`-escape past the project root. Only valid in a `comptime` binding.
/// D-CTFIND1/2: `find(glob) -> [String]` returns sorted relative file paths and
/// records each matched file hash for `.jet/lock`.
BUILTIN_EMBED_FILE :: "embed_file"

BUILTIN_EMBED_BYTES :: "embed_bytes"

/// D-CTEFFECT1 / D-PRELUDE-LAW1=A: gated build-time network fetch.
BUILTIN_FETCH :: "fetch"

/// S43 (ratified M6; PascalCase marker D-CASING1 follow-on 2026-06-21):
/// top-level test-declaration block, written as the marker `#Test("name") { … }`.
/// D-TESTPAREN1=A (ratified 2026-06-26): the name is now a parenthesized string
/// argument, matching the `#FX(…)` marker family.
/// D-TESTFAULT1=A (ratified 2026-08-12): the optional `faults: [Effect]`
/// argument names effect-root call sites for the deterministic test harness.
/// The bare lowercase `test` keyword (FOREIGN_TEST) is the retired spelling,
/// recognized only to emit the E0052 teaching error pointing at `#Test("name")`.
KW_TEST :: "Test"

TEST_FAULTS_PARAM :: "faults"

TEST_EXPECTED_FAIL_PARAM :: "expected_fail"

/// D-DOTSCOPE1 (ratified 2026-07-02): scope-member vocabulary for `#Test`.
/// Inside a `#Test { … }` body a statement-position `.name { … }` /
/// `.name(args) { … }` (I8: the ONE spelling for scope vocabulary) resolves
/// against this list. `.setup` runs first (init region), `.expect_fail` marks
/// a region that must fail, `.timeout(dur)` bounds a region's elapsed time,
/// `.skip` skips a region (or the whole test when it is the first statement),
/// `.measure` selects measurement, and `.cases(rows)` supplies per-row claims.
SCOPE_TEST_SETUP :: "setup"

SCOPE_TEST_EXPECT_FAIL :: "expect_fail"

/// D-TEST-STOPMSG1=A: non-empty literal substring of the region's raw stop text.
SCOPE_TEST_EXPECT_MESSAGE :: "message"

SCOPE_TEST_TIMEOUT :: "timeout"

SCOPE_TEST_SKIP :: "skip"

/// D-CLAIM-BENCH1=A (ratified 2026-08-07, card #1641): measurement is a
/// test member, selected by `jet test --measure`.
SCOPE_TEST_MEASURE :: "measure"

/// D-CLAIM-CASES1=B (ratified 2026-08-07, card #1641): table-driven claims
/// use the same member grammar; the optional explicit row name is handled by
/// the member head and defaults to `AMBIENT_CASE`.
SCOPE_TEST_CASES :: "cases"

/// D-JOB-NAME1=A / D-JOB-SUBCMD1=C: `#Job fn` — a top-level function Jet can
/// invoke as an argv subcommand, living beside `fn run()`. The word is `job`
/// everywhere (marker, `jet jobs`, diagnostics). Bare marker defaults to `.Dev`.
KW_JOB :: "Job"

/// D-JOB-SUBCMD1=C: the closed scope menu accepted by `#Job(<scope>)`.
JOB_SCOPE_VARIANTS :: [String]{"Dev", "Ship", "Internal"}

/// D-SCHEDULE1: `#Every(…)` — a declarative schedule marker on a `#Job fn`.
/// Legal only alongside `#Job` (E0925 otherwise).
MARKER_EVERY :: "Every"

/// D-REDUCE-VALUE1=A: closed Core enum used by SIMD lane reduction.
TYPE_REDUCE_OP :: "ReduceOp" // D-REDUCE-VALUE1

REDUCE_OP_VALUES :: [String]{"Add", "Mul", "Min", "Max", "Avg"} // D-REDUCE-VALUE1
