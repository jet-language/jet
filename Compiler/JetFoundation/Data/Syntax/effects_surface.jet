// Canonical owner-controlled syntax registry (I7).
// The reference comparison is temporary and is not a generator dependency.

/// (ratified 2026-06-17, E2-M11; PascalCase marker follow-on
/// 2026-06-21): typed goal `#Todo` — compiles everywhere, panics at runtime with
/// file, line, and expected type. Bare lowercase `todo` (FOREIGN_TODO) is the
/// retired spelling → E0054 teaching error pointing at `#Todo`.
KW_TODO :: "Todo"

/// S60's former `#Pure fn` marker, retained only so can reject it
/// with E0927. Explicit purity is the empty effect arrow `-[]>`; the same row
/// on a callback type (`f: fn(T) -[]> U`) demands a pure callback, with E0747
/// for an argument whose effects exceed it.
KW_PURE :: "Pure"

/// Amended by on
/// 2026-08-19: an explicit function effect row lives inside the unified arrow:
/// `-[FS.Read, ..E]>`. The empty row `-[]>` is an explicit purity bound; an
/// omitted row leaves ordinary `->` unchanged while sema still infers its
/// complete row. Public metadata and tooling project the normalized inferred
/// row whether source spells it or not.
/// These two fragments are the canonical punctuation used by the parser,
/// formatter, editor grammars, and generated documentation.
EFFECT_ARROW_OPEN :: "-["

EFFECT_ARROW_CLOSE :: "]>"

/// Package-scoped effect-leaf declaration.
/// A declared leaf makes its closed root checked in the package view.
KW_EFFECT_DECL :: "effect"

/// Reading the program's own arguments. It is a leaf of
/// `Exec` so the manifest-less floor can grant argument reading without the
/// `Exec` root, which also covers spawning processes. This is the one spelling
/// of the leaf; the Core registry, the ambient floor, and the leaf table read it.
EFFECT_LEAF_EXEC_ARGS :: "Exec.Args"

/// Waiting on the program's own work. A deny-only leaf
/// like the `Mem` root: inferred and forbiddable, never a requested grant.
EFFECT_LEAF_TIME_WAIT :: "Time.Wait"

/// Prelude effect leaves. These make the supported FFI language names
/// typo-checked without declarations in user code. The parent `FFI` root still
/// covers every leaf through ancestor subsumption.
BUILTIN_EFFECT_LEAVES :: [String]{
    "DB.Read",
    "DB.Write",
    "FS.Read",
    "FS.Write",
    "Rand.Draw",
    "Exec.Exit",
    EFFECT_LEAF_EXEC_ARGS,
    EFFECT_LEAF_TIME_WAIT,
    "FFI.Go",
    "FFI.Java",
    "FFI.DotNet",
    "FFI.Fortran",
    "FFI.Cobol",
    "FFI.Tcl",
    "FFI.Lua",
    "FFI.Ada",
    "FFI.Pascal",
    "FFI.Dart",
    "FFI.PowerShell",
    "FFI.Perl",
    "FFI.Ruby",
    "FFI.Php",
    "FFI.R",
    "FFI.Com",
    "FFI.C",
    "FFI.Cpp",
    "FFI.Asm",
    "FFI.Py",
    "FFI.Octave",
}

/// Retired spelling. Uses direct declared tags such
/// as `#Input value` and `#Credential value`.
KW_TAINTED :: "Tainted"

/// Prelude `Credential` fact tag. A credential value reaching `print`, `log`, or
/// `serialize` sinks is E0722. Part of the closed kind set already ratified in
/// (`.Input`/`.PII`/`.Secret`/`.Credential`). PascalCase per.
KW_CREDENTIAL :: "Credential"

/// Retired spelling. Uses `#Scrub(Tag)`.
KW_SANITIZER :: "Sanitizer"

/// A typed function contract that removes exactly one
/// declared fact tag from its result.
KW_SCRUB :: "Scrub"

/// Prelude fact tags. They are declarations, not compiler
/// flags, and may be used anywhere a declared tag may be used.
BUILTIN_TAGS :: [String]{"Input", "PII", "Secret", "Credential"}

/// (ratified 2026-06-22, option A): the typestate **require-state** fn
/// modifier — `#State(Confirmed) fn check_in(self, …)`. Declares the method valid
/// only when its receiver is currently in state `Confirmed`. Calling it on a value
/// in any other state is E0150. The state is an ordinary `tag` the
/// current state of a value is a compile-time fact threaded by forward dataflow,
/// erased in codegen (I3 — zero runtime cost). A paren-arg fn marker, parallel to
/// `#Layout(c)` / `#UnitFamily(Currency)`. The exact spelling is the implemented
/// default queued for owner confirmation as.
KW_STATE :: "State"

/// (ratified 2026-06-22, option A): the typestate **transition** fn
/// modifier — `#Transition(Pending, Confirmed) fn confirm(self) -> Reservation`.
/// Declares a function that consumes a value in state `Pending` and yields one in
/// state `Confirmed` (the ratified mechanism: "a fn takes the old state tag and
/// returns the next"). The from-state may be `_` for an **entry** transition (a
/// constructor that produces the initial state from nothing). Wrong from-state at a
/// call site is E0150; the call advances the receiver/result to the to-state. The
/// `->` inside reuses the callable arrow. Tags erase (I3). Implemented default queued
/// for owner confirmation as.
KW_TRANSITION :: "Transition"

/// (amends): the typestate **state-set section**
/// contextual keyword — `struct TypeName { state { Pending, Confirmed, CheckedIn } }`.
/// The bounded set is owned by the named struct, erases at runtime, and is checked
/// against its markers. A state referenced in `#State(X)` or `#Transition(A, B)`
/// that is not in the set is E0151. Contextual: `state` stays an ordinary identifier
/// outside a struct-body section.
KW_STATE_DECL :: "state"

/// Amended by the session/protocol
/// declaration contextual keyword — `protocol Name { client: Msg(…) }`.
/// Declares an ordered request/response exchange once; sema expands it into
/// `#SingleUse` `.Client`/`.Server` handle types with typestate-checked send/recv
/// methods (out-of-order use = E0150). Contextual like `state`/`migration`.
KW_PROTOCOL :: "protocol"

/// Endpoint labels in a protocol message line.
PROTO_CLIENT :: "client"

PROTO_SERVER :: "server"

/// The rule-declaration contextual keyword —
/// `marker Name(params…)`. Declares one applied rule as
/// an ordinary Jet declaration in Prelude (or, later, library) source; the
/// rule's own arguments and facts about the rule (`$sites`, `$repeatable`, …)
/// share one named-parameter list under the facts marked with
/// the compile-time sigil. Contextual like `state`/`protocol`. Declaration-
/// side parse only (card #1456); lowering the parsed declaration into the
/// runtime registry row the rest of the compiler consumes is #1457's and
/// #1458's job.
KW_MARKER :: "marker"

/// The one non-code fact declaration word —
/// `fact Name($holds: …, $safe: …, …)`. It reuses the marker declaration
/// parameter-list shape; the registry reads its rows from `Prelude/Facts.jet`.
KW_FACT :: "fact"

/// The entry-transition placeholder — `#Transition(_, Pending)` means
/// "from no prior state". Reuses the existing `_` wildcard glyph.
STATE_ENTRY :: "_"

/// (ratified 2026-08-25): `#FX` is the short expert-source
/// boundary for inferred effects and scoped authority. Bare `#FX(Net, DB)`
/// narrows the block; `#FX(grant: FS, Net)` also binds `grant`. PascalCase
/// effect roots remain the canonical values. Erased in codegen (I3).
KW_FX :: "FX"

/// Parser tombstone for the retired Grant marker.
RETIRED_MARKER_GRANT :: "Grant"

/// The type of a scoped Authority handle bound by
/// `#FX(grant: FS, Net) { … }`. It is an ordinary value type; the block still
/// erases in codegen, but the handle can cross only where the surrounding API
/// accepts Authority.
AUTHORITY_HANDLE_TYPE :: "Authority"

/// Parser-only receiver used while lowering `task` sugar.
INTERNAL_TASK_RECEIVER :: String.from_bytes([U8]{0, 106, 101, 116, 46, 116, 97, 115, 107})

/// Compiler-only dispatch type for a `task` combinator that is not attached to
/// a lexical `Group` handle.
INTERNAL_TASK_SURFACE_TYPE :: String.from_bytes([U8]{0, 106, 101, 116, 46, 116, 97, 115, 107, 46, 115, 117, 114, 102, 97, 99, 101})

/// Compiler-only dispatch type for a canonical combinator inside `task.group`.
INTERNAL_TASK_GROUP_SURFACE_TYPE :: String.from_bytes([U8]{0, 106, 101, 116, 46, 116, 97, 115, 107, 46, 103, 114, 111, 117, 112, 46, 115, 117, 114, 102, 97, 99, 101})

/// The
/// compiler-private handle type bound by `task.group g { … }` and accepted in
/// any direct parameter position — a method's parameter list exactly like a
/// free function's. It carries the lexical group's internal collector through
/// lowering; it is not a public first-class value, so it is refused in a struct
/// field, a return type, a local annotation, a lambda parameter, and every
/// aggregate.
TYPE_TASKGROUP :: "Group"

/// Compiler-private dispatch method for canonical `task` spawn syntax.
INTERNAL_TASK_SPAWN_METHOD :: String.from_bytes([U8]{0, 106, 101, 116, 46, 116, 97, 115, 107, 46, 115, 112, 97, 119, 110})

/// Compiler-private dispatch method for `task.timeout(duration)`.
INTERNAL_TASK_TIMEOUT_METHOD :: String.from_bytes([U8]{0, 106, 101, 116, 46, 116, 97, 115, 107, 46, 116, 105, 109, 101, 111, 117, 116})

/// User-facing selector for the canonical task timeout surface.
TASK_TIMEOUT_SELECTOR :: "timeout"

/// Compiler-private dispatch method for `task.all { … }`.
INTERNAL_TASK_ALL_METHOD :: String.from_bytes([U8]{0, 106, 101, 116, 46, 116, 97, 115, 107, 46, 97, 108, 108})

/// Compiler-private dispatch method for `task.race { … }`.
INTERNAL_TASK_RACE_METHOD :: String.from_bytes([U8]{0, 106, 101, 116, 46, 116, 97, 115, 107, 46, 114, 97, 99, 101})

/// Compiler-private dispatch method for `task.any { … }`.
INTERNAL_TASK_ANY_METHOD :: String.from_bytes([U8]{0, 106, 101, 116, 46, 116, 97, 115, 107, 46, 97, 110, 121})

/// Mark a task paused in the control plane.
METHOD_TASK_PAUSE :: "pause"

/// Clear the paused marker in the control plane.
METHOD_TASK_RESUME :: "resume"

/// Request cancellation for a task in the control plane.
METHOD_TASK_CANCEL :: "cancel"

/// (ratified 2026-06-24): the transaction-block marker, written
/// `#Transact(order) { … }`. `order` binds a user-chosen transaction handle
/// (any lowercase ident, mirroring `region r { … }`). Inside the block an
/// irreversible effect (Net/FS/Exec) is rejected (E0746); the fix is to
/// move it after the block or register it on the handle via
/// `order.on_commit(() -> { … })` which runs Drop-backed on a clean
/// commit. PascalCase per. Erased in codegen (I3).
KW_TRANSACT :: "Transact"

/// (ratified 2026-06-24): the post-commit hook method on a transaction
/// handle — `order.on_commit(() -> { … })`. Drop-backed (model), runs
/// LIFO on a clean commit and is dropped (not run) on a `?`-failure/rollback.
/// NO new keyword (library form, I7 untouched).
TXN_ON_COMMIT :: "on_commit"

/// (ratified 2026-06-25, layer 3): the explicit rollback-hook
/// method on a transaction handle — `order.on_rollback(() -> { … })`. The exact
/// mirror of `on_commit`: Drop-backed (model), runs LIFO on a
/// `?`-failure/rollback and is dropped (not run) on a clean commit. A value handled
/// by an explicit `on_rollback` is the author's to undo, so it is NOT auto-snapshot
/// (layer 1) — they took control and skip the perf cost. NO new keyword (library
/// form, I7 untouched).
TXN_ON_ROLLBACK :: "on_rollback"

/// (ratified 2026-06-25, layer 2): the trait a type may derive/impl
/// to customize how a mutated value is snapshotted and restored inside a `#Transact`
/// block (e.g. a cheap diff instead of a full deep copy). When a mutated value's
/// type implements `Rollback`, the auto-snapshot (layer 1) uses it instead of a
/// generic clone. A user-derivable trait name (I7).
TRAIT_ROLLBACK :: "Rollback"

/// User-facing string rendering for `{}` interpolation.
TRAIT_DISPLAY :: "Display"

/// Developer-facing debug rendering for `{value:Debug}` interpolation.
TRAIT_DEBUG :: "Debug"

/// Expert opt-in hook enabling zero-copy `loop x in mytype`.
TRAIT_ITERABLE :: "Iterable"

/// Cursor type for `Iterable::iter`.
TRAIT_ITERATOR :: "Iterator"

/// Expert opt-in hook enabling `mytype[key]` read syntax.
TRAIT_INDEX :: "Index"

/// Expert opt-in hook enabling `mytype[key] = v` write syntax.
TRAIT_INDEX_MUT :: "IndexMut"

/// Expert operator hooks. Existing symbols and precedence only.
TRAIT_ADD :: "Add"

TRAIT_SUB :: "Sub"

TRAIT_MUL :: "Mul"

TRAIT_DIV :: "Div"

TRAIT_EQUATABLE :: "Equatable"

TRAIT_COMPARABLE :: "Comparable"

TYPE_ORDERING :: "Ordering"

/// The prelude `Numeric` trait. It builds on the
/// operator hooks with the right side fixed to `Self` plus ordering, and adds
/// two static members. `/` and unary minus are deliberately outside it.
/// Built-in numbers (Int, Float, F32, sized integers, Decimal, Fraction) and
/// every `#Numeric` distinct type implement it; structs may `impl T.Numeric`.
TRAIT_NUMERIC :: "Numeric"

NUMERIC_SUPERTRAITS :: [String]{TRAIT_ADD, TRAIT_SUB, TRAIT_MUL, TRAIT_COMPARABLE}

NUMERIC_STATIC_MEMBERS :: [String]{"zero", "one"}

/// Variant order is the shared scalar carrier order for the built-in enum.
ORDERING_VARIANTS :: [String]{"Less", "Equal", "Greater"}

/// Nominal byte-stream read contract in `core.term`.
TRAIT_IO_READER :: "Reader"

/// Nominal byte-stream write contract in `core.term`.
TRAIT_IO_WRITER :: "Writer"

/// Backend-neutral typed-SQL driver
