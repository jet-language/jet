TOOL_SUBCOMMAND :: "tool"

TOOL_VERB_INSTALL :: "install"

TOOL_VERB_LIST :: "list"

TOOL_VERB_UNINSTALL :: "uninstall"

TOOL_VERBS :: [String]{TOOL_VERB_INSTALL, TOOL_VERB_LIST, TOOL_VERB_UNINSTALL}

