// Canonical owner-controlled syntax registry (I7).
// The reference comparison is temporary and is not a generator dependency.

/// The sole prefix for applying a typed rule. A rule may target a
/// declaration, expression, or brace scope when that rule declares the target
/// legal. Supersedes the former marker-plane reservation: `$` marks compiler
/// facts (`T.$layout`, `$build.os`, D-COMPILER-NS1=A), prefix `@` marks only a
/// live link, and infix `@` remains the package-source reference.
///
/// `#` has two other jobs, told apart by parser position only (no lookahead
/// heuristics): inside a bracketed type, `[T#N]`, it is the fixed-size-list
/// separator (S76 `TYPE_FIXED_SIZE_SEP`); after a package name it is the
/// version-pin separator (`pkg#1.2.0`, same constant). Keeps all three jobs on
/// one token.
RULE_PREFIX: "#"

/// Writes one of a declaration's markers as a line inside its body:
/// `#X: value`, alone on its line, directly in the body of a struct, enum,
/// trait, impl, module or function. `#X: true` applies `#X` with no
/// arguments, `#X: false` is `#!X`, `#X: v` passes one simple argument
/// (a name path, string or number) and `#X: (args)` passes any other list.
/// The line is the same marker as `#X(args)` above the declaration; one
/// declaration writes its whole set in one place.
MARKER_INBODY_SEPARATOR: ":"

/// Precondition contract on a function
/// signature — `#Pre(cond, "msg")`. The condition is a pure expression (same
/// checker as `#Pure`). Checked in every build by default; per-module
/// build-policy strip is the explicit opt-out.
MARKER_PRE: "Pre"

/// Postcondition contract — `#Post(cond,
/// "msg")`; `result` names the return value inside `cond`.
MARKER_POST: "Post"

/// Stores a pure function result or a computed
/// field result until its checked inputs change. Functions use the bounded
/// default or `bound: none`; the field form is bare `#Memo` before
/// `name: T -> expr`.
MARKER_MEMO: "Memo"

/// Explicit safe kernel declaration —
/// `#Kernel(.parallel) name: fn …`. The mode is intentionally a closed marker
/// argument, so adding another execution mode needs a new owner ruling.
MARKER_KERNEL: "Kernel"

/// Dev-tier contract on a module-level
/// binding — the value survives `jet dev` hot reloads (identity = module
/// path + binding name). Inert in release builds.
MARKER_PERSIST: "Persist"

/// `#Inline fn` / `#Inline` method — a
/// soft hint that this function/method should be inlined (`#[inline]` in
/// codegen). Never rejected by sema; the compiler is free to ignore it.
/// Methods stay ordinary functions — no macro-rewrite hooks.
MARKER_INLINE: "Inline"

/// Native auto-vectorization is the default for native AOT builds;
/// `#Scalar` is the explicit per-function/method opt-out.
MARKER_SCALAR: "Scalar"

/// Derives the reverse lookup for a typed Add/Mul impl.
MARKER_COMMUTATIVE: "Commutative"

MARKER_STATIC: "Static"

/// (rides
/// Formerly):
/// struct-level CLI derive marker — `#CLI`. A resolved `run: fn(args: T)`
/// parameter type owns parsing, defaults, help, completion, validation, and
/// audit facts. In E, one marked program struct also owns root flags and
/// callable-member commands. The marker is optional because plain `run: fn()`
/// remains a complete entry.
MARKER_CLI: "CLI"

/// (card #181): struct-level derive — generates nested `T.Patch` with
/// `apply`/`diff`/`merge`, Codable by construction (Encode+Decode on Patch).
MARKER_PATCHABLE: "Patchable"

/// Field and command help for CLI-derived
/// arguments. Reuses
/// it only when the function marker group also contains `#Job`.
MARKER_DOC: "Doc"

/// Field-level opt-out from positional filling on a `#[CLI]`
/// required value field — `#[Flag]`. Without it, required scalars fill from
/// bare argv in declaration order; with it, only `--field` is accepted.
MARKER_FLAG: "Flag"

/// One-letter alias for a `#[CLI]` field.
MARKER_SHORT: "Short"

/// Environment fallback for a value `#[CLI]` field.
MARKER_ENV: "Env"

/// Marks the first bare-read parameter of a free function as
/// the receiver for the equivalent `value.function(…)` spelling.
MARKER_ROOT: "Root"

/// Per-function native calling-convention marker for C
/// declarations. C remains the implicit default; alternate ABIs never inherit.
MARKER_ABI: "ABI"

/// `#Undo(inverse)` names the compensating function a
/// foreign binding registers on the enclosing transaction's rollback path.
MARKER_UNDO: "Undo"

/// `#Close(close)` joins a returned foreign handle to the
/// consuming `close(^handle)` protocol. The named foreign function is checked
/// against the returned handle before the binding is registered.
MARKER_CLOSE: "Close"

/// Per-site lint-suppression marker —
/// `#Allow(jet.FloatMoney, "why")` on a declaration, field or statement
/// silences that one lint there. The lint is named by its diagnostic type
/// path. Site collection: `semindex_collect_allow_markers` in
/// `JetSemIndex/Source/SemIndex/Structure.jet`; the allowance itself:
/// `JetSema/Source/Sema/LintAllowances.jet`.
MARKER_ALLOW: "Allow"

/// (ratified 2026-08-19): any package may mark a public item
/// as retiring with `#Deprecated(since: ..., use: ..., removed_in: ...)`.
MARKER_DEPRECATED: "Deprecated"

/// Marks a named type as an allowed explicit error
/// domain for a `!Error` callable contract.
MARKER_ERROR: "Error"
