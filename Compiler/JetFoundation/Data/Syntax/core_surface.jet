// Canonical owner-controlled syntax registry (I7).
// Mechanically ported by Tools/agent/port-syntax-registry.mjs; edit this Jet home.
// The reference comparison is temporary and is not a generator dependency.

/// N1 (ratified): language name.
LANG_NAME :: "Jet"

/// N1 (ratified): compiler binary name.
BINARY_NAME :: "jet"

/// D-UNSAFE-OBLIG1=A: CI/admin input naming a manifest-shaped organization
/// policy file. The loader fails closed when a configured file cannot be read.
ENV_ORG_UNSAFE_POLICY :: "JET_ORG_UNSAFE_POLICY"

/// D-UNSAFE-OBLIG1=A: typed compile-time unsafe proof statement and its
/// parser-only call sentinel (removed by sema before TIR).
KW_ASSERT :: "assert"

INTERNAL_UNSAFE_ASSERT :: "__jet_unsafe_assert"

UNSAFE_OBLIGATION_VALID_PTR :: "valid_ptr"

UNSAFE_OBLIGATION_ALIGNED :: "aligned"

UNSAFE_OBLIGATION_NO_ALIAS :: "no_alias"

/// N2 (ratified): source file extension (without the dot).
FILE_EXT :: "jet"

/// D-ARTIFACT-EXT1=A: closed product-named artifact family. New kinds require
/// an owner ballot; consumers compare against these exact suffixes.
ARTIFACT_EXT_SOURCE_MAP :: ".jetmap"

ARTIFACT_EXT_NOTEBOOK :: ".jetnb"

ARTIFACT_EXT_PROOF :: ".jetproof"

ARTIFACT_EXT_TRACE :: ".jettrace"

ARTIFACT_EXT_GAME_REPLAY :: ".jetreplay"

ARTIFACT_EXT_PROOF_REPLAY :: ".jetproof-replay"

ARTIFACT_KINDS :: [(field_0: ArtifactKind, field_1: String)]{
    (field_0: ArtifactKind.SourceMap, field_1: ARTIFACT_EXT_SOURCE_MAP),
    (field_0: ArtifactKind.Notebook, field_1: ARTIFACT_EXT_NOTEBOOK),
    (field_0: ArtifactKind.Proof, field_1: ARTIFACT_EXT_PROOF),
    (field_0: ArtifactKind.Trace, field_1: ARTIFACT_EXT_TRACE),
    (field_0: ArtifactKind.GameReplay, field_1: ARTIFACT_EXT_GAME_REPLAY),
    (field_0: ArtifactKind.ProofReplay, field_1: ARTIFACT_EXT_PROOF_REPLAY),
}

/// S1 (ratified): keyword that starts a function definition.
KW_FN :: "fn"

/// D-GENERIC-CALL1=A (ratified 2026-08-03): explicit call-site type arguments
/// use the existing angle tokens and must stay adjacent to the call parens.
/// These constants name the source surface; Jet does not use Rust's `::<T>`.
GENERIC_CALL_OPEN :: "<"

GENERIC_CALL_CLOSE :: ">"

/// D-MOD4: `pub use` re-export is the only remaining `pub` form (re-export
/// ballot pending, card #4723). D-VIS-MODULE1: `pub` on a declaration or field is
/// rejected (E0411) with a fix that deletes it.
KW_PUB :: "pub"

/// D-VIS-MODULE1 (owner directive 2026-10-07, card #4723): everything is public by
/// default. `priv` marks a module (`priv module name`, usable only by its
/// enclosing module) or a struct field (usable only by the type's own module).
KW_PRIV :: "priv"

/// D-VIS-MODULE1: retired file marker, recognized only so E0418 can delete it.
MARKER_PUB_FILE :: "PubFile"

/// D-PRELUDEX1=A (ratified 2026-06-28): file-scope marker that disables the
/// readable Core prelude. Expert escape hatch only — no library may inject into
/// the no-prefix surface.
MARKER_NO_PRELUDE :: "NoPrelude"

/// D-VISDEFAULT2 option B (rejected): foreign spelling of `priv`, recognized
/// only for E0412 teaching diagnostics.
FOREIGN_PRIVATE :: "private"

/// D-SHAPE-CLI-COMPLETE1=A: external program schema source for
/// `jet self completions SHELL --for PROGRAM`.
CLI_COMPLETIONS_FOR :: "--for"

/// D-VIS-MODULE1: retired file marker spelling, recognized only so E0418 can
/// delete it.
MARKER_PUBLIC_FILE :: "PublicFile"

/// D-VIS-MODULE1: `priv(package) module` — the module is usable by every module
/// of the same package and invisible to other packages.
PRIV_PACKAGE_QUALIFIER :: "package"

/// S2 / D-BIND1 / D-BIND4 / D-BIND-BARE1: immutable binding sigil `name :: expr`.
/// D-BIND-BARE1 retires typed bindings (`name: Type :: expr`); types ride the
/// value (`Type{ … }`) or live on signatures and fields.
/// D-BODY-LAST1=B, D-SIG-SHAPE1=B, and D-SIG-AFTER1=A: `::` is not a
/// function-body marker. Named function bodies use braces. `->` introduces
/// the return type on signatures and still opens control, arm, and lambda
/// bodies. `::` keeps its binding meaning and `=` remains for slot-filling
/// declarations such as extern bindings.
SIGIL_BIND_IMMUT :: "::"

/// S2 / D-BIND1 (ratified 2026-06-18): mutable binding sigil `name := expr`
/// (was the keyword `var`). `=` stays reassignment of an existing `:=` (S17).
/// D-BIND-BARE1 retires typed bindings (`name: Type := expr`).
SIGIL_BIND_MUT :: ":="

/// D-EACH1=C / D-FENCE2=A: open/close a lock-step statement-expansion fence.
/// Binding fences carry plain names; expression fences carry names or
/// expression entries (D-FENCE-RANGE1 expands ascending integer-literal
/// ranges). Both digraphs are longest-match lexer tokens; `<`, `<=`, `<=>`,
/// `>`, and generic `<T>` never need the adjacent pairs.
SIGIL_FENCE_OPEN :: "<:"

SIGIL_FENCE_CLOSE :: ":>"

/// D-FENCE2=A: the retired D-FENCE-GLYPH1 fence digraphs. The lexer
/// recognizes them only for the E-FENCE-SPELLING teaching diagnostic.
RETIRED_FENCE_OPEN :: "@["

RETIRED_FENCE_CLOSE :: "]@"

/// D-TRACK-ORIGIN1=A: binding-level tracking marker, written before the binding:
/// `#Track name :: expr` / `#Track name := expr`.
MARKER_TRACK :: "Track"

/// D-COMPILER-NS1=A / D-META-ROOT3=A: the compiler-fact sigil. A fact is a
/// `$` member of the thing it describes (`T.$layout`, `f.$effects`,
/// `value.$origin`); subjectless facts use the roots `$build`, `$package`,
/// `$phase` and `$program` (D-BUILD-FACT3=A); marker and fact declarations
/// mark compiler metadata the same way (`$sites:`, D-DECL-META1=A). Inside a
/// derive or marker template the same mark splices a template binding
/// (`fn $method`, `self.$field`, `.$left`; D-NAME-SPLICE1=B). The mark
/// belongs to the name, and programs never declare a `$` name. Config
/// surfaces read the same token as a `$NAME` environment read
/// (D-ONCE-DOLLAR1=B).
COMPTIME_MARK :: "$"

/// D-COMPILER-NS1=A: the retired fact, metadata and splice mark. `T.@layout`,
/// `@build.os` and `@sites:` are accepted only for the E0003 teaching
/// diagnostic, and `fn @method` / `self.@field` only for E0388; prefix `@`
/// in code now means a D-MEMREF1 link.
RETIRED_COMPTIME_MARK :: "@"

/// The four subjectless fact roots (D-META-ROOT3=A, D-BUILD-FACT3=A).
FACT_ROOT_BUILD :: "$build"

FACT_ROOT_PACKAGE :: "$package"

FACT_ROOT_PHASE :: "$phase"

FACT_ROOT_PROGRAM :: "$program"

/// D-META-STAGE1=B: the retired marker spelling for compile-time demand. It is
/// kept only so the parser can recognize it and teach the `@` mark (E0377); no
/// current Jet source writes it.
RETIRED_MARKER_KNOWN :: "Known"

/// D-CANVASSTATE1=D (ratified 2026-07-09): statement switch-off attribute.
/// `#Off <stmt>` parses and type-checks the statement, then emits no code.
MARKER_OFF :: "Off"

/// D-CANVASSTATE1=D (ratified 2026-07-09): debug-only statement attribute.
/// `#DebugOnly <stmt>` emits only in debug/dev builds; release builds strip it.
MARKER_DEBUG_ONLY :: "DebugOnly"

/// D-CANVASMETA1=B (ratified 2026-07-09): tooling metadata attribute for
/// bindings, top-level consts, and functions.
MARKER_META :: "Meta"

/// D-DX-PLUGIN1=D: one marker discovers an exported typed devtools panel.
MARKER_DEV_PANEL :: "DevPanel"

/// D-FOUND-EMBEDDED1 / #2793: bind a bounded target interrupt handler.
MARKER_INTERRUPT :: "Interrupt"

/// D-DX-PLUGIN1=D: the shared Core module and member for typed publications.
CORE_DEVTOOLS_MODULE :: "core.devtools"

CORE_DEVTOOLS_PUBLISH :: "publish"

TYPE_UI_NODE :: "UINode"

/// D-CANVASMETA1=B: `#Meta` category field name.
META_FIELD_CATEGORY :: "category"

/// D-CANVASMETA1=B: `#Meta` tunable flag field name.
META_FIELD_TUNABLE :: "tunable"

/// D-MARK-META1=B: `#Meta` maturity field name.
META_FIELD_MATURITY :: "maturity"

/// S3 (ratified): block delimiters.
BLOCK_OPEN :: "{{"

BLOCK_CLOSE :: "}}"

/// D-FAILURE-FOUNDATION1=A / D-FAIL-CTX1=A: `?` is the contextual journey
/// marker only when followed by `(text)`; ordinary fallible calls propagate
/// implicitly. The note is lazy and source-linked.
OP_TRY_SUFFIX :: "?"

/// S5 (ratified): line comments run from this prefix to end of line.
COMMENT_PREFIX :: "//"

/// S5 (ratified 2026-06-15): block comments `/* … */`, nesting allowed so a
/// region containing other comments can always be commented out.
BLOCK_COMMENT_OPEN :: "/*"

BLOCK_COMMENT_CLOSE :: "*/"

/// S6 / S6-R (ratified 2026-06-18): the statement terminator. Under S6-R it is
/// **never user-typed** — the lexer inserts a synthetic `;` at each line end
/// after a statement-ending token (Go-style), so the grammar stays
/// terminator-based while source has no visible semicolons. `jet fmt` emits
/// none. The constant remains because the token still exists internally.
STMT_SEP :: ";"

/// S8 (ratified): string interpolation delimiters inside quoted text.
INTERP_OPEN :: "{{"

INTERP_CLOSE :: "}}"

/// S9 (ratified): the prelude-declared print function (adds a newline).
BUILTIN_PRINT :: "print"

/// D-DBG1=A (owner: named `debug`, not `dbg`): the prelude-declared
/// development trace. `debug(value)` returns `value` unchanged, adds no
/// effect, and in development builds writes one stderr line
/// `[debug] file.jet:LINE expr = <Debug form>`. Shipped artifacts and
/// release-profile builds reject it (E3405).
BUILTIN_DEBUG :: "debug"

/// D-DBG1=A: sema-only name of a checked `debug(value)` call. Sema appends
/// the site text (`file.jet:LINE expr`) as a second argument so every
/// evaluator prints the same line without re-reading source. Never a source
/// spelling.
INTERNAL_DEBUG_TRACE :: "__jet_debug_trace"

/// D-DBG1=A: the stderr prefix every tier writes before the site text.
DEBUG_TRACE_PREFIX :: "[debug]"

/// D-NAME-ALIAS1=A: `input` is prelude-declared (no `use core.term` required).
/// `print` and `input` remain the interactive I/O subset. Other `core.term`
/// members are opened through the readable prelude's explicit aliases.
BUILTIN_INPUT :: "input"

/// S11 (ratified): built-in type names (M1).
TYPE_INT :: "Int"

TYPE_FLOAT :: "Float"

TYPE_BOOL :: "Bool"

TYPE_STRING :: "String"

/// D-TEXTHEAD-TYPE1=A / D-UNIFYLIT1=A: canonical checked HTML text type.
TYPE_HTML :: "HTML"

/// S80 (ratified; amended by D-FAIL-ERROR1=A): default error type and
/// constructor share `Err`.
TYPE_ERR :: "Err"

/// D-FAILURE-FOUNDATION1=A / D-NEVER2=B: `Never` is the existing bottom
/// error-domain name and is also legal in callable success-return slots.
/// It remains uninhabited in every ordinary value position.
TYPE_NEVER :: "Never"

/// D-FAIL-BIND1=A (ratified 2026-08-06): ambient failure report inside a
/// fallible `??` fallback. This is an ordinary contextual identifier, not a
/// lexer keyword.
AMBIENT_ERR :: "err"

/// D-CLAIM-CASES1=B (ratified 2026-08-07, card #1641): the optional-name
/// `.cases` member uses this ambient binding when the author gives no name;
/// an explicit member-head name overwrites it inside that member's rows.
AMBIENT_CASE :: "case"

/// Retired S80 type spelling. Parser keeps it only for E0432 teaching.
RETIRED_TYPE_ERROR :: "Error"

/// D-VOID1: the public no-information result spelling is `()`.
TYPE_UNIT :: "()"

/// Compiler-only name carried by the existing zero-sized runtime value.
INTERNAL_UNIT_TYPE :: "Unit"

/// D-CHOOSE-HEADS1=A: compiler-private subject name for the one ordinary
