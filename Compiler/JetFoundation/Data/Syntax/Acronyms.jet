// Canonical owner-controlled syntax registry (I7).
// The reference comparison is temporary and is not a generator dependency.

/// Closed applied acronym lexicon (owner rule 2026-09-30):
/// every initials-formed word in current Jet names, in canonical caps. A
/// PascalCase word whose letters (ignoring trailing digits) equal an entry
/// case-insensitively is written in these caps (`Http` -> `HTTP`,
/// `Utf8` -> `UTF8`). Keep in sync with `SEMA_CASING_ACRONYMS` in
/// Compiler/JetFoundation/Source/Names/Casing.jet.
ACRONYMS: [String]{
    "AABB", "ABI", "AES", "ALPN", "ANSI", "AOT", "API", "ASCII", "AST", "BPE", "CAS", "CBOR",
    "CDP", "CFG", "CI", "CLI", "CMS", "CPU", "CSR", "CSS", "CSV", "DB", "DMA", "DNS",
    "DSL", "DTD", "EOF", "FFI", "FS", "GC", "GPIO", "GPU", "HLL", "HMAC", "HSM", "HTML", "HTTP",
    "ID", "IME", "IO", "IP", "IR", "JIT", "JS", "JSON", "JSONL", "JVM", "KDF", "KMS", "LRU",
    "LSP", "LTO", "LWW", "MCP", "MIME", "MMIO", "OCI", "OS", "PEM", "PID", "PM", "PNG",
    "RGA", "RGB", "RNG", "RPC", "RSA", "SDK", "SHA", "SPSC", "SQL", "SRI", "SRV", "SSG",
    "SSH", "SSR", "SVD", "SVG", "TCP", "TLS", "TOML", "TTY", "TUF", "TUI", "UART", "UDP",
    "UI", "URI", "URL", "UTF", "UUID", "VJP", "VM", "XML", "YAML",
}

/// Mixed-case words with one fixed canonical spelling.
ACRONYM_COMPOUNDS: [(field_0: String, field_1: String)]{(field_0: "macos", field_1: "MacOS"), (field_0: "ipv4", field_1: "IPv4"), (field_0: "ipv6", field_1: "IPv6")}

/// Acronyms that stay ordinary words (not initials-formed).
ACRONYM_WORD_EXCEPTIONS: [String]{"Wasm", "Bindgen"}
