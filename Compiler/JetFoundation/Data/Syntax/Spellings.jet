// Canonical owner-controlled syntax registry (I7).
// Tools/agent/LexicalLedger.jet renders LEXICAL_LEDGER into
// Docs/spec/syntax-decisions.md.

LexicalEntry: struct {
    spelling: String
    meaning: String
}

LEXICAL_LEDGER: [LexicalEntry]{
    { spelling: ":", meaning: "immutable binding and declaration: `name: value`, `name: fn(…)`, `Name: struct {{…}}`, `name: module {{…}}`" },
    { spelling: ":=", meaning: "mutable binding" },
    { spelling: "name := value", meaning: "mutable module global at file scope: starts from any storable value its initializer computes while building, held as program data with no startup copy, which an assignment replaces; only a value holding a runtime handle, such as a `Shared` cell, is built on the global's first use" },
    { spelling: "use {{ … }} / use alias: path", meaning: "import block: one row per line, each a module path, `alias: path`, a \"file\" path or `alias: \"file\"`; `alias: owner.x` where `owner.x` names no module binds the member `x` that `owner` declares; several blocks per scope, `pub use {{ … }}` re-exports every row" },
    { spelling: "x.copy()", meaning: "the one deliberate copy: a compiler-owned method returning an independent owned value" },
    { spelling: "name: T -> expr", meaning: "computed struct field: a read-time formula read like a field; nothing assigns, lends for writing or takes it, even inside its module (E0339), so a public one over `priv` storage is a read-only field" },
    { spelling: "Name: enum {{ A, B(T) }} / .A / Name.A", meaning: "enum declaration: its cases are written bare and separated as struct fields are; a value or pattern names a case with its leading dot where the type is known (`.A`) or with the enum's name (`Name.A`); a dotted declaration is not Jet syntax" },
    { spelling: "#", meaning: "attached marker; #[A, B] stacks" },
    { spelling: ".expect_fail(message: \"text\")", meaning: "test region requires a stop with an optional E30xx code and non-empty case-sensitive raw-message substring" },
    { spelling: "Name: struct {{ impl Marker {{ group: #[A, B] }} }}", meaning: "fixed named marker-group declaration; expands at each use without hiding gates or refusals" },
    { spelling: "#module.Marker / #[module.Marker, Other]", meaning: "library marker through the import's local name; pub exports its declaration" },
    { spelling: "#Inline / #Scalar / #Kernel / #Static", meaning: "separate callable promise, scalar hint, kernel proof and constant storage rules" },
    { spelling: "#DevPanel", meaning: "exported typed devtools panel marker" },
    { spelling: "web.form(Model, action: handler)", meaning: "struct-derived headless form with progressive action" },
    { spelling: "#Layout(c, align(N)) / #Layout(c, align(target, N))", meaning: "C layout with portable or target-supported explicit alignment" },
    { spelling: "#Align", meaning: "retired standalone alignment marker" },
    { spelling: "Atomic<T>", meaning: "safe lock-free scalar cell" },
    { spelling: "@", meaning: "live link; the retired compile-time `@NAME` constant, `@` template name splices and `@` fact spellings are not Jet syntax" },
    { spelling: PREP_RUN, meaning: "compiler request: `#run {{ … }}` runs while building; `NAME: #run build_table()` is the only binding that forces compile time (a plain `NAME: value` folds while building when it can); an unbraced `#run` takes one postfix operand, a call, a name or a literal, and anything larger keeps its braces; the `#run` word, `@ {{ … }}` and `prep` are retired" },
    { spelling: PREP_IF, meaning: "build-time branch; unchosen arms are name-checked only" },
    { spelling: PREP_LOOP, meaning: "build-time loop over statements or declarations" },
    { spelling: "#run fn", meaning: "build-time literal-hook method" },
    { spelling: "#run use {{ … }} / #run use alias: path", meaning: "build-only import: the rows of `use`, whose names work only in compile-time code (a `#run {{ … }}` block, a `#run fn` body, a compile-time argument, a value computed while building); a user module only compile-time code uses, however it is imported, stays out of the shipped program" },
    { spelling: "#Pre(#run {{ … }}, \"…\")", meaning: "required early answer: `#run` around a marker expression (a `#Pre` or `#Post` predicate, a `#Memo` bound, a `#Layout` alignment) evaluates it while building at the contract's instantiation point, after the call's checked argument facts are substituted; a false `#Pre` is a build error, and an answer that can't be computed while building is its own error, never deferred to run time" },
    { spelling: "<N: Int>", meaning: "compile-time number parameter declaration: a parameter bounded by exactly the core `Int` is a number, not a type" },
    { spelling: "$", meaning: "config-surface environment read `$NAME`; program source has no `$` words" },
    { spelling: "#{{name}}", meaning: "template paste: `#{{method}}: fn`, `self.#{{field}}`, `.#{{left}}` splice a derive or marker template binding" },
    { spelling: "x.reflect().fact", meaning: "compiler fact read: `T.reflect().layout`, `f.reflect().effects`, `value.reflect().origin`" },
    { spelling: FACT_ROOT_BUILD, meaning: "compiler build-fact value: `#build.target.os`, `.profile`, `.settings.*`, `.stamp.*`, `.cpu.cache_line` (an `Int`, also accepted in `#Layout(c, align(…))`), and the targeted machine's `#build.target.triple`, `.target.layout.pointer_bits`, `.target.layout.word_bits`, `.target.layout.cache_line` and `.target.cpu_features`" },
    { spelling: FACT_ROOT_PACKAGE, meaning: "package site value: `#package.name`, `.version`" },
    { spelling: FACT_ROOT_PHASE, meaning: "compiler `Phase` value, filled in for each compiled copy" },
    { spelling: FACT_ROOT_PROGRAM, meaning: "compiler authorized checked-program fact value" },
    { spelling: FACT_ROOT_HERE, meaning: "site value: the `SourceLocation` (file, line, column, function, module) where it is written, as in `#here.line` and `#here.file`" },
    { spelling: FACT_ROOT_CALLER, meaning: "the `SourceLocation` of the call, legal only as a parameter default `at: SourceLocation{{#caller}}` or inside an #Expand macro" },
    { spelling: CODE_VALUE, meaning: "`Code` value: `#code {{ items }}` holds the items written in its block, which `meta.add(code, scope: \"name\")` on the root's `Compiler` value adds to its target as the generated module `name`; a `#{{name}}` in the items naming a String build local pastes the name or type it spells; a block of statements alone is a body for `meta.rewrite_body(f, code)`, where a line `#{{f.body}}` pastes the original body" },
    { spelling: "b.compiler(output)", meaning: "the root build's `Compiler` value for one of its outputs, which metaprogram actions take; only the root package's own build source can call it, by the loader's package identity, so a dependency or a forwarded `Build` can't make or widen one (E0776)" },
    { spelling: "Compiler", meaning: "compiler-held build value `b.compiler(output)` returns: it names one output of the running root build and is valid only while that build runs; a function the root hands it to acts for the root, and the build's provenance records the handoff" },
    { spelling: "meta.add(code, scope: name)", meaning: "adding code on a `Compiler` value: the items of a `#code {{ … }}` value, or of a String of source text, become the generated module `name` of the value's output, checked with the program like hand-written code; it performs `Meta.Generate`, and source text, which may declare a type made from any value, also performs `Meta.Types` and `Meta.Raw`" },
    { spelling: "meta.add_struct(name, fields, scope: module)", meaning: "a typed type factory on a `Compiler` value: declares the struct `name` of `fields`, a list of `CompilerField{{name:, type:}}` records whose names may be computed and whose types are `TypeId` values (a reflected field's `f.type`), as the generated module `module`, checked with the program, and returns the new struct's `TypeId`; each field type is written as the generated module names it, and the build host refuses a type that module can't see (E3502) and a name that is not one identifier in its kind's casing (E0357), and only the compiler makes a `TypeId`, so no code a build computes is written: it performs `Meta.Generate` and `Meta.Types` but not `Meta.Raw`" },
    { spelling: "meta.find_type(text)", meaning: "a type lookup on a `Compiler` value: the `TypeId` of the one type `text` spells, each type it names read as the program's root module reads it, or as a struct this build already made with `meta.add_struct`; None when `text` is not one type or names a type neither knows. It changes no code, so it uses no `Meta` effect" },
    { spelling: "TypeId{{T}}", meaning: "a type as a value where a `TypeId` is expected: a type the module sees, written bare (`I64`, `geo.Point`, `[Point]`, `Box<Int>`) or as `TypeId{{Point}}`, is that type's `TypeId`, the one reflection gives it, checked where it is written; a `String` there is a mismatch (E0108)" },
    { spelling: "meta.rewrite_body(f, code)", meaning: "rewriting on a `Compiler` value: the statements of a `#code {{ … }}` value replace the body of the top-level function `f`, named directly, through its package, or by a heard `FunctionInfo`; a line `#{{f.body}}` pastes the body before the rewrite, so rewrites of one function compose in the order they run, and the rewritten function is checked with the program; it performs `Meta.Rewrite`, and a dependency's function needs the root's `meta.allow_rewrite`" },
    { spelling: "meta.allow_rewrite(package: name)", meaning: "the root's consent, on its `Compiler` value, for `meta.rewrite_body` to rewrite functions of its locked dependency `name`; without it such a rewrite fails the build (E3514)" },
    { spelling: "meta.events(watch: .Functions{{marked: m}}, handler)", meaning: "watching on a `Compiler` value: the handler hears `.Checked(.Function(f))` (a `CompilerEvent`) once for each function of the build's checked program that carries the marker of the type of the marker struct value `m` (`Traced{{}}`; its field values filter nothing), in the order the program lists them; it only reads, needs no Meta effect, and a value whose build has returned is refused" },
    { spelling: META_QUERY_SOURCE, meaning: "lexical source-snapshot metadata query (no ratified `$` root yet)" },
    { spelling: META_QUERY_TYPES, meaning: "retained runtime type-catalog query (no ratified `$` root yet)" },
    { spelling: COMPILER_GENERATE, meaning: "explicit shared-preparation publication of Generated items" },
    { spelling: "fn(…) {{ … }}", meaning: "lambda: a function binding's value without its name; a passed lambda leaves out the parameter types, effect row and result its expected callable type fixes (`xs.filter(fn(n) {{ n > 2 }})`), a stored one writes them as a named function does (`square: fn(n: Int) -> Int {{ n * n }}`); the body is always braced and its last value is the result" },
    { spelling: "-[…]", meaning: "effect row on a callable" },
    { spelling: "!", meaning: "error-contract mark after its error type (`E!`, `(A | B)!`); deny-only root in an effect row" },
    { spelling: "?", meaning: "optional type mark after its type (`T?`)" },
    { spelling: "??", meaning: "fallback" },
    { spelling: "|>", meaning: "pipe step: the expression after it runs on the value from the line above, which it reads as `<>`; each step is a hidden one-step binding" },
    { spelling: "<>", meaning: "the value of the nearest enclosing `|>` step; legal only inside a step, which must read it at least once" },
    { spelling: "x.move()", meaning: "an early take: a compiler-owned method that moves a named place out before its last use; a call that takes is written plain because its signature declares `&&T` or `&&self`" },
    { spelling: "&&T / &&self", meaning: "take mark in a signature, and `task &&name` for a task capture; `&T` / `&self` is the write mark; calls stay unmarked" },
    { spelling: "fn(&T) / fn(&&T)", meaning: "a function type marks a written input `&` and a taken one `&&`, as a declaration does (`action: fn(&Mobj)`); a function or lambda fits it only when its marks match (E0227), and a stored one is called plainly (`st.action(m)`)" },
    { spelling: "&self.field / &self.[a, b]", meaning: "stated receiver field footprint: the record fields a method may read or change, checked against its body (E0231) and published in the API snapshot; reuses member spread `.[`" },
    { spelling: "T{{expr}}", meaning: "field default" },
    { spelling: "Name{{\"…\"}}", meaning: "checked text head" },
    { spelling: "{{ … }}", meaning: "typed anonymous value" },
    { spelling: "`", meaning: "raw ordinary String fence" },
    { spelling: "\"\"\"", meaning: "multi-line string; only spaces or tabs on the delimiter lines (raw foreign bodies excepted)" },
    { spelling: ",", meaning: "separator with optional trailing item in every comma list" },
    { spelling: "Type{{field: pattern, ..}}", meaning: "named struct pattern; fields bind or test nested shapes" },
    { spelling: "[first, ..rest]", meaning: "list pattern with a read-only zero-copy rest window; exact without the rest marker" },
    { spelling: "[key: pattern, key?: optional, ..]", meaning: "map pattern; required and optional keys, exact unless it ends with rest" },
    { spelling: "if T == {{ Int -> … else -> … }}", meaning: "type table: a generic function branches on its type parameter; each arm reads `T` as its type, `else` is required, each instance keeps one arm; `if T == Int {{ … }}` is the one-arm test; `.Int -> …` names a union member without binding it" },
    { spelling: "T: trait {{ name: Type }} / name: Type{{default}} / impl X.T {{ name: value }} / T.name", meaning: "trait constant: a compile-time literal, enum case or list each implementation supplies (or takes the default), read from the type" },
    { spelling: "r\"…\", raw\"…\", $\"…\"", meaning: "unclaimed raw-string prefixes" },
    { spelling: ";", meaning: "retired explicit statement terminator" },
    { spelling: "_name", meaning: "ordinary identifier" },
    { spelling: "__core_intrinsic", meaning: "compiler-only namespace" },
    { spelling: "<:", meaning: "open a lock-step statement-expansion fence" },
    { spelling: ":>", meaning: "close a lock-step statement-expansion fence" },
    { spelling: "@[ … ]@", meaning: "retired fence spelling; the fence is `<: … :>`" },
}

/// Checked compiler metadata queries that has not yet given a `$` root.
/// `#build`, `#phase`, `#program`, `#package`, `#here` and `#caller` are the fact roots; type, function,
/// method, closure and value facts are `$` members of their subject
/// (`T.reflect().fields`).
META_QUERY_SOURCE: "@SOURCE"

META_QUERY_TYPES: "@TYPES"

/// Publication remains explicit and uses the existing Generated value.
COMPILER_GENERATE: "compiler.generate"

/// The old standalone marker; it is not part of the active marker registry
/// and no rule accepts it.
MARKER_ALIGN_LEGACY: "Align"

// The native library edge uses matching `#Import(c)` and
// `#Export(c)` spellings. The C ABI and the sema-owned guest surface are one
// contract in both directions.
MARKER_IMPORT: "Import"

MARKER_EXPORT: "Export"

// Concurrency surface — thirteen ratified -* outcomes on card #1505.
// Rows for forms that implementation cards will make parseable belong here
// now; parser and sema support land on those cards.
// This rule change compiler facts only.
// keeps #Transact keeps Job/Every/Duration, and
// This rule keeps yield/Stream. Is retired by
// TaskOutcome, TaskStatus, trace, and exception have no rows.
/// The one reserved word for structured task spawning.
KW_CONC_TASK: "task"

/// (ratified 2026-08-12, card #1889): prefix verb that
/// creates a deeply immutable owned snapshot for a task crossing.
KW_FREEZE: "freeze"

// This rule adds no second token for consuming captures: `task &&name`
// reuses SIGIL_MOVE (`&&`) as task-capture syntax on a group child.
// The child owns the value; later use of the name is ordinary E0121.
/// `task.all` is the one fan-out
/// selector that accepts either positional branches or uniformly named
/// branches; named branches return the existing anonymous tuple carrier.
TASK_ALL: "task.all"

/// Qualified fan-out selector.
TASK_RACE: "task.race"

/// Qualified fan-out selector.
TASK_ANY: "task.any"

/// Qualified fan-out selector.
TASK_GROUP: "task.group"

/// The nameable child-handle type.
TYPE_TASK: "Task"

/// Builtin channel constructor.
BUILTIN_CHANNEL: "channel"

/// Receiver endpoint type is nameable in signatures.
TYPE_RECEIVER: "Receiver"

/// Sender endpoint type is nameable in signatures.
TYPE_SENDER: "Sender"

/// Loop source form for channel draining.
LOOP_CHANNEL_DRAIN: "loop value in receiver"

/// Contextual timeout arm in a readiness table.
READINESS_AFTER: "after"

/// Compiler-private field used while a readiness arm is carried through the
/// existing one-field tuple AST node. It cannot be written by source code.
INTERNAL_SELECT_AFTER_FIELD: String.from_bytes([U8]{0, 106, 101, 116, 46, 115, 101, 108, 101, 99, 116, 46, 97, 102, 116, 101, 114})

/// Consuming task result operation.
TASK_JOIN: "join"

/// One error type for joined task failures.
TYPE_TASK_FAILURE: "TaskFailure"

/// Cancellation failure variant.
TASK_FAILURE_CANCELLED: "Cancelled"

/// Deadline failure variant.
TASK_FAILURE_DEADLINE_BLOWN: "DeadlineBlown"

/// Panic failure variant.
TASK_FAILURE_PANICKED: "Panicked"

HTTP_ROUTE_PARAM_PREFIX: ":"

HTTP_ROUTE_CATCH_ALL_PREFIX: "*"

// (ratified 2026-07-20): every explicit parallel collection
// adapter uses the owner-selected `para_` prefix. These are a clean break from
// 's provisional `par_` spellings; there are no aliases.
METHOD_PARA_MAP: "para_map"

METHOD_PARA_FILTER: "para_filter"

METHOD_PARA_PARTITION: "para_partition"

METHOD_PARA_FOLD: "para_fold"

PARA_METHODS: [String]{
    METHOD_PARA_MAP,
    METHOD_PARA_FILTER,
    METHOD_PARA_PARTITION,
    METHOD_PARA_FOLD,
}

// (card #2278, 2026-08-28): Go 1.27 parity names are
// registered at the syntax authority before sema or an engine accepts them.
// `cut_last` is the terminal-boundary root; the Euclidean quotient and
// remainder are separate operations, so neither grows a variant sibling.
METHOD_CUT_LAST: "cut_last"

METHOD_DIV_EUCLID: "div_euclid"

METHOD_REM_EUCLID: "rem_euclid"

/// Compiler-owned numeric source names for.
NUMERIC_CONVERSION_SOURCES: [(field_0: String, field_1: String)]{
    (field_0: "from_i8", field_1: "I8"),
    (field_0: "from_i64", field_1: "I64"),
    (field_0: "from_i16", field_1: "I16"),
    (field_0: "from_i32", field_1: "I32"),
    (field_0: "from_int", field_1: "Int"),
    (field_0: "from_u8", field_1: "U8"),
    (field_0: "from_u16", field_1: "U16"),
    (field_0: "from_u32", field_1: "U32"),
    (field_0: "from_u64", field_1: "U64"),
    (field_0: "from_f32", field_1: "F32"),
    (field_0: "from_float", field_1: "Float"),
    // The exact-number family uses the same
    // destination-owned source suffix convention as fixed numerics.
    (field_0: "from_decimal", field_1: "Decimal"),
    (field_0: "from_fraction", field_1: "Fraction"),
}

/// (card #2310/#2312, 2026-08-28): the
/// completeness-pack names are registered here before they enter sema or an
/// engine. Their implementations remain in the shared Prelude seams.
W4310_SURFACE_NAMES: [String]{
    "read_i8",
    "read_i16_le",
    "read_i16_be",
    "read_i32_le",
    "read_i32_be",
    "read_i64_le",
    "read_i64_be",
    "read_f32_be",
    "read_f64_be",
    "peek",
    "seek",
    "skip",
    "write_i8",
    "write_i16_le",
    "write_i16_be",
    "write_i32_le",
    "write_i32_be",
    "write_i64_le",
    "write_i64_be",
    "write_f32_le",
    "write_f32_be",
    "write_f64_le",
    "write_f64_be",
    "hmac_sha256",
    "to_radix",
    "from_radix",
    "round",
    "floor",
    "ceil",
    "from_decimal",
    "from_fraction",
}

/// The sole source-written quantity-bound constructor.
BOUND_QUANTITY: "Quantity"

/// The closed explicit unit-rounding policies.
ROUND_TOWARD_ZERO: "TowardZero"

ROUND_FLOOR: "Floor"

ROUND_CEILING: "Ceiling"

ROUND_NEAREST_EVEN: "NearestEven"

use {
    jet_foundation.[SemaNameCase]
}

/// One compiler-owned category table. Parser/sema callers select the grammar
/// category; spelling policy never gets reimplemented at individual sites.
NAME_CASE_CATEGORIES: [(field_0: String, field_1: SemaNameCase)]{
    (field_0: "associated type", field_1: SemaNameCase.Pascal),
    (field_0: "distinct type", field_1: SemaNameCase.Pascal),
    (field_0: "enum", field_1: SemaNameCase.Pascal),
    (field_0: "enum variant", field_1: SemaNameCase.Pascal),
    (field_0: "variant group", field_1: SemaNameCase.Pascal),
    (field_0: "marker", field_1: SemaNameCase.Pascal),
    (field_0: "protocol", field_1: SemaNameCase.Pascal),
    (field_0: "protocol message", field_1: SemaNameCase.Pascal),
    (field_0: "state", field_1: SemaNameCase.Pascal),
    (field_0: "state type", field_1: SemaNameCase.Pascal),
    (field_0: "struct", field_1: SemaNameCase.Pascal),
    (field_0: "tag", field_1: SemaNameCase.Pascal),
    (field_0: "trait", field_1: SemaNameCase.Pascal),
    (field_0: "type", field_1: SemaNameCase.Pascal),
    (field_0: "type alias", field_1: SemaNameCase.Pascal),
    (field_0: "type parameter", field_1: SemaNameCase.Pascal),
    (field_0: "unit family", field_1: SemaNameCase.Pascal),
    (field_0: "config name", field_1: SemaNameCase.Snake),
    (field_0: "constant", field_1: SemaNameCase.Screaming),
    (field_0: "context key", field_1: SemaNameCase.Snake),
    (field_0: "field", field_1: SemaNameCase.Snake),
    (field_0: "function", field_1: SemaNameCase.Snake),
    (field_0: "generic module", field_1: SemaNameCase.Snake),
    (field_0: "lambda parameter", field_1: SemaNameCase.Snake),
    (field_0: "local", field_1: SemaNameCase.Snake),
    (field_0: "local constant", field_1: SemaNameCase.Snake),
    (field_0: "loop label", field_1: SemaNameCase.Snake),
    (field_0: "message field", field_1: SemaNameCase.Snake),
    (field_0: "method", field_1: SemaNameCase.Snake),
    (field_0: "module", field_1: SemaNameCase.Snake),
    (field_0: "module variable", field_1: SemaNameCase.Snake),
    (field_0: "module alias", field_1: SemaNameCase.Snake),
    (field_0: "parameter", field_1: SemaNameCase.Snake),
    (field_0: "pattern binding", field_1: SemaNameCase.Snake),
    (field_0: "trait constant", field_1: SemaNameCase.Snake),
    (field_0: "unit member", field_1: SemaNameCase.Snake),
    (field_0: "value parameter", field_1: SemaNameCase.Snake),
    (field_0: "variant field", field_1: SemaNameCase.Snake),
}

COMPUTED_FIELD_GETTER_STEM: "__computed_"
