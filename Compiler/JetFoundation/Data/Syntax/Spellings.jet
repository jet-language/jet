NUMERIC_CONVERSION_SOURCES :: [(field_0: String, field_1: String)]{
    (field_0: "from_i8", field_1: "I8"),
    (field_0: "from_i64", field_1: "I64"),
    (field_0: "from_i16", field_1: "I16"),
    (field_0: "from_i32", field_1: "I32"),
    (field_0: "from_int", field_1: "Int"),
    (field_0: "from_u8", field_1: "U8"),
    (field_0: "from_u16", field_1: "U16"),
    (field_0: "from_u32", field_1: "U32"),
    (field_0: "from_u64", field_1: "U64"),
    (field_0: "from_f32", field_1: "F32"),
    (field_0: "from_float", field_1: "Float"),
