// Canonical owner-controlled syntax registry (I7).
// Mechanically ported by Tools/agent/port-syntax-registry.mjs; edit this Jet home.
// The reference comparison is temporary and is not a generator dependency.

/// S52 (ratified M12; amended 2026-06-16, U2): the unified single lockfile lives
/// inside the `.jet/` managed folder (SOURCE_ROOT_DIR). Replaces `jet.lock`
/// (and `pack.lock`); the manifest reshape chunk migrates the old paths.
UNIFIED_LOCK_FILE :: ".jet/lock"

/// Legacy migration source only. Moved the default Hangar to
/// the native per-user data path; this retired root-owned path is never used
/// for new resolution.
HANGAR_DIR :: "/etc/jet/hangar"

/// (ratified 2026-08-07): the old TOML config filename is
/// retained only as a migration sentinel. It is never parsed; the CLI emits
/// E1225 and points users to the Jet-grammar files that replace its jobs.
JETPACK_TOML :: "jetpack.toml"

/// Amended by (ratified 2026-08-10): `run.jet`
/// remains the ordinary zero-ceremony fallback source for `jet run`, but it
/// is not a reserved command-role filename. The optional command home is
/// `@run.jet`.
DEFAULT_ENTRY_FILE :: "run.jet"

/// One optional leading contextual Package carrier
/// may live in the entry source as `package { … }`. The word remains
/// contextual so `pub(package)` keeps its existing visibility meaning.
INLINE_PACKAGE_DECL :: "package"

/// Pre-ruling project entry name, retained only as a one-time migration sentinel.
LEGACY_ENTRY_FILE :: "main.jet"

/// (ratified 2026-08-10, card #1866): optional package-root
/// command homes. The marked namespace is closed to these four command names;
/// there is no command directory and no package/module role-file spelling.
COMMAND_FILE_RUN :: "@run.jet"

COMMAND_FILE_BUILD :: "@build.jet"

COMMAND_FILE_DEV :: "@dev.jet"

COMMAND_FILE_TEST :: "@test.jet"

COMMAND_ROLE_FILES :: [String]{
    COMMAND_FILE_RUN,
    COMMAND_FILE_BUILD,
    COMMAND_FILE_DEV,
    COMMAND_FILE_TEST,
}

/// (ratified 2026-08-20): named struct construction `Type{ field: val }`.
/// Inferred form (type from context): `{ field: val }` — no type name.
/// The retired dotted forms (`.{…}`, `Type.{…}`) are compile errors (E0320).
/// `jet fmt` still rewrites them. (ratified 2026-06-30): the same
/// sigil also constructs a named-payload enum variant — `.Variant{ field: val }`
/// / `Type.Variant{ field: val }` (S30 multi-field variants). No new token;
/// `enum_lit_named_fields` in `Parser/Expressions.rs` parses `{` immediately
/// after a leading-dot variant name.
/// This rule amends the same `Type{ body }` head is universal —
/// scalars (`U8{ 250 }`), lists (`[U8]{ 1, 2 }`), fixed arrays (`[U8#3]{ … }`),
/// maps (`[String:Int]{}`), and one-expression assertions (`Int{ fetch_rows() }`).
/// Body elaborates against the head; it never converts. Amends
/// `[T]{}` is the explicit empty; bare `[]` stays contextual. No new token.
OP_NAMED_CTOR :: "{{"

/// (ratified 2026-06-27): spread/rest sigil — `name: ...T` variadic
/// parameters (last position only), `f(...xs)` call spread, `[...a, x, ...b]` list spread.
SIGIL_SPREAD :: "..."

/// S76 (ratified 2026-06-16): the fixed-size separator in `[T#N]` type
/// position, e.g. `[Int#3]`. Amended by VERSION-# (2026-06-16): `#` also
/// introduces pinned version numbers in package references (`pkg#1.2.0`).
/// Same token, two contexts: `[T#N]` is the type-level size form; `name#ver`
/// is the package version-pin form. No dedicated two-character token in either
/// case — the parser resolves by position.
///
/// `#` has a third job outside a type: the applied-rule prefix at a
/// declaration/statement/expression target (
/// `RULE_PREFIX`/`MARKER_PREFIX`). Keeps all three jobs on
/// one token, disambiguated only by parser position.
TYPE_FIXED_SIZE_SEP :: "#"

/// (ratified 2026-06-19): `UserId :: distinct Int` — declares a
/// distinct type (a separate nominal type sharing the base's representation).
/// Used in the value position of a `::` immutable binding at item level;
/// `distinct`-over-`distinct` chaining is rejected in v1.
KW_DISTINCT :: "distinct"

/// (ratified 2026-06-20): unwrap method for a distinct type —
/// `value.raw()` yields the base value. Named-cast family (S42).
METHOD_DISTINCT_RAW :: "raw"

/// (ratified 2026-08-06): the one outcome carrier under `?T`
/// and `T !E`. Optional and fallible spellings are distinct; these are the
/// three reads that reach the carrier's facts.
///
/// `.or_err("why")` lifts a clean absence into a failure — the payload rides
/// through untouched and only the report changes. `.partial()` reads the
/// payload a failure kept and `.notes()` reads what it had to say. Both live on
/// the outcome value: an error type opts in by carrying them on its report
/// under the field names below. Writing a note as a `?` hop travels with the
/// journey and belongs to not here.
METHOD_OUTCOME_OR_ERR :: "or_err"

METHOD_OUTCOME_PARTIAL :: "partial"

METHOD_OUTCOME_NOTES :: "notes"

/// The fields an error type carries the carrier's middle states on.
FIELD_OUTCOME_PARTIAL :: "partial"

FIELD_OUTCOME_NOTES :: "notes"

/// (supersedes): retired `.view(a..b)` method
/// name, retained only so parser recovery can emit E0214 and point at the bare
/// range-place spelling. #567 removes the remaining collection plumbing.
METHOD_VIEW :: "view"

/// (ratified 2026-08-05): the callable projection for a
/// returned, stored, or otherwise function-valued expression. Sema recognizes
/// `.call(…)` on function values; a member named `call` on a struct shadows it.
METHOD_CALL :: "call"

/// (ratified 2026-07-01, c7shift): `cursor.take_pattern("…")` reuses
/// the interpolation-literal-as-pattern grammar (`{hole}` /
/// `{hole:Type}`), but a typed hole isn't a legal ordinary interpolation
/// value expression, so the string-literal argument in THIS ONE call
/// position is parsed as a pattern (`try_str_match_pattern`'s engine, reused
/// not duplicated — I8) instead of an ordinary `Expr::Str`. Parsed specially
/// the same way `.view(a..b)` (above) is: one method name, one fixed
/// argument shape, no second call-argument grammar.
METHOD_TAKE_PATTERN :: "take_pattern"

/// (ratified 2026-08-27, card #2265): byte text reuses the
/// existing typed collection head `[U8]{ "..." }`. ASCII text contributes one
/// byte per character; `\xNN` contributes the written byte. No `b` prefix is
/// added.
/// Binary patterns use typed head `[U8]{"…"}`
/// (byte-mode sibling of string patterns). Each `{name:U4}` hole
/// reads a fixed-width bit field; an endian suffix (`be`/`le`) picks byte
/// order on a multi-byte read; a final `{name:...}` captures remaining bytes.
/// Byte values use the typed list head above; this pattern form remains
/// distinct because its body contains holes.
/// Multi-byte big-endian read suffix — `{len:U16be}`.
BINPAT_ENDIAN_BIG :: "be"

/// Multi-byte little-endian read suffix — `{len:U16le}`.
BINPAT_ENDIAN_LITTLE :: "le"

/// (formerly):
/// `#Numeric` marker enables same-type arithmetic on a distinct type.
/// Written `#Numeric` on the same line before the distinct-type name (the
/// sole `#` rule prefix). This is the single merged
/// spelling for what used to be two markers doing the same job — the
/// `#Numeric` distinct-type marker and the formerly-`@numeric`
/// capability bundle — folded per (I8: one
/// way to mean it). `MARKER_BUNDLE_NUMERIC` no longer exists as a separate
/// constant; use this one.
MARKER_NUMERIC :: "Numeric"

/// (ratified 2026-06-24): `#UnitFamily(Currency) { usd, eur, gbp }` —
/// declares a family of units. Each member mints one distinct `#Numeric` type
/// (`usd` → `Usd`) that erases to `Float`, so signatures read plain English
/// (`fn subtotal(price: Usd, qty: Int) Usd`). The family is the
/// "upgrade to " framing of sugar over the distinct-type
/// machinery. PascalCase tag per.
MARKER_UNIT_FAMILY :: "UnitFamily"

/// (card #603): contextual fields in `#UnitFamily`.
UNIT_FAMILY_BASE_FIELD :: "base"

UNIT_FAMILY_DIMENSION_FIELD :: "dimension"

UNIT_FAMILY_SCALE_FIELD :: "scale"

UNIT_FAMILY_OFFSET_FIELD :: "offset"

/// (ratified 2026-06-22): `#PublishedSchema` — marks a struct whose
/// a declared migration is E0910. Written `#PublishedSchema` before `struct`.
MARKER_PUBLISHED_SCHEMA :: "PublishedSchema"

/// Compiler-owned storage for the original ordered wire
/// object. This is an emitted field, not a user-facing source spelling.
PUBLISHED_UNKNOWN_FIELDS :: "__jet_unknown_fields"

/// (ratified 2026-06-21, option A; gated on): `#SingleUse` — marks
/// a type whose values must be consumed exactly once on every reachable path
/// (moved to a `^` parameter or returned). Using one zero times is E0140
/// (unconsumed at scope end) / E0141 (unconsumed on one branch); aliasing one
/// with `&`/`view` is E0142. `#SingleUse` values are move-only. The tag is
/// compile-time only and erases in codegen (I3). Written `#SingleUse` before the
/// `struct`/`enum`, same marker idiom as `#PublishedSchema`.
MARKER_SINGLE_USE :: "SingleUse"

/// `#Replayable fn` marks a function whose reachable effects must be
/// deterministic by default. Ambient `Time`/`Rand`/`Net`/`IO` are rejected unless
/// the work is routed through explicit deterministic/mockable capabilities.
MARKER_REPLAYABLE :: "Replayable"

/// (c18iwxqx): `#MustUse` — marks a type, function, or method whose
/// result cannot be silently ignored as a bare expression statement (E0419).
/// Explicit discard uses `.drop("reason")` only (amended by
/// ). Compile-time only; erases in codegen (I3).
MARKER_MUST_USE :: "MustUse"

/// (ratified 2026-06-22): contextual keyword `migration` — introduces
/// a migration block that declares how a `#PublishedSchema` struct changed between
/// releases. Used as `migration TypeName { rename old -> new }`.
/// (ratified 2026-07-12, card #506): contextual keyword `validate`
/// — introduces the in-body `validate { … }` block inside a struct definition
/// (S82 in-body grammar). Rules are `check(cond, at: field, "msg")`
/// statements; sema resolves `field` as a bare sibling reference
/// and purity-checks `cond`/`msg` (reuses the `#Pre`/`#Post`
/// checker). Failing `check`s accumulate into `[FieldError]`; `decode<T>()`
/// runs the block automatically on a successfully shape-decoded value, and
/// `Type.validate(value)` runs it standalone. `Validate.over(s)` is the
/// use-site escape for rules needing outside context.
KW_VALIDATE_BLOCK :: "validate"

/// The outside-context validation builder keeps the one
/// `check(…, at: field, …)` rule vocabulary while remaining compiler-owned.
TYPE_VALIDATE :: "Validate"

TYPE_VALIDATE_BUILDER :: "__JetValidate"

INTERNAL_VALIDATE_OVER :: String.from_bytes([U8]{0, 106, 101, 116, 46, 118, 97, 108, 105, 100, 97, 116, 101, 46, 111, 118, 101, 114})

/// Compiler-owned ambient receipt handle and its one public
/// attachment method. The handle has no source constructor or module export.
INTERNAL_RECEIPT_HANDLE :: String.from_bytes([U8]{0, 106, 101, 116, 46, 114, 101, 99, 101, 105, 112, 116, 46, 104, 97, 110, 100, 108, 101})

METHOD_RECEIPT_ATTACH :: "attach"

/// The checked-SQL list door `[T].query(SQL)`
/// is a receiver row keyed by this compiler-owned handle. The public spelling
/// stays `query`; `jet_data_query_sql` is never exported or documented.
INTERNAL_LIST_QUERY_HANDLE :: String.from_bytes([U8]{0, 106, 101, 116, 46, 113, 117, 101, 114, 121, 46, 108, 105, 115, 116})

/// The builtin call name inside a `validate { … }` block —
/// `check(cond, at: field, "msg")` records one `FieldError { path, reason }`
/// when `cond` is false. Contextual: recognized as this builtin only inside
/// a `validate { … }` block; an ordinary function named `check` elsewhere is
/// unaffected.
VALIDATE_CHECK_FN :: "check"

KW_MIGRATION :: "migration"

/// (ratified 2026-06-22): contextual keyword `rename` inside a
/// `migration { }` block — declares that field `old` was renamed to `new`.
KW_RENAME :: "rename"

/// (ratified): `add f: T = default` inside a `migration { }` block —
/// declares a new field plus the default old records are read with.
KW_ADD :: "add"

/// (ratified): `remove f` inside a `migration { }` block — deletes a
/// field. The verb is `remove`, NOT `drop` (a `drop` op is taught back to this).
KW_REMOVE :: "remove"

/// Amended by
/// `change f: Old -> New [via { … }]` inside a
/// `migration { }` block — a field type change with an optional inline converter.
KW_CHANGE :: "change"

/// (ratified): the `via { expr }` clause that supplies the inline
/// converter for a `change` op
/// (`change price: Int -> Usd via { c -> Usd.from_int(c) }`).
///
/// (ratified 2026-06-22): also the pass-through marker in a `#(via f)`
/// signature annotation — a function whose published effect set IS whatever the
/// callback parameter `f` carries (a tight pass-through that holds when the value
/// escapes, vs. the conservative flow-through default). Erased in codegen (I3).
KW_VIA :: "via"

/// (ratified): the rejected `reorder` verb — field reordering is not
/// a tracked breaking change and needs no migration. Kept only to teach.
KW_REORDER_RETIRED :: "reorder"

/// The `drop` verb a user might reach for instead of `remove` — kept
/// only to emit the E0911 teaching error pointing at `remove`.
KW_DROP_RETIRED :: "drop"

/// (ratified): `jet inspect schema` subcommand and its verbs. `status`
/// reports each `#PublishedSchema` type's pinned shape; `squash --before <ver>`
/// re-baselines snapshots to the current shape. There is NO `check` verb —
/// `jet build`'s E0910 is already the CI gate.
CMD_SCHEMA :: "schema"

SCHEMA_VERB_STATUS :: "status"

SCHEMA_VERB_SQUASH :: "squash"

/// (ratified 2026-08-07, card #1641): measurement mode on
/// the one test verb.
TEST_FLAG_MEASURE :: "--measure"

/// (ratified 2026-08-07, card #1641): one watch modifier on
/// every runnable verb named by the ballot.
RUN_FLAG_WATCH :: "--watch"

/// (ratified 2026-09-05): refuse implicit Jetpack project
/// preparation only when the caller explicitly opts out.
RUN_FLAG_NO_PREPARE :: "--no-prepare"

/// (ratified 2026-08-07, card #1641): named replay recording
/// producer on `run`, `dev`, and `test`.
RUN_FLAG_RECORD :: "--record="

/// (ratified 2026-08-07, card #1641): named replay consumer
/// on `jet debug`.
DEBUG_FLAG_REPLAY :: "--replay="

/// (ratified 2026-08-07, card #1641): exact resident-session
/// key bytes. The owner casing note applies to action labels, not these keys.
SESSION_KEY_RERUN :: "r"

SESSION_KEY_RESTART :: "R"

SESSION_KEY_TESTS :: "t"

SESSION_KEY_FAILED_CLAIMS :: "f"

SESSION_KEY_QUIT :: "q"

/// (ratified 2026-06-19 = A): `jet debug <file>` — the dedicated
/// source-level debugger entry verb, parallel to `jet run`/`jet test`. The
/// editor launches the same command.
CMD_DEBUG :: "debug"

/// (ratified 2026-06-24 = A): the in-session `jet debug` command
/// surface. The prompt is `(jet)`; the step verbs are lldb-familiar with
/// single-letter aliases. Only Jet frames/lines/safe-locals are shown by
/// default (I2 `--raw-frames` is the expert carve-out).
DBG_PROMPT :: "(jet)"

DBG_STEP :: "step" // (alias `s`)

DBG_NEXT :: "next" // (alias `n`)

DBG_CONTINUE :: "continue" // (alias `c`)

DBG_FINISH :: "finish" // (alias `f`)

DBG_BREAK :: "break" // (alias `b`): set a line breakpoint

DBG_LIST :: "list" // (alias `l`): show source around `here`

DBG_PRINT :: "print" // (alias `p`): show one local's value

DBG_LOCALS :: "locals" // Dump all locals in the frame

DBG_BACKTRACE :: "backtrace" // (alias `bt`): the Jet call stack

DBG_WHY :: "why" // Query recorded acts that produced a value

DBG_WHEN :: "when" // Query recorded changes for a place

DBG_HELP :: "help" // (alias `h`): list the verbs

DBG_QUIT :: "quit" // (alias `q`): end the session (E2204)

DBG_BACK :: "back" // Reverse one statement

DBG_REVERSE_CONTINUE :: "reverse-continue"

DBG_WATCH :: "watch"

DBG_UNWATCH :: "unwatch"

DBG_FIX :: "fix" // Checked source repair

/// (ratified 2026-06-22): subdirectory under the project `.jet/`
/// managed folder where schema snapshots are stored. Full path is
/// `<project_root>/.jet/cache/schema/<TypeName>.snapshot`.
SCHEMA_CACHE_SUBDIR :: "cache/schema"

/// S2 (was c129): subdirectory under the project
/// `.jet/` managed folder where public-fn signature snapshots are stored.
/// Full path is `<project_root>/.jet/cache/api/<package>.api`. Written at
/// `jet registry publish` time, unconditionally, for every library target; read by the
/// local pre-publish SemVer gate (E1218). Committed — it is a durable
/// interface contract, not a build artifact.
API_CACHE_SUBDIR :: "cache/api"

/// (ratified = A): consumes a Task handle without joining
/// — fire-and-forget daemon semantics. Main may return while the task runs.
/// Only valid on owned tasks; capturing a `view` borrow is rejected at spawn
/// time (E1102) and flagged again at the detach site (E1103).
TASK_DETACH :: "detach"

/// (ratified = B)
/// `#Layout(…)` struct attribute controls the memory layout of the generated
/// Rust struct. `#Layout(c)` stamps `#[repr(C)]` for C interop;
/// `#Layout(c, align(N))` requests a portable profile-supported power-of-two
/// byte alignment, while `#Layout(c, align(target, N))` opts into the selected
/// target profile for larger proven boundaries. Field order is preserved as
/// written. Growable fields (`[T]`, `Map`, `String`) are rejected (E1104);
/// unsupported or unproven alignment values are rejected by sema (E1119).
/// PascalCase per.
MARKER_LAYOUT :: "Layout"

/// The C-compatible layout variant — `#Layout(c)` → `#[repr(C)]`.
LAYOUT_C :: "c"

/// `packed` and first-argument `align` remain reserved.
LAYOUT_PACKED :: "packed" // (reserved)

/// Explicit alignment is the second argument of `#Layout(c)`.
LAYOUT_ALIGN :: "align"

/// (implemented): the struct-of-arrays layout variant —
/// `#Layout(columnar) struct S` stores a `[S]` collection column-per-field.
/// Whole-struct only in v1 the partial form `#Layout(columnar: …)`
/// is rejected (E1109) and the per-container prefix `columnar [T]` is reserved
/// E1107.
LAYOUT_COLUMNAR :: "columnar"

// ── Serde derive markers + attributes (–8 bracket form) ──
// Derive markers (PascalCase per written `#[…]` before a struct/enum,
// Formerly): `#[Codable]` derives BOTH
// directions (sugar for `#[Encode, Decode]`); `#[Encode]` is write-only;
// `#[Decode]` is read-only. Owner (= B, modified): the
// collapsed umbrella is `Codable`, with `Encode`/`Decode` as the one-way markers.
MARKER_CODABLE :: "Codable"

MARKER_RECEIPT :: "Receipt"

MARKER_ENCODE :: "Encode"

MARKER_DECODE :: "Decode"

                                          // (formerly B, ratified 2026-07-02): the
                                          // other built-in derive markers that join Codable/Encode/Decode — all on
                                          // `#`, the sole rule prefix.
                                          // All six structural
                                          // auto-derive controls accept the same leading `!` refusal, including
                                          // `#!Codable`. User derives (`derive T.Wire { … }`, applied as
                                          // `#[Wire]`) also stay `#` — built-in and user derives share the
                                          // same prefix; only the derive name tells them apart.
MARKER_COMPARABLE :: "Comparable" // (formerly)

                                                  // Per-field attributes (= A), written `#[…]` before a field.
MARKER_RENAME :: "Rename" // #[Rename("wire_key")]

MARKER_SKIP :: "Skip" // #[Skip]

MARKER_DEFAULT :: "Default" // #[Default] / #[Default(expr)]

MARKER_FLATTEN :: "Flatten" // #[Flatten]

                                            // Container attributes (7/8), written `#[…]` before a struct/enum.
MARKER_RENAME_ALL :: "RenameAll" // #[RenameAll(camel)]

MARKER_DENY_UNKNOWN_FIELDS :: "DenyUnknownFields"

/// Serde's internal discriminant field is not a
/// compile-time fact tag.
MARKER_TAG :: "Discriminant"

MARKER_UNTAGGED :: "Untagged" // #[Untagged]

                                              // (= C) RenameAll casing keywords — closed typed menu, own-case args.
RENAME_ALL_CAMEL :: "camel"

RENAME_ALL_SNAKE :: "snake"

RENAME_ALL_PASCAL :: "pascal"

RENAME_ALL_KEBAB :: "kebab"

RENAME_ALL_SCREAMING :: "screaming"

// ── Maturity metadata values (ratified 2026-07-12) ──────────
// Closed values for `#Meta(maturity: .Experimental | .Tested | .Hardened)`.
// They are not standalone markers and therefore are absent from marker-plane
// registries. No sema/codegen effect.
MARKER_EXPERIMENTAL :: "Experimental"

MARKER_TESTED :: "Tested"

MARKER_HARDENED :: "Hardened"

// ── Explicit discard (ratified 2026-06-28; amended by
// Ratified 2026-07-11, card #498) ─────────────────────────
// `.drop("reason")` — method-style terminal that silences E0402 for a
// fallible or #MustUse result. It is now the SOLE discard spelling; the
// `#Suppress(MustUse) { … }` lexical-scope form is retired outright
// (ordinary unknown-marker error — no MARKER_SUPPRESS registration).
METHOD_DROP :: "drop" // This rule method; distinct from consume builtin

/// Canonical list of real Jet keywords for LSP completion and rename validation.
///
/// Every entry corresponds to a `KW_*`, `LIT_*`, or `BUILTIN_*` constant above.
/// FOREIGN_* teaching-error words must NOT appear here — they are recognized only
/// to emit a diagnostic, not valid syntax.
JET_KEYWORD_LIST :: [String]{
    // Core structure (S1 S16, S50, U3)
    KW_FN,
    KW_PUB,
    KW_PRIV,
    KW_USE,
    KW_AS,
    KW_EXTERN,
    KW_MODULE,
    KW_RUST,
    // Control flow (M1, S19, S23, M1/M2)
    KW_IF,
    KW_ELSE,
    KW_LOOP,
    KW_IN,
    KW_BREAK,
    KW_NEXT,
    KW_RETURN,
    KW_YIELD,
    KW_DEFER,
    // Types and declarations (M2, S30, S27, M2, S28, S55, S57)
    KW_STRUCT,
    KW_ENUM,
    KW_ALIAS,
    KW_IMPL,
    KW_POLICY,
    KW_WRAP,
    KW_TRAIT,
    KW_TAG,
    KW_EFFECT_DECL,
    KW_DERIVE,
    // Preparation and compiler facts.
    KW_PREP,
    KW_FACT,
    KW_DISTINCT,
    // Schema migrations
    KW_MIGRATION,
    KW_RENAME,
    KW_ADD,
    KW_REMOVE,
    KW_CHANGE,
    KW_VIA,
    // Ownership / borrow keywords (S10, M2). Retired KW_MUTATE/KW_MOVE
    // in favor of the `&`/`^` sigils, and retired KW_COPY (a
    // copy is now the method `x.copy()`) — they live only as teaching errors (E0056/E0057/
    // E0991) now, so none of them are in the keyword list. The retired
    // `ref[label]` field spelling (once taught via KW_STORED) is gone
    // outright with stored-reference fields (S3) — `ref` is an
    // ordinary identifier again.
    KW_SELF,
    // Memory / expert tier (S58)
    KW_UNSAFE,
    KW_IMPURE,
    CTX_BLOCK,
    // One reserved word owns task spawning and fan-out.
    KW_CONC_TASK,
    // Immutable task-crossing snapshot verb.
    KW_FREEZE,
    // Shared-cell construction is contextual syntax.
    KW_SHARED,
    // Transactions (–): `#Transact(name) { … }`
    KW_TRANSACT,
    // Schedule-as-code (card #505): `#Job fn` — `#Every(…)`
    // stays out of this list, matching MARKER_TARGET/MARKER_META (paren-arg
    // config markers aren't bare completion words).
    KW_JOB,
    // Test / tooling (S43, S60)
    KW_TEST,
    KW_TODO,
    // This rule retired `Tainted`/`Sanitizer`; direct declared tags and
    // `#Scrub(Tag)` come from the applied-rule registry.
    // Typestate
    KW_STATE,
    KW_TRANSITION,
    KW_STATE_DECL,
    // Session/protocol types
    KW_PROTOCOL,
    PROTO_CLIENT,
    PROTO_SERVER,
    // Rule declarations
    KW_MARKER,
    // In-body struct validation (card #506)
    KW_VALIDATE_BLOCK,
    VALIDATE_CHECK_FN,
    // Reserved literals: boolean (S11), option (S32), synthetic (M4).
    // Result `Ok`/`Err` and Optional `Val` are contextual identifiers, so their
    // canonical LIT_* constants intentionally stay outside this keyword list.
    LIT_TRUE,
    LIT_FALSE,
    LIT_NULL,
    KW_IT,
    // Binding sigils (SIGIL_BIND_IMMUT / SIGIL_BIND_MUT) are not words; omitted.
}

/// Canonical list of built-in type names for LSP completion and rename guard.
///
/// Only types a user writes in source. `Result` is the legacy fallible type
/// (S34) kept for teaching errors; it is intentionally excluded here since
/// failure contracts use the prefix spelling `!E` (or `!(E1 | E2)`).
JET_TYPE_LIST :: [String]{
    TYPE_INT,
    TYPE_FLOAT,
    TYPE_BOOL,
