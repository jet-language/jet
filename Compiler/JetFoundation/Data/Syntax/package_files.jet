/// (ratified 2026-06-25): the `build { }` block in `pkg.jet`
/// where named build profiles are defined. A profile is a `Build{ optimize: … }`
/// value; blessed names `release`/`debug` carry built-in defaults; all others
/// must be declared here. Active profile is chosen by `--release` (sugar for
/// `--profile=release`) or `--profile=<name>` — never by ambient environment.
MANIFEST_BLOCK_BUILD :: "build"

/// The constructor type for a build profile value inside
/// `pkg.jet`'s `build { }` block — written as `Build{ optimize: … }`.
BUILD_CTOR :: "Build"

/// The field inside a `Build{ … }` profile value that sets
/// the optimization level.
BUILD_FIELD_OPTIMIZE :: "optimize"

/// Blessed profile names — `release`, `debug`, `ci`, and
/// `hardened` carry built-in defaults and need no explicit declaration in
/// `build { }`.
BUILD_PROFILE_RELEASE :: "release"

BUILD_PROFILE_DEBUG :: "debug"

BUILD_PROFILE_CI :: "ci"

BUILD_PROFILE_HARDENED :: "hardened"

/// Optional fields inside `Build{ … }` profile values.
BUILD_FIELD_DEBUG_INFO :: "debug_info"

BUILD_FIELD_SMALL :: "small"

BUILD_FIELD_PANIC :: "panic"

BUILD_FIELD_SETTINGS :: "settings"

/// Retired Build fields are recognized only to teach the typed
/// `settings:` replacement; they never contribute compiler configuration.
RETIRED_BUILD_FIELD_FEATURES :: "features"

RETIRED_BUILD_FIELD_ENV :: "env"

/// Standing programmable-build authority grant.
BUILD_FIELD_ALLOW :: "allow"

/// (ratified 2026-07-03): canonical adapter declaration
/// and recipe spellings. These are named module calls, not lexer keywords, so
/// they do not add a grammar token or editor highlight.
PKG_ADAPT :: "Pkg.adapt"

ADAPTER_FIELD_NAME :: "name"

ADAPTER_FIELD_SOURCE :: "source"

ADAPTER_FIELD_DEPS :: "deps"

ADAPTER_FIELD_RECIPE :: "recipe"

RECIPE_COPY :: "Recipe.copy"

RECIPE_PREBUILT :: "Recipe.prebuilt"

RECIPE_FIELD_BIN :: "bin"

RECIPE_FIELD_AS :: "as"

RECIPE_FIELD_AS_NAME :: "as_name"

RECIPE_CARGO :: "Recipe.cargo"

RECIPE_GO :: "Recipe.go"

RECIPE_NODE :: "Recipe.node"

RECIPE_CMAKE :: "Recipe.cmake"

RECIPE_MAKE :: "Recipe.make"

/// (ratified 2026-08-03): finite executable adapter
/// recipe and step spellings.
RECIPE_TYPE :: "Recipe"

RECIPE_BUILD :: "Recipe.build"

RECIPE_BUILD_METHOD :: "build"

RECIPE_FIELD_STEPS :: "steps"

RECIPE_STEP_FETCH :: ".fetch"

RECIPE_STEP_EXEC :: ".exec"

RECIPE_STEP_INSTALL :: ".install"

RECIPE_STEP_INSTALL_TREE :: ".install_tree"

RECIPE_STEP_FIELD_URL :: "url"

RECIPE_STEP_FIELD_SHA256 :: "sha256"

RECIPE_STEP_FIELD_TOOL :: "tool"

RECIPE_STEP_FIELD_ARGS :: "args"

RECIPE_STEP_FIELD_SRC :: "src"

RECIPE_STEP_FIELD_DEST :: "dest"

ADAPTER_RECIPE_NAMES :: [String]{
    RECIPE_BUILD,
    RECIPE_PREBUILT,
    RECIPE_COPY,
    RECIPE_CARGO,
    RECIPE_GO,
    RECIPE_NODE,
    RECIPE_CMAKE,
    RECIPE_MAKE,
}

/// `panic:` values for `Build{ panic: … }`.
BUILD_PANIC_ABORT :: "abort"

BUILD_PANIC_UNWIND :: "unwind"

/// `optimize:` levels for `Build{ optimize: … }`:
/// `none` (no optimization, fastest compile), `basic` (opt-level=2, the
/// driver default), `full` (opt-level=3, maximum throughput).
BUILD_OPTIMIZE_NONE :: "none"

BUILD_OPTIMIZE_BASIC :: "basic"

BUILD_OPTIMIZE_FULL :: "full"

/// Canonical list of impure builtins (write stdout/stderr or read stdin).
///
/// Used by Sema/Purity and Comptime/Purity to detect I/O calls inside
/// `pure fn` or comptime contexts. Both consumers must agree on this set;
/// having it here prevents silent divergence.
IMPURE_BUILTINS :: [String]{
    BUILTIN_PRINT,
    "eprint",
    "print",
    BUILTIN_INPUT,
    "read_all_input",
}
