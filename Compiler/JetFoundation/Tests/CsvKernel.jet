use JetFoundation.CsvKernel.[delimiter, parse, CsvOptions]

// Rust: crates/jet-foundation/src/CsvKernel.rs:405
#Test("options_and_physical_lines_apply_to_records") {
    rows :: parse("name\tage\r\n\r\nAda\t36\r\n\"Grace\r\nHopper\"\t85",
        CsvOptions{delimiter: '\t', header: true, skip_blank: true}) ?? panic("valid CSV")
    assert(rows[0].fields == [String]{"Ada", "36"})
    assert(rows[0].line == 3)
    assert(rows[1].fields == [String]{"Grace\r\nHopper", "85"})
    assert(rows[1].line == 4)
}
// Rust: crates/jet-foundation/src/CsvKernel.rs:422
#Test("blank_quoted_empty_field_is_not_a_blank_record") {
    rows :: parse("\n\"\"\n", CsvOptions{delimiter: ',', header: false, skip_blank: true}) ?? panic("valid CSV")
    assert(rows.len() == 1)
    assert(rows[0].fields == [String]{""})
    assert(rows[0].line == 2)
}
// Rust: crates/jet-foundation/src/CsvKernel.rs:438
#Test("skip_blank_ignores_records_with_only_separators") {
    rows :: parse(",\n \n,\n", CsvOptions{delimiter: ',', header: false, skip_blank: true}) ?? panic("valid CSV")
    assert(rows.len() == 1)
    assert(rows[0].fields == [String]{" "})
    assert(rows[0].line == 2)
}
// Rust: crates/jet-foundation/src/CsvKernel.rs:454
#Test("malformed_input_uses_the_same_engine") {
    if parse("a,\"unterminated", CsvOptions.default()) == {
        .Ok(_) -> panic("expected unterminated-field error")
        .Err(error) -> assert(error.contains("quoted field ended before its closing quote"))
    }
    assert(parse("a,\"ok\"junk", CsvOptions.default()).is_err())
    assert(parse("a\rb", CsvOptions.default()).is_err())
    if parse("header\r\n\"bad\r\nvalue", CsvOptions{delimiter: ',', header: true, skip_blank: false}) == {
        .Ok(_) -> panic("expected multiline-field error")
        .Err(error) -> assert(error.contains("line 3"))
    }
}
// Rust: crates/jet-foundation/src/CsvKernel.rs:473
#Test("delimiter_requires_one_safe_character") {
    loop value in [String]{"", "ab", "\""} {
        if delimiter(value) == {
            .Ok(_) -> panic("expected invalid delimiter")
            .Err(error) -> assert(error.starts_with("E2701:"))
        }
    }
    assert((delimiter("\t") ?? panic("tab rejected")) == '\t')
}
