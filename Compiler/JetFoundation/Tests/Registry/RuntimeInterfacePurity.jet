// Every jet.runtime binding (RUNTIME_INTERFACE_ROWS, generated from the
// runtime bindings of Compiler/JetRuntime/Source) that writes no effect row is
// one this file has reviewed. A binding with no row is pure to sema, which
// may compute it while building, in the compiler's own process; one that
// reads the running program's clocks or watch handles declares the effect it
// reads instead, and one only the running program can answer (its task, its
// process id, its terminal, its live registry cell, its UI provider, its
// platform, module loader and SIMD width) is run-time only
// (RUNTIME_ONLY_READS), which sema never computes while compiling. So a new
// empty row, or a reviewed binding that gained a row, fails here until the
// list says why.
use {
    jet_foundation.[RUNTIME_INTERFACE_ROWS, RUNTIME_ONLY_READS, RuntimeInterfaceRow, runtime_c_export, runtime_only_read]
}

// A group of bindings with no effect row, `module.member` each, and why none
// of them reads the running program's state.
RuntimePureGroup: struct {
    reason: String
    members: [String]
}

runtime_pure_groups: fn() -> [RuntimePureGroup] Never! {
    [RuntimePureGroup]{
        RuntimePureGroup{reason: "computes from its arguments, or from the zone table compiled into the runtime image", members: [String]{
            "time.embedded_zone_bytes",
            "encoding.string_byte", "encoding.bytes_into_text", "encoding.utf8_validate",
            "authority.covers", "files.authority_to_wire", "files.host_path_is_absolute", "files.host_path_join",
            "net.dns_srv_target", "net.dns_srv_port", "net.dns_srv_priority", "net.dns_srv_weight",
            "net.ip_bytes", "net.ip_is_v4", "net.socket_ip", "net.socket_port", "net.socket_scope", "net.udp_packet_addr",
            "testing.text_window",
            "math.floor", "math.ceil", "math.trunc", "math.sqrt", "math.fabs", "math.fmod", "math.fma", "math.to_bits", "math.from_bits",
        }},
        RuntimePureGroup{reason: "makes or uses a runtime handle, which only a call made while running holds", members: [String]{
            "files.reader_path", "files.map_kind",
            "mod.parse_context", "mod.check_context", "mod.context_name", "mod.context_digest", "mod.export_info", "mod.exports_count", "mod.finish_context",
            "rt.receipt", "rt.cancel", "rt.is_cancelled",
            "tasks.condition_notify_one", "tasks.condition_notify_all",
            "event.scope_new", "event.policy_sync",
            "watcher.set", "watcher.cancel", "watcher.is_active", "watcher.target", "watcher.text", "watcher.number",
            "watcher.set_add", "watcher.set_len", "watcher.set_get",
        }},
        RuntimePureGroup{reason: "enters or leaves a text mode its caller restores before returning", members: [String]{
            "encoding.text_cells_enter", "encoding.text_cells_leave", "encoding.etf_strings_enter", "encoding.etf_strings_leave",
        }},
        RuntimePureGroup{reason: "the test harness's record and fault schedule, which only a running test reaches", members: [String]{
            "testing.record_failure", "testing.clear_failure", "testing.skip", "testing.suite_snapshot",
            "files.fault_should_fail", "term.stdio_fault",
        }},
        RuntimePureGroup{reason: "a write, which reads nothing back", members: [String]{
            "log.metric_publish", "encoding.coerce_emit", "web.live_publish",
        }},
    }
}

// Whether `declaration` (`[priv ]name: fn(params) …`) writes a non-empty
// effect row: the generator renders it right after the parameter list, and
// no parameter of an interface member is a function type with a row of its
// own.
runtime_declaration_has_row: fn(declaration: String) -> Bool Never! {
    declaration.contains(") -[") && !declaration.contains(") -[]>")
}

// A binding that reads the running program, and the row it declares.
RuntimeReadRow: struct {
    name: String
    row: String
}

// `module.member` of `row`, without the `jet.runtime.` root.
runtime_binding_name: fn(row: RuntimeInterfaceRow) -> String Never! {
    "{row.module_name.remove_prefix("jet.runtime.")}.{row.member}"
}

#Test("every jet.runtime binding with no effect row is on the reviewed pure list or run-time only") {
    reviewed := [String]{}
    violations := [String]{}
    loop group in runtime_pure_groups() {
        loop member in group.members {
            if reviewed.contains(member) -> violations.push("`{member}` is listed twice")
            reviewed.push(member.copy())
        }
    }
    bound := [String]{}
    loop row in RUNTIME_INTERFACE_ROWS {
        name: runtime_binding_name(row)
        bound.push(name.copy())
        listed: reviewed.contains(name)
        runtime_only: runtime_only_read(row.symbol) != None
        if listed && runtime_only {
            violations.push("`{name}` is run-time only, so it leaves the reviewed pure list")
        } else if runtime_declaration_has_row(row.declaration) {
            if listed -> violations.push("`{name}` declares an effect row, so it leaves the reviewed pure list: {row.declaration}")
        } else if !listed && !runtime_only {
            violations.push("`{name}` has no effect row and isn't on the reviewed pure list: declare the effect it reads, list it with the reason it reads none, or add its export to RUNTIME_ONLY_READS ({row.declaration})")
        }
    }
    loop member in reviewed {
        if !bound.contains(member) -> violations.push("`{member}` is on the reviewed pure list, but no jet.runtime binding has that name")
    }
    assert_eq(violations.join("\n"), "")
}

#Test("every run-time-only read names a runtime export, and the running task, process, terminal, live cell, UI provider and platform are among them") {
    loop row in RUNTIME_ONLY_READS {
        assert(runtime_c_export(row.symbol), "RUNTIME_ONLY_READS names `{row.symbol}`, which no runtime export defines")
    }
    running: [String]{
        "tasks.task_identity", "tasks.task_cancelled", "files.atomic_pid", "files.os_family", "files.path_windows", "term.stdout_terminal", "term.stderr_terminal",
        "web.live_load", "web.live_replace", "mod.supported", "mod.os", "sys.simd_lanes",
        "ui.capability", "ui.clipboard_get", "ui.clipboard_set", "ui.event_pop", "ui.key_claim", "ui.dialog_request", "ui.dialog_result",
    }
    loop name in running {
        found := false
        loop row in RUNTIME_INTERFACE_ROWS {
            if runtime_binding_name(row) != name -> next
            found = true
            assert(runtime_only_read(row.symbol) != None, "`{name}` ({row.symbol}) reads what only the running program has, but isn't run-time only")
        }
        assert(found, "no jet.runtime binding is named `{name}`")
    }
}

#Test("the bindings that read the running program declare the effect they read") {
    expected: [RuntimeReadRow]{
        RuntimeReadRow{name: "watcher.poll", row: "-[IO]>"},
        RuntimeReadRow{name: "tasks.task_cpu_ns", row: "-[Time]>"},
        RuntimeReadRow{name: "time.clock_mono_ns", row: "-[Time.Wait]>"},
    }
    loop want in expected {
        found := false
        loop row in RUNTIME_INTERFACE_ROWS {
            if runtime_binding_name(row) != want.name -> next
            found = true
            assert(row.declaration.contains(") {want.row}"), "`{want.name}` declares {row.declaration}, not {want.row}")
        }
        assert(found, "no jet.runtime binding is named `{want.name}`")
    }
}
