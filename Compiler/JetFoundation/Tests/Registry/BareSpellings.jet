// Every trait Core's prelude declares is a bare spelling of core.prelude
// (CORE_BARE_SOURCE_MODULES), so any module, a dependency package's
// included, implements it without importing it.
use {
    bare_spellings_files: core.files
    jet_foundation.[core_bare_source_module]
}

BARE_SPELLINGS_PRELUDE: "Core/Prelude/Prelude.jet"

BARE_SPELLINGS_TRAIT_HEAD: ": trait {{"

#Test("every prelude trait is a bare core spelling") {
    source: bare_spellings_files.read(BARE_SPELLINGS_PRELUDE) ?? panic("read {BARE_SPELLINGS_PRELUDE}: {err}")
    traits := [String]{}
    loop line in source.split("\n") {
        if line.starts_with(" ") || !line.ends_with(BARE_SPELLINGS_TRAIT_HEAD) -> next
        traits.push(line.slice(0..<(line.len() - BARE_SPELLINGS_TRAIT_HEAD.len())))
    }
    assert(traits.contains("DebugView"), "the prelude declares DebugView")
    loop name in traits {
        assert_eq(core_bare_source_module(name), Val("core.prelude"))
    }
}
