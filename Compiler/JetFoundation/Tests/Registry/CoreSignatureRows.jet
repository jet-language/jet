// The fixed Core signature tables spell every typed Core call as row data,
// including plugin load's optional `limits:` label and vault current's
// sealed key type parameter.
use jet_foundation.[
    CoreCallDefault,
    CoreCallTypeConstraint,
    ParamZone,
    Type,
    core_host_fixed_signature,
    type_identity_equal,
]

#Test("plugin load takes an optional limits label built from its field defaults") {
    signature: core_host_fixed_signature("core.plugin", "load") ?? panic("plugin load signature")
    assert(signature.min_arity == 2 && signature.max_arity == 3 && signature.parameters.len() == 3)
    assert(signature.parameters[0].zone == ParamZone.PositionalOnly && signature.parameters[1].zone == ParamZone.PositionalOnly)
    assert(signature.parameters[0].default == None && signature.parameters[1].default == None)
    assert(type_identity_equal(signature.parameters[1].ty, Type.Named{name: "Authority"}))
    limits: signature.parameters[2]
    assert(limits.name == "limits" && limits.label == "limits" && limits.zone == ParamZone.LabelOnly)
    assert(limits.default == Val(CoreCallDefault.FieldDefaults))
    assert(type_identity_equal(limits.ty, Type.Named{name: "<corelib>/core.plugin.Limits"}))
    returned: signature.return_type ?? panic("plugin load result")
    assert(type_identity_equal(returned, Type.Named{name: "Plugin"}))
}

#Test("vault current seals its key type parameter") {
    signature: core_host_fixed_signature("core.crypto.vault", "current") ?? panic("vault current signature")
    assert(signature.min_arity == 1 && signature.max_arity == 1 && signature.parameters.len() == 1)
    assert(signature.parameters[0].zone == ParamZone.PositionalOnly)
    assert(signature.type_parameters.len() == 1 && signature.type_parameters[0].name == "T")
    assert(signature.type_parameters[0].constraint == CoreCallTypeConstraint.VaultKey)
    key_ref: Type.Apply{name: "KeyRef", args: [Type]{Type.Named{name: "T"}}}
    returned: signature.return_type ?? panic("vault current result")
    assert(type_identity_equal(returned, Type.Result{ok: Type.Option{inner: key_ref}, err: Type.Named{name: "VaultError"}}))
}
