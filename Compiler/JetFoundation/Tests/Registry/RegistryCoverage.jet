// Ports of the registry-row gates from the deleted (#6096, #5902 C4), run
// against the Jet registries that replaced the Rust ones.
use {
    registry_coverage_files :: core.files
    jet_foundation.[DIAGNOSTIC_ERROR, DIAGNOSTIC_LINT, DiagnosticRegistryStatus, FOUNDATION_FACT_READ_ROWS, FactRead, MARKER_SOURCE, REGISTRATION_FACT_ROWS, REGISTRATION_TRUTH_ROWS, RegistrationFactTarget, diagnostic_explanation, diagnostic_registry_row, diagnostic_registry_rows, diagnostic_stage_is_registered, fact_read_reflection_kind, lint_code_for_name, lint_name_for_code, lint_registered_lints, marker_source_read]
}

fn registry_coverage_is_snake_case(name: String) -> Bool Never! {
    bytes :: name.bytes()
    if bytes.len() == 0 -> return false
    previous_underscore := false
    loop (index, byte) in bytes {
        if byte == (U8{95}) {
            if index == 0 || previous_underscore -> return false
            previous_underscore = true
        } else if (byte >= (U8{97}) && byte <= (U8{122})) || (byte >= (U8{48}) && byte <= (U8{57})) {
            previous_underscore = false
        } else {
            return false
        }
    }
    !previous_underscore
}

fn registry_coverage_has(values: [String], value: String) -> Bool Never! {
    loop item in values {
        if item == value -> return true
    }
    false
}

#Test("registered_codes_keep_explicit_severity_and_lint_names") {
    loop expected in [(code: "E2930", severity: DIAGNOSTIC_LINT), (code: "W0410", severity: DIAGNOSTIC_LINT), (code: "R0801", severity: DIAGNOSTIC_ERROR), (code: "E0003", severity: DIAGNOSTIC_ERROR)] {
        row :: diagnostic_registry_row(expected.code) ?? panic("{expected.code} must stay registered")
        assert(row.severity == expected.severity, "{expected.code} must keep the registry row's explicit severity")
    }
    loop lint in lint_registered_lints() {
        name :: lint.lint_name ?? panic("lint {lint.code} needs a stable name")
        assert(registry_coverage_is_snake_case(name), "lint {lint.code} has an unstable selector name `{name}`")
    }
}

#Test("semantic_guidance_lints_round_trip_through_the_registry") {
    loop expected in [
        (code: "L0516", name: "message_text"),
        (code: "L0517", name: "path_containment_string_prefix"),
        (code: "L0518", name: "redundant_fixed_cleanup"),
        (code: "L0519", name: "unit_scalar_rewrap"),
        (code: "L0520", name: "display_migration"),
        (code: "L0521", name: "complete_ascii_case_ladder"),
        (code: "L0522", name: "walk_files_filter"),
        (code: "L0523", name: "repeated_list_head"),
        (code: "L0524", name: "raw_multiline_html"),
    ] {
        row :: diagnostic_registry_row(expected.code) ?? panic("{expected.code} must stay registered")
        assert(row.severity == DIAGNOSTIC_LINT, "{expected.code} is a lint")
        assert((row.lint_name ?? "") == expected.name, "{expected.code} keeps its lint name")
        assert(!row.what.is_empty(), "{expected.code} needs What copy")
        assert(!row.why.is_empty(), "{expected.code} needs Why copy")
        assert(!row.fix.is_empty(), "{expected.code} needs Fix copy")
        assert((lint_code_for_name(expected.name) ?? "") == expected.code, "{expected.name} resolves to {expected.code}")
        assert((lint_name_for_code(expected.code) ?? "") == expected.name, "{expected.code} resolves to {expected.name}")
    }
}

#Test("every_registered_lint_has_a_unique_snake_case_name") {
    registered := [String]{}
    loop row in diagnostic_registry_rows() {
        if row.severity == DIAGNOSTIC_LINT && row.status != DiagnosticRegistryStatus.Retired -> &registered.push(row.code)
    }
    names := [String]{}
    codes := [String]{}
    loop lint in lint_registered_lints() {
        name :: lint.lint_name ?? panic("every registered lint must carry a stable name")
        assert(registry_coverage_is_snake_case(name), "lint `{name}` is not a stable snake_case name")
        assert(!registry_coverage_has(names, name), "lint name `{name}` is duplicated")
        &names.push(name)
        assert(!registry_coverage_has(codes, lint.code), "lint code `{lint.code}` is duplicated")
        &codes.push(lint.code)
        registered_row :: diagnostic_registry_row(lint.code) ?? panic("lint `{lint.code}` is not a registered diagnostic row")
        assert(registered_row.severity == DIAGNOSTIC_LINT, "lint `{lint.code}` is not a registered lint diagnostic row")
        assert((lint_name_for_code(lint.code) ?? "") == name, "lint `{lint.code}` does not round-trip through the name registry")
        assert((lint_code_for_name(name) ?? "") == lint.code, "lint name `{name}` does not resolve to its registered code")
    }
    &codes.sort()
    &registered.sort()
    assert_eq(codes.join(" "), registered.join(" "))
}

#Test("diagnostics_registry_has_no_duplicate_code_rows") {
    seen := [String]{}
    duplicates := [String]{}
    loop (index, row) in diagnostic_registry_rows() {
        if registry_coverage_has(seen, row.code) -> &duplicates.push("{row.code} at row {index}")
        else -> &seen.push(row.code)
    }
    assert(seen.len() > 100, "the typed diagnostic rows must be populated")
    assert_eq(duplicates.join("\n"), "")
}

// Jet teaches no foreign or retired spelling, so no Active row is named for
// one. The FFI rows name the foreign-function boundary itself. The Jetpack
// rows are retired with Jetpack's generic flag and ref errors.
REGISTRY_COVERAGE_FFI_ROWS :: [String]{"E0064", "E0704", "E0705", "E3014", "E3215", "E3216", "E3220", "E3222"}
REGISTRY_COVERAGE_JETPACK_FOLLOW_UP_ROWS :: [String]{"E1296", "E1317"}

#Test("no_active_row_teaches_a_foreign_or_retired_spelling") {
    teaching := [String]{}
    loop row in diagnostic_registry_rows() {
        if row.status != DiagnosticRegistryStatus.Active -> next
        if !row.name.starts_with("jet.Foreign") && !row.name.starts_with("jet.Retired") -> next
        if registry_coverage_has(REGISTRY_COVERAGE_FFI_ROWS, row.code) || registry_coverage_has(REGISTRY_COVERAGE_JETPACK_FOLLOW_UP_ROWS, row.code) -> next
        &teaching.push("{row.code} {row.name}")
    }
    assert_eq(teaching.join("\n"), "")
}

// Every active row's stage holds one value of the closed stage set: in the
// generated rows, and in each Prelude diagnostic type's `stage` list, whose
// parts join in the registered order (`[.Parse, .Sema]` is `parse/sema`). A
// retired or reserved row runs in no stage, so its stage is empty.
#Test("every_diagnostic_stage_is_in_the_closed_set") {
    unknown := [String]{}
    loop row in diagnostic_registry_rows() {
        if row.status != DiagnosticRegistryStatus.Active {
            if row.stage != "" -> &unknown.push("{row.code}: an inactive row has stage `{row.stage}`")
            next
        }
        if !diagnostic_stage_is_registered(row.stage) -> &unknown.push("{row.code}: `{row.stage}`")
    }
    source :: registry_coverage_files.read("Compiler/Prelude/Diagnostics.jet") ?? panic("read Compiler/Prelude/Diagnostics.jet: {err}")
    count := 0
    loop line in source.split("\n") {
        if line == "    impl Diagnostic {{" -> count += 1
        if !line.starts_with("        stage :: [") -> next
        stage :: line.remove_prefix("        stage :: [").remove_suffix("]").replace(", .", "/").remove_prefix(".").lower()
        if !diagnostic_stage_is_registered(stage) -> &unknown.push("Prelude impl {count}: `{stage}`")
    }
    assert(count > 100, "the Prelude diagnostic impls must be readable")
    assert_eq(unknown.join("\n"), "")
    loop stage in ["parser", "compiler", "type", "sema/parse", "loader/jet", "jit", "retired", ""] {
        assert(!diagnostic_stage_is_registered(stage), "`{stage}` must not be a registered stage")
    }
}

// (I4c): `jet explain` resolves every registered row, with the row's own stage
// and meaning.
#Test("every_registered_code_has_explain_page") {
    missing := [String]{}
    loop row in diagnostic_registry_rows() {
        if diagnostic_explanation(row.code) == .Val(explanation) {
            if explanation.code != row.code || explanation.stage != row.stage || explanation.meaning != row.meaning -> &missing.push("{row.code} explains another row")
        } else {
            &missing.push(row.code)
        }
    }
    assert_eq(missing.join("\n"), "")
}

// (D-MARK-REPEAT1=A): the repeatable column is the only place repetition is
// decided, and it stays a minority.
#Test("repeatable_rows_are_declared_not_assumed") {
    repeatable := [String]{}
    loop rule in marker_source_read(MARKER_SOURCE) {
        if rule.repeatable -> &repeatable.push(rule.name)
    }
    assert_eq(repeatable.join(" "), "Pre Post Allow")
}

// (D-META-REG1=A): the registration rows hold every kind: written-code marker
// rows, value planes, scope rights, build facts, corpus truths and diagnostic
// rows; each marker row is one declaration with at least one site.
#Test("the_one_table_holds_every_kind") {
    rules :: marker_source_read(MARKER_SOURCE)
    assert(rules.len() > 0, "the one table holds no Marker row")
    names := [String]{}
    loop rule in rules {
        assert(!registry_coverage_has(names, rule.name), "`#{rule.name}` is declared twice")
        &names.push(rule.name)
        assert(rule.sites.len() > 0, "`#{rule.name}` targets no written code")
    }
    values := 0
    scopes := 0
    builds := 0
    fact_names := [String]{}
    loop row in REGISTRATION_FACT_ROWS {
        assert(!registry_coverage_has(fact_names, row.name), "fact `{row.name}` is registered twice")
        &fact_names.push(row.name)
        if row.target == {
            .Value -> values += 1
            .Scope -> scopes += 1
            .Build -> builds += 1
        }
    }
    assert(values > 0, "the one table holds no Plane row")
    assert(scopes > 0, "the one table holds no Right row")
    assert(builds > 0, "the one table holds no Fact row")
    assert(REGISTRATION_TRUTH_ROWS.len() > 0, "the one table holds no Truth row")
    assert(diagnostic_registry_rows().len() > 0, "the one table holds no Diagnostic row")
}

// (D-FACT-LAW1=B): every row states which way is safe; a row with no meaningful
// direction states `none` and has no gate to move it, and a prover-published
// row is read-only.
#Test("every_row_states_the_one_way_law") {
    violations := [String]{}
    loop row in REGISTRATION_FACT_ROWS {
        if !registry_coverage_has(["gain", "shrink", "discharge", "none"], row.safe_direction) -> &violations.push("{row.name} states no safe direction (`{row.safe_direction}`)")
        if row.safe_direction == "none" && row.gates.len() > 0 -> &violations.push("{row.name} states no direction but names gates")
        if row.published_by != None && row.safe_direction != "none" -> &violations.push("{row.name} is prover-published but states a direction")
        loop gate in row.gates {
            if gate.trim().is_empty() -> &violations.push("{row.name} names an empty gate")
        }
    }
    loop row in REGISTRATION_TRUTH_ROWS {
        if row.home.is_empty() -> &violations.push("truth {row.name} has no home")
        if row.guard_test.is_empty() || row.guard_file.is_empty() -> &violations.push("truth {row.name} has no guard")
    }
    assert_eq(violations.join("\n"), "")
}

// (D-ONCE-LAW1=A): a registered truth names a home that exists and a guard that
// the named file defines.
#Test("every_registered_truth_names_a_home_and_a_guard_that_exist") {
    violations := [String]{}
    loop row in REGISTRATION_TRUTH_ROWS {
        if !registry_coverage_files.exists(row.home) -> &violations.push("`{row.name}` names the home `{row.home}`, which is not a file")
        if !registry_coverage_files.exists(row.guard_file) {
            &violations.push("`{row.name}` names the guard file `{row.guard_file}`, which cannot be read")
            next
        }
        source :: registry_coverage_files.read(row.guard_file) ?? panic("read {row.guard_file}: {err}")
        words :: row.guard_test.split(" ").to_list()
        flag :: words[words.len() - 1]
        defined :: if flag.starts_with("--") -> source.contains(flag) else -> source.contains("#Test(\"{row.guard_test}\")")
        if !defined -> &violations.push("`{row.name}` names the guard `{row.guard_test}`, which `{row.guard_file}` does not define")
    }
    assert_eq(violations.join("\n"), "")
}

// (D-FACT-OWN1=A): the ownership prover publishes read-only rows with no plane
// algebra.
#Test("a_prover_publishes_read_only_rows") {
    loop name in ["Sendability", "ViewProvenance", "Movedness"] {
        found := false
        loop row in REGISTRATION_FACT_ROWS {
            if row.name != name -> next
            found = true
            assert((row.published_by ?? "") == "ownership", "`{name}` names no prover")
            assert(row.safe_direction == "none", "`{name}` is read-only, so it states no direction")
            assert(row.gates.len() == 0, "`{name}` is read-only, so it has no gate")
        }
        assert(found, "the ownership prover publishes no `{name}` row")
    }
}

// Each orphan fact plane has exactly one value-targeted home, and prover state
// is not a registered plane.
#Test("orphan_fact_rows_have_one_home") {
    loop name in ["Sendability", "Attribution", "Origin", "ViewProvenance", "UnitScaleProvenance", "Maturity"] {
        homes := 0
        loop row in REGISTRATION_FACT_ROWS {
            if row.name != name -> next
            homes += 1
            assert(row.target == RegistrationFactTarget.Value, "`{name}` attaches to a value")
        }
        assert(homes == 1, "`{name}` must have one registry home")
    }
    loop engine_fact in ["Uninit", "Exhaustiveness"] {
        loop row in REGISTRATION_FACT_ROWS -> assert(row.name != engine_fact, "`{engine_fact}` is prover state, not a registered user fact plane")
    }
}

// Every registered value plane has one home and a typed FactRead projection
// that covers it, and the plane's source read reports the same reflection kind
// as that projection row. Not ported: the Rust `build_registered_fact_info`
// aggregate check. Jet builds FactInfo only inside comptime evaluation (JetSema
// Comptime/Reflection.jet `sema_comptime_reflection_fact_info`) from this same
// reflection string; no standalone builder exists to call from a registry test.
#Test("every_registered_plane_is_reflectable") {
    violations := [String]{}
    planes := 0
    loop row in REGISTRATION_FACT_ROWS {
        if row.target != RegistrationFactTarget.Value -> next
        planes += 1
        homes := 0
        loop other in REGISTRATION_FACT_ROWS {
            if other.name == row.name -> homes += 1
        }
        if homes != 1 -> &violations.push("plane `{row.name}` has {homes} homes")
        projection := String?{None}
        covering := 0
        loop read in FOUNDATION_FACT_READ_ROWS {
            if !read.planes.contains(row.name) -> next
            covering += 1
            if projection == None -> projection = read.reflection.copy()
        }
        if covering == 0 {
            &violations.push("plane `{row.name}` has no FactRead projection")
            next
        }
        kind :: projection ?? {
            &violations.push("plane `{row.name}` resolves to a FactRead row with no reflection kind")
            next
        }
        source_kind :: fact_read_reflection_kind(FactRead.RegisteredPlane{name: row.name}) ?? ""
        if source_kind != kind -> &violations.push("plane `{row.name}`: source read reflects `{source_kind}`, projection row reflects `{kind}`")
    }
    assert(planes > 0, "the registry holds no value plane")
    assert_eq(violations.join("\n"), "")
}
