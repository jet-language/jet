use core.math as math
use core.encoding as encoding

fn require_unsupported(value: CtValue, reason: String) Never! {
    if ast_comptime_value_json(value) == {
        .Ok(_) -> panic("unsupported value was encoded")
        .Err(error) -> {
            assert(error.format == encoding.EncodingFormat.JSON)
            assert(error.kind == encoding.EncodingErrorKind.Unsupported)
            assert_eq(error.reason, reason)
            assert_eq(error.byte_offset, 0)
            assert_eq(error.path, "$")
            assert_eq(error.line, None)
            assert_eq(error.column, None)
            assert_eq(error.cause, None)
        }
    }
}

fn run() {
    numbers :: [Float]{math.nan(), math.infinity(), -math.infinity()}
    loop number in numbers {
        value :: CtValue.Float(CtFloat.F64(number))
        require_unsupported(value, "JSON cannot encode a non-finite Float")
        require_unsupported(CtValue.List([CtValue]{value}), "JSON cannot encode a non-finite Float")
    }
    require_unsupported(CtValue.Map([CtMapEntry]{CtMapEntry{key: CtKey.Int(1), value: CtValue.Int(2)}}), "JSON cannot encode non-text map keys")
    assert_eq(ast_comptime_value_json(CtValue.Char('\n')) ?? panic("Char JSON"), "\"\\n\"")
    assert_eq(ast_comptime_value_json(CtValue.Char('"')) ?? panic("Char JSON"), "\"\\\"\"")
    bytes := [U8]{}
    loop byte in 0..<32 -> &bytes.push(U8{byte})
    controls :: String.from_bytes(bytes) ?? panic("C0 text")
    encoded :: ast_comptime_value_json(CtValue.Str(controls)) ?? panic("C0 JSON")
    assert_eq(encoded, foundation_json_quote(controls))
    assert(encoded.contains("\\u001f"))
}
