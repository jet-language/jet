// Assemble with the canonical Compiler unit, replacing its host entry.
use jet_foundation.[
    CORE_CALL_COVERAGE_KNOWN, CORE_CALL_COVERAGE_SEMA, CoreCallCoverage,
    CoreCallFallibility, CoreCallPureRoute, CoreCallRecord,
    CoreCallResourceAccess, CoreCallSignature, CoreCallSymbol, CoreCapabilityContract,
    CoreCapabilityKind, Type, core_call_projection_in,
    core_call_source_member, core_call_typed_signature,
]

core_source_owned_require: fn(ok: Bool, message: String) Never! {
    if !ok -> panic("Core SourceOwned: {message}")
}
#Test("core_source_owned") {
    // CORE_CALLS rows are literal data; the #Tests of Tools/agent/CoreSourceRows.jet
    // prove a source-owned row keeps its declaration facts.
    row: CoreCallRecord{module_name: "core.ui.host", member: "shortcut", receiver_types: [String]{}, signature: CoreCallSignature{arity: 2, max_arity: 2, borrow_mask: [Bool]{true, false}}, frame_accesses: [CoreCallResourceAccess]{}, frame_completion: None, fallibility: CoreCallFallibility.Sema, effect_kind: None, capability: CoreCapabilityContract{kind: CoreCapabilityKind.Pure, provider: None, fallback: None, failure: None}, effect_leaf: None, sink_class: None, pure_route: CoreCallPureRoute.NoPureRoute, symbol: CoreCallSymbol.SourceOwned, source_target: None, coverage: CoreCallCoverage{bits: CORE_CALL_COVERAGE_SEMA}, aot_direct: false, native_int_result: false, ui_capabilities: [String]{"UI.Shortcuts"}, marker: None, authority: None}
    original := row.copy()
    original.symbol = CoreCallSymbol.Prelude{name: "jet_ui_host_shortcut"}
    original.coverage = CoreCallCoverage{bits: CORE_CALL_COVERAGE_KNOWN}
    original.aot_direct = true
    core_source_owned_require(!row.aot_direct, "no executable host route")
    core_source_owned_require(if core_call_source_member(row) == {
        .Val(name) -> name == "shortcut"
        .None -> false
    }, "default source export")
    selected := row.copy()
    selected.source_target = Val("__shortcut_entry")
    core_source_owned_require(if core_call_source_member(selected) == {
        .Val(name) -> name == "__shortcut_entry"
        .None -> false
    }, "normalized source export")
    host_selected := original.copy()
    host_selected.source_target = Val("__not_a_host_route")
    core_source_owned_require(core_call_source_member(host_selected) == None, "non-source-owned row unchanged")
    rows: [CoreCallRecord]{row}
    sema: core_call_projection_in(rows, "core.ui.host", "shortcut", 1, 2)
    core_source_owned_require(if sema == {
        .Row(_) -> true
        .Error(_) -> false
    }, "sema projection retained")
    projections: [Int]{2, 4, 8, 32}
    loop projection in projections {
        projected: core_call_projection_in(rows, "core.ui.host", "shortcut", projection, 2)
        rejected: if projected == {
            .Error(error) -> if error == {
                .Uncovered(_) -> true
                .Unknown | .Arity(_, _) -> false
            }
            .Row(_) -> false
        }
        core_source_owned_require(rejected, "executable projection rejected")
    }
    signature: core_call_typed_signature("core.term", "__stdin_line", 0) ?? panic("missing stdio signature: __stdin_line")
    returns: Type.Result{ok: Type.Option{inner: Type.String}, err: Type.Named{name: "IOError"}}
    core_source_owned_require((signature.return_type ?? panic("missing stdio return type")) == returns, "stdio return contract")
    core_source_owned_require(signature.parameters.len() == 0, "stdio arity")
    core_source_owned_require(core_call_typed_signature("core.term", "__stdin_line", 1) == None, "stdio excess arguments rejected")
}
