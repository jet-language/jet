use {
    jet_foundation.[
        ByteSize, Diagnostic, MMIOAccess, MemoryRegion, ProviderContract, ProviderLimits,
        RuntimeLayer, SVDProvenance, SizeBudgetReport, TargetCapability,
        TargetDMAChannelFact, TargetInterruptFact, TargetMachine, TargetMachineError,
        TargetRegisterBlockFact, TargetRegisterFact, TargetUnsafeGate, jet_target_abi_c, jet_target_active_os_name,
        jet_target_allocator_json, jet_target_capabilities_for_core_usage, jet_target_capability_name,
        jet_target_environment_identity, jet_target_hardware_empty, jet_target_hardware_validate,
        jet_target_layout_cache_identity, jet_target_machine_bare_metal, jet_target_machine_board_sensor_v1,
        jet_target_machine_diagnostics, jet_target_machine_error_debug, jet_target_machine_error_diagnostic,
        jet_target_machine_errors_debug, jet_target_machine_hosted,
        jet_target_machine_provides_capability, jet_target_machine_supports_execution_tier,
        jet_target_machine_use_default, jet_target_machine_use_from_core_apis, jet_target_machine_validate,
        jet_target_machine_wasm_browser, jet_target_machine_wasm_no_os, jet_target_machine_wasm_wasi,
        jet_target_max_runtime_layer, jet_target_memory_region_new, jet_target_no_whitespace,
        jet_target_provider_identity, jet_target_provider_valid, jet_target_validate_allocator,
        jet_target_validate_linker, jet_target_validate_memory_regions, jet_target_validate_mmio,
        jet_target_validate_ram_budget,
    ]
    jet_driver.[JET_DRIVER_TARGET_MACHINE_NAMES, jet_driver_target_machine_by_name]
}

target_test_valid_machine: fn() -> TargetMachine Never! {
    machine := jet_target_machine_bare_metal("board.sensor_v1", "thumbv7em-none-eabihf", "0.0.1")
    machine.memory = [MemoryRegion]{
        jet_target_memory_region_new("flash", 0x08000000, ByteSize{bytes: 524288}, .Flash, .Rx),
        jet_target_memory_region_new("ram", 0x20000000, ByteSize{bytes: 131072}, .Ram, .Rw),
        jet_target_memory_region_new("gpio", 0x40020000, ByteSize{bytes: 1024}, .MMIO, .Rw),
    }
    machine.allocator = .Fixed{region: "ram", size: ByteSize{bytes: 16384}}
    machine.panic = .Abort
    machine.mmio = .Provider{provider: target_test_provider("test.mmio", "sha256:test-mmio")}
    machine.wall_clock = .NoClock
    machine.monotonic_clock = .Provider{provider: target_test_provider("test.monotonic", "sha256:test-monotonic")}
    machine.zone_data = .NoClock
    machine.sleep = .Provider{provider: target_test_provider("test.sleep", "sha256:test-sleep")}
    machine.entropy = .NoEntropy
    machine.scheduler = .NoScheduler
    machine.byte_sink = .NoByteSink
    machine.startup = .Generated{provider: target_test_provider("test.startup", "sha256:test-startup")}
    machine
}
target_test_provider: fn(name: String, hash: String) -> ProviderContract Never! {
    ProviderContract{provider: name, sha256: hash, provenance: "provider:{name}",
        abi: jet_target_abi_c(), limits: ProviderLimits{max_request_bytes: None, max_response_bytes: None, max_calls: None}}
}
#Test("target_capability_facts_validate_provider_contracts") {
    machine := target_test_valid_machine()
    assert(jet_target_machine_provides_capability(machine, .MMIO))
    assert(jet_target_machine_provides_capability(machine, .TimeMonotonic))
    assert(!jet_target_machine_provides_capability(machine, .TimeWall))
    assert(!jet_target_machine_provides_capability(machine, .Entropy))
    usage := jet_target_machine_use_default()
    usage.required_capabilities = [TargetCapability]{.TimeMonotonic, .TimeWall}
    assert(jet_target_machine_validate(machine, usage).contains(.MissingTargetCapability{capability: "Time.Wall"}))
    machine.mmio = .Provider{provider: target_test_provider("", "not-a-digest")}
    assert(jet_target_machine_validate(machine, jet_target_machine_use_default()).contains(.InvalidProviderContract{capability: "Target.MMIO", provider: "", sha256: "not-a-digest"}))
}
#Test("hosted_default_keeps_full_runtime") {
    machine: jet_target_machine_hosted("x86_64-unknown-linux-gnu", "0.0.1")
    usage := jet_target_machine_use_default()
    usage.core_apis = [String]{"core.files", "core.http.client"}
    usage.heap_required = true
    assert_eq(jet_target_max_runtime_layer(machine), RuntimeLayer.Std)
    assert(jet_target_machine_validate(machine, usage).is_empty())
}
#Test("hosted_counting_allocator_is_typed_and_auditable") {
    machine := jet_target_machine_hosted("x86_64-unknown-linux-gnu", "0.0.1")
    machine.allocator = .Counting{cap: Val(ByteSize{bytes: 2147483648})}
    assert(jet_target_machine_validate(machine, jet_target_machine_use_default()).is_empty())
    assert_eq(jet_target_allocator_json(machine.allocator), "{{\"kind\":\"counting\",\"wraps\":\"system\",\"cap_bytes\":2147483648}}")
}
#Test("no_os_machine_rejects_hosted_counting_wrapper") {
    machine := target_test_valid_machine()
    machine.allocator = .Counting{cap: None}
    assert(jet_target_machine_validate(machine, jet_target_machine_use_default()).contains(.HostedAllocatorRequiresOS))
}
#Test("valid_no_os_machine_passes") {
    usage := jet_target_machine_use_default()
    usage.stack_bytes = 4096
    usage.static_ram_bytes = 8192
    usage.heap_required = true
    usage.core_apis = [String]{"core.encoding.json"}
    usage.mmio = [MMIOAccess]{MMIOAccess{address: 0x40020000, size: ByteSize{bytes: 4}, unsafe_gate: Val(TargetUnsafeGate{reason: "GPIO register write"})}}
    assert(jet_target_machine_validate(target_test_valid_machine(), usage).is_empty())
}
#Test("validation_reports_missing_required_no_os_facts_in_rust_push_order") {
    errors: jet_target_machine_validate(jet_target_machine_bare_metal("", "", "0.0.1"), jet_target_machine_use_default())
    assert_eq(errors, [TargetMachineError]{.MissingTargetTriple, .MissingAllocatorPolicy, .MissingPanicPolicy,
        .MissingMemoryKind{kind: .Flash}, .MissingMemoryKind{kind: .Ram}, .MissingTargetCapability{capability: "Target.MMIO"},
        .MissingTargetCapability{capability: "Time.Wall"}, .MissingTargetCapability{capability: "Time.Monotonic"}, .MissingTargetCapability{capability: "Time.ZoneData"},
        .MissingTargetCapability{capability: "Time.Sleep"}, .MissingTargetCapability{capability: "Rand.Entropy"}, .MissingTargetCapability{capability: "Target.Scheduler"},
        .MissingTargetCapability{capability: "Target.Startup"}, .MissingTargetCapability{capability: "IO.Read"}, .MissingTargetCapability{capability: "IO.Write"}, .MissingTargetCapability{capability: "Panic.Report"}})
}
#Test("validation_reports_ram_heap_core_and_mmio_errors") {
    machine := target_test_valid_machine()
    machine.allocator = .NoAllocator
    usage := jet_target_machine_use_default()
    usage.stack_bytes = 98304
    usage.static_ram_bytes = 65536
    usage.heap_required = true
    usage.core_apis = [String]{"core.files"}
    usage.mmio = [MMIOAccess]{MMIOAccess{address: 0x50000000, size: ByteSize{bytes: 4}, unsafe_gate: None}}
    errors: jet_target_machine_validate(machine, usage)
    assert(errors.contains(.RamOverflow{used_bytes: 163840, ram_bytes: 131072}))
    assert(errors.contains(.HeapRequiresAllocator))
    assert(errors.contains(.CoreAPIUnavailable{api: "core.files", required: .Std, available: .Core}))
    assert(errors.contains(.MMIOOutsideRegion{address: 0x50000000, size_bytes: 4}))
    assert(errors.contains(.MMIOMissingUnsafeGate{address: 0x50000000}))
}
#Test("memory_linker_allocator_bounds_and_order") {
    machine := target_test_valid_machine()
    machine.memory = [MemoryRegion]{
        jet_target_memory_region_new("same", 8, ByteSize{bytes: 8}, .Ram, .Rw),
        jet_target_memory_region_new("same", 8, ByteSize{bytes: 0}, .Flash, .Rx),
        jet_target_memory_region_new("overflow", 18446744073709551615, ByteSize{bytes: 1}, .Reserved, .R),
    }
    errors := [TargetMachineError]{}
    jet_target_validate_memory_regions(machine.memory, errors)
    assert_eq(errors, [TargetMachineError]{.EmptyMemoryRegion{name: "same"}, .DuplicateMemoryRegion{name: "same"}, .MemoryAddressOverflow{name: "overflow"}, .OverlappingMemoryRegions{first: "same", second: "same"}})
    errors = [TargetMachineError]{}
    jet_target_validate_linker(.File{path: " \n", sha256: "sha256:"}, true, errors)
    assert_eq(errors, [TargetMachineError]{.LinkerFileMissingPath, .LinkerFileMissingHash{path: " \n"}})
    jet_target_validate_linker(.Unspecified, true, errors)
    assert(errors.contains(.MissingLinkerInput))
    machine.allocator = .Fixed{region: "absent", size: ByteSize{bytes: 1}}
    errors = [TargetMachineError]{}
    jet_target_validate_allocator(machine, errors)
    assert_eq(errors, [TargetMachineError]{.AllocatorRegionUnknown{region: "absent"}})
    machine.allocator = .Fixed{region: "same", size: ByteSize{bytes: 9}}
    errors = [TargetMachineError]{}
    jet_target_validate_allocator(machine, errors)
    assert_eq(errors, [TargetMachineError]{.AllocatorRegionTooSmall{region: "same", requested_bytes: 9, available_bytes: 8}})
    machine.allocator = .Fixed{region: "overflow", size: ByteSize{bytes: 0}}
    errors = [TargetMachineError]{}
    jet_target_validate_allocator(machine, errors)
    assert_eq(errors, [TargetMachineError]{.AllocatorRegionNotRam{region: "overflow"}})
}
#Test("provider_startup_limits_and_unique_capability_failures") {
    machine := target_test_valid_machine()
    machine.startup_entry = " "
    machine.startup_vectors = ""
    machine.startup_abi.version = "bad version"
    usage := jet_target_machine_use_default()
    usage.required_capabilities = [TargetCapability]{.TimeWall, .TimeWall}
    errors: jet_target_machine_validate(machine, usage)
    assert_eq(errors, [TargetMachineError]{.MissingTargetCapability{capability: "Time.Wall"}, .MissingTargetCapability{capability: "Target.Startup"}, .InvalidProviderContract{capability: "Target.Startup", provider: "test.startup", sha256: "sha256:test-startup"}})
    provider := target_test_provider("test", "sha256:x")
    assert(jet_target_provider_valid(provider))
    provider.sha256 = "sha256:x y"
    assert(!jet_target_provider_valid(provider))
    provider.sha256 = "sha256:x"
    provider.limits.max_calls = Val(0)
    assert(!jet_target_provider_valid(provider))
    provider.limits.max_calls = Val(1)
    provider.abi.calling_convention = "C\t"
    assert(!jet_target_provider_valid(provider))
}
#Test("ram_saturates_mmio_half_open_range_and_gate_order") {
    machine := target_test_valid_machine()
    usage := jet_target_machine_use_default()
    usage.stack_bytes = 18446744073709551615
    usage.static_ram_bytes = 1
    usage.mmio = [MMIOAccess]{MMIOAccess{address: 0x40020400, size: ByteSize{bytes: 0}, unsafe_gate: Val(TargetUnsafeGate{reason: " "})}, MMIOAccess{address: 18446744073709551615, size: ByteSize{bytes: 1}, unsafe_gate: None}}
    errors := [TargetMachineError]{}
    jet_target_validate_ram_budget(machine, usage, errors)
    jet_target_validate_mmio(machine, usage, errors)
    assert_eq(errors, [TargetMachineError]{.RamOverflow{used_bytes: 18446744073709551615, ram_bytes: 131072}, .MMIOEmptyUnsafeReason{address: 0x40020400}, .MMIOOutsideRegion{address: 18446744073709551615, size_bytes: 1}, .MMIOMissingUnsafeGate{address: 18446744073709551615}})
}
#Test("from_core_apis_sorts_dedups_and_derives_capabilities") {
    usage: jet_target_machine_use_from_core_apis([String]{"core.time::sleep", "core.term", "core.mem::Atomic", "core.time::sleep", "core.crypto.uuid"})
    assert_eq(usage.core_apis, [String]{"core.crypto.uuid", "core.mem::Atomic", "core.term", "core.time::sleep"})
    assert_eq(usage.required_capabilities, [TargetCapability]{.Entropy, .Atomic64, .IORead, .IOWrite, .TimeSleep})
    assert(usage.heap_required)
    assert(jet_target_capabilities_for_core_usage("core.time::duration").is_empty())
    assert_eq(jet_target_capabilities_for_core_usage("core.time::elapsed"), [TargetCapability]{.TimeMonotonic})
    assert_eq(jet_target_capabilities_for_core_usage("core.time::zone"), [TargetCapability]{.TimeZoneData})
    assert_eq(jet_target_capabilities_for_core_usage("core.time::now"), [TargetCapability]{.TimeWall})
}
#Test("named_wasm_profiles_have_distinct_provider_identities") {
    browser: jet_target_machine_wasm_browser("0.0.1")
    wasi: jet_target_machine_wasm_wasi("0.0.1")
    no_os: jet_target_machine_wasm_no_os("0.0.1")
    assert_eq(jet_target_environment_identity(browser), "browser")
    assert_eq(jet_target_environment_identity(wasi), "wasi")
    assert_eq(jet_target_environment_identity(no_os), "no-os")
    assert_eq(jet_target_max_runtime_layer(browser), RuntimeLayer.Std)
    assert_eq(jet_target_max_runtime_layer(wasi), RuntimeLayer.Std)
    assert_eq(jet_target_max_runtime_layer(no_os), RuntimeLayer.Core)
    assert(jet_target_provider_identity(browser) != jet_target_provider_identity(wasi))
    assert(jet_target_provider_identity(browser) != jet_target_provider_identity(no_os))
    assert(jet_target_provider_identity(wasi) != jet_target_provider_identity(no_os))
}
// Rust-computed oracle: CLI-37/identity_oracle.py extracts unmodified Rust
// TargetMachine::provider_identity, board constructors, facts; rustc
// CARGO_PKG_VERSION=0.0.1. No Jet values fed to the oracle. The layout
// identities are still the oracle's; the provider identities were re-pinned
// when the provider dossier gained the Target.Memory and Target.Panic facts,
// which the Rust dossier never wrote.
#Test("every_canonical_profile_has_its_pinned_provider_identity_and_layout") {
    names: JET_DRIVER_TARGET_MACHINE_NAMES
    identities: [String]{"c94eeeb976bd7f2aa6397a9c91d541b25f7cef20cffe4e2e236c4c3e3d1edd55", "91fc8913343bc89281090c627489c6652ae4f59d9d82f37cbb67c021176633b3", "8d9efa77f1dec207dbe66f3c30a013c451d073a67760aa12b5a8708ca7f59c7a", "a87a55733ee77be932d10a98b3033e5209deef8fe377ab848f69cac8ab085bdb", "dda8d67fcb7f23e568d5a7450f748b0d8f620339d0de70ede60fc7e963e61d9c", "2b2d619d122cdc33b386b8a15c43bcac46fb10cf795241288cbd88938292dd81"}
    layouts: [String]{"91a97cc8bacffd938bb13162c2d3e4c0bc8db6dff133b96de5c84e5b922ae1cd", "efd3d02a0853cad8c076a0fa6c46ffd0c1612f49ebaf16c3ad599889ec5d0752", "bea44dc183a1d2224200f3a5a8da632f45499e75718a56aecb3544086db39004", "4967f3046b6afcb4470ab962221dd242835cbe81133eea0c2a95dd24c129bf19", "bea44dc183a1d2224200f3a5a8da632f45499e75718a56aecb3544086db39004", "b6d20f41f9c6b9bd94c3239ffcda1a15252d2054e88e04c0626a301c2e81f8d4"}
    loop index in 0..<names.len() {
        machine: jet_driver_target_machine_by_name(names[index], "0.0.1") ?? panic("canonical target missing")
        assert_eq(machine.name, names[index])
        assert(jet_target_machine_validate(machine, jet_target_machine_use_default()).is_empty())
        assert_eq(jet_target_provider_identity(machine), "target-providers-v1:{identities[index]}")
        assert_eq(jet_target_layout_cache_identity(machine.layout), "layout-facts-v2:{layouts[index]}")
    }
    aliases: [String]{"firmware", "sensor", "virt"}
    loop alias in aliases {
        machine: jet_driver_target_machine_by_name(alias, "0.0.1") ?? panic("alias missing")
        canonical: if alias == "virt" -> "board.virt_aarch64" else -> "board.sensor_v1"
        assert_eq(machine.name, canonical)
    }
    assert_eq(jet_driver_target_machine_by_name("unknown", "0.0.1"), None)
    assert_eq(jet_driver_target_machine_by_name("sensor ", "0.0.1"), None)
}

// All 61 Rust enum variants, including variants produced by later hardware
// and firmware callers. Literal expectations are Rust derive(Debug) spelling.
#Test("every_target_machine_error_has_exact_rust_debug_text") {
    assert_eq(jet_target_machine_error_debug(.MissingTargetTriple), "MissingTargetTriple")
    assert_eq(jet_target_machine_error_debug(.MissingMemoryKind{kind: .MMIO}), "MissingMemoryKind {{ kind: Mmio }}")
    assert_eq(jet_target_machine_error_debug(.DuplicateMemoryRegion{name: "a"}), "DuplicateMemoryRegion {{ name: \"a\" }}")
    assert_eq(jet_target_machine_error_debug(.EmptyMemoryRegion{name: "a"}), "EmptyMemoryRegion {{ name: \"a\" }}")
    assert_eq(jet_target_machine_error_debug(.MemoryAddressOverflow{name: "a"}), "MemoryAddressOverflow {{ name: \"a\" }}")
    assert_eq(jet_target_machine_error_debug(.OverlappingMemoryRegions{first: "a", second: "b"}), "OverlappingMemoryRegions {{ first: \"a\", second: \"b\" }}")
    assert_eq(jet_target_machine_error_debug(.MissingLinkerInput), "MissingLinkerInput")
    assert_eq(jet_target_machine_error_debug(.LinkerFileMissingPath), "LinkerFileMissingPath")
    assert_eq(jet_target_machine_error_debug(.LinkerFileMissingHash{path: "a"}), "LinkerFileMissingHash {{ path: \"a\" }}")
    assert_eq(jet_target_machine_error_debug(.MissingAllocatorPolicy), "MissingAllocatorPolicy")
    assert_eq(jet_target_machine_error_debug(.AllocatorRegionUnknown{region: "a"}), "AllocatorRegionUnknown {{ region: \"a\" }}")
    assert_eq(jet_target_machine_error_debug(.AllocatorRegionNotRam{region: "a"}), "AllocatorRegionNotRam {{ region: \"a\" }}")
    assert_eq(jet_target_machine_error_debug(.AllocatorRegionTooSmall{region: "a", requested_bytes: 2, available_bytes: 1}), "AllocatorRegionTooSmall {{ region: \"a\", requested_bytes: 2, available_bytes: 1 }}")
    assert_eq(jet_target_machine_error_debug(.HostedAllocatorRequiresOS), "HostedAllocatorRequiresOs")
    assert_eq(jet_target_machine_error_debug(.MissingPanicPolicy), "MissingPanicPolicy")
    assert_eq(jet_target_machine_error_debug(.MissingTargetCapability{capability: "a"}), "MissingTargetCapability {{ capability: \"a\" }}")
    assert_eq(jet_target_machine_error_debug(.HostedCapabilityRequiresOS{capability: "a"}), "HostedCapabilityRequiresOs {{ capability: \"a\" }}")
    assert_eq(jet_target_machine_error_debug(.InvalidProviderContract{capability: "a", provider: "b", sha256: "c"}), "InvalidProviderContract {{ capability: \"a\", provider: \"b\", sha256: \"c\" }}")
    assert_eq(jet_target_machine_error_debug(.RamOverflow{used_bytes: 2, ram_bytes: 1}), "RamOverflow {{ used_bytes: 2, ram_bytes: 1 }}")
    assert_eq(jet_target_machine_error_debug(.HeapRequiresAllocator), "HeapRequiresAllocator")
    assert_eq(jet_target_machine_error_debug(.CoreAPIUnavailable{api: "a", required: .Alloc, available: .Core}), "CoreApiUnavailable {{ api: \"a\", required: Alloc, available: Core }}")
    assert_eq(jet_target_machine_error_debug(.MMIOOutsideRegion{address: 1, size_bytes: 2}), "MmioOutsideRegion {{ address: 1, size_bytes: 2 }}")
    assert_eq(jet_target_machine_error_debug(.MMIOMissingUnsafeGate{address: 1}), "MmioMissingUnsafeGate {{ address: 1 }}")
    assert_eq(jet_target_machine_error_debug(.MMIOEmptyUnsafeReason{address: 1}), "MmioEmptyUnsafeReason {{ address: 1 }}")
    assert_eq(jet_target_machine_error_debug(.HostedHasNoLinkerScript), "HostedHasNoLinkerScript")
    assert_eq(jet_target_machine_error_debug(.HostedHasNoStartup), "HostedHasNoStartup")
    assert_eq(jet_target_machine_error_debug(.UnsupportedStartupTriple{triple: "a"}), "UnsupportedStartupTriple {{ triple: \"a\" }}")
    assert_eq(jet_target_machine_error_debug(.ExecutionTierUnsupported{tier: "a", machine: "b"}), "ExecutionTierUnsupported {{ tier: \"a\", machine: \"b\" }}")
    assert_eq(jet_target_machine_error_debug(.FirmwareToolchainMissing{tool: "a"}), "FirmwareToolchainMissing {{ tool: \"a\" }}")
    assert_eq(jet_target_machine_error_debug(.FirmwareBuildFailed{detail: "a"}), "FirmwareBuildFailed {{ detail: \"a\" }}")
    assert_eq(jet_target_machine_error_debug(.SizeBudgetExceeded{report: SizeBudgetReport{artifact_bytes: 1, flash_bytes: 2, flash_ok: true, ram_bytes: 3, ram_used_bytes: 4, ram_ok: false}}), "SizeBudgetExceeded {{ report: SizeBudgetReport {{ artifact_bytes: 1, flash_bytes: 2, flash_ok: true, ram_bytes: 3, ram_used_bytes: 4, ram_ok: false }} }}")
    assert_eq(jet_target_machine_error_debug(.HardwareFactsMissingSVD), "HardwareFactsMissingSvd")
    assert_eq(jet_target_machine_error_debug(.InvalidHardwareSVD{source: "a", sha256: "b"}), "InvalidHardwareSvd {{ source: \"a\", sha256: \"b\" }}")
    assert_eq(jet_target_machine_error_debug(.HardwareFactEmptyName{kind: "a"}), "HardwareFactEmptyName {{ kind: \"a\" }}")
    assert_eq(jet_target_machine_error_debug(.DuplicateRegisterBlock{name: "a"}), "DuplicateRegisterBlock {{ name: \"a\" }}")
    assert_eq(jet_target_machine_error_debug(.RegisterBlockEmpty{name: "a"}), "RegisterBlockEmpty {{ name: \"a\" }}")
    assert_eq(jet_target_machine_error_debug(.RegisterBlockAddressOverflow{name: "a"}), "RegisterBlockAddressOverflow {{ name: \"a\" }}")
    assert_eq(jet_target_machine_error_debug(.RegisterBlockOutsideRegion{name: "a", address: 1, size_bytes: 2}), "RegisterBlockOutsideRegion {{ name: \"a\", address: 1, size_bytes: 2 }}")
    assert_eq(jet_target_machine_error_debug(.DuplicateRegister{block: "a", register: "b"}), "DuplicateRegister {{ block: \"a\", register: \"b\" }}")
    assert_eq(jet_target_machine_error_debug(.RegisterAddressOverflow{block: "a", register: "b"}), "RegisterAddressOverflow {{ block: \"a\", register: \"b\" }}")
    assert_eq(jet_target_machine_error_debug(.RegisterOutsideBlock{block: "a", register: "b"}), "RegisterOutsideBlock {{ block: \"a\", register: \"b\" }}")
    assert_eq(jet_target_machine_error_debug(.UnknownRegisterBlock{block: "a"}), "UnknownRegisterBlock {{ block: \"a\" }}")
    assert_eq(jet_target_machine_error_debug(.UnknownRegister{block: "a", register: "b"}), "UnknownRegister {{ block: \"a\", register: \"b\" }}")
    assert_eq(jet_target_machine_error_debug(.RegisterWidthMismatch{block: "a", register: "b", expected: .U8, actual: .U64}), "RegisterWidthMismatch {{ block: \"a\", register: \"b\", expected: U8, actual: U64 }}")
    assert_eq(jet_target_machine_error_debug(.RegisterReadDenied{block: "a", register: "b"}), "RegisterReadDenied {{ block: \"a\", register: \"b\" }}")
    assert_eq(jet_target_machine_error_debug(.RegisterWriteDenied{block: "a", register: "b"}), "RegisterWriteDenied {{ block: \"a\", register: \"b\" }}")
    assert_eq(jet_target_machine_error_debug(.DuplicateInterrupt{name: "a"}), "DuplicateInterrupt {{ name: \"a\" }}")
    assert_eq(jet_target_machine_error_debug(.DuplicateInterruptVector{vector: 1}), "DuplicateInterruptVector {{ vector: 1 }}")
    assert_eq(jet_target_machine_error_debug(.InvalidInterruptEffect{interrupt: "a", effect_name: "b"}), "InvalidInterruptEffect {{ interrupt: \"a\", effect: \"b\" }}")
    assert_eq(jet_target_machine_error_debug(.UnknownInterrupt{interrupt: "a"}), "UnknownInterrupt {{ interrupt: \"a\" }}")
    assert_eq(jet_target_machine_error_debug(.InterruptEffectForbidden{interrupt: "a", handler: "b", effect_name: "c"}), "InterruptEffectForbidden {{ interrupt: \"a\", handler: \"b\", effect: \"c\" }}")
    assert_eq(jet_target_machine_error_debug(.InterruptHandlerUnbounded{interrupt: "a", handler: "b"}), "InterruptHandlerUnbounded {{ interrupt: \"a\", handler: \"b\" }}")
    assert_eq(jet_target_machine_error_debug(.DuplicateDMAChannel{name: "a"}), "DuplicateDmaChannel {{ name: \"a\" }}")
    assert_eq(jet_target_machine_error_debug(.DuplicateDMAChannelNumber{channel: 1}), "DuplicateDmaChannelNumber {{ channel: 1 }}")
    assert_eq(jet_target_machine_error_debug(.DMATransferSizeZero{channel: "a"}), "DmaTransferSizeZero {{ channel: \"a\" }}")
    assert_eq(jet_target_machine_error_debug(.UnknownDMAChannel{channel: "a"}), "UnknownDmaChannel {{ channel: \"a\" }}")
    assert_eq(jet_target_machine_error_debug(.DMAOwnershipMismatch{channel: "a", buffer: "b", expected: .CPU, actual: .Device}), "DmaOwnershipMismatch {{ channel: \"a\", buffer: \"b\", expected: Cpu, actual: Device }}")
    assert_eq(jet_target_machine_error_debug(.DMAStartWhileInFlight{channel: "a", buffer: "b"}), "DmaStartWhileInFlight {{ channel: \"a\", buffer: \"b\" }}")
    assert_eq(jet_target_machine_error_debug(.DMAWaitWithoutTransfer{channel: "a", buffer: "b"}), "DmaWaitWithoutTransfer {{ channel: \"a\", buffer: \"b\" }}")
    assert_eq(jet_target_machine_error_debug(.DMABufferUnavailable{channel: "a", buffer: "b"}), "DmaBufferUnavailable {{ channel: \"a\", buffer: \"b\" }}")
    assert_eq(jet_target_machine_error_debug(.DMAWaitChannelMismatch{channel: "a", buffer: "b"}), "DmaWaitChannelMismatch {{ channel: \"a\", buffer: \"b\" }}")
    assert_eq(jet_target_machine_errors_debug([TargetMachineError]{.FirmwareBuildFailed{detail: "a\n\"\\\t"}, .MissingTargetTriple}), "[FirmwareBuildFailed {{ detail: \"a\\n\\\"\\\\\\t\" }}, MissingTargetTriple]")
    assert_eq(jet_target_machine_errors_debug([TargetMachineError]{}), "[]")
}

// Rust TargetHardwareFacts::validate_into: every push site and precedence.
#Test("hardware_validation_preserves_all_fact_errors_in_order") {
    hardware := jet_target_hardware_empty()
    hardware.svd = Val(SVDProvenance{source: "", sha256: "invalid"})
    empty: TargetRegisterFact{name: "", offset: 18446744073709551615, width: .U64, access: .ReadWrite, volatile: true}
    outside: TargetRegisterFact{name: "", offset: 0, width: .U32, access: .ReadWrite, volatile: true}
    hardware.register_blocks = [TargetRegisterBlockFact]{
        {name: "", base: 18446744073709551615, size: ByteSize{bytes: 1}, registers: [TargetRegisterFact]{empty, outside}},
        {name: "", base: 0, size: ByteSize{bytes: 0}, registers: [TargetRegisterFact]{}},
    }
    hardware.interrupts = [TargetInterruptFact]{
        {name: "", vector: 1, forbidden_effects: [String]{"bogus", "FS.Read"}, bounded: true},
        {name: "", vector: 1, forbidden_effects: [String]{}, bounded: false},
    }
    hardware.dma_channels = [TargetDMAChannelFact]{
        {name: "", channel: 1, transfer_width: .U8, ownership: .Borrowed, max_transfer_bytes: Val(0)},
        {name: "", channel: 1, transfer_width: .U8, ownership: .Transfer, max_transfer_bytes: None},
    }
    errors: jet_target_hardware_validate(hardware, [MemoryRegion]{})
    assert_eq(errors, [TargetMachineError]{
        .InvalidHardwareSVD{source: "", sha256: "invalid"}, .HardwareFactEmptyName{kind: "register block"},
        .RegisterBlockAddressOverflow{name: ""}, .HardwareFactEmptyName{kind: "register in ``"},
        .RegisterAddressOverflow{block: "", register: ""}, .HardwareFactEmptyName{kind: "register in ``"},
        .DuplicateRegister{block: "", register: ""}, .RegisterOutsideBlock{block: "", register: ""},
        .HardwareFactEmptyName{kind: "register block"}, .DuplicateRegisterBlock{name: ""}, .RegisterBlockEmpty{name: ""},
        .RegisterBlockOutsideRegion{name: "", address: 0, size_bytes: 0},
        .HardwareFactEmptyName{kind: "interrupt"}, .InvalidInterruptEffect{interrupt: "", effect_name: "bogus"},
        .HardwareFactEmptyName{kind: "interrupt"}, .DuplicateInterrupt{name: ""}, .DuplicateInterruptVector{vector: 1},
        .HardwareFactEmptyName{kind: "DMA channel"}, .DMATransferSizeZero{channel: ""},
        .HardwareFactEmptyName{kind: "DMA channel"}, .DuplicateDMAChannel{name: ""}, .DuplicateDMAChannelNumber{channel: 1},
    })
}

#Test("hosted_boundary_policies_and_panic_sink_preserve_unique_order") {
    machine := jet_target_machine_wasm_no_os("0.0.1")
    machine.mmio = .HostedDefault
    machine.wall_clock = .HostedDefault
    machine.monotonic_clock = .HostedDefault
    machine.zone_data = .HostedDefault
    machine.sleep = .HostedDefault
    machine.entropy = .HostedDefault
    machine.scheduler = .HostedDefault
    machine.startup = .HostedDefault
    machine.byte_sink = .HostedDefault
    errors: jet_target_machine_validate(machine, jet_target_machine_use_default())
    assert_eq(errors, [TargetMachineError]{
        .HostedCapabilityRequiresOS{capability: "Target.MMIO"}, .HostedCapabilityRequiresOS{capability: "Time.Wall"},
        .HostedCapabilityRequiresOS{capability: "Time.Monotonic"}, .HostedCapabilityRequiresOS{capability: "Time.ZoneData"},
        .HostedCapabilityRequiresOS{capability: "Time.Sleep"}, .HostedCapabilityRequiresOS{capability: "Rand.Entropy"},
        .HostedCapabilityRequiresOS{capability: "Target.Scheduler"}, .HostedCapabilityRequiresOS{capability: "Target.Startup"},
        .HostedCapabilityRequiresOS{capability: "IO.Read"}, .HostedCapabilityRequiresOS{capability: "IO.Write"}, .HostedCapabilityRequiresOS{capability: "Panic.Report"},
    })
    machine = jet_target_machine_wasm_no_os("0.0.1")
    invalid: target_test_provider("", "invalid")
    machine.panic = .Report{provider: invalid}
    machine.byte_sink = .Provider{read: Val(invalid), write: Val(invalid), report: None}
    usage := jet_target_machine_use_default()
    usage.required_capabilities = [TargetCapability]{.PanicReport, .PanicReport}
    assert_eq(jet_target_machine_validate(machine, usage), [TargetMachineError]{
        .InvalidProviderContract{capability: "Panic.Report", provider: "", sha256: "invalid"},
        .InvalidProviderContract{capability: "IO.Read", provider: "", sha256: "invalid"},
        .InvalidProviderContract{capability: "IO.Write", provider: "", sha256: "invalid"},
        .MissingTargetCapability{capability: "Panic.Report"},
    })
}

#Test("whitespace_and_split_once_match_rust_unicode_boundaries") {
    spaces: [String]{"\t", "\n", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ", "　"}
    loop space in spaces -> assert(!jet_target_no_whitespace("a{space}b"))
    ascii: [Int]{9, 10, 11, 12, 13, 32}
    loop code in ascii {
        space: String.from_bytes([U8]{U8{code}}) ?? panic("ASCII whitespace")
        assert(!jet_target_no_whitespace(space))
    }
    assert(!jet_target_no_whitespace(String.from_bytes([U8]{194, 133}) ?? panic("NEL")))
    assert(!jet_target_no_whitespace(String.from_bytes([U8]{226, 128, 168}) ?? panic("LS")))
    assert(!jet_target_no_whitespace(String.from_bytes([U8]{226, 128, 169}) ?? panic("PS")))
    assert(jet_target_no_whitespace("ä字😀"))
    assert(jet_target_no_whitespace("​"))
    assert_eq(jet_target_capabilities_for_core_usage("core.time::sleep::extra"), [TargetCapability]{.TimeWall})
    assert(jet_target_capabilities_for_core_usage("core.mem::Atomic::extra").is_empty())
    assert(jet_target_capabilities_for_core_usage("").is_empty())
}

// Rust SvdProvenance::is_valid is deliberately weaker than ProviderContract.
#Test("svd_digest_and_effect_set_keep_their_distinct_rust_contracts") {
    hardware := jet_target_hardware_empty()
    hardware.svd = Val(SVDProvenance{source: "vendor.svd", sha256: "sha256:a b"})
    assert(jet_target_hardware_validate(hardware, [MemoryRegion]{}).is_empty())
    assert(!jet_target_provider_valid(target_test_provider("provider", "sha256:a b")))
    hardware.interrupts = [TargetInterruptFact]{
        {name: "IRQ", vector: 1, forbidden_effects: [String]{"z-invalid", "a-invalid", "z-invalid"}, bounded: true},
    }
    assert_eq(jet_target_hardware_validate(hardware, [MemoryRegion]{}), [TargetMachineError]{
        .InvalidInterruptEffect{interrupt: "IRQ", effect_name: "a-invalid"},
        .InvalidInterruptEffect{interrupt: "IRQ", effect_name: "z-invalid"},
    })
}

// Main/Pip CLI-37 ruling: sum RAM facts exactly; Rust's u64 accumulator
// wrapping is a latent defect (tandem Rust u128 fix belongs to integration).
// Used bytes still saturate at u64::MAX, so a greater RAM total cannot overflow
// the RAM budget. In particular MAX + 2 must not become a one-byte budget.
#Test("ram_region_totals_above_u64_max_keep_the_true_budget") {
    machine := jet_target_machine_wasm_no_os("0.0.1")
    machine.memory = [MemoryRegion]{
        jet_target_memory_region_new("flash", 0, ByteSize{bytes: 1}, .Flash, .Rx),
        jet_target_memory_region_new("ram.first", 0, ByteSize{bytes: 18446744073709551615}, .Ram, .Rw),
        jet_target_memory_region_new("ram.second", 0, ByteSize{bytes: 2}, .Ram, .Rw),
    }
    usage := jet_target_machine_use_default()
    usage.stack_bytes = 18446744073709551615
    usage.static_ram_bytes = 1
    errors := [TargetMachineError]{}
    jet_target_validate_ram_budget(machine, usage, errors)
    assert(errors.is_empty())
}

// Rust target_machines.rs sensor_machine: board.sensor_v1 with the MMIO range
// the compile-path volatile tests use and an explicit linker and allocator.
target_test_sensor_machine: fn() -> TargetMachine Never! {
    machine := jet_target_machine_board_sensor_v1("0.0.1")
    machine.memory = [MemoryRegion]{
        jet_target_memory_region_new("flash", 0x08000000, ByteSize{bytes: 524288}, .Flash, .Rx),
        jet_target_memory_region_new("ram", 0x20000000, ByteSize{bytes: 65536}, .Ram, .Rw),
        jet_target_memory_region_new("peripherals", 0x40000000, ByteSize{bytes: 1048576}, .MMIO, .Rw),
    }
    machine.linker = .File{path: "vendor/memory.x", sha256: "sha256:abc123"}
    machine.allocator = .Fixed{region: "ram", size: ByteSize{bytes: 8192}}
    machine.panic = .Abort
    machine
}
target_test_named_provider: fn(name: String) -> ProviderContract Never! {
    target_test_provider("tests.target.{name}", "sha256:tests-target-{name}")
}
// The sensor machine with `provider` behind `capability`.
target_test_set_provider: fn(capability: TargetCapability, provider: ProviderContract) -> TargetMachine Never! {
    machine := target_test_sensor_machine()
    read: target_test_named_provider("io-read")
    write: target_test_named_provider("io-write")
    report: target_test_named_provider("panic-report")
    if capability == {
        .MMIO -> machine.mmio = .Provider{provider: provider}
        .TimeWall -> machine.wall_clock = .Provider{provider: provider}
        .TimeMonotonic -> machine.monotonic_clock = .Provider{provider: provider}
        .TimeZoneData -> machine.zone_data = .Provider{provider: provider}
        .TimeSleep -> machine.sleep = .Provider{provider: provider}
        .Entropy -> machine.entropy = .Provider{provider: provider}
        .Scheduler -> machine.scheduler = .Cooperative{provider: provider}
        .IORead -> machine.byte_sink = .Provider{read: Val(provider), write: Val(write), report: Val(report)}
        .IOWrite -> machine.byte_sink = .Provider{read: Val(read), write: Val(provider), report: Val(report)}
        .PanicReport -> machine.byte_sink = .Provider{read: Val(read), write: Val(write), report: Val(provider)}
        .Allocator -> machine.allocator = .Provider{provider: provider}
        .Startup -> machine.startup = .Generated{provider: provider}
        else -> panic("no provider fact case for {jet_target_capability_name(capability)}")
    }
    machine
}
// The sensor machine with no provider behind `capability`.
target_test_clear_provider: fn(capability: TargetCapability) -> TargetMachine Never! {
    machine := target_test_sensor_machine()
    read: Val(target_test_named_provider("io-read"))
    write: Val(target_test_named_provider("io-write"))
    report: Val(target_test_named_provider("panic-report"))
    if capability == {
        .MMIO -> machine.mmio = .NoMMIO
        .TimeWall -> machine.wall_clock = .NoClock
        .TimeMonotonic -> machine.monotonic_clock = .NoClock
        .TimeZoneData -> machine.zone_data = .NoClock
        .TimeSleep -> machine.sleep = .NoClock
        .Entropy -> machine.entropy = .NoEntropy
        .Scheduler -> machine.scheduler = .NoScheduler
        .IORead -> machine.byte_sink = .Provider{read: None, write: write, report: report}
        .IOWrite -> machine.byte_sink = .Provider{read: read, write: None, report: report}
        .PanicReport -> machine.byte_sink = .Provider{read: read, write: write, report: None}
        .Allocator -> machine.allocator = .NoAllocator
        .Startup -> machine.startup = .Unspecified
        else -> panic("no provider fact case for {jet_target_capability_name(capability)}")
    }
    machine
}
target_test_has_code: fn(diagnostics: [Diagnostic], code: String) -> Bool Never! {
    loop diagnostic in diagnostics {
        if diagnostic.code == code -> return true
    }
    false
}
target_test_has_invalid_provider: fn(errors: [TargetMachineError], capability: TargetCapability) -> Bool Never! {
    loop error in errors {
        if error == .InvalidProviderContract(found, _, _) && found == jet_target_capability_name(capability) -> return true
    }
    false
}
target_test_assert_row: fn(diagnostics: [Diagnostic], code: String, what: String, why: String, fix: String) Never! {
    loop diagnostic in diagnostics {
        if diagnostic.code == code {
            assert_eq(diagnostic.what, what)
            assert_eq(diagnostic.why, why)
            assert_eq(diagnostic.fix, fix)
            return
        }
    }
    panic("missing {code} diagnostic")
}

// Rust jet-sema TargetMachine.rs target_machine_rows_are_registered_and_stable.
#Test("target_machine_rows_are_registered_and_stable") {
    machine := jet_target_machine_wasm_no_os("0.0.1")
    target_test_assert_row(jet_target_machine_diagnostics(machine, jet_target_machine_use_from_core_apis([String]{"core.files"})), "E3310",
        "Prelude part `core.files` needs the `hosted` runtime layer, but target `wasm.no-os` provides `core`.",
        "The complete semantic Prelude closure includes `core.files`; a target cannot emit a higher layer or substitute a second Prelude.",
        "Select a typed target with `hosted` support, or remove `core.files` from the reachable closure.")
    wall := jet_target_machine_use_default()
    wall.required_capabilities = [TargetCapability]{.TimeWall}
    target_test_assert_row(jet_target_machine_diagnostics(machine, wall), "E3311",
        "Target `wasm.no-os` lacks the required `Time.Wall` capability.",
        "The selected target profile must state each machine service separately; a target triple cannot imply a UART, clock, entropy source, scheduler, allocator, startup provider, or MMIO device.",
        "Select a typed target profile with a `Time.Wall` provider, or remove the reachable operation.")
    invalid_provider := jet_target_machine_wasm_no_os("0.0.1")
    invalid_provider.monotonic_clock = .Provider{provider: target_test_provider("", "not-a-digest")}
    monotonic := jet_target_machine_use_default()
    monotonic.required_capabilities = [TargetCapability]{.TimeMonotonic}
    target_test_assert_row(jet_target_machine_diagnostics(invalid_provider, monotonic), "E3312",
        "Provider `` for `Time.Monotonic` on target `wasm.no-os` has invalid digest `not-a-digest`.",
        "Every selected provider needs a stable identity and sha256 provenance so artifacts cannot reuse changed target behavior.",
        "Declare a nonempty provider identity and a `sha256:` digest for `Time.Monotonic`.")
    mmio := jet_target_machine_use_default()
    mmio.mmio = [MMIOAccess]{MMIOAccess{address: 0x10, size: ByteSize{bytes: 4}, unsafe_gate: Val(TargetUnsafeGate{reason: "probe"})}}
    target_test_assert_row(jet_target_machine_diagnostics(machine, mmio), "E3313",
        "Target `wasm.no-os` has an MMIO fact failure: address 0x10 (4 bytes) is outside a declared MMIO region.",
        "MMIO addresses must lie inside a declared MMIO region and every access must carry a nonempty `#Unsafe` reason.",
        "Declare a matching MMIO provider and region, then place the access inside `#Unsafe(\"reason\")`.")
    target_test_assert_row(jet_target_machine_diagnostics(jet_target_machine_bare_metal("broken", "", "0.0.1"), jet_target_machine_use_default()), "E3314",
        "Target `broken` has an invalid `target triple` fact: the selected target triple is empty.",
        "Target memory, linker, allocator, panic, startup, and execution facts are explicit inputs to sema and cannot be recovered safely from a triple.",
        "Select a complete typed target profile and correct the `target triple` declaration.")
}

// Rust target_machines.rs target_provider_fact_matrix_covers_present_missing_and_malformed.
#Test("target_provider_fact_matrix_covers_present_missing_and_malformed") {
    names: [String]{"MMIO", "Time.Wall", "Time.Monotonic", "Time.ZoneData", "Time.Sleep", "Rand.Entropy", "Target.Scheduler", "IO.Read", "IO.Write", "Panic.Report", "Target.Allocator", "Target.Startup"}
    capabilities: [TargetCapability]{.MMIO, .TimeWall, .TimeMonotonic, .TimeZoneData, .TimeSleep, .Entropy, .Scheduler, .IORead, .IOWrite, .PanicReport, .Allocator, .Startup}
    malformed_providers: [ProviderContract]{target_test_provider("", "not-a-digest"), target_test_provider("tests.target.invalid", ""), target_test_provider("tests.target.invalid", "sha256:")}
    loop (at, capability) in capabilities {
        usage := jet_target_machine_use_default()
        usage.required_capabilities = [TargetCapability]{capability}
        if capability == .Allocator -> usage.heap_required = true
        present: target_test_set_provider(capability, target_test_named_provider(names[at]))
        assert_eq(jet_target_machine_errors_debug(jet_target_machine_validate(present, usage)), "[]")
        assert(jet_target_machine_diagnostics(present, usage).is_empty())
        missing: target_test_clear_provider(capability)
        errors: jet_target_machine_validate(missing, usage)
        if capability == .Allocator {
            assert(errors.contains(.HeapRequiresAllocator))
            assert(target_test_has_code(jet_target_machine_diagnostics(missing, usage), "E3303"))
        } else {
            assert(errors.contains(.MissingTargetCapability{capability: jet_target_capability_name(capability)}))
            assert(target_test_has_code(jet_target_machine_diagnostics(missing, usage), "E3311"))
        }
        loop provider in malformed_providers {
            malformed: target_test_set_provider(capability, provider)
            assert(target_test_has_invalid_provider(jet_target_machine_validate(malformed, usage), capability))
            assert(target_test_has_code(jet_target_machine_diagnostics(malformed, usage), "E3312"))
        }
    }
}

// Rust target_machines.rs panic_policy_matrix_covers_explicit_missing_and_malformed.
#Test("panic_policy_matrix_covers_explicit_missing_and_malformed") {
    usage: jet_target_machine_use_default()
    present := target_test_sensor_machine()
    present.panic = .Abort
    assert(jet_target_machine_validate(present, usage).is_empty())
    assert(jet_target_machine_diagnostics(present, usage).is_empty())
    missing := target_test_sensor_machine()
    missing.panic = .Unspecified
    assert(jet_target_machine_validate(missing, usage).contains(.MissingPanicPolicy))
    assert(target_test_has_code(jet_target_machine_diagnostics(missing, usage), "E3314"))
    malformed := target_test_sensor_machine()
    malformed.panic = .Report{provider: target_test_provider("", "not-a-digest")}
    assert(target_test_has_invalid_provider(jet_target_machine_validate(malformed, usage), .PanicReport))
    assert(target_test_has_code(jet_target_machine_diagnostics(malformed, usage), "E3312"))
}

// Rust target_machines.rs no_os_machine_rejects_dev_explicitly (data half):
// a no-OS machine refuses the Dev tier and keeps AOT; hosted keeps both.
#Test("no_os_machine_rejects_dev_explicitly") {
    sensor: target_test_sensor_machine()
    assert_eq(jet_target_machine_supports_execution_tier(sensor, .Dev), TargetMachineError?{Val(.ExecutionTierUnsupported{tier: "dev", machine: "board.sensor_v1"})})
    assert_eq(jet_target_machine_supports_execution_tier(sensor, .AOT), TargetMachineError?{None})
    hosted: jet_target_machine_hosted("x86_64-unknown-linux-gnu", "0.0.1")
    assert_eq(jet_target_machine_supports_execution_tier(hosted, .Dev), TargetMachineError?{None})
    refusal: jet_target_machine_error_diagnostic(sensor, .ExecutionTierUnsupported{tier: "dev", machine: "board.sensor_v1"})
    assert_eq(refusal.code, "E3314")
    assert_eq(refusal.what, "Target `board.sensor_v1` has an invalid `execution` fact: target machine `board.sensor_v1` does not support the `dev` tier.")
}

// `build.target.os` folds each OS-less machine on its own OS, not the host's.
#Test("build_os_folds_web_wasm_and_no_os_machines_on_their_own_os") {
    assert_eq(jet_target_active_os_name(jet_target_machine_wasm_browser("0.0.1"), "linux"), "Web")
    assert_eq(jet_target_active_os_name(jet_target_machine_wasm_wasi("0.0.1"), "linux"), "Wasm")
    assert_eq(jet_target_active_os_name(jet_target_machine_wasm_no_os("0.0.1"), "linux"), "Freestanding")
    assert_eq(jet_target_active_os_name(target_test_sensor_machine(), "macos"), "Freestanding")
    assert_eq(jet_target_active_os_name(jet_target_machine_hosted("aarch64-apple-darwin", "0.0.1"), "linux"), "MacOS")
    assert_eq(jet_target_active_os_name(jet_target_machine_hosted("x86_64-unknown-linux-gnu", "0.0.1"), "macos"), "Linux")
    assert_eq(jet_target_active_os_name(jet_target_machine_hosted("riscv64gc-unknown-unknown", "0.0.1"), "windows"), "Windows")
}

// Target.Memory and Target.Panic are declared capabilities: a hosted machine
// provides both, a no-OS machine provides them only through a RAM region and
// an explicit panic policy, and a use that requires them is checked.
#Test("memory_and_panic_are_checked_target_capabilities") {
    assert(jet_target_machine_provides_capability(jet_target_machine_hosted("x86_64-unknown-linux-gnu", "0.0.1"), .Memory))
    assert(jet_target_machine_provides_capability(jet_target_machine_hosted("x86_64-unknown-linux-gnu", "0.0.1"), .Panic))
    machine := target_test_valid_machine()
    assert(jet_target_machine_provides_capability(machine, .Memory))
    assert(jet_target_machine_provides_capability(machine, .Panic))
    usage := jet_target_machine_use_default()
    usage.required_capabilities = [TargetCapability]{.Memory, .Panic}
    errors: jet_target_machine_validate(machine, usage)
    assert(!errors.contains(.MissingTargetCapability{capability: "Target.Memory"}))
    assert(!errors.contains(.MissingTargetCapability{capability: "Target.Panic"}))
    bare := target_test_valid_machine()
    bare.memory = [MemoryRegion]{jet_target_memory_region_new("flash", 0x08000000, ByteSize{bytes: 524288}, .Flash, .Rx)}
    bare.allocator = .Unspecified
    bare.panic = .Unspecified
    assert(!jet_target_machine_provides_capability(bare, .Memory))
    assert(!jet_target_machine_provides_capability(bare, .Panic))
    missing: jet_target_machine_validate(bare, usage)
    assert(missing.contains(.MissingTargetCapability{capability: "Target.Memory"}))
    assert(missing.contains(.MissingTargetCapability{capability: "Target.Panic"}))
    assert_eq(jet_target_capability_name(.Memory), "Target.Memory")
    assert_eq(jet_target_capability_name(.Panic), "Target.Panic")
}
