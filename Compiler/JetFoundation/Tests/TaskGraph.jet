// The compiler task schedule (TaskGraph.jet): each node starts after the
// nodes it waits on, a run's results are the same for any thread count, and
// a traced run writes one span per node.
use {
    graph_files: core.files
    graph_process: core.process
    graph_sys: core.sys
    jet_foundation.[
        CompilerTaskClock,
        CompilerTaskGraph,
        CompilerTaskSpan,
        CompilerTaskStart,
        CompilerTaskTraceSink,
        CompilerThreads,
        compiler_task_clock,
        compiler_task_clock_start,
        compiler_task_clock_stop,
        compiler_task_graph,
        compiler_task_graph_wait,
        compiler_task_graph_weigh,
        compiler_task_schedule,
        compiler_task_schedule_done,
        compiler_task_schedule_finish,
        compiler_task_schedule_next,
        compiler_task_schedule_stuck,
        compiler_task_trace,
        compiler_threads_single,
    ]
}

// Five nodes: 3 waits on 0 and 1, 4 on 3 (the edge added twice), node 1
// weighs 9 and node 2 weighs 5.
graph_small: fn() -> CompilerTaskGraph Never! {
    graph := compiler_task_graph(5)
    compiler_task_graph_wait(graph, 3, 0)
    compiler_task_graph_wait(graph, 3, 1)
    compiler_task_graph_wait(graph, 4, 3)
    compiler_task_graph_wait(graph, 4, 3)
    compiler_task_graph_weigh(graph, 1, 9)
    compiler_task_graph_weigh(graph, 2, 5)
    graph
}

// The nodes one slot runs `graph`, which it takes, in, until the run is done
// or stuck.
graph_order: fn(graph: &&CompilerTaskGraph) -> [Int] Never! {
    schedule := compiler_task_schedule(graph, compiler_threads_single())
    order := [Int]{}
    loop compiler_task_schedule_next(schedule) == .Val(start) {
        order.push(start.node)
        compiler_task_schedule_finish(schedule, start)
    }
    order
}

#Test("a task schedule starts each node after the nodes it waits on, heaviest ready first") {
    counted: graph_small()
    assert_eq(counted.waits[4], 1)
    assert_eq(graph_order(graph_small()), [Int]{1, 2, 0, 3, 4})
    cycle := graph_small()
    compiler_task_graph_wait(cycle, 0, 4)
    schedule := compiler_task_schedule(cycle, compiler_threads_single())
    assert(!compiler_task_schedule_stuck(schedule))
    loop compiler_task_schedule_next(schedule) == .Val(start) {
        compiler_task_schedule_finish(schedule, start)
    }
    assert(compiler_task_schedule_stuck(schedule))
    assert(!compiler_task_schedule_done(schedule))
}

// A graph's nodes, their bases and the nodes each waits on.
GraphTestCase: struct {
    graph: CompilerTaskGraph,
    base: [Int],
    waits_on: [[Int]],
}

// 300 nodes: from node 3 each waits on a third of itself, from node 100 also
// on the node 50 before it; weights cycle through 0..<11.
graph_wide: fn() -> GraphTestCase Never! {
    count: 300
    case := GraphTestCase{graph: compiler_task_graph(count), base: [Int]{}, waits_on: [[Int]]{}}
    loop node in 0..<count {
        case.base.push(node % 7)
        case.waits_on.push([Int]{})
        if node >= 3 {
            compiler_task_graph_wait(case.graph, node, node /% 3)
            case.waits_on[node].push(node /% 3)
        }
        if node >= 100 {
            compiler_task_graph_wait(case.graph, node, node - 50)
            case.waits_on[node].push(node - 50)
        }
        compiler_task_graph_weigh(case.graph, node, node % 11)
    }
    case
}

// 40 nodes, each from node 1 waiting on half of itself.
graph_halves: fn() -> GraphTestCase Never! {
    count: 40
    case := GraphTestCase{graph: compiler_task_graph(count), base: [Int]{}, waits_on: [[Int]]{}}
    loop node in 0..<count {
        case.base.push(node)
        case.waits_on.push([Int]{})
        if node >= 1 {
            compiler_task_graph_wait(case.graph, node, node /% 2)
            case.waits_on[node].push(node /% 2)
        }
    }
    case
}

// A finished test node: its value and when it ran.
GraphTestRan: struct {
    start: CompilerTaskStart,
    value: Int,
    span: CompilerTaskSpan,
}

// A test node's task: its value is its base plus `inputs`, the values of the
// nodes it waits on.
graph_test_node: fn(start: CompilerTaskStart, base: Int, inputs: [Int], clock: CompilerTaskClock, done: Sender<GraphTestRan>) {
    started: compiler_task_clock_start(clock)
    total := base
    loop value in inputs -> total += value
    done.send(GraphTestRan{start: start, value: total, span: compiler_task_clock_stop(started)}) ?? panic("the test run closed before node {start.node} finished")
}

// The values a run over `case`, which it takes, leaves, in node order: the
// coordinator a phase keeps, as TaskGraph.jet lays it out.
graph_test_run: fn(case: &&GraphTestCase, threads: CompilerThreads, trace_sink: CompilerTaskTraceSink?) -> [Int] {
    values := [Int?]{}
    loop _ in 0..<case.base.len() -> values.push(None)
    schedule := compiler_task_schedule(case.graph, threads)
    { sender: done, receiver: finished }: channel<GraphTestRan>()
    task.group nodes(limit: schedule.workers) {
        loop !compiler_task_schedule_done(schedule) {
            if compiler_task_schedule_next(schedule) == .Val(start) {
                inputs := [Int]{}
                loop on in case.waits_on[start.node] {
                    inputs.push(values[on] ?? panic("node {start.node} started before node {on} finished"))
                }
                clock: compiler_task_clock(trace_sink)
                task graph_test_node(start, case.base[start.node], inputs, clock, done)
                next
            }
            if compiler_task_schedule_stuck(schedule) -> panic("the test graph waits in a cycle")
            ran: finished.receive() ?? panic("the test run lost a finished node")
            compiler_task_schedule_finish(schedule, ran.start)
            values[ran.start.node] = Val(ran.value)
            compiler_task_trace(trace_sink, "test.node", "node {ran.start.node}", ran.start, ran.span)
        }
    }
    out := [Int]{}
    loop value in values -> out.push(value ?? panic("a node left no value"))
    out
}

graph_threads: fn(width: Int) -> CompilerThreads Never! {
    CompilerThreads{cap: Val(width), cores: width, memory_available: None}
}

#Test("a task schedule runs each node after the nodes it waits on, alike for any thread count") {
    one: graph_test_run(graph_wide(), compiler_threads_single(), None)
    assert_eq(one[0], 0)
    assert_eq(one[9], 2 + one[3])
    assert_eq(one[150], 3 + one[50] + one[100])
    widths: [Int]{2, 8, 32}
    loop width in widths {
        assert_eq(graph_test_run(graph_wide(), graph_threads(width), None), one)
    }
}

// A trace sink that appends each node span's label and slot to `path`, one
// line each.
GraphTestSink: struct {
    path: String,

    impl CompilerTaskTraceSink {
        span: fn(self, name: String, detail: String, slot: Int, start_us: Int, end_us: Int, cpu_ns: Int) -[FS, Time]> Never! {
            timed: if start_us >= 0 && start_us <= end_us && cpu_ns >= 0 -> "" else -> " untimed"
            graph_files.append_all(self.path, "{name} {detail} slot {slot}{timed}\n") ?? panic("cannot write the trace: {err}")
        }
    }
}

graph_test_sink: fn(sink: &&GraphTestSink) -> CompilerTaskTraceSink Never! { sink.move() }

#Test("a traced task schedule writes one timed span per node, on its thread slot") {
    count: 40
    path: "{graph_sys.temp_dir()}/jet-task-graph-{graph_process.current_pid()}.txt"
    graph_files.write(path, "") ?? panic("start the trace: {err}")
    _ := graph_test_run(graph_halves(), graph_threads(4), Val(graph_test_sink(GraphTestSink{path: path})))
    rows: (graph_files.read(path) ?? panic("read the trace: {err}")).lines()
    graph_files.remove(path).drop("the test's trace file")
    assert_eq(rows.len(), count)
    seen := [Bool]{}
    loop _ in 0..<count -> seen.push(false)
    loop row in rows {
        parts: row.split(" ").to_list()
        assert_eq(parts.len(), 5)
        assert_eq(parts[0], "test.node")
        node: parts[2].parse() ?? panic("a span names no node: {row}")
        slot: parts[4].parse() ?? panic("a span names no slot or is untimed: {row}")
        assert(!seen[node])
        seen[node] = true
        assert(slot >= 0 && slot < 4)
    }
}
