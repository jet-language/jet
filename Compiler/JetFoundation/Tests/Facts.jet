// Original jet-foundation/Facts.rs tests758-818, plus registry/alias boundaries.
use jet_foundation.[FactKind, ReachabilityRow, StateGraph, StateGraphTransition, StateNode, fact_kind_name, fact_registry_contains, fact_registry_declare, fact_registry_declare_member, fact_registry_declare_state, fact_registry_declare_with_rules, fact_registry_get, fact_registry_iter, fact_registry_iter_kind, fact_registry_member, fact_registry_new, fact_registry_set_state_graph, fact_registry_state_graph, fact_registry_state_members, project_reachability, reachability_copy_node, reachability_nodes_with, reachability_path, sema_effect_covers]

#Test("subsumption_uses_segment_boundaries") {
    assert(sema_effect_covers("FS", "FS"))
    assert(sema_effect_covers("FS", "FS.Read"))
    assert(!sema_effect_covers("FS", "FStore"))
    assert(!sema_effect_covers("FS.Read", "FS"))
}
#Test("fact_families_have_distinct_namespaces") {
    facts := fact_registry_new()
    fact_registry_declare(&facts, FactKind.Effect, "Secret", [String]{})
    fact_registry_declare_with_rules(&facts, FactKind.Tag, "Secret", [String]{}, [String]{"Log"}, [String]{})
    assert((fact_registry_get(facts, FactKind.Effect, "Secret") ?? panic("effect missing")).kind == FactKind.Effect)
    assert((fact_registry_get(facts, FactKind.Tag, "Secret") ?? panic("tag missing")).deny.len() == 1)
    assert(fact_registry_iter(facts).len() == 2)
}
#Test("one_traversal_projects_new_fact_row_with_existing_rows") {
    edges :: [String:[String]]{"root": [String]{"mid"}, "mid": [String]{"leaf"}, "leaf": [String]{"root"}}
    result :: project_reachability(edges, [ReachabilityRow]{
        ReachabilityRow{name: "effects", seeds: [String:[String]]{"leaf": [String]{"FS"}}},
        ReachabilityRow{name: "panic", seeds: [String:[String]]{"leaf": [String]{"panic"}}},
        ReachabilityRow{name: "calls-exec", seeds: [String:[String]]{"leaf": [String]{"Exec"}}},
    })
    assert(reachability_nodes_with(result, "effects", "FS").contains("root"))
    assert(reachability_nodes_with(result, "panic", "panic").contains("root"))
    assert(reachability_nodes_with(result, "calls-exec", "Exec").contains("root"))
    assert((reachability_path(result, "effects", "root", "FS") ?? panic("proof missing")) == [String]{"root", "mid", "leaf"})
}
#Test("registry_replacement_preserves_ordered_state_plane_and_checked_graph") {
    registry := fact_registry_new()
    fact_registry_declare_state(&registry, "Socket", [String]{"Open", "Closed", "Open"})
    assert((fact_registry_get(registry, FactKind.State, "Socket.State") ?? panic("state missing")).members == [String]{"Closed", "Open"})
    assert((fact_registry_state_members(registry, "Socket") ?? panic("order missing")) == [String]{"Open", "Closed", "Open"})
    fact_registry_declare_member(&registry, FactKind.State, "Socket.State", "Closed")
    fact_registry_declare_member(&registry, FactKind.State, "Socket.State", "Pending")
    assert((fact_registry_state_members(registry, "Socket") ?? panic("order missing")) == [String]{"Open", "Closed", "Open", "Pending"})
    graph :: StateGraph{states: [StateNode]{StateNode{name: "Open", terminal: false, reachable: Val(true)}, StateNode{name: "Closed", terminal: true, reachable: Val(true)}, StateNode{name: "Detached", terminal: true, reachable: Val(false)}}, transitions: [StateGraphTransition]{StateGraphTransition{operation: "open", from: None, to: "Open"}, StateGraphTransition{operation: "close", from: Val("Open"), to: "Closed"}}}
    fact_registry_set_state_graph(&registry, "Socket.State", graph)
    assert((fact_registry_state_graph(registry, "Socket.State") ?? panic("graph missing")) == graph)
    fact_registry_declare_state(&registry, "Socket", [String]{"New"})
    assert((fact_registry_state_members(registry, "Socket") ?? panic("replacement order missing")) == [String]{"New"})
    assert(!fact_registry_member(registry, FactKind.State, "Socket.State", "Open"))
    assert(fact_registry_member(registry, FactKind.State, "Socket.State", "New"))
    assert(fact_registry_state_graph(registry, "Missing.State") == None)
    assert(fact_registry_contains(registry, FactKind.State, "Socket.State"))
    assert(fact_registry_iter_kind(registry, FactKind.Tag).len() == 0)
    assert(fact_kind_name(FactKind.State) == "State")
}
#Test("reachability_unique_alias_preserves_deterministic_proof_and_seed_only_nodes") {
    edges :: [String:[String]]{"root": [String]{"z", "a"}, "a": [String]{"leaf"}, "z": [String]{"leaf"}, "leaf": [String]{"root"}}
    result := project_reachability(edges, [ReachabilityRow]{ReachabilityRow{name: "taint", seeds: [String:[String]]{"leaf": [String]{"Credential"}, "isolated": [String]{"Token"}}}})
    assert((reachability_path(result, "taint", "root", "Credential") ?? panic("path missing")) == [String]{"root", "a", "leaf"})
    reachability_copy_node(&result, "alias", "root")
    assert((reachability_path(result, "taint", "alias", "Credential") ?? panic("alias missing")) == [String]{"alias", "a", "leaf"})
    assert(reachability_nodes_with(result, "taint", "Token") == [String]{"isolated"})
    assert(reachability_path(result, "missing", "root", "Credential") == None)
}
