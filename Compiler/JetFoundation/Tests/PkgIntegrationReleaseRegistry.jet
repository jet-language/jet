// Compiler-library acceptance ports. Run after compiler-package assembly; no
// alternate registry or public API.
use jet_foundation.[diagnostic_explanation, diagnostic_registry_rows]

#Test("ga_every_diagnostic_has_explain") {
    missing := [String]{}
    loop row in diagnostic_registry_rows() {
        if diagnostic_explanation(row.code) == None -> missing.push(row.code)
    }
    assert_eq(missing.len(), 0)
}
