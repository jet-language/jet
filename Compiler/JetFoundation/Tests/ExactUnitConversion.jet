use JetFoundation.ExactUnitConversion.[jet_unit_conversion_exact, jet_unit_conversion_rounded, UnitRoundingMode]

// Rust: crates/jet-foundation/src/ExactUnitConversion.rs:517
// No inline Rust tests; controls exercise exact rational and representation checks.
#Test("exact unit conversion requires integral exactly represented destination") {
    assert(jet_unit_conversion_exact(2.0, "3", "2", "0", "1") == Val(3.0))
    assert(jet_unit_conversion_exact(1.0, "1", "2", "0", "1") == None)
    assert(jet_unit_conversion_exact(-2.0, "3", "-2", "1", "1") == Val(4.0))
    assert(jet_unit_conversion_exact(1.0, "1", "0", "0", "1") == None)
    assert(jet_unit_conversion_exact(1.0, "x", "1", "0", "1") == None)
}
// Rust: crates/jet-foundation/src/ExactUnitConversion.rs:530
#Test("rounded units preserve direction ties and precision bound") {
    assert((jet_unit_conversion_rounded(2.5, "1", "1", "0", "1", UnitRoundingMode.NearestEven, I64{0}) ?? panic("rounding failed")) == 2.0)
    assert((jet_unit_conversion_rounded(3.5, "1", "1", "0", "1", UnitRoundingMode.NearestEven, I64{0}) ?? panic("rounding failed")) == 4.0)
    assert((jet_unit_conversion_rounded(-2.5, "1", "1", "0", "1", UnitRoundingMode.Floor, I64{0}) ?? panic("rounding failed")) == -3.0)
    assert((jet_unit_conversion_rounded(-2.5, "1", "1", "0", "1", UnitRoundingMode.Ceiling, I64{0}) ?? panic("rounding failed")) == -2.0)
    assert(jet_unit_conversion_rounded(1.0, "1", "1", "0", "1", UnitRoundingMode.Floor, I64{-1}).is_err())
    assert((jet_unit_conversion_rounded(0.5, "1", "1", "0", "1", UnitRoundingMode.NearestEven, I64.max) ?? panic("huge exact precision rejected")) == 0.5)
}
