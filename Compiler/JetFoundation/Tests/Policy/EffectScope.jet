// The one covers rule for scoped effects (Policy/EffectScope.jet): the path,
// host and value laws, the bare and scoped orders, the scope a Core
// publisher's constant argument names, and the run-time frame descriptor a
// written row gives.
use jet_foundation.[
    authority_covers,
    effect_scope_covers,
    effect_scope_descriptor,
    effect_scope_name,
    effect_scope_of_argument,
    effect_scope_published_effect,
    effect_scope_split,
    sema_effect_covers,
]

// `held > need: covers`, the table the runtime's rule answers the same way
// (tests/cases/effects/effect_scope_covers_is_one_relation_at_every_tier).
COVERS_TABLE: [String]{
    "FS.Read(\"templates/\") > FS.Read(\"templates/home.html\"): true",
    "FS.Read(\"templates\") > FS.Read(\"templates/a/b.txt\"): true",
    "FS.Read(\"./templates/\") > FS.Read(\"templates/x/../y.txt\"): true",
    "FS.Read(\"templates/\") > FS.Read(\"templates2/a.txt\"): false",
    "FS.Read(\"templates/\") > FS.Read(\"templates/../secret.txt\"): false",
    "FS.Read(\"templates/\") > FS.Read(\"../templates/a.txt\"): false",
    "FS.Read(\"Data/\") > FS.Read(\"data/a\"): false",
    "FS.Read(\"..\") > FS.Read(\"../a\"): true",
    "FS.Read(\"..\") > FS.Read(\"../..\"): false",
    "FS.Read(\".\") > FS.Read(\"../a\"): false",
    "FS.Read(\"\") > FS.Read(\"a\"): true",
    "FS.Read(\"a/../../b\") > FS.Read(\"../b/c\"): true",
    "FS.Read(\"//data\") > FS.Read(\"/data/x\"): true",
    "FS.Read(\"/data\") > FS.Read(\"/database/a\"): false",
    "FS.Read(\"/data\") > FS.Read(\"data/a\"): false",
    "FS.Read(\"/\") > FS.Read(\"/etc/hosts\"): true",
    "FS.Read(\"/\") > FS.Read(\"etc/hosts\"): false",
    "FS.Read(\"/..\") > FS.Read(\"/etc\"): true",
    "Net(\"api.example.com\") > Net(\"API.Example.com.\"): true",
    "Net(\"api.example.com\") > Net(\" api.example.com\"): false",
    "Net(\"api.example.com\") > Net(\"api.example.com \"): false",
    "Net(\"api.example.com\") > Net(\"evilapi.example.com\"): false",
    "Net(\"example.com\") > Net(\"api.example.com\"): false",
    "Net(\"a.com.\") > Net(\"a.com\"): true",
    "Net(\"a.com..\") > Net(\"a.com\"): false",
    "GPU(\"npu\") > GPU(\"npu\"): true",
    "GPU(\"npu\") > GPU(\"NPU\"): false",
    "FS > FS.Read(\"a.txt\"): true",
    "FS.Read > FS.Read(\"a.txt\"): true",
    "FS.Read(\"assets/\") > FS.Read: false",
    "FS.Read(\"assets/\") > FS.Write(\"assets/a\"): false",
    "FS(\"assets/\") > FS.Read(\"assets/a\"): true",
    "FS.Read > FS.ReadExtra: false",
}

#Test("rows, holds and the runtime answer the covers table alike") {
    loop row in COVERS_TABLE {
        pair: row.split_once(" > ") ?? panic("a table row is `held > need: covers`")
        need: pair.after.cut_last(": ") ?? panic("a table row ends in its answer")
        expected: need.after == "true"
        assert(effect_scope_covers(pair.before, need.before) == expected, "effect rows: {row}")
        assert(sema_effect_covers(pair.before, need.before) == expected, "library grants: {row}")
        assert(authority_covers(pair.before, need.before) == expected, "authority holds: {row}")
    }
}

#Test("a written row's run-time frame names its FS and Net entries") {
    assert_eq(effect_scope_descriptor("read_scoped", "fn:app::read_scoped", false, Val([String]{"FS.Read(\"data/\")", "IO"})), "read_scoped\nFS.Read(\"data/\")")
    assert_eq(effect_scope_descriptor("read_open", "fn:app::read_open", false, Val([String]{"FS.Read(\"data/\")", "!FS.Read(\"data/private/\")"})), "read_open\nFS.Read(\"data/\")\n!FS.Read(\"data/private/\")")
    assert_eq(effect_scope_descriptor("fetch", "fn:app::fetch", false, Val([String]{"Net(\"api.example.com\")", "Time.Wait", "FS.Read"})), "fetch\nNet(\"api.example.com\")\nFS.Read")
    assert_eq(effect_scope_descriptor("read", "fn:<corelib>/core.files::read", true, Val([String]{"FS.Read"})), "@FS.Read")
    assert_eq(effect_scope_descriptor("get", "fn:<corelib>/core.http::get", false, Val([String]{"Net", "Time.Wait"})), "@Net")
    assert(effect_scope_descriptor("load", "fn:app::load", false, Val([String]{"FS.Read", "IO"})) == "", "a bare row names no scope")
    assert(effect_scope_descriptor("map", "fn:app::map", false, Val([String]{"FS.Read(\"data/\")", "..E"})) == "", "an open row has no closed ceiling")
    assert(effect_scope_descriptor("gpu", "fn:app::gpu", false, Val([String]{"GPU(\"npu\")"})) == "", "a value scope stays static")
    assert(effect_scope_descriptor("plain", "fn:app::plain", false, None) == "", "no row, no frame")
}

#Test("a scoped effect splits into its bare effect and its scope") {
    split: effect_scope_split("FS.Read(\"templates/\")")
    assert_eq(split.base, "FS.Read")
    assert_eq(split.scope ?? "", "templates/")
    assert(effect_scope_split("FS.Read").scope == None, "a bare effect has no scope")
    assert(effect_scope_split("Mem.Alloc(above: 64)").scope == None, "a memory bound is not a scope")
    assert_eq(effect_scope_name("Net", "api.example.com"), "Net(\"api.example.com\")")
}

#Test("a path scope covers by whole components after normalization") {
    assert(effect_scope_covers("FS.Read(\"templates/\")", "FS.Read(\"templates/home.html\")"), "a folder covers its files")
    assert(effect_scope_covers("FS.Read(\"templates\")", "FS.Read(\"templates/a/b.txt\")"), "the trailing slash is optional")
    assert(effect_scope_covers("FS.Read(\"./templates/\")", "FS.Read(\"templates/x/../y.txt\")"), "`.` and `..` normalize")
    assert(!effect_scope_covers("FS.Read(\"templates/\")", "FS.Read(\"templates2/a.txt\")"), "a sibling with a longer name is outside")
    assert(!effect_scope_covers("FS.Read(\"templates/\")", "FS.Read(\"templates/../secret.txt\")"), "`..` leaves the folder")
    assert(!effect_scope_covers("FS.Read(\"templates/\")", "FS.Read(\"../templates/a.txt\")"), "a parent-relative path is outside")
    assert(!effect_scope_covers("FS.Read(\"/data\")", "FS.Read(\"/database/a\")"), "an absolute folder covers whole components")
    assert(!effect_scope_covers("FS.Read(\"/data\")", "FS.Read(\"data/a\")"), "absolute and relative paths differ")
}

#Test("a host scope covers the same host only") {
    assert(effect_scope_covers("Net(\"api.example.com\")", "Net(\"API.Example.com.\")"), "hosts compare without case or the trailing dot")
    assert(!effect_scope_covers("Net(\"api.example.com\")", "Net(\"evilapi.example.com\")"), "a longer host is another host")
    assert(!effect_scope_covers("Net(\"example.com\")", "Net(\"api.example.com\")"), "a parent domain covers no subdomain")
}

#Test("any other scope covers by equality") {
    assert(effect_scope_covers("GPU(\"npu\")", "GPU(\"npu\")"), "a device covers itself")
    assert(!effect_scope_covers("GPU(\"npu\")", "GPU(\"npu0\")"), "another device is outside")
}

#Test("a bare effect covers its scoped leaves and a scoped one never the bare") {
    assert(effect_scope_covers("FS", "FS.Read(\"a.txt\")"), "a root covers a scoped leaf")
    assert(effect_scope_covers("FS.Read", "FS.Read(\"a.txt\")"), "a leaf covers its scoped instances")
    assert(!effect_scope_covers("FS.Read(\"assets/\")", "FS.Read"), "a scope never covers a run-time path")
    assert(!effect_scope_covers("FS.Read(\"assets/\")", "FS.Write(\"assets/a\")"), "a scope covers only its own effect")
    assert(effect_scope_covers("FS(\"assets/\")", "FS.Read(\"assets/a\")"), "a scoped root covers its scoped leaves")
    assert(!effect_scope_covers("FS.Read", "FS.ReadExtra"), "leaves split at dots")
    assert(sema_effect_covers("FS", "FS.Read"), "effect rows use the same rule")
    assert(authority_covers("FS.Read(\"/data\")", "FS.Read(\"/data/a\")"), "authority holds use the same rule")
    assert(!authority_covers("FS.Read(\"/data\")", "FS.Read(\"/database\")"), "a scoped hold covers whole components")
}

#Test("a publisher's constant argument names its scope") {
    assert_eq(effect_scope_published_effect("fn:<corelib>/core.files::read", true, [String]{"FS.Read"}) ?? "", "FS.Read")
    assert_eq(effect_scope_published_effect("fn:<corelib>/core.files::write_bytes", true, [String]{"FS.Write"}) ?? "", "FS.Write")
    assert_eq(effect_scope_published_effect("fn:<corelib>/core.http::get", false, [String]{}) ?? "", "Net")
    assert(effect_scope_published_effect("fn:<corelib>/core.files:FileReader:read", true, [String]{"FS.Read"}) == None, "a method publishes nothing")
    assert(effect_scope_published_effect("fn:<corelib>/core.files::rename", false, [String]{"FS.Write"}) == None, "a first parameter that isn't the path publishes nothing")
    assert(effect_scope_published_effect("fn:<corelib>/core.files::remove_all", true, [String]{"FS"}) == None, "a bare root publishes nothing")
    assert(effect_scope_published_effect("fn:<corelib>/core.files::absolute", true, [String]{"FS", "Env"}) == None, "a row of two effects publishes nothing")
    assert(effect_scope_published_effect("fn:app::read", true, [String]{"FS.Read"}) == None, "only core.files publishes a path")
    assert_eq(effect_scope_of_argument("FS.Read", "assets/logo.txt", true) ?? "", "assets/logo.txt")
    assert_eq(effect_scope_of_argument("FS.Read", "assets/icons/", false) ?? "", "assets/icons/")
    assert(effect_scope_of_argument("FS.Read", "logo", false) == None, "no folder before the interpolation")
    assert_eq(effect_scope_of_argument("Net", "https://api.example.com/v1/", false) ?? "", "api.example.com")
    assert_eq(effect_scope_of_argument("Net", "http://api.example.com:8080", true) ?? "", "api.example.com")
    assert(effect_scope_of_argument("Net", "https://api.", false) == None, "the host continues at run time")
    assert(effect_scope_of_argument("Net", "https://user@evil.example/", true) == None, "user info hides the host")
}
