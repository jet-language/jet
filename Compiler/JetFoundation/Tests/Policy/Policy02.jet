RULE_ARG_TYPES_WITHOUT_CORE_DECLARATION :: prep { [String]{
    "Value", "String", "Ident", "Bool", "Int", "Duration | String", "[Effect]", "Type", "T.default"
} }
// Rust: crates/jet-foundation/src/Policy.rs:1324
pub fn rule_arg_needs_core_declaration(name: String) -> Bool Never! {
