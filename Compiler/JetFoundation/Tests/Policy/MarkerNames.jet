// Every front-end marker-name constant is a marker struct of the one marker
// declaration source, so renaming or retiring a marker there fails here.
use jet_foundation.[
    MARKER_ABI, MARKER_ALLOW, MARKER_ARG, MARKER_AS, MARKER_CLI, MARKER_CODABLE, MARKER_COMMUTATIVE, MARKER_CONTEXT, MARKER_CONTEXT_KEY,
    MARKER_DEADLINE, MARKER_DEPRECATED, MARKER_DEV_PANEL, MARKER_DOC, MARKER_ERROR,
    MARKER_FFI, MARKER_FLATTEN, MARKER_FX, MARKER_GUEST_EXPORT, MARKER_GUEST_IMPORT, MARKER_HOOKS, MARKER_HTML,
    MARKER_INLINE, MARKER_INTERRUPT,
    MARKER_JOB, MARKER_KERNEL, MARKER_LOCAL, MARKER_MAX_DEPTH, MARKER_MEMO, MARKER_META, MARKER_MUST_USE,
    MARKER_NO_PRELUDE, MARKER_NUMERIC, MARKER_OFF, MARKER_OVERFLOW, MARKER_POLICY, MARKER_POST, MARKER_PRE, MARKER_PUBLISHED_SCHEMA,
    MARKER_REACTIVE, MARKER_RECEIPT, MARKER_REDACT, MARKER_RENAME, MARKER_REPLAYABLE, MARKER_ROOT, MARKER_SCALAR,
    MARKER_SCRUB, MARKER_SHARED, MARKER_SINGLE_USE, MARKER_SKIP, MARKER_SOURCE,
    MARKER_STATE, MARKER_STATIC, MARKER_TARGET, MARKER_TRACK, MARKER_TRANSACT,
    MARKER_UNDO, MARKER_UNSAFE, MARKER_UNTAGGED,
]

// The struct names MARKER_SOURCE declares at its top level.
marker_names_declared: fn() -> [String] Never! {
    names := [String]{}
    loop line in MARKER_SOURCE.split("\n") {
        if line.starts_with(" ") || !line.contains(": struct") -> next
        colon: line.index(": struct") ?? next
        names.push(line.slice(0..<colon).trim().copy())
    }
    names
}

#Test("every marker name constant is a declared marker struct") {
    declared: marker_names_declared()
    assert(declared.len() > 20, "MARKER_SOURCE declares no marker structs")
    constants: [String]{
        MARKER_ABI, MARKER_ALLOW, MARKER_ARG, MARKER_AS, MARKER_CLI, MARKER_CODABLE, MARKER_COMMUTATIVE, MARKER_CONTEXT, MARKER_CONTEXT_KEY,
        MARKER_DEADLINE, MARKER_DEPRECATED, MARKER_DEV_PANEL, MARKER_DOC, MARKER_ERROR,
        MARKER_FFI, MARKER_FLATTEN, MARKER_FX, MARKER_HTML, MARKER_INLINE, MARKER_INTERRUPT,
        MARKER_JOB, MARKER_KERNEL, MARKER_LOCAL, MARKER_MAX_DEPTH, MARKER_MEMO, MARKER_META, MARKER_MUST_USE,
        MARKER_NO_PRELUDE, MARKER_NUMERIC, MARKER_OFF, MARKER_OVERFLOW, MARKER_POLICY, MARKER_POST, MARKER_PRE, MARKER_PUBLISHED_SCHEMA,
        MARKER_REACTIVE, MARKER_RECEIPT, MARKER_REDACT, MARKER_RENAME, MARKER_REPLAYABLE, MARKER_ROOT, MARKER_SCALAR,
        MARKER_SCRUB, MARKER_SHARED, MARKER_SINGLE_USE, MARKER_SKIP,
        MARKER_STATE, MARKER_STATIC, MARKER_TARGET, MARKER_TRACK, MARKER_TRANSACT,
        MARKER_UNDO, MARKER_UNSAFE, MARKER_UNTAGGED,
    }
    missing := [String]{}
    loop name in constants {
        if !declared.contains(name) -> missing.push(name.copy())
    }
    assert_eq(missing.join(", "), "")
}

// A hook row keys a Prelude declaration; only the guest-edge spellings have no
// struct, and every row names its declaration once.
#Test("every marker hook keys a declared marker") {
    declared: marker_names_declared()
    seen := [String]{}
    problems := [String]{}
    loop row in MARKER_HOOKS {
        guest: row.declaration == MARKER_GUEST_IMPORT || row.declaration == MARKER_GUEST_EXPORT
        if !guest && !declared.contains(row.declaration) -> problems.push("{row.declaration} is not declared")
        if seen.contains(row.declaration) -> problems.push("{row.declaration} has two rows")
        seen.push(row.declaration.copy())
    }
    assert_eq(problems.join(", "), "")
}
