        expected := ^bom
        expected.extend(wire_bytes(source, wire))
        assert(output == expected)
    }
    writer := StreamWriter.new(RenderEncoding.UTF8, LexicalPolicy.Deterministic)
    before :: writer.clone()
    error :: writer.write(&events[1]).expect_err("missing document start")
    assert(error.reason.contains("document_start"))
    assert(writer.started == before.started)
    assert(writer.stack == before.stack)
}
// Rust: crates/jet-foundation/src/XmlPull.rs:4117
#Test("xml_10_namespaces_closed_tree_algebra_for_parse_surfaces") {
    source :: "<?xml version='1.0' encoding='UTF-8'?>\n<!--prolog-->\n<root xmlns='urn:r' xmlns:p='urn:p' a='1' p:b='2'>text<!--c--><![CDATA[<x>]]><?go now?><p:child/>&amp;tail</root>\n"
    tree :: parse_document(source).expect("parse")
    with :: parse_document_with(source, &ParseOptions.safe()).expect("parse_with")
    bytes :: parse_document_bytes(source.as_bytes()).expect("parse_bytes")
    assert(field(&tree, "$xml") == Val(Value.Text("document")))
    assert(strip_lexical(&tree) == strip_lexical(&with))
    assert(strip_lexical(field(&tree, "children").expect("string children")) == strip_lexical(field(&bytes, "children").expect("byte children")))
    assert(field(&bytes, "encoding") == Val(Value.Text("UTF-8")))
    assert(field(&bytes, "bom") == Val(Value.Array([])))
    children :: match field(&tree, "children") { Val(Value.Array(items)) => items, _ => { panic("children array") } }
    assert(children.iter().map(fn(node) { required_text(node, "$xml").expect("tag") }).collect<[String]>() == [String]{"declaration", "document_whitespace", "comment", "document_whitespace", "element", "document_whitespace"})
    assert(field(&children[1], "value") == Val(Value.Text("\n")))
    root :: children.iter().find(fn(node) { field(node, "$xml") == Val(Value.Text("element")) }).expect("root")
    assert(expanded_name_parts(root).expect("expanded") == ("root", None, "root", Val("urn:r")))
    namespaces :: match field(root, "namespaces") { Val(Value.Array(items)) => items, _ => { panic("namespaces") } }
    attributes :: match field(root, "attributes") { Val(Value.Array(items)) => items, _ => { panic("attributes") } }
    assert(namespaces.len() == 2)
    assert(attributes.len() == 2)
    assert(expanded_name_parts(&attributes[0]).expect("a").2 == "a")
    assert(field(&attributes[0], "normalized_value") == Val(Value.Text("1")))
    assert(expanded_name_parts(&attributes[1]).expect("b").3 == Val("urn:p"))
    content :: match field(root, "children") { Val(Value.Array(items)) => items, _ => { panic("mixed content") } }
    assert(content.iter().map(fn(node) { required_text(node, "$xml").expect("child tag") }).collect<[String]>() == [String]{"text", "comment", "cdata", "processing_instruction", "element", "entity_ref", "text"})
    dup :: parse_document("<r xmlns:p='u' xmlns:q='u' p:a='1' q:a='2'/>").expect_err("duplicate expanded attribute")
    assert(dup.kind == Reason.DuplicateAttribute)
    assert(dup.line == Val(1))
    assert(dup.column != None)
    assert(dup.path == "$")
    mismatch :: parse_document("<r>\n <a></b></r>").expect_err("mismatch")
    assert((mismatch.kind, mismatch.offset, mismatch.line, mismatch.column, mismatch.path) == (Reason.MismatchedTag, 8, Val(2), Val(5), "$/r/a"))
    assert(render_document(&tree).expect("round-trip") == source)
}
// Rust: crates/jet-foundation/src/XmlPull.rs:4230
#Test("parse_bytes_identity_and_token_local_lexical_reuse") {
    source :: "<?xml version='1.0' encoding='UTF-8'?><r><!--keep--><![CDATA[stay]]>x</r>"
    utf8_bom := [U8]{0xef, 0xbb, 0xbf}
    utf8_bom.extend_from_slice(source.as_bytes())
    tree := parse_document_bytes(utf8_bom.view()).expect("parse bom")
    assert(render_document_bytes(&tree, RenderEncoding.UTF8Bom, LexicalPolicy.PreserveValid).expect("identity") == utf8_bom)
    children := xmlpull03_array(xmlpull03_slot(&tree, "children"))
    root := children.iter_mut().find(fn(node) { field(node, "$xml") == Val(Value.Text("element")) }).expect("root")
    content := xmlpull03_array(xmlpull03_slot(root, "children"))
    text_node := content.iter_mut().find(fn(node) { field(node, "$xml") == Val(Value.Text("text")) }).expect("text")
    *xmlpull03_slot(text_node, "value") = text("edited")
    lexical := xmlpull03_slot(text_node, "lexical")
    *xmlpull03_slot(lexical, "raw_bytes") = Value.Null
    *xmlpull03_slot(lexical, "semantic") = object([("value", text("edited"))])
    out :: render_document_bytes(&tree, RenderEncoding.UTF8Bom, LexicalPolicy.PreserveValid).expect("token edit")
    assert(out != utf8_bom)
    out_text :: String.from_utf8(out[3..]).expect("utf8 body")
    assert(out_text.contains("<!--keep-->"))
    assert(out_text.contains("<![CDATA[stay]]>"))
    assert(out_text.contains(">edited</r>"))
    assert(!out_text.contains(">x</r>"))
    conflict := [U8]{0xff, 0xfe}
    conflict.extend(wire_bytes("<?xml version='1.0' encoding='UTF-8'?><r/>", WireEncoding.Utf16Le))
    assert(parse_document_bytes(conflict.view()).expect_err("conflict").kind == Reason.InvalidEncoding)
    assert(parse_document_bytes("<?xml version='1.0' encoding='ISO-8859-1'?><r/>".as_bytes()).expect_err("latin1").kind == Reason.InvalidEncoding)
    loop (bom, wire, render, declared) in [([U8], WireEncoding, RenderEncoding, String)]{
        ([0xff, 0xfe], WireEncoding.Utf16Le, RenderEncoding.Utf16Le, "UTF-16"), ([0xfe, 0xff], WireEncoding.Utf16Be, RenderEncoding.Utf16Be, "UTF-16BE")
    } {
        bytes := bom.clone()
        bytes.extend(wire_bytes("<?xml version='1.0' encoding='{declared}'?><r/>", wire))
        doc :: parse_document_bytes(bytes.view()).expect("utf16 parse")
        assert(render_document_bytes(&doc, render, LexicalPolicy.PreserveValid).expect("utf16 render") == bytes)
    }
}
// Rust: crates/jet-foundation/src/XmlPull.rs:4351
#Test("canonical_xml_w3c_whole_document_corpus") {
    root :: OSPath("tests/data/xml/c14n")
    cases :: [(String, CanonicalOptions)]{
        ("incl11_sort_escape", CanonicalOptions{mode: CanonicalMode.Inclusive11, comments: false, inclusive_prefixes: []}),
        ("incl11_with_comments", CanonicalOptions{mode: CanonicalMode.Inclusive11, comments: true, inclusive_prefixes: []}),
        ("excl10_omit_unused", CanonicalOptions{mode: CanonicalMode.Exclusive10, comments: false, inclusive_prefixes: []}),
        ("excl10_inclusive_prefix", CanonicalOptions{mode: CanonicalMode.Exclusive10, comments: false, inclusive_prefixes: ["b"]}),
        ("excl10_with_comments", CanonicalOptions{mode: CanonicalMode.Exclusive10, comments: true, inclusive_prefixes: []})
    }
    loop (stem, options) in cases {
        input :: fs.read_to_string(root.join("{stem}.in.xml")).expect(stem)
        expected :: fs.read_to_string(root.join("{stem}.out.xml")).expect(stem)
        trimmed := input.trim_end_matches('\n') // #4303
        tree :: parse_document(trimmed).expect("{stem} parse")
        got :: canonical_document(&tree, &options).expect("{stem} canonical")
        assert(got == expected.trim_end_matches('\n'), stem)
    }
    tree :: parse_document("<r xmlns:q='urn:q' xmlns:p='urn:p' q:z='2' a='1'><e/></r>").expect("reject options tree")
    assert(canonical_document(&tree, &CanonicalOptions{mode: CanonicalMode.Inclusive11, comments: false, inclusive_prefixes: ["p"]}).expect_err("inclusive_prefixes illegal for Inclusive11").kind == Reason.Shape)
    relative :: parse_document("<r xmlns:p='relative'><p:e/></r>").expect("relative")
    assert(canonical_document(&relative, &CanonicalOptions{mode: CanonicalMode.Exclusive10, comments: false, inclusive_prefixes: []}).expect_err("relative NS").kind == Reason.Namespace)
    unresolved :: parse_document("<!DOCTYPE r [<!ENTITY e 'x'>]><r>&e;</r>").expect("entity")
    assert(canonical_document(&unresolved, &CanonicalOptions{mode: CanonicalMode.Inclusive11, comments: false, inclusive_prefixes: []}).expect_err("unresolved entity").kind == Reason.Canonicalization)
    not_doc :: object([
        ("$xml", text("element")), ("name", object([("raw", text("r")), ("prefix", Value.Null), ("local", text("r")), ("namespace_uri", Value.Null)])),
        ("namespaces", Value.Array([])), ("attributes", Value.Array([])), ("children", Value.Array([])), ("empty_style", text("empty")), ("open_lexical", Value.Null), ("close_lexical", Value.Null)
    ])
    assert(canonical_document(&not_doc, &CanonicalOptions{mode: CanonicalMode.Inclusive11, comments: false, inclusive_prefixes: []}).expect_err("non-document").kind == Reason.Shape)
}
// Rust: crates/jet-foundation/src/XmlPull.rs:4477
#Test("fold_unfold_inverses_and_hostile_event_algebra") {
    source :: "<?xml version='1.0' encoding='UTF-8'?>\n<!--c-->\n<root xmlns:p='urn:p' a='1'>x&amp;<![CDATA[<y>]]><?go now?><p:e/></root>\n"
    tree :: parse_document_bytes(source.as_bytes()).expect("parse bytes")
    events :: unfold_events(&tree).expect("unfold")
    assert(required_text(&events[0], "$xml_event").expect("start") == "document_start")
    assert(required_text(events.last().expect("end"), "$xml_event").expect("end tag") == "document_end")
    folded :: fold_events(&events).expect("fold")
    assert(folded == tree)
    assert(unfold_events(&folded).expect("re-unfold") == events)
    bytes :: source.as_bytes()
    expected :: stream_values(bytes, bytes.len())
    loop split in 0..=bytes.len() { assert(stream_values(bytes, split) == expected, "hostile chunk split {split}") }
    assert(fold_events(&expected).expect("fold chunked") == tree)
    incomplete :: expected[..expected.len() - 1].to_vec()
    err :: fold_events(&incomplete).expect_err("incomplete")
    assert(err.kind == Reason.Shape)
    assert(err.reason.contains("complete document"))
    after_end := expected.clone()
    after_end.push(object([("$xml_event", text("document_end"))]))
    assert(fold_events(&after_end).expect_err("post end").reason.contains("after document_end"))
    mismatched := expected.clone()
    end := mismatched.iter_mut().find(fn(event) { field(event, "$xml_event") == Val(Value.Text("element_end")) }).expect("element_end")
    *xmlpull03_slot(end, "name") = object([("raw", text("other")), ("prefix", Value.Null), ("local", text("other")), ("namespace_uri", Value.Null)])
    assert(fold_events(&mismatched).expect_err("mismatch").kind == Reason.MismatchedTag)
    writer := StreamWriter.new(RenderEncoding.UTF8, LexicalPolicy.Deterministic)
    assert(writer.write(&object([("$xml_event", text("document_end"))])).expect_err("end before start").reason.contains("document_start"))
    writer = StreamWriter.new(RenderEncoding.UTF8, LexicalPolicy.Deterministic)
    _ :: writer.write(&expected[0]).expect("document_start")
    assert(writer.write(&expected[0]).expect_err("duplicate start").reason.contains("duplicate"))
    writer = StreamWriter.new(RenderEncoding.UTF8, LexicalPolicy.Deterministic)
    loop event in &expected { _ :: writer.write(event).expect("write complete") }
    assert(writer.is_finished())
    assert(writer.write(&object([("$xml_event", text("document_end"))])).expect_err("post terminal").reason.contains("after document_end"))
    writer = StreamWriter.new(RenderEncoding.UTF8, LexicalPolicy.Deterministic)
    _ :: writer.write(&expected[0]).expect("start")
    start :: expected.iter().find(fn(event) { field(event, "$xml_event") == Val(Value.Text("element_start")) && field(event, "empty_style") == Val(Value.Text("explicit")) }).expect("root start")
    _ :: writer.write(start).expect("open root")
    assert(writer.write(&object([("$xml_event", text("document_end"))])).expect_err("incomplete closure").reason.contains("closed root"))
    assert(!writer.is_finished())
}
// Rust: crates/jet-foundation/src/XmlPull.rs:4589
#Test("canonical_xml_sorts_and_normalizes_semantic_infoset") {
    tree :: parse_document("<?xml version='1.0'?><r xmlns:q='urn:q' xmlns:p='urn:p' q:z='2' a='x&#xA;y' p:a='1'><e/><!--c--><![CDATA[<&]]></r>").expect("tree")
    without :: canonical_document(&tree, &CanonicalOptions{mode: CanonicalMode.Inclusive11, comments: false, inclusive_prefixes: []}).expect("canonical")
    assert(without == "<r xmlns:p=\"urn:p\" xmlns:q=\"urn:q\" a=\"x&#xA;y\" p:a=\"1\" q:z=\"2\"><e></e>&lt;&amp;</r>")
    with :: canonical_document(&tree, &CanonicalOptions{mode: CanonicalMode.Exclusive10, comments: true, inclusive_prefixes: ["p"]}).expect("exclusive")
    assert(with == "<r xmlns:p=\"urn:p\" xmlns:q=\"urn:q\" a=\"x&#xA;y\" p:a=\"1\" q:z=\"2\"><e></e><!--c-->&lt;&amp;</r>")
}
// Rust: crates/jet-foundation/src/XmlPull.rs:4614
#Test("projection_helpers_follow_d_encxml_projection1_a") {
    doc :: parse_document("<catalog xmlns:s=\"urn:shop\"><s:book id=\"7\"><title>Hi</title><s:price currency=\"USD\">9</s:price><!--note--></s:book></catalog>").expect("parse")
    root :: document_root(&doc).expect("root")
    assert(expanded_name_parts(&root).expect("name") == ("catalog", None, "catalog", None))
    assert(lookup_attribute(&root, "missing").expect("attr") == None)
    book :: element_content(&root).expect("content").into_iter().find(fn(node) { field(node, "$xml") == Val(Value.Text("element")) }).expect("book")
    (_, _, book_local, book_uri) :: expanded_name_parts(&book).expect("book name")
    assert(book_local == "book")
    assert(book_uri == Val("urn:shop"))
    assert(lookup_attribute(&book, "id").expect("id") == Val("7"))
    assert(lookup_attribute(&book, "{urn:shop}id").expect("clark") == None)
    projected :: project_document_for_decode(&doc).expect("project")
    entries :: match projected { Value.Object(items) => items, _ => { panic("object") } }
    assert(entries.iter().any(fn(item) { item.0 == "{urn:shop}book" }))
    book_proj :: entries.iter().find(fn(item) { item.0 == "{urn:shop}book" }).expect("book proj").1
    book_entries :: match book_proj { Value.Object(items) => items, _ => { panic("book object") } }
    assert(book_entries.iter().any(fn(item) { item.0 == "@id" && item.1 == Value.Text("7") }))
    assert(book_entries.iter().any(fn(item) { item.0 == "$content" }))
    assert(!book_entries.iter().any(fn(item) { item.0 == "$text" }))
}
// Rust: crates/jet-foundation/src/XmlPull.rs:4667
#Test("projection_maps_simple_children_and_price_for_codable") {
    doc :: parse_document("<catalog><book id=\"7\"><title>Hi</title><price currency=\"USD\">9</price></book><book id=\"8\"><title>Lo</title><price currency=\"EUR\">3</price></book></catalog>").expect("parse")
    projected :: project_document_for_decode(&doc).expect("project")
    entries :: match projected { Value.Object(items) => items, _ => { panic("object") } }
    book :: match entries.iter().find(fn(item) { item.0 == "book" }).map(fn(item) { item.1 }) { Val(Value.Array(items)) => &items[0], _ => { panic("expected book array") } }
    book_entries :: match book { Value.Object(items) => items, _ => { panic("book object") } }
    assert(book_entries.iter().any(fn(item) { item.0 == "@id" && item.1 == Value.Text("7") }))
    assert(book_entries.iter().any(fn(item) { item.0 == "title" && item.1 == Value.Text("Hi") }))
    price :: book_entries.iter().find(fn(item) { item.0 == "price" }).expect("price").1
    price_entries :: match price { Value.Object(items) => items, _ => { panic("price object") } }
    assert(price_entries.iter().any(fn(item) { item.0 == "@currency" && item.1 == Value.Text("USD") }))
    assert(price_entries.iter().any(fn(item) { item.0 == "$text" && item.1 == Value.Text("9") }))
}
