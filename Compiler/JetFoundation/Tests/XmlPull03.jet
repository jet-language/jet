// Rust: crates/jet-foundation/src/XmlPull.rs:3629
#Test("max_name_bytes_checks_element_raw_before_retention") {
    limits := Limits.safe()
    limits.max_name_bytes = 3
    error :: parse_document_with("<r xmlns:p='urn:p'><p:ab/></r>", &ParseOptions{entities: EntityPolicy.Preserve, limits: ^limits}).expect_err("raw name budget")
    assert(error.kind == Reason.Limit)
    assert(error.reason.contains("max_name_bytes (3)"))
    assert(error.reason.contains("element name") || error.reason.contains("name"))
}
// Rust: crates/jet-foundation/src/XmlPull.rs:3647
#Test("applies_entity_policy_and_replacement_budget") {
    source :: "<!DOCTYPE r [<!ENTITY e 'ignored'>]><r>&e;</r>"
    values :: [String:String]{"e": "value"}
    resolved :: parse_document_with(source, &ParseOptions{entities: EntityPolicy.Resolve(values.clone()), limits: Limits.safe()}).expect("explicit inert replacement")
    assert(render_document(&resolved).expect("render") == source)
    rejected :: parse_document_with(source, &ParseOptions{entities: EntityPolicy.Reject, limits: Limits.safe()}).expect_err("reject policy")
    assert(rejected.kind == Reason.Entity)
    limits := Limits.safe()
    limits.max_entity_replacement_bytes = 4
    limited :: parse_document_with(source, &ParseOptions{entities: EntityPolicy.Resolve(values.clone()), limits: ^limits}).expect_err("replacement budget")
    assert(limited.kind == Reason.Limit)
    assert(limited.reason.contains("max_entity_replacement_bytes (4)"))
    limits = Limits.safe()
    limits.max_entity_depth = 0
    limited :: parse_document_with(source, &ParseOptions{entities: EntityPolicy.Resolve(values), limits: ^limits}).expect_err("entity depth budget")
    assert(limited.kind == Reason.Limit)
    assert(limited.reason.contains("max_entity_depth (0)"))
}
// Rust: crates/jet-foundation/src/XmlPull.rs:3700
#Test("entity_policy_rejects_external_parameter_cycles_and_keeps_resolve_inert") {
    external :: parse_document("<!DOCTYPE r [<!ENTITY e SYSTEM 'file:///tmp/jet_xml_entity_probe'>]><r>&e;</r>").expect_err("external entity")
    assert(external.kind == Reason.Unsupported)
    assert(external.reason.contains("external entity"))
    parameter :: parse_document("<!DOCTYPE r [<!ENTITY % pe 'x'>]><r/>").expect_err("parameter")
    assert(parameter.kind == Reason.Unsupported)
    assert(parameter.reason.contains("parameter entity"))
    pe_ref :: parse_document("<!DOCTYPE r [<!ENTITY e '%pe;'>]><r/>").expect_err("pe ref")
    assert(pe_ref.kind == Reason.Unsupported)
    assert(pe_ref.reason.contains("parameter entity"))
    cycle :: parse_document("<!DOCTYPE r [<!ENTITY a '&b;'><!ENTITY b '&a;'>]><r>&a;</r>").expect_err("cycle")
    assert(cycle.kind == Reason.EntityCycle)
    tree :: parse_document_with("<!DOCTYPE r [<!ENTITY e 'ignored'>]><r>&e;</r>", &ParseOptions{entities: EntityPolicy.Resolve([String:String]{"e": "<x/>&y;"}), limits: Limits.safe()}).expect("inert resolve")
    document_children :: match field(&tree, "children") { Val(Value.Array(items)) => items, _ => { panic("document children") } }
    root :: document_children.iter().find(fn(node) { field(node, "$xml") == Val(Value.Text("element")) }).expect("root")
    children :: match field(root, "children") { Val(Value.Array(items)) => items, _ => { panic("root children") } }
    assert(children.len() == 1)
    assert(field(&children[0], "$xml") == Val(Value.Text("entity_ref")))
    assert(field(&children[0], "resolved_value") == Val(Value.Text("<x/>&y;")))
    assert(!children.iter().any(fn(node) { field(node, "$xml") == Val(Value.Text("element")) }), "Resolve must not reparse replacement markup")
    with_system :: parse_document("<!DOCTYPE r SYSTEM 'file:///tmp/jet_xml_entity_probe'><r/>").expect("external subset id stays inert data")
    children :: match field(&with_system, "children") { Val(Value.Array(items)) => items, _ => { panic("document children") } }
    assert(children.iter().any(fn(node) { field(node, "$xml") == Val(Value.Text("doctype")) && field(node, "system_id") == Val(Value.Text("file:///tmp/jet_xml_entity_probe")) }))
}
// Rust: crates/jet-foundation/src/XmlPull.rs:3769
fn lex_chunks(bytes: View<U8>, split: USize) -> [(TokenKind, String, [U8])] Never! {
    lexer := ByteLexer.new(1024)
    lexer.push(bytes[..split]).expect("first chunk")
    tokens := [(TokenKind, String, [U8])]{}
    loop { token :: lexer.next_token().expect("first tokens"); if token is Val(t) { tokens.push((t.kind, ^t.text, ^t.raw_bytes)) } else { break } }
    lexer.push(bytes[split..]).expect("second chunk")
    lexer.finish_input().expect("finish input")
    loop { token :: lexer.next_token().expect("remaining tokens"); if token is Val(t) { tokens.push((t.kind, ^t.text, ^t.raw_bytes)) } else { break } }
    ^tokens
}
// Rust: crates/jet-foundation/src/XmlPull.rs:3785
#Test("byte_lexer_is_chunk_invariant_and_preserves_utf8_bytes") {
    bytes := [U8]{0xef, 0xbb, 0xbf}
    bytes.extend_from_slice("<r a='>'>hé&amp;<!--x>y--><![CDATA[z>]]></r>".as_bytes())
    expected :: lex_chunks(bytes.view(), bytes.len())
    loop split in 0..=bytes.len() { assert(lex_chunks(bytes.view(), split) == expected, "split {split}") }
    raw :: expected.iter().flat_map(fn(item) { item.2.clone() }).collect<[U8]>()
    assert(raw == bytes[3..])
}
// Rust: crates/jet-foundation/src/XmlPull.rs:3799
#Test("byte_lexer_decodes_utf16_at_every_byte_boundary") {
    source :: "<?xml version='1.0'?><r>🙂&amp;</r>"
    loop (encoding, bom) in [(WireEncoding, [U8])]{(WireEncoding.Utf16Le, [0xff, 0xfe]), (WireEncoding.Utf16Be, [0xfe, 0xff])} {
        wire := bom.clone()
        wire.extend(wire_bytes(source, encoding))
        expected :: lex_chunks(wire.view(), wire.len())
        loop split in 0..=wire.len() { assert(lex_chunks(wire.view(), split) == expected, "{encoding} split {split}") }
        assert(expected.iter().map(fn(item) { item.1 }).collect<String>() == source)
    }
}
// Rust: crates/jet-foundation/src/XmlPull.rs:3840
#Test("stream_bytes_validate_declaration_and_preserve_encoding_identity") {
    loop (wire, bom, declared) in [(WireEncoding, [U8], String)]{
        (WireEncoding.UTF8, [0xef, 0xbb, 0xbf], "UTF-16"), (WireEncoding.Utf16Le, [0xff, 0xfe], "UTF-8"), (WireEncoding.Utf16Be, [0xfe, 0xff], "UTF-8")
    } {
        source :: "<?xml version='1.0' encoding='{declared}'?><r/>"
        bytes := bom.clone()
        bytes.extend(wire_bytes(source, wire))
        scanner := StreamScanner.new(4096, ParseOptions.safe()).expect("scanner")
        scanner.push(bytes.view()).expect("input bytes")
        scanner.finish_input().expect("finish input")
        assert(scanner.next().expect("document start").unwrap().event == Event.DocumentStart)
        error :: scanner.next().expect_err("conflicting XML declaration")
        assert(error.kind == Reason.InvalidEncoding, "{wire}")
        assert(error.offset == bom.len(), "{wire}")
    }
    loop (wire, render, bom, declared) in [(WireEncoding, RenderEncoding, [U8], String)]{
        (WireEncoding.UTF8, RenderEncoding.UTF8Bom, [0xef, 0xbb, 0xbf], "UTF-8"),
        (WireEncoding.Utf16Le, RenderEncoding.Utf16Le, [0xff, 0xfe], "UTF-16"),
        (WireEncoding.Utf16Be, RenderEncoding.Utf16Be, [0xfe, 0xff], "UTF-16BE")
    } {
        source :: "<?xml version='1.0' encoding='{declared}'?><r>🙂</r>"
        bytes := ^bom
        bytes.extend(wire_bytes(source, wire))
        events :: stream_values(bytes.view(), bytes.len())
        writer := StreamWriter.new(render, LexicalPolicy.PreserveValid)
        output := [U8]{}
        loop event in &events { output.extend(writer.write(event).expect("write matching encoded event")) }
        assert(output == bytes, "{wire} byte identity")
    }
}
