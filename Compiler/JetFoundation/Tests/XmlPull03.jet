// Rust: crates/jet-foundation/src/XmlPull.rs:3941
#Test("byte_lexer_fuses_encoding_and_item_limit_errors") {
    invalid := ByteLexer.new(32)
    _ :: invalid.push([U8]{0xef, 0xbb, 0xbf, 0xff}.view()).expect_err("invalid UTF-8")
    first :: invalid.next_token().expect_err("terminal error")
    assert(invalid.push("<r/>".as_bytes()).expect_err("fused") == first)
    continuation := ByteLexer.new(32)
    first :: continuation.push([U8]{0xc2, 0x20, 60}.view()).expect_err("invalid continuation")
    assert(continuation.finish_input().expect_err("fused") == first)
    limited := ByteLexer.new(3)
    first :: limited.push("<root>".as_bytes()).expect_err("item limit")
    assert(first.kind == Reason.Limit)
    assert(limited.finish_input().expect_err("fused") == first)
}
// Rust: crates/jet-foundation/src/XmlPull.rs:3961
fn stream_events(bytes: View<U8>, split: USize) -> [Event] Never! {
    scanner := StreamScanner.new(4096, ParseOptions.safe()).expect("scanner")
    scanner.push(bytes[..split]).expect("first")
    events := [Event]{}
    loop { event :: scanner.next().expect("events"); if event is Val(e) { events.push(^e.event) } else { break } }
    scanner.push(bytes[split..]).expect("second")
    scanner.finish_input().expect("finish")
    loop { event :: scanner.next().expect("events"); if event is Val(e) { events.push(^e.event) } else { break } }
    ^events
}
// Rust: crates/jet-foundation/src/XmlPull.rs:3977
#Test("stream_scanner_preserves_semantics_across_every_byte_split") {
    bytes := [U8]{0xef, 0xbb, 0xbf}
    bytes.extend_from_slice("<?xml version='1.0'?><r xmlns:p='u'>x&amp;<p:c/></r>\n".as_bytes())
    expected :: stream_events(bytes.view(), bytes.len())
    loop split in 0..=bytes.len() { assert(stream_events(bytes.view(), split) == expected, "split {split}") }
    assert(match &expected[2] { Event.ElementStart{name: name, ..} => name.local == "r", _ => false })
    assert(match &expected[5] { Event.ElementStart{name: name, ..} => name.namespace_uri == Val("u"), _ => false })
    assert(expected.last() == Val(Event.DocumentEnd))
}
// Rust: crates/jet-foundation/src/XmlPull.rs:3990
fn stream_values(bytes: View<U8>, split: USize) -> [Value] Never! {
    scanner := StreamScanner.new(4096, ParseOptions.safe()).expect("scanner")
    values := [Value]{}
    scanner.push(bytes[..split]).expect("first chunk")
    loop { event :: scanner.next().expect("first events"); if event is Val(e) { values.push(stream_event_value(^e)) } else { break } }
    scanner.push(bytes[split..]).expect("second chunk")
    scanner.finish_input().expect("finish input")
    loop { event :: scanner.next().expect("last events"); if event is Val(e) { values.push(stream_event_value(^e)) } else { break } }
    ^values
}
// Rust: crates/jet-foundation/src/XmlPull.rs:4006
#Test("stream_writer_preserves_every_event_across_every_input_split") {
    source := [U8]{0xef, 0xbb, 0xbf}
    source.extend_from_slice("<?xml version='1.0' encoding='UTF-8'?><r xmlns:p='urn:p' p:z='1'>x&amp;<![CDATA[<y>]]><!--c--><?go now?><p:e/></r>".as_bytes())
    loop split in 0..=source.len() {
        writer := StreamWriter.new(RenderEncoding.UTF8Bom, LexicalPolicy.PreserveValid)
        output := [U8]{}
        loop event in stream_values(source.view(), split) { output.extend(writer.write(&event).expect("write event")) }
        assert(writer.is_finished())
        assert(output == source, "split {split}")
    }
}
// Test-only mutable traversal: preserves the original object/array mutation rather than reparsing fixtures.
fn xmlpull03_slot(value: &Value, key: String) -> &Value Never! {
    match value { Value.Object(entries) => &entries.iter_mut().find(fn(item) { item.0 == key }).expect(key).1, _ => { panic("object") } }
}
fn xmlpull03_array(value: &Value) -> &[Value] Never! { match value { Value.Array(items) => &items, _ => { panic("array") } } }
// Rust: crates/jet-foundation/src/XmlPull.rs:4021
#Test("stream_writer_rejects_hostile_raw_byte_evidence") {
    source :: "<r  a='x'/>".as_bytes()
    loop case in [String]{"negative byte", "oversized byte", "extra key", "both raw forms"} {
        events := stream_values(source, source.len())
        lexical := xmlpull03_slot(&events[1], "open_lexical")
        match case {
            "negative byte" | "oversized byte" => { *xmlpull03_slot(lexical, "raw_bytes") = Value.Array([Value.Int(if case == "negative byte" { -1 } else { 256 })]) }
            "extra key" => { match lexical { Value.Object(entries) => entries.push(("extra", Value.Null)), _ => { panic("open_lexical object") } } }
            "both raw forms" => { *xmlpull03_slot(lexical, "raw_text") = Value.Text("<forged/>") }
            _ => { panic("unreachable") }
        }
        writer := StreamWriter.new(RenderEncoding.UTF8, LexicalPolicy.PreserveValid)
        output := [U8]{}
        loop event in &events { output.extend(writer.write(event).expect("write hostile event deterministically")) }
        assert(output == "<r a='x'/>".as_bytes(), case)
        assert(output != source, "{case} replayed forged raw bytes")
    }
}
// Rust: crates/jet-foundation/src/XmlPull.rs:4073
#Test("stream_writer_emits_selected_encoding_and_rejects_state_without_output") {
    source :: "<r a='x'>z</r>"
    events :: stream_values(source.as_bytes(), source.len())
    loop (encoding, wire, bom) in [(RenderEncoding, WireEncoding, [U8])]{
        (RenderEncoding.UTF8, WireEncoding.UTF8, []), (RenderEncoding.Utf16Le, WireEncoding.Utf16Le, [0xff, 0xfe]), (RenderEncoding.Utf16Be, WireEncoding.Utf16Be, [0xfe, 0xff])
    } {
        writer := StreamWriter.new(encoding, LexicalPolicy.Deterministic)
        output := [U8]{}
