use JetFoundation.Coverage.[CoverageEntry, CoverageFact, CoverageBaseline, try_facts, validate_non_decreasing]
use JetFoundation.Report.[NoFixReasonKind]

// Rust: crates/jet-foundation/src/Coverage.rs:68
// No original inline tests; deterministic facts and validation controls.
#Test("coverage facts sort planes and preserve repair reason counters") {
    rows :: try_facts([CoverageEntry]{
        CoverageEntry.new("z", false, None),
        CoverageEntry.new("a", true, None),
        CoverageEntry.new("a", false, Val(NoFixReasonKind.Behavior)),
        CoverageEntry.new("a", false, Val(NoFixReasonKind.Design)),
        CoverageEntry.new("a", false, Val(NoFixReasonKind.Ambiguous))
    }) ?? panic("valid coverage")
    assert(rows.len() == 2 && rows[0].plane == "a" && rows[1].plane == "z")
    assert(rows[0].rows == 4 && rows[0].edit_covered == 1 && rows[0].reason_covered == 3)
    assert(rows[0].behavior_reasons == 1 && rows[0].design_reasons == 1 && rows[0].ambiguous_reasons == 1)
    assert(rows[0].is_closed() && rows[1].uncovered == 1)
    assert(try_facts([CoverageEntry]{CoverageEntry.new(" ", false, None)}).is_err())
    assert(try_facts([CoverageEntry]{CoverageEntry.new("a", true, Val(NoFixReasonKind.Design))}).is_err())
}
// Rust: crates/jet-foundation/src/Coverage.rs:118,156,169,203,244
#Test("coverage baseline parsing projection and ratchet") {
    baseline :: CoverageBaseline.parse("# floor\nz 0 0 1\na 1 2 3\n") ?? panic("valid baseline")
    assert(baseline.render() == "a 1 2 3\nz 0 0 1\n")
    rows :: baseline.facts()
    assert(rows[0].uncovered == 0 && rows[1].uncovered == 1)
    assert(CoverageBaseline.from_facts(rows).render() == baseline.render())
    _ :: baseline.validate(rows) ?? panic("unchanged baseline rejected")
    assert(CoverageBaseline.parse("a 2 0 1").is_err())
    assert(CoverageBaseline.parse("a 1 0 1\na 1 0 1").is_err())
    assert(CoverageBaseline.parse("a -1 0 1").is_err())
    assert(CoverageBaseline.parse("a 1 0").is_err())
    assert(baseline.validate([CoverageFact]{}).is_err())
    assert(validate_non_decreasing(CoverageFact{plane: "a", rows: 1, edit_covered: 1},
        CoverageFact{plane: "a", rows: 1, reason_covered: 1}).is_err())
    assert(baseline.validate([CoverageFact]{rows[0], CoverageFact{plane: "z", rows: 2, uncovered: 2}}).is_err())
}
