// A dimension identity names its axes by escaped name and exponent; reading
// one back gives the same dimension, so its identity is unchanged too.
use jet_foundation.[
    Dimension, DimensionAxis, Measure, dimension_from_identity, dimension_identity,
    dimension_identity_equal,
]

dimension_identity_axis: fn(name: String, exponent: Int) -> DimensionAxis {
    DimensionAxis{name: name, exponent: Measure.SignedLiteral{kind: "dimension", value: exponent}}
}

#Test("dimension_identity_round_trips") {
    dimensions: [Dimension]{
        Dimension{axes: [DimensionAxis]{}},
        Dimension{axes: [DimensionAxis]{dimension_identity_axis("core.units::Length", 1)}},
        Dimension{axes: [DimensionAxis]{dimension_identity_axis("physics::Länge", 2), dimension_identity_axis("physics::時間", -1)}},
        Dimension{axes: [DimensionAxis]{dimension_identity_axis("Température", 3)}},
        Dimension{axes: [DimensionAxis]{dimension_identity_axis("odd%3A;name:%", -2)}},
    }
    loop dimension in dimensions {
        identity: dimension_identity(dimension)
        back: dimension_from_identity(identity) ?? panic("`{identity}` reads back as a dimension")
        assert(dimension_identity_equal(back, dimension))
        assert(dimension_identity(back) == identity)
    }
    assert(dimension_from_identity("core.units::Length") == None)
    assert(dimension_from_identity("Length:x") == None)
    assert(dimension_from_identity("Length:0") == None)
}
