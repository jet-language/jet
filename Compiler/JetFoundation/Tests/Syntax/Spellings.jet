// Original Syntax/core_surface.rs/package_files.rs/effects_surface.rs values.
// Completion/rename catalogs stay separate from retired diagnostic spellings.
#Test("canonical_tool_spelling_tables_preserve_complete_original_order") {
    assert_eq(BUILTIN_EFFECT_LEAVES, [String]{"DB.Read", "DB.Write", "FS.Read", "FS.Write", "Rand.Draw", "Exec.Exit", "Exec.Args", "Time.Wait", "FFI.Go", "FFI.Java", "FFI.DotNet", "FFI.Fortran", "FFI.Cobol", "FFI.Tcl", "FFI.Lua", "FFI.Ada", "FFI.Pascal", "FFI.Dart", "FFI.PowerShell", "FFI.Perl", "FFI.Ruby", "FFI.Php", "FFI.R", "FFI.Com", "FFI.C", "FFI.Cpp", "FFI.Asm", "FFI.Py", "FFI.Octave"})
    assert_eq(REF_SOURCE_PROVIDERS, [String]{"jetpack", "nixpkgs", "github", "path", "cran", "luarocks", "ruby", "perl", "php", "jet-registry", "npm", "cargo", "pypi", "swiftpm", "releases"})
    assert_eq(COMMAND_ROLE_FILES, [String]{"@run.jet", "@build.jet", "@dev.jet", "@test.jet"})
    assert_eq(jet_keyword_names(), [String]{"fn", "pub", "priv", "use", "as", "extern", "module", "if", "else", "loop", "in", "break", "return", "defer", "struct", "enum", "alias", "impl", "policy", "wrap", "trait", "tag", "effect", "derive", "distinct", "migration", "rename", "add", "remove", "change", "via", "self", "Unsafe", "Impure", "Context", "task", "freeze", "shared", "Transact", "Job", "Test", "Todo", "State", "Transition", "state", "protocol", "client", "server", "marker", "validate", "check", "true", "false", "None", "it"})
    assert_eq(jet_type_names(), [String]{"Int", "Float", "Bool", "String", "()", "Char", "Err", "Shared", "SharedSnapshot", "SharedRevisionError", "SharedGuard", "Shared.Weak", "Condition", "Task", "Receiver", "Sender", "TaskFailure", "HashMap", "BTreeMap", "Map", "Queue", "Set", "Rank", "PriorityQueue", "Cache", "Tally", "Bits", "Bytes", "ViewIter", "I8", "I16", "I32", "I64", "U8", "U16", "U32", "U64", "F32", "F64"})
}
#Test("canonical_sigils_keep_mutation_move_and_comptime_slots_distinct") {
    assert_eq(KW_COPY, "copy")
    assert_eq(KW_MUTATE, "mut")
    assert_eq(KW_MOVE, "take")
    assert_eq(SIGIL_BIND_IMMUT, "::")
    assert_eq(SIGIL_BIND_MUT, ":=")
    assert_eq(SIGIL_WRITE, "&")
    assert_eq(SIGIL_COPY, "~")
    assert_eq(SIGIL_MOVE, "^")
    assert_eq(COMPTIME_MARK, "$")
    assert_eq(SIGIL_FENCE_OPEN, "<:")
    assert_eq(SIGIL_FENCE_CLOSE, ":>")
    assert_eq(SIGIL_SPREAD, "...")
    assert_eq(FILE_EXT, "jet")
    assert_eq(UNIFIED_LOCK_FILE, ".jet/lock")
    assert_eq(ENV_FILE, "env.jet")
    assert_eq(CONFIG_FILE, "config.jet")
    assert_eq(WORKSPACE_FILE, "workspace.jet")
    assert_eq(TARGET_SANDBOX, "sandbox")
    assert_eq(RETIRED_TARGET_PLUGIN, "plugin")
    assert_eq(ENGINE_PROTOCOL_FLAG, "--engine-protocol")
    assert_eq(RETIRED_COMPTIME_MARK, "@")
}
