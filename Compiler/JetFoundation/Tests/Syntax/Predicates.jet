use jet_foundation.Syntax.Predicates.[is_known_core_module, KNOWN_CORE_MODULES, generated_name, generated_path, generated_suffix, is_reserved_generated_name, sanitize_crate_name]
use jet_foundation.Syntax.Spellings.[GENERATED_NAME_PREFIX, classify_identifier, IdentifierClass]

// Rust: crates/jet-foundation/src/Syntax/predicates.rs:88
#Test("core_module_keys_reject_internal_jet_prefix") {
    assert(KNOWN_CORE_MODULES.all((name) -> !name.starts_with("jet.")))
    loop ring in [String]{"log", "crypto", "http", "regex", "reactive", "archive", "game", "db", "plugin", "time", "web.router", "web.query", "web.forms", "web.table", "web.virtual", "web.store"} {
        assert(is_known_core_module("core.{ring}"))
        assert(!is_known_core_module("jet.{ring}"))
    }
}
// Rust: crates/jet-foundation/src/Syntax/predicates.rs:587
#Test("generated_names_have_one_machine_prefix") {
    assert_eq(generated_name("run"), "__jet_run")
    assert_eq(generated_name("__jet_run"), "__jet_run")
    assert_eq(generated_path("grades.curve"), "__jet_grades_dcurve")
    assert_eq(generated_path("__jet_grades__curve"), "__jet__u_ujet_ugrades_u_ucurve")
    assert_eq(generated_path("__jet_grades.curve"), "__jet__u_ujet_ugrades_dcurve")
    assert_eq(generated_suffix("__jet_run"), "run")
}
// Rust: crates/jet-foundation/src/Syntax/predicates.rs:603
#Test("generated_paths_are_injective_across_identity_separators") {
    identities :: [String]{"a::b", "a/b", "a\\b", "a_b", "a.b", "a-b", "a:x"}
    symbols := [String]{}
    loop name in identities -> &symbols.push(generated_path(name))
    loop (index, symbol) in symbols {
        assert(symbol.starts_with(GENERATED_NAME_PREFIX))
        suffix := symbol.after(GENERATED_NAME_PREFIX) // #4303
        assert(suffix.bytes().all((byte) -> byte.is_ascii_alphanumeric() || byte == 95))
        assert(symbols[(index + 1)..<symbols.len()].all((other) -> other != symbol))
    }
}
// Rust: crates/jet-foundation/src/Syntax/predicates.rs:616
#Test("crate_names_are_rust_safe") {
    assert_eq(sanitize_crate_name("panic_lexical_task.group"), "panic_lexical_task_group")
    assert_eq(sanitize_crate_name("3d-demo"), "_3d_demo")
    assert_eq(sanitize_crate_name(""), "out")
}
// Rust: crates/jet-foundation/src/Syntax/predicates.rs:625
#Test("canonical_core_names_are_reserved_for_generated_names") {
    loop name in [String]{"Decimal", "Duration", "Date", "LocalDate", "LocalTime", "EncodingError"} -> assert(is_reserved_generated_name(name), "unreserved canonical Core name `{name}`")
}
// Rust: crates/jet-foundation/src/Syntax/predicates.rs:642
#Test("underscore_ladder_has_one_source_classification") {
    assert_eq(classify_identifier("_"), IdentifierClass.Ordinary)
    assert_eq(classify_identifier("_name"), IdentifierClass.SoftPublic)
    assert_eq(classify_identifier("__name"), IdentifierClass.Reserved)
    assert_eq(classify_identifier("__name__"), IdentifierClass.Reserved)
    assert_eq(classify_identifier("name_"), IdentifierClass.Ordinary)
}
