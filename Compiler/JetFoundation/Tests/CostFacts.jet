// Exercise the production frozen-TIR fact channel in the canonical unit.
use jet_foundation.[
    Span, TBinaryOp, TCostFact, TCostKind, TCostState, TExpr, TExprKind, TIntegerBounds, TUnaryOp,
    Type, tir_cost_combine_bounds, tir_expr_facts, tir_user_local,
]

fn cost_fact_expression(kind: TExprKind, ty: Type) -> TExpr Never! {
    TExpr{ty: ty, kind: kind, span: Span{start: 0, end: 1}}
}
#Test("cost_facts") {
    one :: cost_fact_expression(TExprKind.IntLit{value: 1, width: None}, Type.Int)
    two :: cost_fact_expression(TExprKind.IntLit{value: 2, width: None}, Type.Int)
    small :: cost_fact_expression(TExprKind.Binary{op: TBinaryOp.Add, overflow: false, line: 1, lhs: one, rhs: two}, Type.Int)
    assert(tir_expr_facts(small).cost == Val(TCostFact{kind: TCostKind.ExactIntSpill, state: TCostState.OptimizerRemoved}))
    unknown :: cost_fact_expression(TExprKind.Local{local: tir_user_local("input", Span{start: 0, end: 1})}, Type.Int)
    dynamic :: cost_fact_expression(TExprKind.Binary{op: TBinaryOp.Mul, overflow: false, line: 1, lhs: unknown, rhs: two}, Type.Int)
    assert(tir_expr_facts(dynamic).cost == Val(TCostFact{kind: TCostKind.ExactIntSpill, state: TCostState.SemanticRemainder}))
    minimum :: cost_fact_expression(TExprKind.IntLit{value: -4611686018427387904, width: None}, Type.Int)
    negated :: cost_fact_expression(TExprKind.Unary{op: TUnaryOp.Neg, operand: minimum}, Type.Int)
    assert(tir_expr_facts(negated).cost == Val(TCostFact{kind: TCostKind.ExactIntSpill, state: TCostState.SemanticRemainder}))
    carrier :: cost_fact_expression(TExprKind.Present{value: one}, Type.Option{inner: Type.Int})
    assert(tir_expr_facts(carrier).cost == Val(TCostFact{kind: TCostKind.OutcomeConstruction, state: TCostState.SemanticRemainder}))
    view :: cost_fact_expression(TExprKind.MaterializeView{value: unknown}, Type.List{element: Type.Int})
    assert(tir_expr_facts(view).cost == Val(TCostFact{kind: TCostKind.ViewMaterialization, state: TCostState.SemanticRemainder}))
    assert(tir_cost_combine_bounds(TBinaryOp.FloorDiv, TIntegerBounds{lo: -7, hi: -7}, TIntegerBounds{lo: 2, hi: 2}) == Val(TIntegerBounds{lo: -4, hi: -4}))
    assert(tir_cost_combine_bounds(TBinaryOp.FloorDiv, TIntegerBounds{lo: 1, hi: 2}, TIntegerBounds{lo: -1, hi: 1}) == None)
    assert(tir_cost_combine_bounds(TBinaryOp.Mul, TIntegerBounds{lo: -3, hi: 2}, TIntegerBounds{lo: -4, hi: 5}) == Val(TIntegerBounds{lo: -15, hi: 12}))
}
