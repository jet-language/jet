// Rebasing Core record rows into a graph (JetDriver CoreRecordRebase.jet):
// record module indexes map to graph module indexes. A taken body's DeclIDs
// are sema's to rebase (JetSema Tests/CoreRecordBodies.jet). Kept beside the
// record codec's tests, not in the driver's test package, whose files
// compile most of the compiler.
use {
    jet_driver.[jet_driver_core_record_rebase_module]
}

#Test("A rebase maps record module indexes and refuses a module the graph hasn't taken") {
    modules: [Int]{4, -1, 2}
    assert_eq(jet_driver_core_record_rebase_module(modules, 0) ?? -9, 4)
    assert_eq(jet_driver_core_record_rebase_module(modules, 2) ?? -9, 2)
    assert_eq(jet_driver_core_record_rebase_module(modules, 1) ?? -9, -9)
    assert_eq(jet_driver_core_record_rebase_module(modules, 3) ?? -9, -9)
    assert_eq(jet_driver_core_record_rebase_module(modules, -1) ?? -9, -9)
}
