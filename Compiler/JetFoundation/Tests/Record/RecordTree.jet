// Record trees: Dyn rows written once by id and read back on demand.
use jet_foundation.[
    RecordReader, RecordSection, RecordTreeTables, RecordValue, record_encode, record_open_schema,
    record_tree_add, record_tree_difference, record_tree_row, record_tree_tables, record_tree_view, record_tree_writer,
]

RECORD_TREE_TEST_SCHEMA: "jet.tree-test/v1"

// The `push` symbol of core.list, or its `pop`.
record_tree_test_symbol: fn(pop: Bool) -> Dyn Never! {
    Dyn.Object([(key: String, value: Dyn)]{
        (key: "owner", value: Dyn.Text("core.list")),
        (key: "name", value: Dyn.Text(if pop -> "pop" else -> "push")),
        (key: "span", value: Dyn.Object([(key: String, value: Dyn)]{(key: "start", value: Dyn.Int(12)), (key: "end", value: Dyn.Int(40))})),
    })
}

record_tree_test_rows: fn() -> [Dyn] Never! {
    shared: record_tree_test_symbol(false)
    [Dyn]{
        Dyn.Array([Dyn]{shared, shared, record_tree_test_symbol(true)}),
        Dyn.Object([(key: String, value: Dyn)]{
            (key: "symbol", value: shared),
            (key: "count", value: Dyn.Int(0 - 9223372036854775807 - 1)),
            (key: "ratio", value: Dyn.Float(-2.5)),
            // core.math's `NAN`: `==` on it is false, its bits read back.
            (key: "nan", value: Dyn.Float(Float{0.0} / Float{0.0})),
            (key: "raw", value: Dyn.Bytes([U8]{0, 255, 7})),
            (key: "none", value: Dyn.Null),
            (key: "flags", value: Dyn.Array([Dyn]{Dyn.Bool(true), Dyn.Bool(false)})),
            (key: "empty", value: Dyn.Object([(key: String, value: Dyn)]{})),
            (key: "text", value: Dyn.Text("é")),
        }),
        Dyn.Text("push"),
        Dyn.Int(0),
        // Past i64: a u64 at i64's maximum plus one and at its own maximum
        // (an all-ones mask), i64's minimum minus one, and 2^128 + 1.
        Dyn.Array([Dyn]{
            Dyn.Int(9223372036854775808), Dyn.Int(18446744073709551615),
            Dyn.Int(0 - 9223372036854775807 - 2), Dyn.Int(340282366920938463463374607431768211457),
        }),
    }
}

record_tree_test_tables: fn(rows: [Dyn]) -> RecordTreeTables Never! {
    writer := record_tree_writer()
    added := [[U8]]{}
    loop row in rows -> added.push(record_tree_add(writer, row))
    record_tree_tables(writer.move(), [[[U8]]]{added})
}

// A record of the tables' one row section (1) and three tables (2, 3, 4),
// which move into it; `broken` names a string out of range in row 2.
record_tree_test_reader: fn(tables: &&RecordTreeTables, broken: Bool) -> RecordReader Never! {
    held := tables.move()
    rows := held.rows.pop() ?? [RecordValue]{}
    if broken -> rows[2] = RecordValue.Bytes{value: [U8]{5, 120}}
    sections: [RecordSection]{
        RecordSection{id: 1, elements: rows.move()},
        RecordSection{id: 2, elements: held.strings.move()},
        RecordSection{id: 3, elements: held.shapes.move()},
        RecordSection{id: 4, elements: held.nodes.move()},
    }
    encoded: record_encode(RECORD_TREE_TEST_SCHEMA, sections)
    opened: record_open_schema(encoded.bytes ?? panic("the tree record encodes"), RECORD_TREE_TEST_SCHEMA)
    opened.reader ?? panic("the tree record opens")
}

#Test("a record tree reads back every row it was written from") {
    rows: record_tree_test_rows()
    tables := record_tree_test_tables(rows)
    assert_eq(tables.problem, None)
    reader: record_tree_test_reader(tables.move(), false)
    opened: record_tree_view(reader, 2, 3, 4)
    view: opened.view ?? panic("the tree view opens: {opened.problem ?? ""}")
    loop (index, row) in rows {
        read: record_tree_row(reader, view, 1, index)
        assert_eq(read.problem, None)
        assert_eq(record_tree_difference(read.value ?? panic("row {index} reads"), row), None)
    }
}

#Test("a record tree writes each string as the bytes it does not share with the one before it") {
    // More strings than RECORD_TREE_HOT_STRINGS, so the rest are in byte
    // order; each shares its leading `core.list::item/` with its neighbours.
    texts := [Dyn]{}
    loop index in 0..<16500 -> texts.push(Dyn.Text("core.list::item/{index}"))
    rows: [Dyn]{Dyn.Array(texts), Dyn.Text("core.list::item/16499")}
    tables := record_tree_test_tables(rows)
    assert_eq(tables.problem, None)
    if tables.strings[1] == .Bytes(data) -> assert(data.len() < 16500 * 8, "the string table shares leading bytes ({data.len()} bytes)") else -> panic("the string data is bytes")
    reader: record_tree_test_reader(tables.move(), false)
    view: record_tree_view(reader, 2, 3, 4).view ?? panic("the tree view opens")
    loop (index, row) in rows {
        read: record_tree_row(reader, view, 1, index)
        assert_eq(read.problem, None)
        assert_eq(record_tree_difference(read.value ?? panic("row {index} reads"), row), None)
    }
}

#Test("a record tree row reads its strings in any order and repeated, each block walked once") {
    // 40 strings over three string blocks, named out of order and twice,
    // so a block's later string is read before its earlier ones and a
    // block is resumed past the strings already decoded; the objects share
    // one shape.
    items := [Dyn]{}
    loop lap in 0..<2 {
        loop index in 0..<40 {
            named: (index * 7 + lap) % 40
            items.push(Dyn.Text("core.text::item/{named}"))
            items.push(Dyn.Object([(key: String, value: Dyn)]{(key: "name", value: Dyn.Text("core.text::item/{named}")), (key: "at", value: Dyn.Int(index))}))
        }
    }
    rows: [Dyn]{Dyn.Array(items), Dyn.Text("core.text::item/39"), Dyn.Text("core.text::item/0")}
    tables := record_tree_test_tables(rows)
    assert_eq(tables.problem, None)
    reader: record_tree_test_reader(tables.move(), false)
    view: record_tree_view(reader, 2, 3, 4).view ?? panic("the tree view opens")
    loop (index, row) in rows {
        read: record_tree_row(reader, view, 1, index)
        assert_eq(read.problem, None)
        assert_eq(record_tree_difference(read.value ?? panic("row {index} reads"), row), None)
    }
}

#Test("a record tree stores a repeated subtree once and writes a single use in place") {
    tables: record_tree_test_tables(record_tree_test_rows())
    // The `push` symbol (three uses) and the span both symbols share are
    // stored, in one node block; the `pop` symbol and every scalar are
    // written in place.
    if tables.nodes[0] == .Bytes(ends) -> assert_eq(ends.len(), 4) else -> panic("the node end column is bytes")
    // The most named node takes the first id: the `push` symbol (three node
    // items) before its span (two), though the span was interned first.
    if tables.rows[0][0] == .Bytes(row) -> assert_eq(row.slice(0, 6), [U8]{7, 3, 9, 0, 9, 0}) else -> panic("a tree row is bytes")
    again: record_tree_test_tables(record_tree_test_rows())
    assert(again.nodes == tables.nodes && again.rows == tables.rows && again.strings == tables.strings && again.shapes == tables.shapes)
}

#Test("a record tree reads back each stored node of a full node block and the blocks after it") {
    // 70 distinct subtrees, each named twice: three node blocks, the last
    // one part full.
    pairs := [Dyn]{}
    loop index in 0..<70 {
        pairs.push(Dyn.Array([Dyn]{Dyn.Int(index), Dyn.Text("node/{index}")}))
        pairs.push(Dyn.Array([Dyn]{Dyn.Int(index), Dyn.Text("node/{index}")}))
    }
    rows: [Dyn]{Dyn.Array(pairs)}
    tables := record_tree_test_tables(rows)
    assert_eq(tables.problem, None)
    if tables.nodes[0] == .Bytes(ends) -> assert_eq(ends.len(), 12) else -> panic("the node end column is bytes")
    reader: record_tree_test_reader(tables.move(), false)
    view: record_tree_view(reader, 2, 3, 4).view ?? panic("the tree view opens")
    read: record_tree_row(reader, view, 1, 0)
    assert_eq(read.problem, None)
    assert_eq(record_tree_difference(read.value ?? panic("the row reads"), rows[0]), None)
}

#Test("a record tree writes an object's values as payloads alone and an array of one tag as a typed array") {
    rows: [Dyn]{
        Dyn.Object([(key: String, value: Dyn)]{(key: "flag", value: Dyn.Bool(true)), (key: "none", value: Dyn.Null)}),
        Dyn.Array([Dyn]{Dyn.Int(1), Dyn.Int(2), Dyn.Int(3)}),
        // Items with no payload stay a plain array.
        Dyn.Array([Dyn]{Dyn.Bool(true), Dyn.Bool(false)}),
    }
    tables := record_tree_test_tables(rows)
    assert_eq(tables.problem, None)
    // The shape names both values' tags, so the object is its shape id.
    if tables.rows[0][0] == .Bytes(object) -> assert_eq(object, [U8]{8, 0}) else -> panic("a tree row is bytes")
    if tables.rows[0][1] == .Bytes(ints) -> assert_eq(ints, [U8]{11, 3, 3, 2, 4, 6}) else -> panic("a tree row is bytes")
    if tables.rows[0][2] == .Bytes(flags) -> assert_eq(flags, [U8]{7, 2, 2, 1}) else -> panic("a tree row is bytes")
    reader: record_tree_test_reader(tables.move(), false)
    view: record_tree_view(reader, 2, 3, 4).view ?? panic("the tree view opens")
    loop (index, row) in rows {
        read: record_tree_row(reader, view, 1, index)
        assert_eq(read.problem, None)
        assert_eq(record_tree_difference(read.value ?? panic("row {index} reads"), row), None)
    }
}

#Test("a record tree difference names the first path where two trees differ") {
    rows: record_tree_test_rows()
    loop row in rows -> assert_eq(record_tree_difference(row, row), None)
    changed: Dyn.Array([Dyn]{record_tree_test_symbol(false), record_tree_test_symbol(false), record_tree_test_symbol(false)})
    assert_eq(record_tree_difference(rows[0], changed), Val("[2].name: Text(\"pop\"), then Text(\"push\")"))
    assert(record_tree_difference(Dyn.Float(Float{0.0} / Float{0.0}), Dyn.Float(1.0)) != None)
    assert_eq(record_tree_difference(Dyn.Array([Dyn]{}), Dyn.Null), Val(": an array, then null"))
}

#Test("a record tree writes an int past i64 as a wide int and refuses a malformed row") {
    writer := record_tree_writer()
    row: record_tree_add(writer, Dyn.Int(18446744073709551615))
    assert_eq(row, [U8]{10, 0, 8, 255, 255, 255, 255, 255, 255, 255, 255})
    assert_eq(record_tree_add(writer, Dyn.Int(0 - 9223372036854775807 - 2)), [U8]{10, 1, 8, 128, 0, 0, 0, 0, 0, 0, 0})
    assert_eq(record_tree_tables(writer.move(), [[[U8]]]{}).problem, None)
    tables := record_tree_test_tables(record_tree_test_rows())
    reader: record_tree_test_reader(tables.move(), true)
    view: record_tree_view(reader, 2, 3, 4).view ?? panic("the tree view opens")
    assert_eq(record_tree_row(reader, view, 1, 2).problem, Val("record is malformed: tree string 120 is out of range"))
    assert_eq(record_tree_view(reader, 2, 3, 9).problem, Val("record section 9 is missing"))
}
