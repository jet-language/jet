// CLISchema.rs JobRegistry discovery/projection and exact graph controls.
// Static parser discovery is intentionally not a checked Every producer proof.
use jet_parser.[parse_source]

fn job_registry_test_program(source: String) -> Program Never! {
    parsed :: parse_source(source.bytes())
    assert_eq(parsed.diagnostics.len(), 0)
    parsed.program
}

#Test("job_registry_projects_native_arguments_doc_and_default_policy") {
    program :: job_registry_test_program("#[Job, Doc(\"Build the package\")]\nfn compile(target: String, release: Bool = false, count: Int = 2, more: ...String) {{}}\nfn run() {{}}\n")
    registry :: JobRegistry.from_program(program)
    assert_eq(registry.jobs().len(), 1)
    job :: registry.find("compile") ?? panic("the top-level job was not discovered")
    assert_eq(job.doc, Val("Build the package"))
    assert_eq(job.scope_name(), "dev")
    assert_eq(job.schedule, None)
    assert_eq(job.parallel, 1)
    assert_eq(job.cache, JobCachePolicy.Uncached)
    assert_eq(job.arguments.len(), 4)
    assert(job.arguments[0].required)
    assert_eq(job.arguments[0].display(), "target: String")
    assert(!job.arguments[1].required)
    assert_eq(job.arguments[1].default, Val("false"))
    assert_eq(job.arguments[2].default, Val("2"))
    assert(!job.arguments[3].required)
    assert(job.arguments[3].variadic)
    assert_eq(job.arguments[3].display(), "more: ...String")
    assert_eq(job.metadata().parallel, Val(1))
}

#Test("job_registry_visibility_and_completion_preserve_discovery_order") {
    program :: job_registry_test_program("#Job(.Internal) fn hidden() {{}}\n#Job(.Ship) fn ship() {{}}\n#Job fn build_job() {{}}\n#Job fn ship() {{}}\nfn ordinary() {{}}\n")
    registry :: JobRegistry.from_program(program)
    assert_eq(registry.jobs().len(), 4)
    assert_eq(registry.visible_jobs().len(), 3)
    assert(registry.find("hidden") != None)
    assert_eq(registry.find_visible("hidden"), None)
    assert_eq(registry.completion_words(), [String]{"ship", "build_job"})
    assert_eq(registry.find("ship").unwrap().scope, JobScope.Ship)
}

#Test("job_registry_dependency_closure_is_dependency_first_and_includes_internal") {
    program :: job_registry_test_program("#Job(.Internal) fn setup() {{}}\n#Job(after: [\"setup\"]) fn compile() {{}}\n#Job(after: [\"setup\", \"compile\"]) fn ship() {{}}\n")
    registry :: JobRegistry.from_program(program)
    closure :: registry.dependency_closure("ship") ?? panic(err)
    names :: loop job in closure -> job.name
    assert_eq(names, [String]{"setup", "compile", "ship"})
    registry.validate_graph() ?? panic(err)
}

#Test("job_registry_graph_refusals_keep_original_error_text_and_order") {
    unknown :: JobRegistry.from_program(job_registry_test_program("#Job(after: [\"missing\"]) fn ship() {{}}\n"))
    assert_eq(unknown.dependency_closure("ship"), Err("job graph references unknown job `missing`"))
    duplicate :: JobRegistry.from_program(job_registry_test_program("#Job fn ship() {{}}\n#Job fn ship() {{}}\n"))
    assert_eq(duplicate.jobs().len(), 2)
    assert_eq(duplicate.dependency_closure("ship"), Err("job `ship` has an ambiguous declaration"))
    cycle :: JobRegistry.from_program(job_registry_test_program("#Job(after: [\"second\"]) fn first() {{}}\n#Job(after: [\"first\"]) fn second() {{}}\n"))
    assert_eq(cycle.dependency_closure("first"), Err("job graph contains a cycle: first -> second -> first"))
    // Parser admission rejects zero itself. Corrupt the real parsed AST
    // policy to exercise the registry's independent host-admission refusal.
    zero_program := job_registry_test_program("#Job(parallel: 1) fn zero() {{}}\n")
    if zero_program.items[0] == .Func(function) && function.job_metadata == .Val(metadata) -> metadata.parallel = Val(0)
    zero :: JobRegistry.from_program(zero_program)
    assert_eq(zero.dependency_closure("zero"), Err("job `zero` declares a zero parallel bound"))
}

#Test("job_registry_append_moves_rows_without_deduplicating") {
    registry := JobRegistry.from_program(job_registry_test_program("#Job fn first() {{}}\n"))
    other := JobRegistry.from_program(job_registry_test_program("#Job fn second() {{}}\n#Job fn first() {{}}\n"))
    &registry.append(^other)
    rows :: ^registry.into_jobs()
    assert_eq(rows.len(), 3)
    assert_eq(rows[0].name, "first")
    assert_eq(rows[1].name, "second")
    assert_eq(rows[2].name, "first")
}

#Test("job_registry_metadata_rehydrates_complete_parsed_policy") {
    program :: job_registry_test_program("#Job(.Ship, packages: [\"files\", \"net\"], cwd: \"build\", inputs: [\"source.jet\"], outputs: [\"app\"], skip: \"disabled on this host\", cache: .Shared, limits: [\"wall\": \"30s\", \"memory\": \"1G\"], after: [\"prepare\"], parallel: 3) fn publish() {{}}\n")
    registry :: JobRegistry.from_program(program)
    job :: registry.find("publish") ?? panic("the policy-bearing job was lost")
    metadata :: job.metadata()
    assert_eq(metadata.scope, JobScope.Ship)
    assert_eq(metadata.after, [String]{"prepare"})
    assert_eq(metadata.packages, [String]{"files", "net"})
    assert_eq(metadata.cwd, Val("build"))
    assert_eq(metadata.inputs, [String]{"source.jet"})
    assert_eq(metadata.outputs, [String]{"app"})
    assert_eq(metadata.skip, Val(JobSkip.Always{reason: "disabled on this host"}))
    assert_eq(metadata.cache, JobCachePolicy.Shared)
    assert_eq(metadata.parallel, Val(3))
    assert_eq(metadata.limits.len(), 2)
    assert_eq(metadata.limits[0].key, "memory")
    assert_eq(metadata.limits[0].value, "1G")
    assert_eq(metadata.limits[1].key, "wall")
    assert_eq(metadata.limits[1].value, "30s")
}
