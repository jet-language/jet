// A union's canonical member order is one order whether a member is written
// with a module alias or resolved to its declaration key.
use jet_foundation.[Type, type_name, type_union_sort]

union_order_names: fn(members: [Type]) -> String {
    names := [String]{}
    loop member in members -> names.push(type_name(member))
    names.join(" | ")
}

#Test("a union member's module alias or declaration key never reorders the union") {
    written := [Type]{Type.Named{name: "TaskFailure"}, Type.Named{name: "net.NetError"}, Type.Int}
    type_union_sort(written)
    assert_eq(union_order_names(written), "Int | net.NetError | TaskFailure")
    resolved := [Type]{Type.Named{name: "TaskFailure"}, Type.Named{name: "<corelib>/core.net.NetError"}, Type.Int}
    type_union_sort(resolved)
    assert_eq(union_order_names(resolved), "Int | <corelib>/core.net.NetError | TaskFailure")
}
