    assert_eq(canonical_ast_fragment<CanonicalASTFixtureDefaults>(item, defaults, false), expected.bytes())
}

#Test("strip_spans_removes_span_renderings") {
    left :: "Ident(\"x\", Span {{ start: 0, end: 1 }})"
    right :: "Ident(\"x\", Span {{ start: 40, end: 41 }})"
    expected :: "Ident(\"x\", Span)"
    assert_eq(canonical_ast_strip_spans(left), expected.bytes())
    assert_eq(canonical_ast_strip_spans(left), canonical_ast_strip_spans(right))
}
