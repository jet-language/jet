n{start: 2, end: 11}, width: Val(IntegerWidth{signed: true, bits: 64}), raw: Val("42i64")}), span: Span{start: 2, end: 11}}}}}}, script_body: [Stmt]{Stmt.Expr{expr: Expr.Str{parts: [StrPart]{StrPart.Lit{text: "Span {{ start: 5, end: 8 }}"}}, span: Span{start: 2, end: 11}}}}, block_spans: [Span]{Span{start: 2, end: 11}}, fenced_statements: [FencedStatement]{}, web_target_ceiling: Val(WebBucket.Wasm), pub_file: true, no_prelude: true, default_target: Val("web"), html_path: Val("λ.html"), policy_declarations: [PolicyDeclaration]{PolicyDeclaration{key: PolicyKey.Copies, value: PolicyValue.Limit{value: 18446744073709551615}, scope: PolicyScope.Package, span: Span{start: 2, end: 11}, target: Val(Span{start: 2, end: 11}), source: "owner"}}, user_policy_declarations: [UserPolicyDecl]{UserPolicyDecl{is_pub: false, name: "local", name_span: Span{start: 17, end: 29}, params: [Param]{}, body: [Stmt]{Stmt.Expr{expr: Expr.Bool{value: true, span: Span{start: 2, end: 11}}}}, span: Span{start: 17, end: 29}}}, applied_rules: [AppliedRuleApplication]{}, rule_facts: [AppliedRuleApplication]{}, else_arms: [ElseArmSpan]{}, used_import_names: [String]{}, debug_sites: [DebugTraceSite]{}}
