// A test-owned table implements the real borrowed provider contract. The
// expression is loaned to the same writer, not cloned or encoded separately.
struct CanonicalASTFixtureDefaults { expressions: [Expr] }
impl CanonicalASTFixtureDefaults.CanonicalASTDefaultProvider {
    fn write_default(self, reference: FunctionDefaultRef, out: &[U8]) Never! {
        assert(reference.owner_key == "owner" && reference.parameter_index == 0)
        canonical_ast_write_expression<CanonicalASTFixtureDefaults>(&out, self, self.expressions[reference.parameter_index])
    }
}

