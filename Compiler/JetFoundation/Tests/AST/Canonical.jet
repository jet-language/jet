// Golden bytes were exercised from the ORIGINAL frozen Rust CanonicalAST
// encoder through laneS, using std-only actual AST carrier extraction.
// Compound values are asserted as bytes, not source-shape strings.

#Test("canonical_rust_Item_Func") {
    item :: Item.Func{value: Func{span: Span{start: 17, end: 29}, is_pub: false, is_package_pub: false, is_comptime: false, external_type: None, name: "x", name_span: Span{start: 17, end: 29}, meta: None, type_params: [TypeParam]{}, head_pattern: None, params: [Param]{}, return_type: None, return_type_span: None, return_view_provenance: None, declared_return_view_provenance: None, gc_return: false, diverges: false, gc_scope: false, is_unsafe: false, unsafe_reason: None, unsafe_span: None, is_pure: false, is_sanitizer: false, scrub_tag: None, declared_effects: None, effect_via: None, state_requires: None, state_transition: None, is_reactive: false, reactive_upgrades: [String]{}, is_replayable: false, replayable_span: None, is_job: false, job_span: None, job_metadata: None, every: None, is_must_use: false, must_use_span: None, maturity: None, maturity_span: None, kernel: None, is_inline: false, is_inline_always: false, inline_span: None, web_marker: None, pre: [ContractClause]{}, post: [ContractClause]{}, inline_foreign: None, undo: None, markers: [Marker]{}, compiler_generated: false, body: [Stmt]{}}}
    expected :: "Func(Func {{ span: Span, is_pub: false, is_package_pub: false, is_comptime: false, external_type: None, name: \"x\", name_span: Span, meta: None, type_params: [], head_pattern: None, params: [], return_type: None, return_type_span: None, return_view_provenance: None, declared_return_view_provenance: None, gc_return: false, diverges: false, gc_scope: false, is_unsafe: false, unsafe_reason: None, unsafe_span: None, is_pure: false, is_sanitizer: false, scrub_tag: None, declared_effects: None, effect_via: None, state_requires: None, state_transition: None, is_reactive: false, reactive_upgrades: [], is_replayable: false, replayable_span: None, is_job: false, job_span: None, job_metadata: None, every: None, is_must_use: false, must_use_span: None, maturity: None, maturity_span: None, kernel: None, is_inline: false, is_inline_always: false, inline_span: None, web_marker: None, pre: [], post: [], inline_foreign: None, undo: None, markers: [], compiler_generated: false, body: [] }})"
    assert_eq(canonical_ast_fragment<CanonicalASTParsedDefaults>(item, CanonicalASTParsedDefaults.Parsed, false), expected.bytes())
}

