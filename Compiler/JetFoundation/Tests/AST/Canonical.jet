#Test("strip_spans_preserves_quoted_marker_and_escape") {
    text :: "(\"Span {{ start: 1, end: 2 }}\", Span {{ start: 3, end: 4 }})"
    expected :: "(\"Span {{ start: 1, end: 2 }}\", Span)"
    assert_eq(canonical_ast_strip_spans(text), expected.bytes())
}
#Test("canonical_span_coordinates_do_not_change_identity") {
    left :: "Ident(\"x\", Span {{ start: 0, end: 1 }})"
    right :: "Ident(\"x\", Span {{ start: 40, end: 41 }})"
    assert_eq(canonical_ast_strip_spans(left), canonical_ast_strip_spans(right))
    assert_eq(canonical_ast_strip_spans(left), "Ident(\"x\", Span)".bytes())
}

#Test("leaf_rust_string_0") {
    out := [U8]{}
    canonical_ast_write_string(&out, "")
    assert_eq(out, "\"\"".bytes())
}

#Test("leaf_rust_string_1") {
    out := [U8]{}
    canonical_ast_write_string(&out, "quote\" slash\\ apostrophe'")
    assert_eq(out, "\"quote\\\" slash\\\\ apostrophe'\"".bytes())
}

#Test("leaf_rust_string_2") {
    out := [U8]{}
    canonical_ast_write_string(&out, (String.from_bytes([U8]{U8{0}, U8{9}, U8{10}, U8{13}, U8{27}, U8{127}, U8{194}, U8{133}}) ?? panic("scalar fixture is UTF-8")))
    assert_eq(out, "\"\\0\\t\\n\\r\\u{{1b}}\\u{{7f}}\\u{{85}}\"".bytes())
}

#Test("leaf_rust_string_3") {
    out := [U8]{}
    canonical_ast_write_string(&out, "Span {{ start: 1, end: 2 }}")
    assert_eq(out, "\"Span {{ start: 1, end: 2 }}\"".bytes())
}

#Test("leaf_rust_string_4") {
    out := [U8]{}
    canonical_ast_write_string(&out, (String.from_bytes([U8]{U8{206}, U8{187}, U8{240}, U8{159}, U8{152}, U8{128}, U8{226}, U8{128}, U8{141}, U8{226}, U8{128}, U8{168}, U8{194}, U8{173}}) ?? panic("scalar fixture is UTF-8")))
    assert_eq(out, "\"λ😀\\u{{200d}}\\u{{2028}}\\u{{ad}}\"".bytes())
}

#Test("leaf_rust_f32_0") {
    out := [U8]{}
    canonical_ast_write_f32(&out, -0.0)
    assert_eq(out, "-0.0".bytes())
}

#Test("leaf_rust_f32_1") {
    out := [U8]{}
    canonical_ast_write_f32(&out, 1.0)
    assert_eq(out, "1.0".bytes())
}

#Test("leaf_rust_f32_2") {
    out := [U8]{}
    canonical_ast_write_f32(&out, 1.234567890)
    assert_eq(out, "1.2345679".bytes())
}

#Test("leaf_rust_f32_3") {
    out := [U8]{}
    canonical_ast_write_f32(&out, 1e-7)
    assert_eq(out, "1e-7".bytes())
}

#Test("leaf_rust_f32_4") {
    out := [U8]{}
    canonical_ast_write_f32(&out, 1e16)
    assert_eq(out, "1e16".bytes())
}

#Test("leaf_rust_f32_5") {
    out := [U8]{}
    canonical_ast_write_f32(&out, -3.4028234663852886e38)
    assert_eq(out, "-3.4028235e38".bytes())
}

#Test("leaf_rust_f32_6") {
    out := [U8]{}
    canonical_ast_write_f32(&out, 3.4028234663852886e38)
    assert_eq(out, "3.4028235e38".bytes())
}

#Test("leaf_rust_f32_7") {
    out := [U8]{}
    canonical_ast_write_f32(&out, 1.1754943508222875e-38)
    assert_eq(out, "1.1754944e-38".bytes())
}

#Test("leaf_rust_f32_8") {
    out := [U8]{}
    canonical_ast_write_f32(&out, (Float.parse("inf") ?? panic("infinity")))
    assert_eq(out, "inf".bytes())
}

#Test("leaf_rust_f32_9") {
    out := [U8]{}
    canonical_ast_write_f32(&out, (Float.parse("-inf") ?? panic("negative infinity")))
    assert_eq(out, "-inf".bytes())
}

#Test("leaf_rust_f32_10") {
    out := [U8]{}
    canonical_ast_write_f32(&out, Float.NAN)
    assert_eq(out, "NaN".bytes())
}

#Test("leaf_rust_ct_bigint_positive") {
    out := [U8]{}
    canonical_ast_write_ct_bigint(&out, "12987654321123456789")
    assert_eq(out, "CtBigInt {{ negative: false, limbs: [123456789, 987654321, 12] }}".bytes())
}

#Test("leaf_rust_ct_bigint_negative") {
    out := [U8]{}
    canonical_ast_write_ct_bigint(&out, "-12987654321123456789")
    assert_eq(out, "CtBigInt {{ negative: true, limbs: [123456789, 987654321, 12] }}".bytes())
}

#Test("leaf_rust_ct_bigint_zero") {
    out := [U8]{}
    canonical_ast_write_ct_bigint(&out, "0")
    assert_eq(out, "CtBigInt {{ negative: false, limbs: [] }}".bytes())
}

#Test("leaf_rust_budget_bigint") {
    out := [U8]{}
    canonical_ast_write_bigint(&out, -12987654321123456789)
    assert_eq(out, "BigInt {{ sign: -1, limbs: [123456789, 987654321, 12] }}".bytes())
}
