// Rust: tests/feature_acceptance.rs:1
// Feature claim lanes: every test keeps its exact FEATURE_CLAIM body marker.
use std.fs
use std.env
use std.process.[Command]
use jet.Lexer
use jet.Lexer.[Token, TokKind, StrTokPart]
// Rust: tests/feature_acceptance.rs:13
fn root() -> OSPath { OSPath(env.var("CARGO_MANIFEST_DIR").unwrap()) }
// Rust: tests/feature_acceptance.rs:17
fn read(rel: String) -> String {
    // GATE #4494: actual reference-file reads.
    fs.read_to_string(root().join(rel)).unwrap_or_else((e) -> panic("read {rel}: {e}"))
}
// Rust: tests/feature_acceptance.rs:21
fn lex_probe(source: String) -> [Token] {
    (tokens, diagnostics) :: Lexer.lex(source)
    assert(diagnostics.is_empty(), "feature probe source must lex cleanly: {diagnostics:Debug}\n{source}")
    ^tokens
}
// Rust: tests/feature_acceptance.rs:30
fn token_stream_has_executable_drop(tokens: &[Token]) -> Bool {
    code :: tokens.iter().filter((token) -> !Lexer.is_comment(&token.kind)).collect<[&Token]>()
    here :: code.windows(5).any((window) -> match (&window[0].kind, &window[1].kind, &window[2].kind, &window[3].kind, &window[4].kind) {
        (TokKind.Dot, TokKind.Ident(method), TokKind.LParen, TokKind.Str(parts), TokKind.RParen) -> {
            method == "drop" && match parts.as_slice() {
                [StrTokPart.Lit(reason)] -> !reason.is_empty(),
                _ -> false,
            }
        },
        _ -> false,
    })
    here || tokens.iter().any((token) -> match &token.kind {
        TokKind.Str(parts) -> parts.iter().any((part) -> match part {
            StrTokPart.Interp(inner) -> token_stream_has_executable_drop(inner),
            StrTokPart.Lit(_) -> false,
            StrTokPart.Byte(_) -> false,
        }),
        _ -> false,
    })
}
// Rust: tests/feature_acceptance.rs:67
fn has_executable_drop_with_reason(source: String) -> Bool { token_stream_has_executable_drop(&lex_probe(source)) }
// Rust: tests/feature_acceptance.rs:71
fn token_stream_has_active_suppress(tokens: &[Token]) -> Bool {
    code :: tokens.iter().filter((token) -> !Lexer.is_comment(&token.kind)).collect<[&Token]>()
    here :: code.windows(2).any((window) -> match (&window[0].kind, &window[1].kind) {
        (TokKind.Hash, TokKind.Ident(marker)) -> marker == "Suppress",
        _ -> false,
    })
    here || tokens.iter().any((token) -> match &token.kind {
        TokKind.Str(parts) -> parts.iter().any((part) -> match part {
            StrTokPart.Interp(inner) -> token_stream_has_active_suppress(inner),
            StrTokPart.Lit(_) -> false,
            StrTokPart.Byte(_) -> false,
        }),
        _ -> false,
    })
}
// Rust: tests/feature_acceptance.rs:95
fn has_active_suppress(source: String) -> Bool { token_stream_has_active_suppress(&lex_probe(source)) }
// Rust: tests/feature_acceptance.rs:99
fn jet_bin() -> OSPath {
    from_env :: env.var_os("CARGO_BIN_EXE_jet").map(OSPath.from)
    if p := from_env { if p.exists() { return ^p } }
    // Prefer freshly built debug Jet next to tests.
    candidates :: [root().join("target/debug/jet"), root().join("../target/debug/jet")]
    for c in candidates { if c.exists() { return ^c } }
    OSPath("jet")
}
// Rust: tests/feature_acceptance.rs:119
fn run_example(rel: String) -> String {
    path :: root().join(rel)
    // GATE #4494: execute real CLI examples.
    out :: Command.new(jet_bin()).arg("run").arg(&path).current_dir(root()).output().unwrap_or_else((e) -> panic("jet run {rel}: {e}"))
    assert(out.status.success(), "jet run {rel} failed:\n{}", String.from_utf8_lossy(&out.stderr))
    stdout :: String.from_utf8_lossy(&out.stdout)
    joined :: stdout.lines().filter((line) -> !line.starts_with("effects:")).collect<[String]>().join("\n")
    trimmed := joined.trim() // #4303
    trimmed.to_string()
}
