// Rust: tests/ui_backend.rs:78
#Test("tui_backend_reactive_conditional_capture") {
    tir_support.assert_tiers_agree_with_application_policy("ui_reactive_conditional_capture", """
use core.ui as ui
use core.reactive as reactive
fn view(title: String) -> UINode {{
    ui.box([ui.text(title), ui.node_role("notes", 30.0, 3.0, ui.aria_role_text_input())])
}}
fn run() -> {{
    selected := reactive.signal(0)
    backend := ui.tui_backend()
    render_backend :: ~backend
    ui.reactive_render(() -> {{
        marker :: if selected.get() == 0 -> "* " else -> "  "
        ui.mount(render_backend, view("{{marker}}Meeting"))
    }})
    print("initial: {{backend.render_count()}}")
    &selected.set(1)
    print("updated: {{backend.render_count()}}")
    &selected.set(0)
    print("reset: {{backend.render_count()}}")
}}
""", "initial: 1\nupdated: 2\nreset: 3\n", tir_support.TIR_TEST_PACKAGE)
}
// Rust: tests/ui_backend.rs:112
#Test("mount_twice_is_idempotent") {
    dir :: env.temp_dir().join("jet_ui_mount_{process.id()}")
    _ :: fs.remove_dir_all(&dir).ok()
    fs.create_dir_all(&dir).unwrap()
    src :: """
use core.ui as ui
fn run() -> {{
    tree := ui.box([ui.text("Title"), ui.button("Save")])
    null := ui.null_backend()
    ui.mount(null, tree)
    loop command in null.commands() {{ print(command) }}
    print("---")
    ui.mount(null, tree)
    loop command in null.commands() {{ print(command) }}
}}
"""
    (code, stdout, stderr) :: build_and_run(&dir, "ui_mount_twice", src)
    assert_eq(code, 0, "mount twice failed: {stderr}")
    assert_eq(stdout, "text({{x:0,y:0,w:8,h:1}}, Title)\nfill({{x:0,y:1,w:8,h:1}}, #000000)\ntext({{x:0,y:1,w:8,h:1}}, Save)\n---\ntext({{x:0,y:0,w:8,h:1}}, Title)\nfill({{x:0,y:1,w:8,h:1}}, #000000)\ntext({{x:0,y:1,w:8,h:1}}, Save)\n")
    _ :: fs.remove_dir_all(&dir).ok()
}
// Rust: tests/ui_backend.rs:150
#Test("typed_component_tree_has_backend_parity") {
    dir :: env.temp_dir().join("jet_ui_tree_{process.id()}")
    _ :: fs.remove_dir_all(&dir).ok()
    fs.create_dir_all(&dir).unwrap()
    src :: """
use core.ui as ui
fn run() -> {{
    tree := ui.box([ui.text("Title"), ui.button("Save")])
    limit := ui.constraint(0.0, 0.0, 80.0, 24.0)
    null := ui.null_backend()
    size := null.measure(tree, limit)
    null.layout(tree, ui.rect(0.0, 0.0, size.width, size.height))
    null.paint(tree)
    print(null.focused_label())
    null.on_event(ui.key_event("Tab"))
    print(null.focused_label())
    loop command in null.commands() {{ print(command) }}
    tui := ui.tui_backend()
    tui.layout(tree, ui.rect(0.0, 0.0, size.width, size.height))
    tui.paint(tree)
    print(tui.focused_label())
    loop line in tui.frame_lines() {{ print(line) }}
}}
"""
    (code, stdout, stderr) :: build_and_run(&dir, "ui_typed_tree", src)
    assert_eq(code, 0, "typed tree failed: {stderr}")
    assert_eq(stdout, "Save\nSave\ntext({{x:0,y:0,w:8,h:1}}, Title)\nfill({{x:0,y:1,w:8,h:1}}, #000000)\ntext({{x:0,y:1,w:8,h:1}}, Save)\nSave\nTitle\nSave\n")
    _ :: fs.remove_dir_all(&dir).ok()
}
// Rust: tests/ui_fixes.rs:17
#Test("ownership_ui_fixes_compile") {
    dir :: OSPath.from(env.build_var("CARGO_MANIFEST_DIR")).join("tests/ui")
    ext :: jet.Syntax.FILE_EXT
    have_native :: Command.new(jet_bin()).arg("--version").output().is_ok()
    have_cargo :: Command.new("cargo").arg("--version").output().is_ok()
    entries := fs.read_dir(&dir).unwrap().map(fn(e) -> e.unwrap().path()).filter(fn(p) ->
        p.file_name().and_then(fn(n) -> n.to_str()).is_some_and(fn(n) -> n.ends_with(".fixed.{ext}"))
    ).collect<[OSPath]>()
    entries.sort()
    assert(entries.len() >= 10, "expected M2 ownership .fixed.jet companions, found {entries.len()}")
    entries :: Arc.new(^entries)
    next :: Arc.new(AtomicUsize.new(0))
    failures :: Arc.new(Mutex.new([String]{}))
    workers :: test_worker_count(16).min(entries.len().max(1))
    handles := []
    loop _ in 0..<workers {
        worker_entries :: Arc.clone(&entries)
        worker_next :: Arc.clone(&next)
        worker_failures :: Arc.clone(&failures)
        handles.push(thread.spawn(fn() {
            loop {
                i :: worker_next.fetch_add(1, Ordering.Relaxed)
                if i >= worker_entries.len() -> break
                path :: worker_entries[i].clone()
                if std.panic.catch_unwind(fn() -> check_fixed_companion(i, &path, have_native, have_cargo)) == {
                    .Err(payload) -> worker_failures.lock().unwrap().push(panic_message(payload))
                    .Ok(_) -> {}
                }
            }
        }))
    }
    loop handle in handles -> handle.join().unwrap()
    failures :: failures.lock().unwrap()
    if !failures.is_empty() -> panic(failures.join("\n\n"))
}
// Rust: tests/ui_fixes.rs:124
#Test("liveness_fix_renames_to_existing_underscore_form") {
    scratch :: Scratch.new("liveness_fix")
    path :: scratch.join("liveness.jet")
    fs.write(&path, "use core.files as files\nuse core.math.random as random\n\npub(package) fn package_export() -> {{}}\n\nfn unused_private(value: Int) -> {{ print(value) }}\n\nfn run() -> {{\n    unused_binding :: random.normal(0.0, 1.0)\n}}\n").unwrap()
    output :: Command.new(jet_bin()).args(["fix", path.to_str().unwrap()]).current_dir(env.build_var("CARGO_MANIFEST_DIR")).env("NO_COLOR", "1").output().unwrap()
    assert_eq(output.status.code(), .Some(0), "jet fix failed: {String.from_utf8_lossy(&output.stderr)}")
    assert_eq(fs.read_to_string(&path).unwrap(), "use core.files as _files\nuse core.math.random as random\n\npub(package) fn _package_export() -> {{}}\n\nfn _unused_private(value: Int) -> {{ print(value) }}\n\nfn run() -> {{\n    _unused_binding :: random.normal(0.0, 1.0)\n}}\n")
}
// Rust: tests/ui_fixes.rs:158
#Test("liveness_fix_removes_only_literal_locals_and_empty_private_functions") {
    scratch :: Scratch.new("liveness_fix_removal")
    path :: scratch.join("liveness.jet")
    original :: "use core.math.random as random\n\npub fn public_api() -> {{}}\n\nfn empty_private() -> {{}}\n\nfn run() -> {{\n    pure_local :: 42\n    effectful :: random.normal(0.0, 1.0)\n    print(\"done\")\n}}\n"
    fs.write(&path, original).unwrap()
    dry_run :: Command.new(jet_bin()).args(["fix", path.to_str().unwrap(), "--dry-run"]).current_dir(env.build_var("CARGO_MANIFEST_DIR")).env("NO_COLOR", "1").output().unwrap()
    assert_eq(dry_run.status.code(), .Some(0), "dry-run failed: {String.from_utf8_lossy(&dry_run.stderr)}")
    assert_eq(fs.read_to_string(&path).unwrap(), original)
    fixed :: Command.new(jet_bin()).args(["fix", path.to_str().unwrap()]).current_dir(env.build_var("CARGO_MANIFEST_DIR")).env("NO_COLOR", "1").output().unwrap()
    assert_eq(fixed.status.code(), .Some(0), "jet fix failed: {String.from_utf8_lossy(&fixed.stderr)}")
    source :: fs.read_to_string(&path).unwrap()
    assert(source.contains("pub fn public_api() -> {{}}"))
    assert(!source.contains("empty_private"))
    assert(!source.contains("pure_local"))
    assert(source.contains("_effectful :: random.normal(0.0, 1.0)"))
    checked :: Command.new(jet_bin()).args(["check", path.to_str().unwrap()]).current_dir(env.build_var("CARGO_MANIFEST_DIR")).env("NO_COLOR", "1").output().unwrap()
    assert(checked.status.success(), "fixed source does not check: {String.from_utf8_lossy(&checked.stderr)}")
    assert(!String.from_utf8_lossy(&checked.stderr).contains("L0101"))
}
// Rust: tests/ui_fixes.rs:214
#Test("shared_busy_wait_fix_rewrites_empty_plain_field_loop") {
    scratch :: Scratch.new("shared_busy_wait_fix")
    path :: scratch.join("busy_spin.jet")
    fs.write(&path, include_str("tests/ui_lint/busy_spin.jet")).unwrap()
    fixed :: Command.new(jet_bin()).args(["fix", path.to_str().unwrap()]).current_dir(env.build_var("CARGO_MANIFEST_DIR")).env("NO_COLOR", "1").output().unwrap()
    assert_eq(fixed.status.code(), .Some(0), "jet fix failed: {String.from_utf8_lossy(&fixed.stderr)}")
    source :: fs.read_to_string(&path).unwrap()
    assert(source.contains("flag.guard_edit().wait(_changed, value -> value.ready) ?? panic(\"wait failed\")"), "safe busy-loop fix missing:\n{source}")
    assert_eq(source.matches("loop flag.ready == false {{}}").count(), 1, "safe busy-loop fix changed the deliberate allow:\n{source}")
    assert(source.contains("#allow(shared_busy_wait) loop flag.ready == false {{}}"), "safe busy-loop fix removed the deliberate allow:\n{source}")
    checked :: Command.new(jet_bin()).args(["check", path.to_str().unwrap()]).current_dir(env.build_var("CARGO_MANIFEST_DIR")).env("NO_COLOR", "1").output().unwrap()
    assert(checked.status.success(), "fixed busy-loop source does not check:\n{String.from_utf8_lossy(&checked.stderr)}")
}
// Rust: tests/ui_fixes.rs:262
#Test("repeated_list_head_fix_preserves_behavior") {
    scratch :: Scratch.new("repeated_list_head_fix")
    path :: scratch.join("main.jet")
    original :: """
struct LineItem {{
    label: String
    cents: Int
}}
fn run() -> {{
    items :: [
        LineItem{{
            label: "coffee", // field comment stays with the first item
            cents: 450
        }},
        // The second item keeps its position and evaluation order.
        LineItem{{label: "tea", cents: 325}}
    ]
    print("{{items[0].label}}:{{items[0].cents}}")
    print("{{items[1].label}}:{{items[1].cents}}")
}}
"""
    fs.write(&path, original).unwrap()
    fs.write(scratch.join("package.jet"), "name: \"repeated_list_head_fix\"\nversion: \"0.1.0\"\nedition: \"2026\"\nauthority: {{ holds: {{ allow: [IO, Mem.Alloc] }} }}\n").unwrap()
    shown :: path.to_string_lossy().into_owned()
    lint_output :: compile_with_path(original, shown).unwrap()
    lint :: lint_output.lints.iter().find(fn(diagnostic) -> diagnostic.code == "L0523").expect("LineItem list must produce L0523")
    assert_eq(lint.applicability.map(fn(value) -> value.as_str()), .Some("safe"))
    assert(lint.safety.is_some_and(fn(value) -> value.auto_apply()), "L0523 must carry an auto-applicable safety grade")
    edit :: lint.edit.clone().expect("L0523 must carry its source edit")
    expected_fixed :: apply_edits(original, [&edit]).expect("L0523 edit must apply without overlap")
    dry_run :: Command.new(jet_bin()).args(["fix", path.to_str().unwrap(), "--dry-run"]).current_dir(&scratch.path).env("NO_COLOR", "1").output().unwrap()
    assert_eq(dry_run.status.code(), .Some(0), "L0523 dry-run failed: {String.from_utf8_lossy(&dry_run.stderr)}")
    assert_eq(fs.read_to_string(&path).unwrap(), original, "L0523 dry-run changed the source")
    // Retired default/JIT/interpreter modes cut over to native O0/O1/O2/Web.
    before_outputs := [(String, [U8])]{}
    loop mode in ["debug", "dev", "release"] {
        args :: ["run", "--profile={mode}", "main.jet"]
        output :: Command.new(jet_bin()).args(args).current_dir(&scratch.path).env("NO_COLOR", "1").output().unwrap()
        assert_eq(output.status.code(), .Some(0), "L0523 source failed in {mode}: {String.from_utf8_lossy(&output.stderr)}")
        before_outputs.push((mode, ^output.stdout))
    }
    tir_support.assert_awaited_web_tier("repeated_list_head_before", original, "coffee:450\ntea:325\n")
    applied :: Command.new(jet_bin()).args(["fix", path.to_str().unwrap()]).current_dir(&scratch.path).env("NO_COLOR", "1").output().unwrap()
    assert_eq(applied.status.code(), .Some(0), "L0523 fix failed: {String.from_utf8_lossy(&applied.stderr)}")
    assert_eq(fs.read_to_string(&path).unwrap(), expected_fixed)
    assert(expected_fixed.contains("[LineItem]{{"))
    assert(expected_fixed.contains("// field comment stays with the first item"))
    assert(expected_fixed.contains("// The second item keeps its position"))
    fixed :: fs.read_to_string(&path).unwrap()
    checked :: compile_with_path(fixed, shown).unwrap()
    assert(!checked.lints.iter().any(fn(diagnostic) -> diagnostic.code == "L0523"), "L0523 remained after its explicit fix")
    second_fix :: Command.new(jet_bin()).args(["fix", path.to_str().unwrap()]).current_dir(&scratch.path).env("NO_COLOR", "1").output().unwrap()
    assert_eq(second_fix.status.code(), .Some(0), "second L0523 fix failed: {String.from_utf8_lossy(&second_fix.stderr)}")
    assert_eq(fs.read_to_string(&path).unwrap(), fixed, "L0523 fix is not idempotent")
    after_outputs := [(String, [U8])]{}
    loop mode in ["debug", "dev", "release"] {
        args :: ["run", "--profile={mode}", "main.jet"]
        output :: Command.new(jet_bin()).args(args).current_dir(&scratch.path).env("NO_COLOR", "1").output().unwrap()
        assert_eq(output.status.code(), .Some(0), "fixed L0523 source failed in {mode}: {String.from_utf8_lossy(&output.stderr)}")
        after_outputs.push((mode, ^output.stdout))
    }
    assert_eq(before_outputs, after_outputs)
    tir_support.assert_awaited_web_tier("repeated_list_head_after", fixed, "coffee:450\ntea:325\n")
    fmt_path :: scratch.join("fmt.jet")
    fs.write(&fmt_path, original).unwrap()
    fmt :: Command.new(jet_bin()).args(["fmt", fmt_path.to_str().unwrap()]).current_dir(&scratch.path).env("NO_COLOR", "1").output().unwrap()
    assert_eq(fmt.status.code(), .Some(0), "fmt failed on repeated heads: {String.from_utf8_lossy(&fmt.stderr)}")
    formatted :: fs.read_to_string(&fmt_path).unwrap()
    assert(!formatted.contains("[LineItem]{{"), "ordinary fmt must not apply the L0523 source fix: {formatted}")
    assert(formatted.contains("// field comment stays with the first item"))
    assert(formatted.contains("// The second item keeps its position"))
    generic_path :: scratch.join("generic.jet")
    generic :: """
struct Box<T> {{ value: T }}
fn run() -> {{
    boxes := [Box<Int>{{value: 1}}, Box<Int>{{value: 2}}]
    print(boxes[0].value + boxes[1].value)
}}
"""
    fs.write(&generic_path, generic).unwrap()
    generic_output :: compile_with_path(generic, generic_path.to_string_lossy()).unwrap()
    generic_lint :: generic_output.lints.iter().find(fn(diagnostic) -> diagnostic.code == "L0523").expect("generic repeated heads must produce L0523")
    generic_edit :: generic_lint.edit.clone().expect("generic L0523 edit must be safe")
    generic_fixed :: apply_edits(generic, [&generic_edit]).unwrap()
    assert(generic_fixed.contains("[Box<Int>]{{"))
    fs.write(&generic_path, generic_fixed).unwrap()
    generic_checked :: compile_with_path(generic_fixed, generic_path.to_string_lossy()).unwrap()
    assert(!generic_checked.lints.iter().any(fn(diagnostic) -> diagnostic.code == "L0523"))
    fixed_shape_path :: scratch.join("fixed_shape.jet")
    fixed_shape :: """
struct LineItem {{ label: String; cents: Int }}
fn fixed() -> [LineItem#2] {{
    [LineItem{{label: "coffee", cents: 450}}, LineItem{{label: "tea", cents: 325}}]
}}
fn run() -> {{ print(fixed()[0].cents) }}
"""
    fs.write(&fixed_shape_path, fixed_shape).unwrap()
    fixed_shape_output :: compile_with_path(fixed_shape, fixed_shape_path.to_string_lossy()).unwrap()
    assert(fixed_shape_output.lints.iter().filter(fn(diagnostic) -> diagnostic.code == "L0523").all(fn(diagnostic) -> diagnostic.edit.is_none()), "L0523 must not offer a growable-list edit for a fixed-length expected type")
    commented :: """
struct LineItem {{ label: String; cents: Int }}
fn run() -> {{
    items :: [
        LineItem /* keep this constructor spelling */ {{label: "coffee", cents: 450}},
        LineItem{{label: "tea", cents: 325}}
    ]
}}
"""
    fs.write(scratch.join("commented.jet"), commented).unwrap()
    commented_output :: compile_with_path(commented, scratch.join("commented.jet").to_string_lossy()).unwrap()
    assert(commented_output.lints.iter().filter(fn(diagnostic) -> diagnostic.code == "L0523").all(fn(diagnostic) -> diagnostic.edit.is_none()), "L0523 must not offer an edit when constructor comments make the head ambiguous")
}
