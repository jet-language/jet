#Test("in_channel_pin_runs_native_without_writing_lock") {
    dir :: scratch("native")
    it := env.build_var("CARGO_PKG_VERSION").split('.')
    running_channel :: "{it.next().unwrap()}.{it.next().unwrap()}"
    write(&dir, "package.jet", "name: \"x\"\nversion: \"1\"\njet: {running_channel}\n")
    write(&dir, "main.jet", "fn run() -> {{ print(\"ok\") }}\n")
    out :: run(["build", "main.jet"], &dir)
    assert(out.status.success(), "native build failed: {out:?}")
    assert(!dir.join(".jet/lock").exists(), "a plain build must not write a toolchain lock into the tree")
    _ :: fs.remove_dir_all(&dir).ok()
}
