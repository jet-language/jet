// Rust: tests/scheduler_native.rs:32
pub fn strip_region(src: String, begin: String, end: String) -> String {
    if (src.find(begin), src.find(end)) == {
        (.Some(b), .Some(e)) -> {
            if e >= b {
                s := src[..b].to_string()
                s.push_str(&src[e + end.len()..])
                return s
            }
        }
        else -> {}
    }
    src.to_string()
}
// Rust: tests/scheduler_native.rs:45
pub fn strip_mod(src: String, name: String) -> String {
    found :: src.find("mod {name}")
    if found == .None { return src.to_string() }
    start :: found.unwrap()
    bytes :: src.as_bytes()
    depth := 0
    i := start
    end := src.len()
    seen := false
    while i < bytes.len() {
        if bytes[i] == {
            123 -> { depth += 1; seen = true }
            125 -> {
                depth -= 1
                if seen && depth == 0 { end = i + 1; break }
            }
            else -> {}
        }
        i += 1
    }
    s := src[..start].to_string()
    s.push_str(&src[end..])
    s
}
