//RS /// c109 Phase 29: qualified `io.input(prompt)` (surface (H), 34_parallel_scan
//RS /// `paths_from_prompt`). DISTINCT from the ambient bare `input()` (Phase 25 `AmbientInput`):
//RS /// this is a `MethodCall` on a `core.term` alias, lowered to a `CoreCall`
//RS /// (`jet_std_io_input(Some(&(prompt)))` → `Result<String, IOError>`). It composes with a
//RS /// `?? return <value>` fallback (the early-return form, already covered since Phase 8).
//RS /// The loop accumulates piped lines, a blank line breaks, EOF yields `Ok("")` (read_line on
//RS /// EOF) so the loop also breaks — the `?? return` fires only on a genuine Err. Both stdin
//RS /// shapes run deterministically.
//RS #[test]
//RS fn qualified_io_input_or_return() {
//RS     if !have_rustc() {
//RS         return;
//RS     }
//RS     let src = "\
//RS use core.term as io
//RS fn collect() -[IO]> [String] {
//RS     out := [String]{}
//RS     loop true {
//RS         line :: io.input(\"> \") ?? return ~out
//RS         if line == \"\" {
//RS             break
//RS         }
//RS         out.push(line)
//RS     }
//RS     return out
//RS }
//RS fn run() {
//RS     got :: collect()
//RS     print(\"count={got.len()}\")
//RS     loop g in got {
//RS         print(g)
//RS     }
//RS     print(\"done\")
//RS }
//RS ";
//RS     // Two lines then a blank line: the loop accumulates `alpha`/`beta`, the blank breaks.
//RS     let (code, stdout) = build_and_run_stdin("tir_io_input_lines", src, "alpha\nbeta\n\n");
//RS     assert_eq!(code, 0);
//RS     assert_eq!(stdout, "> > > count=2\nalpha\nbeta\ndone\n");
//RS     // Immediate EOF: read_line yields Ok("") → the loop breaks on the empty line, no input.
//RS     let (code, stdout) = build_and_run_stdin("tir_io_input_eof", src, "");
//RS     assert_eq!(code, 0);
//RS     assert_eq!(stdout, "> count=0\ndone\n");
//RS }
//RS 
//RS /// c109 Phase 30: GENERIC functions + TRAIT-OBJECT dispatch (surface (G), 25_traits).
//RS /// Three covered fns: a generic `largest<T: Comparable>(xs: [T]) -> (?T)` (a `>` on a
//RS /// `Comparable`-bound type var, `[T]` indexing, a `T?` return with `value`/`None`); a
//RS /// trait-OBJECT param `print_area(s: Shape)` (dynamic dispatch `s.name()`/`s.area()`
//RS /// through a `Box<dyn __jet_Shape>`); and `main` — a `[Shape]` trait-object list built from
//RS /// `Box::new(<lit>) as Box<dyn __jet_Shape>` element coercions, iterated via `.each`
