//RS struct Tree {
//RS     value: Int
//RS     child: Tree?
//RS }
//RS fn run() {
//RS     root :: Tree{
//RS         value: 3,
//RS         child: Val(Tree{
//RS             value: 2,
//RS             child: Val(Tree{ value: 1, child: None })
