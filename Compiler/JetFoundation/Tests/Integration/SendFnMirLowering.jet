use Compiler.JetFoundation.Tests.Integration.Common as common
use Compiler.JetFoundation.Source.CompilerStack.[run_on_compiler_stack]
use core.fs as fs
use jet

// Rust: tests/send_fn_mir_lowering.rs:19
APP_PACKAGE :: """
name: "send_fn_mir_lowering"
version: "0.1.0"
authority: { holds: { allow: [IO, Env, Net] } }
"""
// Rust: tests/send_fn_mir_lowering.rs:28
APP_HANDLERS :: """
use core.web as web
#Target(Web)
fn home() -> WebPage { web.page("Home", "hello") }
fn detail(id: Int) -> WebPage { web.page("Detail", "item {id}") }
fn save() -> String { "saved" }
fn run() -> App {
    return web.app()
        .route("/", home)
        .page("/about", home)
        .route("/items/:id", detail)
        .action("save", save)
        .form("order", save)
        .pending(home)
        .csr()
}
"""
