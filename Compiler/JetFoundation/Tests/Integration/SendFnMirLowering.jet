}
"""
// Rust: tests/send_fn_mir_lowering.rs:65
fn checked_bundle(name: String, source: String) -> jet.AST.ProgramBundle {
    dir :: common.unique_tmp("jet_send_fn_mir_{name}")
    fs.create_dir_all(&dir).unwrap()
    fs.write(dir.join("package.jet"), APP_PACKAGE).unwrap()
    entry :: dir.join("main.jet")
    fs.write(&entry, source).unwrap()
    bundle := jet.Loader.load_entry(entry.to_str().unwrap()).unwrap()
    errors :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run).into_iter().filter((diagnostic) -> diagnostic.severity == jet.Diagnostics.Severity.Error).collect()
    assert(errors.is_empty(), "{name}: {errors:?}")
    _ :: fs.remove_dir_all(dir)
    ^bundle
}
// Rust: tests/send_fn_mir_lowering.rs:81
fn assert_lowers_on_every_tier(name: String, source: String) -> {
    run_on_compiler_stack(() -> {
        bundle :: checked_bundle(name, source)
        (cranelift, _) :: common.lower_cranelift_bundle(&bundle).unwrap_or_else((error) -> panic("{name}: Cranelift MIR lowering failed: {error}"))
        cranelift.validate().unwrap_or_else((error) -> panic("{name}: Cranelift MIR does not validate: {error}"))
        (interpreter, _) :: common.lower_interpreter_bundle(&bundle).unwrap_or_else((error) -> panic("{name}: interpreter MIR lowering failed: {error}"))
        interpreter.validate().unwrap_or_else((error) -> panic("{name}: interpreter MIR does not validate: {error}"))
    })
}
