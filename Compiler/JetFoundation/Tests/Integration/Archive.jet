        long_name := name.clone()
        long_name.push(0)
        append_tar_bomb_record(&archive, "././#LongLink".as_bytes(), &long_name, 76)
        append_tar_bomb_record(&archive, &[U8]{120}, &[U8]{120}, 48)
    }
    archive.extend_from_slice(&[U8]{0; 1024})
    ^archive
}
