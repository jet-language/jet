// Rust: tests/archive.rs:471
fn tar_bomb_octal(field: &[U8], value: USize) -> Unit {
    field.fill(48)
    field[field.len() - 1] = 0
    digits :: format!("{value:o}")
    start :: field.len() - 1 - digits.len()
    field[start..<start + digits.len()].copy_from_slice(digits.as_bytes())
}
// Rust: tests/archive.rs:479
fn append_tar_bomb_record(output: &[U8], name: &[U8], payload: &[U8], kind: U8) -> Unit {
    header := [U8]{0; 512}
    header[0..<name.len()].copy_from_slice(name)
    tar_bomb_octal(&header[100..<108], 0o644)
    tar_bomb_octal(&header[124..<136], payload.len())
    header[148..<156].fill(32)
    header[156] = kind
    header[257..<263].copy_from_slice(&[U8]{117, 115, 116, 97, 114, 0})
    header[263..<265].copy_from_slice(&[U8]{48, 48})
    checksum :: header.iter().map(fn(byte) { byte as U64 }).sum()
    digits :: format!("{checksum:06o}")
    header[148..<154].copy_from_slice(&digits.as_bytes()[digits.len() - 6..])
    header[154] = 0
    output.extend_from_slice(&header)
    output.extend_from_slice(payload)
    padded :: (output.len() + 511) / 512 * 512
    output.resize(padded, 0)
}
// Rust: tests/archive.rs:498
fn tar_names_json_materialization_bomb() -> [U8] {
    PAIR_COUNT :: 2048 as USize
    NAME_LEN :: 8192 as USize
    name :: [U8]{1; NAME_LEN}
    archive := [U8]{}
