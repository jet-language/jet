fn push_archive_u16(output: &[U8], value: USize) -> Unit {
    output.extend_from_slice(&(value as U16).to_le_bytes())
}
// Rust: tests/archive.rs:306
fn push_archive_u32(output: &[U8], value: USize) -> Unit {
    output.extend_from_slice(&(value as U32).to_le_bytes())
}
// Rust: tests/archive.rs:310
fn zip_limit_bomb(name: &[U8], entry_count: USize, method: U16, compressed: &[U8], uncompressed_len: USize, checksum: U32) -> [U8] {
    local := [U8]{}
    central := [U8]{}
    loop _ in 0..<entry_count {
        local_offset :: local.len()
        push_archive_u32(&local, 0x0403_4b50)
        push_archive_u16(&local, 20)
        push_archive_u16(&local, 0)
        push_archive_u16(&local, method as USize)
        push_archive_u16(&local, 0)
        push_archive_u16(&local, 0)
        push_archive_u32(&local, checksum as USize)
        push_archive_u32(&local, compressed.len())
        push_archive_u32(&local, uncompressed_len)
        push_archive_u16(&local, name.len())
        push_archive_u16(&local, 0)
        local.extend_from_slice(name)
        local.extend_from_slice(compressed)
        push_archive_u32(&central, 0x0201_4b50)
        push_archive_u16(&central, 20)
        push_archive_u16(&central, 20)
        push_archive_u16(&central, 0)
        push_archive_u16(&central, method as USize)
        push_archive_u16(&central, 0)
        push_archive_u16(&central, 0)
        push_archive_u32(&central, checksum as USize)
        push_archive_u32(&central, compressed.len())
        push_archive_u32(&central, uncompressed_len)
        push_archive_u16(&central, name.len())
        push_archive_u16(&central, 0)
        push_archive_u16(&central, 0)
        push_archive_u16(&central, 0)
        push_archive_u16(&central, 0)
        push_archive_u32(&central, 0)
        push_archive_u32(&central, local_offset)
        central.extend_from_slice(name)
    }
    central_offset :: local.len()
    central_size :: central.len()
    archive := ^local
    archive.extend_from_slice(&central)
    push_archive_u32(&archive, 0x0605_4b50)
    push_archive_u16(&archive, 0)
    push_archive_u16(&archive, 0)
    push_archive_u16(&archive, entry_count)
    push_archive_u16(&archive, entry_count)
    push_archive_u32(&archive, central_size)
    push_archive_u32(&archive, central_offset)
    push_archive_u16(&archive, 0)
    ^archive
}
