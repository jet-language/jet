// D-FAIL-CARRIER1=A / D-FAIL-MODEL1=A: one outcome carrier under T? and T !E.
use core.fs as fs
use std.env as env
use std.thread as thread
use jet as jet
use Compiler.JetFoundation.Tests.Integration.Common as common

// Rust: tests/outcome_carrier.rs:9
pub fn compile(name: String, src: String) -> String {
    dir :: env.temp_dir().join("jet_outcome_carrier")
    fs.create_dir_all(dir).unwrap()
    file :: dir.join("{name}.jet")
    fs.write(file, src).unwrap()
    out :: jet.compile_with_path(src, file.to_str().unwrap()).unwrap_or_else((diags) -> panic("{name} failed the front end: {diags:?}"))
    out.rust
}

// Rust: tests/outcome_carrier.rs:22
// The evaluator and front end recurse; give the complete execution one sized stack.
// GATE #4494: native thread creation and join use the std thread substrate.
pub fn run_jet(name: String, src: String) -> String {
    dir :: env.temp_dir().join("jet_outcome_carrier")
    fs.create_dir_all(dir).unwrap()
    file :: dir.join("{name}.jet")
    fs.write(file, src).unwrap()
    thread.Builder.new().stack_size(32 * 1024 * 1024).spawn(() -> {
        path :: file.to_str().unwrap()
        bundle := jet.Loader.load_entry(path).expect("fixture should load")
        diags :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run)
        assert(!diags.iter().any((d) -> d.severity == jet.Diagnostics.Severity.Error), "{name} failed the front end:\n{jet.render_diagnostics(path, src, diags)}")
        match common.run_interpreter_checked_bundle(bundle, true, jet.Interpreter.InterpreterInvocation.RunInterpret, common.development_policy()) {
            jet.Interpreter.RunOutcome.Ran{stdout, stderr, exit_code} -> {
                assert_eq(exit_code, 0, "{name} failed on the interpreter: {stderr}")
                assert(stderr.is_empty(), "{name} emitted diagnostics: {stderr}")
                stdout
            }
            jet.Interpreter.RunOutcome.Problems(diagnostics) -> panic("{name} failed on the interpreter: {diagnostics:?}")
        }
    }).expect("spawn the interpreter thread").join().expect("the interpreter thread must finish")
}

// Rust: tests/outcome_carrier.rs:70
pub fn user_body(rust: String, function: String) -> String {
    head :: "pub fn {function}("
    start :: rust.find(head).unwrap_or_else(() -> panic("no `{function}` in generated Rust"))
    rest :: rust[start..]
    end :: rest.find("\n}\n").expect("unterminated function") + 3
    rest[..end].to_string()
}
