// Rust: tests/web_app_graph.rs:1
// D-WEBAPP1=D / D-WEBAUTHOR1=D: sema-known application graph facts.
use jet.Driver.check_file_with_effect_facts
use jet.Sema.SemIndexEffectFacts
use jet.Diagnostics.Severity

// Rust: tests/web_app_graph.rs:9
fn check_facts(entry: &String) -> SemIndexEffectFacts {
    (diags, _, facts) :: check_file_with_effect_facts(entry, None, false)
    assert(!diags.iter().any(fn(d) { d.severity == Severity.Error }), "{diags:#?}")
    facts
}

// Rust: tests/web_app_graph.rs:20
fn codes(entry: &String) -> [String] {
    check_file_with_effect_facts(entry, None, false).0.iter().map(fn(d) { d.code.clone() }).collect()
}
