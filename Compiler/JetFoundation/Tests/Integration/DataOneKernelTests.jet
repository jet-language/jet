// Rust: tests/data_one_kernel.rs:99
#Test("only_one_core_data_statistics_implementation") {
    kernel :: root().join(KERNEL)
    assert(kernel.is_file(), "the one core.data statistics kernel is missing: {KERNEL}")
    offenders := [String]{}
    loop path in source_files() {
        if path == kernel { continue }
        text :: match fs.read_to_string(&path) { Ok(text) -> text, Err(_) -> continue }
        relative :: path.strip_prefix(root()).unwrap_or(&path).display().to_string()
        loop name in stats_function_names(text) { offenders.push("{relative}: fn {name}(… &[f64] …)") }
        loop (needle, what) in FINGERPRINTS { if text.contains(needle) { offenders.push("{relative}: {what} (`{needle}`)") } }
    }
    assert(offenders.is_empty(), "a second core.data statistics implementation exists (I9). Every tier must call the one kernel at {KERNEL} instead:\n  {offenders.join("\n  ")}")
}
// Rust: tests/data_one_kernel.rs:138
#Test("every_tier_includes_the_one_kernel") {
    kernel_name :: "CoreLib/Top/DataStats.rs"
    // Preserve the Rust reference renderer/comptime single-home comparators.
    loop (path, how) in [("crates/jet-codegen/src/Codegen/mod.rs", "AOT embeds the kernel"), ("crates/jet-comptime/src/Comptime/Methods/core_calls.rs", "comptime includes the kernel")] {
        text :: fs.read_to_string(root().join(path)).unwrap_or_else(fn(error) -> panic("cannot read {path}: {error}"))
        assert(text.contains(kernel_name), "{how}: {path} no longer names {kernel_name}")
    }
    // Retiring JIT representation checks become canonical native/Web behavior.
    tir_support.assert_tiers_agree("one_statistics_kernel", "use core.data as data\nfn run() -> { print(data.sum([Float]{10000000000000000.0, 1.0, -10000000000000000.0}) ?? panic(\"sum\")) }\n", "1.0\n")
}
