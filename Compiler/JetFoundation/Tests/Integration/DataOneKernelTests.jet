// Rust: tests/decisions.rs:14
#Test("ratified_decisions_enforced") {
    docs :: fs.read_to_string("Docs/spec/syntax-decisions.md").expect("Docs/spec/syntax-decisions.md")
    syntax :: decisions.read_syntax_surface()
    ratified :: decisions.extract_section_ids(docs, "## Ratified", "## Enforcement")
    statuses :: decisions.parse_syntax_rs_status(syntax)
    ids := statuses.keys().collect()
    ids.sort()
    loop id in ids {
        status :: statuses[id]
        assert(ratified.contains(&id), "{id} is in crates/jet-foundation/src/Syntax.rs or Syntax/ fragments but not ratified in Docs/spec/syntax-decisions.md")
        assert_ne(status, "provisional", "{id} is ratified but still marked provisional in the canonical syntax source")
    }
}
// Rust: tests/decisions.rs:45
#Test("every_syntax_const_has_adjacent_decision_comment") {
    root :: "crates/jet-foundation/src/Syntax"
    files := ["crates/jet-foundation/src/Syntax.rs".to_string()]
    entries := fs.read_dir(root).expect(root).map(fn(e) -> e.expect("Syntax fragment entry").path()).filter(fn(p) -> p.extension().and_then(fn(e) -> e.to_str()) == Some("rs")).collect()
    entries.sort()
    loop path in entries { files.push(path.display().to_string()) }
    // Ratchet: foundational pre-decision keywords are exempt, never fabricate IDs.
    // Rust: tests/decisions.rs:62
    const EXEMPT_MARKER: String = "KW_DECISION_ID_EXEMPT"
    // Rust: tests/decisions.rs:63
    const EXEMPT_BASELINE: USize = 2 // KW_RETURN, KW_IT
    violations := [String]{}
    exempt_count := 0
    loop file in &files {
        source :: fs.read_to_string(file).unwrap_or_else(fn(err) -> panic("{file}: {err}"))
        covered := false
        exempt := false
        loop (i, line) in source.lines().enumerate() {
            t := line.trim() // #4303
            if t.is_empty() { covered = false; exempt = false; continue }
            if t.starts_with("///") || t.starts_with("//!") {
                if decisions.line_has_decision_id(t) { covered = true }
                if t.contains(EXEMPT_MARKER) { exempt = true }
                continue
            }
            is_kw_or_sigil :: t.starts_with("pub const KW_") || t.starts_with("pub const SIGIL_")
            if is_kw_or_sigil && !covered && !decisions.line_has_decision_id(t) {
                if exempt { exempt_count += 1 }
                else { violations.push("{file}:{i + 1}: {t}") }
            }
        }
    }
    assert(violations.is_empty(), "pub const KW_*/SIGIL_* declarations without an adjacent decision-ID doc comment (I7 — add `/// S123 (ratified): …` or `/// D-XXXX=A: …` directly above, no blank line in between; or a `KW_DECISION_ID_EXEMPT` marker comment if truly foundational and pre-dates the decision log):\n{violations.join("\n")}")
    assert(exempt_count <= EXEMPT_BASELINE, "KW_DECISION_ID_EXEMPT count grew from {EXEMPT_BASELINE} to {exempt_count} — find/assign a real decision ID instead of exempting a new keyword const")
}
// Rust: tests/decisions.rs:138
// #1670 / D-ONCE-LAW1=A: namespaced D- tombstones require provenance in the comment block.
#Test("tombstoned_decision_ids_carry_provenance") {
    docs :: fs.read_to_string("Docs/spec/syntax-decisions.md").expect("Docs/spec/syntax-decisions.md")
    tombstones :: decisions.extract_tombstone_d_ids(docs)
    assert(tombstones.contains("D-CTMARKER1") && tombstones.contains("D-MARKERMOVE1") && tombstones.contains("D-MARKERMOVE2") && tombstones.contains("D-MARKERMOVE3") && tombstones.contains("D-MARKER-FAMILY1"), "tombstone extraction regressed: expected D-CTMARKER1/D-MARKER-FAMILY1/D-MARKERMOVE1..3, got {tombstones:?}")
    // Rust: tests/decisions.rs:151
    const EXCLUDED_DIRS: [String] = []
    // Rust: tests/decisions.rs:152
    const EXCLUDED_FILES: [String] = []
    // Rust: tests/decisions.rs:153
    const PROVENANCE_WORDS: [String] = ["retires", "retired", "superseded", "formerly", "historical", "tombstoned", "predates"]
    files := [String]{}
    loop root in ["crates", "Source"] { decisions.collect_rs_files(root, &EXCLUDED_DIRS, &files) }
    violations := [String]{}
    loop path in &files {
        if EXCLUDED_FILES.contains(&path.as_str()) { continue }
        raw :: fs.read_to_string(path).unwrap_or_else(fn(err) -> panic("{path}: {err}"))
        loop (block_start, block) in decisions.comment_blocks(raw) {
            joined :: block.join(" ")
            lower :: joined.to_lowercase()
            loop id in &tombstones {
                if !decisions.contains_id(joined, id) { continue }
                has_provenance :: PROVENANCE_WORDS.iter().any(fn(w) -> lower.contains(w))
                if !has_provenance { violations.push("{path}:{block_start}: cites tombstoned {id} with no provenance word ({PROVENANCE_WORDS.join("/")})") }
            }
        }
    }
    assert(violations.is_empty(), "comments cite a tombstoned decision ID as if it were live law (#1670, D-ONCE-LAW1):\n{violations.join("\n")}")
}
