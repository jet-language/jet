// Rust: tests/marker_rule_signatures.rs:51
#Test("core_lang_marker_enums_accept_dot_literals_without_imports") {
    ds :: codes("#Inline(.Always)\nfn helper() -> Int { 1 }\nfn run() {}")
    assert(ds.is_empty(), "{ds:?}")
}
// Rust: tests/marker_rule_signatures.rs:57
#Test("arithmetic_policy_accepts_only_declared_sites_and_modes") {
    valid :: codes("""
#Arithmetic(.Checked) fn checked() {}
struct Accumulator { value: U8 }
impl Accumulator {
    #Arithmetic(.Wrapping) fn step(self) {}
}
fn run() {
    #Arithmetic(.Saturating) {}
}
""")
    assert(valid.is_empty(), "{valid:?}")
    wrong_site :: codes("#Arithmetic(.Wrapping) struct Bad { value: U8 }\nfn run() {}")
    assert(wrong_site.iter().any(|code| code == "E0355"), "{wrong_site:?}")
    wrong_mode :: codes("#Arithmetic(.Other) fn bad() {}\nfn run() {}")
    assert(wrong_mode.iter().any(|code| code == "E0930"), "{wrong_mode:?}")
}
// Rust: tests/marker_rule_signatures.rs:86
#Test("job_scope_and_reserved_names_use_the_job_diagnostic") {
    // D-JOB-NAMES1=A: only lifecycle entries, help and version are reserved.
    valid :: codes("#Job(.Ship) fn ship() {}\n#Job(.Internal) fn inspect_job() {}\n#Job fn output() {}\n#Job fn serve() {}\n#Job fn lint() {}\nfn run() {}")
    assert(valid.is_empty(), "{valid:?}")
    loop reserved in ["run", "dev", "build", "test", "help", "version"] {
        ds :: codes("#Job fn {reserved}() {{}}\nfn main() {{}}")
        assert(ds.iter().any(|code| code == "E0928"), "{reserved}: {ds:?}")
    }
}
