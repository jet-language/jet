// Rust: tests/library_outputs.rs:17
pub fn copy_tree(source: &OSPath, target: &OSPath) -> {
    fs.create_dir_all(target).unwrap()
    for entry in fs.read_dir(source).unwrap() {
        item :: entry.unwrap()
        from :: item.path()
        to :: target.join(item.file_name())
        if from.is_dir() { copy_tree(&from, &to) } else { _ :: fs.copy(&from, &to).unwrap() }
    }
}
// Rust: tests/library_outputs.rs:31
pub fn jet_bin() -> OSPath { OSPath.from(env.var_os("CARGO_BIN_EXE_jet").unwrap()) }
// Rust: tests/library_outputs.rs:35
pub fn expected_output() -> String {
    fs.read_to_string(OSPath.from(env.var_os("CARGO_MANIFEST_DIR").unwrap()).join("Examples/features/expected/packages/library_loadable.out")).unwrap()
}
