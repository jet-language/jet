}
// Rust: tests/library_outputs.rs:51
pub fn run_jet_with_pid(root: &OSPath, args: &[String]) -> (UInt32, Output) {
    child := Command.new(jet_bin()).args(args).current_dir(root).env("NO_COLOR", "1").stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().unwrap_or_else(fn(error) -> panic("jet {args:?} could not start: {error}"))
    pid :: child.id()
    output :: child.wait_with_output().unwrap_or_else(fn(error) -> panic("jet {args:?} could not finish: {error}"))
    (pid, output)
}
// Rust: tests/library_outputs.rs:67
pub fn run_jet(root: &OSPath, args: &[String]) -> Output { run_jet_with_pid(root, args).1 }
// Rust: tests/library_outputs.rs:71
pub fn compiler_text(output: &Output) -> String { "stdout:\n{String.from_utf8_lossy(&output.stdout)}\nstderr:\n{String.from_utf8_lossy(&output.stderr)}" }
// Rust: tests/library_outputs.rs:79
pub fn staged_loader_files(pid: UInt32) -> BTreeSet<String> {
    prefix :: "jet-mod-{pid}-"
    fs.read_dir(env.temp_dir()).unwrap().filter_map(fn(result) -> result.ok()).filter_map(fn(entry) -> {
        name :: entry.file_name().to_string_lossy().into_owned()
        name.starts_with(&prefix).then_some(name)
    }).collect()
}
// Rust: tests/library_outputs.rs:91
pub fn all_staged_loader_files() -> BTreeSet<String> {
    fs.read_dir(env.temp_dir()).unwrap().filter_map(fn(result) -> result.ok()).filter_map(fn(entry) -> {
        name :: entry.file_name().to_string_lossy().into_owned()
        name.starts_with("jet-mod-").then_some(name)
    }).collect()
}
