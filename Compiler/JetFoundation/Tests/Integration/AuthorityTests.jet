// Rust: tests/authority.rs:1208
#Test("plugin_load_rejects_a_symlink_outside_the_granted_read_root") {
    if selected_family() != "unix" -> return
    // GATE #4494: native symlink fixture.
    outside :: common.Scratch.new("plugin_outside_read_root")
    allowed :: common.Scratch.new("plugin_allowed_read_root")
    target :: write_plugin_component(&outside, "target.wasm", PLUGIN_ZERO_PARAM_COMPONENT_WAT)
    link :: allowed.join("link.wasm")
    std.os.unix.fs.symlink(&target, &link).expect("create hostile plugin symlink")
    plugin_path :: link.to_string_lossy().replace('\\', "\\\\").replace('"', "\\\"")
    root :: allowed.path.to_string_lossy().replace('\\', "\\\\").replace('"', "\\\"")
    source :: """
use core.plugin as plugin
fn run() {
    policy :: Authority.from_rights(["FS.Read:__ROOT__"])
    hostile :: plugin.load("__PATH__", policy)
    _result :: hostile.zero() ?? {
        print("rejected")
        return
    }
    print("guest-executed")
    print(_result)
}
""".replace("__ROOT__", root).replace("__PATH__", plugin_path)
    api :: plugin_api_snapshot("link", "zero", "", "Int")
    tiers := ["jit", "interpreter"]
    if common.have_rustc() -> tiers.push("release")
    loop tier in tiers {
        (code, stdout, stderr) :: tir_support.run_plugin_tier("plugin_symlink_outside_read_root", &source, tier, &link, &api)
        assert_ne(code, 0, "{tier} followed a plugin symlink outside its root")
        assert_eq(stdout, "", "{tier} emitted output before symlink rejection")
        assert(stderr.contains("file authority path contains a symlink"), "{tier} did not report the symlink rejection: {stderr}")
    }
}
// Rust: tests/authority.rs:1270
#Test("erased_devtools_publications_do_not_feed_panel_state") {
    source :: """
use core.ui as ui
use core.devtools as devtools
struct State {
    selected: String{"none"}
    event_count: Int{0}
}
fn panel_lines(state: State) -> [UINode] {
    return [UINode]{
        ui.text(state.selected),
        ui.text("{state.event_count}")
    }
}
#DevPanel
pub fn panel(state: State) -> UINode {
    return ui.box(panel_lines(state))
}
fn run() {
    selected_value :: "overview"
    #Off {
        devtools.publish(field: .selected, value: selected_value)
        devtools.publish(field: .event_count, value: 1)
    }
    print("ok")
}
"""
    diagnostics :: tir_support.compile_source("erased_devtools_publications", source).expect_err("erased publications must not satisfy panel state fields")
    error_codes :: diagnostics.into_iter().filter(fn(diagnostic) { diagnostic.severity == jet.Diagnostics.Severity.Error }).map(fn(diagnostic) { diagnostic.code }).collect()
    assert_eq(error_codes, ["E1414", "E1414"])
}
// Rust: tests/authority.rs:1315
#Test("erased_authority_scope_does_not_survive_erasure") {
    source :: """
fn erased() {
    #Off {
        #FX(authority: FS.Read) {
            print("erased")
        }
    }
    authority :: Authority.workspace()
    authority.with("FS.Write")
}
fn active() {
    #FX(authority: FS.Read) {
        print("active")
    }
    authority :: Authority.workspace()
    authority.with("FS.Write")
}
fn run() {}
"""
    diagnostics :: jet.compile(source).expect_err("active authority scope must reject IO")
    e0712 :: diagnostics.iter().filter(fn(diagnostic) { diagnostic.code == "E0712" }).count()
    assert_eq(e0712, 1, "only the active authority scope must reject IO: {diagnostics:#?}")
}
// Rust: tests/authority.rs:1373
#Test("manifestless_script_cannot_spawn_but_reads_its_arguments") {
    scratch :: common.Scratch.new("script-authority-spawn")
    marker :: scratch.join("spawned.txt").to_str().expect("scratch path is UTF-8")
    loop tier in SCRIPT_TIERS {
        spawn :: script_run(tier, &[], "spawn.jet", &[marker])
        stderr :: String.from_utf8_lossy(&spawn.stderr)
        assert(!spawn.status.success(), "{tier:?}: spawn must be refused:\n{stderr}")
        assert(stderr.contains("E1803"), "{tier:?}: {stderr}")
        assert(stderr.contains("undecided for `Exec"), "{tier:?}: E1803 names the Exec root: {stderr}")
        assert(stderr.contains("--allow=Exec"), "{tier:?}: the Fix holds the exact --allow command: {stderr}")
        assert(spawn.stdout.is_empty(), "{tier:?}: no user code ran")
        assert(!OSPath.new(marker).exists(), "{tier:?}: no process started")
        argv :: script_run(tier, &[], "argv.jet", &["a", "b"])
        assert(argv.status.success(), "{tier:?}: reading arguments needs no grant:\n{String.from_utf8_lossy(&argv.stderr)}")
        assert_eq(String.from_utf8_lossy(&argv.stdout), "args=2\n", "{tier:?}")
    }
}
// Rust: tests/authority.rs:1401
#Test("leaf_grants_cover_file_reads_but_not_writes") {
    scratch :: common.Scratch.new("script-authority-files")
    target :: scratch.join("written.txt").to_str().expect("scratch path is UTF-8")
    loop tier in SCRIPT_TIERS {
        read :: script_run(tier, &["--allow=FS.Read"], "readfile.jet", &[])
        assert(read.status.success(), "{tier:?}: --allow=FS.Read covers files.read:\n{String.from_utf8_lossy(&read.stderr)}")
        assert_eq(String.from_utf8_lossy(&read.stdout), "read=true\n", "{tier:?}")
        write :: script_run(tier, &["--allow=FS.Read"], "writefile.jet", &[target])
        stderr :: String.from_utf8_lossy(&write.stderr)
        assert(!write.status.success(), "{tier:?}: FS.Read must not cover a write")
        assert(stderr.contains("E1803") && stderr.contains("`FS.Write`"), "{tier:?}: {stderr}")
        assert(!OSPath.new(target).exists(), "{tier:?}: the refused write never ran")
        root :: script_run(tier, &["--allow=FS"], "writefile.jet", &[target])
        assert(root.status.success(), "{tier:?}: the FS root covers the write leaf:\n{String.from_utf8_lossy(&root.stderr)}")
        assert_eq(fs.read_to_string(target).unwrap(), "written", "{tier:?}")
        fs.remove_file(target).unwrap()
    }
}
// Rust: tests/authority.rs:1435
// D-SCRIPT-CONFIRM1=A through a real util-linux script pseudo-terminal.
#Test("script_confirmation_prompt_accepts_enter_and_refuses_n") {
    // GATE #4494: native PTY subprocess and pipe writing.
    if Command.new("script").arg("--version").output().is_err() {
        eprintln("skipping: util-linux `script` is required for a pseudo-terminal")
        return
    }
    scratch :: common.Scratch.new("script-authority-prompt")
    loop (answer, expect_spawn) in [("\n", true), ("n\n", false)] {
        marker :: scratch.join(if expect_spawn -> "yes.txt" else -> "no.txt")
        command :: "{env!("CARGO_BIN_EXE_jet")} run {SCRIPT_AUTHORITY_DIR}/spawn.jet {marker.display()}"
        child := Command.new("script").args(["-qec", &command, "/dev/null"])
            .current_dir(env!("CARGO_MANIFEST_DIR")).env("NO_COLOR", "1").env("JET_RECEIPT_BYPASS", "1")
            .env_remove("CI").stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().expect("script must start")
        {
            stdin := child.stdin.take().expect("script stdin")
            thread.sleep(Duration.from_millis(500))
            stdin.write_all(answer.as_bytes()).unwrap()
        }
        output :: child.wait_with_output().expect("script must finish")
        transcript :: String.from_utf8_lossy(&output.stdout)
        assert(transcript.contains("spawn.jet will:"), "{transcript}")
        assert(transcript.contains("starts other programs"), "{transcript}")
        assert(transcript.contains("Run it? [Y/n/always]"), "{transcript}")
        assert_eq(marker.exists(), expect_spawn, "answer {answer:?}: {transcript}")
        if !expect_spawn -> assert_eq(output.status.code(), .Some(1), "`n` stops with exit 1: {transcript}")
    }
}
