#Test("package_without_authority_block_prints_and_reads_args_on_all_tiers") {
    dir :: "tests/fixtures/package_default_authority"
    loop tier in PACKAGE_DEFAULT_TIERS {
        hello :: package_default_run(tier, "{dir}/hello.jet", &[])
        assert(hello.status.success(), "{tier:?}: printing needs no grant:\n{String.from_utf8_lossy(&hello.stderr)}")
