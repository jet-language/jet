// Rust: tests/authority.rs:673
#Test("authority_plan_refuses_before_spawn_on_all_hosted_tiers") {
    marker :: env.temp_dir().join("jet-authority-plan-marker-{std.process.id()}")
    _ :: fs.remove_file(&marker)
    source :: """
use core.process as process
fn run() {
    policy :: process.workspace()
    spec :: process.cmd(["sh", "-c", "printf spawned > '__MARKER__'"]).cwd("/").under(policy)
    if spec.plan() == {
        .Ok(_) -> print("spawned")
        .Err(_) -> print("refused")
    }
}
""".replace("__MARKER__", marker.to_string_lossy())
    output :: jet.compile(&source).expect("authority plan API should compile")
    assert(output.rust.contains("jet_std_process_spec_under"), "{output.rust}")
    assert(output.rust.contains("jet_process_spec_plan"), "{output.rust}")
    native_backend :: RuntimePolicy.detect_sandbox().level == RuntimePolicy.SandboxLevel.Strong
    expected :: if (selected_os() == "linux" || selected_os() == "macos") && native_backend -> "spawned\n" else -> "refused\n"
    tir_support.assert_tiers_agree("authority_plan_no_spawn", &source, expected)
    assert(!marker.exists(), "plan() spawned the authority-bound command")
}
// Rust: tests/authority.rs:716
#Test("authority_process_binds_exact_resource_grants") {
    cargo :: host_executable("cargo")
    source :: """
use core.process as process
fn run() {
    policy :: Authority.from_rights([
        "FS.Read:repo",
        "FS.Write:.jet/build",
        "Exec:__CARGO__",
    ])
    spec :: process.cmd(["__CARGO__", "test"]).cwd("/tmp").under(policy)
    if spec.plan() == {
        .Ok(_) -> print("planned")
        .Err(_) -> print("refused")
    }
}
""".replace("__CARGO__", cargo)
    output :: jet.compile(&source).expect("exact process grants should compile")
    assert(output.rust.contains("jet_authority_from_rights"), "{output.rust}")
    assert(output.rust.contains("jet_std_process_spec_under"), "{output.rust}")
    native_backend :: RuntimePolicy.detect_sandbox().level == RuntimePolicy.SandboxLevel.Strong
    expected :: if (selected_os() == "linux" || selected_os() == "macos") && native_backend -> "planned\n" else -> "refused\n"
    tir_support.assert_tiers_agree("authority_process_exact_grants", &source, expected)
}
