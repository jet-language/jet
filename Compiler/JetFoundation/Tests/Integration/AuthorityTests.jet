}
// Rust: tests/authority.rs:1108
#Test("authority_web_accepts_the_same_value") {
    source :: "#Target(Web)\nfn run() {\n    #FX(authority: IO) {\n        narrowed :: authority.with(\"IO\")\n        _released :: narrowed.without(\"IO\")\n        print(\"authority\")\n    }\n}\n"
    web :: jet.compile_web_with_path(source, "tests/fixtures/authority_web.jet").expect("web should accept Authority").web.expect("web tier dropped Authority")
    assert(web.wasm_rust.contains("pub extern \"C\" fn jet_entry_"), "web run entry missing")
    assert(web.wasm_rust.contains("jet_runtime_boundary(|| {"), "web run did not retain the runtime boundary")
    assert(web.wasm_rust.contains("jet_authority_with"), "web lost Authority.with")
    assert(web.wasm_rust.contains("jet_authority_without"), "web lost Authority.without")
}
