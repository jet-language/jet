        "authority :: Authority.workspace()",
        "narrowed :: authority.with(\"FS.Read\")",
        "released :: narrowed.without(\"FS.Read\")",
        "#FX(scoped: FS.Read) { inside :: scoped.with(\"FS.Read\") }",
