use jet_foundation.Policy.[ContributionLayer, FactContribution, FactValue, SourceScope]
// Rust: tests/fact_contribution_law.rs:8
fn writer(value: String, scope: SourceScope, layer: ContributionLayer, source: String) -> FactContribution {
    FactContribution.new("Build.Profile", FactValue.Text(value.to_string()), scope, layer, source)
}
