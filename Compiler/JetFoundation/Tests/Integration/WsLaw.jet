// Rust: tests/ws_law.rs:530
pub fn raw_string_start(bytes: [U8], index: USize) -> (USize, USize)? {
    cursor := index
    if bytes.get(cursor) == Val(98) { cursor += 1 }
    if bytes.get(cursor) != Val(114) { return None }
    cursor += 1
    start :: cursor
    loop bytes.get(cursor) == Val(35) { cursor += 1 }
    if bytes.get(cursor) == Val(34) { Val((cursor + 1, cursor - start)) } else { None }
}
// Rust: tests/ws_law.rs:546
pub fn include_at(bytes: [U8], index: USize) -> (USize, String)? {
    if bytes.get(index..<index + "include".len()) != Val("include".as_bytes()) { return None }
    if index != 0 && bytes.get(index - 1).is_some_and((byte) -> byte.is_ascii_alphanumeric() || byte == 95) { return None }
    cursor := index + "include".len()
    loop bytes.get(cursor).is_some_and((byte) -> byte.is_ascii_whitespace()) { cursor += 1 }
    if bytes.get(cursor) != Val(33) { return None }
    cursor += 1
    loop bytes.get(cursor).is_some_and((byte) -> byte.is_ascii_whitespace()) { cursor += 1 }
    if bytes.get(cursor) != Val(40) { return None }
    cursor += 1
    loop bytes.get(cursor).is_some_and((byte) -> byte.is_ascii_whitespace()) { cursor += 1 }
    if bytes.get(cursor) != Val(34) { return None }
    cursor += 1
    target_start :: cursor
    loop {
        byte :: bytes.get(cursor) ?? break
        if byte == 92 { cursor += 2 }
        else if byte == 34 { break }
        else if byte == 10 || byte == 13 { return None }
        else { cursor += 1 }
    }
    if bytes.get(cursor) != Val(34) { return None }
    raw :: bytes.get(target_start..<cursor) ?? return None
    target :: (String.from_utf8(raw).ok() ?? return None).replace("\\", "/")
    cursor += 1
    loop bytes.get(cursor).is_some_and((byte) -> byte.is_ascii_whitespace()) { cursor += 1 }
    if bytes.get(cursor) != Val(41) { return None }
    cursor += 1
    if bytes.get(cursor) == Val(59) { cursor += 1 }
    Val((cursor, target))
}
// Rust: tests/ws_law.rs:608
pub fn char_literal_end(bytes: [U8], quote: USize) -> USize? {
    if bytes.get(quote) != Val(39) { return None }
    cursor := quote + 1
    if bytes.get(cursor) == Val(92) {
        cursor += 1
        byte :: bytes.get(cursor) ?? return None
        if byte == 117 && bytes.get(cursor + 1) == Val(123) {
            cursor += 2
            loop bytes.get(cursor).is_some_and((b) -> b != 125) { cursor += 1 }
            if bytes.get(cursor) != Val(125) { return None }
            cursor += 1
        } else if byte == 120 { cursor += 3 }
        else { cursor += 1 }
    } else {
        raw :: bytes.get(cursor..) ?? return None
        text :: String.from_utf8(raw).ok() ?? return None
        ch :: text.chars().next() ?? return None
        cursor += ch.len_utf8()
    }
    if bytes.get(cursor) == Val(39) { Val(cursor + 1) } else { None }
}
// Rust: tests/ws_law.rs:636
pub fn actual_includes(text: String) -> [(USize, String)] {
    bytes :: text.as_bytes()
    includes := [(USize, String)]{}
    index := 0
    line := 1
    block_depth: USize := 0
    loop index < bytes.len() {
        if block_depth != 0 {
            if bytes.get(index..<index + 2) == Val("/*".as_bytes()) {
                block_depth += 1
                index += 2
            } else if bytes.get(index..<index + 2) == Val("*/".as_bytes()) {
                block_depth -= 1
                index += 2
            } else {
                if bytes[index] == 10 { line += 1 }
                index += 1
            }
            next
        }
        if bytes.get(index..<index + 2) == Val("//".as_bytes()) {
            loop bytes.get(index).is_some_and((byte) -> byte != 10) { index += 1 }
            next
        }
        if bytes.get(index..<index + 2) == Val("/*".as_bytes()) {
            block_depth = 1
            index += 2
            next
        }
        char_quote :: if bytes[index] == 39 { Val(index) }
            else if bytes[index] == 98 && bytes.get(index + 1) == Val(39) { Val(index + 1) }
            else { None }
        if char_quote.and_then((quote) -> char_literal_end(bytes, quote)) == Val(end) {
            index = end
            next
        }
        if raw_string_start(bytes, index) == Val((start, hashes)) {
            cursor := start
            loop {
                if bytes.get(cursor) == Val(byte) {
                    if byte == 10 { line += 1 }
                    if byte == 34 && (0..<hashes).all((offset) -> bytes.get(cursor + 1 + offset) == Val(35)) {
                        index = cursor + 1 + hashes
                        break
                    }
                    cursor += 1
                } else {
                    index = cursor
                    break
                }
            }
            next
        }
        quote :: if bytes[index] == 34 { Val(34) }
            else if bytes[index] == 98 && bytes.get(index + 1) == Val(34) {
                index += 1
                Val(34)
            } else { None }
        if quote == Val(q) {
            index += 1
            loop {
                byte :: bytes.get(index) ?? break
                if byte == 92 { index += 2 }
                else {
                    if byte == 10 { line += 1 }
                    index += 1
                    if byte == q { break }
                }
            }
            next
        }
        if include_at(bytes, index) == Val((end, target)) {
            includes.push((line, target))
            line += bytes[index..<end].iter().filter((byte) -> byte == 10).count()
            index = end
            next
        }
        if bytes[index] == 10 { line += 1 }
        index += 1
    }
    includes
}
// Rust: tests/ws_law.rs:748
pub fn collect_rs(dir: OSPath, files: &[OSPath]) -> {
    // GATE #4494: retained metadata and canonical filesystem identity.
    boundary :: fs.canonicalize(dir.parent().unwrap_or(dir)).unwrap()
    pending := [dir]
    visited := Set<OSPath>{}
    loop {
        current :: &pending.pop() ?? break
        current_is_link :: fs.symlink_metadata(current).unwrap().file_type().is_symlink()
        identity :: if current_is_link {
            fs.canonicalize(current) ?? next
        } else { fs.canonicalize(current).unwrap() }
        if !identity.starts_with(boundary) { next }
        if !visited.insert(identity) { next }
        entries := fs.read_dir(current).unwrap().map((entry) -> entry.unwrap().path()).collect()
        &entries.sort()
        loop path in entries.into_iter().rev() {
            link :: fs.symlink_metadata(path).unwrap()
            if link.file_type().is_symlink() {
                target :: fs.metadata(path) ?? next
                if target.is_dir() { pending.push(path) }
                else if target.is_file() && path.extension().and_then((part) -> part.to_str()) == Val("rs") && fs.canonicalize(path).is_ok_and((item) -> item.starts_with(boundary)) {
                    files.push(path)
                }
            } else if link.is_dir() { pending.push(path) }
            else if link.is_file() && path.extension().and_then((part) -> part.to_str()) == Val("rs") { files.push(path) }
        }
    }
}
