// Rust: tests/jet_test.rs:622
pub struct PropertySample {
    case_index: U64
    seed: U64
    input: I64
}
// Rust: tests/jet_test.rs:628
pub fn parse_property_samples(output: &[U8], engine: String) -> [PropertySample] {
    stdout := String.from_utf8_lossy(output)
    stdout.lines().filter(|line| -> line.starts_with("JET_PROP_SAMPLE ")).map(|line| -> {
        fields := line.split_whitespace().collect()
        assert_eq(fields.len(), 5, "malformed property sample marker: {line}")
        assert_eq(fields[0], "JET_PROP_SAMPLE")
        expected_engine := "engine={engine}"
        assert_eq(fields[1], expected_engine)
        case_index := fields[2].strip_prefix("case=").expect("property sample case field").parse<U64>().expect("property sample case index")
        seed := fields[3].strip_prefix("seed=").expect("property sample seed field").parse<U64>().expect("property sample seed")
        input := fields[4].strip_prefix("input=").expect("property sample input field").parse<I64>().expect("property sample input")
        PropertySample { case_index, seed, input }
    }).collect()
}
// Rust: tests/jet_test.rs:663
pub fn property_sample_digest(samples: &[PropertySample]) -> String {
    mut hash: U64 = 0xcbf29ce484222325
    for sample in samples {
        line := "{sample.case_index}:{sample.seed}:{sample.input}\n"
        for byte in line.bytes() {
            hash ^= U64(byte)
            #Arithmetic(.Wrapping) { hash = hash * U64{0x100000001b3} }
        }
    }
    hash.to_string_radix(16).pad_start(16, '0')
}
// Rust: tests/jet_test.rs:675
pub fn property_distribution(samples: &[PropertySample]) -> [USize#4] {
    explicit_landmarks: [I64] = [0, 1, -1, 2, -2, 42, -42, 99, 100, 255, 256, 512, 1024, I64.MIN, I64.MAX]
    mut counts: [USize#4] = [0, 0, 0, 0]
    for sample in samples {
        if sample.input == 42 { counts[0] += 1 }
        if sample.input == 0 || sample.input == 1 || sample.input == -1 { counts[1] += 1 }
        if sample.input == I64.MIN || sample.input == I64.MAX { counts[2] += 1 }
        if !explicit_landmarks.contains(&sample.input) { counts[3] += 1 }
    }
    counts
}
// Rust: tests/jet_test.rs:711
pub fn report_field(value: &DataTree, key: String) -> &DataTree {
    value.get(key).unwrap_or_else(|error| -> panic("missing JSON field `{key}`: {error}"))
}
// Rust: tests/jet_test.rs:717
pub fn report_object(value: &DataTree, key: String) -> &DataTree {
    field := report_field(value, key)
    match field {
        DataTree.Object(_) -> field
        else -> panic("JSON field `{key}` must be an object: {field:?}")
    }
}
// Rust: tests/jet_test.rs:725
pub fn report_array(value: &DataTree, key: String) -> &[DataTree] {
    report_field(value, key).as_array().unwrap_or_else(|error| -> panic("JSON field `{key}` must be an array: {error}"))
}
// Rust: tests/jet_test.rs:731
pub fn report_text(value: &DataTree) -> String {
    value.as_str().unwrap_or_else(|error| -> panic("JSON field must be text: {error}"))
}
// Rust: tests/jet_test.rs:737
pub fn report_int(value: &DataTree) -> I64 {
    match value {
        DataTree.Int(number) -> number
        DataTree.Number(number) -> number.parse<I64>().unwrap_or_else(|_| -> panic("JSON field must be an integer: {number}"))
        else -> panic("JSON field must be an integer: {value:?}")
    }
}
// Rust: tests/jet_test.rs:747
pub fn report_float(value: &DataTree) -> F64 {
    match value {
        DataTree.Float(number) -> number
        DataTree.Int(number) -> F64(number)
        DataTree.Number(number) -> number.parse<F64>().unwrap_or_else(|_| -> panic("JSON field must be numeric: {number}"))
        else -> panic("JSON field must be numeric: {value:?}")
    }
}
// Rust: tests/jet_test.rs:1265
// GATE #4494: execute actual CLI in the requested package directory.
pub fn jet_ok_outside_core(jet: &OSPath, dir: &OSPath, args: &[String]) -> String {
    out := process.Command.new(jet).args(args).current_dir(dir).output().unwrap()
    stdout := String.from_utf8_lossy(&out.stdout).into_owned()
    stderr := String.from_utf8_lossy(&out.stderr)
    assert(out.status.success(), "jet {args:?} failed in {dir.display()}:\nstdout: {stdout}\nstderr: {stderr}")
    assert(!stderr.contains("Core/") && !stdout.contains("Core/"), "jet {args:?} reported a diagnostic located in Core source:\n{stderr}")
    stdout
}
