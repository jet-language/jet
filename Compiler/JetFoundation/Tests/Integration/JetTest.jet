// Rust: tests/jet_test.rs:1462
pub fn bare_package_project(label: String, jet: &OSPath) -> BarePackage {
    parent_scratch := common.Scratch.new("jet_test_{label}_parent")
    parent := &parent_scratch.path
    tir_support.write_test_package(parent, tir_support.TIR_TEST_PACKAGE)
    name := "jet_test_{label}"
    dir := parent.join(name)
    created := process.Command.new(jet).arg("new").arg(name).current_dir(parent).output().unwrap()
    assert(created.status.success(), "jet new failed:\nstdout: {String.from_utf8_lossy(&created.stdout)}\nstderr: {String.from_utf8_lossy(&created.stderr)}")
    fs.write(dir.join("run.jet"), "fn run() -> {}\n").unwrap()
    BarePackage { path: dir, _parent: parent_scratch }
}
// Rust: tests/jet_test.rs:1732
pub fn fuzz_corpus_dir(label: String) -> OSPath {
    dir := common.unique_tmp("jet_fuzz_corpus_{label}")
    _ :: fs.remove_dir_all(&dir)
    dir
}
