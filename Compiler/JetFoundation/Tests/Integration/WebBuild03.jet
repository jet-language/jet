use core.fs as fs
use core.path.OSPath
use std.process.Command

// Rust: tests/web_build.rs:5367
pub WASM_CALLBACK_HARNESS :: `
class FakeElement {
  constructor(id) { this.id = id; this.listeners = new Map(); }
  addEventListener(name, handler) {
    const list = this.listeners.get(name) ?? [];
    list.push(handler);
    this.listeners.set(name, list);
  }
  dispatchEvent(ev) {
    ev.target = this;
    for (const handler of this.listeners.get(ev.type) ?? []) handler(ev);
  }
}
class FakeDocument {
  constructor() { this.button = new FakeElement("go"); }
  querySelector(sel) { return sel === "#go" ? this.button : null; }
  getElementById(id) { return id === "go" ? this.button : null; }
  createElement(tag) { return new FakeElement(tag); }
}
globalThis.document = new FakeDocument();
const { init } = await import("./app.js");
init();
document.button.dispatchEvent({ type: "click" });
`

// Rust: tests/web_build.rs:5404
// GATE #4494: native fs/Command and actual Node execution.
pub fn run_node_harness(dir: &OSPath, filename: String, harness: String) -> String {
    harness_path :: dir.join("build").join(filename)
    fs.write(&harness_path, harness).unwrap()
    node :: Command.new("node").current_dir(dir.join("build")).arg(filename).output().unwrap()
    assert(node.status.success(), "node harness {filename} failed:\nstdout: {String.from_utf8_lossy(&node.stdout)}\nstderr: {String.from_utf8_lossy(&node.stderr)}")
    String.from_utf8_lossy(&node.stdout).into_owned()
}
