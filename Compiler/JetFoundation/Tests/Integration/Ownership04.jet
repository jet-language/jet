//RS 
//RS /// The callback's returned window must stay tied to the list the callback was
//RS /// handed, and the wrapper's own return must stay tied to the wrapper's own
//RS /// parameter. Both are one-lifetime-on-both-ends facts, and they are what makes
//RS /// a later `values.push(…)` reachable as E0212 through a function value.
//RS ///
//RS /// 56f4f7bd4 (2026-07-31) gave the callback's binder its own name: reusing the
//RS /// enclosing function's `'__jet___view` inside a `for<…>` binder is an E0496
//RS /// shadow whenever a view-returning fn takes a view-returning callback. The
//RS /// rename is why the old spelling no longer appears; the provenance it carries
//RS /// is unchanged, so assert the whole trait shape rather than one lifetime name,
//RS /// and assert the two binders stay distinct.
//RS #[test]
//RS fn parameter_rooted_lambda_and_generic_callback_preserve_view_provenance() {
//RS     let src = r#"
//RS fn apply(callback: fn([Int]) -> View<Int>, values: [Int]) -[]> View<Int> {
//RS     return callback(values)
//RS }
//RS 
//RS fn run() {
//RS     values := [7, 8]
//RS     selected :: apply((items: [Int]) -> items[0..1], values)
//RS     print(selected[0])
//RS }
//RS "#;
//RS     let out = jet::compile(src).expect("callback provenance is hidden in the function value");
//RS     // One binder, on the callback's argument AND on its result: the window the
//RS     // callback returns can only come from the list it was given.
//RS     assert!(
//RS         out.rust.contains(
//RS             "dyn for<'__jet___fn_view> Fn(&'__jet___fn_view Vec<i64>) -> JetOutcome<&'__jet___fn_view [i64], JetErr>"
//RS         ),
//RS         "the callback must return a window into its own argument: {}",
//RS         out.rust
//RS     );
//RS     // The wrapper's own return is tied to the wrapper's own parameter.
//RS     assert!(
//RS         out.rust
//RS             .contains("__jet_values: &'__jet___view Vec<i64>) -> JetOutcome<&'__jet___view [i64], JetErr>"),
//RS         "the wrapper's returned window must be tied to its list parameter: {}",
//RS         out.rust
//RS     );
//RS     // The E0496 half of the same shape: the callback's binder is not the
//RS     // enclosing function's lifetime, so the two windows are never conflated.
//RS     assert!(
//RS         !out.rust.contains("dyn for<'__jet___view>"),
//RS         "the callback binder must not shadow the enclosing view lifetime: {}",
//RS         out.rust
//RS     );
//RS }
