//RS #[test]
//RS fn borrowed_parameter_subplaces_copy_in_owning_positions() {
//RS     let cases = [
//RS         r#"
//RS struct Parcel { label: String }
//RS struct Holder { value: String }
//RS fn wrap(parcel: Parcel) -[]> Holder { return Holder{ value: parcel.label } }
//RS fn run() { print(0) }
//RS "#,
//RS         r#"
//RS enum Wrapped { Val(String) }
//RS fn wrap(values: [String]) -[]> Wrapped { return Wrapped.Val(values[0]) }
//RS fn run() { print(0) }
//RS "#,
//RS         r#"
//RS struct Parcel { label: String }
//RS fn replace(parcel: Parcel) {
//RS     owned := "old"
//RS     owned = parcel.label
//RS }
//RS fn run() { print(0) }
//RS "#,
//RS     ];
//RS     for src in cases {
//RS         jet::compile(src).expect("an owning destination must materialize a read subplace");
//RS     }
//RS }
//RS 
//RS /// Two windows over the same subplace of a read parameter, in the two positions
//RS /// that decide differently, in one function so neither can disturb the other:
//RS /// spec.md:339-340 — "a cloneable read value entering an owning destination is
//RS /// materialized automatically; a bare `::` binding remains a read window" — and
//RS /// spec.md:438-439, where a place ends in "its maximal field, index, or range
//RS /// projection", so a FIELD place is the same window a range place is.
//RS ///
//RS /// The function value is the trap: `callback(parcel.label, 1)` is a borrow
//RS /// position, and a copy inserted there would hand the callback a fresh
//RS /// allocation instead of the caller's own storage, silently breaking
//RS /// spec.md:338's allocation-free read call.
//RS #[test]
//RS fn function_value_borrow_context_preserves_parameter_place_window() {
//RS     let src = r#"
//RS struct Parcel { label: String }
//RS fn inspect(text: String, n: Int) {
//RS     print(text)
//RS     print(n)
//RS }
//RS fn apply_to(parcel: Parcel, callback: fn(String, Int)) {
//RS     callback(parcel.label, 1)
//RS     alias :: parcel.label
//RS }
//RS fn run() { apply_to(Parcel{ label: "hello" }, inspect) }
//RS "#;
//RS     let out = jet::compile(src).expect("bare parameter subplace is a read window");
//RS     assert!(
//RS         out.rust.contains("__jet_parcel: &__jet_Parcel"),
//RS         "{}",
//RS         out.rust
//RS     );
//RS     // The borrow position: the subplace is reborrowed out of the parameter's
//RS     // own storage, not materialized.
//RS     assert!(
//RS         out.rust
//RS             .contains("((*__jet_callback))(&(((*__jet_parcel)).__jet_label),"),
//RS         "the callback argument must reborrow the subplace: {}",
//RS         out.rust
//RS     );
//RS     // The bare `::` binding: still a read window.
//RS     assert!(out.rust.contains("let __jet_alias = &"), "{}", out.rust);
//RS     assert!(
//RS         !out.rust.contains("((*__jet_parcel)).__jet_label).clone()"),
//RS         "a bare `::` binding must not allocate a copy of the subplace: {}",
//RS         out.rust
//RS     );
//RS }
//RS 
//RS /// Three refusal rails, one per access the caller failed to write. The middle
//RS /// one is the load-bearing case for D-MEM-COPYSEM1: a move (`^`) parameter is
//RS /// an owning slot, so the automatic materialization applies to it too — but a
//RS /// bare NAME at that slot is E0209 first ("a named binding passed where it
//RS /// would be silently cloned — Move-param arg without the move marker `^`);
//RS /// see the registered `Diagnostics.jet` row ("no clone is ever silent",
//RS /// D-MEM1/S2). If materialization rewrites the name before that check reads it,
//RS /// the hard error disappears and the clone becomes silent — which is why the
//RS /// convention check reads the argument as it was WRITTEN.
//RS ///
//RS /// The third rail is the survivor of the E0120 side: a `fn` value is not
//RS /// cloneable (`is_cloneable`, Sema/Diagnostics.rs:502), so nothing materializes
//RS /// it and the escape is still refused outright.
//RS #[test]
//RS fn plain_parameter_write_take_and_escape_diagnostics_name_explicit_access() {
//RS     let write_src = r#"
//RS fn edit(values: [Int]) {
//RS     values[0] = 4
//RS }
//RS fn run() { print(0) }
//RS "#;
//RS     let write = jet::compile(write_src).expect_err("plain list parameter cannot be edited");
//RS     let write = write
//RS         .iter()
//RS         .find(|d| d.code == "E0205")
//RS         .unwrap_or_else(|| panic!("expected E0205: {write:?}"));
//RS     assert!(write.fix.contains("&[Int]"), "{write:?}");
//RS 
//RS     let take_src = r#"
//RS fn consume<T>(value: ^T) { print(0) }
//RS fn relay<T>(value: T) { consume(value) }
//RS fn run() { print(0) }
//RS "#;
//RS     let take = jet::compile(take_src).expect_err("plain generic parameter cannot be consumed");
//RS     let take = take.iter().find(|d| d.code == "E0209").expect("E0209");
//RS     assert!(take.fix.contains("^value"), "{take:?}");
//RS 
//RS     let callback_src = r#"
//RS fn keep(f: fn(Int) -> Int) -[]> fn(Int) -> Int { return f }
//RS fn run() { print(0) }
//RS "#;
//RS     let escape = jet::compile(callback_src).expect_err("plain callback parameter cannot escape");
//RS     assert!(escape.iter().any(|d| d.code == "E0120"), "{escape:?}");
//RS }
//RS 
