//RS /// D-MEM-COPYSEM1=A: a cloneable read value entering an owning destination is
//RS /// materialized automatically (spec.md:339-340), and the return slot is an
//RS /// owning destination — `tests/ui/return_borrowed_param.stderr` is the same
//RS /// shape for a concrete `String` and expects no errors at all. E0120 survives
//RS /// only for the cases whose typed rows in `Diagnostics.jet` name: a
//RS /// non-cloneable value or `copies: .Explicit`.
//RS ///
//RS /// The property this test defends is unchanged: a read parameter never escapes
//RS /// as owned WITHOUT an ownership decision. For a generic the decision cannot be
//RS /// made at the definition, so the compiler pays for it visibly — it borrows the
//RS /// parameter, materializes at the return, and puts the resulting `Clone`
//RS /// obligation in the signature where every caller must satisfy it. Assert all
//RS /// three, because dropping any one of them is a different (and wrong) compiler:
//RS /// `&T` alone would allow a move out of a borrow, and `T: Clone` alone would
//RS /// allow the parameter to be taken by value.
//RS #[test]
//RS fn generic_borrowed_parameter_materializes_an_owned_return() {
//RS     let src = r#"
//RS fn identity<T>(value: T) -[]> T {
//RS     return value
//RS }
//RS 
//RS fn run() {
//RS     print(0)
//RS }
//RS "#;
//RS     let out =
//RS         jet::compile(src).expect("a cloneable read parameter materializes at an owned return");
//RS     assert!(
//RS         out.rust
//RS             .contains("pub fn __jet_identity<T: Clone>(__jet_value: &T) -> JetOutcome<T, JetErr> {"),
//RS         "the escape must be paid for in the signature, not laundered: {}",
//RS         out.rust
//RS     );
//RS     assert!(
//RS         out.rust.contains("return Ok(((*__jet_value)).clone());"),
//RS         "the owned return must copy through the borrow, never move out of it: {}",
//RS         out.rust
//RS     );
//RS     // The boundary, from the same output: nothing turned the read parameter
//RS     // into an owned one. A compiler that "solved" the escape by taking the
//RS     // parameter by value would satisfy both assertions above while quietly
//RS     // changing the signature's access.
//RS     assert!(
//RS         !out.rust.contains("__jet_value: T"),
//RS         "the parameter must stay a read borrow, not become an owned slot: {}",
//RS         out.rust
//RS     );
//RS     // The refusal rail this test used to own now lives with the typed rows in
//RS     // `Diagnostics.jet` — a non-cloneable value or `copies: .Explicit`
//RS     // (tests/ui/param_owned_field_needs_copy_explicit) —
//RS     // and the `Clone` obligation is only added where a copy is actually
//RS     // demanded (`generic_clone_bound_is_usage_sensitive`, above).
//RS }
