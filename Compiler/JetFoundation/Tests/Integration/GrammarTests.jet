}
// Rust: tests/grammar.rs:657
#Test("parse_value_tail_stays_an_expression_statement") {
    src :: "\nfn label() -> String {{\n    \"label\"\n}}\nfn run() {{}}\n"
    (tokens, diagnostics) :: Lexer.lex(src)
    assert(diagnostics.is_empty(), "lex diagnostics: {diagnostics:Debug}")
    program :: Parser.parse(&tokens).expect("value tail parses")
    function :: match &program.items[0] { AST.Item.Func(function) -> function, _ -> panic("expected label function") }
    assert(match function.body.last() { Some(AST.Stmt.Expr(AST.Expr.Str(..))) -> true, _ -> false })
}
// Rust: tests/grammar.rs:677
#Test("parse_pipe_switch_arms_as_subject_tests") {
    src :: "\nfn run() {{\n    fruit :: \"orange\"\n    if fruit == {{\n        apple -> {{ print(\"Apple Juice\") }}\n        orange | mango -> {{ print(\"Orange Juice\") }}\n        tangerine | yuzu -> {{ print(\"Citrus Juice\") }}\n        else -> {{ print(\"Water\") }}\n    }}\n    print(\"done\")\n}}\n"
    (toks, lex_diags) :: Lexer.lex(src)
    assert(lex_diags.is_empty(), "lex diagnostics: {lex_diags:Debug}")
    prog :: Parser.parse(&toks).expect("parse")
    func :: match &prog.items[0] { AST.Item.Func(func) -> func, _ -> panic("expected function") }
    (subject, arms, else_body) :: match &func.body[1] { AST.Stmt.Switch{subject, arms, else_body, ..} -> (subject, arms, else_body), _ -> panic("expected switch") }
    assert(match subject { AST.Expr.Ident(name, _) -> name == "fruit", _ -> false })
    assert_eq(arms.len(), 3)
    assert(else_body.is_some())
    assert(match &arms[0].cond { AST.Expr.Binary(AST.BinOp.Eq, _, _, _) -> true, _ -> false })
    assert(match &arms[1].cond { AST.Expr.Binary(AST.BinOp.Or, _, _, _) -> true, _ -> false })
}
// Rust: tests/grammar.rs:722
#Test("parse_subjectless_guard_tables_reuse_if_dispatch") {
    src :: "\nfn run() {{\n    ready :: false\n    stale :: true\n    if {{\n        ready -> print(\"ready\")\n        stale -> print(\"stale\")\n    }}\n    label :: if {{\n        ready -> \"ready\"\n        stale -> \"stale\"\n        else -> \"waiting\"\n    }}\n    if ready {{ print(label) }}\n}}\n"
    (toks, lex_diags) :: Lexer.lex(src)
    assert(lex_diags.is_empty(), "lex diagnostics: {lex_diags:Debug}")
    program :: Parser.parse(&toks).expect("subjectless guards should parse")
    run :: match &program.items[0] { AST.Item.Func(run) -> run, _ -> panic("expected function") }
    (subject, arms, else_body, span) :: match &run.body[2] { AST.Stmt.Switch{subject, arms, else_body, span} -> (subject, arms, else_body, span), _ -> panic("braced statement guards must reuse dispatch AST") }
    assert(match subject { AST.Expr.Bool(true, s) -> s == span, _ -> false })
    assert_eq(arms.len(), 2)
    assert(else_body.is_none(), "statement guard fallback is optional")
    label :: match &run.body[3] { AST.Stmt.Val(label) -> label, _ -> panic("expected value guard binding") }
    assert(match label.init { AST.Expr.If{..} -> true, _ -> false })
    assert(match run.body[4] { AST.Stmt.Switch{..} -> true, _ -> false })
}
// Rust: tests/grammar.rs:765
#Test("dispatch_atom_boolean_groups_are_required_and_machine_fixable") {
    invalid :: "\nfn run() {{\n    n :: 48\n    ready :: true\n    if n < {{\n        48 | 45 && ready -> print(\"hit\")\n        else -> print(\"miss\")\n    }}\n}}\n"
    (tokens, lex_diags) :: Lexer.lex(invalid)
    assert(lex_diags.is_empty(), "lex diagnostics: {lex_diags:Debug}")
    (_, diagnostics) :: Parser.parse_for_check_with_source(&tokens, invalid).expect("the new teaching diagnostic should recover the arm table")
    diagnostic :: diagnostics.iter().find((diagnostic) -> diagnostic.code == "E0386").expect("unparenthesized distributed group diagnostic")
    edit :: diagnostic.edit.as_ref().expect("machine-applicable grouping edit")
    assert_eq(invalid[edit.span.start..edit.span.end], "48 | 45")
    assert_eq(edit.new_text, "(48 | 45)")
    assert_eq(diagnostic.applicability, Some(Diagnostics.FixApplicability.Safe))
    assert_eq(diagnostic.safety, Some(Diagnostics.FixSafety.Formatting))
    legal :: invalid.replace("48 | 45", "(48 | 45)")
    (fixed_tokens, fixed_lex_diags) :: Lexer.lex(&legal)
    assert(fixed_lex_diags.is_empty(), "fixed lex diagnostics: {fixed_lex_diags:Debug}")
    assert(Parser.parse(&fixed_tokens).is_ok(), "fixed arm head should parse")
    untouched :: "\nfn run() {{\n    value :: 1\n    if value == {{\n        301 | 302 -> print(\"atom\")\n        value >= 500 -> print(\"predicate\")\n        .Err(e) && e.fatal -> print(\"guard\")\n        else -> print(\"other\")\n    }}\n}}\n"
    (untouched_tokens, untouched_lex_diags) :: Lexer.lex(untouched)
    assert(untouched_lex_diags.is_empty(), "untouched lex diagnostics: {untouched_lex_diags:Debug}")
    (_, untouched_diagnostics) :: Parser.parse_for_check_with_source(&untouched_tokens, untouched).expect("untouched arm forms should parse")
    assert(untouched_diagnostics.iter().all((diagnostic) -> diagnostic.code != "E0386"), "pure atoms, predicates, and pattern guards are unchanged: {untouched_diagnostics:Debug}")
}
// Rust: tests/grammar.rs:834
#Test("parse_bracket_collection_types_and_semicolon_list_items") {
    src :: "\npub fn shell() -> [JSON] {{\n    return [\n        JSON.Null;\n    ];\n}}\n\nfn use_collections(items: [String], counts: [String:Int]) {{}}\n"
    (toks, lex_diags) :: Lexer.lex(src)
    assert(lex_diags.is_empty(), "lex diagnostics: {lex_diags:Debug}")
    prog :: Parser.parse(&toks).expect("parse")
    shell :: match &prog.items[0] { AST.Item.Func(shell) -> shell, _ -> panic("expected shell function") }
    assert(match shell.return_type { Some(AST.Type.List(_)) -> true, _ -> false })
    use_collections :: match &prog.items[1] { AST.Item.Func(use_collections) -> use_collections, _ -> panic("expected use_collections function") }
    assert(match use_collections.params[0].ty { AST.Type.List(_) -> true, _ -> false })
    assert(match use_collections.params[1].ty { AST.Type.Map{..} -> true, _ -> false })
}
// Rust: tests/grammar.rs:865
#Test("parse_numeric_field_emits_e0049") {
    src :: "fn run() {{ x :: p.0 }}"
    (toks, _) :: Lexer.lex(src)
    (_prog, diags) :: Parser.parse_for_check(&toks).expect("recoverable parse")
    assert(diags.iter().any((d) -> d.code == "E0049"), "expected E0049 for `.0` access, got: {diags:Debug}")
}
