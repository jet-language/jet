    src :: "fn run() {{\n    a :: 2 ^ 3 ^ 2\n    b :: -3 ^ 2\n    c :: (2 ^ 3) ^ 2\n    d :: (-3) ^ 2\n    e :: 2 ^ -1\n    f :: 12 ~| 10\n    g := 2\n    g ^= 10\n    h := 12\n    h ~|= 10\n    print(\"{{a}}{{b}}{{c}}{{d}}{{e}}{{f}}{{g}}{{h}}\")\n}}\n"
