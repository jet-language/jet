}
// Rust: tests/fmt.rs:4069
#Test("fmt_preserves_inline_dep_version") {
    src :: "use textkit#1.4.2\n\nfn run() {{\n    print(\"hi\")\n}}\n"
    assert_fmt_stable(src, "inline dep version (3-part)")
    loose :: "use textkit#1.4\n\nfn run() {{\n    print(\"hi\")\n}}\n"
    assert_fmt_stable(loose, "inline dep version (loose)")
    with_semi :: "use textkit#1.4.2;\n\nfn run() {{\n    print(\"hi\")\n}}\n"
    out :: format_source(with_semi).expect("fmt should accept a trailing `;`")
    assert(out.contains("use textkit#1.4.2\n") && !out.contains("use textkit#1.4.2;"), "fmt should canonicalize away the optional `;`, got:\n{out}")
    twice :: format_source(&out).expect("second fmt should succeed")
    assert_eq(out, twice, "inline dep version with dropped `;` must be idempotent")
}
