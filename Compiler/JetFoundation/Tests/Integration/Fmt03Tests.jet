// Rust: tests/fmt.rs:3961
#Test("fmt_typed_derive_body_comment_not_duplicated") {
    // #4512: named template method uses the one-arrow braced-body form.
    src :: "derive T.Label {{\n    info :: T.reflect()\n    tname :: info.name\n    // resolves to the same value as `tname`\n    lbl :: $tname\n    fn label(self) -> String {{ $lbl }}\n}}\n\n#Label\nstruct Cube {{\n    side: Int\n}}\n\nfn run() {{\n    c :: Cube{{side: 5}}\n    print(c.label())\n}}\n"
    out :: format_source(src).expect("fmt should succeed on a derive block")
    assert_eq(out.matches("resolves to the same value as `tname`").count(), 1, "derive-body comment must not duplicate, got:\n{out}")
    twice :: format_source(&out).expect("second fmt should succeed")
    assert_eq(out, twice, "derive-body comment fmt must be idempotent")
}
