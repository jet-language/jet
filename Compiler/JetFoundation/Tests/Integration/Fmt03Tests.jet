// Rust: tests/fmt.rs:4216
#Test("generic_modules_roundtrip_templates_symbolic_lengths_nested_items_and_alias_chains") {
    src :: "module ring<T>(capacity: Int, label: String) {{\n#Meta(category: label)\nSIZE :: prep {{ capacity }}\npub struct Buffer {{ slots: [T#capacity] }}\nmodule nested<U> {{ pub fn keep(value: U) -> U {{ return ~value }} }}\nmodule inner :: nested<T>\n#Meta(category: label)\npub fn adjusted() -> Int {{ return capacity + 1 }}\n}}\nmodule a :: ring<Int>(2 + 2, \"ring\")\nmodule b :: a\nfn run() {{}}\n"
    once :: format_source(src).expect("generic module format")
    twice :: format_source(&once).expect("formatted generic module reparses")
    assert_eq(once, twice)
    for preserved in ["module ring<T>(capacity: Int, label: String)", "#Meta(category: label)", "[T#capacity]", "module nested<U>", "capacity + 1", "ring<Int>(2 + 2, \"ring\")", "module b :: a"] { assert(once.contains(preserved), "formatter lost `{preserved}`:\n{once}") }
}
// Rust: tests/fmt.rs:4250
#Test("subjectless_guards_preserve_tokens_and_are_byte_stable") {
    src :: "fn run() {{\n    ready :: true\n    if ready -> print(\"inline\")\n    if {{\n        ready -> print(\"ready\")\n        false -> print(\"never\")\n    }}\n    label :: if {{\n        ready -> \"ready\"\n        else -> \"waiting\"\n    }}\n    print(label)\n}}\n"
    once :: format_source(src).expect("subjectless guards should format")
    assert_eq(once, src, "concise subjectless guards should stay byte-stable")
    for preserved in ["if ready -> print(\"inline\")", "if {{", "ready ->", "false ->", "else -> \"waiting\"", "print(label)"] { assert(once.contains(preserved), "formatter lost `{preserved}`:\n{once}") }
    twice :: format_source(&once).expect("formatted guards should reparse")
    assert_eq(once, twice, "subjectless guard formatting must be byte-stable")
}
// Rust: tests/fmt.rs:4293
