use jet.format_source
use jet.Compiler.parse_source
use jet_foundation.Tests.Integration.Fmt.assert_fmt_stable
// Rust: tests/fmt.rs:3587
#Test("fmt_preserves_yield") {
    src :: "fn count(n: Int) -> Stream<Int> {{\n    i := 0\n    loop i < n {{\n        yield i\n        i = i + 1\n    }}\n}}\n\nfn run() {{\n    loop x in count(3) {{ print(\"{{x}}\") }}\n}}\n"
    assert_fmt_stable(src, "yield")
}
// Rust: tests/fmt.rs:3607
#Test("fmt_preserves_chained_comparison") {
    src :: "fn run() {{\n    sev :: 5\n    if 0 <= sev < 10 {{ print(\"in range\") }}\n}}\n"
    assert_fmt_stable(src, "chained comparison")
}
// Rust: tests/fmt.rs:3621
#Test("fmt_never_emits_an_unparenthesized_and_or_mix") {
    src :: "fn run() {{\n    a :: true\n    b :: false\n    c :: true\n    print((a || b) && c)\n    print(a || (b && c))\n    print((a && b) || c)\n    print(a && b && c)\n    print(a || b || c)\n}}\n"
    assert_fmt_stable(src, "grouped && / || mixes")
    for (mixed, grouped) in [("a || b && c", "a || (b && c)"), ("a && b || c", "(a && b) || c")] {
        program :: "fn run() {{\n    a :: true\n    b :: false\n    c :: true\n    print({mixed})\n}}\n"
        once :: format_source(&program).expect("a recovered mix still formats")
        assert(once.contains("print({grouped})"), once)
    }
}
