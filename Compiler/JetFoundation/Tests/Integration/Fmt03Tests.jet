    src :: "#Target(JS)\nfn render_stat(label: String) -> String {{\n    return \"<div>{{label}}</div>\"\n}}\n\n#Target(Wasm)\nfn crunch(n: Int) -> Int {{\n    return n * n\n}}\n\n#WasmExport\nfn bridge_total(n: Int) -> Int {{\n    return crunch(n)\n}}\n\nfn run() {{\n    print(\"{{bridge_total(4)}}\")\n}}\n"
