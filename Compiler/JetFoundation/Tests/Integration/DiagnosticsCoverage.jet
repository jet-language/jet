// PORT-PENDING 1040 tests-diagnostics-coverage: tests/diagnostics_coverage.rs:1-2230
// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! Diagnostics coverage accounting (board card c116, P0).
//RS //!
//RS //! Enforces invariant I4: every emitted code must have
//RS //!   (a) an entry in the typed diagnostic-row registry,
//RS //!   (b) at least one harness-enumerated fixture with a column-0 report opener,
//RS //!       and
//RS //!   (c) a `jet explain` page (resolves through Explain::lookup).
//RS //!
//RS //! Also checks I2 regression: the FFI bridge must not surface raw rustc error
//RS //! codes as Jet diagnostic codes (E0061, E0277, E0308, E0425 are rustc codes
//RS //! used internally for pattern-matching rustc stderr — they must never appear
//RS //! as Jet diagnostic IDs in any snapshot or Source/ emission path that calls
//RS //! Diagnostic::error / Diagnostic::warn).
//RS //!
//RS //! Run: `cargo test diagnostics_coverage`
//RS //! Bless new snapshots: `UPDATE_EXPECT=1 cargo test`
//RS 
//RS mod common;
//RS 
//RS use jet_foundation::DataTree::DataTree;
//RS use std::collections::BTreeSet;
//RS use std::fs;
//RS use std::path::PathBuf;
//RS 
//RS // ---------------------------------------------------------------------------
//RS // Helpers
//RS // ---------------------------------------------------------------------------
