// Rust: tests/diagnostics_coverage.rs:613
pub fn is_snake_case(name: String) -> Bool {
    if name.is_empty() { return false }
    previous_underscore := false
    for (index, character) in name.chars().enumerate() {
        if character == '_' {
            if index == 0 || previous_underscore { return false }
            previous_underscore = true
        } else if character.is_ascii_lowercase() || character.is_ascii_digit() { previous_underscore = false }
        else { return false }
    }
    !previous_underscore
}
// Rust: tests/diagnostics_coverage.rs:694
pub fn assert_ui_snapshot_matches_row(code: String, holes: &[(String, String)], fixture: String) -> {
    row :: Registry.diagnostic(code).unwrap_or_else(() -> panic("{code} must stay registered"))
    rendered :: row.render(holes)
    expected :: "Error [{code}]: {rendered.what}\n Why: {rendered.why}\n Fix: {rendered.fix}\nMore: jet-lang.dev/e/{code}\n"
    assert_eq(read(&root().join("tests/ui").join(fixture)), expected, "{fixture} must preserve {code}'s registered What/Why/Fix identity")
}
// Rust: tests/diagnostics_coverage.rs:749
pub fn is_retired(code: String, _diag_md: String) -> Bool { Registry.diagnostic(code).is_some_and((row) -> row.status == Registry.DiagnosticStatus.Retired) }
// Rust: tests/diagnostics_coverage.rs:754
pub fn staged_card_number(reason: String) -> UInt32? {
    card :: reason.strip_prefix("staged #")?
    if card.is_empty() || !card.bytes().all((byte) -> byte.is_ascii_digit()) { return None }
    card.parse::<UInt32>().ok().filter((card) -> card > 0)
}
// Rust: tests/diagnostics_coverage.rs:762
pub fn allowlist_reason_errors(entries: &[(String, String)]) -> [String] {
    entries.iter().filter_map(((code, reason)) -> {
        if reason == "retired" && is_retired(code, "") { None }
        else if staged_card_number(reason).is_some() { None }
        else { Some("{code}: reason must be `retired` or `staged #<card>`") }
    }).collect()
}
// Rust: tests/diagnostics_coverage.rs:782
pub fn coverage_baseline_failure(entries: [String], unimplemented: &Set<String>, emitted: &Set<String>) -> String? {
    expected :: entries.iter().cloned().collect::<Set<String>>()
    now_emitted := expected.intersection(emitted).cloned().collect::<[String]>()
    now_emitted.sort()
    missing := expected.difference(unimplemented).filter((code) -> !emitted.contains(code)).cloned().collect::<[String]>()
    missing.sort()
    unexpected := unimplemented.difference(&expected).cloned().collect::<[String]>()
    unexpected.sort()
    failures := [String]{}
    if !now_emitted.is_empty() { failures.push("EXPECTED_SPEC_AHEAD_OF_IMPL contains now-emitted codes; remove the line for each:\n  {now_emitted.join("\n  ")}") }
    if !missing.is_empty() { failures.push("EXPECTED_SPEC_AHEAD_OF_IMPL is missing baseline entries; restore the line for each:\n  {missing.join("\n  ")}") }
    if !unexpected.is_empty() { failures.push("Unexpected codes registered in typed rows but not emitted in Source/.\nIf this is intentional (staged feature), add the code to EXPECTED_SPEC_AHEAD_OF_IMPL in tests/diagnostics_coverage.rs.\nUnexpected:\n  {unexpected.join("\n  ")}") }
    if failures.is_empty() { None } else { Some(failures.join("\n")) }
}
