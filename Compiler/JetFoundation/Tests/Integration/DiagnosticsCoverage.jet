// Rust: tests/diagnostics_coverage.rs:885
pub const REPORT_FIXTURE_DIRS: [(String, String)] = [("tests/cli", "txt"), ("tests/release", "txt"), ("tests/fixtures/cli-diagnostics", "stderr"), ("tests/fixtures/jetpack-diagnostics", "stderr"), ("tests/fixtures/module-eval-diagnostics", "stderr")]
// Rust: tests/diagnostics_coverage.rs:897
pub fn report_snapshot_paths() -> [OSPath] { report_fixture_snapshot_paths().into_iter().filter((path) -> path.is_file()).collect() }
// Rust: tests/diagnostics_coverage.rs:908
pub fn report_fixture_snapshot_paths() -> [OSPath] {
    base :: root()
    out := [OSPath]{}
    if fs.read_dir(&base.join("tests/ui")) == Ok(entries) {
        for entry in entries.flatten() {
            path :: entry.path()
            if path.is_file() && path.extension().and_then((ext) -> ext.to_str()) == Some(jet.Syntax.FILE_EXT) && !path.file_name().and_then((name) -> name.to_str()).is_some_and((name) -> name.contains(".fixed.")) {
                out.push(path.with_extension("stderr"))
                continue
            }
            if !path.is_dir() { continue }
            entry :: ["run", "main"].into_iter().map((name) -> path.join("{name}.{jet.Syntax.FILE_EXT}")).find((candidate) -> candidate.is_file())
            if entry.is_some() { out.push(path.join("stderr")) }
            else if path.join(jet.Syntax.WORKSPACE_FILE).is_file() {
                name :: path.file_name().expect("workspace fixture directory name").to_string_lossy()
                out.push(path.parent().expect("workspace fixture parent").join("{name}.stderr"))
            }
        }
    }
    if fs.read_dir(&base.join("tests/ui_lint")) == Ok(entries) {
        for entry in entries.flatten() {
            path :: entry.path()
            if path.is_file() && path.extension().and_then((ext) -> ext.to_str()) == Some(jet.Syntax.FILE_EXT) { out.push(path.with_extension("warn")) }
        }
    }
    for (dir, extension) in REPORT_FIXTURE_DIRS {
        if fs.read_dir(base.join(dir)) == Ok(entries) {
            for entry in entries.flatten() {
                path :: entry.path()
                if path.is_file() && path.extension().and_then((ext) -> ext.to_str()) == Some(extension) { out.push(path) }
            }
        }
    }
    out.sort()
    out.dedup()
    out
}
// Rust: tests/diagnostics_coverage.rs:986
pub fn is_report_code(code: String) -> Bool {
    bytes := code.bytes()
    bytes.next().is_some_and((byte) -> byte.is_ascii_uppercase()) && bytes.all((byte) -> byte.is_ascii_uppercase() || byte.is_ascii_digit() || byte == '-')
}
// Column zero only: prose, quoted assertions, and indented backend text are not reports.
// Rust: tests/diagnostics_coverage.rs:995
pub fn extract_report_opening_codes(text: String) -> [String] {
    text.lines().filter_map((line) -> {
        rest :: ["Error [", "Warning [", "Stop [", "Lint ["].into_iter().find_map((prefix) -> line.strip_prefix(prefix))?
        end :: rest.find(']')?
        code := rest[..end] // #4303
        if is_report_code(code) { Some(code.to_string()) } else { None }
    }).collect()
}
// Rust: tests/diagnostics_coverage.rs:1125
pub fn rendered_report_codes() -> Set<String> { report_snapshot_paths().into_iter().flat_map((path) -> extract_report_opening_codes(read(&path))).collect() }
// Rust: tests/diagnostics_coverage.rs:1170
pub fn rendered_snapshot_texts() -> [(OSPath, String)] {
    out := [(OSPath, String)]{}
    for dir in [root().join("tests/ui"), root().join("tests/ui_lint"), root().join("tests/fixtures/jetpack-diagnostics"), root().join("tests/fixtures/module-eval-diagnostics")] {
        entries :: match fs.read_dir(&dir) { Ok(entries) -> entries, Err(_) -> continue }
        for e in entries.flatten() {
            p :: e.path()
            if p.is_dir() {
                sub :: p.join("stderr")
                if sub.is_file() { out.push((sub.clone(), read(&sub))) }
            } else if p.extension().and_then((x) -> x.to_str()).is_some_and((ext) -> ext == "stderr" || ext == "warn") { out.push((p.clone(), read(&p))) }
        }
    }
    for name in ["bind_missing_e3208.txt", "bind_data_invalid_e3208.txt", "doctor_l2101.txt", "fetch_no_git_e1203.txt", "repl_e1801.txt", "unknown_target_e3302.txt"] {
        path :: root().join("tests/cli").join(name)
        if path.is_file() { out.push((path.clone(), read(&path))) }
    }
    out
}
