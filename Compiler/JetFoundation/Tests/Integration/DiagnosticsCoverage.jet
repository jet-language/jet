// Rust: tests/diagnostics_coverage.rs:151
pub fn prelude_declared_type(source: String, rust_type: String) -> Bool {
    source.lines().any((raw) -> {
        line := raw.trim_start() // #4303
        ["pub struct ", "pub enum ", "pub type ", "struct ", "enum ", "type "].iter().any((prefix) -> line.strip_prefix(prefix).and_then((rest) -> rest.split((ch) -> ch.is_whitespace() || ch == '<').next()) == Some(rust_type))
    })
}
// Rust: tests/diagnostics_coverage.rs:172
pub fn prelude_declared_jet_show(source: String, rust_type: String) -> Bool {
    source.lines().any((raw) -> {
        line := raw.trim_start() // #4303
        rest :: match line.strip_prefix("impl ") { Some(rest) -> rest, None -> return false }
        (trait_name, target) :: match rest.split_once(" for ") { Some(parts) -> parts, None -> return false }
        name :: target.split((ch) -> ch.is_whitespace() || ch == '<' || ch == '{').next().unwrap_or_default()
        trait_name.ends_with("JetShow") && name == rust_type
    })
}
// Rust: tests/diagnostics_coverage.rs:189
pub fn prelude_file(relative: String) -> OSPath { root().join("crates/jet-codegen/src/Prelude").join(relative) }
// Rust: tests/diagnostics_coverage.rs:193
pub fn named_string_const(source: String, name: String) -> Set<String> {
    marker :: "const {name}: &[&str] = &["
    start :: source.find(&marker).unwrap_or_else(() -> panic("missing canonical printable const `{name}`"))
    body :: source[start + marker.len()..]
    end :: body.find("];").unwrap_or_else(() -> panic("unterminated canonical printable const `{name}`"))
    body[..end].lines().filter_map((line) -> {
        (_, rest) :: line.split_once('"')?
        (value, _) :: rest.split_once('"')?
        Some(value.to_string())
    }).collect()
}
// Rust: tests/diagnostics_coverage.rs:306
pub fn emitted_codes() -> Set<String> {
    codes := Set<String>.new()
    for dir in [root().join("Source"), root().join("crates")] {
        walk_rs(&dir, (content) -> { for code in extract_quoted_codes(content) { _ :: codes.insert(code) } })
    }
    codes
}
// Rust: tests/diagnostics_coverage.rs:324
pub fn extract_quoted_codes(text: String) -> [String] {
    out := extract_delimited_codes(text, '"', '"')
    out.extend(extract_delimited_codes(text, '[', ']'))
    out
}
// Rust: tests/diagnostics_coverage.rs:330
pub fn extract_delimited_codes(text: String, open: UInt8, close: UInt8) -> [String] {
    out := [String]{}
    bytes :: text.as_bytes()
    i := 0
    while i < bytes.len() {
        if bytes[i] == open {
            start :: i + 1
            end := start
            while end < bytes.len() && (bytes[end].is_ascii_uppercase() || bytes[end].is_ascii_digit() || bytes[end] == '-') { end += 1 }
            if end > start && end < bytes.len() && bytes[end] == close {
                code := text[start..end] // #4303
                if Explain.is_code(code) { out.push(code.to_string()) }
            }
        }
        i += 1
    }
    out
}
// Rust: tests/diagnostics_coverage.rs:357
pub fn walk_rs(dir: &OSPath, cb: (String) -> Void) -> {
    entries :: match fs.read_dir(dir) { Ok(entries) -> entries, Err(_) -> return }
    for e in entries.flatten() {
        p :: e.path()
        if p.is_dir() { walk_rs(&p, cb) }
        else if p.extension().and_then((x) -> x.to_str()) == Some("rs") {
            if fs.read_to_string(&p) == { Ok(content) -> cb(content), Err(_) -> {} }
        }
    }
}
// Rust: tests/diagnostics_coverage.rs:373
pub fn runtime_stop_calls(source: String) -> [[String]] {
    needle :: "set_runtime_stop("
    calls := [[String]]{}
    search_from := 0
    while source[search_from..].find(needle) == Some(offset) {
        start :: search_from + offset + needle.len()
        bytes :: source.as_bytes()
        args := [String]{}
        arg_start := start
        parens := 0
        brackets := 0
        braces := 0
        string := false
        escaped := false
        end: Int? := None
        for index in start..bytes.len() {
            byte :: bytes[index]
            if string {
                if escaped { escaped = false }
                else if byte == '\\' { escaped = true }
                else if byte == '"' { string = false }
                continue
            }
            match byte {
                '"' -> string = true
                '(' -> parens += 1
                ')' if parens > 0 -> parens -= 1
                ')' -> { args.push(source[arg_start..index].trim().to_string()); end = Some(index); break }
                '[' -> brackets += 1
                ']' -> brackets = brackets.saturating_sub(1)
                '{' -> braces += 1
                '}' -> braces = braces.saturating_sub(1)
                ',' if parens == 0 && brackets == 0 && braces == 0 -> { args.push(source[arg_start..index].trim().to_string()); arg_start = index + 1 }
                _ -> {}
            }
        }
        finish :: match end { Some(value) -> value, None -> break }
        calls.push(args)
        search_from = finish + 1
    }
    calls
}
