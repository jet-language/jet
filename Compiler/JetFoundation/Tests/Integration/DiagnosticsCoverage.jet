//RS // ---------------------------------------------------------------------------
//RS // The known exclusions
//RS // ---------------------------------------------------------------------------
//RS 
//RS /// Codes present in Source/ that are NOT Jet diagnostic codes — they are rustc
//RS /// error codes used in FFI.rs to classify rustc stderr output (I2 / looks_like_signature_mismatch).
//RS /// They must never appear in a Jet Diagnostic::error call or a user-facing snapshot
//RS /// (in [Exxxx] bracket format) EXCEPT when embedded in a "cargo said:" block inside an FFI diagnostic.
//RS ///
//RS /// NOTE: E0308 is intentionally excluded here even though it also appears as a rustc code —
//RS /// Jet uses E0308 independently for the null-typing diagnostic (CheckerInfer.rs).
//RS /// The I2 guard for E0308 is that it must never appear ORIGINATING from rustc code paths,
//RS /// which is confirmed by the FFI.rs Diagnostic::error check above.
//RS const RUSTC_CODES_IN_SOURCE: &[&str] = &[
//RS     "E0061", // rustc: wrong arg count — NOT a Jet code
//RS     "E0277", // rustc: trait bound not satisfied — NOT a Jet code
//RS     "E0425", // rustc: unresolved name — NOT a Jet code
//RS ];
//RS 
//RS /// Internal placeholder used in Jetpack/ModuleEval — never reaches the user.
//RS const INTERNAL_PLACEHOLDER: &[&str] = &["E0000"];
//RS 
//RS /// Codes registered in the typed rows as *retired*; still emitted for backward-compat
//RS /// log readability but not expected to have new snapshots.
//RS /// (E0019 is retired but still fires for legacy `import` spelling. The
//RS ///  retirement status in the row is the coverage proof.)
//RS const RETIRED_WITH_LEGACY_EMISSION: &[&str] = &["E0019"];
//RS 
//RS /// Codes that are fully implemented (parser + sema) but gated behind an
//RS /// unreleased syntax feature; the gate is named here. They satisfy I4 via
//RS /// the typed row + the gate comment; snapshots will land with the gate.
//RS ///
//RS /// Gate: D-UNINIT1 (#Uninit binding) — parser gate in Parser/Statements.rs:660
//RS const STAGED_BEHIND_GATE: &[&str] = &[
//RS     "E0420", // #Uninit: read before write
//RS     "E0421", // #Uninit: needs type annotation
//RS     "E0422", // #Uninit: cannot have initializer
//RS     "E0423", // #Uninit: needs plain-data type
//RS     "E0424", // #Uninit: needs use core.mem
//RS ];
//RS 
//RS /// Codes that ARE fully implemented but cannot be snapshot-tested via a .jet file
//RS /// because the triggering condition causes a physical problem (stack overflow, system
//RS /// dependency) before the diagnostic fires. Coverage is via Source/ unit tests or
//RS /// the typed diagnostic row.
//RS ///
//RS /// E0909: Parser depth-guards at 64 levels of generic nesting, but the parser's
//RS ///        own recursive descent overflows the stack before reaching depth 64.
//RS ///        The actual depth guard is tested in Source/Generics.rs unit tests.
//RS ///        (Tracked as a known issue: the guard depth should be lowered to avoid the
//RS ///        stack overflow, but that's a separate bug fix.)
//RS const UNTESTABLE_VIA_SNAPSHOT: &[&str] = &[
//RS     "E0909", // generic instantiation: parser stack overflow before depth guard fires
//RS ];
//RS 
//RS /// Current fixture/registry mismatches that are intentional and owned. The
//RS /// side names which independently maintained table is missing the code:
//RS /// `left-only` is a registered-active emitted code without a report opener;
//RS /// `right-only` is a report opener without a registered-active emitted code.
//RS /// Every row has an owner, and the count ratchet below makes this list shrink-only.
