// Rust: tests/diagnostics_coverage.rs:1466
pub const DIAGNOSTIC_COVERAGE_ALLOWLIST_CEILING: Int = 152
// Rust: tests/diagnostics_coverage.rs:1469
pub fn all_exclusions() -> Set<String> {
    RUSTC_CODES_IN_SOURCE.iter().chain(INTERNAL_PLACEHOLDER.iter()).chain(RETIRED_WITH_LEGACY_EMISSION.iter()).chain(STAGED_BEHIND_GATE.iter()).chain(UNTESTABLE_VIA_SNAPSHOT.iter()).cloned().collect()
}
// Rust: tests/diagnostics_coverage.rs:1483
pub fn coverage_allowlist_codes(side: String) -> Set<String> { DIAGNOSTIC_COVERAGE_ALLOWLIST.iter().filter((row) -> row.1 == side).map((row) -> row.0.to_string()).collect() }
// Rust: tests/diagnostics_coverage.rs:1491
pub fn coverage_allowlist_errors() -> [String] {
    registered :: registered_codes()
    seen := Set<String>.new()
    errors := [String]{}
    for (code, side, owner) in DIAGNOSTIC_COVERAGE_ALLOWLIST {
        if !is_report_code(code) { errors.push("{code}: invalid diagnostic code") }
        if side != "left-only" && side != "right-only" { errors.push("{code}: side must be `left-only` or `right-only`") }
        if owner.trim().is_empty() { errors.push("{code}: coverage owner is empty") }
        if !registered.contains(code) { errors.push("{code}: coverage allowlist row is not registered") }
        if !seen.insert(code) { errors.push("{code}: duplicate coverage allowlist row") }
    }
    errors
}
// Rust: tests/diagnostics_coverage.rs:1520
pub fn coverage_left() -> Set<String> {
    emitted :: emitted_codes()
    exclusions :: all_exclusions()
    registered_codes().into_iter().filter((code) -> emitted.contains(code)).filter((code) -> Registry.diagnostic(code).is_some_and((row) -> row.status == Registry.DiagnosticStatus.Active)).filter((code) -> !exclusions.contains(code)).collect()
}
// Rust: tests/diagnostics_coverage.rs:1534
pub fn coverage_right() -> Set<String> {
    exclusions :: all_exclusions()
    rendered_report_codes().into_iter().filter((code) -> !exclusions.contains(code)).collect()
}
// Rust: tests/diagnostics_coverage.rs:1542
pub fn coverage_set_diff(left: &Set<String>, right: &Set<String>) -> (Set<String>, Set<String>) { (left.difference(right).cloned().collect(), right.difference(left).cloned().collect()) }
// Rust: tests/diagnostics_coverage.rs:1552
pub fn format_code_set(codes: &Set<String>) -> String {
    if codes.is_empty() { "(none)" }
    else { ordered := codes.iter().cloned().collect::<[String]>(); ordered.sort(); ordered.join("\n  ") }
}
// Rust: tests/diagnostics_coverage.rs:1713
pub fn collect_rs_paths(dir: &OSPath, out: &[OSPath]) -> {
    entries :: match fs.read_dir(dir) { Ok(entries) -> entries, Err(_) -> return }
    for entry in entries.flatten() {
        path :: entry.path()
        if path.is_dir() { collect_rs_paths(&path, out) }
        else if path.extension().and_then((ext) -> ext.to_str()) == Some("rs") { out.push(path) }
    }
    out.sort()
}
// Rust: tests/diagnostics_coverage.rs:1728
pub fn allowed_backend_voice_snapshot(path: &OSPath, text: String, needle: String) -> Bool {
    p :: path.to_string_lossy()
    if p.ends_with("ffi_bad_path.stderr") { return needle == ".rs:" || needle == "rustc rejected generated code" }
    if p.ends_with("os_target_unmatched_call.stderr") && text.contains("raw rustc") { return true }
    false
}
// Rust: tests/diagnostics_coverage.rs:1826
pub fn check_json_snapshots_for_edits(path: &OSPath, failures: &[String]) -> {
    entries :: match fs.read_dir(path) { Ok(entries) -> entries, Err(_) -> return }
    for entry in entries.flatten() {
        child :: entry.path()
        if child.is_dir() { check_json_snapshots_for_edits(&child, failures); continue }
        if child.extension().and_then((ext) -> ext.to_str()) != Some("txt") { continue }
        text :: match fs.read_to_string(&child) { Ok(text) -> text, Err(_) -> continue }
        for (line, raw) in text.lines().enumerate() {
            report :: match JSON.parse_json(raw) { Ok(report) -> report, Err(_) -> continue }
            schema :: match JSON.json_get(&report, "schema").and_then(JSON.json_str) { Some(schema) -> schema, None -> continue }
            if schema != "jet.report/v1" { continue }
            fix :: match JSON.json_get(&report, "fix").and_then(JSON.json_str) { Some(fix) -> fix, None -> continue }
            if !names_one_exact_replacement(fix) { continue }
            edits :: JSON.json_get(&report, "fix_edits")
            has_edit :: match edits { Some(DataTree.Array(items)) -> !items.is_empty(), _ -> false }
            if !has_edit { failures.push("{child.display()}:{line + 1} — {fix}"); continue }
            has_applicability :: match JSON.json_get(&report, "applicability") { Some(DataTree.Text(value)) | Some(DataTree.TypedText(value)) -> value == "safe" || value == "suggested", _ -> false }
            if !has_applicability { failures.push("{child.display()}:{line + 1} — machine edit has no closed applicability grade") }
            has_safety :: match edits {
                Some(DataTree.Array(items)) -> items.iter().all((edit) -> match JSON.json_get(edit, "safety") {
                    Some(DataTree.Text(value)) | Some(DataTree.TypedText(value)) -> [Report.FixSafety.Formatting, Report.FixSafety.BehaviorPreserving, Report.FixSafety.ApiChanging, Report.FixSafety.TargetChanging, Report.FixSafety.NeedsReview].iter().any((grade) -> grade.as_str() == value.as_str())
                    _ -> false
                })
                _ -> false
            }
            if !has_safety { failures.push("{child.display()}:{line + 1} — machine edit has no closed safety grade") }
        }
    }
}
// Rust: tests/diagnostics_coverage.rs:1910
pub fn names_one_exact_replacement(fix: String) -> Bool { (fix.starts_with("did you mean `") && fix.ends_with("`?")) || (fix.starts_with("replace `") && fix.contains("` with `")) || (fix.starts_with("declare it with `") && fix.contains(" := ")) }
