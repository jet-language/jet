// Rust: tests/compute_cuda.rs:21
#Test("cuda_f32_backend_runs_or_fails_closed_across_all_tiers") {
    source :: jet_foundation.Tests.Integration.ComputeCuda.CUDA_BACKEND_SOURCE
    (code, stdout, stderr) :: tir_support.run_default_multi("compute_cuda_backend", "main.jet", &[("main.jet", source)])
    assert_eq(code, 0, "default jet run failed: {stderr}")
    assert(stdout.contains("cuda:unavailable") || stdout.contains("cuda:available"), "CUDA branch did not execute: {stdout}")
    tir_support.assert_tiers_agree("compute_cuda_backend", source, stdout)
    dir :: common.unique_tmp("compute_cuda_full_parity")
    fs.create_dir_all(&dir).unwrap()
    file :: dir.join("main.jet")
    fs.write(&file, source).unwrap()
    for tier in ["O0", "O1", "O2", "Web"] {
        if common.run_entry_tier(&file.to_string_lossy(), tier, false) == {
            .Ran { exit_code, stdout: tier_stdout, stderr: tier_stderr } -> {
                assert_eq(exit_code, code, "{tier}/default exit drift: {tier_stderr}")
                assert_eq(tier_stdout, stdout, "{tier}/default output drift")
                assert_eq(tier_stderr, stderr, "{tier}/default diagnostics drift")
            }
            .Problems(diagnostics) -> panic("{tier} rejected CUDA fixture: {diagnostics}")
        }
    }
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/compute_cuda.rs:171
#Test("cuda_prelude_uses_global_thread_indices_and_real_driver_launches") {
    // Retained Rust source is a peer comparator, never called from Jet.
    prelude :: fs.read_to_string(OSPath(env.var("CARGO_MANIFEST_DIR").unwrap()).join("crates/jet-codegen/src/Prelude/CoreLib/Top/Compute.rs")).unwrap()
    assert(prelude.contains("cuLaunchKernel"))
    assert(prelude.contains("mod jet_compute_cuda"))
    cuda :: prelude.split("// JET_VETTED_UNSAFE_BEGIN: jet_compute_cuda\n").nth(1).and_then(fn(section) { section.split("// JET_VETTED_UNSAFE_END: jet_compute_cuda").next() }).expect("CUDA vetted module must be present")
    assert(cuda.contains("const RTLD_LOCAL: c_int = 0;"))
    assert(prelude.matches("mad.lo.u32 %r0, %r0, %ntid.x, %tid.x").count() >= 10, "per-element CUDA kernels must use global block-aware indices")
    for entry in ["jet_copy", "jet_binary", "jet_unary", "jet_matmul", "jet_sum", "jet_mse", "jet_mse_grad", "jet_mse_jvp", "jet_sgd", "jet_scale"] {
        needle :: ".visible .entry {entry}"
        assert(prelude.contains(needle), "missing CUDA kernel {entry}")
    }
    for operation in ["jet_compute_cuda::copy", "jet_compute_cuda::binary", "jet_compute_cuda::unary", "jet_compute_cuda::matmul", "jet_compute_cuda::sum", "jet_compute_cuda::mse", "jet_compute_cuda::mse_grad", "jet_compute_cuda::mse_jvp", "jet_compute_cuda::sgd", "jet_compute_cuda::scale", "jet_compute_cuda::stream_new", "jet_compute_cuda::stream_sync"] {
        assert(prelude.contains(operation), "missing CUDA dispatch {operation}")
    }
    assert(prelude.contains("check(unsafe { (api.init)(0) }, \"driver initialization\")"))
    assert(prelude.contains("no CPU fallback was selected"))
}
