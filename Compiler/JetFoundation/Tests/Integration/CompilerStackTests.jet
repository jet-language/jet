}
// Rust: tests/compiler_stack.rs:200
#Test("package_edition_survives_tir_eval_worker") {
    dir :: common.unique_tmp("jet_compiler_stack_package_edition")
    fs.create_dir_all(&dir).expect("create the fixture directory")
    fs.write(dir.join("package.jet"), PACKAGE_EDITION_MANIFEST).expect("write the package manifest")
    file :: dir.join("main.jet")
    fs.write(&file, PACKAGE_EDITION_PROGRAM).expect("write the fixture")
    path :: file.to_string_lossy().into_owned()
    for tier in ["O0", "O1", "O2", "Web"] {
        if common.run_entry_tier(&path, tier, false) == {
            .Ran { exit_code, stdout, stderr } -> {
                assert_eq(exit_code, 0, "{tier} must run: {stderr}")
                assert(stderr.is_empty(), "{tier} emitted diagnostics: {stderr}")
                assert_eq(stdout, "checked\nedition-sentinel\n", "{tier} lost the package edition")
            }
            .Problems(diagnostics) -> panic("{tier} rejected the edition fixture: {diagnostics}")
        }
    }
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/compiler_stack.rs:247
// Retired JIT backend boundary is exercised through each canonical backend.
#Test("the_jit_backend_owns_enough_stack_for_a_two_mib_embedder_thread") {
    dir :: common.unique_tmp("jet_compiler_stack_jit_entry")
    fs.create_dir_all(&dir).expect("create the fixture directory")
    file :: dir.join("main.jet")
    fs.write(&file, JIT_ENTRY_SOURCE).expect("write the fixture")
    path :: file.to_string_lossy().into_owned()
    for tier in ["O0", "O1", "O2", "Web"] {
        outcome :: thread.Builder.new().stack_size(2 * 1024 * 1024).spawn(fn() {
            bundle :: run_compiler_work(fn() {
                bundle := load_entry(&path).expect("the fixture should load")
                diagnostics :: check_bundle(&bundle, CompileMode.Run)
                assert(!diagnostics.iter().any(fn(d) { d.severity == Severity.Error }), "{diagnostics}")
                bundle
            })
            common.run_checked_bundle_tier(&bundle, tier, false, &common.development_policy())
        }).expect("spawn the embedder thread").join().expect("the backend must not overflow the embedder thread")
        if outcome == {
            .Ran { stdout, .. } -> assert_eq(stdout, "42\n")
            .Problems(diagnostics) -> panic("the fixture must run on {tier}: {diagnostics}")
        }
    }
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/compiler_stack.rs:291
#Test("the_compiler_boundary_never_nests_a_second_worker") {
    assert(!on_compiler_worker(), "a test thread is not a compiler worker")
    (worker, driver_inside_driver, backend_inside_driver) :: run_compiler_work(fn() {
        assert(on_compiler_worker(), "the flag must be set on the worker, not on the thread that spawned it")
        (thread.current().id(), run_compiler_work(fn() { thread.current().id() }), run_on_compiler_stack(fn() { thread.current().id() }))
    })
    assert_eq(worker, driver_inside_driver, "a nested driver entry must reuse the active worker")
    assert_eq(worker, backend_inside_driver, "a backend entry inside a driver entry must reuse the active worker")
    (worker, driver_inside_backend) :: run_on_compiler_stack(fn() {
        (thread.current().id(), run_compiler_work(fn() { thread.current().id() }))
    })
    assert_eq(worker, driver_inside_backend, "a driver entry inside a backend entry must reuse the active worker")
    assert_ne(worker, thread.current().id(), "an outermost entry must actually leave the caller's thread")
    assert(!on_compiler_worker(), "the flag must not leak back onto the caller")
}
