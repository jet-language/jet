    _ :: fs.remove_dir_all(dir)
    (code: out.status.code() ?? -1, stdout: String.from_utf8_lossy(&out.stdout).into_owned(), stderr: String.from_utf8_lossy(&out.stderr).into_owned())
}

// Rust: tests/tir_support/mod.rs:181
// Environment operands prevent the comptime evaluator from hiding runtime rules.
pub fn jit_run_with_env(name: String, src: String, vars: &[(key: String, value: String)]) -> (code: I32, stdout: String, stderr: String) {
    jit_run_with_env_args(name, src, vars, &[])
}

// Rust: tests/tir_support/mod.rs:186
pub fn jit_run_with_env_args(name: String, src: String, vars: &[(key: String, value: String)], program_args: &[String]) -> (code: I32, stdout: String, stderr: String) {
    scratch :: Scratch.new("jet_jit_run")
    dir :: &scratch.path
    jet_name :: "{name}.jet"
    jet_path :: dir.join(jet_name)
    fs.write(&jet_path, src).unwrap()
    write_test_package(dir, TIR_TEST_PACKAGE)
    command := Command.new(env.jet_bin())
    // Isolate AST-hash keyed caches so old artifacts cannot satisfy this run.
    &command.arg("run").args(["--tier", "O1"]).arg(&jet_path).current_dir(dir).env("JET_STORE_DIR", dir.join("cache")).env("JETPACK_ROOT", dir.join("jetpack"))
    loop var in vars -> &command.env(var.key, var.value)
    if !program_args.is_empty() {
        &command.arg("--")
        loop arg in program_args -> &command.arg(arg)
    }
    out :: &command.output().unwrap()
    _ :: fs.remove_dir_all(dir)
    (code: out.status.code() ?? -1, stdout: String.from_utf8_lossy(&out.stdout).into_owned(), stderr: String.from_utf8_lossy(&out.stderr).into_owned())
}

