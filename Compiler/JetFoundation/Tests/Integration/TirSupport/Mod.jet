// Rust: tests/tir_support/mod.rs:12
// Scratch programs exercise language/Core, with one explicit test authority.
pub TIR_TEST_PACKAGE :: `name: "tir_support"
version: "0.1.0"
authority: { holds: { allow: [Browser, DB, Env, Exec, FFI, FS, GPU, IO, Log, Mem.Alloc, Net, Rand, Secret, Time] } }
`

// All subprocess/fs/env operations below require the native substrate, not a
// Rust execution bridge. GATE #4494: Command, scratch cleanup and native paths.
// Rust: tests/tir_support/mod.rs:15
pub fn write_test_package(dir: &OSPath, source: String) {
    temp :: env.temp_dir()
    scratch :: test_scratch_root("scratch")
    assert(dir.parent() == Val(temp.as_path()) || dir.parent() == Val(scratch.as_path()), "TIR test package must live in its own scratch child: {dir.display()}")
    fs.write(dir.join("package.jet"), source).unwrap()
}

// Rust: tests/tir_support/mod.rs:25
pub fn assert_awaited_web_tier(name: String, source: String, expected: String) {
    scratch :: Scratch.new(name)
    write_test_package(&scratch.path, TIR_TEST_PACKAGE)
    entry :: scratch.path.join("run.jet")
    fs.write(&entry, source).unwrap()
    output :: compile_web_with_path(source, entry.to_str().unwrap()).unwrap_or_else((diagnostics) -> panic("{name} web pass fixture rejected: {diagnostics:#?}"))
    web :: output.web.expect("web artifacts for the same Jet pass")
    fs.write(scratch.path.join("package.json"), `{"type":"module"}` + "\n").unwrap()
    fs.write(scratch.path.join("app.js"), web.js_app).unwrap()
    fs.write(scratch.path.join("jet_dom_runtime.js"), web.dom_runtime).unwrap()
    // Rust remains an independent Wasm compilation oracle here.
    fs.write(scratch.path.join("app_wasm.rs"), web.wasm_rust).unwrap()
    wasm :: Command.new("rustc").current_dir(&scratch.path).args(["--edition", "2021", "--target", "wasm32-unknown-unknown", "--crate-type", "cdylib", "-O", "app_wasm.rs", "-o", "app.wasm"]).output().expect("web proof requires rustc with wasm32 target")
    assert(wasm.status.success(), "{name} web Wasm build: {String.from_utf8_lossy(&wasm.stderr)}")
    fs.write(scratch.path.join("run.mjs"), `const { jet_main } = await import('./app.js');
await jet_main();
`).unwrap()
    node :: Command.new("node").current_dir(&scratch.path).arg("run.mjs").output().expect("web proof requires Node; absence is not a pass")
    assert(node.status.success(), "{name} awaited web entry: {String.from_utf8_lossy(&node.stderr)}")
    assert_eq(String.from_utf8_lossy(&node.stdout), expected, "{name} awaited web stdout")
}

// Rust: tests/tir_support/mod.rs:49
pub fn have_rustc() -> Bool {
    present :: Command.new("rustc").arg("--version").output().is_ok()
    if !present && env.var("JET_REQUIRE_RUSTC").as_deref() == .Ok("1") {
        panic("JET_REQUIRE_RUSTC=1 but rustc not found on PATH — refusing to silently skip I2 (rustc-must-accept) coverage. Fix the CI environment; do not unset JET_REQUIRE_RUSTC to paper over this.")
    }
    present
}

