// Rust: tests/tir_support/mod.rs:115
// Rust callable name retained for packet callers; execution is retained native O1.
pub fn jit_run(name: String, src: String) -> (code: I32, stdout: String, stderr: String) {
    jit_run_with_package(name, src, &[], None)
}

// Rust: tests/tir_support/mod.rs:119
fn jit_run_with_package(name: String, src: String, vars: &[(key: String, value: String)], package_source: String?) -> (code: I32, stdout: String, stderr: String) {
    scratch :: Scratch.new("jet_jit_run")
    dir :: &scratch.path
    jet_name :: "{name}.jet"
    jet_path :: dir.join(jet_name)
    fs.write(&jet_path, src).unwrap()
    write_test_package(dir, package_source ?? TIR_TEST_PACKAGE)
    command := Command.new(env.jet_bin())
    &command.arg("run").args(["--tier", "O1"]).arg(&jet_path).current_dir(dir).env("JET_STORE_DIR", dir.join("cache")).env("JETPACK_ROOT", dir.join("jetpack"))
    loop var in vars -> &command.env(var.key, var.value)
    out :: &command.output().unwrap()
    stderr :: normalize_workspace_root_paths(String.from_utf8_lossy(&out.stderr), dir)
    _ :: fs.remove_dir_all(dir)
    (code: out.status.code() ?? -1, stdout: String.from_utf8_lossy(&out.stdout).into_owned(), stderr: stderr)
}

