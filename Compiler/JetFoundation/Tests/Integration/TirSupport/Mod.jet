// Rust: tests/tir_support/mod.rs:433
pub fn assert_example_cli_tiers_agree_with(stem: String, check_stdout: fn(String)) {
    assert_example_cli_tiers_agree_with_package(stem, None, check_stdout)
}

// Rust: tests/tir_support/mod.rs:442
pub fn assert_example_cli_tiers_agree_with_package(stem: String, package_source: String?, check_stdout: fn(String)) {
    root :: OSPath.from(env.manifest_dir())
    stem_path :: root.join("Examples/features").join(stem)
    source :: if stem_path.is_dir() -> stem_path.join("run.jet") else -> stem_path.with_extension("jet")
    assert(source.is_file(), "missing executable allocator example: {source.display()}")
    scratch := None as Scratch?
    run_source := source.clone()
    if package_source == .Val(package_source) {
        local :: Scratch.new("jet_example_policy")
        run_source = local.join(source.file_name().expect("example source has a filename").to_str().expect("example source filename is UTF-8"))
        fs.copy(&source, &run_source).unwrap()
        write_test_package(&local.path, package_source)
        scratch = Val(^local)
    }
    run_cwd :: scratch.as_ref().map_or(root.as_path(), (scratch) -> scratch.path.as_path())
    baseline := None as (mode: String, code: I32, stdout: String)?
    loop mode in ["O2", "O1", "O0"] {
        cache_scratch :: Scratch.new("jet_example_{mode}")
        cache :: &cache_scratch.path
        output :: Command.new(env.jet_bin()).args(["run", "--tier", mode]).arg(&run_source).current_dir(run_cwd).env("JET_STORE_DIR", cache.join("cache")).env("JETPACK_ROOT", cache.join("jetpack")).env("NO_COLOR", "1").env("JETPACK_ENV", "1").output().unwrap()
        result :: (code: output.status.code() ?? -1, stdout: String.from_utf8_lossy(&output.stdout).into_owned(), stderr: String.from_utf8_lossy(&output.stderr).into_owned())
        assert_eq(result.code, 0, "{mode} run failed for {stem}:\n{result.stderr}")
        check_stdout(result.stdout)
        if baseline == {
            .Val(baseline) -> {
                assert_eq(result.code, baseline.code, "{mode} exit code disagreed with {baseline.mode} for {stem}")
                assert_eq(result.stdout, baseline.stdout, "{mode} output disagreed with {baseline.mode} for {stem}")
            }
            .None -> baseline = Val((mode: mode, code: result.code, stdout: result.stdout))
        }
    }
}

// Rust: tests/tir_support/mod.rs:532
fn normalize_workspace_root_paths(stderr: String, root: &OSPath) -> String {
    shown :: root.display().to_string()
    stderr.replace("{shown}/", "").replace("{shown}\\", "")
}

// Rust: tests/tir_support/mod.rs:541
pub fn assert_example_cli_error_tiers_agree(stem: String, expected_exit_code: I32, expected_stderr: String) {
    root :: OSPath.from(env.manifest_dir())
    source :: root.join("Examples/features").join("{stem}.jet")
    assert(source.is_file(), "missing executable error example: {source.display()}")
    relative :: "Examples/features/{stem}.jet"
    modes :: [(mode: "O0-debug", tier: "O0"), (mode: "O2", tier: "O2"), (mode: "O1", tier: "O1"), (mode: "O0", tier: "O0")]
    baseline := None as (mode: String, result: (code: I32, stdout: String, stderr: String))?
    loop mode in modes {
        cache_scratch :: Scratch.new("jet_example_error_{mode.mode}")
        cache :: &cache_scratch.path
        command := Command.new(env.jet_bin())
        &command.args(["run", "--tier", mode.tier])
        if mode.mode == "O0-debug" -> &command.arg("--profile=debug")
        &command.arg(relative).current_dir(&root).env("JET_STORE_DIR", cache.join("cache")).env("JETPACK_ROOT", cache.join("jetpack")).env("NO_COLOR", "1")
        output :: &command.output().unwrap()
        stderr :: String.from_utf8_lossy(&output.stderr).into_owned()
        result :: (code: output.status.code() ?? -1, stdout: String.from_utf8_lossy(&output.stdout).into_owned(), stderr: normalize_workspace_root_paths(stderr, &root))
        assert_eq(result.code, expected_exit_code, "{mode.mode} exit code for {stem}")
        assert(result.stdout.is_empty(), "{mode.mode} stdout for {stem}: {result.stdout:?}")
        assert_eq(result.stderr, expected_stderr, "{mode.mode} stderr disagreed with the .err.out oracle for {stem}")
        if baseline == {
            .Val(baseline) -> assert_eq(result, baseline.result, "{mode.mode} result disagreed with {baseline.mode} for {stem}")
            .None -> baseline = Val((mode: mode.mode, result: result))
        }
    }
}

// Rust: tests/tir_support/mod.rs:607
pub fn build_and_run_full_with_cfg(prefix: String, name: String, src: String, rustc_cfg: String) -> (code: I32, stdout: String, stderr: String) {
    build_and_run_full_inner(prefix, name, src, Val(rustc_cfg))
}

// Rust: tests/tir_support/mod.rs:616
// Generated Rust compilation is the independent I2 peer oracle.
fn build_and_run_full_inner(prefix: String, name: String, src: String, rustc_cfg: String?) -> (code: I32, stdout: String, stderr: String) {
    scratch :: Scratch.new(prefix)
    dir :: &scratch.path
    write_test_package(dir, TIR_TEST_PACKAGE)
    jet_path :: dir.join("{name}.jet")
    fs.write(&jet_path, src).unwrap()
    shown :: jet_path.to_string_lossy().into_owned()
    out :: compile_with_path(src, shown).unwrap_or_else((diags) -> panic("front end rejected:\n{render_diagnostics(shown, src, &diags)}"))
    // Compile-time lints are separate from runtime stderr parity.
    rs :: dir.join("{name}.rs")
    bin :: dir.join(name)
    fs.write(&rs, out.rust).unwrap()
    rustc_cmd := Command.new("rustc")
    &rustc_cmd.args(["--edition", "2021", "--crate-name"])
    &rustc_cmd.arg(Syntax.sanitize_crate_name(rs.file_stem().and_then((name) -> name.to_str()) ?? "out"))
    &rustc_cmd.args([rs.to_str().unwrap(), "-o", bin.to_str().unwrap()])
    if rustc_cfg == .Val(cfg) -> &rustc_cmd.args(["--cfg", cfg])
    if out.ffi == .Val(link) {
        &rustc_cmd.arg("--extern").arg("{link.crate_name}={link.rlib_path.display()}")
        loop deps_dir in link.dependency_dirs().filter((dir) -> dir.is_dir()) {
            &rustc_cmd.arg("-L").arg("dependency={deps_dir.display()}")
        }
    }
    rustc :: &rustc_cmd.output().unwrap()
    assert(rustc.status.success(), "rustc rejected generated code (I2 violation):\n{String.from_utf8_lossy(&rustc.stderr)}")
    run :: Command.new(&bin).output().unwrap()
    run_stderr :: String.from_utf8_lossy(&run.stderr)
    stderr :: normalize_workspace_root_paths(run_stderr, dir)
    (code: run.status.code() ?? 0, stdout: String.from_utf8_lossy(&run.stdout).into_owned(), stderr: stderr)
}

// Rust: tests/tir_support/mod.rs:678
pub fn build_and_run_multi(name: String, entry: String, files: &[(rel: String, src: String)]) -> (code: I32, stdout: String) {
    scratch :: Scratch.new("jet_tir_multi_{name}")
    dir :: &scratch.path
    write_test_package(dir, TIR_TEST_PACKAGE)
    loop file in files {
        path :: dir.join(file.rel)
        if path.parent() == .Val(parent) -> fs.create_dir_all(parent).unwrap()
        fs.write(&path, file.src).unwrap()
    }
    entry_path :: dir.join(entry)
    shown :: entry_path.to_string_lossy().into_owned()
    entry_src :: fs.read_to_string(&entry_path).unwrap()
    out :: compile_with_path(entry_src, shown).unwrap_or_else((diags) -> panic("front end rejected:\n{render_diagnostics(shown, entry_src, &diags)}"))
    rs :: dir.join("{name}.rs")
    bin :: dir.join(name)
    fs.write(&rs, out.rust).unwrap()
    rustc :: Command.new("rustc").args(["--edition", "2021", "--crate-name"]).arg(Syntax.sanitize_crate_name(rs.file_stem().and_then((name) -> name.to_str()) ?? "out")).args([rs.to_str().unwrap(), "-o", bin.to_str().unwrap()]).output().unwrap()
    assert(rustc.status.success(), "rustc rejected generated code (I2 violation):\n{String.from_utf8_lossy(&rustc.stderr)}")
    run :: Command.new(&bin).output().unwrap()
    (code: run.status.code() ?? 0, stdout: String.from_utf8_lossy(&run.stdout).into_owned())
}

// Rust: tests/tir_support/mod.rs:725
pub fn build_release_and_run_multi(name: String, entry: String, files: &[(rel: String, src: String)]) -> (code: I32, stdout: String, stderr: String) {
    scratch :: Scratch.new("jet_release_multi_{name}")
    dir :: &scratch.path
    write_test_package(dir, TIR_TEST_PACKAGE)
    loop file in files {
        path :: dir.join(file.rel)
        if path.parent() == .Val(parent) -> fs.create_dir_all(parent).unwrap()
        fs.write(&path, file.src).unwrap()
    }
    build :: Command.new(env.jet_bin()).args(["build", "--tier", "O2", entry]).current_dir(dir).env("JET_STORE_DIR", dir.join("cache")).env("NO_COLOR", "1").output().unwrap()
    if !build.status.success() -> return (code: build.status.code() ?? 1, stdout: "", stderr: String.from_utf8_lossy(&build.stderr).into_owned())
    artifact :: dir.join(".jet/build").join(OSPath.new(entry).file_stem().expect("release entry has a file stem"))
    run :: Command.new(artifact).current_dir(dir).output().unwrap()
    (code: run.status.code() ?? 1, stdout: String.from_utf8_lossy(&run.stdout).into_owned(), stderr: String.from_utf8_lossy(&run.stderr).into_owned())
}

// Rust: tests/tir_support/mod.rs:769
pub fn assert_release_tiers_agree(name: String, src: String, expected_stdout: String) {
    files :: [(rel: "main.jet", src: src)]
    runs :: [build_release_and_run_multi(name, "main.jet", &files), run_default_multi(name, "main.jet", &files), run_interpret_multi(name, "main.jet", &files)]
    baseline :: &runs[0]
    loop (mode, result) in ["O2", "O1", "O0"].iter().zip(runs.iter()) {
        assert_eq(result.code, 0, "{mode} failed:\n{result.stderr}")
        assert_eq(result.stdout, expected_stdout, "{mode} output disagreed")
        assert_eq(result.code, baseline.code, "{mode} exit code disagreed")
        assert_eq(result.stdout, baseline.stdout, "{mode} stdout disagreed")
    }
}

// Rust: tests/tir_support/mod.rs:790
pub fn assert_bare_release_tiers_agree(name: String, src: String, expected_stdout: String) {
    scratch :: Scratch.new("jet_bare_tiers_{name}")
    dir :: &scratch.path
    write_test_package(dir, "name: \"tir_bare_tiers\"\nversion: \"0.1.0\"\n")
    path :: dir.join("main.jet")
    fs.write(&path, src).unwrap()
    shown :: path.to_string_lossy().into_owned()
    baseline := None as (mode: String, result: (code: I32, stdout: String, stderr: String))?
    loop mode in ["O2", "O1", "O0"] {
        output :: Command.new(env.jet_bin()).args(["run", "--tier", mode, shown]).current_dir(dir).env("JET_STORE_DIR", dir.join("cache-{mode}")).env("JETPACK_ROOT", dir.join("jetpack-{mode}")).env("NO_COLOR", "1").output().unwrap()
        result :: (code: output.status.code() ?? -1, stdout: String.from_utf8_lossy(&output.stdout).into_owned(), stderr: String.from_utf8_lossy(&output.stderr).into_owned())
        assert_eq(result.code, 0, "{mode} failed:\n{result.stderr}")
        assert_eq(result.stdout, expected_stdout, "{mode} output disagreed")
        if baseline == {
            .Val(baseline) -> assert_eq(result, baseline.result, "{mode} disagreed with {baseline.mode}")
            .None -> baseline = Val((mode: mode, result: result))
        }
    }
    _ :: fs.remove_dir_all(dir)
}

// Rust: tests/tir_support/mod.rs:837
pub fn assert_release_tier_error_with_application_policy(name: String, src: String, package_source: String, expected_code: String) {
    scratch :: Scratch.new("jet_policy_tiers_{name}")
    dir :: &scratch.path
    path :: dir.join("main.jet")
    fs.write(&path, src).unwrap()
    write_test_package(dir, package_source)
    shown :: path.to_string_lossy().into_owned()
    baseline := None as (mode: String, result: (code: I32, stdout: String, stderr: String))?
    loop mode in ["O2", "O1", "O0"] {
        output :: Command.new(env.jet_bin()).args(["run", "--tier", mode, shown]).current_dir(dir).env("JET_STORE_DIR", dir.join("cache-{mode}")).env("JETPACK_ROOT", dir.join("jetpack-{mode}")).env("NO_COLOR", "1").output().unwrap()
        result :: (code: output.status.code() ?? -1, stdout: String.from_utf8_lossy(&output.stdout).into_owned(), stderr: String.from_utf8_lossy(&output.stderr).into_owned())
        assert_ne(result.code, 0, "{mode} unexpectedly succeeded")
        assert(result.stdout.is_empty(), "{mode} wrote stdout: {result.stdout:?}")
        assert(result.stderr.contains(expected_code), "{mode} did not report {expected_code}:\n{result.stderr}")
        if baseline == {
            .Val(baseline) -> assert_eq(result, baseline.result, "{mode} disagreed with {baseline.mode}")
            .None -> baseline = Val((mode: mode, result: result))
        }
    }
    _ :: fs.remove_dir_all(dir)
}

// Rust: tests/tir_support/mod.rs:893
pub fn assert_release_error_tiers_agree(name: String, src: String, expected_message: String) {
    files :: [(rel: "main.jet", src: src)]
    runs :: [build_release_and_run_multi(name, "main.jet", &files), run_default_multi(name, "main.jet", &files), run_interpret_multi(name, "main.jet", &files)]
    expected_prefix :: "Stop [E3010]: `{expected_message}`"
    baseline_code :: runs[0].code
    baseline_prefix := None as String?
    loop (mode, result) in ["O2", "O1", "O0"].iter().zip(runs.iter()) {
        assert_ne(result.code, 0, "{mode} unexpectedly succeeded")
        assert_eq(result.code, baseline_code, "{mode} exit code disagreed")
        assert(result.stdout.is_empty(), "{mode} wrote stdout: {result.stdout:?}")
        prefix :: result.stderr.lines().find((line) -> line.contains("Stop [E3010]:")).and_then((line) -> line.split(" — ").next()).unwrap_or_else(() -> panic("{mode} did not report E3010:\n{result.stderr}"))
        assert_eq(prefix, expected_prefix, "{mode} message disagreed")
        if baseline_prefix == {
            .Val(baseline_prefix) -> assert_eq(prefix, baseline_prefix, "{mode} detail disagreed")
            .None -> baseline_prefix = Val(prefix)
        }
    }
}

// Rust: tests/tir_support/mod.rs:926
pub fn run_default_multi(name: String, entry: String, files: &[(rel: String, src: String)]) -> (code: I32, stdout: String, stderr: String) {
    scratch :: Scratch.new("jet_jit_multi_{name}")
    dir :: &scratch.path
    loop file in files {
        path :: dir.join(file.rel)
        if path.parent() == .Val(parent) -> fs.create_dir_all(parent).unwrap()
        fs.write(&path, file.src).unwrap()
    }
    write_test_package(dir, TIR_TEST_PACKAGE)
    run :: Command.new(env.jet_bin()).args(["run", entry, "--tier", "O1", "--trace-tiers"]).current_dir(dir).env("NO_COLOR", "1").env("JET_STORE_DIR", dir.join("cache")).env("JETPACK_ROOT", dir.join("jetpack")).output().unwrap()
    result :: (code: run.status.code() ?? 1, stdout: String.from_utf8_lossy(&run.stdout).into_owned(), stderr: String.from_utf8_lossy(&run.stderr).into_owned())
    _ :: fs.remove_dir_all(dir)
    result
}

