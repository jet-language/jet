// Rust: tests/tir_support/mod.rs:269
// Frozen Component snapshot belongs to the artifact stem, not its directory.
pub fn run_plugin_tier(name: String, src: String, tier: String, artifact: &OSPath, api_snapshot: String) -> (code: I32, stdout: String, stderr: String) {
    dir :: unique_tmp("jet_plugin_tier_{name}_{tier}")
    fs.create_dir_all(&dir).unwrap()
    write_test_package(&dir, TIR_TEST_PACKAGE)
    api_dir :: dir.join(".jet/cache/api")
    fs.create_dir_all(&api_dir).unwrap()
    stem :: artifact.file_stem().and_then((stem) -> stem.to_str()).unwrap_or_else(() -> panic("plugin artifact has no UTF-8 stem: {artifact.display()}"))
    fs.write(api_dir.join("plugin__{stem}.api"), api_snapshot).unwrap()
    path :: dir.join("{name}.jet")
    fs.write(&path, src).unwrap()
    command := Command.new(env.jet_bin())
    &command.arg("run")
    if tier == { "O0" | "O1" | "O2" -> &command.args(["--tier", tier]) else -> panic("unknown plugin tier `{tier}`") }
    &command.arg(&path).current_dir(&dir).env("JET_STORE_DIR", dir.join("cache-{tier}")).env("JETPACK_ROOT", dir.join("jetpack-{tier}")).env("JETPACK_ENV", "1").env("NO_COLOR", "1")
    output :: &command.output().unwrap()
    result :: (code: output.status.code() ?? -1, stdout: String.from_utf8_lossy(&output.stdout).into_owned(), stderr: normalize_workspace_root_paths(String.from_utf8_lossy(&output.stderr), &dir))
    _ :: fs.remove_dir_all(&dir)
    result
}

// Rust: tests/tir_support/mod.rs:320
pub fn assert_tiers_agree_with_plugin(name: String, src: String, expected_stdout: String, artifact: &OSPath, api_snapshot: String) {
    runs :: [
        (tier: "O1", result: run_plugin_tier(name, src, "O1", artifact, api_snapshot)),
        (tier: "O0", result: run_plugin_tier(name, src, "O0", artifact, api_snapshot)),
        (tier: "O2", result: run_plugin_tier(name, src, "O2", artifact, api_snapshot)),
    ]
    baseline :: runs.first().expect("plugin tier list is non-empty")
    assert_eq(baseline.result.code, 0, "{baseline.tier} plugin run failed:\n{baseline.result.stderr}")
    assert_eq(baseline.result.stdout, expected_stdout, "{baseline.tier} plugin output")
    loop run in runs.iter().skip(1) {
        assert_eq(run.result.code, baseline.result.code, "{run.tier} plugin exit code disagreed")
        assert_eq(run.result.stdout, baseline.result.stdout, "{run.tier} plugin output disagreed")
        assert_eq(run.result.stderr, baseline.result.stderr, "{run.tier} plugin stderr disagreed")
    }
}

// Rust: tests/tir_support/mod.rs:358
pub fn assert_tiers_agree_with_application_policy(name: String, src: String, expected_stdout: String, package_source: String) {
    assert_tiers_agree_with_package(name, src, expected_stdout, Val(package_source))
}

// Rust: tests/tir_support/mod.rs:367
fn assert_tiers_agree_with_package(name: String, src: String, expected_stdout: String, package_source: String?) {
    native :: jit_run_with_package(name, src, &[], package_source)
    assert_eq(native.code, 0, "`jet run --tier O1` failed:\n{native.stderr}")
    assert_eq(native.stdout, expected_stdout, "`jet run --tier O1` disagreed:\n{native.stderr}")
    o0 :: interpreter_run_with_package(name, src, package_source)
    assert_eq(o0.code, native.code, "O0 and O1 exit codes disagree:\nO0 stderr: {o0.stderr}\nO1 stderr: {native.stderr}")
    assert_eq(o0.stdout, native.stdout, "O0 and O1 stdout disagree:\nO0 stderr: {o0.stderr}\nO1 stderr: {native.stderr}")
    assert_eq(o0.stderr, native.stderr, "O0 and O1 stderr disagree")
    scratch :: Scratch.new("jet_tir_O2")
    path :: scratch.path.join("{name}.jet")
    fs.write(&path, src).unwrap()
    write_test_package(&scratch.path, package_source ?? TIR_TEST_PACKAGE)
    output :: Command.new(env.jet_bin()).args(["run", "--tier", "O2"]).arg(&path).current_dir(&scratch.path).env("JET_STORE_DIR", scratch.path.join("cache")).env("JETPACK_ROOT", scratch.path.join("jetpack")).output().unwrap()
    o2 :: (code: output.status.code() ?? -1, stdout: String.from_utf8_lossy(&output.stdout).into_owned(), stderr: normalize_workspace_root_paths(String.from_utf8_lossy(&output.stderr), &scratch.path))
    assert_eq(o2.code, native.code, "O2 and O1 exit codes disagree:\n{o2.stderr}")
    assert_eq(o2.stdout, native.stdout, "O2 and O1 disagree — one tier re-encoded the rule (I9)")
    assert_eq(o2.stderr, native.stderr, "O2 and O1 stderr disagree — one tier re-encoded the rule (I9)")
    assert_eq(o2.code, o0.code, "O2 and O0 exit codes disagree")
    assert_eq(o2.stdout, o0.stdout, "O2 and O0 stdout disagree")
    assert_eq(o2.stderr, o0.stderr, "O2 and O0 stderr disagree")
    // Generated Rust is additionally an independent oracle, never a Jet tier.
    if have_rustc() {
        peer :: build_and_run_full("jet_tir_test", name, src)
        assert_eq(peer.code, native.code, "Rust peer and O1 exit codes disagree:\n{peer.stderr}")
        assert_eq(peer.stdout, native.stdout, "Rust peer and O1 disagree — one tier re-encoded the rule (I9)")
        assert_eq(peer.stderr, native.stderr, "Rust peer and O1 stderr disagree — one tier re-encoded the rule (I9)")
        assert_eq(peer.code, o0.code, "Rust peer and O0 exit codes disagree")
        assert_eq(peer.stdout, o0.stdout, "Rust peer and O0 stdout disagree")
        assert_eq(peer.stderr, o0.stderr, "Rust peer and O0 stderr disagree")
    }
}

