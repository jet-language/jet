// Rust: tests/tir_support/mod.rs:66
pub fn compile(name: String, src: String) -> String {
    scratch :: Scratch.new("jet_tir_compile")
    dir :: &scratch.path
    write_test_package(dir, TIR_TEST_PACKAGE)
    jet_path :: dir.join("{name}.jet")
    fs.write(&jet_path, src).unwrap()
    shown :: jet_path.to_string_lossy().into_owned()
    compile_with_path(src, shown).unwrap_or_else((diags) -> panic("front end rejected:\n{render_diagnostics(shown, src, &diags)}")).rust
}

// Rust: tests/tir_support/mod.rs:85
// A pathless source still requires a real bundle path for package/module context.
pub fn compile_source(name: String, src: String) -> CompileOutput [Diagnostic]! {
    scratch :: Scratch.new("jet_tir_compile_source")
    dir :: &scratch.path
    write_test_package(dir, TIR_TEST_PACKAGE)
    filename :: if name.ends_with(".jet") -> name else -> "{name}.jet"
    path :: dir.join(filename)
    fs.write(&path, src).unwrap()
    shown :: path.to_string_lossy().into_owned()
    result :: compile_with_path(src, shown)
    _ :: fs.remove_dir_all(dir)
    result
}

