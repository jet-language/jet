        entry :: root.join("main.jet")
        source :: """
use __MODULE__ as api
fn build(b: BuildContext) -> BuildPlan {
    #Impure("hostile __NAME__ probe") { __CALL__ }
    return b.plan()
}
fn run() {}
""".replace("__MODULE__", module).replace("__NAME__", name).replace("__CALL__", call)
        write(&entry, &source)
        diagnostics :: jet.Driver.evaluate_build_query(entry.to_str().unwrap(), BuildQueryExpression.Build).expect_err("inspection must reject ambient comptime authority")
        assert(diagnostics.iter().any(fn(diagnostic) { diagnostic.code == "E3411" }), "{name} escaped inspection authority: {diagnostics:?}")
    }
}
// Rust: tests/build_entry.rs:2379
#Test("graph_overlay_uses_unsaved_text_and_canonical_cli_facts") {
    root :: project("query-overlay")
    entry :: root.join("main.jet")
    write(&entry, "fn build(b: BuildContext) -> BuildPlan { app :: b.add_executable(\"disk\", [\"main.jet\"], [])\n return b.plan(app) }\nfn run() {}\n")
    unsaved :: "fn build(b: BuildContext) -> BuildPlan { app :: b.add_executable(\"unsaved\", [\"main.jet\"], [])\n return b.plan(app) }\nfn run() {}\n"
    disk :: jet.Driver.query_build_plan(entry.to_str().unwrap()).unwrap().unwrap()
    overlay :: jet.Driver.query_build_plan_with_overlay(entry.to_str().unwrap(), unsaved).unwrap().unwrap()
    assert_eq(disk.targets()[0].name, "disk")
    assert_eq(overlay.targets()[0].name, "unsaved")
    json :: jet.Driver.build_plan_json(&overlay, .None)
    assert(json.contains("\"files\"") && json.contains("\"toolchains\"") && json.contains("\"generated\""))
    editor_json :: jet.LSP.build_graph_json(entry.to_str().unwrap(), unsaved).unwrap().expect("overlay has build graph")
    assert_eq(editor_json, json, "editor and CLI must serialize one BuildPlan graph")
    queried :: jet.Driver.evaluate_build_query(entry.to_str().unwrap(), BuildQueryExpression.Build).unwrap().unwrap()
    assert_eq(jet.Driver.build_plan_json(&queried, .None), jet.Driver.build_plan_json(&disk, .None), "fixed `build` expression must evaluate typed graph facts")
}
