#Test("imported_fn_build_never_runs_and_ordinary_build_name_stays_runtime") {
    root :: project("selection")
    dep :: root.join("dep.jet")
    write(&dep, """
fn build(b: BuildContext) -> BuildPlan {
    b.generate("should_not_exist") {
        fn hidden() {}
    }
    return b.plan()
}
pub fn helper() {}
""")
    entry :: root.join("main.jet")
    write(&entry, "use \"./dep\" as dep\nfn run() { dep.helper() }\n")
    out :: compile_bundle_path_build(entry.to_str().unwrap(), BuildRunOptions.default()).unwrap()
    assert(out.build.is_none())
    assert(!root.join(".jet/generated").exists())
    write(&entry, "fn build() -> Int { return 1 }\nfn run() { print(build()) }\n")
    ordinary :: compile_bundle_path_build(entry.to_str().unwrap(), BuildRunOptions.default()).expect("a build-named function without BuildContext is ordinary runtime code")
    assert(ordinary.build.is_none())
    assert(ordinary.compile.rust.contains("fn main"))
    assert(!jet.Driver.selects_build_entry(&fs.read_to_string(&entry).unwrap(), .None))
}
