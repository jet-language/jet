#Test("bare_build_plan_entry_uses_implicit_default_error_route") {
    source :: """
fn build(b: BuildContext) -> BuildPlan {
    app :: b.add_library("app", ["main.jet"], [])
    return b.plan(app)
}
fn run() {}
"""
    (tokens, lexer_diagnostics) :: jet.Lexer.lex(source)
    assert(lexer_diagnostics.is_empty(), "{lexer_diagnostics:?}")
    program :: jet.Parser.parse(&tokens).expect("bare BuildPlan entry parses")
    build :: program.items.iter().find_map(fn(item) {
        if item == {
            .Func(function) -> if function.name == "build" -> .Some(function) else -> .None
            else -> .None
        }
    }).expect("build entry is present")
    assert(if build.return_type.as_ref() == { .Some(.Named(name)) -> name == "BuildPlan"; else -> false })
    assert(jet.Sema.build_entry_signature_is_valid(build))
    assert(build.failure_contract().is_default())
    root :: project("bare-build-plan")
    entry :: root.join("main.jet")
    write(&entry, source)
    output :: compile_bundle_path_build(entry.to_str().unwrap(), opts()).expect("bare BuildPlan entry should run through jet build")
    assert_eq(output.build.expect("programmable build should produce a result").plan.targets()[0].name, "app")
}
