// Rust: tests/build_entry.rs:2098
#Test("concurrent_jet_builds_share_store_lock_and_run") {
    left :: Scratch.new("concurrent-build-left")
    right :: Scratch.new("concurrent-build-right")
    source :: "\nfn run() {\n    print(\"shared store\")\n}\n"
    loop scratch in [&left, &right] {
        write(&scratch.join("package.jet"), "name: \"concurrent-build\"\nversion: \"0.1.0\"\nauthority: { holds: { allow: [IO] } }\n")
        write(&scratch.join("main.jet"), source)
    }
    store :: left.join("store")
    holder :: jet_store.Store.open(jet_store.StoreConfig.new(store.clone()).with_reserve_bytes(0)).expect("open shared store lock holder")
    owner :: jet_store.ProcessIdentity.current()
    lock_path :: holder.root().join("locks/store.lock")
    fs.write(&lock_path, "jet.store.v1|lock|{owner.pid()}|{owner.start()}\n").expect("hold shared store lock")
    spawn_build :: fn(scratch: &Scratch) {
        Command.new(env!("CARGO_BIN_EXE_jet")).args(["build", "main.jet"]).current_dir(&scratch.path)
            .env("JET_STORE_DIR", &store).env("JET_STORE_RESERVE_BYTES", "0").env("JET_RUN_CACHE_DIR", scratch.join("run-cache"))
            .env("NO_COLOR", "1").spawn().expect("spawn concurrent build")
    }
    left_child :: spawn_build(&left)
    right_child :: spawn_build(&right)
    thread.sleep(Duration.from_millis(3000))
    fs.remove_file(&lock_path).expect("release shared store lock")
    left_build :: left_child.wait_with_output().expect("wait for left concurrent build")
    right_build :: right_child.wait_with_output().expect("wait for right concurrent build")
    loop (name, output) in [("left", left_build), ("right", right_build)] {
        assert(output.status.success(), "{name} concurrent build failed:\nstdout: {String.from_utf8_lossy(&output.stdout)}\nstderr: {String.from_utf8_lossy(&output.stderr)}")
    }
    loop (name, scratch) in [("left", &left), ("right", &right)] {
        run :: Command.new(scratch.join(".jet/build/main")).current_dir(&scratch.path).output().expect("run concurrent build binary")
        assert(run.status.success(), "{name} binary failed:\nstdout: {String.from_utf8_lossy(&run.stdout)}\nstderr: {String.from_utf8_lossy(&run.stderr)}")
        actual := String.from_utf8_lossy(&run.stdout).trim() // #4303
        assert_eq(actual, "shared store")
    }
}
