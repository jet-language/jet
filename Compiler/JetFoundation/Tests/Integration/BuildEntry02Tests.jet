// Rust: tests/build_entry.rs:2217
#Test("graph_query_is_static_json_and_lsp_check_sees_bad_signature") {
    root :: project("query")
    entry :: root.join("main.jet")
    write(&entry, """
fn build(b: BuildContext) -> BuildPlan {
    action :: b.action("never-run", [], ["out"], ["sh", "-c", "exit 99"], [])
    app :: b.add_executable("app", ["main.jet"], [action])
    return b.plan(app)
}
fn run() {}
""")
    output :: Command.new(env!("CARGO_BIN_EXE_jet")).args(["inspect", "graph"]).arg(&entry).arg("--json").output().unwrap()
    assert(output.status.success(), "{String.from_utf8_lossy(&output.stderr)}")
    json :: String.from_utf8_lossy(&output.stdout)
    assert(json.contains("\"name\":\"app\""))
    assert(json.contains("\"name\":\"never-run\""))
    assert(!root.join("out").exists(), "graph query must never execute actions")
    lsp_plan :: jet.Driver.query_build_plan(entry.to_str().unwrap()).unwrap().unwrap()
    assert_eq(lsp_plan.graph().targets[0].name, "app")
    assert_eq(lsp_plan.graph().actions[0].name, "never-run")
    write(&entry, "fn build() -> Int { return 1 }\nfn run() {}\n")
    (diags, _) :: jet.Driver.check_file(entry.to_str().unwrap(), .None, true)
    assert(diags.iter().all(fn(diag) { diag.code != "E3501" }), "ordinary `fn build` must not receive the build-entry diagnostic: {diags:?}")
}
