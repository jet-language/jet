#Test("malformed_generated_body_is_a_jet_diagnostic_before_codegen") {
    root :: project("bad-generated")
    entry :: root.join("main.jet")
    write(&entry, """
fn build(b: BuildContext) -> BuildPlan {
    b.generate("broken") {
        fn nope(
    }
        app :: b.add_executable("app", ["main.jet", ".jet/generated/main/broken.jet"], [])
    return b.plan(app)
}
fn run() {}
""")
    errors :: compile_bundle_path_build(entry.to_str().unwrap(), BuildRunOptions.default()).unwrap_err()
    assert(!errors.is_empty())
    assert(errors.iter().all(fn(d) { d.code != "ICE" }))
    assert(errors.iter().any(fn(d) { d.code == "E0003" }))
    assert(!root.join(".jet/generated/main/broken.jet").exists())
    assert(!root.join(".jet/lock").exists())
}
