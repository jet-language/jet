// Rust: tests/build_entry.rs:3474
#Test("build_context_fetch_rejects_private_networks_before_connecting") {
    root :: project("build-context-fetch-loopback")
    listener :: TcpListener.bind(("127.0.0.1", 0)).unwrap()
    listener.set_nonblocking(true).unwrap()
    port :: listener.local_addr().unwrap().port()
    server :: thread.spawn(fn() {
        deadline :: Instant.now() + Duration.from_secs(1)
        loop {
            if listener.accept() == {
                .Ok(_) -> return true
                .Err(error) -> {
                    if error.kind() != std.io.ErrorKind.WouldBlock -> return false
                    if Instant.now() >= deadline -> return false
                    thread.yield_now()
                }
            }
        }
    })
    entry :: root.join("main.jet")
    write(&entry, """
fn build(b: BuildContext) -> BuildPlan {
    _ :: b.fetch("http://127.0.0.1:__PORT__/secret", "__HASH__")
    app :: b.add_executable("app", ["main.jet"], [])
    return b.plan(app)
}
fn run() {}
""".replace("__PORT__", port.to_string()).replace("__HASH__", "0".repeat(64)))
    errors :: compile_bundle_path_build(entry.to_str().unwrap(), BuildRunOptions.default()).expect_err("BuildContext.fetch must reject loopback before connecting")
    assert(errors.iter().any(fn(diagnostic) { diagnostic.code == "E3414" }), "unexpected diagnostics: {errors:#?}")
    assert(!server.join().unwrap(), "BuildContext.fetch contacted a private destination")
    _ :: fs.remove_dir_all(root)
}
