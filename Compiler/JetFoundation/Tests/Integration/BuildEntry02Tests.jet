// Rust: tests/build_entry.rs:1803
#Test("workspace_cli_grant_does_not_authorize_member_builds") {
    root :: project("workspace-grant-boundary")
    member :: root.join("packages/member")
    fs.create_dir_all(&member).unwrap()
    write(&root.join("workspace.jet"), "module workspace { members: [\"./packages/member\"] }\nfn build(b: BuildContext) -> BuildPlan { return b.plan() }\n")
    write(&member.join("package.jet"), "name: \"member\"\nversion: \"0.1.0\"\n")
    write(&member.join("run.jet"), """
fn build(b: BuildContext) -[Exec]> BuildPlan {
    #Impure("member must use its own grant") {
        action :: b.action("stamp", [], ["stamp"], ["sh", "-c", "printf bad > stamp"], ["Exec"])
        app :: b.add_executable("app", ["run.jet"], [action])
        return b.plan(app)
    }
    return b.plan()
}
fn run() {}
""")
    errors :: jet.compile_programmable_build_opts(root.join("workspace.jet").to_str().unwrap(), &["exec"], false, jet.Policy.GateSet.allow(jet.Policy.PolicyKey.Impure), false, false, false, .None).unwrap_err()
    assert(errors.iter().any(fn(diagnostic) { diagnostic.code == "E3504" }), "member must not inherit the workspace CLI grant: {errors:#?}")
    assert(!member.join("stamp").exists())
}
// Rust: tests/build_entry.rs:1850
#Test("cache_restore_rebuilds_after_missing_or_invalid_store_entries") {
    loop (case, damage) in [("missing", "remove"), ("invalid", "corrupt"), ("invalid-record", "corrupt-record")] {
        root :: project("restore-{case}")
        entry :: root.join("main.jet")
        write(&entry, """
fn build(b: BuildContext) -[Exec, FS]> BuildPlan {
    #Impure("write declared cached output") {
        emit :: b.action("emit", [], ["artifact"], ["sh", "-c", "printf fresh > artifact"], ["Exec", "FS"])
        app :: b.add_executable("app", ["main.jet"], [emit])
        return b.plan(app)
    }
    return b.plan()
}
fn run() {}
""")
        _ :: compile_bundle_path_build(entry.to_str().unwrap(), opts()).unwrap()
        store :: jet_store.Store.from_env().expect("open configured artifact store")
        action_entries :: fs.read_dir(store.root().join("ac")).unwrap().filter_map(fn(result) { result.ok() }).map(fn(entry) { entry.path() }).filter(fn(path) { path.is_file() }).collect()
        assert(!action_entries.is_empty(), "first build should publish an action record")
        if damage == "corrupt-record" {
            loop path in action_entries -> fs.write(path, "not an action record").unwrap()
        } else {
            blob_entries :: fs.read_dir(store.root().join("cas")).unwrap().filter_map(fn(result) { result.ok() }).map(fn(entry) { entry.path() }).filter(fn(path) { path.is_file() }).collect()
            assert(!blob_entries.is_empty(), "first build should publish CAS blobs")
            loop path in blob_entries {
                if damage == "remove" -> fs.remove_file(path).unwrap()
                else -> fs.write(path, "corrupt").unwrap()
            }
        }
        rebuilt :: compile_bundle_path_build(entry.to_str().unwrap(), opts()).unwrap()
        build :: rebuilt.build.expect("rebuild should expose execution")
        assert(build.execution.events.iter().any(fn(event) {
            if event == { .Finished{outcome: .Succeeded{exit_code: 0}, ..} -> true; else -> false }
        }), "{case} store damage must trigger a successful rebuild")
        assert(!build.execution.events.iter().any(fn(event) {
            if event == { .Finished{outcome: .RestoredFromCache, ..} -> true; else -> false }
        }), "{case} store damage must not restore the damaged action")
    }
}
