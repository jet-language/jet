#Test("sandbox_refuses_output_parent_symlink_escape") {
    if selected_family() != "unix" -> return
    root :: project("symlink-output")
    outside :: project("symlink-outside")
    std.os.unix.fs.symlink(&outside, root.join("redirect")).unwrap()
    entry :: root.join("main.jet")
    write(&entry, """
