        ("filesystem", "core.files", "attempt :: api.write(\"blocked\", \"owned\")"),
        ("environment", "core.sys", "api.set(\"JET_QUERY_BLOCKED\", \"owned\")"),
        ("exec-process", "core.process", "attempt :: api.run([\"sh\", \"-c\", \"exit 97\"])"),
        ("network", "core.net", "attempt :: api.tcp_listen(\"127.0.0.1:0\")"),
    ]
    loop (name, module, call) in cases {
