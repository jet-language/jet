// Rust: tests/build_entry.rs:3869
#Test("criterion9_programmable_build_cli_human_and_json_reports_match") {
    root :: project("build-error-report-parity")
    entry :: root.join("main.jet")
    write(&entry, &duplicate_target_build_source("BuildPlan", ""))
    run :: fn(json: Bool) {
        command := Command.new(env!("CARGO_BIN_EXE_jet"))
        command.current_dir(&root).env("NO_COLOR", "1").args(["build", "main.jet"])
        if json -> command.arg("--json")
        command.output().expect("jet build report command")
    }
    human :: run(false)
    assert(!human.status.success(), "human build failure unexpectedly passed")
    human_stderr :: String.from_utf8_lossy(&human.stderr)
    assert(human_stderr.contains("Error [E3502]: build plan is invalid: target name `app` is registered twice"), "human report did not preserve the BuildError message:\n{human_stderr}")
    assert(human_stderr.contains("More: jet-lang.dev/e/E3502"), "human report did not preserve the diagnostic URL:\n{human_stderr}")
    json :: run(true)
    assert(!json.status.success(), "JSON build failure unexpectedly passed")
    json_stderr :: String.from_utf8_lossy(&json.stderr)
    json_text := json_stderr.trim() // #4303
    report :: parse(json_text).expect("jet build --json emits one report object")
    assert_eq(json_get(&report, "code").and_then(json_str), .Some("E3502"))
    what :: json_get(&report, "what").and_then(json_str).expect("JSON report has what")
    assert(human_stderr.contains("Error [E3502]: {what}"))
    build_error :: json_get(&report, "build_error").expect("JSON report has structured build error")
    assert(if build_error == { .Object(_) -> true; else -> false }, "build_error is an object")
    assert_eq(json_get(build_error, "typed_identity").and_then(json_str), .Some("BuildError::DuplicateTargetName"))
    details :: json_get(build_error, "details").expect("structured details stay nested in the jet.err object")
    assert(if details == { .Object(_) -> true; else -> false }, "structured details are an object")
    assert_eq(json_get(details, "variant").and_then(json_str), .Some("DuplicateTargetName"))
    fields :: json_get(details, "fields").expect("structured fields stay in the JSON report")
    assert(if fields == { .Object(_) -> true; else -> false }, "structured fields are an object")
    assert_eq(json_get(fields, "value").and_then(json_str), .Some("app"))
}
// Rust: tests/build_entry.rs:3954
// I2/I3: frontend projection excludes build-only entries for every runtime engine.
#Test("build_entry_is_absent_from_the_runtime_program") {
    root :: project("build-entry-runtime-program")
    entry :: root.join("run.jet")
    write(&entry, BUILD_ENTRY_PROGRAM)
    shown :: entry.to_string_lossy().into_owned()
    compiled :: jet.compile_with_path(BUILD_ENTRY_PROGRAM, &shown).expect("a program with a build entry must reach codegen without an ICE")
    emitted_build :: "fn {jet_foundation.Names.mangle(\"build\")}("
    assert(!compiled.rust.contains(&emitted_build), "the build entry leaked into the runtime program (`{emitted_build}`)")
    assert(compiled.rust.contains("runtime program"), "the runtime entry must still be emitted")
    bundle := jet.Loader.load_entry(&shown).expect("build-entry bundle loads")
    diagnostics :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run)
    assert(!diagnostics.iter().any(fn(diagnostic) { diagnostic.severity == jet.Diagnostics.Severity.Error }), "{diagnostics:#?}")
    assert(!bundle.modules.iter().any(fn(module) { module.items.iter().any(fn(item) {
        if item == { .Func(func) -> func.name == "build"; else -> false }
    }) }), "sema left the build entry in the checked runtime program")
    assert(bundle.modules[bundle.entry].items.iter().any(fn(item) {
        if item == { .Func(func) -> func.name == "run"; else -> false }
    }), "the runtime entry must survive the projection")
    _ :: fs.remove_dir_all(&root)
}
