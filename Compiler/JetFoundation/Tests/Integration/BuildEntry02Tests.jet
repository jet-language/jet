// Rust: tests/build_entry.rs:4097
// Source scan: the only compiler-API exemption must stay paired with unconditional projection.
#Test("the_compiler_api_exemption_stays_paired_with_the_drivers_projection") {
    root :: OSPath.from(env!("CARGO_MANIFEST_DIR"))
    pipeline :: fs.read_to_string(root.join("crates/jet-sema/src/Sema/Bundle/Pipeline/Completion.rs")).unwrap()
    driver :: fs.read_to_string(root.join("crates/jet-driver/src/Driver/mod.rs")).unwrap()
    sema_entry :: fs.read_to_string(root.join("crates/jet-sema/src/Sema/Bundle.rs")).unwrap()
    code :: fn(text: String) {
        text.lines().map(fn(line) { line.trim() }).filter(fn(line) { !line.is_empty() && !line.starts_with("//") }).map(fn(line) { line.to_string() }).collect::<[String]>()
    }
    exemptions :: code(&pipeline).into_iter().filter(fn(line) { line.contains("allow_compiler_api") && line.starts_with("if ") }).collect()
    assert_eq(exemptions, ["if !allow_compiler_api && mode != CompileMode::Check {"],
        "the build-entry projection may be skipped for exactly two reasons — the build session's own check, and `jet check`/LSP, which emits no code. A third condition, or a second site, hands codegen a build entry again (Tower card 2008, I2/I3).")
    guarded_line :: code(&pipeline).windows(2).find(fn(pair) { pair[0].contains("if !allow_compiler_api") }).map(fn(pair) { pair[1].clone() }).expect("the exemption guards a statement")
    assert(guarded_line.contains("strip_build_only_entries(bundle)"), "the `allow_compiler_api` conditional must guard the projection itself; it now guards `{guarded_line}`")
    callers :: code(&driver).iter().filter(fn(line) { line.contains("check_bundle_with_effect_facts_for_build(") }).count()
        + code(&sema_entry).iter().filter(fn(line) { line.contains("check_bundle_with_effect_facts_for_build(") }).filter(fn(line) { !line.contains("pub fn ") }).count()
    assert_eq(callers, 1, "`check_bundle_with_effect_facts_for_build` is the only check that leaves a build entry in the bundle. Every caller must remove it afterwards, so a second caller must be paired by hand and this assertion updated deliberately.")
    unconditional :: driver.lines().any(fn(line) {
        line.trim() == "crate::Sema::strip_build_only_entries(&mut bundle);" && line.len() - line.trim_start().len() == 4
    })
    assert(unconditional, "the driver must project build-only entries out unconditionally. Moving that call under `if build_run.is_some()` or `if options.execute` restores the original defect for the inspect-only and package-check paths, where `emit_func` raises an internal compiler error instead of any diagnostic (Tower card 2008).")
}
