    fs.create_dir_all(app).unwrap()
    fs.write(dependency.join("package.jet"), "name: \"audit\"\nversion: \"0.1.0\"\n").unwrap()
    fs.write(dependency.join("audit.jet"), "effect Log.Audit\npub fn record() -[Log.Audit]> {}\n").unwrap()
    fs.write(app.join("package.jet"), "name: \"app\"\nversion: \"0.1.0\"\ndeps: { audit: ../audit }\n").unwrap()
    entry :: app.join("main.jet")
    fs.write(entry, "use audit\nfn run() -> { audit.record() }\n").unwrap()
    checked :: Command.new(std.env.compile_time_var("CARGO_BIN_EXE_jet")).args(["check", "main.jet"]).current_dir(app).env("NO_COLOR", "1").output().unwrap() // GATE #4494
    assert(checked.status.success(), "{String.from_utf8_lossy(checked.stderr)}")
    fs.write(entry, "use audit\nfn typo() -[Log.Aduut]> {}\nfn run() -> { audit.record() }\n").unwrap()
    checked_typo :: Command.new(std.env.compile_time_var("CARGO_BIN_EXE_jet")).args(["check", "main.jet"]).current_dir(app).env("NO_COLOR", "1").output().unwrap()
    stderr :: String.from_utf8_lossy(checked_typo.stderr)
    assert(!checked_typo.status.success(), "{stderr}")
    assert(stderr.contains("E0750"), "{stderr}")
    assert(stderr.contains("Log.Audit"), "{stderr}")
}
