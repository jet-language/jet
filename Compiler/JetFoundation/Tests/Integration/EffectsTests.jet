// Rust: tests/effects.rs:17
#Test("callbacks_entry_effects_are_only_io") {
    entry :: OSPath.from(std.env.compile_time_var("CARGO_MANIFEST_DIR")).join("Examples/features/basics/callbacks.jet")
    (diagnostics, bundle, facts) :: Driver.check_file_with_effect_facts(entry.to_str().unwrap(), .None, false)
    assert(!diagnostics.iter().any((diagnostic) -> diagnostic.severity == Severity.Error), "{diagnostics:#?}")
    assert_eq(EffectBudget.summary_line_for_program(bundle.expect("callbacks bundle"), facts.summaries, "run"), "effects: IO")
}
// Rust: tests/effects.rs:39
#Test("selected_output_effects_follow_the_selected_callable") {
    entry :: OSPath.from(std.env.compile_time_var("CARGO_MANIFEST_DIR")).join("Examples/features/tooling/output_callable.jet")
    (diagnostics, maybe_bundle, facts) :: Driver.check_file_with_effect_facts_for_output(entry.to_str().unwrap(), "app", "dev", [:])
    assert(!diagnostics.iter().any((diagnostic) -> diagnostic.severity == Severity.Error), "{diagnostics:#?}")
    bundle :: maybe_bundle.expect("selected output bundle")
    selected :: bundle.modules.iter().flat_map((module) -> module.items).find_map((item) -> if item == {
        .Const(constant) -> constant.resolved_output.as_ref().filter((output) -> output.selected)
        _ -> .None
    })
    assert_eq(EffectBudget.summary_line_for_program(bundle, facts.summaries, "run"), "effects: IO", "selected={selected:#?}\nsummaries={facts.summaries:#?}")
}
// Rust: tests/effects.rs:79
#Test("sqlite_style_fail_nth_effect_loop_is_deterministic") {
    root :: common.unique_tmp("jet_test_fault_loop")
    fs.create_dir_all(root).unwrap()
    entry :: root.join("main.jet")
    fs.write(entry, """
use core.files as fs

#Test(faults: [FS.Write]) fn sqlite_style_fail_nth_effect_loop_is_deterministic() -> {
    fs.write("fault-loop.txt", "x") ?? return
    values := List.try_with_capacity(1) ?? return
    &values.try_push(1) ?? return
    assert(values.len() == 1)
    assert(true)
}

fn run() -> {}
""").unwrap()
    (first, _) :: jet.compile_tests_with_path("", entry.to_str().unwrap()).expect("fault-configured test should compile")
    (second, _) :: jet.compile_tests_with_path("", entry.to_str().unwrap()).expect("fault-configured test should compile twice")
    assert_eq(first, second, "fault schedules must be deterministic")
    assert(first.contains("jet_fault_test_loop(&[\"FS.Write\"]"), "test harness must carry the sema-canonical selector:\n{first}")
    assert(first.contains("while fail_nth <= max_counts[selector_index]"), "test harness must enumerate each reachable fail-nth call:\n{first}")
    assert(first.contains("jet_list_try_with_capacity") && first.contains("jet_list_try_push"), "the SQLite-style body must use the fallible allocation rail:\n{first}")
}
// Rust: tests/effects.rs:120
#Test("cross_module_same_name_effects_keep_qualified_rows") {
    root :: common.unique_tmp("jet_effect_collision")
    fs.create_dir_all(root).unwrap()
    fs.write(root.join("left.jet"), "fn helper() -> { print(\"left\") }\npub fn same() -> { helper() }\n").unwrap()
    fs.write(root.join("right.jet"), "fn helper() -> {}\npub fn same() -> { helper() }\n").unwrap()
    entry :: root.join("main.jet")
    fs.write(entry, "use \"./left\" as left\nuse \"./right\" as right\nfn clean() -[]> { right.same() }\nfn run() -> {\n    clean()\n    left.same()\n}\n").unwrap()
    (diagnostics, _, facts) :: Driver.check_file_with_effect_facts(entry.to_str().unwrap(), .None, false)
    assert(!diagnostics.iter().any((diagnostic) -> diagnostic.severity == Severity.Error), "{diagnostics:#?}")
    assert(facts.solved["left::same"].contains("IO"))
    assert(facts.solved["right::same"].is_empty())
    assert(!facts.solved.contains_key("same"))
}
