    assert(facts.summaries["clean"].edges.contains("main::Shape::area"), "{facts.summaries["clean"].edges:#?}")
    assert(facts.solved["Shape::area"].contains("IO"), "{facts.solved:#?}")
    assert(facts.solved["clean"].contains("IO"), "{facts.solved:#?}")
    assert(diagnostics.iter().any((diagnostic) -> diagnostic.code == "E3401"))
}
// Rust: tests/effects.rs:183
#Test("strided_source_loop_projects_exact_arena_audit_multiplicity") {
    check :: (tag: String, source: String) -> {
        root :: common.unique_tmp(tag)
        fs.create_dir_all(root).unwrap()
        entry :: root.join("main.jet")
        fs.write(entry, source).unwrap()
        (diagnostics, _, facts) :: Driver.check_file_with_effect_facts(entry.to_str().unwrap(), .None, false)
        (diagnostics, facts)
    }
    source :: (bound: U64, stride: String) -> format("""use core.mem as mem

fn reserve() -> {{
    arena :: mem.Arena.new(capacity: 4)
    close(^arena)
}}

fn run() -[!Mem.Alloc(above: {bound})]> {{
    loop item in [1, 2, 3, 4, 5], {stride} {{
        print(item)
        reserve()
    }}
}}
""")
    (diagnostics, facts) :: check("jet_stride_arena_exact", source(12, "2"))
    assert(!diagnostics.iter().any((diagnostic) -> diagnostic.severity == Severity.Error), "five items at stride two execute three 4-byte calls:\n{diagnostics:#?}")
    run_12 :: ("main::run", MemoryFact.MemAllocBounded(12))
    assert_eq(facts.memory_projections.get(run_12), .Some(MemoryProjection.Proven)) // GATE #4499 composite map key
    assert(facts.solved["run"].contains("IO"))
    (tight_diagnostics, tight_facts) :: check("jet_stride_arena_tight", source(11, "2"))
    assert(tight_diagnostics.iter().any((diagnostic) -> diagnostic.code == "E0921"))
    assert(if tight_facts.memory_projections.get(("main::run", MemoryFact.MemAllocBounded(11))) == { .Some(.Violated { .. }) -> true; _ -> false })
    dynamic :: source(12, "stride").replace("fn run() -[!Mem.Alloc(above: 12)]> {", "fn run() -[!Mem.Alloc(above: 12)]> {\n    stride := 2")
    (dynamic_diagnostics, dynamic_facts) :: check("jet_stride_arena_dynamic", dynamic)
    assert(dynamic_diagnostics.iter().any((diagnostic) -> diagnostic.code == "E0921"))
    assert(if dynamic_facts.memory_projections.get(run_12) == { .Some(.OpenWorld { reason, .. }) -> reason.contains("loop iteration count"); _ -> false })
    assert(dynamic_facts.solved["run"].contains("IO"))
}
// Rust: tests/effects.rs:261
#Test("authority_region_erases_to_plain_block") {
    src :: "\nfn run() -> {\n    #FX(IO) {\n        print(\"inside\")\n    }\n    print(\"outside\")\n}\n"
    rust :: jet.compile(src).expect("compiles").rust
    assert(!rust.contains("AuthorityScope"), "generated Rust must not mention AuthorityScope:\n{rust}")
    assert(!rust.contains("#("), "generated Rust must carry no effect annotation:\n{rust}")
    assert(rust.contains("inside") && rust.contains("outside"), "region body must survive:\n{rust}")
}
// Rust: tests/effects.rs:287
#Test("erased_scope_restores_refinement_and_effect_facts") {
    src :: """
use core.files as fs

fn need(value: Int) -> {
    print(value)
}

fn erased_refinement(value: Int?) -> {
    #Off {
        if value == .None {
            return
        }
        need(value)
    }
    need(value)
}

fn erased_effect() -[IO]> {
    #Off {
        #FX(authority: FS) {
            _text :: fs.read("missing") ?? ""
        }
    }
    print("erased")
}

fn active_effect() -[IO]> {
    #FX(authority: FS) {
        _text :: fs.read("missing") ?? ""
    }
    print("active")
}

fn run() -> {}
"""
    diagnostics :: codes(src)
    assert_eq(diagnostics.iter().filter((code) -> code == "E0310").count(), 1, "the erased optional refinement must not escape: {diagnostics:?}")
    assert_eq(diagnostics.iter().filter((code) -> code == "E0740").count(), 1, "the erased effect grant must not reach the caller, while the active control remains: {diagnostics:?}")
    assert_eq(diagnostics.len(), 2, "unexpected diagnostics: {diagnostics:?}")
}
// Rust: tests/effects.rs:341
#Test("erased_authority_delegations_do_not_enter_effect_facts") {
    source :: """
use core.process as process

fn delegation_witness() -> {
    #FX(authority: Exec, IO, Time.Wait) {
        #Off {
            _erased :: process.run(["echo", "erased"], authority)
        }
        _active :: process.run(["echo", "active"], authority)
    }
}

fn run() -> {
    delegation_witness()
}
"""
    root :: common.unique_tmp("jet_erased_authority_delegations")
    fs.create_dir_all(root).unwrap()
    entry :: root.join("main.jet")
    fs.write(entry, source).unwrap()
    (diagnostics, _, facts) :: Driver.check_file_with_effect_facts(entry.to_str().unwrap(), .None, false)
    assert(diagnostics.is_empty(), "authority delegation witness must compile: {diagnostics:#?}")
    delegations :: facts.summaries["delegation_witness"].authority_delegations
    assert_eq(delegations.len(), 1, "only the active process.run may publish an authority delegation: {delegations:#?}")
    assert_eq(delegations[0].operation, "run")
}
