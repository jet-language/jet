// Rust: tests/effects.rs:391
#Test("active_panic_remains_a_tier_stop") {
    source :: "\nfn run() -> {\n    panic(\"active\")\n}\n"
    tiers := [("jit", tir_support.jit_run("active_panic", source)), ("interpreter", tir_support.interpreter_run("active_panic", source))]
    if tir_support.have_rustc() { &tiers.push(("release", tir_support.build_and_run_full("active_panic", "active_panic", source))) }
    loop (tier, (code, stdout, stderr)) in tiers {
        assert_eq(code, 70, "{tier} active panic exit code")
        assert(stdout.is_empty(), "{tier} active panic stdout: {stdout:?}")
        assert(stderr.contains("panic: active"), "{tier} lost active panic diagnostic: {stderr:?}")
    }
}
// Rust: tests/effects.rs:423
#Test("effect_annotations_are_erased") {
    annotated :: """
trait Shape { fn area(self) -[]> Int }
struct Square { side: Int }
impl Square.Shape { fn area(self) -> Int { return self.side * self.side } }
fn sq(n: Int) -[]> Int { return n * n }
fn load(p: String) -[IO]> { print(p) }
fn invoke(n: Int) -[IO]> { load("{sq(n)}") }
fn run() -> {
    s :: Square{ side: 3 }
    print("{s.area()}")
    invoke(2)
}
"""
    plain :: """
trait Shape { fn area(self) -> Int }
struct Square { side: Int }
impl Square.Shape { fn area(self) -> Int { return self.side * self.side } }
fn sq(n: Int) -> Int { return n * n }
fn load(p: String) -> { print(p) }
fn invoke(n: Int) -> { load("{sq(n)}") }
fn run() -> {
    s :: Square{ side: 3 }
    print("{s.area()}")
    invoke(2)
}
"""
    a :: jet.compile(annotated).expect("annotated compiles").rust
    b :: jet.compile(plain).expect("plain compiles").rust
    assert_eq(a, b, "effect annotations must leave no trace in generated Rust (I3)")
}
// Rust: tests/effects.rs:461
#Test("panic_prohibition_is_e0749_with_three_exits") {
    src :: "\nfn parse_port(raw: String) -[!Panic]> Int {\n    return Int.parse(raw) ?? panic(\"bad port\")\n}\nfn run() -> { print(parse_port(\"8080\")) }\n"
    diagnostics :: jet.compile(src).expect_err("a denied panic must fail sema")
    diagnostic :: diagnostics.iter().find((diagnostic) -> diagnostic.code == "E0749").expect("expected E0749")
    assert(diagnostic.what.contains("parse_port"), "{diagnostic:#?}")
    assert(diagnostic.why.contains("parse_port"), "{diagnostic:#?}")
    assert(diagnostic.fix.contains("fallible result"), "{diagnostic:#?}")
    assert(diagnostic.fix.contains("facts"), "{diagnostic:#?}")
    assert(diagnostic.fix.contains("#Pre"), "{diagnostic:#?}")
}
// Rust: tests/effects.rs:486
#Test("panic_effect_propagates_transitively") {
    src :: "\nfn leaf() -> { panic(\"bad input\") }\nfn middle() -> { leaf() }\nfn top() -[!Panic]> { middle() }\nfn run() -> { top() }\n"
    root :: common.unique_tmp("jet_panic_effect")
    fs.create_dir_all(root).unwrap()
    entry :: root.join("main.jet")
    fs.write(entry, src).unwrap()
    (diagnostics, _, facts) :: Driver.check_file_with_effect_facts(entry.to_str().unwrap(), .None, false)
    assert(diagnostics.iter().any((diagnostic) -> diagnostic.code == "E0749"))
    assert(facts.solved["leaf"].contains("Panic"))
    assert(facts.solved["middle"].contains("Panic"))
    assert(facts.solved["top"].contains("Panic"))
    assert(facts.reachability.nodes_with("panic", "panic").contains("main::top"))
}
