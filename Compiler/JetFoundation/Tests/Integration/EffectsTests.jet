    diagnostic :: diagnostics.iter().find((diagnostic) -> diagnostic.code == "E3401").expect("pure access should produce E3401")
    assert_eq(diagnostic.denial_kind.as_deref(), .Some("pure"))
    assert_eq(diagnostic.call_chain, ["load", "fs.read"])
}
