    path :: dir.join("main.jet")
    src :: "\nextern rust \"std\" {\n    #Undo(undo_mutate) fn mutate(left: Int, right: Int) -> Int = \"std::cmp::max\"\n}\nfn undo_mutate(left: Int, right: Int) -> { print(left + right) }\nfn run() -> {\n    #Transact(tx) {\n        mutate(1, 2)\n    }\n}\n"
    fs.write(path, src).unwrap()
    shown :: path.to_string_lossy().into_owned()
    outcome :: dev_iteration(shown, false, true)
    if outcome == {
        .Problems(diagnostics) -> assert(diagnostics.iter().any((diagnostic) -> diagnostic.code == "E0956"), "native FFI must use the canonical unsupported diagnostic: {diagnostics:?}")
        other -> panic("interpreter ran native FFI: {other:?}")
    }
}
