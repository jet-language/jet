#Test("dynamic_trait_calls_use_the_declared_dispatch_row") {
    source :: "\ntrait Shape { fn area(self) -[IO]> Int }\nfn clean(shape: Shape) -[]> Int { return shape.area() }\nfn run() -> {}\n"
    root :: common.unique_tmp("jet_trait_dispatch_effect")
