// Rust: tests/inline_package.rs:22
#Test("inline_package_keeps_pub_package_visibility") {
    stamp :: time.SystemTime.now().duration_since(time.UNIX_EPOCH).unwrap().as_nanos()
    root :: env.temp_dir().join("jet-inline-package-{process.id()}-{stamp}")
    fs.create_dir_all(&root).unwrap()
    source :: "package {\n    name: \"inline-visibility\"\n}\n\npub(package) fn secret() -> String {\n    return \"ok\"\n}\n\nfn run() {\n    print(secret())\n}\n"
    path :: root.join("run.jet")
    fs.write(&path, source).unwrap()
    diagnostics :: jet.check_with_path(&path.to_string_lossy())
    assert(diagnostics.iter().all(fn(diagnostic) -> diagnostic.severity != jet.Diagnostics.Severity.Error), "inline Package must preserve pub(package): {diagnostics:?}")
    _ :: fs.remove_dir_all(root)
}
// Rust: tests/inline_package.rs:53
#Test("inline_package_conflicts_with_manifest_for_every_entry") {
    stamp :: time.SystemTime.now().duration_since(time.UNIX_EPOCH).unwrap().as_nanos()
    root :: env.temp_dir().join("jet-inline-package-conflict-{process.id()}-{stamp}")
    fs.create_dir_all(&root).unwrap()
    fs.write(root.join("run.jet"), "package { name: \"inline\" }\nfn run() {}\n").unwrap()
    fs.write(root.join("other.jet"), "fn run() {}\n").unwrap()
    fs.write(root.join("package.jet"), "name: \"manifest\"\n").unwrap()
    assert_eq(jet.Loader.find_package_root_checked(&root).unwrap(), Some(root.clone()))
    load_diagnostics :: jet.Loader.load_entry(root.join("other.jet").to_str().unwrap()).expect_err("an inline Package and package.jet must not coexist")
    assert(load_diagnostics.iter().any(fn(diagnostic) -> diagnostic.code == "E1363"), "{load_diagnostics:#?}")
    facts_diagnostics :: jet.Loader.package_facts_for_entry(&root.join("other.jet")).expect_err("facts lookup must reject the same conflicting carriers")
    assert(facts_diagnostics.iter().any(fn(diagnostic) -> diagnostic.code == "E1363"), "{facts_diagnostics:#?}")
    _ :: fs.remove_dir_all(root)
}
