// Rust: tests/inline_deps.rs:79
#Test("script_inline_dep_resolves") {
    if !jet_bin().is_file() || !have_cargo() { eprintln("note: skipping script_inline_dep_resolves (need the jet binary + cargo)"); return }
    dir :: tmp_dir("resolves")
    write_textkit_fixture(&dir)
    write(&dir, "stats.jet", "use textkit#1.4.2\n\nfn run() {\n    print(textkit.shout(\"hi\"))\n}\n")
    out :: jet_cmd(["run", "stats.jet"], &dir)
    assert(out.status.success(), "jet run should resolve the inline dep and run\nstdout: {String.from_utf8_lossy(&out.stdout)}\nstderr: {String.from_utf8_lossy(&out.stderr)}")
    assert(String.from_utf8_lossy(&out.stdout).contains("hi"), "expected the script's output, got: {String.from_utf8_lossy(&out.stdout)}")
}
// Rust: tests/inline_deps.rs:107
#Test("script_inline_dep_unresolved_is_e1253") {
    if !jet_bin().is_file() { return }
    dir :: tmp_dir("unresolved")
    write(&dir, "stats.jet", "use ghostpkg#1.0.0\n\nfn run() {\n    print(\"never\")\n}\n")
    out :: jet_cmd(["run", "stats.jet"], &dir)
    assert(!out.status.success())
    stderr :: String.from_utf8_lossy(&out.stderr)
    assert(stderr.contains("E1253"), "expected E1253 in stderr, got: {stderr}")
}
// Rust: tests/inline_deps.rs:128
#Test("script_inline_dep_unpinned_is_l0203") {
