// Rust: tests/inline_package.rs:566
#Test("inline_package_extraction_matches_extracted_entry_across_build_and_run_tiers") {
    source :: include_str("Examples/features/packages/inline_package.jet")
    expected :: include_str("Examples/features/expected/packages/inline_package.out")
    block :: jet.Package.extract_inline_package(source).unwrap().expect("the shipped example must carry an inline Package")
    body :: block.body(source).to_owned()
    extracted_program :: source[block.span.end..].to_owned()
    assert(extracted_program.contains("fn run"))
    base :: inline_scratch("tier-extraction")
    inline_root :: base.join("inline")
    extracted_root :: base.join("extracted")
    fs.create_dir_all(&inline_root).unwrap()
    fs.create_dir_all(&extracted_root).unwrap()
    fs.write(inline_root.join("run.jet"), source).unwrap()
    fs.write(extracted_root.join("package.jet"), &body).unwrap()
    fs.write(extracted_root.join("run.jet"), &extracted_program).unwrap()
    for root in [&inline_root, &extracted_root] {
        (code, _stdout, stderr) :: run_inline_cli(root, ["build", "run.jet"])
        assert_eq(code, 0, "AOT build failed in {root.display()}:\n{stderr}")
    }
    modes :: [["run", "--release", "run.jet"], ["run", "run.jet"], ["run", "--interpret", "run.jet"]]
    inline_results: [(Int32, String)] = []
    extracted_results: [(Int32, String)] = []
    for args in modes {
        inline :: run_inline_cli(&inline_root, args)
        assert_eq(inline.0, 0, "inline tier failed {args:?}:\n{inline.2}")
        assert_eq(inline.1, expected, "inline tier output drifted for {args:?}")
        extracted :: run_inline_cli(&extracted_root, args)
        assert_eq(extracted.0, 0, "extracted tier failed {args:?}:\n{extracted.2}")
        assert_eq(extracted.1, expected, "extracted tier output drifted for {args:?}")
        inline_results.push((inline.0, inline.1))
        extracted_results.push((extracted.0, extracted.1))
    }
    assert_eq(inline_results, extracted_results, "inline and extracted source must have identical tier receipts")
    remove_inline_scratch(&base)
}
