    dir :: tmp_dir("unpinned")
    write_textkit_fixture(&dir)
    write(&dir, "stats.jet", "use textkit#1.4\n\nfn run() {\n    print(textkit.shout(\"hi\"))\n}\n")
    out :: jet_cmd(["run", "stats.jet"], &dir)
    assert(out.status.success(), "a loose selector still resolves and runs\nstderr: {String.from_utf8_lossy(&out.stderr)}")
