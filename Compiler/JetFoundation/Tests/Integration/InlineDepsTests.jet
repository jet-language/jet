// Rust: tests/inline_deps.rs:158
#Test("jet_lock_writes_sidecar") {
    if !jet_bin().is_file() { return }
    dir :: tmp_dir("lock")
    write_textkit_fixture(&dir)
    write(&dir, "stats.jet", "use textkit#1.4\n\nfn run() {\n    print(textkit.shout(\"hi\"))\n}\n")
    out :: jet_cmd(["fetch", "--lock", "stats.jet"], &dir)
    assert(out.status.success(), "jet fetch --lock should succeed\nstdout: {String.from_utf8_lossy(&out.stdout)}\nstderr: {String.from_utf8_lossy(&out.stderr)}")
    sidecar :: dir.join("stats.jet.lock")
    assert(sidecar.is_file(), "expected {sidecar.display()} to exist")
    contents :: fs.read_to_string(&sidecar).unwrap()
    assert(contents.contains("version = 1"))
    assert(contents.contains("script_hash = \"sha256-"))
    assert(contents.contains("[[dep]]"))
    assert(contents.contains("name = \"textkit\""))
    assert(contents.contains("selector = \"1.4\""))
    assert(contents.contains("resolved = \"1.4.2\""))
    assert(contents.contains("content_hash = \"sha256-"))
    out2 :: jet_cmd(["fetch", "--lock", "stats.jet"], &dir)
    assert(out2.status.success())
    assert_eq(contents, fs.read_to_string(&sidecar).unwrap())
}
