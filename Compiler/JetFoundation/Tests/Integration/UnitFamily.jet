// PORT-PENDING 1182 tests-unit-family: tests/unit_family.rs:1-2249
// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! D-QUAL3 (ratified 2026-06-24): unit families, `#UnitFamily(Name) { m, … }`.
//RS //!
//RS //! Each member mints one `#Numeric` distinct type erasing to `Float`
//RS //! (`usd` → `Usd`), so signatures read in plain English and the compiler keeps
//RS //! the units from mixing. This is pure sugar over the D-DIST1/D-DIST3 distinct
//RS //! machinery: convert with `Usd.from_float(value)`, scalar scaling stays in the
//RS //! unit, `.raw()` strips it, and nominal cross-unit/unit×unit mixing is E0127
//RS //! (the distinct same-type arithmetic rule). The family erases in codegen (I3).
//RS //! D-TYPE2-DEFAULT1=A (Docs/spec/syntax-decisions.md:768): bare decimal
//RS //! literals are exact; these fixtures use the registered `Float{...}` literal
//RS //! when `from_float` needs an approximate input.
//RS 
//RS mod common;
//RS 
//RS #[path = "tir_support/mod.rs"]
//RS mod tir_support;
//RS 
