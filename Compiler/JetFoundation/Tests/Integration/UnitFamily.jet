// D-QUAL3: nominal unit families; physical dimensions opt in explicitly.
use jet.[compile, Lexer, Parser]
use jet.Driver.check_file
use jet.AST.[UnitFamilyDef, Item, Dimension]
use jet.Loader.load_entry
use jet.Sema.[check_bundle, CompileMode]
use jet.Publish.ApiFreeze.snapshot_from_items
use std.fs
use common
// Rust: tests/unit_family.rs:18
pub FAMILY :: "\n#UnitFamily(Currency) { usd, eur }\n"
// Rust: tests/unit_family.rs:22
pub fn codes_of(src: String) -> [String] {
    if compile(src) is .Err(diags) { diags.into_iter().map(d -> d.code.to_string()).collect() } else { [] }
}
// Rust: tests/unit_family.rs:29
pub fn check_codes_of(src: String) -> [String] {
    // GATE #4494: real scratch entry file and compiler checking.
    dir := common.unique_tmp("jet_quantity_check")
    fs.create_dir_all(dir).unwrap()
    path := dir.join("main.jet")
    fs.write(path, src).unwrap()
    check_file(path.to_str().unwrap(), None, false).0.into_iter().map(d -> d.code).collect()
}
// Rust: tests/unit_family.rs:41
pub fn parse_family(src: String) -> UnitFamilyDef {
    (tokens, diagnostics) := Lexer.lex(src)
    assert(diagnostics.is_empty(), "lex diagnostics: {diagnostics:?}")
    program := Parser.parse(tokens).expect("unit family should parse")
    item := program.items.into_iter().next().unwrap()
    if item is .UnitFamily(family) { family } else { panic("expected a unit family") }
}
// Rust: tests/unit_family.rs:2005
pub fn resolved_axis(root: OSPath, package: String) -> (Dimension, String) {
    // GATE #4494: native filesystem; semantic identity excludes checkout roots.
    fs.create_dir_all(root).unwrap()
    fs.write(root.join("package.jet"), "name: \"{package}\"\nversion: \"1.0.0\"\n").unwrap()
    fs.write(root.join("main.jet"), "pub #UnitFamily(Inventory, dimension, base: item) { item }\npub fn sample() -> Item { return 1item }\nfn run() -> {}\n").unwrap()
    bundle := load_entry(root.join("main.jet").to_str().unwrap()).unwrap()
    diagnostics := check_bundle(&bundle, CompileMode.Run)
    assert(diagnostics.is_empty(), "{diagnostics:?}")
    dimension := bundle.modules[0].items.iter().find_map(item -> {
        if item is .UnitFamily(family) {
            if family.family == "Inventory" { return family.resolved_dimension.clone() }
        }
        None
    }).unwrap()
    signature := snapshot_from_items(bundle.modules[0].items, package, "1.0.0").funcs[0].signature.clone()
    (dimension, signature)
}
