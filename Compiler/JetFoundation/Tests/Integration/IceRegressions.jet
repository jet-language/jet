// Rust: tests/ice_regressions.rs:31
fn assert_compiles(name: String, src: String) -> {
    dir :: env.temp_dir().join("jet_ice_{std.process.id()}")
    fs.create_dir_all(dir).unwrap()
    path :: dir.join("{name}.jet")
    fs.write(path, src).unwrap()
    shown :: path.to_string_lossy()
    out :: jet.compile_with_path(src, shown).unwrap_or_else(diags -> {
        panic("{name}: front end rejected a valid program:\n{jet.render_diagnostics(shown, src, diags)}")
    })
    user_rust :: Common.strip_vetted_prelude_modules(out.rust)
    assert(!user_rust.contains("unsafe"), "{name}: invariant I1")
    if !Common.have_rustc() {
        eprintln("note: rustc not found; skipping build for {name}")
        return
    }
    rs :: dir.join("jet_ice_{name}.rs")
    bin :: dir.join("jet_ice_{name}")
    fs.write(rs, out.rust).unwrap()
    // GATE #4494: native process execution.
    res :: Command.new("rustc").args(["--edition", "2021"]).arg(rs).arg("-o").arg(bin).output().unwrap()
    assert(res.status.success(), "I2 violated: rustc rejected generated code for {name} — this is a jet bug:\n{String.from_utf8_lossy(res.stderr)}")
}

// Rust: tests/ice_report_codegen_rejection.rs:104
fn normalize_backend_error_excerpts(text: String, project: OSPath) -> String {
    excerpts := [String]{}
    current: String? := None
    loop line in text.lines() {
        header := line.trim_start() // #4303
        if header.starts_with("error:") || header.starts_with("error[") {
            if current == Some(block) {
                if block.contains("JET_RUSTC_REJECTION_") {
                    trimmed := block.trim_end() // #4303
                    excerpts.push(trimmed.to_string())
                }
            }
            current = Some(line.to_string())
        } else if header.starts_with("warning:") {
            if current == Some(block) {
                if block.contains("JET_RUSTC_REJECTION_") {
                    trimmed := block.trim_end() // #4303
                    excerpts.push(trimmed.to_string())
                }
            }
            current = None
        } else if current.as_mut() == Some(block) {
            block.push_str("\n")
            block.push_str(line)
        }
    }
    if current == Some(block) {
        if block.contains("JET_RUSTC_REJECTION_") {
            trimmed := block.trim_end() // #4303
            excerpts.push(trimmed.to_string())
        }
    }
    return normalize_backend_locations(excerpts.join("\n\n"), project)
}

// Rust: tests/ice_report_codegen_rejection.rs:135
fn normalize_backend_locations(text: String, project: OSPath) -> String {
    replaced :: text.replace(project.to_string_lossy(), "<project>")
    normalized := String.new()
    loop line in replaced.lines() {
        header := line.trim_start() // #4303
        if header.starts_with("--> ") {
            normalized.push_str("  --> <generated>:<line>:<column>")
        } else if line.split_once('|') == Some((number, source)) {
            trimmed := number.trim() // #4303
            if trimmed.parse<UInt>().is_ok() {
                normalized.push_str("<line> |")
                normalized.push_str(source)
            } else if trimmed.is_empty() {
                normalized.push_str("       |")
                normalized.push_str(source)
            } else { normalized.push_str(line) }
        } else { normalized.push_str(line) }
        normalized.push_str("\n")
    }
    return normalized
}

// Rust: tests/ice_report_single_home.rs:22
fn root() -> OSPath { OSPath.from(env.var("JET_SOURCE_ROOT").unwrap()) }

// Rust: tests/ice_report_single_home.rs:26
fn collect_rs_files(dir: OSPath, out: &[OSPath]) -> {
    entries :: fs.read_dir(dir) ?? return
    loop entry in entries.flatten() {
        path :: entry.path()
        if path.is_dir() { collect_rs_files(path, &out) }
        else if path.extension().is_some_and(e -> e == "rs") { out.push(path) }
    }
}

