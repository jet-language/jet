DEBUG :: "Debug"
// Rust: tests/impl_shape_matrix.rs:16
EQUATABLE :: "Equatable"
// Rust: tests/impl_shape_matrix.rs:17
LABELED_CONTEXTS :: ["bare", "debug", "pretty", "nested"]

// Rust: tests/impl_shape_matrix.rs:20
enum Resolution { Auto, Explicit, Bundle, Unavailable }
// Rust: tests/impl_shape_matrix.rs:28
struct MatrixRow {
    owner: String
    binding: String
    label: String
    display: Resolution
    debug: Resolution
}
// Rust: tests/impl_shape_matrix.rs:40
// The closed row set must account for every sema-admitted fixture owner.
ROWS :: [
    MatrixRow{owner: "AutoOwner", binding: "auto", label: "auto", display: .Auto, debug: .Auto},
    MatrixRow{owner: "DisplayOnlyOwner", binding: "display_only", label: "display-only", display: .Explicit, debug: .Auto},
    MatrixRow{owner: "DebugOnlyOwner", binding: "debug_only", label: "debug-only", display: .Auto, debug: .Explicit},
    MatrixRow{owner: "DisplayDebugOwner", binding: "display_debug", label: "display-debug", display: .Explicit, debug: .Explicit},
    MatrixRow{owner: "EquatableOwner", binding: "equatable", label: "equatable", display: .Explicit, debug: .Auto},
    MatrixRow{owner: "GenericOwner", binding: "generic", label: "generic", display: .Explicit, debug: .Explicit},
    MatrixRow{owner: "EnumOwner", binding: "enum_value", label: "enum", display: .Explicit, debug: .Explicit},
    MatrixRow{owner: "UnitOwner", binding: "unit", label: "unit", display: .Explicit, debug: .Explicit},
    // Debug uses the admitted raw base, not a backend-only distinct impl.
    MatrixRow{owner: "DistinctOwner", binding: "distinct", label: "distinct", display: .Bundle, debug: .Unavailable}
]

// Rust: tests/impl_shape_matrix.rs:108
fn source_path() -> OSPath { root().join(SOURCE_PATH) }
// Rust: tests/impl_shape_matrix.rs:112
fn source_items(bundle: ProgramBundle) -> [Item] { bundle.modules[bundle.entry].items.clone() }
// Rust: tests/impl_shape_matrix.rs:116
fn local_nominals(items: [Item]) -> [String:Bool] {
    result := [String:Bool]{}
    loop item in items {
        if item == {
            .Struct(def) -> result[def.name] = true
            .Enum(def) -> result[def.name] = true
            .Distinct(def) -> result[def.name] = true
            else -> {}
        }
    }
    return result
}
// Rust: tests/impl_shape_matrix.rs:128
fn explicit_impls(items: [Item]) -> [(String, String):Bool] {
    result := [(String, String):Bool]{} // GATE #4499: composite map keys.
    loop item in items {
        if item == {
            .Struct(def) -> {
                loop implementation in def.trait_impls { result[(def.name, implementation.trait_name)] = true }
            }
            .Enum(def) -> {
                loop implementation in def.trait_impls { result[(def.name, implementation.trait_name)] = true }
            }
            .Impl(implementation) -> {
                if implementation.trait_name == Some(trait_name) { result[(implementation.type_name, trait_name)] = true }
            }
            else -> {}
        }
    }
    return result
}
// Rust: tests/impl_shape_matrix.rs:153
fn row_resolution(row: MatrixRow, trait_name: String) -> Resolution {
    if trait_name == DISPLAY { return row.display }
    if trait_name == DEBUG { return row.debug }
    panic("unsupported matrix trait `{trait_name}`")
}
// Rust: tests/impl_shape_matrix.rs:161
fn sema_admits(registry: TraitRegistry, owner: String, trait_name: String) -> Bool {
    if trait_name == DISPLAY { return registry.implements_trait(owner, DISPLAY) || registry.auto_printable.contains(owner) }
    if trait_name == DEBUG { return registry.implements_trait(owner, DEBUG) }
    panic("unsupported matrix trait `{trait_name}`")
}
// Rust: tests/impl_shape_matrix.rs:171
fn matrix_admitted_pairs() -> [(String, String):Bool] {
    result := [(String, String):Bool]{}
    loop row in ROWS {
        loop trait_name in [DISPLAY, DEBUG] {
            if row_resolution(row, trait_name) != .Unavailable { result[(row.owner, trait_name)] = true }
        }
    }
    return result
}
// Rust: tests/impl_shape_matrix.rs:180
fn sema_admitted_pairs(registry: TraitRegistry, local: [String:Bool]) -> [(String, String):Bool] {
    result := [(String, String):Bool]{}
    owners := local.keys().collect()
    owners.sort()
    loop owner in owners {
        loop trait_name in [DISPLAY, DEBUG] {
            if sema_admits(registry, owner, trait_name) { result[(owner, trait_name)] = true }
        }
    }
    return result
}
// Rust: tests/impl_shape_matrix.rs:195
fn assert_matrix_cells() -> {
    assert_eq(ROWS.len(), 9, "the closed impl-shape space changed")
    owners := [String:Bool]{}
    bindings := [String:Bool]{}
    labels := [String:Bool]{}
    loop row in ROWS {
        owners[row.owner] = true
        bindings[row.binding] = true
        labels[row.label] = true
    }
    assert_eq(owners.len(), ROWS.len(), "matrix owners must be unique")
    assert_eq(bindings.len(), ROWS.len(), "matrix bindings must be unique")
    assert_eq(labels.len(), ROWS.len(), "matrix labels must be unique")
    loop row in ROWS {
        loop context in LABELED_CONTEXTS {
            prefix :: "{row.label}/{context}="
            assert_eq(SOURCE.matches(prefix).count(), 1, "source needs one {context} cell for {row.owner}")
            assert_eq(EXPECTED.matches(prefix).count(), 1, "golden needs one {context} cell for {row.owner}")
        }
        print_call :: "print(~{row.binding})"
        assert_eq(SOURCE.matches(print_call).count(), 1, "source needs one print(v) cell for {row.owner}")
    }
    assert_eq(SOURCE.matches("print(~").count(), ROWS.len(), "source must have one direct print cell per row")
}
// Rust: tests/impl_shape_matrix.rs:235
fn assert_admission(registry: TraitRegistry, explicit: [(String, String):Bool], local: [String:Bool]) -> {
    admitted :: sema_admitted_pairs(registry, local)
    rows :: matrix_admitted_pairs()
    assert_eq(admitted, rows, "every sema-admitted local Display/Debug shape needs a matrix row")
    loop row in ROWS {
        assert_resolution(registry, explicit, row.owner, DISPLAY, row.display)
        assert_resolution(registry, explicit, row.owner, DEBUG, row.debug)
    }
}
// Rust: tests/impl_shape_matrix.rs:265
fn assert_resolution(registry: TraitRegistry, explicit: [(String, String):Bool], owner: String, trait_name: String, resolution: Resolution) -> {
    has_explicit :: explicit.contains_key((owner, trait_name))
    if resolution == {
        .Explicit -> {
            assert(has_explicit, "{owner} needs an explicit {trait_name} impl")
            assert(registry.implements_trait(owner, trait_name), "sema must admit {owner}.{trait_name}")
        }
        .Auto -> {
            assert(!has_explicit, "{owner}.{trait_name} must not have a custom impl")
            if trait_name == DISPLAY { assert(registry.auto_printable.contains(owner), "sema must admit auto {owner}.{trait_name}") }
            if trait_name == DEBUG { assert(registry.auto_debug.contains(owner), "sema must admit auto {owner}.{trait_name}") }
        }
        .Bundle -> {
            assert(!has_explicit, "{owner}.{trait_name} must use its bundle")
            assert(registry.implements_trait(owner, trait_name), "sema must admit bundled {owner}.{trait_name}")
        }
        .Unavailable -> {
            assert(!has_explicit, "{owner}.{trait_name} is not sema-admitted")
            assert(!registry.implements_trait(owner, trait_name))
            assert(!registry.auto_printable.contains(owner))
            assert(!registry.auto_debug.contains(owner))
        }
    }
}
// Rust: tests/impl_shape_matrix.rs:313
fn assert_aot_and_admission_contract(registry: TraitRegistry, explicit: [(String, String):Bool], local: [String:Bool]) -> {
    assert_admission(registry, explicit, local)
}
