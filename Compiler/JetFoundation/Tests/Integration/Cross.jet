use std.[fs, env, process]
use jet.[compile_no_os, render_diagnostics]
// GATE #4494: real filesystem and process identifiers.
// Rust: tests/cross.rs:11
pub fn check_freestanding_src(src: String, label: String) -> String {
    dir :: env.temp_dir().join("jet_cross_test_{process.id()}_{label}")
    fs.create_dir_all(&dir).unwrap()
    path :: dir.join("test.jet")
    fs.write(&path, src).unwrap()
    file_arg :: path.to_string_lossy().into_owned()
    if compile_no_os(&file_arg) == {
        .Ok(_) -> "(no errors)\n"
        .Err(diags) -> render_diagnostics(&file_arg, src, &diags)
    }
}
// Rust: tests/cross.rs:156
pub fn os_target_gating_path() -> String {
    OSPath(env.var("CARGO_MANIFEST_DIR").unwrap()).join("Examples/features/lowlevel/os_target_gating.jet").to_string_lossy().into_owned()
}
// Rust: tests/cross.rs:163
pub fn os_target_gating_src() -> String { fs.read_to_string(os_target_gating_path()).unwrap() }
