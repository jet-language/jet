// Rust: tests/fact_reads.rs:412
#Test("aot_default_and_interpreter_fold_the_same_build_facts") {
    scratch :: common.Scratch.new("build-facts-tiers")
    entry :: scratch.join("main.jet")
    fs.write(&entry, "fn run() {\n    print($package.name)\n    print($package.version)\n    print($build.os)\n    print($build.profile)\n}\n").unwrap()
    path :: entry.to_str().unwrap()
    _ :: compile_with_path("", path).expect("AOT front end should fold build facts")
    expected :: "main\n0.0.0\n{core.sys.target.selected_os()}\ndev\n"
    interpreter :: stdout(run_interpreter_once_with_args(path, &[]), "interpreter")
    assert_eq(interpreter, expected)
    for tier in ["O0", "O1", "O2", "Web"] { assert_eq(stdout(common.run_entry_tier(path, tier, false), tier), interpreter) }
}
// Rust: tests/fact_reads.rs:442
#Test("checked_in_lock_stamp_is_a_byte_stable_golden") {
    scratch :: common.Scratch.new("build-stamp-golden")
    lock_path :: scratch.join(".jet/lock")
    fs.create_dir_all(lock_path.parent().unwrap()).unwrap()
    golden :: include_str("tests/fixtures/build_stamp.lock")
    fs.write(&lock_path, golden).unwrap()
    lock :: jet.Lock.parse(golden).expect("checked-in lock golden must parse")
    assert_eq(jet.Lock.write(&lock), golden)
    stamp :: jet.Lock.build_stamp(&scratch.path, true).expect("locked stamp replay")
    assert_eq(stamp.at, "2026-08-13T12:34:56.000000000Z")
    assert_eq(stamp.git.as_deref(), Some("abc123-dirty"))
    assert(stamp.dirty)
    assert_eq(stamp.toolchain, "1.0.0")
}
// Rust: tests/fact_reads.rs:459
#Test("registered_build_stamp_facts_fold_from_the_lock") {
    scratch :: common.Scratch.new("build-stamp-facts")
    lock_path :: scratch.join(".jet/lock")
    fs.create_dir_all(lock_path.parent().unwrap()).unwrap()
    fs.write(&lock_path, include_str("tests/fixtures/build_stamp.lock")).unwrap()
    entry :: scratch.join("main.jet")
    fs.write(&entry, "fn run() {\n    print($build.stamp.git ?? \"none\")\n    print($build.stamp.dirty)\n    print($build.stamp.toolchain)\n    print($build.stamp.at)\n}\n").unwrap()
    path :: entry.to_str().unwrap()
    _ :: compile_with_path("", path).expect("registered stamp facts should fold from the lock")
    expected :: "abc123-dirty\ntrue\n1.0.0\n2026-08-13T12:34:56.000000000Z\n"
    for tier in ["O0", "O1", "O2", "Web"] { assert_eq(stdout(common.run_entry_tier(path, tier, false), tier), expected) }
    assert_eq(stdout(run_interpreter_once_with_args(path, &[]), "interpreter"), expected)
}
// Rust: tests/fact_reads.rs:498
#Test("lock_stamp_is_captured_once_and_replayed_without_a_clock") {
    scratch :: common.Scratch.new("build-stamp-replay")
    generated :: [ComptimeInput { path: ".jet/generated/main.jet", hash: "sha256-fixed" }]
    first :: BuildStamp { git: Some("fixed-revision"), dirty: false, toolchain: "1.0.0", at: "2026-08-13T12:34:56.000000000Z" }
    jet.Lock.record_generated_inputs(&scratch.path, &generated, false, &first).expect("unlocked generated provenance should write the lock")
    before :: fs.read(scratch.join(".jet/lock")).unwrap()
    changed :: BuildStamp { git: Some("different-revision"), dirty: true, toolchain: "different-toolchain", at: "2099-01-01T00:00:00.000000000Z" }
    jet.Lock.record_generated_inputs(&scratch.path, &generated, false, &changed).expect("replaying generated provenance should remain valid")
    after :: fs.read(scratch.join(".jet/lock")).unwrap()
    assert_eq(before, after, "repeated builds must preserve lock bytes")
    assert_eq(jet.Lock.build_stamp(&scratch.path, true).unwrap(), first)
    hostile :: common.Scratch.new("build-stamp-missing")
    hostile_lock :: hostile.join(".jet/lock")
    fs.create_dir_all(hostile_lock.parent().unwrap()).unwrap()
    fs.write(&hostile_lock, "version = 1\n").unwrap()
    error :: jet.Lock.build_stamp(&hostile.path, true).expect_err("missing stamp must fail locked")
    assert(error.contains("[build.stamp]"), "{error}")
}
