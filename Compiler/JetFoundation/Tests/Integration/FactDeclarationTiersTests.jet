// Rust: tests/fact_reads.rs:99
#Test("runtime_fact_reads_are_refused_before_codegen") {
    diags :: diagnostics("#Numeric Severity :: distinct Int(0..10)\n\nfn run() {\n    print(Severity.$range.start)\n}\n")
    diagnostic :: diags.iter().find(fn(diagnostic) { diagnostic.code == "E0302" }).expect("runtime fact read should have a registered diagnostic")
    assert(diagnostic.what.contains("compile-time only"), "{diagnostic}")
    assert(diagnostic.why.contains("never selects runtime behavior"), "{diagnostic}")
    assert(diagnostic.fix.contains("binding"), "{diagnostic}")
}
// Rust: tests/fact_reads.rs:119
#Test("fact_reads_do_not_enter_type_position") {
    diags :: diagnostics("#Numeric Severity :: distinct Int(0..10)\n\nfn takes(value: Severity.$range) {}\nfn run() {}\n")
    diagnostic :: diags.iter().find(fn(diagnostic) { diagnostic.code == "E0119" }).expect("a fact in type position should have a registered diagnostic")
    assert(diagnostic.what.contains("fact value"), "{diagnostic}")
    assert(diagnostic.why.contains("do not mint or select types"), "{diagnostic}")
}
