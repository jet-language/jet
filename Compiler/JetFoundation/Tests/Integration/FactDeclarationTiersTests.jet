    source :: "fn run() {\n    #Track tracked :: 1.0\n    origin :: prep { tracked.$origin }\n    print(origin?.tracked ?? false)\n    print(origin?.source ?? \"missing\")\n    print(origin?.line ?? 0)\n    print(origin?.column ?? 0)\n    print(origin?.ambiguity ?? false)\n}\n"
