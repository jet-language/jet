// Rust: tests/fact_reads.rs:151
#Test("every_registered_plane_has_a_source_fact_read") {
    reads :: jet.Syntax.fact_read_members().map(fn(member) { Registry.fact_read(&member).unwrap_or_else(fn() { panic("unregistered fact member: {member}") }) }).collect()
    for plane in Registry.fact_rows().filter(fn(row) { row.kind() == Registry.RowKind.Plane }) {
        read :: Registry.registered_fact_read(plane.name).unwrap_or_else(fn() { panic("registered plane `{plane.name}` has no typed reader") })
        assert(reads.contains(&read), "registered plane `{plane.name}` has no source member-position read")
        assert_eq(read.reflection_kind(), Registry.reflection_kind(plane.name), "source read and aggregate reflection disagree for `{plane.name}`")
    }
}
