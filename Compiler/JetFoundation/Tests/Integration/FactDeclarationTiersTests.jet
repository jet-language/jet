// Rust: tests/fact_reads.rs:217
#Test("retired_origin_method_is_rejected_for_every_tracked_value_type") {
    diags :: diagnostics("struct Sample { value: Int }\n\nfn run() {\n    #Track count :: 1\n    #Track sample :: Sample{value: 1}\n    print(count.origin())\n    print(sample.origin())\n}\n")
    assert_eq(diags.iter().filter(fn(diagnostic) { diagnostic.code == "E0311" }).count(), 2, "tracked non-Float values must not reach ordinary method lookup: {diags}")
    assert(diags.iter().all(fn(diagnostic) { diagnostic.code != "E0311" || (diagnostic.what == "`.origin()` is retired for tracked values" && diagnostic.fix == "read `value.$origin` in comptime code") }))
}
// Rust: tests/fact_reads.rs:234
#Test("retired_origin_method_preempts_root_dispatch") {
    diags :: diagnostics("fn origin(#Root value: Int) -> Int { value }\n\nfn run() {\n    #Track speed :: 3\n    print(speed.origin())\n}\n")
    assert_eq(diags.iter().filter(fn(diagnostic) { diagnostic.code == "E0311" }).count(), 1, "tracked `.origin()` must be rejected before #Root compatibility dispatch: {diags}")
    assert(!diags.iter().any(fn(diagnostic) { diagnostic.code == "E0105" }), "{diags}")
    assert(diags.iter().any(fn(diagnostic) { diagnostic.code == "E0311" && diagnostic.what == "`.origin()` is retired for tracked values" && diagnostic.fix == "read `value.$origin` in comptime code" }))
}
