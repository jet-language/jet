// Rust: tests/fact_declaration_tiers.rs:116
#Test("resident_jit_and_forced_interpreter_agree_without_fallback") {
    scratch :: common.Scratch.new("fact-declaration-tiers")
    entry :: scratch.join("app.jet")
    fs.write(&entry, SOURCE).unwrap()
    bundle := jet.Loader.load_entry(entry.to_str().unwrap()).unwrap()
    errors :: check_bundle(&bundle, CompileMode.Run).into_iter().filter(fn(diagnostic) { diagnostic.severity == Severity.Error }).collect()
    assert(errors.is_empty(), "fact fixture rejected before tier proof: {errors}")
    // The resident JIT is retired. Every canonical backend must run the checked bundle directly.
    for tier in ["O0", "O1", "O2", "Web"] {
        assert_eq(stdout(common.run_checked_bundle_tier(&bundle, tier, false, &common.development_policy()), tier), EXPECTED)
    }
    assert_eq(stdout(dev_iteration(entry.to_str().unwrap(), false, true), "forced interpreter"), EXPECTED)
}
