// Rust: tests/fact_declaration_tiers.rs:35
#Test("parser_reads_the_fact_source_and_fixture") {
    (tokens, lexer_diagnostics) :: jet.Lexer.lex(Registry.FACT_SOURCE)
    assert(lexer_diagnostics.is_empty(), "lex: {lexer_diagnostics}")
    program :: jet.Parser.parse(&tokens).expect("Facts.jet must parse")
    parsed_names :: program.items.iter().filter_map(fn(item) {
        if item == { .FactDecl(declaration) -> Some(declaration.name.as_str()); else -> None }
    }).collect()
    registry_names :: Registry.fact_declarations().iter().map(fn(declaration) { declaration.source_name }).collect()
    assert_eq(parsed_names, registry_names)
    (fixture_tokens, fixture_diagnostics) :: jet.Lexer.lex(SOURCE)
    assert(fixture_diagnostics.is_empty(), "lex fixture: {fixture_diagnostics}")
    assert(jet.Parser.parse(&fixture_tokens).expect("fact fixture must parse").items.iter().any(fn(item) {
        if item == { .FactDecl(declaration) -> declaration.name == "Exactness"; else -> false }
    }))
}
// Rust: tests/fact_declaration_tiers.rs:72
#Test("registry_reads_the_same_fact_columns") {
    declaration :: Registry.fact_declarations().iter().find(fn(declaration) { declaration.name == "Exactness" }).expect("Exactness is written in Facts.jet")
    row :: Registry.row("Exactness").expect("Exactness is in the one registry")
    assert_eq(row.target, declaration.target)
    assert_eq(row.safe_direction, declaration.safe_direction)
    assert_eq(row.gates, declaration.gates)
    assert_eq(row.decision, declaration.decision)
}
