// Rust: tests/fact_declaration_tiers.rs:202
#Test("measure_rows_share_one_registry_and_all_tiers") {
    plane :: Registry.type_plane("Measure")
    fixed :: Type.FixedList { elem: Type.Int, len: Measure.literal("length", 4) }
    matrix :: Type.compute_shape_type("Matrix", &[2, 3])
    lanes :: Type.Named("F32x4")
    quantity :: Type.Quantity { base: Type.Float, dimension: Dimension.base("Length") }
    assert(Registry.row(plane).is_some(), "measure plane must be registered")
    assert(fixed.knowledge_vector().facts(plane).any(fn(fact) {
        if fact == { .Measure(.Literal { kind, value }) -> kind == "length" && value == 4; else -> false }
    }))
    assert(matrix.knowledge_vector().facts(plane).any(fn(fact) {
        if fact == { .Measure(.Literal { kind, value }) -> kind == "shape" && value == 2; else -> false }
    }))
    assert(lanes.knowledge_vector().facts(plane).any(fn(fact) {
        if fact == { .Measure(.Literal { kind, value }) -> kind == "lane" && value == 4; else -> false }
    }))
    assert(quantity.knowledge_vector().facts(plane).any(fn(fact) {
        if fact == { .Measure(.SignedLiteral { kind, value }) -> kind == "exponent" && value == 1; else -> false }
    }))
    source :: "\nuse core.compute as compute\n\nfn vec_rank(value: Vec<3>) -> Int {\n    return compute.rank(value)\n}\n\nfn matrix_rank(value: Matrix<2, 3>) -> Int {\n    return compute.rank(value)\n}\n\nfn run() {\n    vector :: compute.vec(3, 1.0) ?? panic(\"vector\")\n    matrix :: compute.matrix(2, 3, 2.0) ?? panic(\"matrix\")\n    print(\"vector:{vec_rank(vector)}\")\n    print(\"matrix:{matrix_rank(matrix)}\")\n}\n"
    tir_support.assert_tiers_agree("measure_rows_share_one_registry", source, "vector:1\nmatrix:2\n")
}
