}
// Rust: tests/parity.rs:837
pub fn string_equalities(text: &String, subject: &String) -> BTreeSet<String> {
    names := BTreeSet<String>.new()
    needle :: "{subject} == \""
    rest := text
    loop {
        at :: match rest.find(&needle) { Some(at) -> at; None -> { break } }
        value := &rest[at + needle.len()..] // #4303
        match value.find('"') {
            Some(end) -> { _ :: names.insert(value[..end].to_string()); rest = &value[end + 1..] }
            None -> { break }
        }
    }
    names
}
// Rust: tests/parity.rs:853
pub fn direct_dispatch_names(text: &String) -> BTreeSet<String> { string_equalities(text, "name") }
// Rust: tests/parity.rs:857
pub fn extract_any_string_pairs(text: &String) -> BTreeSet<(String, String)> {
    out := BTreeSet<(String, String)>.new()
    loop (start, end) in tuple_ranges(text) {
        fields :: split_top_level(&text[start + 1..end - 1], ',')
        if fields.len() >= 2 {
            loop owner in extract_quoted(fields[0]) {
                loop method in extract_quoted(fields[1]) { _ :: out.insert((owner.clone(), method)) }
            }
        }
    }
    out
}
// Rust: tests/parity.rs:872
pub fn core_boundary(module: &String, method: &String) -> String? {
    if EFFECT_GATED_MODULES.contains(module) { return Some("named comptime effect gate") }
    if ["core.sys", "core.term", "core.web", "core.web.storage.local", "core.web.storage.session", "core.tasks", "core.watcher", "core.web.devserver", "core.crypto.uuid"].contains(module) { return Some("named ambient/native boundary") }
    if module == "core.ui" && ["null_backend", "tui_backend", "gtk_backend", "reactive_render"].contains(method) { return Some("named ambient/native boundary") }
    if module == "core.game.raylib" && ["begin_drawing", "clear_background", "close_window", "draw_rectangle", "draw_text", "end_drawing", "key_down", "set_target_fps", "window_open", "window_ready", "window_should_close"].contains(method) { return Some("named ambient/native boundary") }
    if module == "core.testing" && ["corpus", "fixture", "golden", "snap", "temp_dir"].contains(method) { return Some("named testing filesystem boundary") }
    if (module == "core.args" && method == "spec") || (module == "core.game" && method == "run") { return Some("named ambient runtime boundary") }
    if ["core.event", "core.http.client", "core.http.server", "core.http.middleware", "core.net.ws", "core.mem", "core.mem.scope"].contains(module) { return Some("named runtime/native boundary") }
    if (module.starts_with("core.encoding.") && ["reader", "writer"].contains(method)) || (module == "core.email" && ["smtp", "smtp_from_env"].contains(method)) || (module == "core.data" && ["csv_reader", "json_reader"].contains(method)) { return Some("named I/O handle boundary") }
    if module == "core.time" && ["now", "now_utc", "today", "time", "instant", "sleep", "start"].contains(method) { return Some("named clock boundary") }
    if module == "core.auth" && ["verify_jwt", "verify_paseto"].contains(method) { return Some("named native/security boundary") }
    if module == "core.crypto.random" && method == "bytes" { return Some("named native/security boundary") }
    if module == "core.crypto.expert" && ["open_v1", "migrate_v1"].contains(method) { return Some("named native/security boundary") }
    if module == "core.crypto.vault" { return Some("named native/security boundary") }
    if module == "core.time" && (method == "today" || method == "now") { return Some("named clock boundary") }
    if module == "core.time.expiring" && method == "new" { return Some("named E1004 retired spelling boundary") }
    None
}
// Rust: tests/parity.rs:981
pub fn value_boundary(owner: &String) -> String? {
    if owner == "Instant" { return Some("named clock boundary") }
    if owner == "Clock" { return Some("named clock boundary") }
    if owner == "ExpiringValue" { return Some("named expiry runtime boundary") }
    if ["Secret", "WrappedVaultKey"].contains(owner) { return Some("named native/security boundary") }
    if ["Signal", "Shared", "Effect", "Computed", "Derived", "DecisionHook"].contains(owner) { return Some("named reactive runtime boundary") }
    if ["Task", "Receiver", "Sender", "Event", "AsyncEvent", "DispatchReport", "Hook", "Subscription", "EventScope", "EventTrace", "WatchHandle", "WatchSet", "SigningKey", "X25519SecretKey", "VerifyKey", "X25519PublicKey", "Signature", "Sealed", "WrappedKey", "Digest256", "Digest512", "PasswordHash"].contains(owner) { Some("named runtime/native handle boundary") } else { None }
}
// Rust: tests/parity.rs:1031
pub fn value_method_boundary(owner: &String, method: &String) -> String? {
    match (owner, method) {
        ("List" | "FixedList", "view") -> Some("named E0214 retired spelling boundary")
        ("FixedList", "insert") -> Some("named E0964 fixed-length boundary")
        ("Float", "origin") -> Some("named float-debug tracking boundary")
        ("Stopwatch", "elapsed_millis") -> Some("named clock boundary")
        _ -> None
    }
}
// Rust: tests/parity.rs:1041
pub fn comptime_sequence_methods() -> BTreeSet<String> {
    source :: read("crates/jet-comptime/src/Comptime/SequenceParity.rs")
    method_candidates(source_between(&source, "if !matches!(", Some("return None;")))
}
// Rust: tests/parity.rs:1050
pub fn discover_inventory() -> BTreeSet<Entry> {
    fixed_src :: read("crates/jet-sema/src/Sema/CheckerCoreLib/fixed_sigs.rs")
    bespoke_src :: read("crates/jet-sema/src/Sema/CheckerCoreLib/core_call.rs")
    fixed :: extract_pairs(&fixed_src)
    core_all :: extract_pairs(&bespoke_src)
    entries := BTreeSet<Entry>.new()
    loop (module, method) in &fixed {
        if EXTRACTOR_ARTIFACTS.contains(&(module.as_str(), method.as_str())) { continue }
        _ :: entries.insert(Entry { surface: Surface.Fixed, owner: module.clone(), method: method.clone() })
    }
    loop (module, method) in core_all.difference(&fixed) {
        _ :: entries.insert(Entry { surface: Surface.Bespoke, owner: module.clone(), method: method.clone() })
    }
    syntax_src :: "{read("crates/jet-foundation/src/Syntax.rs")}\n{read_rust_tree("crates/jet-foundation/src/Syntax")}"
    values :: string_constant_values(&syntax_src, "")
    direct_src :: read("crates/jet-sema/src/Sema/CheckerInfer/calls/direct_calls.rs")
    direct_aot := builtin_constant_refs(&direct_src)
    direct_aot.extend(equality_constant_refs(&direct_src, "call.name").into_iter().filter(fn(constant) -> constant.starts_with("TYPE_") || constant == "RESOURCE_CLOSE"))
    loop constant in direct_aot {
        spelling :: values.get(&constant).cloned().unwrap_or_else(fn() -> constant.clone())
        _ :: entries.insert(Entry { surface: Surface.DirectStatic, owner: "direct", method: spelling })
    }
    math_src :: read("crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs")
    math_types :: math_src.split("pub fn math_scalar_ty").next().map(extract_quoted).unwrap_or_default()
    loop name in math_types.into_iter().filter(fn(name) -> name.chars().next().is_some_and(fn(ch) -> ch.is_ascii_uppercase())) {
        _ :: entries.insert(Entry { surface: Surface.DirectStatic, owner: "direct", method: name })
    }
    entries.extend(aot_collection_methods())
    entries.extend(aot_special_collection_constructors())
    entries.extend(aot_specialized_value_methods())
    entries
}
// Rust: tests/parity.rs:1121
pub fn classify_inventory(discovered: &BTreeSet<Entry>) -> [Classified] [String]! {
    core_dispatch_src :: read_rust_tree("crates/jet-comptime/src/Comptime")
    builtin_dispatch_src :: read("crates/jet-comptime/src/Comptime/Builtins.rs")
    dispatch_tree :: read_rust_tree("crates/jet-comptime/src/Comptime/Methods/dispatch")
    dispatch_src :: "{read("crates/jet-comptime/src/Comptime/Methods/dispatch.rs")}\n{dispatch_tree}"
    ct_core :: extract_pairs(&core_dispatch_src)
    gaps: BTreeSet<(String, String)> :: KNOWN_OPEN_GAPS.iter().cloned().collect()
    partials: BTreeSet<(String, String)> :: KNOWN_PARTIAL_GAPS.iter().cloned().collect()
    syntax_src :: "{read("crates/jet-foundation/src/Syntax.rs")}\n{read_rust_tree("crates/jet-foundation/src/Syntax")}"
    values :: string_constant_values(&syntax_src, "")
    direct_ct := builtin_constant_refs(&dispatch_src)
    direct_ct.extend(equality_constant_refs(&dispatch_src, "name"))
    direct_names := direct_dispatch_names(&dispatch_src)
    direct_names.extend(direct_ct.iter().filter_map(fn(constant) -> values.get(constant).cloned()))
    ct_values := ct_value_methods(&core_dispatch_src)
    core_pure_source :: read("crates/jet-comptime/src/Comptime/CorePureParity.rs")
    core_pure_methods :: source_between(&core_pure_source, "pub(super) fn evaluate_method(", Some("fn one<'a>("))
    ct_values.extend(extract_any_string_pairs(core_pure_methods).into_iter().filter(fn(pair) -> pair.0.chars().next().is_some_and(fn(ch) -> ch.is_ascii_uppercase())))
    ct_statics := ct_static_methods(source_between(&builtin_dispatch_src, "pub fn apply_static_type_method(", Some("pub fn apply_mutating(")))
    ct_statics.extend(guarded_static_methods(&dispatch_tree))
    ct_build_context :: ct_build_context_methods()
    sequence_methods :: comptime_sequence_methods()
    view_methods: BTreeSet<String> :: ["contains", "first", "fold", "get", "index_of", "is_empty", "join", "last", "len", "map"].into_iter().collect()
    errors: [String] := []
    loop (module, method) in KNOWN_OPEN_GAPS {
        pair_is_discovered :: discovered.iter().any(fn(entry) -> (entry.surface == Surface.Fixed || entry.surface == Surface.Bespoke) && entry.owner == module && entry.method == method)
        if !pair_is_discovered { errors.push("stale pure_pending gap: {module}.{method} is no longer discovered") }
        else if ct_core.contains(&(module.to_string(), method.to_string())) { errors.push("stale pure_pending gap: {module}.{method} is now comptime-covered") }
    }
    loop (module, method) in KNOWN_PARTIAL_GAPS {
        pair :: (module.to_string(), method.to_string())
        if !discovered.iter().any(fn(entry) -> (entry.surface == Surface.Fixed || entry.surface == Surface.Bespoke) && entry.owner == module && entry.method == method) {
            errors.push("stale partial gap: {module}.{method} is no longer discovered")
        } else if ct_core.contains(&pair) { errors.push("partial gap leaked into comptime dispatch: {module}.{method}") }
    }
    out: [Classified] := []
    loop entry in discovered.iter().cloned() {
        classified: (Class, String)? :: match entry.surface {
            .Fixed | .Bespoke -> {
                pair :: (entry.owner.clone(), entry.method.clone())
                if partials.contains(&(entry.owner.as_str(), entry.method.as_str())) { Some((Class.PurePending, "explicit partial pure port")) }
                else if ct_core.contains(&pair) { Some((Class.Covered, "comptime core dispatch")) }
                else if gaps.contains(&(entry.owner.as_str(), entry.method.as_str())) { Some((Class.PurePending, "explicit pure port backlog")) }
                else { core_boundary(&entry.owner, &entry.method).map(fn(reason) -> (Class.Boundary, reason)) }
            }
            .DirectStatic -> {
                if entry.owner == "direct" {
                    if ["print", "input"].contains(&entry.method) { Some((Class.Boundary, "named interactive I/O boundary")) }
                    else if entry.method == "close" { Some((Class.Boundary, "named runtime resource boundary")) }
                    else if direct_names.contains(&entry.method) { Some((Class.Covered, "comptime direct dispatch")) }
                    else { None }
                } else if ct_statics.contains(&(entry.owner.clone(), entry.method.clone())) { Some((Class.Covered, "comptime static dispatch")) }
                else { match value_boundary(&entry.owner) { Some(reason) -> Some((Class.Boundary, reason)); None -> Some((Class.PurePending, "static method port pending")) } }
            }
            .Value -> {
                owner :: if entry.owner == "FixedList" { "List" } else { &entry.owner }
                erased_scalar_dispatch :: match entry.owner.as_str() {
                    "I8" | "I16" | "I32" | "U8" | "U16" | "U32" | "U64" -> ["to_string", "count_ones", "count_zeros", "leading_zeros", "trailing_zeros"].contains(&entry.method) && ct_values.contains(&("Int", entry.method.clone()))
                    "F32" -> ["is_nan", "is_infinite", "is_finite", "to_string"].contains(&entry.method) && ct_values.contains(&("Float", entry.method.clone()))
                    _ -> false
                }
                match value_method_boundary(&entry.owner, &entry.method) {
                    Some(reason) -> Some((Class.Boundary, reason))
                    None -> {
                        if owner == "BuildContext" && ct_build_context.contains(&entry.method) { Some((Class.Covered, "interpreter-owned build context dispatch")) }
                        else if ["List", "FixedList", "Iter"].contains(&entry.owner) && sequence_methods.contains(&entry.method) { Some((Class.Covered, "comptime sequence dispatch")) }
                        else if entry.owner == "Iter" && ["to_list", "collect", "len", "is_empty", "join", "map", "filter", "each", "find"].contains(&entry.method) { Some((Class.Covered, "comptime Iter dispatch")) }
                        else if ["View", "ViewMut"].contains(&entry.owner) && view_methods.contains(entry.method.as_str()) { Some((Class.Covered, "comptime slice-view dispatch")) }
                        else if erased_scalar_dispatch { Some((Class.Covered, "comptime scalar representation dispatch")) }
                        else if ct_values.contains(&(owner.to_string(), entry.method.clone())) { Some((Class.Covered, "comptime value dispatch")) }
                        else { match value_boundary(&entry.owner) { Some(reason) -> Some((Class.Boundary, reason)); None -> Some((Class.PurePending, "value method port pending")) } }
                    }
                }
            }
        }
        match classified {
            Some((class, reason)) -> out.push(Classified { entry, class, reason })
            None -> errors.push("unclassified {entry.surface.name()} {entry.owner}.{entry.method}")
        }
    }
    if errors.is_empty() { Ok(out) } else { Err(errors) }
}
// Rust: tests/parity.rs:1339
pub fn render_inventory(records: &[Classified]) -> String {
    lines: [String] := records.iter().map(fn(record) -> "{record.class.name()} | {record.entry.surface.name()} | {record.entry.owner}.{record.entry.method} | {record.reason}").collect()
    lines.sort()
    lines.join("\n") + "\n"
}
// Rust: tests/parity.rs:1357
pub fn stable_hash(text: &String) -> U64 {
    text.bytes().fold(0xcbf29ce484222325 as U64, fn(hash, byte) -> (hash ^ U64.from(byte)).wrapping_mul(0x100000001b3))
}
// Rust: tests/parity.rs:1363
pub fn validate_records(discovered: &BTreeSet<Entry>, records: &[Classified]) -> Unit [String]! {
    seen := BTreeSet<Entry>.new()
    errors: [String] := []
    loop record in records {
        if !seen.insert(record.entry.clone()) { errors.push("duplicate classification: {record.entry.surface.name()} {record.entry.owner}.{record.entry.method}") }
        if !discovered.contains(&record.entry) { errors.push("stale {record.class.name()} classification: {record.entry.surface.name()} {record.entry.owner}.{record.entry.method}") }
    }
    loop entry in discovered.difference(&seen) { errors.push("unclassified: {entry.surface.name()} {entry.owner}.{entry.method}") }
    if errors.is_empty() { Ok(()) } else { Err(errors) }
}
// Rust: tests/parity.rs:1403
pub fn record(records: &[Classified], surface: Surface, owner: &String, method: &String) -> &Classified {
    records.iter().find(fn(record) -> record.entry.surface == surface && record.entry.owner == owner && record.entry.method == method).unwrap_or_else(fn() -> panic("missing {surface.name()} {owner}.{method}"))
}


