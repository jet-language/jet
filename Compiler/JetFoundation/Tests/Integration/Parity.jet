// Rust: tests/parity.rs:617
pub fn aot_specialized_value_methods() -> BTreeSet<Entry> {
    // Rust: tests/parity.rs:618
    fn add_arm(entries: &BTreeSet<Entry>, source: &String, owner: &String, marker: &String) -> {
        loop method in method_candidates(source_between(source, marker, Some("_ => None,"))) {
            _ :: entries.insert(Entry { surface: Surface.Value, owner: owner.to_string(), method })
        }
    }
    time :: read("crates/jet-sema/src/Sema/CheckerCoreLib/net_text_time.rs")
    entries := BTreeSet<Entry>.new()
    add_arm(&entries, &time, "MIME", "Type::Named(n) if n == \"MIME\" => match method {")
    date_marker :: "Type::Named(n) if n == \"Date\" || n == \"LocalDate\" => match method {"
    add_arm(&entries, &time, "Date", date_marker)
    add_arm(&entries, &time, "LocalDate", date_marker)
    loop owner in ["LocalTime", "DateTime", "Instant", "Period", "Zone", "ZonedDateTime"] {
        add_arm(&entries, &time, owner, "Type::Named(n) if n == \"{owner}\" => match method {{")
    }
    inference :: read("crates/jet-sema/src/Sema/CheckerInfer/calls/method_calls.rs")
    loop method in method_candidates(source_between(&inference, "// D-HONESTNUM1=A: methods on `Measurement<Float>`", Some("// D-MEM1 S6"))) {
        _ :: entries.insert(Entry { surface: Surface.Value, owner: "Measurement", method })
    }
    entries
}
// Rust: tests/parity.rs:670
pub fn ct_value_methods(text: &String) -> BTreeSet<(String, String)> {
    variants :: [("List", "List"), ("Bytes", "List"), ("Map", "Map"), ("Str", "String"), ("Int", "Int"), ("Float", "Float"), ("Bool", "Bool"), ("Char", "Char"), ("BigInt", "Int"), ("Present", "Option"), ("Failed", "Option")]
    syntax :: "{read("crates/jet-foundation/src/Syntax.rs")}\n{read_rust_tree("crates/jet-foundation/src/Syntax")}"
    values :: string_constant_values(&syntax, "")
    out := BTreeSet<(String, String)>.new()
    loop (start, end) in tuple_ranges(text) {
        fields :: split_top_level(&text[start + 1..end - 1], ',')
        if fields.len() >= 2 {
            methods :: extract_quoted(fields[1])
            loop (variant, owner) in variants {
                if fields[0].contains("CtValue::{variant}") {
                    loop method in &methods { _ :: out.insert((owner.to_string(), method.clone())) }
                }
            }
            field := fields[0].trim() // #4303
            if field == "v" {
                loop (_, owner) in variants { loop method in &methods { _ :: out.insert((owner.to_string(), method.clone())) } }
            }
            if fields[0].contains("CtValue::Struct") {
                rest := &text[end..] // #4303
                guard := &rest[..rest.find("=>").unwrap_or(0)] // #4303
                owners := string_equalities(guard, "type_name")
                owners.extend(equality_constant_refs(guard, "type_name").into_iter().filter_map(fn(constant) -> values.get(&constant).cloned()))
                if guard.contains("type_name.as_str()") {
                    owners.extend(extract_quoted(guard).into_iter().filter(fn(owner) -> owner.chars().next().is_some_and(fn(ch) -> ch.is_ascii_uppercase())))
                }
                methods := extract_quoted(fields[1])
                field := fields[1].trim() // #4303
                if field == "method" {
                    methods.extend(extract_quoted(guard).into_iter().filter(fn(method) -> method.chars().all(fn(ch) -> ch.is_ascii_lowercase() || ch == '_')))
                }
                loop owner in owners { loop method in &methods { _ :: out.insert((owner.clone(), method.clone())) } }
            }
        }
    }
    out
}
// Rust: tests/parity.rs:746
pub fn guarded_static_methods(text: &String) -> BTreeSet<(String, String)> {
    syntax :: "{read("crates/jet-foundation/src/Syntax.rs")}\n{read_rust_tree("crates/jet-foundation/src/Syntax")}"
    values :: string_constant_values(&syntax, "")
    out := BTreeSet<(String, String)>.new()
    needle :: "if type_name == "
    loop at in rust_code_occurrences(text, needle) {
        after := &text[at + needle.len()..] // #4303
        header :: match rust_header_before_block(after) { Some(header) -> header; None -> { continue } }
        trimmed := header.trim_start() // #4303
        owner :: match trimmed.strip_prefix('"') {
            Some(quoted) -> quoted.find('"').map(fn(end) -> quoted[..end].to_string())
            None -> {
                token := trimmed.split_whitespace().next().unwrap_or_default() // #4303
                token.rsplit("::").next().and_then(fn(constant) -> values.get(constant).cloned())
            }
        }
        match owner {
            Some(owner) -> {
                methods := string_equalities(&header, "method")
                match header.find("matches!(method,") { Some(at) -> methods.extend(extract_quoted(&header[at..])); None -> {} }
                loop method in methods { _ :: out.insert((owner.clone(), method)) }
            }
            None -> {}
        }
    }
    out
}
// Rust: tests/parity.rs:786
pub fn ct_static_methods(text: &String) -> BTreeSet<(String, String)> {
    out := BTreeSet<(String, String)>.new()
    loop (owner, method) in extract_any_string_pairs(text) {
        if owner.chars().next().is_some_and(fn(ch) -> ch.is_ascii_uppercase()) { _ :: out.insert((owner, method)) }
    }
    collections :: read("crates/jet-foundation/src/Collections.rs")
    syntax :: "{read("crates/jet-foundation/src/Syntax.rs")}\n{read_rust_tree("crates/jet-foundation/src/Syntax")}"
    receivers :: builtin_receivers(&collections, &syntax)
    loop (method, _) in jet.Syntax.NUMERIC_CONVERSION_SOURCES {
        loop (owner, ty) in &receivers { if ty.is_numeric() { _ :: out.insert((owner.clone(), method.to_string())) } }
    }
    out.extend(guarded_static_methods(text))
    out
}
// Rust: tests/parity.rs:815
pub fn ct_build_context_methods() -> BTreeSet<String> {
    bridge :: read("crates/jet-comptime/src/Comptime/Build/runtime_bridge.rs")
    methods := method_candidates(source_between(&bridge, "let result = match method {", Some("_ => return None.ok_or_else")))
    dispatch :: "{read("crates/jet-comptime/src/Comptime/Methods/dispatch.rs")}\n{read_rust_tree("crates/jet-comptime/src/Comptime/Methods/dispatch")}"
    loop method in ["find", "fetch", "embed"] {
