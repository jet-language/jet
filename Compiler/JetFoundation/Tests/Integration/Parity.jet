// PORT-PENDING 1126 tests-parity: tests/parity.rs:1-2319
// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! Card #392: AOT-vs-comptime builtin parity matrix.
//RS //!
//RS //! Builds one deterministic inventory from AOT's fixed Core signatures,
//RS //! bespoke `infer_core_call` arms, direct/static builtins, and value-method
//RS //! registry. Comptime coverage comes from the real split interpreter source
//RS //! tree. Every discovered entry receives exactly one classification.
//RS //!
//RS //! A pair present in AOT but absent from comptime means `use core.x as a;
//RS //! a.f(...)` type-checks and compiles for `jet build`, but hits E0956 in
//RS //! `jet dev`/the REPL/a `comptime` binding — an R12 parity bug (silent
//RS //! AOT-only builtin). New effect-free builtins must add themselves to
//RS //! comptime's dispatch (or to `KNOWN_OPEN_GAPS` as PurePending). Genuine
//RS //! ambient/native effects are named in `core_boundary` — never listed as
//RS //! PurePending gaps.
//RS //!
//RS //! Effectful modules (`core.files`/`core.sys`/`core.term`/`core.net`/
//RS //! `core.net.tls`/`core.process`) are explicit effect boundaries:
//RS //! comptime handles them as a whole via the `is_tier2` wildcard (E3410
//RS //! `#Impure` gate), not per-method.
//RS 
//RS mod common;
//RS 
//RS use std::collections::{BTreeMap, BTreeSet};
//RS use std::fs;
//RS 
//RS /// Modules comptime gates wholesale behind `#Impure` (Methods.rs `is_tier2`)
//RS /// rather than dispatching per-method — a per-name diff against these would
//RS /// only prove the gate exists, which other tests (e.g. `repl.rs`'s E3410
//RS /// cases) already cover.
//RS const EFFECT_GATED_MODULES: &[&str] = &[
//RS     "core.files",
//RS     "core.sys",
//RS     "core.term",
//RS     "core.net",
//RS     "core.net.tls",
//RS     "core.process",
//RS     // Not gated by the generic `is_tier2` list — denied unconditionally,
//RS     // earlier in `eval_method`, with its own diagnostic (E1265): a build
//RS     // artifact must never bake in a decrypted secret (I1), so there is no
//RS     // `#Impure` escape hatch at all here, unlike the effects above. Correctly
//RS     // handled, just not through the per-method `apply_core_call` table this
//RS     // audit reads — excluded so it isn't flagged as a silent gap.
//RS     "core.crypto.vault",
//RS ];
//RS 
//RS // The tuple extractor intentionally over-approximates alternation arms. JSON's
//RS // `to_string_pretty` must not cross-product onto adapters whose sema surface
//RS // exposes only `to_string`.
//RS const EXTRACTOR_ARTIFACTS: &[(&str, &str)] = &[
//RS     ("core.encoding.csv", "to_string_pretty"),
//RS     ("core.encoding.toml", "to_string_pretty"),
//RS     ("core.encoding.yaml", "to_string_pretty"),
//RS ];
//RS 
//RS /// Known, currently-open *pure* comptime gaps: real AOT `(module, method)`
//RS /// pairs with no comptime dispatch yet that are effect-free and therefore
//RS /// eligible for a future pure port. Every entry here is a to-do — remove a
//RS /// line the same PR that closes the gap.
//RS ///
//RS /// Ambient / native / security *boundaries* do **not** live here. They are
//RS /// classified by `core_boundary` (exact per-call for mixed modules). Listing a
//RS /// boundary row here used to false-green: `classify_inventory` preferred the
//RS /// broad module boundary and the asserted pure-pending count stayed zero
//RS /// while these rows were still open (card #721 / #392 criterion 3).
//RS /// Closed by #722: crypto.expert AEAD/sign/argon2id and encoding.xml projection
//RS /// ports. View/ViewMut.join closed here (string JoinSep; same List join semantics).
//RS /// D-ITERTOOLS1 Iter.* rows are Covered via sequence/Iter dispatch (list-shaped
//RS /// TirBridge + AOT JetIter fusion).
//RS /// until inventory closeout — not #722 crypto/xml gaps.
//RS const KNOWN_OPEN_GAPS: &[(&str, &str)] = &[];
//RS 
//RS /// Calls with a production-compiled foundation that must remain private until
//RS /// the complete AOT contract is resident. A public comptime arm is a false
//RS /// parity claim while an entry remains here. Remove the entry in the same
//RS /// commit that completes and dispatches the call.
//RS const KNOWN_PARTIAL_GAPS: &[(&str, &str)] = &[];
//RS 
