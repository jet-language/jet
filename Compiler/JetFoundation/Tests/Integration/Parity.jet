// Rust: tests/parity.rs:415
pub fn string_constant_values(text: &String, prefix: &String) -> [String:String] {
    values: [String:String] := [:]
    loop line in text.lines() {
        line := line.trim() // #4303
        rest :: match line.strip_prefix("pub const ") { Some(rest) -> rest; None -> { continue } }
        (name, value) :: match rest.split_once(": &str = ") { Some(pair) -> pair; None -> { continue } }
        if !name.starts_with(prefix) { continue }
        start :: match value.find('"') { Some(at) -> at; None -> { continue } }
        end :: match value[start + 1..].find('"') { Some(at) -> at; None -> { continue } }
        value := &value[start + 1..start + 1 + end] // #4303
        _ :: values.insert(name.to_string(), value.to_string())
    }
    values
}
// Rust: tests/parity.rs:440
pub fn constant_refs(text: &String, prefix: &String) -> BTreeSet<String> {
    refs := BTreeSet<String>.new()
    needle :: "Syntax::{prefix}"
    rest := text
    loop {
        at :: match rest.find(&needle) { Some(at) -> at; None -> { break } }
        after := &rest[at + "Syntax::".len()..] // #4303
        len :: after.bytes().take_while(fn(byte) -> byte.is_ascii_uppercase() || byte.is_ascii_digit() || *byte == 95).count()
        _ :: refs.insert(after[..len].to_string())
        rest = &after[len..]
    }
    refs
}
// Rust: tests/parity.rs:456
pub fn builtin_constant_refs(text: &String) -> BTreeSet<String> { constant_refs(text, "BUILTIN_") }
// Rust: tests/parity.rs:460
pub fn equality_constant_refs(text: &String, subject: &String) -> BTreeSet<String> {
    refs := BTreeSet<String>.new()
    needle :: "{subject} == "
    rest := text
    loop {
        at :: match rest.find(&needle) { Some(at) -> at; None -> { break } }
        after := rest[at + needle.len()..].trim_start() // #4303
        after = after.strip_prefix("crate::").unwrap_or(after)
        match after.strip_prefix("Syntax::") {
            Some(after) -> {
                len :: after.bytes().take_while(fn(byte) -> byte.is_ascii_uppercase() || byte.is_ascii_digit() || *byte == 95).count()
                _ :: refs.insert(after[..len].to_string())
            }
            None -> {}
        }
        rest = &rest[at + needle.len()..]
    }
    refs
}
// Rust: tests/parity.rs:481
pub fn method_candidates(text: &String) -> BTreeSet<String> {
    extract_quoted(text).into_iter().filter(fn(name) -> !name.is_empty() && name.chars().all(fn(ch) -> ch.is_ascii_lowercase() || ch.is_ascii_digit() || ch == '_')).collect()
}
// Rust: tests/parity.rs:493
pub fn named(name: &String) -> Type { Type.Named(name.to_string()) }
// Rust: tests/parity.rs:497
pub fn apply(name: &String, args: [Type]) -> Type { Type.Apply { name: name.to_string(), args } }
// Rust: tests/parity.rs:504
pub fn builtin_receivers(collections: &String, syntax: &String) -> [(String, Type)] {
    out := [
        ("List", Type.List(Box.new(Type.Int))),
        ("FixedList", Type.FixedList { elem: Box.new(Type.Int), len: Measure.literal("length", 4) }),
        ("Map", Type.Map { key: Box.new(Type.String), key_span: None, value: Box.new(Type.Int) }),
        ("String", Type.String), ("Int", Type.Int), ("Float", Type.Float), ("F32", Type.Float32),
        ("Bool", Type.Bool), ("Char", Type.Char), ("Option", Type.Option(Box.new(Type.Int))), ("Shared", Type.Shared(Box.new(Type.Int)))
    ]
    values :: string_constant_values(syntax, "")
    named_receivers: BTreeSet<String> := extract_quoted(collections).into_iter().collect()
    named_receivers.extend(constant_refs(collections, "").into_iter().filter_map(fn(constant) -> values.get(&constant).cloned()))
    loop owner in named_receivers {
        out.push((owner.clone(), named(&owner)))
        out.push((owner.clone(), apply(&owner, [Type.Int])))
        out.push((owner.clone(), apply(&owner, [Type.String, Type.Int])))
    }
    loop (_, source) in jet.Syntax.NUMERIC_CONVERSION_SOURCES {
        match jet.AST.numeric_type_from_name(source) {
            Some(ty) -> {
                owner :: ty.name()
                if !out.iter().any(fn(pair) -> pair.0 == owner) { out.push((owner, ty)) }
            }
            None -> {}
        }
    }
    out
}
// Rust: tests/parity.rs:558
pub fn aot_collection_methods() -> BTreeSet<Entry> {
    source :: read("crates/jet-foundation/src/Collections.rs")
    syntax :: "{read("crates/jet-foundation/src/Syntax.rs")}\n{read_rust_tree("crates/jet-foundation/src/Syntax")}"
    candidates := method_candidates(&source)
    values :: string_constant_values(&syntax, "")
    candidates.extend(constant_refs(&source, "").into_iter().filter_map(fn(constant) -> values.get(&constant).cloned()))
    candidates.extend(jet.Syntax.NUMERIC_CONVERSION_SOURCES.iter().map(fn(pair) -> pair.0.to_string()))
    entries := BTreeSet<Entry>.new()
    loop (owner, ty) in builtin_receivers(&source, &syntax) {
        loop method in &candidates {
            loop arity in 0..9 {
                if jet.Collections.builtin_method_return(&ty, method, arity, false).is_some() {
                    _ :: entries.insert(Entry { surface: Surface.Value, owner: owner.clone(), method: method.clone() })
                }
                if jet.Collections.builtin_method_return(&ty, method, arity, true).is_some() {
                    _ :: entries.insert(Entry { surface: Surface.DirectStatic, owner: owner.clone(), method: method.clone() })
                }
            }
        }
    }
    entries
}
