// Rust: tests/parity.rs:78
pub fn raw_string_end(bytes: &[U8], start: Int) -> Int? {
    i := match (bytes.get(start), bytes.get(start + 1)) {
        (Some(114), _) -> start + 1
        (Some(98), Some(114)) -> start + 2
        _ -> { return None }
    }
    hashes_start :: i
    loop bytes.get(i) == Some(35) { i += 1 }
    if bytes.get(i) != Some(34) { return None }
    hashes :: i - hashes_start
    i += 1
    loop i < bytes.len() {
        if bytes[i] == 34 && i + 1 + hashes <= bytes.len() && bytes[i + 1..i + 1 + hashes].iter().all(fn(byte) -> *byte == 35) {
            return Some(i + 1 + hashes)
        }
        i += 1
    }
    Some(bytes.len())
}

// Rust: tests/parity.rs:106
#Derive(Clone, Copy, Eq, PartialEq)
pub enum RustSegment { Code, String }

// Rust: tests/parity.rs:112
pub fn rust_source_segments(text: &String) -> [(RustSegment, Int, Int)] {
    bytes :: text.as_bytes()
    segments: [(RustSegment, Int, Int)] := []
    i := 0
    start := 0
    loop i < bytes.len() {
        skipped_from :: i
        string := false
        skipped := false
        if bytes[i] == 47 && bytes.get(i + 1) == Some(47) {
            i += 2
            loop i < bytes.len() && bytes[i] != 10 { i += 1 }
            skipped = true
        } else if bytes[i] == 47 && bytes.get(i + 1) == Some(42) {
            i += 2
            comments := 1
            loop i < bytes.len() && comments > 0 {
                if bytes[i] == 47 && bytes.get(i + 1) == Some(42) { comments += 1; i += 2 }
                else if bytes[i] == 42 && bytes.get(i + 1) == Some(47) { comments -= 1; i += 2 }
                else { i += 1 }
            }
            skipped = true
        } else if match raw_string_end(bytes, i) { Some(end) -> { i = end; skipped = true; true }; None -> false } {
        } else if bytes[i] == 34 {
            i += 1
            loop i < bytes.len() {
                if bytes[i] == 92 { i = (i + 2).min(bytes.len()) }
                else if bytes[i] == 34 { i += 1; break }
                else { i += 1 }
            }
            string = true
            skipped = true
        } else if bytes[i] == 39 {
            end :: if bytes.get(i + 1) == Some(92) { i + 3 } else { i + 2 }
            if bytes.get(end) == Some(39) { i = end + 1; skipped = true }
            else { i += 1 }
        } else { i += 1 }
        if skipped {
            if start < skipped_from { segments.push((RustSegment.Code, start, skipped_from)) }
            if string { segments.push((RustSegment.String, skipped_from, i)) }
            start = i
        }
    }
    if start < bytes.len() { segments.push((RustSegment.Code, start, bytes.len())) }
    segments
}

// Rust: tests/parity.rs:192
pub fn rust_code_ranges(text: &String) -> Iter<(Int, Int)> {
    rust_source_segments(text).into_iter().filter_map(fn(segment) -> {
        (kind, start, end) :: segment
        if kind == RustSegment.Code { Some((start, end)) } else { None }
    })
}
// Rust: tests/parity.rs:198
pub fn rust_code_occurrences(text: &String, needle: &String) -> [Int] {
    out: [Int] := []
    loop (start, end) in rust_code_ranges(text) {
        loop (at, _) in text[start..end].match_indices(needle) { out.push(start + at) }
    }
    out
}
// Rust: tests/parity.rs:209
pub fn rust_header_before_block(text: &String) -> String? {
    segments :: rust_source_segments(text)
    brace: Int? := None
    loop (kind, start, end) in &segments {
        if kind == RustSegment.Code {
            match text.as_bytes()[start..end].iter().position(fn(byte) -> *byte == 123) {
                Some(at) -> { brace = Some(start + at); break }
                None -> {}
            }
        }
    }
    limit :: match brace { Some(at) -> at; None -> { return None } }
    header := [U8].repeat(32, limit)
    loop (_, start, end) in segments {
        if start >= limit { break }
        bounded_end :: end.min(limit)
        header[start..bounded_end].copy_from_slice(&text.as_bytes()[start..bounded_end])
    }
    String.from_utf8(header).ok()
}
// Rust: tests/parity.rs:232
pub fn tuple_ranges(text: &String) -> [(Int, Int)] {
    bytes :: text.as_bytes()
    ranges: [(Int, Int)] := []
    starts: [Int] := []
    loop (start, end) in rust_code_ranges(text) {
        loop i in start..end {
            match bytes[i] {
                40 -> starts.push(i)
                41 -> { match starts.pop() { Some(start) -> ranges.push((start, i + 1)); None -> {} } }
                _ -> {}
            }
        }
    }
    ranges.sort_unstable()
    ranges
}
// Rust: tests/parity.rs:255
pub fn extract_pairs(text: &String) -> BTreeSet<(String, String)> {
    out := BTreeSet<(String, String)>.new()
    loop (start, end) in tuple_ranges(text) {
        fields :: split_top_level(&text[start + 1..end - 1], ',')
        if fields.len() >= 2 {
            modules :: extract_quoted(fields[0])
            names :: extract_quoted(fields[1])
            loop module in modules.iter().filter(fn(module) -> module.starts_with("core.")) {
                loop name in names.iter().filter(fn(name) -> *name != "_") { _ :: out.insert((module.clone(), name.clone())) }
            }
        }
    }
    out
}
// Rust: tests/parity.rs:272
pub fn split_top_level(text: &String, separator: Char) -> [&String] {
    fields: [&String] := []
    depth := 0
    quoted := false
    escaped := false
    start := 0
    loop (i, ch) in text.char_indices() {
        if quoted {
            if escaped { escaped = false }
            else if ch == '\\' { escaped = true }
            else if ch == '"' { quoted = false }
            continue
        }
        match ch {
            '"' -> { quoted = true }
            '(' | '[' | '{' -> { depth += 1 }
            ')' | ']' | '}' -> { depth -= 1 }
            _ -> { if ch == separator && depth == 0 { fields.push(&text[start..i]); start = i + ch.len_utf8() } }
        }
    }
    fields.push(&text[start..])
    fields
}
// Rust: tests/parity.rs:304
pub fn extract_quoted(s: &String) -> [String] {
    out: [String] := []
    bytes :: s.as_bytes()
    i := 0
    loop i < bytes.len() {
        if bytes[i] == 34 {
            match s[i + 1..].find('"') {
                Some(j) -> { out.push(s[i + 1..i + 1 + j].to_string()); i = i + 1 + j + 1; continue }
                None -> { break }
            }
        }
        i += 1
    }
    out
}
// Rust: tests/parity.rs:323
pub fn read(rel: &String) -> String {
    path :: OSPath.from("{env("CARGO_MANIFEST_DIR")}/{rel}")
    fs.read_to_string(&path).unwrap_or_else(fn(e) -> panic("reading {path}: {e}"))
}
// Rust: tests/parity.rs:328
pub fn read_rust_tree(rel: &String) -> String {
    // Rust: tests/parity.rs:329
    fn visit(path: &OSPath, files: &[OSPath]) -> {
        if path.is_dir() {
            loop entry in fs.read_dir(path).unwrap() { visit(&entry.unwrap().path(), files) }
        } else if path.extension().and_then(fn(ext) -> ext.to_str()) == Some("rs") { files.push(path.clone()) }
    }
    root :: OSPath.from(env("CARGO_MANIFEST_DIR")).join(rel)
    files: [OSPath] := []
    visit(&root, &files)
    files.sort()
    files.into_iter().map(fn(path) -> fs.read_to_string(path).unwrap()).collect::<[String]>().join("\n")
}
// Rust: tests/parity.rs:350
pub fn source_between(text: &String, start: &String, end: String?) -> &String {
    at :: text.find(start).unwrap_or_else(fn() -> panic("missing source marker {start}"))
    rest := &text[at..] // #4303
    match end {
        Some(end) -> &rest[..rest.find(end).unwrap_or_else(fn() -> panic("missing source marker {end}"))]
        None -> rest
    }
}
