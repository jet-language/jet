// Rust: tests/ownership.rs:3196
// #1163: read and write views return provenance rooted in the owner's list field.
#Test("owner_backed_collection_returns_element_views") {
    src :: "\nstruct Book {{\n    title: String,\n    pages: Int\n}}\n\nstruct Library {{\n    books: [Book]\n}}\n\nfn book_at(lib: Library, i: Int) -> View<Book> {{ lib.books[i..i] }}\n\nfn edit_at(lib: &Library, i: Int) -[]> ViewMut<Book> {{\n    return &lib.books[i..i]\n}}\n\nfn run() {{\n    lib := Library{{\n        books: [\n            Book{{ title: \"Dune\", pages: 412 }},\n            Book{{ title: \"Neuromancer\", pages: 271 }}\n        ]\n    }}\n    first :: book_at(lib, 0)\n    print(first[0].title)\n    dune :: edit_at(&lib, 0)\n    dune[0].pages += 10\n    print(lib.books[0].pages)\n}}\n"
    out :: compile(src).expect("owner-backed collection views must compile")
    assert(out.rust.contains("fn __jet_book_at<'__jet___view>(__jet_lib: &'__jet___view __jet_Library, __jet_i: i64) -> JetOutcome<&'__jet___view [__jet_Book], JetErr>"), "read view must tie to parameter 0: {out.rust}")
    assert(out.rust.contains("fn __jet_edit_at<'__jet___view>(__jet_lib: &'__jet___view mut __jet_Library, __jet_i: i64) -> JetOutcome<&'__jet___view mut [__jet_Book], JetErr>"), "write view must tie to parameter 0: {out.rust}")
    // A compound field write borrows the ViewMut element once and updates it;
    // no cloned temporary may stand between the target and its owner.
    assert(out.rust.contains("&mut (__jet_dune)[0i64 as usize].__jet_pages"), "field write must assign through the ViewMut element, not a cloned temporary: {out.rust}")
    assert(!out.rust.contains("(__jet_dune).clone()"), "the write must not go through a cloned view: {out.rust}")
}

// Rust: tests/ownership.rs:3260
#Test("owner_backed_collection_rejects_resize_while_view_live") {
    src :: "\nstruct Book {{\n    title: String,\n    pages: Int\n}}\n\nstruct Library {{\n    books: [Book]\n}}\n\nfn book_at(lib: Library, i: Int) -> View<Book> {{ lib.books[i..i] }}\n\nfn run() {{\n    lib := Library{{\n        books: [\n            Book{{ title: \"Dune\", pages: 412 }},\n            Book{{ title: \"Neuromancer\", pages: 271 }}\n        ]\n    }}\n    first :: book_at(lib, 0)\n    &lib.books.push(Book{{ title: \"Snow Crash\", pages: 480 }})\n    print(first[0].title)\n}}\n"
    diags :: compile(src).expect_err("resize while view live must fail")
    assert(diags.iter().any(|d| -> d.code == "E0212"), "expected E0212, got {diags:?}")
}

// Rust: tests/ownership.rs:3295
// #1163 / #1164: plain owned String is not a tracked View<str>.
#Test("owner_backed_collection_rejects_plain_string_as_view_str_field") {
    src :: "\nstruct Book {{\n    title: String,\n    pages: Int\n}}\n\nstruct Library {{\n    books: [Book]\n}}\n\nstruct TitleView {{\n    value: View<str>\n}}\n\nfn first_title(lib: Library) -[]> TitleView {{\n    value :: lib.books[0].title\n    return TitleView{{ value: value }}\n}}\n\nfn run() {{\n    lib :: Library{{\n        books: [Book{{ title: \"Dune\", pages: 412 }}]\n    }}\n    print(first_title(lib).value)\n}}\n"
    diags :: compile(src).expect_err("plain String into View<str> must fail")
    e2307 :: diags.iter().filter(|d| -> d.code == "E2307").collect()
    assert_eq(e2307.len(), 1, "expected one E2307, got {diags:?}")
    assert(e2307[0].what.contains("owned `String` cannot fill a `View<str>`"), "teaching must name the owned-String ceiling, got {e2307[0]:?}")
    assert(e2307[0].why.contains(".trim()") || e2307[0].fix.contains(".trim()"), "fix must teach trim/after/before or element View, got {e2307[0]:?}")
}

// Rust: tests/ownership.rs:3342
// Aggregate and direct return paths must not duplicate E2305.
#Test("local_owned_view_return_reports_e2305_once") {
    src :: "\nfn make() -[]> View<Int> {{\n    incidents := [Int]{{1, 2, 3, 4, 5}}\n    return incidents[0..2]\n}}\n\nfn run() {{\n    make()\n    print(0)\n}}\n"
    diags :: compile(src).expect_err("local-owned view return must fail")
    e2305 :: diags.iter().filter(|d| -> d.code == "E2305").collect()
    assert_eq(e2305.len(), 1, "expected exactly one E2305, got {diags:?}")
    assert(e2305[0].what.contains("this function owns"), "expected owns-return teaching, got {e2305[0]:?}")
}

