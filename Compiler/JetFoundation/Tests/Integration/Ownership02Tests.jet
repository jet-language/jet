// Rust: tests/ownership.rs:3532
#Test("range_window_checks_bounds_before_borrowing") {
    src :: "\nfn run() {{\n    xs := [1, 2]\n    window :: xs[0..1]\n    print(window.len())\n}}\n"
    out :: compile(src).expect("range window must compile")
    check :: out.rust.find(" = jet_view_range_new").expect("view helper call")
    helper :: out.rust.find("fn jet_view_range_new").expect("view helper definition")
    assert(helper < check, "bounds-checking helper must exist before use")
    // AOT, resident JIT and interpreter share window -> bounds -> range policy.
    // The bounds check is inside the helper and must precede its borrow.
    assert(out.rust.contains("fn jet_checked_view_bounds"), "the shared view-bounds rule must be emitted: {out.rust}")
    helper_body :: out.rust[helper..]
    bounds :: helper_body.find("jet_checked_view_window(").expect("the view helper must check bounds")
    borrow :: helper_body.find("&xs[start as usize..end as usize]").expect("the view helper must borrow the checked window")
    assert(bounds < borrow, "bounds must be checked before the window is borrowed: {out.rust}")
}

