// Rust: tests/ownership.rs:2790
#Test("write_windows_edit_whole_field_and_index_places") {
    src :: "\nstruct Slot {{ value: Int }}\nfn run() {{\n    whole := 1\n    whole_edit :: &whole\n    whole_edit = 2\n\n    cell := Slot{{ value: 3 }}\n    field_edit :: &cell.value\n    field_edit = 4\n\n    xs := [5, 6]\n    index_edit :: &xs[0]\n    index_edit = 7\n    print(whole + cell.value + xs[0])\n}}\n"
    out :: compile(src).expect("write windows must write through to each owner place")
    assert(out.rust.contains("(*__jet_whole_edit) = 2i64"), "{out.rust}")
    assert(out.rust.contains("(*__jet_field_edit) = 4i64"), "{out.rust}")
    assert(out.rust.contains("(*__jet_index_edit) = 7i64"), "{out.rust}")
}

// Rust: tests/ownership.rs:2827
#Test("named_write_windows_forward_to_helpers_and_mutate_owners") {
    src :: "\nstruct Slot {{ value: Int }}\n\nfn bump(value: &Int, amount: Int) {{\n    value += amount\n}}\n\nfn inspect(first: Slot, second: Slot) {{\n    print(first.value + second.value)\n}}\n\nfn run() {{\n    whole := 1\n    whole_window :: &whole\n    bump(&whole_window, 2)\n\n    slot := Slot{{ value: 3 }}\n    field_window :: &slot.value\n    bump(&field_window, 4)\n\n    values := [5, 6]\n    index_window :: &values[0]\n    bump(&index_window, 6)\n\n    read_slot := Slot{{ value: 9 }}\n    read_window :: &read_slot\n    inspect(read_window, read_window)\n\n    print(whole)\n    print(slot.value)\n    print(values[0])\n}}\n"
    _ :: compile(src).expect("named write windows must forward to helpers")
    expected :: "3\n7\n11\n18\n"
    assert(common.have_rustc(), "named write-window forwarding requires the AOT proof toolchain")
    tir_support.assert_tiers_agree("named_write_window_forward", src, expected)
    tir_support.assert_awaited_web_tier("named_write_window_forward", src, expected)
}

// Rust: tests/ownership.rs:2872
#Test("named_write_window_calls_keep_alias_and_read_view_checks") {
    overlapping :: "\nfn both(first: &Int, second: Int) {{\n    first += second\n}}\n\nfn run() {{\n    value := 1\n    window :: &value\n    both(&window, value)\n}}\n"
    diags :: compile(overlapping).expect_err("same-call named-window alias must fail")
    assert(diags.iter().any(|diag| -> diag.code == "E0204"), "expected E0204 for an overlapping named-window call: {diags:?}")
    read_view :: "\nfn bump(value: &Int) {{\n    value += 1\n}}\n\nfn run() {{\n    values := [1, 2]\n    read :: values[0]\n    bump(&read)\n}}\n"
    read_diags :: compile(read_view).expect_err("a read view cannot enter a write helper")
    assert(read_diags.iter().any(|diag| -> diag.code == "E0212"), "expected E0212 for a write through a read view: {read_diags:?}")
}

// Rust: tests/ownership.rs:2909
#Test("named_write_window_call_preserves_scoped_loan_rejection") {
    src :: "\nfn bump(value: &Int) {{\n    value += 1\n}}\n\nfn run() {{\n    values := [1]\n    task.group g {{\n        edit :: &values[0]\n        child :: task {{ edit }}\n        bump(&edit)\n    }}\n}}\n"
    diags :: compile(src).expect_err("a scoped loan must outlive the named write call")
    diagnostic :: diags.iter().find(|diag| -> diag.code == "E1101").expect("expected the scoped-loan diagnostic")
    assert(diagnostic.what.contains("cannot be passed with write access"), "the protected call change must be the reported action: {diagnostic:?}")
}

// Rust: tests/ownership.rs:2936
#Test("write_window_requires_mutable_owner_or_write_parameter") {
    local :: "\nfn run() {{\n    xs :: [1, 2]\n    edit :: &xs[0]\n    print(edit)\n}}\n"
    diags :: compile(local).expect_err("immutable local must reject write window")
    assert(diags.iter().any(|d| -> d.code == "E0202"), "{diags:?}")
    parameter :: "\nfn edit(xs: [Int]) {{\n    window :: &xs[0]\n    print(window)\n}}\nfn run() {{ print(0) }}\n"
    parameter_diags :: compile(parameter).expect_err("read parameter must reject write window")
    assert(parameter_diags.iter().any(|d| -> d.code == "E0205"), "{parameter_diags:?}")
}

