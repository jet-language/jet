use jet_foundation.Tests.Integration.Common as common
use jet_foundation.Tests.Integration.TirSupport as tir_support
use jet.[compile, compile_with_path]
use std.fs
use std.process.Command

// Rust: tests/ownership.rs:1812
#Test("whole_place_alias_blocks_overlapping_write_argument") {
    src :: "\nfn both(a: &[Int], b: [Int]) {{\n    a[0] = b[0]\n}}\n\nfn run() {{\n    xs := [1, 2, 3]\n    alias :: xs\n    both(&xs, alias)\n}}\n"
    diags :: compile(src).expect_err("whole-place read alias must fail in sema before rustc")
    diag :: diags.iter().find(|diag| -> diag.code == "E0204")
    assert(diag.is_some(), "expected the call-alias diagnostic: {diags:?}")
    diagnostic :: diag.unwrap()
    assert(diagnostic.what.starts_with("`xs`"), "the alias must resolve through the view fact graph to its owner: {diagnostic:?}")
}

// Rust: tests/ownership.rs:1839
#Test("rustc_oracle_rejects_the_hostile_borrow_shapes") {
    if !common.have_rustc() { return }
    root :: common.unique_tmp("jet_call_place_rustc_oracle")
    fs.create_dir_all(&root).unwrap()
    cases :: [
        ("nested.rs", "\nfn see(x: i64) -> i64 {{ x }}\nfn both(a: &mut i64, b: i64) {{ *a += b }}\nfn main() {{\n    let mut x = 1;\n    both(&mut x, see(x));\n}}\n", "E0503"),
        ("alias.rs", "\nfn both(a: &mut Vec<i64>, b: &Vec<i64>) {{ a[0] = b[0] }}\nfn main() {{\n    let mut xs = vec![1, 2, 3];\n    let alias = &xs;\n    both(&mut xs, alias);\n}}\n", "E0502"),
        ("lambda.rs", "\nfn both<F: FnOnce() -> String>(a: &mut String, callback: F) {{\n    println!(\"{{a}}\");\n    println!(\"{{}}\", callback());\n}}\nfn main() {{\n    let mut x = String::from(\"jet\");\n    both(&mut x, move || x);\n}}\n", "E0505"),
        ("constructor.rs", "\nstruct Pair<T>(T);\nimpl<T> Pair<T> {{\n    fn new(_first: &mut T, second: T) -> Self {{ Self(second) }}\n}}\nfn see(value: i64) -> i64 {{ value }}\nfn main() {{\n    let mut x = 1;\n    let _ = Pair::new(&mut x, see(x));\n}}\n", "E0503"),
        ("mutable_capture_lifetime.rs", "\nfn both<F: FnMut()>(mut callback: F, values: &Vec<i64>) {{\n    callback();\n    println!(\"{{}}\", values.len());\n}}\nfn main() {{\n    let mut values = vec![1, 2];\n    both(|| values.push(3), &values);\n}}\n", "E0502"),
        ("composite_lambda.rs", "\nstruct Work<F> {{ callback: F }}\nfn both<F: Fn() -> usize>(values: &mut Vec<i64>, work: Work<F>) {{\n    values.push((work.callback)() as i64);\n}}\nfn main() {{\n    let mut values = vec![1, 2];\n    both(&mut values, Work {{ callback: move || values.len() }});\n}}\n", "E0505"),
        ("immediate_lambda_callee.rs", "\nfn both(values: &mut Vec<i64>, count: usize) {{ &values.push(count as i64) }}\nfn main() {{\n    let mut values = vec![1, 2];\n    both(&mut values, (move || values.len())());\n}}\n", "E0505"),
        ("conflicting_capture_field.rs", "\nstruct Pair {{ left: Vec<i64>, right: Vec<i64> }}\nfn both<F: FnMut()>(mut callback: F, values: &Vec<i64>) {{\n    callback();\n    println!(\"{{}}\", values.len());\n}}\nfn main() {{\n    let mut pair = Pair {{ left: vec![1], right: vec![2] }};\n    both(|| pair.right.push(3), &pair.right);\n}}\n", "E0502"),
        ("builtin_receiver.rs", "\nfn main() {{\n    let mut values = vec![1, 2];\n    values.insert(0, values.remove(0));\n}}\n", "E0499"),
        ("if_prefix_write.rs", "\nfn both(values: &Vec<i64>, count: i64) {{ println!(\"{{}}\", values.len() as i64 + count) }}\nfn main() {{\n    let mut values = vec![1, 2];\n    both(&values, {{ values = vec![3]; 1 }});\n}}\n", "E0506"),
        ("transitive_lambda.rs", "\nfn both<F, G>(value: &mut String, callback: F)\nwhere F: FnOnce() -> G, G: FnOnce() -> String\n{{\n    println!(\"{{value}}\");\n    println!(\"{{}}\", callback()());\n}}\nfn main() {{\n    let mut value = String::from(\"jet\");\n    both(&mut value, move || move || value);\n}}\n", "E0505"),
        ("eager_helper_receiver.rs", "\nfn advance(clock: &mut i64, to: i64) {{ *clock = to; }}\nfn now(clock: &i64) -> i64 {{ *clock }}\nfn main() {{\n    let mut clock = 0;\n    advance(&mut clock, now(&clock));\n}}\n", "E0502"),
        ("eager_sort_capture.rs", "\nfn sort_by<F: Fn(i64) -> i64>(values: &mut Vec<i64>, key: F) {{\n    values.sort_by_key(|value| key(*value));\n}}\nfn main() {{\n    let mut values = vec![2, 1];\n    sort_by(&mut values, |value| value + values.len() as i64);\n}}\n", "E0502"),
        ("wrapped_returned_view.rs", "\nfn first(values: &Vec<i64>) -> &[i64] {{ &values[0..1] }}\nfn both(view: &[i64], values: &mut Vec<i64>) {{ &values.push(view[0]); }}\nfn main() {{\n    let mut values = vec![1, 2];\n    both((first(&values)), &mut values);\n}}\n", "E0502"),
        ("pattern_value_capture.rs", "\nstruct Incident {{ count: usize }}\nfn both<F: FnMut()>(values: &mut Vec<i64>, mut callback: F) {{\n    values.push(3);\n    callback();\n}}\nfn main() {{\n    let mut values = vec![1, 2];\n    let mut changed = vec![0];\n    let incident = Incident {{ count: 2 }};\n    both(&mut values, || {{\n        changed.push(1);\n        if incident.count == values.len() {{}}\n    }});\n}}\n", "E0502"),
        ("reactive_whole_root_clone.rs", "\n#[derive(Clone)]\nstruct Pair {{ left: Vec<i64>, right: Vec<i64> }}\nfn both<F: FnMut()>(values: &mut Vec<i64>, mut callback: F) {{\n    values.push(3);\n    callback();\n}}\nfn main() {{\n    let mut pair = Pair {{ left: vec![1], right: vec![2] }};\n    let mut changed = vec![0];\n    both(&mut pair.right, || {{\n        changed.push(1);\n        let captured_pair = pair.clone();\n        let _effect = move || println!(\"{{}}\", captured_pair.left.len());\n    }});\n}}\n", "E0502"),
        ("move_capture_before_read.rs", "\nfn both<F: Fn() -> usize>(callback: F, values: &Vec<i64>) {{\n    println!(\"{{}} {{}}\", callback(), values.len());\n}}\nfn main() {{\n    let values = vec![1, 2];\n    both(move || values.len(), &values);\n}}\n", "E0382"),
        ("read_before_move_capture.rs", "\nfn both<F: Fn() -> usize>(values: &Vec<i64>, callback: F) {{\n    println!(\"{{}} {{}}\", values.len(), callback());\n}}\nfn main() {{\n    let values = vec![1, 2];\n    both(&values, move || values.len());\n}}\n", "E0505"),
        ("same_move_capture_field.rs", "\nstruct Pair {{ left: String, right: Vec<i64> }}\nfn both<F: Fn()>(callback: F, text: String) {{ callback(); println!(\"{{text}}\"); }}\nfn main() {{\n    let pair = Pair {{ left: \"jet\".to_string(), right: vec![1] }};\n    both(move || println!(\"{{}}\", pair.left), pair.left);\n}}\n", "E0382"),
        ("captured_view_vs_write.rs", "\nfn both<F: Fn()>(values: &mut Vec<i64>, callback: F) {{ &values.push(3); callback(); }}\nfn main() {{\n    let mut values = vec![1, 2];\n    let first = &values[0..1];\n    both(&mut values, move || println!(\"{{}}\", first.len()));\n}}\n", "E0502"),
        ("captured_view_vs_later_write.rs", "\nfn both<F: Fn() -> usize>(callback: F, values: &mut Vec<i64>) {{\n    values.push(callback() as i64);\n}}\nfn main() {{\n    let mut values = vec![1, 2];\n    let first = &values[0..1];\n    both(move || first.len(), &mut values);\n}}\n", "E0502"),
        ("indexed_move_capture.rs", "\nfn call<F: Fn()>(callback: F) {{ callback(); }}\nfn main() {{\n    let values = vec![1, 2];\n    call(move || println!(\"{{}}\", values[0]));\n    println!(\"{{}}\", values.len());\n}}\n", "E0382"),
        ("sliced_move_capture.rs", "\nfn call<F: Fn()>(callback: F) {{ callback(); }}\nfn main() {{\n    let values = vec![1, 2];\n    call(move || println!(\"{{}}\", values[0..1].len()));\n    println!(\"{{}}\", values.len());\n}}\n", "E0382"),
        ("if_prefix.rs", "\nfn both(value: &mut i64, count: i64) {{ *value += count }}\nfn main() {{\n    let mut value = 1;\n    both(&mut value, if true {{ let seen = value; seen }} else {{ 0 }});\n}}\n", "E0503"),
        ("composite_receiver.rs", "\nfn both(value: &mut i64, count: usize) {{ *value += count as i64 }}\nfn main() {{\n    let mut value = 1;\n    both(&mut value, vec![value].len());\n}}\n", "E0503"),
        ("dynamic_index.rs", "\nfn both(index: &mut usize, value: i64) {{ *index += value as usize }}\nfn main() {{\n    let values = [10, 20];\n    let mut index = 0;\n    both(&mut index, values[index]);\n}}\n", "E0503"),
        ("slice_bound.rs", "\nfn both(end: &mut usize, values: &[i64]) {{ *end += values.len() }}\nfn main() {{\n    let values = [10, 20];\n    let mut end = 1;\n    both(&mut end, &values[0..end]);\n}}\n", "E0503")
    ]
    for (name, source, expected) in cases {
        path :: root.join(name)
        fs.write(&path, source).unwrap()
        // GATE #4494: native process invocation retained for the independent rustc oracle.
        output :: Command.new("rustc").arg("--edition=2021").arg(&path).arg("-o").arg(root.join("{name}.bin")).output().unwrap()
        stderr :: String.from_utf8_lossy(&output.stderr)
        assert(!output.status.success() && stderr.contains(expected), "native oracle must reject {name} with {expected}: {stderr}")
    }
}

// Rust: tests/ownership.rs:2222
#Test("rustc_oracle_accepts_move_copy_and_disjoint_field_captures") {
    if !common.have_rustc() { return }
    root :: common.unique_tmp("jet_call_place_rustc_positive_oracle")
    fs.create_dir_all(&root).unwrap()
    cases :: [
        ("copy_move.rs", "\nfn both<F: Fn() -> i64>(callback: F, value: &mut i64) {{ *value += callback() }}\nfn main() {{\n    let mut value = 1;\n    both(move || value, &mut value);\n}}\n"),
        ("disjoint_field.rs", "\nstruct Pair {{ left: Vec<i64>, right: Vec<i64> }}\nfn both<F: FnMut()>(mut callback: F, values: &Vec<i64>) {{\n    callback();\n    println!(\"{{}}\", values.len());\n}}\nfn main() {{\n    let mut pair = Pair {{ left: vec![1], right: vec![2] }};\n    both(|| pair.right.push(3), &pair.left);\n}}\n"),
        ("two_phase_receiver.rs", "\nfn main() {{\n    let mut values = vec![1_i64, 2];\n    values.push(values.len() as i64);\n}}\n"),
        ("mixed_projection_capture.rs", "\nstruct Pair {{ left: Vec<i64>, right: Vec<i64> }}\nfn both<F: FnMut()>(mut callback: F, values: &Vec<i64>) {{\n    callback();\n    println!(\"{{}}\", values.len());\n}}\nfn main() {{\n    let mut pair = Pair {{ left: vec![1], right: vec![2] }};\n    both(|| {{\n        println!(\"{{}}\", pair.left.len());\n        pair.right.push(3);\n    }}, &pair.left);\n}}\n"),
        ("move_owned_field.rs", "\nstruct Pair {{ left: String, right: Vec<i64> }}\nfn both<F: Fn()>(callback: F, values: Vec<i64>) {{ callback(); println!(\"{{}}\", values.len()); }}\nfn main() {{\n    let pair = Pair {{ left: \"jet\".to_string(), right: vec![1] }};\n    both(move || println!(\"{{}}\", pair.left), pair.right);\n}}\n"),
        ("copy_field_owner.rs", "\nstruct Pair {{ count: i64, values: Vec<i64> }}\nfn both<F: Fn()>(callback: F, pair: Pair) {{ callback(); println!(\"{{}}\", pair.count); }}\nfn main() {{\n    let pair = Pair {{ count: 2, values: vec![1] }};\n    both(move || println!(\"{{}}\", pair.count), pair);\n}}\n"),
        ("view_alias_capture.rs", "\nfn call<F: Fn()>(callback: F) {{ callback(); }}\nfn main() {{\n    let values = vec![1, 2];\n    let first = &values[0..1];\n    call(move || println!(\"{{}}\", first.len()));\n    println!(\"{{}}\", values.len());\n}}\n"),
        ("indexed_disjoint_field.rs", "\nstruct Pair {{ left: Vec<i64>, right: Vec<i64> }}\nfn call<F: Fn()>(callback: F) {{ callback(); }}\nfn main() {{\n    let pair = Pair {{ left: vec![1], right: vec![2] }};\n    call(move || println!(\"{{}}\", pair.left[0]));\n    println!(\"{{}}\", pair.right.len());\n}}\n")
    ]
    for (name, source) in cases {
        path :: root.join(name)
        fs.write(&path, source).unwrap()
        // GATE #4494: native process invocation retained for the independent rustc oracle.
        output :: Command.new("rustc").arg("--edition=2021").arg(&path).arg("-o").arg(root.join("{name}.bin")).output().unwrap()
        assert(output.status.success(), "native oracle must accept {name}: {String.from_utf8_lossy(&output.stderr)}")
    }
}

// Rust: tests/ownership.rs:2345
#Test("imported_call_uses_the_same_place_access_rule") {
    root :: common.unique_tmp("jet_imported_call_place_access")
    fs.create_dir_all(&root).unwrap()
    fs.write(root.join("helper.jet"), "pub fn both(a: &Int, b: Int) {{ a += b }}\n").unwrap()
    entry :: root.join("main.jet")
    src :: "\nuse \"./helper\" as helper\n\nfn run() {{\n    x := 1\n    helper.both(&x, x)\n}}\n"
    fs.write(&entry, src).unwrap()
    diags :: compile_with_path(src, entry.to_str().unwrap()).expect_err("imported call alias must fail in sema before rustc")
    assert(diags.iter().any(|diag| -> diag.code == "E0204"), "expected the call-alias diagnostic: {diags:?}")
}

// Rust: tests/ownership.rs:2372
#Test("generic_method_trait_and_function_value_calls_share_place_access") {
    hostile :: [
        "\nfn both<T>(a: &T, b: T) {{ print(0) }}\nfn run() {{\n    value := 1\n    both(&value, value)\n}}\n",
        "\nstruct Editor {{ id: Int }}\nimpl Editor {{\n    fn clash(self, other: &Editor) {{ print(other.id) }}\n}}\nfn run() {{\n    editor := Editor{{ id: 1 }}\n    editor.clash(&editor)\n}}\n",
        "\ntrait Edit {{\n    fn clash(self, other: &Edit)\n}}\nfn conflict(editor: &Edit) {{\n    editor.clash(&editor)\n}}\nfn run() {{}}\n",
        "\nfn length(value: String) -[]> Int {{ return value.len() }}\nfn both(value: &String, count: Int) {{\n    print(value)\n    print(count)\n}}\nfn run() {{\n    callback :: length\n    value := \"hello\"\n    both(&value, callback(value))\n}}\n",
        "\nmodule helper {{\n    pub fn both(a: &Int, b: Int) {{ a += b }}\n}}\nfn run() {{\n    value := 1\n    helper.both(&value, value)\n}}\n"
    ]
    for src in hostile {
        diags :: compile(src).expect_err("every call form must reject one aliased place")
        assert(diags.iter().any(|diag| -> diag.code == "E0204"), "expected the shared call-place diagnostic: {diags:?}")
    }
}

// Rust: tests/ownership.rs:2432
#Test("trait_object_mut_self_calls_use_receiver_change_rules_inside_callbacks") {
    rejected :: "\ntrait Edit {{\n    fn change(&self)\n}}\nfn call(callback: fn()) {{ callback() }}\nfn invoke(editor: Edit) {{\n    call(() -> {{ editor.change() }})\n}}\nfn run() {{}}\n"
    diags :: compile(rejected).expect_err("a trait-object mut-self callback capture needs edit access")
    assert(diags.iter().any(|diag| -> diag.code == "E0202"), "{diags:?}")
    accepted :: "\ntrait Edit {{\n    fn change(&self)\n}}\nfn call(callback: fn()) {{ callback() }}\nfn invoke(editor: &Edit) {{\n    call(() -> {{ editor.change() }})\n}}\nfn run() {{}}\n"
    _ :: compile(accepted).expect("an editable trait-object callback capture is valid")
}

// Rust: tests/ownership.rs:2461
#Test("multi_trait_receiver_access_follows_first_match_dispatch_order") {
    read_first :: "\ntrait Inspect {{\n    fn touch(self)\n}}\ntrait Edit {{\n    fn touch(&self)\n}}\nfn call(callback: fn()) {{ callback() }}\nfn inspect_all(items: ...[Inspect, Edit]) {{\n    loop item in items {{\n        call(() -> {{ item.touch() }})\n    }}\n}}\nfn run() {{}}\n"
    _ :: compile(read_first).expect("the first matching read-self method controls dispatch and capture access")
    write_first :: "\ntrait Inspect {{\n    fn touch(self)\n}}\ntrait Edit {{\n    fn touch(&self)\n}}\nfn call(callback: fn()) {{ callback() }}\nfn edit_all(items: ...[Edit, Inspect]) {{\n    loop item in items {{\n        call(() -> {{ item.touch() }})\n    }}\n}}\nfn run() {{}}\n"
    diags :: compile(write_first).expect_err("the first matching write-self method needs edit access")
    assert(diags.iter().any(|diag| -> diag.code == "E0202"), "{diags:?}")
}

// Rust: tests/ownership.rs:2501
#Test("implicit_borrows_persist_but_finished_scalar_reads_do_not") {
    borrowed :: "\nfn inspect_then_edit(values: [Int], edited: &[Int]) {{ print(values.len() + edited.len()) }}\nfn run() {{\n    values := [1, 2, 3]\n    inspect_then_edit(values, &values)\n}}\n"
    diags :: compile(borrowed).expect_err("implicit read borrow must remain active")
    assert(diags.iter().any(|diag| -> diag.code == "E0204"), "{diags:?}")
    ordered :: "\nfn read_then_edit(value: Int, edited: &Int) {{ edited += value }}\nfn run() {{\n    value := 1\n    read_then_edit(value, &value)\n}}\n"
    _ :: compile(ordered).expect("a completed scalar read may precede a write borrow")
}

// Rust: tests/ownership.rs:2523
#Test("call_access_frames_do_not_leak_across_control_flow_or_disjoint_places") {
    src :: "\nfn both(a: &Int, b: Int) {{ a += b }}\nfn run() {{\n    left := 1\n    right := 2\n    if true {{\n        both(&left, right)\n    }}\n    both(&right, left)\n}}\n"
    _ :: compile(src).expect("separate calls on disjoint places must not share access frames")
}

// Rust: tests/ownership.rs:2542
// E0209 remains a hard error; live-after values get the reorder/copy menu.
#Test("implicit_clone_errors_with_reorder_menu_when_live_after_call") {
    src :: "\nfn consume(s: ^String) {{\n    print(s)\n}}\n\nfn run() {{\nmsg :: \"hello\"\n    consume(msg)\n    print(msg)\n}}\n"
    diags :: compile(src).expect_err("should error")
    d :: diags.iter().find(|d| -> d.code == "E0209").expect("expected E0209 implicit-clone hard error")
    assert(d.fix.contains("reorder"), "live-after fix menu should suggest reordering, got: {d.fix}")
}

// Rust: tests/ownership.rs:2569
// At last use, the fix menu can safely lead with the move sigil.
#Test("implicit_clone_errors_with_move_menu_when_dead_after_call") {
    src :: "\nfn consume(s: ^String) {{\n    print(s)\n}}\n\nfn run() {{\nmsg :: \"hello\"\n    consume(msg)\n}}\n"
    diags :: compile(src).expect_err("should error")
    d :: diags.iter().find(|d| -> d.code == "E0209").expect("expected E0209 implicit-clone hard error")
    assert(d.fix.contains("^msg"), "dead-after fix menu should lead with `^msg`, got: {d.fix}")
}

// Rust: tests/ownership.rs:2593
#Test("deref_outside_unsafe_is_error") {
    src :: "\nfn run() {{\nx :: 1\n    print(*x)\n}}\n"
    diags :: compile(src).expect_err("should error")
    assert(diags.iter().any(|d| -> d.code == "E0208"))
}

// Rust: tests/ownership.rs:2611
// Liveness includes the enclosing block, not just the current block's tail.
#Test("implicit_clone_uses_reorder_menu_when_live_in_enclosing_block") {
    src :: "\nfn consume(s: ^String) {{\n    print(s)\n}}\n\nfn maybe(b: Bool) -[]> Bool {{ return b }}\n\nfn run() {{\nmsg :: \"hello\"\n    if maybe(true) {{\n        consume(msg)\n    }}\n    print(msg)\n}}\n"
    diags :: compile(src).expect_err("should error")
    d :: diags.iter().find(|d| -> d.code == "E0209").expect("expected E0209 implicit-clone hard error")
    assert(d.fix.contains("reorder"), "live-in-enclosing-block fix menu should suggest reordering, got: {d.fix}")
}

// Rust: tests/ownership.rs:2643
#Test("implicit_clone_uses_move_menu_when_dead_in_all_enclosing_blocks") {
    src :: "\nfn consume(s: ^String) {{\n    print(s)\n}}\n\nfn maybe(b: Bool) -[]> Bool {{ return b }}\n\nfn run() {{\nmsg :: \"hello\"\n    if maybe(true) {{\n        consume(msg)\n    }}\n}}\n"
    diags :: compile(src).expect_err("should error")
    d :: diags.iter().find(|d| -> d.code == "E0209").expect("expected E0209 implicit-clone hard error")
    assert(d.fix.contains("^msg"), "dead-in-all-enclosing-blocks fix menu should lead with `^msg`, got: {d.fix}")
}

// Rust: tests/ownership.rs:2673
// D-MEM1 S9 / #649: a read view prevents moving its owner.
#Test("moving_list_owner_with_live_view_is_error") {
    src :: "\nfn consume(xs: ^[Int]) {{\n    print(xs.len())\n}}\n\nfn run() {{\n    xs := [1, 2, 3]\n    window :: xs[0..1]\n    consume(^xs)\n    print(window.len())\n}}\n"
    diags :: compile(src).expect_err("moving a viewed owner must fail")
    assert(diags.iter().any(|d| -> d.code == "E0212"))
}

// Rust: tests/ownership.rs:2693
// D-SHAPE-PLACE1=A: a bare range place is a read window.
#Test("moving_list_owner_with_bare_range_window_is_error") {
    src :: "\nfn consume(xs: ^[Int]) {{\n    print(xs.len())\n}}\n\nfn run() {{\n    xs := [1, 2, 3]\n    window :: xs[0..1]\n    consume(^xs)\n    print(window.len())\n}}\n"
    diags :: compile(src).expect_err("moving a windowed owner must fail")
    assert(diags.iter().any(|d| -> d.code == "E0212"), "got {diags:?}")
}

// Rust: tests/ownership.rs:2713
// Exclusive write windows conflict with overlapping read windows.
#Test("write_range_window_conflicts_with_overlapping_read_window") {
    src :: "\nfn run() {{\n    xs := [1, 2, 3]\n    edit :: &xs[0..1]\n    read :: xs[1..2]\n    print(edit.len() + read.len())\n}}\n"
    diags :: compile(src).expect_err("overlapping write/read windows must fail")
    assert(diags.iter().any(|d| -> d.code == "E0212"), "got {diags:?}")
}

// Rust: tests/ownership.rs:2727
#Test("bare_range_window_lowers_without_copy") {
    src :: "\nfn run() {{\n    xs :: [1, 2, 3]\n    band :: 0..1\n    window :: xs[band]\n    print(window[1])\n}}\n"
    out :: compile(src).expect("bare range window must compile")
    assert(out.rust.contains("let __jet_window = jet_view_range_new"), "range acquisition must lower to a view: {out.rust}")
}

// Rust: tests/ownership.rs:2745
#Test("whole_place_window_lowers_as_borrow") {
    src :: "\nfn run() {{\n    xs :: [1, 2, 3]\n    all :: xs\n    print(all.len())\n}}\n"
    out :: compile(src).expect("whole place window must compile")
    assert(out.rust.contains("let __jet_all = &(__jet_xs)"), "{out.rust}")
}

// Rust: tests/ownership.rs:2762
#Test("copied_range_is_owned_and_does_not_borrow_owner") {
    src :: "\nfn run() {{\n    xs := [1, 2, 3]\n    copied :: ~xs[0..1]\n    &xs.push(4)\n    print(copied.len() + xs.len())\n}}\n"
    _ :: compile(src).expect("`~range` must stay an independent owned copy")
}

// Rust: tests/ownership.rs:2775
#Test("write_range_window_edits_owner") {
