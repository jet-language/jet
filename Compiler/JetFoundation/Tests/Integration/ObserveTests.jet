    (_code, _stdout, stderr) :: build_and_run_debug("log_escape", src)
    line :: stderr.lines().find(|l| -> l.starts_with('{')).expect("no log line")
    assert(line.contains("\\\"hello\\\""), "quotes not escaped in: {line}")
}
// Rust: tests/observe.rs:219
#Test("rich_panic_shows_jet_location") {
    if !common.have_rustc() { return }
    src :: "\nfn check(n: Int) {{\n    assert(n > 0, \"must be positive\")\n}}\nfn run() {{\n    check(0)\n}}\n"
    for (tier, (code, _stdout, stderr)) in [
        ("native", build_and_run_debug("rich_panic", src)),
        ("default", tir_support.jit_run("rich_panic", src)),
        ("interpret", tir_support.interpreter_run("rich_panic", src))
    ] {
        assert_eq(code, 70, "{tier}: expected exit 70; stderr:\n{stderr}")
        assert(stderr.contains("Stop [E3001]: `panic: must be positive`\n"), "wrong panic header: {stderr}")
        assert(stderr.contains("in check"), "function name missing: {stderr}")
        assert(stderr.contains("assert(n > 0"), "source line missing: {stderr}")
        assert(stderr.contains('^'), "caret missing: {stderr}")
        assert(!stderr.contains("thread 'main' panicked") && !stderr.contains("panicked at"), "raw Rust panic banner leaked: {stderr}")
    }
}
// Rust: tests/observe.rs:264
#Test("safe_locals_shown_in_dev_mode") {
    if !common.have_rustc() { return }
    src :: "\nfn capture(count: Int, active: Bool, name: String) {{\n    assert(count > 10, \"not enough\")\n}}\nfn run() {{\n    capture(3, true, \"test\")\n}}\n"
    (code, _stdout, stderr) :: build_and_run_debug("safe_locals", src)
    assert_eq(code, 70, "expected exit 70")
    assert(stderr.contains("Stop [E3001]"), "missing E3001 stop: {stderr}")
    assert(stderr.contains("count = 3"), "count not in locals: {stderr}")
    assert(stderr.contains("active = true"), "active not in locals: {stderr}")
    assert(!stderr.contains("name = "), "String local leaked into panic report: {stderr}")
}
// Rust: tests/observe.rs:306
#Test("panic_context_uses_only_lexically_live_locals") {
    if !common.have_rustc() { return }
    cases: [(String, String, [String])] :: [
        ("if_branch", "if live > 0 {{ branch_only :: 7; print(branch_only) }}", ["branch_only"]),
        ("region", "#Region(inner) {{ region_only :: 7; print(region_only) }}", ["region_only"]),
        ("counted_loop", "loop i in 0..<1 {{ counted_only :: 7; print(counted_only) }}", ["i", "counted_only"]),
        ("unsafe", "#Unsafe(\"scope audit\") {{ unsafe_only :: 7; print(unsafe_only) }}", ["unsafe_only"]),
        ("impure", "#Impure(\"scope audit\") {{ impure_only :: 7; print(impure_only) }}", ["impure_only"]),
        ("shield", "#Shield {{ shield_only :: 7; print(shield_only) }}", ["shield_only"]),
        ("authority", "#FX(IO) {{ authority_only :: 7; print(authority_only) }}", ["authority_only"]),
        ("grant", "#FX(authority: IO) {{ grant_only :: 7; print(grant_only) }}", ["grant_only"]),
        // #Nondeterministic is legal only inside #Pure, not this print/panic template.
        ("transact", "#Transact {{ transact_only :: 7; print(transact_only) }}", ["transact_only"]),
        ("context", "#Context(logger: 0) {{ context_only :: 7; print(context_only) }}", ["context_only"]),
        ("task.group", "task.group g {{ task_group_only :: 7; print(task_group_only) }}", ["task_group_only"])
    ]
    for (name, scoped_stmt, dead_names) in cases {
        src :: "\nfn missing() -> (Int?) {{ None }}\nfn capture(live: Int) {{\n    {scoped_stmt}\n    _value :: missing() ?? panic(\"missing value\")\n}}\nfn run() {{\n    capture(3)\n}}\n"
        test_name :: "panic_lexical_{name}"
        (code, _stdout, stderr) :: build_and_run_debug(&test_name, &src)
        assert_eq(code, 70, "{name}: expected Jet panic, not a rustc ICE: {stderr}")
        assert(stderr.contains("Stop [E3001]: `panic: missing value`\n"), "{name}: missing exact Jet panic report: {stderr}")
        assert(stderr.contains("live = 3"), "{name}: live local missing: {stderr}")
        for dead in dead_names { assert(!stderr.contains("{dead} ="), "{name}: out-of-scope local `{dead}` leaked: {stderr}") }
        assert(!stderr.contains("rustc") && !stderr.contains("internal compiler error"), "{name}: backend diagnostic escaped I2 handling: {stderr}")
    }
}
// Rust: tests/observe.rs:417
#Test("unsafe_block_locals_not_leaked") {
    // Safe environment includes copy scalars, never raw pointers or strings.
    if !common.have_rustc() { return }
    src :: "\nfn capture(secret: String, count: Int) {{\n    assert(count > 5, \"failed\")\n}}\nfn run() {{\n    capture(\"password123\", 1)\n}}\n"
    (_code, _stdout, stderr) :: build_and_run_debug("no_leak", src)
    assert(!stderr.contains("password"), "secret string leaked into panic: {stderr}")
    assert(stderr.contains("count = 1"), "scalar should appear: {stderr}")
}
