// Rust: tests/observe.rs:471
#Test("error_return_trace_frames") {
    if !common.have_rustc() { return }
    src :: "\nenum ParseError {{\n    Empty\n    BadDigit(String)\n}}\nfn parse_age(raw: String) -[]> Int ParseError! {{\n    if raw == \"\" {{\n        return Err(ParseError.Empty)\n    }}\n    return Ok(42)\n}}\nfn load(raw: String) -[]> Int ParseError! {{\n    n :: parse_age(raw)?(\"loading age\")\n    return Ok((n * 2))\n}}\nfn double(raw: String) -[]> Int ParseError! {{\n    n :: load(raw)?(\"doubling age\")\n    return Ok((n * 2))\n}}\nfn run() -> ParseError! {{\n    n :: double(\"\")\n    print(n)\n}}\n"
    (code, stdout, stderr) :: build_and_run_debug("error_trace", src)
    assert_eq(code, 1, "escaping failure must exit 1: {stderr}")
    assert(stdout.is_empty(), "nothing printed before the failure: {stdout}")
    (root, trail) :: stderr.split_once(" Trail [E3002] (").unwrap_or_else(|| -> panic("report must carry a trail block: {stderr}"))
    assert(!root.trim().is_empty(), "the root failure must lead the report: {stderr}")
    assert(trail.starts_with("3 hops via ?, origin first):\n"), "three propagation sites, none repeated: {stderr}")
    hops :: trail.lines().skip(1).collect()
    assert_eq(hops.len(), 3, "one hop per propagation site: {stderr}")
    assert(hops[0].starts_with("  1. load (") && hops[0].ends_with(") — loading age"), "innermost hop must be load with its note: {stderr}")
    assert(hops[1].starts_with("  2. double (") && hops[1].ends_with(") — doubling age"), "second hop must be double with its note: {stderr}")
    assert(hops[2].starts_with("  3. run (") && hops[2].ends_with(")"), "outermost hop must be run with no note: {stderr}")
}
// Rust: tests/observe.rs:542
#Test("try_note_interpolation_is_lazy_on_success") {
    if !common.have_rustc() { return }
    src :: "\nfn present() -> String {{ Ok(\"ok\") }}\nfn note_value() -[IO]> String {{\n    print(\"evaluated\")\n    return \"unexpected\"\n}}\nfn wrapped() -[IO]> String {{\n    value :: present()?(\"never {{note_value()}}\")\n    return Ok(value)\n}}\nfn run() {{\n    if wrapped() == {{\n        .Ok(value) -> {{ print(value) }}\n        .Err(_) -> {{ print(\"failed\") }}\n    }}\n}}\n"
    (code, stdout, stderr) :: build_and_run_debug("try_note_lazy", src)
    assert_eq(code, 0, "successful propagation should exit 0: {stderr}")
    assert_eq(stdout.trim(), "ok", "success note was evaluated: {stdout}")
}
// Rust: tests/observe.rs:571
#Test("fallback_handles_locally_and_context_preserves_the_structured_cause") {
    if !common.have_rustc() { return }
    src :: "\nfn fail() -> String {{ Err(\"outer\", code: \"E_OUTER\", cause: Err(\"root\")) }}\nfn pass_through() -[]> {{\n    _ :: fail()?(\"loading\")\n}}\nfn run() {{\n    recovered :: fail() ?? \"fallback\"\n    print(recovered)\n    _ :: pass_through()\n}}\n"
    (code, stdout, stderr) :: build_and_run_debug("fallback_context_cause", src)
    assert_eq(code, 1, "the second failure must escape: {stderr}")
    assert_eq(stdout.trim(), "fallback", "the first failure was not handled locally")
    assert(stderr.starts_with("Error [E_OUTER]: outer\n  cause: root\n"), "the structured error and nested cause must survive propagation: {stderr}")
    assert(stderr.contains("Trail [E3002] (2 hops via ?, origin first):\n"), "only the explicit context and outer propagation should be traced: {stderr}")
    assert(stderr.contains("  1. pass_through (") && stderr.contains(") — loading\n") && stderr.contains("  2. run ("), "the context must be one source-linked hop: {stderr}")
    assert_eq(stderr.matches(" — loading\n").count(), 1, "the context note must be evaluated exactly once: {stderr}")
}
// Rust: tests/observe.rs:616
#Test("default_report_keeps_conversion_identity_at_the_aot_edge") {
    if !common.have_rustc() { return }
    // #4409: preserve InvalidInput, IOContext and conversion identity.
    src :: "\nimpl IOError -> Err {{\n    return Err(\"store unavailable\", code: \"E_STORE\", cause: Err(\"disk offline\"))\n}}\n\nfn read_store() -> Int IOError! {{\n    return Err(IOError.InvalidInput(IOContext{{\n        operation: .Read,\n        resource: None,\n        os_code: None,\n        cause: Val(\"disk offline\"),\n    }}))\n}}\n\nfn get_user() -> Int {{\n    value :: read_store()?(\"loading store\")\n    return Ok(value)\n}}\n\nfn run() {{\n    value :: get_user()\n    print(value)\n}}\n"
    generated :: compile(src).expect("the converted default report must compile")
    assert(generated.rust.contains("jet_entry_error_exit_jet("), "the default Err must reach the edge as JetErr, not Display text")
    (code, stdout, stderr) :: build_and_run_debug("default_report_conversion", src)
    assert_eq(code, 1, "the converted failure must escape: {stderr}")
    assert(stdout.is_empty(), "the failure must not print to stdout: {stdout}")
    assert(stderr.starts_with("Error [E_STORE]: store unavailable (type: IOError)\n  cause: disk offline\n"), "the default report must keep code, message, typed identity, and cause: {stderr}")
    assert(stderr.contains("): loading store\n"), "the default report must keep the source-linked context frame: {stderr}")
    assert(stderr.contains("  conversion: IOError -> Err\n"), "the default report must keep conversion history: {stderr}")
    assert(stderr.contains("Trail [E3002] (2 hops via ?, origin first):") && stderr.contains("  1. get_user (") && stderr.contains("  2. run ("), "the default report must keep the source journey: {stderr}")
}
// Rust: tests/observe.rs:675
#Test("contextual_try_preserves_identity_cause_and_prior_context") {
    if !common.have_rustc() { return }
    src :: "\nimpl IOError -> Err {{\n    return Err(\"store unavailable\", code: \"E_STORE\", cause: Err(\"disk offline\"))\n}}\n\nfn read_store() -> String IOError! {{\n    return Err(IOError.InvalidInput(IOContext{{\n        operation: .Read,\n        resource: None,\n        os_code: None,\n        cause: Val(\"disk offline\"),\n    }}))\n}}\n\nfn load_store() -> String {{\n    value :: read_store()?(\"loading store\")\n    return value\n}}\n\nfn open_store() -> String {{\n    value :: load_store()?(\"opening store\")\n    return value\n}}\n\nfn run() {{\n    _ :: open_store()?(\"running store\")\n}}\n"
    (code, stdout, stderr) :: build_and_run_debug("contextual_try_preserves_error", src)
    assert_eq(code, 1, "the contextual failure must escape: {stderr}")
    assert(stdout.is_empty(), "the failure must not print stdout: {stdout}")
    assert(stderr.starts_with("Error [E_STORE]: store unavailable (type: IOError)\n  cause: disk offline\n"), "typed identity and cause were not preserved: {stderr}")
    inner :: stderr.find("context (").expect("inner context frame")
    middle_view := stderr[inner + 1..] // #4303
    middle :: middle_view.find("context (").map(|offset| -> inner + 1 + offset).expect("middle context frame")
    outer_view := stderr[middle + 1..] // #4303
    outer :: outer_view.find("context (").map(|offset| -> middle + 1 + offset).expect("outer context frame")
    inner_view := stderr[inner..] // #4303
    middle_context := stderr[middle..] // #4303
    outer_context := stderr[outer..] // #4303
    assert(inner_view.contains(": loading store") && middle_context.contains(": opening store") && outer_context.contains(": running store"), "context frames were not preserved in source order: {stderr}")
    assert(stderr.contains("conversion: IOError -> Err\n"), "conversion identity was lost: {stderr}")
}
// Rust: tests/observe.rs:738
#Test("uncaught_err_prints_propagation_chain") {
    if !common.have_rustc() { return }
    src :: "\nfn read_raw() -> String {{ Err(\"file not found\") }}\nfn parse_config() -[]> String {{\n    raw :: read_raw()?(\"reading raw config\")\n    return Ok(raw)\n}}\nfn load_config() -[]> String {{\n    cfg :: parse_config()?(\"loading config\")\n    return Ok(cfg)\n}}\nfn run() {{\n    _ :: load_config()\n}}\n"
    (code, _stdout, stderr) :: build_and_run_debug("error_trace_uncaught", src)
    assert_eq(code, 1, "uncaught Err must exit 1: {stderr}")
    assert(stderr.starts_with("Error: file not found\n"), "the root failure must be the first line: {stderr}")
    assert(stderr.contains(" Trail [E3002] (3 hops via ?, origin first):\n"), "missing the trail header: {stderr}")
    assert(stderr.contains("  1. parse_config (") && stderr.contains(") — reading raw config\n"), "missing parse_config hop with its note: {stderr}")
    assert(stderr.contains("  2. load_config (") && stderr.contains(") — loading config\n"), "missing load_config hop with its note: {stderr}")
    assert(stderr.contains("  3. run ("), "missing the entry hop: {stderr}")
}
// Rust: tests/observe.rs:785
#Test("propagation_trace_collapses_repeated_frames") {
    if !common.have_rustc() { return }
    src :: "\nfn dive(n: Int) -[]> Int {{\n    if n <= 0 {{\n        return Err(\"bottom\")\n    }}\n    v :: dive((n - 1))\n    return Ok(v)\n}}\nfn run() {{\n    v :: dive(4)\n    print(v)\n}}\n"
    (code, stdout, stderr) :: build_and_run_debug("error_trace_collapse", src)
    assert_eq(code, 1, "an escaping failure must exit 1: {stderr}")
    assert(stdout.is_empty(), "the failure precedes the print: {stdout}")
    dive_hops :: stderr.lines().filter(|line| -> line.contains(". dive (")).collect()
    assert_eq(dive_hops.len(), 1, "repeated dive hops must collapse to one line:\n{stderr}")
    assert(dive_hops[0].ends_with(" ×4"), "the collapsed hop must count its repeats:\n{stderr}")
    assert(stderr.contains(" Trail [E3002] (5 hops via ?, origin first):\n"), "the header counts every hop, collapsed or not:\n{stderr}")
}
