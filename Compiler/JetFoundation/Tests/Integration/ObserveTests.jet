use jet_foundation.Tests.Integration.Observe.build_and_run_debug
use jet_foundation.Tests.Integration.Common as common
use jet_foundation.Tests.Integration.TirSupport as tir_support
use jet.compile

// Rust: tests/observe.rs:18
#Test("structured_log_json_fields") {
    if !common.have_rustc() { return }
    src :: "\nuse core.log as log\nfn run() {{\n    log.set_level(\"debug\")\n    log.info(\"hello world\")\n    log.warn(\"disk low\")\n    log.error(\"connection lost\")\n    log.debug(\"trace detail\")\n}}\n"
    (code, _stdout, stderr) :: build_and_run_debug("log_json", src)
    assert_eq(code, 0, "program should exit cleanly; stderr:\n{stderr}")
    lines :: stderr.lines().collect()
    assert_eq(lines.len(), 4, "expected 4 log lines, got:\n{stderr}")
    for line in &lines {
        assert(line.starts_with('{') && line.ends_with('}'), "log line is not a JSON object: {line}")
        assert(line.contains("\"level\""), "missing 'level' field: {line}")
        assert(line.contains("\"body\""), "missing 'body' field: {line}")
        assert(line.contains("\"ts\":"), "missing 'ts' field: {line}")
    }
    assert(lines[0].contains("\"level\":\"info\"") && lines[0].contains("\"body\":\"hello world\""), "info line wrong: {lines[0]}")
    assert(lines[1].contains("\"level\":\"warn\"") && lines[1].contains("\"body\":\"disk low\""), "warn line wrong: {lines[1]}")
    assert(lines[2].contains("\"level\":\"error\"") && lines[2].contains("\"body\":\"connection lost\""), "error line wrong: {lines[2]}")
    assert(lines[3].contains("\"level\":\"debug\"") && lines[3].contains("\"body\":\"trace detail\""), "debug line wrong: {lines[3]}")
}
// Rust: tests/observe.rs:81
#Test("structured_log_level_filter") {
    if !common.have_rustc() { return }
    src :: "\nuse core.log as log\nfn run() {{\n    log.info(\"visible\")\n    log.debug(\"hidden\")\n}}\n"
    (_code, _stdout, stderr) :: build_and_run_debug("log_filter", src)
    lines :: stderr.lines().filter(|l| -> !l.is_empty()).collect()
    assert_eq(lines.len(), 1, "expected only 1 log line at info level, got:\n{stderr}")
    assert(lines[0].contains("\"level\":\"info\""), "wrong level: {lines[0]}")
}
// Rust: tests/observe.rs:111
#Test("structured_log_trace_id") {
    if !common.have_rustc() { return }
    src :: "\nuse core.log as log\nfn run() {{\n    log.set_trace_id(\"req-abc-123\")\n    log.info(\"with trace\")\n}}\n"
    for (tier, (code, _stdout, stderr)) in [
        ("native", build_and_run_debug("log_trace_id", src)),
        ("default", tir_support.jit_run("log_trace_id", src)),
        ("interpret", tir_support.interpreter_run("log_trace_id", src))
    ] {
        assert_eq(code, 0, "{tier} failed:\n{stderr}")
        lines :: stderr.lines().filter(|l| -> l.starts_with('{')).collect()
        assert_eq(lines.len(), 1, "{tier} stderr:\n{stderr}")
        assert(lines[0].contains("\"trace_id\":\"req-abc-123\""), "{tier} trace_id missing from log line: {lines[0]}")
    }
}
// Rust: tests/observe.rs:141
#Test("structured_log_fields_and_span_context") {
    if !common.have_rustc() { return }
    src :: "\nuse core.log as log\nfn run() {{\n    log.setup(\"json\")\n    log.set_trace_id(\"req-1\")\n    span :: log.span(\"request\")\n    log.enter(span)\n    log.info_fields(\"served\", [\n        log.field(\"route\", \"/health\"),\n        log.int(\"status\", 200),\n        log.bool(\"cache\", true),\n        log.counter(\"requests\", 1),\n    ])\n    log.close(span)\n}}\n"
    (_code, _stdout, stderr) :: build_and_run_debug("log_structured_fields", src)
    lines :: stderr.lines().filter(|l| -> l.starts_with('{')).collect()
    assert_eq(lines.len(), 1, "stderr:\n{stderr}")
    line :: lines[0]
    assert(line.contains("\"trace_id\":\"req-1\""), "trace missing: {line}")
    assert(line.contains("\"route\":\"/health\""), "field missing: {line}")
    assert(line.contains("\"status\":200"), "int field missing: {line}")
    assert(line.contains("\"cache\":true"), "bool field missing: {line}")
    assert(line.contains("\"metric.counter.requests\":1"), "counter missing: {line}")
    assert(line.contains("\"spans\":[\"request\"]"), "span missing: {line}")
}
// Rust: tests/observe.rs:191
