// Rust: tests/build_entry.rs:3747
fn duplicate_target_build_source(return_type: String, declarations: String) -> String {
    // ONE-arrow owner ruling: the fixture's old second body arrow is removed.
    """
__DECLARATIONS__
fn build(b: BuildContext) -> __RETURN_TYPE__ {
 first :: b.add_library("app", ["main.jet"], [])
 duplicate :: b.add_library("app", ["main.jet"], [])
    return b.plan()
}
fn run() {}
""".replace("__DECLARATIONS__", declarations).replace("__RETURN_TYPE__", return_type)
}

// Rust: tests/build_entry.rs:3762
fn assert_duplicate_target_report(errors: &[jet.Diagnostics.Diagnostic]) -> Unit {
    diagnostic :: errors.iter().find(fn(diagnostic) { diagnostic.code == "E3502" }).unwrap_or_else(fn() { panic("duplicate target must use the build report diagnostic: {errors:#?}") })
    if &diagnostic.structured == {
        .Some(.BuildError{report}) -> {
            assert_eq(report.typed_identity.as_deref(), .Some("BuildError::DuplicateTargetName"))
            details :: report.details.as_ref().expect("typed build details")
            assert_eq(details.variant, "DuplicateTargetName")
            assert_eq(details.fields.len(), 1)
            assert_eq(details.fields[0], JetErrorField{name: "value", value: "\"app\""})
        }
        other -> panic("missing structured BuildError report: {other:?}")
    }
}
