// Rust: tests/dev_parts/support.rs:3366
fn assert_interactive_example_three_way(file: String, stem: String, answers: String) -> {
    golden := ProgramOutput.ran(golden_stdout(stem), golden_stderr(stem), 0)
    for tier in ["O0", "O1", "O2", "Web"] {
        assert_eq(support02_stdin_output(file, tier, answers), golden, "{tier} drifted from the golden for `{stem}` with the answers it was recorded with")
    }
    if !common.have_rustc() {
        eprintln("note: rustc not found; `{stem}` compared on retained execution tiers only")
        return
    }
    dir := aot_scratch_dir("stdin_three_way", stem)
    aot := compiled_binary_output_with_stdin(&dir, "stdin_three_way", 0, stem, file, Some(answers))
    assert_eq(aot, golden, "AOT drifted from the golden for `{stem}` with the answers it was recorded with")
}
// Rust: tests/dev_parts/support.rs:3399
fn assert_io_cli_terminal_time_three_way(file: String, stem: String) -> {
    _ :: checked_bundle_from_path(file)
    if Some(answers) := common.example_stdin(stem) {
        assert_interactive_example_three_way(file, stem, answers.piped)
        return
    }
    golden := ProgramOutput.ran(golden_stdout(stem), golden_stderr(stem), 0)
    dir := aot_scratch_dir("jit_1219", stem)
    index := next_oracle_index()
    aot := compiled_binary_output(&dir, "jit_1219", index, stem, file)
    assert_eq(aot.stdout, golden.stdout, "AOT stdout drifted from golden for `{stem}`")
    // Each retained tier executes its own artifact, so watcher argv[0] naturally
    // names that artifact rather than requiring a resident-engine argv override.
    for tier in ["O0", "O1", "O2", "Web"] {
        output := support02_native_output(file, tier)
        assert_eq(output.stdout, aot.stdout, "{tier} vs AOT stdout divergence for `{stem}`")
        assert_eq(output.exit_code, aot.exit_code, "{tier} vs AOT exit divergence for `{stem}`")
        expected_stderr := if !golden.stderr.is_empty() -> &golden.stderr else -> &aot.stderr
        assert_eq(output.stderr, expected_stderr, "{tier} stderr divergence for `{stem}`")
        assert_eq(aot.stderr, expected_stderr, "AOT stderr divergence for `{stem}`")
    }
}
// Rust: tests/dev_parts/support.rs:3529
fn assert_lowlevel_and_safety_three_way(file: String, stem: String) -> {
    _ :: checked_bundle_from_path(file)
    golden := ProgramOutput.ran(golden_stdout(stem), golden_stderr(stem), 0)
    dir := aot_scratch_dir("jit_1220", stem)
    aot := compiled_binary_output(&dir, "jit_1220", next_oracle_index(), stem, file)
    assert_eq(aot.stdout, golden.stdout, "AOT stdout drifted from golden for `{stem}`")
    for tier in ["O0", "O1", "O2", "Web"] {
        output := support02_native_output(file, tier)
        assert_eq(output.stdout, golden.stdout, "{tier} stdout drifted from golden for `{stem}`")
        assert_eq(output.stdout, aot.stdout, "{tier} vs AOT stdout divergence for `{stem}`")
        assert_eq(output.exit_code, aot.exit_code, "{tier} vs AOT exit divergence for `{stem}`")
    }
}
