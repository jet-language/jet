// Private continuation of DevParts.Support; Main wires this fragment into that owner.
use jet.[Loader, Sema, Diagnostics, AST, Driver, Interpreter]
use jet_foundation.Tests.Integration.Common as common
use std.[fs, env, process, sync, thread, panic, time, collections]

// Retained execution providers replace retired resident-JIT representation checks.
// GATE #4494: the provider builds and executes the selected native/Web artifact.
fn support02_native_output(file: String, tier: String) -> ProgramOutput {
    if tier == "Web" {
        if common.run_entry_tier(OSPath(file), tier, false) == {
            .Ran(exit_code, stdout, stderr) -> return ProgramOutput.ran(stdout, stderr, exit_code)
            else -> panic("{tier} failed to execute `{file}`")
        }
    }
    profile := match tier {
        "O0" -> "debug"
        "O1" -> "dev"
        "O2" -> "release"
        else -> panic("unknown execution tier {tier}")
    }
    mut cmd := process.Command.new(common.jet_bin())
    cmd.args(["run", "--profile={profile}", file]).env("NO_COLOR", "1")
    output := command_output_with_timeout(cmd, DEV_DIFF_TIMEOUT, "native {profile}: {file}")
    ProgramOutput.ran(String.from_utf8_lossy(&output.stdout).into_owned(), String.from_utf8_lossy(&output.stderr).into_owned(), output.status.code().unwrap_or(1))
}
fn support02_checked_output(bundle: &AST.ProgramBundle, file: String, tier: String) -> ProgramOutput {
    if common.run_checked_entry_tier(bundle, OSPath(file), tier, &[file], false) == {
        .Ran(exit_code, stdout, stderr) -> ProgramOutput.ran(stdout, stderr, exit_code)
        else -> panic("{tier} failed to execute checked bundle `{file}`")
    }
}
fn support02_stdin_output(file: String, tier: String, answers: String) -> ProgramOutput {
    if tier == "Web" {
        if common.run_entry_tier_with_stdin(OSPath(file), tier, answers) == {
            .Ran(exit_code, stdout, stderr) -> return ProgramOutput.ran(stdout, stderr, exit_code)
            else -> panic("{tier} failed to execute `{file}` with stdin")
        }
    }
    profile := match tier {
        "O0" -> "debug"
        "O1" -> "dev"
        "O2" -> "release"
        else -> panic("unknown execution tier {tier}")
    }
    dir := common.unique_tmp("jet_native_answers")
    fs.create_dir_all(&dir).unwrap()
    input := dir.join("answers")
    fs.write(&input, answers).unwrap()
    mut cmd := process.Command.new(common.jet_bin())
    cmd.args(["run", "--profile={profile}", file]).env("NO_COLOR", "1").stdin(process.Stdio.from(fs.File.open(&input).unwrap()))
    output := command_output_with_timeout(cmd, DEV_DIFF_TIMEOUT, "native {profile} with stdin: {file}")
    _ :: fs.remove_dir_all(&dir)
    ProgramOutput.ran(String.from_utf8_lossy(&output.stdout).into_owned(), String.from_utf8_lossy(&output.stderr).into_owned(), output.status.code().unwrap_or(1))
}

// Rust: tests/dev_parts/support.rs:1807
fn print_jit_op_report() -> {
    root := OSPath(env.manifest_dir())
    ops: [String:(USize, USize)] = [:]
    for path in topic_jet_files(&root) {
        file := path.to_string_lossy()
        mut bundle := match Loader.load_entry(&file) {
            Ok(b) -> b
            Err(_) -> continue
        }
        diags := Sema.check_bundle(&bundle, Sema.CompileMode.Run)
        if diags.iter().any(|d| -> d.severity == Diagnostics.Severity.Error) { continue }
        covered := common.compile_entry_tier(&bundle, "O0").is_ok()
        for tag in common.main_ops(&bundle) {
            entry := ops.entry(tag).or_insert((0, 0))
            if covered { entry.0 += 1 } else { entry.1 += 1 }
        }
    }
    eprintln("native observed TIR op compile coverage:")
    mut keys := ops.keys().collect()
    keys.sort()
    for op in keys {
        (covered, gaps) := ops[op]
        eprintln("  {op}: compile_covered_examples={covered} gap_examples={gaps}")
    }
}

// Rust: tests/dev_parts/support.rs:1856
// Honest execution boundaries: fuel, unsupported comptime constructs, user panic,
// ungated effects, vault denial and frontend gaps retained by manifested corpora.
const BOUNDARY_CODES: [String] = [
    "E2202", "E0952", "E0956", "E0953", "E3410", "E3411", "E3412", "E1265",
    "E0102", "E0857", "E0107", "E0501",
    "E0308", "E0504", "E0302", "E0505", "E0915", "E0311", "E1004",
]
// Rust: tests/dev_parts/support.rs:1865
const DEFAULT_BACKEND_EXPECTED_BOUNDARIES: [String] = ["collections/list_bounds"]

// Rust: tests/dev_parts/support.rs:1868
struct DevBatteryStats {
    ran: USize = 0
    boundary: USize = 0
    deopt: USize = 0
    manifested: USize = 0
    boundary_stems: [String] = []
    // Rust: tests/dev_parts/support.rs:1877
    fn add(&self, mut other: DevBatteryStats) -> {
        self.ran += other.ran
        self.boundary += other.boundary
        self.deopt += other.deopt
        self.manifested += other.manifested
        self.boundary_stems.append(&other.boundary_stems)
    }
}

// Rust: tests/dev_parts/support.rs:1886
fn assert_default_dev_jit_gap(stem: String, file: String) -> {
    baseline := support02_native_output(file, "O0")
    for tier in ["O1", "O2", "Web"] {
        assert_eq(normalize_for_parity(stem, support02_native_output(file, tier)), normalize_for_parity(stem, baseline), "native coverage/output divergence for `{stem}` at {tier}")
    }
}
// Rust: tests/dev_parts/support.rs:1909
fn is_named_dev_boundary(stem: String, diags: &[Diagnostics.Diagnostic]) -> Bool {
    diags.iter().any(|d| -> BOUNDARY_CODES.contains(&d.code)) ||
        (stem == "io/db_checked_sql" && diags.iter().all(|d| -> d.code == "E1004"))
}
// Rust: tests/dev_parts/support.rs:1920
fn check_interactive_stem_cli_vs_aot(i: USize, stem: String, dir: &OSPath, file: String, answers: String, interpret: Bool, tag: String, manifested_divergences: &[String]) -> DevBatteryStats {
    left := normalize_for_parity(stem, cli_tier_program_output(file, stem, answers, interpret))
    compiled := normalize_for_parity(stem, compiled_binary_output_with_stdin(dir, tag, i, stem, file, Some(answers)))
    if left != compiled {
        if is_manifested_parity_divergence(stem, manifested_divergences) {
            eprintln("manifested parity divergence: {stem}")
            return DevBatteryStats { ran: 1, manifested: 1 }
        }
        assert_eq(left, compiled, "DIVERGENCE for `{stem}` with the answers its golden was recorded with: CLI and compiled binary disagree")
    }
    DevBatteryStats { ran: 1 }
}
// Rust: tests/dev_parts/support.rs:1958
fn check_dev_default_stem(i: USize, stem: String, dir: &OSPath, manifested_divergences: &[String]) -> DevBatteryStats {
    file := example_path(stem)
    eprintln("dev-default checking {stem}")
    if Some(answers) := common.example_stdin(stem) {
        return check_interactive_stem_cli_vs_aot(i, stem, dir, file, answers.piped, false, "dev_default_diff", manifested_divergences)
    }
    interpreted := match dev_iteration_with_timeout(stem, file, false) {
        RunOutcome.Ran { stdout, stderr, exit_code } -> ProgramOutput.ran(stdout, stderr, exit_code)
        RunOutcome.Problems(diags) -> {
            assert(!diags.iter().any(|diagnostic| -> diagnostic.code == "E2211"), "`{stem}` must not emit retired E2211: {diags:?}")
            codes := diags.iter().map(|d| -> d.code).collect()
            eprintln("default boundary: {stem}: {codes.join(",")}")
            assert(is_named_dev_boundary(stem, &diags), "`{stem}` neither ran nor stopped at a named boundary {BOUNDARY_CODES:?} under the default jet dev backend; codes were {codes:?}")
            return DevBatteryStats { boundary: 1, boundary_stems: [stem.to_string()] }
        }
    }
    // Host AOT failure does not imply a tier bug; retain the oracle skip.
    compiled := match try_compiled_binary_output(dir, "dev_default_diff", i, stem, file) {
        Some(output) -> output
        None -> {
            eprintln("aot unavailable (skip parity): {stem}")
            return DevBatteryStats { ran: 1 }
        }
    }
    interpreted_normalized := normalize_for_parity(stem, interpreted)
    compiled_normalized := normalize_for_parity(stem, compiled)
    if interpreted_normalized != compiled_normalized {
        if is_manifested_parity_divergence(stem, manifested_divergences) {
            eprintln("manifested parity divergence: {stem}")
            return DevBatteryStats { ran: 1, manifested: 1 }
        }
        assert_eq(interpreted_normalized, compiled_normalized, "DIVERGENCE for `{stem}` under the default jet dev backend: JIT/fallback and compiled binary disagree on stdout/stderr/exit code — this is a P0 miscompile")
    }
    DevBatteryStats { ran: 1 }
}
// Rust: tests/dev_parts/support.rs:2051
fn run_dev_default_battery_parallel(stems: [String], dir: OSPath, manifested_divergences: [String]) -> DevBatteryStats {
    // GATE #4494: shared synchronization, native worker spawning and panic capture.
    jobs := sync.Arc.new(sync.Mutex.new(stems.into_iter().enumerate().collect<collections.VecDeque<(USize, String)>>()))
    shared_dir := sync.Arc.new(dir)
    divergences := sync.Arc.new(manifested_divergences)
    failures := sync.Arc.new(sync.Mutex.new<[String]>([]))
    worker_count := common.test_worker_count(16)
    mut handles = []
    for _ in 0..worker_count {
        worker_jobs := jobs.clone()
        worker_dir := shared_dir.clone()
        worker_divergences := divergences.clone()
        worker_failures := failures.clone()
        handles.push(thread.Builder.new().spawn(move || -> {
            mut stats := DevBatteryStats()
            loop {
                (i, stem) := match lock_recovered(&worker_jobs, "dev default work queue").pop_front() {
                    Some(job) -> job
                    None -> break
                }
                result := panic.catch_unwind(panic.AssertUnwindSafe(|| -> check_dev_default_stem(i, stem, &worker_dir, &worker_divergences)))
                match result {
                    Ok(next) -> stats.add(next)
                    Err(payload) -> lock_recovered(&worker_failures, "dev default failure report").push("{stem}: {common.panic_message(payload)}")
                }
            }
            stats
        }).expect("dev default worker"))
    }
    mut stats := DevBatteryStats()
    for handle in handles {
        stats.add(handle.join().expect("dev default worker panicked outside harness"))
    }
    report := judged_report(&failures, "dev default failure report")
    assert(report.is_empty(), "dev default parity failures:\n{report.join("\n\n")}")
    report_oracle_cache_counts()
    stats
}
