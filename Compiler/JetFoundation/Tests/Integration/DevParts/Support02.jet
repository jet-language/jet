        return check_interactive_stem_cli_vs_aot(i, stem, dir, file, answers.piped, true, "dev_diff", manifested_divergences)
    }
    interpreted := match dev_iteration_with_timeout(stem, file, true) {
        RunOutcome.Ran { stdout, stderr, exit_code } -> ProgramOutput.ran(stdout, stderr, exit_code)
        RunOutcome.Problems(diags) -> {
            codes := diags.iter().map(|d| -> d.code).collect()
            assert(is_named_dev_boundary(stem, &diags), "`{stem}` neither ran nor stopped at a named boundary {BOUNDARY_CODES:?}; codes were {codes:?}")
            return DevBatteryStats { boundary: 1 }
        }
    }
    compiled := match try_compiled_binary_output(dir, "dev_diff", i, stem, file) {
        Some(output) -> output
        None -> {
            eprintln("aot unavailable (skip parity): {stem}")
            return DevBatteryStats { ran: 1 }
        }
    }
    interpreted_normalized := normalize_for_parity(stem, interpreted)
    compiled_normalized := normalize_for_parity(stem, compiled)
    if interpreted_normalized != compiled_normalized {
        if is_manifested_parity_divergence(stem, manifested_divergences) {
            eprintln("manifested parity divergence: {stem}")
            return DevBatteryStats { ran: 1, manifested: 1 }
        }
        assert_eq(interpreted_normalized, compiled_normalized, "DIVERGENCE for `{stem}`: interpreter and compiled binary disagree on stdout/stderr/exit code — this is a P0 miscompile")
    }
    DevBatteryStats { ran: 1 }
}
