// Rust: tests/dev_parts/support.rs:3205
fn golden_program_output(stem: String) -> ProgramOutput {
    root := OSPath(env.manifest_dir())
    if example_has_err_golden(stem) {
        stderr := fs.read_to_string(root.join("Examples/features/expected/{stem}.err.out")).unwrap_or_else(|e| -> panic("missing err golden for `{stem}`: {e}"))
        return ProgramOutput.ran("", stderr, 70)
    }
    ProgramOutput.ran(golden_stdout(stem), "", 0)
}
// Rust: tests/dev_parts/support.rs:3216
fn strip_panic_locals(stderr: String) -> String {
    lines := stderr.lines().filter(|line| -> !line.starts_with("locals:")).collect()
    lines.join("\n") + if stderr.ends_with("\n") -> "\n" else -> ""
}
// Rust: tests/dev_parts/support.rs:3225
fn assert_data_pipelines_parsing_three_way(file: String, stem: String) -> {
    _ :: checked_bundle_from_path(file)
    expected := golden_program_output(stem)
    baseline := support02_native_output(file, "O0")
    assert_eq(baseline, expected, "O0 drifted from golden for `{stem}`")
    if stem == "reflection/reflect-value" {
        assert_eq(baseline, expected, "reflection example must match its golden output")
    }
    dir := aot_scratch_dir("jit_1223", stem)
    aot := compiled_binary_output(&dir, "jit_1223", next_oracle_index(), stem, file)
    if stem == "tooling/panic_report" {
        body := |out: &ProgramOutput| -> ProgramOutput.ran(out.stdout.clone(), strip_panic_locals(out.stderr), out.exit_code)
        assert_eq(body(&baseline), body(&aot), "native vs AOT panic body divergence for `{stem}`")
        for tier in ["O1", "O2", "Web"] {
            assert_eq(body(&support02_native_output(file, tier)), body(&expected), "{tier} panic body drifted from golden for `{stem}`")
        }
    } else {
        assert_eq(baseline, aot, "native vs AOT reference divergence for `{stem}`")
        for tier in ["O1", "O2", "Web"] {
            assert_eq(support02_native_output(file, tier), expected, "{tier} drifted from golden for `{stem}`")
        }
    }
}
