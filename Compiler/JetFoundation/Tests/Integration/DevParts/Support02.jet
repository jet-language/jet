//RS /// The recognized honest-boundary / terminal codes the interpreter may stop at
//RS /// instead of producing run-to-completion stdout (c77 / D-DEV1):
//RS ///   - E2202 / E0952: the step/fuel budget was exhausted,
//RS ///   - E0956: a construct not yet supported at comptime (hit during execution),
//RS ///   - E0953: a deliberate user-authored panic (`assert(false, …)`), which is
//RS ///     the program legitimately failing, not a silent skip.
//RS ///   - E3410 / E3411: a D-CTEFFECT1 Tier-2 comptime effect (`core.files`/`core.term`/
//RS ///     `core.sys`/…) reached with no `#Impure` gate, or a gate present but
//RS ///     `--gate impure=allow` not passed — an honest, named boundary (the golden
//RS ///     corpus runs with neither), not a silent skip.
//RS ///   - E1265 (U13, D-JPK-SECRETCRYPTO1): `core.crypto.vault.get` reached through the
//RS ///     same comptime/interpreter evaluation path — unconditionally denied
//RS ///     (no `#Impure` escape hatch), so an example exercising it always stops
//RS ///     here under the interpreter/JIT tiers even though the AOT-compiled
//RS ///     binary runs it fine (it never goes through this evaluator).
//RS const BOUNDARY_CODES: &[&str] = &[
//RS     "E2202", "E0952", "E0956", "E0953", "E3410", "E3411", "E3412", "E1265",
//RS     // Front-end / sema codes that surface when the interpreter can't load a
//RS     // construct the AOT path still accepts (splice/generics gaps).
//RS     "E0102", "E0857", "E0107", "E0501",
//RS     // Frontend-rejected examples (corpus gate) may still appear in manifested lists.
//RS     "E0308", "E0504", "E0302", "E0505", "E0915", "E0311", "E1004",
//RS ];
//RS 
//RS const DEFAULT_BACKEND_EXPECTED_BOUNDARIES: &[&str] = &["collections/list_bounds"];
