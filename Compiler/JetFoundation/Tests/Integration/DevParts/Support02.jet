    for tier in ["O0", "O1", "O2", "Web"] {
        // Native callback run is empty; its golden belongs to wasm/node.
        golden := if stem == "web/web_wasm_callback" && tier != "Web" -> ProgramOutput.ran("", "", 0) else -> expected
        assert_eq(support02_native_output(file, tier), golden, "{tier} drifted from golden for `{stem}`")
    }
    dir := aot_scratch_dir("jit_1225", stem)
