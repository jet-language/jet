// Rust: tests/dev_parts/support.rs:2694
fn conformance_application_authority() -> jet_foundation.Authority.ApplicationAuthority {
    mut allow := jet_foundation.Authority.Effect.all()
    allow.extend(jet_foundation.Authority.ApplicationAuthority.AMBIENT_BASIC_EFFECTS.iter().map(|effect| -> effect.to_string()))
    allowed := allow.into_iter().collect()
    jet_foundation.Authority.ApplicationAuthority.from_policy(Some(&allowed), None, "core conformance harness")
}
// Rust: tests/dev_parts/support.rs:2709
fn assert_cranelift_three_way(file: String, stem: String) -> {
    mut bundle := Loader.load_entry(file).expect("bundle should load")
    is_core_conformance := stem.starts_with("conformance/")
    if is_core_conformance {
        bundle.package_guarantees.application_authority = conformance_application_authority()
    }
    Driver.seed_build_facts(&bundle, "dev", false, &[:]).unwrap_or_else(|diags| -> {
        messages := diags.iter().map(|d| -> "{d.code}: {d.what}").collect()
        panic("`{stem}` build facts should seed: {messages.join("; ")}")
    })
    diags := Sema.check_bundle(&bundle, Sema.CompileMode.Run)
    errors := diags.into_iter().filter(|d| -> d.severity == Diagnostics.Severity.Error).collect()
    assert(errors.is_empty(), "`{stem}` must type-check: {errors:?}")
    baseline := normalize_for_parity(stem, support02_checked_output(&bundle, file, "O0"))
    for tier in ["O1", "O2", "Web"] {
        output := normalize_for_parity(stem, support02_checked_output(&bundle, file, tier))
        assert_eq(output, baseline, "{tier} vs O0 divergence for `{stem}`")
    }
    dir := aot_scratch_dir("jit_3way", stem)
    aot := normalize_for_parity(stem, if is_core_conformance -> compiled_binary_output_from_bundle(&dir, "jit_3way", next_oracle_index(), stem, file, &bundle) else -> compiled_binary_output(&dir, "jit_3way", next_oracle_index(), stem, file))
    assert_eq(baseline, aot, "native vs AOT reference divergence for `{stem}`")
}
