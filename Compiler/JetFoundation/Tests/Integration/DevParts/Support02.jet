// Rust: tests/dev_parts/support.rs:2260
// A process-wide counter prevents concurrent oracle builds overwriting scratch.
fn next_oracle_index() -> USize {
    // GATE #4494: static atomic storage and relaxed fetch-add.
    static NEXT: sync.atomic.AtomicUsize = sync.atomic.AtomicUsize.new(0)
    NEXT.fetch_add(1, sync.atomic.Ordering.Relaxed)
}
// Rust: tests/dev_parts/support.rs:2279
fn run_child_stem_battery(test_name: String, child_env: String, label: String, timeout: time.Duration, stems: &[String], extra_env: &[(String, String)]) -> {
    // GATE #4494: child processes, worker threads, synchronization and unwind.
    jobs := sync.Arc.new(sync.Mutex.new(stems.iter().map(|stem| -> stem.to_string()).collect<collections.VecDeque<String>>()))
    failures := sync.Arc.new(sync.Mutex.new<[String]>([]))
    mut handles = []
    for worker in 0..common.test_worker_count(8) {
        worker_jobs := jobs.clone()
        worker_failures := failures.clone()
        worker_test := test_name.to_string()
        worker_env := child_env.to_string()
        worker_label := label.to_string()
        worker_extra := extra_env.iter().map(|(key, value)| -> (key.to_string(), value.to_string())).collect()
        handles.push(thread.Builder.new().name("child-stem-battery-{worker}").spawn(move || -> {
            loop {
                stem := match lock_recovered(&worker_jobs, "child stem battery queue").pop_front() {
                    Some(stem) -> stem
                    None -> break
                }
                // A per-stem panic is reported without losing the queued siblings.
                judged := panic.catch_unwind(panic.AssertUnwindSafe(|| -> {
                    mut command := process.Command.new(env.current_exe().expect("current dev test binary"))
                    command.args(["--exact", worker_test, "--nocapture"]).env(worker_env, stem).env("NO_COLOR", "1")
                    for (key, value) in &worker_extra { command.env(key, value) }
                    command_output_with_timeout(command, timeout, "{worker_label} `{stem}`")
                }))
                match judged {
                    Ok(output) -> {
                        if !output.status.success() {
                            lock_recovered(&worker_failures, "child stem battery failures").push("{stem}: status={output.status:?}\nstdout:\n{String.from_utf8_lossy(&output.stdout)}\nstderr:\n{String.from_utf8_lossy(&output.stderr)}")
                        }
                    }
                    Err(payload) -> lock_recovered(&worker_failures, "child stem battery failures").push("{stem}: {common.panic_message(payload)}")
                }
            }
        }).expect("child stem battery worker"))
    }
    for handle in handles { handle.join().expect("child stem battery worker panicked outside the per-stem guard") }
    report := judged_report(&failures, "child stem battery failures")
    assert(report.is_empty(), "{label} failures:\n{report.join("\n")}")
}
// Rust: tests/dev_parts/support.rs:2381
fn run_three_way_battery_parallel(stems: [String]) -> USize {
    // GATE #4494: shared queue, relaxed atomic counts, workers and unwind capture.
    total := stems.len()
    jobs := sync.Arc.new(sync.Mutex.new(collections.VecDeque.from(stems)))
    failures := sync.Arc.new(sync.Mutex.new<[String]>([]))
    ran := sync.Arc.new(sync.atomic.AtomicUsize.new(0))
    mut handles = []
    for worker in 0..common.test_worker_count(8) {
        worker_jobs := jobs.clone()
        worker_failures := failures.clone()
        worker_ran := ran.clone()
        handles.push(thread.Builder.new().name("three-way-{worker}").spawn(move || -> {
            loop {
                stem := match lock_recovered(&worker_jobs, "three-way work queue").pop_front() {
                    Some(stem) -> stem
                    None -> break
                }
                eprintln("three-way battery: checking `{stem}`")
                judged := panic.catch_unwind(panic.AssertUnwindSafe(|| -> {
                    with_jit_test_scope(|| -> assert_cranelift_three_way(example_path(stem), stem))
                }))
                match judged {
                    Ok(_) -> { _ :: worker_ran.fetch_add(1, sync.atomic.Ordering.Relaxed) }
                    Err(payload) -> lock_recovered(&worker_failures, "three-way failure report").push("{stem}: {common.panic_message(payload)}")
                }
            }
        }).expect("three-way battery worker"))
    }
    for handle in handles { handle.join().expect("three-way battery worker panicked") }
    report := judged_report(&failures, "three-way failure report")
    assert(report.is_empty(), "three-way differential failures ({report.len()} of {total} stem(s)):\n{report.join("\n\n")}")
    ran.load(sync.atomic.Ordering.Relaxed)
}
// Rust: tests/dev_parts/support.rs:2429
fn check_job_runner_interpreter(root: &OSPath, file: String) -> {
    mut bundle := Loader.load_entry(file).expect("job_runner loads")
    errors := Sema.check_bundle(&bundle, Sema.CompileMode.Run).into_iter().filter(|d| -> d.severity == Diagnostics.Severity.Error).collect()
    assert(errors.is_empty(), "job_runner front end: {errors:?}")
    for (job, expected_name) in [("greet", "job_runner.greet"), ("seed_data", "job_runner.seed_data")] {
        expected := fs.read_to_string(root.join("Examples/features/expected/devloop/{expected_name}.out")).unwrap_or_else(|_| -> panic("missing expected/devloop/{expected_name}.out"))
        policy := common.development_policy()
        match common.run_interpreter_named_job(&bundle, file, job, false, &policy) {
            RunOutcome.Ran { stdout, .. } -> assert_eq(stdout, expected, "interpreter job `{job}` differs from golden")
            RunOutcome.Problems(diags) -> panic("interpreter job `{job}` did not run: {diags.iter().map(|d| -> d.code).collect():?}")
        }
    }
}
// Rust: tests/dev_parts/support.rs:2465
fn checked_bundle_from_path(file: String) -> AST.ProgramBundle {
    jet.run_compiler_work(|| -> {
        mut b := Loader.load_entry(file).expect("bundle should load")
        diags := Sema.check_bundle(&b, Sema.CompileMode.Run)
        errors := diags.into_iter().filter(|d| -> d.severity == Diagnostics.Severity.Error).collect()
        assert(errors.is_empty(), "fixture must type-check: {errors:?}")
        b
    })
}
