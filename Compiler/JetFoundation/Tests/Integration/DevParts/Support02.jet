// Rust: tests/dev_parts/support.rs:2617
fn run_cli_default_resident(command: String, file: String, tag: String) -> ProgramOutput {
    // GATE #4494: actual child CLI and process environment.
    cache := common.unique_tmp("jet_{tag}_cache")
    fs.create_dir_all(&cache).unwrap()
    mut args := [command, file]
    if command == "dev" { args.extend(["--watch=off", "--quiet"]) }
    mut cmd := process.Command.new(env.bin_exe("jet"))
    cmd.args(args).current_dir(env.manifest_dir()).env("NO_COLOR", "1").env("JET_RUN_CACHE_DIR", &cache).env("JET_STORE_DIR", cache.join("build"))
    output := command_output_with_timeout(cmd, DEV_DIFF_TIMEOUT, "default CLI {command} for `{tag}`")
    assert(output.status.success(), "default CLI {command} failed for `{tag}`:\nstdout:\n{String.from_utf8_lossy(&output.stdout)}\nstderr:\n{String.from_utf8_lossy(&output.stderr)}")
    mut stdout := String.from_utf8_lossy(&output.stdout).into_owned()
    if Some(end) := stdout.find("✓ ran in ") { stdout = stdout[..end].to_string() }
    _ :: fs.remove_dir_all(&cache)
    ProgramOutput.ran(stdout, "", output.status.code().unwrap_or(1))
}
// Rust: tests/dev_parts/support.rs:2659
fn assert_cli_diagnostic_snapshot(command: String, fixture: String, snapshot: String) -> {
    // GATE #4494: actual child CLI and process environment.
    mut args := [command, fixture]
    if command == "dev" { args.extend(["--watch=off", "--quiet"]) }
    mut cmd := process.Command.new(env.bin_exe("jet"))
    cmd.args(args).current_dir(env.manifest_dir()).env("NO_COLOR", "1")
    output := command_output_with_timeout(cmd, DEV_DIFF_TIMEOUT, "default CLI {command} diagnostic")
    assert(!output.status.success(), "default CLI {command} unexpectedly accepted `{fixture}`")
    rendered := "{String.from_utf8_lossy(&output.stdout)}{String.from_utf8_lossy(&output.stderr)}"
    assert(rendered.starts_with(snapshot), "default CLI {command} diagnostic drifted from UI snapshot:\n{rendered}")
}
