    }
}
// Rust: tests/dev_parts/routine.rs:1913
#Test("fixed_interpolation_matches_interpreter_and_resident_jit_rounding") {
    if skip_if_cranelift_host_unsupported() { return }
    src :: """
fn run() -> {
    lower_tie :: Float{1.125}
    upper_tie :: Float{1.375}
    grouped :: Float{1234.5678}
    integer :: 1234
    print("{lower_tie:Fixed(2)}|{upper_tie:Fixed(2)}|{grouped:Fixed(2)}|{grouped:Grouped(2)}|{integer:Fixed(2)}|{integer:Grouped(2)}")
}
"""
    expected :: ProgramOutput.ran("1.12|1.38|1234.57|1,234.57|1234.00|1,234.00\n", "", 0)
    file :: std.env.temp_dir().join("jet_fixed_interpolation_parity.jet")
    fs.write(file, src).unwrap()
    shown :: file.to_string_lossy().to_string()
    interpreted :: if dev_iteration(shown, false, true) == {
        .Ran { stdout, stderr, exit_code } -> ProgramOutput.ran(stdout, stderr, exit_code)
        .Problems(diags) -> panic("fixed interpolation must run in the interpreter: {diags:?}")
    }
    jit.reset_jit_trace_for_test()
    resident :: run_cranelift_without_fallback(src, "fixed_interpolation_parity")
    assert(jit.jit_executed_for_test(), "fixed interpolation must execute in resident JIT")
    assert(!jit.deopt_invoked_for_test() && !jit.fallback_invoked_for_test(), "fixed interpolation must not deopt or fall back")
    assert_eq(interpreted, expected)
    assert_eq(resident, expected)
}
// Rust: tests/dev_parts/routine.rs:1956
#Test("dev_packed_enum_print_is_safe_across_run_processes") {
    stamp :: std.time.SystemTime.now().duration_since(std.time.UNIX_EPOCH).unwrap().as_nanos() // GATE #4494
    cache :: std.env.temp_dir().join("jet_dev_packed_enum_cache_{std.process.id()}_{stamp}")
    file :: "Examples/features/errors/errors.jet"
    expected :: "42\n84\nBadDigit(\"x\")\n"
    loop run in 1..=2 {
        output :: Command.new(std.env.compile_time_var("CARGO_BIN_EXE_jet")).args(["run", file]).env("JET_RUN_CACHE_DIR", cache).output().unwrap() // GATE #4494
        assert(output.status.success(), "run {run} failed: {String.from_utf8_lossy(output.stderr)}")
        assert_eq(String.from_utf8_lossy(output.stdout), expected, "run {run} must preserve the Jet enum name")
    }
    _ :: fs.remove_dir_all(cache)
}
// Rust: tests/dev_parts/routine.rs:1994
#Test("cranelift_backend_matches_hello") {
    if skip_if_cranelift_host_unsupported() { return }
    file :: "Examples/features/basics/hello.jet"
    bundle :: checked_bundle_from_path(file)
    expected :: if dev_iteration(file, false, true) == {
        .Ran { stdout, .. } -> stdout
        .Problems(ds) -> panic("interpreter baseline must run hello, got diagnostics: {ds:?}")
    }
    policy :: common.development_policy()
    backend := CraneliftBackend.new()
    got :: if common.run_cranelift_bundle(&backend, bundle, false, policy) == {
        .Ran { stdout, .. } -> stdout
        .Problems(ds) -> panic("cranelift backend did not run hello: {ds:?}")
    }
    assert_eq(got, expected, "cranelift output drifted from interpreter")
    src :: fs.read_to_string(file).expect("hello source should read")
    compiled :: jet.compile_with_path(src, file).expect("hello should compile")
    rs :: std.env.temp_dir().join("jet_dev_cranelift_hello.rs")
    bin :: std.env.temp_dir().join("jet_dev_cranelift_hello")
    command := Command.new("rustc")
    runtime_lease :: add_generated_rust(&command, rs, compiled.rust, compiled.ffi.is_some(), [])
    rustc :: command.arg("-o").arg(bin).output().expect("run rustc")
    assert(rustc.status.success(), "rustc failed compiling hello fixture: {String.from_utf8_lossy(rustc.stderr)}")
    run :: Command.new(bin).output().expect("run compiled hello")
    compiled_stdout :: String.from_utf8_lossy(run.stdout).to_string()
    assert_eq(got, compiled_stdout, "cranelift output drifted from AOT binary")
}
// Rust: tests/dev_parts/routine.rs:2047
#Test("post_contract_failure_matches_aot_under_quick_run") {
    if skip_if_cranelift_host_unsupported() || !have_rustc() { return }
    src :: """
#Post(result == 99, "must equal 99")
fn get() -> Int {
    return 1
}

fn run() -> {
    print(get())
}
"""
    dir :: std.env.temp_dir().join("jet_contract_parity_{std.process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).unwrap()
    file :: dir.join("post_failure.jet")
    fs.write(file, src).unwrap()
    shown :: file.to_string_lossy().to_string()
    quick :: if dev_iteration(shown, false, false) == {
        .Ran { stdout, stderr, exit_code } -> ProgramOutput.ran(stdout, stderr, exit_code)
        .Problems(ds) -> panic("quick run returned diagnostics: {ds:?}")
    }
    aot :: compiled_binary_output(dir, "post_contract", 0, "contracts/post_failure", shown)
    assert_eq(quick.exit_code, 70, "quick run must trap: {quick:?}")
    assert(quick.stderr.contains("#Post contract failed: must equal 99"))
    assert_eq(quick, aot, "quick run and AOT contract behavior diverged")
    _ :: fs.remove_dir_all(dir)
}
// Rust: tests/dev_parts/routine.rs:2087
#Test("post_contract_success_and_failure_match_on_all_tiers") {
    if skip_if_cranelift_host_unsupported() || !have_rustc() { return }
    src :: """
#Post(result > 0, "post sees the successful payload")
fn counted(value: Int) -> Int {
    print("body:{value}")
    if value > 0 {
        return value
    }
    return Err("sentinel")
}

fn run() -> {
    good :: counted(7)
    good ? value -> print("good:{value}") ! error -> print("good-error:{error.message}")
    bad :: counted(0)
    bad ? value -> print("bad:{value}") ! error -> print("bad-error:{error.message}")
}
"""
    expected :: ProgramOutput.ran("body:7\ngood:7\nbody:0\nbad-error:sentinel\n", "", 0)
    dir :: std.env.temp_dir().join("jet_contract_success_failure_{std.process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).unwrap()
    file :: dir.join("post_contract_success_failure.jet")
    fs.write(file, src).unwrap()
    shown :: file.to_string_lossy().to_string()
    interpreted :: if dev_iteration(shown, false, true) == {
        .Ran { stdout, stderr, exit_code } -> ProgramOutput.ran(stdout, stderr, exit_code)
        .Problems(ds) -> panic("contract interpreter failed: {ds:?}")
    }
    resident :: run_cranelift_resident(src, "contracts_success_failure")
    default :: if dev_iteration(shown, false, false) == {
        .Ran { stdout, stderr, exit_code } -> ProgramOutput.ran(stdout, stderr, exit_code)
        .Problems(ds) -> panic("contract default run failed: {ds:?}")
    }
    aot :: compiled_binary_output(dir, "post_contract_success_failure", 0, "contracts/post_contract_success_failure", shown)
    assert_eq(interpreted, expected, "contract interpreter output drifted")
    assert_eq(resident, expected, "contract resident JIT output drifted")
    assert_eq(default, expected, "contract default JIT output drifted")
    assert_eq(aot, expected, "contract AOT output drifted")
    have_node :: Command.new("node").arg("--version").output().map((output) -> output.status.success()).unwrap_or(false)
    have_wasm_target :: Command.new("rustc").args(["--print", "target-libdir", "--target", "wasm32-unknown-unknown"]).output().map((output) -> output.status.success()).unwrap_or(false)
    if have_node && have_wasm_target {
        output :: jet.compile_web_with_path(src, shown).unwrap_or_else((diags) -> panic("contract web source failed: {diags:?}"))
        web :: output.web.expect("contract web output should be present")
        scratch :: common.Scratch.new("contract-success-failure-web")
        fs.write(scratch.join("app.js"), web.js_app).unwrap()
        fs.write(scratch.join("jet_dom_runtime.js"), web.dom_runtime).unwrap()
        fs.write(scratch.join("app_wasm.rs"), web.wasm_rust).unwrap()
        wasm :: Command.new("rustc").current_dir(scratch.path).args(["--edition", "2021", "--target", "wasm32-unknown-unknown", "--crate-type", "cdylib", "-O", "app_wasm.rs", "-o", "app.wasm"]).output().expect("spawn contract web wasm rustc")
        assert(wasm.status.success(), "rustc rejected contract web output: {String.from_utf8_lossy(wasm.stderr)}")
        js :: Command.new("node").current_dir(scratch.path).arg("app.js").output().expect("run contract web JS")
        assert(js.status.success(), "contract web JS failed: {String.from_utf8_lossy(js.stderr)}")
        assert_eq(String.from_utf8_lossy(js.stdout), expected.stdout.as_str(), "contract JavaScript output drifted")
        fs.write(scratch.join("wasm.mjs"), """
const { instantiateWasm, takeWasmError } = await import("./jet_dom_runtime.js");
const instance = await instantiateWasm("./app.wasm");
const status = instance.exports.jet_export_run();
if (status !== 0) throw new Error(`contract Wasm status: ${status}`);
if (takeWasmError(instance.exports)?.tag !== "Ok") throw new Error("contract Wasm stopped");
""").unwrap()
        wasm_run :: Command.new("node").current_dir(scratch.path).arg("wasm.mjs").output().expect("run contract web Wasm")
        assert(wasm_run.status.success(), "contract web Wasm failed: {String.from_utf8_lossy(wasm_run.stderr)}")
        assert_eq(String.from_utf8_lossy(wasm_run.stdout), expected.stdout.as_str(), "contract Wasm output drifted")
    } else {
        eprintln("note: skipping contract web execution (need node and wasm32 target)")
    }
    _ :: fs.remove_dir_all(dir)
}
// Rust: tests/dev_parts/routine.rs:2243
#Test("unicode_string_and_core_text_match_aot_comptime_and_resident_jit") {
    if skip_if_cranelift_host_unsupported() || !have_rustc() { return }
    upper :: Char.from_u32(0xA7CE).unwrap()
    lower :: Char.from_u32(0xA7CF).unwrap()
    whitespace :: Char.from_u32(0x2003).unwrap()
    source :: format("""use core.text as text

fn run() -> {{
    print("{upper}".to_lower() == "{lower}")
    print("{lower}".to_upper() == "{upper}")
    print("{whitespace}jet{whitespace}".trim())
    print(text.lower("{upper}") == "{lower}")
    print(text.upper("{lower}") == "{upper}")
    print(text.trim("{whitespace}jet{whitespace}"))
}}
""")
    expected :: "true\ntrue\njet\ntrue\ntrue\njet\n"
    resident :: run_cranelift_without_fallback(source, "unicode_public_string")
    assert_eq(resident.stdout, expected)
    dir :: common.unique_tmp("jet_unicode_public_string_aot")
    fs.create_dir_all(dir).unwrap()
    jet_path :: dir.join("main.jet")
    rust_path :: dir.join("main.rs")
    binary :: dir.join("main")
    fs.write(jet_path, source).unwrap()
    compiled :: jet.compile_with_path(source, jet_path.to_string_lossy()).expect("pinned Unicode String fixture should compile")
    command := Command.new("rustc")
    runtime_lease :: add_generated_rust(&command, rust_path, compiled.rust, compiled.ffi.is_some(), [])
    rustc :: command.arg("-o").arg(binary).output().unwrap()
    assert(rustc.status.success(), "pinned Unicode AOT fixture rejected:\n{String.from_utf8_lossy(rustc.stderr)}")
    aot :: Command.new(binary).output().unwrap()
    assert(aot.status.success())
    assert_eq(String.from_utf8_lossy(aot.stdout), expected)
    _ :: fs.remove_dir_all(dir)
}
