// Rust: tests/dev_parts/routine.rs:1862
#Test("scheduler_spawn_runs_via_jit") {
    if skip_if_cranelift_host_unsupported() { return }
    file :: "Examples/features/concurrency/scheduler_spawn.jet"
    bundle := Loader.load_entry(file).expect("bundle should load")
    diags :: Sema.check_bundle(&bundle, Sema.CompileMode.Run)
    errors :: diags.into_iter().filter((d) -> d.severity == Severity.Error).collect()
    assert(errors.is_empty(), "scheduler_spawn must type-check")
    assert(common.cranelift_resident_safe(bundle), "scheduler_spawn must be resident-safe: {common.cranelift_resident_safe_detail(bundle)}")
    common.compile_cranelift_bundle(bundle, common.development_policy()).unwrap_or_else((e) -> panic("scheduler_spawn JIT compile failed: {e}"))
    got :: if dev_iteration(file, false, false) == {
        .Ran { stdout, .. } -> stdout
        .Problems(ds) -> panic("scheduler_spawn must run via default dev/JIT, got: {ds:?}")
    }
    trimmed := got.trim() // #4303
    assert_eq(trimmed, "1000")
}
