        .Problems(diags) -> panic("default dev failed exact Int equality: {diags:?}")
    }
    aot :: compiled_binary_output(dir, "exact_int_value_equality", 0, "exact_int_value_equality", shown)
    expected :: ProgramOutput.ran("true\nfalse\ntrue\n", "", 0)
    assert_eq(resident, expected)
    assert_eq(default, expected)
    assert_eq(aot, expected)
