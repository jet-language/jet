// Rust: tests/dev_parts/routine.rs:2718
#Test("unified_loop_jit_tiers_are_explicit_and_match_aot") {
    counted :: "fn run() -> {\n    loop i in 0..<4 {\n        if i == 1 { next }\n        print(i)\n    }\n}\n"
    if !skip_if_cranelift_host_unsupported() {
        native :: run_cranelift_without_fallback(counted, "counted_next")
        assert_eq(native.stdout, "0\n2\n3\n")
    }
    stride :: "fn run() -> {\n    xs := [0, 1, 2, 3, 4]\n    loop x in xs, 2 {\n        print(x)\n        if x == 0 { next }\n    }\n}\n"
    if !skip_if_cranelift_host_unsupported() {
        native :: run_cranelift_without_fallback(stride, "source_stride_next")
        assert_eq(native.stdout, "0\n2\n4\n")
        invalid :: "fn run() -> {\n    xs := [1, 2]\n    stride := 0\n    loop x in xs, stride {\n        print(x)\n    }\n}\n"
        if run_cranelift_outcome_without_fallback(invalid, "source_stride_pre_pull") == {
            .Ran { stdout, stderr, exit_code } -> {
                assert_eq(exit_code, 70, "invalid stride must exit 70: out={stdout} err={stderr}")
                assert(stdout.is_empty(), "invalid dynamic stride must stop before the first source pull, got stdout={stdout:?}")
                assert(stderr.contains("panic:") && stderr.contains("E0123"), "invalid stride must carry E0123 in panic wording, got: {stderr}")
                assert(!stderr.contains("E0953") && !stderr.contains("comptime"), "invalid stride must not use comptime voice: {stderr}")
            }
            other -> panic("invalid dynamic stride expected runtime trap, got: {other:?}")
        }
    }
}
// Rust: tests/dev_parts/routine.rs:2762
#Test("range_values_run_in_resident_jit_without_fallback") {
    if skip_if_cranelift_host_unsupported() { return }
    unboxed :: """
fn identity(band: ^Range) -> Range {
    return band
}
fn run() -> {
    band := 2..<5
    copied :: identity(band)
    print(copied)
    print(band.start)
    print(copied.contains(4))
    print(copied == band)
    bands :: [1..3, 8..<10]
    print("{bands[1]:Debug}")
    print(bands[0].start)
    print(bands[0].contains(3))
    total := 0
    loop n in copied {
        total += n
    }
    print(total)
    values :: [10, 20, 30, 40, 50, 60]
    print(~values[copied])
    band = 7..9
    print(band)
}
"""
    unboxed_proof :: std.env.temp_dir().join("jet_jit_range_unboxed_safety.jet")
    fs.write(unboxed_proof, unboxed).unwrap()
    unboxed_bundle :: checked_bundle_from_path(unboxed_proof.to_string_lossy())
    common.compile_cranelift_bundle(unboxed_bundle, common.development_policy()).unwrap_or_else((error) -> panic("unboxed Range resident compilation failed: {error}"))
    assert_eq(common.cranelift_func_safety(unboxed_bundle, "run"), ResidentJitSafety.Covered, "unboxed Range values must stay in resident JIT")
    jit.reset_struct_new_count_for_test()
    unboxed_run :: run_cranelift_without_fallback(unboxed, "range_unboxed")
    assert_eq(unboxed_run.stdout, "Range { start: 2, end: 5, exclusive: true }\n2\ntrue\ntrue\nRange { start: 8, end: 10, exclusive: true }\n1\ntrue\n9\n[30, 40, 50]\nRange { start: 7, end: 9, exclusive: false }\n")
    assert_eq(jit.struct_new_count_for_test(), 0, "Range construct/copy/pass/return/list/field/contains/show/equality/loop/slice must not call struct_new")
    src :: """
fn identity(band: ^Range) -> Range {
    return band
}
fn run() -> {
    band :: 2..<5
    copied :: identity(band)
    print(copied == band)
    bands :: [1..3, 8..<10]
    print(bands[0])
    print("{bands[1]:Debug}")
    print(bands[0].contains(3))
    print(band)
    print("{band}")
    print("{band:Debug}")
    print(band == (2..<5))
    print(band == (2..5))
    print(band.start)
    print(band.end)
    print(band.contains(4))
    print((5..2).contains(3))
    total := 0
    loop n in band {
        total += n
    }
    print(total)
    values := [10, 20, 30, 40, 50, 60]
    print(~values[band])
    edit :: &values[band]
    edit[0] = 99
    print(values)
}
"""
    proof :: std.env.temp_dir().join("jet_jit_range_value_safety.jet")
    fs.write(proof, src).unwrap()
    bundle :: checked_bundle_from_path(proof.to_string_lossy())
    common.compile_cranelift_bundle(bundle, common.development_policy()).unwrap_or_else((error) -> panic("Range resident compilation failed: {error}"))
    assert_eq(common.cranelift_func_safety(bundle, "run"), ResidentJitSafety.Covered, "Range values and windows must stay in resident JIT")
    native :: run_cranelift_without_fallback(src, "range_values")
    expected :: "true\nRange { start: 1, end: 3, exclusive: false }\nRange { start: 8, end: 10, exclusive: true }\ntrue\nRange { start: 2, end: 5, exclusive: true }\nRange { start: 2, end: 5, exclusive: true }\nRange { start: 2, end: 5, exclusive: true }\ntrue\nfalse\n2\n5\ntrue\nfalse\n9\n[30, 40, 50]\n[10, 20, 99, 40, 50, 60]\n"
    assert_eq(native.stdout, expected)
    dir :: common.unique_tmp("jet_range_value_interpreter")
    fs.create_dir_all(dir).unwrap()
    path :: dir.join("main.jet")
    fs.write(path, src).unwrap()
    if dev_iteration(path.to_string_lossy(), false, true) == {
        .Ran { stdout, .. } -> assert_eq(stdout, expected)
        .Problems(diags) -> panic("Range views must run in the canonical evaluator: {diags:?}")
    }
    _ :: fs.remove_dir_all(dir)
}
