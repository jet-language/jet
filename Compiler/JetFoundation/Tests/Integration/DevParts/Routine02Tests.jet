#Test("decimal_scale_arithmetic_matches_interpreter_default_jit_and_aot") {
    if skip_if_cranelift_host_unsupported() || !have_rustc() { return }
    guard :: lock_recovered(dev_diff_lock(), "dev_diff_lock")
    dir :: common.unique_tmp("jet_decimal_scale_parity")
    fs.create_dir_all(dir).unwrap()
    file :: dir.join("decimal_scale.jet")
    source :: """fn run() -> {
    left :: 1.20
    right :: 2.30
    print(left + right)
    print(right - left)
    print(9.5 * 2.0)
}
"""
    fs.write(file, source).unwrap()
    shown :: file.to_string_lossy().into_owned()
    expected :: ProgramOutput.ran("3.50\n1.10\n19.0\n", "", 0)
    interpreted :: if dev_iteration(shown, false, true) == {
        .Ran { stdout, stderr, exit_code } -> ProgramOutput.ran(stdout, stderr, exit_code)
        .Problems(diags) -> panic("Decimal interpreter failed: {diags:?}")
    }
    jit.reset_jit_trace_for_test()
    resident :: run_cranelift_without_fallback(source, "decimal_scale_parity")
    assert(jit.jit_executed_for_test(), "Decimal scale arithmetic must execute in resident JIT")
    assert(!jit.deopt_invoked_for_test() && !jit.fallback_invoked_for_test(), "Decimal scale arithmetic must not use interpreter fallback")
    default :: if dev_iteration(shown, false, false) == {
        .Ran { stdout, stderr, exit_code } -> ProgramOutput.ran(stdout, stderr, exit_code)
        .Problems(diags) -> panic("Decimal default run failed: {diags:?}")
    }
    aot :: compiled_binary_output(dir, "decimal_scale_parity", 0, "decimal_scale", shown)
    assert_eq(interpreted, expected, "Decimal interpreter scale drift")
    assert_eq(resident, expected, "Decimal resident JIT scale drift")
    assert_eq(default, expected, "Decimal default JIT scale drift")
    assert_eq(aot, expected, "Decimal AOT scale drift")
    _ :: fs.remove_dir_all(dir)
}
