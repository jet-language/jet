// Rust: tests/dev_parts/routine.rs:3612
#Test("solver_state_transitions_match_aot_in_resident_jit") {
    if skip_if_cranelift_host_unsupported() || !have_rustc() { return }
    source_path :: "Examples/features/tooling/solve_puzzle.jet"
    src :: fs.read_to_string(source_path).expect("read solve_puzzle example")
    native :: run_cranelift_without_fallback(src, "solve_puzzle")
    compiled :: jet.compile_with_path(src, source_path).expect("compile solve_puzzle")
    dir :: std.env.temp_dir().join("jet_solver_jit_parity_{std.process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).unwrap()
    rs :: dir.join("solve_puzzle.rs")
    bin :: dir.join("solve_puzzle")
    command := Command.new("rustc") // GATE #4494
    runtime_lease :: add_generated_rust(&command, rs, compiled.rust, compiled.ffi.is_some(), [])
    rustc :: command.arg("-o").arg(bin).output().expect("run rustc")
    assert(rustc.status.success(), "rustc failed: {String.from_utf8_lossy(rustc.stderr)}")
    output :: Command.new(bin).output().expect("run AOT solve_puzzle")
    aot :: ProgramOutput.ran(String.from_utf8_lossy(output.stdout).into_owned(), String.from_utf8_lossy(output.stderr).into_owned(), output.status.code().unwrap_or(1))
    assert_eq(native, aot, "Solver state drifted between resident JIT and AOT")
    assert_eq(native.stdout, "key=1 door=3\nkey=3 door=1\nwins=2\nstatus=failed\nfailures=7\n")
    _ :: fs.remove_dir_all(dir)
}
