#Test("uninit_fixed_mutating_borrow_matches_interpreter_resident_jit_and_aot") {
    source :: "\nuse core.mem\n\nfn set_first(bytes: &[U8#2]) {{\n    bytes[0] = 8\n}}\n\nfn first(bytes: [U8#2]) -> U8 {{\n    index :: 0\n    return bytes[index]\n}}\n\nfn run() {{\n    bytes := [U8#2]{{ uninit }}\n    bytes[0] = 1\n    bytes[1] = 2\n    set_first(&bytes)\n    print(bytes[0])\n    print(first(bytes))\n}}\n"
    file :: routine03_fixture("uninit_fixed_mutating_borrow", source)
    routine03_golden(file.clone(), "8\n8\n", "", 0)
    _ :: fs.remove_dir_all(file.parent().unwrap())
}
// Rust: tests/dev_parts/routine.rs:4383
#Test("uninit_fixed_dynamic_oob_uses_the_resident_jit_trap_path") {
    source :: "\nuse core.mem\n\nfn outside() -> Int {{\n    return 2\n}}\n\nfn run() {{\n    bytes := [U8#2]{{ uninit }}\n    bytes[0] = 1\n    bytes[1] = 2\n    print(bytes[outside()])\n}}\n"
    file :: routine03_fixture("uninit_fixed_dynamic_oob", source)
    bundle := Loader.load_entry(file.to_str().unwrap()).unwrap()
    diagnostics :: Sema.check_bundle(&bundle, Sema.CompileMode.Run)
    errors :: diagnostics.iter().filter((diagnostic) -> diagnostic.severity == Diagnostics.Severity.Error).collect()
    assert(errors.is_empty(), "{errors:Debug}")
    for tier in ["O0", "O1", "O2", "Web"] {
        (exit_code, stdout, stderr) :: routine03_output(file.clone(), tier)
        assert_eq(exit_code, 70, "dynamic OOB must exit 70: out={stdout} err={stderr}")
        assert(stderr.contains("Stop [E3010]") && stderr.contains("the list has 2 items") && stderr.contains("doesn't exist"), "dynamic OOB trap wording: {stderr}")
        assert(!stderr.contains("E0953") && !stderr.contains("comptime"), "dynamic OOB must not use comptime voice: {stderr}")
    }
    _ :: fs.remove_dir_all(file.parent().unwrap())
}
