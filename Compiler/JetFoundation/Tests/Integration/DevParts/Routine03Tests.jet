    source :: "\nfn remainder(value: I8, divisor: I8) -> I8 {{\n    return value % divisor\n}}\n\nfn run() {{\n    print(remainder(I8.MIN, I8{{-1}}))\n}}\n"
    file :: routine03_fixture("fixed_width_remainder_trap", source)
    bundle :: checked_bundle_from_path(file.to_string_lossy())
    // D-MODSEM1: MIN % -1 is zero and fits; no trap is expected.
