// Rust: tests/dev_parts/routine.rs:3658
#Test("resident_jit_result_abi_covers_calls_ok_err_try_and_entry") {
    success :: "\nfn choose_ok() -> Float String! {{\n    return Ok(0.25)\n}}\n\nfn choose_err() -> Float String! {{\n    return Err(\"typed boom\")\n}}\n\nfn forward() -> Float String! {{\n    value :: choose_ok()\n    return Ok(value + 0.25)\n}}\n\nfn run() {{\n    print(forward())\n}}\n"
    failure :: success.replace("choose_ok()", "choose_err()")
    for (source, tag) in [(success, "result_success"), (failure, "result_failure")] {
        file :: env.temp_dir().join("jet_jit_result_{tag}.jet")
        fs.write(&file, source).unwrap()
        shown :: file.to_string_lossy().into_owned()
        if tag == "result_success" {
            routine03_golden(file.clone(), "0.5\n", "", 0)
        } else {
            // D-FAIL-CTX1: same fixture path on every tier, origin first, two automatic crossings.
            routine03_golden(file.clone(), "", "Error: typed boom\n Trail [E3002] (2 hops via ?, origin first):\n  1. forward ({shown}:11)\n  2. run ({shown}:16)\n", 1)
        }
        _ :: fs.remove_file(file)
    }
}
// Rust: tests/dev_parts/routine.rs:3746
#Test("resident_jit_fallible_void_cfg_fallthrough_matches_aot") {
    one_arm :: "\nfn direct_ok() -> Int {{\n    return Ok(7)\n}}\n\nfn run() {{\n    print(direct_ok())\n    stop :: false\n    if stop {{\n        return Err(\"one-arm stopped\")\n    }}\n    print(\"one-arm fallthrough\")\n}}\n"
    nested :: "\nfn direct_ok() -> Int {{\n    return Ok(7)\n}}\n\nfn run() {{\n    print(direct_ok())\n    outer :: true\n    inner :: false\n    if outer {{\n        if inner {{\n            return Err(\"nested stopped\")\n        }}\n    }}\n    print(\"nested fallthrough\")\n}}\n"
    neither :: "\nfn direct_ok() -> Int {{\n    return Ok(7)\n}}\n\nfn run() {{\n    print(direct_ok())\n    if true {{\n        print(\"left continues\")\n    }} else {{\n        print(\"right continues\")\n    }}\n    print(\"neither terminated\")\n}}\n"
    both :: "\nfn direct_ok() -> Int {{\n    return Ok(7)\n}}\n\nfn run() {{\n    print(direct_ok())\n    if true {{\n        return Err(\"left branch\")\n    }} else {{\n        return Err(\"right branch\")\n    }}\n}}\n"
    for (tag, source, stdout, stderr, exit_code) in [
        ("one_arm_fallthrough", one_arm, "7\none-arm fallthrough\n", "", 0),
        ("nested_fallthrough", nested, "7\nnested fallthrough\n", "", 0),
        ("neither_arm_terminates", neither, "7\nleft continues\nneither terminated\n", "", 0),
        ("both_arms_terminate", both, "7\n", "Error: left branch\n", 1)
    ] {
        file :: routine03_fixture(tag, source)
        routine03_golden(file.clone(), stdout, stderr, exit_code)
        _ :: fs.remove_dir_all(file.parent().unwrap())
    }
}
// Rust: tests/dev_parts/routine.rs:3865
#Test("resident_jit_fidelity_matches_runtime_contract") {
    valid :: "\nuse core.perf as perf\n\nfn run() {{\n    perf.reset_fidelity()\n    print(perf.default_fidelity())\n    perf.override_fidelity(0.25)\n    print(perf.fidelity())\n    perf.reset_fidelity()\n    print(perf.fidelity())\n}}\n"
    file :: routine03_fixture("fidelity_valid", valid)
    routine03_golden(file.clone(), "1.0\n0.25\n1.0\n", "", 0)
    _ :: fs.remove_dir_all(file.parent().unwrap())
    for (value, tag) in [("-0.01", "negative"), ("1.01", "above_one"), ("(1.0 / 0.0)", "infinite"), ("(0.0 / 0.0)", "nan")] {
        source :: "use core.perf as perf\nfn run() {{\n    perf.reset_fidelity()\n    perf.override_fidelity(0.375)\n    perf.override_fidelity({value})\n}}"
        file :: routine03_fixture(tag, source)
        // Run the state assertion in the same invocation so native/Web process isolation cannot reset fidelity.
        read_file :: routine03_fixture("{tag}_state", "use core.perf as perf\nfn run() {{\n    perf.reset_fidelity()\n    perf.override_fidelity(0.375)\n    if perf.override_fidelity({value}) == {{\n        .Err(_) -> print(perf.fidelity())\n        .Ok(_) -> panic(\"invalid fidelity unexpectedly accepted\")\n    }}\n}}")
        for tier in ["O0", "O1", "O2", "Web"] {
            (exit_code, _, stderr) :: routine03_output(file.clone(), tier)
            assert_eq(exit_code, 1, "{tag} must fail")
            assert(stderr.contains("OutOfRange") && stderr.contains("PerfError"), "{tag}: {stderr:Debug}")
            assert_eq(routine03_output(read_file.clone(), tier), (0, "0.375\n", ""), "{tag} changed fidelity before returning Err")
        }
        _ :: fs.remove_dir_all(file.parent().unwrap())
        _ :: fs.remove_dir_all(read_file.parent().unwrap())
    }
}
// Rust: tests/dev_parts/routine.rs:3945
#Test("unsafe_blocks_are_evaluated_by_canonical_mir_with_live_sentries") {
    raw :: Loader.load_entry(&example_path("memory/rawptr")).expect("rawptr example should load")
    fault_path :: env.temp_dir().join("jet_unsafe_mir_runtime_{process.id()}.jet")
    fs.write(&fault_path, "use core.mem\nfn run() {{\n    #Unsafe(\"mapped address is valid and aligned\") {{\n        p :: mem.Ptr<Int>.from_addr(0x40000100)\n        print(p.*)\n    }}\n}}\n").unwrap()
    fault_file :: fault_path.to_string_lossy().into_owned()
    fault_bundle :: Loader.load_entry(&fault_file).expect("pointer cast example should load")
    for tier in ["O0", "O1", "O2", "Web"] {
        (exit_code, stdout, stderr) :: routine03_output(fault_path.clone(), tier)
        assert_eq(exit_code, 70, "a raw read with no allocation provenance is a program-side stop: {stderr}")
        assert(stdout.is_empty(), "the refused deref must not have printed: {stdout:Debug}")
        for marker in ["Runtime fault [R0801]", "mapped address is valid and aligned", "no live allocation contains this address", "obligation `valid_ptr` was not met on this run"] {
            assert(stderr.contains(marker), "{tier} sentry report is missing `{marker}`: {stderr}")
        }
    }
    _ :: fs.remove_file(fault_path)
}
// Rust: tests/dev_parts/routine.rs:3996
#Test("io_style_raw_nonunicode_no_color_uses_presence_semantics") {
    if selected_family() != "unix" { return }
    // The raw presence seam is essential: captured stdout alone cannot establish NO_COLOR handling.
    // Rust generated-program peer comparator retained; never a production Rust callback.
    thread.Builder.new().spawn(() -> {
        source :: "use core.term as io\nfn run() {{\n    print(io.style(\"red\", \"plain\"))\n}}\n"
        dir :: common.unique_tmp("jet_raw_no_color")
        fs.create_dir_all(&dir).unwrap()
        input :: dir.join("raw_no_color.jet")
        fs.write(&input, source).unwrap()
        compiled :: jet.compile_with_path(source, input.to_str().unwrap()).expect("raw NO_COLOR fixture must compile")
        rust :: dir.join("raw_no_color.rs")
        bin :: dir.join("raw_no_color_test")
        probe :: "\nfn jet_probe_no_color_presence() {{\n    assert!(jet_env_value_raw(\"NO_COLOR\").is_some());\n    assert!(jet_std_env_get(&\"NO_COLOR\".to_string()).is_none());\n    let no_color = jet_env_value_raw(\"NO_COLOR\").is_some();\n    let force_color = jet_env_value_raw(\"FORCE_COLOR\").is_some();\n    assert!(no_color, \"set-but-non-Unicode NO_COLOR must register as present\");\n    assert!(!jet_term_style_enabled(no_color, force_color, true));\n    let styled = jet_std_io_style(&\"red\".to_string(), &\"plain\".to_string());\n    assert_eq!(styled, \"plain\");\n}}\n"
        MAIN_ANCHOR :: "fn main() {{\n    jet_std_env_init();"
        assert_eq(compiled.rust.matches(MAIN_ANCHOR).count(), 1, "generated `main` no longer starts with `jet_std_env_init();` -- re-anchor this probe, do not skip it")
        hooked :: compiled.rust.replacen(MAIN_ANCHOR, "{MAIN_ANCHOR}\n    jet_probe_no_color_presence();", 1)
        generated :: "{hooked}{probe}"
        assert(compiled.ffi.is_none(), "raw NO_COLOR fixture must not need FFI")
        fs.write(&rust, &generated).unwrap()
        built :: Command.new("rustc").args(["--edition", "2021", "--crate-name", "raw_no_color"]).arg(&rust).arg("-o").arg(&bin).output().unwrap()
        assert(built.status.success(), "rustc rejected raw NO_COLOR probe:\n{String.from_utf8_lossy(&built.stderr)}")
        run :: Command.new(&bin).env("NO_COLOR", std.ffi.OsString.from_vec([U8{0xff}])).output().unwrap()
        assert(run.status.success(), "raw NO_COLOR presence probe failed:\nstdout:\n{String.from_utf8_lossy(&run.stdout)}\nstderr:\n{String.from_utf8_lossy(&run.stderr)}")
        assert_eq(String.from_utf8_lossy(&run.stdout), "plain\n")
        _ :: fs.remove_dir_all(dir)
    }).unwrap().join().unwrap()
}
// Rust: tests/dev_parts/routine.rs:4128
#Test("jit_1216_adversarial_regressions") {
    CASE :: "JET_1216_ADVERSARIAL_CASE"
    if env.var(CASE) == {
        .Ok(case) -> {
            source :: if case == {
                "oob" -> "fn run() {{ xs := [1]\n xs[4] = 2 }}\n"
                "stm_return" -> "\nstruct Slot {{ value: Int }}\nfn rollback(cell: Shared<Slot>) {{\n    #Transact(tx) {{\n        cell.value = 9\n        return\n    }}\n}}\nfn run() {{\n    cell :: shared Slot{{value: 1}}\n    rollback(cell)\n    print(cell.value)\n}}\n"
                "generator" -> "\nfn stopped() -> Stream<Int> {{\n    yield 1\n    yield 2\n}}\nfn closes() -> Stream<Int> {{\n    yield 3\n    return\n}}\nfn run() {{\n    loop value in stopped() {{\n        print(value)\n        break\n    }}\n    loop value in closes() {{ print(value) }}\n    print(\"done\")\n}}\n"
                "raw_alias" -> "\nuse core.mem\nfn run() {{\n    value := 4\n    #Unsafe(\"the pointer stays inside this stack frame\") {{\n        pointer :: *Int{{*value}}\n        mem.volatile_write(pointer, 9)\n        print(value)\n    }}\n}}\n"
                "option_minus_one" -> "\nfn run() {{\n    queue := PriorityQueue.from([-1])\n    print(&queue.pop())\n    print(&queue.pop())\n}}\n"
                "sum_bigint" -> "\nfn run() {{\n    print([Int.MAX, 1].sum())\n}}\n"
                else -> panic("unknown #1216 adversarial case `{case}`")
            }
            file :: routine03_fixture("1216_{case}", source)
            for tier in ["O0", "O1", "O2", "Web"] {
                (exit_code, stdout, stderr) :: routine03_output(file.clone(), tier)
                if case == "oob" {
                    assert_eq(exit_code, 70, "`{case}` must exit 70: err={stderr}")
                    assert(stderr.contains("Stop [E3010]"), "`{case}` must use the E3010 stop, got: {stderr}")
                    assert(!stderr.contains("E0953") && !stderr.contains("comptime"), "`{case}` must not use comptime voice: {stderr}")
                    assert(stderr.contains("the list has 1 items, so position 4 doesn't exist"), "`oob` trap wording: {stderr}")
                } else {
                    expected :: if case == {
                        "stm_return" -> "1\n"
                        "generator" -> "1\n3\ndone\n"
                        "raw_alias" -> "9\n"
                        "option_minus_one" -> "-1\nnull\n"
                        "sum_bigint" -> "9223372036854775808\n"
                        else -> panic("unknown adversarial case")
                    }
                    assert_eq(stdout, expected, "{tier}: {case}")
                }
            }
            _ :: fs.remove_dir_all(file.parent().unwrap())
            return
        }
        .Err(_) -> {}
    }
    for case in ["oob", "stm_return", "generator", "raw_alias", "option_minus_one", "sum_bigint"] {
        command := Command.new(env.current_exe().expect("current dev test binary"))
        command.args(["--exact", "jit_1216_adversarial_regressions", "--nocapture"]).env(CASE, case).env("NO_COLOR", "1")
        output :: command_output_with_timeout(^command, Duration.from_secs(10), "#1216 adversarial `{case}`")
        assert(output.status.success(), "{case}: stdout:\n{String.from_utf8_lossy(&output.stdout)}\nstderr:\n{String.from_utf8_lossy(&output.stderr)}")
    }
}
