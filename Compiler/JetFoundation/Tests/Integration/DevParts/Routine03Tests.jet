}
// Rust: tests/dev_parts/routine.rs:4953
#Test("fixed_width_and_plain_int_remainder_zero_traps_across_tiers") {
    for (tag, source) in [
        ("fixed_width", "\nfn remainder(value: I8, divisor: I8) -> I8 {{\n    return value % divisor\n}}\n\nfn run() {{\n    print(remainder(I8{{7}}, I8{{0}}))\n}}\n"),
        ("plain_int", "\nfn remainder(value: Int, divisor: Int) -> Int {{\n    return value % divisor\n}}\n\nfn run() {{\n    print(remainder(19, 0))\n}}\n")
    ] {
        file :: routine03_fixture("remainder_zero_{tag}", source)
        bundle :: checked_bundle_from_path(file.to_string_lossy())
        baseline: String? := None
        for tier in ["O0", "O1", "O2", "Web"] {
            (exit_code, stdout, stderr) :: routine03_output(file.clone(), tier)
            assert_eq(exit_code, 70, "{tag} {tier} must exit 70: out={stdout} err={stderr}")
            assert(stderr.contains("Stop [E3010]") && stderr.contains("divided by zero"), "{tag} {tier} trap wording: {stderr}")
            assert(!stderr.contains("E0953") && !stderr.contains("comptime"), "{tag} {tier} must not use comptime voice: {stderr}")
            assert(!stderr.contains("panicked at"), "{tag} leaked a raw Rust panic")
            if baseline == { .Val(expected) -> assert_eq(stdout, expected, "{tag} stdout tier drift") .None -> baseline = Val(stdout) }
        }
        _ :: fs.remove_dir_all(file.parent().unwrap())
    }
}
// Rust: tests/dev_parts/routine.rs:5080
#Test("fixed_width_mixed_sign_shift_counts_trap_across_tiers") {
    cases :: [
        ("shl_negative", "U8", "I8", "U8{{1}}", "I8{{-1}}", "<<", "shifting left by -1 bits is out of range (this type is 8 bits wide)"),
        ("shr_negative", "U8", "I8", "U8{{1}}", "I8{{-1}}", ">>", "shifting right by -1 bits is out of range (this type is 8 bits wide)"),
        ("shl_huge", "I8", "U64", "I8{{1}}", "U64.MAX", "<<", "shifting left by 18446744073709551615 bits is out of range (this type is 8 bits wide)"),
        ("shr_width", "U8", "U8", "U8{{1}}", "U8{{8}}", ">>", "shifting right by 8 bits is out of range (this type is 8 bits wide)")
    ]
    for (tag, value_ty, count_ty, value, count, operator, trap) in cases {
        source :: "fn shift(value: {value_ty}, count: {count_ty}) -> {value_ty} {{\n    return value {operator} count\n}}\n\nfn run() {{\n    print(shift({value}, {count}))\n}}\n"
        file :: routine03_fixture(tag, source)
        bundle :: checked_bundle_from_path(file.to_string_lossy())
        baseline: String? := None
        for tier in ["O0", "O1", "O2", "Web"] {
            (exit_code, stdout, stderr) :: routine03_output(file.clone(), tier)
            assert_eq(exit_code, 70, "{tag} {tier} must exit 70: out={stdout} err={stderr}")
            assert(stderr.contains("Stop [E3010]") && stderr.contains(trap), "{tag} {tier} trap wording: {stderr}")
            assert(!stderr.contains("E0953") && !stderr.contains("comptime"), "{tag} {tier} must not use comptime voice: {stderr}")
            assert(!stderr.contains("panicked at"), "{tag} leaked a raw Rust panic")
            if baseline == { .Val(expected) -> assert_eq(stdout, expected, "{tag} stdout tier drift") .None -> baseline = Val(stdout) }
        }
        _ :: fs.remove_dir_all(file.parent().unwrap())
    }
}
