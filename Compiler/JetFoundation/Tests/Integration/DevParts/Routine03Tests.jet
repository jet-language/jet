#Test("numeric_singleton_splits_match_resident_jit_and_aot_without_fallback") {
    source :: "\nfn run() {{\n    values := [1.5, 2.5, 3.5]\n    first :: &values[0]\n    last :: &values[2]\n    first = 4.5\n    last = 6.5\n    first += 1.25\n    last += 0.25\n    print(first)\n    print(last)\n    print(values[0])\n    print(values[2])\n\n    counts := [1, 2, 3]\n    low :: &counts[0]\n    high :: &counts[2]\n    low += 4\n    high += 6\n    low &= 6\n    low <<= 1\n    high ~|= 10\n    high |= 8\n    print(low)\n    print(high)\n    print(counts[0])\n    print(counts[2])\n}}\n"
    file :: routine03_fixture("numeric_singleton_splits", source)
    bundle :: checked_bundle_from_path(file.to_string_lossy())
    routine03_golden(file.clone(), "5.75\n6.75\n5.75\n6.75\n8\n11\n8\n11\n", "", 0)
    _ :: fs.remove_dir_all(file.parent().unwrap())
}
