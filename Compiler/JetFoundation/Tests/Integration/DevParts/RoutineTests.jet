    source :: """
struct Window { values: View<Int> }
struct Holder { maybe: Window? }
struct GenericHolder<T> { value: T, maybe: Window? }
struct Node { next: Node?, values: View<Int> }
fn maybe(values: [Int]) -> (Window?) {
    selected :: values[0..1]
    return Val(Window{ values: selected })
}
fn result(values: [Int]) -> Window String! {
    selected :: values[0..1]
    return Ok(Window{ values: selected })
}
fn tuple(values: [Int]) -> (window: Window, count: Int) {
    selected :: values[0..1]
    return (window: Window{ values: selected }, count: 1)
}
fn node(values: [Int]) -> Node {
    selected :: values[0..1]
    return Node{ next: None, values: selected }
}
fn run() { print(0) }
"""
    fs.write(&file, source).unwrap()
    shown :: file.to_string_lossy().to_string()
    aot :: compiled_binary_output(&dir, "wrapped_returned_view_fields", 0, "wrapped_returned_view_fields", &shown)
    assert_eq(aot.stdout, "0\n")
    assert_native_profiles(&shown, &aot)
    tir_support.assert_tiers_agree("wrapped_returned_view_fields", source, "0\n")
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/dev_parts/routine.rs:1360
#Test("returned_string_view_field_matches_all_execution_tiers") {
    dir :: env.temp_dir().join("jet_returned_string_view_{process.id()}")
    fs.create_dir_all(&dir).unwrap()
    file :: dir.join("returned_string_view.jet")
    source :: """
struct Parsed { source: String, head: View<str> }
fn parse(source: String) -> Parsed {
    head :: source.before(":")
    return Parsed{ source: source, head: head }
}
fn run() {
    left := "name"
    right := "value"
    source := "{left}:{right}"
    result :: parse(source)
    print(result.head)
    print("wrapped: {result.head}")
    expected :: "name"
    print("wrapped: {expected}")
}
"""
    fs.write(&file, source).unwrap()
    shown :: file.to_string_lossy().to_string()
    aot :: compiled_binary_output(&dir, "returned_string_view", 0, "returned_string_view", &shown)
    expected :: ProgramOutput.ran("name\nwrapped: name\nwrapped: name\n", "", 0)
    assert_eq(aot, expected, "AOT View<str> interpolation drifted from String")
    assert_native_profiles(&shown, &expected)
    tir_support.assert_tiers_agree("returned_string_view", source, expected.stdout)
    _ :: fs.remove_dir_all(&dir)
}
