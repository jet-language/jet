// Rust: tests/dev_parts/routine.rs:945
#Test("watching_dev_deopts_on_gap_edit_and_recovers") {
    dir :: env.temp_dir().join("jet_watch_deopt_{process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    file :: dir.join("watch_gap.jet")
    fs.write(&file, "fn run() {\n    print(\"ok1\")\n}\n").unwrap()
    shown :: file.to_string_lossy().to_string()
    child := Command.new(common.jet_bin()).args(["dev", &shown]).env("NO_COLOR", "1").stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().expect("spawn watching jet dev")
    thread.sleep(Duration.from_millis(800))
    fs.write(&file, "use core.sys as env\nfn run() {\n    print(env.current_dir())\n}\n").unwrap()
    thread.sleep(Duration.from_millis(800))
    fs.write(&file, "fn run() {\n    print(\"ok2\")\n}\n").unwrap()
    thread.sleep(Duration.from_millis(800))
    _ :: child.kill()
    out :: child.wait_with_output().expect("watching jet dev output")
    stdout :: String.from_utf8_lossy(&out.stdout)
    stderr :: String.from_utf8_lossy(&out.stderr)
    assert(stdout.contains("ok1"), "stdout:\n{stdout}")
    assert(!stderr.contains("E2211") && !stdout.contains("E2211"), "retired E2211 must not appear\nstdout:\n{stdout}\nstderr:\n{stderr}")
    assert(stdout.contains("ok2"), "stdout:\n{stdout}")
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/dev_parts/routine.rs:993
#Test("persist_example_survives_hot_reload") {
    root :: OSPath(env!("CARGO_MANIFEST_DIR"))
    source :: root.join("Examples/features/devloop/persist.jet")
    dir :: common.unique_tmp("jet_dev_persist_example")
    fs.create_dir_all(&dir).unwrap()
    file :: dir.join("persist.jet")
    original :: fs.read(&source).unwrap()
    fs.write(&file, &original).unwrap()
    shown :: file.to_string_lossy().to_string()
    child := Command.new(common.jet_bin()).args(["dev", &shown, "--swap"]).env("NO_COLOR", "1").stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().expect("spawn persist example jet dev")
    stdout :: child.stdout.take().unwrap()
    (lines_tx, lines_rx) :: mpsc.channel()
    _ :: thread.spawn(fn[^stdout, ^lines_tx]() {
        loop line in BufReader.new(stdout).lines() {
            if lines_tx.send(line).is_err() -> break
        }
    })
    wait_for :: fn(expected: &String) {
        loop {
            line :: lines_rx.recv_timeout(Duration.from_secs(30)).expect("persist example output").expect("persist example stdout line")
            if line == expected -> break
        }
    }
    wait_for("1")
    compatible :: String.from_utf8(original.clone()).unwrap().replace("print(\"{counter}\")", "print(\"count={counter}\")")
    fs.write(&file, compatible).unwrap()
    wait_for("count=2")
    shape_changed :: String.from_utf8(original).unwrap().replace("#Persist counter := 0", "#Persist counter := 0.0").replace("print(\"{counter}\")", "print(\"count={counter}\")")
    fs.write(&file, shape_changed).unwrap()
    wait_for("count=1.0")
    _ :: child.kill()
    _ :: child.wait_with_output().expect("stop persist example jet dev")
    _ :: fs.remove_dir_all(&dir)
}
