// Rust: tests/dev_parts/routine.rs:1629
#Test("dev_default_tls_peer_identity_matches_aot_and_interpreter") {
    _guard :: lock_recovered(dev_diff_lock(), "dev_diff_lock")
    scratch :: common.Scratch.new("tls-peer-identity")
    dir :: scratch.path.as_path()
    fs.write(dir.join("package.jet"), "name: \"tls_peer_identity\"\nversion: \"0.1.0\"\nauthority: { holds: { allow: [IO, Mem.Alloc, Net, Time.Wait] } }\n").unwrap()
    root :: OSPath(env!("CARGO_MANIFEST_DIR"))
    ca_cert :: root.join("tests/fixtures/tls/localhost.cert.pem")
    ca_key :: root.join("tests/fixtures/tls/localhost.key.pem")
    serial :: dir.join("ca.srl")
    server_cert :: dir.join("server.cert.pem")
    server_key :: dir.join("server.key.pem")
    csr :: dir.join("server.csr.pem")
    ext :: dir.join("server.ext")
    fs.write(&ext, "basicConstraints=critical,CA:FALSE\nsubjectAltName=DNS:localhost\nextendedKeyUsage=serverAuth\n").unwrap()
    req :: Command.new("openssl").args(["req", "-new", "-newkey", "rsa:2048", "-nodes", "-subj", "/CN=localhost", "-keyout"]).arg(&server_key).arg("-out").arg(&csr).output().unwrap()
    assert(req.status.success(), "{String.from_utf8_lossy(&req.stderr)}")
    sign :: Command.new("openssl").args(["x509", "-req", "-days", "1", "-CAcreateserial", "-CAserial"]).arg(&serial).arg("-CA").arg(&ca_cert).arg("-CAkey").arg(&ca_key).arg("-extfile").arg(&ext).arg("-in").arg(&csr).arg("-out").arg(&server_cert).output().unwrap()
    assert(sign.status.success(), "{String.from_utf8_lossy(&sign.stderr)}")
    root_bytes :: fs.read(&ca_cert).unwrap()
    jet_bytes :: fn(bytes: &[U8]) { bytes.iter().map(fn(byte) { byte.to_string() }).collect().join(", ") }
    source_for :: fn(port: U16) {
        roots :: jet_bytes(&root_bytes)
        """
use core.net as net
use core.net.tls as tls
fn run() {
    roots :: tls.RootCertificates.from_pem([U8]{ {roots} }) ?? panic("roots")
    cfg :: tls.ClientConfig.default().with_trust(.CustomOnly(roots)) ?? panic("trust")
    cfg2 :: cfg.with_version_bounds(min: .TLS13, max: .TLS13) ?? panic("versions")
    tcp :: net.tcp_connect("127.0.0.1:{port}") ?? panic("tcp")
    budget :: Duration.seconds(2) ?? panic("deadline")
    secure := tls.client(^tcp, server_name: "localhost", config: cfg2, deadline: budget) ?? panic("tls")
    peer :: secure.peer_identity()
    if peer.verified_server_name != "localhost" { panic("server name") }
    print(peer.verified_server_name)
    print(peer.cipher_suite)
    print(peer.tls_version)
    if !peer.cipher_suite.starts_with("TLS13_") { panic("cipher") }
    if peer.tls_version != .TLS13 { panic("version") }
    crlf :: String.from_bytes([U8]{13, 10}) ?? panic("CRLF")
    secure.write_text("GET / HTTP/1.0{crlf}Host: localhost{crlf}{crlf}") ?? panic("request")
    response := ""
    response_reads := 0
    loop response_reads < 8 && !response.contains("<HTML>") {
        chunk :: secure.read_text(512) ?? panic("response")
        if chunk == "" -> break
        response = "{response}{chunk}"
        response_reads = response_reads + 1
    }
    if !response.contains("<HTML>") { panic("response body") }
    print("tls-response-ok")
    secure.close() ?? panic("close")
}
"""
    }
    wait_ready :: fn(port: U16) {
        loop _ in 0..<50 {
            if TcpStream.connect(("127.0.0.1", port)).is_ok() -> return
            thread.sleep(Duration.from_millis(50))
        }
        panic("openssl TLS 1.3 server did not accept on 127.0.0.1:{port}")
    }
    start_server :: fn(port: U16) {
        server :: TlsServer{child: Command.new("openssl").args(["s_server", "-quiet", "-www", "-tls1_3", "-accept", &port.to_string(), "-cert"]).arg(&server_cert).arg("-key").arg(&server_key).arg("-cert_chain").arg(&ca_cert).stdout(Stdio.null()).stderr(Stdio.null()).spawn().expect("openssl TLS 1.3 server")}
        wait_ready(port)
        server
    }
    fresh_port :: fn() {
        probe :: TcpListener.bind("127.0.0.1:0").unwrap()
        port :: probe.local_addr().unwrap().port()
        drop(probe)
        port
    }
    aot_port :: fresh_port()
    file :: dir.join("tls_peer_identity.jet")
    fs.write(&file, source_for(aot_port)).unwrap()
    server :: start_server(aot_port)
    shown :: file.to_string_lossy().to_string()
    aot :: compiled_binary_output(dir, "tls_peer_identity_aot", 0, "tls_peer_identity", &shown)
    drop(server)
    assert_eq(aot.exit_code, 0, "AOT stderr: {aot.stderr}")
    loop profile in ["debug", "dev", "release"] {
        port :: fresh_port()
        fs.write(&file, source_for(port)).unwrap()
        server :: start_server(port)
        output :: native_profile_output(&shown, profile)
        drop(server)
        assert_eq(output.stdout, aot.stdout, "{profile} stdout differed from AOT")
        assert_eq(output.stderr, aot.stderr, "{profile} stderr differed from AOT")
        assert_eq(output.exit_code, 0, "{profile} stderr: {output.stderr}")
    }
    aot_lines := aot.stdout.lines()
    assert_eq(aot_lines.next(), .Some("localhost"))
    assert(aot_lines.next().is_some_and(fn(cipher) { cipher.starts_with("TLS13_") }))
    assert_eq(aot_lines.next(), .Some("TLS13"))
    assert_eq(aot_lines.next(), .Some("tls-response-ok"))
    assert_eq(aot_lines.next(), .None)
}
