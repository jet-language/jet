// Rust: tests/dev_parts/routine.rs:367
#Test("task_surface_runs_resident_with_string_results_and_typed_failures") {
    source :: """
use core.time as time
fn slow_text() -> String {
    time.sleep(25ms)
    return "slow"
}
fn late_text() -> String {
    time.sleep(1000ms)
    return "late"
}
fn failure_label(error: TaskFailure) -> String {
    if error == {
        .Cancelled -> { return "cancelled" }
        .DeadlineBlown -> { return "deadline" }
        .Panicked(_) -> { return "panicked" }
    }
}
fn run() {
    task.group workers {
        child :: task { "child" }
        print(child.join() ?? "child-fallback")
        all_result :: task.all { "left", "right" } ?? []
        print(all_result[0], all_result[1])
        print((task.race { slow_text(), "race" }) ?? "race-fallback")
        print((task.any { slow_text(), "any" }) ?? "any-fallback")
        cancelled :: task late_text()
        cancelled.cancel()
        cancelled_result :: cancelled.join()
        if cancelled_result == {
            .Err(error) -> { print(failure_label(error)) }
            .Ok(_) -> { print("wrong cancellation") }
        }
        failed :: task { panic("boom") }
        failed_result :: failed.join()
        if failed_result == {
            .Err(error) -> { print(failure_label(error)) }
            .Ok(_) -> { print("wrong panic") }
        }
    }
}
"""
    path :: env.temp_dir().join("jet_dev_task_surface_{process.id()}.jet")
    fs.write(&path, source).unwrap()
    shown :: path.to_string_lossy().into_owned()
    _ :: checked_bundle_from_path(&shown)
    assert_native_profiles(&shown, &ProgramOutput.ran("child\nleft\nright\nrace\nany\ncancelled\npanicked\n", "", 0))
}
// Rust: tests/dev_parts/routine.rs:455
#Test("caught_task_panics_keep_stderr_deterministic_under_parallel_repetition") {
    dir :: env.temp_dir().join("jet_dev_scheduler_panic_hook_{process.id()}")
    file :: "Examples/features/concurrency/all_failfast.jet"
    expected_stderr :: fs.read_to_string("Examples/features/expected/concurrency/all_failfast.err.out").expect("all_failfast.err.out")
    expected :: ProgramOutput.ran(String.new(), expected_stderr, 70)
    first :: compiled_binary_output(&dir, "scheduler_panic_hook", 0, "all_failfast", file)
    assert_eq(first, expected)
    binary :: Arc.new(compiled_binary_path(&aot_scratch_dir("scheduler_panic_hook", "all_failfast"), "scheduler_panic_hook", 0, file))
    failures :: Arc.new(Mutex.new([]))
    workers := []
    loop worker in 0..<8 {
        binary :: Arc.clone(&binary)
        failures :: Arc.clone(&failures)
        expected :: expected.clone()
        workers.push(thread.spawn(fn[^binary, ^failures, ^expected]() {
            loop iteration in 0..<8 {
                last := .None
                loop _attempt in 0..<4 {
                    run :: command_output_with_timeout(Command.new(binary.as_ref()), DEV_DIFF_TIMEOUT, "scheduler panic run {worker}/{iteration}")
                    got :: ProgramOutput.ran(String.from_utf8_lossy(&run.stdout).into_owned(), String.from_utf8_lossy(&run.stderr).into_owned(), run.status.code().unwrap_or(1))
                    if got == expected { last = .None; break }
                    if got.exit_code == 70 && got.stderr.is_empty() && got.stdout.is_empty() { last = .Some(got); next }
                    last = .Some(got)
                    break
                }
                if last == .Some(got) -> lock_recovered(&failures, "panic-hook drift report").push("run {worker}/{iteration}: expected {expected:?}, got {got:?}")
            }
        }))
    }
    loop worker in workers -> worker.join().expect("panic-hook regression worker panicked")
    report :: judged_report(&failures, "panic-hook drift report")
    assert(report.is_empty(), "caught task panic stderr drifted:\n{report.join(\"\n\")}")
    _ :: fs.remove_dir_all(&dir)
}
