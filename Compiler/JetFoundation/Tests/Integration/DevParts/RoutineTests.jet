// Rust: tests/dev_parts/routine.rs:205
#Test("debug_keeps_the_impure_files_boundary_while_dev_reaches_the_shared_prelude") {
    path :: env.temp_dir().join("jet_interpreter_boundary_files_{process.id()}.jet")
    data :: path.with_extension("txt")
    fs.write(&data, "shared-prelude").unwrap()
    data_path :: data.to_string_lossy().replace('\\', "/")
    fs.write(&path, "use core.files as files\nfn run() {{\n    text :: files.read(\"{data_path}\") ?? panic(\"read\")\n    print(text == \"shared-prelude\")\n}}\n").unwrap()
    shown :: path.to_string_lossy().into_owned()
    bundle :: jet.Loader.load_entry(&shown).expect("files boundary fixture should load")
    expected :: ProgramOutput.ran("true\n", "", 0)
    assert_native_profiles(&shown, &expected)
    // Source-debug impurity analysis is independent of the retained native O0 tier.
    debug :: jet_driver.InterpreterBoundary.debug_boundary_scan(&bundle).expect("source debug must retain the impurity gate")
    assert_eq(debug.code, "E2203")
    assert(debug.what.contains("a file read or write"), "debug must still name the impure files boundary: {debug.what}")
    _ :: fs.remove_file(path.with_extension("txt"))
    _ :: fs.remove_file(path)
}
