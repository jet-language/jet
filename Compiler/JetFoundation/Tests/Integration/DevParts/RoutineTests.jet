// Rust: tests/dev_parts/routine.rs:99
#Test("infinite_loop_hits_e2202_fuel_stop") {
    jet.boot_mir_eval()
    src :: "fn run() {\n    n := 0\n    loop {\n        n = n + 1\n    }\n}\n"
    prog :: jet.Parser.parse(&jet.Lexer.lex(src).0).expect("fixture should parse")
    funcs := [String:&jet.AST.Func]{}
    loop item in &prog.items {
        if item == .Func(f) -> funcs.insert(f.name.clone(), f)
    }
    run :: funcs.get("run").copied().expect("fixture has run")
    sink := jet.Comptime.DevSink.new()
    err :: jet.Comptime.run_main_with_fuel(run, &funcs, OSPath("."), &sink, 10000).expect_err("an unbounded loop must exhaust the step budget")
    assert_eq(err.code, "E2202", "an unbounded loop must stop with E2202, got: {err.code}")
}
// Rust: tests/dev_parts/routine.rs:128
#Test("fluent_method_chain_preserves_fuel_order_and_spans") {
    jet.boot_mir_eval()
    run_chain :: fn(links: USize, fuel: U64) {
        src :: "fn run() {{\n    print(\" x \"{\".trim()\".repeat(links)})\n}}\n"
        prog :: jet.Parser.parse(&jet.Lexer.lex(&src).0).expect("fixture should parse")
        funcs := [String:&jet.AST.Func]{}
        loop item in &prog.items {
            if item == .Func(f) -> funcs.insert(f.name.clone(), f)
        }
        run :: funcs.get("run").copied().expect("fixture has run")
        argument :: if run.body.first() == {
            .Some(.Expr(.Call(call))) -> &call.args[0].expr
            other -> panic("expected print call, got {other:?}")
        }
        method_spans := []
        cursor := argument
        loop {
            if cursor == {
                .MethodCall{receiver, method_span, ..} -> {
                    method_spans.push(*method_span)
                    cursor = receiver
                }
                else -> break
            }
        }
        expected_exhaustion_span :: method_spans.get(2).copied()
        sink := jet.Comptime.DevSink.new()
        result :: jet.Comptime.run_main_with_fuel(run, &funcs, OSPath("."), &sink, fuel)
        (result, sink.stdout, expected_exhaustion_span)
    }
    (one, stdout, _) :: run_chain(1, 4)
    one.expect("one method link should fit exactly inside four fuel steps")
    assert_eq(stdout, "x\n")
    loop links in [3, 100] {
        (result, _, _expected_span) :: run_chain(links, 3)
        err :: result.expect_err("the chain should exhaust three fuel steps")
        assert_eq(err.code, "E2202")
    }
}
