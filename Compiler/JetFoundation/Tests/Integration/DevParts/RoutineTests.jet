    assert(front_end.is_empty(), "{stem} must type-check before a runtime boundary means anything; untyped json.decode(text) is the ratified D-JSON3 lenient form: {front_end:?}")
    expected :: normalize_for_parity(stem, compiled_binary_output(&dir, "json_coerce_aot", 0, stem, &file))
    assert_eq(expected.stdout, "8081\napi\ntrue\n")
    assert_eq(expected.exit_code, 0)
    loop profile in ["debug", "dev", "release"] -> assert_eq(normalize_for_parity(stem, native_profile_output(&file, profile)), expected)
}
