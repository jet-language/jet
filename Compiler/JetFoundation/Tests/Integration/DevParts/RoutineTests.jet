// Rust: tests/dev_parts/routine.rs:7
#Test("stdin_filter_default_dev_reports_jit_gap") {
    dir :: env.temp_dir().join("jet_dev_stdin_boundary_{process.id()}")
    fs.create_dir_all(&dir).unwrap()
    file :: example_path("io/stdin_filter")
    compiled :: compiled_binary_output_with_stdin(&dir, "stdin_filter_aot", 0, "io/stdin_filter", &file, .Some("jet one\nnope\njet two\n"))
    assert_eq(compiled.stdout.trim(), "jet one\njet two")
    loop profile in ["debug", "dev", "release"] {
        child := Command.new(common.jet_bin()).args(["run", "--profile={profile}", &file]).stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().unwrap()
        input := child.stdin.take().unwrap()
        input.write_all(b"jet one\nnope\njet two\n").unwrap()
        drop(input)
        out :: child.wait_with_output().unwrap()
        actual :: ProgramOutput.ran(String.from_utf8_lossy(&out.stdout).into_owned(), String.from_utf8_lossy(&out.stderr).into_owned(), out.status.code().unwrap_or(1))
        assert_eq(actual, compiled, "{profile} stdin filtering drifted")
    }
}
