//RS #[test]
//RS fn fixed_width_integers_match_interpreter_resident_jit_default_and_aot() {
//RS     if skip_if_cranelift_host_unsupported() || !have_rustc() {
//RS         return;
//RS     }
//RS     // Two retired spellings, both from before this fixture's neighbours moved.
//RS     // D-ARROW-CONTROL1: a callable result is `=>`; `->` is reserved for
//RS     // selected or yielded control values, and sema rejects it with E0070, so
//RS     // every signature below stopped type-checking and the forced interpreter
//RS     // reported nine E0070s instead of running. D-EXPOP1=A / D-XORSPELL1=A
//RS     // (2026-08-05): the caret raises to a power and exclusive-or is `~|`, so
//RS     // `flags ^ mask` on a trapping `U8` would overflow rather than answer the
//RS     // 7 this block asks for. Both spellings move; not one expected value does.
//RS     let _guard = lock_recovered(dev_diff_lock(), "dev_diff_lock");
//RS     let source = r#"
//RS fn i8_id(value: I8) -> I8 { return value }
//RS fn i16_id(value: I16) -> I16 { return value }
//RS fn i32_id(value: I32) -> I32 { return value }
//RS fn i64_id(value: I64) -> I64 { return value }
//RS fn u8_id(value: U8) -> U8 { return value }
//RS fn u16_id(value: U16) -> U16 { return value }
//RS fn u32_id(value: U32) -> U32 { return value }
//RS fn u64_id(value: U64) -> U64 { return value }
//RS fn pass_u64(value: U64?) -> (U64?) { return ~value }
//RS 
//RS fn run() {
//RS     print(i8_id(I8{-8}))
//RS     print(i16_id(I16{-1600}))
//RS     print(i32_id(I32{-320000}))
//RS     print(i64_id(-6400000000))
//RS     print(u8_id(U8{8}))
//RS     print(u16_id(U16{1600}))
//RS     print(u32_id(U32{320000}))
//RS     maximum :: u64_id(U64.MAX)
//RS     print(maximum)
//RS     print("{maximum}")
//RS     print(maximum.to_string())
//RS     print("{maximum:Debug}")
//RS     print([maximum, U64{1}])
//RS     print([U64#2]{maximum, U64{1}})
//RS     print(-i8_id(I8{8}))
//RS     print(-i16_id(I16{16}))
//RS     print(-i32_id(I32{32}))
//RS     print(-i64_id(64))
//RS 
//RS     print(i8_id(I8{10}) + I8{5})
//RS     print(i16_id(I16{100}) - I16{40})
//RS     print(i32_id(I32{7}) * I32{6})
//RS     print(i64_id(84) / 2)
//RS     print(19 % 4)
//RS     print(i8_id(I8{7}) % I8{3})
//RS     flags :: u8_id(U8{13})
//RS     mask :: U8{10}
//RS     print(flags & mask)
//RS     combined := U8{flags}
//RS     combined |= mask
//RS     print(combined)
//RS     print(flags ~| mask)
//RS     print(flags << 1)
//RS     print(u8_id(U8.MAX) << 1)
//RS     print(i8_id(I8{64}) << 1)
//RS     print(flags >> 2)
//RS     print(u16_id(U16.MAX) > U16{1})
//RS     print(u32_id(U32.MAX) > U32{1})
//RS     print(maximum > U64{1})
//RS     print(maximum >> 63)
//RS     print(flags.count_ones())
//RS     print(flags.count_zeros())
//RS     print(flags.leading_zeros())
//RS     print(flags.trailing_zeros())
//RS 
//RS     i8_max :: I8.MAX
//RS     i8_one :: I8{1}
//RS     i8_zero :: I8{0}
//RS     print(wrapping(i8_max + i8_one))
//RS     print(saturating(i8_max + i8_one))
//RS     print(checked(i8_max + i8_zero) ?? i8_zero)
//RS     print(checked(i8_max + i8_one) ?? i8_zero)
//RS     i16_max :: I16.MAX
//RS     i16_one :: I16{1}
//RS     i16_zero :: I16{0}
//RS     print(wrapping(i16_max + i16_one))
//RS     print(saturating(i16_max + i16_one))
//RS     print(checked(i16_max + i16_zero) ?? i16_zero)
//RS     print(checked(i16_max + i16_one) ?? i16_zero)
//RS     i32_max :: I32.MAX
//RS     i32_one :: I32{1}
//RS     i32_zero :: I32{0}
//RS     print(wrapping(i32_max + i32_one))
//RS     print(saturating(i32_max + i32_one))
//RS     print(checked(i32_max + i32_zero) ?? i32_zero)
//RS     print(checked(i32_max + i32_one) ?? i32_zero)
//RS     i64_max :: I64{9223372036854775807}
//RS     i64_one :: I64{1}
//RS     i64_zero :: I64{0}
//RS     print(wrapping(i64_max + i64_one))
