use std.[fs, env]
use jet_foundation.Tests.Integration.Common as common
// Rust: tests/dev_parts/routine.rs:3658
// Retired resident-engine representation checks are replaced by behavioral O0/O1/O2/Web witnesses.
// GATE #4494: real filesystem and tier execution providers.
pub fn routine03_output(file: OSPath, tier: String) -> (Int, String, String) {
    if common.run_entry_tier(file, tier, false) == {
        .Ran(exit_code, stdout, stderr) -> (exit_code, stdout, stderr)
        else -> panic("{tier} did not execute {file.display()}")
    }
}
pub fn routine03_fixture(tag: String, source: String) -> OSPath {
    dir :: common.unique_tmp("jet_routine03_{tag}")
    fs.create_dir_all(&dir).unwrap()
    file :: dir.join("{tag}.jet")
    fs.write(&file, source).unwrap()
    file
}
pub fn routine03_golden(file: OSPath, stdout: String, stderr: String, exit_code: Int) -> {
    for tier in ["O0", "O1", "O2", "Web"] {
        assert_eq(routine03_output(file.clone(), tier), (exit_code, stdout, stderr), "{tier}: {file.display()}")
    }
}
