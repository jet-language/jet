// Rust: tests/dev_parts/routine.rs:5720
#Test("serde_jit_parity_manifest_pins") {
    gate :: parse_corpus_gate_manifest()
    for stem in ["serde/encoding_breadth", "serde/serde_generic"] {
        rows :: gate.iter().filter(fn(record) { record.stem == stem }).collect()
        assert_eq(rows.len(), 1, "{stem} must carry exactly one corpus-gate row, found {rows.len()}")
        record :: rows[0]
        assert(record.class != CorpusGateClass.RunTierBroken && record.class != CorpusGateClass.TierDivergent, "{stem} became a run-tier refusal or a tier divergence: {record.class:?} {record.detail}")
        if record.class == CorpusGateClass.DeoptInterp { assert(record.detail.is_empty(), "{stem} deopts CARRYING a diagnostic: {record.detail}") }
        assert(record.class != CorpusGateClass.FrontendRejected, "{stem} is frontend-rejected: {record.detail}. The E2402 error-conversion gap that once excused this row is fixed (D-FAIL-CONV2=A), so a rejection here is a live defect, not the known one")
    }
}
