// Rust: tests/dev_parts/routine.rs:5990
#Test("multi_head_functions_match_interpreter_resident_jit_and_aot") {
    require_multi_head_parity_prereqs()
    src :: """
enum Shape {
    Circle(Float)
    Rect(left_1: Float, right_1: Float)
}
fn area(Circle(r: Float)) -> Float { return r * r }
fn area(Rect(left_1: Float, right_1: Float)) -> Float { return left_1 * right_1 }
fn run() {
    print(area(Shape.Circle(3.0)))
    print(area(.Rect{ left_1: 2.0, right_1: 4.0 }))
}
"""
    dir :: env.temp_dir().join("jet_multi_head_parity_{process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    file :: dir.join("multi_head.jet")
    fs.write(&file, src).unwrap()
    shown :: file.to_string_lossy().to_string()
    tir_support.assert_tiers_agree("multi_head_functions", src, "9\n8\n")
    for verb in ["run", "dev"] {
        args := [verb, shown]
        if verb == "dev" { args.push("--watch=off") }
        out :: Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(args).env("NO_COLOR", "1").output().unwrap()
        assert(out.status.success(), "{String.from_utf8_lossy(&out.stderr)}")
        assert_eq(String.from_utf8_lossy(&out.stdout), "9\n8\n")
    }
    _ :: fs.remove_dir_all(&dir)
}
