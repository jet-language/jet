// Rust: tests/dev_parts/routine.rs:7467
#Test("every_dev_slice_is_wired_into_a_test_target") {
    tests_dir :: OSPath(env.var("CARGO_MANIFEST_DIR").unwrap()).join("Compiler/JetFoundation/Tests/Integration")
    wired := ""
    for entry in fs.read_dir(&tests_dir).expect("tests dir").flatten() {
        name :: entry.file_name().to_string_lossy().into_owned()
        if name.starts_with("Dev") && name.ends_with(".jet") { wired.push_str(&fs.read_to_string(entry.path()).expect("dev target source")) }
    }
    orphans := []
    for entry in fs.read_dir(tests_dir.join("DevParts")).expect("DevParts dir").flatten() {
        name :: entry.file_name().to_string_lossy().into_owned()
        if name.ends_with(".jet") && !wired.contains("DevParts.{name.trim_end_matches(".jet")}") && !wired.contains("DevParts/{name}") { orphans.push(name) }
    }
    orphans.sort()
    assert(orphans.is_empty(), "no integration Dev target includes these slices, so every test in them runs nowhere: {orphans:?}")
}
