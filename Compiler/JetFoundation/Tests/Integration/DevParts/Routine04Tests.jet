#Test("body_only_edit_is_type_stable") {
    old :: bundle_of(STRUCT_OLD, "stable_old")
    new :: bundle_of("struct P {{\n    x: Int\n}}\nfn f(p: P) -> Int {{\n    return p.x + 1\n}}\nfn run() {{\n    print(f(P{{x: 2}}))\n}}\n", "stable_new")
    decision :: jet.Sema.HotSwap.type_stable_decision(&old, &new, "run").expect("body-only edit must produce a hot-swap decision")
    assert(decision.is_compatible(), "a body-only edit must be type-stable (swap path): {decision:?}")
}
// Rust: tests/dev_parts/routine.rs:6507
#Test("struct_field_change_emits_e2210") {
    old :: bundle_of(STRUCT_OLD, "field_old")
    new :: bundle_of("struct P {{\n    x: Int\n    y: Int\n}}\nfn f(p: P) -> Int {{\n    return p.x\n}}\nfn run() {{\n    print(f(P{{x: 1, y: 2}}))\n}}\n", "field_new")
    decision :: jet.Sema.HotSwap.type_stable_decision(&old, &new, "run").expect("struct field change must produce a hot-swap decision")
    assert(decision.requires_restart(), "adding a struct field must force a restart: {decision:?}")
    reason :: decision.compatibility.reason().expect("an incompatible decision must carry a restart reason")
    diagnostic :: jet.Sema.HotSwap.e2210(reason)
    assert_eq(diagnostic.code, "E2210")
    assert(diagnostic.what.contains("struct `P`"), "E2210 should name the changed struct, got: {diagnostic.what}")
}
