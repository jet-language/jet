}
// Rust: tests/dev_parts/routine.rs:7176
#Test("package_callable_survives_dev_and_run_watch_reload") {
    for command in ["dev", "run"] {
        scratch :: common.Scratch.new("package-callable-reload")
        fs.write(scratch.join("package.jet"), "name: \"callable_reload\"\nversion: \"0.1.0\"\nauthority: {{ holds: {{ allow: [IO] }} }}\noutputs: {{ app: .Executable{{ entry: launch }} }}\n").unwrap()
        file :: scratch.join("entry.jet")
        fs.write(&file, "fn run() {{ print(\"wrong callable\") }}\npub fn launch() {{ print(\"selected-1\") }}\n").unwrap()
        args := [command, scratch.path.to_str().unwrap()]
        if command == "run" { args.push("--watch") }
        child := Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(&args).env("NO_COLOR", "1").stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().unwrap_or_else(fn(error) { panic("spawn package {command}: {error}") })
        stdout :: child.stdout.take().unwrap()
        (lines_tx, lines_rx) :: std.sync.mpsc.channel()
        thread.spawn(fn() {
            for line in io.BufReader.new(^stdout).lines() { if lines_tx.send(line).is_err() { break } }
        })
        // Rust: tests/dev_parts/routine.rs:7213 (local wait_for closure)
        wait_for :: fn(expected: String) {
            loop {
                line :: lines_rx.recv_timeout(Duration.from_secs(30)).unwrap_or_else(fn(error) { panic("package {command} output {expected}: {error}") }).expect("package callable stdout line")
                if line == expected { break }
                assert_ne(line, "wrong callable", "package execution fell back to run")
            }
        }
        wait_for("selected-1")
        fs.write(&file, "fn run() {{ print(\"wrong callable\") }}\npub fn launch() {{ print(\"selected-2\") }}\n").unwrap()
        wait_for("selected-2")
        _ :: child.kill()
        output :: child.wait_with_output().unwrap_or_else(fn(error) { panic("stop package {command}: {error}") })
        stderr :: String.from_utf8_lossy(&output.stderr)
        assert(!stderr.contains("Error [") && !stderr.contains("E2211"), "package {command} reload failed:\n{stderr}")
    }
}
// Rust: tests/dev_parts/routine.rs:7264
#Test("tiered_run_selects_per_function_tiers_and_cross_calls") {
    dir :: common.unique_tmp("jet_778_tiers")
    fs.create_dir_all(&dir).unwrap()
    file :: dir.join("mixed.jet")
    src :: """
#Memo fn cached(n: Int) -[]> Int { n * 2 }
fn add1(n: Int) -> Int {
    return n + 1
}
fn native_sum() -> Int {
    doubled :: [add1(40), add1(1)]
    [a, b] :: doubled
    return a + b
}
fn run() {
    print(native_sum())
    print(cached(21) + add1(0))
}
"""
    fs.write(&file, src).unwrap()
    // Retired planner/trace assertions become genuine native cross-call/memo
    // behavior across each retained optimization tier, with no deopt engine.
    tir_support.assert_tiers_agree("mixed_tiers_cross_calls", src, "43\n43\n")
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/dev_parts/routine.rs:7389
#Test("tracked_origin_fact_matches_aot_in_default_dev") {
    dir :: common.unique_tmp("jet_origin_fact_dev")
    fs.create_dir_all(&dir).unwrap()
    file :: dir.join("origin_fact.jet")
    src :: "fn run() {{\n    #Track speed :: Float{{3.5}}\n    plain :: Float{{3.5}}\n    copied :: speed\n    speed_origin :: prep {{ speed.$origin }}\n    plain_origin :: prep {{ plain.$origin }}\n    copied_origin :: prep {{ copied.$origin }}\n    print(speed_origin?.tracked ?? false)\n    print(speed_origin?.source ?? \"missing\")\n    print(speed_origin?.line ?? 0)\n    print(speed_origin?.column ?? 0)\n    print(plain_origin == None)\n    print(copied_origin == None)\n}}\n"
    fs.write(&file, src).unwrap()
    shown :: file.to_string_lossy().to_string()
    expected_stdout :: "true\nspeed\n2\n12\ntrue\ntrue\n"
    tir_support.assert_tiers_agree("origin_fact", src, expected_stdout)
    for forced in [false, true] {
        if dev_iteration_with_timeout("origin_fact", &shown, forced) == {
            .Ran(stdout, stderr, exit_code) -> assert_eq(ProgramOutput.ran(stdout, stderr, exit_code), ProgramOutput.ran(expected_stdout, "", 0))
            .Problems(diags) -> panic("dev failed origin fact: {diags:?}")
        }
    }
    _ :: fs.remove_dir_all(&dir)
}
