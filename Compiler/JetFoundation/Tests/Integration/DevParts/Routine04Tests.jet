// Rust: tests/dev_parts/routine.rs:6088
#Test("multi_head_payload_range_checks_each_slot_across_runtime_tiers") {
    require_multi_head_parity_prereqs()
    src :: """
enum Pair {
    Values(left: Int, right: Int)
    Empty
}
fn classify(pair: Pair) -> String {
    if pair == {
        .Values(_, 10..19) -> { return "range" }
        .Values(_, _) -> { return "other" }
        .Empty -> { return "empty" }
    }
    return "unknown"
}
fn run() {
    print(classify(.Values{ left: 1, right: 15 }))
    print(classify(.Values{ left: 1, right: 25 }))
}
"""
    dir :: common.unique_tmp("jet_multi_head_payload_range")
    fs.create_dir_all(&dir).unwrap()
    file :: dir.join("multi_head_payload_range.jet")
    fs.write(&file, src).unwrap()
    shown :: file.to_string_lossy().into_owned()
    tir_support.assert_tiers_agree("multi_head_payload_range", src, "range\nother\n")
    if dev_iteration(&shown, false, false) == {
        .Ran(stdout, stderr, exit_code) -> assert_eq(ProgramOutput.ran(stdout, stderr, exit_code), ProgramOutput.ran("range\nother\n", "", 0), "default dev payload-range slot drifted")
        .Problems(diags) -> panic("default dev failed payload-range fixture: {diags:?}")
    }
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/dev_parts/routine.rs:6147
#Test("multi_head_missing_head_e0307_reaches_all_diagnostic_entries") {
    file :: OSPath(env.var("CARGO_MANIFEST_DIR").unwrap()).join("tests/ui/multi_head_not_exhaustive.jet")
    shown :: file.to_string_lossy().into_owned()
    src :: fs.read_to_string(&file).unwrap()
    snapshot :: fs.read_to_string(OSPath(env.var("CARGO_MANIFEST_DIR").unwrap()).join("tests/ui/multi_head_not_exhaustive.stderr")).unwrap()
    snapshot_file :: "tests/ui/multi_head_not_exhaustive.jet"
    require_multi_head_parity_prereqs()
    entries :: multi_head_diagnostic_entries(&shown, &src)
    expected :: diagnostic_shapes(&entries.sema)
    assert_eq(expected.len(), 1, "missing-head fixture must produce exactly one diagnostic: {expected:?}")
    assert_eq(expected[0].code, "E0307")
    assert_eq(jet.render_diagnostics(snapshot_file, &src, &entries.sema), snapshot, "the sema diagnostic must match the checked-in UI snapshot")
    for command in ["run", "dev"] { assert_cli_diagnostic_snapshot(command, snapshot_file, &snapshot) }
    for (tier, result) in [("sema", RunOutcome.Problems(entries.sema)), ("AOT", RunOutcome.Problems(entries.aot)), ("native", entries.jit), ("default dev", entries.default_dev), ("diagnostic gate", entries.interpreter_gate)] {
        if result == {
            .Problems(diags) -> {
                assert_eq(diagnostic_shapes(&diags), expected, "{tier} diagnostic code/text/span drifted from sema")
                assert_eq(jet.render_diagnostics(snapshot_file, &src, &diags), snapshot, "{tier} rendered diagnostic drifted from the UI snapshot")
            }
            _ -> panic("{tier} entry must reject missing multi-head coverage")
        }
    }
    assert_eq(entries.forced_interpreter, ProgramOutput.ran("first\n", "", 0), "successful forced entry must keep first-head order")
}
// Rust: tests/dev_parts/routine.rs:6208
#Test("multi_head_duplicate_head_l0301_keeps_first_match_across_runtime_tiers") {
    require_multi_head_parity_prereqs()
    file :: OSPath(env.var("CARGO_MANIFEST_DIR").unwrap()).join("tests/ui_lint/multi_head_unreachable.jet")
    shown :: file.to_string_lossy().into_owned()
    src :: fs.read_to_string(&file).unwrap()
    dir :: common.unique_tmp("jet_multi_head_duplicate_head")
    fs.create_dir_all(&dir).unwrap()
    bundle := jet.Loader.load_entry(&shown).expect("duplicate-head fixture should load")
    sema :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run)
    assert(sema.iter().any(fn(diagnostic) { diagnostic.code == "L0301" }), "sema must retain duplicate-head lint: {sema:?}")
    compiled :: jet.compile_with_path(&src, &shown).expect("duplicate-head lint must not block AOT compilation")
    assert(compiled.lints.iter().any(fn(diagnostic) { diagnostic.code == "L0301" }), "AOT entry lost duplicate-head lint: {compiled.lints:?}")
    tir_support.assert_tiers_agree("multi_head_duplicate_head", &src, "first\n")
    for verb in ["run", "dev"] {
        args := [verb, shown]
        if verb == "dev" { args.push("--watch=off") }
        out :: Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(args).env("NO_COLOR", "1").output().unwrap()
        assert(out.status.success(), "{String.from_utf8_lossy(&out.stderr)}")
        assert_eq(String.from_utf8_lossy(&out.stdout), "first\n")
    }
    _ :: fs.remove_dir_all(&dir)
}
