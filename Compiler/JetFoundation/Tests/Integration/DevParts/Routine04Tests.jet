// Rust: tests/dev_parts/routine.rs:5789
#Test("cranelift_shield_defers_task_cancel_without_unwinding_native_frame") {
    with_jit_test_scope(fn() {
        tir_support.assert_tiers_agree("shield_cancel", """
use core.tasks as tasks
fn run() {
    (sender, ch) :: channel<Int>()
    (ack_sender, ack) :: channel<Int>()
    slow :: task {
        #Shield {
            value :: ch.receive() ?? panic("closed")
            print(value)
            ack_sender.send(1)
        }
        print(99)
    }
    slow.cancel()
    slow.detach()
    sender.send(42)
    ack.receive() ?? panic("closed")
}
""", "42\n")
    })
}
// Rust: tests/dev_parts/routine.rs:5825
#Test("cranelift_unshielded_receive_cancel_does_not_unwind_native_frame") {
    tir_support.assert_tiers_agree("unshielded_receive_cancel", """
use core.tasks as tasks
fn run() {
    (ready_sender, ready) :: channel<Int>()
    (sender, ch) :: channel<Int>()
    slow :: task {
        ready_sender.send(1)
        ch.receive() ?? panic("closed")
        print(99)
    }
    ready.receive() ?? panic("closed")
    slow.cancel()
    slow.detach()
    sender.send(42)
}
""", "")
}
