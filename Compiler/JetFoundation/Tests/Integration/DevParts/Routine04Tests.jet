// Rust: tests/dev_parts/routine.rs:5441
#Test("resident_jit_safety_detail_smoke") {
    for stem in ["basics/compound", "basics/value_dispatch", "types/structs", "types/enums", "basics/branches", "concurrency/task_group"] {
        file :: example_path(stem)
        bundle := jet.Loader.load_entry(&file).expect("load")
        diagnostics :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run)
        assert(diagnostics.iter().all(fn(d) { d.severity != Severity.Error }), "{stem}: {diagnostics:?}")
        expected :: golden_program_output(stem)
        tir_support.assert_example_cli_tiers_agree(stem, &expected.stdout)
    }
}
// Rust: tests/dev_parts/routine.rs:5491
#Test("resident_jit_safe_labeled_loop_control") {
    src :: """
fn run() {
    outer :: loop i in 0..<2 {
        loop {
            if i == 0 {
                next(outer)
            }
            break(outer)
        }
    }
    print("done")
}
"""
    tir_support.assert_tiers_agree("labeled_loop_control", src, "done\n")
}
// Rust: tests/dev_parts/routine.rs:5515
#Test("resident_jit_named_or_fallback_loop_control") {
    src :: """
fn run() {
    values := [7]
    outer :: loop i in 0..<2 {
        loop {
            value :: values.get(1 - i) ?? next(outer)
            print(value)
            values.get(99) ?? break(outer)
        }
    }
    print("done")
}
"""
    tir_support.assert_tiers_agree("named_or_fallback_loop_control", src, "7\ndone\n")
}
