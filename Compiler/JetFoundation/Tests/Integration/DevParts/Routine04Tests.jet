#Test("cranelift_unshielded_sleep_cancel_does_not_unwind_native_frame") {
    tir_support.assert_tiers_agree("unshielded_sleep_cancel", """
use core.tasks as tasks
use core.time as time
fn run() {
    (ready_sender, ready) :: channel<Int>()
    slow :: task {
        ready_sender.send(1)
        time.sleep(200ms)
        print(99)
    }
    ready.receive() ?? panic("closed")
    slow.cancel()
    slow.detach()
}
""", "")
}
// Rust: tests/dev_parts/routine.rs:5870
#Test("cranelift_unshielded_select_cancel_does_not_unwind_native_frame") {
    tir_support.assert_tiers_agree("unshielded_select_cancel", """
use core.tasks as tasks
fn select_cancel_worker(ready_sender: Sender<Int>) {
    task.group worker {
        (_sender, ch) :: channel<Int>()
        ready_sender.send(1)
        if {
            value, ch -> print(value)
        }
        print(99)
    }
}
fn run() {
    task.group g {
        (ready_sender, ready) :: channel<Int>()
        slow :: task select_cancel_worker(ready_sender)
        ready.receive() ?? panic("closed")
        slow.cancel()
    }
}
""", "")
}
// Rust: tests/dev_parts/routine.rs:5899
#Test("cranelift_wait_failures_recover_as_typed_task_failures") {
    join_cancelled :: """
use core.time as time
fn failure_label(error: TaskFailure) -> String {
    if error == {
        .Cancelled -> { return "cancelled" }
        .DeadlineBlown -> { return "deadline" }
        .Panicked(_) -> { return "panicked" }
    }
}
fn run() {
    child :: task {
        time.sleep(200ms)
    }
    child.cancel()
    result :: child.join()
    if result == {
        .Err(error) -> { print(failure_label(error)) }
        .Ok(_) -> { print("wrong cancellation") }
    }
}
"""
    tir_support.assert_tiers_agree("join_cancelled", join_cancelled, "cancelled\n")
}
