//RS 
//RS /// Acquire a harness mutex whose guarded value CANNOT be left half-written by an
//RS /// unwind, and say out loud when the lock was already poisoned.
//RS ///
//RS /// Every dev test serializes on `dev_diff_lock`, so one test that unwinds while
//RS /// holding it poisons the lock for the whole binary. With `.lock().unwrap()`
//RS /// each later test then dies with a bare `PoisonError { .. }` reported at *its
//RS /// own* line, so a single real defect manufactures an unbounded run of false
//RS /// failures — the same slander the old abort-on-first-failure behavior produced.
//RS ///
//RS /// `PoisonError::into_inner()` is sound at these sites because the guarded value
//RS /// has no multi-step invariant to break: `dev_diff_lock` guards `()`, the work
//RS /// queues are only ever `pop_front`ed under the guard, and the report vectors are
//RS /// only ever `push`ed. `VecDeque::pop_front` and `Vec::push` either complete or
//RS /// do nothing, so no torn state can outlive an unwind.
//RS ///
//RS /// The poison flag is deliberately NOT cleared: every later acquisition keeps
//RS /// tagging its test as post-cascade. This changes attribution only — the calling
//RS /// test still stands or falls on its own assertions.
//RS fn lock_recovered<'a, T>(lock: &'a Mutex<T>, what: &str) -> MutexGuard<'a, T> {
//RS     match lock.lock() {
//RS         Ok(guard) => guard,
//RS         Err(poisoned) => {
//RS             eprintln!(
//RS                 "note: cascade, not a fresh defect — `{what}` was poisoned by an EARLIER panic \
//RS                  in this test binary. The guard holds no partially written state, so it is \
//RS                  recovered and this test keeps its own verdict; fix the first panic of the run."
//RS             );
//RS             poisoned.into_inner()
//RS         }
//RS     }
//RS }
//RS 
//RS /// Read a worker-collected report the caller is about to assert on.
//RS ///
//RS /// `into_inner()` is WRONG here. Poison means a worker thread unwound while
//RS /// holding the report, so the row that is missing is exactly the row that would
//RS /// have failed the test, and `assert!(report.is_empty())` over a recovered
//RS /// report can go GREEN across a real defect. Fail instead, name the cascade, and
//RS /// print the rows that survived so the first panic stays visible.
//RS fn judged_report<'a>(lock: &'a Mutex<Vec<String>>, what: &str) -> MutexGuard<'a, Vec<String>> {
//RS     match lock.lock() {
//RS         Ok(guard) => guard,
//RS         Err(poisoned) => {
//RS             let partial = poisoned.into_inner();
//RS             panic!(
//RS                 "cascade, not a fresh defect: `{what}` was poisoned — a worker of this test \
//RS                  unwound while holding the report, so it is incomplete and cannot be judged \
//RS                  (an absent row reads as success). {} row(s) survived:\n{}",
//RS                 partial.len(),
//RS                 partial.join("\n\n")
//RS             )
//RS         }
//RS     }
//RS }
