//RS 
//RS /// How many shipped examples the default `jet dev` battery is still allowed to
//RS /// lose to a run-path sema error (#2020).
//RS ///
//RS /// Shrink-only, exactly like `OUT_OF_UNIVERSE_CEILING` and for the same reason.
//RS /// `typechecked_example_stems` used to `filter` a sema-failing stem out and say
//RS /// nothing, so a stem could leave this battery's universe by BREAKING: on
//RS /// 2026-08-14 a mechanical `x ?? panic(…)` -> `x?` rewrite across 39 files was
//RS /// made against a conversion rail that had been removed eight days earlier, 28
//RS /// net/serde examples stopped type-checking, and this battery still reported
//RS /// green because the broken stems were simply no longer in it. That is the hole
//RS /// #1998 closed in `observe_jit_coverage` and #2012 closed in the retired
//RS /// `jit_covered_example_stems`, reproduced in a third oracle.
//RS ///
//RS /// Every row is a defect to fix — fix the example, or the rail it trips — never
//RS /// a stem to write out of the battery. The rows are DERIVED from the compiler's
//RS /// own diagnostic at battery time, so this is a counted ceiling and not an
//RS /// allowlist: no stem can be excused by name.
//RS ///
//RS /// Provenance: 28, the count traced on this branch while #2020 was open. It is a
//RS /// recorded observation, not a measurement of this assertion — correct it to the
//RS /// first count this battery observes, in the same diff as that observation, and
//RS /// only downward afterwards.
//RS /// 54 is the first OBSERVED count, taken at 76bb19ba9 once this assertion
//RS /// existed to measure it. The 28 it replaced was a hand-traced estimate from a
//RS /// different oracle (the JIT coverage universe, which walks a slightly
//RS /// different set) and was never a measurement of this battery. Correcting an
//RS /// estimate to its measurement is not raising a guard: the number may only fall
//RS /// from here, and card #2018 owns driving it down.
//RS ///
//RS /// 1 is the count #2018 drove it to. The 11 it replaces was never measured by
//RS /// anything: it was written in the same uncommitted snapshot that also renamed
//RS /// the modules examples, so the number moved without evidence while the ledger
//RS /// beside it still carried 40 rows. The four #2018 recovered, each by its own
//RS /// root cause and not by editing the ceiling:
//RS ///   * the E2402 core-error family, by the ratified `impl <CoreError> => Err`
//RS ///     rail (D-FAIL-CONV2=A) — 36 net/serde stems, every cascading E0311/E0302/
//RS ///     E0107/E0114 with them;
//RS ///   * `crypto/vault_secret`, by dropping the D-CRYPTOENV1 `#Unsafe` demand from
//RS ///     `core.crypto.vault.get`, whose gate is the `Secret` effect;
//RS ///   * `memory/shared_guard_queue`, by putting `Condition` on the shared-handle
//RS ///     rail it was always Arc-backed for;
//RS ///   * `modules/package`, which was never an example — it is that topic's
//RS ///     manifest, now excluded at `topic_jet_files`, the one discovery seam.
//RS ///
//RS /// Build entries use the full staged build front end, so compiler-only calls
//RS /// and generated runtime declarations are checked in their real context.
//RS const SEMA_REJECTED_CEILING: usize = 0;
//RS 
//RS /// The stems the run-path front end accepts, and the ones it rejects together
//RS /// with the reason the compiler gave (#2020). Nothing is discarded.
//RS fn typechecked_example_stems() -> (Vec<String>, Vec<String>) {
//RS     let mut accepted = Vec::new();
//RS     let mut rejected = Vec::new();
//RS     for stem in all_example_stems() {
//RS         let file = example_path(&stem);
//RS         let diags = if let Ok(source) = fs::read_to_string(&file) {
//RS             if jet::Driver::selects_build_entry(&source, None) {
//RS                 jet::Driver::compile_bundle_path_build(
//RS                     &file,
//RS                     jet::Driver::BuildRunOptions::default(),
//RS                 )
//RS                 .map(|_| Vec::new())
//RS                 .unwrap_or_else(|diags| diags)
//RS             } else {
//RS                 jet::check_with_path(&file)
//RS             }
//RS         } else {
//RS             jet::check_with_path(&file)
//RS         };
//RS         if diags
//RS             .iter()
//RS             .any(|d| matches!(d.severity, jet::Diagnostics::Severity::Error))
//RS         {
//RS             rejected.push(format!("{stem}: {}", first_diagnostic_summary(&diags)));
//RS         } else {
//RS             accepted.push(stem);
//RS         }
//RS     }
//RS     (accepted, rejected)
//RS }
//RS 
//RS /// The one-line `CODE: message` reason a stem carries when the compile oracle
//RS /// could not judge it.
//RS ///
//RS /// #1998: the reason is DERIVED from the compiler's own diagnostic, never
//RS /// declared here, so the out-of-universe list can never become an allowlist. A
//RS /// stem leaves the oracle only for as long as the compiler still says why.
//RS fn first_diagnostic_summary(diagnostics: &[jet::Diagnostics::Diagnostic]) -> String {
//RS     let first = diagnostics
//RS         .iter()
//RS         .find(|d| matches!(d.severity, jet::Diagnostics::Severity::Error))
//RS         .or_else(|| diagnostics.first());
//RS     match first {
//RS         Some(d) => format!("{}: {}", d.code, d.what.replace('\n', " ")),
//RS         None => "failed without a diagnostic".to_string(),
//RS     }
//RS }
//RS 
//RS /// What the in-process compile oracle can say about one example stem.
//RS ///
//RS /// #1998: there used to be a fourth outcome with no name. A stem whose
//RS /// in-process `Loader` or `Sema` pass failed fell out of the loop on a bare
//RS /// `continue`, so it joined neither set, and the audit then reported `gaps: 0`
//RS /// over a denominator it never stated. The fourth outcome is named here and the
//RS /// match on it is exhaustive, so a stem can no longer leave the audit silently.
//RS ///
//RS /// #2012: `Covered` carries the resident gate too. The three-way differential
//RS /// battery needs a stricter fact — the lowerer accepted the bundle AND the
//RS /// resident JIT will run it — and it used to answer that from a second walk of
//RS /// the same corpus (`jit_covered_example_stems`) carrying the same two silent
//RS /// `continue`s this enum exists to remove. One oracle now answers both
//RS /// questions, so the two can no longer disagree (AGENTS.md I8).
//RS enum JitCompileVerdict {
//RS     /// The JIT lowerer accepted the bundle. `resident_refusal` is `None` when
//RS     /// the resident JIT will also RUN it, or the
//RS     /// `cranelift_resident_safe_detail` reason it will not.
//RS     Covered { resident_refusal: Option<String> },
//RS     /// The lowerer rejected the bundle: a live I9 compile gap, and its reason.
//RS     Gap(String),
//RS     /// The harness never reached the lowerer, so this run judged nothing about
//RS     /// the stem. Carries the diagnostic that stopped it.
//RS     OutOfUniverse(String),
//RS }
//RS 
//RS /// How many example stems the compile oracle must still see (#1998).
//RS ///
//RS /// A floor, because examples get added: deleting one, or making
//RS /// `topic_jet_files` stop seeing one, must lower a reviewed constant. It lives
//RS /// here, outside `Examples/features/`, so deleting an example cannot silently
//RS /// shrink the measured universe.
//RS ///
//RS /// #2012: every reader of `collect_jit_coverage` asserts this, not just the
//RS /// coverage audit, so no battery scoped to a slice of this universe can report
//RS /// success while the universe itself shrank.
//RS ///
//RS /// #2018 lowered it 498 -> 497 in the same diff as the deletion the rule above
//RS /// demands: `topic_jet_files` no longer discovers `Examples/features/modules/
//RS /// package.jet`, because that file is the `modules` topic's MANIFEST and never
//RS /// was an example. It stays on disk — `modules/fact_value_arguments.jet` reads
//RS /// the `cache_slots` setting it declares — so this is one fewer stem measured,
//RS /// not one fewer example shipped. `Examples/features/expected/` corroborates it:
//RS /// 19 stems carry no golden, and every one of the other 18 is a deliberate
//RS /// panic/trap/abort example whose whole point is the failure path.
//RS /// `modules/package` is the only one that is not a program at all.
//RS ///
//RS /// 497 is the last REVIEWED value minus that one deletion, deliberately not the
//RS /// count on disk. `topic_jet_files` saw 500 files while this card was open, so
//RS /// the honest observed floor was 499 — but the extra stems are examples other
//RS /// work added concurrently and this card does not own them. Leaving the floor at
//RS /// the reviewed-minus-one value keeps a real deletion loud without making this
//RS /// diff fail when a sibling change is integrated in a different order. Raise it
//RS /// to the observed count in the same diff as the next observed run.
//RS const EXAMPLE_CORPUS_FLOOR: usize = 497;
//RS 
//RS /// How many stems the compile oracle is still allowed to be blind to (#1998).
//RS ///
//RS /// Shrink-only. Every row is a stem this oracle cannot judge, so every row is a
//RS /// defect to fix — build the
//RS /// context the harness is missing, or fix the frontend the stem trips — never a
//RS /// skip to accept. The rows are derived from the compiler's own diagnostics at
//RS /// audit time, so this is a counted ceiling and not an allowlist: no stem can be
//RS /// written out of the universe by hand.
//RS ///
//RS /// #2018 drove it to 1. It was 53 when the card opened and 11 when the card was
//RS /// picked up, and that 11 was never measured — it was written in an uncommitted
//RS /// snapshot while `tests/jit_corpus_gate.txt` beside it still carried 40
//RS /// `frontend_rejected:` rows, so the exclusion set had been tightened without
//RS /// evidence. What actually recovered the stems is recorded on
//RS /// `SEMA_REJECTED_CEILING` above, plus one gap closed HERE: `classify_jit_compile`
//RS /// now seeds the build-fact snapshot before sema, exactly as
//RS /// `classify_corpus_stem` does, so the two in-process front ends can no longer
//RS /// judge the same `@build.*`-reading stem in two different contexts.
//RS ///
//RS /// Build entries now use the same staged runtime bundle as `jet run`, so
//RS /// generated declarations enter this oracle instead of being reported outside
//RS /// it.
//RS const OUT_OF_UNIVERSE_CEILING: usize = 0;
//RS 
//RS /// How many compile-covered stems the resident JIT must still be willing to run
//RS /// — the universe `cranelift_three_way_differential_battery` is scoped to
//RS /// (#2012).
//RS ///
//RS /// A floor for the same reason `EXAMPLE_CORPUS_FLOOR` is one: the corpus grows,
//RS /// and a stem that quietly stops being resident-safe silently leaves the
//RS /// battery's denominator, which is exactly how that battery could run a
//RS /// shrinking slice of the corpus and still pass.
//RS ///
//RS /// Last recorded observation: `344 ran / 353 resident-safe`, from the #1251
//RS /// verification at 0f5505640 (2026-07-28), when the corpus was smaller than the
//RS /// `EXAMPLE_CORPUS_FLOOR` above. It is therefore a conservative floor, to raise
//RS /// to the observed count in the same diff as the next observed run.
//RS const RESIDENT_SAFE_FLOOR: usize = 353;
//RS 
//RS /// How many stems the three-way differential battery must still execute (#2012).
//RS ///
//RS /// `RESIDENT_SAFE_FLOOR` pins the universe; this pins how much of it the battery
//RS /// actually ran, so deleting a golden — which moves a stem out of the run set
//RS /// without moving it out of the universe — cannot pass quietly either. Same
//RS /// provenance as `RESIDENT_SAFE_FLOOR`: `344 ran` at 0f5505640. It replaces the
//RS /// original `ran >= 9` M3 seed floor, which stopped saying anything once the
//RS /// battery reached the hundreds.
//RS const THREE_WAY_RAN_FLOOR: usize = 344;
//RS 
//RS /// The audit's whole answer, together with the denominator it was measured over.
//RS ///
//RS /// `covered`, `gaps` and `out_of_universe` partition `corpus` exactly, and
//RS /// `resident_safe` and `resident_refused` partition `covered` exactly;
//RS /// `observe_jit_coverage` asserts both.
//RS #[derive(Clone)]
//RS struct JitCoverage {
//RS     /// Every stem `topic_jet_files` yielded — the audit's universe.
//RS     corpus: usize,
//RS     covered: Vec<String>,
//RS     /// #2012: the subset of `covered` the resident JIT will also RUN — the
//RS     /// universe `cranelift_three_way_differential_battery` is scoped to.
//RS     resident_safe: Vec<String>,
//RS     /// `stem: reason`, one row per compile-covered stem the resident gate turns
//RS     /// away. The battery cannot run these, so it states how many it held back
//RS     /// and why, instead of quietly narrowing to the ones it can.
//RS     resident_refused: Vec<String>,
//RS     gaps: Vec<String>,
//RS     /// `stem: where: CODE: message`, one row per stem the oracle could not
//RS     /// judge. Shrink-only: each row is a defect to fix, never a skip to accept.
//RS     out_of_universe: Vec<String>,
//RS }
//RS 
//RS /// Observe which examples `compile_cranelift_bundle` accepts, once per test binary.
//RS ///
//RS /// The answer is a pure function of the example corpus and the compiler, and
//RS /// producing it compiles the whole corpus (~80s in CI). Both ratchet entry
//RS /// points want the same answer, so pay for it once.
//RS fn collect_jit_coverage() -> JitCoverage {
//RS     static COVERAGE: LazyLock<JitCoverage> = LazyLock::new(observe_jit_coverage);
//RS     (*COVERAGE).clone()
//RS }
//RS 
//RS fn observe_jit_coverage() -> JitCoverage {
//RS     let root = PathBuf::from(env!("CARGO_MANIFEST_DIR"));
//RS     // `topic_jet_files` yields `read_dir` order, which is the host filesystem's
//RS     // and not the corpus's. This walk compiles every bundle into one process, so
//RS     // an order-dependent verdict would make the ledger a property of the machine
//RS     // that dumped it. Sort the walk, exactly as `all_example_stems` already does.
