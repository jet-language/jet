// Rust: tests/dev_parts/support.rs:26
pub fn emit_native_aot(bundle: &ProgramBundle, ffi: FfiLink?) -> String {
    request :: MirArtifactRequest.new(MirArtifactTarget.RustAot, MirArtifactKind.NativeExecutable, MirArtifactBuildMode.Dev)
    (mir, artifact) := lower_checked_mir_program_for(bundle, request).expect("checked native artifact lowers through MIR")
    mir.validate().expect("canonical MIR validates in dev support")
    optimized :: optimize_mir_program(^mir, &MirOptimizationPolicy.conservative()).expect("canonical MIR optimizes in dev support")
    execution := MirRustExecutionConfig.for_artifact(artifact)
    execution.ffi = ffi
    emit_mir_program(&optimized, &MirRustConfig(target: TargetLayout.host(), target_kind: MirRustTarget.Native, root_prefix: "", execution: execution))
}

