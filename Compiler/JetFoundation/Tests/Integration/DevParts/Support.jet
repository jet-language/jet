// Rust: tests/dev_parts/support.rs:179
pub fn host_expected_stdout(stem: &String) -> String? {
    // GATE #4483: selected-target OS, not the machine running the compiler.
    if stem == "lowlevel/os_target_gating" {
        match target.selected_os() {
            "macos" -> return Some("macos: appkit\n")
            "windows" -> return Some("windows: win32\n")
            _ -> {}
        }
    }
    None
