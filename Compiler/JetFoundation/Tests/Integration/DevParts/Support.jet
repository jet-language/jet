//RS /// `jet_jit::on_compiler_stack` is the product boundary: it installs the sized
//RS /// compiler stack and carries the trace flags, tier rows, `struct_new` tally
//RS /// and tier artifact back to this thread. Re-entrancy makes it inline when an
//RS /// outer entry already crossed, so nesting it is free.
//RS fn with_jit_test_scope<T, F>(f: F) -> T
//RS where
//RS     F: FnOnce() -> T + Send,
//RS     T: Send,
//RS {
//RS     jet_jit::reset_jit_trace_for_test();
//RS     jet_jit::on_compiler_stack(f)
//RS }
