// Rust: tests/dev_parts/support.rs:187
pub fn uses_ffi_bridge(stem: &String) -> Bool {
    match stem {
        "lowlevel/ffi" | "lowlevel/inline_c" | "lowlevel/inline_asm" | "io/archive" | "io/db" |
        "crypto/crypto_envelope" | "crypto/crypto_sign" | "crypto/crypto_migration" | "crypto/crypto_suite" |
        "crypto/vault_secret" | "crypto/auth_tokens" | "io/compress_gzip" | "io/compress_zstd" -> true
        _ -> false
    }
}

