// Rust: tests/dev_parts/support.rs:243
// Keep the source stem as argv[0], and uniqueness in its containing directory.
pub fn compiled_binary_path(dir: &OSPath, tag: &String, i: USize, file: &String) -> OSPath {
    program_name :: OSPath.new(file).file_stem().and_then(|name| -> name.to_str()).expect("oracle source name is utf8")
    dir.join("jet_{tag}_{i}_bin").join(program_name)
}

// Rust: tests/dev_parts/support.rs:263
// Each tier receives its own file, never a shared pipe drained by the first tier.
pub fn answer_file(dir: &OSPath, tag: &String, i: USize, answers: &String) -> OSPath {
    path :: dir.join("jet_{tag}_{i}.stdin")
    fs.create_dir_all(dir).unwrap_or_else(|e| -> panic("create answer dir: {e}"))
    fs.write(&path, answers).unwrap_or_else(|e| -> panic("write answers for `{tag}`: {e}"))
    path
}

// Rust: tests/dev_parts/support.rs:294
// One list feeds both the command and the digest key.
pub const ORACLE_RUSTC_FLAGS: [String] = ["-O"]

// Rust: tests/dev_parts/support.rs:299
#Error
pub enum OracleBuildFailure {
    Io(std.io.Error)
    FrontEnd([Diagnostic])
    CLinks([Diagnostic])
    Rustc(Output)
}
impl OracleBuildFailure {
    // Rust: tests/dev_parts/support.rs:309
    pub fn describe(&self, stem: &String, file: &String) -> String {
        rendered :: |diags: &[Diagnostic]| -> {
            src :: fs.read_to_string(file).unwrap_or_default()
            jet.render_diagnostics(file, &src, diags)
        }
        match self {
            Io(error) -> "`{stem}` ran in dev but its oracle I/O failed (source read or scratch dir): {error}"
            FrontEnd(diags) -> "`{stem}` ran in dev but failed the front end:\n{rendered(diags)}"
            CLinks(diags) -> "`{stem}` ran in dev but AOT C-link resolution failed:\n{rendered(diags)}"
            Rustc(out) -> "`{stem}` ran in dev but generated Rust failed to build (status: {out.status}):\nstdout:\n{String.from_utf8_lossy(&out.stdout)}\nstderr:\n{String.from_utf8_lossy(&out.stderr)}"
        }
    }
}

// Rust: tests/dev_parts/support.rs:345
pub static ORACLE_CACHE_ROOT: LazyLock<OSPath?> = LazyLock.new(|| -> {
    common.assert_test_environment_is_safe()
    root :: match env.var_os("JET_DEV_ORACLE_CACHE_DIR") {
        Some(dir) -> {
            root :: OSPath.from(dir)
            common.assert_test_path_on_disk(&root, "JET_DEV_ORACLE_CACHE_DIR")
            root
        }
        None -> {
            rustc_salt :: ORACLE_RUSTC_IDENTITY.as_ref().map(|identity| -> jet.SHA256.sha256_hex(identity.as_bytes())).unwrap_or_else(|| -> "unknown")
            common.test_scratch_root("dev-oracle-cache").join("run-{std.process.id()}-{rustc_salt}")
        }
    }
    fs.create_dir_all(&root).ok().map(|_| -> ^root)
})

// Rust: tests/dev_parts/support.rs:371
pub static ORACLE_RUSTC_IDENTITY: LazyLock<String?> = LazyLock.new(|| -> {
    // GATE #4494: real toolchain subprocess identity; a failed probe disables reuse.
    out :: Command.new("rustc").arg("-vV").output().ok()?
    if out.status.success() { Some(String.from_utf8_lossy(&out.stdout).into_owned()) } else { None }
})

// Rust: tests/dev_parts/support.rs:394
pub fn oracle_cache_entry(rust: &String, ffi: FfiLink?, clinks: &[String]) -> OSPath? {
    root :: ORACLE_CACHE_ROOT.as_ref()?
    data: [U8] = []
    push_oracle_key_field(&data, "jet-dev-oracle-bin-v1".as_bytes())
    push_oracle_key_field(&data, rust.as_bytes())
    push_oracle_key_field(&data, ORACLE_RUSTC_IDENTITY.as_ref()?.as_bytes())
    loop flag in ORACLE_RUSTC_FLAGS { push_oracle_key_field(&data, flag.as_bytes()) }
    match ffi {
        None -> push_oracle_key_field(&data, "no-ffi".as_bytes())
        Some(link) -> {
            push_oracle_key_field(&data, link.crate_name.as_bytes())
            push_oracle_key_field(&data, link.rlib_path.to_string_lossy().as_bytes())
            push_oracle_key_field(&data, jet.SHA256.sha256_file_hex(&link.rlib_path).ok()?.as_bytes())
            artifacts_manifest :: link.rlib_path.parent()?.join("{link.crate_name}.sha256")
            push_oracle_key_field(&data, "ffi-artifacts.sha256".as_bytes())
            push_oracle_key_field(&data, artifacts_manifest.to_string_lossy().as_bytes())
            push_oracle_key_field(&data, jet.SHA256.sha256_file_hex(&artifacts_manifest).ok()?.as_bytes())
            loop deps_dir in link.dependency_dirs() { push_oracle_key_field(&data, deps_dir.to_string_lossy().as_bytes()) }
        }
    }
    loop arg in clinks { push_oracle_key_field(&data, arg.as_bytes()) }
    Some(root.join(jet.SHA256.sha256_hex(&data)))
}

// Rust: tests/dev_parts/support.rs:443
pub fn push_oracle_key_field(out: &[U8], value: &[U8]) -> {
    out.extend_from_slice(&(value.len() as U64).to_be_bytes())
    out.extend_from_slice(value)
}

// Rust: tests/dev_parts/support.rs:456
pub fn reuse_cached_oracle(entry: &OSPath, bin: &OSPath) -> Bool {
    ready :: entry.join("ready")
    artifact :: ready.join("artifact")
    digest :: ready.join("artifact.sha256")
    recorded :: match fs.read_to_string(&digest) { Ok(text) -> text; Err(_) -> return false }
    if !fs.symlink_metadata(&artifact).is_ok_and(|metadata| -> metadata.file_type().is_file()) ||
       !fs.symlink_metadata(&digest).is_ok_and(|metadata| -> metadata.file_type().is_file()) { return false }
    trimmed := recorded.trim() // #4303
    match jet.SHA256.sha256_file_hex(&artifact) { Ok(actual) if actual == trimmed -> {}; _ -> return false }
    _ :: fs.remove_file(bin)
    // GATE #4494: real hard link; copy only when the filesystems differ or linking fails.
    if fs.hard_link(&artifact, bin).is_err() && fs.copy(&artifact, bin).is_err() { return false }
    record_oracle_event("hit", entry)
    true
}

// Rust: tests/dev_parts/support.rs:495
pub fn publish_cached_oracle(entry: &OSPath, bin: &OSPath) -> {
    ready :: entry.join("ready")
    if ready.is_dir() { return }
    staged :: entry.join("staged.{std.process.id()}.{next_oracle_index()}")
    published :: (|| -> Unit std.io.Error! {
        fs.create_dir_all(&staged)?
        if fs.hard_link(bin, staged.join("artifact")).is_err() { _ :: fs.copy(bin, staged.join("artifact"))? }
        fs.write(staged.join("artifact.sha256"), jet.SHA256.sha256_file_hex(&staged.join("artifact"))?)?
        fs.rename(&staged, &ready)
    })()
    if published.is_err() { _ :: fs.remove_dir_all(&staged) }
}

// Rust: tests/dev_parts/support.rs:523
pub struct OracleCacheLock { dir: OSPath }
impl OracleCacheLock {
    // Rust: tests/dev_parts/support.rs:528
    pub fn acquire(entry: &OSPath) -> OracleCacheLock std.io.Error! {
        fs.create_dir_all(entry)?
        dir :: entry.join(".build-lock")
        loop {
            match fs.create_dir(&dir) {
                Ok(_) -> return Ok(OracleCacheLock(dir: ^dir))
                // GATE #4409: preserve AlreadyExists, never swallow other IO failures.
                Err(error) if error.kind() == std.io.ErrorKind.AlreadyExists -> {
                    stale :: fs.metadata(&dir).and_then(|meta| -> meta.modified()).and_then(|modified| -> modified.elapsed().map_err(std.io.Error.other)).is_ok_and(|age| -> age > Duration.from_secs(120))
                    if stale { _ :: fs.remove_dir(&dir) }
                    else { thread.sleep(Duration.from_millis(50)) } // GATE #4494
                }
                Err(error) -> return Err(error)
            }
        }
    }
    // Rust: tests/dev_parts/support.rs:552
    fn drop(&self) -> { _ :: fs.remove_dir(&self.dir) }
}

// Rust: tests/dev_parts/support.rs:557
#Derive(Default)
pub struct OracleCacheCounts { hits: USize; misses: USize; builds: USize }
// Rust: tests/dev_parts/support.rs:564
pub static ORACLE_CACHE_COUNTS: LazyLock<Mutex<OracleCacheCounts>> = LazyLock.new(|| -> Mutex.new(OracleCacheCounts.default()))

// Rust: tests/dev_parts/support.rs:567
pub fn report_oracle_cache_counts() -> {
    counts :: ORACLE_CACHE_COUNTS.lock().unwrap_or_else(|poisoned| -> poisoned.into_inner())
    if counts.hits + counts.misses + counts.builds > 0 {
        eprintln("oracle cache: {counts.hits} hits, {counts.misses} misses, {counts.builds} builds")
    }
}

// Rust: tests/dev_parts/support.rs:607
// Best-effort shared-run event ledger; a missing counter never changes a verdict.
pub fn record_oracle_event(event: &String, entry: &OSPath) -> {
    if counts := ORACLE_CACHE_COUNTS.lock().ok() {
        match event { "hit" -> counts.hits += 1; "miss" -> counts.misses += 1; "build" -> counts.builds += 1; _ -> {} }
    }
    root :: match ORACLE_CACHE_ROOT.as_ref() { Some(root) -> root; None -> return }
    key :: match entry.file_name() { Some(key) -> key.to_string_lossy(); None -> return }
    if log := fs.OpenOptions.new().append(true).create(true).open(root.join("events")).ok() {
        _ :: log.write_all("{event} {key}\n".as_bytes())
    }
}

// Rust: tests/dev_parts/support.rs:636
pub fn aot_scratch_dir(tag: &String, stem: &String) -> OSPath {
    flat_stem :: stem.replace('/', "_")
    common.test_scratch_root("aot").join("{tag}_{flat_stem}_{std.process.id()}")
}

// Rust: tests/dev_parts/support.rs:648
pub fn build_oracle_binary(dir: &OSPath, tag: &String, i: USize, stem: &String, file: &String) -> OSPath OracleBuildFailure! {
    common.assert_test_environment_is_safe()
    common.assert_test_path_on_disk(dir, "AOT scratch")
    src :: fs.read_to_string(file).map_err(OracleBuildFailure.Io)?
    compiled :: jet.compile_with_path(&src, file).map_err(OracleBuildFailure.FrontEnd)?
    clinks :: jet.resolve_c_links(file).map_err(OracleBuildFailure.CLinks)?
    build_oracle_binary_from_parts(dir, tag, i, stem, file, ^compiled.rust, ^compiled.ffi, ^clinks)
}

// Rust: tests/dev_parts/support.rs:666
pub fn build_oracle_binary_from_bundle(dir: &OSPath, tag: &String, i: USize, stem: &String, file: &String, bundle: &ProgramBundle) -> OSPath OracleBuildFailure! {
    common.assert_test_environment_is_safe()
    common.assert_test_path_on_disk(dir, "AOT scratch")
    ffi :: jet.FFI.prepare(bundle).map_err(OracleBuildFailure.FrontEnd)?
    rust :: emit_native_aot(bundle, ffi.as_ref())
    clinks :: jet.resolve_c_links_for_bundle(bundle, None).map_err(OracleBuildFailure.CLinks)?
    build_oracle_binary_from_parts(dir, tag, i, stem, file, ^rust, ^ffi, ^clinks)
}

// Rust: tests/dev_parts/support.rs:683
pub fn build_oracle_binary_from_parts(dir: &OSPath, tag: &String, i: USize, stem: &String, file: &String, rust: String, ffi: FfiLink?, clinks: [String]) -> OSPath OracleBuildFailure! {
    bin :: compiled_binary_path(dir, tag, i, file)
    fs.create_dir_all(bin.parent().expect("oracle binary has a parent")).map_err(OracleBuildFailure.Io)?
    entry :: oracle_cache_entry(&rust, ffi.as_ref(), &clinks)
    if cache_entry := entry.as_ref() {
        if reuse_cached_oracle(cache_entry, &bin) { return Ok(bin) }
        record_oracle_event("miss", cache_entry)
    }
    cache_lock :: entry.as_ref().and_then(|entry| -> {
        match OracleCacheLock.acquire(entry) {
            Ok(lock) -> Some(lock)
            Err(error) -> {
                eprintln("note: oracle cache lock unavailable for {entry.display()}: {error}; building uncached")
                None
            }
        }
    })
    if cache_entry := entry.as_ref() {
        if reuse_cached_oracle(cache_entry, &bin) { return Ok(bin) }
        if cache_lock.is_some() { _ :: fs.remove_dir_all(cache_entry.join("ready")) }
    }
    rs :: dir.join("jet_{tag}_{i}.rs")
    rustc_cmd := Command.new("rustc")
    runtime_lease :: common.add_generated_rust(&rustc_cmd, &rs, &rust, ffi.is_some(), ORACLE_RUSTC_FLAGS)
    rustc_cmd.arg("-o").arg(&bin)
    if link := ffi.as_ref() {
        rustc_cmd.arg("--extern").arg("{link.crate_name}={link.rlib_path.display()}")
        loop deps_dir in link.dependency_dirs().filter(|dir| -> dir.is_dir()) {
            rustc_cmd.arg("-L").arg("dependency={deps_dir.display()}")
        }
    }
    loop arg in clinks { rustc_cmd.arg(arg) }
    out :: command_output_with_timeout(^rustc_cmd, *DEV_DIFF_TIMEOUT, "rustc build for `{stem}`")
    if cache_entry := entry.as_ref() { record_oracle_event(if out.status.success() { "build" } else { "fail" }, cache_entry) }
    if !out.status.success() { return Err(OracleBuildFailure.Rustc(out)) }
    if cache_entry := entry.as_ref() { publish_cached_oracle(cache_entry, &bin) }
    // cache_lock and runtime_lease remain alive through compilation and publication.
    Ok(bin)
}

// Rust: tests/dev_parts/support.rs:780
pub fn compiled_binary_output(dir: &OSPath, tag: &String, i: USize, stem: &String, file: &String) -> ProgramOutput {
    compiled_binary_output_with_stdin(dir, tag, i, stem, file, None)
}

// Rust: tests/dev_parts/support.rs:790
pub fn compiled_binary_output_from_bundle(_dir: &OSPath, tag: &String, i: USize, stem: &String, file: &String, bundle: &ProgramBundle) -> ProgramOutput {
    dir :: aot_scratch_dir(tag, stem)
    bin :: build_oracle_binary_from_bundle(&dir, tag, i, stem, file, bundle).unwrap_or_else(|failure| -> panic("{failure.describe(stem, file)}"))
    run :: command_output_with_timeout(Command.new(&bin), *DEV_DIFF_TIMEOUT, "compiled binary run for `{stem}`")
    ProgramOutput.ran(String.from_utf8_lossy(&run.stdout).to_string(), String.from_utf8_lossy(&run.stderr).to_string(), run.status.code().unwrap_or(1))
}

// Rust: tests/dev_parts/support.rs:820
pub fn compiled_binary_output_with_stdin(_dir: &OSPath, tag: &String, i: USize, stem: &String, file: &String, answers: String?) -> ProgramOutput {
    dir :: aot_scratch_dir(tag, stem)
    bin :: build_oracle_binary(&dir, tag, i, stem, file).unwrap_or_else(|failure| -> panic("{failure.describe(stem, file)}"))
    run_cmd := Command.new(&bin)
    if input := answers { run_cmd.stdin(fs.File.open(answer_file(&dir, tag, i, input)).unwrap()) }
    if stem == "ui/ui_native_linux" { run_cmd.env("JET_UI_HEADLESS", "1") }
    runtime_timeout :: if stem == "io/os_process_control" { Duration.from_secs(120) } else { *DEV_DIFF_TIMEOUT }
    run :: command_output_with_timeout(^run_cmd, runtime_timeout, "compiled binary run for `{stem}`")
    ProgramOutput.ran(String.from_utf8_lossy(&run.stdout).to_string(), String.from_utf8_lossy(&run.stderr).to_string(), run.status.code().unwrap_or(1))
}

// Rust: tests/dev_parts/support.rs:863
pub fn try_compiled_binary_build(_dir: &OSPath, tag: &String, i: USize, stem: &String, file: &String) -> OSPath? {
    dir :: aot_scratch_dir(tag, stem)
    build_oracle_binary(&dir, tag, i, stem, file).ok()
}

// Rust: tests/dev_parts/support.rs:874
pub fn try_compiled_binary_output(dir: &OSPath, tag: &String, i: USize, stem: &String, file: &String) -> ProgramOutput? {
    bin :: try_compiled_binary_build(dir, tag, i, stem, file)?
    run :: command_output_with_timeout(Command.new(&bin), *DEV_DIFF_TIMEOUT, "compiled binary run for `{stem}`")
    Some(ProgramOutput.ran(String.from_utf8_lossy(&run.stdout).to_string(), String.from_utf8_lossy(&run.stderr).to_string(), run.status.code().unwrap_or(1)))
}

// Rust: tests/dev_parts/support.rs:894
pub fn command_output_with_timeout(cmd: Command, timeout: Duration, label: &String) -> Output {
    // GATE #4494: real process spawn, native file handles, poll, kill and reap.
    stamp :: SystemTime.now().duration_since(UNIX_EPOCH).unwrap().as_nanos()
    base :: env.temp_dir().join("jet_dev_timeout_{std.process.id()}_{stamp}")
    stdout_path :: base.with_extension("stdout")
    stderr_path :: base.with_extension("stderr")
    stdout_file :: fs.File.create(&stdout_path).unwrap_or_else(|e| -> panic("{label}: failed to create stdout temp file: {e}"))
    stderr_file :: fs.File.create(&stderr_path).unwrap_or_else(|e| -> panic("{label}: failed to create stderr temp file: {e}"))
    child := cmd.stdout(Stdio.from(^stdout_file)).stderr(Stdio.from(^stderr_file)).spawn().unwrap_or_else(|e| -> panic("{label}: failed to spawn: {e}"))
    start :: Instant.now()
    loop {
        match child.try_wait() {
            Ok(Some(_)) -> {
                status :: child.wait().unwrap_or_else(|e| -> panic("{label}: failed to collect status: {e}"))
                stdout :: fs.read(&stdout_path).unwrap_or_default()
                stderr :: fs.read(&stderr_path).unwrap_or_default()
                _ :: fs.remove_file(&stdout_path)
                _ :: fs.remove_file(&stderr_path)
                return Output(status: status, stdout: ^stdout, stderr: ^stderr)
            }
            Ok(None) if start.elapsed() >= timeout -> {
                _ :: child.kill()
                _ :: child.wait()
                stdout :: fs.read(&stdout_path).unwrap_or_default()
                stderr :: fs.read(&stderr_path).unwrap_or_default()
                _ :: fs.remove_file(&stdout_path)
                _ :: fs.remove_file(&stderr_path)
                panic("{label}: timed out after {timeout:?}\nstdout:\n{String.from_utf8_lossy(&stdout)}\nstderr:\n{String.from_utf8_lossy(&stderr)}")
            }
            Ok(None) -> thread.sleep(Duration.from_millis(10))
            Err(e) -> panic("{label}: failed to poll child: {e}")
        }
    }
}

// Rust: tests/dev_parts/support.rs:965
// Run a child, not an injected reader: each tier owns its actual fd 0.
pub fn cli_tier_output_with_answers(file: &String, stem: &String, answers: &String, interpret: Bool, trace: Bool) -> Output {
    tag :: "{stem.replace('/', "_")}_{if interpret { "interp" } else { "default" }}"
    cache :: common.unique_tmp("jet_stdin_{tag}_cache")
    fs.create_dir_all(&cache).unwrap()
    cmd := Command.new(common.jet_bin())
    cmd.arg("run").arg(file)
    if interpret { cmd.arg("--interpret") }
    cmd.arg("--quiet")
    if trace { cmd.arg("--trace-tiers") }
    cmd.current_dir(common.manifest_dir()).env("NO_COLOR", "1").env("JET_RUN_CACHE_DIR", &cache).env("JET_STORE_DIR", cache.join("build")).stdin(fs.File.open(answer_file(&cache, &tag, 0, answers)).unwrap())
    output :: command_output_with_timeout(^cmd, *DEV_DIFF_TIMEOUT, "`jet run` with answers for `{stem}` ({tag})")
    _ :: fs.remove_dir_all(&cache)
    output
}

// Rust: tests/dev_parts/support.rs:1008
pub fn assert_cli_tier_answered(file: &String, stem: &String, answers: &String, interpret: Bool) -> {
    traced :: cli_tier_output_with_answers(file, stem, answers, interpret, true)
    assert(traced.status.success(), "traced `jet run{if interpret { " --interpret" } else { "" }}` failed for `{stem}`:\nstdout:\n{String.from_utf8_lossy(&traced.stdout)}\nstderr:\n{String.from_utf8_lossy(&traced.stderr)}")
    trace :: String.from_utf8_lossy(&traced.stderr)
    (wanted, forbidden) :: if interpret { ("tier0 interp", "tier1 native") } else { ("tier1 native", "tier0 interp") }
    assert(trace.contains(wanted), "`{stem}` did not report `{wanted}` when fed its answers:\n{trace}")
    assert(!trace.contains(forbidden), "`{stem}` reached `{forbidden}` when it had to stay on `{wanted}`:\n{trace}")
}

// Rust: tests/dev_parts/support.rs:1034
pub fn cli_tier_program_output(file: &String, stem: &String, answers: &String, interpret: Bool) -> ProgramOutput {
    output :: cli_tier_output_with_answers(file, stem, answers, interpret, false)
    ProgramOutput.ran(String.from_utf8_lossy(&output.stdout).into_owned(), String.from_utf8_lossy(&output.stderr).into_owned(), output.status.code().unwrap_or(1))
}

// Rust: tests/dev_parts/support.rs:1048
pub fn dev_iteration_with_timeout(stem: &String, file: &String, use_interpreter: Bool) -> RunOutcome {
    worker_file :: file.clone()
    // GATE #4494: native thread, mpsc channel and timed receive; preserve trace flags.
    (tx, rx) :: std.sync.mpsc.channel()
    thread.Builder.new().name("dev-iter-{stem}").spawn(move || -> {
        jet_jit.reset_jit_trace_for_test()
        out :: dev_iteration(&worker_file, false, use_interpreter)
        flags :: jet_jit.jit_trace_flags_for_test()
        _ :: tx.send((out, flags))
    }).expect("dev_iteration worker")
    (out, flags) :: rx.recv_timeout(*DEV_DIFF_TIMEOUT).unwrap_or_else(|_| -> panic("dev_iteration timed out after {*DEV_DIFF_TIMEOUT:?} for `{stem}` ({file}) with use_interpreter={use_interpreter}"))
    jet_jit.merge_jit_trace_flags_for_test(flags)
    out
}

// Rust: tests/dev_parts/support.rs:1086
// Only direct topic children; manifests, expected/ and project subdirectories are not entries.
pub fn topic_jet_files(root: &OSPath) -> [OSPath] {
    files: [OSPath] = []
    loop topic_entry in fs.read_dir(root.join("Examples/features")).unwrap().flatten() {
        topic_path :: topic_entry.path()
        if !topic_path.is_dir() { continue }
        if topic_path.file_name().unwrap().to_string_lossy() == "expected" { continue }
        loop entry in fs.read_dir(&topic_path).unwrap().flatten() {
            path :: entry.path()
            if path.extension().and_then(|s| -> s.to_str()) != Some("jet") { continue }
            if path.file_name().and_then(|n| -> n.to_str()) == Some(jet.Syntax.PACKAGE_FILE) { continue }
            files.push(^path)
        }
    }
    files
}

// Rust: tests/dev_parts/support.rs:1117
pub fn stem_of(root: &OSPath, path: &OSPath) -> String {
    relative :: path.strip_prefix(root.join("Examples/features")).unwrap().with_extension("")
    relative.to_string_lossy().replace('\\', "/")
}

// Rust: tests/dev_parts/support.rs:1126
pub fn all_example_stems() -> [String] {
    root :: OSPath.from(common.manifest_dir())
    stems := topic_jet_files(&root).iter().map(|p| -> stem_of(&root, p)).collect<[String]>()
    stems.sort()
    stems
}

// Rust: tests/dev_parts/support.rs:1140
pub fn core_conformance_corpus_entries() -> [(String, String)] {
    // Rust: tests/dev_parts/support.rs:1141
    fn walk(dir: &OSPath, files: &[OSPath]) -> {
        loop entry in fs.read_dir(dir).unwrap_or_else(|error| -> panic("Core conformance corpus directory `{dir.display()}` unreadable: {error}")) {
            path :: entry.expect("Core conformance corpus entry").path()
            name :: path.file_name().and_then(|value| -> value.to_str()).unwrap_or("")
            if name.starts_with(".") || name == "package.jet" { continue }
            if path.is_dir() { walk(&path, files) }
            else if path.extension().and_then(|value| -> value.to_str()) == Some("jet") { files.push(^path) }
        }
    }
    root :: OSPath.from(common.manifest_dir())
    corpus :: root.join("tests/conformance/corpus")
    if !corpus.is_dir() { return [] }
    files: [OSPath] = []
    walk(&corpus, &files)
    entries := files.into_iter().map(|path| -> {
        relative :: path.strip_prefix(&corpus).expect("conformance path belongs to conformance corpus").with_extension("")
        ("conformance/{relative.to_string_lossy().replace('\\', "/")}", path.to_string_lossy().into_owned())
    }).collect<[(String, String)]>()
    entries.sort_by(|left, right| -> left.0.cmp(&right.0))
    entries
}

// Rust: tests/dev_parts/support.rs:1191
pub fn corpus_gate_shard_config() -> (USize, USize)? {
    index :: env.var("JET_CORPUS_GATE_SHARD_INDEX").ok()
    count :: env.var("JET_CORPUS_GATE_SHARD_COUNT").ok()
    match (index, count) {
        (None, None) -> None
        (Some(index), Some(count)) -> {
            parsed_index :: index.parse<USize>().unwrap_or_else(|_| -> panic("JET_CORPUS_GATE_SHARD_INDEX must be a non-negative integer, got `{index}`"))
            parsed_count :: count.parse<USize>().unwrap_or_else(|_| -> panic("JET_CORPUS_GATE_SHARD_COUNT must be a positive integer, got `{count}`"))
            assert(parsed_count > 0, "JET_CORPUS_GATE_SHARD_COUNT must be >= 1, got {parsed_count}")
            assert(parsed_index < parsed_count, "JET_CORPUS_GATE_SHARD_INDEX ({parsed_index}) must be < JET_CORPUS_GATE_SHARD_COUNT ({parsed_count})")
            Some((parsed_index, parsed_count))
        }
        _ -> panic("JET_CORPUS_GATE_SHARD_INDEX and JET_CORPUS_GATE_SHARD_COUNT must be set together")
    }
}

// Rust: tests/dev_parts/support.rs:1224
pub fn corpus_gate_stem_weight(class: CorpusGateClass?) -> U64 {
    match class {
        Some(CorpusGateClass.FrontendRejected | CorpusGateClass.GateExcluded | CorpusGateClass.NonRunnable | CorpusGateClass.OracleUnavailable) -> 1
        Some(CorpusGateClass.ExpectedExit) -> 2
        Some(CorpusGateClass.AotBroken | CorpusGateClass.RunTierBroken) -> 3
        Some(CorpusGateClass.ResidentJit | CorpusGateClass.DeoptInterp | CorpusGateClass.TierDivergent) | None -> 4
    }
}

// Rust: tests/dev_parts/support.rs:1243
pub fn corpus_gate_shard_stems(stems: [String]) -> [String] {
    (index, count) :: match corpus_gate_shard_config() { Some(config) -> config; None -> return stems }
    weights: [String: CorpusGateClass] = [:]
    loop record in parse_corpus_gate_manifest() { weights.insert(^record.stem, record.class) }
    input := ""
    loop stem in stems { input.push_str("{corpus_gate_stem_weight(weights.get(stem))}\t{stem}\n") }
    // GATE #4494: actual shared shard-engine child with piped stdin and output.
    child := Command.new("bash").arg(OSPath.from(common.manifest_dir()).join("Tools/ci/weighted-shards.sh")).args([index.to_string(), count.to_string()]).stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().expect("spawn shared weighted shard engine")
    child.stdin.as_mut().expect("shared weighted shard stdin").write_all(input.as_bytes()).expect("write corpus stems to shared weighted shard engine")
    output :: child.wait_with_output().expect("wait for shared weighted shard engine")
    assert(output.status.success(), "shared weighted shard engine failed:\n{String.from_utf8_lossy(&output.stderr)}")
    known: [String: Bool] = [:]
    loop stem in stems { known.insert(stem, true) }
    selected := String.from_utf8_lossy(&output.stdout).lines().filter(|stem| -> !stem.is_empty()).map(|stem| -> stem.to_string()).collect<[String]>()
    assert(selected.iter().all(|stem| -> known.contains_key(stem)), "shared weighted shard engine emitted a stem outside its input: {selected:?}")
    selected.sort()
    assert(selected.windows(2).all(|pair| -> pair[0] != pair[1]), "shared weighted shard engine emitted a duplicate stem: {selected:?}")
    selected
}

// Rust: tests/dev_parts/support.rs:1301
pub fn corpus_gate_selected_stems() -> [String] {
    stems := all_example_stems()
    if filter := env.var("JET_CORPUS_GATE_FILTER").ok() { stems.retain(|stem| -> stem.contains(&filter)) }
    corpus_gate_shard_stems(^stems)
}

// Rust: tests/dev_parts/support.rs:1311
pub fn frontend_rejected_stems() -> [String: Bool] {
    rejected: [String: Bool] = [:]
    loop record in parse_corpus_gate_manifest() {
        if record.class == CorpusGateClass.FrontendRejected { rejected.insert(^record.stem, true) }
    }
    rejected
}

// Rust: tests/dev_parts/support.rs:1319
pub fn interpreter_example_stems() -> [String] {
    rejected :: frontend_rejected_stems()
    all_example_stems().into_iter().filter(|stem| -> !rejected.contains_key(stem)).collect<[String]>()
}

// Rust: tests/dev_parts/support.rs:1373
// Shrink-only: derived compiler diagnostic rows are defects, never a stem allowlist.
pub const SEMA_REJECTED_CEILING: USize = 0

// Rust: tests/dev_parts/support.rs:1377
pub fn typechecked_example_stems() -> ([String], [String]) {
    accepted: [String] = []
    rejected: [String] = []
    loop stem in all_example_stems() {
        file :: example_path(&stem)
        diags :: match fs.read_to_string(&file) {
            Ok(source) -> {
                if jet.Driver.selects_build_entry(&source, None) {
                    jet.Driver.compile_bundle_path_build(&file, jet.Driver.BuildRunOptions.default()).map(|_| -> []).unwrap_or_else(|diags| -> diags)
                } else { jet.check_with_path(&file) }
            }
            Err(_) -> jet.check_with_path(&file)
        }
        if diags.iter().any(|d| -> d.severity == Severity.Error) { rejected.push("{stem}: {first_diagnostic_summary(&diags)}") }
        else { accepted.push(^stem) }
    }
    (^accepted, ^rejected)
}

// Rust: tests/dev_parts/support.rs:1414
pub fn first_diagnostic_summary(diagnostics: &[Diagnostic]) -> String {
    first :: diagnostics.iter().find(|d| -> d.severity == Severity.Error).or_else(|| -> diagnostics.first())
    match first {
        Some(d) -> "{d.code}: {d.what.replace('\n', " ")}"
        None -> "failed without a diagnostic"
    }
}

// Rust: tests/dev_parts/support.rs:1439
pub enum JitCompileVerdict {
    Covered { resident_refusal: String? }
    Gap(String)
    OutOfUniverse(String)
}

// Rust: tests/dev_parts/support.rs:1479
// Reviewed corpus floor: excludes the topic manifest, not a shipped example.
pub const EXAMPLE_CORPUS_FLOOR: USize = 497
// Rust: tests/dev_parts/support.rs:1503
// Shrink-only number of compiler-derived rows the oracle cannot judge.
pub const OUT_OF_UNIVERSE_CEILING: USize = 0
// Rust: tests/dev_parts/support.rs:1518
// Recorded conservative floor, 353 resident-safe at 0f5505640.
pub const RESIDENT_SAFE_FLOOR: USize = 353
// Rust: tests/dev_parts/support.rs:1528
// Recorded executed floor, 344 ran at 0f5505640.
pub const THREE_WAY_RAN_FLOOR: USize = 344

// Rust: tests/dev_parts/support.rs:1535
#Derive(Clone)
pub struct JitCoverage {
    corpus: USize
    covered: [String]
    resident_safe: [String]
    resident_refused: [String]
    gaps: [String]
    out_of_universe: [String]
}

// Rust: tests/dev_parts/support.rs:1558
pub fn collect_jit_coverage() -> JitCoverage {
    // GATE #4494: once per test binary, rather than recompiling the corpus for each reader.
    static COVERAGE: LazyLock<JitCoverage> = LazyLock.new(observe_jit_coverage)
    (*COVERAGE).clone()
}

// Rust: tests/dev_parts/support.rs:1563
pub fn observe_jit_coverage() -> JitCoverage {
    root :: OSPath.from(common.manifest_dir())
    paths := topic_jet_files(&root)
    paths.sort()
    corpus :: paths.len()
    covered: [String] = []
    resident_safe: [String] = []
    resident_refused: [String] = []
    gaps: [String] = []
    out_of_universe: [String] = []
    loop path in paths {
        stem :: stem_of(&root, &path)
        match classify_jit_compile(&path) {
            JitCompileVerdict.Covered { resident_refusal } -> {
                match resident_refusal {
                    None -> resident_safe.push(stem.clone())
                    Some(reason) -> resident_refused.push("{stem}: {reason}")
                }
                covered.push(^stem)
            }
            JitCompileVerdict.Gap(reason) -> gaps.push("{stem}: {reason}")
            JitCompileVerdict.OutOfUniverse(reason) -> out_of_universe.push("{stem}: {reason}")
        }
    }
    covered.sort()
    resident_safe.sort()
    resident_refused.sort()
    gaps.sort()
    out_of_universe.sort()
    assert_eq(covered.len() + gaps.len() + out_of_universe.len(), corpus, "the compile oracle lost a stem: {corpus} discovered, {covered.len()} covered, {gaps.len()} gap(s), {out_of_universe.len()} outside the universe. Every discovered stem lands in exactly one bucket (#1998)")
    assert_eq(resident_safe.len() + resident_refused.len(), covered.len(), "the resident gate lost a stem: {covered.len()} compile-covered, {resident_safe.len()} resident-safe, {resident_refused.len()} refused. Every compile-covered stem lands in exactly one of the two (#2012)")
    JitCoverage(corpus: corpus, covered: ^covered, resident_safe: ^resident_safe, resident_refused: ^resident_refused, gaps: ^gaps, out_of_universe: ^out_of_universe)
}

// Rust: tests/dev_parts/support.rs:1632
pub fn classify_jit_compile(path: &OSPath) -> JitCompileVerdict {
    file := path.to_string_lossy() // #4303
    if fs.read_to_string(path).ok().is_some_and(|source| -> jet.Driver.selects_build_entry(&source, None)) {
        return match jet.Driver.compile_bundle_path_build(&file, jet.Driver.BuildRunOptions.default()) {
            Ok(output) -> match output.runtime {
                Some(bundle) -> classify_jit_bundle(^bundle)
                None -> JitCompileVerdict.OutOfUniverse("build front end returned no runtime bundle")
            }
            Err(diagnostics) -> JitCompileVerdict.OutOfUniverse("build: {first_diagnostic_summary(&diagnostics)}")
        }
    }
    bundle := match jet.Loader.load_entry(&file) {
        Ok(bundle) -> bundle
        Err(diagnostics) -> return JitCompileVerdict.OutOfUniverse("loader: {first_diagnostic_summary(&diagnostics)}")
    }
    // Seed the same locked build-fact snapshot as classify_corpus_stem before sema.
    if diagnostics := jet.Driver.seed_build_facts(&bundle, "dev", false, &[:]).err() {
        return JitCompileVerdict.OutOfUniverse("build facts: {first_diagnostic_summary(&diagnostics)}")
    }
    errors :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run).into_iter().filter(|d| -> d.severity == Severity.Error).collect<[Diagnostic]>()
    if !errors.is_empty() { return JitCompileVerdict.OutOfUniverse("sema: {first_diagnostic_summary(&errors)}") }
    classify_jit_bundle(^bundle)
}

// Rust: tests/dev_parts/support.rs:1700
pub fn classify_jit_bundle(bundle: ProgramBundle) -> JitCompileVerdict {
    match common.compile_cranelift_bundle(&bundle, &common.development_policy()) {
        Ok(_) -> {
            refusal :: common.cranelift_resident_safe_detail(&bundle)
            JitCompileVerdict.Covered(resident_refusal: if refusal.is_empty() { None } else { Some(^refusal) })
        }
        Err(reason) -> JitCompileVerdict.Gap(reason)
    }
}

// Rust: tests/dev_parts/support.rs:1716
pub fn is_manifested_parity_divergence(stem: &String, entries: &[String]) -> Bool {
    entries.iter().any(|entry| -> entry.strip_prefix(stem).is_some_and(|rest| -> rest.starts_with(':')))
}

// Rust: tests/dev_parts/support.rs:1724
pub fn normalize_for_parity(stem: &String, out: ProgramOutput) -> ProgramOutput {
    normalized := ^out
    if stem == "io/log" || stem == "io/log_structured" || stem == "serde/json_coerce" { normalized.stderr = normalize_json_log_timestamps(&normalized.stderr) }
    if stem == "io/log_human" { normalized.stderr = normalize_text_log_timestamps(&normalized.stderr) }
    if stem == "ui/ui_native_linux" { normalized.stderr = normalize_gtk_loader_path(&normalized.stderr) }
    // Remove AOT reporting envelopes, not program result bytes.
    if stem == "errors/typed_error_families" {
        normalized.stderr = normalized.stderr.lines().filter(|line| -> {
            hop :: line.strip_prefix("  ").is_some_and(|rest| -> rest.split_once(". ").is_some_and(|pair| -> pair.0.parse<U32>().is_ok()))
            !line.starts_with(" Trail [E3002] (") && !hop
        }).collect<[String]>().join("\n")
        if !normalized.stderr.is_empty() && !normalized.stderr.ends_with('\n') { normalized.stderr.push('\n') }
    }
    normalized.stderr = strip_panic_locals(&normalized.stderr)
    normalized
}

// Rust: tests/dev_parts/support.rs:1761
pub fn normalize_gtk_loader_path(s: &String) -> String {
    marker :: ": symbol lookup error: "
    if !s.contains("libgtk-4.so.1") || !s.contains("undefined symbol") { return s.to_string() }
    match s.split_once(marker) { Some((_, rest)) -> "<jet-ui-binary>{marker}{rest}"; None -> s.to_string() }
}

// Rust: tests/dev_parts/support.rs:1773
pub fn normalize_json_log_timestamps(s: &String) -> String {
    out := String.with_capacity(s.len())
    rest := s
    loop {
        pos :: match rest.find("\"ts\":") { Some(pos) -> pos; None -> break }
        out.push_str(&rest[..pos])
        out.push_str("\"ts\":<ts>")
        tail := &rest[pos + "\"ts\":".len()..] // #4303
        ws :: tail.bytes().take_while(|b| -> b.is_ascii_whitespace()).count()
        tail = &tail[ws..]
        digits :: tail.bytes().take_while(|b| -> b.is_ascii_digit()).count()
        rest = &tail[digits..]
    }
    out.push_str(rest)
    out
}

// Rust: tests/dev_parts/support.rs:1791
pub fn normalize_text_log_timestamps(s: &String) -> String {
    s.lines().map(|line| -> {
        (level, rest) :: match line.split_once(' ') { Some(pair) -> pair; None -> return line.to_string() }
        (_, msg) :: match rest.split_once(" | ") { Some(pair) -> pair; None -> return line.to_string() }
        "{level} <ts> | {msg}"
    }).collect<[String]>().join("\n") + if s.ends_with('\n') { "\n" } else { "" }
}
