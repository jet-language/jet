//RS #[derive(Default)]
//RS struct OracleCacheCounts {
//RS     hits: usize,
//RS     misses: usize,
//RS     builds: usize,
//RS }
//RS 
//RS static ORACLE_CACHE_COUNTS: LazyLock<Mutex<OracleCacheCounts>> =
//RS     LazyLock::new(|| Mutex::new(OracleCacheCounts::default()));
//RS 
//RS fn report_oracle_cache_counts() {
//RS     let counts = ORACLE_CACHE_COUNTS
//RS         .lock()
//RS         .unwrap_or_else(|poisoned| poisoned.into_inner());
//RS     if counts.hits + counts.misses + counts.builds > 0 {
//RS         eprintln!(
//RS             "oracle cache: {} hits, {} misses, {} builds",
//RS             counts.hits, counts.misses, counts.builds
//RS         );
//RS     }
//RS }
//RS 
//RS /// One line per oracle event in the shared cache root — the #2076 ledger.
//RS ///
//RS /// Six battery processes share the root, so a per-process counter cannot state
//RS /// a combined count and an appended line can. The run file is cumulative; total
//RS /// builds against the number of DISTINCT keys built is the duplicate-compile
//RS /// count the card gates on:
//RS ///
//RS /// ```text
//RS /// events="$JET_DEV_ORACLE_CACHE_DIR/events"
//RS /// builds=$(grep -c '^build ' "$events")
//RS /// distinct=$(awk '$1=="build"{print $2}' "$events" | sort -u | wc -l)
//RS /// hits=$(grep -c '^hit ' "$events")
//RS /// echo "duplicate optimized oracle compiles: $((builds - distinct)) (was $((hits + builds - distinct)))"
//RS /// ```
//RS ///
//RS /// Every `hit` is a compile the current or an earlier run did not pay and the
//RS /// old harness did, so the cumulative ledger still exposes reuse without a
//RS /// cache-off run.
//RS ///
//RS /// `miss` records a caller that needed the lock, `hit` a reuse, `build` a paid
//RS /// compile, and `fail` a compile rustc rejected. A rejection is deliberately
//RS /// NOT published, so the few examples whose oracle is known broken
//RS /// (`AOT_BROKEN_HELD_OUT`) still pay their compile in every battery that reaches
//RS /// them, and the ledger says so by name instead of hiding them in the duplicate
//RS /// count.
//RS ///
//RS /// Best effort by construction: this ledger measures the cache and never gates
//RS /// a battery, so a failed append costs a number, never a verdict.
//RS fn record_oracle_event(event: &str, entry: &std::path::Path) {
//RS     if let Ok(mut counts) = ORACLE_CACHE_COUNTS.lock() {
//RS         match event {
//RS             "hit" => counts.hits += 1,
//RS             "miss" => counts.misses += 1,
//RS             "build" => counts.builds += 1,
//RS             _ => {}
//RS         }
//RS     }
//RS     let Some(root) = ORACLE_CACHE_ROOT.as_ref() else {
//RS         return;
//RS     };
//RS     let Some(key) = entry.file_name() else {
//RS         return;
//RS     };
//RS     let key = key.to_string_lossy();
//RS     if let Ok(mut log) = fs::OpenOptions::new()
//RS         .append(true)
//RS         .create(true)
//RS         .open(root.join("events"))
//RS     {
//RS         use std::io::Write;
//RS         let _ = log.write_all(format!("{event} {key}\n").as_bytes());
//RS     }
//RS }
