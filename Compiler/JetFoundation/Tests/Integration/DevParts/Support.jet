pub fn require_multi_head_parity_prereqs() -> {
    assert(jet_jit.cranelift_host_supported(), "multi-head parity requires a supported Cranelift host; project harness must provision one")
    assert(common.have_rustc(), "multi-head parity requires rustc; project harness must provision it")
}

