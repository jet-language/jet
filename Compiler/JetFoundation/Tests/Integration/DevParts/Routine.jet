use jet_foundation.Tests.Integration.DevParts.Support.*
use jet_foundation.Tests.Integration.DevParts.Support02.*
use jet_foundation.Tests.Integration.Common as common
use std.process.[Command, Child]

// Rust: tests/dev_parts/routine.rs:1742
pub struct TlsServer { pub child: Child }
impl TlsServer.Drop {
    // Rust: tests/dev_parts/routine.rs:1742
    fn drop(self) -> {
        // GATE #4494: stop and reap the real OpenSSL child on every scope exit.
        _ :: self.child.kill()
        _ :: self.child.wait()
    }
}

// Rust: tests/dev_parts/routine.rs:188,265,574,752,813,865,1409,1564,1815
// Retired JIT/interpreter routing is replaced by explicit retained native profiles.
pub fn native_profile_output(file: &String, profile: &String) -> ProgramOutput {
    output :: command_output_with_timeout(Command.new(common.jet_bin()).args(["run", "--profile={profile}", file]).env("NO_COLOR", "1"), DEV_DIFF_TIMEOUT, "native {profile}: {file}")
    ProgramOutput.ran(String.from_utf8_lossy(&output.stdout).into_owned(), String.from_utf8_lossy(&output.stderr).into_owned(), output.status.code().unwrap_or(1))
}

// Rust: tests/dev_parts/routine.rs:28,38,64,1177,1217,1257,1300,1356,1473,1614,1625
pub fn assert_native_profiles(file: &String, expected: &ProgramOutput) -> {
    loop profile in ["debug", "dev", "release"] {
        assert_eq(native_profile_output(file, profile), expected, "{profile} output differs: {file}")
    }
}
