//RS /// c139 M2: type-stable hot_swap re-links in the resident JIT and preserves
//RS /// live runtime state; restart tears it down.
//RS #[test]
//RS fn cranelift_hot_swap_preserves_live_state() {
//RS     // One session, one thread. The resident module, the live heap and the
//RS     // `#Persist` store are scoped to the thread, not to the call or to the
//RS     // backend value (D-HOTSWAP1 / D-PERSIST1) -- `backend2` below re-links the
//RS     // very session `backend` started. So the sized stack goes around the whole
//RS     // session; `CraneliftBackend::run`'s own boundary then runs inline.
