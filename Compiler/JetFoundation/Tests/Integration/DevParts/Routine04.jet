//RS /// #1760: the two serde stems stay green — and each pin claims only what a
//RS /// ledger can actually prove about that stem.
//RS ///
//RS /// The old run-tier pin demanded `resident_jit:` for BOTH stems. That was true
//RS /// the day it was written (`af3201409`) and is not true now, and neither half of
//RS /// the change was a regression this test could have caught:
//RS ///
//RS /// * `d1aaf936e` rewrote error handling across 39 net and serde examples one day
//RS ///   AFTER the gate last moved, so the `resident_jit:` rows for those stems were
//RS ///   never re-observed. `f7aab7bf8` re-derived the ledger from an observed run
//RS ///   (374 -> 496 rows, 122 stems previously in no section at all) and recorded
//RS ///   what the tiers actually do: `serde/encoding_breadth` is `frontend_rejected:`
//RS ///   on the E2402 error-conversion family, and `serde/serde_generic` is an
//RS ///   `deopt_interp:` row.
//RS /// * Nothing ran this test in between. `dev` belonged to no named target set
//RS ///   until `tests/suites.txt` landed, so the pin went stale silently — the same
//RS ///   shape as the `compile_covered` claim described below.
//RS ///
//RS /// So the pin is re-stated against the OBSERVED classification, and only in the
//RS /// directions the gate's own ratchet allows. `run_tier_broken:` and
//RS /// `tier_divergent:` are shrink-only and both are currently EMPTY, so "neither
//RS /// stem may be a refusal or a divergence" can only ever get easier to satisfy —
//RS /// it is a real parity claim, not a restatement of today's row. A bare
//RS /// `deopt_interp:` row is a TIER CHOICE; the gate treats a detail-carrying one as
//RS /// FAILING, so the empty-detail pin below is the
//RS /// assertion that actually catches a `serde/serde_generic` regression, and it is
//RS /// stricter than the class pin it replaces.
//RS ///
//RS /// Compile coverage is owned by `jit_coverage_audit`; this test only pins the
//RS /// two serde rows' observed run-tier classification.
//RS #[test]
//RS fn serde_jit_parity_manifest_pins() {
//RS     let gate = parse_corpus_gate_manifest();
//RS     for stem in ["serde/encoding_breadth", "serde/serde_generic"] {
//RS         // Accounted for exactly once. A ghost row, a duplicate, or a stem that
//RS         // dropped out of the file entirely would otherwise make every claim
//RS         // below vacuously true.
//RS         let rows: Vec<_> = gate.iter().filter(|record| record.stem == stem).collect();
//RS         assert_eq!(
//RS             rows.len(),
//RS             1,
//RS             "{stem} must carry exactly one corpus-gate row, found {}",
//RS             rows.len()
//RS         );
//RS         let record = rows[0];
//RS         // The parity claim, on the two sections that mean a tier disagreed.
//RS         assert!(
//RS             !matches!(
//RS                 record.class,
//RS                 CorpusGateClass::RunTierBroken | CorpusGateClass::TierDivergent
//RS             ),
//RS             "{stem} became a run-tier refusal or a tier divergence: {:?} {}",
//RS             record.class,
//RS             record.detail
//RS         );
//RS         // A tier choice carries no diagnostic; a failure does.
//RS         if record.class == CorpusGateClass::DeoptInterp {
//RS             assert!(
//RS                 record.detail.is_empty(),
//RS                 "{stem} deopts to the interpreter CARRYING a diagnostic: {}",
//RS                 record.detail
//RS             );
//RS         }
//RS         // #2018: E2402 is repaired — the core-error family ships one
//RS         // `impl <CoreError> => Err` on the D-FAIL-CONV2=A rail — so this branch
//RS         // retires exactly as its previous note said it would. It used to ALLOW a
//RS         // `frontend_rejected:` row for this stem as long as the reason was the
//RS         // known E2402 error-conversion gap. There is no longer a known reason to
//RS         // allow, so the allowance becomes the flat law: a shipped example that
//RS         // the front end rejects is a defect, and naming it here is stronger than
//RS         // the conditional it replaces.
//RS         assert!(
//RS             record.class != CorpusGateClass::FrontendRejected,
//RS             "{stem} is frontend-rejected: {}. The E2402 error-conversion gap that \
//RS              once excused this row is fixed (D-FAIL-CONV2=A), so a rejection here \
//RS              is a live defect, not the known one",
//RS             record.detail
//RS         );
//RS     }
//RS }
