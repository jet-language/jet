//RS /// The three plain parameter modes across a call boundary: `read` (by value),
//RS /// `&` (write-back), and `^` (take).
//RS ///
//RS /// This was an `assert_cranelift_deopts_on_gap` case from the era when the
//RS /// resident tier had no user-call write-back at all. It has one now — the
//RS /// interpreter-side boundary right below this test only stays honest because
//RS /// resolved user calls DO carry write-back — so the tier compiles this whole
//RS /// body natively and correctly declines to deopt. The assertion follows the
//RS /// coverage.
//RS ///
//RS /// The tier assertions are the point, not decoration (the `float_lists`
//RS /// lesson): a re-opened write-back gap is silent, because the deopt still
//RS /// prints the right answer. `jit_executed_for_test` proves the resident engine
//RS /// ran it, the deopt/fallback pair proves no arm went back to the interpreter,
//RS /// and the helper compares stdout against the pure-interpreter baseline, so a
//RS /// write-back that lands in the wrong slot fails too.
//RS #[test]
//RS fn cranelift_matches_plain_parameter_read_write_and_take_modes() {
//RS     if skip_if_cranelift_host_unsupported() {
//RS         return;
//RS     }
//RS     // The interpreter baseline inside the helper runs on `InterpreterBackend`,
//RS     // which never touches these thread-local flags, so resetting here is safe.
//RS     jet_jit::reset_jit_trace_for_test();
//RS     assert_cranelift_matches_interpreter(
//RS         "fn read(text: String) { print(text) }\nfn edit(values: &[Int]) { values[0] = 9 }\nfn consume(text: ^String) { print(text) }\nfn run() {\n    text :: \"hello\"\n    values := [1, 2]\n    read(text)\n    edit(&values)\n    print(values[0])\n    consume(^text)\n}\n",
//RS         "plain_parameter_modes",
//RS     );
//RS     assert!(
//RS         jet_jit::jit_executed_for_test(),
//RS         "plain_parameter_modes must reach the resident Cranelift tier"
//RS     );
//RS     assert!(
//RS         !jet_jit::deopt_invoked_for_test() && !jet_jit::fallback_invoked_for_test(),
//RS         "plain_parameter_modes must stay native: a deopt here means read/&/^ \
//RS          parameter passing left the resident tier"
//RS     );
//RS }
//RS 
//RS 
//RS /// A fixed `&` write-back parameter beside a variadic pack, read inside the
//RS /// callee (`extras.len()`).
//RS ///
//RS /// Same stale premise as `cranelift_matches_plain_parameter_read_write_and_take_modes`
//RS /// above: this was an `assert_cranelift_deopts_on_gap` case from the era with
//RS /// no resident user-call write-back, and the tier now compiles the whole body
//RS /// natively, so it correctly declines to deopt. Native execution plus stdout
//RS /// equality against the pure interpreter is strictly stronger than the old
//RS /// deopt check, which never compared output at all: it catches both a
//RS /// re-opened gap and a variadic count that arrives wrong in the callee.
//RS #[test]
//RS fn cranelift_matches_variadic_fixed_writeback() {
//RS     if skip_if_cranelift_host_unsupported() {
//RS         return;
//RS     }
//RS     jet_jit::reset_jit_trace_for_test();
//RS     assert_cranelift_matches_interpreter(
//RS         "fn edit(values: &[Int], extras: ...Int) { values[0] = extras.len() }\nfn run() {\n    values := [0]\n    edit(&values, 7, 8)\n    print(values[0])\n}\n",
//RS         "variadic_fixed_writeback",
//RS     );
//RS     assert!(
//RS         jet_jit::jit_executed_for_test(),
//RS         "variadic_fixed_writeback must reach the resident Cranelift tier"
//RS     );
//RS     assert!(
//RS         !jet_jit::deopt_invoked_for_test() && !jet_jit::fallback_invoked_for_test(),
//RS         "variadic_fixed_writeback must stay native: a deopt here means variadic \
//RS          calls with a write-back parameter left the resident tier"
//RS     );
//RS }
