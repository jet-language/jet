use std.[fs, env, process]
use jet_foundation.Tests.Integration.Common as common
use jet_foundation.Tests.Integration.TirSupport as tir_support
use jet_foundation.Tests.Integration.DevParts.Support.[example_path, golden_program_output]
// GATE #4494: actual filesystem/process fixture providers.
// Rust: tests/dev_parts/routine.rs:6669
fn emitted_body(rust: String, name: String) -> StringView {
    start :: rust.find("{name}(__jet_").unwrap_or_else(fn() { panic("`{name}` was not emitted:\n{rust}") })
    rest := rust[start..] // #4303
    rest[..rest.find("\n}}\n").expect("emitted function has a closing brace")]
}
// Rust: tests/dev_parts/routine.rs:6677
fn emitted_rust(file: String, src: String) -> String {
    dir :: env.temp_dir().join("jet_{file}_{process.id()}")
    fs.create_dir_all(&dir).unwrap()
    path :: dir.join("{file}.jet")
    fs.write(&path, src).unwrap()
    shown :: path.to_string_lossy().to_string()
    rust :: jet.compile_with_path(src, &shown).unwrap_or_else(fn(diags) { panic("front end rejected fixture:\n{jet.render_diagnostics(&shown, src, &diags)}") }).rust
    _ :: fs.remove_dir_all(&dir)
    rust
}
// Retired resident-JIT representation checks use the retained native O0/O1/O2
// and eligible Web behavioral harness, not legacy engine traces or Rust callbacks.
