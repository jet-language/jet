//RS /// c125 Phase 2 / #1995: Float list values use the shared JetArena list path.
//RS ///
//RS /// This was an `assert_cranelift_deopts_on_gap` case for as long as `xs[1..2]`
//RS /// on a `[Float]` reached the int-only `jet_jit_list_slice`, which cloned
//RS /// through `clone_int_list` and `.expect`ed inside its own `extern "C"` frame
//RS /// — aborting the process. 9623985d0 made the window element-kind preserving,
//RS /// which CLOSED that gap: the tier now compiles this whole body natively, so
//RS /// it correctly declines to deopt. The assertion follows the coverage.
//RS ///
//RS /// The tier assertions are the point, not decoration. This defect class is
//RS /// silent — Cranelift declines a function, the tier deopts, and the program
//RS /// still prints the right answer — so an output-only check would pass again
//RS /// the moment the gap re-opened. `jit_executed_for_test` proves the resident
//RS /// engine ran it, and the deopt/fallback pair proves no arm of it went back
//RS /// to the interpreter.
//RS #[test]
//RS fn cranelift_covers_float_lists() {
//RS     if skip_if_cranelift_host_unsupported() {
//RS         return;
//RS     }
//RS     // The interpreter baseline inside the helper runs on `InterpreterBackend`,
//RS     // which never touches these thread-local flags, so resetting here is safe.
//RS     jet_jit::reset_jit_trace_for_test();
//RS     assert_cranelift_matches_interpreter(
//RS         "fn run() {\n    xs := [Float]{ 1.5, 2.5 }\n    xs.push(3.5)\n    print(xs.len())\n    print(xs[0])\n    xs[1] = 4.5\n    print(xs[1])\n    mid :: xs[1..2]\n    print(mid[0])\n}\n",
//RS         "float_lists",
//RS     );
//RS     assert!(
//RS         jet_jit::jit_executed_for_test(),
//RS         "float_lists must reach the resident Cranelift tier"
//RS     );
//RS     assert!(
//RS         !jet_jit::deopt_invoked_for_test() && !jet_jit::fallback_invoked_for_test(),
//RS         "float_lists must stay native: a deopt here means the float list gap re-opened"
//RS     );
//RS }
