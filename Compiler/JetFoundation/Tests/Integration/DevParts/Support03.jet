//RS 
//RS fn corpus_gate_interpreter_refusal_detail<'a>(codes: impl IntoIterator<Item = &'a str>) -> String {
//RS     format!("interpreter_refused: {}", corpus_gate_unique_codes(codes))
//RS }
//RS 
//RS /// R13 (#1997): an abort is never an outcome, so it is never a ledger row
//RS /// either.
//RS ///
//RS /// Every other classification below records a real observable — a diagnostic, an
//RS /// exit code, a diverging stream. An abort records none of those: the process
//RS /// died before the report boundary could run, and the exit code it leaves behind
//RS /// describes the corpse rather than the program. Filing one is worse than
//RS /// missing it, because every ratcheted section here is shrink-only, so the row
//RS /// then *protects* the abort from ever failing this suite again.
//RS ///
//RS /// That is not hypothetical. `streams/generators` cancelled a generator at a
//RS /// wait point inside drop glue, raised a second time, and died with `panic in a
//RS /// destructor during cleanup`; the classifier saw only `exit_code != 0` and
//RS /// filed the benign-looking `aot_broken` row `AOT exit 1`. So the check lives
//RS /// where the bytes are first seen, on every tier, rather than in the manifest
//RS /// where the abort has already been turned into a number.
//RS fn corpus_gate_refuse_abort(stem: &str, tier: &str, out: &ProgramOutput) {
//RS     if let Some(marker) = common::abort_marker(&out.stderr) {
//RS         panic!(
//RS             "`{stem}`: the {tier} run carries the abort marker `{marker}`, so a Rust \
//RS              control transfer killed the process instead of becoming a report. An \
//RS              abort is never an outcome and never a gate row either — fix the \
//RS              boundary, do not file the stem (Docs/spec/architecture.md R13, \
//RS              crates/jet-jit/src/host_seam.rs).\nexit: {}\nstdout:\n{}\nstderr:\n{}",
//RS             out.exit_code, out.stdout, out.stderr
//RS         );
//RS     }
//RS }
//RS 
//RS /// Which observable stream(s) diverged, as stable tokens.
//RS ///
//RS /// The old detail for a divergence was the single word `parity`, which named the
//RS /// CHECK rather than the finding: a stem could sit in `run_tier_broken` reading
//RS /// `parity` while the default run had exited 0 with correct-looking output. These
//RS /// tokens are the finding, and they stay free of program text so a divergence
//RS /// cannot thrash the ledger with its own payload.
//RS fn corpus_gate_divergent_streams(jit: &ProgramOutput, aot: &ProgramOutput) -> String {
//RS     let mut streams = Vec::new();
//RS     if jit.stdout != aot.stdout {
//RS         streams.push("stdout");
//RS     }
//RS     if jit.stderr != aot.stderr {
//RS         streams.push("stderr");
//RS     }
//RS     if jit.exit_code != aot.exit_code {
//RS         streams.push("exit");
//RS     }
//RS     streams.join("+")
//RS }
//RS 
//RS #[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord)]
//RS enum CorpusGateClass {
//RS     FrontendRejected,
//RS     GateExcluded,
//RS     NonRunnable,
//RS     /// The HOST has no rustc, so no AOT oracle could be built for ANY stem. This
//RS     /// states a fact about the machine, never about the program: membership is
//RS     /// all-or-nothing and flips when a toolchain is installed. That is exactly
//RS     /// why it is neither `expected_exit` nor `aot_broken` — a shrink-only
//RS     /// ratchet over a set the host decides cannot be held honestly, and a stem
//RS     /// whose oracle was never built is no evidence that anything is broken or
//RS     /// repaired (#2016). Detail names the missing tool.
//RS     OracleUnavailable,
//RS     /// The GOLDEN expects a non-zero exit (an `.err` golden is present), so the
//RS     /// stem has no exit-0 oracle to differentiate against. Exactly ONE fact.
//RS     ///
//RS     /// It used to carry four: this one, `rustc unavailable`, `AOT compile or run
//RS     /// failed`, and `AOT exit N`. A broken oracle therefore sat in a
//RS     /// benign-sounding section and was dropped from the differential entirely,
//RS     /// so a cross-tier divergence in any of those stems was permanently
//RS     /// unobservable — the same shape as the `parity` rows that hid in
//RS     /// `run_tier_broken` (#2016).
//RS     ExpectedExit,
//RS     /// The AOT ORACLE ITSELF is broken: the optimized AOT build failed, or the
//RS     /// binary it produced exited non-zero for a stem whose golden expects exit
//RS     /// 0. No tier comparison runs for such a stem, so this is a HOLE in the
//RS     /// differential, not an outcome the gate accepts. Shrink-only against
//RS     /// `AOT_BROKEN_HELD_OUT`.
//RS     ///
//RS     /// A build failure here is also where an I2 violation surfaces: rustc
//RS     /// rejecting GENERATED code is an internal compiler error, never a
//RS     /// user-facing outcome. Detail is `AOT compile or run failed` or `AOT exit
//RS     /// N`.
//RS     AotBroken,
//RS     ResidentJit,
//RS     DeoptInterp,
//RS     /// AOT-green (oracle exit 0) but the default tiered run REFUSES to run the
//RS     /// program: sema rejects it on the run path, or the tiered backend answers
//RS     /// `Problems`. Shrink-only burndown (D-VERDICT-1254-1 / D-LENS-RUN1). Detail
//RS     /// is diagnostic codes only — a record with any other detail is not this
//RS     /// class, which is how `parity` rows hid eight non-refusals here.
//RS     RunTierBroken,
//RS     /// AOT-green and the default tiered run ALSO ran to completion, but their
//RS     /// normalized stdout/stderr/exit differ. That is a tier-semantics divergence,
//RS     /// not a run-tier refusal: the program runs under `jet run` and prints the
//RS     /// wrong thing (or the oracle does). Kept separate because `run_tier_broken`
//RS     /// asserts "fails under default `jet run`", and a stem that ran did not fail
//RS     /// (D-ONECORE1=A, the same law `jit_coverage_audit` states).
//RS     /// Detail names the diverging stream(s): `stdout`, `stderr`, `exit`.
//RS     TierDivergent,
//RS }
//RS 
//RS /// The stems whose default `jet run` is KNOWN to refuse an AOT-green program,
//RS /// with the codes it stops on and the card that owes the fix. Stem-sorted, and
//RS /// the gate compares its observed `run_tier_broken` class against this list
//RS /// EXACTLY — so a new refusal fails, and a repaired one fails until its row is
//RS /// deleted here.
//RS ///
//RS /// It lives in source, not in `tests/jit_corpus_gate.txt`: the ledger is
//RS /// regenerated from an observed run, so a row there cannot hold a law that
//RS /// regeneration is meant to be unable to silence (#2013).
//RS ///
//RS /// Empty since #2016: the one row here, `lowlevel/layout_columnar`, cannot be
//RS /// observed in this class at all while its AOT oracle is broken, because an
//RS /// exit-0 oracle is the precondition for reaching the run tier. The stem is
//RS /// held out in `AOT_BROKEN_HELD_OUT` instead, which names #1988 too, and the
//RS /// diff that repairs the AOT build moves the row back here — one section owns a
//RS /// stem, so the two lists never double-count it.
