//RS /// What the ledger accounts for, and what it does not (#2013).
//RS struct CorpusGateLedgerAudit {
//RS     /// Distinct stems the ledger names, each of which exists on disk.
//RS     classified: usize,
//RS     /// Rows in `gate_excluded:` — the same ceiling the live observation applies.
