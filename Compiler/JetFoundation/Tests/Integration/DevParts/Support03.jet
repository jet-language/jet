//RS /// Unique diagnostic codes in encounter order — run_tier_broken records codes only
//RS /// so concurrent E0956 wording churn does not thrash the manifest.
//RS fn corpus_gate_unique_codes<'a>(codes: impl IntoIterator<Item = &'a str>) -> String {
