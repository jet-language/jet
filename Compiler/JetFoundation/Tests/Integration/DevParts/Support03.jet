//RS /// How many stems `tests/jit_corpus_gate.txt` must classify (#2013).
//RS ///
//RS /// A floor: rows may only GROW. The file states its own invariant — "Every
//RS /// top-level Examples/features/<topic>/*.jet appears in exactly one section" —
//RS /// and until #2013 nothing outside the expensive gate checked it. On 2026-08-16
//RS /// the file held 374 rows against a 496-stem corpus: 122 stems had no row in ANY
//RS /// section, `tooling/data_plot` among them, while open cards cited its
//RS /// `resident_jit:` rows as current evidence about which tier runs a stem.
//RS ///
//RS /// This lives here, outside the file it guards, for the same reason
//RS /// its row floor does: a hand-edit cannot green the ledger by deleting
//RS /// the row that fails. A row that LEAVES is either a deleted example — lower this
//RS /// in the same diff as the deletion — or the defect this pins.
//RS const CORPUS_GATE_ROW_FLOOR: usize = 496;
//RS 
//RS /// How many examples the gate ledger is still allowed to say nothing about (#2013).
//RS ///
//RS /// Shrink-only, exactly like `OUT_OF_UNIVERSE_CEILING` and for the same reason:
//RS /// every stem counted here is a stem no section names, so no reader can tell
//RS /// whether it runs resident, deopts, or fails. The count is DERIVED from the
//RS /// corpus walk on every run and never an allowlist, so a new example without a
//RS /// row raises it and fails. Burn it down with a regeneration run; raising it is
//RS /// not a fix.
//RS const CORPUS_GATE_UNCLASSIFIED_CEILING: usize = 0;
//RS 
//RS /// How many stems the corpus gate may exclude outright (#2016 / #1998 / #2013).
//RS ///
//RS /// One constant for two readers: `collect_corpus_gate_records` applies it to the
//RS /// live classification, `assert_corpus_gate_manifest_covers_corpus` applies it to
//RS /// the checked-in ledger. Exclusions may only SHRINK.
//RS const CORPUS_GATE_EXCLUDED_CEILING: usize = 12;
//RS 
//RS /// The gate ledger's own stated invariant, asserted without an observed run (#2013).
//RS ///
//RS /// The gate that owns `tests/jit_corpus_gate.txt` needs a Cranelift host and an
//RS /// AOT build per stem, and it returns green early where the host is unsupported,
//RS /// so the completeness of that file was only ever checked behind ~500
//RS /// classifications. This check reads the ledger and walks
//RS /// `Examples/features/<topic>/`, nothing more, so a stem that falls out of every
//RS /// section fails on any host in milliseconds.
//RS ///
//RS /// State the polarity plainly, because both directions are bugs:
//RS ///
//RS /// - `CORPUS_GATE_ROW_FLOOR` may only grow — a vanished row is a stem that left
//RS ///   the ledger.
//RS /// - `CORPUS_GATE_UNCLASSIFIED_CEILING` may only shrink — a stem with no row is
//RS ///   a claim nobody made.
//RS ///
//RS /// Nothing here decides which section a stem belongs in. This check cannot and
//RS /// must not classify: a classification needs an observed run, and the rows this
//RS /// an earlier hand ledger was falsified three times by exactly the hand-edit
//RS /// that guessing here would invite. Regenerate the rows
//RS /// from an observation:
//RS ///
//RS /// ```text
//RS /// JET_CORPUS_GATE_REPORT_DIR=jit-aot-parity-report JET_WRITE_CORPUS_GATE=1 \
//RS ///   bash Tools/ci/jit-aot-parity.sh
//RS /// ```
//RS fn assert_corpus_gate_manifest_covers_corpus() {
//RS     let manifest = parse_corpus_gate_manifest();
//RS     let corpus = all_example_stems();
//RS     let audit = audit_corpus_gate_ledger(&manifest, &corpus);
//RS 
//RS     // Printed on every run, pass or fail, for the same reason `jit_coverage_audit`
//RS     // prints its unjudged stems: the denominator is stated, never implied.
//RS     eprintln!(
//RS         "corpus gate ledger: {} of {} stem(s) classified; {} stem(s) in no section:",
//RS         audit.classified,
//RS         corpus.len(),
//RS         audit.unclassified.len()
//RS     );
//RS     for stem in &audit.unclassified {
//RS         eprintln!("  {stem}");
//RS     }
//RS 
//RS     // Named apart, and named first: the gate's blob compare reports the first
//RS     // diverging record, so a row naming a file that does not exist reads exactly
//RS     // like a classification that changed. That is how the nonexistent stem
//RS     // `tooling/data_line` held a battery down for ten days.
//RS     assert!(
//RS         audit.ghosts.is_empty(),
//RS         "tests/jit_corpus_gate.txt names {} stem(s) with no \
//RS          Examples/features/<topic>/<name>.jet file: {:?}. A nonexistent stem is a stale row to \
//RS          delete, never a classification that failed.",
//RS         audit.ghosts.len(),
//RS         audit.ghosts
//RS     );
//RS     assert!(
//RS         audit.duplicated.is_empty(),
//RS         "{} stem(s) appear in more than one section of tests/jit_corpus_gate.txt, breaking that \
//RS          file's own invariant that every top-level example appears in exactly one:\n{}",
//RS         audit.duplicated.len(),
//RS         audit.duplicated.join("\n")
//RS     );
//RS 
//RS     // #2016 + #1998 rule applied to the ledger, not only to the live
//RS     // observation: a stem held out of the run tier carries a named reason AND is
//RS     // counted. `classify_corpus_stem` never emits one of those classes with an
//RS     // empty detail, so a bare stem in one of those sections is a hand-edit.
//RS     assert!(
//RS         audit.reasonless.is_empty(),
//RS         "{} row(s) in tests/jit_corpus_gate.txt hold a stem out of the run tier without saying \
//RS          why:\n{}\nA stem held out states its reason, or it is not held out — it is hidden.",
//RS         audit.reasonless.len(),
//RS         audit.reasonless.join("\n")
//RS     );
//RS 
//RS     // The pin is an identity against the corpus, not a bare row count. With no
//RS     // ghosts and no duplicates, classified + unclassified IS the corpus, so
//RS     // neither pin below can be satisfied by moving a stem out of the accounting.
//RS     assert_eq!(
//RS         audit.classified + audit.unclassified.len(),
//RS         corpus.len(),
//RS         "gate ledger accounting is broken: {} classified + {} unclassified != {} discovered \
//RS          stem(s). The pins below only mean something while this identity holds.",
//RS         audit.classified,
//RS         audit.unclassified.len(),
//RS         corpus.len()
//RS     );
//RS     assert!(
//RS         corpus.len() >= EXAMPLE_CORPUS_FLOOR,
//RS         "the example corpus shrank to {} stem(s) (floor {EXAMPLE_CORPUS_FLOOR}). A stem leaving \
//RS          `Examples/features/<topic>/` shrinks every claim this ledger makes: restore it, or \
//RS          lower the floor in the same diff as the deletion.",
//RS         corpus.len()
//RS     );
//RS     assert!(
//RS         audit.classified >= CORPUS_GATE_ROW_FLOOR,
//RS         "tests/jit_corpus_gate.txt classifies {} stem(s) but the ratchet floor is \
//RS          {CORPUS_GATE_ROW_FLOOR}; rows may only GROW. A stem that lost its row did not change \
//RS          class — it left the ledger, and every card citing this file then cites a silence. \
//RS          Regenerate from an observed run; lower the floor only in the same diff as a deleted \
//RS          example.",
//RS         audit.classified
//RS     );
//RS     assert!(
//RS         audit.unclassified.len() <= CORPUS_GATE_UNCLASSIFIED_CEILING,
//RS         "{} example(s) appear in NO section of tests/jit_corpus_gate.txt (ceiling \
//RS          {CORPUS_GATE_UNCLASSIFIED_CEILING}), breaking that file's own invariant that every \
//RS          top-level example appears in exactly one:\n  {}\nThis count may only FALL. Regenerate \
//RS          the manifest from an observed run; a missing row is not a class change, and guessing \
//RS          one by hand is how the sibling ledger was falsified three times.",
//RS         audit.unclassified.len(),
//RS         audit.unclassified.join("\n  ")
//RS     );
//RS     assert!(
//RS         !audit.unclassified.is_empty() || CORPUS_GATE_UNCLASSIFIED_CEILING == 0,
//RS         "every example now carries a row: set CORPUS_GATE_UNCLASSIFIED_CEILING to 0 in the same \
//RS          diff, so the hole cannot reopen unnoticed"
//RS     );
//RS     assert!(
//RS         audit.excluded <= CORPUS_GATE_EXCLUDED_CEILING,
//RS         "tests/jit_corpus_gate.txt excludes {} stem(s) but the ceiling is \
//RS          {CORPUS_GATE_EXCLUDED_CEILING}; exclusions may only SHRINK. Drive the stem instead of \
//RS          excluding it, or lower the ceiling in the same reviewed diff",
//RS         audit.excluded
//RS     );
//RS }
