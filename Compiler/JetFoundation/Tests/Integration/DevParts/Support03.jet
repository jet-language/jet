// Rust: tests/dev_parts/support.rs:3657
fn assert_resident_clif_shape(tag: String, source: String, require_funcs: [String], expected_stdout: String) -> {
    dir :: env.temp_dir().join("jet_clif_shape_{tag}_{process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).unwrap()
    file :: dir.join("{tag}.jet")
    fs.write(file, source).unwrap()
    // CLIF symbols/verifier/residency were retired representation assertions.
    // Their replacement witnesses the fixture's observable result on every retained tier.
    // require_funcs retains the original fixture-site context for diagnostics.
    // GATE #4494: canonical native tier execution; never a Rust JIT callback.
    loop tier in ["O0", "O1", "O2", "Web"] {
        if common.run_entry_tier(file, tier, false) == {
            .Ran(exit_code, stdout, stderr) -> {
                assert_eq(stdout, expected_stdout, "`{tag}` {tier} output drifted at {require_funcs:?} (stderr: {stderr:?})")
                assert_eq(exit_code, 0, "`{tag}` {tier} exited {exit_code} (stderr: {stderr:?})")
            }
            else -> panic("`{tag}` {tier} did not execute fixture sites {require_funcs:?}")
        }
    }
    _ :: fs.remove_dir_all(dir)
}

// Rust: tests/dev_parts/support.rs:3721
// Report the measured universe alongside every gap count (#1998).
fn report_jit_universe(corpus: USize, covered: [String], gaps: [String], out_of_universe: [String]) -> {
    eprintln("jit compile-coverage universe: {corpus} example stem(s) = {covered.len()} compile-covered + {gaps.len()} compile gap(s) + {out_of_universe.len()} outside this oracle")
    if out_of_universe.is_empty() {
        eprintln("jit stems outside this oracle: none — the audit judged the whole corpus")
        return
    }
    eprintln("jit stems outside this oracle ({out_of_universe.len()}): the {gaps.len()} gap row(s) are scoped to the {covered.len() + gaps.len()} stem(s) this oracle could judge, NOT to the {corpus}-stem corpus (#1998)")
    loop row in out_of_universe { eprintln("  {row}") }
}

// Rust: tests/dev_parts/support.rs:3750
fn jit_coverage_audit_inner() -> {
    coverage :: collect_jit_coverage()
    corpus :: coverage.corpus
    covered :: coverage.covered
    gaps :: coverage.gaps
    out_of_universe :: coverage.out_of_universe
    run_gaps :: corpus_gate_run_gaps(parse_corpus_gate_manifest())
    eprintln("jit coverage: gaps: {gaps.len()}, run_gaps: {run_gaps.len()}")
    report_jit_universe(corpus, covered, gaps, out_of_universe)
    eprintln("jit compile-covered ({covered.len()}):")
    loop s in covered { eprintln("  {s}") }
    eprintln("jit gaps ({gaps.len()} of {covered.len() + gaps.len()} stem(s) judged; {out_of_universe.len()} stem(s) unjudged):")
    loop g in gaps { eprintln("  {g}") }
    print_jit_op_report()
    assert(corpus >= EXAMPLE_CORPUS_FLOOR, "the example corpus shrank to {corpus} stem(s) (floor {EXAMPLE_CORPUS_FLOOR}). A stem leaving `Examples/features/<topic>/` shrinks every claim this audit makes: restore it, or lower the floor in the same diff as the deletion.")
    assert(out_of_universe.len() <= OUT_OF_UNIVERSE_CEILING, "{out_of_universe.len()} stem(s) sit outside the compile oracle (ceiling {OUT_OF_UNIVERSE_CEILING}); this count may only fall:\n{out_of_universe.join("\n")}")
    assert(!out_of_universe.is_empty() || OUT_OF_UNIVERSE_CEILING == 0, "the oracle now judges the whole corpus: set OUT_OF_UNIVERSE_CEILING to 0 in the same diff, so the universe hole cannot reopen unnoticed")
    assert(gaps.is_empty(), "JIT compile coverage has {gaps.len()} gap(s); fix the lowering path before changing the corpus claim:\n{gaps.join("\n")}")
    assert(run_gaps.is_empty(), "JIT run-tier parity has {run_gaps.len()} gap(s); fix the shared semantics:\n{run_gaps.join("\n")}")
}

// Rust: tests/dev_parts/support.rs:3823
fn cranelift_three_way_differential_battery_inner() -> {
    _guard :: lock_recovered(dev_diff_lock(), "dev_diff_lock")
    if skip_if_cranelift_host_unsupported() { return }
    have_compiler :: have_rustc()
    if !have_compiler {
        eprintln("note: rustc not found; skipping three-way JIT differential battery")
        return
    }
    if env.var("JET_THREE_WAY_STEM") == {
        .Ok(stem) -> {
            assert_cranelift_three_way(example_path(stem), stem)
            eprintln("three-way battery: focused stem `{stem}` ok — this run is scoped to that ONE stem and is NOT the battery")
            return
        }
        .Err(_) -> {}
    }
    root :: OSPath.from(env.CARGO_MANIFEST_DIR)
    coverage :: collect_jit_coverage()
    corpus :: coverage.corpus
    covered :: coverage.covered
    resident_safe :: coverage.resident_safe
    resident_refused :: coverage.resident_refused
    gaps :: coverage.gaps
    out_of_universe :: coverage.out_of_universe
    report_jit_universe(corpus, covered, gaps, out_of_universe)
    assert(corpus >= EXAMPLE_CORPUS_FLOOR, "the example corpus shrank to {corpus} stem(s) (floor {EXAMPLE_CORPUS_FLOOR}); this battery is scoped to a subset of it, so a smaller corpus silently shrinks the battery")
    assert(out_of_universe.len() <= OUT_OF_UNIVERSE_CEILING, "{out_of_universe.len()} stem(s) sit outside the compile oracle (ceiling {OUT_OF_UNIVERSE_CEILING}), so this battery never judged them; the count may only fall:\n{out_of_universe.join("\n")}")
    assert(resident_safe.len() >= RESIDENT_SAFE_FLOOR, "the resident-safe universe shrank to {resident_safe.len()} stem(s) of {covered.len()} compile-covered (floor {RESIDENT_SAFE_FLOOR}). A stem leaving the resident gate leaves this battery: fix the gate or the lowering it refuses, and only lower the floor in a reviewed diff. Refused now:\n{resident_refused.join("\n")}")
    eprintln("three-way battery scope: {resident_safe.len()} resident-safe stem(s) of {covered.len()} compile-covered in a {corpus}-stem corpus; {resident_refused.len()} compile-covered stem(s) refused by the resident gate, {gaps.len()} compile gap(s) and {out_of_universe.len()} stem(s) outside the compile oracle are NOT tested here")
    to_run := [String]{}
    no_golden := [String]{}
    held_back := [String]{}
    loop stem in resident_safe {
        if !root.join("Examples/features/expected/{stem}.out").exists() {
            no_golden.push(stem.clone())
            continue
        }
        file :: example_path(stem)
        if Loader.load_entry(file) == {
            .Ok(bundle) -> {
                b := ^bundle
                _ :: Sema.check_bundle(&b, Sema.CompileMode.Run)
                if AST.bundle_serves_until_stopped(b) {
                    held_back.push("{stem}: service entry serves until stopped")
                    continue
                }
            }
            .Err(_) -> {}
        }
        if stem == "web/app_hello" {
            held_back.push("{stem}: AOT TIR gate miss on unused web helpers")
            continue
        }
        to_run.push(stem.clone())
    }
    ran :: run_three_way_battery_parallel(^to_run)
    assert_eq(ran + no_golden.len() + held_back.len(), resident_safe.len(), "the three-way battery lost a stem: {resident_safe.len()} resident-safe, {ran} ran, {no_golden.len()} without a golden, {held_back.len()} held back. Every stem of the universe lands in exactly one bucket (#2012)")
    eprintln("three-way battery universe: {resident_safe.len()} resident-safe stem(s) of {covered.len()} compile-covered, out of a {corpus}-stem corpus = {ran} ran + {no_golden.len()} with no golden + {held_back.len()} held back at a named AOT gate. This battery says NOTHING about the {resident_refused.len()} compile-covered stem(s) the resident gate refuses, the {gaps.len()} compile gap(s), or the {out_of_universe.len()} stem(s) outside the compile oracle.")
    loop row in resident_refused { eprintln("  resident gate refused: {row}") }
    loop stem in no_golden { eprintln("  no golden: {stem}") }
    loop row in held_back { eprintln("  held back: {row}") }
    assert(ran >= THREE_WAY_RAN_FLOOR, "the three-way battery ran {ran} of its {resident_safe.len()} resident-safe stem(s) (floor {THREE_WAY_RAN_FLOOR}); it may only grow. A fallen count means goldens or resident-safe stems left the battery: restore them, or lower the floor in the same reviewed diff.")
    report_oracle_cache_counts()
}

// Rust: tests/dev_parts/support.rs:4004
fn corpus_gate_exclusion(stem: String) -> String? {
    if stem == {
        "game/raylib_window" -> "interactive display required"
        "lowlevel/cross" -> "cross-target demo"
        "net/http_server" | "net/http_server_lifecycle" | "net/http_server_middleware" | "net/http_server_tasks" | "net/http_server_trailers" | "net/socket_echo" -> "network service"
        "ui/ui_native_linux" -> "native GTK shell"
        _ -> nil
    }
}
// Rust: tests/dev_parts/support.rs:4019
fn example_has_err_golden(stem: String) -> Bool {
    OSPath.from(env.CARGO_MANIFEST_DIR).join("Examples/features/expected/{stem}.err.out").is_file()
}
// Rust: tests/dev_parts/support.rs:4025
fn example_has_out_golden(stem: String) -> Bool {
    OSPath.from(env.CARGO_MANIFEST_DIR).join("Examples/features/expected/{stem}.out").is_file()
}
// Rust: tests/dev_parts/support.rs:4033
fn corpus_gate_unique_codes(codes: [String]) -> String {
    seen := [String:Bool]{}
    out := [String]{}
    loop code in codes {
        if !seen.contains_key(code) { seen[code] = true; out.push(code) }
    }
    out.join("; ")
}
// Rust: tests/dev_parts/support.rs:4044
fn corpus_gate_interpreter_refusal_detail(codes: [String]) -> String {
    "interpreter_refused: {corpus_gate_unique_codes(codes)}"
}
// Rust: tests/dev_parts/support.rs:4064
// An abort is never an outcome and cannot become a shrink-only ledger row (R13).
fn corpus_gate_refuse_abort(stem: String, tier: String, out: ProgramOutput) -> {
    if common.abort_marker(out.stderr) is marker {
        panic("`{stem}`: the {tier} run carries the abort marker `{marker}`, so a Rust control transfer killed the process instead of becoming a report. An abort is never an outcome and never a gate row either — fix the boundary, do not file the stem (Docs/spec/architecture.md R13, crates/jet-jit/src/host_seam.rs).\nexit: {out.exit_code}\nstdout:\n{out.stdout}\nstderr:\n{out.stderr}")
    }
}
// Rust: tests/dev_parts/support.rs:4084
fn corpus_gate_divergent_streams(jit_out: ProgramOutput, aot: ProgramOutput) -> String {
    streams := [String]{}
    if jit_out.stdout != aot.stdout { streams.push("stdout") }
    if jit_out.stderr != aot.stderr { streams.push("stderr") }
    if jit_out.exit_code != aot.exit_code { streams.push("exit") }
    streams.join("+")
}

// Rust: tests/dev_parts/support.rs:4099
#Derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord)
enum CorpusGateClass {
    FrontendRejected
    GateExcluded
    NonRunnable
    // Host fact, all-or-nothing: missing rustc is not a shrink-only program defect.
    OracleUnavailable
    // Only the golden's nonzero exit expectation, never an AOT failure.
    ExpectedExit
    // Broken AOT oracle: no comparison ran; shrink-only.
    AotBroken
    ResidentJit
    DeoptInterp
    // Default tier refuses an AOT-green program; detail is diagnostic codes only.
    RunTierBroken
    // Both tiers ran, but normalized stdout/stderr/exit disagree.
    TierDivergent
}
// Rust: tests/dev_parts/support.rs:4166
RUN_TIER_BROKEN_HELD_OUT :: [(String, String, String)]{}
// Rust: tests/dev_parts/support.rs:4177
AOT_BROKEN_HELD_OUT :: [
    ("devloop/schedule_every", "AOT compile or run failed", "#2016: the optimized AOT build or run of the example fails, so the gate has no oracle to compare the tiers against"),
    ("operators/spaceship", "AOT compile or run failed", "#2016: the optimized AOT build or run of the example fails, so the gate has no oracle to compare the tiers against"),
    ("reflection/reflect-value", "AOT exit 70", "#2016: the AOT binary exits 70 for a stem whose golden expects exit 0, so the oracle disagrees with the golden and cannot arbitrate the tiers"),
    ("serde/hand_codec", "AOT exit 1", "#2016: the AOT binary exits 1 for a stem whose golden expects exit 0, so the oracle disagrees with the golden and cannot arbitrate the tiers"),
    ("types/typed_literal_forms", "AOT compile or run failed", "#2016: the optimized AOT build or run of the example fails, so the gate has no oracle to compare the tiers against")
]
// Rust: tests/dev_parts/support.rs:4211
#Derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord)
struct CorpusGateRecord { stem: String, class: CorpusGateClass, detail: String }

// Rust: tests/dev_parts/support.rs:4217
fn classify_corpus_stem(stem: String, have_compiler: Bool) -> CorpusGateRecord {
    file :: example_path(stem)
    if corpus_gate_exclusion(stem) is reason {
        return CorpusGateRecord { stem: stem.to_string(), class: .GateExcluded, detail: reason.to_string() }
    }
    build_entry :: fs.read_to_string(file).ok().is_some_and((source) -> Driver.selects_build_entry(source, nil))
    bundle := if build_entry {
        if Driver.compile_bundle_path_build(file, Driver.BuildRunOptions.default()) == {
            .Ok(output) -> {
                if output.runtime is b { ^b } else {
                    return CorpusGateRecord { stem: stem.to_string(), class: .FrontendRejected, detail: "build front end returned no runtime bundle" }
                }
            }
            .Err(diags) -> {
                detail :: diags.first().map((d) -> "{d.code}: {d.what}").unwrap_or_else(() -> "build failed")
                return CorpusGateRecord { stem: stem.to_string(), class: .FrontendRejected, detail: detail }
            }
        }
    } else {
        if Loader.load_entry(file) == {
            .Ok(b) -> ^b
            .Err(diags) -> {
                detail :: diags.first().map((d) -> "{d.code}: {d.what}").unwrap_or_else(() -> "load failed")
                return CorpusGateRecord { stem: stem.to_string(), class: .FrontendRejected, detail: detail }
            }
        }
    }
    // Seed the same build-fact snapshot as jet run and the AOT oracle (I9).
    errors :: if build_entry { [Diagnostic]{} } else {
        if Driver.seed_build_facts(&bundle, "dev", false, [String:String]{}) == {
            .Err(diags) -> ^diags
            .Ok(()) -> Sema.check_bundle(&bundle, Sema.CompileMode.Run).into_iter().filter((d) -> d.severity == Severity.Error).collect()
        }
    }
    if !errors.is_empty() {
        detail :: errors.iter().map((d) -> "{d.code}: {d.what}").collect().join("; ")
        if have_compiler && example_has_out_golden(stem) && !example_has_err_golden(stem) {
            aot_dir :: aot_scratch_dir("corpus_gate", stem)
            if try_compiled_binary_output(aot_dir, "corpus_gate_aot", 0, stem, file) is aot {
                if aot.exit_code == 0 {
                    return CorpusGateRecord { stem: stem.to_string(), class: .RunTierBroken, detail: corpus_gate_unique_codes(errors.iter().map((d) -> d.code).collect()) }
                }
            }
        }
        return CorpusGateRecord { stem: stem.to_string(), class: .FrontendRejected, detail: detail }
    }
    if !have_compiler {
        return CorpusGateRecord { stem: stem.to_string(), class: .OracleUnavailable, detail: "rustc unavailable; oracle skipped" }
    }
    if AST.bundle_serves_until_stopped(bundle) {
        aot_dir :: aot_scratch_dir("corpus_gate_service", stem)
        assert(try_compiled_binary_build(aot_dir, "corpus_gate_service", 0, stem, file).is_some(), "`{stem}` is a service entry outside the gate's run universe, so its AOT compile is the only proof left: that compile failed")
        return CorpusGateRecord { stem: stem.to_string(), class: .GateExcluded, detail: "service entry serves until stopped" }
    }
    if example_has_err_golden(stem) {
        return CorpusGateRecord { stem: stem.to_string(), class: .ExpectedExit, detail: "golden expects non-zero exit" }
    }
    aot_dir :: aot_scratch_dir("corpus_gate", stem)
    aot :: try_compiled_binary_output(aot_dir, "corpus_gate_aot", 0, stem, file) ?? {
        return CorpusGateRecord { stem: stem.to_string(), class: .AotBroken, detail: "AOT compile or run failed" }
    }
    corpus_gate_refuse_abort(stem, "AOT oracle", aot)
    if aot.exit_code != 0 {
        return CorpusGateRecord { stem: stem.to_string(), class: .AotBroken, detail: "AOT exit {aot.exit_code}" }
    }
    policy :: common.development_policy()
    jit.reset_jit_trace_for_test()
    backend := CraneliftBackend.new()
    result :: jit.with_program_args([file.clone()], () -> common.run_cranelift_bundle(&backend, bundle, false, policy))
    assert(!jit.fallback_invoked_for_test(), "`{stem}` must not invoke forbidden interpreter/AOT fallback under tiered Cranelift")
    if result == {
        .Problems(diags) -> {
            assert(!diags.iter().any((diagnostic) -> diagnostic.code == "E2211"), "`{stem}` must not emit retired E2211: {diags:?}")
            CorpusGateRecord { stem: stem.to_string(), class: .RunTierBroken, detail: corpus_gate_unique_codes(diags.iter().map((d) -> d.code).collect()) }
        }
        .Ran { stdout, stderr, exit_code } -> {
            jit_raw :: ProgramOutput.ran(^stdout, ^stderr, exit_code)
            corpus_gate_refuse_abort(stem, "default `jet run`", jit_raw)
            jit_out :: normalize_for_parity(stem, ^jit_raw)
            aot_out :: normalize_for_parity(stem, ^aot)
            if jit_out != aot_out {
                return CorpusGateRecord { stem: stem.to_string(), class: .TierDivergent, detail: corpus_gate_divergent_streams(jit_out, aot_out) }
            }
            interpreter_detail :: if common.run_interpreter_checked_bundle(bundle, true, InterpreterInvocation.RunInterpret, policy) == {
                .Ran { stdout, stderr, exit_code } -> {
                    interp_raw :: ProgramOutput.ran(^stdout, ^stderr, exit_code)
                    corpus_gate_refuse_abort(stem, "forced interpreter", interp_raw)
                    interp_out :: normalize_for_parity(stem, ^interp_raw)
                    assert_eq(interp_out, aot_out, "`{stem}` pure-interpreter must match AOT stdout/stderr/exit")
                    ""
                }
                .Problems(diags) -> {
                    assert(diags.iter().any((d) -> d.code == "E0956"), "`{stem}` pure-interpreter failed without the canonical evaluator boundary: {diags:?}")
                    corpus_gate_interpreter_refusal_detail(diags.iter().map((d) -> d.code).collect())
                }
            }
            if jit.deopt_invoked_for_test() || !common.cranelift_resident_safe(bundle) {
                CorpusGateRecord { stem: stem.to_string(), class: .DeoptInterp, detail: interpreter_detail }
            } else {
                assert(jit.jit_executed_for_test(), "`{stem}` must execute resident Cranelift when AOT succeeds without deopt")
                CorpusGateRecord { stem: stem.to_string(), class: .ResidentJit, detail: interpreter_detail }
            }
        }
    }
}

// Rust: tests/dev_parts/support.rs:4492
fn collect_corpus_gate_records() -> [CorpusGateRecord] {
    common.assert_test_environment_is_safe()
    _ :: common.test_scratch_root("aot")
    have_compiler :: have_rustc()
    stems :: corpus_gate_selected_stems()
    // GATE #4494: native shared mutexes, worker stacks and unwind boundary.
    jobs :: Arc.new(Mutex.new(VecDeque.from(^stems)))
    records :: Arc.new(Mutex.new([CorpusGateRecord]{}))
    failures :: Arc.new(Mutex.new([String]{}))
    handles := []
    loop worker in 0..test_worker_count(8) {
        worker_jobs :: Arc.clone(jobs)
        worker_records :: Arc.clone(records)
        worker_failures :: Arc.clone(failures)
        handles.push(thread.Builder.new().name("corpus-gate-{worker}").stack_size(32 * 1024 * 1024).spawn(() -> {
            loop {
                stem :: lock_recovered(worker_jobs, "corpus gate work queue").pop_front() ?? { break }
                result :: catch_unwind(AssertUnwindSafe(() -> classify_corpus_stem(stem, have_compiler)))
                if result == {
                    .Ok(record) -> lock_recovered(worker_records, "corpus gate record set").push(^record)
                    .Err(payload) -> lock_recovered(worker_failures, "corpus gate failure report").push("{stem}: {panic_message(^payload)}")
                }
            }
        }).expect("corpus gate worker"))
    }
    loop handle in handles { handle.join().expect("corpus gate worker panicked") }
    judged_failures :: judged_report(failures, "corpus gate failure report")
    assert(judged_failures.is_empty(), "corpus gate classification failures:\n{judged_failures.join("\n")}")
    // Poison is incomplete classification, never permission to publish a partial corpus.
    judged := if records.lock() == {
        .Ok(locked) -> locked.clone()
        .Err(poisoned) -> panic("cascade, not a fresh defect: the corpus gate record set was poisoned — a worker unwound while holding it, so the classification is incomplete ({poisoned.into_inner().len()} stem(s) recorded) and no ledger cross-check may be judged against it; fix the first panic of the run")
    }
    judged.sort_by((left, right) -> left.stem.cmp(right.stem))
    excluded :: judged.iter().filter((record) -> record.class == CorpusGateClass.GateExcluded).count()
    assert(excluded <= CORPUS_GATE_EXCLUDED_CEILING, "the corpus gate excludes {excluded} stem(s) but the ceiling is {CORPUS_GATE_EXCLUDED_CEILING}; exclusions may only SHRINK. Drive the stem instead of excluding it, or lower the ceiling in the same reviewed diff")
    report_oracle_cache_counts()
    ^judged
}
// Rust: tests/dev_parts/support.rs:4582
fn corpus_gate_run_gaps(records: [CorpusGateRecord]) -> [String] {
    gaps := records.iter().filter((record) -> record.class == CorpusGateClass.RunTierBroken || record.class == CorpusGateClass.TierDivergent || (record.class == CorpusGateClass.DeoptInterp && !record.detail.is_empty() && !record.detail.starts_with("interpreter_refused: "))).map((record) -> {
        if record.detail.is_empty() { record.stem.clone() } else { "{record.stem}: {record.detail}" }
    }).collect()
    gaps.sort()
    ^gaps
}
// Rust: tests/dev_parts/support.rs:4605
fn corpus_gate_manifest_from_records(records: [CorpusGateRecord]) -> String {
    out := "# c727: differential example-corpus gate manifest.\n# Every top-level Examples/features/<topic>/*.jet appears in exactly one section.\n# Update only for intentional ratchet moves.\n# D-VERDICT-1254-1 / D-LENS-RUN1: run_tier_broken may only shrink — AOT-green\n# examples whose default jet run REFUSES to run. Record stem + diagnostic code only.\n# tier_divergent is the other half: it ran under both tiers and the observables\n# differ. Record stem + the diverging stream(s) only.\n# aot_broken may only shrink too (#2016): the AOT oracle failed to build or exited\n# non-zero, so NO tier comparison ran for the stem. expected_exit means one thing\n# and one thing only — the golden itself expects a non-zero exit. oracle_unavailable\n# is a HOST fact (no rustc), so it carries no ratchet and says nothing about a stem.\n# A resident_jit or deopt_interp row may carry interpreter_refused: CODE.\n# That row has no interpreter output comparison. A resident_jit or\n# deopt_interp row without that detail does.\n#\n# That invariant is enforced, not merely stated (#2013). CORPUS_GATE_ROW_FLOOR\n# and CORPUS_GATE_UNCLASSIFIED_CEILING in tests/dev_parts/support.rs pin how many\n# stems this file classifies and how many it still says nothing about; both live\n# outside this file so a hand-edit cannot green the check by deleting the row that\n# fails. Rows may only GROW, unclassified stems may only SHRINK, and\n# tests/dev_corpus_gate.rs::corpus_gate_manifest_accounts_for_every_example checks\n# both with no run at all.\n#\n# Never hand-write a classification: a row states an OBSERVED tier. Regenerate with\n#   JET_CORPUS_GATE_REPORT_DIR=jit-aot-parity-report JET_WRITE_CORPUS_GATE=1 \\\n#     bash Tools/ci/jit-aot-parity.sh\n\n"
    loop class in CORPUS_GATE_SECTION_ORDER {
        section :: corpus_gate_section_name(class)
        section_records := records.iter().filter((record) -> record.class == class).collect()
        section_records.sort_by((left, right) -> left.stem.cmp(right.stem))
        out.push_str(section)
        out.push_str(":\n")
        loop record in section_records {
            out.push_str("  ")
            out.push_str(record.stem)
            if !record.detail.is_empty() { out.push_str(": "); out.push_str(record.detail) }
            out.push('\n')
        }
        out.push('\n')
    }
    ^out
}
// Rust: tests/dev_parts/support.rs:4664
CORPUS_GATE_SECTION_ORDER :: [CorpusGateClass.FrontendRejected, CorpusGateClass.GateExcluded, CorpusGateClass.NonRunnable, CorpusGateClass.OracleUnavailable, CorpusGateClass.ExpectedExit, CorpusGateClass.AotBroken, CorpusGateClass.ResidentJit, CorpusGateClass.DeoptInterp, CorpusGateClass.RunTierBroken, CorpusGateClass.TierDivergent]
// Rust: tests/dev_parts/support.rs:4677
fn corpus_gate_section_name(class: CorpusGateClass) -> String {
    if class == {
        .FrontendRejected -> "frontend_rejected"
        .GateExcluded -> "gate_excluded"
        .NonRunnable -> "non_runnable"
        .OracleUnavailable -> "oracle_unavailable"
        .ExpectedExit -> "expected_exit"
        .AotBroken -> "aot_broken"
        .ResidentJit -> "resident_jit"
        .DeoptInterp -> "deopt_interp"
        .RunTierBroken -> "run_tier_broken"
        .TierDivergent -> "tier_divergent"
    }
}
// Rust: tests/dev_parts/support.rs:4692
fn parse_corpus_gate_manifest() -> [CorpusGateRecord] {
    section: CorpusGateClass? := nil
    records := [CorpusGateRecord]{}
    loop raw in fs.read_to_string(OSPath.from(env.CARGO_MANIFEST_DIR).join("tests/jit_corpus_gate.txt")).expect("corpus gate manifest").lines() {
        trimmed := raw.trim() // #4303
        if trimmed.is_empty() || trimmed.starts_with('#') { continue }
        if trimmed.strip_suffix(':') is name {
            section = if name == "e2211" { CorpusGateClass.DeoptInterp } else {
                CORPUS_GATE_SECTION_ORDER.iter().find((class) -> corpus_gate_section_name(class) == name).unwrap_or_else(() -> panic("unknown manifest section: {trimmed}"))
            }
            continue
        }
        pair :: if trimmed.split_once(": ") is (stem, detail) { (stem.to_string(), detail.to_string()) } else { (trimmed.to_string(), "") }
        class :: section.clone().unwrap_or_else(() -> panic("manifest entry outside a section: {trimmed}"))
        records.push(CorpusGateRecord { stem: pair.0, class: class, detail: pair.1 })
    }
    records.sort_by((left, right) -> left.stem.cmp(right.stem))
    ^records
}
// Rust: tests/dev_parts/support.rs:4745
CORPUS_GATE_ROW_FLOOR: USize :: 496
// Rust: tests/dev_parts/support.rs:4755
CORPUS_GATE_UNCLASSIFIED_CEILING: USize :: 0
// Rust: tests/dev_parts/support.rs:4762
CORPUS_GATE_EXCLUDED_CEILING: USize :: 12

// Rust: tests/dev_parts/support.rs:4790
fn assert_corpus_gate_manifest_covers_corpus() -> {
    manifest :: parse_corpus_gate_manifest()
    corpus :: all_example_stems()
    audit :: audit_corpus_gate_ledger(manifest, corpus)
    eprintln("corpus gate ledger: {audit.classified} of {corpus.len()} stem(s) classified; {audit.unclassified.len()} stem(s) in no section:")
    loop stem in audit.unclassified { eprintln("  {stem}") }
    assert(audit.ghosts.is_empty(), "tests/jit_corpus_gate.txt names {audit.ghosts.len()} stem(s) with no Examples/features/<topic>/<name>.jet file: {audit.ghosts:?}. A nonexistent stem is a stale row to delete, never a classification that failed.")
    assert(audit.duplicated.is_empty(), "{audit.duplicated.len()} stem(s) appear in more than one section of tests/jit_corpus_gate.txt, breaking that file's own invariant that every top-level example appears in exactly one:\n{audit.duplicated.join("\n")}")
    assert(audit.reasonless.is_empty(), "{audit.reasonless.len()} row(s) in tests/jit_corpus_gate.txt hold a stem out of the run tier without saying why:\n{audit.reasonless.join("\n")}\nA stem held out states its reason, or it is not held out — it is hidden.")
    assert_eq(audit.classified + audit.unclassified.len(), corpus.len(), "gate ledger accounting is broken: {audit.classified} classified + {audit.unclassified.len()} unclassified != {corpus.len()} discovered stem(s). The pins below only mean something while this identity holds.")
    assert(corpus.len() >= EXAMPLE_CORPUS_FLOOR, "the example corpus shrank to {corpus.len()} stem(s) (floor {EXAMPLE_CORPUS_FLOOR}). A stem leaving `Examples/features/<topic>/` shrinks every claim this ledger makes: restore it, or lower the floor in the same diff as the deletion.")
    assert(audit.classified >= CORPUS_GATE_ROW_FLOOR, "tests/jit_corpus_gate.txt classifies {audit.classified} stem(s) but the ratchet floor is {CORPUS_GATE_ROW_FLOOR}; rows may only GROW. A stem that lost its row did not change class — it left the ledger, and every card citing this file then cites a silence. Regenerate from an observed run; lower the floor only in the same diff as a deleted example.")
    assert(audit.unclassified.len() <= CORPUS_GATE_UNCLASSIFIED_CEILING, "{audit.unclassified.len()} example(s) appear in NO section of tests/jit_corpus_gate.txt (ceiling {CORPUS_GATE_UNCLASSIFIED_CEILING}), breaking that file's own invariant that every top-level example appears in exactly one:\n  {audit.unclassified.join("\n  ")}\nThis count may only FALL. Regenerate the manifest from an observed run; a missing row is not a class change, and guessing one by hand is how the sibling ledger was falsified three times.")
    assert(!audit.unclassified.is_empty() || CORPUS_GATE_UNCLASSIFIED_CEILING == 0, "every example now carries a row: set CORPUS_GATE_UNCLASSIFIED_CEILING to 0 in the same diff, so the hole cannot reopen unnoticed")
    assert(audit.excluded <= CORPUS_GATE_EXCLUDED_CEILING, "tests/jit_corpus_gate.txt excludes {audit.excluded} stem(s) but the ceiling is {CORPUS_GATE_EXCLUDED_CEILING}; exclusions may only SHRINK. Drive the stem instead of excluding it, or lower the ceiling in the same reviewed diff")
}
// Rust: tests/dev_parts/support.rs:4892
struct CorpusGateLedgerAudit {
    classified: USize
    excluded: USize
    ghosts: [String]
    duplicated: [String]
    unclassified: [String]
    reasonless: [String]
}
// Rust: tests/dev_parts/support.rs:4916
fn audit_corpus_gate_ledger(manifest: [CorpusGateRecord], corpus: [String]) -> CorpusGateLedgerAudit {
    discovered := [String:Bool]{}
    loop stem in corpus { discovered[stem] = true }
    sections := [String:[String]]{}
    loop record in manifest { sections.entry(record.stem).or_default().push(corpus_gate_section_name(record.class)) }
    keys := sections.keys().collect()
    keys.sort()
    ghosts := [String]{}
    duplicated := [String]{}
    loop stem in keys {
        if !discovered.contains_key(stem) { ghosts.push(stem.to_string()) }
        listed :: sections[stem]
        if listed.len() > 1 { duplicated.push("  {stem}: {listed.join(", ")}") }
    }
    unclassified :: corpus.iter().filter((stem) -> !sections.contains_key(stem)).cloned().collect()
    reasonless :: manifest.iter().filter((record) -> {
        held_out :: if record.class == {
            .FrontendRejected | .GateExcluded | .NonRunnable | .OracleUnavailable | .ExpectedExit | .AotBroken | .RunTierBroken | .TierDivergent -> true
            _ -> false
        }
        held_out && record.detail.is_empty()
    }).map((record) -> "  {record.stem}: in `{corpus_gate_section_name(record.class)}:` with no reason").collect()
    CorpusGateLedgerAudit {
        classified: sections.len() - ghosts.len(),
        excluded: manifest.iter().filter((record) -> record.class == CorpusGateClass.GateExcluded).count(),
        ghosts: ^ghosts, duplicated: ^duplicated, unclassified: ^unclassified, reasonless: ^reasonless
    }
}
// Rust: tests/dev_parts/support.rs:4986
fn print_corpus_gate_manifest(records: [CorpusGateRecord]) -> {
    loop class in CORPUS_GATE_SECTION_ORDER {
        section :: corpus_gate_section_name(class)
        section_records := records.iter().filter((record) -> record.class == class).collect()
        section_records.sort_by((left, right) -> left.stem.cmp(right.stem))
        if section_records.is_empty() { continue }
        eprintln("{section}:")
        loop record in section_records {
            if record.detail.is_empty() { eprintln("  {record.stem}") } else { eprintln("  {record.stem}: {record.detail}") }
        }
        eprintln("")
    }
}
// Rust: tests/dev_parts/support.rs:5010
fn write_corpus_gate_report(records: [CorpusGateRecord], elapsed: Duration) -> {
    dir_text :: env.var("JET_CORPUS_GATE_REPORT_DIR").ok() ?? { return }
    dir :: OSPath.from(dir_text)
    fs.create_dir_all(dir).expect("create JET_CORPUS_GATE_REPORT_DIR")
    fs.write(dir.join("cases.txt"), corpus_gate_manifest_from_records(records)).expect("write cases.txt")
    backend_trace := "# backend attribution (c727/c730)\n# resident_jit = native Cranelift; deopt_interp = tiered deopt to tier-0\n# run_tier_broken = AOT-green but the default jet run refuses (D-VERDICT-1254-1)\n# tier_divergent = both tiers ran and the named stream(s) disagree\n# parity = pure-interpreter + default tiered + optimized AOT identity\n# only when the row has no interpreter_refused: CODE detail\n"
    loop record in records {
        backend :: corpus_gate_section_name(record.class)
        if record.detail.is_empty() { backend_trace.push_str("{record.stem}\t{backend}\n") } else { backend_trace.push_str("{record.stem}\t{backend}\t{record.detail}\n") }
    }
    fs.write(dir.join("backend_trace.txt"), ^backend_trace).expect("write backend_trace.txt")
    index :: corpus_gate_shard_config().map_or(-1 as I32, ((index, _)) -> index as I32)
    count :: corpus_gate_shard_config().map_or(1, ((_, count)) -> count)
    fs.write(dir.join("timing.txt"), "shard_index={index}\nshard_count={count}\nelapsed_ms={elapsed.as_millis()}\nelapsed_s={elapsed.as_secs_f64():.3}\n").expect("write timing.txt")
    fs.write(dir.join("result.txt"), "ok\n").expect("write result.txt")
    fs.write(dir.join("output_diff.txt"), "").expect("write output_diff.txt")
}
// Rust: tests/dev_parts/support.rs:5058
#Derive(Debug)
struct MultiHeadDiagnosticEntries {
    sema: [Diagnostic]
    aot: [Diagnostic]
    jit: RunOutcome
    default_dev: RunOutcome
    interpreter_gate: RunOutcome
    forced_interpreter: ProgramOutput
}
// Rust: tests/dev_parts/support.rs:5067
fn multi_head_diagnostic_entries(file: String, src: String) -> MultiHeadDiagnosticEntries {
    owned_file :: file.to_owned()
    owned_src :: src.to_owned()
    // GATE #4494: native channel and diagnostic worker.
    (tx, rx) :: mpsc.channel()
    worker :: thread.Builder.new().name("multi-head-diagnostic").spawn(() -> {
        bundle := Loader.load_entry(owned_file).expect("missing-head fixture should load")
        sema :: Sema.check_bundle(&bundle, Sema.CompileMode.Run)
        aot :: jet.compile_with_path(owned_src, owned_file).err().expect("AOT entry must reject missing multi-head coverage")
        jit_result :: run_jit_once(owned_file)
        default_dev :: dev_iteration(owned_file, false, false)
        interpreter_gate :: dev_iteration(owned_file, false, true)
        valid_file :: OSPath.from(env.CARGO_MANIFEST_DIR).join("tests/ui_lint/multi_head_unreachable.jet")
        valid_shown :: valid_file.to_string_lossy().to_owned()
        forced_interpreter :: if dev_iteration(valid_shown, false, true) == {
            .Ran { stdout, stderr, exit_code } -> ProgramOutput.ran(^stdout, ^stderr, exit_code)
            .Problems(diags) -> panic("valid multi-head entry must reach forced interpreter: {diags:?}")
        }
        entries :: MultiHeadDiagnosticEntries { sema: ^sema, aot: ^aot, jit: ^jit_result, default_dev: ^default_dev, interpreter_gate: ^interpreter_gate, forced_interpreter: ^forced_interpreter }
        tx.send(^entries).expect("multi-head diagnostic receiver")
    }).expect("spawn multi-head diagnostic worker")
    entries :: rx.recv_timeout(DEV_DIFF_TIMEOUT).expect("multi-head diagnostic worker")
    worker.join().expect("multi-head diagnostic worker panicked")
    ^entries
}
// Rust: tests/dev_parts/support.rs:5119
#Derive(Debug, Clone, PartialEq, Eq)
struct DiagnosticShape {
    severity: Severity
    code: String
    what: String
    why: String
    fix: String
    span: (USize, USize)?
}
// Rust: tests/dev_parts/support.rs:5128
fn diagnostic_shapes(diags: [Diagnostic]) -> [DiagnosticShape] {
    diags.iter().map((diagnostic) -> DiagnosticShape { severity: diagnostic.severity, code: diagnostic.code.clone(), what: diagnostic.what.clone(), why: diagnostic.why.clone(), fix: diagnostic.fix.clone(), span: diagnostic.span.map((span) -> (span.start, span.end)) }).collect()
}

// Rust: tests/dev_parts/support.rs:5142
fn cranelift_hot_swap_preserves_live_state_inner() -> {
    if skip_if_cranelift_host_unsupported() { return }
    // Rust: tests/dev_parts/support.rs:5146
    fn checked_bundle(src: String, tag: String) -> AST.ProgramBundle {
        b := bundle_of(src, tag)
        diags :: Sema.check_bundle(&b, Sema.CompileMode.Run)
        errors :: diags.into_iter().filter((d) -> d.severity == Severity.Error).collect()
        assert(errors.is_empty(), "fixture must type-check: {errors:?}")
        ^b
    }
    v1 :: checked_bundle("fn run() {\n    print(\"v1\")\n}\n", "jit_swap_v1")
    v2 :: checked_bundle("fn run() {\n    print(\"v2\")\n}\n", "jit_swap_v2")
    policy :: common.development_policy()
    backend := CraneliftBackend.new()
    out1 :: if common.run_cranelift_bundle(&backend, v1, false, policy) == {
        .Ran { stdout, .. } -> ^stdout
        .Problems(ds) -> panic("first run failed: {ds:?}")
    }
    assert_eq(out1, "v1\n")
    assert_eq(jit.resident_invocations_for_test(), 1)
    out2 :: if common.hot_swap_cranelift_bundle(&backend, "run", v2, false, policy) == {
        .Ok(.Ran { stdout, .. }) -> ^stdout
        .Ok(.Problems(ds)) -> panic("hot_swap produced diagnostics: {ds:?}")
        .Err(ds) -> panic("hot_swap failed: {ds:?}")
    }
    assert_eq(out2, "v2\n")
    assert_eq(jit.resident_invocations_for_test(), 2, "hot_swap must preserve resident invocation count (live state)")
    backend2 := CraneliftBackend.new()
    out3 :: if common.hot_swap_cranelift_bundle(&backend2, "run", v1, false, policy) == {
        .Ok(.Ran { stdout, .. }) -> ^stdout
        .Ok(.Problems(ds)) -> panic("second backend hot_swap failed: {ds:?}")
        .Err(ds) -> panic("second backend hot_swap errored: {ds:?}")
    }
    assert_eq(out3, "v1\n")
    assert_eq(jit.resident_invocations_for_test(), 3)
    out4 :: if common.restart_cranelift_bundle(&backend, v2, false, policy) == {
        .Ran { stdout, .. } -> ^stdout
        .Problems(ds) -> panic("restart failed: {ds:?}")
    }
    assert_eq(out4, "v2\n")
    assert_eq(jit.resident_invocations_for_test(), 1, "restart must reset resident live state")
}
// Rust: tests/dev_parts/support.rs:5214
fn cranelift_trap_then_hot_swap_continues_inner() -> {
    if skip_if_cranelift_host_unsupported() { return }
    // Rust: tests/dev_parts/support.rs:5218
    fn checked_bundle(src: String, tag: String) -> AST.ProgramBundle {
        b := bundle_of(src, tag)
        diags :: Sema.check_bundle(&b, Sema.CompileMode.Run)
        errors :: diags.into_iter().filter((d) -> d.severity == Severity.Error).collect()
        assert(errors.is_empty(), "fixture must type-check: {errors:?}")
        ^b
    }
    panics :: checked_bundle("fn run() {\n    xs :: [Int]{ 1, 2, 3 }\n    print(xs[99])\n}\n", "jit_trap_v1")
    recovers :: checked_bundle("fn run() {\n    print(\"recovered\")\n}\n", "jit_trap_v2")
    assert(common.cranelift_resident_safe(panics), "trap fixture must be resident-safe: {common.cranelift_resident_safe_detail(panics)}")
    policy :: common.development_policy()
    backend := CraneliftBackend.new()
    if common.run_cranelift_bundle(&backend, panics, false, policy) == {
        .Ran { stdout, stderr, exit_code } -> {
            assert_eq(exit_code, 70, "a list index OOB is a runtime stop: out={stdout} err={stderr}")
            assert(stdout.is_empty(), "the trap must cut the run before `print`, got stdout {stdout:?}")
            assert(stderr.contains("Stop [E3010]"), "expected the registered E3010 bounds stop, got {stderr:?}")
            assert(!stderr.contains("E0953") && !stderr.contains("comptime"), "a live-program trap must not wear the comptime voice (#1483): {stderr}")
        }
        .Problems(diags) -> panic("a live-program trap is a runtime stop, not a build diagnostic (#1483): {diags.iter().map((d) -> d.code).collect():?}")
    }
    out :: if common.hot_swap_cranelift_bundle(&backend, "run", recovers, false, policy) == {
        .Ok(.Ran { stdout, .. }) -> ^stdout
        .Ok(.Problems(ds)) -> panic("hot_swap after a trap produced diagnostics: {ds:?}")
        .Err(ds) -> panic("hot_swap after a trap errored: {ds:?}")
    }
    assert_eq(out, "recovered\n")
}
// Rust: tests/dev_parts/support.rs:5304
fn bundle_of(src: String, tag: String) -> AST.ProgramBundle {
    p :: env.temp_dir().join("jet_hotswap_{tag}.jet")
    fs.write(p, src).unwrap()
    path :: p.to_str().expect("temp path is utf-8").to_string()
    jet.run_compiler_work(() -> Loader.load_entry(path)).expect("bundle should load")
}
