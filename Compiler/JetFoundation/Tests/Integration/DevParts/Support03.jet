fn persist_binding_survives_hot_swap_and_resets_on_shape_change_inner() -> {
    // Rust: tests/dev_parts/support.rs:5314
    fn load_checked(path: OSPath) -> AST.ProgramBundle {
        b := Loader.load_entry(path.to_str().unwrap()).expect("bundle should load")
        diags :: Sema.check_bundle(&b, Sema.CompileMode.Run)
        errors :: diags.into_iter().filter((d) -> d.severity == Severity.Error).collect()
        assert(errors.is_empty(), "fixture must type-check: {errors:?}")
        ^b
    }
    path :: env.temp_dir().join("jet_persist_reload_{process.id()}.jet")
    write :: (src: String) -> { fs.write(path, src).unwrap() }
    Persist.shared_clear()
    write("#Persist counter := 0\nfn run() {\n    counter += 1\n    print(counter)\n}\n")
    v1 :: load_checked(path)
    write("#Persist counter := 99\nfn run() {\n    counter += 1\n    print(counter)\n}\n")
    v2 :: load_checked(path)
    write("#Persist counter := true\nfn run() {\n    print(counter)\n}\n")
    v3 :: load_checked(path)
    {
        Persist.shared_clear()
        policy :: common.development_policy()
        backend := InterpreterBackend.new(InterpreterInvocation.DevInterpret)
        out1 :: if common.run_interpreter_bundle(&backend, v1, false, policy) == {
            .Ran { stdout, .. } -> ^stdout
            .Problems(ds) -> panic("interp run failed: {ds:?}")
        }
        assert_eq(out1, "1\n")
        out2 :: if common.hot_swap_interpreter_bundle(&backend, "run", v2, false, policy) == {
            .Ok(.Ran { stdout, .. }) -> ^stdout
            .Ok(.Problems(ds)) -> panic("interp hot_swap problems: {ds:?}")
            .Err(ds) -> panic("interp hot_swap failed: {ds:?}")
        }
        assert_eq(out2, "2\n", "compatible `#Persist` reload must keep the mutated Int value, not reinit to 99")
        out3 :: if common.hot_swap_interpreter_bundle(&backend, "run", v3, false, policy) == {
            .Ok(.Ran { stdout, .. }) -> ^stdout
            .Ok(.Problems(ds)) -> panic("interp shape-change problems: {ds:?}")
            .Err(ds) -> panic("interp shape-change failed: {ds:?}")
        }
        assert_eq(out3, "true\n", "incompatible shape must reinitialize from the new Bool initializer")
        out4 :: if common.restart_interpreter_bundle(&backend, v2, false, policy) == {
            .Ran { stdout, .. } -> ^stdout
            .Problems(ds) -> panic("interp restart failed: {ds:?}")
        }
        assert_eq(out4, "100\n", "restart must clear persist and use the new initializer")
    }
    if skip_if_cranelift_host_unsupported() { return }
    {
        Persist.shared_clear()
        policy :: common.development_policy()
        backend := CraneliftBackend.new()
        out1 :: if common.run_cranelift_bundle(&backend, v1, false, policy) == {
            .Ran { stdout, .. } -> ^stdout
            .Problems(ds) -> panic("jit run failed: {ds:?}")
        }
        assert_eq(out1, "1\n")
        out2 :: if common.hot_swap_cranelift_bundle(&backend, "run", v2, false, policy) == {
            .Ok(.Ran { stdout, .. }) -> ^stdout
            .Ok(.Problems(ds)) -> panic("jit hot_swap problems: {ds:?}")
            .Err(ds) -> panic("jit hot_swap failed: {ds:?}")
        }
        assert_eq(out2, "2\n", "JIT hot_swap must keep the mutated `#Persist` Int across compatible reload")
        out3 :: if common.hot_swap_cranelift_bundle(&backend, "run", v3, false, policy) == {
            .Ok(.Ran { stdout, .. }) -> ^stdout
            .Ok(.Problems(ds)) -> panic("jit shape-change problems: {ds:?}")
            .Err(ds) -> panic("jit shape-change failed: {ds:?}")
        }
        assert_eq(out3, "true\n")
        out4 :: if common.restart_cranelift_bundle(&backend, v2, false, policy) == {
            .Ran { stdout, .. } -> ^stdout
            .Problems(ds) -> panic("jit restart failed: {ds:?}")
        }
        assert_eq(out4, "100\n")
    }
    Persist.shared_clear()
    _ :: fs.remove_file(path)
}
