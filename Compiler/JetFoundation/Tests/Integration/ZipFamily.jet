pub STRICT_MISMATCH_SOURCE: String :: """
use core.process as process
fn run() -> {
    count :: process.args().len()
    left :: [1, 2, 3].take(count)
    right :: [10, 20].take(2)
    loop row in left.zip(right) { print(row.a) }
}
"""
