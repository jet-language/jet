// Rust: tests/numops.rs:152
#Test("bit_operators_and_mixed_width_shift") {
    if !common.have_rustc() { return }
    src :: "fn run() -> {{\n    a :: U8{{ 12 }}\n    b :: U8{{ 10 }}\n    print(a & b)\n    c := U8{{ a }}\n    c |= b\n    print(c)\n    print(a ~| b)\n    print(a << 2)\n    print(a >> 1)\n}}\n"
    (code, stdout, stderr) :: build_and_run("u8_bitops", src)
    assert_eq(code, 0, "bit ops should succeed: {stderr}")
