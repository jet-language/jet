// Rust: tests/marker_registry_coverage.rs:413
#Test("the_one_table_holds_every_kind") {
    for kind in [RowKind.Marker, RowKind.Plane, RowKind.Right, RowKind.Fact, RowKind.Truth, RowKind.Diagnostic] {
        row :: Registry.rows().iter().find(fn(row) { row.kind() == kind }).unwrap_or_else(fn() { panic("the one table holds no {kind.name()} row") })
        assert_eq(row.target.kind(), kind)
    }
    for registered in Registry.marker_rows() {
        row :: registered.rule.expect("marker rows carry their applied rule")
        registered :: Registry.row(row.name).unwrap_or_else(fn() { panic("`#{row.name}` is not in the one table") })
        assert_eq(registered.target, RowTarget.Code(row.sites))
        assert_eq(registered.rule.map(fn(rule) { rule.name }), Some(row.name))
        assert_eq(registered.safe_direction, SafeDirection.None)
    }
    // Index declarations once; do not introduce per-row whole-table scans.
    declarations := [:]
    for declaration in Registry.fact_declarations() { declarations[declaration.name] = declaration }
    for row in Registry.type_plane_rows() {
        assert_eq(row.kind(), RowKind.Plane)
        declaration :: declarations.get(row.name).unwrap_or_else(fn() { panic("type plane `{row.name}` has no Prelude declaration") })
        assert_eq(row.identity_bearing, declaration.identity_bearing)
        assert_eq(row.decision, declaration.decision)
    }
    for row in Registry.fact_rows() {
        declaration :: declarations.get(row.name).unwrap_or_else(fn() { panic("fact `{row.name}` has no Prelude declaration") })
        assert_eq(row.target, declaration.target)
        assert_eq(row.identity_bearing, declaration.identity_bearing)
    }
}
// Rust: tests/marker_registry_coverage.rs:465
#Test("every_registered_plane_is_reflectable") {
    planes :: Registry.fact_rows().filter(fn(row) { row.kind() == RowKind.Plane }).collect()
    for row in &planes {
        assert_eq(row.kind(), RowKind.Plane)
        assert(Registry.row(row.name).is_some(), "plane `{row.name}` has no home")
        read :: Registry.registered_fact_read(row.name).unwrap_or_else(fn() { panic("plane `{row.name}` has no FactRead projection") })
        assert(read.registered_planes().any(fn(registered) { registered.name == row.name }), "plane `{row.name}` resolves to the wrong FactRead row")
        assert_eq(read.reflection_kind(), Registry.reflection_kind(row.name))
        info :: jet.Comptime.build_registered_fact_info(row.name).unwrap_or_else(fn() { panic("plane `{row.name}` has no typed reflection row") })
        fields :: match &info { CtValue.Struct { fields, .. } -> fields, _ -> panic("plane `{row.name}` did not reflect as FactInfo") }
        info_kind :: match &fields.iter().find(fn(pair) { pair.0 == "kind" }).expect("FactInfo.kind").1 {
            CtValue.Enum { variant, .. } -> variant,
            _ -> panic("plane `{row.name}` has an untyped FactInfo.kind"),
        }
        value_fields :: match &fields.iter().find(fn(pair) { pair.0 == "value" }).expect("FactInfo.value").1 {
            CtValue.Struct { fields, .. } -> fields,
            _ -> panic("plane `{row.name}` has an untyped FactInfo.value"),
        }
        value_kind :: match &value_fields.iter().find(fn(pair) { pair.0 == "kind" }).expect("FactValue.kind").1 {
            CtValue.Enum { variant, .. } -> variant,
            _ -> panic("plane `{row.name}` has an untyped FactValue.kind"),
        }
        assert_eq(info_kind, value_kind, "aggregate kind drifted for `{row.name}`")
        assert_eq(Some(info_kind.as_str()), read.reflection_kind(), "source read and aggregate kind disagree for `{row.name}`")
    }
    assert_eq(planes.len(), Registry.fact_declarations().iter().filter(fn(declaration) { declaration.target == RowTarget.Value }).count())
}
