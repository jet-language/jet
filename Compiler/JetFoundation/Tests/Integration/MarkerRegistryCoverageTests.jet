// Rust: tests/marker_registry_coverage.rs:224
#Test("every_active_row_is_reachable_at_a_declared_site") {
    ghosts := []
    for registered in Registry.marker_rows() {
        row :: registered.rule.expect("marker rows carry their applied rule")
        if row.status != RuleStatus.Active { continue }
        marker :: spelling(row)
        renderable :: row.sites.iter().copied().filter(fn(site) { site_is_source_renderable(*site) }).collect<[RuleSite]>()
        if renderable.is_empty() { ghosts.push("#{row.name} declares only interior sites {row.sites:?}, so no source can reach it"); continue }
        rejections := []
        reached := false
        for site in renderable {
            source :: match program_at(&marker, row, site) { Some(value) -> value, None -> continue }
            rejected :: rejected_the_marker(&source)
            if rejected.is_empty() { reached = true; break }
            rejections.push("  at {site:?}: {rejected.join("; ")}")
        }
        if !reached { ghosts.push("`{marker}` is rejected at every site it declares:\n{rejections.join("\n")}") }
    }
    assert(ghosts.is_empty(), "registry rows with no reachable spelling ({ghosts.len()}):\n{ghosts.join("\n")}")
}
// Rust: tests/marker_registry_coverage.rs:280
#Test("every_active_row_walks_parse_validate_format_highlight_reflect") {
    highlighted :: Syntax.highlighted_tokens_sorted()
    scratch :: common.Scratch.new("marker-registry-coverage")
    validation_path :: scratch.join("main.jet")
    for registered in Registry.marker_rows() {
        row :: registered.rule.expect("marker rows carry their applied rule")
        if row.status != RuleStatus.Active { continue }
        marker :: spelling(row)
        source :: row.sites.iter().copied().filter(fn(site) { site_is_source_renderable(*site) }).find_map(fn(site) {
            source :: program_at(&marker, row, site)?
            (tokens, lex_diagnostics) :: if source.contains("#Bindgen") { jet.Lexer.lex_generated(&source) } else { jet.Lexer.lex(&source) }
            if !lex_diagnostics.is_empty() { return None }
            parse_diagnostics :: match jet.Parser.parse_for_check(&tokens) { Ok((_, diagnostics)) -> diagnostics, Err(_) -> return None }
            marker_rejected :: parse_diagnostics.iter().any(fn(diagnostic) { diagnostic.code == "E0927" || diagnostic.code == "E0355" })
            (!marker_rejected).then_some(source)
        }).unwrap_or_else(fn() { panic("`{marker}` has no parseable declared site") })
        (tokens, lex_diagnostics) :: if source.contains("#Bindgen") { jet.Lexer.lex_generated(&source) } else { jet.Lexer.lex(&source) }
        assert(lex_diagnostics.is_empty(), "`{marker}` lex: {lex_diagnostics:?}")
        (_, parse_diagnostics) :: jet.Parser.parse_for_check(&tokens).unwrap_or_else(fn(diagnostics) { panic("`{marker}` parse: {diagnostics:?}") })
        assert(parse_diagnostics.iter().all(fn(diagnostic) { diagnostic.code != "E0927" && diagnostic.code != "E0355" }), "`{marker}` was rejected during validation: {parse_diagnostics:?}")
        validation_diagnostics :: sema_diagnostics(&source, &validation_path)
        assert(validation_diagnostics.iter().all(fn(diagnostic) { diagnostic.severity != jet.Diagnostics.Severity.Error || (source.contains("#Bindgen") && diagnostic.code == "E3201") }), "`{marker}` failed semantic validation: {validation_diagnostics:?}")
        once :: format_for_coverage(&source).unwrap_or_else(fn(error) { panic("`{marker}` format: {error:?}") })
        assert_eq(once, format_for_coverage(&once).expect("formatted row must round-trip"))
        assert(highlighted.iter().any(fn(token) { token.text == row.name }), "`{marker}` is missing from the highlight registry")
        reflected :: Registry.marker_row_and_args(row.name, false, []).unwrap_or_else(fn() { panic("`{marker}` is missing from reflection") })
        assert_eq(reflected.row.name, row.name)
    }
}
