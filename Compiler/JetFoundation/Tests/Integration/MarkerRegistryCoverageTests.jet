}
// Rust: tests/numops.rs:172
#Test("over_width_shift_traps_cleanly") {
    if !common.have_rustc() { return }
    src :: "fn shift_it(a: U8, n: U8) -> U8 {{\n    r :: U8{{ a << n }}\n    return r\n}}\nfn run() -> {{\n    print(shift_it(4, 200))\n}}\n"
    (code, _, stderr) :: build_and_run("u8_overshift", src)
    assert_eq(code, 70, "over-width shift should trap (exit 70): {stderr}")
    assert(stderr.contains("out of range"), "panic should explain the shift: {stderr}")
}
