// Rust: tests/marker_registry_coverage.rs:567
#Test("every_registered_truth_names_a_home_and_a_guard_that_exist") {
    root :: OSPath.from(env.manifest_dir())
    violations := []
    for row in Registry.truths() {
        home :: row.home.expect("law_violations refuses a truth with no home")
        if !root.join(home).is_file() { violations.push("`{row.name}` names the home `{home}`, which is not a file") }
        guard :: row.guard.expect("law_violations refuses a truth with no guard")
        match fs.read_to_string(root.join(guard.file)) {
            Ok(source) -> {
                // Rust guards remain reference comparators; Jet guards are #Test declarations.
                declaration :: if guard.file.ends_with(".jet") { "#Test(\"{guard.test}\")" } else { "fn {guard.test}(" }
                if !source.contains(&declaration) { violations.push("`{row.name}` names the guard `{guard.test}`, which `{guard.file}` does not define") }
            },
            Err(_) -> violations.push("`{row.name}` names the guard file `{guard.file}`, which cannot be read"),
        }
    }
    assert(violations.is_empty(), "registered truths whose home or guard is missing ({violations.len()}):\n{violations.join("\n")}")
}
// Rust: tests/marker_registry_coverage.rs:611
#Test("a_prover_publishes_read_only_rows") {
    for name in ["Sendability", "ViewProvenance", "Movedness"] {
        row :: Registry.row(name).unwrap_or_else(fn() { panic("the ownership prover publishes no `{name}` row") })
        assert(row.is_prover_supplied(), "`{name}` names no prover")
        assert_eq(row.safe_direction, SafeDirection.None)
        assert(row.gates.is_empty(), "`{name}` is read-only, so it has no gate")
    }
}
// Rust: tests/marker_registry_coverage.rs:627
#Test("orphan_fact_rows_have_one_home") {
    declarations := [:]
    for declaration in Registry.fact_declarations() { declarations[declaration.name] = declaration }
    rows := [:]
    for row in Registry.rows() { rows.entry(row.name).or_insert([]).push(row) }
    for name in ["Sendability", "Attribution", "Origin", "ViewProvenance", "UnitScaleProvenance", "Maturity"] {
        declaration :: declarations.get(name).unwrap_or_else(fn() { panic("`{name}` has no Prelude declaration") })
        matches :: rows.get(name).unwrap_or(&[])
        assert_eq(matches.len(), 1, "`{name}` must have one registry home")
        row :: matches[0]
        assert_eq(row.target, RowTarget.Value)
        assert_eq(row.kind(), RowKind.Plane)
        assert_eq(row.decision, declaration.decision)
    }
    for engine_fact in ["Uninit", "Exhaustiveness"] {
        assert(!Registry.fact_rows().any(fn(row) { row.name == engine_fact }), "`{engine_fact}` is prover state, not a registered user fact plane")
    }
}
// Rust: tests/marker_registry_coverage.rs:713
#Test("marker_name_literals_stay_in_the_registry") {
    root :: OSPath.from(env.manifest_dir())
    paths := []
    for directory in ["crates/jet-lexer/src", "crates/jet-parser/src", "crates/jet-sema/src"] { collect_source_files(&root.join(directory), &paths) }
    marker_names :: Registry.marker_rows().filter_map(fn(registered) { registered.rule }).filter(fn(row) { row.status == RuleStatus.Active }).map(fn(row) { row.name }).collect()
    sources :: paths.into_iter().map(fn(path) {
        display :: path.display().to_string()
        source :: fs.read_to_string(path).expect("read compiler source")
        (display, source)
    }).collect()
    offenders :: marker_name_literal_offenders(sources, &marker_names)
    assert(offenders.is_empty(), "marker-name literals escaped the registry:\n{offenders.join("\n")}")
    seeded :: marker_name_literal_offenders([("synthetic.rs", "if marker_name == \"Inline\" {}")], &["Inline"])
    assert_eq(seeded.len(), 1, "the seeded drift case must fail this guard")
}
