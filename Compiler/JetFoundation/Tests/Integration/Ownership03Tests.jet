// Rust: tests/ownership.rs:3894
#Test("zero_copy_parser_returns_token_and_remainder_views") {
    src :: "\nstruct Token {{\n    text: View<str>,\n    rest: View<str>\n}}\n\nfn scan(source: String) -[]> Token {{\n    text :: source.before(\":\")\n    rest :: source.after(\":\")\n    return Token{{ text: text, rest: rest }}\n}}\n\nfn parse(source: String) -[]> Token {{\n    return scan(source)\n}}\n\nfn run() {{\n    source := \"name:value\"\n    token :: parse(source)\n    print(token.text)\n    print(token.rest)\n    expected :: \"name\"\n    print(\"wrapped: {{token.text}}\")\n    print(\"wrapped: {{expected}}\")\n}}\n"
    out :: compile(src).expect("a parser token and remainder may borrow one caller-owned source")
    assert(out.rust.contains("pub struct __jet_Token<'__jet___view>") && out.rust.contains("pub __jet_text: &'__jet___view str") && out.rust.contains("pub __jet_rest: &'__jet___view str") && out.rust.contains("-> JetOutcome<__jet_Token<'__jet___view>, JetErr>"), "both parser views must share the hidden source lifetime: {out.rust}")
}
