// Rust: tests/ownership.rs:3654
#Test("resizing_list_owner_with_live_view_is_error") {
    src :: "\nfn run() {{\n    xs := [1, 2, 3]\n    window :: xs[0..1]\n    &xs.push(4)\n    print(window.len())\n}}\n"
    diags :: compile(src).expect_err("resizing a viewed owner must fail")
    assert(diags.iter().any(|d| -> d.code == "E0212"))
}
// Rust: tests/ownership.rs:3668
#Test("named_range_view_blocks_owner_resize_and_replacement") {
