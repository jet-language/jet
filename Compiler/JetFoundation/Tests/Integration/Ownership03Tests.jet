// Rust: tests/ownership.rs:3965
#Test("zero_copy_parser_blocks_source_replacement_while_token_is_live") {
    for (projection, field) in [("parse_text", "text"), ("parse_rest", "rest")] {
        src :: "\nstruct Token {{\n    text: View<str>,\n    rest: View<str>\n}}\n\nfn scan(source: String) -[]> Token {{\n    text :: source.before(\":\")\n    rest :: source.after(\":\")\n    return Token{{ text: text, rest: rest }}\n}}\n\nfn parse(source: String) -[]> Token {{\n    return scan(source)\n}}\n\nfn parse_text(source: String) -[]> View<str> {{\n    return parse(source).text\n}}\n\nfn parse_rest(source: String) -[]> View<str> {{\n    return parse(source).rest\n}}\n\nfn run() {{\n    source := \"name:value\"\n    selected :: $PROJECTION(source)\n    source = \"other:data\"\n    print(selected)\n}}\n".replace("$PROJECTION", projection)
        diags :: compile(&src).expect_err("live parser views must keep caller storage stable")
        assert(diags.iter().any(|diag| -> diag.code == "E0212"), "expected owner-invalidation error for token.{field}: {diags:?}")
    }
}
