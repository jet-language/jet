// Rust: tests/ownership.rs:4671
#Test("mutable_view_bounds_fail_at_construction_in_every_tier") {
    src :: "\nfn run() {{\n    values := [1]\n    outside :: [&values[0..0], &values[2..2]]\n}}\n"
    // D-FAIL-BREACH1=A: the shared stop boundary retains Jet source locations.
    stop :: "Stop [E3001]: `panic: can't view 1 items from 2 to 2 (inclusive)`"
    _ :: compile(src).expect("dynamic view bounds must reach runtime validation")
    if common.have_rustc() {
        (code, _stdout, stderr) :: common.build_and_run("jet_view_mut_bounds_aot", "view_mut_bounds_aot", src)
        assert_ne(code, 0, "AOT accepted an invalid mutable view")
        assert(stderr.contains(stop), "AOT reported the wrong runtime failure: {stderr}")
    }
    root :: common.unique_tmp("jet_view_mut_bounds_tiers")
    _ :: fs.create_dir_all(&root).unwrap()
    path :: root.join("main.jet")
    _ :: fs.write(&path, src).unwrap()
    bundle := load_entry(path.to_str().unwrap()).unwrap()
    errors :: check_bundle(&bundle, CompileMode.Run).into_iter().filter(|diag| -> diag.severity == Severity.Error).collect()
    assert(errors.is_empty(), "{errors:?}")
    jit_report: String? := None
    if cranelift_host_supported() {
        assert(common.cranelift_resident_safe(&bundle), "{common.cranelift_resident_safe_detail(&bundle)}")
        policy :: common.development_policy()
        _ :: common.compile_cranelift_bundle(&bundle, &policy).expect("mutable view bounds must lower to JIT")
        backend := CraneliftBackend.new()
        if common.run_cranelift_bundle(&backend, &bundle, false, &policy) == {
            .Ran{stderr, exit_code, ..} -> {
                assert_eq(exit_code, 70, "resident JIT exit drift: {stderr}")
                assert(stderr.starts_with(stop), "resident JIT reported the wrong runtime failure: {stderr}")
                jit_report = Some(stderr)
            }
            .Problems(diags) -> { panic("resident JIT returned diagnostics instead of running: {diags:?}") }
        }
    }
    if dev_iteration(path.to_str().unwrap(), false, true) == {
        .Ran{stderr, exit_code, ..} -> {
            assert_eq(exit_code, 70, "forced interpreter exit drift: {stderr}")
            assert(stderr.starts_with(stop), "forced interpreter reported the wrong runtime failure: {stderr}")
            assert(stderr.contains("main.jet:4 in run"), "forced interpreter dropped the Jet source location: {stderr}")
            if jit_report == .Some(jit) {
                assert_eq(jit, stderr, "the resident JIT and the interpreter must report one failure")
            }
        }
        .Problems(diags) -> { panic("forced interpreter returned diagnostics instead of running: {diags:?}") }
    }
    // GATE #4494: native process invocation.
    output :: Command.new(env("CARGO_BIN_EXE_jet")).args(["run", path.to_str().unwrap()]).current_dir(&root).output().expect("run invalid mutable view through the default tier")
    assert(!output.status.success(), "default tier accepted an invalid mutable view")
}
