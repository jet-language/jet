// Rust: tests/ownership.rs:3609
#Test("write_window_cannot_be_stored") {
    src :: "\nstruct Holder {{ window: ViewMut<Int> }}\nfn run() {{\n    xs := [1, 2, 3]\n    edit :: &xs[0..1]\n    holder :: Holder{{ window: edit }}\n    print(holder.window.len())\n}}\n"
    diags :: compile(src).expect_err("write view storage must be rejected")
    assert(diags.iter().any(|d| -> d.code == "E2305"), "{diags:?}")
}
