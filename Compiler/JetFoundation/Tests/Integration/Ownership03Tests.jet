// Rust: tests/ownership.rs:3780
#Test("method_write_argument_conflicts_with_live_view_once") {
    src :: "\nstruct Editor {{ id: Int }}\n\nimpl Editor {{\n    fn touch(self, values: &[Int]) {{\n        &values.push(9)\n    }}\n}}\n\nfn run() {{\n    editor :: Editor{{ id: 0 }}\n    values := [1, 2, 3]\n    window :: values[0..2]\n    editor.touch(&values)\n    print(window[0])\n}}\n"
