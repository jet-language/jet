        ("return", "\nfn leak(values: &[Int]) -[]> ViewMut<Int> {{\n    selected :: &values.get_disjoint_write([0, 1]) ?? panic(\"selection failed\")\n    loop edit in selected {{ return edit }}\n    panic(\"unreachable\")\n}}\nfn run() {{\n    values := [1, 2]\n    leak(&values)\n}}\n")
