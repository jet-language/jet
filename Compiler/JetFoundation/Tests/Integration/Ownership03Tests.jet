        src :: "\nfn run() {{\n    xs := [1, 2, 3]\n    band :: 0..<2\n    window :: xs[band]\n    {action}\n    print(window.len())\n}}\n"
        diags :: compile(&src).expect_err("changing a viewed owner must fail")
        assert(diags.iter().any(|d| -> d.code == "E0212"), "expected E0212 for `{action}`, got {diags:?}")
    }
}
