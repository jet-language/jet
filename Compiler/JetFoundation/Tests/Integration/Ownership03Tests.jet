// Rust: tests/ownership.rs:4841
#Test("runtime_disjoint_views_match_aot_jit_dev_and_interpreter") {
    src :: "\nfn run() {{\n    values := [1, 2, 3, 4]\n    parts :: &values.split_write(2) ?? panic(\"split failed\")\n    parts.left[0] = 10\n    parts.right[1] = 40\n\n    &values.edit_disjoint([0, 2], (left, right) -> {{\n        left[0] = left[0] + 1\n        right[0] = right[0] + 2\n    }}) ?? panic(\"edit failed\")\n\n    selected :: &values.get_disjoint_write([1, 3]) ?? panic(\"selection failed\")\n    loop edit in selected {{\n        edit[0] = edit[0] + 5\n    }}\n    print(values)\n}}\n"
    expected :: "[11, 7, 5, 45]\n"
    root :: common.unique_tmp("jet_runtime_disjoint_tiers")
    _ :: fs.create_dir_all(&root).unwrap()
    path :: root.join("main.jet")
    _ :: fs.write(&path, src).unwrap()
    if common.have_rustc() {
        (code, stdout, stderr) :: common.build_and_run("jet_runtime_disjoint_tiers", "aot", src)
        assert_eq(code, 0, "AOT failed: {stderr}")
        assert_eq(stdout, expected, "AOT output drift")
    }
    bundle := load_entry(path.to_str().unwrap()).unwrap()
    errors :: check_bundle(&bundle, CompileMode.Run).into_iter().filter(|diag| -> diag.severity == Severity.Error).collect()
    assert(errors.is_empty(), "{errors:?}")
    assert(common.cranelift_resident_safe(&bundle), "{common.cranelift_resident_safe_detail(&bundle)}")
    _ :: common.compile_cranelift_bundle(&bundle, &common.development_policy()).expect("disjoint views must lower to resident JIT")
    for (tier, force_interpreter) in [("resident JIT", false), ("interpreter", true)] {
        jit.reset_jit_trace_for_test()
        if dev_iteration(path.to_str().unwrap(), false, force_interpreter) == {
            .Ran{stdout, stderr, exit_code} -> {
                assert_eq(exit_code, 0, "{tier}: {stderr}")
                assert_eq(stderr, "", "{tier} stderr drift")
                assert_eq(stdout, expected, "{tier} output drift")
            }
            .Problems(diags) -> { panic("{tier} failed: {diags:?}") }
        }
        if !force_interpreter {
            assert(jit.jit_executed_for_test(), "resident JIT did not execute")
            assert(!jit.fallback_invoked_for_test() && !jit.deopt_invoked_for_test(), "resident JIT used an interpreter fallback")
        }
    }
    // GATE #4494: native process invocation.
    output :: Command.new(env("CARGO_BIN_EXE_jet")).args(["run", path.to_str().unwrap()]).current_dir(&root).output().expect("run disjoint views through the default tier")
    assert(output.status.success(), "default run failed:\n{String.from_utf8_lossy(&output.stderr)}")
    assert_eq(String.from_utf8(output.stdout).unwrap(), expected)
}
