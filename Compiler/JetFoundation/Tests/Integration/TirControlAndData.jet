//RS /// D-FAILURE-FOUNDATION1=A: a plain fallible call inserts the existing
//RS /// propagation node in every value/statement shape; only `??` handles locally.
//RS #[test]
//RS fn implicit_failure_propagation_covers_call_positions() {
//RS     let src = r#"
//RS struct Holder {
//RS     value: Int
//RS 
//RS     fn bump(self, by: Int) -> Int {
//RS         return add(self.value + by)
//RS     }
//RS }
//RS 
//RS fn source(value: Int) -> Int {
//RS     if value == 0 {
//RS         return Err("source failed")
//RS     }
//RS     return value
//RS }
//RS 
//RS fn add(value: Int) -> Int -> value + 1
//RS 
//RS fn is_zero(value: Int) -> Bool -> value == 0
//RS 
//RS fn argument(value: Int) -> Int {
//RS     return add(source(value))
//RS }
//RS 
//RS fn nested(value: Int) -> Int {
//RS     return source(value) + 1
//RS }
//RS 
//RS fn branch(value: Int) -> Int {
