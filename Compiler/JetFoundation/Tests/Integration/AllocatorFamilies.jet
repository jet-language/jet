// Rust: tests/allocator_families.rs:1
// Hostile allocator proofs. Rust harnesses are peer comparators over the exact emitted prelude.
use std.[fs, process]
use std.process.[Command, Output]
use std.sync.atomic.[AtomicU64, Ordering]
use jet.AST.ProgramBundle
use jet.Codegen.TIR.lower_checked_mir_program_for
use jet.Codegen.MIRRust.[emit_mir_program, MirRustConfig, MirRustTarget, MirRustExecutionConfig]
use jet_foundation.MIR.[MirArtifactRequest, MirArtifactTarget, MirArtifactKind, MirArtifactBuildMode, optimize_mir_program, MirOptimizationPolicy]
use jet_foundation.Layout.TargetLayout
use jet_foundation.Tests.Integration.Common as common
use jet_foundation.Tests.Integration.TirSupport as tir_support

// Rust: tests/allocator_families.rs:13
fn emit_native_aot(bundle: &ProgramBundle) -> String {
    request :: MirArtifactRequest.new(.RustAot, .NativeExecutable, .Dev)
    (mir, artifact) :: lower_checked_mir_program_for(bundle, request).expect("checked native artifact lowers through MIR")
    mir.validate().expect("canonical MIR validates in allocator test")
    optimized :: optimize_mir_program(^mir, &MirOptimizationPolicy.conservative()).expect("canonical MIR optimizes in allocator test")
    emit_mir_program(&optimized, &MirRustConfig {
        target: TargetLayout.host(), target_kind: .Native, root_prefix: "",
        execution: MirRustExecutionConfig.for_artifact(artifact)
    })
}
// Rust: tests/allocator_families.rs:39
// GATE #4494: native atomic sequence and process/FS primitives in test harnesses.
SEQ :: AtomicU64.new(0)
// Rust: tests/allocator_families.rs:41
fn temp_dir(label: String) -> OSPath {
    id :: SEQ.fetch_add(1, Ordering.Relaxed)
    common.test_scratch_root("allocator_families").join("jet_allocator_{label}_{process.id()}_{id}")
}
// Rust: tests/allocator_families.rs:49
fn compile_rust_harness(body: String) -> Output {
    dir :: temp_dir("runtime")
    fs.create_dir_all(&dir).unwrap()
    source :: dir.join("main.rs")
    binary :: dir.join("main")
    observe :: fs.read_to_string("crates/jet-codegen/src/Prelude/Observe.rs").unwrap()
    uninit :: fs.read_to_string("crates/jet-codegen/src/Prelude/Uninit.rs").unwrap()
    encoding_errors :: fs.read_to_string("crates/jet-foundation/src/EncodingErrors.rs").unwrap()
    json_number :: fs.read_to_string("crates/jet-foundation/src/JSONNumber.rs").unwrap()
    encoding_json :: fs.read_to_string("crates/jet-foundation/src/EncodingJson.rs").unwrap()
    outcome :: fs.read_to_string("crates/jet-foundation/src/Outcome.rs").unwrap()
    runtime_diagnostic_core :: fs.read_to_string("crates/jet-foundation/src/RuntimeDiagnosticCore.rs").unwrap()
    fixed_kernel :: fs.read_to_string("crates/jet-codegen/src/Prelude/Core/FixedAllocator.rs").unwrap()
    fault_injection :: fs.read_to_string("crates/jet-codegen/src/Prelude/FaultInjection.rs").unwrap()
    sentry :: fs.read_to_string("crates/jet-foundation/src/MemSentry.rs").unwrap()
    prelude :: fs.read_to_string("crates/jet-codegen/src/Prelude/Mem.rs").unwrap()
    // The standalone peer harness has no registered generic runtime row.
    registry :: """
#[allow(non_snake_case)]
mod Registry {
    pub fn active_runtime_diagnostic(_code: &str) -> Option<&'static super::JetRuntimeDiagnosticRow> { None }
}
"""
    runtime_stop :: """
fn jet_sentry_runtime_stop(
    code: &'static str, file: &str, line: u32, gate: &str, operation: &str,
    obligation: &str, obligation_status: &str, foreign_component: Option<&str>,
    foreign_fenced: Option<bool>, detail: &str,
) -> ! {
    let report = jet_render_runtime_sentry_with_context(
        match code { "R0801" => "R0801", "R0802" => "R0802", "R0803" => "R0803", _ => "R0801" },
        file, line, gate, operation, obligation, detail, obligation_status,
        foreign_component, foreign_fenced,
    );
    panic!("{}", report.rendered);
}
"""
    source_text :: "#![allow(dead_code)]\n" + observe + "\nmod jet_encoding_errors {\n" + encoding_errors +
        "\n}\nmod jet_json_number {\n" + json_number + "\n}\n#[allow(non_snake_case)]\nmod EncodingJson {\n" + encoding_json +
        "\n}\n#[allow(non_snake_case)]\nmod RuntimeDiagnosticCore {\n" + runtime_diagnostic_core + "\n}\n" + registry + outcome +
        fault_injection + runtime_stop + "\nmod jet_uninit_semantics {\n" + uninit + "\n}\nmod jet_fixed_kernel {\n" + fixed_kernel +
        "\n}\nmod jet_mem {\nmod jet_sentry {\n" + sentry + "\n}\n" + prelude + "\n}\n" + body + "\n"
    fs.write(&source, source_text).unwrap()
    compiled :: Command.new("rustc").args(["--edition", "2021"]).arg(&source).arg("-o").arg(&binary).output().unwrap()
    assert(compiled.status.success(), "allocator runtime harness failed to compile:\n{String.from_utf8_lossy(&compiled.stderr)}")
    Command.new(binary).output().unwrap()
}
// Rust: tests/allocator_families.rs:167
fn compile_program_allocator_harness(body: String) -> Output {
    dir :: temp_dir("program_allocator")
    fs.create_dir_all(&dir).unwrap()
    source :: dir.join("main.rs")
    binary :: dir.join("main")
    allocator :: fs.read_to_string("crates/jet-codegen/src/Prelude/ProgramAllocator.rs").unwrap()
    fs.write(&source, "#![allow(dead_code)]\nmod allocator {\n" + allocator + "\n}\n" + body + "\n").unwrap()
    compiled :: Command.new("rustc").args(["--edition", "2021"]).arg(&source).arg("-o").arg(&binary).output().unwrap()
    assert(compiled.status.success(), "program allocator harness failed to compile:\n{String.from_utf8_lossy(&compiled.stderr)}")
    Command.new(binary).output().unwrap()
}
// Rust: tests/allocator_families.rs:194
fn write_program_allocator_project(label: String, allocator: String?) -> OSPath {
    root :: temp_dir(label)
    fs.create_dir_all(&root).unwrap()
    allocator_line :: allocator.map(fn(value) { "allocator: {value}\n" }).unwrap_or_default()
    fs.write(root.join("package.jet"), "name: \"{label}\"\nversion: \"0.1.0\"\n{allocator_line}").unwrap()
    entry :: root.join("main.jet")
    fs.write(&entry, "fn run() { print(\"ok\") }\n").unwrap()
    entry
}
// Rust: tests/allocator_families.rs:210
fn compile_jet(src: String) -> Result<jet.CompileOutput, [String]> {
    dir :: temp_dir("jet")
    fs.create_dir_all(&dir).unwrap()
    tir_support.write_test_package(&dir, tir_support.TIR_TEST_PACKAGE)
    path :: dir.join("main.jet")
    fs.write(&path, src).unwrap()
    jet.compile_with_path(src, &path.to_string_lossy()).map_err(fn(diags) { diags.into_iter().map(fn(diag) { diag.code }).collect() })
}
// Rust: tests/allocator_families.rs:220
fn run_jet(label: String, src: String) -> (I32, String, String) {
    output :: compile_jet(src).unwrap_or_else(fn(diags) { panic("{label} front end failed: {diags:?}") })
    user :: common.strip_vetted_prelude_modules(&output.rust)
    unsafe_lines :: user.lines().filter(fn(line) { !common.unsafe_keyword_columns(line).is_empty() }).collect()
    assert(unsafe_lines.is_empty(), "unsafe escaped the vetted prelude: {unsafe_lines:?}")
    dir :: temp_dir(label)
    fs.create_dir_all(&dir).unwrap()
    source :: dir.join("main.rs")
    binary :: dir.join("main")
    fs.write(&source, output.rust).unwrap()
    compiled :: Command.new("rustc").args(["--edition", "2021"]).arg(&source).arg("-o").arg(&binary).output().unwrap()
    assert(compiled.status.success(), "rustc rejected generated {label} code:\n{String.from_utf8_lossy(&compiled.stderr)}")
    ran :: Command.new(binary).output().unwrap()
    (ran.status.code().unwrap_or(-1), String.from_utf8_lossy(&ran.stdout).into_owned(), String.from_utf8_lossy(&ran.stderr).into_owned())
}
