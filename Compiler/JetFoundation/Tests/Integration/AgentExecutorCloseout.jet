// Rust: tests/agent_executor_closeout.rs:1
// Hostile executor matrix; separate from platform-specific executor rows.
use jet_foundation.Tests.Integration.TirSupport as tir_support
use jetpack.RuntimePolicy as RuntimePolicy
use std.[env, fs, process, thread]
use std.net.TcpListener
use std.sync.Arc
use std.sync.atomic.[AtomicBool, Ordering]
use std.time.[Duration, Instant]
use core.sys.target.selected_os

// Rust: tests/agent_executor_closeout.rs:12
fn native_backend_available() -> Bool {
    RuntimePolicy.detect_sandbox().level == RuntimePolicy.SandboxLevel.Strong
}
// Rust: tests/agent_executor_closeout.rs:17
fn host_executable(name: String) -> String {
    env.split_paths(env.var_os("PATH").expect("PATH should be set"))
        .map(fn(directory) { directory.join(name) })
        .find(fn(candidate) { candidate.is_file() })
        .and_then(fn(candidate) { fs.canonicalize(candidate).ok() })
        .unwrap_or_else(fn() { OSPath("/bin/{name}") })
        .to_string_lossy().replace('\\', "\\\\").replace('"', "\\\"")
}

// Rust: tests/agent_executor_closeout.rs:29
#Test("agent_executor_rejects_unenforced_grants_before_spawn_on_all_tiers") {
    marker :: env.temp_dir().join("jet-agent-executor-unenforced-{process.id()}")
    _ :: fs.remove_file(&marker)
    source :: """
use core.process as process
fn run() {
    policy :: Authority.from_rights(["FS.Read:home"])
    spec :: process.cmd(["sh", "-c", "printf escaped > '__MARKER__'"]).cwd("/tmp").under(policy)
    if spec.plan() == {
        .Ok(_) -> print("escaped")
        .Err(_) -> print("refused")
    }
}
""".replace("__MARKER__", marker.display().to_string())
    tir_support.assert_tiers_agree("agent_executor_unenforced_grant", source, "refused\n")
    assert(!marker.exists(), "unenforced authority grant reached spawn")
}

// Rust: tests/agent_executor_closeout.rs:56
#Test("agent_executor_limits_and_secret_receipts_match_all_tiers") {
    if selected_os() == "linux" || selected_os() == "macos" {
        source :: """
use core.process as process
fn run() {
    policy :: process.workspace()
    limited :: process.cmd(["sh", "-c", "printf 123456"])
        .stdout(.Capture).stderr(.Capture).output_limit(3).cwd("/tmp").under(policy)
    if limited.plan() == {
        .Ok(_) -> {
            if limited.run() == {
                .Ok(_) -> print("output-escaped")
                .Err(_) -> print("output-limit")
            }
        }
        .Err(_) -> print("unsupported")
    }
    timeout :: Duration.milliseconds(50) ?? panic("timeout duration")
    slow :: process.cmd(["sh", "-c", "while true; do :; done"]).timeout(timeout).cwd("/tmp").under(policy)
    if slow.plan() == {
        .Ok(_) -> {
            if slow.run() == {
                .Ok(receipt) -> print(receipt.timed_out)
                .Err(_) -> print("timeout-error")
            }
        }
        .Err(_) -> print("unsupported")
    }
    secret :: process.cmd(["sh", "-c", "printf '%s' \"$SECRET_TOKEN\""])
        .env_clear().env("SECRET_TOKEN", "agent-receipt-secret").cwd("/tmp").under(policy)
    if secret.plan() == {
        .Ok(plan) -> {
            receipt :: secret.run() ?? panic("secret receipt")
            print(receipt.output)
            print(receipt.redacted)
            print(plan.policy_digest == receipt.policy_digest)
            print(plan.authority == receipt.authority)
        }
        .Err(_) -> print("unsupported")
    }
}
"""
        expected :: if native_backend_available() -> "output-limit\ntrue\n<redacted>\ntrue\ntrue\ntrue\n" else -> "unsupported\nunsupported\nunsupported\n"
        tir_support.assert_tiers_agree("agent_executor_limits_receipts", source, expected)
    }
}

// Rust: tests/agent_executor_closeout.rs:121
#Test("agent_executor_network_and_descendant_hostiles_fail_closed_on_all_tiers") {
    if selected_os() == "linux" || selected_os() == "macos" {
        // GATE #4494: native TCP oracle, shared atomics and thread ownership.
        listener :: TcpListener.bind(("127.0.0.1", 0)).expect("bind hostile network oracle")
        listener.set_nonblocking(true).expect("set hostile network oracle nonblocking")
        port :: listener.local_addr().expect("network oracle address").port()
        stop :: Arc.new(AtomicBool.new(false))
        connected :: Arc.new(AtomicBool.new(false))
        thread_stop :: Arc.clone(&stop)
        thread_connected :: Arc.clone(&connected)
        network_thread :: thread.spawn(fn() {
            deadline :: Instant.now() + Duration.from_secs(15)
            loop !thread_stop.load(Ordering.Acquire) && Instant.now() < deadline {
                if listener.accept() == {
                    .Ok((stream, _)) -> {
                        thread_connected.store(true, Ordering.Release)
                        bytes := [U8]{}
                        _ :: stream.read_to_end(&bytes)
                    }
                    .Err(error) -> {
                        if error.kind() == std.io.ErrorKind.WouldBlock {
                            thread.sleep(Duration.from_millis(5))
                        } else { break }
                    }
                }
            }
        })
        sleep :: host_executable("sleep")
        source :: """
use core.process as process
fn run() {
    policy :: process.workspace()
    network :: process.cmd(["bash", "-c", "if printf escaped > /dev/tcp/127.0.0.1/__PORT__ 2>/dev/null; then exit 41; else exit 0; fi"]).cwd("/tmp").under(policy)
    if network.plan() == {
        .Ok(_) -> {
            if network.run_checked() == {
                .Ok(_) -> print("network-blocked")
                .Err(_) -> print("network-escaped")
            }
        }
        .Err(_) -> print("unsupported")
    }
    descendants :: process.cmd(["sh", "-c", "(__SLEEP__ 1; printf child-leaked) & exit 0"])
        .stdout(.Capture).stderr(.Capture).cwd("/tmp").under(policy)
    if descendants.plan() == {
        .Ok(_) -> {
            receipt :: descendants.run() ?? panic("descendant receipt")
            print(receipt.success)
            print(receipt.descendants)
            print(receipt.output == "")
        }
        .Err(_) -> print("unsupported")
    }
}
""".replace("__PORT__", port.to_string()).replace("__SLEEP__", sleep)
        expected :: if native_backend_available() -> "network-blocked\ntrue\ncontained\ntrue\n" else -> "unsupported\nunsupported\n"
        tir_support.assert_tiers_agree("agent_executor_network_descendants", source, expected)
        stop.store(true, Ordering.Release)
        network_thread.join().expect("network oracle thread")
        assert(!connected.load(Ordering.Acquire), "authority-bound child reached host network")
    }
}

// Rust: tests/agent_executor_closeout.rs:211
#Test("agent_executor_example_matches_all_hosted_tiers") {
    expected :: if (selected_os() == "linux" || selected_os() == "macos") && native_backend_available() -> "agent-safe\ntrue\ntrue\n" else -> "unsupported\n"
    tir_support.assert_example_cli_tiers_agree("io/agent_executor", expected)
}
