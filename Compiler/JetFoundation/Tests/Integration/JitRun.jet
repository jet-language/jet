//RS /// Every zero-argument `ProcessSpec` builder runs resident, and each one
//RS /// reports what the AOT lens reports:
//RS ///   * `env_clear` still runs the command and captures its output;
//RS ///   * `detached` drops the streams, so the output is empty;
//RS ///   * `terminal` runs through the native PTY backend and returns its output.
//RS ///
//RS /// The expected text is the recorded `jet run --release` stdout for the same
//RS /// program, so a divergence here is a lens gap.
//RS #[test]
//RS fn zero_arg_process_spec_builders_run_resident() {
//RS     if skip_if_cranelift_host_unsupported() {
//RS         return;
//RS     }
//RS     let dir = common::unique_tmp("jit_process_zero_arg_builders");
//RS     fs::create_dir_all(&dir).unwrap();
//RS     let file = dir.join("builders.jet");
//RS     fs::write(
//RS         &file,
//RS         r#"use core.process as process
//RS 
//RS fn run() {
//RS     cleared :: process.cmd(["echo", "x"]).env_clear().run() ?? panic("env_clear failed")
//RS     print(cleared.success)
//RS     print(cleared.output.trim())
//RS     detached :: process.cmd(["echo", "y"]).detached().run() ?? panic("detached failed")
//RS     print(detached.success)
//RS     print("[{detached.output.trim()}]")
//RS     if process.cmd(["printf", "z"]).terminal().run() == {
//RS         .Ok(v) -> { print(v.output.contains("z")) }
//RS         .Err(_) -> { print("terminal err") }
//RS         else -> {}
//RS     }
//RS }
//RS "#,
//RS     )
//RS     .unwrap();
//RS 
//RS     jet_jit::reset_jit_trace_for_test();
//RS     let outcome = dev_iteration(file.to_str().unwrap(), false, false);
//RS     let stdout = match outcome {
//RS         RunOutcome::Ran { stdout, .. } => stdout,
//RS         RunOutcome::Problems(diags) => panic!(
//RS             "zero-argument ProcessSpec builders must run under default `jet run`: {:?}",
//RS             diags.iter().map(|d| d.code.clone()).collect::<Vec<_>>()
//RS         ),
//RS     };
//RS     assert_eq!(stdout, "true\nx\ntrue\n[]\ntrue\n");
//RS     assert!(
//RS         jet_jit::jit_executed_for_test(),
//RS         "the builders must lower to host calls, not deopt"
//RS     );
//RS     assert!(
//RS         !jet_jit::fallback_invoked_for_test(),
//RS         "a missing residency entry deopts to tier 0, which prints the same bytes from the wrong tier"
//RS     );
//RS 
//RS     let _ = fs::remove_dir_all(&dir);
//RS }
