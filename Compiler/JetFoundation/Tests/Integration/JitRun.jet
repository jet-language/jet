//RS /// Card #1993 — the iterator adapters emitted CLIF that Cranelift's own
//RS /// verifier rejected.
//RS ///
//RS /// `lower_iter_chunk_while` minted its increment `1` inside the `existing` arm
//RS /// and read it back in the shared `step` latch. The `first` arm reaches `step`
//RS /// without passing through `existing`, so the constant's definition does not
//RS /// dominate its use and Cranelift answered
//RS /// `uses value v… from non-dominating inst…`. That is a lowering bug of the
//RS /// class I2 names, never an unsupported construct.
//RS ///
//RS /// No output-only check can see it: the compile failure makes default
//RS /// `jet run` interpret the whole program, and the interpreter prints the right
//RS /// answer. So this proves three things together — the resident tier COMPILES
//RS /// the bundle (the verifier runs inside `compile_cranelift_bundle`), it EXECUTES
//RS /// native code with no deopt and no fallback, and AOT, default `jet run`, and
//RS /// the forced interpreter all produce the same bytes.
//RS #[test]
//RS fn iter_adapter_latches_emit_dominating_clif() {
//RS     if skip_if_cranelift_host_unsupported() {
//RS         return;
//RS     }
//RS     let dir = common::unique_tmp("jit_iter_adapter_dominance");
//RS     fs::create_dir_all(&dir).unwrap();
//RS     fs::write(
//RS         dir.join("package.jet"),
//RS         "name: \"jit_iter_adapter_dominance\"\nversion: \"0.1.0\"\nauthority: { holds: { allow: [IO, Mem.Alloc] } }\n",
//RS     )
//RS     .unwrap();
//RS     let file = dir.join("adapters.jet");
//RS     fs::write(
//RS         &file,
//RS         r#"fn run() {
//RS     jagged :: [1, 2, 3, 5, 6, 9, 10, 12]
//RS     print(jagged.chunk_while((a: Int, b: Int) -> (b == a + 1)).to_list())
//RS     parities :: [2, 4, 6, 1, 3, 8, 10]
//RS     print(parities.dedup_by((n: Int) -> (n % 2)).to_list())
//RS     print(jagged.is_sorted_by((n: Int) -> n))
//RS }
//RS "#,
//RS     )
//RS     .unwrap();
//RS     let shown = file.to_string_lossy().into_owned();
//RS 
//RS     let mut bundle = jet::Loader::load_entry(&shown).expect("adapter fixture should load");
//RS     let diagnostics = jet::Sema::check_bundle(&mut bundle, jet::Sema::CompileMode::Run);
//RS     assert!(
//RS         diagnostics
//RS             .iter()
//RS             .all(|diagnostic| !matches!(diagnostic.severity, jet::Diagnostics::Severity::Error)),
//RS         "adapter fixture must type-check: {diagnostics:#?}"
//RS     );
//RS     assert!(
//RS         common::cranelift_resident_safe(&bundle),
