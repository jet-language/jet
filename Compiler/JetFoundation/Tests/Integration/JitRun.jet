//RS     print(repeats.last_index_of(7))
//RS     counts := [String:Int]{ "words": 4 }
//RS     print(&counts.pop("words") ?? -1)
//RS     print(&counts.pop("words") ?? -1)
//RS     priorities := PriorityQueue.from([2, 9, 4])
//RS     print(&priorities.pop() ?? -1)
//RS     single := PriorityQueue.from([1])
//RS     print(&single.pop() ?? -1)
//RS     print(&single.pop() ?? -1)
//RS }
//RS "#,
//RS     )
//RS     .unwrap();
//RS     let shown = file.to_string_lossy().into_owned();
//RS 
//RS     let mut bundle = jet::Loader::load_entry(&shown).expect("fixture should load");
