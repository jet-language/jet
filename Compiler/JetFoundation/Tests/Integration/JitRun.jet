// Tower #1253/#1255: ProcessSpec builders preserve their argument and environment
// semantics across the native and development execution lenses.
use Compiler.JetFoundation.Tests.Integration.Common as common
use std.env as env
use std.process.[Command, Output]

// Rust: tests/jit_run.rs:382
// GATE #4483: selected native target support; #4494: environment and stderr.
fn skip_if_native_target_unsupported() -> Bool {
    if common.native_host_supported() {
        false
    } else if env.var("JET_REQUIRE_NATIVE_TARGET").as_deref() == .Ok("1") {
        panic("native execution unsupported on this selected target (JET_REQUIRE_NATIVE_TARGET=1); remove the target from the parity matrix or restore native support")
    } else {
        eprintln("note: native execution unsupported on this selected target; skipping native assertion")
        true
    }
}

// Rust: tests/jit_run.rs:1100
fn jet_string(value: &OSPath) -> String {
    value.to_string_lossy().replace('\\', "\\\\").replace('"', "\\\"")
}

// Rust: tests/jit_run.rs:1107
// GATE #4494: real executable discovery, child process and captured streams.
fn run_jet(file: &OSPath, release: Bool) -> Output {
    command := Command.new(common.jet_bin())
    command.arg("run")
    if release { command.arg("--release") }
    command.arg(file)
        .current_dir(file.parent().expect("Jet fixture has a project directory"))
        .env("NO_COLOR", "1")
        .env("JET_SPEC_REMOVE", "host-value")
        .output().expect("run ProcessSpec lens fixture")
}
