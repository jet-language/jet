// PORT-PENDING 1104 tests-jit-run-slice-1: tests/jit_run.rs:1-1796
// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! Tower #1253 and #1255 — the `ProcessSpec` builders stay in the JIT host
//RS //! table.
//RS //!
//RS //! `env_clear`, `detached`, and `terminal` had no entry in `lower_ctx` or in
//RS //! `safety::resident_safe_call_arg`, so default `jet run` deopted and tier 0
//RS //! then refused `process.cmd` with E0956. The program worked under `jet build`
//RS //! and failed under `jet run`, which is the lens gap D-LENS-RUN1 forbids.
//RS //!
//RS //! `env` and `env_remove` had the same missing entries, and `cwd` had a host
//RS //! shim that dropped its argument, so the child ran in the wrong directory and
//RS //! nothing reported it.
//RS 
//RS use std::fs;
//RS use std::io::Write;
//RS use std::path::Path;
//RS use std::process::{Command, Output, Stdio};
//RS 
//RS mod common;
//RS 
//RS use jet::Interpreter::dev_iteration;
//RS use jet_foundation::JitBackend::RunOutcome;
