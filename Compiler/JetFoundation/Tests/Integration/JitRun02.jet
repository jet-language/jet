use std.fs
use std.path.OSPath
use jet_foundation.Tests.Integration.Common as common
use jet
// Rust: tests/jit_run.rs:2674
fn assert_typed_fast_path_fixture(name: &String, source: &String, expected: &String) -> {
    assert_typed_fast_path_fixture_with_manifest(name, source, expected, Some("name: \"test-fixture\"\nversion: \"0.1.0\"\nauthority: { holds: { allow: [IO, Mem.Alloc] } }\n"))
}
// Rust: tests/jit_run.rs:2685
// Retired resident/interpreter representation assertions become actual O0/O1/O2/Web results.
// GATE #4494: disk-backed scratch, native compilation/subprocess and Web execution providers.
fn assert_typed_fast_path_fixture_with_manifest(name: &String, source: &String, expected: &String, manifest: String?) -> {
    dir :: common.unique_tmp(name)
    fs.create_dir_all(&dir).unwrap()
    if Some(value) = manifest { fs.write(dir.join("package.jet"), value).unwrap() }
    file :: dir.join("{name}.jet")
    fs.write(&file, source).unwrap()
    shown :: file.to_string_lossy().into_owned()
    bundle := jet.Loader.load_entry(&shown).unwrap_or_else(fn(error) { panic("{name} fixture should load: {error:?}") })
    diagnostics :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run)
    assert(diagnostics.iter().all(fn(diagnostic) { diagnostic.severity != jet.Diagnostics.Severity.Error }), "{name} fixture must type-check: {diagnostics:#?}")
    for tier in ["O0", "O1", "O2", "Web"] {
        output :: common.run_entry_tier(&file, tier)
        assert_eq(output.status.code(), Some(0), "{name} {tier} fixture failed: {String.from_utf8_lossy(&output.stderr)}")
        assert_eq(String.from_utf8_lossy(&output.stdout), expected, "{name} {tier} observable drifted")
        assert_eq(String.from_utf8_lossy(&output.stderr), "", "{name} {tier} stderr drifted")
    }
    _ :: fs.remove_dir_all(&dir)
}
