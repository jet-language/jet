// Rust: tests/fact_reads.rs:20
fn diagnostics(source: String) -> [Diagnostic] { compile(source).expect_err("the fixture must be rejected") }
// Rust: tests/fact_reads.rs:24
fn stdout(outcome: RunOutcome, tier: String) -> String {
    if outcome == {
        .Ran { stdout, stderr, exit_code } -> {
            assert(stderr.is_empty(), "{tier} stderr: {stderr}")
            assert_eq(exit_code, 0, "{tier} exit code")
            stdout
        }
        other -> panic("{tier} did not run: {other}")
    }
}
// Rust: tests/fact_reads.rs:39 — retired generated-Rust dispatch inspection is replaced by canonical tier behavior.
fn assert_fact_tiers(name: String, source: String, expected: String) -> {
    scratch :: common.Scratch.new(name)
    entry :: scratch.join("main.jet")
    fs.write(&entry, source).unwrap()
    for tier in ["O0", "O1", "O2", "Web"] {
        assert_eq(stdout(common.run_entry_tier(entry.to_str().unwrap(), tier, false), tier), expected, "folded fact result differs in {tier}")
    }
}
// Rust: tests/fact_reads.rs:43 — Web uses native Jet artifacts, never rustc or Rust source.
fn web_stdout(name: String, source: String, source_path: String) -> String? {
    if Command.new("node").arg("--version").output().is_err() { return None }
    scratch :: common.Scratch.new(name)
    output :: compile_web_with_path(source, source_path).unwrap_or_else(fn(diags) { panic("web fact fixture was rejected: {diags}") })
    _ :: output.web.expect("web fact fixture must produce web artifacts")
    entry :: scratch.join(OSPath.from(source_path).file_name().unwrap())
    fs.write(&entry, source).unwrap()
    Some(stdout(common.run_entry_tier(entry.to_str().unwrap(), "Web", false), "Web"))
}
