// Rust: tests/authority.rs:54
fn host_executable(name: String) -> String {
    // GATE #4494: native environment and executable paths.
    candidate :: env.split_paths(&env.var_os("PATH").expect("PATH should be set"))
        .map(fn(directory) { directory.join(name) }).find(fn(path) { path.is_file() })
        .and_then(fn(path) { fs.canonicalize(path).ok() })
        .unwrap_or_else(fn() { OSPath.from("/bin/{name}") })
    candidate.to_string_lossy().replace('\\', "\\\\").replace('"', "\\\"")
}

