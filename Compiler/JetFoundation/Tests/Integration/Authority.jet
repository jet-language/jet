// Rust: tests/authority.rs:197
fn write_plugin_component(scratch: &common.Scratch, name: String, wat_source: String) -> OSPath {
    bytes :: wat.parse_str(wat_source).unwrap_or_else(fn(error) { panic("hostile plugin WAT should parse: {error}") })
    path :: scratch.join(name)
    fs.write(&path, bytes).unwrap_or_else(fn(error) { panic("write hostile plugin fixture {path.display()}: {error}") })
    path
}

// Rust: tests/authority.rs:210
fn plugin_api_snapshot(package: String, export: String, params: String, result: String) -> String {
    "api_version = 1\npackage = plugin__{package}\npublished_version = 0.1.0\nfn {export}({params}) {result}\n"
}

// Rust: tests/authority.rs:221
fn large_argument_component_wat(count: USize) -> String { large_named_argument_component_wat("scale", count) }
// Rust: tests/authority.rs:225
fn large_zero_argument_component_wat(count: USize) -> String { large_named_argument_component_wat("zero", count) }
// Rust: tests/authority.rs:229
fn large_named_argument_component_wat(export: String, count: USize) -> String {
    params :: (0..<count).map(fn(_) { "i64" }).collect().join(" ")
    component_params :: (0..<count).map(fn(index) { "(param \"a{index}\" s64)" }).collect().join(" ")
    """(component
  (core module $m
    (func $__EXPORT__ (export "__EXPORT__") (param __PARAMS__) (result i64)
      (i64.const 7)))
  (core instance $i (instantiate $m))
  (type $t (func __COMPONENT_PARAMS__ (result s64)))
  (func $__EXPORT__ (type $t)
    (canon lift (core func $i "__EXPORT__")))
  (export "__EXPORT__" (func $__EXPORT__)))
""".replace("__EXPORT__", export).replace("__PARAMS__", params).replace("__COMPONENT_PARAMS__", component_params)
}

// Rust: tests/authority.rs:255
fn plugin_failure_source(path: &OSPath, export: String, failure_marker: String, success_marker: String) -> String {
    plugin_path :: path.to_string_lossy().replace('\\', "\\\\").replace('"', "\\\"")
    plugin_root :: path.parent().unwrap_or_else(fn() { OSPath.new(".") }).to_string_lossy().replace('\\', "\\\\").replace('"', "\\\"")
    """
use core.plugin as plugin
fn run() {
    policy :: Authority.from_rights(["FS.Read:__ROOT__"])
    hostile :: plugin.load("__PATH__", policy)
    _result :: hostile.__EXPORT__() ?? {
        print("__FAILURE__")
        print(err)
        return
    }
    print("__SUCCESS__")
    print(_result)
}
""".replace("__ROOT__", plugin_root).replace("__PATH__", plugin_path).replace("__EXPORT__", export).replace("__FAILURE__", failure_marker).replace("__SUCCESS__", success_marker)
}

// Rust: tests/authority.rs:295
fn assert_plugin_failure_result(tier: String, result: &(I32, String, String), failure_marker: String, required_error_terms: &[String]) -> Unit {
    (code, stdout, stderr) :: result
    assert_eq(code, 0, "{tier} plugin witness failed: {stderr}")
    assert_eq(stderr, "", "{tier} plugin witness wrote diagnostics")
    assert(stdout.starts_with("{failure_marker}\n"), "{tier} did not return the typed failure marker: {stdout}")
    assert(!stdout.contains("guest-returned"), "{tier} entered the success path: {stdout}")
    assert(stdout.len() <= 4096, "{tier} returned an unbounded plugin failure: {stdout.len()} bytes")
    assert(stdout.contains("trapped"), "{tier} did not reach a guest trap through the plugin call seam: {stdout}")
    assert(required_error_terms.is_empty() || required_error_terms.iter().any(fn(term) { stdout.to_ascii_lowercase().contains(term) }), "{tier} trap did not identify the expected resource guard: {stdout}")
}

// Rust: tests/authority.rs:330
const PLUGIN_CHILD_TEST_ENV: String = "JET_AUTHORITY_PLUGIN_RESOURCE_TEST"
// Rust: tests/authority.rs:331
const PLUGIN_CHILD_TIER_ENV: String = "JET_AUTHORITY_PLUGIN_RESOURCE_TIER"
// Rust: tests/authority.rs:332
const PLUGIN_CHILD_SOURCE_ENV: String = "JET_AUTHORITY_PLUGIN_RESOURCE_SOURCE"
// Rust: tests/authority.rs:333
const PLUGIN_CHILD_ARTIFACT_ENV: String = "JET_AUTHORITY_PLUGIN_RESOURCE_ARTIFACT"
// Rust: tests/authority.rs:334
const PLUGIN_CHILD_API_ENV: String = "JET_AUTHORITY_PLUGIN_RESOURCE_API"
// Rust: tests/authority.rs:335
const PLUGIN_CHILD_OK_MARKER: String = "JET_AUTHORITY_PLUGIN_RESOURCE_CHILD_OK"
// Rust: tests/authority.rs:336
const PLUGIN_CHILD_CAPTURE_LIMIT: USize = 16 * 1024

// Rust: tests/authority.rs:338
fn run_plugin_resource_child_if_selected(test_name: String) -> Bool {
    // GATE #4494: native environment.
    requested_test :: env.var(PLUGIN_CHILD_TEST_ENV) ?? return false
    if requested_test != test_name -> return false
    tier :: env.var(PLUGIN_CHILD_TIER_ENV).unwrap_or_else(fn(error) { panic("plugin child tier is required: {error}") })
    source :: env.var(PLUGIN_CHILD_SOURCE_ENV).unwrap_or_else(fn(error) { panic("plugin child source is required: {error}") })
    artifact :: OSPath.from(env.var(PLUGIN_CHILD_ARTIFACT_ENV).unwrap_or_else(fn(error) { panic("plugin child artifact is required: {error}") }))
    api :: env.var(PLUGIN_CHILD_API_ENV).unwrap_or_else(fn(error) { panic("plugin child API is required: {error}") })
    (failure_marker, required_error_terms): (String, [String]) :: if requested_test == {
        "plugin_call_stops_a_non_terminating_component_on_all_hosted_tiers" -> ("execution-bound-failure", ["fuel", "epoch", "interrupt"])
        "plugin_call_rejects_linear_memory_growth_beyond_the_cap_on_all_hosted_tiers" -> ("memory-bound-failure", [])
        "plugin_call_rejects_table_growth_beyond_the_cap_on_all_hosted_tiers" -> ("table-bound-failure", [])
        other -> panic("unknown plugin child test `{other}`")
    }
    result :: tir_support.run_plugin_tier("plugin_resource_child", &source, &tier, &artifact, &api)
    assert_plugin_failure_result("isolated {tier}", &result, failure_marker, &required_error_terms)
    print(PLUGIN_CHILD_OK_MARKER)
    true
}

// Rust: tests/authority.rs:385
fn bounded_plugin_capture(path: &OSPath) -> String {
    // GATE #4494: retained file descriptor read.
    file :: fs.File.open(path).unwrap_or_else(fn(error) { panic("open bounded plugin child capture: {error}") })
    bytes := [U8].with_capacity(PLUGIN_CHILD_CAPTURE_LIMIT + 1)
    file.take((PLUGIN_CHILD_CAPTURE_LIMIT + 1) as U64).read_to_end(&bytes).unwrap_or_else(fn(error) { panic("read bounded plugin child capture: {error}") })
    truncated :: bytes.len() > PLUGIN_CHILD_CAPTURE_LIMIT
    bytes.truncate(PLUGIN_CHILD_CAPTURE_LIMIT)
    if truncated {
        suffix :: "\n[output truncated]".as_bytes()
        start :: PLUGIN_CHILD_CAPTURE_LIMIT.saturating_sub(suffix.len())
        bytes[start..].copy_from_slice(&suffix[..<PLUGIN_CHILD_CAPTURE_LIMIT - start])
    }
    String.from_utf8_lossy(&bytes).into_owned()
}

// Rust: tests/authority.rs:405
#FFI(c)
fn kill(pid: I32, signal: I32) -> I32
// Rust: tests/authority.rs:403
fn kill_plugin_resource_process_group(pid: U32) -> Unit {
    if selected_family() == "unix" {
        // GATE #4494: POSIX signal ABI.
        if I32.try_from(pid) == {
            .Ok(native_pid) -> { #Unsafe("signal only the isolated plugin child's process group") { _ :: kill(-native_pid, 9) } }
            .Err(_) -> {}
        }
    }
}

// Rust: tests/authority.rs:412
fn run_plugin_resource_child(test_name: String, tier: String, source: String, artifact: &OSPath, api_snapshot: String) -> (Bool, String, String) {
    // GATE #4494: process spawn, group control, files and monotonic clock.
    stamp :: SystemTime.now().duration_since(UNIX_EPOCH).expect("system clock should be after the Unix epoch").as_nanos()
    prefix :: "jet_authority_plugin_resource_{std.process.id()}_{stamp}_{tier}"
    stdout_path :: env.temp_dir().join("{prefix}.stdout")
    stderr_path :: env.temp_dir().join("{prefix}.stderr")
    stdout_file :: fs.File.create(&stdout_path).unwrap_or_else(fn(error) { panic("create plugin child stdout capture: {error}") })
    stderr_file :: fs.File.create(&stderr_path).unwrap_or_else(fn(error) { panic("create plugin child stderr capture: {error}") })
    command := Command.new(env.current_exe().expect("authority test executable should be available"))
    command.args(["--exact", test_name, "--nocapture"])
        .env(PLUGIN_CHILD_TEST_ENV, test_name).env(PLUGIN_CHILD_TIER_ENV, tier)
        .env(PLUGIN_CHILD_SOURCE_ENV, source).env(PLUGIN_CHILD_ARTIFACT_ENV, artifact)
        .env(PLUGIN_CHILD_API_ENV, api_snapshot).stdout(Stdio.from(stdout_file)).stderr(Stdio.from(stderr_file))
    if selected_family() == "unix" -> command.process_group(0)
    child := command.spawn().unwrap_or_else(fn(error) { panic("spawn isolated plugin {tier} child: {error}") })
    timeout :: if tier == "release" -> Duration.from_secs(60) else -> Duration.from_secs(10)
    started :: Instant.now()
    loop {
        status :: child.try_wait().unwrap_or_else(fn(error) { panic("poll isolated plugin {tier} child: {error}") })
        if status == {
            .Some(status) -> {
                _ :: child.wait().unwrap_or_else(fn(error) { panic("reap isolated plugin {tier} child: {error}") })
                stdout :: bounded_plugin_capture(&stdout_path)
                stderr :: bounded_plugin_capture(&stderr_path)
                _ :: fs.remove_file(&stdout_path)
                _ :: fs.remove_file(&stderr_path)
                return (status.success(), stdout, stderr)
            }
            .None -> {
                if started.elapsed() >= timeout {
                    if selected_family() == "unix" -> kill_plugin_resource_process_group(child.id())
                    _ :: child.kill()
                    _ :: child.wait()
                    stdout :: bounded_plugin_capture(&stdout_path)
                    stderr :: bounded_plugin_capture(&stderr_path)
                    _ :: fs.remove_file(&stdout_path)
                    _ :: fs.remove_file(&stderr_path)
                    panic("isolated plugin {tier} child timed out after {timeout:?}\nstdout:\n{stdout}\nstderr:\n{stderr}")
                }
                thread.sleep(Duration.from_millis(10))
            }
        }
    }
}

// Rust: tests/authority.rs:494
fn assert_plugin_failure_on_all_hosted_tiers(test_name: String, source: String, failure_marker: String, artifact: &OSPath, api_snapshot: String) -> Unit {
    tiers := ["jit", "interpreter"]
    if common.have_rustc() -> tiers.push("release")
    else -> eprintln("note: skipping AOT plugin resource witness (need rustc)")
    loop tier in tiers {
        (success, stdout, stderr) :: run_plugin_resource_child(test_name, tier, source, artifact, api_snapshot)
        assert(success, "isolated plugin {tier} child failed for {failure_marker}\nstdout:\n{stdout}\nstderr:\n{stderr}")
        assert(stdout.contains(PLUGIN_CHILD_OK_MARKER), "isolated plugin {tier} child did not execute the selected test")
        assert(stdout.len() <= PLUGIN_CHILD_CAPTURE_LIMIT && stderr.len() <= PLUGIN_CHILD_CAPTURE_LIMIT, "isolated plugin {tier} child capture exceeded the bound")
    }
}

