// Rust: tests/authority.rs:1352
// Manifest-less scripts receive IO, Mem.Alloc, Exec.Args at the beginner floor.
const SCRIPT_AUTHORITY_DIR: String = "tests/fixtures/script_authority"
// Rust: tests/authority.rs:1354
fn script_run(tier: &[String], flags: &[String], fixture: String, args: &[String]) -> Output {
    // GATE #4494: native CLI subprocess.
    Command.new(env!("CARGO_BIN_EXE_jet")).arg("run").args(tier).args(flags)
        .arg("{SCRIPT_AUTHORITY_DIR}/{fixture}").args(args).current_dir(env!("CARGO_MANIFEST_DIR"))
        .env("NO_COLOR", "1").env("JET_RECEIPT_BYPASS", "1").stdin(Stdio.null()).output().expect("jet run must start")
}
