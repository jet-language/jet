const SCRIPT_TIERS: [[String]] = [[], ["--release"]]
// Rust: tests/authority.rs:1481
fn package_default_run(tier: &[String], path: String, args: &[String]) -> Output {
    // GATE #4494: native CLI subprocess.
    Command.new(env!("CARGO_BIN_EXE_jet")).arg("run").args(tier).arg(path).args(args)
        .current_dir(env!("CARGO_MANIFEST_DIR")).env("NO_COLOR", "1").env("JET_RECEIPT_BYPASS", "1")
        .stdin(Stdio.null()).output().expect("jet run must start")
}
