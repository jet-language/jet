// Rust: tests/fmt_wave_a.rs:50
fn semantic_identity(source: String) -> [UInt8] {
    (tokens, diagnostics) :: Lexer.lex(source)
    assert(diagnostics.is_empty(), "fixture should lex before identity comparison: {diagnostics:Debug}")
    program :: Parser.parse_for_fmt(&tokens).unwrap_or_else((diagnostics) -> panic("fixture should parse: {diagnostics:Debug}"))
    Formatter.canonical_program(&program)
}
// Rust: tests/fmt_wave_a.rs:145
const CLI_FIXTURE: String = WHITESPACE_AND_LITERALS
// Rust: tests/fmt_wave_a.rs:147
fn run_fmt(root: &OSPath, args: &[String]) -> Output {
    // GATE #4494: actual CLI subprocess.
    Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(args).current_dir(root).env("NO_COLOR", "1").output().unwrap_or_else((error) -> panic("run jet fmt {args:Debug}: {error}"))
}
