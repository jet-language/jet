// Rust: tests/allocator_families.rs:528
#Test("allocator_handles_are_thread_confined") {
    src :: """
use core.mem
fn run() {
    arena :: mem.Arena.new()
    handle :: task {
        value :: arena.alloc(1)
        print(value)
    }
    handle.join() ?? panic("task failed")
}
"""
    diags :: compile_jet(src).expect_err("allocators must not cross task boundaries")
    assert(diags.iter().any(fn(code) { code == "E1102" }), "{diags:?}")
}
// Rust: tests/allocator_families.rs:545
#Test("pool_ids_reuse_slots_without_reviving_stale_generations") {
    if !common.have_rustc() { return }
    src :: """
struct Item { value: Int }
fn run() {
    pool := Pool<Item>.new()
    first :: pool.add(Item{ value: 10 })
    stale :: first
    removed :: pool.remove(first)
    second :: pool.add(Item{ value: 20 })
    if removed == Val(item) { print(item.value) } else { print(-1) }
    print(stale == second)
    print(pool[second].value)
}
"""
    (code, stdout, stderr) :: run_jet("pool_generation", src)
    assert_eq(code, 0, "{stderr}")
    assert_eq(stdout, "10\nfalse\n20\n")
}
// Rust: tests/allocator_families.rs:573
#Test("stale_pool_id_panics_instead_of_reading_reused_slot") {
    if !common.have_rustc() { return }
    src :: """
struct Item { value: Int }
fn run() {
    pool := Pool<Item>.new()
    first :: pool.add(Item{ value: 10 })
    stale :: first
    _removed :: pool.remove(first)
    _second :: pool.add(Item{ value: 20 })
    print(pool[stale].value)
}
"""
    (code, _stdout, stderr) :: run_jet("pool_stale", src)
    assert_eq(code, 70, "{stderr}")
    assert(stderr.contains("no longer refers to a live value"), "{stderr}")
}
// Rust: tests/allocator_families.rs:598
#Test("default_dev_runs_allocator_constructors_natively") {
    if !common.have_rustc() { return }
    src :: """
use core.mem
fn run() {
    arena :: mem.Arena.new(capacity: 32)
    a :: arena.alloc(1)
    print(a)
    &arena.reset()
    again :: arena.alloc(2)
    print(again)
    bump :: mem.Bump.new(capacity: 32)
    b :: bump.alloc(3)
    print(b)
    pool :: mem.Pool.new(slots: 2)
    p :: pool.alloc(4)
    print(p)
    fixed :: mem.Fixed.new(size: 128)
    f :: fixed.alloc(5)
    print(f)
}
"""
    root :: temp_dir("dev")
    fs.create_dir_all(&root).unwrap()
    path :: root.join("main.jet")
    fs.write(&path, src).unwrap()
    bundle := Loader.load_entry(path.to_str().unwrap()).unwrap()
    errors :: Sema.check_bundle(&bundle, Sema.CompileMode.Run).into_iter().filter(fn(d) { d.severity == Diagnostics.Severity.Error }).collect()
    assert(errors.is_empty(), "{errors:?}")
    // Retired resident-JIT/deopt representation assertions become native tier behavior.
    tir_support.assert_tiers_agree("allocator_constructors", src, "1\n2\n3\n4\n5\n")
    (code, stdout, _) :: run_jet("pool_generation", src)
    assert_eq(code, 0)
    assert_eq(stdout, "1\n2\n3\n4\n5\n")
}
// Rust: tests/allocator_families.rs:665
#Test("try_allocation_example_reports_exhaustion_as_a_value") {
    src :: fs.read_to_string("Examples/features/memory/try_allocation.jet").unwrap()
    expected :: fs.read_to_string("Examples/features/expected/memory/try_allocation.out").unwrap()
    if common.have_rustc() {
        (code, stdout, stderr) :: run_jet("try_allocation", src)
        assert_eq(code, 0, "{stderr}")
        assert_eq(stdout, expected)
        dir :: temp_dir("try_allocation_dev")
        fs.create_dir_all(&dir).unwrap()
        path :: dir.join("main.jet")
        fs.write(&path, src).unwrap()
        tir_support.assert_tiers_agree("try_allocation_dev", src, expected)
        _ :: fs.remove_dir_all(&dir)
    } else {
        _ :: compile_jet(src).expect("try allocation example should pass the front end")
    }
}
// Rust: tests/allocator_families.rs:706
#Test("fault_scheduler_reaches_allocator_try_alloc") {
    if !common.have_rustc() { return }
    ran :: compile_rust_harness("""
fn main() {
    let (result, injected, counts) = jet_fault_run_once(
        &["FS.Write"], Some(1), 1, &mut || {
            let mut bytes = [0u8; 64];
            let fixed = jet_mem::JetFixed::over(&mut bytes);
            match fixed.try_alloc(7u64) {
                Ok(_) => Err("allocator fault was not injected".to_string()),
                Err(_) => Ok(()),
            }
        },
    ).unwrap();
    assert!(result.is_ok());
    assert!(injected);
    assert_eq!(counts[1], 1);
    println!("ok");
}
""")
    assert(ran.status.success(), "{String.from_utf8_lossy(&ran.stderr)}")
    assert_eq(String.from_utf8_lossy(&ran.stdout), "ok\n")
}
// Rust: tests/allocator_families.rs:743
#Test("program_allocator_fact_selects_counting_wrapper_for_aot") {
    entry :: write_program_allocator_project("program_allocator_counting", Val("mem.Counting.over(mem.Heap, cap: 2.kb)"))
    bundle := Loader.load_entry(entry.to_str().unwrap()).unwrap()
    assert(bundle.program_allocator == TargetMachine.AllocatorPolicy.Counting { cap: Val(TargetMachine.ByteSize { bytes: 2048 }) })
    errors :: Sema.check_bundle(&bundle, Sema.CompileMode.Run).into_iter().filter(fn(diagnostic) { diagnostic.severity == Diagnostics.Severity.Error }).collect()
    assert(errors.is_empty(), "{errors:?}")
    rust :: emit_native_aot(&bundle)
    assert(rust.contains("static __JET_PROGRAM_ALLOCATOR: JetProgramAllocator = JetProgramAllocator::counting(2048)"))
}
// Rust: tests/allocator_families.rs:767
#Test("missing_program_allocator_keeps_hidden_system_heap") {
    entry :: write_program_allocator_project("program_allocator_default", nil)
    bundle := Loader.load_entry(entry.to_str().unwrap()).unwrap()
    assert_eq(bundle.program_allocator, TargetMachine.AllocatorPolicy.HostedDefault)
    errors :: Sema.check_bundle(&bundle, Sema.CompileMode.Run).into_iter().filter(fn(diagnostic) { diagnostic.severity == Diagnostics.Severity.Error }).collect()
    assert(errors.is_empty(), "{errors:?}")
    rust :: emit_native_aot(&bundle)
    assert(!rust.contains("__JET_PROGRAM_ALLOCATOR"))
}
// Rust: tests/allocator_families.rs:784
#Test("invalid_program_allocator_fact_is_a_teaching_diagnostic") {
    entry :: write_program_allocator_project("program_allocator_invalid", Val("mem.Mystery"))
    diagnostics :: Loader.load_entry(entry.to_str().unwrap()).unwrap_err()
    diagnostic :: diagnostics.iter().find(fn(diagnostic) { diagnostic.code == "E1206" }).expect("invalid allocator fact must use the registered manifest diagnostic")
    assert_eq(diagnostic.what, "Invalid hosted program allocator")
    assert(diagnostic.fix.contains("mem.Counting.over"))
}
// Rust: tests/allocator_families.rs:796
#Test("program_allocator_kernel_caps_fallible_allocations") {
    if !common.have_rustc() { return }
    ran :: compile_program_allocator_harness("""
use std::alloc::{GlobalAlloc, Layout};
fn main() {
    let allocator = allocator::JetProgramAllocator::counting(64);
    let first_layout = Layout::from_size_align(48, 16).unwrap();
    let second_layout = Layout::from_size_align(32, 16).unwrap();
    let first = unsafe { GlobalAlloc::alloc(&allocator, first_layout) };
    assert!(!first.is_null());
    let exhausted = unsafe { GlobalAlloc::alloc(&allocator, second_layout) };
    assert!(exhausted.is_null());
    let facts = allocator.facts();
    assert_eq!(facts.allocations, 1);
    assert_eq!(facts.requested_bytes, 48);
    assert_eq!(facts.live_bytes, 48);
    assert_eq!(facts.high_water_bytes, 48);
    unsafe { GlobalAlloc::dealloc(&allocator, first, first_layout) };
    assert_eq!(allocator.facts().live_bytes, 0);
    println!("ok");
}
""")
    assert(ran.status.success(), "{String.from_utf8_lossy(&ran.stderr)}")
    assert_eq(String.from_utf8_lossy(&ran.stdout), "ok\n")
}
