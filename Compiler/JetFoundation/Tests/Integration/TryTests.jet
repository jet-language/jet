// Rust: tests/typestate.rs:325
#Test("generic_struct_state_set_is_shared_by_separate_impl") {
    source :: """
struct Box<T> {
    state { Empty, Full }
    value: T
}
impl Box {
    #Transition(_, Empty) fn new(value: ^T) -[]> Box<T> { return Box<T>{ value: value } }
    #Transition(Empty, Full) fn fill(self: ^Box<T>) -[]> Box<T> { return self }
}
impl Box { #State(Full) fn read(self) -[]> T { return self.value } }
fn run() -> {
    box := Box<Int>.new(1)
    box = box.fill()
    print(box.read())
}
"""
    compiled :: compiler.compile(source).unwrap_or_else(fn(diags) { panic("{diags:?}") })
    assert(!compiled.rust.contains("Empty"), "state labels must erase")
    assert(!compiled.rust.contains("Full"), "state labels must erase")
    assert(!compiled.rust.contains("discriminant"), "typestate must not add a tag")
    wrong_order :: source.replace("    box = box.fill()\n", "")
    assert(codes(wrong_order).contains("E0150"), "the shared generic state set must guard methods from a separate impl: {codes(wrong_order):?}")
}
// Rust: tests/typestate.rs:369
#Test("typestate_graph_is_folded_before_aot_jit_and_interpreter") {
    assert(tir_support.have_rustc(), "AOT proof needs rustc")
    tir_support.assert_tiers_agree("typestate_graph_tiers", TIER_SOURCE, TIER_EXPECTED)
    output :: compiler.compile(TIER_SOURCE).expect("typestate tier fixture must compile")
    loop label in ["Queued", "Approved", "Settled", "Settlement.State"] {
        assert(!output.rust.contains(label), "typestate fact `{label}` reached generated runtime Rust")
    }
}
// Rust: tests/typestate.rs:382
#Test("typestate_graph_runs_on_resident_jit_without_runtime_state") {
    // Retired resident engine traces become actual O0/O1/O2/Web behavior.
    scratch :: common.Scratch.new("typestate-jit")
    path :: scratch.join("main.jet")
    fs.write(path, TIER_SOURCE).unwrap()
    shown :: path.to_string_lossy().to_string()
    bundle := Loader.load_entry(shown).expect("typestate fixture loads")
    found :: Sema.check_bundle(&bundle, Sema.CompileMode.Run)
    assert(found.is_empty(), "typestate fixture diagnostics: {found:?}")
    tir_support.assert_tiers_agree("typestate_graph_native_no_runtime_state", TIER_SOURCE, TIER_EXPECTED)
}
// Rust: tests/typestate.rs:422
#Test("typestate_graph_reaches_web_without_runtime_state") {
    scratch :: common.Scratch.new("typestate-web")
    path :: scratch.join("main.jet")
    fs.write(path, TIER_SOURCE).unwrap()
    shown :: path.to_string_lossy().to_string()
    output :: compiler.compile_web_with_path(TIER_SOURCE, shown).unwrap_or_else(fn(diags) {
        panic("web typestate fixture rejected:\n{compiler.render_diagnostics(shown, TIER_SOURCE, diags)}")
    })
    web :: output.web.expect("web typestate fixture must produce artifacts")
    loop label in ["Queued", "Approved", "Settled", "Settlement.State"] {
        assert(!web.wasm_rust.contains(label), "typestate fact `{label}` reached web runtime Rust")
    }
    fs.write(scratch.join("app.js"), web.js_app).unwrap()
    fs.write(scratch.join("jet_dom_runtime.js"), web.dom_runtime).unwrap()
    fs.write(scratch.join("package.json"), "{{\"type\":\"module\"}}").unwrap()
    node :: Command.new("node").current_dir(scratch.path).arg("app.js").output().expect("spawn node")
    assert(node.status.success(), "web typestate fixture failed:\nstdout: {String.from_utf8_lossy(node.stdout)}\nstderr: {String.from_utf8_lossy(node.stderr)}")
    assert_eq(String.from_utf8_lossy(node.stdout), TIER_EXPECTED)
}
// Rust: tests/typestate.rs:461
