    #State(Door.State.Closed) fn inspect(self: ^Door) -[]> String {
        next := self.open()
        return "closed"
    }
}
fn run() -> {}
"""
    found :: codes(src)
    assert(found.is_empty(), "qualified markers must resolve to leaves: {found:?}")
}
