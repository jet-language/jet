    src :: "{DECL}\nfn run() -> {{\n  r := Reservation.book(\"a\")\n  r = r.pay()\n  r = r.check_in()\n  print(r.room_key())\n}}\n"
    assert(codes(src).is_empty(), "a terminal state must compile: {codes(src):?}")
