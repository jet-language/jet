// Rust: tests/typestate.rs:584
#Test("divergent_branch_states_are_reported") {
    src :: "{DIVERGENT}\nfn decide(paid: Bool) -> {{\n  order := Order.start(1)\n  if {{\n    paid -> order = order.confirm()\n    else -> order = order.cancel()\n  }}\n  print(order.id)\n}}\nfn run() -> {{ decide(true) }}\n"
    assert(lint_codes(src).contains("L0152"), "a state-divergent branch must be reported: {lint_codes(src):?}")
}
// Rust: tests/typestate.rs:596
#Test("divergent_branch_does_not_keep_the_last_walked_arm") {
    src :: "{DIVERGENT}\nfn decide(paid: Bool) -> {{\n  order := Order.start(1)\n  if {{\n    paid -> order = order.confirm()\n    else -> order = order.cancel()\n  }}\n  print(order.ship())\n}}\nfn run() -> {{ decide(true) }}\n"
    assert(!codes(src).contains("E0150"), "the last-walked arm must not decide the state: {codes(src):?}")
    assert(lint_codes(src).contains("L0152"), "the divergence is reported instead: {lint_codes(src):?}")
}
// Rust: tests/typestate.rs:616
#Test("agreeing_branches_keep_the_state") {
    src :: "{DIVERGENT}\nfn decide(paid: Bool) -> {{\n  order := Order.start(1)\n  if {{\n    paid -> order = order.confirm()\n    else -> order = order.confirm()\n  }}\n  print(order.ship())\n}}\nfn run() -> {{ decide(true) }}\n"
    assert(codes(src).is_empty(), "both paths reach `Confirmed`, so `ship` is in state: {codes(src):?}")
    assert(!lint_codes(src).contains("L0152"), "agreeing paths are not a divergence: {lint_codes(src):?}")
}
// Rust: tests/typestate.rs:636
#Test("agreeing_switch_arms_over_an_exhaustive_enum_keep_the_state") {
    src :: "{DIVERGENT}\nenum Mode {{ Fast Slow }}\nfn decide(m: Mode) -> {{\n  order := Order.start(1)\n  if m == {{\n    .Fast -> order = order.confirm()\n    .Slow -> order = order.confirm()\n  }}\n  print(order.ship())\n}}\nfn run() -> {{ decide(Mode.Fast) }}\n"
    assert(codes(src).is_empty(), "both arms of an exhaustive dispatch reach `Confirmed`, so `ship` is in state: {codes(src):?}")
    assert(!lint_codes(src).contains("L0152"), "an exhaustive pattern table has no fall-through path to diverge from: {lint_codes(src):?}")
}
// Rust: tests/typestate.rs:656
#Test("counted_loop_zero_iterations_reports_the_pre_loop_divergence") {
    src :: "{DIVERGENT}\nfn decide(n: Int) -> {{\n  order := Order.start(1)\n  loop i := 0, i < n {{\n    fresh := Order.start(2)\n    order = fresh.confirm()\n  }}\n  print(order.ship())\n}}\nfn run() -> {{ decide(1) }}\n"
    assert(lint_codes(src).contains("L0152"), "the loop may run zero times, so `Draft` (skipped) and `Confirmed` (ran) must be reported as diverging: {lint_codes(src):?}")
}
