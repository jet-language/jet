// Rust: tests/typestate.rs:232
#Test("state_section_shape_diagnostics_are_distinct") {
    empty :: codes("struct Empty {{ state {{}} }}\nfn run() -> {{}}\n")
    assert(empty.contains("E0169"), "{empty:?}")
    duplicate_section :: codes("struct Door {{ state {{ Ready }} state {{ Open }} }}\nfn run() -> {{}}\n")
    assert(duplicate_section.contains("E0168"), "{duplicate_section:?}")
    duplicate_name :: codes("struct Door {{ state {{ Ready, Ready }} }}\nfn run() -> {{}}\n")
    assert(duplicate_name.contains("E0166"), "{duplicate_name:?}")
    member_collision :: codes("struct Door {{ state {{ open }} open: Bool }}\nfn run() -> {{}}\n")
    assert(member_collision.contains("E0167"), "{member_collision:?}")
    missing_owner :: codes("struct Door {{ opened: Bool }}\nimpl Door {{ #State(Ready) fn open(self) -> {{}} }}\nfn run() -> {{}}\n")
    assert(missing_owner.contains("E0159"), "{missing_owner:?}")
}
// Rust: tests/typestate.rs:264
#Test("state_section_sema_diagnostic_spans_cover_the_section") {
    empty :: "struct Empty {{ state {{}} }}\nfn run() -> {{}}\n"
    empty_start :: empty.find("state {{").unwrap()
    empty_end :: empty_start + empty[empty_start..].find("}").unwrap() + 1
    empty_diagnostic :: diagnostics(empty).find(fn(diagnostic) { diagnostic.code == "E0169" }).expect("E0169")
    assert_eq(empty_diagnostic.span, Val(Span.new(empty_start, empty_end)))
    repeated :: "struct Door {{ state {{ Ready }} state {{ Open }} }}\nfn run() -> {{}}\n"
    repeated_start :: repeated.rfind("state {{").unwrap()
    repeated_end :: repeated_start + repeated[repeated_start..].find("}").unwrap() + 1
    repeated_diagnostic :: diagnostics(repeated).find(fn(diagnostic) { diagnostic.code == "E0168" }).expect("E0168")
    assert_eq(repeated_diagnostic.span, Val(Span.new(repeated_start, repeated_end)))
}
// Rust: tests/typestate.rs:291
#Test("qualified_state_markers_seed_leaf_states") {
