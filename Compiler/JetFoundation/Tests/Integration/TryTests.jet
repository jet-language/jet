// Rust: tests/typestate.rs:479
#Test("self_loop_and_reopen_states_are_nonterminal") {
    src :: """
struct Gate { state { Closed, Reopened }; w: Int }
impl Gate {
    #Transition(_, Closed) fn new(w: Int) -[]> Gate { return Gate{ w: w } }
    #Transition(Closed, Closed) fn hold(self: ^Gate) -[]> Gate { return self }
    #Transition(Closed, Reopened) fn reopen(self: ^Gate) -[]> Gate { return self }
}
fn run() -> {
    g := Gate.new(1)
    g = g.hold()
    g = g.reopen()
}
"""
    assert(codes(src).is_empty(), "no errors expected: {codes(src):?}")
    lints :: lint_codes(src)
    assert(lints.all(fn(code) { code != "L0153" }), "self-loop and reopen must not be unreachable: {lints:?}")
}
