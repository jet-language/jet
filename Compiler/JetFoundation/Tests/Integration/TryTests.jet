// Rust: tests/try.rs:49
#Test("default_try_rechecks_overlay_then_rolls_back_byte_for_byte") {
    (dir, plan, before, _) :: fixture("rollback", "two")
    output :: Command.new(jet()).arg("try").arg(plan).output().unwrap()
    assert(output.status.success(), "stdout: {String.from_utf8_lossy(output.stdout)}\nstderr: {String.from_utf8_lossy(output.stderr)}")
    stdout :: String.from_utf8_lossy(output.stdout)
    assert(stdout.contains("claims re-checked"), "{stdout}")
    assert(stdout.contains("claims reused"), "{stdout}")
    assert(stdout.contains("rolled back (default)"), "{stdout}")
    assert_eq(fs.read(dir.join("examples/main.jet")).unwrap(), before)
    assert(!dir.join(".jet").exists(), "default try must not create a transaction directory")
    _ :: fs.remove_dir_all(dir)
}
// Rust: tests/try.rs:71
#Test("keep_lands_the_same_bytes_as_the_staged_edit") {
    (dir, plan, _, after) :: fixture("keep", "two")
    output :: Command.new(jet()).args(["try", plan.to_str().unwrap(), "--keep"]).output().unwrap()
    assert(output.status.success(), "stdout: {String.from_utf8_lossy(output.stdout)}\nstderr: {String.from_utf8_lossy(output.stderr)}")
    assert(String.from_utf8_lossy(output.stdout).contains("kept"), "{String.from_utf8_lossy(output.stdout)}")
    assert_eq(fs.read(dir.join("examples/main.jet")).unwrap(), after)
    assert(dir.join(".jet/codemods").is_dir())
    _ :: fs.remove_dir_all(dir)
}
// Rust: tests/try.rs:94
#Test("failed_verdict_rolls_back_without_keep") {
    (dir, plan, before, _) :: fixture("failed", "one")
    start :: before.windows(3).position(fn(window) { window == "one".bytes() }).unwrap()
    // One extra quote makes the candidate invalid without corrupting the JSON plan.
    fs.write(plan, "{{\"name\":\"failed\",\"entry\":\"examples/main.jet\",\"edits\":[{{\"path\":\"examples/main.jet\",\"start\":{start},\"end\":{start + 3},\"new_text\":\"one\\\"\"}}]}}\n").unwrap()
    output :: Command.new(jet()).arg("try").arg(plan).output().unwrap()
    assert(!output.status.success())
    assert(String.from_utf8_lossy(output.stderr).contains("verdict failed"), "{String.from_utf8_lossy(output.stderr)}")
    assert_eq(fs.read(dir.join("examples/main.jet")).unwrap(), before)
    _ :: fs.remove_dir_all(dir)
}
// Rust: tests/type_sentinel_guard.rs:63
#Test("defer_close_string_sentinel_stays_retired") {
    manifest :: OSPath.from(env.build_var("CARGO_MANIFEST_DIR"))
    sentinel :: ["\\0jet", ".defer.close"].concat()
    stack := [manifest.join("Source"), manifest.join("crates")]
    loop !stack.is_empty() {
        path :: &stack.pop() ?? break
        if path.is_dir() {
            loop entry in fs.read_dir(path).unwrap().flatten() { &stack.push(entry.path()) }
            continue
        }
        if path.extension().and_then(fn(ext) { ext.to_str() }) != Val("rs") { continue }
        text :: fs.read_to_string(path).unwrap()
        assert(!text.contains(sentinel), "{path.display()}: defer-close string sentinel must stay retired; use Stmt::DeferClose")
    }
}
// Rust: tests/type_sentinel_guard.rs:108
#Test("nul_prefixed_type_sentinels_stay_on_the_allowlist") {
    offenders := [String]{}
    survivors_seen := 0
    loop path in foundation_sources() {
        loop hit in scan(path) {
            marker :: hit.splitn(3, ": \\0").nth(1).map(fn(value) { "\\0{value}" })
            allowed :: marker.is_some_and(fn(value) { ALLOWED_SENTINELS.any(fn(prefix) { value.starts_with(prefix) }) })
            if allowed { survivors_seen += 1 } else { &offenders.push(hit) }
        }
    }
    assert(offenders.is_empty(), "new \\0-prefixed compiler sentinel(s) outside the card #1662 allowlist (add a real typed field/variant instead, per D-FACT-HOME1):\n{offenders.join("\n")}")
    assert(survivors_seen == 0, "allowlisted sentinel remains after the final sentinel retirement")
}
// Rust: tests/type_sentinel_guard.rs:137
#Test("approx_and_quantity_sentinels_are_retired") {
    loop path in foundation_sources() {
        // Comments recording a retired name do not reintroduce it.
        text :: fs.read_to_string(path).unwrap().lines().filter(fn(line) { !line.trim_start().starts_with("//") }).join("\n")
        shown :: path.display()
        assert(!text.contains("APPROX_NUMERIC_WIDEN_MARKER"), "{shown}: APPROX_NUMERIC_WIDEN_MARKER must stay retired (card #1662) — use Call::widen_approx")
        assert(!text.contains("\\0Quantity"), "{shown}: the \\0Quantity string encoding must stay retired (card #1662) — use Type::Quantity")
        assert(!text.contains("CHECKED_NUMERIC_WIDEN_MARKER"), "{shown}: CHECKED_NUMERIC_WIDEN_MARKER must stay retired (card #1662) — use Expr::MethodCall::checked_widen")
        assert(!text.contains("COMPUTE_DIMENSION_PREFIX"), "{shown}: COMPUTE_DIMENSION_PREFIX must stay retired (card #1662) — use Type::ComputeDim(u64)")
        loop retired_marker_const in ["CORE_CRYPTO_NOMINAL_MARKER", "DETERMINISTIC_CLOCK_MARKER", "SYSTEM_CLOCK_MARKER", "EXPIRING_SECRET_LOAN_MARKER", "SHARED_GUARD_READ_MARKER", "SHARED_GUARD_EDIT_MARKER", "TERMINAL_FACT_SET_MARKER", "CPP_CALLBACK_ABI_MARKER"] {
            assert(!text.contains(retired_marker_const), "{shown}: {retired_marker_const} must stay retired (card #1662) — use Type::Tagged with TagMarker::Internal(InternalTag)")
        }
    }
}
