// D-ONCE-LAW1 / D-ONCE-TIER1: promises require one mechanical grade.
use core.fs as fs
use std.env as env
use std.mem as mem

// Rust: tests/parity_lint.rs:18
pub const SCANNED_ROOTS: [String] = ["crates", "Source", "tests"]
// Rust: tests/parity_lint.rs:19
pub const THIS_TEST: String = "tests/parity_lint.rs"
// Rust: tests/parity_lint.rs:20
pub const CROSS_TIER_WORDS: [String] = ["aot", "comptime", "interpreter", "jit", "tier", "r12", "decode path", "ffi bridge", "wire format", "jet_std"]
// Rust: tests/parity_lint.rs:34
pub struct Site {
    path: String
    line: USize
    grade: String
}
// Rust: tests/parity_lint.rs:40
pub fn root() -> OSPath { OSPath.from(env.manifest_dir()) }
// Rust: tests/parity_lint.rs:44
pub fn collect_source_files(dir: OSPath, out: &[OSPath]) -> {
    entries :: match fs.read_dir(dir) { Ok(value) -> value, Err(_) -> { return } }
    loop entry in entries.flatten() {
        path :: entry.path()
        if path.is_dir() {
            collect_source_files(path, &out)
        } else if path.extension().is_some_and((extension) -> extension == "rs" || extension == "jet") {
            out.push(path)
        }
    }
}
// Rust: tests/parity_lint.rs:61
pub fn source_files(repo_root: OSPath) -> [OSPath] {
    files := []
    loop directory in SCANNED_ROOTS { collect_source_files(repo_root.join(directory), &files) }
    files.sort()
    ^files
}
// Rust: tests/parity_lint.rs:70
pub fn relative_path(repo_root: OSPath, path: OSPath) -> String {
    path.strip_prefix(repo_root).unwrap_or(path).to_string_lossy().replace("\\", "/")
}
// Rust: tests/parity_lint.rs:77
pub fn line_comment_start(line: String) -> USize? {
    bytes :: line.as_bytes()
    in_string := false
    index := 0
    loop while index + 1 < bytes.len() {
        match bytes[index] {
            34 -> in_string = !in_string
            92 if in_string -> { index += 2; continue }
            47 if !in_string && bytes[index + 1] == 47 -> { return Val(index) }
            _ -> {}
        }
        index += 1
    }
    None
}
// Rust: tests/parity_lint.rs:96
pub fn comment_blocks(source: String) -> [(USize, String)] {
    blocks := []
    current_start: USize? := None
    current := ""
    finish :: (blocks: &[(USize, String)], start: &USize?, text: &String) -> {
        if start.take() is Val(line) { blocks.push((line, mem.take(&text))) }
    }
    loop (index, line) in source.lines().enumerate() {
        comment_start :: match line_comment_start(line) {
            Val(value) -> value
            None -> { finish(&blocks, &current_start, &current); continue }
        }
        if current_start.is_none() { current_start = Val(index + 1) }
        if !current.is_empty() { current.push('\n') }
        trimmed := line[comment_start + 2..].trim() // #4303
        current.push_str(trimmed)
    }
    finish(&blocks, &current_start, &current)
    ^blocks
}
// Rust: tests/parity_lint.rs:125
pub fn is_parity_promise(comment: String) -> Bool {
    lower :: comment.to_ascii_lowercase()
    if lower.contains("matches aot") || lower.contains("mirrors aot") { return true }
    lower.contains("byte-for-byte") && CROSS_TIER_WORDS.iter().any((word) -> lower.contains(word))
}
// Rust: tests/parity_lint.rs:133
pub fn parity_annotations(comment: String) -> [String] {
    comment.lines().filter_map((line) -> {
        lower :: line.to_ascii_lowercase()
        start :: lower.find("parity:")? + "parity:".len()
        trimmed := line[start..].trim() // #4303
        Val(trimmed.to_string())
    }).collect()
}
// Rust: tests/parity_lint.rs:144
pub fn code_without_line_comments(source: String) -> String {
    source.lines().map((line) -> line_comment_start(line).map_or(line, (comment_start) -> line[..comment_start])).collect().join("\n")
}
// Rust: tests/parity_lint.rs:152
pub fn include_mentions(source: String, target: String) -> Bool {
    suffix :: target.strip_prefix("crates/").unwrap_or(target)
    code :: code_without_line_comments(source)
    (code.contains(target) || code.contains(suffix)) && (code.contains("include!(") || code.contains("include_str!("))
}
// Rust: tests/parity_lint.rs:159
pub fn is_engine_gap(path: String) -> Bool {
    path.contains("crates/jet-jit/") || path.contains("crates/jet-codegen/src/Codegen/TIR/eval/")
}
// Rust: tests/parity_lint.rs:163
pub fn valid_card_number(token: String) -> Bool {
    number :: match token.strip_prefix("card=#") { Val(value) -> value, None -> { return false } }
    !number.is_empty() && number.chars().all((character) -> character.is_ascii_digit())
}
// Rust: tests/parity_lint.rs:170
pub fn validate_grade(repo_root: OSPath, path: String, source: String, comment: String) -> String Err! {
    annotations :: parity_annotations(comment)
    if annotations.len() != 1 { return Err("expected exactly one `parity:` grade, found {annotations.len()}") }
    annotation := annotations[0].trim() // #4303
    if annotation.strip_prefix("include path=") is Val(raw_target) {
        target := raw_target.trim() // #4303
        if target.is_empty() { return Err("the include grade has no canonical source path") }
        if !repo_root.join(target).is_file() { return Err("the include target does not exist: {target}") }
        if !include_mentions(source, target) { return Err("the source does not include the canonical source named by the grade: {target}") }
        return Ok("include {target}")
    }
    if annotation.strip_prefix("marshal symbol=") is Val(raw_symbol) {
        symbol := raw_symbol.trim() // #4303
        if symbol.is_empty() || symbol.chars().any((c) -> c.is_whitespace()) { return Err("the marshal grade must name one symbol") }
        if !code_without_line_comments(source).contains(symbol) { return Err("the shared marshalling symbol is not called: {symbol}") }
        return Ok("marshal {symbol}")
    }
    if annotation.strip_prefix("guard ") is Val(target) {
        trimmed := target.trim() // #4303
        (test_path, raw_function) :: match trimmed.split_once("::") {
            Val(pair) -> pair
            None -> { return Err("the guard grade must be `guard tests/file.rs::function`") }
        }
        if !test_path.starts_with("tests/") { return Err("the guard grade must point to a test file") }
        function := raw_function.trim() // #4303
        if function.is_empty() { return Err("the guard grade names no test function") }
        guard_path :: repo_root.join(test_path)
        guard_source :: fs.read_to_string(guard_path).map_err((error) -> "cannot read guard {test_path}: {error}")?
        if !guard_source.contains("fn {function}") { return Err("guard function does not exist: {test_path}::{function}") }
        if !guard_source.contains("assert") { return Err("guard has no behavior assertion: {test_path}::{function}") }
        return Ok("guard {test_path}::{function}")
    }
    if annotation.strip_prefix("gap ") is Val(rest) {
        fields := rest.splitn(2, " risk=")
        card := fields.next().unwrap_or_default().trim() // #4303
        risk := fields.next().unwrap_or_default().trim() // #4303
        if !valid_card_number(card) || risk.is_empty() { return Err("the gap grade must be `gap card=#N risk=<reason>`") }
        if is_engine_gap(path) { return Err("jet-jit and TIR eval parity promises require include, marshal, or guard; gaps are not allowed") }
        return Ok("gap {card}")
    }
    Err("unknown parity grade: {annotation}")
}
// Rust: tests/parity_lint.rs:260
pub fn scan(repo_root: OSPath) -> ([Site], [String]) {
    sites := []
    errors := []
    loop path in source_files(repo_root) {
        relative :: relative_path(repo_root, path)
        if relative == THIS_TEST { continue }
        source :: match fs.read_to_string(path) { Ok(value) -> value, Err(_) -> { continue } }
        loop (line, comment) in comment_blocks(source) {
            if !is_parity_promise(comment) { continue }
            match validate_grade(repo_root, relative, source, comment) {
                Ok(grade) -> sites.push(Site.{path: relative.clone(), line: line, grade: grade})
                Err(error) -> errors.push("{relative}:{line}: {error}")
            }
        }
    }
    (^sites, ^errors)
}
