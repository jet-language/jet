// Rust: tests/web_build.rs:692
// Independent clamped smoothstep oracle for tween(40, 95, elapsed_ms, 600).
pub fn expected_fuel_pct(elapsed_ms: I64) -> I64 {
    (from, to, duration) :: (40.0, 95.0, 600)
    value :: if elapsed_ms <= 0 { from }
        else if elapsed_ms >= duration { to }
        else {
            t :: F64.from(elapsed_ms) / F64.from(duration)
            eased :: t * t * (3.0 - 2.0 * t)
            from + (to - from) * eased
        }
    I64.from(value.trunc())
}
