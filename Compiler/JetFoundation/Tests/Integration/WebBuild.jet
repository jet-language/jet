//RS /// Smoothstep ease, mirroring 197_ui_showcase.jet's `tween(40.0, 95.0,
//RS /// elapsed_ms, 600)` exactly (3t^2 - 2t^3, clamped at the ends) — the
//RS /// independent oracle the harness's printed `Fuel: N%` lines are checked
//RS /// against, so the assertion is "the interpolation math", not "whatever the
//RS /// code happens to print".
//RS fn expected_fuel_pct(elapsed_ms: i64) -> i64 {
//RS     let (from, to, duration) = (40.0_f64, 95.0_f64, 600_i64);
//RS     let value = if elapsed_ms <= 0 {
//RS         from
//RS     } else if elapsed_ms >= duration {
//RS         to
//RS     } else {
//RS         let t = elapsed_ms as f64 / duration as f64;
//RS         let eased = t * t * (3.0 - 2.0 * t);
//RS         from + (to - from) * eased
//RS     };
//RS     value.trunc() as i64
//RS }
