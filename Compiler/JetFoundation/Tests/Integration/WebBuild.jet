// Rust: tests/web_build.rs:1354
pub fn source_map_string_field(map: String, field: String) -> String {
    prefix :: "\"{field}\":\""
    value :: map.split_once(prefix).unwrap_or_else(() -> panic("missing source-map field `{field}`:\n{map}")).1
    value.split_once("\"").unwrap_or_else(() -> panic("unterminated source-map field `{field}`:\n{map}")).0.to_string()
}
// Rust: tests/web_build.rs:1366
pub fn decode_source_map_mappings(map: String) -> [(USize, USize, USize, USize, USize)] {
    // Rust: tests/web_build.rs:1367
    fn digit(byte: U8) -> I64 {
        if byte == {
            65..90 -> I64.from(byte - 65)
            97..122 -> I64.from(byte - 97) + 26
            48..57 -> I64.from(byte - 48) + 52
            43 -> 62
            47 -> 63
            else -> panic("invalid base64 VLQ byte: {byte}")
        }
    }
    // Rust: tests/web_build.rs:1378
    fn segment(encoded: String) -> [I64] {
        values := [I64]{}
        value: I64 := 0
        shift := 0
        loop byte in encoded.bytes() {
            d :: digit(byte)
            value |= (d & 31) << shift
            if d & 32 == 0 {
                negative :: value & 1 == 1
                magnitude :: value >> 1
                values.push(if negative { -magnitude } else { magnitude })
                value = 0
                shift = 0
            } else { shift += 5 }
        }
        assert_eq(shift, 0, "unterminated base64 VLQ segment: {encoded}")
        values
    }
    out := [(USize, USize, USize, USize, USize)]{}
    source: I64 := 0
    original_line: I64 := 0
    original_column: I64 := 0
    loop (generated_line, line) in source_map_string_field(map, "mappings").split(";").enumerate() {
        generated_column: I64 := 0
        loop encoded in line.split(",").filter((item) -> !item.is_empty()) {
            values :: segment(encoded)
            assert_eq(values.len(), 4, "expected an unmapped-name segment")
            generated_column += values[0]
            source += values[1]
            original_line += values[2]
            original_column += values[3]
            out.push((generated_line, USize.try_from(generated_column).unwrap(), USize.try_from(source).unwrap(), USize.try_from(original_line).unwrap(), USize.try_from(original_column).unwrap()))
        }
    }
    out
}
