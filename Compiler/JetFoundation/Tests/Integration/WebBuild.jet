// Rust: tests/web_build.rs:12
pub fn have_tool(name: String) -> Bool {
    // GATE #4494: actual subprocess availability probe.
    Command.new(name).arg("--version").output().is_ok()
}
// Rust: tests/web_build.rs:15
pub fn resolve_executable(candidate: OSPath) -> OSPath? {
    if candidate.components().count() > 1 {
        if candidate.is_file() { return Val(candidate) }
        return None
    }
    path :: env.var_os("PATH") ?? return None
    env.split_paths(path).map((dir) -> dir.join(candidate)).find((item) -> item.is_file())
}
// Rust: tests/web_build.rs:25
pub fn web_tools() -> (OSPath, OSPath)? {
    chromium :: env.var_os("JET_WEB_CHROMIUM").or_else(() -> env.var_os("CHROMIUM")).or_else(() -> Val("chromium")).and_then((name) -> resolve_executable(OSPath.from(name))) ?? return None
    node :: env.var_os("JET_WEB_NODE").or_else(() -> env.var_os("NODE")).or_else(() -> Val("node")).and_then((name) -> resolve_executable(OSPath.from(name))) ?? return None
    chromium_ok :: Command.new(chromium).arg("--version").output().ok().map((out) -> {
        version :: "{String.from_utf8_lossy(out.stdout)}{String.from_utf8_lossy(out.stderr)}"
        version.contains("Chromium") || version.contains("Chrome")
    }).unwrap_or(false)
    node_ok :: Command.new(node).arg("--version").output().ok().map((out) -> {
        version :: String.from_utf8_lossy(out.stdout)
        version.starts_with("v") && version.as_bytes().get(1).is_some_and((byte) -> byte.is_ascii_digit())
    }).unwrap_or(false)
    if chromium_ok && node_ok { Val((chromium, node)) } else { None }
}

// Rust: tests/web_build.rs:60
pub fn build_web_fixture(stem: String, src: String, shown: String) -> OSPath {
    // GATE #4494: filesystem publication and independent Rust wasm comparator compiler.
    dir :: env.temp_dir().join("jet_web_{stem}_{process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).unwrap()
    fs.create_dir_all(dir.join("build")).unwrap()
    out :: jet.compile_web_with_path(src, shown).unwrap_or_else((diags) -> panic("front end rejected web fixture:\n{jet.render_diagnostics(shown, src, diags)}"))
    web :: out.web.expect("web target compile must produce web artifacts")
    assert(web.manifest_json.contains("\"status\": \"m2\""), "manifest should be M2: {web.manifest_json}")
    assert(web.manifest_json.contains("\"partitions\""), "manifest missing partitions")
    fs.write(dir.join("build/web.manifest.json"), web.manifest_json).unwrap()
    fs.write(dir.join("build/jet_dom_runtime.js"), web.dom_runtime).unwrap()
    fs.write(dir.join("build/app.js"), web.js_app).unwrap()
    fs.write(dir.join("build/app_wasm.rs"), web.wasm_rust).unwrap()
    wasm_path :: dir.join("build/app.wasm")
    rustc :: Command.new("rustc").current_dir(dir).args(["--edition", "2021", "--target", "wasm32-unknown-unknown", "--crate-type", "cdylib", "-O", "build/app_wasm.rs", "-o", "build/app.wasm"]).output().unwrap()
    assert(rustc.status.success(), "rustc rejected wasm for {stem}:\n{String.from_utf8_lossy(rustc.stderr)}")
    assert(wasm_path.is_file(), "missing app.wasm for {stem}")
    dir
}
// Rust: tests/web_build.rs:114
pub fn build_web_fixture_with_machine(stem: String, src: String, shown: String, machine: TargetMachine) -> OSPath {
    // GATE #4494: retained filesystem and process primitives; #4483 selected machine.
    dir :: env.temp_dir().join("jet_web_{stem}_{process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir.join("build")).unwrap()
    out :: jet.compile_web_with_target_machine(shown, machine).unwrap_or_else((error) -> {
        if error == {
            .Diagnostics(diags) -> panic("front end rejected selected web fixture:\n{jet.render_diagnostics(shown, src, diags)}")
            .Machine(errors) -> panic("target machine rejected selected web fixture: {errors:Debug}")
        }
    })
    web :: out.web.expect("selected target compile must produce web artifacts")
    fs.write(dir.join("build/web.manifest.json"), web.manifest_json).unwrap()
    fs.write(dir.join("build/jet_dom_runtime.js"), web.dom_runtime).unwrap()
    fs.write(dir.join("build/app.js"), web.js_app).unwrap()
    fs.write(dir.join("build/app_wasm.rs"), web.wasm_rust).unwrap()
    wasm_path :: dir.join("build/app.wasm")
    rustc :: Command.new("rustc").current_dir(dir).args(["--edition", "2021", "--target", "wasm32-unknown-unknown", "--crate-type", "cdylib", "-O", "build/app_wasm.rs", "-o", "build/app.wasm"]).output().unwrap()
    assert(rustc.status.success(), "rustc rejected selected web fixture for {stem}:\n{String.from_utf8_lossy(rustc.stderr)}")
    assert(wasm_path.is_file(), "missing app.wasm for {stem}")
    dir
}
// Rust: tests/web_build.rs:167
pub fn build_web_project(stem: String, files: [(String, String)]) -> OSPath {
    dir :: env.temp_dir().join("jet_web_{stem}_{process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir.join("build")).unwrap()
    loop (path, src) in files { fs.write(dir.join(path), src).unwrap() }
    entry :: dir.join("main.jet")
    out :: jet.compile_web(entry.to_str().unwrap()).unwrap_or_else((diags) -> panic("front end rejected web project:\n{jet.render_diagnostics(entry.to_str().unwrap(), fs.read_to_string(entry).unwrap(), diags)}"))
    web :: out.web.expect("web target compile must produce web artifacts")
    fs.write(dir.join("build/web.manifest.json"), web.manifest_json).unwrap()
    fs.write(dir.join("build/jet_dom_runtime.js"), web.dom_runtime).unwrap()
    fs.write(dir.join("build/app.js"), web.js_app).unwrap()
    fs.write(dir.join("build/app_wasm.rs"), web.wasm_rust).unwrap()
    rustc :: Command.new("rustc").current_dir(dir).args(["--edition", "2021", "--target", "wasm32-unknown-unknown", "--crate-type", "cdylib", "-O", "build/app_wasm.rs", "-o", "build/app.wasm"]).output().unwrap()
    assert(rustc.status.success(), "rustc rejected wasm for {stem}:\n{String.from_utf8_lossy(rustc.stderr)}")
    dir
}
