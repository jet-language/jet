// Rust: tests/marker_declarations.rs:42
#Test("every_registry_row_is_one_written_declaration") {
    written :: marker_declarations()
    registry :: Registry.marker_rows().map(|row| -> row.rule.expect("marker rows carry their applied rule")).collect()
    assert_eq(written.len(), registry.len(), "the registry and the file must hold the same rows")
    for (declaration, row) in written.iter().zip(registry) {
        assert_eq(declaration.name, row.name, "rows are served in written order")
    }
}
// Rust: tests/marker_declarations.rs:63
#Test("retired_marker_declaration_forms_are_confined_to_fixtures_and_history") {
    root :: OSPath.from(env.var("CARGO_MANIFEST_DIR").expect("CARGO_MANIFEST_DIR"))
    allowed :: ["Docs/spec/syntax-decisions.md", "tests/ui/marker_decl_rejected_forms.jet", "tests/ui/marker_decl_rejected_forms.stderr"]
    marker_word :: ["mark", "er "].concat()
    on_clause :: [" ", "on", " ", "["].concat()
    second_list :: [")", "("].concat()
    checked_text_node :: ["checked", "_text_head_decl"].concat()
    frozen_parity :: root.join("dogfood/tower/tests/parity/fixtures")
    pending := [root.to_path_buf()]
    offenders: [String] := []
    loop {
        directory_opt :: pending.pop()
        if directory_opt == None { break }
        directory :: directory_opt.unwrap()
        entries :: fs.read_dir(&directory)
        if entries == Err(_) { continue }
        for entry in entries.unwrap().flatten() {
            path :: entry.path()
            if path.starts_with(&frozen_parity) { continue }
            metadata_result :: fs.symlink_metadata(&path)
            if metadata_result == Err(_) { continue }
            metadata :: metadata_result.unwrap()
            if metadata.file_type().is_dir() {
                name :: path.file_name().and_then(|name| -> name.to_str()).unwrap_or_default()
                if [".git", ".claude", ".opencode", ".tmp", ".jet", ".tower", ".agent-worktrees", "jit-aot-parity-report", "node_modules", "target", "build", ".cache", "cache", "dist", "result"].contains(name)
                    || name.starts_with("target-") || name.starts_with("build-") || name.starts_with("result-") { continue }
                pending.push(^path)
                continue
            }
            if !metadata.file_type().is_file() { continue }
            relative :: path.strip_prefix(root).expect("walked under the repository root").to_string_lossy().replace('\\', "/")
            if allowed.contains(&relative.as_str()) { continue }
            source_result :: fs.read_to_string(&path)
            if source_result == Err(_) { continue }
            source :: source_result.unwrap()
            for (line_number, line) in source.lines().enumerate() {
                if (line.contains(&marker_word) && (line.contains(&on_clause) || line.contains(&second_list))) || line.contains(&checked_text_node) {
                    offenders.push("{relative}:{line_number + 1}: {line}")
                }
            }
        }
    }
    assert(offenders.is_empty(), "retired marker declaration forms escaped their fixture/history allowlist:\n{offenders.join("\n")}")
}
// Rust: tests/marker_declarations.rs:154
#Test("the_parser_and_the_registry_read_the_same_rows") {
    for declaration in marker_declarations() {
        row :: Registry.marker_rows().find(|registered| -> registered.name == declaration.name).and_then(|registered| -> registered.rule)
            .unwrap_or_else(|| -> panic("`{declaration.name}` is written but not registered"))
        facts :: declaration.params.iter().filter(|param| -> Syntax.is_comptime_name(&param.name)).map(|param| -> param.name.as_str()).collect()
        assert(facts.contains(&"$sites"), "`{declaration.name}` must say where it may be written")
        assert(declaration.params.iter().all(|parameter| -> {
            if Syntax.is_comptime_name(&parameter.name) { parameter.ty.is_none() && parameter.value.is_some() }
            else { parameter.ty.is_some() }
        }), "`{declaration.name}` must keep typed arguments and fixed metadata separate")
        written_arguments :: declaration.params.iter().filter(|param| -> !Syntax.is_comptime_name(&param.name)).map(|param| -> param.name.as_str()).collect()
        registered_arguments :: row.signature.params.iter().map(|param| -> param.name).collect()
        registered_variadic :: declaration.params.iter().filter(|param| -> param.variadic).count()
        assert_eq(registered_variadic, if row.signature.variadic.is_some() { 1 } else { 0 }, "`{declaration.name}` variadic list")
        assert_eq(written_arguments.len(), registered_arguments.len() + registered_variadic, "`{declaration.name}` argument count")
        for (index, name) in registered_arguments.iter().enumerate() {
            assert_eq(&written_arguments[index], name, "`{declaration.name}` argument order")
        }
        written_sites :: declaration.params.iter().find(|parameter| -> parameter.name == "$sites")
            .and_then(|parameter| -> parameter.value.as_deref()).and_then(|value| -> {
                if value == {
                    ListLit(values, _) -> Some(values.iter().filter_map(|value| -> {
                        if value == {
                            EnumLit{variant, ..} -> Some(variant.as_str())
                            Field(_, member, _) -> Some(member.as_str())
                            Ident(name, _) -> Some(name.as_str())
                            _ -> None
                        }
                    }).collect())
                    _ -> None
                }
            }).expect("@sites is a list value")
        assert_eq(written_sites, row.sites.iter().map(|site| -> site.name()).collect(), "`{declaration.name}` site metadata")
        written_repeatable :: declaration.params.iter().find(|parameter| -> parameter.name == "$repeatable")
            .and_then(|parameter| -> parameter.value.as_deref()).is_some_and(|value| -> {
                if value == { Bool(true, _) -> true; _ -> false }
            })
        assert_eq(written_repeatable, row.repeatable, "`{declaration.name}` repeatability metadata")
    }
}
// Rust: tests/marker_declarations.rs:263
#Test("a_written_site_list_reaches_the_registry") {
    assert(Policy.rule_allows("Unsafe", RuleSite.Block))
    assert(Policy.rule_allows("Redact", RuleSite.Field))
    assert(!Policy.rule_allows("Redact", RuleSite.Type))
    assert(Policy.applied_rule("Known").is_some_and(|row| -> row.sites.is_empty()), "a retired row keeps no legal site")
}
// Rust: tests/marker_declarations.rs:275
#Test("every_effect_root_is_one_written_declaration") {
    written :: declarations(Facts.EFFECT_SOURCE).into_iter().filter_map(|item| -> {
        if item == { EffectDecl(declaration) -> Some(declaration.name); _ -> None }
    }).collect()
    assert(!written.is_empty(), "the effect file must declare roots")
    assert_eq(written, Facts.EFFECT_ROOTS, "written roots are the served roots")
}
// Rust: tests/marker_declarations.rs:295
#Test("every_fact_row_carries_its_law_columns") {
    parsed :: declarations(Registry.FACT_SOURCE).into_iter().filter_map(|item| -> {
        if item == { FactDecl(declaration) -> Some(declaration); _ -> None }
    }).collect()
    written :: Registry.FACT_SOURCE.lines().map(|line| -> line.trim()).filter(|line| -> line.starts_with("fact ")).collect()
    declarations :: Registry.fact_declarations()
    assert_eq(parsed.iter().map(|declaration| -> declaration.name.as_str()).collect(), declarations.iter().map(|declaration| -> declaration.source_name).collect(), "the real parser and the foundation reader must see the same fact rows")
    assert_eq(declarations.len(), written.len(), "every fact declaration is read")
    declaration_names: BTreeSet<String> :: declarations.iter().map(|declaration| -> declaration.name).collect()
    rows :: Registry.rows().iter().filter(|row| -> declaration_names.contains(row.name)).collect()
    row_names: BTreeSet<String> :: rows.iter().map(|row| -> row.name).collect()
    assert_eq(row_names, declaration_names, "parsed fact declarations and registry rows must have the same names")
    assert_eq(rows.len(), declarations.len(), "every fact declaration serves one row")
    for declaration in declarations {
        source :: written.iter().find(|source| -> source.starts_with("fact {declaration.source_name}("))
            .unwrap_or_else(|| -> panic("fact `{declaration.name}` is not written"))
        row :: rows.iter().find(|row| -> row.name == declaration.name).unwrap_or_else(|| -> panic("fact `{declaration.name}` has no registry row"))
        assert(source.starts_with("fact {declaration.source_name}("))
        parsed_declaration :: parsed.iter().find(|parsed| -> parsed.name == declaration.source_name)
            .unwrap_or_else(|| -> panic("fact `{declaration.name}` has no parsed declaration"))
        written_name :: parsed_declaration.params.iter().find(|param| -> param.name == "$name").and_then(|param| -> param.value.as_deref())
            .and_then(|value| -> {
                if value == {
                    Str(parts, _) -> {
                        literal :: parts.iter().all(|part| -> if part == { Lit(_) -> true; _ -> false })
                        if !literal { return None }
                        Some(parts.iter().map(|part| -> {
                            if part == { Lit(text) -> text.as_str(); Interp(..) -> panic("checked literal fact name") }
                        }).collect())
                    }
                    _ -> None
                }
            })
        if written_name == Some(name) { assert_eq(name, declaration.name, "fact @name column") }
        for column in ["@holds:", "@safe:", "@gates:"] { assert(source.contains(column), "`{declaration.name}` must write `{column}`") }
        assert_eq(row.name, declaration.name)
        assert_eq(row.target, declaration.target)
        assert_eq(row.safe_direction, declaration.safe_direction)
        assert_eq(row.gates, declaration.gates)
    }
}
// Rust: tests/marker_declarations.rs:399
#Test("source_rules_record_facts_and_add_checked_members") {
    source :: "\nmarker Recorded($sites: [.Type])\n\nmarker AddGreeting($sites: [.Type]) {{\n    tname :: target.name\n    impl $tname {{\n        fn greeting(self) -> String {{ \"hello\" }}\n    }}\n}}\n\n#[Recorded, AddGreeting]\nstruct Person {{ name: String }}\n\nfn run() {{\n    person :: Person{{name: \"ada\"}}\n    print(person.greeting())\n}}\n"
    _ :: compile(source).expect("source marker facts and additive bodies should compile")
    parsed :: declarations(source)
    recorded :: parsed.iter().find_map(|item| -> {
        if item == { MarkerDecl(declaration) -> if declaration.name == "Recorded" { Some(declaration) } else { None }; _ -> None }
    }).expect("bodyless source rule")
    additive :: parsed.iter().find_map(|item| -> {
        if item == { MarkerDecl(declaration) -> if declaration.name == "AddGreeting" { Some(declaration) } else { None }; _ -> None }
    }).expect("bodyful source rule")
    assert(recorded.body.is_none())
    assert(additive.body.is_some())
    source_declarations :: parsed.iter().filter_map(|item| -> {
        if item == { MarkerDecl(declaration) -> Some(declaration.clone()); _ -> None }
    }).collect()
    vocabulary :: Policy.MarkerVocabulary.with_derives_and_declarations([].into_iter(), source_declarations)
    person :: parsed.iter().find_map(|item| -> if item == { Struct(definition) -> Some(definition); _ -> None }).expect("reflected target type")
    reflection :: Comptime.build_struct_type_info_with_path_and_vocabulary(person, &[], "Person", Some(&vocabulary))
    fields :: if reflection == { Struct{fields, ..} -> fields; _ -> panic("TypeInfo must be a struct value") }
    marker_field :: fields.iter().find(|(name, _)| -> name == "markers")
    markers :: if marker_field == {
        Some((_, CtValue.List(markers))) -> markers
        _ -> panic("TypeInfo must expose marker facts")
    }
    assert(markers.iter().any(|marker| -> {
        if marker == {
            Struct{fields, ..} -> fields.iter().any(|(name, value)| -> name == "name" && if value == { Str(value) -> value == "Recorded"; _ -> false })
            _ -> false
        }
    }))
    reflected_add_greeting :: markers.iter().find(|marker| -> {
        if marker == {
            Struct{fields, ..} -> fields.iter().any(|(name, value)| -> name == "name" && if value == { Str(value) -> value == "AddGreeting"; _ -> false })
            _ -> false
        }
    }).expect("AddGreeting reflection")
    reflected_fields :: if reflected_add_greeting == { Struct{fields, ..} -> fields; _ -> panic("marker reflection must be a struct") }
    assert(reflected_fields.iter().any(|(name, value)| -> name == "sites" && if value == {
        List(values) -> values.iter().any(|value| -> if value == { Str(site) -> site == "Type"; _ -> false })
        _ -> false
    }))
    assert(reflected_fields.iter().any(|(name, value)| -> name == "repeatable" && if value == { Bool(false) -> true; _ -> false }))
}
// Rust: tests/marker_declarations.rs:515
#Test("source_rule_rejects_a_wrong_typed_argument") {
    diagnostics :: compile("marker NeedsName(name: String, $sites: [.Type])\n#NeedsName(7)\nstruct Person {{ id: Int }}\n").expect_err("a source rule must check its typed argument")
