    fs.write(&list_main, list_src).unwrap()
    list_diags :: jet.compile_with_path(list_src, list_main.to_str().unwrap()).expect_err("planned foreign member lists must be reserved")
    assert_eq(list_diags[0].code, "E1002")
}
