// Rust: tests/cffi.rs:20
#Test("octave_sidecar_runs_real_matrix_round_trip") {
    tool :: ["octave-cli", "octave"].iter().find(fn(candidate) { Command.new(candidate).arg("--version").output().map(fn(output) { output.status.success() }).unwrap_or(false) }).expect("jet-env full must provision Octave")
    eprintln("using {tool} for Octave integration")
    root :: env.temp_dir().join("jet_octave_e2e_{process.id()}")
    _ :: fs.remove_dir_all(&root)
    fs.create_dir_all(&root).unwrap()
    example :: OSPath(env.var("CARGO_MANIFEST_DIR").unwrap()).join("Examples/interop/octave")
    for file in ["scale.m", "run.jet", "expected.out"] { fs.copy(example.join(file), root.join(file)).unwrap() }
    fs.write(root.join("package.jet"), "name: \"octave_e2e\"\nversion: \"0.1.0\"\nedition: \"2026\"\nauthority: {{\n    holds: {{ allow: [GPU, IO, Mem.Alloc] }},\n}}\n").unwrap()
    bind :: Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(["inspect", "bind", "octave", "scale.m", "--pkg", "scale"]).current_dir(&root).output().unwrap()
    assert(bind.status.success(), "Octave bind failed:\n{String.from_utf8_lossy(&bind.stderr)}")
    generated :: fs.read_to_string(root.join(".jet/bindings/octave/scale.jet")).unwrap()
    assert(generated.contains("Tensor"))
    assert(generated.contains("FFI.Octave"))
    assert_eq(generated.matches("fn decode_response(").count(), 1)
    assert_eq(generated.matches("raw :: abi.scale(").count(), 1)
    assert_eq(generated.matches("decode_response(raw, code)").count(), 1)
    run :: Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(["run", "run.jet"]).current_dir(&root).output().unwrap()
    assert(run.status.success(), "generated Octave binding did not run:\n{String.from_utf8_lossy(&run.stderr)}")
    assert_eq(String.from_utf8_lossy(&run.stdout), fs.read_to_string(root.join("expected.out")).unwrap())
    provenance :: fs.read_to_string(root.join(".jet/bindings/octave/scale.provenance")).unwrap()
    assert(provenance.contains("transport=json"))
    assert(provenance.contains("shape=rank-2"))
    _ :: fs.remove_dir_all(root)
}
// Rust: tests/cffi.rs:82
#Test("cobol_copybook_binder_runs_real_gnucobol_and_preserves_comp3") {
    cobc :: Command.new("cobc").arg("--version").output().expect("jet-env full must provision cobc")
    assert(cobc.status.success(), "provisioned cobc failed its version check")
    root :: env.temp_dir().join("jet_cobol_e2e_{process.id()}")
    _ :: fs.remove_dir_all(&root)
    fs.create_dir_all(&root).unwrap()
    repo :: OSPath(env.var("CARGO_MANIFEST_DIR").unwrap()).join("Examples/interop/cobol")
    for file in ["payroll.cob", "payroll.cpy", "main.jet", "expected.out"] { fs.copy(repo.join(file), root.join(file)).unwrap() }
    bind :: Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(["inspect", "bind", "cobol", "payroll.cob", "--copybook", "payroll.cpy", "--pkg", "payroll"]).current_dir(&root).output().unwrap()
    assert(bind.status.success(), "{String.from_utf8_lossy(&bind.stderr)}")
    generated :: fs.read_to_string(root.join(".jet/bindings/cobol/payroll.jet")).unwrap()
    assert(generated.contains("jet-ffi-descriptor="))
    assert(generated.contains("gross_pay: Decimal\n"))
    assert(generated.contains("offset=24 width=5 type=Decimal scale=2 encoding=COMP-3"))
    assert(!generated.contains("gross_pay: Float"))
    assert(generated.contains("-[FFI.Cobol]> Int !CobolError"))
    assert(!generated.contains("=>"))
    provenance :: fs.read_to_string(root.join(".jet/bindings/cobol/payroll.provenance")).unwrap()
    assert(provenance.contains("schema=jet-cobol-bind-v1\n"))
    assert(provenance.contains("descriptor=jet-ffi-descriptor-v1;"))
    assert(provenance.contains("program_symbol=JETPAY\n"))
    assert(provenance.contains("record_width=29\n"))
    run :: Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(["run", "main.jet"]).current_dir(&root).output().unwrap()
    assert(run.status.success(), "{String.from_utf8_lossy(&run.stderr)}")
    assert_eq(String.from_utf8_lossy(&run.stdout), fs.read_to_string(root.join("expected.out")).unwrap())
    _ :: fs.remove_dir_all(root)
}
