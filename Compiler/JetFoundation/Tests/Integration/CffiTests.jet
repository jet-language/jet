}
// Rust: tests/cffi.rs:282
#Test("cffi_write_capability_round_trips_through_the_native_c_boundary") {
    if !common.have_rustc() { eprintln("note: skipping cffi_write_capability_round_trips (need rustc)"); return }
    root :: common.unique_tmp("jet_ffi_c_write")
    fs.create_dir_all(&root).unwrap()
    declare_local_c_dep(&root, "cap")
    build_local_c_provider(&root, "cap", """
#include <stdint.h>
typedef struct { int64_t x; int64_t y; } CapPair;
void jet_cap_increment(int64_t *value) { *value += 1; }
CapPair jet_cap_make(void) { return (CapPair){20, 22}; }
int64_t jet_cap_consume(CapPair value) { return value.x + value.y; }
""")
    path :: root.join("main.jet")
    source :: """
use c.cap as c
#Layout(c)
struct Pair { x: Int
    y: Int }
#Import module c.cap {
    fn increment(value: &Int) = "jet_cap_increment"
    fn make() -> Pair = "jet_cap_make"
    fn consume(value: ^Pair) -> Int = "jet_cap_consume"
}
fn run() {
    value := 41
    #Unsafe("the C function writes through the exclusive capability") { c.increment(&value) }
    print(value)
    pair :: c.make()
    #Unsafe("the C function consumes the C-layout value") { print(c.consume(^pair)) }
}
"""
    fs.write(&path, source).unwrap()
    output :: jet.compile_with_path(source, path.to_str().unwrap()).unwrap_or_else(fn(diagnostics) { panic("C capability rejected:\n{diagnostics:?}") })
    assert(output.ffi.is_none(), "capability C calls must stay on the native path")
    assert(output.rust.contains("*mut std::os::raw::c_longlong"), "C `&` must lower to a mutable pointer:\n{output.rust}")
    assert(output.rust.contains("&mut c0"), "C `&` must pass the exclusive temporary:\n{output.rust}")
    assert(output.rust.contains("pub fn __jet_consume(a0: super::__jet_Pair)"), "C `^` must consume the C-layout value without a borrowed clone")
    rs :: root.join("main.rs")
    bin :: root.join("main_bin")
    fs.write(&rs, &output.rust).unwrap()
    built :: Command.new("rustc").args(["--edition", "2021"]).arg(&rs).arg("-o").arg(&bin).arg("-L").arg("native={root.display()}").arg("-lcap").output().unwrap()
    assert(built.status.success(), "rustc rejected the native C capability wrapper:\n{String.from_utf8_lossy(&built.stderr)}")
    run :: Command.new(&bin).output().unwrap()
    assert(run.status.success(), "native C capability call failed:\n{String.from_utf8_lossy(&run.stderr)}")
    assert_eq(String.from_utf8_lossy(&run.stdout), "42\n42\n")
    _ :: fs.remove_dir_all(root)
}
// Rust: tests/cffi.rs:372
#Test("cffi_close_capability_round_trips_through_the_native_c_boundary") {
    if !common.have_rustc() { eprintln("note: skipping cffi_close_capability_round_trips (need rustc)"); return }
    root :: common.unique_tmp("jet_ffi_c_close")
    fs.create_dir_all(&root).unwrap()
    declare_local_c_dep(&root, "close")
    build_local_c_provider(&root, "close", """
#include <stdint.h>
typedef struct { int64_t value; } CloseHandle;
static int64_t released;
CloseHandle jet_close_acquire(void) { return (CloseHandle){41}; }
void jet_close_release(CloseHandle handle) { released = handle.value; }
int64_t jet_close_released(void) { return released; }
""")
    path :: root.join("main.jet")
    source :: """
use c.close as c
#Layout(c)
struct Handle { value: I64 }
#Import module c.close {
    #Close(release)
    fn acquire() -> Handle = "jet_close_acquire"
    fn release(handle: ^Handle) = "jet_close_release"
    fn released() -> I64 = "jet_close_released"
}
fn run() {
    handle := c.acquire()
    close(^handle)
    print(c.released())
}
"""
    fs.write(&path, source).unwrap()
    output :: jet.compile_with_path(source, path.to_str().unwrap()).unwrap_or_else(fn(d) { panic("C #Close fixture was rejected:\n{jet.render_diagnostics(path.to_str().unwrap(), source, &d)}") })
    assert(output.rust.contains("impl __jet_Close for"))
    assert(output.rust.contains("__jet_release(self)"))
    assert(!output.rust.contains("jet_ffi_release(self)"))
    rs :: root.join("main.rs")
    bin :: root.join("main_bin")
    fs.write(&rs, &output.rust).unwrap()
    built :: Command.new("rustc").args(["--edition", "2021"]).arg(&rs).arg("-o").arg(&bin).arg("-L").arg("native={root.display()}").arg("-lclose").output().unwrap()
    assert(built.status.success(), "I2: rustc rejected the C #Close wrapper:\n{String.from_utf8_lossy(&built.stderr)}")
    run :: Command.new(&bin).output().unwrap()
    assert(run.status.success(), "{String.from_utf8_lossy(&run.stderr)}")
    assert_eq(String.from_utf8_lossy(&run.stdout), "41\n")
    _ :: fs.remove_dir_all(root)
}
// Rust: tests/cffi.rs:443
#Test("foreign_close_contract_registers_only_a_matching_consuming_function") {
    root :: common.unique_tmp("jet_ffi_close_contract")
    fs.create_dir_all(&root).unwrap()
    valid :: """
extern rust "std" {
    #Close(release)
    fn acquire() -> String = "std::string::String::new"
    fn release(handle: ^String) = "std::mem::drop"
}
fn run() {
    handle := acquire()
    close(^handle)
}
"""
    valid_path :: root.join("valid.jet")
    fs.write(&valid_path, valid).unwrap()
    valid_diags :: jet.check_with_path(valid_path.to_str().unwrap())
    assert(valid_diags.is_empty(), "matching #Close(^handle) contract must pass: {valid_diags:?}")
    compiled :: jet.compile_with_path(valid, valid_path.to_str().unwrap()).expect("validated foreign close contract must lower through production codegen")
    assert(compiled.rust.contains("impl __jet_Close for String") && compiled.rust.contains("jet_ffi_release"), "the close contract must reach the generated bridge call: {compiled.rust}")
    invalid :: valid.replace("handle: ^String", "handle: String")
    invalid_path :: root.join("invalid.jet")
    fs.write(&invalid_path, invalid).unwrap()
    invalid_diags :: jet.check_with_path(invalid_path.to_str().unwrap())
    assert(invalid_diags.iter().any(fn(diagnostic) { diagnostic.code == "E0702" }), "layout/ownership mismatch must fail as a typed FFI diagnostic: {invalid_diags:?}")
    _ :: fs.remove_dir_all(root)
}
// Rust: tests/cffi.rs:488
#Test("unified_foreign_binder_registry_routes_active_and_planned_languages") {
    expected :: [
        (ForeignLanguage.C, "c", "bindings/c", BinderSurface.Namespace, BinderStatus.Active),
        (ForeignLanguage.Rust, "rust", "bindings/rust", BinderSurface.Namespace, BinderStatus.Planned),
        (ForeignLanguage.Py, "py", "bindings/py", BinderSurface.Namespace, BinderStatus.Active),
        (ForeignLanguage.JS, "js", "bindings/js", BinderSurface.Namespace, BinderStatus.Active),
        (ForeignLanguage.Swift, "swift", "bindings/swift", BinderSurface.Namespace, BinderStatus.Planned),
        (ForeignLanguage.Fortran, "fortran", "bindings/fortran", BinderSurface.Namespace, BinderStatus.Active),
        (ForeignLanguage.Cobol, "cobol", "bindings/cobol", BinderSurface.Namespace, BinderStatus.Active),
        (ForeignLanguage.Java, "java", "bindings/java", BinderSurface.Namespace, BinderStatus.Active),
        (ForeignLanguage.DotNet, "cs", "bindings/cs", BinderSurface.Namespace, BinderStatus.Active),
        (ForeignLanguage.Tcl, "tcl", "bindings/tcl", BinderSurface.Namespace, BinderStatus.Active),
        (ForeignLanguage.Ada, "ada", "bindings/ada", BinderSurface.Namespace, BinderStatus.Active),
        (ForeignLanguage.Pascal, "pascal", "bindings/pascal", BinderSurface.Namespace, BinderStatus.Active),
        (ForeignLanguage.Dart, "dart", "bindings/dart", BinderSurface.Namespace, BinderStatus.Active),
        (ForeignLanguage.PowerShell, "pwsh", "bindings/pwsh", BinderSurface.Namespace, BinderStatus.Active),
        (ForeignLanguage.Perl, "perl", "bindings/perl", BinderSurface.Namespace, BinderStatus.Active),
        (ForeignLanguage.Ruby, "ruby", "bindings/ruby", BinderSurface.Namespace, BinderStatus.Active),
        (ForeignLanguage.Php, "php", "bindings/php", BinderSurface.Namespace, BinderStatus.Active),
        (ForeignLanguage.R, "r", "bindings/r", BinderSurface.Namespace, BinderStatus.Active),
        (ForeignLanguage.Octave, "octave", "bindings/octave", BinderSurface.Namespace, BinderStatus.Active),
        (ForeignLanguage.Com, "com", "bindings/com", BinderSurface.Namespace, BinderStatus.Active)
    ]
    for (lang, root, bindings, surface, status) in expected {
        assert_eq(ForeignLanguage.from_root(root), Val(lang))
        assert_eq(lang.root(), root)
        assert_eq(lang.bindings_subdir(), bindings)
        binder :: binder_for(lang).expect("registered binder")
        assert_eq(binder.surface, surface)
        assert_eq(binder.status, status)
    }
}
// Rust: tests/cffi.rs:646
#Test("unified_foreign_namespace_model_recognizes_every_registered_root") {
    roots :: [
        ("c", ForeignLanguage.C), ("cpp", ForeignLanguage.Cpp), ("rust", ForeignLanguage.Rust),
        ("py", ForeignLanguage.Py), ("js", ForeignLanguage.JS), ("swift", ForeignLanguage.Swift),
        ("go", ForeignLanguage.Go), ("java", ForeignLanguage.Java), ("cs", ForeignLanguage.DotNet),
        ("tcl", ForeignLanguage.Tcl), ("lua", ForeignLanguage.Lua), ("fortran", ForeignLanguage.Fortran),
        ("cobol", ForeignLanguage.Cobol), ("ada", ForeignLanguage.Ada), ("pascal", ForeignLanguage.Pascal),
        ("dart", ForeignLanguage.Dart), ("pwsh", ForeignLanguage.PowerShell), ("perl", ForeignLanguage.Perl),
        ("ruby", ForeignLanguage.Ruby), ("php", ForeignLanguage.Php), ("r", ForeignLanguage.R),
        ("octave", ForeignLanguage.Octave), ("com", ForeignLanguage.Com)
    ]
    assert_eq(roots.map(fn((_, language)) { language }), ForeignLanguage.ALL)
    for (root, language) in roots {
        path :: "{root}.lib"
        namespace :: ForeignNamespace.from_module_path(&path).unwrap_or_else(fn() { panic("{root} namespace") })
        assert_eq(namespace.language, language)
        assert_eq(namespace.lib, "lib")
        assert_eq(namespace.display(), path)
        assert(ForeignNamespace.from_module_path(root).is_none())
        assert(ForeignNamespace.from_module_path("{root}.").is_none())
        assert(ForeignNamespace.from_module_path("{root}.lib.extra").is_none())
    }
    assert(ForeignNamespace.from_module_path("unknown.lib").is_none())
}
// Rust: tests/cffi.rs:692
#Test("foreign_namespace_selective_imports_reuse_ordinary_parser_path") {
    for language in ForeignLanguage.ALL {
        source :: "use {language.root()}.[lib1 as first, lib2]\nfn run() {{ }}\n"
        (tokens, lex_diagnostics) :: jet.Lexer.lex(&source)
        assert(lex_diagnostics.is_empty(), "{language.root()}: {lex_diagnostics:?}")
        program :: jet.Parser.parse(&tokens).unwrap_or_else(fn(diagnostics) { panic("{language.root()}: {diagnostics:?}") })
        if &program.imports[0].kind == {
            .Unqualified { module_alias, items, .. } -> {
                assert_eq(module_alias, language.root())
                assert_eq(items, &[("lib1", Val("first")), ("lib2", nil)])
            }
            _ -> panic("{language.root()} list took a foreign-only parser branch")
        }
    }
}
// Rust: tests/cffi.rs:728
#Test("c_member_lists_resolve_each_library_and_alias_through_cffi") {
    root :: common.unique_tmp("jet_cffi_member_list")
    fs.create_dir_all(&root).unwrap()
    main :: root.join("main.jet")
    source :: """
use c.[c as libc, m]
#Import module c.c { fn clamp(left: Int, middle: Int, right: Int) -> Int = "libc_clamp" }
#Import module c.m { fn version(left: Int, middle: Int, right: Int) -> Int = "libm_version" }
module c_scope {
    use c.[c as lib]
    pub fn call() -> Int { return lib.clamp(1, 2, 3) }
}
module m_scope {
    use c.[m as lib]
    pub fn call() -> Int { return lib.version(1, 2, 3) }
}
fn run() { }
"""
    fs.write(root.join("package.jet"), "name: \"member_list\"\nversion: \"0.1.0\"\ndeps: {{ c: c@system, m: c@system }}\n").unwrap()
    fs.write(&main, source).unwrap()
    output :: jet.compile_with_path(source, main.to_str().unwrap()).unwrap_or_else(fn(diagnostics) { panic("C member list rejected: {diagnostics:?}") })
    assert(output.rust.contains("libc_clamp"))
    assert(output.rust.contains("libm_version"))
    assert(output.rust.contains("__c_c"))
    assert(output.rust.contains("__c_m"))
    c_scope :: output.rust.find("fn __jet_c_scope__call").expect("inline C scope emitted")
    m_scope :: output.rust.find("fn __jet_m_scope__call").expect("second inline C scope emitted")
    assert(output.rust[c_scope..m_scope].contains("__c_c"), "c_scope resolved its local alias to the wrong C library")
    assert(output.rust[m_scope..].contains("__c_m"), "m_scope resolved its local alias to the wrong C library")
    _ :: fs.remove_dir_all(root)
}
// Rust: tests/cffi.rs:788
#Test("foreign_member_list_rejects_one_invalid_member_without_partial_import") {
