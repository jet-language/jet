// Rust: tests/cffi.rs:190
#Test("ffi_capability_boundary_is_safe_only_inside_unsafe") {
    root :: common.unique_tmp("jet_ffi_capability_boundary")
    fs.create_dir_all(&root).unwrap()
    safe :: """
extern rust "std" { fn borrow(s: &String) -> String = "std::mem::take" }
fn run() {
    value := "hi"
    print(borrow(&value))
}
"""
    safe_path :: root.join("safe.jet")
    fs.write(&safe_path, safe).unwrap()
    safe_diags :: jet.check_with_path(safe_path.to_str().unwrap())
    assert(safe_diags.iter().any(fn(diagnostic) { diagnostic.code == "E0702" }), "safe raw capability call must be rejected with E0702: {safe_diags:?}")
    assert(!safe_diags.iter().any(fn(diagnostic) { diagnostic.code == "E3103" }), "capability gate must use E0702, not E3103: {safe_diags:?}")
    audited :: """
extern rust "std" { fn borrow(s: &String) -> String = "std::mem::take" }
fn run() {
    value := "hi"
    #Unsafe("the foreign call may write through the borrowed value") {
        print(borrow(&value))
    }
}
"""
    audited_path :: root.join("audited.jet")
    fs.write(&audited_path, audited).unwrap()
    audited_diags :: jet.check_with_path(audited_path.to_str().unwrap())
    assert(!audited_diags.iter().any(fn(diagnostic) { diagnostic.code == "E0702" }), "an audited raw capability call must clear the E0702 boundary gate: {audited_diags:?}")
    audited_output :: jet.compile_with_path(audited, audited_path.to_str().unwrap()).expect("an audited capability call must lower through the checked wrapper")
    assert(audited_output.rust.contains("jet_ffi_borrow(&mut"), "`&` must remain an exclusive borrow at the generated call edge")
    _ :: fs.remove_dir_all(root)
}
