// Rust: tests/gate_ledger.rs:10
fn jet() -> OSPath { OSPath.from(env.build("CARGO_BIN_EXE_jet")) }
// Rust: tests/gate_ledger.rs:14
fn run(root: &OSPath, args: &[String]) -> Output {
    Command.new(jet()).current_dir(root).args(args).output().expect("run jet")
}
// Rust: tests/gate_ledger.rs:22
fn stdout(output: &Output) -> String {
    assert(output.status.success(), "status={output.status} stdout={String.from_utf8_lossy(&output.stdout)} stderr={String.from_utf8_lossy(&output.stderr)}")
    String.from_utf8(output.stdout.clone()).expect("utf8 stdout")
}
// Rust: tests/gate_ledger.rs:33
fn write_gates(root: &OSPath) -> {
    fs.write(root.join("gates.jet"), """
fn run() -> {
    #Unsafe("test unsafe reason") { print("unsafe row") }
    #Impure("test impure reason") {}
    #Nondeterministic("test nondeterministic reason") {}
}
""").unwrap()
}
// Rust: tests/gate_ledger.rs:48
fn write_source_gate_kinds(root: &OSPath) -> {
    fs.write(root.join("source-gates.jet"), """
#UnitFamily(Length, base: meter) {
    meter
    thirdish(scale: 2/3)
}
tag Input { deny: [IO] }
#Scrub(Input) fn scrub(raw: #Input String) -> String { ~raw }
#MustUse fn discardable() -> Int { 1 }
fn run() -> {
    #FX(authority: IO) {}
    discardable().drop("intentional result discard")
    detached :: task 42
    detached.detach()
    approx(1)
    wrapping(1 + 2)
    Thirdish.from_meter_rounded(1meter, .NearestEven, digits: 0).drop("rounded conversion gate")
}
""").unwrap()
}
