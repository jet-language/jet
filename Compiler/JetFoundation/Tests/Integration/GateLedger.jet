// Rust: tests/gate_ledger.rs:101
fn have_tool(name: &String) -> Bool {
    Command.new(name).arg("--version").output().map((output) -> output.status.success()).unwrap_or(false)
}
// Rust: tests/gate_ledger.rs:109
fn have_wasm_target() -> Bool {
    Command.new("rustc").args(["--print", "target-libdir", "--target", "wasm32-unknown-unknown"]).output().map((output) -> output.status.success()).unwrap_or(false)
}
// Rust: tests/gate_ledger.rs:122
fn checked_number_grid_bundle(tag: &String) -> (common.Scratch, compiler.AST.ProgramBundle) {
    scratch :: common.Scratch.new(tag)
    entry :: scratch.join("range_types.jet")
    fs.write(&entry, NUMBER_GRID_EXAMPLE).unwrap()
    shown :: entry.to_string_lossy().into_owned()
    bundle := compiler.Loader.load_entry(&shown).expect("number-grid example must load")
    diagnostics :: compiler.Sema.check_bundle(&bundle, compiler.Sema.CompileMode.Run)
    assert(diagnostics.is_empty(), "number-grid sema failed: {diagnostics:Debug}")
    (scratch, bundle)
}
// Rust: tests/gate_ledger.rs:136
fn assert_inline_int_range(ty: &compiler.AST.Type, lo: I64, hi: I64) -> {
    match ty {
        .InlineRange(base, actual_lo, actual_hi) -> {
            assert_eq(base.as_ref(), &compiler.AST.Type.Int)
            assert_eq((actual_lo, actual_hi), (lo, hi))
        }
        other -> panic("expected Int({lo}..{hi}), got {other:Debug}")
    }
}
// Rust: tests/gate_ledger.rs:150
fn assert_tier_output(output: Output) -> {
    text :: stdout(&output)
    assert_tier_text(&text)
}
// Rust: tests/gate_ledger.rs:155
fn assert_tier_text(text: &String) -> {
    for expected in ["42", "comptime_range=9", "comptime_exactness=true", "comptime_unit=2.0", "comptime_state=state", "comptime_classification=world", "exactness=true", "unit=2.0", "state=state", "classification=world", "range=9"] {
        assert(text.contains(expected), "expected {expected:Debug}, got {text}")
    }
}
// Rust: tests/gate_ledger.rs:173
fn assert_knowledge_ledger(json: &String) -> {
    assert(json.starts_with("{{\"schema\":\"jet.status/v1\"") && json.contains("\"gates\":{{\"entries\":["), "{json}")
    for subject in ["approx", "wrapping", "from_half_rounded", ".raw", "#Transition(_, Pending)", "#Transition(Pending, Confirmed)", "#Scrub(Input)"] {
        assert(json.contains("\"subject\":\"{subject}\""), "missing {subject} in {json}")
    }
    assert_eq(json.matches("\"kind\":\"state_transition\"").count(), 2, "{json}")
    assert_eq(json.matches("\"kind\":\"taint_scrub\"").count(), 1, "{json}")
    assert_eq(json.matches("\"kind\":\"precision_demotion\"").count(), 5, "{json}")
    scrub :: json.find("\"kind\":\"taint_scrub\"").expect("taint row")
    state :: json.find("\"kind\":\"state_transition\"").expect("state row")
    precision :: json.find("\"kind\":\"precision_demotion\"").expect("precision row")
    assert(scrub < state && state < precision, "knowledge rows drifted: {json}")
    assert(json.contains("\"span\":{{\"start\":"), "{json}")
    assert(json.contains("\"reason\":\"#Transition(Pending, Confirmed)\""), "{json}")
    assert(json.contains("tier.jet:"), "{json}")
}
