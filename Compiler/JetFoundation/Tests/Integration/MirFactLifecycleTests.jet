// Rust: tests/modules.rs:542
#Test("leading_underscore_opts_module_out_of_auto_discovery") {
    src :: "module _gaming {{\n    system.gaming: System{{\n        target: linux.x64,\n    }}\n}}\n"
    items :: parse_items(src)
    m :: if items[0] == .Module(value) { value } else { panic("expected a module item") }
    assert_eq(m.name, "_gaming")
    assert(!m.is_auto_discovered())
    assert_eq(m.contributions[0].namespace, Namespace.System)
}
// Rust: tests/modules.rs:560
#Test("many_modules_per_file") {
    src :: "module laptop {{\n    system.laptop: System{{ target: linux.x64 }}\n}}\nmodule installer {{\n    image.installer: Image{{ from: system.laptop, target: linux.arm64 }}\n}}\n"
    items :: parse_items(src)
    assert_eq(items.len(), 2)
    a :: if items[0] == .Module(value) { value } else { panic("expected two module items") }
    b :: if items[1] == .Module(value) { value } else { panic("expected two module items") }
    assert_eq(a.name, "laptop")
    assert_eq(a.contributions[0].namespace, Namespace.System)
    assert_eq(b.name, "installer")
    assert_eq(b.contributions[0].namespace, Namespace.Image)
}
