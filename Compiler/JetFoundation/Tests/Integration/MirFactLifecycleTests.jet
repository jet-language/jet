// Rust: tests/mir_typed_error_carriers.rs:81
#Test("base64_typed_error_carrier_is_consistent_across_i9_tiers") {
    TirSupport.assert_tiers_agree("base64_typed_error_carrier", BASE64_TYPED_ERROR_SOURCE, "false\ntrue\n1\n102\ntrue\ninvalid base64 at byte 2: expected 1 padding characters\ninvalid base64 at byte 1: byte 0x3F is not in the standard base64 alphabet\ninvalid base64 at byte 1: non-zero unused bits\ninvalid base64 at byte 0: byte 0x2D is not in the standard base64 alphabet\n1\n251\ntrue\ninvalid base64url at byte 2: padding is not allowed\n")
}

// Rust: tests/modules.rs:81
#Test("perf_role_captures_budget_expression_and_spans") {
    src :: "module perf.release {{\n    budgets: [Budget{{\n        name: \"binary\",\n        scope: .Target(\"cli\"),\n        metric: .BinarySize,\n        limit: .AtMost(2MiB),\n    }}]\n}}\n\n"
    items :: parse_items(src)
    module :: if items[0] == .Module(value) { value } else { panic("expected perf role module") }
    assert_eq(module.name, "perf.release")
    assert_eq(src[module.name_span.start..module.name_span.end], "perf.release")
    contribution :: module.contributions[0]
    assert_eq(contribution.namespace, Namespace.Perf)
    assert_eq(contribution.path, "release")
    perf :: if contribution.value == .Perf(value) { value } else { panic("expected typed perf role AST") }
    assert_eq(src[perf.budgets_span.start..perf.budgets_span.end], "budgets")
    assert_eq(perf.budgets.len(), 1)
    assert_eq(perf.budgets[0].fields.len(), 4)
    limit :: perf.budgets[0].fields.iter().find(field -> field.name == "limit").expect("typed limit field")
    args :: if limit.value == .EnumLit{args, ..} { args } else { panic("typed limit enum") }
    unit :: if args[0] == .Positional(value) { value } else { panic("typed unit literal") }
    if unit == .UnitLit{raw, suffix, suffix_span, ..} {
        assert_eq((raw, suffix), ("2", "MiB"))
        assert_eq(src[suffix_span.start..suffix_span.end], "MiB")
    } else { panic("typed unit literal") }
    expected_span := src[src.find("budgets").unwrap()..].trim_end() // #4303
    assert_eq(src[perf.span.start..perf.span.end], expected_span)
}
// Rust: tests/modules.rs:139
#Test("perf_budget_sema_elaborates_defaults_and_field_spans") {
    src :: "module perf.release {{\n    budgets: [Budget{{\n        name: \"binary\",\n        metric: .BinarySize,\n        limit: .AtMost(2MiB),\n    }}]\n}}\n\n"
    (tokens, lex_diags) :: jet.Lexer.lex(src)
    assert(lex_diags.is_empty(), "lex diagnostics: {lex_diags:?}")
    program :: jet.Parser.parse(tokens).expect("parse")
    specs :: jet.Sema.collect_budget_specs(program).expect("valid performance budget")
    assert_eq(specs.len(), 1)
    spec :: specs[0]
    assert_eq(spec.role, "release")
    assert_eq(spec.name, "binary")
    assert_eq(spec.metric, "BinarySize")
    assert_eq(spec.comparison, "Absolute")
    assert_eq(spec.limit, "AtMost")
    assert_eq(spec.enforcement, "Fail")
    assert_eq(src[spec.span.start..spec.span.end], "Budget{{\n        name: \"binary\",\n        metric: .BinarySize,\n        limit: .AtMost(2MiB),\n    }}")
    loop field in ["name", "metric", "limit"] {
        span :: spec.field_spans.get(field).expect("field span")
        assert_eq(src[span.start..span.end], field)
    }
}
// Rust: tests/modules.rs:178
#Test("perf_budget_sema_rejects_duplicate_identity_and_effective_overlap") {
    duplicate_name :: "module perf.release {{\n    budgets: [\n        Budget{{ name: \"binary\", metric: .BinarySize, limit: .AtMost(2MiB) }},\n        Budget{{ name: \"binary\", metric: .ArtifactSize, limit: .AtMost(3MiB) }},\n    ]\n}}\n"
