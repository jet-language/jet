use std.fs
use jet
use jet.AST.[Item, Expr, Namespace, ContribValue, EnumLitArg, StrPart]
use jet.Sema.[BudgetQuantity, BudgetRawQuantity]
use jet_foundation.MIR.*
use jet_foundation.Tests.Integration.Common
use jet_foundation.Tests.Integration.TirSupport
use jet_foundation.Tests.Integration.MirFactLifecycle.*

// Rust: tests/mir_fact_lifecycle.rs:49
#Test("changed_mir_recomputes_facts_and_rejects_stale_passes") {
    source :: """
fn auto(values: [Float#4]) -> [Float#4] {{
    output := [Float#4]{{0.0, 0.0, 0.0, 0.0}}
    loop i in 0..<4 {{ output[i] = values[i] * 2.0 }}
    return output
}}
fn scalar_sum(values: [Float#4]) -> Float {{
    total := Float{{0.0}}
    loop i in 0..<4 {{ total += values[i] }}
    return total
}}
fn run() {{}}
"""
    mir :: lower_checked(source)
    policy :: MirOptimizationPolicy.conservative()
    optimized :: optimize_mir_program(^mir, policy).unwrap()
    reduction :: function(optimized, "scalar_sum")
    assert(!reduction.optimization.auto_vectorizable)
    assert(reduction.optimization.vector_facts.iter().all(fact -> !fact.decision.is_eligible()))
    auto :: function(optimized, "auto")
    assert(auto.optimization.auto_vectorizable, "loop facts: {auto.optimization.loop_facts:#?}\nvector facts: {auto.optimization.vector_facts:#?}")
    assert(auto.optimization.vector_facts.iter().any(fact -> fact.decision.is_eligible()))
    checked :: auto.optimization.checked_vector_facts.iter().find(proof -> auto.optimization.vector_facts.iter().any(fact -> fact.loop_header == proof.loop_header)).expect("eligible vector fact must retain its checked source proof")
    derived :: auto.optimization.vector_facts.iter().find(fact -> fact.loop_header == checked.loop_header).expect("eligible loop must retain its derived vector fact")
    cursor :: checked.cursor.expect("checked proof must identify its cursor")
    assert(!checked.body_blocks.is_empty())
    assert(checked.advance_block.is_some())
    assert(!checked.accesses.is_empty())
    assert(checked.packed)
    assert(checked.span.start > 0 && checked.span.end > checked.span.start && checked.span.end <= source.len(), "checked proof must retain a non-default source origin: {checked.span:?}")
    assert(source[checked.span.start..checked.span.end].bytes().any(byte -> !byte.is_ascii_whitespace()), "checked proof origin must cover source bytes")
    assert(checked.same_checked_scope(derived), "checked proof scope must match the canonical post-optimization row:\nchecked={checked:#?}\nderived={derived:#?}")
    assert_eq(checked.accesses.len(), 3, "the elementwise witness must retain all canonical input/output access identities: {checked.accesses:#?}")
    assert(checked.accesses.iter().all(access -> {
        place_root :: if access.root == .Place(_) { true } else { false }
        return access.layout == MirVectorLayout.Flat && access.field.is_none() && access.column_index.is_none() && place_root
    }), "flat elementwise proof must retain place roots without projections: {checked.accesses:#?}")
    access_roots := checked.accesses.iter().map(access -> {
        if access.root == .Place(place) { return place }
        panic("flat elementwise access must use a place root")
    }).collect()
    access_roots.sort()
    access_roots.dedup()
    assert_eq(access_roots.len(), checked.accesses.len(), "each proven access must retain a distinct MIR place identity")
    access_roles := [(String, Bool, Bool, Bool)]{}
    induction_local :: auto.locals.iter().find(local -> local.name == "i").expect("counted witness must retain its induction local")
    loop place_id in access_roots {
        place :: auto.places.iter().find(place -> place.id == place_id).unwrap_or_else(() -> panic("checked access references unknown MIR place {place_id:?}"))
        semantic_name :: if place.base == {
            .Local(local) -> auto.locals.iter().find(candidate -> candidate.id == local).map(local -> local.name)
            .Parameter(value) -> auto.blocks.iter().flat_map(block -> block.instructions.iter()).find_map(instruction -> {
                if instruction.result == Some(value) && instruction.operation == .Parameter{name, ..} { return Some(name) }
                return None
            })
            .Capture(value) -> auto.blocks.iter().flat_map(block -> block.instructions.iter()).find_map(instruction -> {
                if instruction.result == Some(value) && instruction.operation == .Parameter{name, ..} { return Some(name) }
                return None
            })
            .Temporary(value) -> auto.blocks.iter().flat_map(block -> block.instructions.iter()).find_map(instruction -> {
                if instruction.result == Some(value) && instruction.operation == .Parameter{name, ..} { return Some(name) }
                return None
            })
            .Static(_) -> None
        }.unwrap_or_else(() -> panic("checked access has no semantic local name: {place:?}"))
        has_index :: place.projections.iter().any(projection -> if projection == .Index{..} { true } else { false })
        indexes_cursor :: place.projections.iter().any(projection -> if projection == .Index{index, ..} { index == cursor } else { false })
        access_roles.push((semantic_name, has_index, indexes_cursor, place.projections.is_empty()))
    }
    access_roles.sort()
    assert_eq(access_roles, [("i", false, false, true), ("output", true, false, false), ("values", true, true, false)], "checked access IDs must resolve to the induction, output, and input local roles")
    output_place :: auto.places.iter().find(place -> {
        output_local :: if place.base == .Local(local) { auto.locals.iter().any(candidate -> candidate.id == local && candidate.name == "output") } else { false }
        return output_local && place.projections.iter().any(projection -> if projection == .Index{..} { true } else { false })
    }).and_then(place -> place.projections.iter().find_map(projection -> if projection == .Index{index, ..} { Some(index) } else { None })).expect("output access must retain its index identity")
    seen := [MirValueId]{}
    assert(value_reads_place(auto, output_place, induction_local.place, &seen), "output write index must be tied to the induction local: output index={output_place:?}, induction place={induction_local.place:?}")
    assert(checked.no_aliasing)
    assert(checked.no_early_exit)
    assert(checked.effect_free_body)
    assert(checked.no_cross_iteration_dependencies)
    overrun := optimized.clone()
    overrun_function :: function_mut(&overrun, "auto")
    upper_bound :: overrun_function.blocks.iter_mut().flat_map(block -> &block.instructions).find_map(instruction -> {
        if instruction.operation == .Constant(.Int{value, ..}) { if value == 4 { return Some(&value) } }
        return None
    }).expect("the checked loop has a literal upper bound")
    *upper_bound = 5
    overrun_function.optimization.pass_ids.clear()
    overrun_optimized :: optimize_mir_program(^overrun, policy).unwrap()
    overrun_checked :: function(overrun_optimized, "auto")
    assert(overrun_checked.optimization.loop_facts.iter().any(fact -> fact.trip_count == Some(5)))
    assert(!overrun_checked.optimization.auto_vectorizable)
    changed := optimized.clone()
    function_mut(&changed, "auto").effects.direct.insert("IO")
    assert(require_canonical_mir_optimization(changed).is_err(), "changed MIR must not inherit the old pass receipt")
    function_mut(&changed, "auto").optimization.pass_ids.clear()
    rejected :: optimize_mir_program(^changed, policy).unwrap()
    rejected_auto :: function(rejected, "auto")
    assert(!rejected_auto.optimization.auto_vectorizable)
    assert(rejected_auto.optimization.vector_facts.iter().all(fact -> !fact.decision.is_eligible()))
    require_canonical_mir_optimization(rejected).unwrap()
    no_op :: optimize_mir_program(rejected.clone(), policy).unwrap()
    assert_eq(rejected.deterministic_digest(), no_op.deterministic_digest(), "reoptimizing unchanged MIR must preserve identity")
}

// Rust: tests/mir_fact_lifecycle.rs:321
#Test("erased_loop_facts_do_not_make_the_function_vectorizable") {
    source :: "fn erased(values: [Float#4]) -> [Float#4] {{\n    output := [Float#4]{{0.0, 0.0, 0.0, 0.0}}\n    #Off {{\n        loop i in 0..<4 {{ output[i] = values[i] * 2.0 }}\n    }}\n    return output\n}}\nfn active(values: [Float#4]) -> [Float#4] {{\n    output := [Float#4]{{0.0, 0.0, 0.0, 0.0}}\n    loop i in 0..<4 {{ output[i] = values[i] * 2.0 }}\n    return output\n}}\nfn run() {{}}\n"
    optimized :: optimize_mir_program(lower_checked(source), MirOptimizationPolicy.conservative()).unwrap()
    erased :: function(optimized, "erased")
    active :: function(optimized, "active")
    assert(!erased.optimization.auto_vectorizable, "erased loop facts must not make the function vectorizable: {erased.optimization:#?}")
    assert(active.optimization.auto_vectorizable, "active loop must retain its optimizer premise: {active.optimization:#?}")
}
// Rust: tests/mir_fact_lifecycle.rs:362
#Test("elementwise_list_writes_keep_copy_cost_outside_the_loop") {
    source :: "fn bare(values: [Float#4]) -> [Float#4] {{\n    output := [Float#4]{{0.0, 0.0, 0.0, 0.0}}\n    loop i in 0..<4 {{ output[i] = values[i] * 2.0 }}\n    return output\n}}\nfn explicit(values: [Float#4]) -> [Float#4] {{\n    output := ~values\n    loop i in 0..<4 {{ output[i] = values[i] * 2.0 }}\n    return output\n}}\nfn run() {{}}\n"
    policy :: MirOptimizationPolicy.conservative()
    optimized :: optimize_mir_program(lower_checked(source), policy).unwrap()
    bare :: function(optimized, "bare")
    bare_loop :: bare.optimization.loop_facts.first().expect("bare elementwise loop fact")
    assert_eq(bare_loop.copy_cost, MirCopyCost.None)
    assert(bare.optimization.vector_facts.iter().any(fact -> fact.decision.is_eligible()), "bare/read elementwise writes must remain vector-eligible")
    explicit :: function(optimized, "explicit")
    explicit_loop :: explicit.optimization.loop_facts.first().expect("explicit-copy elementwise loop fact")
    assert_eq(explicit_loop.copy_cost, MirCopyCost.None)
    explicit_copies :: explicit.blocks.iter().flat_map(block -> block.instructions.iter()).filter(instruction -> if instruction.operation == .Copy{..} { true } else { false }).count()
    assert_eq(explicit_copies, 1, "explicit copy must be materialized once before the loop")
    assert(explicit.optimization.vector_facts.iter().any(fact -> fact.decision.is_eligible()), "explicit-copy destination must retain elementwise eligibility")
}
// Rust: tests/mir_fact_lifecycle.rs:429
#Test("checked_vector_proof_conflicts_cannot_repromote_a_loop") {
    source :: "fn auto(values: [Float#4]) -> [Float#4] {{\n    output := [Float#4]{{0.0, 0.0, 0.0, 0.0}}\n    loop i in 0..<4 {{ output[i] = values[i] * 2.0 }}\n    return output\n}}\nfn run() {{}}\n"
    mir :: lower_checked(source)
    policy :: MirOptimizationPolicy.conservative()
    missing := optimize_mir_program(mir.clone(), policy).unwrap()
    function_mut(&missing, "auto").optimization.checked_vector_facts.clear()
    function_mut(&missing, "auto").optimization.pass_ids.clear()
    missing_checked :: optimize_mir_program(^missing, policy).unwrap()
    assert(function(missing_checked, "auto").optimization.vector_facts.iter().all(fact -> !fact.decision.is_eligible()), "missing checked proof must keep the loop scalar")
    duplicate := optimize_mir_program(mir.clone(), policy).unwrap()
    duplicate_proof :: function(duplicate, "auto").optimization.checked_vector_facts.first().cloned().expect("auto loop checked proof")
    function_mut(&duplicate, "auto").optimization.checked_vector_facts.push(^duplicate_proof)
    function_mut(&duplicate, "auto").optimization.pass_ids.clear()
    duplicate_checked :: optimize_mir_program(^duplicate, policy).unwrap()
    assert(function(duplicate_checked, "auto").optimization.vector_facts.iter().all(fact -> !fact.decision.is_eligible()), "duplicate checked proofs must remain conservatively rejected")
    conflict := optimize_mir_program(mir.clone(), policy).unwrap()
    proof :: function_mut(&conflict, "auto").optimization.checked_vector_facts.first_mut().expect("auto loop checked proof")
    proof.no_cross_iteration_dependencies = false
    function_mut(&conflict, "auto").optimization.pass_ids.clear()
    conflict_checked :: optimize_mir_program(^conflict, policy).unwrap()
    auto :: function(conflict_checked, "auto")
    assert(auto.optimization.vector_facts.iter().all(fact -> !fact.decision.is_eligible()), "conflicting checked proof must not be re-promoted")
    assert(auto.optimization.vector_facts.iter().any(fact -> !fact.no_cross_iteration_dependencies), "the rejected cross-iteration fact must remain visible")
    stale_access := optimize_mir_program(mir.clone(), policy).unwrap()
    stale_proof :: function_mut(&stale_access, "auto").optimization.checked_vector_facts.first_mut().expect("auto loop checked proof")
    assert(!stale_proof.accesses.is_empty())
    stale_proof.accesses.clear()
    function_mut(&stale_access, "auto").optimization.pass_ids.clear()
    stale_checked :: optimize_mir_program(^stale_access, policy).unwrap()
    assert(function(stale_checked, "auto").optimization.vector_facts.iter().all(fact -> !fact.decision.is_eligible()), "a proof with stale access identity must not re-promote the loop")
    changed_cfg := optimize_mir_program(mir.clone(), policy).unwrap()
    checked :: function(changed_cfg, "auto").optimization.checked_vector_facts.first().cloned().expect("auto loop checked proof")
    exit :: function(changed_cfg, "auto").optimization.loop_facts.iter().find(row -> row.header == checked.loop_header).and_then(row -> row.exit).expect("auto loop exit")
    body :: checked.body_blocks[0]
    function_mut(&changed_cfg, "auto").blocks.iter_mut().find(block -> block.id == body).expect("auto loop body block").terminator = MirTerminator.Jump{target: exit}
    function_mut(&changed_cfg, "auto").optimization.pass_ids.clear()
    cfg_checked :: optimize_mir_program(^changed_cfg, policy).unwrap()
    assert(function(cfg_checked, "auto").optimization.vector_facts.iter().all(fact -> !fact.decision.is_eligible()), "CFG mutation must invalidate the checked loop scope")
    explicit_scalar := optimize_mir_program(^mir, policy).unwrap()
    function_mut(&explicit_scalar, "auto").is_scalar = true
    function_mut(&explicit_scalar, "auto").optimization.pass_ids.clear()
    scalar_checked :: optimize_mir_program(^explicit_scalar, policy).unwrap()
    assert(function(scalar_checked, "auto").optimization.vector_facts.iter().all(fact -> !fact.decision.is_eligible()), "an explicit scalar fact must stay on the scalar path")
}
// Rust: tests/mir_fact_lifecycle.rs:593
#Test("columnar_field_arithmetic_keeps_packed_direct_layout") {
    source :: "#Layout(columnar)\nstruct Particle {{\n    x: Float\n    y: Float\n    mass: Float\n}}\nfn energy(ps: [Particle#4]) -> [Float#4] {{\n    output := [Float#4]{{0.0, 0.0, 0.0, 0.0}}\n    loop i in 0..<4 {{ output[i] = ps[i].x * ps[i].y + ps[i].mass }}\n    return output\n}}\nfn run() {{}}\n"
    optimized :: optimize_mir_program(lower_checked(source), MirOptimizationPolicy.conservative()).unwrap()
    energy :: function(optimized, "energy")
    fact :: energy.optimization.vector_facts.iter().find(fact -> fact.layout == MirVectorLayout.ColumnarDirect).unwrap_or_else(() -> panic("missing direct columnar vector fact: {energy.optimization.vector_facts:#?}"))
    assert(fact.decision.is_eligible(), "columnar arithmetic should be eligible: {fact:#?}")
    assert(fact.packed, "columnar arithmetic should retain packed lowering: {fact:#?}")
    assert(fact.no_cross_iteration_dependencies, "independent field reads must not inherit a scalar loop-carried dependency: {fact:#?}")
    assert(fact.accesses.iter().any(access -> access.layout == MirVectorLayout.ColumnarDirect), "vector fact must retain a direct columnar access: {fact:#?}")
    assert(energy.optimization.acceleration_facts.iter().all(fact -> fact.proof.source_proven && fact.proof.no_aliasing && fact.proof.no_cross_iteration_dependencies && fact.proof.no_early_exit && fact.proof.effect_free_body && fact.proof.ownership_safe && fact.proof.failure_order_preserved), "columnar acceleration must retain every checked safety guard")
}

