// Rust: tests/modules.rs:322
#Test("perf_budget_sema_normalizes_rate_and_retains_canonical_facts") {
    source :: (baseline: String, count: String, seconds: I64) -> {
        return "module env.dev {{\n    services: {{ api: {{ enable: true }} }}\n}}\nmodule perf.release {{\n    budgets: [Budget{{\n        name: \"throughput\",\n        scope: .Service(\"api\"),\n        metric: .Throughput,\n        provider: .ServiceProbe(\"api\"),\n        comparison: .AbsoluteFrom(\"{baseline}\"),\n        limit: .AtLeast(Rate{{ count: {count}, per: {seconds}s }}),\n        enforcement: .Warn,\n    }}]\n}}\n"
    }
    first :: collect_perf_specs(source("ci/linux-x64", "100", 2)).expect("valid Rate").remove(0)
    assert_eq(first.comparison, "AbsoluteFrom")
    assert_eq(first.comparison_fact.baseline, Some("ci/linux-x64"))
    assert_eq(first.limit_fact.quantity, BudgetQuantity.Rate{numerator: 1, denominator_ns: 20_000_000})
    assert_eq(first.limit_fact.raw, BudgetRawQuantity.Rate{count_digits: "100", per_digits: "2", per_suffix: "s"})
    second :: collect_perf_specs(source("ci/macos-arm64", "75", 1)).expect("second valid Rate").remove(0)
    assert_ne(first.comparison_fact, second.comparison_fact)
    assert_ne(first.limit_fact, second.limit_fact)
    hostile :: collect_perf_specs(source("ci/linux-x64", "000_100", 2)).expect("Rate with legal leading zeroes and separators").remove(0)
    assert_eq(hostile.limit_fact.quantity, BudgetQuantity.Rate{numerator: 1, denominator_ns: 20_000_000})
    assert_eq(hostile.limit_fact.raw, BudgetRawQuantity.Rate{count_digits: "000_100", per_digits: "2", per_suffix: "s"})
}
// Rust: tests/modules.rs:392
#Test("perf_budget_sema_rejects_named_and_extra_limit_arguments") {
    cases :: [
        ("BinarySize", "", "", "Absolute", "AtMost", "2MiB"),
        ("StartupTime", "scope: .Service(\"api\"),", "provider: .ServiceProbe(\"api\"),", "RelativeTo(\"ci/linux-x64\")", "RegressionAtMost", "3pct"),
        ("Throughput", "scope: .Service(\"api\"),", "provider: .ServiceProbe(\"api\"),", "RelativeTo(\"ci/linux-x64\")", "ImprovementAtLeast", "3pct"),
        ("Throughput", "scope: .Service(\"api\"),", "provider: .ServiceProbe(\"api\"),", "AbsoluteFrom(\"ci/linux-x64\")", "AtLeast", "Rate{{ count: 100, per: 1s }}")
    ]
    loop (metric, scope, provider, comparison, constructor, value) in cases {
        loop limit_expr in [".{constructor}{{ value: {value} }}", ".{constructor}({value}, {value})"] {
            src :: "module env.dev {{ services: {{ api: {{ enable: true }} }} }}\nmodule perf.release {{\n    budgets: [Budget{{\n        name: \"hostile\",\n        {scope}\n        metric: .{metric},\n        {provider}\n        comparison: .{comparison},\n        limit: {limit_expr},\n        enforcement: .Fail,\n    }}]\n}}\n"
            diagnostics :: collect_perf_specs(src).expect_err("limit constructor arity must reject")
            assert_eq(diagnostics[0].code, "E2903", limit_expr)
            assert(diagnostics[0].why.contains("exactly one positional"), "{diagnostics[0]:?}")
        }
    }
}
// Rust: tests/modules.rs:453
#Test("parses_module_shell_with_contribution") {
    src :: "module dev {{\n    env.dev: Env{{\n        prompt: \"wordstats\",\n    }}\n}}\n"
    items :: parse_items(src)
    assert_eq(items.len(), 1)
    m :: if items[0] == .Module(value) { value } else { panic("expected a module item, got {items[0]:?}") }
    assert_eq(m.name, "dev")
    assert(m.is_auto_discovered())
    assert_eq(m.contributions.len(), 1)
    assert_eq(m.contributions[0].namespace, Namespace.Env)
    assert_eq(m.contributions[0].path, "dev")
}
// Rust: tests/modules.rs:477
#Test("parses_nested_sources_and_imports") {
    src :: "module dev {{\n    sources: {{ default: NixOS/nixpkgs/nixos-24.05@github }}\n    imports: find(\"./modules\")\n    env.dev: Env{{\n        prompt: \"wordstats\",\n    }}\n}}\n"
    items :: parse_items(src)
    m :: if items[0] == .Module(value) { value } else { panic("expected a module item, got {items[0]:?}") }
    assert_eq(m.sources.len(), 1)
    assert_eq(m.sources[0].name, "default")
    assert_eq(src[m.sources[0].ref_span.start..m.sources[0].ref_span.end], "NixOS/nixpkgs/nixos-24.05@github")
    assert_eq(m.imports.len(), 1)
    call :: if m.imports[0] == .Call(value) { value } else { panic("expected a call expression, got {m.imports[0]:?}") }
    assert_eq(call.name, "find")
    assert_eq(call.args.len(), 1)
    parts :: if call.args[0].expr == .Str(value, _) { value } else { panic("expected a string argument, got {call.args[0].expr:?}") }
    assert_eq(parts.len(), 1, "expected a single literal string part, got {parts:?}")
    path :: if parts[0] == .Lit(value) { value } else { panic("expected a single literal string part, got {parts:?}") }
    assert_eq(path, "./modules")
    assert_eq(m.contributions.len(), 1)
    assert_eq(m.contributions[0].namespace, Namespace.Env)
    assert_eq(m.contributions[0].path, "dev")
}
