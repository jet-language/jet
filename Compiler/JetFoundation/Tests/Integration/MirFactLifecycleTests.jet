    overlap :: "module perf.release {{\n    budgets: [\n        Budget{{ name: \"binary\", metric: .BinarySize, limit: .AtMost(2MiB) }},\n        Budget{{ name: \"shipping\", metric: .BinarySize, limit: .AtMost(3MiB) }},\n    ]\n}}\n"
    overlapping :: collect_perf_specs(overlap).expect_err("effective overlap")
    assert_eq(overlapping.last().expect("diagnostic").code, "E2904")
}
