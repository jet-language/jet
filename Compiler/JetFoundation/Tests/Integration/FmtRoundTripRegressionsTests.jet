// Rust: tests/fmt_round_trip_regressions.rs:155
#Test("effect_arrows_round_trip_beside_foreign_bodies") {
    source :: """
#Import module c.demo {
    fn probe(value: Int) -> Int = "probe"
}

fn run() -[IO]> Int {
    return 1
}
"""
    formatted :: jet.format_source(source).expect("foreign source should format")
    assert(formatted.contains("fn probe(value: Int) -> Int = \"probe\""), "foreign declaration arrow was not canonicalized:\n{formatted}")
    assert(formatted.contains("fn run() -[IO]> Int"), "effect arrow was not canonicalized:\n{formatted}")
    assert(!formatted.contains("=[IO]=>") && !formatted.contains("Int) => Int"), "retired arrow survived formatting:\n{formatted}")
    assert_eq(formatted, jet.format_source(&formatted).expect("formatted foreign source should reformat"))
}
// Rust: tests/fmt_round_trip_regressions.rs:184
#Test("interpolated_struct_literals_survive_retired_dot_migration") {
    source :: "fn run() -> {{\n    print(\"{{NoDebug{{value: 2}}:Debug}}\")\n    print(\"{{Probe{{value: 2}} == Probe{{value: 1}}:Debug}}\")\n}}\n"
    formatted :: jet.format_source(source).expect("interpolated literals should format")
    assert(formatted.contains("print(\"{{NoDebug{{value: 2}}:Debug}}\")"), "formatter dropped the interpolated struct literal:\n{formatted}")
    assert(formatted.contains("print(\"{{Probe{{value: 2}} == Probe{{value: 1}}:Debug}}\")"), "formatter dropped the interpolated struct comparison:\n{formatted}")
    assert_eq(formatted, jet.format_source(&formatted).expect("formatted interpolations should reformat"))
}
// Rust: tests/fmt_wave_a.rs:62
#Test("preservation_matrix_survives_two_canonical_formatter_passes") {
    cases :: [
        ("comments, tabs, newlines, quotes, and braces", WHITESPACE_AND_LITERALS, ["// tabbed comment: \"quotes\" {{braces}}", "quoted \\\"text\\\" and {{{{braces}}}}; escapes: \\t \\n", "/* nested */ still here */", "print(\"{{value}}\")"]),
        ("triple strings", TRIPLE_STRING, ["banner :: \"\"\"\n", "hello, {{who}}\n", "        indented\n", "print(\"{{banner}}\")"]),
        ("interpolation selectors", INTERPOLATION_SELECTORS, ["print(\"{{price:Fixed(2)}}\")", "print(\"{{price:Grouped(2)}}\")"]),
        ("comments attached to declaration and control boundaries", ATTACHED_COMMENTS, ["// declaration boundary comment", "// control boundary comment", "if true", "print(\"attached\")"]),
    ]
    for (label, source, needles) in cases {
        before :: semantic_identity(source)
        once :: jet.format_source(source).unwrap_or_else((diagnostics) -> panic("fmt failed for {label}: {diagnostics:Debug}"))
        for needle in needles { assert(once.contains(needle), "{label}: formatter dropped {needle:Debug}\n--- got ---\n{once}") }
        assert(once.ends_with('\n'), "{label}: canonical output must end with a newline")
        assert_eq(before, semantic_identity(&once), "{label}: first formatter pass changed semantic identity")
        twice :: jet.format_source(&once).unwrap_or_else((diagnostics) -> panic("second fmt failed for {label}: {diagnostics:Debug}"))
        assert_eq(once, twice, "{label}: formatter is not idempotent")
        assert_eq(semantic_identity(&once), semantic_identity(&twice), "{label}: semantic identity changed across formatter passes")
    }
}
