// Rust: tests/closures.rs:279
#Test("iter_adapters_compile") {
    src :: """
fn run() -> {
    nums := [1, 2, 3, 4, 5]
    print(&nums.take(3).to_list())
    print(nums.skip(2).to_list())
    print(nums.step_by(2).to_list())
    print(nums.dedup().to_list())
    print(nums.take_while((n: Int) -> (n < 4)).to_list())
    print(nums.skip_while((n: Int) -> (n < 4)).to_list())
    sum := nums.fold(0, (acc: Int, n: Int) -> (acc + n))
    print(sum)
    pos := nums.position((n: Int) -> (n == 3))
    print(pos)
    words := ["b", "a", "c"]
    print(words.min_by((w: String) -> w.len()))
    print(words.max_by((w: String) -> w.len()))
    nested := [[1, 2], [3, 4]]
    print(nested.flatten())
    print(nested.lazy().flatten().to_list())
    print(nested.flat_map((xs: [Int]) -> xs))
    print(nested.lazy().flat_map((xs: [Int]) -> xs).to_list())
}
"""
    jet.compile(src).expect("D-ITER1 adapters should compile without user unsafe")
    // MIR core-call facts retain the lazy/eager split previously asserted on
    // Rust helper names, without publishing or inspecting a retired backend.
    checked :: jet.compile(src).unwrap()
    loop name in ["Iter.take", "Iter.from_list", "Iter.skip", "List.fold", "Iter.take_while", "List.flat_map", "List.flatten", "Iter.flatten", "Iter.flat_map"] {
        assert(checked.mir.has_core_call(name), "adapter must preserve canonical lowering {name}")
    }
    assert(!checked.mir.has_core_call("List.take"), "adapters must not eagerly collect then re-wrap")
}
// Rust: tests/closures.rs:351
#Test("iter_chunks_windows") {
    src :: """
fn run() -> {
    nums := [1, 2, 3, 4, 5, 6]
    print(nums.chunks(2).len())
    print(nums.windows(3).len())
}
"""
    checked :: jet.compile(src).expect("chunks/windows should compile")
    assert(checked.mir.has_core_call("Iter.chunks"), "chunks should lower lazily")
    assert(checked.mir.has_core_call("Iter.windows"), "windows should lower lazily")
    tir_support.assert_tiers_agree("closures_chunks_windows", src, "3\n4\n")
}
