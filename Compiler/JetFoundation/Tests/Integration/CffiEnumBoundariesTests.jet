impl Pattern.CheckedText {
    type Error = Error
    fn check(text: String) -[]> Unit Error! { return }
    fn encode_hole<T: Printable>(value: T) -[]> String { return "" }
}
fn run() -> {
    value :: Pattern.raw("already checked")
    print(value.raw())
}
"""
