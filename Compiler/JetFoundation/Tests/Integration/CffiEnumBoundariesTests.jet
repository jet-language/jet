Pattern :: distinct String
impl Pattern.CheckedText {
    fn check(text: String) -[]> Unit Error! { return }
    fn encode_hole<T: Printable>(value: T) -[]> String { return "" }
}
fn run() -> {}
"""
    diagnostics :: jet.compile(source).expect_err("missing associated Error must be rejected")
    assert(diagnostics.iter().any(fn(diagnostic) { diagnostic.code == "E0913" }))
    assert(diagnostics.iter().any(fn(diagnostic) { diagnostic.code == "E0907" }))
}
