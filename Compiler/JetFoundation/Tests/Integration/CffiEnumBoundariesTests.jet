// Rust: tests/cffi_enum_boundaries.rs:24
#Test("cffi_enum_unknown_tag_width_stays_at_the_checked_boundary") {
    diagnostics :: codes("""
use c.bad as c
#Layout(c, tag: U24)
enum BadTag { Ok = 0 }
#Import module c.bad { fn take(value: BadTag) -> I32 = "take_bad_tag" }
fn run() -> {}
""", "jet_cffi_enum_bad_tag")
    assert(diagnostics.iter().any(fn(code) { code == "E0003" }), "unsupported C enum tag width must be rejected by the marker boundary: {diagnostics:?}")
}
// Rust: tests/cffi_enum_boundaries.rs:46
#Test("cffi_enum_out_of_range_discriminant_stays_at_the_checked_boundary") {
    diagnostics :: codes("""
enum BadDiscriminant { TooWide = 9223372036854775808 }
fn run() -> {}
""", "jet_cffi_enum_bad_discriminant")
    assert(diagnostics.iter().any(fn(code) { code == "E0035" }), "an out-of-range enum discriminant must stop before C ABI lowering: {diagnostics:?}")
}
// Rust: tests/cffi_native_matrix.rs:40
#Test("required_native_c_abi_matrix") {
    assert_eq(required("JET_CFFI_MATRIX_REQUIRED"), "1")
    cc :: required("JET_CFFI_CC")
    ar :: required("JET_CFFI_AR")
    // Rust toolchain selection retires in favor of the canonical native target
    // and linker; the required lane still never skips its compilation/execution.
    target :: env.var("JET_CFFI_TARGET").ok()
    linker :: env.var("JET_CFFI_LINKER").ok().unwrap_or(cc.clone())
    runner :: env.var("JET_CFFI_RUNNER").ok()
    abi :: required("JET_CFFI_ABI")
    safe_abi :: abi.replace(['/', ' '], "-")
    root :: env.temp_dir().join("jet-cffi-required-{process.id()}-{safe_abi}")
    _ :: fs.remove_dir_all(&root)
    fs.create_dir_all(&root).unwrap()
    c_source :: root.join("matrix.c")
    fs.write(&c_source, """
#include <stddef.h>
#include <stdint.h>
typedef struct { int64_t x; int64_t y; } Coord;
typedef int32_t Status;
typedef uint8_t PacketTag;
typedef union { int64_t ping; struct { int64_t x; int64_t y; } data; } PacketPayload;
typedef struct { PacketTag tag; PacketPayload payload; } Packet;
int64_t coord_sum(Coord p) { return p.x + p.y; }
int32_t status_value(Status s) { return s; }
int32_t packet_value(Packet p) { return (int32_t)p.tag * 100 + (int32_t)p.payload.ping; }
int32_t packet_size(void) { return (int32_t)sizeof(Packet); }
int32_t packet_align(void) { struct A { char c; Packet p; }; return (int32_t)offsetof(struct A, p); }
int32_t packet_payload_offset(void) { return (int32_t)offsetof(Packet, payload); }
typedef int32_t (*callback_t)(int32_t);
int32_t callback_twice(callback_t cb, int32_t x) { return cb(cb(x)); }
#include <pthread.h>
typedef struct { callback_t cb; int32_t x; int32_t out; } Job;
static void *run_job(void *raw) { Job *j = (Job *)raw; j->out = j->cb(j->x); return 0; }
int32_t callback_parallel(callback_t cb) {
    pthread_t threads[4]; Job jobs[4]; int32_t sum = 0;
    for (int i=0;i<4;i++) { jobs[i]=(Job){cb,i,0}; if(pthread_create(&threads[i],0,run_job,&jobs[i])) return -1000; }
    for (int i=0;i<4;i++) { pthread_join(threads[i],0); sum += jobs[i].out; }
    return sum;
}
typedef struct { uint64_t id; uint32_t flags; } Record;
int32_t load_record(uint64_t id, Record *out) {
    if (id == 7) { out->id=70; out->flags=3; return 0; }
    unsigned char *p=(unsigned char *)out; for(size_t i=0;i<sizeof(*out);i++) p[i]=0xA5;
    return 9;
}
int32_t abi_default(int32_t a, int32_t b) { return a + b; }
int32_t abi_explicit(int32_t a, int32_t b) { return a + b; }
""").unwrap()
    object :: root.join("matrix.o")
    library :: root.join("libjetmatrix.a")
    compile_c := command(&cc)
    compile_c.arg("-c").arg(&c_source).arg("-o").arg(&object)
    run_ok(&compile_c, "C compiler")
    archive := command(&ar)
    archive.arg("rcs").arg(&library).arg(&object)
    run_ok(&archive, "C archiver")
    package_template :: """
name: "jet-cffi-matrix"
version: "0.1.0"
deps: { jetmatrix: c@"__ROOT__" }
"""
    fs.write(root.join("package.jet"), package_template.replace("__ROOT__", root.display().to_string())).unwrap()
    explicit_abi :: match abi.as_str() { "sysv64" => "#ABI(sysv64) "; "default" => ""; other => panic("unsupported matrix ABI {other}") }
    jet_source :: """
use core.mem
use c.jetmatrix as c
#Layout(c)
struct Coord { x: Int; y: Int }
#Layout(c)
enum Status { Ok = 0; Lost = 7 }
#Layout(c, tag: U8)
enum Packet { Ping(Int) = 3; Data(x: Int, y: Int) = 7 }
#Layout(c)
struct Record { id: U64; flags: U32 }
fn increment(x: I32) -[]> I32 { return x + 1 }
#Import module c.jetmatrix {
    fn coord_sum(p: Coord) -> Int = "coord_sum"
    fn status_value(s: Status) -> I32 = "status_value"
    fn packet_value(p: Packet) -> I32 = "packet_value"
    fn packet_size() -> I32 = "packet_size"
    fn packet_align() -> I32 = "packet_align"
    fn packet_payload_offset() -> I32 = "packet_payload_offset"
    fn callback_twice(cb: fn(I32) -[]> I32, x: I32) -> I32 = "callback_twice"
    fn callback_parallel(cb: fn(I32) -[]> I32) -> I32 = "callback_parallel"
    fn load_record(id: U64, out: *Record) -> I32 = "load_record"
    fn abi_default(a: I32, b: I32) -> I32 = "abi_default"
    __EXPLICIT_ABI__fn abi_explicit(a: I32, b: I32) -> I32 = "abi_explicit"
}
fn load(id: U64) -[]> Record Err! {
    slot := Record{id: 0, flags: 0}
    status := I32{ 1 }
    #Unsafe("live non-null out slot; read only after status zero") {
        p :: mem.Ptr<Record>.from_addr(mem.address_of(slot))
        status = c.load_record(id, p)
        if Int.from_i32(status) == 0 { slot = ~p.* }
    }
    if Int.from_i32(status) != 0 { return Err("status {status}") }
    return Ok(slot)
}
fn run() -> {
    print(c.coord_sum(Coord{x: 3, y: 4}))
    print(c.status_value(Status.Lost))
    print(c.packet_value(Packet.Ping(41)))
    print(c.packet_size())
    print(c.packet_align())
    print(c.packet_payload_offset())
    print(c.callback_twice(increment, 40))
    print(c.callback_parallel(increment))
    print((load(7) ?? panic("success expected")).id)
    if load(8) == { .Ok(v) -> { print("unexpected {v.id}") } .Err(e) -> { print(e) } }
    print(c.abi_default(20, 22))
    print(c.abi_explicit(19, 23))
}
""".replace("__EXPLICIT_ABI__", explicit_abi)
    jet_path :: root.join("matrix.jet")
    fs.write(&jet_path, &jet_source).unwrap()
    bundle :: Loader.load_entry(jet_path.to_str().unwrap()).unwrap()
    diagnostics :: check_bundle(&bundle, CompileMode.Run).into_iter().filter(fn(d) { d.severity == Severity.Error }).collect::<[_]>()
    assert(diagnostics.is_empty(), "front end rejected required matrix fixture:\n{diagnostics:?}")
    request :: MirArtifactRequest.new(MirArtifactTarget.Native, MirArtifactKind.NativeExecutable, MirArtifactBuildMode.Dev)
    (mir, artifact) :: lower_checked_mir_program_for(&bundle, request).expect("C ABI matrix lowers through checked MIR")
    mir.validate().expect("C ABI matrix MIR is complete")
    optimized :: optimize_mir_program(mir, &MirOptimizationPolicy.conservative()).unwrap()
    // GATE #4483/#4494: selected-target native object emitter and C ABI/linker.
    layout :: target.map(fn(triple) { TargetLayout.for_triple(triple).unwrap() }).unwrap_or_else(fn() { TargetLayout.host() })
    native_object :: emit_mir_program(&optimized, &NativeConfig { target: layout, root_prefix: "", execution: NativeConfig.for_artifact(artifact) }).unwrap()
    native_path :: root.join("matrix-jet.o")
    fs.write(&native_path, native_object).unwrap()
    compile_native := command(&linker)
    compile_native.arg(&native_path).arg("-o").arg(binary(&root)).arg("-L").arg(&root).arg("-ljetmatrix").arg("-lpthread")
    run_ok(&compile_native, "native compiler/linker")
    execute := match runner { Val(runner) => { cmd := command(&runner); cmd.arg(binary(&root)); cmd }; None => Command.new(binary(&root)) }
    output :: execute.output().expect("could not execute generated matrix binary")
    assert(output.status.success(), "generated matrix failed: {String.from_utf8_lossy(&output.stderr)}")
    lines :: String.from_utf8(output.stdout).unwrap().lines().map(fn(line) { line.to_string() }).collect::<[String]>()
    assert_eq(lines.len(), 12, "unexpected output: {lines:?}")
    assert_eq(lines[0], "7")
    assert_eq(lines[1], "7")
    assert_eq(lines[2], "341")
    assert_eq(&lines[3..<6], &["24", "8", "8"], "wrong native Packet size/alignment/offset")
    assert_eq(&lines[6..], &["42", "10", "70", "status 9", "42", "42"])
    _ :: fs.remove_dir_all(root)
}

