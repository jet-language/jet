// Rust: tests/checked_text.rs:226
#Test("dynamic_checked_text_from_keeps_the_shared_error_report") {
    jet.compile(DYNAMIC_ERROR_SOURCE).expect("dynamic CheckedText source should compile")
    scratch :: common.Scratch.new("checked_text_dynamic_error")
    entry :: scratch.join("main.jet")
    fs.write(&entry, DYNAMIC_ERROR_SOURCE).unwrap()
    // Retired JIT/interpreter/AOT backend checks now retain exact report parity
    // over real O0/O1/O2/Web executions, including conversion and error trail.
    baseline := None as (I32, String, String)?
    loop tier in ["O0", "O1", "O2", "Web"] {
        outcome :: common.run_entry_tier(&entry, tier, false)
        (code, stdout, stderr) :: match outcome { .Ran { exit, stdout, stderr } => (exit, stdout, stderr); other => panic("checked text {tier} did not execute: {other:?}") }
        assert_eq(code, 1, "dynamic checked text failure must escape: {stderr}")
        assert(stdout.is_empty(), "dynamic checked text failure printed stdout: {stdout}")
        assert(stderr.starts_with("Error [E_PATTERN]: pattern rejected (type: PatternError)\n"))
        assert(stderr.contains("  cause: invalid shape\n"))
        assert(stderr.contains("  conversion: PatternError -> Err\n"))
        assert(stderr.contains(") — loading pattern\n"))
        assert(stderr.contains("Trail [E3002]"))
        normalized :: normalize_journey_paths(&stderr)
        match baseline { Val((first_code, first_stdout, first_stderr)) => { assert_eq(code, first_code); assert_eq(stdout, first_stdout); assert_eq(normalized, first_stderr) }; None => { baseline = Val((code, stdout, normalized)) } }
    }
}

// Rust: tests/closures.rs:6
#Test("lambdas_compile_to_rust") {
    src :: """
fn apply(f: fn(Int) -> Int, x: Int) -> Int { return f(f(x)) }
fn run() -> {
    nums :: [1, 2, 3]
    print(nums.map((n: Int) -> n * n).to_list().len())
    total := 0
    nums.each((n: Int) -> { total += n })
    print(total)
    print(apply((x: Int) -> x + 1, 5))
    print(nums.filter((n: Int) -> n > 1).to_list().len())
    print(nums.any((n: Int) -> n == 2))
    print(nums.reduce(0, (acc: Int, n: Int) -> acc + n))
}
"""
    jet.compile(src).expect("closures should compile without user unsafe")
    tir_support.assert_tiers_agree("closures_lambdas", src, "3\n6\n7\n2\ntrue\n6\n")
}
// Rust: tests/closures.rs:37
#Test("single_line_lambda_bodies_need_no_braces") {
    src :: """
struct Box { n: Int }
fn bump(box: Shared<Box>) -> {
    slot :: box.guard_edit().map(b -> b.n)
    slot.value += 1
}
fn run() -> {
    box :: shared Box{n: 0}
    t :: task bump(box)
    t.join() ?? panic("task failed")
    print(box.n)
}
"""
    jet.compile(src).expect("brace-free single-statement lambdas should compile")
    tir_support.assert_tiers_agree("closures_single_line", src, "1\n")
}
// Rust: tests/closures.rs:65
#Test("parallel_adapters_reject_unsafe_boundaries_before_codegen") {
    mutable_capture :: """
fn run() -> {
    seen := [Int]{}
    ignored :: [1, 2, 3].para_map((n: Int) -> { &seen.push(n) })
}
"""
    diags :: jet.compile(mutable_capture).expect_err("mutable parallel capture must fail")
    assert_eq(diags.iter().filter(fn(diag) { diag.code == "E1101" }).count(), 1, "{diags:#?}")
    borrowed_capture :: """
fn run() -> {
    values := [1, 2, 3]
    window :: values[0..1]
    ignored :: [1, 2, 3].para_filter((n: Int) -> window.contains(n))
}
"""
    diags :: jet.compile(borrowed_capture).expect_err("borrowed parallel capture must fail")
    assert(diags.iter().any(fn(diag) { diag.code == "E1102" }), "{diags:#?}")
    hidden_capture :: """
fn run() -> {
    offset :: 1
    callback :: (n: Int) -> n + offset
    ignored :: [1, 2, 3].para_map(callback)
}
"""
    diags :: jet.compile(hidden_capture).expect_err("stored parallel callback must fail")
    assert(diags.iter().any(fn(diag) { diag.code == "E1102" }), "{diags:#?}")
    loop (role, source) in [
        ("item", """
fn bump(n: Int) -> Int { return n + 1 }
fn run() -> {
    callbacks :: [fn(Int) -> Int]{ bump }
    ignored :: callbacks.para_filter((callback: fn(Int) -> Int) -> true)
}
"""),
        ("result", """
fn run() -> { ignored :: [1].para_map((n: Int) -> (x: Int) -> x + n) }
"""),
        ("accumulator", """
fn run() -> {
    ignored :: [1].para_fold(
        () -> (x: Int) -> x,
        (callback: fn(Int) -> Int, n: Int) -> callback,
        (left: fn(Int) -> Int, right: fn(Int) -> Int) -> left
    )
}
"""),
        ("enum payload", """
alias Boxed<T> :: T
enum CallbackPayload { Callback(Boxed<fn(Int) -> Int>) }
fn bump(n: Int) -> Int { return n + 1 }
fn run() -> {
    payloads :: [CallbackPayload]{ CallbackPayload.Callback(bump) }
    ignored :: payloads.para_map((payload: CallbackPayload) -> 1)
}
"""),
        ("stored-function capture", """
fn run() -> {
    stored :: (n: Int) -> n + 1
    ignored :: [1].para_map((n: Int) -> stored(n))
}
""")
    ] {
        diags :: jet.compile(source).expect_err("function-typed worker values must fail in sema")
        assert(diags.iter().any(fn(diag) { diag.code == "E1102" }), "function {role} must stop before native codegen: {diags:#?}")
    }
}
// Rust: tests/closures.rs:157
