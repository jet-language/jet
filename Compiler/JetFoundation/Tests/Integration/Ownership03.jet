//RS #[test]
//RS fn nested_returned_aggregate_stabilizes_each_view_output_slot() {
//RS     let src = r#"
//RS struct Inner { values: View<Int> }
//RS struct Outer { inner: Inner }
//RS 
//RS fn outer(values: [Int]) -[]> Outer {
//RS     selected :: values[0..1]
//RS     return Outer{ inner: Inner{ values: selected } }
//RS }
//RS 
//RS fn run() {
//RS     values := [7, 8]
//RS     result :: outer(values)
//RS     print(result.inner.values[0])
//RS }
//RS "#;
//RS     let out =
//RS         jet::compile(src).expect("nested returned aggregate must carry transitive view provenance");
//RS     assert!(
//RS         out.rust.contains("pub struct __jet_Inner<'__jet___view>"),
//RS         "{}",
//RS         out.rust
//RS     );
//RS     assert!(
//RS         out.rust.contains("pub struct __jet_Outer<'__jet___view>"),
//RS         "{}",
//RS         out.rust
//RS     );
//RS     assert!(
//RS         out.rust
//RS             .contains("pub __jet_inner: __jet_Inner<'__jet___view>"),
//RS         "{}",
//RS         out.rust
//RS     );
//RS     assert!(
//RS         out.rust.contains("-> JetOutcome<__jet_Outer<'__jet___view>, JetErr>"),
//RS         "{}",
//RS         out.rust
//RS     );
//RS }
//RS 
//RS /// The property: a wrapper around a view-bearing value renders the view
//RS /// lifetime on the NAMED LEAF that actually holds the window, never on the
//RS /// wrapper itself. Put it on the wrapper and every value of that wrapper type
//RS /// would be tied to one owner's storage, whether or not it carries a window.
//RS ///
//RS /// The wrappers are spelled `JetOutcome<…>` now, not `Option`/`Result`.
//RS /// D-FAIL-CARRIER1=A / D-FAIL-MODEL1=A (ratified 2026-08-06,
//RS /// crates/jet-foundation/src/Outcome.rs:1-22) make one carrier serve both
//RS /// surface forms: `T?` is `JetOutcome<T, JetAbsent>` and `T !E` is
//RS /// `JetOutcome<T, E>`. A raw `Option` here would be the second optional
//RS /// representation that decision exists to remove. The leaf-not-wrapper
//RS /// property is untouched by the rename, so the negative guards move to the
//RS /// carrier's own name — without them these assertions would still pass on a
//RS /// build that parameterized the wrapper too.
//RS #[test]
//RS fn wrapper_returned_view_aggregates_render_lifetimes_on_named_leaves() {
//RS     let src = r#"
//RS struct Window { values: View<Int> }
//RS struct Holder { maybe: Window? }
//RS struct GenericHolder<T> { value: T, maybe: Window? }
//RS 
//RS fn maybe(values: [Int]) -[]> (Window?) {
//RS     selected :: values[0..1]
//RS     return Val(Window{ values: selected })
//RS }
//RS 
//RS fn result(values: [Int]) -[]> Window String! {
//RS     selected :: values[0..1]
//RS     return Ok(Window{ values: selected })
//RS }
//RS 
//RS fn tuple(values: [Int]) -[]> (window: Window, count: Int) {
//RS     selected :: values[0..1]
//RS     return (window: Window{ values: selected }, count: 1)
//RS }
//RS 
//RS fn run() { print(0) }
//RS "#;
//RS     let out = jet::compile(src).expect("wrapper returns must preserve view provenance");
//RS     assert!(
//RS         out.rust
//RS             .contains("JetOutcome<__jet_Window<'__jet___view>, JetAbsent>"),
//RS         "{}",
//RS         out.rust
//RS     );
//RS     assert!(
//RS         out.rust
//RS             .contains("JetOutcome<__jet_Window<'__jet___view>, String>"),
//RS         "{}",
//RS         out.rust
//RS     );
//RS     assert!(
//RS         out.rust
//RS             .contains("pub __jet_window: __jet_Window<'__jet___view>"),
//RS         "{}",
//RS         out.rust
//RS     );
//RS     assert!(
//RS         out.rust
//RS             .contains("pub struct __jet_GenericHolder<'__jet___view, T"),
//RS         "{}",
//RS         out.rust
//RS     );
//RS     assert!(
//RS         out.rust
//RS             .contains("pub __jet_maybe: JetOutcome<__jet_Window<'__jet___view>, JetAbsent>"),
//RS         "{}",
//RS         out.rust
//RS     );
//RS     assert!(
//RS         !out.rust.contains("JetOutcome<'__jet___view"),
//RS         "{}",
//RS         out.rust
//RS     );
//RS     assert!(!out.rust.contains("Option<'__jet___view"), "{}", out.rust);
//RS     assert!(!out.rust.contains("Result<'__jet___view"), "{}", out.rust);
//RS }
//RS 
