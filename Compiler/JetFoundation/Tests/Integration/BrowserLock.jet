fn scratch_dir(label: &String) -> OSPath {
    n :: COUNTER.fetch_add(1, Ordering.Relaxed)
    dir :: std.env.temp_dir().join("jet-buildnorm-scriptdeps-{label}-{std.process.id()}-{n}")
    fs.create_dir_all(&dir).unwrap()
    dir
}
// Rust: tests/build_cache_normalization.rs:70
fn write_scratch_file(root: &OSPath, relative: &String, contents: &[U8]) -> OSPath {
    path :: root.join(relative)
    fs.create_dir_all(path.parent().unwrap()).unwrap()
    fs.write(&path, contents).unwrap()
    path
}
