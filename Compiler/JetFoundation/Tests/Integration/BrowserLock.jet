// Rust: tests/browser_lock.rs:22
// GATE #4494: native clock and filesystem.
fn temp_root(label: &String) -> OSPath {
    nanos :: SystemTime.now().duration_since(UNIX_EPOCH).unwrap().as_nanos()
    root :: std.env.temp_dir().join("jet-browser-provision-{label}-{nanos}")
    fs.create_dir_all(&root).unwrap()
    root
}
// Rust: tests/browser_lock.rs:32
// GATE #4494: native Unix permission bits.
fn write_executable(path: &OSPath, body: &String) -> {
    if path.parent() == Val(parent) { fs.create_dir_all(parent).unwrap() }
    fs.write(path, body).unwrap()
    perms := fs.metadata(path).unwrap().permissions()
    perms.set_mode(0o755)
    fs.set_permissions(path, perms).unwrap()
}
// Rust: tests/browser_lock.rs:42
// GATE #4494: real process provider.
fn run_jetpack(root: &OSPath, args: &[String]) -> (I32, String, String) {
    output :: Command.new(jetpack_bin()).current_dir(root).args(args).output().expect("jetpack")
    (output.status.code().unwrap_or(1), String.from_utf8_lossy(&output.stdout).to_string(), String.from_utf8_lossy(&output.stderr).to_string())
}
// Rust: tests/browser_lock.rs:55
fn run_jet_source(root: &OSPath, source: &String) -> (I32, String, String) {
    path :: root.join("main.jet")
    fs.write(&path, source).unwrap()
    output :: Command.new(jet_bin()).current_dir(root).env("JET_PROJECT_ROOT", root).args(["run", path.to_str().unwrap()]).output().expect("jet run")
    (output.status.code().unwrap_or(1), String.from_utf8_lossy(&output.stdout).to_string(), String.from_utf8_lossy(&output.stderr).to_string())
}
// Rust: tests/build_cache_normalization.rs:19
// GATE #4494: relaxed native atomic uniqueness counter.
COUNTER :: AtomicU64.new(0)
// Rust: tests/build_cache_normalization.rs:24
// Fixed basename preserves the filename-derived alias across variants.
fn key_with(src: &String, profile_tag: &String, version: &String) -> String {
    n :: COUNTER.fetch_add(1, Ordering.Relaxed)
    dir :: std.env.temp_dir().join("jet-buildnorm-{std.process.id()}-{n}")
    fs.create_dir_all(&dir).unwrap()
    file :: dir.join("prog.jet")
    fs.write(&file, src).unwrap()
    bundle :: Loader.load_entry_with_overlay(file.to_str().unwrap(), None, false).unwrap_or_else((d) -> panic("test program should parse:\n{src}\n{d:?}"))
    result :: CanonicalAST.ast_cache_key(&bundle, profile_tag, version, &bundle.build_facts)
    _ :: fs.remove_dir_all(&dir).ok()
    result
}
// Rust: tests/build_cache_normalization.rs:40
fn key_with_target_dossier(bundle: &ProgramBundle, mutate: fn(&TargetDossier) -> ()) -> String {
    facts := bundle.build_facts.clone()
    mutate(&facts.target_dossier)
    CanonicalAST.ast_cache_key(bundle, "default", "test-version", &facts)
}
// Rust: tests/build_cache_normalization.rs:50
fn key_with_target_triple(bundle: &ProgramBundle, target_triple: &String) -> String {
    facts := bundle.build_facts.clone()
    facts.target_triple = target_triple.to_string()
    CanonicalAST.ast_cache_key(bundle, "default", "test-version", &facts)
}
// Rust: tests/build_cache_normalization.rs:57
fn key(src: &String) -> String { key_with(src, "default", "test-version") }
