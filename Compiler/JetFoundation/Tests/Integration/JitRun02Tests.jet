// Rust: tests/jit_run.rs:3028
#Test("native_source_helper_reenters_from_interface_and_catches_inner_error") {
    scratch :: common.Scratch.new("jit_nested_source_helper_interface")
    file :: scratch.join("run.jet")
    fs.write(&file, """
trait Bridge { fn invoke(&self, value: Int) -[]> Int }
fn nested(value: Int) -[]> Int { return value + 10 }
fn outer(service: Bridge, value: Int) -[]> Int {
    before :: value * 2
    answer :: service.invoke(value)
    return before + answer
}
fn run() -> {}
""").unwrap()
    shown :: file.to_string_lossy().into_owned()
    bundle := jet.Loader.load_entry(&shown).expect("nested helper fixture loads")
    diagnostics :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run)
    assert(diagnostics.iter().all(fn(diagnostic) { diagnostic.severity != jet.Diagnostics.Severity.Error }), "nested helper fixture must type-check: {diagnostics:#?}")
    // GATE #4494: retained checked helper/interface ABI; no retiring JIT implementation.
    (program, artifact) :: common.lower_native_bundle(&bundle).unwrap_or_else(fn(error) { panic("nested helper fixture must lower to canonical MIR: {error}") })
    trait_row :: program.traits.iter().find(fn(row) { row.name == "Bridge" }).expect("checked Bridge trait")
    method_row :: trait_row.methods.iter().find(fn(row) { row.name == "invoke" }).expect("checked Bridge.invoke method")
    outer :: program.functions.iter().find(fn(row) { row.name == "outer" }).expect("checked outer helper")
    nested :: program.functions.iter().find(fn(row) { row.name == "nested" }).expect("checked nested helper")
    outer_id :: outer.id
    nested_id :: nested.id
    receiver_type :: outer.params[0].ty.clone()
    method :: NativeInterfaceMethod.checked(&program, artifact, trait_row.id, method_row.id, receiver_type).expect("checked native Bridge.invoke descriptor")
    bindings :: Arc.new(NativeInterfaceBindings.new())
    object :: bindings.create_object(()).expect("native bridge object")
    source_resources :: Arc.new(SourceResourceSession.new())
    callback_errors :: Arc.new(AtomicUsize.new(0))
    nested_error_caught :: Arc.new(AtomicUsize.new(0))
    handler_calls :: Arc.new(AtomicUsize.new(0))
    unexpected_source_fallback :: Arc.new(AtomicUsize.new(0))
    nested_program :: Arc.new(program)
    nested_policy :: common.development_policy()
    handler_resources :: source_resources.clone()
    handler_program :: nested_program.clone()
    handler_policy :: nested_policy.clone()
    handler_callback_errors :: callback_errors.clone()
    handler_error_caught :: nested_error_caught.clone()
    handler_calls_count :: handler_calls.clone()
    handler_unexpected_fallback :: unexpected_source_fallback.clone()
    bindings.bind(object.clone(), method.identity.clone(), method.signature.clone(), Arc.new(fn(_object, call) {
        handler_calls_count.fetch_add(1, Ordering.SeqCst)
        value :: match call.argument(0).map(fn(argument) { &argument.value }) {
            Some(MirRuntimeValue.Int(value)) -> *value,
            _ -> return Err("Bridge.invoke received no checked Int value"),
        }
        lease :: handler_resources.retain_root().map_err(fn(error) { error.to_string() })?
        if value == -1 {
            source_callback_errors :: handler_callback_errors.clone()
            error :: execute_source_helper_entry(handler_program.as_ref(), artifact, &[nested_id], nested_id, &lease, [SourceHelperArgument.Owned(MirRuntimeValue.Int(7))], SourceExecutionPolicy.SourceOnly, &handler_policy, fn(_request) {
                source_callback_errors.fetch_add(1, Ordering.SeqCst)
                Err("inner Source callback failure")
            })
            return match error {
                Err(error) -> {
                    invoked :: match error.failure() { SourceHelperInvocationFailure.Invoked { .. } -> true, _ -> false }
                    cause :: error.to_string()
                    error.record_completion().map_err(fn(completion) { "inner completion has no parent owner: {completion:?}" })?
                    if invoked { handler_error_caught.fetch_add(1, Ordering.SeqCst); Ok(MirRuntimeValue.Int(90)) } else { Err("inner failure was pre-invocation: {cause}") }
                },
                Ok(_) -> Err("inner Source callback failure was not returned"),
            }
        }
        fallback_calls :: handler_unexpected_fallback.clone()
        execution :: execute_source_helper_entry(handler_program.as_ref(), artifact, &[nested_id], nested_id, &lease, [SourceHelperArgument.Owned(MirRuntimeValue.Int(value))], SourceExecutionPolicy.NativeWithSourceFallback, &handler_policy, fn(_request) {
            fallback_calls.fetch_add(1, Ordering.SeqCst)
            Err("native nested helper unexpectedly requested Source")
        }).map_err(fn(error) { error.to_string() })?
        if execution.tier != SourceExecutionTier.Native { return Err("nested helper did not execute in the native tier") }
        (execution, projected) :: execution.with_completion_scope(fn(execution) { execution.take_result().expect("nested helper returns one projection") })
        completion :: execution.retire()
        SourceExecutionCompletionScope.record_current(completion).map_err(fn(completion) { "nested completion has no parent owner: {completion:?}" })?
        match projected.value {
            Some(MirRuntimeValue.Int(value)) -> Ok(MirRuntimeValue.Int(value)),
            _ -> Err("nested helper returned no checked Int value"),
        }
    })).expect("bind exact native Bridge.invoke implementation")
    outer_lease :: source_resources.retain_root().expect("retain outer helper source root")
    pure_helper :: execute_source_helper_entry(nested_program.as_ref(), artifact, &[nested_id], nested_id, &outer_lease, [SourceHelperArgument.Owned(MirRuntimeValue.Int(30))], SourceExecutionPolicy.NativeWithSourceFallback, &nested_policy, fn(_request) { Err("pure helper unexpectedly requested Source") }).expect("a private pure helper needs no interface scope")
    assert_eq(pure_helper.tier, SourceExecutionTier.Native)
    pure_value :: match pure_helper.retire().disposition {
        SourceExecutionCompletionDisposition.Invoked { retirement: Some(SourceExecutionCompletionRetirement.Completed(retirement)), .. } -> retirement.value,
        other -> panic("private pure helper did not retain its result: {other:?}"),
    }
    assert_eq(pure_value, Some(MirRuntimeValue.Int(40)))
    no_scope_values :: [object.as_runtime_value(), MirRuntimeValue.Int(10)]
    no_scope_error :: match execute_source_helper_entry(nested_program.as_ref(), artifact, &[outer_id], outer_id, &outer_lease, [SourceHelperArgument.Owned(object.as_runtime_value()), SourceHelperArgument.Owned(MirRuntimeValue.Int(10))], SourceExecutionPolicy.NativeWithSourceFallback, &nested_policy, fn(_request) { Err("scope preflight must not enter Source") }) {
        Err(error) -> error,
        Ok(_) -> panic("a reachable native interface call needs its checked scope"),
    }
    match no_scope_error.failure() {
        SourceHelperInvocationFailure.NotInvoked { cause: SourceDeoptError.NativeInterface(NativeInterfaceError.MissingBinding), entry_values, .. } -> assert_eq(entry_values, &no_scope_values),
        _ -> panic("missing native interface scope must fail before invocation"),
    }
    assert_eq(no_scope_error.entry_values(), Some(no_scope_values.as_slice()))
    assert_eq(handler_calls.load(Ordering.SeqCst), 0)
    assert_eq(unexpected_source_fallback.load(Ordering.SeqCst), 0)
    drop(no_scope_error)
    _activation :: bindings.activate(nested_program.as_ref(), artifact).expect("activate checked native bridge")
    // Build one identity index rather than repeated scans over every candidate function.
    function_ids :: nested_program.functions.iter().map(fn(function) { function.id }).collect<HashSet<MirFunctionId>>()
    missing_helper_id :: (0..).map(MirFunctionId).find(fn(candidate) { !function_ids.contains(candidate) }).expect("the checked MIR has an unused function identity")
    preflight_values :: [object.as_runtime_value(), MirRuntimeValue.Int(77)]
    preflight_arguments :: [SourceHelperArgument.Owned(object.as_runtime_value()), SourceHelperArgument.Owned(MirRuntimeValue.Int(77))]
    calls :: unexpected_source_fallback.clone()
    preflight_error :: match execute_source_helper_entry(nested_program.as_ref(), artifact, &[], missing_helper_id, &outer_lease, preflight_arguments, SourceExecutionPolicy.NativeWithSourceFallback, &common.development_policy(), fn(_request) {
        calls.fetch_add(1, Ordering.SeqCst)
        Err("preflight failure must not enter Source")
    }) {
        Err(error) -> error,
        Ok(_) -> panic("missing helper must fail before native or Source invocation"),
    }
    match preflight_error.failure() {
        SourceHelperInvocationFailure.NotInvoked { entry_values, .. } -> assert_eq(entry_values, &preflight_values),
        _ -> panic("missing helper must fail before invocation"),
    }
    assert_eq(preflight_error.entry_values(), Some(preflight_values.as_slice()))
    drop(preflight_error)
    policy :: common.development_policy()
    success :: execute_source_helper_entry(nested_program.as_ref(), artifact, &[outer_id], outer_id, &outer_lease, [SourceHelperArgument.Owned(object.as_runtime_value()), SourceHelperArgument.Owned(MirRuntimeValue.Int(10))], SourceExecutionPolicy.NativeWithSourceFallback, &policy, fn(_request) { Err("outer helper unexpectedly requested Source") }).expect("outer native helper returns after nested native execution")
    assert_eq(success.tier, SourceExecutionTier.Native)
    match &success.outcome { Some(jet.Interpreter.RunOutcome.Ran { exit_code: 0, .. }) -> {}, _ -> panic("successful helper must finish normally") }
    success_retirement :: match success.retire().disposition {
        SourceExecutionCompletionDisposition.Invoked { cause: None, retirement: Some(SourceExecutionCompletionRetirement.Completed(retirement)), .. } -> retirement,
        _ -> panic("successful helper completion must retain its retirement"),
    }
    assert_eq(success_retirement.value, Some(MirRuntimeValue.Int(40)))
    recovered :: execute_source_helper_entry(nested_program.as_ref(), artifact, &[outer_id], outer_id, &outer_lease, [SourceHelperArgument.Owned(object.as_runtime_value()), SourceHelperArgument.Owned(MirRuntimeValue.Int(-1))], SourceExecutionPolicy.NativeWithSourceFallback, &policy, fn(_request) { Err("outer helper unexpectedly requested Source") }).expect("outer native helper resumes after catching the nested Source error")
    assert_eq(recovered.tier, SourceExecutionTier.Native)
    match &recovered.outcome { Some(jet.Interpreter.RunOutcome.Ran { exit_code: 0, .. }) -> {}, _ -> panic("recovered helper must finish normally") }
    recovered_retirement :: match recovered.retire().disposition {
        SourceExecutionCompletionDisposition.Invoked { cause: None, retirement: Some(SourceExecutionCompletionRetirement.Completed(retirement)), .. } -> retirement,
        _ -> panic("recovered helper completion must retain its retirement"),
    }
    assert_eq(recovered_retirement.value, Some(MirRuntimeValue.Int(88)))
    assert_eq(handler_calls.load(Ordering.SeqCst), 2)
    assert_eq(callback_errors.load(Ordering.SeqCst), 1)
    assert_eq(nested_error_caught.load(Ordering.SeqCst), 1)
    assert_eq(unexpected_source_fallback.load(Ordering.SeqCst), 0)
    drop(outer_lease)
    source_resources.retire().expect("retire shared parent Source resources")
}
