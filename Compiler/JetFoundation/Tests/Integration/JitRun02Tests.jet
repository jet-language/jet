// Rust: tests/jit_run.rs:1797
#Test("data_tree_list_extend_runs_resident_and_snapshots_self_extension") {
    assert_typed_fast_path_fixture_with_manifest("jit_data_tree_extend", """
fn text_value(value: DataTree) -> String {
    return if value == { .Text(text) -> ~text else -> "" }
}
fn run() -> {
    values := [DataTree]{DataTree.Text("a"), DataTree.Text("b")}
    other := [DataTree]{DataTree.Text("c"), DataTree.Text("d")}
    &values.extend(other)
    loop value in values { print(text_value(~value)) }
    &values.extend(values)
    loop value in values { print(text_value(~value)) }
}
""", "a\nb\nc\nd\na\nb\nc\nd\na\nb\nc\nd\n", Some("name: \"jit_data_tree_extend\"\nversion: \"0.1.0\"\nauthority: { holds: { allow: [IO, Mem.Alloc] } }\n"))
}
// Rust: tests/jit_run.rs:1886
#Test("data_tree_for_in_nested_conditions_run_resident") {
    assert_typed_fast_path_fixture_with_manifest("jit_data_tree_for_in", """
fn text_value(value: DataTree) -> String {
    return if value == { .Text(text) -> ~text else -> "" }
}
fn run() -> {
    rows := [DataTree]{DataTree.Text("target"), DataTree.Text("other")}
    found := false
    loop row in rows {
        if text_value(~row) == "target" && !found && true -> found = true
    }
    print(found)
}
""", "true\n", Some("name: \"jit_data_tree_for_in\"\nversion: \"0.1.0\"\nauthority: { holds: { allow: [IO, Mem.Alloc] } }\n"))
}
