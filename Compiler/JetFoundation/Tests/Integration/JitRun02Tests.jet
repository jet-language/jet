    assert_typed_fast_path_fixture_with_manifest("jit_result_err_try_sort_by", """
fn epoch_order(epoch: String) -> Int Err! {
    if epoch == "a" -> return Ok(1)
    if epoch == "bb" -> return Ok(2)
    return Ok(3)
}
fn run() -> {
    epochs := ["ccc", "a", "bb"]
    &epochs.sort_by((epoch: String) -> epoch_order(epoch))
    loop epoch in epochs { print(epoch) }
}
""", "a\nbb\nccc\n", None)
}
