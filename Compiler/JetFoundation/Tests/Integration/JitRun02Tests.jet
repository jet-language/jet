// Rust: tests/jit_run.rs:2342
#Test("tower_data_tree_helpers_select_resident_tier") {
    source_root :: OSPath.from(env.manifest_dir()).join("dogfood/tower")
    dir :: common.unique_tmp("jit_tower_data_tree_helpers")
    fs.create_dir_all(&dir).unwrap()
    fs.copy(source_root.join("run.jet"), dir.join("run.jet")).unwrap()
    fs.copy(source_root.join("package.jet"), dir.join("package.jet")).unwrap()
    path :: dir.join("run.jet")
    bundle := jet.Loader.load_entry(path.to_str().unwrap()).expect("Tower run should load")
    diagnostics :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run)
    assert(diagnostics.iter().all(fn(diagnostic) { diagnostic.severity != jet.Diagnostics.Severity.Error }), "Tower run should type-check: {diagnostics:#?}")
    // Every helper remains in the compiled program; no retired tier-plan representation is asserted.
    for tier in ["O0", "O1", "O2", "Web"] {
        common.compile_entry_tier(&path, tier).expect("Tower run and DataTree/HTTP/filesystem/hash helpers must compile")
    }
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/jit_run.rs:2419
#Test("lowering_failure_is_not_resident_covered") {
    dir :: common.unique_tmp("jit_safety_no_program")
    fs.create_dir_all(&dir).unwrap()
    file :: dir.join("lib_only.jet")
    fs.write(&file, "fn helper() { print(1) }\n").unwrap()
    bundle := jet.Loader.load_entry(file.to_str().unwrap()).unwrap()
    _ :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Check)
    for tier in ["O0", "O1", "O2", "Web"] {
        result :: common.compile_entry_tier(&file, tier)
        assert(result.is_err(), "a file with no run must not compile an executable {tier} program")
        reason :: result.unwrap_err().to_string()
        assert(!reason.is_empty(), "lowering failure must carry a diagnostic reason")
    }
    _ :: fs.remove_dir_all(&dir)
}
