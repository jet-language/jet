use TirSupport.[assert_tiers_agree, build_and_run, build_and_run_multi, have_rustc, run_default_multi, run_interpret_multi]
use std.[env, fs, process]
use jet.[check_with_path, compile_with_path, render_diagnostics]
use jet.Diagnostics.Severity
// GATE #4494: actual filesystem and canonical compiler/CLI/native tier providers.

// Rust: tests/tir_modules_and_enums.rs:16
#Test("grouped_nested_core_import_binds_dotted_leaf") {
