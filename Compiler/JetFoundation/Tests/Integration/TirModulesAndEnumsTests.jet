}
"""
    assert_tiers_agree("grouped_nested_core_import", source, "[42]\n")
}
// Rust: tests/tir_modules_and_enums.rs:28
#Test("soft_public_imports_warn_once_per_outside_use") {
    dir := env.temp_dir().join("jet_soft_public_{process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).unwrap()
    fs.write(dir.join("note.jet"), "pub struct Note {\n    pub _title: String\n}\nimpl Note {\n    pub fn _length(self) -> Int { return 1 }\n}\npub fn _legacy() -> Int { return 2 }\n").unwrap()
    source := "use \"note\"\nuse note._legacy\nfn run() -> {\n    n :: note.Note{ _title: \"hi\" }\n    print(n._title)\n    print(n._length())\n    print(note._legacy())\n    print(_legacy())\n}\n"
    main := dir.join("main.jet")
    fs.write(main, source).unwrap()
    diagnostics := check_with_path(main.to_str().unwrap())
    assert(diagnostics.iter().all(d -> d.severity != Severity.Error), "{diagnostics:#?}")
    assert_eq(diagnostics.iter().filter(d -> d.code == "L0601").count(), 5, "{diagnostics:#?}")
    _ :: fs.remove_dir_all(dir)
}
// Rust: tests/tir_modules_and_enums.rs:60
#Test("soft_public_reexports_warn_on_the_exported_spelling_once") {
    dir := env.temp_dir().join("jet_soft_public_reexport_{process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir.join("api")).unwrap()
    fs.write(dir.join("api/module.jet"), "pub use implementation.[_raw as stable, supported as _preview]\nmodule implementation\n").unwrap()
    fs.write(dir.join("api/implementation.jet"), "pub fn _raw() -> Int { return 1 }\npub fn supported() -> Int { return 2 }\n").unwrap()
    main := dir.join("main.jet")
    fs.write(main, "module api\nfn run() -> {\n    print(api.stable())\n    print(api._preview())\n}\n").unwrap()
    diagnostics := check_with_path(main.to_str().unwrap())
    lints := diagnostics.iter().filter(d -> d.code == "L0601").collect()
    assert_eq(lints.len(), 1, "{diagnostics:#?}")
    assert_eq(lints[0].what, "`_preview` is a soft-public API")
    _ :: fs.remove_dir_all(dir)
}
// Rust: tests/tir_modules_and_enums.rs:92
#Test("imported_soft_public_declared_types_warn_once_per_occurrence") {
    dir := env.temp_dir().join("jet_soft_public_types_{process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).unwrap()
    fs.write(dir.join("models.jet"), "pub struct _Cell<T> { pub value: T }\npub trait _Readable { fn read(self) -> Int }\n").unwrap()
    main := dir.join("main.jet")
    fs.write(main, "use \"models\"\nfn adapt<T: _Readable>(value: ^models._Cell<Int>) -> models._Cell<Int> { return value }\nfn local(value: ^models._Cell<Int>) -> { cell := value }\nfn run() -> {}\n").unwrap()
    diagnostics := check_with_path(main.to_str().unwrap())
    assert(diagnostics.iter().all(d -> d.severity != Severity.Error), "{diagnostics:#?}")
    assert_eq(diagnostics.iter().filter(d -> d.code == "L0601").count(), 4, "{diagnostics:#?}")
    _ :: fs.remove_dir_all(dir)
}
// Rust: tests/tir_modules_and_enums.rs:127
#Test("local_soft_public_types_win_over_imported_name_collisions") {
    dir := env.temp_dir().join("jet_soft_public_type_collision_{process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).unwrap()
    fs.write(dir.join("library.jet"), "pub struct _Thing { pub value: Int }\npub trait _Shape { fn size(self) -> Int }\n").unwrap()
    main := dir.join("main.jet")
    fs.write(main, "use \"library\"\nstruct _Thing { value: Int }\ntrait _Shape { fn size(self) -> Int }\nfn keep<T: _Shape>(value: ^_Thing) -> _Thing { return value }\nfn run() -> {}\n").unwrap()
    diagnostics := check_with_path(main.to_str().unwrap())
    assert(diagnostics.iter().all(d -> d.severity != Severity.Error), "{diagnostics:#?}")
    assert_eq(diagnostics.iter().filter(d -> d.code == "L0601").count(), 0, "{diagnostics:#?}")
    _ :: fs.remove_dir_all(dir)
}
