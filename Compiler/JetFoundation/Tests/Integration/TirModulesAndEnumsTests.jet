// Rust: tests/tir_modules_and_enums.rs:273
#Test("inline_module_use_list_and_pub_reexport_match_all_tiers") {
    src := """
module math {
    pub fn double(n: Int) -> Int { return (n * 2) }
}
module api {
    use math.[double as twice]
    pub use math.[double as exported]
    pub fn local(n: Int) -> Int { return twice(n) }
}
fn run() -> {
    print(api.local(4))
    print(api.exported(5))
}
"""
    if have_rustc() {
        (code, stdout) := build_and_run("tir_inline_use_list", src)
        assert_eq(code, 0)
        assert_eq(stdout, "8\n10\n")
    }
    (code, stdout, stderr) := run_default_multi("inline_use_list", "main.jet", [("main.jet", src)])
    assert_eq(code, 0, "{stderr}")
    assert_eq(stdout, "8\n10\n")
    // Retired tier1/tier0 trace assertions become actual retained-tier behavior.
    (code, stdout, stderr) := run_interpret_multi("inline_use_list", "main.jet", [("main.jet", src)])
    assert_eq(code, 0, "forced execution rejected inline imports: {stderr}")
    assert_eq(stdout, "8\n10\n")
}
// Rust: tests/tir_modules_and_enums.rs:328
#Test("inline_module_core_use_list_and_pub_reexport_match_all_tiers") {
    src := """
use core.math.[abs, min, max, clamp]
module api {
    use core.[math.abs]
    pub use core.[math.abs as exported]
    pub fn local(n: Int) -> Int { return abs(n) }
}
fn run() -> {
    print(abs(-3))
    print(min(9, 4))
    print(max(9, 4))
    print(clamp(12, 0, 10))
    print(min(9.0, 4.0))
    print(max(9.0, 4.0))
    print(clamp(12.0, 0.0, 10.0))
    print(api.local(-7))
    print(api.exported(-5))
}
"""
    expected := "3\n4\n9\n10\n4.0\n9.0\n10.0\n7\n5\n"
    if have_rustc() {
        (code, stdout) := build_and_run("tir_inline_core_use_list", src)
        assert_eq(code, 0)
        assert_eq(stdout, expected)
    }
    (code, stdout, stderr) := run_default_multi("inline_core_use_list", "main.jet", [("main.jet", src)])
    assert_eq(code, 0, "{stderr}")
    assert_eq(stdout, expected)
    (code, stdout, stderr) := run_interpret_multi("inline_core_use_list", "main.jet", [("main.jet", src)])
    assert_eq(code, 0, "forced execution rejected inline Core imports: {stderr}")
    assert_eq(stdout, expected)
}
