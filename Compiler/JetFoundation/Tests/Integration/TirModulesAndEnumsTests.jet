// Rust: tests/tir_modules_and_enums.rs:1030
#Test("struct_payload_enum") {
    if !have_rustc() { return }
    src := """
struct Point {
    x: Int
    y: Int
}
enum Shape {
    Dot(Point)
    Line(Int)
}
fn mk(p: Point) -> Shape { return Shape.Dot(~p) }
fn first(s: Shape) -> Int {
    if s == {
        .Dot(p) -> { return p.x }
        .Line(n) -> { return n }
    }
    return 0
}
fn run() -> {
    pt :: Point{ x: 3, y: 4 }
    sh :: mk(pt)
    print("{first(sh)}")
}
"""
    (code, stdout) := build_and_run("tir_struct_payload_enum", src)
    assert_eq(code, 0)
    assert_eq(stdout, "3\n")
}
