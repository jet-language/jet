#Test("recursive_boxed_enum") {
    if !have_rustc() { return }
    src := """
enum Tree {
    Leaf(Int)
    Node(Tree)
}
fn wrap(inner: Tree) -> Tree { return Tree.Node(~inner) }
fn leaf_val(t: Tree) -> Int {
    if t == {
        .Leaf(n) -> { return n }
        .Node(inner) -> { return 0 }
    }
    return 0
}
fn run() -> {
    a :: Tree.Leaf(7)
    b :: wrap(a)
    print("{leaf_val(b)}")
}
"""
    (code, stdout) := build_and_run("tir_recursive_boxed_enum", src)
    assert_eq(code, 0)
    assert_eq(stdout, "0\n")
}
