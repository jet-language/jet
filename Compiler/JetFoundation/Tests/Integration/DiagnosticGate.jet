// Rust: tests/diagnostic_pages.rs:18
SNAPSHOT_DIRS :: ["tests/ui", "tests/ui_lint"]
// Rust: tests/diagnostic_pages.rs:20
struct Snapshot { path: String, text: String }
// Rust: tests/diagnostic_pages.rs:25
fn html_escape(value: String) -> String {
    value.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;").replace("'", "&#39;").replace(TEXT_NUL, "&#0;")
}
// Rust: tests/diagnostic_pages.rs:35
fn collect_snapshot_paths(dir: OSPath, out: &[OSPath]) -> {
    entries := fs.read_dir(dir).unwrap_or_else(fn(error) { panic("cannot read {dir.display()}: {error}") }).map(fn(entry) { entry.unwrap().path() }).collect()
    entries.sort()
    for path in entries {
        if path.is_dir() { collect_snapshot_paths(&path, &out) }
        else if path.extension().and_then(fn(ext) { ext.to_str() }) == Some("stderr") || path.extension().and_then(fn(ext) { ext.to_str() }) == Some("warn") { out.push(path) }
    }
}
// Rust: tests/diagnostic_pages.rs:53
fn snapshots(root: OSPath) -> [Snapshot] {
    paths := []
    for directory in SNAPSHOT_DIRS { collect_snapshot_paths(&root.join(directory), &paths) }
    paths.sort()
    paths.into_iter().map(fn(path) {
        Snapshot { path: path.strip_prefix(root).unwrap().to_string_lossy().replace("\\", "/"), text: fs.read_to_string(&path).unwrap_or_else(fn(error) { panic("cannot read {path.display()}: {error}") }) }
    }).collect()
}
// Rust: tests/diagnostic_pages.rs:73
fn first_snapshot(values: [Snapshot], code: String) -> Snapshot? {
    marker :: "[{code}]"
    values.iter().find(fn(snapshot) { snapshot.text.contains(&marker) })
}
// Rust: tests/diagnostic_pages.rs:78
fn collect_html_paths(dir: OSPath, root: OSPath, out: &[OSPath: Bool]) -> {
    entries := fs.read_dir(dir).unwrap_or_else(fn(error) { panic("cannot read {dir.display()}: {error}") }).map(fn(entry) { entry.unwrap().path() }).collect()
    entries.sort()
    for path in entries {
        if path.is_dir() { collect_html_paths(&path, root, &out) }
        else if path.extension().and_then(fn(ext) { ext.to_str() }) == Some("html") { out.insert(path.strip_prefix(root).unwrap().to_path_buf(), true) }
    }
}
// Rust: tests/diagnostic_pages.rs:93
fn sorted_rows() -> [DiagnosticRow] {
    rows := diagnostic_rows().iter().collect()
    rows.sort_by(fn(left, right) { left.code.cmp(right.code) })
    rows
}
// Rust: tests/diagnostic_pages.rs:99
fn render_page(row: DiagnosticRow, example: Snapshot?) -> String {
    code :: html_escape(row.code)
    what :: html_escape(row.what)
    why :: html_escape(row.why)
    fix :: html_escape(row.fix)
    description :: html_escape(row.what)
    example_text :: if example == {
        Some(snapshot) -> "<p>First UI snapshot mentioning <code>{code}</code>: <code>{html_escape(&snapshot.path)}</code>.</p>\n<pre class=\"diag\">{html_escape(&snapshot.text)}</pre>"
        None -> "<p>No UI snapshot currently mentions this code.</p>"
    }
    "<!-- Generated by tests/diagnostic_pages.rs; do not edit. -->\n" +
    "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n" +
    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>{code} — Jet diagnostic</title>\n" +
    "<meta name=\"description\" content=\"{description}\">\n<meta property=\"og:title\" content=\"{code} — Jet diagnostic\">\n" +
    "<meta property=\"og:description\" content=\"{description}\">\n<link rel=\"icon\" type=\"image/svg+xml\" href=\"../../assets/favicon.svg\">\n" +
    "<link rel=\"stylesheet\" href=\"../../assets/site.css\">\n</head>\n<body>\n<header class=\"wrap nav\">\n" +
    "<a class=\"nav-brand\" href=\"../../index.html\" aria-label=\"Jet home\"><span class=\"word\">jet</span></a>\n<nav><ul class=\"nav-links\">\n" +
    "<li><a href=\"../../tour.html\">Tour</a></li>\n<li><a href=\"../../install.html\">Install</a></li>\n" +
    "<li><a href=\"../index.html\" aria-current=\"page\">Error codes</a></li>\n</ul></nav>\n</header>\n<main>\n<section class=\"wrap page\">\n" +
    "<div class=\"page-header\">\n<p class=\"eyebrow\">// diagnostic</p>\n<h1>{code}</h1>\n<p>{what}</p>\n</div>\n</section>\n" +
    "<article class=\"wrap article\">\n<h2>What</h2>\n<p class=\"diag-copy what\" data-registry-field=\"what\">{what}</p>\n" +
    "<h2>Why</h2>\n<p class=\"diag-copy why\" data-registry-field=\"why\">{why}</p>\n<h2>Fix</h2>\n" +
    "<p class=\"diag-copy fix\" data-registry-field=\"fix\">{fix}</p>\n<h2>Worked example</h2>\n{example_text}\n" +
    "<p><a href=\"../index.html\">Back to all error codes</a></p>\n</article>\n</main>\n<footer class=\"footer\">\n<div class=\"wrap footer-grid\">\n" +
    "<a class=\"nav-brand\" href=\"../../index.html\" aria-label=\"Jet home\"><span class=\"word\">jet</span></a>\n" +
    "<p class=\"made\">Generated from Jet's diagnostic registry and UI snapshots.</p>\n</div>\n</footer>\n</body>\n</html>\n"
}
// Rust: tests/diagnostic_pages.rs:171
fn line_diff(expected: String, actual: String) -> String {
    expected_lines :: expected.lines().collect()
    actual_lines :: actual.lines().collect()
    first :: expected_lines.iter().zip(&actual_lines).position(fn(pair) { pair.0 != pair.1 }).unwrap_or(expected_lines.len().min(actual_lines.len()))
    "first differing line {first + 1}\n- {expected_lines.get(first).copied().unwrap_or(\"<missing>\")}\n+ {actual_lines.get(first).copied().unwrap_or(\"<missing>\")}"
}

// Rust: tests/diagnostics_format.rs:235
fn diagnostic_body_violations(text: String) -> [String] {
    violations := []
    in_wwf_table := false
    for (idx, raw) in text.lines().enumerate() {
        line := raw.trim() // #4303
        if !line.starts_with("|") { in_wwf_table = false; continue }
        cells :: markdown_cells(line)
        if is_wwf_header(&cells) { in_wwf_table = true; continue }
        if !in_wwf_table { continue }
        if cells.iter().all(fn(c) { c.is_empty() || c.chars().all(fn(ch) { ch == '-' }) }) { continue }
        code :: cells.get(1).and_then(fn(cell) { diagnostic_code(cell) })
        if code.is_none() { continue }
        value :: code.unwrap()
        if cells.len() != 6 {
            violations.push("line {idx + 1}: {value} — malformed What/Why/Fix row has {cells.len()} pipe-delimited cells, expected 6")
            continue
        }
        what :: &cells[2]
        why :: &cells[3]
        fix :: &cells[4]
        if what.is_empty() || why.is_empty() || fix.is_empty() { violations.push("line {idx + 1}: {value} — What/Why/Fix must all be non-empty (what={what.debug()} why={why.debug()} fix={fix.debug()})") }
    }
    violations
}
// Rust: tests/diagnostics_format.rs:289
fn markdown_cells(line: String) -> [String] {
    cells := [String.new()]
    escaped := false
    for ch in line.chars() {
        if ch == '|' && !escaped { cells.push(String.new()) }
        else { cells.last_mut().unwrap().push(ch) }
        escaped = ch == '\\' && !escaped
    }
    cells.into_iter().map(fn(cell) { view := cell.trim(); view.to_string() }).collect() // #4303
}
// Rust: tests/diagnostics_format.rs:306
fn is_wwf_header(cells: [String]) -> Bool {
    cells.len() >= 5 && cells[1].eq_ignore_ascii_case("code") && cells[2].eq_ignore_ascii_case("what") && cells[3].eq_ignore_ascii_case("why") && cells[4].eq_ignore_ascii_case("fix")
}
// Rust: tests/diagnostics_format.rs:314
fn is_code_like(code: String) -> Bool { jet.Explain.is_code(code) }
// Rust: tests/diagnostics_format.rs:318
fn diagnostic_code(cell: String) -> String? {
    code :: cell.strip_prefix("`").and_then(fn(value) { value.strip_suffix("`") }).unwrap_or(cell)
    if is_code_like(code) -> Some(code) else -> None
}
