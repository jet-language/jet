// Rust: tests/diagnostic_gate.rs:45
fn diagnostic_gate_project(tag: String, source: String, denied: Bool) -> common.Scratch {
    project :: common.Scratch.new(tag)
    fs.write(project.join("main.jet"), source).unwrap()
    fs.write(project.join("package.jet"), if denied -> DENIED_LINT_PACKAGE else -> DIAGNOSTIC_GATE_PACKAGE).unwrap()
    project
}
// Rust: tests/diagnostic_gate.rs:60
fn run_cli(project: common.Scratch, cache: String, args: [String]) -> Output {
    Command.new(env.var("JET_BIN").expect("Jet executable"))
        .args(args).current_dir(&project.path)
        .env("JET_RUN_CACHE_DIR", project.path.join("cache/{cache}/run"))
        .env("JET_STORE_DIR", project.path.join("cache/{cache}/build"))
        .env("NO_COLOR", "1").output().unwrap_or_else(fn(error) { panic("jet {args}: {error}") })
}
// Rust: tests/diagnostic_gate.rs:77
fn assert_warning_status(output: Output, label: String, code: String) -> {
    stderr :: String.from_utf8_lossy(&output.stderr)
    assert_eq(output.status.code(), Some(0), "{label} exited nonzero:\nstdout={String.from_utf8_lossy(&output.stdout)}\nstderr={stderr}")
    assert(stderr.contains("Warning [{code}]"), "{label} did not classify {code} as a warning:\n{stderr}")
    assert(!stderr.contains("Error [{code}]"), "{label} classified {code} as an error:\n{stderr}")
}
// Rust: tests/diagnostic_gate.rs:95
fn assert_warning_execution(output: Output, label: String, code: String, stdout: String) -> {
    assert_warning_status(output, label, code)
    assert_eq(output.stdout, stdout.as_bytes(), "{label} program stdout changed")
}

