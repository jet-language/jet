// Rust: tests/lint_visibility_wave_a.rs:54
#Test("check_and_build_show_advisories_while_execution_can_request_them") {
    scratch :: Common.Scratch.new("lint-visibility-wave-a")
    fs.write(scratch.join("main.jet"), SOURCE).expect("write lint visibility fixture")
    allow_io(scratch.path)
    assert_advisory_visible("check", run_jet(scratch.path, ["check", "main.jet"]))
    assert_advisory_visible("build", run_jet(scratch.path, ["build", "--profile=debug", "main.jet"]))
    quiet_run :: run_jet(scratch.path, ["run", "main.jet"])
    assert(quiet_run.status.success(), "default run failed:\n{combined(quiet_run)}")
    assert_eq(String.from_utf8_lossy(quiet_run.stdout), "ok\n", "application stdout must remain intact")
    assert(!combined(quiet_run).contains("[L0101]"), "default run should hide ordinary advisories:\n{combined(quiet_run)}")
    verbose_run :: run_jet(scratch.path, ["run", "--verbose", "main.jet"])
    assert_advisory_visible("verbose run", verbose_run)
    assert_eq(String.from_utf8_lossy(verbose_run.stdout), "ok\n")
    program_arg_run :: run_jet(scratch.path, ["run", "main.jet", "--", "--verbose", "--json"])
    assert(program_arg_run.status.success(), "program-argument run failed:\n{combined(program_arg_run)}")
    assert_eq(String.from_utf8_lossy(program_arg_run.stdout), "ok\n")
    assert(!combined(program_arg_run).contains("[L0101]"), "program arguments after -- must not enable advisories:\n{combined(program_arg_run)}")
}
// Rust: tests/lint_visibility_wave_a.rs:104
#Test("dev_watch_off_hides_advisories_by_default_and_verbose_requests_them") {
    scratch :: Common.Scratch.new("lint-visibility-wave-a-dev")
    fs.write(scratch.join("main.jet"), SOURCE).expect("write dev lint fixture")
    allow_io(scratch.path)
    quiet_dev :: run_jet(scratch.path, ["dev", "main.jet", "--watch=off"])
    assert(quiet_dev.status.success(), "default dev failed:\n{combined(quiet_dev)}")
    assert(!combined(quiet_dev).contains("[L0101]"), "default dev should hide ordinary advisories:\n{combined(quiet_dev)}")
    verbose_dev :: run_jet(scratch.path, ["dev", "--verbose", "main.jet", "--watch=off"])
    assert_advisory_visible("verbose dev", verbose_dev)
}
// Rust: tests/lint_visibility_wave_a.rs:150
#Test("test_hides_advisories_unless_verbose") {
    scratch :: Common.Scratch.new("lint-visibility-wave-a-test")
    fs.write(scratch.join("main.jet"), TESTED_SOURCE).expect("write test lint fixture")
    allow_io(scratch.path)
    quiet :: run_jet(scratch.path, ["test", "--capture=all", "main.jet"])
    assert(quiet.status.success(), "default test failed:\n{combined(quiet)}")
    assert(!combined(quiet).contains("[L0101]"), "default test should hide ordinary advisories:\n{combined(quiet)}")
    assert(combined(quiet).contains("1 passed, 0 failed"), combined(quiet))
    // Verbose execution must expose advisories even with the cached result.
    verbose :: run_jet(scratch.path, ["test", "--verbose", "--capture=all", "main.jet"])
    assert_advisory_visible("verbose test", verbose)
    assert(combined(verbose).contains("1 passed, 0 failed"), combined(verbose))
}
// Rust: tests/lint_visibility_wave_a.rs:172
#Test("enforcement_survives_hidden_advisories") {
    deny :: Common.Scratch.new("lint-visibility-wave-a-deny")
    fs.write(deny.join("main.jet"), TESTED_SOURCE).expect("write deny fixture")
    package(deny.path, "IO", "policy: {{ lints: {{ deny: [unused_local_binding] }} }}\n")
    loop args in [["run", "main.jet"], ["run", "--verbose", "main.jet"], ["test", "main.jet"], ["test", "--verbose", "main.jet"]] {
        assert_fails_with("denied lint {args:?}", run_jet(deny.path, args), "E1293")
    }
    sema :: Common.Scratch.new("lint-visibility-wave-a-sema")
    fs.write(sema.join("main.jet"), TESTED_SOURCE.replace("    print(\"ok\")", "    x :: 1 + \"a\"\n    print(\"ok\")")).expect("write sema fixture")
    allow_io(sema.path)
    loop args in [["run", "main.jet"], ["test", "main.jet"]] {
        assert_fails_with("sema error {args:?}", run_jet(sema.path, args), "E0109")
    }
    runtime :: Common.Scratch.new("lint-visibility-wave-a-runtime")
    fs.write(runtime.join("main.jet"), "fn boom() {{\n    panic(\"boom\")\n}}\n\nfn run() {{\n    unused_binding :: 1\n    boom()\n}}\n\n#Test(\"stops\") {{\n    boom()\n}}\n").expect("write runtime fixture")
    allow_io(runtime.path)
    loop args in [["run", "main.jet"], ["run", "--verbose", "main.jet"]] {
        assert_fails_with("runtime stop {args:?}", run_jet(runtime.path, args), "E3001")
    }
    failing_test :: run_jet(runtime.path, ["test", "main.jet"])
    assert(!failing_test.status.success(), combined(failing_test))
    assert(combined(failing_test).contains("0 passed, 1 failed"), combined(failing_test))
    authority :: Common.Scratch.new("lint-visibility-wave-a-authority")
    fs.write(authority.join("main.jet"), TESTED_SOURCE).expect("write authority fixture")
    package(authority.path, "", "")
    loop args in [["run", "main.jet"], ["run", "--verbose", "main.jet"]] {
        assert_fails_with("authority {args:?}", run_jet(authority.path, args), "E1220")
    }
}
// Rust: tests/lint_visibility_wave_a.rs:223
#Test("json_output_keeps_structure_with_hidden_advisories") {
    scratch :: Common.Scratch.new("lint-visibility-wave-a-json")
    fs.write(scratch.join("main.jet"), TESTED_SOURCE).expect("write json fixture")
    allow_io(scratch.path)
    run :: run_jet(scratch.path, ["run", "--json", "main.jet"])
    assert(run.status.success(), combined(run))
    assert_eq(String.from_utf8_lossy(run.stdout), "ok\n", "application stdout stays clean")
    assert(!combined(run).contains("[L0101]"), combined(run))
    check :: run_jet(scratch.path, ["check", "--json", "main.jet"])
    check_stdout :: String.from_utf8_lossy(check.stdout)
    assert(check.status.success(), combined(check))
    assert(check_stdout.contains("L0101"), "check --json must report the advisory:\n{check_stdout}")
    assert(check_stdout.contains("\"ok\":true") && !check_stdout.contains("\"ok\":false"), "warnings-only check --json must report ok:true:\n{check_stdout}")
    test :: run_jet(scratch.path, ["test", "--json", "main.jet"])
    stdout :: String.from_utf8_lossy(test.stdout)
    assert(test.status.success(), combined(test))
    trimmed := stdout.trim_start() // #4303
    assert(trimmed.starts_with('{'), stdout)
    assert(stdout.contains("\"action\":\"test\"") && stdout.contains("\"ok\":true"), stdout)
    assert(!combined(test).contains("L0101"), combined(test))
}

// Rust: tests/live_inspect.rs:20
#Test("live_inspector_reads_running_tasks_channels_and_resources_without_payloads") {
    if !Common.have_rustc() { return }
    dir :: Common.unique_tmp("jet_live_inspect")
    fs.create_dir_all(dir).unwrap()
    source :: dir.join("live.jet")
    fs.write(source, LIVE_SOURCE).unwrap()
    jet_bin :: env.var("JET_BIN").unwrap()
    build :: Command.new(jet_bin).args(["build", source.to_str().unwrap()]).current_dir(dir).output().unwrap()
    assert(build.status.success(), "build failed:\n{String.from_utf8_lossy(build.stderr)}")
    // GATE #4483: selected target executable suffix.
    suffix :: if target.selected_os() == "windows" { ".exe" } else { "" }
    binary :: dir.join(".jet").join("build").join("live{suffix}")
    // GATE #4494: real spawned program and attach observations.
    child :: Command.new(binary).env("JET_OBSERVE", "1").stdout(Stdio.null()).stderr(Stdio.null()).spawn().unwrap()
    pid :: child.id()
    guard :: ChildGuard{child: ^child}
    deadline :: Instant.now() + Duration.from_secs(5)
    snapshot :: loop {
        observed :: LiveInspect.read(pid)
        if observed == Ok(value) {
            if value.contains("\"wait\":\"channel receive\"") && value.contains("\"depth\":1,\"capacity\":1") { break value }
        }
        if Instant.now() < deadline { thread.sleep(Duration.from_millis(25)) }
        else { panic("live scheduler snapshot never became observable: {observed:?}") }
    }
    assert(snapshot.contains("\"parent\":1"))
    assert(snapshot.contains("\"label\":\"task@"))
    assert(snapshot.contains("\"spawn_site\":"))
    assert(snapshot.contains("\"effects\":"))
    assert(snapshot.contains("\"arena_bytes\":"))
    assert(!snapshot.contains("TOP_SECRET_CHANNEL_PAYLOAD"))
    assert(!snapshot.contains("payload"))
    assert(!snapshot.contains("locals"))
    cli :: Command.new(jet_bin).args(["inspect", "live", "--attach", pid.to_string(), "--once", "--json"]).output().unwrap()
    assert(cli.status.success(), String.from_utf8_lossy(cli.stderr))
    cli_snapshot :: String.from_utf8(cli.stdout).unwrap()
    assert(cli_snapshot.contains("\"pid\":{pid}"))
    assert(cli_snapshot.contains("\"wait\":\"channel receive\""))
    assert(!cli_snapshot.contains("TOP_SECRET_CHANNEL_PAYLOAD"))
    drop(^guard)
    _ :: fs.remove_file(LiveInspect.snapshot_path(pid))
    _ :: fs.remove_dir_all(dir)
}
