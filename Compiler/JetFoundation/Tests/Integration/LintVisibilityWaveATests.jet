// Rust: tests/local_cell_tiers.rs:189
#Test("local_cell_full_surface_runs_through_aot") {
    if !TirSupport.have_rustc() { return }
    (code, stdout) :: TirSupport.build_and_run("local_cell_aot", LOCAL_SOURCE)
    assert_eq(code, 0)
    assert_eq(stdout, LOCAL_EXPECTED)
}
// Rust: tests/local_cell_tiers.rs:199
#Test("local_cell_full_surface_runs_through_default_tier") {
    // GATE #4494: retained 2 MiB embedder stack and native tier harness.
    thread.Builder.new().stack_size(2 * 1024 * 1024).spawn(() -> {
        dir :: env.temp_dir().join("jet_local_cell_parity_{std.process.id()}")
        fs.create_dir_all(dir).unwrap()
        path :: dir.join("main.jet")
        fs.write(path, LOCAL_SOURCE).unwrap()
        loop tier in ["O0", "O1", "O2", "Web"] {
            (code, stdout, stderr) :: TirSupport.run_entry_tier(path, tier)
            assert_eq(code, 0, "{tier} exit drift: {stderr}")
            assert_eq(stderr, "", "{tier} stderr drift")
            assert_eq(stdout, LOCAL_EXPECTED, "{tier} output drift")
        }
    }).expect("spawn 2 MiB local Cell embedder").join().expect("local Cell embedder must not overflow")
}
