// Rust: tests/local_cell_tiers.rs:303
#Test("local_cell_non_string_map_uses_default_evaluator") {
    thread.Builder.new().stack_size(2 * 1024 * 1024).spawn(() -> {
        dir :: env.temp_dir().join("jet_local_cell_int_map_{std.process.id()}")
        fs.create_dir_all(dir).unwrap()
        path :: dir.join("main.jet")
        fs.write(path, INT_MAP_SOURCE).unwrap()
        // Retiring evaluator/JIT eligibility flags become observable parity.
        loop tier in ["O0", "O1", "O2", "Web"] {
            (code, stdout, stderr) :: TirSupport.run_entry_tier(path, tier)
            assert_eq(code, 0)
            assert_eq(stderr, "")
            assert_eq(stdout, "2\n")
        }
    }).expect("spawn 2 MiB non-string map Cell embedder").join().expect("non-string map Cell embedder must not overflow")
}
// Rust: tests/local_cell_tiers.rs:358
#Test("local_cell_guards_are_linear_before_codegen") {
    source :: "fn run() {{\n    cell :: Cell.new(1)\n    guard :: cell.guard_read()\n    copied :: ~guard\n    print(copied.get())\n}}\n"
    diagnostics :: jet.compile(source).expect_err("Cell guards must be rejected by sema before codegen")
    assert(diagnostics.iter().any(diagnostic -> diagnostic.code == "E0211"), "expected E0211 for explicit Cell guard copy: {diagnostics:?}")
}
// Rust: tests/local_cell_tiers.rs:378
#Test("local_cell_guard_storage_boundary_reports_once_per_site") {
    cases :: [
        ("struct field", "struct Held {{\n    guard: CellReadGuard<Int>,\n}}\n\nfn run() {{}}\n"),
        ("enum payload", "enum Held {{\n    Guard(CellReadGuard<Int>)\n}}\n\nfn run() {{}}\n"),
        ("list binding", "fn run() {{\n    cell :: Cell.new(1)\n    guard :: cell.guard_read()\n    held :: [guard]\n}}\n"),
        ("lambda capture", "fn hold(cell: Cell<Int>) -> fn() -> Int {{\n    guard :: cell.guard_read()\n    return () -> guard.get()\n}}\n\nfn run() {{}}\n"),
        ("immediate lambda capture", "fn run() {{\n    cell :: Cell.new(1)\n    guard :: cell.guard_read()\n    read :: (() -> guard.get()).call()\n}}\n"),
        ("generic struct temporary", "struct Held<T> {{\n    value: T,\n}}\n\nfn consume<T>(held: Held<T>) {{}}\n\nfn run() {{\n    cell :: Cell.new(1)\n    consume(Held<CellReadGuard<Int>>{{ value: cell.guard_read() }})\n}}\n"),
        ("list call argument", "fn consume<T>(held: T) {{}}\n\nfn run() {{\n    cell :: Cell.new(1)\n    consume([cell.guard_read()])\n}}\n")
    ]
    loop (case, source) in cases {
        diagnostics :: jet.compile(source).expect_err("unsupported Cell guard storage must be rejected before codegen")
        count :: diagnostics.iter().filter(diagnostic -> diagnostic.code == "E0217").count()
        assert_eq(count, 1, "{case} must report one E0217: {diagnostics:?}")
    }
}
