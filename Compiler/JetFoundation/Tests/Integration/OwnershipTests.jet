// Rust: tests/ownership.rs:828
#Test("const_address_taken_emits_static") {
    src :: """
#Static LIMIT :: prep { 10 }
fn show(n: Int) { print(n) }
fn run() { show(LIMIT) }
"""
    out :: jet.compile(src).expect("should compile")
    assert(out.rust.contains("static __JET_CT_LIMIT"), "`#Static` should give the constant its own address: {out.rust}")
    inlined :: jet.compile(src.replace("#Static ", "")).expect("should compile")
    assert(!inlined.rust.contains("__JET_CT_LIMIT"), "an unmarked constant should inline, not take an address: {inlined.rust}")
