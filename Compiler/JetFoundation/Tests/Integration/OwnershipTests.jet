fn both(values: &[Int], callback: fn()) {
    &values.push(3)
    callback()
}
fn run() {
    values := [1, 2]
    both(&values, () -> {
        found :: missing() ?? panic("length {values.len()}")
        print(found)
    })
}
"""
    diags :: jet.compile(fallback).expect_err("panic fallback arguments are closure captures")
    assert(diags.iter().any((diag) -> diag.code == "E0204"), "{diags:?}")
    scope_member :: """
fn run() { print(0) }
#Test("member argument capture walk") {
    values := [1, 2]
    .skip("length {values.len()}") { assert(false) }
}
"""
    jet.compile(scope_member).expect("valid scope-member arguments remain walkable")
}

// Rust: tests/ownership.rs:1700
#Test("wrapped_and_branch_returned_views_stay_live_through_outer_calls") {
    loop view in ["(first(values))", "if true -> { first(values) } else -> { first(values) }", "Val(first(values)) ?? first(values)"] {
        src :: format("""
fn first(values: [Int]) -[]> View<Int> {{ return values[0..1] }}
fn both(view: View<Int>, values: &[Int]) {{ &values.push(view[0]) }}
fn run() {{
    values := [1, 2]
    both({view}, &values)
}}
""")
        diags :: jet.compile(src).expect_err("wrapped returned views retain their source loan")
        assert(diags.iter().any((diag) -> diag.code == "E0204"), "{view}: {diags:?}")
    }
}

// Rust: tests/ownership.rs:1730
#Test("return_fallback_view_does_not_reach_the_enclosing_call") {
    source :: """
struct View<T> { value: T }
fn first(values: [Int]) -[]> View<Int> { return values[0..1] }
fn both(view: View<Int>, values: &[Int]) { &values.push(view[0]) }
fn choose(other: [Int], values: &[Int]) -[..E]> View<Int> {
    both(Val(first(other)) ?? return first(values), &values)
    return first(other)
}
fn run() {
    other := [1]
    values := [2]
    chosen :: choose(other, &values)
    print(chosen[0])
}
"""
    jet.compile(source).expect("a return fallback exits before the enclosing call can run")
}

// Rust: tests/ownership.rs:1750
#Test("generic_constructor_nested_argument_sees_active_write_place") {
    src :: """
struct Pair<T> { value: T }
impl Pair {
    fn new(first: &T, second: T) -[]> Pair<T> { return Pair<T>{ value: second } }
}
fn see(value: Int) -[]> Int { return value }
fn run() {
    x := 1
    pair :: Pair.new(&x, see(x))
    print(pair.value)
}
"""
    diags :: jet.compile(src).expect_err("constructor pre-inference must fail in sema before rustc")
    assert(diags.iter().any((diag) -> diag.code == "E0204"), "expected the call-alias diagnostic: {diags:?}")
}

// Rust: tests/ownership.rs:1775
#Test("dynamic_projection_operands_are_checked_but_not_retained") {
    hostile_index :: """
fn both(index: &Int, value: Int) { index += value }
fn run() {
    values := [10, 20]
    index := 0
    both(&index, values[index])
}
"""
    index_diags :: jet.compile(hostile_index).expect_err("dynamic index evaluation must fail in sema before rustc")
    assert(index_diags.iter().any((diag) -> diag.code == "E0204"), "{index_diags:?}")
    hostile_slice :: """
fn both(end: &Int, values: [Int]) { end += values.len() }
fn run() {
    values := [10, 20]
    end := 1
    both(&end, values[0..end])
}
"""
    slice_diags :: jet.compile(hostile_slice).expect_err("dynamic slice-bound evaluation must fail in sema before rustc")
    assert(slice_diags.iter().any((diag) -> diag.code == "E0204"), "{slice_diags:?}")
    ordered :: """
fn both(value: Int, index: &Int) { index += value }
fn run() {
    values := [10, 20]
    index := 0
    both(values[index], &index)
}
"""
    jet.compile(ordered).expect("the index read finishes before the later write borrow is retained")
}
