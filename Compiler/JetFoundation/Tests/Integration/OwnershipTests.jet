    changed := Condition.new()
    guard :: cell.guard_edit()
    _ :: guard.wait(changed, value -> value)
}
"""
    predicate_diagnostics :: jet.compile(predicate_src).expect_err("a wait predicate must return Bool")
    assert(predicate_diagnostics.iter().any((diagnostic) -> diagnostic.code == "E0112" || diagnostic.code == "E0113"), "expected the predicate diagnostic: {predicate_diagnostics:?}")
}

