    jet.compile(field).expect("field assignment reinitializes the exact moved field")
    sibling :: """
struct Pair { left: String, right: [Int] }
fn call(callback: fn()) { callback() }
fn run() {
    pair := Pair{ left: "jet", right: [1] }
    call(() -> { print(pair.left) })
    pair.right = [2]
    print(pair.left)
}
"""
    sibling_diags :: jet.compile(sibling).expect_err("assigning a sibling must not restore the moved field")
    assert(sibling_diags.iter().any((diag) -> diag.code == "E0121"), "{sibling_diags:?}")
    ancestor :: """
struct Pair { left: String, right: [Int] }
fn call(callback: fn()) { callback() }
fn run() {
    pair := Pair{ left: "jet", right: [1] }
    call(() -> { print(pair) })
    pair.left = "again"
}
"""
    ancestor_diags :: jet.compile(ancestor).expect_err("assigning a field cannot restore a moved ancestor")
    assert(ancestor_diags.iter().any((diag) -> diag.code == "E0121"), "{ancestor_diags:?}")
}

