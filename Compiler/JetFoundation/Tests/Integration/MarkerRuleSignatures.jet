use std.[fs, env, process, thread]
use jet
// GATE #4494: native temporary filesystem, process id and thread name.
// Rust: tests/marker_rule_signatures.rs:3
fn checked(source: String, mode: jet.Sema.CompileMode) -> (jet.AST.ProgramBundle, [String]) {
    dir :: env.temp_dir().join("jet_marker_rule_signatures_{process.id()}_{thread.current().name().unwrap_or("test")}")
    fs.create_dir_all(&dir).unwrap()
    path :: dir.join("main.jet")
    fs.write(&path, source).unwrap()
    bundle := jet.Loader.load_entry(path.to_str().unwrap()).unwrap()
    codes: [String] :: jet.Sema.check_bundle(&bundle, mode).into_iter().map(|diagnostic| diagnostic.code.to_string()).collect()
    (^bundle, codes)
}
// Rust: tests/marker_rule_signatures.rs:20
fn codes(source: String) -> [String] { checked(source, jet.Sema.CompileMode.Check).1 }
// Rust: tests/marker_rule_signatures.rs:24
fn diagnostics(source: String) -> [jet.Diagnostics.Diagnostic] {
    dir :: env.temp_dir().join("jet_marker_rule_signatures_diagnostics_{process.id()}_{thread.current().name().unwrap_or("test")}")
    fs.create_dir_all(&dir).unwrap()
    path :: dir.join("main.jet")
    fs.write(&path, source).unwrap()
    bundle := jet.Loader.load_entry(path.to_str().unwrap()).unwrap()
    jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Check)
}
// Rust: tests/marker_rule_signatures.rs:37
fn parse_diagnostics(source: String) -> [jet.Diagnostics.Diagnostic] {
    (tokens, lexer_diagnostics) :: jet.Lexer.lex(source)
    assert(lexer_diagnostics.is_empty(), "{lexer_diagnostics:?}")
    jet.Parser.parse(&tokens).err().unwrap_or_default()
}
// Rust: tests/marker_rule_signatures.rs:43
fn parse_codes(source: String) -> [String] {
    parse_diagnostics(source).into_iter().map(|diagnostic| diagnostic.code).collect()
}
