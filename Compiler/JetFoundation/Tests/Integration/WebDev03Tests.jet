#Test("embedded_devserver_rejects_hardlinked_source") {
    if selected_family() != "unix" && selected_os() != "windows" { return }
    if !have_tool("rustc") { eprintln("note: skipping embedded_devserver_rejects_hardlinked_source (need rustc)"); return }
    dir :: env.temp_dir().join("jet_embedded_devserver_hardlinked_source_{process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    port :: unused_local_port()
    source :: fn_fixture_src(port, "hardlinked source")
    outside :: dir.join("outside-app.jet")
    fs.write(&outside, &source).unwrap()
    fs.hard_link(&outside, dir.join("app.jet")).unwrap()
    output :: Command.new(jet_bin()).args(["dev", "app.jet"]).current_dir(&dir).output().expect("failed to launch hardlinked-source fixture")
    assert(!output.status.success(), "jet dev must fail closed for a hardlinked source")
    assert_eq(fs.read(&outside).unwrap(), source.as_bytes())
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/web_dev.rs:3762
#Test("embedded_devserver_rejects_unix_hardlinks_and_special_files") {
    if selected_family() != "unix" { return }
    if !have_tool("rustc") { eprintln("note: skipping embedded_devserver_rejects_unix_hardlinks_and_special_files (need rustc)"); return }
    dir :: env.temp_dir().join("jet_embedded_devserver_unix_file_identity_{process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    port :: unused_local_port()
    fs.write(dir.join("app.jet"), fn_fixture_src(port, "host")).unwrap()
    guard :: start_embedded_devserver(&dir, port)
    build :: dir.join("build")
    outside_static :: dir.join("outside-static.js")
    fs.write(&outside_static, b"outside-static").unwrap()
    hardlinked_static :: build.join("hardlinked.js")
    fs.hard_link(&outside_static, &hardlinked_static).unwrap()
    (status, _, body) :: http_get_with_content_type(port, "/hardlinked.js").expect("hardlinked static GET failed")
    assert_eq(status, 400)
    assert(body.is_empty() || body == b"bad path")
    assert_eq(fs.read(&outside_static).unwrap(), b"outside-static")
    special :: build.join("special.sock")
    socket :: UnixListener.bind(&special).unwrap()
    (status, _, _) :: http_get_with_content_type(port, "/special.sock").expect("special-file GET failed")
    assert_eq(status, 400)
    drop(socket)
    outside_output :: dir.join("outside-output.js")
    fs.write(&outside_output, b"outside-output").unwrap()
    output_path :: build.join("app.js")
    fs.remove_file(&output_path).unwrap()
    fs.hard_link(&outside_output, &output_path).unwrap()
    (_, baseline_body) :: http_get_without_session(port, "/__jet_dev_version").unwrap()
    baseline_view := String.from_utf8_lossy(&baseline_body).trim() // #4303
    baseline :: baseline_view.to_string()
    fs.write(dir.join("app.jet"), fn_fixture_src(port, "changed")).unwrap()
    deadline :: Instant.now() + Duration.from_secs(5)
    while Instant.now() < deadline {
        (_, version_body) :: http_get_without_session(port, "/__jet_dev_version").unwrap()
        if String.from_utf8_lossy(&version_body).trim() != baseline { panic("hardlinked output was published instead of rejected") }
        thread.sleep(Duration.from_millis(100))
    }
    assert_eq(fs.read(&outside_output).unwrap(), b"outside-output")
    assert_eq(fs.read(&output_path).unwrap(), b"outside-output")
    fs.remove_file(&output_path).unwrap()
    fs.write(dir.join("app.jet"), fn_fixture_src(port, "recovered")).unwrap()
    recovered :: wait_for_version_change(port, &baseline, Duration.from_secs(15))
    assert_ne(recovered, baseline, "watcher did not recover after rejected publish")
    assert_eq(fs.read(&outside_output).unwrap(), b"outside-output")
    drop(guard)
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/web_dev.rs:3831
#Test("embedded_devserver_parent_rename_stays_inside_held_root") {
    if selected_family() != "unix" { return }
    if !have_tool("rustc") { eprintln("note: skipping embedded_devserver_parent_rename_stays_inside_held_root (need rustc)"); return }
    dir :: env.temp_dir().join("jet_embedded_devserver_parent_rename_{process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    port :: unused_local_port()
    fs.write(dir.join("app.jet"), fn_fixture_src(port, "host")).unwrap()
    guard :: start_embedded_devserver(&dir, port)
    build :: dir.join("build")
    nested :: build.join("nested")
    parked :: build.join("nested.parked")
    outside :: dir.join("outside-parent")
    fs.create_dir_all(&nested).unwrap()
    fs.create_dir_all(&outside).unwrap()
    fs.write(nested.join("race.js"), b"inside-parent").unwrap()
    fs.write(outside.join("race.js"), b"outside-parent").unwrap()
    (status, body) :: http_get_without_session(port, "/nested/race.js").unwrap()
    assert_eq(status, 200)
    assert_eq(body, b"inside-parent")
    stop :: Arc.new(AtomicBool.new(false))
    leaked :: Arc.new(AtomicBool.new(false))
    swaps :: Arc.new(AtomicUsize.new(0))
    swap_stop :: Arc.clone(&stop)
    swap_nested :: nested.clone()
    swap_parked :: parked.clone()
    swap_outside :: outside.clone()
    swap_count :: Arc.clone(&swaps)
    swapper :: thread.spawn(fn [^swap_stop, ^swap_nested, ^swap_parked, ^swap_outside, ^swap_count]() {
        while !swap_stop.load(Ordering.Relaxed) {
            _ :: fs.remove_dir(&swap_parked)
            if fs.rename(&swap_nested, &swap_parked).is_ok() {
                if symlink(&swap_outside, &swap_nested).is_ok() { _ :: swap_count.fetch_add(1, Ordering.Relaxed) }
                _ :: fs.remove_file(&swap_nested)
                _ :: fs.rename(&swap_parked, &swap_nested)
            }
        }
    })
    requests := []
    for _ in 0..4 {
        request_leaked :: Arc.clone(&leaked)
        requests.push(thread.spawn(fn [^request_leaked, port]() {
            for _ in 0..256 {
                result :: http_get_without_session(port, "/nested/race.js")
                if result.is_none() { continue }
                (status, body) :: result.unwrap()
                if status == 200 && body != b"inside-parent" { request_leaked.store(true, Ordering.Relaxed); break }
            }
        }))
    }
    for request in requests { request.join().unwrap() }
    stop.store(true, Ordering.Relaxed)
    swapper.join().unwrap()
    _ :: fs.remove_file(&nested)
    _ :: fs.rename(&parked, &nested)
    assert(!leaked.load(Ordering.Relaxed))
    assert(swaps.load(Ordering.Relaxed) > 0)
    drop(guard)
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/web_dev.rs:3915
#Test("embedded_devserver_rejects_invalid_utf8_index_within_response_budget") {
    if !have_tool("rustc") { eprintln("note: skipping embedded_devserver_rejects_invalid_utf8_index_within_response_budget (need rustc)"); return }
    const MAX_GENERATED_RESPONSE_BYTES: U64 = 64 * 1024 * 1024
    const SCRIPT_HEADROOM_BYTES: U64 = 4096
    dir :: env.temp_dir().join("jet_embedded_devserver_invalid_utf8_{process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    port :: unused_local_port()
    fs.write(dir.join("app.jet"), fn_fixture_src(port, "host")).unwrap()
    guard :: start_embedded_devserver(&dir, port)
    index :: dir.join("build").join("index.html")
    file :: fs.File.create(&index).unwrap()
    file.set_len(MAX_GENERATED_RESPONSE_BYTES - SCRIPT_HEADROOM_BYTES).unwrap()
    file.write_all(&[0xff]).unwrap()
    drop(file)
    (status, content_type, body) :: http_get_with_content_type(port, "/").expect("invalid-UTF8 index GET failed")
    assert_eq(status, 404)
    assert_eq(content_type, "text/plain; charset=utf-8")
    assert(body.len() < 128, "invalid UTF-8 must fail closed without echoing HTML")
    drop(guard)
    _ :: fs.remove_dir_all(&dir)
}
