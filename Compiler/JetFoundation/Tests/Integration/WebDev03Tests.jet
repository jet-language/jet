// Rust: tests/web_dev.rs:3390
#Test("embedded_devserver_http_line_and_header_bounds_are_exact") {
    if !have_tool("rustc") { eprintln("note: skipping embedded_devserver_http_line_and_header_bounds_are_exact (need rustc)"); return }
    const MAX_LINE_BYTES: USize = 8 * 1024
    const MAX_HEADER_BYTES: USize = 32 * 1024
    const MAX_HEADER_COUNT: USize = 100
    dir :: env.temp_dir().join("jet_embedded_devserver_http_bounds_{process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    port :: unused_local_port()
    fs.write(dir.join("app.jet"), fn_fixture_src(port, "host")).unwrap()
    guard :: start_embedded_devserver(&dir, port)
    line_prefix :: "GET "
    line_suffix :: " HTTP/1.1\r\n"
    target_prefix :: "/__jet_dev_version?"
    target_len :: MAX_LINE_BYTES - line_prefix.len() - line_suffix.len()
    assert(target_len > target_prefix.len())
    exact_target :: "{target_prefix}{\"q\".repeat(target_len - target_prefix.len())}"
    assert_eq("{line_prefix}{exact_target}{line_suffix}".len(), MAX_LINE_BYTES)
    exact_response :: raw_http_exchange(port, &raw_get_request(&exact_target, &[])).expect("request line at the 8 KiB boundary was not served")
    assert(exact_response.starts_with(b"HTTP/1.1 200 OK\r\n"), "request line at the exact cap should remain valid")
    over_target :: "{target_prefix}{\"q\".repeat(target_len + 1 - target_prefix.len())}"
    assert_eq("{line_prefix}{over_target}{line_suffix}".len(), MAX_LINE_BYTES + 1)
    over_response :: raw_http_exchange(port, &raw_get_request(&over_target, &[]))
    assert(over_response.map(fn(response) { !response.starts_with(b"HTTP/1.1 200 OK\r\n") }).unwrap_or(true), "a request line over 8 KiB was accepted")
    header_prefix :: "X-Pad: "
    exact_header :: "{header_prefix}{\"x\".repeat(MAX_LINE_BYTES - header_prefix.len() - 2)}"
    assert_eq(exact_header.len() + 2, MAX_LINE_BYTES)
    exact_response :: raw_http_exchange(port, &raw_get_request("/__jet_dev_version", &[exact_header.clone()])).expect("header line at the 8 KiB boundary was not served")
    assert(exact_response.starts_with(b"HTTP/1.1 200 OK\r\n"), "header line at the exact cap should remain valid")
    over_header :: "{header_prefix}{\"x\".repeat(MAX_LINE_BYTES - header_prefix.len() - 1)}"
    assert_eq(over_header.len() + 2, MAX_LINE_BYTES + 1)
    over_response :: raw_http_exchange(port, &raw_get_request("/__jet_dev_version", &[over_header]))
    assert(over_response.map(fn(response) { !response.starts_with(b"HTTP/1.1 200 OK\r\n") }).unwrap_or(true), "a header line over 8 KiB was accepted")
    exact_headers :: [exact_header; MAX_HEADER_BYTES / MAX_LINE_BYTES]
    exact_header_bytes: USize = exact_headers.iter().map(fn(header) { header.len() + 2 }).sum()
    assert_eq(exact_header_bytes, MAX_HEADER_BYTES)
    exact_response :: raw_http_exchange(port, &raw_get_request("/__jet_dev_version", &exact_headers)).expect("aggregate headers at the 32 KiB boundary were not served")
    assert(exact_response.starts_with(b"HTTP/1.1 200 OK\r\n"), "aggregate headers at the exact cap should remain valid")
    over_headers := exact_headers.clone()
    over_headers.push("X: y")
    assert(over_headers.iter().all(fn(header) { header.len() + 2 <= MAX_LINE_BYTES }))
    over_header_bytes: USize = over_headers.iter().map(fn(header) { header.len() + 2 }).sum()
    assert(over_header_bytes > MAX_HEADER_BYTES)
    over_response :: raw_http_exchange(port, &raw_get_request("/__jet_dev_version", &over_headers))
    assert(over_response.map(fn(response) { !response.starts_with(b"HTTP/1.1 200 OK\r\n") }).unwrap_or(true), "aggregate headers over 32 KiB were accepted")
    exact_count_headers: [String] = (0..MAX_HEADER_COUNT).map(fn(index) { "X-{index}: y" }).collect()
    assert_eq(exact_count_headers.len(), MAX_HEADER_COUNT)
    exact_response :: raw_http_exchange(port, &raw_get_request("/__jet_dev_version", &exact_count_headers)).expect("100 headers at the count boundary were not served")
    assert(exact_response.starts_with(b"HTTP/1.1 200 OK\r\n"), "100 headers at the exact cap should remain valid")
    over_count_headers := exact_count_headers.clone()
    over_count_headers.push("X-extra: y")
    assert_eq(over_count_headers.len(), MAX_HEADER_COUNT + 1)
    over_response :: raw_http_exchange(port, &raw_get_request("/__jet_dev_version", &over_count_headers))
    assert(over_response.map(fn(response) { !response.starts_with(b"HTTP/1.1 200 OK\r\n") }).unwrap_or(true), "more than 100 headers were accepted")
    drop(guard)
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/web_dev.rs:3542
#Test("embedded_devserver_admission_cap_drops_the_65th_connection") {
    if !have_tool("rustc") { eprintln("note: skipping embedded_devserver_admission_cap_drops_the_65th_connection (need rustc)"); return }
    const MAX_CONNECTIONS: USize = 64
    dir :: env.temp_dir().join("jet_embedded_devserver_connection_cap_{process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    port :: unused_local_port()
    fs.write(dir.join("app.jet"), fn_fixture_src(port, "host")).unwrap()
    guard :: start_embedded_devserver(&dir, port)
    // Incomplete requests hold admitted workers, not merely backlog sockets.
    holders := [TcpStream].with_capacity(MAX_CONNECTIONS)
    for _ in 0..MAX_CONNECTIONS {
        holder :: TcpStream.connect(("127.0.0.1", port)).expect("failed to connect an admission-cap holder")
        holder.set_write_timeout(Some(Duration.from_secs(1))).unwrap()
        holder.write_all(b"G").unwrap()
        holders.push(holder)
    }
    probe_request :: b"GET /__jet_dev_version HTTP/1.1\r\n\r\n"
    probe_deadline :: Instant.now() + Duration.from_secs(5)
    dropped := false
    while Instant.now() < probe_deadline {
        probe_result :: TcpStream.connect(("127.0.0.1", port))
        if probe_result.is_err() { dropped = true; break }
        probe :: probe_result.unwrap()
        probe.set_read_timeout(Some(Duration.from_millis(200))).unwrap()
        if probe.write_all(probe_request).is_err() { dropped = true; break }
        _ :: probe.shutdown(Shutdown.Write)
        response := [U8].new()
        result :: probe.read_to_end(&response)
        closed :: response.is_empty() && result.map(fn(_) { true }).unwrap_or_else(fn(error) {
            error.kind() == io.ErrorKind.ConnectionReset || error.kind() == io.ErrorKind.ConnectionAborted || error.kind() == io.ErrorKind.UnexpectedEof
        })
        if closed { dropped = true; break }
        thread.yield_now()
    }
    drop(holders)
    assert(dropped, "the connection after 64 occupied admission slots was not dropped or refused")
    wait_for_server_up(port, Duration.from_secs(3))
    drop(guard)
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/web_dev.rs:3626
#Test("embedded_devserver_deadline_is_absolute_under_successful_byte_trickle") {
    if !have_tool("rustc") { eprintln("note: skipping embedded_devserver_deadline_is_absolute_under_successful_byte_trickle (need rustc)"); return }
    const TRICKLE_BYTES: USize = 32
    const TRICKLE_INTERVAL: Duration = Duration.from_millis(200)
    dir :: env.temp_dir().join("jet_embedded_devserver_absolute_deadline_{process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    port :: unused_local_port()
    fs.write(dir.join("app.jet"), fn_fixture_src(port, "host")).unwrap()
    guard :: start_embedded_devserver(&dir, port)
    client :: TcpStream.connect(("127.0.0.1", port)).unwrap()
    client.set_read_timeout(Some(Duration.from_secs(12))).unwrap()
    client.write_all(b"GET /__jet_dev_version HTTP/1.1\r\nHost: localhost").unwrap()
    client.flush().unwrap()
    stop :: Arc.new(AtomicBool.new(false))
    start_barrier :: Arc.new(Barrier.new(2))
    writer_stop :: Arc.clone(&stop)
    writer_barrier :: Arc.clone(&start_barrier)
    trickle :: client.try_clone().unwrap()
    (sent_tx, sent_rx) :: mpsc.channel()
    writer :: thread.spawn(fn [^writer_stop, ^writer_barrier, ^trickle, ^sent_tx]() {
        writer_barrier.wait()
        sent := 0
        for index in 0..TRICKLE_BYTES {
            if writer_stop.load(Ordering.Acquire) || trickle.write_all(b"x").is_err() || trickle.flush().is_err() { break }
            sent += 1
            if index + 1 < TRICKLE_BYTES { thread.sleep(TRICKLE_INTERVAL) }
        }
        _ :: sent_tx.send(sent)
        while !writer_stop.load(Ordering.Acquire) { thread.yield_now() }
    })
    started :: Instant.now()
    start_barrier.wait()
    response := [U8].new()
    read_result :: client.read_to_end(&response)
    elapsed :: started.elapsed()
    stop.store(true, Ordering.Release)
    drop(client)
    writer.join().unwrap()
    sent :: sent_rx.recv_timeout(Duration.from_secs(1)).expect("trickle writer did not report its successful bytes")
    deadline_closed :: read_result.as_ref().map(fn(_) { true }).unwrap_or_else(fn(error) {
        error.kind() == io.ErrorKind.ConnectionReset || error.kind() == io.ErrorKind.ConnectionAborted || error.kind() == io.ErrorKind.UnexpectedEof
    })
    assert_eq(sent, TRICKLE_BYTES, "the client must deliver successful bytes before the absolute deadline")
    assert(deadline_closed && response.is_empty(), "the incomplete request must close without a response: read={read_result:?}, response={response:?}")
    assert(elapsed >= Duration.from_secs(9), "the deadline proof must allow the successful trickle to run: {elapsed:?}")
    assert(elapsed < Duration.from_millis(11500), "successful bytes renewed the request deadline: {elapsed:?}")
    drop(guard)
    _ :: fs.remove_dir_all(&dir)
}
