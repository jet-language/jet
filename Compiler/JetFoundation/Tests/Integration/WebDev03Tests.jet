    drop(guard)
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/web_dev.rs:4054
#Test("ul6_browser_watch_matrix_budget_reconnect_cleanup") {
    if !have_tool("rustc") { eprintln("note: skipping ul6_browser_watch_matrix_budget_reconnect_cleanup (need rustc)"); return }
    dir :: env.temp_dir().join("jet_ul6_web_{process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    src_path :: dir.join("app.jet")
    fs.write(&src_path, "#Target(Web)\nfn run() {\n    print(\"hello\")\n}\n").unwrap()
    session :: WatchSession.open(&src_path).unwrap()
    session.recover()
    assert(session.graph().node_count() >= 1)
    started :: Instant.now()
    thread.sleep(Duration.from_millis(30))
    fs.write(&src_path, "#Target(Web)\nfn run() {\n    print(\"hello-2\")\n}\n").unwrap()
    receipt :: session.poll().expect("web source change")
    ms :: started.elapsed().as_millis()
    assert(within_budget(&receipt) || ms <= EDIT_TO_VISIBLE_BUDGET_MS, "budget miss ms={ms} receipt={receipt.edit_to_visible_ms:?}")
    assert(!receipt.render().is_empty())
    session.acknowledge(&receipt).unwrap()
    _ :: fs.remove_dir_all(&dir)
    assert(!dir.exists() || fs.read_dir(&dir).map(fn(d) { d.count() }).unwrap_or(0) == 0)
}

// Rust: tests/web_examples_doc.rs:10
#Test("web_examples_are_documented_and_have_expected_outputs") {
    repo :: OSPath.from(env.var_os("CARGO_MANIFEST_DIR").unwrap())
    web_dir :: repo.join("Examples/features/web")
    expected_dir :: repo.join("Examples/features/expected/web")
    doc :: fs.read_to_string(repo.join("Docs/spec/reference/web-backend-wasm.md")).expect("web backend doc")
    jets := fs.read_dir(&web_dir).unwrap().filter_map(fn(e) { e.ok() }).map(fn(e) { e.path() }).filter(fn(p) { p.extension().is_some_and(fn(ext) { ext == "jet" }) }).collect()
    jets.sort()
    assert(!jets.is_empty(), "expected at least one web example")
    for jet in jets {
        name :: jet.file_name().unwrap().to_str().unwrap()
        assert(doc.contains(name), "{name} missing from Docs/spec/reference/web-backend-wasm.md")
        stem :: jet.file_stem().unwrap().to_str().unwrap()
        native :: expected_dir.join("{stem}.out")
        web :: expected_dir.join("{stem}.web.out")
        harness :: expected_dir.join("{stem}.harness.out")
        assert(native.is_file() || web.is_file() || harness.is_file(), "{name} has no golden under Examples/features/expected/web/")
    }
}
