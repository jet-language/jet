    (toks, _) :: jet.Lexer.lex(src)
    prog := jet.Parser.parse(&toks).unwrap()
    bundle := ProgramBundle {
        entry: 0,
        project_root: OSPath.from("."),
        ffi_callback_fns: [].into_set(),
        modules: [LoadedModule {
            path: OSPath.from("t.jet"), display: "t.jet", source: src.to_string(), alias: "main",
            imports: mem.take(&prog.imports), items: mem.take(&prog.items),
            script_body: mem.take(&prog.script_body), block_spans: mem.take(&prog.block_spans),
            web_target_ceiling: prog.web_target_ceiling, pub_file: prog.pub_file,
            no_prelude: prog.no_prelude, default_target: prog.default_target,
            html_path: prog.html_path.clone(), policy_declarations: mem.take(&prog.policy_declarations),
            user_policy_declarations: mem.take(&prog.user_policy_declarations), rule_facts: mem.take(&prog.rule_facts)
        }],
        devtools_registry: DevtoolsRegistry.default(), parse_teaching: [], used_core: Default.default(),
        cffi: Default.default(), comptime_inputs: [], name_ledger: NameLedger.default(),
        layer_ceiling: None, inferred_layer: RuntimeLayer.Core,
        web_partitions: Default.default(), web_partition_enforced: false, web_partition_report: None,
        dep_roots: Default.default(), package_guarantees: Default.default(), program_allocator: Default.default(),
        active_os: OSTarget.host(), build_facts: Default.default(), edition: "2026"
    }
    _ :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run)
    assert_eq(bundle.web_partitions.get("dom_fn"), Some(&WebBucket.JS))
}
// Rust: tests/web_partition.rs:265
#Test("imported_same_leaf_helpers_keep_distinct_buckets") {
    dir :: temp_web_project("same_leaf", &[
        ("main.jet", "#Target(Web)\nuse \"./left\" as left\nuse \"./right\" as right\n#Target(JS)\nfn run() { print(left.value() + right.value()) }\n"),
        ("left.jet", "#Target(JS)\nfn helper() -> Int { return 1 }\n#Target(JS)\npub fn value() -> Int { return helper() }\n"),
        ("right.jet", "fn helper() -> Int { return 2 }\n#WasmExport\npub fn value() -> Int { return helper() }\n")
    ])
    out :: jet.compile_web(dir.join("main.jet").to_str().unwrap()).expect("same-leaf partition fixture should compile")
    web :: out.web.expect("web artifacts")
    parts := manifest_partitions(&web.manifest_json)
    parts.sort()
    expected := [("__jet_left__helper", "JS"), ("__jet_left__value", "JS"), ("__jet_right__helper", "Wasm"), ("__jet_right__value", "Wasm"), ("run", "JS")]
    expected.sort()
    assert_eq(parts, expected)
    _ :: fs.remove_dir_all(dir)
}
// Rust: tests/web_partition.rs:301
#Test("wasm_export_and_target_pins_are_deterministic") {
    src :: """#Target(Web)
#WasmExport
fn exported() -> Int { return 3 }
#Target(Wasm)
fn pinned() -> Int { return 4 }
#Target(JS)
fn run() { print(exported()) }
"""
    out :: jet.compile_web_with_path(src, "tests/fixtures/web_partition_pins.jet").expect("pinned partition fixture should compile")
    web :: out.web.expect("web artifacts")
    parts := manifest_partitions(&web.manifest_json)
    parts.sort()
    expected := [("exported", "Wasm"), ("pinned", "Wasm"), ("run", "JS")]
    expected.sort()
    assert_eq(parts, expected)
    report :: out.web_partition_report.expect("web compile should set partition report")
    repeat :: jet.compile_web_with_path(src, "tests/fixtures/web_partition_pins.jet").expect("repeat compile").web_partition_report.expect("repeat report")
    assert_eq(report, repeat, "partition report must be stable across compiles")
}
// Rust: tests/web_partition.rs:338
#Test("inline_module_callback_keeps_qualified_js_partition") {
    src :: """#Target(Web)
module handlers {
    #Target(JS)
    pub fn init() { print("ready") }
}
#Target(JS)
fn run() { handlers.init() }
"""
    out :: jet.compile_web_with_path(src, "tests/fixtures/web_partition_callback.jet").expect("callback partition fixture should compile")
    web :: out.web.expect("web artifacts")
    parts :: manifest_partitions(&web.manifest_json)
    assert(parts.iter().any(fn((k, b)) { k == "handlers__init" && b == "JS" }), "callback module must stay JS-qualified: {parts:?}")
    assert(parts.iter().any(fn((k, b)) { k == "run" && b == "JS" }), "entry must stay JS: {parts:?}")
}
