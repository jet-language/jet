// Rust: tests/web_build.rs:1428
#Test("js_source_map_uses_line_markers_and_hides_host_paths") {
    src :: "#Target(JS)\nfn run() -> {{\n\n    first :: 1\n    print(\"left {{first}}\\n//# __jet_source_map line 999\\nright\")\n}}\n"
    shown :: "{env.temp_dir().display()}/private/build-host/project/main.jet"
    first :: jet.compile_web_with_path(src, shown).expect("web source-map fixture").web.expect("web artifacts")
    second :: jet.compile_web_with_path(src, shown).expect("repeat web source-map fixture").web.expect("web artifacts")
    assert_eq(first.js_app, second.js_app)
    assert_eq(first.js_source_map, second.js_source_map)
    assert(!first.js_app.contains("sourceMappingURL="))
    assert(first.js_source_map.starts_with("{{\"version\":3,\"file\":\"app.js\",\"sources\":[\"main.jet\"],\"sourcesContent\":["))
    assert(first.js_source_map.contains("\"#Target(JS)\\nfn run() -> {{\\n\\n    first :: 1\\n    print(\\\"left {{first}}\\\\n//# __jet_source_map line 999\\\\nright\\\")\\n}}\\n\""), "sourcesContent must contain the exact Jet bytes:\n{first.js_source_map}")
    assert(!first.js_source_map.contains("/private/build-host"))
    assert(first.js_app.contains("//# __jet_source_map line 999"), "user text must survive internal marker stripping:\n{first.js_app}")
    mappings :: decode_source_map_mappings(first.js_source_map)
    assert_eq(mappings.iter().map((row) -> (row.2, row.3, row.4)).collect(), [(0, 4, 0), (0, 5, 0)])
    loop (generated_line, generated_column, _, _, _) in mappings {
        line :: first.js_app.lines().nth(generated_line).unwrap()
        first_code :: line.find((c) -> !c.is_whitespace()).unwrap()
        assert_eq(generated_column, line[..<first_code].encode_utf16().count())
        assert(line[first_code..].starts_with("let first =") || line[first_code..].starts_with("jetDom.print(`left ${{first}}"), "mapping does not point at a Jet statement: {line}")
    }
}
// Rust: tests/web_build.rs:1486
#Test("web_build_publishes_maps_and_release_omits_them") {
    if !have_tool("rustc") {
        eprintln("note: skipping web map publication test (need rustc)")
        return
    }
    src :: "#Target(JS)\nfn run() -> {{\n    print(\"hi\")\n}}\n"
    dir :: env.temp_dir().join("jet_web_maps_pub_{process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).unwrap()
    fs.write(dir.join("main.jet"), src).unwrap()
    executable :: jet_bin()
    default_out :: Command.new(executable).current_dir(dir).args(["build", "--target=web", "main.jet"]).output().expect("jet build --target=web")
    assert(default_out.status.success(), "default web build failed:\n{String.from_utf8_lossy(default_out.stderr)}")
    js :: fs.read_to_string(cli_build_root(dir).join("app.js")).unwrap()
    assert(js.contains("//# sourceMappingURL=app.js.map"), "missing js map URL:\n{js}")
    js_map :: fs.read_to_string(cli_build_root(dir).join("app.js.map")).unwrap()
    assert(js_map.contains("\"version\":3"), "{js_map}")
    assert(js_map.contains("\"sourcesContent\":["), "{js_map}")
    assert(!js_map.contains("/home/"), "host path leaked into js map")
    wasm_map :: fs.read_to_string(cli_build_root(dir).join("app.wasm.map")).unwrap()
    assert(wasm_map.contains("\"file\":\"app.wasm\""), "{wasm_map}")
    assert(wasm_map.contains("\"sourcesContent\":["), "{wasm_map}")
    default_wasm :: fs.read(cli_build_root(dir).join("app.wasm")).unwrap()
    assert(default_wasm.windows("sourceMappingURL".as_bytes().len()).any((w) -> w == "sourceMappingURL".as_bytes()), "wasm missing sourceMappingURL custom section")
    assert(default_wasm.windows("app.wasm.map".as_bytes().len()).any((w) -> w == "app.wasm.map".as_bytes()), "wasm missing relative map URL")
    release_out :: Command.new(executable).current_dir(dir).args(["build", "--target=web", "--profile=release", "main.jet"]).output().expect("jet build --target=web --profile=release")
    assert(release_out.status.success(), "release web build failed:\n{String.from_utf8_lossy(release_out.stderr)}")
    release_js :: fs.read_to_string(cli_build_root(dir).join("app.js")).unwrap()
    assert(!release_js.contains("sourceMappingURL="), "release app.js must not reference maps")
    assert(!cli_build_root(dir).join("app.js.map").is_file(), "release must not write app.js.map")
    assert(!cli_build_root(dir).join("app.wasm.map").is_file(), "release must not write app.wasm.map")
    release_manifest :: fs.read_to_string(cli_build_root(dir).join("web.manifest.json")).unwrap()
    assert(!release_manifest.contains("\"sourceMap\""), "release manifest must omit sourceMap")
    release_wasm :: fs.read(cli_build_root(dir).join("app.wasm")).unwrap()
    assert(!release_wasm.windows("sourceMappingURL".as_bytes().len()).any((w) -> w == "sourceMappingURL".as_bytes()), "release wasm must not embed sourceMappingURL")
    assert(release_wasm.len() <= default_wasm.len(), "optimized release Wasm must not exceed the mapped default artifact: {release_wasm.len()} > {default_wasm.len()} bytes")
    assert(!release_wasm.windows(".debug_".as_bytes().len()).any((w) -> w == ".debug_".as_bytes()), "optimized release Wasm must not carry debug custom sections")
    wasm_src :: "#Target(Web)\n#WasmExport\nfn add(a: Int, b: Int) -[]> Int {{ return a + b }}\nfn run() -> {{}}\n"
    fs.write(dir.join("wasm.jet"), wasm_src).unwrap()
    wasm_out :: Command.new(executable).current_dir(dir).args(["build", "--target=web", "wasm.jet"]).output().expect("jet build wasm export")
    assert(wasm_out.status.success(), "wasm export build failed:\n{String.from_utf8_lossy(wasm_out.stderr)}")
    wasm_map2 :: fs.read_to_string(cli_build_root(dir).join("app.wasm.map")).unwrap()
    mappings_field :: wasm_map2.split("\"mappings\":").nth(1).and_then((rest) -> rest.split(",").next()).unwrap_or("")
    assert(mappings_field.contains("\"") && mappings_field.len() > 3, "wasm export map must carry mappings:\n{wasm_map2}")
    _ :: fs.remove_dir_all(dir)
}
