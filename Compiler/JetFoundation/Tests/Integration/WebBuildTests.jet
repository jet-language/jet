// Rust: tests/web_build.rs:232
#Test("knowledge_tier_web_js_and_wasm_runtime_values_match") {
    if !have_tool("rustc") || !have_tool("node") {
        eprintln("note: skipping knowledge web parity test (need rustc + node)")
        return
    }
    source :: knowledge_tier_web_source()
    dir :: build_web_fixture("knowledge_tier", source, "tests/fixtures/knowledge_tier_web.jet")
    expected :: "42\nexactness=true\nunit=5.0\nstate=state\nclassification=world\nrange=9\n"
    assert_eq(run_web_app(dir), expected, "JS web bridge output changed")
    harness :: """
const { instantiateWasm, takeWasmError } = await import("./jet_dom_runtime.js");
const instance = await instantiateWasm("./app.wasm");
instance.exports.jet_export_run();
if (takeWasmError(instance.exports)?.tag !== "Ok") throw new Error("unexpected Wasm outcome");
"""
    assert_eq(run_node_harness(dir, "knowledge_tier_wasm_harness.mjs", harness), expected, "Wasm runtime output changed")
    _ :: fs.remove_dir_all(dir)
}
// Rust: tests/web_build.rs:265
// D-CONC-ALLNAMED1=A: authored completion order differs from canonical field order.
#Test("web_named_task_all_maps_heterogeneous_reverse_completion_on_js_and_wasm") {
    if !have_tool("rustc") || !have_tool("node") {
        eprintln("note: skipping named task.all web parity test (need rustc + node)")
        return
    }
    src :: """
#Target(Web)
fn slow() -> String {
    turns := 0
    loop _ in 0..<50000 { turns += 1 }
    return "slow"
}
fn fast() -> Int { return 7 }
fn run() -> {
    values :: (task.all {
        z: slow(),
        a: fast()
    }) ?? panic("named task.all failed")
    print(values.z)
    print(values.a)
}
"""
    expected :: "slow\n7\n"
    js_src :: src.replace("fn slow()", "#Target(JS)\nfn slow()").replace("fn fast()", "#Target(JS)\nfn fast()").replace("fn run()", "#Target(JS)\nfn run()")
    js_dir :: build_web_fixture("named_task_all_reverse_completion_js", js_src, "tests/fixtures/web_named_task_all_reverse_completion.jet")
    assert_eq(run_web_app(js_dir), expected, "JS named task.all mapping changed")
    app :: fs.read_to_string(js_dir.join("build/app.js")).unwrap()
    assert(app.contains("await jet_task_all_named(") && app.contains("[\"z\", \"a\"]") && app.contains("[\"a\", \"z\"]"), "JS must pass authored fields and project canonical fields:\n{app}")
    _ :: fs.remove_dir_all(js_dir)
    wasm_dir :: build_web_fixture("named_task_all_reverse_completion_wasm", src, "tests/fixtures/web_named_task_all_reverse_completion.jet")
    harness :: """
const { instantiateWasm, takeWasmError } = await import("./jet_dom_runtime.js");
const instance = await instantiateWasm("./app.wasm");
instance.exports.jet_export_run();
if (takeWasmError(instance.exports)?.tag !== "Ok") throw new Error("unexpected Wasm outcome");
"""
    assert_eq(run_node_harness(wasm_dir, "named_task_all_wasm_harness.mjs", harness), expected, "Wasm named task.all mapping changed")
    wasm :: fs.read_to_string(wasm_dir.join("build/app_wasm.rs")).unwrap()
    assert(wasm.contains("__jet_z: __jet___named_all_value_") && wasm.contains("__jet_a: __jet___named_all_value_"), "Wasm must assemble the named result by field:\n{wasm}")
    _ :: fs.remove_dir_all(wasm_dir)
}
