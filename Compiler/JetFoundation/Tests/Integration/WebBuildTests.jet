// Rust: tests/web_build.rs:1642
#Test("wasm_void_body_and_internal_helper_are_emitted_from_tir") {
    src :: """
#Target(Web)
fn tick() -> {}
#WasmExport
fn ping() -> { tick() }
fn twice(n: Int) -> Int { return n * 2 }
#WasmExport
fn compute(n: Int) -> Int { return twice(n) }
fn run() -> {}
"""
    out :: jet.compile_web_with_path(src, "tests/fixtures/web_wasm_helpers.jet").expect("supported Wasm helpers should compile")
    wasm :: out.web.expect("web artifacts").wasm_rust
    assert(wasm.contains("fn jet_wasm_tick()"))
    assert(wasm.contains("jet_wasm_tick()"), "void body side effect was dropped:\n{wasm}")
    assert(wasm.contains("fn jet_wasm_twice(__jet_n: JetWasmInt) -> JetOutcome<JetWasmInt, JetErr>"))
    assert(wasm.contains("jet_wasm_twice("), "export did not call internal helper:\n{wasm}")
}
// Rust: tests/web_build.rs:1670
#Test("web_value_and_range_arm_tables_emit_on_js_and_wasm") {
    // D-IF3: arm tables share MixedSwitch / RangeSwitch with native.
    src :: """
#Target(Web)
#Target(JS)
fn digit(n: Int) -> String {
    if n == {
        0 -> { "0" }
        1 -> { "1" }
        else -> { "x" }
    }
}
#Target(JS)
fn band(n: Int) -> String {
    if n == {
        0..9 -> { "low" }
        else -> { "high" }
    }
}
#WasmExport
fn wasm_digit(n: Int) -> String {
    if n == {
        0 -> { "0" }
        1 -> { "1" }
        else -> { "x" }
    }
}
#WasmExport
fn wasm_band(n: Int) -> String {
    if n == {
        0..9 -> { "low" }
        10..19 -> { "mid" }
        else -> { "high" }
    }
}
fn run() -> {}
"""
    out :: jet.compile_web_with_path(src, "tests/fixtures/web_arm_tables.jet").expect("value/range arm tables must compile on web")
    web :: out.web.expect("web artifacts")
    assert(web.js_app.contains("} else if"), "JS MixedSwitch must emit an if/else-if chain:\n{web.js_app}")
    assert(web.js_app.contains("(n == 0n)") && web.js_app.contains("(n == 1n)"), "JS MixedSwitch must compare the already-bound parameter subject:\n{web.js_app}")
    assert(web.wasm_rust.contains("__jet_n == JetWasmInt::from_i64(0)") && web.wasm_rust.contains("__jet___if_range_"), "Wasm arm tables must reuse the parameter and cache each range subject:\n{web.wasm_rust}")
    assert(web.wasm_rust.contains("} else if"), "Wasm arm tables must emit an if/else-if chain:\n{web.wasm_rust}")
    assert(web.wasm_rust.contains(">= JetWasmInt::from_i64(0)") && web.wasm_rust.contains("<= JetWasmInt::from_i64(9)"), "Wasm RangeSwitch must emit inclusive range tests:\n{web.wasm_rust}")
}
