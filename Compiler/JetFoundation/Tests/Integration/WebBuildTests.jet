#Test("web_decimal_and_grouped_formatters_use_shared_helpers") {
    if !have_tool("rustc") || !have_tool("node") {
        eprintln("note: skipping decimal/grouped web parity test (need rustc + node)")
        return
    }
    source :: """
#Target(Web)
use core.text.fmt as fmt
fn run() -> {
    print(fmt.decimal(Float{1234.5678}, 2))
    print(fmt.grouped(Float{1234.5678}, 2))
    print(fmt.decimal(1234, 2))
    print(fmt.grouped(1234, 2))
}
"""
    dir :: build_web_fixture("decimal_grouped", source, "tests/fixtures/web_decimal_grouped.jet")
    wasm_rust :: fs.read_to_string(dir.join("build/app_wasm.rs")).unwrap()
    js_app :: fs.read_to_string(dir.join("build/app.js")).unwrap()
    loop helper in ["jet_fmt_decimal(", "jet_fmt_grouped(", "jet_fmt_decimal_int(", "jet_fmt_grouped_int("] {
        assert(wasm_rust.contains(helper), "missing {helper} in wasm Rust")
    }
    assert(js_app.contains("function jet_fmt_decimal("))
    assert(js_app.contains("function jet_fmt_grouped("))
    assert(js_app.contains("function jet_fmt_decimal_int("))
    assert(js_app.contains("function jet_fmt_grouped_int("))
    expected :: "1234.57\n1,234.57\n1234.00\n1,234.00\n"
    assert_eq(run_web_app(dir), expected, "JS formatter output changed")
    harness :: """
const { instantiateWasm, takeWasmError } = await import("./jet_dom_runtime.js");
const instance = await instantiateWasm("./app.wasm");
instance.exports.jet_export_run();
if (takeWasmError(instance.exports)?.tag !== "Ok") throw new Error("unexpected Wasm outcome");
"""
    assert_eq(run_node_harness(dir, "decimal_grouped_wasm_harness.mjs", harness), expected, "Wasm formatter output changed")
    _ :: fs.remove_dir_all(dir)
}
// Rust: tests/web_build.rs:1297
#Test("web_template_literals_keep_hostile_text_as_data") {
    source :: """
#Target(JS)
fn run() -> {
    value :: "safe"
    print("`\\${owned}\n{value}")
}
"""
    web :: jet.compile_web_with_path(source, "tests/fixtures/web_template_hostile.jet").expect("hostile template literal should compile").web.expect("web artifacts")
    assert(web.js_app.contains("\\`"), "backtick escaped in JS:\n{web.js_app}")
    assert(web.js_app.contains("\\${{owned}}"), "literal interpolation marker escaped in JS:\n{web.js_app}")
    assert(web.js_app.contains("\\\\"), "backslash escaped in JS:\n{web.js_app}")
    assert(web.js_app.contains("\\n"), "newline escaped in JS:\n{web.js_app}")
}
