// Rust: tests/web_build.rs:766
#Test("jet_cli_infers_web_target_from_file_marker") {
    if !have_tool("rustc") {
        eprintln("note: skipping web-target-inference (file marker) test")
        return
    }
    dir :: env.temp_dir().join("jet_web_target_marker_{process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).unwrap()
    fs.write(dir.join("app.jet"), """
#Target(Web)
use core.ui as ui
fn run() -> {
    b :: ui.null_backend()
    n :: ui.node_color("hi", 10.0, 5.0, "#3366ff")
    c :: ui.constraint(0.0, 0.0, 50.0, 20.0)
    s :: b.measure(n, c)
    f :: ui.rect(0.0, 0.0, s.width, s.height)
    b.layout(n, f)
    b.paint(n)
}
""").unwrap()
    fs.write(dir.join("package.jet"), "name: \"webproj\"\nversion: \"0.1.0\"\nauthority: {{ holds: {{ allow: [Browser] }} }}\n").unwrap()
    // Deliberately no --target=.
    out :: Command.new(jet_bin()).current_dir(dir).args(["build", "app.jet"]).output().unwrap()
    assert(out.status.success(), "jet build (no --target flag) should infer web from #Target(Web):\nstdout: {String.from_utf8_lossy(out.stdout)}\nstderr: {String.from_utf8_lossy(out.stderr)}")
    assert(cli_build_root(dir).join("app.js").is_file(), "no .jet/build/app.js — web backend wasn't inferred")
    assert(cli_build_root(dir).join("app.wasm").is_file(), "no .jet/build/app.wasm — web backend wasn't inferred")
    _ :: fs.remove_dir_all(dir)
}
// Rust: tests/web_build.rs:813
#Test("jet_cli_infers_web_target_from_manifest") {
    if !have_tool("rustc") {
        eprintln("note: skipping web-target-inference (manifest) test")
        return
    }
    dir :: env.temp_dir().join("jet_web_target_manifest_{process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).unwrap()
    fs.write(dir.join("package.jet"), "name: \"webproj\"\nversion: \"0.1.0\"\ntarget: \"web\"\nauthority: {{ holds: {{ allow: [Browser] }} }}\n").unwrap()
    fs.write(dir.join("main.jet"), """
use core.ui as ui
fn run() -> {
    b :: ui.null_backend()
    n :: ui.node_color("hi", 10.0, 5.0, "#3366ff")
    c :: ui.constraint(0.0, 0.0, 50.0, 20.0)
    s :: b.measure(n, c)
    f :: ui.rect(0.0, 0.0, s.width, s.height)
    b.layout(n, f)
    b.paint(n)
}
""").unwrap()
    executable :: jet_bin()
    out :: Command.new(executable).current_dir(dir).args(["build", "main.jet"]).output().unwrap()
    assert(out.status.success(), "jet build (no --target flag) should infer web from package.jet target: \"web\":\nstdout: {String.from_utf8_lossy(out.stdout)}\nstderr: {String.from_utf8_lossy(out.stderr)}")
    assert(cli_build_root(dir).join("app.js").is_file(), "no .jet/build/app.js — web backend wasn't inferred from package.jet")
    assert(cli_build_root(dir).join("app.wasm").is_file(), "no .jet/build/app.wasm — web backend wasn't inferred from package.jet")
    run :: Command.new(executable).current_dir(dir).args(["run", "main.jet"]).output().unwrap()
    assert(!run.status.success(), "jet run must reject a package web default:\nstdout: {String.from_utf8_lossy(run.stdout)}\nstderr: {String.from_utf8_lossy(run.stderr)}")
    assert(run.stdout.is_empty(), "a rejected package web run must not execute user code")
    run_stderr :: String.from_utf8_lossy(run.stderr)
    assert(run_stderr.contains("E-WEB-RUN") && run_stderr.contains("jet dev") && run_stderr.contains("jet build --target=web"), "package web run should explain the native/web boundary: {run_stderr}")
    _ :: fs.remove_dir_all(dir)
}
// Rust: tests/web_build.rs:881
#Test("jet_cli_rejects_native_run_for_web_marker") {
    dir :: env.temp_dir().join("jet_web_target_run_rejects_{process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).unwrap()
    fs.write(dir.join("app.jet"), "#Target(Web)\nfn run() -> {{\n    print(\"native\")\n}}\n").unwrap()
    out :: Command.new(jet_bin()).current_dir(dir).args(["run", "app.jet"]).output().unwrap()
    assert(!out.status.success(), "jet run must reject #Target(Web) before native execution:\nstdout: {String.from_utf8_lossy(out.stdout)}\nstderr: {String.from_utf8_lossy(out.stderr)}")
    assert_eq(String.from_utf8_lossy(out.stdout), "", "a rejected native run must not execute the web program")
    stderr :: String.from_utf8_lossy(out.stderr)
    assert(stderr.contains("E-WEB-RUN"), "expected the registered diagnostic: {stderr}")
    assert(stderr.contains("jet dev") && stderr.contains("jet build --target=web"), "diagnostic must teach both supported web paths: {stderr}")
    _ :: fs.remove_dir_all(dir)
}
// Rust: tests/web_build.rs:924
#Test("jet_cli_explicit_native_target_runs_web_default_natively") {
    if !have_tool("rustc") {
        eprintln("note: skipping explicit-native-target web-default test")
        return
    }
    host_output :: Command.new("rustc").args(["-vV"]).output().expect("query rustc host target")
    host :: String.from_utf8(host_output.stdout).expect("rustc version output is UTF-8").lines().find_map((line) -> line.strip_prefix("host: ")).expect("rustc -vV must report a host target").to_string()
    dir :: env.temp_dir().join("jet_web_target_explicit_native_{process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).unwrap()
    fs.write(dir.join("app.jet"), "#Target(Web)\nfn run() -> {{\n    print(\"native\")\n}}\n").unwrap()
    out :: Command.new(jet_bin()).current_dir(dir).args(["run", "--target", host, "app.jet"]).output().unwrap()
    assert(out.status.success(), "explicit host target must run the web-default source natively:\nstdout: {String.from_utf8_lossy(out.stdout)}\nstderr: {String.from_utf8_lossy(out.stderr)}")
    assert_eq(String.from_utf8_lossy(out.stdout), "native\n", "explicit native target must execute the program")
    _ :: fs.remove_dir_all(dir)
}
