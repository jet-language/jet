//RS #[test]
//RS fn fmt_preserves_checked_text_type() {
//RS     // D-TEXTHEAD-TYPE1=A: the ordinary checked-text type and its audited raw
//RS     // escape must survive byte-for-byte.
//RS     let src = "\
//RS enum TextError { Empty }
//RS 
//RS Pattern :: distinct String
//RS 
//RS impl Pattern.CheckedText {
//RS     type Error = TextError
//RS 
//RS     fn check(text: String) Err! -[]> {
//RS         if text == \"\" { return Err(TextError.Empty) }
