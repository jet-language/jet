//RS #[test]
//RS fn fmt_write_sigil_d_mem1_stability() {
//RS     // D-MEM1 (S1): `&T` is the write sigil (param + call-site mirror), `&self`
//RS     // is the write receiver, `^T`/`^self` (take/move) are unchanged, and plain
//RS     // `T`/`self` (read) carries no sigil. Must all survive fmt unchanged.
//RS     let src = "\
//RS struct Player {
//RS     hp: Int
//RS }
//RS 
//RS impl Player {
//RS     fn show(self) -> Int { return self.hp }
//RS 
//RS     fn heal(&self, amount: Int) { self.hp = self.hp + amount }
//RS }
//RS 
//RS fn damage(p: &Player, amount: Int) {
//RS     p.hp = p.hp - amount
//RS }
//RS 
//RS fn archive(p: ^Player) -> Int {
//RS     return p.hp
//RS }
//RS 
//RS fn run() {
//RS     p := Player{hp: 100}
//RS     damage(&p, 10)
//RS     p.heal(5)
//RS     print(archive(^p))
//RS }
//RS ";
//RS     assert_fmt_keeps(
//RS         src,
//RS         &[
//RS             "fn heal(&self, amount: Int)",
