use jet.[format_source, render_diagnostics]

// Rust: tests/fmt.rs:2123
// Check first-pass token survival as well as subsequent idempotence.
pub fn assert_fmt_keeps(src: String, needles: [String], label: String) -> {
    out := format_source(src).unwrap_or_else(d -> panic("fmt failed for {label}:\n{render_diagnostics(label, src, &d)}"))
    loop needle in needles {
        assert(out.contains(needle), "{label}: fmt dropped `{needle}`\n--- got ---\n{out}")
    }
    twice := format_source(out).expect("second fmt should succeed")
    assert_eq(out, twice, "{label}: fmt is not idempotent\n--- got ---\n{out}")
}
