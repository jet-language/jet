// Project-check proof rows retain exact content fingerprints; scrub only fixture paths.
use jet_foundation.DataTree.DataTree
use jet_foundation.JSON.[json_get, json_str, parse]
use std.[fs, env]
use std.io.ErrorKind
use std.process.[Command, Output]
use std.time.[Instant, SystemTime, UNIX_EPOCH]
use core.path.OSPath
use Common as common

// Rust: tests/project_check.rs:16
pub fn fixture_root() -> OSPath { env.manifest_dir().join("tests/project_check/fixtures") }
// Rust: tests/project_check.rs:20
pub fn fixture(name: String) -> OSPath { fixture_root().join(name) }
// Rust: tests/project_check.rs:24
pub fn jet_bin() -> OSPath { common.jet_bin() }
// Rust: tests/project_check.rs:28
// GATE #4494: real CLI process output and fixture filesystem.
pub fn run_check(name: String, args: &[String]) -> Output {
    dir :: fixture(name)
    Command.new(jet_bin()).args(args).current_dir(&dir).env("NO_COLOR", "1").env("TERM", "dumb").output().unwrap_or_else(fn(error) { panic("jet check {name} failed to start: {error}") })
}
// Rust: tests/project_check.rs:39
pub fn run_uncached(name: String, args: &[String]) -> Output {
    dir :: fixture(name)
    Command.new(jet_bin()).args(args).current_dir(&dir).env("JET_RECEIPT_BYPASS", "1").env("NO_COLOR", "1").env("TERM", "dumb").output().unwrap_or_else(fn(error) { panic("jet {args[0]} {name} failed to start: {error}") })
}
// Rust: tests/project_check.rs:51
pub fn scratch_root(name: String) -> OSPath {
    stamp :: SystemTime.now().duration_since(UNIX_EPOCH).expect("system clock before Unix epoch").as_nanos()
    base :: env.var_os("HOME").map(fn(home) { OSPath.from(home).join(".cache/jet-test-scratch") }).unwrap_or_else(fn() { OSPath.from(".cache/jet-test-scratch") })
    root :: base.join("project-check-{name}-{std.process.id()}-{stamp}")
    _ :: fs.remove_dir_all(&root)
    fs.create_dir_all(&root).expect("create project-check scratch root")
    root
}
// Rust: tests/project_check.rs:69
pub fn copy_receipt_fixture(root: &OSPath) -> Unit {
    for (source_relative, destination_relative) in [("workspace.jet", "workspace.jet"), ("lock.fixture", ".jet/lock"), ("packages/app/package.jet", "packages/app/package.jet"), ("packages/app/app/main.jet", "packages/app/app/main.jet"), ("packages/app/lock.fixture", "packages/app/.jet/lock"), ("packages/app/fixtures/generated/input.jet", "packages/app/.jet/generated/input.jet")] {
        source :: fixture("receipt_invalidation").join(source_relative)
        destination :: root.join(destination_relative)
        fs.create_dir_all(destination.parent().unwrap_or_else(fn() { panic("fixture destination has no parent") })).expect("create copied fixture parent")
        fs.copy(&source, &destination).unwrap_or_else(fn(error) { panic("copy receipt fixture {source.display()} -> {destination.display()}: {error}") })
    }
}
// Rust: tests/project_check.rs:99
pub fn copy_fixture_tree(source: &OSPath, destination: &OSPath) -> Unit {
    fs.create_dir_all(destination).unwrap_or_else(fn(error) { panic("create staged fixture {destination.display()}: {error}") })
    entries :: fs.read_dir(source).unwrap_or_else(fn(error) { panic("read fixture {source.display()}: {error}") })
    for entry in entries {
        entry :: entry.unwrap_or_else(fn(error) { panic("read entry in fixture {source.display()}: {error}") })
        source_path :: entry.path()
        destination_path :: destination.join(entry.file_name())
        file_type :: entry.file_type().unwrap_or_else(fn(error) { panic("inspect fixture entry {source_path.display()}: {error}") })
        if file_type.is_dir() { copy_fixture_tree(&source_path, &destination_path) }
        else if file_type.is_file() {
            fs.copy(&source_path, &destination_path).unwrap_or_else(fn(error) { panic("copy fixture {source_path.display()} -> {destination_path.display()}: {error}") })
        } else { panic("unsupported fixture entry {source_path.display()}") }
    }
}
// Rust: tests/project_check.rs:133
// GATE #4409: only NotFound is benign; all other IO errors fail.
pub fn clear_receipt_store(path: &OSPath) -> Unit {
    match fs.remove_dir_all(path) {
        .Ok(_) -> {}
        .Err(error) -> if error.kind() != ErrorKind.NotFound { panic("clear receipt store {path.display()}: {error}") }
    }
}
// Rust: tests/project_check.rs:143
pub fn run_project_check(dir: &OSPath, receipt_dir: &OSPath, args: &[String]) -> Output {
    Command.new(jet_bin()).args(args).arg("--verbose").current_dir(dir).env("JET_RECEIPT_DIR", receipt_dir).env_remove("JET_RECEIPT_BYPASS").env("NO_COLOR", "1").env("TERM", "dumb").output().unwrap_or_else(fn(error) { panic("jet check in {dir.display()} failed to start: {error}") })
}
// Rust: tests/project_check.rs:156
pub fn assert_project_check_passed(output: &Output, context: String) -> Unit {
    assert(output.status.success(), "{context} failed:\nstdout:\n{String.from_utf8_lossy(&output.stdout)}\nstderr:\n{String.from_utf8_lossy(&output.stderr)}")
}
// Rust: tests/project_check.rs:165
pub fn receipt_replayed(output: &Output) -> Bool { String.from_utf8_lossy(&output.stderr).contains("ok: check current") }
// Rust: tests/project_check.rs:169
pub fn machine_rows(output: &Output) -> [DataTree] {
    assert_project_check_passed(output, "machine project check")
    stdout :: String.from_utf8_lossy(&output.stdout)
    trimmed := stdout.trim() // #4303
    report :: parse(trimmed).unwrap_or_else(fn(error) { panic("project check --json emitted invalid JSON: {error}\n{stdout}") })
    assert_eq(json_get(&report, "contract").and_then(json_str), Some("jet.check/v1"), "project check machine contract changed")
    elapsed_valid :: match json_get(&report, "elapsed_ms") {
        Some(DataTree.Int(milliseconds)) -> milliseconds >= 0
        _ -> false
    }
    assert(elapsed_valid, "project check machine result must record elapsed_ms")
    match json_get(&report, "rows") {
        Some(DataTree.Array(rows)) -> rows.clone()
        other -> panic("project check machine rows must be an array, got {other:?}")
    }
}
// Rust: tests/project_check.rs:190
pub fn scrub_fixture_path(text: String, dir: &OSPath) -> String {
    absolute :: dir.canonicalize().unwrap_or_else(fn(error) { panic("fixture {dir.display()} is not canonical: {error}") })
    text.replace(absolute.to_string_lossy(), "<fixture>")
}
// Rust: tests/project_check.rs:197
pub fn proof_snapshot(output: &Output, dir: &OSPath) -> String {
    stdout :: String.from_utf8_lossy(&output.stdout)
    snapshot := stdout.lines().filter(fn(line) { line.starts_with("proof: ") }).map(fn(line) { scrub_fixture_path(line, dir) }).collect<[String]>().join("\n")
    if !snapshot.is_empty() { snapshot.push('\n') }
    snapshot
}
// Rust: tests/project_check.rs:211
pub fn stderr_snapshot(output: &Output, dir: &OSPath) -> String { scrub_fixture_path(String.from_utf8_lossy(&output.stderr), dir) }
// Rust: tests/project_check.rs:215
pub fn expected(name: String, extension: String) -> OSPath { fixture(name).join("expected.{extension}") }
// Rust: tests/project_check.rs:219
pub fn assert_snapshot(name: String, extension: String, actual: String) -> Unit {
    path :: expected(name, extension)
    if env.var_os("UPDATE_EXPECT").is_some() {
        fs.write(&path, actual).unwrap_or_else(fn(error) { panic("write snapshot {path.display()}: {error}") })
        return
    }
    want :: fs.read_to_string(&path).unwrap_or_else(fn(error) { panic("read snapshot {path.display()}: {error}") })
    assert_eq(actual, want, "snapshot mismatch for {path.display()}")
}
// Rust: tests/project_check.rs:231
pub fn assert_project_proof_rows(fixture_name: String, proof: String) -> Unit {
    rows :: proof.lines().collect<[String]>()
    assert_eq(rows.len(), 4, "project check {fixture_name} must expose one row for each proof class:\n{proof}")
    for (label, code) in [("entry resolution", "E2389"), ("module graph", "E2390"), ("Core closure", "E2391"), ("tier lowering", "E2392")] {
        assert(rows.iter().any(fn(row) { row.contains(label) && row.contains(code) && row.contains("[proven]") }), "project check {fixture_name} did not prove {label} ({code}):\n{proof}")
    }
    assert(!proof.contains("absent from the checked module graph"), "clean project check reported an unresolved output:\n{proof}")
}
// Rust: tests/project_check.rs:256
pub fn assert_clean_project(name: String) -> Unit {
    output :: run_check(name, &["check", "--verbose", "."])
    assert(output.status.success(), "project check {name} failed:\n{String.from_utf8_lossy(&output.stderr)}")
    proof :: proof_snapshot(&output, &fixture(name))
    assert_project_proof_rows(name, &proof)
    assert_snapshot(name, "stdout", &proof)
}
