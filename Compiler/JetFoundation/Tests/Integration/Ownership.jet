//RS /// D-CONC-SHARE1=A (card #1561): plain field access on a `Shared<T>` is the
//RS /// only source spelling. Sema desugars a field read into ONE locked read and a
//RS /// field write into ONE locked edit, both through the same Prelude seam the
//RS /// retired closure forms used, so no execution tier grows a second mechanism.
//RS /// The synthesized payload parameter is `__jet_shared_value`, a name no user
//RS /// program can spell, so counting its closures counts the locks taken.
//RS #[test]
//RS fn shared_callbacks_receive_exactly_one_host_borrow() {
//RS     let src = r#"
//RS struct Config { hits: Int }
//RS fn run() {
//RS     config := shared Config{ hits: 0 }
//RS     print(config.hits)
//RS     config.hits += 1
//RS }
//RS "#;
//RS     let out = jet::compile(src).expect("plain shared access must lower without double borrowing");
//RS     assert!(
//RS         out.rust.contains("|__jet_shared_value: &__jet_Config|"),
//RS         "{}",
//RS         out.rust
//RS     );
//RS     assert!(
//RS         out.rust.contains("|__jet_shared_value: &mut __jet_Config|"),
//RS         "{}",
//RS         out.rust
//RS     );
//RS     assert!(!out.rust.contains("&&__jet_Config"), "{}", out.rust);
//RS     assert!(!out.rust.contains("&mut &__jet_Config"), "{}", out.rust);
//RS     // The single-write property. `config.hits += 1` is a read-modify-write, and
//RS     // the desugar must keep both halves inside ONE edit so no update is lost. A
//RS     // two-step lowering would either add a second read closure (the `+=` load)
//RS     // or nest a read inside the edit; either way the counts below move. One
//RS     // read closure (`print(config.hits)`) and one edit closure (`+= 1`) is the
//RS     // only shape in which the write's load and store share a single lock.
//RS     assert_eq!(
//RS         out.rust
//RS             .matches("|__jet_shared_value: &__jet_Config|")
//RS             .count(),
//RS         1,
//RS         "the field read is one locked read: {}",
//RS         out.rust
//RS     );
//RS     assert_eq!(
//RS         out.rust
//RS             .matches("|__jet_shared_value: &mut __jet_Config|")
//RS             .count(),
//RS         1,
//RS         "the read-modify-write is one locked edit: {}",
//RS         out.rust
//RS     );
//RS }
