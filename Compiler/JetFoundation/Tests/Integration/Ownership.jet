//RS #[test]
//RS fn shared_auto_clone_in_loop_is_lint() {
//RS     let src = r#"
//RS fn noop(h: Shared<Int>) {
//RS     print(0)
//RS }
//RS 
//RS fn loop_user(h: Shared<Int>) {
//RS     loop {
//RS         noop(h)
//RS     }
//RS }
//RS 
//RS fn run() {
//RS     print(0)
//RS }
//RS "#;
//RS     let out = jet::compile(src).expect("should compile with lint");
//RS     assert!(
//RS         out.lints.iter().any(|d| d.code == "L0202"),
//RS         "expected L0202 loop auto-clone lint"
//RS     );
//RS     // D-MEM1 S6: `Shared<T>` lowers to `jet_std::JetShared<T>` now, not a bare
//RS     // `Arc<T>` — the auto-clone is a plain `.clone()` call (its own cheap-handle
//RS     // `Clone` impl), not `Arc::clone(&…)`.
//RS     assert!(out.rust.contains(").clone()"));
//RS }
//RS 
//RS /// D-CONSTMARK1=A (syntax-decisions.md:1756): `NAME :: value` is the marked
//RS /// compile-time binding, and `#Static @` emits a Rust `static` so the value
//RS /// gets one stable address. Ordinary `name :: value` and `name := value`
//RS /// are module globals; only the mutable form is writable.
//RS ///
//RS /// The symbol name is fixed by the naming law, not by choice: `mangle` rewrites
//RS /// the `@` mark to `ct_` and prefixes the one machine prefix `__jet_`
//RS /// (crates/jet-foundation/src/Names.rs:565-571, D-NAME-SIGIL1 at
//RS /// crates/jet-foundation/src/Syntax/predicates.rs:367), then `emit_const`
//RS /// uppercases it (crates/jet-codegen/src/Codegen/Items.rs:2864). So `@limit`
//RS /// can only ever become `__JET_CT_LIMIT`.
//RS #[test]
//RS fn const_address_taken_emits_static() {
//RS     let src = r#"
//RS #Static LIMIT :: prep { 10 }
//RS 
//RS fn show(n: Int) {
//RS     print(n)
//RS }
//RS 
//RS fn run() {
//RS     show(LIMIT)
//RS }
//RS "#;
//RS     let out = jet::compile(src).expect("should compile");
//RS     assert!(
//RS         out.rust.contains("static __JET_CT_LIMIT"),
//RS         "`#Static` should give the constant its own address: {}",
//RS         out.rust
//RS     );
//RS     // The other half of the same law: without `#Static` the constant is
//RS     // address-free — it folds into its use sites and emits no top-level item
//RS     // (crates/jet-codegen/src/Codegen/Items.rs:2829). Without this the
//RS     // assertion above would also pass on a build that emitted a symbol for
//RS     // every constant, which is the opposite of what the marker is for.
//RS     let inlined = jet::compile(&src.replace("#Static ", "")).expect("should compile");
//RS     assert!(
//RS         !inlined.rust.contains("__JET_CT_LIMIT"),
//RS         "an unmarked constant should inline, not take an address: {}",
//RS         inlined.rust
//RS     );
//RS }
