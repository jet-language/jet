fn write_agent_workload_package(scratch: &OSPath) -> {
    fs.write(scratch.join("package.jet"), "name: \"agent-workload\"\nversion: \"0.1.0\"\nedition: \"2026\"\nauthority: { holds: { allow: [Browser, DB, Env, Exec, FS, IO, Mem.Alloc, Net, Time] } }\n").unwrap()
}
// Rust: tests/agent_workloads.rs:898
fn adapter_command(adapter: &String, source: &OSPath, jet_cli: &OSPath, input: &OSPath, scratch: &OSPath, task_id: &String) -> Command {
    if adapter != "jet" {
        package :: scratch.join("package.jet")
        // GATE #4409: retain NotFound-only tolerance.
        fs.remove_file(&package).unwrap_or_else((error) -> {
            if error.kind() != ErrorKind.NotFound { panic("remove fixture package `{package.display()}`: {error}") }
        })
    }
    command := if adapter == {
        "jet" -> {
            write_agent_workload_package(scratch)
            local_source :: scratch.join(source.file_name().unwrap())
            _ :: fs.copy(source, &local_source).unwrap()
            cmd := Command.new(jet_cli)
            cmd.args(["run", "--release"]).arg(local_source).arg("--").env("JET_RECEIPT_BYPASS", "1")
            cmd
        }
        "bash" -> { cmd := Command.new("bash"); cmd.arg(source); cmd }
        "python" -> { cmd := Command.new("python3"); cmd.arg(source); cmd }
        "node" -> { cmd := Command.new("node"); cmd.arg(source); cmd }
        other -> panic("unknown adapter {other}")
    }
    command.arg(input).env("JET_CORPUS_JET", jet_cli).env("JET_CORPUS_JETPACK", common.jetpack_bin()).env("JET_CORPUS_TASK", task_id).current_dir(scratch)
    command
}
// Rust: tests/agent_workloads.rs:952
fn jet_tier_command(jet_cli: &OSPath, source: &OSPath, input: &OSPath, scratch: &OSPath, task_id: &String, tier_args: &[String]) -> Command {
    command := Command.new(jet_cli)
    command.args(["run"]).args(tier_args).arg(source).arg("--").env("JET_RECEIPT_BYPASS", "1")
    command.arg(input).env("JET_CORPUS_JET", jet_cli).env("JET_CORPUS_JETPACK", common.jetpack_bin()).env("JET_CORPUS_TASK", task_id).current_dir(scratch)
    command
}
// Rust: tests/agent_workloads.rs:976
fn tree_hashes(root: &OSPath) -> [String:String] {
    // Rust: tests/agent_workloads.rs:977
    fn walk(root: &OSPath, dir: &OSPath, out: &[String:String]) -> {
        for entry in fs.read_dir(dir).unwrap() {
            path :: entry.unwrap().path()
            if path.is_dir() { walk(root, &path, out) }
            else {
                relative :: path.strip_prefix(root).unwrap().to_string_lossy().replace('\\', "/")
                out.insert(relative, SHA256.sha256_hex(&fs.read(path).unwrap()))
            }
        }
    }
    out := [String:String]{}
    walk(root, root, &out)
    out
}
// Rust: tests/agent_workloads.rs:997
fn input_hashes(input: &OSPath) -> [String:String] {
    if input.is_dir() { return tree_hashes(input) }
    [input.file_name().unwrap().to_string_lossy().to_string(): SHA256.sha256_hex(&fs.read(input).unwrap())]
}
// Rust: tests/agent_workloads.rs:1007
fn input_digest(input: &OSPath) -> String {
    canonical := String.new()
    hashes :: input_hashes(input)
    paths := hashes.keys().collect()
    paths.sort()
    for path in paths { canonical.push_str(&path); canonical.push('\t'); canonical.push_str(&hashes[path]); canonical.push('\n') }
    SHA256.sha256_hex(canonical.as_bytes())
}
