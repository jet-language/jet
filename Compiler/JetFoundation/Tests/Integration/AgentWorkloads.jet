fn corpus_root() -> OSPath { OSPath(common.manifest_dir()).join("tests/agent_workloads") }
// Rust: tests/agent_workloads.rs:486
fn compiled_workload_root() -> OSPath { OSPath(common.manifest_dir()).join("tests/compiled_workloads") }
// Rust: tests/agent_workloads.rs:490
fn read_compiled_workload_tsv(relative: &String, header: &String, width: USize) -> [[String]] {
    text :: fs.read_to_string(compiled_workload_root().join(relative)).unwrap()
    lines := text.lines()
    assert_eq(lines.next(), Val(header), "compiled workload schema drifted")
    lines.filter((line) -> !line.is_empty()).map((line) -> {
        fields :: line.split('\t').map((field) -> field.to_string()).collect()
        assert_eq(fields.len(), width, "bad compiled workload row: {line}")
        fields
    }).collect()
}
// Rust: tests/agent_workloads.rs:504
fn policy_field(name: &String) -> String {
    POLICY_CONTRACT.lines().find_map((line) -> line.strip_prefix(name).and_then((value) -> value.strip_prefix('=')))
        .unwrap_or_else(() -> panic("policy contract lacks field {name}")).to_string()
}
// Rust: tests/agent_workloads.rs:514
fn policy_digest() -> String {
    for field in POLICY_FIELDS { _ :: policy_field(field) }
    text := POLICY_CONTRACT.trim_end_matches('\n') // #4303
    SHA256.sha256_hex(text.as_bytes())
}
// Rust: tests/agent_workloads.rs:521
fn policy_receipt(digest: &String) -> String {
    "policy\tversion={policy_field("version")}\tdigest={digest}\tplan={policy_field("plan")}\tlaunch_transaction={policy_field("launch_transaction")}\tdescendants={policy_field("descendants")}\tlimits={policy_field("limits")}\toutputs={policy_field("outputs")}\treceipt={policy_field("receipt")}\tauthority={policy_field("authority")}" 
}
// Rust: tests/agent_workloads.rs:535
fn validate_corpus_relative_path(relative: &String) -> () Err! {
    if relative.is_empty() || OSPath(relative).is_absolute() || relative.contains(':') ||
        relative.split((character) -> character == '/' || character == '\\').any((part) -> part.is_empty() || part == "." || part == "..") {
        throw "invalid corpus fixture path: {relative}"
    }
}
// Rust: tests/agent_workloads.rs:548
fn validate_authority(authority: &String) -> () Err! {
    if authority != policy_field("authority") { throw "unsupported authority enforcement: {authority}" }
}
// Rust: tests/agent_workloads.rs:556
fn adapter_stem(task_id: &String) -> String {
    if task_id == "repository-marker-scan" || task_id == "repository-marker-scan-empty" { "repository_marker_scan" }
    else if task_id == "repository-semantic-inspection" { "repository_semantic_inspection" }
    else if task_id == "repository-semantic-edit" { "repository_semantic_edit" }
    else if task_id == "git-diff-review" || task_id == "git-diff-empty" { "git_diff_review" }
    else if task_id == "build-test-failure-recovery" { "build_test_recovery" }
    else if task_id.starts_with("incident-report-") { "incident_report" }
    else if task_id.starts_with("structured-data-") { "structured_data" }
    else if task_id.starts_with("database-") { "database_access" }
    else if task_id.starts_with("http-") { "http_api" }
    else if task_id.starts_with("process-batch-") { "process_batch" }
    else if task_id.starts_with("mcp-environment-") { "mcp_resource" }
    else if task_id.starts_with("interactive-terminal-") { "interactive_terminal" }
    else if task_id.starts_with("service-lifecycle-") { "service_lifecycle" }
    else if task_id == "browser-automation-preflight" { "browser_automation_preflight" }
    else if task_id == "desktop-interaction-focus" { "desktop_interaction_focus" }
    else if task_id == "document-markdown-inspection" { "document_markdown_inspection" }
    else if task_id == "media-asset-inventory" { "media_asset_inventory" }
    else { panic("task has no adapter source: {task_id}") }
}
// Rust: tests/agent_workloads.rs:596
fn read_domain_contract() -> [DomainContract] {
    contract :: fs.read_to_string(corpus_root().join("domain_contract.tsv")).unwrap()
    lines := contract.lines()
    assert_eq(lines.next(), Val(DOMAIN_CONTRACT_HEADER), "agent workload domain contract schema drifted")
    lines.filter((line) -> !line.is_empty()).map((line) -> {
        fields :: line.split('\t').collect()
        assert_eq(fields.len(), 6, "bad domain contract row: {line}")
        assert_eq(fields[0], "1", "unsupported domain contract version: {line}")
        assert_eq(fields[5], DOMAIN_SCORING, "domain scoring drifted: {line}")
        DomainContract { task_id: fields[1].to_string(), allowed_dependencies: fields[2].to_string(), machine_spec: fields[3].to_string(), variant: fields[4].to_string(), scoring: fields[5].to_string() }
    }).collect()
}
// Rust: tests/agent_workloads.rs:625
fn read_tasks() -> [Task] {
    manifest :: fs.read_to_string(corpus_root().join("manifest.tsv")).unwrap()
    lines := manifest.lines()
    assert_eq(lines.next(), Val(HEADER), "agent workload manifest schema drifted")
    lines.filter((line) -> !line.is_empty()).map((line) -> {
        fields :: line.split('\t').collect()
        assert_eq(fields.len(), 13, "bad agent workload manifest row: {line}")
        assert_eq(fields[0], "1", "unsupported corpus version in: {line}")
        validate_corpus_relative_path(fields[5]).unwrap_or_else((error) -> panic("{error}"))
        validate_corpus_relative_path(fields[6]).unwrap_or_else((error) -> panic("{error}"))
        Task { id: fields[1].to_string(), domain: fields[2].to_string(), case: fields[3].to_string(), outcome: fields[4].to_string(), input: fields[5].to_string(), expected: fields[6].to_string(), authority: fields[7].to_string(), adapters: fields[8].to_string(), platforms: fields[9].to_string(), evidence: fields[10].to_string(), tower_card: fields[11].to_string(), loss_cards: fields[12].to_string() }
    }).collect()
}
// Rust: tests/agent_workloads.rs:659
fn read_native_os_matrix() -> [(String, String, String, String, String)] {
    matrix :: fs.read_to_string(corpus_root().join("native_os_matrix.tsv")).unwrap()
    lines := matrix.lines()
