        assert_eq(fields[0], "1", "unsupported native OS matrix version: {line}")
        (fields[1].to_string(), fields[2].to_string(), fields[3].to_string(), fields[4].to_string(), fields[5].to_string())
    }).collect()
}
// Rust: tests/agent_workloads.rs:687
fn read_jet_baseline() -> [(String, String, String)] {
    baseline :: fs.read_to_string(corpus_root().join("jet_baseline.tsv")).unwrap()
    lines := baseline.lines()
    assert_eq(lines.next(), Val(JET_BASELINE_HEADER), "Jet baseline schema drifted")
    lines.filter((line) -> !line.is_empty()).map((line) -> {
