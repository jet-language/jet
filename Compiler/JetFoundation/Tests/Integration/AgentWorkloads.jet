// Rust: tests/agent_workloads.rs:706
fn pinned_adapter_versions() -> [String:String] {
    receipt :: fs.read_to_string(corpus_root().join("baselines/receipt.tsv")).unwrap()
    lines := receipt.lines()
    assert_eq(lines.next(), Val(BASELINE_HEADER), "baseline schema drifted while reading tool pins")
    versions := [String:String]{}
    for line in lines.filter((line) -> !line.is_empty()) {
        fields :: line.split('\t').collect()
        assert_eq(fields.len(), 23, "bad baseline receipt row: {line}")
        adapter :: if fields[3] == {
            "bash" -> "bash"
            "python" -> "python"
            "node" -> "node"
            other -> panic("unknown pinned adapter: {other}")
        }
        version :: fields[21]
        assert(!version.is_empty() && version != "unknown")
        if versions.insert(adapter, version.to_string()) == Val(previous) {
            assert_eq(previous, version, "pinned tool version drifted for {adapter}")
        }
    }
    adapters := versions.keys().collect()
    adapters.sort()
    expected := BASELINE_ADAPTERS.to_vec()
    expected.sort()
    assert_eq(adapters, expected, "baseline must pin every competitor adapter exactly once")
    versions
}
// Rust: tests/agent_workloads.rs:741
// GATE #4494: process launch, retained output files, threads and clock.
fn run_bounded(command: Command, label: &String, deadline: Duration) -> BoundedOutput {
    command := ^command
    // Serial launches retain a cache lease until descendant cleanup has finished.
    _jet_guard :: jet_workload_guard(&command)
    capture :: Scratch.new("jet_agent_process_output")
    defer capture.drop()
    stdout_path :: capture.path.join("stdout")
    stderr_path :: capture.path.join("stderr")
    command.stdout(Stdio.from(fs.File.create(&stdout_path).unwrap())).stderr(Stdio.from(fs.File.create(&stderr_path).unwrap()))
    // GATE #4483: selected-target family, not host cfg.
    if target.selected_family() == "unix" { command.process_group(0) }
    started :: Instant.now()
    child := command.spawn().unwrap_or_else((err) -> panic("cannot start `{label}`: {err}"))
    child_pid :: child.id()
    (status, timed_out, limit_exceeded) :: loop {
        if child.try_wait().unwrap() == Val(status) {
            group_result :: if target.selected_family() == "unix" { kill_process_group(child_pid) } else { Ok(()) }
            status :: child.wait().unwrap_or(status)
            group_result.unwrap_or_else((error) -> panic("process-group cleanup failed for `{label}`: {error}"))
            break (status, false, output_size(&stdout_path, &stderr_path) > PROCESS_OUTPUT_LIMIT_BYTES)
        }
        if output_size(&stdout_path, &stderr_path) > PROCESS_OUTPUT_LIMIT_BYTES {
            group_result :: if target.selected_family() == "unix" { kill_process_group(child.id()) } else { Ok(()) }
            _ :: child.kill()
            status :: child.wait().unwrap()
            group_result.unwrap_or_else((error) -> panic("process-group cleanup failed for `{label}`: {error}"))
            break (status, false, true)
        }
        if started.elapsed() >= deadline {
            group_result :: if target.selected_family() == "unix" { kill_process_group(child.id()) } else { Ok(()) }
            _ :: child.kill()
            status :: child.wait().unwrap()
            group_result.unwrap_or_else((error) -> panic("process-group cleanup failed for `{label}`: {error}"))
            break (status, true, false)
        }
        thread.sleep(Duration.from_millis(5))
    }
    BoundedOutput { output: Output { status, stdout: fs.read(stdout_path).unwrap(), stderr: fs.read(stderr_path).unwrap() }, elapsed: started.elapsed(), timed_out, limit_exceeded }
}
// Rust: tests/agent_workloads.rs:821
fn output_size(stdout: &OSPath, stderr: &OSPath) -> U64 {
    fs.metadata(stdout).map((file) -> file.len()).unwrap_or(0) + fs.metadata(stderr).map((file) -> file.len()).unwrap_or(0)
