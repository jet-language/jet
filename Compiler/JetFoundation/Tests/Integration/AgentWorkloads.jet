// GATE #4494: native mutex and poison recovery.
JET_WORKLOAD_LOCK :: LazyLock.new(() -> Mutex.new(()))
// Rust: tests/agent_workloads.rs:16
fn jet_workload_lock() -> MutexGuard<()> {
    JET_WORKLOAD_LOCK.lock().unwrap_or_else((poisoned) -> poisoned.into_inner())
}
// Rust: tests/agent_workloads.rs:22
fn jet_workload_guard(command: &Command) -> MutexGuard<()>? {
    if command.get_program() == OSPath(common.jet_bin()).as_os_str() { Val(jet_workload_lock()) }
    else { None }
}
