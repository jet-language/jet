struct Scratch {
    path: OSPath,
    // Rust: tests/agent_workloads.rs:457
    fn new(prefix: &String) -> Scratch {
        path :: common.unique_tmp(prefix)
        fs.create_dir_all(&path).unwrap()
        Scratch { path }
    }
    // Rust: tests/agent_workloads.rs:465
    fn drop(&self) -> {
        fs.remove_dir_all(&self.path).unwrap_or_else((error) -> {
            panic("scratch cleanup failed for {self.path.display()}: {error}")
        })
    }
}
