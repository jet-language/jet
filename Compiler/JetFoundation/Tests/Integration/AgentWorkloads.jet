// Rust: tests/agent_workloads.rs:827
fn kill_process_group(pid: U32) -> () Err! {
    pid :: I32.try_from(pid).unwrap_or_else(() -> { throw "child PID does not fit platform process ID" })
    // GATE #4494: Core native kill binding and errno; GATE #4409: NotFound fidelity.
    // Rust: tests/agent_workloads.rs:829
    #Unsafe("Negative PID targets only the bounded child's own group; SIGKILL fails closed")
    result :: core.sys.posix.kill(-pid, 9)
    if result != 0 {
        error :: Error.last_os_error()
        if error.kind() != ErrorKind.NotFound && error.raw_os_error() != Val(3) {
            throw "kill(-{pid}, SIGKILL): {error}"
        }
    }
}
// Rust: tests/agent_workloads.rs:851
fn stderr_receipt(output: &Output) -> String {
