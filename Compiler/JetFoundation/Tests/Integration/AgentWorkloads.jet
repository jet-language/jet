}
// Rust: tests/agent_workloads.rs:860
// Linux-only caller dispatch uses target.selected_os(); GATE #4483.
fn process_is_gone_or_zombie(pid: U32) -> Bool {
    path :: OSPath("/proc/{pid}/stat")
    stat :: fs.read_to_string(path).unwrap_or_else((_) -> { return true })
    stat.rsplit_once(") ").and_then(((_, fields)) -> fields.split_whitespace().next()) == Val("Z")
}
// Rust: tests/agent_workloads.rs:870
fn command_version(program: &OSPath, arg: &String, label: &String) -> String {
    command := Command.new(program)
    command.arg(arg)
    bounded :: run_bounded(^command, label, PROCESS_DEADLINE)
    assert(!bounded.timed_out, "`{label}` version timed out")
    assert(!bounded.limit_exceeded, "`{label}` output limit exceeded")
    assert(bounded.output.status.success(), "`{label} {arg}` failed")
    text :: if bounded.output.stdout.is_empty() { &bounded.output.stderr } else { &bounded.output.stdout }
    first := String.from_utf8_lossy(text).lines().next().unwrap_or("unknown").trim() // #4303
    first.to_string()
}
