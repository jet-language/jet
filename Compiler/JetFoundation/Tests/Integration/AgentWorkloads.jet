struct BaselineCapture {
    root: OSPath, run_id: String, machine: String, receipt: fs.File,
    // Rust: tests/agent_workloads.rs:1026
    fn from_env() -> BaselineCapture? {
        root :: OSPath(std.env.var_os("JET_CORPUS_BASELINE_DIR")?)
        run_id :: std.env.var("JET_CORPUS_BASELINE_RUN_ID").expect("JET_CORPUS_BASELINE_RUN_ID is required when capturing baselines")
        machine :: std.env.var("JET_CORPUS_BASELINE_MACHINE").expect("JET_CORPUS_BASELINE_MACHINE is required when capturing baselines")
        fs.create_dir_all(root.join("outputs")).unwrap()
        receipt := fs.File.create(root.join("receipt.tsv")).unwrap()
        receipt.write_all("{BASELINE_HEADER}\n".as_bytes()).unwrap()
        Val(BaselineCapture { root, run_id, machine, receipt })
    }
    // Rust: tests/agent_workloads.rs:1043
    fn record(&self, task: &Task, adapter: &String, source: &OSPath, input: &OSPath, expected: &[U8], cold: &BoundedOutput, warm: &BoundedOutput, version: &String) -> {
        output_dir :: self.root.join("outputs").join(adapter)
        fs.create_dir_all(&output_dir).unwrap()
        stdout_file :: "outputs/{adapter}/{task.id}.stdout"
        stderr_file :: "outputs/{adapter}/{task.id}.stderr"
        fs.write(self.root.join(&stdout_file), &cold.output.stdout).unwrap()
        fs.write(self.root.join(&stderr_file), &cold.output.stderr).unwrap()
        output_stable :: cold.output.stdout == warm.output.stdout
        supported :: cold.output.status.code() == Val(0) && warm.output.status.code() == Val(0) && cold.output.stdout == expected && warm.output.stdout == expected && output_stable
        expressibility :: if supported { "supported" } else { "unsupported" }
        finding :: if supported { "none" } else { "cold_exit={cold.output.status.code():?};warm_exit={warm.output.status.code():?};stdout_expected={cold.output.stdout == expected && warm.output.stdout == expected};warm_stable={output_stable}" }
        row :: ["1", self.run_id, self.machine, adapter.to_string(), task.id, expressibility, finding, input_digest(input), SHA256.sha256_hex(expected), cold.output.status.code().unwrap_or(-1).to_string(), source_tokens(source).to_string(), stdout_file, SHA256.sha256_hex(&cold.output.stdout), stderr_file, SHA256.sha256_hex(&cold.output.stderr), cold.elapsed.as_nanos().to_string(), warm.elapsed.as_nanos().to_string(), SHA256.sha256_hex(&warm.output.stdout), SHA256.sha256_hex(&warm.output.stderr), output_stable.to_string(), DOMAIN_SCORING, version.replace('\t', " "), policy_digest()].join("\t")
        self.receipt.write_all("{row}\n".as_bytes()).unwrap()
    }
}
// Rust: tests/agent_workloads.rs:1112
fn fixture_files(root: &OSPath) -> Set<String> {
    // Rust: tests/agent_workloads.rs:1113
    fn walk(corpus: &OSPath, dir: &OSPath, out: &Set<String>) -> {
        for entry in fs.read_dir(dir).unwrap() {
            path :: entry.unwrap().path()
            if path.is_dir() { walk(corpus, &path, out) }
            else { out.insert(path.strip_prefix(corpus).unwrap().to_string_lossy().replace('\\', "/")) }
        }
    }
    files := Set<String>.new()
    for name in ["inputs", "expected"] {
        dir :: root.join(name)
        if dir.is_dir() { walk(root, &dir, &files) }
    }
    files
}
// Rust: tests/agent_workloads.rs:1138
fn verify_checksum_closure(root: &OSPath, sums: &String) -> USize Err! {
    declared := [String:String]{}
    for line in sums.lines().filter((line) -> !line.is_empty()) {
        (hash, relative) :: line.split_once("  ").unwrap_or_else(() -> { throw "bad SHA256SUMS row: {line}" })
        if validate_corpus_relative_path(relative).is_err() { throw "invalid checksum path: {relative}" }
        if declared.insert(relative.to_string(), hash.to_string()).is_some() { throw "duplicate checksum path: {relative}" }
    }
    actual :: fixture_files(root)
    listed :: declared.keys().collect::<Set<String>>()
    if actual != listed {
        unhashed := actual.difference(&listed).collect()
        missing := listed.difference(&actual).collect()
        unhashed.sort(); missing.sort()
        throw "checksum closure mismatch; unhashed={unhashed:?}; missing={missing:?}"
    }
    paths := declared.keys().collect(); paths.sort()
    for relative in paths {
        bytes :: fs.read(root.join(relative)).map_err((err) -> err.to_string())?
        actual_hash :: SHA256.sha256_hex(&bytes)
        if actual_hash != declared[relative] { throw "fixture drift: {relative}" }
    }
    declared.len()
}
// Rust: tests/agent_workloads.rs:1173
fn source_tokens(path: &OSPath) -> USize { fs.read_to_string(path).unwrap().split_whitespace().count() }
// Rust: tests/agent_workloads.rs:1177
fn scratch_output_violations(adapter: &String, path: &OSPath, jet_artifact_name: &String) -> [String] {
    // Rust: tests/agent_workloads.rs:1178
    fn walk(root: &OSPath, dir: &OSPath, entries: &[String:String]) -> {
        for entry in fs.read_dir(dir).unwrap() {
            path :: entry.unwrap().path()
            relative :: path.strip_prefix(root).unwrap().to_string_lossy().replace('\\', "/")
            file_type :: fs.symlink_metadata(&path).unwrap().file_type()
            kind :: if file_type.is_dir() { "directory" } else if file_type.is_file() { "file" } else if file_type.is_symlink() { "symlink" } else { "other" }
            entries.insert(relative, kind)
            if file_type.is_dir() { walk(root, &path, entries) }
        }
    }
    actual := [String:String]{}
    walk(path, path, &actual)
    (required, optional) :: if adapter == "jet" {
        ([".jet": "directory", ".jet/build": "directory", ".jet/build/{jet_artifact_name}": "file"], [".jet/build/{jet_artifact_name}.rs": "file"])
    } else { ([String:String]{}, [String:String]{}) }
    violations := [String]{}
    for (entry, kind) in actual {
        if required.get(entry) != Val(kind) && optional.get(entry) != Val(kind) { violations.push("unexpected {kind}: {entry}") }
    }
    for (entry, kind) in required {
        if actual.get(entry) != Val(kind) { violations.push("missing {kind}: {entry}") }
    }
    violations.sort()
    violations
}
// Rust: tests/agent_workloads.rs:1234
fn baseline_artifact_path(root: &OSPath, relative: &String) -> OSPath Err! {
    path :: OSPath(relative)
    if path.is_absolute() { throw "baseline artifact escaped root: {relative}" }
    if validate_corpus_relative_path(relative).is_err() { throw "invalid baseline artifact path: {relative}" }
    root.join(path)
}
