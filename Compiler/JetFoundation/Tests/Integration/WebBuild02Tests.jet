}
// Rust: tests/web_build.rs:2233
#Test("web_js_runtime_stop_uses_shared_report") {
    if !have_tool("node") { eprintln("note: skipping JS runtime-stop test (need node)"); return }
    src :: "#Target(JS)\nfn run() -> {{\n    n := 1\n    xs := [n]\n    print(xs[9])\n}}\n"
    dir :: build_web_fixture("js_runtime_stop", src, "tests/fixtures/web_js_runtime_stop.jet")
    node :: Command.new("node").current_dir(dir.join("build")).arg("app.js").output().unwrap()
    assert(!node.status.success(), "a reached stop must fail the JS process")
    stderr :: String.from_utf8_lossy(&node.stderr)
    assert(stderr.contains("Stop [E3010]: `the list has 1 items, so position 9 doesn't exist`"), "missing shared stop text:\n{stderr}")
    assert(stderr.contains("--> tests/fixtures/web_js_runtime_stop.jet:5"), "missing Jet source location:\n{stderr}")
    assert(stderr.contains("Why: the operands or position do not produce a valid result, so the safe runtime stops instead of returning corrupted data.") && stderr.contains("Fix: check the operands or bounds before the operation, or use a checked operation that returns an outcome."), "missing shared why/fix:\n{stderr}")
    assert(!stderr.contains("thread 'main' panicked"), "raw host panic leaked:\n{stderr}")
    _ :: fs.remove_dir_all(&dir).ok()
}
// Rust: tests/web_build.rs:2281
#Test("web_js_unknown_runtime_stop_preserves_host_status_101") {
    if !have_tool("node") { eprintln("note: skipping JS unknown runtime-stop test (need node)"); return }
    dir :: build_web_fixture("js_unknown_runtime_stop", "#Target(JS)\nfn run() -> {{}}\n", "tests/fixtures/web_unknown_runtime_stop.jet")
    app_path :: dir.join("build/app.js")
    app := fs.read_to_string(&app_path).unwrap()
    app.push_str("\nexport {{ jet_runtime_stop }};\n")
    fs.write(app_path, app).unwrap()
    harness :: """
const {{ jet_runtime_stop }} = await import("./app.js");
for (const code of ["E9999", "E1001"]) {{
  try {{
    jet_runtime_stop(code, "tests/fixtures/web_unknown_runtime_stop.jet", 9, "host defect", "run", "fn run() {{}}", 1, 1, "");
    throw new Error("unexpected success");
  }} catch (error) {{
    if (error?.name !== "JetHostError") throw error;
    if (error.status !== 101 || error.exitCode !== 101) throw error;
    if (error.code !== code) throw error;
    console.log(`${{code}}:status=${{error.status}}:name=${{error.name}}`);
  }}
}}
"""
    stdout :: run_node_harness(&dir, "js_unknown_runtime_stop_harness.mjs", harness)
    assert(stdout.contains("E9999:status=101:name=JetHostError"), stdout)
    assert(stdout.contains("E1001:status=101:name=JetHostError"), stdout)
    _ :: fs.remove_dir_all(&dir).ok()
}
// Rust: tests/web_build.rs:2323
#Test("web_e3001_context_matches_on_js_and_wasm") {
    if !have_tool("node") { eprintln("note: skipping web E3001 context test (need node)"); return }
    harness :: """
process.on("unhandledRejection", (error) => {{ if (error?.name !== "JetError") throw error; }});
const {{ jet_main }} = await import("./app.js");
try {{ await jet_main(); throw new Error("unexpected success"); }}
catch (error) {{ if (error?.name !== "JetError") throw error; console.log(error.frame); }}
"""
    loop (stem, target, shown) in [("e3001_js_context", "JS", "tests/fixtures/web_e3001_js_context.jet"), ("e3001_wasm_context", "Wasm", "tests/fixtures/web_e3001_wasm_context.jet")] {
        source :: "#Target({target})\nfn missing() -> Int? {{\n    return None\n}}\n\nfn run() -> {{\n    print(missing() ?? panic(\"missing value\"))\n}}\n"
        dir :: build_web_fixture(stem, source, shown)
        stdout :: run_node_harness(&dir, "e3001_context_harness.mjs", harness)
        assert(stdout.contains("Stop [E3001]: `panic: missing value`"), "{stem} lost E3001 report:\n{stdout}")
        assert(stdout.contains("--> {shown}:7 in run"), "{stem} lost function context:\n{stdout}")
        assert(stdout.contains("7 |     print(missing() ?? panic(\"missing value\"))"), "{stem} lost source-line context:\n{stdout}")
        assert(stdout.contains("Why: the program hit a `panic`") && stdout.contains("Fix: fix the logic that led to the failure"), "{stem} lost canonical E3001 policy:\n{stdout}")
        _ :: fs.remove_dir_all(&dir).ok()
    }
}
