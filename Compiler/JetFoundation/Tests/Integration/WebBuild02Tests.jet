// Rust: tests/web_build.rs:1740
#Test("web_loops_and_index_assign_emit_on_js_and_wasm") {
    src :: """
#Target(Web)
#Target(JS)
fn sum_to(n: Int) -[]> Int {{
    total := 0
    i := 0
    loop {{
        if i >= n {{ break }}
        total = total + i
        i = i + 1
    }}
    return total
}}
#Target(JS)
fn sum_while(n: Int) -[]> Int {{
    total := 0
    i := 0
    loop i < n {{
        i += 1
        if i == 2 {{ next }}
        total += i
    }}
    return total
}}
#Target(JS)
fn sum_counted(n: Int) -[]> Int {{
    total := 0
    loop i in 0..<n {{ total += i }}
    return total
}}
#Target(JS)
fn bump(n: Int) -[]> Int {{
    xs := [n]
    xs[0] = 9
    return xs[0]
}}
#WasmExport
fn wasm_sum_to(n: Int) -[]> Int {{
    total := 0
    i := 0
    loop {{
        if i >= n {{ break }}
        total = total + i
        i = i + 1
    }}
    return total
}}
#WasmExport
fn wasm_sum_while(n: Int) -[]> Int {{
    total := 0
    i := 0
    loop i < n {{
        i += 1
        if i == 2 {{ next }}
        total += i
    }}
    return total
}}
#WasmExport
fn wasm_sum_counted(n: Int) -[]> Int {{
    total := 0
    loop i in 0..<n {{ total += i }}
    return total
}}
#WasmExport
fn wasm_bump(n: Int) -[]> Int {{
    xs := [n]
    xs[0] = 9
    return xs[0]
}}
#Target(JS)
fn run() -> {{
    print(sum_to(4)); print(sum_while(4)); print(sum_counted(4)); print(bump(1))
    print(wasm_sum_to(4)); print(wasm_sum_while(4)); print(wasm_sum_counted(4)); print(wasm_bump(1))
}}
"""
    out :: compile_web_with_path(src, "tests/fixtures/web_loops_index.jet").expect("loops + index assign must compile on web")
    web :: out.web.expect("web artifacts")
    assert(web.js_app.contains("while (true)"), "JS Loop must emit while(true):\n{web.js_app}")
    assert(web.js_app.contains("break;"), "JS Break must emit break:\n{web.js_app}")
    assert(web.js_app.contains("while ((i < n))") && web.js_app.contains("continue;") && web.js_app.contains("__jet___loop_first"), "JS While/Continue/CountedLoop forms were not all emitted:\n{web.js_app}")
    assert(web.js_app.contains("] = ") || web.js_app.contains("[0] ="), "JS IndexAssign must emit array write:\n{web.js_app}")
    // Retired Wasm-Rust shape assertions become execution over every loop form.
    dir :: build_web_fixture("loops_index", src, "tests/fixtures/web_loops_index.jet")
    assert_eq(run_web_app(&dir), "6\n8\n6\n9\n6\n8\n6\n9\n")
    _ :: fs.remove_dir_all(&dir).ok()
}
// Rust: tests/web_build.rs:1863
#Test("web_fallible_match_and_option_if_emit_on_js_and_wasm") {
    src :: """
#Target(Web)
enum Toggle {{ On Off }}
#Target(JS)
fn make_result(flag: Bool) -> Int Err! {{
    if flag -> return Ok(7)
    return Err("x")
}}
#Target(JS)
fn make_opt(flag: Bool) -> Int? {{
    if flag -> return .Val(3)
    return .None
}}
#Target(JS)
fn classify(flag: Bool) -> Int {{
    if make_result(flag) == {{ .Ok(n) -> return n .Err(_) -> return -1 }}
}}
#Target(JS)
fn maybe(flag: Bool) -> Int {{
    x :: make_opt(flag)
    if x == .None {{ return 0 }}
    if x == .Val(n) {{ return n }}
    return -1
}}
#Target(JS)
fn js_make_toggle(flag: Bool) -> Toggle {{ if flag {{ return .On }}; return .Off }}
#Target(JS)
fn js_matches_and(flag: Bool) -> Int {{
    x :: make_opt(flag)
    toggle :: js_make_toggle(flag)
    if x == .Val(n) && toggle == .On && flag {{ return n }}
    return 0
}}
#Target(Wasm)
fn wasm_make_result(flag: Bool) -> Int Err! {{ if flag -> return Ok(7); return Err("x") }}
#Target(Wasm)
fn wasm_make_opt(flag: Bool) -> Int? {{ if flag -> return .Val(3); return .None }}
#WasmExport
fn wasm_classify(flag: Bool) -> Int {{
    if wasm_make_result(flag) == {{ .Ok(n) -> return n .Err(_) -> return -1 }}
}}
#WasmExport
fn wasm_maybe(flag: Bool) -> Int {{
    x :: wasm_make_opt(flag)
    if x == .None {{ return 0 }}
    if x == .Val(n) {{ return n }}
    return -1
}}
#Target(Wasm)
fn wasm_make_toggle(flag: Bool) -> Toggle {{ if flag {{ return .On }}; return .Off }}
#WasmExport
fn wasm_matches_and(flag: Bool) -> Int {{
    x :: wasm_make_opt(flag)
    toggle :: wasm_make_toggle(flag)
    if x == .Val(n) && toggle == .On && flag {{ return n }}
    return 0
}}
#Target(JS)
fn run() -> {{
    print(classify(true)); print(classify(false)); print(maybe(true)); print(maybe(false)); print(js_matches_and(true)); print(js_matches_and(false))
    print(wasm_classify(true)); print(wasm_classify(false)); print(wasm_maybe(true)); print(wasm_maybe(false)); print(wasm_matches_and(true)); print(wasm_matches_and(false))
}}
"""
    out :: compile_web_with_path(src, "tests/fixtures/web_fallible_match.jet").expect("Result/Option match must compile on web")
    web :: out.web.expect("web artifacts")
    assert(web.js_app.contains("tag === \"Ok\"") && web.js_app.contains("tag === \"Err\""), "JS EnumMatch must emit Ok and Err branches:\n{web.js_app}")
    assert(web.js_app.contains("tag: \"None\"") || web.js_app.contains("\"None\""), "JS must emit None tag:\n{web.js_app}")
    assert(web.js_app.contains("tag === \"On\"") && web.js_app.contains("if (flag)"), "JS Matches + And must emit both short-circuit tests:\n{web.js_app}")
    dir :: build_web_fixture("fallible_match", src, "tests/fixtures/web_fallible_match.jet")
    assert_eq(run_web_app(&dir), "7\n-1\n3\n0\n3\n0\n7\n-1\n3\n0\n3\n0\n")
    _ :: fs.remove_dir_all(&dir).ok()
}
