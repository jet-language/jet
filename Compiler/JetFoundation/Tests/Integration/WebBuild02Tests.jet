// Rust: tests/web_build.rs:2533
#Test("web_contracts_execute_with_canonical_e3005_on_js_and_wasm") {
    if !have_tool("node") { eprintln("note: skipping web contract stop test (need node)"); return }
    harness :: """
process.on("unhandledRejection", (error) => {{ if (error?.name !== "JetError") throw error; }});
const {{ jet_main }} = await import("./app.js");
try {{ await jet_main(); throw new Error("unexpected success"); }}
catch (error) {{ if (error?.name !== "JetError") throw error; console.log("code=" + error.code); console.log(error.frame); }}
"""
    loop (stem, target, argument, shown, clause, message, expected_line) in [("contract_js", "JS", 0, "tests/fixtures/web_contract_js.jet", "Pre", "positive", 7), ("contract_wasm", "Wasm", 1, "tests/fixtures/web_contract_wasm.jet", "Post", "grows", 1)] {
        source :: "#[Target({target}), Pre(value > 0, \"positive\"), Post(result > value, \"grows\")]\nfn checked(value: Int) -> Int {{\n    return value\n}}\n\nfn run() -> {{\n    print(checked({argument}))\n}}\n"
        dir :: build_web_fixture(stem, source, shown)
        stdout :: run_node_harness(&dir, "contract_harness.mjs", harness)
        assert(stdout.contains("code=E3005"), "{stem}:\n{stdout}")
        assert(stdout.contains("Stop [E3005]: #{clause} contract failed: {message}"), "{stem} lost the contract frame:\n{stdout}")
        assert(stdout.contains("--> {shown}:{expected_line}"), "{stem} lost the contract source location:\n{stdout}")
        assert(stdout.contains("Why: A `#Pre` (argument claim, checked at entry) or `#Post` (`result` claim, checked before return) condition evaluated false at runtime.") && stdout.contains("Fix: fix the caller (a failed `#Pre` means an argument violated the function's stated contract) or the function body (a failed `#Post` means it broke its own promise about the result)."), "{stem} lost the canonical contract why/fix:\n{stdout}")
        _ :: fs.remove_dir_all(&dir).ok()
    }
}

