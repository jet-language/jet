#Test("web_if_expr_emits_safe_js_and_wasm_value_blocks") {
    if !have_tool("node") { eprintln("note: skipping web IfExpr test"); return }
    src :: """
#Target(Web)
#WasmExport
fn wasm_pick(flag: Bool) -[]> Int {{
    if flag -> {{
        n :: 6
        n + 1
    }} else -> {{ 3 }}
}}
#Target(JS)
fn js_pick(flag: Bool) -[]> Int {{
    if flag -> {{
        n :: 6
        n + 2
    }} else -> {{ 4 }}
}}
#Target(JS)
fn run() -> {{
    print(js_pick(true))
    print(if true -> wasm_pick(true) else -> 0)
}}
"""
    dir :: build_web_fixture("if_expr", src, "tests/fixtures/web_if_expr.jet")
    js :: fs.read_to_string(dir.join("build/app.js")).unwrap()
    assert(js.contains("await (async () =>") && js.contains("let n = 6n;"), "JS IfExpr must retain branch statements and await bridge calls:\n{js}")
    check :: Command.new("node").arg("--check").arg(dir.join("build/app.js")).output().unwrap()
    assert(check.status.success(), "node --check rejected JS:\n{String.from_utf8_lossy(&check.stderr)}")
    // Executing Wasm retains branch statements and values without Rust text.
    assert_eq(run_web_app(&dir), "8\n7\n")
    _ :: fs.remove_dir_all(&dir).ok()
}
// Rust: tests/web_build.rs:3453
#Test("web_backends_traverse_impure_regions") {
    src :: """
#Target(Web)
#Target(JS)
fn js_value() -[]> Int {{
    value := 0
    #Impure("preserve JS body") {{ value = 7 }}
    return value
}}
#WasmExport
fn wasm_value() -[]> Int {{
    value := 0
    #Impure("preserve Wasm body") {{ value = 9 }}
    return value
}}
#Target(JS)
fn run() -> {{ print(js_value()); print(wasm_value()) }}
"""
    out :: compile_web_with_path(src, "tests/fixtures/web_impure_regions.jet").expect("Impure regions should be transparent to web codegen")
    web :: out.web.expect("web artifacts")
    assert(web.js_app.contains("value = 7"), "JS body was dropped:\n{web.js_app}")
    dir :: build_web_fixture("impure_regions", src, "tests/fixtures/web_impure_regions.jet")
    assert_eq(run_web_app(&dir), "7\n9\n", "Wasm body was dropped")
    _ :: fs.remove_dir_all(&dir).ok()
}
// Rust: tests/web_build.rs:3490
#Test("web_inline_modules_keep_qualified_function_identity") {
    if !have_tool("node") { eprintln("note: skipping web module identity test"); return }
    src :: """
#Target(Web)
module left {{
    #Target(JS)
    pub fn value() -> Int {{ return 1 }}
}}
module right {{
    #Target(JS)
    pub fn value() -> Int {{ return 2 }}
}}
#Target(JS)
fn run() -> {{ print(left.value() + right.value()) }}
"""
    dir :: build_web_fixture("module_identity", src, "tests/fixtures/web_module_identity.jet")
    js :: fs.read_to_string(dir.join("build/app.js")).unwrap()
    assert(js.contains("function __jet_left__value()"), "left module identity was dropped:\n{js}")
    assert(js.contains("function __jet_right__value()"), "right module identity was dropped:\n{js}")
    assert_eq(run_web_app(&dir), "3\n")
    _ :: fs.remove_dir_all(&dir).ok()
}
