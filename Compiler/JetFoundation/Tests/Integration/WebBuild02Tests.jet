#Test("web_two_hop_journey_matches_all_execution_tiers") {
    if !have_tool("node") { eprintln("note: skipping web two-hop journey parity test (need node)"); return }
    source :: """
fn load() -[]> String {{
    return Err("two-hop", code: "TWOHOP")
}}

fn read() -[]> String {{
    value :: load()?("reading source")
    return Ok(value)
}}

fn run() -> {{
    value :: read()?("running source")
    print(value)
}}
"""
    shown :: "tests/fixtures/web_two_hop_journey.jet"
    expected_journey :: " Trail [E3002] (2 hops via ?, origin first):\n  1. read ({shown}:6) — reading source\n  2. run ({shown}:11) — running source"
    expected_report :: "Error [TWOHOP]: two-hop\n  context ({shown}:6): reading source\n  context ({shown}:11): running source\n{expected_journey}"
    native_dir :: env.temp_dir().join("jet_web_two_hop_native_{process.id()}")
    _ :: fs.remove_dir_all(&native_dir).ok()
    fs.create_dir_all(&native_dir).unwrap()
    tir_support.write_test_package(&native_dir, tir_support.TIR_TEST_PACKAGE)
    entry :: native_dir.join("web_two_hop_journey.jet")
    fs.write(&entry, source).unwrap()
    // Native O0/O1/O2 replace the retired AOT-Rust/JIT/interpreter lenses.
    loop tier in ["debug", "dev", "release"] {
        output :: Command.new(env.build_var("CARGO_BIN_EXE_jet")).args(["run", "--profile={tier}", entry.to_str().unwrap()])
            .current_dir(&native_dir).output().unwrap()
        assert_eq(output.status.code(), .Some(1), "{tier} two-hop run must return an error")
        stdout :: String.from_utf8_lossy(&output.stdout)
        assert(stdout.is_empty(), "{tier} two-hop run printed stdout: {stdout:?}")
        stderr := String.from_utf8_lossy(&output.stderr).trim_end() // #4303
        assert_eq(normalize_journey_paths(stderr, shown, 0), expected_report, "{tier} journey changed")
    }
    harness :: """
process.on("unhandledRejection", (error) => {{ if (error?.name !== "JetError") throw error; }});
const {{ jet_main }} = await import("./app.js");
try {{ await jet_main(); throw new Error("unexpected success"); }}
catch (error) {{
  console.log("JOURNEY_BEGIN");
  console.log(error.journey);
  console.log("JOURNEY_END");
  console.log("FRAME_BEGIN");
  console.log(error.frame);
  console.log("FRAME_END");
}}
"""
    js_dir :: build_web_fixture("two_hop_journey_js", "#Target(JS)\n{source}", shown)
    js_stdout :: run_node_harness(&js_dir, "two_hop_journey_harness.mjs", harness)
    js_journey := harness_journey(js_stdout).trim_end() // #4303
    js_frame := harness_frame(js_stdout).trim_end() // #4303
    assert_eq(normalize_journey_paths(js_journey, shown, 1), expected_journey, "JS journey changed")
    assert_eq(normalize_journey_paths(js_frame, shown, 1), expected_report, "JS report changed")
    wasm_dir :: build_web_fixture("two_hop_journey_wasm", source, shown)
    wasm_stdout :: run_node_harness(&wasm_dir, "two_hop_journey_harness.mjs", harness)
    wasm_journey := harness_journey(wasm_stdout).trim_end() // #4303
    wasm_frame := harness_frame(wasm_stdout).trim_end() // #4303
    assert_eq(normalize_journey_paths(wasm_journey, shown, 0), expected_journey, "Wasm journey changed")
    assert_eq(normalize_journey_paths(wasm_frame, shown, 0), expected_report, "Wasm report changed")
    _ :: fs.remove_dir_all(&js_dir).ok()
    _ :: fs.remove_dir_all(&wasm_dir).ok()
    _ :: fs.remove_dir_all(&native_dir).ok()
}
