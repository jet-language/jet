fn get_user() -> Int Err! {{ value :: read_store(); return Ok(value) }}
#Target(Wasm)
fn run() -> {{
    if get_user() == {{
        .Ok(value) -> {{ print(value) }}
        .Err(error) -> {{ print(error.message) }}
        else -> {{}}
    }}
}}
"""
