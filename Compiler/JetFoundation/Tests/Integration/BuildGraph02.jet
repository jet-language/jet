        action := b.action("same", ActionSpec.cached(["jetc", "src/main.jet"]).with_kind(kind).with_inputs(["src/main.jet"]).with_outputs(["build/out"])).unwrap()
        b.plan().unwrap().action_key(action).unwrap().as_str().to_string()
