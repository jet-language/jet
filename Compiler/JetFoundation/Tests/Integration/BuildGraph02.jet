    _ :: fs.remove_dir_all(root)
}

// Rust: tests/build_graph.rs:2391
#Test("remote_transport_authenticates_workers_and_rejects_tampered_or_stale_records") {
    root := env.temp_dir().join("jet_remote_hostile_{id()}_exchange"); _ :: fs.remove_dir_all(&root)
    key := ActionKey.new("hostile-worker")
    worker_binding := RemoteBuildBinding.new("builder-a", &root, "worker-key".as_bytes()).unwrap().with_trust_domain("trusted").with_worker_id("worker-a").with_platform("linux-x86_64").with_abi("native")
    client := RemoteCacheTransport.for_binding(&worker_binding).unwrap(); worker := RemoteCacheTransport.for_binding(&worker_binding).unwrap()
    sandbox := client.sandbox_proof("remote:builder-a:trusted:job-1", "attempt-job-1", key.as_str(), ContentDigest.from_bytes("provenance".as_bytes())).unwrap()
    policy := RemoteCachePolicy.with_grants(false, false, true, sandbox.clone()); unauthenticated := RemoteCacheTransport.new(&root)
    auth_error := unauthenticated.upload_execution_blob("must-not-write".as_bytes(), &policy).unwrap_err()
    assert(auth_error == { RemoteCacheError.Denied(denied) -> denied.reason == RemoteDeniedReason.MissingAuthentication; _ -> false })
    input_digest := client.upload_execution_blob("source".as_bytes(), &policy).unwrap()
    request := RemoteExecutionRequest { key: key.clone(), attempt_id: sandbox.attempt_id.clone(), argv: ["jetc", "src/main.jet"],
        inputs: [ActionInputSnapshot { path: BuildPath.new("src/main.jet").unwrap(), digest: input_digest, byte_len: 6 }], outputs: [BuildPath.new("build/app").unwrap()],
        toolchain_digest: ContentDigest.from_bytes("toolchain".as_bytes()), sandbox: sandbox.clone() }
    client.submit_execution(&request, &policy).unwrap()
    wrong_binding := RemoteBuildBinding.new("builder-a", &root, "wrong-worker-key".as_bytes()).unwrap().with_trust_domain("trusted").with_worker_id("worker-a").with_platform("linux-x86_64").with_abi("native")
    wrong_key := RemoteCacheTransport.for_binding(&wrong_binding).unwrap()
    assert(wrong_key.read_execution_request(&key) == { Err(RemoteCacheError.InvalidRecord(_)) -> true; _ -> false })
    assert_eq(worker.read_execution_request(&key).unwrap(), request)
    output_digest := worker.upload_execution_blob("compiled".as_bytes(), &policy).unwrap(); (stdout_digest, stderr_digest) := remote_empty_log_digests(&worker, &policy)
    result := RemoteExecutionResult { key: key.clone(), attempt_id: request.attempt_id.clone(), execution_id: remote_execution_identity(&request), outcome: ActionOutcome.Succeeded { exit_code: 0 },
        outputs: [ActionOutputRecord { path: request.outputs[0].clone(), digest: output_digest.clone(), byte_len: 8 }], toolchain_digest: request.toolchain_digest.clone(), sandbox: sandbox.clone(),
        stdout_digest: stdout_digest, stderr_digest: stderr_digest, provenance_signer: sandbox.worker_id.clone() }
    worker.publish_execution_result(&result, &policy).unwrap(); assert_eq(client.download_execution_result(&key, &policy).unwrap(), result)
    result_digest := ContentDigest.from_bytes(key.as_str().as_bytes()); result_hex := result_digest.as_str().strip_prefix("sha256:").unwrap()
    result_path := root.join("execution/results").join(&result_hex[..2]).join(&result_hex[2..]); signed := fs.read(&result_path).unwrap()
    unsigned := signed.clone(); mac_start := unsigned.windows(4).position(fn(window) { window == "mac=".as_bytes() }).unwrap()
    mac_end := mac_start + unsigned[mac_start..].iter().position(fn(byte) { byte == 10 }).unwrap() + 1
    _ :: unsigned.drain(mac_start..mac_end); fs.write(&result_path, unsigned).unwrap()
    assert(client.download_execution_result(&key, &policy) == { Err(RemoteCacheError.InvalidRecord(message)) -> message.contains("no MAC"); _ -> false })
    corrupt := signed; payload_offset := corrupt.windows(2).position(fn(window) { window == [10, 10] }).unwrap() + 2
    corrupt[payload_offset] = if corrupt[payload_offset] == 118 { 119 } else { 118 }
    fs.write(&result_path, corrupt).unwrap()
    assert(client.download_execution_result(&key, &policy) == { Err(RemoteCacheError.InvalidRecord(message)) -> message.contains("authentication failed"); _ -> false })
    // A new attempt removes the old result before publishing the request; delayed workers cannot replay it.
    new_sandbox := client.sandbox_proof("remote:builder-a:trusted:job-2", "attempt-job-2", key.as_str(), ContentDigest.from_bytes("provenance".as_bytes())).unwrap()
    new_policy := RemoteCachePolicy.with_grants(false, false, true, new_sandbox.clone())
    new_request := request.clone(); new_request.sandbox = new_sandbox.clone(); new_request.attempt_id = new_sandbox.attempt_id.clone()
    client.submit_execution(&new_request, &new_policy).unwrap()
    stale_error := client.download_execution_result(&key, &new_policy).unwrap_err()
    assert(stale_error == { RemoteCacheError.Io(error) -> error.kind() == ErrorKind.NotFound; _ -> false })
    replay_error := worker.publish_execution_result(&result, &policy).unwrap_err()
    assert(replay_error == { RemoteCacheError.InvalidRecord(_) -> true; _ -> false })
    output_path := root.join("cas").join("blobs").join("sha256").join(&output_digest.as_str()[7..9]).join(&output_digest.as_str()[9..])
    tampered := fs.read(&output_path).unwrap(); last := tampered.len() - 1; tampered[last] ^= 0x01; fs.write(&output_path, tampered).unwrap()
    tampered_error := client.download_execution_blob(&output_digest, &policy).unwrap_err()
    assert(tampered_error == { RemoteCacheError.InvalidRecord(_) -> true; _ -> false })
    binding := RemoteBuildBinding.new("builder-a", root.clone(), "worker-key".as_bytes()).unwrap().with_trust_domain("trusted").with_execute(true)
    assert(binding.is_enabled()); assert("{binding:?}".contains("configured: true")); bound := RemoteCacheTransport.for_binding(&binding).unwrap()
    foreign_policy := RemoteCachePolicy.with_grants(false, false, true, RemoteSandboxProof.new("remote:builder-a:other-trust:job-1", key.as_str(), ContentDigest.from_bytes("provenance".as_bytes())))
    assert(bound.upload_execution_blob("foreign".as_bytes(), &foreign_policy) == { Err(RemoteCacheError.InvalidRecord(_)) -> true; _ -> false })
    _ :: fs.remove_dir_all(root)
}

// Rust: tests/build_graph.rs:2590
#Test("scheduler_records_parallel_ready_graph_pools_cancellation_and_metrics") {
    b := BuildContext.new()
    core := b.action("compile-core", ActionSpec.cached(["jetc", "src/core.jet"]).with_outputs(["build/core.o"]).with_pool(BuildResourcePool.CPU)).unwrap()
    ui := b.action("compile-ui", ActionSpec.cached(["jetc", "src/ui.jet"]).with_outputs(["build/ui.o"]).with_pool(BuildResourcePool.CPU)).unwrap()
    link := b.action("link-app", ActionSpec.cached(["ld", "-o", "build/app"]).with_inputs(["build/core.o", "build/ui.o"]).with_outputs(["build/app"]).with_pool(BuildResourcePool.Linker).with_pool(BuildResourcePool.Console)).unwrap()
    core_target := b.add_library("core", TargetSpec.new().with_action(core)).unwrap()
    ui_target := b.add_library("ui", TargetSpec.new().with_action(ui)).unwrap()
    app := b.add_executable("app", TargetSpec.new().with_dep(core_target).with_dep(ui_target).with_action(link)).unwrap()
    plan := b.plan_with_default(app).unwrap(); model := plan.execution_model().unwrap()
    assert_eq(model.stages[0].actions, [core.id(), ui.id()]); assert_eq(model.stages[1].actions, [link.id()])
    assert_eq(model.metrics.max_parallel_actions, 2); assert_eq(model.metrics.cacheable_actions, 3)
    assert_eq(model.pools.iter().map(fn(pool) { pool.pool.as_str() }).collect(), ["cpu", "memory", "linker", "console", "gpu"])
    assert_eq(model.nodes.iter().find(fn(node) { node.action == link.id() }).unwrap().prerequisites, [core.id(), ui.id()])
    assert_eq(model.console_order, [core.id(), ui.id(), link.id()])
    report := plan.execution_report(&[(core, ActionOutcome.Failed { exit_code: 1 }), (ui, ActionOutcome.Succeeded { exit_code: 0 })]).unwrap()
    assert(report.events.contains(&BuildExecutionEvent.Cancelled { action: link.id(), failed_prereq: core.id() }))
    assert_eq(report.metrics.failed_actions, 1); assert_eq(report.metrics.cancelled_actions, 1)
}

// Rust: tests/build_graph.rs:2674
#Test("scheduler_orders_file_producer_before_consumer_without_target_dep") {
    b := BuildContext.new()
    gen := b.action("generate", ActionSpec.cached(["gen"]).with_outputs([".jet/generated/schema.jet"]).with_pool(BuildResourcePool.CPU)).unwrap()
    compile := b.action("compile", ActionSpec.cached(["jetc", ".jet/generated/schema.jet"]).with_inputs([".jet/generated/schema.jet"]).with_outputs(["build/schema.o"]).with_pool(BuildResourcePool.CPU)).unwrap()
    b.add_library("gen", TargetSpec.new().with_action(gen)).unwrap()
    b.add_library("compile", TargetSpec.new().with_action(compile)).unwrap()
    plan := b.plan().unwrap(); model := plan.execution_model().unwrap()
    assert_eq(model.stages[0].actions, [gen.id()]); assert_eq(model.stages[1].actions, [compile.id()])
    assert_eq(model.nodes.iter().find(fn(node) { node.action == compile.id() }).unwrap().prerequisites, [gen.id()])
}

// Rust: tests/build_graph.rs:2714
#Test("graph_query_explain_and_rebuild_reasons_share_plan_provenance") {
    b := BuildContext.new()
    gen := b.action("generate-schema", ActionSpec.cached(["schema-gen", "schema/app.sql"]).with_inputs(["schema/app.sql"]).with_outputs([".jet/generated/schema.jet"]).with_cap(BuildCapability.FS)).unwrap()
    lib := b.add_library("db", TargetSpec.new().with_source(".jet/generated/schema.jet").with_action(gen)).unwrap()
    plan := b.plan_with_default(lib).unwrap(); graph := plan.graph()
    assert_eq(graph.targets[0].name, "db"); assert_eq(graph.actions[0].outputs, [".jet/generated/schema.jet"])
    ownership := plan.file_ownership(".jet/generated/schema.jet")
    assert_eq(ownership.owner, Val(gen.id())); assert_eq(ownership.targets, [lib.id()])
    target_explain := plan.explain_target(lib).unwrap()
    assert_eq(target_explain.subject, BuildGraphSubject.Target(lib.id())); assert(target_explain.provenance.iter().any(fn(line) { line == "actions=1" }))
    action_explain := plan.explain_action(gen).unwrap()
    assert_eq(action_explain.subject, BuildGraphSubject.Action(gen.id())); assert(action_explain.provenance.iter().any(fn(line) { line == "inputs=1" }))
    file_explain := plan.explain_file(".jet/generated/schema.jet")
    assert(file_explain.provenance.iter().any(fn(line) { line == "owner=Some(ActionId(0))" }), "generated action ownership must remain visible")
    rebuilt := plan.why_rebuilt(gen, ActionCacheStatus.Miss(CacheMissReason.ActionKeyChanged)).unwrap()
    assert_eq(rebuilt.action, gen.id()); assert_eq(rebuilt.reason, "action key changed")
}

// Rust: tests/build_graph.rs:2773
#Test("legacy_wrappers_are_typed_declared_and_policy_denied_without_ambient_authority") {
    policy := BuildPolicy.allow_all()
    for (kind, spec) in [
        (LegacyWrapperKind.CMake, LegacyWrapperSpec.cmake(["cmake", "--build", "build"])),
        (LegacyWrapperKind.Make, LegacyWrapperSpec.make(["make"])),
        (LegacyWrapperKind.Gradle, LegacyWrapperSpec.gradle(["gradle", "assemble"])),
        (LegacyWrapperKind.Npm, LegacyWrapperSpec.npm(["npm", "run", "build"])),
        (LegacyWrapperKind.Cargo, LegacyWrapperSpec.cargo(["cargo", "build"]))
    ] {
        action := spec.with_inputs(["legacy/project"]).with_outputs(["build/{kind.as_str()}"]).with_cap(BuildCapability.Exec).with_cap(BuildCapability.FS).into_action_spec(&policy).unwrap()
        assert_eq(action.legacy_wrapper, Val(kind)); assert(action.caps.contains(&BuildCapability.Exec))
        assert_eq(action.inputs[0].as_str(), "legacy/project")
        assert_eq(action.labels.get("legacy.wrapper").map(fn(value) { value.as_str() }), Val(kind.as_str()))
    }
    denial := LegacyWrapperSpec.cargo(["cargo", "build"]).with_inputs(["Cargo.toml"]).with_outputs(["target/debug/app"]).with_cap(BuildCapability.Exec)
        .explain(&BuildPolicy.deny_legacy_wrappers("CI forbids legacy build tools"))
    assert(!denial.allowed); assert_eq(denial.reason, "CI forbids legacy build tools")
    err := LegacyWrapperSpec.make(["make"]).with_inputs(["Makefile"]).with_outputs(["build/app"]).into_action_spec(&policy).unwrap_err()
    assert_eq(err, BuildError.LegacyWrapperWithoutCaps(LegacyWrapperKind.Make))
}

// Rust: tests/build_graph.rs:2832
#Test("legacy_project_import_reads_one_canonical_file_and_ci_denies_the_wrapper") {
    root := env.temp_dir().join("jet_legacy_import_{id()}_cargo")
    _ :: fs.remove_dir_all(&root); fs.create_dir_all(&root).unwrap()
    fs.write(root.join("Cargo.toml"), "[package]\nname = \"imported\"\n".as_bytes()).unwrap()
    imported := LegacyWrapperSpec.from_project_file(&root, LegacyWrapperKind.Cargo).unwrap()
    assert_eq(imported.labels.get("legacy.project-file").map(fn(value) { value.as_str() }), Val("Cargo.toml"))
    assert_eq(imported.inputs[0].as_str(), "Cargo.toml"); assert_eq(imported.argv[0], "cargo")
    action := imported.clone().with_outputs(["target/debug/imported"]).with_cap(BuildCapability.Exec).into_action_spec(&BuildPolicy.allow_all()).unwrap()
    assert_eq(action.legacy_wrapper, Val(LegacyWrapperKind.Cargo))
    ci := imported.with_outputs(["target/debug/imported"]).with_cap(BuildCapability.Exec).into_action_spec(&BuildPolicy.ci_default()).unwrap_err()
    assert(ci == { BuildError.PolicyDenied(_) -> true; _ -> false })
    fs.remove_file(root.join("Cargo.toml")).unwrap()
    assert_eq(LegacyWrapperSpec.from_project_file(&root, LegacyWrapperKind.Cargo).unwrap_err(), BuildError.LegacyProjectFileMissing(LegacyWrapperKind.Cargo))
    _ :: fs.remove_dir_all(root)
}

// Rust: tests/build_graph.rs:2876
#Test("legacy_project_import_rejects_ambiguous_targets_and_unmodeled_dependencies") {
    root := env.temp_dir().join("jet_legacy_import_strict_{id()}_all")
    _ :: fs.remove_dir_all(&root); fs.create_dir_all(&root).unwrap()
    fs.write(root.join("CMakeLists.txt"), "project(app)\nadd_executable(app main.cc)\nadd_dependencies(app generated)\n").unwrap()
    assert(LegacyWrapperSpec.from_project_file(&root, LegacyWrapperKind.CMake) == { Err(BuildError.LegacyProjectFileInvalid(message)) -> message.contains("add_dependencies"); _ -> false })
    fs.write(root.join("Makefile"), "all: main.o\nother:\n").unwrap()
    assert(LegacyWrapperSpec.from_project_file(&root, LegacyWrapperKind.Make) == { Err(BuildError.LegacyProjectFileInvalid(message)) -> message.contains("multiple or ambiguous"); _ -> false })
    fs.write(root.join("build.gradle"), "tasks.register(\"build\")\ndependencies {{ implementation(\"x:y:1\") }}\n").unwrap()
    assert(LegacyWrapperSpec.from_project_file(&root, LegacyWrapperKind.Gradle) == { Err(BuildError.LegacyProjectFileInvalid(message)) -> message.contains("depends") || message.contains("dependencies"); _ -> false })
    fs.write(root.join("package.json"), "{{\"scripts\":{{\"build\":\"tool\"}},\"dependencies\":\"not-an-object\"}}").unwrap()
    assert(LegacyWrapperSpec.from_project_file(&root, LegacyWrapperKind.Npm) == { Err(BuildError.LegacyProjectFileInvalid(message)) -> message.contains("dependencies"); _ -> false })
    fs.write(root.join("Cargo.toml"), "[package]\nname = \"app\"\n[[bin]]\nname = \"one\"\n[[bin]]\nname = \"two\"\n").unwrap()
    assert(LegacyWrapperSpec.from_project_file(&root, LegacyWrapperKind.Cargo) == { Err(BuildError.LegacyProjectFileInvalid(message)) -> message.contains("multiple binary"); _ -> false })
    _ :: fs.remove_dir_all(root)
}

// Rust: tests/build_graph.rs:2934
#Test("legacy_project_import_captures_source_closure_and_rejects_unmodeled_recipes") {
    root := env.temp_dir().join("jet_legacy_import_closure_{id()}_all")
    _ :: fs.remove_dir_all(&root); fs.create_dir_all(root.join("src")).unwrap(); fs.create_dir_all(root.join("include")).unwrap()
    fs.write(root.join("src/main.c"), "int main(void) {{ return 0; }}\n").unwrap(); fs.write(root.join("include/app.h"), "#pragma once\n").unwrap()
    fs.write(root.join("CMakeLists.txt"), "project(app)\nadd_executable(app src/main.c)\n# jet: output=build/app\n").unwrap()
    cmake := LegacyWrapperSpec.from_project_file(&root, LegacyWrapperKind.CMake).unwrap()
    assert(cmake.inputs.iter().any(fn(path) { path.as_str() == "src/main.c" })); assert(cmake.inputs.iter().any(fn(path) { path.as_str() == "include/app.h" }))
    assert(cmake.labels.get("legacy.source-closure").is_some_and(fn(value) { value.starts_with("project-files-v1:") }))
    fs.write(root.join("CMakeLists.txt"), "project(app)\nadd_executable(app src/main.c)\n").unwrap()
    assert(LegacyWrapperSpec.from_project_file(&root, LegacyWrapperKind.CMake) == { Err(BuildError.LegacyProjectFileInvalid(message)) -> message.contains("exact build output"); _ -> false })
    fs.write(root.join("Makefile"), "app: src/main.c\n\tcc -o app src/main.c\n").unwrap()
    assert(LegacyWrapperSpec.from_project_file(&root, LegacyWrapperKind.Make) == { Err(BuildError.LegacyProjectFileInvalid(message)) -> message.contains("recipe bodies"); _ -> false })
    fs.write(root.join("build.gradle"), "rootProject.name = \"app\"\ntasks.register(\"build\")\n# jet: output=build/libs/app.jar\n").unwrap()
    gradle := LegacyWrapperSpec.from_project_file(&root, LegacyWrapperKind.Gradle).unwrap()
    assert(gradle.outputs.iter().any(fn(path) { path.as_str() == "build/libs/app.jar" }))
    fs.write(root.join("build.gradle"), "tasks.register(\"build\") {{ dependsOn \"x\" }}\n").unwrap()
    assert(LegacyWrapperSpec.from_project_file(&root, LegacyWrapperKind.Gradle) == { Err(BuildError.LegacyProjectFileInvalid(message)) -> message.contains("task body"); _ -> false })
    fs.write(root.join("Cargo.toml"), "[package]\nname = \"app\"\n[dependencies]\nserde = \"1\"\n").unwrap()
    assert(LegacyWrapperSpec.from_project_file(&root, LegacyWrapperKind.Cargo) == { Err(BuildError.LegacyProjectFileInvalid(message)) -> message.contains("Cargo.lock"); _ -> false })
    fs.write(root.join("package.json"), "{{\"scripts\":{{\"build\":\"tool\"}}}}").unwrap()
    assert(LegacyWrapperSpec.from_project_file(&root, LegacyWrapperKind.Npm) == { Err(BuildError.LegacyProjectFileInvalid(message)) -> message.contains("exact build output"); _ -> false })
    fs.write(root.join("package.json"), "{{\"scripts\":{{\"build\":\"tool\"}},\"main\":\"dist/index.js\",\"dependencies\":{{\"vite\":\"5\"}}}}").unwrap()
    fs.write(root.join("package-lock.json"), "{{}}".as_bytes()).unwrap()
    npm := LegacyWrapperSpec.from_project_file(&root, LegacyWrapperKind.Npm).unwrap()
    assert(npm.outputs.iter().any(fn(path) { path.as_str() == "dist/index.js" }))
    assert_eq(npm.labels.get("legacy.dependency.dependencies.vite").map(fn(value) { value.as_str() }), Val("5"))
    fs.remove_file(root.join("package-lock.json")).unwrap()
    fs.write(root.join("package.json"), "{{\"scripts\":{{\"build\":\"tool\"}},\"dependencies\":{{\"vite\":\"5\"}}}}").unwrap()
    assert(LegacyWrapperSpec.from_project_file(&root, LegacyWrapperKind.Npm) == { Err(BuildError.LegacyProjectFileInvalid(message)) -> message.contains("package-lock") || message.contains("shrinkwrap"); _ -> false })
    _ :: fs.remove_dir_all(root)
}

