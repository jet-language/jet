// Rust: tests/build_graph.rs:3396
#Test("complete_action_key_covers_dep_outputs_env_allowlist_helpers_and_exact_source") {
    b := BuildContext.new()
    dep_action := b.action("dep-compile", ActionSpec.cached(["jetc", "lib.jet"]).with_kind(ActionKind.Compile).with_outputs(["build/lib.o"])).unwrap()
    dep := b.add_library("lib", TargetSpec.new().with_source("lib.jet").with_action(dep_action).with_output("build/lib.o")).unwrap()
    main := b.action("main-compile", ActionSpec.cached(["jetc", "main.jet"]).with_kind(ActionKind.Compile).with_inputs(["main.jet"]).with_outputs(["build/main"])
        .with_env("JET_PROFILE", "release").with_env("HOME", "/tmp/leak").with_env_allowlist(["JET_PROFILE"]).with_helper_version("docgen", "1.2.3").with_label("profile", "release")).unwrap()
    b.add_executable("app", TargetSpec.new().with_source("main.jet").with_dep(dep).with_action(main).with_metadata("profile", "release")).unwrap()
    plan := b.plan().unwrap()
    snap := [ActionInputSnapshot { path: BuildPath.new("main.jet").unwrap(), digest: ContentDigest.from_bytes("fn run() {{}}".as_bytes()), byte_len: 11 }]
    base := plan.action_key_with_inputs(main, &snap).unwrap()
    // HOME is outside the allowlist: changing its declared value must not change the key.
    b2 := BuildContext.new()
    dep_action2 := b2.action("dep-compile", ActionSpec.cached(["jetc", "lib.jet"]).with_kind(ActionKind.Compile).with_outputs(["build/lib.o"])).unwrap()
    dep2 := b2.add_library("lib", TargetSpec.new().with_source("lib.jet").with_action(dep_action2).with_output("build/lib.o")).unwrap()
    main2 := b2.action("main-compile", ActionSpec.cached(["jetc", "main.jet"]).with_kind(ActionKind.Compile).with_inputs(["main.jet"]).with_outputs(["build/main"])
        .with_env("JET_PROFILE", "release").with_env("HOME", "/other/home").with_env_allowlist(["JET_PROFILE"]).with_helper_version("docgen", "1.2.3").with_label("profile", "release")).unwrap()
    b2.add_executable("app", TargetSpec.new().with_source("main.jet").with_dep(dep2).with_action(main2).with_metadata("profile", "release")).unwrap()
    assert_eq(base, b2.plan().unwrap().action_key_with_inputs(main2, &snap).unwrap())
    // Helper version changes the key.
    b3 := BuildContext.new()
    dep_action3 := b3.action("dep-compile", ActionSpec.cached(["jetc", "lib.jet"]).with_kind(ActionKind.Compile).with_outputs(["build/lib.o"])).unwrap()
    dep3 := b3.add_library("lib", TargetSpec.new().with_source("lib.jet").with_action(dep_action3).with_output("build/lib.o")).unwrap()
    main3 := b3.action("main-compile", ActionSpec.cached(["jetc", "main.jet"]).with_kind(ActionKind.Compile).with_inputs(["main.jet"]).with_outputs(["build/main"])
        .with_env("JET_PROFILE", "release").with_env_allowlist(["JET_PROFILE"]).with_helper_version("docgen", "9.9.9").with_label("profile", "release")).unwrap()
    b3.add_executable("app", TargetSpec.new().with_source("main.jet").with_dep(dep3).with_action(main3).with_metadata("profile", "release")).unwrap()
    assert_ne(base, b3.plan().unwrap().action_key_with_inputs(main3, &snap).unwrap())
    // Exact source bytes change the key for observing kinds.
    snap2 := [ActionInputSnapshot { path: BuildPath.new("main.jet").unwrap(), digest: ContentDigest.from_bytes("fn run() {{ print(1) }}".as_bytes()), byte_len: 20 }]
    assert_ne(base, plan.action_key_with_inputs(main, &snap2).unwrap())
    // Dependency output path changes the key.
    b4 := BuildContext.new()
    dep_action4 := b4.action("dep-compile", ActionSpec.cached(["jetc", "lib.jet"]).with_kind(ActionKind.Compile).with_outputs(["build/lib-renamed.o"])).unwrap()
    dep4 := b4.add_library("lib", TargetSpec.new().with_source("lib.jet").with_action(dep_action4).with_output("build/lib-renamed.o")).unwrap()
    main4 := b4.action("main-compile", ActionSpec.cached(["jetc", "main.jet"]).with_kind(ActionKind.Compile).with_inputs(["main.jet"]).with_outputs(["build/main"])
        .with_env("JET_PROFILE", "release").with_env_allowlist(["JET_PROFILE"]).with_helper_version("docgen", "1.2.3").with_label("profile", "release")).unwrap()
    b4.add_executable("app", TargetSpec.new().with_source("main.jet").with_dep(dep4).with_action(main4).with_metadata("profile", "release")).unwrap()
    assert_ne(base, b4.plan().unwrap().action_key_with_inputs(main4, &snap).unwrap())
}

// Rust: tests/build_graph.rs:3610
#Test("front_end_completion_gates_cache_lookup") {
    assert(FrontEndCompletion.all_complete().authorize_cache_lookup().is_ok())
    parser := FrontEndCompletion.all_complete(); parser.parsed = false
    assert_eq(parser.authorize_cache_lookup().unwrap_err(), CacheBypassDenied.Parser)
    sema := FrontEndCompletion.all_complete(); sema.sema_checked = false
    assert_eq(sema.authorize_cache_lookup().unwrap_err(), CacheBypassDenied.Sema)
    policy := FrontEndCompletion.all_complete(); policy.policy_checked = false
    assert_eq(policy.authorize_cache_lookup().unwrap_err(), CacheBypassDenied.Policy)
    diagnostics := FrontEndCompletion.all_complete(); diagnostics.diagnostics_complete = false
    assert_eq(diagnostics.authorize_cache_lookup().unwrap_err(), CacheBypassDenied.Diagnostics)
}

// Rust: tests/build_graph.rs:3655
#Test("per_package_dependency_artifacts_restore_and_invalidate") {
    root := env.temp_dir().join("jet_build_package_actions_{id()}_restore")
    _ :: fs.remove_dir_all(&root); fs.create_dir_all(&root).unwrap()
    make_plan := fn(identity: &String, target: &String, profile: &String, alpha_source: &[U8], beta_source: &[U8]) -> BuildPlan {
        context := BuildContext.new()
        app := context.add_executable("app", TargetSpec.new().with_source("main.jet")).unwrap()
        plan := context.plan_with_default(app).unwrap()
        plan.add_compiler_package_actions(&[
            CompilerPackageSpec.new("alpha", ContentDigest.from_bytes(alpha_source), []),
            CompilerPackageSpec.new("beta", ContentDigest.from_bytes(beta_source), []),
            CompilerPackageSpec.new("app", ContentDigest.from_bytes("app".as_bytes()), ["alpha", "beta"])
        ], identity, target, profile).unwrap()
        plan
    }
    plan := make_plan("jet-test-compiler@clean", "native-test-target", "debug", "alpha".as_bytes(), "beta".as_bytes())
    // The original sealed-byte compiler callback is a test-local action runner, not a production fallback.
    compiler := fn(action: &BuildAction, snapshots: &[ActionInputSnapshot]) {
        label := fn(name: &String) -> String { action.labels.get(name).map(fn(value) { value.as_str() }).unwrap_or_default() }
        dependencies := snapshots.iter().map(fn(snapshot) { "{snapshot.path.as_str()}={snapshot.digest.as_str()}" }).collect().join(",")
        Ok(action.outputs.iter().map(fn(_) {
            "sealed:{action.name.as_str()}:{label("compiler.source-digest")}:{label("compiler.identity")}:{label("compiler.target")}:{label("compiler.profile")}:{dependencies}".into_bytes()
        }).collect())
    }
    first := execute_build_plan_with_front_end_and_compiler(&plan, &root, &[], FrontEndCompletion.all_complete(), &compiler).unwrap()
    assert_eq(first.report.events.iter().filter(fn(event) {
        event == {
            BuildExecutionEvent.Finished { action, outcome: ActionOutcome.Succeeded { .. } } -> plan.action_handle(action).and_then(fn(handle) { plan.action(handle) }).is_some_and(fn(action) { action.is_compiler_owned() })
            _ -> false
        }
    }).count(), 3)
    second := execute_build_plan_with_front_end_and_compiler(&plan, &root, &[], FrontEndCompletion.all_complete(), &compiler).unwrap()
    assert_eq(second.report.metrics.cache_restored_actions, 3)
    assert_eq(second.report.events.iter().filter(fn(event) {
        event == {
            BuildExecutionEvent.Finished { action, outcome: ActionOutcome.RestoredFromCache } -> plan.action_handle(action).and_then(fn(handle) { plan.action(handle) })
                .and_then(fn(action) { action.labels.get("compiler.package") }).is_some_and(fn(package) { package != "app" })
            _ -> false
        }
    }).count(), 2, "every unchanged dependency artifact must restore")
    assert(second.report.events.iter().all(fn(event) {
        !(event == {
            BuildExecutionEvent.Finished { action, outcome: ActionOutcome.Succeeded { .. } } -> plan.action_handle(action).and_then(fn(handle) { plan.action(handle) })
                .and_then(fn(action) { action.labels.get("compiler.package") }).is_some_and(fn(package) { package != "app" })
            _ -> false
        })
    }))
    rebuild_with := fn(field: &String, value: &String) {
        changed_plan := field == {
            "compiler.identity" -> make_plan(value, "native-test-target", "debug", "alpha".as_bytes(), "beta".as_bytes())
            "compiler.target" -> make_plan("jet-test-compiler@clean", value, "debug", "alpha".as_bytes(), "beta".as_bytes())
            "compiler.profile" -> make_plan("jet-test-compiler@clean", "native-test-target", value, "alpha".as_bytes(), "beta".as_bytes())
            _ -> { panic("unreachable compiler field") }
        }
        rebuilt := execute_build_plan_with_front_end_and_compiler(&changed_plan, &root, &[], FrontEndCompletion.all_complete(), &compiler).unwrap()
        assert_eq(rebuilt.report.metrics.cache_restored_actions, 0, "{field}")
        assert_eq(rebuilt.report.events.iter().filter(fn(event) {
            event == {
                BuildExecutionEvent.Finished { action, outcome: ActionOutcome.Succeeded { .. } } -> changed_plan.action_handle(action).and_then(fn(handle) { changed_plan.action(handle) })
                    .and_then(fn(action) { action.labels.get("compiler.package") }).is_some_and(fn(package) { package != "app" })
                _ -> false
            }
        }).count(), 2, "{field} change must rebuild each dependency artifact once")
    }
    rebuild_with("compiler.identity", "jet-test-compiler@next"); rebuild_with("compiler.target", "aarch64-test-target"); rebuild_with("compiler.profile", "release")
    changed_source_plan := make_plan("jet-test-compiler@clean", "native-test-target", "debug", "alpha-v2".as_bytes(), "beta".as_bytes())
    changed_source := execute_build_plan_with_front_end_and_compiler(&changed_source_plan, &root, &[], FrontEndCompletion.all_complete(), &compiler).unwrap()
    assert_eq(changed_source.report.metrics.cache_restored_actions, 1)
    assert_eq(changed_source.report.events.iter().filter(fn(event) {
        event == {
            BuildExecutionEvent.Finished { action, outcome: ActionOutcome.Succeeded { .. } } -> changed_source_plan.action_handle(action).and_then(fn(handle) { changed_source_plan.action(handle) }).is_some_and(fn(action) { action.is_compiler_owned() })
            _ -> false
        }
    }).count(), 2, "changing alpha must rebuild alpha and its app dependent only")
    assert(changed_source.report.events.iter().any(fn(event) {
        event == {
            BuildExecutionEvent.Finished { action, outcome: ActionOutcome.RestoredFromCache } -> changed_source_plan.action_handle(action).and_then(fn(handle) { changed_source_plan.action(handle) })
                .and_then(fn(action) { action.labels.get("compiler.package") }).is_some_and(fn(package) { package == "beta" })
            _ -> false
        }
    }))
    dependency := plan.actions().iter().find(fn(action) { action.labels.get("compiler.package").is_some_and(fn(value) { value == "alpha" }) }).unwrap()
    consumer := plan.actions().iter().find(fn(action) { action.labels.get("compiler.package").is_some_and(fn(value) { value == "app" }) }).unwrap()
    original := ActionInputSnapshot { path: dependency.outputs[0].clone(), digest: ContentDigest.from_bytes("sealed:alpha".as_bytes()), byte_len: "sealed:alpha".len() as U64 }
    changed := original.clone(); changed.digest = ContentDigest.from_bytes("sealed:alpha-v2".as_bytes()); changed.byte_len = "sealed:alpha-v2".len() as U64
    consumer_handle := plan.action_handle(consumer.id).unwrap()
    assert_ne(plan.action_key_with_inputs(consumer_handle, &[original]).unwrap(), plan.action_key_with_inputs(consumer_handle, &[changed]).unwrap())
    fs.remove_dir_all(root).unwrap()
}

// Rust: tests/build_graph.rs:3941
#Test("compiler_package_identity_target_and_profile_force_rebuild_keys") {
    // Rust: tests/build_graph.rs:3942
    key := fn(identity: &String, target: &String, profile: &String) -> ActionKey {
        context := BuildContext.new()
        app := context.add_executable("app", TargetSpec.new().with_source("main.jet")).unwrap()
        plan := context.plan_with_default(app).unwrap()
        handles := plan.add_compiler_package_actions(&[CompilerPackageSpec.new("app", ContentDigest.from_bytes("source".as_bytes()), [])], identity, target, profile).unwrap()
        plan.action_key(handles[0]).unwrap()
    }
    base := key("jet-a", "x86_64-linux", "debug")
    assert_ne(base, key("jet-b", "x86_64-linux", "debug")); assert_ne(base, key("jet-a", "aarch64-linux", "debug")); assert_ne(base, key("jet-a", "x86_64-linux", "release"))
}

// Rust: tests/build_graph.rs:3970
#Test("declared_hangar_toolchain_binds_virtual_mount_and_action_identity") {
    // Rust: tests/build_graph.rs:3971
    plan_for := fn(mount_identity: &String) -> (BuildPlan, ActionHandle) {
        context := BuildContext.new()
        provenance := BuildProvenance.jetpack_dependency("cc-toolchain@jetpack", LockRecord.new("hangar", "sha256:bundle"))
        mount_source := "/hangar/objects/{mount_identity}"; mount_destination := "/jet/toolchains/bundle"
        toolchain := context.toolchain("jet-cc", ToolchainSpec.target("x86_64-unknown-linux-gnu", provenance.clone())
            .with_host_triple("x86_64-unknown-linux-gnu").with_linker(LinkerIdentity.new("lld", provenance.clone()))
            .with_sysroot(SysrootIdentity.new("sysroot", "sha256:sysroot", provenance.clone()))
            .with_tool("cc", "{mount_destination}/bin/cc").with_tool("c++", "{mount_destination}/bin/c++").with_tool("ld", "{mount_destination}/bin/ld")
            .declared_only().with_read_only_mount_identity(mount_source, mount_destination, "sha256:{mount_identity}")).unwrap()
        action := context.action("compile-main", ActionSpec.cached(["cc", "--target=x86_64-unknown-linux-gnu", "--sysroot=/jet/toolchains/bundle/sysroot", "-c", "main.c"])
            .with_inputs(["main.c"]).with_outputs(["main.o"]).with_kind(ActionKind.Compile).with_cap(BuildCapability.Exec).with_toolchain(toolchain)).unwrap()
        app := context.add_executable("app", TargetSpec.new().with_source("main.c").with_output("app").with_action(action).with_toolchain(toolchain)).unwrap()
        (context.plan_with_default(app).unwrap(), action)
    }
    (first, first_action) := plan_for("bundle-a"); (second, second_action) := plan_for("bundle-b")
    first_toolchain := &first.toolchains()[1]
    assert_eq(first_toolchain.resolution, ToolchainResolution.DeclaredOnly); assert_eq(first_toolchain.mounts[0].identity, "sha256:bundle-a")
    assert_eq(first_toolchain.tools.get("cc").map(fn(value) { value.as_str() }), Val("/jet/toolchains/bundle/bin/cc"))
    assert_eq(first.action(first_action).unwrap().kind, ActionKind.Compile)
    assert_ne(first.action_key(first_action).unwrap(), second.action_key(second_action).unwrap())
}

// Rust: tests/build_graph.rs:4064
#Test("compiler_nodes_are_sorted_and_path_independent") {
    first := BuildPlanNode.new(BuildNodeKind.Check, "src/main.jet", [("src/z.jet", "digest-z"), ("src/a.jet", "digest-a")])
    second := BuildPlanNode.new(BuildNodeKind.Check, "src/main.jet", [("src/a.jet", "digest-a"), ("src/z.jet", "digest-z")])
    assert_eq(first, second); assert_eq(first.inputs, ["src/a.jet", "src/z.jet"]); assert_eq(first.key.len(), 64)
}
