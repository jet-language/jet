// GATE #4494: native filesystem, threads, time and environment are real providers throughout.
// Rust: tests/build_graph.rs:1829
#Test("remote_execution_retries_after_worker_loss") {
    project_root := env.temp_dir().join("jet_remote_retry_{id()}_worker-loss")
    _ :: fs.remove_dir_all(&project_root); fs.create_dir_all(project_root.join("src")).unwrap()
    fs.write(project_root.join("src/input"), "retry input".as_bytes()).unwrap()
    remote_root := project_root.join("remote-transport")
    b := BuildContext.new()
    action := b.action("remote-retry", ActionSpec.cached(["remote-tool"]).with_inputs(["src/input"]).with_outputs(["build/retried"]).with_cap(BuildCapability.Net)).unwrap()
    target := b.add_executable("retried", TargetSpec.new().with_action(action)).unwrap()
    plan := b.plan_with_default(target).unwrap(); grants := [BuildCapability.Net].into_iter().collect()
    store := test_artifact_store(&project_root)
    snapshots := snapshot_declared_inputs(&store, &project_root, plan.action(action).unwrap()).unwrap()
    key := plan.effective_action_key(action, &snapshots, &grants, OSPath.new("remote-tool"), &ContentDigest.from_bytes("remote-tool".as_bytes()), &[]).unwrap()
    binding := RemoteBuildBinding.new("builder-retry", &remote_root, "retry-key".as_bytes()).unwrap().with_trust_domain("trusted")
        .with_worker_id("worker-retry").with_platform("{selected_os()}-{selected_arch()}").with_abi("native").with_execute(true).with_timeout_ms(1000)
    worker_key := key.clone(); worker_binding := binding.clone()
    worker := thread.spawn(fn() {
        transport := RemoteCacheTransport.for_binding(&worker_binding).unwrap()
        deadline := Instant.now() + Duration.from_secs(5); lost_attempt: String? = None
        loop {
            transport.read_execution_request(&worker_key) == {
                Ok(request) -> {
                    if lost_attempt.is_none() { lost_attempt = Val(request.attempt_id) }
                    else if lost_attempt.as_ref().is_some_and(fn(attempt) { attempt == &request.attempt_id }) { thread.sleep(Duration.from_millis(2)) }
                    else {
                        policy := RemoteCachePolicy.with_grants(false, false, true, request.sandbox.clone())
                        bytes := "retried output".as_bytes(); digest := transport.upload_execution_blob(bytes, &policy).unwrap()
                        (stdout_digest, stderr_digest) := remote_empty_log_digests(&transport, &policy)
                        transport.publish_execution_result(&RemoteExecutionResult {
                            key: request.key.clone(), attempt_id: request.attempt_id.clone(), execution_id: remote_execution_identity(&request),
                            outcome: ActionOutcome.Succeeded { exit_code: 0 }, outputs: [ActionOutputRecord { path: request.outputs[0].clone(), digest: digest, byte_len: bytes.len() as U64 }],
                            toolchain_digest: request.toolchain_digest.clone(), sandbox: request.sandbox.clone(), stdout_digest: stdout_digest, stderr_digest: stderr_digest,
                            provenance_signer: request.sandbox.worker_id.clone()
                        }, &policy).unwrap()
                        return
                    }
                }
                Err(error) -> {
                    if error == RemoteCacheError.Io(io_error) && io_error.kind() == ErrorKind.NotFound && Instant.now() < deadline { thread.sleep(Duration.from_millis(2)) }
                    else { panic("remote retry worker could not read request: {error}") }
                }
            }
        }
    })
    execution := execute_build_plan_with_front_end_and_remote(&plan, &project_root, &grants, FrontEndCompletion.all_complete(), Val(&binding)).unwrap()
    worker.join().unwrap()
    assert(execution.report.events.iter().any(fn(event) {
        event == { BuildExecutionEvent.Finished { action: finished, outcome: ActionOutcome.Succeeded { exit_code: 0 } } -> finished == action.id(); _ -> false }
    }))
    assert_eq(fs.read(project_root.join("build/retried")).unwrap(), "retried output".as_bytes())
    cancellation_digest := ContentDigest.from_bytes(key.as_str().as_bytes())
    cancellation_hex := cancellation_digest.as_str().strip_prefix("sha256:").unwrap()
    assert(remote_root.join("execution/cancelled").join(&cancellation_hex[..2]).join(&cancellation_hex[2..]).is_file())
    _ :: fs.remove_dir_all(project_root)
}

// Rust: tests/build_graph.rs:1975
#Test("remote_execution_fails_over_to_registered_builder_after_worker_loss") {
    guard := REMOTE_HOST_ENV_LOCK.lock().unwrap()
    project_root := env.temp_dir().join("jet_remote_failover_{id()}_registered")
    _ :: fs.remove_dir_all(&project_root); fs.create_dir_all(&project_root).unwrap()
    config_root := project_root.join("config"); fast_root := project_root.join("fast-transport"); safe_root := project_root.join("safe-transport")
    fast_credential := project_root.join("fast.credential"); safe_credential := project_root.join("safe.credential")
    fs.write(&fast_credential, "fast-failover-key".as_bytes()).unwrap(); fs.write(&safe_credential, "safe-failover-key".as_bytes()).unwrap()
    previous_config := env.var_os("XDG_CONFIG_HOME"); env.set_var("XDG_CONFIG_HOME", &config_root)
    fast_name := "remote-fast-{id()}"; safe_name := "remote-safe-{id()}"
    fast := RemoteBuildBinding.bind_host(&fast_name, &fast_root, &fast_credential, "trusted", "worker-fast", "{selected_os()}-{selected_arch()}", "native", false, false, true, false, 1000).unwrap()
    safe := RemoteBuildBinding.bind_host(&safe_name, &safe_root, &safe_credential, "trusted", "worker-safe", "{selected_os()}-{selected_arch()}", "native", false, false, true, false, 1000).unwrap()
    b := BuildContext.new()
    action := b.action("remote-failover", ActionSpec.cached(["remote-tool"]).with_outputs(["build/failover"]).with_cap(BuildCapability.Net)).unwrap()
    target := b.add_executable("failover", TargetSpec.new().with_action(action)).unwrap()
    plan := b.plan_with_default(target).unwrap(); grants := [BuildCapability.Net].into_iter().collect()
    store := test_artifact_store(&project_root); snapshots := snapshot_declared_inputs(&store, &project_root, plan.action(action).unwrap()).unwrap()
    key := plan.effective_action_key(action, &snapshots, &grants, OSPath.new("remote-tool"), &ContentDigest.from_bytes("remote-tool".as_bytes()), &[]).unwrap()
    lost_key := key.clone(); lost_binding := fast.clone()
    lost_worker := thread.spawn(fn() {
        transport := RemoteCacheTransport.for_binding(&lost_binding).unwrap(); deadline := Instant.now() + Duration.from_secs(5)
        attempts: [String:Bool] = [:]
        loop {
            transport.read_execution_request(&lost_key) == {
                Ok(request) -> {
                    assert(Instant.now() < deadline, "lost worker did not observe both retry attempts")
                    attempts.insert(request.attempt_id, true)
                    if attempts.len() >= 2 { return }
                    thread.sleep(Duration.from_millis(40))
                }
                Err(error) -> {
                    if error == RemoteCacheError.Io(io_error) && io_error.kind() == ErrorKind.NotFound && Instant.now() < deadline { thread.sleep(Duration.from_millis(2)) }
                    else { panic("lost worker could not inspect request: {error}") }
                }
            }
        }
    })
    safe_key := key.clone(); safe_binding := safe.clone()
    safe_worker := thread.spawn(fn() {
        transport := RemoteCacheTransport.for_binding(&safe_binding).unwrap(); deadline := Instant.now() + Duration.from_secs(5)
        loop {
            transport.read_execution_request(&safe_key) == {
                Ok(request) -> {
                    policy := RemoteCachePolicy.with_grants(false, false, true, request.sandbox.clone())
                    bytes := "failover output".as_bytes(); digest := transport.upload_execution_blob(bytes, &policy).unwrap()
                    (stdout_digest, stderr_digest) := remote_empty_log_digests(&transport, &policy)
                    transport.publish_execution_result(&RemoteExecutionResult {
                        key: request.key.clone(), attempt_id: request.attempt_id.clone(), execution_id: remote_execution_identity(&request), outcome: ActionOutcome.Succeeded { exit_code: 0 },
                        outputs: [ActionOutputRecord { path: request.outputs[0].clone(), digest: digest, byte_len: bytes.len() as U64 }], toolchain_digest: request.toolchain_digest.clone(),
                        sandbox: request.sandbox.clone(), stdout_digest: stdout_digest, stderr_digest: stderr_digest, provenance_signer: request.sandbox.worker_id.clone()
                    }, &policy).unwrap()
                    return
                }
                Err(error) -> {
                    if error == RemoteCacheError.Io(io_error) && io_error.kind() == ErrorKind.NotFound && Instant.now() < deadline { thread.sleep(Duration.from_millis(2)) }
                    else { panic("failover worker could not inspect request: {error}") }
                }
            }
        }
    })
    execution := execute_build_plan_with_front_end_and_remote(&plan, &project_root, &grants, FrontEndCompletion.all_complete(), Val(&fast))
    lost_join := lost_worker.join(); safe_join := safe_worker.join()
    assert(RemoteBuildBinding.remove_host(&fast_name).is_ok()); assert(RemoteBuildBinding.remove_host(&safe_name).is_ok())
    previous_config == { Val(value) -> env.set_var("XDG_CONFIG_HOME", value); None -> env.remove_var("XDG_CONFIG_HOME") }
    assert(lost_join.is_ok(), "lost worker thread panicked"); assert(safe_join.is_ok(), "failover worker thread panicked")
    cancellation_digest := ContentDigest.from_bytes(key.as_str().as_bytes()); cancellation_hex := cancellation_digest.as_str().strip_prefix("sha256:").unwrap()
    assert(fast_root.join("execution/cancelled").join(&cancellation_hex[..2]).join(&cancellation_hex[2..]).is_file())
    execution := execution.unwrap()
    assert(execution.report.events.iter().any(fn(event) { event == { BuildExecutionEvent.Finished { action: finished, outcome: ActionOutcome.Succeeded { exit_code: 0 } } -> finished == action.id(); _ -> false } }))
    assert_eq(fs.read(project_root.join("build/failover")).unwrap(), "failover output".as_bytes())
    _ :: fs.remove_dir_all(project_root)
}

