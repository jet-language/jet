    _ :: fs.remove_dir_all(project_root)
}

// Rust: tests/build_graph.rs:2240
#Test("remote_execution_grant_carries_blobs_without_cache_authority") {
    root := env.temp_dir().join("jet_remote_execute_only_{id()}_roundtrip"); _ :: fs.remove_dir_all(&root)
    binding := RemoteBuildBinding.new("builder-execute-only", &root, "remote-test-key".as_bytes()).unwrap().with_trust_domain("trusted").with_worker_id("worker-execute-only").with_platform("linux-x86_64").with_abi("native")
    transport := RemoteCacheTransport.for_binding(&binding).unwrap(); key := ActionKey.new("execute-only")
    sandbox := transport.sandbox_proof("remote:builder-execute-only:trusted:sandbox-execute-only", "attempt-execute-only-1", key.as_str(), ContentDigest.from_bytes("toolchain".as_bytes())).unwrap()
    policy := RemoteCachePolicy.with_grants(false, false, true, sandbox.clone())
    input_digest := transport.upload_execution_blob("source".as_bytes(), &policy).unwrap()
    assert_eq(transport.download_execution_blob(&input_digest, &policy).unwrap(), "source".as_bytes())
    assert(transport.upload_blob("cache-forbidden".as_bytes(), &policy).is_err())
    input := ActionInputSnapshot { path: BuildPath.new("src/main.jet").unwrap(), digest: input_digest, byte_len: 6 }
    output_path := BuildPath.new("build/app").unwrap()
    request := RemoteExecutionRequest { key: key.clone(), attempt_id: sandbox.attempt_id.clone(), argv: ["jetc", "src/main.jet"], inputs: [input], outputs: [output_path.clone()], toolchain_digest: ContentDigest.from_bytes("toolchain".as_bytes()), sandbox: sandbox.clone() }
    transport.submit_execution(&request, &policy).unwrap(); assert_eq(transport.read_execution_request(&key).unwrap(), request)
    output_digest := transport.upload_execution_blob("compiled".as_bytes(), &policy).unwrap()
    (stdout_digest, stderr_digest) := remote_empty_log_digests(&transport, &policy)
    result := RemoteExecutionResult { key: key.clone(), attempt_id: request.attempt_id.clone(), execution_id: remote_execution_identity(&request), outcome: ActionOutcome.Succeeded { exit_code: 0 },
        outputs: [ActionOutputRecord { path: output_path, digest: output_digest, byte_len: 8 }], toolchain_digest: request.toolchain_digest.clone(), sandbox: sandbox.clone(), stdout_digest: stdout_digest, stderr_digest: stderr_digest, provenance_signer: sandbox.worker_id.clone() }
    transport.publish_execution_result(&result, &policy).unwrap(); assert_eq(transport.download_execution_result(&key, &policy).unwrap(), result)
    _ :: fs.remove_dir_all(&root)
}

// Rust: tests/build_graph.rs:2323
#Test("remote_transport_rejects_a_symlinked_store_root") {
    if selected_family() == "unix" {
        root := env.temp_dir().join("jet_remote_symlink_{id()}_root"); outside := root.with_extension("outside")
        _ :: fs.remove_file(&root); _ :: fs.remove_dir_all(&root); _ :: fs.remove_dir_all(&outside)
        fs.create_dir_all(&outside).unwrap(); fs.symlink(&outside, &root).unwrap()
        key := ActionKey.new("remote-symlink-key")
        binding := RemoteBuildBinding.new("builder-symlink", &root, "remote-test-key".as_bytes()).unwrap().with_trust_domain("trusted").with_worker_id("worker-symlink").with_platform("linux-x86_64").with_abi("native")
        transport := RemoteCacheTransport.for_binding(&binding).unwrap()
        policy := RemoteCachePolicy.granted(transport.sandbox_proof("remote:builder-symlink:trusted:symlink", "attempt-symlink-1", key.as_str(), ContentDigest.from_bytes("provenance".as_bytes())).unwrap())
        assert(transport.upload_blob("must not follow".as_bytes(), &policy) == { Err(RemoteCacheError.Io(_)) -> true; _ -> false })
        assert(!outside.join("cas").exists()); _ :: fs.remove_file(&root); _ :: fs.remove_dir_all(outside)
    }
}
