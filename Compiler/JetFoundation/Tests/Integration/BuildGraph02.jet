#Test("legacy_project_import_rejects_a_symlinked_canonical_file") {
    if selected_family() == "unix" {
        root := env.temp_dir().join("jet_legacy_import_symlink_{id()}_cargo"); outside := root.with_extension("outside")
        _ :: fs.remove_dir_all(&root); _ :: fs.remove_dir_all(&outside); fs.create_dir_all(&root).unwrap(); fs.create_dir_all(&outside).unwrap()
        fs.write(outside.join("Cargo.toml"), "[package]\nname = \"outside\"\n".as_bytes()).unwrap()
        fs.symlink(outside.join("Cargo.toml"), root.join("Cargo.toml")).unwrap()
        assert(LegacyWrapperSpec.from_project_file(&root, LegacyWrapperKind.Cargo) == { Err(BuildError.LegacyProjectFileInvalid(path)) -> path == "Cargo.toml"; _ -> false })
        _ :: fs.remove_file(root.join("Cargo.toml")); _ :: fs.remove_dir_all(&root); _ :: fs.remove_dir_all(outside)
    }
}

// Rust: tests/build_graph.rs:3091
#Test("wasm_build_plugins_handshake_grants_policy_and_return_plan_contributions") {
    b := BuildContext.new()
    plugin := WasmComponentPluginSpec.new("shader-tools", "1.2.0", "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa").with_capability(BuildCapability.FS).with_capability(BuildCapability.Exec)
    policy := BuildPolicy.allow_all().with_plugin_grant("shader-tools", BuildCapability.FS).with_plugin_grant("shader-tools", BuildCapability.Exec)
    contribution := PluginContribution.new().with_action("compile-shaders", ActionSpec.cached(["shaderc", "assets/main.glsl"]).with_inputs(["assets/main.glsl"]).with_outputs(["build/shaders.bin"]).with_cap(BuildCapability.FS).with_cap(BuildCapability.Exec))
        .with_target(TargetKind.Library, "shader-lib", TargetSpec.new().with_source(".jet/generated/shaders.jet"))
        .with_generated_module(GeneratedModuleSpec.new("shaders", ".jet/generated/shaders.jet", "fn shader_count() -[]> Int {{ return 1 }}"))
    applied := b.apply_wasm_component_plugin(plugin, contribution, &policy).unwrap(); plan := b.plan().unwrap()
    assert_eq(plan.plugins()[0].name, "shader-tools"); assert_eq(plan.plugins()[0].api_version, BUILD_PLUGIN_API_VERSION)
    assert_eq(plan.action(applied.actions[0]).unwrap().plugin, Val(applied.plugin)); assert_eq(plan.target(applied.targets[0]).unwrap().plugin, Val(applied.plugin))
    assert_eq(plan.generated_modules()[0].name, "shaders"); assert(plan.generated_modules()[0].source_digest.as_str().starts_with("sha256:"))
    generated := plan.explain_file(".jet/generated/shaders.jet")
    assert(generated.provenance.iter().any(fn(fact) { fact == "generated=shaders" })); assert(generated.provenance.iter().any(fn(fact) { fact.starts_with("digest=sha256:") }))
    denied := BuildContext.new().apply_wasm_component_plugin(WasmComponentPluginSpec.new("net-plugin", "1.0.0", "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb").with_capability(BuildCapability.Net), PluginContribution.new(), &BuildPolicy.allow_all()).unwrap_err()
    assert(denied == { BuildError.PolicyDenied(_) -> true; _ -> false })
    version_err := BuildContext.new().apply_wasm_component_plugin(WasmComponentPluginSpec.new("old-plugin", "0.1.0", "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc").with_api_version("jet.build.plugin.v0"), PluginContribution.new(), &BuildPolicy.allow_all()).unwrap_err()
    assert(version_err == { BuildError.PluginVersionMismatch { .. } -> true; _ -> false })
    contributed_cap_denied := BuildContext.new().apply_wasm_component_plugin(WasmComponentPluginSpec.new("net-plugin", "1.0.0", "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb").with_capability(BuildCapability.FS),
        PluginContribution.new().with_action("probe-network", ActionSpec.cached(["curl", "https://example.invalid"]).with_outputs(["build/net.txt"]).with_cap(BuildCapability.Net)),
        &BuildPolicy.allow_all().with_plugin_grant("net-plugin", BuildCapability.FS)).unwrap_err()
    assert(contributed_cap_denied == { BuildError.PolicyDenied(_) -> true; _ -> false })
}

// Rust: tests/build_graph.rs:3207
#Test("packaged_build_plugins_verify_bytes_and_roll_back_rejected_contributions") {
    root := env.temp_dir().join("jet_build_plugin_package_{id()}_{thread.current().name().unwrap_or("test")}")
    _ :: fs.remove_dir_all(&root); fs.create_dir_all(&root).unwrap()
    component: [U8] = [0, 97, 115, 109, 13, 0, 1, 0]
    digest := ContentDigest.from_bytes(&component); manifest := root.join("plugin.manifest"); component_path := root.join("plugin.wasm")
    fs.write(&manifest, "name = \"packaged\"\nversion = \"1.0.0\"\napi_version = \"{BUILD_PLUGIN_API_VERSION}\"\ncomponent_digest = \"{digest.as_str()}\"\ncapabilities = [\"FS\"]\n").unwrap()
    fs.write(&component_path, &component).unwrap()
    spec := WasmComponentPluginSpec.load_packaged(&manifest, &component_path).unwrap(); assert_eq(spec.component_digest, digest.as_str())
    invalid_component := "not a component".as_bytes(); invalid_manifest := root.join("invalid.manifest"); invalid_component_path := root.join("invalid.wasm")
    fs.write(&invalid_manifest, "name = \"invalid\"\nversion = \"1.0.0\"\napi_version = \"{BUILD_PLUGIN_API_VERSION}\"\ncomponent_digest = \"{ContentDigest.from_bytes(invalid_component).as_str()}\"\ncapabilities = []\n").unwrap()
    fs.write(&invalid_component_path, invalid_component).unwrap()
    invalid := WasmComponentPluginSpec.load_packaged(&invalid_manifest, &invalid_component_path).expect_err("digest-matching arbitrary bytes must not be a component")
    assert(invalid.contains("Component Model binary"), "{invalid}")
    policy := BuildPolicy.allow_all().with_plugin_grant("packaged", BuildCapability.FS)
    rejected := PluginContribution.new().with_action("partial-action", ActionSpec.cached(["tool"]).with_outputs(["build/out"]).with_cap(BuildCapability.FS))
        .with_generated_module(GeneratedModuleSpec.new("bad-module", "bad-module.jet", "fn bad() {{}}"))
    build := BuildContext.new()
    assert(build.apply_packaged_wasm_component_plugin(&manifest, &component_path, rejected, &policy) == { Err(BuildError.InvalidGeneratedModulePath(_)) -> true; _ -> false })
    assert(build.plan().unwrap().actions().is_empty()); assert(build.plan().unwrap().plugins().is_empty())
    accepted := PluginContribution.new().with_action("packaged-action", ActionSpec.cached(["tool"]).with_outputs(["build/packaged.out"]).with_cap(BuildCapability.FS))
    applied := build.apply_packaged_wasm_component_plugin(&manifest, &component_path, accepted, &policy).unwrap()
    assert_eq(applied.actions.len(), 1); assert_eq(build.plan().unwrap().plugins().len(), 1)
    fs.write(&component_path, "tampered".as_bytes()).unwrap(); assert(WasmComponentPluginSpec.load_packaged(&manifest, &component_path).is_err())
    _ :: fs.remove_dir_all(root)
}

// Rust: tests/build_graph.rs:3289
#Test("packaged_plugin_host_reads_are_bounded_and_reject_links") {
    if selected_family() == "unix" {
        root := env.temp_dir().join("jet_build_plugin_bounds_{id()}_hostile"); _ :: fs.remove_dir_all(&root); fs.create_dir_all(&root).unwrap()
        oversized := root.join("oversized.manifest"); fs.write(&oversized, Array<U8>.repeat(120, 65 * 1024)).unwrap()
        error := read_packaged_file_bounded(&oversized, "manifest", 64 * 1024).unwrap_err(); assert(error.contains("exceeds 65536"), "{error}")
        target := root.join("real.manifest"); fs.write(&target, "safe".as_bytes()).unwrap()
        link := root.join("linked.manifest"); fs.symlink(&target, &link).unwrap()
        error := read_packaged_file_bounded(&link, "manifest", 64 * 1024).unwrap_err(); assert(error.contains("regular non-symlink"), "{error}")
        _ :: fs.remove_dir_all(root)
    }
}

