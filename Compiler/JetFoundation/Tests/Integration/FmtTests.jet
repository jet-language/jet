use jet.[Package, Compiler, Lexer, Parser, Formatter, format_source, format_source_with_options, render_diagnostics]
use jet_foundation.Tests.Integration.Fmt.[collect_jet_files, assert_fmt_stable]
use jet_foundation.Tests.Integration.Common as common
use std.[fs, env, process]

// Rust: tests/fmt.rs:9
#Test("package_transition_surface_formats_canonically_and_idempotently") {
    sources := ["name: \"demo\"\noutputs: { app: .Executable{ entry: run } }\n", "pub development :: Config{ environments: { development: .Environment{ tools: [\"git\"] } } }\n", "pub app :: Config{ version: \"1\" }\n"]
    for source in sources {
        once := Package.format_source(source, "package.jet").expect("canonical package source should format")
        twice := Package.format_source(once, "package.jet").expect("formatted package source should reformat")
        assert_eq(once, twice, "canonical package formatting must be stable")
        assert(once.contains("Executable") || once.contains("Config"), "formatter dropped package contribution:\n{once}")
    }
    formatted := Package.format_source("name : \"demo\"\n", "package.jet").expect("package field spacing should format")
    assert(formatted.contains("name: \"demo\""), "{formatted}")
    assert(!formatted.contains("name :"), "{formatted}")
}
// Rust: tests/fmt.rs:35
#Test("package_cli_migrates_retired_record_heads_before_validation") {
    // GATE #4494: real CLI, scoped scratch and filesystem.
    scratch := common.Scratch.new("package-fmt-retired-record-heads")
    path := scratch.join("package.jet")
    fs.write(&path, "name: \"demo\"\nauthority: { holds: { allow: [IO] } }\n").unwrap()
    output := process.Command.new(common.jet_bin()).args(["fmt", path.to_str().unwrap()]).output().unwrap()
    assert(output.status.success(), "stderr:\n{String.from_utf8_lossy(&output.stderr)}")
    formatted := fs.read_to_string(path).unwrap()
    assert(formatted.contains("authority: {"), "{formatted}")
    assert(!formatted.contains(".{"), "{formatted}")
}
// Rust: tests/fmt.rs:59
#Test("type_alias_binding_sigils_are_canonical_and_idempotent") {
    source := "alias Result<T> :: T Int!;\nfn run() -> {}\n"
    once := format_source(source).expect("canonical alias spelling should format")
    assert(once.contains("alias Result<T> :: T Int!"), "{once}")
    assert(!once.contains("alias Result<T> ="), "{once}")
    twice := format_source(once).expect("canonical alias spelling should reformat")
    assert_eq(once, twice, "alias formatting must be idempotent")
}
// Rust: tests/fmt.rs:69
#Test("fmt_preserves_module_declaration_and_function_source_order") {
    source := "MESSAGE :: \"module global\"\n\nfn helper() -> Int {\n    return 42\n}\n\nfn run() -> {\n    print(MESSAGE)\n    print(helper())\n}\n"
    once := format_source(source).expect("module globals should format")
    message := once.find("MESSAGE ::").expect("module binding should remain")
    helper := once.find("fn helper").expect("declaration should remain")
    assert(message < helper, "formatter reordered source items:\n{once}")
    twice := format_source(once).expect("formatted source should reformat")
    assert_eq(once, twice, "module-global formatting must be idempotent")
}
// Rust: tests/fmt.rs:86
#Test("fmt_separates_core_functions_with_exactly_two_newlines") {
    source := "fn first() -> {}\n\n\n/// Documents the second function.\nfn second() -> {}\nfn third() -> {}\n"
    once := format_source(source).expect("core-style functions should format")
    assert(once.contains("}\n\n/// Documents the second function.\nfn second()"), "{once}")
    assert(once.contains("}\n\nfn third()"), "{once}")
    assert(!once.contains("}\n\n\n"), "{once}")
    assert_eq(once, format_source(once).expect("formatting should be idempotent"))
}
