}
// Rust: tests/fmt.rs:1246
#Test("fmt_simplify_keeps_a_routed_value_loop_binding") {
    options := Formatter.FormatOptions { simplify: true }
    source := "fn answer() -> Int {\n    return 42\n}\n\nfn search() -> Int {\n    values :: [Int]{1, 2, 3, 4}\n    first :: loop value in values {\n        if value > 2 { break value }\n    } ?? -1\n    return first\n}\n"
    plain := format_source(source).expect("a routed value loop should format")
    simplified := format_source_with_options(plain, options).expect("a routed value loop must not reach the identity assertion")
    assert(simplified.contains("fn answer() -> Int { 42 }"), "R1 did not fire ahead of the value loop, so nothing moved:\n{simplified}")
    tail := |text: String| -> {
        start := text.find("fn search").expect("the search fn survives fmt")
        text[start..].to_string()
    }
    assert_eq(tail(simplified), tail(plain), "simplify changed the routed value-loop binding:\n{simplified}")
    assert_eq(simplified, format_source_with_options(simplified, options).expect("second simplify pass should work"), "simplify output must be stable")
}
