// Rust: tests/fmt.rs:678
#Test("fmt_keeps_dispatch_return_arms_parseable_before_leading_dot_arms") {
    jet_foundation.CompilerStack.run_on_compiler_stack(|| -> {
        source := "fn run() -> {\n    if result == {\n        .Err(error) -> return error_result(error.message)\n        .Ok(value) -> {\n            if nested == {\n                .Err(error) -> return error_result(error.message)\n                .Ok(inner) -> print(inner)\n            }\n        }\n    }\n}\n"
        formatted := format_source(source).expect("dispatch return arms should format")
        assert(formatted.contains(".Err(error) -> return error_result(error.message)"), "direct return arm should stay canonical:\n{formatted}")
        (tokens, lex_diagnostics) := Lexer.lex(formatted)
        assert(lex_diagnostics.is_empty(), "{lex_diagnostics:?}")
        _ :: Parser.parse_for_fmt(&tokens).unwrap_or_else(|diagnostics| -> panic("fmt wrote source it cannot read:\n{formatted}\n{diagnostics:?}"))
        twice := format_source(formatted).expect("formatted dispatch should reformat")
        assert_eq(formatted, twice, "dispatch return-arm formatting must be idempotent")
    })
}
