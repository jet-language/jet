// Rust: tests/fmt.rs:155
#Test("checked_text_bodies_keep_raw_backslashes") {
    src := "fn run() -> {\n    pattern :: Pattern{\"\\d+\"}\n    text :: \"a\\nb\"\n    page :: Pattern{\"<p>{{name}}</p>\"}\n}\n"
    once := format_source(src).expect("checked text type should format")
    assert(once.contains("Pattern{\"\\d+\"}"), "formatter decoded a checked-text slash:\n{once}")
    assert(once.contains("\"a\\nb\""), "formatter lost the plain-string newline escape:\n{once}")
    assert(once.contains("{{name}}"), "formatter dropped a checked-text hole:\n{once}")
    twice := format_source(once).expect("checked text type should reformat")
    assert_eq(once, twice, "checked-text formatting must be idempotent")
}
