// Rust: tests/fmt.rs:1588
#Test("fmt_preserves_optional_result_variants") {
    src := "fn f(flag: Bool) -> Int String! {\n    maybe :: .Val(1)\n    empty :: .None\n    if maybe == {\n        .Val(n) -> { print(n) }\n        .None -> { print(0) }\n    }\n    if flag { return .Ok(1) }\n    return .Err(\"no\")\n}\n"
    once := format_source(src).expect("variant forms should format")
    for spelling in [".Val(1)", ".None", ".Val(n)", ".Ok(1)", ".Err(\"no\")"] { assert(once.contains(spelling), "formatter dropped `{spelling}`:\n{once}") }
    twice := format_source(once).expect("variant output should re-format")
    assert_eq(once, twice, "variant formatting must be idempotent")
}
// Rust: tests/fmt.rs:1612
#Test("fmt_canonicalizes_anonymous_union_types") {
    src := "fn hold(v: String | Int) -> Int | String {\n    return v\n}\nfn parse(raw: String) -> Int (String | Bool)! {\n    return .Err(false)\n}\n"
    once := format_source(src).expect("anonymous unions should format")
    assert(once.contains("Int | String"), "expected canonical union spelling, got:\n{once}")
    assert(once.contains("Int (Bool | String)!"), "expected fallible error-side union, got:\n{once}")
    twice := format_source(once).expect("union fmt must be idempotent")
    assert_eq(once, twice, "anonymous union formatting must be idempotent")
}
