// Rust: tests/fmt.rs:238
#Test("fmt_canonicalizes_unit_return_types") {
    src := "fn run() -> Err! { return Err(\"boom\") }\n"
    once := format_source(src).expect("unit return type should format")
    assert(once.contains("fn run() -> Err!"), "formatter lost the unit-fallible return:\n{once}")
    twice := format_source(once).expect("formatted unit return should re-format")
    assert_eq(once, twice, "unit return formatting must be idempotent")
    assert(format_source("fn run() ? { return Err(\"boom\") }\n").is_err(), "retired bare unit-fallible spelling must not be accepted by the formatter")
    assert(format_source("fn run() => Void ! { return Err(\"boom\") }\n").is_err(), "retired Void must not be accepted by the formatter")
}
// Rust: tests/fmt.rs:258
#Test("fmt_parallel_collection_adapters_are_stable") {
    src := "fn run() -> {\n    values := [1, 2, 3, 4]\n    doubled :: values.para_map((n: Int) -> n * 2)\n    even :: values.para_filter((n: Int) -> n % 2 == 0)\n    split :: values.para_partition((n: Int) -> n % 2 == 0)\n    total :: values.para_fold(() -> 0, (acc: Int, n: Int) -> acc + n, (left: Int, right: Int) -> left + right)\n}\n"
    once := format_source(src).expect("parallel collection adapters should format")
    for spelling in ["para_map", "para_filter", "para_partition", "para_fold"] { assert(once.contains(spelling), "formatter dropped `{spelling}`:\n{once}") }
    twice := format_source(once).expect("formatted parallel adapters should parse")
    assert_eq(once, twice, "parallel adapter formatting must be stable")
}
