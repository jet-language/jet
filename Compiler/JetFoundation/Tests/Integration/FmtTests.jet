// Rust: tests/fmt.rs:1334
#Test("parser_rejects_arrowless_value_callable_and_offers_insertion_fix") {
    // E0080 now inserts the sole signature arrow, not a second body arrow.
    source := "fn value() Int { return 1 }\n"
    (tokens, lex_diagnostics) := Lexer.lex(source)
    assert(lex_diagnostics.is_empty(), "{lex_diagnostics:?}")
    diagnostics := Parser.parse(&tokens).expect_err("the signature arrow is required")
    diagnostic := diagnostics.iter().find(|diagnostic| -> diagnostic.code == "E0080").expect("missing callable signature arrow diagnostic")
    assert_eq(diagnostic.edit.as_ref().map(|edit| -> edit.new_text), Some("-> "))
    (canonical_tokens, canonical_lex_diagnostics) := Lexer.lex("fn value() -> Int { return 1 }\n")
    assert(canonical_lex_diagnostics.is_empty(), "{canonical_lex_diagnostics:?}")
    _ :: Parser.parse(&canonical_tokens).expect("the canonical signature arrow should parse")
}
