// Rust: tests/fmt.rs:1158
#Test("fmt_simplify_one_line_return_is_ast_equal_and_stable") {
    source := "fn answer() -> Int {\n    return 42\n}\n"
    plain := format_source(source).expect("plain fmt should format")
    assert(plain.contains("fn answer() -> Int { return 42 }"), "{plain}")
    assert(!plain.contains(":: 42"), "plain fmt must not simplify:\n{plain}")
    options := Formatter.FormatOptions { simplify: true }
    once := format_source_with_options(source, options).expect("simplify fmt should format")
    // ONE-arrow owner ruling: simplify removes return but retains a braced body.
    assert_eq(once, "fn answer() -> Int { 42 }\n")
    (before_tokens, before_lex_diags) := Lexer.lex(source)
    assert(before_lex_diags.is_empty(), "{before_lex_diags:?}")
    before := Parser.parse_for_fmt(&before_tokens).expect("source should parse")
    (after_tokens, after_lex_diags) := Lexer.lex(once)
    assert(after_lex_diags.is_empty(), "{after_lex_diags:?}")
    after := Parser.parse_for_fmt(&after_tokens).expect("simplified source should parse")
    assert_eq(Formatter.canonical_program(&before), Formatter.canonical_program(&after), "simplify must preserve the parsed AST")
    assert_eq(once, format_source_with_options(once, options).expect("second simplify pass should work"))
    wide_name := "wide_value".repeat(12)
    wide := "fn wide() -> Int {{ return {wide_name} }}\n"
    wide_out := format_source_with_options(wide, options).expect("wide simplify input should format")
    assert(!wide_out.contains(" :: "), "wide bodies must stay braced:\n{wide_out}")
    commented := "fn noted() -> Int {\n    // keep this note\n    return 42\n}\n"
    commented_out := format_source_with_options(commented, options).expect("commented simplify input should format")
    assert(!commented_out.contains(" :: 42"), "commented bodies must stay braced:\n{commented_out}")
    nested_commented := "fn noted() -> Point {\n    return Point{x: 1, y: 2} // keep this note\n}\n"
    nested_commented_out := format_source_with_options(nested_commented, options).expect("nested commented simplify input should format")
    assert(!nested_commented_out.contains(" :: "), "comments after nested literals must keep bodies braced:\n{nested_commented_out}")
    assert(nested_commented_out.contains("// keep this note"), "nested literal comment was lost:\n{nested_commented_out}")
}
