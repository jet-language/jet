// Rust: tests/fmt.rs:1511
#Test("fmt_is_idempotent_on_ui_fixes") {
    root := OSPath(env.manifest_dir())
    ui := root.join("tests/ui")
    for entry in fs.read_dir(&ui).unwrap() {
        path := entry.unwrap().path()
        if path.file_name().and_then(|n| -> n.to_str()).is_some_and(|n| -> n.ends_with(".fixed.jet")) {
            src := fs.read_to_string(&path).unwrap()
            once := format_source(src).unwrap_or_else(|d| -> panic("fmt failed on {path.display()}:\n{render_diagnostics(path.display().to_string(), src, &d)}"))
            twice := format_source(once).expect("second fmt should succeed")
            assert_eq(once, twice, "fmt is not idempotent on {path.display()}")
        }
    }
}
