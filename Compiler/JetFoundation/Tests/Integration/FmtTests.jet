    parsed := Compiler.parse_source(src)
    assert(parsed.diagnostics.iter().any(|diagnostic| -> diagnostic.code == "E0003"), "retired annotated binding must remain an ordinary parse error: {parsed.diagnostics:?}")
    assert(format_source(src).is_err(), "formatter must reject the parser-invalid retired annotated binding")
