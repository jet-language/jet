// Rust: tests/fmt.rs:202
#Test("fmt_migrates_each_retired_print_spelling_to_one_canonical_job") {
    source := "use core.term as io\n\nfn run() -> {\n    io.println(\"line\")\n    value :: \"value\"\n    io.sprint(value)\n    io.repr(value)\n}\n"
    edits := Formatter.retired_print_family_edits(source)
    assert_eq(edits.len(), 3, "one migration edit per retired spelling")
    once := format_source(source).expect("retired print family should format")
    assert_eq(once, "use core.term as io\n\nfn run() -> {\n    io.print(\"line\")\n    value :: \"value\"\n    print(\"{{value}}\")\n    print(\"{{value:Debug}}\")\n}\n")
    assert(Formatter.retired_print_family_edits(once).is_empty())
    assert_eq(format_source(once).expect("canonical print family should reformat"), once)
}
