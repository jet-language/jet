// Rust: tests/unit_family.rs:1693
#Test("dimension_exponent_limit_is_a_sema_error_not_a_panic") {
    src := "#UnitFamily(Length, dimension) { meter }\nfn run() -> {\n    q0 :: 1meter\n"
    loop exponent in 1..=31 {
        previous := exponent - 1
        src.push_str("    q{exponent} :: q{previous} * q{previous}\n")
    }
    src.push_str("}\n")
    result := panic.catch_unwind(() -> compile(src))
    diagnostics := result.expect("checked dimension overflow must not panic").expect_err("2^31 Length exponent must be rejected in sema")
    assert(diagnostics.iter().any(d -> d.code == "E0359"))
}
