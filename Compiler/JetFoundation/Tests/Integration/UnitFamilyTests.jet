#Test("quantities_display_units_styles_and_explicit_overrides") {
    defaults := """
#UnitFamily(Length, dimension, base: meter) { meter px(scale: 1) }
#UnitFamily(Currency) { usd }
fn run() -> {
    distance :: 12meter
    elapsed :: 3s
    speed :: distance / elapsed
    pixels :: 766px
    price :: 5usd
    print(distance)
    print("{speed}")
    print(pixels)
    print(price)
    print("{distance:Unit(name)}")
    print("{distance:Unit(bare)}")
    print(distance.raw())
}
"""
    (code, stdout) := tiers.build_and_run("quantity_display_defaults", defaults)
    assert_eq(code, 0)
    assert_eq(stdout, "12 meter\n4 meter/ns\n766 px\n5 usd\n12 Meter\n12\n12.0\n")
    tiers.assert_tiers_agree("quantity_display_tiers", defaults, "12 meter\n4 meter/ns\n766 px\n5 usd\n12 Meter\n12\n12.0\n")
    explicit := """
#UnitFamily(Length, dimension, base: meter) { meter }
impl Meter.Display {
    fn display(self) -> String { "custom length" }
}
fn run() -> {
    distance :: 12meter
    print(distance)
    print("{distance}")
    print("{distance:Unit(bare)}")
}
"""
    (code, stdout) := tiers.build_and_run("quantity_display_override", explicit)
    assert_eq(code, 0)
    assert_eq(stdout, "custom length\ncustom length\n12\n")
    dir := common.unique_tmp("quantity_display_override_parity")
    fs.create_dir_all(dir).unwrap()
    path := dir.join("main.jet")
    fs.write(path, explicit).unwrap()
    bundle := load_entry(path.to_str().unwrap()).unwrap()
    diagnostics := check_bundle(&bundle, CompileMode.Run)
    assert(diagnostics.is_empty(), "{diagnostics:?}")
    tiers.assert_tiers_agree("quantity_display_override_parity", explicit, "custom length\ncustom length\n12\n")
    web_src := """
#Target(Web)
#UnitFamily(Length, dimension, base: meter) { meter }
impl Meter.Display {
    fn display(self) -> String { "custom length" }
}
fn show(distance: Meter) -> {
    print(distance)
    print("{distance}")
}
fn run() -> {}
"""
    web := compile_web_with_path(web_src, "quantity_display_override_web.jet").expect("custom unit Display must compile through the web backend").web.expect("web compilation must produce artifacts")
    wasm_dir := common.unique_tmp("quantity_display_override_web_wasm")
    fs.create_dir_all(wasm_dir).unwrap()
    wasm_rust := wasm_dir.join("app_wasm.rs")
    wasm_bin := wasm_dir.join("app.wasm")
    fs.write(wasm_rust, web.wasm_rust).unwrap()
    rustc := Command.new("rustc").args(["--edition", "2021", "--target", "wasm32-unknown-unknown", "--crate-type", "cdylib", "-O"]).arg(wasm_rust).arg("-o").arg(wasm_bin).output().expect("run rustc for custom unit Display web output")
    assert(rustc.status.success(), "rustc rejected custom unit Display web output:\n{String.from_utf8_lossy(rustc.stderr)}")
    assert(wasm_bin.is_file(), "web build did not produce a Wasm artifact")
}
