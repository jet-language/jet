// Rust: tests/unit_family.rs:382
#Test("zero_ratio_denominator_points_at_the_denominator") {
    src := "#UnitFamily(Length, dimension, base: meter) { meter broken(scale: 1/0) }"
    (tokens, lex) := Lexer.lex(src)
    assert(lex.is_empty(), "lex diagnostics: {lex:?}")
    diagnostics := Parser.parse(tokens).unwrap_err()
    diagnostic := diagnostics.iter().find(d -> d.what.contains("denominator is zero")).expect("zero-denominator diagnostic")
    zero := src.rfind('0').unwrap()
    assert_eq(diagnostic.span, Some(Span.new(zero, zero + 1)))
}
