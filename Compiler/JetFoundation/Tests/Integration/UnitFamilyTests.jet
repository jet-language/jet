// Rust: tests/unit_family.rs:1551
#Test("imported_public_units_keep_display_metadata_across_tiers") {
    units := """
pub #UnitFamily(Length, dimension, base: meter) { meter }
impl Meter.Display {
    fn display(self) -> String { "defined in units" }
}
pub fn distance() -> Meter { return 12meter }
"""
    main := """
use "measurements" as units
struct Nested { values: [[units.Meter]] }
fn run() -> {
    distance :: units.distance()
    print(distance)
    print("{distance}")
    print("{distance:Unit(name)}")
    print("{distance:Unit(bare)}")
}
"""
    expected := "defined in units\ndefined in units\n12 Meter\n12\n"
    files := [("measurements.jet", units), ("main.jet", main)]
    if tiers.have_rustc() {
        (code, stdout) := tiers.build_and_run_multi("imported_unit_display", "main.jet", files)
        assert_eq(code, 0)
        assert_eq(stdout, expected)
    }
    dir := common.unique_tmp("imported_unit_display_tiers")
    fs.create_dir_all(dir).unwrap()
    fs.write(dir.join("measurements.jet"), units).unwrap()
    entry := dir.join("main.jet")
    fs.write(entry, main).unwrap()
    bundle := load_entry(entry.to_str().unwrap()).unwrap()
    diagnostics := check_bundle(&bundle, CompileMode.Run)
    assert(diagnostics.is_empty(), "{diagnostics:?}")
    (code, stdout, stderr) := tiers.run_default_multi("imported_unit_display", "main.jet", files)
    assert_eq(code, 0, "{stderr}")
    assert_eq(stdout, expected)
    (code, stdout, stderr) := tiers.run_interpret_multi("imported_unit_display", "main.jet", files)
    assert_eq(code, 0, "{stderr}")
    assert_eq(stdout, expected)
    web_units := """
pub #UnitFamily(Length, dimension, base: meter) { meter }
impl Meter.Display {
    fn display(self) -> String { "defined in units" }
}
"""
    web_main := """
#Target(Web)
use "web_units" as units
fn show(distance: units.Meter) -> {
    print(distance)
    print("{distance}")
}
fn run() -> {}
"""
    fs.write(dir.join("web_units.jet"), web_units).unwrap()
    web_entry := dir.join("web.jet")
    fs.write(web_entry, web_main).unwrap()
    web := compile_web(web_entry.to_str().unwrap()).expect("imported unit display must compile for web").web.expect("web compilation must produce artifacts")
    assert(web.wasm_rust.contains("defined in units"), "web output must retain the defining module's Display implementation")
    wasm_rust := dir.join("imported_unit_app_wasm.rs")
    wasm_bin := dir.join("imported_unit_app.wasm")
    fs.write(wasm_rust, web.wasm_rust).unwrap()
    rustc := Command.new("rustc").args(["--edition", "2021", "--target", "wasm32-unknown-unknown", "--crate-type", "cdylib", "-O"]).arg(wasm_rust).arg("-o").arg(wasm_bin).output().expect("run rustc for imported unit Display web output")
    assert(rustc.status.success(), "rustc rejected imported unit Display web output:\n{String.from_utf8_lossy(rustc.stderr)}")
    assert(wasm_bin.is_file(), "web build did not produce a Wasm artifact")
}
