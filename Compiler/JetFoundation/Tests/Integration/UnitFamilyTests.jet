// Rust: tests/unit_family.rs:991
#Test("quantity_generic_bounds_are_frozen_into_public_api_identity") {
    parse := src -> {
        (tokens, diagnostics) := Lexer.lex(src)
        assert(diagnostics.is_empty())
        Parser.parse(tokens).expect("public Quantity generic should parse")
    }
    length := parse("pub fn keep<Q: Quantity<Length, .Linear>>(value: ^Q) -> Q { return value }")
    time := parse("pub fn keep<Q: Quantity<Time, .Linear>>(value: ^Q) -> Q { return value }")
    length := snapshot_from_items(length.items, "units", "1.0.0")
    time := snapshot_from_items(time.items, "units", "1.0.0")
    assert_eq(length.funcs[0].signature, "fn keep<Q: Quantity<Length, .Linear>>(value: ^Q) Q")
    assert_ne(length.funcs[0].signature, time.funcs[0].signature)
    old := [ApiItem{kind: "fn", name: "keep", signature: length.funcs[0].signature.clone()}]
    new := [ApiItem{kind: "fn", name: "keep", signature: time.funcs[0].signature.clone()}]
    assert_eq(diff_public_api(old, new).len(), 1)
}
