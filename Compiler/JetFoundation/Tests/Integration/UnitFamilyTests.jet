#Test("explicit_units_policy_requires_destination_owned_conversion") {
    implicit := """
#UnitFamily(Length, dimension, base: meter) { meter millimeter(scale: 1/1000) }
#Policy(explicit_units)
fn run() -> {
    total :: 1meter + 1millimeter
    print("{(total.raw())}")
}
"""
    assert_eq(codes_of(implicit), ["E0127"])
    explicit := """
#UnitFamily(Length, dimension, base: meter) { meter millimeter(scale: 1/1000) }
#Policy(explicit_units)
fn run() -> {
    converted :: Meter.from_millimeter(1000millimeter) ?? panic("exact conversion")
    total :: 1meter + converted
    print("{(total.raw())}")
}
"""
    assert(codes_of(explicit).is_empty())
    module_scoped := """
#Policy(explicit_units)
#UnitFamily(Length, dimension, base: meter) { meter millimeter(scale: 1/1000) }
fn run() -> {
    total :: 1meter + 1millimeter
    print(total.raw())
}
"""
    assert_eq(codes_of(module_scoped), ["E0127"])
    block_scoped := """
#UnitFamily(Length, dimension, base: meter) { meter millimeter(scale: 1/1000) }
fn run() -> {
    #Policy(explicit_units) {
        total :: 1meter + 1millimeter
        print(total.raw())
    }
}
"""
    assert_eq(codes_of(block_scoped), ["E0127"])
}
