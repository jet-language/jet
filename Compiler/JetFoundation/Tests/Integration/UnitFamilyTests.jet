// Rust: tests/unit_family.rs:1907
#Test("standard_units_share_canonical_owner_across_dependency_boundary") {
    root := common.unique_tmp("standard_unit_dependency")
    app := root.join("app")
    dep := root.join("dep")
    fs.create_dir_all(app).unwrap()
    fs.create_dir_all(dep).unwrap()
    fs.write(app.join("package.jet"), "name: \"app\"\nversion: \"0.1.0\"\ndeps: { dep: ../dep }\n").unwrap()
    fs.write(app.join("main.jet"), "use dep\npub fn local() -> Meter { return 1meter }\nfn accept(value: Meter) -> { print(value.raw()) }\nfn run() -> { accept(dep.distance()) }\n").unwrap()
    fs.write(dep.join("package.jet"), "name: \"dep\"\nversion: \"0.1.0\"\n").unwrap()
    fs.write(dep.join("dep.jet"), "pub fn distance() -> Meter { return 2meter }\n").unwrap()
    bundle := load_entry(app.join("main.jet").to_str().unwrap()).unwrap()
    diagnostics := check_bundle(&bundle, CompileMode.Run)
    assert(diagnostics.is_empty(), "ordinary Prelude units have one owner across packages: {diagnostics:?}")
    loop module in bundle.modules {
        snapshot := snapshot_from_items(module.items, module.alias, "0.1.0")
        loop function in snapshot.funcs {
            if function.name == "local" || function.name == "distance" {
                assert(function.signature.contains("package=core.units; family=Length"), "checked standard-unit API identity must use its semantic owner: {function.signature}")
            }
        }
    }
}
// Rust: tests/unit_family.rs:1957
#Test("qualified_imported_dimensions_resolve_by_alias_and_unqualified_collisions_fail") {
    root := common.unique_tmp("qualified_dimensions")
    fs.create_dir_all(root).unwrap()
    fs.write(root.join("stock.jet"), "pub #UnitFamily(Inventory, dimension, base: item) { item }\n").unwrap()
    fs.write(root.join("other.jet"), "pub #UnitFamily(Inventory, dimension, base: widget) { widget }\n").unwrap()
    qualified := root.join("qualified.jet")
    fs.write(qualified, "use \"stock\" as dep\n#UnitFamily(Rate, dimension: dep.Inventory / Time, base: item_per_second) { item_per_second }\nfn run() -> {}\n").unwrap()
    qualified_diagnostics := check_with_path(qualified.to_string_lossy())
    assert(qualified_diagnostics.is_empty(), "qualified dimensions must resolve through the written alias: {qualified_diagnostics:?}")
    ambiguous := root.join("ambiguous.jet")
    fs.write(ambiguous, "use \"stock\" as stock\nuse \"other\" as other\n#UnitFamily(Rate, dimension: Inventory / Time, base: item_per_second) { item_per_second }\nfn run() -> {}\n").unwrap()
    diagnostics := check_with_path(ambiguous.to_string_lossy())
    assert_eq(diagnostics.iter().map(d -> d.code.as_str()).collect(), ["E0905"], "an unqualified collision must not depend on import order: {diagnostics:?}")
    assert(diagnostics[0].what.contains("ambiguous"), "the collision needs a specific ambiguity diagnostic: {diagnostics:?}")
}
// Rust: tests/unit_family.rs:2004
#Test("custom_axis_identity_ignores_checkout_root_and_separates_packages") {
    scratch := common.unique_tmp("stable_unit_axis")
    first := resolved_axis(scratch.join("checkout-a"), "warehouse")
    second := resolved_axis(scratch.join("checkout-b"), "warehouse")
    distinct := resolved_axis(scratch.join("checkout-c"), "ledger")
    assert_eq(first.0, second.0, "checkout roots are not semantic identity")
    assert_eq(first.1, second.1, "API identity must ignore checkout roots")
    assert_ne(first.0, distinct.0, "distinct package metadata must not collide")
    assert_ne(first.1, distinct.1, "distinct package APIs must not collide")
    assert(!first.0.identity().contains(scratch.to_string_lossy()), "serialized dimension identity must not expose a checkout path")
}
// Rust: tests/unit_family.rs:2068
#Test("linear_units_and_affine_deltas_scale_without_losing_family") {
    src := """
#UnitFamily(Length, dimension, base: meter) { meter }
#UnitFamily(MeasureTag, base: tick) { tick }
#UnitFamily(Temperature, dimension, base: kelvin) {
    kelvin
    celsius(scale: 1, offset: 27315/100)
}
fn run() -> {
    length :: 3meter
    quantity :: 2
    right_int_binding :: length * quantity
    left_int_binding :: quantity * length
    float_quantity :: Float.from_int(quantity)
    right_float_binding :: length * float_quantity
    left_float_binding :: float_quantity * length
    signed_quantity :: I32{2}
    narrow_signed_quantity :: I8{2}
    unsigned_quantity :: U8{2}
    float32_quantity :: F32{2.0}
    right_i32_binding :: length * signed_quantity
    right_i8_binding :: length * narrow_signed_quantity
    left_u8_binding :: unsigned_quantity * length
    right_f32_binding :: length / float32_quantity
    right_int :: length * 2
    left_int :: 2 * length
    quotient :: length / 2
    right_decimal :: length * 1.5
    left_decimal :: 1.5 * length
    negative :: length * -2
    zero :: length * 0
    overflow :: length * 1.0e308
    zero_division :: length / 0
    tick_value :: 4tick
    tick_scaled :: tick_value * 2
    delta :: CelsiusDelta.from_float(Float{5.0})
    delta_right :: delta * 2
    delta_left :: 2 * delta
    delta_quotient :: delta / 2
    print("{(right_int_binding.raw())} {(left_int_binding.raw())}")
    print("{(right_float_binding.raw())} {(left_float_binding.raw())}")
    print("{(right_i32_binding.raw())} {(right_i8_binding.raw())} {(left_u8_binding.raw())} {(right_f32_binding.raw())}")
    print("{(right_int.raw())} {(left_int.raw())} {(quotient.raw())}")
    print("{(right_decimal.raw())} {(left_decimal.raw())} {(negative.raw())}")
    print("{(zero.raw())} {(overflow.raw())} {(zero_division.raw())}")
    print("{(delta_right.raw())} {(delta_left.raw())} {(delta_quotient.raw())}")
    print("{(tick_scaled.raw())}")
}
"""
    tiers.assert_tiers_agree("linear_unit_scalar_scaling", src, "6.0 6.0\n6.0 6.0\n6.0 6.0 6.0 1.5\n6.0 6.0 1.5\n4.5 4.5 -6.0\n0.0 inf inf\n10.0 10.0 2.5\n8.0\n")
}
// Rust: tests/unit_family.rs:2126
#Test("scalar_unit_boundaries_and_nominal_currency_stay_rejected") {
    affine := """
#UnitFamily(Temperature, dimension, base: kelvin) { kelvin celsius(scale: 1, offset: 27315/100) }
fn run() -> {
    point :: CelsiusPoint.from_float(Float{20.0})
    bad :: point * 2
}
"""
    assert_eq(codes_of(affine), ["E0109"])
    affine_product := """
#UnitFamily(Temperature, dimension, base: kelvin) { kelvin celsius(scale: 1, offset: 27315/100) }
fn run() -> {
    point :: CelsiusPoint.from_float(Float{20.0})
    bad :: point * point
}
"""
    assert_eq(codes_of(affine_product), ["E0127"])
    inverse := """
#UnitFamily(Length, dimension, base: meter) { meter }
fn run() -> {
    bad :: 2 / 1meter
    bad_float :: 2.0 / 1meter
}
"""
    assert_eq(codes_of(inverse), ["E0109", "E0109"])
    unsupported := """
#UnitFamily(Length, dimension, base: meter) { meter }
fn run() -> { bad :: 1meter * true }
"""
    assert_eq(codes_of(unsupported), ["E0109"])
    decimal := """
#UnitFamily(Length, dimension, base: meter) { meter }
fn run() -> {
    scale :: 1.5
    bad :: 1meter * scale
}
"""
    assert_eq(codes_of(decimal), ["E0109"])
    incompatible := """
#UnitFamily(Length, dimension, base: meter) { meter }
#UnitFamily(Mass, dimension, base: gram) { gram }
fn run() -> { bad :: 1meter + 1gram }
"""
    assert_eq(codes_of(incompatible), ["E0359"])
    currency := """
#UnitFamily(Currency) { usd eur }
fn run() -> {
    price :: Usd.from_float(Float{2.0})
    bad :: price * 2
}
"""
    assert_eq(codes_of(currency), ["E0127"])
    nominal_units := """
#UnitFamily(Currency) { usd eur }
fn run() -> {
    left :: Usd.from_float(Float{2.0})
    right :: Eur.from_float(Float{3.0})
    bad :: left * right
}
"""
    assert_eq(codes_of(nominal_units), ["E0127"])
}
// Rust: tests/unit_family.rs:2207
#Test("unit_scalar_rewrap_lint_requires_the_direct_policy_free_identity") {
    src := """
#UnitFamily(Length, base: meter) {
    meter
    half(scale: 1/2)
}
#UnitFamily(Temperature, base: kelvin) {
    kelvin
    celsius(scale: 1, offset: 27315/100)
}
fn external_scale(value: Float) -> Float { calibrate(value) }
fn calibrate(value: Float) -> Float { value * 2 }
fn run() -> {
    value :: Meter.from_float(Float{4.0})
    print(Meter.from_float(value.raw() * 2).raw())
    print(Meter.from_float(value.raw() * calibrate(2.0)).raw())
    print(Meter.from_float(value.raw() * external_scale(2.0)).raw())
    print(Meter.from_float(value.raw() * Float.from_float(calibrate(2.0))).raw())
    print(Meter.from_float(value.raw() * Float.from_float(external_scale(2.0))).raw())
    rounded :: Meter.from_half_rounded(1half, .NearestEven, digits: 0) ?? Meter.from_float(Float{0.0})
    print(rounded.raw())
    point :: CelsiusPoint.from_float(Float{20.0})
    print(CelsiusPoint.from_float(point.raw() * 2).raw())
    #Arithmetic(.Wrapping) {
        print(Meter.from_float(value.raw() * 2).raw())
    }
}
"""
    output := compile(src).expect("lint identity fixture should compile")
    unit_lints := output.lints.iter().filter(lint -> lint.code == "L0519").collect()
    assert_eq(unit_lints.len(), 1, "only the direct policy-free identity should warn: {output.lints:?}")
}
