// Rust: tests/unit_family.rs:132
#Test("derived_dimension_requires_one_scale_one_anchor") {
    src := "#UnitFamily(Energy, dimension: Force * Length) { joule }"
    (tokens, diagnostics) := Lexer.lex(src)
    assert(diagnostics.is_empty(), "lex diagnostics: {diagnostics:?}")
    diagnostics := Parser.parse(tokens).expect_err("a derived dimension needs `base:`")
    assert_eq(diagnostics.iter().map(d -> d.code.as_str()).collect(), ["E0003"])
    assert_eq(diagnostics[0].fix, "Add `base: member_name` and keep that member's scale at 1 with offset 0")
}
// Rust: tests/unit_family.rs:151
#Test("scale_provenance_parses_without_erasing_source_truth") {
    angle := parse_family("#UnitFamily(Angle, dimension, base: radian) { radian degree(scale: pi / 180) }")
    assert(angle.members[1].scale_provenance is .SymbolicPi(_))
    mass := parse_family("""
#UnitFamily(Mass, dimension, base: kilogram) {
    kilogram
    dalton(scale: measured(1.66053906892e-27, uncertainty: 0.00000000052e-27, source: "BIPM-2026/CODATA-2022"))
}
""")
    assert(mass.members[1].scale_provenance is .Measured(_))
}
// Rust: tests/unit_family.rs:173
#Test("symbolic_and_measured_standard_scales_keep_one_explicit_boundary") {
    symbolic := "fn accept(value: Radian) -> {}\nfn run() -> { accept(1degree) }\n"
    assert(codes_of(symbolic).is_empty(), "symbolic pi conversions should use the ordinary conversion path")
    measured := """
fn run() -> {
    mass :: Kilogram.from_dalton_rounded(1dalton, .NearestEven, digits: 30) ?? panic("rounded measured conversion")
    print(mass.value())
    print(mass.uncertainty())
}
"""
    assert(codes_of(measured).is_empty(), "a rounded measured-scale conversion must return a measured value")
}
// Rust: tests/unit_family.rs:197
#Test("measure_rules_cover_fixed_lengths_and_matrix_shapes") {
    lengths := """
fn join(left: [Int#2], right: [Int#3]) -> [Int#5] { return left.concat(right) }
fn run() -> {}
"""
    length_codes := codes_of(lengths)
    assert(length_codes.is_empty(), "fixed-list join must add the two length measures, got {length_codes:?}")
    matrices := """
fn compose(left: Matrix<3, 4>, right: Matrix<4, 2>) -> Matrix<3, 2> ComputeError! { return left * right }
fn run() -> {}
"""
    matrix_codes := codes_of(matrices)
    assert(matrix_codes.is_empty(), "matrix multiplication must match inner measures and compose outer measures, got {matrix_codes:?}")
}
// Rust: tests/unit_family.rs:230
#Test("poundforce_uses_the_exact_defined_ratio_across_execution_tiers") {
    src := """
fn run() -> {
    force :: Newton.from_poundforce(10000000000000poundforce) ?? panic("defined force conversion")
    print(force.raw())
}
"""
    assert(fs.read_to_string("crates/jet-codegen/src/Prelude/Units.jet").unwrap().contains("poundforce(scale: 44482216152605/10000000000000)"), "the standard unit declaration lost the exact defined pound-force ratio")
    _ :: compile(src).expect("standard force conversion should compile")
    (code, stdout, stderr) := tiers.build_and_run_full("jet_unit_family", "standard_force_ratio", src)
    assert_eq((code, stdout.as_str()), (0, "44482216152605.0\n"), "{stderr}")
    dir := common.unique_tmp("standard_force_ratio_tiers")
    fs.create_dir_all(dir).unwrap()
    entry := dir.join("main.jet")
    fs.write(entry, src).unwrap()
    bundle := load_entry(entry.to_str().unwrap()).unwrap()
    diagnostics := check_bundle(&bundle, CompileMode.Run)
    assert(diagnostics.is_empty(), "{diagnostics:?}")
    tiers.assert_tiers_agree("standard_force_ratio_tiers", src, "44482216152605.0\n")
    _ :: fs.remove_dir_all(dir)
}
// Rust: tests/unit_family.rs:282
#Test("user_dimensions_compose_and_named_derived_units_share_the_structure") {
    src := """
#UnitFamily(Mass, dimension, base: kilogram) { kilogram }
#UnitFamily(Length, dimension, base: meter) { meter }
#UnitFamily(Force, dimension: Mass * Length / Time / Time, base: newton) { newton }
fn accept(force: Newton) -> { print("{force.raw()}") }
fn keep<Q: Quantity<Force, .Linear>>(value: ^Q) -> Q { return value }
fn run() -> {
    momentum :: 4kilogram * 3meter
    acceleration_step :: momentum / 2s
    force :: acceleration_step / 2s
    named :: 1newton
    keep(^named)
    keep(^force)
    accept(force)
}
"""
    (code, stdout) := tiers.build_and_run("open_dimensions", src)
    assert_eq((code, stdout.as_str()), (0, "3.0\n"))
}
// Rust: tests/unit_family.rs:305
#Test("user_dimensions_keep_interpreter_and_resident_jit_parity") {
    src := """
#UnitFamily(Mass, dimension, base: kilogram) { kilogram }
#UnitFamily(Length, dimension, base: meter) { meter }
#UnitFamily(Force, dimension: Mass * Length / Time / Time, base: newton) { newton }
fn accept(force: Newton) -> { print("{force.raw()}") }
fn preserve<Q: Quantity<Force, .Linear>>(value: ^Q) -> Q { return value }
fn run() -> {
    momentum :: 4kilogram * 3meter
    acceleration_step :: momentum / 2s
    force :: acceleration_step / 2s
    preserve(^force)
    accept(force)
}
"""
    dir := common.unique_tmp("open_dimension_tiers")
    fs.create_dir_all(dir).unwrap()
    entry := dir.join("main.jet")
    fs.write(entry, src).unwrap()
    bundle := load_entry(entry.to_str().unwrap()).unwrap()
    diagnostics := check_bundle(&bundle, CompileMode.Run)
    assert(diagnostics.is_empty(), "{diagnostics:?}")
    tiers.assert_tiers_agree("open_dimension_tiers", src, "3.0\n")
    _ :: fs.remove_dir_all(dir)
}
// Rust: tests/unit_family.rs:345
#Test("scaled_and_affine_metadata_is_exact_and_normalized") {
    family := parse_family("#UnitFamily(Temperature, dimension, base: kelvin) { kelvin celsius(scale: 2/2, offset: 54630/200) }")
    assert_eq(family.base.as_ref().map(base -> base.0.as_str()), Some("kelvin"))
    celsius := family.members.iter().find(member -> member.name == "celsius").unwrap()
    assert_eq(celsius.scale.to_string(), "1")
    assert_eq(celsius.offset.to_string(), "5463/20")
}
// Rust: tests/unit_family.rs:366
#Test("unit_metadata_uses_arbitrary_precision_signed_ratios") {
