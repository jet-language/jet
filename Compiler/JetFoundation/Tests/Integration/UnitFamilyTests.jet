    result := compile_with_path(src, entry.to_str().unwrap())
    _ :: fs.remove_dir_all(dir)
    codes := result.unwrap_err().into_iter().map(d -> d.code.to_string()).collect()
    assert_eq(codes, ["E0359"])
}
// Rust: tests/unit_family.rs:1775
#Test("same_named_unit_families_from_different_packages_do_not_convert") {
    dir := env.temp_dir().join("jet_quantity_package_identity_{process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).unwrap()
    unit := """
pub #UnitFamily(Length, dimension, base: meter) { meter millimeter(scale: 1/1000) }
pub fn sample() -> Meter { return 1meter }
"""
    fs.write(dir.join("left.jet"), unit).unwrap()
    fs.write(dir.join("right.jet"), unit).unwrap()
    entry := dir.join("main.jet")
    fs.write(entry, """
use "left" as left
use "right" as right
fn run() -> {
    bad :: left.sample() + right.sample()
    print(bad.raw())
}
""").unwrap()
    bundle := load_entry(entry.to_str().unwrap()).unwrap()
    loop module in &bundle.modules {
        if module.alias == "left" || module.alias == "right" {
            module.path = dir.parent().unwrap().join("foreign-{module.alias}/module.jet")
        }
    }
    diagnostics := check_bundle(&bundle, CompileMode.Run)
    _ :: fs.remove_dir_all(dir)
    assert(diagnostics.iter().any(d -> d.code == "E0109" || d.code == "E0127" || d.code == "E0359"), "package-owned families must not unify: {diagnostics:?}")
}
