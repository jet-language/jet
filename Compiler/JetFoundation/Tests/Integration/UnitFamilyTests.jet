// Rust: tests/unit_family.rs:52
#Test("open_base_and_derived_dimension_claims_parse") {
    base := parse_family("#UnitFamily(Mass, dimension, base: kilogram) { kilogram }")
    assert(base.dimension is .Some(.Base(_)))
    derived := parse_family("#UnitFamily(Force, dimension: Mass * Length / Time / Time, base: newton) { newton }")
    assert(derived.dimension is .Some(.Derived(_)))
}
// Rust: tests/unit_family.rs:72
#Test("omitted_base_defaults_to_first_member") {
    dimensioned := parse_family("#UnitFamily(Length, dimension) { meter foot }")
    assert_eq(dimensioned.base.as_ref().map(base -> base.0.as_str()), Some("meter"))
    converted := parse_family("#UnitFamily(Length) { meter millimeter(scale: 1/1000) }")
    assert_eq(converted.base.as_ref().map(base -> base.0.as_str()), Some("meter"))
    codes := codes_of("#UnitFamily(Length) { meter millimeter(scale: 1/1000) }\nfn run() -> {\n    m :: Millimeter.from_float(Float{1000.0})\n    print(\"{(m.raw())}\")\n}\n")
    assert(codes.is_empty(), "expected clean compile, got {codes:?}")
}
