// Rust: tests/jet_test.rs:259
#Test("concurrent_jet_test_same_file_is_process_isolated") {
    root := OSPath(env.manifest_dir())
    jet := jet_bin()
    if !jet.exists() { return }
    example := root.join("Examples/features/tooling/tests.jet")
    sandboxes := (0..4).map(|index| -> isolated_test_package("jet_test_concurrent_{index}")).collect()
    mut children = []
    for sandbox in &sandboxes {
        children.push(process.Command.new(&jet).args(["test", "--show-default", "--capture=all"]).arg(&example).current_dir(&sandbox.path).stdout(process.Stdio.piped()).stderr(process.Stdio.piped()).spawn().expect("spawn concurrent jet test"))
    }
    for child in children {
        out := child.wait_with_output().expect("wait for concurrent jet test")
        assert(out.status.success(), "concurrent jet test failed: {out.status}\nstdout: {String.from_utf8_lossy(&out.stdout)}\nstderr: {String.from_utf8_lossy(&out.stderr)}")
    }
}
