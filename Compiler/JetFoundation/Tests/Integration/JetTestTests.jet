// Rust: tests/jet_test.rs:436
#Test("jet_test_fail_then_fixed") {
    root := OSPath(env.manifest_dir())
    jet := jet_bin()
    if !jet.exists() { return }
    fail := root.join("tests/fixtures/test_fail.jet")
    fixed := root.join("tests/fixtures/test_fail.fixed.jet")
    cwd := isolated_test_package("jet_test_fail_fixed")
    bad := process.Command.new(&jet).args(["test", "--show-default", "--capture=all"]).arg(&fail).current_dir(&cwd.path).output().unwrap()
    assert_eq(bad.status.code(), Some(1), "a test failure is not a compiler ICE")
    assert(String.from_utf8_lossy(&bad.stdout).contains("FAIL"), "expected a FAIL line, got: {String.from_utf8_lossy(&bad.stdout)}")
    assert(String.from_utf8_lossy(&bad.stderr).contains("Stop [E3001]"), "assert_eq should print the registered test report")
    json := process.Command.new(&jet).args(["test", "--json", "--serial", "--fresh"]).arg(&fail).current_dir(&cwd.path).output().unwrap()
    assert_eq(json.status.code(), Some(1), "ordinary assertion failure must fail the JSON run")
    status := parse_json(String.from_utf8_lossy(&json.stdout)).expect("JSON ordinary-failure status")
    test := report_object(&status, "test")
    assert_eq(report_int(report_field(test, "failed")), 1)
    assert_eq(report_int(report_field(test, "expectedFailures")), 0)
    assert_eq(report_int(report_field(test, "unexpectedPasses")), 0)
    evidence := report_object(&status, "evidence")
    ordinary_failure := report_array(evidence, "evidence").iter().find(|record| -> report_text(report_field(record, "claim")) == "addition works" && report_text(report_field(record, "kind")) == "unit").expect("ordinary assertion terminal evidence")
    assert_eq(report_text(report_field(ordinary_failure, "outcome")), "failed")
    assert_eq(report_text(report_field(ordinary_failure, "expectation")), "ordinary")
    good := process.Command.new(&jet).args(["test", "--show-default", "--capture=all"]).arg(&fixed).current_dir(&cwd.path).output().unwrap()
    assert(good.status.success())
    assert(String.from_utf8_lossy(&good.stdout).contains("pass"), "fixed tests should pass")
}
// Rust: tests/jet_test.rs:506
#Test("criterion_1_2_3_4_6_testing_file_failures_are_typed_and_path_bearing") {
    root := OSPath(env.manifest_dir())
    jet := jet_bin()
    if !jet.exists() { return }
    failing := root.join("tests/fixtures/testing_failure_reports.jet")
    fixed := root.join("tests/fixtures/testing_failure_reports.fixed.jet")
    cwd := isolated_test_package("jet_test_typed_failures")
    fixture_dir := cwd.path.join("tests/fixtures")
    fs.create_dir_all(&fixture_dir).unwrap()
    _ :: fs.copy(root.join("tests/fixtures/testing_failure_reports.golden"), fixture_dir.join("testing_failure_reports.golden")).unwrap()
    bad := process.Command.new(&jet).args(["test", "--show-default", "--capture=all"]).arg(&failing).current_dir(&cwd.path).output().unwrap()
    stdout := String.from_utf8_lossy(&bad.stdout)
    stderr := String.from_utf8_lossy(&bad.stderr)
    assert(!bad.status.success())
    assert_eq(stdout.matches(": FAIL").count(), 4, "stdout: {stdout}")
    assert(stderr.contains("golden file is missing: tests/fixtures/testing_failure_reports.missing"))
    assert(stderr.contains("golden file cannot be read: tests/fixtures"))
    assert(stderr.contains("golden file differs: tests/fixtures/testing_failure_reports.golden"))
    assert(stderr.contains("fixture is missing: tests/fixtures/testing_failure_reports.missing"))
    assert(stderr.contains("--- expected tests/fixtures/testing_failure_reports.golden"))
    assert(stderr.contains("+++ actual tests/fixtures/testing_failure_reports.golden"))
    removal := stderr.find("-expected\n").expect("mismatch report must show expected removal")
    addition := stderr.find("+actual\n").expect("mismatch report must show actual addition")
    assert(removal < addition, "diff order must be deterministic: {stderr}")
    assert_eq(stderr.matches("Stop [E3001]").count(), 4, "stderr: {stderr}")
    assert_eq(stderr.matches("-->").count(), 4, "stderr: {stderr}")
    snapshot := fs.read_to_string(root.join("tests/fixtures/testing_failure_reports.stderr")).expect("testing_failure_reports.stderr")
    normalized_stderr := stderr.replace(root.to_str().expect("manifest path"), "<repo>")
    assert_eq(normalized_stderr, snapshot, "typed testing report snapshot drifted")
    good := process.Command.new(&jet).args(["test", "--show-default", "--capture=all"]).arg(&fixed).current_dir(&cwd.path).output().unwrap()
    assert(good.status.success(), "fixed testing helpers failed:\nstdout: {String.from_utf8_lossy(&good.stdout)}\nstderr: {String.from_utf8_lossy(&good.stderr)}")
}
// Rust: tests/jet_test.rs:581
#Test("release_test_uses_aot_tier_marker") {
    root := OSPath(env.manifest_dir())
    jet := jet_bin()
    if !jet.exists() { return }
    example := root.join("Examples/features/tooling/property_tests.jet")
    cwd := isolated_test_package("jet_release_property")
    out := process.Command.new(&jet).args(["test", "--release", "--trace-tiers", "--show-default", "--capture=all"]).arg(&example).current_dir(&cwd.path).output().unwrap()
    stdout := String.from_utf8_lossy(&out.stdout)
    stderr := String.from_utf8_lossy(&out.stderr)
    assert(out.status.success(), "release property test failed:\nstdout: {stdout}\nstderr: {stderr}")
    assert(stdout.contains("tier aot profile=release"), "release test did not report its AOT tier:\n{stdout}")
    assert_eq(stdout.matches("tier aot profile=release").count(), 1, "release test must report exactly one AOT tier marker:\n{stdout}")
    combined := "{stdout}{stderr}".to_ascii_lowercase()
    assert(!combined.contains("tier jit"), "release test reported a JIT tier:\n{combined}")
    assert(!combined.contains("tier interpreter"), "release test reported an interpreter tier:\n{combined}")
}
// Rust: tests/jet_test.rs:759
#Test("property_generator_distribution_report_is_reproducible") {
    root := OSPath(env.manifest_dir())
    jet := jet_bin()
    if !jet.exists() { return }
    report_path := root.join("tests/fixtures/property-generator-distribution.json")
    report_source := fs.read_to_string(&report_path).expect("property distribution report")
    report := parse_json(report_source).expect("valid property report JSON")
    if report.as_object().is_err() { panic("property report must be an object") }
    assert_eq(report_int(report_field(&report, "schema")), 1)
    predicates := report_array(&report, "predicates")
    predicate_ids := predicates.iter().map(|predicate| -> report_text(report_field(predicate, "id"))).collect()
    assert_eq(predicate_ids, ["int_eq_42", "int_small_anchor", "int_extreme", "int_random_fallback"])
    predicate_expressions := predicates.iter().map(|predicate| -> report_text(report_field(predicate, "expression"))).collect()
    assert_eq(predicate_expressions, ["x == 42", "x == 0 || x == 1 || x == -1", "x == Int.MIN || x == Int.MAX", "x is outside the 15 explicit i64 landmarks"])
    engines := report_array(&report, "engines")
    assert(engines.iter().any(|engine| -> report_text(engine) == "jet_test"))
    assert(engines.iter().any(|engine| -> report_text(engine) == "jet_fuzz"))
    comparison := report_object(&report, "comparison")
    for field in ["predicates", "seeds", "sample_counts", "hit_rates", "sample_stream"] { assert_eq(report_text(report_field(comparison, field)), "identical") }
    seeds := report_object(&report, "seeds")
    sample_counts := report_object(&report, "sample_counts")
    test_seed := report_int(report_field(seeds, "jet_test"))
    fuzz_seed := report_int(report_field(seeds, "jet_fuzz"))
    assert_eq(test_seed, fuzz_seed, "engines use different base seeds")
    seed := U64.try_from(test_seed).expect("property seed must fit u64")
    test_count := report_int(report_field(sample_counts, "jet_test"))
    fuzz_count := report_int(report_field(sample_counts, "jet_fuzz"))
    assert_eq(test_count, fuzz_count, "engines use different sample counts")
    sample_count := USize.try_from(test_count).expect("sample count must fit usize")
    hit_rates := report_object(&report, "hit_rates")
    test_rates := report_object(hit_rates, "jet_test")
    fuzz_rates := report_object(hit_rates, "jet_fuzz")
    predicate_names := ["int_eq_42", "int_small_anchor", "int_extreme", "int_random_fallback"]
    for id in predicate_names {
        test_rate := report_float(report_field(test_rates, id))
        fuzz_rate := report_float(report_field(fuzz_rates, id))
        assert_eq(test_rate, fuzz_rate, "engines disagree for {id}")
    }
    expected_hit_counts := report_object(&report, "hit_counts")
    expected_digests := report_object(&report, "sample_digests")
    card_ids := report_array(&report, "finding_card_ids")
    assert(card_ids.iter().any(|id| -> report_text(id) == "#1905"))
    findings := report_array(&report, "findings")
    assert(!findings.is_empty(), "distribution findings must be carded")
    for finding in findings {
        ids := report_array(finding, "finding_card_ids")
        assert(ids.iter().any(|id| -> report_text(id) == "#1905"))
    }
    fixture := root.join("tests/fixtures/property-generator-distribution.jet")
    seed_arg := seed.to_string()
    cwd := isolated_test_package("jet_property_distribution")
    test_out := process.Command.new(&jet).args(["test", "--serial", "--show-default", "--capture=all"]).arg(&fixture).env("JET_PROP_SEED", seed_arg).env("JET_PROP_TRACE", "1").current_dir(&cwd.path).output().expect("run jet test property distribution")
    assert(test_out.status.success(), "jet test property distribution failed:\nstdout: {String.from_utf8_lossy(&test_out.stdout)}\nstderr: {String.from_utf8_lossy(&test_out.stderr)}")
    corpus := common.unique_tmp("jet_property_generator_distribution")
    _ :: fs.remove_dir_all(&corpus)
    fs.create_dir_all(&corpus).expect("create empty fuzz corpus")
    iterations_arg := "--iterations={sample_count}"
    corpus_arg := "--corpus={corpus.display()}"
    fuzz_out := process.Command.new(&jet).args(["test", "--grade=generated"]).arg(iterations_arg).arg("--seed={seed}").arg(corpus_arg).arg(&fixture).arg("generator_contract").env("JET_PROP_TRACE", "1").current_dir(&cwd.path).output().expect("run generated property distribution")
    _ :: fs.remove_dir_all(&corpus)
    assert(fuzz_out.status.success(), "generated property distribution failed:\nstdout: {String.from_utf8_lossy(&fuzz_out.stdout)}\nstderr: {String.from_utf8_lossy(&fuzz_out.stderr)}")
    test_samples := parse_property_samples(&test_out.stdout, "jet_test")
    fuzz_samples := parse_property_samples(&fuzz_out.stdout, "jet_fuzz")
    assert_eq(test_samples.len(), sample_count)
    assert_eq(fuzz_samples.len(), sample_count)
    for (expected_case, sample) in test_samples.iter().enumerate() { assert_eq(sample.case_index, U64(expected_case)) }
    for (expected_case, sample) in fuzz_samples.iter().enumerate() { assert_eq(sample.case_index, U64(expected_case)) }
    assert_eq(test_samples, fuzz_samples, "jet test and generated tests produced different case seeds or inputs")
    test_counts := property_distribution(&test_samples)
    fuzz_counts := property_distribution(&fuzz_samples)
    assert_eq(test_counts, fuzz_counts, "engines disagree on predicate hits")
    for (index, id) in predicate_names.iter().enumerate() {
        test_counts_by_id := report_object(expected_hit_counts, "jet_test")
        expected_test_count := report_int(report_field(test_counts_by_id, id))
        assert_eq(USize.try_from(expected_test_count).expect("test hit count must fit usize"), test_counts[index], "wrong hit count for {id}")
        fuzz_counts_by_id := report_object(expected_hit_counts, "jet_fuzz")
        expected_fuzz_count := report_int(report_field(fuzz_counts_by_id, id))
        assert_eq(USize.try_from(expected_fuzz_count).expect("fuzz hit count must fit usize"), fuzz_counts[index], "wrong fuzz hit count for {id}")
        expected_test_rate := report_float(report_field(test_rates, id))
        expected_fuzz_rate := report_float(report_field(fuzz_rates, id))
        observed_rate := F64(test_counts[index]) / F64(sample_count)
        assert((observed_rate - expected_test_rate).abs() < 1e-12, "wrong test rate for {id}")
        assert((observed_rate - expected_fuzz_rate).abs() < 1e-12, "wrong fuzz rate for {id}")
    }
    for (engine, samples) in [("jet_test", &test_samples), ("jet_fuzz", &fuzz_samples)] {
        expected_digest := report_text(report_field(expected_digests, engine))
        assert_eq(property_sample_digest(samples), expected_digest, "generator contract drifted for {engine}")
    }
}
