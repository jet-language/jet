    assert(stdout_a.contains("minimized input: n = 50"), "expected the shrunk boundary value:\n{stdout_a}")
    entries_a := fs.read_dir(&corpus_a).map(|rd| -> rd.filter_map(|e| -> e.ok().map(|entry| -> entry.file_name().to_string_lossy().into_owned())).collect<[String]>()).unwrap_or_default()
    entries_b := fs.read_dir(&corpus_b).map(|rd| -> rd.filter_map(|e| -> e.ok().map(|entry| -> entry.file_name().to_string_lossy().into_owned())).collect<[String]>()).unwrap_or_default()
    assert_eq(entries_a.len(), 1, "expected exactly one saved corpus entry")
    assert_eq(entries_a, entries_b, "same seed must save the same corpus file name")
    _ :: fs.remove_dir_all(&corpus_a)
    _ :: fs.remove_dir_all(&corpus_b)
}
// Rust: tests/jet_test.rs:1921
#Test("jet_fuzz_replays_corpus_before_generating_fresh_cases") {
    root := OSPath(env.manifest_dir())
    jet := jet_bin()
    if !jet.exists() { return }
    fixture := root.join("tests/fixtures/prop_shrink.jet")
    cwd := isolated_test_package("jet_fuzz_replay")
    corpus := fuzz_corpus_dir("replay")
    first := process.Command.new(&jet).args(["test", "--grade=generated", "--seed=7"]).arg("--corpus={corpus.display()}").arg(&fixture).current_dir(&cwd.path).output().unwrap()
    assert(!first.status.success())
    assert(fs.read_dir(&corpus).map(|rd| -> rd.count() == 1).unwrap_or(false), "expected one saved corpus entry after the first run")
    second := process.Command.new(&jet).args(["test", "--grade=generated", "--seed=999"]).arg("--corpus={corpus.display()}").arg(&fixture).current_dir(&cwd.path).output().unwrap()
    assert(!second.status.success())
    stdout := String.from_utf8_lossy(&second.stdout)
    assert(stdout.contains("corpus replay"), "expected the second run to fail on corpus replay, not a fresh case:\n{stdout}")
    _ :: fs.remove_dir_all(&corpus)
}
// Rust: tests/jet_test.rs:1971
#Test("jet_test_harness_keeps_helper_functions_on_their_own_error_family") {
    jet := jet_bin()
    if !jet.exists() { return }
    scratch := common.Scratch.new("jet_test_helper_family")
    dir := &scratch.path
    fs.create_dir_all(dir).unwrap()
    tir_support.write_test_package(dir, tir_support.TIR_TEST_PACKAGE)
    source := dir.join("helpers.jet")
    fs.write(&source, "#Error\nstruct HelperError {\n    message: String\n}\n\nfn first(values: [Int]) -> Int {\n    return values.get(0) ?? panic(\"empty list\")\n}\n\nfn checked(flag: Bool) -> Bool {\n    assert(flag, \"flag must hold\")\n    assert_eq(flag, true)\n    return true\n}\n\nfn port(text: String) -> Int HelperError! {\n    number :: text.trim().to_int() ?? panic(\"not a port number\")\n    if number < 0 -> return Err(HelperError{message: \"negative port\"})\n    return Ok(number)\n}\n\nstruct Recorded {\n    argv: [String]\n}\n\n// #2350 part 2: both operands are read windows into borrowed non-scalar\n// parameters. Binding them by value moved out of a shared reference (E0507),\n// so the generated Rust never compiled.\nfn same_argv(expected: Recorded, oracle_argv: [String]) -> Bool {\n    assert_eq(expected.argv, oracle_argv)\n    return true\n}\n\n#Test(\"helpers with assert and ?? panic build inside a test harness\") {\n    assert(checked(true))\n    assert_eq(first([7]), 7)\n    resolved :: port(\"  8080  \") ?? -1\n    assert_eq(resolved, 8080)\n    recorded :: Recorded{argv: [\"jet\", \"run\"]}\n    assert(same_argv(recorded, [\"jet\", \"run\"]))\n}\n\n#Test(\"a failing harness assertion is still a caught failure\") {\n    assert_eq(first([1]), 2)\n}\n").unwrap()
    out := process.Command.new(&jet).args(["test", "--show-default", "--serial"]).arg(&source).current_dir(dir).output().unwrap()
    stdout := String.from_utf8_lossy(&out.stdout)
    stderr := String.from_utf8_lossy(&out.stderr)
    assert(stdout.contains("helpers with assert and ?? panic build inside a test harness: pass"), "helper functions must not borrow the harness String failure ABI:\nstdout: {stdout}\nstderr: {stderr}")
    assert(stdout.contains("a failing harness assertion is still a caught failure: FAIL"), "the `#Test` body assertion must still report as a caught failure:\nstdout: {stdout}\nstderr: {stderr}")
    assert(!out.status.success(), "a failing test must fail the run:\nstdout: {stdout}\nstderr: {stderr}")
}
