    cwd_a := isolated_test_package("jet_fuzz_deterministic_a")
    corpus_a := fuzz_corpus_dir("det_a")
    out_a := process.Command.new(&jet).args(["test", "--grade=generated", "--seed=7"]).arg("--corpus={corpus_a.display()}").arg(&fixture).current_dir(&cwd_a.path).output().unwrap()
    corpus_b := fuzz_corpus_dir("det_b")
    cwd_b := isolated_test_package("jet_fuzz_deterministic_b")
    out_b := process.Command.new(&jet).args(["test", "--grade=generated", "--seed=7"]).arg("--corpus={corpus_b.display()}").arg(&fixture).current_dir(&cwd_b.path).output().unwrap()
    assert(!out_a.status.success(), "the fixture's property always fails")
    assert_eq(out_a.status.code(), out_b.status.code(), "same seed must reproduce the same exit code")
    strip_saved := |s: String| -> s.lines().filter(|line| -> !line.trim_start().starts_with("saved:")).collect().join("\n")
    assert_eq(strip_saved(String.from_utf8_lossy(&out_a.stdout)), strip_saved(String.from_utf8_lossy(&out_b.stdout)), "same seed must reproduce the same stdout (minimized input, iteration count)")
