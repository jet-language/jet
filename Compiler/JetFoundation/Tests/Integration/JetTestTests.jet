    example := root.join("Examples/features/tooling/tests.jet")
    cwd := isolated_test_package("jet_test_example")
    out := process.Command.new(&jet).args(["test", "--show-default", "--capture=all"]).arg(&example).current_dir(&cwd.path).output().unwrap()
    assert(out.status.success(), "jet test Examples/features/tooling/tests.jet failed:\nstdout: {String.from_utf8_lossy(&out.stdout)}\nstderr: {String.from_utf8_lossy(&out.stderr)}")
    expected := fs.read_to_string(root.join("Examples/features/expected/tooling/tests.test.out")).expect("Examples/features/expected/tooling/tests.test.out")
    assert_eq(String.from_utf8_lossy(&out.stdout), expected)
}
// Rust: tests/jet_test.rs:58
#Test("jet_test_inline_c_comparison_preserves_checked_int_declaration") {
    root := OSPath(env.manifest_dir())
    jet := jet_bin()
    if !jet.exists() { return }
    example := root.join("Examples/features/lowlevel/inline_c.jet")
    cwd := isolated_test_package("jet_test_inline_c")
    matching := process.Command.new(&jet).args(["test", "--show-default", "--capture=all", "--serial"]).arg(&example).current_dir(&cwd.path).output().unwrap()
    assert(matching.status.success(), "bounded inline C comparisons failed:\nstdout: {String.from_utf8_lossy(&matching.stdout)}\nstderr: {String.from_utf8_lossy(&matching.stderr)}")
    matching_stdout := String.from_utf8_lossy(&matching.stdout)
    assert(matching_stdout.contains("inline C Int comparisons: pass"), "matching inline C test did not report a pass:\n{matching_stdout}")
    assert(!matching_stdout.contains("FAIL"), "matching inline C test reported a failure:\n{matching_stdout}")
    wrong := cwd.path.join("wrong_inline_c.jet")
    fs.write(&wrong, "fn jet_add(n: Int) -> Int { (n * 2) }\n\n#[Unsafe(\"deliberately wrong scalar C result\"), FFI(c)] fn c_wrong(n: Int) -> Int {\n    \"\"\"int64_t c_wrong(int64_t n) { return n * 2 + 1; }\"\"\"\n}\n\n#Test(\"wrong inline C result\") {\n    #Unsafe(\"audited scalar C call\") {\n        assert_eq(jet_add(3), c_wrong(3))\n    }\n}\n").unwrap()
    failed := process.Command.new(&jet).args(["test", "--show-default", "--capture=all", "--serial"]).arg(&wrong).current_dir(&cwd.path).output().unwrap()
    assert_eq(failed.status.code(), Some(1), "wrong inline C result must be an ordinary failed test:\nstdout: {String.from_utf8_lossy(&failed.stdout)}\nstderr: {String.from_utf8_lossy(&failed.stderr)}")
    failed_stdout := String.from_utf8_lossy(&failed.stdout)
    assert(failed_stdout.contains("wrong inline C result: FAIL"), "wrong inline C test did not report an ordinary failure:\n{failed_stdout}")
    failed_stderr := String.from_utf8_lossy(&failed.stderr)
    assert(failed_stderr.contains("E3001"), "wrong inline C test did not report its runtime assertion:\n{failed_stderr}")
}
// Rust: tests/jet_test.rs:132
#Test("jet_test_expected_fail_tracks_failure_and_unexpected_pass") {
    root := OSPath(env.manifest_dir())
    jet := jet_bin()
    if !jet.exists() { return }
    example := root.join("Examples/features/tooling/expected_fail.jet")
    expected := fs.read_to_string(root.join("Examples/features/expected/tooling/expected_fail.test.out")).expect("expected_fail.test.out")
    cwd := isolated_test_package("jet_test_expected_fail")
    green := process.Command.new(&jet).args(["test", "--show-default", "--capture=all", "--serial", "--filter=known"]).arg(&example).current_dir(&cwd.path).output().unwrap()
    assert(green.status.success(), "expected failure should stay green:\n{String.from_utf8_lossy(&green.stdout)}")
    assert_eq(String.from_utf8_lossy(&green.stdout), "known bug remains expected-fail: expected-fail\n0 passed, 0 failed, 0 skipped, 1 expected-fail\n")
    out := process.Command.new(&jet).args(["test", "--show-default", "--capture=all", "--serial"]).arg(&example).current_dir(&cwd.path).output().unwrap()
    assert_eq(out.status.code(), Some(1), "unexpected pass must fail the run")
    assert_eq(String.from_utf8_lossy(&out.stdout), expected)
    json_output := process.Command.new(&jet).args(["test", "--json", "--serial"]).arg(&example).current_dir(&cwd.path).output().unwrap()
    assert_eq(json_output.status.code(), Some(1), "JSON run must preserve unexpected-pass failure")
    json := String.from_utf8_lossy(&json_output.stdout)
    assert(json.contains("\"expectedFailures\":1"), "missing expected-failure count: {json}")
    assert(json.contains("\"unexpectedPasses\":1"), "missing unexpected-pass count: {json}")
    status := parse_json(json).expect("JSON test status")
    evidence := report_object(&status, "evidence")
    evidence_identity := report_object(evidence, "identity")
    assert_eq(report_text(report_field(evidence_identity, "claim")), "", "aggregate evidence identity must not inherit the first runtime stop")
    assert_eq(report_text(report_field(evidence_identity, "evidence")), "", "aggregate evidence identity must not inherit one terminal record")
    records := report_array(evidence, "evidence")
    terminal_expected_failure := records.iter().find(|record| -> report_text(report_field(record, "claim")) == "known bug remains expected-fail" && report_text(report_field(record, "kind")) == "unit").expect("normalized harness terminal outcome")
    assert_eq(report_text(report_field(terminal_expected_failure, "outcome")), "failed")
    assert_eq(report_text(report_field(terminal_expected_failure, "expectation")), "expected_failure")
    raw_expected_failure := records.iter().find(|record| -> report_text(report_field(record, "claim")) == "E3001" && report_text(report_field(record, "kind")) == "runtime").expect("raw expected-failure diagnostic")
    assert_eq(report_text(report_field(raw_expected_failure, "expectation")), "expected_failure")
}
