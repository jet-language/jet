// Rust: tests/jet_test.rs:1284
#Test("jet_new_creates_project") {
    jet := jet_bin()
    parent_scratch := common.Scratch.new("jet_new_test_parent")
    parent := &parent_scratch.path
    tir_support.write_test_package(parent, tir_support.TIR_TEST_PACKAGE)
    name := "hello"
    dir := parent.join(name)
    _ :: jet_ok_outside_core(&jet, parent, &["new", name])
    mut created := fs.read_dir(&dir).unwrap().map(|entry| -> entry.unwrap().file_name().to_string_lossy().into_owned()).collect()
    created.sort()
    assert_eq(created, [".gitignore", ".jet", "package.jet", "run.jet"], "plain `jet new` writes only the print-only project")
    source := fs.read_to_string(dir.join("run.jet")).unwrap()
    assert(!source.contains("#CLI") && !source.contains("core.ui") && source.contains("fn run()"), "plain `jet new` must emit the print-only starter: {source}")
    assert_eq(jet_ok_outside_core(&jet, &dir, &["run"]), "hello, world\n")
    assert_eq(jet_ok_outside_core(&jet, &dir, &["run", "run.jet"]), "hello, world\n")
    assert_eq(jet_ok_outside_core(&jet, &dir, &["run", "--profile=debug"]), "hello, world\n")
    tested := jet_ok_outside_core(&jet, &dir, &["test", "--capture=all"])
    assert(tested.contains("the greeting stays stable: pass") && tested.contains("1 passed"), "the starter test must pass:\n{tested}")
    _ :: jet_ok_outside_core(&jet, &dir, &["build"])
    binary := process.Command.new(dir.join(".jet/build/run")).output().unwrap()
    assert(binary.status.success())
    assert_eq(String.from_utf8_lossy(&binary.stdout), "hello, world\n")
    duplicate := process.Command.new(&jet).args(["new", name]).current_dir(parent).output().unwrap()
    assert(!duplicate.status.success(), "jet new must reject an existing project")
    unknown := process.Command.new(&jet).args(["new", "other", "--template", "gui"]).current_dir(parent).output().unwrap()
    unknown_stderr := String.from_utf8_lossy(&unknown.stderr)
    assert(!unknown.status.success() && unknown_stderr.contains("E2104") && unknown_stderr.contains("cli, ui, web, overrides"), "an unknown template must name the valid ones:\n{unknown_stderr}")
    assert(!parent.join("other").exists(), "an unknown template must create nothing")
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/jet_test.rs:1355
#Test("jet_new_every_template_runs_and_tests") {
    jet := jet_bin()
    parent_scratch := common.Scratch.new("jet_new_templates_parent")
    parent := &parent_scratch.path
    tir_support.write_test_package(parent, tir_support.TIR_TEST_PACKAGE)
    homes := ["@run.jet", "@build.jet", "@dev.jet", "@test.jet"]
    for template in ["cli", "ui", "web", "overrides"] {
        name := "starter_{template}"
        dir := parent.join(name)
        _ :: jet_ok_outside_core(&jet, parent, &["new", name, "--template", template])
        for home in homes { assert_eq(dir.join(home).exists(), template == "overrides", "only `--template overrides` writes `{home}`") }
        tested := jet_ok_outside_core(&jet, &dir, &["test", "--capture=all"])
        assert(tested.contains("1 passed"), "{template} starter test:\n{tested}")
        if template == "web" {
            _ :: jet_ok_outside_core(&jet, &dir, &["build", "--target", "web"])
            assert(dir.join(".jet/build/app.wasm").is_file(), "web starter built no wasm")
        } else {
            stdout := jet_ok_outside_core(&jet, &dir, &["run"])
            assert(stdout.starts_with("hello, world\n"), "{template} starter output:\n{stdout}")
        }
    }
}
