// Rust: tests/jet_test.rs:1151
#Test("jet_test_coverage_reports_branch_taken_and_not_taken_in_text_and_json") {
    root := OSPath(env.manifest_dir())
    jet := jet_bin()
    if !jet.exists() { return }
    fixture := root.join("tests/fixtures/coverage.jet")
    cwd := isolated_test_package("jet_coverage_branch")
    run := |json: Bool| -> {
        mut command := process.Command.new(&jet)
        command.arg("test").arg("--coverage")
        if json { command.arg("--json") }
        command.arg(&fixture).current_dir(&cwd.path)
        command.output().unwrap()
    }
    text_output := run(false)
    assert(text_output.status.success(), "coverage text run failed:\n{String.from_utf8_lossy(&text_output.stdout)}\n{String.from_utf8_lossy(&text_output.stderr)}")
    fixture_path := fixture.to_string_lossy().into_owned()
    qualified_fixture_path := "{root.join("tests/fixtures").display()}::coverage.jet::"
    text_source := String.from_utf8_lossy(&text_output.stdout).replace(fixture_path, "tests/fixtures/coverage.jet").replace(qualified_fixture_path, "main::")
    compact := |value: String| -> value.split_whitespace().collect().join(" ")
    text := compact(text_source)
    assert(text.contains("1/2 branches covered (50%)"), "missing branch coverage summary:\n{text}")
    json_output := run(true)
    assert(json_output.status.success(), "coverage JSON run failed:\n{String.from_utf8_lossy(&json_output.stdout)}\n{String.from_utf8_lossy(&json_output.stderr)}")
    json := String.from_utf8_lossy(&json_output.stdout).replace(fixture_path, "tests/fixtures/coverage.jet").replace(qualified_fixture_path, "main::")
    report := json.lines().filter(|line| -> !line.trim().is_empty()).map(|line| -> parse_json(line).expect("coverage command emits valid JSON records")).find(|report| -> report.get("coverage").is_ok()).expect("coverage status record")
    coverage := report_object(&report, "coverage")
    branches := report_array(coverage, "branches")
    functions := report_array(coverage, "functions")
    function_state := |name: String| -> functions.iter().find(|function| -> report_text(report_field(function, "name")) == name).unwrap_or_else(|| -> panic("missing function coverage row {name}: {functions:?}"))
    assert_eq(report_field(function_state("used"), "covered"), &DataTree.Bool(true))
    assert_eq(report_field(function_state("unused"), "covered"), &DataTree.Bool(false))
    assert_eq(branches.len(), 2, "test-harness branches must not count as source coverage")
    outcome := |name: String| -> branches.iter().find(|branch| -> report_text(report_field(branch, "outcome")) == name).unwrap_or_else(|| -> panic("missing branch outcome {name}: {branches:?}"))
    taken := outcome("taken")
    not_taken := outcome("not-taken")
    id := report_text(report_field(taken, "id"))
    assert_eq(id, report_text(report_field(not_taken, "id")))
    for (branch, outcome_name, hits, state) in [(taken, "taken", 1, "HIT"), (not_taken, "not-taken", 0, "MISS")] {
        assert_eq(report_text(report_field(branch, "function")), "used")
        assert_eq(report_int(report_field(branch, "hits")), hits)
        row := "BRANCH {id} {outcome_name} {state} hits={hits}"
        assert(text.contains(compact(row)), "text and JSON coverage differ:\n{row}\n{text}")
    }
}
