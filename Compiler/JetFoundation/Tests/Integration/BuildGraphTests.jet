// Rust: tests/build_graph.rs:81
#Test("registers_typed_targets_and_default_plan") {
    b := BuildContext.new()
    gen :: b.action("generate-assets", ActionSpec.cached(["jet-tool", "pack"]).with_inputs(["assets/sprite.png"]).with_outputs([".jet/generated/assets.jet"]).with_cap(BuildCapability.FS)).unwrap()
    lib :: b.add_library("engine", TargetSpec.new().with_source("src/engine.jet").with_action(gen)).unwrap()
    app :: b.add_executable("game", TargetSpec.new().with_source("src/main.jet").with_dep(lib)).unwrap()
    b.add_test("unit", TargetSpec.new().with_dep(app)).unwrap()
    b.add_test("frame-time", TargetSpec.new().with_dep(app)).unwrap()
    b.add_asset_bundle("assets", TargetSpec.new().with_action(gen)).unwrap()
    b.add_doc("manual", TargetSpec.new().with_source("docs/manual.md")).unwrap()
    b.add_install("install", TargetSpec.new().with_dep(app)).unwrap()
    b.add_package("package", TargetSpec.new().with_dep(app)).unwrap()
    b.add_publish("publish", TargetSpec.new().with_dep(app)).unwrap()
    plan :: b.plan_with_default(app).unwrap()
    assert_eq(plan.default_target(), Val(app.into()))
    assert_eq(plan.target(app).unwrap().kind, TargetKind.Executable)
    assert_eq(plan.target(app).unwrap().toolchain, b.default_host_toolchain())
    assert_eq(plan.default_host_toolchain().role, ToolchainRole.Host)
    assert_eq(plan.default_host_toolchain().provenance.source, ProvenanceSource.InferredHost)
    assert_eq(plan.target(lib).unwrap().kind, TargetKind.Library)
    assert_eq(plan.targets_by_kind(TargetKind.AssetBundle).len(), 1)
    assert_eq(plan.actions().len(), 1)
    assert_eq(plan.action(gen).unwrap().outputs[0].as_str(), ".jet/generated/assets.jet")
}

// Rust: tests/build_graph.rs:143
#Test("selected_default_executes_only_its_target_dependency_closure") {
    b := BuildContext.new()
    selected_action :: b.action("selected", ActionSpec.cached(["tool"]).with_outputs(["selected.out"])).unwrap()
    unrelated_action :: b.action("unrelated", ActionSpec.cached(["tool"]).with_outputs(["unrelated.out"])).unwrap()
    selected :: b.add_executable("selected", TargetSpec.new().with_source("main.jet").with_action(selected_action)).unwrap()
    b.add_test("unrelated", TargetSpec.new().with_source("other.jet").with_action(unrelated_action)).unwrap()
    plan :: b.plan_with_default(selected).unwrap()
    model :: plan.execution_model().unwrap()
    assert_eq(model.nodes.len(), 1)
    assert_eq(model.nodes[0].name, "selected")
    assert_eq(plan.selected_sources().unwrap()[0].as_str(), "main.jet")
}

// Rust: tests/build_graph.rs:180
#Test("records_explicit_toolchains_sdks_linkers_and_signers") {
    b := BuildContext.new()
    sdk_lock :: LockRecord.new("sdk:core.embedded-sdk#1.4", "sha256:sdk")
    linker_lock :: LockRecord.new("linker:lld#18", "sha256:linker")
    toolchain_lock :: LockRecord.new("toolchain:aarch64-linux-musl", "sha256:toolchain")
    toolchain :: b.toolchain("arm-musl", ToolchainSpec.target("aarch64-linux-musl", BuildProvenance.jetpack_dependency("toolchain.aarch64-linux-musl#2026.07", toolchain_lock)).with_host_triple("x86_64-linux").with_sdk(SdkIdentity.new("core.embedded-sdk", "1.4", BuildProvenance.jetpack_dependency("core.embedded-sdk#1.4", sdk_lock))).with_linker(LinkerIdentity.new("lld", BuildProvenance.jetpack_dependency("lld#18", linker_lock)))).unwrap()
    signer :: b.signing_identity("mac-release", SigningIdentitySpec.new("developer-id:ACME", BuildProvenance.user_declared("keychain:mac-release", Val(LockRecord.new("signing:mac-release", "sha256:signer"))))).unwrap()
    link :: b.action("link-firmware", ActionSpec.cached(["ld.lld", "-o", "build/sensor"]).with_outputs(["build/sensor"]).with_cap(BuildCapability.Exec).with_toolchain(toolchain)).unwrap()
    app :: b.add_executable("sensor", TargetSpec.new().with_source("src/sensor.jet").with_action(link).with_toolchain(toolchain).with_signing_identity(signer)).unwrap()
    plan :: b.plan_with_default(app).unwrap()
    recorded_toolchain :: plan.toolchain(toolchain).unwrap()
    assert_eq(recorded_toolchain.role, ToolchainRole.Target)
    assert_eq(recorded_toolchain.host_triple, "x86_64-linux")
    assert_eq(recorded_toolchain.target_triple, "aarch64-linux-musl")
    assert_eq(recorded_toolchain.sdk.as_ref().unwrap().provenance.lock.as_ref().unwrap().digest, "sha256:sdk")
    assert_eq(recorded_toolchain.linker.as_ref().unwrap().provenance.lock.as_ref().unwrap().digest, "sha256:linker")
    assert_eq(plan.target(app).unwrap().toolchain, toolchain)
    assert_eq(plan.action(link).unwrap().toolchain, toolchain)
    assert_eq(plan.target(app).unwrap().signing_identity, Val(signer))
    assert_eq(plan.signing_identity(signer).unwrap().label, "developer-id:ACME")
    assert_eq(plan.signing_identity(signer).unwrap().provenance.lock.as_ref().unwrap().digest, "sha256:signer")
}

// Rust: tests/build_graph.rs:288
#Test("typed_probes_record_reproducibility_and_provenance") {
    b := BuildContext.new()
    cc :: b.find_program("cc", "cc").unwrap()
    sqlite :: b.probe("sqlite", ProbeSpec.pkg_config("sqlite3").with_min_version("3.42").with_reproducibility(ReproducibilityClass.Reproducible).with_provenance(BuildProvenance.jetpack_dependency("pkg-config:sqlite3#3.42", LockRecord.new("probe:sqlite3", "sha256:sqlite")))).unwrap()
    header :: b.header_check("sqlite-header", "sqlite3.h").unwrap()
    compile :: b.compile_check("sqlite-wal", "sqlite-wal", ["sqlite3.h"], "sqlite3_wal_checkpoint_v2").unwrap()
    lib :: b.add_library("sqlite-bridge", TargetSpec.new().with_probe(cc).with_probe(sqlite).with_probe(header).with_probe(compile)).unwrap()
    plan :: b.plan_with_default(lib).unwrap()
    assert_eq(plan.probes().len(), 4)
    assert_eq(plan.probe(cc).unwrap().reproducibility, ReproducibilityClass.Ambient)
    assert_eq(plan.probe(sqlite).unwrap().reproducibility, ReproducibilityClass.Reproducible)
    assert_eq(plan.probe(sqlite).unwrap().provenance.lock.as_ref().unwrap().digest, "sha256:sqlite")
    assert(match plan.probe(sqlite).unwrap().kind { .PkgConfig { package, .. } => package == "sqlite3"; _ => false })
    assert(match plan.probe(header).unwrap().kind { .HeaderCheck { header } => header == "sqlite3.h"; _ => false })
    assert(match plan.probe(compile).unwrap().kind { .CompileCheck { name, .. } => name == "sqlite-wal"; _ => false })
    assert_eq(plan.target(lib).unwrap().probes, [cc, sqlite, header, compile])
}

// Rust: tests/build_graph.rs:362
#Test("declared_target_toolchain_wins_over_ambient_host_tool") {
    // GATE #4494: native PATH, canonicalization, process execution and file operations.
    false_path :: env.var_os("PATH").into_iter().flat_map(fn(paths) { env.split_paths(&paths).collect::<[OSPath]>() }).map(fn(directory) { directory.join("false") }).find(fn(path) { path.is_file() }).expect("the test host needs a `false` executable")
    declared_false :: fs.canonicalize(&false_path).unwrap()
    b := BuildContext.new()
    toolchain :: b.toolchain("declared-native", ToolchainSpec.target("x86_64-linux-gnu", BuildProvenance.jetpack_dependency("toolchain.native#1", LockRecord.new("toolchain:native", "sha256:native"))).with_host_triple("x86_64-linux-gnu").with_tool("cc", false_path.to_string_lossy())).unwrap()
    probe :: b.probe("declared-cc", ProbeSpec.header_check("stddef.h").with_toolchain(toolchain)).unwrap()
    target :: b.add_library("declared-native-probe", TargetSpec.new().with_toolchain(toolchain).with_probe(probe)).unwrap()
    plan :: b.plan_with_default(target).unwrap()
    root :: env.temp_dir().join("jet-declared-toolchain-{process.id()}")
    _ :: fs.remove_dir_all(&root)
    fs.create_dir_all(&root).unwrap()
    grants :: [BuildCapability.Exec].into_iter().collect::<BTreeSet<BuildCapability>>()
    error :: execute_build_plan_with_front_end_and_remote(&plan, &root, &grants, FrontEndCompletion.all_complete(), None).unwrap_err()
    assert(match error { .ProbeFailed { detail, .. } => detail.contains(declared_false.to_string_lossy().as_ref()); _ => false }, "declared target tool must be used instead of ambient PATH: {error:?}")
    _ :: fs.remove_dir_all(root)
}

// Rust: tests/build_graph.rs:426
#Test("foreign_toolchain_probe_and_signer_handles_are_rejected") {
    a := BuildContext.new()
    b := BuildContext.new()
    toolchain :: b.toolchain("other", ToolchainSpec.target("wasm32-wasi", BuildProvenance.jetpack_dependency("toolchain.wasm32-wasi#2026.07", LockRecord.new("toolchain:wasm32-wasi", "sha256:wasm")))).unwrap()
    signer :: b.signing_identity("other-signer", SigningIdentitySpec.new("developer-id:OTHER", BuildProvenance.user_declared("keychain:other", None))).unwrap()
    probe :: b.find_program("other-cc", "cc").unwrap()
    err :: a.add_executable("bad-toolchain", TargetSpec.new().with_toolchain(toolchain)).unwrap_err()
    assert_eq(err, BuildError.UnknownToolchain(toolchain.id()))
    err :: a.add_executable("bad-signer", TargetSpec.new().with_signing_identity(signer)).unwrap_err()
    assert_eq(err, BuildError.UnknownSigningIdentity(signer.id()))
    err :: a.add_library("bad-probe", TargetSpec.new().with_probe(probe)).unwrap_err()
    assert_eq(err, BuildError.UnknownProbe(probe.id()))
}

