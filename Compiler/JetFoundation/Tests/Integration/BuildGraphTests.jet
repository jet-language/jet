// Rust: tests/build_graph.rs:615
#Test("action_keys_are_deterministic_and_cover_cache_contract") {
    // Rust: tests/build_graph.rs:616
    fn key(argv: &[String], env_value: String, input: String, output: String, cap: BuildCapability, target_triple: String, probe_package: String, signer_label: String, label_value: String) -> String {
        b := BuildContext.new()
        toolchain :: b.toolchain("tc", ToolchainSpec.target(target_triple, BuildProvenance.jetpack_dependency("toolchain.{target_triple}#2026.07", LockRecord.new("toolchain:{target_triple}", "sha256:tc")))).unwrap()
        probe :: b.probe("probe", ProbeSpec.pkg_config(probe_package).with_reproducibility(ReproducibilityClass.Reproducible).with_provenance(BuildProvenance.jetpack_dependency("pkg-config:{probe_package}#1", LockRecord.new("probe:{probe_package}", "sha256:probe")))).unwrap()
        signer :: b.signing_identity("signer", SigningIdentitySpec.new(signer_label, BuildProvenance.user_declared("keychain:{signer_label}", Val(LockRecord.new("signing:release", "sha256:signer"))))).unwrap()
        action :: b.action("compile", ActionSpec.cached(argv.iter().copied()).with_inputs([input]).with_outputs([output]).with_env("MODE", env_value).with_cap(cap).with_toolchain(toolchain).with_probe(probe).with_signing_identity(signer).with_label("profile", label_value)).unwrap()
        plan :: b.plan().unwrap()
        plan.action_key(action).unwrap().as_str().to_string()
    }
    base :: key(&["jetc", "--emit", "obj"], "release", "src/main.jet", "build/main.o", BuildCapability.Exec, "x86_64-linux", "sqlite3", "developer-id:ACME", "release")
    assert_eq(base, key(&["jetc", "--emit", "obj"], "release", "src/main.jet", "build/main.o", BuildCapability.Exec, "x86_64-linux", "sqlite3", "developer-id:ACME", "release"))
    assert_ne(base, key(&["jetc", "--emit", "asm"], "release", "src/main.jet", "build/main.o", BuildCapability.Exec, "x86_64-linux", "sqlite3", "developer-id:ACME", "release"))
    assert_ne(base, key(&["jetc", "--emit", "obj"], "debug", "src/main.jet", "build/main.o", BuildCapability.Exec, "x86_64-linux", "sqlite3", "developer-id:ACME", "release"))
    assert_ne(base, key(&["jetc", "--emit", "obj"], "release", "src/lib.jet", "build/main.o", BuildCapability.Exec, "x86_64-linux", "sqlite3", "developer-id:ACME", "release"))
    assert_ne(base, key(&["jetc", "--emit", "obj"], "release", "src/main.jet", "build/lib.o", BuildCapability.Exec, "x86_64-linux", "sqlite3", "developer-id:ACME", "release"))
    assert_ne(base, key(&["jetc", "--emit", "obj"], "release", "src/main.jet", "build/main.o", BuildCapability.FS, "x86_64-linux", "sqlite3", "developer-id:ACME", "release"))
    assert_ne(base, key(&["jetc", "--emit", "obj"], "release", "src/main.jet", "build/main.o", BuildCapability.Exec, "aarch64-linux-musl", "sqlite3", "developer-id:ACME", "release"))
    assert_ne(base, key(&["jetc", "--emit", "obj"], "release", "src/main.jet", "build/main.o", BuildCapability.Exec, "x86_64-linux", "openssl", "developer-id:ACME", "release"))
    assert_ne(base, key(&["jetc", "--emit", "obj"], "release", "src/main.jet", "build/main.o", BuildCapability.Exec, "x86_64-linux", "sqlite3", "developer-id:OTHER", "release"))
    assert_ne(base, key(&["jetc", "--emit", "obj"], "release", "src/main.jet", "build/main.o", BuildCapability.Exec, "x86_64-linux", "sqlite3", "developer-id:ACME", "coverage"))
}

// Rust: tests/build_graph.rs:835
#Test("artifact_store_round_trips_blobs_and_restores_declared_outputs") {
    root :: env.temp_dir().join("jet_artifact_store_{process.id()}_restore")
    _ :: fs.remove_dir_all(&root)
    fs.create_dir_all(root.join("work/build")).unwrap()
    store :: test_artifact_store(&root)
    digest :: store.put_blob("hello artifact".bytes()).unwrap()
    assert_eq(store.get_blob(&digest).unwrap().unwrap(), "hello artifact".bytes())
    b := BuildContext.new()
    action :: b.action("emit", ActionSpec.cached(["jetc", "src/main.jet"]).with_outputs(["build/out.txt"])).unwrap()
    plan :: b.plan().unwrap()
    key :: plan.action_key(action).unwrap()
    fs.write(root.join("work/build/out.txt"), "compiled bytes").unwrap()
    record :: capture_declared_outputs(&store, &root.join("work"), plan.action(action).unwrap(), key, ActionOutcome.Succeeded { exit_code: 0 }, ActionCacheProvenance.miss(CacheMissReason.NoLocalActionRecord)).unwrap()
    fs.write(root.join("work/build/out.txt"), "stale").unwrap()
    restore_action_outputs(&store, &root.join("work"), plan.action(action).unwrap(), &record).unwrap()
    assert_eq(fs.read_to_string(root.join("work/build/out.txt")).unwrap(), "compiled bytes")
    assert_eq(record.outputs[0].byte_len, U64.from("compiled bytes".len()))
    _ :: fs.remove_dir_all(&root)
}

