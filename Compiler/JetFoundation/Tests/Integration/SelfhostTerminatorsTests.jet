#Test("jet_lexer_payload_golden_covers_whitespace_exponents_and_shifted_spans") {
    assert(tir_support.have_rustc(), "AOT proof is required, never skipped")
    (source, expected) :: lexer_payload_golden_program()
    tir_support.assert_tiers_agree("selfhost_lexer_payload_golden", source, expected)
    tir_support.assert_awaited_web_tier("selfhost_lexer_payload_web", source, expected)
}
// Rust: tests/selfhost_terminators.rs:429
#Test("jet_lexer_exports_parser_ready_tokens_spans_payloads_and_diagnostics") {
    source :: "{PASS_SOURCE}\nfn run() -> {{\n    result :: lex_payload(\"Name 500ms 1.25 true \\\"ok\\\" 'x'\", false)\n    print(result.tokens[0].kind)\n    print(result.tokens[0].payload.text)\n    print(result.tokens[1].kind)\n    print(result.tokens[1].payload.integer ?? -1)\n    print(result.tokens[1].payload.suffix)\n    print(result.tokens[2].kind)\n    print(result.tokens[2].payload.decimal ?? Float{{0}})\n    print(result.tokens[3].kind)\n    print(result.tokens[4].kind)\n    print(result.tokens[4].payload.decoded)\n    print(result.tokens[5].kind)\n    print(result.tokens[5].payload.decoded)\n    print(result.tokens[6].kind)\n    print(result.diagnostics.len())\n    interpolated :: lex_payload(\"\\\"a{{value + 1}}b\\\"\".bytes(), false)\n    print(interpolated.tokens[0].payload.string_parts.len())\n    print(interpolated.tokens[0].payload.string_parts[0].kind)\n    print(interpolated.tokens[0].payload.string_parts[1].kind)\n    print(interpolated.tokens[0].payload.string_parts[1].tokens.len())\n    print(interpolated.tokens[0].payload.string_parts[1].tokens[0].span.start)\n    print(interpolated.tokens[0].payload.string_parts[1].tokens[3].kind)\n    print(interpolated.tokens[0].payload.string_parts[1].tokens[3].span.start)\n    terminated :: lex(\"fn f() {{\\n    value\\n}}\".bytes())\n    print(terminated.tokens[6].kind)\n    print(terminated.tokens[6].span.start)\n    print(terminated.tokens[6].span.end)\n    bad :: lex_payload(\"§§\".bytes(), false)\n    print(bad.diagnostics.len())\n    print(bad.diagnostics[0].span.start)\n    print(bad.diagnostics[1].span.start)\n    prefix :: lex_payload(\"r\\\"bad\\\"\".bytes(), false)\n    print(prefix.diagnostics[0].code)\n    print(prefix.diagnostics[0].span.end)\n}}\n"
    (code, stdout, stderr) :: tir_support.jit_run("selfhost_parser_ready_lexer", source)
    assert_eq(code, 0, "lexer interface run failed:\n{stderr}")
    assert_eq(stdout, "1\nName\n6\n500\nms\n5\n1.25\n8\n3\nok\n7\nx\n49\n0\n3\n1\n2\n4\n3\n49\n12\n86\n18\n18\n2\n0\n2\nE0003\n1\n")
}
// Rust: tests/selfhost_terminators.rs:442
#Test("jet_lexer_scans_inline_foreign_bodies_and_interpolations") {
    source := PASS_SOURCE
    &source.push_str("\nfn run() -> {\n")
    &source.push_str("    foreign :: lex_payload(`#FFI(C) fn f() { \"\"\"int f() { return \"x\"; }\"\"\" }`.bytes(), false)\n")
    &source.push_str("    print(foreign.tokens[10].payload.decoded)\n    print(foreign.tokens[10].payload.string_parts[0].kind)\n    print(foreign.diagnostics.len())\n")
    &source.push_str("    missing :: lex_payload(`#FFI(C) fn bad() { \"\"\"int f() {`.bytes(), false)\n")
    &source.push_str("    print(missing.diagnostics.len())\n    print(missing.diagnostics[0].code)\n    diagnostic_span :: missing.diagnostics[0].span ?? return\n    print(diagnostic_span.start)\n")
    &source.push_str("    commented :: lex_payload(`\"a{ /* } */ value + 1}b\"`.bytes(), false)\n    print(commented.tokens[0].payload.string_parts[1].tokens[1].payload.text)\n    print(commented.tokens[0].payload.string_parts[1].tokens[1].span.start)\n}\n")
    (code, stdout, stderr) :: tir_support.jit_run("selfhost_inline_foreign_lexer", source)
    assert_eq(code, 0, "inline foreign lexer run failed:\n{stderr}")
    assert_eq(stdout, "int f() { return \"x\"; }\n1\n0\n1\nE0002\n19\nvalue\n12\n")
}
// Rust: tests/selfhost_terminators.rs:467
