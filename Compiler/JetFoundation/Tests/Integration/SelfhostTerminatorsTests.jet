use SelfhostTerminators.[pass, bootstrap, lower_bundle, decode_events, WITNESSES, PASS_SOURCE, assert_lex_equal, compiler_must_fail, golden_program, lexer_payload_golden_program]
use jet_lexer as Lexer
use jet_lexer.[TerminatorDriver, TerminatorEvent]
use jet_parser as Parser
use jet_loader as Loader
use jet_codegen.MIREval.[evaluate_mir_function_with_config, MirEvalConfig, MirExecutionStatus, MirValue]
use jet_driver.[run_compiler_work]
use Common as common
use TirSupport as tir_support
// GATE #4494: native files, shared mutex/atomic state and real unwind scope restoration.
use std.fs
use std.panic.[catch_unwind, AssertUnwindSafe]
use std.sync.[Shared, Mutex]
use std.sync.atomic.[AtomicUsize, Ordering]

// Rust: tests/selfhost_terminators.rs:187
#Test("jet_policy_matches_bounded_reference_and_downstream_parser") {
    compiled :: pass()
    run_compiler_work(fn() {
        loop witness in WITNESSES {
            expected :: Lexer.lex(witness.source)
            actual :: Lexer.with_terminator_driver(Val(compiled.driver()), fn() { Lexer.lex(witness.source) })
            assert_lex_equal(witness.name, actual, expected)
            reference_parse :: Parser.parse_with_source(expected.0, witness.source)
            candidate_parse :: Parser.parse_with_source(actual.0, witness.source)
            assert_eq("{candidate_parse:?}", "{reference_parse:?}", "{witness.name}: downstream parser")
            if witness.name == "split-arrow" || witness.name == "split-block-crlf" || witness.name == "split-retired-arrow" || witness.name == "split-effect-spellings" {
                assert(actual.1.any(fn(diagnostic) { diagnostic.code == "E0986" }), "{witness.name}: invalid split header must retain E0986")
            }
            if witness.parses {
                assert(actual.1.is_empty(), "{witness.name}: unexpected lexer diagnostic")
                assert(candidate_parse.is_ok(), "{witness.name}: complete program must parse")
            }
        }
        variants :: [
            ("own-source", PASS_SOURCE, Lexer.lex),
            ("config-url", "url: https://example.test/a\nname: \"probe\"\n", Lexer.lex_config),
            ("generated-name", "fn __generated() {\n    return 1\n}\n", Lexer.lex_generated)
        ]
        loop (name, source, lex) in variants {
            expected :: lex(source)
            actual :: Lexer.with_terminator_driver(Val(compiled.driver()), fn() { lex(source) })
            assert_lex_equal(name, actual, expected)
            assert_eq("{Parser.parse_with_source(actual.0, source):?}", "{Parser.parse_with_source(expected.0, source):?}", "{name}: parser")
        }
    })
}
// Rust: tests/selfhost_terminators.rs:221
#Test("scoped_candidate_reaches_overlay_loader_parser_and_checked_mir") {
    compiled :: pass()
    scratch :: common.Scratch.new("selfhost_terminator_overlay")
    tir_support.write_test_package(scratch.path, tir_support.TIR_TEST_PACKAGE)
    entry :: scratch.path.join("run.jet")
    helper :: scratch.path.join("helper.jet")
    entry_source :: "use helper as h\nfn observed() -> Int { return h.answer() }\nfn run() { print(observed()) }\n"
    helper_source :: "pub fn answer() -> Int {\n    return 42\n}\n"
    fs.write(entry, "fn run() {}\n").unwrap()
    fs.write(helper, helper_source).unwrap()
    seen :: Shared.new(Mutex.new([[U8]]{}))
    observed :: seen.clone()
    driver: TerminatorDriver :: Shared.new(fn(source, facts) -> [TerminatorEvent] Err! {
        events :: compiled.evaluate(source, facts, U64{50000000})?
        observed.lock().unwrap().push(source.to_vec())
        events
    })
    Lexer.with_terminator_driver(Val(driver), fn() {
        run_compiler_work(fn() {
            bundle := Loader.load_entry_with_overlays(entry.to_str().unwrap(), [(entry, entry_source), (helper, helper_source)], false)
                .expect("candidate lexer must feed the real overlay Loader")
            mir :: lower_bundle(&bundle, "overlay terminator fixture")
            function :: mir.functions.find(fn(row) { row.name == "observed" }).unwrap().id
            result :: evaluate_mir_function_with_config(mir, function, [MirValue]{}, MirEvalConfig.default()).expect("checked imported value executes")
            assert_eq(result.status, MirExecutionStatus.Completed)
            if result.value == {
                .Present(value) -> { if value == { .Int(42) -> {}; else -> assert(false, "scoped compiler must preserve the imported function's result") } }
                else -> assert(false, "scoped compiler must preserve the imported function's result")
            }
        })
    })
    sources :: seen.lock().unwrap()
    assert(sources.any(fn(source) { source == entry_source.bytes() }), "entry overlay bypassed candidate")
    assert(sources.any(fn(source) { source == helper_source.bytes() }), "import overlay worker bypassed candidate")
    assert(Lexer.terminator_driver().is_none())
}
// Rust: tests/selfhost_terminators.rs:269
#Test("callback_evaluator_and_event_abi_failures_are_not_reference_fallbacks") {
    compiled :: pass()
    compiler_must_fail(Shared.new(fn(_, _) { Err("deliberate callback failure") }), "deliberate callback failure")
    compiler_must_fail(Shared.new(fn(source, facts) { compiled.evaluate(source, facts, U64{0}) }), "exhausted its fuel")
    compiler_must_fail(Shared.new(fn(_, _) { decode_events(MirValue.String("wrong ABI")) }), "non-list carrier")
    compiler_must_fail(Shared.new(fn(_, _) { [TerminatorEvent.InsertSemi{before: Int.MAX, at: 0}] }), "invalid raw-token index")
    compiler_must_fail(Shared.new(fn(_, _) { [TerminatorEvent.InsertSemi{before: 0, at: 0}, TerminatorEvent.InsertSemi{before: 0, at: 0}] }), "event order")
}
// Rust: tests/selfhost_terminators.rs:282
#Test("scoped_driver_restores_outer_candidate_after_nested_unwind") {
    compiled :: pass()
    calls :: Shared.new(AtomicUsize.new(0))
    observed :: calls.clone()
    driver: TerminatorDriver :: Shared.new(fn(source, facts) -> [TerminatorEvent] Err! {
        result :: compiled.evaluate(source, facts, U64{50000000})?
        _ :: observed.fetch_add(1, Ordering.Relaxed)
        result
    })
    run_compiler_work(fn() {
        Lexer.with_terminator_driver(Val(driver), fn() {
            expected :: Lexer.lex("x")
            failed :: catch_unwind(AssertUnwindSafe(fn() {
                Lexer.with_terminator_driver(Val(Shared.new(fn(_, _) { Err("nested candidate") })), fn() { Lexer.lex("x") })
            }))
            assert(failed.is_err())
            assert_lex_equal("restored outer driver", Lexer.lex("x"), expected)
        })
    })
    assert_eq(calls.load(Ordering.Relaxed), 2, "nested unwind lost the real evaluator")
    assert(Lexer.terminator_driver().is_none())
}
// Rust: tests/selfhost_terminators.rs:304
#Test("six_policy_mutations_are_killed_through_candidate_event_application") {
    mutations :: [
        ("omit-eof", "if ends_statement(previous) && previous != K_RBRACE {", "if false {", "x"),
        ("minus-boundary", "|| kind == K_MINUS || kind == K_STAR", "|| kind == K_STAR", "x\n-y"),
        ("comment-last-code", "if kind == K_LINE_COMMENT || kind == K_BLOCK_COMMENT -> index += 1 else {", "if kind == K_LINE_COMMENT || kind == K_BLOCK_COMMENT {\n            last_code = index\n            index += 1\n        } else {", "x // c\ny"),
        ("guard-newline", "return !newline_between(source, guard_start, facts[cursor * 4 + 1])", "return true", "x\n.Key && ready\n-> 1"),
        ("unary-not-suppression", "return kind_at(facts, index) == K_BANG && kind_at(facts, index + 1) == K_IDENT && kind_at(facts, index + 2) == K_UNIFIED_ARROW", "return kind_at(facts, index) == K_BANG", "x\n!y"),
        ("shift-synthetic-span", "events.push(end)", "events.push(end + 1)", "x\ny")
    ]
    loop (name, before, after, source) in mutations {
        assert_eq(PASS_SOURCE.matches(before).count(), 1, "mutation {name} must target one decision")
        mutant :: bootstrap(name, PASS_SOURCE.replacen(before, after, 1))
        run_compiler_work(fn() {
            reference :: Lexer.lex(source)
            changed :: Lexer.with_terminator_driver(Val(mutant.driver()), fn() { Lexer.lex(source) })
            assert_ne(changed.0, reference.0, "{name} survived: candidate driver/application was bypassed")
        })
    }
}
// Rust: tests/selfhost_terminators.rs:356
#Test("same_jet_pass_golden_executes_aot_default_interpreter_and_awaited_web") {
    assert(tir_support.have_rustc(), "AOT proof is required, never skipped")
    (source, expected) :: golden_program()
    // Retired tier1/deopt representation assertions are replaced by execution parity.
    tir_support.assert_tiers_agree("selfhost_terminators_golden", source, expected)
    (native_code, native_stdout, stderr) :: tir_support.jit_run("selfhost_terminators_golden", source)
    assert_eq(native_code, 0, "default run failed:\n{stderr}")
    assert_eq(native_stdout, expected, "default pass changed the golden:\n{stderr}")
    tir_support.assert_awaited_web_tier("selfhost_terminators_web", source, expected)
}
