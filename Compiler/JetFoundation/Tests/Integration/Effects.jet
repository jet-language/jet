// Effect inference and boundary proof tests (D-EFF1, D-QUAL1).
use jet.[compile]

// Rust: tests/effects.rs:10
fn codes(src: String) -> [String] {
    if compile(src) == {
        .Ok(_) -> [String]{}
        .Err(diags) -> diags.iter().map((d) -> d.code.clone()).collect()
    }
}
