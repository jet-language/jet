//RS /// D-BOUND-UNDO1=A: the native inline-FFI bridge executes the compensating
//RS /// function when the transaction fails, so the declaration cannot bypass the
//RS /// existing rollback guard at runtime.
//RS #[test]
//RS fn transact_inline_ffi_undo_runs_and_unwinds_lifo() {
