// Rust: tests/pin.rs:368
#Test("two_pins_on_sibling_fields_do_not_conflict") {
    src :: NODE + """
struct Pair {
    left: Node
    right: Node
}
fn run() {
    pair := Pair{left: Node{payload: 1, hops: 0}, right: Node{payload: 2, hops: 0}}
    first :: mem.pin(&pair.left)
    second :: mem.pin(&pair.right)
    first.hops += 1
    second.hops += 2
    print("{(first.hops)} {(second.hops)}")
}
"""
    assert_eq(error_codes(src), [])
    assert_eq(interpret(src), "1 2\n")
    if build_and_run("sibling_pins", src, false) is Val(out) { assert_eq(out, "1 2\n") }
}
// Rust: tests/pin.rs:396
