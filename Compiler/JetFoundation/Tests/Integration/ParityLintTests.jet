use Compiler.JetFoundation.Tests.Integration.ParityLint.*
use Compiler.JetFoundation.Tests.Integration.Pin.*

// Rust: tests/parity_lint.rs:289
#Test("every_tier_parity_promise_has_one_mechanical_grade") {
    (sites, errors) := scan(root())
    sites.sort_by((left, right) -> (left.path, left.line).cmp((right.path, right.line)))
    assert(errors.is_empty(), "ungraded parity promises:\n  {errors.join("\n  ")}")
    assert(!sites.is_empty(), "the parity inventory found no promise comments")
    loop site in sites { print("{site.path}:{site.line} — {site.grade}") }
}
// Rust: tests/parity_lint.rs:307
#Test("new_unbacked_duplication_comment_is_rejected") {
    source :: "// hand-copy matches AOT\nfn copied() {}\n"
    (line, comment) :: comment_blocks(source).into_iter().find((entry) -> is_parity_promise(entry.1)).expect("seeded promise comment")
    error :: validate_grade(root(), "crates/jet-jit/src/new_copy.rs", source, comment).expect_err("a comment without a mechanical link must fail")
    assert(error.contains("parity:` grade") || error.contains("parity: grade"), "line {line}: unexpected lint error: {error}")
}
// Rust: tests/parity_lint.rs:322
#Test("include_grade_must_name_real_include_code") {
    source :: "// matches AOT\n// parity: include path=crates/jet-codegen/src/Prelude/Core/EncodingBase.rs\n"
    (_, comment) :: comment_blocks(source).into_iter().find((entry) -> is_parity_promise(entry.1)).expect("seeded promise comment")
    error :: validate_grade(root(), "crates/jet-jit/src/new_copy.rs", source, comment).expect_err("an include path written only in a comment must fail")
    assert(error.contains("does not include the canonical source"), "{error}")
}
// Rust: tests/parity_lint.rs:337
#Test("jet_jit_and_tir_eval_cannot_card_a_parity_gap") {
    loop path in ["crates/jet-jit/src/new_copy.rs", "crates/jet-codegen/src/Codegen/TIR/eval/new_copy.rs"] {
        source :: "// matches AOT\n// parity: gap card=#1711 risk=hand-copy\n"
        (_, comment) :: comment_blocks(source).into_iter().find((entry) -> is_parity_promise(entry.1)).expect("seeded promise comment")
        error :: validate_grade(root(), path, source, comment).expect_err("engine parity gaps must have a mechanical link")
        assert(error.contains("require include, marshal, or guard"), "{path}: {error}")
    }
}

// Rust: tests/pin.rs:142
#Test("moving_a_pinned_place_is_e0219") {
    src :: NODE + """
fn consume(n: ^Node) -> Int { return n.payload }
fn run() {
    node := Node{payload: 7, hops: 0}
    pinned :: mem.pin(&node)
    taken :: consume(^node)
    print("{taken} {(pinned.payload)}")
}
"""
    assert_eq(error_codes(src), ["E0219"])
}
// Rust: tests/pin.rs:159
#Test("replacing_a_pinned_place_is_e0219") {
    src :: NODE + """
fn run() {
    node := Node{payload: 7, hops: 0}
    pinned :: mem.pin(&node)
    node = Node{payload: 9, hops: 0}
    print("{(pinned.payload)}")
}
"""
    assert_eq(error_codes(src), ["E0219"])
}
