// Rust: tests/pin.rs:421
#Test("a_pin_cannot_cross_a_task_boundary") {
    src :: NODE + """
fn run() {
    node := Node{payload: 7, hops: 0}
    pinned :: mem.pin(&node)
    handle :: task pinned.payload
    print("{(handle.join() ?? 0)}")
}
"""
    codes :: error_codes(src)
    assert(!codes.is_empty(), "a pin is a borrow into one owner's storage; it must not cross a task")
}
// Rust: tests/pin.rs:442
#Test("a_library_may_return_a_pin_field_from_an_owner_parameter") {
    src :: NODE + """
struct Queue {
    label: String
    head: Pin<Node>
}
fn attach(label: String, node: &Node) -> Queue from node {
    return Queue{label: ~label, head: mem.pin(&node)}
}
fn run() {
    node := Node{payload: 41, hops: 0}
    queue :: attach("ready", &node)
    queue.head.hops += 1
    queue.head.payload += 1
    print("{(queue.label)} {(queue.head.payload)} {(queue.head.hops)}")
}
"""
    assert_eq(error_codes(src), [])
    assert_eq(interpret(src), "ready 42 1\n")
    if build_and_run("return_pin_field", src, false) is Val(out) { assert_eq(out, "ready 42 1\n") }
}
