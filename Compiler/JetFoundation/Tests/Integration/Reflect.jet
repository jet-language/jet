// D-METAREFLECT1 / D-REFLECT1 rich reflection.
use jet.Comptime.[CtValue]
use jet.Diagnostics.[Span]
use jet.AST.[AccessConvention, Field, Func, Param, ParamZone, Type]

// Rust: tests/reflect.rs:17
fn span() -> Span { Span.new(0, 1) }

// Rust: tests/reflect.rs:163
fn field(name: String, ty: String, is_pub: Bool) -> Field {
    Field{
        is_pub: is_pub,
        is_package_pub: false,
        name: name.to_string(),
        name_span: span(),
        ty: Type.Named(ty.to_string()),
        ty_span: span(),
        serde_markers: [],
        redact: false,
        computed: nil,
        default: nil,
        default_ct: nil,
    }
}

// Rust: tests/reflect.rs:179
fn method(name: String, is_pub: Bool) -> Func {
    Func{
        span: span(),
        is_pub: is_pub,
        is_package_pub: false,
        is_comptime: false,
        external_type: nil,
        name: name.to_string(),
        name_span: span(),
        type_params: [],
        head_pattern: nil,
        params: [Param{
            convention: AccessConvention.Read,
            root: false,
            name: "self",
            name_span: span(),
            public_label: nil,
            zone: ParamZone.Either,
            ty: Type.Named("Self"),
            ty_span: span(),
            default: nil,
            variadic: false,
            variadic_bound_list: nil,
            declared_view_from_names: nil,
        }],
        return_type: Type.Named("String"),
        return_type_span: span(),
        return_view_provenance: nil,
        declared_return_view_provenance: nil,
        gc_return: false,
        diverges: false,
        gc_scope: false,
        is_unsafe: false,
        unsafe_reason: nil,
        unsafe_span: nil,
        is_pure: false,
        is_sanitizer: false,
        scrub_tag: nil,
        is_reactive: false,
        reactive_upgrades: [],
        is_replayable: false,
        replayable_span: nil,
        declared_effects: nil,
        pre: [],
        post: [],
        effect_via: nil,
        state_requires: nil,
        state_transition: nil,
        web_marker: nil,
        is_must_use: false,
        must_use_span: nil,
        maturity: nil,
        maturity_span: nil,
        kernel: nil,
        is_inline: false,
        is_inline_always: false,
        inline_span: nil,
        meta: nil,
        is_job: false,
        job_span: nil,
        every: nil,
        job_metadata: nil,
        inline_foreign: nil,
        undo: nil,
        markers: [],
        compiler_generated: false,
        body: [],
    }
}

// Rust: tests/reflect.rs:249
fn list_len(v: &CtValue) -> USize {
    if v == {
        .List(xs) -> xs.len()
        else -> panic("expected list, got {v:?}")
    }
}

// Rust: tests/reflect.rs:256
fn struct_field(v: &CtValue, name: String) -> &CtValue {
    fields :: if v == {
        .Struct { fields, .. } -> fields
        else -> panic("expected struct")
    }
    &fields.iter().find(((n, _)) -> n == name).unwrap().1
}

// Rust: tests/reflect.rs:263
fn list_struct_field(v: &CtValue, index: USize, name: String) -> &CtValue {
    values :: if v == {
        .List(values) -> values
        else -> panic("expected list")
    }
    struct_field(&values[index], name)
}
