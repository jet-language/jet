use std.[fs, env]
use std.process.Command
use jet
use jet_foundation.Tests.Integration.Common.[have_rustc, Scratch]
use jet_foundation.Tests.Integration.LibraryOutputs.*
// GATE #4494: real native builds, loader lifecycle and foreign process calls.
// GATE #4483: Unix-only suite and per-target shared library/link flags.
// Rust: tests/library_outputs.rs:115
#Test("native_and_component_exports_share_one_typed_surface") {
    if core.sys.target.selected_family() != "unix" { return }
    fixture :: OSPath.from(env.var_os("CARGO_MANIFEST_DIR").unwrap()).join("Examples/features/packages/library_loadable")
    scratch :: Scratch.new("embedding-parity")
    copy_tree(&fixture, &scratch.path)
    source :: scratch.path.join("library.jet").to_string_lossy()
    library :: jet.compile_library(&source, None).expect("native Library codegen should accept the fixture").library.expect("native Library artifacts")
    plugin :: jet.compile_plugin(&source).expect("sandbox Component codegen should accept the fixture").plugin.expect("sandbox Component artifacts")
    assert(plugin.exports.iter().all(fn(export) -> export.scalar.is_some()), "the scalar library fixture must expose a concrete scalar for every Component export")
    library_rows :: library.exports.iter().map(fn(export) -> (export.name.clone(), Some(export.scalar), export.conventions.clone())).collect()
    plugin_rows :: plugin.exports.iter().map(fn(export) -> (export.name.clone(), export.scalar, export.params.clone())).collect()
    assert_eq(library_rows, plugin_rows)
    assert_eq(plugin.exported_fns, library.exports.iter().map(fn(export) -> export.name.clone()).collect())
}
// Rust: tests/library_outputs.rs:164
#Test("guest_import_library_calls_native_c_and_cpp_hosts") {
    if core.sys.target.selected_family() != "unix" { return }
    assert(have_rustc(), "guest import proof requires rustc")
    cc :: cc().expect("guest import C proof requires a C compiler")
    cxx :: cxx().expect("guest import C++ proof requires a C++ compiler")
    fixture :: OSPath.from(env.var_os("CARGO_MANIFEST_DIR").unwrap()).join("tests/fixtures/guest_import_library")
    scratch :: Scratch.new("guest-import-library")
    copy_tree(&fixture, &scratch.path)
    build :: run_jet(&scratch.path, ["build", "--lib", "library.jet"])
    assert(build.status.success(), "guest import Library build failed:\n{compiler_text(&build)}")
    target :: scratch.path.join(".jet/build")
    archive :: target.join("libguestimport.a")
    header :: target.join("guestimport.h")
    assert(archive.is_file(), "guest import build missed {archive.display()}")
    assert(header.is_file(), "guest import build missed {header.display()}")
    c_source :: scratch.path.join("foreign.c")
    c_binary :: scratch.path.join("foreign-c")
    c_build := Command.new(cc)
    c_build.args(["-std=c11", "-I"]).arg(&target).arg(&c_source).arg(&archive).arg("-o").arg(&c_binary)
    if core.sys.target.selected_os() == "linux" { c_build.args(["-ldl", "-lpthread", "-lm"]) }
    c_result :: c_build.output().unwrap()
    assert(c_result.status.success(), "guest import C host failed to compile:\n{compiler_text(&c_result)}")
    c :: Command.new(&c_binary).output().unwrap()
    assert(c.status.success(), "guest import C host failed at runtime:\n{compiler_text(&c)}")
    assert_eq(String.from_utf8_lossy(&c.stdout), "42\n")
    cpp_source :: scratch.path.join("foreign.cpp")
    cpp_binary :: scratch.path.join("foreign-cpp")
    cpp_build := Command.new(cxx)
    cpp_build.args(["-std=c++17", "-I"]).arg(&target).arg(&cpp_source).arg(&archive).arg("-o").arg(&cpp_binary).arg("-pthread")
    if core.sys.target.selected_os() == "linux" { cpp_build.args(["-ldl", "-lpthread", "-lm"]) }
    cpp_result :: cpp_build.output().unwrap()
    assert(cpp_result.status.success(), "guest import C++ host failed to compile:\n{compiler_text(&cpp_result)}")
    cpp :: Command.new(&cpp_binary).output().unwrap()
    assert(cpp.status.success(), "guest import C++ host failed at runtime:\n{compiler_text(&cpp)}")
    assert_eq(String.from_utf8_lossy(&cpp.stdout), "42\n")
}
// Rust: tests/library_outputs.rs:243
#Test("library_build_load_and_foreign_call_are_one_surface") {
    if core.sys.target.selected_family() != "unix" { return }
    assert(have_rustc(), "Library end-to-end proof requires rustc")
    cc :: cc().expect("Library end-to-end proof requires a C compiler")
    fixture :: OSPath.from(env.var_os("CARGO_MANIFEST_DIR").unwrap()).join("Examples/features/packages/library_loadable")
    scratch :: Scratch.new("library-loadable")
    copy_tree(&fixture, &scratch.path)
    package :: fs.read_to_string(scratch.path.join("package.jet")).unwrap()
    assert(package.contains("outputs: {"))
    fs.write(scratch.path.join("package.jet"), package.replacen("outputs: {", "authority: { holds: { allow: [Exec, IO, Mem.Alloc] } }\noutputs: {", 1)).unwrap()
    expected :: expected_output()
    build :: run_jet(&scratch.path, ["build", "--lib", "library.jet"])
    assert(build.status.success(), "Library build failed:\n{compiler_text(&build)}")
    target :: scratch.path.join(".jet/build")
    shared :: if core.sys.target.selected_os() == "macos" { target.join("libloadable.dylib") } else if core.sys.target.selected_os() == "windows" { target.join("libloadable.dll") } else { target.join("libloadable.so") }
    for path in [target.join("libloadable.a"), target.join("loadable.h"), target.join("loadable.jetlib"), target.join("bindings/loadable.h"), target.join("bindings/loadable.py"), target.join("bindings/loadable.swift")] {
        assert(path.is_file(), "Library build missed {path.display()}")
    }
    assert(shared.is_file(), "Library build missed {shared.display()}")
    artifact :: jet.JetLibArtifact.decode(&fs.read(target.join("loadable.jetlib")).unwrap()).expect("loadable Library metadata should decode")
    assert_eq(artifact.stamp.library_name, "loadable")
    assert_eq(artifact.stamp.abi_version, jet.JetLib.ABI_VERSION)
    assert_eq(artifact.stamp.exports, [jet.JetLibExport.new("greet", jet.JetLibScalar.Text, 1), jet.JetLibExport.new("is_enabled", jet.JetLibScalar.Bool, 1), jet.JetLibExport.new("on_tick", jet.JetLibScalar.Int, 1)])
    jet.JetLib.validate_load_metadata(&artifact.stamp).expect("generated Library metadata should match the loader ABI")
    completion :: fs.read_to_string(target.join(".loadable.jet-library.complete")).unwrap()
    assert(completion.starts_with("jet-library-set-v1\n"))
    for (name, path) in [("libloadable.a", target.join("libloadable.a")), ("loadable.h", target.join("loadable.h")), ("loadable.jetlib", target.join("loadable.jetlib"))] {
        digest :: jet.SHA256.sha256_hex(&fs.read(path).unwrap())
        assert(completion.contains("{name}\tsha256-{digest}\n"), "completion marker missed {name}")
    }
    header_text :: fs.read_to_string(target.join("loadable.h")).unwrap()
    assert(header_text.contains("int64_t on_tick(int64_t p0);"))
    assert(header_text.contains("bool is_enabled(bool p0);"))
    assert(header_text.contains("JetText greet(JetText p0);"))
    assert(header_text.contains("void jet_text_free(JetText value);"))
    c_source :: scratch.path.join("foreign.c")
    assert(c_source.is_file(), "missing checked-in C host example")
    c_binary :: scratch.path.join("foreign")
    c_build := Command.new(cc)
    c_build.arg("-std=c11").arg("-I").arg(&target).arg(&c_source).arg(target.join("libloadable.a")).arg("-o").arg(&c_binary)
    if core.sys.target.selected_os() == "linux" { c_build.args(["-ldl", "-lpthread", "-lm"]) }
    c_result :: c_build.output().unwrap()
    assert(c_result.status.success(), "foreign C caller failed:\n{compiler_text(&c_result)}")
    foreign :: Command.new(&c_binary).output().unwrap()
    assert(foreign.status.success(), "foreign C caller failed at runtime")
    assert_eq(String.from_utf8_lossy(&foreign.stdout), expected.as_str())
    deterministic_paths :: [target.join("libloadable.a"), shared.clone(), target.join("loadable.jetlib"), target.join("loadable.h"), target.join("bindings/loadable.h"), target.join("bindings/loadable.py"), target.join("bindings/loadable.swift")]
    deterministic_before :: deterministic_paths.iter().map(fn(path) -> fs.read(path).unwrap()).collect()
    rebuild :: run_jet(&scratch.path, ["build", "--lib", "library.jet"])
    assert(rebuild.status.success(), "repeat Library build failed:\n{compiler_text(&rebuild)}")
    for (path, before) in deterministic_paths.iter().zip(deterministic_before) { assert_eq(fs.read(path).unwrap(), before, "non-deterministic {path.display()}") }
    cxx :: cxx().expect("C++ Library host proof requires a C++ compiler")
    cpp_source :: scratch.path.join("foreign.cpp")
    assert(cpp_source.is_file(), "missing checked-in C++ host example")
    cpp_binary :: scratch.path.join("foreign-cpp")
    cpp_build := Command.new(cxx)
    cpp_build.arg("-std=c++17").arg("-I").arg(&target).arg(&cpp_source).arg("-o").arg(&cpp_binary).arg("-pthread")
    if core.sys.target.selected_os() == "linux" { cpp_build.arg("-ldl") }
    cpp_result :: cpp_build.output().unwrap()
    assert(cpp_result.status.success(), "foreign C++ host failed to compile:\n{compiler_text(&cpp_result)}")
    cpp :: Command.new(&cpp_binary).arg(&shared).output().unwrap()
    assert(cpp.status.success(), "foreign C++ host failed at runtime:\n{compiler_text(&cpp)}")
    expected_cpp :: expected_cpp_output()
    assert_eq(String.from_utf8_lossy(&cpp.stdout), expected_cpp.as_str())
    panic_scratch :: Scratch.new("library-panic")
    copy_tree(&fixture, &panic_scratch.path)
    fs.write(panic_scratch.path.join("library.jet"), "#Export(c) pub fn panic_now(value: Int) -> Int { panic(\"foreign panic {value}\")\nreturn 0 }\n").unwrap()
    panic_build :: run_jet(&panic_scratch.path, ["build", "--lib", "library.jet"])
    assert(panic_build.status.success(), "panic Library build failed:\n{compiler_text(&panic_build)}")
    panic_shared :: if core.sys.target.selected_os() == "macos" { panic_scratch.path.join(".jet/build/libloadable.dylib") } else if core.sys.target.selected_os() == "windows" { panic_scratch.path.join(".jet/build/libloadable.dll") } else { panic_scratch.path.join(".jet/build/libloadable.so") }
    assert(panic_shared.is_file(), "panic Library build missed {panic_shared.display()}")
    panic_output :: Command.new(&cpp_binary).args(["--panic", panic_shared.to_str().unwrap()]).output().unwrap()
    assert(!panic_output.status.success(), "panic crossed the C ABI as a successful C++ call")
    panic_text :: compiler_text(&panic_output)
    assert(panic_text.contains("Stop [E3001]: `panic: foreign panic 0`"), "panic did not report a runtime panic:\n{panic_text}")
    jit :: run_jet(&scratch.path, ["run", "host.jet"])
    assert(jit.status.success(), "default jet run failed:\n{compiler_text(&jit)}")
    assert_eq(String.from_utf8_lossy(&jit.stdout), expected.as_str())
    aot :: run_jet(&scratch.path, ["run", "--release", "host.jet"])
    assert(aot.status.success(), "AOT jet run failed:\n{compiler_text(&aot)}")
    assert_eq(String.from_utf8_lossy(&aot.stdout), expected.as_str())
    jetlib :: target.join("loadable.jetlib")
    original :: fs.read(&jetlib).unwrap()
    altered := jet.JetLibArtifact.decode(&original).unwrap()
    altered.stamp.compiler_version = "0.0.1-foreign"
    altered.stamp.declared_effects.insert("Net")
    altered.payload = b"not a shared object".to_vec()
    fs.write(&jetlib, altered.encode()).unwrap()
    mismatched :: run_jet(&scratch.path, ["run", "host.jet"])
    assert(!mismatched.status.success(), "mismatched .jetlib unexpectedly loaded")
    mismatched_text :: compiler_text(&mismatched)
    assert(mismatched_text.contains("E1338"), "missing identity refusal:\n{mismatched_text}")
    assert(!mismatched_text.contains("cannot map library payload"), "identity refusal happened after mapping:\n{mismatched_text}")
    altered.stamp.compiler_version = jet.Manifest.COMPILER_VERSION.to_string()
    fs.write(&jetlib, altered.encode()).unwrap()
    over_granted :: run_jet(&scratch.path, ["run", "host.jet"])
    assert(!over_granted.status.success(), "ungranted .jetlib unexpectedly loaded")
    over_granted_text :: compiler_text(&over_granted)
    assert(over_granted_text.contains("E1339"), "missing effect refusal:\n{over_granted_text}")
    assert(!over_granted_text.contains("cannot map library payload"), "effect refusal happened after mapping:\n{over_granted_text}")
    malformed := jet.JetLibArtifact.decode(&original).unwrap()
    malformed.payload = b"not a shared object".to_vec()
    fs.write(&jetlib, malformed.encode()).unwrap()
    before_staging :: all_staged_loader_files()
    (loader_pid, invalid_payload) :: run_jet_with_pid(&scratch.path, ["run", "host.jet"])
    assert(!invalid_payload.status.success())
    invalid_payload_text :: compiler_text(&invalid_payload)
    assert(invalid_payload_text.contains("cannot map library payload"), "missing native mapping diagnostic:\n{invalid_payload_text}")
    assert_eq(staged_loader_files(loader_pid), before_staging.into_iter().filter(fn(name) -> name.starts_with("jet-mod-{loader_pid}-")).collect(), "failed native mapping left a staged payload behind")
    malformed = jet.JetLibArtifact.decode(&original).unwrap()
    malformed.stamp.target = "foreign-target"
    fs.write(&jetlib, malformed.encode()).unwrap()
    wrong_target :: run_jet(&scratch.path, ["run", "host.jet"])
    assert(!wrong_target.status.success())
    wrong_target_text :: compiler_text(&wrong_target)
    assert(wrong_target_text.contains("E1341") && wrong_target_text.contains("targets"), "missing target diagnostic:\n{wrong_target_text}")
    assert(!wrong_target_text.contains("cannot map library payload"), "target refusal happened after mapping:\n{wrong_target_text}")
}
// Rust: tests/library_outputs.rs:539
#Test("guest_embedding_contract_covers_lifecycle_threads_reentry_and_panic") {
    if core.sys.target.selected_family() != "unix" { return }
    assert(have_rustc(), "guest embedding proof requires rustc")
    cxx :: cxx().expect("guest embedding proof requires a C++ compiler")
    fixture :: OSPath.from(env.var_os("CARGO_MANIFEST_DIR").unwrap()).join("Examples/interop/guest_library")
    scratch :: Scratch.new("guest-embedding-contract")
    copy_tree(&fixture, &scratch.path)
    build :: run_jet(&scratch.path, ["build", "--lib", "library.jet"])
    assert(build.status.success(), "guest embedding Library build failed:\n{compiler_text(&build)}")
    target :: scratch.path.join(".jet/build")
    shared :: if core.sys.target.selected_os() == "macos" { target.join("libembedding.dylib") } else if core.sys.target.selected_os() == "windows" { target.join("libembedding.dll") } else { target.join("libembedding.so") }
    assert(shared.is_file(), "guest embedding build missed {shared.display()}")
    header :: target.join("embedding.h")
    assert(header.is_file(), "guest embedding build missed {header.display()}")
    header_text :: fs.read_to_string(&header).unwrap()
    assert(header_text.contains("int64_t on_tick(int64_t p0);"))
    assert(header_text.contains("int64_t reenter(int64_t p0);"))
    assert(header_text.contains("void jet_text_free(JetText value);"))
    cpp_source :: scratch.path.join("foreign.cpp")
    cpp_binary :: scratch.path.join("foreign")
    cpp_build := Command.new(cxx)
    cpp_build.args(["-std=c++17", "-I"]).arg(&target).arg(&cpp_source).arg("-o").arg(&cpp_binary).arg("-pthread")
    if core.sys.target.selected_os() == "linux" { cpp_build.args(["-ldl", "-rdynamic"]) } else if core.sys.target.selected_os() == "macos" { cpp_build.args(["-ldl", "-Wl,-export_dynamic"]) }
    cpp_result :: cpp_build.output().unwrap()
    assert(cpp_result.status.success(), "guest embedding host failed to compile:\n{compiler_text(&cpp_result)}")
    // Host rows cover init/shutdown, threads/TLS, reentry, signals, allocation ownership,
    // panic containment and repeated load/unload. Double-free/post-dlclose are UB-by-C.
    host :: Command.new(&cpp_binary).arg(&shared).output().unwrap()
    assert(host.status.success(), "guest embedding host failed at runtime:\n{compiler_text(&host)}")
    assert_eq(String.from_utf8_lossy(&host.stdout), "embedding-ok\n")
    assert(String.from_utf8_lossy(&host.stderr).contains("Stop [E3001]"), "panic child did not emit the E3001 report:\n{compiler_text(&host)}")
}
