// Rust: tests/library_outputs.rs:672
#Test("library_rejects_colliding_c_symbols_before_codegen") {
    if core.sys.target.selected_family() != "unix" { return }
    fixture :: OSPath.from(env.var_os("CARGO_MANIFEST_DIR").unwrap()).join("Examples/features/packages/library_loadable")
    scratch :: Scratch.new("library-symbol-collision")
    copy_tree(&fixture, &scratch.path)
    fs.write(scratch.path.join("library.jet"), "#Export(c) pub fn café() -> Int { 1 }\n#Export(c) pub fn cafö() -> Int { 2 }\n#Export(c) pub fn jet_text_free() -> String { \"bad\" }\n").unwrap()
    source :: scratch.path.join("library.jet").to_string_lossy()
    errors :: jet.compile_library(&source, None).expect_err("colliding C symbols accepted")
    assert(errors.iter().any(fn(error) -> error.code == "E1341" && error.what.contains("same C symbol")), "missing C symbol collision diagnostic: {errors:?}")
    assert(errors.iter().any(fn(error) -> error.code == "E1341" && error.what.contains("generated C symbol")), "missing generated allocator symbol diagnostic: {errors:?}")
}
// Rust: tests/library_outputs.rs:701
#Test("guest_import_rejects_invalid_signature_and_duplicate_native_symbol") {
    if core.sys.target.selected_family() != "unix" { return }
    fixture :: OSPath.from(env.var_os("CARGO_MANIFEST_DIR").unwrap()).join("tests/fixtures/guest_import_library")
    scratch :: Scratch.new("guest-import-negative")
    copy_tree(&fixture, &scratch.path)
    source :: scratch.path.join("library.jet")
    fs.write(&source, "#Import(c) fn bad(values: [Int]) -> Int = \"guest_bad\"\n#Export(c) pub fn call_host(value: Int) -> Int { value }\n").unwrap()
    source_text :: source.to_string_lossy()
    invalid :: jet.compile_library(&source_text, None).expect_err("non-C-safe guest import signature accepted")
    assert(invalid.iter().any(fn(error) -> error.code == "E3203"), "missing invalid guest import signature diagnostic: {invalid:?}")
    fs.write(&source, "#Import(c) fn mutate(value: &Int) -> Int = \"guest_mutate\"\n#Export(c) pub fn call_host(value: Int) -> Int { value }\n").unwrap()
    capability :: jet.compile_library(&source_text, None).expect_err("capability guest import accepted by the hidden bridge")
    assert(capability.iter().any(fn(error) -> error.code == "E1341" && error.what.contains("hidden C bridge")), "missing capability bridge diagnostic: {capability:?}")
    fs.write(&source, "#Layout(c)\nstruct Pair {\n    value: Int\n}\n#Import(c) fn use_pair(value: Pair) -> Int = \"guest_pair\"\n#Export(c) pub fn call_host(value: Int) -> Int { value }\n").unwrap()
    layout :: jet.compile_library(&source_text, None).expect_err("C-layout guest import accepted by the hidden bridge")
    assert(layout.iter().any(fn(error) -> error.code == "E1341" && error.what.contains("hidden C bridge")), "missing C-layout bridge diagnostic: {layout:?}")
    fs.write(&source, "#Import(c) fn first(value: Int) -> Int = \"call_host\"\n#Export(c) pub fn call_host(value: Int) -> Int { value }\n").unwrap()
    duplicate :: jet.compile_library(&source_text, None).expect_err("duplicate guest native symbol accepted")
    assert(duplicate.iter().any(fn(error) -> error.code == "E1341" && error.what.contains("Guest imports") && error.what.contains("same C symbol")), "missing duplicate guest import symbol diagnostic: {duplicate:?}")
    fs.write(&source, "#Import module c.fake {\n    fn module_host(value: Int) -> Int = \"call_host\"\n}\n#Import(c) fn first(value: Int) -> Int = \"call_host\"\n#Export(c) pub fn call_host(value: Int) -> Int { value }\n").unwrap()
    c_module :: jet.compile_library(&source_text, None).expect_err("C-module and guest import symbol collision accepted")
    assert(c_module.iter().any(fn(error) -> error.code == "E1341" && error.what.contains("C module imports") && error.what.contains("same C symbol")), "missing C-module symbol collision diagnostic: {c_module:?}")
}
// Rust: tests/library_outputs.rs:784
#Test("library_output_selection_is_named_and_fail_closed") {
    if core.sys.target.selected_family() != "unix" { return }
    scratch :: Scratch.new("library-output-selection")
    fs.write(scratch.path.join("package.jet"), "name: \"library-selection\"\nversion: \"0.1.0\"\noutputs: {\n    alpha: .Library{ name: \"alpha\", entry: run, native: true }\n    beta: .Library{ name: \"beta\", entry: run, native: true }\n    app: .Executable{ name: \"app\", entry: run }\n}\n").unwrap()
    fs.write(scratch.path.join("library.jet"), "#Export(c) pub fn on_tick(dt: Int) -> Int { dt + 1 }\nfn run() {}\n").unwrap()
    source :: scratch.path.join("library.jet").to_string_lossy()
    ambiguous :: jet.compile_library(&source, None).expect_err("ambiguous Library accepted")
    assert(ambiguous.iter().any(fn(error) -> error.code == "E1341" && error.what.contains("Multiple Library outputs") && error.fix.contains("alpha, beta")), "missing ambiguous Library diagnostic: {ambiguous:?}")
    selected :: jet.compile_library(&source, Some("beta")).expect("named Library output should compile")
    selected_config :: selected.library_config.unwrap()
    assert_eq(selected_config.name, "beta")
    assert_eq(selected_config.entry.as_deref(), Some("run"))
    missing :: jet.compile_library(&source, Some("missing")).expect_err("missing Library output accepted")
    assert(missing.iter().any(fn(error) -> error.code == "E1341" && error.what.contains("Library output `missing`")), "missing named Library diagnostic: {missing:?}")
    non_library :: jet.compile_library(&source, Some("app")).expect_err("non-Library output accepted")
    assert(non_library.iter().any(fn(error) -> error.code == "E1341" && error.what.contains("Output `app` is not a Library")))
}
// Rust: tests/library_outputs.rs:835
#Test("locked_library_compile_requires_the_lock_stamp") {
    if core.sys.target.selected_family() != "unix" { return }
    scratch :: Scratch.new("library-locked")
    fs.write(scratch.path.join("package.jet"), "name: \"locked-library\"\nversion: \"0.1.0\"\noutputs: { core: .Library{ name: \"core\", native: true } }\n").unwrap()
    fs.write(scratch.path.join("library.jet"), "#Export(c) pub fn on_tick(dt: Int) -> Int { dt + 1 }\n").unwrap()
    source :: scratch.path.join("library.jet").to_string_lossy()
    settings: [String: String] = [:]
    errors :: jet.compile_library_with_gates_and_settings(&source, None, jet.Policy.GateSet.default(), true, &settings).expect_err("locked Library compile accepted a missing lock stamp")
    assert(errors.iter().any(fn(error) -> error.code == "E3512"))
}
// Rust: tests/library_outputs.rs:909
#Test("locked_named_library_build_selects_the_requested_output") {
    if core.sys.target.selected_family() != "unix" { return }
    assert(have_rustc(), "locked Library build proof requires rustc")
    fixture :: OSPath.from(env.var_os("CARGO_MANIFEST_DIR").unwrap()).join("tests/fixtures/foreign_build_hosts/cmake")
    scratch :: library_build_scratch("library-locked-build")
    copy_tree(&fixture, &scratch.path)
    jet_dir :: scratch.path.join(".jet")
    fs.create_dir_all(&jet_dir).unwrap()
    _ :: fs.copy(fixture.join("lock.fixture"), jet_dir.join("lock")).unwrap()
    build :: run_jet(&scratch.path, ["build", "--lib", "--locked", "--output", "core", "library.jet"])
    assert(build.status.success(), "locked named Library build failed:\n{compiler_text(&build)}")
    assert(scratch.path.join(".jet/build/libloadable.a").is_file())
    assert(scratch.path.join(".jet/build/loadable.h").is_file())
    assert(scratch.path.join(".jet/build/loadable.jetlib").is_file())
}
// Rust: tests/library_outputs.rs:933
#Test("default_library_rejects_cross_target_before_publication") {
    if core.sys.target.selected_family() != "unix" { return }
    assert(have_rustc(), "Library target diagnostic proof requires rustc")
    fixture :: OSPath.from(env.var_os("CARGO_MANIFEST_DIR").unwrap()).join("Examples/features/packages/library_loadable")
    scratch :: Scratch.new("library-target")
    copy_tree(&fixture, &scratch.path)
    target :: "--target={env.var("JET_BUILD_TARGET").unwrap()}"
    rejected :: run_jet(&scratch.path, ["build", target.as_str(), "library.jet"])
    assert(!rejected.status.success(), "cross-target Library build unexpectedly succeeded:\n{compiler_text(&rejected)}")
    text :: compiler_text(&rejected)
    assert(text.contains("E1341"), "missing unsupported-target diagnostic:\n{text}")
    shared :: if core.sys.target.selected_os() == "macos" { scratch.path.join(".jet/build/libloadable.dylib") } else if core.sys.target.selected_os() == "windows" { scratch.path.join(".jet/build/libloadable.dll") } else { scratch.path.join(".jet/build/libloadable.so") }
    assert(!scratch.path.join(".jet/build/libloadable.a").exists() && !scratch.path.join(".jet/build/loadable.h").exists() && !scratch.path.join(".jet/build/loadable.jetlib").exists() && !shared.exists(), "unsupported Library target published artifacts")
}
