        header :: "int fresh_value(void);\n"
        fs.write(header_dir.join("rebind.h"), header).unwrap()
        cache_file :: cache_dir.join("rebind.jet")
        stale :: jet.CBind.generate("int stale_value(void);\n", "rebind").unwrap().source
        fs.write(&cache_file, stale).unwrap()
        if value :: sidecar { fs.write(jet.CBind.hash_sidecar_path(&cache_file), value).unwrap() }
        main :: root.join("main.jet")
        fs.write(&main, "use \"include/rebind.h\" as rebind\nfn run() {{ print(rebind.fresh_value()) }}\n").unwrap()
        src :: fs.read_to_string(&main).unwrap()
        result :: jet.compile_with_path(&src, main.to_str().unwrap())
        assert(result.is_ok(), "{case} hash did not trigger rebind: {result:?}")
        assert(fs.read_to_string(&cache_file).unwrap().contains("fresh_value"), "{case} hash left stale cache bytes")
        assert_eq(jet.CBind.read_stored_hash(&cache_file), Val(jet.CBind.compute_bind_hash(header, "")))
        _ :: fs.remove_dir_all(&root)
    }
