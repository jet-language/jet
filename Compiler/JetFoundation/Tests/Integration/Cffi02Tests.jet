#Test("hash_invalidation_on_header_change") {
    root :: env.temp_dir().join("jet_hash_inval_{process.id()}")
    _ :: fs.remove_dir_all(&root)
    cache_dir :: root.join(".jet/bindings/c")
    fs.create_dir_all(&cache_dir).unwrap()
    header_dir :: root.join("include")
    fs.create_dir_all(&header_dir).unwrap()
    header_path :: header_dir.join("mylib2.h")
    header_v1 :: "int mylib2_v1(int x);\n"
    fs.write(&header_path, header_v1).unwrap()
    cache_file :: cache_dir.join("mylib2.jet")
    bind_v1 :: jet.CBind.generate(header_v1, "mylib2").unwrap()
    fs.write(&cache_file, &bind_v1.source).unwrap()
    jet.CBind.write_bind_hash(&cache_file, header_v1, "").unwrap()
    assert(!bind_v1.source.contains("mylib2_v2"), "sanity: v2 not in v1 cache")
    header_v2 :: "int mylib2_v2(int y);\n"
    fs.write(&header_path, header_v2).unwrap()
    main :: root.join("main.jet")
    fs.write(&main, "use \"include/mylib2.h\" as m\nfn run() {{ print(m.mylib2_v2(2)) }}\n").unwrap()
    src :: fs.read_to_string(&main).unwrap()
    result :: jet.compile_with_path(&src, main.to_str().unwrap())
    new_cache :: fs.read_to_string(&cache_file).unwrap_or_default()
    assert(new_cache.contains("mylib2_v2"), "hash invalidation: cache must be regenerated with updated symbol; got:\n{new_cache}")
    assert(!new_cache.contains("mylib2_v1"), "hash invalidation: stale v1 symbol must not appear in regenerated cache; got:\n{new_cache}")
    new_hash :: jet.CBind.read_stored_hash(&cache_file)
    expected_hash :: jet.CBind.compute_bind_hash(header_v2, "")
    assert_eq(new_hash, Val(expected_hash), "hash sidecar must be updated after re-bind")
    _ :: result
    _ :: fs.remove_dir_all(&root)
}
