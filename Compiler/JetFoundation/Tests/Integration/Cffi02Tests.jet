    src :: fs.read_to_string(&main).unwrap()
    out :: jet.compile_with_path(&src, main.to_str().unwrap()).unwrap_or_else(fn(d) { panic("override rejected:\n{d:?}") })
    assert(out.rust.contains("real_add"), "overlay symbol must win")
    assert(!out.rust.contains("gen_add"), "bindgen symbol must be replaced")
    _ :: fs.remove_dir_all(&root)
}
