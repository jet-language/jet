// Rust: tests/cffi.rs:2512
#Test("auto_bind_on_cache_miss") {
    root :: env.temp_dir().join("jet_autobind_miss_{process.id()}")
    _ :: fs.remove_dir_all(&root)
    cache_dir :: root.join(".jet/bindings/c")
    fs.create_dir_all(&cache_dir).unwrap()
    declare_local_c_dep(&root, "mylib")
    build_local_c_provider(&root, "mylib", "int mylib_ping(int value) {{ return value; }}\n")
    header_dir :: root.join("include")
