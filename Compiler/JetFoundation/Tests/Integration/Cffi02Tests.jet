    assert(run.status.success(), "22_ffi runtime failed")
    expected :: fs.read_to_string(root.join("Examples/features/expected/lowlevel/ffi.out")).unwrap()
    assert_eq(String.from_utf8_lossy(&run.stdout), expected)
}
