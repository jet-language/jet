#Test("cffi_sysv64_abi_executes_native_symbol") {
    if selected_arch() != "x86_64" || selected_os() == "windows" { return }
    if !common.have_rustc() { return }
    root :: env.temp_dir().join("jet_cffi_sysv_{process.id()}")
    _ :: fs.remove_dir_all(&root)
    fs.create_dir_all(&root).unwrap()
    fs.write(root.join("abi.c"), "#include <stdint.h>\nint32_t abi_add(int32_t a,int32_t b){{return a+b;}}\n").unwrap()
    cc :: ["cc", "gcc", "clang"].iter().find(fn(x) { Command.new(x).arg("--version").output().is_ok() }).unwrap()
    assert(Command.new(cc).args(["-c"]).arg(root.join("abi.c")).arg("-o").arg(root.join("abi.o")).status().unwrap().success())
    assert(Command.new("ar").arg("rcs").arg(root.join("libabi.a")).arg(root.join("abi.o")).status().unwrap().success())
    declare_local_c_dep(&root, "abi")
    src :: """
use c.abi as c
#Import module c.abi {
    #ABI(sysv64)
    fn add(a: I32, b: I32) -> I32 = "abi_add"
}
fn run() { print(c.add(20, 22)) }
"""
    main :: root.join("main.jet")
    fs.write(&main, src).unwrap()
    out :: jet.compile_with_path(src, main.to_str().unwrap()).unwrap_or_else(fn(d) { panic("{jet.render_diagnostics(main.to_str().unwrap(), src, &d)}") })
    assert(out.rust.contains("extern \"sysv64\""))
    fs.write(root.join("main.rs"), &out.rust).unwrap()
    rustc := Command.new("rustc")
    rustc.args(["--edition", "2021"]).arg(root.join("main.rs")).arg("-o").arg(root.join("main_bin")).arg("-L").arg("native={root.display()}").arg("-labi")
    built :: rustc.output().unwrap()
    assert(built.status.success(), "I2: {String.from_utf8_lossy(&built.stderr)}")
    run :: Command.new(root.join("main_bin")).output().unwrap()
    assert_eq(String.from_utf8_lossy(&run.stdout), "42\n")
    _ :: fs.remove_dir_all(root)
}
// Rust: tests/cffi.rs:2186
#Test("cffi_string_returns_are_borrowed_non_null_utf8_and_copied") {
    if !common.have_rustc() { return }
    root :: env.temp_dir().join("jet_cffi_cstr_{process.id()}")
    _ :: fs.remove_dir_all(&root)
    fs.create_dir_all(&root).unwrap()
    fs.write(root.join("strret.c"), "const char* good(void){{return \"caf\\xC3\\xA9\";}} const char* null_s(void){{return 0;}} const char* bad(void){{static const char s[]={{ (char)0xff,0 }};return s;}}\n").unwrap()
    cc :: ["cc", "gcc", "clang"].iter().find(fn(x) { Command.new(x).arg("--version").output().is_ok() }).unwrap()
    assert(Command.new(cc).args(["-c"]).arg(root.join("strret.c")).arg("-o").arg(root.join("strret.o")).status().unwrap().success())
    assert(Command.new("ar").arg("rcs").arg(root.join("libstrret.a")).arg(root.join("strret.o")).status().unwrap().success())
    declare_local_c_dep(&root, "strret")
    for (name, expected, success) in [("good", "café\n", true), ("null_s", "returned a null pointer", false), ("bad", "not valid UTF-8", false)] {
        src :: "use c.strret as c\n#Import module c.strret {{ fn get() -> String = \"{name}\" }}\nfn run() {{ print(c.get()) }}\n"
        main :: root.join("{name}.jet")
        fs.write(&main, &src).unwrap()
        out :: jet.compile_with_path(&src, main.to_str().unwrap()).unwrap_or_else(fn(d) { panic("{jet.render_diagnostics(main.to_str().unwrap(), &src, &d)}") })
        wrapper :: out.rust.split_once("pub fn __jet_get() -> String {{\n").unwrap_or_else(fn() { panic("missing generated C wrapper for {name}") }).1.split_once("\n}}\n").unwrap_or_else(fn() { panic("unterminated generated C wrapper for {name}") }).0
        assert(wrapper.contains("let p = unsafe {{ {name}() }};"))
        assert(wrapper.contains("if p.is_null()"))
        assert(wrapper.contains("std::ffi::CStr::from_ptr(p)"))
        assert(wrapper.contains("bytes.to_str()"))
        assert(wrapper.contains(".to_owned()"))
        assert(!wrapper.contains("to_string_lossy"))
        assert(!wrapper.contains("/* unsupported:"))
        rs :: root.join("{name}.rs")
        bin :: root.join("{name}_bin")
        fs.write(&rs, &out.rust).unwrap()
        rustc := Command.new("rustc")
        rustc.args(["--edition", "2021"]).arg(&rs).arg("-o").arg(&bin).arg("-L").arg("native={root.display()}").arg("-lstrret")
        built :: rustc.output().unwrap()
        assert(built.status.success(), "I2: {String.from_utf8_lossy(&built.stderr)}")
        run :: Command.new(bin).output().unwrap()
        assert_eq(run.status.success(), success)
        text :: "{String.from_utf8_lossy(&run.stdout)}{String.from_utf8_lossy(&run.stderr)}"
        assert(text.contains(expected), "{name}: {text}")
    }
    _ :: fs.remove_dir_all(root)
}
// Rust: tests/cffi.rs:2279
// Runtime-built strings with embedded NUL must panic, never silently truncate.
#Test("cffi_runtime_interior_nul_panics_instead_of_silently_truncating") {
    if !common.have_rustc() { eprintln("note: skipping cffi_runtime_interior_nul_panics (need rustc)"); return }
    root :: env.temp_dir().join("jet_cffi_nul_panic_{process.id()}")
    _ :: fs.remove_dir_all(&root)
    fs.create_dir_all(&root).unwrap()
    declare_local_c_dep(&root, "jetc436")
    build_local_c_provider(&root, "jetc436", "#include <stddef.h>\nlong long jetc436_strlen(const char *s) {{ const char *p = s; while (*p) ++p; return (long long)(p - s); }}\n")
    main :: root.join("main.jet")
    fs.write(&main, """
use c.jetc436 as c436
#Import module c.jetc436 {
    fn takes_str(s: String) -> Int = "jetc436_strlen"
}
fn run() {
    line :: input() ?? ""
    print(c436.takes_str(line))
}
""").unwrap()
    src :: fs.read_to_string(&main).unwrap()
    out :: jet.compile_with_path(&src, main.to_str().unwrap()).unwrap_or_else(fn(d) { panic("front end rejected the runtime-NUL fixture:\n{jet.render_diagnostics(main.to_str().unwrap(), &src, &d)}") })
    rs :: root.join("main.rs")
    fs.write(&rs, &out.rust).unwrap()
    bin :: root.join("main_bin")
    rustc := Command.new("rustc")
    rustc.args(["--edition", "2021"]).arg(&rs).arg("-o").arg(&bin).arg("-L").arg("native={root.display()}").arg("-ljetc436")
    if link :: out.ffi { add_ffi_bridge_args(&rustc, &link) }
    status :: rustc.output().unwrap()
    assert(status.status.success(), "I2: rustc rejected the runtime-NUL wrapper (jet bug):\n{String.from_utf8_lossy(&status.stderr)}")
    child := Command.new(&bin).stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().unwrap()
    child.stdin.take().unwrap().write_all([97 as U8, 98, 0, 99, 100, 10]).unwrap()
    run :: child.wait_with_output().unwrap()
    assert(!run.status.success(), "a runtime String with an embedded NUL must panic at the C boundary, not silently succeed with a truncated/empty string; stdout was: {String.from_utf8_lossy(&run.stdout):?}")
    _ :: fs.remove_dir_all(&root)
}
// Rust: tests/cffi.rs:2368
#Test("cffi_string_param_emits_cstring_conversion") {
    root :: env.temp_dir().join("jet_cffi_strparam_{process.id()}")
    _ :: fs.remove_dir_all(&root)
    cache :: root.join(".jet/bindings/c")
    fs.create_dir_all(&cache).unwrap()
    declare_local_c_dep(&root, "strlib")
    build_local_c_provider(&root, "strlib", "long long strlib_slen(const char *s) {{ const char *p = s; while (*p) ++p; return (long long)(p - s); }}\n")
    fs.write(cache.join("strlib.jet"), "#Bindgen module c.strlib.__bindgen__ {{ fn slen(s: String) -> Int = \"strlib_slen\" }}\n").unwrap()
    main :: root.join("main.jet")
    fs.write(&main, "use c.strlib as s\nfn run() {{ print(s.slen(\"hello\")) }}\n").unwrap()
    src :: fs.read_to_string(&main).unwrap()
    out :: jet.compile_with_path(&src, main.to_str().unwrap()).unwrap_or_else(fn(d) { panic("string-param C FFI rejected:\n{d:?}") })
    assert(out.rust.contains("let c0 = std::ffi::CString::new"), "wrapper must declare the CString temp for a String param; got:\n{out.rust}")
    assert(out.rust.contains("strlib_slen(c0.as_ptr())"), "wrapper must call through the declared temp; got:\n{out.rust}")
    _ :: fs.remove_dir_all(&root)
}
