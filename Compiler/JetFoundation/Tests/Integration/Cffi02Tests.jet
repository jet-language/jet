    fs.create_dir_all(&cache).unwrap()
    fs.write(root.join("package.jet"), "name: \"ffi_unresolvable\"\nversion: \"0.1.0\"\nauthority: {{\n    holds: {{ allow: [FFI, IO, Browser, DB, Env, Exec, FS, GPU, Log, Net, Rand, Secret, Time, Mem.Alloc] }},\n}}\n").unwrap()
    fs.write(root.join("main.jet"), "extern rust \"not-a-real-crate-xyz@9.9.9\" {{\n    fn foo() -> Int = \"not_a_real_crate_xyz::foo\"\n}}\nfn run() {{ print(foo()) }}\n").unwrap()
    // Rust: tests/cffi.rs:3287 (local tier closure)
    tier :: fn(verb: String) {
        out :: Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args([verb, "main.jet"]).current_dir(&root).env("JET_FFI_CACHE_DIR", &cache).env("NO_COLOR", "1").env("TERM", "dumb").output().unwrap_or_else(fn(error) { panic("spawn jet {verb}: {error}") })
        assert(!out.status.success(), "jet {verb} must fail on an unresolvable crate")
        stderr :: String.from_utf8_lossy(&out.stderr).into_owned()
        assert(!stderr.contains("E0956"), "jet {verb} reported a compiler-bug refusal for a user error:\n{stderr}")
        report :: stderr.lines().filter(fn(line) { line.starts_with("Error [E0704]") || line.starts_with(" Why:") || line.starts_with(" Fix:") }).collect().join("\n")
        assert(report.starts_with("Error [E0704]: Couldn't fetch or build `not-a-real-crate-xyz@9.9.9`"), "jet {verb} did not report E0704:\n{stderr}")
        report
    }
    run :: tier("run")
    build :: tier("build")
    assert_eq(run, build, "run and build must render the same E0704 report")
    _ :: fs.remove_dir_all(&root)
}
