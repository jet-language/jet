// Rust: tests/cffi.rs:3153
#Test("concurrent_processes_share_one_bridge_build_per_key") {
    if Command.new("cargo").arg("--version").output().is_err() { eprintln("note: cargo not found; skipping concurrent FFI bridge test"); return }
    if !common.have_rustc() { eprintln("note: rustc not found; skipping concurrent FFI bridge test"); return }
    root :: common.unique_tmp("jet_ffi_concurrent")
    cache :: root.join("ffi-cache")
    fs.create_dir_all(&cache).unwrap()
    source :: "extern rust \"base64@0.22\" {{\n    fn b64encode(s: String) -> String = \"base64::encode\"\n}}\nfn run() {{ print(b64encode(\"hi\")) }}\n"
    children := []
    for worker in 0..2 {
        dir :: root.join("w{worker}")
        fs.create_dir_all(&dir).unwrap()
        fs.write(dir.join("main.jet"), source).unwrap()
        fs.write(dir.join("package.jet"), "name: \"ffi_concurrent\"\nversion: \"0.1.0\"\nauthority: {{\n    holds: {{ allow: [FFI, IO] }},\n}}\n").unwrap()
        children.push(Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(["run", "--profile=debug", "main.jet"]).current_dir(&dir).env("JET_FFI_CACHE_DIR", &cache).env("NO_COLOR", "1").stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().expect("spawn concurrent jet run"))
    }
    for (worker, child) in children.into_iter().enumerate() {
        out :: child.wait_with_output().unwrap()
        assert(out.status.success(), "concurrent worker {worker} failed:\n{String.from_utf8_lossy(&out.stderr)}")
        assert_eq(String.from_utf8_lossy(&out.stdout), "aGk=\n")
    }
    key_dirs :: fs.read_dir(&cache).unwrap().map(fn(entry) { entry.unwrap().path() }).filter(fn(path) { path.is_dir() && !path.ends_with("deps") }).collect()
    assert_eq(key_dirs.len(), 1, "two processes on one bridge key produced {key_dirs.len()} key dirs: {key_dirs:?}")
    assert(!key_dirs[0].join(".build-lock").exists(), "the per-key build lock leaked: {key_dirs[0].display()}")
    rlibs := []
    sidecars := []
    pending := [cache.join("deps")]
    loop {
        dir :: pending.pop() ?? break
        for entry in fs.read_dir(&dir).unwrap() {
            path :: entry.unwrap().path()
            if path.is_dir() { pending.push(path); continue }
            name :: path.file_name().unwrap().to_string_lossy().into_owned()
            if name.starts_with("libjet_ffi_") && name.ends_with(".rlib") && path.parent().is_some_and(fn(parent) { parent.ends_with("release") }) {
                rlibs.push(name)
            } else if name.starts_with("jet_ffi_") && name.ends_with(".sha256") { sidecars.push(name) }
        }
    }
    assert_eq(rlibs.len(), 1, "expected one bridge rlib, got {rlibs:?}")
    assert_eq(sidecars.len(), 1, "expected one blessed bridge, got {sidecars:?}")
    _ :: fs.remove_dir_all(&root)
}
