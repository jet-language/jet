    _ :: fs.remove_dir_all(&root)
    cache_dir :: root.join(".jet/bindings/c")
    fs.create_dir_all(&cache_dir).unwrap()
    header_dir :: root.join("include")
    fs.create_dir_all(&header_dir).unwrap()
    header_path :: header_dir.join("mylib3.h")
    header_src :: "int mylib3_ping(int x);\n"
    fs.write(&header_path, header_src).unwrap()
    cache_file :: cache_dir.join("mylib3.jet")
    bind_result :: jet.CBind.generate(header_src, "mylib3").unwrap()
    fs.write(&cache_file, &bind_result.source).unwrap()
    jet.CBind.write_bind_hash(&cache_file, header_src, "").unwrap()
    cache_before :: fs.read_to_string(&cache_file).unwrap()
    mtime_before :: fs.metadata(&cache_file).and_then(fn(m) { m.modified() }).unwrap()
    thread.sleep(time.Duration.from_millis(50))
    main :: root.join("main.jet")
    fs.write(&main, "use \"include/mylib3.h\" as m\nfn run() {{ print(m.mylib3_ping(0)) }}\n").unwrap()
    src :: fs.read_to_string(&main).unwrap()
    _ :: jet.compile_with_path(&src, main.to_str().unwrap())
    cache_after :: fs.read_to_string(&cache_file).unwrap()
    mtime_after :: fs.metadata(&cache_file).and_then(fn(m) { m.modified() }).unwrap()
    assert_eq(cache_before, cache_after, "cache-hit fast path: cache content must not change on identical header")
    assert_eq(mtime_before, mtime_after, "cache-hit fast path: cache file must not be rewritten on hash match")
    _ :: fs.remove_dir_all(&root)
}
// Rust: tests/cffi.rs:2885
#Test("bind_hash_is_real") {
    h1 :: jet.CBind.compute_bind_hash("int foo(int x);", "")
    h2 :: jet.CBind.compute_bind_hash("int foo(int x);", "")
    h3 :: jet.CBind.compute_bind_hash("int bar(int x);", "")
    h4 :: jet.CBind.compute_bind_hash("int foo(int x);", "-I/usr/include")
    assert_eq(h1, h2, "same inputs → same hash")
    assert_ne(h1, h3, "different header → different hash")
    assert_ne(h1, h4, "different cflags → different hash")
    assert_eq(h1.len(), 64)
    assert(h1.chars().all(fn(c) { c.is_ascii_hexdigit() }))
}
