// GATE #4494: real native file/process/thread primitives; #4483: selected target dispatch.
// Rust: tests/cffi.rs:1823
#Test("cffi_repr_c_enums_match_native_c_layout") {
    if !common.have_rustc() { return }
    root :: env.temp_dir().join("jet_cffi_reprc2_{process.id()}")
    _ :: fs.remove_dir_all(&root)
    fs.create_dir_all(&root).unwrap()
    fs.write(root.join("reprc2.c"), """
#include <stdint.h>
#include <stddef.h>
typedef enum { STATUS_OK=0, STATUS_LOST=7 } Status;
typedef enum __attribute__((packed)) { PACKET_PING=3, PACKET_DATA=7 } PacketTag;
typedef union { long long ping; struct { long long x; long long y; } data; } PacketPayload;
typedef struct { PacketTag tag; PacketPayload payload; } Packet;
int32_t repr_status(Status s){return (int32_t)s;} int32_t repr_packet(Packet p){return (int32_t)p.tag*100+p.payload.ping;}
int32_t repr_packet_size(void){return sizeof(Packet);} int32_t repr_packet_align(void){return _Alignof(Packet);}
int32_t repr_packet_payload_offset(void){return offsetof(Packet,payload);}
""").unwrap()
    cc :: ["cc", "gcc", "clang"].iter().find(fn(x) { Command.new(x).arg("--version").output().is_ok() }).unwrap()
    assert(Command.new(cc).args(["-c"]).arg(root.join("reprc2.c")).arg("-o").arg(root.join("reprc2.o")).status().unwrap().success())
    assert(Command.new("ar").arg("rcs").arg(root.join("libreprc2.a")).arg(root.join("reprc2.o")).status().unwrap().success())
    declare_local_c_dep(&root, "reprc2")
    main :: root.join("main.jet")
    fs.write(&main, """
use c.reprc2 as c
#Layout(c)
enum Status {
    Ok = 0
    Lost = 7
}
#Layout(c, tag: U8)
enum Packet {
    Ping(Int) = 3
    Data(x: Int, y: Int) = 7
}
#Import module c.reprc2 {
    fn repr_status(s: Status) -> I32 = "repr_status"
    fn repr_packet(p: Packet) -> I32 = "repr_packet"
    fn repr_packet_size() -> I32 = "repr_packet_size"
    fn repr_packet_align() -> I32 = "repr_packet_align"
    fn repr_packet_payload_offset() -> I32 = "repr_packet_payload_offset"
}
fn run() {
    print(c.repr_status(Status.Lost))
    print(c.repr_packet(Packet.Ping(41)))
    print(c.repr_packet_size())
    print(c.repr_packet_align())
    print(c.repr_packet_payload_offset())
}
""").unwrap()
    src :: fs.read_to_string(&main).unwrap()
    out :: jet.compile_with_path(&src, main.to_str().unwrap()).unwrap_or_else(fn(d) { panic("{jet.render_diagnostics(main.to_str().unwrap(), &src, &d)}") })
    assert(out.rust.contains("#[repr(C, u8)]") && out.rust.contains("__jet_Lost = 7") && out.rust.contains("__jet_Ping(i64) = 3"))
    assert(out.rust.contains("typedef uint8_t Packet_Tag;") && out.rust.contains("typedef union Packet_Payload") && out.rust.contains("typedef struct Packet"))
    fs.write(root.join("main.rs"), &out.rust).unwrap()
    rustc := Command.new("rustc")
    rustc.args(["--edition", "2021"]).arg(root.join("main.rs")).arg("-o").arg(root.join("main_bin")).arg("-L").arg("native={root.display()}").arg("-lreprc2")
    built :: rustc.output().unwrap()
    assert(built.status.success(), "I2: {String.from_utf8_lossy(&built.stderr)}")
    run :: Command.new(root.join("main_bin")).output().unwrap()
    assert(run.status.success(), "{String.from_utf8_lossy(&run.stderr)}")
    assert_eq(String.from_utf8_lossy(&run.stdout), "7\n341\n24\n8\n8\n")
    _ :: fs.remove_dir_all(root)
}
// Rust: tests/cffi.rs:1930
#Test("cffi_named_pure_callback_has_stable_c_symbol") {
    if !common.have_rustc() { return }
    root :: env.temp_dir().join("jet_cffi_cb_{process.id()}")
    _ :: fs.remove_dir_all(&root)
    fs.create_dir_all(&root).unwrap()
    fs.write(root.join("cb.c"), "#include <stdint.h>\n#include <pthread.h>\ntypedef int32_t (*cb_t)(int32_t);\nint32_t call_twice(cb_t cb,int32_t x){{ return cb(cb(x)); }}\ntypedef struct {{ cb_t cb; int32_t x; int32_t out; }} Job;\nstatic void* run_job(void* p){{ Job* j=(Job*)p; j->out=j->cb(j->x); return 0; }}\nint32_t call_parallel(cb_t cb){{ pthread_t t[4]; Job j[4]; for(int i=0;i<4;i++){{j[i]=(Job){{cb,i,0}}; pthread_create(&t[i],0,run_job,&j[i]);}} int32_t s=0; for(int i=0;i<4;i++){{pthread_join(t[i],0);s+=j[i].out;}} return s; }}\n").unwrap()
    cc :: ["cc", "gcc", "clang"].iter().find(fn(x) { Command.new(x).arg("--version").output().is_ok() }).unwrap()
    assert(Command.new(cc).args(["-c"]).arg(root.join("cb.c")).arg("-o").arg(root.join("cb.o")).status().unwrap().success())
    assert(Command.new("ar").arg("rcs").arg(root.join("libcb.a")).arg(root.join("cb.o")).status().unwrap().success())
    fs.write(root.join("package.jet"), "name: \"cffi_cb\"\nversion: \"0.1.0\"\ndeps: {{ cb: c@\"{root.display()}\" }}\n").unwrap()
    main :: root.join("main.jet")
    fs.write(&main, """
use c.cb as c
fn increment(x: I32) -[]> I32 {
    return x + 1
}
#Import module c.cb {
    fn call_twice(cb: fn(I32) -[]> I32, x: I32) -> I32 = "call_twice"
    fn call_parallel(cb: fn(I32) -[]> I32) -> I32 = "call_parallel"
}
fn run() {
    print(c.call_twice(increment, 40))
    print(c.call_parallel(increment))
    print(c.call_twice((x) -> x + x, 10))
}
""").unwrap()
    src :: fs.read_to_string(&main).unwrap()
    out :: jet.compile_with_path(&src, main.to_str().unwrap()).unwrap_or_else(fn(d) { panic("{jet.render_diagnostics(main.to_str().unwrap(), &src, &d)}") })
    assert(out.rust.contains("extern \"C\" fn __jet_increment"))
    assert(out.rust.contains("extern \"C\" fn(i32) -> i32"))
    assert(out.rust.contains("extern \"C\" fn __jet_c_callback_"))
    fs.write(root.join("main.rs"), out.rust).unwrap()
    rustc := Command.new("rustc")
    rustc.args(["--edition", "2021"]).arg(root.join("main.rs")).arg("-o").arg(root.join("main_bin")).arg("-L").arg("native={root.display()}").arg("-lcb").arg("-lpthread")
    built :: rustc.output().unwrap()
    assert(built.status.success(), "I2: {String.from_utf8_lossy(&built.stderr)}")
    run :: Command.new(root.join("main_bin")).output().unwrap()
    assert_eq(String.from_utf8_lossy(&run.stdout), "42\n10\n40\n")
    _ :: fs.remove_dir_all(root)
}
// Rust: tests/cffi.rs:2020
#Test("cffi_raw_status_out_pointer_reads_only_on_success") {
    if !common.have_rustc() { return }
    root :: env.temp_dir().join("jet_cffi_out_{process.id()}")
    _ :: fs.remove_dir_all(&root)
    fs.create_dir_all(&root).unwrap()
    fs.write(root.join("store.c"), "#include <stdint.h>\n#include <string.h>\ntypedef struct {{ uint64_t id; uint32_t flags; }} Record;\nint32_t store_load(uint64_t id, Record* out){{ if(id==7){{out->id=70;out->flags=3;return 0;}} memset(out,0xA5,sizeof(*out)); return 9; }}\n").unwrap()
    cc :: ["cc", "gcc", "clang"].iter().find(fn(x) { Command.new(x).arg("--version").output().is_ok() }).unwrap()
    assert(Command.new(cc).args(["-c"]).arg(root.join("store.c")).arg("-o").arg(root.join("store.o")).status().unwrap().success())
    assert(Command.new("ar").arg("rcs").arg(root.join("libstore.a")).arg(root.join("store.o")).status().unwrap().success())
    declare_local_c_dep(&root, "store")
    main :: root.join("main.jet")
    src :: """
use core.mem
use c.store as store
#Layout(c)
struct Record {
    id: U64
    flags: U32
}
#Error
enum StoreError { Status }
#Import module c.store {
    fn store_load(id: U64, out: *Record) -> I32 = "store_load"
}
fn load(id: U64) -> Record StoreError! {
    slot := Record{id: 0, flags: 0}
    status := I32{ 1 }
    #Unsafe("store_load receives a live non-null slot; bytes are read only after status zero") {
        p :: mem.Ptr<Record>.from_addr(mem.address_of(slot))
        status = store.store_load(id, p)
        if Int.from_i32(status) == 0 { slot = ~p.* }
    }
    if Int.from_i32(status) != 0 { return Err(StoreError.Status) }
    return Ok(slot)
}
fn run() {
    print((load(7) ?? panic("success expected")).id)
    if load(8) == {
        .Ok(v) -> { print("unexpected {v.id}") }
        .Err(e) -> { print("status 9") }
    }
}
"""
    fs.write(&main, src).unwrap()
    out :: jet.compile_with_path(src, main.to_str().unwrap()).unwrap_or_else(fn(d) { panic("{jet.render_diagnostics(main.to_str().unwrap(), src, &d)}") })
    assert(out.rust.contains("*mut super::__jet_Record"))
    assert(!out.rust.contains("Result<super::__jet_Record"))
    fs.write(root.join("main.rs"), &out.rust).unwrap()
    rustc := Command.new("rustc")
    rustc.args(["--edition", "2021"]).arg(root.join("main.rs")).arg("-o").arg(root.join("main_bin")).arg("-L").arg("native={root.display()}").arg("-lstore")
    if link :: out.ffi { add_ffi_bridge_args(&rustc, &link) }
    built :: rustc.output().unwrap()
    assert(built.status.success(), "I2: {String.from_utf8_lossy(&built.stderr)}")
    run :: Command.new(root.join("main_bin")).output().unwrap()
    assert_eq(String.from_utf8_lossy(&run.stdout), "70\nstatus 9\n")
    _ :: fs.remove_dir_all(root)
}
