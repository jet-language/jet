                "session.new" -> "{{\"sessionId\":\"cdp-life\",\"capabilities\":{{\"goog:cdp\":true}}}}"
                "browser.createUserContext" -> "{{\"userContext\":\"user-1\"}}"
                "browsingContext.create" -> "{{\"context\":\"page-1\"}}"
                "goog:cdp.sendCommand" -> {
                    assert(request.contains("\"method\":\"Page.enable\""), "page-scoped expert CDP must wrap Page.enable: {request}")
                    "{{}}"
