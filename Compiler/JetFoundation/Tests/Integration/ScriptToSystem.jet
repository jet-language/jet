// Card #1415: one source grows through supported project forms.
use std.fs
use std.fs.OpenOptions
use std.io.Write
use std.process.[Command, Output]
use std.time.[Duration, Instant]
use core.path.OSPath
use core.sys.target.[selected_os, selected_arch, selected_family]
use jet
// GATE #4494: actual filesystem, process spawn and clock providers.
// GATE #4483: selected target facts for receipts and native artifact names.
// Rust: tests/script_to_system.rs:17
pub EXPECTED_STDOUT :: include_bytes("Examples/continuity/script_to_system/expected.out")
// Rust: tests/script_to_system.rs:19
pub RECEIPT_NAME :: "script-to-system.tsv"
// Rust: tests/script_to_system.rs:20
pub RECEIPT_VERSION: U8 :: 2
// Rust: tests/script_to_system.rs:22
pub fn receipt_path(cache: &OSPath) -> OSPath { cache.join(RECEIPT_NAME) }
// Rust: tests/script_to_system.rs:26
pub fn start_receipt(cache: &OSPath) -> {
    fs.write(receipt_path(cache), "version={RECEIPT_VERSION}\thost={selected_os()}\tarch={selected_arch()}\n").expect("create the script-to-system receipt")
}
// Rust: tests/script_to_system.rs:38
pub fn receipt_operation(label: &String) -> String {
    if label == "fold-rollback" || label.starts_with("rollback-") { "rollback" }
    else if label.starts_with("split-") { "split" }
    else if label.starts_with("fold-") { "fold" }
    else if label.contains("install") { "install" }
    else if label.contains("library") || label.starts_with("export-") || label.contains("aot") || label.contains("rebuild") { "export" }
    else { "journey" }
}
// Rust: tests/script_to_system.rs:58
pub fn bytes_digest(bytes: &[U8]) -> String { "sha256:{jet.SHA256.sha256_hex(bytes)}" }
// Rust: tests/script_to_system.rs:62
pub fn file_digest(path: &OSPath) -> String {
    bytes :: fs.read(path).unwrap_or_else(fn(error) -> panic("read {path.display()}: {error}"))
    bytes_digest(&bytes)
}
// Rust: tests/script_to_system.rs:67
pub fn record_receipt(cache: &OSPath, event: &String, label: &String, elapsed: Duration, status: &String, detail: &String) -> {
    detail :: detail.replace('\t', " ").replace('\n', " ")
    line :: "event={event}\toperation={receipt_operation(label)}\tlabel={label}\telapsed_ms={elapsed.as_millis()}\tstatus={status}\tdetail={detail}\n"
    OpenOptions.new().append(true).open(receipt_path(cache)).expect("open the script-to-system receipt").write_all(line.as_bytes()).expect("write the script-to-system receipt")
    eprint("script-to-system receipt {line}")
}
// Rust: tests/script_to_system.rs:90
pub fn assert_lock_preserved(cache: &OSPath, root: &OSPath, expected: &[U8], expected_digest: &String, label: &String) -> {
    lock :: root.join(".jet/lock")
    actual :: fs.read(&lock).unwrap_or_else(fn(error) -> panic("read {lock.display()} after {label}: {error}"))
    assert_eq(actual.as_slice(), expected, "{label} changed authoritative lock bytes")
    actual_digest :: bytes_digest(&actual)
    assert_eq(actual_digest, expected_digest, "{label} changed authoritative lock digest")
    record_receipt(cache, "proof", label, Duration.ZERO, "ok", "lock_bytes={expected.len()} lock_sha256={expected_digest} lock_unchanged=true")
}
// Rust: tests/script_to_system.rs:123
pub fn assert_source_preserved(cache: &OSPath, root: &OSPath, expected: &[U8], expected_digest: &String, label: &String) -> {
    source :: root.join("run.jet")
    actual :: fs.read(&source).unwrap_or_else(fn(error) -> panic("read {source.display()} after {label}: {error}"))
    assert_eq(actual.as_slice(), expected, "{label} changed run.jet")
    assert_eq(bytes_digest(&actual), expected_digest, "{label} changed run.jet digest")
    record_receipt(cache, "proof", label, Duration.ZERO, "ok", "path=run.jet source_sha256={expected_digest} source_unchanged=true")
}
// Rust: tests/script_to_system.rs:149
pub fn edit_file(cache: &OSPath, root: &OSPath, label: &String, path: &OSPath, contents: &String) -> {
    started :: Instant.now()
    fs.write(path, contents).unwrap_or_else(fn(error) -> panic("write {path.display()}: {error}"))
    relative :: path.strip_prefix(root).unwrap_or(path)
    record_receipt(cache, "edit", label, started.elapsed(), "ok", "path={relative.display()}")
}
// Rust: tests/script_to_system.rs:163
pub fn record_artifact(cache: &OSPath, root: &OSPath, path: &OSPath) -> {
    started :: Instant.now()
    bytes :: fs.read(path).unwrap_or_else(fn(error) -> panic("read {path.display()}: {error}"))
    metadata :: fs.metadata(path).unwrap_or_else(fn(error) -> panic("stat {path.display()}: {error}"))
    relative :: path.strip_prefix(root).unwrap_or(path)
    record_receipt(cache, "artifact", "final-output", started.elapsed(), "ok", "path={relative.display()} bytes={metadata.len()} sha256={bytes_digest(&bytes)}")
}
// Rust: tests/script_to_system.rs:185
#Derive(Debug, Clone, PartialEq, Eq)
pub struct ProjectGraphTruth { fingerprint: String, dependencies: String, dependency_sha256: String }
// Rust: tests/script_to_system.rs:192
pub fn recompute_project_graph(root: &OSPath) -> ProjectGraphTruth {
    // Reload checked facts from disk, not the transition's stated fingerprint.
    package :: match jet.Package.PackageFacts.load(root) {
        Some(Ok(package)) -> package
        Some(Err(error)) -> panic("load package facts from {root.display()}: {error}")
        None -> panic("no package facts in {root.display()}")
    }
    graph :: "name={package.name:?}\nversion={package.version:?}\njet={package.jet:?}\nsource={package.source:?}\ndeps={package.deps:?}\nservices={package.services:?}\noutputs={package.outputs:?}\nenvironments={package.environments:?}\ndefaults={package.defaults:?}\n"
    dependencies :: "{package.deps:?}"
    ProjectGraphTruth { fingerprint: bytes_digest(graph.as_bytes()), dependency_sha256: bytes_digest(dependencies.as_bytes()), dependencies }
}
// Rust: tests/script_to_system.rs:221
pub fn assert_graph_preserved(before: &ProjectGraphTruth, after: &ProjectGraphTruth, label: &String) -> {
    assert_eq(after.fingerprint, before.fingerprint, "{label} changed the checked package graph")
    assert_eq(after.dependencies, before.dependencies, "{label} changed package dependencies")
    assert_eq(after.dependency_sha256, before.dependency_sha256, "{label} changed the dependency identity")
}
// Rust: tests/script_to_system.rs:236
pub fn transition_fingerprints(output: &Output) -> (String, String) {
    stdout :: String.from_utf8_lossy(&output.stdout)
    match stdout.lines().find_map(fn(line) -> line.strip_prefix("package graph unchanged: ")) {
        Some(fingerprint) -> { return (fingerprint.to_owned(), fingerprint.to_owned()) }
        None -> {}
    }
    before :: stdout.lines().find_map(fn(line) -> line.strip_prefix("package graph before: "))
    after :: stdout.lines().find_map(fn(line) -> line.strip_prefix("package graph after: "))
    match (before, after) {
        (Some(before), Some(after)) -> (before.to_owned(), after.to_owned())
        _ -> panic("transition output lacks graph identity:\n{stdout}")
    }
}
// Rust: tests/script_to_system.rs:259
pub fn transition_graph(output: &Output) -> String {
    (before, after) :: transition_fingerprints(output)
    assert_eq(before, after, "transition changed the package graph: {String.from_utf8_lossy(&output.stdout)}")
    before
}
// Rust: tests/script_to_system.rs:270
pub fn transition_journal(output: &Output) -> OSPath {
    stdout :: String.from_utf8_lossy(&output.stdout)
    stdout.lines().find_map(fn(line) -> line.strip_prefix("Transition journal: ")).map(OSPath.from).unwrap_or_else(fn() -> panic("transition output lacks journal path:\n{stdout}"))
}
// Rust: tests/script_to_system.rs:279
pub fn journal_value(contents: &String, field: &String, path: &OSPath) -> String {
    prefix :: "{field}="
    contents.lines().find_map(fn(line) -> line.strip_prefix(&prefix)).filter(fn(value) -> !value.is_empty()).map(fn(value) -> value.to_owned()).unwrap_or_else(fn() -> panic("journal {path.display()} lacks {field}"))
}
// Rust: tests/script_to_system.rs:289
pub fn journal_fingerprints(path: &OSPath) -> (String, String) {
    contents :: fs.read_to_string(path).unwrap_or_else(fn(error) -> panic("read transition journal {path.display()}: {error}"))
    assert_eq(contents.lines().next(), Some("jet-package-transition-v1"), "unexpected transition journal header in {path.display()}")
    (journal_value(&contents, "before", path), journal_value(&contents, "after", path))
}
// Rust: tests/script_to_system.rs:304
pub fn jet_bin() -> OSPath { OSPath.from(env("CARGO_BIN_EXE_jet")) }
// Rust: tests/script_to_system.rs:308
pub fn compiler_text(output: &Output) -> String {
    "stdout:\n{String.from_utf8_lossy(&output.stdout)}\nstderr:\n{String.from_utf8_lossy(&output.stderr)}"
}
// Rust: tests/script_to_system.rs:316
pub fn run_jet(root: &OSPath, cache: &OSPath, label: &String, args: &[String]) -> (Duration, Output) {
    started :: Instant.now()
    output :: Command.new(jet_bin()).args(args).current_dir(root).env("HOME", cache.join("home")).env("JET_STORE_DIR", cache.join("jet-cache")).env("JETPACK_ROOT", cache.join("jetpack")).env("NO_COLOR", "1").output().unwrap_or_else(fn(error) -> panic("jet {args:?} could not start: {error}"))
    elapsed :: started.elapsed()
    eprintln("script-to-system action={label} elapsed_ms={elapsed.as_millis()} status={output.status}")
    event :: if label.contains("build") { "build" } else { "action" }
    record_receipt(cache, event, label, elapsed, if output.status.success() { "ok" } else { "failed" }, "argv={args:?} exit={output.status.code():?}")
    (elapsed, output)
}
// Rust: tests/script_to_system.rs:353
pub fn run_jet_ok(root: &OSPath, cache: &OSPath, label: &String, args: &[String]) -> Output {
    (_, output) :: run_jet(root, cache, label, args)
    assert(output.status.success(), "jet {args:?} failed:\n{compiler_text(&output)}")
    output
}
// Rust: tests/script_to_system.rs:364
pub fn cc() -> String? {
    if selected_family() != "unix" { return None }
    ["cc", "gcc", "clang"].into_iter().find(fn(candidate) -> Command.new(candidate).arg("--version").output().is_ok())
}

