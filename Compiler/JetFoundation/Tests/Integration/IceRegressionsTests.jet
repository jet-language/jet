// Rust: tests/ice_regressions.rs:404
#Test("b12_c_module_import_keeps_plain_c_return") {
    dir :: env.temp_dir().join("jet_ice_c_module_{std.process.id()}")
    fs.create_dir_all(dir).unwrap()
    native :: dir.join("native")
    fs.create_dir_all(native).unwrap()
    fs.write(dir.join("package.jet"), "name: \"c_module_plain_return\"\nversion: \"0.1.0\"\ndeps: {{ answer: c@\"./native\" }}\n").unwrap()
    // GATE #4494: native archive tool execution.
    assert(Command.new("ar").args(["rcs"]).arg(native.join("libanswer.a")).status().unwrap().success(), "C-module fixture needs an archive for its declared local dependency")
    path :: dir.join("c_module_import_plain_return.jet")
    source :: #IncludeText("../../../../tests/ice_regressions/c_module_import_plain_return.jet")
    fs.write(path, source).unwrap()
    shown :: path.to_string_lossy()
    diagnostics :: jet.check_with_path(shown)
    assert(diagnostics.is_empty(), "b12_c_module_import_keeps_plain_c_return: `jet check` rejected fixture:\n{jet.render_diagnostics(shown, source, diagnostics)}")
    out :: jet.compile_with_path(source, shown).unwrap_or_else(diags -> panic("b12_c_module_import_keeps_plain_c_return: compile rejected fixture:\n{jet.render_diagnostics(shown, source, diags)}"))
    run :: out.rust.split("pub fn __jet_run()").nth(1).expect("generated run function")
    assert(run.contains("__jet___c_answer::__jet_value()"), "C-module call missing from generated run:\n{run}")
    assert(!run.contains("jet_trace_err(__jet___c_answer::__jet_value()"), "plain C-module return acquired a hidden Result trace wrapper:\n{run}")
    _ :: fs.remove_dir_all(dir)
}
// Rust: tests/ice_regressions.rs:456
#Test("b13_c_bridge_call_keeps_declared_return") {
    source :: #IncludeText("../../../../Examples/features/lowlevel/cbind/run.jet")
    shown :: root().join("Examples/features/lowlevel/cbind/run.jet").to_string_lossy()
    out :: jet.compile_with_path(source, shown).unwrap_or_else(diags -> panic("b13_c_bridge_call_keeps_declared_return: compile rejected fixture:\n{jet.render_diagnostics(shown, source, diags)}"))
    run :: out.rust.split("pub fn __jet_run()").nth(1).expect("generated run function")
    assert(run.contains("|| jet_std::jet_int_from_i64("), "C bridge call did not retain its declared integer return:\n{run}")
    assert(!run.contains("|| Ok::<_, JetErr>(jet_std::jet_int_from_i64("), "C bridge call acquired the callable Result carrier:\n{run}")
}

// Rust: tests/ice_report_codegen_rejection.rs:14
#Test("generated_rust_rejection_is_a_branded_ice_and_preserves_backend_evidence") {
    project :: Common.Scratch.new("ice-generated-rust-rejection")
    source :: "fn run() {{\n    print(\"rejection-{std.process.id()}\")\n}}\n"
    fs.write(project.join("main.jet"), source).unwrap()
    // GATE #4494: real CLI execution and retained backend artifacts.
    output :: Command.new(env.var("JET_BIN").unwrap()).args(["build", "--profile=ci", "--verbose", "main.jet"]).current_dir(project.path).env("JET_ICE_RUSTC_REJECTION_SELF_TEST", "1").env("JET_PROVE_FRESH_TEST", "1").env("NO_COLOR", "1").output().expect("jet build should start")
    stderr :: String.from_utf8_lossy(output.stderr)
    assert_eq(output.status.code(), Some(101), "generated-Rust rejection must exit as an ICE:\n{stderr}")
    assert(stderr.contains("internal compiler error:"), "backend rejection must remain an internal compiler error:\n{stderr}")
    assert(stderr.contains(project.join(".jet/build/main.rs").to_string_lossy()), "report must identify the preserved generated source:\n{stderr}")
    assert(stderr.contains("JET_RUSTC_REJECTION_SENTINEL"), "report must retain the first backend error:\n{stderr}")
    assert(project.join(".jet/build/main.rs").is_file())
    log_path :: project.join(".jet/build/main.rustc.log")
    assert(stderr.contains(log_path.to_string_lossy()), "report must identify the complete backend log:\n{stderr}")
    log :: fs.read_to_string(log_path).expect("backend stderr must survive the ICE")
    assert(log.contains("JET_RUSTC_REJECTION_SENTINEL"), "persisted backend stderr lost the first rejection:\n{log}")
    assert(log.contains("JET_RUSTC_REJECTION_SECOND_SENTINEL"), "persisted backend stderr lost the second rejection:\n{log}")
    output_text :: "{String.from_utf8_lossy(output.stdout)}{stderr}"
    assert(output_text.contains("[build] rustc error:\nerror: JET_RUSTC_REJECTION_SENTINEL"), "verbose build must echo the first backend error:\n{output_text}")
    assert(!output_text.contains("JET_RUSTC_REJECTION_SECOND_SENTINEL"), "verbose output must exclude later backend errors:\n{output_text}")
    assert(!output_text.contains("warning:"), "verbose output must exclude later backend warnings:\n{output_text}")
    banner :: stderr[stderr.find("internal compiler error:").unwrap()..]
    assert(!banner.contains("JET_RUSTC_REJECTION_SECOND_SENTINEL"), "ICE banner must exclude later backend errors:\n{banner}")
    assert(!banner.contains("warning:"), "ICE banner must exclude later backend warnings:\n{banner}")
    CliSupport.check_snapshot("generated_rust_rejection.txt", normalize_backend_locations(banner, project.path))
    CliSupport.check_snapshot("generated_rust_rejection.rustc.txt", normalize_backend_error_excerpts(log, project.path))
}

// Rust: tests/ice_report_single_home.rs:41
#Test("no_hand_typed_ice_banner_outside_the_one_home") {
    files := [OSPath]{}
    collect_rs_files(root().join("Source"), &files)
    violations := [String]{}
    loop file in files {
        text :: fs.read_to_string(file).unwrap_or_default()
        loop (n, line) in text.lines().enumerate() {
            trimmed := line.trim_start() // #4303
            if trimmed.starts_with("//") { continue }
            if (line.contains("\"internal compiler error") || line.contains("(internal compiler error)")) && !line.contains("render_ice_report") {
                violations.push("{file.display()}:{n + 1}: {line.trim()}")
            }
        }
    }
    assert(violations.is_empty(), "hand-typed ICE banner outside the one home (jet_foundation::Diagnostics::render_ice_report):\n{violations.join("\n")}")
}
// Rust: tests/ice_report_single_home.rs:75
#Test("panic_hook_prints_the_branded_report_and_exits_101") {
    // GATE #4494: actual panic hook process.
    out :: Command.new(env.var("JET_BIN").unwrap()).env("JET_ICE_SELF_TEST", "1").output().expect("failed to run jet")
    assert_eq(out.status.code(), Some(101), "an uncaught panic must still exit ICE (101)")
    stderr :: String.from_utf8_lossy(out.stderr)
    assert(stderr.contains("internal compiler error: ICE self-test triggered by JET_ICE_SELF_TEST"), "missing branded ICE first line:\n{stderr}")
    assert(stderr.contains("This is a bug in jet, NOT in your program. Please report it,"), "missing branded report body:\n{stderr}")
    assert(!stderr.contains("RUST_BACKTRACE"), "raw Rust panic hint leaked past the hook:\n{stderr}")
    assert(!stderr.contains("thread 'main' panicked at"), "raw Rust panic text leaked past the hook:\n{stderr}")
}

// Rust: tests/impl_shape_matrix.rs:322
#Test("impl_shape_matrix_covers_all_contexts_and_resolution_seams") {
    assert_matrix_cells()
    path :: source_path()
    bundle := jet.Loader.load_entry(path.to_str().unwrap()).expect("matrix loads")
    items_before_sema :: source_items(bundle)
    explicit :: explicit_impls(items_before_sema)
    local :: local_nominals(items_before_sema)
    registry :: TraitRegistry.auto_derives_for_items(items_before_sema)
    diagnostics :: Sema.check_bundle(&bundle, Sema.CompileMode.Run)
    errors :: diagnostics.iter().filter(diagnostic -> diagnostic.severity == Severity.Error).collect()
    assert(errors.is_empty(), "matrix sema errors: {errors:?}")
    assert(items_before_sema.iter().any(item -> {
        if item == .Struct(def) { return def.name == "EquatableOwner" && def.derives.iter().any(pair -> pair.0 == EQUATABLE) }
        return false
    }), "EquatableOwner must retain the derived-Equatable matrix shape")
    compiled :: jet.compile_with_path(SOURCE, path.to_str().unwrap()).expect("matrix AOT codegen")
    assert_aot_and_admission_contract(registry, explicit, local)
    TirSupport.assert_example_cli_tiers_agree("traits/impl_shape_matrix", EXPECTED)
    // Retired resident-JIT representation check becomes the same rendering
    // contract across the supported execution tiers.
    loop tier in ["O0", "O1", "O2", "Web"] {
        (code, stdout, stderr) :: TirSupport.run_tier_traced("impl_shape_matrix_native", SOURCE, tier)
        assert_eq(code, 0, "{tier} `jet run` failed for impl_shape_matrix: {stderr}")
        assert_eq(stdout, EXPECTED)
    }
}
// Rust: tests/impl_shape_matrix.rs:375
#Test("impl_shape_matrix_retains_typed_operator_rhs") {
    path :: root().join("Examples/features/operators/mixed_types.jet")
    bundle :: jet.Loader.load_entry(path.to_str().unwrap()).expect("operator example loads")
    rhs := None
    loop item in bundle.modules[bundle.entry].items {
        if item == .Impl(implementation) {
            if implementation.type_name == "Money" && implementation.trait_name == Some("Add") {
                if implementation.operator_rhs == Some(value) { rhs = Some(value); break }
            }
        }
    }
    assert_eq(rhs, Some(Type.Int))
}
