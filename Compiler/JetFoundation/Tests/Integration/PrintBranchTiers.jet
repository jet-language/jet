// Rust: tests/print_branch_tiers.rs:235
pub fn assert_cli_tiers_agree(name: String, src: String, expected_stdout: String) -> {
    root :: common.unique_tmp("jet_print_branch_tiers_{name}")
    _ :: fs.create_dir_all(&root).unwrap()
    _ :: fs.write(root.join("package.jet"), PACKAGE_SOURCE).unwrap()
    _ :: fs.write(root.join("run.jet"), src).unwrap()
    release :: common.have_rustc()
    if !release { eprintln("note: skipping the AOT tier of {name} (need rustc)") }
    modes :: [("default", []), ("interpret", ["--interpret"]), ("release", ["--release"])]
    for (mode, flags) in modes {
        if mode == "release" && !release { continue }
        cache :: root.join("cache-{mode}")
        // GATE #4494: native process invocation.
        output :: Command.new(env("CARGO_BIN_EXE_jet")).arg("run").args(flags).arg("run.jet").current_dir(&root).env("JET_STORE_DIR", &cache).env("JETPACK_ENV", "1").env("NO_COLOR", "1").output().unwrap()
        stdout :: String.from_utf8_lossy(&output.stdout)
        stderr :: String.from_utf8_lossy(&output.stderr)
        assert_eq(output.status.code(), Some(0), "{name}: {mode} run failed:\nstdout:\n{stdout}\nstderr:\n{stderr}")
        assert_eq(stdout, expected_stdout, "{name}: {mode} stdout")
    }
    _ :: fs.remove_dir_all(root)
}
