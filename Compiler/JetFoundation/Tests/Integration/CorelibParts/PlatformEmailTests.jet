// Rust: tests/dev_parts/interp_parity.rs:45
#Test("interpreter_matches_expected_golden") {
    root :: OSPath.from(std.env.compile_time_var("CARGO_MANIFEST_DIR"))
    checked := 0
    loop stem in interpreter_example_stems() {
        file :: example_path(stem)
        // Named jobs, rather than the run() usage hint, are the executable goldens.
        if stem == "devloop/job_runner" {
            check_job_runner_interpreter(root, file)
            checked += 2
            continue
        }
        if uses_ffi_bridge(stem) { continue }
        if stem.starts_with("web/web_wasm_") { continue }
        // Feed canonical recorded answers in a child: in-process fd 0 is shared.
        if common.example_stdin(stem) == .Some(answers) {
            interpreted :: cli_tier_program_output(file, stem, answers.piped, true)
            assert_eq(interpreted.stdout, golden_stdout(stem), "`{stem}`: forced interpreter differs from the golden recorded with its answers")
            checked += 1
            continue
        }
        expected_path :: root.join("Examples/features/expected/{stem}.out")
        if dev_iteration_with_timeout(stem, file, true) == {
            .Ran { stdout, .. } -> {
                if host_expected_stdout(stem) == .Some(expected) {
                    assert_eq(stdout, expected, "`{stem}`: interpreter output differs from host expected output")
                    checked += 1
                } else if fs.read_to_string(expected_path) == .Ok(expected) {
                    assert_eq(stdout, expected, "`{stem}`: interpreter output differs from expected golden")
                    checked += 1
                }
                // No golden: the compiled-binary battery still covers this stem.
            }
            .Problems(diags) -> {
                codes :: diags.iter().map((d) -> d.code.as_str()).collect[[StringView]]()
                assert(is_named_dev_boundary(stem, diags), "`{stem}` neither ran nor stopped at a named boundary; codes were {codes:?}")
            }
        }
    }
    assert(checked > 0, "expected at least some golden comparisons")
}
