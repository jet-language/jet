#Test("core_process_pipeline_honors_stage_timeout") {
    if target.selected_family() != "unix" { return }
    dir :: env.temp_dir().join("jet_core_process_pipeline_timeout-{std.process.id()}")
    _ :: fs.remove_dir_all(&dir)
