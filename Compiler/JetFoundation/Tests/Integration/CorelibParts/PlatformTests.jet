// Rust: tests/corelib_parts/platform.rs:40
#Test("core_data_import_and_codegen_resolve") {
    out :: compile_temp("core_data_import.jet", """
use core.data as data
#Codable
struct Ticket {
    team: String
    minutes: Float
}
fn run() -> {
    rows :: data.csv<Ticket>("team,minutes\nCore,4.0") ?? panic("bad csv")
    print(rows.len())
}
""")
    assert(out.rust.contains("jet_enc_csv_decode"))
    assert(out.rust.contains("jet_enc_csv_decode::<__jet_Ticket>"), "core.data.csv must lower its sema-owned list element type exactly:\n{out.rust}")
    assert(!out.rust.contains("jet_enc_csv_decode::<Vec<__jet_Ticket>>"), "core.data.csv nested its list result at the runtime boundary:\n{out.rust}")
    assert(!out.rust.contains("jet_data_count"), "ordinary list length must not lower through the removed data.count wrapper")
}
// Rust: tests/corelib_parts/platform.rs:76
#Test("core_files_parallel_walk_and_read_count_share_lowering") {
    out :: compile_temp("core_files_parallel_count.jet", """
use core.files as fs
fn count_file(path: String, needle: String) -> Int {
    (fs.read(path) ?? panic("read failed")).count(needle)
}
