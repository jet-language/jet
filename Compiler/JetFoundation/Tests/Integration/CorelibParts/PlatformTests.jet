    expected :: fs.read_to_string("Examples/features/expected/io/files_depth.out").unwrap()
    assert_eq(String.from_utf8_lossy(&out.stdout), expected)
    assert_eq(release.stdout, out.stdout)
}
// Rust: tests/corelib_parts/platform.rs:199
#Test("core_files_stat_mode_matches_across_tiers") {
    if target.selected_family() != "unix" { return }
    jet :: jet_bin()
    if !jet.exists() { return }
    dir :: env.temp_dir().join("jet_corelib_stat_mode-{std.process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    regular :: dir.join("regular.txt")
    fs.write(&regular, "regular").unwrap()
    executable :: dir.join("executable.sh")
    write_executable(&executable, "#!/bin/sh\nexit 0\n")
    directory :: dir.join("directory")
    fs.create_dir(&directory).unwrap()
    symlink :: dir.join("regular.link")
    source_path :: dir.join("stat_mode.jet")
    source :: """
use core.files as fs
use core.process as process
use core.sys as sys
fn run() -> {
    args :: process.argv().skip(1).to_list()
    family :: sys.family()
    absolute :: fs.absolute("regular.txt") ?? panic("absolute")
    fs.set_mode(args[0], 0o644) ?? panic("regular mode setup")
    fs.set_mode(args[2], 0o755) ?? panic("directory mode setup")
    fs.symlink(args[0], args[3]) ?? panic("symlink setup")
    regular :: fs.stat(args[0]) ?? panic("regular stat")
    executable :: fs.stat(args[1]) ?? panic("executable stat")
    directory :: fs.stat(args[2]) ?? panic("directory stat")
    symlink :: fs.stat(args[3]) ?? panic("symlink stat")
    fs.set_mode(args[0], 0o600) ?? panic("regular mode mutation")
    fs.set_mode(args[2], 0o700) ?? panic("directory mode mutation")
    regular_after :: fs.stat(args[0]) ?? panic("regular after stat")
    directory_after :: fs.stat(args[2]) ?? panic("directory after stat")
    print("family:{family}")
    print("absolute:{absolute}")
    print("{regular.mode},{executable.mode},{directory.mode},{symlink.mode},{regular_after.mode},{directory_after.mode}")
}
"""
    fs.write(&source_path, source).unwrap()
    fs.write(dir.join("package.jet"), "name: \"stat_mode\"\nversion: \"0.1.0\"\nauthority: { holds: { allow: [Env, Exec, FS, IO, Mem.Alloc, Panic] } }\n").unwrap()
    source_arg :: source_path.to_string_lossy().into_owned()
    path_args :: [regular.to_string_lossy().into_owned(), executable.to_string_lossy().into_owned(), directory.to_string_lossy().into_owned(), symlink.to_string_lossy().into_owned()]
    // Rust: tests/corelib_parts/platform.rs:256
    run_tier :: fn(extra: &[String]) -> {
        _ :: fs.remove_file(&symlink)
        command := Command.new(&jet)
        command.current_dir(&dir).arg("run").args(extra).arg(&source_arg).arg("--")
        loop path in &path_args { command.arg(path) }
        command.output().expect("run stat mode fixture")
    }
    default :: run_tier(&["--profile=dev"])
    unoptimized :: run_tier(&["--profile=debug"])
    release :: run_tier(&["--release"])
    // Rust: tests/corelib_parts/platform.rs:274
    observations :: fn(output: &Output, tier: String) -> {
        assert(output.status.success(), "{tier} stat mode failed\nstdout:\n{String.from_utf8_lossy(&output.stdout)}\nstderr:\n{String.from_utf8_lossy(&output.stderr)}")
        stdout :: String.from_utf8_lossy(&output.stdout)
        lines := stdout.lines()
        family :: lines.next().and_then(fn(line) -> line.strip_prefix("family:")).expect("platform family observation").to_string()
        absolute :: lines.next().and_then(fn(line) -> line.strip_prefix("absolute:")).expect("absolute path observation").to_string()
        mode_line := lines.next().expect("stat mode observation").trim() // #4303
        modes :: mode_line.split(',').map(fn(mode) -> mode.parse<I64>().expect("numeric stat mode")).collect()
        (family, absolute, modes)
    }
    (default_family, default_absolute, default_modes) :: observations(&default, "o1")
    (unoptimized_family, unoptimized_absolute, unoptimized_modes) :: observations(&unoptimized, "o0")
    (release_family, release_absolute, release_modes) :: observations(&release, "o2")
    expected_absolute :: regular.to_string_lossy().into_owned()
    expected_family :: target.selected_family()
    assert_eq(default_family, expected_family)
    assert_eq(unoptimized_family, expected_family)
    assert_eq(release_family, expected_family)
    assert_eq(default_absolute, expected_absolute)
    assert_eq(unoptimized_absolute, expected_absolute)
    assert_eq(release_absolute, expected_absolute)
    assert_eq(default_modes.len(), 6)
    assert_eq(unoptimized_modes, default_modes)
    assert_eq(release_modes, default_modes)
    assert_eq(default_modes[0] & 0o170000, 0o100000)
    assert_eq(default_modes[0] & 0o777, 0o644)
    assert_eq(default_modes[1] & 0o170000, 0o100000)
    assert_eq(default_modes[1] & 0o777, 0o755)
    assert_eq(default_modes[2] & 0o170000, 0o040000)
    assert_eq(default_modes[2] & 0o777, 0o755)
    assert_eq(default_modes[3] & 0o170000, 0o120000)
    assert_ne(default_modes[3] & 0o111, 0)
    assert_eq(default_modes[4] & 0o170000, 0o100000)
    assert_eq(default_modes[4] & 0o777, 0o600)
    assert_eq(default_modes[5] & 0o170000, 0o040000)
    assert_eq(default_modes[5] & 0o777, 0o700)
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/corelib_parts/platform.rs:335
#Test("core_files_fsync_is_consumed_across_tiers") {
    jet :: jet_bin()
    if !jet.exists() { return }
    dir :: env.temp_dir().join("jet_corelib_fsync-{std.process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    journal :: dir.join("owned").join("closure.journal")
    source_path :: dir.join("fsync.jet")
    source :: """
use core.files as fs
fn run() -> {
    fs.create_dir_all("owned") ?? panic("mkdir")
    fs.write("owned/closure.journal", "closure") ?? panic("write")
    fs.fsync("owned/closure.journal") ?? panic("fsync")
    contents :: fs.read("owned/closure.journal") ?? panic("read")
    print(contents)
}
"""
    fs.write(&source_path, source).unwrap()
    fs.write(dir.join("package.jet"), "name: \"fsync\"\nversion: \"0.1.0\"\nauthority: { holds: { allow: [FS, IO, Mem.Alloc, Panic] } }\n").unwrap()
    source_arg :: source_path.to_string_lossy().into_owned()
    // Rust: tests/corelib_parts/platform.rs:363
    run_tier :: fn(extra: &[String]) -> {
        _ :: fs.remove_file(&journal)
        command := Command.new(&jet)
        command.current_dir(&dir).arg("run").args(extra).arg(&source_arg)
        command.output().expect("run fsync fixture")
    }
    default :: run_tier(&["--profile=dev"])
    unoptimized :: run_tier(&["--profile=debug"])
    release :: run_tier(&["--release"])
    loop (tier, output) in [("o1", &default), ("o0", &unoptimized), ("o2", &release)] {
        assert(output.status.success(), "{tier} fsync failed\nstdout:\n{String.from_utf8_lossy(&output.stdout)}\nstderr:\n{String.from_utf8_lossy(&output.stderr)}")
        assert_eq(output.stdout, "closure\n".as_bytes(), "{tier} fsync output")
    }
    assert_eq(unoptimized.stdout, default.stdout)
    assert_eq(release.stdout, default.stdout)
    assert(journal.exists(), "fsync fixture did not leave the owned file")
    assert_eq(fs.read_to_string(&journal).unwrap(), "closure")
    _ :: fs.remove_dir_all(&dir)
}
