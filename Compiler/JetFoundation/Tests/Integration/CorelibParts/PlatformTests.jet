#Test("core_process_pipeline_limits_intermediate_stdout_without_deadlock") {
    if target.selected_family() != "unix" { return }
    dir :: env.temp_dir().join("jet_core_process_pipeline_output_limit-{std.process.id()}")
    _ :: fs.remove_dir_all(&dir)
