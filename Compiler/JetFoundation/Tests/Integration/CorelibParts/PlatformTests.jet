// Rust: tests/corelib_parts/platform.rs:420
#Test("core_process_builder_pipeline_and_spawn_run") {
    if target.selected_family() != "unix" { return }
    dir :: env.temp_dir().join("jet_corelib_process-{std.process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    work :: dir.join("work")
    fs.create_dir_all(&work).unwrap()
    probe :: dir.join("probe.sh")
    emit :: dir.join("emit.sh")
    cat :: dir.join("cat.sh")
    lines :: dir.join("lines.sh")
    write_executable(&probe, "#!/bin/sh\nprintf 'env=%s\\n' \"$JET_PROCESS_TEST\"\nprintf 'cwd=%s\\n' \"$(pwd)\"\nread line\nprintf 'stdin=%s\\n' \"$line\"\n")
    write_executable(&emit, "#!/bin/sh\nprintf 'pipe-ok\\n'\n")
    write_executable(&cat, "#!/bin/sh\ncat\n")
    write_executable(&lines, "#!/bin/sh\nprintf 'line-one\\nline-two\\n'\n")
    src :: """
use core.process as process
use core.time as time
fn run() -> {
    timeout :: Duration.seconds(2) ?? panic("duration")
    spec :: process.cmd(["{jet_string_path(&probe)}"]).cwd("{jet_string_path(&work)}").env_clear().env("JET_PROCESS_TEST", "ok").stdin(.Capture).stdout(.Capture).stderr(.Capture).timeout(timeout).output_limit(10000)
    probe_child :: spec.spawn() ?? panic("spawn failed")
    probe_child.stdin.write("from-stdin\n") ?? panic("write failed")
    result :: probe_child.wait() ?? panic("wait failed")
    print(result.success)
    print(result.code)
    print(result.timed_out)
    print(result.output)
    piped :: process.pipeline([process.cmd(["{jet_string_path(&emit)}"]), process.cmd(["{jet_string_path(&cat)}"])]) ?? panic("pipeline failed")
    print(piped.success)
    print(piped.output)
    child :: process.cmd(["{jet_string_path(&lines)}"]).stdout(.Stream).spawn() ?? panic("spawn failed")
    loop line in child.stdout.lines() { print(line) }
    waited :: child.wait() ?? panic("wait failed")
    print(waited.success)
}
"""
    (code, stdout, stderr) :: build_and_run(&dir, "process_api", &src, &[], None)
    assert_eq(code, 0, "stderr:\n{stderr}")
    assert(stdout.contains("true\n0\nfalse\n"), "{stdout}")
    assert(stdout.contains("env=ok\n"), "{stdout}")
    assert(stdout.contains("cwd={work.display()}\n"), "{stdout}")
    assert(stdout.contains("stdin=from-stdin\n"), "{stdout}")
    assert(stdout.contains("pipe-ok\n"), "{stdout}")
    assert(stdout.contains("line-one\n"), "{stdout}")
}
