    src :: """
use core.process as process
fn run() -> {
    timeout :: Duration.milliseconds(100) ?? panic("duration failed")
    result :: process.pipeline([process.cmd(["{jet_string_path(&slow)}"]).timeout(timeout), process.cmd(["cat"])]) ?? panic("pipeline failed")
    print(result.timed_out)
}
"""
    (code, stdout, stderr) :: build_and_run(&dir, "process_pipeline_timeout", &src, &[], None)
    assert_eq(code, 0, "stderr:\n{stderr}")
    assert_eq(stdout, "true\n")
    started :: Instant.now()
    rerun :: Command.new(dir.join("process_pipeline_timeout")).current_dir(&dir).output().unwrap()
    assert(started.elapsed() < Duration.from_millis(800), "pipeline ignored stage timeout: {started.elapsed().debug()}")
    assert_eq(rerun.status.code(), Some(0))
    assert_eq(rerun.stdout, "true\n".as_bytes())
    _ :: fs.remove_dir_all(&dir)
}
