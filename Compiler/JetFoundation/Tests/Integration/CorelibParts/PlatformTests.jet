    write_executable(&flood, "#!/bin/sh\ndd if=/dev/zero bs=8192 count=32 2>/dev/null | tr '\\000' x\n")
    src :: """
use core.process as process
fn run() -> {
    bounded :: process.cmd(["{jet_string_path(&flood)}"]).output_limit(1024)
    result :: process.pipeline([bounded, process.cmd(["cat"])])
    if result == {
        .Ok(_) -> { print("limit:accepted") }
        .Err(_) -> { print("limit:refused") }
    }
}
"""
    (code, stdout, stderr) :: build_and_run(&dir, "process_pipeline_output_limit", &src, &[], None)
    assert_eq(code, 0, "stderr:\n{stderr}")
    assert_eq(stdout, "limit:refused\n")
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/corelib_parts/platform.rs:618
#Test("core_process_live_stream_does_not_block_on_sibling_output") {
    if target.selected_family() != "unix" { return }
    dir :: env.temp_dir().join("jet_core_process_live_backpressure-{std.process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    slow :: dir.join("slow.sh")
    write_executable(&slow, """
#!/bin/sh
dd if=/dev/zero bs=131072 count=1 1>&2 2>/dev/null &
writer=$!
(sleep 2; kill -9 "$writer" 2>/dev/null) >/dev/null 2>&1 &
killer=$!
wait "$writer"
kill "$killer" 2>/dev/null || true
printf 'done\\n'
""")
    src :: """
use core.process as process
fn run() -> {
    child :: process.cmd(["{jet_string_path(&slow)}"]).stdout(.Stream).stderr(.Stream).spawn() ?? panic("spawn failed")
    loop line in child.stdout.lines() { print(line) }
    child.wait() ?? panic("wait failed")
    print("finished")
}
"""
    (code, stdout, stderr) :: build_and_run(&dir, "process_live_backpressure", &src, &[], None)
    assert_eq(code, 0, "stderr:\n{stderr}")
    assert_eq(stdout, "done\nfinished\n")
    assert(stderr.is_empty(), "unexpected child stderr: {stderr.debug()}")
    started :: Instant.now()
    rerun :: Command.new(dir.join("process_live_backpressure")).current_dir(&dir).output().unwrap()
    assert(started.elapsed() < Duration.from_millis(1500), "live stream waited for the sibling pipe instead of draining it: {started.elapsed().debug()}")
    assert_eq(rerun.status.code(), Some(0))
    assert_eq(rerun.stdout, "done\nfinished\n".as_bytes())
    assert(rerun.stderr.is_empty(), "unexpected child stderr: {rerun.stderr.debug()}")
}
// Rust: tests/corelib_parts/platform.rs:679
#Test("core_process_limits_kill_descendants_and_stop_output_early") {
    if target.selected_family() != "unix" { return }
    dir :: env.temp_dir().join("jet_core_process_limits-{std.process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    timeout_pid :: dir.join("timeout.pid")
    output_pid :: dir.join("output.pid")
    timeout_script :: dir.join("timeout.sh")
    output_script :: dir.join("output.sh")
    write_executable(&timeout_script, "#!/bin/sh\nsleep 30 &\nprintf '%s\\n' \"$!\" > '{timeout_pid.display()}'\nwait\n")
    write_executable(&output_script, "#!/bin/sh\nsleep 2 &\nprintf '%s\\n' \"$!\" > '{output_pid.display()}'\nprintf '0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef'\nwait\n")
    src :: """
use core.process as process
use core.time as time
fn run() -[Exec, IO, Time.Wait]> {
    timeout :: Duration.seconds(1) ?? panic("duration")
    timed :: process.run_spec(process.cmd(["{jet_string_path(&timeout_script)}"]).timeout(timeout)) ?? panic("timeout run failed")
    print(timed.timed_out)
    limited :: process.run_spec(process.cmd(["{jet_string_path(&output_script)}"]).output_limit(16))
    if limited == {
        .Ok(_) -> { print("limit:accepted") }
        .Err(_) -> { print("limit:refused") }
    }
}
"""
    // Time only the already-built production executable, not compilation.
    (code, stdout, stderr) :: build_and_run(&dir, "process_limits", &src, &[], None)
    assert_eq(code, 0, "stderr:\n{stderr}")
    assert(stdout.contains("true\nlimit:refused\n"), "{stdout}")
    started :: Instant.now()
    rerun :: Command.new(dir.join("process_limits")).current_dir(&dir).output().unwrap()
    assert(started.elapsed() < Duration.from_secs(2), "output limit waited for the child instead of terminating it: {started.elapsed().debug()}")
    assert_eq(rerun.status.code(), Some(0))
    assert_eq(rerun.stdout, "true\nlimit:refused\n".as_bytes())
    loop pid_file in [&timeout_pid, &output_pid] {
        pid_text :: fs.read_to_string(pid_file).unwrap()
        pid := pid_text.trim() // #4303
        alive :: Command.new("kill").args(["-0", pid]).status().unwrap().success()
        if alive { _ :: Command.new("kill").args(["-9", pid]).status() }
        assert(!alive, "process descendant {pid} survived enforcement")
    }
}
