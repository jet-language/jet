use std.io.[BufReader, BufRead, Read]
use std.process.Child
use std.time.[Duration, Instant]
use std.thread
// GATE #4494: POSIX signal FFI and real child pipe/process providers.
// Rust: tests/corelib_parts/compile.rs:592,676,829,906,1052
#FFI(c, symbol: "kill")
#Unsafe("POSIX kill sends SIGINT to the explicitly spawned test child")
pub fn kill(pid: I32, signal: I32) -> I32 {}

// Rust: tests/corelib_parts/compile.rs:1045
// Send SIGINT after readiness, then collect the observable signal delivery.
pub fn interrupt_and_collect(child: Child, tier: String) -> (I32?, String) {
    child := ^child
    stdout := BufReader.new(child.stdout.take().unwrap())
    ready := String.new()
    stdout.read_line(&ready).unwrap()
    assert_eq(ready, "ready\n", "{tier} did not finish registering")
    assert_eq(#Unsafe("signal the registered child process") { kill(child.id() as I32, 2) }, 0, "send SIGINT to {tier}")
    deadline :: Instant.now() + Duration.from_secs(30)
    status :: loop {
        if child.try_wait().unwrap() == { Some(status) -> break status, None -> {} }
        if Instant.now() >= deadline {
            _ :: child.kill()
            _ :: child.wait()
            panic("{tier} did not exit after SIGINT")
        }
        thread.sleep(Duration.from_millis(25))
    }
    rest := String.new()
    stdout.read_to_string(&rest).unwrap()
    stderr := String.new()
    child.stderr.take().unwrap().read_to_string(&stderr).unwrap()
    assert(!stderr.contains("unsupported"), "{tier} refused the program instead of running it: {stderr}")
    (status.code(), "{ready}{rest}")
}
