    response := [U8]{}
    &response.extend_from_slice(query[0..2])
    &response.extend_from_slice((0x8180 as U16).to_be_bytes())
    &response.extend_from_slice((1 as U16).to_be_bytes())
    &response.extend_from_slice((1 as U16).to_be_bytes())
    &response.extend_from_slice((0 as U16).to_be_bytes())
    &response.extend_from_slice((1 as U16).to_be_bytes())
    &response.extend_from_slice(query[12..end])
    &response.extend_from_slice([0xc0, 0x0c])
    &response.extend_from_slice((5 as U16).to_be_bytes())
    &response.extend_from_slice((1 as U16).to_be_bytes())
    &response.extend_from_slice((0 as U32).to_be_bytes())
    &response.extend_from_slice((alias.len() as U16).to_be_bytes())
    &response.extend_from_slice(alias)
    &response.extend_from_slice(alias)
    &response.extend_from_slice((1 as U16).to_be_bytes())
    &response.extend_from_slice((1 as U16).to_be_bytes())
    &response.extend_from_slice((0 as U32).to_be_bytes())
    &response.extend_from_slice((4 as U16).to_be_bytes())
    &response.extend_from_slice([192, 0, 2, 42])
    response
}

// Rust: tests/corelib_parts/support.rs:343
fn bind_dns_dual_protocol_fixture() -> (TcpListener, UdpSocket, SocketAddr) {
    MAX_ATTEMPTS :: 64
    loop attempt in 1..=MAX_ATTEMPTS {
        tcp :: if TcpListener.bind("127.0.0.1:0") == { // GATE #4494; #4409 ErrorKind fidelity
            .Ok(tcp) -> tcp
            .Err(error) -> {
                if error.kind() == ErrorKind.AddrInUse {
                    if attempt < MAX_ATTEMPTS { continue }
                    break
                }
                panic("failed to bind DNS fixture TCP listener: {error}")
            }
        }
        addr :: tcp.local_addr().unwrap_or_else((error) -> panic("failed to read DNS fixture TCP listener address: {error}"))
        if UdpSocket.bind(addr) == {
            .Ok(udp) -> return (^tcp, ^udp, addr)
            .Err(error) -> {
                if error.kind() == ErrorKind.AddrInUse {
                    if attempt < MAX_ATTEMPTS { continue }
                    break
                }
                panic("failed to bind DNS fixture UDP socket at {addr}: {error}")
            }
        }
    }
    panic("failed to reserve one TCP/UDP DNS fixture port after {MAX_ATTEMPTS} attempts")
}

// Rust: tests/dev_parts/corpus_gate.rs:105
fn core_conformance_shard(entries: [(String, String)]) -> [(String, String)] {
    index :: std.env.var("JET_CORE_CONFORMANCE_SHARD_INDEX").ok()
    count :: std.env.var("JET_CORE_CONFORMANCE_SHARD_COUNT").ok()
    selected :: if (index, count) == {
        (.None, .None) -> ^entries
        (.Some(index_text), .Some(count_text)) -> {
            index :: index_text.parse[USize]().expect("Core conformance shard index must be an integer")
            count :: count_text.parse[USize]().expect("Core conformance shard count must be an integer")
            assert(count > 0, "Core conformance shard count must be positive")
            assert(index < count, "Core conformance shard index must be below its count")
            entries.into_iter().enumerate().filter_map(((position, entry)) -> if position % count == index { .Some(^entry) } else { .None }).collect()
        }
        _ -> panic("Core conformance shard index and count must be set together")
    }
    if std.env.var("JET_CORE_CONFORMANCE_FILTER") == .Ok(filter) {
        trimmed := filter.trim() // #4303
        if !trimmed.is_empty() {
            needles :: filter.split(',').map((n) -> { text := n.trim(); text.to_string() }).filter((n) -> !n.is_empty()).collect[[String]]()
            kept :: selected.into_iter().filter(((stem, _)) -> needles.iter().any((n) -> stem.contains(n))).collect[[(String, String)]]()
            assert(!kept.is_empty(), "Core conformance filter `{filter}` matched no witness stem")
            return kept
        }
    }
    selected
}

