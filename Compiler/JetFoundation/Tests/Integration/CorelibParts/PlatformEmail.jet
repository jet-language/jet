// Rust: tests/corelib_parts/support.rs:27
fn compile_temp(name: String, src: String) -> CompileOutput {
    dir :: std.env.temp_dir().join("jet_corelib_test_{std.process.id()}") // GATE #4494
    fs.create_dir_all(dir).unwrap()
    path :: dir.join(name)
    fs.write(path, src).unwrap()
    shown :: path.to_string_lossy()
    compile_with_path(src, shown).unwrap_or_else((diags) -> panic("front end rejected fixture:\n{render_diagnostics(shown, src, diags)}"))
}

// Rust: tests/corelib_parts/support.rs:41
fn standalone_tls_probe_source(rust: String) -> String {
    renamed :: rust.replacen("fn main()", "fn jet_generated_main()", 1)
    isolated := String.with_capacity(renamed.len())
    cfg_test := false
    test_module := 0
    loop line in renamed.split_inclusive('\n') {
        body :: line.strip_suffix('\n').unwrap_or(line)
        if body == "#[cfg(test)]" {
            cfg_test = true
            &isolated.push_str(line)
            continue
        }
        if body.starts_with("extern crate jet_ffi_") { continue }
        if body.starts_with("fn jet_ffi_install_reporter() {") {
            &isolated.push_str("fn jet_ffi_install_reporter() {}")
            if line.ends_with('\n') { &isolated.push('\n') }
            continue
        }
        if cfg_test {
            cfg_test = false
            trimmed := body.trim_start() // #4303
            if trimmed.starts_with("mod tests {") {
                &isolated.push_str(body[0..body.len() - trimmed.len()])
                &isolated.push_str("mod jet_standalone_test_module_{test_module} {{")
                if line.ends_with('\n') { &isolated.push('\n') }
                test_module += 1
                continue
            }
        }
        &isolated.push_str(line)
    }
    isolated
}

// Rust: tests/corelib_parts/support.rs:82
