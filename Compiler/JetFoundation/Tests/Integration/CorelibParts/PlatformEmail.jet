// Rust: tests/corelib_parts/support.rs:86
fn build_and_run(dir: OSPath, name: String, src: String, env: [(String, String)], stdin: String?) -> (I32, String, String) {
    path :: dir.join(name)
    fs.write(path, src).unwrap()
    shown :: path.to_string_lossy()
    out :: compile_with_path(src, shown).unwrap_or_else((diags) -> panic("front end rejected fixture:\n{render_diagnostics(shown, src, diags)}"))
    rs :: dir.join("{name}.rs")
    bin :: dir.join(name)
    rustc_cmd := Command.new("rustc") // GATE #4494: real child process provider
    runtime_lease :: common.add_generated_rust(&rustc_cmd, rs, out.rust, out.ffi.is_some(), [])
    &rustc_cmd.arg("-o").arg(bin)
    if out.ffi == .Some(link) {
        &rustc_cmd.arg("--extern").arg("{link.crate_name}={link.rlib_path.display()}")
        loop deps_dir in link.dependency_dirs().filter((dir) -> dir.is_dir()) {
            &rustc_cmd.arg("-L").arg("dependency={deps_dir.display()}")
        }
    }
    rustc :: rustc_cmd.output().unwrap()
    assert(rustc.status.success(), "rustc rejected generated code:\n{String.from_utf8_lossy(rustc.stderr)}")
    cmd := Command.new(bin)
    &cmd.current_dir(dir)
    loop (k, v) in env { &cmd.env(k, v) }
    if stdin == .Some(text) {
        &cmd.stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.piped())
        child := cmd.spawn().unwrap()
        if &child.stdin.take() == .Some(input) { &input.write_all(text.as_bytes()).unwrap() }
        output :: child.wait_with_output().unwrap()
        return (output.status.code().unwrap_or(-1), String.from_utf8_lossy(output.stdout).into_owned(), String.from_utf8_lossy(output.stderr).into_owned())
    }
    output :: cmd.output().unwrap()
    (output.status.code().unwrap_or(-1), String.from_utf8_lossy(output.stdout).into_owned(), String.from_utf8_lossy(output.stderr).into_owned())
}

// Rust: tests/corelib_parts/support.rs:152
fn run_web_js_source(dir: OSPath, name: String, src: String) -> String? {
    if Command.new("node").arg("--version").output().is_err() { return .None }
    web_dir :: dir.join("{name}_web")
    _ :: fs.remove_dir_all(web_dir)
    fs.create_dir_all(web_dir).unwrap()
    source_path :: web_dir.join("{name}.jet")
    fs.write(source_path, src).unwrap()
    shown :: source_path.to_string_lossy()
    out :: compile_web_with_path(src, shown).unwrap_or_else((diags) -> panic("front end rejected Web fixture:\n{render_diagnostics(shown, src, diags)}"))
    web :: out.web.expect("Web fixture must produce Web artifacts")
    fs.write(web_dir.join("app.js"), web.js_app).unwrap()
    fs.write(web_dir.join("jet_dom_runtime.js"), web.dom_runtime).unwrap()
    fs.write(web_dir.join("package.json"), "{\"type\":\"module\"}").unwrap()
    node :: Command.new("node").current_dir(web_dir).arg("app.js").output().unwrap()
    assert(node.status.success(), "Web JS fixture failed:\nstdout: {String.from_utf8_lossy(node.stdout)}\nstderr: {String.from_utf8_lossy(node.stderr)}")
    .Some(String.from_utf8_lossy(node.stdout).into_owned())
}

// Rust: tests/corelib_parts/support.rs:186
fn build_and_run_multi(dir: OSPath, name: String, entry: String, files: [(String, String)]) -> (I32, String, String) {
    loop (rel, src) in files {
        path :: dir.join(rel)
        if path.parent() == .Some(parent) { fs.create_dir_all(parent).unwrap() }
        fs.write(path, src).unwrap()
    }
    entry_path :: dir.join(entry)
    src :: fs.read_to_string(entry_path).unwrap()
    shown :: entry_path.to_string_lossy()
    out :: compile_with_path(src, shown).unwrap_or_else((diags) -> panic("front end rejected multi-file fixture:\n{render_diagnostics(shown, src, diags)}"))
    rs :: dir.join("{name}.rs")
    bin :: dir.join(name)
    rustc_cmd := Command.new("rustc") // GATE #4494
    runtime_lease :: common.add_generated_rust(&rustc_cmd, rs, out.rust, out.ffi.is_some(), [])
    rustc :: rustc_cmd.arg("-o").arg(bin).output().unwrap()
    assert(rustc.status.success(), "rustc rejected generated multi-file code:\n{String.from_utf8_lossy(rustc.stderr)}")
    run :: Command.new(bin).current_dir(dir).output().unwrap()
    (run.status.code().unwrap_or(-1), String.from_utf8_lossy(run.stdout).into_owned(), String.from_utf8_lossy(run.stderr).into_owned())
}

// Rust: tests/corelib_parts/support.rs:227
fn write_executable(path: OSPath, body: String) -> {
    if core.sys.target.selected_family() == "unix" { // GATE #4483
        fs.write(path, body).unwrap()
        perms := fs.metadata(path).unwrap().permissions()
        &perms.set_mode(0o755) // GATE #4494
        fs.set_permissions(path, perms).unwrap()
    }
}

// Rust: tests/corelib_parts/support.rs:234
fn jet_string_path(path: OSPath) -> String {
    path.to_string_lossy().replace('\\', "\\\\").replace('"', "\\\"")
}

// Rust: tests/corelib_parts/support.rs:240
fn dns_name_wire(name: String) -> [U8] {
    out := [U8]{}
    trimmed := name.trim_end_matches('.') // #4303
    loop label in trimmed.split('.') {
        &out.push(label.len() as U8)
        &out.extend_from_slice(label.as_bytes())
    }
    &out.push(0)
    out
}

// Rust: tests/corelib_parts/support.rs:250
fn dns_fixture_response(query: [U8]) -> [U8] {
    pos := 12
    loop pos < query.len() && query[pos] != 0 { pos += query[pos] as USize + 1 }
    pos += 1
    qtype :: U16.from_be_bytes([query[pos], query[pos + 1]])
    question_end :: pos + 4
    resp := [U8]{}
    &resp.extend_from_slice(query[0..2])
    &resp.extend_from_slice((0x8180 as U16).to_be_bytes())
    &resp.extend_from_slice((1 as U16).to_be_bytes())
    &resp.extend_from_slice((1 as U16).to_be_bytes())
    &resp.extend_from_slice((0 as U16).to_be_bytes())
    &resp.extend_from_slice((0 as U16).to_be_bytes())
    &resp.extend_from_slice(query[12..question_end])
    &resp.extend_from_slice([0xc0, 0x0c])
    &resp.extend_from_slice(qtype.to_be_bytes())
    &resp.extend_from_slice((1 as U16).to_be_bytes())
    &resp.extend_from_slice((0 as U32).to_be_bytes())
    rdata :: if qtype == {
        16 -> {
            r := [U8]{}
            &r.push(3)
            &r.extend_from_slice("jet".as_bytes())
            r
        }
        33 -> {
            r := [U8]{}
            &r.extend_from_slice((10 as U16).to_be_bytes())
            &r.extend_from_slice((20 as U16).to_be_bytes())
            &r.extend_from_slice((443 as U16).to_be_bytes())
            &r.extend_from_slice(dns_name_wire("srv.example.test"))
            r
        }
        _ -> [U8]{}
    }
    &resp.extend_from_slice((rdata.len() as U16).to_be_bytes())
    &resp.extend_from_slice(rdata)
    resp
}

// Rust: tests/corelib_parts/support.rs:292
fn dns_question_end(query: [U8]) -> USize {
    pos := 12
    loop pos < query.len() && query[pos] != 0 { pos += query[pos] as USize + 1 }
    pos + 5
}

// Rust: tests/corelib_parts/support.rs:300
fn dns_truncated_response(query: [U8]) -> [U8] {
    end :: dns_question_end(query)
    response := [U8]{}
    &response.extend_from_slice(query[0..2])
    &response.extend_from_slice((0x8380 as U16).to_be_bytes())
    &response.extend_from_slice((1 as U16).to_be_bytes())
    &response.extend_from_slice((1 as U16).to_be_bytes())
    &response.extend_from_slice((0 as U16).to_be_bytes())
    &response.extend_from_slice((0 as U16).to_be_bytes())
    &response.extend_from_slice(query[12..end])
    // The authenticated TC header/question must trigger TCP retry before parsing this incomplete record.
    &response.push(0xc0)
    response
}

