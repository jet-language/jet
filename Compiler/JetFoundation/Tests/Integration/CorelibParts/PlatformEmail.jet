// PORT-PENDING 1021 tests-corelib-parts-platform-email-module-group: tests/dev_parts/corpus.rs:1-31
// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS // The shared corpus observation and everything ratcheted against it (#2020).
//RS //
//RS // `jit_coverage_audit` and `cranelift_three_way_differential_battery` both read the ONE memoised
//RS // `collect_jit_coverage` walk, so they are deliberately kept in the SAME target:
//RS // splitting them apart would pay for that whole-corpus compile walk twice and
//RS // let two copies of the same answer drift (AGENTS.md I8).
//RS 
//RS /// The one compile-coverage ratchet (#125 / #778, hole closed by #1663).
//RS ///
//RS /// Audits every example through the JIT lowerer and the observed run-tier gate.
//RS /// The old hand-maintained `jit_gaps.txt` baseline is retired. The audit now
//RS /// states its own denominator: `EXAMPLE_CORPUS_FLOOR` pins how many stems it
//RS /// measures and `OUT_OF_UNIVERSE_CEILING` pins how many it cannot judge.
//RS #[test]
//RS fn jit_coverage_audit() {
//RS     with_jit_test_scope(jit_coverage_audit_inner);
//RS }
//RS 
//RS /// c139 M3+: three-way differential (JIT == interpreter == AOT) on resident-safe examples.
//RS ///
//RS /// The universe is stated, not implied: the `resident_safe` bucket of the shared
//RS /// `collect_jit_coverage` observation — the compile-covered stems the resident
//RS /// JIT will also run — restricted to the ones carrying an `.out` golden. Every
//RS /// other stem of the corpus is counted and named on every run, and
//RS /// `EXAMPLE_CORPUS_FLOOR`, `OUT_OF_UNIVERSE_CEILING`, `RESIDENT_SAFE_FLOOR` and
//RS /// `THREE_WAY_RAN_FLOOR` pin all of it, so this battery cannot pass over a
//RS /// universe that quietly shrank (#2012).
//RS #[test]
//RS fn cranelift_three_way_differential_battery() {
//RS     with_jit_test_scope(cranelift_three_way_differential_battery_inner);
//RS }
// END-PORT-PENDING 1021 tests/dev_parts/corpus.rs:1-31

// PORT-PENDING 1021 tests-corelib-parts-platform-email-module-group: tests/dev_parts/corpus_gate.rs:1-513
// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS // The strict JIT<->AOT differential corpus gate (#2020).
//RS //
//RS // Own target: it classifies all ~500 stems with an AOT build each, and
//RS // `Tools/ci/jit-aot-parity.sh` already runs it as its own invocation.
//RS 
//RS /// #2013: the ledger accounts for the whole corpus — checked with no run at all.
//RS ///
//RS /// Deliberately its own test, ahead of the gate below. The gate needs a Cranelift
//RS /// host and an AOT build per stem and returns green early where the host is
//RS /// unsupported, so `tests/jit_corpus_gate.txt` could — and did — drift to 374
//RS /// rows against a 496-stem corpus without any check firing. This one parses the
//RS /// ledger and walks `Examples/features/<topic>/`; it runs everywhere, in
//RS /// milliseconds, and says nothing about which tier runs a stem.
//RS #[test]
//RS fn corpus_gate_manifest_accounts_for_every_example() {
//RS     assert_corpus_gate_manifest_covers_corpus();
//RS }
//RS 
//RS /// #2013 negative control: the completeness law actually fires.
//RS ///
