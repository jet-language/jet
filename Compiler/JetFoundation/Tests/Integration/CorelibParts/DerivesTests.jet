    assert_eq(code, 0, "cross-module generated decode failed: {stderr}")
    assert_eq(stdout, "{\"shipping\":{\"city\":\"Paris\"},\"quantities\":[2,3],\"labels\":{\"fragile\":1}}\n")
    _ :: fs.remove_dir_all(&dir)
}
