#Test("yaml_full_nested_decode_and_features") {
    if !common.have_rustc() { eprintln("note: skipping yaml_full_nested_decode_and_features (need rustc)"); return }
    dir :: env.temp_dir().join("jet_yaml_full_{process.id()}")
