//RS         .Ok(_) -> { print("pipeline: accepted") }
//RS         .Err(_) -> { print("pipeline: refused") }
//RS     }
//RS     if process.run_spec(process.cmd([]).terminal()) == {
//RS         .Ok(_) -> { print("empty: accepted") }
