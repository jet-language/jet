// Rust: tests/corelib_parts/system.rs:422
#Test("process_wait_observes_inherited_deadline") {
    if selected_family() != "unix" { return } // GATE #4483
    have_rustc :: common.have_rustc()
    if !have_rustc { eprintln("note: skipping process deadline runtime test (need rustc)"); return }
    dir :: env.temp_dir().join("jet_corelib_process_deadline_{process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    sleeper :: dir.join("sleep.sh")
    write_executable(&sleeper, "#!/bin/sh\nsleep 2\n")
    source :: "\nuse core.process as process\nuse core.time as time\n\nfn run() {{\n    child :: process.cmd([\"{jet_string_path(&sleeper)}\"]).spawn() ?? panic(\"spawn failed\")\n    #Context(deadline: time.now() + 20) {{\n        child.wait() ?? panic(\"wait failed\")\n    }}\n}}\n"
    (code, _stdout, stderr) :: build_and_run(&dir, "process_wait_deadline", &source, &[], None)
    assert_eq(code, 70, "process wait deadline should stop with runtime code 70")
    assert(stderr.contains("Error [E3003]") && stderr.contains("process wait"), "process wait should report its compiler-owned deadline boundary: {stderr:?}")
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/corelib_parts/system.rs:461
#Test("core_sys_expand_home_patterns_are_identical_across_tiers") {
    inherited_home :: env.var("HOME").expect("HOME must be present in the test environment")
    assert(!inherited_home.is_empty(), "HOME must be nonempty in the test environment")
    tir_support.assert_tiers_agree("core_sys_expand_home_patterns", """
use core.sys as sys

fn run() {
    home :: sys.get("HOME") ?? ""
    print(home != "")
    print(sys.expand("$HOME") == home)
    print(sys.expand("${{HOME}}") == home)
    print(sys.expand("%HOME%") == home)
    print(sys.expand("λ<$HOME>🌍") == "λ<{home}>🌍")
    print(sys.expand("$$HOME") == "$HOME")
}
""", "true\ntrue\ntrue\ntrue\ntrue\ntrue\n")
}
