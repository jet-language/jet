// Rust: tests/corelib_parts/system.rs:936
#Test("race_cancels_losing_task") {
    have_rustc :: common.have_rustc()
    if !have_rustc { eprintln("note: skipping race cancel test (need rustc)"); return }
    dir :: env.temp_dir().join("jet_race_cancel_{process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    (code, stdout, stderr) :: build_and_run(&dir, "race_cancel", """
use core.tasks as tasks
use core.time as time

fn fast_nine() -> Int { return 9 }
fn slow_one() -> Int {
    time.sleep(300ms)
    return 1
}
fn run() {
    task.group g {
        winner :: (task.race { slow_one(), fast_nine() }) ?? panic("race failed")
        print(winner)
    }
}
""", &[], None)
    assert_eq(code, 0, "race cancel test failed: {stderr}")
    assert_eq(stdout, "9\n")
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/corelib_parts/system.rs:981
#Test("compiler_sources_reject_retired_jet_ring_keys") {
    // Guard all Jet compiler source owners after clean Rust cutover.
    roots :: ["Source", "Compiler/JetFoundation/Source", "Compiler/JetDriver/Source", "Compiler/JetSema/Source", "Compiler/JetCodegen/Source", "Compiler/JetComptime/Source", "Compiler/JetRepl/Source"]
    retired :: ["\"jet.log\"", "\"jet.crypto\"", "\"jet.http\"", "\"jet.regex\"", "\"jet.reactive\"", "\"jet.db\"", "\"jet.plugin\"", "\"jet.time\""]
    pending := roots.iter().map((root) -> OSPath(root)).collect::<[OSPath]>()
    while path :: pending.pop() {
        metadata :: fs.metadata(&path).unwrap_or_else((error) -> panic("failed to inspect compiler source {path.display()}: {error}"))
        if metadata.is_dir() {
            for entry in fs.read_dir(&path).unwrap_or_else((error) -> panic("failed to read compiler source {path.display()}: {error}")) { pending.push(entry.unwrap().path()) }
            continue
        }
        if path.extension().and_then((extension) -> extension.to_str()) != Val("jet") { continue }
        source :: fs.read_to_string(&path).unwrap_or_else((error) -> panic("failed to read compiler source {path.display()}: {error}"))
        for key in &retired { assert(!source.contains(key), "retired internal module key {key} found in {path.display()}") }
    }
}
// Rust: tests/corelib_parts/system.rs:1035
#Test("core_reference_lists_every_built_core_module") {
    docs :: fs.read_to_string("Docs/spec/reference/core-library.md").expect("core library reference must exist")
    missing :: Loader.KNOWN_CORE_MODULES.iter().copied().filter((module) -> module != "core").filter((module) -> !docs.contains("`{module}`")).collect::<[String]>()
    assert(missing.is_empty(), "Docs/spec/reference/core-library.md must list every built Core module from KNOWN_CORE_MODULES: {missing:?}")
}
// Rust: tests/corelib_parts/system.rs:1052
#Test("retired_core_namespaces_name_their_canonical_homes") {
    assert_eq(AST.core_list_prefix("core"), Val("core"))
    assert_eq(AST.core_list_prefix("core.game"), Val("core.game"))
    assert_eq(AST.core_list_prefix("jet"), None)
    assert_eq(AST.core_list_prefix("jet.game"), None)
    retired :: [("core.io", "core.term"), ("core.path", "core.files"), ("core.time.date", "core.time"), ("core.time.datetime", "core.time"), ("core.text.unicode", "core.text"), ("core.fmt", "core.text.fmt"), ("core.random", "core.math.random"), ("core.env", "core.sys"), ("core.os", "core.sys"), ("core.tls", "core.net.tls"), ("core.ws", "core.net.ws"), ("core.url", "core.net.url"), ("core.mime", "core.net.mime"), ("core.uuid", "core.crypto.uuid"), ("core.vault", "core.crypto.vault"), ("core.raylib", "core.game.raylib"), ("core.browser", "core.web.browser"), ("core.solve", "core.compute.solve"), ("core.sketch.hll", "core.data.sketch.hll"), ("core.sketch.tdigest", "core.data.sketch.tdigest"), ("core.sketch.reservoir", "core.data.sketch.reservoir"), ("core.sketch.cms", "core.data.sketch.cms"), ("core.compress.gzip", "core.archive.gzip"), ("core.compress.zstd", "core.archive.zstd"), ("core.science.measurement", "core.units"), ("core.mem.alloc", "core.mem"), ("core.scope", "core.mem.scope"), ("core.lang", "core.compiler.lang"), ("core.binary", "core.encoding")]
    for (retired, canonical) in retired {
        source :: "use {retired} as old\nfn run() {{}}\n"
        diagnostics :: compile(&source).expect_err(retired)
        diagnostic :: diagnostics.iter().find((diagnostic) -> diagnostic.code == "E1001").unwrap_or_else(() -> panic("{retired} did not produce E1001: {diagnostics:?}"))
        assert(diagnostic.fix.contains(canonical), "{retired} did not name {canonical}: {diagnostic.fix}")
    }
}
// Rust: tests/corelib_parts/system.rs:1108
#Test("jet_raylib_namespace_is_not_a_core_module_alias") {
    assert(Syntax.is_known_core_module("core.game.raylib"))
    assert(!Syntax.is_known_core_module("jet.raylib"))
    src :: "\nuse jet.raylib as rl\n\nfn run() {\n    print(\"nope\")\n}\n"
    diags :: compile(src).expect_err("jet.raylib must be rejected")
    assert(diags.iter().any((diagnostic) -> diagnostic.code == "E0341"), "expected E0341 for retired namespace, got: {diags.iter().map((diagnostic) -> diagnostic.code.to_string()).collect::<[String]>():?}")
    assert(diags.iter().any((diagnostic) -> diagnostic.fix.contains("core.game.raylib")), "raylib retirement must name its canonical home: {diags:?}")
}
// Rust: tests/corelib_parts/system.rs:1132
#Test("jet_time_namespace_uses_retirement_teaching") {
    source :: "use jet" + ".time as time\n\n" + "fn run() {\n" + "    time.now()\n" + "}\n"
    diagnostics :: compile(source).expect_err("the retired time namespace must fail")
    assert(diagnostics.iter().any((diagnostic) -> diagnostic.code == "E0341"), "expected E0341 for the retired time namespace, got: {diagnostics.iter().map((diagnostic) -> diagnostic.code.to_string()).collect::<[String]>():?}")
    assert_eq(Syntax.rename_target("jet" + ".time" + ".now"), Val("core.time.now"))
}
