#Test("text_unicode_audit_surface_runs") {
    have_rustc :: common.have_rustc()
    if !have_rustc { eprintln("note: skipping text unicode test (need rustc)"); return }
    dir :: env.temp_dir().join("jet_corelib_text_{process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    (code, stdout, stderr) :: build_and_run(&dir, "text_unicode", """
use core.text as text

fn run() {
    print(text.caseless_eq("Straße", "STRASSE"))
    print(text.nfc("é") == "é")
    print(text.nfkc("ﬃ"))
    print(text.graphemes("é👍").len())
    print(text.words("Hi, κόσμε 123.").len())
    print(text.sentences("One. Two!").len())
    print(text.display_width("表a"))
    print(text.is_alphabetic("Ж"))
    print(text.is_numeric("٣"))
    print(text.pad_start("7", 3, "0"))
    print(text.center("x", 3, "."))
    print(text.starts_any("jetpack", ["jet", "go"]))
    print(text.char_indices("éa")[1])
}
""", &[], None)
    assert_eq(code, 0, "text unicode test failed: {stderr}")
    assert_eq(stdout, "true\ntrue\nffi\n2\n3\n2\n3\ntrue\ntrue\n007\n.x.\ntrue\n2:a\n")
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/corelib_parts/system.rs:45
#Test("db_checked_sql_execute_uses_typed_sql") {
    assert(common.have_rustc(), "DB query_one proof requires rustc")
    dir :: env.temp_dir().join("jet_corelib_db_sql_{process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    (code, stdout, stderr) :: build_and_run(&dir, "db_checked_sql", """
use core.db as db

fn run() {
    conn := db.open_memory()
    policy :: db.policy("person", "true") ?? panic("policy")
    scoped := conn.with_policy(policy, "owner")
    created :: db.migrate(scoped, "person-v1", [
        SQL{"CREATE TABLE person (id INTEGER PRIMARY KEY, name TEXT, active INTEGER)"}
    ]) ?? panic("migrate")
    skipped :: db.migrate(scoped, "person-v1", [
        SQL{"CREATE TABLE person (id INTEGER PRIMARY KEY, name TEXT, active INTEGER)"}
    ]) ?? panic("migrate again")
    id :: 7
    name :: "Ada"
    insert :: SQL{"INSERT INTO person (id, name, active) VALUES ({id}, {name}, 1)"}
    _inserted :: scoped.execute(insert) ?? panic("insert")
    failed :: db.transaction(scoped, "bad batch", [
        SQL{"INSERT INTO person (id, name, active) VALUES (8, 'Grace', 1)"},
        SQL{"INSERT INTO missing_table VALUES (1)"}
    ]) ?? 0
    found :: scoped.query_one(SQL{"SELECT id, name, active FROM person WHERE id = {id}"}) ?? panic("query")
    missing_id :: 99
    missing :: scoped.query_one(SQL{"SELECT id, name, active FROM person WHERE id = {missing_id}"})
    counted :: scoped.query_one(SQL{"SELECT COUNT(*) AS n FROM person"}) ?? panic("count")
    print(created)
    print(skipped)
    print(failed)
    print(db.row_int(found, "id") ?? 0)
    print(db.row_text(found, "name") ?? "bad")
    print(db.row_int(found, "active") ?? 0)
    print(db.row_int(counted, "n") ?? 0)
    if missing == .None { print("absent") } else { panic("unexpected row") }
    _closed :: scoped.close()
}
""", &[], None)
    assert_eq(code, 0, "db checked sql test failed: {stderr}")
    assert_eq(stdout, "1\n0\n0\n7\nAda\n1\n1\nabsent\n")
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/corelib_parts/system.rs:98
#Test("core_db_implements_driver_trait") {
    assert(common.have_rustc(), "DB Driver query_one proof requires rustc")
    dir :: env.temp_dir().join("jet_corelib_db_driver_{process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    src :: """
use core.db as db

fn count_people<T: Driver>(&conn: T) -> Int DBError! {
    row :: conn.query_one(SQL{"SELECT COUNT(*) AS n FROM person"})
    found :: row ?? panic("missing")
    missing :: conn.query_one(SQL{"SELECT id, name FROM person WHERE id = 99"})
    if missing == .None { print("absent") } else { panic("unexpected row") }
    return .Ok(db.row_int(found, "n") ?? 0)
}

fn run() {
    conn := db.open_memory()
    policy :: db.policy("person", "true") ?? panic("policy")
    scoped := conn.with_policy(policy, "owner")
    _ :: db.migrate(scoped, "person-v1", [
        SQL{"CREATE TABLE person (id INTEGER PRIMARY KEY, name TEXT)"}
    ]) ?? panic("create")
    _ :: scoped.execute(
        SQL{"INSERT INTO person (id, name) VALUES (1, 'Ada')"}
    ) ?? panic("insert")
    n :: count_people(&scoped) ?? panic("count")
    print(n)
    _closed :: scoped.close()
}
"""
    (code, stdout, stderr) :: build_and_run(&dir, "db_driver_trait", src, &[], None)
    assert_eq(code, 0, "db Driver trait AOT failed: {stderr}")
    assert_eq(stdout, "absent\n1\n")
    // I9: default run must retain the same Driver meaning after JIT retirement.
    jet :: jet_bin()
    path :: dir.join("db_driver_trait_run.jet")
    fs.write(&path, src).unwrap()
    out :: Command.new(&jet).arg("run").arg(&path).output().expect("spawn jet run for Driver")
    assert(out.status.success(), "db Driver trait run failed: {String.from_utf8_lossy(&out.stderr)}")
    assert_eq(String.from_utf8_lossy(&out.stdout), "absent\n1\n")
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/corelib_parts/system.rs:158
#Test("core_db_query_one_first_row_matches_all_execution_tiers") {
    assert(common.have_rustc(), "DB query_one parity proof requires rustc")
    dir :: common.unique_tmp("jet_corelib_db_query_one_parity")
    fs.create_dir_all(&dir).unwrap()
    fs.write(dir.join("package.jet"), "name: \"db-query-one-parity\"\nversion: \"0.1.0\"\nauthority: { holds: { allow: [DB, DB.Read, DB.Write, IO, Mem.Alloc] } }\n").unwrap()
    src :: """
use core.db as db

fn run() {
    conn :: db.open_memory()
    policy :: db.policy("person", "true") ?? panic("policy")
    scoped := conn.with_policy(policy, "owner")
    _ :: db.migrate(scoped, "person-v1", [
        SQL{"CREATE TABLE person (id INTEGER PRIMARY KEY, name TEXT)"}
    ]) ?? panic("create")
    _ :: scoped.execute(
        SQL{"INSERT INTO person (id, name) VALUES (7, 'Ada')"}
    ) ?? panic("insert")
    present :: scoped.query_one(
        SQL{"SELECT id, name FROM person WHERE id = 7"}
    )
    if present == {
        .Val(_) -> { print("present") }
        .None -> { panic("present row absent") }
    }
    absent :: scoped.query_one(
        SQL{"SELECT id, name FROM person WHERE id = 99"}
    )
    if absent == .None { print("absent") } else { panic("absent row present") }
    _closed :: scoped.close()
}
"""
    (code, aot_stdout, stderr) :: build_and_run(&dir, "db_query_one_parity", src, &[], None)
    assert_eq(code, 0, "DB query_one AOT failed: {stderr}")
    expected :: "present\nabsent\n"
    assert_eq(aot_stdout, expected)
    // Rust interpreter/JIT representation guards retire; actual O0/O1/O2/Web behavior remains.
    tir_support.assert_tiers_agree("db_query_one_parity", src, expected)
    _ :: fs.remove_dir_all(&dir)
}
