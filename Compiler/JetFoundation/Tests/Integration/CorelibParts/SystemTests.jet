// SL9/R10: importing unused Core modules must not bloat the binary.
// Rust: tests/corelib_parts/system.rs:512
#Test("importing_all_core_modules_without_calls_stays_hello_world_sized") {
    jet :: jet_bin()
    have_rustc :: common.have_rustc()
    if !have_rustc || !jet.exists() { eprintln("note: skipping core use size test (need jet + rustc)"); return }
    dir :: env.temp_dir().join("jet_corelib_size_{process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    fs.create_dir_all(dir.join(".jet/build")).unwrap()
    fs.write(dir.join("hello.jet"), "fn run() {\n    print(\"hello, world\")\n}\n").unwrap()
    fs.write(dir.join("core_import_only.jet"), """
use core.files as fs
use core.term as io
use core.sys as env
use core.process as process
use core.math as math
use core.math.random as random
use core.time as time
use core.encoding.json as json

fn run() {
    print("ok")
}
""").unwrap()
    hello :: Command.new(&jet).args(["build", "--small", "hello.jet"]).current_dir(&dir).output().unwrap()
    assert(hello.status.success(), "hello build failed")
    imports :: Command.new(&jet).args(["build", "--small", "core_import_only.jet"]).current_dir(&dir).output().unwrap()
    assert(imports.status.success(), "import-only build failed")
    hello_size :: fs.metadata(dir.join(".jet/build/hello")).unwrap().len()
    import_size :: fs.metadata(dir.join(".jet/build/core_import_only")).unwrap().len()
    assert(import_size <= hello_size.saturating_add(4096), "import-only binary ({import_size} bytes) should stay within 4 KiB of hello ({hello_size} bytes)")
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/corelib_parts/system.rs:578
#Test("json_decode_lenient_surfaces_coercions") {
    have_rustc :: common.have_rustc()
    if !have_rustc { eprintln("note: skipping json_decode_lenient_surfaces_coercions (need rustc)"); return }
    dir :: env.temp_dir().join("jet_json_decode_{process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    (code_a, stdout_a, stderr_a) :: build_and_run(&dir, "json_coerce_a", """
use core.encoding.json as json
fn run() {
    data :: json.decode("{{\"port\":\"8080\"}}") ?? panic("bad json")
    if data == .Object(m) {
        if m["port"] == .Int(n) { print(n + 1) }
    }
}
""", &[], None)
    assert_eq(code_a, 0, "probe (a) failed: {stderr_a}")
    assert_eq(stdout_a, "8081\n", "probe (a): decoded value should be plain number + 1")
    assert(stderr_a.contains("json coerce") && stderr_a.contains("port") && stderr_a.contains("number"), "probe (a): coercion log line missing or malformed; got: {stderr_a}")
    (code_b, stdout_b, stderr_b) :: build_and_run(&dir, "json_coerce_b", """
use core.encoding.json as json
fn run() {
    data :: json.decode("{{\"port\":8080,\"name\":\"api\"}}") ?? panic("bad json")
    if data == .Object(m) {
        if m["port"] == .Int(n) { print(n) }
    }
}
""", &[], None)
    assert_eq(code_b, 0, "probe (b) failed: {stderr_b}")
    assert_eq(stdout_b, "8080\n", "probe (b): value should be 8080")
    assert(!stderr_b.contains("json coerce"), "probe (b): spurious coercion line emitted for clean JSON; got: {stderr_b}")
    (code_c, stdout_c, stderr_c) :: build_and_run(&dir, "json_coerce_c", """
use core.encoding.json as json
fn run() {
    data :: json.decode("{{\"port\":\"8080\",\"enabled\":\"true\"}}") ?? panic("bad json")
    if data == .Object(m) {
        if m["port"] == .Int(n) { print(n) }
        if m["enabled"] == .Bool(b) { print(b) }
    }
}
""", &[], None)
    assert_eq(code_c, 0, "probe (c) failed: {stderr_c}")
    assert_eq(stdout_c, "8080\ntrue\n", "probe (c): both coerced values should come back plain")
    coerce_lines :: stderr_c.lines().filter((line) -> line.contains("json coerce")).collect::<[String]>()
    assert_eq(coerce_lines.len(), 2, "probe (c): expected 2 coercion lines, got {coerce_lines.len()}; stderr: {stderr_c}")
    assert(coerce_lines.iter().any((line) -> line.contains("port")), "probe (c): no coercion line for 'port'")
    assert(coerce_lines.iter().any((line) -> line.contains("enabled")), "probe (c): no coercion line for 'enabled'")
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/corelib_parts/system.rs:696
#Test("json_parser_is_rfc8259_complete") {
    have_rustc :: common.have_rustc()
    if !have_rustc { eprintln("note: skipping json_parser_is_rfc8259_complete (need rustc)"); return }
    dir :: env.temp_dir().join("jet_json_full_{process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    (code_a, stdout_a, stderr_a) :: build_and_run(&dir, "json_full_a", """
use core.encoding.json as json
fn run() {
    raw :: "{{\"big\":1.5e3,\"acc\":\"caf\\u00e9\",\"grin\":\"\\uD83D\\uDE00\",\"tab\":\"a\\tb\"}}"
    data :: json.parse(raw) ?? panic("bad json")
    print(json.to_string(data))
}
""", &[], None)
    assert_eq(code_a, 0, "probe (a) failed: {stderr_a}")
    // Integral exponent numbers collapse to Int in Data.
    assert_eq(stdout_a, "{\"acc\":\"café\",\"big\":1500,\"grin\":\"😀\",\"tab\":\"a\\tb\"}\n", "probe (a): full parse + re-serialize")
    (code_b, stdout_b, stderr_b) :: build_and_run(&dir, "json_full_b", """
use core.encoding.json as json
fn run() {
    if json.parse("{{\"x\":\"a\\qb\"}}") == {
        .Ok(_) -> { print("OK") }
        .Err(e) -> { print("ERR: {e.message}") }
    }
}
""", &[], None)
    assert_eq(code_b, 0, "probe (b) failed: {stderr_b}")
    assert_eq(stdout_b, "ERR: invalid escape in string\n", "probe (b): bad escape rejected")
    (code_c, stdout_c, stderr_c) :: build_and_run(&dir, "json_full_c", "\nuse core.encoding.json as json\nfn run() {\n    if json.parse(\"{{\\\"x\\\":\\\"a\tb\\\"}}\") == {\n        .Ok(_) -> { print(\"OK\") }\n        .Err(e) -> { print(\"ERR: {e.message}\") }\n    }\n}\n", &[], None)
    assert_eq(code_c, 0, "probe (c) failed: {stderr_c}")
    assert_eq(stdout_c, "ERR: control character in string\n", "probe (c): raw control char rejected")
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/corelib_parts/system.rs:779
#Ignore
#Test("channel_stress_1000_messages") {
    have_rustc :: common.have_rustc()
    if !have_rustc { eprintln("note: skipping channel stress test (need rustc)"); return }
    dir :: env.temp_dir().join("jet_channel_stress_{process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    (code, stdout, stderr) :: build_and_run(&dir, "channel_stress", """
use core.tasks as tasks

fn run() {
(sender, ch) : channel<Int>()
    producer :: task {
        loop i in 1..1000 { sender.send(i) }
    }
    producer.join() ?? 0
    total: Int = 0
    loop i in 1..1000 { total = total + (ch.receive() ?? panic("channel closed")) }
    print(total)
}
""", &[], None)
    assert_eq(code, 0, "channel stress failed: {stderr}")
    assert_eq(stdout, "500500\n")
    _ :: fs.remove_dir_all(&dir)
}
