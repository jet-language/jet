    (test_rust, _) :: Driver.compile_tests(test_path.to_str().unwrap(), false).unwrap()
    assert(test_rust.contains("jet_runtime_boundary(|| jet_runtime_stop(\"E3001\", \"\", 0, &message))"))
    assert(scheduler_host.contains("std::panic::panic_any(rendered)"))
    assert(task_mem.contains("super::jet_runtime_stop_with_context("))
    // Deadline diagnostics route through the interrupt/wait/typed-task boundaries.
    assert(time.contains("jet_runtime_diagnostic(rendered)"))
    assert(time.contains("jet_interrupt_handler_should_unwind()"))
    assert(time.contains("jet_scheduler_wait_boundary_should_unwind()"))
    assert(time.contains("jet_typed_deadline_boundary_should_unwind()"))
    assert(scheduler.contains("fn jet_scheduler_fatal(msg: &str) -> !"))
    assert(scheduler.contains("jet_scheduler_runtime_stop(msg)"))
    assert(scheduler.contains("jet_runtime_diagnostic(rendered)"))
    assert(scheduler.contains("struct JetSchedulerWaitBoundary"))
    assert(scheduler.contains("let _boundary = JetSchedulerWaitBoundary::enter()"))
    assert(scheduler.contains("struct JetTypedDeadlineBoundary"))
    (ordinary_task_spawn, typed_task_spawn) :: task_mem.split_once("pub(crate) fn spawn_typed_deadline").expect("typed-deadline task spawn must remain explicit")
    assert(!ordinary_task_spawn.contains("JetTypedDeadlineBoundary::enter()"))
    typed_body :: typed_task_spawn.split_once("pub fn pause").expect("typed-deadline task spawn boundary").0
    assert(typed_body.contains("let _typed_deadline_boundary"))
    assert(typed_body.contains("super::JetTypedDeadlineBoundary::enter()"))
    assert_eq(core.matches("std::process::exit(").count(), 1)
    assert(core.contains("fn jet_runtime_process_exit(code: i32, report: Option<&str>) -> !"))
    assert(core.contains("Self::SchedulerFatal { msg } => jet_runtime_stop(\"E3001\", \"\", 0, &msg)"))
    assert(core.contains("fn jet_runtime_should_unwind() -> bool"))
    assert(core.contains("jet_scheduler_in_task()"))
    assert(core.contains("jet_interrupt_handler_should_unwind()"))
    assert(core.contains("if jet_runtime_should_unwind()"))
    assert(core.contains("if jet_interrupt_handler_should_unwind()"))
}
// Rust: tests/corelib_parts/compile.rs:987
// The retiring JIT's source-representation assertions become runtime-boundary behavior.
#Test("resident_jit_terminal_helpers_do_not_bypass_the_runtime_boundary") {
    if !common.have_rustc() { return }
    dir :: env.temp_dir().join("jet_corelib_terminal_boundary_{std.process.id()}")
    fs.create_dir_all(&dir).unwrap()
    loop (name, src, code, diagnostic) in [
        ("panic", "fn run() -> { panic(\"boundary failure\") }", 70, "boundary failure"),
        ("exit", "use core.process as process\nfn run() -> { process.exit(1) }", 1, "")
    ] {
        path :: dir.join("{name}.jet")
        fs.write(&path, src).unwrap()
        loop profile in ["debug", "dev", "release"] {
            output :: Command.new(env.bin_exe("jet")).args(["run", path.to_str().unwrap(), "--profile={profile}"]).env("NO_COLOR", "1").output().unwrap()
            assert_eq(output.status.code(), Some(code), "{profile} {name} runtime boundary exit drifted")
            assert(String.from_utf8_lossy(&output.stderr).contains(diagnostic), "{profile} {name} runtime boundary diagnostic lost")
        }
    }
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/corelib_parts/compile.rs:1013
// #2027: identical real SIGINT, ordered handlers and single consumption across native tiers.
#Test("core_os_interrupt_delivery_matches_aot_jit_and_interpreter") {
    if target.selected_family() != "unix" { return }
    src :: """
use core.sys as os
use core.process as process
fn run() -> {
    os.on_interrupt(() -> { print("first") })
    os.on_interrupt(() -> { print("second"); process.exit(0) })
    print("ready")
    loop { tick :: 0 }
}
"""
    dir :: env.temp_dir().join("jet_corelib_interrupt_tiers_{std.process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    source :: dir.join("interrupt_tiers.jet")
    fs.write(&source, src).unwrap()
    out :: compile_temp("interrupt_tiers.jet", src)
    rs :: dir.join("main.rs")
    bin :: dir.join("interrupt-tiers")
    rustc := Command.new("rustc")
    _runtime_lease :: common.add_generated_rust(&rustc, &rs, &out.rust, out.ffi.is_some(), &[])
    built :: rustc.arg("-o").arg(&bin).output().unwrap()
    assert(built.status.success(), "rustc failed:\n{String.from_utf8_lossy(&built.stderr)}")
    aot :: interrupt_and_collect(Command.new(&bin).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().unwrap(), "aot")
    assert_eq(aot, (Some(0), "ready\nfirst\nsecond\n".to_string()), "AOT interrupt delivery drifted")
    // Signal the built binary directly: CLI-spawned grandchildren do not receive its SIGINT.
    loop profile in ["debug", "dev", "release"] {
        tier_bin :: dir.join("interrupt-{profile}")
        built :: Command.new(env.bin_exe("jet")).args(["build", "interrupt_tiers.jet", "--profile={profile}", "-o", tier_bin.to_str().unwrap()]).current_dir(&dir).env("NO_COLOR", "1").env("JET_STORE_DIR", dir.join("cache-{profile}")).env("JET_RUN_CACHE_DIR", dir.join("run-cache-{profile}")).output().unwrap()
        assert(built.status.success(), "{profile} build failed: {String.from_utf8_lossy(&built.stderr)}")
        observed :: interrupt_and_collect(Command.new(&tier_bin).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().unwrap(), profile)
        assert_eq(observed, aot, "{profile} and AOT disagree about a delivered signal — tiers must share one interrupt count and one consumption rule (#2027)")
    }
    _ :: fs.remove_dir_all(&dir)
}
