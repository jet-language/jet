    scheduler_host :: fs.read_to_string(env.manifest_dir().join("crates/jet-codegen/src/SchedulerHost.rs")).unwrap()
    stream :: fs.read_to_string(env.manifest_dir().join("crates/jet-codegen/src/Prelude/Stream.rs")).unwrap()
    ffi :: fs.read_to_string(env.manifest_dir().join("crates/jet-pkg-model/src/FFI.rs")).unwrap()
