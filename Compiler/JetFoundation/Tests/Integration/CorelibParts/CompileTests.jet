#Test("comptime_find_glob_records_sorted_lock_inputs") {
    dir :: env.temp_dir().join("jet_comptime_find_{std.process.id()}_lock")
    fs.create_dir_all(dir.join("inputs/nested")).unwrap()
    fs.write(dir.join("inputs/alpha-1.txt"), "alpha").unwrap()
    fs.write(dir.join("inputs/nested/beta-2.txt"), "beta").unwrap()
    fs.write(dir.join("inputs/nested/gamma-3.txt"), "gamma").unwrap()
    fs.write(dir.join("inputs/nested/beta-2.md"), "skip").unwrap()
    src :: """
PATHS :: prep { find("inputs/**/{{alpha,beta}}-[0-9].t?t") }
fn run() -> {
    print(PATHS.join("|"))
}
"""
    path :: dir.join("main.jet")
    fs.write(&path, src).unwrap()
    shown :: path.to_string_lossy()
    out :: compile_with_path(src, &shown).unwrap_or_else(fn(diags) -> panic("front end rejected find fixture:\n{render_diagnostics(&shown, src, &diags)}"))
    paths :: out.comptime_inputs.iter().map(fn(input) -> input.path.as_str()).collect()
    assert_eq(paths, ["inputs/alpha-1.txt", "inputs/nested/beta-2.txt"])
    assert(out.comptime_inputs.iter().all(fn(input) -> input.hash.len() == 64))
}
// Rust: tests/corelib_parts/compile.rs:304
#Test("core_args_audit_surface_runs_and_reports_suggestions") {
    dir :: env.temp_dir().join("jet_corelib_args_{std.process.id()}")
    fs.create_dir_all(&dir).unwrap()
    src :: """
use core.args as args
fn run() -> {
    spec :: args.spec()
        .flag_short("verbose", "v", "print extra detail")
        .option_env("profile", "config profile", "NAME", "JET_ARGS_PROFILE")
        .option_int("jobs", "worker count", "N")
        .repeat("tag", "classification tag", "TAG")
    parsed :: spec.parse(["tool", "-vv", "--jobs", "8", "--tag", "a", "--tag=b"]) ?? panic("parse failed")
    print(parsed.flag("verbose"))
    print(parsed.option("profile") ?? "")
    print(parsed.option_int("jobs") ?? 0)
    print(parsed.options("tag").len())
    if spec.parse(["tool", "--verbse"]) == {
        .Ok(_) -> { print("unexpected") }
        .Err(e) -> { print(e) }
    }
}
"""
    (_code, stdout, stderr) :: build_and_run(&dir, "args_audit", src, &[("JET_ARGS_PROFILE", "dev")], None)
    assert(stdout.contains("unknown option `--verbse`") && stdout.contains("did you mean `--verbose`?"), "core.args suggestion missing:\nstdout:\n{stdout}\nstderr:\n{stderr}")
    assert(stdout.starts_with("true\ndev\n8\n2\n"))
}
// Rust: tests/corelib_parts/compile.rs:347
#Test("core_args_parse_or_exit_handles_cli_boundaries_and_keeps_parse_pure") {
    dir :: env.temp_dir().join("jet_corelib_args_exit_{std.process.id()}")
    fs.create_dir_all(&dir).unwrap()
    src :: """
use core.args as args
use core.term as io
fn run() -> {
    spec :: args.spec().flag("verbose", "print extra detail")
    parsed :: spec.parse_or_exit(process.argv())
    embedded :: spec.parse(["embedded", "--verbose"]) ?? panic("pure parse failed")
    print(parsed.flag("verbose"))
    print(embedded.flag("verbose"))
}
"""
    path :: dir.join("args_parse_or_exit.jet")
    fs.write(&path, src).unwrap()
    shown :: path.to_string_lossy()
    out :: compile_with_path(src, &shown).unwrap_or_else(fn(diags) -> panic("front end rejected parse_or_exit fixture:\n{render_diagnostics(&shown, src, &diags)}"))
    rust :: dir.join("args_parse_or_exit.rs")
    bin :: dir.join("args_parse_or_exit")
    command := Command.new("rustc")
    _runtime_lease :: common.add_generated_rust(&command, &rust, &out.rust, out.ffi.is_some(), &[])
    built :: command.arg("-o").arg(&bin).output().unwrap()
    assert(built.status.success(), "rustc rejected generated code:\n{String.from_utf8_lossy(&built.stderr)}")
    normal :: Command.new(&bin).arg("--verbose").output().unwrap()
    assert_eq(normal.status.code(), Some(0))
    assert_eq(String.from_utf8_lossy(&normal.stdout), "true\ntrue\n")
    assert(normal.stderr.is_empty())
    help :: Command.new(&bin).arg("--help").output().unwrap()
    assert_eq(help.status.code(), Some(0))
    help_stdout :: String.from_utf8_lossy(&help.stdout)
    assert(help_stdout.contains("Usage: args_parse_or_exit [options]"))
    assert(help_stdout.contains("--help"))
    assert(help.stderr.is_empty())
    bad :: Command.new(&bin).arg("--verbse").output().unwrap()
    assert_eq(bad.status.code(), Some(2))
    assert(bad.stdout.is_empty())
    bad_stderr :: String.from_utf8_lossy(&bad.stderr)
    assert(bad_stderr.contains("unknown option `--verbse`"))
    assert(bad_stderr.contains("did you mean `--verbose`?"))
}
// Rust: tests/corelib_parts/compile.rs:407
#Test("core_args_parse_or_exit_rejects_surplus_bare_arguments") {
    if !common.have_rustc() { return }
    dir :: env.temp_dir().join("jet_corelib_args_surplus_{std.process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    src :: """
use core.args as args
use core.process as process
fn run() -> {
    spec :: args.spec()
        .option("name", "display name", "NAME")
        .positional("name", "display name")
    parsed :: spec.parse_or_exit(process.argv())
    print(parsed.option("name") ?? "none")
}
"""
    path :: dir.join("args_surplus.jet")
    fs.write(&path, src).unwrap()
    shown :: path.to_string_lossy()
    out :: compile_with_path(src, &shown).unwrap_or_else(fn(diags) -> panic("front end rejected surplus builder fixture:\n{render_diagnostics(&shown, src, &diags)}"))
    rust :: dir.join("args_surplus.rs")
    bin :: dir.join("args_surplus")
    command := Command.new("rustc")
    _runtime_lease :: common.add_generated_rust(&command, &rust, &out.rust, out.ffi.is_some(), &[])
    built :: command.arg("-o").arg(&bin).output().unwrap()
    assert(built.status.success(), "rustc rejected generated code:\n{String.from_utf8_lossy(&built.stderr)}")
    run :: fn(args) -> Command.new(&bin).args(args).output().unwrap()
    named :: run(&["bare-loses", "--name", "named"])
    assert_eq(named.status.code(), Some(0))
    assert_eq(String.from_utf8_lossy(&named.stdout), "named\n")
    assert(named.stderr.is_empty())
    help :: run(&["--help"])
    assert_eq(help.status.code(), Some(0))
    help_stdout :: String.from_utf8_lossy(&help.stdout)
    assert(help_stdout.contains("Usage:"), "{help_stdout}")
    assert(help_stdout.contains("name"), "{help_stdout}")
    assert(help.stderr.is_empty())
    bad :: run(&["first", "second", "third"])
    assert_eq(bad.status.code(), Some(2))
    assert(bad.stdout.is_empty())
    bad_stderr :: String.from_utf8_lossy(&bad.stderr)
    assert(bad_stderr.contains("unexpected arguments"), "{bad_stderr}")
    assert(bad_stderr.contains("`second`") && bad_stderr.contains("`third`"), "{bad_stderr}")
    assert(bad_stderr.contains("Usage:"), "{bad_stderr}")
    _ :: fs.remove_dir_all(&dir)
}
