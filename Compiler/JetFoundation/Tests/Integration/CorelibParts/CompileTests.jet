// Rust: tests/corelib_parts/compile.rs:540
#Test("core_os_interrupt_callback_forms_match_dev_tiers") {
    if target.selected_family() != "unix" { return }
    dir :: env.temp_dir().join("jet_corelib_interrupt_callback_forms_{std.process.id()}")
    fs.create_dir_all(&dir).unwrap()
    aot_source :: """
use core.sys as os
use core.process as process
fn named_callback() -> { print("named") }
fn run() -> {
    indirect :: named_callback
    os.on_interrupt(named_callback)
    os.on_interrupt(indirect)
    os.on_interrupt(() -> { print("inline"); process.exit(0) })
    print("ready")
    loop { }
}
"""
    out :: compile_temp("named_indirect_aot.jet", aot_source)
    rs :: dir.join("named_indirect_aot.rs")
    bin :: dir.join("named_indirect_aot")
    rustc := Command.new("rustc")
    _runtime_lease :: common.add_generated_rust(&rustc, &rs, &out.rust, out.ffi.is_some(), &[])
    built :: rustc.arg("-o").arg(&bin).output().unwrap()
    assert(built.status.success(), "named/indirect/inline AOT rustc failed: {String.from_utf8_lossy(&built.stderr)}")
    child := Command.new(&bin).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().expect("spawn AOT callback program")
    stdout := BufReader.new(child.stdout.take().unwrap())
    ready := String.new()
    stdout.read_line(&ready).unwrap()
    assert_eq(ready, "ready\n", "AOT callback registration was not ready")
    assert_eq(#Unsafe("signal registered test child") { kill(child.id() as I32, 2) }, 0)
    status :: child.wait().unwrap()
    rest := String.new()
    stdout.read_to_string(&rest).unwrap()
    stderr := String.new()
    child.stderr.take().unwrap().read_to_string(&stderr).unwrap()
    assert(status.success(), "AOT callback program failed: {stderr}")
    assert_eq(rest, "named\nnamed\ninline\n")
    dev_source :: """
use core.sys as os
fn named_callback() -> { print("named") }
fn stop_callback() -> { print("stop"); panic("stop") }
fn run() -> {
    loop indirect := stop_callback, true {
        named_alias :: named_callback
        local_lambda :: () -> { print("lambda") }
        os.on_interrupt(() -> { named_alias() })
        os.on_interrupt(local_lambda)
        os.on_interrupt(named_callback)
        os.on_interrupt(indirect)
        print("ready")
        loop { tick :: 0 }
    }
}
"""
    path :: dir.join("named_indirect_dev.jet")
    fs.write(&path, dev_source).unwrap()
    // O0/O1/O2 replace retired interpreter/resident-JIT tier assertions.
    loop profile in ["debug", "dev", "release"] {
        command := Command.new(env.bin_exe("jet"))
        command.args(["build", path.to_str().unwrap(), "--profile={profile}", "-o", bin.to_str().unwrap()]).current_dir(&dir)
        built :: command.output().unwrap()
        assert(built.status.success(), "{profile} callback build failed: {String.from_utf8_lossy(&built.stderr)}")
        child := Command.new(&bin).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().unwrap_or_else(fn(error) -> panic("spawn {profile} callback program: {error}"))
        (lines_tx, lines_rx) :: mpsc.channel()
        child_stdout :: child.stdout.take().unwrap()
        thread.spawn(fn() -> {
            loop line in BufReader.new(^child_stdout).lines() {
                if lines_tx.send(line).is_err() { break }
            }
        })
        ready :: match lines_rx.recv_timeout(Duration.from_secs(30)) {
            Ok(line) -> line.unwrap_or_else(fn(error) -> panic("read {profile} readiness: {error}")),
            Err(error) -> { _ :: child.kill(); _ :: child.wait(); panic("{profile} callback program did not become ready: {error}") }
        }
        assert_eq(ready, "ready", "{profile} callback registration was not ready")
        assert_eq(#Unsafe("SIGINT to child with registered callbacks") { kill(child.id() as I32, 2) }, 0, "send SIGINT to {profile} callback program")
        deadline :: Instant.now() + Duration.from_secs(30)
        status :: loop {
            if child.try_wait().unwrap() == { Some(status) -> break status, None -> {} }
            if Instant.now() >= deadline { _ :: child.kill(); panic("{profile} callback program did not exit after SIGINT") }
            thread.sleep(Duration.from_millis(25))
        }
        stderr := String.new()
        child.stderr.take().unwrap().read_to_string(&stderr).unwrap()
        stdout :: lines_rx.into_iter().collect::<Result<[String], std.io.Error>>().expect("callback stdout is readable").join("\n") + "\n"
        assert(status.code() == Some(70), "{profile} callback program failed: stdout={stdout:?} stderr={stderr:?}")
        assert_eq(stdout, "named\nlambda\nnamed\nstop\n", "{profile} callback dispatch drifted")
        assert(stderr.contains("panic: stop"), "{profile} callback lost the runtime panic diagnostic: {stderr:?}")
        assert(!stderr.contains("unsupported"), "{profile} emitted an unsupported-feature diagnostic: {stderr}")
    }
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/corelib_parts/compile.rs:738
#Test("core_os_interrupt_prelude_is_emitted_only_when_used") {
    facts_only :: compile_temp("os_facts_only.jet", "use core.sys as os\nfn run() -> { print(os.name()) }\n")
    assert(!facts_only.rust.contains("mod jet_os_interrupt") && !facts_only.rust.contains("SetConsoleCtrlHandler") && !facts_only.rust.contains("jet_std_os_on_interrupt"), "ordinary core.sys facts should not inherit signal FFI")
    assert(facts_only.rust.contains("JET_INTERRUPT_HANDLER_DEPTH") && facts_only.rust.contains("fn jet_runtime_should_unwind()"), "safe central panic-boundary state must remain available without signal FFI")
    with_interrupt :: compile_temp("os_interrupt.jet", "use core.sys as os\nfn run() -> { os.on_interrupt(() -> { print(\"interrupted\") }) }\n")
    assert(with_interrupt.rust.contains("mod jet_os_interrupt") && with_interrupt.rust.contains("SetConsoleCtrlHandler") && with_interrupt.rust.contains("CTRL_C_EVENT") && with_interrupt.rust.contains("AtomicUsize") && with_interrupt.rust.contains("catch_unwind") && with_interrupt.rust.contains("struct PanicBoundary") && with_interrupt.rust.contains("impl Drop for PanicBoundary") && with_interrupt.rust.contains("#[cfg(not(any(unix, windows)))]") && with_interrupt.rust.contains("interrupt handling is unavailable on this target") && with_interrupt.rust.contains("jet_std_os_on_interrupt") && !with_interrupt.rust.contains("let _ = handler"), "on_interrupt should keep its Unix/Windows dispatcher and no silent no-op")
}
// Rust: tests/corelib_parts/compile.rs:791
#Test("core_os_interrupt_handlers_are_additive_and_ordered") {
    if target.selected_family() != "unix" { return }
    dir :: env.temp_dir().join("jet_corelib_interrupt_{std.process.id()}")
    fs.create_dir_all(&dir).unwrap()
    src :: """
use core.sys as os
use core.process as process
fn run() -> {
    os.on_interrupt(() -> { panic("first handler failed") })
    os.on_interrupt(() -> { print("second"); process.exit(0) })
    print("ready")
    loop { }
}
"""
    out :: compile_temp("os_interrupt_runtime.jet", src)
    rs :: dir.join("main.rs")
    bin :: dir.join("interrupt-runtime")
    command := Command.new("rustc")
    _runtime_lease :: common.add_generated_rust(&command, &rs, &out.rust, out.ffi.is_some(), &[])
    rustc :: command.arg("-o").arg(&bin).output().unwrap()
    assert(rustc.status.success(), "rustc failed:\n{String.from_utf8_lossy(&rustc.stderr)}")
    child := Command.new(&bin).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().unwrap()
    stdout := BufReader.new(child.stdout.take().unwrap())
    ready := String.new()
    stdout.read_line(&ready).unwrap()
    assert_eq(ready, "ready\n", "registration was not ready before run continued")
    assert_eq(#Unsafe("SIGINT to registered child") { kill(child.id() as I32, 2) }, 0)
    status :: child.wait().unwrap()
    rest := String.new()
    stdout.read_to_string(&rest).unwrap()
    stderr := String.new()
    child.stderr.take().unwrap().read_to_string(&stderr).unwrap()
    assert(status.success(), "interrupt child failed: {status}")
    assert_eq(rest, "second\n")
    assert(stderr.contains("panic: first handler failed"), "first handler panic lost its interrupt boundary diagnostic: {stderr:?}")
}
// Rust: tests/corelib_parts/compile.rs:851
#Test("core_os_interrupt_deadline_diagnostic_unwinds_inside_handler_boundary") {
    if target.selected_family() != "unix" { return }
    dir :: env.temp_dir().join("jet_corelib_interrupt_deadline_{std.process.id()}")
    fs.create_dir_all(&dir).unwrap()
    src :: """
use core.sys as os
use core.process as process
use core.time as time
fn run() -> {
    os.on_interrupt(() -> {
        #Context(deadline: time.now()) { time.sleep(5ms) }
    })
    os.on_interrupt(() -> { print("second"); process.exit(0) })
    print("ready")
    loop { }
}
"""
    out :: compile_temp("os_interrupt_deadline.jet", src)
    assert(out.rust.contains("jet_interrupt_handler_panic_enter") && out.rust.contains("jet_interrupt_handler_panic_leave"), "interrupt handlers need a boundary distinct from scheduler-task identity")
    rs :: dir.join("main.rs")
    bin :: dir.join("interrupt-deadline")
    command := Command.new("rustc")
    _runtime_lease :: common.add_generated_rust(&command, &rs, &out.rust, out.ffi.is_some(), &[])
    rustc :: command.arg("-o").arg(&bin).output().unwrap()
    assert(rustc.status.success(), "rustc failed:\n{String.from_utf8_lossy(&rustc.stderr)}")
    child := Command.new(&bin).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().unwrap()
    stdout := BufReader.new(child.stdout.take().unwrap())
    ready := String.new()
    stdout.read_line(&ready).unwrap()
    assert_eq(ready, "ready\n")
    assert_eq(#Unsafe("SIGINT to child with deadline handler") { kill(child.id() as I32, 2) }, 0)
    output :: child.wait_with_output().unwrap()
    rest := String.new()
    stdout.read_to_string(&rest).unwrap()
    assert(output.status.success(), "interrupt child failed: {output.status}")
    assert_eq(rest, "second\n")
    stderr :: String.from_utf8_lossy(&output.stderr)
    assert(stderr.contains("Error [E3003]: deadline exceeded while waiting in time sleep"))
    assert(stderr.contains("Why: this wait point observed the task context deadline"))
    assert(stderr.contains("Fix: raise the deadline budget or shorten the work"))
}
