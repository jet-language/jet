// Rust: tests/corelib_parts/compile.rs:21
#Test("range_interval_proves_fixed_array_index") {
    src :: """
tag Checked { deny: [Net] }
Die :: distinct Int(1..6)
fn pick(faces: [String#6], roll: Die) -[]> String {
    return faces[roll.raw() - 1]
}
fn run() -> {
    faces :: [String#6]{ "zero", "one", "two", "three", "four", "five" }
    print(pick(faces, Die.from_int(3)))
    print(pick(faces, #Checked Die.from_int(1)))
}
"""
    dir :: env.temp_dir().join("jet_corelib_range_interval_index_{std.process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    (code, aot_stdout, stderr) :: build_and_run(&dir, "range_interval_index", src, &[], None)
    assert_eq(code, 0, "fixed-list AOT failed: {stderr}")
    assert_eq(aot_stdout, "two\nzero\n")
    path :: dir.join("range_interval_index.jet")
    // Retired resident/interpreter representation checks become native O0/O1/O2 equality.
    loop profile in ["debug", "dev", "release"] {
        output :: Command.new(env.bin_exe("jet")).args(["run", path.to_str().unwrap(), "--profile={profile}"]).output().unwrap()
        assert_eq(output.status.code(), Some(0), "{profile} fixed-list run failed: {String.from_utf8_lossy(&output.stderr)}")
        assert(output.stderr.is_empty())
        assert_eq(String.from_utf8_lossy(&output.stdout), aot_stdout, "{profile} fixed-list output drifted")
    }
    web_src :: """
#Target(Web)
tag Checked { deny: [Net] }
Die :: distinct Int(1..6)
#Target(JS)
fn pick(faces: [String#6], roll: Die) -[]> String {
    return faces[roll.raw() - 1]
}
#Target(JS)
fn run() -> {
    faces :: [String#6]{ "zero", "one", "two", "three", "four", "five" }
    print(pick(faces, Die.from_int(3)))
    print(pick(faces, #Checked Die.from_int(1)))
}
"""
    if run_web_js_source(&dir, "range_interval_index_web", web_src) == { Some(web_stdout) -> assert_eq(web_stdout, "two\nzero\n"), None -> {} }
    _ :: fs.remove_dir_all(&dir)
}
