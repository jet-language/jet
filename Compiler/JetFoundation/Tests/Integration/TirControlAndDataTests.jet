// Rust: tests/tir_control_and_data.rs:955
#Test("loop_values_example_matches_all_execution_tiers") {
    expected :: fs.read_to_string(env.manifest_dir().join("Examples/features/expected/basics/loop_values.out")).unwrap()
    tir_support.assert_example_cli_tiers_agree("basics/loop_values", expected)
    path :: env.manifest_dir().join("Examples/features/basics/loop_values.jet").to_string_lossy()
    if dev_iteration(&path, false, true) == {
        .Ran(exit_code, stdout, stderr) -> {
            assert_eq(exit_code, 0)
            assert_eq(stdout, expected)
            assert_eq(stderr, "")
        }
        .Problems(diagnostics) -> panic("forced interpreter rejected loop_values example: {diagnostics:?}")
    }
}

