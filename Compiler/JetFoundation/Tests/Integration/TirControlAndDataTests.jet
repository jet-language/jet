#Test("braced_value_tails_and_arm_tables_agree_on_all_tiers") {
    src :: """
fn label(value: Int) -> String {
    if value == {
        1 -> { "one" }
        else -> { "other" }
    }
}

fn early(flag: Bool) -> String {
