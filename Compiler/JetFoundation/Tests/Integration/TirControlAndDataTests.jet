// Rust: tests/tir_control_and_data.rs:1545
#Test("union_codec_emission_respects_derive_direction") {
    if !have_rustc() { return }
    src :: """
use core.encoding.json as json

struct WriteOnly {
    marker: Int
}

impl WriteOnly.Encode {
    fn encode(self) -> DataTree {
        return DataTree.Text("write")
    }
}

#Encode
struct Output {
    value: Int | WriteOnly
}

#Decode
struct ReadOnly {
    marker: Int
}

#Decode
struct Input {
    value: Int | ReadOnly
}

fn run() -> {
    output :: Output{ value: WriteOnly{ marker: 1 } }
    print(json.to_string(output))
    _ :: json.decode<Input>("{{\"value\":7}}") ?? panic("input")
    print("ok")
}
"""
    (code, stdout) :: build_and_run("union_codec_direction", src)
    assert_eq(code, 0)
    assert_eq(stdout, "{\"value\":\"write\"}\nok\n")
}
// Rust: tests/tir_control_and_data.rs:1590
#Test("optional_union_null_and_enum_payload_round_trip") {
    if !have_rustc() { return }
    src :: """
use core.encoding.json as json

#Codable
struct MaybeRow {
    value: Int? | String
}

#Codable
enum Envelope {
    Value(Int | String)
}

fn run() -> {
    decoded :: json.decode<MaybeRow>("{{\"value\":null}}") ?? panic("row")
    print(json.to_string(decoded))

    envelope :: Envelope.Value(7)
    envelope_wire :: json.to_string(envelope)
    print(envelope_wire)
    back :: json.decode<Envelope>(envelope_wire) ?? panic("envelope")
    print(json.to_string(back))
}
"""
    (code, stdout) :: build_and_run("union_codable_roundtrip", src)
    assert_eq(code, 0)
    assert_eq(stdout, "{\"value\":null}\n{\"Value\":7}\n{\"Value\":7}\n")
}
// Rust: tests/tir_control_and_data.rs:1624
#Test("codable_union_distinct_member_uses_base_wire_shape") {
    if !have_rustc() { return }
    src :: """
use core.encoding.json as json

#CodableAsBase
Usd :: distinct Int

#Codable
struct Row {
    value: Usd | String
}

fn run() -> {
    row :: Row{ value: Usd.from_int(7) }
    wire :: json.to_string(row)
    print(wire)
    decoded :: json.decode<Row>(wire) ?? panic("row")
    decoded_value :: decoded.value
    if decoded_value == {
        .Usd(value) -> print(value.raw())
        .String(value) -> print(value)
    }
}
"""
    (code, stdout) :: build_and_run("union_codable_distinct", src)
    assert_eq(code, 0)
    assert_eq(stdout, "{\"value\":7}\n7\n")
}

// Rust: tests/tir_control_and_data.rs:1661
#Test("infinite_and_while_loops") {
    if !have_rustc() { return }
    src :: """fn run() -> {
    x := 0
    loop {
        x = (x + 1)
        if (x == 3) {
            break
        }
    }
    print(x)
    fuel := 3
    loop fuel > 0 {
        print("t-minus {fuel}")
        fuel-= 1
    }
    print("liftoff")
}
"""
    (code, stdout) :: build_and_run("tir_loops", src)
    assert_eq(code, 0)
    assert_eq(stdout, "3\nt-minus 3\nt-minus 2\nt-minus 1\nliftoff\n")
}
