// Rust: tests/tir_control_and_data.rs:1767
#Test("range_values_store_pass_return_loop_and_slice") {
    if !have_rustc() { return }
    src :: """fn identity(band: ^Range) -> Range {
    return band
}
fn run() -> {
    bands :: [1..3, 8..<10]
    print(bands[0])
    print("{bands[1]:Debug}")
    print(bands[0] == (1..3))
    print(bands[0] == (1..<3))
    print(bands[0].contains(3))
    band :: identity(4..<7)
    print(band.start)
    print(band.end)
    print(band.contains(6))
    print(band.contains(7))
    print((7..4).contains(5))
    total := 0
    loop n in band {
        total = (total + n)
    }
    print(total)
    xs :: [10, 20, 30, 40, 50, 60, 70, 80]
    print(~xs[band])
}
"""
    (code, stdout) :: build_and_run("tir_range_values", src)
    assert_eq(code, 0)
    assert_eq(stdout, "Range { start: 1, end: 3, exclusive: false }\nRange { start: 8, end: 10, exclusive: true }\ntrue\nfalse\ntrue\n4\n7\ntrue\nfalse\nfalse\n15\n[50, 60, 70]\n")
}
