#Test("tir_function_and_method_coexist") {
    if !have_rustc() { return }
    src :: """struct Counter {
    n: Int
}
impl Counter {
    fn bumped(self) -> Int {
        return (self.n + 1)
    }
}
fn add(a: Int, b: Int) -> Int {
    return (a + b)
}
fn run() -> {
    c :: Counter{ n: 41 }
    print(add(c.bumped(), 0))
}
"""
    (code, stdout) :: build_and_run("tir_coexist", src)
    assert_eq(code, 0)
    assert_eq(stdout, "42\n")
}
