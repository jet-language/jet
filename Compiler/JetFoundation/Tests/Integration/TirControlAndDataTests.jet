// Rust: tests/tir_control_and_data.rs:20
#Test("result_handler_reuses_result_split_on_all_tiers") {
    src :: """
fn classify(ok: Bool) -> Int {
    if ok { return 7 }
    return Err("bad")
}

fn run() -[IO]> {
    #FX(authority: IO) {
        authority.with("IO")
        classify(true) ? ok -> {
            print("ok")
            print(ok)
            0
        } ! _error -> {
            print("error")
            0
        }
        classify(false) ? ok -> {
            print("ok")
            print(ok)
            0
        } ! _error -> {
            print("error")
            0
        }
    }
}
"""
    tir_support.assert_tiers_agree_with_application_policy("result_handler_tiers", src, "ok\n7\nerror\n", RESULT_HANDLER_PACKAGE)
}

// Rust: tests/tir_control_and_data.rs:58
#Test("result_handler_evaluates_effectful_receiver_once_on_all_tiers") {
    src :: """
fn classify(ok: Bool) -[IO]> Int {
    print("source")
    if ok { return 7 }
    return Err("bad")
}

fn run() -[IO]> {
    #FX(authority: IO) {
        authority.with("IO")
        classify(false) ? _ok -> print("ok") ! _error -> print("error")
    }
}
"""
    tir_support.assert_tiers_agree_with_application_policy("result_handler_effectful_receiver", src, "source\nerror\n", RESULT_HANDLER_PACKAGE)
}

// Rust: tests/tir_control_and_data.rs:84
#Test("result_handler_preserves_diverging_arm_on_all_tiers") {
    src :: """
fn choose(ok: Bool) -> Int {
    if ok { return 7 }
    return Err("bad")
}

fn run() -> {
    #FX(authority: IO) {
        authority.with("IO")
        result :: choose(true) ? ok -> ok + 1 ! _error -> return
        print(result)
    }
}
"""
    tir_support.assert_tiers_agree_with_application_policy("result_handler_diverging", src, "8\n", RESULT_HANDLER_PACKAGE)
}

// Rust: tests/tir_control_and_data.rs:112
#Test("result_handler_preserves_ownership_generic_and_nested_values_on_all_tiers") {
    src :: """
fn choose<T>(value: ^T, ok: Bool) -> T {
    if ok { return value }
    return Err("bad")
}

fn choose_text(value: ^String, ok: Bool) -> String {
    if ok { return value }
    return Err("bad")
}

fn owned(ok: Bool) -> String {
    return choose_text("owned", ok) ? success -> success ! _failure -> "bad"
}

fn generic<T>(value: ^T, ok: Bool) -> T {
    return choose<T>(^value, ok) ? success -> success ! _failure -> return Err("bad")
}

fn nested(value: Int, ok: Bool) -> Int {
    return choose<Int>(^value, ok) ? success -> {
        choose<Int>(^success, ok) ? nested_success -> nested_success + 1 ! _nested_failure -> 0
    } ! _failure -> 0
}

fn run() -> {
    #FX(authority: IO) {
        authority.with("IO")
        print(owned(true))
        print(owned(false))
        print(generic(4, true) ? generic_value -> generic_value ! _generic_failure -> 0)
        print(nested(4, true))
        print(nested(4, false))
    }
}
"""
    tir_support.assert_tiers_agree_with_application_policy("result_handler_ownership_generic_nested", src, "owned\nbad\n4\n5\n0\n", RESULT_HANDLER_PACKAGE)
}

