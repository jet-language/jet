    }
}

// Rust: tests/tir_control_and_data.rs:603
#Test("typed_error_union_widening_runs_on_jit_and_interpreter") {
    src :: """
#Error
enum NarrowError { Narrow }
#Error
enum OtherError { Other }

fn narrow() -> Int NarrowError! { Err(NarrowError.Narrow) }

fn widen() -> Int (NarrowError | OtherError)! { narrow() }

fn run() -> {
    print(widen() ?? 7)
}
"""
    (jit_code, jit_stdout, jit_stderr) :: tir_support.jit_run("tir_error_union_widen_jit", src)
    assert_eq(jit_code, 0, "{jit_stderr}")
    assert_eq(jit_stdout, "7\n")
    tir_support.assert_tiers_agree("tir_error_union_widen_native", src, "7\n")
    (interp_code, interp_stdout, interp_stderr) :: tir_support.interpreter_run("tir_error_union_widen_interp", src)
    assert_eq(interp_code, 0, "{interp_stderr}")
    assert_eq(interp_stdout, jit_stdout)
}

// Rust: tests/tir_control_and_data.rs:639
#Test("implicit_failure_propagation_covers_call_positions") {
    src :: """
struct Holder {
    value: Int

    fn bump(self, by: Int) -> Int {
        return add(self.value + by)
    }
}

fn source(value: Int) -> Int {
    if value == 0 {
        return Err("source failed")
    }
    return value
}

fn add(value: Int) -> Int { value + 1 }

fn is_zero(value: Int) -> Bool { value == 0 }

fn argument(value: Int) -> Int {
    return add(source(value))
}

fn nested(value: Int) -> Int {
    return source(value) + 1
}

fn branch(value: Int) -> Int {
    if is_zero(value) {
        source(value)
    }
    return value
}

fn branch_value(value: Int) -> Int {
    return if is_zero(value) -> { source(value) } else -> { value + 1 }
}

fn closure(value: Int) -> Int {
    worker :: (n: Int) Int -> source(n) + 1
    return worker(value)
}

fn method(value: Int) -> Int {
    holder :: Holder{ value: source(value) }
    return add(holder.bump(1))
}

fn run() -> {
    print(argument(2) ?? 0)
    print(nested(2) ?? 0)
    print(branch(0) ?? 99)
    print(closure(2) ?? 0)
    print(method(2) ?? 0)
    print(branch_value(0) ?? 99)
}
"""
    tir_support.assert_tiers_agree("implicit_failure_propagation_positions", src, "3\n3\n99\n3\n5\n99\n")
}

// Rust: tests/tir_control_and_data.rs:709
#Test("implicit_failure_propagation_in_map_and_filter_callbacks") {
    src :: """
fn source(value: Int) -> Int {
    if value == 0 {
        return Err("source failed")
    }
    return value
}

fn source_flag(value: Int) -> Bool {
    if value == 0 {
        return Err("source failed")
    }
    return value > 1
}

fn add_one(value: Int) -> Int { value + 1 }
fn retain_flag(value: Bool) -> Bool { value }

fn run() -> {
    values :: [1, 2]
    mapped :: values.map((value: Int) -> add_one(source(value))) ?? []
    filtered :: values.filter((value: Int) -> retain_flag(source_flag(value))) ?? []
    mapped_block :: values.map((value: Int) -> {
        add_one(source(value))
    }) ?? []
    filtered_block :: values.filter((value: Int) -> {
        retain_flag(source_flag(value))
    }) ?? []
    mapped_failed :: [0, 1].map((value: Int) -> {
        add_one(source(value))
    }) ?? []
    filtered_failed :: [0, 1].filter((value: Int) -> {
        retain_flag(source_flag(value))
    }) ?? []
    print(mapped[0])
    print(mapped[1])
    print(filtered.len())
    print(mapped_block[0])
    print(mapped_block[1])
    print(filtered_block.len())
    print(mapped_failed.len())
    print(filtered_failed.len())
}
"""
    tir_support.assert_tiers_agree("implicit_failure_propagation_collection_callbacks", src, "2\n3\n1\n2\n3\n1\n0\n0\n")
}

// Rust: tests/tir_control_and_data.rs:764
#Test("jit_or_fallback_panic_keeps_rich_context") {
    src :: """use core.process as process
fn run() -> {
    count :: process.argv().len()
    missing :: process.argv().get(count + 1)
    print(missing ?? panic("missing argument"))
}
"""
    (code, stdout, stderr) :: tir_support.jit_run("jit_fallback_panic", src)
    assert_eq(code, 70, "rich panic exit: out={stdout} err={stderr}")
    assert(stdout.is_empty(), "{stdout}")
    assert(stderr.contains("Stop [E3001]: `panic: missing argument`") && stderr.contains("jit_fallback_panic.jet:5 in run") && stderr.contains("print(missing ?? panic(\"missing argument\"))") && stderr.contains("count = "), "panic fallback lost rich context: {stderr}")
}

// Rust: tests/tir_control_and_data.rs:793
#Test("index_hook_miss_uses_the_structured_runtime_stop") {
    src :: """struct Tile {
    value: Int
}
struct Grid {
    cells: [Tile]
}
impl Grid.Index {
    type Key = Int
    type Value = Int
    fn get(self, key: Int) -> Int? {
        if key < 0 || key >= self.cells.len() -> return None
        return Val(self.cells[key].value)
    }
}
fn run() -> {
    grid :: Grid{cells: [Tile{value: 1}]}
    print(grid[9])
}
"""
    loop (tier, (code, stdout, stderr)) in [
        ("default", tir_support.jit_run("index_hook_miss_jit", src)),
        ("interpreter", tir_support.interpreter_run("index_hook_miss_interp", src))
    ] {
        assert_eq(code, 70, "{tier}: out={stdout} err={stderr}")
        assert(stdout.is_empty(), "{tier}: {stdout}")
        assert(stderr.contains("Stop [E3001]: `panic: index miss`") && stderr.contains("print(grid[9])") && stderr.contains("in run"), "{tier}: {stderr}")
        assert(!stderr.contains("unsupported"), "{tier}: {stderr}")
    }
}

