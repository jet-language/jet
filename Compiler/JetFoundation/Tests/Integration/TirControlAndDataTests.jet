#Test("arithmetic_and_helper_call") {
    if !have_rustc() { return }
    src :: """fn double(n: Int) -> Int {
    return (n * 2)
}
fn run() -> {
    sum :: (7 + (3 * 4))
    print("sum {sum}")
    print(double(sum))
}
"""
    (code, stdout) :: build_and_run("tir_arith", src)
    assert_eq(code, 0, "should exit cleanly")
    assert_eq(stdout, "sum 19\n38\n")
}
// Rust: tests/tir_control_and_data.rs:1155
#Test("range_value_windows_are_no_copy_and_write_through") {
    if !have_rustc() { return }
    src :: """
fn run() -> {
    values := [10, 20, 30, 40, 50]
    band :: 1..<4
    window :: values[band]
    print(~window)
    edit :: &values[band]
    edit[1] = 99
    print(values)
}
"""
    rust :: compile("tir_range_value_windows", src)
    assert(rust.contains("let __jet_window = jet_view_range_new"), "bare Range projection must borrow without copying: {rust}")
    assert(rust.contains("let __jet_edit = jet_view_mut_range_new"), "write Range projection must borrow the owner: {rust}")
    (code, stdout) :: build_and_run("tir_range_value_windows", src)
    assert_eq(code, 0)
    assert_eq(stdout, "[20, 30, 40]\n[10, 20, 99, 40, 50]\n")
}
