// Rust: tests/tir_control_and_data.rs:1208
#Test("if_else_chain_and_return") {
    if !have_rustc() { return }
    src :: """fn label(n: Int) -> String {
    if ((n % 15) == 0) {
        return "FizzBuzz"
    } else if ((n % 3) == 0) {
        return "Fizz"
    } else if ((n % 5) == 0) {
        return "Buzz"
    }
    return "{n}"
}
fn run() -> {
    print(label(3))
    print(label(5))
    print(label(15))
    print(label(7))
}
"""
    (code, stdout) :: build_and_run("tir_ifchain", src)
    assert_eq(code, 0)
    assert_eq(stdout, "Fizz\nBuzz\nFizzBuzz\n7\n")
}

// Rust: tests/tir_control_and_data.rs:1236
#Test("discarded_if_does_not_unify_mixed_tail_values") {
    src :: """
fn branch(flag: Bool) -[IO]> {
    if {
        flag -> {
            print("returned")
            7
        }
        else -> { print("value") }
    }
}

fn run() -[IO]> {
    #FX(authority: IO) {
        authority.with("IO")
        branch(true)
        branch(false)
    }
}
"""
    tir_support.assert_tiers_agree_with_application_policy("discarded_if_mixed_tails", src, "returned\nvalue\n", RESULT_HANDLER_PACKAGE)
}
