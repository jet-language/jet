    assert(!diagnostics.iter().any(fn(diagnostic) { diagnostic.severity == jet.Diagnostics.Severity.Error }), "example {entry.stem} failed the front end:\n{jet.render_diagnostics(&entry.shown, src, &diagnostics)}")
}
// Rust: tests/golden.rs:213
fn example_serves_until_stopped(path: &OSPath) -> Bool {
    path :: match path.to_str() { Some(value) -> value, None -> return false }
    bundle := match jet.Loader.load_entry(path) { Ok(value) -> value, Err(_) -> return false }
    _ :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run)
    jet.AST.bundle_serves_until_stopped(&bundle)
}
// Rust: tests/golden.rs:261
fn feature_stem(path: &OSPath, ex_dir: &OSPath) -> String {
    path.strip_prefix(ex_dir).expect("feature path must be below Examples/features").to_string_lossy().replace('\\', "/")
}
// Rust: tests/golden.rs:268
fn push_feature_source(entries: &[GoldenEntry], path: OSPath, ex_dir: &OSPath, ext: &String) -> {
    stem :: feature_stem(&path, ex_dir).strip_suffix(".{ext}").unwrap_or_else(fn() { panic("feature source has unexpected extension: {path.display()}") }).to_owned()
    entries.push(GoldenEntry { shown: "Examples/features/{stem}.{ext}", path: ^path, stem: ^stem })
}
// Rust: tests/golden.rs:280
fn push_feature_project(entries: &[GoldenEntry], run: OSPath, ex_dir: &OSPath, ext: &String) -> {
    stem :: feature_stem(run.parent().expect("run entry must have a project directory"), ex_dir)
    entries.push(GoldenEntry { shown: "Examples/features/{stem}/run.{ext}", path: ^run, stem: ^stem })
}
// Rust: tests/golden.rs:292
fn collect_feature_project_entries(dir: &OSPath, ex_dir: &OSPath, ext: &String, entries: &[GoldenEntry]) -> {
    name :: match dir.file_name().and_then(fn(name) { name.to_str() }) { Some(value) -> value, None -> return }
    if name.starts_with('.') || name == "expected" { return }
    run :: dir.join("run.{ext}")
    if run.is_file() { push_feature_project(entries, ^run, ex_dir, ext); return }
    // Package/workspace roots own their descendants; these are not independent executables.
    if dir.join("package.jet").is_file() || dir.join("workspace.jet").is_file() { return }
    children :: match fs.read_dir(dir) { Ok(value) -> value, Err(_) -> return }
    for child in children.flatten() {
        path :: child.path()
        if path.is_dir() { collect_feature_project_entries(&path, ex_dir, ext, entries) }
    }
}
// Rust: tests/golden.rs:328
fn collect_feature_golden_entries(ex_dir: &OSPath, ext: &String) -> [GoldenEntry] {
    entries := []
    topics :: match fs.read_dir(ex_dir) { Ok(value) -> value, Err(_) -> return entries }
    for topic in topics.flatten() {
        topic_path :: topic.path()
        topic_name :: match topic_path.file_name().and_then(fn(name) { name.to_str() }) { Some(value) -> value, None -> continue }
        if !topic_path.is_dir() || topic_name.starts_with('.') || topic_name == "expected" { continue }
        children :: match fs.read_dir(&topic_path) { Ok(value) -> value, Err(_) -> continue }
        for child in children.flatten() {
            path :: child.path()
            if path.is_file() && path.extension().and_then(fn(extension) { extension.to_str() }) == Some(ext) && path.file_name().and_then(fn(name) { name.to_str() }) != Some("package.jet") && path.file_name().and_then(fn(name) { name.to_str() }) != Some("workspace.jet") && !path.file_name().and_then(fn(name) { name.to_str() }).is_some_and(fn(name) { name.starts_with('.') }) {
                push_feature_source(&entries, ^path, ex_dir, ext)
            } else if path.is_dir() { collect_feature_project_entries(&path, ex_dir, ext, &entries) }
        }
    }
    entries.sort_by(fn(a, b) { a.stem.cmp(&b.stem) })
    entries
}
// Rust: tests/golden.rs:537
// Derived from the one approved unsafe-region registry, not a second hand-maintained stem list.
GATED_UNSAFE_STEMS :: LazyLock.new(fn() {
    baseline_path :: OSPath.from(env.manifest_dir()).join("Docs/spec/safety.md")
    baseline :: fs.read_to_string(&baseline_path).unwrap_or_else(fn(err) { panic("cannot read the approved unsafe-region baseline {baseline_path.display()}: {err}") })
    data :: baseline.split_once("<!-- unsafe-ratchet:data").and_then(fn(pair) { pair.1.split_once("\n-->") }).map(fn(pair) { pair.0 }).unwrap_or_else(fn() { panic("{baseline_path.display()} has no `unsafe-ratchet:data` baseline block") })
    example_prefix :: "Examples/features/"
    jet_suffix :: ".{jet.Syntax.FILE_EXT}"
    stems :: data.lines().filter_map(fn(line) {
        trimmed := line.trim() // #4303
        quoted := trimmed.strip_prefix("\"file\":")?.trim_start() // #4303
        file :: quoted.strip_prefix('"')?.split('"').next()?
        stem :: file.strip_prefix(example_prefix)?.strip_suffix(&jet_suffix)?
        Some(stem.to_owned())
    }).collect<HashSet<String>>()
    assert(!stems.is_empty(), "{baseline_path.display()} records no approved `Examples/features` unsafe region; the audited-tier examples (lowlevel/memory/effects/crypto) must appear there")
    stems
})
// Rust: tests/golden.rs:578
fn check_golden_entry(entry: &GoldenEntry, env: &GoldenEnv) -> {
    if entry.stem == "devloop/job_runner" { check_job_runner_jobs(entry, env); return }
    if entry.stem.starts_with("lowlevel/polyglot_") { check_polyglot_binder_example(entry, env); return }
    src :: fs.read_to_string(&entry.path).unwrap()
    staged_fixture :: FeatureFixtureScratch.for_entry(&entry.path)
    compile_path :: staged_fixture.as_ref().map(fn(scratch) { scratch.entry.to_string_lossy().into_owned() }).unwrap_or_else(fn() { entry.shown.clone() })
    stem :: entry.stem.as_str()
    needs_gtk :: stem == "ui/ui_native_linux"
    if needs_gtk && !env.have_gtk {
        assert_front_end(entry, &src)
        eprintln("note: front end checked; skipping Examples/features/{stem}.jet build (need gtk4)")
        return
    }
    uses_ffi_bridge :: ["lowlevel/ffi", "io/archive", "io/db", "crypto/crypto_envelope", "crypto/crypto_sign", "crypto/crypto_migration", "crypto/crypto_suite", "crypto/vault_secret", "crypto/auth_tokens", "io/compress_gzip", "io/compress_zstd"].contains(stem)
    if uses_ffi_bridge && !env.have_cargo {
        assert_front_end(entry, &src)
        eprintln("note: front end checked; skipping Examples/features/{stem}.jet golden (need cargo for FFI bridge)")
        return
    }
    compiled_result :: if has_package_build_entry(&OSPath.from(&compile_path), &src) { jet.compile_programmable_build(&compile_path, &[]) } else { jet.compile_with_path(&src, &compile_path) }
    compiled :: match compiled_result {
        Ok(c) -> c,
        Err(diags) -> panic("example {stem} failed the front end:\n{jet.render_diagnostics(&"Examples/features/{stem}.{env.ext}", &src, &diags)}"),
    }
    assert(!compiled.lints.iter().any(fn(diagnostic) { diagnostic.code == "L0507" }), "feature example {stem} still teaches the discouraged braced/chained branch form:\n{jet.render_diagnostics(&entry.shown, &src, &compiled.lints)}")
    rust_code :: ^compiled.rust
    ffi_link :: ^compiled.ffi
    user_code :: strip_vetted_prelude_modules(&rust_code)
    if GATED_UNSAFE_STEMS.contains(stem) {
        assert(user_code.lines().any(fn(line) { !unsafe_keyword_columns(line).is_empty() }), "the audited example {stem} should exercise the gated `unsafe` tier")
        for (i, line) in user_code.lines().enumerate() {
            for col in unsafe_keyword_columns(line) {
                after := line[col + "unsafe".len()..].trim_start() // #4303
                assert(after.starts_with('{') || after.starts_with("fn "), "{stem} emits an ungated `unsafe` at line {i + 1}: {line.trim()}")
            }
        }
    } else if stem == "game/raylib_window" {
        assert(!user_code.contains("unsafe fn __jet_"), "raylib user functions must stay safe; bridge unsafe stays in vetted prelude")
    } else {
        leftover :: user_code.lines().enumerate().filter(fn(pair) { !unsafe_keyword_columns(pair.1).is_empty() }).map(fn(pair) { "  line {pair.0 + 1}: {pair.1.trim()}" }).collect<[String]>()
        assert(leftover.is_empty(), "generated Rust for {stem} contains `unsafe` outside vetted memory helpers:\n{leftover.join("\n")}")
    }
    assert(rust_code.contains("fn main()"), "generated Rust for {stem} has no fn main")
    if needs_gtk && !env.have_rustc {
        eprintln("note: front end checked; skipping Examples/features/{stem}.jet build (need gtk4 + rustc)")
        return
    }
    needs_raylib_display :: stem == "game/raylib_window"
    if needs_raylib_display && std.env.var("JET_RAYLIB_DISPLAY").as_deref() != Ok("1") {
        eprintln("note: front end checked; skipping Examples/features/{stem}.jet build (set JET_RAYLIB_DISPLAY=1)")
        return
    }
    if !env.have_rustc { return }
    flat_stem :: stem.replace('/', "_")
    dir :: std.env.temp_dir()
    rs :: dir.join("jet_golden_{process.id()}_{flat_stem}.rs")
    bin :: dir.join("jet_golden_{process.id()}_{flat_stem}")
    rustc_cmd := Command.new("rustc")
    _runtime_lease :: add_generated_rust(&rustc_cmd, &rs, &rust_code, ffi_link.is_some(), &[])
    rustc_cmd.arg("-o").arg(&bin)
    if Some(link) = ffi_link.as_ref() {
        rustc_cmd.arg("--extern").arg("{link.crate_name}={link.rlib_path.display()}")
        for deps_dir in link.dependency_dirs().filter(fn(dir) { dir.is_dir() }) { rustc_cmd.arg("-L").arg("dependency={deps_dir.display()}") }
    }
    clinks :: jet.resolve_c_links(entry.path.to_str().unwrap()).expect("resolve_c_links should succeed for example C bindings")
    for arg in &clinks { rustc_cmd.arg(arg) }
    out :: rustc_cmd.output().unwrap()
    assert(out.status.success(), "I2 violated: rustc rejected generated code for {stem} — this is a jet bug:\n{String.from_utf8_lossy(&out.stderr)}")
    // Services prove front end, I1 and I2, but have no terminating stdout or exit code.
    if example_serves_until_stopped(&entry.path) {
        eprintln("note: built Examples/features/{stem}.jet; not run (service entry serves until stopped)")
        return
    }
    run_cmd := Command.new(&bin)
    if needs_gtk { run_cmd.env("JET_UI_HEADLESS", "1") }
    run :: if Some(answers) = example_stdin(stem) {
        child := run_cmd.stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().unwrap()
        child.stdin.take().unwrap().write_all(answers.piped.as_bytes()).unwrap()
        child.wait_with_output().unwrap()
    } else { run_cmd.output().unwrap() }
    if needs_gtk && !run.status.success() && gtk_loader_unavailable(&run.stderr) {
        eprintln("note: skipping Examples/features/{stem}.jet run (gtk4 runtime loader unavailable)")
        return
    }
    err_path :: env.ex_dir.join("expected").join("{stem}.err.out")
    success_err_path :: env.ex_dir.join("expected").join("{stem}.stderr.out")
    if err_path.exists() {
        code :: run.status.code()
        assert(code == Some(70) || code == Some(1), "exit code mismatch for example {stem}: expected 70 (panic) or 1 (uncaught Err), got {code:?}")
        actual_err :: String.from_utf8_lossy(&run.stderr)
        if env.update_expected { fs.write(&err_path, actual_err.as_bytes()).unwrap() } else {
            expected_err :: fs.read_to_string(&err_path).unwrap_or_else(fn(_) { panic("missing Examples/features/expected/{stem}.err.out") })
            if actual_err != expected_err { panic("stderr mismatch for example {stem}:\n{unified_diff(&"Examples/features/expected/{stem}.err.out", &"Examples/features/{stem} stderr (actual)", &expected_err, &actual_err)}") }
        }
        record_golden_receipt(entry, env, &run, &run.stdout)
    } else {
        assert(run.status.success(), "example {stem} failed at runtime:\nstdout: {String.from_utf8_lossy(&run.stdout)}\nstderr: {String.from_utf8_lossy(&run.stderr)}")
        out_path :: env.ex_dir.join("expected").join("{stem}.out")
        actual_raw :: String.from_utf8_lossy(&run.stdout)
        actual_normalized := None
        actual :: if stem.starts_with("cli/") {
            source_name :: entry.path.file_stem().and_then(fn(name) { name.to_str() }).expect("golden source name is utf8")
            binary_name :: bin.file_name().and_then(fn(name) { name.to_str() }).expect("golden binary name is utf8")
            actual_normalized = Some(actual_raw.replacen(&"Usage: {binary_name}", &"Usage: {source_name}", 1))
            actual_normalized.as_ref().unwrap().as_str()
        } else { actual_raw.as_ref() }
        if env.update_expected {
            fs.create_dir_all(out_path.parent().unwrap()).unwrap()
            fs.write(&out_path, actual.as_bytes()).unwrap()
        } else {
            assert(out_path.is_file(), "missing Examples/features/expected/{stem}.out; run with JET_UPDATE_GOLDEN=1 and a scoped JET_GOLDEN_FILTER to create it")
            expected :: fs.read_to_string(&out_path).unwrap()
            if stem == "tooling/compute_vulkan_webgpu" { assert_compute_vulkan_webgpu_output(actual) } else if actual != expected {
                panic("output mismatch for example {stem}:\n{unified_diff(&"Examples/features/expected/{stem}.out", &"Examples/features/{stem} stdout (actual)", &expected, &actual)}")
            }
        }
        if success_err_path.exists() {
            actual_err :: String.from_utf8_lossy(&run.stderr)
            if env.update_expected { fs.write(&success_err_path, actual_err.as_bytes()).unwrap() } else {
                expected_err :: fs.read_to_string(&success_err_path).unwrap_or_else(fn(_) { panic("missing Examples/features/expected/{stem}.stderr.out") })
                if actual_err != expected_err { panic("stderr mismatch for example {stem}:\n{unified_diff(&"Examples/features/expected/{stem}.stderr.out", &"Examples/features/{stem} stderr (actual)", &expected_err, &actual_err)}") }
            }
        }
        record_golden_receipt(entry, env, &run, actual.as_bytes())
    }
}
// Rust: tests/golden.rs:936
fn record_golden_receipt(entry: &GoldenEntry, env: &GoldenEnv, output: &Output, stdout: &[U8]) -> {
    err_path :: env.ex_dir.join("expected").join("{entry.stem}.err.out")
    stdout_path :: env.ex_dir.join("expected").join("{entry.stem}.out")
    stderr_path :: env.ex_dir.join("expected").join("{entry.stem}.stderr.out")
    expected :: if err_path.is_file() { ^err_path } else if stdout_path.is_file() { ^stdout_path } else { return }
    expected_paths := [^expected]
    if stderr_path.is_file() { expected_paths.push(^stderr_path) }
    record_golden_receipt_at_output(entry, env, output, stdout, &output.stderr, "aot", None, &expected_paths, &[])
}
// Rust: tests/golden.rs:978
fn record_golden_receipt_at(entry: &GoldenEntry, env: &GoldenEnv, output: &Output, tier: &String, variant: String?, expected_paths: &[OSPath], extra_inputs: &[OSPath]) -> {
    record_golden_receipt_at_output(entry, env, output, &output.stdout, &output.stderr, tier, variant, expected_paths, extra_inputs)
}
// Rust: tests/golden.rs:1000
fn record_golden_receipt_at_output(entry: &GoldenEntry, env: &GoldenEnv, output: &Output, stdout: &[U8], stderr: &[U8], tier: &String, variant: String?, expected_paths: &[OSPath], extra_inputs: &[OSPath]) -> {
    if expected_paths.iter().any(fn(path) { !path.is_file() }) { return }
    inputs := [entry.path.clone()]
    inputs.extend(extra_inputs.iter().cloned().filter(fn(path) { path.is_file() }))
    inputs.extend(expected_paths.iter().cloned())
    root :: env.ex_dir.parent().and_then(fn(path) { path.parent() }).unwrap_or_else(fn() { OSPath.from(".") })
    store_root :: std.env.var_os("JET_RECEIPT_DIR").map(OSPath.from).unwrap_or_else(fn() { root.join(".jet").join("receipts") })
    store :: jet.ReceiptStore.ReceiptStore.new(store_root)
    argv := ["golden", entry.path.to_string_lossy().into_owned(), tier.to_string()]
    if Some(value) = variant { argv.push(value.to_string()) }
    status :: output.status.code().unwrap_or(1)
    store.record("golden", &argv, &inputs, status, stdout, stderr).unwrap_or_else(fn(error) { panic("could not record golden receipt for {entry.stem}: {error}") })
}
// Rust: tests/golden.rs:1044
fn has_package_build_entry(path: &OSPath, source: &String) -> Bool {
    if source.contains("fn build(") { return true }
    root :: match path.parent() { Some(value) -> value, None -> return false }
    resolver :: match jet.Authority.AuthorityResolver.open(root) { Ok(value) -> value, Err(_) -> return false }
    facts :: match resolver.checked_manifest(&OSPath.from(".")) {
        Ok(manifest) -> manifest.facts,
        Err(error) -> if error.is_missing() { jet.Package.PackageFacts.default() } else { return false },
    }
    facts.resolve_build_entry_checked(&resolver).ok().flatten().is_some()
}
// Rust: tests/golden.rs:1069
fn check_polyglot_binder_example(entry: &GoldenEntry, env: &GoldenEnv) -> {
    (language, package, foreign_source) :: match entry.stem.as_str() {
        "lowlevel/polyglot_go" -> ("go", "handles", "handles.go"),
        "lowlevel/polyglot_java" -> ("java", "counter", "Counter.java"),
        "lowlevel/polyglot_dotnet" -> ("cs", "counter", "Counter.cs"),
        "lowlevel/polyglot_pascal" -> ("pascal", "counter", "Counter.pas"),
        "lowlevel/polyglot_ada" -> ("ada", "geodesy", "geodesy.ads"),
        "lowlevel/polyglot_fortran" -> ("fortran", "matrix", "matrix.f90"),
        "lowlevel/polyglot_tcl" -> ("tcl", "eda", "eda.tcl"),
        "lowlevel/polyglot_dart" -> ("dart", "callbacks", "callbacks.dart"),
        other -> panic("unknown polyglot golden `{other}`"),
    }
    src :: fs.read_to_string(&entry.path).unwrap()
    if language != "dart" { assert_front_end(entry, &src) }
    if !env.have_rustc || !env.have_cargo {
        eprintln("note: front end checked; skipping Examples/features/{entry.stem} golden (need provisioned compiler toolchain)")
        return
    }
    tool :: match language {
        "go" -> "go", "fortran" -> "gfortran", "java" -> "javac", "cs" -> "dotnet",
        "pascal" -> "fpc", "ada" -> "gnatmake", "tcl" -> "tclsh", "dart" -> "dart",
        _ -> unreachable("binder language has no provisioned tool"),
    }
    have_tool :: Command.new(tool).arg("--version").output().map(fn(output) { output.status.success() }).unwrap_or(false)
    if !have_tool {
        eprintln("note: front end checked; skipping Examples/features/{entry.stem} golden (need provisioned {tool})")
        return
    }
    flat_stem :: entry.stem.replace('/', "_")
    dir :: std.env.temp_dir().join("jet_golden_{process.id()}_{flat_stem}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    source_dir :: entry.path.parent().expect("polyglot example directory")
    fs.copy(&entry.path, dir.join("run.jet")).unwrap()
    fs.copy(source_dir.join(foreign_source), dir.join(foreign_source)).unwrap()
    if language == "ada" { fs.copy(source_dir.join("geodesy.adb"), dir.join("geodesy.adb")).unwrap() }
    if language == "dart" { fs.copy(source_dir.join("host.dart"), dir.join("host.dart")).unwrap() }
    bind := Command.new(std.env.var("JET_BIN").expect("Jet executable"))
    bind.current_dir(&dir).env("NO_COLOR", "1")
    bind.args(["inspect", "bind", language, foreign_source])
    if language == "dart" { bind.args(["--jet", "run.jet"]) }
    bind :: bind.args(["--pkg", package]).output().unwrap()
    assert(bind.status.success(), "{language} binder example failed:\n{String.from_utf8_lossy(&bind.stderr)}")
    if language == "dart" {
        check :: Command.new(std.env.var("JET_BIN").expect("Jet executable")).args(["check", "run.jet"]).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
        assert(check.status.success(), "Dart generated binding failed its front end:\n{String.from_utf8_lossy(&check.stderr)}")
    }
    run :: if language == "dart" { Command.new("dart").args(["run", "host.dart"]).current_dir(&dir).output().unwrap() } else {
        Command.new(std.env.var("JET_BIN").expect("Jet executable")).args(["run", "run.jet"]).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
    }
    assert(run.status.success(), "{language} binder example failed at runtime:\nstdout: {String.from_utf8_lossy(&run.stdout)}\nstderr: {String.from_utf8_lossy(&run.stderr)}")
    out_path :: env.ex_dir.join("expected").join("{entry.stem}.out")
    assert(out_path.is_file(), "missing Examples/features/expected/{entry.stem}.out")
    foreign_inputs := [source_dir.join(foreign_source)]
    if language == "ada" { foreign_inputs.push(source_dir.join("geodesy.adb")) }
    if language == "dart" { foreign_inputs.push(source_dir.join("host.dart")) }
    record_golden_receipt_at(entry, env, &run, "dev", None, &[out_path.clone()], &foreign_inputs)
    actual :: String.from_utf8_lossy(&run.stdout)
    if env.update_expected { fs.write(&out_path, actual.as_bytes()).unwrap() } else {
        expected :: fs.read_to_string(&out_path).unwrap()
        if actual != expected { panic("output mismatch for example {entry.stem}:\n{unified_diff(&"Examples/features/expected/{entry.stem}.out", &"Examples/features/{entry.stem}/run.jet stdout (actual)", &expected, &actual)}") }
    }
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/golden.rs:1232
fn check_job_runner_jobs(entry: &GoldenEntry, env: &GoldenEnv) -> {
    src :: fs.read_to_string(&entry.path).unwrap()
    path :: entry.path.to_str().expect("example path is utf8")
    compiled :: jet.compile_with_path(&src, path).unwrap_or_else(fn(diags) { panic("job_runner subcommand table failed the front end:\n{jet.render_diagnostics(&entry.shown, &src, &diags)}") })
    job_runner_user_code :: strip_vetted_prelude_modules(&compiled.rust)
    assert(job_runner_user_code.lines().all(fn(line) { unsafe_keyword_columns(line).is_empty() }), "generated Rust for job_runner contains ungated `unsafe`")
    assert(compiled.rust.contains("fn main()"), "job_runner has no fn main")
    if !env.have_rustc { return }
    dir :: std.env.temp_dir()
    rs :: dir.join("jet_golden_{process.id()}_devloop_job_runner.rs")
    bin :: dir.join("jet_golden_{process.id()}_devloop_job_runner")
    rustc := Command.new("rustc")
    _runtime_lease :: add_generated_rust(&rustc, &rs, &compiled.rust, compiled.ffi.is_some(), &[])
    rustc.arg("-o").arg(&bin)
    if Some(link) = compiled.ffi.as_ref() {
        rustc.arg("--extern").arg("{link.crate_name}={link.rlib_path.display()}")
        for deps_dir in link.dependency_dirs().filter(fn(dir) { dir.is_dir() }) { rustc.arg("-L").arg("dependency={deps_dir.display()}") }
    }
    out :: rustc.output().unwrap()
    assert(out.status.success(), "I2 violated: rustc rejected job_runner:\n{String.from_utf8_lossy(&out.stderr)}")
    for (job, expected_name) in [("greet", "job_runner.greet"), ("seed_data", "job_runner.seed_data")] {
        run :: Command.new(&bin).arg(job).output().unwrap()
        assert(run.status.success(), "job_runner subcommand `{job}` failed at runtime:\nstdout: {String.from_utf8_lossy(&run.stdout)}\nstderr: {String.from_utf8_lossy(&run.stderr)}")
        out_path :: env.ex_dir.join("expected").join("devloop/{expected_name}.out")
        assert(out_path.is_file(), "missing expected output for `{job}`")
        record_golden_receipt_at(entry, env, &run, "aot", Some(job), &[out_path.clone()], &[])
        actual :: String.from_utf8_lossy(&run.stdout)
        if env.update_expected { fs.write(&out_path, actual.as_bytes()).unwrap() } else {
            expected :: fs.read_to_string(&out_path).unwrap()
            if actual != expected { panic("output mismatch for job_runner subcommand `{job}`:\n{unified_diff(&"Examples/features/expected/devloop/{expected_name}.out", &"Examples/features/devloop/job_runner subcommand `{job}` stdout", &expected, &actual)}") }
        }
    }
    _ :: fs.remove_file(&rs)
    _ :: fs.remove_file(&bin)
}
