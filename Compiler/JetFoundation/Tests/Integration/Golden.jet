// Rust: tests/golden.rs:103
fn contains_fixture_state(root: &OSPath) -> Bool {
    fs.read_dir(root).unwrap_or_else(fn(error) { panic("read example project {root.display()}: {error}") }).flatten().any(fn(item) {
        path :: item.path()
        name :: item.file_name()
        if !item.file_type().is_ok_and(fn(kind) { kind.is_dir() }) { return false }
        if name == "fixture-state" { return true }
        name != ".jet" && contains_fixture_state(&path)
    })
}
// Rust: tests/golden.rs:120
fn copy_feature_project(source: &OSPath, destination: &OSPath) -> {
    for item in fs.read_dir(source).unwrap_or_else(fn(error) { panic("read example project {source.display()}: {error}") }).flatten() {
        name :: item.file_name()
        kind :: item.file_type().expect("read example fixture entry type")
        from :: item.path()
        if kind.is_dir() && name == ".jet" { continue }
        if kind.is_dir() && name == "fixture-state" {
            state :: destination.join(".jet")
            fs.create_dir_all(&state).expect("create staged example .jet state")
            copy_feature_state(&from, &state)
        } else if kind.is_dir() {
            to :: destination.join(&name)
            fs.create_dir_all(&to).expect("create copied example directory")
            copy_feature_project(&from, &to)
        } else if kind.is_file() {
            fs.copy(&from, destination.join(&name)).unwrap_or_else(fn(error) { panic("copy example fixture {from.display()} into {destination.display()}: {error}") })
        }
    }
}
// Rust: tests/golden.rs:151
fn copy_feature_state(source: &OSPath, destination: &OSPath) -> {
    for item in fs.read_dir(source).unwrap_or_else(fn(error) { panic("read fixture state {source.display()}: {error}") }).flatten() {
        from :: item.path()
        to :: destination.join(item.file_name())
        kind :: item.file_type().expect("read fixture state entry type")
        if kind.is_dir() {
            fs.create_dir_all(&to).expect("create staged fixture state directory")
            copy_feature_state(&from, &to)
        } else if kind.is_file() {
            fs.copy(&from, &to).unwrap_or_else(fn(error) { panic("copy fixture state {from.display()} into {destination.display()}: {error}") })
        }
    }
}
// Rust: tests/golden.rs:174
fn gtk_loader_unavailable(stderr: &[U8]) -> Bool {
    stderr :: String.from_utf8_lossy(stderr)
    stderr.contains("symbol lookup error") && stderr.contains("libgtk-4.so") && stderr.contains("undefined symbol")
}
// Rust: tests/golden.rs:181
fn assert_compute_vulkan_webgpu_output(stdout: &String) -> {
    lines :: stdout.lines().collect()
    assert_eq(lines.len(), 2, "unexpected output from tooling/compute_vulkan_webgpu: {stdout:?}")
    assert(lines[0] == "vulkan:accepted" || lines[0] == "vulkan:rejected", "Vulkan must report its real availability: {stdout:?}")
    assert_eq(lines[1], "webgpu:rejected", "native WebGPU must fail closed: {stdout:?}")
}
