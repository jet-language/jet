// Rust: tests/package_outputs.rs:306
// GATE #4494: native fixture filesystem; failures preserve original diagnostics.
pub fn stage_jetpack_phase1(source: &OSPath, destination: &OSPath) -> Unit {
    fs.create_dir_all(destination).expect("create staged Jetpack fixture")
    for name in ["package.jet", "env.jet"] {
        fs.copy(source.join(name), destination.join(name)).unwrap_or_else(fn(error) { panic("copy Jetpack fixture {name}: {error}") })
    }
    lock :: destination.join(".jet/lock")
    fs.create_dir_all(lock.parent().unwrap()).expect("create staged Jetpack lock directory")
    fs.copy(source.join("fixture-state/lock"), &lock).unwrap_or_else(fn(error) { panic("stage Jetpack fixture lock: {error}") })
}

// Rust: tests/package_outputs.rs:540
pub fn typed_settings_dir() -> OSPath { env.manifest_dir().join("Examples/features/packages/typed_settings") }
// Rust: tests/package_outputs.rs:544
pub fn typed_settings_output(tls: String) -> String {
    if tls == "on" { return fs.read_to_string(env.manifest_dir().join("Examples/features/expected/packages/typed_settings.out")).unwrap() }
    "tls-{tls}\nhttps://api.example.com\n"
}

// Rust: tests/package_outputs.rs:722
// alpha waits on gamma, gamma on beta, beta on alpha; validation precedes spawning.
pub ACTION_CYCLE_BUILD :: """
fn build(b: BuildContext) -> BuildPlan {
    alpha :: b.action("alpha", ["gamma.stamp"], ["alpha.stamp"], ["sh", "-c", "true"], [])
    beta :: b.action("beta", ["alpha.stamp"], ["beta.stamp"], ["sh", "-c", "true"], [])
    gamma :: b.action("gamma", ["beta.stamp"], ["gamma.stamp"], ["sh", "-c", "true"], [])
    app :: b.add_executable("app", ["run.jet"], [alpha, beta, gamma])
    return b.plan(app)
}
fn run() -> {
    print("unreachable")
}
"""
// Rust: tests/package_outputs.rs:736
pub ACTION_CYCLE_CHAIN :: "`alpha` -> `gamma` -> `beta` -> `alpha`"
// Rust: tests/package_outputs.rs:738
pub fn action_cycle_package(tag: String) -> common.Scratch {
    scratch :: common.Scratch.new(tag)
    fs.write(scratch.join("package.jet"), "name: \"build_cycle_demo\"\nversion: \"0.1.0\"\n").expect("write cycle package manifest")
    fs.write(scratch.join("run.jet"), ACTION_CYCLE_BUILD).expect("write cycle build entry")
    scratch
}
// Rust: tests/package_outputs.rs:759
// GATE #4494: real native CLI process; graph rejection must happen before action spawn.
pub fn cycle_diagnostic(scratch: &common.Scratch, args: &[String]) -> String {
    out :: Command.new(jet_bin()).args(args).current_dir(&scratch.path).env("NO_COLOR", "1").output().unwrap_or_else(fn(error) { panic("jet {args:?} should execute: {error}") })
    assert(!out.status.success(), "a cyclic build graph must be rejected by jet {args:?}:\n{String.from_utf8_lossy(&out.stdout)}")
    stderr :: String.from_utf8_lossy(&out.stderr).into_owned()
    stderr.lines().find(fn(line) { line.contains("build plan is invalid") }).unwrap_or_else(fn() { panic("jet {args:?} must reject the cyclic graph as an invalid plan:\n{stderr}") }).to_string()
}
