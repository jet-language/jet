//RS /// A three-node action cycle declared by `fn build`: every action consumes
//RS /// the next action's declared output, so the graph has no build order.
//RS /// `alpha` waits on `gamma`, `gamma` waits on `beta`, `beta` waits on
//RS /// `alpha`.
//RS ///
//RS /// The actions declare no capabilities, so this package reaches graph
//RS /// validation without an `#Impure` gate or an execution grant, and the cycle
//RS /// is rejected before any action is spawned.
//RS const ACTION_CYCLE_BUILD: &str = r#"fn build(b: BuildContext) -> BuildPlan {
//RS     alpha :: b.action("alpha", ["gamma.stamp"], ["alpha.stamp"], ["sh", "-c", "true"], [])
//RS     beta :: b.action("beta", ["alpha.stamp"], ["beta.stamp"], ["sh", "-c", "true"], [])
//RS     gamma :: b.action("gamma", ["beta.stamp"], ["gamma.stamp"], ["sh", "-c", "true"], [])
//RS     app :: b.add_executable("app", ["run.jet"], [alpha, beta, gamma])
//RS     return b.plan(app)
//RS }
//RS 
//RS fn run() {
//RS     print("unreachable")
//RS }
//RS "#;
//RS 
//RS /// The one ordered chain the three-node cycle above must always render.
