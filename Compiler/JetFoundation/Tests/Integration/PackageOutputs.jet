//RS         .join("Examples/features/expected/packages/outputs_build.out");
//RS     fs::read_to_string(&path).unwrap_or_else(|_| panic!("missing {}", path.display()))
//RS }
//RS 
//RS fn jet_bin() -> PathBuf {
//RS     PathBuf::from(env!("CARGO_BIN_EXE_jet"))
//RS }
//RS 
//RS fn nested_example_dir() -> PathBuf {
//RS     PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("Examples/features/packages/outputs_nested")
//RS }
