// D-META-ONE1=A / D-FACT-LAW1=B: one written declaration per registry row.
use jet.AST.[Expr, Item, MarkerDecl, StrPart]
use jet.[Lexer, Parser]
use std.[fs, env]
use jet_foundation.Policy

// Rust: tests/marker_declarations.rs:21
pub fn declarations(source: String) -> [Item] {
    (tokens, lex_diagnostics) :: Lexer.lex(source)
    assert(lex_diagnostics.is_empty(), "lex: {lex_diagnostics:?}")
    Parser.parse(&tokens).expect("Prelude declarations must parse as ordinary Jet").items
}
// Rust: tests/marker_declarations.rs:29
pub fn marker_declarations() -> [MarkerDecl] {
    declarations(Policy.MARKER_SOURCE).into_iter().filter_map(|item| -> {
        if item == { MarkerDecl(declaration) -> Some(declaration); _ -> None }
    }).collect()
}
// Rust: tests/marker_declarations.rs:922
pub fn rust_sources() -> [OSPath] {
    root :: OSPath.from(env.var("CARGO_MANIFEST_DIR").expect("CARGO_MANIFEST_DIR"))
    found: [OSPath] := []
    for directory in ["crates", "Source"] { collect(&root.join(directory), &found) }
    found
}
// Rust: tests/marker_declarations.rs:931
pub fn collect(directory: OSPath, found: &[OSPath]) -> {
    entries :: fs.read_dir(directory)
    if entries == Ok(value) {
        for entry in value.flatten() {
            path :: entry.path()
            if path.is_dir() { collect(&path, &found) }
            else if path.extension().is_some_and(|extension| -> extension == "rs") { found.push(^path) }
        }
    }
}
