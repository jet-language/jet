// Rust: tests/reflect.rs:572
#Test("registered_type_planes_reflect_as_typed_values") {
    fields := []
    loop (name, ty) in [
        ("bounded", Type.IntN{signed: true, bits: 8}),
        ("shape", Type.FixedList{elem: Box.new(Type.Int), len: Measure.literal("length", 4)}),
        ("quantity", Type.Quantity{base: Box.new(Type.Int), dimension: Dimension.base("Length")}),
        ("classified", Type.Tagged{marker: TagMarker.User("Audited"), inner: Box.new(Type.Int)}),
        ("nominal", Type.Tagged{marker: TagMarker.Internal(InternalTag.CoreCryptoNominal), inner: Box.new(Type.Named("Secret"))}),
        ("callable", Type.Fn{
            params: [Type.Int],
            ret: Box.new(Type.Int),
            effect_bound: nil,
            param_contract: [("value", ParamZone.Either)],
            call_metadata: nil,
            return_view_provenance: nil,
        }),
        ("approximate", Type.Float32),
    ] {
        projected := field(name, "Int", true)
        projected.ty = ^ty
        fields.push(^projected)
    }
    info :: build_struct_type_info(&StructDef{
        span: span(),
        is_pub: true,
        is_package_pub: false,
        name: "Planes",
        name_span: span(),
        type_params: [],
        fields: ^fields,
        state: nil,
        methods: [],
        cli_bindings: [],
        trait_impls: [],
        derives: [],
        auto_derive_default: true,
        is_published_schema: false,
        published_schema_span: nil,
        is_single_use: false,
        single_use_span: nil,
        layout: nil,
        layout_span: nil,
        serde_markers: [],
        type_markers: [],
        is_must_use: false,
        must_use_span: nil,
        validate_block: [],
        validate_span: nil,
    })
    facts :: if struct_field(&info, "facts") == { .List(facts) -> facts else -> panic("facts") }
    loop expected in ["Range", "Layout", "Measure", "Exactness", "Dimension", "Classification", "Nominal", "Obligation"] {
        fact :: facts.iter().find((fact) -> if struct_field(fact, "kind") == { .Enum { variant, .. } -> variant == expected else -> false }).unwrap_or_else(() -> panic("missing typed `{expected}` fact in {facts:?}"))
        assert(if struct_field(fact, "value") == { .Struct { .. } -> true else -> false })
    }
    fact_of_kind :: (kind: String) -> {
        facts.iter().find((fact) -> if struct_field(fact, "kind") == { .Enum { variant, .. } -> variant == kind else -> false }).unwrap_or_else(() -> panic("missing `{kind}` payload in {facts:?}"))
    }
    range_slot :: struct_field(struct_field(fact_of_kind("Range"), "value"), "range")
    range :: if range_slot == { .Present(range) -> range else -> panic("range payload is not present") }
    assert(if struct_field(range, "start") == { .Int(-128) -> true else -> false })
    assert(if struct_field(range, "end") == { .Int(127) -> true else -> false })
    layout_slot :: struct_field(struct_field(fact_of_kind("Layout"), "value"), "layout")
    layout :: if layout_slot == { .Present(layout) -> layout else -> panic("layout payload is not present") }
    assert(if struct_field(layout, "bytes") == { .Int(1) -> true else -> false })
    measure_slot :: struct_field(struct_field(fact_of_kind("Measure"), "value"), "measure")
    measure :: if measure_slot == { .Present(measure) -> measure else -> panic("measure payload is not present") }
    assert(if (struct_field(measure, "kind"), struct_field(measure, "value")) == {
        (.Str(kind), .Present(value)) -> kind == "length" && if value.as_ref() == { .Int(4) -> true else -> false }
        else -> false
    })
    exactness_fact :: facts.iter()
        .filter((fact) -> if struct_field(fact, "kind") == { .Enum { variant, .. } -> variant == "Exactness" else -> false })
        .find((fact) -> if struct_field(struct_field(fact, "value"), "exactness") == {
            .Present(value) -> if struct_field(value, "kind") == { .Enum { variant, .. } -> variant == "Approximate" else -> false }
            else -> false
        }).expect("approximate exactness payload")
    exactness_slot :: struct_field(struct_field(exactness_fact, "value"), "exactness")
    exactness :: if exactness_slot == { .Present(exactness) -> exactness else -> panic("exactness payload is not present") }
    assert(if struct_field(exactness, "precision") == { .Present(value) -> if value.as_ref() == { .Int(24) -> true else -> false } else -> false })
    dimension_slot :: struct_field(struct_field(fact_of_kind("Dimension"), "value"), "dimension")
    dimension :: if dimension_slot == { .Present(dimension) -> dimension else -> panic("dimension payload is not present") }
    assert(if struct_field(dimension, "axes") == {
        .List(axes) -> axes.iter().any((axis) -> if (struct_field(axis, "name"), struct_field(axis, "exponent")) == {
            (.Str(name), .Int(1)) -> name == "Length"
            else -> false
        })
        else -> false
    })
    classification_slot :: struct_field(struct_field(fact_of_kind("Classification"), "value"), "classification")
    classification :: if classification_slot == { .Present(classification) -> classification else -> panic("classification payload is not present") }
    assert(if struct_field(classification, "name") == { .Str(name) -> name == "Audited" else -> false })
    nominal_slot :: struct_field(struct_field(fact_of_kind("Nominal"), "value"), "nominal")
    nominal :: if nominal_slot == { .Present(nominal) -> nominal else -> panic("nominal payload is not present") }
    assert(if struct_field(nominal, "name") == { .Str(name) -> name == "core.crypto" else -> false })
    obligation_slot :: struct_field(struct_field(fact_of_kind("Obligation"), "value"), "obligation")
    obligation :: if obligation_slot == { .Present(obligation) -> obligation else -> panic("obligation payload is not present") }
    params :: if struct_field(obligation, "param_contract") == { .List(params) -> params else -> panic("obligation parameter contract") }
    assert(if params.first().map((param) -> (struct_field(param, "name"), struct_field(param, "zone"))) == {
        .Val((.Str(name), .Enum { type_name, variant, .. })) -> name == "value" && type_name == "ParamZone" && variant == "Either"
        else -> false
    })
}

// Rust: tests/reflect.rs:785
#Test("range_and_dimension_facts_are_typed_records") {
    info :: build_distinct_type_info(&DistinctDef{
        is_pub: true,
        is_package_pub: false,
        type_markers: [],
        derives: [],
        quantity: (Dimension.base("Length"), QuantityKind.Linear),
        name: "Severity",
        name_span: span(),
        base: Type.Int,
        base_span: span(),
        range: (0, 10, span()),
        span: span(),
    }, "main")
    assert(if struct_field(&info, "name") == { .Str(name) -> name.as_str() == "Severity" else -> false })
    assert(if struct_field(&info, "path") == { .Str(path) -> path.as_str() == "main.Severity" else -> false })
    facts :: if struct_field(&info, "facts") == { .List(facts) -> facts else -> panic("facts") }
    is_kind :: (fact: &CtValue, expected: String) -> if struct_field(fact, "kind") == {
        .Enum { variant, .. } -> variant == expected
        other -> panic("expected typed fact kind, got {other:?}")
    }
    range :: facts.iter().find((fact) -> is_kind(fact, "Range")).expect("range fact")
    range_value :: if struct_field(struct_field(range, "value"), "range") == { .Present(range_value) -> range_value else -> panic("range fact must carry a present Range") }
    assert(if struct_field(range_value, "start") == { .Int(0) -> true else -> false })
    assert(if struct_field(range_value, "end") == { .Int(10) -> true else -> false })
    assert(if struct_field(struct_field(range, "value"), "dimension") == { .Failed(.Clean(_)) -> true else -> false })
    dimension :: facts.iter().find((fact) -> is_kind(fact, "Dimension")).expect("dimension fact")
    dimension_value :: if struct_field(struct_field(dimension, "value"), "dimension") == { .Present(dimension_value) -> dimension_value else -> panic("dimension fact must carry a present DimensionInfo") }
    axes :: if struct_field(dimension_value, "axes") == { .List(axes) -> axes else -> panic("dimension axes") }
    assert(axes.iter().any((axis) -> if (struct_field(axis, "name"), struct_field(axis, "exponent")) == {
        (.Str(name), .Int(1)) -> name == "Length"
        else -> false
    }))
    assert(if struct_field(struct_field(dimension, "value"), "range") == { .Failed(.Clean(_)) -> true else -> false })
}

// Rust: tests/reflect.rs:860
#Test("orphan_fact_rows_are_typed_and_readable") {
    loop (name, kind) in [
        ("Sendability", "Sendability"),
        ("Attribution", "Attribution"),
        ("Origin", "Origin"),
        ("ViewProvenance", "ViewProvenance"),
        ("UnitScaleProvenance", "UnitScaleProvenance"),
        ("Maturity", "Maturity"),
    ] {
        info :: build_registered_fact_info(name).expect("registered orphan fact")
        assert(if struct_field(&info, "kind") == { .Enum { variant, .. } -> variant == kind else -> false })
        assert(if struct_field(&info, "value") == { .Struct { .. } -> true else -> false })
        if name == "Attribution" {
            assert(if struct_field(&info, "path") == { .Str(path) -> path == "report.$attribution" else -> false })
        }
    }
}
