// Rust: tests/fixtures/process_sessions/session_fixture.rs:99
// Rust: tests/fixtures/process_sessions/session_fixture.rs:143
fn terminal_size() -> (U16, U16) io.Error! {
    // GATE #4483: compile/link the applicable native declarations for selected target.
    if selected_family() == "unix" {
        stdout :: io.stdout()
        size := WinSize { rows: 0, cols: 0, xpixel: 0, ypixel: 0 }
        request :: if selected_os() == "linux" { TIOCGWINSZ_LINUX } else { TIOCGWINSZ_OTHER_UNIX }
        // GATE #4494: stdout stays open; ioctl writes one kernel-sized initialized winsize.
        result :: #Unsafe("stdout retained; initialized WinSize buffer matches native ioctl layout") {
            ioctl(stdout.as_raw_fd(), request, (&size as *WinSize).cast::<U8>())
        }
        if result != 0 { return .Err(io.Error.last_os_error()) }
        return .Ok((size.rows, size.cols))
    } else {
        // The other reference cfg arm is Windows; target publication limits this fixture to Unix/Windows.
        // GATE #4494: owned stdout handle, initialized native screen-buffer record.
        handle :: #Unsafe("process owns standard output handle") { GetStdHandle(STD_OUTPUT_HANDLE) }
        info := ConsoleScreenBufferInfo { size: Coord { x: 0, y: 0 }, cursor: Coord { x: 0, y: 0 }, attributes: 0, window: SmallRect { left: 0, top: 0, right: 0, bottom: 0 }, maximum: Coord { x: 0, y: 0 } }
        result :: #Unsafe("Windows fills one initialized screen-buffer record") { GetConsoleScreenBufferInfo(handle, &info) }
        if result == 0 { return .Err(io.Error.last_os_error()) }
        cols :: (info.window.right as I32 - info.window.left as I32 + 1).try_into::<U16>().map_err((_) -> io.Error.new(io.ErrorKind.Other, "invalid console width"))?
        rows :: (info.window.bottom as I32 - info.window.top as I32 + 1).try_into::<U16>().map_err((_) -> io.Error.new(io.ErrorKind.Other, "invalid console height"))?
        return .Ok((rows, cols))
    }
}
