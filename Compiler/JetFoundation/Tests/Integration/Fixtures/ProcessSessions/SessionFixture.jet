use std.env as env
use std.fs as fs
use std.io as io
use std.process as process
use std.process.[Command]
use std.thread as thread
use std.time.[Duration]
use core.sys.target.[selected_os, selected_family]

// Rust: tests/fixtures/process_sessions/session_fixture.rs:8
fn main() -> {
    args := env.args()
    _program :: args.next()
    if args.next() == {
        "terminal" -> terminal()
        "tree" -> tree(args.next().expect("tree needs a pid file"))
        "descendant" -> descendant(args.next().expect("descendant needs a pid file"))
        "output" -> output(args.next().unwrap_or("large"))
        "cpu" -> cpu()
        "memory" -> memory()
        "files" -> files()
        _ -> process.exit(2)
    }
}
// Rust: tests/fixtures/process_sessions/session_fixture.rs:23
fn output(size: String) -> {
    bytes :: if size == "small" { b"ok\n" } else { b"0123456789abcdef0123456789abcdef\n" }
    // GATE #4494: actual process stdout.
    io.stdout().write_all(bytes).expect("write process output")
}
// Rust: tests/fixtures/process_sessions/session_fixture.rs:32
fn cpu() -> {
    // GATE #4494: native CPU spin hint; deliberately never terminates.
    loop { std.hint.spin_loop() }
}
// Rust: tests/fixtures/process_sessions/session_fixture.rs:38
fn memory() -> {
    blocks := [[U8]]{}
    loop {
        block := [U8].repeat(0, 256 * 1024)
        block[0] = 1
        blocks.push(^block)
        thread.sleep(Duration.from_millis(1))
    }
}
// Rust: tests/fixtures/process_sessions/session_fixture.rs:48
fn files() -> {
    handles := [fs.File]{}
    loop {
        // GATE #4483: selected target device name; #4494 native retained file descriptors.
        if fs.File.open(if selected_os() == "windows" { "NUL" } else { "/dev/null" }) == {
            .Ok(handle) -> handles.push(^handle)
            .Err(_) -> thread.sleep(Duration.from_millis(1))
        }
    }
}
// Rust: tests/fixtures/process_sessions/session_fixture.rs:58
fn terminal() -> {
    if !io.stdin().is_terminal() || !io.stdout().is_terminal() { process.exit(41) }
    stdout := io.stdout().lock()
    stdout.write_all(b"ready\n").expect("write terminal readiness")
    stdout.flush().expect("flush terminal readiness")
    input := ""
    io.stdin().read_line(&input).expect("read terminal input")
    line := input.trim_end_matches(['\r', '\n']) // #4303
    stdout.write_all("input:{line}\n".as_bytes()).expect("write terminal input")
    stdout.write_all(b"\x1b[31mcontrol\x1b[0m\n").expect("write terminal control bytes")
    (rows, cols) :: terminal_size().expect("read terminal size")
    stdout.write_all("size:{rows}x{cols}\n".as_bytes()).expect("write terminal size")
}
// Rust: tests/fixtures/process_sessions/session_fixture.rs:80
fn tree(pid_file: String) -> {
    executable :: env.current_exe().expect("find process fixture")
    _ :: Command.new(executable).args(["descendant", pid_file]).spawn().expect("spawn descendant")
    loop { thread.sleep(Duration.from_secs(1)) }
}
// Rust: tests/fixtures/process_sessions/session_fixture.rs:91
fn descendant(pid_file: String) -> {
    fs.write(pid_file, process.id().to_string()).expect("write descendant pid")
    loop { thread.sleep(Duration.from_secs(1)) }
}

