use std.[fs, env]
use std.path.OSPath
use std.process.[Command, id]
// GATE #4494: real subprocess, native path, filesystem and permission providers.
// Rust: tests/fmt_project.rs:25
fn jet() -> OSPath { OSPath.from(env.var("JET_BIN").expect("Jet executable")) }
// Rust: tests/fmt_project.rs:30
fn tmpdir(tag: String) -> OSPath {
    d :: env.temp_dir().join("jet_fmt_{tag}_{id()}")
    _ :: fs.remove_dir_all(&d)
    fs.create_dir_all(&d).unwrap()
    d
}
