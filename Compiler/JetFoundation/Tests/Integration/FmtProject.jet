// PORT-PENDING 1061 tests-fmt-project: tests/fmt_project.rs:1-1004
// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! D-FMTPROJECT1=D — integration tests for the project-level `jet fmt` command.
//RS //!
//RS //! Covers:
//RS //!   - no-arg discovery (format all .jet under project root)
//RS //!   - explicit file and directory arguments
//RS //!   - `--check`: exit 1 when files would change, exit 0 when clean
//RS //!   - `--check --diff`: prints unified diffs
//RS //!   - `--dry-run`: prints unified diffs without writing
//RS //!   - `--changed` outside a git repo: exit 2 with a diagnostic
//RS //!   - `jet fmt -` stdin mode (including `--stdin-path`)
//RS //!   - preflight zero-write: one bad file among good ones writes NOTHING
//RS //!   - ignore: `vendor/` and other generated dirs are skipped on discovery
//RS //!   - idempotence: formatting twice equals once
//RS //!   - exit-code table: 0 = clean/formatted, 1 = check dirty or a `--check`
//RS //!     rejection (same user-error code as `jet check`), 2 = a writing run that
//RS //!     had to refuse
//RS 
//RS mod common;
//RS use common::jetpack_bin;
//RS 
