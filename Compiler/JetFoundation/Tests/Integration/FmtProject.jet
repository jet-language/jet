//RS /// `jet audit copies` and `jet fmt --explicit-copies` must agree on the same
//RS /// site. The site here is D-MEM-COPYSEM1: `owner.after("@")` is a read view
//RS /// into `owner`'s buffer, and returning it through a `String` (a non-view
//RS /// slot) outlives that buffer, so the checker inserts an owning copy. The
//RS /// audit must list exactly that implicit copy, and `--explicit-copies` must
//RS /// spell it `~domain` at the same span.
//RS #[test]
//RS fn explicit_copy_format_matches_copy_audit() {
//RS     let dir = tmpdir(&line!().to_string());
//RS     // `take` is the retired move keyword (D-CAP7, `Syntax::KW_MOVE`), so it can
//RS     // no longer name a function; `make` matches the canonical fixture in
//RS     // `tests/fixtures/policy_copies_explicit/run.jet`.
//RS     let source = "\
//RS fn make() -> String {
//RS     owner := \"a@b\"
//RS     domain :: owner.after(\"@\")
//RS     return domain
//RS }
//RS fn run() { print(make()) }
//RS ";
//RS     let file = write(&dir, "main.jet", source);
//RS 
//RS     let audit = Command::new(jet())
//RS         .args(["audit", "copies", "--json"])
//RS         .arg(&file)
//RS         .current_dir(&dir)
//RS         .output()
//RS         .unwrap();
//RS     assert_eq!(
//RS         audit.status.code(),
//RS         Some(0),
//RS         "copy audit failed\nstderr: {}",
//RS         String::from_utf8_lossy(&audit.stderr)
//RS     );
//RS     let audit_json = String::from_utf8_lossy(&audit.stdout);
//RS     assert!(audit_json.contains("\"action\":\"audit.copies\""));
//RS     assert!(audit_json.contains("\"kind\":\"implicit\""), "{audit_json}");
//RS 
//RS     let formatted = Command::new(jet())
//RS         .args(["fmt", "--explicit-copies"])
//RS         .arg(&file)
//RS         .current_dir(&dir)
//RS         .output()
//RS         .unwrap();
//RS     assert_eq!(
//RS         formatted.status.code(),
//RS         Some(0),
//RS         "explicit-copy formatting failed\nstderr: {}",
//RS         String::from_utf8_lossy(&formatted.stderr)
//RS     );
//RS     assert!(read(&file).contains("return ~domain"), "{}", read(&file));
//RS }
