// Rust: tests/diagnostic_snapshots.rs:1679
#Test("semantic_guidance_fixtures_keep_one_selected_rule_and_edit") {
    cases: [(String, [String], String)] = [
        ("process_args_view", ["L0515"], ".args()"),
        ("message_text", ["L0516", "L0516", "L0516"], ".text()"),
        ("redundant_fixed_cleanup", ["L0518"], ""),
        ("unit_scalar_rewrap", ["L0519"], " * "),
        ("path_containment_string_prefix", ["L0517"], "is_within"),
        ("complete_ascii_case_ladder", ["L0521"], "to_ascii_"),
        ("walk_files_filter", ["L0522"], "walk_files"),
        ("repeated_list_head", ["L0523"], "[Point]{"),
        ("raw_multiline_html", ["L0524"], "HTML{\"\"\"")
    ]
    root :: OSPath.from(common.manifest_dir())
    loop (name, expected_codes, edit_fragment) in cases {
        path :: root.join("tests/ui_lint").join("{name}.jet")
        source :: fs.read_to_string(&path).expect("semantic guidance fixture")
        output :: jet.compile_with_path(&source, &path.to_string_lossy()).unwrap_or_else(|diagnostics| -> panic("{name} must compile: {diagnostics:?}"))
        selected :: output.lints.iter().filter(|diagnostic| -> {
            match diagnostic.code { "L0515" | "L0516" | "L0517" | "L0518" | "L0519" | "L0521" | "L0522" | "L0523" | "L0524" -> true; _ -> false }
        }).collect<[&Diagnostic]>()
        actual_codes :: selected.iter().map(|diagnostic| -> diagnostic.code.as_str()).collect<[String]>()
        assert_eq(actual_codes, expected_codes, "selected lints changed for {name}")
        // GATE #4499: exact tuple/string/Span composite-key equality and hash.
        sites: [(String, Span): Bool] = [:]
        loop diagnostic in selected {
            span :: diagnostic.span.unwrap_or_else(|| -> panic("{name} selected lint has no semantic site"))
            site :: (diagnostic.code.as_str(), span)
            assert(!sites.contains_key(&site), "{name} emitted duplicate selected lint at {span:?}")
            sites.insert(site, true)
        }
        assert(selected.iter().all(|diagnostic| -> diagnostic.edit.as_ref().is_some_and(|edit| -> edit.new_text.contains(edit_fragment))), "{name} selected lint lost its mechanical edit")
        if name == "raw_multiline_html" {
            edit :: selected[0].edit.as_ref().expect("raw HTML edit")
            literal_start :: source.find("\"\"\"").expect("opening triple quote")
            literal_end :: source.rfind("\"\"\"").expect("closing triple quote") + 3
            assert_eq(edit.span, Span.new(literal_start, literal_end))
            assert_eq(edit.new_text, "HTML{" + source[literal_start..literal_end] + "}")
        }
    }
}
