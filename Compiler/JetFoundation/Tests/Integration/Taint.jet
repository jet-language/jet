// D-TAINT1: Input facts, Scrub contracts and sink diagnostics are compile-time only.
use jet.compile

// Rust: tests/taint.rs:7
pub fn codes(src: String) -> [String] {
    if compile(src) is .Err(diags) {
        diags.iter().map(d -> d.code.clone()).collect()
    } else { [] }
}
