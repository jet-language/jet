// Rust: tests/pure.rs:209
#Test("pure_fn_calling_impure_user_fn_is_e3401") {
    src :: """
fn read_value() -> Int { print("side effect"); return 1 }
fn compute() -[]> Int { return read_value() }
fn run() -> { print("{compute()}") }
"""
    res :: jet.compile(src)
    assert(res.is_err(), "#Pure fn calling impure user fn should fail")
    diags :: res.unwrap_err()
    assert(diags.iter().any(fn(d) { d.code == "E3401" }), "expected E3401, got: {diags.iter().map(fn(d) { d.code }).collect():?}")
}
// Rust: tests/pure.rs:233
#Test("pure_fn_checks_calls_in_range_bounds") {
    src :: """
fn read_bound() -> Int { print("side effect"); return 2 }
fn bad() -[]> Range { return 0..read_bound() }
fn run() -> { print(bad()) }
"""
    diags :: jet.compile(src).expect_err("an impure range bound must fail")
    assert(diags.iter().any(fn(d) { d.code == "E3401" }), "expected E3401, got {diags:?}")
}
// Rust: tests/pure.rs:258
#Test("transitive_chain_3_levels") {
    src :: """
fn b() -> { print("side effect") }
fn a() -> { b() }
fn run() -> { a() }
"""
    diags :: purity_diagnostics(src)
    assert(!diags.is_empty(), "expected E3401 for transitive impurity")
    d :: &diags[0]
    assert_eq(d.code, "E3401", "should be E3401")
    why :: &d.why
    assert(why.contains("run") && why.contains("a") && why.contains("b"), "transitive chain missing from why: {why:?}")
    assert(why.contains("→"), "chain separator `→` missing from why: {why:?}")
}
// Rust: tests/pure.rs:360
#Test("transitive_range_bound_is_e3401") {
    src :: """
fn impure_bound() -> Int { print("oops"); return 2 }
fn helper() -> { band :: 0..impure_bound() }
fn run() -> { helper() }
"""
    diags :: purity_diagnostics(src)
    assert(!diags.is_empty(), "expected E3401")
    why :: &diags[0].why
    assert(why.contains("run") && why.contains("helper") && why.contains("impure_bound"), "chain missing in why: {why:?}")
}
// Rust: tests/pure.rs:454
#Test("transitive_clean_program_no_error") {
    src :: """
fn square(n: Int) -[]> Int { return n * n }
fn run() -> { x :: square(5) }
"""
    diags :: purity_diagnostics(src)
    assert(diags.is_empty(), "expected no diagnostics, got: {diags:?}")
}
// Rust: tests/pure.rs:544
#Test("ctvalue_render_pretty_struct") {
    v :: CtValue.Struct{ type_name: "Point", fields: [("x", CtValue.Int(3)), ("y", CtValue.Int(4))] }
    rendered :: v.render_pretty()
    assert(rendered.contains("Point"), "missing type name")
    assert(rendered.contains("x:"), "missing field x")
    assert(rendered.contains("y:"), "missing field y")
    assert(rendered.contains("3"), "missing value 3")
    assert(rendered.contains("4"), "missing value 4")
}
// Rust: tests/pure.rs:563
#Test("ctvalue_render_pretty_list") {
    v :: CtValue.List([CtValue.Int(1), CtValue.Int(2), CtValue.Int(3)])
    rendered :: v.render_pretty()
    assert(rendered.starts_with('['), "should start with [")
    assert(rendered.contains("1,"), "missing 1")
    assert(rendered.contains("2,"), "missing 2")
}
// Rust: tests/pure.rs:574
#Test("ctvalue_render_pretty_nested") {
    v :: CtValue.Struct{ type_name: "Report", fields: [("total", CtValue.Int(42)), ("items", CtValue.List([CtValue.Str("a"), CtValue.Str("b")]))] }
    rendered :: v.render_pretty()
    assert(rendered.contains("Report"), "missing type name")
    assert(rendered.contains("total:"), "missing total field")
    assert(rendered.contains("items:"), "missing items field")
    assert(rendered.contains("\"a\""), "missing item a")
    assert(rendered.contains("\"b\""), "missing item b")
}
// Rust: tests/pure.rs:599
#Test("ctvalue_to_json_struct") {
    v :: CtValue.Struct{ type_name: "Point", fields: [("x", CtValue.Int(3)), ("y", CtValue.Int(4))] }
    json :: v.to_json()
    assert_eq(json, "{\"x\":3,\"y\":4}")
}
// Rust: tests/pure.rs:614
#Test("ctvalue_to_json_list") {
    v :: CtValue.List([CtValue.Int(1), CtValue.Int(2)])
    assert_eq(v.to_json(), "[1,2]")
}
// Rust: tests/pure.rs:624
#Test("store_generations_empty") {
    dir :: env.temp_dir().join("jet_pure_test_gen_empty")
    with_store(&dir, fn() { _ :: jet.Store.list_generations() })
}
// Rust: tests/pure.rs:634
#Test("store_record_generation") {
    dir :: env.temp_dir().join("jet_pure_test_gen_record")
    with_store(&dir, fn() {
        gen :: jet.Store.record_generation()
        assert(gen >= 1, "generation should be at least 1")
        gens :: jet.Store.list_generations()
        assert(!gens.is_empty(), "should have at least one generation recorded")
    })
}
// Rust: tests/pure.rs:649
#Test("store_rollback_invalid_gen") {
    dir :: env.temp_dir().join("jet_pure_test_gen_rollback_inv")
    with_store(&dir, fn() {
        result :: jet.Store.rollback_to(9999)
        assert(result.is_err(), "rollback to non-existent gen should fail")
    })
}
// Rust: tests/pure.rs:664
#Test("eval_type_error_gives_precise_diagnostic_not_e0956") {
    src :: "fn run() -[]> Int { return \"string\" + 5 }"
    diags :: jet.check_for_eval(src, "test_eval_type.jet")
    assert(!diags.is_empty(), "type error should produce diagnostics, got none")
    assert(diags.iter().all(fn(d) { d.code != "E0956" }), "must not see E0956 for a type error; got: {diags.iter().map(fn(d) { d.code }).collect():?}")
    codes :: diags.iter().map(fn(d) { d.code }).collect()
    assert(codes.iter().any(fn(c) { c != "E0956" }), "expected a type/operator error code, got: {codes:?}")
}
