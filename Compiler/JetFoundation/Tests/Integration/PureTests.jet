use Pure.*
use jet
use jet.[AST, CtValue]
use std.env

// Rust: tests/pure.rs:41
#Test("pure_fn_compiles") {
    src :: """
fn add(a: Int, b: Int) -[]> Int { return a + b }
fn run() -> { print("{add(1, 2)}") }
"""
    res :: jet.compile(src)
    assert(res.is_ok(), "#Pure fn should compile: {res.err():?}")
}
// Rust: tests/pure.rs:56
#Test("pure_fn_impure_call_is_e3401") {
    src :: """
fn bad() -[]> Int {
    print("side effect")
    return 42
}
fn run() -> { print("{bad()}") }
"""
    res :: jet.compile(src)
    assert(res.is_err(), "impure call in #Pure fn should fail")
    diags :: res.unwrap_err()
    assert(diags.iter().any(fn(d) { d.code == "E3401" }), "expected E3401, got: {diags.iter().map(fn(d) { d.code }).collect():?}")
}
// Rust: tests/pure.rs:81
#Test("pure_fn_impure_gate_still_fires_e3401") {
    src :: """
fn bad() -[]> Int {
    #Impure("side effect") { print("ambient") }
    return 42
}
fn run() -> { print("{bad()}") }
"""
    res :: jet.compile(src)
    assert(res.is_err(), "#Impure-gated ambient call in a `-[]>` fn should still fail")
    diags :: res.unwrap_err()
    assert(diags.iter().any(fn(d) { d.code == "E3401" }), "expected E3401, got: {diags.iter().map(fn(d) { d.code }).collect():?}")
}
// Rust: tests/pure.rs:114
#Test("pure_fn_comptime_block_is_excluded_from_runtime_check") {
    src :: """
fn good() -[]> Int {
    prep { print("build-time only") }
    return 42
}
fn run() -> { print("{good()}") }
"""
    res :: jet.compile(src)
    assert(res.is_err(), "print() inside `prep {{ }}` is still build-time invalid")
    diags :: res.unwrap_err()
    e3401s :: diags.iter().filter(fn(d) { d.code == "E3401" }).collect()
    assert_eq(e3401s.len(), 1, "expected exactly one E3401 (the build-time one), got: {e3401s:?}")
    assert(e3401s[0].what.contains("not allowed in comptime code"), "the surviving E3401 should be the build-time one, got: {e3401s[0]:?}")
}
// Rust: tests/pure.rs:149
#Test("comptime_named_authority_scope_compiles") {
    src :: """
ANSWER :: prep { 42 }
fn run() -> {
    prep { #FX(authority: IO) {} }
    print("{ANSWER}")
}
"""
    output :: jet.compile(src).expect("comptime should accept named #FX")
    // Original generated source is a peer reference comparator for constant folding.
    assert(output.rust.contains("42"), "comptime binding was not emitted")
}
// Rust: tests/pure.rs:168
#Test("pure_fn_calling_pure_fn_is_ok") {
    src :: """
fn square(n: Int) -[]> Int { return n * n }
fn cube(n: Int) -[]> Int { return n * square(n) }
fn run() -> { print("{cube(3)}") }
"""
    res :: jet.compile(src)
    assert(res.is_ok(), "pure calling pure should compile: {res.err():?}")
}
