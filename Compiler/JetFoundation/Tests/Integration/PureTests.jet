// Rust: tests/pure.rs:712
#Test("parse_reactive_block_stmt") {
    src :: """
fn run() -> {
    #Reactive { print(1) }
}
"""
    (toks, lex_diags) :: jet.Lexer.lex(src)
    assert(lex_diags.is_empty(), "lex: {lex_diags:?}")
    prog :: jet.Parser.parse(&toks).expect("parse ok")
    run :: prog.items.iter().find_map(fn(i) {
        match i {
            AST.Item.Func(f) -> if f.name == "run" -> Some(f) else -> None
            _ -> None
        }
    }).expect("run")
    assert(run.body.iter().any(fn(s) { match s { AST.Stmt.Reactive{..} -> true; _ -> false } }), "expected Stmt.Reactive in run body, got {run.body:?}")
}
