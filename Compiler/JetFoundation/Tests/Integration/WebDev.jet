// Rust: tests/web_dev.rs:290
fn port_from_url_line(line: String, prefix: String) -> U16? {
    url :: line.strip_prefix(prefix)?
    authority :: url.split("://").nth(1)?.split("/").next()?
    authority.rsplit_once(":")?.1.parse<U16>().ok()
}
// Rust: tests/web_dev.rs:296
fn session_from_canvas_url_line(line: String) -> String? {
    rest :: line.strip_prefix("Canvas: ")?.split("session=").nth(1)?
    rest.split(fn(c) { !c.is_ascii_hexdigit() }).next().filter(fn(token) { token.len() >= 32 }).map(fn(token) { token.to_string() })
}
// Rust: tests/web_dev.rs:306
struct DevPorts { canvas: U16; application: U16 }
// Rust: tests/web_dev.rs:312
fn wait_for_ports(child_stdout: ChildStdout) -> DevPorts {
    (tx, rx) :: mpsc.channel<DevPorts>()
    _ :: thread.spawn(fn() {
        reader :: BufReader.new(^child_stdout)
        canvas_port := None
        application_port := None
        session := None
        loop line in reader.lines().map_while(fn(result) { result.ok() }) {
            if canvas_port.is_none() { canvas_port = port_from_url_line(line, "Canvas: ") }
            if application_port.is_none() { application_port = port_from_url_line(line, "App preview: ") }
            if session.is_none() { session = session_from_canvas_url_line(line) }
            if (canvas_port, application_port, session) == {
                (.Val(canvas), .Val(application), .Val(token)) -> {
                    if application != canvas { forget_canvas_session(application) }
                    remember_canvas_session(canvas, token.clone())
                    _ :: tx.send(DevPorts{canvas: canvas, application: application})
                    return
                }
                else -> {}
            }
        }
    })
    rx.recv_timeout(Duration.from_secs(60)).expect("jet dev never printed its serving URL and Canvas session")
}
// Rust: tests/web_dev.rs:355
fn wait_for_app_preview(child_stdout: ChildStdout) -> U16 {
    (tx, rx) :: mpsc.channel<U16>()
    _ :: thread.spawn(fn() {
        reader :: BufReader.new(^child_stdout)
        sent := false
        loop line in reader.lines().map_while(fn(result) { result.ok() }) {
            if !sent {
                if port_from_url_line(line, "App preview: ") == {
                    .Val(port) -> { forget_canvas_session(port); _ :: tx.send(port); sent = true }
                    .None -> {}
                }
            }
        }
    })
    rx.recv_timeout(Duration.from_secs(60)).expect("jet dev never printed its static app preview URL")
}
// Rust: tests/web_dev.rs:375
fn wait_for_canvas_port(path: OSPath, timeout: Duration) -> U16 {
    transcript :: wait_for_file_text(path, "Canvas: http://", timeout)
    (port, session) :: transcript.lines().find_map(fn(line) { Val((port_from_url_line(line, "Canvas: ")?, session_from_canvas_url_line(line)?)) }).expect("PTY startup did not include a Canvas URL")
    remember_canvas_session(port, session)
    port
}
