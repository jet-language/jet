impl Drop for KillOnDrop {
    // Rust: tests/web_dev.rs:422/477/605/708/804/1097/1246/1368/1528
    fn drop(self: &KillOnDrop) -> { _ :: self.child.kill(); _ :: self.child.wait() }
}
