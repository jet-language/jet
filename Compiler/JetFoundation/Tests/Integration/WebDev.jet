// Rust: tests/web_dev.rs:40
CANVAS_SESSIONS :: OnceLock<Mutex<[U16:String]>>.new()
// Rust: tests/web_dev.rs:42
fn canvas_session(port: U16) -> String? { CANVAS_SESSIONS.get_or_init(fn() { Mutex.new([U16:String]{}) }).lock().unwrap().get(port).cloned() }
// Rust: tests/web_dev.rs:51
fn remember_canvas_session(port: U16, session: String) -> { _ :: CANVAS_SESSIONS.get_or_init(fn() { Mutex.new([U16:String]{}) }).lock().unwrap().insert(port, session) }
// Rust: tests/web_dev.rs:59
fn forget_canvas_session(port: U16) -> {
    if CANVAS_SESSIONS.get() == { .Val(sessions) -> { _ :: sessions.lock().unwrap().remove(port) }; .None -> {} }
}
// Rust: tests/web_dev.rs:68
fn http_get(port: U16, path: String) -> (U16, [U8])? { http_get_with_session(port, path, canvas_session(port)) }
// Rust: tests/web_dev.rs:72
fn http_get_without_session(port: U16, path: String) -> (U16, [U8])? { http_get_with_session(port, path, None) }
// Rust: tests/web_dev.rs:76
fn http_get_with_session(port: U16, path: String, session: String?) -> (U16, [U8])? {
    (status, _, body) :: http_get_response_with_session(port, path, session)?
    Val((status, ^body))
}
// Rust: tests/web_dev.rs:85
fn http_get_with_content_type(port: U16, path: String) -> (U16, String, [U8])? { http_get_response_with_session(port, path, None) }
// Rust: tests/web_dev.rs:89
fn http_get_response_with_session(port: U16, path: String, session: String?) -> (U16, String, [U8])? {
    stream := TcpStream.connect(("127.0.0.1", port)).ok()?
    stream.set_read_timeout(Val(Duration.from_secs(5))).ok()?
    authorization :: session.map(fn(token) { "Authorization: Bearer {token}\r\n" }).unwrap_or_default()
    req :: "GET {path} HTTP/1.1\r\nHost: localhost:{port}\r\n{authorization}Sec-Fetch-Site: same-origin\r\nConnection: close\r\n\r\n"
    stream.write_all(req.bytes()).ok()?
    raw := [U8]{}
    stream.read_to_end(&raw).ok()?
    sep :: "\r\n\r\n".bytes()
    split :: raw.windows(sep.len()).position(fn(window) { window == sep }).map(fn(index) { index + sep.len() })?
    header_text :: String.from_utf8_lossy(raw[..<split])
    status :: header_text.lines().next()?.split_whitespace().nth(1)?.parse<U16>().ok()?
    content_type := ""
    loop line in header_text.lines() {
        if line.split_once(":") == {
            .Val((name, value)) && name.eq_ignore_ascii_case("content-type") -> { content_type = value.trim().to_string(); break }
            else -> {}
        }
    }
    Val((status, content_type, raw[split..].to_vec()))
}
// Rust: tests/web_dev.rs:126
fn raw_http_exchange(port: U16, request: [U8]) -> [U8]? {
    stream := TcpStream.connect(("127.0.0.1", port)).ok()?
    stream.set_read_timeout(Val(Duration.from_secs(5))).ok()?
    stream.write_all(request).ok()?
    stream.shutdown(Shutdown.Write).ok()?
    raw := [U8]{}
    stream.read_to_end(&raw).ok()?
    Val(^raw)
}
// Rust: tests/web_dev.rs:138
fn raw_get_request(target: String, headers: [String]) -> [U8] {
    request := "GET {target} HTTP/1.1\r\n".bytes().to_vec()
    loop header in headers { &request.extend(header.bytes()); &request.extend("\r\n".bytes()) }
    &request.extend("\r\n".bytes())
    request
}
// Rust: tests/web_dev.rs:148
fn http_post(port: U16, path: String, body: String) -> (U16, [U8])? {
    stream := TcpStream.connect(("127.0.0.1", port)).ok()?
    stream.set_read_timeout(Val(Duration.from_secs(5))).ok()?
    authorization :: canvas_session(port).map(fn(token) { "Authorization: Bearer {token}\r\n" }).unwrap_or_default()
    req :: "POST {path} HTTP/1.1\r\nHost: localhost:{port}\r\n{authorization}Origin: http://localhost:{port}\r\nContent-Type: application/json\r\nContent-Length: {body.len()}\r\nConnection: close\r\n\r\n{body}"
    stream.write_all(req.bytes()).ok()?
    raw := [U8]{}
    stream.read_to_end(&raw).ok()?
    sep :: "\r\n\r\n".bytes()
    split :: raw.windows(sep.len()).position(fn(window) { window == sep }).map(fn(index) { index + sep.len() })?
    header_text :: String.from_utf8_lossy(raw[..<split])
    status :: header_text.lines().next()?.split_whitespace().nth(1)?.parse<U16>().ok()?
    Val((status, raw[split..].to_vec()))
}
// Rust: tests/web_dev.rs:182
fn json_field(haystack: String, field: String) -> String {
    key :: "\"{field}\":\""
    start :: haystack.find(key).expect("json field") + key.len()
    rest := haystack[start..] // #4303
    rest[..<rest.find("\"").expect("json field terminator")].to_string()
}
// Rust: tests/web_dev.rs:189
fn debug_session_id(body: String) -> String {
    payload :: body.split_once("\"protocol\":\"jet.canvas.debug\"").map(fn((_, rest)) { rest }).expect("debug protocol payload")
    json_field(payload, "id")
}
// Rust: tests/web_dev.rs:197
fn json_number_after(haystack: String, marker: String) -> U16 {
    start :: haystack.find(marker).expect("json number marker") + marker.len()
    haystack[start..].split(fn(ch) { !ch.is_ascii_digit() }).next().expect("json number").parse<U16>().expect("json number value")
}
// Rust: tests/web_dev.rs:209
fn wait_for_version_change(port: U16, baseline: String, timeout: Duration) -> String {
    start :: Instant.now()
    loop {
        if http_get(port, "/__jet_dev_version") == {
            .Val((200, body)) -> {
                version := String.from_utf8_lossy(body).trim().to_string() // #4303
                if version != baseline && !version.is_empty() { return version }
            }
            else -> {}
        }
        if start.elapsed() > timeout { panic("/__jet_dev_version never changed from {baseline:?} within {timeout:?}") }
        thread.sleep(Duration.from_millis(100))
    }
}
// Rust: tests/web_dev.rs:228
fn wait_for_status(port: U16, client: String, state: String, timeout: Duration) -> String {
    start :: Instant.now()
    path :: "/__jet_dev_status?client={client}"
    loop {
        if http_get(port, path) == {
            .Val((200, body)) -> {
                text :: String.from_utf8_lossy(body).to_string()
                if text.contains("\"state\":\"{state}\"") { return text }
            }
            else -> {}
        }
        if start.elapsed() > timeout { panic("dev status never reached {state:?} within {timeout:?}") }
        thread.sleep(Duration.from_millis(50))
    }
}
// Rust: tests/web_dev.rs:245
fn wait_for_file_text(path: OSPath, needle: String, timeout: Duration) -> String {
    start :: Instant.now()
    loop {
        text :: fs.read_to_string(path).unwrap_or_default()
        if text.contains(needle) { return text }
        if start.elapsed() > timeout { panic("PTY transcript never contained {needle:?} within {timeout:?}:\n{text}") }
        thread.sleep(Duration.from_millis(50))
    }
}
