// Rust: tests/package_outputs.rs:77
#Test("outputs_block_drives_jet_build_aot") {
    dir :: example_dir()
    build_dir :: dir.join(".jet/build")
    _ :: fs.remove_dir_all(&build_dir)
    build :: Command.new(jet_bin()).arg("build").current_dir(&dir).output().expect("jet build should execute")
    assert(build.status.success(), "jet build failed:\n{String.from_utf8_lossy(&build.stderr)}")
    binary :: build_dir.join("service")
    assert(binary.is_file(), "jet build did not produce .jet/build/service (resolved via outputs:); found: {fs.read_dir(&build_dir).map(fn(entries) { entries.flatten().map(fn(e) { e.path() }).collect() }).unwrap_or_default():?}")
    run :: Command.new(&binary).output().expect("built binary should run")
    assert(run.status.success(), "built binary failed:\n{String.from_utf8_lossy(&run.stderr)}")
    assert_eq(String.from_utf8_lossy(&run.stdout), expected_output())
    _ :: fs.remove_dir_all(&build_dir)
}
