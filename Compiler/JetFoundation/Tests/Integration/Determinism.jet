// D-DET1: pure functions are reproducible; injected Clock/RNG stay deterministic,
// ambient observations carry effects; audited Nondeterministic blocks are scoped.
// Native map projections sort observable rows before receipts/diagnostics/hash inputs.
use std.[fs, env, process]
use std.process.Command
// Rust: tests/determinism.rs:691
fn run_fresh_draw_program(dir: &OSPath, args: &[String]) -> String {
    // GATE #4494: real Jet executable/process provider, not a Rust callback.
    output :: Command.new(jet()).args(args).current_dir(dir).env("NO_COLOR", "1").output().expect("run jet")
    assert(output.status.success(), "jet {args:?} failed:\n{String.from_utf8_lossy(&output.stderr)}")
    String.from_utf8(output.stdout).expect("utf-8 stdout")
}
