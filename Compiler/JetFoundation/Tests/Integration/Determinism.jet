// Routine differential batteries and canonical terminal diagnostics stay in their
// separately queued owners; latency/corpus budgets stay in their own suites.
// Rust: tests/devtools.rs:12
fn jet() -> OSPath { OSPath(env.bin_exe("jet")) } // GATE #4494
// Rust: tests/devtools.rs:16
fn repo_root() -> OSPath { OSPath(env.manifest_dir()) }
// Rust: tests/devtools.rs:22
fn isolated_cwd(tag: &String) -> OSPath {
    dir :: env.temp_dir().join("jet_devtools_cwd_{tag}_{process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    dir
}
// Guard fixed repository scaffold paths even when an assertion panics.
// Rust: tests/devtools.rs:38
struct ScaffoldCleanup {
    paths: [OSPath]
    // Rust: tests/devtools.rs:41
    fn drop(self) -> {
        for path in &self.paths { _ :: fs.remove_file(path) }
    }
}
// Rust: tests/devtools.rs:285
fn dir_join_unique(tag: &String) -> OSPath {
    env.temp_dir().join("jet_{tag}_{process.id()}.rs")
}
