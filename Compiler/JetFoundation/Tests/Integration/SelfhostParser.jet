// Rust: tests/selfhost_parser.rs:247
fn jet_byte_array_literal(source: String) -> String {
    bytes := [String]{}
    loop byte in source.bytes() { &bytes.push(byte.to_string()) }
    "[U8]{{{bytes.join(", ")}}}"
}
// Rust: tests/selfhost_parser.rs:252
fn tier_run_source() -> String {
    source := "\nfn run() -> {\n"
    loop (index, (_, input)) in CASES.enumerate() {
        input_bytes :: "parser_input_{index}"
        facts :: "parser_facts_{index}"
        cursor :: "parser_cursor_{index}"
        &source.push_str("    {input_bytes} :: {jet_byte_array_literal(input)}\n")
        &source.push_str("    print({index})\n    print({input_bytes}.len())\n    {cursor} := 0\n")
        &source.push_str("    loop {cursor} < {input_bytes}.len() {{\n")
        &source.push_str("        print(Int.from_u8({input_bytes}[{cursor}]))\n")
        &source.push_str("        {cursor} += 1\n    }}\n")
        &source.push_str("    {facts} :: selfhost_parser_probe({input_bytes})\n    print({facts}.len())\n    {cursor} = 0\n")
        &source.push_str("    loop {cursor} < {facts}.len() {{\n")
        &source.push_str("        print({facts}[{cursor}])\n")
        &source.push_str("        {cursor} += 1\n    }}\n")
    }
    &source.push_str("}\n")
    source
}
