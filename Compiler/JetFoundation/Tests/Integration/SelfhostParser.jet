    loop (index, (_, input)) in CASES.enumerate() {
        bytes :: input.bytes()
        &output.push_str("{index}\n{bytes.len()}\n")
        loop byte in bytes { &output.push_str("{byte}\n") }
        facts :: native_facts(input)
        &output.push_str("{facts.len()}\n")
        loop fact in facts { &output.push_str("{fact}\n") }
    }
    output
}
// Rust: tests/selfhost_parser.rs:289
fn parser_source(root: OSPath) -> (String, Int) {
    source := ""
    source_file_count := 0
    loop row in SOURCE_MANIFEST.lines() {
        path := row.trim() // #4303
        if path.is_empty() || path.starts_with("#") { continue }
        parser_input :: path.starts_with("Compiler/JetLexer/Source/Lexer/")
            || path == "Compiler/JetFoundation/Source/Diagnostics/Diagnostic.jet"
            || path == "Compiler/JetFoundation/Source/Types/Types.jet"
            || path == "Compiler/JetFoundation/Source/Registry/Diagnostics.jet"
            || path == "Compiler/JetFoundation/Source/Registry/DiagnosticRows.jet"
            || path.starts_with("Compiler/JetFoundation/Source/AST/")
            || path.starts_with("Compiler/JetParser/Source/Parser/")
        if parser_input {
            source_file_count += 1
            &source.push_str("// [selfhost parser parity source: ")
            &source.push_str(path)
            &source.push_str("]\n")
            text :: fs.read_to_string(root.join(path)).expect("canonical parser source")
            &source.push_str(without_package_imports(text))
            &source.push_str("\n")
        }
    }
    &source.push_str(PROBE_SOURCE)
    &source.push_str(tier_run_source())
    (source, source_file_count)
}
// Rust: tests/selfhost_parser.rs:322
// D-MOD-CYCLE1=A: concatenation is one namespace; dependency imports are dropped.
fn without_package_imports(text: String) -> String {
    kept := String.with_capacity(text.len())
    in_import := false
    loop line in text.split_inclusive("\n") {
        if !in_import && (line.starts_with("use jet_") || line.starts_with("use compiler_bootstrap")) && line.contains(".[") { in_import = true }
        if in_import { in_import = !line.contains("]"); continue }
        &kept.push_str(line)
    }
    kept
}
// Rust: tests/selfhost_parser.rs:341
struct Pass { mir: MirProgram; function: MirFunctionId; source: String; source_file_count: Int }
// Rust: tests/selfhost_parser.rs:348
fn lower_bundle(bundle: &ProgramBundle, context: String) -> MirProgram {
    diagnostics :: Sema.check_bundle(&bundle, Sema.CompileMode.Run)
    errors :: diagnostics.filter(fn(row) { row.severity == Severity.Error })
    assert(errors.is_empty(), "{context}: checked parser fixture: {errors:?}")
    request :: MirArtifactRequest.new(MirArtifactTarget.Cranelift, MirArtifactKind.NativeExecutable, MirArtifactBuildMode.Dev)
    TIR.lower_checked_mir_program_for(bundle, request).unwrap_or_else(fn(error) { panic("{context}: canonical parser MIR: {error}") }).0
}
// Rust: tests/selfhost_parser.rs:362
fn bootstrap() -> Shared<Pass> {
    run_compiler_work(fn() {
        scratch :: common.Scratch.new("selfhost_parser_bootstrap")
        tir_support.write_test_package(scratch.path, tir_support.TIR_TEST_PACKAGE)
        path :: scratch.path.join("parser.jet")
        (source, source_file_count) :: parser_source(OSPath(env("CARGO_MANIFEST_DIR")))
        fs.write(path, source).unwrap()
        bundle := Loader.load_entry(path.to_str().unwrap()).expect("Rust reference bootstraps the Jet parser source")
        mir :: lower_bundle(&bundle, "generated Jet parser")
        function :: mir.functions.find(fn(row) { row.name == "selfhost_parser_probe" }).expect("compiled parser probe entry").id
        Shared.new(Pass{mir: mir, function: function, source: source, source_file_count: source_file_count})
    })
}
// Rust: tests/selfhost_parser.rs:378
PASS :: OnceLock<Shared<Pass>>.new()
fn pass() -> Shared<Pass> { PASS.get_or_init(bootstrap).clone() }
// Rust: tests/selfhost_parser.rs:384
impl Pass {
    fn evaluate(self: &Pass, source: String) -> [I64] {
        bytes := [MirValue]{}
        loop byte in source.bytes() { &bytes.push(MirValue.Int(I64.from_u8(byte))) }
        args :: [MirValue.List(^bytes)]
        config := MirEvalConfig.default()
        config.fuel = Val(U64{50000000})
        result :: evaluate_mir_function_with_config(self.mir, self.function, args, config)
            .unwrap_or_else(fn(error) { panic("generated Jet parser evaluation: {error.diagnostic:?}") })
        assert_eq(result.status, MirExecutionStatus.Completed, "parser evaluator status")
        assert_eq(result.exit_code, 0, "parser evaluator exit code")
        assert(result.stdout.is_empty() && result.stderr.is_empty(), "parser probe must be silent")
        value := result.value
        if value == { .Present(inner) -> value = ^inner; else -> {} }
        if value == {
            .List(values) -> {
                facts := [I64]{}
                loop item in values {
                    if item == { .Int(number) -> &facts.push(number); else -> panic("parser probe returned a non-integer fact: {item:?}") }
                }
                facts
            }
            else -> panic("parser probe returned a non-list carrier: {value:?}")
        }
    }
}
// Rust: tests/selfhost_parser.rs:408
fn push_text(facts: &[I64], text: String) -> {
    bytes :: text.bytes()
    &facts.push(I64.try_from(bytes.len()).unwrap())
    loop byte in bytes { &facts.push(I64.from_u8(byte)) }
}
// Rust: tests/selfhost_parser.rs:414
fn push_diagnostic(facts: &[I64], diagnostic: &Diagnostic) -> {
    push_text(&facts, diagnostic.code)
    if diagnostic.severity == { .Error -> &facts.push(1); .Lint -> &facts.push(2) }
    push_text(&facts, diagnostic.what)
    push_text(&facts, diagnostic.why)
    push_text(&facts, diagnostic.fix)
    if diagnostic.span == {
        .Val(span) -> &facts.extend([1, I64.try_from(span.start).unwrap(), I64.try_from(span.end).unwrap()])
        .None -> &facts.push(0)
    }
    if diagnostic.edit == {
        .Val(edit) -> {
            &facts.extend([1, I64.try_from(edit.span.start).unwrap(), I64.try_from(edit.span.end).unwrap()])
            push_text(&facts, edit.new_text)
        }
        .None -> &facts.push(0)
    }
    &facts.push(I64.try_from(diagnostic.labels.len()).unwrap())
    loop label in diagnostic.labels {
        &facts.extend([I64.try_from(label.span.start).unwrap(), I64.try_from(label.span.end).unwrap()])
        push_text(&facts, label.message)
    }
}
// Rust: tests/selfhost_parser.rs:441
fn push_expr(facts: &[I64], expression: &Expr) -> {
    if expression == {
        .Ident(name, span) -> {
            &facts.push(1)
            push_text(&facts, name)
            &facts.extend([I64.try_from(span.start).unwrap(), I64.try_from(span.end).unwrap()])
        }
        .Spread(value, span) -> {
            &facts.extend([2, I64.try_from(span.start).unwrap(), I64.try_from(span.end).unwrap()])
            push_expr(&facts, value)
        }
        .Field(base, member, span) -> {
            &facts.push(3)
            push_text(&facts, member)
            &facts.extend([I64.try_from(span.start).unwrap(), I64.try_from(span.end).unwrap()])
            push_expr(&facts, base)
        }
        .OptField(base, member, member_span, _, span) -> {
            &facts.push(5)
            push_text(&facts, member)
            &facts.extend([I64.try_from(member_span.start).unwrap(), I64.try_from(member_span.end).unwrap(), I64.try_from(span.start).unwrap(), I64.try_from(span.end).unwrap()])
            push_expr(&facts, base)
        }
        // D-SUGAR6: native CallValue through OptField corresponds to OptMethodCall.
        .CallValue(callee, args, span) -> {
            if callee == {
                .OptField(base, member, member_span, _, _) -> {
                    &facts.push(6)
                    push_text(&facts, member)
                    &facts.extend([I64.try_from(member_span.start).unwrap(), I64.try_from(member_span.end).unwrap(), I64.try_from(base.span().start).unwrap(), I64.try_from(span.end).unwrap(), I64.try_from(args.len()).unwrap()])
                    loop argument in args { push_call_arg(&facts, &argument) }
                    push_expr(&facts, base)
                }
                else -> &facts.push(0)
            }
        }
        else -> &facts.push(0)
    }
}
// Rust: tests/selfhost_parser.rs:505
fn push_label(facts: &[I64], label: (String, Span)?) -> {
    if label == {
        .Val((name, span)) -> {
            &facts.push(1)
            push_text(&facts, name)
            &facts.extend([I64.try_from(span.start).unwrap(), I64.try_from(span.end).unwrap()])
        }
        .None -> &facts.push(0)
    }
}
// Rust: tests/selfhost_parser.rs:515
fn push_call_arg(facts: &[I64], argument: &CallArg) -> {
    convention :: if argument.convention == { .Read -> 0; .Write -> 1; .Move -> 2 }
    spread :: if argument.spread -> 1 else -> 0
    &facts.extend([convention, I64.try_from(argument.span.start).unwrap(), I64.try_from(argument.span.end).unwrap(), spread])
    push_label(&facts, argument.label)
    push_expr(&facts, &argument.expr)
}
// Rust: tests/selfhost_parser.rs:531
fn push_marker(facts: &[I64], marker: &Marker) -> {
    &facts.push(I64.try_from(marker.args.len()).unwrap())
    loop (index, argument) in marker.args.enumerate() {
        label := None
        if index < marker.arg_labels.len() { label = marker.arg_labels[index] }
        push_label(&facts, label)
        if argument == {
            .Expr(expression) -> push_expr(&facts, &expression)
            .EffectRow(_, span) -> &facts.extend([4, I64.try_from(span.start).unwrap(), I64.try_from(span.end).unwrap()])
        }
    }
}
// Rust: tests/selfhost_parser.rs:544
fn push_program(facts: &[I64], program: Program?, diagnostics: [Diagnostic]) -> {
    show_ast := true
    loop diagnostic in diagnostics { if diagnostic.code != "E0029" { show_ast = false } }
    if !show_ast { &facts.extend([0, 0]); return }
    if program == {
        .Val(value) -> {
            if value.script_body.len() > 0 {
                if value.script_body[0] == {
                    .Expr(expression) -> {
                        if expression == {
                            .Call(call) -> {
                                &facts.extend([1, I64.try_from(call.args.len()).unwrap()])
                                loop argument in call.args { push_call_arg(&facts, &argument) }
                                return
                            }
                            else -> {}
                        }
                    }
                    .Switched(marker, _, _) -> { &facts.push(3); push_marker(&facts, &marker); return }
                    else -> {}
                }
            }
            if value.items.len() > 0 {
                if value.items[0] == {
                    .Func(function) -> {
                        if function.markers.len() > 0 { &facts.push(2); push_marker(&facts, &function.markers[0]); return }
                    }
                    else -> {}
                }
            }
        }
        .None -> {}
    }
    &facts.extend([0, 0])
}
// Rust: tests/selfhost_parser.rs:581
fn push_diagnostics(facts: &[I64], diagnostics: [Diagnostic]) -> {
    &facts.push(I64.try_from(diagnostics.len()).unwrap())
    loop diagnostic in diagnostics { push_diagnostic(&facts, &diagnostic) }
}
// Rust: tests/selfhost_parser.rs:588
fn native_facts(source: String) -> [I64] {
    (tokens, lexer_diagnostics) :: Lexer.lex(source)
    facts := [I64]{}
    // Lexer failure stops parsing; do not append parser diagnostics.
    if !lexer_diagnostics.is_empty() {
        push_diagnostics(&facts, lexer_diagnostics)
        push_program(&facts, None, lexer_diagnostics)
        return facts
    }
    result :: Parser.parse_for_check_with_source(tokens, source)
    if result == {
        .Ok((program, diagnostics)) -> { push_diagnostics(&facts, diagnostics); push_program(&facts, Val(program), diagnostics) }
        .Err(diagnostics) -> { push_diagnostics(&facts, diagnostics); push_program(&facts, None, diagnostics) }
    }
    facts
}
// Rust: tests/selfhost_parser.rs:613
// Human-facing text in the diagnostic prefix of a parser fact vector.
fn diagnostic_texts(facts: [I64]) -> [String] {
    cursor := 0
    next :: fn() -> I64 { cursor += 1; facts[cursor - 1] }
    // Rust: tests/selfhost_parser.rs:619
    text :: fn(next: () -> I64) -> String {
        len :: Int.try_from(next()).unwrap()
        bytes := [U8]{}
        loop _ in 0..<len { &bytes.push(U8.truncate(next())) }
        String.from_utf8(^bytes).expect("diagnostic text is UTF-8")
    }
    out := [String]{}
    count :: next()
    loop _ in 0..<count {
        _ :: text(next)
        _ :: next()
        loop _ in 0..<3 { &out.push(text(next)) }
        if next() == 1 { _ :: next(); _ :: next() }
        if next() == 1 { _ :: next(); _ :: next(); &out.push(text(next)) }
        labels :: next()
        loop _ in 0..<labels { _ :: next(); _ :: next(); &out.push(text(next)) }
    }
    out
}
