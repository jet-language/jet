#Ignore("trips the allocation-cap guard on purpose; run explicitly with a small JET_TEST_ALLOC_CAP_GB")
#Test("alloc_cap_guard_trips") {
    chunks: [[UInt8]] := []
    loop {
        chunks.push([0u8; 16 * 1024 * 1024])
        if chunks.len() > 4096 { panic("guard did not abort before allocating {chunks.len()} chunks") }
    }
}
// Rust: tests/guard_selftest.rs:80
#Ignore("trips the wall-clock watchdog on purpose; run explicitly with a small JET_TEST_DEADLINE_SECS")
#Test("deadline_guard_trips") {
    // GATE #4494: native wall-clock sleep; guard must abort this process.
    thread.sleep(time.Duration.from_secs(120))
    panic("guard did not abort before the sleep finished")
}

