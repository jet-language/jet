// Rust: tests/harness_tools.rs:9
#Test("unified_diff_keeps_small_diffs_complete") {
    diff :: unified_diff("expected", "actual", "same\nold\n", "same\nnew\n")
    assert(diff.starts_with("--- expected\n+++ actual\n@@"))
    assert(diff.contains(" same\n"))
    assert(diff.contains("-old\n"))
    assert(diff.contains("+new\n"))
    assert(!diff.contains("truncated"))
}
// Rust: tests/harness_tools.rs:19
#Test("unified_diff_bounds_hostile_output_and_names_every_truncation") {
    expected_line :: "{"e".repeat(1024)}\n"
    actual_line :: "{"a".repeat(1024)}\n"
    expected :: expected_line.repeat(UNIFIED_DIFF_MAX_INPUT_LINES * 2)
    actual :: actual_line.repeat(UNIFIED_DIFF_MAX_INPUT_LINES * 2)
    diff :: unified_diff("expected", "actual", &expected, &actual)
    assert(diff.starts_with("--- expected\n+++ actual\n"))
    assert(diff.contains("@@"))
    assert(diff.contains("diff input truncated: expected"), "expected input truncation must be explicit")
    assert(diff.contains("diff input truncated: actual"), "actual input truncation must be explicit")
    assert(diff.contains("diff output truncated; remaining compared edits omitted"), "render truncation must be explicit")
    assert(diff.len() <= UNIFIED_DIFF_MAX_OUTPUT_BYTES)
    assert(expected.len() > UNIFIED_DIFF_MAX_INPUT_BYTES)
    assert(actual.len() > UNIFIED_DIFF_MAX_INPUT_BYTES)
}
// Rust: tests/harness_tools.rs:47
#Test("unified_diff_line_limit_is_reported_without_scanning_all_lines") {
    expected :: "old\n".repeat(UNIFIED_DIFF_MAX_INPUT_LINES * 4)
    actual :: "new\n".repeat(UNIFIED_DIFF_MAX_INPUT_LINES * 4)
    diff :: unified_diff("expected", "actual", &expected, &actual)
    assert(diff.contains("limits are {UNIFIED_DIFF_MAX_INPUT_BYTES} bytes/{UNIFIED_DIFF_MAX_INPUT_LINES} lines"))
    assert(diff.len() <= UNIFIED_DIFF_MAX_OUTPUT_BYTES)
}

// Rust: tests/hostile_closeout_ledger.rs:340
#Test("every_observed_hostile_closeout_finding_has_one_owner_row") {
    observed :: raw_code_counts()
    validate_hostile_closeout_ledger(LEDGER, &observed).unwrap_or_else(|error| -> panic("hostile closeout ledger is incomplete: {error}"))
}
// Rust: tests/hostile_closeout_ledger.rs:347
#Test("closeout_rejects_an_observed_finding_when_its_owner_row_is_missing") {
    observed :: raw_code_counts()
    for spec in HOSTILE_CLOSEOUT_FINDINGS {
        without_row :: LEDGER.lines().filter(|line| -> !line.contains("| {spec.finding} ")).collect().join("\n")
        error :: validate_hostile_closeout_ledger(&without_row, &observed).expect_err("an observed finding without its owner row must fail closed")
        observed_name :: spec.code.unwrap_or(spec.finding)
        assert(error.contains(observed_name) && error.contains(spec.finding), "missing-row error lost identity for {spec.finding}: {error}")
    }
}
// Rust: tests/hostile_closeout_ledger.rs:367
#Test("closeout_rejects_a_mismatched_owner_or_witness") {
    observed :: raw_code_counts()
    for spec in HOSTILE_CLOSEOUT_FINDINGS {
        row :: ledger_rows(LEDGER, spec.finding).into_iter().next().expect("every finding has a source row")
        for required in [spec.owner, spec.raw_witness, spec.fixture] {
            mismatched_row :: row.replace(required, "__mismatched__")
            mismatched_ledger :: LEDGER.lines().map(|line| -> {
                if line == row { mismatched_row.as_str() } else { line }
            }).collect().join("\n")
            error :: validate_hostile_closeout_ledger(&mismatched_ledger, &observed).expect_err("a mismatched owner or witness must fail closed")
            assert(error.contains(spec.finding) && error.contains(required), "mismatch error lost {spec.finding} identity: {error}")
        }
    }
}
// Rust: tests/hostile_closeout_ledger.rs:399
#Test("l0503_current_fixture_keeps_subject_span_and_teaching_snapshot") {
    fixture :: fs.read_to_string(root().join("tests/ui_lint/prefer_compound_assign.jet")).expect("L0503 fixture")
    snapshot :: fs.read_to_string(root().join("tests/ui_lint/prefer_compound_assign.warn")).expect("L0503 snapshot")
    for expected in ["p.hp = p.hp - amount", "n = (n + 1)", "Indexed compound is E0164"] {
        assert(fixture.contains(expected), "L0503 fixture lost {expected:?}")
    }
    assert_eq(snapshot.matches("Warning [L0503]").count(), 4, "L0503 snapshot warning count changed: {snapshot}")
    for expected in ["prefer `p.hp -= …` instead of repeating the left side", "prefer `p.hp += …` instead of repeating the left side", "Why: compound assignment updates a place in one step without restating it", "Fix: write `p.hp -= …`", "More: jet-lang.dev/e/L0503"] {
        assert(snapshot.contains(expected), "L0503 snapshot lost {expected:?}")
    }
}
