// Rust: tests/hardening.rs:47
#Test("instance_method_args_keep_read_convention") {
    src :: "\nstruct Greeter {{\n    prefix: String\n\n    fn greet(self, name: String) -> String {{\n        return \"{{self.prefix}} {{name}}\"\n    }}\n}}\n\nfn run() {{\n    g :: Greeter{{ prefix: \"hi\" }}\n    name :: \"bob\"\n    print(g.greet(name))\n}}\n"
    out :: compile(src).expect("should compile")
    assert(out.rust.contains("__jet_greet(&("), "read-convention method arg must be borrowed: {out.rust}")
}
// Rust: tests/hardening.rs:72
#Test("field_read_clones_instead_of_moving") {
    src :: "\nstruct P {{\n    name: String\n}}\n\nfn run() {{\n    p :: P{{ name: \"x\" }}\n    s :: p.name\n    t :: p.name\n    print(s)\n    print(t)\n}}\n"
    out :: compile(src).expect("should compile")
    assert(out.rust.contains("__jet_name).clone()"), "field reads in owning position must clone: {out.rust}")
}
// Rust: tests/hardening.rs:95
#Test("or_fallback_keeps_sema_rewrites") {
    src :: "\nfn maybe() -> (Int?) {{\n    return None\n}}\n\nfn run() {{\n    m := [String:Int]{{}}\n    m[\"k\"] = 7\n    x :: maybe() ?? m[\"k\"]\n    print(x)\n}}\n"
    out :: compile(src).expect("should compile")
    assert(out.rust.contains("jet_index_map"), "map index inside `or` fallback must use the map helper: {out.rust}")
}
// Rust: tests/hardening.rs:117
#Test("bare_question_return_uses_default_error") {
    src :: "\nfn parse_count(raw: String) -> Int {{\n    if raw == \"\" {{\n        return Err(\"empty\")\n    }}\n    return Ok(1)\n}}\n\nfn run() {{\n    n :: parse_count(\"\") ?? 0\n    print(n)\n}}\n"
    out :: compile(src).expect("default Err fallible return should compile")
    assert(out.rust.contains("Result<i64, JetErr>"), "default Err should lower to the Prelude value: {out.rust}")
}
