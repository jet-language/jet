// Rust: tests/todo_fill.rs:4
pub fn todo_example() -> OSPath {
    OSPath.from(env.build_var("CARGO_MANIFEST_DIR")).join("Examples/features/tooling/todo_hole.jet")
}
// Rust: tests/toolchain_pin.rs:14
pub fn jet_bin() -> OSPath { OSPath.from(env.build_var("CARGO_BIN_EXE_jet")) }
// Rust: tests/toolchain_pin.rs:18
pub fn scratch(tag: String) -> OSPath {
    base :: env.temp_dir().join("jet_toolchain_pin_{tag}_{process.id()}_{time.SystemTime.now().duration_since(time.UNIX_EPOCH).unwrap().as_nanos():?}")
    fs.create_dir_all(&base).unwrap()
    base
}
// Rust: tests/toolchain_pin.rs:31
pub fn run(args: [String], cwd: &OSPath) -> Output {
    Command.new(jet_bin()).args(args).current_dir(cwd).output().expect("jet binary should run")
}
// Rust: tests/toolchain_pin.rs:39
pub fn write(dir: &OSPath, name: String, body: String) -> Unit { fs.write(dir.join(name), body).unwrap() }
// Rust: tests/ui_backend.rs:10
pub fn build_and_run(dir: &OSPath, name: String, src: String) -> (I32, String, String) {
    tir_support.write_test_package(dir, tir_support.TIR_TEST_PACKAGE)
    path :: dir.join(name)
    fs.write(&path, src).unwrap()
    shown :: path.to_string_lossy()
    _ :: compile_with_path(src, shown).unwrap_or_else(fn(diags) {
        panic("front end rejected fixture:\n{render_diagnostics(shown, src, &diags)}")
    })
    // Native O0 replaces the retired generated-Rust/rustc representation journey.
    output :: Command.new(jet_bin()).args(["run", "--profile=debug", path.to_str().unwrap()])
        .current_dir(dir).output().unwrap()
    (output.status.code().unwrap_or(0), String.from_utf8_lossy(&output.stdout).into_owned(), String.from_utf8_lossy(&output.stderr).into_owned())
}
// Rust: tests/ui_fixes.rs:71
pub fn check_fixed_companion(i: USize, path: &OSPath, have_native: Bool, have_cargo: Bool) -> Unit {
    name :: path.file_name().unwrap().to_string_lossy()
    src :: fs.read_to_string(path).unwrap()
    shown :: "tests/ui/{name}"
    stem_name :: path.file_stem().and_then(fn(s) -> s.to_str()).unwrap_or("")
    if stem_name.starts_with("ffi_") && !have_cargo -> return
    _ :: compile_with_path(src, shown).unwrap_or_else(fn(diags) {
        panic("fixed companion {name} should compile:\n{render_diagnostics(shown, src, &diags)}")
    })
    // take_required.fixed retains the original sema-only fixture boundary.
    if have_native && stem_name != "take_required.fixed" {
        stem :: stem_name.replace('.', "_")
        bin :: env.temp_dir().join("jet_ui_fix_{process.id()}_{i}_{stem}")
        // The native driver owns FFI extern/dependency linking; no Rust bridge.
        status :: Command.new(jet_bin()).args(["build", "--profile=debug", "-o"])
            .arg(&bin).arg(path).status().unwrap()
        assert(status.success(), "native compiler rejected fixed companion {name} (I2)")
    }
}
