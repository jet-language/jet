// Rust: tests/fuzz_sema.rs:53
fn load_example_seeds(root: &OSPath) -> [(String, String)] {
    ex_dir :: root.join("Examples/features")
    ext :: jet.Syntax.FILE_EXT
    seeds: [(String, String)] = []
    files: [OSPath] = []
    for t in fs.read_dir(&ex_dir).unwrap().flatten() {
        tp :: t.path()
        if !tp.is_dir() || tp.file_name().unwrap() == "expected" { continue }
        for e in fs.read_dir(&tp).unwrap().flatten() { files.push(e.path()) }
    }
    for path in files {
        if path.extension().and_then((x) -> x.to_str()) == Val(ext) {
            stem :: "{path.parent().unwrap().file_name().unwrap().to_string_lossy()}/{path.file_stem().unwrap().to_string_lossy()}"
            if stem == "lowlevel/ffi" { continue }
            src :: fs.read_to_string(&path).unwrap()
            shown :: "Examples/features/{stem}.{ext}"
            if src.contains("#Unsafe") { continue }
            baseline_has_unsafe :: jet.compile_with_path(&src, &path.to_string_lossy()).map((out) -> strip_vetted_prelude_modules(&out.rust).contains("unsafe")).unwrap_or(false)
            if baseline_has_unsafe { continue }
            seeds.push((shown, src))
        }
    }
    seeds.sort_by((a, b) -> a.0.cmp(&b.0))
    seeds.extend(curated_soundness_seeds())
    seeds
}
// Rust: tests/fuzz_sema.rs:108
fn curated_soundness_seeds() -> [(String, String)] {
    [
        ("curated/generic_identity", """
fn id<T>(x: T) -> T { return x }
fn run() -> { print(id<Int>(7)) }
"""),
        ("curated/fixed_list_literal_index", """
fn second(xs: [Int#3]) -> Int { return xs[1] }
fn run() -> {
    xs :: [Int#3]{ 1, 2, 3 }
    print(second(xs))
}
"""),
        ("curated/refined_index", """
Index3 :: distinct Int(0..2)
fn pick(xs: [Int#3], i: Index3) -> Int { return xs[i] }
fn run() -> {
    xs :: [Int#3]{ 1, 2, 3 }
    print(pick(xs, Index3.from_int(2)))
}
"""),
        ("curated/fanout_fixed_list", """
fn inc(x: Int) -> Int { return x + 1 }
fn run() -> {
    ys :: [Int#3]{ inc(1), inc(2), inc(3) }
    print(ys[2])
}
"""),
        ("curated/pure_boundary", """
fn add1(x: Int) -[]> Int { return x + 1 }
fn run() -> { print(add1(4)) }
""")
    ]
}
// Rust: tests/fuzz_sema.rs:183
fn mutate_source(rng: &Rng, src: &String, variant: USize) -> String {
    n :: variant
    match rng.next() % 7 {
        0 -> "{src}\n_fuzz_{n} :: {n};\n"
        1 -> "{src}\nfn _fuzz_fn_{n}() -> {{\n    _x :: {n};\n    return;\n}}\n"
        2 -> "{src}\nfn _fuzz_wrap_{n}() -> Int {{\n    return {n};\n}}\n"
        3 -> "{src}\nfn _fuzz_id_{n}<T>(x: T) -> T {{\n    return x\n}}\n"
        4 -> "{src}\nfn _fuzz_fixed_{n}(xs: [Int#3]) -> Int {{\n    return xs[1]\n}}\n"
        5 -> "{src}\n_FuzzIndex{n} :: distinct Int(0..2)\nfn _fuzz_refined_{n}(xs: [Int#3], i: _FuzzIndex{n}) -> Int {{\n    return xs[i]\n}}\n"
        _ -> "{src}\nfn _fuzz_inc_{n}(x: Int) -> Int {{\n    return x + 1\n}}\nfn _fuzz_fixed_{n}() -> [Int#3] {{\n    return [_fuzz_inc_{n}(1), _fuzz_inc_{n}(2), _fuzz_inc_{n}(3)]\n}}\n"
    }
}
// Rust: tests/fuzz_sema.rs:200
fn is_jet_diagnostic(d: &jet.Diagnostics.Diagnostic) -> Bool {
    c :: d.code.as_str()
    c.starts_with('E') || c.starts_with('L') || c.starts_with('W')
}
// Rust: tests/fuzz_sema.rs:205
fn rustc_accepts(stem: &String, rust_code: &String) -> Unit Err! {
    dir :: env.temp_dir()
    rs :: dir.join("jet_fuzz_{stem}.rs")
    bin :: dir.join("jet_fuzz_{stem}")
    fs.write(&rs, rust_code).unwrap()
    out :: Command.new("rustc").args(["--edition", "2021", "-D", "warnings"]).arg(&rs).arg("-o").arg(&bin).output().unwrap()
    if out.status.success() {
        _ :: fs.remove_file(&rs)
        _ :: fs.remove_file(&bin)
        Ok(())
    } else { Err(String.from_utf8_lossy(&out.stderr).into_owned()) }
}
// Rust: tests/fuzz_sema.rs:335
fn check_fuzz_variant(i: USize, shown: &String, mutated: &String, file_str: &String) -> {
    match jet.compile_with_path(mutated, file_str) {
        .Ok(out) -> {
            if !mutated.contains("#Unsafe") {
                assert(!strip_vetted_prelude_modules(&out.rust).contains("unsafe"), "I1 violated in fuzz variant {i} from {shown}: source has no #Unsafe but generated code contains `unsafe`")
            }
            if out.rust.contains("extern crate jet_ffi_") { return }
            match rustc_accepts("v{i}", &out.rust) {
                .Err(rustc_err) -> panic("I2 violated: sema accepted variant {i} from {shown} but rustc rejected:\n{rustc_err}\n--- generated ---\n{out.rust}")
                .Ok(_) -> {}
            }
        }
        .Err(diags) -> {
            assert(!diags.is_empty(), "compile_with_path returned empty diags for variant {i} from {shown}")
            for d in &diags {
                assert(is_jet_diagnostic(d), "variant {i} from {shown}: non-jet diagnostic code `{d.code}`")
            }
        }
    }
}
