// Rust: tests/failure_tier_parity.rs:125
fn normalize_journey_paths(stderr: &String) -> String {
    normalized := stderr.lines().map((line) -> {
        open :: line.find(" (")
        if open == nil { return line.to_string() }
        colon :: line.rfind(':')
        if colon == nil { return line.to_string() }
        if !line[open.unwrap() + 2..colon.unwrap()].contains(".jet") { return line.to_string() }
        "{line[..open.unwrap() + 2]}<source>:{line[colon.unwrap() + 1..]}"
    }).map((line) -> {
        start :: line.match_indices("jet_").find_map(((start, _)) -> {
            if start == 0 || line.as_bytes().get(start - 1) == Val(b'/') { Val(start) } else { nil }
        })
        if start == nil { return line }
        end :: line[start.unwrap()..].find(".jet").map((offset) -> start.unwrap() + offset + 4)
        if end == nil { return line }
        "{line[..start.unwrap()]}<source>{line[end.unwrap()..]}"
    }).collect().join("\n")
    if stderr.ends_with('\n') { normalized.push('\n') }
    normalized
}
// Rust: tests/failure_tier_parity.rs:159
fn runtime_error_suffix(stderr: &String) -> &String {
    start :: stderr.find("Error:").unwrap_or_else(() -> panic("runtime error missing from stderr: {stderr}"))
    &stderr[start..]
}
