use std.[fs, io, env, thread]
use std.process.[Command, Output]
use std.time.Duration
use core.sys.target
use jet_foundation.Tests.Integration.Common.Scratch
// GATE #4494: native filesystem permissions, executable copy, process output and sleep.
// GATE #4409: preserve ExecutableFileBusy distinctly from other IO errors.
// GATE #4483: Unix branches use selected target family.

// Rust: tests/engine_dispatch.rs:21
fn real_jet() -> OSPath { OSPath.from(env.build("CARGO_BIN_EXE_jet")) }

// Rust: tests/engine_dispatch.rs:27
fn isolated_jet(dir: &Scratch) -> OSPath {
    dest :: dir.join("jet")
    fs.copy(real_jet(), &dest).unwrap()
    if target.selected_family() == "unix" {
        perm := fs.metadata(&dest).unwrap().permissions()
        perm.set_mode(0o755)
        fs.set_permissions(&dest, perm).unwrap()
    }
    dest
}

// Rust: tests/engine_dispatch.rs:41
fn write_script(path: &OSPath, body: &String) -> {
    fs.write(path, "#!/bin/sh\n{body}\n").unwrap()
    perm := fs.metadata(path).unwrap().permissions()
    perm.set_mode(0o755)
    fs.set_permissions(path, perm).unwrap()
}

// Rust: tests/engine_dispatch.rs:49
fn output_with_retry(cmd: &Command) -> Output {
    last: io.Error? = nil
    for attempt in 0..8 {
        if attempt > 0 { thread.sleep(Duration.from_millis(20 * attempt)) }
        match cmd.output() {
            .Ok(out) -> return out
            .Err(e) -> {
                if e.kind() == io.ErrorKind.ExecutableFileBusy { last = Val(e) }
                else { panic("engine dispatch command failed: {e}") }
            }
        }
    }
    panic("engine dispatch command stayed busy: {last.unwrap()}")
}

// Rust: tests/event_hooks.rs:16
fn json_string_at(text: &String, start: USize) -> (String, USize) {
    bytes :: text.as_bytes()
    assert_eq(bytes.get(start), Val(b'"'), "JSON string must start with quote")
    index := start + 1
    decoded := String.new()
    while index < bytes.len() {
        match bytes[index] {
            b'"' -> return (decoded, index + 1)
            b'\\' -> {
                index += 1
                escaped :: bytes.get(index).expect("JSON string cannot end after an escape")
                character :: match escaped {
                    b'"' -> '"'
                    b'\\' -> '\\'
                    b'/' -> '/'
                    b'b' -> '\u{8}'
                    b'f' -> '\u{c}'
                    b'n' -> '\n'
                    b'r' -> '\r'
                    b't' -> '\t'
                    b'u' -> {
                        end :: index + 5
                        digits :: text.get(index + 1..end).expect("JSON unicode escape must have four digits")
                        code :: U16.from_str_radix(digits, 16).expect("JSON unicode escape must be hexadecimal")
                        index = end - 1
                        Char.from_u32(code as U32).expect("JSON unicode escape must be valid")
                    }
                    other -> panic("unsupported JSON escape {other:Debug}")
                }
                decoded.push(character)
                index += 1
            }
            _ -> {
                character :: text[index..].chars().next().expect("JSON string byte must be valid UTF-8")
                decoded.push(character)
                index += character.len_utf8()
            }
        }
    }
    panic("unterminated JSON string")
}

// Rust: tests/event_hooks.rs:67
fn hook_commands(settings: &String) -> [String] {
    bytes :: settings.as_bytes()
    commands: [String] = []
    index := 0
    while index < bytes.len() {
        if bytes[index] != b'"' { index += 1; continue }
        (key, after_key) :: json_string_at(settings, index)
        index = after_key
        if key != "command" { continue }
        while bytes.get(index).is_some_and((byte) -> byte.is_ascii_whitespace()) { index += 1 }
        if bytes.get(index) != Val(b':') { continue }
        index += 1
        while bytes.get(index).is_some_and((byte) -> byte.is_ascii_whitespace()) { index += 1 }
        (command, after_command) :: json_string_at(settings, index)
        commands.push(command)
        index = after_command
    }
    commands
}
