// Rust: tests/browser_bidi.rs:1189
#Test("native_bidi_runs_real_network_path_in_forced_and_default_dev_tier_zero") {
    // Rust: tests/browser_bidi.rs:1190
    // Retired engine traces become real network behavior on O0/O1/O2/Web.
    fn run_once(tier: String) -> (String, [String]) {
        listener :: TcpListener.bind(("127.0.0.1", 0)).unwrap()
        endpoint :: "ws://{listener.local_addr().unwrap()}/session"
        server :: thread.spawn(fn() { run_smoke(^listener) })
        source :: """
use core.web.browser as browser
fn run() {
    profile :: browser.profile("bidi-2024.11") ?? panic("profile")
    timeout :: browser.timeout(500) ?? panic("timeout")
    session :: browser.connect_profile("__ENDPOINT__", profile, timeout) ?? panic("connect")
    print(session.abilities().profile())
    bidi :: session.protocol("bidi") ?? panic("protocol")
    blocked :: bidi.send("webExtension.install", "{{}}") ?? "blocked"
    print(blocked)
    unknown :: bidi.send("network.futureCommand", "{{}}") ?? "blocked"
    print(unknown)
    raw_cdp :: bidi.send("goog:cdp.sendCommand", "{{}}") ?? "blocked"
    print(raw_cdp)
    session.close() ?? panic("close")
}
""".replace("__ENDPOINT__", endpoint)
        dir :: common.unique_tmp("jet_browser_bidi_dev")
        fs.create_dir_all(&dir).unwrap()
        fs.write(dir.join("package.jet"), "name: \"browser_bidi_dev\"\nversion: \"0.1.0\"\nauthority: { holds: { allow: [IO, Net] } }\n").unwrap()
        path :: dir.join("browser_bidi_dev.jet"); fs.write(&path, source).unwrap()
        outcome :: common.run_entry_tier(path, tier, false)
        stdout :: if outcome == {
            .Ran(exit_code, stdout, stderr) -> {
                assert(exit_code == 0, "dev stderr:\n{stderr}"); assert(stderr == ""); stdout
            }
            .Problems(diags) -> panic("Browser dev tier rejected real network program: {diags:?}")
        }
        (stdout, server.join().unwrap())
    }
    // Rust: tests/browser_bidi.rs:1246
    fn dev_stdout(source: String, label: String) -> String {
        dir :: common.unique_tmp(label); fs.create_dir_all(&dir).unwrap()
        fs.write(dir.join("package.jet"), "name: \"browser_bidi_dev\"\nversion: \"0.1.0\"\nauthority: { holds: { allow: [IO, Net] } }\n").unwrap()
        path :: dir.join("browser_bidi_dev.jet"); fs.write(&path, source).unwrap()
        if common.run_entry_tier(path, "O0", false) == {
            .Ran(exit_code, stdout, stderr) -> {
                assert(exit_code == 0, "dev stderr:\n{stderr}"); assert(stderr == ""); stdout
            }
            .Problems(diags) -> panic("Browser dev tier rejected real network program: {diags:?}")
        }
    }
    (forced_stdout, forced_methods) :: run_once("O0")
    assert(forced_stdout == "bidi-2024.11\nblocked\nblocked\nblocked\n")
    assert(forced_methods == ["session.status", "session.new", "session.end"])
    loop tier in ["O1", "O2", "Web"] {
        (default_stdout, default_methods) :: run_once(tier)
        assert(default_stdout == forced_stdout); assert(default_methods == forced_methods)
    }
    listener :: TcpListener.bind(("127.0.0.1", 0)).unwrap()
    endpoint :: "ws://{listener.local_addr().unwrap()}/session"
    server :: thread.spawn(fn() { run_profile_smoke(^listener) })
    source :: """
use core.web.browser as browser
fn run() {
    profile :: browser.profile("bidi-2025.5") ?? panic("profile")
    timeout :: browser.timeout(500) ?? panic("timeout")
    session :: browser.connect_profile("__ENDPOINT__", profile, timeout) ?? panic("connect")
    bidi :: session.protocol("bidi") ?? panic("protocol")
    install_outcome :: bidi.send("webExtension.install", "{{}}") ?? "failed"
    print(install_outcome)
    unknown_outcome :: bidi.send("network.futureCommand", "{{}}") ?? "blocked"
    print(unknown_outcome)
    cdp_outcome :: bidi.send("goog:cdp.sendCommand", "{{}}") ?? "blocked"
    print(cdp_outcome)
    session.close() ?? panic("close")
}
""".replace("__ENDPOINT__", endpoint)
    assert(dev_stdout(source, "jet_browser_bidi_profile_2025") == "{}\nblocked\nblocked\n")
    assert(server.join().unwrap() == ["session.status", "session.new", "webExtension.install", "session.end"])
    loop iteration in 0..<2 {
        guard_listener :: TcpListener.bind(("127.0.0.1", 0)).unwrap()
        guard_endpoint :: "ws://{guard_listener.local_addr().unwrap()}/session"
        guard_server :: thread.spawn(fn() { run_smoke(^guard_listener) })
        guard_source :: """
use core.web.browser as browser
fn run() {
    session :: browser.connect("__ENDPOINT__") ?? panic("connect")
    print(session.abilities().profile())
}
""".replace("__ENDPOINT__", guard_endpoint)
        assert(dev_stdout(guard_source, "jet_browser_bidi_guard_{iteration}") == "bidi-2025.5\n")
        assert(guard_server.join().unwrap() == ["session.status", "session.new", "session.end"], "runtime entry guard must drain Browser owners on iteration {iteration}")
    }
    (invalid, invalid_server) :: handshake_listener("{\"ready\":01,\"message\":\"bad\"}", false)
    (surrogate, surrogate_server) :: handshake_listener("{\"ready\":true,\"message\":\"\\uD83D\\uDE80\"}", true)
    codec_source :: """
use core.web.browser as browser
fn outcome(endpoint: String) -> String {
    session :: browser.connect(endpoint) ?? return "caught"
    session.close() ?? return "close-error"
    return "connected"
}
fn run() {
    print(outcome("__INVALID__"))
    print(outcome("__SURROGATE__"))
}
""".replace("__INVALID__", invalid).replace("__SURROGATE__", surrogate)
    assert(dev_stdout(codec_source, "jet_browser_bidi_json_codec") == "caught\nconnected\n")
    assert(invalid_server.join().unwrap() == ["session.status"])
    assert(surrogate_server.join().unwrap() == ["session.status", "session.new", "session.end"])
}

// Rust: tests/browser_bidi.rs:1436
#Test("native_bidi_semantic_locators_actions_and_waits") {
    listener :: TcpListener.bind(("127.0.0.1", 0)).unwrap()
    endpoint :: "ws://{listener.local_addr().unwrap()}/session?token=LOCATOR_SECRET"
    server :: thread.spawn(fn() { run_locator_actions(^listener) })
    source :: """
use core.web.browser as browser
fn run() {
    profile :: browser.profile("bidi-2025.5") ?? panic("profile")
    timeout :: browser.timeout(500) ?? panic("timeout")
    session :: browser.connect_profile("__ENDPOINT__", profile, timeout) ?? panic("connect")
    context :: session.context() ?? panic("context")
    page :: context.page() ?? panic("page")
    page.goto("https://example.test/form") ?? panic("goto")
    save :: page.get_by_role("button", "Save")
    save.wait(timeout) ?? panic("wait")
    save.hover() ?? panic("hover")
    save.click() ?? panic("click")
    name :: page.get_by_label("Name")
    name.fill("Ada") ?? panic("fill")
    name.press("Tab") ?? panic("press")
    page.get_by_text("Save").wait(timeout) ?? panic("text wait")
    page.get_by_placeholder("email").wait(timeout) ?? panic("placeholder wait")
    page.get_by_test_id("save").wait(timeout) ?? panic("test id wait")
    page.get_by_css("button.save").wait(timeout) ?? panic("css wait")
    gone :: page.get_by_role("status", "Saving")
    gone.wait_gone(timeout) ?? panic("wait_gone")
    print("locators:ok")
    page.close() ?? panic("page close")
    context.close() ?? panic("context close")
    session.close() ?? panic("session close")
}
""".replace("__ENDPOINT__", endpoint)
    (code, stdout, stderr) :: common.build_and_run("jet_browser_bidi_locators", "browser_bidi_locators", source)
    assert(code == 0, "stderr:\n{stderr}"); assert(stdout == "locators:ok\n")
    assert(!stdout.contains("SECRET"), stdout); assert(!stderr.contains("SECRET"), stderr)
    methods :: server.join().unwrap()
    assert(methods.iter().filter(fn(m) { m == "browsingContext.locateNodes" }).count() >= 11, "expected repeated locateNodes for waits/actions: {methods:?}")
    assert(methods.iter().any(fn(m) { m == "script.callFunction" }), "fill must use script.callFunction: {methods:?}")
    assert(methods.iter().filter(fn(m) { m == "input.performActions" }).count() >= 3, "hover/click/press need performActions: {methods:?}")
    assert(methods.last() == Val("session.end"))
}
// Rust: tests/browser_bidi.rs:1513
#Test("native_bidi_missing_locator_action_times_out_without_leaks") {
    listener :: TcpListener.bind(("127.0.0.1", 0)).unwrap()
    endpoint :: "ws://{listener.local_addr().unwrap()}/session?token=MISSING_LOCATOR_SECRET"
    server :: thread.spawn(fn() {
        (stream, _) := listener.accept().unwrap(); accept_websocket(&stream); methods := [String]{}
        loop _ in 0..<12 {
            request :: read_text_frame(&stream); id :: field(request, "id"); method :: field(request, "method")
            methods.push(method.clone())
            result :: if method == {
                "session.status" -> "{\"ready\":true,\"message\":\"ready\"}"
                "session.new" -> "{\"sessionId\":\"mock-session\",\"capabilities\":{\"browserName\":\"mock\",\"browserVersion\":\"1\"}}"
                "browser.createUserContext" -> "{\"userContext\":\"user-1\"}"
                "browsingContext.create" -> "{\"context\":\"page-1\"}"
                "browsingContext.locateNodes" -> "{\"nodes\":[]}"
                "browsingContext.close" | "browser.removeUserContext" | "session.end" -> "{}"
                other -> panic("unexpected BiDi method {other}: {request}")
            }
            write_text_frame(&stream, "{\"type\":\"success\",\"id\":{id},\"result\":{result}}")
            if method == "session.end" -> break
        }
        ^methods
    })
    source :: """
use core.web.browser as browser
fn run() {
    profile :: browser.profile("bidi-2025.5") ?? panic("profile")
    timeout :: browser.timeout(80) ?? panic("timeout")
    session :: browser.connect_profile("__ENDPOINT__", profile, timeout) ?? panic("connect")
    context :: session.context() ?? panic("context")
    page :: context.page() ?? panic("page")
    missing :: page.get_by_role("button", "Missing")
    loop attempt in [1] {
        missing.click() ?? next
        print("unexpected")
    }
    print("caught")
    page.close() ?? panic("page close")
    context.close() ?? panic("context close")
    session.close() ?? panic("session close")
}
""".replace("__ENDPOINT__", endpoint)
    (code, stdout, stderr) :: common.build_and_run("jet_browser_bidi_missing_locator", "browser_bidi_missing_locator", source)
    assert(code == 0, "stderr:\n{stderr}"); assert(stdout == "caught\n")
    assert(!stdout.contains("SECRET"), stdout); assert(!stderr.contains("SECRET"), stderr)
    methods :: server.join().unwrap()
    assert(methods.iter().any(fn(m) { m == "browsingContext.locateNodes" }), "{methods:?}")
    assert(!methods.iter().any(fn(m) { m == "input.performActions" }), "missing locator must not click: {methods:?}")
}
// Rust: tests/browser_bidi.rs:1652
#Test("native_bidi_network_events_inspection_and_interception") {
    listener :: TcpListener.bind(("127.0.0.1", 0)).unwrap()
    endpoint :: "ws://{listener.local_addr().unwrap()}/session?token=NETWORK_SECRET"
    server :: thread.spawn(fn() { run_network_events(^listener) })
    source :: """
use core.web.browser as browser
fn run() {
    profile :: browser.profile("bidi-2025.5") ?? panic("profile")
    timeout :: browser.timeout(500) ?? panic("timeout")
    session :: browser.connect_profile("__ENDPOINT__", profile, timeout) ?? panic("connect")
    session.subscribe("network.beforeRequestSent") ?? panic("subscribe")
    intercept :: session.add_intercept("beforeRequestSent") ?? panic("add_intercept")
    event :: &session.next_event(timeout) ?? panic("next_event")
    print(event.kind())
    print(event.request_id())
    print(event.request_method())
    print(event.is_blocked())
    hash :: event.url_hash()
    print(hash.len() == 16)
    print(hash.contains("SECRET") == false)
    session.continue_request(event.request_id()) ?? panic("continue")
    session.fail_request("req-secret-1") ?? panic("fail")
    session.fulfill_request("req-secret-1", 200, "ok") ?? panic("fulfill")
    url_intercept :: session.add_intercept_url("beforeRequestSent", "https://api.test/*") ?? panic("add_intercept_url")
    url_intercept.remove() ?? panic("remove url")
    intercept.remove() ?? panic("remove")
    intercept.remove() ?? panic("remove idempotent")
    print("network:ok")
    session.close() ?? panic("session close")
}
""".replace("__ENDPOINT__", endpoint)
    (code, stdout, stderr) :: common.build_and_run("jet_browser_bidi_network", "browser_bidi_network", source)
    assert(code == 0, "stderr:\n{stderr}")
    assert(stdout.contains("network.beforeRequestSent\n"), stdout); assert(stdout.contains("req-secret-1\n"), stdout)
    assert(stdout.contains("GET\n"), stdout); assert(stdout.contains("true\n"), stdout); assert(stdout.contains("network:ok\n"), stdout)
    assert(!stdout.contains("TOP_SECRET"), stdout); assert(!stdout.contains("NETWORK_SECRET"), stdout)
    assert(!stderr.contains("TOP_SECRET"), stderr); assert(!stderr.contains("NETWORK_SECRET"), stderr)
    methods :: server.join().unwrap()
    assert(methods.iter().any(fn(m) { m == "session.subscribe" }), "{methods:?}")
    assert(methods.iter().filter(fn(m) { m == "network.addIntercept" }).count() == 2, "{methods:?}")
    assert(methods.iter().any(fn(m) { m == "network.continueRequest" }), "{methods:?}")
    assert(methods.iter().any(fn(m) { m == "network.failRequest" }), "{methods:?}")
    assert(methods.iter().any(fn(m) { m == "network.provideResponse" }), "{methods:?}")
    assert(methods.iter().filter(fn(m) { m == "network.removeIntercept" }).count() == 2, "second remove must be local-idempotent: {methods:?}")
    assert(methods.last() == Val("session.end"))
}
