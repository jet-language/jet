#Test("native_bidi_network_intercept_rejects_bad_phase_and_empty_request") {
    listener :: TcpListener.bind(("127.0.0.1", 0)).unwrap()
    endpoint :: "ws://{listener.local_addr().unwrap()}/session?token=HOSTILE_NETWORK_SECRET"
    server :: thread.spawn(fn() {
        (stream, _) := listener.accept().unwrap(); accept_websocket(&stream); methods := [String]{}
        loop _ in 0..<10 {
            request :: read_text_frame(&stream); id :: field(request, "id"); method :: field(request, "method"); methods.push(method.clone())
            result :: if method == {
                "session.status" -> "{\"ready\":true,\"message\":\"ready\"}"
                "session.new" -> "{\"sessionId\":\"mock-session\",\"capabilities\":{\"browserName\":\"mock\",\"browserVersion\":\"1\"}}"
                "session.end" -> "{}"
                other -> panic("unexpected BiDi method {other}: {request}")
            }
            write_text_frame(&stream, "{\"type\":\"success\",\"id\":{id},\"result\":{result}}")
            if method == "session.end" -> break
        }
        ^methods
    })
    source :: """
use core.web.browser as browser
fn run() {
    profile :: browser.profile("bidi-2025.5") ?? panic("profile")
    timeout :: browser.timeout(200) ?? panic("timeout")
    session :: browser.connect_profile("__ENDPOINT__", profile, timeout) ?? panic("connect")
    loop attempt in [1] {
        session.add_intercept("not-a-phase") ?? next
        print("unexpected phase")
    }
    loop attempt in [1] {
        session.continue_request("") ?? next
        print("unexpected empty")
    }
    loop attempt in [1] {
        session.fulfill_request("req", 99, "nope") ?? next
        print("unexpected status")
    }
    print("caught")
    session.close() ?? panic("close")
}
""".replace("__ENDPOINT__", endpoint)
    (code, stdout, stderr) :: common.build_and_run("jet_browser_bidi_network_hostile", "browser_bidi_network_hostile", source)
    assert(code == 0, "stderr:\n{stderr}"); assert(stdout == "caught\n")
    assert(!stdout.contains("SECRET"), stdout); assert(!stderr.contains("SECRET"), stderr)
    methods :: server.join().unwrap()
    assert(!methods.iter().any(fn(m) { m.starts_with("network.") }), "invalid client calls must not hit the wire: {methods:?}")
}
