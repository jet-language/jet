use std.[env, fs, process]
use std.process.[Command, Output]
use jet as compiler

// Rust: tests/structural_merge.rs:10
fn jet() -> OSPath { OSPath.from(env.build_var("CARGO_BIN_EXE_jet")) }
// Rust: tests/structural_merge.rs:13
fn dir(name: String) -> OSPath {
    // GATE #4494: native process identity and filesystem.
    path :: env.temp_dir().join("jet_structural_merge_{process.id()}_{name}")
    _ :: fs.remove_dir_all(&path)
    fs.create_dir_all(&path).unwrap()
    path
}
// Rust: tests/structural_merge.rs:23
fn write(dir: &OSPath, name: String, source: String) -> OSPath {
    path :: dir.join(name)
    fs.write(&path, source).unwrap()
    path
}
// Rust: tests/structural_merge.rs:28
fn run(args: &[String]) -> Output {
    // GATE #4494: native subprocess.
    Command.new(jet()).args(args).output().unwrap()
}
// Rust: tests/structural_merge.rs:31
fn run_in(dir: &OSPath, args: &[String]) -> Output { Command.new(jet()).current_dir(dir).args(args).output().unwrap() }
// Rust: tests/structural_merge.rs:38
fn git(dir: &OSPath, args: &[String]) -> Output { Command.new("git").current_dir(dir).args(args).output().unwrap() }
// Rust: tests/structural_merge.rs:45
fn semantic_rename_receipt(root: &OSPath, path: &OSPath, before: String, after: String, from: String, to: String) -> {
    dir :: root.join(".jet/codemods")
    fs.create_dir_all(&dir).unwrap()
    before_hash :: compiler.SHA256.sha256_hex(before.as_bytes())
    after_hash :: compiler.SHA256.sha256_hex(after.as_bytes())
    receipt :: "{{\"schema\":2,\"name\":\"recorded-rename\",\"project\":\"{root.display()}\",\"semantic_ops\":[{{\"kind\":\"rename\",\"from\":\"{from}\",\"to\":\"{to}\",\"targets\":[{{\"stable_id\":\"def:recorded\",\"before\":\"{from}\",\"after\":\"{to}\",\"kind\":\"function\",\"module_path\":\"{path.display()}\"}}],\"files\":[{{\"path\":\"{path.display()}\",\"before_hash\":\"{before_hash}\",\"after_hash\":\"{after_hash}\"}}]}}],\"files\":[{{\"path\":\"{path.display()}\",\"before_hash\":\"{before_hash}\",\"after_hash\":\"{after_hash}\"}}]}}\n"
    fs.write(dir.join("recorded-rename.log.json"), receipt).unwrap()
}
