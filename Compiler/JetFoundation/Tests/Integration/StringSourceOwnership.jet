// Rust: tests/structure_fact_plane.rs:19
fn repo() -> OSPath { OSPath.from(env.build_var("CARGO_MANIFEST_DIR")) }
// Rust: tests/structure_fact_plane.rs:23
fn structure_example() -> OSPath { repo().join("Examples/features/tooling/structure_plane.jet") }
// Rust: tests/structure_fact_plane.rs:27
fn run_jet(args: &[String]) -> Output {
    // GATE #4494: native subprocess.
    Command.new(env.build_var("CARGO_BIN_EXE_jet")).current_dir(repo()).env("NO_COLOR", "1").args(args).output().expect("run jet")
}
// Rust: tests/structure_fact_plane.rs:36
fn successful_stdout(output: Output) -> String {
    assert(output.status.success(), "jet failed: stdout={String.from_utf8_lossy(&output.stdout)} stderr={String.from_utf8_lossy(&output.stderr)}")
    String.from_utf8(^output.stdout).expect("jet stdout is utf8")
}
