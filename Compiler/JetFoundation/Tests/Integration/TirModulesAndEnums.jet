//RS /// Returning a second fallible call from a `?? {}` handler must flatten that
//RS /// call's carrier. Otherwise the caller can select `.Ok` with an `Err` payload
//RS /// and fail later as an invalid struct field receiver.
//RS #[test]
//RS fn imported_fallible_handler_return_flattens_before_result_match() {
//RS     let main_src = "\
//RS module worker
//RS fn wire(value: worker.Value) -> String {
//RS     return value.id
//RS }
//RS fn run() {
//RS     if worker.checked() == {
//RS         .Err(error) -> print(\"failure:{error.message}\")
//RS         .Ok(value) -> print(wire(value))
//RS     }
//RS }
//RS ";
//RS     let worker_src = "\
//RS #Error
//RS pub struct WorkerError {
//RS     pub message: String
//RS }
//RS pub struct Value {
//RS     pub id: String
//RS }
//RS fn inner() -> Bool WorkerError! {
//RS     return Err(WorkerError{message: \"inner\"})
//RS }
//RS fn fail_after(error: WorkerError) -> Value WorkerError! {
//RS     return Err(error)
//RS }
//RS pub fn checked() -> Value WorkerError! {
//RS     inner() ?? {
//RS         return fail_after(err)
//RS     }
//RS     return Ok(Value{id: \"unreachable\"})
//RS }
//RS ";
//RS     let files = [("main.jet", main_src), ("worker.jet", worker_src)];
//RS     let expected = "failure:inner\n";
//RS     let (code, stdout, stderr) =
//RS         run_default_multi("imported_fallible_handler_return", "main.jet", &files);
//RS     assert_eq!(code, 0, "{stderr}");
//RS     assert_eq!(stdout, expected, "{stderr}");
//RS     let (code, stdout, stderr) =
//RS         run_interpret_multi("imported_fallible_handler_return", "main.jet", &files);
