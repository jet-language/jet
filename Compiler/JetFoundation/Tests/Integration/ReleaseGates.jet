//RS         );
//RS         let (package, kind, name, seconds) = (fields[0], fields[1], fields[2], fields[3]);
//RS         assert!(
//RS             seconds.parse::<u64>().is_ok(),
//RS             "Tools/ci/test-weights.tsv:{row} seconds must be a whole number: {seconds:?}"
//RS         );
//RS         let target = match kind {
//RS             "lib" => format!("-p {package} --lib"),
