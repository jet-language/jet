use core.fs as fs
use std.env as env
use std.process.[Command, Output, Stdio]

// Rust: tests/release_gates.rs:14
pub fn jet_bin() -> OSPath { OSPath.from(env.jet_bin()) }
// Rust: tests/release_gates.rs:98
pub fn root() -> OSPath { OSPath.from(env.manifest_dir()) }
// Rust: tests/release_gates.rs:229
pub fn release_dir() -> OSPath { root().join("tests/release") }
// Rust: tests/release_gates.rs:234
pub fn check_fixture(name: String, actual: String) -> {
    path :: release_dir().join(name)
    if env.var("UPDATE_EXPECT").is_ok() {
        fs.create_dir_all(release_dir()).unwrap()
        fs.write(path, actual).unwrap()
        return
    }
    expected :: fs.read_to_string(path).unwrap_or_default()
    assert_eq(actual, expected, "\nrelease fixture mismatch for tests/release/{name}\n(if the new output is intentional and matches the spec, run: UPDATE_EXPECT=1 cargo test)\n")
}
// Rust: tests/release_gates.rs:519
// Independent reference Rust workspace inventory; no compiler execution callback.
// GATE #4494: real process stdin/stdout pipes and child collection.
pub fn full_workspace_test_target_inventory(root: OSPath) -> [String] {
    metadata :: Command.new("cargo").args(["metadata", "--no-deps", "--format-version", "1"]).current_dir(root).output().expect("run cargo metadata")
    assert(metadata.status.success(), "cargo metadata failed:\n{String.from_utf8_lossy(metadata.stderr)}")
    jq_filter :: ".packages[] | .name as $pkg | .targets[] | select(.kind[0] == \"lib\" or .kind[0] == \"bin\" or .kind[0] == \"test\") | if .kind[0] == \"lib\" then \"-p \\($pkg) --lib\" elif .kind[0] == \"bin\" then \"-p \\($pkg) --bin \\(.name)\" else \"-p \\($pkg) --test \\(.name)\" end"
    child := Command.new("jq").args(["-r", jq_filter]).stdin(Stdio.piped()).stdout(Stdio.piped()).spawn().expect("spawn jq")
    child.stdin.as_mut().unwrap().write_all(metadata.stdout).expect("pipe cargo metadata into jq")
    jq_result :: child.wait_with_output().expect("jq output")
    assert(jq_result.status.success(), "jq filter failed:\n{String.from_utf8_lossy(jq_result.stderr)}")
    String.from_utf8(jq_result.stdout).unwrap().lines().map((line) -> line.to_string()).collect()
}
// Rust: tests/release_gates.rs:943
pub fn run_tower_hygiene_gate(repo: OSPath, tower_dir: OSPath, docs_root: OSPath, report: OSPath) -> Output {
    Command.new("bash").arg(repo.join("Tools/ci/tower-hygiene-gate.sh")).current_dir(repo).env("TOWER_DATA", tower_dir).env("JET_TOWER_LINT_SCOPE", docs_root).env("JET_TOWER_HYGIENE_REPORT", report).env_remove("JET_TEST_SHARD").output().expect("run Tower hygiene gate")
}
