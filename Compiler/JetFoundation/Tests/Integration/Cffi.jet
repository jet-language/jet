//RS /// Card #436: build a second C static library exercising the C-ABI shapes
//RS /// that sema newly accepts (fixed-width ints, a `#Layout(c)` struct passed
//RS /// by value, a distinct-over-`Int`) so the round trip is proven against a
//RS /// REAL C compiler + linker, not just codegen string matching.
//RS fn build_c_lib_card436(dir: &Path) -> Option<(PathBuf, String)> {
//RS     let cc = ["cc", "gcc", "clang"]
//RS         .iter()
//RS         .find(|c| Command::new(c).arg("--version").output().is_ok())?;
//RS     let c_src = dir.join("jetc436.c");
//RS     fs::write(
//RS         &c_src,
//RS         r#"
//RS #include <stdint.h>
//RS 
//RS /* D-SG9: fixed-width integers cross the C boundary as their exact C type. */
//RS uint8_t jetc436_add_u8(uint8_t a, uint8_t b) { return (uint8_t)(a + b); }
//RS int32_t jetc436_add_i32(int32_t a, int32_t b) { return a + b; }
//RS float jetc436_add_f32(float a, float b) { return a + b; }
//RS 
//RS /* D-REPRC1: a `#Layout(c)` struct is `#[repr(C)]` — same field order/size as
//RS  * this C struct, so it crosses by value with no bridging code needed. */
//RS typedef struct {
//RS     long long x;
//RS     long long y;
//RS } CPoint;
//RS 
//RS CPoint jetc436_make_point(long long x, long long y) {
//RS     CPoint p;
//RS     p.x = x;
//RS     p.y = y;
//RS     return p;
//RS }
//RS 
//RS long long jetc436_point_sum(CPoint p) { return p.x + p.y; }
//RS 
//RS /* D-DIST1: a distinct type is `#[repr(transparent)]` over its base — same
//RS  * ABI as the base scalar, so it crosses the boundary directly. */
//RS long long jetc436_scale_meters(long long m) { return m * 2; }
//RS "#,
//RS     )
//RS     .unwrap();
//RS     let obj = dir.join("jetc436.o");
//RS     let ok = Command::new(cc)
//RS         .args(["-c"])
//RS         .arg(&c_src)
//RS         .arg("-o")
//RS         .arg(&obj)
//RS         .status()
//RS         .map(|s| s.success())
//RS         .unwrap_or(false);
//RS     if !ok {
