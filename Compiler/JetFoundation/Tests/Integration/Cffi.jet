// PORT-PENDING 0988 tests-cffi-slice-1: tests/cffi.rs:1-1822
// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! C FFI (S59 / E2-M14) integration + unit tests.
//RS //!
//RS //! Phase 1 proves the whole pipeline end to end: a hand-written `#Bindgen`
//RS //! cache fixture + a `use c.<lib>` call site compile to `extern "C"` wrappers
//RS //! that link against a real C static library (built here with `cc`) and print
//RS //! deterministic output.
//RS //!
//RS //! Phase 2 link discovery is exercised by unit tests over the flag parser
//RS //! (`parse_pkg_config`), the `deps: { lib: c@… }` manifest path, and E3201,
//RS //! since the nix dev shell ships neither `pkg-config` nor a known system lib.
//RS 
//RS use std::fs;
//RS use std::path::{Path, PathBuf};
//RS use std::process::Command;
//RS 
//RS mod common;
//RS use common::have_rustc;
