//RS /// Card #436: fixed-width ints (`U8`/`I32`), `F32`, a `#Layout(c)` struct
//RS /// passed/returned by value, and a distinct-over-`Int` all round-trip through
//RS /// generated wrappers, link against a real C library, and run — the shapes
//RS /// `Sema::FFI::is_c_abi_type` accepts now all have matching `CModule.rs`
//RS /// codegen (before this card, these fell into codegen's `/* unsupported */
//RS /// ()` placeholder — an I2/I3 bug: sema-accepted, codegen-unlowerable).
//RS #[test]
//RS fn cffi_card436_c_abi_shapes_round_trip() {
//RS     if !have_rustc() {
//RS         eprintln!("note: skipping cffi_card436_c_abi_shapes_round_trip (need rustc)");
