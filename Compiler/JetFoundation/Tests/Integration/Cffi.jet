// Rust: tests/cffi.rs:1
// C FFI integration helpers for real C compiler/linker peer journeys.
use std.fs
use std.process.Command
use jet.FFI.FfiLink
// GATE #4494: native process and filesystem primitives used by fixture providers.
// Rust: tests/cffi.rs:1236
fn build_c_lib(dir: &OSPath) -> (OSPath, String)? {
    cc :: ["cc", "gcc", "clang"].iter().find(fn(c) { Command.new(c).arg("--version").output().is_ok() }) ?? return nil
    c_src :: dir.join("jetc.c")
    fs.write(&c_src, """
#include <stdint.h>
static long long jetc_value = 0;
void jetc_reset(void) { jetc_value = 7; }
long long jetc_value_get(void) { return jetc_value; }
void jetc_store(long long value) { jetc_value = value; }
long long jetc_twice(long long value) { return value * 2; }
long long jetc_add_ints(long long a, long long b) { return a + b; }
double jetc_half(double value) { return value / 2.0; }
double jetc_sum6(double a, double b, double c, double d, double e, double f) { return a + b + c + d + e + f; }
const char *jetc_echo(const char *value) { return value; }
const char *jetc_greeting(void) { return "hi from C"; }
""").unwrap()
    obj :: dir.join("jetc.o")
    ok :: Command.new(cc).args(["-c"]).arg(&c_src).arg("-o").arg(&obj).status().map(fn(s) { s.success() }).unwrap_or(false)
    if !ok { return nil }
    lib :: dir.join("libjetc.a")
    archived :: Command.new("ar").arg("rcs").arg(&lib).arg(&obj).status().map(fn(s) { s.success() }).unwrap_or(false)
    if !archived { return nil }
    Val((dir.to_path_buf(), "jetc"))
}
// Rust: tests/cffi.rs:1286
fn declare_local_c_dep(root: &OSPath, lib: String) -> {
    fs.write(root.join("package.jet"), "name: \"cffi_{lib}\"\nversion: \"0.1.0\"\ndeps: {{ {lib}: c@\"{root.display()}\" }}\n").unwrap()
}
// Rust: tests/cffi.rs:1297
fn build_local_c_provider(root: &OSPath, lib: String, source: String) -> {
    source_path :: root.join("{lib}.c")
    object_path :: root.join("{lib}.o")
    fs.write(&source_path, source).unwrap()
    cc :: ["cc", "gcc", "clang"].iter().find(fn(compiler) { Command.new(compiler).arg("--version").output().is_ok() }).expect("C provider fixture needs a C compiler")
    assert(Command.new(cc).args(["-c"]).arg(&source_path).arg("-o").arg(&object_path).status().unwrap().success())
    assert(Command.new("ar").arg("rcs").arg(root.join("lib{lib}.a")).arg(object_path).status().unwrap().success())
}
// Rust: tests/cffi.rs:1322
fn add_ffi_bridge_args(rustc: &Command, link: &FfiLink) -> {
    rustc.arg("--extern").arg("{link.crate_name}={link.rlib_path.display()}")
    for deps_dir in link.dependency_dirs().filter(fn(dir) { dir.is_dir() }) {
        rustc.arg("-L").arg("dependency={deps_dir.display()}")
    }
}
// Rust: tests/cffi.rs:1647
fn build_c_lib_card436(dir: &OSPath) -> (OSPath, String)? {
    cc :: ["cc", "gcc", "clang"].iter().find(fn(c) { Command.new(c).arg("--version").output().is_ok() }) ?? return nil
    c_src :: dir.join("jetc436.c")
    fs.write(&c_src, """
#include <stdint.h>
uint8_t jetc436_add_u8(uint8_t a, uint8_t b) { return (uint8_t)(a + b); }
int32_t jetc436_add_i32(int32_t a, int32_t b) { return a + b; }
float jetc436_add_f32(float a, float b) { return a + b; }
typedef struct { long long x; long long y; } CPoint;
CPoint jetc436_make_point(long long x, long long y) { CPoint p; p.x = x; p.y = y; return p; }
long long jetc436_point_sum(CPoint p) { return p.x + p.y; }
long long jetc436_scale_meters(long long m) { return m * 2; }
""").unwrap()
    obj :: dir.join("jetc436.o")
    ok :: Command.new(cc).args(["-c"]).arg(&c_src).arg("-o").arg(&obj).status().map(fn(s) { s.success() }).unwrap_or(false)
    if !ok { return nil }
    lib :: dir.join("libjetc436.a")
    archived :: Command.new("ar").arg("rcs").arg(&lib).arg(&obj).status().map(fn(s) { s.success() }).unwrap_or(false)
    if !archived { return nil }
    Val((dir.to_path_buf(), "jetc436"))
}
