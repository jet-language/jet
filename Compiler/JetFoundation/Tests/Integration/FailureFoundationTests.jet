// Rust: tests/failure_foundation.rs:254
#Test("never_contract_rejects_every_reachable_failure_route") {
    cases :: [
        ("explicit propagation", """
fn fail() -> Int { Err("bad") }
fn impossible() -> Int Never! { fail()?("unreachable") }
fn run() -> {}
"""),
        ("implicit direct return", """
fn fail() -> Int { Err("bad") }
fn impossible() -> Int Never! { fail() }
fn run() -> {}
"""),
        ("implicit statement propagation", """
fn fail() -> Int { Err("bad") }
fn impossible() -> Never! { fail() }
fn run() -> {}
"""),
        ("implicit branch propagation", """
fn fail() -> Int { Err("bad") }
fn impossible(value: Bool) -> Int Never! {
    if value { fail() }
    return 7
}
fn run() -> {}
""")
    ]
    scratch :: common.Scratch.new("failure-never")
    path :: scratch.join("failure_never.jet")
    shown :: path.to_string_lossy().into_owned()
    for (case, source) in cases {
        fs.write(&path, source).expect("write !Never fixture")
        diagnostics :: jet.compile_with_path(source, &shown).expect_err("!Never must reject a reachable failure")
        assert(diagnostics.iter().any((diagnostic) -> diagnostic.code == "E2404"), "{case}: expected E2404, got {diagnostics:Debug}")
    }
    empty_path :: scratch.join("failure_never_empty.jet")
    empty_shown :: empty_path.to_string_lossy().into_owned()
    empty_source :: "fn impossible() -> Never! {{}}\nfn run() -> {{}}\n"
    fs.write(&empty_path, empty_source).expect("write empty !Never fixture")
    jet.compile_with_path(empty_source, &empty_shown).expect("a !Never function with no reachable failure can fall through as success")
}
