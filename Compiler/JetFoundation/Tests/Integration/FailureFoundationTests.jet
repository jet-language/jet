// Rust: tests/fuzz_sema.rs:226
#Test("fuzz_sema_rustc_agreement") {
    root :: OSPath.from(env.build("CARGO_MANIFEST_DIR"))
    if !common.have_rustc() { eprintln("note: rustc not found; skipping fuzz_sema"); return }
    seeds :: load_example_seeds(&root)
    assert(seeds.len() >= 2, "expected at least 2 example seeds, found {seeds.len()}")
    seed :: fuzz_seed()
    rng := Rng.new(seed)
    fuzz_dir :: env.temp_dir().join("jet_fuzz_{process.id()}")
    _ :: fs.remove_dir_all(&fuzz_dir)
    fs.create_dir_all(&fuzz_dir).unwrap()
    variants := []
    for i in 0..fuzz_variants() {
        (shown, src) :: rng.pick(&seeds).clone()
        mutated :: mutate_source(&rng, &src, i)
        file :: fuzz_dir.join("variant_{i}.jet")
        fs.write(&file, &mutated).unwrap()
        file_str :: file.to_string_lossy().into_owned()
        variants.push((i, shown, mutated, file_str))
    }
    jobs :: Arc.new(Mutex.new(VecDeque.from(variants)))
    failures :: Arc.new(Mutex.new([String]{}))
    handles := []
    for _ in 0..common.test_worker_count(16) {
        worker_jobs :: Arc.clone(&jobs)
        worker_failures :: Arc.clone(&failures)
        handles.push(thread.spawn(() -> {
            loop {
                job :: worker_jobs.lock().unwrap().pop_front()
                if job == nil { break }
                (i, shown, mutated, file_str) :: job.unwrap()
                result :: panic.catch_unwind(panic.AssertUnwindSafe(() -> check_fuzz_variant(i, &shown, &mutated, &file_str)))
                match result {
                    .Err(payload) -> worker_failures.lock().unwrap().push("variant {i} from {shown}: {common.panic_message(payload)}")
                    .Ok(_) -> {}
                }
            }
        }))
    }
    for handle in handles { handle.join().expect("fuzz worker panicked outside harness") }
    held_failures :: failures.lock().unwrap()
    assert(held_failures.is_empty(), "fuzz sema failures:\n{held_failures.join("\n\n")}")
    _ :: fs.remove_dir_all(&fuzz_dir)
}
// Rust: tests/fuzz_sema.rs:300
#Test("fuzz_sema_i1_unsafe_gate_is_ungated_on_rustc") {
    root :: OSPath.from(env.build("CARGO_MANIFEST_DIR"))
    seeds :: load_example_seeds(&root)
    assert(seeds.len() >= 2, "expected at least 2 example seeds, found {seeds.len()}")
    seed :: fuzz_seed()
    rng := Rng.new(seed)
    violations: [String] = []
    for i in 0..fuzz_variants() {
        (shown, src) :: rng.pick(&seeds).clone()
        mutated :: mutate_source(&rng, &src, i)
        if mutated.contains("#Unsafe") { continue }
        match jet.compile_with_path(&mutated, "fuzz_variant_{i}.jet") {
            .Ok(out) -> {
                if common.strip_vetted_prelude_modules(&out.rust).contains("unsafe") {
                    violations.push("variant {i} from {shown}: source has no #Unsafe but generated code contains `unsafe`")
                }
            }
            .Err(_) -> {}
        }
    }
    assert(violations.is_empty(), "I1 violated in fuzz_sema-generated programs (checked independently of rustc availability):\n{violations.join("\n")}")
}
