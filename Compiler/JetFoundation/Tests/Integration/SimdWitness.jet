use Compiler.JetFoundation.Tests.Integration.Common as common
use core.fs as fs
use core.sys.target
use std.process.Command
use jet
use jet_foundation.MIR.[MirProgram, MirFunction, MirArtifactRequest, MirArtifactTarget, MirArtifactKind, MirArtifactBuildMode]

// GATE #4494 real process/filesystem; #4483 selected target architecture.
// rustc/objdump artifacts below are reference comparators, not runtime bridges.
// Rust: tests/simd_witness.rs:15
SOURCE :: """
fn auto(values: [Float#4]) -> [Float#4] {
    output := [Float#4]{0.0, 0.0, 0.0, 0.0}
    loop i in 0..<4 { output[i] = values[i] * 2.0 + 1.0 }
    return output
}
#Scalar
fn scalar(values: [Float#4]) -> [Float#4] {
    output := [Float#4]{0.0, 0.0, 0.0, 0.0}
    loop i in 0..<4 { output[i] = values[i] * 2.0 + 1.0 }
    return output
}
fn run() {
    values := [Float#4]{1.0, 2.0, 3.0, 4.0}
    loop value in auto(values) { print(value) }
    loop value in scalar(values) { print(value) }
}
"""
// Rust: tests/simd_witness.rs:40
fn lower_checked(source: String) -> MirProgram {
    root :: common.unique_tmp("jet_simd_witness")
    fs.create_dir_all(&root).unwrap()
    fs.write(root.join("package.jet"), "name: \"simd_witness\"\nversion: \"1.0.0\"\n").unwrap()
    entry :: root.join("main.jet")
    fs.write(&entry, source).unwrap()
    bundle := jet.Loader.load_entry(entry.to_str().unwrap()).unwrap()
    errors :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run).into_iter().filter((diagnostic) -> diagnostic.severity == jet.Diagnostics.Severity.Error).collect()
    assert(errors.is_empty(), "{errors:?}")
    request :: MirArtifactRequest.new(MirArtifactTarget.Cranelift, MirArtifactKind.NativeExecutable, MirArtifactBuildMode.Dev)
    jet.Codegen.TIR.lower_checked_mir_program_for(&bundle, request).expect("witness lowers through canonical MIR").0
}
// Rust: tests/simd_witness.rs:66
fn mir_function(program: &MirProgram, name: String) -> &MirFunction {
    program.functions.iter().find((function) -> function.name == name).unwrap_or_else(() -> panic("missing MIR function {name}"))
}
// Rust: tests/simd_witness.rs:77
fn assert_native_simd_artifact(expected: String) -> {
    scratch :: common.Scratch.new("jet_simd_native_artifact")
    source_path :: scratch.join("main.jet")
    fs.write(&source_path, SOURCE).unwrap()
    shown :: source_path.to_string_lossy().into_owned()
    output :: jet.compile_with_path(SOURCE, &shown).expect("SIMD witness must compile for native artifact inspection")
    rust_path :: scratch.join("main.rs")
    binary_path :: scratch.join("main")
    fs.write(&rust_path, &output.rust).unwrap()
    rustc :: Command.new("rustc").args(["--edition", "2021", "-C", "opt-level=3", "-C", "debuginfo=1"]).arg(&rust_path).arg("-o").arg(&binary_path).output().expect("spawn rustc for SIMD native artifact")
    assert(rustc.status.success(), "rustc rejected SIMD witness generated Rust:\n{String.from_utf8_lossy(&rustc.stderr)}")
    run :: Command.new(&binary_path).output().expect("run SIMD native artifact")
    assert_eq(run.status.code(), .Val(0), "SIMD native artifact failed: {String.from_utf8_lossy(&run.stderr)}")
    assert_eq(String.from_utf8_lossy(&run.stdout), expected)
    if target.selected_arch() != "x86" && target.selected_arch() != "x86_64" { return }
    has_objdump :: Command.new("objdump").arg("--version").output().map((output) -> output.status.success()).unwrap_or(false)
    if !has_objdump {
        eprintln("note: skipping SIMD instruction inspection (objdump unavailable)")
        return
    }
    disassembly :: Command.new("objdump").arg("-d").arg(&binary_path).output().expect("inspect SIMD native artifact")
    assert(disassembly.status.success(), "objdump rejected SIMD native artifact:\n{String.from_utf8_lossy(&disassembly.stderr)}")
    text :: String.from_utf8_lossy(&disassembly.stdout).to_ascii_lowercase()
    assert(text.contains("mulpd") || text.contains("vmulpd") || text.contains("addpd") || text.contains("vaddpd"), "eligible SIMD witness must leave packed arithmetic in its binary")
}
// Rust: tests/simd_witness.rs:142
fn assert_web_simd_artifacts_run(expected: String) -> {
    output :: jet.compile_web_with_path(SOURCE, "simd_witness_web.jet").expect("SIMD witness must compile for Web")
    web :: output.web.expect("SIMD witness must produce Web artifacts")
    assert(web.wasm_rust.contains("jet_entry_"), "Web SIMD witness must retain an entry point")
    have_tool :: (name: String) -> Command.new(name).arg("--version").output().map((output) -> output.status.success()).unwrap_or(false)
    have_wasm_target :: Command.new("rustc").args(["--print", "target-libdir", "--target", "wasm32-unknown-unknown"]).output().map((output) -> output.status.success()).unwrap_or(false)
    if !have_tool("rustc") || !have_tool("node") || !have_wasm_target {
        eprintln("note: skipping SIMD Web execution (need rustc, wasm32 target, and node)")
        return
    }
    scratch :: common.Scratch.new("jet_simd_web_artifact")
    fs.write(scratch.join("app.js"), &web.js_app).unwrap()
    fs.write(scratch.join("jet_dom_runtime.js"), &web.dom_runtime).unwrap()
    fs.write(scratch.join("app_wasm.rs"), &web.wasm_rust).unwrap()
    fs.write(scratch.join("package.json"), "{\"type\":\"module\"}").unwrap()
    wasm :: Command.new("rustc").current_dir(&scratch.path).args(["--edition", "2021", "--target", "wasm32-unknown-unknown", "--crate-type", "cdylib", "-O", "app_wasm.rs", "-o", "app.wasm"]).output().expect("spawn Web rustc for SIMD witness")
    assert(wasm.status.success(), "rustc rejected SIMD Web output:\n{String.from_utf8_lossy(&wasm.stderr)}")
    node :: Command.new("node").current_dir(&scratch.path).arg("app.js").output().expect("spawn Web SIMD witness")
    assert(node.status.success(), "Node rejected SIMD Web output: stdout={String.from_utf8_lossy(&node.stdout)} stderr={String.from_utf8_lossy(&node.stderr)}")
    assert_eq(String.from_utf8_lossy(&node.stdout), expected)
}
