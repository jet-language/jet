// Rust: tests/build_sandbox.rs:905
#Test("failed_recipe_preserves_previous_output_and_removes_partial_stage") {
    if target.selected_family() == "unix" {
        _sandbox_guard :: sandbox_test_lock()
        base :: scratch("rollback"); src :: base.join("src"); out :: base.join("out"); cache :: base.join("cache")
        fs.create_dir_all(&src).unwrap(); fs.create_dir_all(&out).unwrap(); fs.write(out.join("old"), "previous").unwrap()
        tools :: ["sh": host_tool("sh")]
        ctx :: BuildContext { source_dir: &src, output_root: &out, tools, fetch_cache: &cache, offline: false }
        recipe :: BuildRecipe { steps: [
            BuildStep.Exec { tool: "sh", args: ["-c", "printf replacement > \"$JET_BUILD_OUTPUT/new\""] },
            BuildStep.Exec { tool: "sh", args: ["-c", "false"] },
        ] }
        error :: Recipe.run(&recipe, &ctx, None).unwrap_err()
        assert_eq(error.code, "E1238")
        assert_eq(fs.read_to_string(out.join("old")).unwrap(), "previous")
        assert(!out.join("new").exists())
        assert(fs.read_dir(&base).unwrap().flatten().all((entry) -> !entry.file_name().to_string_lossy().starts_with(".out.jet-stage-")), "failed recipe left a partial staged output")
        _ :: fs.remove_dir_all(&base).ok()
    }
}
