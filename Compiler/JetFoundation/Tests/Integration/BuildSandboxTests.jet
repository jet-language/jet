// All native test IO/process/env/thread/socket operations: GATE #4494.
// Selected-OS/family dispatch below preserves Rust cfg: GATE #4483.
// Nonblocking socket WouldBlock identity: GATE #4409.
// Capability grant sets use nominal enum keys: GATE #4499.

// Rust: tests/build_sandbox.rs:34
#Test("target_sandbox_manifest_runs") {
    source :: """
name: "mathkit"
version: "0.1.0"
packages: {
    mathkit: sandbox { export: "mathkit" },
}
"""
    facts :: Package.PackageFacts.parse(source, "package.jet").expect("sandbox target manifest should parse")
    assert(if facts.packages[0].targets == { [Package.Target.Plugin { export: Val(name) }] -> name == "mathkit" else -> false })
    (rewritten, count) :: Package.rewrite_retired_targets(&source.replace("sandbox", "plugin"))
    assert_eq(count, 1)
    assert(rewritten.contains("mathkit: sandbox"), "{rewritten}")
}
