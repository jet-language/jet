// Rust: tests/build_sandbox.rs:210
#Test("build_hook_does_not_inherit_host_credentials") {
    if target.selected_family() == "unix" {
        _sandbox_guard :: sandbox_test_lock()
        base :: scratch("clean-env"); src :: base.join("src"); out :: base.join("out"); cache :: base.join("cache")
        fs.create_dir_all(&src).unwrap()
        secret_name :: "JET_TEST_SECRET_DO_NOT_LEAK"
        previous :: std.env.var_os(secret_name); std.env.set_var(secret_name, "sentinel")
        tools :: ["sh": host_tool("sh")]
        ctx :: BuildContext { source_dir: &src, output_root: &out, tools, fetch_cache: &cache, offline: false }
        recipe :: BuildRecipe { steps: [BuildStep.Exec { tool: "sh", args: ["-c", "test \"${{{secret_name}:-}}\" = \"\" && printf clean > \"$JET_BUILD_OUTPUT/clean\""] }] }
        result :: Recipe.run(&recipe, &ctx, None)
        if previous == Val(value) { std.env.set_var(secret_name, value) } else { std.env.remove_var(secret_name) }
        result.unwrap()
        assert_eq(fs.read_to_string(out.join("clean")).unwrap(), "clean")
        _ :: fs.remove_dir_all(&base).ok()
    }
}
// Rust: tests/build_sandbox.rs:253
#Test("native_linux_recipe_sandbox_blocks_host_escape_and_records_backend_receipt") {
    if target.selected_os() == "linux" {
        _sandbox_guard :: sandbox_test_lock()
        base :: scratch("native-linux"); src :: base.join("src"); out :: base.join("out"); cache :: base.join("cache")
        host_marker :: base.with_file_name("{base.file_name().unwrap().to_string_lossy()}-host-escape")
        fs.create_dir_all(&src).unwrap(); fs.write(src.join("input"), "source").unwrap()
        tools :: ["sh": host_tool("sh")]
        ctx :: BuildContext { source_dir: &src, output_root: &out, tools, fetch_cache: &cache, offline: false }
        recipe :: BuildRecipe { steps: [BuildStep.Exec { tool: "sh", args: ["-c", "test ! -e /etc/passwd && if printf hostile > '{host_marker.display()}'; then exit 41; fi && if printf hostile > input; then exit 42; fi && printf ok > \"$JET_BUILD_OUTPUT/ok\""] }] }
        report :: Recipe.run(&recipe, &ctx, None).expect("native Linux sandbox should run recipe")
        assert_eq(report.sandbox_class, "linux-bwrap")
        assert(report.sandbox_policy.contains("filesystem=source-readonly,output-private-copy"))
        assert(report.sandbox_policy.contains("process=private-pid,parent-death"))
        assert(report.sandbox_policy.contains("network=isolated"))
        assert_eq(fs.read_to_string(out.join("ok")).unwrap(), "ok")
        assert(!host_marker.exists(), "recipe wrote through to the host filesystem")
        assert_eq(fs.read_to_string(src.join("input")).unwrap(), "source")
        _ :: fs.remove_dir_all(&base).ok()
    }
}
// Rust: tests/build_sandbox.rs:311
#Test("logged_recipe_sandbox_blocks_host_escape") {
    if target.selected_os() == "linux" {
        _sandbox_guard :: sandbox_test_lock()
        base :: scratch("logged-native-linux"); src :: base.join("src"); out :: base.join("out"); cache :: base.join("cache")
        host_marker :: base.with_file_name("{base.file_name().unwrap().to_string_lossy()}-logged-host-escape")
        fs.create_dir_all(&src).unwrap()
        tools :: ["sh": host_tool("sh")]
        ctx :: BuildContext { source_dir: &src, output_root: &out, tools, fetch_cache: &cache, offline: false }
        recipe :: BuildRecipe { steps: [BuildStep.Exec { tool: "sh", args: ["-c", "if printf hostile > '{host_marker.display()}'; then exit 41; fi && printf ok > \"$JET_BUILD_OUTPUT/ok\""] }] }
        attempt := BuildDebug.Attempt.new("logged-sandbox", "logged-sandbox", "test", "recipe", "source")
        result :: Recipe.run_logged(&recipe, &ctx, None, &attempt)
        status :: Build.native_sandbox_status()
        if status.available {
            report :: result.expect("logged recipe sandbox should run")
            assert_eq(report.sandbox_class, "linux-bwrap")
            assert_eq(fs.read_to_string(out.join("ok")).unwrap(), "ok")
        } else { assert_eq(result.unwrap_err().code, "E1275") }
        assert(!host_marker.exists(), "logged recipe execution escaped its native sandbox")
        _ :: fs.remove_dir_all(&base).ok()
    }
}
// Rust: tests/build_sandbox.rs:377
#Test("native_windows_appcontainer_allows_declared_output_and_records_receipt") {
    if target.selected_os() == "windows" {
        _sandbox_guard :: sandbox_test_lock()
        base :: scratch("native-windows-output"); src :: base.join("src"); out :: base.join("out"); cache :: base.join("cache")
        fs.create_dir_all(&src).unwrap(); fs.write(src.join("input"), "source").unwrap()
        secret_name :: "JET_WINDOWS_HOST_SECRET"
        previous_secret :: std.env.var_os(secret_name); std.env.set_var(secret_name, "must-not-enter-appcontainer")
        tools :: ["cmd": windows_command_interpreter()]
        ctx :: BuildContext { source_dir: &src, output_root: &out, tools, fetch_cache: &cache, offline: false }
        recipe :: BuildRecipe { steps: [BuildStep.Exec { tool: "cmd", args: ["/C", "if defined JET_WINDOWS_HOST_SECRET (exit /b 13) else type \"%CD%\\input\" > \"%JET_BUILD_OUTPUT%\\ok\""] }] }
        result :: Recipe.run(&recipe, &ctx, None)
        if previous_secret == Val(value) { std.env.set_var(secret_name, value) } else { std.env.remove_var(secret_name) }
        report :: result.expect("AppContainer build should run")
        assert_eq(report.sandbox_class, "windows-appcontainer")
        assert(report.sandbox_policy.contains("source-readonly,output-readwrite"))
        for policy in ["process=appcontainer+job-kill-on-close+active-process=256", "network=denied", "environment=clear+declared", "devices=appcontainer-default-deny", "resources=memory-2GiB+active-process-256"] { assert(report.sandbox_policy.contains(policy), "{policy}") }
        text := fs.read_to_string(out.join("ok")).unwrap().trim() // #4303
        assert_eq(text, "source")
        _ :: fs.remove_dir_all(&base).ok()
    }
}
// Rust: tests/build_sandbox.rs:437
#Test("native_windows_appcontainer_hermetic_build_allows_declared_output") {
    if target.selected_os() == "windows" {
        _sandbox_guard :: sandbox_test_lock()
        base :: scratch("windows-hermetic-success"); marker :: base.join("host-marker")
        command :: "echo escaped>\"{marker.display()}\" || echo blocked>status & if exist \"{marker.display()}\" (exit /b 70) else echo ok>status"
        context := Build.BuildContext.new()
        action :: context.action("windows-hermetic-success", ActionSpec.uncached_phony([windows_command_interpreter().to_string_lossy().to_string(), "/C", command]).with_outputs(["status"]).with_cap(BuildCapability.Exec)).expect("hermetic Windows action should register")
        target :: context.add_executable("windows-hermetic-success", TargetSpec.new().with_action(action)).expect("hermetic Windows target should register")
        plan :: context.plan_with_default(target).expect("hermetic Windows plan should validate")
        artifact_store :: BuildArtifactStoreHandle.at(base.join(".jet-store")).expect("open test artifact store")
        grants :: Set.from([BuildCapability.Exec])
        result :: execute_build_plan(&plan, &base, &artifact_store, &grants).expect("AppContainer hermetic build should complete")
        assert_eq(result.report.metrics.actions_total, 1); assert_eq(result.report.metrics.failed_actions, 0)
        text := fs.read_to_string(base.join("status")).unwrap().trim() // #4303
        assert_eq(text, "ok")
        assert(!marker.exists(), "hermetic build wrote outside its output")
        _ :: fs.remove_dir_all(&base).ok()
    }
}
