// Rust: tests/build_sandbox.rs:665
#Test("native_windows_appcontainer_uses_the_shared_hostile_corpus") {
    if target.selected_os() == "windows" {
        _sandbox_guard :: sandbox_test_lock()
        cases :: hostile_cases()
        for (case_id, _category, _attempt, _expected) in cases {
            base :: scratch("windows-hostile-{case_id}"); src :: base.join("src"); out :: base.join("out"); cache :: base.join("cache")
            host_secret :: base.join("host-secret"); host_marker :: base.join("host-marker")
            fs.create_dir_all(&src).unwrap(); fs.write(&host_secret, "host-only-secret").unwrap()
            if case_id == "source-symlink" { std.os.windows.fs.symlink_file(&host_secret, src.join("link")).expect("Windows hostile corpus needs symlink creation to test the source boundary") }
            network_thread := None
            (tool, args) :: if case_id == {
                "host-read" -> (windows_command_interpreter(), ["/C", "copy /Y \"{host_secret.display()}\" \"{host_marker.display()}\" >NUL 2>&1 && exit /b 70 || echo blocked>\"%JET_BUILD_OUTPUT%\\status\""])
                "host-write" -> (windows_command_interpreter(), ["/C", "echo escaped>\"{host_marker.display()}\""])
                "source-symlink" -> (windows_command_interpreter(), ["/C", "if exist \"%CD%\\link\" (copy /Y \"%CD%\\link\" \"%JET_BUILD_OUTPUT%\\leak\" >NUL 2>&1 && exit /b 70) else echo blocked>\"%JET_BUILD_OUTPUT%\\status\""])
                "output-symlink" -> (windows_command_interpreter(), ["/C", "mklink \"%JET_BUILD_OUTPUT%\\link\" \"{host_marker.display()}\" >NUL 2>&1 && echo escaped>\"%JET_BUILD_OUTPUT%\\link\" || echo blocked>\"%JET_BUILD_OUTPUT%\\status\""])
                "network-exfiltration" -> {
                    listener :: TcpListener.bind("127.0.0.1:0").unwrap(); listener.set_nonblocking(true).unwrap()
                    port :: listener.local_addr().unwrap().port()
                    network_thread = Val(thread.spawn(() -> {
                        deadline :: Instant.now() + Duration.from_millis(750)
                        loop {
                            if listener.accept() == {
                                .Ok((_stream, _address)) -> return true
                                .Err(error) -> {
                                    if error.kind() != ErrorKind.WouldBlock { return false }
                                    if Instant.now() >= deadline { return false }
                                    thread.sleep(Duration.from_millis(5))
                                }
                            }
                        }
                    }))
                    powershell :: OSPath(std.env.var_os("WINDIR").unwrap_or_else(() -> "C:\\Windows")).join("System32").join("WindowsPowerShell").join("v1.0").join("powershell.exe")
                    (powershell, ["-NoProfile", "-NonInteractive", "-Command", "try {$c=New-Object Net.Sockets.TcpClient('127.0.0.1',{port});$c.Close();exit 70} catch {exit 0}"])
                }
                "child-process" -> {
                    interpreter :: windows_command_interpreter()
                    (interpreter.clone(), ["/C", "start \"\" /b \"{interpreter.display()}\" /C \"echo escaped>\\\"{host_marker.display()}\\\"\""])
                }
                "tmpfs-exhaustion" -> {
                    interpreter :: windows_command_interpreter()
                    (interpreter.clone(), ["/C", "for /L %i in (1,1,300) do @start \"\" /b \"{interpreter.display()}\" /C \"timeout /T 3 /NOBREAK >NUL\" & echo blocked>\"%JET_BUILD_OUTPUT%\\status\""])
                }
                other -> panic("unmapped hostile corpus case {other}")
            }
            tools :: ["hostile-tool": tool]
            ctx :: BuildContext { source_dir: &src, output_root: &out, tools, fetch_cache: &cache, offline: false }
            recipe :: BuildRecipe { steps: [BuildStep.Exec { tool: "hostile-tool", args }] }
            result :: Recipe.run(&recipe, &ctx, None)
            if result.as_ref().err() == Val(error) { assert(["E1237", "E1238", "E1275"].contains(error.code), "{case_id} returned an unrelated diagnostic: {error.code}") }
            if result == .Ok(report) {
                assert_eq(report.sandbox_class, "windows-appcontainer")
                for policy in ["filesystem=", "process=", "network=", "environment=", "devices=", "resources="] { assert(report.sandbox_policy.contains(policy), "{case_id}: {policy}") }
            }
            if network_thread == Val(worker) { assert(!worker.join().unwrap(), "{case_id} reached the network") }
            if case_id == "source-symlink" { assert(!out.join("leak").exists(), "{case_id} exposed the host file through declared output") }
            if case_id == "child-process" { thread.sleep(Duration.from_millis(100)) }
            assert(!host_marker.exists(), "{case_id} wrote the host marker")
            _ :: fs.remove_dir_all(&base).ok()
        }
    }
}
