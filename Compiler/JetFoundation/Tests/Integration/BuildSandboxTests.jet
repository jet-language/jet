// Rust: tests/build_sandbox.rs:1171
#Test("shared_hostile_corpus_uses_the_recipe_production_path") {
    if target.selected_family() == "unix" {
        _sandbox_guard :: sandbox_test_lock()
        cases :: hostile_cases()
        sandbox_shell :: std.env.split_paths(&std.env.var_os("PATH").expect("PATH should be available to sandbox tests")).map((directory) -> directory.join("bash")).find((candidate) -> candidate.is_file()).or_else(() -> {
            std.env.split_paths(&std.env.var_os("PATH").expect("PATH should be available to sandbox tests")).map((directory) -> directory.join("sh")).find((candidate) -> candidate.is_file())
        }).expect("a shell is required for the hostile corpus")
        for (case_id, _category, _attempt, expected) in cases {
            base :: scratch("hostile-{case_id}"); src :: base.join("src"); out :: base.join("out"); cache :: base.join("cache")
            host_secret :: base.join("host-secret"); host_marker :: base.join("host-marker")
            fill_path :: OSPath("/tmp/jet-build-hostile-fill-{std.process.id()}-{case_id}")
            fs.create_dir_all(&src).unwrap(); fs.write(&host_secret, "host-only-secret").unwrap()
            if case_id == "source-symlink" { std.os.unix.fs.symlink(&host_secret, src.join("link")).unwrap() }
            network_thread := None
            command :: if case_id == {
                "host-read" -> "if [ -r {shell_quote(&host_secret)} ]; then printf leaked > \"$JET_BUILD_OUTPUT/status\"; exit 70; else printf blocked > \"$JET_BUILD_OUTPUT/status\"; fi"
                "host-write" -> "if printf escaped > {shell_quote(&host_marker)}; then printf escaped > \"$JET_BUILD_OUTPUT/status\"; exit 70; else printf blocked > \"$JET_BUILD_OUTPUT/status\"; fi"
                "source-symlink" -> "if [ -r \"$PWD/link\" ]; then printf leaked > \"$JET_BUILD_OUTPUT/status\"; exit 70; else printf blocked > \"$JET_BUILD_OUTPUT/status\"; fi"
                "output-symlink" -> "if {shell_quote(&host_tool("ln"))} -s {shell_quote(&host_marker)} \"$JET_BUILD_OUTPUT/link\" && printf escaped > \"$JET_BUILD_OUTPUT/link\"; then printf escaped > \"$JET_BUILD_OUTPUT/status\"; else printf blocked > \"$JET_BUILD_OUTPUT/status\"; fi"
                "network-exfiltration" -> {
                    listener :: TcpListener.bind("127.0.0.1:0").unwrap()
                    listener.set_nonblocking(true).expect("test listener should accept nonblocking mode")
                    port :: listener.local_addr().unwrap().port()
                    network_thread = Val(thread.spawn(() -> {
                        deadline :: Instant.now() + Duration.from_millis(500)
                        loop {
                            if listener.accept() == {
                                .Ok((stream, _)) -> {
                                    stream := ^stream
                                    bytes := [U8]{}
                                    _ :: stream.read_to_end(&bytes)
                                    return bytes == "escaped".as_bytes()
                                }
                                .Err(error) -> {
                                    if error.kind() != ErrorKind.WouldBlock { return false }
                                    if Instant.now() >= deadline { return false }
                                    thread.sleep(Duration.from_millis(5))
                                }
                            }
                        }
                    }))
                    "if printf escaped > /dev/tcp/127.0.0.1/{port} 2>/dev/null; then printf leaked > \"$JET_BUILD_OUTPUT/status\"; exit 70; else printf blocked > \"$JET_BUILD_OUTPUT/status\"; fi"
                }
                "child-process" -> "(printf escaped > {shell_quote(&host_marker)}) & child=$!; wait \"$child\"; if [ -e {shell_quote(&host_marker)} ]; then printf escaped > \"$JET_BUILD_OUTPUT/status\"; else printf blocked > \"$JET_BUILD_OUTPUT/status\"; fi"
                "tmpfs-exhaustion" -> "i=0; while [ \"$i\" -lt 1025 ]; do if ! printf '%65536s' x >> {shell_quote(&fill_path)}; then printf blocked > \"$JET_BUILD_OUTPUT/status\"; break; fi; i=$((i + 1)); done; if [ \"$i\" -ge 1025 ]; then printf escaped > \"$JET_BUILD_OUTPUT/status\"; else printf blocked > \"$JET_BUILD_OUTPUT/status\"; fi"
                other -> panic("unmapped hostile corpus case {other}")
            }
            tools :: ["sh": sandbox_shell.clone()]
            ctx :: BuildContext { source_dir: &src, output_root: &out, tools, fetch_cache: &cache, offline: false }
            recipe :: BuildRecipe { steps: [BuildStep.Exec { tool: "sh", args: ["-c", ^command] }] }
            result :: Recipe.run(&recipe, &ctx, None)
            if result == {
                .Ok(report) -> {
                    assert_ne(report.sandbox_class, "non-executing")
                    assert(report.sandbox_policy.contains("filesystem="))
                    assert(report.sandbox_policy.contains("process="))
                    assert(report.sandbox_policy.contains("network="))
                    assert(report.sandbox_policy.contains("environment="))
                    assert(report.sandbox_policy.contains("devices="))
                    assert(report.sandbox_policy.contains("resources="))
                    status := fs.read_to_string(out.join("status")).unwrap().trim() // #4303
                    assert_eq(status, "blocked", "{case_id} corpus result must prove the attempt was blocked")
                }
                .Err(error) -> assert(["E1237", "E1275"].contains(error.code), "{case_id} returned an executable failure instead of blocked/unsupported: {error.code}")
            }
            if case_id == "child-process" { thread.sleep(Duration.from_millis(100)) }
            assert(!host_marker.exists(), "{case_id} escaped the sandbox and wrote the host marker")
            if network_thread == Val(worker) { assert(!worker.join().unwrap(), "{case_id} escaped the network namespace") }
            if fs.read_to_string(out.join("status")) == .Ok(status) { assert_ne(status, "leaked"); assert_ne(status, "escaped") }
            _ :: fs.remove_file(&fill_path).ok(); _ :: fs.remove_dir_all(&base).ok()
            assert_eq(expected, "blocked-or-unsupported")
        }
    }
}
// Rust: tests/build_sandbox.rs:1326
#Test("shared_hostile_corpus_uses_agent_executor_production_path") {
    if target.selected_family() == "unix" {
        _sandbox_guard :: sandbox_test_lock()
        cases :: hostile_cases()
        base :: scratch("agent-hostile")
        host_secret :: base.with_file_name("build-sandbox-agent-hostile-secret"); host_marker :: base.with_file_name("build-sandbox-agent-hostile-marker")
        fs.write(&host_secret, "host-only-secret").unwrap()
        source_link :: base.join("link"); std.os.unix.fs.symlink(&host_secret, &source_link).unwrap()
        agent_fill_path :: "/tmp/jet-agent-hostile-fill-{std.process.id()}"
        base_literal :: jet_string_literal(&base.to_string_lossy())
        network_thread := None
        commands :: cases.iter().map(((case_id, _, _, _)) -> {
            command :: if case_id == {
                "host-read" -> "if test -r {shell_quote(&host_secret)}; then printf escaped; else printf blocked; fi"
                "host-write" -> "if printf escaped > {shell_quote(&host_marker)}; then printf escaped; else printf blocked; fi"
                "source-symlink" -> "if test -r \"$PWD/link\"; then printf escaped; else printf blocked; fi"
                "output-symlink" -> "if {shell_quote(&host_tool("ln"))} -s {shell_quote(&host_marker)} \"$JET_BUILD_OUTPUT/link\" && printf escaped > \"$JET_BUILD_OUTPUT/link\"; then printf escaped; else printf blocked; fi"
                "network-exfiltration" -> {
                    listener :: TcpListener.bind("127.0.0.1:0").unwrap(); listener.set_nonblocking(true).unwrap()
                    port :: listener.local_addr().unwrap().port()
                    network_thread = Val(thread.spawn(() -> {
                        deadline :: Instant.now() + Duration.from_millis(750)
                        loop {
                            if listener.accept() == {
                                .Ok(_) -> return true
                                .Err(error) -> {
                                    if error.kind() != ErrorKind.WouldBlock { return false }
                                    if Instant.now() >= deadline { return false }
                                    thread.sleep(Duration.from_millis(5))
                                }
                            }
                        }
                    }))
                    "if printf escaped > /dev/tcp/127.0.0.1/{port} 2>/dev/null; then printf escaped; else printf blocked; fi"
                }
                "child-process" -> "(printf escaped > {shell_quote(&host_marker)}) & printf blocked"
                "tmpfs-exhaustion" -> "i=0; while [ \"$i\" -lt 1025 ]; do if ! printf '%65536s' x >> {shell_quote(&OSPath(agent_fill_path))}; then printf blocked; exit 0; fi; i=$((i + 1)); done; printf escaped"
                other -> panic("unmapped hostile corpus case {other}")
            }
            (case_id, command)
        }).collect()
        source := String.from("use core.process as process\n\nfn run() {\n    policy :: process.workspace()\n")
        for (index, (case_id, command)) in commands.iter().enumerate() {
            source.push_str("    print({jet_string_literal(case_id)})\n    if process.cmd([\"bash\", \"-c\", {jet_string_literal(command)}]).cwd({base_literal}).under(policy).run_checked() == {\n        .Ok(value) -> print(value.output)\n        .Err(_) -> print(\"unsupported\")\n    }\n")
        }
        source.push_str("}\n")
        source_path :: base.join("agent-hostile.jet"); fs.write(&source_path, source).unwrap()
        output :: Command.new(common.jet_bin()).args(["run", "--release"]).arg(&source_path).current_dir(&base).output().expect("agent executor should launch through the public CLI")
        assert(output.status.success(), "agent hostile corpus failed: stdout={String.from_utf8_lossy(&output.stdout)} stderr={String.from_utf8_lossy(&output.stderr)}")
        stdout :: String.from_utf8_lossy(&output.stdout); lines :: stdout.lines().collect()
        assert_eq(lines.len(), cases.len() * 2, "agent corpus output lost a row")
        capability :: RuntimePolicy.detect_sandbox()
        expected :: if capability.level == RuntimePolicy.SandboxLevel.Strong { "blocked" } else { "unsupported" }
        for (index, (case_id, _, _, _)) in cases.iter().enumerate() {
            assert_eq(lines[index * 2], case_id)
            assert_eq(lines[index * 2 + 1], expected, "{case_id} result")
        }
        if network_thread == Val(worker) { assert(!worker.join().unwrap(), "agent corpus reached the network") }
        thread.sleep(Duration.from_millis(100))
        assert_eq(fs.read_to_string(&host_secret).unwrap(), "host-only-secret", "agent corpus modified the host secret")
        assert(!host_marker.exists(), "agent corpus wrote the host marker")
        _ :: fs.remove_file(&agent_fill_path).ok(); _ :: fs.remove_dir_all(&base).ok()
        _ :: fs.remove_file(&host_secret).ok(); _ :: fs.remove_file(&host_marker).ok()
    }
}
// Rust: tests/build_sandbox.rs:1497
#Test("core_cargo_build_refuses_before_unavailable_sandbox_can_run_build_script") {
    _sandbox_guard :: sandbox_test_lock()
    base :: scratch("core-cargo-unavailable"); repo :: base.join("repo"); root :: base.join("root"); marker :: base.join("host-marker")
    fs.create_dir_all(&repo).unwrap()
    fs.write(repo.join("package.jet"), "name: \"escape\"\nversion: \"0.1.0\"\npackages: { escape: library }\n").unwrap()
    fs.write(repo.join("lib.rs"), "pub fn value() -> u8 { 1 }\n").unwrap()
    fs.write(repo.join("Cargo.toml"), "[package]\nname = \"escape\"\nversion = \"0.1.0\"\nbuild = \"build.rs\"\n[lib]\npath = \"lib.rs\"\n").unwrap()
    fs.write(repo.join("Cargo.lock"), "# This file is automatically @generated by Cargo.\nversion = 3\n\n[[package]]\nname = \"escape\"\nversion = \"0.1.0\"\n\n").unwrap()
    fs.write(repo.join("build.rs"), "fn main() { let _ = std::fs::write({marker.to_string_lossy():?}, \"escaped\"); }\n").unwrap()
    table :: RefSpec.SourceTable.from_decls([("mine", "path:{repo.display()}", RefSpec.ProviderKind.Core)])
    spec :: RefSpec.classify_in("escape@mine", &table).unwrap()
    roots :: Store.Roots.at(root.clone()); store :: roots.hangar_dir()
    ctx :: Provider.Ctx { fixtures: None, store_dir: &store, offline: false, project_dir: None, nix_index: None, nix_roots: None, allow_local_nix_catalog: false }
    previous :: std.env.var_os("JETPACK_FAKE_SANDBOX"); std.env.set_var("JETPACK_FAKE_SANDBOX", "unavailable")
    result :: Store.realize_verified(&roots, &ctx, Store.RealizeRequest.Package { spec: &spec, table: &table })
    if previous == Val(value) { std.env.set_var("JETPACK_FAKE_SANDBOX", value) } else { std.env.remove_var("JETPACK_FAKE_SANDBOX") }
    error :: if result == {
        .Ok(_) -> panic("an unavailable build sandbox must refuse Core Cargo")
        .Err(error) -> error
    }
    assert("{error:?}".contains("SandboxUnavailable"), "{error:?}")
    assert(!marker.exists(), "Cargo build.rs ran without the sandbox")
    assert(Store.list(&roots).is_empty())
    _ :: fs.remove_dir_all(base).ok()
}
// Rust: tests/build_sandbox.rs:1573
#Test("core_cargo_build_is_private_and_not_published_to_shared_cache") {
    if target.selected_os() == "linux" {
        _sandbox_guard :: sandbox_test_lock()
        base :: scratch("core-cargo-private"); repo :: base.join("repo"); root :: base.join("root"); mirror :: base.join("mirror")
        fs.create_dir_all(&repo).unwrap(); fs.create_dir_all(&mirror).unwrap()
        fs.write(repo.join("package.jet"), "name: \"private\"\nversion: \"0.1.0\"\npackages: { private: library }\n").unwrap()
        fs.write(repo.join("lib.rs"), "pub fn value() -> u8 { 1 }\n").unwrap()
        fs.write(repo.join("Cargo.toml"), "[package]\nname = \"private\"\nversion = \"0.1.0\"\n[lib]\npath = \"lib.rs\"\n").unwrap()
        fs.write(repo.join("Cargo.lock"), "# This file is automatically @generated by Cargo.\nversion = 3\n\n[[package]]\nname = \"private\"\nversion = \"0.1.0\"\n\n").unwrap()
        table :: RefSpec.SourceTable.from_decls([("mine", "path:{repo.display()}", RefSpec.ProviderKind.Core)])
        spec :: RefSpec.classify_in("private@mine", &table).unwrap()
        roots :: Store.Roots.at(root.clone())
        Store.bind_cache(&roots, "public", [mirror.display().to_string()], None, None, true).unwrap()
        store :: roots.hangar_dir()
        ctx :: Provider.Ctx { fixtures: None, store_dir: &store, offline: false, project_dir: None, nix_index: None, nix_roots: None, allow_local_nix_catalog: false }
        realized :: Store.realize_verified(&roots, &ctx, Store.RealizeRequest.Package { spec: &spec, table: &table }).expect("native Core Cargo build should produce a private lease")
        assert_eq(realized.source_state(), Provider.SourceState.Built)
        assert_eq(realized.consumption_status(), &Store.ConsumptionStatus.Consumable)
        producer :: Store.ProducerRecord.decode(&realized.metadata().producer_record).unwrap()
        assert_eq(producer.facts.get("build.trust").map((value) -> value.as_str()), Val("private-untrusted"))
        assert_eq(producer.plan.facts().get("build.trust").map((value) -> value.as_str()), Val("private-untrusted"))
        assert(fs.read_dir(&mirror).unwrap().flatten().all((item) -> item.path().extension().and_then((ext) -> ext.to_str()) != Val("narinfo")))
        drop(^realized)
        _ :: fs.remove_dir_all(base).ok()
    }
}
