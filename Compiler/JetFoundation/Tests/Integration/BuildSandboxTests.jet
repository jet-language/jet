#Test("unavailable_macos_backend_refuses_before_recipe_tool_launch") {
    if target.selected_os() == "macos" {
        _sandbox_guard :: sandbox_test_lock()
        base :: scratch("macos-unavailable"); src :: base.join("src"); out :: base.join("out"); cache :: base.join("cache"); marker :: base.join("host-marker")
        fs.create_dir_all(&src).unwrap()
        previous :: std.env.var_os("JETPACK_FAKE_SANDBOX"); std.env.set_var("JETPACK_FAKE_SANDBOX", "unavailable")
        tools :: ["bash": OSPath("/bin/bash")]
        ctx :: BuildContext { source_dir: &src, output_root: &out, tools, fetch_cache: &cache, offline: false }
        recipe :: BuildRecipe { steps: [BuildStep.Exec { tool: "bash", args: ["-c", "printf launched > '{marker.display()}'"] }] }
        result :: Recipe.run(&recipe, &ctx, None)
        if previous == Val(value) { std.env.set_var("JETPACK_FAKE_SANDBOX", value) } else { std.env.remove_var("JETPACK_FAKE_SANDBOX") }
        error :: result.expect_err("an unavailable macOS backend must fail closed")
        assert_eq(error.code, "E1275")
        assert(!marker.exists(), "recipe tool launched without Seatbelt")
        assert(!out.join("marker").exists())
        _ :: fs.remove_dir_all(&base).ok()
    }
}
