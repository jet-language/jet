#Test("native_windows_appcontainer_hermetic_build_rejects_host_write") {
    if target.selected_os() == "windows" {
        _sandbox_guard :: sandbox_test_lock()
        assert_eq(RuntimePolicy.detect_sandbox().level, RuntimePolicy.SandboxLevel.Strong, "Windows hermetic test requires the native AppContainer backend")
        base :: scratch("windows-hermetic-failure"); marker :: base.join("host-marker")
        context := Build.BuildContext.new()
        action :: context.action("windows-hermetic-failure", ActionSpec.uncached_phony([windows_command_interpreter().to_string_lossy().to_string(), "/C", "echo escaped>\"{marker.display()}\" && exit /b 70"]).with_cap(BuildCapability.Exec)).expect("hermetic Windows action should register")
        target :: context.add_executable("windows-hermetic-failure", TargetSpec.new().with_action(action)).expect("hermetic Windows target should register")
        plan :: context.plan_with_default(target).expect("hermetic Windows plan should validate")
        grants :: Set.from([BuildCapability.Exec])
        artifact_store :: BuildArtifactStoreHandle.at(base.join(".jet-store")).expect("open test artifact store")
        result :: execute_build_plan(&plan, &base, &artifact_store, &grants)
        assert(result.is_err(), "host write must fail the hermetic action")
        assert(!marker.exists(), "hermetic build wrote outside its output")
        _ :: fs.remove_dir_all(&base).ok()
    }
}
// Rust: tests/build_sandbox.rs:527
#Test("native_windows_appcontainer_rejects_reparse_parent_before_launch") {
    if target.selected_os() == "windows" {
        _sandbox_guard :: sandbox_test_lock()
        assert_eq(RuntimePolicy.detect_sandbox().level, RuntimePolicy.SandboxLevel.Strong, "Windows reparse-point test requires the native AppContainer backend")
        base :: scratch("windows-reparse-parent"); real :: base.join("real"); linked :: base.join("linked")
        source :: real.join("source"); output :: real.join("output"); marker :: base.join("launched")
        fs.create_dir_all(&source).unwrap(); fs.create_dir_all(&output).unwrap()
        std.os.windows.fs.symlink_dir(&real, &linked).expect("Windows reparse-point test needs a directory link")
        command :: "echo launched>\"{marker.display()}\" & if exist \"{marker.display()}\" (exit /b 70) else exit /b 0"
        result :: Build.run_native_sandboxed(&windows_command_interpreter(), ["/C", command], &linked.join("source"), Val(&linked.join("output")), &[String:String]{}, false)
        assert(result.is_err(), "a reparse-point parent must be rejected before launch: {result:?}")
        assert(!marker.exists(), "reparse-point rejection launched the tool")
        _ :: fs.remove_dir_all(&base).ok()
    }
}
