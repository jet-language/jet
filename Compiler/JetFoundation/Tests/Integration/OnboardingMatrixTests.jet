// Rust: tests/policy_scope.rs:146
#Test("package_gc_policy_applies_once_across_imported_modules") {
    path :: OSPath.from(env("CARGO_MANIFEST_DIR")).join("tests/fixtures/policy_gc_multimodule/run.jet")
    bundle := jet.Loader.load_entry(path.to_str().unwrap()).unwrap()
    diagnostics :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run)
    assert(!diagnostics.iter().any(|d| d.code == "E0355"))
    function :: bundle.modules[0].items.iter().find_map(|item| match item {
        jet.AST.Item.Func(function) if function.name == "run" -> Some(function)
        _ -> None
    }).unwrap()
    assert(function.gc_scope)
    assert(match function.body.first() {
        Some(jet.AST.Stmt.Val(binding)) -> binding.gc_promotion.is_some()
        _ -> false
    })
}
