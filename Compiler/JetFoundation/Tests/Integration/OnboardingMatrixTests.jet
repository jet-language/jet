// Rust: tests/onboarding_matrix.rs:39
#Test("terminal_editor_state_matrix") {
    // FEATURE_CLAIM: claim.tooling-cli / cli-terminal-matrix
    guide :: A.read("Docs/spec/guides/first-hour.md")
    loop state in ["## Terminal and editor state matrix", "| Install ready |", "| Scaffolded |", "| Valid edit |", "| Invalid edit |", "| Missing entry |", "| Ambiguous project |", "| Legacy layout |", "| Offline or unsupported host |", "| Learn next |"] {
        assert(guide.contains(state), "first-hour matrix lost state {state}")
    }
    assert(guide.contains("jet ?") && guide.contains("jet ? run"))
    assert(guide.contains("jet check run.jet") && guide.contains("jet test run.jet"))
    example :: A.read("Examples/features/basics/first_hour.jet")
    assert(example.contains("First-hour tour"))
    assert(A.root().join("Examples/features/expected/basics/first_hour.out").is_file())
    assert(A.read("tests/golden.rs").contains("Examples/features"))
    vscode :: A.read("Tools/editors/vscode/extension.js")
    assert(vscode.contains("[\"run\", file]") && vscode.contains("[\"test\", file]"), "VS Code code lenses must invoke the production jet binary")
    loop docs in ["Tools/editors/vscode/README.md", "Tools/editors/zed/README.md"] {
        editor_docs :: A.read(docs)
        assert(editor_docs.contains("run/test code lenses") || (editor_docs.contains("Run File") && editor_docs.contains("Test File")), "editor docs lost the run/test entry path: {docs}")
    }
    lsp :: A.read("tests/lsp.rs")
    assert(lsp.contains("fn lsp_document_links_and_code_lenses()") && lsp.contains("jet.runFile") && lsp.contains("jet.testFile"), "LSP editor acceptance must keep both code lenses")
    terminal_matrix :: A.read("tests/help_pty.rs")
    loop proof in ["fn enter_expands_then_guides_without_hooks_instead_of_pasting()", "fn shell_prefill_mode_keeps_palette_on_tty_while_stdout_is_captured()", "fn explicit_color_law_reaches_interactive_renderer()", "fn live_narrow_resize_uses_actual_terminal_size()"] {
        assert(terminal_matrix.contains(proof), "PTY matrix lost {proof}")
    }
    root :: Common.Scratch.new("onboarding-state-matrix")
    created :: A.jet(&["new", "hello"], &root.path)
    assert(created.status.success(), "jet new failed:\n{A.stderr(&created)}")
    project :: root.join("hello")
    loop file in ["package.jet", "run.jet", ".gitignore"] { assert(project.join(file).is_file(), "scaffold is missing {file}") }
    palette :: A.jet(&["?", "--color=never"], &project)
    assert(palette.status.success(), "non-TTY help failed:\n{A.stderr(&palette)}")
    assert(A.stdout(&palette).contains("Build & Run"))
    assert(!A.stdout(&palette).contains('\u{1b}'), "NO_COLOR leaked into help")
    search :: A.jet(&["?", "run", "--color=never"], &project)
    assert(search.status.success(), "non-TTY help search failed:\n{A.stderr(&search)}")
    assert(A.stdout(&search).contains("jet run"))
    assert(!A.stdout(&search).contains('\u{1b}'), "NO_COLOR leaked into search")
    first_run :: A.jet(&["run"], &project)
    assert(first_run.status.success(), "bare jet run failed:\n{A.stderr(&first_run)}")
    assert_eq(A.stdout(&first_run), "hello, world\n")
    explicit_run :: A.jet(&["run", "run.jet"], &project)
    assert(explicit_run.status.success(), "explicit jet run failed:\n{A.stderr(&explicit_run)}")
    fs.rename(project.join("run.jet"), project.join("run.jet.retired")).expect("hide the default entry for recovery")
    missing :: A.jet(&["run"], &project)
    assert(!missing.status.success(), "missing entry unexpectedly ran")
    assert(A.stderr(&missing).contains("E2105"))
    assert(A.stderr(&missing).contains("create `run.jet`") && A.stderr(&missing).contains("jet run <file.jet>"), "missing entry lost its recovery path:\n{A.stderr(&missing)}")
    fs.rename(project.join("run.jet.retired"), project.join("run.jet")).expect("restore the default entry after recovery proof")
    source_path :: project.join("run.jet")
    source :: fs.read_to_string(&source_path).expect("read scaffold entry")
    edited :: source.replace("hello, world", "hello from Jet")
    fs.write(&source_path, &edited).expect("write edited entry")
    loop args in [["check", "run.jet"], ["test", "run.jet"]] {
        result :: A.jet(&args, &project)
        assert(result.status.success(), "jet {args:?} failed:\n{A.stderr(&result)}")
    }
    edited_run :: A.jet(&["run"], &project)
    assert(edited_run.status.success(), "edited jet run failed:\n{A.stderr(&edited_run)}")
    assert_eq(A.stdout(&edited_run), "hello from Jet\n")
    fs.write(&source_path, edited.replace("print", "pirnt")).expect("write invalid entry")
    invalid :: A.jet(&["check", "run.jet"], &project)
    assert(!invalid.status.success(), "invalid source unexpectedly passed check")
    assert(A.stderr(&invalid).contains("E0102"), "invalid edit lost E0102:\n{A.stderr(&invalid)}")
    assert(A.stderr(&invalid).contains("Fix:"), "invalid edit lost Fix:\n{A.stderr(&invalid)}")
    fs.write(&source_path, edited).expect("restore edited entry")
    recovered :: A.jet(&["run"], &project)
    assert(recovered.status.success(), "recovery run failed:\n{A.stderr(&recovered)}")
    assert_eq(A.stdout(&recovered), "hello from Jet\n")
}
// Rust: tests/onboarding_recovery.rs:40
#Test("first_hour_scaffold_edit_check_test_and_run_recover") {
    root :: Common.Scratch.new("onboarding-scaffold")
    created :: B.jet(&["new", "hello"], &root.path)
    assert(created.status.success(), "jet new failed:\n{B.stderr(&created)}")
    project :: root.join("hello")
    loop file in ["package.jet", "run.jet", ".gitignore"] { assert(project.join(file).is_file(), "scaffold is missing {file}") }
    manifest :: fs.read_to_string(project.join("package.jet")).unwrap()
    assert(manifest.contains("authority: { holds: { allow: [IO, Mem.Alloc] } }"), "print-only scaffold grants only the effects its run.jet uses:\n{manifest}")
    source :: fs.read_to_string(project.join("run.jet")).unwrap()
    assert(source.contains("fn run()") && !source.contains("#CLI"), "the default scaffold is the print-only starter:\n{source}")
    first_run :: B.jet(&["run"], &project)
    assert(first_run.status.success(), "bare jet run failed:\n{B.stderr(&first_run)}")
    assert_eq(B.stdout(&first_run), "hello, world\n")
    explicit_run :: B.jet(&["run", "run.jet"], &project)
    assert(explicit_run.status.success(), "explicit jet run failed:\n{B.stderr(&explicit_run)}")
    assert_eq(B.stdout(&explicit_run), "hello, world\n")
    checked :: B.jet(&["check", "run.jet"], &project)
    assert(checked.status.success(), "jet check failed:\n{B.stderr(&checked)}")
    test :: B.jet(&["test", "run.jet"], &project)
    assert(test.status.success(), "jet test failed:\n{B.stderr(&test)}")
    source_path :: project.join("run.jet")
    edited :: source.replace("print(greeting(\"world\"))", "print(\"hello from Jet\")")
    fs.write(&source_path, &edited).unwrap()
    edited_run :: B.jet(&["run"], &project)
    assert(edited_run.status.success(), "edited jet run failed:\n{B.stderr(&edited_run)}")
    assert_eq(B.stdout(&edited_run), "hello from Jet\n")
    fs.write(&source_path, edited.replace("print", "pirnt")).unwrap()
    invalid :: B.jet(&["check", "run.jet"], &project)
    assert(!invalid.status.success(), "invalid source unexpectedly passed check")
    assert(B.stderr(&invalid).contains("E0102"), "missing E0102:\n{B.stderr(&invalid)}")
    assert(B.stderr(&invalid).contains("Fix:"), "diagnostic has no fix:\n{B.stderr(&invalid)}")
    explanation :: B.jet(&["explain", "E0102"], &project)
    assert(explanation.status.success(), "jet explain failed:\n{B.stderr(&explanation)}")
    assert(B.stdout(&explanation).contains("E0102"), "explain omitted its code:\n{B.stdout(&explanation)}")
    fs.write(&source_path, edited).unwrap()
    recovered :: B.jet(&["run"], &project)
    assert(recovered.status.success(), "recovery run failed:\n{B.stderr(&recovered)}")
    assert_eq(B.stdout(&recovered), "hello from Jet\n")
}
// Rust: tests/onboarding_recovery.rs:141
#Test("entry_recovery_covers_missing_ambiguous_legacy_and_stale_layouts") {
    missing :: Common.Scratch.new("onboarding-missing-entry")
    B.write_package(&missing.path, "missing_entry")
    missing_run :: B.jet(&["run"], &missing.path)
    assert(!missing_run.status.success())
    assert(B.stderr(&missing_run).contains("run.jet"), "missing recovery omitted run.jet:\n{B.stderr(&missing_run)}")
    assert(B.stderr(&missing_run).contains("Fix:"), "missing recovery omitted Fix:\n{B.stderr(&missing_run)}")
    fs.write(missing.join("run.jet"), "fn run() { print(\"restored\") }\n").unwrap()
    restored :: B.jet(&["run"], &missing.path)
    assert(restored.status.success(), "restored entry failed:\n{B.stderr(&restored)}")
    assert_eq(B.stdout(&restored), "restored\n")
    workspace :: Common.Scratch.new("onboarding-ambiguous-workspace")
    fs.write(workspace.join("workspace.jet"), "module workspace { members: [\"./packages/one\", \"./packages/two\"] }\n").unwrap()
    loop name in ["one", "two"] {
        package :: workspace.join("packages/{name}")
        fs.create_dir_all(&package).unwrap()
        B.write_package(&package, name)
        fs.write(package.join("run.jet"), "fn run() {{ print(\"{name}\") }}\n").unwrap()
    }
    ambiguous :: B.jet(&["run"], &workspace.path)
    assert(!ambiguous.status.success(), "ambiguous workspace unexpectedly ran")
    assert(B.stderr(&ambiguous).contains("ambiguous"), "ambiguity was not named:\n{B.stderr(&ambiguous)}")
    assert(B.stderr(&ambiguous).contains("-p"), "ambiguity omitted member recovery:\n{B.stderr(&ambiguous)}")
    selected :: B.jet(&["run", "-p", "one"], &workspace.path)
    assert(selected.status.success(), "selected workspace member failed:\n{B.stderr(&selected)}")
    assert_eq(B.stdout(&selected), "one\n")
    legacy :: Common.Scratch.new("onboarding-legacy-entry")
    B.write_package(&legacy.path, "legacy_entry")
    fs.write(legacy.join("main.jet"), "fn run() { print(\"legacy\") }\n").unwrap()
    migrated :: B.jet(&["run"], &legacy.path)
    assert(migrated.status.success(), "legacy entry did not recover:\n{B.stderr(&migrated)}")
    assert_eq(B.stdout(&migrated), "legacy\n")
    assert(legacy.join("run.jet").is_file())
    assert(!legacy.join("main.jet").exists())
    assert(B.stderr(&migrated).contains("migrated"), "migration notice missing:\n{B.stderr(&migrated)}")
    conflict :: Common.Scratch.new("onboarding-legacy-conflict")
    B.write_package(&conflict.path, "legacy_conflict")
    fs.write(conflict.join("run.jet"), "fn run() { print(\"current\") }\n").unwrap()
    fs.write(conflict.join("main.jet"), "fn run() { print(\"old\") }\n").unwrap()
    conflict_run :: B.jet(&["run"], &conflict.path)
    assert(!conflict_run.status.success())
    assert(B.stderr(&conflict_run).contains("E2105"), "conflict lost its CLI diagnostic:\n{B.stderr(&conflict_run)}")
    assert(B.stderr(&conflict_run).contains("ambiguous project entry"), "conflict omitted recovery:\n{B.stderr(&conflict_run)}")
    fs.remove_file(conflict.join("main.jet")).unwrap()
    conflict_recovered :: B.jet(&["run"], &conflict.path)
    assert(conflict_recovered.status.success(), "conflict recovery failed:\n{B.stderr(&conflict_recovered)}")
    assert_eq(B.stdout(&conflict_recovered), "current\n")
    stale :: Common.Scratch.new("onboarding-stale-manifest")
    fs.write(stale.join("pkg.jet"), "name: \"stale\"\n").unwrap()
    fs.write(stale.join("run.jet"), "fn run() { print(\"stale\") }\n").unwrap()
    stale_run :: B.jet(&["run"], &stale.path)
    assert(!stale_run.status.success())
    assert(B.stderr(&stale_run).contains("E1226"), "stale layout lost E1226:\n{B.stderr(&stale_run)}")
    assert(B.stderr(&stale_run).contains("package.jet"), "stale layout omitted package.jet fix:\n{B.stderr(&stale_run)}")
    fs.rename(stale.join("pkg.jet"), stale.join("package.jet")).unwrap()
    stale_recovered :: B.jet(&["run"], &stale.path)
    assert(stale_recovered.status.success(), "stale layout recovery failed:\n{B.stderr(&stale_recovered)}")
    assert_eq(B.stdout(&stale_recovered), "stale\n")
}
// Rust: tests/onboarding_recovery.rs:281
#Test("install_host_and_offline_failures_have_recovery") {
    guide :: B.repo_text("Docs/spec/guides/first-hour.md")
    exercises :: B.repo_text("Docs/spec/guides/diagnostic-recovery.md")
    loop phrase in ["x86_64 Linux and x86_64 macOS", "platform-specific project track", "Installation fails", "repeat the install command", "Do not continue with a partial install", "The first install is offline", "reconnect and repeat the install", "The host is unsupported"] { assert(guide.contains(phrase), "first-hour recovery lost {phrase:?}") }
    loop phrase in ["uname -s", "uname -m", "nix --version", "Recover install and host failures", "If the install fails because the network is offline", "If the install succeeds but `jet` is not found", "shell and run `jet version`"] { assert(exercises.contains(phrase), "diagnostic recovery lost {phrase:?}") }
    missing_tools :: Common.Scratch.new("onboarding-install-offline")
    doctor :: Command.new(env("CARGO_BIN_EXE_jet")).args(["self", "doctor"]).current_dir(&missing_tools.path).env("NO_COLOR", "1").env("PATH", &missing_tools.path).output().expect("jet self doctor should start after an install failure")
    report :: B.stdout(&doctor)
    assert(!doctor.status.success(), "missing toolchain unexpectedly passed")
    loop phrase in ["rustc: not found on PATH", "Fix: install Rust", "registry: skipped (offline; pass --online to check)", "Warning [L2101]", "run `jet self doctor` again"] { assert(report.contains(phrase), "doctor recovery lost {phrase:?}:\n{report}") }
}
