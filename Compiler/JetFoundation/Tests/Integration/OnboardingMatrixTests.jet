// Rust: tests/policy_scope.rs:177
#Test("unsafe_obligations_are_checked_before_codegen") {
    path :: OSPath.from(env("CARGO_MANIFEST_DIR")).join("tests/fixtures/unsafe_obligations/run.jet")
    bundle := jet.Loader.load_entry(path.to_str().unwrap()).unwrap()
    diagnostics :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run)
    assert(diagnostics.iter().any(|d| d.code == "E3107"))
    function :: bundle.modules[0].items.iter().find_map(|item| match item {
        jet.AST.Item.Func(function) if function.name == "run" -> Some(function)
        _ -> None
    }).unwrap()
    body :: match &function.body[1] {
        jet.AST.Stmt.Unsafe(body: body, ..) -> body
        _ -> panic("unsafe gate")
    }
    assert(!body.iter().any(|statement| match statement {
        jet.AST.Stmt.Expr(jet.AST.Expr.Call(call)) -> call.name == jet.Syntax.INTERNAL_UNSAFE_ASSERT
        _ -> false
    }))
    dev_bundle := jet.Loader.load_entry(path.to_str().unwrap()).unwrap()
    dev_codes: [String] :: jet.Sema.check_bundle(&dev_bundle, jet.Sema.CompileMode.Check).into_iter().map(|d| d.code).collect()
    run_codes: [String] :: diagnostics.into_iter().map(|d| d.code).collect()
    assert_eq(dev_codes, run_codes, "AOT and dev/check share the pre-TIR obligation pass")
}
// Rust: tests/policy_scope.rs:213
#Test("organization_obligations_floor_rejects_package_relaxation") {
    declaration :: (scope, value, source: String) -> jet.Policy.PolicyDeclaration(key: jet.Policy.PolicyKey.Unsafe, value: value, scope: scope, span: jet.Diagnostics.Span.new(0, 0), target: None, source: source)
    result :: jet.Policy.resolve(jet.Policy.PolicyKey.Unsafe, [
        declaration(jet.Policy.PolicyScope.Organization, jet.Policy.PolicyValue.Obligations, "/admin/policy.jet"),
        declaration(jet.Policy.PolicyScope.Package, jet.Policy.PolicyValue.Relaxed, "package.jet")
    ])
    assert(match result { Err(jet.Policy.PolicyError.Widening(..)) -> true, _ -> false })
}
// Rust: tests/policy_scope.rs:244
#Test("organization_policy_document_is_exact_and_fails_closed") {
    valid :: jet.Package.parse_policy_document("policy: { unsafe: .Obligations, impure: .GateOnly, nondeterministic: .GateOnly }\n").unwrap()
    assert_eq(valid.len(), 3)
    assert_eq(valid[0].value, jet.Policy.PolicyValue.Obligations)
    assert_eq(valid[1].key, jet.Policy.PolicyKey.Impure)
    assert_eq(valid[2].key, jet.Policy.PolicyKey.Nondeterministic)
    assert(jet.Package.parse_policy_document("policy: { unsafe: .Obligations").is_err())
    assert(jet.Package.parse_policy_document("policy: { unsafe: .Obligations }\npackage: {}").is_err())
}
