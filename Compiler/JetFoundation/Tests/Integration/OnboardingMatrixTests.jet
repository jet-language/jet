// Rust: tests/package_root_single_home.rs:90
#Test("nested_entry_points_share_root_and_stale_diagnostic") {
    fixture_root :: env.temp_dir().join("jet-package-root-test-{process.id()}")
    _ :: fs.remove_dir_all(&fixture_root)
    fs.create_dir_all(fixture_root.join("src/nested")).unwrap()
    fs.write(fixture_root.join("package.jet"), "name: \"root\"\nversion: \"0.1.0\"\n").unwrap()
    entry :: fixture_root.join("src/nested/main.jet")
    fs.write(&entry, "fn run() {}\n").unwrap()
    expected :: fs.canonicalize(&fixture_root).unwrap()
    assert_eq(jet.Loader.find_manifest_root(entry.parent().unwrap()), Some(expected.clone()))
    facts :: jet_semindex.package_facts_for_entry(&entry).unwrap().expect("semantic index must use package root")
    assert_eq(facts.name, "root")
    graph :: jet_devserver.WatchGraph.from_entry(&entry, &[]).unwrap()
    assert(graph.watched_paths().contains(&expected.join("package.jet")))
    project :: jet_devserver.Canvas.project_json_for_entry(&entry)
    assert(project.contains("\"project_root\":\"{expected.display()}\""))
    clean_lsp :: jet.LSP.check_document(&entry.display().to_string(), "fn run() {}\n")
    assert(clean_lsp.iter().all(|d| d.code != "E1226"), "canonical package must not emit stale-manifest diagnostic: {clean_lsp:?}")
    fs.remove_file(expected.join("package.jet")).unwrap()
    fs.write(expected.join("jet.toml"), "").unwrap()
    (_, stale) :: jet.Loader.stale_manifest_name_diagnostic(entry.parent().unwrap()).expect("stale manifest diagnostic")
    assert_eq(stale.code, "E1226")
    stale_lsp :: jet.LSP.check_document(&entry.display().to_string(), "fn run() {}\n")
    assert(stale_lsp.iter().any(|d| d.code == "E1226"), "LSP must receive Loader's stale-manifest diagnostic: {stale_lsp:?}")
    stale_watch :: match jet.Interpreter.dev_iteration(&entry.display().to_string(), false, true) {
        jet.Interpreter.RunOutcome.Problems(ds) -> ds
        outcome -> panic("watch entrypoint unexpectedly ran: {outcome:?}")
    }
    assert(stale_watch.iter().any(|d| d.code == "E1226"), "watch entrypoint must receive Loader's stale-manifest diagnostic: {stale_watch:?}")
    stale_canvas :: jet_devserver.Canvas.graph_json_for_file(&entry).unwrap_err()
    assert(stale_canvas.iter().any(|d| d.code == "E1226"), "Canvas must receive Loader's stale-manifest diagnostic: {stale_canvas:?}")
    stale_build :: jet.compile_programmable_build(&entry.display().to_string(), &[]).expect_err("policy defaults must reject a retired manifest name")
    assert(stale_build.iter().any(|d| d.code == "E1226"), "policy defaults must receive Loader's stale-manifest diagnostic: {stale_build:?}")
    _ :: fs.remove_dir_all(&fixture_root)
}
