// Rust: tests/policy_scope.rs:31
#Test("package_team_policy_parser_normalizes_typed_controls") {
    package :: jet.Package.PackageFacts.parse("name: \"policy\"\nversion: \"0.1.0\"\ndeps: { zlib: c@system }\npolicy: { effects: { \"./src\": -[IO, IO]> }, unsafe: .Paths([\"./src\", \"src\"]), expert: .Deny, deps: .List([\"zlib\", \"zlib\"]), lints: { deny: [float_money] })\n", "test").unwrap()
    ceiling :: package.policy.effects.get("src").unwrap()
    assert_eq(ceiling.len(), 1)
    assert(ceiling.contains("IO"))
    assert_eq(package.policy.unsafe_paths, Some(["src"]))
    assert_eq(package.policy.expert, Some(false))
    assert_eq(package.policy.deps, Some(["zlib"]))
    assert_eq(package.policy.lints_deny, Some(["float_money"]))
}
// Rust: tests/policy_scope.rs:54
#Test("package_dependency_policy_checks_source_less_dependencies_once_in_order") {
    root :: Common.unique_tmp("policy_dependency_facts")
    fs.create_dir_all(&root).unwrap()
    fs.write(root.join("package.jet"), "name: \"policy\"\nversion: \"0.1.0\"\ndeps: { a_denied: c@system, m_allowed: c@system, z_denied: js@\"widget#version=1@npm\" }\npolicy: { deps: .List([\"m_allowed\"]) }\n").unwrap()
    entry :: root.join("main.jet")
    fs.write(&entry, "fn run() {}\n").unwrap()
    bundle :: jet.Loader.load_entry(entry.to_str().unwrap()).unwrap()
    dependency_names: [String] :: bundle.package_guarantees.dependency_names.iter().cloned().collect()
    assert_eq(dependency_names, ["a_denied", "m_allowed", "z_denied"])
    (diagnostics, _, _) :: jet.Driver.check_file_with_effect_facts(entry.to_str().unwrap(), None, false)
    policy_diagnostics: [jet.Diagnostics.Diagnostic] :: diagnostics.iter().filter(|d| d.code == "E2960").collect()
    assert_eq(policy_diagnostics.len(), 2, "{diagnostics:#?}")
    assert(policy_diagnostics[0].what.contains("a_denied"))
    assert(policy_diagnostics[1].what.contains("z_denied"))
    assert(policy_diagnostics.iter().all(|d| d.what.contains("package.jet")))
    assert(!policy_diagnostics.iter().any(|d| d.what.contains("m_allowed")))
    _ :: fs.remove_dir_all(root)
}
// Rust: tests/policy_scope.rs:105
#Test("package_policy_declarations_inherit_to_imported_modules") {
    root :: Common.unique_tmp("policy_inherited_package")
    fs.create_dir_all(&root).unwrap()
    fs.write(root.join("package.jet"), "name: \"policy\"\nversion: \"0.1.0\"\npolicy: { explicit_units: true }\n").unwrap()
    fs.write(root.join("main.jet"), "use child\nfn run() {}\n").unwrap()
    fs.write(root.join("child.jet"), "fn helper() {}\n").unwrap()
    entry :: root.join("main.jet")
    bundle :: jet.Loader.load_entry(entry.to_str().unwrap()).unwrap()
    child :: bundle.modules.iter().find(|module| module.path.file_name().and_then(|name| name.to_str()) == Some("child.jet")).expect("imported child module")
    assert(child.policy_declarations.iter().any(|d| d.key == jet.Policy.PolicyKey.ExplicitUnits && d.scope == jet.Policy.PolicyScope.Package && d.source.ends_with("package.jet")))
    _ :: fs.remove_dir_all(root)
}
