// Rust: tests/policy_scope.rs:306
#Test("audited_gates_share_the_five_scope_tightening_ladder") {
    loop key in jet.Policy.AUDITED_GATE_KEYS {
        rule :: jet.Policy.rule(key)
        assert_eq(rule.scopes.len(), 5, "{key.name()} must expose every policy scope")
        assert_eq(rule.combine, jet.Policy.PolicyCombine.Tighten)
        assert_eq(jet.Policy.PolicyKey.parse(key.name()), Some(key))
        assert(jet.Policy.parse_value(key, ".Forbid").is_ok())
        assert_eq(jet.Policy.GateSet.parse("{key.name()}=allow"), Ok(key))
    }
}
// Rust: tests/policy_scope.rs:326
#Test("audited_gate_invocations_cannot_widen_an_organization_forbid") {
    loop key in jet.Policy.AUDITED_GATE_KEYS {
        declaration :: jet.Policy.PolicyDeclaration(key: key, value: jet.Policy.PolicyValue.Forbid, scope: jet.Policy.PolicyScope.Organization, span: jet.Diagnostics.Span.new(0, 0), target: None, source: "org-policy.jet")
        result :: jet.Policy.resolve_with_gates(key, [declaration], &jet.Policy.GateSet.allow(key))
        assert(match result { Err(jet.Policy.PolicyError.Widening(..)) -> true, _ -> false }, key.name())
    }
}
