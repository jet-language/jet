// Rust: tests/os_interrupt_windows.rs:69
#Test("windows_console_ctrl_c_runs_all_handlers_in_order") {
    // GATE #4483: selected Windows arm, never assume writer's host OS.
    if target.selected_os() != "windows" { return }
    CTRL_C_EVENT: U32 :: 0
    dir :: env.temp_dir().join("jet-os-interrupt-windows-{process.id()}")
    fs.create_dir_all(&dir).unwrap()
    // Private console; child clears inherited ignore flag for its real handler.
    #Unsafe("Windows console driver calls use exact system ABI") {
        _ :: W.FreeConsole()
        assert_ne(W.AllocConsole(), 0, "could not allocate private test console")
        assert_ne(W.SetConsoleCtrlHandler(None, 1), 0, "could not protect test driver")
    }
    binary :: W.compile_interrupt_program(&dir)
    child := Command.new(binary).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().unwrap()
    (lines_tx, lines_rx) :: mpsc.channel()
    child_stdout :: child.stdout.take().unwrap()
    _ :: thread.spawn(() -> {
        loop line in BufReader.new(^child_stdout).lines() {
            if lines_tx.send(line).is_err() { break }
        }
    })
    ready :: match lines_rx.recv_timeout(Duration.from_secs(10)) {
        Ok(line) -> line.unwrap()
        Err(error) -> {
            _ :: child.kill()
            _ :: child.wait()
            panic("generated child did not become ready within 10 seconds: {error}")
        }
    }
    assert_eq(ready, "ready")
    #Unsafe("broadcast CTRL_C_EVENT to the private shared console") { assert_ne(W.GenerateConsoleCtrlEvent(CTRL_C_EVENT, 0), 0) }
    deadline :: Instant.now() + Duration.from_secs(10)
    status :: loop {
        if status :: child.try_wait().unwrap() { break status }
        if Instant.now() >= deadline {
            _ :: child.kill()
            _ :: child.wait()
            panic("generated child did not handle CTRL_C_EVENT within 10 seconds")
        }
        thread.sleep(Duration.from_millis(10))
    }
    assert(status.success(), "generated child failed: {status}")
    stderr := ""
    child.stderr.take().unwrap().read_to_string(&stderr).unwrap()
    second :: lines_rx.recv_timeout(Duration.from_secs(1)).expect("second handler produced no output").unwrap()
    assert_eq(second, "second")
    assert(lines_rx.try_recv().is_err(), "unexpected handler output")
    assert(stderr.contains("panic: first handler failed"), "first handler panic lost its interrupt boundary diagnostic: {stderr:?}")
}
