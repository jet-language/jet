// Rust: tests/policy_scope.rs:374
#Test("audited_gate_ladder_example_allows_and_refuses_each_marker") {
    path :: OSPath.from(env("CARGO_MANIFEST_DIR")).join("Examples/features/effects/audited_gate_ladder.jet")
    loop key in jet.Policy.AUDITED_GATE_KEYS {
        allowed := jet.Loader.load_entry(path.to_str().unwrap()).unwrap()
        all := jet.Policy.GateSet.default()
        loop allowed_key in jet.Policy.AUDITED_GATE_KEYS { all.insert(allowed_key) }
        diagnostics :: jet.Sema.check_bundle_gates(&allowed, jet.Sema.CompileMode.Run, ^all)
        assert(diagnostics.is_empty(), "allowed {key.name()} gate: {diagnostics:#?}")
        refused := jet.Loader.load_entry(path.to_str().unwrap()).unwrap()
        loop module in &refused.modules {
            module.policy_declarations.push(jet.Policy.PolicyDeclaration(key: key, value: jet.Policy.PolicyValue.Forbid, scope: jet.Policy.PolicyScope.Organization, span: jet.Diagnostics.Span.new(0, 0), target: None, source: "org-policy.jet"))
        }
        refused_diagnostics :: jet.Sema.check_bundle_gates(&refused, jet.Sema.CompileMode.Run, jet.Policy.GateSet.allow(key))
        assert(refused_diagnostics.iter().any(|d| d.code == "E3415"), "refused {key.name()} gate: {refused_diagnostics:#?}")
    }
}
