#Test("mixed_operator_cli_types_projection_lists_reverse_owner") {
    root :: OSPath.from(env("CARGO_MANIFEST_DIR"))
    path :: root.join(O.SOURCE_PATH)
    output :: Command.new(env("CARGO_BIN_EXE_jet")).args(["inspect", "types", path.to_str().unwrap()]).current_dir(&root).env("NO_COLOR", "1").output().expect("run `jet inspect types`")
