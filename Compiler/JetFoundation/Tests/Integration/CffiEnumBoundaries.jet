// Bounded front-end C-ABI enum guards, not Darwin/Windows native evidence.
use jet_foundation.Tests.Integration.Common as common
use jet
use std.fs as fs

// Rust: tests/cffi_enum_boundaries.rs:11
pub fn codes(source: String, stem: String) -> [String] {
    root :: common.unique_tmp(stem)
    path :: root.join("main.jet")
    fs.write(&path, source).unwrap()
    diagnostics :: jet.check_with_path(path.to_str().unwrap())
    _ :: fs.remove_dir_all(root)
    diagnostics.into_iter().map(fn(diagnostic) { diagnostic.code }).collect()
}
