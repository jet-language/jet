}
// Rust: tests/tir_io_and_ownership.rs:327
#Test("borrowed_parameter_field_assignment_preserves_alias_isolation") {
    src :: "struct Ledger {{\n    rows: [Int]\n    fn put_back(&self, s: [Int]) {{\n        self.rows = s\n    }}\n}}\nfn run() {{\n    data := [Int]{{ 1, 2, 3 }}\n    ledger := Ledger{{ rows: [] }}\n    ledger.put_back(data)\n    data[0] = 9\n    print(ledger.rows[0])\n    print(data[0])\n}}\n"
