// Rust: tests/testing_tiers.rs:19
#Test("testing_file_helpers_preserve_success_and_failure_values_across_tiers") {
    if !have_rustc() { return }
    root :: OSPath.from(env("CARGO_MANIFEST_DIR"))
    golden :: jet_string(&root.join("tests/fixtures/testing_failure_reports.golden"))
    missing :: jet_string(&root.join("tests/fixtures/testing_failure_reports.missing"))
    source :: "use core.testing as testing\n\nfn run() {{\n    print(testing.golden(\"{golden}\", \"expected\n\"))\n    print(testing.golden(\"{missing}\", \"actual\n\"))\n    print(testing.golden(\"{golden}\", \"actual\n\"))\n    print(testing.fixture(\"{missing}\").len())\n    print(testing.fixture(\"{golden}\").len())\n}}\n"
    assert_tiers_agree("testing_file_helpers_tiers", &source, "true\nfalse\nfalse\n0\n9\n")
}
// Rust: tests/tir_io_and_ownership.rs:76
#Test("qualified_io_input_or_return") {
    if !have_rustc() { return }
    src :: "use core.term as io\nfn collect() -[IO]> [String] {{\n    out := [String]{{}}\n    loop true {{\n        line :: io.input(\"> \") ?? return ~out\n        if line == \"\" {{\n            break\n        }}\n        out.push(line)\n    }}\n    return out\n}}\nfn run() {{\n    got :: collect()\n    print(\"count={{got.len()}}\")\n    loop g in got {{\n        print(g)\n    }}\n    print(\"done\")\n}}\n"
    (code, stdout) :: build_and_run_stdin("tir_io_input_lines", src, "alpha\nbeta\n\n")
    assert_eq(code, 0)
    assert_eq(stdout, "> > > count=2\nalpha\nbeta\ndone\n")
    (eof_code, eof_stdout) :: build_and_run_stdin("tir_io_input_eof", src, "")
    assert_eq(eof_code, 0)
    assert_eq(eof_stdout, "> count=0\ndone\n")
}
// Rust: tests/tir_io_and_ownership.rs:122
#Test("generic_fns_and_trait_object_dispatch") {
    if !have_rustc() { return }
    src :: "trait Shape {{\n    fn area(self) -> Float\n    fn name(self) -> String\n}}\nstruct Circle {{\n    radius: Float\n\n    impl Shape {{\n        fn area(self) -[]> Float {{\n            return ((3.14159 * self.radius) * self.radius)\n        }}\n        fn name(self) -[]> String {{\n            return \"circle\"\n        }}\n    }}\n}}\nstruct Square {{\n    side: Float\n}}\nimpl Square.Shape {{\n    fn area(self) -[]> Float {{\n        return (self.side * self.side)\n    }}\n    fn name(self) -[]> String {{\n        return \"square\"\n    }}\n}}\nfn largest<T: Comparable>(xs: [T]) -[]> T? {{\n    if xs.len() == 0 {{\n        return None\n    }}\n    best := ~xs[0]\n    i := 1\n    loop i < xs.len() {{\n        if xs[i] > best {{\n            best = ~xs[i]\n        }}\n        i+= 1\n    }}\n    return Val(best)\n}}\nfn print_area(s: Shape) {{\n    print(\"{{s.name()}}: {{s.area()}}\")\n}}\n#Comparable\nstruct Score {{\n    points: Int\n}}\nfn run() {{\nshapes :: [Shape]{{ Circle{{radius: 1.0}}, Square{{side: 2.0}} }}\n    shapes.each((s) -> {{\n        print_area(s)\n    }})\n    nums :: [3, 1, 4, 1, 5]\n    print(largest(nums))\n    scores := [Score{{points: 10}}, Score{{points: 20}}]\n    scores.sort_by((s: Score) -> s.points)\n    print(scores[0].points)\n}}\n"
    assert_release_tiers_agree("tir_generic_trait_object", src, "circle: 3.14159\nsquare: 4.0\n5\n10\n")
}
// Rust: tests/tir_io_and_ownership.rs:198
#Test("trait_object_each_callback_result_parity") {
    if !have_rustc() { return }
    src :: "#Error\nenum VisitError {{\n    Stop\n}}\ntrait Shape {{\n    fn name(self) -[]> String\n}}\nstruct Circle {{\n    radius: Float\n    impl Shape {{\n        fn name(self) -[]> String {{\n            return \"circle\"\n        }}\n    }}\n}}\nstruct Square {{\n    side: Float\n}}\nimpl Square.Shape {{\n    fn name(self) -[]> String {{\n        return \"square\"\n    }}\n}}\nfn visit_ok(s: Shape) -> VisitError! {{\n    name :: s.name() ?? \"unreachable\"\n    print(name)\n    return\n}}\nfn visit_fail(s: Shape) -> VisitError! {{\n    name :: s.name() ?? \"unreachable\"\n    print(name)\n    if name == \"circle\" {{\n        return Err(VisitError.Stop)\n    }}\n    return\n}}\nfn consume_plain() -[]> Unit {{\n    shapes :: [Shape]{{ Circle{{radius: 1.0}}, Square{{side: 2.0}} }}\n    shapes.each((s) -> {{}})\n}}\nfn consume_ok() -> VisitError! {{\n    shapes :: [Shape]{{ Circle{{radius: 1.0}}, Square{{side: 2.0}} }}\n    shapes.each((s) -> visit_ok(s))\n    return\n}}\nfn consume_fail() -> VisitError! {{\n    shapes :: [Shape]{{ Circle{{radius: 1.0}}, Square{{side: 2.0}} }}\n    shapes.each((s) -> visit_fail(s))\n    return\n}}\nfn run() {{\n    consume_ok() ? ok -> {{ print(\"callback-ok\") }} ! error -> {{ print(\"callback-ok-failed\") }}\n    consume_fail() ? ok -> {{ print(\"callback-failed-missed\") }} ! error -> {{ print(\"callback-failed\") }}\n    consume_plain()\n    print(\"plain-ok\")\n}}\n"
    assert_release_tiers_agree("tir_trait_object_each_callback", src, "circle\nsquare\ncallback-ok\ncircle\ncallback-failed\nplain-ok\n")
}
// Rust: tests/tir_io_and_ownership.rs:271
#Test("trait_object_list_boxes_local_implementing_values") {
    if !have_rustc() { return }
    src :: "trait Sink {{\n    fn absorb(self, value: Float) -> Float\n}}\nstruct Holder {{\n    offset: Float\n\n    impl Sink {{\n        fn absorb(self, value: Float) -[]> Float {{\n            return value + self.offset\n        }}\n    }}\n}}\nfn run() {{\n    holder :: Holder{{ offset: 1.0 }}\n    sinks :: [Sink]{{ holder }}\n    print(sinks.len())\n}}\n"
    (code, stdout) :: build_and_run("tir_trait_object_local_list", src)
    assert_eq(code, 0)
    assert_eq(stdout, "1\n")
}
