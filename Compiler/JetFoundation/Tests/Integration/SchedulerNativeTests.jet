// Rust: tests/tir_io_and_ownership.rs:524
#Test("plain_parameter_modes_match_tir_and_aot") {
    if !have_rustc() { return }
    src :: "\nstruct Parcel {{ label: String }}\nstruct Leaf {{ text: String }}\nstruct Branch {{ leaf: Leaf }}\n\nimpl Parcel {{\n    fn show(self) {{ print(self.label) }}\n}}\n\nfn read_text(text: String) {{ print(text) }}\nfn read_list(values: [Int]) {{ print(values.len()) }}\nfn read_generic<T>(value: T) {{ print(7) }}\nfn read_nested(branch: Branch) {{ print(branch.leaf.text) }}\nfn apply(f: fn(Int) -> Int, value: Int) -[]> Int {{ return f(value) }}\nfn increment(value: Int) -[]> Int {{ return value + 1 }}\nfn edit(values: &[Int]) {{ values[0] = 9 }}\nfn consume(text: ^String) {{ print(text) }}\n\nfn run() {{\n    text :: \"hello\"\n    values := [1, 2]\n    parcel :: Parcel{{ label: \"parcel\" }}\n    branch :: Branch{{ leaf: Leaf{{ text: \"nested\" }} }}\n    callback :: increment\n    read_text(text)\n    read_list(values)\n    read_generic(text)\n    read_generic(callback)\n    read_nested(branch)\n    parcel.show()\n    print(apply((n: Int) -> (n + 1), 41))\n    edit(&values)\n    print(values[0])\n    consume(^text)\n}}\n"
    (code, stdout) :: build_and_run("tir_plain_parameter_modes", src)
    assert_eq(code, 0)
    assert_eq(stdout, "hello\n2\n7\n7\nnested\nparcel\n42\n9\nhello\n")
}
// Rust: tests/tir_io_and_ownership.rs:570
#Test("generic_inherent_methods_use_per_method_clone_bounds") {
    if !have_rustc() { return }
    src :: "\ntrait Measure {{\n    fn measure(self) -> Int\n}}\n\nstruct Holder<T> {{\n    reader: fn(T) -> Int\n\n    fn inspect(self) -[]> Int {{\n        return 1\n    }}\n\n    fn copy_tagged(self, value: #Input T) -[]> #Input T {{\n        return ~value\n    }}\n}}\n\nfn increment(value: Int) -[]> Int {{ return value + 1 }}\nfn read_callback(value: fn(Int) -> Int) -[]> Int {{ return 1 }}\nfn read_measure(value: Measure) -[]> Int {{ return 2 }}\nfn read_string(value: String) -[]> Int {{ return value.len() }}\n\nfn run() {{\n    callbacks :: Holder<fn(Int) -> Int>{{reader: read_callback}}\n    measures :: Holder<Measure>{{reader: read_measure}}\n    strings :: Holder<String>{{reader: read_string}}\n    print(callbacks.inspect())\n    print(measures.inspect())\n    copied :: strings.copy_tagged(#Input \"copy\")\n    print(3)\n}}\n"
    (code, stdout) :: build_and_run("tir_generic_method_clone_bounds", src)
    assert_eq(code, 0)
    assert_eq(stdout, "1\n1\n3\n")
}
// Rust: tests/tir_io_and_ownership.rs:612
#Test("path_parent_exhaustive_match_preserves_option_shape") {
    src :: "\nfn classify(path: Path) -[]> String {{\n    parent :: path.parent()\n    if parent == {{\n        .Val(next) -> return \"present:{{next.to_string()}}\"\n        .None -> return \"none\"\n    }}\n}}\n\nfn run() {{\n    print(classify(Path.from(\"/tmp/jet-parent/child\")))\n    print(classify(Path.from(\"/\")))\n}}\n"
    assert_tiers_agree("path_parent_exhaustive_match", src, "present:/tmp/jet-parent\nnone\n")
}
