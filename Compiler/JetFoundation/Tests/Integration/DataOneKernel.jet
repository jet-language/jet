// #1657 / I9: statistics have one canonical kernel; adapters only marshal.
use std.fs
use std.env
// GATE #4494: real filesystem traversal and reads.
// Rust: tests/data_one_kernel.rs:24
pub const KERNEL: String = "crates/jet-codegen/src/Prelude/CoreLib/Top/DataStats.rs"
// Rust: tests/data_one_kernel.rs:27
pub const STAT_WORDS: [String] = ["sum", "mean", "min", "max", "median", "variance", "stddev", "quantile", "rolling", "describe"]
// Rust: tests/data_one_kernel.rs:32
pub const FINGERPRINTS: [(String, String)] = [("compensation +=", "Neumaier compensated sum"), ("m2 += delta * delta2", "Welford variance update")]
// Rust: tests/data_one_kernel.rs:37
pub fn root() -> OSPath { env.manifest_dir() }
// Rust: tests/data_one_kernel.rs:41
pub fn collect_rs_files(dir: &OSPath, out: &[OSPath]) -> {
    entries :: match fs.read_dir(dir) { Ok(entries) -> entries, Err(_) -> return }
    loop entry in entries.flatten() {
        path :: entry.path()
        if path.is_dir() { collect_rs_files(&path, out) }
        else if path.extension().is_some_and(fn(e) -> e == "rs") { out.push(path) }
    }
}
// Rust: tests/data_one_kernel.rs:55
pub fn source_files() -> [OSPath] {
    out := [OSPath]{}
    collect_rs_files(&root().join("crates"), &out)
    collect_rs_files(&root().join("Source"), &out)
    out.sort()
    out
}
// Rust: tests/data_one_kernel.rs:66
// Float-sequence statistics return floats; marshalling adapters return values.
pub fn stats_function_names(text: String) -> [String] {
    found := [String]{}
    loop line in text.lines() {
        trimmed := line.trim_start() // #4303
        if trimmed.starts_with("//") { continue }
        if !(line.contains("&[f64]") || line.contains("&Vec<f64>")) { continue }
        (_, after_arrow) :: match line.split_once("-> ") { Some(pair) -> pair, None -> continue }
        if !after_arrow.contains("f64") { continue }
        rest :: match line.split_once("fn ") { Some(pair) -> pair, None -> continue }
        name: String :: rest.1.chars().take_while(fn(c) -> c.is_alphanumeric() || c == '_').collect()
        lower :: name.to_ascii_lowercase()
        if lower.split('_').any(fn(part) -> STAT_WORDS.contains(&part)) { found.push(name) }
    }
    found
}
