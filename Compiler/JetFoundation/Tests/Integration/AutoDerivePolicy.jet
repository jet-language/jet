use jet_foundation.[ProgramBundle, Item, Severity]
use jet_foundation.MIR.[MirArtifactRequest, MirArtifactTarget, MirArtifactKind, MirArtifactBuildMode, MirOptimizationPolicy, optimize_mir_program]
use jet_foundation.Layout.[TargetLayout]
use jet_codegen.TIR.[lower_checked_mir_program_for]
use jet_codegen.Native.[emit_mir_program, NativeConfig]
use jet_driver.[Loader]
use jet_sema.[check_bundle, CompileMode]
use jet_sema.Traits.[TraitRegistry]
use jet_tests.[Common]
use std.[fs, env, process]
use std.process.[Command]

// Rust: tests/auto_derive_policy.rs:6
// Native object emission replaces the retired generated-Rust artifact lane.
fn emit_native_aot(bundle: &ProgramBundle) -> [U8] {
    request :: MirArtifactRequest.new(MirArtifactTarget.Native, MirArtifactKind.NativeExecutable, MirArtifactBuildMode.Dev)
    (mir, artifact) :: lower_checked_mir_program_for(bundle, request).expect("checked native artifact lowers through MIR")
    mir.validate().expect("canonical MIR validates in auto-derive test")
    optimized :: optimize_mir_program(mir, &MirOptimizationPolicy.conservative()).expect("canonical MIR optimizes in auto-derive test")
    // GATE #4494: canonical native object emitter/link ABI; no Rust compiler or Rust bridge.
    emit_mir_program(&optimized, &NativeConfig{target: TargetLayout.host(), root_prefix: "", execution: NativeConfig.for_artifact(artifact)})!
}
// Rust: tests/auto_derive_policy.rs:36
// Retired emitted-Rust header counts migrate to the same checked derivation/explicit-impl facts.
fn impl_count(bundle: &ProgramBundle, trait_name: String, name: String) -> USize {
    all :: TraitRegistry.bundle_auto_derives(bundle, &bundle.name_ledger)
    facts :: &all[bundle.entry]
    derived :: if trait_name == {
        "JetShow" -> facts.auto_printable.contains(name)
        "JetDebug" -> facts.auto_debug.contains(name)
        "__jet_Equatable" -> facts.auto_equatable.contains(name)
        "__jet_Encode" -> facts.auto_encode.contains(name)
        "__jet_Decode" -> facts.auto_decode.contains(name)
        else -> panic("unknown auto-derive assertion trait")
    }
    canonical_trait :: if trait_name == {
        "JetShow" -> "Printable" "JetDebug" -> "Debug" "__jet_Equatable" -> "Equatable"
        "__jet_Encode" -> "Encode" "__jet_Decode" -> "Decode" else -> panic("unknown auto-derive assertion trait")
    }
    explicit := 0
    loop item in bundle.modules[bundle.entry].items {
        if item == {
            .Impl(implementation) -> if implementation.type_name == name && implementation.trait_name == canonical_trait -> explicit += 1
            .Struct(definition) -> if definition.name == name {
                loop implementation in definition.trait_impls { if implementation.trait_name == canonical_trait -> explicit += 1 }
            }
            else -> {}
        }
    }
    if explicit != 0 -> explicit else if derived -> 1 else -> 0
}
// Rust: tests/auto_derive_policy.rs:46
fn project_dir(name: String) -> OSPath { env.temp_dir().join("jet_auto_derive_{name}_{process.id()}") }
// Rust: tests/auto_derive_policy.rs:50
fn loaded_project(name: String, manifest_policy: String, source: String) -> ProgramBundle {
    // GATE #4494: retained host filesystem and loader authority ingress.
    dir :: project_dir(name)
    _ :: fs.remove_dir_all(&dir); fs.create_dir_all(&dir)!
    fs.write(dir.join("package.jet"), "name: \"{name}\"\nversion: \"1.0.0\"\n{manifest_policy}\n")!
    entry :: dir.join("main.jet"); fs.write(&entry, source)!
    Loader.load_entry(entry.to_str().unwrap())!
}
// Rust: tests/auto_derive_policy.rs:64
fn checked_bundle(bundle: ProgramBundle) -> ProgramBundle {
    errors :: check_bundle(&bundle, CompileMode.Run).into_iter().filter(fn(d) -> d.severity == Severity.Error).collect()
    assert(errors.is_empty(), "{errors:Debug}")
    ^bundle
}
// Rust: tests/auto_derive_policy.rs:73
fn checked_project(name: String, manifest_policy: String, source: String) -> ProgramBundle { checked_bundle(loaded_project(name, manifest_policy, source)) }
// Rust: tests/auto_derive_policy.rs:77
fn project_diagnostics(name: String, manifest_policy: String, source: String) -> [String] {
    bundle := loaded_project(name, manifest_policy, source)
    check_bundle(&bundle, CompileMode.Run).into_iter().filter(fn(d) -> d.severity == Severity.Error).map(fn(d) -> d.code).collect()
}
// Rust: tests/auto_derive_policy.rs:96
fn collect_struct_defaults(items: &[Item], out: &[(String, Bool)]) -> {
    loop item in items {
        if item == {
            .Struct(definition) -> out.push((definition.name.clone(), definition.auto_derive_default))
            .CodeModule(module) -> if module.body == .Val(body) -> collect_struct_defaults(&body, out)
            .GenericModule(module) -> collect_struct_defaults(&module.body, out)
            else -> {}
        }
    }
}
// Rust: tests/auto_derive_policy.rs:115
struct AotMeasurement { exit: I32, stdout: String, generated_object_bytes: USize, binary_bytes: U64 }
// Rust: tests/auto_derive_policy.rs:122
fn aot_measurement(bundle: &ProgramBundle, name: String) -> AotMeasurement? {
    // Preserve optional tool availability, substituting the native linker for retired rustc.
    if !Command.new("cc").arg("--version").output().map(fn(o) -> o.status.success()).unwrap_or(false) -> return None
    dir :: project_dir(name)
    _ :: fs.remove_dir_all(&dir); fs.create_dir_all(&dir)!
    object :: dir.join("main.o"); binary :: dir.join("main_bin")
    generated :: emit_native_aot(bundle)
    fs.write(&object, &generated)!
    built :: Command.new("cc").arg(&object).arg("-o").arg(&binary).output()!
    assert(built.status.success(), "AOT native object failed to link:\n{String.from_utf8_lossy(&built.stderr)}")
    ran :: Command.new(binary).output()!
    Val(AotMeasurement{exit: ran.status.code().unwrap_or(-1), stdout: String.from_utf8_lossy(&ran.stdout).to_string(), generated_object_bytes: generated.len(), binary_bytes: fs.metadata(dir.join("main_bin"))!.len()})
}
// Rust: tests/auto_derive_policy.rs:154
fn aot_output(bundle: &ProgramBundle, name: String) -> (I32, String)? { aot_measurement(bundle, name).map(fn(m) -> (m.exit, m.stdout)) }

// Rust: tests/auto_derive_policy.rs:159
#Test("signed_markers_gate_generated_traits_and_jit_behavior") {
    bundle :: checked_project("signed", "", """
#[!Debug, !Equatable, Printable]
struct Mixed { value: Int }

fn run() {
    print(Mixed{ value: 7 })
}
""")
    assert_eq(impl_count(&bundle, "JetShow", "Mixed"), 1)
    assert_eq(impl_count(&bundle, "JetDebug", "Mixed"), 0)
    assert_eq(impl_count(&bundle, "__jet_Equatable", "Mixed"), 0)
    // JIT retirement: the same output expectation is exercised in every retained execution tier.
    loop tier in [String]{"O0", "O1", "O2", "Web"} {
        outcome :: Common.run_bundle_tier(&bundle, tier, false, &Common.development_policy())
        stdout :: if outcome == { .Ran(_, stdout, _) -> stdout else -> panic("signed auto-derive program did not run: {outcome:Debug}") }
        assert_eq(stdout, "Mixed { value: 7 }\n")
    }
}
