// Rust: tests/auto_derive_policy.rs:206
#Test("plain_struct_auto_codable_matches_all_execution_tiers") {
    bundle :: checked_project("plain_codable", "", """
use core.encoding.json as json

struct Record { id: Int name: String }

fn run() {
    print(json.to_string(Record{ id: 7, name: "plain" }))
}
""")
    expected :: "{\"id\":7,\"name\":\"plain\"}\n"
    if aot_output(&bundle, "plain_codable_aot") == .Val((exit, stdout)) { assert_eq(exit, 0); assert_eq(stdout, expected) }
    loop tier in [String]{"O0", "O1", "O2", "Web"} {
        outcome :: Common.run_bundle_tier(&bundle, tier, false, &Common.development_policy())
        stdout :: if outcome == { .Ran(_, stdout, _) -> stdout else -> panic("plain Codable program did not run in {tier}: {outcome:Debug}") }
        assert_eq(stdout, expected)
    }
}
// Rust: tests/auto_derive_policy.rs:249
#Test("auto_derive_keeps_compile_and_binary_measurements_stable") {
    explicit_bundle :: checked_project("auto_measure_before", "", """
use core.encoding.json as json

#[Encode, Decode]
struct Record { id: Int name: String }

fn run() {
    print(json.to_string(Record{ id: 7, name: "plain" }))
}
""")
    automatic_bundle :: checked_project("auto_measure_after", "", """
use core.encoding.json as json

struct Record { id: Int name: String }

fn run() {
    print(json.to_string(Record{ id: 7, name: "plain" }))
}
""")
    explicit :: aot_measurement(&explicit_bundle, "auto_measure_before_aot") ?? return
    explicit_repeat :: aot_measurement(&explicit_bundle, "auto_measure_before_aot") ?? return
    automatic :: aot_measurement(&automatic_bundle, "auto_measure_after_aot") ?? return
    automatic_repeat :: aot_measurement(&automatic_bundle, "auto_measure_after_aot") ?? return
    loop (label, first, repeat) in [(String, &AotMeasurement, &AotMeasurement)]{("explicit", &explicit, &explicit_repeat), ("automatic", &automatic, &automatic_repeat)} {
        assert_eq(first.exit, repeat.exit, "{label} exit changed between runs")
        assert_eq(first.stdout, repeat.stdout, "{label} stdout changed between runs")
        assert_eq(first.generated_object_bytes, repeat.generated_object_bytes, "{label} generated-object bytes changed between runs")
        assert_eq(first.binary_bytes, repeat.binary_bytes, "{label} binary bytes changed between runs")
    }
    assert_eq(explicit.exit, 0); assert_eq(automatic.exit, 0); assert_eq(explicit.stdout, automatic.stdout)
    generated_delta :: explicit.generated_object_bytes.abs_diff(automatic.generated_object_bytes)
    binary_delta :: explicit.binary_bytes.abs_diff(automatic.binary_bytes)
    Common.eprintln("auto-derive measurement: generated native object {explicit.generated_object_bytes} -> {automatic.generated_object_bytes} ({generated_delta} bytes); binary {explicit.binary_bytes} -> {automatic.binary_bytes} ({binary_delta} bytes)")
    assert(generated_delta <= 64, "auto derive added {generated_delta} generated-object bytes")
    assert(binary_delta <= 64, "auto derive changed the binary by {binary_delta} bytes")
}
// Rust: tests/auto_derive_policy.rs:333
#Test("structural_defaults_cover_codable_and_refusals_are_silent") {
    bundle :: loaded_project("structural_defaults", "", """
struct Plain { value: Int }

#!Codable
struct Refused { value: Int }

struct Opaque { value: Shared<Int> }

fn run() {}
""")
    all :: TraitRegistry.bundle_auto_derives(&bundle, &bundle.name_ledger); facts :: &all[bundle.entry]
    loop selected in [&facts.auto_printable, &facts.auto_debug, &facts.auto_equatable, &facts.auto_comparable, &facts.auto_encode, &facts.auto_decode] {
        assert(selected.contains("Plain"), "{selected:Debug}")
        assert(!selected.contains("Opaque"), "{selected:Debug}")
    }
    loop selected in [&facts.auto_printable, &facts.auto_debug, &facts.auto_equatable, &facts.auto_comparable] { assert(selected.contains("Refused"), "{selected:Debug}") }
    assert(!facts.auto_encode.contains("Refused")); assert(!facts.auto_decode.contains("Refused"))
    _ :: checked_bundle(bundle)
}
