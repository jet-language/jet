#!Printable
struct NoPrint { value: Int }
struct Blocked { child: NoPrint? }

fn run() {}
""")
    all :: TraitRegistry.bundle_auto_derives(&bundle, &bundle.name_ledger); facts :: &all[bundle.entry]
    loop name in [String]{"OptionalNode", "ListNode", "MapNode"} {
        assert(facts.auto_printable.contains(name), name); assert(facts.auto_debug.contains(name), name)
        assert(facts.auto_encode.contains(name), name); assert(facts.auto_decode.contains(name), name)
    }
    loop name in [String]{"OptionalNode", "ListNode", "MapNode"} { assert(facts.auto_equatable.contains(name), name) }
    assert(!facts.auto_printable.contains("Blocked"))
    _ :: checked_bundle(bundle)
}
// Rust: tests/auto_derive_policy.rs:407
#Test("project_refusal_is_a_default_fact_and_explicit_codable_still_wins") {
    bundle :: loaded_project("project_refusal_fact", "policy: { lints: { deny: [auto_derive] } }", """
struct Defaulted { value: Int }

#Codable
struct Explicit { value: Int }

fn run() {}
""")
    defaults := [(String, Bool)]{}
    collect_struct_defaults(&bundle.modules[bundle.entry].items, &defaults)
    assert_eq(defaults, [(String, Bool)]{("Defaulted", false), ("Explicit", false)})
    all :: TraitRegistry.bundle_auto_derives(&bundle, &bundle.name_ledger); facts :: &all[bundle.entry]
    assert(!facts.auto_encode.contains("Defaulted")); assert(!facts.auto_decode.contains("Defaulted"))
    assert(facts.auto_encode.contains("Explicit")); assert(facts.auto_decode.contains("Explicit"))
    checked :: checked_bundle(bundle)
    assert_eq(impl_count(&checked, "__jet_Encode", "Defaulted"), 0)
    assert_eq(impl_count(&checked, "__jet_Decode", "Defaulted"), 0)
    assert_eq(impl_count(&checked, "__jet_Encode", "Explicit"), 1)
    assert_eq(impl_count(&checked, "__jet_Decode", "Explicit"), 1)
}
// Rust: tests/auto_derive_policy.rs:444
#Test("generic_deny_list_refuses_auto_derive") {
    bundle :: checked_project("package_off", "policy: { lints: { deny: [auto_derive] } }", """
#[Printable, Equatable, Debug]
struct Enabled { value: Int }

struct Missing { value: Int }

#!Debug
struct Manual { value: Int }

impl Manual.Debug {
    fn debug(self) -> String { return "manual" }
}

fn run() {
    a := Enabled{ value: 3 }
    print(a)
    print("{a:Debug}")
    print(a == Enabled{ value: 3 })
    print("{Manual{ value: 9 }:Debug}")
}
""")
    loop trait_name in [String]{"JetShow", "JetDebug", "__jet_Equatable"} {
        assert_eq(impl_count(&bundle, trait_name, "Enabled"), 1, "{trait_name} Enabled")
        assert_eq(impl_count(&bundle, trait_name, "Missing"), 0, "{trait_name} Missing")
    }
    all :: TraitRegistry.bundle_auto_derives(&bundle, &bundle.name_ledger); facts :: &all[bundle.entry]
    assert(!facts.auto_encode.contains("Missing")); assert(!facts.auto_decode.contains("Missing"))
    assert_eq(impl_count(&bundle, "JetDebug", "Manual"), 1)
    loop tier in [String]{"O0", "O1", "O2", "Web"} {
        outcome :: Common.run_bundle_tier(&bundle, tier, false, &Common.development_policy())
        stdout :: if outcome == { .Ran(_, stdout, _) -> stdout else -> panic("package-off auto-derive program did not run: {outcome:Debug}") }
        assert_eq(stdout, "Enabled { value: 3 }\nEnabled { value: 3 }\ntrue\nmanual\n")
    }
}
// Rust: tests/auto_derive_policy.rs:510
#Test("old_auto_derive_key_is_rejected") {
    dir :: project_dir("old_key")
    _ :: fs.remove_dir_all(&dir); fs.create_dir_all(&dir)!
    legacy_key :: [String]{"auto", "derive"}.join("_")
    fs.write(dir.join("package.jet"), "name: \"old-key\"\nversion: \"1\"\npolicy: \u{007b} {legacy_key}: false \u{007d}\n")!
    entry :: dir.join("main.jet"); fs.write(&entry, "fn run() {}\n")!
    diagnostics :: Loader.load_entry(entry.to_str().unwrap()).expect_err("retired policy key must be rejected")
    assert_eq(diagnostics.len(), 1, "{diagnostics:Debug}")
    assert_eq(diagnostics[0].code, "E1206")
    assert(diagnostics[0].what.contains("policy.auto_derive"), "{diagnostics:Debug}")
    assert(diagnostics[0].fix.contains("policy.lints.deny"), "{diagnostics:Debug}")
}
// Rust: tests/auto_derive_policy.rs:538
#Test("rejected_auto_traits_fail_in_sema_before_codegen") {
    diagnostics :: project_diagnostics("reject_use", "", """
#!Printable
struct NoPrint { value: Int }
struct OuterNoPrint { inner: NoPrint }

#!Debug
struct NoDebug { value: Int }
struct OuterNoDebug { inner: NoDebug }

#!Equatable
struct NoEquality { value: Int }
struct OuterNoEquality { inner: NoEquality }

struct OuterReader { reader: FileReader }

#[!Printable, !Debug, !Equatable]
struct Hidden<T> { value: T }
struct OuterHidden { value: Hidden<Int> }

fn reject_opaque_core(reader: FileReader) {
    print(reader)
    print("{reader:Debug}")
}

fn reject_outer_reader(value: OuterReader) {
    print(value)
}

fn run() {
    print(OuterNoPrint{ inner: NoPrint{ value: 1 } })
    print("{OuterNoDebug{ inner: NoDebug{ value: 2 } }:Debug}")
    print(OuterNoEquality{ inner: NoEquality{ value: 3 } } == OuterNoEquality{ inner: NoEquality{ value: 3 } })
    print(OuterHidden{ value: Hidden{ value: 4 } })
}
""")
    assert(diagnostics.iter().filter(fn(code) -> code == "E0112").count() >= 6, "{diagnostics:Debug}")
    assert(diagnostics.iter().any(fn(code) -> code == "E0312"), "{diagnostics:Debug}")
    entry :: project_dir("reject_use").join("main.jet")
    bundle :: Loader.load_entry(entry.to_str().unwrap())!
    all :: TraitRegistry.bundle_auto_derives(&bundle, &bundle.name_ledger); facts :: &all[bundle.entry]
    loop (type_name, selected) in [("OuterReader", &facts.auto_printable), ("OuterHidden", &facts.auto_printable), ("OuterHidden", &facts.auto_debug), ("OuterHidden", &facts.auto_equatable)] { assert(!selected.contains(type_name), type_name) }
    loop type_name in [String]{"NoEquality", "OuterNoEquality"} {
        assert(!facts.auto_equatable.contains(type_name), type_name)
        assert(facts.auto_comparable.contains(type_name), type_name)
    }
    loop tier in [String]{"O0", "O1", "O2", "Web"} {
        outcome :: Common.run_entry_tier(entry, tier, false)
        errors :: if outcome == { .Problems(errors) -> errors else -> panic("{tier} bypassed sema: {outcome:Debug}") }
        assert(errors.iter().filter(fn(d) -> d.code == "E0112").count() >= 6, "{tier}: {errors:Debug}")
    }
}
// Rust: tests/auto_derive_policy.rs:625
#Test("package_default_reaches_nested_and_dependency_modules") {
    nested_dir :: project_dir("nested")
    _ :: fs.remove_dir_all(&nested_dir); fs.create_dir_all(&nested_dir)!
    fs.write(nested_dir.join("package.jet"), "name: \"nested\"\nversion: \"1\"\npolicy: { lints: { deny: [auto_derive] } }\n")!
    fs.write(nested_dir.join("main.jet"), "struct Outer { value: Int }\nmodule inner { struct Inner { value: Int } }\nfn run() {}\n")!
    nested :: Loader.load_entry(nested_dir.join("main.jet").to_str().unwrap())!
    defaults := [(String, Bool)]{}
    loop module in nested.modules { collect_struct_defaults(&module.items, &defaults) }
    assert_eq(defaults, [(String, Bool)]{("Outer", false), ("Inner", false)})
    workspace :: project_dir("multi_package"); app :: workspace.join("app"); dep :: workspace.join("dep")
    _ :: fs.remove_dir_all(&workspace); fs.create_dir_all(&app)!; fs.create_dir_all(&dep)!
    fs.write(app.join("package.jet"), "name: \"app\"\nversion: \"1\"\ndeps: { dep: ../dep }\n")!
    fs.write(app.join("main.jet"), "use dep\nstruct AppType { value: Int }\nstruct ImportedOuter { value: dep.DepType }\nfn reject(value: ImportedOuter) { print(value) }\nfn run() {}\n")!
    fs.write(dep.join("package.jet"), "name: \"dep\"\nversion: \"1\"\npolicy: { lints: { deny: [auto_derive] } }\n")!
    fs.write(dep.join("dep.jet"), "pub struct DepType { value: Int }\n")!
    bundle := Loader.load_entry(app.join("main.jet").to_str().unwrap())!
    // GATE #4499: exact native OSPath keys; no lossy display substitution.
    by_module := [OSPath:[(String, Bool)]]{}
    loop module in bundle.modules {
        module_defaults := [(String, Bool)]{}
        collect_struct_defaults(&module.items, &module_defaults)
        by_module[module.path.clone()] = ^module_defaults
    }
    assert_eq(by_module[app.join("main.jet")], [(String, Bool)]{("AppType", true), ("ImportedOuter", true)})
    assert_eq(by_module[dep.join("dep.jet")], [(String, Bool)]{("DepType", false)})
    all :: TraitRegistry.bundle_auto_derives(&bundle, &bundle.name_ledger); facts :: &all[bundle.entry]
    assert(!facts.auto_printable.contains("ImportedOuter"))
    errors :: check_bundle(&bundle, CompileMode.Run).into_iter().filter(fn(d) -> d.severity == Severity.Error).collect()
    assert(errors.iter().any(fn(d) -> d.code == "E0112"), "{errors:Debug}")
}
// Rust: tests/auto_derive_policy.rs:703
#Test("same_named_dependency_type_keeps_its_own_auto_derive_policy") {
    workspace :: project_dir("same_named_types")
    app :: workspace.join("app"); dep :: workspace.join("dep"); open_dep :: workspace.join("open_dep")
    _ :: fs.remove_dir_all(&workspace); fs.create_dir_all(&app)!; fs.create_dir_all(&dep)!; fs.create_dir_all(&open_dep)!
    fs.write(app.join("package.jet"), "name: \"app\"\nversion: \"1\"\ndeps: {\n    dep: ../dep,\n    open_dep: ../open_dep,\n}\n")!
    fs.write(app.join("main.jet"), """
use dep as vendor

struct Token { value: Int }
struct LocalEnvelope { token: Token }
struct DependencyEnvelope { token: vendor.Token }
struct SharedEnvelope { value: Shared<Int> }

fn reject(value: vendor.Token) {
    print(value)
}

fn run() {
    print(LocalEnvelope{ token: Token{ value: 7 } })
}
""")!
    fs.write(dep.join("package.jet"), "name: \"dep\"\nversion: \"1\"\npolicy: { lints: { deny: [auto_derive] } }\n")!
    fs.write(dep.join("dep.jet"), "pub struct Token { value: Int }\n")!
    fs.write(open_dep.join("package.jet"), "name: \"open_dep\"\nversion: \"1\"\n")!
    fs.write(open_dep.join("open_dep.jet"), "pub struct Badge { pub value: Int }\n")!
    bundle := Loader.load_entry(app.join("main.jet").to_str().unwrap())!
    all :: TraitRegistry.bundle_auto_derives(&bundle, &bundle.name_ledger); app_facts :: &all[bundle.entry]
    loop selected in [&app_facts.auto_printable, &app_facts.auto_debug, &app_facts.auto_equatable] { assert(!selected.contains("SharedEnvelope"), "{selected:Debug}") }
    errors :: check_bundle(&bundle, CompileMode.Run).into_iter().filter(fn(d) -> d.severity == Severity.Error).collect()
    assert_eq(errors.iter().filter(fn(d) -> d.code == "E0112").count(), 1, "{errors:Debug}")
    fs.write(app.join("main.jet"), """
use dep as vendor
use open_dep as library
use core.encoding.json as json

struct Token { value: Int }
struct LocalEnvelope { token: Token }
struct DependencyEnvelope { token: vendor.Token }
struct ImportedEnvelope { badge: library.Badge }
struct MapEnvelope { values: [String:Int] }
struct UnionEnvelope { value: Int | String }

fn run() {
    token :: Token{ value: 7 }
    print(token)
    print("{token:Debug}")
    print(token == Token{ value: 7 })

    badge :: library.Badge{ value: 9 }
    print(badge)
    print("{badge:Debug}")
    print(badge == library.Badge{ value: 9 })

    envelope :: ImportedEnvelope{ badge: library.Badge{ value: 9 } }
    print(envelope)
    print("{envelope:Debug}")
    print(envelope == ImportedEnvelope{ badge: library.Badge{ value: 9 } })
    print(envelope < ImportedEnvelope{ badge: library.Badge{ value: 10 } })
    wire :: json.to_string(envelope)
    print(wire)
    decoded :: json.decode<ImportedEnvelope>(wire) ?? panic("decode")
    print(decoded == envelope)

    map :: MapEnvelope{ values: [String:Int]{ "one": 1 } }
    print(map)
    print("{map:Debug}")

    union :: UnionEnvelope{ value: 3 }
    print(union)
    print("{union:Debug}")
    print(union == UnionEnvelope{ value: 3 })
}
""")!
    bundle = Loader.load_entry(app.join("main.jet").to_str().unwrap())!
    all :: TraitRegistry.bundle_auto_derives(&bundle, &bundle.name_ledger); app_facts :: &all[bundle.entry]
    dep_idx :: bundle.modules.iter().position(fn(module) -> module.path == dep.join("dep.jet")).unwrap()
    open_dep_idx :: bundle.modules.iter().position(fn(module) -> module.path == open_dep.join("open_dep.jet")).unwrap()
    badge_identity :: bundle.name_ledger.nominal_identity(open_dep_idx, "Badge").unwrap()
    assert(badge_identity.contains("::"), badge_identity)
    dep_facts :: &all[dep_idx]
    loop selected in [&app_facts.auto_printable, &app_facts.auto_debug, &app_facts.auto_equatable] {
        assert(selected.contains("Token"), "{selected:Debug}"); assert(selected.contains("LocalEnvelope"), "{selected:Debug}")
        assert(selected.contains("UnionEnvelope"), "{selected:Debug}")
        assert(!selected.contains("DependencyEnvelope"), "{selected:Debug}"); assert(!selected.contains("vendor.Token"), "{selected:Debug}")
        assert(selected.contains(&badge_identity), "{selected:Debug}"); assert(selected.contains("ImportedEnvelope"), "{selected:Debug}")
    }
    comparable :: &app_facts.auto_comparable
    assert(comparable.contains("Token"), "{comparable:Debug}"); assert(comparable.contains("LocalEnvelope"), "{comparable:Debug}")
    assert(!comparable.contains("UnionEnvelope"), "{comparable:Debug}")
    assert(!comparable.contains("DependencyEnvelope"), "{comparable:Debug}"); assert(!comparable.contains("vendor.Token"), "{comparable:Debug}")
    assert(comparable.contains(&badge_identity), "{comparable:Debug}"); assert(comparable.contains("ImportedEnvelope"), "{comparable:Debug}")
    assert(app_facts.auto_encode.contains("ImportedEnvelope")); assert(app_facts.auto_decode.contains("ImportedEnvelope"))
    assert(app_facts.auto_printable.contains("MapEnvelope")); assert(app_facts.auto_debug.contains("MapEnvelope"))
    assert(app_facts.auto_equatable.contains("MapEnvelope")); assert(!app_facts.auto_comparable.contains("MapEnvelope"))
    loop selected in [&dep_facts.auto_printable, &dep_facts.auto_debug, &dep_facts.auto_equatable, &dep_facts.auto_comparable] { assert(!selected.contains("Token"), "{selected:Debug}") }
    errors :: check_bundle(&bundle, CompileMode.Run).into_iter().filter(fn(d) -> d.severity == Severity.Error).collect()
    assert(errors.is_empty(), "{errors:Debug}")
    expected :: "Token { value: 7 }\nToken { value: 7 }\ntrue\nBadge { value: 9 }\nBadge { value: 9 }\ntrue\nImportedEnvelope { badge: Badge { value: 9 } }\nImportedEnvelope { badge: Badge { value: 9 } }\ntrue\ntrue\n{\"badge\":{\"value\":9}}\ntrue\nMapEnvelope { values: [\"one\": 1] }\nMapEnvelope { values: [\"one\": 1] }\nUnionEnvelope { value: 3 }\nUnionEnvelope { value: 3 }\ntrue\n"
    if aot_output(&bundle, "same_named_types_aot") == .Val((exit, stdout)) { assert_eq(exit, 0); assert_eq(stdout, expected) }
    loop tier in [String]{"O0", "O1", "O2", "Web"} {
        outcome :: Common.run_bundle_tier(&bundle, tier, false, &Common.development_policy())
        stdout :: if outcome == { .Ran(_, stdout, _) -> stdout else -> panic("same-name program did not run in {tier}: {outcome:Debug}") }
        assert_eq(stdout, expected)
    }
}
