pub fn jet_bin() -> OSPath { env.jet_bin() }
// Rust: tests/web_scaffold.rs:22
pub fn unused_local_port() -> U16 {
    TcpListener.bind(("127.0.0.1", 0)).expect("bind an ephemeral localhost port").local_addr().expect("read local addr").port()
}
// Rust: tests/web_scaffold.rs:30
pub fn http_get(port: U16, path: String) -> (U16, [U8])? {
    stream := TcpStream.connect(("127.0.0.1", port)).ok() ?? return .None
    _ :: stream.set_read_timeout(Val(Duration.from_secs(5))).ok() ?? return .None
    _ :: stream.write_all("GET {path} HTTP/1.1\r\nHost: localhost:{port}\r\nConnection: close\r\n\r\n".as_bytes()).ok() ?? return .None
    raw := [U8]{}
    _ :: stream.read_to_end(&raw).ok() ?? return .None
    separator :: b"\r\n\r\n"
    split :: raw.windows(separator.len()).position((window) -> window == separator).map((index) -> index + separator.len()) ?? return .None
    status :: String.from_utf8_lossy(&raw[..split]).lines().next().and_then((line) -> line.split_whitespace().nth(1)).and_then((value) -> value.parse::<U16>().ok()) ?? return .None
    Val((status, raw[split..].to_vec()))
}
// Rust: tests/web_scaffold.rs:55
pub fn wait_for_server(port: U16, timeout: Duration) -> {
    deadline :: Instant.now() + timeout
    loop {
        if http_get(port, "/__jet_dev_version") == Val(reply) { if reply.0 == 200 { return } }
        if Instant.now() >= deadline { panic("web scaffold server did not start on {port}") }
        thread.sleep(Duration.from_millis(100))
    }
}
// Rust: tests/web_scaffold.rs:68
pub const WEB_DOM_HARNESS: String = """
class FakeElement {{
  constructor(tag) {{
    this.tagName = tag;
    this.style = {{}};
    this.dataset = {{}};
    this.children = [];
    this.textContent = "";
    this.id = "";
    this.attributes = new Map();
    this.listeners = new Map();
    this.parentNode = null;
  }}
  appendChild(child) {{ child.parentNode = this; this.children.push(child); return child; }}
  remove() {{
    if (!this.parentNode) return;
    this.parentNode.children = this.parentNode.children.filter((child) => child !== this);
  }}
  addEventListener(name, handler) {{
    const handlers = this.listeners.get(name) ?? [];
    handlers.push(handler);
    this.listeners.set(name, handlers);
  }}
  setAttribute(name, value) {{ this.attributes.set(name, String(value)); }}
  removeAttribute(name) {{ this.attributes.delete(name); }}
  focus() {{}}
}}
class FakeDocument {{
  constructor() {{
    this.body = new FakeElement("body");
    this.body.ownerDocument = this;
    this.activeElement = null;
    this._byId = new Map();
  }}
  createElement(tag) {{ const element = new FakeElement(tag); element.ownerDocument = this; return element; }}
  getElementById(id) {{ return this._byId.get(id) ?? null; }}
}}
const document = new FakeDocument();
const appendBody = document.body.appendChild.bind(document.body);
document.body.appendChild = (element) => {{
  if (element.id) document._byId.set(element.id, element);
  return appendBody(element);
}};
globalThis.document = document;
const {{ jet_main }} = await import("./app.js");
await jet_main();
const root = document.getElementById("jet-app");
const text = root?.children.map((child) => child.textContent).join("") ?? "";
if (!text.includes("hello, world")) {{ throw new Error(`expected rendered greeting, got ${{JSON.stringify(text)}}`); }}
console.log(text);
"""
// Rust: tests/web_scaffold.rs:131
pub fn assert_web_dom_output(project: OSPath) -> {
    build :: project.join(".jet/build")
    harness :: build.join("web_dom_harness.mjs")
    fs.write(&harness, WEB_DOM_HARNESS).expect("write Web DOM harness")
    output :: Command.new("node").current_dir(&build).arg("web_dom_harness.mjs").output().expect("spawn Web DOM harness")
    _ :: fs.remove_file(harness)
    assert(output.status.success(), "generated Web app did not render the greeting:\nstdout: {String.from_utf8_lossy(&output.stdout)}\nstderr: {String.from_utf8_lossy(&output.stderr)}")
    assert_no_scaffold_diagnostic("Web DOM harness", &output.stdout, &output.stderr)
    assert(String.from_utf8_lossy(&output.stdout).contains("hello, world"), "generated Web DOM omitted the greeting:\n{String.from_utf8_lossy(&output.stdout)}")
}
// Rust: tests/web_scaffold.rs:155
pub fn assert_no_scaffold_diagnostic(label: String, stdout: [U8], stderr: [U8]) -> {
    output :: "{String.from_utf8_lossy(stdout)}\n{String.from_utf8_lossy(stderr)}"
    loop code in ["E-WEB-TIR-UNSUPPORTED", "E2937", "ICE"] { assert(!output.contains(code), "{label} emitted scaffold drift diagnostic {code}:\n{output}") }
}
