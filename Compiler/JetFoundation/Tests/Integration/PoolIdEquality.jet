//RS const PACKAGE_SOURCE: &str = r#"
//RS name: "print_branch_tiers"
//RS version: "0.1.0"
//RS authority: { holds: { allow: [IO] } }
//RS "#;
//RS 
//RS /// Every primitive reaches the canonical print operation and renders the same
//RS /// bytes on every tier.  The bound locals cover the resident JIT reading a
//RS /// `let` back through a different place row than the one it wrote (one stack
//RS /// slot per local, not per place row); the interpolated line covers the shared
//RS /// Display route and the allocation layer AOT needs to build it.
//RS const PRINT_PRIMITIVES: &str = r#"
//RS fn run() {
//RS     print(1)
//RS     print(-7)
//RS     print(1 + 2)
//RS     print(true)
//RS     print(false)
//RS     print(1.5)
//RS     print(2.0)
//RS     print("s")
//RS     print('c')
//RS     print(1, "two", 3)
//RS     x :: 3
//RS     print(x)
//RS     s :: "text"
//RS     print(s)
//RS     print("v={x + 1} b={x > 2} s={s}")
//RS }
//RS "#;
//RS 
//RS const PRINT_PRIMITIVES_STDOUT: &str =
//RS     "1\n-7\n3\ntrue\nfalse\n1.5\n2.0\ns\nc\n1\ntwo\n3\n3\ntext\nv=4 b=true s=text\n";
//RS 
//RS /// A concrete automatic Printable, an explicit Display override, and one
//RS /// variadic call whose arguments print while they are evaluated.  The helper
//RS /// and operator both return `D` so the tier must preserve the checked
//RS /// Printable value until the backend renders it; the variadic output proves
//RS /// both left-to-right argument evaluation and delayed emission.
//RS const PRINTABLE_DISPLAY_VARIADIC: &str = r#"
//RS struct D {
//RS     value: Int
//RS }
//RS 
//RS struct Pair {
//RS     a: Int
//RS     b: Int
//RS }
//RS 
//RS fn align(left: D, right: D) -> Pair -> Pair{a: left.value, b: right.value}
//RS 
//RS impl D.Add {
//RS     fn add(self, rhs: D) -> D {
//RS         pair :: align(self, rhs)
//RS         return D{value: pair.a + pair.b}
//RS     }
//RS }
//RS 
//RS enum Envelope {
//RS     Pair(left: D, right: D)
//RS }
//RS 
//RS struct Shown {
//RS     value: Int
//RS }
//RS 
