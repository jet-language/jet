// Rust: tests/jet_perf_trace_parts/capture_run.rs:125
pub fn profile_row_identity(text: String) -> (String, String, [(String, String, [I64])]) {
    trace := parse_json(text).unwrap_or_else(_ -> panic("trace is not JSON: {text}"))
    profile := json_get(trace, "content").and_then(content -> json_get(content, "profile")).unwrap_or_else(() -> panic("missing profile: {text}"))
    field := (key: String) -> json_get(profile, key).and_then(json_str).unwrap().to_string()
    rows_value := json_get(profile, "rows").unwrap()
    rows := if rows_value == {
        .Array(values) -> values
        else -> panic("profile rows are not an array: {text}")
    }
    identities := rows.iter().map(row -> {
        source := json_get(row, "source").unwrap()
        position := (key: String) -> json_get(source, key).and_then(json_int).unwrap()
        (json_get(row, "clock").and_then(json_str).unwrap().to_string(),
         json_get(json_get(row, "symbol").unwrap(), "name").and_then(json_str).unwrap().to_string(),
         [position("start_line"), position("start_column"), position("end_line"), position("end_column")])
    }).collect()
    (field("status"), field("window_status"), identities)
}
