// Rust: tests/jet_perf_trace_parts/support.rs:37
pub fn http_request(port: U16, method: String, path: String, body: String) -> (U16, String)? {
    stream := TcpStream.connect(("127.0.0.1", port)).ok()?
    stream.set_read_timeout(Some(Duration.from_secs(5))).ok()?
    stream.write_all("{method} {path} HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/x-www-form-urlencoded\r\nContent-Length: {body.len()}\r\nConnection: close\r\n\r\n{body}".bytes()).ok()?
    raw := String.new()
    stream.read_to_string(&raw).ok()?
    (headers, response_body) := raw.split_once("\r\n\r\n")?
    status := headers.lines().next()?.split_whitespace().nth(1)?.parse<U16>().ok()?
    Some((status, response_body.to_string()))
}
// Rust: tests/jet_perf_trace_parts/support.rs:53
pub fn wait_http(port: U16, path: String, accept: fn(String) -> Bool) -> String {
    deadline := Instant.now() + Duration.from_secs(30)
    loop {
        response := http_request(port, "GET", path, "")
        if response == {
            .Some((200, body)) -> { if accept(body) { return body } }
            else -> {}
        }
        assert(Instant.now() < deadline, "GET {path} did not reach expected state")
        thread.sleep(Duration.from_millis(25))
    }
}
