}
// Rust: tests/jet_perf_trace_parts/support.rs:74
pub struct ChildGuard { child: Child }
// Rust: tests/jet_perf_trace_parts/support.rs:76
impl ChildGuard.Drop {
    // Rust: tests/jet_perf_trace_parts/support.rs:77
    fn drop(&self) -> {
        pid := self.child.id()
        _ :: self.child.kill()
        _ :: self.child.wait()
        _ :: fs.remove_file(LiveInspect.snapshot_path(pid))
        _ :: fs.remove_file(BrowserTrace.relay_path(pid))
        _ :: fs.remove_file(BrowserTrace.request_path(pid))
    }
}
// Rust: tests/jet_perf_trace_parts/support.rs:87
pub fn json_u64_after(haystack: String, key: String) -> U64? {
    needle := "\"{key}\":"
    tail := haystack.split_once(needle)?.1
    digits: String := tail.chars().take_while(ch -> ch.is_ascii_digit()).collect()
    digits.parse<U64>().ok()
}
// Rust: tests/jet_perf_trace_parts/support.rs:94
pub fn json_string_after(haystack: String, key: String) -> String? {
    needle := "\"{key}\":\""
    haystack.split_once(needle)?.1.split_once('"').map((value, _) -> value.to_string())
}
// Rust: tests/jet_perf_trace_parts/support.rs:99
pub fn assert_completed_io_bound_to_tasks(text: String) -> {
    io := text.split_once("\"io\":[").and_then((_, tail) -> tail.split_once("],\"locks\"")).map((array, _) -> array).unwrap_or_else(() -> panic("missing io array: {text}"))
    tasks := text.split_once("\"tasks\":[").and_then((_, tail) -> tail.split_once("],\"toolchain\"")).map((array, _) -> array).unwrap_or_else(() -> panic("missing tasks array: {text}"))
    task_index: [U64: String] := [:]
    loop task in tasks.split("}},{{") { task_index.insert(json_u64_after(task, "id").unwrap(), task.to_string()) }
    spans := 0
    loop span in io.split("}},{{") {
        task_id := json_u64_after(span, "task_id").unwrap_or_else(() -> panic("I/O span missing task_id: {span}"))
        task := task_index.get(task_id).unwrap_or_else(() -> panic("I/O task {task_id} missing: {text}"))
        assert(task.contains("\"state\":\"done\""), "I/O task {task_id} not done: {task}")
        assert(task.contains("\"wait\":\"\""), "done I/O task {task_id} retained wait: {task}")
        start := json_u64_after(span, "start_ns").unwrap()
        end := json_u64_after(span, "end_ns").unwrap()
        assert(end > start, "completed I/O task {task_id} has no duration: {span}")
        spans += 1
    }
    assert(spans > 0, "no completed I/O spans: {text}")
}
// Rust: tests/jet_perf_trace_parts/support.rs:129
pub fn assert_honest_wall_and_alloc(text: String) -> {
    wall_at := text.find("\"domain\":\"wall\"").unwrap_or_else(() -> panic("missing wall sample: {text}"))
    wall_ns := json_u64_after(text[wall_at..], "duration_ns").unwrap_or_else(() -> panic("missing wall duration_ns: {text}"))
    assert(wall_ns > 1, "fabricated 1ns wall (or zero): duration_ns={wall_ns} in {text}")
    assert(wall_ns >= 1_000_000, "wall duration not real observed work: duration_ns={wall_ns} in {text}")
    alloc_at := text.find("\"allocations\":[{{").unwrap_or_else(() -> panic("missing allocations object: {text}"))
    count := json_u64_after(text[alloc_at..], "count").unwrap_or_else(() -> panic("missing alloc count: {text}"))
    bytes := json_u64_after(text[alloc_at..], "bytes").unwrap_or_else(() -> panic("missing alloc bytes: {text}"))
    assert(count > 0, "zero alloc count false-green: count={count} bytes={bytes} in {text}")
    assert(bytes > 0, "zero alloc bytes false-green: count={count} bytes={bytes} in {text}")
}
// Rust: tests/jet_perf_trace_parts/support.rs:162
pub fn assert_honest_tasks(text: String) -> {
    tasks_at := text.find("\"tasks\":[{{").unwrap_or_else(() -> panic("missing non-empty tasks array: {text}"))
    tasks := text[tasks_at..]
    assert(tasks.contains("\"parent\":0"), "missing root task parent=0: {text}")
    assert(tasks.contains("\"parent\":1") || tasks.contains("\"parent\":2"), "missing spawned child parent causality: {text}")
    assert(tasks.contains("\"state\":\"running\"") || tasks.contains("\"state\":\"blocked\"") || tasks.contains("\"state\":\"queued\"") || tasks.contains("\"state\":\"done\""), "missing live observe task state: {text}")
    assert(!text.contains("\"tasks\":[]"), "empty tasks false-green leaked beside non-empty claim: {text}")
}
// Rust: tests/jet_perf_trace_parts/support.rs:189
pub fn assert_honest_locks(text: String) -> {
    locks_at := text.find("\"locks\":[{{").unwrap_or_else(() -> panic("missing non-empty locks array: {text}"))
    locks := text[locks_at..]
    assert(locks.contains("\"kind\":\"channel\""), "missing channel lock kind: {text}")
    assert(locks.contains("\"recv_waiters\":1") || locks.contains("\"recv_waiters\":2") || locks.contains("\"send_waiters\":1") || locks.contains("\"send_waiters\":2"), "missing contended waiters: {text}")
    assert(!text.contains("\"locks\":[]"), "empty locks false-green leaked beside non-empty claim: {text}")
    assert(!locks.contains("\"recv_waiters\":0,\"send_waiters\":0") && !locks.contains("\"send_waiters\":0,\"recv_waiters\":0"), "idle zero-waiter lock row leaked: {text}")
}
// Rust: tests/jet_perf_trace_parts/support.rs:217
pub fn assert_honest_io(text: String) -> {
    io_at := text.find("\"io\":[{{").unwrap_or_else(() -> panic("missing non-empty io array: {text}"))
    after := text[io_at + "\"io\":[".len()..]
    array_end := after.find(']').unwrap_or_else(() -> panic("unclosed io array: {text}"))
    io := after[..array_end]
    assert(io.contains("\"kind\":\"tcp\""), "missing tcp io kind: {text}")
    assert(io.contains("\"wait\":\"tcp accept\"") || io.contains("\"wait\":\"tcp accept readiness\""), "missing real tcp accept wait: {text}")
    assert(io.contains("\"task_id\":"), "missing io task_id: {text}")
    start := json_u64_after(io, "start_ns").unwrap_or_else(() -> panic("missing session-relative io start_ns: {text}"))
    end := json_u64_after(io, "end_ns").unwrap_or_else(() -> panic("missing session-relative io end_ns: {text}"))
    assert(end >= start, "io span runs backward: start={start} end={end} in {text}")
    assert(!text.contains("\"io\":[]"), "empty io false-green leaked beside non-empty claim: {text}")
    assert(!io.contains("\"wait\":\"time sleep\"") && !io.contains("\"wait\":\"channel "), "non-I/O wait leaked into io: {io}")
}
// Rust: tests/jet_perf_trace_parts/support.rs:253
pub fn assert_honest_native(text: String, expect_elapsed: Bool, expect_cpu_work: Bool) -> {
    native_at := text.find("\"native\":[{{").unwrap_or_else(() -> panic("missing native timing: {text}"))
    native := text[native_at..]
    assert(native.contains("\"clock\":\"process_cpu\""), "{text}")
    observed := json_u64_after(native, "observed_at_ns").unwrap_or_else(() -> panic("missing native session-relative clock: {text}"))
    if expect_elapsed {
        assert(observed > 0, "run native observation did not advance: {text}")
        wall_at := text.find("\"domain\":\"wall\"").unwrap()
        wall := json_u64_after(text[wall_at..], "duration_ns").unwrap()
        assert(observed <= wall, "native observation is after trace wall: {text}")
    }
    target := json_string_after(native, "target").unwrap_or_else(() -> panic("missing native target: {text}"))
    // GATE #4483: selected target OS, not host cfg.
    if selected_os() == "linux" || selected_os() == "android" {
        assert(native.contains("\"status\":\"captured\""), "{text}")
        duration := json_u64_after(native, "duration_ns").unwrap_or_else(() -> panic("missing captured native duration: {text}"))
        if expect_cpu_work { assert(duration > 0, "deliberate CPU work captured as zero: {text}") }
        assert(native.contains("\"reason\":\"\""), "{text}")
        assert(native.contains("\"task_id\":1"), "{text}")
    } else {
        assert(native.contains("\"status\":\"unavailable\""), "{text}")
        assert(native.contains("\"duration_ns\":null"), "{text}")
        assert(native.contains("\"task_id\":null"), "{text}")
        assert(native.contains("\"reason\":\"process CPU timing is unavailable on target {target}\""), "{text}")
    }
    assert(text.contains("\"native_row_limit\":1"), "{text}")
    assert(text.contains("\"native_rows_truncated\":false"), "{text}")
}
// Rust: tests/jet_perf_trace_parts/support.rs:293
pub fn assert_honest_spans(text: String, expect_captured: Bool) -> {
    spans := text.split_once("\"spans\":[").and_then((_, tail) -> tail.split_once("],\"tasks\"")).map((array, _) -> array).unwrap_or_else(() -> panic("missing spans array: {text}"))
    assert(spans.contains("\"clock\":\"monotonic\""), "{text}")
    assert(spans.contains("\"kind\":\"task_observed\""), "{text}")
    assert(text.contains("\"span_row_limit\":4096"), "{text}")
    assert(text.contains("\"span_rows_truncated\":false"), "{text}")
    if !expect_captured {
        assert(spans.contains("\"status\":\"unavailable\""), "{text}")
        assert(spans.contains("\"start_ns\":null"), "{text}")
        assert(spans.contains("\"end_ns\":null"), "{text}")
        assert(spans.contains("\"task_id\":null"), "{text}")
        assert(spans.contains("\"parent_task_id\":null"), "{text}")
        assert(spans.contains("task span requires multiple live observations"), "{text}")
        return
    }
    assert(!spans.is_empty(), "empty captured span set: {text}")
    assert(!spans.contains("\"status\":\"unavailable\""), "{text}")
    tasks := text.split_once("\"tasks\":[").and_then((_, tail) -> tail.split_once("],\"toolchain\"")).map((array, _) -> array).unwrap_or_else(() -> panic("missing task array: {text}"))
    task_index: [U64: String] := [:]
    loop task in tasks.split("}},{{") { task_index.insert(json_u64_after(task, "id").unwrap(), task.to_string()) }
    wall_at := text.find("\"domain\":\"wall\"").unwrap()
    wall := json_u64_after(text[wall_at..], "duration_ns").unwrap()
    count := 0
    loop span in spans.split("}},{{") {
        assert(span.contains("\"status\":\"captured\""), "{span}")
        task_id := json_u64_after(span, "task_id").unwrap()
        task := task_index.get(task_id).unwrap_or_else(() -> panic("span task {task_id} missing: {text}"))
        start := json_u64_after(span, "start_ns").unwrap()
        end := json_u64_after(span, "end_ns").unwrap()
        assert(end >= start, "span runs backward: {span}")
        assert(end <= wall, "span ends after trace wall: {span}")
        parent := json_u64_after(task, "parent").unwrap()
        if parent == 0 { assert(span.contains("\"parent_task_id\":null"), "{span}") }
        else { assert_eq(json_u64_after(span, "parent_task_id"), Some(parent), "{span}") }
        count += 1
    }
    assert_eq(count, tasks.split("}},{{").count(), "span/task count drift: {text}")
}
// Rust: tests/jet_perf_trace_parts/views.rs:224
pub fn profiler_fixture_source() -> String {
    "fn run() {{\n    hot()\n}}\nfn hot() {{\n}}\nfn cold() {{\n}}\n"
}
// Rust: tests/jet_perf_trace_parts/views.rs:228
pub fn profiler_fixture_row(clock: String, name: String, start_line: U64, end_column: U64, sample_count: U64, source_sha256: String) -> TraceProfileRow {
    TraceProfileRow{clock: clock, execution_count: None, sample_count: sample_count, sample_weight: sample_count,
        source: TraceProfileSource{path: "profile.jet", sha256: source_sha256, start_line: start_line, start_column: 1, end_line: start_line, end_column: end_column},
        symbol: JetSymbolRef{path: "profile.jet", name: name}}
}
// Rust: tests/jet_perf_trace_parts/views.rs:256
pub fn profiler_fixture(state: String) -> [U8] {
    source := profiler_fixture_source()
    source_sha256 := SHA256.sha256_hex(source.bytes())
    hot_wall := profiler_fixture_row("wall", "hot", 4, 7, 37, source_sha256)
    hot_cpu := profiler_fixture_row("cpu", "hot", 4, 7, 11, source_sha256)
    cold_wall := profiler_fixture_row("wall", "cold", 6, 8, 1, source_sha256)
    profile := if state == {
        "captured" -> TraceProfile{method: "sampling", status: "captured", coverage: "complete", rows: [hot_wall, hot_cpu, cold_wall], row_limit: TRACE_PROFILE_ROW_LIMIT as U64, rows_truncated: false, overhead_ns: Some(3), overhead_status: "measured", overhead_reason: "fixture sampling overhead", reason: "source-attributed sampling retained hot and cold rows", window_status: "exit", window_wall_ns: Some(5_000_000), window_cpu_ns: Some(4_000_000), window_reason: "published by the runtime at its exit seam"}
        "no_samples" -> TraceProfile{method: "sampling", status: "no_samples", coverage: "none", rows: [], row_limit: TRACE_PROFILE_ROW_LIMIT as U64, rows_truncated: false, overhead_ns: None, overhead_status: "not_measured", overhead_reason: "no source samples were retained", reason: "the observe channel produced no source-attributed samples", window_status: "unavailable", window_wall_ns: None, window_cpu_ns: None, window_reason: "the runtime published no run window"}
        "unsupported" -> TraceProfile.unsupported("source sampling is unsupported for fixture")
        "truncated" -> TraceProfile{method: "sampling", status: "truncated", coverage: "partial", rows: [hot_wall], row_limit: TRACE_PROFILE_ROW_LIMIT as U64, rows_truncated: true, overhead_ns: None, overhead_status: "not_measured", overhead_reason: "no matched non-profiled run was captured", reason: "sampling observations exceeded the bounded profile sample limit", window_status: "live", window_wall_ns: Some(9_000_000), window_cpu_ns: None, window_reason: "the runtime has no process CPU clock on this target"}
        "dropped" -> TraceProfile{method: "sampling", status: "truncated", coverage: "partial", rows: [hot_wall], row_limit: TRACE_PROFILE_ROW_LIMIT as U64, rows_truncated: true, overhead_ns: None, overhead_status: "not_measured", overhead_reason: "no matched non-profiled run was captured", reason: "dropped_rows=1 at bounded profile sample limit", window_status: "unavailable", window_wall_ns: None, window_cpu_ns: None, window_reason: "the runtime published no run window"}
        else -> panic("unknown profiler fixture state {state}")
    }
    skeleton := TraceSkeleton{command: "run", argv: ["run", "profile.jet"],
        toolchain: TraceToolchain{jet_version: "fixture", compiler_build_id: "profile-fixture", stdlib_id: "profile-stdlib", runner_id: "profile-runner"},
        hardware: TraceHardware{cpu_arch: "x86_64", logical_cpus: 1, os: "fixture", target: "profile-target"},
        capture_policy: CapturePolicy.default_exclusions(), samples: [], profile: profile, allocations: [], browser: [], game_frames: [], game_draw_events: [], tasks: [], locks: [], io: [], native: [], spans: [], receipt_sections: [],
        source_identity: [SourceIdentity{path: "profile.jet", sha256: source_sha256, symbols: [("cold", "fn"), ("hot", "fn"), ("run", "fn")]}],
        source_maps: [TraceSourceMap.jet_with_source("profile.jet", source)]}
    build_skeleton_bytes(skeleton).unwrap()
}
