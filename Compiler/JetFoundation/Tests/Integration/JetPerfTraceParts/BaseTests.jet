// Rust: tests/jet_perf_trace_parts/browser.rs:5
#Test("perf_attach_uses_compiler_browser_map_after_source_changes") {
    guard := SELF_ATTACH_LOCK.lock().unwrap()
    root := temp_workspace()
    source := root.join("browser.jet")
    original := "#Target(Web)\nuse core.web as web\nmodule handlers {{\n    #Target(JS)\n    pub fn init() {{ web.on(\"#field\", \"input\", (ev) -> {{}}) }}\n}}\n#Target(JS)\nfn run() {{ handlers.init() }}\n"
    fs.write(source, original).unwrap()
    compiled := compile_web_with_path(original, source.to_str().unwrap()).unwrap()
    manifest := compiled.web.unwrap().manifest_json
    relay := BrowserTrace.Relay.new(manifest).unwrap()
    fs.write(source, "fn run() {{}}\n").unwrap()
    relay.record("class=event&symbol=handlers__init%24handler0&start_ns=100&duration_ns=25&clock_ns=125".bytes()).unwrap()
    out := root.join("browser.jettrace")
    attach := run_jet(root, ["perf", "attach", id().to_string(), "--out", out.to_str().unwrap()])
    assert(attach.status.success(), "{String.from_utf8_lossy(attach.stderr)}")
    bytes := fs.read(out).unwrap()
    verify_jettrace(bytes).unwrap()
    text := String.from_utf8(bytes).unwrap()
    assert(text.contains("\"name\":\"handlers__init$handler0\""), "{text}")
    assert(text.contains("\"sha256\":\"{SHA256.sha256_hex(original.bytes())}\""), "{text}")
    assert(!text.contains(SHA256.sha256_hex("fn run() {{}}\n".bytes())), "source was reread: {text}")
    assert(text.contains("\"source_maps\":[{{"), "missing embedded source maps: {text}")
    assert(text.contains("\"kind\":\"js\""), "missing js source map: {text}")
    assert(text.contains("\"domain\":\"wall\"") || text.contains("\"domain\":\"cpu\"") || text.contains("\"native\":[{{"), "browser attach missing host domains: {text}")
    relay.drop()
    _ :: fs.remove_dir_all(root)
}
