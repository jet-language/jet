use jet_foundation.Tests.Integration.Common.Mod.[unsafe_keyword_columns, strip_vetted_prelude_modules, parsed_cap_gb, GUARD_CAP_CEILING_GB, resolve_suite_budget, suite_name_from_exe_stem, parse_suite_budgets, SUITE_BUDGET_LEDGER, SUITE_BUDGET_LEDGER_PATH, DEFAULT_SUITE_BUDGET_SECS]
// Rust: tests/common/mod.rs:2091
#Test("unsafe_keyword_scan_reads_code_not_data") {
    path_argument :: "    let __jet_stack_frame = crate::jet_stack_enter(\"Examples/features/memory/unsafe_sentries.jet\", 5, \"run\", \"fn run() {{\");"
    assert(unsafe_keyword_columns(path_argument).is_empty(), "an example's own path in a stack-frame argument is data, not an `unsafe` block")
    sentry :: "        let _jet_sentry = jet_mem::jet_sentry_scope(true, \"Examples/features/lowlevel/unsafe_obligations.jet\", 5, \"cell stays live\");"
    assert(unsafe_keyword_columns(sentry).is_empty(), "sentry reason strings are data")
    user_string :: "        {{ let _ = jet_term_write_stdout_line(&((\"unsafe gate\".to_string()).jet_show()), false); }};"
    assert(unsafe_keyword_columns(user_string).is_empty(), "a printed string is data")
    assert(unsafe_keyword_columns("// unsafe {{ … }} in a comment").is_empty())
    assert(unsafe_keyword_columns("    let unsafe_flag = 1;").is_empty(), "identifier, not keyword")
    assert_eq(unsafe_keyword_columns("    unsafe {{").len(), 1, "the gated block form must count")
    assert_eq(unsafe_keyword_columns("unsafe extern \"C\" fn InitWindow() {{}}").len(), 1, "an `unsafe extern` item must count even though the line also holds a string")
    assert_eq(unsafe_keyword_columns("    let p = unsafe {{ *raw }}; // unsafe read").len(), 1, "code counts once; the trailing comment does not add a second")
}
// Rust: tests/common/mod.rs:2212
#Test("vetted_module_stripping_cannot_swallow_following_user_unsafe") {
    generated :: """
before
// JET_VETTED_UNSAFE_BEGIN: jet_watch_process_probe
#[cfg(windows)]
mod audited { const TEXT: &str = r#"{ comment-like }"#; unsafe { ffi() } }
// JET_VETTED_UNSAFE_END: jet_watch_process_probe
fn user() { unsafe { user_pointer() } }
"""
    stripped :: strip_vetted_prelude_modules(generated)
    assert(!stripped.contains("ffi()"))
    assert(stripped.contains("unsafe {{ user_pointer() }}"))
}
// Rust: tests/common/mod.rs:2226
#Test("vetted_module_stripping_tracks_nested_block_comments") {
    generated :: """
mod jet_mem {
    /* outer comment /* nested comment with } */ still outer */
    const VALUE: i32 = 1;
}
unsafe { user_pointer() }
"""
    stripped :: strip_vetted_prelude_modules(generated)
    assert(!stripped.contains("mod jet_mem"))
    assert(stripped.contains("unsafe {{ user_pointer() }}"))
}
// Rust: tests/common/mod.rs:2240
#Test("term_mode_stripping_removes_all_platform_variants_without_hiding_user_unsafe") {
    generated :: """
#[cfg(unix)]
mod jet_term_mode { unsafe { unix_ffi() } }
#[cfg(windows)]
mod jet_term_mode { unsafe { windows_ffi() } }
#[cfg(not(any(unix, windows)))]
mod jet_term_mode { unsafe { other_ffi() } }
unsafe { user_pointer() }
"""
    stripped :: strip_vetted_prelude_modules(generated)
    assert(!stripped.contains("unix_ffi()"))
    assert(!stripped.contains("windows_ffi()"))
    assert(!stripped.contains("other_ffi()"))
    assert(stripped.contains("unsafe {{ user_pointer() }}"))
}
// Rust: tests/common/mod.rs:2258
#Test("raylib_bridge_stripping_cannot_swallow_following_user_unsafe") {
    generated :: "// jet:raylib-begin\nunsafe extern \"C\" fn InitWindow() {{}}\n// jet:raylib-end\nunsafe {{ user_pointer() }}"
    stripped :: strip_vetted_prelude_modules(generated)
    assert(!stripped.contains("InitWindow"))
    assert(stripped.contains("unsafe {{ user_pointer() }}"))
}
// Rust: tests/common/mod.rs:2266
#Test("audited_source_markers_strip_only_registered_regions") {
    names :: ["jet_foundation_sha256", "jet_foundation_numeric", "jet_term_kernel", "jet_atomic_carrier", "jet_std_common_types", "jet_std_math_task_mem", "jet_std_reactive_event_watch", "jet_std_ffi_callbacks", "jet_testing_history_foundation", "jet_testing_history_top", "jet_data_flow"]
    generated := ""
    for name in names { generated.push_str("// JET_VETTED_UNSAFE_BEGIN: {name}\nunsafe {{ {name}() }}\n// JET_VETTED_UNSAFE_END: {name}\n") }
    generated.push_str("// JET_VETTED_UNSAFE_BEGIN: unregistered\nunsafe {{ unregistered() }}\n// JET_VETTED_UNSAFE_END: unregistered\nunsafe {{ user_pointer() }}")
    stripped :: strip_vetted_prelude_modules(&generated)
    for name in names { assert(!stripped.contains("{name}()")) }
    assert(stripped.contains("unsafe {{ unregistered() }}"))
    assert(stripped.contains("unsafe {{ user_pointer() }}"))
}
// Rust: tests/common/mod.rs:2301
#Test("garbage_alloc_cap_env_value_clamps_to_a_sane_cap") {
    gb :: parsed_cap_gb(Val("999999999999999999"))
    assert(gb >= 1 && gb <= GUARD_CAP_CEILING_GB, "gb={gb} not clamped")
    bytes :: gb.saturating_mul(1 << 30)
    assert(bytes > 0, "cap bytes must stay positive, got {bytes}")
    assert_eq(parsed_cap_gb(nil), 10)
    assert_eq(parsed_cap_gb(Val("not a number")), 10)
    assert_eq(parsed_cap_gb(Val("0")), 1, "0 GB must clamp up to the 1 GB floor")
}
// Rust: tests/common/mod.rs:2325
#Test("suite_budget_defaults_to_900s_and_env_can_only_tighten") {
    ledger :: "# comment\nslow_measurement 5400 ratified sample policy\n"
    (secs, source) :: resolve_suite_budget("some_unit_suite", ledger, nil)
    assert_eq(secs, 900, "an unlisted suite keeps the 900s default")
    assert(source.contains("900s default"), "source: {source}")
    assert(source.contains("no `some_unit_suite` row"), "source: {source}")
    (named_secs, named_source) :: resolve_suite_budget("slow_measurement", ledger, nil)
    assert_eq(named_secs, 5400, "a named row is the suite's budget")
    assert(named_source.contains("committed `slow_measurement` row"), "source: {named_source}")
    assert(named_source.contains("ratified sample policy"), "the reason travels: {named_source}")
    (tight_secs, tight_source) :: resolve_suite_budget("some_unit_suite", ledger, Val("3"))
    assert_eq(tight_secs, 3)
    assert(tight_source.starts_with("JET_TEST_DEADLINE_SECS=3, tightening"), "source: {tight_source}")
    assert_eq(resolve_suite_budget("some_unit_suite", ledger, Val("36000")).0, 900)
    assert_eq(resolve_suite_budget("slow_measurement", ledger, Val("36000")).0, 5400)
    assert_eq(resolve_suite_budget("some_unit_suite", ledger, Val("0")).0, 900, "a zero deadline would abort instantly; it is garbage, not a tightening")
    assert_eq(resolve_suite_budget("slow_measurement", "slow_measurement lots", nil).0, 900)
    assert_eq(resolve_suite_budget("slow_measurement", "slow_measurement 5400", nil).0, 900)
}
// Rust: tests/common/mod.rs:2387
#Test("suite_name_comes_from_the_test_binary_cargo_built") {
    assert_eq(suite_name_from_exe_stem("cli_compile_latency-1a2b3c4d5e6f7a8b"), "cli_compile_latency")
    assert_eq(suite_name_from_exe_stem("cli_compile_latency"), "cli_compile_latency")
    assert_eq(suite_name_from_exe_stem("cli-runtime"), "cli-runtime")
    assert_eq(suite_name_from_exe_stem("-1a2b3c4d5e6f7a8b"), "-1a2b3c4d5e6f7a8b")
}
// Rust: tests/common/mod.rs:2408
#Test("the_committed_suite_budget_table_parses") {
    rows :: parse_suite_budgets(SUITE_BUDGET_LEDGER).unwrap_or_else(fn(err) { panic("{SUITE_BUDGET_LEDGER_PATH} does not parse: {err}") })
    for row in &rows { assert(row.secs > DEFAULT_SUITE_BUDGET_SECS, "{SUITE_BUDGET_LEDGER_PATH}: `{row.suite}` asks for {row.secs}s, at or under the {DEFAULT_SUITE_BUDGET_SECS}s default. A row that buys nothing is a row to delete.") }
}
