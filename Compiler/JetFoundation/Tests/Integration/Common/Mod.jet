//RS 
//RS /// Text that only appears when a Rust control transfer killed a process instead
//RS /// of becoming a Jet report (R13 / D-JITUNWIND1, #1995 / #1997).
//RS ///
//RS /// One list, because the two checks that need it must not drift: the JIT
//RS /// boundary suite (`tests/jit_no_unwind_boundary.rs`) asserts a cancelled task
//RS /// never aborts, and the example-corpus gate refuses to *classify* an abort at
//RS /// all. `streams/generators` is why the second one exists — it died with
//RS /// `panic in a destructor during cleanup` and the gate filed it as the benign
//RS /// row `AOT exit 1`, so an abort became a shrink-only ledger entry instead of a
//RS /// failure.
//RS ///
//RS /// The four families, which are four different defects:
//RS ///
//RS /// * `failed to initiate panic` is `_URC_END_OF_STACK`: phase 1 walked off the
//RS ///   top of the stack without finding a handler, because `cranelift-jit`
//RS ///   registers no unwind information for the code it emits.
//RS /// * `non-unwinding panic` / `panic in a function that cannot unwind` is an
//RS ///   `extern "C"` body's own abort-on-unwind shim.
//RS /// * `panic in a destructor during cleanup` is a second raise from drop glue
//RS ///   while an unwind is already in flight (#2007).
//RS /// * `fatal runtime error: stack overflow` is real stack exhaustion — the only
//RS ///   one `jet_foundation::CompilerStack::COMPILER_STACK_SIZE` can answer for.
//RS ///   Listed so a failure names which abort it saw rather than guessing.
//RS pub const ABORT_MARKERS: &[&str] = &[
//RS     "failed to initiate panic",
//RS     "non-unwinding panic",
//RS     "panic in a function that cannot unwind",
//RS     "panic in a destructor during cleanup",
//RS     "core::panicking",
//RS     "fatal runtime error: stack overflow",
//RS ];
//RS 
//RS /// The abort marker `stderr` carries, if any.
//RS pub fn abort_marker(stderr: &str) -> Option<&'static str> {
//RS     ABORT_MARKERS
//RS         .iter()
//RS         .copied()
//RS         .find(|marker| stderr.contains(marker))
//RS }
