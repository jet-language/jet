// Rust: tests/common/mod.rs:1267
fn unified_diff(expected_name: String, actual_name: String, expected: String, actual: String) -> String {
    expected_lines :: bounded_diff_lines(expected)
    actual_lines :: bounded_diff_lines(actual)
    columns :: actual_lines.lines.len() + 1
    lcs := [Int].filled((expected_lines.lines.len() + 1) * columns, 0)
    for i in (0..expected_lines.len()).rev() {
        for j in (0..actual_lines.lines.len()).rev() {
            here :: i * columns + j
            lcs[here] = if expected_lines.lines[i] == actual_lines.lines[j] { lcs[(i + 1) * columns + j + 1] + 1 } else { lcs[(i + 1) * columns + j].max(lcs[i * columns + j + 1]) }
        }
    }
    out := BoundedDiffOutput.new()
    out.push("--- {expected_name}\n+++ {actual_name}\n")
    push_input_truncation(&out, "expected", expected, &expected_lines)
    push_input_truncation(&out, "actual", actual, &actual_lines)
    out.push("@@ -1,{expected_lines.lines.len()} +1,{actual_lines.lines.len()} @@\n")
    i := 0
    j := 0
    loop i < expected_lines.lines.len() || j < actual_lines.lines.len() {
        if i < expected_lines.lines.len() && j < actual_lines.lines.len() && expected_lines.lines[i] == actual_lines.lines[j] {
            push_diff_line(&out, ' ', expected_lines.lines[i], expected_lines.cut_mid_line && i + 1 == expected_lines.lines.len())
            i += 1
            j += 1
        } else if j < actual_lines.lines.len() && (i == expected_lines.lines.len() || lcs[i * columns + j + 1] >= lcs[(i + 1) * columns + j]) {
            push_diff_line(&out, '+', actual_lines.lines[j], actual_lines.cut_mid_line && j + 1 == actual_lines.lines.len())
            j += 1
        } else {
            push_diff_line(&out, '-', expected_lines.lines[i], expected_lines.cut_mid_line && i + 1 == expected_lines.lines.len())
            i += 1
        }
    }
    out.finish()
}
