//RS // --- interactive example stdin ----------------------------------------------
//RS //
//RS // An interactive example's checked-in golden is only reproducible against the
//RS // answers it was recorded with, and five suites feed those answers
//RS // (`tests/golden.rs`, `tests/terminal.rs`, `tests/jit_run.rs`,
//RS // `tests/corelib_parts/http_data.rs`, and the `tests/dev*.rs` batteries). They
//RS // live here once. A second copy is how a golden and a harness drift apart while
//RS // neither one looks wrong on its own — and a harness that feeds nothing at all
//RS // silently compares a no-input run against a fed-input golden.
//RS //
//RS // #2017 recorded the mechanism as well as the bytes: a harness feeds a CHILD
//RS // process, never an injected reader. The in-process entry points read the test
//RS // binary's own fd 0, shared by every thread of a parallel suite, and an
//RS // injected reader would exercise an input path no user has.
//RS 
//RS /// The answers one example needs on stdin.
//RS pub struct ExampleStdin {
//RS     /// Answers for a run whose stdin is a pipe or a file. This is what the
//RS     /// checked-in `Examples/features/expected/<stem>.out` golden was recorded
//RS     /// against, so it is also what any harness comparing against that golden
//RS     /// owes the program.
//RS     pub piped: &'static str,
//RS     /// The extra answers a run on a real terminal reaches and a piped run does
//RS     /// not. Empty when a terminal run reads exactly what a piped run reads.
//RS     pub tty_only: &'static str,
//RS }
//RS 
//RS impl ExampleStdin {
//RS     /// Answers for a run on a real terminal.
//RS     pub fn tty(&self) -> String {
//RS         format!("{}{}", self.piped, self.tty_only)
//RS     }
//RS }
//RS 
//RS /// `io/terminal_parity` answers, in program order:
//RS ///   `io.confirm`      — an empty line takes the `[y/N]` default, so `false`;
//RS ///   `io.choose`       — `not-a-number` and `3` are both rejected (the golden's
//RS ///                       two `Enter a number from 1 to 2.` lines), then `2`
//RS ///                       selects `production`;
//RS ///   `io.input_secret` — reached only on a terminal. Off a terminal it answers
//RS ///                       `Err(InvalidInput)` without consuming a line, which is
//RS ///                       the golden's `secret: non-tty`; on a terminal it reads
//RS ///                       six characters, which is `secret length: 6`.
//RS const TERMINAL_PARITY_STDIN: ExampleStdin = ExampleStdin {
//RS     piped: "\nnot-a-number\n3\n2\n",
//RS     tty_only: "secret\n",
//RS };
//RS 
//RS /// `io/terminal` answers: one keystroke for the single `term.read_key()` call
//RS /// inside the example's `live { … }` block.
//RS ///
//RS /// Exactly one key, with no trailing newline, on purpose. `read_key` takes up
//RS /// to six bytes per call, so a piped script of several keys would be split by
//RS /// pipe buffering instead of by keystroke and the transcript would depend on
//RS /// the writer's chunking. One key is the same on a pipe and on a terminal, and
//RS /// the example never reads a second time, so a terminal run cannot block on an
//RS /// answer a piped run does not need — `tty_only` is therefore empty.
//RS const TERMINAL_STDIN: ExampleStdin = ExampleStdin {
//RS     piped: "h",
//RS     tty_only: "",
//RS };
//RS 
//RS const STDIN_INPUT_STDIN: ExampleStdin = ExampleStdin {
//RS     piped: "alpha\nbeta\n",
//RS     tty_only: "",
//RS };
//RS 
//RS const STDIN_READ_ALL_STDIN: ExampleStdin = ExampleStdin {
//RS     piped: "alpha\nbeta\n",
//RS     tty_only: "",
//RS };
//RS 
//RS const STDIN_READLINE_STDIN: ExampleStdin = ExampleStdin {
//RS     piped: "alpha\nbeta\n",
//RS     tty_only: "",
//RS };
//RS 
//RS /// The stdin an example needs, or `None` for the examples that read nothing.
//RS ///
//RS /// Keyed by example stem (`<topic>/<name>`) so a harness that already walks
//RS /// stems asks for the answers instead of naming the interactive examples
//RS /// again. Only an example whose checked-in golden was recorded WITH these
//RS /// answers belongs here: a harness that walks every stem uses this table to
//RS /// decide what to feed, so an entry whose golden is a no-input transcript
//RS /// would make that harness feed the wrong thing.
//RS pub fn example_stdin(stem: &str) -> Option<&'static ExampleStdin> {
//RS     match stem {
//RS         "io/terminal_parity" => Some(&TERMINAL_PARITY_STDIN),
//RS         "io/terminal" => Some(&TERMINAL_STDIN),
//RS         "io/stdin_input" => Some(&STDIN_INPUT_STDIN),
//RS         "io/stdin_read_all" => Some(&STDIN_READ_ALL_STDIN),
//RS         "io/stdin_readline" => Some(&STDIN_READLINE_STDIN),
//RS         _ => None,
//RS     }
//RS }
//RS 
