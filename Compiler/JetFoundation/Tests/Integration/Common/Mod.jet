// Rust: tests/common/mod.rs:1229
fn normalize_fixture_selector(var: String, raw: String) -> String {
    normalized_separators :: raw.trim().replace('\\', "/")
    assert(!normalized_separators.is_empty(), "{var} must not be empty")
    path :: OSPath(normalized_separators)
    assert(!path.is_absolute(), "{var} must be repository-relative: {normalized_separators}")
    parts := []
    for component in path.components() {
        if component == {
            .CurDir -> {}
            .Normal(part) -> parts.push(part.to_string_lossy().into_owned())
            .ParentDir | .RootDir | .Prefix(_) -> panic("{var} must not escape the repository: {normalized_separators}")
        }
    }
    assert(!parts.is_empty(), "{var} must name a fixture")
    parts.join("/")
}
