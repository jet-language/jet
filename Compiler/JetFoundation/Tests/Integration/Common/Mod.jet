//RS             format!(
//RS                 "the {DEFAULT_SUITE_BUDGET_SECS}s default (no `{suite}` row in \
//RS                  {SUITE_BUDGET_LEDGER_PATH})"
//RS             ),
//RS         ),
//RS     };
//RS     // 1..secs, both ends meaningful: 0 would abort instantly (garbage, not a
//RS     // tightening) and anything at or above the resolved budget is the loosening
//RS     // this law refuses.
//RS     if let Some(requested) = env_raw
