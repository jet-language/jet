const TEST_PACKAGE_MANIFEST: String = "name: \"test-fixture\"\nversion: \"0.1.0\"\n"
// Rust: tests/common/mod.rs:21
fn prepare_test_fixture_root(path: &OSPath) -> {
    fs.create_dir_all(path).unwrap_or_else(fn(error) { panic("create test fixture root `{path.display()}`: {error}") })
    if selected_family() == "unix" {
        fs.set_permissions(path, fs.Permissions.from_mode(0o700)).unwrap_or_else(fn(error) { panic("make test fixture root private `{path.display()}`: {error}") })
    }
    manifest :: path.join("package.jet")
    if fs.symlink_metadata(&manifest) == {
        .Ok(_) -> {}
        .Err(error) -> {
            if error.kind() == io.ErrorKind.NotFound {
                fs.write(&manifest, TEST_PACKAGE_MANIFEST).unwrap_or_else(fn(error) { panic("write test fixture manifest `{manifest.display()}`: {error}") })
            } else { panic("inspect test fixture manifest `{manifest.display()}`: {error}") }
        }
    }
}
