struct CraneliftTierPlan {
    whole_interp: Bool
    native: [String:Bool]
    deopt: [(String, String)]
    gap: String?
    rows: [TierRow]
}
// Rust: tests/common/mod.rs:126
fn cranelift_tier_plan(bundle: &ProgramBundle) -> CraneliftTierPlan {
    (program, artifact) :: lower_cranelift_bundle(bundle).expect("checked bundle must lower to Cranelift MIR")
    plan :: jet_jit.plan_mir_tiers(&program, artifact)
    rows :: plan.rows
    function_name :: fn(id) { rows.iter().find(fn(row) { row.function == id }).map(fn(row) { row.function_name.clone() }).unwrap_or_else(fn() { "function#{id:?}" }) }
    CraneliftTierPlan{whole_interp: plan.whole_program_deopt, native: plan.native.into_iter().map(fn(id) { (function_name(id), true) }).collect(), deopt: plan.deopt.into_iter().map(fn((id, reason)) { (function_name(id), reason) }).collect(), gap: plan.gap.map(fn(gap) { "{gap:?}" }), rows: rows}
}
