// Rust: tests/common/mod.rs:1021
struct NativeCatalogRecipe { name: String, version: String, bin: String, artifact_name: String, contents: [U8] }
// Rust: tests/common/mod.rs:1030
fn write_native_catalog(catalog: &OSPath, artifact_root: &OSPath, recipes: &[NativeCatalogRecipe]) -> {
    fs.create_dir_all(catalog).expect("create native catalog directory")
    fs.create_dir_all(artifact_root).expect("create native catalog artifact directory")
    records := [String].with_capacity(recipes.len())
    for recipe in recipes {
        assert(!recipe.artifact_name.is_empty() && !recipe.artifact_name.contains('/') && !recipe.artifact_name.contains('\\'), "native catalog artifact name must be one path component")
        artifact :: artifact_root.join(&recipe.artifact_name)
        fs.write(&artifact, &recipe.contents).expect("write native catalog artifact")
        if selected_family() == "unix" {
            permissions := fs.metadata(&artifact).expect("stat native catalog artifact").permissions()
            permissions.set_mode(0o755)
            fs.set_permissions(&artifact, permissions).expect("make native catalog artifact executable")
        }
        digest :: jetpack.SHA256.sha256_file_hex(&artifact).expect("hash native catalog artifact")
        url :: "file://{artifact.display()}"
        records.push("{{\"name\":\"{jet_foundation.JSON.json_escape(&recipe.name)}\",\"version\":\"{jet_foundation.JSON.json_escape(&recipe.version)}\",\"kind\":\"prebuilt\",\"url\":\"{jet_foundation.JSON.json_escape(&url)}\",\"sha256\":\"{digest}\",\"bin\":\"{jet_foundation.JSON.json_escape(&recipe.bin)}\"}}")
    }
    records.sort_unstable()
    fs.write(catalog.join("recipes-v1.json"), "{{\"schema\":1,\"recipes\":[{records.join(",")}]}}").expect("write native catalog recipes")
}
