//RS     assert!(
//RS         source.contains("ratified sample policy"),
//RS         "the reason travels: {source}"
//RS     );
//RS 
//RS     // Tightening is the env var's whole job — the guard self-test runs on it.
//RS     let (secs, source) = resolve_suite_budget("some_unit_suite", ledger, Some("3"));
//RS     assert_eq!(secs, 3);
//RS     assert!(
//RS         source.starts_with("JET_TEST_DEADLINE_SECS=3, tightening"),
//RS         "source: {source}"
//RS     );
//RS 
//RS     // Loosening is not. An exported deadline is granted to every target at
//RS     // once, which is exactly the drift the committed table exists to stop.
//RS     assert_eq!(
//RS         resolve_suite_budget("some_unit_suite", ledger, Some("36000")).0,
//RS         900
