    }
    // Rust: tests/common/mod.rs:1420
    fn finish(self) -> String {
        if self.truncated { self.text.push_str(DIFF_OUTPUT_TRUNCATED) }
        debug_assert(self.text.len() <= UNIFIED_DIFF_MAX_OUTPUT_BYTES)
        self.text
    }
}
