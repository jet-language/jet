// Rust: tests/common/mod.rs:1482
fn build_and_run_with_cwd(prefix: String, name: String, src: String, run_in_scratch: Bool) -> (I32, String, String) {
    scratch :: Scratch.new(prefix)
    dir :: &scratch.path
    fs.write(dir.join("package.jet"), TEST_PACKAGE_MANIFEST).unwrap()
    jet_path :: dir.join("{name}.jet")
    fs.write(&jet_path, src).unwrap()
    shown :: jet_path.to_string_lossy().into_owned()
    out :: jet.compile_with_path(src, &shown).unwrap_or_else(fn(diags) { panic("front end rejected:\n{jet.render_diagnostics(&shown, src, &diags)}") })
    rs :: dir.join("{name}.rs")
    bin :: dir.join(name)
    rustc_cmd := Command.new("rustc")
    runtime_lease :: add_generated_rust(&rustc_cmd, &rs, &out.rust, out.ffi.is_some(), [])
    rustc_cmd.arg("-o").arg(&bin)
    if link :: out.ffi {
        rustc_cmd.arg("--extern").arg("{link.crate_name}={link.rlib_path.display()}")
        for deps_dir in link.dependency_dirs().filter(fn(dir) { dir.is_dir() }) { rustc_cmd.arg("-L").arg("dependency={deps_dir.display()}") }
    }
    rustc :: rustc_cmd.output().unwrap()
    assert(rustc.status.success(), "rustc rejected generated code (I2 violation):\n{String.from_utf8_lossy(&rustc.stderr)}")
    run_cmd := Command.new(&bin)
    if run_in_scratch { run_cmd.current_dir(dir) }
    run :: run_cmd.output().unwrap()
    (run.status.code().unwrap_or(0), String.from_utf8_lossy(&run.stdout).into_owned(), String.from_utf8_lossy(&run.stderr).into_owned())
}
