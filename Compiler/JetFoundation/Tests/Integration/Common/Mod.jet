// Rust: tests/common/mod.rs:1150
fn resolve_or_build_bin(env_suffix: String, package: String, bin_name: String) -> OSPath {
    if path :: env.var_os("CARGO_BIN_EXE_{env_suffix}") { return OSPath(path) }
    target_dir :: env.var_os("CARGO_TARGET_DIR").map(OSPath.from).unwrap_or_else(fn() { OSPath(env.var("CARGO_MANIFEST_DIR").unwrap()).join("target") })
    suffix :: if selected_os() == "windows" { ".exe" } else { "" }
    bin :: target_dir.join("debug").join("{bin_name}{suffix}")
    if !bin.is_file() {
        status :: Command.new(env.var("CARGO").unwrap()).args(["build", "-p", package, "--bin", bin_name]).current_dir(env.var("CARGO_MANIFEST_DIR").unwrap()).status().unwrap()
        assert(status.success(), "building {bin_name} test binary failed")
    }
    bin
}
