//RS 
//RS // --- runaway-test guard rails -----------------------------------------------
//RS //
//RS // A runaway test binary (unbounded allocation loop, or a hang) can eat all
//RS // RAM/swap and get the kernel to OOM-kill the whole agent session. Every
//RS // tests/*.rs binary installs this as its global allocator (via `mod
//RS // common;`), which caps live allocation and starts a wall-clock watchdog on
//RS // first use. Plain atomics only: no locks, no deps, nothing allocated on the
//RS // failure path beyond the one stderr line.
//RS 
//RS struct GuardedAlloc;
//RS 
//RS /// Cap in bytes; -1 means "not read from env yet". i64 (not u64) so the tiny,
//RS /// unavoidable unaccounted allocation from the lazy env read below (see
//RS /// `guard_on_alloc`) can dip `GUARD_LIVE_BYTES` negative without wrapping.
//RS static GUARD_CAP_BYTES: AtomicI64 = AtomicI64::new(-1);
//RS static GUARD_CAP_INIT_STARTED: AtomicBool = AtomicBool::new(false);
//RS static GUARD_LIVE_BYTES: AtomicI64 = AtomicI64::new(0);
//RS static GUARD_WATCHDOG_STARTED: AtomicBool = AtomicBool::new(false);
//RS /// One-shot: only the first tripper prints. A re-entrant trip (e.g. an
//RS /// allocation made while formatting the message below) or a concurrent
//RS /// tripper on another thread skips straight to `abort()` instead of
//RS /// recursing into a second print.
//RS static GUARD_ABORTING: AtomicBool = AtomicBool::new(false);
//RS 
//RS /// A cap this large is already indistinguishable from "unbounded" for any
//RS /// real machine; it exists only so a garbage env value (typo, dropped digit)
//RS /// can't overflow the `* 1 GiB` multiply below and wrap into a negative or
//RS /// tiny cap. Real caps are single-digit GB.
//RS const GUARD_CAP_CEILING_GB: i64 = 1 << 20; // ~1 PB
//RS 
//RS /// Parse + clamp the raw `JET_TEST_ALLOC_CAP_GB` value. Pure and
//RS /// env-independent so it's directly unit-testable — see
//RS /// `garbage_alloc_cap_env_value_clamps_to_a_sane_cap` below.
//RS fn parsed_cap_gb(raw: Option<&str>) -> i64 {
//RS     raw.and_then(|s| s.parse::<i64>().ok())
//RS         .unwrap_or(10)
//RS         .clamp(1, GUARD_CAP_CEILING_GB)
//RS }
//RS 
//RS unsafe impl std::alloc::GlobalAlloc for GuardedAlloc {
//RS     unsafe fn alloc(&self, layout: std::alloc::Layout) -> *mut u8 {
//RS         let ptr = std::alloc::System.alloc(layout);
//RS         if !ptr.is_null() {
//RS             guard_on_alloc(layout.size() as i64);
//RS         }
//RS         ptr
//RS     }
//RS 
//RS     unsafe fn dealloc(&self, ptr: *mut u8, layout: std::alloc::Layout) {
//RS         std::alloc::System.dealloc(ptr, layout);
//RS         GUARD_LIVE_BYTES.fetch_sub(layout.size() as i64, Ordering::Relaxed);
//RS     }
//RS }
//RS 
//RS fn guard_on_alloc(size: i64) {
//RS     let cap = GUARD_CAP_BYTES.load(Ordering::Relaxed);
//RS     if cap < 0 {
//RS         // Cap not read yet. Claim the read exactly once; std::env::var itself
//RS         // allocates, so the nested alloc() call this triggers re-enters here,
//RS         // sees the flag already set, and just falls through uncounted — a
//RS         // one-time, few-byte startup blind spot the i64 counter absorbs.
//RS         if !GUARD_CAP_INIT_STARTED.swap(true, Ordering::AcqRel) {
//RS             let gb = parsed_cap_gb(std::env::var("JET_TEST_ALLOC_CAP_GB").ok().as_deref());
//RS             // Both factors are positive and gb is clamped well below any
//RS             // overflow threshold, but saturating_mul is the boring choice
//RS             // over "trust the clamp" — it can never produce a negative or
//RS             // wrapped cap, which would otherwise silently disarm the guard
//RS             // (see the `cap < 0` branch above).
//RS             GUARD_CAP_BYTES.store(gb.saturating_mul(1 << 30), Ordering::Relaxed);
//RS         }
//RS         return;
//RS     }
//RS     let total = GUARD_LIVE_BYTES.fetch_add(size, Ordering::Relaxed) + size;
//RS     if total > cap {
//RS         guard_abort(|out| {
//RS             let _ = writeln!(
//RS                 out,
//RS                 "jet test guard: allocation cap {} GB exceeded — aborting; raise JET_TEST_ALLOC_CAP_GB if legitimate",
//RS                 cap / (1 << 30)
//RS             );
//RS         });
//RS     }
//RS     guard_start_watchdog();
//RS }
//RS 
//RS /// Print (first tripper only) then abort. `print` is a closure so each call
//RS /// site can format its own message without heap-allocating a `String` first
//RS /// — `write!` to `Stderr` formats straight into the underlying `write()`
//RS /// syscall.
//RS fn guard_abort(print: impl FnOnce(&mut std::io::Stderr)) -> ! {
//RS     if !GUARD_ABORTING.swap(true, Ordering::AcqRel) {
//RS         print(&mut std::io::stderr());
//RS     }
//RS     std::process::abort();
//RS }
//RS 
//RS /// Lazily spawned on first (accounted) allocation, guarded by a one-shot
//RS /// flag: a plain relaxed load short-circuits the common case (already
//RS /// started) before paying for the atomic swap.
//RS fn guard_start_watchdog() {
//RS     if GUARD_WATCHDOG_STARTED.load(Ordering::Relaxed) {
//RS         return;
//RS     }
//RS     if GUARD_WATCHDOG_STARTED.swap(true, Ordering::AcqRel) {
//RS         return;
//RS     }
//RS     let spawned = std::thread::Builder::new()
//RS         .name("jet-test-watchdog".into())
//RS         .spawn(guard_watchdog_main);
//RS     if spawned.is_err() {
//RS         // Too early in process startup to spawn a thread (rare) — let a
//RS         // later allocation retry.
//RS         GUARD_WATCHDOG_STARTED.store(false, Ordering::Release);
//RS     }
//RS }
//RS 
//RS /// The wall-clock budget for one test binary when nothing names it. #677: this
//RS /// number does not move. A suite that outruns it is normally defective — split
//RS /// it or speed it up — and the rare suite that genuinely cannot fit (a
//RS /// measurement suite whose sample count is ratified policy) earns a NAMED row
//RS /// in the table below instead of a bigger number here.
//RS const DEFAULT_SUITE_BUDGET_SECS: u64 = 900;
//RS 
//RS /// The committed exemption table, embedded rather than read at run time: the
//RS /// guard must not depend on a cwd, and a deleted table becomes a compile error
//RS /// instead of a silently restored default. `tests/suite_membership.rs` reads
//RS /// this same text through this module — never a second copy — and pins how many
//RS /// rows may exceed the default (AGENTS.md I8).
//RS pub const SUITE_BUDGET_LEDGER: &str = include_str!("../suite_budgets.txt");
//RS 
//RS /// Named once so the abort message, the ledger checks and the runner all cite
//RS /// the same path.
//RS pub const SUITE_BUDGET_LEDGER_PATH: &str = "tests/suite_budgets.txt";
//RS 
//RS /// One table row: the test target name (`--test <name>`), its budget in
//RS /// seconds, and the one-line reason it is not the default. Borrowed from the
//RS /// ledger text, so resolving a budget allocates nothing but the message.
//RS #[derive(Debug)]
//RS pub struct SuiteBudgetRow<'a> {
//RS     pub suite: &'a str,
//RS     pub secs: u64,
//RS     pub reason: &'a str,
//RS }
//RS 
//RS /// Parse the table. Strict on purpose: a malformed row is an error naming the
//RS /// line, never a skipped row, because a row nobody parses is an exemption
//RS /// nobody voted for. The guard below treats an unparseable table as "no rows"
//RS /// and so falls back to the strict default; `tests/suite_membership.rs` fails
//RS /// on the same input, which is where the drift gets reported.
//RS pub fn parse_suite_budgets(text: &str) -> Result<Vec<SuiteBudgetRow<'_>>, String> {
//RS     let mut rows = Vec::new();
//RS     for (index, raw) in text.lines().enumerate() {
//RS         let line = raw.trim();
//RS         if line.is_empty() || line.starts_with('#') {
//RS             continue;
//RS         }
//RS         let number = index + 1;
//RS         let mut fields = line.splitn(3, char::is_whitespace);
//RS         let suite = fields.next().unwrap_or_default();
//RS         let secs = fields.next().unwrap_or_default();
//RS         let reason = fields.next().unwrap_or_default().trim();
//RS         let secs: u64 = secs.parse().map_err(|_| {
//RS             format!(
//RS                 "{SUITE_BUDGET_LEDGER_PATH}:{number}: `{secs}` is not a budget in whole seconds. \
//RS                  Row shape: <test target name> <seconds> <reason, one line>"
//RS             )
//RS         })?;
//RS         if reason.is_empty() {
//RS             return Err(format!(
//RS                 "{SUITE_BUDGET_LEDGER_PATH}:{number}: the `{suite}` row states no reason. An \
//RS                  exemption without a reason is one nobody can review or retire (#677)"
//RS             ));
//RS         }
//RS         rows.push(SuiteBudgetRow {
//RS             suite,
//RS             secs,
//RS             reason,
//RS         });
//RS     }
//RS     Ok(rows)
//RS }
//RS 
//RS /// The suite a running test binary belongs to. Cargo names the binary
//RS /// `<target>-<metadata hash>`, so the stem minus that hash is the target name —
//RS /// exactly the spelling `tests/suites.txt` and the budget table use.
//RS pub fn suite_name_from_exe_stem(stem: &str) -> &str {
//RS     match stem.rsplit_once('-') {
//RS         Some((head, hash))
//RS             if !head.is_empty()
//RS                 && hash.len() >= 8
//RS                 && hash.bytes().all(|byte| byte.is_ascii_hexdigit()) =>
//RS         {
//RS             head
//RS         }
//RS         _ => stem,
//RS     }
//RS }
//RS 
//RS /// Resolve one suite's budget and say where it came from, so the abort can name
//RS /// the rule that bit the reader instead of only the number (#677).
//RS ///
//RS /// `JET_TEST_DEADLINE_SECS` may only TIGHTEN: an env var that could loosen is a
//RS /// deadline handed to every target at once by whoever exported it, which is the
//RS /// opposite of a committed, named, reviewable minority. Pure, so the unit tests
//RS /// below drive it with synthetic input instead of the real environment.
