//RS /// Byte columns of every real `unsafe` KEYWORD on one line of generated Rust.
//RS ///
//RS /// #2025: the I1 scans used to ask `line.contains("unsafe")`, which reads DATA
//RS /// as CODE. Generated Rust embeds the program's own source path and its string
//RS /// literals verbatim — `crate::jet_stack_enter("Examples/features/memory/
//RS /// unsafe_sentries.jet", …)`, `jet_mem::jet_sentry_scope(true, "…/
//RS /// unsafe_obligations.jet", …)`, `print("unsafe gate")` — so four examples were
//RS /// permanently red for owning the word `unsafe` in their FILE NAME, and
//RS /// `tests/sema_soundness_parts/provenance.rs` had to keep its scratch-dir prefix
//RS /// free of the substring to avoid false-tripping every case. The property being
//RS /// checked is about the `unsafe` keyword, so scan for the keyword: skip `//`
//RS /// comments, string and char literals, and identifiers that merely contain the
//RS /// word (`unsafe_sentries`, `jet_unsafe_probe`).
//RS ///
//RS /// Line-scoped, like the checks it serves: a generated statement is one line.
//RS pub fn unsafe_keyword_columns(line: &str) -> Vec<usize> {
//RS     let bytes = line.as_bytes();
//RS     let ident_byte = |byte: u8| byte.is_ascii_alphanumeric() || byte == b'_' || byte >= 0x80;
//RS     let mut columns = Vec::new();
//RS     let mut i = 0;
//RS     while i < bytes.len() {
//RS         match bytes[i] {
//RS             b'/' if bytes.get(i + 1) == Some(&b'/') => return columns,
//RS             b'"' => {
//RS                 i += 1;
//RS                 while i < bytes.len() && bytes[i] != b'"' {
//RS                     i += if bytes[i] == b'\\' { 2 } else { 1 };
//RS                 }
//RS                 i += 1;
//RS             }
//RS             // A char literal, not a lifetime (`'a`) and not an apostrophe inside
//RS             // one: `'x'`, `'\n'`. Anything else advances one byte.
//RS             b'\'' if bytes.get(i + 2) == Some(&b'\'') || bytes.get(i + 1) == Some(&b'\\') => {
//RS                 i += 1;
//RS                 while i < bytes.len() && bytes[i] != b'\'' {
//RS                     i += if bytes[i] == b'\\' { 2 } else { 1 };
//RS                 }
//RS                 i += 1;
//RS             }
//RS             b'u' if bytes[i..].starts_with(b"unsafe")
//RS                 && (i == 0 || !ident_byte(bytes[i - 1]))
//RS                 && bytes.get(i + 6).is_none_or(|byte| !ident_byte(*byte)) =>
//RS             {
//RS                 columns.push(i);
//RS                 i += 6;
//RS             }
//RS             _ => i += 1,
//RS         }
//RS     }
//RS     columns
//RS }
//RS 
//RS /// #2025 negative control: the keyword scan tells generated CODE from generated
//RS /// DATA. Every string below is a real line from `jet emit --rust` output.
//RS #[test]
//RS fn unsafe_keyword_scan_reads_code_not_data() {
//RS     let path_argument = "    let __jet_stack_frame = crate::jet_stack_enter(\"Examples/features/memory/unsafe_sentries.jet\", 5, \"run\", \"fn run() {\");";
//RS     assert!(
//RS         unsafe_keyword_columns(path_argument).is_empty(),
//RS         "an example's own path in a stack-frame argument is data, not an `unsafe` block"
//RS     );
//RS     let sentry = "        let _jet_sentry = jet_mem::jet_sentry_scope(true, \"Examples/features/lowlevel/unsafe_obligations.jet\", 5, \"cell stays live\");";
//RS     assert!(
//RS         unsafe_keyword_columns(sentry).is_empty(),
//RS         "sentry reason strings are data"
//RS     );
//RS     let user_string = "        { let _ = jet_term_write_stdout_line(&((\"unsafe gate\".to_string()).jet_show()), false); };";
//RS     assert!(
//RS         unsafe_keyword_columns(user_string).is_empty(),
//RS         "a printed string is data"
//RS     );
//RS     assert!(unsafe_keyword_columns("// unsafe { … } in a comment").is_empty());
//RS     assert!(
//RS         unsafe_keyword_columns("    let unsafe_flag = 1;").is_empty(),
//RS         "identifier, not keyword"
//RS     );
//RS 
//RS     assert_eq!(
//RS         unsafe_keyword_columns("    unsafe {").len(),
//RS         1,
//RS         "the gated block form must count"
//RS     );
//RS     assert_eq!(
//RS         unsafe_keyword_columns("unsafe extern \"C\" fn InitWindow() {}").len(),
//RS         1,
//RS         "an `unsafe extern` item must count even though the line also holds a string"
//RS     );
//RS     assert_eq!(
//RS         unsafe_keyword_columns("    let p = unsafe { *raw }; // unsafe read").len(),
//RS         1,
//RS         "code counts once; the trailing comment does not add a second"
//RS     );
//RS }
