//RS     assert_eq!(
//RS         resolve_suite_budget("some_unit_suite", ledger, Some("0")).0,
//RS         900,
//RS         "a zero deadline would abort instantly; it is garbage, not a tightening"
//RS     );
//RS 
//RS     // A malformed table falls back to the strict default rather than to the
//RS     // last row that happened to parse. tests/suite_membership.rs is what turns
//RS     // that fallback into a reported failure.
