fn unsafe_keyword_columns(line: String) -> [Int] {
    bytes :: line.as_bytes()
    ident_byte :: fn(byte: U8) { byte.is_ascii_alphanumeric() || byte == 95 || byte >= 0x80 }
    columns := []
    i := 0
    loop i < bytes.len() {
        if bytes[i] == 47 && bytes.get(i + 1) == Val(47) { return columns }
        else if bytes[i] == 34 {
            i += 1
            loop i < bytes.len() && bytes[i] != 34 { i += if bytes[i] == 92 { 2 } else { 1 } }
            i += 1
        } else if bytes[i] == 39 && (bytes.get(i + 2) == Val(39) || bytes.get(i + 1) == Val(92)) {
            i += 1
            loop i < bytes.len() && bytes[i] != 39 { i += if bytes[i] == 92 { 2 } else { 1 } }
            i += 1
        } else if bytes[i] == 117 && bytes[i..].starts_with("unsafe".as_bytes()) && (i == 0 || !ident_byte(bytes[i - 1])) && bytes.get(i + 6).is_none_or(fn(byte) { !ident_byte(byte) }) {
            columns.push(i)
            i += 6
        } else { i += 1 }
    }
    columns
}
// Rust: tests/common/mod.rs:2133
fn strip_scheduler_native(src: String) -> String {
    begin :: "// jet:scheduler-native-begin"
    end :: "// jet:scheduler-native-end"
    text := src.to_string()
    loop {
        if (text.find(begin), text.find(end)) == {
            (.Val(b), .Val(e)) -> {
                if e < b { return text }
                next := text[..b].to_string()
                next.push_str(&text[e + end.len()..])
                text = next
            }
            _ -> return text
        }
    }
}
// Rust: tests/common/mod.rs:2152
fn strip_raylib_bridge(src: String) -> String {
    begin :: "// jet:raylib-begin"
    end :: "// jet:raylib-end"
    if (src.find(begin), src.find(end)) == {
        (.Val(b), .Val(e)) -> {
            if e < b { return src.to_string() }
            out := src[..b].to_string()
            out.push_str(&src[e + end.len()..])
            out
        }
        _ -> src.to_string()
    }
}
// Rust: tests/common/mod.rs:2168
fn strip_shared_guard_internals(src: String) -> String {
    begin :: "// jet:shared-guard-internal-begin"
    end :: "// jet:shared-guard-internal-end"
    out := src.to_string()
    loop {
        b :: out.find(begin) ?? return out
        e :: out.find(end) ?? return out
        if e < b { return out }
        next := out[..b].to_string()
        next.push_str(&out[e + end.len()..])
        out = next
    }
}
// Rust: tests/common/mod.rs:2188
fn strip_vetted_module(src: String, name: String) -> String {
    begin :: "// JET_VETTED_UNSAFE_BEGIN: {name}"
    end :: "// JET_VETTED_UNSAFE_END: {name}"
    text := src.to_string()
    loop {
        start :: text.find(&begin).or_else(fn() {
            offset := 0
            for line in text.lines() {
                if line.trim_start().starts_with(&begin) { return Val(offset) }
                offset += line.len() + 1
            }
            nil
        }) ?? return text
        relative_end :: text[start..].find(&end) ?? return text
        end_offset :: start + relative_end + end.len()
        text = "{text[..start]}{text[end_offset..]}"
    }
}
