// Rust: tests/common/mod.rs:1083,1111
fn make_tree_writable(path: &OSPath) -> {
    if selected_family() == "unix" {
        meta :: fs.symlink_metadata(path).ok() ?? return
        if !meta.file_type().is_symlink() {
            mode :: if meta.is_dir() { 0o755 } else { meta.permissions().mode() | 0o600 }
            _ :: fs.set_permissions(path, fs.Permissions.from_mode(mode))
        }
        if meta.is_dir() {
            entries :: fs.read_dir(path).ok() ?? return
            for entry in entries {
                value :: entry.ok() ?? continue
                make_tree_writable(&value.path())
            }
        }
    } else {
        meta :: fs.metadata(path).ok() ?? return
        permissions := meta.permissions()
        permissions.set_readonly(false)
        _ :: fs.set_permissions(path, permissions)
    }
}
