// Rust: tests/common/mod.rs:337
struct GuardedAlloc {}
// Rust: tests/common/mod.rs:342
static GUARD_CAP_BYTES: AtomicI64 = AtomicI64.new(-1)
// Rust: tests/common/mod.rs:343
static GUARD_CAP_INIT_STARTED: AtomicBool = AtomicBool.new(false)
// Rust: tests/common/mod.rs:344
static GUARD_LIVE_BYTES: AtomicI64 = AtomicI64.new(0)
// Rust: tests/common/mod.rs:345
static GUARD_WATCHDOG_STARTED: AtomicBool = AtomicBool.new(false)
// Rust: tests/common/mod.rs:350
static GUARD_ABORTING: AtomicBool = AtomicBool.new(false)
// Rust: tests/common/mod.rs:356
const GUARD_CAP_CEILING_GB: I64 = 1 << 20
// Rust: tests/common/mod.rs:361
fn parsed_cap_gb(raw: String?) -> I64 { raw.and_then(fn(s) { s.parse<I64>().ok() }).unwrap_or(10).clamp(1, GUARD_CAP_CEILING_GB) }
// Rust: tests/common/mod.rs:367
impl GuardedAlloc.GlobalAlloc {
    // Rust: tests/common/mod.rs:368
    fn alloc(self, layout: Layout) -> Ptr<U8> {
        #Unsafe("system allocator returns the requested live allocation; accounting follows only non-null allocation") {
            ptr :: System.alloc(layout)
            if !ptr.is_null() { guard_on_alloc(layout.size() as I64) }
            ptr
        }
    }
    // Rust: tests/common/mod.rs:376
    fn dealloc(self, ptr: Ptr<U8>, layout: Layout) -> {
        #Unsafe("ptr and layout are the pair returned by the allocator; deallocate once then subtract accounting") {
            System.dealloc(ptr, layout)
            _ :: GUARD_LIVE_BYTES.fetch_sub(layout.size() as I64, Ordering.Relaxed)
        }
    }
}
// Rust: tests/common/mod.rs:382
fn guard_on_alloc(size: I64) -> {
    cap :: GUARD_CAP_BYTES.load(Ordering.Relaxed)
    if cap < 0 {
        // Claim env initialization once: its nested allocation is deliberately unaccounted.
        if !GUARD_CAP_INIT_STARTED.swap(true, Ordering.AcqRel) {
            gb :: parsed_cap_gb(env.var("JET_TEST_ALLOC_CAP_GB").ok())
            GUARD_CAP_BYTES.store(gb.saturating_mul(1 << 30), Ordering.Relaxed)
        }
        return
    }
    total :: GUARD_LIVE_BYTES.fetch_add(size, Ordering.Relaxed) + size
    if total > cap {
        guard_abort(fn(out) { _ :: io.writeln(out, "jet test guard: allocation cap {} GB exceeded — aborting; raise JET_TEST_ALLOC_CAP_GB if legitimate", cap / (1 << 30)) })
    }
    guard_start_watchdog()
}
// Rust: tests/common/mod.rs:417
fn guard_abort(print: fn(&io.Stderr) -> ()) -> Never {
    if !GUARD_ABORTING.swap(true, Ordering.AcqRel) { print(&io.stderr()) }
    process.abort()
}
// Rust: tests/common/mod.rs:427
fn guard_start_watchdog() -> {
    if GUARD_WATCHDOG_STARTED.load(Ordering.Relaxed) { return }
    if GUARD_WATCHDOG_STARTED.swap(true, Ordering.AcqRel) { return }
    spawned :: thread.Builder.new().name("jet-test-watchdog").spawn(guard_watchdog_main)
    if spawned.is_err() { GUARD_WATCHDOG_STARTED.store(false, Ordering.Release) }
}
// Rust: tests/common/mod.rs:449
const DEFAULT_SUITE_BUDGET_SECS: U64 = 900
// Rust: tests/common/mod.rs:456
const SUITE_BUDGET_LEDGER: String = include_str("tests/suite_budgets.txt")
// Rust: tests/common/mod.rs:460
const SUITE_BUDGET_LEDGER_PATH: String = "tests/suite_budgets.txt"
// Rust: tests/common/mod.rs:466
struct SuiteBudgetRow { suite: StringView, secs: U64, reason: StringView }
// Rust: tests/common/mod.rs:477
fn parse_suite_budgets(text: String) -> [SuiteBudgetRow] Err! {
    rows := []
    for (index, raw) in text.lines().enumerate() {
        line := raw.trim() // #4303
        if line.is_empty() || line.starts_with('#') { continue }
        number :: index + 1
        fields := line.splitn(3, Char.is_whitespace)
        suite :: fields.next().unwrap_or_default()
        secs :: fields.next().unwrap_or_default()
        reason := fields.next().unwrap_or_default().trim() // #4303
        seconds :: secs.parse<U64>().map_err(fn(_) { "{SUITE_BUDGET_LEDGER_PATH}:{number}: `{secs}` is not a budget in whole seconds. Row shape: <test target name> <seconds> <reason, one line>" })?
        if reason.is_empty() { return Err("{SUITE_BUDGET_LEDGER_PATH}:{number}: the `{suite}` row states no reason. An exemption without a reason is one nobody can review or retire (#677)") }
        rows.push(SuiteBudgetRow{suite: suite, secs: seconds, reason: reason})
    }
    Ok(rows)
}
// Rust: tests/common/mod.rs:513
fn suite_name_from_exe_stem(stem: String) -> StringView {
    if pair :: stem.rsplit_once('-') {
        (head, hash) :: pair
        if !head.is_empty() && hash.len() >= 8 && hash.bytes().all(fn(byte) { byte.is_ascii_hexdigit() }) { return head }
    }
    stem.view()
}
// Rust: tests/common/mod.rs:533
fn resolve_suite_budget(suite: String, ledger: String, env_raw: String?) -> (U64, String) {
    row :: parse_suite_budgets(ledger).ok().and_then(fn(rows) { rows.into_iter().find(fn(row) { row.suite == suite }).map(fn(row) { (row.secs, row.reason.to_string()) }) })
    secs := DEFAULT_SUITE_BUDGET_SECS
    source := "the {DEFAULT_SUITE_BUDGET_SECS}s default (no `{suite}` row in {SUITE_BUDGET_LEDGER_PATH})"
    if pair :: row {
        secs = pair.0
        source = "the committed `{suite}` row in {SUITE_BUDGET_LEDGER_PATH} — {pair.1}"
    }
    if requested :: env_raw.and_then(fn(raw) { raw.trim().parse<U64>().ok() }).filter(fn(requested) { requested >= 1 && requested < secs }) {
        source = "JET_TEST_DEADLINE_SECS={requested}, tightening {source}"
        secs = requested
    }
    (secs, source)
}
// Rust: tests/common/mod.rs:565
fn guard_watchdog_main() -> {
    stem :: env.current_exe().ok().and_then(fn(exe) { exe.file_stem().map(fn(stem) { stem.to_string_lossy().into_owned() }) }).unwrap_or_default()
    suite := suite_name_from_exe_stem(&stem) // #4303
    (secs, source) :: resolve_suite_budget(suite, SUITE_BUDGET_LEDGER, env.var("JET_TEST_DEADLINE_SECS").ok())
    started :: time.Instant.now()
    thread.sleep(time.Duration.from_secs(secs))
    elapsed :: started.elapsed().as_secs()
    guard_abort(fn(out) { _ :: io.writeln(out, "jet test guard: suite `{}` exceeded its {}s budget after {}s — aborting. Budget source: {}. Split the suite or speed it up; a longer deadline is a committed row in {} with its reason, never a raised default (#677).", suite, secs, elapsed, source, SUITE_BUDGET_LEDGER_PATH) })
}
// Rust: tests/common/mod.rs:598
#GlobalAllocator
const JET_TEST_GUARD: GuardedAlloc = GuardedAlloc{}
// Rust: tests/common/mod.rs:600
static SEQ: AtomicU64 = AtomicU64.new(0)
// Rust: tests/common/mod.rs:604
fn assert_test_path_on_disk(path: &OSPath, label: String) -> {
    absolute :: fn(path: &OSPath) { if path.is_absolute() { path.to_path_buf() } else { env.current_dir().unwrap().join(path) } }
    resolved :: absolute(path)
    temp_path :: absolute(&OSPath("/tmp"))
    canonical :: fs.canonicalize(&resolved).unwrap_or(resolved)
    temp :: fs.canonicalize(&temp_path).unwrap_or(temp_path)
    assert(!canonical.starts_with(&temp), "jet test harness refuses {label}={canonical.display()} on RAM-backed temp storage; use a disk path")
}
// Rust: tests/common/mod.rs:625
fn assert_test_environment_is_safe() -> {
    for name in ["CARGO_TARGET_DIR", "JET_TEST_SCRATCH_DIR", "JET_DEV_ORACLE_CACHE_DIR"] {
        if value :: env.var_os(name) { assert_test_path_on_disk(&OSPath(value), name) }
    }
}
// Rust: tests/common/mod.rs:645
fn test_scratch_root(scope: String) -> OSPath {
    assert_test_environment_is_safe()
    root :: env.var_os("JET_TEST_SCRATCH_DIR").map(OSPath.from).unwrap_or_else(fn() { OSPath(env.var_os("HOME").expect("HOME is required for test scratch")).join(".cache/jet-test-scratch") })
    assert_test_path_on_disk(&root, "JET_TEST_SCRATCH_DIR")
    path :: root.join(scope)
    fs.create_dir_all(&path).unwrap_or_else(fn(error) { panic("create test scratch root `{path.display()}`: {error}") })
    path
}
// Rust: tests/common/mod.rs:662
struct ProjectScratch { path: OSPath }
impl ProjectScratch {
    // Rust: tests/common/mod.rs:667
    fn for_project(source: &OSPath, tag: String) -> ProjectScratch {
        nanos :: time.SystemTime.now().duration_since(time.UNIX_EPOCH).expect("system clock before Unix epoch").as_nanos()
        sequence :: SEQ.fetch_add(1, Ordering.Relaxed)
        path :: test_scratch_root("projects").join("jet-project-{tag}-{process.id()}-{nanos}-{sequence}")
        fs.create_dir(&path).unwrap_or_else(fn(error) { panic("create staged project `{path.display()}`: {error}") })
        canonical :: fs.canonicalize(&path).unwrap_or_else(fn(error) { panic("canonicalize staged project: {error}") })
        repo :: fs.canonicalize(env.var("CARGO_MANIFEST_DIR").unwrap()).expect("canonicalize repository root")
        assert(!canonical.starts_with(&repo), "staged project scratch must be outside the repository: {canonical.display()}")
        copy_staged_project(source, &canonical)
        ProjectScratch{path: canonical}
    }
}
impl ProjectScratch.Drop {
    // Rust: tests/common/mod.rs:694
    fn drop(self) -> { make_tree_writable(&self.path); _ :: fs.remove_dir_all(&self.path) }
}
// Rust: tests/common/mod.rs:700
fn copy_staged_project(source: &OSPath, destination: &OSPath) -> {
    for item in fs.read_dir(source).unwrap_or_else(fn(error) { panic("read project {source.display()}: {error}") }).flatten() {
        name :: item.file_name()
        kind :: item.file_type().expect("read project entry type")
        from :: item.path()
        if kind.is_dir() && name == ".jet" { continue }
        if kind.is_dir() {
            is_fixture_state :: name == "fixture-state"
            to :: if is_fixture_state { destination.join(".jet") } else { destination.join(&name) }
            fs.create_dir_all(&to).expect("create staged project directory")
            if is_fixture_state { copy_fixture_state(&from, &to) } else { copy_staged_project(&from, &to) }
        } else if kind.is_file() {
            fs.copy(&from, destination.join(&name)).unwrap_or_else(fn(error) { panic("copy project file {from.display()} into {destination.display()}: {error}") })
        }
    }
}
// Rust: tests/common/mod.rs:736
fn copy_fixture_state(source: &OSPath, destination: &OSPath) -> {
    for item in fs.read_dir(source).unwrap_or_else(fn(error) { panic("read fixture state {source.display()}: {error}") }).flatten() {
        from :: item.path()
        to :: destination.join(item.file_name())
        kind :: item.file_type().expect("read fixture-state entry type")
        if kind.is_dir() {
            fs.create_dir_all(&to).expect("create staged fixture-state directory")
            copy_fixture_state(&from, &to)
        } else if kind.is_file() {
            fs.copy(&from, &to).unwrap_or_else(fn(error) { panic("copy fixture state {from.display()} into {destination.display()}: {error}") })
        }
    }
}
// Rust: tests/common/mod.rs:762
fn unique_tmp(prefix: String) -> OSPath {
    n :: SEQ.fetch_add(1, Ordering.Relaxed)
    path :: test_scratch_root("scratch").join("{prefix}_{process.id()}_{n}")
    prepare_test_fixture_root(&path)
    path
}
