fn test_worker_count(cap: Int) -> Int {
    requested :: env.var("JET_TEST_JOBS").ok().and_then(fn(s) { s.parse<Int>().ok() }).filter(fn(n) { n > 0 })
    available :: thread.available_parallelism().map(fn(n) { n.get() }).unwrap_or(2)
    requested.unwrap_or(available).clamp(1, cap.max(1))
}
