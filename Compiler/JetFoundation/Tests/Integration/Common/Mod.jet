// Rust: tests/common/mod.rs:1347
fn bounded_diff_lines(input: String) -> BoundedDiffLines {
    byte_end := input.len().min(UNIFIED_DIFF_MAX_INPUT_BYTES)
    loop !input.is_char_boundary(byte_end) { byte_end -= 1 }
    prefix := input[..byte_end] // #4303
    lines := []
    compared_bytes := 0
    for line in prefix.split_inclusive('\n').take(UNIFIED_DIFF_MAX_INPUT_LINES) { compared_bytes += line.len(); lines.push(line) }
    BoundedDiffLines{lines: lines, compared_bytes: compared_bytes, cut_mid_line: compared_bytes < input.len() && compared_bytes > 0 && input.as_bytes()[compared_bytes - 1] != 10}
}
// Rust: tests/common/mod.rs:1371
fn push_input_truncation(out: &BoundedDiffOutput, side: String, input: String, bounded: &BoundedDiffLines) -> {
    if bounded.compared_bytes < input.len() { out.push("# diff input truncated: {side} compares first {bounded.compared_bytes} of {input.len()} bytes across {bounded.lines.len()} lines; limits are {UNIFIED_DIFF_MAX_INPUT_BYTES} bytes/{UNIFIED_DIFF_MAX_INPUT_LINES} lines\n") }
}
