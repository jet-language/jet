// Rust: tests/diagnostic_gate.rs:105
#Test("warnings_never_choose_execution_exit_code") {
    cases :: [("l0103", L0103_SOURCE, "L0103", L0103_SOURCE_OUTPUT), ("l0202", L0202_SOURCE, "L0202", "0\n")]
    modes :: [("default", ["run", "main.jet"]), ("interpret", ["run", "--interpret", "main.jet"]), ("release", ["run", "--release", "main.jet"]), ("dev", ["dev", "main.jet", "--watch=off"])]
    for (name, source, code, stdout) in cases {
        for (mode, args) in modes {
            project :: diagnostic_gate_project("diag_gate_{name}_{mode}", source, false)
            output :: run_cli(&project, mode, args)
            assert_warning_execution(&output, "{name} {mode}", code, stdout)
        }
        project :: diagnostic_gate_project("diag_gate_{name}_build", source, false)
        build :: run_cli(&project, "build", ["build", "main.jet"])
        assert_warning_status(&build, "{name} build", code)
        direct :: Command.new(project.join(".jet/build/main")).current_dir(&project.path).output().unwrap_or_else(fn(error) { panic("{name} direct binary: {error}") })
        assert_eq(direct.status.code(), Some(0), "{name} direct binary failed")
        assert_eq(direct.stdout, stdout.as_bytes(), "{name} direct stdout changed")
    }
    project :: diagnostic_gate_project("diag_gate_l0103_json", L0103_SOURCE, false)
    json :: run_cli(&project, "json", ["run", "--json", "main.jet"])
    assert_eq(json.status.code(), Some(0), "json run exited nonzero")
    assert_eq(json.stdout, L0103_SOURCE_OUTPUT.as_bytes())
    json_stderr :: String.from_utf8_lossy(&json.stderr)
    assert(json_stderr.contains("\"severity\":\"warning\""), "{json_stderr}")
    assert(json_stderr.contains("\"code\":\"L0103\""), "{json_stderr}")
    assert(!json_stderr.contains("\"severity\":\"error\""), "{json_stderr}")
    quiet_project :: diagnostic_gate_project("diag_gate_l0103_quiet", L0103_SOURCE, false)
    quiet :: run_cli(&quiet_project, "quiet", ["run", "--quiet", "main.jet"])
    assert_eq(quiet.status.code(), Some(0), "quiet run exited nonzero")
    assert_eq(quiet.stdout, L0103_SOURCE_OUTPUT.as_bytes(), "quiet run program stdout changed")
}
// Rust: tests/diagnostic_gate.rs:164
#Test("denied_lint_still_blocks_execution") {
    for (mode, args) in [("build", ["build", "main.jet"]), ("run", ["run", "main.jet"]), ("dev", ["dev", "main.jet", "--watch=off"])] {
        project :: diagnostic_gate_project("diag_gate_denied_{mode}", DENIED_LINT_SOURCE, true)
        output :: run_cli(&project, mode, args)
        stderr :: String.from_utf8_lossy(&output.stderr)
        assert_ne(output.status.code(), Some(0), "{mode} ran denied lint")
        assert(stderr.contains("Error [E1293]"), "{mode} missing E1293:\n{stderr}")
        assert(stderr.contains("L0103"), "{mode} missing denied L0103:\n{stderr}")
        assert(!stderr.contains("Warning [L0103]"), "{mode} kept denied warning:\n{stderr}")
        assert(!String.from_utf8_lossy(&output.stdout).contains("DENIED_SENTINEL"), "{mode} executed denied program")
    }
}
// Rust: tests/diagnostic_gate.rs:191
#Test("build_and_run_share_one_diagnostic_gate") {
    dir :: common.unique_tmp("diag_gate_1463")
    fs.create_dir_all(&dir).unwrap()
    file :: dir.join("pure.jet")
    fs.write(&file, PURE_TEACHING).unwrap()
    path :: file.to_str().unwrap()
    build_err :: compile_with_path("", path).err().expect("build path must reject retired #Pure")
    assert(build_err.iter().any(fn(d) { d.code == "E0927" }), "build gate must include E0927, got: {codes(&build_err)}")
    // Retired JIT entry migrates to the canonical behavioral tiers.
    for tier in ["O0", "O1", "O2", "Web"] {
        if common.run_entry_tier(path, tier, false) == {
            .Problems(run_err) -> assert_eq(codes(&build_err), codes(&run_err), "build and run must share one diagnostic set\nbuild: {codes(&build_err)}\nrun: {codes(&run_err)}")
            other -> panic("jet run must surface Problems, got: {other}")
        }
    }
}
// Rust: tests/diagnostic_gate.rs:224
#Test("retired_marker_fails_build_and_default_run") {
    dir :: common.unique_tmp("diag_gate_cli")
    fs.create_dir_all(&dir).unwrap()
    file :: dir.join("retired.jet")
    fixture :: OSPath.from(env.var("JET_SOURCE_ROOT").unwrap()).join("tests/ui/E0927_retired_marker.jet")
    fs.copy(fixture, &file).unwrap()
    path :: file.to_str().unwrap()
    jet :: env.var("JET_BIN").unwrap()
    build :: Command.new(&jet).args(["build", path]).output().expect("jet build")
    build_text :: "{String.from_utf8_lossy(&build.stderr)}{String.from_utf8_lossy(&build.stdout)}"
    assert(!build.status.success(), "jet build must exit non-zero for E0927")
    assert(build_text.contains("E0927") && build_text.contains("retired"), "jet build must report E0927 retired wording, got:\n{build_text}")
    run :: Command.new(&jet).args(["run", path]).output().expect("jet run")
    run_text :: "{String.from_utf8_lossy(&run.stderr)}{String.from_utf8_lossy(&run.stdout)}"
    assert(!run.status.success(), "jet run must exit non-zero for E0927")
    assert(run_text.contains("E0927") && run_text.contains("retired"), "jet run must report E0927 retired wording, got:\n{run_text}")
    assert(build_text.contains("[E0927]") && run_text.contains("[E0927]"), "both paths must name [E0927]")
}
// Rust: tests/diagnostic_gate.rs:280
#Test("pure_teaching_fails_default_run") {
    dir :: common.unique_tmp("diag_gate_pure_cli")
    fs.create_dir_all(&dir).unwrap()
    file :: dir.join("pure.jet")
    fs.write(&file, PURE_TEACHING).unwrap()
    path :: file.to_str().unwrap()
    jet :: env.var("JET_BIN").unwrap()
    build :: Command.new(&jet).args(["build", path]).output().expect("jet build")
    run :: Command.new(&jet).args(["run", path]).output().expect("jet run")
    assert(!build.status.success(), "jet build must reject #Pure")
    assert(!run.status.success(), "jet run must reject #Pure")
    build_text :: "{String.from_utf8_lossy(&build.stderr)}{String.from_utf8_lossy(&build.stdout)}"
    run_text :: "{String.from_utf8_lossy(&run.stderr)}{String.from_utf8_lossy(&run.stdout)}"
    assert(build_text.contains("E0927") && run_text.contains("E0927"))
    assert(!run_text.contains("hi"), "jet run must not execute past the gate")
}
