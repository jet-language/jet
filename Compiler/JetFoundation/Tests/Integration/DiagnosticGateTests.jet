// Rust: tests/diagnostics_format.rs:190
#Test("adding_a_new_title_case_violation_fails_case_check") {
    sources := case_law.user_facing_case_sources()
    assert(case_law.case_law_violations(&sources).is_empty(), "case-law source baseline must pass before mutation")
    sources.push(case_law.CaseLawSource { name: "temporary violating label", value: "Ready And Safe", kind: case_law.CaseLawKind.Title })
    violations :: case_law.case_law_violations(&sources)
    assert(violations.iter().any(fn(violation) { violation.contains("temporary violating label") && violation.contains("And") }), "adding a new violating string must fail the case check: {violations}")
}
