// Rust: tests/dsl_blocks.rs:109
#Test("boundary_typed_heads_validate_and_compile") {
    source :: "\nfn run() {\n    service :: \"ada/../etc\"\n    endpoint :: URL.{\"https://api.example.com/v2/{service}\"}\n    log_path :: Path.{\"/var/log/{service}.log\"}\n    stamp :: DateTime.{\"2026-08-07T12:00:00Z\"}\n}\n"
    _ :: compile(source).expect("URL, Path, and DateTime heads should compile")
    invalid_url :: compile("fn run() {\n    bad :: URL.{\"https://[bad\"}\n}\n").expect_err("an invalid URL head must fail in sema")
    assert(invalid_url.iter().any(fn(diagnostic) { diagnostic.code == "E0155" }), "invalid URL head should use E0155: {invalid_url}")
    datetime_hole :: compile("fn run() {\n    hour :: \"12\"\n    bad :: DateTime.{\"2026-08-07T{hour}:00:00Z\"}\n}\n").expect_err("DateTime heads must reject interpolation")
    assert(datetime_hole.iter().any(fn(diagnostic) { diagnostic.code == "E0155" }), "DateTime interpolation should use E0155: {datetime_hole}")
}
// Rust: tests/dsl_blocks.rs:151
