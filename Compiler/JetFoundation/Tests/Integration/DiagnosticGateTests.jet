// Rust: tests/diagnostic_pages.rs:188
#Test("diagnostic_pages_match_registry_and_snapshots") {
    root :: OSPath.from(env.var("JET_SOURCE_ROOT").unwrap())
    output :: root.join(GENERATED_DIR)
    snapshot_files :: snapshots(&root)
    rows :: sorted_rows()
    expected_codes := [:]
    for row in rows { expected_codes.insert(row.code, true) }
    assert_eq(expected_codes.len(), rows.len(), "diagnostic registry contains duplicate codes")
    update :: env.var_os("UPDATE_EXPECT").is_some() || env.var_os("UPDATE_DIAGNOSTIC_PAGES").is_some()
    if update { fs.create_dir_all(&output).unwrap() }
    generated := 0
    for row in rows {
        page :: render_page(row, first_snapshot(&snapshot_files, row.code))
        for (field, value) in [("what", row.what), ("why", row.why), ("fix", row.fix)] {
            marker :: "<p class=\"diag-copy {field}\" data-registry-field=\"{field}\">{html_escape(value)}</p>"
            assert(page.contains(&marker), "{row.code} page lost registry {field} text")
        }
        path :: output.join(row.code).join("index.html")
        if update {
            fs.create_dir_all(path.parent().unwrap()).unwrap()
            fs.write(&path, &page).unwrap_or_else(fn(error) { panic("cannot write {path.display()}: {error}") })
        } else {
            actual :: fs.read_to_string(&path).unwrap_or_else(fn(error) { panic("missing generated page {path.display()}: {error}; run with UPDATE_EXPECT=1") })
            assert_eq(actual, page, "{path.display()} drifted:\n{line_diff(&page, &actual)}")
        }
        generated += 1
    }
    expected_pages := [:]
    ordered_codes := expected_codes.keys().collect()
    ordered_codes.sort()
    for code in ordered_codes { expected_pages.insert(OSPath.from(code).join("index.html"), true) }
    actual_pages := [:]
    if output.is_dir() { collect_html_paths(&output, &output, &actual_pages) }
    actual_pages.remove(&OSPath.from("index.html"))
    assert_eq(actual_pages, expected_pages, "generated diagnostic page set drifted; hand-authored or stale pages exist")
    print("diagnostic pages: generated {generated} / registry {expected_codes.len()}")
    assert_eq(generated, expected_codes.len())
}
// Rust: tests/diagnostics_format.rs:14
#Test("every_typed_diagnostic_row_is_complete") {
    rows :: diagnostic_rows()
    violations := []
    for row in rows {
        for (part, value) in [("What", row.what), ("Why", row.why), ("Fix", row.fix)] {
            view := value.trim() // #4303
            if view.is_empty() { violations.push("{row.code}: {part} is empty") }
        }
    }
    assert(violations.is_empty(), "typed diagnostic rows have malformed or incomplete What/Why/Fix templates (I4 — every diagnostic needs what/why/fix, not just a code):\n{violations.join(\"\n\")}")
}
// Rust: tests/diagnostics_format.rs:38
#Test("every_typed_diagnostic_line_uses_ratified_sentence_case") {
    rows := 0
    violations := []
    for (line_index, raw) in DIAGNOSTIC_SOURCE.lines().enumerate() {
        line := raw.trim() // #4303
        if line.is_empty() || line.starts_with("//") { continue }
        fields :: line.split('\t').collect()
        if fields.first().copied() != Some("diagnostic") { continue }
        rows += 1
        for (name, value) in [("What", fields[7]), ("Why", fields[8]), ("Fix", fields[9])] {
            detail :: case_law.sentence_case_violation(value)
            if detail.is_some() { violations.push("Diagnostics.jet:{line_index + 1} {fields[1]} {name}: {detail.unwrap()}") }
        }
    }
    assert_eq(rows, diagnostic_rows().len(), "table validator must inspect every typed diagnostic row")
    assert(violations.is_empty(), "ratified sentence-case violations (D-CASE-PROSE1):\n{violations.join(\"\n\")}")
}
// Rust: tests/diagnostics_format.rs:77
#Test("diagnostic_case_validator_preserves_code_fragments_and_flags") {
    source :: DIAGNOSTIC_SOURCE
    assert(source.contains("`--offline` forbids network access"))
    assert(source.contains("D-PATR: range"))
    assert(source.contains("C-style"))
    assert(!source.contains("`--offline` Forbids Network Access"))
    assert(!source.contains("D-patr: Range"))
    assert_eq(jet_sentence_case_line("Int cannot cross the C boundary"), "Int cannot cross the C boundary")
    assert_eq(jet_sentence_case_line("Syntax.rs owns user-typeable syntax"), "Syntax.rs owns user-typeable syntax")
    for input in ["Bool cannot cross the boundary", "U8 has the wrong width", "src/Main.jet is not reachable", "package@Source#Version is not available", "UserId has no matching field", "fn is the only declaration form", "`TypeName` cannot be constructed here"] {
        assert_eq(jet_sentence_case_line(input), input, "diagnostic case law changed `{input}`")
    }
}
// Rust: tests/diagnostics_format.rs:116
#Test("diagnostic_case_validator_excludes_non_prose_tokens") {
    for (kind, input) in [("identifier", "UserId has no matching field"), ("flag", "--offline forbids network access"), ("path", "src/Main.jet is not reachable"), ("path", "Main.jet is not reachable"), ("ref", "package@Source#Version is not available"), ("keyword", "fn is the only declaration form"), ("JSON key", "{\"SomeKey\":\"SomeValue\"}")] {
        bounds :: case_law.first_diagnostic_prose_token(input)
        if bounds.is_none() { continue }
        (start, end) :: bounds.unwrap()
        token := input[start..end] // #4303
        assert(!token.chars().next().is_some_and(fn(ch) { ch.is_ascii_uppercase() }) || case_law.diagnostic_token_keeps_case(token), "{kind} was treated as prose: {input} (token {token})")
    }
    for token in ["UserId", "--offline", "src/Main.jet", "package@Source#Version", "fn", "SomeKey"] {
        assert(case_law.diagnostic_token_keeps_case(token), "excluded {token} must keep its own case")
    }
    for input in ["UserId has no matching field", "--offline forbids network access", "src/Main.jet is not reachable", "Main.jet is not reachable", "package@Source#Version is not available", "fn is the only declaration form", "{\"SomeKey\":\"SomeValue\"}"] {
        assert_eq(jet_sentence_case_line(input), input, "production diagnostic projection changed exclusion {input}")
    }
}
