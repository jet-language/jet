#Test("i9_interpreter_runs_the_ffi_leaf_row") {
    (code, stdout, stderr) :: tir_support.interpreter_run("ffi_leaf_interpreter", FFI_LEAF_SOURCE)
    assert_eq(code, 0, "interpreter stderr: {stderr}")
    assert_eq(stdout, "ffi leaf\n")
}
// Rust: tests/effect_roots.rs:156
#Test("i9_dev_runs_the_ffi_leaf_row") {
    root :: env.temp_dir().join("jet_ffi_leaf_dev_{id()}")
    _ :: fs.remove_dir_all(&root)
    fs.create_dir_all(&root).expect("dev scratch")
    entry :: root.join("main.jet")
    fs.write(&entry, FFI_LEAF_SOURCE).expect("dev source")
    output :: Command.new(env.var("JET_BIN").unwrap()).args(["dev", entry.to_str().unwrap(), "--watch=off"]).current_dir(&root).env("NO_COLOR", "1").output().expect("dev command")
    _ :: fs.remove_dir_all(&root)
    assert(output.status.success(), "dev stderr: {String.from_utf8_lossy(&output.stderr)}")
    assert_eq(String.from_utf8_lossy(&output.stdout), "ffi leaf\n")
}
// Rust: tests/effect_roots.rs:178
#Test("i9_comptime_keeps_the_ffi_leaf_row") {
    _ :: compile(FFI_LEAF_SOURCE).expect("comptime accepts FFI.Py")
    for tier in ["O0", "O1", "O2", "Web"] {
        (code, stdout, stderr) :: ffi_leaf_tier("ffi_leaf_comptime", tier)
        assert_eq(code, 0, "{tier}: {stderr}")
        assert_eq(stdout, "ffi leaf\n", "comptime value was lost")
    }
}
// Rust: tests/effect_roots.rs:184
#Test("i9_repl_runs_the_ffi_leaf_row") {
    transcript :: jet.REPL.run_transcript(&[FFI_LEAF_SOURCE, ":run"], None)
    assert(transcript.contains("ffi leaf"), "REPL output: {transcript}")
}
// Rust: tests/effect_roots.rs:190
#Test("i9_web_accepts_the_ffi_leaf_row") {
    output :: compile_web_with_path(FFI_LEAF_SOURCE, "ffi_leaf_web.jet").expect("web accepts FFI.Py")
    assert(output.web.is_some(), "web tier dropped the FFI leaf program")
}

// Rust: tests/effect_roots.rs:125,141,178 — behavioral replacement of retired backend representation.
fn ffi_leaf_tier(name: String, tier: String) -> (Int, String, String) {
    dir :: common.unique_tmp("{name}_{tier}")
    fs.create_dir_all(&dir).expect("tier scratch")
    file :: dir.join("main.jet")
    fs.write(&file, FFI_LEAF_SOURCE).expect("tier source")
    outcome :: common.run_entry_tier(file.to_str().unwrap(), tier, false)
    _ :: fs.remove_dir_all(&dir)
    if outcome == {
        .Ran { exit_code, stdout, stderr } -> (exit_code, stdout, stderr)
        .Problems(diags) -> panic("{tier} rejected FFI.Py: {diags}")
    }
}
