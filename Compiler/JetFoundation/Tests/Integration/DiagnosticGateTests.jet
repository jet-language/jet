// Rust: tests/diagnostics_format.rs:222
#Test("diagnostic_body_validator_rejects_malformed_rows") {
    malformed :: "| Code | What | Why | Fix |\n| --- | --- | --- | --- |\n| E0001 | what | why | |\n| E0002 | what | why |\n| `E0003` | what | why | |\n"
    violations :: diagnostic_body_violations(malformed)
    assert_eq(violations.len(), 3, "{violations}")
    assert(violations[0].contains("E0001") && violations[0].contains("non-empty"))
    assert(violations[1].contains("E0002") && violations[1].contains("malformed"))
    assert(violations[2].contains("E0003") && violations[2].contains("non-empty"))
}
// Rust: tests/dsl_blocks.rs:7
#Test("sql_and_html_blocks_compile_and_formatter_round_trip") {
    source :: "\n    struct User { id: Int }\n    fn run() {\n    #SQL(User) {\n        query :: SQL.{\"select id from users\"}\n        print(query.template())\n    }\n    #HTML {\n        page :: HTML.{\"<p>ready</p>\"}\n        print(page.text())\n    }\n}\n"
    _ :: compile(source).expect("declared library blocks should compile")
    formatted :: format_source(source).expect("DSL blocks should format")
    assert(formatted.contains("#SQL(User)"))
    assert(formatted.contains("#HTML {"))
    assert_eq(format_source(&formatted).unwrap(), formatted, "DSL formatter output must be stable")
}
