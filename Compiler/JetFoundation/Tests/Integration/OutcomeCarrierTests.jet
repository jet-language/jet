// Rust: tests/output_callable.rs:69
#Test("parser_retains_typed_output_function_reference") {
    source :: "APP :: Output.Executable{ name: \"demo\", entry: run }\nfn run() {}\n"
    (tokens, lex) :: jet.Lexer.lex(source)
    assert(lex.is_empty(), "{lex:#?}")
    program :: jet.Parser.parse(tokens).expect("Output syntax parses")
    output :: program.items.iter().find_map((item) -> match item {
        Item.Const(value) if value.name == "app" -> Val(value)
        _ -> None
    }).expect("typed Output item")
    assert(match output.ty { Val(Type.Named(name)) -> name == "Output", _ -> false })
    assert(match output.value { Expr.EnumLit{variant, ..} -> OutputKind.from_name(variant) == Val(OutputKind.Executable), _ -> false })
}

// Rust: tests/output_callable.rs:91
#Test("sema_resolves_sole_executable_entry_before_codegen") {
    dir :: common.unique_tmp("jet_output_callable")
    fs.create_dir_all(dir).unwrap()
    file :: dir.join("run.jet")
    fs.write(file, "APP :: Output.Executable{ name: \"demo\", entry: start }\nfn start() {}\n").unwrap()
    bundle := jet.Loader.load_entry(file.to_str().unwrap()).unwrap()
    diagnostics :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run)
    assert(diagnostics.is_empty(), "{diagnostics:#?}")
    output :: bundle.modules[bundle.entry].items.iter().find_map((item) -> match item {
        Item.Const(value) -> value.resolved_output
        _ -> None
    }).expect("sema resolved Output entry")
    assert_eq(output.kind, OutputKind.Executable)
    assert_eq(output.source_name, "start")
    assert_eq(output.module, bundle.entry)
}

// Rust: tests/output_callable.rs:117
#Test("inspect_output_reports_selected_callable_facts") {
    // GATE #4494: real CLI process invocation.
    path :: OSPath.from(env.manifest_dir()).join("Examples/features/tooling/output_callable.jet")
    output :: Command.new(env.jet_bin()).args(["inspect", "output", path.to_str().unwrap()]).output().expect("jet inspect output")
    assert(output.status.success(), "{String.from_utf8_lossy(output.stderr)}")
    stdout :: String.from_utf8_lossy(output.stdout)
    loop expected in ["selected: Executable \"checked-output\"", "entry: launch", "source path: ", "callable identity: output_callable::launch", "failure contract: !Err", "implicit default !Err", "effects: IO", "selection reason: sole compatible Output"] {
        assert(stdout.contains(expected), "missing {expected}: {stdout}")
    }
    json_output :: Command.new(env.jet_bin()).args(["inspect", "output", path.to_str().unwrap(), "--json"]).output().expect("jet inspect output JSON")
    assert(json_output.status.success(), "{String.from_utf8_lossy(json_output.stderr)}")
    json :: String.from_utf8_lossy(json_output.stdout)
    assert(json.contains("\"failure_contract\":\"!Err\""), "{json}")
    assert(json.contains("\"failure_source\":\"implicit default !Err\""), "{json}")
}

