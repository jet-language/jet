// Rust: tests/outcome_carrier.rs:83
#Test("both_views_lower_onto_one_carrier") {
    rust :: compile("views", """
fn lookup(id: Int) -> Int? {
    if id == 1 { return Val(9) }
    return None
}
fn parse(raw: String) -> Int Err! {
    if raw == "" { return Err("empty") }
    return Ok(7)
}
fn run() {
    print(lookup(1) ?? 0)
    print(parse("x") ?? 0)
}
""")
    lookup :: user_body(rust, "__jet_lookup")
    parse :: user_body(rust, "__jet_parse")
    assert(lookup.contains("JetOutcome<i64, JetAbsent>"), "`T?` must lower onto the carrier:\n{lookup}")
    assert(parse.contains("JetOutcome<i64, JetErr>"), "`T !E` must lower onto the same carrier:\n{parse}")
    assert(!lookup.contains("Option<"), "no second representation may survive for `T?`:\n{lookup}")
    assert(lookup.contains("Ok(9i64)") && lookup.contains("Err(JetAbsent)"), "the optional view builds the carrier:\n{lookup}")
    run :: user_body(rust, "__jet_run")
    assert(!run.contains("Some(") && !run.contains("None"), "`??` reads both views the same way:\n{run}")
}

// Rust: tests/outcome_carrier.rs:135
#Test("or_err_lifts_a_clean_absence_into_a_failure") {
    rust :: compile("or_err", """
fn birth_year(book: [String:String], name: String) -> String Err! {
    return book.get(name).or_err("nobody in the book is called that")
}
fn run() {
    print(birth_year(["ada": "1815"], "ada") ?? "unknown")
}
""")
    body :: user_body(rust, "__jet_birth_year")
    assert(body.contains(".or_err(\"nobody in the book is called that\""), "`.or_err` must reach the prelude's one meaning:\n{body}")
    assert(!body.contains("ok_or") && !body.contains("Some(") && !body.contains("None"), "the two views are one carrier, so nothing converts between them:\n{body}")
}

// Rust: tests/outcome_carrier.rs:164
#Test("the_middle_states_read_off_the_same_carrier") {
    rust :: compile("middle_states", """
struct ImportErr {
    broken: Int
    partial: [String]
    notes: [String]
}
fn import_rows(label: String, rows: [String]) -> [String] ImportErr! {
    good :: rows.filter((row) -> row != "")
    broken :: rows.len() - good.len()
    if broken > 0 {
        return Err(ImportErr.{ broken: broken, partial: good, notes: [~label] })
    }
    return Ok(good)
}
fn run() {
    people :: import_rows("people", ["ada", "", "alan"])
    ports :: import_rows("ports", ["80", ""])
    print(people.notes().join(""))
    print(ports.notes().join(""))
    print(people.notes().join(""))
    print((&people.partial() ?? []).len())
}
""")
    run :: user_body(rust, "__jet_run")
    report :: jet.AST.mangle_generated("report")
    partial_field :: jet.AST.mangle("partial")
    notes_field :: jet.AST.mangle("notes")
    partial_read :: "|{report}| {report}.{partial_field}.clone()"
    notes_read :: "|{report}| {report}.{notes_field}.clone()"
    assert(run.contains("jet_partial(&(") && run.contains(partial_read), "`.partial` must read the typed carrier field through `jet_partial`:\n{run}")
    assert(run.contains("jet_notes(&(") && run.contains(notes_read), "`.notes` must read the typed carrier field through `jet_notes`:\n{run}")
    assert(!run.contains("Partial<") && !run.contains("Noted<"), "the middle states need no third type:\n{run}")
    out :: run_jet("middle_states_run", """
struct ImportErr {
    broken: Int
    partial: [String]
    notes: [String]
}
fn import_rows(label: String, rows: [String]) -> [String] ImportErr! {
    good :: rows.filter((row) -> row != "")
    broken :: rows.len() - good.len()
    if broken > 0 {
        return Err(ImportErr.{ broken: broken, partial: good, notes: [~label] })
    }
    return Ok(good)
}
fn run() {
    people :: import_rows("people", ["ada", "", "alan"])
    ports :: import_rows("ports", ["80", ""])
    clean :: import_rows("clean", ["ada"])
    print(people.notes().join(""))
    print(ports.notes().join(""))
    print(people.notes().join(""))
    print((&people.partial() ?? []).join(","))
    print((&ports.partial() ?? []).join(","))
    print(clean.notes().len())
    print((&clean.partial() ?? ["kept nothing"]).join(","))
}
""")
    assert_eq(out, "people\nports\npeople\nada,alan\n80\n0\nkept nothing\n", "two outcomes must not share a fact, and a second read must answer the first")
}

// Rust: tests/outcome_carrier.rs:258
#Test("the_web_tier_reads_the_same_carrier") {
    src :: """
#WasmExport
fn double(n: Int) -> Int { n * 2 }
#Target(JS)
fn run() {
    print(double(4))
}
"""
    out :: jet.compile_web_with_path(src, "main.jet").unwrap_or_else((diags) -> panic("web fixture rejected: {diags:?}"))
    web :: out.web.expect("web target must produce artifacts")
    assert(web.wasm_rust.contains("pub type JetOutcome<T, E> = Result<T, E>;") && web.wasm_rust.contains("pub struct JetAbsent;"), "the wasm module must include the one carrier file:\n{web.wasm_rust}")
    emitter :: fs.read_to_string(OSPath.from(env.manifest_dir()).join("crates/jet-codegen/src/Codegen/Web.rs")).expect("read the web emitter")
    assert(emitter.contains("JetOutcome<{}, JetAbsent>") && emitter.contains("Err(JetAbsent)"), "the web emitter must build the one carrier")
    assert(!emitter.contains("format!(\"Option<{}>\""), "no second representation may survive on the web tier")
}

// Rust: tests/outcome_carrier.rs:301
#Test("the_web_tier_marshals_default_err_values") {
    src :: """
#Target(Wasm)
fn run() {
    error :: Err("bad", code: "E_BAD", cause: Err("root"))
    print(error.message)
}
"""
    out :: jet.compile_web_with_path(src, "default_err.jet").unwrap_or_else((diags) -> panic("web Err fixture rejected: {diags:?}"))
    web :: out.web.expect("web target must produce artifacts")
    assert(web.wasm_rust.contains("pub struct JetErr {"))
    assert(web.wasm_rust.contains("jet_err("))
    assert(web.wasm_rust.contains("jet_err_message"))
    js_src :: """
#Target(JS)
fn run() {
    error :: Err("bad", code: "E_BAD", cause: Err("root"))
    print(error.message)
}
"""
    js_out :: jet.compile_web_with_path(js_src, "default_err.js.jet").unwrap_or_else((diags) -> panic("web JS Err fixture rejected: {diags:?}"))
    js :: js_out.web.expect("JS web target must produce artifacts")
    assert(js.js_app.contains("message: \"bad\"") && js.js_app.contains("code: \"E_BAD\"") && js.js_app.contains("cause:"), "the JS tier must carry the same Err fields:\n{js.js_app}")
}

// Rust: tests/outcome_carrier.rs:339
#Test("the_interpreter_edge_renders_default_err_through_the_prelude") {
    src :: """
fn run() Err! {
    return Err("unhandled", code: "E_RUN", cause: Err("root"))
}
"""
    dir :: env.temp_dir().join("jet_default_err_interpreter_{std.process.id()}")
    fs.create_dir_all(dir).unwrap()
    file :: dir.join("main.jet")
    fs.write(file, src).unwrap()
    bundle := jet.Loader.load_entry(file.to_str().unwrap()).expect("interpreter Err fixture should load")
    diagnostics :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run)
    assert(diagnostics.iter().all((diagnostic) -> diagnostic.severity != jet.Diagnostics.Severity.Error), "interpreter Err fixture should type-check: {diagnostics:?}")
    match common.run_interpreter_checked_bundle(bundle, false, jet.Interpreter.InterpreterInvocation.RunInterpret, common.development_policy()) {
        jet.Interpreter.RunOutcome.Ran{stdout, stderr, exit_code} -> {
            assert_eq(stdout, "")
            assert_eq(exit_code, 1)
            assert_eq(stderr, "Error [E_RUN]: unhandled\n  cause: root\n")
        }
        other -> panic("interpreter Err fixture did not run: {other:?}")
    }
}

// Rust: tests/outcome_carrier.rs:384
#Test("an_unread_verdict_costs_nothing") {
    // GATE #4483: sizes are selected-target layouts, not hardcoded host sizes.
    assert_eq(mem.size_of<JetOutcome<Int64, JetAbsent>>(), mem.size_of<Int64?>(), "a clean report is zero-sized, so `T?` carries no verdict word")
    assert_eq(mem.size_of<JetOutcome<String, JetAbsent>>(), mem.size_of<String>(), "the payload's niche still holds the absence")
    rust :: compile("erasure", """
fn first_even(n: Int) -> Int? {
    if n % 2 == 0 {
        return Val(n)
    }
    return None
}
fn run() {
    print(first_even(4) ?? -1)
}
""")
    body :: user_body(rust, "__jet_first_even")
    run :: user_body(rust, "__jet_run")
    loop shape in ["Vec::", "vec!", "to_vec()", "String::new()"] {
        assert(!body.contains(shape), "an unread verdict must allocate nothing, found `{shape}`:\n{body}")
    }
    assert_eq(run.matches("match ").count(), 1, "reading the payload is one branch, not one per fact:\n{run}")
}

