// Rust: tests/output_callable.rs:379
#Test("nested_output_links_report_e1321_before_codegen") {
    // Rust: tests/output_callable.rs:380
    fn codes(tag: String, app: String, cli: String, entry: String) -> [String] {
        dir :: common.unique_tmp(tag)
        fs.create_dir_all(dir).unwrap()
        fs.write(dir.join("main.jet"), "use \"app\" as app\nOUT :: Output.Executable{{ name: \"out\", entry: {entry} }}\n").unwrap()
        fs.write(dir.join("app.jet"), app).unwrap()
        fs.write(dir.join("cli.jet"), cli).unwrap()
        bundle := jet.Loader.load_entry(dir.join("main.jet").to_str().unwrap()).unwrap()
        jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Check).into_iter().map((diagnostic) -> diagnostic.code).collect()
    }
    missing :: codes("jet_output_nested_missing", "pub use \"cli\" as cli;\n", "pub fn run() {}\n", "app.cli.missing")
    assert(missing.iter().any((code) -> code == "E1321"), "{missing:?}")
    private :: codes("jet_output_nested_private", "use \"cli\" as cli;\n", "pub fn run() {}\n", "app.cli.run")
    assert(private.iter().any((code) -> code == "E1321"), "{private:?}")
    escaped :: codes("jet_output_nested_escape", "pub use \"cli\" as cli;\n", "fn run() {}\n", "app.cli.run")
    assert(escaped.iter().any((code) -> code == "E1321"), "{escaped:?}")
}

// Rust: tests/output_callable.rs:435
#Test("runnable_contracts_and_selection_fail_in_sema") {
    // Rust: tests/output_callable.rs:436
    fn codes(source: String, mode: jet.Sema.CompileMode) -> [String] {
        dir :: common.unique_tmp("jet_output_callable_bad")
        fs.create_dir_all(dir).unwrap()
        file :: dir.join("main.jet")
        fs.write(file, source).unwrap()
        bundle := jet.Loader.load_entry(file.to_str().unwrap()).unwrap()
        jet.Sema.check_bundle(&bundle, mode).into_iter().map((diagnostic) -> diagnostic.code).collect()
    }
    loop source in [
        "APP :: Output.Executable{ name: \"demo\", entry: \"start\" }\nfn start() {}\n",
        "API :: Output.Service{ name: \"api\", entry: serve }\nfn serve(port: Int) {}\n",
        "RELEASE :: Output.Check{ name: \"release\", entry: verify }\nfn verify() -> Int { return 1 }\n",
        "APP :: Output.Executable{ name: \"demo\", entry: start }\n#Unsafe(\"raw boundary\") fn start() {}\n"
    ] {
        assert(codes(source, jet.Sema.CompileMode.Check).contains("E1321"))
    }
    ambiguity :: codes("ONE :: Output.Executable{ name: \"one\", entry: first }\nTWO :: Output.Executable{ name: \"two\", entry: second }\nfn first() {}\nfn second() {}\n", jet.Sema.CompileMode.Run)
    assert_eq(ambiguity.iter().filter((code) -> code == "E1321").count(), 1)
    assert(ambiguity.contains("E0101"), "{ambiguity:?}")
    loop source in ["LIB :: Output.Library{ name: \"lib\" }\n", "API :: Output.Service{ name: \"api\", entry: serve }\nfn serve() {}\n"] {
        no_entry :: codes(source, jet.Sema.CompileMode.Run)
        assert(no_entry.contains("E0101"), "{no_entry:?}")
    }
    dir :: common.unique_tmp("jet_output_explicit_check_bad")
    fs.create_dir_all(dir).unwrap()
    file :: dir.join("main.jet")
    fs.write(file, "RELEASE :: Output.Check{ name: \"release\", entry: verify }\nfn verify() {}\n").unwrap()
    bundle := jet.Loader.load_entry(file.to_str().unwrap()).unwrap()
    explicit_check :: jet.Sema.check_bundle_for_output(&bundle, jet.Sema.CompileMode.Run, "release")
    assert(explicit_check.iter().any((diagnostic) -> diagnostic.code == "E1321"), "{explicit_check:?}")
    loop source in [
        "APP :: Output.Executable{ name: \"app\", entry: start }\ndefaults: { run: missing }\nfn start() {}\n",
        "APP :: Output.Executable{ name: \"app\", entry: start }\ndefaults: { run: missing }\nfn start() {}\nfn run() {}\n",
        "APP :: Output.Executable{ name: \"app\", entry: start }\nAPI :: Output.Service{ name: \"api\", entry: serve }\ndefaults: { run: API }\nfn start() {}\nfn serve() {}\n"
    ] {
        stale_default :: codes(source, jet.Sema.CompileMode.Run)
        assert(stale_default.contains("E1321"), "{stale_default:?}")
    }
}

// Rust: tests/output_callable.rs:515
#Test("invalid_output_selection_stops_in_jet_before_codegen") {
    // Rust: tests/output_callable.rs:516
    fn reject(source: String, args: [String], code: String) -> {
        dir :: common.unique_tmp("jet_output_selection_cli_bad")
        fs.create_dir_all(dir).unwrap()
        file :: dir.join("main.jet")
        fs.write(file, source).unwrap()
        command := Command.new(env.jet_bin())
        command.arg("run")
        command.args(args)
        output :: command.arg(file).output().unwrap()
        stderr :: String.from_utf8_lossy(output.stderr)
        assert(!output.status.success(), "{stderr}")
        assert(stderr.contains("Error [{code}]"), "{stderr}")
        assert(!stderr.contains("internal compiler error"), "{stderr}")
        assert(!stderr.contains("rustc rejected"), "{stderr}")
    }
    reject("LIB :: Output.Library{ name: \"lib\" }\n", [], "E0101")
    reject("API :: Output.Service{ name: \"api\", entry: serve }\nfn serve() {}\n", [], "E0101")
    reject("RELEASE :: Output.Check{ name: \"release\", entry: verify }\nfn verify() {}\n", ["--output", "release"], "E1321")
    reject("APP :: Output.Executable{ name: \"app\", entry: start }\ndefaults: { run: missing }\nfn start() {}\nfn run() {}\n", [], "E1321")
}

// Rust: tests/output_callable.rs:551
#Test("checked_default_selects_one_of_multiple_executables") {
    bundle :: checked_bundle("ONE :: Output.Executable{ name: \"one\", entry: first }\nTWO :: Output.Executable{ name: \"two\", entry: second }\ndefaults: { run: TWO }\nfn first() { print(\"first\") }\nfn second() { print(\"second\") }\n", "jet_output_checked_default", jet.Sema.CompileMode.Run)
    selected :: bundle.modules[bundle.entry].items.iter().find_map((item) -> match item {
        Item.Const(value) -> value.resolved_output.filter((output) -> output.selected)
        _ -> None
    }).expect("checked default selects one Output")
    assert_eq(selected.address, "two")
    rust :: emit_native_aot(bundle)
    assert(rust.contains("match __jet_second()"), "{rust}")
    assert(!rust.contains("match __jet_first()"), "{rust}")
}

// Rust: tests/output_callable.rs:580
#Test("explicit_service_address_reaches_tir_and_real_cli_runtime") {
    if !common.have_rustc() { return }
    dir :: common.unique_tmp("jet_output_service_cli")
    fs.create_dir_all(dir).unwrap()
    file :: dir.join("main.jet")
    fs.write(file, "APP :: Output.Executable{ name: \"app\", entry: launch }\nAPI :: Output.Service{ name: \"api\", entry: serve }\nfn launch() { print(\"app\") }\nfn serve() { print(\"service\") }\n").unwrap()
    bundle := jet.Loader.load_entry(file.to_str().unwrap()).unwrap()
    diagnostics :: jet.Sema.check_bundle_for_output(&bundle, jet.Sema.CompileMode.Run, "api")
    assert(diagnostics.is_empty(), "{diagnostics:#?}")
    output :: Command.new(env.jet_bin()).args(["run", "--quiet", "--output", "api", file.to_str().unwrap()]).current_dir(dir).output().expect("run explicit Service Output")
    assert(output.status.success(), "{String.from_utf8_lossy(output.stderr)}")
    assert_eq(String.from_utf8_lossy(output.stdout), "service\n")
}

// Rust: tests/output_callable.rs:611
#Test("service_edge_emits_one_structured_report_record") {
    if !common.have_rustc() { return }
    dir :: common.unique_tmp("jet_output_service_failure")
    fs.create_dir_all(dir).unwrap()
    file :: dir.join("main.jet")
    fs.write(file, "API :: Output.Service{ name: \"api\", entry: serve }\nfn serve() { return Err(\"service unavailable\", code: \"SVC503\") }\n").unwrap()
    output :: Command.new(env.jet_bin()).args(["run", "--output", "api", file.to_str().unwrap()]).current_dir(dir).output().expect("run failing Service Output")
    stderr :: String.from_utf8_lossy(output.stderr)
    assert_eq(output.status.code(), Val(1), "{stderr}")
    records :: stderr.lines().filter((line) -> line.starts_with("{")).collect()
    assert_eq(records.len(), 1, "service failure must have one structured record:\n{stderr}")
    assert(records[0].contains("{\"target\":\"service\",\"report\":\"Error [SVC503]: service unavailable\\n\"}"), "service report lost its native report text:\n{stderr}")
    assert(output.stdout.is_empty(), "service failure wrote stdout")
    _ :: fs.remove_dir_all(dir)
}

// Rust: tests/output_callable.rs:650
#Test("check_outputs_are_plural_real_test_harness_entries_without_test_blocks") {
    if !common.have_rustc() { return }
    dir :: common.unique_tmp("jet_output_check_cli")
    fs.create_dir_all(dir).unwrap()
    file :: dir.join("main.jet")
    fs.write(file, "UNIT :: Output.Check{ name: \"unit\", entry: verify_unit }\nRELEASE :: Output.Check{ name: \"release\", entry: verify_release }\nfn verify_unit() {}\nfn verify_release() { return Err(\"release blocked\") }\n").unwrap()
    bundle := jet.Loader.load_entry(file.to_str().unwrap()).unwrap()
    diagnostics :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Test)
    assert(diagnostics.is_empty(), "{diagnostics:#?}")
    rust :: emit_test_harness(bundle)
    assert_eq(rust.matches("// jet-mir-output-check:").count(), 2, "{rust}")
    assert_eq(rust.matches("fn __jet_output_check_").count(), 2, "{rust}")
    output :: Command.new(env.jet_bin()).args(["test", "--show-default", file.to_str().unwrap()]).current_dir(dir).output().expect("run Check Output harness")
    assert_eq(output.status.code(), Val(1), "{String.from_utf8_lossy(output.stderr)}")
    stdout :: String.from_utf8_lossy(output.stdout)
    assert(stdout.contains("unit: pass"), "{stdout}")
    assert(stdout.contains("release: FAIL"), "{stdout}")
    assert(String.from_utf8_lossy(output.stderr).contains("release blocked"))
}

// Rust: tests/output_callable.rs:687
#Test("renamed_entry_is_not_recovered_from_a_stale_lock") {
    dir :: common.unique_tmp("jet_output_callable_stale")
    fs.create_dir_all(dir.join(".jet")).unwrap()
    fs.write(dir.join(".jet/lock"), "version = 1\nentry = \"helper.start\"\n").unwrap()
    fs.write(dir.join("helper.jet"), "pub fn renamed() {}\n").unwrap()
    file :: dir.join("main.jet")
    fs.write(file, "use \"helper\"\nAPP :: Output.Executable{ name: \"demo\", entry: helper.start }\n").unwrap()
    bundle := jet.Loader.load_entry(file.to_str().unwrap()).unwrap()
    diagnostics :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run)
    assert(diagnostics.iter().any((diagnostic) -> diagnostic.code == "E1321"))
    assert(bundle.modules[bundle.entry].items.iter().all((item) -> match item { Item.Const(value) -> value.resolved_output.is_none(), _ -> true }))
}

// Rust: tests/output_callable.rs:714
#Test("typed_executable_output_reuses_the_checked_cli_schema") {
    dir :: common.unique_tmp("jet_output_callable_cli")
    fs.create_dir_all(dir).unwrap()
    file :: dir.join("main.jet")
    fs.write(file, "#CLI\nstruct Args { value: Int }\n\nAPP :: Output.Executable{ name: \"demo\", entry: launch }\n\nfn launch(args: Args) { print(args.value) }\n").unwrap()
    bundle := jet.Loader.load_entry(file.to_str().unwrap()).unwrap()
    diagnostics :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run)
    assert(diagnostics.is_empty(), "{diagnostics:#?}")
    schema :: CLISchema.entry_schema_for_bundle(bundle).expect("typed Output owns one checked CLI schema")
    assert_eq(schema.entry_type, "Args")
    rust :: emit_native_aot(bundle)
    assert(rust.contains("jet_args_option_base"), "{rust}")
    assert(rust.contains("__jet_launch(__jet_cli_0)"), "{rust}")
}

// Rust: tests/output_callable.rs:735
#Test("compiled_imported_typed_fallible_entry_uses_its_defining_module") {
    if !common.have_rustc() { return }
    dir :: common.unique_tmp("jet_output_callable_imported_cli")
    fs.create_dir_all(dir).unwrap()
    fs.write(dir.join("helper.jet"), "#CLI\npub struct Args { value: Int }\n\npub fn launch(args: Args) {\n    print(args.value)\n    return Err(\"imported boom\")\n}\n").unwrap()
    file :: dir.join("main.jet")
    fs.write(file, "use \"helper\"\nAPP :: Output.Executable{ name: \"demo\", entry: helper.launch }\n").unwrap()
    output :: Command.new(env.jet_bin()).args(["run", file.to_str().unwrap(), "--", "--value", "42"]).current_dir(dir).output().expect("run imported typed Output")
    assert_eq(output.status.code(), Val(1), "{String.from_utf8_lossy(output.stderr)}")
    assert_eq(String.from_utf8_lossy(output.stdout), "42\n", "{String.from_utf8_lossy(output.stderr)}")
    assert(String.from_utf8_lossy(output.stderr).contains("imported boom"))
}
