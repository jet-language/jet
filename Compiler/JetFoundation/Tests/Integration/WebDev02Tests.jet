    source :: fs.read_to_string(&entry).unwrap()
    revision :: Canvas.source_revision(&source)
    search :: "{{\"schema_version\":1,\"op\":\"project_search\",\"source_id\":\"app.jet\",\"revision\":\"{revision}\",\"project_revision\":\"{project_revision}\",\"query\":\"helper\"}}"
    (search_status, search_bytes) :: http_post(port, "/canvas/query", &search).expect("POST project search")
    assert_eq(search_status, 200, "project search response: {String.from_utf8_lossy(&search_bytes)}")
    search_body :: String.from_utf8_lossy(&search_bytes)
    assert(search_body.contains("\"op\":\"project_search\""), "{search_body}")
    assert(search_body.contains("\"source_id\":\"helper.jet\""), "{search_body}")
    references :: "{{\"schema_version\":1,\"op\":\"references\",\"source_id\":\"app.jet\",\"revision\":\"{revision}\",\"project_revision\":\"{project_revision}\",\"symbol\":\"helper\"}}"
    (ref_status, ref_bytes) :: http_post(port, "/canvas/query", &references).expect("POST project references")
    assert_eq(ref_status, 200)
    ref_body :: String.from_utf8_lossy(&ref_bytes)
    assert(ref_body.contains("\"op\":\"references\""), "{ref_body}")
    assert(ref_body.contains("\"kind\":\"reference\""), "{ref_body}")
    fs.write(dir.join("helper.jet"), "fn helper() -> Int {{\n    return 3\n}}\n").unwrap()
    (stale_status, stale_bytes) :: http_post(port, "/canvas/query", &search).expect("POST stale search")
    assert_eq(stale_status, 409)
    stale_body :: String.from_utf8_lossy(&stale_bytes)
    assert(stale_body.contains("\"kind\":\"conflict\""), "{stale_body}")
    assert(fs.read_to_string(dir.join("helper.jet")).unwrap().contains("return 3"))
    drop(^guard)
    _ :: fs.remove_dir_all(&dir)
}

