// Rust: tests/web_dev.rs:2492
#Test("jet_dev_web_status_does_not_expose_canvas_session_data") {
    if !have_tool("rustc") {
        eprintln("note: skipping jet_dev_web_status_does_not_expose_canvas_session_data (need rustc)")
        return
    }
    dir :: env.temp_dir().join("jet_dev_canvas_status_{id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    fs.write(dir.join("app.jet"), FIXTURE_SRC).unwrap()
    child := Command.new(jet_bin()).args(["dev", "app.jet", "--target=web", "--canvas"]).current_dir(&dir).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().expect("failed to start `jet dev --target=web`")
    struct KillOnDrop { child: Child }
    impl KillOnDrop.Drop {
        // Rust: tests/web_dev.rs:2518
        fn drop(&self) -> { _ :: self.child.kill(); _ :: self.child.wait() }
    }
    stdout :: child.stdout.take().unwrap()
    guard :: KillOnDrop{child: ^child}
    port :: wait_for_ports(^stdout).canvas
    (status, graph) :: http_get(port, "/canvas/graph").expect("GET authorized Canvas graph")
    assert_eq(status, 200)
    assert(String.from_utf8_lossy(&graph).contains("\"source_text\":"), "authorized graph must contain its source projection")
    (public_code, public_body) :: http_get_without_session(port, "/__jet_dev_status").expect("GET public dev status")
    assert_eq(public_code, 200)
    public_status :: String.from_utf8_lossy(&public_body)
    assert(!public_status.contains("\"session\":"), "public dev status must not expose retained Canvas session data: {public_status}")
    assert(!public_status.contains("\"source_text\":"), "public dev status must not expose retained Canvas graph source: {public_status}")
    drop(^guard)
    _ :: fs.remove_dir_all(&dir)
}

// Rust: tests/web_dev.rs:2553
#Test("jet_dev_web_live_canvas_debug_session_round_trip") {
    if !have_tool("rustc") {
        eprintln("note: skipping jet_dev_web_live_canvas_debug_session_round_trip (need rustc)")
        return
    }
    dir :: env.temp_dir().join("jet_dev_canvas_debug_{id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    entry :: dir.join("app.jet")
    source :: "fn run() -> {{\n    a := 1\n    b := a + 1\n    c := b + 1\n    print(\"debug\")\n}}\n"
    fs.write(&entry, source).unwrap()
    child := Command.new(jet_bin()).args(["dev", "app.jet", "--target=web", "--canvas"]).current_dir(&dir).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().expect("failed to start Canvas debug dev server")
    struct KillOnDrop { child: Child }
    impl KillOnDrop.Drop {
        // Rust: tests/web_dev.rs:2576
        fn drop(&self) -> { _ :: self.child.kill(); _ :: self.child.wait() }
    }
    stdout :: child.stdout.take().unwrap()
    guard :: KillOnDrop{child: ^child}
    port :: wait_for_ports(^stdout).canvas
    revision :: Canvas.source_revision(source)
    first :: "{{\"schema_version\":1,\"revision\":\"{revision}\",\"commands\":[\"s\"]}}"
    (first_status, first_bytes) :: http_post(port, "/canvas/debug", &first).expect("start Canvas debug")
    assert_eq(first_status, 200, "start response: {String.from_utf8_lossy(&first_bytes)}")
    first_body :: String.from_utf8_lossy(&first_bytes)
    assert(first_body.contains("\"protocol\":\"jet.canvas.debug\""), "{first_body}")
    assert(first_body.contains("\"state\":\"running\""), "{first_body}")
    assert(first_body.contains("\"tier\":\"jet-dev-interpreter\""), "{first_body}")
    assert(!first_body.contains("\"active_line\":null"), "{first_body}")
    session :: debug_session_id(&first_body)
    next_req :: "{{\"schema_version\":1,\"revision\":\"{revision}\",\"session_id\":\"{session}\",\"commands\":[\"s\"]}}"
    (next_status, next_bytes) :: http_post(port, "/canvas/debug", &next_req).expect("resume Canvas debug")
    assert_eq(next_status, 200, "resume response: {String.from_utf8_lossy(&next_bytes)}")
    next_body :: String.from_utf8_lossy(&next_bytes)
    assert(next_body.contains("\"state\":\"running\""), "{next_body}")
    assert(!next_body.contains("\"active_line\":null"), "{next_body}")
    invalid :: "{{\"schema_version\":1,\"revision\":\"{revision}\",\"session_id\":\"{session}\",\"commands\":[\"teleport\"]}}"
    (invalid_status, invalid_bytes) :: http_post(port, "/canvas/debug", &invalid).expect("reject invalid debug command")
    assert_eq(invalid_status, 409, "invalid response: {String.from_utf8_lossy(&invalid_bytes)}")
    assert(String.from_utf8_lossy(&invalid_bytes).contains("\"kind\":\"unsupported\""))
    after_invalid :: "{{\"schema_version\":1,\"revision\":\"{revision}\",\"session_id\":\"{session}\",\"commands\":[\"s\"]}}"
    (ai_status, ai_bytes) :: http_post(port, "/canvas/debug", &after_invalid).expect("resume after invalid debug command")
    assert_eq(ai_status, 200, "resume response: {String.from_utf8_lossy(&ai_bytes)}")
    assert(String.from_utf8_lossy(&ai_bytes).contains("\"state\":\"running\""))
    finish :: "{{\"schema_version\":1,\"revision\":\"{revision}\",\"session_id\":\"{session}\",\"commands\":[\"c\"]}}"
    (finish_status, finish_bytes) :: http_post(port, "/canvas/debug", &finish).expect("finish Canvas debug")
    assert_eq(finish_status, 200, "finish response: {String.from_utf8_lossy(&finish_bytes)}")
    finish_body :: String.from_utf8_lossy(&finish_bytes)
    assert(finish_body.contains("\"state\":\"finished\""), "{finish_body}")
    assert(finish_body.contains("\"active_line\":null"), "{finish_body}")
    stale_breakpoint :: "{{\"schema_version\":1,\"revision\":\"{revision}\",\"breakpoint_spans\":[\"999999:1000000\"],\"commands\":[\"c\"]}}"
    (sb_status, sb_bytes) :: http_post(port, "/canvas/debug", &stale_breakpoint).expect("stale breakpoint")
    assert_eq(sb_status, 200, "stale breakpoint response: {String.from_utf8_lossy(&sb_bytes)}")
    assert(String.from_utf8_lossy(&sb_bytes).contains("\"state\":\"stale\""), "{String.from_utf8_lossy(&sb_bytes)}")
    stale_revision :: "{{\"schema_version\":1,\"revision\":\"sha256-stale\",\"commands\":[\"s\"]}}"
    (sr_status, sr_bytes) :: http_post(port, "/canvas/debug", stale_revision).expect("stale revision")
    assert_eq(sr_status, 409, "stale revision response: {String.from_utf8_lossy(&sr_bytes)}")
    assert(String.from_utf8_lossy(&sr_bytes).contains("\"kind\":\"conflict\""))
    ended :: "{{\"schema_version\":1,\"revision\":\"{revision}\",\"session_id\":\"{session}\",\"commands\":[\"s\"]}}"
    (ended_status, ended_bytes) :: http_post(port, "/canvas/debug", &ended).expect("ended session")
    assert_eq(ended_status, 409, "ended response: {String.from_utf8_lossy(&ended_bytes)}")
    assert(String.from_utf8_lossy(&ended_bytes).contains("\"kind\":\"session\""))
    assert_eq(fs.read_to_string(&entry).unwrap(), source)
    drop(^guard)
    _ :: fs.remove_dir_all(&dir)
}

