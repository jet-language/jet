#Test("jet_dev_web_exposes_canvas_panel_and_graph") {
    if !have_tool("rustc") {
        eprintln("note: skipping jet_dev_web_exposes_canvas_panel_and_graph (need rustc)")
        return
    }
    // GATE #4494: real process, pipes and native HTTP provider.
    dir :: env.temp_dir().join("jet_dev_canvas_{id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    src_path :: dir.join("app.jet")
    fs.write(&src_path, FIXTURE_SRC).unwrap()
    child := Command.new(jet_bin()).args(["dev", "app.jet", "--target=web", "--canvas"]).current_dir(&dir).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().expect("failed to start `jet dev --target=web`")
    // Rust: tests/web_dev.rs:1607
    struct KillOnDrop { child: Child }
    impl KillOnDrop.Drop {
        // Rust: tests/web_dev.rs:1609
        fn drop(&self) -> { _ :: self.child.kill(); _ :: self.child.wait() }
    }
    stdout :: child.stdout.take().unwrap()
    guard :: KillOnDrop{child: ^child}
    port :: wait_for_ports(^stdout).canvas
