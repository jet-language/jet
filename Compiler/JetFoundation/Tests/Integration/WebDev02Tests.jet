    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    src_path :: dir.join("app.jet")
    port :: unused_local_port()
    fs.write(&src_path, fn_fixture_src(port, "hello, world")).unwrap()
    child := Command.new(jet_bin()).args(["dev", "app.jet"]).current_dir(&dir).env("PATH", &new_path).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().expect("failed to start `jet dev`")
    struct KillOnDrop { child: Child }
    impl KillOnDrop.Drop {
        // Rust: tests/web_dev.rs:2901
        fn drop(&self) -> { _ :: self.child.kill(); _ :: self.child.wait() }
    }
    // GATE #4494: drain both native pipes on real background threads to prevent a full-pipe deadlock.
    stderr :: child.stderr.take().unwrap()
    _ :: thread.spawn(() -> {
        reader :: BufReader.new(^stderr)
        loop line in reader.lines().map_while((result) -> result.ok()) { eprintln("[child stderr] {line}") }
    })
    stdout :: child.stdout.take().unwrap()
    _ :: thread.spawn(() -> {
        reader :: BufReader.new(^stdout)
        loop line in reader.lines().map_while((result) -> result.ok()) { eprintln("[child stdout] {line}") }
    })
    guard :: KillOnDrop{child: ^child}
    wait_for_server_up(port, Duration.from_secs(30))
    loop path in ["/C:/Windows/win.ini", "/\\Windows\\win.ini", "/\\\\server\\share\\secret"] {
        (status, _) :: http_get(port, path).expect("embedded static-path hostile request failed")
        assert_eq(status, 400, "embedded Windows absolute static path escaped the build root: {path}")
    }
    (status, version_body) :: http_get(port, "/__jet_dev_version").expect("GET /__jet_dev_version failed")
    assert_eq(status, 200)
    baseline_view := String.from_utf8_lossy(&version_body).trim() // #4303
    baseline_version :: baseline_view.to_string()
    (js_status, js_body) :: http_get(port, "/app.js").expect("GET /app.js failed")
    assert_eq(js_status, 200)
    assert(!js_body.is_empty(), "served app.js from the user's own dev() server should be non-empty")
    fs.write(&src_path, fn_fixture_src(port, "hello there")).unwrap()
    new_version :: wait_for_version_change(port, &baseline_version, Duration.from_secs(20))
    assert_ne(new_version, baseline_version)
    drop(^guard)
    _ :: fs.remove_dir_all(&dir)
}

