// Rust: tests/web_dev.rs:3358
#Test("embedded_devserver_slow_header_does_not_block_other_clients") {
    if !have_tool("rustc") {
        eprintln("note: skipping embedded_devserver_slow_header_does_not_block_other_clients (need rustc)")
        return
    }
    dir :: env.temp_dir().join("jet_embedded_devserver_slow_header_{id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    port :: unused_local_port()
    fs.write(dir.join("app.jet"), fn_fixture_src(port, "host")).unwrap()
    guard :: start_embedded_devserver(&dir, port)
    // GATE #4494: genuine slow TCP client and read timeout.
    slow := TcpStream.connect(("127.0.0.1", port)).unwrap()
    slow.set_read_timeout(Val(Duration.from_millis(200))).unwrap()
    slow.write_all("G".as_bytes()).unwrap()
    slow.flush().unwrap()
    (status, _, _) :: http_get_with_content_type(port, "/__jet_dev_version").expect("slow header must not block a normal client")
    assert_eq(status, 200)
    drop(^slow)
    drop(^guard)
    _ :: fs.remove_dir_all(&dir)
}
