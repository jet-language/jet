// Rust: tests/web_dev.rs:3053
#Test("jet_dev_static_generator_serves_reloads_and_watches_inputs") {
    if !have_tool("rustc") {
        eprintln("note: skipping jet_dev_static_generator_serves_reloads_and_watches_inputs (need rustc)")
        return
    }
    dir :: env.temp_dir().join("jet_dev_static_generator_{id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    source_path :: dir.join("generate.jet")
    generator_source :: fs.read_to_string(env.manifest_dir().join("Examples/features/devloop/static_site_generator/run.jet")).unwrap()
    fs.write(&source_path, generator_source).unwrap()
    fs.write(dir.join("package.jet"), fs.read_to_string(env.manifest_dir().join("Examples/features/devloop/static_site_generator/package.jet")).unwrap()).unwrap()
    fs.write(dir.join("content.txt"), "first headline").unwrap()
    fs.write(dir.join("widget.wasm"), [0, 97, 115, 109]).unwrap()
    child := Command.new(jet_bin()).args(["dev", "generate.jet"]).current_dir(&dir).stdout(Stdio.piped()).stderr(Stdio.null()).spawn().expect("failed to start static generator dev loop")
    struct KillOnDrop { child: Child }
    impl KillOnDrop.Drop {
        // Rust: tests/web_dev.rs:3091
        fn drop(&self) -> { _ :: self.child.kill(); _ :: self.child.wait() }
    }
    stdout :: child.stdout.take().unwrap()
    guard :: KillOnDrop{child: ^child}
    port :: wait_for_app_preview(^stdout)
    wait_for_server_up(port, Duration.from_secs(20))
    (status, html_body) :: http_get_without_session(port, "/").expect("GET static index")
    assert_eq(status, 200)
    html :: String.from_utf8_lossy(&html_body)
    assert(html.contains("<h1>first headline</h1>"), "{html}")
    assert(html.contains("__jet_dev_status"), "live reload not injected")
    (wasm_status, content_type, wasm) :: http_get_with_content_type(port, "/widget.wasm").expect("GET generated wasm")
    assert_eq(wasm_status, 200)
    assert_eq(content_type, "application/wasm")
    assert_eq(wasm, [0, 97, 115, 109])
    (_, baseline_body) :: http_get_without_session(port, "/__jet_dev_version").unwrap()
    baseline_view := String.from_utf8_lossy(&baseline_body).trim() // #4303
    baseline :: baseline_view.to_string()
    fs.write(dir.join("content.txt"), "second headline").unwrap()
    after_input :: wait_for_version_change(port, &baseline, Duration.from_secs(20))
    assert_ne(after_input, baseline)
    (_, input_body) :: http_get_without_session(port, "/").expect("GET index after input edit")
    assert(String.from_utf8_lossy(&input_body).contains("<h1>second headline</h1>"), "generator input edit was not served")
    edited_source :: generator_source.replace("<h1>{{headline}}</h1>", "<h1>source edit: {{headline}}</h1>")
    assert_ne(edited_source, generator_source, "static generator source fixture did not change")
    fs.write(&source_path, edited_source).unwrap()
    after_source :: wait_for_version_change(port, &after_input, Duration.from_secs(20))
    assert_ne(after_source, after_input)
    (_, source_body) :: http_get_without_session(port, "/").expect("GET index after source edit")
    assert(String.from_utf8_lossy(&source_body).contains("<h1>source edit: second headline</h1>"), "generator source edit was not served")
    drop(^guard)
    _ :: fs.remove_dir_all(&dir)
}

// Rust: tests/web_dev.rs:3147
#Test("embedded_devserver_static_read_survives_concurrent_symlink_swap") {
    // GATE #4483: this reference arm is Unix-only.
    if target.selected_family() != "unix" { return }
    if !have_tool("rustc") {
        eprintln("note: skipping embedded_devserver_static_read_survives_concurrent_symlink_swap (need rustc)")
        return
    }
    // GATE #4494: actual symlink race, Arc atomics and native threads.
    dir :: env.temp_dir().join("jet_embedded_devserver_symlink_race_{id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    fixture_port :: unused_local_port()
    fs.write(dir.join("app.jet"), "use core.web.devserver as devserver\n\nfn dev() -> {{\n    server :: devserver.app()\n    server.port({fixture_port})\n    server.serve()\n}}\n\nfn run() -> {{\n    print(\"host\")\n}}\n").unwrap()
    child := Command.new(jet_bin()).args(["dev", "app.jet"]).current_dir(&dir).stdout(Stdio.piped()).stderr(Stdio.null()).spawn().expect("failed to start embedded devserver symlink-race fixture")
    struct KillOnDrop { child: Child }
    impl KillOnDrop.Drop {
        // Rust: tests/web_dev.rs:3192
        fn drop(&self) -> { _ :: self.child.kill(); _ :: self.child.wait() }
    }
    stdout :: child.stdout.take().unwrap()
    guard :: KillOnDrop{child: ^child}
    port :: wait_for_app_preview(^stdout)
    wait_for_server_up(port, Duration.from_secs(30))
    build :: dir.join("build")
    race_target :: build.join("race.js")
    parked :: build.join("race.js.parked")
    outside :: dir.join("outside-secret.js")
    outside_marker :: "outside-secret".as_bytes()
    fs.write(&outside, outside_marker).unwrap()
    fs.write(&race_target, "inside".as_bytes()).unwrap()
    (status, content_type, body) :: http_get_with_content_type(port, "/race.js").expect("initial static GET failed")
    assert_eq(status, 200)
    assert_eq(content_type, "application/javascript; charset=utf-8")
    assert_eq(body, "inside".as_bytes())
    stop :: Arc.new(AtomicBool.new(false))
    leaked :: Arc.new(AtomicBool.new(false))
    swaps :: Arc.new(AtomicUsize.new(0))
    served :: Arc.new(AtomicUsize.new(0))
    swap_stop :: Arc.clone(&stop)
    swap_target :: race_target.clone()
    swap_parked :: parked.clone()
    swap_outside :: outside.clone()
    swap_count :: Arc.clone(&swaps)
    swapper :: thread.spawn(() -> {
        loop !swap_stop.load(Ordering.Relaxed) {
            _ :: fs.remove_file(&swap_parked)
            if fs.rename(&swap_target, &swap_parked).is_ok() {
                if symlink(&swap_outside, &swap_target).is_ok() { _ :: swap_count.fetch_add(1, Ordering.Relaxed) }
                _ :: fs.remove_file(&swap_target)
                _ :: fs.rename(&swap_parked, &swap_target)
                thread.sleep(Duration.from_micros(50))
            }
        }
    })
    requests := []
    loop _ in 0..<4 {
        request_leaked :: Arc.clone(&leaked)
        request_served :: Arc.clone(&served)
        requests.push(thread.spawn(() -> {
            loop _ in 0..<512 {
                if http_get_without_session(port, "/race.js") == {
                    Val((status, body)) -> {
                        if status == 200 { _ :: request_served.fetch_add(1, Ordering.Relaxed) }
                        if body.windows(outside_marker.len()).any((window) -> window == outside_marker) || (status == 200 && body != "inside".as_bytes()) {
                            request_leaked.store(true, Ordering.Relaxed)
                            break
                        }
                    }
                    None -> next
                }
            }
        }))
    }
    loop request in ^requests { request.join().unwrap() }
    stop.store(true, Ordering.Relaxed)
    swapper.join().unwrap()
    _ :: fs.remove_file(&race_target)
    _ :: fs.rename(&parked, &race_target)
    assert(!leaked.load(Ordering.Relaxed), "concurrent static serving returned bytes from outside the build root")
    assert(swaps.load(Ordering.Relaxed) > 0 && served.load(Ordering.Relaxed) > 0, "hostile race did not observe both symlink swaps and successful in-root reads")
    drop(^guard)
    _ :: fs.remove_dir_all(&dir)
}

