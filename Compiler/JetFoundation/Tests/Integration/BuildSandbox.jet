// T1/T2 (#99): build-from-source sandbox and pinned toolchain conformance.
use common
use jetpack.Recipe.[BuildContext, BuildRecipe, BuildStep]
use jetpack.[Recipe, Toolchain]
use std.fs
use std.sync.[Mutex, MutexGuard, OnceLock]
use std.time.[SystemTime, UNIX_EPOCH]
// Rust: tests/build_sandbox.rs:22
HOSTILE_CORPUS :: include_str("tests/fixtures/build_sandbox/hostile-corpus.tsv")
// Rust: tests/build_sandbox.rs:24
// GATE #4494: native OnceLock and mutex poison recovery.
SANDBOX_TEST_LOCK :: OnceLock<Mutex<()>>.new()
// Rust: tests/build_sandbox.rs:26
fn sandbox_test_lock() -> MutexGuard<()> {
    SANDBOX_TEST_LOCK.get_or_init(() -> Mutex.new(())).lock().unwrap_or_else((poisoned) -> poisoned.into_inner())
}
// Rust: tests/build_sandbox.rs:54
fn scratch(tag: &String) -> OSPath {
    p :: std.env.temp_dir().join("build-sandbox-{tag}-{SystemTime.now().duration_since(UNIX_EPOCH).unwrap().as_nanos()}")
    fs.create_dir_all(&p).unwrap()
    p
}
// Rust: tests/build_sandbox.rs:66
fn hostile_cases() -> [(String, String, String, String)] {
    cases :: HOSTILE_CORPUS.lines().filter((line) -> !line.is_empty() && !line.starts_with('#')).map((line) -> {
        fields :: line.split('\t').collect()
        assert_eq(fields.len(), 4, "malformed hostile corpus row: {line}")
        (fields[0].to_string(), fields[1].to_string(), fields[2].to_string(), fields[3].to_string())
    }).collect()
    assert_eq(cases.len(), 7, "hostile corpus lost a required case")
    ids := Set<String>.new()
    for (id, category, attempt, expected) in cases {
        assert(ids.insert(id), "hostile corpus repeats case {id}")
        assert(["escape", "exfiltration", "resource-abuse", "toctou", "child-process-abuse"].contains(category), "{id} has an unknown hostile category {category}")
        assert(!attempt.is_empty(), "{id} has no hostile attempt")
        assert_eq(expected, "blocked-or-unsupported", "{id} has a weak result claim")
    }
    for category in ["escape", "exfiltration", "resource-abuse", "toctou", "child-process-abuse"] {
        assert(cases.iter().any(((_, found, _, _)) -> found == category), "hostile corpus lacks category {category}")
    }
    cases
}
// Rust: tests/build_sandbox.rs:368
fn windows_command_interpreter() -> OSPath {
    std.env.var_os("ComSpec").or_else(() -> std.env.var_os("COMSPEC")).map((path) -> OSPath(path)).unwrap_or_else(() -> OSPath("C:\\Windows\\System32\\cmd.exe"))
}
// Rust: tests/build_sandbox.rs:961
fn run_macos_attack(tag: &String, command_template: &String) -> {
    _sandbox_guard :: sandbox_test_lock()
    base :: scratch(tag)
    src :: base.join("src"); out :: base.join("out"); cache :: base.join("cache")
    fs.create_dir_all(&src).unwrap()
    host :: base.join("host-secret"); outside :: base.join("escape")
    fs.write(&host, "host-only").unwrap()
    command :: command_template.replace("{HOST}", &host.to_string_lossy()).replace("{OUTSIDE}", &outside.to_string_lossy())
    tools :: ["bash": OSPath("/bin/bash")]
    ctx :: BuildContext { source_dir: &src, output_root: &out, tools, fetch_cache: &cache, offline: false }
    recipe :: BuildRecipe { steps: [BuildStep.Exec { tool: "bash", args: ["-c", command] }] }
    error :: Recipe.run(&recipe, &ctx, None).unwrap_err()
    assert(["E1237", "E1238"].contains(error.code), "{error:?}")
    assert(!outside.exists(), "macOS sandbox escape succeeded: {outside:?}")
    _ :: fs.remove_dir_all(&base).ok()
}
// Rust: tests/build_sandbox.rs:1466
fn shell_quote(path: &OSPath) -> String { "'{path.to_string_lossy().replace('\'', "'\\''")}'" }
// Rust: tests/build_sandbox.rs:1471
fn jet_string_literal(value: &String) -> String {
    literal := String.from("\"")
    for character in value.chars() {
        if character == {
            '\\' -> literal.push_str("\\\\")
            '"' -> literal.push_str("\\\"")
            '\n' -> literal.push_str("\\n")
            '\r' -> literal.push_str("\\r")
            '\t' -> literal.push_str("\\t")
            character -> literal.push(character)
        }
    }
    literal.push('"')
    literal
}
// Rust: tests/build_sandbox.rs:1488
fn host_tool(name: &String) -> OSPath {
    std.env.split_paths(&std.env.var_os("PATH").expect("PATH should be set")).map((dir) -> dir.join(name)).find((candidate) -> candidate.is_file()).and_then((candidate) -> fs.canonicalize(candidate).ok()).unwrap_or_else(() -> OSPath("/bin/{name}"))
}
