// Rust: tests/agent_executor.rs:1
// Authority-bound execution through the public Core surface across hosted tiers.
use jet_foundation.Tests.Integration.TirSupport as tir_support
use jetpack.RuntimePolicy as RuntimePolicy
use std.[env, fs, process]
use core.sys.target.selected_os

// Rust: tests/agent_executor.rs:12
fn native_backend_available() -> Bool {
    RuntimePolicy.detect_sandbox().level == RuntimePolicy.SandboxLevel.Strong
}

// Rust: tests/agent_executor.rs:18
#Test("agent_executor_plan_and_receipt_preserve_one_policy_across_tiers") {
    if selected_os() == "linux" || selected_os() == "macos" {
        source :: """
use core.process as process
fn run() {
    policy :: process.workspace()
    spec :: process.cmd(["printf", "agent-safe"])
        .stdout(.Capture).stderr(.Capture).cwd("/tmp").under(policy)
    if spec.plan() == {
        .Ok(plan) -> {
            receipt :: spec.run_checked() ?? panic("authority-bound run failed")
            print(plan.executable_identity == receipt.executable_identity)
            print(plan.argv == receipt.argv)
            print(plan.input_digest == receipt.input_digest)
            print(plan.policy_digest == receipt.policy_digest)
            print(plan.backend == receipt.backend)
            print(plan.authority == receipt.authority)
            print(plan.descendants == receipt.descendants)
            print(plan.limits == receipt.limits)
            print(plan.outputs[0] == receipt.outputs[0])
            print(plan.outputs[1] == receipt.outputs[1])
            print(receipt.outputs.len() == plan.outputs.len() + 1)
            print(receipt.output)
            print(receipt.redacted)
        }
        .Err(_) -> print("unsupported")
    }
}
"""
        expected :: if native_backend_available() -> "true\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\nagent-safe\ntrue\n" else -> "unsupported\n"
        tir_support.assert_tiers_agree("agent_executor_plan_receipt", source, expected)
    }
}

// Rust: tests/agent_executor.rs:60
#Test("agent_executor_hostile_filesystem_examples_fail_closed_on_all_tiers") {
    if selected_os() == "linux" || selected_os() == "macos" {
        marker :: env.temp_dir().join("jet-agent-executor-host-write-{process.id()}")
        _ :: fs.remove_file(&marker)
        source :: """
use core.process as process
fn run() {
    policy :: process.workspace()
    read_spec :: process.cmd(["sh", "-c", "if test -r /etc/passwd; then exit 41; else exit 0; fi"]).cwd("/tmp").under(policy)
    if read_spec.plan() == {
        .Ok(_) -> {
            if read_spec.run_checked() == {
                .Ok(_) -> print("host-read-blocked")
                .Err(_) -> print("host-read-escaped")
            }
        }
        .Err(_) -> print("unsupported")
    }
    write_spec :: process.cmd(["sh", "-c", "if printf escaped > '__MARKER__'; then exit 41; else exit 0; fi"]).cwd("/tmp").under(policy)
    if write_spec.plan() == {
        .Ok(_) -> {
            if write_spec.run_checked() == {
                .Ok(_) -> print("host-write-blocked")
                .Err(_) -> print("host-write-escaped")
            }
        }
        .Err(_) -> print("unsupported")
    }
}
""".replace("__MARKER__", marker.to_string_lossy())
        expected :: if native_backend_available() -> "host-read-blocked\nhost-write-blocked\n" else -> "unsupported\nunsupported\n"
        tir_support.assert_tiers_agree("agent_executor_hostile_filesystem", source, expected)
        assert(!marker.exists(), "authority-bound process wrote outside its output grant")
    }
}

// Rust: tests/agent_executor.rs:109
#Test("agent_executor_explicit_cancellation_reaps_descendants_on_all_tiers") {
    if selected_os() == "linux" || selected_os() == "macos" {
        source :: """
use core.process as process
fn run() {
    policy :: process.workspace()
    spec :: process.cmd(["sh", "-c", "while true; do sleep 1; done"])
        .stdout(.Capture).stderr(.Capture).cwd("/tmp").under(policy)
    if spec.spawn() == {
        .Ok(child) -> {
            child.kill() ?? panic("authority-bound cancellation failed")
            receipt :: child.wait() ?? panic("cancelled child did not reap")
            print(receipt.success)
            print(receipt.timed_out)
            print(receipt.descendants)
        }
        .Err(_) -> print("unsupported")
    }
}
"""
        expected :: if native_backend_available() -> "false\nfalse\ncontained\n" else -> "unsupported\n"
        tir_support.assert_tiers_agree("agent_executor_cancellation", source, expected)
    }
}

// Rust: tests/agent_executor.rs:142
#Test("agent_executor_windows_appcontainer_plan_and_receipt_preserve_policy") {
    if selected_os() == "windows" {
        source :: """
use core.process as process
fn run() {
    policy :: process.workspace()
    spec :: process.cmd(["cmd.exe", "/C", "exit", "0"]).cwd("/tmp").under(policy)
    if spec.plan() == {
        .Ok(plan) -> {
            receipt :: spec.run_checked() ?? panic("Windows authority-bound run failed")
            print(plan.backend)
            print(plan.executable_identity == receipt.executable_identity)
            print(plan.argv == receipt.argv)
            print(plan.input_digest == receipt.input_digest)
            print(plan.policy_digest == receipt.policy_digest)
            print(plan.authority == receipt.authority)
            print(plan.descendants == receipt.descendants)
            print(plan.limits == receipt.limits)
            print(plan.outputs[0] == receipt.outputs[0])
            print(plan.outputs[1] == receipt.outputs[1])
            print(receipt.outputs.len() == plan.outputs.len() + 1)
            print(receipt.redacted)
        }
        .Err(_) -> print("refused")
    }
}
"""
        tir_support.assert_tiers_agree("agent_executor_windows_appcontainer_plan_receipt", source, "windows-appcontainer\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\n")
    }
}

// Rust: tests/agent_executor.rs:178
#Test("agent_executor_windows_appcontainer_denies_host_read") {
    if selected_os() == "windows" {
        marker_path :: env.temp_dir().join("jet-agent-executor-windows-host-secret-{process.id()}.txt")
        fs.write(&marker_path, "host-secret").expect("write Windows host-read marker")
        marker :: marker_path.to_string_lossy().replace('\\', "/")
        source :: """
use core.process as process
fn run() {
    policy :: process.workspace()
    spec :: process.cmd(["cmd.exe", "/C", "type \"__MARKER__\""]).cwd("/tmp").under(policy)
    if spec.plan() == {
        .Ok(plan) -> {
            print(plan.backend)
            result :: spec.run_checked()
            if result == {
                .Ok(_) -> print("escaped")
                .Err(_) -> print("blocked")
            }
        }
        .Err(_) -> print("refused")
    }
}
""".replace("__MARKER__", marker)
        tir_support.assert_tiers_agree("agent_executor_windows_appcontainer_host_read", source, "windows-appcontainer\nblocked\n")
        _ :: fs.remove_file(marker)
    }
}
