// Rust: tests/support/corpus_policy.rs:122
pub fn rule_registry() -> &[RuleSpec] { &RULE_REGISTRY }
// Rust: tests/support/corpus_policy.rs:174
pub struct SemanticViolation {
    pub file: String
    pub rule: String
    pub site: String
    pub why: String
    pub replacement: String
    // Rust: tests/support/corpus_policy.rs:183
    pub fn new(file: String, rule: String, site: String) -> SemanticViolation {
        spec :: rule_registry().iter().find(fn(spec) -> spec.name == rule)
            .unwrap_or_else(fn() { panic("unregistered corpus rule: {rule}") })
        SemanticViolation{file: file, rule: rule, site: ^site, why: spec.why, replacement: spec.replacement}
    }
}
impl std.fmt.Display for SemanticViolation {
    // Rust: tests/support/corpus_policy.rs:199
    pub fn fmt(self, out: &std.fmt.Formatter) -> Unit Err! {
        out.write("file={self.file}; rule={self.rule}; site={self.site}; why={self.why}; replacement={self.replacement}")
    }
}
