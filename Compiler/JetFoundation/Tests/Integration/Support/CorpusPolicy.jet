fn is_response_decoder(function: &Func) -> Bool {
    function.name == "decode_response" && function.params.len() == 2
        && named_type(&function.params[0].ty, "String") && named_type(&function.params[1].ty, "Int")
        && if function.return_type.as_ref() == {
            .Some(.Result{ok, ..}) -> named_type(ok, "DataTree")
            _ -> false
        }
}
// Rust: tests/support/corpus_policy.rs:922
fn protocol_override_identity(protocol: String) -> String? {
