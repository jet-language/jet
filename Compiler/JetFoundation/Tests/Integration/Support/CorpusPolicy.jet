    program_expressions(program).iter().any(fn(expr) -> is_process_input(expr, &aliases))
}
// Rust: tests/support/corpus_policy.rs:1543
enum CorpusWalkNode {
    Expr(&Expr), Stmt(&Stmt), LValue(&jet.AST.LValue), ForKind(&ForKind),
    BindPattern(&BindPattern), Pattern(&Pattern), Fallback(&OrFallback)
}
// Rust: tests/support/corpus_policy.rs:1552
fn push_corpus_statements(stack: &[CorpusWalkNode], body: &[Stmt]) -> Unit {
    loop statement in body.iter().rev() -> stack.push(.Stmt(statement))
}
// Rust: tests/support/corpus_policy.rs:1558
fn push_corpus_args(stack: &[CorpusWalkNode], args: &[CallArg]) -> Unit {
    loop argument in args.iter().rev() -> stack.push(.Expr(&argument.expr))
}

// Visit borrowed corpus expressions iteratively; neither clone ancestors nor
// consume call-stack depth proportional to source shape.
// Rust: tests/support/corpus_policy.rs:1569
pub fn for_each_statement_expr(body: &[Stmt], f: fn(&Expr) -> Unit) -> Unit {
    stack := [CorpusWalkNode].with_capacity(body.len())
    push_corpus_statements(&stack, body)
    loop {
        node :: stack.pop() else { break }
        if node == {
            .Stmt(statement) -> if statement == {
                .Expr(expr) -> stack.push(.Expr(expr))
                .DeferClose{close, ..} -> stack.push(.Expr(close))
                .Val(binding) -> {
                    if pattern :: binding.pattern.as_ref() -> stack.push(.BindPattern(pattern))
                    stack.push(.Expr(&binding.init))
                }
                .Assign{target, value, ..} -> {
                    stack.push(.Expr(value))
                    stack.push(.LValue(target))
                }
                .Return(value, _) -> { if value :: value -> stack.push(.Expr(value)) }
                .While{cond, body, ..} -> {
                    push_corpus_statements(&stack, body)
                    stack.push(.Expr(cond))
                }
                .For{kind, body, ..} -> {
                    push_corpus_statements(&stack, body)
                    stack.push(.ForKind(kind))
                }
                .Switch{subject, arms, else_body, ..} | .ComptimeSwitch{subject, arms, else_body, ..} -> {
                    if body :: else_body -> push_corpus_statements(&stack, body)
                    loop arm in arms.iter().rev() {
                        push_corpus_statements(&stack, &arm.body)
                        stack.push(.Expr(&arm.cond))
                    }
                    stack.push(.Expr(subject))
                }
                .BreakValue(value, _) | .Yield(value, _) -> stack.push(.Expr(value))
                .BreakLabelValue(_, _, value, _) -> stack.push(.Expr(value))
                .Loop{body, ..} | .Reactive{body, ..} | .Shield{body, ..}
                    | .Switched{body, ..} | .Region{body, ..} | .Policy{body, ..}
                    | .AuthorityScope{body, ..} | .ComptimeBlock{body, ..}
                    | .Live{body, ..} | .Transact{body, ..} | .Layout{body, ..} -> push_corpus_statements(&stack, body)
                .Unsafe{audit_expr, body, ..} -> {
                    push_corpus_statements(&stack, body)
                    if expr :: audit_expr -> stack.push(.Expr(expr))
                }
                .Impure{reason_expr, body, ..} -> {
                    push_corpus_statements(&stack, body)
                    if expr :: reason_expr -> stack.push(.Expr(expr))
                }
                .CountedLoop{init, cond, step, body, ..} -> {
                    push_corpus_statements(&stack, body)
                    if step :: step -> stack.push(.Stmt(step.as_ref()))
                    stack.push(.Expr(cond))
                    stack.push(.Expr(&init.init))
                }
                .TaskGroup{limit, body, ..} -> {
                    push_corpus_statements(&stack, body)
                    if limit :: limit -> stack.push(.Expr(limit))
                }
                .ContextBlock{fields, body, ..} -> {
                    push_corpus_statements(&stack, body)
                    loop (_, value, _) in fields.iter().rev() -> stack.push(.Expr(value))
                }
                .AssumeDet{reason_expr, body, ..} -> {
                    push_corpus_statements(&stack, body)
                    stack.push(.Expr(reason_expr))
                }
                .ComptimeIf{cond, then_body, else_body, ..} -> {
                    if body :: else_body -> push_corpus_statements(&stack, body)
                    push_corpus_statements(&stack, then_body)
                    stack.push(.Expr(cond))
                }
                .ScopeMember{args, body, ..} -> {
                    push_corpus_statements(&stack, body)
                    loop arg in args.iter().rev() -> stack.push(.Expr(arg))
                }
                .Break(_) | .Continue(_) | .BreakLabel(..) | .ContinueLabel(..) -> {}
            }
            .Expr(expr) -> {
                f(expr)
                if expr == {
                    .Str(parts, _) -> {
                        loop part in parts.iter().rev() {
                            if part == { .Interp(inner, _) -> stack.push(.Expr(inner)) _ -> {} }
                        }
                    }
                    .ListLit(items, _) -> { loop item in items.iter().rev() -> stack.push(.Expr(item)) }
                    .MemberSpread{base, ..} | .Spread(base, _) | .Deref(base, _)
                        | .RawOf(base, _) | .Copy(base, _) | .Place(base, _, _)
                        | .Field(base, _, _) | .Present(base, _) | .Ok(base, _)
                        | .Err(base, _) | .Paren(base, _) -> stack.push(.Expr(base))
                    .Try(base, _, _, note) -> {
                        if note :: note -> stack.push(.Expr(note))
                        stack.push(.Expr(base))
                    }
                    .MapLit(entries, _) -> {
                        loop (key, value) in entries.iter().rev() {
                            stack.push(.Expr(value))
                            stack.push(.Expr(key))
                        }
                    }
                    .Index{base, index, ..} -> {
                        stack.push(.Expr(index))
                        stack.push(.Expr(base))
                    }
                    .Slice{base, start, end, range, ..} -> {
                        if range :: range -> stack.push(.Expr(range))
                        stack.push(.Expr(end))
                        stack.push(.Expr(start))
                        stack.push(.Expr(base))
                    }
                    .Range{start, end, ..} -> {
                        stack.push(.Expr(end))
                        stack.push(.Expr(start))
                    }
                    .Call(call) -> push_corpus_args(&stack, &call.args)
                    .Unary(_, inner, _) -> stack.push(.Expr(inner))
                    .Binary(_, lhs, rhs, _) -> {
                        stack.push(.Expr(rhs))
                        stack.push(.Expr(lhs))
                    }
                    .CompareChain{operands, ..} -> { loop operand in operands.iter().rev() -> stack.push(.Expr(operand)) }
                    .OptField{base, ..} -> stack.push(.Expr(base))
                    .MethodCall{receiver, args, ..} -> {
                        push_corpus_args(&stack, args)
                        stack.push(.Expr(receiver))
                    }
                    .StructLit{fields, ..} -> { loop (_, _, value) in fields.iter().rev() -> stack.push(.Expr(value)) }
                    .TypedLit{body, ..} -> if body == {
                        .Fields(fields) -> { loop (_, _, value) in fields.iter().rev() -> stack.push(.Expr(value)) }
                        .Elements(elements) -> { loop element in elements.iter().rev() -> stack.push(.Expr(element)) }
                        .Entries(entries) -> {
                            loop (key, value) in entries.iter().rev() {
                                stack.push(.Expr(value))
                                stack.push(.Expr(key))
                            }
                        }
                        .Value(value) -> stack.push(.Expr(value))
                        .ByteText(_) | .Empty -> {}
                    }
                    .EnumLit{args, ..} -> {
                        loop arg in args.iter().rev() {
                            value :: if arg == {
                                .Positional(value) | .Named{expr: value, ..} -> value
                            }
                            stack.push(.Expr(value))
                        }
                    }
                    .Tainted(inner, _, _) -> stack.push(.Expr(inner))
                    .PatternTest{subject, pattern, ..} -> {
                        stack.push(.Pattern(pattern))
                        stack.push(.Expr(subject))
                    }
                    .OrFallback{value, fallback, ..} -> {
                        stack.push(.Fallback(fallback))
                        stack.push(.Expr(value))
                    }
                    .If{cond, then_body, then_value, else_body, else_value, ..} -> {
                        stack.push(.Expr(else_value))
                        push_corpus_statements(&stack, else_body)
                        stack.push(.Expr(then_value))
                        push_corpus_statements(&stack, then_body)
                        stack.push(.Expr(cond))
                    }
                    .TupleLit(fields, _, _) -> { loop (_, value) in fields.iter().rev() -> stack.push(.Expr(value)) }
                    .Lambda(lambda) -> if lambda.body == {
                        .Expr(value) -> stack.push(.Expr(value))
                        .Block(body) -> push_corpus_statements(&stack, body)
                    }
                    .CallValue{callee, args, ..} -> {
                        push_corpus_args(&stack, args)
                        stack.push(.Expr(callee))
                    }
                    .PtrFromAddr{addr, ..} -> stack.push(.Expr(addr))
                    .StrMatchLit(..) | .BinMatchLit(..) | .Int(..) | .Float(..)
                        | .Bool(..) | .Unit(..) | .Char(..) | .Ident(..) | .UnitLit{..}
                        | .Absent(..) | .Todo{..} | .NoElse(..) | .ReduceMarker(..)
                        | .ComptimeName{..} -> {}
                }
            }
            .LValue(lvalue) -> if lvalue == {
                .Local{..} -> {}
                .Index{base, index, ..} -> {
                    stack.push(.Expr(index))
                    stack.push(.Expr(base))
                }
                .Field{base, ..} -> stack.push(.Expr(base))
            }
            .ForKind(kind) -> if kind == {
                .Range{start, end, step, ..} -> {
                    if step :: step -> stack.push(.Expr(step))
                    stack.push(.Expr(end))
                    stack.push(.Expr(start))
                }
                .In{collection, step} -> {
                    if step :: step -> stack.push(.Expr(step))
                    stack.push(.Expr(collection))
                }
            }
            .BindPattern(pattern) -> if pattern == {
                .Refutable{pattern, fallback, ..} -> {
                    stack.push(.Fallback(fallback))
                    stack.push(.Pattern(pattern))
                }
                _ -> {}
            }
            .Pattern(pattern) -> if pattern == {
                .Or(alternatives, _) -> { loop alternative in alternatives.iter().rev() -> stack.push(.Pattern(alternative)) }
                .Struct{fields, ..} -> {
                    loop field in fields.iter().rev() {
                        if field == { .Value{value, ..} -> stack.push(.Expr(value)) _ -> {} }
                    }
                }
                .Variant{..} | .Present{..} | .Absent(..) | .Ok{..}
                    | .Err{..} | .Range{..} | .StrMatch{..} | .BinMatch{..} -> {}
            }
            .Fallback(fallback) -> if fallback == {
                .Value(value) -> stack.push(.Expr(value))
                .Block{body, value, ..} -> {
                    if value :: value -> stack.push(.Expr(value))
                    push_corpus_statements(&stack, body)
                }
                .Return(.Some(value), _) -> stack.push(.Expr(value))
                .Panic{args, ..} -> push_corpus_args(&stack, args)
                .Return(.None, _) | .Break(_) | .Continue(_) | .BreakLabel(..) | .ContinueLabel(..) -> {}
            }
        }
    }
}

