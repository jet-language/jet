    fn apply_exceptions(self, path: String, candidates: [SemanticViolation]) -> [SemanticViolation] Err! {
        remaining := [SemanticViolation]{}
        matched := [(String, String): USize]{}
        errors := [String]{}
        loop candidate in candidates {
            key :: (candidate.rule, candidate.site)
            exception :: self.corpus_manifest.exceptions.iter().find(fn(exception) ->
                exception.rule == candidate.rule && exception.selector == "file:{path}" && exception.site == candidate.site
            )
            if exception.is_some() -> matched[key] = matched.get(key).copied().unwrap_or(0) + 1
        }
        loop exception in self.corpus_manifest.exceptions.iter().filter(fn(exception) -> exception.selector == "file:{path}") {
            actual :: matched.get((exception.rule, exception.site)).copied().unwrap_or(0)
            if actual != exception.expected {
                errors.push("file={path}; rule={exception.rule}; site={exception.site}; why=expected {exception.expected} occurrence(s), found {actual}; replacement=remove the additional occurrence or update the exact reviewed site")
            }
        }
        consumed := [(String, String): USize]{}
        loop candidate in ^candidates {
            key :: (candidate.rule, candidate.site)
            exception :: self.corpus_manifest.exceptions.iter().find(fn(exception) ->
                exception.rule == candidate.rule && exception.selector == "file:{path}" && exception.site == candidate.site
            )
            if exception :: exception {
                seen :: consumed.get(key).copied().unwrap_or(0) + 1
                consumed[key] = seen
                if seen > exception.expected -> remaining.push(^candidate)
            } else { remaining.push(^candidate) }
        }
        if !errors.is_empty() -> fail errors.join("\n")
        remaining
    }
