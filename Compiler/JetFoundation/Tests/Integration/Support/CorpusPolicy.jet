// Rust: tests/support/corpus_policy.rs:231
pub struct CorpusPolicy {
    root: OSPath
    corpus_manifest: CorpusManifest
    // Rust: tests/support/corpus_policy.rs:237
    pub fn load() -> CorpusPolicy Err! {
        CorpusPolicy.from_manifest(MANIFEST, OSPath.from(env.build_var("CARGO_MANIFEST_DIR")))
    }
    // Rust: tests/support/corpus_policy.rs:241
    pub fn from_manifest(text: String, root: OSPath) -> CorpusPolicy Err! {
        manifest :: CorpusManifest.parse(text)
        manifest.validate()
        validate_manifest_paths(&manifest, &root)
        CorpusPolicy{root: ^root, corpus_manifest: ^manifest}
    }
    // Rust: tests/support/corpus_policy.rs:249
    pub fn manifest(self) -> &CorpusManifest { &self.corpus_manifest }
    // Rust: tests/support/corpus_policy.rs:253
    pub fn validate(self) -> Unit Err! { self.corpus_manifest.validate() }
    // Rust: tests/support/corpus_policy.rs:260
    pub fn inventory(self) -> ArtifactInventory Err! {
        paths := [String]{}
        discover_manifest_files(&self.root, &self.corpus_manifest, &paths)
        paths.sort()
        paths.dedup()
        errors := [String]{}
        files := [InventoryEntry]{}
        loop path in paths {
            row :: self.source_row(path) else {
                errors.push(inventory_error("unclassified eligible source", path, "inventory:source"))
                continue
            }
            producer :: self.corpus_manifest.artifacts.iter()
                .find(fn(artifact) -> artifact.selector == "path:{path}").map(fn(artifact) -> artifact.producer)
            if row.role == .GeneratedOutput && producer.is_none() {
                errors.push(inventory_error("generated source has no producer artifact provenance", path, "inventory:provenance"))
            }
            files.push(InventoryEntry{path: ^path, role: row.role, producer: ^producer})
        }
        loop artifact in self.corpus_manifest.artifacts {
            if path :: artifact.selector.strip_prefix("path:") {
                if !self.root.join(path).is_file() -> errors.push("manifest artifact is missing: {path}")
            }
        }
        loop artifact in self.corpus_manifest.artifacts {
            path := artifact.selector.strip_prefix("path:") else { continue }
            if OSPath.new(path).extension().and_then(fn(ext) -> ext.to_str()) != .Some("jet") -> continue
            if self.source_row(path) == {
                .Some(row) -> {
                    if row.role != .GeneratedOutput -> errors.push("generated artifact {path} is classified as {row.role:?}, not generated-output")
                }
                .None -> errors.push("generated artifact has no source classification: {path}")
            }
        }
        producers :: self.corpus_manifest.producers.iter().map(fn(producer) -> producer.selector).collect()
        artifacts :: self.corpus_manifest.artifacts.iter().map(fn(artifact) -> artifact.selector).collect()
        provenance :: self.corpus_manifest.artifacts.iter().filter_map(fn(artifact) ->
            self.corpus_manifest.producers.iter().find(fn(producer) -> producer.selector == artifact.producer)
                .map(fn(producer) -> ProvenanceEntry{producer: producer.selector, artifact: artifact.selector, protocol: producer.protocol})
        ).collect()
        if !errors.is_empty() -> fail errors.join("\n")
        ArtifactInventory{files: ^files, producers: ^producers, artifacts: ^artifacts, provenance: ^provenance}
    }
    // Rust: tests/support/corpus_policy.rs:367
    pub fn audit_inventory(self, files: [String], producers: [String]) -> Unit Err! {
        errors := [String]{}
        loop file in files {
            if self.source_row(file).is_none() -> errors.push(inventory_error("unclassified eligible source", file, "inventory:source"))
        }
        declared := [String: Bool]{}
        loop producer in self.corpus_manifest.producers -> declared[producer.selector] = true
        loop producer in producers {
            if !declared.contains_key(producer) -> errors.push(inventory_error("unclassified generated-source producer", producer, "inventory:producer"))
        }
        if !errors.is_empty() -> fail errors.join("\n")
    }
    // Rust: tests/support/corpus_policy.rs:403
    pub fn check_cli_recipe_inventory(self) -> Unit Err! {
        self.validate()
        self.check_fixture_inventory()
        inventory :: self.inventory()
        errors := [String]{}
        checked := [String: Bool]{}
        loop entry in inventory.files {
            row :: self.source_row(entry.path) else { continue }
            recipe :: cli_recipe_profile(row.profile) else { continue }
            path :: self.root.join(entry.path)
            if !is_jet_program(&path) && recipe != .TypedDoc -> continue
            source :: fs.read_to_string(&path).map_err(fn(error) -> "read {path.display()}: {error}")
            has_run_command :: has_jet_run_command(source)
            sources :: if OSPath.new(entry.path).extension().and_then(fn(ext) -> ext.to_str()) == .Some("md") {
                jet_fences(source)
            } else { [source] }
            programs := [Program]{}
            loop source in sources -> programs.push(parse_program(entry.path, source))
            valid :: if recipe == {
                .Typed -> !programs.is_empty() && programs.iter().all(has_typed_cli_entry)
                .TypedDoc -> programs.iter().any(has_typed_cli_entry) && has_run_command
                .Builder -> programs.iter().any(has_args_builder)
                .Raw -> programs.iter().any(has_raw_process_boundary)
            }
            if !valid -> errors.push("CLI recipe profile `{row.profile}` is not proved by the AST for {entry.path}")
            checked[entry.path] = true
        }
        if checked.is_empty() -> errors.push("manifest has no checked CLI recipe profiles")
        if !errors.is_empty() -> fail errors.join("\n")
    }
    // Rust: tests/support/corpus_policy.rs:468
    pub fn check_fixture_inventory(self) -> Unit Err! {
        self.validate()
        inventory :: self.inventory()
        errors := [String]{}
        loop entry in inventory.files {
            expected :: fixture_role_for_path(entry.path) else { continue }
            if entry.role != expected {
                errors.push(SemanticViolation.new(entry.path, "fixture-role-classification", site("inventory:fixture-role", Span.new(0, 0))).to_string())
            }
        }
        loop row in self.corpus_manifest.sources {
            expected :: profile_fixture_role(row.profile) else { continue }
            compatible :: if expected == {
                .One(role) -> row.role == role
                .Generated -> row.role == .RawProtocol || row.role == .GeneratedOutput
            }
            if !compatible {
                errors.push(SemanticViolation.new(selector_path(row.selector), "fixture-cli-role", site("manifest:fixture-profile", Span.new(0, 0))).to_string())
            }
        }
        if !errors.is_empty() -> fail errors.join("\n")
    }
    // Rust: tests/support/corpus_policy.rs:525
    pub fn check_gate(self, gate: String) -> Unit Err! {
        self.validate()
        self.check_cli_recipe_inventory()
        inventory :: self.inventory()
        violations := [SemanticViolation]{}
        loop entry in inventory.files {
            row :: self.source_row(entry.path) else { continue }
            if row.role == .GeneratedOutput || !proof_matches(row.proof, gate) || !semantic_role(row.role) -> continue
            path :: self.root.join(entry.path)
            if path.file_name().and_then(fn(name) -> name.to_str()) == .Some("package.jet") -> continue
            source :: fs.read_to_string(&path).map_err(fn(error) -> "read {path.display()}: {error}")
            violations.extend(self.evaluate_source(entry.path, source))
        }
        if gate == "all" || gate == "bindgen" {
            loop artifact in self.corpus_manifest.artifacts {
                path := artifact.selector.strip_prefix("path:") else { continue }
                producer :: self.corpus_manifest.producers.iter().find(fn(producer) -> producer.selector == artifact.producer) else { continue }
                if is_no_response_protocol(producer.protocol) || OSPath.new(path).extension().and_then(fn(ext) -> ext.to_str()) != .Some("jet") -> continue
                source :: fs.read_to_string(self.root.join(path)).map_err(fn(error) -> "read generated artifact {path}: {error}")
                violations.extend(self.evaluate_generated(producer.selector, source))
            }
        }
        if !violations.is_empty() -> fail violations.iter().map(fn(v) -> v.to_string()).collect<[String]>().join("\n")
    }
    // Rust: tests/support/corpus_policy.rs:582
    pub fn evaluate_source(self, path: String, source: String) -> [SemanticViolation] Err! {
        row :: self.source_row(path) else { fail inventory_error("unclassified eligible source", path, "inventory:source") }
        if !semantic_role(row.role) -> return []
        programs :: if OSPath.new(path).extension().and_then(fn(ext) -> ext.to_str()) == .Some("md") {
            jet_fences(source)
        } else { [source] }
        all := [SemanticViolation]{}
        loop program_source in programs {
            program :: parse_program(path, program_source)
            self.validate_maintained_lint_allows(path, row, &program)
            all.extend(evaluate_program(&self.corpus_manifest, path, row, &program))
        }
        if applies(&self.corpus_manifest, path, row, "first-hour-doc-recipe") && path == "Docs/spec/guides/first-hour.md" {
            typed :: jet_fences(source).iter().any(fn(fence) ->
                parse_program(path, fence).map(fn(program) -> has_typed_cli_entry(&program)).unwrap_or(false)
            )
            if !typed || !has_jet_run_command(source) {
                kind :: if typed { "document:jet-run" } else { "document:typed-cli" }
                all.push(SemanticViolation.new(path, "first-hour-doc-recipe", site(kind, Span.new(0, 0))))
            }
        }
        self.apply_exceptions(path, ^all)
    }
    // Rust: tests/support/corpus_policy.rs:636
    fn validate_maintained_lint_allows(self, path: String, row: &SourceRow, program: &Program) -> Unit Err! {
        if row.role != .CanonicalTeaching && row.role != .ExpertLesson -> return
        occurrences := [(String, String): USize]{}
        loop application in program.rule_facts {
            if application.marker.name != MARKER_ALLOW -> continue
            target :: application.target else { continue }
            loop argument in application.marker.expr_args() {
                if argument == {
                    .Ident(rule, _) -> {
                        if !maintained_guidance_lint(rule) -> continue
                        location :: "allow:{rule}@{target.start}..{target.end}"
                        key :: (rule, location)
                        occurrences[key] = occurrences.get(key).copied().unwrap_or(0) + 1
                    }
                    _ -> {}
                }
            }
        }
        keys := occurrences.keys().collect<[(String, String)]>()
        keys.sort()
        loop (rule, location) in keys {
            count :: occurrences[(rule, location)]
            matches :: self.corpus_manifest.exceptions.iter().filter(fn(exception) ->
                exception.rule == rule && exception.selector == "file:{path}" && exception.site == location
            ).collect<[&ExceptionRow]>()
            if matches.len() != 1 {
                fail "file={path}; rule={rule}; site={location}; why=maintained #allow needs one occurrence-scoped manifest reason; replacement=add one exact [exception] row"
            }
            if matches[0].expected != count {
                fail "file={path}; rule={rule}; site={location}; why=manifest expects {matches[0].expected} occurrence(s), found {count}; replacement=keep one reviewed #allow occurrence per manifest row"
            }
        }
        loop exception in self.corpus_manifest.exceptions.iter().filter(fn(exception) ->
            exception.selector == "file:{path}" && exception.site.starts_with("allow:")
        ) {
            count :: occurrences.get((exception.rule, exception.site)).copied().unwrap_or(0)
            if count != exception.expected {
                fail "file={path}; rule={exception.rule}; site={exception.site}; why=manifest expects {exception.expected} occurrence(s), found {count}; replacement=remove the stale allowance or update its exact reviewed site"
            }
        }
    }
    // Rust: tests/support/corpus_policy.rs:709
    pub fn evaluate_generated(self, producer: String, source: String) -> [SemanticViolation] Err! {
        row :: self.corpus_manifest.producers.iter().find(fn(row) -> row.selector == producer) else {
            fail inventory_error("unclassified generated-source producer", producer, "inventory:producer")
        }
        program :: parse_program(producer, source)
        decoders := [&Func]{}
        loop item in program.items {
            if item == {
                .Func(function) -> { if is_response_decoder(function) -> decoders.push(function) }
                _ -> {}
            }
        }
        if is_no_response_protocol(row.protocol) -> return []
        violations := [SemanticViolation]{}
        if decoders.is_empty() {
            violations.push(SemanticViolation.new(producer, "bindgen-one-decoder", "producer:{producer}#decode_response@0..0"))
        } else {
            loop function in decoders.iter().skip(1) {
                violations.push(SemanticViolation.new(producer, "bindgen-one-decoder", "producer:{producer}#response-decoder@{function.span.start}..{function.span.end}"))
            }
        }
        if decoders.len() == 1 && protocol_override_identity(row.protocol).is_some() && ordinary_envelope_decoder(decoders[0]) {
            identity :: protocol_override_identity(row.protocol).unwrap_or("unknown")
            violations.push(SemanticViolation.new(producer, "generated-protocol-override", "producer:{producer}#protocol:{identity}@{decoders[0].span.start}..{decoders[0].span.end}"))
        }
        violations
    }
    // Rust: tests/support/corpus_policy.rs:780
    pub fn validate_occurrences(self, selector: String, candidates: [SemanticViolation]) -> Unit Err! {
        counts := [(String, String): USize]{}
        loop candidate in candidates {
            if candidate.file != selector -> fail "candidate file {candidate.file} does not match {selector}"
            key :: (candidate.rule, candidate.site)
            counts[key] = counts.get(key).copied().unwrap_or(0) + 1
        }
        keys := counts.keys().collect<[(String, String)]>()
        keys.sort()
