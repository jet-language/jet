        "typed-cli-doc" -> .Some(.TypedDoc)
        "builder-cli" -> .Some(.Builder)
        "raw-cli" -> .Some(.Raw)
        _ -> .None
    }
}
// Rust: tests/support/corpus_policy.rs:1511
fn has_typed_cli_entry(program: &Program) -> Bool { jet_foundation.CLISchema.entry_schema(program.items).is_some() }
// Rust: tests/support/corpus_policy.rs:1515
fn has_args_builder(program: &Program) -> Bool {
    aliases :: module_aliases(program)
    expressions :: program_expressions(program)
    has_spec :: expressions.iter().any(fn(expr) ->
        if expr.without_parens() == {
            .MethodCall{receiver, method, ..} -> method == "spec" && receiver_is(receiver, "args", &aliases)
            _ -> false
        }
    )
    has_parse :: expressions.iter().any(fn(expr) ->
        if expr.without_parens() == {
            .MethodCall{method, ..} -> method == "parse" || method == "parse_or_exit"
            _ -> false
        }
    )
