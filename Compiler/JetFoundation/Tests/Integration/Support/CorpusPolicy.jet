}
// Rust: tests/support/corpus_policy.rs:928
fn ordinary_envelope_decoder(function: &Func) -> Bool {
    has_status_field := false
    for_each_statement_expr(function.body, fn(expr) {
        if expr.without_parens() == {
            .MethodCall{method, args, ..} -> {
                if method == "field" && args.first().is_some_and(fn(arg) -> is_literal_string(&arg.expr, "ok")) -> has_status_field = true
            }
            _ -> {}
        }
    })
    has_status_field
}

impl CorpusManifest {
    // Rust: tests/support/corpus_policy.rs:945
    pub fn parse(text: String) -> CorpusManifest Err! {
        manifest := CorpusManifest{}
        section := ""
        loop (line_number, raw) in text.lines().enumerate() {
            line := raw.trim_end_matches('\r') // #4303
            if line.is_empty() || line.starts_with('#') -> continue
            if line.starts_with('[') && line.ends_with(']') {
                section = line[1..<line.len() - 1].to_string()
                if !["source", "scope", "producer", "artifact", "finding", "exception"].contains(section) {
                    fail "manifest line {line_number + 1}: unknown section [{section}]"
                }
                continue
            }
            fields :: line.split('\t').collect<[String]>()
            error :: fn(message: String) -> "manifest line {line_number + 1}: {message}"
            if section == {
                "source" if fields.len() == 8 -> manifest.sources.push(SourceRow{
                    selector: parse_selector(fields[1]).map_err(fn(message) -> error(message)),
                    role: SourceRole.parse(fields[2]).map_err(fn(message) -> error(message)),
                    profile: nonempty(fields[3], error("source profile is empty")),
                    decision: nonempty(fields[4], error("source decision is empty")),
                    proof: nonempty(fields[5], error("source proof is empty")),
                    owner: nonempty(fields[6], error("source owner is empty")),
                    reason: nonempty(fields[7], error("source reason is empty"))
                })
                "scope" if fields.len() == 4 -> manifest.scopes.push(RuleScopeRow{
                    rule: nonempty(fields[1], error("scope rule is empty")),
                    selector: parse_selector(fields[2]).map_err(fn(message) -> error(message)),
                    reason: nonempty(fields[3], error("scope reason is empty"))
                })
                "producer" if fields.len() == 6 -> manifest.producers.push(ProducerRow{
                    selector: parse_producer(fields[1]).map_err(fn(message) -> error(message)),
                    artifact: parse_artifact(fields[2]).map_err(fn(message) -> error(message)),
                    protocol: nonempty(fields[3], error("producer protocol is empty")),
                    owner: nonempty(fields[4], error("producer owner is empty")),
                    reason: nonempty(fields[5], error("producer reason is empty"))
                })
                "artifact" if fields.len() == 5 -> manifest.artifacts.push(ArtifactRow{
                    selector: parse_artifact(fields[1]).map_err(fn(message) -> error(message)),
                    producer: parse_producer(fields[2]).map_err(fn(message) -> error(message)),
                    kind: nonempty(fields[3], error("artifact kind is empty")),
                    reason: nonempty(fields[4], error("artifact reason is empty"))
                })
                "finding" if fields.len() == 5 -> manifest.findings.push(FindingRow{
                    id: nonempty(fields[1], error("finding id is empty")),
                    rule: nonempty(fields[2], error("finding rule is empty")),
                    owner: nonempty(fields[3], error("finding owner is empty")),
                    proof: nonempty(fields[4], error("finding proof is empty"))
                })
                "exception" if fields.len() == 7 -> manifest.exceptions.push(ExceptionRow{
                    rule: nonempty(fields[1], error("exception rule is empty")),
                    selector: parse_selector(fields[2]).map_err(fn(message) -> error(message)),
                    site: parse_site(fields[3]).map_err(fn(message) -> error(message)),
                    expected: fields[4].parse<USize>().map_err(fn(_) -> error("exception occurrence is not a positive integer")),
                    protocol: nonempty(fields[5], error("exception protocol is empty")),
                    reason: nonempty(fields[6], error("exception reason is empty"))
                })
                _ -> fail error("wrong field count or row outside a section")
            }
            if fields.first() != .Some("1") -> fail error("unsupported manifest version")
        }
        manifest
    }
    // Rust: tests/support/corpus_policy.rs:1022
    pub fn validate(self) -> Unit Err! {
        errors := [String]{}
        unique_selectors(self.sources.iter().map(fn(row) -> row.selector).collect(), "source", &errors)
        scope_keys := [(String, String): Bool]{}
        loop scope in self.scopes {
            key :: (scope.rule, scope.selector)
            if scope_keys.contains_key(key) -> errors.push("duplicate scope {scope.rule} {scope.selector}")
            scope_keys[key] = true
        }
        unique_selectors(self.producers.iter().map(fn(row) -> row.selector).collect(), "producer", &errors)
        unique_selectors(self.artifacts.iter().map(fn(row) -> row.selector).collect(), "artifact", &errors)
        unique_selectors(self.findings.iter().map(fn(row) -> row.id).collect(), "finding", &errors)
        rule_names := [String: Bool]{}
        loop spec in rule_registry() -> rule_names[spec.name] = true
        producer_names := [String: Bool]{}
        loop row in self.producers -> producer_names[row.selector] = true
        loop finding in self.findings {
            if !rule_names.contains_key(finding.rule) -> errors.push("finding {finding.id} names unknown rule {finding.rule}")
            if finding.owner.is_empty() || finding.proof.is_empty() -> errors.push("finding {finding.id} has no owner or executable proof")
            if !self.scopes.iter().any(fn(scope) -> scope.rule == finding.rule) && !domain_guard_rule(finding.rule) {
                errors.push("finding {finding.id} rule {finding.rule} has no executable corpus or domain guard")
            }
        }
        if self.findings.len() != 38 -> errors.push("manifest must retain all 38 audited findings, found {self.findings.len()}")
        loop scope in self.scopes {
            if !rule_names.contains_key(scope.rule) -> errors.push("scope names unknown rule {scope.rule}")
            path := selector_path(scope.selector)
            if !self.sources.iter().any(fn(source) -> selector_matches(source.selector, path)) {
                errors.push("scope {scope.rule} names an unclassified source selector {scope.selector}")
            }
            if scope.reason.is_empty() -> errors.push("scope {scope.rule} {scope.selector} has no reason")
        }
        loop producer in self.producers {
            if validate_protocol(producer.protocol) == {
                .Err(error) -> {
                    violation :: SemanticViolation.new(producer_path(producer.selector), "generated-protocol-override", site("manifest:generated-protocol", Span.new(0, 0)))
                    errors.push("{violation} ({error})")
                }
                .Ok(_) -> {}
            }
            if !self.artifacts.iter().any(fn(artifact) -> artifact.selector == producer.artifact && artifact.producer == producer.selector) {
                errors.push("producer {producer.selector} family has no artifact row")
            }
        }
        loop artifact in self.artifacts {
            if !producer_names.contains_key(artifact.producer) -> errors.push("artifact {artifact.selector} names unknown producer {artifact.producer}")
        }
        exception_keys := [(String, String, String): Bool]{}
        loop exception in self.exceptions {
            if !rule_names.contains_key(exception.rule) -> errors.push("exception names unknown rule {exception.rule}")
            key :: (exception.rule, exception.selector, exception.site)
            if exception_keys.contains_key(key) -> errors.push("duplicate occurrence exception {exception.rule} {exception.selector} {exception.site}")
            exception_keys[key] = true
            if exception.expected == 0 -> errors.push("exception {exception.rule} {exception.site} has zero expected occurrences")
            if !exception.selector.starts_with("file:") {
                errors.push("exception {exception.rule} {exception.site} is not occurrence-scoped to one file")
            } else {
                path := selector_path(exception.selector)
                source :: self.sources.iter().filter(fn(source) -> selector_matches(source.selector, path))
                    .max_by_key(fn(source) -> selector_specificity(source.selector))
                if source == {
                    .None -> errors.push("exception {exception.rule} names an unclassified source {exception.selector}")
                    .Some(source) -> {
                        if !exception.site.starts_with("allow:") && source.role != .ExpertLesson && source.role != .NegativeDiagnostic {
                            errors.push("exception {exception.rule} {exception.selector} requires an expert-lesson or negative-diagnostic source, found {source.role:?}")
                        }
                    }
                }
            }
            if exception.protocol.is_empty() || exception.reason.is_empty() {
                errors.push("exception {exception.rule} {exception.site} has no protocol or reason")
            } else {
                if validate_exception_protocol(exception.protocol) == {
                    .Err(error) -> errors.push("exception {exception.rule} {exception.site}: {error}")
                    .Ok(_) -> {}
                }
            }
        }
        if !errors.is_empty() -> fail errors.join("\n")
    }
}
// Rust: tests/support/corpus_policy.rs:1223
fn validate_manifest_paths(manifest: &CorpusManifest, root: &OSPath) -> Unit Err! {
    errors := [String]{}
    loop source in manifest.sources {
        path := selector_path(source.selector)
        exists :: if source.selector.strip_prefix("root:").is_some() { root.join(path).is_dir() } else { root.join(path).is_file() }
        if !exists -> errors.push("manifest source selector does not exist: {source.selector}")
    }
    loop producer in manifest.producers {
        path := producer_path(producer.selector)
        if !root.join(path).is_file() -> errors.push("manifest producer source does not exist: {producer.selector}")
    }
    loop exception in manifest.exceptions {
        path := exception.selector.strip_prefix("file:") else { continue }
        if !root.join(path).is_file() -> errors.push("manifest exception source does not exist: {exception.selector}")
    }
    if !errors.is_empty() -> fail errors.join("\n")
}
// Rust: tests/support/corpus_policy.rs:1265
fn selector_path(selector: String) -> String {
    selector.strip_prefix("root:").or_else(fn() -> selector.strip_prefix("file:")).unwrap_or(selector)
}
// Rust: tests/support/corpus_policy.rs:1272
fn producer_path(selector: String) -> String {
    selector.strip_prefix("producer:").and_then(fn(body) -> body.split_once('#').map(fn(pair) -> pair.0)).unwrap_or(selector)
}
// Rust: tests/support/corpus_policy.rs:1279
fn parse_selector(value: String) -> String Err! {
    path := value.strip_prefix("root:").or_else(fn() -> value.strip_prefix("file:")) else {
        fail "selector must start with root: or file: ({value})"
    }
    validate_relative_path(path)
    value
}
// Rust: tests/support/corpus_policy.rs:1288
fn parse_producer(value: String) -> String Err! {
    body := value.strip_prefix("producer:") else { fail "producer selector must start with producer: ({value})" }
    (path, symbol) := body.split_once('#') else { fail "producer selector must name a symbol ({value})" }
    validate_relative_path(path)
    if symbol.is_empty() || symbol.contains('#') -> fail "producer selector must name one non-empty symbol ({value})"
    value
}
// Rust: tests/support/corpus_policy.rs:1304
fn parse_artifact(value: String) -> String Err! {
    if path := value.strip_prefix("path:") { validate_relative_path(path) }
    else if family := value.strip_prefix("family:") {
        if family.is_empty() || family.contains('/') -> fail "artifact family is not a stable identifier ({value})"
    } else { fail "artifact selector must start with path: or family: ({value})" }
    value
}
// Rust: tests/support/corpus_policy.rs:1321
fn parse_site(value: String) -> String Err! {
    (kind, span) := value.rsplit_once('@') else { fail "semantic site must carry a span ({value})" }
    if kind.is_empty() || kind.contains('@') -> fail "semantic site kind is empty or malformed ({value})"
    (start_text, end_text) := span.split_once("..") else { fail "semantic site span must use start..end ({value})" }
    start :: start_text.parse<USize>().map_err(fn(_) -> "bad site start ({value})")
    end :: end_text.parse<USize>().map_err(fn(_) -> "bad site end ({value})")
    if end < start -> fail "site end precedes start ({value})"
    value
}
// Rust: tests/support/corpus_policy.rs:1345
fn validate_relative_path(path: String) -> Unit Err! {
    if path.is_empty() || OSPath.new(path).is_absolute() || path.split('/').any(fn(part) -> part == ".." || part.is_empty()) {
        fail "manifest path is not a normalized relative path ({path})"
    }
}
// Rust: tests/support/corpus_policy.rs:1357
fn nonempty(value: String, error: String) -> String Err! {
    if value.is_empty() -> fail error
    value
}
// Rust: tests/support/corpus_policy.rs:1365
fn unique_selectors(values: [String], kind: String, errors: &[String]) -> Unit {
    seen := [String: Bool]{}
    loop value in values {
        if seen.contains_key(value) -> errors.push("duplicate {kind} selector {value}")
        seen[value] = true
    }
}
// Rust: tests/support/corpus_policy.rs:1374
pub fn selector_matches(selector: String, path: String) -> Bool {
    if file := selector.strip_prefix("file:") -> return file == path
    root := selector.strip_prefix("root:") else { return false }
    path == root || path.strip_prefix(root).is_some_and(fn(rest) -> rest.starts_with('/'))
}
// Rust: tests/support/corpus_policy.rs:1387
fn selector_specificity(selector: String) -> USize {
    selector.strip_prefix("file:").map_or(0, fn(file) -> 100_000 + file.len())
        + selector.strip_prefix("root:").map_or(0, fn(root) -> root.len())
}
// Rust: tests/support/corpus_policy.rs:1394
fn is_no_response_protocol(protocol: String) -> Bool { protocol == "no-response-protocol" }
// Rust: tests/support/corpus_policy.rs:1398
fn validate_protocol(protocol: String) -> Unit Err! {
    if protocol == "ordinary-envelope" || is_no_response_protocol(protocol) -> return
    override_body := protocol.strip_prefix("override:") else {
        fail "generated protocol must be ordinary-envelope, no-response-protocol, or an override ({protocol})"
    }
    (identity, proof) := override_body.split_once(':') else {
        fail "generated protocol override must name identity and proof ({protocol})"
    }
    if identity.is_empty() || proof != "differs-from-ordinary-envelope" || identity == "ordinary-envelope" {
        fail "generated protocol override must prove a distinct protocol identity ({protocol})"
    }
}
// Rust: tests/support/corpus_policy.rs:1423
fn validate_exception_protocol(protocol: String) -> Unit Err! {
    if ["fixture", "expert-lesson", "negative-diagnostic", "canonical-teaching", "raw-protocol", "fixture-harness-boundary"].contains(protocol) -> return
    if protocol.starts_with("override:") -> return validate_protocol(protocol)
    fail "exception protocol must name its source boundary or a generated override ({protocol})"
}
// Rust: tests/support/corpus_policy.rs:1443
fn domain_guard_rule(rule: String) -> Bool {
    ["product-parser-regression", "compiler-loop-fact", "build-root-fact", "fixture-role-classification", "fixture-cli-role", "bindgen-one-decoder"].contains(rule)
}
// Rust: tests/support/corpus_policy.rs:1455
pub fn semantic_role(role: SourceRole) -> Bool {
    role == .CanonicalTeaching || role == .ExpertLesson || role == .GeneratedOutput
}
// Rust: tests/support/corpus_policy.rs:1462
fn fixture_role_for_path(path: String) -> SourceRole? {
    if path.starts_with("tests/ui/") || path.starts_with("tests/ui_lint/") { .Some(.NegativeDiagnostic) }
    else if path.starts_with("tests/fuzz/") || path.starts_with("tests/conformance/corpus/") || path.starts_with("Tools/adoption/fixtures/") {
        .Some(.FixtureHarnessBoundary)
    } else { .None }
}
// Rust: tests/support/corpus_policy.rs:1476
enum ProfileFixtureRole { One(SourceRole), Generated }
// Rust: tests/support/corpus_policy.rs:1481
fn profile_fixture_role(profile: String) -> ProfileFixtureRole? {
    if profile == {
        "negative" -> .Some(.One(.NegativeDiagnostic))
        "fixture" | "canonical-test" | "package-template" -> .Some(.One(.FixtureHarnessBoundary))
        "protocol" -> .Some(.One(.RawProtocol))
        "generated" -> .Some(.Generated)
        _ -> .None
    }
}
