// Rust: tests/support/corpus_policy.rs:23
pub enum SourceRole {
    CanonicalTeaching, ExpertLesson, NegativeDiagnostic, RawProtocol,
    FixtureHarnessBoundary, GeneratedOutput, NonTeachingTestData

    // Rust: tests/support/corpus_policy.rs:34
    fn parse(value: String) -> SourceRole Err! {
        if value == {
            "canonical-teaching" -> .CanonicalTeaching
            "expert-lesson" -> .ExpertLesson
            "negative-diagnostic" -> .NegativeDiagnostic
            "raw-protocol" -> .RawProtocol
            "fixture-harness-boundary" -> .FixtureHarnessBoundary
            "generated-output" -> .GeneratedOutput
            "non-teaching-test-data" -> .NonTeachingTestData
            _ -> fail "unknown corpus source role `{value}`"
        }
    }
}
