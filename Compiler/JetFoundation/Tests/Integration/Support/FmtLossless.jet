//RS #[test]
//RS fn canonical_rewrite_rules_are_explicit_and_narrow() {
//RS     let allowed = [
//RS         (
//RS             "top-level ordering",
//RS             "#Target(Web)\nuse core.ui as ui\nfn run() {}\n",
//RS             "use core.ui as ui\n#Target(Web)\nfn run() {}\n",
//RS         ),
//RS         (
//RS             "import-hoisted top-level comments",
//RS             "// helper\nfn helper() {}\n// import\nuse core.ui as ui\n",
//RS             "// helper\n// import\nuse core.ui as ui\nfn helper() {}\n",
//RS         ),
//RS         (
//RS             "spanless marker comment position",
//RS             "// web target\n#Target(Web)\nfn run() {}\n",
//RS             "#Target(Web)\n// web target\nfn run() {}\n",
//RS         ),
//RS         (
//RS             "marker grouping",
//RS             "#Codable\n#RenameAll(camel)\nstruct S {}\n",
//RS             "#[Codable, RenameAll(camel)]\nstruct S {}\n",
//RS         ),
//RS         (
//RS             "static generic call",
//RS             "fn run() { Pool<Node>.new() }\n",
//RS             "fn run() { Pool.new<Node>() }\n",
//RS         ),
//RS         (
//RS             "external method",
//RS             "fn Point.len(self) Int -> 1\n",
//RS             "impl Point { fn len(self) -> Int -> 1 }\n",
//RS         ),
//RS         (
//RS             "enum group separators",
//RS             "enum E { G { A, B } }\n",
//RS             "enum E { G { A B } }\n",
//RS         ),
//RS         (
//RS             "struct declaration separators",
//RS             "struct S { x: Int, y: Int }\n",
//RS             "struct S { x: Int y: Int }\n",
//RS         ),
//RS         (
//RS             "trailing comma",
//RS             "fn run() { xs :: [1,] }\n",
//RS             "fn run() { xs :: [1] }\n",
//RS         ),
//RS         (
//RS             "default file alias",
//RS             "use \"./foo\" as foo\nfn run() {}\n",
//RS             "use \"./foo\"\nfn run() {}\n",
//RS         ),
//RS         (
//RS             "typed-literal dot removal",
//RS             "fn run() { p :: Point.{x: 1} }\n",
//RS             "fn run() { p :: Point{x: 1} }\n",
//RS         ),
//RS         (
//RS             "arrow unification",
//RS             "fn run() { if x == { .A => print(1) } }\n",
//RS             "fn run() { if x == { .A -> print(1) } }\n",
//RS         ),
//RS         (
//RS             "retired result arrow on braced function",
//RS             "fn parse_age() => Int { return 42 }\n",
//RS             "fn parse_age() -> Int { return 42 }\n",
//RS         ),
//RS         (
//RS             "dispatch arm block",
//RS             "fn run() { if x == { .A -> print(1) } }\n",
//RS             "fn run() { if x == { .A -> { print(1) } } }\n",
//RS         ),
//RS         (
