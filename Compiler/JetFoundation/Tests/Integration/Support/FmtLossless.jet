// Rust: tests/support/fmt_lossless.rs:722
fn declaration_field_commas(tokens: &[Token]) -> [Bool] {
    ignored := [false; tokens.len()]
    awaiting_struct_body := false
    struct_depth := None as Int?
    brace_depth := 0
    paren_depth := 0
    bracket_depth := 0
    loop (index, token) in tokens.iter().enumerate() {
        if token.kind == {
