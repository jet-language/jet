        .Val(token) -> {
            if token.kind == .Str(parts) {
                if plain_string_value(&parts) == .Val(path) {
                    return tokens[index + 1].kind == { .Ident(alias) -> path.rsplit('/').next().is_some_and((default) -> default == alias) else -> false }
