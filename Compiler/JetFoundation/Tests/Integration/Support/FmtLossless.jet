// Rust: tests/support/fmt_lossless.rs:783
fn plain_string_value(parts: &[StrTokPart]) -> String? {
    value := ""
    loop part in parts {
        if part == {
            .Lit(text) -> &value.push_str(text)
            // D-BYTELIT1=B: raw byte literals are not plain text.
            .Byte(_) | .Interp(_) -> return None
        }
    }
    Val(value)
}

// Rust: tests/support/fmt_lossless.rs:797
fn token_kinds_equal(left: &TokKind, right: &TokKind) -> Bool {
    if left == .Str(left_parts) {
        if right == .Str(right_parts) -> return string_parts_equal(&left_parts, &right_parts)
    }
    // Typed binary patterns also use ordinary string parts.
    left == right
}

// Rust: tests/support/fmt_lossless.rs:806
fn string_parts_equal(left: &[StrTokPart], right: &[StrTokPart]) -> Bool {
    if left.len() != right.len() -> return false
    loop (left, right) in left.iter().zip(right) {
        equal :: if (left, right) == {
            (.Lit(left), .Lit(right)) -> left == right
            (.Interp(left), .Interp(right)) -> {
                left_tokens :: left.iter().filter((token) -> !(token.kind == { .Semi | .Eof -> true else -> false })).cloned().collect()
                right_tokens :: right.iter().filter((token) -> !(token.kind == { .Semi | .Eof -> true else -> false })).cloned().collect()
                ordered_token_diff(&OSPath.new("<string interpolation>"), &left_tokens, &right_tokens).is_ok()
            }
            else -> false
        }
        if !equal -> return false
    }
    true
}

// Rust: tests/support/fmt_lossless.rs:835
fn assert_fmt_preserves_token_stream(path: &OSPath, src: String, formatted: String) {
    original_tokens :: canonical_tokens(src, path)
    formatted_tokens :: canonical_tokens(formatted, path)
    if ordered_token_diff(path, &original_tokens, &formatted_tokens) == .Err(diff) -> panic(diff)
    twice :: format_supported_source(path, formatted).unwrap_or_else((diagnostics) -> panic("second fmt failed on {path.display()}:\n{render_diagnostics(path.display().to_string(), formatted, &diagnostics)}"))
    assert_eq(formatted, twice, "fmt is not byte-stable on {path.display()}")
}

// Rust: tests/support/fmt_lossless.rs:856
fn format_supported_source(path: &OSPath, src: String) -> String [Diagnostic]! {
    if format_source(src) == {
        .Ok(formatted) -> return formatted
        .Err(diagnostics) -> {
            if Package.format_source(src, path.display().to_string()) == {
                .Ok(formatted) -> return formatted
                .Err(_) -> fail diagnostics
            }
        }
    }
}

// Rust: tests/support/fmt_lossless.rs:868
fn ordered_token_diff(path: &OSPath, original: &[Token], formatted: &[Token]) -> Err! {
    original_i := 0
    formatted_i := 0
    inserted_arm_braces := 0
    inserted_lambda_parens := 0
    loop original_i < original.len() || formatted_i < formatted.len() {
        if original_i < original.len() && formatted_i < formatted.len() && token_kinds_equal(&original[original_i].kind, &formatted[formatted_i].kind) {
            original_i += 1
            formatted_i += 1
            next
        }
        if reordered_simple_union_type(original, original_i, formatted, formatted_i) == .Val(indices) {
            original_i = indices.original
            formatted_i = indices.formatted
            next
        }
        if retired_result_arrow_removal(original, original_i, formatted, formatted_i) {
            original_i += 1
            next
        }
        if canonical_arrow_rewrite(original, original_i, formatted, formatted_i) == .Val(indices) {
            original_i = indices.original
            formatted_i = indices.formatted
            next
        }
        if typed_literal_dot_rewrite(original, original_i, formatted, formatted_i) {
            original_i += 1
            next
        }
        if formatted_arm_block_opens(formatted, formatted_i) && !original.get(original_i).is_some_and((t) -> t.kind == .LBrace) {
            inserted_arm_braces += 1
            formatted_i += 1
            next
        }
        if formatted_lambda_params_open(formatted, formatted_i) && !original.get(original_i).is_some_and((t) -> t.kind == .LParen) {
            inserted_lambda_parens += 1
            formatted_i += 1
            next
        }
        if formatted_variant_pattern_dot(original, original_i, formatted, formatted_i) {
            formatted_i += 1
            next
        }
        if inserted_lambda_parens > 0 && formatted.get(formatted_i).is_some_and((t) -> t.kind == .RParen) && formatted.get(formatted_i + 1).is_some_and((t) -> t.kind == { .UnifiedArrow | .LambdaArrow -> true else -> false }) && original.get(original_i).is_some_and((t) -> t.kind == { .UnifiedArrow | .LambdaArrow -> true else -> false }) {
            inserted_lambda_parens -= 1
            formatted_i += 1
            next
        }
        if inserted_arm_braces > 0 && formatted.get(formatted_i).is_some_and((t) -> t.kind == .RBrace) && (next_token_matches(original, original_i, formatted, formatted_i + 1) || formatted_variant_pattern_dot(original, original_i, formatted, formatted_i + 1)) {
            inserted_arm_braces -= 1
            formatted_i += 1
            next
        }
        if formatted_struct_shorthand_expansion(formatted, formatted_i) {
            formatted_i += 2
            next
        }
        if formatted_default_module_alias(formatted, formatted_i) {
            formatted_i += 2
            next
        }
        if formatted_struct_separator(formatted, formatted_i) {
            formatted_i += 1
            next
        }
        before :: original.get(original_i).map((token) -> &token.kind)
        after :: formatted.get(formatted_i).map((token) -> &token.kind)
        fail "fmt changed ordered token {original_i} on {path.display()}:\n  before: {before:?}\n  after: {after:?}"
    }
    if inserted_arm_braces != 0 -> fail "fmt left an unmatched canonical arm block on {path.display()}"
    if inserted_lambda_parens != 0 -> fail "fmt left unmatched canonical lambda parens on {path.display()}"
}

// Rust: tests/support/fmt_lossless.rs:997
fn retired_result_arrow_removal(original: &[Token], original_i: Int, formatted: &[Token], formatted_i: Int) -> Bool {
    if !original.get(original_i).is_some_and((token) -> token.kind == .LambdaArrow) || !original.get(original_i.checked_sub(1).unwrap_or_default()).is_some_and((token) -> token.kind == .RParen) -> return false
    next_original :: original.get(original_i + 1) ?? return false
    next_formatted :: formatted.get(formatted_i) ?? return false
    if !token_kinds_equal(&next_original.kind, &next_formatted.kind) || !function_signature_before(original, original_i) -> return false
    original[original_i + 1..].iter().take_while((token) -> !(token.kind == { .Semi | .Eof -> true else -> false })).any((token) -> token.kind == .LBrace)
}

// Rust: tests/support/fmt_lossless.rs:1031
fn function_signature_before(tokens: &[Token], arrow: Int) -> Bool {
    braces := 0
    loop token in tokens[..arrow].iter().rev() {
        if token.kind == {
            .RBrace -> braces += 1
            .LBrace -> {
                if braces > 0 -> braces -= 1 else -> return false
            }
            .KwFn -> { if braces == 0 -> return true }
            .Semi -> { if braces == 0 -> return false }
            else -> {}
        }
    }
    false
}

// Rust: tests/support/fmt_lossless.rs:1046
fn reordered_simple_union_type(original: &[Token], original_i: Int, formatted: &[Token], formatted_i: Int) -> (original: Int, formatted: Int)? {
    if !simple_union_type_annotation(original, original_i) || !simple_union_type_annotation(formatted, formatted_i) -> return None
    original_members := simple_union_members(original, original_i) ?? return None
    formatted_members := simple_union_members(formatted, formatted_i) ?? return None
    &original_members.members.sort()
    &formatted_members.members.sort()
    if original_members.members == formatted_members.members -> Val((original: original_members.next, formatted: formatted_members.next)) else -> None
}

// Rust: tests/support/fmt_lossless.rs:1064
fn canonical_arrow_rewrite(original: &[Token], original_i: Int, formatted: &[Token], formatted_i: Int) -> (original: Int, formatted: Int)? {
    if original.get(original_i).is_some_and((token) -> token.kind == .LambdaArrow) && formatted.get(formatted_i).is_some_and((token) -> token.kind == .UnifiedArrow) -> return Val((original: original_i + 1, formatted: formatted_i + 1))
    if !original.get(original_i).is_some_and((token) -> token.kind == .Eq) || !formatted.get(formatted_i).is_some_and((token) -> token.kind == .Colon) -> return None
    if !original.get(original_i + 1).is_some_and((token) -> token.kind == .LBracket) || !formatted.get(formatted_i + 1).is_some_and((token) -> token.kind == .LBracket) -> return None
    original_close :: matching_bracket_end(original, original_i + 1) ?? return None
    formatted_close :: matching_bracket_end(formatted, formatted_i + 1) ?? return None
    if original_close - original_i != formatted_close - formatted_i || !original[original_i + 2..original_close].iter().zip(&formatted[formatted_i + 2..formatted_close]).all((pair) -> token_kinds_equal(&pair.0.kind, &pair.1.kind)) || !original.get(original_close + 1).is_some_and((token) -> token.kind == .LambdaArrow) || !formatted.get(formatted_close + 1).is_some_and((token) -> token.kind == .UnifiedArrow) -> return None
    Val((original: original_close + 2, formatted: formatted_close + 2))
}

// Rust: tests/support/fmt_lossless.rs:1119
fn matching_bracket_end(tokens: &[Token], open: Int) -> Int? {
    depth := 0
    loop (index, token) in tokens.iter().enumerate().skip(open) {
        if token.kind == {
            .LBracket -> depth += 1
            .RBracket -> {
                depth -= 1
                if depth == 0 -> return Val(index)
            }
            else -> {}
        }
    }
    None
}

// Rust: tests/support/fmt_lossless.rs:1136
fn typed_literal_dot_rewrite(original: &[Token], original_i: Int, formatted: &[Token], formatted_i: Int) -> Bool {
    if !original.get(original_i).is_some_and((token) -> token.kind == .Dot) -> return false
    original_body :: original.get(original_i + 1) ?? return false
    formatted_body :: formatted.get(formatted_i) ?? return false
    (original_body.kind == { .LBrace | .Str(_) -> true else -> false }) && token_kinds_equal(&original_body.kind, &formatted_body.kind)
}

// Rust: tests/support/fmt_lossless.rs:1158
fn simple_union_type_annotation(tokens: &[Token], start: Int) -> Bool {
    colon :: start.checked_sub(1) ?? return false
    if !tokens.get(colon).is_some_and((token) -> token.kind == .Colon) -> return false
    awaiting_struct_body := false
    awaiting_fn_params := false
    struct_scopes := [(brace: Int, paren: Int, bracket: Int)]{}
    fn_param_scopes := [(brace: Int, paren: Int, bracket: Int)]{}
    brace_depth := 0
    paren_depth := 0
    bracket_depth := 0
    loop token in &tokens[..colon] {
        if token.kind == {
            .KwStruct -> awaiting_struct_body = true
            .KwFn -> awaiting_fn_params = true
            .LBrace -> {
                brace_depth += 1
                if awaiting_struct_body {
                    &struct_scopes.push((brace: brace_depth, paren: paren_depth, bracket: bracket_depth))
                    awaiting_struct_body = false
                }
            }
            .RBrace -> {
                if struct_scopes.last().is_some_and((scope) -> scope.brace == brace_depth) -> _ :: &struct_scopes.pop()
                brace_depth -= 1
            }
            .LParen -> {
                paren_depth += 1
                if awaiting_fn_params {
                    &fn_param_scopes.push((brace: brace_depth, paren: paren_depth, bracket: bracket_depth))
                    awaiting_fn_params = false
                }
            }
            .RParen -> {
                if fn_param_scopes.last().is_some_and((scope) -> scope.paren == paren_depth) -> _ :: &fn_param_scopes.pop()
                paren_depth -= 1
            }
            .LBracket -> bracket_depth += 1
            .RBracket -> bracket_depth -= 1
            else -> {}
        }
    }
    scope :: (brace: brace_depth, paren: paren_depth, bracket: bracket_depth)
    struct_scopes.last() == Val(&scope) || fn_param_scopes.last() == Val(&scope)
}

// Rust: tests/support/fmt_lossless.rs:1221
fn simple_union_members(tokens: &[Token], start: Int) -> (members: [String], next: Int)? {
    first_token :: tokens.get(start) ?? return None
    first :: if first_token.kind == { .Ident(name) -> name else -> return None }
    members := [first]
    cursor := start + 1
    loop tokens.get(cursor).is_some_and((token) -> token.kind == .Pipe) {
        member_token :: tokens.get(cursor + 1) ?? return None
        if member_token.kind == { .Ident(member) -> &members.push(member) else -> return None }
        cursor += 2
    }
    if members.len() > 1 && tokens.get(cursor).is_some_and((token) -> token.kind == { .Comma | .Eq | .RBrace | .RParen -> true else -> false }) -> Val((members: members, next: cursor)) else -> None
}

// Rust: tests/support/fmt_lossless.rs:1245
fn formatted_variant_pattern_dot(original: &[Token], original_i: Int, formatted: &[Token], formatted_i: Int) -> Bool {
    original_token :: original.get(original_i) ?? return false
    if !formatted.get(formatted_i).is_some_and((token) -> token.kind == .Dot) -> return false
    formatted_token :: formatted.get(formatted_i + 1) ?? return false
    same_variant :: if (&original_token.kind, &formatted_token.kind) == {
        (.Ident(original), .Ident(formatted)) -> original == formatted && original.starts_with(Char.is_uppercase)
        (.KwNull, .KwNull) -> true
        else -> false
    }
    same_variant && variant_pattern_context(original, original_i)
}

// Rust: tests/support/fmt_lossless.rs:1275
fn variant_pattern_context(tokens: &[Token], index: Int) -> Bool {
    if index > 0 && tokens[index - 1].kind == .EqEq -> return true
    brace_depth := 0
    dispatch_open := None as Int?
    loop cursor in (0..index).rev() {
        if tokens[cursor].kind == {
            .RBrace -> brace_depth += 1
            .LBrace -> {
                if brace_depth > 0 -> brace_depth -= 1 else {
                    dispatch_open = Val(cursor)
                    break
                }
            }
            else -> {}
        }
    }
    open :: dispatch_open ?? return false
    open > 0 && tokens[open - 1].kind == .EqEq && same_brace_scope_has_if(tokens, open - 1) && pattern_reaches_arrow(tokens, index)
}

// Rust: tests/support/fmt_lossless.rs:1311
fn same_brace_scope_has_if(tokens: &[Token], before: Int) -> Bool {
    loop token in tokens[..before].iter().rev() {
        if token.kind == {
            .KwIf -> return true
            .LBrace | .RBrace | .UnifiedArrow | .LambdaArrow -> return false
            else -> {}
        }
    }
    false
}

// Rust: tests/support/fmt_lossless.rs:1324
fn pattern_reaches_arrow(tokens: &[Token], index: Int) -> Bool {
    paren_depth := 0
    bracket_depth := 0
    loop token in &tokens[index + 1..] {
        if token.kind == {
            .LParen -> paren_depth += 1
            .RParen -> { if paren_depth > 0 -> paren_depth -= 1 }
            .LBracket -> bracket_depth += 1
            .RBracket -> { if bracket_depth > 0 -> bracket_depth -= 1 }
            .UnifiedArrow | .LambdaArrow -> { if paren_depth == 0 && bracket_depth == 0 -> return true }
            .LBrace | .RBrace -> { if paren_depth == 0 && bracket_depth == 0 -> return false }
            else -> {}
        }
    }
    false
}

// Rust: tests/support/fmt_lossless.rs:1347
fn formatted_arm_block_opens(tokens: &[Token], index: Int) -> Bool {
    tokens.get(index).is_some_and((t) -> t.kind == .LBrace) && index > 0 && (tokens[index - 1].kind == { .UnifiedArrow | .LambdaArrow -> true else -> false })
}

// Rust: tests/support/fmt_lossless.rs:1358
fn formatted_lambda_params_open(tokens: &[Token], index: Int) -> Bool {
    if !tokens.get(index).is_some_and((t) -> t.kind == .LParen) -> return false
    depth := 0
    loop (cursor, token) in tokens.iter().enumerate().skip(index) {
        if token.kind == {
            .LParen -> depth += 1
            .RParen -> {
                depth -= 1
                if depth == 0 -> return tokens.get(cursor + 1).is_some_and((t) -> t.kind == { .UnifiedArrow | .LambdaArrow -> true else -> false })
            }
            else -> {}
        }
    }
    false
}

// Rust: tests/support/fmt_lossless.rs:1381
fn next_token_matches(original: &[Token], original_i: Int, formatted: &[Token], formatted_i: Int) -> Bool {
    if (original.get(original_i), formatted.get(formatted_i)) == {
        (.None, .None) -> true
        (.Val(original), .Val(formatted)) -> token_kinds_equal(&original.kind, &formatted.kind)
        else -> false
    }
}

// Rust: tests/support/fmt_lossless.rs:1394
fn struct_literal_head_before_brace(tokens: &[Token], open: Int) -> Bool {
    if open == 0 -> return false
    if tokens[open - 1].kind == {
        .Dot | .Colon | .ColonColon | .Comma | .LParen | .Eq | .KwReturn | .Gt -> true
        .Ident(name) -> name.starts_with(Char.is_uppercase)
        .RBracket -> {
            if open < 3 -> return false
            tokens[open - 2].kind == .LBracket && (tokens[open - 3].kind == { .Ident(name) -> name.starts_with(Char.is_uppercase) else -> false })
        }
        else -> false
    }
}

// Rust: tests/support/fmt_lossless.rs:1430
fn formatted_struct_shorthand_expansion(tokens: &[Token], index: Int) -> Bool {
    if !tokens.get(index).is_some_and((t) -> t.kind == .Colon) || index == 0 -> return false
    value_token :: tokens.get(index + 1) ?? return false
    value :: if value_token.kind == { .Ident(name) -> name else -> return false }
    field :: if tokens[index - 1].kind == { .Ident(name) -> name else -> return false }
    if field != value -> return false
    depth := 0
    loop cursor in (0..index).rev() {
        if tokens[cursor].kind == {
            .RBrace -> depth += 1
            .LBrace -> {
                if depth == 0 -> return struct_literal_head_before_brace(tokens, cursor)
                depth -= 1
            }
            else -> {}
        }
    }
    false
}

// Rust: tests/support/fmt_lossless.rs:1468
fn formatted_default_module_alias(tokens: &[Token], index: Int) -> Bool {
    as_token :: tokens.get(index) ?? return false
    alias_token :: tokens.get(index + 1) ?? return false
    as_kw :: if as_token.kind == { .Ident(name) -> name else -> return false }
    alias :: if alias_token.kind == { .Ident(name) -> name else -> return false }
    as_kw == Syntax.KW_AS && index >= 2 && (tokens[index - 1].kind == { .Ident(segment) -> segment == alias else -> false }) && tokens[index - 2].kind == .Dot && exact_use_path_before_alias(tokens, index)
}

// Rust: tests/support/fmt_lossless.rs:1497
fn exact_use_path_before_alias(tokens: &[Token], alias_index: Int) -> Bool {
    use_index :: tokens[..alias_index].iter().rposition((token) -> token.kind == .KwUse) ?? return false
    path :: &tokens[use_index + 1..alias_index]
    if path.len() < 3 || path.len() % 2 == 0 -> return false
    path.iter().enumerate().all((pair) -> if pair.0 % 2 == 0 -> pair.1.kind == { .Ident(_) -> true else -> false } else -> pair.1.kind == .Dot)
}

// Rust: tests/support/fmt_lossless.rs:1517
fn formatted_struct_separator(tokens: &[Token], index: Int) -> Bool {
    if !tokens.get(index).is_some_and((t) -> t.kind == .Comma) -> return false
    depth := 0
    loop cursor in (0..index).rev() {
        if tokens[cursor].kind == {
            .RBrace -> depth += 1
            .LBrace -> {
                if depth == 0 -> return struct_literal_head_before_brace(tokens, cursor)
                depth -= 1
            }
            else -> {}
        }
    }
    false
}

// Rust: tests/support/fmt_lossless.rs:1550
pub fn run_supported_source_corpus() {
    root :: OSPath.from(env("CARGO_MANIFEST_DIR"))
    example_files :: collect_jet_files_recursive(&root.join("Examples"))
    ui_files :: collect_jet_files_recursive(&root.join("tests/ui"))
    example_programs := 0
    example_configs := 0
    loop path in &example_files {
        name :: path.file_name().and_then((name) -> name.to_str())
        if name == Val(Syntax.PAYLOAD_FILE) || name == Val(Syntax.WORKSPACE_FILE) || name == Val(Syntax.PACKAGE_FILE) {
            example_configs += 1
            next
        }
        src :: fs.read_to_string(path).unwrap()
        if format_source(src) == {
            .Ok(formatted) -> {
                assert_fmt_preserves_token_stream(path, src, formatted)
                example_programs += 1
            }
            .Err(diagnostics) -> {
                formatted :: Package.format_source(src, path.display().to_string()).unwrap_or_else((_) -> panic("example program failed to parse for fmt on {path.display()}:\n{render_diagnostics(path.display().to_string(), src, &diagnostics)}"))
                assert_fmt_preserves_token_stream(path, src, formatted)
                example_configs += 1
            }
        }
    }
    ui_parse_valid := 0
    ui_parse_invalid := 0
    ui_configs := 0
    actual_invalid := [String]{}
    mismatches := [String]{}
    loop path in &ui_files {
        name :: path.file_name().and_then((name) -> name.to_str())
        if name == Val(Syntax.PAYLOAD_FILE) || name == Val(Syntax.WORKSPACE_FILE) || name == Val(Syntax.PACKAGE_FILE) {
            // Manifests are config, never program source or pinned invalid fixtures.
            ui_configs += 1
            next
        }
        src :: fs.read_to_string(path).unwrap()
        relative :: path.strip_prefix(&root).unwrap().to_string_lossy().replace('\\', "/")
        expected_invalid :: UI_PARSE_INVALID.binary_search(relative).is_ok()
        // Recovered AST teaching diagnostics are not hard parse failures.
        lexed :: lex(src)
        actual_is_invalid :: !lexed.1.is_empty() || Parser.parse_for_check(&lexed.0).is_err()
        if actual_is_invalid != expected_invalid {
            &mismatches.push("UI parser-validity changed for {relative}; update the pinned manifest only after review (expected_invalid={expected_invalid}, actual_is_invalid={actual_is_invalid})")
            next
        }
        if expected_invalid {
            &actual_invalid.push(relative)
            ui_parse_invalid += 1
        } else {
            is_fixed_companion :: path.file_name().and_then((name) -> name.to_str()).is_some_and((name) -> name.ends_with(".fixed.jet"))
            if !is_fixed_companion {
                formatted :: format_source(src).unwrap_or_else((diagnostics) -> panic("parse-valid UI fixture failed formatter parse on {path.display()}:\n{render_diagnostics(path.display().to_string(), src, &diagnostics)}"))
                assert_fmt_preserves_token_stream(path, src, formatted)
            }
            ui_parse_valid += 1
        }
    }
    assert(mismatches.is_empty(), "UI corpus parser-validity mismatches ({mismatches.len()} found):\n{mismatches.join("\n")}")
    assert_eq(example_files.len(), example_programs + example_configs, "every example .jet file must be program source or explicit package/workspace config")
    assert_eq(ui_files.len(), ui_parse_valid + ui_parse_invalid + ui_configs, "every UI .jet fixture must be classified by its actual formatter parse result")
    assert(UI_PARSE_INVALID.windows(2).all((pair) -> pair[0] < pair[1]), "UI parse-invalid manifest must be sorted and duplicate-free")
    assert_eq(actual_invalid, UI_PARSE_INVALID, "discovered parser-invalid UI set must exactly equal the pinned manifest")
    eprintln("formatter corpus: {example_programs} example programs, {example_configs} configs, {ui_parse_valid} parse-valid UI fixtures, {ui_parse_invalid} parse-invalid UI fixtures, {ui_configs} UI manifest configs")
}

// Rust: tests/support/fmt_lossless.rs:1685
pub fn ordered_sources_diff(original: String, formatted: String) -> Err! {
    path :: OSPath.new("canonical-rule.jet")
    original_tokens :: canonical_tokens(original, &path)
    formatted_tokens :: canonical_tokens(formatted, &path)
    ordered_token_diff(&path, &original_tokens, &formatted_tokens)
}
