// Rust: tests/support/fmt_lossless.rs:224
fn collect_jet_files_recursive(dir: &OSPath) -> [OSPath] {
    out := [OSPath]{}
    collect_matching_jet_files(dir, &out)
    &out.sort()
    out
}

// Rust: tests/support/fmt_lossless.rs:231
fn collect_matching_jet_files(dir: &OSPath, out: &[OSPath]) {
    if dir.file_name().and_then((name) -> name.to_str()) == Val(".jet") -> return
    loop entry in fs.read_dir(dir).unwrap() {
        path :: entry.unwrap().path()
        if path.is_dir() {
            collect_matching_jet_files(&path, out)
        } else if path.extension().and_then((e) -> e.to_str()) == Val(Syntax.FILE_EXT) {
            &out.push(path)
        }
    }
}

// Ordered exact loss oracle: only parser-equivalent, explicitly named rewrites
// may alter tokens. Expression operands, operators, marker payloads, comments,
// and interpolation tokens remain ordered and intact.
// Rust: tests/support/fmt_lossless.rs:255
fn canonical_tokens(src: String, path: &OSPath) -> [Token] {
    lexed :: lex(src)
    tokens :: lexed.0
    diagnostics :: lexed.1
    assert(diagnostics.is_empty(), "lex failed on {path.display()}:\n{render_diagnostics(path.display().to_string(), src, &diagnostics)}")
    normalized :: canonicalize_external_methods(canonicalize_static_generic_calls(expand_marker_groups(canonicalize_file_prefix(^tokens))))
    enum_commas :: enum_group_commas(&normalized)
    field_commas :: declaration_field_commas(&normalized)
    filtered := [Token]{}
    loop (index, token) in normalized.iter().enumerate() {
        if !enum_commas[index] && !field_commas[index] && !(token.kind == { .Semi | .Eof -> true else -> false }) {
            &filtered.push(token.clone())
        }
    }
    canonical := [Token]{}
    index := 0
    loop index < filtered.len() {
        if filtered[index].kind == .Comma && filtered.get(index + 1).is_some_and((next) -> next.kind == { .RParen | .RBracket | .RBrace -> true else -> false }) {
            index += 1
            next
        }
        // D-FAIL-ERROR1=A: default Err is omitted only in fallible returns.
        if (filtered[index].kind == { .Ident(name) -> name == Syntax.TYPE_ERR else -> false }) && canonical.last().is_some_and((token) -> token.kind == .Bang) && filtered.get(index + 1).is_some_and((token) -> token.kind == { .LBrace | .Eq -> true else -> false }) {
            index += 1
            next
        }
        if redundant_default_file_alias(&canonical, &filtered, index) {
            index += 2
            next
        }
        &canonical.push(filtered[index].clone())
        index += 1
    }
    canonical
}

// Rust: tests/support/fmt_lossless.rs:319
fn canonicalize_file_prefix(tokens: [Token]) -> [Token] {
    chunks := [[Token]]{}
    chunk := [Token]{}
    brace_depth := 0
    loop token in tokens {
        if token.kind == {
            .LBrace -> brace_depth += 1
            .RBrace -> brace_depth -= 1
            else -> {}
        }
        end :: token.kind == .Eof || (brace_depth == 0 && token.kind == .Semi)
        &chunk.push(^token)
        if end {
            &chunks.push(^chunk)
            chunk = [Token]{}
        }
    }
    if !chunk.is_empty() -> &chunks.push(^chunk)
    groups := [(category: Int, tokens: [Token])]{}
    leading_comments := [Token]{}
    loop chunk in chunks {
        if chunk.iter().all((token) -> token.kind == { .LineComment(_) | .BlockComment(_) | .Semi | .Eof -> true else -> false }) {
            &leading_comments.extend(^chunk)
            next
        }
        &leading_comments.extend(^chunk)
        category :: file_chunk_category(&leading_comments)
        &groups.push((category: category, tokens: ^leading_comments))
        leading_comments = [Token]{}
    }
    if !leading_comments.is_empty() -> &groups.push((category: 3, tokens: ^leading_comments))
    loop directive_i in 0..groups.len() {
        if !is_spanless_file_marker_group(&groups[directive_i].tokens) -> next
        displaced := [Token]{}
        loop groups[directive_i].tokens.first().is_some_and((token) -> token.kind == { .LineComment(_) | .BlockComment(_) | .Semi -> true else -> false }) {
            &displaced.push(&groups[directive_i].tokens.remove(0))
        }
        loop item_i in directive_i + 1..groups.len() {
            if groups[item_i].category == 3 {
                &displaced.append(&groups[item_i].tokens)
                groups[item_i].tokens = ^displaced
                break
            }
        }
    }
    loop import_i in 0..groups.len() {
        if groups[import_i].category != 1 -> next
        hoisted_comments := [Token]{}
        loop earlier in 0..import_i {
            &hoisted_comments.extend(drain_top_level_comments(&groups[earlier].tokens))
        }
        if !hoisted_comments.is_empty() {
            &hoisted_comments.append(&groups[import_i].tokens)
            groups[import_i].tokens = ^hoisted_comments
        }
    }
    &groups.retain((group) -> !group.tokens.is_empty())
    &groups.sort_by_key((group) -> group.category)
    out := [Token]{}
    loop group in groups -> &out.extend(^group.tokens)
    out
}

// Rust: tests/support/fmt_lossless.rs:397
fn is_spanless_file_marker_group(tokens: &[Token]) -> Bool {
    kinds :: tokens.iter().filter((token) -> !(token.kind == { .LineComment(_) | .BlockComment(_) | .Semi | .Eof -> true else -> false })).map((token) -> &token.kind).collect()
    if kinds.len() < 2 || kinds[0] != .Hash -> return false
    kinds[1] == { .Ident(name) -> name == Syntax.MARKER_TARGET || name == Syntax.MARKER_HTML else -> false }
}

// Rust: tests/support/fmt_lossless.rs:415
fn drain_top_level_comments(tokens: &[Token]) -> [Token] {
    comments := [Token]{}
    retained := [Token]{}
    brace_depth := 0
    loop token in &tokens.drain(..) {
        if token.kind == {
            .LBrace -> brace_depth += 1
            .RBrace -> brace_depth -= 1
            .LineComment(_) | .BlockComment(_) -> {
                if brace_depth == 0 {
                    &comments.push(^token)
                    next
                }
            }
            else -> {}
        }
        &retained.push(^token)
    }
    tokens = ^retained
    comments
}

// Rust: tests/support/fmt_lossless.rs:435
fn file_chunk_category(chunk: &[Token]) -> Int {
    kinds :: chunk.iter().filter((token) -> !(token.kind == { .LineComment(_) | .BlockComment(_) | .Semi | .Eof -> true else -> false })).map((token) -> &token.kind).collect()
    if kinds.is_empty() -> return 3
    if kinds[0] == .KwUse -> return 1
    if kinds[0] == .KwPub && kinds.iter().skip(1).any((kind) -> kind == .KwUse) -> return 1
    if kinds.len() > 1 && kinds[0] == .Hash {
        if kinds[1] == {
            .Ident(name) -> {
                if name == Syntax.MARKER_PUB_FILE || name == Syntax.MARKER_NO_PRELUDE -> return 0
                if name == Syntax.MARKER_TARGET || name == Syntax.MARKER_HTML -> return 2
            }
            else -> {}
        }
    }
    3
}

// Rust: tests/support/fmt_lossless.rs:469
fn expand_marker_groups(tokens: [Token]) -> [Token] {
    out := [Token]{}
    index := 0
    loop index < tokens.len() {
        if tokens[index].kind == .Hash && tokens.get(index + 1).is_some_and((t) -> t.kind == .LBracket) {
            if matching_bracket(&tokens, index + 1) == .Val(end) {
                group_start := index + 2
                paren_depth := 0
                brace_depth := 0
                bracket_depth := 0
                loop cursor in index + 2..=end {
                    split :: cursor == end || (tokens[cursor].kind == .Comma && paren_depth == 0 && brace_depth == 0 && bracket_depth == 0)
                    if split {
                        &out.push(tokens[index].clone())
                        &out.extend(tokens[group_start..cursor].iter().cloned())
                        group_start = cursor + 1
                        next
                    }
                    if tokens[cursor].kind == {
                        .LParen -> paren_depth += 1
                        .RParen -> paren_depth -= 1
                        .LBrace -> brace_depth += 1
                        .RBrace -> brace_depth -= 1
                        .LBracket -> bracket_depth += 1
                        .RBracket -> bracket_depth -= 1
                        else -> {}
                    }
                }
                index = end + 1
                next
            }
        }
        &out.push(tokens[index].clone())
        index += 1
    }
    out
}

// Rust: tests/support/fmt_lossless.rs:516
fn matching_bracket(tokens: &[Token], open: Int) -> Int? {
    depth := 0
    loop index in open..tokens.len() {
        if tokens[index].kind == {
            .LBracket -> depth += 1
            .RBracket -> {
                depth -= 1
                if depth == 0 -> return Val(index)
            }
            else -> {}
        }
    }
    None
}

// Rust: tests/support/fmt_lossless.rs:533
fn canonicalize_static_generic_calls(tokens: [Token]) -> [Token] {
    out := [Token]{}
    index := 0
    loop index < tokens.len() {
        if (tokens[index].kind == { .Ident(_) -> true else -> false }) && tokens.get(index + 1).is_some_and((t) -> t.kind == .Lt) {
            depth := 0
            close := None as Int?
            loop cursor in index + 1..tokens.len() {
                if tokens[cursor].kind == {
                    .Lt -> depth += 1
                    .Gt -> {
                        depth -= 1
                        if depth == 0 {
                            close = Val(cursor)
                            break
                        }
                    }
                    else -> {}
                }
            }
            if close == .Val(close) {
                if tokens.get(close + 1).is_some_and((t) -> t.kind == .Dot) && tokens.get(close + 2).is_some_and((t) -> t.kind == { .Ident(_) -> true else -> false }) && tokens.get(close + 3).is_some_and((t) -> t.kind == .LParen) {
                    &out.push(tokens[index].clone())
                    &out.push(tokens[close + 1].clone())
                    &out.push(tokens[close + 2].clone())
                    &out.extend(tokens[index + 1..=close].iter().cloned())
                    index = close + 3
                    next
                }
            }
        }
        &out.push(tokens[index].clone())
        index += 1
    }
    out
}

// Rust: tests/support/fmt_lossless.rs:581
fn canonicalize_external_methods(tokens: [Token]) -> [Token] {
    out := [Token]{}
    index := 0
    loop index < tokens.len() {
        if tokens[index].kind == .KwFn && tokens.get(index + 1).is_some_and((t) -> t.kind == { .Ident(_) -> true else -> false }) && tokens.get(index + 2).is_some_and((t) -> t.kind == .Dot) && tokens.get(index + 3).is_some_and((t) -> t.kind == { .Ident(_) -> true else -> false }) && tokens.get(index + 4).is_some_and((t) -> t.kind == .LParen) {
            body_open :: tokens[index + 4..].iter().position((token) -> token.kind == .LBrace).map((offset) -> index + 4 + offset)
            if body_open == {
                .Val(body_open) -> {
                    if matching_brace(&tokens, body_open) == .Val(body_close) {
                        &out.push(Token{kind: .KwImpl, span: tokens[index].span})
                        &out.push(tokens[index + 1].clone())
                        &out.push(Token{kind: .LBrace, span: tokens[index].span})
                        &out.push(tokens[index].clone())
                        &out.push(tokens[index + 3].clone())
                        &out.extend(tokens[index + 4..=body_close].iter().cloned())
                        &out.push(Token{kind: .RBrace, span: tokens[body_close].span})
                        index = body_close + 1
                        next
                    }
                }
                .None -> {
                    if tokens[index + 4..].iter().position((token) -> token.kind == { .Semi | .Eof -> true else -> false }).map((offset) -> index + 4 + offset) == .Val(method_end) {
                        // Preserve the exact one-line method span in a synthetic impl.
                        &out.push(Token{kind: .KwImpl, span: tokens[index].span})
                        &out.push(tokens[index + 1].clone())
                        &out.push(Token{kind: .LBrace, span: tokens[index].span})
                        &out.push(tokens[index].clone())
                        &out.push(tokens[index + 3].clone())
                        &out.extend(tokens[index + 4..method_end].iter().cloned())
                        &out.push(Token{kind: .RBrace, span: tokens[method_end.saturating_sub(1)].span})
                        index = method_end
                        next
                    }
                }
            }
        }
        &out.push(tokens[index].clone())
        index += 1
    }
    out
}

// Rust: tests/support/fmt_lossless.rs:659
fn matching_brace(tokens: &[Token], open: Int) -> Int? {
    depth := 0
    loop index in open..tokens.len() {
