// Rust: tests/support/fmt_lossless.rs:760
fn redundant_default_file_alias(canonical: &[Token], tokens: &[Token], index: Int) -> Bool {
    if index + 1 >= tokens.len() || !(tokens[index].kind == { .Ident(name) -> name == Syntax.KW_AS else -> false }) -> return false
