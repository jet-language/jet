// Rust: tests/support/nix_index_cache_server.rs:36
fn valid_fixture_times() -> (UInt64, UInt64, UInt64) {
    // GATE #4494: native wall clock.
    now :: time.SystemTime.now().duration_since(time.UNIX_EPOCH).expect("test clock is before Unix epoch").as_secs()
    (now.saturating_sub(60), now.saturating_sub(60), now.saturating_add(365 * 24 * 60 * 60))
}
