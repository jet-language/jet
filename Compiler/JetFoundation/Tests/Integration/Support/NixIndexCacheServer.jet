    pub fn start_static_ripgrep(scratch: &OSPath, publication: &OSPath) -> StaticNixIndexCacheServer {
        static_server :: StaticFileServer.start(publication)
        endpoint :: static_server.endpoint.clone()
        (signed_index, routes, root_store_path, transitive_store_paths) :: ripgrep_fixture(&endpoint, &endpoint, scratch)
        write_static_routes(publication, &routes)
        StaticNixIndexCacheServer { endpoint: endpoint, index_endpoint: static_server.endpoint.clone(), root_store_path: root_store_path.to_string(), transitive_store_paths: transitive_store_paths, signed_index: signed_index, _server: static_server }
    }
    // Rust: tests/support/nix_index_cache_server.rs:110
    pub fn start_unindexed(scratch: &OSPath) -> Self {
        listener :: TcpListener.bind(("127.0.0.1", 0)).expect("bind Nix test server")
        listener.set_nonblocking(true).expect("set Nix test server nonblocking")
        address :: listener.local_addr().expect("Nix test server address")
        endpoint :: "http://127.0.0.1:{address.port()}"
        index_endpoint :: "{endpoint}/index"
        (released_unix, issued_unix, expires_unix) :: valid_fixture_times()
        signed_index :: test_nix_index.signed(SIGNING_SEED, INDEX_KEY_ID, &index_endpoint, CHANNEL, REVISION, SYSTEM, released_unix, 1, issued_unix, expires_unix, [], [(["postgres"], "missing-narinfo")]).expect("build signed unindexed Nix test index")
        _ :: scratch
        Self.finish(listener, endpoint.clone(), index_endpoint, signed_index.clone(), index_routes(&signed_index, &endpoint, CHANNEL), ROOT_PATH, [])
    }
    // Rust: tests/support/nix_index_cache_server.rs:147
    fn finish(listener: TcpListener, endpoint: String, index_endpoint: String, signed_index: TestSignedIndex, routes: [String:[UInt8]], root_store_path: String, transitive_store_paths: [String]) -> Self {
        // GATE #4494: native shared ownership, mutex, atomics and worker thread.
        shared_routes :: Arc.new(Mutex.new(routes))
        counts :: Arc.new(Mutex.new([String:UInt]{}))
        online :: Arc.new(AtomicBool.new(true))
        stop :: Arc.new(AtomicBool.new(false))
        thread_routes :: Arc.clone(&shared_routes)
        thread_counts :: Arc.clone(&counts)
        thread_online :: Arc.clone(&online)
        thread_stop :: Arc.clone(&stop)
        join :: thread.spawn(fn() {
            while !thread_stop.load(Ordering.Relaxed) {
                match listener.accept() {
                    Ok((stream, _)) -> { serve_request(stream, &thread_routes, &thread_counts, thread_online.load(Ordering.Relaxed)) }
                    Err(error) if error.kind() == ErrorKind.WouldBlock -> { thread.sleep(Duration.from_millis(1)) }
                    Err(_) -> { break }
                }
            }
        })
        Self { endpoint: endpoint, index_endpoint: index_endpoint, root_store_path: root_store_path.to_string(), transitive_store_paths: transitive_store_paths, signed_index: signed_index, routes: shared_routes, counts: counts, online: online, stop: stop, join: Some(join) }
    }
    // Rust: tests/support/nix_index_cache_server.rs:194
    pub fn install(self, root: &OSPath) -> { install_fixture_config(root, &self.index_endpoint, &self.endpoint, &self.signed_index) }
    // Rust: tests/support/nix_index_cache_server.rs:198
    pub fn install_local_catalog(self, root: &OSPath) -> {
        target_dir :: root.join("index-v1").join(REVISION).join(SYSTEM)
        fs.create_dir_all(&target_dir).expect("local Nix catalog target directory")
        digest :: SHA256.sha256_hex(&self.signed_index.index_bytes)
        fs.write(target_dir.join("{digest}.json.zst"), &self.signed_index.index_bytes).expect("local Nix catalog target")
    }
    // Rust: tests/support/nix_index_cache_server.rs:209
    pub fn corrupt_index_signature(self) -> {
        path :: self.signed_index.target_signature_url.strip_prefix(&self.endpoint).expect("index signature belongs to server")
        signature := self.signed_index.index_signature.clone()
        signature.push(33)
        self.routes.lock().expect("Nix test routes").insert(path.to_string(), signature)
    }
    // Rust: tests/support/nix_index_cache_server.rs:223
    pub fn stop_network(self) -> { self.online.store(false, Ordering.Relaxed) }
    // Rust: tests/support/nix_index_cache_server.rs:227
    pub fn start_network(self) -> { self.online.store(true, Ordering.Relaxed) }
    // Rust: tests/support/nix_index_cache_server.rs:231
    pub fn reset_counts(self) -> { self.counts.lock().expect("Nix request counts").clear() }
    // Rust: tests/support/nix_index_cache_server.rs:235
    pub fn count(self, path: String) -> UInt { self.counts.lock().expect("Nix request counts").get(path).copied().unwrap_or_default() }
    // Rust: tests/support/nix_index_cache_server.rs:244
    pub fn object_request_count(self, store_path: String) -> UInt {
        basename :: store_path.strip_prefix("/nix/store/").expect("test store path prefix")
        narinfo_path :: "/{basename[..32]}.narinfo"
        nar_path :: match store_path {
            ROOT_PATH -> "/nar/root.nar"
            LIB_PATH -> "/nar/lib.nar"
            RUNTIME_PATH -> "/nar/runtime.nar"
            _ -> { return self.count(&narinfo_path) }
        }
        self.count(&narinfo_path) + self.count(nar_path)
    }
}
// Rust: tests/support/nix_index_cache_server.rs:258
pub struct StaticNixIndexCacheServer {
    pub endpoint: String
    pub index_endpoint: String
    pub root_store_path: String
    pub transitive_store_paths: [String]
    pub signed_index: TestSignedIndex
    _server: StaticFileServer
}
impl StaticNixIndexCacheServer {
    // Rust: tests/support/nix_index_cache_server.rs:268
    pub fn install(self, root: &OSPath) -> { install_fixture_config(root, &self.index_endpoint, &self.endpoint, &self.signed_index) }
}
impl NixIndexCacheServer.Drop {
    // Rust: tests/support/nix_index_cache_server.rs:274
    fn drop(&self) -> {
        self.stop.store(true, Ordering.Relaxed)
        _ :: TcpStream.connect(self.endpoint.strip_prefix("http://").expect("loopback Nix test endpoint"))
        if Some(join) :: self.join.take() { join.join().expect("Nix test server thread") }
    }
}
// Rust: tests/support/nix_index_cache_server.rs:287
fn index_routes(signed: &TestSignedIndex, endpoint: String, channel: String) -> [String:[UInt8]] {
    target_path :: signed.target_url.strip_prefix(endpoint).expect("index target belongs to server").to_string()
    index_prefix :: target_path.split_once("/index-v1/").map(fn((prefix, _)) { prefix }).expect("index target has the v1 path")
    manifest :: "{index_prefix}/v1/{channel}/manifest.json"
    target_signature_path :: signed.target_signature_url.strip_prefix(endpoint).expect("index target signature belongs to server").to_string()
    [manifest: signed.manifest_bytes.clone(), "{manifest}.sig.json": signed.manifest_signature.clone(), target_path: signed.index_bytes.clone(), target_signature_path: signed.index_signature.clone()]
}
// Rust: tests/support/nix_index_cache_server.rs:318
fn install_fixture_config(root: &OSPath, index_endpoint: String, cache_endpoint: String, signed_index: &TestSignedIndex) -> {
    fs.create_dir_all(root.join("config")).expect("Nix index config directory")
    fs.create_dir_all(root.join("trust")).expect("Nix index trust directory")
    fs.write(root.join("config/nix-index-v1.endpoint"), "{index_endpoint}\n").expect("Nix index endpoint")
    fs.write(root.join("trust/nix-index-v1.ed25519.pub"), "{INDEX_KEY_ID}:{base64_encode(&signed_index.public_key)}\n").expect("Nix index trust key")
    fs.write(root.join("config/nix-cache-v1.endpoint"), "{cache_endpoint}\n").expect("Nix cache endpoint")
    fs.write(root.join("trust/nix-cache-v1.ed25519.pub"), "{CACHE_KEY_ID}:{base64_encode(&test_nix_index.public_key(SIGNING_SEED))}\n").expect("Nix cache trust key")
}
// Rust: tests/support/nix_index_cache_server.rs:356
fn ripgrep_fixture(endpoint: String, index_endpoint: String, scratch: &OSPath) -> (TestSignedIndex, [String:[UInt8]], String, [String]) {
    (released_unix, issued_unix, expires_unix) :: valid_fixture_times()
    signed_index :: test_nix_index.signed(SIGNING_SEED, INDEX_KEY_ID, index_endpoint, CHANNEL, REVISION, SYSTEM, released_unix, 1, issued_unix, expires_unix,
        [TestIndexRecord { attrpath: ["ripgrep"], version: "15.2.0", drv_path: DRV_PATH, outputs: ["out": ROOT_PATH] }], []).expect("build signed Nix test index")
    source :: scratch.join("nix-index-cache-nar-source")
    objects :: [(ROOT_PATH, ObjectKind.Root, "root.nar"), (LIB_PATH, ObjectKind.Library, "lib.nar"), (RUNTIME_PATH, ObjectKind.Runtime, "runtime.nar")]
    nars := [String:[UInt8]]{}
    for (store_path, kind, _nar_name) in objects { nars.insert(store_path.to_string(), make_nar(&source, kind)) }
    routes := index_routes(&signed_index, endpoint, CHANNEL)
    routes.insert("/nix-cache-info", "StoreDir: /nix/store\nWantMassQuery: 1\n".into_bytes())
    for (store_path, kind, nar_name) in objects {
        nar :: nars.get(store_path).expect("Nix test NAR was built")
        basename :: store_path.strip_prefix("/nix/store/").expect("test store path prefix")
        references :: match kind { ObjectKind.Root -> [LIB_PATH]; ObjectKind.Library -> [RUNTIME_PATH]; ObjectKind.Runtime -> [] }
        routes.insert("/{basename[..32]}.narinfo", signed_narinfo(store_path, nar_name, nar, references.as_slice(), CACHE_KEY_ID, SIGNING_SEED))
        routes.insert("/nar/{nar_name}", nar.clone())
    }
    _ :: fs.remove_dir_all(&source)
    (signed_index, routes, ROOT_PATH, [LIB_PATH, RUNTIME_PATH])
}
// Rust: tests/support/nix_index_cache_server.rs:430
fn write_static_routes(root: &OSPath, routes: &[String:[UInt8]]) -> {
    keys := routes.keys().collect()
    keys.sort()
    for route in keys {
        relative :: route.strip_prefix('/').expect("static route starts with slash")
        path :: root.join(relative)
        fs.create_dir_all(path.parent().expect("static route parent")).expect("static route directory")
        fs.write(path, &routes[route]).expect("static route bytes")
    }
}
// Rust: tests/support/nix_index_cache_server.rs:442
fn make_nar(root: &OSPath, kind: ObjectKind) -> [UInt8] {
    _ :: fs.remove_dir_all(root)
    fs.create_dir_all(root).expect("Nix NAR source root")
    match kind {
        ObjectKind.Root -> {
            fs.create_dir_all(root.join("bin")).expect("Nix executable directory")
            executable :: root.join("bin/rg")
            fs.write(&executable, "#!/bin/sh\necho ripgrep 15.2.0\n".as_bytes()).expect("Nix executable")
            if target.selected_family() == "unix" {
                // GATE #4494: native Unix permission bits.
                fs.set_permissions(&executable, fs.Permissions.from_mode(0o755)).expect("Nix executable mode")
            }
        }
        ObjectKind.Library -> {
            fs.create_dir_all(root.join("lib")).expect("Nix library directory")
            fs.write(root.join("lib/marker"), "library".as_bytes()).expect("Nix library marker")
        }
        ObjectKind.Runtime -> {
            fs.create_dir_all(root.join("share")).expect("Nix runtime directory")
            fs.write(root.join("share/marker"), "runtime".as_bytes()).expect("Nix runtime marker")
        }
    }
    (nar, _) :: Store.write_nar(root).expect("encode Nix test NAR")
    nar
}
// Rust: tests/support/nix_index_cache_server.rs:470
fn signed_narinfo(store_path: String, nar_name: String, nar: &[UInt8], references: &[String], key_id: String, seed: [UInt8; 32]) -> [UInt8] {
    hash :: "sha256:{SHA256.sha256_hex(nar)}"
    reference_names :: references.iter().map(fn(reference) { reference.rsplit('/').next().expect("Nix reference basename").to_string() }).collect()
    info :: NixNarInfo { store_path: store_path.to_string(), url: "nar/{nar_name}", compression: NixCompression.None, file_hash: Some(hash.clone()), file_size: Some(nar.len() as UInt64), nar_hash: hash, nar_size: nar.len() as UInt64, references: reference_names.clone(), deriver: None, ca: None, signatures: [] }
    signed :: test_nix_index.sign(seed, &info.fingerprint("/nix/store").expect("Nix narinfo fingerprint"))
    signature :: NixNarInfoSignature { key_id: key_id.to_string(), signature: signed.try_into().expect("ed25519 signature has 64 bytes") }
    "StorePath: {info.store_path}\nURL: {info.url}\nCompression: none\nFileHash: {info.file_hash.as_deref().expect("Nix FileHash")}\nFileSize: {info.file_size.expect("Nix FileSize")}\nNarHash: {info.nar_hash}\nNarSize: {info.nar_size}\nReferences: {reference_names.join(" ")}\nSig: {key_id}:{base64_encode(&signature.signature)}\n".into_bytes()
}
// Rust: tests/support/nix_index_cache_server.rs:530
fn serve_request(stream: TcpStream, routes: &Arc<Mutex<[String:[UInt8]]>>, counts: &Arc<Mutex<[String:UInt]>>, online: Bool) -> {
    request := [UInt8; 16384].filled(0)
    count :: stream.read(&request).unwrap_or_default()
    path :: String.from_utf8(&request[..count]).ok().and_then(fn(request) { request.lines().next() }).and_then(fn(line) { line.split_whitespace().nth(1) }).unwrap_or("/").split('?').next().unwrap_or("/").to_string()
    counts.lock().expect("Nix request counts").entry(path.clone()).or_default() += 1
    body :: if online { routes.lock().expect("Nix test routes").get(&path).cloned() } else { None }
    match body {
        Some(body) -> {
            header :: "HTTP/1.1 200 OK\r\nContent-Length: {body.len()}\r\nConnection: close\r\n\r\n"
            _ :: stream.write_all(header.as_bytes())
            _ :: stream.write_all(&body)
        }
        None -> { _ :: stream.write_all("HTTP/1.1 503 Service Unavailable\r\nContent-Length: 0\r\nConnection: close\r\n\r\n".as_bytes()) }
    }
}
// Rust: tests/support/nix_index_cache_server.rs:574
fn base64_encode(bytes: &[UInt8]) -> String {
    // Rust: tests/support/nix_index_cache_server.rs:575
    ALPHABET :: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/".as_bytes()
    output := String.new()
    for chunk in bytes.chunks(3) {
        first :: chunk[0]
        output.push(ALPHABET[(first >> 2) as UInt] as Char)
        output.push(ALPHABET[(((first & 0x03) << 4) | (chunk.get(1).copied().unwrap_or_default() >> 4)) as UInt] as Char)
        if Some(second) :: chunk.get(1) {
            output.push(ALPHABET[(((second & 0x0f) << 2) | (chunk.get(2).copied().unwrap_or_default() >> 6)) as UInt] as Char)
        } else { output.push('=') }
        if Some(third) :: chunk.get(2) { output.push(ALPHABET[(third & 0x3f) as UInt] as Char) }
        else { output.push('=') }
    }
    output
}
