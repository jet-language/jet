        // GATE #4494: native loopback socket.
        listener :: TcpListener.bind(("127.0.0.1", 0)).expect("bind Nix test server")
        listener.set_nonblocking(true).expect("set Nix test server nonblocking")
        address :: listener.local_addr().expect("Nix test server address")
        endpoint :: "http://127.0.0.1:{address.port()}"
        index_endpoint :: "{endpoint}/index"
        (signed_index, normalized_routes, root_store_path, transitive_store_paths) :: ripgrep_fixture(&endpoint, &index_endpoint, scratch)
