                return match receiver.without_parens() { .Ident(name, _) -> name == "task" || name == jet.Syntax.INTERNAL_TASK_RECEIVER; _ -> false } && ["all", jet.Syntax.INTERNAL_TASK_ALL_METHOD].contains(method.as_str())
            }
            .OrFallback { value, .. } -> { current = value }
            _ -> { return false }
        }
    }
}
// Rust: tests/support/corpus_policy.rs:3633
pub fn is_task_combinator_expr(expr: &Expr) -> Bool {
    current := expr
    loop {
        match current.without_parens() {
            .Call(call) -> { return [jet.Syntax.TASK_ALL, jet.Syntax.TASK_RACE, jet.Syntax.TASK_ANY, jet.Syntax.INTERNAL_TASK_ALL_METHOD, jet.Syntax.INTERNAL_TASK_RACE_METHOD, jet.Syntax.INTERNAL_TASK_ANY_METHOD].contains(call.name.as_str()) }
            .MethodCall { receiver, method, .. } -> {
                return match receiver.without_parens() { .Ident(name, _) -> name == "task" || name == jet.Syntax.INTERNAL_TASK_RECEIVER; _ -> false } && ["all", "race", "any", jet.Syntax.INTERNAL_TASK_ALL_METHOD, jet.Syntax.INTERNAL_TASK_RACE_METHOD, jet.Syntax.INTERNAL_TASK_ANY_METHOD].contains(method.as_str())
            }
            .OrFallback { value, .. } -> { current = value }
            _ -> { return false }
        }
    }
}
// Rust: tests/support/corpus_policy.rs:3669
pub fn bare_structural_codable(structure: &StructDef) -> Bool {
    structure.type_params.is_empty() && structure.type_markers.len() == 1 && structure.type_markers.first().is_some_and(fn(marker) -> marker.name == "Codable" && !marker.negated)
        && structure.fields.iter().all(fn(field) -> field.serde_markers.is_empty() && field.computed.is_none() && field.default.is_none()) && !structure.is_published_schema
}
// Rust: tests/support/corpus_policy.rs:3682
pub fn site(kind: &String, span: Span) -> String { "{kind}@{span.start}..{span.end}" }
// Rust: tests/support/corpus_policy.rs:3686
pub fn inventory_error(message: &String, file: &String, site_kind: &String) -> String {
    "{message}: {file}; {SemanticViolation.new(file, "corpus-inventory", site(site_kind, Span.new(0, 0)))}"
}

