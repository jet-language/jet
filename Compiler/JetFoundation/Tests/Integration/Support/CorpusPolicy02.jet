// Rust: tests/support/corpus_policy.rs:1961
pub fn program_expressions(program: &Program) -> [&Expr] {
    expressions: [&Expr] := []
    for_each_statement_expr(&program.script_body, fn(expr) -> expressions.push(expr))
    loop item in &program.items {
        match item {
            .Func(function) -> for_each_statement_expr(&function.body, fn(expr) -> expressions.push(expr))
            .Struct(structure) -> { loop method in &structure.methods { for_each_statement_expr(&method.body, fn(expr) -> expressions.push(expr)) } }
            _ -> {}
        }
    }
    expressions
}
// Rust: tests/support/corpus_policy.rs:1980
#Derive(Debug, Default)
pub struct StatementFacts {
    task_groups: [(Span, Bool)]
    counted_loops: [(Span, Bool)]
    manual_counter_loops: [Span]
    file_walks: [Span]
}
// Rust: tests/support/corpus_policy.rs:1988
pub fn collect_program_statement_facts(program: &Program, aliases: &[String:String], facts: &StatementFacts) -> {
    collect_statement_facts(&program.script_body, aliases, facts)
    loop item in &program.items {
        match item {
            .Func(function) -> collect_statement_facts(&function.body, aliases, facts)
            .Struct(structure) -> { loop method in &structure.methods { collect_statement_facts(&method.body, aliases, facts) } }
            _ -> {}
        }
    }
}
// Rust: tests/support/corpus_policy.rs:2010
pub fn collect_statement_facts(body: &[Stmt], aliases: &[String:String], facts: &StatementFacts) -> {
    // Explicit borrowed-body stack: no source-shape-dependent call-stack depth.
    bodies: [&[Stmt]] := [body]
    loop {
        body :: match bodies.pop() { Some(body) -> body; None -> { break } }
        loop pair in body.windows(2) {
            binding :: match &pair[0] { .Val(binding) -> binding; _ -> { continue } }
            match &pair[1] {
                .For { kind: ForKind.In { .. }, body: loop_body, span, .. } -> {
                    if binding.mutable && match binding.init.without_parens() { .Int(value, ..) -> *value == 0; _ -> false } && manual_counter_body(&binding.name, loop_body) {
                        facts.manual_counter_loops.push(*span)
                    }
                }
                _ -> {}
            }
        }
        match body_file_walk_filter(body, aliases) { Some(span) -> facts.file_walks.push(span); None -> {} }
        loop statement in body.iter().rev() {
            match statement {
                .TaskGroup { span, body: task_body, .. } -> {
                    task_combinator_count :: task_body.iter().filter(fn(statement) -> is_task_combinator_statement(statement)).count()
                    has_task_all :: task_body.iter().any(is_task_all_statement)
                    facts.task_groups.push((*span, task_combinator_count == 1 && !has_task_all))
                    bodies.push(task_body)
                }
                .CountedLoop { span, init, step, body, .. } -> {
                    facts.counted_loops.push((*span, counted_loop_indexes_sequence(init, body)))
                    bodies.push(body)
                    match step { Some(step) -> bodies.push(slice.from_ref(step.as_ref())); None -> {} }
                }
                .While { body, .. } | .For { body, .. } | .Loop { body, .. }
                | .Unsafe { body, .. } | .Impure { body, .. } | .Reactive { body, .. }
                | .Shield { body, .. } | .Switched { body, .. } | .Region { body, .. }
                | .Policy { body, .. } | .Layout { body, .. } | .AuthorityScope { body, .. }
                | .ComptimeBlock { body, .. } | .ContextBlock { body, .. } | .Live { body, .. }
                | .AssumeDet { body, .. } | .Transact { body, .. } | .ScopeMember { body, .. } -> bodies.push(body)
                .Switch { arms, else_body, .. } | .ComptimeSwitch { arms, else_body, .. } -> {
                    match else_body { Some(body) -> bodies.push(body); None -> {} }
                    loop arm in arms.iter().rev() { bodies.push(&arm.body) }
                }
                .ComptimeIf { then_body, else_body, .. } -> {
                    match else_body { Some(body) -> bodies.push(body); None -> {} }
                    bodies.push(then_body)
                }
                .Expr(_) | .Val(_) | .Assign { .. } | .Return(..) | .Break(..) | .BreakValue(..)
                | .Continue(..) | .BreakLabel(..) | .BreakLabelValue(..) | .ContinueLabel(..)
                | .Yield(..) | .DeferClose { .. } -> {}
            }
        }
    }
}
// Rust: tests/support/corpus_policy.rs:2134
pub fn proof_matches(proof: &String, gate: &String) -> Bool {
    gate == "all" || proof == gate
        || (gate == "golden" && proof == "golden-and-dev-corpus")
        || (gate == "dev-corpus" && proof == "golden-and-dev-corpus")
        || (gate == "suite" && proof == "suite-goldens")
        || (gate == "package" && proof == "package-template-gate")
        || (gate == "dogfood" && proof == "dogfood-gates")
        || (gate == "dogfood" && proof == "dogfood/jetpack and workload gates")
        || (gate == "fixture" && proof == "ui-snapshot-gate")
        || (gate == "fixture" && proof == "fuzz-gate")
        || (gate == "docs" && proof == "doc-gate")
        || (gate == "site" && proof == "site-gate")
        || (gate == "bindgen" && proof == "generator-IR-renderer-registry")
        || (gate == "bindgen" && proof == "bindgen-registry")
        || (gate == "conformance" && proof == "conformance-gate")
        || (gate == "workload" && proof == "compiled-workload-gate")
        || (gate == "workload" && proof == "workload-gate")
}
// Rust: tests/support/corpus_policy.rs:2154
pub fn skip_directory(name: &String) -> Bool {
    [".git", ".claude", ".opencode", ".tmp", ".jet", ".tower", ".cache", ".agent-worktrees", "plugins", "node_modules", "target", "build", "cache", "dist", "result"].contains(name)
        || name.starts_with("target-") || name.starts_with("build-") || name.starts_with("result-")
}
// Rust: tests/support/corpus_policy.rs:2181
pub fn is_declared_package_config_dir(path: &OSPath) -> Bool {
    if path.file_name().and_then(fn(name) -> name.to_str()) != Some("config") { return false }
    package_root :: match path.parent() { Some(root) -> root; None -> { return false } }
    manifest_path :: package_root.join("package.jet")
    source :: match fs.read_to_string(&manifest_path) { Ok(source) -> source; Err(_) -> { return false } }
    facts :: match jet.Package.PackageFacts.parse_uncomposed(&source, manifest_path.display().to_string()) { Ok(facts) -> facts; Err(_) -> { return false } }
    facts.configs.iter().any(fn(config) -> config == "config" || config.starts_with("config/"))
}
// Rust: tests/support/corpus_policy.rs:2203
pub fn discover_manifest_files(root: &OSPath, manifest: &CorpusManifest, out: &[String]) -> Err! {
    loop source in &manifest.sources {
        match source.selector.strip_prefix("root:") {
            Some(path) -> { discover_files(root, &root.join(path), out)? }
            None -> { match source.selector.strip_prefix("file:") { Some(path) -> { if root.join(path).is_file() { out.push(path.to_string()) } }; None -> {} } }
        }
    }
    Ok(())
}
// Rust: tests/support/corpus_policy.rs:2220
pub fn discover_files(root: &OSPath, current: &OSPath, out: &[String]) -> Err! {
    pending := [current.clone()]
    loop {
        directory :: match pending.pop() { Some(directory) -> directory; None -> { break } }
        metadata :: fs.symlink_metadata(&directory).map_err(fn(error) -> Err("stat {directory.display()}: {error}"))?
        if metadata.file_type().is_symlink() { continue }
        entries :: fs.read_dir(&directory).map_err(fn(error) -> Err("read {directory.display()}: {error}"))?
        loop entry in entries {
            entry :: entry.map_err(fn(error) -> Err("read directory entry: {error}"))?
            path :: entry.path()
            file_type :: entry.file_type().map_err(fn(error) -> Err("stat {path.display()}: {error}"))?
            if file_type.is_symlink() { continue }
            if file_type.is_dir() {
                if is_declared_package_config_dir(&path) || path.file_name().and_then(fn(name) -> name.to_str()).is_some_and(skip_directory) { continue }
                pending.push(path)
            } else if file_type.is_file() && path.extension().and_then(fn(ext) -> ext.to_str()) == Some("jet") {
                relative :: path.strip_prefix(root).map_err(fn(error) -> Err("relative path {path.display()}: {error}"))?.to_str().ok_or_else(fn() -> Err("non-UTF8 corpus path: {path.display()}"))?.to_string()
                out.push(relative)
            }
        }
    }
    Ok(())
}
// Rust: tests/support/corpus_policy.rs:2267
pub fn is_jet_program(path: &OSPath) -> Bool { path.file_name().and_then(fn(name) -> name.to_str()) != Some("package.jet") }
// Rust: tests/support/corpus_policy.rs:2271
pub fn jet_fences(source: &String) -> [String] { markdown_fences(source, "jet") }
// Rust: tests/support/corpus_policy.rs:2275
pub fn shell_fences(source: &String) -> [String] {
    fences := markdown_fences(source, "bash")
    fences.extend(markdown_fences(source, "sh"))
    fences.extend(markdown_fences(source, "shell"))
    fences
}
// Rust: tests/support/corpus_policy.rs:2282
pub fn markdown_fences(source: &String, language: &String) -> [String] {
    fences: [String] := []
    current: String? := None
    opener :: "```{language}"
    loop line in source.lines() {
        trimmed := line.trim() // #4303
        if current.is_none() { if trimmed == opener.as_str() { current = Some(String.new()) } }
        else if trimmed == "```" { fences.push(current.take().unwrap_or_default()) }
        else { match &current { Some(code) -> { code.push_str(line); code.push('\n') }; None -> {} } }
    }
    fences
}
// Rust: tests/support/corpus_policy.rs:2302
pub fn has_jet_run_command(source: &String) -> Bool {
    shell_fences(source).iter().any(fn(fence) -> fence.lines().any(fn(line) -> {
        line := line.trim() // #4303
        if line.is_empty() || line.starts_with('#') { return false }
        words := line.split_whitespace().take_while(fn(word) -> *word != "#")
        loop {
            word :: match words.next() { Some(word) -> word; None -> { break } }
            if word == "jet" && words.next() == Some("run") { return true }
        }
        false
    }))
}
// Rust: tests/support/corpus_policy.rs:2320
pub fn parse_program(source_label: &String, source: &String) -> Program Err! {
    CompilerStack.run_on_compiler_stack(fn() -> {
        (tokens, lexer_diagnostics) :: jet.Lexer.lex(source)
        if !lexer_diagnostics.is_empty() { return Err("Jet lexer rejected corpus source `{source_label}`: {lexer_diagnostics:?}") }
        parse_source :: strip_inline_package(source, &tokens)
        (parse_tokens, parse_diagnostics) :: jet.Lexer.lex(parse_source)
        if !parse_diagnostics.is_empty() { return Err("Jet lexer rejected corpus source `{source_label}`: {parse_diagnostics:?}") }
        jet.Parser.parse(&parse_tokens).map_err(fn(diagnostics) -> Err("Jet parser rejected corpus source `{source_label}`: {diagnostics:?}"))
    })
}
// Rust: tests/support/corpus_policy.rs:2341
pub fn strip_inline_package(source: &String, tokens: &[Token]) -> &String {
    first :: tokens.iter().enumerate().find(fn(pair) -> match &pair.1.kind { .LineComment(_) | .BlockComment(_) -> false; _ -> true })
    (package_index, package_token) :: match first { Some(pair) -> pair; None -> { return source } }
    if !match &package_token.kind { .Ident(name) -> name == "package"; _ -> false } { return source }
    open_index :: match tokens.iter().enumerate().skip(package_index + 1).find_map(fn(pair) -> match &pair.1.kind { .LBrace -> Some(pair.0); _ -> None }) {
        Some(index) -> index
        None -> { return source }
    }
    depth := 0
    loop token in tokens.iter().skip(open_index) {
        match &token.kind {
            .LBrace -> { depth += 1 }
            .RBrace -> { depth = (depth - 1).max(0); if depth == 0 { return &source[token.span.end..] } }
            _ -> {}
        }
    }
    source
}
// Rust: tests/support/corpus_policy.rs:2377
pub fn evaluate_program(manifest: &CorpusManifest, path: &String, row: &SourceRow, program: &Program) -> [SemanticViolation] {
    violations: [SemanticViolation] := []
    aliases :: module_aliases(program)
    expressions :: program_expressions(program)
    statement_facts := StatementFacts.default()
    collect_program_statement_facts(program, &aliases, &statement_facts)
    argv_sites: [Span] := []
    functions: [&Func] := []
    structures: [&StructDef] := []
    loop item in &program.items {
        match item { .Func(function) -> functions.push(function); .Struct(structure) -> structures.push(structure); _ -> {} }
    }
    if applies(manifest, path, row, "first-hour-doc-recipe") && path == "Examples/features/types/typed_literal_forms.jet" {
        match expressions.iter().find(fn(expr) -> is_build_command_literal(expr)) {
            Some(expression) -> violations.push(SemanticViolation.new(path, "first-hour-doc-recipe", site("literal:jet-build", expression.span())))
            None -> {}
        }
    }
    loop expr in &expressions {
        if is_process_input(expr, &aliases) { argv_sites.push(expr.span()) }
        if applies(manifest, path, row, "raw-cli-fixed-shape") && is_process_input(expr, &aliases) { violations.push(SemanticViolation.new(path, "raw-cli-fixed-shape", site("call:process.argv", expr.span()))) }
        if applies(manifest, path, row, "raw-cli-builder-shape") && is_process_argv_view(expr, &aliases) { violations.push(SemanticViolation.new(path, "raw-cli-builder-shape", site("call:process.argv.skip", expr.span()))) }
        if applies(manifest, path, row, "duration-constant-safe") && is_constant_duration_constructor(expr, &aliases) { violations.push(SemanticViolation.new(path, "duration-constant-safe", site("call:Duration.constructor", expr.span()))) }
        if applies(manifest, path, row, "unit-scalar-rewrap") && is_unit_scalar_rewrap(expr, &aliases) { violations.push(SemanticViolation.new(path, "unit-scalar-rewrap", site("call:unit-rewrap", expr.span()))) }
        if applies(manifest, path, row, "readonly-copy") && is_readonly_copy(expr, &aliases) { violations.push(SemanticViolation.new(path, "readonly-copy", site("call:readonly-copy", expr.span()))) }
        if applies(manifest, path, row, "error-identity") && is_identity_fallback(expr, &aliases) { violations.push(SemanticViolation.new(path, "error-identity", site("expr:error-propagation", expr.span()))) }
        if applies(manifest, path, row, "http-wrapper-json") && is_http_ceremony(expr, &functions) { violations.push(SemanticViolation.new(path, "http-wrapper-json", site("call:http-wrapper", expr.span()))) }
        if applies(manifest, path, row, "http-message-text") && is_http_message_text(expr) { violations.push(SemanticViolation.new(path, "http-message-text", site("call:response.text", expr.span()))) }
        if applies(manifest, path, row, "http-typed-json") && is_raw_http_json_body(expr, &functions) { violations.push(SemanticViolation.new(path, "http-typed-json", site("call:request.body", expr.span()))) }
        if applies(manifest, path, row, "delimited-reader-config") && is_raw_delimited_split(expr) { violations.push(SemanticViolation.new(path, "delimited-reader-config", site("call:delimited-split", expr.span()))) }
        if applies(manifest, path, row, "plain-format-fact") && is_redundant_fixed_cleanup(expr) { violations.push(SemanticViolation.new(path, "plain-format-fact", site("call:Fixed.replace", expr.span()))) }
        if applies(manifest, path, row, "dogfood-path-containment") && is_string_prefix_containment(expr) { violations.push(SemanticViolation.new(path, "dogfood-path-containment", site("call:path.starts_with", expr.span()))) }
        if applies(manifest, path, row, "dogfood-json") && is_hand_json_wire(expr) { violations.push(SemanticViolation.new(path, "dogfood-json", site("literal:json-wire", expr.span()))) }
        if applies(manifest, path, row, "dogfood-url-query") && is_url_query_reparse(expr) { violations.push(SemanticViolation.new(path, "dogfood-url-query", site("call:url.query.split", expr.span()))) }
        if applies(manifest, path, row, "dogfood-list-equality") && is_named_list_equality(expr) { violations.push(SemanticViolation.new(path, "dogfood-list-equality", site("fn:same_strings", expr.span()))) }
        if applies(manifest, path, row, "dogfood-directory-setup") && is_non_idempotent_directory_call(expr, &aliases) { violations.push(SemanticViolation.new(path, "dogfood-directory-setup", site("call:fs.create_dir", expr.span()))) }
        if applies(manifest, path, row, "dogfood-ascii") && is_ascii_replacement_chain(expr) { violations.push(SemanticViolation.new(path, "dogfood-ascii", site("call:String.replace", expr.span()))) }
        if applies(manifest, path, row, "crypto-naming-fact") && is_legacy_digest_call(expr, &aliases) { violations.push(SemanticViolation.new(path, "crypto-naming-fact", site("call:crypto.sha256_bytes", expr.span()))) }
    }
    if applies(manifest, path, row, "raw-cli-process-boundary") && argv_sites.len() > 1 {
        loop span in argv_sites.into_iter().skip(1) { violations.push(SemanticViolation.new(path, "raw-cli-process-boundary", site("call:process.argv", span))) }
    }
    if applies(manifest, path, row, "entry-implicit") && program.items.iter().any(fn(item) -> match item { .Func(function) -> function.name == "run"; _ -> false }) {
        span :: program.items.iter().find_map(fn(item) -> match item { .Func(function) if function.name == "run" -> Some(function.span); _ -> None }).unwrap_or(Span { start: 0, end: 0 })
        violations.push(SemanticViolation.new(path, "entry-implicit", site("fn:run", span)))
    }
    if applies(manifest, path, row, "codable-structural") {
        loop structure in structures { if bare_structural_codable(structure) { violations.push(SemanticViolation.new(path, "codable-structural", site("type:{structure.name}", structure.name_span))) } }
    }
    if applies(manifest, path, row, "effect-row-inference") {
        loop function in &functions { if function.name == "run" && redundant_effect_row(function, &aliases) { violations.push(SemanticViolation.new(path, "effect-row-inference", site("fn:{function.name}", function.span))) } }
    }
    if applies(manifest, path, row, "task-one-child") {
        loop (span, is_single_combinator) in statement_facts.task_groups { if is_single_combinator { violations.push(SemanticViolation.new(path, "task-one-child", site("stmt:task.group", span))) } }
    }
    if applies(manifest, path, row, "indexed-sequence") {
        loop span in statement_facts.manual_counter_loops { violations.push(SemanticViolation.new(path, "indexed-sequence", site("loop:manual-counter", span))) }
        loop (span, is_sequence_index) in statement_facts.counted_loops { if is_sequence_index { violations.push(SemanticViolation.new(path, "indexed-sequence", site("loop:counted-sequence", span))) } }
    }
    if applies(manifest, path, row, "datatree-domain-policy") { violations.extend(datatree_domain_policy_violations(path, program)) }
    if applies(manifest, path, row, "walk-files-filter") {
        match statement_facts.file_walks.first().copied() { Some(span) -> violations.push(SemanticViolation.new(path, "walk-files-filter", site("call:fs.walk", span))); None -> {} }
    }
    if applies(manifest, path, row, "regex-capture-recipe") && !has_anchored_regex_capture(program, &aliases) {
        span :: functions.first().map_or(Span { start: 0, end: 0 }, fn(function) -> function.span)
        violations.push(SemanticViolation.new(path, "regex-capture-recipe", site("recipe:regex-capture", span)))
    }
    if applies(manifest, path, row, "http-unused-request") {
        loop function in &functions {
            if function.params.iter().any(fn(parameter) -> match &parameter.ty { .Named(name) -> name == "HTTPRequest" && has_unused_parameter(function, &parameter.name); _ -> false }) {
                violations.push(SemanticViolation.new(path, "http-unused-request", site("param:req", function.span)))
            }
        }
    }
    violations
}
// Rust: tests/support/corpus_policy.rs:2685
pub fn applies(manifest: &CorpusManifest, path: &String, row: &SourceRow, rule: &String) -> Bool {
    if !semantic_role(row.role) { return false }
    if ["raw-cli-fixed-shape", "raw-cli-builder-shape"].contains(rule) && !["typed-cli", "typed-cli-doc"].contains(row.profile.as_str()) { return false }
    manifest.scopes.iter().any(fn(scope) -> scope.rule == rule && selector_matches(&scope.selector, path))
}
// Rust: tests/support/corpus_policy.rs:2700
pub fn maintained_guidance_lint(name: &String) -> Bool {
    ["process_args_view", "message_text", "redundant_fixed_cleanup", "unit_scalar_rewrap", "path_containment_string_prefix", "complete_ascii_case_ladder", "walk_files_filter"].contains(name)
}
// Rust: tests/support/corpus_policy.rs:2713
pub fn redundant_effect_row(function: &Func, aliases: &[String:String]) -> Bool {
    declared :: match function.declared_effects.as_ref() { Some(declared) -> declared; None -> { return false } }
    if declared.is_empty() { return false }
    inferred := BTreeSet<String>.new()
    for_each_statement_expr(&function.body, fn(expr) -> { match expression_effect(expr, aliases) { Some(effect) -> { _ :: inferred.insert(effect) }; None -> {} } })
    !inferred.is_empty() && declared.iter().all(fn(pair) -> inferred.iter().any(fn(effect) -> effect.eq_ignore_ascii_case(pair.0))) && inferred.len() == declared.len()
}
// Rust: tests/support/corpus_policy.rs:2735
pub fn expression_effect(expr: &Expr, aliases: &[String:String]) -> String? {
    match expr.without_parens() {
        .Call(call) -> {
            if ["print", "println", "eprint", "eprintln"].contains(call.name.as_str()) { return Some("IO") }
            (module, _) :: match call.name.rsplit_once('.') { Some(pair) -> pair; None -> { return None } }
            effect_for_module(module, aliases)
        }
        .MethodCall { receiver, .. } -> {
            module :: match receiver.without_parens() { .Ident(name, _) -> name.as_str(); _ -> { return None } }
            effect_for_module(module, aliases)
        }
        _ -> None
    }
}
// Rust: tests/support/corpus_policy.rs:2758
pub fn effect_for_module(module: &String, aliases: &[String:String]) -> String? {
    resolved :: aliases.get(module).map(fn(value) -> value.as_str()).unwrap_or(module)
    match resolved {
        "core.files" | "core.fs" -> Some("FS")
        "core.process" | "core.exec" -> Some("Exec")
        "core.time" -> Some("Time")
        "core.net" | "core.net.url" | "core.http" | "core.http.client" -> Some("Net")
        "core.io" -> Some("IO")
        _ -> None
    }
}
// Rust: tests/support/corpus_policy.rs:2770
pub fn module_aliases(program: &Program) -> [String:String] {
    program.imports.iter().filter_map(fn(import) -> import.core_module_path().map(fn(module) -> (import.import_alias(), module))).collect()
}
// Rust: tests/support/corpus_policy.rs:2782
pub fn counted_loop_indexes_sequence(init: &Binding, body: &[Stmt]) -> Bool {
    indexes_sequence := false
    for_each_statement_expr(body, fn(expr) -> {
        match expr.without_parens() { .Index { index, .. } -> { if match index.without_parens() { .Ident(name, _) -> name == &init.name; _ -> false } { indexes_sequence = true } }; _ -> {} }
    })
    indexes_sequence
}
// Rust: tests/support/corpus_policy.rs:2794
pub fn manual_counter_body(counter: &String, body: &[Stmt]) -> Bool {
    increments := 0
    used := false
    loop statement in body {
        if match statement {
