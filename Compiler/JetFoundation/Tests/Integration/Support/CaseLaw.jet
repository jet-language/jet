//RS /// D-CASE-PROSE1=A governs the FIRST thing on the line and nothing after it.
//RS /// A line opening with a quoted fragment, a `{placeholder}`, a flag, or an
//RS /// identifier keeps that fragment's own case and is never force-capitalised —
//RS /// the ratified sample reads ``\`--offline\` forbids network access``, with
//RS /// `forbids` staying lowercase. So this deliberately does NOT reuse
//RS /// `first_diagnostic_prose_token`, which skips code-ish tokens and walks on:
//RS /// that would capitalise a word in the middle of the sentence.
//RS pub(crate) fn sentence_case_violation(value: &str) -> Option<String> {
//RS     let mut offset = 0;
//RS     let ch = loop {
//RS         let ch = value[offset..].chars().next()?;
