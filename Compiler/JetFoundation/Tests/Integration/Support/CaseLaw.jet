// Shared enforcement for the ratified UI case law.
use jet.[CLI, Help, REPL]
use jet_foundation.[Registry, Syntax, CoreModuleExports, Collections]

// Rust: tests/support/case_law.rs:3
pub enum CaseLawKind { Sentence, Title, Excluded }
// Rust: tests/support/case_law.rs:10
pub struct CaseLawSource { name: String, value: String, kind: CaseLawKind }

// Rust: tests/support/case_law.rs:20
// D-CASE-CHROME1=C / D-CASE-PROSE1=A: collect strings from live producers.
pub fn assert_user_facing_case_law() -> {
    sources :: user_facing_case_sources()
    violations :: case_law_violations(&sources)
    assert(violations.is_empty(), "ratified UI case-law violations (D-CASE-CHROME1/D-CASE-PROSE1):\n{violations.join("\n")}")
}
// Rust: tests/support/case_law.rs:30
pub fn case_law_violations(sources: &[CaseLawSource]) -> [String] {
    sources.iter().filter_map(fn(source) {
        violation :: source.kind == {
            .Sentence -> sentence_case_violation(source.value)
            .Title -> title_case_violation(source.value)
            .Excluded -> None
        }
        violation.map(fn(text) { "{source.name}: {text}" })
    }).collect()
}
// Rust: tests/support/case_law.rs:44
pub fn user_facing_case_sources() -> [CaseLawSource] {
    sources := [CaseLawSource]{}
    add :: (name: String, value: String, kind: CaseLawKind) -> push_source(&sources, name, value, kind)
    // Diagnostics.jet is the one diagnostic home; all renderers use its projection.
    loop (line_index, raw) in Registry.DIAGNOSTIC_SOURCE.lines().enumerate() {
        line := raw.trim() // #4303
        if line.is_empty() || line.starts_with("//") -> next
        fields :: line.split('\t').collect()
        if fields.first() != Val("diagnostic") -> next
        loop (field, index) in [("meaning", 6), ("What", 7), ("Why", 8), ("Fix", 9)] {
            if fields.get(index) == Val(value) {
                add("Diagnostics.jet:{line_index + 1} {fields[1]} {field}", value, .Sentence)
            }
        }
    }
    loop command in CLI.COMMANDS {
        add("CLI command {command.name} summary", command.summary, .Sentence)
        loop action in command.actions {
            add("CLI {command.name} {action.name} summary", CLI.action_help_summary(command.name, action), .Sentence)
        }
    }
    loop group in CLI.command_groups() {
        add("CLI {group.name} group label", CLI.command_group_label(group.name), .Title)
    }
    loop flag in CLI.FLAGS.iter() { add("CLI {flag.long} help", flag.help, .Sentence) }
    loop (line_index, raw) in CLI.usage_page("1.0.0", CLI.HelpOrder.Frequency).lines().enumerate() {
        line := raw.trim() // #4303
        if line_index == 0 { add("CLI usage greeting", line, .Sentence) }
        else if line == "Usage:" || line == "Flags:" {
            add("CLI usage header {line}", line.trim_end_matches(':'), .Title)
        } else if line.strip_suffix(" Commands:") == Val(label) {
            add("CLI usage group header {label}", label, .Title)
        }
    }
    loop category in Help.CATEGORIES { add("help category {category}", category, .Title) }
    loop entry in Help.build_index() {
        add("help {entry.symbol.name} summary", entry.symbol.summary, .Sentence)
        loop (flag, help) in entry.flags { add("help {flag} description", help, .Sentence) }
    }
    repl_help :: REPL.run_transcript([":help"], None)
    loop (line_index, raw) in repl_help.lines().enumerate() {
        line := raw.trim() // #4303
        if line.is_empty() -> next
        if line_index == 0 || line == "Interactive terminal only" {
            add("REPL help heading {line}", line, .Title)
        } else if line.strip_prefix("Tip: ") == Val(tip) {
            add("REPL help tip {tip}", tip, .Sentence)
        } else if line.split_once("  ") == Val((_, description)) {
            add("REPL help line {line_index}", description.trim(), .Sentence)
        }
    }
    banner :: REPL.Render.render_banner("1.0.0", false)
    if banner.strip_prefix("Jet 1.0.0 — ") == Val(text) {
        add("REPL banner description", text.split_once("  (").map_or(text, fn((text, _)) { text }), .Sentence)
    }
    loop (mode, hint) in [("raw", REPL.Render.render_discovery_hint(true, false)), ("cooked", REPL.Render.render_discovery_hint(false, false))] {
        loop part in hint.strip_prefix("Try: ").unwrap_or(hint).split(" · ") {
            if part.to_ascii_lowercase().starts_with("interactive keys") {
                add("REPL {mode} discovery status {part}", part, .Title)
                next
            }
            text :: part.split_once(' ').map_or(part, fn((_, description)) { description })
            // One- or two-word hints in the key bar are labels, not descriptions.
            add("REPL {mode} discovery hint {text}", text, .Title)
        }
    }
    prompt :: REPL.Render.render_prompt(1, false)
    add("REPL prompt", prompt.trim(), .Excluded)
    // Mid-line fragments and literal command names keep their spelling.
    fold :: REPL.Render.render_fold_marker(42, "Row", false)
    add("REPL fold status", fold.strip_prefix("⋯ 42 ").and_then(fn(text) { text.split(" · ").next() }).unwrap_or_default(), .Excluded)
    add("REPL fold action", fold.split(" · ").nth(2).unwrap_or_default().split(' ').next().unwrap_or_default(), .Excluded)
    pin :: REPL.Render.render_pin_rail("total: Int :: 15", 3, 62, false)
    if pin.lines().next().and_then(fn(line) { line.split("turn 3").nth(1) }) == Val(hint) {
        add("REPL pin status", "turn", .Excluded)
        add("REPL pin action", hint.split('·').nth(1).unwrap_or_default().trim().split(' ').next().unwrap_or_default(), .Excluded)
    }
    // The machine-readable status also feeds the notebook JSON and wire protocol.
    loop line in REPL.run_transcript(["1 + 2", ":turns"], None).lines() {
        if line.starts_with('#') {
            if line.split_once(' ').and_then(fn((_, rest)) { rest.split_once("  ").map(fn((status, _)) { status }) }) == Val(status) {
                add("REPL status {status}", status, .Excluded)
            }
        }
    }
    empty_turns :: REPL.run_transcript([":turns"], None)
    if empty_turns.lines().find(fn(line) { !line.trim().is_empty() }) == Val(status) {
        add("REPL empty-turn status", status.trim(), .Sentence)
    }
    collect_help_render_sources(&sources)
    sources
}

// Rust: tests/support/case_law.rs:307
// Check chrome from emitted frames, not a duplicated test-only literal table.
fn collect_help_render_sources(sources: &[CaseLawSource]) -> {
    index :: Help.build_index()
    categorized :: Help.Render.render_categorized(&index, 0, true, Val("run"), 72, false, None)
    categorized_lines :: categorized.lines().collect()
    title :: frame_title(categorized_lines.first().unwrap_or_default())
        .and_then(fn(title) { title.strip_prefix("jet ? — ").or(Val(title)) })
        .expect("categorized help must have a frame title")
    push_source(sources, "help categorized frame title", title, .Title)
    hint :: panel_line(categorized_lines.get(1).expect("categorized help must have a search hint"))
        .expect("categorized help search hint must be a panel row")
    push_source(sources, "help categorized search hint", hint, .Sentence)
    loop raw in categorized_lines {
        line :: panel_line(raw) ?? next
        if line.strip_prefix("▾ ").or_else(fn() { line.strip_prefix("▸ ") }) == Val(category) {
            push_source(sources, "help categorized category {category}", category, .Title)
        }
    }
    error_category :: Help.CATEGORIES.iter().position(fn(category) { category == "Error Codes" })
        .expect("hybrid help must retain its error-code category")
    error_view :: Help.Render.render_categorized(&index, error_category, true, None, 72, false, None)
    error_tip :: error_view.lines().filter_map(panel_line).find(fn(line) { !line.starts_with("▾ ") && !line.starts_with("▸ ") })
        .expect("expanded error-code help must have its explanatory row")
    push_source(sources, "help error-code tip", error_tip, .Sentence)
    hits :: Help.search(&index, "run")
    results :: Help.Render.render_result_list(&hits, "run", 72, false, None, None)
    result_lines :: results.lines().collect()
    title :: frame_title(result_lines.first().unwrap_or_default()).expect("help results must have a frame title")
    push_source(sources, "help result frame title", title, .Title)
    footer :: result_lines.iter().rev().filter_map(panel_line).next().expect("help results must have a footer")
    push_source(sources, "help result footer", footer, .Sentence)
    if hits.first().and_then(fn(hit) {
        hit == { .Command(entry: entry, ..) -> entry.symbol.examples.first(); .Code(_) -> None }
    }) == Val(example) {
        example_line :: result_lines.iter().filter_map(panel_line).find(fn(line) { line.ends_with(example) })
            .expect("help result with an example must render its example row")
        label :: example_line.strip_suffix(example).map(fn(text) { text.trim() }).filter(fn(label) { !label.is_empty() })
            .expect("help example row must have a label")
        push_source(sources, "help result example label", label, .Title)
    }
    detail_entry :: index.iter().find(fn(entry) { entry.symbol.name == "run" }).expect("hybrid help must contain the run command")
    detail :: Help.Render.render_detail(detail_entry, 72, false)
    detail_lines :: detail.lines().collect()
    title :: frame_title(detail_lines.first().unwrap_or_default()).expect("help detail must have a frame title")
    collapse :: title.rsplit_once("⇥ ").map(fn((_, label)) { label }).expect("help detail frame title must have a collapse label")
    push_source(sources, "help detail collapse label", collapse, .Title)
    if detail_lines.get(1).and_then(panel_line) == Val(line) {
        label :: line.split_once("   ").map(fn((label, _)) { label.trim() }).filter(fn(label) { !label.is_empty() })
            .expect("help detail usage row must have a label")
        push_source(sources, "help detail usage label", label, .Title)
    }
    // Join once, preserving the Rust output while avoiding per-row allocation.
    see_also :: detail_entry.see_also.join(" · ")
    loop raw in detail_lines {
        line :: panel_line(raw) ?? next
        if line.split_once("   ") == Val((label, rest)) {
            label := label.trim() // #4303
            is_flag_row :: line.contains("(none)") || detail_entry.flags.iter().any(fn((flag, _)) { rest.trim_start().starts_with(flag) })
            if is_flag_row && !label.is_empty() { push_source(sources, "help detail flags label", label, .Title) }
        }
        if detail_entry.symbol.examples.first() == Val(example) {
            if line.ends_with(example) {
                label :: line.strip_suffix(example).map(fn(text) { text.trim() }).filter(fn(label) { !label.is_empty() })
                    .expect("help detail example row must have a label")
                push_source(sources, "help detail example label", label, .Title)
            }
        }
        if !see_also.is_empty() && line.ends_with(see_also) {
            label :: line.strip_suffix(see_also).map(fn(text) { text.trim() }).filter(fn(label) { !label.is_empty() })
                .expect("help detail see-also row must have a label")
            push_source(sources, "help detail see-also label", label, .Title)
        }
    }
    footer :: detail_lines.iter().rev().filter_map(panel_line).next().expect("help detail must have a footer")
    push_source(sources, "help detail footer", footer, .Sentence)
    reference :: Help.Render.render_reference(&index, 0, Val(detail_entry), 80, 12, false, "run")
    reference_lines :: reference.lines().collect()
    header := reference_lines.first().unwrap_or_default().trim() // #4303
    reference_label :: header.strip_prefix("jet ? ").and_then(fn(header) { header.split_once(" · Search:").map(fn((label, _)) { label }) })
        .expect("help reference must have a reference title")
    push_source(sources, "help reference title", reference_label, .Title)
    search_label :: header.split_once(" · ").and_then(fn((_, search)) { search.split_once(':').map(fn((label, _)) { label }) })
        .map(fn(text) { text.trim() }).filter(fn(label) { !label.is_empty() }).expect("help reference must have a search label")
    push_source(sources, "help reference search label", search_label, .Title)
    footer :: reference_lines.last().map(fn(text) { text.trim() }).filter(fn(line) { !line.is_empty() }).expect("help reference must have a footer")
    push_source(sources, "help reference footer", footer, .Sentence)
    empty_reference :: Help.Render.render_reference(&index, 0, None, 80, 12, false, "")
    empty_body :: empty_reference.lines().nth(1).expect("empty help reference must have a body row")
    empty_message :: empty_body.split('│').nth(2).map(fn(text) { text.trim() }).filter(fn(line) { !line.is_empty() })
        .expect("empty help reference must have its empty-state message")
    push_source(sources, "help reference empty state", empty_message, .Sentence)
    no_match_output :: Help.run_query("zzzznonsense", false)
    no_match :: no_match_output.lines().next().map(fn(text) { text.trim() }).filter(fn(line) { !line.is_empty() })
        .expect("help no-match query must have a message")
    push_source(sources, "help no-match message", no_match, .Sentence)
    symbol_help :: Help.run_query("List.len", false)
    loop line in symbol_help.lines().skip(2) {
        if line.split_once(": ") == Val((label, _)) { push_source(sources, "help symbol lookup label", label, .Title) }
    }
}

// Rust: tests/support/case_law.rs:589
fn push_source(sources: &[CaseLawSource], name: String, value: String, kind: CaseLawKind) -> {
    sources.push(CaseLawSource(name: name, value: value.to_string(), kind: kind))
}
// Rust: tests/support/case_law.rs:602
fn panel_line(line: String) -> String? {
    line.strip_prefix('│').and_then(fn(line) { line.strip_suffix('│') }).map(fn(text) { text.trim() })
}
// Rust: tests/support/case_law.rs:608
fn frame_title(line: String) -> String? {
    line.strip_prefix("┌─ ").and_then(fn(line) { line.rsplit_once(" ─").map(fn((title, _)) { title }) })
}

// Rust: tests/support/case_law.rs:620
// Only the FIRST token is governed: quoted fragments and identifiers retain case.
pub fn sentence_case_violation(value: String) -> String? {
    offset := 0
    ch := value.chars().next() ?? return None
    loop {
        ch = value[offset..].chars().next() ?? return None
        if ch.is_whitespace() || ch == '*' || ch == '~' || ch == '_' {
            offset += ch.len_utf8()
            next
        }
        break
    }
    if ch == '`' || ch == '"' || ch == '\'' || ch == '{' -> return None
    rest := value[offset..] // #4303: byte-indexed UTF-8 view
    end :: rest.find(fn(c) { c.is_whitespace() || [',', ';', ':', '(', ')', '[', ']', '!'].contains(c) }).unwrap_or(rest.len())
    token := rest[..end] // #4303
    if token.is_empty() || diagnostic_token_keeps_case(token) -> return None
    if token.chars().next().is_some_and(fn(c) { c.is_ascii_lowercase() }) {
        return Val("sentence prose starts with lowercase `{token}` at byte {offset} in {value:?}")
    }
    None
}
// Rust: tests/support/case_law.rs:653
pub fn title_case_violation(value: String) -> String? {
    // A metavariable keeps the spelling the user must type.
    if value.starts_with('<') && value.ends_with('>') -> return None
    words :: value.split(fn(ch) { !ch.is_ascii_alphanumeric() }).filter(fn(word) { !word.is_empty() }).collect()
    loop (index, word) in words.iter().enumerate() {
        lower :: word.to_ascii_lowercase()
        minor :: title_case_minor_word(lower)
        is_first_or_last :: index == 0 || index + 1 == words.len()
        if minor && !is_first_or_last {
            if word != lower -> return Val("minor word `{word}` must stay lowercase in {value:?}")
        } else if word.chars().next().is_some_and(fn(character) { character.is_ascii_lowercase() }) {
            return Val("word `{word}` must start uppercase in {value:?}")
        }
    }
    None
}
// Rust: tests/support/case_law.rs:687
pub TITLE_CASE_MINOR_WORDS :: [String]{"a", "an", "the", "and", "but", "or", "nor", "for", "as", "at", "by", "in", "of", "on", "to", "via"}
// Rust: tests/support/case_law.rs:692
fn title_case_minor_word(word: String) -> Bool { TITLE_CASE_MINOR_WORDS.contains(word) }

// Rust: tests/support/case_law.rs:700
pub fn first_diagnostic_prose_token(input: String) -> (USize, USize)? {
    offset := 0
    loop offset < input.len() {
        rest := input[offset..] // #4303
        ch :: rest.chars().next() ?? return None
        if ch.is_whitespace() || ch == '*' || ch == '~' || ch == '_' {
            offset += ch.len_utf8()
            next
        }
        if ch == '`' || ch == '"' || ch == '\'' {
            after := rest[ch.len_utf8()..] // #4303
            if after.find(ch) == Val(close) {
                offset += ch.len_utf8() + close + ch.len_utf8()
                next
            }
        }
        if ch == '{' {
            if rest.find('}') == Val(close) { offset += close + 1; next }
        }
        start :: offset
        end := 0
        loop end < rest.len() {
            value :: rest[end..].chars().next().expect("diagnostic token index is on a character boundary")
            if end > 0 && (value.is_whitespace() || [',', ';', ':', '(', ')', '[', ']', '!'].contains(value)) -> break
            if value == '.' {
                next_char :: rest[end + value.len_utf8()..].chars().next()
                if next_char.is_none_or(fn(next_char) { next_char.is_whitespace() || [',', ';', ':', '(', ')', '[', ']', '!'].contains(next_char) }) && end > 0 -> break
            }
            end += value.len_utf8()
        }
        token_end :: offset + end
        token := input[start..token_end] // #4303
        if token.is_empty() { offset += ch.len_utf8(); next }
        offset = token_end
        if diagnostic_token_keeps_case(token) -> next
        return Val((start, token_end))
    }
    None
}
// Rust: tests/support/case_law.rs:762
pub fn diagnostic_token_keeps_case(token: String) -> Bool {
    if Syntax.JET_KEYWORD_LIST.contains(token) || Syntax.JET_TYPE_LIST.contains(token)
        || CoreModuleExports.is_core_type_name(token) || Collections.is_reserved_type(token)
        || token.chars().next().is_some_and(fn(ch) { ch == '-' || ch == '#' || ch == '@' })
        || token == "C"
        || ["App", "Hangar", "Jet", "Jetpack", "Nix", "Runtime", "Store", "jet", "jetpack", "cargo", "nix", "git", "rustc"].contains(token) -> return true
    has_digit :: token.chars().any(fn(ch) { ch.is_ascii_digit() })
    has_structural_case :: token.chars().any(fn(ch) { ['_', '/', '\\', '@', '#', '.'].contains(ch) })
    all_code :: token.chars().all(fn(ch) { ch.is_ascii_uppercase() || ch.is_ascii_digit() || ch == '-' || ch == '_' })
    camel_case :: token.chars().next().is_some_and(fn(ch) { ch.is_ascii_uppercase() }) && token.chars().skip(1).any(fn(ch) { ch.is_ascii_uppercase() })
    has_digit || has_structural_case || all_code || camel_case || token.starts_with("C-")
}
