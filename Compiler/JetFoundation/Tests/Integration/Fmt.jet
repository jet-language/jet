// M6 phase 1: real formatter idempotence, fmt(fmt(x)) == fmt(x).
use jet.[format_source, render_diagnostics, Syntax]
use std.fs

// Rust: tests/fmt.rs:377
pub fn collect_jet_files(dir: &OSPath) -> [OSPath] {
    // GATE #4494: actual filesystem directory entries.
    mut out: [OSPath] = []
    for entry in fs.read_dir(dir).unwrap() {
        path := entry.unwrap().path()
        if path.extension().and_then(|e| -> e.to_str()) == Some(Syntax.FILE_EXT) { out.push(path) }
    }
    out.sort()
    out
}
// Rust: tests/fmt.rs:1775
// D-FMT1: fitting single-statement control bodies may collapse; comments and
// nested/wide bodies remain braced. Compare actual formatter passes.
pub fn assert_fmt_stable(src: String, label: String) -> {
    out := format_source(src).unwrap_or_else(|d| -> panic("fmt failed for {label}:\n{render_diagnostics(label, src, &d)}"))
    twice := format_source(out).expect("second fmt should succeed")
    assert_eq(out, twice, "{label}: fmt is not idempotent\n--- once ---\n{out}")
}
