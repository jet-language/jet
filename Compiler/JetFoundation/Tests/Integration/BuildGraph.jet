use jet_comptime.Comptime.Build as build
use jet_comptime.Comptime.Build.[BuildPlan, BuildCapability, FrontEndCompletion, RemoteBuildBinding, BuildExecutionResult, BuildExecutionError, CompilerActionRunner, RemoteCacheTransport, RemoteCachePolicy, ContentDigest]
use jet_driver.Driver.BuildArtifactStoreHandle
use core.path.OSPath
use std.collections.BTreeSet
use std.sync.Mutex

// Rust: tests/build_graph.rs:27
pub fn test_artifact_store(root: &OSPath) -> BuildArtifactStoreHandle {
    BuildArtifactStoreHandle.at(root.join(".jet-store")).expect("open test artifact store")
}

// Rust: tests/build_graph.rs:31
pub fn execute_build_plan_with_front_end_and_remote(plan: &BuildPlan, project_root: &OSPath, grants: &BTreeSet<BuildCapability>, front_end: FrontEndCompletion, remote_binding: RemoteBuildBinding?) -> BuildExecutionResult BuildExecutionError! {
    artifact_store :: test_artifact_store(project_root)
    build.execute_build_plan_with_front_end_and_remote(plan, project_root, &artifact_store, grants, front_end, remote_binding)
}

// Rust: tests/build_graph.rs:49
pub fn execute_build_plan_with_front_end_and_compiler(plan: &BuildPlan, project_root: &OSPath, grants: &BTreeSet<BuildCapability>, front_end: FrontEndCompletion, runner: &CompilerActionRunner) -> BuildExecutionResult BuildExecutionError! {
    artifact_store :: test_artifact_store(project_root)
    build.execute_build_plan_with_front_end_and_compiler(plan, project_root, &artifact_store, grants, front_end, runner)
}

// Rust: tests/build_graph.rs:68
// GATE #4494: real native mutex serializes process-global environment mutation.
pub static REMOTE_HOST_ENV_LOCK: Mutex<Unit> = Mutex.new(())

// Rust: tests/build_graph.rs:70
pub fn remote_empty_log_digests(transport: &RemoteCacheTransport, policy: &RemoteCachePolicy) -> (ContentDigest, ContentDigest) {
    (transport.upload_execution_blob("".bytes(), policy).unwrap(), transport.upload_execution_blob("".bytes(), policy).unwrap())
}
