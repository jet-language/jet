use jet_foundation.Tests.Integration.SyntaxReconciliation.*
use jet.[Syntax, Lexer, Parser, Policy, compile]
use jet.Comptime.Build.[BuildCapability, BuildResourcePool]
use std.fs
// GATE #4494: tests inspect real repository files through the native filesystem.

// Rust: tests/syntax_reconciliation.rs:11
#Test("identifier_prefix_contract_is_canonical") {
    assert_eq(Syntax.classify_identifier("name"), Syntax.IdentifierClass.Ordinary)
    assert_eq(Syntax.classify_identifier("_name"), Syntax.IdentifierClass.SoftPublic)
    assert_eq(Syntax.classify_identifier("_name_"), Syntax.IdentifierClass.SoftPublic)
    assert_eq(Syntax.classify_identifier("__name"), Syntax.IdentifierClass.Reserved)
    assert_eq(Syntax.classify_identifier("__name__"), Syntax.IdentifierClass.Reserved)
    assert_eq(Syntax.classify_identifier("__"), Syntax.IdentifierClass.Reserved)
    assert_eq(Syntax.classify_identifier("_"), Syntax.IdentifierClass.Ordinary)
}
// Rust: tests/syntax_reconciliation.rs:24
#Test("every_double_underscore_source_identifier_is_rejected") {
    source :: "\nmodule __module\nuse thing as __alias\nextern c {{ fn __ffi(__ffi_arg: Int) }}\nfn __call(__arg: Int) {{\n    __local :: __arg\n    value.__field\n}}\ntrait Contract {{ fn __method(self) }}\n"
    (_, diagnostics) :: Lexer.lex(source)
    reserved :: diagnostics.iter().filter(fn(diagnostic) { diagnostic.code == "E0067" }).count()
    assert_eq(reserved, 10, "{diagnostics:#?}")
}
// Rust: tests/syntax_reconciliation.rs:44
#Test("compiler_generated_identifiers_use_the_reserved_lane") {
    source :: "fn __jet_generated() {{ print(\"{{__jet_value}}\") }}"
    (_, user_diagnostics) :: Lexer.lex(source)
    (tokens, generated_diagnostics) :: Lexer.lex_generated(source)
    assert(user_diagnostics.iter().any(fn(diagnostic) { diagnostic.code == "E0067" }))
    assert(generated_diagnostics.is_empty(), "{generated_diagnostics:#?}")
    assert(Parser.parse(&tokens).is_ok())
}
// Rust: tests/syntax_reconciliation.rs:59
#Test("generated_symbol_ladder_has_one_canonical_prefix") {
    assert_eq(Syntax.generated_name("lambda_7"), "__jet_lambda_7")
    assert_eq(Syntax.generated_path("scoring.letter"), "__jet_scoring__letter")
    assert_eq(Syntax.generated_suffix("__jet_lambda_7"), "lambda_7")
}
// Rust: tests/syntax_reconciliation.rs:68
#Test("compiler_user_visible_enums_obey_acronym_lexicon") {
    // Rust: tests/syntax_reconciliation.rs:72
    fn assert_variants(enum_name: String, variants: &[(String, String, String, String)]) -> {
        loop (retired, canonical, rendered, expected) in variants {
            assert_eq(Syntax.respell_acronym_name(retired), canonical, "{enum_name} variant `{retired}` has no canonical acronym respell")
            assert_eq(Syntax.respell_acronym_name(canonical), canonical, "{enum_name} canonical variant `{canonical}` is still retired")
            assert_eq(rendered, expected, "{enum_name} variant `{canonical}` renders the wrong user-visible word")
        }
    }
    assert_variants("BuildCapability", &[("Fs", "FS", BuildCapability.FS.name(), "FS"), ("Io", "IO", BuildCapability.IO.name(), "IO"), ("Db", "DB", BuildCapability.DB.name(), "DB"), ("Gpu", "GPU", BuildCapability.GPU.name(), "GPU")])
    assert_variants("BuildResourcePool", &[("Cpu", "CPU", BuildResourcePool.CPU.as_str(), "cpu"), ("Gpu", "GPU", BuildResourcePool.GPU.as_str(), "gpu")])
}
// Rust: tests/syntax_reconciliation.rs:187
#Test("live_surface_has_no_retired_spellings") {
    failures := [String]{}
    loop root in ROOTS {
        loop path in files(&OSPath(root)) {
            if should_skip(&path) -> next
            text :: fs.read_to_string(&path) ?? next
            loop (line_no, line) in scan_lines(&path, text) {
                loop needle in forbidden_for_path(&path) {
                    if forbidden_occurs(line, needle) { failures.push("{path.display()}:{line_no} contains `{needle}`") }
                }
            }
        }
    }
    assert(failures.is_empty(), "retired syntax found:\n{failures.join("\n")}")
}
