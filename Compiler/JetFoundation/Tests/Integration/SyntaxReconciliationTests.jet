// Rust: tests/syntax_reconciliation.rs:443
#Test("ratified_unshipped_spellings_are_listed_and_triaged") {
    reference :: fs.read_to_string("Docs/spec/reference/syntax-surface.jet").expect("read syntax reference")
    spec :: fs.read_to_string("Docs/spec/syntax-decisions.md").expect("read syntax decisions")
    expected := ratified_reference_gap_ids(reference)
    loop id in ["S74", "D-ONCE-UITREE1"] { expected.insert(id, true) }
    listed := [String: Bool]{}
    loop (id, _, _, _, _) in RATIFIED_UNSHIPPED_SPELLINGS { listed.insert(id, true) }
    assert_eq(listed, expected, "ratified unshipped spelling inventory drifted; add or retire the row before changing the spec")
    loop (id, spelling, home, anchor, disposition) in RATIFIED_UNSHIPPED_SPELLINGS {
        source :: if home == "Docs/spec/syntax-decisions.md" -> spec else -> reference
        assert(source.contains(anchor), "{id} ({spelling}) has no source evidence in {home}: {anchor}")
        assert(disposition.contains("card #") && (disposition.contains("retired") || disposition.contains("deferred") || disposition.contains("tracked")), "{id} ({spelling}) has no card-backed disposition: {disposition}")
    }
    (tokens, lex_diags) :: Lexer.lex("fn run() {{ .Ok(age) :: parse_age() ?? return }}\n")
    assert(lex_diags.is_empty(), "retired S74 spelling should lex before parser rejection: {lex_diags:#?}")
    assert(Parser.parse(&tokens).is_err(), "retired S74 spelling gained a parser path")
    (tokens, _) :: Lexer.lex("fn run() {{ tree :: .Button.{{ label: \"OK\" }} }}\n")
    assert(Parser.parse(&tokens).is_err(), "ratified-but-unbuilt UI dot-construction gained a parser path")
}
// Rust: tests/syntax_reconciliation.rs:506
#Test("syntax_status_matrix_covers_unbuilt_notes") {
    // FEATURE_CLAIM: claim.syntax-law / syntax-matrix
    spec :: fs.read_to_string("Docs/spec/syntax-decisions.md").expect("read syntax decisions")
    assert(spec.contains("A ratified entry may sit unbuilt **only** when gated on"))
    lines :: spec.lines().collect()
    uncovered := [String]{}
    loop (idx, line) in lines.iter().enumerate() {
        lower :: line.to_ascii_lowercase()
        if !(lower.contains("unbuilt") || lower.contains("not yet implemented")) -> next
        if idx < 20 || lower.contains("have/have-not ledger") -> next
        if !lower.contains("ratified") && !lower.contains("not yet implemented") -> next
        start := idx
        loop start > 0 && !lines[start - 1].trim().is_empty() { start -= 1 }
        end := idx + 1
        loop end < lines.len() && !lines[end].trim().is_empty() { end += 1 }
        context :: lines[start..end].join("\n")
        if !(context.contains("card #") || context.contains("cards #")) { uncovered.push("{idx + 1}: {line.trim()}") }
    }
    assert(uncovered.is_empty(), "unbuilt syntax note lacks a live card gate:\n{uncovered.join("\n")}")
}
// Rust: tests/syntax_reconciliation.rs:549
#Test("environment_reference_is_canonical_and_navigable") {
    reference :: fs.read_to_string(ENVIRONMENT_REFERENCE).expect("read canonical environment-variable reference")
    docs_index :: fs.read_to_string("Docs/README.md").expect("read docs index")
    assert(docs_index.contains("reference/environment.md"), "docs index must link the canonical environment-variable reference")
    loop required in ["JET_PROP_SEED", "JET_RAYLIB_DISPLAY", "JET_UI_HEADLESS", "JET_ENV_DISABLE", "JET_TEST_JOBS", "JET_CANVAS_PREREQUISITES", "## Naming convention"] {
