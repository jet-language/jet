// Rust: tests/syntax_reconciliation.rs:232
#Test("dynamic_encoding_surface_uses_datatree_name") {
    failures := [String]{}
    loop relative in DATATREE_NORMATIVE_SURFACES {
        text :: fs.read_to_string(relative).unwrap_or_else(fn(error) { panic("cannot read DataTree inventory surface {relative}: {error}") })
        markdown :: OSPath(relative).extension().is_some_and(fn(ext) { ext == "md" })
        if markdown {
            loop (line_no, line) in markdown_data_name_lines(text) {
                if !historical_data_reference(line) { failures.push("{relative}:{line_no}: {line.trim()}") }
            }
        } else {
            loop offset in source_identifier_offsets(text, "Data") {
                line_no :: text[..offset].bytes().filter(fn(byte) { byte == U8{10} }).count() + 1
                line :: text.lines().nth(line_no - 1).unwrap_or("")
                failures.push("{relative}:{line_no}: {line.trim()}")
            }
        }
    }
    assert(failures.is_empty(), "current dynamic-encoding surfaces must use `DataTree`; label historical `Data` references explicitly:\n{failures.join("\n")}")
}
// Rust: tests/syntax_reconciliation.rs:263
#Test("datatree_name_check_distinguishes_prose_and_type_names") {
    loop lawful in ["| `conn.send_text(text)` | Data frames; client frames are masked |", "| Data ownership | Official UCD inputs are checked in. |"] {
        assert(markdown_data_name_lines(lawful).is_empty())
    }
    loop prohibited in ["`Data.Object`", "`[Data]`", "`Data?`"] { assert_eq(markdown_data_name_lines(prohibited).len(), 1) }
    tilde_fence :: "~~~jet\nvalue: Data\n~~~"
    assert_eq(markdown_data_name_lines(tilde_fence)[0].0, 2)
    four_tick_fence :: "````jet\nvalue: Data\n```\nother: Data\n````"
    assert_eq(markdown_data_name_lines(four_tick_fence).iter().map(fn((line_no, _)) { line_no }).collect(), [2, 4])
    multiline_fence :: "```jet\n/*\nData in a comment\n*/\ntext :: \"\"\"\nData in text\n\"\"\"\nvalue: Data\n```"
    assert_eq(markdown_data_name_lines(multiline_fence).iter().map(fn((line_no, _)) { line_no }).collect(), [8])
    assert_eq(markdown_data_name_lines("```jet\nvalue: Data")[0].0, 2)
    lawful_source :: "// Data is retired\ntext :: \"Data\"\n/* Data */\nvalue: DataTree"
    assert(source_identifier_offsets(lawful_source, "Data").is_empty())
    assert_eq(source_identifier_offsets("value: Data", "Data").len(), 1)
}
// Rust: tests/syntax_reconciliation.rs:301
#Test("active_maturity_docs_use_meta_field_only") {
    retired :: ["#Experimental", "#Tested", "#Hardened", "#Experimental", "#Tested", "#Hardened"]
    failures := [String]{}
    loop relative in ACTIVE_MATURITY_DOCS {
        text :: fs.read_to_string(relative).unwrap_or_else(fn(error) { panic("cannot read maturity surface {relative}: {error}") })
        loop required in ["#Meta(maturity:", ".Experimental", ".Tested", ".Hardened"] {
            if !text.contains(required) { failures.push("{relative} does not teach `{required}`") }
        }
        loop line in text.lines() {
            loop spelling in retired {
                if line.contains(spelling) && !line.contains("not grammar") { failures.push("{relative} teaches standalone `{spelling}`") }
            }
        }
    }
    assert(failures.is_empty(), "active maturity docs drifted from the sole `#Meta(maturity: ...)` surface:\n{failures.join("\n")}")
}
// Rust: tests/syntax_reconciliation.rs:335
#Test("proposal_marker_census_matches_syntax_registry") {
    rules :: Policy.APPLIED_RULES.iter().filter(fn(row) { row.status == .Active }).count()
    assert(rules > 0, "applied-rule registry must be non-empty")
    assert_eq(Syntax.RULE_PREFIX, "#", "registered applied rules must use the canonical `#` plane")
    text :: fs.read_to_string(MARKER_CENSUS_DOC).unwrap_or_else(fn(error) { panic("cannot read marker census doc {MARKER_CENSUS_DOC}: {error}") })
    normalized :: text.split_whitespace().collect().join(" ")
    assert(normalized.contains("`#` is the sole prefix for attributes, instructions, and properties.")
        && normalized.contains("Prefix `@` is now the compile-time and fact-read mark; infix `@`")
        && normalized.contains("A leading `@Rule` in marker position produces E0063 with the canonical `#Rule` fix."),
        "{MARKER_CENSUS_DOC} must teach the Syntax registry's canonical `#` applied-rule plane")
}
