// Rust: tests/syntax_reconciliation.rs:575
#Test("lexical_ledger_is_rendered_from_syntax") {
    decisions :: fs.read_to_string("Docs/spec/syntax-decisions.md").expect("read syntax decisions")
    start :: decisions.find("<!-- BEGIN GENERATED LEXICAL LEDGER -->").expect("syntax decisions must render the lexical ledger")
    end :: decisions.find("<!-- END GENERATED LEXICAL LEDGER -->").expect("syntax decisions must close the lexical ledger")
    assert(start < end, "lexical ledger markers must be ordered")
    block := decisions[start..end] // #4303
    assert(block.contains("Generated by `Tools/agent/lexical-ledger.mjs`"), "lexical ledger must identify its renderer")
    rendered_rows :: block.lines().filter(fn(line) { line.starts_with("| ") && !line.starts_with("| ---") }).count()
    assert_eq(rendered_rows, Syntax.LEXICAL_LEDGER.len() + 1, "rendered ledger must contain its header plus every Syntax.rs row")
    loop row in Syntax.LEXICAL_LEDGER {
        if row.spelling == "`" { assert(block.contains("<code>`</code>"), "rendered ledger is missing the backtick spelling") }
        else { assert(block.contains(row.spelling), "rendered ledger is missing spelling `{row.spelling}`") }
    }
    loop row in Syntax.LEXICAL_LEDGER {
        assert(block.contains(row.meaning), "rendered ledger is missing meaning `{row.meaning}`")
        if !row.decision.is_empty() { assert(block.contains(row.decision), "rendered ledger is missing decision `{row.decision}`") }
    }
}
// Rust: tests/syntax_reconciliation.rs:632
#Test("marker_plane_matrix_covers_current_marker_families") {
    syntax :: fs.read_to_string("crates/jet-foundation/src/Syntax.rs").expect("read Syntax.rs")
    decisions :: fs.read_to_string("Docs/spec/syntax-decisions.md").expect("read syntax decisions")
    assert_eq(Syntax.RULE_PREFIX, "#", "the applied-rule registry must stay on the canonical `#` plane")
    assert_eq(Syntax.EFFECT_ARROW_OPEN, "-[")
    assert_eq(Syntax.EFFECT_ARROW_CLOSE, "]>")
    assert(decisions.contains("**D-SHAPE8=A — Effects inside the arrow** *(ratified 2026-07-14,")
        && decisions.contains("owner-amended by D-ARROW-CONTROL1 on 2026-07-26; card #543)*:"),
        "syntax decisions must keep D-SHAPE8=A ratified, amended, and implemented")
    unique := [String: Bool]{}
    loop row in Policy.APPLIED_RULES.iter().filter(fn(row) { row.status == .Active }) {
        rule :: row.name
        assert(!rule.starts_with(['#', '@']), "registered applied-rule names are bare; RULE_PREFIX owns the `#` plane: {rule}")
        assert(!unique.contains_key(rule), "duplicate applied rule `{rule}`")
        unique.insert(rule, true)
    }
    loop rule in ["PubFile", "NoPrelude", "Target", "HTML", "WasmExport", "Layout", "SingleUse", "UnitFamily", "Rename", "Skip", "RenameAll", "Discriminant", "Untagged", "Codable", "Encode", "Decode", "Comparable", "MustUse", "Pre", "Post", "Inline", "Persist", "CLI", "Numeric", "Printable", "CodableAsBase", "FX", "Unsafe", "Impure", "Test", "Scrub", "Job", "Replayable", "State", "Transition", "Track", "Memo", "Meta"] {
        assert(unique.contains_key(rule), "Syntax registry missing applied-rule family member `{rule}`")
    }
    assert_eq(Policy.applied_rule("Default").map(fn(row) { row.status }), Val(Policy.RuleStatus.Retired(replacement: "field: ...{{{{...}}}}")), "Default must remain a diagnostic-only tombstone")
    loop syntax_anchor in ["MARKER_PUB_FILE", "MARKER_TARGET", "MARKER_LAYOUT", "MARKER_CODABLE", "APPLIED_RULES", "KW_FX", "KW_COMPTIME", "KW_DERIVE", "MARKER_TRACK", "MARKER_LOCAL", "MARKER_SHARED"] {
        assert(syntax.contains(syntax_anchor), "Syntax.rs must retain live marker anchor `{syntax_anchor}`")
    }
    loop decision_anchor in ["D-MARKER-FAMILY1", "D-MARKERMOVE1", "D-UNSAFE2", "D-TESTPAREN1", "D-BENCH1", "D-CAPBUNDLE1", "D-CTMARKER1"] {
        assert(decisions.contains(decision_anchor), "live syntax decisions must retain `{decision_anchor}`")
    }
}
// Rust: tests/syntax_reconciliation.rs:751
#Test("authority_vocabulary_has_one_live_name_and_retired_marker_tombstones") {
    live_surfaces :: ["crates/jet-foundation/src/Syntax/effects_surface.rs", "crates/jet-foundation/src/Syntax/core_surface.rs", "crates/jet-foundation/src/AST/statements.rs", "crates/jet-parser/src/Parser/Statements/control.rs", "crates/jet-sema/src/Sema/CheckerCore/statements.rs", "crates/jet-sema/src/Sema/Effects.rs", "crates/jet-sema/src/Sema/GateLedger.rs", "crates/jet-repl/src/lib.rs", "crates/jet-pkg-model/src/EffectBudget.rs", "crates/jet-devserver/src/Canvas/graph_projection.rs", "Source/CmdCompile.rs", "Docs/spec/reference/syntax-surface.jet", "tests/cli/man.txt", "tests/cli/completions_bash.txt", "tests/cli/completions_fish.txt", "tests/cli/completions_powershell.txt", "tests/cli/completions_zsh.txt", "crates/jet-codegen/src/Codegen/TIR/lower/statements.rs"]
    retired_words :: ["Abil" + "ity", "Abil" + "ities", "Capabil" + "ity", "Caps", "KW_CAPS", "TYPE_ABILITIES", "CAP_HANDLE_TYPE", "Stmt::Caps"]
    failures := [String]{}
    loop relative in live_surfaces {
        text :: fs.read_to_string(relative).expect("read live authority surface")
        loop retired in retired_words { if text.contains(retired) { failures.push("{relative} contains retired `{retired}`") } }
    }
    assert(failures.is_empty(), "live authority vocabulary drift:\n{failures:#?}")
    assert_eq(Syntax.KW_FX, "FX")
    assert_eq(Syntax.TYPE_AUTHORITY, "Authority")
    loop retired in ["Abilities", "Caps"] {
        assert_eq(Policy.applied_rule(retired).map(fn(row) { row.status }), Val(Policy.RuleStatus.Retired(replacement: "#FX")), "{retired} must remain a diagnostic-only tombstone")
    }
    assert(Policy.applied_rule("Authority").is_none())
}
// Rust: tests/syntax_reconciliation.rs:808
#Test("retired_authority_types_and_markers_keep_exact_teaching_diagnostics") {
    loop name in ["Ability", "Abilities", "Capability", "Caps"] {
        source :: "fn audit(value: {name}) {{ print(\"x\") }}"
        diagnostics :: compile(source).expect_err("retired Authority type must fail")
        assert(diagnostics.iter().any(fn(diagnostic) { diagnostic.code == "E0119" && diagnostic.what.contains("`{name}` is retired") }), "missing exact retirement diagnostic for {name}: {diagnostics:#?}")
    }
    loop marker in ["Abilities", "Caps"] {
        source :: "fn run() {{ #{marker}(IO) {{ print(\"x\") }} }}"
        (tokens, lex_diagnostics) :: Lexer.lex(source)
        assert(lex_diagnostics.is_empty(), "lexer rejected retired marker: {lex_diagnostics:#?}")
        diagnostics :: Parser.parse(&tokens).expect_err("retired Authority marker must fail in the parser")
        assert(diagnostics.iter().any(fn(diagnostic) { diagnostic.code == "E0927" && diagnostic.what.contains("`#{marker}` is retired") }), "missing exact retirement diagnostic for #{marker}: {diagnostics:#?}")
    }
}
// Rust: tests/syntax_reconciliation.rs:840
#Test("value_dispatch_accepts_range_arm_heads") {
    source :: "\nfn ordered(n: Int) -> Int {{\n    return if n == {{\n        0..9 -> 1\n        10..99 -> 2\n        else -> 3\n    }}\n}}\nfn run() {{\n    print(\"{{ordered(40)}}\")\n}}\n"
    (tokens, lex_diags) :: Lexer.lex(source)
    assert(lex_diags.is_empty(), "{lex_diags:#?}")
    program :: Parser.parse(&tokens).expect("value-dispatch range arms must parse")
    assert(!program.items.is_empty(), "parsed program should retain the ordered fn")
}
// Rust: tests/syntax_reconciliation.rs:865
#Test("card_511_census_matches_current_law") {
    core :: fs.read_to_string("crates/jet-foundation/src/Syntax/core_surface.rs").expect("read core surface registry")
    package :: fs.read_to_string("crates/jet-foundation/src/Syntax/package_files.rs").expect("read package surface registry")
    markers :: fs.read_to_string("crates/jet-foundation/src/Syntax/markers.rs").expect("read marker registry")
    decisions :: fs.read_to_string("Docs/spec/syntax-decisions.md").expect("read syntax decisions")
    assert(!core.contains("pub const KW_VIEW"), "D-MEM1 retired `view` as a keyword")
    assert(package.contains("pub const METHOD_VIEW"), "D-SHAPE-PLACE1 keeps retired `.view(a..b)` registered for E0214 teaching")
    loop retired in ["MARKER_WASM,", "MARKER_JS,", "MARKER_SUPPRESS,"] { assert(!markers.contains(retired), "retired marker remains registered: {retired}") }
    loop value in ["MARKER_EXPERIMENTAL", "MARKER_TESTED", "MARKER_HARDENED"] {
        assert(package.contains(value) && !markers.contains(value), "maturity value `{value}` must remain a #Meta value, not a standalone marker")
    }
    loop law in ["D-MARKER-FAMILY1", "D-DET1", "D-REPLAY1", "D-MARK-META1"] { assert(decisions.contains(law), "current syntax law omits `{law}`") }
}
// Rust: tests/syntax_reconciliation.rs:901
#Test("module_internal_is_discovery_not_access_control") {
    syntax :: fs.read_to_string("crates/jet-foundation/src/Syntax.rs").expect("read syntax registry")
