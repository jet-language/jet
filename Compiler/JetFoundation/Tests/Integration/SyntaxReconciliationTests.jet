// Rust: tests/syntax_reconciliation.rs:1310
#Test("artifact_extensions_are_one_closed_kind_specific_family") {
    assert_eq(Syntax.ARTIFACT_KINDS, [(Syntax.ArtifactKind.SourceMap, ".jetmap"), (Syntax.ArtifactKind.Notebook, ".jetnb"), (Syntax.ArtifactKind.Proof, ".jetproof"), (Syntax.ArtifactKind.Trace, ".jettrace"), (Syntax.ArtifactKind.GameReplay, ".jetreplay"), (Syntax.ArtifactKind.ProofReplay, ".jetproof-replay")])
    loop (kind, suffix) in Syntax.ARTIFACT_KINDS { assert_eq(Syntax.artifact_kind("artifact{suffix}"), Val(kind)) }
    assert_eq(Syntax.artifact_kind("run.jetproof-replay"), Val(Syntax.ArtifactKind.ProofReplay))
    assert_ne(Syntax.artifact_kind("run.jetproof-replay"), Val(Syntax.ArtifactKind.GameReplay))
    loop root in ["Source", "crates", "Examples", "tests", "Docs"] {
        loop path in files(&OSPath(root)) {
            if path.ends_with("tests/syntax_reconciliation.rs") -> next
            text :: fs.read_to_string(&path) ?? next
            loop (line_no, line) in text.lines().enumerate() {
                loop retired in [".jproof", ".jtrace", ".jreplay"] {
                    if line.contains(retired) && !line.contains("jet.jproof") { panic("{path.display()}:{line_no + 1} retains retired artifact suffix `{retired}`") }
                }
            }
        }
    }
}
