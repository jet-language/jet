use std.[fs, env]
use std.process.[Command, Output, id]
// GATE #4494: real filesystem/subprocess/build-environment test substrate.

// Rust: tests/authority_manifest.rs:7
@AUTHORITY_PACKAGE :: """
name: "authority_tiers"
version: "0.1.0"
authority: {{
    holds: {{ allow: [IO], deny: [Exec] }},
    grants: {{ "image-codec": [FS.Read] }},
    trust: {{ default: prompt, ci: {{ prompt: deny }}, services: {{ stripe: allow }}, require: none }},
    providers: {{ nix: {{ registry: "nixpkgs", deny: ["openssl-1.0"] }} }},
}}
"""

// Rust: tests/authority_manifest.rs:18
@AUTHORITY_PROGRAM :: """
ANSWER :: prep {{ "authority" }}

fn run() -> {{
    print(ANSWER)
}}
"""

// Rust: tests/authority_manifest.rs:26
fn authority_project(label: String) -> OSPath {
    root :: env.temp_dir().join("jet_authority_manifest_{label}_{id()}")
    fs.remove_dir_all(root).drop("remove previous isolated authority fixture")
    fs.create_dir_all(root).expect("authority tier project")
    fs.write(root.join("package.jet"), @AUTHORITY_PACKAGE).expect("authority package")
    fs.write(root.join("run.jet"), @AUTHORITY_PROGRAM).expect("authority program")
    root
}

// Rust: tests/authority_manifest.rs:38
fn run_authority_cli(root: OSPath, args: [String]) -> Output {
    command := Command.new(env.build_var("CARGO_BIN_EXE_jet"))
    &command.args(args).current_dir(root).env("NO_COLOR", "1")
    command.output().expect("authority tier command")
}

// Rust: tests/authority_manifest.rs:47
fn assert_authority_output(output: Output, tier: String) -> {
    assert(output.status.success(), "{tier} rejected the authority project:\nstdout={String.from_utf8_lossy(output.stdout)}\nstderr={String.from_utf8_lossy(output.stderr)}")
    assert_eq(String.from_utf8_lossy(output.stdout), "authority\n", tier)
}
