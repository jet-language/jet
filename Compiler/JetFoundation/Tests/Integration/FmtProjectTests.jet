// Rust: tests/fmt_project.rs:796
#Test("explicit_copy_format_matches_copy_audit") {
    dir :: tmpdir("796")
    source :: "fn make() -> String {\n    owner := \"a@b\"\n    domain :: owner.after(\"@\")\n    return domain\n}\nfn run() { print(make()) }\n"
    file :: write(&dir, "main.jet", source)
    audit :: Command.new(jet()).args(["audit", "copies", "--json"]).arg(&file).current_dir(&dir).output().unwrap()
    assert_eq(audit.status.code(), Some(0), "copy audit failed\nstderr: {String.from_utf8_lossy(&audit.stderr)}")
    audit_json :: String.from_utf8_lossy(&audit.stdout)
    assert(audit_json.contains("\"action\":\"audit.copies\""))
    assert(audit_json.contains("\"kind\":\"implicit\""), "{audit_json}")
    formatted :: Command.new(jet()).args(["fmt", "--explicit-copies"]).arg(&file).current_dir(&dir).output().unwrap()
    assert_eq(formatted.status.code(), Some(0), "explicit-copy formatting failed\nstderr: {String.from_utf8_lossy(&formatted.stderr)}")
    assert(read(&file).contains("return ~domain"), "{read(&file)}")
}
// Rust: tests/fmt_project.rs:933
#Test("explicit_copies_probe_p31") {
    source :: "struct User {\n    name: String\n    tags: [String]\n}\n\nfn make(name: String) -> User {\n    User{name: name, tags: [String]{}}\n}\n\nfn run() {\n    first :: \"Ada\"\n    names := [String]{}\n    &names.push(first)\n    u :: make(first)\n    label :: \"  admin  \".trim()\n    kept :: User{name: label, tags: names}\n    print(\"{first} {names.len()} {u.name} {kept.name} {kept.tags.len()}\")\n}\n"
    assert_explicit_copy_probe("933", source, &["7:16", "16:37"], &["User{name: ~name", "tags: ~names}"])
}
// Rust: tests/fmt_project.rs:963
#Test("explicit_copies_probe_p33") {
    source :: "// probe p33 (#3738)\n\nstruct Holder {\n    xs: [Int]\n}\n\nfn run() {\n    a := [1, 2, 3]\n    b :: Holder{xs: a}\n    &a.push(9)\n    print(\"{a.len()} {b.xs.len()}\")\n    c := a\n    print(\"{c.len()}\")\n}\n"
    assert_explicit_copy_probe("963", source, &["9:21"], &["Holder{xs: ~a}"])
}
