// Rust: tests/fmt_project.rs:461
#Test("stdin_mode_formats_and_writes_stdout") {
    dir :: tmpdir("461")
    child := Command.new(jet()).args(["fmt", "-", "--stdin-path=src/a.jet"]).current_dir(&dir).stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().unwrap()
    {
        stdin :: child.stdin.as_mut().unwrap()
        stdin.write_all(UNFORMATTED.as_bytes()).unwrap()
    }
    out :: child.wait_with_output().unwrap()
    assert_eq(out.status.code(), Some(0), "stdin mode should exit 0\nstderr: {String.from_utf8_lossy(&out.stderr)}")
    stdout :: String.from_utf8_lossy(&out.stdout)
    assert(!stdout.is_empty(), "stdout should contain formatted source")
}
