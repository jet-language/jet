// Rust: tests/fmt_project.rs:525
#Test("preflight_zero_write_on_bad_file") {
    dir :: tmpdir("525")
    good :: write(&dir, "good.jet", UNFORMATTED)
    bad :: write(&dir, "bad.jet", INVALID)
    before_good :: read(&good)
    before_bad :: read(&bad)
    out :: Command.new(jet()).arg("fmt").current_dir(&dir).output().unwrap()
    assert_eq(out.status.code(), Some(2), "preflight failure should exit 2\nstderr: {String.from_utf8_lossy(&out.stderr)}")
    assert_eq(read(&good), before_good, "good file must not be written when preflight fails")
    assert_eq(read(&bad), before_bad, "bad file must not be written")
}
