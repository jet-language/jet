    f :: write(&dir, "main.jet", UNFORMATTED)
    out1 :: Command.new(jet()).arg("fmt").arg(&f).current_dir(&dir).output().unwrap()
    assert_eq(out1.status.code(), Some(0))
    after_first :: read(&f)
    out2 :: Command.new(jet()).arg("fmt").arg(&f).current_dir(&dir).output().unwrap()
    assert_eq(out2.status.code(), Some(0))
    assert_eq(read(&f), after_first, "formatting twice must produce the same result")
}
// Rust: tests/fmt_project.rs:674
#Test("simplify_mode_is_stable_across_a_project") {
    dir :: tmpdir("674")
    sources :: [write(&dir, "examples/answer.jet", "fn answer() -> Int {\n    return 42\n}\n"), write(&dir, "tests/double.jet", "fn double(value: Int) -> Int {\n    return value * 2\n}\n"), write(&dir, "docs/spec/reference/sample.jet", "fn label() -> String {\n    return \"sample\"\n}\n")]
    corpus :: [dir.join("examples"), dir.join("tests"), dir.join("docs/reference")]
    first :: Command.new(jet()).args(["fmt", "--simplify"]).args(&corpus).current_dir(&dir).output().unwrap()
    assert_eq(first.status.code(), Some(0))
    // D-SIG-AFTER1=A: simplification retains exactly one arrow and a braced body.
    assert_eq(read(&sources[0]), "fn answer() -> Int { 42 }\n")
    assert_eq(read(&sources[1]), "fn double(value: Int) -> Int { value * 2 }\n")
    assert_eq(read(&sources[2]), "fn label() -> String { \"sample\" }\n")
    before_second :: sources.iter().map(fn(source) { fs.read(source).unwrap() }).collect()
    second :: Command.new(jet()).args(["fmt", "--simplify", "--check"]).args(&corpus).current_dir(&dir).output().unwrap()
    assert_eq(second.status.code(), Some(0))
    assert_eq(sources.iter().map(fn(source) { fs.read(source).unwrap() }).collect(), before_second, "the second simplify corpus check must not change bytes")
}
// Rust: tests/fmt_project.rs:736
