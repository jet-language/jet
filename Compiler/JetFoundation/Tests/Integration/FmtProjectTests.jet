use std.[fs, env]
use std.process.[Command, Stdio]
use std.io.Write
use jet_foundation.Tests.Integration.Common.jetpack_bin
use jet_foundation.Tests.Integration.FmtProject.*
// GATE #4494: real subprocesses, piped stdin, filesystem and permissions.
// Rust: tests/fmt_project.rs:74
#Test("top_level_jet_fmt_delegates_non_jet_file_to_realized_formatter") {
    dir :: tmpdir("74")
    root :: dir.join("root")
    formatter_repo :: dir.join("formatter-repo")
    formatter :: formatter_repo.join("bin/nixfmt")
    fs.create_dir_all(formatter.parent().unwrap()).unwrap()
    fs.write(&formatter, "#!/bin/sh\nset -e\nfor path do\n    printf 'formatted\\n' > \"$path\"\ndone\n").unwrap()
    make_executable(&formatter)
    fs.write(formatter_repo.join("package.jet"), "name: \"formatter-repo\"\nversion: \"0.1.0\"\npackages: { nixfmt: executable }\n").unwrap()
    fs.write(formatter_repo.join("nixfmt.jet"), "module nixfmt { }\n").unwrap()
    fs.write(dir.join("env.jet"), "module env.dev {{\n    sources: {{ local: {formatter_repo.to_string_lossy()} }}\n    formatter: \"nixfmt@local\"\n}}\n").unwrap()
    file :: write(&dir, "flake.nix", "unformatted\n")
    jetpack_path :: jetpack_bin()
    jetpack_dir :: jetpack_path.parent().unwrap()
    path_entries := [jetpack_dir.to_path_buf()]
    for value in env.var_os("PATH").into_iter() { path_entries.extend(env.split_paths(&value)) }
    path :: env.join_paths(path_entries).unwrap()
    out :: Command.new(jet()).args(["fmt", "--lang", "nix", "--trust", "--offline", "--no-color"]).current_dir(&dir).env("JETPACK_ROOT", &root).env("JETPACK_SHARED_CAS", dir.join("shared-cas")).env("PATH", path).output().unwrap()
    assert_eq(out.status.code(), Some(0), "jet fmt delegation failed\nstdout: {String.from_utf8_lossy(&out.stdout)}\nstderr: {String.from_utf8_lossy(&out.stderr)}")
    assert_eq(read(&file), "formatted\n")
}
// Rust: tests/fmt_project.rs:138
