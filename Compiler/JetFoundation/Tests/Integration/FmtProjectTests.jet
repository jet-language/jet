    assert_eq(first.status.code(), Some(0))
    assert_eq(read(&f), "fn read(values: [String:Int]) -> [String:Int] { return [\"key\": 1] }\n")
    before :: read(&f)
    second :: Command.new(jet()).args(["fmt", "--check"]).arg(&f).current_dir(&dir).output().unwrap()
    assert_eq(second.status.code(), Some(0))
    assert_eq(read(&f), before)
}
