// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! #2025: every declared test target belongs to exactly one named verification set.
//RS //!
//RS //! Three targets — `golden`, `ban_bare_panic` and `jit_run` — were each found red
//RS //! while sitting outside every set an agent routinely ran. None of them was
//RS //! broken by the session that found them; they had simply been red for a while
//RS //! with nothing watching. The defect is not the three targets, it is that suite
//RS //! MEMBERSHIP was remembered rather than enforced: a target nobody runs is a
//RS //! target whose failures are invisible, and "add these three to the list" repeats
//RS //! the same defect one layer up.
//RS //!
//RS //! So membership is derived and checked here, in the shape
//RS //! `tests/dev_parts/support.rs` already uses for the corpus-gate ledger:
//RS //!
//RS //! - the DENOMINATOR is walked from the filesystem on every run, never listed —
//RS //!   cargo builds one test binary per `tests/*.rs` file, so the walk IS the
//RS //!   target inventory and a new file cannot be born outside it;
//RS //! - `tests/suites.txt` states which set each target belongs to;
//RS //! - the pins live HERE, outside the file they guard, so a hand-edit cannot green
//RS //!   the check by deleting the row that fails;
//RS //! - `suite_ledger_audit_fires_on_a_target_in_no_set` proves the law can fail,
//RS //!   because a pin nobody has watched fail is a pin nobody should trust.
//RS //!
//RS //! Scope: integration test targets, in this package and every workspace crate.
//RS //! Package lib/bin unit tests ride with their package under `--workspace` and
//RS //! cannot fall out of a set on their own, which is the failure mode this file
//RS //! exists to stop.
//RS 
//RS mod common;
//RS 
//RS use std::collections::BTreeMap;
//RS use std::fs;
//RS use std::path::{Path, PathBuf};
//RS 
//RS /// The one list of set names. The ledger parser and the writer of any message
//RS /// here all read the sections out of the ledger rather than keeping a private
//RS /// copy, so a new set cannot exist in one reader and not another (AGENTS.md I8).
//RS const SUITE_ORDER: [&str; 7] = [
//RS     "guards",
//RS     "dev_loop",
//RS     "language",
//RS     "runtime",
//RS     "tooling",
//RS     "surface",
//RS     "host_gated",
//RS ];
//RS 
//RS /// The one section that is not executable, so the one section that owes a reason.
//RS const HOST_GATED: &str = "host_gated";
//RS 
//RS /// How many test targets `tests/suites.txt` must assign (#2025).
//RS ///
//RS /// A floor: rows may only GROW. State the polarity plainly, because both
//RS /// directions are bugs — a row that VANISHES is a target that left the sets and
//RS /// went back to being unwatched, which is the defect this file pins; a target
//RS /// with no row raises `unassigned` and fails against the ceiling below.
//RS ///
//RS /// Measured on 2026-08-17: 289 `tests/*.rs` targets in this package, 8 in
//RS /// workspace crates, plus this file. 2026-08-19 (#677): `cli_compile_latency`
//RS /// split out of `cli`, so 290 in this package. Lower it only in the same
//RS /// reviewed diff as a deleted test file.
//RS const TEST_TARGET_FLOOR: usize = 302;
//RS 
//RS /// How many declared targets may belong to NO set (#2025).
//RS ///
//RS /// Zero, and shrink-only cannot go below zero, so this is the whole point of the
//RS /// card expressed as a number: there is no legitimate "in no set". A target that
//RS /// genuinely cannot run on a normal host is parked in `host_gated:` WITH its
//RS /// observed gate, which costs an edit here as well — it is never simply absent.
//RS const UNASSIGNED_CEILING: usize = 0;
//RS 
//RS /// How many suites may exceed the guard's 900s default (#677).
//RS ///
//RS /// The guard's default is deliberately hostile: almost every suite that outruns
//RS /// 900s is defective, and the remedy is to split it or speed it up. A
//RS /// measurement suite whose sample count is ratified policy is the real
//RS /// exception, so `tests/suite_budgets.txt` exists — and this number is what
//RS /// keeps that exception an exception. It equals the row count today, so a
//RS /// SECOND exemption cannot land without moving this pin in the same reviewed
//RS /// diff. That friction is the feature: the goal is to speed development up, not
//RS /// to let the slow suites become the norm they were guarded against.
//RS const OVER_DEFAULT_BUDGET_CEILING: usize = 1;
//RS 
//RS /// The targets that cannot run in any executable set, with the observed gate and
