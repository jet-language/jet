pub SUITE_ORDER := ["guards", "dev_loop", "language", "runtime", "tooling", "surface", "host_gated"]
// Rust: tests/suite_membership.rs:48
pub HOST_GATED := "host_gated"
// Rust: tests/suite_membership.rs:61
pub TEST_TARGET_FLOOR := 302
// Rust: tests/suite_membership.rs:69
pub UNASSIGNED_CEILING := 0
// Rust: tests/suite_membership.rs:81
pub OVER_DEFAULT_BUDGET_CEILING := 1
// Rust: tests/suite_membership.rs:91
