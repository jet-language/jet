// Rust: tests/structure_liveness.rs:9
pub fn repo() -> OSPath { OSPath.from(env.var("CARGO_MANIFEST_DIR").unwrap()) }
// Rust: tests/structure_liveness.rs:13
pub fn example() -> String { "Examples/features/tooling/structure_liveness.jet" }
// Rust: tests/structure_liveness.rs:17
pub fn run_jet(args: [String]) -> Output {
    // GATE #4494: real process launch and output capture.
    Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).current_dir(repo()).env("NO_COLOR", "1").args(args).output().expect("run jet")
}
// Rust: tests/structure_liveness.rs:26
pub fn assert_liveness_warnings(label: String, output: Output) -> {
    stderr := String.from_utf8_lossy(output.stderr)
    loop code in ["L0101", "L0103", "L0104", "L0105"] { assert(stderr.contains(code), "{label} missing {code}: {stderr}") }
}
// Rust: tests/structure_liveness.rs:33
pub fn assert_liveness_policy_denied(label: String, output: Output) -> {
    stderr := String.from_utf8_lossy(output.stderr)
    assert(!output.status.success(), "{label} unexpectedly ran: {stderr}")
    assert(output.stdout.is_empty(), "{label} executed user code")
    assert(stderr.contains("E1293") && stderr.contains("L0101"), "{label} missing denied liveness lint: {stderr}")
    assert(!stderr.contains("Warning [L0101]"), "{label} printed denied lint as warning: {stderr}")
}
