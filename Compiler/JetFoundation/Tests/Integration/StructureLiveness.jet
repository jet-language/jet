// Rust: tests/suite_membership.rs:96
pub struct SuiteRow { target: String, set: String, observed: String }
// Rust: tests/suite_membership.rs:105
pub struct SuiteLedgerAudit {
    assigned: Int
    unassigned: [String]
    ghosts: [String]
    duplicated: [String]
    reasonless: [String]
    empty_sets: [String]
    host_gated: [(String, String)]
}
// Rust: tests/suite_membership.rs:125
pub fn repo_root() -> OSPath { OSPath.from(env.var("CARGO_MANIFEST_DIR").unwrap()) }
// Rust: tests/suite_membership.rs:132
pub fn discover_test_targets() -> [String] {
    // GATE #4494: filesystem-derived inventory, not a remembered list.
    root := repo_root()
    targets := integration_targets(root.join("tests"), "tests")
    crates := root.join("crates")
    crate_dirs: [OSPath] := fs.read_dir(crates).expect("crates dir").flatten().map(entry -> entry.path()).filter(path -> path.is_dir()).collect()
    crate_dirs.sort()
    loop crate_dir in crate_dirs {
        name := crate_dir.file_name().expect("crate dir name").to_string_lossy().to_string()
        tests := crate_dir.join("tests")
        if tests.is_dir() { targets.extend(integration_targets(tests, "crates/{name}/tests")) }
    }
    targets.sort()
    targets
}
// Rust: tests/suite_membership.rs:158
pub fn integration_targets(dir: OSPath, prefix: String) -> [String] {
    targets: [String] := fs.read_dir(dir).unwrap_or_else(err -> panic("read {dir.display()}: {err}")).flatten().filter(entry -> entry.path().is_file()).filter_map(entry -> {
        name := entry.file_name().to_string_lossy().to_string()
        name.strip_suffix(".rs").map(stem -> "{prefix}/{stem}")
    }).collect()
    targets.sort()
    targets
}
// Rust: tests/suite_membership.rs:173
pub fn parse_suite_ledger(text: String) -> [SuiteRow] {
    section: String? := None
    rows: [SuiteRow] := []
    loop raw in text.lines() {
        trimmed := raw.trim() // #4303
        if trimmed.is_empty() || trimmed.starts_with('#') { next }
        name := trimmed.strip_suffix(':')
        if name.is_some() {
            section = Some(SUITE_ORDER.iter().find(known -> known == name.unwrap()).unwrap_or_else(() -> panic("tests/suites.txt names the set `{name.unwrap()}:`, which is not one of {SUITE_ORDER:?}. A set the runner cannot name is a set nobody runs.")).to_string())
            next
        }
        split := trimmed.split_once(": ")
        (target, observed) := if split == {
            .Some((target, observed)) -> (target.to_string(), observed.to_string())
            .None -> (trimmed.to_string(), String.new())
        }
        set := section.unwrap_or_else(() -> panic("tests/suites.txt row outside any section: {trimmed}"))
        rows.push(SuiteRow{target: target, set: set, observed: observed})
    }
    rows
}
// Rust: tests/suite_membership.rs:215
pub fn audit_suite_ledger(ledger: [SuiteRow], discovered: [String]) -> SuiteLedgerAudit {
    existing: [String: Bool] := [:]
    loop target in discovered { existing.insert(target, true) }
    claims: [String: [String]] := [:]
    loop row in ledger { claims.entry(row.target).or_insert([]).push(row.set) }
    keys := claims.keys().collect()
    keys.sort()
    ghosts: [String] := []
    duplicated: [String] := []
    loop target in keys {
        if !existing.contains_key(target) { ghosts.push(target) }
        sets := claims[target]
        if sets.len() > 1 { duplicated.push("  {target}: {sets.join(", ")}") }
    }
    unassigned := discovered.iter().filter(target -> !claims.contains_key(target)).map(target -> target.to_string()).collect()
    reasonless := ledger.iter().filter(row -> row.set == HOST_GATED && row.observed.is_empty()).map(row -> "  {row.target}: parked in `{HOST_GATED}:` with no gate named").collect()
    present_sets: [String: Bool] := [:]
    loop row in ledger { present_sets.insert(row.set, true) }
    empty_sets := SUITE_ORDER.iter().filter(set -> set != HOST_GATED && !present_sets.contains_key(set)).map(set -> set.to_string()).collect()
    host_gated := ledger.iter().filter(row -> row.set == HOST_GATED).map(row -> (row.target.to_string(), row.observed.to_string())).collect()
    host_gated.sort()
    SuiteLedgerAudit{assigned: claims.len() - ghosts.len(), unassigned: unassigned, ghosts: ghosts, duplicated: duplicated, reasonless: reasonless, empty_sets: empty_sets, host_gated: host_gated}
}
// Rust: tests/suite_membership.rs:456
pub fn audit_suite_budgets(rows: [common.SuiteBudgetRow], discovered: [String]) -> [String] {
    names: [String: Bool] := [:]
    loop target in discovered { names.insert(target.rsplit('/').next().unwrap_or(target).to_string(), true) }
    violations: [String] := []
    seen: [String: Int] := [:]
    loop row in rows {
        seen.entry(row.suite).or_insert(0) += 1
        if row.secs <= 900 {
            violations.push("`{row.suite}` asks for {row.secs}s, at or under the 900s default — a row that buys nothing is a row to delete, and the env var is what tightens a budget")
        }
        if !names.contains_key(row.suite) {
            violations.push("`{row.suite}` names no test target — a stale row keeps an exemption alive for a suite that no longer exists, and spends the ceiling on nothing")
        }
    }
    keys := seen.keys().collect()
    keys.sort()
    loop suite in keys {
        count := seen[suite]
        if count > 1 { violations.push("`{suite}` has {count} rows; the guard takes the first, so the others are exemptions nobody reads") }
    }
    violations
}
