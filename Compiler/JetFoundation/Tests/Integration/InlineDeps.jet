use std.[fs, env, process, time]
use std.process.[Command, Output]
use std.sync.atomic.[AtomicU64, Ordering]
// GATE #4494: filesystem, actual subprocesses, clock and atomic sequence.
// Rust: tests/inline_deps.rs:19
pub fn tmp_dir(label: String) -> OSPath {
    stamp :: time.SystemTime.now().duration_since(time.UNIX_EPOCH).unwrap().subsec_nanos()
    base :: env.temp_dir().join("jet_inline_deps_{label}_{process.id()}_{stamp}")
    fs.create_dir_all(&base).unwrap()
    base
}
// Rust: tests/inline_deps.rs:33
pub fn write(dir: &OSPath, rel: String, content: String) -> {
    path :: dir.join(rel)
    if parent :: path.parent() { fs.create_dir_all(parent).unwrap() }
    fs.write(path, content).unwrap()
}
// Rust: tests/inline_deps.rs:41
pub fn jet_bin() -> OSPath { OSPath.from(env.var_os("CARGO_BIN_EXE_jet").unwrap()) }
// Rust: tests/inline_deps.rs:45
pub fn have_cargo() -> Bool { Command.new("cargo").arg("--version").output().is_ok() }
// Rust: tests/inline_deps.rs:55
// Private cache prevents identical fixtures from suppressing sema lint emission.
pub fn jet_cmd(args: &[String], cwd: &OSPath) -> Output {
    Command.new(jet_bin()).args(args).current_dir(cwd).env("JET_STORE_DIR", cwd.join(".jet-test-cache")).output().expect("jet binary should run")
}
// Rust: tests/inline_deps.rs:66
pub fn write_textkit_fixture(project: &OSPath) -> {
    write(project, ".jet/inline-deps/textkit/1.4.2/textkit.jet", "pub fn shout(s: String) -> String {\n    return ~s\n}\n")
}
// Rust: tests/inline_package.rs:246
pub static INLINE_SCRATCH_SEQ: AtomicU64 = AtomicU64.new(0)
// Rust: tests/inline_package.rs:248
pub fn inline_scratch(label: String) -> OSPath {
    base :: OSPath.from(env.var_os("HOME").expect("inline package tests require HOME")).join(".cache/jet-test-scratch/inline-package")
    sequence :: INLINE_SCRATCH_SEQ.fetch_add(1, Ordering.Relaxed)
    root :: base.join("{label}-{process.id()}-{sequence}")
    fs.create_dir_all(&root).unwrap()
    fs.write(root.join("workspace.jet"), "module workspace { members: [] }\n").unwrap()
    root
}
// Rust: tests/inline_package.rs:266
pub fn remove_inline_scratch(root: &OSPath) -> { _ :: fs.remove_dir_all(root) }
// Rust: tests/inline_package.rs:270
pub fn run_inline_cli(root: &OSPath, args: &[String]) -> (Int32, String, String) {
    sequence :: INLINE_SCRATCH_SEQ.fetch_add(1, Ordering.Relaxed)
    output :: Command.new(jet_bin()).args(args).current_dir(root)
        .env("JET_STORE_DIR", root.join(".jet-cache-{sequence}"))
        .env("JET_PACKAGE_STORE_DIR", root.join(".jet-store-{sequence}"))
        .env("JETPACK_ROOT", root.join(".jetpack-{sequence}"))
        .env("JETPACK_ENV", "1").env("NO_COLOR", "1").output().expect("run Jet inline-package command")
    (output.status.code().unwrap_or(-1), String.from_utf8_lossy(&output.stdout).into_owned(), String.from_utf8_lossy(&output.stderr).into_owned())
}
