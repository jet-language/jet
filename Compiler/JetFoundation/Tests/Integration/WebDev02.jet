use Compiler.JetFoundation.Tests.Integration.WebDev.[jet_bin, http_get, wait_for_app_preview]
use std.process.[Child, Command, Stdio]
use std.time.[Duration, Instant]
use std.thread

// Rust: tests/web_dev.rs:2809
pub fn fn_fixture_src(port: U16, greeting: String) -> String {
    "use core.web.devserver as devserver\n\nfn dev() -> {{\n    server :: devserver.for_app(\"app.jet\")\n    server.port({port})\n    server.serve()\n}}\n\nfn run() -> {{\n    print(\"{greeting}\")\n}}\n"
}
// Rust: tests/web_dev.rs:2826
// Poll the port selected by the fixture itself; never use a blind sleep.
// Rust: tests/web_dev.rs:2828
pub fn wait_for_server_up(port: U16, timeout: Duration) -> {
    // GATE #4494: native monotonic clock and thread sleep.
    start :: Instant.now()
    loop {
        if http_get(port, "/__jet_dev_version") == Val((200, _)) { return }
        if start.elapsed() > timeout {
            panic("jet dev's own core.web.devserver never came up on port {port}")
        }
        thread.sleep(Duration.from_millis(100))
    }
}
// Rust: tests/web_dev.rs:2844
pub struct EmbeddedDevserverChild { child: Child }
// Rust: tests/web_dev.rs:2846
impl EmbeddedDevserverChild.Drop {
    // Rust: tests/web_dev.rs:2847
    fn drop(&self) -> {
        _ :: self.child.kill()
        _ :: self.child.wait()
    }
}
// Rust: tests/web_dev.rs:2853
pub fn start_embedded_devserver(dir: &OSPath, port: U16) -> EmbeddedDevserverChild {
    // GATE #4494: real devserver process and pipes.
    child := Command.new(jet_bin()).args(["dev", "app.jet"]).current_dir(dir).stdout(Stdio.piped()).stderr(Stdio.null()).spawn().expect("failed to start embedded devserver fixture")
    stdout :: child.stdout.take().unwrap()
    guard :: EmbeddedDevserverChild{child: ^child}
    served_port :: wait_for_app_preview(^stdout)
    assert_eq(served_port, port)
    wait_for_server_up(port, Duration.from_secs(30))
    guard
}
