// Rust: tests/gate_ledger.rs:651
#Test("i9_number_grid_parser_keeps_int_ranges_as_one_surface") {
    (tokens, diagnostics) :: compiler.Lexer.lex(NUMBER_GRID_EXAMPLE)
    assert(diagnostics.is_empty(), "number-grid lexer diagnostics: {diagnostics:Debug}")
    program :: compiler.Parser.parse(&tokens).expect("number-grid example must parse")
    severity :: program.items.iter().find_map((item) -> match item {
        .Distinct(def) -> if def.name == "Severity" -> Val(def) else -> nil
        _ -> nil
    }).expect("number-grid distinct range declaration")
    assert_eq(severity.range.map(((lo, hi, _)) -> (lo, hi)), Val((0, 10)))
    setter :: program.items.iter().find_map((item) -> match item {
        .Func(func) -> if func.name == "set_brightness" -> Val(func) else -> nil
        _ -> nil
    }).expect("number-grid inline range function")
    assert_inline_int_range(&setter.params[0].ty, 0, 100)
    assert_inline_int_range(setter.return_type.as_ref().expect("setter return type"), 0, 100)
}
