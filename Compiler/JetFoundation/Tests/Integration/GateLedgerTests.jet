// Rust: tests/gate_ledger.rs:550
#Test("i9_sema_tier_records_all_knowledge_plane_gates_stably") {
    scratch :: common.Scratch.new("gate-tier-sema-knowledge")
    write_tier_fixture(&scratch.path)
