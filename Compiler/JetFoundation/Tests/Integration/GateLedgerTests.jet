// Rust: tests/gate_ledger.rs:228
#Test("full_and_filtered_views_keep_one_provenance_ledger") {
    scratch :: common.Scratch.new("gate-views")
    write_gates(&scratch.path)
    human :: stdout(&run(&scratch.path, &["inspect", "gates", "gates.jet"]))
    assert(human.contains("gates:"), "{human}")
    assert(human.contains("unsafe:"), "{human}")
    assert(human.contains("impure:"), "{human}")
    assert(human.contains("nondeterministic:"), "{human}")
    json :: stdout(&run(&scratch.path, &["inspect", "gates", "--json", "gates.jet"]))
    assert(json.starts_with("{{\"schema_version\":1,\"entries\":["), "{json}")
    assert(json.contains("\"provenance\":["), "{json}")
    assert(json.contains("test unsafe reason"), "{json}")
    kind :: stdout(&run(&scratch.path, &["inspect", "gates", "--kind", "impure", "gates.jet"]))
    assert(kind.contains("impure: 1"), "{kind}")
    assert(!kind.contains("unsafe:"), "{kind}")
    scope :: stdout(&run(&scratch.path, &["inspect", "gates", "--scope", "block", "gates.jet"]))
    assert(scope.contains("impure:"), "{scope}")
    assert(!scope.contains("unsafe:"), "{scope}")
    authority :: stdout(&run(&scratch.path, &["inspect", "authority", "--json", "gates.jet"]))
    assert(authority.contains("\"kind\":\"unsafe\""), "{authority}")
    assert(!authority.contains("precision_demotion"), "{authority}")
    unsafe_view :: stdout(&run(&scratch.path, &["inspect", "unsafe", "--json", "gates.jet"]))
    assert(unsafe_view.contains("\"gates\":["), "{unsafe_view}")
    assert(!unsafe_view.contains("test impure reason"), "{unsafe_view}")
}
// Rust: tests/gate_ledger.rs:279
#Test("authority_ledger_mirrors_manifest_and_lock_block_shape") {
    scratch :: common.Scratch.new("authority-ledger")
    fs.write(scratch.join("package.jet"), """
name: "ledger"
version: "0.1.0"
authority: {
    holds: { allow: [IO], deny: [Exec] },
    grants: { "image-codec": [FS.Read] },
    trust: { default: prompt, ci: { prompt: deny }, services: { stripe: allow } },
    providers: { nix: { registry: "nixpkgs", deny: ["openssl-1.0"] } },
}
""").unwrap()
    fs.write(scratch.join("run.jet"), "fn run() -> {{ print(\"ledger\") }}\n").unwrap()
    fs.create_dir_all(scratch.join(".jet")).unwrap()
    fs.write(scratch.join(".jet/lock"), """
version = 1

[root]
dependencies = []
authority = { holds: { allow: [IO], deny: [Exec] }, grants: { "image-codec": [FS.Read] }, trust: { default: prompt, ci: { prompt: deny }, services: { stripe: allow } }, providers: { nix: { registry: "nixpkgs", deny: ["openssl-1.0"] } } }
""").unwrap()
    json :: stdout(&run(&scratch.path, &["inspect", "authority", "--json", "run.jet"]))
    for subject in ["authority.holds.allow", "authority.holds.deny", "image-codec", "authority.trust.default", "authority.trust.ci", "authority.trust.services.stripe", "authority.providers.nix"] {
        assert(json.contains("\"subject\":\"{subject}\""), "{subject}: {json}")
    }
    assert(json.contains(".jet/lock"), "lock authority provenance missing: {json}")
}
// Rust: tests/gate_ledger.rs:332
#Test("source_gate_kinds_keep_their_written_reasons") {
    scratch :: common.Scratch.new("gate-source-kinds")
    write_source_gate_kinds(&scratch.path)
    json :: stdout(&run(&scratch.path, &["inspect", "gates", "--json", "source-gates.jet"]))
    for kind in ["dependency_grant", "taint_scrub", "duty_drop", "precision_demotion"] {
        assert(json.contains("\"kind\":\"{kind}\""), "{kind}: {json}")
    }
    for subject in ["approx", "wrapping", "from_meter_rounded"] {
        marker :: "\"subject\":\"{subject}\""
        subject_at :: json.find(&marker).expect("precision gate subject")
        entry_at :: json[..subject_at].rfind("{{\"kind\":\"").expect("precision gate entry")
        assert(json[entry_at..subject_at].starts_with("{{\"kind\":\"precision_demotion\""), "precision gate {subject} did not use exact ledger kind: {json}")
    }
    assert(json.contains("intentional result discard"), "{json}")
    assert(json.contains("#Scrub(Input)"), "{json}")
    assert(json.contains("\"subject\":\"from_meter_rounded\""), "{json}")
    assert(json.contains("source-gates.jet:"), "{json}")
}
// Rust: tests/gate_ledger.rs:372
#Test("range_knowledge_gate_has_three_tier_example_parity") {
    root :: OSPath.from(env.build("CARGO_MANIFEST_DIR"))
