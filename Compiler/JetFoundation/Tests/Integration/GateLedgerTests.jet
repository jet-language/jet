// Rust: tests/gate_ledger.rs:739
#Test("i9_number_grid_comptime_keeps_the_exact_inline_value") {
    (_scratch, bundle) :: checked_number_grid_bundle("number-grid-comptime")
    constant :: bundle.modules[bundle.entry].items.iter().find_map((item) -> match item {
        .Const(def) -> if def.name == "comptime_brightness" -> Val(def) else -> nil
        _ -> nil
    }).expect("number-grid comptime binding")
    assert(constant.is_comptime)
    assert_eq(constant.ct.as_ref(), Val(compiler.AST.CtValue.Int(42)))
}
// Rust: tests/gate_ledger.rs:757
#Test("i9_number_grid_repl_keeps_the_inline_range_behavior") {
    transcript :: compiler.REPL.run_transcript(&["fn set_brightness(level: Int(0..100)) -> Int(0..100) {{ level }}", "fn checked_inline(raw: Int) -> Int(0..100) String! {{ Int(0..100).from_int(raw) }}", "print(set_brightness(42))", "print(checked_inline(3) ?? Int(0..100).from_int(0))"], nil)
    assert_eq(transcript, "ok\nok\n42\n3\n")
}
// Rust: tests/gate_ledger.rs:771
#Test("i9_number_grid_web_keeps_the_shared_runtime_behavior") {
    output :: compiler.compile_web_with_path(NUMBER_GRID_WEB_SOURCE, "tests/fixtures/number_grid_web.jet").unwrap_or_else((diagnostics) -> panic("number-grid web source was rejected: {diagnostics:Debug}"))
    web :: output.web.expect("number-grid web target must produce artifacts")
    assert(web.js_app.contains("function jet_inline_range_from_int"))
    assert(web.wasm_rust.contains("jet_inline_range_from_int"))
    if !have_tool("rustc") || !have_tool("node") || !have_wasm_target() { eprintln("note: skipping number-grid web execution (need rustc, node, and wasm32 target)"); return }
    scratch :: common.Scratch.new("number-grid-web")
    fs.write(scratch.join("app.js"), &web.js_app).unwrap()
    fs.write(scratch.join("jet_dom_runtime.js"), &web.dom_runtime).unwrap()
    fs.write(scratch.join("app_wasm.rs"), &web.wasm_rust).unwrap()
    fs.write(scratch.join("package.json"), "{{\"type\":\"module\"}}").unwrap()
    wasm :: Command.new("rustc").current_dir(&scratch.path).args(["--edition", "2021", "--target", "wasm32-unknown-unknown", "--crate-type", "cdylib", "-O", "app_wasm.rs", "-o", "app.wasm"]).output().expect("spawn number-grid web rustc")
    assert(wasm.status.success(), "rustc rejected number-grid web output: {String.from_utf8_lossy(&wasm.stderr)}")
    node :: Command.new("node").current_dir(&scratch.path).arg("app.js").output().expect("spawn number-grid web app")
    assert(node.status.success(), "number-grid web app failed: stdout={String.from_utf8_lossy(&node.stdout)} stderr={String.from_utf8_lossy(&node.stderr)}")
    assert_eq(String.from_utf8_lossy(&node.stdout), "42\n3\n")
}
