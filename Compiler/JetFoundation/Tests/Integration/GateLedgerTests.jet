// Rust: tests/gate_ledger.rs:610
#Test("i9_repl_tier_keeps_the_fixture_behavior") {
    scratch :: common.Scratch.new("gate-tier-repl")
    write_tier_fixture(&scratch.path)
    child := Command.new(jet()).current_dir(&scratch.path).args(["repl"]).env("XDG_STATE_HOME", scratch.path.join("state")).env_remove("JET_REPL_HISTORY").env("NO_COLOR", "1").stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().expect("start REPL")
    child.stdin.as_mut().expect("REPL stdin").write_all(b":load tier.jet\n:run\n:quit\n").expect("write REPL input")
    output :: child.wait_with_output().expect("finish REPL")
    text :: stdout(&output)
    assert_tier_text(&text)
    assert(text.contains("loaded"), "expected REPL fixture load, got {text}")
}
