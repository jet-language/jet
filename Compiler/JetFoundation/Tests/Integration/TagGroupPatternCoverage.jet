// D-TAG1: group subsumption uses the shared fact_covers separator rule.
use std.[env, fs, process, thread]
use jet.Loader.load_entry
use jet.Sema.[check_bundle, CompileMode]

// Rust: tests/tag_group_pattern_coverage.rs:9
pub fn codes(source: String) -> [String] {
    // GATE #4494: native scratch directory, process/thread identity and file writes.
    dir := env.temp_dir().join("jet_tag_group_pattern_coverage_{process.id()}_{thread.current().name().unwrap_or(\"test\")}")
    fs.create_dir_all(dir).unwrap()
    path := dir.join("main.jet")
    fs.write(path, source).unwrap()
    bundle := load_entry(path.to_str().unwrap()).unwrap()
    check_bundle(&bundle, CompileMode.Check).into_iter().map(diagnostic -> diagnostic.code.to_string()).collect()
}
