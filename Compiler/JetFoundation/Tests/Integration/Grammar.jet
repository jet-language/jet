//RS     );
//RS }
//RS 
//RS /// S6-R: the lexer inserts a synthetic statement terminator at line ends after
//RS /// a statement-ending token, with continuation suppression. Pins the four cases
//RS /// the design doc calls out: dot-chain, broken boolean, broken arithmetic, and
//RS /// the negative case (a genuine statement on the next line gets a terminator).
//RS #[test]
//RS fn s6r_terminator_insertion_and_suppression() {
//RS     use jet::Lexer::TokKind;
//RS     let count_semis = |src: &str| -> usize {
//RS         let (toks, diags) = jet::Lexer::lex(src);
//RS         assert!(diags.is_empty(), "lex diags for {src:?}: {diags:?}");
//RS         toks.iter()
//RS             .filter(|t| matches!(t.kind, TokKind::Semi))
//RS             .count()
//RS     };
//RS 
//RS     // Negative case: two real statements → a terminator between them (+ one
//RS     // before the closing `}`), so 2 synthetic terminators inside the body.
//RS     assert_eq!(count_semis("fn run() {\n    x :: 1\n    y :: 2\n}\n"), 2);
//RS 
//RS     // Dot-chain continuation (S69): a leading `.` suppresses insertion, so the
//RS     // whole `a.b()` is one statement → just the pre-`}` terminator.
//RS     assert_eq!(count_semis("fn run() {\n    a()\n        .b()\n}\n"), 1);
//RS 
//RS     // Broken boolean: a leading `&&` suppresses insertion → one statement.
//RS     assert_eq!(count_semis("fn run() {\n    x :: a\n        && b\n}\n"), 1);
//RS 
//RS     // Broken arithmetic: a leading `+` suppresses insertion → one statement.
//RS     assert_eq!(count_semis("fn run() {\n    x :: a\n        + b\n}\n"), 1);
//RS 
//RS     // A closing `)` on its own line never gets a terminator before it
//RS     // (multi-line call args) → one statement.
//RS     assert_eq!(count_semis("fn run() {\n    f(\n        a\n    )\n}\n"), 1);
//RS 
//RS     // D-IF3 / D-ENUMDOT1: a leading-dot dispatch arm is a new statement, not a
//RS     // fluent chain — otherwise a braceless prior arm body glues onto `.Empty`.
//RS     // Two arm bodies + pre-`}` terminator → 3 semis inside the outer fn body
//RS     // (the `if` itself is one statement; semis live inside its dispatch block).
//RS     assert_eq!(
//RS         count_semis(
//RS             "fn run() {\n    if s == {\n        .Circle(r) -> print(r)\n        .Empty -> print(0)\n    }\n}\n"
//RS         ),
//RS         3
//RS     );
//RS }
