//RS #[test]
//RS fn enum_is_keyword() {
//RS     let (toks, diags) = jet::Lexer::lex("enum x { A; }");
//RS     assert!(diags.is_empty(), "{diags:?}");
//RS     assert!(
//RS         matches!(toks[0].kind, jet::Lexer::TokKind::KwEnum),
//RS         "{:?}",
