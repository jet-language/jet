// Editor keyword drift guards: generated highlight sections and foreign teaching words.
use std.fs
use jet.Syntax
// GATE #4494: real checked-in grammar/source filesystem reads.
// Rust: tests/grammar.rs:17
pub const GENERATED_START: String = "BEGIN GENERATED JET SYNTAX HIGHLIGHTS"
// Rust: tests/grammar.rs:18
pub const GENERATED_END: String = "END GENERATED JET SYNTAX HIGHLIGHTS"
// Rust: tests/grammar.rs:20
pub fn generated_section(path: String) -> String {
    text :: fs.read_to_string(path).unwrap_or_else((e) -> panic("{path}: {e}"))
    generated_section_from_text(path, text)
}
// Rust: tests/grammar.rs:25
pub fn generated_section_from_text(path: String, text: String) -> String {
    start :: text.find(GENERATED_START).unwrap_or_else(() -> panic("{path} is missing {GENERATED_START}"))
    line_start :: text[..start].rfind('\n').map_or(0, (idx) -> idx + 1)
    after_start :: text[start..]
    end :: after_start.find(GENERATED_END).unwrap_or_else(() -> panic("{path} is missing {GENERATED_END}"))
    end_marker :: start + end + GENERATED_END.len()
    line_end :: text[end_marker..].find('\n').map_or(text.len(), (idx) -> end_marker + idx)
    text[line_start..line_end].to_string()
}
// Rust: tests/grammar.rs:41
pub fn generated_section_matches(text: String, path: String, expected: String) -> Bool {
    trimmed := expected.trim_end() // #4303
    generated_section_from_text(path, text) == trimmed
}
// Rust: tests/grammar.rs:257
pub fn section_has_token(section: String, token: String) -> Bool {
    escaped :: regex_escape(token)
    json_escaped :: escaped.replace('\\', "\\\\")
    section.contains(token) || section.contains(&escaped) || section.contains(&json_escaped)
}
// Rust: tests/grammar.rs:263
pub fn zed_generated_class(class: Syntax.HighlightClass) -> Bool { class != Syntax.HighlightClass.MarkerRule }
// Rust: tests/grammar.rs:267
pub fn is_word_token(s: String) -> Bool {
    s.chars().all((c) -> c == '_' || c.is_ascii_alphanumeric()) && s.chars().next().is_some_and((c) -> c == '_' || c.is_ascii_alphabetic())
}
// Rust: tests/grammar.rs:274
pub fn extract_anonymous_node_types(path: String) -> Set<String> {
    text :: fs.read_to_string(path).unwrap_or_else((e) -> panic("{path}: {e}"))
    out := Set<String>.new()
    current_type: String? := None
    current_named: Bool? := None
    for line in text.lines() {
        trimmed := line.trim() // #4303
        if line.starts_with("  {{") { current_type = None; current_named = None }
        else if trimmed.starts_with("\"type\":") && current_type.is_none() { current_type = json_field_string_value(trimmed).map((value) -> value.to_string()) }
        else if trimmed.starts_with("\"named\":") && current_named.is_none() { current_named = Some(trimmed.contains("true")) }
        else if line.starts_with("  }}") {
            if current_named == Some(false) { if current_type.take() == Some(t) { _ :: out.insert(t) } }
        }
    }
    out
}
// Rust: tests/grammar.rs:301
pub fn extract_zed_query_string_literals(query: String) -> [String] {
    out := [String]{}
    for line in query.lines() {
        trimmed := line.trim() // #4303
        if trimmed.starts_with(';') { continue }
        rest := trimmed
        while rest.find('"') == Some(start) {
            rest = rest[start + 1..]
            end :: match rest.find('"') { Some(end) -> end, None -> break }
            out.push(rest[..end].to_string())
            rest = rest[end + 1..]
        }
    }
    out
}
// Rust: tests/grammar.rs:321
pub fn json_string_value(line: String) -> String? {
    first :: line.find('"')?
    rest :: line[first + 1..]
    second :: rest.find('"')?
    Some(rest[..second].to_string())
}
// Rust: tests/grammar.rs:328
pub fn json_field_string_value(line: String) -> String? {
    colon :: line.find(':')?
    value := line[colon + 1..].trim() // #4303
    json_string_value(value)
}
// Rust: tests/grammar.rs:333
pub fn regex_escape(s: String) -> String {
    out := String.new()
    for ch in s.chars() {
        if ['\\', '.', '+', '*', '?', '^', '$', '(', ')', '[', ']', '{', '}', '|', '/', '-'].contains(ch) { out.push('\\') }
        out.push(ch)
    }
    out
}
// Scan match regex alternation groups only within the grammar's keywords object.
// Rust: tests/grammar.rs:366
pub fn extract_grammar_keyword_words(grammar_text: String) -> Set<String> {
    words := Set<String>.new()
    in_keywords := false
    depth := 0
    for line in grammar_text.lines() {
        trimmed := line.trim() // #4303
        if trimmed.contains("\"keywords\"") { in_keywords = true }
        if in_keywords {
            depth += trimmed.chars().filter((c) -> c == '{').count()
            depth -= trimmed.chars().filter((c) -> c == '}').count()
            if depth <= 0 && in_keywords && !trimmed.contains("\"keywords\"") { in_keywords = false }
            if trimmed.find("\"match\"") == Some(match_start) {
                after :: trimmed[match_start..]
                val_start :: after.find('"').and_then((_) -> {
                    rest := after[after.find(':').unwrap_or(0) + 1..].trim_start() // #4303
                    if rest.starts_with('"') { Some(rest) } else { None }
                })
                if val_start == Some(value) {
                    inner :: value[1..]
                    if inner.rfind('"') == Some(end) { extract_alternation_words(inner[..end].to_string(), &words) }
                }
            }
        }
    }
    words
}
// Rust: tests/grammar.rs:414
pub fn extract_alternation_words(pattern: String, out: &Set<String>) -> {
    rest := pattern
    while rest.find('(') == Some(open) {
        inner_start :: open + 1
        close :: match rest[inner_start..].find(')') { Some(close) -> close, None -> break }
        group :: rest[inner_start..inner_start + close]
        if !group.contains('(') && !group.contains('\\') {
            for word in group.split('|') {
                w := word.trim() // #4303
                if !w.is_empty() && w.chars().all((c) -> c.is_alphanumeric() || c == '_') { _ :: out.insert(w.to_string()) }
            }
        }
        rest = rest[inner_start + close + 1..]
    }
}
// Rust: tests/grammar.rs:440
pub fn extract_foreign_words_from_syntax(syntax_text: String) -> Set<String> {
    words := Set<String>.new()
    for line in syntax_text.lines() {
        trimmed := line.trim() // #4303
        if trimmed.starts_with("pub const FOREIGN_") {
            if trimmed.rfind('"') == Some(start) {
                before :: trimmed[..start]
                if before.rfind('"') == Some(end) {
                    word :: before[end + 1..]
                    if !word.is_empty() && !word.contains(' ') && word.chars().all((c) -> c.is_alphanumeric() || c == '_') { _ :: words.insert(word.to_string()) }
                }
            }
        }
    }
    words
}
