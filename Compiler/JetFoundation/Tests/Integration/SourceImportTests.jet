with Interfaces.C;
package Geodesy is
   subtype Latitude is Interfaces.C.double range -90.0 .. 90.0;
   function Double_Lat (Lat : Latitude) return Interfaces.C.double
     with Export, Convention => C, External_Name => "geo_double";
end Geodesy;
""").unwrap()
    fs.write(source_dir.join("geodesy.adb"), "package body Geodesy is begin null; end Geodesy;\n").unwrap()
    output :: run(root, ["import", "ada", "ada/app"])
    assert_eq(output.status.code(), Val(0), "{String.from_utf8_lossy(output.stderr)}")
    stdout :: String.from_utf8(output.stdout).unwrap()
    assert(stdout.contains("0 functions, 0 carried tests, 1 TODO diagnostics"), "{stdout}")
    generated :: fs.read_to_string(root.join("jet/app/geodesy.jet")).unwrap()
    loop field in ["Generated by jet import ada", "use ada.geodesy as geodesy", "TODO JT0101", "canonical source of truth"] { assert(generated.contains(field), "{generated}") }
    assert(!generated.contains("fn double_lat"), "Ada source became guessed Jet: {generated}")
    checked :: run(root, ["check", "jet/app/geodesy.jet"])
    assert_eq(checked.status.code(), Val(0), "generated Ada stub failed its own front end:\n{String.from_utf8_lossy(checked.stderr)}")
    report :: fs.read_to_string(root.join("jet/app/import-report.json")).unwrap()
    loop field in ["\"language\":\"ada\"", "geodesy.ads", "\"code\":\"JT0101\"", "\"migration_status\":\"omitted-reported\""] { assert(report.contains(field), "{report}") }
}

// Rust: tests/source_import.rs:326
#Test("source_import_dry_run_idempotence_and_three_way_update_are_honest") {
    root :: workspace("rerun")
    source :: root.join("python/app/main.py")
    fs.write(source, "def answer() -> int:\n    return 42\n").unwrap()
    preview :: run(root, ["import", "py", "python/app", "--dry-run"])
    assert_eq(preview.status.code(), Val(0))
    assert(!root.join("jet").exists(), "dry-run wrote output")
    first :: run(root, ["import", "py", "python/app"])
    assert_eq(first.status.code(), Val(0))
    generated :: root.join("jet/app/main.jet")
    original :: fs.read_to_string(generated).unwrap()
    rerun :: run(root, ["import", "py", "python/app"])
    assert_eq(rerun.status.code(), Val(0), "{String.from_utf8_lossy(rerun.stderr)}")
    assert_eq(fs.read_to_string(generated).unwrap(), original)
    edited :: original + "\nfn owner_edit() {}\n"
    fs.write(generated, edited).unwrap()
    create_conflict :: run(root, ["import", "py", "python/app"])
    assert_eq(create_conflict.status.code(), Val(1))
    assert_eq(String.from_utf8_lossy(create_conflict.stderr).replace(root.display().to_string(), "$ROOT"), #IncludeText("tests/fixtures/source_import/conflict.stderr"))
    preserve :: run(root, ["import", "py", "python/app", "--update"])
    assert_eq(preserve.status.code(), Val(0), "{String.from_utf8_lossy(preserve.stderr)}")
    assert_eq(fs.read_to_string(generated).unwrap(), edited)
    report :: root.join("jet/app/import-report.json")
    report_original :: fs.read_to_string(report).unwrap()
    report_edited :: report_original + "\n{\"owner_note\":true}\n"
    fs.write(report, report_edited).unwrap()
    report_preserve :: run(root, ["import", "py", "python/app", "--update"])
    assert_eq(report_preserve.status.code(), Val(1))
    assert(String.from_utf8_lossy(report_preserve.stderr).contains("JT0199"))
    assert_eq(fs.read_to_string(report).unwrap(), report_edited)
    fs.write(source, "def answer() -> int:\n    return 43\n").unwrap()
    both_changed :: run(root, ["import", "py", "python/app", "--update"])
    assert_eq(both_changed.status.code(), Val(1))
    assert(String.from_utf8_lossy(both_changed.stderr).contains("JT0199"))
    assert_eq(fs.read_to_string(generated).unwrap(), edited)
    assert_eq(fs.read_to_string(report).unwrap(), report_edited)
}

// Rust: tests/source_import.rs:386
#Test("source_import_rejects_unknown_language_and_does_not_follow_symlinks") {
    root :: workspace("hostile")
    fs.write(root.join("python/app/good.py"), "def Ok() -> int:\n    return 1\n").unwrap()
    unknown :: run(root, ["import", "ruby", "python/app"])
    assert_eq(unknown.status.code(), Val(2))
    assert(!root.join("jet").exists())
    // GATE #4483: original cfg(unix) uses selected target family.
    if target.selected_family() == "unix" {
        // GATE #4494: actual native symbolic link, never traversal emulation.
        std.os.unix.fs.symlink("/etc", root.join("python/app/outside")).unwrap()
        output :: run(root, ["import", "py", "python/app"])
        assert_eq(output.status.code(), Val(0))
        count :: fs.read_dir(root.join("jet/app")).unwrap().filter_map((entry) -> entry.ok()).filter((entry) -> entry.path().extension().and_then((v) -> v.to_str()) == Val("jet")).count()
        assert_eq(count, 1)
    }
}

// Rust: tests/source_import.rs:414
#Test("enterprise_importers_match_scalar_behavior_fixtures_and_keep_source_unchanged") {
    cases :: [
        ("java", "java", #IncludeText("tests/fixtures/source_import/enterprise/java/Math.java"), "fn add(left: Int, right: Int) -> Int {", "5\n"),
        ("csharp", "cs", #IncludeText("tests/fixtures/source_import/enterprise/csharp/Math.cs"), "fn add(left: Int, right: Int) -> Int {", "5\n"),
        ("ts", "ts", #IncludeText("tests/fixtures/source_import/enterprise/ts/math.ts"), "fn add(left: Float, right: Float) -> Float {", "5.0\n"),
        ("js", "js", #IncludeText("tests/fixtures/source_import/enterprise/js/math.js"), "fn add(left: Float, right: Float) -> Float {", "5.0\n"),
        ("go", "go", #IncludeText("tests/fixtures/source_import/enterprise/go/math.go"), "fn add(left: Int, right: Int) -> Int {", "5\n")
    ]
    loop (language, extension, source, signature, expected_output) in cases {
        root :: workspace("enterprise-{language}")
        source_dir :: root.join(language).join("app")
        fs.create_dir_all(source_dir).unwrap()
        source_path :: source_dir.join("program.{extension}")
        fs.write(source_path, source).unwrap()
        source_arg :: "{language}/app"
        imported :: run(root, ["import", language, source_arg])
        assert_eq(imported.status.code(), Val(0), "{language}: {String.from_utf8_lossy(imported.stderr)}")
        generated_path :: root.join("jet/app/program.jet")
        generated :: fs.read_to_string(generated_path).unwrap()
        assert(generated.contains(signature), "{language}: {generated}")
        assert(generated.contains("// Source span:"), "{language}: {generated}")
        assert(generated.contains("D-MIGRATE-SRC1"), "{language}: {generated}")
        assert(!generated.contains("fn unsupported"), "{language}: {generated}")
        assert_eq(fs.read_to_string(source_path).unwrap(), source)
        report :: fs.read_to_string(root.join("jet/app/import-report.json")).unwrap()
        loop field in ["\"law\":\"D-MIGRATE-SRC1\"", "\"source_span\":", "\"generated_target\":", "\"code\":\"JT0101\""] { assert(report.contains(field), "{language}: {report}") }
        checked :: run(root, ["check", "jet/app/program.jet"])
        assert_eq(checked.status.code(), Val(0), "{language}: generated Jet failed its own front end:\n{String.from_utf8_lossy(checked.stderr)}")
        translated :: run(root, ["run", "jet/app/program.jet"])
        assert_eq(translated.status.code(), Val(0), "{language}: {String.from_utf8_lossy(translated.stderr)}")
        assert_eq(translated.stdout, expected_output.as_bytes(), "{language}")
        rerun :: run(root, ["import", language, source_arg])
        assert_eq(rerun.status.code(), Val(0), "{language}: rerun failed")
        assert_eq(fs.read_to_string(generated_path).unwrap(), generated)
    }
}

// Rust: tests/source_import.rs:621
#Test("enterprise_importers_match_foreign_oracle_where_toolchain_present") {
    cases :: [
        ("java", "java", #IncludeText("tests/fixtures/source_import/enterprise/java/Math.java")),
        ("csharp", "cs", #IncludeText("tests/fixtures/source_import/enterprise/csharp/Math.cs")),
        ("ts", "ts", #IncludeText("tests/fixtures/source_import/enterprise/ts/math.ts")),
        ("js", "js", #IncludeText("tests/fixtures/source_import/enterprise/js/math.js")),
        ("go", "go", #IncludeText("tests/fixtures/source_import/enterprise/go/math.go"))
    ]
    matched := []
    unavailable := []
    loop (language, extension, source) in cases {
        root :: workspace("oracle-{language}")
        source_dir :: root.join(language).join("app")
        fs.create_dir_all(source_dir).unwrap()
        fs.write(source_dir.join("program.{extension}"), source).unwrap()
        oracle :: match foreign_oracle(language, source, root.join("oracle")) {
            Val(output) -> output
            None -> { unavailable.push(language); continue }
        }
        assert(oracle.status.success(), "{language} oracle failed:\n{String.from_utf8_lossy(oracle.stderr)}")
        imported :: run(root, ["import", language, "{language}/app"])
        assert_eq(imported.status.code(), Val(0), "{language}: {String.from_utf8_lossy(imported.stderr)}")
        translated :: run(root, ["run", "jet/app/program.jet"])
        assert_eq(translated.status.code(), Val(0), "{language}: {String.from_utf8_lossy(translated.stderr)}")
        assert_eq(numeric_lines(translated.stdout), numeric_lines(oracle.stdout), "{language}: imported Jet diverged from its foreign oracle")
        matched.push(language)
    }
    io.eprintln("foreign oracle matched: {matched:?}")
    io.eprintln("foreign oracle UNAVAILABLE (toolchain missing, not proven): {unavailable:?}")
    assert(!matched.is_empty(), "no tier-one importer had a foreign toolchain; nothing was proven")
}

// Rust: tests/source_import.rs:675
#Test("enterprise_import_reports_ambiguity_malformed_input_and_no_cpp_importer") {
    root :: workspace("enterprise-failures")
    source_dir :: root.join("java/app")
    fs.create_dir_all(source_dir).unwrap()
    source_path :: source_dir.join("Ambiguous.java")
    source :: #IncludeText("tests/fixtures/source_import/enterprise/failures/ambiguous.java")
    fs.write(source_path, source).unwrap()
    imported :: run(root, ["import", "java", "java/app"])
    assert_eq(imported.status.code(), Val(0))
    generated_path :: root.join("jet/app/Ambiguous.jet")
    generated :: fs.read_to_string(generated_path).unwrap()
    assert(generated.contains("fn keep(value: Int) -> Int {"), "{generated}")
    assert(!generated.contains("fn add"), "ambiguous overload was guessed: {generated}")
    assert(!generated.contains("fn quotient"), "foreign division was guessed: {generated}")
    assert(!generated.contains("fn broken"), "malformed body was guessed: {generated}")
    assert_eq(fs.read_to_string(source_path).unwrap(), source)
    report :: fs.read_to_string(root.join("jet/app/import-report.json")).unwrap()
    loop field in ["unsupported java dependency declaration", "ambiguous overloaded java function", "foreign division or remainder semantics", "malformed java function", "\"migration_status\":\"omitted-reported\""] { assert(report.contains(field), "{report}") }
    checked :: run(root, ["check", "jet/app/Ambiguous.jet"])
    assert_eq(checked.status.code(), Val(0), "{String.from_utf8_lossy(checked.stderr)}")
    loop language in ["c", "c++"] {
        unavailable :: run(root, ["import", language, "java/app"])
        assert_eq(unavailable.status.code(), Val(2), "{language}")
        stderr :: String.from_utf8_lossy(unavailable.stderr)
        assert(stderr.contains("intentionally unavailable"), "{language}: {stderr}")
        assert(stderr.contains("binder"), "{language}: {stderr}")
    }
}

// Rust: tests/source_import.rs:745
#Test("javascript_import_does_not_rewrite_foreign_names_inside_strings") {
    root :: workspace("javascript-string")
    source_dir :: root.join("javascript/app")
    fs.create_dir_all(source_dir).unwrap()
    source :: """
/** @returns {string} */
function label() {
    return "console.log(";
}
"""
    source_path :: source_dir.join("labels.js")
    fs.write(source_path, source).unwrap()
    imported :: run(root, ["import", "js", "javascript/app"])
    assert_eq(imported.status.code(), Val(0))
    generated :: fs.read_to_string(root.join("jet/app/labels.jet")).unwrap()
    assert(generated.contains("return \"console.log(\""), "{generated}")
    assert_eq(fs.read_to_string(source_path).unwrap(), source)
    translated :: run(root, ["run", "jet/app/labels.jet"])
    assert_eq(translated.status.code(), Val(0))
    assert_eq(translated.stdout, "console.log(\n".as_bytes())
}

// Rust: tests/source_import.rs:769
#Test("enterprise_import_preserves_source_for_partial_failure") {
    root :: workspace("enterprise-partial-failure")
    source_dir :: root.join("ts/app")
    fs.create_dir_all(source_dir).unwrap()
    source :: #IncludeText("tests/fixtures/source_import/enterprise/failures/partial.ts")
    source_path :: source_dir.join("partial.ts")
    fs.write(source_path, source).unwrap()
    imported :: run(root, ["import", "ts", "ts/app"])
    assert_eq(imported.status.code(), Val(0), "{String.from_utf8_lossy(imported.stderr)}")
    generated_path :: root.join("jet/app/partial.jet")
    generated :: fs.read_to_string(generated_path).unwrap()
    assert(generated.contains("fn keep(value: Float) -> Float {"), "{generated}")
    assert(generated.contains("increment := value + 1.0"), "{generated}")
    loop omitted in ["unsupported", "broken", "duplicate", "readFile"] { assert(!generated.contains("fn {omitted}"), "unproven function `{omitted}` was guessed: {generated}") }
    assert_eq(fs.read_to_string(source_path).unwrap(), source)
    report :: fs.read_to_string(root.join("jet/app/import-report.json")).unwrap()
    loop reason in ["unsupported ts dependency declaration", "foreign type `number[]` is outside the scalar importer subset", "ts body `broken` was not translated", "ambiguous overloaded ts function `duplicate`"] { assert(report.contains(reason), "{reason}: {report}") }
    assert(report.matches("\"migration_status\":\"omitted-reported\"").count() >= 4, "{report}")
    checked :: run(root, ["check", "jet/app/partial.jet"])
    assert_eq(checked.status.code(), Val(0), "partial import generated invalid Jet:\n{String.from_utf8_lossy(checked.stderr)}")
}
