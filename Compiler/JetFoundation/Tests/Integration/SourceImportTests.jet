// Rust: tests/source_import.rs:128
#Test("python_source_import_matches_python_oracle_fixed_corpus") {
    root :: workspace("differential")
    fs.write(root.join("python/app/corpus.py"), #IncludeText("tests/fixtures/source_import/corpus.py")).unwrap()
    imported :: run(root, ["import", "py", "python/app"])
    assert_eq(imported.status.code(), Val(0), "{String.from_utf8_lossy(imported.stderr)}")
    generated :: root.join("jet/app/corpus.jet")
    assert_eq(fs.read_to_string(generated).unwrap(), #IncludeText("tests/fixtures/source_import/corpus.jet"))
    checked :: run(root, ["check", "jet/app/corpus.jet"])
    assert_eq(checked.status.code(), Val(0), "generated Jet failed its own front end:\n{String.from_utf8_lossy(checked.stderr)}")
    // GATE #4494: source-language process oracle, not a Python editing tool.
    oracle :: Command.new("python3").current_dir(root).args(["-c", "import runpy; runpy.run_path('python/app/corpus.py')['run']()"]).output().expect("Python 3 is the source-language differential oracle")
    assert_eq(oracle.status.code(), Val(0), "{String.from_utf8_lossy(oracle.stderr)}")
    assert_eq(oracle.stdout, #IncludeText("tests/fixtures/source_import/corpus.out").as_bytes())
    translated :: run(root, ["run", "jet/app/corpus.jet"])
    assert_eq(translated.status.code(), Val(0), "{String.from_utf8_lossy(translated.stderr)}")
    assert_eq(translated.stderr, oracle.stderr)
    assert_eq(translated.stdout, oracle.stdout, "imported output diverged from Python oracle")
}

// Rust: tests/source_import.rs:191
#Test("pascal_source_import_preserves_source_and_emits_binder_todo") {
    root :: workspace("pascal")
    source_dir :: root.join("pascal/app")
    fs.create_dir_all(source_dir).unwrap()
    fs.write(source_dir.join("inventory.pas"), """
library inventory;
function add_scalar(A, B: Int64): Int64; cdecl;
begin Result := A + B; end;
exports add_scalar;
begin end.
""").unwrap()
    output :: run(root, ["import", "pascal", "pascal/app"])
    assert_eq(output.status.code(), Val(0), "{String.from_utf8_lossy(output.stderr)}")
    stdout :: String.from_utf8(output.stdout).unwrap()
    assert(stdout.contains("0 functions, 0 carried tests, 1 TODO diagnostics"), "{stdout}")
    assert(stdout.contains("JT0101"), "{stdout}")
    generated :: fs.read_to_string(root.join("jet/app/inventory.jet")).unwrap()
    loop field in ["Generated by jet import pascal", "use pascal.inventory as inventory", "TODO JT0101", "canonical source of truth"] { assert(generated.contains(field), "{generated}") }
    assert(!generated.contains("fn add_scalar"), "Pascal source became guessed Jet: {generated}")
    checked :: run(root, ["check", "jet/app/inventory.jet"])
    assert_eq(checked.status.code(), Val(0), "binder stub failed its own front end:\n{String.from_utf8_lossy(checked.stderr)}")
    report :: fs.read_to_string(root.join("jet/app/import-report.json")).unwrap()
    loop field in ["\"language\":\"pascal\"", "inventory.pas", "\"code\":\"JT0101\"", "\"migration_status\":\"omitted-reported\""] { assert(report.contains(field), "{report}") }
}

// Rust: tests/source_import.rs:257
#Test("ada_source_import_preserves_package_and_emits_binder_todo") {
    root :: workspace("ada")
    source_dir :: root.join("ada/app")
