use Compiler.JetFoundation.Tests.Integration.SourceImport.*
use core.fs as fs
use core.sys.target as target
use std.process.[Command]
use std.io as io
use jet_foundation.Registry as Registry

// Rust: tests/source_import.rs:34
#Test("python_source_import_translates_real_subset_and_reports_every_gap") {
    root :: workspace("vertical")
    fs.write(root.join("python/app/math.py"), """
import decimal

def add(x: int, y: int) -> int:
    total = x + y
    return total

def test_add() -> None:
    assert add(2, 3) == 5

def risky(x: int) -> int:
    if x > 0:
        return x
    raise RuntimeError("negative")
""").unwrap()
    output :: run(root, ["import", "py", "python/app"])
    assert_eq(output.status.code(), Val(0), "{String.from_utf8_lossy(output.stderr)}")
    stdout :: String.from_utf8(output.stdout).unwrap()
    assert_eq(stdout.replace(root.display().to_string(), "$ROOT"), #IncludeText("tests/fixtures/source_import/vertical.stdout"))
    assert(stdout.contains("2 functions, 1 carried tests, 2 TODO diagnostics"), "{stdout}")
    assert(stdout.contains("JT0101"), "{stdout}")
    generated :: fs.read_to_string(root.join("jet/app/math.jet")).unwrap()
    assert(generated.contains("fn add(x: Int, y: Int) -> Int {"), "{generated}")
    assert(generated.contains("total := x + y"), "{generated}")
    assert(generated.contains("#Test fn test_add()"), "{generated}")
    assert(generated.contains("assert_eq(add(2, 3), 5)"), "{generated}")
    assert(!generated.contains("fn risky"), "unsupported body became fake code: {generated}")
    assert(!generated.contains("decimal"), "unsupported import leaked into output: {generated}")
    checked :: run(root, ["check", "jet/app/math.jet"])
    assert_eq(checked.status.code(), Val(0), "generated Jet failed its own front end:\n{String.from_utf8_lossy(checked.stderr)}")
    report :: fs.read_to_string(root.join("jet/app/import-report.json")).unwrap()
    assert(Registry.diagnostic("JT0101").is_some())
    loop field in ["\"schema\":\"jet.source-import.v1\"", "\"code\":\"JT0101\"", "\"what\":", "\"why\":", "\"fix\":", "\"source\":", "\"generated_target\":", "\"migration_status\":\"omitted-reported\""] { assert(report.contains(field), "{report}") }
}

