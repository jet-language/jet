#FFI(c)
fn openpty(master: &I32, slave: &I32, name: mem.Ptr<I8>, termp: mem.Ptr<U8>, winp: mem.Ptr<U8>) -> I32
// Rust: tests/os_native.rs:342
#FFI(c)
fn tcgetattr(fd: I32, termios: mem.Ptr<U8>) -> I32
// Rust: tests/os_native.rs:343
#FFI(c)
fn fcntl(fd: I32, command: I32, ...) -> I32
// Rust: tests/os_native.rs:347
pub enum PtyRead { Bytes([U8]), End }

// Rust: tests/os_native.rs:353
pub fn open_test_pty() -> (fs.File, fs.File) {
    master_fd := I32(-1)
    slave_fd := I32(-1)
    #Unsafe("openpty writes live fd slots; no optional name, termios or window buffer supplied") {
        assert_eq(openpty(&master_fd, &slave_fd, mem.Ptr<I8>.null(), mem.Ptr<U8>.null(), mem.Ptr<U8>.null()), 0, "openpty must provide a real PTY")
    }
    assert(master_fd >= 0 && slave_fd >= 0, "openpty returned invalid fds")
    // Tie reader EIO/EOF to the child instead of accidental inheritable clones.
    for fd in [master_fd, slave_fd] {
        #Unsafe("fcntl operates on fresh openpty descriptors and sets close-on-exec") {
            flags :: fcntl(fd, 1)
            assert(flags >= 0, "fcntl(F_GETFD) failed for PTY fd {fd}")
            assert_eq(fcntl(fd, 2, flags | 1), 0, "fcntl(FD_CLOEXEC) failed")
        }
    }
    #Unsafe("each fresh descriptor transfers exactly once to its File owner") {
        (fs.File.from_raw_fd(master_fd), fs.File.from_raw_fd(slave_fd))
    }
}

// Rust: tests/os_native.rs:384
pub fn read_pty_termios(slave: &fs.File, layout: &[String: USize]) -> [U8] {
    size :: layout.get("size").expect("termios size metric")
    assert(size > 0 && size <= 256, "termios size outside probe buffer: {size}")
    words := [U64(0); size.div_ceil(mem.size_of<U64>())]
    #Unsafe("aligned U64 storage covers the probed termios size; copy only initialized termios bytes") {
        rc :: tcgetattr(slave.as_raw_fd(), words.as_mut_ptr().cast<U8>())
        assert_eq(rc, 0, "tcgetattr failed for PTY inspection")
        std.slice.from_raw_parts(words.as_ptr().cast<U8>(), size).to_vec()
    }
}

// Rust: tests/os_native.rs:401
pub fn termios_lflag(bytes: &[U8], layout: &[String: USize]) -> U64 {
    offset :: layout.get("c_lflag").expect("termios c_lflag metric")
    width :: layout.get("flag_size").expect("termios flag size metric")
    assert(width > 0 && width <= 8 && offset + width <= bytes.len())
    raw := [U8(0); 8]
    raw[..width].copy_from_slice(&bytes[offset..offset + width])
    U64.from_ne_bytes(raw)
}

// Rust: tests/os_native.rs:414
pub fn pty_contains(bytes: &[U8], marker: &[U8]) -> Bool {
    !marker.is_empty() && bytes.windows(marker.len()).any(fn(window) { window == marker })
}

// Rust: tests/os_native.rs:419
pub fn wait_for_pty_marker(child: &Child, reader: &mpsc.Receiver<PtyRead>, transcript: &[U8], marker: &[U8], what: String, timeout: Duration) -> Unit {
    deadline :: Instant.now() + timeout
    while !pty_contains(transcript, marker) {
        remaining :: deadline.saturating_duration_since(Instant.now())
        assert(!remaining.is_zero(), "{what} did not arrive within {timeout:?}; child={child.try_wait().ok().flatten():?}; transcript={String.from_utf8_lossy(transcript):?}")
        match reader.recv_timeout(remaining) {
            .Ok(.Bytes(bytes)) -> transcript.extend(bytes)
            .Ok(.End) -> panic("PTY reader reached EOF before {what}; child={child.try_wait().ok().flatten():?}; transcript={String.from_utf8_lossy(transcript):?}")
            .Err(error) -> panic("PTY reader stopped before {what}: {error}; child={child.try_wait().ok().flatten():?}; transcript={String.from_utf8_lossy(transcript):?}")
        }
    }
}

// Rust: tests/os_native.rs:454
pub fn wait_for_pty_mode(slave: &fs.File, layout: &[String: USize], predicate: fn(U64) -> Bool, what: String) -> [U8] {
    deadline :: Instant.now() + Duration.from_secs(10)
    loop {
        bytes :: read_pty_termios(slave, layout)
        if predicate(termios_lflag(&bytes, layout)) { return bytes }
        assert(Instant.now() < deadline, "{what} did not become observable within 10 seconds")
        thread.sleep(Duration.from_millis(5))
    }
}

