// Rust: tests/os_native.rs:510
// GATE #4494: child stdio owns real PTY descriptors; native thread/channel reader.
pub fn run_termios_pty_case(mode: String, source: String, failure: Bool, layout: &[String: USize]) -> Unit {
    kind :: if failure -> "fail" else -> "ok"
    dir :: temp_dir("termios-pty-{mode}-{kind}")
    entry :: dir.join("main.jet")
    fs.write(&entry, source).unwrap()
    fs.write(dir.join("package.jet"), TERM_PTY_PACKAGE).unwrap()
    (master, slave) := open_test_pty()
    inspect :: slave.try_clone().expect("PTY inspection clone")
    baseline :: read_pty_termios(&inspect, layout)
    baseline_lflag :: termios_lflag(&baseline, layout)
    echo :: layout.get("echo").expect("termios ECHO metric") as U64
    icanon :: layout.get("icanon").expect("termios ICANON metric") as U64
    assert_ne(baseline_lflag & echo, 0, "openpty baseline must have ECHO set")
    assert_ne(baseline_lflag & icanon, 0, "openpty baseline must have ICANON set")
    args := ["run", "--quiet"]
    // Retired release/default/interpret tiers become native O2/O1/O0 behavioral journeys.
    match mode {
        "O2" -> args.push("-O2")
        "O1" -> args.push("-O1")
        "O0" -> args.push("-O0")
        other -> panic("unknown PTY mode {other}")
    }
    args.push(entry.to_str().unwrap())
    child := Command.new(env.cargo_bin_exe("jet")).args(args).current_dir(&dir)
        .env("NO_COLOR", "1").env("JET_STORE_DIR", dir.join("cache"))
        .env("JET_RUN_CACHE_DIR", dir.join("run-cache")).env("JETPACK_ROOT", dir.join("jetpack"))
        .stdin(Stdio.from(slave.try_clone().unwrap())).stdout(Stdio.from(slave.try_clone().unwrap()))
        .stderr(Stdio.from(^slave)).spawn().unwrap_or_else(fn(error) { panic("{mode} PTY child must start: {error}") })
    (tx, rx) :: mpsc.channel<PtyRead>()
    reader := master.try_clone().expect("PTY reader clone")
    reader_thread :: thread.spawn(fn() {
        chunk := [U8(0); 4096]
        loop {
            match reader.read(&chunk) {
                .Ok(0) -> { _ :: tx.send(.End); break }
                .Ok(count) -> { if tx.send(.Bytes(chunk[..count].to_vec())).is_err() { break } }
                .Err(error) -> {
                    if error.raw_os_error() == Some(5) { _ :: tx.send(.End); break }
                    panic("PTY reader failed: {error}")
                }
            }
        }
    })
    transcript := []
    wait_for_pty_marker(&child, &rx, &transcript, b"ready", "PTY ready marker", Duration.from_secs(60))
    _raw :: wait_for_pty_mode(&inspect, layout, fn(flags) { flags & echo == 0 && flags & icanon == 0 }, "raw mode")
    master.write_all(b"x").expect("write PTY raw key")
    if failure {
        status :: wait_bounded(&child, "{mode} failure PTY child")
        restored :: read_pty_termios(&inspect, layout)
        assert_eq(restored, baseline, "{mode} injected failure did not restore the complete termios state")
        drop(^inspect)
        loop {
            match rx.recv_timeout(Duration.from_secs(1)) {
                .Ok(.Bytes(bytes)) -> transcript.extend(bytes)
                .Ok(.End) -> break
                .Err(_) -> break
            }
        }
        reader_thread.join().expect("PTY reader thread")
        assert(!status.success(), "{mode} injected failure unexpectedly succeeded")
        output :: String.from_utf8_lossy(&transcript)
        assert(output.contains("injected terminal failure"), "{mode} failure did not reach the injected runtime stop: {output:?}")
        _ :: fs.remove_dir_all(&dir)
        return
    }
    wait_for_pty_marker(&child, &rx, &transcript, b"raw-complete", "raw completion marker", Duration.from_secs(10))
    _secret :: wait_for_pty_mode(&inspect, layout, fn(flags) { flags & echo == 0 && flags & icanon == baseline_lflag & icanon }, "secret echo-off mode")
    master.write_all(b"answer\n").expect("write PTY secret")
    wait_for_pty_marker(&child, &rx, &transcript, b"secret-ok:answer", "secret success marker", Duration.from_secs(10))
    status :: wait_bounded(&child, "{mode} success PTY child")
    restored :: read_pty_termios(&inspect, layout)
    assert_eq(restored, baseline, "{mode} successful terminal use did not restore the complete termios state")
    drop(^inspect)
    loop {
        match rx.recv_timeout(Duration.from_secs(1)) {
            .Ok(.Bytes(bytes)) -> transcript.extend(bytes)
            .Ok(.End) -> break
            .Err(_) -> break
        }
    }
    reader_thread.join().expect("PTY reader thread")
    assert(status.success(), "{mode} successful PTY child failed: {status}")
    output :: String.from_utf8_lossy(&transcript)
    assert(output.contains("secret-ok:answer"), "{mode} PTY output missing success: {output:?}")
    _ :: fs.remove_dir_all(&dir)
}

