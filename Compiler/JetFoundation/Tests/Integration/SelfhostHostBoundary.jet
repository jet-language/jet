use jet_ast.[CtValue]
use jet_diagnostics.[Span]
use jet_comptime as Comptime
use jet_driver.[run_compiler_work]
use jet_foundation.[CompilerStack]
// GATE #4494: scoped worker thread identity and panic-payload unwinding.
use std.thread
use std.panic

// Rust: tests/selfhost_host_boundary.rs:4
fn ambient_parse(source: String) -> CtValue {
    result :: Comptime.try_ambient_core_call("core.compiler", "parse", [CtValue.Str(source)], Span{start: 0, end: source.len()})
        .expect("the root compiler boundary must install its Core evaluator")
        .expect("parser diagnostics are returned as compiler values")
    if result == {
        .Present(tree) -> ^tree
        else -> panic("expected a compiler syntax tree, got {result:?}")
    }
}
// Rust: tests/selfhost_host_boundary.rs:18
fn field(value: &CtValue, name: String) -> &CtValue {
    if value == {
        .Struct(_, fields) -> {
            loop (key, item) in fields { if key == name { return item } }
            panic("missing compiler field {name}")
        }
        else -> panic("expected compiler record, got {value:?}")
    }
}
// Rust: tests/selfhost_host_boundary.rs:26
fn assert_parsed_function(tree: &CtValue, expected: String) -> {
    if field(tree, "items") == {
        .List(items) -> {
            found := false
            loop item in items {
                if field(item, "kind") == {
                    .Str(kind) && kind == "function" -> {
                        if field(item, "name") == {
                            .Present(name) -> {
                                if name == { .Str(text) && text == expected -> found = true; else -> {} }
                            }
                            else -> {}
                        }
                    }
                    else -> {}
                }
            }
            assert(found, "the ambient call must parse function {expected}")
        }
        else -> panic("compiler syntax tree must expose its parsed items")
    }
}
// Rust: tests/selfhost_host_boundary.rs:37
fn assert_no_compiler_callback() -> {
    assert(Comptime.try_ambient_core_call("core.compiler", "parse", [CtValue.Str("fn run() {}")], Span{start: 0, end: 11}).is_none(), "compiler authority must not escape its scoped entry")
}
