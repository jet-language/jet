    _ :: fs.remove_dir_all(base)
    root :: base.join("root")
    sibling :: base.join("root-sibling")
    fs.create_dir_all(root).unwrap()
    fs.create_dir_all(sibling).unwrap()
    fs.write(root.join("index.html"), "safe\n").unwrap()
    fs.write(sibling.join("secret.js"), "sibling-secret\n").unwrap()
    (port, guard) :: start_web_test_static_server(root)
    (status, content_type, _) :: http_get_with_content_type(port, "/").expect("GET / from static server")
