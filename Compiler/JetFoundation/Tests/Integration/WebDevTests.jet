use WebDev.[have_tool, jet_bin, unused_local_port, http_get, http_get_without_session, http_get_with_content_type, wait_for_app_preview, wait_for_ports, wait_for_version_change, wait_for_status, wait_for_file_text, wait_for_canvas_port, port_from_url_line, forget_canvas_session, start_web_test_static_server, KillOnDrop, FIXTURE_SRC, FIXTURE_SRC_EDITED]
use WebDev02.[wait_for_server_up]
use jet_driver as jet
// GATE #4494: real native CLI/TCP/fs/PTY/thread/channel/atomic/clock substrate.
use std.fs
use std.env
use std.process.[Command, Stdio]
use std.thread
use std.time.[Duration, Instant]
use std.sync.[Shared, mpsc]
use std.sync.atomic.[AtomicBool, AtomicUsize, Ordering]
use std.os.unix.fs.[symlink]
// GATE #4483: cfg(unix/windows) uses the selected execution target.
use core.sys.target

// Rust: tests/web_dev.rs:391
#Test("ui_showcase_uses_builtin_host_and_keeps_companion_page_live") {
    if !have_tool("rustc") { eprintln("note: skipping UI showcase dev host proof (need rustc)"); return }
    dir :: env.temp_dir().join("jet_ui_showcase_dev_{std.process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).unwrap()
    fs.write(dir.join("app.jet"), include_str("Examples/features/web/ui_web_click.jet")).unwrap()
    fs.write(dir.join("ui_web_click.html"), include_str("Examples/features/web/ui_web_click.html")).unwrap()
    port :: unused_local_port()
    child :: Command.new(jet_bin()).args(["dev", "app.jet", "--port={port}"]).current_dir(dir).stdout(Stdio.null()).stderr(Stdio.null()).spawn().expect("start UI showcase dev host")
    guard :: KillOnDrop{child: ^child}
    wait_for_server_up(port, Duration.from_secs(30))
    loop request in 0..<3 {
        (status, body) :: http_get(port, "/").expect("GET showcase companion page")
        assert_eq(status, 200, "request {request}")
        html :: String.from_utf8_lossy(body)
        assert(html.contains("<h1>Reactive counter, rendered live</h1>"), "request {request}: {html}")
        assert(html.contains("id=\"jet-app\"") && html.contains("jet_main"), "request {request}: showcase host served a generic shell")
    }
    (status, js) :: http_get(port, "/app.js").expect("GET showcase app.js")
    assert_eq(status, 200)
    assert(String.from_utf8_lossy(js).contains("function jet_main()"))
    drop(^guard)
    _ :: fs.remove_dir_all(dir)
}
// Rust: tests/web_dev.rs:452
#Test("jet_dev_web_serves_and_rebuilds_on_save") {
    if !have_tool("rustc") { eprintln("note: skipping jet_dev_web_serves_and_rebuilds_on_save (need rustc)"); return }
    dir :: env.temp_dir().join("jet_dev_web_{std.process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).unwrap()
    src_path :: dir.join("app.jet")
    fs.write(src_path, FIXTURE_SRC).unwrap()
    child := Command.new(jet_bin()).args(["dev", "app.jet", "--target=web"]).current_dir(dir).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().expect("failed to start `jet dev --target=web`")
    stdout :: child.stdout.take().unwrap()
    guard :: KillOnDrop{child: ^child}
    port :: wait_for_app_preview(^stdout)
    assert(port >= 8080 && port <= 8089, "default app preview port escaped the stable range: {port}")
    loop path in ["/C:/Windows/win.ini", "/\\Windows\\win.ini", "/\\\\server\\share\\secret"] {
        (status, _) :: http_get(port, path).expect("static-path hostile request failed")
        assert_eq(status, 400, "Windows absolute static path escaped the build root: {path}")
    }
    expected_initial :: jet.compile_web_with_path(FIXTURE_SRC, "app.jet").expect("front end rejected fixture").web.expect("web target compile must produce web artifacts").js_app
    (status, body) :: http_get(port, "/app.js").expect("GET /app.js failed")
    assert_eq(status, 200)
    served :: String.from_utf8_lossy(body)
    map_trailer :: "//# sourceMappingURL=app.js.map\n"
    stripped :: served.strip_suffix(map_trailer).unwrap_or_else(fn() { panic("served app.js must end with the dev source-map trailer") })
    assert_eq(stripped, expected_initial, "served app.js (minus the dev source-map trailer) should match a plain compile of the same source")
    (status, _) :: http_get(port, "/app.js.map").expect("GET /app.js.map failed")
    assert_eq(status, 200, "the referenced source map must be served")
    (status, version_body) :: http_get(port, "/__jet_dev_version").expect("GET /__jet_dev_version failed")
    assert_eq(status, 200)
    baseline_version := String.from_utf8_lossy(version_body).trim().to_string() // #4303
    (status, status_body) :: http_get(port, "/__jet_dev_status").expect("GET /__jet_dev_status failed")
    assert_eq(status, 200)
    status_text :: String.from_utf8_lossy(status_body)
    assert(status_text.contains("\"state\":\"ready\""), "{status_text}")
    assert(status_text.contains("\"clients\":"), "{status_text}")
    (status, html_body) :: http_get_without_session(port, "/").expect("GET / failed")
    assert_eq(status, 200)
    html :: String.from_utf8_lossy(html_body)
    assert(html.contains("__jet_dev_status") && html.contains("Build failed"), "served index.html should have the live-reload script injected")
    (status, _) :: http_get_without_session(port, "/canvas").expect("GET app listener Canvas path")
    assert_eq(status, 404, "the app listener must not expose the Canvas route")
    fs.write(src_path, FIXTURE_SRC_EDITED).unwrap()
    new_version :: wait_for_version_change(port, baseline_version, Duration.from_secs(15))
    assert_ne(new_version, baseline_version)
    expected_edited :: jet.compile_web_with_path(FIXTURE_SRC_EDITED, "app.jet").expect("front end rejected edited fixture").web.expect("web target compile must produce web artifacts").js_app
    (status, body) :: http_get(port, "/app.js").expect("GET /app.js (after edit) failed")
    assert_eq(status, 200)
    served_edited :: String.from_utf8_lossy(body)
    assert_eq(served_edited.strip_suffix(map_trailer).unwrap_or(served_edited), expected_edited, "served app.js should reflect the rebuilt (edited) source")
    assert_ne(expected_initial, expected_edited, "sanity: the edit should actually change generated JS, or this test proves nothing")
    drop(^guard)
    _ :: fs.remove_dir_all(dir)
}
// Rust: tests/web_dev.rs:582
#Test("jet_dev_web_publishes_from_a_repository_subdirectory") {
    if !have_tool("rustc") { eprintln("note: skipping jet_dev_web_publishes_from_a_repository_subdirectory (need rustc)"); return }
    root :: env.temp_dir().join("jet_dev_web_subdir_{std.process.id()}")
    _ :: fs.remove_dir_all(root)
    fs.create_dir_all(root.join(".git")).unwrap()
    app :: root.join("app")
    fs.create_dir_all(app).unwrap()
    fs.write(app.join("app.jet"), "fn run() -> {{\n    print(\"hello web\")\n}}\n").unwrap()
    port :: unused_local_port()
    child := Command.new(jet_bin()).args(["dev", "app.jet", "--target=web", "--port={port}"]).current_dir(app).stdout(Stdio.piped()).stderr(Stdio.null()).spawn().expect("failed to start `jet dev --target=web`")
    stdout :: child.stdout.take().unwrap()
    guard :: KillOnDrop{child: ^child}
    assert_eq(wait_for_app_preview(^stdout), port)
    (status, body) :: http_get(port, "/app.js").expect("GET /app.js failed")
    assert_eq(status, 200)
    trailer :: "//# sourceMappingURL=app.js.map\n".bytes()
    published :: fs.read(root.join(".jet/build/app.js")).expect("app.js published at the project root")
    assert_eq(published.strip_suffix(trailer).unwrap_or(published), body.strip_suffix(trailer).unwrap_or(body), "served app.js must be the bundle published under the project root")
    drop(^guard)
    _ :: fs.remove_dir_all(root)
}
// Rust: tests/web_dev.rs:630
#Test("tanstack_start_dev_reference_loop_recovers_last_good_browser_state") {
    if !have_tool("rustc") || !have_tool("node") || !have_tool("chromium") { eprintln("note: skipping TanStack reference dev loop (need rustc + node + chromium)"); return }
    repo :: OSPath.from(env.build_var("CARGO_MANIFEST_DIR"))
    root :: env.temp_dir().join("jet_tanstack_reference_dev_{std.process.id()}")
    _ :: fs.remove_dir_all(root)
    fs.create_dir_all(root.join("public")).unwrap()
    loop path in ["run.jet", "package.jet", "public/index.html", "public/app.css"] {
        source :: repo.join("Examples/features/web/tanstack_start").join(path)
        destination :: root.join(path)
        if destination.parent() == { .Val(parent) -> fs.create_dir_all(parent).unwrap(); .None -> {} }
        fs.copy(source, destination).unwrap()
    }
    output :: Command.new("node").env("CHROMIUM", "chromium").arg(repo.join("Tools/web-dev-test/reference_app.mjs"))
        .args(["--metric", "error_to_fix", "--manifest"]).arg(repo.join("Tools/agent-eval/dx/manifest.json"))
        .args(["--exercise", "--app", "tanstack-start-orders", "--jet-env"]).arg(repo.join("Tools/agent/jet-env")).current_dir(root).output().expect("run TanStack reference dev loop")
    assert(output.status.success(), "TanStack reference dev loop failed\nstdout:\n{String.from_utf8_lossy(output.stdout)}\nstderr:\n{String.from_utf8_lossy(output.stderr)}")
    stdout :: String.from_utf8_lossy(output.stdout)
    assert(stdout.contains("REFERENCE_METRIC:error_to_fix") && stdout.contains("diagnosis_ms=") && stdout.contains("repair_ms="), "reference dev loop did not report diagnosis and repair timing: {stdout}")
    _ :: fs.remove_dir_all(root)
}
