// Rust: tests/web_dev.rs:902
#Test("web_test_static_server_final_swap_stays_inside_root") {
    if target.selected_family() != "unix" { return }
    if !have_tool("node") { eprintln("note: skipping web_test_static_server_final_swap_stays_inside_root (need node)"); return }
    base :: env.temp_dir().join("jet-web-test-static-final-swap-{std.process.id()}")
    _ :: fs.remove_dir_all(base)
    root :: base.join("root")
    destination :: root.join("race.js")
    parked :: root.join("race.js.parked")
    outside :: base.join("outside.js")
    fs.create_dir_all(root).unwrap()
    fs.write(root.join("index.html"), "safe\n").unwrap()
    fs.write(destination, "inside-final\n").unwrap()
    fs.write(outside, "outside-final\n").unwrap()
    (port, guard) :: start_web_test_static_server(root)
    stop :: Shared.new(AtomicBool.new(false))
    leaked :: Shared.new(AtomicBool.new(false))
    swaps :: Shared.new(AtomicUsize.new(0))
    served :: Shared.new(AtomicUsize.new(0))
    swap_stop :: stop.clone()
    swap_target :: destination.clone()
    swap_parked :: parked.clone()
    swap_outside :: outside.clone()
    swap_count :: swaps.clone()
    swapper :: thread.spawn(fn() {
        loop !swap_stop.load(Ordering.Relaxed) {
            _ :: fs.remove_file(swap_parked)
            if fs.rename(swap_target, swap_parked).is_ok() {
                if symlink(swap_outside, swap_target).is_ok() { _ :: swap_count.fetch_add(1, Ordering.Relaxed) }
                _ :: fs.remove_file(swap_target)
                _ :: fs.rename(swap_parked, swap_target)
                thread.sleep(Duration.from_micros(50))
            }
        }
    })
    requests := [std.thread.JoinHandle<()>]{}
    loop _ in 0..<4 {
        request_leaked :: leaked.clone()
        request_served :: served.clone()
        &requests.push(thread.spawn(fn() {
            loop _ in 0..<256 {
                (status, body) :: http_get_without_session(port, "/race.js") ?? continue
                if status == 200 { _ :: request_served.fetch_add(1, Ordering.Relaxed) }
                if body.windows("outside-final".bytes().len()).any(fn(window) { window == "outside-final".bytes() }) { request_leaked.store(true, Ordering.Relaxed); break }
            }
        }))
    }
    loop request in requests { request.join().unwrap() }
    stop.store(true, Ordering.Relaxed)
    swapper.join().unwrap()
    assert(!leaked.load(Ordering.Relaxed))
    assert(swaps.load(Ordering.Relaxed) > 0)
    assert(served.load(Ordering.Relaxed) > 0)
    drop(^guard)
    _ :: fs.remove_dir_all(base)
}
