// Rust: tests/web_dev.rs:769
#Test("web_test_static_server_rejects_symlink_escape") {
    if target.selected_family() != "unix" { return }
    if !have_tool("node") { eprintln("note: skipping web_test_static_server_rejects_symlink_escape (need node)"); return }
    root :: env.temp_dir().join("jet-web-test-static-symlink-{std.process.id()}")
    _ :: fs.remove_dir_all(root)
    fs.create_dir_all(root).unwrap()
    fs.write(root.join("index.html"), "safe\n").unwrap()
    outside :: root.with_file_name("jet-web-test-static-outside-{std.process.id()}")
    fs.write(outside, "secret\n").unwrap()
    symlink(outside, root.join("escape.js")).unwrap()
    port :: unused_local_port()
    child :: Command.new("node").arg(OSPath.from(env.build_var("CARGO_MANIFEST_DIR")).join("Tools/web-test/serve.mjs"))
        .arg("--port").arg(port.to_string()).arg("--root").arg(root).stdout(Stdio.null()).stderr(Stdio.null()).spawn().expect("start web-test static server")
    guard :: KillOnDrop{child: ^child}
    start :: Instant.now()
    loop start.elapsed() < Duration.from_secs(10) {
        if http_get(port, "/") == { .Val((200, _)) -> break; else -> {} }
        thread.sleep(Duration.from_millis(25))
    }
    (status, _) :: http_get(port, "/escape.js").expect("static server request")
    assert_eq(status, 400, "symlink outside the static root was served")
    assert_eq(fs.read_to_string(outside).unwrap(), "secret\n")
    _ :: fs.remove_dir_all(root)
    _ :: fs.remove_file(outside)
}
