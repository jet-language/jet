// Rust: tests/suite_membership.rs:278
#Test("every_test_target_belongs_to_a_named_set") {
    ledger := parse_suite_ledger(fs.read_to_string(repo_root().join("tests/suites.txt")).unwrap())
    discovered := discover_test_targets()
    audit := audit_suite_ledger(ledger, discovered)
    eprint("suite membership: {audit.assigned} of {discovered.len()} declared test target(s) in a named set; {audit.unassigned.len()} in none:\n")
    loop target in audit.unassigned { eprint("  {target}\n") }
    assert(audit.ghosts.is_empty(), "tests/suites.txt names {audit.ghosts.len()} target(s) with no matching `.rs` file: {audit.ghosts:?}. A nonexistent target is a stale row to delete, never a set that failed.")
    assert(audit.duplicated.is_empty(), "{audit.duplicated.len()} target(s) appear in more than one section of tests/suites.txt, breaking that file's own invariant that every target belongs to exactly one set:\n{audit.duplicated.join("\n")}")
    assert(audit.reasonless.is_empty(), "{audit.reasonless.len()} target(s) are parked in `{HOST_GATED}:` without saying what gates them:\n{audit.reasonless.join("\n")}\nA target held out states its gate, or it is not held out — it is hidden, which is the whole defect (#2025).")
    assert(audit.empty_sets.is_empty(), "these named sets have no members: {audit.empty_sets:?}. An empty set is a name that will be cited as coverage it does not have — delete the name or give it members.")
    assert_eq(audit.assigned + audit.unassigned.len(), discovered.len(), "suite accounting is broken: {audit.assigned} assigned + {audit.unassigned.len()} unassigned != {discovered.len()} discovered target(s).")
    assert(audit.unassigned.len() <= UNASSIGNED_CEILING, "{audit.unassigned.len()} declared test target(s) belong to NO verification set (ceiling {UNASSIGNED_CEILING}):\n  {audit.unassigned.join("\n  ")}\nThat is how `golden`, `ban_bare_panic` and `jit_run` were each found red long after they broke. Put the target in the set it belongs to, or park it in `{HOST_GATED}:` with the observed gate AND a row in HOST_GATED_HELD_OUT.")
    assert(audit.assigned >= TEST_TARGET_FLOOR, "tests/suites.txt assigns {audit.assigned} target(s) but the ratchet floor is {TEST_TARGET_FLOOR}; rows may only GROW. A target that lost its row did not change set — it left the sets and went back to being unwatched. Lower the floor only in the same diff as a deleted test file.")
    held_out := HOST_GATED_HELD_OUT.iter().map((target, observed, _) -> (target.to_string(), observed.to_string())).collect()
    held_out_description := HOST_GATED_HELD_OUT.iter().map((target, observed, why) -> "{target} ({observed}) — {why}").collect().join("; ")
    assert_eq(audit.host_gated, held_out, "the `{HOST_GATED}:` section of tests/suites.txt and HOST_GATED_HELD_OUT disagree. A new entry is a target that stopped being routine; a vanished entry is one that can run again and must leave both places in the same diff. Held out: {held_out_description}")
}
// Rust: tests/suite_membership.rs:384
#Test("suite_ledger_audit_fires_on_a_target_in_no_set") {
    row := (target: String, set: String, observed: String) -> SuiteRow{target: target, set: set, observed: observed}
    ledger := [row("tests/golden", "guards", ""), row("tests/dev", "dev_loop", ""), row("tests/dev", "language", ""), row("tests/gone_yesterday", "guards", ""), row("tests/os_interrupt_windows", HOST_GATED, "")]
    discovered := ["tests/dev", "tests/golden", "tests/jit_run", "tests/os_interrupt_windows"]
    audit := audit_suite_ledger(ledger, discovered)
    assert_eq(audit.unassigned, ["tests/jit_run"], "a target in no set must be named, not counted away")
    assert_eq(audit.ghosts, ["tests/gone_yesterday"], "a row with no file must read as a stale row, never as a set change")
    assert_eq(audit.duplicated.len(), 1, "{audit.duplicated:?}")
    assert(audit.duplicated[0].contains("tests/dev") && audit.duplicated[0].contains("dev_loop") && audit.duplicated[0].contains("language"), "the duplicate must name both claiming sets: {audit.duplicated:?}")
    assert_eq(audit.reasonless.len(), 1, "{audit.reasonless:?}")
    assert(audit.reasonless[0].contains("tests/os_interrupt_windows"), "a parked row with no gate must be named: {audit.reasonless:?}")
    assert_eq(audit.empty_sets, ["runtime", "tooling", "surface"], "a named set with no members must be named too")
    assert_eq(audit.assigned, 3, "only targets that exist count toward the floor")
    assert_eq(audit.assigned + audit.unassigned.len(), discovered.len(), "the identity the pins rest on must hold on synthetic input too")
    assert_eq(audit.host_gated, [("tests/os_interrupt_windows", "")], "the parked section is reported for the exact compare")
}
// Rust: tests/suite_membership.rs:500
#Test("suite_budget_rows_stay_a_named_minority") {
    rows := common.parse_suite_budgets(common.SUITE_BUDGET_LEDGER).unwrap_or_else(err -> panic("{common.SUITE_BUDGET_LEDGER_PATH} does not parse, so the guard silently falls back to the 900s default for every listed suite: {err}"))
    discovered := discover_test_targets()
    violations := audit_suite_budgets(rows, discovered)
    eprint("suite budgets: {rows.len()} of {discovered.len()} declared test target(s) exceed the 900s default (ceiling {OVER_DEFAULT_BUDGET_CEILING}):\n")
    loop row in rows { eprint("  {row.suite} {row.secs}s — {row.reason}\n") }
    assert(violations.is_empty(), "{common.SUITE_BUDGET_LEDGER_PATH} is {violations.len()} row(s) wrong:\n  {violations.join("\n  ")}")
    description := rows.iter().map(row -> "{row.suite} {row.secs}s — {row.reason}").collect().join("\n  ")
    assert(rows.len() <= OVER_DEFAULT_BUDGET_CEILING, "{rows.len()} suite(s) now exceed the 900s guard default, over the ceiling of {OVER_DEFAULT_BUDGET_CEILING}:\n  {description}\nThe guard is flexible for a NAMED minority, not for the majority: a suite that outruns 900s is normally defective and gets split or sped up. If this row genuinely belongs, raise OVER_DEFAULT_BUDGET_CEILING in the same reviewed diff and say why here (#677).")
}
// Rust: tests/suite_membership.rs:552
#Test("suite_budget_audit_fires_on_a_row_that_should_not_exist") {
    discovered := ["tests/cli_compile_latency", "tests/some_unit_suite"]
    rows := [common.SuiteBudgetRow{suite: "cli_compile_latency", secs: 5400, reason: "ratified sample policy"}, common.SuiteBudgetRow{suite: "cli_compile_latency", secs: 4000, reason: "a second row for the same suite"}, common.SuiteBudgetRow{suite: "some_unit_suite", secs: 900, reason: "at the default, so it buys nothing"}, common.SuiteBudgetRow{suite: "deleted_suite", secs: 1200, reason: "target no longer exists"}]
    violations := audit_suite_budgets(rows, discovered)
    assert_eq(violations.len(), 3, "one row at the default, one naming no target, one duplicated: {violations:?}")
    assert(violations.iter().any(v -> v.contains("some_unit_suite") && v.contains("900s default")), "a row at the default must be named: {violations:?}")
    assert(violations.iter().any(v -> v.contains("deleted_suite") && v.contains("no test target")), "a row naming no target must be named: {violations:?}")
    assert(violations.iter().any(v -> v.contains("cli_compile_latency") && v.contains("2 rows")), "a duplicated row must be named: {violations:?}")
    reasonless := common.parse_suite_budgets("some_unit_suite 5400\n").expect_err("a reasonless row must be refused")
    assert(reasonless.contains("states no reason"), "{reasonless}")
    nonnumeric := common.parse_suite_budgets("some_unit_suite ninety minutes, please\n").expect_err("a non-numeric budget must be refused")
    assert(nonnumeric.contains("not a budget in whole seconds"), "{nonnumeric}")
}
