// GATE #4494: real filesystem, CLI subprocess and output capture throughout.
// Rust: tests/structure_liveness.rs:51
#Test("liveness_facts_and_fixes_are_one_checked_result") {
    source := fs.read_to_string(repo().join(example())).expect("liveness example source")
    bundle := load_entry(example()).expect("liveness example loads")
    diagnostics := check_bundle(&bundle, CompileMode.Run)
    codes := diagnostics.iter().map(diagnostic -> diagnostic.code).collect()
    codes.sort()
    assert_eq(codes, ["L0101", "L0103", "L0104", "L0105"])
    assert(diagnostics.iter().all(diagnostic -> diagnostic.severity == Severity.Lint && diagnostic.edit.is_some_and(edit -> edit.new_text.is_empty() || edit.new_text.starts_with('_'))))
    facts := bundle.name_ledger.structure_facts().iter().filter(fact -> fact.kind == StructureFactKind.Liveness).collect()
    assert_eq(facts.len(), 4)
    assert(facts.iter().all(fact -> fact.kind == StructureFactKind.Liveness && fact.gate == Some("_name") && fact.source == example()))
    assert(facts.iter().any(fact -> fact.subject == "support"))
    assert(facts.iter().any(fact -> fact.subject == "unused_binding"))
    assert(facts.iter().any(fact -> fact.subject == "unused_private"))
    assert(facts.iter().any(fact -> fact.subject == "package_export"))
    assert(!facts.iter().any(fact -> fact.subject == "library_pub"))
    loop diagnostic in diagnostics {
        span := diagnostic.span.expect("liveness diagnostic span")
        edit := diagnostic.edit.expect("liveness source edit")
        if edit.new_text.is_empty() {
            assert(diagnostic.code == "L0101" || diagnostic.code == "L0104")
            assert(edit.span.start <= span.start && edit.span.end >= span.end)
        } else {
            assert_eq(edit.span, span)
            assert_eq(edit.new_text, "_{source[span.start..span.end]}")
        }
    }
    text_output := run_jet(["inspect", "structure", example()])
    assert(text_output.status.success(), "structure inspect failed: {text_output:?}")
    text := String.from_utf8(text_output.stdout).expect("structure text is utf8")
    expected_text := fs.read_to_string(repo().join("Examples/features/expected/tooling/structure_liveness.structure.out")).expect("structure text golden")
    assert_eq(text, expected_text)
    loop subject in ["support", "unused_binding", "unused_private", "package_export"] { assert(text.contains(subject), "missing {subject} in {text}") }
    assert(text.contains("Structure.Liveness"))
    assert(text.contains("gates=_name"))
    json_output := run_jet(["inspect", "structure", "--json", example()])
    assert(json_output.status.success(), "JSON structure inspect failed: {json_output:?}")
    json := String.from_utf8(json_output.stdout).expect("structure JSON is utf8")
    expected_json := fs.read_to_string(repo().join("Examples/features/expected/tooling/structure_liveness.structure.json")).expect("structure JSON golden")
    assert_eq(json, expected_json)
    assert(json.contains("\"registry\":\"Structure.Liveness\""))
    assert(json.contains("\"gate\":\"_name\""))
    cache := env.temp_dir().join("jet_structure_liveness_tiers_{id()}")
    _ :: fs.remove_dir_all(cache)
    // Retired engine-specific checks become the shared O0/O1/O2 contract.
    loop (mode, args) in [("O2", ["run", "--release", example()]), ("O0", ["run", example()]), ("O1", ["build", example()])] {
        output := Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).current_dir(repo()).env("NO_COLOR", "1").env("JET_RUN_CACHE_DIR", cache.join(mode).join("run")).env("JET_STORE_DIR", cache.join(mode).join("build")).args(args).output().expect("run liveness example tier")
        assert(output.status.success(), "{mode} failed: stdout={String.from_utf8_lossy(output.stdout)} stderr={String.from_utf8_lossy(output.stderr)}")
        if mode == "O1" {
            // GATE #4483: executable suffix belongs to the selected target.
            suffix := if selected_os() == "windows" -> ".exe" else -> ""
            binary := build_project_root(example()).unwrap().join(".jet/build").join("structure_liveness{suffix}")
            executed := Command.new(binary).current_dir(repo()).env("NO_COLOR", "1").output().expect("run O1 liveness binary")
            assert(executed.status.success(), "O1 execution failed: {String.from_utf8_lossy(executed.stderr)}")
            assert_eq(executed.stdout, "structure liveness\n".bytes(), "{mode} output")
        } else { assert_eq(output.stdout, "structure liveness\n".bytes(), "{mode} output") }
        assert_liveness_warnings(mode, output)
    }
    dev := run_jet(["dev", example(), "--watch=off"])
    assert(dev.status.success(), "dev failed: stdout={String.from_utf8_lossy(dev.stdout)} stderr={String.from_utf8_lossy(dev.stderr)}")
    assert_eq(dev.stdout, "structure liveness\n".bytes(), "dev output")
    assert_liveness_warnings("dev", dev)
    loop (mode, args) in [
        ("policy-O2", ["run", "--release", "tests/ui/lint_policy_liveness/run.jet"]),
        ("policy-O0", ["run", "tests/ui/lint_policy_liveness/run.jet"]),
        ("policy-O1", ["build", "tests/ui/lint_policy_liveness/run.jet"]),
        ("policy-dev", ["dev", "tests/ui/lint_policy_liveness/run.jet", "--watch=off"])
    ] {
        output := run_jet(args)
        assert_liveness_policy_denied(mode, output)
    }
    _ :: fs.remove_dir_all(cache)
}
// Rust: tests/structure_liveness.rs:204
#Test("liveness_web_compile_keeps_the_same_front_end_result") {
    rustc := Command.new("rustc").args(["--print", "target-libdir", "--target", "wasm32-unknown-unknown"]).output().expect("probe wasm target")
    if !rustc.status.success() {
        eprint("note: skipping liveness web tier proof (wasm target unavailable)\n")
        return
    }
    output := run_jet(["build", "--target=web", example()])
    assert(output.status.success(), "web build failed: stdout={String.from_utf8_lossy(output.stdout)} stderr={String.from_utf8_lossy(output.stderr)}")
    assert_liveness_warnings("web", output)
}
// Rust: tests/suite_goldens.rs:21
#Test("user_story_suite_matches_expected_output") {
    root := OSPath.from(env.var("CARGO_MANIFEST_DIR").unwrap())
    suite := root.join("Examples/suites")
    programs := fs.read_dir(suite).expect("user-story suite exists").flatten().map(entry -> entry.path()).filter(path -> path.extension().and_then(extension -> extension.to_str()) == Some("jet") && path.file_name().and_then(name -> name.to_str()) != Some("package.jet")).collect()
    programs.sort()
    assert_eq(programs.len(), 8, "the suite must keep eight user stories")
    cache := env.temp_dir().join("jet-user-story-golden-{id()}")
    scratch := Scratch{path: cache}
    fs.create_dir_all(cache).expect("create golden cache")
    loop program in programs {
        stem := program.file_stem().and_then(name -> name.to_str()).expect("program has a utf8 stem")
        expected := suite.join("expected").join("{stem}.out")
        expected_output := fs.read_to_string(expected).unwrap_or_else(error -> panic("read {expected.display()}: {error}"))
        output := Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(["run", program.to_str().expect("program path is utf8")]).current_dir(root).env("JETPACK_ENV", "1").env_remove("JETPACK_ENV_DIR").env("JET_STORE_DIR", cache).env("NO_COLOR", "1").output().unwrap_or_else(error -> panic("run {program.display()}: {error}"))
        assert(output.status.success(), "{program.display()} failed:\n{String.from_utf8_lossy(output.stderr)}")
        assert_eq(String.from_utf8_lossy(output.stdout), expected_output, "golden mismatch for {program.display()}")
    }
}
