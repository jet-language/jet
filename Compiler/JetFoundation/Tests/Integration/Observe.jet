//RS #[test]
//RS fn unsafe_block_locals_not_leaked() {
//RS     // D-OBS2: locals inside #Unsafe blocks must never appear in panic reports.
//RS     // This is enforced structurally: safe_locals_expr only includes Copy scalars
//RS     // that are in the *safe* env, never raw pointer slots from core.mem.
//RS     // The sema gate (E3101/E3102/E3103) prevents unsafe ops outside #Unsafe blocks,
//RS     // so the only unsafe values are Ptr types — which are not Int/Float/Bool
//RS     // and are therefore always excluded by the type filter.
//RS     // This test confirms the invariant holds by checking that a panic inside an
//RS     // ordinary function with no unsafe block shows only its safe locals.
//RS     let have_rustc = common::have_rustc();
//RS     if !have_rustc {
//RS         return;
//RS     }
