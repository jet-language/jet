//RS fn capture(secret: String, count: Int) {
//RS     assert(count > 5, "failed")
//RS }
//RS fn run() {
//RS     capture("password123", 1)
//RS }
//RS "#;
//RS     let (_code, _stdout, stderr) = build_and_run_debug("no_leak", src);
//RS     assert!(
//RS         !stderr.contains("password"),
//RS         "secret string leaked into panic: {}",
//RS         stderr
//RS     );
//RS     assert!(
//RS         stderr.contains("count = 1"),
//RS         "scalar should appear: {}",
//RS         stderr
//RS     );
//RS }
