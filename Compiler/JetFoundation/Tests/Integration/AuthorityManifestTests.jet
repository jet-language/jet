// Rust: tests/authority_manifest.rs:388
#Test("i9_interpreter_runs_the_authority_project") {
    repo :: authority_project("interpreter")
    entry :: repo.join("run.jet")
    bundle := load_entry(entry.to_str().unwrap()).expect("interpreter front end accepts authority project")
    diagnostics :: check_bundle(&bundle, CompileMode.Run)
    assert(diagnostics.is_empty(), "interpreter sema changed authority meaning: {diagnostics:?}")
    // Retired engine-carrier match becomes the same executable O0 behavior.
    output :: run_authority_cli(repo, ["run", "run.jet"])
    assert_eq(output.status.code(), Val(0), "interpreter stderr: {String.from_utf8_lossy(output.stderr)}")
    assert_authority_output(output, "O0")
    fs.remove_dir_all(repo).drop("remove authority fixture")
}

