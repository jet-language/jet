// Rust: tests/backend_queue.rs:18
#Test("durable_queue_observations_are_consumed_by_jobs_panel") {
    event :: queue_status_event()
    catalog :: JetDevtoolsPanelCatalog.canonical().expect("canonical panel catalog")
    assert_eq(catalog.panel_for_event(event), Val(JetDevtoolsPanelId.Jobs))
    assert(event.payload_json().is_none())
    envelope := JetDevtoolsEnvelope.new("queue-session", 1)
    &envelope.push(event)
    grants :: JetDevtoolsPanelCapability.ALL.to_vec()
    panels :: catalog.project(envelope, JetDevtoolsHostKind.Headless, grants)
    jobs :: panels.iter().find(|panel| panel.availability.descriptor.id == JetDevtoolsPanelId.Jobs).expect("Jobs panel descriptor")
    assert(jobs.availability.is_available())
    assert_eq(jobs.events.len(), 1)
    assert_eq(jobs.events[0].kind(), "Job")
    assert(jobs.events[0].fields_json().contains("\"depth\":1"))
    assert(jobs.events[0].payload_json().is_none())
}

// Rust: tests/backend_queue.rs:40
#Test("typed_job_lifecycle_facts_share_the_same_jobs_route") {
    fact :: JetDevtoolsJobPanelFact{sequence: 1, timestamp_ms: 7, kind: JetDevtoolsJobPanelEventKind.Enqueue, state: JetDevtoolsJobPanelLifecycleState.Enqueued, job_id: "job-1", name: "Sync", labels: [], queue: "default", attempts: 0, duration_ms: None, worker: None, request_id: Val("request-1"), failure: None}
    event :: fact.to_protocol_event("job-runtime").expect("typed lifecycle fact must marshal through the shared event boundary")
    catalog :: JetDevtoolsPanelCatalog.canonical().expect("canonical panel catalog")
    assert_eq(catalog.panel_for_event(event), Val(JetDevtoolsPanelId.Jobs))
    assert(event.payload_json().is_none())
    assert(event.fields_json().contains("\"request_id\":\"request-1\""))
    state := JetDevtoolsJobPanelState.new()
    &state.apply_fact(fact).expect("typed lifecycle fact must be consumed by the Jobs panel state")
    assert_eq(state.job("job-1").unwrap().request_correlation(), Val("request-1"))
}

// Rust: tests/backend_queue.rs:75
#Test("absent_snapshot_workers_preserve_lifecycle_worker_facts") {
    state := JetDevtoolsJobPanelState.new()
    &state.enqueue("job-1", "Sync", "default", [], None, 10).expect("lifecycle enqueue")
    &state.start("job-1", 20, "worker-1").expect("lifecycle start")
    &state.observe_queue_status("default", 8, false, 1, 10, 2, 30).expect("queue snapshot")
    projection :: state.queue_projection("default", 40, None).expect("Jobs queue projection")
    assert_eq(projection.depth, 1)
    assert_eq(projection.wait_ms, 10)
    assert_eq(projection.throughput, 2)
    assert_eq(projection.workers, 1)
}

// Rust: tests/ban_bare_panic.rs:576
#Test("examples_panic_budget_only_shrinks") {
    repo :: root()
    budget :: parse_examples_panic_budget()
    current :: example_panic_counts(repo)
    violations :: example_panic_budget_violations(current, budget)
    assert(violations.is_empty(), "feature example panic budget grew or became stale:\n{violations.join("\n")}")
}

// Rust: tests/ban_bare_panic.rs:590
#Test("examples_panic_budget_trips_on_seeded_growth") {
    budget :: parse_examples_panic_budget()
    seed :: budget.first().expect("panic budget needs a seeded growth entry")
    seeded_source :: "panic(\"seeded\")\n".repeat(seed.baseline + 1)
    seeded_count :: count_jet_panic_calls(seeded_source)
    assert_eq(seeded_count, seed.baseline + 1)
    violations :: example_panic_budget_violations([(seed.path, seeded_count)], budget)
    assert(violations.iter().any(|violation| violation.starts_with(seed.path)), "seeded panic growth did not trip the path budget: {violations:?}")
}

// Rust: tests/ban_bare_panic.rs:610
#Test("compiler_crates_ban_bare_panic_outside_allowlist") {
    repo :: root()
    violations := [String]{}
    allowed := [String: Int]{}
    loop (path, maximum, _) in @ALLOWLIST -> allowed[path] = maximum
    loop scan_root in @SCAN_ROOTS {
        files := [OSPath]{}
        collect_rs_files(repo.join(scan_root), &files)
        loop file in files {
            rel :: file.strip_prefix(repo).unwrap().to_string_lossy().replace('\\', "/")
            text :: fs.read_to_string(file) ?? ""
            count :: count_bare_panics(text)
            if count == 0 -> next
            ceiling :: allowed.get(rel) ?? 0
            if count > ceiling -> &violations.push("{rel}: {count} bare panic!( (allowlisted: {ceiling}) — use jet_foundation::ice!(span, \"…\") or add to ALLOWLIST with a reason")
        }
    }
    assert(violations.is_empty(), "bare panic! outside the ice!/vetted allowlist (I2, card #453):\n{violations.join("\n")}")
}

// Rust: tests/ban_bare_panic.rs:655
#Test("ban_logic_trips_on_a_seeded_bare_panic") {
    seeded :: """
fn already_vetted_test_fixture() {{
    panic!("the allowlist permits this one vetted fixture");
}}

fn seeded_leak() {{
    panic!("bare panic! slipped past ice! adoption");
}}
"""
    count :: count_bare_panics(seeded)
    allowlisted_ceiling_before_seed :: 1
    assert_eq(count, 2, "fixture must contain one vetted and one seeded panic")
    assert(count > allowlisted_ceiling_before_seed, "ban logic failed to reject growth past an existing allowlist ceiling")
    assert(count > allowlisted_ceiling_before_seed, "seeded bare panic! did not trip the allowlisted-file ratchet")
}
