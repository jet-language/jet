// Rust: tests/authority_manifest.rs:62
#Test("default_run_records_source_linked_authority_delegation") {
    repo :: authority_project("run-delegation-receipt")
    package :: """
name: "authority_receipts"
version: "0.1.0"
authority: {{ holds: {{ allow: [Exec, IO] }} }}
"""
    program :: """
use core.process as process

fn run() -> {{
    #FX(authority: Exec, IO) {{
        result :: process.run(["echo", "receipt"], authority)
        print("done")
    }}
}}
"""
    fs.write(repo.join("package.jet"), package).expect("receipt package")
    fs.write(repo.join("run.jet"), program).expect("receipt program")
    output :: run_authority_cli(repo, ["run", "run.jet"])
    assert(output.status.success(), "default run rejected the receipt project:\nstdout={String.from_utf8_lossy(output.stdout)}\nstderr={String.from_utf8_lossy(output.stderr)}")
    receipt :: fs.read_to_string(repo.join(".jet/receipts/authority.jsonl")).expect("default run should write the authority receipt")
    delegation :: receipt.lines().find(|line| line.contains("\"kind\":\"delegation\"")).expect("default run should write a delegation receipt")
    assert(delegation.contains("\"scope\":\"authority@"), delegation)
    assert(delegation.contains("\"resource\":\"process\""), delegation)
    assert(delegation.contains("\"operation\":\"run\""), delegation)
    assert(delegation.contains("\"source\":\"run.jet\""), delegation)
    assert(delegation.contains("\"authority\":\"authority\""), delegation)
    assert(delegation.contains("\"policy_source\":\"#FX; declared policy\""), delegation)
}

// Rust: tests/authority_manifest.rs:119
#Test("authority_receipt_rejects_symlinked_ancestor_without_redirecting_write") {
    if core.sys.target.selected_family() != "unix" -> return // GATE #4483 original cfg(unix).
    repo :: authority_project("receipt-symlink-ancestor")
    outside :: repo.with_file_name("jet_authority_manifest_receipt_target_{id()}")
    fs.remove_dir_all(outside).drop("remove previous receipt target")
    fs.create_dir_all(outside).expect("receipt target directory")
    target :: outside.join("authority.jsonl")
    fs.write(target, "must survive\n").expect("receipt target")
    package :: """
name: "authority_receipts"
version: "0.1.0"
authority: {{ holds: {{ allow: [Exec, IO] }} }}
"""
    program :: """
use core.process as process

fn run() -> {{
    #FX(authority: Exec, IO) {{
        result :: process.run(["echo", "receipt"], authority)
        print("done")
    }}
}}
"""
    fs.write(repo.join("package.jet"), package).expect("receipt package")
    fs.write(repo.join("run.jet"), program).expect("receipt program")
    fs.create_dir_all(repo.join(".jet")).expect("receipt metadata directory")
    std.os.unix.fs.symlink(outside, repo.join(".jet/receipts")).expect("symlink receipt directory") // GATE #4494.
    output :: run_authority_cli(repo, ["run", "run.jet"])
    assert(!output.status.success(), "run accepted a symlinked receipt directory:\nstdout={String.from_utf8_lossy(output.stdout)}\nstderr={String.from_utf8_lossy(output.stderr)}")
    assert_eq(fs.read_to_string(target).expect("receipt target still exists"), "must survive\n")
    fs.remove_dir_all(repo).drop("remove authority fixture")
    fs.remove_dir_all(outside).drop("remove receipt target")
}

// Rust: tests/authority_manifest.rs:168
#Test("malformed_authority_fields_share_e1221") {
    cases :: [(String, String)]{
        ("holds", "authority: {{ holds: {{ allow: [NotAnAuthority] }} }}"),
        ("grants", "authority: {{ grants: {{ \"dep\": [NotAnAuthority] }} }}"),
        ("trust", "authority: {{ trust: {{ default: maybe }} }}"),
        ("providers", "authority: {{ providers: {{ nix: {{ deny: [\"openssl-1.0\"] }} }} }}")
    }
    loop (field_name, block) in cases {
        source :: "name: \"demo\"\nversion: \"0.1.0\"\n{block}\n"
        diagnostic :: Manifest.parse(OSPath.from("package.jet"), source).unwrap_err()
        assert_eq(diagnostic.code, "E1221", "{field_name}: {diagnostic:?}")
        assert(diagnostic.what.contains("authority"), "{field_name}: {diagnostic:?}")
        assert(diagnostic.fix.contains("authority:"), "{field_name}: {diagnostic:?}")
    }
}

// Rust: tests/authority_manifest.rs:198
#Test("retired_authority_fields_name_the_new_block") {
    loop block in ["grants: {{ \"dep\": [Net] }}", "policy: {{ trust: {{ default: prompt }} }}", "policy: {{ providers: {{ nix: {{ registry: \"nixpkgs\" }} }} }}"] {
        source :: "name: \"demo\"\nversion: \"0.1.0\"\n{block}\n"
        diagnostic :: Manifest.parse(OSPath.from("package.jet"), source).expect_err("retired authority field must fail")
        assert_eq(diagnostic.code, "E1206", "{block}: {diagnostic:?}")
        assert(diagnostic.why.contains("authority:"), "{block}: {diagnostic:?}")
        assert(diagnostic.fix.contains("authority:"), "{block}: {diagnostic:?}")
    }
}

// Rust: tests/authority_manifest.rs:222
#Test("policy_keeps_unsafe_mode_and_package_floors") {
    source :: """
name: "demo"
version: "0.1.0"
policy: {{ unsafe: .Forbid, gc: true, explicit_units: true, copies: .Explicit, sentries: .On }}
authority: {{ holds: {{ deny: [Mem.Alloc] }} }}
"""
    facts :: PackageFacts.parse(source, "package.jet").expect("policy floors and unsafe mode stay in policy")
    keys :: facts.policy.declarations.iter().map(|declaration| declaration.key.name()).collect()
    assert_eq(keys, ["unsafe", "gc", "explicit_units", "copies", "sentries"])
    assert_eq(facts.authority.holds.deny, Val([String]{"Mem.Alloc"}))
    assert(facts.authority.trust.is_none())
    assert(facts.authority.providers.is_empty())
    loop retired in ["policy: {{ no_alloc: true }}", "policy: {{ zero_rc: true }}", "policy: {{ arena_bounded: 65536 }}"] {
        diagnostic :: Manifest.parse(OSPath.from("package.jet"), "name: \"demo\"\nversion: \"0.1.0\"\n{retired}\n").expect_err("retired memory floor must move to authority.holds.deny")
        assert_eq(diagnostic.code, "E1206", "{retired}: {diagnostic:?}")
        assert(diagnostic.why.contains("authority.holds"), "{retired}: {diagnostic:?}")
        assert(diagnostic.fix.contains("authority.holds"), "{retired}: {diagnostic:?}")
    }
}

// Rust: tests/authority_manifest.rs:269
#Test("retired_effect_budget_names_authority_holds") {
    source :: "name: \"demo\"\nversion: \"0.1.0\"\neffects: {{ deny: [Net] }}\n"
    diagnostic :: Manifest.parse(OSPath.from("package.jet"), source).expect_err("retired effects key must fail closed")
    assert_eq(diagnostic.code, "E1206")
    assert(diagnostic.why.contains("authority.holds"), "{diagnostic:?}")
    assert(diagnostic.fix.contains("authority.holds"), "{diagnostic:?}")
}

// Rust: tests/authority_manifest.rs:279
#Test("e1220_keeps_dependency_and_effect_provenance_after_key_move") {
    manifest :: PackageFacts.parse("name: \"demo\"\nversion: \"0.1.0\"\nauthority: {{ holds: {{ allow: [FS] }} }}\n", "package.jet").expect("authority holds")
    entries :: [PackageEffects]{PackageEffects{name: "netdep", effects: EffectSet.from([String]{"Net"}), effect_sites: [:], panic_sites: [], boundary_span: Val(Span.new(4, 12))}}
    diagnostics :: enforce(entries, manifest)
    assert_eq(diagnostics.len(), 1)
    diagnostic :: diagnostics[0]
    assert_eq(diagnostic.code, "E1220")
    assert(diagnostic.what.contains("netdep"))
    assert(diagnostic.what.contains("Net"))
    assert(diagnostic.why.contains("authority.holds"))
    assert(diagnostic.fix.contains("authority.holds.allow"))
    assert(diagnostic.fix.contains("authority.grants"))
    assert_eq(diagnostic.span, None)
}

// Rust: tests/authority_manifest.rs:306
#Test("i9_parser_reads_one_authority_block") {
    facts :: PackageFacts.parse(@AUTHORITY_PACKAGE, "package.jet").expect("parser accepts the one authority block")
    assert_eq(facts.authority.holds.allow, Val([String]{"IO"}))
    assert_eq(facts.authority.grants.len(), 1)
    assert_eq(facts.authority.trust.and_then(|trust| trust.require), Val(ProvenanceRequirement.None))
    assert_eq(facts.authority.providers.len(), 1)
}

// Rust: tests/authority_manifest.rs:323
#Test("lock_and_authority_ledger_mirror_the_manifest_block") {
    repo :: authority_project("lock-ledger")
    manifest :: Manifest.parse(repo.join("package.jet"), @AUTHORITY_PACKAGE).expect("manifest authority")
    options :: FetchOptions{locked: false, update: false, update_dep: None, resolution: ResolveMode.Conservative}
    (lock, _) :: fetch(repo, manifest, None, options).expect("authority-only manifest fetch")
    assert_eq(lock.authority, Val(manifest.authority))
    lock_path :: repo.join(".jet/lock")
    lock_text :: fs.read_to_string(lock_path).expect("fetch writes unified lock")
    parsed :: Lock.parse(lock_text).expect("authority lock parses")
    assert_eq(parsed.authority, Val(manifest.authority))
    output :: run_authority_cli(repo, ["inspect", "authority", "--json", "run.jet"])
    assert(output.status.success(), "authority ledger failed:\nstdout={String.from_utf8_lossy(output.stdout)}\nstderr={String.from_utf8_lossy(output.stderr)}")
    json :: String.from_utf8_lossy(output.stdout)
    loop subject in ["authority.holds.allow", "authority.holds.deny", "image-codec", "authority.trust.default", "authority.trust.ci", "authority.trust.services.stripe", "authority.trust.require", "authority.providers.nix"] {
        assert(json.contains("\"subject\":\"{subject}\""), "{subject}: {json}")
    }
    assert(json.contains(".jet/lock"), "lock authority provenance missing: {json}")
    fs.remove_dir_all(repo).drop("remove authority fixture")
}

