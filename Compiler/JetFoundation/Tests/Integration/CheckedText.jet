// Rust: tests/checked_text.rs:135
pub fn normalize_journey_paths(stderr: String) -> String {
    normalized := stderr.lines().map(fn(line) {
        open :: line.find(" (") ?? return line.to_string()
        colon :: line.rfind(':') ?? return line.to_string()
        if !line[open + 2..<colon].contains(".jet") -> return line.to_string()
        "{line[..<open + 2]}<source>:{line[colon + 1..]}"
    }).collect::<[String]>().join("\n")
    if stderr.ends_with('\n') -> normalized.push('\n')
    normalized
}
// Rust: tests/checked_text.rs:274
pub fn assert_checked_text_web_tier() -> Unit {
    output :: jet.compile_web_with_path(TIERS_SOURCE, "checked_text_web.jet").expect("ordinary CheckedText source should compile for web")
    web :: output.web.expect("ordinary CheckedText source should produce web artifacts")
    // Retired wasm-Rust symbol checks migrate to real checked-text acceptance.
    assert_web_artifacts_run(&web.js_app, &web.dom_runtime, &web.wasm, TIERS_STDOUT, "checked-text-web")
}
// Rust: tests/checked_text.rs:293
pub fn assert_html_web_tier() -> Unit {
    output :: jet.compile_web_with_path(HTML_TIERS_SOURCE, "html_composition_web.jet").expect("typed HTML composition should compile for web")
    web :: output.web.expect("typed HTML composition should produce web artifacts")
    assert_web_artifacts_run(&web.js_app, &web.dom_runtime, &web.wasm, HTML_TIERS_STDOUT, "html-composition-web")
}
// Rust: tests/checked_text.rs:308
pub fn assert_web_artifacts_run(js_app: String, dom_runtime: String, wasm: &[U8], expected_stdout: String, scratch_name: String) -> Unit {
    // GATE #4494: real Node execution; wasm is the canonical emitted binary,
    // never a Rust source callback or a fabricated execution result.
    have_tool :: fn(name: String) { Command.new(name).arg("--version").output().map(fn(output) { output.status.success() }).unwrap_or(false) }
    if !have_tool("node") {
        eprintln("note: skipping web execution (need node)")
        return
    }
    scratch :: common.Scratch.new(scratch_name)
    fs.write(scratch.join("app.js"), js_app).unwrap()
    fs.write(scratch.join("jet_dom_runtime.js"), dom_runtime).unwrap()
    fs.write(scratch.join("app.wasm"), wasm).unwrap()
    fs.write(scratch.join("package.json"), """{"type":"module"}""").unwrap()
    node :: Command.new("node").current_dir(&scratch.path).arg("app.js").output().expect("spawn web app")
    assert(node.status.success(), "node rejected web output: stdout={String.from_utf8_lossy(&node.stdout)} stderr={String.from_utf8_lossy(&node.stderr)}")
    assert_eq(String.from_utf8_lossy(&node.stdout), expected_stdout)
}
