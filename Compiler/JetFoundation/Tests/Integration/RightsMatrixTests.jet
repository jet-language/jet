// Rust: tests/rollback.rs:114
#Test("rollback_trait_interpreter_restores_projected_fields") {
    bundle := Loader.load_entry("Examples/features/errors/rollback_trait.jet").expect("rollback trait fixture should load")
    diagnostics :: Sema.check_bundle(&bundle, Sema.CompileMode.Run)
    errors :: diagnostics.iter().filter(fn(diagnostic) { diagnostic.severity == Diagnostics.Severity.Error }).collect()
    assert(errors.is_empty(), "rollback trait fixture should be semantically valid: {errors:#?}")
    match common.run_interpreter_checked_bundle(&bundle, true, Interpreter.InterpreterInvocation.RunInterpret, &common.development_policy()) {
        Interpreter.RunOutcome.Ran { stdout, exit_code, .. } -> {
            assert_eq(exit_code, 0)
            assert_eq(stdout, include_str("Examples/features/expected/errors/rollback_trait.out"))
        }
        Interpreter.RunOutcome.Problems(diagnostics) -> { panic("rollback trait interpreter failed: {diagnostics:?}") }
    }
}
// Rust: tests/rollback.rs:153
#Test("snapshot_custom_in_codegen") {
    src :: """
struct Counter {
    value: Int
}
struct CounterSnap { value: Int }
impl Counter.Rollback {
    type Snapshot = CounterSnap
    fn snapshot(self) -> CounterSnap {
        return CounterSnap{ value: self.value }
    }
    fn restore(&self, snap: ^CounterSnap) -> {
        self.value = snap.value
    }
}
enum Fail { Bad }
fn bump(c: &Counter) -> Int !Fail {
    #Transact {
        c.value += 1
        return Err(Fail.Bad)
    }
    return Ok(c.value)
}
fn run() -> {
    c := Counter{ value: 0 }
    _ :: bump(&c) ?? 0
    print(c.value)
}
"""
    dir :: unique_tmp("codegen")
    fs.create_dir_all(&dir).unwrap()
    jet_path :: dir.join("snap_codegen.jet")
    fs.write(&jet_path, src).unwrap()
    shown :: jet_path.to_string_lossy().into_owned()
    out :: jet.compile_with_path(src, &shown).unwrap_or_else(fn(diags) { panic("front end rejected: {diags:?}") })
    rust :: &out.rust
    assert(rust.contains("snapshot_custom"), "expected snapshot_custom in generated Rust:\n{rust}")
    assert(rust.contains("trait __jet_Rollback"), "expected trait __jet_Rollback in generated Rust:\n{rust}")
    user_code :: common.strip_vetted_prelude_modules(rust)
    assert(!user_code.contains("unsafe"), "unsafe leaked outside jet_txn/jet_mem:\n{user_code}")
}
