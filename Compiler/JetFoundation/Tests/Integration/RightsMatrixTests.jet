// Rust: tests/ring_layer.rs:49
#Test("math_import_infers_core_layer") {
    dir :: tmp_project("math")
    fs.write(dir.join("package.jet"), "name: \"m\"\nversion: \"0.1.0\"\n").unwrap()
    main :: """
use core.math as math

fn run() -> {
    print(math.sqrt(9.0))
}
"""
    fs.write(dir.join("main.jet"), main).unwrap()
    main_path :: dir.join("main.jet")
    path :: main_path.to_str().unwrap()
    bundle := Loader.load_entry(path).unwrap()
    diags :: Sema.check_bundle(&bundle, Sema.CompileMode.Run)
    assert(!diags.iter().any(fn(d) { d.severity == Diagnostics.Severity.Error }), "{jet.render_diagnostics(path, main, &diags)}")
    assert_eq(bundle.inferred_layer, Syntax.RuntimeLayer.Core)
}
