// Rust: tests/ring_layer.rs:206
#Test("ceiling_blocks_ambient_input_helper") {
    dir :: tmp_project("input_ceiling")
    fs.write(dir.join("package.jet"), "name: \"m\"\nversion: \"0.1.0\"\nruntime: core\n").unwrap()
    main :: """
fn run() -> {
    _ :: input("name? ")
    print("ok")
}
"""
    fs.write(dir.join("main.jet"), main).unwrap()
    path :: dir.join("main.jet")
    shown :: path.to_string_lossy()
    diags :: jet.check_with_path(&shown)
    assert(diags.iter().any(fn(d) { d.code == "E1006" }), "expected E1006 for ambient input under core ceiling")
    e1006 :: diags.iter().find(fn(d) { d.code == "E1006" }).unwrap()
    assert(e1006.why.contains("import chain:"), "E1006 should include import chain: {e1006.why}")
    assert(e1006.why.contains("input()"), "chain should name ambient input: {e1006.why}")
}
// Rust: tests/ring_layer.rs:241
#Test("lock_roundtrip_layer_metadata") {
    pkg :: Lock.LockedPackage {
        name: "embed", version: "0.1.0", source: Lock.LockSource.Root, nix_closure: None,
        locked: None, fingerprint: "", content_hash: None, dependencies: [],
        layer: Some(Syntax.RuntimeLayer.Alloc), inferred_layer: Some(Syntax.RuntimeLayer.Std),
        effects: [], effect_grants: [], required_effects: [], granted_effects: [], denied_effects: [],
        effect_authority: None, envelope: None, receipt: None, provenance: None,
    }
    lock :: Lock.LockFile {
        version: 1, packages: [pkg], root_dependencies: [], authority: None, workspace_members: [],
        workspace_source_digest: None, workspace_overlay_policy: Default.default(), comptime_inputs: [],
        toolchains: [], browsers: [], source_channels: [], build_stamp: None, build_contributions: [],
    }
    raw :: Lock.write(&lock)
    parsed :: Lock.parse(&raw).unwrap()
    assert_eq(parsed.packages[0].layer, Some(Syntax.RuntimeLayer.Alloc))
    assert_eq(parsed.packages[0].inferred_layer, Some(Syntax.RuntimeLayer.Std))
}
// Rust: tests/ring_shipping.rs:29
#Test("ring_module_realizes_from_hangar") {
    // GATE #4494: process-global environment; run in isolation as in the Rust test binary.
    env.remove_var(Syntax.TOOLCHAIN_OBJECT_ENV)
    assert(!Syntax.is_ring_module_staged("http"), "with no toolchain object, no ring is staged")
    assert_eq(Loader.resolve_ring_module("http"), Loader.RingResolution.Embedded)
    obj :: scratch("obj")
    ring :: obj.join("ring")
    fs.create_dir_all(&ring).unwrap()
    fs.write(ring.join("http"), "prebuilt-http").unwrap()
    fs.write(ring.join("regex"), "prebuilt-regex").unwrap()
    env.set_var(Syntax.TOOLCHAIN_OBJECT_ENV, &obj)
    assert(Syntax.is_ring_module_staged("http"), "is_ring_module_staged(\"http\") must flip true when the object stages it")
    assert(Syntax.is_ring_module_staged("regex"))
    match Loader.resolve_ring_module("http") {
        Loader.RingResolution.Staged(path) -> { assert_eq(path, ring.join("http"), "must point at the staged artifact") }
        other -> { panic("expected Staged, got {other:?}") }
    }
    assert(!Syntax.is_ring_module_staged("db"))
    assert_eq(Loader.resolve_ring_module("db"), Loader.RingResolution.Embedded)
    assert(!Syntax.is_ring_module_staged("not_a_ring"))
    env.remove_var(Syntax.TOOLCHAIN_OBJECT_ENV)
    _ :: fs.remove_dir_all(&obj).ok()
}
