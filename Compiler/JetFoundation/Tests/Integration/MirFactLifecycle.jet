// Rust: tests/mir_fact_lifecycle.rs:9
fn lower_checked(source: String) -> MirProgram {
    root :: Common.unique_tmp("jet_mir_fact_lifecycle")
    // GATE #4494: native filesystem fixture.
    fs.create_dir_all(root).unwrap()
    fs.write(root.join("package.jet"), "name: \"mir_fact_lifecycle\"\nversion: \"1.0.0\"\n").unwrap()
    entry :: root.join("main.jet")
    fs.write(entry, source).unwrap()
    bundle := jet.Loader.load_entry(entry.to_str().unwrap()).unwrap()
    errors :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run).into_iter().filter(diagnostic -> diagnostic.severity == Severity.Error).collect()
    assert(errors.is_empty(), "{errors:#?}")
    request :: MirArtifactRequest.new(MirArtifactTarget.Cranelift, MirArtifactKind.NativeExecutable, MirArtifactBuildMode.Dev)
    return jet.Codegen.TIR.lower_checked_mir_program_for(bundle, request).expect("checked bundle lowers through the public MIR optimizer path").0
}
// Rust: tests/mir_fact_lifecycle.rs:37
fn function(program: MirProgram, name: String) -> &MirFunction {
    return program.functions.iter().find(function -> function.name == name).unwrap_or_else(() -> panic("missing MIR function {name}"))
}
// Rust: tests/mir_fact_lifecycle.rs:658
fn value_reads_place(function: MirFunction, value: MirValueId, place: MirPlaceId, seen: &[MirValueId]) -> Bool {
    if seen.contains(value) { return false }
    seen.push(value)
    instruction :: function.blocks.iter().flat_map(block -> block.instructions.iter()).find(instruction -> instruction.result == Some(value)) ?? return false
    return if instruction.operation == {
        .ReadPlace(candidate) -> candidate == place
        .MovePlace{place: candidate} -> candidate == place
        .Copy{value: inner, ..} -> value_reads_place(function, inner, place, &seen)
        .Move{value: inner} -> value_reads_place(function, inner, place, &seen)
        .AttachTag{value: inner, ..} -> value_reads_place(function, inner, place, &seen)
        .Convert{value: inner, ..} -> value_reads_place(function, inner, place, &seen)
        else -> false
    }
}
// Rust: tests/mir_fact_lifecycle.rs:688
fn function_mut(program: &MirProgram, name: String) -> &MirFunction {
    return program.functions.iter_mut().find(function -> function.name == name).unwrap_or_else(() -> panic("missing MIR function {name}"))
}

// Rust: tests/mir_typed_error_carriers.rs:6
BASE64_TYPED_ERROR_SOURCE :: """
use core.encoding.base64 as api
fn report_standard(text: String, expected: U8) {{
    if api.decode(text) == {{
        .Ok(bytes) -> {{
            print(bytes.len())
            print(bytes[0])
            print(bytes[0] == expected)
        }}
        .Err(error) -> print(error.reason)
    }}
}}
fn report_url(text: String, expected: U8) {{
    if api.decode_url(text) == {{
        .Ok(bytes) -> {{
            print(bytes.len())
            print(bytes[0])
            print(bytes[0] == expected)
        }}
        .Err(error) -> print(error.reason)
    }}
}}
fn run() {{
    print(api.is_base64("jet"))
    print(api.is_base64("Zg=="))
    report_standard("Zg==", U8{{102}})
    report_standard("Zg=", U8{{102}})
    report_standard("a?==", U8{{102}})
    report_standard("Zh==", U8{{102}})
    report_standard("-w", U8{{251}})
    report_url("-w", U8{{251}})
    report_url("-w==", U8{{251}})
}}
"""
