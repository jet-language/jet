// Rust: tests/modules.rs:17
fn parse_items(src: String) -> [Item] {
    (toks, lex_diags) :: jet.Lexer.lex(src)
    assert(lex_diags.is_empty(), "lex diagnostics: {lex_diags:?}")
    return jet.Parser.parse(toks).expect("parse").items
}
// Rust: tests/modules.rs:23
fn write_files(root: OSPath, files: [(String, String)]) -> {
    loop (relative, source) in files {
        path :: root.join(relative)
        if path.parent() == Some(parent) { fs.create_dir_all(parent).unwrap() }
        fs.write(path, source).unwrap()
    }
}
// Rust: tests/modules.rs:33
fn run_forced_interpreter(name: String, entry: String, files: [(String, String)]) -> (I32, String, String) {
    scratch :: Common.Scratch.new(name)
    write_files(scratch.path, files)
    path :: scratch.join(entry)
    // Retained explicit native debug tier replaces retired interpreter.
    return TirSupport.run_entry_tier(path, "O0")
}
// Rust: tests/modules.rs:53
fn assert_bodyless_module_runs(name: String, declaration: String) -> {
    main_src :: "module lib\nuse lib.[helper]\nfn run() {{ print(helper.value()) }}\n"
    lib_src :: "{declaration} module helper;\n"
    files :: [("main.jet", main_src), ("lib.jet", lib_src), ("helper.jet", "pub fn value() -> String {{ return \"visible\" }}\n")]
    if TirSupport.have_rustc() {
        (code, stdout) :: TirSupport.build_and_run_multi(name, "main.jet", files)
        assert_eq(code, 0)
        assert_eq(stdout, "visible\n")
    }
    (code, stdout, stderr) :: TirSupport.run_default_multi(name, "main.jet", files)
    assert_eq(code, 0, "default jet run failed: {stderr}")
    assert_eq(stdout, "visible\n")
    (explicit_code, explicit_stdout, explicit_stderr) :: run_forced_interpreter(name, "main.jet", files)
    assert_eq(explicit_code, 0, "explicit native execution failed: {explicit_stderr}")
    assert_eq(explicit_stdout, "visible\n")
}
// Rust: tests/modules.rs:168
fn collect_perf_specs(src: String) -> Result<[jet.Sema.BudgetSpec], [Diagnostic]> {
    (tokens, lex_diags) :: jet.Lexer.lex(src)
    assert(lex_diags.is_empty(), "lex diagnostics: {lex_diags:?}")
    program :: jet.Parser.parse(tokens).expect("parse")
    return jet.Sema.collect_budget_specs(program)
}
