// Rust: tests/release_gates.rs:362
#Test("core_encoding_migrations_use_one_marker_payload") {
    encode :: jet.Syntax.core_marker_application("core.encoding.cbor", "encode").expect("cbor.encode deprecation")
    assert_eq(encode.since, "2027")
    assert_eq(encode.replacement, "cbor.to_bytes")
    assert_eq(encode.removed_in, Val("2028"))
    decode :: jet.Syntax.core_marker_application("core.encoding.cbor", "decode").expect("cbor.decode deprecation")
    assert_eq(decode.since, "2027")
    assert_eq(decode.replacement, "cbor.parse")
    assert_eq(decode.removed_in, Val("2028"))
}

// Rust: tests/release_gates.rs:376
#Test("cbor_deprecation_release_fixture") {
    dir :: env.temp_dir().join("jet_release_deprecation_{process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).unwrap()
    source :: "use core.encoding.cbor as cbor\nuse core.encoding.json as json\n\nfn run() {\n    tree :: json.parse(\"{{}}\") ?? panic(\"json\")\n    payload :: cbor.encode(tree)\n    print(\"ok\")\n}\n"
    rendered := ""
    loop edition in ["2027", "2028"] {
        fs.write(dir.join("package.jet"), "name: \"cbor_release\"\nversion: \"0.1.0\"\nedition: \"{edition}\"\n").unwrap()
        path :: dir.join("run.jet")
        fs.write(path, source).unwrap()
        diagnostics :: jet.check_with_path(path.to_str().unwrap())
        rendered.push_str("edition {edition}\n")
        rendered.push_str(jet.render_diagnostics("tests/release/cbor_{edition}.jet", source, diagnostics))
    }
    _ :: fs.remove_dir_all(dir)
    check_fixture("deprecation.txt", rendered)
}

// Rust: tests/release_gates.rs:407
#Test("compiled_workload_release_gate_uses_frozen_contract_and_canaries") {
    repo :: root()
    gate :: fs.read_to_string(repo.join("Tools/ci/compiled-workload-gate.sh")).expect("read compiled workload gate")
    loop field in ["--contract", "--check", "outcomes.tsv", "measurements.tsv", "tiers.tsv", "jet_tool_version", "peer_tool_version", "review_status", "review_evidence", "review.tsv", "reviewer_is_independent", "review_workflow", "review_run", "review_actor", "rust_tolerance_ratio", "metric_is_loss"] {
        assert(gate.contains(field), "compiled workload gate lost {field}")
    }
    runner_path :: repo.join("Tools/ci/compiled-workload-runner.mjs")
    runner :: fs.read_to_string(runner_path).expect("read compiled workload runner")
    loop field in ["runMeasured", "process.hrtime.bigint", "JET_WEB_CHROMIUM", "CdpDriver", "network=loopback-only", "network=disabled", "peerMeasured", "samples", "targetArtifactProof", "JET_STORE_DIR", ".jet"] {
        assert(runner.contains(field), "compiled workload runner lost {field}")
    }
    registry :: Command.new("node").arg(runner_path).arg("--measurement-registry").current_dir(repo).output().expect("probe compiled workload measurement registry")
    assert(registry.status.success(), "compiled workload measurement registry probe failed:\n{String.from_utf8_lossy(registry.stderr)}")
    metric_registry :: String.from_utf8_lossy(registry.stdout)
    loop field in ["\"linux\"", "\"macos\"", "\"windows\"", "\"VmHWM\"", "\"VmRSS\"", "\"PeakWorkingSet64\""] {
        assert(metric_registry.contains(field), "compiled workload measurement registry lost {field}: {metric_registry}")
    }
    assert(metric_registry.contains("\"processProperty\":\"PeakWorkingSet64\""), "Windows memory measurement must use peak working set: {metric_registry}")
    self_check :: fs.read_to_string(repo.join("Tools/ci/test-compiled-workload-gate.sh")).expect("read compiled workload gate self-check")
    canaries :: fs.read_to_string(repo.join("tests/compiled_workloads/canaries.tsv")).expect("read compiled workload canaries")
    loop line in canaries.lines().skip(1).filter((line) -> !line.is_empty()) {
        name :: line.split('\t').nth(1).unwrap()
        assert(self_check.contains("expect_reject {name}"), "removal canary is not exercised: {name}")
    }
    suites :: fs.read_to_string(repo.join("tests/suites.txt")).expect("read test suites")
    assert(suites.lines().any((line) -> line.trim() == "tests/compiled_workloads"), "compiled workload self-check must stay in the named test suites")
    output :: Command.new("bash").arg(repo.join("Tools/ci/compiled-workload-gate.sh")).arg("--contract").current_dir(repo).output().expect("run compiled workload contract gate")
    assert(output.status.success(), "compiled workload contract gate failed:\n{String.from_utf8_lossy(output.stderr)}")
}

// Rust: tests/release_gates.rs:565
#Test("ci_test_shards_cover_every_workspace_target_exactly_once") {
    repo :: root()
    shard_count :: 6
    want :: full_workspace_test_target_inventory(repo)
    assert(want.len() > 200, "sanity: expected well over 200 lib/bin/test targets across the workspace, got {want.len()}")
    got: [String] := []
    loop shard in 0..<shard_count {
        out :: Command.new("bash").arg(repo.join("Tools/ci/test-shards.sh")).arg(shard.to_string()).arg(shard_count.to_string()).current_dir(repo).output().expect("run Tools/ci/test-shards.sh")
        assert(out.status.success(), "shard {shard} enumeration failed:\n{String.from_utf8_lossy(out.stderr)}")
        got.extend(String.from_utf8(out.stdout).unwrap().lines().map((line) -> line.to_string()))
    }
    // String keys retain the set's uniqueness check without a quadratic scan.
    unique: [String:Bool] := [:]
    loop target in got { unique[target] = true }
    assert_eq(got.len(), unique.len(), "a test target appeared in more than one shard")
    want_sorted := want.clone()
    want_sorted.sort()
    got_sorted := got.clone()
    got_sorted.sort()
    assert_eq(want_sorted, got_sorted, "the union of all CI test shards must equal the exact workspace test-target inventory (nothing silently skipped, nothing duplicated)")
    assert_eq(got.iter().filter((target) -> target.as_str() == "-p jet --test grammar").count(), 1, "CI grammar drift tests must remain on exactly one production shard")
}

// Rust: tests/release_gates.rs:631
#Test("ci_test_shards_use_the_committed_weight_table") {
    repo :: root()
    table :: fs.read_to_string(repo.join("Tools/ci/test-weights.tsv")).expect("read Tools/ci/test-weights.tsv")
    inventory: [String:Bool] := [:]
    loop target in full_workspace_test_target_inventory(repo) { inventory[target] = true }
    weighed: [String:Bool] := [:]
    loop (index, line) in table.lines().enumerate() {
        row :: index + 1
        if line.is_empty() || line.starts_with("#") { continue }
        fields :: line.split('\t').collect()
        assert_eq(fields.len(), 4, "Tools/ci/test-weights.tsv:{row} must be '<package>\t<kind>\t<target>\t<seconds>': {line:?}")
        (package, kind, name, seconds) :: (fields[0], fields[1], fields[2], fields[3])
        assert(seconds.parse<UInt64>().is_ok(), "Tools/ci/test-weights.tsv:{row} seconds must be a whole number: {seconds:?}")
        target :: match kind {
            "lib" -> "-p {package} --lib"
            "bin" -> "-p {package} --bin {name}"
            "test" -> "-p {package} --test {name}"
            other -> panic("Tools/ci/test-weights.tsv:{row} has unknown target kind `{other}`")
        }
        assert(inventory.contains_key(target), "Tools/ci/test-weights.tsv:{row} weighs `{target}`, which is not a workspace test target — renamed or deleted, so its weight silently stopped applying")
        assert(weighed.insert(target.clone(), true).is_none(), "Tools/ci/test-weights.tsv:{row} repeats `{target}`")
    }
    assert(!weighed.is_empty(), "the weight table must carry at least one measured row, or the weighted split is round-robin wearing a hat")
    out :: Command.new("bash").arg(repo.join("Tools/ci/test-shards.sh")).args(["0", "6"]).current_dir(repo).output().expect("run Tools/ci/test-shards.sh")
    assert(out.status.success(), "weighted shard enumeration failed:\n{String.from_utf8_lossy(out.stderr)}")
    summary :: String.from_utf8_lossy(out.stderr)
    assert(summary.contains("predicted ") && summary.contains("spread "), "Tools/ci/test-shards.sh must report the load and spread it computed: {summary}")
}

// Rust: tests/release_gates.rs:700
#Test("verify_full_default_run_covers_whole_workspace") {
    verify :: fs.read_to_string(root().join("Tools/agent/verify-full.sh")).expect("read Tools/agent/verify-full.sh")
    assert(verify.contains("cargo test --workspace \"$@\""), "the unsharded default path must run `cargo test --workspace`, not the default-members-only `cargo test`")
    assert(verify.contains("Tools/ci/test-shards.sh"), "the sharded path must delegate enumeration to Tools/ci/test-shards.sh")
    assert(verify.contains("cargo test $test_target --no-run"))
    assert(verify.contains("test_targets_repeat"))
    assert(verify.contains("test-target inventory is nondeterministic"))
    assert(verify.contains("CARGO_BUILD_JOBS"))
    assert(!verify.contains("tmp_parent=\"${JET_VERIFY_TMPDIR:-/tmp}\""))
}

// Rust: tests/release_gates.rs:725
#Test("warning_free_policy_is_strict_and_curated") {
    verify :: fs.read_to_string(root().join("Tools/agent/verify-full.sh")).expect("read Tools/agent/verify-full.sh")
    assert(verify.contains("D-CI2=A") && verify.contains("-D warnings"), "the production test path must inherit the warning wall")
    jit :: fs.read_to_string(root().join("crates/jet-jit/src/lib.rs")).expect("read jet-jit lint policy")
