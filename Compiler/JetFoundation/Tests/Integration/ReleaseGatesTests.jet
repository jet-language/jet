// Rust: tests/release_gates.rs:23
#Test("small_profile_binary_is_smaller_than_default") {
    jet :: jet_bin()
    assert(jet.exists(), "need the native jet binary")
    example :: root().join("Examples/features/collections/wordcount.jet")
    assert(example.is_file(), "Examples/features/collections/wordcount.jet must exist")
    dir :: env.temp_dir().join("jet_small_test_{process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).unwrap()
    fs.create_dir_all(dir.join(".jet/build")).unwrap()
    build_default :: Command.new(jet).args(["build", example.to_str().unwrap()]).current_dir(dir).output().unwrap()
    assert(build_default.status.success(), "default build failed:\n{String.from_utf8_lossy(build_default.stderr)}")
    fs.rename(dir.join(".jet/build/wordcount"), dir.join(".jet/build/wordcount_default")).unwrap()
    build_small :: Command.new(jet).args(["build", "--small", example.to_str().unwrap()]).current_dir(dir).output().unwrap()
    assert(build_small.status.success(), "--small build failed:\n{String.from_utf8_lossy(build_small.stderr)}")
    fs.rename(dir.join(".jet/build/wordcount"), dir.join(".jet/build/wordcount_small")).unwrap()
    default_size :: fs.metadata(dir.join(".jet/build/wordcount_default")).unwrap().len()
    small_size :: fs.metadata(dir.join(".jet/build/wordcount_small")).unwrap().len()
    assert(small_size < default_size, "--small binary ({small_size} bytes) should be smaller than default ({default_size} bytes)")
    _ :: fs.remove_dir_all(dir)
}

// Rust: tests/release_gates.rs:106
#Test("ga_every_diagnostic_has_explain") {
    index :: jet.Explain.index()
    missing :: Registry.diagnostic_rows().iter().filter((row) -> !index.contains_key(row.code)).map((row) -> row.code.to_string()).collect()
    assert(missing.is_empty(), "M17 GA gate: these diagnostic codes lack a `jet explain` entry:\n  {missing.join(", ")}")
}

// Rust: tests/release_gates.rs:124
#Test("ga_milestone_features_front_end_clean") {
    features :: [("modules/library.jet", "library authoring"), ("lowlevel/lowlevel.jet", "expert low-level tier"), ("net/http_server_tasks.jet", "HTTP service"), ("lowlevel/freestanding.jet", "freestanding smoke")]
    features_dir :: root().join("Examples/features")
    loop (file, desc) in features {
        path :: features_dir.join(file)
        assert(path.is_file(), "M17 GA gate: feature example missing: {path.display()}")
        src :: fs.read_to_string(path).unwrap_or_else((_) -> panic("cannot read {path.display()}"))
        result :: jet.compile_with_path(src, path.to_str().unwrap())
        assert(result.is_ok(), "M17 GA gate: '{desc}' failed front end:\n{result.err():?}")
    }
}

// Rust: tests/release_gates.rs:155
#Test("ga_feature_size_budgets") {
    jet :: jet_bin()
    assert(jet.exists(), "need the native jet binary")
    budgets :: [("basics/hello.jet", 512_000), ("io/cli.jet", 512 * 1024), ("net/http_server_tasks.jet", 3 * 1024 * 1024), ("modules/library.jet", 4_194_304), ("lowlevel/lowlevel.jet", 4_194_304), ("lowlevel/freestanding.jet", 4_194_304)]
    features_dir :: root().join("Examples/features")
    build_dir :: env.temp_dir().join("jet_ga_budgets_{process.id()}")
    fs.create_dir_all(build_dir.join(".jet/build")).unwrap()
    loop (file, max_bytes) in budgets {
        src :: features_dir.join(file)
        stem :: OSPath.from(file).file_stem().unwrap().to_string_lossy()
        bin :: build_dir.join(".jet/build").join(stem)
        out :: Command.new(jet).args(["build", "--small", src.to_str().unwrap()]).current_dir(build_dir).output().unwrap()
        assert(out.status.success(), "GA size gate: `--small` build of {file} failed:\n{String.from_utf8_lossy(out.stderr)}")
        size :: fs.metadata(bin).map((m) -> m.len()).unwrap_or(0)
        assert(size <= max_bytes && size > 0, "GA size gate: {file} --small binary is {size} bytes (limit {max_bytes})")
    }
    _ :: fs.remove_dir_all(build_dir)
}

