// Rust: tests/release_gates.rs:742
#Test("ci_gate_evidence_preserves_success_and_failure_receipts") {
    repo :: root()
    scratch :: common.test_scratch_root("ci-evidence-{process.id()}")
    _ :: fs.remove_dir_all(scratch)
    fs.create_dir_all(scratch).unwrap()
    script :: repo.join("Tools/ci/ci-evidence.sh")
    success_dir :: scratch.join("success")
    success :: Command.new("bash").arg(script).args(["--report-dir", success_dir.to_str().unwrap(), "--", "bash", "-c"]).arg("printf 'gate-ok\\n'").env_remove("GITHUB_ACTIONS").env("RUNNER_OS", "Linux").env("RUNNER_ARCH", "X64").current_dir(repo).output().expect("run CI evidence success path")
    assert(success.status.success(), "successful gate must stay successful:\n{String.from_utf8_lossy(success.stderr)}")
    assert_eq(String.from_utf8_lossy(success.stdout), "gate-ok\n", "evidence wrapper must preserve gate stdout")
    success_receipt :: fs.read_to_string(success_dir.join("receipt.txt")).unwrap()
    candidate :: success_receipt.lines().find_map((line) -> line.strip_prefix("candidate_commit=")).expect("receipt must record the candidate").to_owned()
    assert_eq(candidate.len(), 40, "candidate revision must be a full SHA-1")
    assert(success_receipt.contains("schema=jet.ci-evidence.v1"))
    assert(success_receipt.contains("status=pass"))
    assert(success_receipt.contains("candidate_commit={candidate}"))
    loop field in ["source_candidate_commit", "toolchain_candidate_commit", "artifact_candidate_commit", "signature_candidate_commit", "test_candidate_commit", "support_matrix_candidate_commit", "provenance_candidate_commit", "release_metadata_candidate_commit"] {
        assert(success_receipt.contains("{field}={candidate}"), "receipt must bind {field} to the candidate")
    }
    candidate_manifest :: fs.read_to_string(success_dir.join("candidate.txt")).unwrap()
    assert(candidate_manifest.contains("schema=jet.ci-candidate.v1"))
    loop field in ["candidate_commit", "source_candidate_commit", "toolchain_candidate_commit", "artifact_candidate_commit", "signature_candidate_commit", "test_candidate_commit", "support_matrix_candidate_commit", "provenance_candidate_commit", "release_metadata_candidate_commit"] {
        assert(candidate_manifest.contains("{field}={candidate}"), "candidate manifest must bind {field} to the candidate")
    }
    assert(candidate_manifest.contains("signature=not-required-for-ci-test-gate"))
    loop field in ["command_exit=0", "support_matrix=Linux/X64", "artifact_name=not-published", "provenance=github-actions:local/1", "source_manifest_sha256=", "toolchain_sha256="] { assert(success_receipt.contains(field)) }
    assert_eq(fs.read_to_string(success_dir.join("command.stdout")).unwrap(), "gate-ok\n")

    failure_dir :: scratch.join("failure")
    failure :: Command.new("bash").arg(script).args(["--report-dir", failure_dir.to_str().unwrap(), "--", "bash", "-c"]).arg("printf 'gate-failed\\n' >&2; exit 23").env("GITHUB_SHA", candidate).env("RUNNER_OS", "Linux").env("RUNNER_ARCH", "X64").current_dir(repo).output().expect("run CI evidence failure path")
    assert_eq(failure.status.code(), Val(23))
    failure_receipt :: fs.read_to_string(failure_dir.join("receipt.txt")).unwrap()
    assert(failure_receipt.contains("status=fail"))
    assert(failure_receipt.contains("command_exit=23"))
    assert_eq(fs.read_to_string(failure_dir.join("command.stderr")).unwrap(), "gate-failed\n")
    assert(failure_dir.join("toolchain.txt").is_file(), "failed gates must retain toolchain evidence")

    missing_runner_dir :: scratch.join("missing-runner")
    missing_runner :: Command.new("bash").arg(script).args(["--report-dir", missing_runner_dir.to_str().unwrap(), "--", "bash", "-c"]).arg("printf 'must-not-run\\n'").env("GITHUB_ACTIONS", "true").env("GITHUB_SHA", candidate).env_remove("RUNNER_OS").env_remove("RUNNER_ARCH").env_remove("GITHUB_RUNNER_OS").env_remove("GITHUB_RUNNER_ARCH").current_dir(repo).output().expect("run CI evidence missing-runner path")
    assert_eq(missing_runner.status.code(), Val(78))
    assert_eq(fs.read_to_string(missing_runner_dir.join("command.stdout")).unwrap(), "")
    missing_runner_receipt :: fs.read_to_string(missing_runner_dir.join("receipt.txt")).unwrap()
    assert(missing_runner_receipt.contains("status=fail"))
    assert(fs.read_to_string(missing_runner_dir.join("command.stderr")).unwrap().contains("runner OS identity is missing"))

    stale_dir :: scratch.join("stale")
    fs.create_dir_all(stale_dir).unwrap()
    fs.write(stale_dir.join("receipt.txt"), "status=pass\n").unwrap()
    stale :: Command.new("bash").arg(script).args(["--report-dir", stale_dir.to_str().unwrap(), "--", "bash", "-c"]).arg("printf 'must-not-run\\n'").env_remove("GITHUB_ACTIONS").env("GITHUB_SHA", candidate).env("RUNNER_OS", "Linux").env("RUNNER_ARCH", "X64").current_dir(repo).output().expect("run CI evidence stale-report path")
    assert_eq(stale.status.code(), Val(78))
    assert_eq(fs.read_to_string(stale_dir.join("command.stdout")).unwrap(), "")
    stale_receipt :: fs.read_to_string(stale_dir.join("receipt.txt")).unwrap()
    assert(stale_receipt.contains("status=fail"))
    assert(fs.read_to_string(stale_dir.join("command.stderr")).unwrap().contains("stale file"))

    artifact_mismatch_dir :: scratch.join("artifact-mismatch")
    artifact_mismatch :: Command.new("bash").arg(script).args(["--report-dir", artifact_mismatch_dir.to_str().unwrap(), "--", "bash", "-c"]).arg("printf 'must-not-run\\n'").env_remove("GITHUB_ACTIONS").env("GITHUB_SHA", candidate).env("JET_CI_ARTIFACT_NAME", "ci-gate-evidence-shard-0-stale").current_dir(repo).output().expect("run CI evidence artifact identity failure path")
    assert_eq(artifact_mismatch.status.code(), Val(78))
    artifact_mismatch_receipt :: fs.read_to_string(artifact_mismatch_dir.join("receipt.txt")).unwrap()
    assert(artifact_mismatch_receipt.contains("status=fail"))
    assert(fs.read_to_string(artifact_mismatch_dir.join("command.stderr")).unwrap().contains("artifact name does not identify candidate"))
    assert(artifact_mismatch_dir.join("candidate.txt").is_file())
    _ :: fs.remove_dir_all(scratch)
}

// Rust: tests/release_gates.rs:961
#Test("tower_hygiene_gate_is_read_only_and_blocks_missing_records") {
    repo :: root()
    fixture :: common.test_scratch_root("tower-hygiene-gate-{process.id()}")
    _ :: fs.remove_dir_all(fixture)
    fs.create_dir_all(fixture.join("Docs/spec")).unwrap()
    fs.create_dir_all(fixture.join("tower")).unwrap()
    fs.write(fixture.join("tower/tower.json"), """
{
  "meta": {"version": 4, "project": "fixture", "currentEpoch": null, "nextNum": 1, "rev": 0, "ui": {"toggled": []}},
  "epochs": [{"id": "e1", "name": "Epoch 1", "goal": "", "status": "active"}],
  "milestones": [],
  "cards": [],
  "decisions": [{"id": "D-OK1", "status": "ratified", "outcome": "A"}],
  "questions": [],
  "ideas": [],
  "papercuts": [],
  "events": []
}
""").unwrap()
    fs.write(fixture.join("tower/history.json"), "{\"version\": 1, \"decisions\": [], \"cards\": [], \"events\": []}\n").unwrap()
    fs.write(fixture.join("tower/read-only-marker.txt"), "must not change\n").unwrap()
    fs.write(fixture.join("Docs/spec/ok.md"), "D-OK1\n").unwrap()
    tower_before :: fs.read(fixture.join("tower/tower.json")).unwrap()
    history_before :: fs.read(fixture.join("tower/history.json")).unwrap()
    marker_before :: fs.read(fixture.join("tower/read-only-marker.txt")).unwrap()
    success_report :: fixture.join("success.txt")
    success :: run_tower_hygiene_gate(repo, fixture.join("tower"), fixture.join("Docs"), success_report)
    assert(success.status.success(), "valid Tower hygiene must pass:\n{String.from_utf8_lossy(success.stdout)}")
    success_text :: fs.read_to_string(success_report).unwrap()
    loop field in ["status=pass", "read_only=pass", "lint_exit=0", "lint_repeat_exit=0", "lint_json=pass", "lint_repeat_json=pass", "candidate_commit=", "runner_os=", "node=v", "scope_input="] { assert(success_text.contains(field), "{success_text}") }
    assert_eq(tower_before, fs.read(fixture.join("tower/tower.json")).unwrap())
    assert_eq(history_before, fs.read(fixture.join("tower/history.json")).unwrap())
    assert_eq(marker_before, fs.read(fixture.join("tower/read-only-marker.txt")).unwrap())

    fs.write(fixture.join("Docs/spec/bad.md"), "D-MISSING1\n").unwrap()
    failure_report :: fixture.join("failure.txt")
    failure :: run_tower_hygiene_gate(repo, fixture.join("tower"), fixture.join("Docs"), failure_report)
    assert(!failure.status.success(), "missing Tower decision record must block:\n{String.from_utf8_lossy(failure.stdout)}")
    failure_text :: fs.read_to_string(failure_report).unwrap()
    loop field in ["status=fail", "lint_exit=1", "lint_repeat_exit=1", "spec-decision-ref-missing", "D-MISSING1"] { assert(failure_text.contains(field), "{failure_text}") }
    assert_eq(tower_before, fs.read(fixture.join("tower/tower.json")).unwrap())
    assert_eq(history_before, fs.read(fixture.join("tower/history.json")).unwrap())
    assert_eq(marker_before, fs.read(fixture.join("tower/read-only-marker.txt")).unwrap())

    fs.create_dir_all(fixture.join("outside")).unwrap()
    traversal_report :: fixture.join("outside/../tower/traversal.txt")
    traversal :: run_tower_hygiene_gate(repo, fixture.join("tower"), fixture.join("Docs"), traversal_report)
    assert(!traversal.status.success(), "a report path resolving into Tower must block the gate:\n{String.from_utf8_lossy(traversal.stdout)}")
    assert(!fixture.join("tower/traversal.txt").exists(), "read-only gate wrote an audit report into Tower")

    fs.create_dir_all(fixture.join("tower/tower.json.lock")).unwrap()
    fs.write(fixture.join("tower/tower.json.lock/info.json"), "{\"pid\": 1, \"at\": 0}\n").unwrap()
    locked_report :: fixture.join("locked.txt")
    locked :: run_tower_hygiene_gate(repo, fixture.join("tower"), fixture.join("Docs"), locked_report)
    assert(!locked.status.success(), "a Tower write lock must block the read-only gate:\n{String.from_utf8_lossy(locked.stdout)}")
    locked_text :: fs.read_to_string(locked_report).unwrap()
    assert(locked_text.contains("read_only=blocked"), "{locked_text}")
    assert(locked_text.contains("lint_exit=not-run"), "{locked_text}")
    assert(locked_text.contains("write lock"), "{locked_text}")
    _ :: fs.remove_dir_all(fixture.join("tower/tower.json.lock"))
    verify :: fs.read_to_string(repo.join("Tools/agent/verify-full.sh")).unwrap()
    assert(verify.contains("Tools/ci/tower-hygiene-gate.sh"), "verify-full must run the production Tower hygiene gate")
    _ :: fs.remove_dir_all(fixture)
}
