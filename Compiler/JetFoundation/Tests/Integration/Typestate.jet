// Rust: tests/typestate.rs:40
fn codes(src: String) -> [String] {
    if jet.compile(src) == {
        .Ok(_) -> [String]{}
        .Err(diags) -> diags.map(fn(d) { d.code })
    }
}
// Rust: tests/typestate.rs:47
fn diagnostics(src: String) -> [Diagnostic] { jet.compile(src).expect_err("fixture must produce diagnostics") }
// Rust: tests/typestate.rs:51
fn lint_codes(src: String) -> [String] {
    if jet.compile(src) == {
        .Ok(out) -> out.lints.map(fn(d) { d.code })
        .Err(_) -> [String]{}
    }
}
// Rust: tests/typestate.rs:59
DECL :: """
struct Reservation {
    state { Pending, Confirmed, CheckedIn }
    guest: String
}
impl Reservation {
    #Transition(_, Pending) fn book(guest: String) -[]> Reservation {
        return Reservation{ guest: ~guest }
    }
    #Transition(Pending, Confirmed) fn pay(self: ^Reservation) -[]> Reservation { return self }
    #Transition(Confirmed, CheckedIn) fn check_in(self: ^Reservation) -[]> Reservation { return self }
    #State(CheckedIn) fn room_key(self) -[]> String { return "key" }
}
"""
