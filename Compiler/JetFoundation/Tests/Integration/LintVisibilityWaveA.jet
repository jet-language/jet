// Rust: tests/lint_visibility_wave_a.rs:130
fn package(root: OSPath, allow: String, extra: String) -> {
    fs.write(root.join("package.jet"), "name: \"lint-visibility\"\nversion: \"0.1.0\"\nauthority: {{ holds: {{ allow: [{allow}] }} }}\n{extra}").expect("write lint visibility package")
}
// Rust: tests/lint_visibility_wave_a.rs:140
fn assert_fails_with(label: String, output: Output, code: String) -> {
    assert(!output.status.success(), "{label} must fail:\n{combined(output)}")
    assert(combined(output).contains("[{code}]"), "{label} must report {code}:\n{combined(output)}")
}

// Rust: tests/live_inspect.rs:10
struct ChildGuard { child: Child }
// Rust: tests/live_inspect.rs:12
impl Drop for ChildGuard {
    // Rust: tests/live_inspect.rs:13
    fn drop(&self) -> {
        // GATE #4494: kill and reap the native child even on assertion unwind.
        _ :: self.child.kill()
        _ :: self.child.wait()
    }
}
// Rust: tests/live_inspect.rs:29,130
LIVE_SOURCE :: "use core.tasks as tasks\nuse core.time as time\n\nfn run() {{\n    (secret_sender, _secrets) :: channel<String>(1)\n    secret_sender.send(\"TOP_SECRET_CHANNEL_PAYLOAD\")\n    (ready_sender, ready) :: channel<Int>()\n    (_sender, blocked) :: channel<Int>(1)\n    child :: task {{\n        ready_sender.send(1)\n        blocked.receive() ?? panic(\"closed\")\n    }}\n    child.detach()\n    ready.receive() ?? panic(\"closed\")\n    time.sleep(30000ms)\n}}\n"
// Rust: tests/live_inspect.rs:121
fn live_inspector_reads_tasks_without_payloads(args: [String], tag: String) -> {
    if !Common.have_rustc() { return }
    dir :: Common.unique_tmp(tag)
    fs.create_dir_all(dir).unwrap()
    source :: dir.join("live.jet")
    fs.write(source, LIVE_SOURCE).unwrap()
    // GATE #4494: native spawn, clock and sleep.
    child :: Command.new(env.var("JET_BIN").unwrap()).args(args).arg(source.to_str().unwrap()).current_dir(dir).stdout(Stdio.null()).stderr(Stdio.null()).spawn().unwrap()
    pid :: child.id()
    guard :: ChildGuard{child: ^child}
    deadline :: Instant.now() + Duration.from_secs(5)
    snapshot :: loop {
        observed :: LiveInspect.read(pid)
        if observed == Ok(value) {
            if value.contains("\"wait\":\"channel receive\"") { break value }
        }
        if Instant.now() < deadline { thread.sleep(Duration.from_millis(25)) }
        else { panic("{tag} snapshot never became observable: {observed:?}") }
    }
    assert(snapshot.contains("\"parent\":1"))
    assert(snapshot.contains("\"effects\":"))
    assert(snapshot.contains("\"arena_bytes\":"))
    assert(!snapshot.contains("TOP_SECRET_CHANNEL_PAYLOAD"))
    assert(!snapshot.contains("payload"))
    assert(!snapshot.contains("locals"))
    drop(^guard)
    _ :: fs.remove_file(LiveInspect.snapshot_path(pid))
    _ :: fs.remove_dir_all(dir)
}

