// Rust: tests/lint_visibility_wave_a.rs:15
fn run_jet(root: OSPath, args: [String]) -> Output {
    // GATE #4494: actual compiler process.
    return Command.new(env.var("JET_BIN").unwrap()).args(args).current_dir(root).env("NO_COLOR", "1").output().unwrap_or_else(error -> panic("run jet {args:?}: {error}"))
}
// Rust: tests/lint_visibility_wave_a.rs:24
fn combined(output: Output) -> String { "{String.from_utf8_lossy(output.stdout)}{String.from_utf8_lossy(output.stderr)}" }
// Rust: tests/lint_visibility_wave_a.rs:32
fn allow_io(root: OSPath) -> {
    fs.write(root.join("package.jet"), "name: \"lint-visibility\"\nversion: \"0.1.0\"\nauthority: {{ holds: {{ allow: [IO] }} }}\n").expect("write IO authority for lint visibility fixture")
}
// Rust: tests/lint_visibility_wave_a.rs:40
fn assert_advisory_visible(label: String, output: Output) -> {
    assert(output.status.success(), "{label} failed:\n{combined(output)}")
    assert(combined(output).contains("[L0101]"), "{label} should expose the unused-binding advisory:\n{combined(output)}")
}
// Rust: tests/lint_visibility_wave_a.rs:128
