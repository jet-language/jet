// Rust: tests/determinism.rs:396
#Test("nondeterministic_time_classification_is_shared_by_purity_and_folding") {
    pure_src :: """
use core.time as date
fn pure_today() -[]> String { return date.today().to_string() }
fn run() { print(pure_today()) }
"""
    purity_diagnostics :: compile(pure_src).expect_err("ambient date.today must be rejected in pure code")
    assert(purity_diagnostics.iter().any((diagnostic) -> diagnostic.code == "E3403"), "sema purity must report E3403, got: {purity_diagnostics:#?}")
    fold_src :: """
use core.time as date
fn run() { today :: prep { date.today() } }
"""
    fold_diagnostics :: compile(fold_src).expect_err("ambient date.today must be rejected at comptime")
    assert(fold_diagnostics.iter().any((diagnostic) -> diagnostic.code == "E3403"), "explicit comptime folding must report E3403, got: {fold_diagnostics:#?}")
    assert(fold_diagnostics.iter().all((diagnostic) -> diagnostic.code != "E0956"), "ambient date.today must not fall back to generic comptime E0956: {fold_diagnostics:#?}")
}
