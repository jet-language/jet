// Rust: tests/determinism.rs:711
#Test("ambient_draws_are_never_folded_into_the_build") {
    root :: common.unique_tmp("jet_fresh_draws")
    uuid_dir :: root.join("uuid")
    seeded_dir :: root.join("seeded")
    for (dir, name) in [(&uuid_dir, "fresh_uuid"), (&seeded_dir, "fresh_seeded")] {
        fs.create_dir_all(dir).unwrap()
        fs.write(dir.join("package.jet"), "name: \"{name}\"\nversion: \"0.1.0\"\nauthority: {{ holds: {{ allow: [IO, Mem.Alloc, Rand] }} }}\n").unwrap()
    }
    fs.write(uuid_dir.join("uuid.jet"), """
use core.crypto.uuid as uuid
fn run() -[Rand, IO]> {
    id :: uuid.v4() ?? panic("uuid")
    print(id)
}
""").unwrap()
    fs.write(seeded_dir.join("seeded.jet"), """
use core.math.random as random
fn run() -[Rand, IO]> {
    random.seed(42)
    first :: random.int(0, 1000000)
    second :: random.int(0, 1000000)
    print("{first != second}")
}
""").unwrap()
    first :: run_fresh_draw_program(&uuid_dir, &["run", "--debug", "uuid.jet"])
    second :: run_fresh_draw_program(&uuid_dir, &["run", "--debug", "uuid.jet"])
    assert_ne(first.trim(), second.trim(), "uuid.v4 repeated across runs")
    rust :: run_fresh_draw_program(&uuid_dir, &["emit", "--rust", "uuid.jet"])
    // Generated Rust is a peer comparator, never a production callback.
    for id in [first.trim(), second.trim()] { assert(!rust.contains(id), "generated Rust contains the drawn UUID {id}") }
    for tier in [["run", "seeded.jet"], ["run", "--debug", "seeded.jet"], ["run", "--release", "seeded.jet"]] {
        assert_eq(run_fresh_draw_program(&seeded_dir, tier).trim(), "true", "two seeded draws repeated one folded value on {tier:?}")
    }
}
// Rust: tests/devtools.rs:53
#Test("devtools_reduce_shrinks_to_minimal_e0107_repro") {
    dir :: isolated_cwd("reduce")
    src_path :: dir.join("repro.jet")
    fs.write(&src_path, "fn helper_a() {\n    print(\"a\")\n}\n\nfn helper_b() {\n    print(\"b\")\n}\n\nfn run() {\n    helper_a()\n    helper_b()\n    print(nonexistent_symbol_for_reduce_test)\n}\n").unwrap()
    out :: Command.new(jet()).args(["self", "devtools", "reduce"]).arg(&src_path).args(["--code", "E0107"]).output().unwrap()
    assert(out.status.success(), "reduce should succeed:\nstdout: {String.from_utf8_lossy(&out.stdout)}\nstderr: {String.from_utf8_lossy(&out.stderr)}")
    reduced_path :: dir.join("repro.reduced.jet")
    reduced :: fs.read_to_string(&reduced_path).unwrap_or_else((_) -> panic("missing {reduced_path.display()}; reduce stdout was:\n{String.from_utf8_lossy(&out.stdout)}"))
    assert(!reduced.contains("helper_a") && !reduced.contains("helper_b"), "reduce didn't shrink away the unused helpers:\n{reduced}")
    assert(reduced.contains("nonexistent_symbol_for_reduce_test"), "reduce shrunk away the line that reproduces E0107:\n{reduced}")
    assert(reduced.lines().count() <= 3, "expected reduce to shrink to <= 3 lines, got:\n{reduced}")
    recheck :: Command.new(jet()).arg("check").arg(&reduced_path).output().unwrap()
    stderr :: String.from_utf8_lossy(&recheck.stderr)
    assert(stderr.contains("E0107"), "reduced case no longer reproduces E0107:\n{stderr}")
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/devtools.rs:123
