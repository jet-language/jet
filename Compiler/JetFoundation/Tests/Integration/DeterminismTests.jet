    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/devtools.rs:150
#Test("devtools_ice_report_bundles_source_rust_and_versions") {
    dir :: isolated_cwd("ice_report")
    src_path :: dir.join("prog.jet")
    fs.write(&src_path, "fn run() {\n    print(\"hi\")\n}\n").unwrap()
    out :: Command.new(jet()).current_dir(&dir).args(["self", "devtools", "ice-report"]).arg(&src_path).output().unwrap()
    assert(out.status.success(), "ice-report should succeed:\nstdout: {String.from_utf8_lossy(&out.stdout)}\nstderr: {String.from_utf8_lossy(&out.stderr)}")
    stdout :: String.from_utf8_lossy(&out.stdout)
    bundle_line :: stdout.lines().find_map((line) -> line.strip_prefix("wrote ICE report bundle to ")).unwrap_or_else(() -> panic("no bundle-path line in stdout:\n{stdout}"))
    bundle_dir :: dir.join(bundle_line)
    assert(bundle_dir.is_dir(), "bundle dir `{bundle_dir.display()}` (from `{bundle_line}`) doesn't exist")
    for name in ["source.jet", "generated.rs", "rustc.stderr", "versions.txt"] { assert(bundle_dir.join(name).is_file(), "ice-report bundle missing `{name}` in {bundle_dir.display()}") }
    versions :: fs.read_to_string(bundle_dir.join("versions.txt")).unwrap()
    assert(versions.contains("jet "), "versions.txt: {versions}")
    source :: fs.read_to_string(bundle_dir.join("source.jet")).unwrap()
    assert(source.contains("fn run()"))
    _ :: fs.remove_dir_all(&dir)
}
// Rust: tests/devtools.rs:205
#Test("devtools_new_example_scaffolds_a_passing_golden_pair") {
    root :: repo_root()
    topic :: "tooling"
    name :: "devtools_test_scaffold_{process.id()}_208"
    example_path :: root.join("Examples/features").join(topic).join("{name}.jet")
    expected_path :: root.join("Examples/features/expected").join(topic).join("{name}.out")
    _ :: fs.remove_file(&example_path)
    _ :: fs.remove_file(&expected_path)
    _cleanup :: ScaffoldCleanup{paths: [example_path.clone(), expected_path.clone()]}
    out :: Command.new(jet()).current_dir(&root).args(["self", "devtools", "new-example"]).arg("{topic}/{name}").output().unwrap()
    assert(out.status.success(), "new-example should succeed:\nstdout: {String.from_utf8_lossy(&out.stdout)}\nstderr: {String.from_utf8_lossy(&out.stderr)}")
    assert(example_path.is_file(), "missing {example_path.display()}")
    assert(expected_path.is_file(), "missing {expected_path.display()}")
    src :: fs.read_to_string(&example_path).unwrap()
    shown :: "Examples/features/{topic}/{name}.jet"
    compiled :: compile_with_path(&src, &example_path.to_string_lossy()).unwrap_or_else((diags) -> panic("scaffolded example failed the front end:\n{render_diagnostics(&shown, &src, &diags)}"))
    if common.have_rustc() {
        // Real rustc peer comparator proves the generated scaffold and golden pair.
        rs :: dir_join_unique("devtools_new_example")
        fs.write(&rs, &compiled.rust).unwrap()
        bin :: rs.with_extension("")
        rustc :: Command.new("rustc").args(["--edition", "2021"]).arg(&rs).arg("-o").arg(&bin).output().unwrap()
        assert(rustc.status.success(), "I2 violated by scaffold: rustc rejected generated code:\n{String.from_utf8_lossy(&rustc.stderr)}")
        run :: Command.new(&bin).output().unwrap()
        assert(run.status.success())
        expected :: fs.read_to_string(&expected_path).unwrap()
        assert_eq(String.from_utf8_lossy(&run.stdout), expected, "scaffold stdout must match its own .out fixture")
        _ :: fs.remove_file(&rs)
        _ :: fs.remove_file(&bin)
    }
    _ :: fs.remove_file(&example_path)
    _ :: fs.remove_file(&expected_path)
}
// Rust: tests/devtools.rs:295
#Test("devtools_new_ui_scaffolds_a_self_consistent_snapshot_pair") {
    root :: repo_root()
    name :: "devtools_test_scaffold_{process.id()}_297"
    jet_path :: root.join("tests/ui").join("{name}.jet")
    stderr_path :: root.join("tests/ui").join("{name}.stderr")
    _ :: fs.remove_file(&jet_path)
    _ :: fs.remove_file(&stderr_path)
    _cleanup :: ScaffoldCleanup{paths: [jet_path.clone(), stderr_path.clone()]}
    out :: Command.new(jet()).current_dir(&root).args(["self", "devtools", "new-ui"]).arg(&name).output().unwrap()
    assert(out.status.success(), "new-ui should succeed:\nstdout: {String.from_utf8_lossy(&out.stdout)}\nstderr: {String.from_utf8_lossy(&out.stderr)}")
    assert(jet_path.is_file(), "missing {jet_path.display()}")
    assert(stderr_path.is_file(), "missing {stderr_path.display()}")
    src :: fs.read_to_string(&jet_path).unwrap()
    shown_path :: "tests/ui/{name}.jet"
    actual :: match compile_with_path(&src, &shown_path) {
        Err(diags) -> render_diagnostics(&shown_path, &src, &diags),
        Ok(_) -> "(no errors)\n"
    }
    expected :: fs.read_to_string(&stderr_path).unwrap()
    assert_eq(actual, expected, "scaffolded pair isn't self-consistent")
    assert(actual.contains("Error ["), "expected the scaffold to trigger a real diagnostic, got:\n{actual}")
    _ :: fs.remove_file(&jet_path)
    _ :: fs.remove_file(&stderr_path)
}
// Rust: tests/devtools.rs:343
#Test("devtools_check_fixture_paths_runs_clean_on_this_repo") {
    root :: repo_root()
    out :: Command.new(jet()).current_dir(&root).args(["self", "devtools", "check-fixture-paths"]).output().unwrap()
    assert(out.status.success(), "check-fixture-paths should run clean on this repo:\nstdout: {String.from_utf8_lossy(&out.stdout)}\nstderr: {String.from_utf8_lossy(&out.stderr)}")
    assert(String.from_utf8_lossy(&out.stdout).contains("all present"), "expected an all-present summary line")
}
// Rust: tests/devtools.rs:369
#Test("devtools_bless_dry_run_lists_every_known_target") {
    out :: Command.new(jet()).args(["self", "devtools", "bless", "--dry-run"]).output().unwrap()
    assert(out.status.success())
    stdout :: String.from_utf8_lossy(&out.stdout)
    for target in ["cli", "cross", "diagnostic_snapshots", "diagnostics_coverage", "release_gates"] {
        assert(stdout.contains("cargo test --test {target}"), "bless --dry-run missing target `{target}`:\n{stdout}")
        assert(stdout.contains("UPDATE_EXPECT=1"), "bless --dry-run should show the UPDATE_EXPECT wiring:\n{stdout}")
    }
}
// Rust: tests/devtools.rs:398
#Test("devtools_bless_rejects_unknown_target") {
    out :: Command.new(jet()).args(["self", "devtools", "bless", "not_a_real_test_target", "--dry-run"]).output().unwrap()
    assert(!out.status.success(), "bless should reject an unknown target name")
    assert(String.from_utf8_lossy(&out.stderr).contains("unknown bless target"), "stderr: {String.from_utf8_lossy(&out.stderr)}")
}
