// Rust: tests/diagnostic_snapshots.rs:1420
pub fn normalize_volatile_ui_snapshot(shown_path: &String, actual: String) -> String {
    relative := actual.replace("{common.manifest_dir()}/", "")
    if fixture_root := shown_path.strip_suffix("/workspace.jet") { relative = relative.replace(fixture_root, "/tmp") }
    normalized :: relative.lines().filter(|line| -> !line.contains("Blocking waiting for file lock on package cache")).map(|line| -> "{line}\n").collect<String>()
    if shown_path.ends_with("ffi_fetch_failed.jet") && normalized.contains("Error [E0704]") && normalized.contains("not-a-real-crate-xyz@9.9.9") && cargo_index_unavailable(&normalized) {
        return fs.read_to_string("tests/ui/ffi_fetch_failed.stderr").expect("ffi_fetch_failed.stderr must exist")
    }
    normalized
}
// Rust: tests/diagnostic_snapshots.rs:1452
pub fn cargo_index_unavailable(actual: &String) -> Bool {
    actual.contains("download of config.json failed") || actual.contains("failed to download from `https://index.crates.io/config.json`") || actual.contains("spurious network error") || actual.contains("Could not resolve host: index.crates.io") || actual.contains("Resolving timed out")
}

// Rust: tests/diagnostic_snapshots.rs:1562
#Derive(Clone)
pub enum UpdateSelector { None; All; One(String) }
// Rust: tests/diagnostic_snapshots.rs:1573
pub fn update_selector() -> UpdateSelector {
    case_law.assert_user_facing_case_law()
    match env.var("UPDATE_EXPECT") {
        Err(_) -> UpdateSelector.None
        Ok(value) if value.trim() == "1" -> {
            assert(bless_reason().is_some(), "UPDATE_EXPECT=1 rewrites every fixture, so it must name the compiler change that justifies the new output:\n    UPDATE_EXPECT_REASON=\"<commit or ratified decision>\" UPDATE_EXPECT=1 …\nTo bless one reviewed fixture instead, use JET_UI_FILTER=<canonical-relative-name> UPDATE_EXPECT=<same-name>.")
            UpdateSelector.All
        }
        Ok(value) -> UpdateSelector.One(common.normalize_fixture_selector("UPDATE_EXPECT", &value))
    }
}
// Rust: tests/diagnostic_snapshots.rs:1596
pub fn bless_reason() -> String? {
    reason :: env.var("UPDATE_EXPECT_REASON").ok()?
    trimmed := reason.trim() // #4303
    owned :: trimmed.to_string()
    if owned.len() >= 8 { Some(^owned) } else { None }
}
// Rust: tests/diagnostic_snapshots.rs:1606
pub fn rendered_diagnostic_count(rendered: &String) -> USize {
    rendered.lines().filter(|line| -> line.starts_with("Error [") || line.starts_with("Warning [") || line.starts_with("Stop [")).count()
}
// Rust: tests/diagnostic_snapshots.rs:1624
pub fn write_blessed_snapshot(expect_path: &OSPath, shown_path: &String, actual: &String) -> {
    previous :: fs.read_to_string(expect_path).unwrap_or_default()
    before :: rendered_diagnostic_count(&previous)
    after :: rendered_diagnostic_count(actual)
    if after < before {
        named :: env.var("UPDATE_EXPECT_SHRINK").ok().is_some_and(|value| -> value.trim() == shown_path)
        reason :: bless_reason()
        assert(named && reason.is_some(), "refusing to bless {shown_path}: its diagnostic count would fall {before} -> {after}. A disappearing diagnostic is a defect the compiler accepts in silence, so name the change that retired it:\n    UPDATE_EXPECT_SHRINK={shown_path} UPDATE_EXPECT_REASON=\"<commit or ratified decision>\" …\nIf nothing retired it, the diagnostic still fires and this snapshot is the bug.")
        eprintln("blessed shrink {shown_path}: {before} -> {after} diagnostics — {reason.unwrap_or_default()}")
    }
    fs.write(expect_path, actual).unwrap()
}
// Rust: tests/diagnostic_snapshots.rs:1650
pub fn validate_scoped_update(update: &UpdateSelector, paths: impl Iterator<String>) -> {
    selector :: match update { UpdateSelector.One(selector) -> selector; _ -> return }
    matches :: paths.filter(|path| -> path.contains(selector)).collect<[String]>()
    assert_eq(matches.len(), 1, "UPDATE_EXPECT={selector} must match exactly one fixture; matched: {matches:?}")
}
// Rust: tests/diagnostic_snapshots.rs:1662
pub fn should_update(update: &UpdateSelector, shown_path: &String) -> Bool {
    match update { UpdateSelector.None -> false; UpdateSelector.All -> true; UpdateSelector.One(selector) -> shown_path.contains(selector) }
}
