// Rust: tests/diagnostic_snapshots.rs:1123
pub fn run_complexity_cli_snapshot(file: &String, spec: &String) -> String {
    parts := spec.split_whitespace()
    expectation :: parts.next().expect("complexity snapshot needs pass/fail")
    max :: parts.next().expect("complexity snapshot needs a budget")
    assert(parts.next().is_none(), "complexity snapshot directive has extra words: {spec}")
    output :: Command.new(common.jet_bin()).args(["lint", "--complexity", file]).arg("--max={max}").args(["--color=never"]).env("NO_COLOR", "1").output().expect("run cognitive-complexity CLI fixture")
    match expectation {
        "fail" -> {
            assert(!output.status.success(), "over-budget cognitive-complexity fixture must fail")
            assert(std.str.from_utf8(&output.stderr).expect("complexity stderr is UTF-8").contains("[L2902]"), "over-budget fixture must reach the complexity lint, not another failure: {String.from_utf8_lossy(&output.stderr)}")
        }
        "pass" -> assert(output.status.success(), "refactored cognitive-complexity fixture must pass")
        other -> panic("complexity snapshot expects `pass` or `fail`, got `{other}`")
    }
    rendered := String.from_utf8(output.stdout).expect("complexity stdout is UTF-8")
    rendered.push_str(&String.from_utf8(output.stderr).expect("complexity stderr is UTF-8"))
    rendered
}
// Rust: tests/diagnostic_snapshots.rs:1163
pub fn run_sandbox_cli_snapshot(file: &String, missing_wasm_tools: Bool) -> String {
    scratch :: common.unique_tmp(if missing_wasm_tools { "jet_ui_e1259" } else { "jet_ui_e1258" })
    fs.create_dir_all(&scratch).unwrap()
    _ :: fs.copy(file, scratch.join("main.jet")).expect("copy sandbox diagnostic fixture")
    command := Command.new(common.jet_bin())
    command.args(["build", "main.jet", "--target=sandbox", "--color=never"]).current_dir(&scratch).env("NO_COLOR", "1")
    if missing_wasm_tools {
        which :: |tool: &String| -> Command.new("which").arg(tool).output().ok().filter(|output| -> output.status.success()).map(|output| -> {
            path := String.from_utf8_lossy(&output.stdout).trim() // #4303
            path.to_string()
        })
        rustc_path :: which("rustc").expect("E1259 snapshot needs rustc on PATH")
        lld_path :: which("lld").expect("E1259 snapshot needs lld on PATH")
        bin_dir :: scratch.join("bin")
        fs.create_dir_all(&bin_dir).unwrap()
        // GATE #4483 / #4494: selected Unix family and native symlinks.
        if target.selected_family() == "unix" {
            std.os.unix.fs.symlink(&rustc_path, bin_dir.join("rustc")).expect("link rustc for E1259 snapshot")
            std.os.unix.fs.symlink(&lld_path, bin_dir.join("lld")).expect("link lld for E1259 snapshot")
        } else { panic("E1259 snapshot needs Unix symlink support") }
        command.env("PATH", &bin_dir)
    }
    output :: command.output().expect("run sandbox diagnostic fixture")
    _ :: fs.remove_dir_all(&scratch)
    assert(!output.status.success(), "sandbox diagnostic fixture must fail")
    rendered := String.from_utf8(output.stdout).expect("sandbox stdout is UTF-8")
    rendered.push_str(&String.from_utf8(output.stderr).expect("sandbox stderr is UTF-8"))
    rendered
}
