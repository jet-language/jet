// Rust: tests/diagnostic_snapshots.rs:1281
pub fn run_jetpack_hangar_digest_mismatch_snapshot() -> String {
    scratch :: common.unique_tmp("jet_ui_hangar_digest_mismatch")
    root :: scratch.join("root")
    project :: scratch.join("project")
    dependency :: scratch.join("dependency")
    source :: scratch.join("source")
    fs.create_dir_all(&project).unwrap()
    fs.create_dir_all(&dependency).unwrap()
    fs.create_dir_all(&source).unwrap()
    fs.write(dependency.join("payload"), "dependency bytes\n").unwrap()
    fs.write(source.join("payload"), "trusted bytes\n").unwrap()
    roots :: jetpack.Store.Roots(root: root.clone(), dev_mode: false)
    ingest :: |name: &String, output: OSPath, references: [String]| -> {
        jetpack.Store.ingest_tree(&roots, &jetpack.Store.IngestRequest(name: name.to_string(), version: "", reference: "path:{output.display()}", cache_identity: jetpack.Store.CacheIdentity.default(), references: ^references, outputs: ["out": ^output], signature: "", provenance: "", platform_artifact_kind: "")).expect("seed valid Hangar closure for diagnostic fixture")
    }
    ingested_dependency :: ingest("ui-e1315-dependency", ^dependency, [])
    ingested :: ingest("ui-e1315", ^source, [ingested_dependency.entry.envelope.output_hash])
    digest :: ingested.entry.envelope.output_hash
    object :: root.join("hangar/objects").join(&digest)
    payload :: object.join("payload")
    loop path in [&object, &payload] {
        permissions := fs.metadata(path).unwrap().permissions()
        permissions.set_readonly(false)
        fs.set_permissions(path, permissions).unwrap()
    }
    fs.write(&payload, "tampered bytes\n").unwrap()
    output :: Command.new(common.jetpack_bin()).args(["hangar", "verify", &digest, "--no-color"]).current_dir(&project).env("JETPACK_ROOT", &root).output().expect("run real jetpack hangar verify diagnostic fixture")
    _ :: fs.remove_dir_all(&scratch)
    assert_eq(output.status.code(), Some(2), "tampered Hangar object must fail verification: {String.from_utf8_lossy(&output.stderr)}")
    stderr :: String.from_utf8(output.stderr).expect("Jetpack diagnostic is UTF-8")
    start :: stderr.find("Error [E1315]:").expect("real hangar verify must emit E1315")
    stderr[start..].to_string()
}
