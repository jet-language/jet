//RS #[derive(Clone)]
//RS enum UpdateSelector {
//RS     None,
//RS     All,
//RS     One(String),
//RS }
//RS 
//RS /// `UPDATE_EXPECT=1` is the reviewed sweep; card #2026 made it name its author.
//RS /// A sweep is the only bless that can rewrite a fixture nobody read, so it
//RS /// carries `UPDATE_EXPECT_REASON` — the compiler change that justifies the new
//RS /// output. 6fd88282b had none: zero crate source changed and 122 contracts moved.
//RS fn update_selector() -> UpdateSelector {
