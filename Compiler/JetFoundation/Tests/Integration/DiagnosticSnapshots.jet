//RS     print(json.canonical(doc) ?? "")
//RS     total := 0
//RS     total = total + 1
//RS     print(total)
//RS }
//RS "#;
//RS     let path = unique_tmp("jet_core_lint_boundary").join("core_lint_boundary.jet");
