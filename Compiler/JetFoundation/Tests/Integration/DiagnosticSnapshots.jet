//RS         assert!(
//RS             !lint.origin().is_some_and(|origin| origin.is_core_source()),
//RS             "a Core lint leaked into user output:\n{rendered}"
//RS         );
//RS         if lint.origin().is_none() {
//RS             assert!(
//RS                 lint.span.is_none_or(|span| span.end <= source.len()),
//RS                 "a lint points outside the user's source:\n{rendered}"
//RS             );
//RS         }
//RS     }
//RS     assert!(
//RS         compiled.lints.iter().any(|lint| lint.code == "L0503"),
//RS         "the user's own compound-assignment lint must still surface:\n{rendered}"
//RS     );
//RS }
