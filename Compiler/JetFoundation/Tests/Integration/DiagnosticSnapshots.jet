use std.ffi.OsString
use std.time.[SystemTime, UNIX_EPOCH]
use core.sys.target

// Rust: tests/diagnostic_snapshots.rs:48
pub fn compiler_extension_env_lock() -> &Mutex<Unit> {
    // GATE #4494: serialize real process-global environment changes.
    static LOCK: OnceLock<Mutex<Unit>> = OnceLock.new()
    LOCK.get_or_init(|| -> Mutex.new(()))
}
// Rust: tests/diagnostic_snapshots.rs:53
pub struct CompilerExtensionEnvRestore { previous: OsString? }
impl CompilerExtensionEnvRestore {
    // Rust: tests/diagnostic_snapshots.rs:56
    fn drop(&self) -> {
        match self.previous.take() {
            Some(value) -> env.set_var("JET_COMPILER_EXTENSION", value)
            None -> env.remove_var("JET_COMPILER_EXTENSION")
        }
    }
}
// Rust: tests/diagnostic_snapshots.rs:64
pub fn compiler_extension_env(compiler_extension: String?) -> (MutexGuard<Unit>, CompilerExtensionEnvRestore) {
    if compiler_extension.is_some() { _ :: common.jetpack_bin() }
    guard :: compiler_extension_env_lock().lock().unwrap_or_else(|poisoned| -> poisoned.into_inner())
    restore :: CompilerExtensionEnvRestore(previous: env.var_os("JET_COMPILER_EXTENSION"))
    match compiler_extension {
        Some(rel) -> {
            wasm :: OSPath.from(common.manifest_dir()).join(rel)
            env.set_var("JET_COMPILER_EXTENSION", wasm.to_str().expect("utf-8 wasm path"))
        }
        None -> env.remove_var("JET_COMPILER_EXTENSION")
    }
    (^guard, ^restore)
}

// Rust: tests/diagnostic_snapshots.rs:90
pub struct UiFixtureScratch { root: OSPath; entry: OSPath }
impl UiFixtureScratch {
    // Rust: tests/diagnostic_snapshots.rs:96
    pub fn for_entry(entry: &OSPath) -> UiFixtureScratch? {
        fixture_root :: entry.parent()?
        state :: fixture_root.join("state")
        if !state.is_dir() { return None }
        base :: env.var_os("JET_TEST_SCRATCH_DIR").or_else(|| -> env.var_os("JET_TEST_SCRATCH")).map(OSPath.from).unwrap_or_else(|| -> OSPath.from(env.var_os("HOME").expect("HOME is required for test scratch")).join(".cache/jet-test-scratch"))
        fs.create_dir_all(&base).expect("create UI fixture scratch root")
        canonical_base :: fs.canonicalize(base).expect("canonicalize UI fixture scratch root")
        repo :: fs.canonicalize(common.manifest_dir()).expect("canonicalize repo root")
        assert(!canonical_base.starts_with(&repo) && !canonical_base.starts_with("/tmp"), "UI fixture scratch must be outside the repository and disk-backed: {canonical_base.display()}")
        stamp :: SystemTime.now().duration_since(UNIX_EPOCH).expect("system clock before Unix epoch").as_nanos()
        root :: canonical_base.join("ui-fixture-{std.process.id()}-{stamp}")
        fs.create_dir_all(&root).expect("create UI fixture scratch project")
        copy_ui_fixture_tree(fixture_root, &root, true)
        manifest :: root.join("package.jet")
        if !manifest.is_file() {
            source :: fs.read_to_string(entry).unwrap_or_else(|error| -> panic("read UI fixture entry {entry.display()}: {error}"))
            has_inline_package :: source.lines().any(|line| -> line.trim_start().starts_with("package {"))
            is_workspace_entry :: entry.file_name().and_then(|name| -> name.to_str()) == Some(jet.Syntax.WORKSPACE_FILE)
            if !has_inline_package && !is_workspace_entry {
                package_name :: entry.file_stem().and_then(|name| -> name.to_str()).unwrap_or("ui-fixture-scratch")
                fs.write(&manifest, "name: \"{package_name}\"\nversion: \"0.1.0\"\n").unwrap_or_else(|error| -> panic("write staged UI package manifest {manifest.display()}: {error}"))
            }
        }
        jet_state :: root.join(".jet")
        fs.create_dir_all(&jet_state).expect("create staged UI .jet state")
        copy_ui_fixture_tree(&state, &jet_state, false)
        Some(UiFixtureScratch(entry: root.join(entry.file_name()?), root: ^root))
    }
    // Rust: tests/diagnostic_snapshots.rs:171
    fn drop(&self) -> { _ :: fs.remove_dir_all(&self.root) }
}
// Rust: tests/diagnostic_snapshots.rs:176
pub fn copy_ui_fixture_tree(source: &OSPath, destination: &OSPath, skip_state: Bool) -> {
    loop item in fs.read_dir(source).unwrap_or_else(|error| -> panic("read UI fixture directory {source.display()}: {error}")).flatten() {
        name :: item.file_name()
        if skip_state && (name == "state" || name == "stderr") { continue }
        from :: item.path()
        to :: destination.join(&name)
        file_type :: item.file_type().expect("read UI fixture entry type")
        if file_type.is_dir() {
            fs.create_dir_all(&to).expect("create copied UI fixture directory")
            copy_ui_fixture_tree(&from, &to, false)
        } else if file_type.is_file() {
            _ :: fs.copy(&from, &to).unwrap_or_else(|error| -> panic("copy UI fixture {from.display()} -> {to.display()}: {error}"))
        }
    }
}

// Rust: tests/diagnostic_snapshots.rs:1026
pub fn run_retired_gate_flag_snapshot(file: &String) -> String {
    retirement :: jet.Syntax.retirement("allow-impure").expect("retired gate row")
    output :: Command.new(common.jet_bin()).args(["run", file]).arg(retirement.retired).env("NO_COLOR", "1").output().expect("run retired gate fixture")
    assert(!output.status.success(), "retired gate flag must fail")
    rendered := String.from_utf8(output.stdout).expect("retired gate stdout is UTF-8")
    rendered.push_str(&String.from_utf8(output.stderr).expect("retired gate stderr is UTF-8"))
    rendered
}
