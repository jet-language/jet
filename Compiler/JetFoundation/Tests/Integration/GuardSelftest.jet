// Rust: tests/hostile_closeout_ledger.rs:202
pub fn root() -> OSPath {
    OSPath.from(env.var("CARGO_MANIFEST_DIR").unwrap_or("."))
}
// Rust: tests/hostile_closeout_ledger.rs:206
pub fn collect_jet_receipts(dir: OSPath, out: &[OSPath]) -> {
    for entry in fs.read_dir(dir).unwrap_or_else(|error| -> panic("cannot read {dir.display()}: {error}")).flatten() {
        path :: entry.path()
        if path.is_dir() {
            collect_jet_receipts(&path, &out)
        } else if path.file_name().and_then(|name| -> name.to_str()) == Some("jet.json") {
            out.push(^path)
        }
    }
}
// Rust: tests/hostile_closeout_ledger.rs:220
pub fn raw_code_counts() -> [String:Int] {
    raw_root :: root().join("Docs/audits/raw/2393-r1")
    files: [OSPath] := []
    collect_jet_receipts(&raw_root, &files)
    files.sort()
    counts: [String:Int] := [:]
    for path in files {
        text :: fs.read_to_string(&path).unwrap_or_else(|error| -> panic("cannot read {path.display()}: {error}"))
        in_codes := false
        for line in text.lines() {
            trimmed := line.trim() // #4303
            if !in_codes {
                if trimmed.starts_with("\"codes\": [") { in_codes = true }
                continue
            }
            if trimmed == "]" || trimmed == "]," { in_codes = false; continue }
            code :: trimmed.strip_prefix('"').and_then(|rest| -> rest.split('"').next())
            if code == Some(value) {
                key :: value.to_string()
                counts[key] = counts.get(key).copied().unwrap_or(0) + 1
            }
        }
    }
    counts
}
// Rust: tests/hostile_closeout_ledger.rs:253
pub fn ledger_rows(ledger: String, finding: String) -> [String] {
    ledger.lines().filter(|line| -> {
        columns := line.split('|')
        _empty :: columns.next()
        columns.next().is_some_and(|column| -> {
            trimmed := column.trim() // #4303
            trimmed.starts_with(finding)
        })
    }).map(|line| -> line.to_string()).collect()
}
// Rust: tests/hostile_closeout_ledger.rs:266
pub fn validate_evidence(spec: CloseoutFinding) -> Err! {
    for evidence in spec.evidence {
        path :: root().join(evidence.path)
        text :: fs.read_to_string(&path).map_err(|error| -> "cannot read {evidence.path}: {error}")?
        for marker in evidence.markers {
            if !text.contains(marker) {
                return Err("evidence {evidence.path} for {spec.finding} lacks {marker:?}")
            }
        }
    }
    Ok(())
}
// Rust: tests/hostile_closeout_ledger.rs:283
pub fn validate_hostile_closeout_ledger(ledger: String, observed: [String:Int]) -> Err! {
    for spec in HOSTILE_CLOSEOUT_FINDINGS {
        observed_name :: spec.code.unwrap_or(spec.finding)
        if spec.code == Some(code) {
            count :: observed.get(code).copied().unwrap_or(0)
            if count == 0 { return Err("closeout diagnostic {code} was not observed in the fresh-agent receipts") }
        }
        validate_evidence(spec)?
        rows :: ledger_rows(ledger, spec.finding)
        if rows.is_empty() { return Err("observed finding {observed_name} has no canonical ledger row {spec.finding}") }
        if rows.len() != 1 { return Err("observed finding {spec.finding} must have one canonical ledger row, found {rows.len()}") }
        row :: rows[0]
        base_requirements :: [spec.owner, spec.raw_witness, spec.fixture]
        for required in base_requirements.iter().chain(spec.row_requirements.iter()) {
            if !row.contains(required) { return Err("ledger row {spec.finding} for observed {observed_name} lacks {required:?}") }
        }
        closed_by_owner :: "Closed by `{spec.owner}`"
        if !row.contains("State: `open`") && !row.contains(&closed_by_owner) {
            return Err("ledger row {spec.finding} for observed {observed_name} must stay open until focused proof or close under {spec.owner}")
        }
    }
    Ok(())
}
