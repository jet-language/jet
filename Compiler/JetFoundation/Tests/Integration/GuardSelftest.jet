use jet.[compile, compile_with_path]
use jet.Diagnostics.Diagnostic
use std.[fs, env, process]

// Rust: tests/hardening.rs:11
pub fn expect_error(src: String, code: String) -> {
    diags :: compile(src).expect_err("front end should reject this")
    assert(diags.iter().any(|d| -> d.code == code),
        "expected {code}, got: {diags.iter().map(|d| -> (d.code.clone(), d.what.clone())).collect():?}")
}
// Rust: tests/hardening.rs:378
pub fn temp_project(name: String) -> OSPath {
    // GATE #4494: native temporary directory and process identity.
    dir :: env.temp_dir().join("jet_hardening_{name}_{process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    dir
}
// Rust: tests/hardening.rs:385
pub fn compile_bundle(entry: OSPath) -> String [Diagnostic]! {
    src :: fs.read_to_string(entry).unwrap()
    compile_with_path(&src, entry.to_str().unwrap()).map(|o| -> o.rust)
}

