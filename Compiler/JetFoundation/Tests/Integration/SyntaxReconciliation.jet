// Rust: tests/syntax_reconciliation.rs:433
pub fn ratified_reference_gap_ids(source: String) -> [String: Bool] {
    ids := [String: Bool]{}
    loop line in source.lines() {
        if line.split_once("# RATIFIED, NOT YET IMPLEMENTED (").and_then(fn((_, rest)) { rest.split_once(')') }) == Val((names, _)) {
            loop name in names.split('/') {
                id := name.trim() // #4303
                if id != "<id>" { ids.insert(id.to_string(), true) }
            }
        }
    }
    ids
}
// Rust: tests/syntax_reconciliation.rs:923
pub fn scan_old_binding_codes(path: &OSPath, text: String, failures: &[String]) -> {
    loop (idx, line) in text.lines().enumerate() {
        loop code in OLD_BINDING_CODES {
            if line.contains(code) && !allowed_old_binding_reference(path, text, line) {
                failures.push("{path.display()}:{idx + 1} contains retired binding diagnostic `{code}`")
            }
        }
    }
}
// Rust: tests/syntax_reconciliation.rs:938
pub fn scan_old_binding_examples(path: &OSPath, text: String, failures: &[String]) -> {
    if path.extension().and_then(fn(x) { x.to_str() }) == Val("rs") {
        loop (line, literal) in rust_string_literals(text) {
            if literal_has_old_binding_example(literal) && !allowed_old_binding_reference(path, text, literal) {
                failures.push("{path.display()}:{line} contains retired binding spelling in a Rust string literal")
            }
        }
        return
    }
    loop (idx, line) in text.lines().enumerate() {
        if line_has_old_binding_start(line) && !allowed_old_binding_reference(path, text, line) {
            failures.push("{path.display()}:{idx + 1} contains retired binding spelling `{line.trim()}`")
        }
    }
}
// Rust: tests/syntax_reconciliation.rs:966
pub fn rust_string_literals(text: String) -> [(USize, String)] {
    bytes :: text.as_bytes()
    out := [(USize, String)]{}
    i := 0; line := 1
    loop i < bytes.len() {
        if bytes[i] == U8{10} { line += 1; i += 1 }
        else if bytes[i] == U8{114} {
            start_line :: line
            j := i + 1
            loop j < bytes.len() && bytes[j] == U8{35} { j += 1 }
            if j >= bytes.len() || bytes[j] != U8{34} { i += 1; next }
            hashes :: j - (i + 1)
            closing_hashes :: [U8]{35; hashes}
            j += 1
            content_start :: j
            loop j < bytes.len() {
                if bytes[j] == U8{10} { line += 1 }
                if bytes[j] == U8{34} && bytes[j + 1..].starts_with(closing_hashes) {
                    content :: String.from_utf8_lossy(bytes[content_start..j]).to_string()
                    out.push((start_line, content))
                    j += 1 + hashes
                    break
                }
                j += 1
            }
            i = j
        } else if bytes[i] == U8{34} {
            if i > 0 && i + 1 < bytes.len() && bytes[i - 1] == U8{39} && bytes[i + 1] == U8{39} { i += 1; next }
            start_line :: line
            j := i + 1
            content := String.new()
            loop j < bytes.len() {
                if bytes[j] == U8{92} && j + 1 < bytes.len() {
                    next_char :: bytes[j + 1] as Char
                    if next_char == 'n' { content.push('\n') } else { content.push(next_char) }
                    j += 2
                } else if bytes[j] == U8{34} { j += 1; break }
                else if bytes[j] == U8{10} { line += 1; content.push('\n'); j += 1 }
                else { content.push(bytes[j] as Char); j += 1 }
            }
            out.push((start_line, content))
            i = j
        } else { i += 1 }
    }
    out
}
// Rust: tests/syntax_reconciliation.rs:1049
pub fn literal_has_old_binding_example(literal: String) -> Bool { literal.lines().any(line_has_old_binding_start) }
// Rust: tests/syntax_reconciliation.rs:1053
pub fn line_has_old_binding_start(line: String) -> Bool {
    loop segment in line.split(['{', ';']) {
        trimmed := segment.trim_start() // #4303
        loop word in OLD_BINDING_WORDS {
            if trimmed.strip_prefix(word) == Val(rest) {
                if rest.starts_with(' ') || rest.starts_with('\t') -> return true
            }
        }
    }
    false
}
// Rust: tests/syntax_reconciliation.rs:1067
pub fn allowed_old_binding_reference(path: &OSPath, text: String, line: String) -> Bool {
    s :: path.to_string_lossy()
    if s.ends_with("tests/ui/foreign_declaration_binding.jet") -> return line_has_old_binding_start(line)
    s.ends_with("Source/LSP/mod.rs") && text.contains("fn old_binding_keyword_has_no_teaching_edit")
        && (line.contains("let x = 1") || line.contains("E0009") || line.contains("E0985"))
}
