// Rust: tests/syntax_reconciliation.rs:1090
pub fn source_identifier_offsets(source: String, identifier: String) -> [USize] {
    // Rust: tests/syntax_reconciliation.rs:1091
    fn collect(tokens: &[Token], identifier: String, offsets: &[USize]) -> {
        loop token in tokens {
            if token.kind == {
                .Ident(name) -> { if name == identifier { offsets.push(token.span.start) } }
                .Str(parts) -> {
                    loop part in parts {
                        if part == .Interp(tokens) { collect(tokens, identifier, offsets) }
                    }
                }
                else -> {}
            }
        }
    }
    (tokens, _) :: Lexer.lex(source)
    offsets := [USize]{}
    collect(&tokens, identifier, &offsets)
    offsets
}
// Rust: tests/syntax_reconciliation.rs:1115
pub fn markdown_data_name_lines(text: String) -> [(USize, String)] {
    fence := None as (U8, USize, USize, String)?
    lines := [(USize, String)]{}
    source_lines :: text.lines().collect()
    loop (index, line) in source_lines.iter().enumerate() {
        if fence.as_ref() == Val((open_marker, open_len, _, _)) {
            if markdown_fence(line).is_some_and(fn((marker, len, rest)) { marker == open_marker && len >= open_len && rest.trim().is_empty() }) {
                (_, _, start_line, source) :: fence.take().unwrap()
                append_fence_data_lines(source, start_line, &source_lines, &lines)
            } else {
                (_, _, _, source) :: fence.as_mut().unwrap()
                source.push_str(line)
                source.push('\n')
            }
        } else if markdown_fence(line) == Val((marker, len, _)) {
            fence = Val((marker, len, index + 2, String.new()))
        } else if inline_code_has_identifier(line, "Data") { lines.push((index + 1, line)) }
    }
    if fence == Val((_, _, start_line, source)) { append_fence_data_lines(source, start_line, &source_lines, &lines) }
    lines
}
// Rust: tests/syntax_reconciliation.rs:1143
pub fn append_fence_data_lines(source: String, start_line: USize, source_lines: &[String], lines: &[(USize, String)]) -> {
    loop offset in source_identifier_offsets(source, "Data") {
        line_no :: start_line + source[..offset].bytes().filter(fn(byte) { byte == U8{10} }).count()
        if !lines.iter().any(fn((existing, _)) { existing == line_no }) { lines.push((line_no, source_lines[line_no - 1])) }
    }
}
// Rust: tests/syntax_reconciliation.rs:1161
pub fn markdown_fence(line: String) -> (U8, USize, String)? {
    trimmed := line.trim_start() // #4303
    marker :: trimmed.as_bytes().first() ?? return None
    if marker != U8{96} && marker != U8{126} -> return None
    len :: trimmed.bytes().take_while(fn(byte) { byte == marker }).count()
    if len >= 3 -> Val((marker, len, trimmed[len..])) else -> None
}
// Rust: tests/syntax_reconciliation.rs:1171
pub fn inline_code_has_identifier(line: String, identifier: String) -> Bool {
    bytes :: line.as_bytes()
    at := 0
    loop at < bytes.len() {
        if bytes[at] != U8{96} { at += 1; next }
        delimiter :: bytes[at..].iter().take_while(fn(byte) { byte == U8{96} }).count()
        content_start :: at + delimiter
        close := content_start
        matched := false
        loop close < bytes.len() {
            if bytes[close] != U8{96} { close += 1; next }
            run :: bytes[close..].iter().take_while(fn(byte) { byte == U8{96} }).count()
            if run == delimiter {
                if !source_identifier_offsets(line[content_start..close], identifier).is_empty() -> return true
                at = close + run; matched = true; break
            }
            close += run
        }
        if !matched -> break
    }
    false
}
// Rust: tests/syntax_reconciliation.rs:1209
pub fn files(path: &OSPath) -> [OSPath] {
    metadata :: fs.symlink_metadata(path) ?? return [OSPath]{}
    if metadata.file_type().is_file() -> return [path.to_path_buf()]
    if !metadata.file_type().is_dir() -> return [OSPath]{}
    pending := [path.to_path_buf()]
    out := [OSPath]{}
    loop pending.pop() == Val(directory) {
        entries :: fs.read_dir(&directory) ?? next
        loop entry in entries.flatten() {
            candidate :: entry.path()
            metadata :: fs.symlink_metadata(&candidate) ?? next
            if metadata.file_type().is_dir() {
                name :: candidate.file_name().and_then(fn(name) { name.to_str() }).unwrap_or_default()
                if [".git", ".claude", ".opencode", ".tmp", ".jet", ".tower", ".agent-worktrees", "jit-aot-parity-report", "node_modules", "target", "build", ".cache", "cache", "dist", "result"].contains(name)
                    || name.starts_with("target-") || name.starts_with("build-") || name.starts_with("result-") -> next
                pending.push(candidate)
            } else if metadata.file_type().is_file() { out.push(candidate) }
        }
    }
    out
}
// Rust: tests/syntax_reconciliation.rs:1268
pub fn should_skip(path: &OSPath) -> Bool {
    s :: path.to_string_lossy()
    name :: path.file_name().and_then(fn(name) { name.to_str() }).unwrap_or_default()
    s.contains("/target/") || name.starts_with("retired_") || name.contains("_retired_") || name.ends_with("_retired")
        || s.ends_with(".published.snapshot") || s.ends_with("tests/syntax_reconciliation.rs") || s.ends_with("Docs/spec/syntax-decisions.md")
}
// Rust: tests/syntax_reconciliation.rs:1283
pub fn scan_lines(path: &OSPath, text: String) -> [(USize, String)] {
    if path.extension().and_then(fn(x) { x.to_str() }) != Val("rs") -> return text.lines().enumerate().map(fn((i, l)) { (i + 1, l) }).collect()
    text.lines().enumerate().filter_map(fn((i, line)) {
        if path.ends_with("crates/jet-parser/src/Parser/Items.rs") && line.contains("retired_c_module_marker_diag") -> return None
        trimmed := line.trim_start() // #4303
        if trimmed.starts_with("//") || trimmed.starts_with("///") || trimmed.starts_with("//!") || line.contains('"') -> Val((i + 1, line)) else -> None
    }).collect()
}
// Rust: tests/syntax_reconciliation.rs:1361
pub fn forbidden_for_path(path: &OSPath) -> [String] {
    FORBIDDEN.iter().filter(fn(needle) {
        if needle == "pure fn" -> return path.starts_with("Docs")
        if path.extension().and_then(fn(x) { x.to_str() }) != Val("rs") -> return true
        !["#layout", "#grant", "#context", "List<", "List[", "Map<", "core.json", "use jet."].contains(needle)
    }).collect()
}
// Rust: tests/syntax_reconciliation.rs:1387
pub fn forbidden_occurs(line: String, needle: String) -> Bool {
    if !["List<", "List[", "Map<"].contains(needle) -> return line.contains(needle)
    offset := 0
    loop line[offset..].find(needle) == Val(relative) {
        index :: offset + relative
        preceded_by_ident :: line[..index].chars().next_back().is_some_and(fn(ch) { ch == '_' || ch.is_ascii_alphanumeric() })
        if !preceded_by_ident -> return true
        offset = index + needle.len()
    }
    false
}
