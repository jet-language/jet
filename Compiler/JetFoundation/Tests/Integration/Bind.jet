    assert(csv.contains("struct Person")); assert(csv.contains("name: String")); assert(csv.contains("age: Int?")); assert(csv.contains("active: Bool")); assert(csv.contains("notes: String"))
    sql := generated("sql", "sql_schema.sql", "CREATE TABLE users (id INTEGER PRIMARY KEY, price DECIMAL(10,2), active BOOLEAN NOT NULL, born DATE, opened TIME, created TIMESTAMP, data BLOB);\nCREATE TABLE audit (event TEXT NOT NULL);", Val("Root"), "jet inspect bind sql sql_schema.sql --type Root")
    assert(sql.contains("struct Users")); assert(sql.contains("id: Int")); assert(sql.contains("price: Decimal?")); assert(sql.contains("active: Bool")); assert(sql.contains("born: LocalDate?")); assert(sql.contains("opened: LocalTime?")); assert(sql.contains("created: DateTime?")); assert(sql.contains("data: [U8]?")); assert(sql.contains("struct Audit")); assert(!sql.contains("struct Root"))
    xml := generated("xml", "xml_catalog.xml", "<?xml version=\"1.0\" encoding=\"UTF-8\"?><?catalog generated?><catalog><!-- comment --><book id=\"1\"><title><![CDATA[<A]]></title></book><book id=\"2\"><title>B</title></book></catalog>", Val("Catalog"), "jet inspect bind xml xml_catalog.xml --type Catalog")
    assert(xml.contains("struct Catalog")); assert(xml.contains("book: [CatalogBook]")); assert(xml.contains("#Rename(\"@id\") id: String")); assert(xml.contains("title: String"))
    proto := generated("proto", "proto_repo.proto", "syntax = \"proto3\";\nmessage Repo {{ string name = 1; repeated Tag tags = 2; optional int64 stars = 3; }}\nmessage Tag {{ string value = 1; }}\n", Val("Repo"), "jet inspect bind proto proto_repo.proto --type Repo")
    assert(proto.contains("struct Repo")); assert(proto.contains("tags: [Tag]")); assert(proto.contains("stars: Int?")); assert(proto.contains("// proto field number: 2")); assert(proto.contains("#Codable"))
}
// Rust: tests/bind.rs:353
#Test("retired_top_level_bind_forms_teach_the_grouped_route") {
    dir := scratch("retired-bind")
    for args in [["bind", "missing.h"], ["--json", "bind", "missing.h"], ["-v", "bind", "missing.h"], ["--color=never", "bind", "missing.h"]] {
        output := Command.new(common.jet_exe()).args(args).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
        rendered := "{String.from_utf8_lossy(&output.stdout)}\n{String.from_utf8_lossy(&output.stderr)}"
        assert(!output.status.success(), "retired bind unexpectedly succeeded: {rendered}")
        assert(rendered.contains("E2101"), "retired bind lost its teaching diagnostic: {rendered}")
        assert(rendered.contains("inspect bind"), "retired bind lost its canonical fix: {rendered}")
        assert(!rendered.contains("jet bind"), "retired bind kept a top-level alias: {rendered}")
        assert(!rendered.contains("E3208"), "retired bind reached the binder: {rendered}")
    }
    _ :: fs.remove_dir_all(dir)
}
