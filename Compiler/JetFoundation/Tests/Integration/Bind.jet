#Test("data_bind_filesystem_errors_use_e2105") {
    dir := scratch("data-bind-io")
    missing := Command.new(common.jet_exe()).args(["inspect", "bind", "json", "missing.json", "--type", "Missing"]).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
    missing_stderr := String.from_utf8_lossy(&missing.stderr); assert_eq(missing.status.code(), Val(1))
    assert(missing_stderr.contains("Error [E2105]:"), "missing input lost E2105: {missing_stderr}")
    assert(!missing_stderr.contains("E3208"), "missing input was mislabeled as a schema error: {missing_stderr}")
    fs.write(dir.join("blocked"), "not a directory").unwrap(); fs.write(dir.join("valid.json"), "{{\"ok\":true}}").unwrap()
    blocked := Command.new(common.jet_exe()).args(["inspect", "bind", "json", "valid.json", "--type", "Valid", "-o", "blocked/generated.jet"]).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
    blocked_stderr := String.from_utf8_lossy(&blocked.stderr); assert_eq(blocked.status.code(), Val(1))
    assert(blocked_stderr.contains("Error [E2105]:"), "output IO failure lost E2105: {blocked_stderr}")
    assert(!blocked_stderr.contains("E3208"), "output IO failure was mislabeled as a schema error: {blocked_stderr}")
    _ :: fs.remove_dir_all(dir)
}
