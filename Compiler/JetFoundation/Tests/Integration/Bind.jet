// Rust: tests/bind.rs:914
#Test("data_bind_rejects_malformed_inputs") {
    dir := scratch("malformed-public")
    malformed := [
        ("json", "bad.json", "[]"), ("json", "bad.json", "{{\"x\":"),
        ("csv", "bad.csv", "a,a\n1,2\n"), ("csv", "bad.csv", "a,b\n1\n"), ("csv", "bad.csv", "a,b\n\"unterminated,2\n"),
        ("sql", "bad.sql", "CREATE TABLE x (id UNKNOWN);"), ("sql", "bad.sql", "CREATE TABLE x (id INT"),
        ("sql", "bad.sql", "CREATE TABLE x (id INTEGER PRIMARY KEY trailing);"), ("sql", "bad.sql", "CREATE TABLE x (id VARCHAR(4) UNSIGNED);"),
        ("xml", "bad.xml", "<a><b></a>"), ("xml", "bad.xml", "<!-- unclosed"), ("xml", "bad.xml", "<a><![CDATA[unclosed</a>"),
        ("xml", "bad.xml", "<?xml?><a/>"), ("xml", "bad.xml", "<a/><?xml version=\"1.0\"?>"),
        ("xml", "bad.xml", "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"maybe\"?><a/>"), ("xml", "bad.xml", "<a attr=\"&unknown;\"/>"),
        ("proto", "bad.proto", "message A {{ string x = 1; string x = 2; }}"), ("proto", "bad.proto", "message A {{ string x = 1;"),
        ("proto", "bad.proto", "syntax = \"proto4\"; message A {{ string x = 1; }}"), ("proto", "bad.proto", "message A {{ string x = 19000; }}"),
        ("proto", "bad.proto", "message A {{ reserved 1 to 5; string x = 1; }}"), ("proto", "bad.proto", "message A {{ string Child = 1; enum Child {{ ZERO = 0; }} }}")
    ]
    for (format, filename, input) in malformed {
        path := dir.join(filename); fs.write(&path, input).unwrap()
        output := Command.new(common.jet_exe()).args(["inspect", "bind", format]).arg(&path).args(["--type", "Bad"]).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
        stderr := String.from_utf8_lossy(&output.stderr)
        assert_eq(output.status.code(), Val(1), "{format} unexpectedly succeeded: {stderr}")
        assert(stderr.contains("Error [E3208]:"), "{format} missing E3208: {stderr}")
        assert(stderr.contains("Why:") && stderr.contains("Fix:"), "{format}: {stderr}")
    }
    _ :: fs.remove_dir_all(dir)
}
