// Rust: tests/bind.rs:827
#Test("public_c_bind_writes_parseable_hashed_cache_and_regenerates_idempotently") {
    dir := scratch("c-cli"); header := dir.join("hostile.h")
    source := "int match(int match); int foo_bar(int value); int foo__bar(int value);\n"
    fs.write(&header, source).unwrap(); output := dir.join("generated.jet")
    args := ["inspect", "bind", header.to_str().unwrap(), "--pkg", "hostile-lib", "-o", output.to_str().unwrap()]
    first := Command.new(common.jet_exe()).args(args).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
    assert_success(&first); before := fs.read_to_string(&output).unwrap(); assert_generated_source_parses(&before)
    hash := fs.read_to_string(output.with_extension("hash")).unwrap(); assert_eq(hash, CBind.compute_bind_hash(source, ""))
    second := Command.new(common.jet_exe()).args(args).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
    assert_success(&second); assert_eq(before, fs.read_to_string(&output).unwrap())
    _ :: fs.remove_dir_all(dir)
}
