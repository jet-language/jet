#Test("public_cli_covers_each_data_format_parse_hash_and_idempotence") {
    dir := scratch("all-formats")
    cases := [
        ("json", "json_repo.json", "{{\"name\":\"jet\",\"count\":9007199254740993,\"scale\":1e9999}}", "Repo", "json_repo.jet"),
        ("csv", "csv_people.csv", "name,age\nAda,36\nLin,37\n", "Person", "csv_people.jet"),
        ("sql", "sql_schema.sql", "CREATE TABLE users (id INTEGER PRIMARY KEY, name VARCHAR(32) NOT NULL, created TIMESTAMP(0));", "Users", "sql_schema.jet"),
        ("xml", "xml_catalog.xml", "<?xml version=\"1.0\" encoding=\"UTF-8\"?><catalog><book id=\"1\"/></catalog>", "Catalog", "xml_catalog.jet"),
        ("proto", "proto_repo.proto", "syntax = \"proto3\"; message Repo {{ string name = 1; }}", "Repo", "proto_repo.jet")
    ]
    for (format, filename, input, root, output_filename) in cases {
        input_path := dir.join(filename); fs.write(&input_path, input).unwrap(); input_text := input_path.to_str().unwrap()
        output_path := dir.join("bindings").join(output_filename); output_text := output_path.to_str().unwrap()
        args := ["inspect", "bind", format, input_text, "--type", root, "-o"]
        first := Command.new(common.jet_exe()).args(args).arg(output_text).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
        assert_success(&first); before := fs.read_to_string(&output_path).unwrap()
        assert(before.contains("#Codable")); assert(before.contains("sha256: {sha256_hex(input.as_bytes())}")); assert_generated_source_parses(&before)
        second := Command.new(common.jet_exe()).args(args).arg(output_text).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
        assert_success(&second); assert_eq(before, fs.read_to_string(&output_path).unwrap())
    }
    malformed := [("json", "bad.json", "{{"), ("csv", "bad.csv", "a,a\n1,2\n"), ("sql", "bad.sql", "CREATE TABLE x (id UNKNOWN);"), ("xml", "bad.xml", "<a attr=\"&bad;\"/>"), ("proto", "bad.proto", "message A {{ string x = 19000; }}")]
    for (format, filename, input) in malformed {
        path := dir.join(filename); fs.write(&path, input).unwrap()
        output := Command.new(common.jet_exe()).args(["inspect", "bind", format, path.to_str().unwrap(), "--type", "Bad"]).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
        assert_eq(output.status.code(), Val(1)); stderr := String.from_utf8_lossy(&output.stderr)
        assert(stderr.contains("Error [E3208]:"), "{format} missing E3208: {stderr}")
        assert(stderr.contains("Why:") && stderr.contains("Fix:"), "{format}: {stderr}")
    }
    _ :: fs.remove_dir_all(dir)
}
// Rust: tests/bind.rs:1292
#Test("data_bind_cli_writes_visible_output_and_regeneration_diff") {
    dir := scratch("cli"); input := dir.join("records.json")
    fs.write(&input, "{{\"name\":\"first\",\"count\":1}}").unwrap(); input_text := input.to_str().unwrap()
    first := Command.new(common.jet_exe()).args(["inspect", "bind", "json", input_text, "--type", "Record"]).current_dir(&dir).output().unwrap()
    assert_success(&first); default_output := dir.join("bindings/records.jet"); assert(default_output.is_file())
    before := fs.read_to_string(&default_output).unwrap()
    assert(before.contains("#Codable")); assert(before.contains("struct Record")); assert(before.contains(input_text))
    fs.write(&input, "{{\"name\":\"second\",\"count\":2,\"active\":true}}").unwrap()
    stale := fs.read_to_string(&default_output).unwrap(); assert_eq(before, stale)
    regenerated := Command.new(common.jet_exe()).args(["inspect", "bind", "json", input_text, "--type", "Record"]).current_dir(&dir).output().unwrap()
    assert_success(&regenerated); regenerated_output := fs.read_to_string(&default_output).unwrap()
    assert_ne(before, regenerated_output); assert(regenerated_output.contains("active: Bool"))
    explicit := dir.join("generated/record.jet"); explicit_text := explicit.to_str().unwrap()
    second := Command.new(common.jet_exe()).args(["inspect", "bind", "json", input_text, "--type", "Record", "-o", explicit_text]).current_dir(&dir).output().unwrap()
    assert_success(&second); after := fs.read_to_string(&explicit).unwrap()
    assert_ne(before, after); assert(after.contains("active: Bool")); assert(after.contains(explicit_text)); assert(OSPath.new(explicit_text).is_file())
    _ :: fs.remove_dir_all(dir)
}
