    dir := scratch("data-bind-collision")
    fs.write(dir.join("a b.json"), "{{\"first\":true}}").unwrap(); fs.write(dir.join("a_b.json"), "{{\"second\":true}}").unwrap()
    first := Command.new(common.jet_exe()).args(["inspect", "bind", "json", "a b.json", "--type", "First"]).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
    assert_success(&first); output_path := dir.join("bindings/a_b.jet"); before := fs.read_to_string(&output_path).unwrap()
    second := Command.new(common.jet_exe()).args(["inspect", "bind", "json", "a_b.json", "--type", "Second"]).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
    stderr := String.from_utf8_lossy(&second.stderr); assert_eq(second.status.code(), Val(1))
    assert(stderr.contains("Error [E2104]:"), "filename collision lost E2104: {stderr}")
    assert(!stderr.contains("E3208"), "filename collision was mislabeled as a schema error: {stderr}")
    assert_eq(before, fs.read_to_string(&output_path).unwrap(), "collision overwrote the first binding")
    _ :: fs.remove_dir_all(dir)
}
