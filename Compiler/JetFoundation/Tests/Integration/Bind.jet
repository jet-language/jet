// Rust: tests/bind.rs:1144
#Test("data_bind_provenance_is_hashed_and_stable") {
    input := "{{\"name\":\"jet\",\"count\":2}}"
    first := generated("json", "fixtures/stable.json", input, Val("Stable"), "jet inspect bind json fixtures/stable.json --type Stable")
    second := generated("json", "fixtures/stable.json", input, Val("Stable"), "jet inspect bind json fixtures/stable.json --type Stable")
    assert_eq(first, second); hash := sha256_hex(input.as_bytes())
    assert(first.contains("input: fixtures/stable.json")); assert(first.contains("sha256: {hash}"))
    assert(first.contains("generated by: jet inspect bind json fixtures/stable.json --type Stable"))
    assert(first.contains("format: json")); assert(first.contains("inference: JSON object fields become #Codable fields"))
    changed := generated("json", "fixtures/stable.json", "{{\"name\":\"jet\",\"count\":3}}", Val("Stable"), "jet inspect bind json fixtures/stable.json --type Stable")
    assert_ne(first, changed)
}
