use common
use std.fs
use std.env
use std.process.[Command, Output]
use jet.[Lexer, Parser, Syntax, CBind]
use jet_foundation.SHA256.sha256_hex

// GATE #4494: all commands and filesystem journeys below use real native providers.
// Rust: tests/bind.rs:7
fn scratch(name: &String) -> OSPath {
    path := common.unique_tmp("jet-bind-{name}")
    fs.create_dir_all(&path).unwrap()
    path
}
// Rust: tests/bind.rs:13
fn generated(format: &String, path: &String, input: &String, root: String?, command: &String) -> String {
    dir := scratch("generated-{format}")
    input_path := dir.join(path)
    if input_path.parent().filter(fn(path) { !path.as_os_str().is_empty() }) == Val(parent) { fs.create_dir_all(parent).unwrap() }
    fs.write(&input_path, input).unwrap()
    source := run_public_data_bind(&dir, format, path, root, command)
    _ :: fs.remove_dir_all(dir)
    source
}
// Rust: tests/bind.rs:28
fn escape_provenance(value: &String) -> String {
    value.chars().flat_map(fn(ch) {
        ch == {
            '\\' -> "\\\\".chars().collect()
            '\n' -> "\\n".chars().collect()
            '\r' -> "\\r".chars().collect()
            '\t' -> "\\t".chars().collect()
            ch -> {
                if ch.is_control() || ch == '\u{2028}' || ch == '\u{2029}' { "\\u{ch as U32:04x}".chars().collect() }
                else { [ch] }
            }
        }
    }).collect()
}
// Rust: tests/bind.rs:44
fn run_public_data_bind(dir: &OSPath, format: &String, input_path: &String, root: String?, command: &String) -> String {
    args := ["inspect", "bind", format.to_string(), input_path.to_string()]
    if root == Val(root) { args.extend(["--type", root.to_string()]) }
    output := Command.new(common.jet_exe()).args(&args).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    assert_success(&output)
    stdout := String.from_utf8_lossy(&output.stdout)
    output_path := stdout.lines().find_map(fn(line) { line.split_once(" → ").map(fn(pair) { pair.1.trim() }) })
        .unwrap_or_else(fn() { panic("public `jet inspect bind` did not report an output path:\n{stdout}") })
    source := fs.read_to_string(dir.join(output_path)).unwrap()
    expected_provenance := "// generated by: {escape_provenance(command)}"
    assert(source.contains(&expected_provenance), "public `jet inspect bind` changed provenance:\n{source}")
    source
}
// Rust: tests/bind.rs:83
fn assert_success(output: &Output) -> Unit {
    assert(output.status.success(), "status={output.status.code():?}\nstderr={String.from_utf8_lossy(&output.stderr)}")
}
// Rust: tests/bind.rs:95
// Real generated projects: typed reads reject parser-only or dynamic fallback implementations.
fn assert_generated_project(name: &String, format: &String, input_path: &String, input: &String, root: &String,
    command: &String, program: &String, expected_stdout: &String, source_markers: &[String]) -> Unit {
    dir := scratch("project-{name}")
    input_file := dir.join(input_path)
    if input_file.parent().filter(fn(path) { !path.as_os_str().is_empty() }) == Val(parent) { fs.create_dir_all(parent).unwrap() }
    fs.write(&input_file, input).unwrap()
    generated := run_public_data_bind(&dir, format, input_path, Val(root), command)
    for marker in source_markers { assert(generated.contains(marker), "{format} generated source lost required schema marker {marker:?}:\n{generated}") }
    assert_generated_source_parses(&generated)
    allowed_dynamic_fields := source_markers.iter().flat_map(fn(marker) { marker.lines().map(fn(line) { line.trim() }) })
        .filter(fn(marker) { marker.contains("DataTree") }).collect()
    dynamic_fields := generated.lines().map(fn(line) { line.trim() })
        .filter(fn(line) { !line.starts_with("//") && line.contains("DataTree") }).collect()
    assert_eq(dynamic_fields, allowed_dynamic_fields, "{format} generated source changed its explicitly allowed dynamic fields:\n{generated}")
    main_path := dir.join("main.jet")
    project_source := "{generated}\n{program}"
    fs.write(&main_path, &project_source).unwrap()
    shown := main_path.to_string_lossy().into_owned()
    compiled := jet.compile_with_path(&project_source, &shown).unwrap_or_else(fn(diagnostics) {
        panic("semantic analysis rejected generated {format} project:\n{jet.render_diagnostics(&shown, &project_source, &diagnostics)}")
    })
    // GATE #4483: retired Rust/JIT representation check becomes canonical typed native output.
    assert(compiled.has_type(Syntax.generated_name(root)), "codegen omitted generated {root} instead of using a fallback project")
    // Rust's AOT/default/interpreter behavior is preserved across the owner-selected O0/O1/O2/Web providers.
    for tier in ["O0", "O1", "O2", "Web"] {
        run := Command.new(common.jet_exe()).args(["run", "--trace-tiers", "--tier", tier, "main.jet"])
            .current_dir(&dir).env("JET_STORE_DIR", dir.join("run-cache-{tier}")).env("NO_COLOR", "1").output().unwrap()
        assert_success(&run)
        assert_eq(String.from_utf8_lossy(&run.stdout), expected_stdout, "{tier} output did not use generated {format} fields")
        trace := String.from_utf8_lossy(&run.stderr)
        assert(trace.lines().any(fn(line) { line.starts_with("run") && line.contains(tier) }), "{tier} did not execute generated {format} project:\n{trace}")
        assert(!trace.contains("deopt"), "{tier} deoptimized generated {format} project:\n{trace}")
        assert(!trace.contains("fallback"), "{tier} used a fallback for generated {format} project:\n{trace}")
    }
    _ :: fs.remove_dir_all(dir)
}
// Rust: tests/bind.rs:246
fn assert_generated_source_parses(source: &String) -> Unit {
    (tokens, diagnostics) := Lexer.lex_generated(source)
    assert(diagnostics.is_empty(), "generated source lexed with diagnostics: {diagnostics:#?}")
    assert(Parser.parse(&tokens).is_ok(), "generated source did not parse:\n{source}")
}
// Rust: tests/bind.rs:258
fn check_cli_snapshot(name: &String, actual: &String) -> Unit {
    path := common.repo_root().join("tests/cli").join(name)
    if env.var("UPDATE_EXPECT").is_ok() { fs.write(&path, actual).unwrap(); return }
    expected := fs.read_to_string(&path).unwrap_or_else(fn(_) { panic("missing snapshot {path.display()}; run UPDATE_EXPECT=1 with the bind suite") })
    assert_eq(actual, expected, "snapshot mismatch for {name}")
}
// Rust: tests/bind.rs:275
fn scrub_cli_path(output: &String, file: &OSPath) -> String { output.replace(&file.display().to_string(), "BAD.jet") }

