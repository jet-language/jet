// Rust: tests/bind.rs:550
#Test("xml_bind_resolves_namespaces_omits_declarations_and_keeps_collisions") {
    input := "<root xmlns=\"urn:root\" xmlns:a=\"urn:one\" xmlns:b=\"urn_one\" a:id=\"left\" b:id=\"right\" id=\"plain\" xml:lang=\"en\"><a:item>one</a:item><b:item>two</b:item><a:record><value>left</value></a:record><b:record><value>right</value></b:record><nested xmlns=\"urn:nested\"><leaf>three</leaf></nested></root>"
    command := "jet inspect bind xml namespaced.xml --type Root"
    first := generated("xml", "namespaced.xml", input, Val("Root"), command)
    second := generated("xml", "namespaced.xml", input, Val("Root"), command)
    assert_eq(first, second, "XML namespace naming must be deterministic")
    assert(first.contains("generated by: jet inspect bind xml namespaced.xml --type Root"))
    assert(first.contains("input: namespaced.xml")); assert(first.contains("sha256: {sha256_hex(input.as_bytes())}"))
    assert(!first.contains("xmlns"), "namespace declarations are not wire fields")
    field_marker := fn(wire: &String, name: &String, ty: &String) -> String {
        escaped := "{wire:?}".replace('{', "{{{{").replace('}', "}}}}")
        "#Rename({escaped}) {name}: {ty}"
    }
    id_base := Syntax.sanitize_generated_name("{{urn:one}}id", Syntax.NameCase.Snake, "field")
    assert_eq(id_base, Syntax.sanitize_generated_name("{{urn_one}}id", Syntax.NameCase.Snake, "field"))
    assert(first.contains(&field_marker("@id", "id", "String")))
    assert(first.contains(&field_marker("@{{urn:one}}id", &id_base, "String")))
    assert(first.contains(&field_marker("@{{urn_one}}id", "{id_base}_2", "String")))
    assert(first.contains(&field_marker("@{{http://www.w3.org/XML/1998/namespace}}lang", &Syntax.sanitize_generated_name("@{{http://www.w3.org/XML/1998/namespace}}lang", Syntax.NameCase.Snake, "field"), "String")))
    item_base := Syntax.sanitize_generated_name("{{urn:one}}item", Syntax.NameCase.Snake, "field")
    assert_eq(item_base, Syntax.sanitize_generated_name("{{urn_one}}item", Syntax.NameCase.Snake, "field"))
    assert(first.contains(&field_marker("{{urn:one}}item", &item_base, "String")))
    assert(first.contains(&field_marker("{{urn_one}}item", "{item_base}_2", "String")))
    record_base := Syntax.sanitize_generated_name("Root{Syntax.sanitize_generated_name("{{urn:one}}record", Syntax.NameCase.Pascal, "Schema")}", Syntax.NameCase.Pascal, "Schema")
    assert_eq(record_base, Syntax.sanitize_generated_name("Root{Syntax.sanitize_generated_name("{{urn_one}}record", Syntax.NameCase.Pascal, "Schema")}", Syntax.NameCase.Pascal, "Schema"))
    record_field := Syntax.sanitize_generated_name("{{urn:one}}record", Syntax.NameCase.Snake, "field")
    assert(first.contains(&field_marker("{{urn:one}}record", &record_field, &record_base)))
    assert(first.contains(&field_marker("{{urn_one}}record", "{record_field}_2", "{record_base}_2")))
    assert(first.contains("struct {record_base} {{")); assert(first.contains("struct {record_base}_2 {{"))
    nested_leaf := Syntax.sanitize_generated_name("{{urn:nested}}leaf", Syntax.NameCase.Snake, "field")
    assert(first.contains(&field_marker("{{urn:nested}}leaf", &nested_leaf, "String")))
    assert_generated_source_parses(&first)
}
