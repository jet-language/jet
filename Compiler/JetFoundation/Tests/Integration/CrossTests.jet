// Rust: tests/cross.rs:26
#Test("e3301_fs_read_in_freestanding") {
    src :: "use core.files as fs\n\nfn run() {\n    _ :: fs.read(\"config.txt\")\n}\n"
    out :: check_freestanding_src(src, "fs_read")
    assert(out.contains("E3301"), "expected E3301 for fs.read in freestanding mode; got:\n{out}")
    assert(out.contains("no-OS"), "expected 'no-OS' in error; got:\n{out}")
}
