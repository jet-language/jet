    for needle in ["empty_mean: Empty mean:", "empty_quantile: Empty quantile:", "empty_variance: Empty variance:", "missing_count: 3", "dup_join_count: 5", "pivot: row=a|b col=c sum=12.0", "tie_order: 3.0,1.0,2.0", "nan_mean: NonFinite", "inf_sum: NonFinite", "signed_zero_sum: 0.0", "signed_zero_mean: 0.0", "pop_variance: 0.6666666666666666", "one_variance: 0.0", "bad_quantile: InvalidArgument quantile:", "bad_window: InvalidArgument rolling_mean:", "hostile_svg_escaped: true", "large_limit: Limit group_mean:", "cancellation_sum: 1.0", "cancellation_mean: 0.3333333333333333"] {
        assert(out.contains(needle), "hostile golden missing required class `{needle}`:\n{out}")
    }
}
