// Rust: tests/retirement_ratchet.rs:220
// Keep hidden .jet source; exclude external/build state, Tower and gauntlet data.
pub fn failure_surface_skip_dir(path: OSPath) -> Bool {
    path.starts_with("Tools/gauntlet/results") || path.components().any(|component| -> {
        if component is .Normal(name) {
            text :: name.to_string_lossy()
            text == ".git" || text == ".claude" || text == ".agent-worktrees" || text == ".opencode" || text == ".tower" || text == "node_modules" || text == "build" || text.starts_with("target")
        } else { false }
    })
}

// Rust: tests/retirement_ratchet.rs:238
pub fn walk_failure_surface(root: OSPath, out: &[OSPath]) -> {
    entries :: fs.read_dir(root).ok() ?? { return }
    for entry in entries.flatten() {
        path :: entry.path()
        file_type :: entry.file_type().ok() ?? { continue }
        if file_type.is_symlink() { continue }
        if path.is_dir() {
            relative :: path.strip_prefix(env("CARGO_MANIFEST_DIR")).unwrap_or(&path)
            if !failure_surface_skip_dir(relative) { walk_failure_surface(&path, out) }
        } else if path.extension().is_some_and(|extension| -> FAILURE_SURFACE_EXTENSIONS.iter().any(|allowed| -> extension == allowed)) { out.push(path) }
    }
}

// Rust: tests/retirement_ratchet.rs:267
pub fn failure_surface_files() -> [OSPath] {
    root :: OSPath.new(env("CARGO_MANIFEST_DIR"))
    out := []
    for relative in FAILURE_SURFACE_ROOTS { walk_failure_surface(root.join(relative), &out) }
    if fs.read_dir(root).ok() is Some(entries) {
        out.extend(entries.flatten().filter_map(|entry| -> {
            path :: entry.path()
            if path.is_file() && path.extension().is_some_and(|extension| -> extension == "jet") { Some(path) } else { None }
        }))
    }
    readme :: root.join("README.md")
    if readme.is_file() { out.push(readme) }
    out
}

