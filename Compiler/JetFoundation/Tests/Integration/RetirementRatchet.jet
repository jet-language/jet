// Rust: tests/retirement_ratchet.rs:786
pub fn is_authority_diagnostic_producer(path: String, line: String) -> Bool {
    if path == "crates/jet-codegen/src/Prelude/Markers.jet" {
        trimmed := line.trim_start() // #4303
        return trimmed.starts_with("marker ") && (line.contains("marker " + "Abil" + "ities") || line.contains("marker " + "Cap" + "s"))
    }
    if path == "crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs" {
        trimmed := line.trim_start() // #4303
        return trimmed.starts_with("\"" + "Abil") || trimmed.starts_with("\"" + "Cap")
    }
    if path == "crates/jet-codegen/src/Prelude/Diagnostics.jet" { return line.starts_with("diagnostic\tE0077\t") && line.contains("#" + "Grant") }
    if path == "crates/jet-parser/src/Parser/Statements/control.rs" { return line.contains("the `#" + "Grant` scope marker is retired") }
    if path == "crates/jet-foundation/src/Syntax/retirements.rs" { return line.contains("retired: \"#" + "Grant\"") }
    if path == "crates/jet-parser/src/Parser/mod.rs" { return line.contains("#" + "Grant") }
    false
}
// Rust: tests/retirement_ratchet.rs:811
pub fn is_unrelated_authority_word(path: String, line: String) -> Bool {
    if path == "crates/jet-pkg-model/src/CompilerExtension.rs" || path == "crates/jet-driver/src/CompilerExtensionHook.rs" || path == "crates/jetpack-bin/tests/compiler_extension_e2e.rs" { return true }
    if path.starts_with("Docs/spec/reference/surfaces/") { return true }
    match path {
        "crates/jet-canvas/src/js/inspector-connections.js" -> line.contains("Capabil" + "ity mismatch")
        "crates/jet-devserver/src/WebHost.rs" -> line.contains("Abil" + "ity check")
        "crates/jet-driver/src/Driver/mod.rs" -> line.contains("Abil" + "ity grants")
        "crates/jet-driver/src/Foreign.rs" -> line.contains("Capabil" + "ity report")
        "crates/jet-pkg-model/src/FFI.rs" -> line.contains("Capabil" + "ity-bearing")
        "crates/jet-repl/src/Notebook/trust.rs" -> line.contains("Abil" + "ity widget")
        "crates/jet-sema/src/Sema/mod.rs" -> line.contains("Abil" + "ity") && line.contains("derive rows")
        "crates/jetpack/src/Recipe.rs" -> line.contains("Capabil" + "ity-limited")
        "Examples/features/io/app_config.jet" -> { trimmed := line.trim_start(); trimmed.starts_with("// " + "Abil" + "ity") }
        "Examples/features/net/browser_cdp.jet" -> line.contains("Abil" + "ity-gated protocol")
        "Tools/canvas-test/scenario.mjs" -> line.contains("Capabil" + "ity mismatch")
        "Docs/spec/spec.md" -> line.contains("Capabil" + "ity parameters")
        _ -> false
    }
}
// Rust: tests/retirement_ratchet.rs:876
pub fn authority_retired_words_in_line(line: String) -> [String] {
    hits := []
    for word in RETIRED_AUTHORITY_WORDS { if contains_word(line, word) { hits.push(word) } }
    for marker in RETIRED_AUTHORITY_MARKERS { if line.contains(marker) { hits.push(marker) } }
    for identifier in RETIRED_AUTHORITY_IDENTIFIERS { if line.contains(identifier) { hits.push(identifier) } }
    hits
}

// Rust: tests/retirement_ratchet.rs:915
// Identity wrappers count only at line/quote starts, not user type fields.
pub fn writes_retired_identity(text: String) -> Bool {
    bytes :: text.as_bytes()
    for (index, _) in text.match_indices("payload:") {
        opens_here :: index == 0 || bytes[index - 1] == b'\n' || bytes[index - 1] == b'"' || (bytes[index - 1] == b'\\' && index >= 2 && bytes[index - 2] == b'"')
        if !opens_here { continue }
        rest := text[index + "payload:".len()..].trim_start() // #4303
        if rest.starts_with('{') && rest.contains("name:") { return true }
    }
    false
}

// Rust: tests/retirement_ratchet.rs:933
pub fn ref_sides(text: String) -> [(String, String)] {
    bytes :: text.as_bytes()
    word :: |c: U8| -> c.is_ascii_alphanumeric() || c == b'_' || c == b'-'
    out := []
    for (at, _) in text.match_indices('@') {
        start := at
        while start > 0 && word(bytes[start - 1]) { start -= 1 }
        end := at + 1
        while end < bytes.len() && word(bytes[end]) { end += 1 }
        out.push((text[start..at].to_string(), text[at + 1..end].to_string()))
    }
    out
}

// Rust: tests/retirement_ratchet.rs:955
// A provider on both sides is canonical: perl@nixpkgs is not provider-first.
pub fn writes_provider_first(text: String) -> Bool {
    ref_sides(text).iter().any(|(left, right)| -> REF_PROVIDERS.contains(left.as_str()) && !REF_PROVIDERS.contains(right.as_str()))
}
// Rust: tests/retirement_ratchet.rs:961
pub fn writes_canonical_ref(text: String) -> Bool {
    ref_sides(text).iter().any(|(_, right)| -> REF_PROVIDERS.contains(right.as_str()))
}

// Rust: tests/retirement_ratchet.rs:971
pub fn lint_policy_value_is_code(line: String) -> Bool? {
    value := if line.find("lints") is Some(lints) {
        deny :: (line[lints..].find("deny") ?? { return None }) + lints
        open :: (line[deny..].find('[') ?? { return None }) + deny
        line[open + 1..]
    } else if line.find("#allow(") is Some(allow) {
        line[allow + "#allow(".len()..]
    } else { return None }
    value = value.trim_start() // #4303
    token := value.split(|character| -> character == ',' || character == ']' || character == ')' || character.is_whitespace()).next().unwrap_or("").trim_matches('"') // #4303
    if token.is_empty() { return None }
    chars := token.chars()
    first :: chars.next()
    code_shape :: (first == Some('E') || first == Some('L') || first == Some('W')) && chars.count() == 4 && token[1..].chars().all(|character| -> character.is_ascii_digit())
    Some(code_shape)
}
// Rust: tests/retirement_ratchet.rs:1001
pub fn lint_policy_values(text: String) -> (Bool, Bool) {
    retired := false
    canonical := false
    for line in text.lines() {
        match lint_policy_value_is_code(line) { Some(true) -> retired = true; Some(false) -> canonical = true; None -> {} }
    }
    (retired, canonical)
}

// Rust: tests/retirement_ratchet.rs:1014
pub fn writes_interpolation_selector(text: String, retired: Bool) -> Bool {
    (tokens, lex_diags) :: Lexer.lex(text)
    if !lex_diags.is_empty() { return false }
    // Rust: tests/retirement_ratchet.rs:1019
    fn scan(tokens: [Token], retired: Bool) -> Bool {
        for token in tokens {
            parts :: if token.kind is .Str(parts) { parts } else { continue }
            for part in parts {
                inner :: if part is .Interp(inner) { inner } else { continue }
                for pair in inner.windows(2) {
                    rail :: if retired { pair[0].kind is .Hash } else { pair[0].kind is .Colon }
                    selector :: match pair[1].kind { .Ident(name) -> Syntax.interpolation_selector(name).is_some(); _ -> false }
                    if rail && selector { return true }
                }
                if scan(inner, retired) { return true }
            }
        }
        false
    }
    scan(tokens, retired)
}

// Rust: tests/retirement_ratchet.rs:1056
// Registered facts count; compile-time name splices that are not facts do not.
pub fn has_retired_fact_mark(tokens: [Token]) -> Bool {
    for (index, token) in tokens.iter().enumerate() {
        if token.kind is .Ident(name) {
            if name.strip_prefix(Syntax.RETIRED_COMPTIME_MARK) is Some(rest) {
                member :: index > 0 && tokens[index - 1].kind is .Dot && Syntax.fact_read_kind("{Syntax.COMPTIME_MARK}{rest}").is_some()
                if member || Syntax.retired_fact_spelling(name).is_some() { return true }
            }
        }
        parts :: if token.kind is .Str(parts) { parts } else { continue }
        for part in parts { if part is .Interp(inner) { if has_retired_fact_mark(inner) { return true } } }
    }
    false
}
// Rust: tests/retirement_ratchet.rs:1086
// --[ belongs to the retired effect-arrow row, not the step-token row.
pub fn writes_step_token(tokens: [Token], plus: Bool) -> Bool {
    tokens.iter().enumerate().any(|(index, token)| -> {
        step :: if plus { token.kind is .PlusPlus }
            else { token.kind is .MinusMinus && !tokens.get(index + 1).is_some_and(|next| -> next.kind is .LBracket) }
        step || match token.kind {
            .Str(parts) -> parts.iter().any(|part| -> match part { .Interp(inner) -> writes_step_token(inner, plus); _ -> false })
            _ -> false
        }
    })
}
// Rust: tests/retirement_ratchet.rs:1106
pub fn writes_compound_step(tokens: [Token], plus: Bool) -> Bool {
    tokens.iter().any(|token| -> if plus { token.kind is .PlusEq } else { token.kind is .MinusEq })
}
// Rust: tests/retirement_ratchet.rs:1116
pub fn tally_collection_example(path_suffix: String, retired_form: String, canonical_form: String) -> (Int, Int) {
    content_files().into_iter().filter(|path| -> path.to_string_lossy().ends_with(path_suffix)).filter_map(|path| -> read(&path))
        .fold((0, 0), |(retired, canonical), text| -> (retired + Int.from(text.contains(retired_form)), canonical + Int.from(text.contains(canonical_form))))
}
// Rust: tests/retirement_ratchet.rs:1133
pub fn tally_print_family(retired_form: String, canonical_form: String) -> (Int, Int) {
    content_files().into_iter().filter(|path| -> path.extension().is_some_and(|ext| -> ext == "jet")).filter_map(|path| -> read(&path))
        .fold((0, 0), |(retired, canonical), text| -> (retired + Int.from(text.contains(retired_form)), canonical + Int.from(text.contains(canonical_form))))
}
// Rust: tests/retirement_ratchet.rs:1148
pub fn writes_effect_spelling(text: String, spelling: String) -> Bool {
    for original_line in text.lines() {
        line := original_line.trim() // #4303
        if line.strip_prefix("effect ").and_then(|tail| -> tail.split_whitespace().next()) is Some(name) {
            if name == spelling { return true }
        }
        for marker in [":[", "=[", "#(", "allow: [", "deny: ["] {
            rest := line
            while rest.find(marker) is Some(start) {
                values :: rest[start + marker.len()..]
                end :: values.find(']') ?? { break }
                if values[..end].split(',').map(|value| -> value.trim()).map(|value| -> value.strip_prefix('!').unwrap_or(value).trim()).any(|value| -> value == spelling) { return true }
                rest = values[end + 1..]
            }
        }
    }
    false
}

// Rust: tests/retirement_ratchet.rs:1180
pub fn tally(row: Retirement) -> (Int, Int) {
    match row.id {
        "entry-file" | "manifest-file" -> {
            files :: all_files()
            count :: |name: String| -> files.iter().filter(|p| -> file_name(p) == name).count()
            (count(row.retired), count(row.canonical))
        }
        "jetpack-file" -> {
            files :: all_files()
            retired :: files.iter().filter(|path| -> file_name(path) == JETPACK_TOML).count()
            canonical :: files.iter().filter(|path| -> file_name(path) == "package.jet" || file_name(path) == "env.jet").count()
            (retired, canonical)
        }
        "manifest-identity" -> {
            retired := 0
            canonical := 0
            for path in content_files() {
                text :: read(&path) ?? { continue }
                if writes_retired_identity(text) { retired += 1 }
                else if file_name(&path).ends_with(".jet") && text.lines().any(|line| -> line.starts_with("name:")) { canonical += 1 }
            }
            (retired, canonical)
        }
        "lint-policy-code" -> {
            retired := 0
            canonical := 0
            for path in content_files() {
                text :: read(&path) ?? { continue }
                (has_retired, has_canonical) :: lint_policy_values(text)
                if has_retired { retired += 1 } else if has_canonical { canonical += 1 }
            }
            (retired, canonical)
        }
        "auto-derive-policy" -> {
            retired := 0
            canonical := 0
            for path in content_files() {
                if path.extension().is_none_or(|ext| -> ext != "jet") { continue }
                text :: read(&path) ?? { continue }
                if text.contains("policy: {{ auto_derive") { retired += 1 }
                else if text.contains("policy: {{ lints: {{ deny: [auto_derive]") { canonical += 1 }
            }
            (retired, canonical)
        }
        "package-ref-order" -> {
            // Rust quotations prove E1317; only Jet package sources count.
            retired := 0
            canonical := 0
            for path in content_files() {
                if path.extension().is_none_or(|ext| -> ext != "jet") { continue }
                // E1317 teaching text is evidence, not a live package ref.
                if path.ends_with("crates/jet-codegen/src/Prelude/Diagnostics.jet") { continue }
                text :: read(&path) ?? { continue }
                if writes_provider_first(text) { retired += 1 } else if writes_canonical_ref(text) { canonical += 1 }
            }
            (retired, canonical)
        }
        "allow-impure" | "freestanding-flag" -> {
            retired := 0
            canonical := 0
            for path in content_files() {
                if path.ends_with("crates/jet-foundation/src/Syntax/retirements.rs") { continue }
                text :: read(&path) ?? { continue }
                if text.contains(row.retired) { retired += 1 } else if text.contains(row.canonical) { canonical += 1 }
            }
            (retired, canonical)
        }
        "scope-marker-grant" -> {
            retired := 0
            canonical := 0
            for path in content_files() {
                if path.ends_with("crates/jet-codegen/src/Prelude/Diagnostics.jet")
                    || path.ends_with("crates/jet-foundation/src/Syntax/retirements.rs")
                    || path.ends_with("crates/jet-parser/src/Parser/Statements/control.rs")
                    || path.ends_with("crates/jet-parser/src/Parser/mod.rs")
                    || path.ends_with("tests/retirement_ratchet.rs") { continue }
                text :: read(&path) ?? { continue }
                if text.contains(row.retired) { retired += 1 } else if text.contains(row.canonical) { canonical += 1 }
            }
            (retired, canonical)
        }
        "interpolation-selector-rail" -> {
            retired := 0
            canonical := 0
            for path in content_files() {
                if path.extension().is_none_or(|ext| -> ext != "jet") { continue }
                text :: read(&path) ?? { continue }
                if writes_interpolation_selector(text, true) { retired += 1 } else if writes_interpolation_selector(text, false) { canonical += 1 }
            }
            (retired, canonical)
        }
        "fact-mark" -> {
            retired := 0
            canonical := 0
            for path in content_files() {
                if path.extension().is_none_or(|ext| -> ext != "jet") { continue }
                text :: read(&path) ?? { continue }
                (tokens, lex_diags) :: Lexer.lex(text)
                if !lex_diags.is_empty() { continue }
                old :: has_retired_fact_mark(tokens)
                current :: tokens.iter().any(|token| -> match token.kind { .Ident(name) -> name.starts_with(Syntax.COMPTIME_MARK); _ -> false })
                if old { retired += 1 } else if current { canonical += 1 }
            }
            (retired, canonical)
        }
        "set-take" -> tally_collection_example("Examples/features/collections/set.jet", ".take(", ".pop(")
        "map-replace" -> tally_collection_example("Examples/features/collections/map_surface.jet", ".replace(", ".add(")
        "set-replace" -> tally_collection_example("Examples/features/collections/set.jet", ".replace(", ".add(")
        "core-io-println" -> tally_print_family("io.println", "io.print")
        "core-io-sprint" -> tally_print_family("io.sprint", "{{value}}")
        "core-io-repr" -> tally_print_family("io.repr", "{{value:Debug}}")
        "core-path-free-functions" -> {
            retired := 0
            canonical := 0
            for path in content_files() {
                if path.extension().is_none_or(|ext| -> ext != "jet") { continue }
                text :: read(&path) ?? { continue }
                if text.contains("use core.path") || text.contains("core.path.") { retired += 1 }
                else if text.contains("Path.from") || text.contains("Path.home") { canonical += 1 }
            }
            (retired, canonical)
        }
        id if id.starts_with("core-namespace-") -> {
            retired := 0
            canonical := 0
            for path in content_files() {
                if path.extension().is_none_or(|ext| -> ext != "jet") { continue }
                text :: read(&path) ?? { continue }
                if text.contains(row.retired) { retired += 1 } else if text.contains(row.canonical) { canonical += 1 }
            }
            (retired, canonical)
        }
        "target-plugin" -> {
            retired := 0
            canonical := 0
            for path in content_files() {
                if path.extension().is_none_or(|ext| -> ext != "jet") { continue }
                text :: read(&path) ?? { continue }
                (_, retired_targets) :: Package.rewrite_retired_targets(text)
                if retired_targets > 0 || text.contains("target: plugin") { retired += 1 }
                else if text.contains("target: sandbox") || Package.PackageFacts.parse(text, path.display().to_string()).is_ok_and(|facts| -> facts.packages.iter().any(|package| -> package.targets.iter().any(|target| -> target is .Plugin{..}))) { canonical += 1 }
            }
            (retired, canonical)
        }
        "core-container-queue" | "core-container-rank" | "core-container-tally" | "core-container-bits" | "core-container-bytes" -> {
            retired := 0
            canonical := 0
            for path in content_files() {
                text :: read(&path) ?? { continue }
                if contains_word(text, row.retired) { retired += 1 } else if contains_word(text, row.canonical) { canonical += 1 }
            }
            (retired, canonical)
        }
        "operator-plus-plus" | "operator-minus-minus" -> {
            plus :: row.id == "operator-plus-plus"
            retired := 0
            canonical := 0
            for path in content_files() {
                if !path.extension().is_some_and(|ext| -> ext == "jet") { continue }
                text :: read(&path) ?? { continue }
                (tokens, _) :: Lexer.lex(text)
                if writes_step_token(tokens, plus) { retired += 1 } else if writes_compound_step(tokens, plus) { canonical += 1 }
            }
            (retired, canonical)
        }
        "jet-time-now" | "jet-time-format" -> {
            files :: content_files()
            count :: |needle: String| -> files.iter().filter_map(|path| -> read(path)).filter(|text| -> text.contains(needle)).count()
            (count(row.retired), count(row.canonical))
        }
        id if id.starts_with("effect-flat-ffi-") -> {
            retired := 0
            canonical := 0
            for path in content_files() {
                if path.ends_with("tests/effect_roots.rs") { continue }
                text :: read(&path) ?? { continue }
                if writes_effect_spelling(text, row.retired) { retired += 1 } else if writes_effect_spelling(text, row.canonical) { canonical += 1 }
            }
            (retired, canonical)
        }
        "outcome-nested-ok-pattern" -> {
            retired := 0
            canonical := 0
            for path in content_files() {
                if !path.extension().is_some_and(|ext| -> ext == "jet") { continue }
                // E0392 names the form it refuses.
                if path.ends_with("crates/jet-codegen/src/Prelude/Diagnostics.jet") { continue }
                text :: read(&path) ?? { continue }
                if text.contains(".Ok(.Val(") || text.contains(".Ok(.None)") { retired += 1 }
                else if text.contains(".Val(") && text.contains(".None") && text.contains(".Err(") { canonical += 1 }
            }
            (retired, canonical)
        }
        "comptime-constant-mark" -> {
            retired := 0
            canonical := 0
            for path in content_files() {
                if !path.extension().is_some_and(|ext| -> ext == "jet") { continue }
                text :: read(&path) ?? { continue }
                (tokens, _) :: Lexer.lex(text)
                declares :: |marked: Bool| -> tokens.windows(2).any(|pair| -> {
                    match pair[0].kind {
                        .Ident(name) -> marked == name.starts_with('@') && name.trim_start_matches('@').chars().any(|character| -> character.is_uppercase()) && !name.trim_start_matches('@').chars().any(|character| -> character.is_lowercase()) && pair[1].kind is .ColonColon
                        _ -> false
                    }
                })
                if declares(true) { retired += 1 } else if declares(false) { canonical += 1 }
            }
            (retired, canonical)
        }
        "template-name-splice-mark" -> {
            retired := 0
            canonical := 0
            for path in content_files() {
                if !path.extension().is_some_and(|ext| -> ext == "jet") { continue }
                text :: read(&path) ?? { continue }
                (tokens, lex_diags) :: Lexer.lex(text)
                spliced :: tokens.windows(2).any(|pair| -> {
                    (pair[0].kind is .KwFn || pair[0].kind is .KwImpl) && match pair[1].kind { .Ident(name) -> name.starts_with(Syntax.COMPTIME_MARK); _ -> false }
                })
                if lex_diags.iter().any(|diag| -> diag.code == "E0388") { retired += 1 } else if spliced { canonical += 1 }
            }
            (retired, canonical)
        }
        other -> panic("no way to count row `{other}`; teach `tally` how to count it")
    }
}
