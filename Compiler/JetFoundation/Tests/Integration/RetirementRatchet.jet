// Rust: tests/retirement_ratchet.rs:304
pub struct FailureSourceFragment { first_line: Int, source: String }

// Rust: tests/retirement_ratchet.rs:309
pub fn failure_fence(line: String) -> (U8, Int, String)? {
    trimmed := line.trim_start() // #4303
    marker :: trimmed.as_bytes().first().copied() ?? { return None }
    if marker != b'`' && marker != b'~' { return None }
    length :: trimmed.bytes().take_while(|byte| -> byte == marker).count()
    if length >= 3 { Some((marker, length, trimmed[length..])) } else { None }
}

// Rust: tests/retirement_ratchet.rs:319
pub fn failure_inline_fragments(line: String) -> [String] {
    bytes :: line.as_bytes()
    fragments := []
    cursor := 0
    while cursor < bytes.len() {
        if bytes[cursor] != b'`' { cursor += 1; continue }
        length :: bytes[cursor..].iter().take_while(|byte| -> byte == b'`').count()
        content_start :: cursor + length
        close := content_start
        while close < bytes.len() {
            if bytes[close] != b'`' { close += 1; continue }
            close_length :: bytes[close..].iter().take_while(|byte| -> byte == b'`').count()
            if close_length == length {
                fragments.push(line[content_start..close].to_string())
                cursor = close + close_length
                break
            }
            close += close_length
        }
        if close >= bytes.len() { break }
    }
    fragments
}

// Rust: tests/retirement_ratchet.rs:357
pub fn failure_looks_like_jet(source: String) -> Bool {
    ["fn ", "alias ", "struct ", "pub fn ", "->", "-[", "fallible", "failure", "optional"].iter().any(|marker| -> source.contains(marker))
}

// Rust: tests/retirement_ratchet.rs:373
pub fn failure_embedded_fragments(text: String) -> [FailureSourceFragment] {
    bytes :: text.as_bytes()
    fragments := []
    cursor := 0
    // Increasing offsets permit incremental line counting without prefix rescans.
    counted_to := 0
    line := 1
    line_at := |offset| -> {
        line += bytes[counted_to..offset].iter().filter(|byte| -> byte == b'\n').count()
        counted_to = offset
        line
    }
    while cursor < bytes.len() {
        if bytes[cursor] == b'r' {
            quote := cursor + 1
            while quote < bytes.len() && bytes[quote] == b'#' { quote += 1 }
            if quote < bytes.len() && bytes[quote] == b'"' {
                hashes :: text[cursor + 1..quote]
                close :: "\"{hashes}"
                content_start :: quote + 1
                close_offset :: text[content_start..].find(&close) ?? { cursor += 1; continue }
                content_end :: content_start + close_offset
                source :: text[content_start..content_end]
                if failure_looks_like_jet(source) { fragments.push(FailureSourceFragment{first_line: line_at(cursor), source: source.to_string()}) }
                cursor = content_end + close.len()
                continue
            }
        }
        if bytes[cursor] == b'"' {
            content_start :: cursor + 1
            end := content_start
            while end < bytes.len() {
                if bytes[end] == b'\\' { end = end.saturating_add(2) }
                else if bytes[end] == b'"' { break }
                else { end += 1 }
            }
            if end < bytes.len() {
                source :: text[content_start..end]
                if failure_looks_like_jet(source) { fragments.push(FailureSourceFragment{first_line: line_at(cursor), source: source.to_string()}) }
                cursor = end + 1
                continue
            }
        }
        cursor += 1
    }
    fragments
}

// Rust: tests/retirement_ratchet.rs:444
pub fn failure_source_fragments(path: OSPath, text: String) -> [FailureSourceFragment] {
    if path.extension().is_some_and(|extension| -> extension == "jet") { return [FailureSourceFragment{first_line: 1, source: text.to_string()}] }
    if relative_path(path).starts_with("Tools/editors/tree-sitter/test/corpus/") {
        source :: text.split_once("\n---").map_or(text, |(source, _)| -> source)
        return [FailureSourceFragment{first_line: 1, source: source.to_string()}]
    }
    markdown :: path.extension().is_some_and(|extension| -> extension == "md")
    if !markdown { return failure_embedded_fragments(text) }
    fragments := []
    fence: (U8, Int, Int, Bool, String)? = None
    for (index, line) in text.lines().enumerate() {
        if fence.as_mut() is Some((open_marker, open_length, _, active, source)) {
            if failure_fence(line).is_some_and(|(marker, length, rest)| -> marker == open_marker && length >= open_length && rest.trim().is_empty()) {
                (_, _, first_line, was_active, completed) :: fence.take().expect("fence exists")
                if was_active { fragments.push(FailureSourceFragment{first_line: first_line, source: completed}) }
            } else if active { source.push_str(line); source.push('\n') }
        } else if failure_fence(line) is Some((marker, length, info)) {
            language :: info.split_whitespace().next().unwrap_or("")
            fence = Some((marker, length, index + 2, language == "jet" || language == "Jet" || language == "jetlang", String.new()))
        } else {
            for source in failure_inline_fragments(line) { fragments.push(FailureSourceFragment{first_line: index + 1, source: source}) }
        }
    }
    if fence is Some((_, _, first_line, active, source)) {
        if active { fragments.push(FailureSourceFragment{first_line: first_line, source: source}) }
    }
    fragments
}

// Rust: tests/retirement_ratchet.rs:506
pub fn collect_failure_tokens(tokens: [Token], out: &[&Token]) -> {
    for token in tokens {
        match token.kind {
            .LineComment(_) | .BlockComment(_) -> {}
            .Str(parts) -> {
                out.push(&token)
                for part in parts { if part is .Interp(inner) { collect_failure_tokens(inner, out) } }
            }
            .Eof -> {}
            _ -> out.push(&token)
        }
    }
}

// Rust: tests/retirement_ratchet.rs:527
pub fn failure_is_type_atom(token: Token) -> Bool {
    match token.kind { .Ident(_) | .RParen | .RBracket | .Gt | .Shr -> true; _ -> false }
}
// Rust: tests/retirement_ratchet.rs:538
pub fn failure_is_contract_position(token: Token) -> Bool {
    failure_is_type_atom(token) || match token.kind { .Colon | .ColonColon | .RParen -> true; _ -> false }
}
// Rust: tests/retirement_ratchet.rs:548
pub fn failure_is_expression_end(token: Token) -> Bool {
    match token.kind {
        .Ident(_) | .Str(_) | .Int(..) | .Float(..) | .UnitNumber{..} | .Char(_)
        | .KwTrue | .KwFalse | .KwNull | .KwIt | .KwSelf | .RParen | .RBracket | .RBrace | .PlusPlus | .MinusMinus -> true
        _ -> false
    }
}
// Rust: tests/retirement_ratchet.rs:570
pub fn failure_is_type_name(token: Token) -> Bool {
    match token.kind { .Ident(name) -> name.chars().next().is_some_and(|character| -> character.is_ascii_uppercase()); _ -> false }
}
// Rust: tests/retirement_ratchet.rs:578
pub fn failure_is_adjacent(left: Token, right: Token) -> Bool { left.span.end == right.span.start }

// Rust: tests/retirement_ratchet.rs:582
pub fn failure_is_result_arm_separator(tokens: [&Token], index: Int) -> Bool {
    previous :: index.checked_sub(1).and_then(|index| -> tokens.get(index)) ?? { return false }
    next :: tokens.get(index + 1) ?? { return false }
    after_next :: tokens.get(index + 2) ?? { return false }
    match (previous.kind, next.kind, after_next.kind) {
        (.Ident(previous), .Ident(next), .UnifiedArrow) -> previous.starts_with(|character| -> character.is_ascii_lowercase() || character == '_') && next.starts_with(|character| -> character.is_ascii_lowercase() || character == '_')
        _ -> false
    }
}
// Rust: tests/retirement_ratchet.rs:606
pub fn failure_is_infix_contract(tokens: [&Token], index: Int) -> Bool {
    previous :: index.checked_sub(1).and_then(|index| -> tokens.get(index)) ?? { return false }
    next :: tokens.get(index + 1) ?? { return false }
    if !failure_is_type_atom(previous) || !(failure_is_type_atom(next) || next.kind is .LParen) { return false }
    if failure_is_result_arm_separator(tokens, index) { return false }
    failure_is_type_name(previous) || failure_is_type_name(next)
}
// Rust: tests/retirement_ratchet.rs:625
pub fn failure_is_optional_prefix(tokens: [&Token], index: Int) -> Bool {
    question :: tokens.get(index) ?? { return false }
    next :: tokens.get(index + 1) ?? { return false }
    type_head :: failure_is_type_name(next) || match next.kind { .LParen | .LBracket | .Star | .KwFn -> true; _ -> false }
    type_head && failure_is_adjacent(question, next)
}

// Rust: tests/retirement_ratchet.rs:643
pub fn failure_syntax_hits(source: String) -> [(Int, String)] {
    (lexed, _) :: Lexer.lex(source)
    tokens := []
    collect_failure_tokens(lexed, &tokens)
    tokens.sort_by_key(|token| -> token.span.start)
    line :: |offset| -> source[..offset].bytes().filter(|byte| -> byte == b'\n').count() + 1
    hits := []
    for (index, token) in tokens.iter().enumerate() {
        match token.kind {
            .Bang -> {
                marker_negation :: index >= 2 && tokens[index - 2].kind is .Hash
                canonical_prefix :: tokens.get(index + 1).is_some_and(|next| -> failure_is_adjacent(token, next) && match next.kind { .Ident(_) | .LParen | .LBracket | .Star | .KwFn -> true; _ -> false })
                if marker_negation || canonical_prefix || failure_is_result_arm_separator(tokens, index) { continue }
                if index.checked_sub(1).and_then(|index| -> tokens.get(index)).is_some_and(|token| -> failure_is_contract_position(token)) { hits.push((line(token.span.start), "retired failure contract")) }
            }
            .Question -> {
                contextual :: tokens.get(index + 1).is_some_and(|token| -> token.kind is .LParen)
                result_handler :: tokens.get(index + 1).and_then(|next| -> tokens.get(index + 2).map(|after| -> (next, after))).is_some_and(|(next, after)| -> match (next.kind, after.kind) {
                    (.Ident(name), .UnifiedArrow) -> name.starts_with(|character| -> character.is_ascii_lowercase() || character == '_')
                    _ -> false
                })
                expression_end :: index.checked_sub(1).and_then(|index| -> tokens.get(index)).is_some_and(|token| -> failure_is_expression_end(token))
                if contextual || result_handler || failure_is_optional_prefix(tokens, index) { continue }
                if failure_is_infix_contract(tokens, index) || expression_end { hits.push((line(token.span.start), "retired failure propagation/type")) }
            }
            _ -> {}
        }
    }
    hits
}

// Rust: tests/retirement_ratchet.rs:719
pub fn file_name(path: OSPath) -> String { path.file_name().unwrap_or_default().to_string_lossy().to_string() }
// Rust: tests/retirement_ratchet.rs:726
pub fn read(path: OSPath) -> String? {
    ext :: (path.extension() ?? { return None }).to_string_lossy().to_string()
    if ext == "rs" || ext == "jet" { fs.read_to_string(path).ok() } else { None }
}
// Rust: tests/retirement_ratchet.rs:731
pub fn contains_word(text: String, word: String) -> Bool {
    is_word :: |character: Char?| -> character.is_some_and(|character| -> character.is_ascii_alphanumeric() || character == '_')
    text.match_indices(word).any(|(index, _)| -> !is_word(text[..index].chars().next_back()) && !is_word(text[index + word.len()..].chars().next()))
}

