// PORT-PENDING 1141 tests-retirement-ratchet: tests/retirement_ratchet.rs:1-1778
// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! D-ONCE-RETIRE1=C: every retirement carries an adoption ratchet that ends at
//RS //! zero.
//RS //!
//RS //! `Syntax::RETIREMENTS` says what was retired. This test says how much of the
//RS //! repository is still written the old way, and holds that number down. It
//RS //! counts files per canonical form, prints the adoption ratio for each row, and
//RS //! fails when a count moves away from its recorded ceiling in either direction:
//RS //!
//RS //! * a count **above** the ceiling means a new file was written in a retired
//RS //!   form, so the retirement went backwards;
//RS //! * a count **below** the ceiling means a migration landed without lowering
//RS //!   the ceiling, so the ratchet stopped ratcheting.
//RS //!
//RS //! A row is finished when its ceiling is `0`, and a ceiling of `0` then holds
//RS //! the retired form out of the repository for good.
//RS //!
//RS //! Diagnostic fixtures under `tests/ui` and `tests/fuzz` are not counted for
//RS //! the content rows: a fixture must keep the retired form to prove the error
//RS //! that refuses it.
//RS 
//RS mod common;
//RS 
//RS use std::collections::BTreeMap;
//RS use std::fs;
//RS use std::path::{Path, PathBuf};
//RS 
//RS use jet::Syntax::{
//RS     law_violations, rename_target, Retirement, RetirementKind, JETPACK_TOML, REF_PROVIDERS,
//RS     RETIREMENTS,
//RS };
//RS 
