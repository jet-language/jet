// Rust: tests/retirement_ratchet.rs:121
CONTENT_ROOTS :: ["crates", "Examples", "tests", "Source"]

// Rust: tests/retirement_ratchet.rs:127
pub fn is_skipped_dir(path: OSPath) -> Bool {
    path.components().any(|component| -> {
        if component is .Normal(name) {
            text :: name.to_string_lossy()
            text.starts_with('.') || text.starts_with("target") || text == "build" || text == "node_modules"
        } else { false }
    })
}

// Rust: tests/retirement_ratchet.rs:140
pub fn walk(root: OSPath, out: &[OSPath]) -> {
    // GATE #4494: native filesystem directory iteration and symlink facts.
    entries :: fs.read_dir(root).ok() ?? { return }
    for entry in entries.flatten() {
        path :: entry.path()
        file_type :: entry.file_type().ok() ?? { continue }
        if file_type.is_symlink() { continue }
        if path.is_dir() {
            relative :: path.strip_prefix(env("CARGO_MANIFEST_DIR")).unwrap_or(&path)
            if !is_skipped_dir(relative) { walk(&path, out) }
        } else { out.push(path) }
    }
}

// Rust: tests/retirement_ratchet.rs:167
pub fn all_files() -> [OSPath] {
    out := []
    root :: OSPath.new(env("CARGO_MANIFEST_DIR"))
    walk(root, &out)
    out
}

// Rust: tests/retirement_ratchet.rs:176
pub fn content_files() -> [OSPath] {
    out := []
    repo_root :: OSPath.new(env("CARGO_MANIFEST_DIR"))
    for content_root in CONTENT_ROOTS { walk(repo_root.join(content_root), &out) }
    for entry in fs.read_dir(repo_root).into_iter().flatten().flatten() {
        path :: entry.path()
        if path.is_file() && path.extension().is_some_and(|ext| -> ext == "jet") { out.push(path) }
    }
    out.retain(|path| -> {
        text :: "/{path.to_string_lossy().replace('\\', \"/\")}"
        !text.contains("/tests/ui/") && !text.contains("/tests/fuzz/")
    })
    out
}

