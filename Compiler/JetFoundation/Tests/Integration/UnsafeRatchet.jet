// Rust: tests/web_app.rs:14
pub fn repo_root() -> OSPath { env.manifest_dir() }
// Rust: tests/web_app.rs:18
pub fn jet_bin() -> OSPath { repo_root().join("target/debug/jet") }
// Rust: tests/web_app.rs:22
pub fn run_jet(args: &[String]) -> (I32, String, String) {
    // GATE #4494: process spawn and captured output.
    out :: Command.new(jet_bin()).current_dir(repo_root()).args(args).output().expect("spawn jet")
    (out.status.code().unwrap_or(1), String.from_utf8_lossy(&out.stdout).into_owned(), String.from_utf8_lossy(&out.stderr).into_owned())
}
// Rust: tests/web_app.rs:35
pub struct ServerChild {
    child: Child
    // Rust: tests/web_app.rs:37
    pub fn diagnostic(&self) -> String {
        status :: if self.child.try_wait() == {
            .Ok(Val(status)) -> "exited with {status}"
            .Ok(None) -> "still running"
            .Err(error) -> "status unavailable: {error}"
        }
        stderr := ""
        if status.starts_with("exited") {
            if self.child.stderr.take() == Val(pipe) {
                _ :: pipe.read_to_string(&stderr)
            }
        }
        "{status}; stderr={stderr}"
    }
}
// Rust: tests/web_app.rs:56
impl ServerChild.Drop {
    // Rust: tests/web_app.rs:57
    fn drop(&self) -> {
        _ :: self.child.kill()
        _ :: self.child.wait()
    }
}
// Rust: tests/web_app.rs:63
pub fn free_port() -> U16 {
    // GATE #4494: native TCP listener.
    listener :: TcpListener.bind(("127.0.0.1", 0)).unwrap()
    listener.local_addr().unwrap().port()
}
// Rust: tests/web_app.rs:68
pub fn request(port: U16, method: String, path: String, child: &ServerChild?) -> String {
    // GATE #4494: native TCP, monotonic deadline and thread sleep.
    deadline :: Instant.now() + Duration.from_secs(30)
    stream := loop {
        if TcpStream.connect(("127.0.0.1", port)) == {
            .Ok(stream) -> break stream
            .Err(error) -> {
                if Instant.now() < deadline {
                    _ :: error
                    thread.sleep(Duration.from_millis(50))
                } else {
                    diagnostic :: child.map((child) -> child.diagnostic()).unwrap_or_else(() -> "child diagnostics unavailable")
                    panic("web app did not listen on {port}: {error}; {diagnostic}")
                }
            }
        }
    }
    stream.write_all("{method} {path} HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\nContent-Length: 0\r\n\r\n".as_bytes()).unwrap()
    stream.shutdown(Shutdown.Write).unwrap()
    response := ""
    stream.read_to_string(&response).unwrap()
    response
}
// Rust: tests/web_app.rs:97
pub fn spawn_server_with_program(program: &OSPath, args: &[String], port: U16) -> ServerChild {
    // GATE #4494: native server process and pipes.
    ServerChild{child: Command.new(program).current_dir(repo_root()).args(args).env("JET_APP_PORT", port.to_string()).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().expect("spawn web app server")}
}
// Rust: tests/web_app.rs:110
pub fn spawn_server(args: &[String], port: U16) -> ServerChild { spawn_server_with_program(&jet_bin(), args, port) }
// Rust: tests/web_app.rs:114
pub fn response_body(response: String) -> String {
    response.split_once("\r\n\r\n").map(((_, body)) -> body).expect("HTTP response body")
}
// Rust: tests/web_app.rs:121
pub fn web_graph_facts_json() -> String {
    (code, stdout, stderr) :: run_jet(&["explain", "--web-graph", "--json", "Examples/features/web/web_app.jet"])
    assert_eq(code, 0, "stderr={stderr}\nstdout={stdout}")
    stdout.replace(&repo_root().join("Examples/features/web/web_app.jet").display().to_string(), "Examples/features/web/web_app.jet")
}
