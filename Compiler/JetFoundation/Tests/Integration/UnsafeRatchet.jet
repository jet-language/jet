// Rust: tests/unsafe_ratchet.rs:46
pub fn ratchet(fixture: &Fixture, update: Bool) -> Output {
    // GATE #4494: native child execution.
    script :: env.manifest_dir().join("Tools/agent/check-unsafe-ratchet.mjs")
    command := Command.new("node")
    command.arg(script).args(["--root", fixture.root.to_str().unwrap()]).args(["--baseline", fixture.baseline().to_str().unwrap()])
    if update { command.arg("--update") }
    command.output().unwrap()
}
// Rust: tests/unsafe_ratchet.rs:60
pub fn seed(fixture: &Fixture) -> {
    output :: ratchet(fixture, true)
    assert(output.status.success(), "baseline seed failed: {String.from_utf8_lossy(&output.stderr)}")
}
// Rust: tests/unsafe_ratchet.rs:69
pub fn ratchet_trips_on_seeded_growth() -> {
    fixture :: Fixture.new("growth")
    fixture.write("main.jet", """// #Unsafe("comment only")
TEXT :: "#Unsafe(\"string only\")"
#Unsafe("seed region") {}
#[Unsafe("function region"), FFI(c)] fn foreign() -> {}
""")
    seed(&fixture)
    fixture.write("new.jet", "#Unsafe(\"new region reason\") {}\n")
    output :: ratchet(&fixture, false)
    assert(!output.status.success(), "growth must fail")
    stderr :: String.from_utf8_lossy(&output.stderr)
    assert(stderr.contains("fixture: 2 -> 3"), "{stderr}")
    assert(stderr.contains("new.jet"), "{stderr}")
    assert(stderr.contains("new region reason"), "{stderr}")
}
// Rust: tests/unsafe_ratchet.rs:90
pub fn ratchet_allows_shrink() -> {
    fixture :: Fixture.new("shrink")
    fixture.write("main.jet", "#Unsafe(\"keep this region\") {}\n#Unsafe(\"remove this region\") {}\n")
    seed(&fixture)
    fixture.write("main.jet", "#Unsafe(\"keep this region\") {}\n")
    output :: ratchet(&fixture, false)
    assert(output.status.success(), "shrink must pass: {String.from_utf8_lossy(&output.stderr)}")
    baseline :: fs.read_to_string(fixture.baseline()).unwrap()
    assert(baseline.contains("\"total\": 1"), "{baseline}")
    assert(!baseline.contains("remove this region"), "{baseline}")
}
// Rust: tests/unsafe_ratchet.rs:110
pub fn generated_ffi_does_not_move_baseline() -> {
    fixture :: Fixture.new("generated-ffi")
    fixture.write("main.jet", "#Unsafe(\"authored region\") {}\n")
    seed(&fixture)
    before :: fs.read_to_string(fixture.baseline()).unwrap()
    fixture.write(".jet/bindings/c/generated.jet", "#Bindgen module c.fixture.__bindgen__ {\n    #Unsafe(\"generated FFI region\") fn foreign() -> {}\n}\n")
    output :: ratchet(&fixture, false)
    assert(output.status.success(), "generated FFI must not grow baseline: {String.from_utf8_lossy(&output.stderr)}")
    assert_eq(before, fs.read_to_string(fixture.baseline()).unwrap())
}

// Rust: tests/view_copy_semantics.rs:13
pub fn apply_type(name: String, args: [MirType]) -> MirType {
    MirType.from_kind(MirTypeKind.Apply(name: MirNominalRef{id: MirTypeId(1), name: name.to_string()}, args: ^args))
}
// Rust: tests/view_copy_semantics.rs:23
pub fn named_type(name: String) -> MirType { apply_type(name, []) }
// Rust: tests/view_copy_semantics.rs:27
pub fn view_of(element: MirType) -> MirType { apply_type("View", [^element]) }
// Rust: tests/view_copy_semantics.rs:30
pub fn lower_checked(source: String) -> MirProgram {
    root :: common.unique_tmp("jet_view_copy_semantics")
    fs.create_dir_all(&root).unwrap()
    fs.write(root.join("package.jet"), "name: \"view_copy_semantics\"\nversion: \"1.0.0\"\n").unwrap()
    entry :: root.join("main.jet")
    fs.write(&entry, source).unwrap()
    bundle := jet.Loader.load_entry(entry.to_str().unwrap()).unwrap()
    errors :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run).into_iter().filter((diagnostic) -> diagnostic.severity == jet.Diagnostics.Severity.Error).collect()
    assert(errors.is_empty(), "{errors:#?}")
    jet.Codegen.TIR.lower_checked_mir_program_for(&bundle, MirArtifactRequest.new(MirArtifactTarget.Cranelift, MirArtifactKind.NativeExecutable, MirArtifactBuildMode.Dev)).expect("checked source lowers through canonical MIR").0
}
// Rust: tests/view_copy_semantics.rs:57
pub fn emitted_kernel_call(rust: String, symbol: String) -> Bool {
    needle :: "{symbol}("
    declaration :: "fn {symbol}"
    rust.lines().any((line) -> !line.contains(&declaration) && line.contains(&needle))
}
