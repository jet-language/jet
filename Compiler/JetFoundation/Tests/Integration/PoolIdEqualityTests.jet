// Rust: tests/pool_id_equality.rs:19
#Test("pool_ids_are_equatable_without_requiring_the_payload_to_be_equatable") {
    source :: "\nstruct Payload {{\n    callback: fn(Int) -> Int\n}}\n\nfn identity(value: Int) -> Int {{\n    return value\n}}\n\nfn equal<T: Equatable>(left: T, right: T) -> Bool {{\n    return left == right\n}}\n\nfn run() {{\n    pool := Pool<Payload>.new()\n    left :: pool.add(Payload.{{callback: identity}})\n    right :: pool.add(Payload.{{callback: identity}})\n    same :: equal(left, right)\n    print(same)\n}}\n"
    result :: compile(source)
    assert(result.is_ok(), "ID<T> equality must depend on ID identity, not T: {result:#?}")
}
// Rust: tests/pool_id_equality.rs:50
#Test("reused_pool_slot_does_not_equal_its_stale_generation") {
    if tir_support.have_rustc() {
        (code, stdout) :: tir_support.build_and_run("pool_id_stale_generation", STALE_SOURCE)
        assert_eq(code, 0)
        assert_eq(stdout, "false\n")
    }
    (code, stdout, stderr) :: tir_support.run_default_multi("pool_id_stale_generation", "main.jet", &[("main.jet", STALE_SOURCE)])
    assert_eq(code, 0, "{stderr}")
    assert_eq(stdout, "false\n")
}
