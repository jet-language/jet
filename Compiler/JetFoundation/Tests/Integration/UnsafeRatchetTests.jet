    (code, stdout, stderr) :: run_jet(&["explain", "--web-graph", "--json", "Examples/features/web/app_hello.jet"])
    assert_eq(code, 0, "stderr={stderr}\nstdout={stdout}")
    compact :: stdout.chars().filter((character) -> !character.is_whitespace()).collect()
    assert(compact.contains("\"handler\":\"home\""), "{stdout}")
    assert(compact.contains("csp"), "{stdout}")
}
