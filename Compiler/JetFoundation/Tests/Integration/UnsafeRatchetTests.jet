    tmp :: &scratch.path
    fs.create_dir_all(tmp.join("routes/orders")).unwrap()
    fs.write(tmp.join("app.jet"), """
use core.web as web

fn run() -> App {
    return web.app().routes(from: "routes")
}
""").unwrap()
    fs.write(tmp.join("routes/index.jet"), "fn page() -> {}\n").unwrap()
