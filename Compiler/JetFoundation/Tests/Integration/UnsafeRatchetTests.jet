// Rust: tests/web_app.rs:264
#Test("typed_app_args_report_invalid_port_with_shared_fix") {
    loop args in [
        ["run", "Examples/features/web/app_typed_args.jet", "--", "--port=nine"],
        ["run", "--interpret", "Examples/features/web/app_typed_args.jet", "--", "--port=nine"],
        ["run", "--release", "Examples/features/web/app_typed_args.jet", "--", "--port=nine"]
    ] {
        (code, stdout, stderr) :: run_jet(args)
        assert_eq(code, 2, "args={args:?}\nstdout={stdout}\nstderr={stderr}")
        assert(stdout.is_empty(), "args={args:?}\nstdout={stdout}")
        assert(stderr.contains("`--port` expects an Int, got `nine`"), "args={args:?}\nstderr={stderr}")
        assert(stderr.contains("fix: pass a whole number to `--port`"), "args={args:?}\nstderr={stderr}")
    }
}
