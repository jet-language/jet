// Rust: tests/view_copy_semantics.rs:338
#Test("string_view_materialization_uses_string_kernel_and_list_view_uses_list_kernel") {
    string_source :: """
fn run() -> {
    text := "  x  "
    view :: text.trim()
    print(~view)
}
"""
    string_compiled :: jet.compile(string_source).expect("String View materializes")
    assert(emitted_kernel_call(&string_compiled.rust, "jet_string_view_copy"), "String view lowering must emit a call-site use of jet_string_view_copy")
    assert(!emitted_kernel_call(&string_compiled.rust, "jet_view_copy"), "String view lowering must not call the List kernel")
    list_compiled :: jet.compile(LIST_STRING_SOURCE).expect("View<String> materializes")
    assert(emitted_kernel_call(&list_compiled.rust, "jet_view_copy"), "List<String> view lowering must emit a call-site use of jet_view_copy")
    assert(!emitted_kernel_call(&list_compiled.rust, "jet_string_view_copy"), "List<String> view lowering must not call the String kernel")
}
