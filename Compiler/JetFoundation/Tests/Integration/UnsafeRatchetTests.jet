// Rust: tests/unsafe_sentries.rs:4
#Test("dev_sentry_faults_feed_the_shared_memory_ledger_without_engine_policy") {
    // GATE #4494: environment and sentry memory substrate.
    root :: env.temp_dir().join("jet_sentry_ledger_{id()}")
    ledger :: root.join("ledger.jsonl")
    fs.create_dir_all(&root).unwrap()
    env.set_var("JET_MEMORY_LEDGER", &ledger)
    jet_sentry_reset()
    gate :: jet_sentry_scope(true, "unsafe.jet", 12, "reads raw storage")
    fault :: jet_sentry_check(1, 8, 1, "read", "live allocation").unwrap()
    assert_eq(fault.code, "R0801")
    assert_eq(fault.file, "unsafe.jet")
    drop(^gate)
    jet_sentry_reset()
    env.remove_var("JET_MEMORY_LEDGER")
    witness :: fs.read_to_string(&ledger).unwrap()
    assert(witness.contains("\"schema\":\"jet.memory.ledger\""))
    assert(witness.contains("\"kind\":\"sentry\""))
    assert(witness.contains("\"code\":\"R0801\""))
    assert(witness.contains("\"source\":\"unsafe.jet\""))
    assert(witness.contains("\"provenance\":\"source #Unsafe gate\""))
    assert(witness.contains("derive the pointer from live storage inside this gate"))
    _ :: fs.remove_dir_all(root)
}

// Rust: tests/user_policies.rs:6
#Test("user_policy_declaration_and_custom_chain_parse_together") {
    source :: """
pub policy audit(topic: String) {
    wrap(call) { return call() }
}

#Policy(audit("users.load"))
fn load_user() -> Int { 7 }
"""
    (tokens, lexer_diagnostics) :: Lexer.lex(source)
    assert(lexer_diagnostics.is_empty(), "{lexer_diagnostics:?}")
    program :: Parser.parse(&tokens).expect("user policy source should parse")
    declaration :: program.user_policy_declarations.first().expect("the package policy declaration")
    assert(declaration.is_pub)
    assert_eq(declaration.name, "audit")
    assert_eq(declaration.params.len(), 1)
    assert_eq(declaration.params[0].name, "topic")
    if program.items[0] == {
        .Func(function) -> {
            marker :: function.markers.iter().find((marker) -> marker.name == Syntax.MARKER_POLICY).expect("the callable policy marker")
            assert(if marker.args[0].as_expr() == {
                Val(AST.Expr.Call(call)) -> call.name == "audit"
                else -> false
            })
        }
        else -> panic("expected the policy-decorated function")
    }
    formatted :: Formatter.format_source(source).expect("user policy source should format")
    assert(formatted.contains("pub policy audit(topic: String)"))
    assert(formatted.contains("wrap(call)"))
}

// Rust: tests/user_policies.rs:47
#Test("user_policy_apply_keeps_a_callable_binding") {
    dir :: common.unique_tmp("jet_user_policy_apply")
    fs.create_dir_all(&dir).unwrap()
    file :: dir.join("main.jet")
    fs.write(&file, """pub policy audit(topic: String) {
    wrap(call) { return "{topic}:{call()}" }
}

fn load_user() -> String { "ok" }

fn run() -> {
    selected :: apply(audit("users.load"), load_user)
    print(selected())
}
""").unwrap()
    bundle := jet.Loader.load_entry(file.to_str().unwrap()).unwrap()
    diagnostics :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run)
    assert(diagnostics.is_empty(), "{diagnostics:#?}")
    if jet.Interpreter.dev_iteration(file.to_str().unwrap(), false, true) == {
        .Ran(exit_code, stdout, stderr) -> {
            assert_eq(exit_code, 0)
            assert_eq(stdout, "users.load:ok\n")
            assert_eq(stderr, "")
        }
        .Problems(diagnostics) -> panic("interpreter rejected the user policy apply source: {diagnostics:#?}")
    }
}

// Rust: tests/vault_key_wrap.rs:4
#Test("actual_vault_key_wrap_bridge_fixture_compiles_and_runs") {
    // GATE #4494: actual external reference fixture process, not a production Rust bridge.
    root :: env.current_dir().unwrap()
    dir :: env.temp_dir().join("jet-vault-key-wrap-proof-{id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(dir.join("src")).unwrap()
    jet_codegen :: root.join("crates/jet-codegen")
    fs.write(dir.join("Cargo.toml"), "[package]\nname = \"jet-vault-key-wrap-proof\"\nversion = \"0.0.0\"\nedition = \"2021\"\n\n[workspace]\n\n[dependencies]\naes-gcm = \"0.10\"\nage = \"0.10\"\nargon2 = {{ version = \"=0.5.3\", default-features = false, features = [\"alloc\", \"password-hash\"] }}\nblake3 = \"1\"\nchacha20poly1305 = \"0.10\"\ned25519-dalek = \"2\"\nhkdf = \"0.12\"\nsha2 = \"0.10\"\nsubtle = \"2\"\nx25519-dalek = \"2\"\njet-codegen = {{ path = \"{jet_codegen.display()}\" }}\n").unwrap()
    fixture :: root.join("tests/fixtures/vault_key_wrap_runtime.rs")
    fs.write(dir.join("src/lib.rs"), "include!({fixture:?});\n").unwrap()
    output :: Command.new("cargo").args(["test", "--offline", "--quiet", "--manifest-path"]).arg(dir.join("Cargo.toml")).args(["--", "--test-threads=1"]).env("CARGO_TARGET_DIR", dir.join("target")).output().unwrap()
    _ :: fs.remove_dir_all(&dir)
    assert(output.status.success(), "vault key-wrap proof failed:\nstdout:\n{String.from_utf8_lossy(&output.stdout)}\nstderr:\n{String.from_utf8_lossy(&output.stderr)}")
}

