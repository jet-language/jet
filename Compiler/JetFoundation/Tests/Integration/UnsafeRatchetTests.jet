// Rust: tests/view_copy_semantics.rs:66
#Test("canonical_view_copy_kind_preserves_string_and_nested_shapes") {
    string_view :: view_of(named_type("str"))
    owned_string_view :: view_of(MirType.from_kind(MirTypeKind.String))
    nested_view :: view_of(MirType.from_kind(MirTypeKind.List(MirType.from_kind(MirTypeKind.String))))
    tagged_nested_view :: MirType.from_kind(MirTypeKind.Tagged(marker: MirTagMarker.User("ReadAlias"), inner: nested_view.clone()))
    assert_eq(mir_view_copy_kind(&string_view), Val(MirViewCopyKind.String))
    assert_eq(mir_view_copy_kind(&owned_string_view), Val(MirViewCopyKind.List))
    assert_eq(mir_view_copy_kind(&nested_view), Val(MirViewCopyKind.List))
    assert_eq(mir_view_copy_kind(&tagged_nested_view), Val(MirViewCopyKind.List))
    assert(mir_view_copy_element_type(&nested_view).expect("nested view element").is_list())
    string_target :: MirType.from_kind(MirTypeKind.String)
    list_target :: MirType.from_kind(MirTypeKind.List(MirType.from_kind(MirTypeKind.List(MirType.from_kind(MirTypeKind.String)))))
    canonical_string_target :: named_type("String")
    canonical_list_target :: apply_type("List", [MirType.from_kind(MirTypeKind.String)])
    tagged_canonical_string :: MirType.from_kind(MirTypeKind.Tagged(marker: MirTagMarker.User("OwnedAlias"), inner: canonical_string_target.clone()))
    fake_string_view :: apply_type("foo.View", [named_type("str")])
    fake_list_view :: apply_type("foo.ViewMut", [MirType.from_kind(MirTypeKind.Int)])
    malformed_view_placeholder :: apply_type("View<>", [named_type("str")])
    fake_string_target :: named_type("foo.String")
    fake_list_target :: apply_type("foo.List", [MirType.from_kind(MirTypeKind.String)])
    malformed_list_placeholder :: apply_type("List<>", [MirType.from_kind(MirTypeKind.String)])
    assert_eq(mir_view_copy_kind(&fake_string_view), None)
    assert_eq(mir_view_copy_kind(&fake_list_view), None)
    assert_eq(mir_view_copy_kind(&malformed_view_placeholder), None)
    assert(!MirViewCopyKind.String.target_matches(&fake_string_target))
    assert(!MirViewCopyKind.List.target_matches(&fake_list_target))
    assert(!MirViewCopyKind.List.target_matches(&malformed_list_placeholder))
    assert(MirViewCopyKind.String.target_matches(&canonical_string_target))
    assert(MirViewCopyKind.String.target_matches(&tagged_canonical_string))
    assert(MirViewCopyKind.List.target_matches(&canonical_list_target))
    assert(MirViewCopyKind.String.target_matches(&string_target))
    assert(!MirViewCopyKind.String.target_matches(&list_target))
    assert(MirViewCopyKind.List.target_matches(&list_target))
}

// Rust: tests/view_copy_semantics.rs:129
#Test("copy_fact_changes_canonical_payload_and_identity") {
    ordinary :: MirOperation.Copy(value: MirValueId(7), fact: MirCopyFact.Materialize)
    materialized :: MirOperation.Copy(value: MirValueId(7), fact: MirCopyFact.ViewMaterialize)
    ordinary_payload :: canonical_operation_payload(&ordinary)
    materialized_payload :: canonical_operation_payload(&materialized)
    assert_ne(ordinary_payload, materialized_payload)
    assert(ordinary_payload.contains("\"copy_fact\":\"materialize\""))
    assert(materialized_payload.contains("\"copy_fact\":\"view_materialize\""))
    assert_ne(canonical_operation_identity(&ordinary), canonical_operation_identity(&materialized))
}

// Rust: tests/view_copy_semantics.rs:149
#Test("optimization_and_digest_preserve_materialization_marker") {
    mir :: lower_checked(OWNED_WINDOW_SOURCE)
    optimized :: optimize_mir_program(^mir, &MirOptimizationPolicy.conservative()).expect("MIR optimization preserves the checked operation schema")
    assert(optimized.functions.iter().any((function) -> function.blocks.iter().any((block) -> block.instructions.iter().any((instruction) -> if instruction.operation == {
        .Copy(_, MirCopyFact.ViewMaterialize) -> true
        else -> false
    }))))
    flipped := optimized.clone()
    changed := false
    loop function in &flipped.functions {
        loop block in &function.blocks {
            loop instruction in &block.instructions {
                if instruction.operation == .Copy(value, MirCopyFact.ViewMaterialize) {
                    instruction.operation = MirOperation.Copy(value: value, fact: MirCopyFact.Materialize)
                    changed = true
                }
            }
        }
    }
    assert(changed, "fixture must contain a materializing Copy")
    assert_ne(mir_program_digest(&optimized), mir_program_digest(&flipped))
}

// Rust: tests/view_copy_semantics.rs:188
#Test("checked_source_windows_lower_to_marked_mir") {
    mir :: lower_checked(EMPTY_STRING_AND_LIST_SOURCE)
    marked :: mir.functions.iter().flat_map((function) -> function.blocks.iter()).flat_map((block) -> block.instructions.iter()).filter((instruction) -> if instruction.operation == {
        .Copy(_, MirCopyFact.ViewMaterialize) -> true
        else -> false
    }).count()
    assert(marked >= 4, "the checked fixture's four windows must lower to marked Copy operations: {marked}")
}

// Rust: tests/view_copy_semantics.rs:212
#Test("evaluator_view_materialization_helpers_use_checked_jet_route") {
    source :: fs.read_to_string(env.manifest_dir().join("Compiler/JetEval/Source/Evaluator.jet")).unwrap()
    loop helper in ["jet_eval_materialize_string_window", "jet_eval_materialize_list_window", "jet_eval_materialize_bytes_window"] {
        assert(source.contains("fn {helper}("), "Source/Evaluator.jet must define {helper}")
    }
    assert(source.contains("window :: value.after(\"\")\n    ~window"), "String evaluator materialization must lower through checked Jet `~`")
    assert_eq(source.matches("window :: value[0..<value.len()]\n    ~window").count(), 2, "List and Bytes evaluator materialization must use checked full windows")
}

