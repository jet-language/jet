// Rust: tests/mir_constant_identity.rs:101
pub fn write_fixture(root: &OSPath) -> {
    tir_support.write_test_package(root, tir_support.TIR_TEST_PACKAGE)
    for (relative, source) in FILES {
        path :: root.join(relative)
        if parent :: path.parent() { fs.create_dir_all(parent).unwrap() }
        fs.write(path, source).unwrap()
    }
}
// Rust: tests/mir_constant_identity.rs:112
pub fn assert_fixture_constants_reach_mir_globals() -> {
    scratch :: common.Scratch.new("mir_constant_identity_keys")
    write_fixture(&scratch.path)
    mir :: jet.run_compiler_work(fn() -> {
        entry :: scratch.path.join("main.jet")
        bundle := jet.Loader.load_entry(entry.to_str().unwrap()).expect("constant identity bundle should load")
        errors :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run).into_iter().filter(fn(diagnostic) -> diagnostic.severity == jet.Diagnostics.Severity.Error).collect()
        assert(errors.is_empty(), "constant identity fixture rejected: {errors:#?}")
        request :: MIR.MirArtifactRequest.new(MIR.MirArtifactTarget.RustAot, MIR.MirArtifactKind.NativeExecutable, MIR.MirArtifactBuildMode.Dev)
        tir :: jet.Codegen.TIR.lower_checked_tir_program_for(&bundle, request).expect("constant identity fixture should lower through TIR")
        jet.Codegen.TIR.lower_tir_to_mir(tir).expect("constant identity fixture should lower through MIR")
    })
    expected_keys: HashSet<String> = mir.constants.iter().filter(fn(constant) -> {
        module :: mir.modules.iter().find(fn(module) -> module.id == constant.module)
        if module.is_none() { return false }
        owner :: module.unwrap()
        (owner.path.ends_with("alpha.jet") || owner.path.ends_with("beta.jet")) && ["TOKEN", "PAYLOAD", "ALIAS_VALUES", "IMPORT_VALUES"].contains(constant.name.as_str())
    }).map(fn(constant) -> constant.key.clone()).collect()
    assert_eq(expected_keys.len(), 7, "fixture must retain duplicate module constants with distinct element types")
    global_keys: HashSet<String> = mir.functions.iter().flat_map(fn(function) -> &function.blocks).flat_map(fn(block) -> &block.instructions).filter_map(fn(instruction) -> match &instruction.operation {
        MIR.MirOperation.Global { name } -> Some(name.clone())
        _ -> None
    }).collect()
    missing :: expected_keys.difference(&global_keys).collect()
    assert(missing.is_empty(), "runtime fixture constants must reach MIR Globals by their exact definition keys: {missing:?}")
}
// Rust: tests/mir_constant_identity.rs:185
pub fn assert_private_module_constant_is_rejected() -> {
    scratch :: common.Scratch.new("mir_constant_identity_private")
    write_fixture(&scratch.path)
    fs.write(scratch.path.join("main.jet"), "\nmodule alpha\nfn run() {\n    print(alpha.PAYLOAD[0])\n}\n").unwrap()
    diagnostics :: jet.run_compiler_work(fn() -> {
        entry :: scratch.path.join("main.jet")
        bundle := jet.Loader.load_entry(entry.to_str().unwrap()).expect("private constant bundle should load")
        jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run)
    })
    private :: diagnostics.iter().find(fn(diagnostic) -> diagnostic.code == "E0605").expect("qualified private module constant should be rejected")
    assert(private.what.contains("PAYLOAD"), "private diagnostic must name the inaccessible constant: {private:?}")
}
// Rust: tests/mir_constant_identity.rs:214
pub fn run_without_tier_trace(name: String, mode: &[String]) -> (Int32, String, String) {
    scratch :: common.Scratch.new(name)
    write_fixture(&scratch.path)
    output :: Command.new(env.var_os("CARGO_BIN_EXE_jet").unwrap()).arg("run").args(mode).arg("main.jet").current_dir(&scratch.path).env("NO_COLOR", "1").env("JET_STORE_DIR", scratch.path.join("cache")).env("JETPACK_ROOT", scratch.path.join("jetpack")).output().expect("Jet run should launch")
    (output.status.code().unwrap_or(1), String.from_utf8_lossy(&output.stdout).into_owned(), String.from_utf8_lossy(&output.stderr).into_owned())
}
// Rust: tests/mir_constant_identity.rs:234
pub fn assert_web_output(name: String) -> {
    scratch :: common.Scratch.new(name)
    write_fixture(&scratch.path)
    entry :: scratch.path.join("main.jet")
    shown :: entry.to_string_lossy()
    output :: jet.compile_web(&shown).unwrap_or_else(fn(diagnostics) -> panic("web rejected constant identity fixture: {diagnostics:#?}"))
    web :: output.web.expect("web compile must produce web artifacts")
    web_root :: scratch.path.join("web")
    build_dir :: web_root.join("build")
    fs.create_dir_all(&build_dir).unwrap()
    fs.write(build_dir.join("web.manifest.json"), &web.manifest_json).unwrap()
    fs.write(build_dir.join("app.js"), &web.js_app).unwrap()
    fs.write(build_dir.join("jet_dom_runtime.js"), &web.dom_runtime).unwrap()
    fs.write(build_dir.join("app_wasm.rs"), &web.wasm_rust).unwrap()
    wasm :: Command.new("rustc").current_dir(&web_root).args(["--edition", "2021", "--target", "wasm32-unknown-unknown", "--crate-type", "cdylib", "-O", "build/app_wasm.rs", "-o", "build/app.wasm"]).output().expect("rustc is required to compile the web constant-identity regression")
    assert(wasm.status.success(), "rustc rejected web constant-identity wasm:\n{String.from_utf8_lossy(&wasm.stderr)}")
    assert(build_dir.join("app.wasm").is_file(), "web compile must produce app.wasm")
    node :: Command.new("node").current_dir(&build_dir).args(["--input-type=module", "-e", "const { jet_main } = await import('./app.js');\nconst result = await jet_main();\nif (result !== undefined) throw new Error('web entry success result must be undefined');"]).output().expect("Node is required to execute the web constant-identity regression")
    assert(node.status.success(), "web constant-identity fixture failed:\nstdout: {String.from_utf8_lossy(&node.stdout)}\nstderr: {String.from_utf8_lossy(&node.stderr)}")
    assert_eq(String.from_utf8_lossy(&node.stdout), MIR_EXPECTED)
    assert(node.stderr.is_empty(), "valid web program wrote to stderr: {String.from_utf8_lossy(&node.stderr)}")
}
