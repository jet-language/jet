pub const PURE_FOLD_SOURCE: String = "\nfn square(value: Int) -> Int {\n    value * value\n}\n\nfn greet(name: String) -> String {\n    \"hello {name}\"\n}\n\nfn noisy() -> Int {\n    print(\"noisy\")\n    5\n}\n\nfn run() {\n    squared :: square(12)\n    greeting :: greet(\"jet\")\n    total :: [4, 5, 6].reduce(0, (acc: Int, n: Int) -> acc + n)\n    a :: 7\n    b :: 3\n    larger :: if a > b -> a * 2 else -> b\n    side :: noisy()\n    print(\"{squared} {greeting} {total} {larger} {side}\")\n}\n"
