// Rust: tests/math_display_parity.rs:35
pub fn run_lens(file: &OSPath, release: Bool) -> Output {
    command := Command.new(env.var_os("CARGO_BIN_EXE_jet").unwrap())
    command.arg("run")
    if release { command.arg("--release") }
    command.arg(file).env("NO_COLOR", "1").output().expect("run builtin math display fixture")
}
