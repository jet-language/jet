// Rust: tests/simd_witness.rs:216
#Test("default_float_loop_is_packed_and_scalar_marker_is_a_hard_opt_out") {
    optimized :: simd.lower_checked(simd.SOURCE)
    auto :: simd.mir_function(&optimized, "auto")
    scalar :: simd.mir_function(&optimized, "scalar")
    fact :: auto.optimization.vector_facts.iter().find((fact) -> fact.decision.is_eligible()).unwrap_or_else(() -> panic("default Float loop must retain an eligible vector fact: {auto.optimization.vector_facts:?}"))
    assert(fact.lane_width == .Val(2) || fact.lane_width == .Val(4))
    assert(scalar.optimization.vector_facts.iter().all((fact) -> !fact.decision.is_eligible()))
    assert(scalar.optimization.vector_facts.iter().any((fact) -> fact.decision is MirOptimizationDecision.Rejected(_)))
}
// Rust: tests/simd_witness.rs:245
#Test("default_and_scalar_float_witnesses_print_identical_values_on_every_tier") {
    expected :: "3.0\n5.0\n7.0\n9.0\n3.0\n5.0\n7.0\n9.0\n"
    (jit_code, jit_stdout, jit_stderr) :: tir_support.jit_run("simd_default_scalar", simd.SOURCE)
    assert_eq(jit_code, 0, "default run failed: {jit_stderr}")
    assert_eq(jit_stdout, expected)
    (interpreter_code, interpreter_stdout, interpreter_stderr) :: tir_support.interpreter_run("simd_default_scalar", simd.SOURCE)
    assert_eq(interpreter_code, jit_code, "interpreter failed: {interpreter_stderr}")
    assert_eq(interpreter_stdout, expected)
    if tir_support.have_rustc() {
        (aot_code, aot_stdout, aot_stderr) :: tir_support.build_and_run_full("jet_simd_witness", "simd_default_scalar", simd.SOURCE)
        assert_eq(aot_code, jit_code, "AOT failed: {aot_stderr}")
        assert_eq(aot_stdout, expected)
    }
    if tir_support.have_rustc() { simd.assert_native_simd_artifact(expected) }
    simd.assert_web_simd_artifacts_run(expected)
}
