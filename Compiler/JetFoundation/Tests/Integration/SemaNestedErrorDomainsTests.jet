// Rust: tests/single_use.rs:316
#Test("drop_erases_no_unsafe_in_codegen") {
    body :: """
fn run() {
    db :: acquire("db")
    #Unsafe("gone") { consume(db) }
}
"""
    src :: "{LOCK}\n{body}"
    out :: jet.compile(&src).expect("should compile")
    assert(out.rust.contains("drop("), "consume should lower to a Rust drop(...) call")
}
// Rust: tests/single_use.rs:330
#Test("single_use_enum_dropped_is_e0140") {
    src :: """
#SingleUse enum Ticket {
    Open
    Closed
}
fn make() -> Ticket { return Ticket.Open }
fn close(t: ^Ticket) { print("closed") }
fn run() { t :: make() }
"""
    codes :: codes_of(src)
    assert(codes.contains("E0140"), "expected E0140 for enum, got {codes:?}")
}
// Rust: tests/single_use.rs:357
#Test("tag_erases_in_codegen") {
    body :: """
fn run() {
    db :: acquire("db")
    release(^db)
}
"""
    src :: "{LOCK}\n{body}"
    out :: jet.compile(&src).expect("should compile")
    assert(!common.strip_vetted_prelude_modules(&out.rust).contains("unsafe"), "I1: no unsafe in generated code")
    assert(!out.rust.contains("SingleUse"), "tag must erase, found SingleUse in output")
    assert(out.rust.contains("struct __jet_Lock"), "Lock should lower to a plain struct")
}
// Rust: tests/single_use.rs:385
#Test("task_handles_owe_join_or_detach") {
    dropped :: codes_of("""
fn run() {
    handle :: task 42
    print("done")
}
""")
    assert(dropped.contains("L1101"), "a bound handle that is never discharged must report L1101, got {dropped:?}")
    discarded :: codes_of("""
fn run() {
    _ :: task 42
    print("done")
}
""")
    assert(discarded.contains("L1101"), "discarding a handle into `_` is still dropping it, got {discarded:?}")
    join_source :: """
fn run() {
    handle :: task 42
    print(handle.join() ?? 0)
}
"""
    detach_source :: """
fn run() {
    handle :: task 42
    handle.detach()
}
"""
    unbound_source :: """
fn work() -> Int { 7 }
fn run() {
    task work()
    print("spawned")
}
"""
    for (label, src) in [("join", join_source), ("detach", detach_source), ("unbound spawn", unbound_source)] {
        codes :: codes_of(src)
        assert(!codes.contains("L1101"), "{label} discharges the duty, so no L1101 belongs here; got {codes:?}")
    }
}
