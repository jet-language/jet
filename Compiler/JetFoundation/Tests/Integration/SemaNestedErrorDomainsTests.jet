// Rust: tests/sema_soundness.rs:9
#Test("knowledge_loss_requires_a_spelled_gate") {
    rejects :: (source: String, code: String) -> {
        diagnostics :: jet.compile(source).expect_err("source must be rejected by sema")
        assert(diagnostics.iter().any((diagnostic) -> diagnostic.code == code), "expected {code}, got {diagnostics:?}")
    }
    rejects("""
fn accept_f32(value: F32) {}
fn run() {
    value :: Float.{1.0}
    accept_f32(value)
}
""", "E0112")
    rejects("""
#Numeric Severity :: distinct Int(0..10)
fn run() {
    left :: Severity.from_int(4)
    right :: Severity.from_int(5)
    total :: left + right
    print(total)
}
""", "E0156")
    rejects("""
fn accept_int(value: Int) {}
fn run() {
    bounded :: Int(0..10).from_int(4)
    accept_int(bounded)
}
""", "E0156")
    rejects("""
fn run() {
    bounded :: Int(0..10).from_int(4)
    negated :: -bounded
    print(negated)
}
""", "E0156")
    rejects(fs.read_to_string(env.manifest_dir().join("tests/ui/quantity_implicit_rounding.jet")).unwrap(), "E0127")
    rejects(fs.read_to_string(env.manifest_dir().join("tests/ui/typestate_wrong_state.jet")).unwrap(), "E0150")
    rejects(fs.read_to_string(env.manifest_dir().join("tests/ui/taint_sink_unsanitized.jet")).unwrap(), "E0721")
}
