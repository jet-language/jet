use std.net.TcpListener
use jet_foundation.Tests.Integration.BrowserBidi.[accept_websocket, read_text_frame, write_text_frame, field]
// Rust: tests/browser_bidi.rs:1908
// GATE #4494: native TCP test peer over the real WebSocket transport.
fn run_artifacts(listener: TcpListener) -> [String] {
    (stream, _) := listener.accept().unwrap()
    accept_websocket(&stream)
    methods := [String]{}
    locate_calls := 0
    for _ in 0..40 {
        request :: read_text_frame(&stream)
        id :: field(&request, "id")
        method :: field(&request, "method")
        methods.push(method.clone())
        if method == {
            "session.status" -> write_text_frame(&stream, "{{\"type\":\"success\",\"id\":{id},\"result\":{{\"ready\":true,\"message\":\"ready\"}}}}")
            "session.new" -> write_text_frame(&stream, "{{\"type\":\"success\",\"id\":{id},\"result\":{{\"sessionId\":\"mock-session\",\"capabilities\":{{\"browserName\":\"mock\",\"browserVersion\":\"1\"}}}}}}")
            "browser.createUserContext" -> write_text_frame(&stream, "{{\"type\":\"success\",\"id\":{id},\"result\":{{\"userContext\":\"user-1\"}}}}")
            "browsingContext.create" -> write_text_frame(&stream, "{{\"type\":\"success\",\"id\":{id},\"result\":{{\"context\":\"page-1\"}}}}")
            "browsingContext.navigate" -> write_text_frame(&stream, "{{\"type\":\"success\",\"id\":{id},\"result\":{{\"url\":\"https://example.test/app\",\"navigation\":\"nav-1\"}}}}")
            "storage.setCookie" | "storage.deleteCookies" | "browser.setDownloadBehavior" | "browsingContext.close" | "browser.removeUserContext" | "session.end" | "input.setFiles" -> write_text_frame(&stream, "{{\"type\":\"success\",\"id\":{id},\"result\":{{}}}}")
            "storage.getCookies" -> write_text_frame(&stream, "{{\"type\":\"success\",\"id\":{id},\"result\":{{\"cookies\":[{{\"name\":\"session\",\"value\":{{\"type\":\"string\",\"value\":\"cookie-SECRET\"}},\"domain\":\"example.test\",\"path\":\"/\"}}],\"partitionKey\":{{\"userContext\":\"user-1\"}}}}}}")
            "script.callFunction" -> {
                result :: if request.contains("getItem") { "{{\"result\":{{\"type\":\"string\",\"value\":\"stored-SECRET\"}}}}" } else { "{{\"result\":{{\"type\":\"undefined\"}}}}" }
                write_text_frame(&stream, "{{\"type\":\"success\",\"id\":{id},\"result\":{result}}}")
            }
            "browsingContext.captureScreenshot" -> write_text_frame(&stream, "{{\"type\":\"success\",\"id\":{id},\"result\":{{\"data\":\"iVBORw0KGgo=\"}}}}")
            "browsingContext.print" -> write_text_frame(&stream, "{{\"type\":\"success\",\"id\":{id},\"result\":{{\"data\":\"JVBERi0xLjQ=\"}}}}")
            "browsingContext.locateNodes" -> {
                locate_calls += 1
                write_text_frame(&stream, "{{\"type\":\"success\",\"id\":{id},\"result\":{{\"nodes\":[{{\"type\":\"node\",\"sharedId\":\"file-node-{locate_calls}\"}}]}}}}")
            }
            "session.subscribe" -> {
                write_text_frame(&stream, "{{\"type\":\"success\",\"id\":{id},\"result\":{{}}}}")
                write_text_frame(&stream, "{{\"type\":\"event\",\"method\":\"browsingContext.downloadWillBegin\",\"params\":{{\"context\":\"page-1\",\"navigation\":\"nav-dl\",\"timestamp\":1.0,\"url\":\"https://cdn.example/SECRET_REPORT.pdf\",\"download\":\"dl-1\",\"suggestedFilename\":\"SECRET_REPORT.pdf\"}}}}")
            }
            other -> panic("unexpected BiDi method {other}: {request}")
        }
        if method == "session.end" { break }
    }
    methods
}
