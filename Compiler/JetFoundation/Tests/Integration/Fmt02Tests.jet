// Rust: tests/fmt.rs:1989
#Test("fmt_preserves_single_line_loops_and_fn") {
    assert_fmt_stable("fn run() {{\n    n :: 0\n    loop n < 3 -> n += 1\n}}\n", "single-line while/loop")
    assert_fmt_stable("fn run() {{\n    loop -> break\n}}\n", "single-line infinite loop")
    assert_fmt_stable("fn run() {{\n    loop i := 0, i < 3 -> i += 1\n}}\n", "single-line state loop")
    assert_fmt_stable("fn run() {{\n    loop i in 0..3 -> print(\"{{i}}\")\n}}\n", "single-line for/loop")
    assert_fmt_stable("fn run() {{\n    loop i in 0..<3 -> print(\"{{i}}\")\n}}\n", "exclusive range loop")
    assert_fmt_stable("fn run() {{\n    loop (i, x) in xs -> print(\"{{i}}\")\n}}\n", "list two-binding loop")
    assert_fmt_stable("fn one() -> Int {{ 1 }}\n", "single-line fn body")
    retired_fn := format_source("fn one() => Int = 1\n").expect("retired fn body should be fixable")
    assert(retired_fn.contains("fn one() -> Int {{ 1 }}"), "{retired_fn}")
    assert_fmt_stable("fn noop() {{}}\n", "empty single-line fn body")
}
