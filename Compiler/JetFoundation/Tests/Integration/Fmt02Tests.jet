// Rust: tests/fmt.rs:2724
#Test("layout_compiler_fact_rejects_unknown_and_user_owned_at_members") {
    parsed := parse_source("derive T.LayoutFacts {{ info :: T.$unknown }}\nfn run() {{}}\n")
    unknown := parsed.diagnostics.iter().find(diagnostic -> diagnostic.code == "E0302").expect("unknown compiler fact should have a registered diagnostic")
    assert(unknown.message.contains("$unknown"), "{unknown:?}")
    assert(unknown.fix.contains("$layout"), "{unknown:?}")
    user_member := parse_source("struct Bad {{ @layout: Int }}\nfn run() {{}}\n")
    assert(user_member.diagnostics.iter().any(diagnostic -> diagnostic.code == "E0003"), "user declarations must not claim the compiler-owned @ member: {user_member.diagnostics:?}")
}
