// Rust: tests/fmt.rs:2551
#Test("fmt_dot_construction_d_dotctor1") {
    named := "struct Pt {{\n    x: Int\n    y: Int\n}}\n\nfn run() {{\n    p :: Pt{{ x: 1, y: 2 }}\n    print(\"{{p.x}}\")\n}}\n"
    out_named := format_source(named).expect("fmt should accept named Pt construction")
    assert(out_named.contains("Pt{{"), "named head Pt{{ must survive fmt, got:\n{out_named}")
    assert(!out_named.contains("Pt.{{"), "fmt must not regress to dotted construction form, got:\n{out_named}")
    twice_named := format_source(out_named).expect("named form must re-fmt")
    assert_eq(out_named, twice_named, "named form must be fmt-idempotent")
    old := "struct Pt {{\n    x: Int\n    y: Int\n}}\n\nfn run() {{\n    p :: Pt.{{ x: 1, y: 2 }}\n    print(\"{{p.x}}\")\n}}\n"
    out_old := format_source(old).expect("fmt should recover retired dotted form")
    assert(out_old.contains("Pt{{"), "retired dotted form must auto-fix to Pt{{, got:\n{out_old}")
    assert(!out_old.contains("Pt.{{"), "dotted construction form must not survive fmt, got:\n{out_old}")
    twice_old := format_source(out_old).expect("fixed form must re-fmt")
    assert_eq(out_old, twice_old, "fixed form must be fmt-idempotent")
}
