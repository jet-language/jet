// Rust: tests/fmt.rs:2194
#Test("fmt_rewrites_marker_stacking_to_one_shape_and_is_stable") {
    single := format_source("#[Codable]\nstruct Invoice {{ id: Int }}\n").expect("fmt should recover a single-item marker list")
    assert(single.contains("#Codable\nstruct Invoice"), "fmt must remove brackets around one marker:\n{single}")
    single_twice := format_source(single).expect("canonical single marker should parse")
    assert_eq(single, single_twice, "single-marker rewrite must be stable")
    stacked := format_source("#Job #Every(5min) fn prune() {{\n}}\n").expect("fmt should recover a bare marker stack")
    assert(stacked.contains("#[Job, Every(5min)] fn prune"), "fmt must combine a bare stack into one marker list:\n{stacked}")
    stacked_twice := format_source(stacked).expect("canonical marker list should parse")
    assert_eq(stacked, stacked_twice, "marker-list rewrite must be stable")
}
