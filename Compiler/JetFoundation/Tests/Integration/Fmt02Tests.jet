// Rust: tests/fmt.rs:3522
#Test("fmt_preserves_parse_pattern") {
    src := "fn run() {{\n    ticket :: \"inc-42-open\"\n    if ticket == {{\n        \"inc-{{id:Int}}-{{status}}\" -> {{ print(\"incident #{{id}} {{status}}\") }}\n        else -> {{\n            print(\"not an incident id\")\n        }}\n    }}\n}}\n"
    assert_fmt_keeps(src, ["\"inc-{{id:Int}}-{{status}}\"", "print(\"incident #{{id}} {{status}}\")"], "str-match pattern arm (untyped + typed hole)")
}
// Rust: tests/fmt.rs:3550
#Test("fmt_preserves_checked_text_type") {
    src := "enum TextError {{ Empty }}\n\nPattern :: distinct String\n\nimpl Pattern.CheckedText {{\n    type Error = TextError\n\n    fn check(text: String) -[]> Err! {{\n        if text == \"\" {{ return Err(TextError.Empty) }}\n        return Ok(())\n    }}\n\n    fn encode_hole<T: Printable>(value: T) -[]> String {{\n        return \"[{{value}}]\"\n    }}\n}}\n\nfn render(value: Pattern) {{\n    #Unsafe(\"formatter fixture\") {{\n        print(value.raw())\n    }}\n}}\n\nfn run() {{\n    id :: 42\n    value :: Pattern{{\"value {{id}}\"}}\n    render(value)\n}}\n"
    assert_fmt_stable(src, "checked text type")
}
