    assert_eq(out, "fn run() {{\n    if a -> x() else -> y()\n}}\n", "fitting if/else branches should collapse, got:\n{out}")
    twice := format_source(out).expect("collapsed chain should re-fmt")
    assert_eq(out, twice, "collapsed chain must be idempotent")
}
