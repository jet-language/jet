// Rust: tests/fmt.rs:2503
#Test("fmt_keeps_parens_around_binary_receiver") {
    src := "fn run() {{\n    c :: (1 + 2).to_string()\n    d :: (1 + 2) * 3\n    print(c)\n    print(d)\n}}\n"
    out := format_source(src).expect("fmt should succeed")
    assert(out.contains("(1 + 2).to_string()"), "parens around binary method receiver dropped:\n{out}")
    assert(out.contains("(1 + 2) * 3"), "parens around lower-prec binary operand dropped:\n{out}")
    plain := format_source("fn run() {{\n    a :: 1 + 2 * 3\n    print(a)\n}}\n").unwrap()
    assert(plain.contains("a :: 1 + 2 * 3"), "added spurious parens:\n{plain}")
    twice := format_source(out).expect("paren fmt must re-fmt")
    assert_eq(out, twice, "paren fmt must be idempotent")
}
