use jet.[format_source, format_source_with_options]
use jet.Formatter.[FormatOptions]
use jet.Compiler.[parse_source]
use Fmt.[assert_fmt_stable]
use Fmt02.[assert_fmt_keeps]

// Rust: tests/fmt.rs:1790
#Test("fmt_concurrency_spellings_that_parse_today") {
    src := "fn inspect(handle: Task<Int>, group: Group, rx: Receiver<Int>, tx: Sender<Int>) -> TaskFailure {{\n    joined :: handle.join()\n    cancelled :: .Cancelled\n    deadline :: .DeadlineBlown\n    loop value in rx -> tx.send(value)\n    return .Panicked(\"boom\")\n}}\n\nfn open() {{\n    pair :: channel<Int>(capacity: 8)\n    plain :: task {{ 1 }}\n    frozen :: freeze(1)\n    task.group g {{\n        child :: task ^frozen {{ frozen }}\n        child.join() ?? 0\n    }}\n}}\n"
    once := format_source(src).expect("parseable concurrency spellings should format")
    loop spelling in ["Task<Int>", "Group", "Receiver<Int>", "Sender<Int>", "TaskFailure", "handle.join()", ".Cancelled", ".DeadlineBlown", "loop value in rx", ".Panicked(\"boom\")", "channel<Int>(capacity: 8)", "plain :: task {{ 1 }}", "freeze(1)", "task ^frozen"] {
        assert(once.contains(spelling), "fmt dropped {spelling:?}:\n{once}")
    }
    assert_eq(once, format_source(once).expect("concurrency spellings should re-format"))
}
// Rust: tests/fmt.rs:1839
#Test("fmt_shield_block_stability") {
    src := "fn run() {{\n    #Shield {{\n        print(\"committed\")\n    }}\n}}\n"
    expected := "fn run() {{\n    #Shield {{ print(\"committed\") }}\n}}\n"
    out := format_source(src).expect("#Shield block should format")
    assert_eq(out, expected)
    assert_eq(out, format_source(out).expect("collapsed #Shield block should re-format"))
}
// Rust: tests/fmt.rs:1851
#Test("fmt_shield_block_keeps_comment_and_over_width_multiline") {
    commented_src := "fn run() {{\n    #Shield {{\n        // keep this comment\n        print(\"committed\")\n    }}\n}}\n"
    commented_expected := "fn run() {{\n    #Shield {{\n        // keep this comment\n        print(\"committed\")\n    }}\n}}\n"
    commented := format_source(commented_src).expect("commented #Shield block should format")
    assert_eq(commented, commented_expected)
    body := "x".repeat(80)
    wide_src := "fn run() {{\n    #Shield {{\n        print(\"" + body + "\")\n    }}\n}}\n"
    wide_expected := "fn run() {{\n    #Shield {{\n        print(\"" + body + "\")\n    }}\n}}\n"
    wide := format_source(wide_src).expect("over-width #Shield block should format")
    assert_eq(wide, wide_expected)
    assert_eq(wide, format_source(wide).expect("over-width #Shield block should re-format"))
}
