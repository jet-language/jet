// Rust: tests/fmt.rs:1906
#Test("fmt_classic_if_does_not_mix_braced_then_with_arrow_else") {
    source := "fn run() {{\n    if flag {{\n        print(\"then-a\")\n        print(\"then-b\")\n    }} else {{\n        print(\"else-only\")\n    }}\n}}\n"
    once := format_source_with_options(source, FormatOptions{simplify: true}).expect("mixed if/else should format")
    assert(!once.contains("}} else ->"), "braced then-branch must not pair with an arrow else:\n{once}")
    assert(once.contains("}} else {{") || once.contains("else {{"), "else should stay a braced body:\n{once}")
}
// Rust: tests/fmt.rs:1931
#Test("fmt_if_else_chain_collapses_when_every_branch_fits") {
