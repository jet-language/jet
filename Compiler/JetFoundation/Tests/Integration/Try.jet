// Rust: tests/try.rs:1
// D-DEVR-TRY1=A: overlay-first speculative edits and byte-for-byte rollback.
// GATE #4494: native filesystem, process identity and atomic unique scratch names.
use std.fs
use std.env
use std.process
use std.sync.atomic.[AtomicU64, Ordering]

// Rust: tests/try.rs:8
NEXT :: AtomicU64.new(0)
// Rust: tests/try.rs:10
fn jet() -> OSPath { OSPath.from(env.build_var("CARGO_BIN_EXE_jet")) }
// Rust: tests/try.rs:14
fn temp_dir(label: String) -> OSPath {
    dir :: env.temp_dir().join("jet-try-{label}-{process.id()}-{NEXT.fetch_add(1, Ordering.Relaxed)}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir.join("examples")).unwrap()
    dir
}
// Rust: tests/try.rs:25
fn fixture(label: String, replacement: String) -> (OSPath, OSPath, [U8], [U8]) {
    dir :: temp_dir(label)
    source_path :: dir.join("examples/main.jet")
    before :: "fn target() -> {{\n    print(\"one\")\n}}\n\nfn untouched() -> {{\n    print(\"stable\")\n}}\n\nfn run() -> {{\n    target()\n}}\n".bytes().to_vec()
    start :: before.windows(3).position(fn(window) { window == "one".bytes() }).unwrap()
    after := before.clone()
    &after.splice(start..<(start + 3), replacement.bytes())
    fs.write(source_path, before).unwrap()
    plan_path :: dir.join("try.json")
    fs.write(plan_path, "{{\"name\":\"{label}\",\"entry\":\"examples/main.jet\",\"edits\":[{{\"path\":\"examples/main.jet\",\"start\":{start},\"end\":{start + 3},\"new_text\":\"{replacement}\"}}]}}\n").unwrap()
    (dir, plan_path, before, after)
}
