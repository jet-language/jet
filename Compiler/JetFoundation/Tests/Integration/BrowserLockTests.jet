// Rust: tests/build_cache_normalization.rs:335
#Test("profile_sensitive") {
    src :: "fn add(a: Int, b: Int) {\n    print(a + b)\n}\n"
    default :: key_with(src, "default", "v")
    small :: key_with(src, "small", "v")
    release :: key_with(src, "release", "v")
    assert_ne(default, small, "profiles must not share a cache entry")
    assert_ne(default, release)
    assert_ne(small, release)
}
