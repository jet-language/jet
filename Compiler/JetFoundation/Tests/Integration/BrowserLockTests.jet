// Rust: tests/build_cache_normalization.rs:414
#Test("target_dossier_inputs_invalidate_artifact_key") {
    n :: COUNTER.fetch_add(1, Ordering.Relaxed)
    dir :: std.env.temp_dir().join("jet-buildnorm-dossier-{std.process.id()}-{n}")
    fs.create_dir_all(&dir).unwrap()
    file :: dir.join("prog.jet")
    src :: "fn add(a: Int, b: Int) {\n    print(a + b)\n}\n"
    fs.write(&file, src).unwrap()
    bundle :: Loader.load_entry_with_overlay(file.to_str().unwrap(), None, false).unwrap_or_else((d) -> panic("test program should parse:\n{src}\n{d:?}"))
    baseline :: key_with_target_dossier(&bundle, (_) -> {})
    assert_eq(baseline, key_with_target_dossier(&bundle, (_) -> {}), "identical input must keep the artifact key stable")
    assert_changes :: (name, mutate) -> {
        assert_ne(baseline, key_with_target_dossier(&bundle, mutate), "{name} must invalidate the artifact key")
    }
    assert_changes("runtime layer", (dossier) -> { dossier.layer = RuntimeLayer.Core })
    assert_changes("provider digest/identity", (dossier) -> { dossier.provider_identity = "target-providers-v1:sha256:provider-b" })
    assert_changes("Prelude closure", (dossier) -> { dossier.closure_identity = "prelude-hosted-v2:sha256:closure-b" })
    assert_changes("linker", (dossier) -> { dossier.linker_identity = "lld:sha256:linker-b" })
    assert_changes("execution tier", (dossier) -> { dossier.tier_identity = "aot" })
    assert_changes("compiler", (dossier) -> { dossier.compiler_identity = "jet@next" })
    assert_changes("environment", (dossier) -> { dossier.environment_identity = "wasi" })
    assert_changes("dependency graph", (dossier) -> { dossier.dependency_identity = "deps:sha256:dependency-b" })
    assert_ne(baseline, key_with_target_triple(&bundle, "wasm32-unknown-unknown"), "target triple must invalidate the artifact key")
    _ :: fs.remove_dir_all(&dir).ok()
}
// Rust: tests/build_cache_race.rs:29
#Test("concurrent_distinct_sources_sharing_a_stem_do_not_poison_the_cache") {
    // GATE #4494: real concurrent launches with shared native cache/cwd.
    root :: std.env.temp_dir().join("jet-cache-race-{std.process.id()}")
    _ :: fs.remove_dir_all(&root)
    fs.create_dir_all(&root).unwrap()
    cache :: root.join("cache")
    fs.create_dir_all(&cache).unwrap()
    shared_cwd :: root.join("cwd")
    fs.create_dir_all(&shared_cwd).unwrap()
    files := [OSPath]{}
    for i in 0..N {
        dir :: root.join("src{i}")
        fs.create_dir_all(&dir).unwrap()
        f :: dir.join("main.jet")
        fs.write(&f, "fn run() {\n    print(\"prog-{i}\")\n}\n").unwrap()
        files.push(f)
    }
    handles :: files.iter().cloned().map((f) -> {
        cwd :: shared_cwd.clone()
        cache :: cache.clone()
        thread.spawn(() -> Command.new(jet()).arg("run").arg(&f).current_dir(&cwd).env("JET_STORE_DIR", &cache).output().expect("spawn jet run"))
    }).collect()
    for h in handles {
        out :: h.join().expect("thread")
        assert(out.status.success(), "a concurrent `jet run` failed:\nstderr: {String.from_utf8_lossy(&out.stderr)}")
    }
    for (i, f) in files.iter().enumerate() {
        iso :: root.join("verify{i}")
        fs.create_dir_all(&iso).unwrap()
        out :: Command.new(jet()).arg("run").arg(f).current_dir(&iso).env("JET_STORE_DIR", &cache).output().expect("spawn jet run (verify)")
        assert(out.status.success(), "verify run {i} failed:\n{String.from_utf8_lossy(&out.stderr)}")
        stdout :: String.from_utf8_lossy(&out.stdout)
        assert(stdout.contains("prog-{i}"), "cache entry for source {i} returned the wrong binary — expected `prog-{i}`, got: {stdout:?}")
    }
    _ :: fs.remove_dir_all(&root).ok()
}
