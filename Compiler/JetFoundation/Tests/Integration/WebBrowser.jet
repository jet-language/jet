// Rust: tests/web_browser.rs:21
const NEST_P001_FORM: String = #include_str("tests/fixtures/nest_p001_form.jet")
// Rust: tests/web_browser.rs:22
const NEST_P001_INPUT_SHA256: String = "e5c1707a9ab751897c662ece76a9047622a999c58eb56b4d03c853101f74deca"

// Rust: tests/web_browser.rs:25
fn assert_nest_p001_form_stages() -> {
    assert_eq(NEST_P001_FORM.len(), 298)
    assert_eq(sha256_hex(NEST_P001_FORM.as_bytes()), NEST_P001_INPUT_SHA256)
    scratch :: Scratch.new("nest-p001-form")
    fs.write(scratch.join("run.jet"), NEST_P001_FORM).expect("write NEST-P001 fixture")
    fs.write(scratch.join("package.jet"), "name: \"nest-p001\"\nversion: \"0.1.0\"\nedition: \"2026\"\nauthority: {\n    holds: {\n        allow: [IO, Mem.Alloc, Panic]\n    }\n}\n").expect("write NEST-P001 authority")
    stages: [(String, [String])] = [
        ("default", ["run", "run.jet"]),
        ("interpreter", ["run", "--interpret", "run.jet"]),
        ("profile-debug", ["run", "--profile=debug", "run.jet"])
    ]
    for (stage, args) in stages {
        output :: Command.new(jet_bin()).current_dir(&scratch.path).args(args).env("NO_COLOR", "1").output().unwrap_or_else(fn(error) { panic("run NEST-P001 {stage} stage: {error}") })
        stdout :: String.from_utf8_lossy(&output.stdout)
        stderr :: String.from_utf8_lossy(&output.stderr)
        assert(output.status.success(), "NEST-P001 {stage} stage failed:\nstdout:\n{stdout}\nstderr:\n{stderr}")
        assert(stdout.contains("name=Ada"), "NEST-P001 {stage} stage did not execute the typed field:\n{stdout}")
        assert(stdout.contains("<form method=\"post\" action=\"/actions/save\" aria-busy=\"false\">"), "NEST-P001 {stage} stage lost the generated form action:\n{stdout}")
        assert(stdout.contains("<input name=\"name\" id=\"Input-name\" type=\"text\" aria-label=\"name\" aria-invalid=\"false\" required value=\"Ada\">"), "NEST-P001 {stage} stage lost the generated typed field:\n{stdout}")
        assert(stdout.contains("<button type=\"submit\">Submit</button>"), "NEST-P001 {stage} stage lost the generated submit control:\n{stdout}")
        combined :: "{stdout}{stderr}"
        assert(!combined.contains("source bytes 0..0") && !combined.contains("selected entry is not a top-level function"), "NEST-P001 {stage} stage regressed to the old source-less lowering ICE:\n{combined}")
    }
}

