}
// Rust: tests/ownership.rs:5464
#Test("returned_view_paths_form_a_safe_source_union") {
    src :: "fn choose(left: [Int], right: [Int], first: Bool) -[]> View<Int> {{\n    if first {{ return left[0..1] }}\n    return right[0..1]\n}}\nfn run() {{\n    left := [7, 8]\n    right := [9, 10]\n    print(choose(left, right, true)[0])\n    print(choose(left, right, false)[0])\n}}\n"
    out :: jet.compile(src).expect("both compatible parameter owners form one source union")
    assert(out.rust.contains("__jet_left: &'__jet___view Vec<i64>") && out.rust.contains("__jet_right: &'__jet___view Vec<i64>") && out.rust.contains("-> JetOutcome<&'__jet___view [i64], JetErr>"), out.rust)
}
// Rust: tests/ownership.rs:5491
#Test("borrowed_parameter_binding_never_inserts_hidden_copy") {
    src :: "fn bind_again(text: String) {{\n    alias :: text\n    print(alias)\n}}\nfn run() {{ bind_again(\"hello\") }}\n"
    diags :: jet.compile(src).expect_err("borrowed parameter binding must need explicit ownership")
    escape :: diags.iter().find(diag -> diag.code == "E0120").expect("borrowed binding must report E0120 instead of cloning")
    assert(escape.fix.contains("~text"), "fix must name explicit copy: {escape:?}")
}
// Rust: tests/ownership.rs:5515
#Test("ownership_copy_edit_grade_tracks_cloneability") {
    safe_src :: "#Policy(copies: .Explicit)\nstruct Holder {{ value: String }}\nfn wrap(value: String) -> Holder {{ return Holder{{value: value}} }}\nfn run() {{ print(0) }}\n"
    safe_diags :: jet.compile(safe_src).expect_err("explicit copy policy must report E0120")
    safe :: safe_diags.iter().find(diagnostic -> diagnostic.code == "E0120").expect("safe E0120")
    assert_eq(safe.applicability, Some(FixApplicability.Safe))
    assert_eq(safe.safety, Some(FixSafety.BehaviorPreserving))
    safe_edit :: safe.edit.as_ref().expect("safe E0120 must carry an edit")
    assert_eq(safe_edit.new_text, "~")
    assert_eq(safe_src[safe_edit.span.start..safe_edit.span.end], "")
    safe_fixed :: jet.LSP.apply_edit(safe_src, safe_edit)
    assert(jet.compile(safe_fixed).is_ok(), "the safe `~` edit must clear the E0120 report: {safe_fixed}")
    suggested_src :: "struct Holder {{ value: fn(Int) -> Int }}\nfn wrap(value: fn(Int) -> Int) -> Holder {{ return Holder{{value: value}} }}\nfn run() {{ print(0) }}\n"
    suggested_diags :: jet.compile(suggested_src).expect_err("non-cloneable copy must report E0120")
    suggested :: suggested_diags.iter().find(diagnostic -> diagnostic.code == "E0120").expect("suggested E0120")
    assert(suggested.edit.is_none(), "a non-cloneable E0120 must not offer a `~` edit")
    assert(jet.LSP.fixes_from_diagnostics(suggested_diags.clone()).is_empty())
}
// Rust: tests/ownership.rs:5577
#Test("ownership_copy_edit_wraps_the_whole_place") {
    src :: "#Policy(copies: .Explicit)\nstruct Inner {{ name: String? }}\nstruct Outer {{ inner: Inner\n    names: [String?] }}\nfn first_name(outer: Outer) -> String {{\n    picked :: outer.inner.name ?? return \"\"\n    picked\n}}\nfn indexed(outer: Outer) -> String {{\n    picked :: outer.names[0] ?? return \"\"\n    picked\n}}\nfn run() {{ print(0) }}\n"
    diags :: jet.compile(src).expect_err("borrowed subplaces must report E0120")
    fixed := src.to_string()
    edits := diags.iter().filter(diagnostic -> diagnostic.code == "E0120").map(diagnostic -> diagnostic.edit.clone().expect("a cloneable E0120 must carry the `~` edit")).collect()
    assert_eq(edits.len(), 2)
    edits.sort_by_key(edit -> std.cmp.Reverse(edit.span.start))
    loop edit in edits {
        assert_eq(edit.new_text, "~")
        fixed = jet.LSP.apply_edit(fixed, edit)
    }
    assert(fixed.contains("picked :: ~outer.inner.name ?? return"), fixed)
    assert(fixed.contains("picked :: ~outer.names[0] ?? return"), fixed)
    assert(jet.compile(fixed).is_ok(), "the `~` edits must clear the E0120 reports: {fixed}")
}
// Rust: tests/ownership.rs:5628
#Test("core_string_view_copy_edit_names_consuming_expression") {
    src :: #IncludeText("../../../../tests/ui/core_string_view_reuse_after_json.jet")
    diags :: jet.compile(src).expect_err("explicit-copy Core boundary must report E2307")
    diagnostic :: diags.iter().find(diagnostic -> diagnostic.code == "E2307").expect("the Core string-view refusal must be present")
    assert_eq(diagnostic.applicability, Some(FixApplicability.Safe))
    assert_eq(diagnostic.safety, Some(FixSafety.BehaviorPreserving))
    edit :: diagnostic.edit.as_ref().expect("the named Core expression must carry a structured copy edit")
    assert_eq(edit.new_text, "~")
    assert_eq(src[edit.span.start..edit.span.end], "")
    diagnostic_span :: diagnostic.span.expect("the Core expression must be highlighted")
    assert_eq(edit.span.start, diagnostic_span.start)
    assert_eq(src[diagnostic_span.start..diagnostic_span.end], "view")
    fixed :: jet.LSP.apply_edit(src, edit)
    assert(jet.compile(fixed).is_ok(), "applying the named Core copy edit must clear the report: {fixed}")
    expected :: "alue\n\"value\"\n"
    if Common.have_rustc() {
        (code, stdout, stderr) :: Common.build_and_run("jet_string_view_core_reuse", "core_reuse", fixed)
        assert_eq(code, 0, "AOT witness failed: {stderr}")
        assert_eq(stdout, expected, "AOT witness output drift")
    }
    root :: Common.unique_tmp("jet_string_view_core_reuse_default")
    // GATE #4494: actual filesystem and default CLI execution.
    fs.create_dir_all(root).unwrap()
    path :: root.join("main.jet")
    fs.write(path, fixed).unwrap()
    output :: Command.new(env.var("JET_BIN").unwrap()).args(["run", path.to_str().unwrap()]).current_dir(root).output().expect("run the fixed Core witness through the default tier")
    assert(output.status.success(), "default witness failed:\n{String.from_utf8_lossy(output.stderr)}")
    assert_eq(String.from_utf8(output.stdout).unwrap(), expected)
}
// Rust: tests/ownership.rs:5702
#Test("generic_borrowed_parameter_materializes_an_owned_return") {
    src :: "fn identity<T>(value: T) -[]> T {{ return value }}\nfn run() {{ print(0) }}\n"
    out :: jet.compile(src).expect("a cloneable read parameter materializes at an owned return")
    assert(out.rust.contains("pub fn __jet_identity<T: Clone>(__jet_value: &T) -> JetOutcome<T, JetErr> {{"), "the escape must be paid for in the signature, not laundered: {out.rust}")
    assert(out.rust.contains("return Ok(((*__jet_value)).clone());"), "the owned return must copy through the borrow, never move out of it: {out.rust}")
    assert(!out.rust.contains("__jet_value: T"), "the parameter must stay a read borrow, not become an owned slot: {out.rust}")
}
// Rust: tests/ownership.rs:5742
#Test("every_unmarked_nonscalar_parameter_has_read_borrow_rust_shape") {
    src :: """
struct Parcel {{ label: String }}
impl Parcel {{
    fn show(self) {{ print(self.label) }}
}}
fn read_text(text: String) {{ if true {{ print(text) }} }}
fn read_list(values: [Int]) {{ print(values.len()) }}
fn read_parcel(parcel: Parcel) {{ parcel.show() }}
fn read_generic<T>(value: T) {{ print(0) }}
fn apply(f: fn(Int) -> Int, value: Int) -[]> Int {{ return f(value) }}
fn run() {{
    text :: "hello"
    values :: [1, 2, 3]
    parcel :: Parcel{{ label: "parcel" }}
    read_text(text)
    read_list(values)
    read_parcel(parcel)
    read_generic(text)
    print(apply((n: Int) -> (n + 1), 41))
}}
"""
    out :: jet.compile(src).expect("all plain parameters are read borrows")
    assert(out.rust.contains("__jet_text: &String"), out.rust)
    assert(out.rust.contains("__jet_values: &Vec<i64>"), out.rust)
    assert(out.rust.contains("__jet_parcel: &__jet_Parcel"), out.rust)
    assert(out.rust.contains("__jet_value: &T"), out.rust)
    assert(out.rust.contains("__jet_f: &std::rc::Rc<dyn Fn"), out.rust)
    assert(out.rust.contains("pub fn __jet_read_generic<T>(__jet_value: &T)"), "a read-only generic parameter must stay bound-free: {out.rust}")
    assert(!out.rust.contains("((*__jet_text)).clone()"), out.rust)
}
// Rust: tests/ownership.rs:5823
#Test("function_value_calls_preserve_plain_parameter_read_borrows") {
    src :: "fn inspect(value: String) -[]> Int {{ return value.len() }}\nfn apply(f: fn(String) -> Int, value: String) -[]> Int {{ return f(value) }}\nfn run() {{ print(apply(inspect, \"hello\")) }}\n"
    out :: jet.compile(src).expect("function-value call must preserve read access")
    assert(out.rust.contains("__jet_f: &std::rc::Rc<dyn Fn(&String)"), "the function value must arrive as a read borrow: {out.rust}")
    assert(out.rust.contains("__jet_value: &String"), out.rust)
    assert(out.rust.contains("((*__jet_f))(&((*__jet_value)))"), out.rust)
    assert(!out.rust.contains("((*__jet_value)).clone()"), out.rust)
}
