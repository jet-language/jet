// Rust: tests/ownership.rs:6160
#Test("function_value_call_rejects_move_and_tracks_aliases_per_call") {
    moved :: "fn inspect(value: String) {{ print(value) }}\nfn run() {{\n    callback :: inspect\n    value :: \"hello\"\n    callback(^value)\n}}\n"
    diags :: jet.compile(moved).expect_err("read callback must reject explicit move")
    assert(diags.iter().any(d -> d.code == "E0203"), "{diags:?}")
    aliased :: "fn both(a: String, b: String) {{\n    print(a)\n    print(b)\n}}\nfn run() {{\n    callback :: both\n    value := \"hello\"\n    callback(&value, value)\n}}\n"
    aliases :: jet.compile(aliased).expect_err("callback arguments must preserve alias rules")
    assert_eq(aliases.iter().filter(d -> d.code == "E0204").count(), 1, "alias state must stay within this call and flow across its arguments: {aliases:?}")
}
