// Rust: tests/ownership.rs:6351
#Test("stored_lambda_materializes_a_read_view_capture") {
    src :: "fn store(text: String) -[..E]> fn() -> String -[..E]> {{\n    domain :: text.after(\"@\")\n    return () -> domain\n}}\nfn run() {{\n    callback :: store(\"nate@jet-lang.dev\")\n    print(callback())\n}}\n"
    compiled :: jet.compile(src).expect("stored read-view capture must become owning")
    assert(compiled.rust.contains("jet_string_view_copy"), compiled.rust)
    if Common.have_rustc() {
        (code, stdout, stderr) :: Common.build_and_run("jet_stored_view_capture", "whole_root", src)
        assert_eq(code, 0, stderr)
        assert_eq(stdout, "jet-lang.dev\n")
    }
}
// Rust: tests/ownership.rs:6377
#Test("owning_collection_elements_materialize_read_views_without_expected_type") {
    src :: "fn collect(text: String) -[]> [String] {{\n    domain :: text.after(\"@\")\n    values :: [domain]\n    return values\n}}\nfn run() {{ print(collect(\"nate@jet-lang.dev\")[0]) }}\n"
    compiled :: jet.compile(src).expect("an owning collection element must materialize")
    assert(compiled.rust.contains("jet_string_view_copy"), compiled.rust)
}
// Rust: tests/ownership.rs:6397
#Test("borrowed_parameter_can_feed_stored_lambda_after_explicit_copy") {
    src :: "fn store(text: String) {{\n    owned :: ~text\n    callback :: () -> owned.len()\n    print(callback())\n}}\nfn run() {{ store(\"read\") }}\n"
    jet.compile(src).expect("explicitly copied capture should compile")
}
// Rust: tests/ownership.rs:6410
#Test("borrowed_parameter_can_feed_task_after_explicit_copy") {
    src :: "fn launch(text: String) {{\n    owned :: ~text\n    handle :: task owned.len()\n    print(handle.join() ?? 0)\n}}\nfn run() {{ launch(\"read\") }}\n"
    jet.compile(src).expect("explicitly copied task capture should compile")
}
// Rust: tests/ownership.rs:6423
#Test("two_binding_loop_over_owned_task_list_compiles") {
    src :: "fn run() {{\n    handles :: [task 1, task 2]\n    total := 0\n    loop (i, h) in handles {{ total += (h.join() ?? 0) + i }}\n    print(total)\n}}\n"
    jet.compile(src).expect("owned two-binding task loop must compile")
}
// Rust: tests/ownership.rs:6436
#Test("nested_task_list_loop_compiles") {
    src :: "fn run() {{\n    groups :: [[task 1], [task 2]]\n    n := 0\n    loop g in groups {{ n += g.len() }}\n    print(n)\n}}\n"
    jet.compile(src).expect("loop over [[Task]] must compile by value")
}
// Rust: tests/ownership.rs:6449
#Test("mutable_task_list_drain_discharges_linear_duty") {
    src :: "fn run() {{\n    workers := [Task<Int>]{{}}\n    &workers.push(task 1)\n    loop workers.len() > 0 {{\n        worker :: &workers.pop() ?? panic(\"missing worker\")\n        print(worker.join() ?? 0)\n    }}\n}}\n"
    jet.compile(src).expect("a proven pop-to-empty loop must discharge the task-list duty")
}
// Rust: tests/ownership.rs:6464
#Test("task_list_drain_that_reinserts_still_owes_consume") {
    src :: "fn run() {{\n    workers := [Task<Int>]{{}}\n    &workers.push(task 1)\n    loop workers.len() > 0 {{\n        worker :: &workers.pop() ?? panic(\"missing worker\")\n        print(worker.join() ?? 0)\n        &workers.push(task 2)\n    }}\n}}\n"
    diags :: jet.compile(src).expect_err("a drain that reinserts is not proven empty")
    duty :: diags.iter().find(d -> d.code == "E0140").expect("E0140")
    assert(duty.what.contains("workers"), "{duty:?}")
}
// Rust: tests/ownership.rs:6482
#Test("moved_task_list_parameter_loop_compiles") {
    src :: "fn drain(hs: ^[Task<Int>]) -[]> Int {{\n    total := 0\n    loop h in hs {{ total += h.join() ?? 0 }}\n    total\n}}\nfn run() {{\n    handles :: [task 1, task 2]\n    print(drain(^handles))\n}}\n"
    jet.compile(src).expect("moved task-list parameter loop must compile")
}
// Rust: tests/ownership.rs:6498
#Test("two_binding_borrowed_task_list_reports_e0120") {
    src :: "fn drain(hs: [Task<Int>]) -[]> Int {{\n    total := 0\n    loop (i, h) in hs {{ total += (h.join() ?? 0) + i }}\n    total\n}}\nfn run() {{\n    handles :: [task 1]\n    print(drain(handles))\n}}\n"
    diags :: jet.compile(src).expect_err("borrowed two-binding task loop needs ^")
    assert(diags.iter().any(d -> d.code == "E0120"), "{diags:?}")
}
// Rust: tests/ownership.rs:6515
#Test("task_list_index_loop_reports_e0120") {
    src :: "fn run() {{\n    groups :: [[task 1]]\n    total := 0\n    loop h in groups[0] {{ total += h.join() ?? 0 }}\n    print(total)\n}}\n"
    diags :: jet.compile(src).expect_err("index projection cannot be consumed by value")
    escape :: diags.iter().find(d -> d.code == "E0120").expect("E0120")
    assert(escape.what.contains("field or index"), "must not rewrite the root as the list: {escape:?}")
    assert(!escape.fix.contains("groups: ^"), "must not suggest taking the outer list as [Task]: {escape:?}")
}
// Rust: tests/ownership.rs:6537
#Test("stream_reuse_after_loop_reports_e0121") {
    src :: "fn count(n: Int) -[]> Stream<Int> {{\n    i := 0\n    loop i < n {{\n        yield i\n        i += 1\n    }}\n}}\nfn run() {{\n    s :: count(3)\n    loop x in s {{ print(\"{{x}}\") }}\n    loop x in s {{ print(\"{{x}}\") }}\n}}\n"
    diags :: jet.compile(src).expect_err("Stream is consumed by the first loop")
    assert(diags.iter().any(d -> d.code == "E0121"), "{diags:?}")
}
// Rust: tests/ownership.rs:6560
#Test("lone_write_borrow_matches_on_jit_and_aot") {
    cases :: [
        ("local_add", "struct P {{ position: Int }}\nfn run() {{\n  ps := [P{{ position: 10 }}, P{{ position: 20 }}]\n  a :: &ps[0]\n  a.position += 2\n  print(ps[0].position)\n}}\n", "12\n"),
        ("local_field", "struct P {{ position: Int }}\nfn run() {{\n  ps := [P{{ position: 1 }}, P{{ position: 2 }}]\n  a :: &ps[0]\n  a.position = 42\n  print(ps[0].position)\n}}\n", "42\n"),
        ("through_param", "struct P {{ position: Int }}\nstruct W {{ ps: [P] }}\nfn bump(w: &W) {{\n  a :: &w.ps[0]\n  a.position = 42\n}}\nfn run() {{\n  w := W{{ ps: [P{{ position: 1 }}] }}\n  bump(&w)\n  print(w.ps[0].position)\n}}\n", "42\n"),
        ("nested_index", "fn run() {{\n  grid := [[1, 2], [3, 4]]\n  a :: &grid[0][1]\n  a = 42\n  print(grid[0][1])\n}}\n", "42\n")
    ]
    loop (name, source, expected) in cases {
        out :: jet.compile(source).unwrap_or_else(diags -> panic("{name} must compile for AOT emit: {diags:?}"))
        if name == "nested_index" {
            assert(out.rust.contains("jet_index_vec_mut"), "{name} must borrow the live inner list, not a clone: {out.rust}")
            assert(out.rust.contains("let __jet___place_plan_0_root = &mut ((*jet_index_vec_mut("), "{name} split-view root must use jet_index_vec_mut: {out.rust}")
        }
        root :: Common.unique_tmp("jet_lone_write_{name}")
        fs.create_dir_all(root).unwrap()
        path :: root.join("main.jet")
        fs.write(path, source).unwrap()
        loop release in [false, true] {
            cmd := Command.new(env.var("JET_BIN").unwrap())
            cmd.arg("run")
            if release { cmd.arg("--release") }
            cmd.arg(path.to_str().unwrap()).current_dir(root)
            output :: cmd.output().unwrap_or_else(err -> panic("jet run failed to spawn for {name}: {err}"))
            assert(output.status.success(), "{name} release={release} failed:\n{String.from_utf8_lossy(output.stderr)}")
            assert_eq(String.from_utf8_lossy(output.stdout), expected, "{name} release={release}")
        }
    }
}
// Rust: tests/ownership.rs:6663
#Test("declared_trait_from_allows_dyn_view_return_on_jit") {
    dir :: env.temp_dir().join("jet_view_from_trait_dyn_{std.process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir).unwrap()
    path :: dir.join("main.jet")
    // ONE-arrow owner ruling: the head method has a braced value body.
    fs.write(path, "trait Slice {{\n    fn head(self) -[]> View<Int> from self\n}}\nstruct Packet {{ data: [Int] }}\nimpl Packet.Slice {{\n    fn head(self) -> View<Int> from self {{ self.data[0..1] }}\n}}\nfn first(s: Slice) -[..E]> View<Int> from s {{ return s.head() }}\nfn run() {{\n    boxed :: [Slice]{{Packet{{ data: [9, 8, 7] }}}}\n    print(first(boxed[0])[0])\n}}\n").unwrap()
    output :: Command.new(env.var("JET_BIN").unwrap()).arg("run").arg(path).output().expect("jet run")
    code :: output.status.code().unwrap_or(1)
    stdout :: String.from_utf8_lossy(output.stdout).to_string()
    stderr :: String.from_utf8_lossy(output.stderr).to_string()
    assert_eq(code, 0, stderr)
    assert_eq(stdout, "9\n", stderr)
}
// Rust: tests/ownership.rs:6713
#Test("undeclared_view_callback_freezes_every_non_scalar_argument") {
    src :: "fn pick_first(line: String, noise: String) -[]> View<str> {{\n    text :: line.before(\":\")\n    return text\n}}\nfn apply(f: fn(String, String) -> View<str>, a: String, b: String) -[]> View<str> {{ return f(a, b) }}\nfn run() {{\n    a := \"hello:x\"\n    b := \"world\"\n    result :: apply(pick_first, a, b)\n    b = \"mutated\"\n    print(result)\n}}\n"
    diags :: jet.compile(src).expect_err("wide callback must freeze noise owner")
    assert(diags.iter().any(d -> d.code == "E0212"), "expected E0212, got {diags:?}")
    assert(diags.iter().all(d -> d.code != "E2307"), "fixture itself must typecheck: {diags:?}")
}
// Rust: tests/ownership.rs:6746
#Test("declared_view_callback_from_freezes_only_named_source") {
    src :: "fn pick_first(line: String, noise: String) -[]> View<str> {{\n    text :: line.before(\":\")\n    return text\n}}\nfn apply(f: fn(line: String, noise: String) -> View<str> from line, a: String, b: String) -[]> View<str> {{ return f(a, b) }}\nfn run() {{\n    a := \"hello:x\"\n    b := \"world\"\n    result :: apply(pick_first, a, b)\n    b = \"mutated\"\n    print(result)\n}}\n"
    jet.compile(src).expect("narrow from-clause must leave noise free")
}
