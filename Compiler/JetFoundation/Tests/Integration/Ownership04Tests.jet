use std.[fs, env]
use std.process.Command
use jet
use jet.Diagnostics.[FixApplicability, FixSafety]
use jet_foundation.Tests.Integration.Common

// Rust: tests/ownership.rs:5399
#Test("aggregate_view_slot_composes_through_parameter_projection") {
    src :: "struct Pair {{ left: View<Int>, right: View<Int> }}\nfn pair(left: [Int], right: [Int]) -[]> Pair {{\n    left_view :: left[0..1]\n    right_view :: right[0..1]\n    return Pair{{ left: left_view, right: right_view }}\n}}\nfn first(pair: Pair) -[]> View<Int> {{ return pair.left }}\nfn run() {{\n    left := [7, 8]\n    right := [9, 10]\n    result :: pair(left, right)\n    selected :: first(result)\n    &left.push(11)\n    print(selected[0])\n}}\n"
    diags :: jet.compile(src).expect_err("the projected left slot must retain its original owner")
    assert(diags.iter().any(diag -> diag.code == "E0212"), "{diags:?}")
}
// Rust: tests/ownership.rs:5428
#Test("returned_view_aggregate_cannot_cross_task_boundary") {
    src :: "struct Window {{ values: View<Int> }}\nfn window(values: [Int]) -[]> Window {{\n    selected :: values[0..1]\n    return Window{{ values: selected }}\n}}\nfn run() {{\n    handle :: task window([7, 8])\n    print((handle.join() ?? Window{{ values: [] }}).values[0])\n}}\n"
    diags :: jet.compile(src).expect_err("view aggregates are not task-sendable")
    assert(diags.iter().any(d -> d.code == "E1102"), "{diags:?}")
}
