    assert(out.rust.contains("__jet_values: &'__jet___view Vec<i64>) -> JetOutcome<&'__jet___view [i64], JetErr>"), "the wrapper's returned window must be tied to its list parameter: {out.rust}")
    assert(!out.rust.contains("dyn for<'__jet___view>"), "the callback binder must not shadow the enclosing view lifetime: {out.rust}")
}
