// Rust: tests/build_entry.rs:159
#Test("root_fn_build_executes_graph_materializes_and_frontend_checks_generated_source") {
    root :: project("vertical")
    fs.create_dir_all(root.join("build")).unwrap()
    fs.write(root.join("build/legacy-output"), "preserve").unwrap()
    fs.create_dir_all(root.join(".jet-build")).unwrap()
    fs.write(root.join(".jet-build/legacy-output"), "preserve").unwrap()
    fs.create_dir_all(root.join("src/.jet")).unwrap()
    fs.write(root.join("src/.jet/legacy-output"), "preserve").unwrap()
    entry :: root.join("main.jet")
    write(&entry, """
fn build(b: BuildContext) -[Exec, FS]> BuildPlan {
    b.generate("generated_message") {
        fn generated_message() -> String { return "built" }
    }
    #Impure("write declared build output") {
        stamp :: b.action(
            "stamp", [], [".jet/generated/app/stamp.txt"],
            ["sh", "-c", "printf stamped > .jet/generated/app/stamp.txt"], ["Exec", "FS"]
        )
        app :: b.add_executable("app", ["main.jet", ".jet/generated/main/generated_message.jet"], [stamp])
        return b.plan(app)
    }
    return b.plan()
}
fn run() -> { print("ok") }
""")
    first :: compile_bundle_path_build(entry.to_str().unwrap(), opts()).unwrap()
    build :: first.build.expect("root fn build should run")
    assert_eq(build.plan.targets()[0].name, "app")
    assert_eq(build.plan.actions()[0].name, "stamp")
    assert_eq(build.execution.metrics.actions_total, 1)
    assert(match build.execution.events.last() {
        Some(BuildExecutionEvent.Finished{outcome: ActionOutcome.Succeeded{exit_code: 0}, ..}) -> true,
        Some(BuildExecutionEvent.Finished{outcome: ActionOutcome.RestoredFromCache, ..}) -> true,
        _ -> false
    })
    assert_eq(fs.read_to_string(root.join(".jet/generated/app/stamp.txt")).unwrap(), "stamped")
    assert_eq(fs.read_to_string(root.join("build/legacy-output")).unwrap(), "preserve")
    assert_eq(fs.read_to_string(root.join(".jet-build/legacy-output")).unwrap(), "preserve")
    assert_eq(fs.read_to_string(root.join("src/.jet/legacy-output")).unwrap(), "preserve")
    assert_eq(fs.read_dir(root.join("build")).unwrap().count(), 1, "build/ must not receive compiler-owned history debris")
    assert_eq(fs.read_dir(root.join(".jet-build")).unwrap().count(), 1, ".jet-build/ must remain an untouched legacy namespace")
    assert_eq(fs.read_dir(root.join("src/.jet")).unwrap().count(), 1, "per-input .jet/ must remain an untouched legacy namespace")
    generated :: &build.generated[0]
    assert_eq(generated.name, "generated_message")
    assert(generated.path.exists())
    assert(generated.digest.as_str().starts_with("sha256:"))
    lock :: fs.read_to_string(root.join(".jet/lock")).unwrap()
    assert(lock.contains(".jet/generated/main/generated_message.jet"))
    assert(lock.contains(generated.digest.as_str()))
    assert(first.compile.rust.contains("fn main"))
    assert(first.compile.rust.contains("generated_message"))
    second :: compile_bundle_path_build(entry.to_str().unwrap(), opts()).unwrap()
    warm :: second.build.unwrap()
    assert(warm.execution.events.iter().any(fn(event) -> match event {
        BuildExecutionEvent.Finished{outcome: ActionOutcome.RestoredFromCache, ..} -> true,
        _ -> false
    }))
    stamp :: warm.plan.actions().iter().find(fn(action) -> action.name == "stamp").expect("stamp action remains in the build plan")
    rebuilt :: warm.plan.why_rebuilt(warm.plan.action_handle(stamp.id).unwrap(), ActionCacheStatus.Hit(CacheHitReason.LocalActionRecordMatched)).unwrap()
    assert_eq(rebuilt.status, ActionCacheStatus.Hit(CacheHitReason.LocalActionRecordMatched))
    assert_eq(rebuilt.reason, "local action record matched")
    explain :: Command.new(env.bin_exe("jet")).args(["inspect", "explain-build", "stamp", entry.to_str().unwrap(), "--json"]).output().expect("jet inspect explain-build")
    assert(explain.status.success(), "explain-build failed: {String.from_utf8_lossy(&explain.stderr)}")
    assert(String.from_utf8_lossy(&explain.stdout).contains("\"label\":\"stamp\""), "explain-build action query must expose the action label: {String.from_utf8_lossy(&explain.stdout)}")
}

// Rust: tests/build_entry.rs:299
#Test("package_manifest_build_entry_uses_the_same_pipeline_as_a_file_entry") {
    root :: project("package-entry")
    write(&root.join("package.jet"), """
name: "package-entry"
version: "0.1.0"
fn build(b: BuildContext) -> BuildPlan {
    b.generate("package_message") {
        fn package_message() -> String { "package" }
    }
    app :: b.add_executable("app", ["main.jet", ".jet/generated/package-entry/package_message.jet"], [])
    return b.plan(app)
}
""")
    entry :: root.join("main.jet")
    write(&entry, "fn run() -> { print(package_message()) }\n")
    output :: compile_bundle_path_build(entry.to_str().unwrap(), opts()).unwrap()
    build :: output.build.expect("package.jet fn build should be selected")
    assert_eq(build.plan.targets()[0].name, "app")
    assert_eq(build.generated.len(), 1)
    assert(output.compile.rust.contains("package_message"))
}

// Rust: tests/build_entry.rs:329
#Test("multi_dependency_build_restores_semantic_noop_compiler_artifact") {
    (root, dep_b_source) :: multi_dependency_fixture("package-artifact-restore")
    entry :: root.join("main.jet")
    first :: compile_bundle_path_build(entry.to_str().unwrap(), opts()).unwrap()
    first_build :: first.build.expect("first dependency build should run")
    compiler_actions :: first_build.plan.actions().iter().filter(fn(action) -> action.is_compiler_owned()).collect()
    assert_eq(compiler_actions.len(), 3, "root plus two dependencies")
    assert_eq(first_build.execution.metrics.cache_restored_actions, 0)
    assert_eq(first_build.execution.events.iter().filter(fn(event) -> match event {
        BuildExecutionEvent.Finished{action, outcome: ActionOutcome.Succeeded{..}} -> first_build.plan.action_handle(action).and_then(fn(handle) -> first_build.plan.action(handle)).is_some_and(fn(a) -> a.is_compiler_owned()),
        _ -> false
    }).count(), 3)
    // A comment-only edit is not package source meaning; all artifacts remain cacheable.
    write(&dep_b_source, "// semantic no-op\npub fn value() -> Int { return 2 }\n")
    second :: compile_bundle_path_build(entry.to_str().unwrap(), opts()).unwrap()
    second_build :: second.build.expect("warm dependency build should run")
    assert_eq(second_build.execution.metrics.cache_restored_actions, 3)
    assert_eq(second_build.execution.events.iter().filter(fn(event) -> match event {
        BuildExecutionEvent.Finished{action, outcome: ActionOutcome.RestoredFromCache} -> second_build.plan.action_handle(action).and_then(fn(handle) -> second_build.plan.action(handle)).is_some_and(fn(a) -> a.is_compiler_owned()),
        _ -> false
    }).count(), 3)
    assert(!second_build.execution.events.iter().any(fn(event) -> match event {
        BuildExecutionEvent.Finished{action, outcome: ActionOutcome.Succeeded{..}} -> second_build.plan.action_handle(action).and_then(fn(handle) -> second_build.plan.action(handle)).is_some_and(fn(a) -> a.is_compiler_owned()),
        _ -> false
    }))
    loop action in second_build.plan.actions().iter().filter(fn(action) -> action.is_compiler_owned()) {
        assert(root.join(action.outputs[0].as_str()).is_file())
    }
}

// Rust: tests/build_entry.rs:400
#Test("enum_dependency_change_invalidates_compiler_package_chain") {
    root :: project("enum-package-invalidation")
    fixture_marker :: root.file_name().expect("fixture root has a name").to_string_lossy().replace('-', "_")
    producer :: root.join("deps/producer")
    consumer :: root.join("deps/consumer")
    fs.create_dir_all(&producer).unwrap()
    fs.create_dir_all(&consumer).unwrap()
    write(&root.join("package.jet"), "name: \"enum-package-invalidation\"\nversion: \"0.1.0\"\ndeps: { producer: ./deps/producer, consumer: ./deps/consumer }\n")
    write(&producer.join("package.jet"), "name: \"producer\"\nversion: \"0.1.0\"\n")
    write(&consumer.join("package.jet"), "name: \"consumer\"\nversion: \"0.1.0\"\n")
    producer_source :: producer.join("producer.jet")
    producer_fixture :: """
#Layout(c, tag: U8)
pub enum Packet {
    Ping(value: Int) = 3
}
pub fn make() -> Packet { return Packet.Ping{value: 7} }
pub fn seed__MARKER__() -> Int { return 0 }
""".replace("__MARKER__", fixture_marker)
    write(&producer_source, producer_fixture)
    write(&consumer.join("consumer.jet"), """
use producer
pub fn inspect(value: producer.Packet) -> Int { return 7 }
""")
    entry :: root.join("main.jet")
    write(&entry, """
use producer
use consumer
fn build(b: BuildContext) -> BuildPlan {
    app :: b.add_executable("app", ["main.jet"], [])
    return b.plan(app)
}
fn run() -> { print(consumer.inspect(producer.make())) }
""")
    // Rust: tests/build_entry.rs:468
    source_identity :: fn(build: &BuildRun, package: String) -> build.plan.actions().iter().find(fn(action) -> action.name == "compile-package:{package}").and_then(fn(action) -> action.labels.get("compiler.source-digest")).cloned().unwrap_or_else(fn() -> panic("missing compiler source identity for {package}"))
    first :: compile_bundle_path_build(entry.to_str().unwrap(), opts()).unwrap()
    first_build :: first.build.as_ref().expect("cold enum dependency build should expose execution")
    assert_eq(first_build.plan.actions().iter().filter(fn(action) -> action.is_compiler_owned()).count(), 3, "root, producer, and consumer compiler actions should be planned")
    assert_eq(first_build.execution.metrics.cache_restored_actions, 0)
    first_producer_source :: source_identity(first_build, "producer")
    first_consumer_source :: source_identity(first_build, "consumer")
    first_rust :: &first.compile.rust
    assert(first_rust.contains("Packet"))
    changed_fixture :: """
#Layout(c, tag: U8)
pub enum Packet {
    Ping(value: Int, extra: Int) = 9
    Pong(value: Int) = 11
}
pub fn make() -> Packet { return Packet.Ping{value: 7, extra: 1} }
pub fn seed__MARKER__() -> Int { return 0 }
""".replace("__MARKER__", fixture_marker)
    write(&producer_source, changed_fixture)
    second :: compile_bundle_path_build(entry.to_str().unwrap(), opts()).unwrap()
    second_build :: second.build.as_ref().expect("incremental enum dependency build should expose execution")
    assert_eq(second_build.execution.metrics.cache_restored_actions, 0, "producer enum changes must invalidate producer and every dependent compiler action")
    loop action in second_build.plan.actions().iter().filter(fn(action) -> action.is_compiler_owned()) {
        assert(second_build.execution.events.iter().any(fn(event) -> match event {
            BuildExecutionEvent.Finished{action: finished, outcome: ActionOutcome.Succeeded{..}} -> finished == action.id,
            _ -> false
        }), "{action.name} must rebuild successfully after the producer enum changes")
        assert(!second_build.execution.events.iter().any(fn(event) -> match event {
            BuildExecutionEvent.Finished{action: finished, outcome: ActionOutcome.RestoredFromCache} -> finished == action.id,
            _ -> false
        }), "{action.name} must not be restored from stale cache state")
    }
    second_producer_source :: source_identity(second_build, "producer")
    second_consumer_source :: source_identity(second_build, "consumer")
    assert_ne(first_producer_source, second_producer_source, "producer case/code/payload changes must change its source identity")
    assert_eq(first_consumer_source, second_consumer_source, "consumer source identity stays stable while its dependency changes")
    assert_ne(first_rust, second.compile.rust, "compiled output must reflect the changed enum shape")
    assert(second.compile.rust.contains("Pong"), "compiled output must contain the added producer enum case")
    changed_source :: fs.read_to_string(&producer_source).expect("read changed producer source")
    compatible_source :: "{changed_source}\n// compatible source-only edit: enum codes must remain stable\n"
    write(&producer_source, compatible_source)
    third :: compile_bundle_path_build(entry.to_str().unwrap(), opts()).unwrap()
    // Rust: tests/build_entry.rs:580
    enum_fragments :: fn(rust: String) -> rust.lines().filter(fn(line) -> line.contains("Ping") || line.contains("Pong")).map(fn(line) -> line.to_string()).collect()
    assert_eq(enum_fragments(second.compile.rust), enum_fragments(third.compile.rust), "a compatible source-only edit must preserve generated enum codes")
    eprintln("enum invalidation: producer_source={first_producer_source} -> {second_producer_source}, consumer_source={first_consumer_source} -> {second_consumer_source}, cold_restored={first_build.execution.metrics.cache_restored_actions}, incremental_restored={second_build.execution.metrics.cache_restored_actions}, output_changed=true")
}

// Rust: tests/build_entry.rs:603
#Test("warm_dependency_cache_still_runs_frontend_diagnostics") {
    (root, dep_b_source) :: multi_dependency_fixture("malformed-dependent-warm-cache")
    entry :: root.join("main.jet")
    _ :: compile_bundle_path_build(entry.to_str().unwrap(), opts()).unwrap()
    artifact :: root.join(".jet/package-artifacts/dep_b.sealed")
    assert(artifact.is_file(), "first build must seal dep_b")
    fs.remove_file(&artifact).unwrap()
    write(&dep_b_source, "pub fn value() -> Int { return 2\n")
    errors :: compile_bundle_path_build(entry.to_str().unwrap(), opts()).unwrap_err()
    assert(!errors.is_empty())
    assert(errors.iter().all(fn(diagnostic) -> diagnostic.code != "ICE"))
    assert(errors.iter().any(fn(diagnostic) -> diagnostic.code.starts_with('E')))
    assert(!artifact.exists(), "front-end diagnostics must stop before cache restore or compiler codegen")
    fs.remove_dir_all(root).unwrap()
}

// Rust: tests/build_entry.rs:626
#Test("compiler_self_speed_reports_clean_and_incremental_medians") {
    (root, dep_b_source) :: multi_dependency_fixture("compiler-self-speed")
    entry :: root.join("main.jet")
    clean := [U128]{}
    loop sample in 0..3 {
        write(&dep_b_source, "// clean sample {sample}\npub fn value() -> Int {{ return 2 }}\n")
        _ :: fs.remove_dir_all(root.join(".jet/package-artifacts"))
        start :: Instant.now()
        output :: compile_bundle_path_build(entry.to_str().unwrap(), opts()).unwrap()
        build :: output.build.expect("clean build should expose execution")
        assert_eq(build.execution.metrics.cache_restored_actions, 0)
        clean.push(start.elapsed().as_micros())
    }
    incremental := [U128]{}
    loop _ in 0..3 {
        start :: Instant.now()
        output :: compile_bundle_path_build(entry.to_str().unwrap(), opts()).unwrap()
        build :: output.build.expect("incremental build should expose execution")
        assert_eq(build.execution.metrics.cache_restored_actions, 3)
        incremental.push(start.elapsed().as_micros())
    }
    clean_median :: median_micros(&clean)
    incremental_median :: median_micros(&incremental)
    eprintln("compiler self-speed: clean_median_us={clean_median} incremental_median_us={incremental_median} clean_restored_actions=0 incremental_restored_actions=3 samples=3")
    assert(clean_median > 0)
    assert(incremental_median > 0)
    assert(incremental_median <= clean_median, "incremental median exceeded clean median: clean={clean_median}us incremental={incremental_median}us")
    fs.remove_dir_all(root).unwrap()
}

// Rust: tests/build_entry.rs:668
#Test("compiler_speed_explain_build_reports_release_nodes") {
    root :: project("compiler-speed-explain-build")
    entry :: root.join("main.jet")
    write(&entry, "fn run() -> { print(\"timing\") }\n")
    output :: Command.new(env.bin_exe("jet")).args(["build", "--release", "main.jet"]).current_dir(&root).env("JET_STORE_DIR", root.join("store")).env("NO_COLOR", "1").output().expect("run optimized compiler-speed build")
    assert(output.status.success(), "release build failed: {String.from_utf8_lossy(&output.stdout)}\n{String.from_utf8_lossy(&output.stderr)}")
    explanation :: Command.new(env.bin_exe("jet")).args(["inspect", "explain-build", "main.jet", "--json"]).current_dir(&root).env("JET_STORE_DIR", root.join("store")).env("NO_COLOR", "1").output().expect("read release build explanation")
    assert(explanation.status.success(), "explain-build failed: {String.from_utf8_lossy(&explanation.stdout)}\n{String.from_utf8_lossy(&explanation.stderr)}")
    report :: String.from_utf8_lossy(&explanation.stdout)
    assert(report.contains("\"schema\":\"jet.explain-build/v1\""))
    assert(report.contains("\"program\":\"main.jet\""))
    assert(report.contains("\"nodes\":["))
    assert(root.join(".jet/build/main").is_file())
    fs.remove_dir_all(root).unwrap()
}

// Rust: tests/build_entry.rs:709
#Test("release_build_and_default_run_preserve_typed_empty_list_type") {
    scratch :: Scratch.new("typed-empty-list-release")
