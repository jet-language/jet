// Rust: tests/build_entry.rs:1557
#Test("production_build_bridge_imports_only_the_canonical_legacy_project_file") {
    root :: project("legacy-import")
    entry :: root.join("main.jet")
    write(&root.join("Cargo.toml"), "[package]\nname = \"legacy-import\"\n")
    write(&entry, """
fn build(b: BuildContext) -[Exec, FS]> BuildPlan {
    #Impure("invoke one explicitly imported legacy project file") {
        tc :: b.toolchain("native", "x86_64-linux")
        identity :: b.signing("builder", "ci")
        imported :: b.legacy(
            "cargo", "cargo", ["Cargo.toml"], ["target/debug/legacy-import"],
            ["cargo", "build", "--bin", "legacy-import"], ["Exec", "FS"],
            tc, [], identity, "generic", [], [], [], [], [], "cached", "Cargo.toml"
        )
        app :: b.add_executable("app", ["main.jet"], [imported])
        return b.plan(app)
    }
    return b.plan()
}
fn run() -> {}
""")
    errors :: compile_bundle_path_build(entry.to_str().unwrap(), ci_opts()).unwrap_err()
    assert(errors.iter().any(fn(diagnostic) -> diagnostic.what.contains("legacy build wrappers are disabled in CI")), "{errors.debug()}")
}

// Rust: tests/build_entry.rs:1609
#Test("production_legacy_import_uses_project_contents_for_the_typed_action") {
    root :: project("legacy-content")
    entry :: root.join("main.jet")
    write(&root.join("Cargo.toml"), "[package]\nname = \"legacy-content\"\nversion = \"1.2.3\"\n\n[[bin]]\nname = \"cli\"\n")
    write(&entry, """
fn build(b: BuildContext) -[Exec, FS]> BuildPlan {
    #Impure("inspect the canonical Cargo import") {
        tc :: b.toolchain("native", "x86_64-linux")
        identity :: b.signing("builder", "ci")
        imported :: b.legacy(
            "cargo", "cargo-import", ["Cargo.toml"], ["target/debug/cli"],
            ["cargo", "build", "--bin", "cli"], ["Exec", "FS"],
            tc, [], identity, "generic", [], [], [], [], [], "cached", "Cargo.toml"
        )
        app :: b.add_executable("app", ["main.jet"], [imported])
        return b.plan(app)
    }
    return b.plan()
}
fn run() -> {}
""")
    output :: compile_bundle_path_build(entry.to_str().unwrap(), inspect_opts()).unwrap()
    build :: output.build.expect("legacy import should produce a build plan")
    action :: build.plan.actions().iter().find(fn(action) -> action.name == "cargo-import").expect("imported action")
    assert_eq(action.argv, ["cargo", "build", "--bin", "cli"])
    assert_eq(action.inputs.iter().map(fn(path) -> path.as_str()).collect(), ["Cargo.toml"])
    assert_eq(action.outputs.iter().map(fn(path) -> path.as_str()).collect(), ["target/debug/cli"])
    assert_eq(action.labels.get("legacy.version").map(fn(value) -> value.as_str()), Some("1.2.3"))
    assert_eq(action.labels.get("legacy.target").map(fn(value) -> value.as_str()), None)
}

// Rust: tests/build_entry.rs:1686
#Test("production_legacy_import_rejects_unsupported_project_constructs") {
    root :: project("legacy-unsupported")
    entry :: root.join("main.jet")
    write(&root.join("CMakeLists.txt"), "add_custom_command(OUTPUT generated COMMAND sh -c \"touch generated\")\n")
    write(&entry, """
fn build(b: BuildContext) -[Exec, FS]> BuildPlan {
    #Impure("reject unsupported CMake import") {
        tc :: b.toolchain("native", "x86_64-linux")
        identity :: b.signing("builder", "ci")
        imported :: b.legacy(
            "cmake", "cmake-import", ["CMakeLists.txt"], ["build/app"],
            ["cmake", "--build", "build"], ["Exec", "FS"],
            tc, [], identity, "generic", [], [], [], [], [], "cached", "CMakeLists.txt"
        )
        app :: b.add_executable("app", ["main.jet"], [imported])
        return b.plan(app)
    }
    return b.plan()
}
fn run() -> {}
""")
    errors :: compile_bundle_path_build(entry.to_str().unwrap(), inspect_opts()).unwrap_err()
    assert(errors.iter().any(fn(diagnostic) -> diagnostic.what.contains("unsupported construct") && diagnostic.what.contains("add_custom_command")), "{errors.debug()}")
}

// Rust: tests/build_entry.rs:1739
#Test("workspace_build_runs_members_in_dependency_order_then_its_own_plan") {
    root :: project("workspace-entry")
    packages :: root.join("packages")
    fs.create_dir_all(packages.join("a")).unwrap()
    fs.create_dir_all(packages.join("b")).unwrap()
    write(&root.join("workspace.jet"), """
module workspace {
    members: ["./packages/a", "./packages/b"]
}
fn build(b: BuildContext) -> BuildPlan {
    app :: b.add_executable("workspace", ["workspace.jet"], [])
    return b.plan(app)
}
fn run() -> {}
""")
    write(&packages.join("a").join("package.jet"), """
name: "a"
version: "0.1.0"
fn build(b: BuildContext) -> BuildPlan {
    b.generate("a_generated") {
        fn a_generated() -> String { "a" }
    }
    target :: b.add_library("a", ["run.jet", ".jet/generated/a/a_generated.jet"], [])
    return b.plan(target)
}
""")
    write(&packages.join("a").join("run.jet"), "fn run() -> {}\n")
    write(&packages.join("b").join("package.jet"), "name: \"b\"\nversion: \"0.1.0\"\ndeps: { a: ../a }\n")
    write(&packages.join("b").join("run.jet"), "fn build(b: BuildContext) -> BuildPlan {\n    b.generate(\"b_generated\") {\n        fn b_generated() -> String { \"b\" }\n    }\n    target :: b.add_library(\"b\", [\"run.jet\", \".jet/generated/b/b_generated.jet\"], [])\n    return b.plan(target)\n}\nfn run() -> {}\n")
    output :: compile_programmable_build_opts(root.join("workspace.jet").to_str().unwrap(), &[], false, GateSet.allow(PolicyKey.Impure), false, false, false, None).expect("workspace and member build entries should share the Driver pipeline")
    assert(root.join("packages/a/.jet/generated/a/a_generated.jet").is_file())
    assert(root.join("packages/b/.jet/generated/b/b_generated.jet").is_file())
    assert(output.rust.contains("workspace"))
}
