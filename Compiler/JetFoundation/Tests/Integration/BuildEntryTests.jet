    assert(build.status.success(), "release build failed:\nstdout: {String.from_utf8_lossy(&build.stdout)}\nstderr: {String.from_utf8_lossy(&build.stderr)}")
    aot :: Command.new(scratch.join(".jet/build/main")).current_dir(&scratch.path).output().expect("run typed empty-list AOT binary")
    assert(aot.status.success(), "AOT binary failed:\nstdout: {String.from_utf8_lossy(&aot.stdout)}\nstderr: {String.from_utf8_lossy(&aot.stderr)}")
    aot_text := String.from_utf8_lossy(&aot.stdout).trim() // #4303
    assert_eq(aot_text, "0")
    interpreted :: Command.new(env.bin_exe("jet")).args(["run", "main.jet"]).current_dir(&scratch.path).env("JET_STORE_DIR", scratch.join("store")).env("JET_RUN_CACHE_DIR", scratch.join("run-cache")).env("NO_COLOR", "1").output().expect("run typed empty-list default run")
    assert(interpreted.status.success(), "default run failed:\nstdout: {String.from_utf8_lossy(&interpreted.stdout)}\nstderr: {String.from_utf8_lossy(&interpreted.stderr)}")
    interpreted_text := String.from_utf8_lossy(&interpreted.stdout).trim() // #4303
    assert_eq(interpreted_text, "0")
}

// Rust: tests/build_entry.rs:768
#Test("two_builds_from_two_paths_are_byte_identical") {
    left :: Scratch.new("determinism-left")
    right :: Scratch.new("determinism-right")
    copy_determinism_fixture(&left)
    copy_determinism_fixture(&right)
    // Rust: tests/build_entry.rs:774
    build :: fn(scratch: &Scratch) -> Command.new(env.bin_exe("jet")).args(["build", "main.jet"]).current_dir(&scratch.path).env("JET_STORE_DIR", scratch.join("store")).env("JET_RUN_CACHE_DIR", scratch.join("run-cache")).env("NO_COLOR", "1").output().expect("run determinism build")
    loop (name, output) in [("left", build(&left)), ("right", build(&right))] {
        assert(output.status.success(), "{name} determinism build failed:\nstdout: {String.from_utf8_lossy(&output.stdout)}\nstderr: {String.from_utf8_lossy(&output.stderr)}")
    }
    left_binary :: fs.read(left.join(".jet/build/main")).unwrap()
    right_binary :: fs.read(right.join(".jet/build/main")).unwrap()
    assert_eq(sha256_hex(&left_binary), sha256_hex(&right_binary), "native binary SHA-256 changed with checkout path")
    assert_eq(left_binary, right_binary, "native binary changed with checkout path")
    left_log :: normalized_build_log(&left.path, &left.join("store"), "main.jet")
    right_log :: normalized_build_log(&right.path, &right.join("store"), "main.jet")
    assert(!left_log.is_empty(), "build must publish its store log")
    assert_eq(left_log, right_log, "build store logs differ beyond checkout paths")
}

// Rust: tests/build_entry.rs:815
// #3953: deleted dev executable restores the exact cached image and runs.
#Test("dev_build_restores_a_deleted_executable_from_its_cached_image") {
    scratch :: Scratch.new("dev-image-restore")
    write(&scratch.join("main.jet"), "fn run() -> { print(\"image-restore\") }\n")
    // Rust: tests/build_entry.rs:821
    build :: fn() -> {
        output :: Command.new(env.bin_exe("jet")).args(["build", "main.jet"]).current_dir(&scratch.path).env("JET_STORE_DIR", scratch.join("store")).env("JET_RUN_CACHE_DIR", scratch.join("run-cache")).env("NO_COLOR", "1").output().expect("run jet build")
        assert(output.status.success(), "build failed:\nstdout: {String.from_utf8_lossy(&output.stdout)}\nstderr: {String.from_utf8_lossy(&output.stderr)}")
    }
    executable :: scratch.join(".jet/build/main")
    build()
    built :: fs.read(&executable).expect("read built executable")
    fs.remove_file(&executable).expect("delete built executable")
    build()
    assert_eq(fs.read(&executable).expect("read restored executable"), built, "the restored executable differs from the built one")
    run :: Command.new(&executable).output().expect("run restored executable")
    assert(run.status.success(), "restored executable failed: {run.debug()}")
    assert_eq(String.from_utf8_lossy(&run.stdout), "image-restore\n")
}

// Rust: tests/build_entry.rs:858
// #3953: stored compiled functions produce the same executable; twice and double share IR.
#Test("dev_build_from_stored_functions_is_byte_identical") {
    scratch :: Scratch.new("dev-function-cache")
    write(&scratch.join("main.jet"), "fn twice(x: Int) -> Int { x * 2 }\nfn double(x: Int) -> Int { x * 2 }\nfn run() -> { print(twice(3) + double(4)) }\n")
    store :: scratch.join("store")
    // Rust: tests/build_entry.rs:865
    build :: fn() -> {
        output :: Command.new(env.bin_exe("jet")).args(["build", "main.jet"]).current_dir(&scratch.path).env("JET_STORE_DIR", &store).env("JET_RUN_CACHE_DIR", scratch.join("run-cache")).env("NO_COLOR", "1").output().expect("run jet build")
        assert(output.status.success(), "build failed:\nstdout: {String.from_utf8_lossy(&output.stdout)}\nstderr: {String.from_utf8_lossy(&output.stderr)}")
    }
    executable :: scratch.join(".jet/build/main")
    build()
    compiled :: fs.read(&executable).expect("read built executable")
    // Drop executable and all blobs, including cached image; action records remain.
    fs.remove_file(&executable).expect("delete built executable")
    fs.remove_dir_all(store.join("cas")).expect("delete store blobs")
    build()
    assert_eq(fs.read(&executable).expect("read rebuilt executable"), compiled, "the executable built from stored functions differs")
    run :: Command.new(&executable).output().expect("run rebuilt executable")
    assert(run.status.success(), "rebuilt executable failed: {run.debug()}")
    assert_eq(String.from_utf8_lossy(&run.stdout), "14\n")
}

// Rust: tests/build_entry.rs:903
// #2517: typed warning replay and up-to-date receipt skip every Check.
#Test("no_change_build_replays_diagnostics_and_skips_every_check") {
    scratch :: Scratch.new("no-change-receipt")
    write(&scratch.join("main.jet"), "fn helper_one() -> Int { 1 }\nfn helper_two() -> Int { 2 }\nfn run() -> { print(\"receipt\") }\n")
    // Rust: tests/build_entry.rs:909
    build :: fn(store: String, json: Bool) -> {
        command := Command.new(env.bin_exe("jet"))
        command.args(["build", "main.jet"]).current_dir(&scratch.path).env("JET_STORE_DIR", scratch.join(store)).env("JET_RUN_CACHE_DIR", scratch.join("run-cache")).env("NO_COLOR", "1")
        if json { command.arg("--json") }
        output :: command.output().expect("run jet build")
        assert(output.status.success(), "build failed:\nstdout: {String.from_utf8_lossy(&output.stdout)}\nstderr: {String.from_utf8_lossy(&output.stderr)}")
        output
    }
    // Rust: tests/build_entry.rs:929
    warnings :: fn(output: &Output) -> String.from_utf8_lossy(&output.stderr).lines().filter(fn(line) -> line.starts_with("Warning [") || line.trim_start().starts_with("-->")).map(fn(line) -> line.to_string()).collect()
    // Rust: tests/build_entry.rs:936
    checks :: fn(store: String) -> normalized_build_log(&scratch.path, &scratch.join(store), "main.jet").into_iter().filter(fn(row) -> row.0 == "check").map(fn(row) -> (row.2, row.3)).collect()
    fresh :: build("store", false)
    fresh_warnings :: warnings(&fresh)
    assert_eq(fresh_warnings.iter().filter(fn(line) -> line.starts_with("Warning [L0104]")).count(), 2, "{String.from_utf8_lossy(&fresh.stderr)}")
    assert(!String.from_utf8_lossy(&fresh.stderr).contains("up to date: "))
    executed :: checks("store")
    assert(!executed.is_empty() && executed.iter().all(fn(row) -> row.1 != "reused"), "the first build checks every module: {executed.debug()}")
    replayed :: build("store", false)
    assert_eq(warnings(&replayed), fresh_warnings)
    assert_eq(replayed.stdout, fresh.stdout)
    assert(String.from_utf8_lossy(&replayed.stderr).contains("up to date: "), "{String.from_utf8_lossy(&replayed.stderr)}")
    reused :: checks("store")
    assert_eq(reused.len(), executed.len())
    assert(reused.iter().all(fn(row) -> row.1 == "reused"), "an unchanged build executes no Check: {reused.debug()}")
    // Typed records re-render JSON, rather than replay captured bytes.
    fresh_json :: build("store-json", true)
    replayed_json :: build("store", true)
    assert_eq(String.from_utf8_lossy(&replayed_json.stdout), String.from_utf8_lossy(&fresh_json.stdout))
    assert(checks("store").iter().all(fn(row) -> row.1 == "reused"))
}

// Rust: tests/build_entry.rs:995
// #2517 criteria 2/6: recorded checks declare every audited check-time read.
#Test("check_inputs_are_all_declared") {
    scratch :: Scratch.new("check-inputs-declared")
    fs.create_dir_all(scratch.join("assets/inputs/nested")).unwrap()
    write(&scratch.join("assets/motd.txt"), "hello\n")
    fs.write(scratch.join("assets/logo.bin"), [U8]{0x89, 80, 78, 71, 0, 7}).unwrap()
    write(&scratch.join("assets/inputs/alpha.txt"), "alpha\n")
    write(&scratch.join("assets/inputs/nested/beta.txt"), "beta\n")
    corpus :: [
        ("plain.jet", "fn run() -> { print(\"plain\") }\n"),
        ("embed.jet", "MOTD :: prep { embed_file(\"assets/motd.txt\") }\nfn run() -> { print(MOTD) }\n"),
        ("bytes.jet", "LOGO :: prep { embed_bytes(\"assets/logo.bin\") }\nSIZE :: prep { byte_count(LOGO) }\nfn byte_count(bytes: [U8]) -> Int { bytes.len() }\nfn run() -> { print(\"{SIZE}\") }\n"),
        ("find.jet", "PATHS :: prep { find(\"assets/inputs/**/*.txt\") }\nfn run() -> { print(PATHS.join(\"|\")) }\n")
    ]
    loop (name, source) in corpus { write(&scratch.join(name), source) }
    // Rust: tests/build_entry.rs:1020
    check :: fn(program: String, audit: Bool, inject: OSPath?) -> {
        command := Command.new(env.bin_exe("jet"))
        command.args(["check", program]).current_dir(&scratch.path).env("JET_STORE_DIR", scratch.join("store")).env("NO_COLOR", "1").env_remove("JET_CHECK_READS_AUDIT").env_remove("JET_CHECK_READS_INJECT")
        if audit { command.env("JET_CHECK_READS_AUDIT", "1") }
        if inject == Some(path) { command.env("JET_CHECK_READS_INJECT", path) }
        command.output().expect("run jet check")
    }
    // Rust: tests/build_entry.rs:1037
    succeeded :: fn(output: &Output) -> {
        assert(output.status.success(), "check failed:\nstdout: {String.from_utf8_lossy(&output.stdout)}\nstderr: {String.from_utf8_lossy(&output.stderr)}")
    }
    // Rust: tests/build_entry.rs:1045
    checks :: fn(program: String) -> normalized_build_log(&scratch.path, &scratch.join("store"), program).into_iter().filter(fn(row) -> row.0 == "check").map(fn(row) -> row.3).collect()
    loop (program, _) in corpus {
        succeeded(&check(program, false, None))
        fresh :: checks(program)
        assert(!fresh.is_empty() && fresh.iter().all(fn(why) -> why != "reused"), "{program}: {fresh.debug()}")
        // Re-check against the verified record's declared reads and digests.
        succeeded(&check(program, true, None))
        succeeded(&check(program, false, None))
        replayed :: checks(program)
        assert(replayed.iter().all(fn(why) -> why == "reused"), "{program}: {replayed.debug()}")
    }
    injected :: scratch.join("undeclared.txt")
    write(&injected, "not an input of embed.jet\n")
    audit :: check("embed.jet", true, Some(injected))
    assert_eq(audit.status.code(), Some(ICE))
    stderr :: String.from_utf8_lossy(&audit.stderr)
    assert(stderr.contains("check read audit") && stderr.contains("undeclared.txt"), "{stderr}")
    write(&scratch.join("assets/motd.txt"), "changed\n")
    succeeded(&check("embed.jet", false, None))
    rechecked :: checks("embed.jet")
    assert(rechecked.iter().all(fn(why) -> why != "reused"), "a changed embedded input must not replay: {rechecked.debug()}")
    succeeded(&check("embed.jet", false, None))
    replayed :: checks("embed.jet")
    assert(replayed.iter().all(fn(why) -> why == "reused"), "{replayed.debug()}")
}

// Rust: tests/build_entry.rs:1094
// #2517 S1: private-body early cutoff preserves importer; interface edits redden it.
#Test("explain_build_reports_package_reuse_reasons") {
    root :: project("explain-package-reasons")
    dep :: root.join("deps/dep_b")
    fs.create_dir_all(&dep).unwrap()
    write(&root.join("package.jet"), "name: \"app\"\nversion: \"0.1.0\"\ndeps: { dep_b: ./deps/dep_b }\n")
    write(&dep.join("package.jet"), "name: \"dep_b\"\nversion: \"0.1.0\"\n")
    dep_source :: dep.join("dep_b.jet")
    write(&dep_source, "pub fn value() -> Int { return 2 }\n")
    write(&root.join("main.jet"), "use dep_b\n\nfn run() -> { print(dep_b.value()) }\n")
    store :: root.join("store")
    // Rust: tests/build_entry.rs:1107
    check :: fn() -> {
        output :: Command.new(env.bin_exe("jet")).args(["check", "main.jet"]).current_dir(&root).env("JET_STORE_DIR", &store).env("NO_COLOR", "1").output().expect("run jet check")
        assert(output.status.success(), "check failed:\nstdout: {String.from_utf8_lossy(&output.stdout)}\nstderr: {String.from_utf8_lossy(&output.stderr)}")
        normalized_build_log(&root, &store, "main.jet").into_iter().filter(fn(row) -> row.0 == "package").map(fn(row) -> (row.2, row.3)).collect()
    }
    // Rust: tests/build_entry.rs:1127
    reason :: fn(rows: &[(String, String)], needle: String) -> rows.iter().find(fn(row) -> row.0.contains(needle)).map(fn(row) -> row.1).unwrap_or_else(fn() -> panic("no package row for {needle}: {rows.debug()}"))
    first :: check()
    assert(first.len() >= 2, "{first.debug()}")
    assert(first.iter().all(fn(row) -> row.1 == "first-run"), "{first.debug()}")
    write(&dep_source, "pub fn value() -> Int { return 3 }\n")
    body :: check()
    assert_eq(reason(&body, "dep_b"), "red:source+cutoff", "{body.debug()}")
    assert(body.iter().filter(fn(row) -> !row.0.contains("dep_b")).all(fn(row) -> row.1 == "green:key"), "{body.debug()}")
    write(&dep_source, "pub fn value() -> Int { return 3 }\npub fn unused() -> Int { return 4 }\n")
    interface :: check()
    assert_eq(reason(&interface, "dep_b"), "red:source", "{interface.debug()}")
    (_, importer) :: interface.iter().find(fn(row) -> row.0.contains("main.jet") || row.0 == "pkg:.").unwrap_or_else(fn() -> panic("no importer row: {interface.debug()}"))
    assert(importer.starts_with("red:dependency:"), "{interface.debug()}")
    explain :: Command.new(env.bin_exe("jet")).args(["inspect", "explain-build", "main.jet"]).current_dir(&root).env("JET_STORE_DIR", &store).env("NO_COLOR", "1").output().expect("jet inspect explain-build")
    assert(explain.status.success(), "{String.from_utf8_lossy(&explain.stderr)}")
    text :: String.from_utf8_lossy(&explain.stdout)
    assert(text.lines().any(fn(line) -> line.starts_with("package\t") && line.contains("red:dependency:")), "{text}")
}

// Rust: tests/build_entry.rs:1182
// #2517 S2: sealed dependency reuse preserves root effect diagnostics after body edits.
#Test("body_edit_in_root_reuses_dependency_package_record") {
    root :: project("sealed-dependency")
    dep :: root.join("deps/util")
    fs.create_dir_all(&dep).unwrap()
    write(&root.join("package.jet"), "name: \"app\"\nversion: \"0.1.0\"\ndeps: { util: ./deps/util }\n")
    write(&dep.join("package.jet"), "name: \"util\"\nversion: \"0.1.0\"\n")
    write(&dep.join("util.jet"), "pub fn shout(text: String) -> String {\n    print(text)\n    return \"{text}!\"\n}\n\npub fn twice(n: Int) -> Int { return helper(n) + helper(n) }\n\nfn helper(n: Int) -> Int { return n * 2 }\n")
    lib :: root.join("lib.jet")
    // Rust: tests/build_entry.rs:1196
    source :: fn(extra: String) -> "use util\n\npub fn quiet(text: String) -[]> String {{\n    return util.shout(text)\n}}\n\npub fn sum(n: Int) -> Int {{ return util.twice(n) + {extra} }}\n"
    // Rust: tests/build_entry.rs:1201
    check :: fn(store: &OSPath) -> {
        output :: Command.new(env.bin_exe("jet")).args(["check", "lib.jet"]).current_dir(&root).env("JET_STORE_DIR", store).env("NO_COLOR", "1").output().expect("run jet check")
        rows :: normalized_build_log(&root, store, "lib.jet").into_iter().filter(fn(row) -> row.0 == "package").map(fn(row) -> (row.2, row.3)).collect()
        (String.from_utf8_lossy(&output.stderr).into_owned(), rows)
    }
    // Rust: tests/build_entry.rs:1216
    reason :: fn(rows: &[(String, String)], needle: String) -> rows.iter().find(fn(row) -> row.0.contains(needle)).map(fn(row) -> row.1).unwrap_or_else(fn() -> panic("no package row for {needle}: {rows.debug()}"))
    store :: root.join("store")
    write(&lib, source("1"))
    (cold, first) :: check(&store)
    assert(cold.contains("E3401"), "{cold}")
    assert(reason(&first, "util").starts_with("checked+published"), "{first.debug()}")
    write(&lib, source("2"))
    (warm, second) :: check(&store)
    assert(reason(&second, "util").starts_with("reused"), "{second.debug()}")
    (fresh, _) :: check(&root.join("fresh-store"))
    assert_eq(warm, fresh, "a sealed dependency must not change the root's diagnostics")
}

