use jet_foundation.Tests.Integration.BitwiseNot.[SEED]
use jet_foundation.Tests.Integration.TirSupport.[assert_tiers_agree, build_and_run, have_rustc]
// Rust: tests/bitwise_not.rs:18
#Test("bit_not_on_int_is_minus_x_minus_one") {
    if !have_rustc() -> return
    src :: SEED + """
fn check(x: Int) -> {
    print(!x == -x - 1)
}
fn run() -> {
    check(bits(0))
    check(bits(5))
    check(bits(-6))
    check(bits(1000))
    print(!bits(0))
    print(!bits(5))
}
"""
    (code, out) :: build_and_run("bitnot_identity", src)
    assert_eq(code, 0, out)
    assert_eq(out, "true\ntrue\ntrue\ntrue\n-1\n-6\n", out)
}
// Rust: tests/bitwise_not.rs:47
#Test("bit_not_keeps_each_integer_width") {
    if !have_rustc() -> return
    src :: """
fn run() -> {
    a :: U8{5}
    print(!a)
    b :: U16{5}
    print(!b)
    c :: U32{5}
    print(!c)
    d :: I8{5}
    print(!d)
    e :: I16{5}
    print(!e)
    f :: I32{5}
    print(!f)
}
"""
    (code, out) :: build_and_run("bitnot_widths", src)
    assert_eq(code, 0, out)
    assert_eq(out, "250\n65530\n4294967290\n-6\n-6\n-6\n", out)
}
// Rust: tests/bitwise_not.rs:76
#Test("bit_not_clears_the_bits_a_mask_names") {
    if !have_rustc() -> return
    src :: SEED + """
fn run() -> {
    flags :: bits(15)
    print(flags & !bits(4))
    print(flags & !bits(1))
    print(flags & !bits(15))
    print(flags & !bits(0))
}
"""
    (code, out) :: build_and_run("bitnot_mask", src)
    assert_eq(code, 0, out)
    assert_eq(out, "11\n14\n0\n15\n", out)
}
// Rust: tests/bitwise_not.rs:98
#Test("bit_not_on_bool_is_unchanged") {
    if !have_rustc() -> return
    src :: """
fn yes() -> Bool { return true }
fn run() -> {
    print(!true)
    print(!false)
    print(!yes())
}
"""
    (code, out) :: build_and_run("bitnot_bool", src)
    assert_eq(code, 0, out)
    assert_eq(out, "false\ntrue\nfalse\n", out)
}
// Rust: tests/bitwise_not.rs:124
#Test("bit_not_agrees_on_every_tier") {
    src :: SEED + """
fn run() -> {
    print(!bits(0))
    print(!bits(5))
    print(!bits(-6))
    print(!bits(4294967296))
    print(bits(15) & !bits(4))
    print(!true)
    a :: U8{5}
    print(!a)
    b :: I16{5}
    print(!b)
    c :: U32{5}
    print(!c)
}
"""
    assert_tiers_agree("bitnot_tiers", src, "-1\n-6\n5\n-4294967297\n11\nfalse\n250\n-6\n4294967290\n")
}
