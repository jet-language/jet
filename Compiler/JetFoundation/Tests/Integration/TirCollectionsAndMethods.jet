//RS /// String methods: len (char count), to_upper, to_lower, trim, split, starts_with,
//RS /// ends_with, replace, repeat, slice, chars, contains, to_string.
//RS #[test]
//RS fn string_builtin_methods() {
//RS     if !have_rustc() {
//RS         return;
//RS     }
//RS     let src = "\
//RS fn run() {
//RS     s := \"  Hello, World  \"
//RS     t := s.trim()
//RS     print(t.to_upper())
//RS     print(t.to_lower())
//RS     print(t.len())
//RS     print(t.starts_with(\"Hello\"))
//RS     print(t.ends_with(\"World\"))
//RS     print(t.replace(\"World\", \"Jet\"))
//RS     print(\"ab\".repeat(3))
//RS     print(t.contains(\"World\"))
//RS     parts := \"a,b,c\".split(\",\")
//RS     print(parts.len())
