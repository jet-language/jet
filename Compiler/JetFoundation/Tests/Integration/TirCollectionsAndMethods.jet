//RS /// The sema-inserted `.clone()` inside a COVERED function (no `self`): `p.name`
//RS /// is an owning non-`Copy` String field read, which sema rewrites to a
//RS /// `(p.name).clone()` MethodCall. Phases 3–5 excluded this (the getter that moves
//RS /// a field out); Phase 6 covers it, so `name_of` now routes through the TIR.
//RS #[test]
//RS fn covered_fn_returns_cloned_string_field() {
//RS     if !have_rustc() {
//RS         return;
//RS     }
//RS     let src = "\
//RS struct Person {
//RS     name: String
//RS     age: Int
//RS }
//RS fn name_of(p: Person) -[]> String {
//RS     return ~p.name
//RS }
//RS fn run() {
//RS     p :: Person{ name: \"Grace\", age: 40 }
//RS     print(name_of(p))
//RS }
//RS ";
//RS     let (code, stdout) = build_and_run("tir_clone_getter", src);
//RS     assert_eq!(code, 0);
//RS     assert_eq!(stdout, "Grace\n");
//RS }
//RS 
