//RS fn total(xs: [Int]) -[]> Int {
//RS     sum := 0
//RS     loop x in xs {
//RS         sum = (sum + x)
//RS     }
//RS     return sum
//RS }
//RS fn run() {
//RS     nums := [10, 20, 30, 40]
//RS     print(nums[0])
//RS     print(nums[1..2])
//RS     print(total(nums))
//RS }
//RS ";
//RS     let (code, stdout) = build_and_run("tir_list", src);
//RS     assert_eq!(code, 0);
//RS     assert_eq!(stdout, "10\n[20, 30]\n100\n");
