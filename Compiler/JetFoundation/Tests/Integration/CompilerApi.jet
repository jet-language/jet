use std.[fs, env, process]
// GATE #4494: real filesystem and process identity primitives.
// Rust: tests/compiler_api.rs:1193
pub fn fixture_file(name: String, src: String) -> OSPath {
    dir :: env.temp_dir().join("jet_compiler_api_{process.id()}_{name.trim_end_matches(\".jet\")}")
    fs.create_dir_all(&dir).expect("create temp fixture dir")
    path :: dir.join(name)
    fs.write(&path, src).expect("write temp fixture")
    path
}
