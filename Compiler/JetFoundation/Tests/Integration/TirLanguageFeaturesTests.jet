// Rust: tests/tir_language_features.rs:825
#Test("regex_match_group") {
    src :: "use core.regex as re\nfn run() {{\n    text :: \"order 42 shipped\"\n    m :: re.match({{\"(\\d+) shipped\"}}, text)\n    if m == .Val(mat) {{\n        whole :: mat.group(0) ?? \"none\"\n        print(whole)\n    }}\n}}\n"
    dir :: env.temp_dir().join("jet_tir_regex_{process.id()}")
    fs.create_dir_all(&dir).unwrap()
    path :: dir.join("regex.jet")
    fs.write(&path, src).unwrap()
    shown :: path.to_string_lossy().into_owned()
    _ :: jet.compile_with_path(src, shown).expect("front end rejected regex fixture")
    // Actual match/group behavior replaces retired emitter-substring assertions.
    assert_tiers_agree("tir_regex_group", src, "42 shipped\n")
}
