// Rust: tests/tir_language_features.rs:278
#Test("named_args") {
    if !have_rustc() -> return
    src :: """
fn area(width: Int, height: Int) -> Int {{ return (width * height) }}
fn connect(host: String, /, *, timeout seconds: Int{{30}}, tls: Bool{{true}}) -> String {{
    return "{{host}} t={{seconds}} tls={{tls}}"
}}
fn identity<T>(value: T, *, note: String{{"unused"}}) -> T {{ return value }}
fn force(*, force: Bool) -> Int {{ 1 }}
fn apply(action: fn(*, force: Bool) -> Int) -> Int {{ return action(force: true) }}
struct Logger {{ id: Int }}
impl Logger {{
    fn write(self, level: String, parts: ...String) -> String {{ return [level, ...parts].join(" ") }}
}}
fn run() {{
    print(area(width: 4, height: 3))
    print(area(4, height: 3))
    print(connect("db", tls: false, timeout: 5))
    print(connect("db", tls: false))
    print(identity<Int>(note: "generic", value: 7))
    print(apply(force))
    logger :: Logger{{id: 0}}
    print(logger.write(parts: "a", level: "L"))
    print(logger.write("M", "b", "c"))
}}
"""
    (code, stdout) :: build_and_run("tir_named_args", src)
    assert_eq(code, 0)
    assert_eq(stdout, "12\n12\ndb t=5 tls=false\ndb t=30 tls=false\n7\n1\nL a\nM b c\n")
}
// Rust: tests/tir_language_features.rs:325
#Test("named_arg_diagnostic_covers_zero_parameter_calls") {
    src :: "fn nothing() {{}}\nfn run() {{ nothing(value: 1) }}\n"
    diagnostics :: jet.compile(src).expect_err("a label on a zero-parameter call must fail")
    assert(diagnostics.iter().any(fn(diagnostic) { diagnostic.code == "E0764" }), "expected E0764 for a label on a zero-parameter call: {diagnostics:#?}")
}
// Rust: tests/tir_language_features.rs:337
#Test("named_arg_diagnostic_covers_unlabelled_function_values") {
    src :: "fn apply(action: fn(Int) -> Int) -> Int {{ return action(value: 1) }}\nfn run() {{ _ :: apply((value: Int) -> value) }}\n"
    diagnostics :: jet.compile(src).expect_err("an unlabelled function type must reject labels")
    assert(diagnostics.iter().any(fn(diagnostic) { diagnostic.code == "E0764" }), "expected E0764 for a label on an unlabelled function value: {diagnostics:#?}")
}
// Rust: tests/tir_language_features.rs:353
#Test("function_value_arguments_preserve_public_callable_contracts") {
    src :: "fn factory(action: fn(*, force: Bool) -> Int) -> Int {{ return action(force: true) }}\nfn invoke(callback: fn(fn(*, force: Bool) -> Int) -> Int) -> Int {{ return callback(plain) }}\nfn plain(value: Bool) -> Int {{ 1 }}\nfn run() {{ _ :: invoke(factory) }}\n"
    diagnostics :: jet.compile(src).expect_err("a function value with the wrong public label must be rejected")
    assert(diagnostics.iter().any(fn(diagnostic) { diagnostic.code == "E0112" }), "expected E0112 for a callable-contract mismatch: {diagnostics:#?}")
}
// Rust: tests/tir_language_features.rs:369
#Test("unannotated_function_values_do_not_erase_strict_callable_contracts") {
    src :: "fn factory(action: fn(*, force: Bool) -> Int) -> Int {{ return action(force: true) }}\nfn invoke(callback: fn(fn(*, force: Bool) -> Int) -> Int, plain: fn(Bool) -> Int) -> Int {{ return callback(plain) }}\nfn run() {{ _ :: invoke(factory, (value: Bool) -> 1) }}\n"
    diagnostics :: jet.compile(src).expect_err("an unannotated function value must not satisfy a strict callable type")
    assert(diagnostics.iter().any(fn(diagnostic) { diagnostic.code == "E0112" }), "expected E0112 for a missing strict callable contract: {diagnostics:#?}")
}
// Rust: tests/tir_language_features.rs:388
#Test("distinct_types") {
    if !have_rustc() -> return
    src :: """
UserID :: distinct Int
#Numeric Meters :: distinct Float
#UnitFamily(Currency) {{ usd }}
fn greet(id: UserID) -> String {{ return "user {{(id.raw())}}" }}
fn run() {{
    uid :: UserID.from_int(42)
    print(greet(uid))
    a :: Meters.from_float(3.0)
    b :: Meters.from_float(1.5)
    c :: a + b
    print("{{(c.raw())}} m")
    x :: UserID.from_int(7)
    y :: UserID.from_int(7)
    print("{{(x == y)}}")
    from_byte :: UserID.from_u8(8)
    from_float :: UserID.from_float(9.9) ?? UserID.from_int(0)
    print("{{(from_byte.raw())}} {{(from_float.raw())}}")
    meters :: Meters.from_int(3)
    dollars :: Usd.from_int(5)
    print("{{(meters.raw())}} {{(dollars.raw())}}")
}}
"""
    (code, stdout) :: build_and_run("tir_distinct", src)
    assert_eq(code, 0)
    assert_eq(stdout, "user 42\n4.5 m\ntrue\n8 9\n3.0 5.0\n")
}
// Rust: tests/tir_language_features.rs:424
#Test("numeric_distinct_operator_borrows_synthetic_rhs") {
    if !have_rustc() -> return
    src :: "#UnitFamily(Length, base: meter) {{ meter }}\nfn run() {{\n    distance :: 12meter\n    area :: distance * distance\n    print(area)\n}}\n"
    // Preserve operand reuse behavior without depending on the retired Rust emitter.
    (code, stdout) :: build_and_run("tir_numeric_borrow", src)
    assert_eq(code, 0)
    (default_code, default_stdout, _) :: tir_support.jit_run("tir_numeric_borrow", src)
    (interpreter_code, interpreter_stdout, _) :: tir_support.interpreter_run("tir_numeric_borrow", src)
    assert_eq(default_code, code)
    assert_eq(interpreter_code, code)
    assert_eq(default_stdout, stdout)
    assert_eq(interpreter_stdout, stdout)
}
// Rust: tests/tir_language_features.rs:444
#Test("distinct_and_unit_numeric_source_matrix") {
    if !have_rustc() -> return
    src :: """
UserID :: distinct Int
Label :: distinct String
#UnitFamily(Currency) {{ usd }}
fn checked_user(value: U64) -> UserID String! {{ return UserID.from_u64(value) }}
fn pass_user(value: UserID String!) -> UserID String! {{ return ~value }}
fn run() {{
    fallback :: UserID.from_int(0)
    print(UserID.from_i8(-8).raw())
    print(UserID.from_i16(-16).raw())
    print(UserID.from_i32(-32).raw())
    print(UserID.from_int(-64).raw())
    print(UserID.from_u8(8).raw())
    print(UserID.from_u16(16).raw())
    print(UserID.from_u32(32).raw())
    print((pass_user(checked_user(64)) ?? fallback).raw())
    print((UserID.from_f32(3.75) ?? fallback).raw())
    print((UserID.from_float(4.75) ?? fallback).raw())
    print(Usd.from_i8(-8).raw())
    print(Usd.from_i16(-16).raw())
    print(Usd.from_i32(-32).raw())
    print(Usd.from_int(-64).raw())
    print(Usd.from_u8(8).raw())
    print(Usd.from_u16(16).raw())
    print(Usd.from_u32(32).raw())
    print(Usd.from_u64(64).raw())
    print(Usd.from_f32(3.75).raw())
    print(Usd.from_float(4.75).raw())
    label :: Label.from_string("converted")
    print(label.raw())
}}
"""
    (code, stdout) :: build_and_run("tir_distinct_source_matrix", src)
    assert_eq(code, 0)
    assert_eq(stdout, "-8\n-16\n-32\n-64\n8\n16\n32\n64\n3\n4\n-8.0\n-16.0\n-32.0\n-64.0\n8.0\n16.0\n32.0\n64.0\n3.75\n4.75\nconverted\n")
}
// Rust: tests/tir_language_features.rs:495
#Test("range_type_runtime_try_and_spelled_arithmetic_gate") {
    if !have_rustc() -> return
    src :: """
#Numeric Severity :: distinct Int(0..10)
fn checked(raw: Int) -> Severity String! {{ return Ok(Severity.from_int(raw)) }}
fn pass_checked(value: Severity String!) -> Severity String! {{ return ~value }}
fn direct() -> Severity {{ return Severity.from_u8(8) }}
fn run() {{
    a :: pass_checked(checked(4)) ?? panic("range")
    b :: checked(6) ?? panic("range")
    widened :: wrapping(a + b)
    print("{{widened}}")
    print(direct().raw())
}}
"""
    (code, stdout) :: build_and_run("tir_range_type_checked", src)
    assert_eq(code, 0)
    assert_eq(stdout, "10\n8\n")
}
// Rust: tests/tir_language_features.rs:523
#Test("range_type_literal_proofs_cover_every_numeric_source_family") {
    src :: "\n#Numeric Severity :: distinct Int(0..10)\n\nfn run() {{\n    signed :: Severity.from_i8(11)\n    unsigned :: Severity.from_u8(12)\n    narrow_float :: Severity.from_f32(13.0)\n    float :: Severity.from_float(14.0)\n}}\n"
    diagnostics :: jet.compile(src).expect_err("all four literals exceed Severity's range")
    range_errors :: diagnostics.iter().filter(fn(diagnostic) { diagnostic.code == "E0135" }).count()
    assert_eq(range_errors, 4, "diagnostics: {diagnostics:#?}")
}
// Rust: tests/tir_language_features.rs:608
#Test("contract_breach_output_matches_aot_jit_and_interpreter") {
    assert_contract_breach_tiers("contract_pre_failure", "\n#Pre(value > 0, \"positive\") fn checked(value: Int) -> Int {{\n    return value\n}}\n\nfn run() {{\n    print(checked(0))\n}}\n", "Pre", 7)
    assert_contract_breach_tiers("contract_post_failure", "\n#Post(result == 99, \"must equal 99\")\nfn get() -> Int {{\n    return 1\n}}\n\nfn run() {{\n    print(get())\n}}\n", "Post", 2)
}
// Rust: tests/tir_language_features.rs:641
#Test("contract_interval_proof_erases_only_the_runtime_check") {
    unproven :: "\n#Pre(value > 0, \"positive\") fn checked(value: Int) -> Int {{\n    return value\n}}\n\nfn run() {{\n    print(checked(1))\n}}\n"
    proven :: "\n#Numeric Positive :: distinct Int(1..10)\n#Pre(value.raw() > 0, \"positive\") fn checked(value: Positive) -> Int {{\n    return value.raw()\n}}\n\nfn run() {{\n    value :: Positive.from_int(1)\n    print(checked(value))\n}}\n"
    // Canonical behavioral counterparts to the retired generated-Rust check census.
    assert_tiers_agree("contract_unproven", unproven, "1\n")
    assert_tiers_agree("contract_proven", proven, "1\n")
    assert_contract_breach_tiers("contract_unproven_failure", unproven.replace("checked(1)", "checked(0)"), "Pre", 7)
}
