// Rust: tests/tir_language_features.rs:884
#Test("foreign_enum_matching_and_payload") {
    if !have_rustc() -> return
    note :: """
pub enum NoteType {{ User Feedback Project Reference }}
pub struct Note {{
    pub name: String
    pub note_type: NoteType
    pub parent: String?
}}
pub fn make_note(name: ^String, t: ^NoteType) -> Note {{ return Note{{name: name, note_type: t, parent: None}} }}
pub fn kind_str(n: Note) -> String {{
    k :: ~n.note_type
    if k == {{
        .User -> {{ return "user" }}
        .Feedback -> {{ return "feedback" }}
        .Project -> {{ return "project" }}
        .Reference -> {{ return "reference" }}
    }}
}}
fn run() {{ print("note") }}
"""
    entry :: """
use "note"
enum Query {{ Tag(String) Kind(NoteType) }}
fn classify(raw: String) -> Query {{
    if raw == "user" {{ return Query.Kind(NoteType.User) }}
    return Query.Tag(~raw)
}}
fn describe(n: Note, q: ^Query) -> String {{
    if q == {{
        .Tag(t) -> {{ return "tag:{{t}}" }}
        .Kind(k) -> {{ return "kind:{{note.kind_str(n)}}" }}
    }}
}}
fn run() {{
    n :: note.make_note("x", NoteType.User)
    q :: classify("user")
    print(describe(n, ^q))
    q2 :: classify("design")
    print(describe(n, ^q2))
}}
"""
    (code, stdout) :: build_and_run_multi("tir_foreign_enum", "main.jet", &[("main.jet", entry), ("note.jet", note)])
    assert_eq(code, 0)
    assert_eq(stdout, "kind:user\ntag:design\n")
}
// Rust: tests/tir_language_features.rs:953
#Test("result_names_do_not_reserve_user_functions_or_variants") {
    if !have_rustc() -> return
    src :: """
enum Wrapped {{ Val(Int) Ok(Int) Err(Int) }}
fn Ok(value: Int) -> Int {{ return (value + 10) }}
fn Err(value: Int) -> Int {{ return (value + 20) }}
fn run() {{
    print(Ok(1))
    print(Err(2))
    wrapped :: Wrapped.Val(7)
    if wrapped == {{
        .Val(value) -> {{ print(value) }}
        .Ok(value) -> {{ print(value) }}
        .Err(value) -> {{ print(value) }}
    }}
}}
"""
    (code, stdout) :: build_and_run("tir_contextual_result_names", src)
    assert_eq(code, 0)
    assert_eq(stdout, "11\n22\n7\n")
}
