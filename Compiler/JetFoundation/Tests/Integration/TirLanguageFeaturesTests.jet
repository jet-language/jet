#Test("static_new_constructor") {
    if !have_rustc() -> return
    src :: """
struct Rect {{ width: Int, height: Int }}
impl Rect {{
    fn new(width: Int, height: Int) -> Rect {{ return Rect{{width: width, height: height}} }}
    fn area(self) -> Int {{ return (self.width * self.height) }}
}}
fn run() {{
    r :: Rect.new(4, 3)
    print(r.area())
}}
"""
    (code, stdout) :: build_and_run("tir_static_new", src)
    assert_eq(code, 0)
    assert_eq(stdout, "12\n")
}
