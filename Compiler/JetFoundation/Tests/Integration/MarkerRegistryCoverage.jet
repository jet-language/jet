// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! D-VERDICT-1455-1 (law zero): a marker exists if and only if it is a registry
//RS //! row, and every active row must be alive end to end. This walks the registry
//RS //! itself, so a row that nothing can parse — `#Authority` was one — fails here
//RS //! instead of sitting in the table looking implemented.
//RS //!
//RS //! The renderer builds each program from the row's own signature and site list.
//RS //! Nothing in this file names a marker, so a new row is covered the moment it
//RS //! is added and cannot be forgotten.
//RS 
//RS mod common;
//RS 
//RS use jet_foundation::Policy::{self, AppliedRule, RuleArgType, RuleSite, RuleStatus};
//RS use jet_foundation::{Registry, Syntax};
//RS 
//RS /// Sites that describe a position with no source spelling of its own.
//RS /// `Package` is `package.jet` manifest scope, `Impl` and `Operation` are
//RS /// interior positions the writer reaches through some other construct. A row
//RS /// that lives *only* at one of these is reported, not skipped.
//RS fn site_is_source_renderable(site: RuleSite) -> bool {
//RS     !matches!(
//RS         site,
//RS         RuleSite::Package | RuleSite::Impl | RuleSite::Operation | RuleSite::Text
//RS     )
//RS }
