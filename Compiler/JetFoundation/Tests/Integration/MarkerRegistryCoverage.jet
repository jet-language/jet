// Rust: tests/marker_registry_coverage.rs:19
fn site_is_source_renderable(site: RuleSite) -> Bool {
    site != RuleSite.Package && site != RuleSite.Impl && site != RuleSite.Operation && site != RuleSite.Text
}
// Rust: tests/marker_registry_coverage.rs:28
fn placeholder(ty: RuleArgType, source_type: &String) -> String {
    if Some(declaration) = Policy.rule_arg_declaration(source_type) {
        if Some(variant) = declaration.variants.first() { return variant.to_string() }
    }
    match ty {
        RuleArgType.String -> "\"x\"", RuleArgType.Path -> "Path{\"x\"}",
        RuleArgType.Int -> "1", RuleArgType.Bool -> "true", RuleArgType.DurationOrString -> "1s",
        RuleArgType.Ident -> "x", RuleArgType.Any -> "1", RuleArgType.EffectRoots -> "[FS.Write]",
    }
}
// Rust: tests/marker_registry_coverage.rs:47
fn spelling(row: &AppliedRule) -> String {
    if row.name == "Test" { return "#Test(\"coverage\")" }
    if !row.signature.arguments_required() { return "#{row.name}" }
    args := row.signature.params.iter().filter(fn(param) { param.default.is_none() }).map(fn(param) { placeholder(param.ty, param.source_type) }).collect<[String]>()
    if args.is_empty() {
        if Some(ty) = row.signature.variadic {
            if Some(source_type) = row.signature.variadic_source_type { args.push(placeholder(ty, source_type)) }
        }
    }
    if row.name == "Scrub" { args[0] = "X" }
    if row.name == "Undo" { args[0] = "inverse" }
    if row.name == "Short" { args[0] = "\"p\"" }
    if row.name == "Env" { args[0] = "\"PORT\"" }
    if row.name == Syntax.KW_FX { args[0] = "IO" }
    if row.name == "Target" { args[0] = "Web" }
    if row.name == "UnitFamily" { return "#UnitFamily(Length, dimension)" }
    if row.name == "Pre" || row.name == "Post" { args[0] = "true" }
    if row.name == "Every" { return "#[Job, Every({args.join(", ")})]" }
    "#{row.name}({args.join(", ")})"
}
// Rust: tests/marker_registry_coverage.rs:99
fn program_at(marker: &String, row: &AppliedRule, site: RuleSite) -> String? {
    Some(match site {
        RuleSite.File -> if marker.starts_with("#NoPrelude") {
            "#NoPrelude\nuse core.term as io\nfn run() -> {{\n    io.print(\"ok\")\n}}\n"
        } else { "{marker}\nfn run() -> {{\n    print(\"ok\")\n}}\n" },
        RuleSite.Module -> if marker.starts_with("#Bindgen") {
            "{marker} module c.coverage.__bindgen__ {{\n}}\n"
        } else { "{marker} module c.lib {{\n}}\n\nfn run() -> {{\n    print(\"ok\")\n}}\n" },
        RuleSite.Function -> if marker.starts_with("#Scrub") {
            "tag X {{ deny: [IO] }}\n{marker} fn helper(raw: #X String) -[]> String {{ return ~raw }}\n\nfn run() -> {{\n}}\n"
        } else if marker.starts_with("#Undo") {
            "fn inverse() -> {{}}\n#[Unsafe(\"coverage\"), FFI(c), Undo(inverse)]\nfn helper() -> {{\n    \"\"\"void helper(void) {{}}\"\"\"\n}}\n\nfn run() -> {{\n}}\n"
        } else if marker.starts_with("#ABI") {
            "#Import module c.demo {{\n    {marker} fn helper(value: I32) -> I32 = \"helper\"\n}}\n\nfn run() -> {{\n}}\n"
        } else if marker.starts_with("#FFI") {
            "#[Unsafe(\"coverage\"), FFI(c)]\nfn helper() -> {{\n    \"\"\"void helper(void) {{}}\"\"\"\n}}\n\nfn run() -> {{\n}}\n"
        } else if row.name == jet.Syntax.MARKER_MEMO {
            "{marker}\nfn helper() -[]> {{\n}}\n\nfn run() -> {{\n}}\n"
        } else { "{marker}\nfn helper() -> {{\n}}\n\nfn run() -> {{\n}}\n" },
        RuleSite.Method -> "W :: struct {{\n    a: Int\n\n    {marker}\n    fn helper(self) -> {{\n    }}\n}}\n\nfn run() -> {{\n}}\n",
        RuleSite.Type -> if marker.starts_with("#UnitFamily") { "{marker} {{ meter }}\n\nfn run() -> {{\n}}\n" } else { "{marker}\nstruct W {{\n    a: Int\n}}\n\nfn run() -> {{\n}}\n" },
        RuleSite.Field -> if marker.starts_with("#Short") || marker.starts_with("#Env") || marker.starts_with("#Flag") {
            "#CLI\nstruct W {{\n    {marker} a: String\n}}\n\nfn run() -> {{\n}}\n"
        } else { "struct W {{\n    {marker} a: Int\n}}\n\nfn run() -> {{\n}}\n" },
        RuleSite.Variant -> "enum E {{\n    {marker} A\n    B\n}}\n\nfn run() -> {{\n}}\n",
        RuleSite.Block -> "fn run() -> {{\n    {marker} {{\n        print(\"ok\")\n    }}\n}}\n",
        RuleSite.Statement -> "fn run() -> {{\n    {marker} print(\"ok\")\n}}\n",
        RuleSite.Declaration -> if marker.starts_with("#Persist") { "{marker} value := 1\n\nfn run() -> {{\n}}\n" } else { "fn run() -> {{\n    {marker} value :: 1\n}}\n" },
        RuleSite.Constant -> "{marker} VALUE :: prep {{ 1 }}\n\nfn run() -> {{\n}}\n",
        RuleSite.Parameter -> "fn helper({marker} a: Int) -> {{\n}}\n\nfn run() -> {{\n}}\n",
        RuleSite.Expression -> "fn run() -> {{\n    value :: {marker}\n}}\n",
        RuleSite.Test -> "{marker} {{\n    print(\"ok\")\n}}\n\nfn run() -> {{\n}}\n",
        RuleSite.Package -> return None, RuleSite.Impl -> return None,
        RuleSite.Operation -> return None, RuleSite.Text -> return None,
    })
}
// Rust: tests/marker_registry_coverage.rs:162
// GATE #4494: filesystem-backed loader input.
fn sema_diagnostics(source: &String, path: &OSPath) -> [jet.Diagnostics.Diagnostic] {
    if source.contains("#Bindgen") {
        return jet.Driver.compile_generated_src(source, ".jet/bindings/c/coverage.jet", jet.Sema.CompileMode.Check).err().unwrap_or_default()
    }
    fs.write(path, source).expect("write marker coverage source")
    bundle := jet.Loader.load_entry(path.to_str().expect("coverage path")).expect("load marker coverage source")
    jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Check)
}
// Rust: tests/marker_registry_coverage.rs:181
fn rejected_the_marker(source: &String) -> [String] {
    (tokens, lex_diagnostics) :: if source.contains("#Bindgen") { jet.Lexer.lex_generated(source) } else { jet.Lexer.lex(source) }
    if !lex_diagnostics.is_empty() { return lex_diagnostics.into_iter().map(fn(diagnostic) { "{diagnostic.code}: {diagnostic.what}" }).collect() }
    diagnostics :: match jet.Parser.parse_for_check(&tokens) { Ok((_, diagnostics)) -> diagnostics, Err(diagnostics) -> diagnostics }
    diagnostics.into_iter().filter(fn(diagnostic) { diagnostic.code == "E0927" || diagnostic.code == "E0355" }).map(fn(diagnostic) { "{diagnostic.code}: {diagnostic.what}" }).collect()
}
// Rust: tests/marker_registry_coverage.rs:204
fn format_for_coverage(source: &String) -> Result<String, [jet.Diagnostics.Diagnostic]> {
    if source.contains("#Bindgen") {
        (tokens, diagnostics) :: jet.Lexer.lex_generated(source)
        if !diagnostics.is_empty() { return Err(diagnostics) }
        program :: jet.Parser.parse_for_fmt(&tokens)?
        return Ok(jet.Formatter.format_program(&program, source, &jet.Lexer.comments(&tokens)))
    }
    jet.format_source(source)
}
// Rust: tests/marker_registry_coverage.rs:665
fn marker_name_literal_offenders(sources: [(String, String)], marker_names: &[String]) -> [String] {
    offenders := []
    for (path, source) in sources {
        for (line_number, line) in source.lines().enumerate() {
            code :: line.split("//").next().unwrap_or(line)
            names_marker :: ["marker_name", "marker.name", "attr_name", "rule_name", "marker_head"].iter().any(fn(needle) { code.contains(needle) })
            if !names_marker { continue }
            for name in marker_names {
                if code.contains(&"\"{name}\"") { offenders.push("{path}:{line_number + 1} contains marker name `{name}`") }
            }
        }
    }
    offenders
}
// Rust: tests/marker_registry_coverage.rs:698
fn collect_source_files(directory: &OSPath, found: &[OSPath]) -> {
    entries :: match fs.read_dir(directory) { Ok(value) -> value, Err(_) -> return }
    for entry in entries.flatten() {
        path :: entry.path()
        if path.is_dir() { collect_source_files(&path, found) } else if path.extension().is_some_and(fn(extension) { extension == "rs" }) { found.push(^path) }
    }
}
