// Rust: tests/nbody_witness.rs:13
fn assert_fixture_tiers(name: &String, source: &String) -> {
    for tier in ["O0", "O1", "O2", "Web"] {
        (code, stdout, stderr) :: jet_foundation.Tests.Integration.TirSupport.run_tier(name, source, tier)
        assert_eq(code, 0, "{name} {tier} run failed: {stderr}")
        assert_eq(stdout, NBODY_EXPECTED, "{name} {tier} output drifted")
    }
}
