//RS }
//RS ";
//RS     let out = jet::compile(src).expect("should compile");
//RS     // A comptime const is compile-time DATA: sema folds `@pair_value.left`
//RS     // to the projected value (`CheckerInfer/expr.rs::fold_comptime_struct_field`),
