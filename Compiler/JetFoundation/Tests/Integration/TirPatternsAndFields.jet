//RS /// c109 (builtin-name collision): a user method whose name collides with a builtin
//RS /// (`get`/`len`) was mis-dispatched by `emit_builtin_method` (name-keyed, not
//RS /// receiver-typed) → `b.get()` emitted garbage, `b.len()` → E0599. The fix dispatches
//RS /// to the USER method (`__jet_<method>`) when `recv_type == Some(T)` and `(T, method) ∈
//RS /// cx.method_sigs`. `main` and both methods route through the TIR.
//RS #[test]
//RS fn user_method_shadowing_builtin_name() {
//RS     if !have_rustc() {
//RS         return;
//RS     }
//RS     let src = "\
//RS struct Crate {
//RS     items: [Int]
//RS 
//RS     fn get(self) -> Int {
//RS         return 42
//RS     }
//RS     fn len(self) -> Int {
//RS         return 7
//RS     }
//RS }
//RS fn run() {
//RS     b :: Crate{ items: [1, 2, 3] }
//RS     print(b.get())
//RS     print(b.len())
//RS }
//RS ";
//RS     let (code, stdout) = build_and_run("tir_builtin_collision", src);
//RS     assert_eq!(code, 0);
//RS     assert_eq!(stdout, "42\n7\n");
//RS }
//RS 
//RS /// c109 (builtin-name collision, receiver side) — the sibling of the test above.
//RS /// The builtin table is receiver-TYPED, but the receiver-type resolver answered
//RS /// `None` for a struct FIELD read, and a `None` there does not read as "unknown",
//RS /// it reads as "take the List surface". So `entry.relative.replace(a, b)` on a
//RS /// `String` field lowered to `jet_list_replace(&String, String, String)` — which
//RS /// wants `&[T]`, `i64`, `T` — and rustc was handed Jet's own ill-typed output,
//RS /// an internal compiler error by I2 (found by tests/agent_workloads
//RS /// repository-marker-scan). Every name the String and List surfaces share had the
//RS /// same hole, `len` included. The fix reads the field's DECLARED type
//RS /// (`builtin_recv_ty` / `declared_field_ty`, TIR/lower/builtins.rs), so a String
//RS /// field takes the String arm, a list field keeps the index/element arm, and a
//RS /// receiver no table row claims (a bare list literal) keeps the legacy list
//RS /// fallback. All three shapes, and all three tiers, in one snippet.
//RS #[test]
//RS fn builtin_dispatch_reads_the_field_receiver_type() {
//RS     let src = "\
//RS struct ScanEntry {
//RS     relative: String
//RS     marks: [Int]
//RS }
//RS fn run() {
//RS     entry :: ScanEntry{ relative: \"a-b-c\", marks: [1, 2, 1] }
//RS     print(entry.relative.replace(\"-\", \"/\"))
//RS     print(entry.relative.len())
//RS     print(entry.marks.replace(1, 9))
//RS     print([1, 2, 1].replace(1, 9))
//RS }
//RS ";
//RS     assert_tiers_agree(
//RS         "tir_builtin_field_receiver_dispatch",
//RS         src,
//RS         "a/b/c\n5\n[1, 9, 1]\n[1, 9, 1]\n",
//RS     );
//RS }
//RS 
//RS /// c109 (`is_empty` Bool fix): `Collections::*_method_return` typed `is_empty` as
//RS /// `Int`, so `e := xs.is_empty()` emitted `let e: i64 = (…).is_empty()` (bool ≠ i64
//RS /// → rustc E0308) and `if xs.is_empty()` was E0110 at sema. The fix returns `Bool`;
//RS /// `is_empty` is now covered (`TBuiltinOp::IsEmpty`) on list/map/string receivers.
//RS #[test]
//RS fn is_empty_returns_bool() {
//RS     if !have_rustc() {
//RS         return;
//RS     }
//RS     let src = "\
//RS fn check(xs: [Int]) {
//RS     if xs.is_empty() {
//RS         print(\"empty\")
//RS     } else {
//RS         print(\"not empty\")
//RS     }
//RS }
//RS fn run() {
//RS     e :: [1, 2, 3].is_empty()
//RS     print(e)
//RS     m :: [1: 2]
//RS     print(m.is_empty())
//RS     s :: \"hi\"
//RS     print(s.is_empty())
//RS empty :: [Int]{}
//RS     check(empty)
//RS     check([9])
//RS }
//RS ";
//RS     let (code, stdout) = build_and_run("tir_is_empty", src);
//RS     assert_eq!(code, 0);
//RS     assert_eq!(stdout, "false\nfalse\nfalse\nempty\nnot empty\n");
//RS }
//RS 
//RS /// c109 (bare `?? return` fix): `infer_or_fallback`'s logic was inverted — a bare
//RS /// `?? return` (no value) was sema-rejected in a UNIT fn (E0405) and accepted in a
//RS /// NON-unit fn (where rustc then rejected the emitted `return;` → E0069). The fix
//RS /// accepts a bare `?? return` ONLY in a unit fn (`return;` is valid) and rejects it
//RS /// in a value-returning fn. The unit-fn form routes through the TIR
//RS /// (`orfallback_rhs_in_subset → Return(None)`, emitting `None => return`).
//RS #[test]
//RS fn bare_or_return_in_unit_fn() {
//RS     if !have_rustc() {
//RS         return;
//RS     }
//RS     let src = "\
//RS fn f(xs: [Int]) {
//RS     x := xs.first() ?? return
//RS     print(x)
//RS }
//RS fn run() {
//RS     f([10, 20])
//RS empty :: [Int]{}
//RS     f(empty)
//RS     print(99)
//RS }
//RS ";
//RS     let (code, stdout) = build_and_run("tir_bare_or_return", src);
//RS     assert_eq!(code, 0);
//RS     assert_eq!(stdout, "10\n99\n");
//RS }
