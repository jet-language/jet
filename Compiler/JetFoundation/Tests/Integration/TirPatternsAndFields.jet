// TIR pattern, field, and collection-receiver integration tests.
use std.fs as fs

// Rust: tests/tir_patterns_and_fields.rs:17
pub fn assert_function_tier(trace: String, function: String, tier: String) -> {
    assert(trace.lines().any((line) -> line.starts_with(function) && line.contains(tier)), "missing `{function}` {tier} row:\n{trace}")
}

// Rust: tests/tir_patterns_and_fields.rs:26
pub fn assert_no_hard_coded_generated_literals(path: OSPath) -> {
    // GATE #4494: retained filesystem directory and source reads.
    loop result in fs.read_dir(path).expect("read Codegen source directory") {
        entry :: result.expect("read Codegen directory entry")
        child :: entry.path()
        if child.is_dir() {
            assert_no_hard_coded_generated_literals(child)
            next
        }
        if child.extension().and_then((ext) -> ext.to_str()) != Val("rs") { next }
        source :: fs.read_to_string(child).expect("read Codegen source")
        bytes :: source.as_bytes()
        at := 0
        loop at < bytes.len() {
            if bytes[at] != 34 {
                at += 1
                next
            }
            start :: at + 1
            at = start
            escaped := false
            loop at < bytes.len() {
                byte :: bytes[at]
                at += 1
                if escaped { escaped = false }
                else if byte == 92 { escaped = true }
                else if byte == 34 { break }
            }
            literal := source[start..<at.saturating_sub(1)] // #4303
            if literal == "//# __jet_source_map" && child.ends_with("Codegen/mod.rs") { next }
            loop (offset, _) in literal.match_indices("__jet_") {
                if literal.as_bytes().get(offset + "__jet_".as_bytes().len()).is_some_and((byte) -> byte.is_ascii_lowercase()) {
                    panic("hard-coded generated literal in {child.display()}: {literal:Debug}")
                }
            }
        }
    }
}
