//RS /// Local `Bool !Never` calls keep the same Result carrier ABI as imported
//RS /// calls, including a deep scalar branch-dispatch chain. Carrier views must
//RS /// remain carriers so `??` does not unwrap twice.
//RS #[test]
//RS fn local_never_calls_cross_the_result_abi_once() {
//RS     let src = r#"
//RS fn bool_level_10(left: Bool, right: Bool) -> Bool Never! {
//RS     return left == right
//RS }
//RS 
//RS fn bool_level_9(left: Bool, right: Bool) -> Bool Never! {
//RS     return if {
//RS         left -> bool_level_10(left, right)
//RS         else -> bool_level_10(right, left)
//RS     }
//RS }
//RS 
//RS fn bool_level_8(left: Bool, right: Bool) -> Bool Never! {
//RS     return bool_level_9(left, right)
//RS }
//RS 
//RS fn bool_level_7(left: Bool, right: Bool) -> Bool Never! {
//RS     return if {
//RS         right -> bool_level_8(left, right)
//RS         else -> bool_level_8(right, left)
//RS     }
