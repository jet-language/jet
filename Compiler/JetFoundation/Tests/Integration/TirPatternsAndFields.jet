//RS     }
//RS     print(sum(root))
//RS }
//RS ";
//RS     let (code, stdout) = build_and_run("tir_boxed_field_read", src);
//RS     assert_eq!(code, 0);
//RS     assert_eq!(stdout, "6\n");
//RS }
