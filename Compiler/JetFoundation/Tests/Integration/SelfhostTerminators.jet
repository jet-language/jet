PASS_SOURCE :: Lexer.TERMINATOR_PASS_SOURCE
// Rust: tests/selfhost_terminators.rs:15
BOOT_ENTRY :: "\nfn bootstrap_probe(source: [U8], facts: [Int]) -> {\n    print(terminator_events(source, facts).len())\n}\nfn run() -> { bootstrap_probe([U8]{}, [Int]{}) }\n"
// Rust: tests/selfhost_terminators.rs:17
struct Pass { mir: MirProgram; function: MirFunctionId }
// Rust: tests/selfhost_terminators.rs:22
fn lower_bundle(bundle: &ProgramBundle, context: String) -> MirProgram {
    diagnostics :: Sema.check_bundle(&bundle, Sema.CompileMode.Run)
    errors :: diagnostics.filter(fn(row) { row.severity == Severity.Error })
    assert(errors.is_empty(), "{context}: checked terminator fixture: {errors:?}")
    request :: MirArtifactRequest.new(MirArtifactTarget.Cranelift, MirArtifactKind.NativeExecutable, MirArtifactBuildMode.Dev)
    TIR.lower_checked_mir_program_for(bundle, request).unwrap_or_else(fn(error) { panic("{context}: canonical optimized terminator MIR: {error}") }).0
}
// Rust: tests/selfhost_terminators.rs:34
fn bootstrap(context: String, source: String) -> Shared<Pass> {
    assert(Lexer.terminator_driver().is_none(), "bootstrap must precede candidate installation")
    run_compiler_work(fn() {
        scratch :: common.Scratch.new("selfhost_terminator_bootstrap")
        tir_support.write_test_package(scratch.path, tir_support.TIR_TEST_PACKAGE)
        path :: scratch.path.join("terminators.jet")
        fs.write(path, "{source}{BOOT_ENTRY}").unwrap()
        bundle := Loader.load_entry(path.to_str().unwrap()).expect("Rust reference bootstraps the Jet pass")
        mir :: lower_bundle(&bundle, context)
        function :: mir.functions.find(fn(row) { row.name == "terminator_events" }).expect("checked Jet pass entry").id
        Shared.new(Pass{mir: mir, function: function})
    })
}
// Rust: tests/selfhost_terminators.rs:50
PASS :: OnceLock<Shared<Pass>>.new()
fn pass() -> Shared<Pass> { PASS.get_or_init(fn() { bootstrap("canonical terminator pass", PASS_SOURCE) }).clone() }
// Rust: tests/selfhost_terminators.rs:55
fn input_values(source: [U8], facts: [RawTokenFact]) -> [MirValue] Err! {
    bytes := [MirValue]{}
    loop byte in source { &bytes.push(MirValue.Int(I64.from_u8(byte))) }
    rows := [MirValue].with_capacity(facts.len() * 4)
    loop fact in facts {
        &rows.push(MirValue.Int(I64.from_u16(fact.kind)))
        &rows.push(MirValue.Int(I64.try_from(fact.span.start).map_err(fn(error) { error.to_string() })?))
        &rows.push(MirValue.Int(I64.try_from(fact.span.end).map_err(fn(error) { error.to_string() })?))
        &rows.push(MirValue.Int(if fact.uppercase -> 1 else -> 0))
    }
    [MirValue.List(^bytes), MirValue.List(^rows)]
}
// Rust: tests/selfhost_terminators.rs:67
fn decode_events(value: MirValue) -> [TerminatorEvent] Err! {
    carrier := ^value
    if carrier == { .Present(inner) -> carrier = ^inner; else -> {} }
    if carrier == {
        .List(values) -> {
            if values.len() % 3 != 0 { return Err("terminator event carrier has an incomplete row") }
            events := [TerminatorEvent].with_capacity(values.len() / 3)
            index := 0
            loop index < values.len() {
                if (values[index], values[index + 1], values[index + 2]) == {
                    (.Int(kind), .Int(before), .Int(at)) -> {
                        before_index :: Int.try_from(before).map_err(fn(error) { error.to_string() })?
                        at_index :: Int.try_from(at).map_err(fn(error) { error.to_string() })?
                        // Rust usize conversions reject negatives, even on a signed Jet index carrier.
                        if before_index < 0 || at_index < 0 { return Err("out of range integral type conversion attempted") }
                        if kind == {
                            1 -> &events.push(TerminatorEvent.InsertSemi{before: before_index, at: at_index})
                            2 -> &events.push(TerminatorEvent.SplitHeader{before: before_index, at: at_index})
                            else -> return Err("unknown terminator event tag {kind}")
                        }
                    }
                    else -> return Err("terminator event fields must be integers")
                }
                index += 3
            }
            events
        }
        else -> Err("terminator entry returned a non-list carrier: {carrier:?}")
    }
}
// Rust: tests/selfhost_terminators.rs:94
impl Pass {
    fn evaluate(self: &Pass, source: [U8], facts: [RawTokenFact], fuel: U64) -> [TerminatorEvent] Err! {
        args :: input_values(source, facts)?
        config := MirEvalConfig.default()
        config.fuel = Val(fuel)
        result :: evaluate_mir_function_with_config(self.mir, self.function, args, config).map_err(fn(error) { "{error.diagnostic:?}" })?
        if result.status != MirExecutionStatus.Completed || result.exit_code != 0 || !result.stdout.is_empty() || !result.stderr.is_empty() {
            return Err("terminator evaluator did not complete silently and successfully")
        }
        decode_events(^result.value)
    }
    // Rust: tests/selfhost_terminators.rs:108
    fn driver(self: &Shared<Pass>) -> TerminatorDriver {
        compiled :: self.clone()
        Shared.new(fn(source, facts) { compiled.evaluate(source, facts, U64{50000000}) })
    }
}
