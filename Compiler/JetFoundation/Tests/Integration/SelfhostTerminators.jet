// Rust: tests/selfhost_terminators.rs:159
fn float_bits(tokens: [Token], output: &[U64]) -> {
    loop token in tokens {
        if token.kind == {
            .Float(value, _) -> &output.push(value.to_bits())
            .UnitNumber(_, Val(value), _) -> &output.push(value.to_bits())
            .Str(parts) -> {
                loop part in parts { if part == { .Interp(nested) -> float_bits(nested, &output); else -> {} } }
            }
            else -> {}
        }
    }
}
// Rust: tests/selfhost_terminators.rs:176
fn assert_lex_equal(name: String, actual: ([Token], [Diagnostic]), expected: ([Token], [Diagnostic])) -> {
    assert_eq(actual.0, expected.0, "{name}: full token payloads, trees and byte spans")
    actual_bits := [U64]{}
    expected_bits := [U64]{}
    float_bits(actual.0, &actual_bits)
    float_bits(expected.0, &expected_bits)
    assert_eq(actual_bits, expected_bits, "{name}: floating-point payload bits")
    assert_eq("{actual.1:?}", "{expected.1:?}", "{name}: ordered diagnostics")
}
// Rust: tests/selfhost_terminators.rs:256
fn compiler_must_fail(driver: TerminatorDriver, expected: String) -> {
    failure :: catch_unwind(AssertUnwindSafe(fn() {
        Lexer.with_terminator_driver(Val(driver), fn() { _ :: compile("fn run() {}\n") })
    })).expect_err("candidate failure must not succeed through the Rust reference")
    message :: failure.downcast_ref<String>().or_else(fn() { failure.downcast_ref<str>() }).expect("ICE message")
    assert(message.contains("internal compiler error") && message.contains(expected), "{message}")
    assert(Lexer.terminator_driver().is_none(), "failed candidate leaked scoped driver")
}
// Rust: tests/selfhost_terminators.rs:324
fn golden_program() -> (String, String) {
    cases :: [
        ("x", [I64]{1, 1, 1}),
        ("x\n-y", [I64]{1, 3, 4}),
        ("x // c\ny", [I64]{1, 2, 1, 1, 3, 8}),
        ("x\n!y", [I64]{1, 1, 1, 1, 3, 4}),
        ("f()\n{}", [I64]{2, 3, 4}),
        ("x\n.Key && ready\n-> 1", [I64]{1, 5, 15, 1, 7, 20}),
        ("x\n.Key && ready -> 1", [I64]{1, 1, 1, 1, 7, 20}),
        ("x\n.member(1) {}", [I64]{1, 1, 1})
    ]
    // Keep the pure pass inside an unfolder printing wrapper with dynamic parameters.
    source := "{PASS_SOURCE}\nfn emit_events(source: [U8], facts: [Int]) -> {{\n    events :: terminator_events_scanned(source, false)\n    loop value in events {{ print(value) }}\n}}\nfn run() -> {{\n"
    expected := ""
    loop (input, events) in cases {
        (tokens, diagnostics) :: Lexer.lex_raw(input)
        assert(diagnostics.is_empty(), "golden raw input: {diagnostics:?}")
        bytes := [String]{}
        loop byte in input.bytes() { &bytes.push(byte.to_string()) }
        rows := [String]{}
        loop token in tokens {
            fact :: Lexer.raw_token_fact(token)
            &rows.push(fact.kind.to_string())
            &rows.push(fact.span.start.to_string())
            &rows.push(fact.span.end.to_string())
            &rows.push(if fact.uppercase -> "1" else -> "0")
        }
        &source.push_str("    emit_events([U8]{{{bytes.join(", ")}}}, [Int]{{{rows.join(", ")}}})\n")
        loop event in events { &expected.push_str("{event}\n") }
    }
    &source.push_str("}\n")
    (source, expected)
}
// Rust: tests/selfhost_terminators.rs:375
fn lexer_payload_golden_program() -> (String, String) {
    input :: "\t\u{000B}\u{000C}\r\n  1_2.5e-1 1.25e+1 3.5E-1 3.25E+1 \"prefix {1.25e-2} suffix\""
    (tokens, diagnostics) :: Lexer.lex_raw(input)
    assert(diagnostics.is_empty(), "payload golden raw input: {diagnostics:?}")
    assert_eq(tokens.len(), 6, "payload golden token count changed")
    loop index in 0..<4 {
        if tokens[index].kind == { .Float(_, _) -> {}; else -> assert(false) }
    }
    nested :: if tokens[4].kind == {
        .Str(parts) -> {
            if parts.get(1) == {
                .Val(.Interp(inner)) -> inner.first().expect("interpolation token")
                else -> panic("payload golden string parts lost its interpolation")
            }
        }
        else -> panic("payload golden string token changed: {tokens[4].kind:?}")
    }
    if nested.kind == { .Float(_, _) -> {}; else -> assert(false) }
    bytes := [String]{}
    loop byte in input.bytes() { &bytes.push(byte.to_string()) }
    source := "{PASS_SOURCE}\nfn run() -> {{\n    result :: lex_payload([U8]{{{bytes.join(", ")}}}, false)\n    index := 0\n    loop index < result.tokens.len() {{\n        print(result.tokens[index].span.start)\n        print(result.tokens[index].span.end)\n        print(result.tokens[index].kind)\n        print(result.tokens[index].payload.text)\n        print(result.tokens[index].payload.integer ?? -1)\n        print(result.tokens[index].payload.decimal ?? Float{{0}})\n        print(result.tokens[index].payload.suffix)\n        index += 1\n    }}\n    print(result.diagnostics.len())\n    nested :: result.tokens[4].payload.string_parts[1].tokens[0]\n    print(nested.span.start)\n    print(nested.span.end)\n    print(nested.kind)\n    print(nested.payload.text)\n    print(nested.payload.decimal ?? Float{{0}})\n}}\n"
    expected := ""
    loop token in tokens {
        raw := input[token.span.start..<token.span.end] // #4303
        &expected.push_str("{token.span.start}\n{token.span.end}\n{Lexer.raw_token_fact(token).kind}\n")
        &expected.push_str("{raw}\n")
        if token.kind == {
            .Float(value, _) -> &expected.push_str("-1\n{value}\n\n")
            .Str(_) -> &expected.push_str("-1\n0\n\n")
            .Eof -> &expected.push_str("-1\n0\n\n")
            else -> panic("payload golden token kind changed: {token.kind:?}")
        }
    }
    &expected.push_str("0\n")
    if nested.kind == {
        .Float(value, _) -> {
            raw := input[nested.span.start..<nested.span.end] // #4303
            fact :: Lexer.raw_token_fact(nested)
            &expected.push_str("{nested.span.start}\n{nested.span.end}\n{fact.kind}\n{raw}\n{value}\n")
        }
        else -> panic("payload golden interpolation is not a float")
    }
    (source, expected)
}
