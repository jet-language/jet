// Rust: tests/web_build.rs:3162
pub fn normalize_journey_paths(journey: String, shown: String, target_line_offset: I64) -> String {
    trailing_newline :: journey.ends_with('\n')
    normalized :: journey.lines().map(fn(line) {
        open :: line.find(" (") else { return line.to_string() }
        close :: line[open..].find(')').map(fn(offset) -> open + offset) else { return line.to_string() }
        colon :: line[..close].rfind(':') else { return line.to_string() }
        source_line :: line[colon + 1..<close].parse<I64>() else { return line.to_string() }
        "{line[..open]} ({shown}:{source_line - target_line_offset}{line[close..]}"
    }).collect<[String]>().join("\n")
    if trailing_newline { "{normalized}\n" } else { normalized }
}
// Rust: tests/web_build.rs:3195
pub fn harness_journey(stdout: String) -> String { harness_field(stdout, "JOURNEY_BEGIN\n", "\nJOURNEY_END") }
// Rust: tests/web_build.rs:3199
pub fn harness_frame(stdout: String) -> String { harness_field(stdout, "FRAME_BEGIN\n", "\nFRAME_END") }
// Rust: tests/web_build.rs:3203
pub fn harness_field(stdout: String, begin: String, end_marker: String) -> String {
    start :: stdout.find(begin).expect("harness field start marker") + begin.len()
    end :: stdout[start..].find(end_marker).map(fn(offset) -> start + offset).expect("harness field end marker")
    stdout[start..<end].to_string()
}
