//RS 
//RS // ---------------------------------------------------------------------------
//RS // The runtime error report's terminal state matrix (card #2044 criterion 2).
//RS //
//RS // One renderer owns the report (jet-foundation's `jet_journey_trail`), and
//RS // `JetReportStyle::for_stderr` is the one place that reads the terminal. Its
//RS // four cells are unit-pinned against explicit facts in that file; these tests
//RS // prove the detection itself against a real PTY and a real pipe, through the
//RS // same `script -qfec` mechanism the parity tests above use.
//RS // ---------------------------------------------------------------------------
//RS 
//RS /// Relative on purpose: the trail prints the source path a frame recorded, so a
//RS /// relative invocation keeps these fixtures free of this machine's checkout.
//RS const FAILING_EXAMPLE: &str = "Examples/features/errors/error_context.jet";
//RS 
//RS fn repo_root() -> &'static str {
//RS     env!("CARGO_MANIFEST_DIR")
//RS }
//RS 
//RS /// A PTY transcript is line-ending noise plus the report. Strip `\r`, and strip
//RS /// this checkout's path if a frame ever records an absolute one, so the fixture
//RS /// is the report and nothing else.
