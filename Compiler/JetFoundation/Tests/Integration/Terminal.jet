fn answers() -> &common.ExampleStdin {
    common.example_stdin("io/terminal_parity").expect("io/terminal_parity has stdin answers")
}
// Rust: tests/terminal.rs:31
fn assert_resident_tier_compiles_run() -> {
    bundle := jet.Loader.load_entry(EXAMPLE).expect("terminal_parity loads")
    diags :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run)
    assert(!diags.iter().any((d) -> d.severity == jet.Diagnostics.Severity.Error), "terminal_parity must check: {diags:?}")
    // Canonical tier-plan owner must prove native selection, not silent deopt.
    plan :: common.cranelift_tier_plan(&bundle)
    assert(!plan.whole_interp, "the whole program deopted to the interpreter: {plan:?}")
    assert(plan.native.contains("run"), "`run` must select the native tier; native={plan.native:?} deopt={plan.deopt:?}")
}
// Rust: tests/terminal.rs:57
fn assert_default_run_traces_native_tier() -> {
    cache :: env.temp_dir().join("jet_terminal_parity_trace_cache_{process.id()}")
    _ :: fs.remove_dir_all(&cache)
    child := Command.new(env.jet_bin()).args(["run", "--quiet", "--trace-tiers", EXAMPLE]).env("NO_COLOR", "1").env("JET_RUN_CACHE_DIR", &cache).stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().expect("traced jet run must start")
    child.stdin.take().expect("traced stdin").write_all(answers().piped.as_bytes()).expect("write traced answers")
    output :: child.wait_with_output().expect("collect tier trace")
    trace :: String.from_utf8_lossy(&output.stderr).into_owned()
    _ :: fs.remove_dir_all(&cache)
    assert(output.status.success(), "traced run failed: {trace}")
    assert(trace.contains("tier1 native"), "no function reached the native tier: {trace}")
    assert(!trace.contains("tier0 interp"), "default `jet run` silently deopted: {trace}")
    assert(!trace.contains("E0956"), "{trace}")
}
// Rust: tests/terminal.rs:96
fn shell_quote(value: String) -> String { "'{value.replace('\'', "'\\''")}'" }
// Rust: tests/terminal.rs:100
fn run_pty(mode: String) -> String {
    assert(["O0", "O1", "O2", "Web"].contains(mode), "unknown PTY mode: {mode}")
    jet_bin :: shell_quote(env.jet_bin())
    example :: shell_quote(EXAMPLE)
    shell_line :: "stty rows 24 cols 100; exec {jet_bin} run --quiet --tier {mode} {example}"
    child := Command.new("script").args(["-qfec", &shell_line, "/dev/null"]).env("NO_COLOR", "1").stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().expect("util-linux script must allocate a real PTY")
    child.stdin.take().expect("PTY stdin").write_all(answers().tty().as_bytes()).expect("write terminal answers")
    output :: child.wait_with_output().expect("collect PTY transcript")
    assert(output.status.success(), "PTY child failed with {output.status}\nstdout: {String.from_utf8_lossy(&output.stdout):?}\nstderr: {String.from_utf8_lossy(&output.stderr):?}")
    String.from_utf8_lossy(&output.stdout).into_owned()
}
// Rust: tests/terminal.rs:135
struct NonPtyOutput { stdout: String, stderr: String }
// Rust: tests/terminal.rs:140
fn run_non_pty(mode: String) -> NonPtyOutput {
    assert(["O0", "O1", "O2", "Web"].contains(mode), "unknown non-PTY mode: {mode}")
    args :: ["run", "--quiet", "--tier", mode, EXAMPLE]
    output :: common.jet_cli_output_with_stdin(&args, answers().piped)
    assert(output.status.success(), "non-PTY child failed: {String.from_utf8_lossy(&output.stderr)}")
    NonPtyOutput{stdout: String.from_utf8_lossy(&output.stdout).into_owned(), stderr: String.from_utf8_lossy(&output.stderr).into_owned()}
}
// Rust: tests/terminal.rs:161
fn run_non_pty_merged(mode: String) -> String {
    assert(["O0", "O1", "O2", "Web"].contains(mode), "unknown merged non-PTY mode: {mode}")
    args :: ["run", "--quiet", "--tier", mode, EXAMPLE]
    path :: env.temp_dir().join("jet_terminal_parity_merged_{process.id()}_{mode}")
    sink :: OpenOptions.new().create(true).truncate(true).write(true).open(&path).expect("merged output file")
    stderr :: sink.try_clone().expect("clone merged output file")
    child := Command.new(env.jet_bin()).args(args).env("NO_COLOR", "1").stdin(Stdio.piped()).stdout(Stdio.from(sink)).stderr(Stdio.from(stderr)).spawn().expect("merged non-PTY jet run must start")
    child.stdin.take().expect("merged non-PTY stdin").write_all(answers().piped.as_bytes()).expect("write merged non-PTY answers")
    status :: child.wait().expect("collect merged non-PTY status")
    assert(status.success(), "merged non-PTY child failed: {status}")
    merged :: fs.read_to_string(&path).expect("read merged non-PTY output")
    _ :: fs.remove_file(path)
    merged
}
// Rust: tests/terminal.rs:205
fn marker_positions(transcript: String) -> [USize] {
    clean :: transcript.replace('\r', "")
    ["Continue? [y/N]", "Choose a target:", "choice: production", "Secret: ", "secret length: 6", "progress", "stderr stream"].into_iter().map((marker) -> clean.find(marker).unwrap_or_else(() -> panic("PTY transcript missing {marker:?}: {clean}"))).collect()
}
// Rust: tests/terminal.rs:424
struct ClosedInputRun {
    code: I32?, timed_out: Bool, elapsed: Duration, stdout_bytes: U64,
    stdout: String, stderr: String
}
// Rust: tests/terminal.rs:437
fn run_without_input(mode: String) -> ClosedInputRun {
    assert(["O0", "O1", "O2", "Web"].contains(mode), "unknown closed-input mode: {mode}")
    args :: ["run", "--quiet", "--tier", mode, EXAMPLE]
    base :: env.temp_dir().join("jet_terminal_parity_closed_{process.id()}_{mode}")
    out_path :: base.with_extension("out")
    err_path :: base.with_extension("err")
    sink :: (path: OSPath) -> OpenOptions.new().create(true).truncate(true).write(true).open(path).expect("closed-input output file")
    started :: Instant.now()
    child := Command.new(env.jet_bin()).args(args).env("NO_COLOR", "1").stdin(Stdio.null()).stdout(Stdio.from(sink(&out_path))).stderr(Stdio.from(sink(&err_path))).spawn().expect("closed-input jet run must start")
    deadline :: Duration.from_secs(120)
    code := null
    timed_out := false
    loop {
        status :: child.try_wait().expect("poll closed-input child")
        if status is finished { code = finished.code(); break }
        if started.elapsed() >= deadline {
            _ :: child.kill()
            _ :: child.wait()
            timed_out = true
            break
        }
        thread.sleep(Duration.from_millis(20))
    }
    elapsed :: started.elapsed()
    stdout_bytes :: fs.metadata(&out_path).expect("closed-input stdout metadata").len()
    stdout :: if stdout_bytes <= 64 * 1024 { fs.read_to_string(&out_path).expect("read closed-input stdout") } else { "" }
    stderr :: fs.read_to_string(&err_path).unwrap_or_default()
    _ :: fs.remove_file(&out_path)
    _ :: fs.remove_file(&err_path)
    ClosedInputRun{code: code, timed_out: timed_out, elapsed: elapsed, stdout_bytes: stdout_bytes, stdout: stdout, stderr: stderr}
}
// Rust: tests/terminal.rs:506
fn expected_closed_input_stdout() -> String {
    golden :: fs.read_to_string(env.manifest_dir().join("Examples/features/expected/io/terminal_parity.out")).unwrap()
    retry :: "> Enter a number from 1 to 2.\n"
    assert_eq(golden.matches(retry).count(), 2, "the golden no longer shows two rejected answers, so this derivation is stale")
    trimmed := retry.trim_end() // #4303
    out := ""
    for line in golden.lines() {
        if line == trimmed { continue }
        out.push_str(&line.replace("> choice: production", "> choice: staging"))
        out.push('\n')
    }
    ^out
}
// Rust: tests/terminal.rs:574
FAILING_EXAMPLE :: "Examples/features/errors/error_context.jet"
// Rust: tests/terminal.rs:576
fn repo_root() -> OSPath { env.manifest_dir() }
// Rust: tests/terminal.rs:583
fn normalize_report(text: String) -> String { text.replace('\r', "").replace("{repo_root().display()}/", "") }
// Rust: tests/terminal.rs:588
fn strip_sgr(text: String) -> String {
    out := String.with_capacity(text.len())
    chars := text.chars()
    loop {
        ch :: chars.next() ?? break
        if ch != '\x1b' { out.push(ch); continue }
        for escaped in chars.by_ref() { if escaped == 'm' { break } }
    }
    ^out
}
// Rust: tests/terminal.rs:605
struct ReportCell { text: String, code: I32? }
// Rust: tests/terminal.rs:614
fn report_on_pty(setup: String, environment: [(String, String)]) -> ReportCell {
    jet_bin :: shell_quote(env.jet_bin())
    example :: shell_quote(FAILING_EXAMPLE)
    shell_line :: "{setup} exec {jet_bin} run --quiet {example}"
    command := Command.new("script")
    command.args(["-qfec", &shell_line, "/dev/null"]).current_dir(repo_root()).env_remove("NO_COLOR").env_remove("FORCE_COLOR").env_remove("COLUMNS").stdin(Stdio.null())
    for (name, value) in environment { command.env(name, value) }
    output :: command.output().expect("util-linux script must allocate a real PTY")
    ReportCell{text: normalize_report(&String.from_utf8_lossy(&output.stdout)), code: output.status.code()}
}
// Rust: tests/terminal.rs:640
fn report_on_pipe() -> ReportCell {
    output :: Command.new(env.jet_bin()).args(["run", "--quiet", FAILING_EXAMPLE]).current_dir(repo_root()).env_remove("NO_COLOR").env_remove("FORCE_COLOR").env("COLUMNS", "40").stdin(Stdio.null()).output().expect("piped jet run must start")
    ReportCell{text: normalize_report(&String.from_utf8_lossy(&output.stderr)), code: output.status.code()}
}
// Rust: tests/terminal.rs:658
fn check_report_fixture(name: String, actual: String) -> {
    path :: repo_root().join("tests/cli").join(name)
    if env.var_os("UPDATE_EXPECT").is_some() { fs.write(&path, actual).expect("write report fixture"); return }
    expected :: fs.read_to_string(&path).unwrap_or_else((_) -> panic("missing snapshot {path.display()}; run UPDATE_EXPECT=1 cargo test --test terminal"))
    assert_eq(actual, expected, "report fixture drifted: tests/cli/{name}")
}
