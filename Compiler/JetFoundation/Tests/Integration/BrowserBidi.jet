// Rust: tests/browser_bidi.rs:14
fn sha1(data: &[U8]) -> [U8] {
    h0 := 0x6745_2301 as U32; h1 := 0xefcd_ab89 as U32
    h2 := 0x98ba_dcfe as U32; h3 := 0x1032_5476 as U32; h4 := 0xc3d2_e1f0 as U32
    bit_len :: (data.len() as U64) * 8
    msg := data.to_vec(); msg.push(0x80)
    loop msg.len() % 64 != 56 -> msg.push(0)
    msg.extend_from_slice(&bit_len.to_be_bytes())
    loop chunk in msg.chunks_exact(64) {
        w := [U32]{0; 80}
        loop (i, word) in chunk.chunks_exact(4).enumerate() {
            w[i] = U32.from_be_bytes([U8]{word[0], word[1], word[2], word[3]})
        }
        loop i in 16..<80 -> w[i] = (w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16]).rotate_left(1)
        a := h0; b := h1; c := h2; d := h3; e := h4
        loop (i, word) in w.iter().enumerate() {
            (f, k) :: if i <= 19 -> ((b & c) | ((!b) & d), 0x5a82_7999 as U32)
                else if i <= 39 -> (b ^ c ^ d, 0x6ed9_eba1 as U32)
                else if i <= 59 -> ((b & c) | (b & d) | (c & d), 0x8f1b_bcdc as U32)
                else -> (b ^ c ^ d, 0xca62_c1d6 as U32)
            next :: a.rotate_left(5).wrapping_add(f).wrapping_add(e).wrapping_add(k).wrapping_add(word)
            e = d; d = c; c = b.rotate_left(30); b = a; a = next
        }
        h0 = h0.wrapping_add(a); h1 = h1.wrapping_add(b); h2 = h2.wrapping_add(c)
        h3 = h3.wrapping_add(d); h4 = h4.wrapping_add(e)
    }
    out := [U8]{0; 20}
    loop (i, word) in [h0, h1, h2, h3, h4].iter().enumerate() {
        out[i * 4..<i * 4 + 4].copy_from_slice(&word.to_be_bytes())
    }
    ^out
}
// Rust: tests/browser_bidi.rs:68
fn base64(bytes: &[U8]) -> String {
    ALPHABET :: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/".as_bytes()
    out := String.new()
    loop chunk in bytes.chunks(3) {
        a :: chunk[0]; b :: chunk.get(1).copied().unwrap_or(0); c :: chunk.get(2).copied().unwrap_or(0)
        out.push(ALPHABET[(a >> 2) as USize] as Char)
        out.push(ALPHABET[(((a & 3) << 4) | (b >> 4)) as USize] as Char)
        out.push(if chunk.len() > 1 -> ALPHABET[(((b & 15) << 2) | (c >> 6)) as USize] as Char else -> '=')
        out.push(if chunk.len() > 2 -> ALPHABET[(c & 63) as USize] as Char else -> '=')
    }
    ^out
}
// Rust: tests/browser_bidi.rs:91
fn accept_websocket(stream: &TcpStream) -> Unit {
    request := [U8]{}; buf := [U8]{0; 1024}
    loop !request.windows(4).any(fn(part) { part == "\r\n\r\n".as_bytes() }) {
        n :: stream.read(&buf).expect("read handshake")
        assert(n != 0, "client closed during handshake")
        request.extend_from_slice(&buf[0..<n])
        assert(request.len() <= 16 * 1024, "oversized handshake")
    }
    text :: String.from_utf8(request).expect("ASCII handshake")
    key := text.lines().find_map(fn(line) {
        line.split_once(':').filter(fn(pair) { pair.0.eq_ignore_ascii_case("sec-websocket-key") }).map(fn(pair) { pair.1.trim() })
    }).expect("websocket key") // #4303
    digest :: sha1("{key}258EAFA5-E914-47DA-95CA-C5AB0DC85B11".as_bytes())
    response :: "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: {base64(&digest)}\r\n\r\n"
    stream.write_all(response.as_bytes()).unwrap()
}
// Rust: tests/browser_bidi.rs:117
fn read_text_frame(stream: &TcpStream) -> String {
    head := [U8]{0; 2}; stream.read_exact(&head).unwrap()
    assert(head[0] & 0x0f == 1, "expected text frame")
    assert(head[1] & 0x80 != 0, "client frame must be masked")
    len := (head[1] & 0x7f) as USize
    if len == 126 {
        ext := [U8]{0; 2}; stream.read_exact(&ext).unwrap(); len = U16.from_be_bytes(ext) as USize
    } else if len == 127 {
        ext := [U8]{0; 8}; stream.read_exact(&ext).unwrap(); len = USize.try_from(U64.from_be_bytes(ext)).unwrap()
    }
    mask := [U8]{0; 4}; stream.read_exact(&mask).unwrap()
    payload := [U8]{0; len}; stream.read_exact(&payload).unwrap()
    loop i in 0..<payload.len() -> payload[i] ^= mask[i % 4]
    String.from_utf8(payload).unwrap()
}
// Rust: tests/browser_bidi.rs:142
fn write_text_frame(stream: &TcpStream, text: String) -> Unit {
    bytes :: text.as_bytes(); frame := [U8]{0x81}
    if bytes.len() <= 125 { frame.push(bytes.len() as U8) }
    else if bytes.len() <= 65535 { frame.push(126); frame.extend_from_slice(&(bytes.len() as U16).to_be_bytes()) }
    else { panic("mock response too large") }
    frame.extend_from_slice(bytes); stream.write_all(&frame).unwrap()
}
// Rust: tests/browser_bidi.rs:157
fn field(text: String, name: String) -> String {
    marker :: "\"{name}\":"
    rest := text.split_once(marker).unwrap_or_else(fn() { panic("missing {name}: {text}") }).1 // #4303
    if rest.strip_prefix('"') == .Val(tail) -> return tail.split_once('"').unwrap().0.to_string()
    rest.chars().take_while(fn(ch) { ch.is_ascii_digit() }).collect()
}
// Rust: tests/browser_bidi.rs:169
fn run_mock(listener: TcpListener) -> [String] {
    (stream, _) := listener.accept().unwrap(); accept_websocket(&stream)
    methods := [String]{}
    loop _ in 0..<14 {
        request :: read_text_frame(&stream); id :: field(request, "id"); method :: field(request, "method")
        methods.push(method.clone())
        result :: if method == {
            "session.status" -> "{\"ready\":true,\"message\":\"ready\"}"
            "session.new" -> "{\"sessionId\":\"mock-session\",\"capabilities\":{\"browserName\":\"mock\",\"browserVersion\":\"1\",\"goog:cdp\":true}}"
            "browser.createUserContext" -> "{\"userContext\":\"user-1\"}"
            "browsingContext.create" -> "{\"context\":\"page-1\"}"
            "browsingContext.navigate" -> "{\"url\":\"https://example.test/app\",\"navigation\":\"nav-1\"}"
            "browsingContext.locateNodes" -> "{\"nodes\":[{\"type\":\"node\",\"sharedId\":\"node-1\"}]}"
            "input.performActions" | "session.subscribe" | "goog:cdp.sendCommand" | "browsingContext.close" | "browser.removeUserContext" | "session.end" -> "{}"
            other -> panic("unexpected BiDi method {other}: {request}")
        }
        write_text_frame(&stream, "{\"type\":\"success\",\"id\":{id},\"result\":{result}}")
        if method == "session.subscribe" -> write_text_frame(&stream, "{\"type\":\"event\",\"method\":\"log.entryAdded\",\"params\":{\"text\":\"SECRET PAGE DATA\"}}")
    }
    ^methods
}
// Rust: tests/browser_bidi.rs:211
#Derive(Clone, Copy)
enum HostileReply { Malformed, MismatchedId, ProtocolError, Timeout, NoCdp }
// Rust: tests/browser_bidi.rs:220
fn run_hostile(listener: TcpListener, reply: HostileReply) -> Unit {
    (stream, _) := listener.accept().unwrap(); accept_websocket(&stream)
    request :: read_text_frame(&stream); id: I64 :: field(request, "id").parse().unwrap()
    if reply == {
        .Malformed -> write_text_frame(&stream, "{not-json")
        .MismatchedId -> write_text_frame(&stream, "{\"type\":\"success\",\"id\":{id + 1},\"result\":{}}")
        .ProtocolError -> write_text_frame(&stream, "{\"type\":\"error\",\"id\":{id},\"error\":\"invalid argument\",\"message\":\"SECRET SERVER DATA\",\"stacktrace\":\"SECRET STACK\"}")
        .Timeout -> thread.sleep(Duration.from_millis(500))
        .NoCdp -> {
            write_text_frame(&stream, "{\"type\":\"success\",\"id\":{id},\"result\":{\"ready\":true,\"message\":\"ready\"}}")
            next :: read_text_frame(&stream)
            assert(field(next, "method") == "session.new")
            assert(next.contains("\"capabilities\":{\"alwaysMatch\":{}}"))
            next_id :: field(next, "id")
            write_text_frame(&stream, "{\"type\":\"success\",\"id\":{next_id},\"result\":{\"sessionId\":\"no-cdp\",\"capabilities\":{\"goog:cdp\":false}}}")
        }
    }
}
// Rust: tests/browser_bidi.rs:259
fn run_lifecycle(listener: TcpListener) -> [String] {
    (stream, _) := listener.accept().unwrap(); accept_websocket(&stream)
    methods := [String]{}; page_closes := 0; context_closes := 0; session_closes := 0
    loop _ in 0..<17 {
        request :: read_text_frame(&stream); id :: field(request, "id"); method :: field(request, "method")
        methods.push(method.clone())
        result: String? :: if method == {
            "session.status" -> Val("{\"ready\":true,\"message\":\"ready\"}")
            "session.new" -> Val("{\"sessionId\":\"lifecycle\",\"capabilities\":{}}")
            "browser.createUserContext" -> Val("{\"userContext\":\"context\"}")
            "browsingContext.create" -> Val("{\"context\":\"page\"}")
            "browsingContext.close" -> { page_closes += 1; if page_closes != 1 -> Val("{}") else -> None }
            "browser.removeUserContext" -> { context_closes += 1; if context_closes != 1 -> Val("{}") else -> None }
            "session.end" -> { session_closes += 1; if session_closes != 1 -> Val("{}") else -> None }
            other -> panic("unexpected lifecycle method {other}: {request}")
        }
        if result == {
            .Val(value) -> write_text_frame(&stream, "{\"type\":\"success\",\"id\":{id},\"result\":{value}}")
            .None -> write_text_frame(&stream, "{\"type\":\"error\",\"id\":{id},\"error\":\"unknown error\",\"message\":\"SECRET CLOSE FAILURE\"}")
        }
    }
    ^methods
}
