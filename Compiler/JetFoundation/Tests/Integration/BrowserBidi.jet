fn run_tab_frame_lifecycle(listener: TcpListener) -> [String] {
    (stream, _) := listener.accept().unwrap(); accept_websocket(&stream)
    methods := [String]{}; creates := 0
    loop _ in 0..<11 {
        request :: read_text_frame(&stream); id :: field(request, "id"); method :: field(request, "method")
        methods.push(method.clone())
        result :: if method == {
            "session.status" -> "{\"ready\":true,\"message\":\"ready\"}"
            "session.new" -> "{\"sessionId\":\"tabs\",\"capabilities\":{}}"
            "browser.createUserContext" -> "{\"userContext\":\"ctx\"}"
            "browsingContext.create" -> { creates += 1; assert(request.contains("\"type\":\"tab\""), "tab create must request type=tab: {request}"); "{\"context\":\"tab-{creates}\"}" }
            "browsingContext.getTree" -> "{\"contexts\":[{\"context\":\"tab-1\",\"children\":[{\"context\":\"frame-a\",\"children\":[]},{\"context\":\"frame-b\",\"children\":[]}]}]}"
            "browsingContext.close" | "browser.removeUserContext" | "session.end" -> "{}"
            other -> panic("unexpected tab/frame method {other}: {request}")
        }
        write_text_frame(&stream, "{\"type\":\"success\",\"id\":{id},\"result\":{result}}")
    }
    ^methods
}
