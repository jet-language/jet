// Rust: tests/browser_bidi.rs:420
fn run_handshake(listener: TcpListener, status_result: String, expect_session: Bool) -> [String] {
    (stream, _) := listener.accept().unwrap(); accept_websocket(&stream)
    request :: read_text_frame(&stream); id :: field(request, "id"); methods := [field(request, "method")]
    write_text_frame(&stream, "{\"type\":\"success\",\"id\":{id},\"result\":{status_result}}")
    if expect_session {
        next :: read_text_frame(&stream); next_id :: field(next, "id"); methods.push(field(next, "method"))
        write_text_frame(&stream, "{\"type\":\"success\",\"id\":{next_id},\"result\":{\"sessionId\":\"codec\",\"capabilities\":{}}}")
        last :: read_text_frame(&stream); last_id :: field(last, "id"); methods.push(field(last, "method"))
        write_text_frame(&stream, "{\"type\":\"success\",\"id\":{last_id},\"result\":{}}")
    } else {
        stream.set_read_timeout(Val(Duration.from_millis(100))).unwrap()
        pending := [U8]{0; 1}
        if stream.peek(&pending).unwrap_or(0) != 0 -> methods.push(field(read_text_frame(&stream), "method"))
    }
    ^methods
}
// Rust: tests/browser_bidi.rs:463
fn run_malformed_session(listener: TcpListener) -> [String] {
    (stream, _) := listener.accept().unwrap(); accept_websocket(&stream); methods := [String]{}
    loop result in ["{\"ready\":true,\"message\":\"ready\"}", "{\"sessionId\":1,\"capabilities\":[]}", "{}"] {
        request :: read_text_frame(&stream); id :: field(request, "id"); methods.push(field(request, "method"))
        write_text_frame(&stream, "{\"type\":\"success\",\"id\":{id},\"result\":{result}}")
    }
    ^methods
}
// Rust: tests/browser_bidi.rs:483
fn run_event_storm(listener: TcpListener) -> [String] {
    (stream, _) := listener.accept().unwrap(); accept_websocket(&stream); methods := [String]{}
    loop command in 0..<4 {
        request :: read_text_frame(&stream); id :: field(request, "id"); method :: field(request, "method"); methods.push(method.clone())
        result :: if command == {
            0 -> "{\"ready\":true,\"message\":\"ready\"}"
            1 -> "{\"sessionId\":\"storm\",\"capabilities\":{}}"
            2 -> {
                loop index in 0..<300 {
                    event_method :: if index == 100 -> "SECRET_REMOTE_METHOD_{\"x\".repeat(4_000)}" else -> "event.{index}"
                    write_text_frame(&stream, "{\"type\":\"event\",\"method\":\"{event_method}\",\"params\":{}}")
                }
                "{\"ready\":true,\"message\":\"ready\"}"
            }
            3 -> "{}"
            _ -> panic("unreachable event-storm command")
        }
        write_text_frame(&stream, "{\"type\":\"success\",\"id\":{id},\"result\":{result}}")
    }
    ^methods
}
// Rust: tests/browser_bidi.rs:520
fn run_continuous_events(listener: TcpListener) -> [String] {
    (stream, _) := listener.accept().unwrap(); accept_websocket(&stream); methods := [String]{}
    loop command in 0..<2 {
        request :: read_text_frame(&stream); id :: field(request, "id"); methods.push(field(request, "method"))
        result :: if command == 0 -> "{\"ready\":true,\"message\":\"ready\"}" else -> "{\"sessionId\":\"deadline\",\"capabilities\":{}}"
        write_text_frame(&stream, "{\"type\":\"success\",\"id\":{id},\"result\":{result}}")
    }
    request :: read_text_frame(&stream); methods.push(field(request, "method"))
    loop index in 0..<60 {
        write_text_frame(&stream, "{\"type\":\"event\",\"method\":\"network.tick{index}\",\"params\":{}}")
        thread.sleep(Duration.from_millis(5))
    }
    last :: read_text_frame(&stream); id :: field(last, "id"); methods.push(field(last, "method"))
    write_text_frame(&stream, "{\"type\":\"success\",\"id\":{id},\"result\":{}}")
    ^methods
}
// Rust: tests/browser_bidi.rs:558
fn hostile_listener(reply: HostileReply) -> (String, thread.JoinHandle<Unit>) {
    listener :: TcpListener.bind(("127.0.0.1", 0)).unwrap()
    endpoint :: "ws://{listener.local_addr().unwrap()}/session?token=HOSTILE_SECRET"
    server :: thread.spawn(fn() { run_hostile(^listener, reply) })
    (endpoint, server)
}
// Rust: tests/browser_bidi.rs:568
fn handshake_listener(status_result: String, expect_session: Bool) -> (String, thread.JoinHandle<[String]>) {
    listener :: TcpListener.bind(("127.0.0.1", 0)).unwrap()
    endpoint :: "ws://{listener.local_addr().unwrap()}/session"
    server :: thread.spawn(fn() { run_handshake(^listener, status_result, expect_session) })
    (endpoint, server)
}
// Rust: tests/browser_bidi.rs:578
fn malformed_session_listener() -> (String, thread.JoinHandle<[String]>) {
    listener :: TcpListener.bind(("127.0.0.1", 0)).unwrap()
    endpoint :: "ws://{listener.local_addr().unwrap()}/session"
    server :: thread.spawn(fn() { run_malformed_session(^listener) })
    (endpoint, server)
}

// Rust: tests/browser_bidi.rs:1387
fn run_locator_actions(listener: TcpListener) -> [String] {
    (stream, _) := listener.accept().unwrap(); accept_websocket(&stream)
    methods := [String]{}; locate_calls := 0 as USize
    loop _ in 0..<24 {
        request :: read_text_frame(&stream); id :: field(request, "id"); method :: field(request, "method")
        methods.push(method.clone())
        result :: if method == {
            "session.status" -> "{\"ready\":true,\"message\":\"ready\"}"
            "session.new" -> "{\"sessionId\":\"mock-session\",\"capabilities\":{\"browserName\":\"mock\",\"browserVersion\":\"1\"}}"
            "browser.createUserContext" -> "{\"userContext\":\"user-1\"}"
            "browsingContext.create" -> "{\"context\":\"page-1\"}"
            "browsingContext.navigate" -> "{\"url\":\"https://example.test/form\",\"navigation\":\"nav-1\"}"
            "browsingContext.locateNodes" -> {
                locate_calls += 1
                if locate_calls <= 10 -> "{\"nodes\":[{\"type\":\"node\",\"sharedId\":\"node-1\"}]}" else -> "{\"nodes\":[]}"
            }
            "input.performActions" | "script.callFunction" | "browsingContext.close" | "browser.removeUserContext" | "session.end" -> "{}"
            other -> panic("unexpected BiDi method {other}: {request}")
        }
        write_text_frame(&stream, "{\"type\":\"success\",\"id\":{id},\"result\":{result}}")
        if method == "session.end" -> break
    }
    ^methods
}
// Rust: tests/browser_bidi.rs:1591
fn run_network_events(listener: TcpListener) -> [String] {
    (stream, _) := listener.accept().unwrap(); accept_websocket(&stream)
    methods := [String]{}; add_intercepts := 0 as USize
    loop _ in 0..<20 {
        request :: read_text_frame(&stream); id :: field(request, "id"); method :: field(request, "method")
        methods.push(method.clone())
        if method == {
            "session.status" -> write_text_frame(&stream, "{\"type\":\"success\",\"id\":{id},\"result\":{\"ready\":true,\"message\":\"ready\"}}")
            "session.new" -> write_text_frame(&stream, "{\"type\":\"success\",\"id\":{id},\"result\":{\"sessionId\":\"mock-session\",\"capabilities\":{\"browserName\":\"mock\",\"browserVersion\":\"1\"}}}")
            "session.subscribe" -> write_text_frame(&stream, "{\"type\":\"success\",\"id\":{id},\"result\":{}}")
            "network.addIntercept" -> {
                add_intercepts += 1
                write_text_frame(&stream, "{\"type\":\"success\",\"id\":{id},\"result\":{\"intercept\":\"intercept-{add_intercepts}\"}}")
                if add_intercepts == 1 -> write_text_frame(&stream, "{\"type\":\"event\",\"method\":\"network.beforeRequestSent\",\"params\":{\"isBlocked\":true,\"request\":{\"request\":\"req-secret-1\",\"method\":\"GET\",\"url\":\"https://leak.example/TOP_SECRET_TOKEN\"},\"response\":null}}")
            }
            "network.continueRequest" | "network.failRequest" | "network.provideResponse" | "network.removeIntercept" | "session.end" -> write_text_frame(&stream, "{\"type\":\"success\",\"id\":{id},\"result\":{}}")
            other -> panic("unexpected BiDi method {other}: {request}")
        }
        if method == "session.end" -> break
    }
    ^methods
}
