// Rust: tests/project_check.rs:269
#Test("explicit_in_package_file_keeps_file_scope") {
    output :: run_check("frozen_dogfood", &["check", "--verbose", "src/cli/main.jet"])
    assert(output.status.success(), "in-package check failed:\n{String.from_utf8_lossy(&output.stderr)}")
    stdout :: String.from_utf8_lossy(&output.stdout)
    assert(stdout.contains("scope=explicit-file"), "explicit in-package check changed scope:\n{stdout}")
    proof :: proof_snapshot(&output, &fixture("frozen_dogfood"))
    rows :: proof.lines().collect()
    assert_eq(rows.len(), 4, "explicit-file check must expose four non-project proof rows:\n{proof}")
    assert(rows.iter().all(fn(row) { row.contains("output=not-applicable") && row.contains("[not applicable]") }), "explicit-file check exposed project proof:\n{proof}")
}
// Rust: tests/project_check.rs:296
#Test("bare_project_check_enumerates_outputs_without_writing_artifacts") {
    dir :: fixture("entry_resolution")
    package :: dir.join("package.jet")
    lock :: dir.join(".jet/lock")
    generated :: dir.join(".jet/generated")
    package_mtime :: fs.metadata(&package).unwrap_or_else(fn(error) { panic("package fixture metadata: {error}") }).modified().unwrap_or_else(fn(error) { panic("package fixture mtime: {error}") })
    lock_mtime :: fs.metadata(&lock).ok().and_then(fn(metadata) { metadata.modified().ok() })
    generated_mtime :: fs.metadata(&generated).ok().and_then(fn(metadata) { metadata.modified().ok() })
    output :: run_check("entry_resolution", &["check", "--verbose"])
    assert(output.status.success(), "bare project check failed:\n{String.from_utf8_lossy(&output.stderr)}")
    stdout :: String.from_utf8_lossy(&output.stdout)
    assert(stdout.contains("scope=project"), "bare check did not use project scope:\n{stdout}")
    proof :: proof_snapshot(&output, &dir)
    assert_project_proof_rows("entry_resolution bare", &proof)
    assert(proof.lines().all(fn(row) { row.contains("output=release") }), "bare check did not enumerate the declared runnable output:\n{proof}")
    after_package_mtime :: fs.metadata(&package).unwrap_or_else(fn(error) { panic("package fixture metadata after check: {error}") }).modified().unwrap_or_else(fn(error) { panic("package fixture mtime after check: {error}") })
    after_lock_mtime :: fs.metadata(&lock).ok().and_then(fn(metadata) { metadata.modified().ok() })
    after_generated_mtime :: fs.metadata(&generated).ok().and_then(fn(metadata) { metadata.modified().ok() })
    assert_eq(package_mtime, after_package_mtime, "project check touched package.jet")
    assert_eq(lock_mtime, after_lock_mtime, "project check touched .jet/lock")
    assert_eq(generated_mtime, after_generated_mtime, "project check touched .jet/generated")
}
