// Rust: tests/project_check.rs:427
#Test("dependency_package_members_check_clean_and_run") {
    check :: run_uncached("dependency_members/app", &["check", "."])
    report :: "{String.from_utf8_lossy(&check.stdout)}{String.from_utf8_lossy(&check.stderr)}"
    assert(check.status.success(), "dependency member check failed:\n{report}")
    for code in ["Warning", "Error", "internal"] { assert(!report.contains(code), "dependency member check reported {code}:\n{report}") }
    run :: run_uncached("dependency_members/app", &["run"])
    assert(run.status.success(), "dependency member run failed:\n{String.from_utf8_lossy(&run.stderr)}")
    assert_eq(String.from_utf8_lossy(&run.stdout), "4\n5\n7\n9\n3\nwide\n4\n2\n2\ntrue\n")
}
// Rust: tests/project_check.rs:459
#Test("clean_project_check_then_default_run_and_aot_build_stay_clean") {
    for name in ["frozen_dogfood", "entry_resolution", "module_graph", "core_closure"] {
        check :: run_uncached(name, &["check"])
        assert(check.status.success(), "project check {name} failed:\n{String.from_utf8_lossy(&check.stderr)}")
        run :: run_uncached(name, &["run"])
        assert(run.status.success(), "default-tier run after project check {name} failed:\n{String.from_utf8_lossy(&run.stderr)}")
        build :: run_uncached(name, &["build"])
        assert(build.status.success(), "AOT build after project check {name} failed:\n{String.from_utf8_lossy(&build.stderr)}")
    }
}
