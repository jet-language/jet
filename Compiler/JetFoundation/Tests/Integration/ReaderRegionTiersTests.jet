    assert_eq(actual, fs.read_to_string(env.manifest_dir().join("tests/ui/e2392_linked_cascade.json")).unwrap(), "JSON must preserve the root-first cause chain")
}
// Rust: tests/report.rs:59
#Test("zero_telemetry_policy_docs_and_source_audit") {
    manifest :: env.manifest_dir()
    policy :: fs.read_to_string(manifest.join("Docs/spec/reference/network-policy.md")).unwrap()
    assert(policy.contains("D-TELEMETRY1=A"))
    assert(policy.contains("Jet sends no telemetry"))
    assert(policy.contains("Inventory of toolchain network paths"))
    assert(!policy.contains("future send operation"))
    forbidden_endpoints :: ["reports.jet-lang.dev", "telemetry.jet-lang.dev", "/v1/telemetry", "sentry.io", "crashlytics", "segment.io", "gotelemetry"]
    roots :: [manifest.join("Source"), manifest.join("crates/jet-cli"), manifest.join("crates/jetpack/src")]
    for root in roots {
        for entry in report.walkdir(&root) {
            path :: entry.as_path()
            if path.extension().and_then((ext) -> ext.to_str()) != .Val("rs") { continue }
            text :: fs.read_to_string(path).unwrap()
            for needle in forbidden_endpoints {
                assert(!text.contains(needle), "{path.display()} must not name telemetry endpoint `{needle}`")
            }
        }
    }
}
// Rust: tests/report.rs:148
#Test("ordinary_build_opens_no_network_connection") {
    if target.selected_os() != "linux" { return }
    build_root :: report.scratch("build-network")
    fs.write(build_root.join("main.jet"), "fn run() { print(\"offline\") }\n").unwrap()
    (build, calls) :: report.traced_network_calls(&build_root, "build", ["build", "main.jet"])
    assert(build.status.success(), "build failed:\nstdout: {String.from_utf8_lossy(&build.stdout)}\nstderr: {String.from_utf8_lossy(&build.stderr)}")
    // rustc's local AF_UNIX exec-status socket pair cannot address a host.
    spawn_sockets :: calls.iter().filter((line) -> line.contains("socketpair(AF_UNIX, SOCK_SEQPACKET|SOCK_CLOEXEC, 0,") && line.ends_with("= 0")).count()
    spawn_replies :: calls.iter().filter((line) -> line.contains("recvfrom(") && line.ends_with("\", 8, 0, NULL, NULL) = 0")).count()
    // sendfile between local fds is process I/O, also classified as network by strace.
    unexpected :: calls.iter().filter((line) -> !(line.contains("socketpair(AF_UNIX, SOCK_SEQPACKET|SOCK_CLOEXEC, 0,") && line.ends_with("= 0")) && !(line.contains("recvfrom(") && line.ends_with("\", 8, 0, NULL, NULL) = 0")) && !line.contains("sendfile(")).collect()
    assert(unexpected.is_empty(), "ordinary build made an unexpected network syscall:\n{unexpected.iter().map((line) -> line.as_str()).collect().join("\n")}")
    assert_eq(spawn_sockets, spawn_replies, "rustc's local exec-status socket/reply must stay paired")
    _ :: fs.remove_dir_all(build_root)
}
