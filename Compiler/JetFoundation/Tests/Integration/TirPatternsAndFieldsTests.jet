// Rust: tests/tir_patterns_and_fields.rs:400
#Test("mapped_string_lists_flatten_on_each_hosted_tier") {
    src :: """
fn flatten_words(contents: String) -> [String] {
    return contents.lines().map((line: String) -> line.split(" ").to_list()).flatten()
}
fn flatten_string_rows() -> [String] { [[String]]{{"red"}, {"blue", "green"}}.flatten() }
fn run() -> {
    words :: flatten_words("one two\nthree four")
    neighbors :: flatten_words("five six")
    rows :: flatten_string_rows()
    print(words.len())
    print(words[0])
    print(words[3])
    print(neighbors[1])
    print(rows[2])
}
"""
    expected :: "4\none\nfour\nsix\ngreen\n"
    files :: [("main.jet", src)]
    (code, stdout, stderr) :: run_default_multi("mapped_string_lists_flatten", "main.jet", files)
    assert_eq(code, 0, "default run failed: {stderr}")
    assert_eq(stdout, expected, "{stderr}")
    assert_function_tier(stderr, "flatten_words", "tier1 native")
    assert_function_tier(stderr, "flatten_string_rows", "tier1 native")
    assert_function_tier(stderr, "run", "tier1 native")
    assert(!stderr.contains("tier0 interp"), "{stderr}")
    assert(!stderr.contains("E0956"), "{stderr}")
    (interp_code, interp_stdout, interp_stderr) :: run_interpret_multi("mapped_string_lists_flatten", "main.jet", files)
    assert_eq(interp_code, 0, "interpreter run failed: {interp_stderr}")
    assert_eq(interp_stdout, expected, "{interp_stderr}")
    assert_function_tier(interp_stderr, "run", "tier0 interp")
    assert(!interp_stderr.contains("tier1 native"), "{interp_stderr}")
    assert(!interp_stderr.contains("E0956"), "{interp_stderr}")
    if have_rustc() {
        (aot_code, aot_stdout, aot_stderr) :: build_release_and_run_multi("mapped_string_lists_flatten", "main.jet", files)
        assert_eq(aot_code, 0, "release AOT failed: {aot_stderr}")
        assert_eq(aot_stdout, expected, "{aot_stderr}")
    }
    unsupported_src :: """
fn flatten_float_rows(rows: [[Float]]) -> [Float] { rows.flatten() }
fn run() -> {
    values :: flatten_float_rows([[Float]{1.5}, [Float]{2.5}])
    print(values.len())
    print(values[1])
}
"""
    unsupported_files :: [("main.jet", unsupported_src)]
    (fallback_code, fallback_stdout, fallback_stderr) :: run_default_multi("float_rows_flatten_fallback", "main.jet", unsupported_files)
    assert_eq(fallback_code, 0, "unsupported-shape fallback failed: {fallback_stderr}")
    assert_eq(fallback_stdout, "2\n2.5\n", "{fallback_stderr}")
    assert_function_tier(fallback_stderr, "flatten_float_rows", "tier0 interp")
}

// Rust: tests/tir_patterns_and_fields.rs:465
#Test("float_list_arguments_stay_native_on_the_default_tier") {
    src :: """
fn first(values: [Float]) -> Float { values.first() ?? 0.0 }
fn last(values: [Float]) -> Float { values.last() ?? 0.0 }
fn sorted_first(values: [Float]) -> Float {
    sorted_values := values.copy()
    &sorted_values.sort()
    return sorted_values.first() ?? 0.0
}
fn ordered(left: Float, right: Float) -> Bool { left < right }
fn list_ordered(left: [Float], right: [Float]) -> Bool { left < right }
fn run() -> {
    values :: [Float]{1.0, 2.0}
    print(first(values))
    print(last(values))
    print(sorted_first([Float]{2.0, 1.0}))
    print(ordered(values[0], values[1]))
    print(list_ordered(values, [Float]{1.0, 3.0}))
}
"""
    expected :: "1.0\n2.0\n1.0\ntrue\ntrue\n"
    files :: [("main.jet", src)]
    (code, stdout, stderr) :: run_default_multi("float_list_argument_call", "main.jet", files)
    assert_eq(code, 0, "default run failed: {stderr}")
    assert_eq(stdout, expected, "{stderr}")
    loop function in ["first", "last", "sorted_first", "ordered", "list_ordered"] {
        assert_function_tier(stderr, function, "tier1 native")
    }
    assert(!stderr.contains("tier0 interp"), "{stderr}")
    assert(!stderr.contains("E0956"), "{stderr}")
    (interp_code, interp_stdout, interp_stderr) :: run_interpret_multi("float_list_argument_call", "main.jet", files)
    assert_eq(interp_code, 0, "interpreter run failed: {interp_stderr}")
    assert_eq(interp_stdout, expected, "{interp_stderr}")
    assert_function_tier(interp_stderr, "run", "tier0 interp")
    assert(!interp_stderr.contains("tier1 native"), "{interp_stderr}")
    assert(!interp_stderr.contains("E0956"), "{interp_stderr}")
    if have_rustc() {
        (aot_code, aot_stdout, aot_stderr) :: build_release_and_run_multi("float_list_argument_call", "main.jet", files)
        assert_eq(aot_code, 0, "release AOT failed: {aot_stderr}")
        assert_eq(aot_stdout, expected, "{aot_stderr}")
    }
}

