// Rust: tests/tir_patterns_and_fields.rs:1233
#Test("shared_auto_clone_in_free_call_arg") {
    if !have_rustc() { return }
    src :: """
fn noop(h: Shared<Int>) -> {
    print(0)
}
fn loop_user(h: Shared<Int>) -> {
    loop {
        noop(h)
    }
}
fn run() -> {
    print(0)
}
"""
    // GATE #4494: real source filesystem and independent Rust comparator subprocess.
    dir :: env.temp_dir().join("jet_tir_shared_{process.id()}")
    fs.create_dir_all(dir).unwrap()
    jet_path :: dir.join("shared.jet")
    fs.write(jet_path, src).unwrap()
    shown :: jet_path.to_string_lossy().into_owned()
    out :: jet.compile_with_path(src, shown).unwrap_or_else((diags) -> panic("front end rejected:\n{jet.render_diagnostics(shown, src, diags)}"))
    assert(out.rust.contains("let __jet___arg91_0 = &(((*__jet_h)).clone());\n    __jet_noop(__jet___arg91_0)"), "shared auto-clone free-call arg not byte-exact:\n{out.rust}")
    assert(out.rust.contains("pub fn __jet_noop(__jet_h: &jet_std::JetShared<i64>)"), "Shared<Int> param signature not byte-exact:\n{out.rust}")
    rs :: dir.join("shared.rs")
    bin :: dir.join("shared")
    fs.write(rs, out.rust).unwrap()
    rustc :: Command.new("rustc").args(["--edition", "2021", rs.to_str().unwrap(), "-o", bin.to_str().unwrap()]).output().unwrap()
    assert(rustc.status.success(), "rustc rejected generated code (I2 violation):\n{String.from_utf8_lossy(rustc.stderr)}")
}

