// Rust: tests/tir_patterns_and_fields.rs:850
#Test("bare_or_return_in_unit_fn") {
    if !have_rustc() { return }
    src :: """
fn f(xs: [Int]) -> {
    x := xs.first() ?? return
    print(x)
}
fn run() -> {
    f([10, 20])
    empty :: [Int]{}
    f(empty)
    print(99)
}
"""
