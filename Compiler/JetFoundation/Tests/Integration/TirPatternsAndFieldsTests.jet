// Rust: tests/tir_patterns_and_fields.rs:878
#Test("boxed_recursive_struct_field_read") {
    if !have_rustc() { return }
    src :: """
struct Tree {
    value: Int
    child: Tree?
}
fn sum(t: Tree) -> Int {
    total := t.value
    kid :: t.child
    if kid == {
        .Val(c) -> { total = total + sum(c) }
        .None -> {}
    }
    return total
}
fn run() -> {
    root :: Tree{
        value: 3,
        child: Val(Tree{
            value: 2,
            child: Val(Tree{ value: 1, child: None })
        })
    }
    print(sum(root))
}
"""
    (code, stdout) :: build_and_run("tir_boxed_field_read", src)
    assert_eq(code, 0)
    assert_eq(stdout, "6\n")
}

