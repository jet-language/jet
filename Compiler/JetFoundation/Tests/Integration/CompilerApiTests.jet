// Rust: tests/compiler_api.rs:129
#Test("reserved_in_diagnostic_teaches_postfix_member_carve_out") {
    tree :: Compiler.parse_source("fn run() {{\n    in :: 1\n}}\n")
    diagnostic :: tree.diagnostics.iter().find((diagnostic) -> diagnostic.code == "E0003").expect("bare `in` should remain reserved")
    assert(diagnostic.fix.contains("after `.` it is allowed as a member name"), "diagnostic must teach D-TIME-IN1=C: {diagnostic.fix}")
}
