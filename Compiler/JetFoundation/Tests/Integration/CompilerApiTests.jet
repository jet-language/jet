// Rust: tests/compiler_api.rs:212
#Test("check_file_api_includes_semindex_for_clean_program") {
    source :: "fn helper() -[]> Int {{\n    return 41\n}}\n\nfn run() {{\n    print(helper() + 1)\n}}\n"
    path :: fixture_file("compiler_api_clean.jet", source)
    checked :: Compiler.check_file(&path)
    assert(checked.diagnostics.is_empty(), "unexpected diagnostics: {checked.diagnostics:Debug}")
    sem :: checked.semantic_index.expect("clean file has semindex")
    assert_eq(sem.schema_version, SCHEMA_VERSION)
    assert_eq(sem.source_digest, SHA256.sha256_hex(source.as_bytes()))
    assert(sem.definitions.iter().any((d) -> d.name == "run"))
    assert(sem.definitions.iter().any((d) -> d.name == "helper"))
    assert(sem.calls.iter().any((c) -> c.callee == "helper"))
}
// Rust: tests/compiler_api.rs:237
#Test("check_file_api_projects_arithmetic_policy_and_scope") {
    source :: "fn run() {{\n    #Arithmetic(.Wrapping) {{\n        value :: U8{{250}} + U8{{10}}\n        print(value)\n    }}\n}}\n"
    path :: fixture_file("compiler_api_arithmetic.jet", source)
    checked :: Compiler.check_file(&path)
    assert(checked.diagnostics.is_empty(), "{checked.diagnostics:Debug}")
    sem :: checked.semantic_index.expect("arithmetic semindex")
    operation :: sem.arithmetic.first().expect("arithmetic operation")
    assert_eq(operation.operation, "add")
    assert_eq(operation.policy, "Wrapping")
    assert(operation.scope_span.start < operation.operation_span.start)
    assert(operation.scope_span.end > operation.operation_span.end)
}
// Rust: tests/compiler_api.rs:251
#Test("check_file_api_keeps_semindex_absent_when_errors_exist") {
    path :: fixture_file("compiler_api_bad.jet", "fn run() {{\n    missing_name()\n}}\n")
    checked :: Compiler.check_file(&path)
    assert(checked.diagnostics.iter().any((d) -> d.severity == Compiler.DiagnosticSeverity.Error))
    assert(checked.semantic_index.is_none())
}
// Rust: tests/compiler_api.rs:265
#Test("source_map_api_reads_generated_rust_markers") {
    rust :: "// jet:source-map source=input.jet\nfn main() {{\n    // jet:line 7\n    let x = 1;\n    // jet:line 8\n}}\n"
    map :: Compiler.source_map_from_generated_rust(rust)
    assert_eq(map.sources, ["input.jet"])
    assert_eq(map.generated_lines.len(), 2)
    assert_eq(map.generated_lines[0].generated_line, 3)
    assert_eq(map.generated_lines[0].source, Val("input.jet"))
    assert_eq(map.generated_lines[0].source_line, 7)
}
// Rust: tests/compiler_api.rs:276
#Test("compiler_api_json_mirrors_are_schema_versioned") {
    source :: "fn run() {{ print(\"ok\") }}\n"
    lex :: Compiler.lex_source_json(source)
    assert(lex.starts_with("{{\"schema\":\"jet.status/v1\""))
    assert(lex.contains("\"compiler\":{{\"schema_version\":1,\"api_version\":1,\"operation\":\"lex\""))
    assert(lex.contains("\"tokens\":["))
    parse :: Compiler.parse_source_json(source)
    assert(parse.contains("\"operation\":\"parse\""))
    assert(parse.contains("\"kind\":\"function\""))
    path :: fixture_file("compiler_api_json.jet", source)
    check :: Compiler.check_file_json(&path)
    assert(check.contains("\"operation\":\"check\""))
    assert(check.contains("\"semantic_index\":{{\"schema_version\":1"))
    assert(!check.contains("semantic_index\\\""), "semantic facts must not be JSON strings")
    map :: Compiler.source_map_json("// jet:source-map source=input.jet\n// jet:line 3\n")
    assert(map.contains("\"operation\":\"source_map\""))
    assert(map.contains("\"generated_line\":2"))
}
// Rust: tests/compiler_api.rs:302
#Test("compiler_check_json_is_the_typed_value_not_a_second_shape") {
    source :: "fn run() {{ print(\"same\") }}\n"
    path :: fixture_file("compiler_api_check_shape.jet", source)
    parsed_result :: Compiler.eval_core_call("core.compiler", "parse", [CtValue.Str(source)], Diagnostics.Span.new(0, 0)).unwrap().unwrap()
    parsed :: if parsed_result == { .Present(value) -> value else -> panic("parse must return a typed success value") }
    checked_result :: Compiler.eval_core_call("core.compiler", "check", [^parsed], Diagnostics.Span.new(0, 0)).unwrap().unwrap()
    checked :: if checked_result == { .Present(value) -> value else -> panic("check must return a typed success value") }
    typed_json :: checked.to_json()
    cli_json :: Compiler.check_file_json(&path)
    assert(cli_json.contains("\"value\":{typed_json}"), "CLI check must serialize the exact typed CompilerChecked value: {cli_json}")
    assert(typed_json.contains("\"functions\":"))
    assert(typed_json.contains("\"effects\":"))
    assert(typed_json.contains("\"semantic_index\":{{"))
}
// Rust: tests/compiler_api.rs:339
