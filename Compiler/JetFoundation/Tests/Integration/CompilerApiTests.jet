    source :: "fn run() {{ missing_name() }}\n"
    result :: Compiler.eval_core_call("core.compiler", "check", [CtValue.Struct{type_name: "CompilerSyntaxTree", fields: [("schema_version", CtValue.Int(1)), ("source", CtValue.Str(source))]}], Diagnostics.Span.new(0, 0)).unwrap().unwrap()
