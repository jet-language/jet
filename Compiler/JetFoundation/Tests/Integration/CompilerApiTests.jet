// Rust: tests/compiler_api.rs:8
#Test("lexer_api_returns_stable_value_tokens") {
    src :: "fn run() {{\n    print(\"hi\")\n}}\n"
    lexed :: Compiler.lex_source(src)
    assert_eq(lexed.api_version, Compiler.API_VERSION)
    assert(lexed.diagnostics.is_empty())
    assert(lexed.tokens.iter().any((t) -> t.kind == "keyword.fn" && t.text == "fn" && t.start.line == 1 && t.start.column == 1))
    assert(lexed.tokens.iter().any((t) -> t.kind == "identifier" && t.text == "run"))
    assert_eq(lexed.tokens.last().map((t) -> t.kind), Val("eof"))
}
// Rust: tests/compiler_api.rs:24
#Test("lexer_api_positions_match_canonical_unicode_newline_and_long_line") {
    source :: "fn α() {{\r\n    value :: π\r\n}}\n"
    lexed :: Compiler.lex_source(source)
    assert(lexed.diagnostics.is_empty(), "unexpected lexer diagnostics: {lexed.diagnostics:Debug}")
    for token in &lexed.tokens {
        assert_eq((token.start.line, token.start.column), Diagnostics.span_line_col(source, token.span.start), "start position for {token.kind} {token.span:Debug}")
        assert_eq((token.end.line, token.end.column), Diagnostics.span_line_col(source, token.span.end), "end position for {token.kind} {token.span:Debug}")
    }
    eof :: lexed.tokens.last().expect("lexer always emits eof")
    assert_eq(eof.kind, "eof")
    assert_eq(eof.text, "")
    assert_eq(eof.span.start, source.len())
    assert_eq(eof.span.end, source.len())
    long_line := String.with_capacity(4_096 * 5)
    for index in 0..4_096 {
        if index != 0 { long_line.push(' ') }
        long_line.push_str("item")
    }
    long :: Compiler.lex_source(&long_line)
    assert(long.diagnostics.is_empty(), "unexpected long-line lexer diagnostics: {long.diagnostics:Debug}")
    assert_eq(long.tokens.iter().filter((token) -> token.kind == "identifier").count(), 4_096)
    for token in &long.tokens {
        assert_eq((token.start.line, token.start.column), Diagnostics.span_line_col(&long_line, token.span.start), "long-line start position for {token.kind} {token.span:Debug}")
        assert_eq((token.end.line, token.end.column), Diagnostics.span_line_col(&long_line, token.span.end), "long-line end position for {token.kind} {token.span:Debug}")
    }
}
// Rust: tests/compiler_api.rs:93
#Test("postfix_in_lexes_as_a_member_identifier") {
    lexed :: Compiler.lex_source("fn run() {{\n    value :: duration.in(.Seconds)\n    loop item in [1] -> print(item)\n}}\n")
    assert(lexed.diagnostics.is_empty(), "unexpected lexer diagnostics: {lexed.diagnostics:Debug}")
    assert(lexed.tokens.iter().any((token) -> token.kind == "identifier" && token.text == "in"))
    assert(lexed.tokens.iter().any((token) -> token.kind == "keyword.in" && token.text == "in"))
}
// Rust: tests/compiler_api.rs:109
