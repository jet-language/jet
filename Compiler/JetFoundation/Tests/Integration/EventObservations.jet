// Rust: tests/event_observations.rs:1
// Real runtime observations consumed by the debugger; these attach to generated programs.
use std.fs
use std.io.[BufReader]
use std.env
use std.process.[Child, Command, Stdio]
use std.time.[Duration, Instant]
use jet_foundation.Tests.Integration.Common as common
use jet.DevServer.LiveInspect
use jet.Debug
use jet.Canvas

// Rust: tests/event_observations.rs:14
struct Running {
    child: Child,
    dir: OSPath,
}
// Rust: tests/event_observations.rs:20
impl Drop for Running {
    fn drop(&self) -> {
        // GATE #4494: native child cleanup and filesystem operations.
        pid :: self.child.id()
        _ :: self.child.kill()
        _ :: self.child.wait()
        _ :: fs.remove_file(LiveInspect.snapshot_path(pid))
        _ :: fs.remove_dir_all(&self.dir)
    }
}
// Rust: tests/event_observations.rs:29
fn spawn_observed(tag: String, source: String) -> Running? {
    if !common.have_rustc() { return None }
    dir :: common.unique_tmp("jet_event_observe_{tag}")
    fs.write(dir.join("package.jet"), "name: \"test-fixture\"\nversion: \"0.1.0\"\nauthority: {\n    holds: {\n        allow: [IO, Panic, Time, Time.Wait]\n    }\n}\n").unwrap()
    source_path :: dir.join("main.jet")
    fs.write(&source_path, source).unwrap()
    // GATE #4494: native process spawn, pipes and environment.
    build :: Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(["build", source_path.to_str().unwrap()]).current_dir(&dir).output().unwrap()
    assert(build.status.success(), "build failed:\n{}", String.from_utf8_lossy(&build.stderr))
    // GATE #4483: selected-target executable suffix, not host assumptions.
    suffix :: if core.sys.target.selected_os() == "windows" { ".exe" } else { "" }
    binary :: dir.join(".jet").join("build").join("main{suffix}")
    child := Command.new(binary)
        .env("JET_OBSERVE", "1")
        .env("JET_DEVTOOLS_RELAY_SESSION_ID", "event-observation-session")
        .env("JET_DEVTOOLS_RELAY_SOURCE_ID", "observed")
        .env("JET_DEVTOOLS_RELAY_BUILD_ID", "event-observation-build")
        .env("JET_DEVTOOLS_RELAY_REVISION", "event-observation-revision")
        .env("JET_DEVTOOLS_RELAY_WORLD_ID", "event-observation-world")
        .env("JET_SCHEDULER_THREADS", "2")
        .stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().unwrap()
    ready := String.new()
    BufReader.new(child.stdout.take().unwrap()).read_line(&ready).unwrap()
    ready_trimmed := ready.trim() // #4303
    if ready_trimmed != "READY" {
        stderr :: child.stderr.take().map((stream) -> {
            text := String.new()
            _ :: BufReader.new(stream).read_line(&text)
            text
        }).unwrap_or_default()
        panic("observed program did not become ready: {ready:Debug} {stderr}")
    }
    Some(Running{child: ^child, dir: ^dir})
}
// Rust: tests/event_observations.rs:86
fn debugger_events(pid: UInt32, terminal: String) -> (String, String) {
    deadline :: Instant.now() + Duration.from_secs(5)
    last := String.new()
    loop {
        if snapshot := LiveInspect.read(pid).ok() {
            if snapshot.contains(terminal) {
                rendered :: Debug.render_event_observations(&snapshot).expect("debugger should consume the runtime event schema")
                return (^snapshot, ^rendered)
            }
            last = ^snapshot
        }
        if Instant.now() >= deadline {
            rendered :: Debug.render_event_observations(&last).unwrap_or_default()
            panic("runtime event observation never became visible:\n{rendered}")
        }
        // GATE #4494: real native sleep.
        std.thread.sleep(Duration.from_millis(25))
    }
}
// Rust: tests/event_observations.rs:106
fn canvas_runtime(running: &Running) -> String {
    graph :: Canvas.graph_json_for_entry_source_with_live_pid(&running.dir.join("main.jet"), None, running.child.id()).expect("Canvas should project the validated live Event sequence")
    graph.split_once("\"runtime_events\":")
        .and_then((pair) -> pair.1.split_once(",\"event_dispatchers\""))
        .map((pair) -> pair.0.to_string()).expect("Canvas runtime event facts")
}
