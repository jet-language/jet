use jet_foundation.Tests.Integration.Common as common
use jet_foundation.Tests.Integration.TirSupport.[build_and_run, have_rustc]
use jet_foundation.Tests.Integration.DevParts.Support.[ProgramOutput, DEV_DIFF_TIMEOUT, command_output_with_timeout]
use std.fs as fs
use std.process.Command

// Rust: tests/fenced_names.rs:10
pub const SOURCE: String = """

fn run() {
    <: score1..score3 :> :: 7
    print(<: score1..score3 :>)
}
"""
// Rust: tests/fenced_names.rs:17
pub const INTEGER_RANGE_SOURCE: String = """

fn run() {
    print(<:0..3:>)
}
"""
// Rust: tests/fenced_names.rs:23
pub fn run_fenced_source(name: &String, source: &String, expected: &String) -> {
    if have_rustc() {
        (code, stdout) :: build_and_run(name, source)
        assert_eq(code, 0)
        assert_eq(stdout, expected)
    }
    dir :: std.env.temp_dir().join("jet_{name}_{std.process.id()}")
    fs.create_dir_all(&dir).unwrap()
    path :: dir.join("main.jet")
    fs.write(&path, source).unwrap()
    shown :: path.to_string_lossy().into_owned()
    bundle := jet.Loader.load_entry(&shown).expect("fenced-name bundle should load")
    errors :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run).into_iter().filter(|diagnostic| -> diagnostic.severity == jet.Diagnostics.Severity.Error).collect<[jet.Diagnostics.Diagnostic]>()
    assert(errors.is_empty(), "fenced names must type-check: {errors:?}")
    // Retired resident-JIT/interpreter checks migrate to actual retained O0/O1/O2 executions.
    loop profile in ["debug", "dev", "release"] {
        // GATE #4494: real native compiler/run child, no tier mocks or Rust callbacks.
        output :: command_output_with_timeout(Command.new(common.jet_bin()).args(["run", "--profile={profile}", "--quiet", &shown]).env("NO_COLOR", "1"), *DEV_DIFF_TIMEOUT, "{profile} fenced names")
        assert_eq(output.status.code(), Some(0), "{profile} exit drift")
        assert_eq(String.from_utf8_lossy(&output.stderr), "", "{profile} stderr drift")
        assert_eq(String.from_utf8_lossy(&output.stdout), expected, "{profile} expansion order drift")
    }
}
