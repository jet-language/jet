// Rust: tests/fresh_agent_t4.rs:55
struct Scratch { path: OSPath }
impl Scratch {
    // Rust: tests/fresh_agent_t4.rs:60
    fn new(tier: String) -> Scratch {
        sequence :: SCRATCH_SEQUENCE.fetch_add(1, Ordering.Relaxed)
        path :: env.temp_dir().join("jet-fresh-agent-t4-{id()}-{tier}-{sequence}")
        fs.create_dir_all(&path).expect("create T4 scratch directory")
        Scratch{path: ^path}
    }
}
impl Drop for Scratch {
    // Rust: tests/fresh_agent_t4.rs:72
    fn drop(&self) -> { _ :: fs.remove_dir_all(&self.path) }
}
// Rust: tests/fresh_agent_t4.rs:77
fn fixture_root() -> OSPath { OSPath(env.var("CARGO_MANIFEST_DIR").unwrap()).join("tests/fixtures/fresh_agent_t4") }
// Rust: tests/fresh_agent_t4.rs:81
fn copy_fixture_project(root: &OSPath, scratch: &OSPath) -> {
    fs.copy(root.join("package.jet"), scratch.join("package.jet")).expect("copy T4 package manifest")
    fs.copy(root.join("run.jet"), scratch.join("run.jet")).expect("copy T4 Jet program")
}
// Rust: tests/fresh_agent_t4.rs:87
fn run_tier(scratch: &Scratch, command_args: &[String]) -> Output {
    // GATE #4494: real subprocess and cache isolation.
    Command.new(env.var("CARGO_BIN_EXE_jet").unwrap()).args(command_args).args(["run.jet", "--", "report.tsv"]).current_dir(&scratch.path).env("JET_STORE_DIR", scratch.path.join("cache")).env("NO_COLOR", "1").output().expect("run T4 Jet fixture")
}
