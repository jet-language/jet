// Rust: tests/taint.rs:93
#Test("external_boundaries_seed_origin_facts") {
    cases := [
        ("fs", """
use core.files as files
fn run() -> {
    value :: files.read("payload.txt") ?? return Err("test")
    SQL.raw(value)
}
"""),
        ("env", """
use core.sys as env
fn run() -> {
    value :: env.get("PAYLOAD") ?? return Err("test")
    SQL.raw(value)
}
"""),
        ("process", """
use core.process as process
fn run() -> {
    result :: process.run(["echo", "payload"]) ?? return Err("test")
    SQL.raw(result.output)
}
"""),
        ("net", """
use core.net as net
fn run() -> {
    stream :: net.tcp_connect("example.invalid:80") ?? return Err("test")
    value :: net.tcp_read_text(stream, 1) ?? return Err("test")
    SQL.raw(value)
}
"""),
        ("ffi", """
extern rust "std" {
    fn identity(value: String) -> String = "std::convert::identity"
}
fn run() -> {
    value :: identity("payload")
    SQL.raw(value)
}
""")
    ]
    loop (source, program) in cases {
        found := codes(program)
        assert(found.iter().any(code -> code == "E0721"), "{source} boundary must seed an origin fact: {found:?}")
    }
}
