// Rust: tests/taint.rs:537
#Test("magic_link_rejects_oversized_dns_labels") {
    valid := "user@{\"a\".repeat(63)}.example"
    invalid := "user@{\"a\".repeat(64)}.example"
    assert(jet_auth_delivery_capability(valid).is_some())
    assert(jet_auth_delivery_capability(invalid).is_none(), "a delivery identity with a 64-byte DNS label must be rejected")
    assert(jet_auth_register_user(invalid.clone(), "hash").is_ok())
    assert(jet_auth_magic_link_issue(invalid, 0, 1000).is_err(), "registered users with invalid delivery identities must not receive magic links")
}
// Rust: tests/taint.rs:554
#Test("session_show_redacts_bearer_and_oauth_fails_closed") {
    session := auth.Session{ id: "sess-live-bearer", user_id: "alice", expires_at: 42, cookie: "jet_session=sess-live-bearer" }
    shown := auth.session_show(session)
    assert_eq(shown, "Session(id=<redacted>, user=alice, exp=42, cookie_len=28)")
    assert(!shown.contains("sess-live-bearer"))
    debug := fmt.debug(session)
    assert(!debug.contains("sess-live-bearer"))
    assert(!debug.contains("jet_session=sess-live-bearer"))
    assert(debug.contains("<redacted>"))
    assert(jet_auth_oauth_begin("google").is_err())
    assert(jet_auth_oauth_finish("state", "attacker", 0, 1000).is_err())
}
// Rust: tests/taint.rs:581
#Test("oauth_assertion_requires_provider_proof_and_state_nonce") {
    entry := JetAuthOAuthState{ state: "oauth-state", provider: "google", nonce: "nonce-value", expires_at: 1700000060000 }
    secret := "01234567890123456789012345678901".bytes().to_vec()
    header := b64url("{\"alg\":\"HS256\",\"typ\":\"JWT\"}".bytes())
    payload := b64url("{\"iss\":\"google\",\"aud\":\"google\",\"sub\":\"alice\",\"nonce\":\"nonce-value\",\"exp\":1700000100,\"iat\":1700000000}".bytes())
    signing_input := "{header}.{payload}"
    signature := b64url(crypto.hmac_sha256(secret, signing_input.bytes()).unwrap())
    assertion := "{signing_input}.{signature}"
    assert_eq(jet_auth_oauth_verify(entry, assertion, 1700000000000, secret, "google", "google").unwrap(), "alice")
    tampered := assertion.clone()
    tampered.pop()
    tampered.push('A')
    assert(jet_auth_oauth_verify(entry, tampered, 1700000000000, secret, "google", "google").is_err())
    wrong_nonce := entry.clone()
    wrong_nonce.nonce = "other"
    assert(jet_auth_oauth_verify(wrong_nonce, assertion, 1700000000000, secret, "google", "google").is_err())
}
