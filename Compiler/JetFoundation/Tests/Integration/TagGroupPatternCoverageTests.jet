// Rust: tests/tag_group_pattern_coverage.rs:28
#Test("ancestor_group_arm_still_flags_later_leaf_as_unreachable") {
    diagnostics := coverage.codes("""
enum Damage {
    Fire { Burn, Scald }
    Cold
}
fn run() -> {
    d := Damage.Fire.Burn
    if d == {
        .Fire -> { print("fire") }
        .Fire.Burn -> { print("burn") }
        .Cold -> { print("cold") }
    }
}
""")
    assert(diagnostics.iter().any(code -> code == "L0301"), "{diagnostics:?}")
}
// Rust: tests/tag_group_pattern_coverage.rs:55
#Test("sibling_variant_with_shared_text_prefix_is_not_falsely_covered") {
    diagnostics := coverage.codes("""
enum Alarm {
    Fire
    FireAlarm
}
fn run() -> {
    a := Alarm.FireAlarm
    if a == {
        .Fire -> { print("fire") }
        .FireAlarm -> { print("fire alarm") }
    }
}
""")
    assert(!diagnostics.iter().any(code -> code == "L0301" || code == "E0365"), "{diagnostics:?}")
}
// Rust: tests/tail_return_parity.rs:163
#Test("block_values_arm_tables_and_early_returns_match_comptime_and_hosted_tiers") {
    assert_packaged_cli_tiers_agree(COMPTIME_SOURCE, "one\nother\nearly\nlate\none\nother\nearly\nlate\n100\n3\n9\n0\n0\n100\n3\n9\n0\n0\n")
}
// Rust: tests/tail_return_parity.rs:176
#Test("l0507_arm_table_fix_keeps_a_tail_chain_meaning_on_every_tier") {
    source := """
fn grade(score: Int) -> String {
    if score >= 90 {
        return "a"
    } else if score >= 80 {
        return "b"
    } else {
        return "c"
    }
}
fn show(score: Int) -> {
    if score >= 90 {
        print("A")
    } else if score >= 80 {
        print("B")
    } else {
        print("C")
    }
}
fn run() -> {
    print(grade(95))
    print(grade(85))
    print(grade(10))
    show(95)
    show(85)
    show(10)
}
"""
    // GATE #4494: real entry file used by the compiler driver.
    scratch := common.unique_tmp("jet_l0507_fix")
    fs.create_dir_all(scratch).unwrap()
    compile_file := text -> {
        path := scratch.join("run.jet")
        fs.write(path, text).unwrap()
        compile_with_path(text, path.to_str().unwrap())
    }
    compiled := compile_file(source).unwrap_or_else(diagnostics -> panic("classic chains must compile: {diagnostics:?}"))
    edits := compiled.lints.iter().filter(d -> d.code == "L0507").filter_map(d -> d.edit.clone()).collect()
    assert_eq(edits.len(), 2, "both chains must carry the arm-table fix")
    fixed := apply_edits(source, edits).expect("the L0507 edits must apply")
    assert(fixed.contains("    if {\n        score >= 90 -> {"), "{fixed}")
    recompiled := compile_file(fixed).unwrap_or_else(diagnostics -> panic("fixed source must compile:\n{fixed}\n{diagnostics:?}"))
    assert(!recompiled.lints.iter().any(d -> d.code == "L0507"), "fixed source still warns:\n{fixed}")
    _ :: fs.remove_dir_all(scratch)
    expected := "a\nb\nc\nA\nB\nC\n"
    assert_packaged_cli_tiers_agree(source, expected)
    assert_packaged_cli_tiers_agree(fixed, expected)
}
// Rust: tests/tail_return_parity.rs:239
#Test("block_values_arm_tables_and_early_returns_match_web_runtime") {
    if !have_tool("rustc") || !have_tool("node") || !have_wasm_target() {
        eprintln("note: skipping tail-return web test (need rustc, wasm32 target, and node)")
        return
    }
    out := compile_web_with_path(WEB_SOURCE, "tests/fixtures/tail_return_web.jet").expect("tail-return web source must compile")
    web := out.web.expect("web compile must return web artifacts")
    scratch := common.Scratch.new("jet_tail_return_web")
    fs.write(scratch.join("app.js"), web.js_app).unwrap()
    fs.write(scratch.join("jet_dom_runtime.js"), web.dom_runtime).unwrap()
    fs.write(scratch.join("app_wasm.rs"), web.wasm_rust).unwrap()
    fs.write(scratch.join("package.json"), "{\"type\":\"module\"}").unwrap()
    fs.write(scratch.join("harness.mjs"), "const { jet_main } = await import(\"./app.js\");\nawait jet_main();\n").unwrap()
    // GATE #4494: actual generated Wasm compilation and web execution.
    wasm := Command.new("rustc").current_dir(scratch.path).args(["--edition", "2021", "--target", "wasm32-unknown-unknown", "--crate-type", "cdylib", "-O", "app_wasm.rs", "-o", "app.wasm"]).output().expect("rustc must build the generated Wasm partition")
    assert(wasm.status.success(), "generated Wasm failed to compile:\n{String.from_utf8_lossy(wasm.stderr)}")
    output := Command.new("node").current_dir(scratch.path).arg("harness.mjs").output().expect("node must run the generated web harness")
    assert(output.status.success(), "generated web app failed:\n{String.from_utf8_lossy(output.stderr)}")
    assert_eq(String.from_utf8_lossy(output.stdout), "7\n20\n30\n40\n100\n3\n9\n0\n0\n7\n20\n30\n40\n")
}

// Rust: tests/taint.rs:15
#Test("origin_facts_clear_only_after_typed_decode") {
    rejected_before_decode := """
use core.files as files
fn run() -> {
    raw :: files.read("config.json") ?? return Err("test")
    SQL.raw(raw)
}
"""
    assert(codes(rejected_before_decode).iter().any(code -> code == "E0721"), "external text must stay origin-marked before validation: {codes(rejected_before_decode):?}")
    accepted_after_decode := """
use core.files as files
use core.encoding.json as json
#Codable
struct Config {
    name: String
}
fn run() -> {
    raw :: files.read("config.json") ?? return Err("test")
    config :: json.decode<Config>(raw) ?? return Err("test")
    SQL.raw(config.name)
}
"""
    assert(!codes(accepted_after_decode).iter().any(code -> code == "E0721"), "successful typed decode must clear origin facts: {codes(accepted_after_decode):?}")
}
// Rust: tests/taint.rs:56
#Test("origin_marked_text_rejects_raw_sinks") {
    src := """
use core.files as files
fn run() -> {
    raw :: files.read("payload.txt") ?? return Err("test")
    SQL.raw(raw)
    HTML.raw(raw)
    Sh.raw(raw)
}
"""
    found := codes(src)
    assert_eq(found.iter().filter(code -> code == "E0721").count(), 3, "all audited raw sinks must reject origin text: {found:?}")
}
