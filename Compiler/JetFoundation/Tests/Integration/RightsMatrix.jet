// Phase-A differential matrix: test-local legacy verdict oracles.
use jet_foundation.Authority
use jet_foundation.Authority.[Holds, Verdict]
use jet_foundation.sema.[RightsProvenance, RightsRow]
use std.[env, fs, process, time]
use common
use tir_support

// Rust: tests/rights_matrix.rs:11
struct Case {
    name: String
    row: RightsRow
    effects: Holds
    legacy: fn(String) -> Verdict
}
// Rust: tests/rights_matrix.rs:18
fn legacy_pure(_right: String) -> Verdict { Verdict.Missing }
// Rust: tests/rights_matrix.rs:22
fn legacy_replayable(right: String) -> Verdict {
    match Authority.root(right) {
        "Time" | "Rand" | "Net" | "IO" -> Verdict.Denied
        _ -> Verdict.Allowed
    }
}
// Rust: tests/rights_matrix.rs:29
fn legacy_comptime(right: String) -> Verdict {
    if Authority.covers("Mem", right) { Verdict.Allowed } else { Verdict.Missing }
}
// Rust: tests/rights_matrix.rs:37
fn legacy_invocation(right: String) -> Verdict {
    if Authority.covers("FS.Write", right) { Verdict.Denied }
    else if Authority.covers("FS", right) || Authority.covers("Time", right) { Verdict.Allowed }
    else { Verdict.Missing }
}
// Rust: tests/rights_matrix.rs:47
fn case_rows() -> [Case] {
    [
        Case { name: "pure-empty-row", row: RightsRow.pure(RightsProvenance.new("rights_matrix::pure", "legacy purity oracle")), effects: Holds.from(["IO"]), legacy: legacy_pure },
        Case { name: "replayable-ambient-denials", row: RightsRow.replayable(RightsProvenance.new("rights_matrix::replayable", "legacy replayability oracle")), effects: Holds.from(["Time", "Rand.Draw", "Net.HTTP.Get", "IO", "FS.Read"]), legacy: legacy_replayable },
        Case { name: "comptime-memory-only", row: RightsRow.comptime(RightsProvenance.new("rights_matrix::comptime", "legacy comptime oracle")), effects: Holds.from(["Mem.Alloc", "FS.Read"]), legacy: legacy_comptime },
        Case { name: "invocation-allow-deny", row: RightsRow.invocation(["FS", "Time"], ["FS.Write"], RightsProvenance.new("rights_matrix::invocation", "legacy invocation oracle")), effects: Holds.from(["FS.Read", "FS.Write", "Time", "Net"]), legacy: legacy_invocation },
    ]
}

// Rust: tests/ring_layer.rs:8
fn tmp_project(name: String) -> OSPath {
    // GATE #4494: native process identity and temporary directory.
    dir :: env.temp_dir().join("jet_ring_layer_{name}_{process.id()}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    dir
}
// Rust: tests/ring_shipping.rs:16
fn scratch(tag: String) -> OSPath {
    // GATE #4494: native wall clock and filesystem.
    nanos :: time.SystemTime.now().duration_since(time.UNIX_EPOCH).unwrap().as_nanos()
    p :: env.temp_dir().join("ring-ship-{tag}-{nanos}")
    fs.create_dir_all(&p).unwrap()
    p
}
// Rust: tests/rollback.rs:8
fn unique_tmp(tag: String) -> OSPath { common.unique_tmp("jet_rollback_{tag}") }
// Rust: tests/rollback.rs:12
fn build_and_run(name: String, src: String) -> (Int32, String) {
    (code, stdout, _stderr) :: common.build_and_run("jet_rollback", name, src)
    (code, stdout)
}
// Rust: tests/s5_columnar_witness.rs:8
EXPECTED :: "599.9999999999977\n"
// Rust: tests/s5_columnar_witness.rs:9
AOS :: include_str("tests/s5_columnar_witness/aos.jet")
// Rust: tests/s5_columnar_witness.rs:10
COLUMNAR :: include_str("tests/s5_columnar_witness/columnar.jet")
// Rust: tests/s5_columnar_witness.rs:12
fn assert_tiers(name: String, source: String) -> {
    (jit_code, jit_stdout, jit_stderr) :: tir_support.jit_run(name, source)
    assert_eq(jit_code, 0, "{name} default run failed: {jit_stderr}")
    assert_eq(jit_stdout, EXPECTED, "{name} default output drifted")
    (interpreter_code, interpreter_stdout, interpreter_stderr) :: tir_support.interpreter_run(name, source)
    assert_eq(interpreter_code, jit_code, "{name} interpreter failed: {interpreter_stderr}")
    assert_eq(interpreter_stdout, EXPECTED, "{name} interpreter output drifted")
    if tir_support.have_rustc() {
        (aot_code, aot_stdout, aot_stderr) :: tir_support.build_and_run_full("jet_s5_columnar", name, source)
        assert_eq(aot_code, jit_code, "{name} AOT failed: {aot_stderr}")
        assert_eq(aot_stdout, EXPECTED, "{name} AOT output drifted")
    }
}
