use std.[fs, env]
use std.process.[Command, Output]
use jet_foundation.Tests.Integration.CliParts.Support.[jet, isolated_cwd]
// GATE #4494: native process and filesystem primitives; #4483: selected-family dispatch in callers.
// Rust: tests/cli_parts/bindings.rs:199
pub fn fake_rustc_fixture(tag: String, target_list_action: String) -> (OSPath, OSPath, OSPath) {
    dir :: isolated_cwd(tag)
    bin :: dir.join("bin")
    sysroot :: dir.join("sysroot")
    fs.create_dir_all(&bin).unwrap()
    rustc :: bin.join("rustc")
    script :: "#!/bin/sh\nif [ \"$1\" = \"--version\" ]; then\n    printf '%s\\n' 'rustc 1.97.1'\n    exit 0\nfi\nif [ \"$1\" = \"--print\" ] && [ \"$2\" = \"target-list\" ]; then\n    {target_list_action}\nfi\nif [ \"$1\" = \"--print\" ] && [ \"$2\" = \"sysroot\" ]; then\n    printf '%s\\n' \"$JET_FAKE_SYSROOT\"\n    exit 0\nfi\nprintf '%s\\n' 'rustc-probe-sentinel' >&2\nexit 79\n"
    fs.write(&rustc, script).unwrap()
    permissions := fs.metadata(&rustc).unwrap().permissions()
    permissions.set_mode(0o755)
    fs.set_permissions(&rustc, permissions).unwrap()
    (dir, bin, sysroot)
}
// Rust: tests/cli_parts/bindings.rs:232
pub fn run_doctor_target(dir: &OSPath, bin: &OSPath, sysroot: &OSPath, target_args: &[String]) -> Output {
    Command.new(jet()).args(["self", "doctor"]).args(target_args).current_dir(dir).env("PATH", bin).env("HOME", dir).env("JET_FAKE_SYSROOT", sysroot).env("NO_COLOR", "1").output().unwrap()
}
