// Rust: tests/cli_parts/surface.rs:1023
#Test("machine_report_paths_stay_resolvable_across_repository_layouts") {
    dir :: isolated_cwd("machine_report_paths")
    runner :: dir.join("runner")
    fs.create_dir_all(&runner).unwrap()
    report :: (path: &OSPath) -> {
        output :: Command.new(jet()).args(["check", path.to_str().unwrap(), "--json"]).current_dir(&runner).env("NO_COLOR", "1").output().unwrap()
        assert_eq(output.status.code(), 1, "{String.from_utf8_lossy(&output.stderr)}")
        assert(output.stdout.is_empty())
        stderr :: String.from_utf8(output.stderr).unwrap()
        assert_eq(stderr.lines().count(), 1, "{stderr}")
        trimmed := stderr.trim() // #4303
        parse_json(trimmed).unwrap_or_else((_) -> panic("invalid diagnostic JSON: {stderr}"))
    }
    report_file :: (value: &DataTree) -> json_str(json_get(value, "file").unwrap()).unwrap().to_string()
    outside :: dir.join("outside/bad.jet")
    fs.create_dir_all(outside.parent().unwrap()).unwrap()
    fs.write(&outside, "fn run() {\n    pirnt(\"hi\")\n}\n").unwrap()
    assert_eq(report_file(&report(&outside)), outside.display().to_string())
    assert_eq(report_file(&report(&OSPath("../outside/bad.jet"))), outside.display().to_string())
    inside :: dir.join("repo/src/bad.jet")
    fs.create_dir_all(inside.parent().unwrap()).unwrap()
    fs.create_dir_all(dir.join("repo/.git")).unwrap()
    fs.write(&inside, "fn run() {\n    pirnt(\"hi\")\n}\n").unwrap()
    assert_eq(report_file(&report(&inside)), inside.display().to_string())
    stray_root :: dir.join("stray")
    stray :: stray_root.join("nested/bad.jet")
    fs.create_dir_all(stray.parent().unwrap()).unwrap()
    fs.create_dir_all(stray_root.join(".git")).unwrap()
    fs.write(&stray, "fn run() {\n    pirnt(\"hi\")\n}\n").unwrap()
    with_ancestor_git :: report_file(&report(&stray))
    fs.remove_dir(stray_root.join(".git")).unwrap()
    without_ancestor_git :: report_file(&report(&stray))
    assert_eq(with_ancestor_git, without_ancestor_git)
    assert_eq(without_ancestor_git, stray.display().to_string())
    fix :: dir.join("fix/bad.jet")
    fs.create_dir_all(fix.parent().unwrap()).unwrap()
    fs.write(&fix, "fn run() {\n    println(\"hi\")\n}\n").unwrap()
    fix_report :: report(&OSPath("../fix/bad.jet"))
    fix_file :: report_file(&fix_report)
    assert_eq(json_str(json_get(&fix_report, "applicability").unwrap()).unwrap(), "safe")
    edits :: match json_get(&fix_report, "fix_edits").unwrap() { DataTree.Array(edits) -> edits, _ -> panic("fix_edits is not an array") }
    assert_eq(edits.len(), 1)
    edit :: match &edits[0] { DataTree.Object(_) -> &edits[0], _ -> panic("fix edit is not an object") }
    edit_file :: json_str(json_get(&edits[0], "file").unwrap()).unwrap()
    assert_eq(fix_file, edit_file)
    span :: match json_get(edit, "span").unwrap() { DataTree.Object(_) -> json_get(edit, "span").unwrap(), _ -> panic("fix span is not an object") }
    start :: json_int(json_get(span, "start").unwrap()).unwrap() as USize
    end :: json_int(json_get(span, "end").unwrap()).unwrap() as USize
    new_text :: json_str(json_get(edit, "new_text").unwrap()).unwrap()
    assert_eq(json_str(json_get(edit, "safety").unwrap()).unwrap(), "behavior-preserving")
    fixed := fs.read_to_string(edit_file).unwrap()
    fixed.replace_range(start..end, new_text)
    fs.write(edit_file, &fixed).unwrap()
    assert_eq(fs.read_to_string(&fix).unwrap(), fixed)
    assert(!fixed.contains("println"))
    left :: dir.join("left/bad.jet")
    right :: dir.join("right/bad.jet")
    fs.create_dir_all(left.parent().unwrap()).unwrap()
    fs.create_dir_all(right.parent().unwrap()).unwrap()
    fs.write(&left, "fn run( {\n").unwrap()
    fs.write(&right, "fn run( {\n").unwrap()
    output :: Command.new(jet()).args(["fmt", "../left/bad.jet", "../right/bad.jet", "--json"]).current_dir(&runner).env("NO_COLOR", "1").output().unwrap()
    assert_eq(output.status.code(), 2, "{String.from_utf8_lossy(&output.stderr)}")
    reports :: String.from_utf8(output.stderr).unwrap()
    files :: reports.lines().map((line) -> report_file(&parse_json(line).unwrap())).collect::<[String]>()
    assert_eq(files, [left.display().to_string(), right.display().to_string()])
}
// Rust: tests/cli_parts/surface.rs:1159
#Test("e0102_and_e0111_typed_fix_edits_apply") {
    dir :: isolated_cwd("typed_fix_edits")
    typo :: dir.join("typo.jet")
    fs.write(&typo, "fn run() {\n    pirnt(\"hi\")\n}\n").unwrap()
    immutable :: dir.join("immutable.jet")
    fs.write(&immutable, "fn run() {\n    x :: 1\n    x = 2\n    print(x)\n}\n").unwrap()
    for (file, expected) in [(&typo, "fn run() {\n    print(\"hi\")\n}\n"), (&immutable, "fn run() {\n    x := 1\n    x = 2\n    print(x)\n}\n")] {
        output :: Command.new(jet()).args(["fix", file.to_str().unwrap()]).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
        assert_eq(output.status.code(), 0, "jet fix failed for {file.display()}: {String.from_utf8_lossy(&output.stderr)}")
        assert_eq(fs.read_to_string(file).unwrap(), expected)
    }
}
// Rust: tests/cli_parts/surface.rs:1195
#Test("name_suggestion_json_edit_applies_and_rechecks_clean") {
    dir :: isolated_cwd("name_suggestion_fix_edit")
    file :: dir.join("name.jet")
    fs.write(&file, "fn run() {\n    score :: 90\n    print(scor)\n}\n").unwrap()
    check :: () -> Command.new(jet()).args(["check", file.to_str().unwrap(), "--json"]).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
    output :: check()
    assert_eq(output.status.code(), 1)
    assert(output.stdout.is_empty())
    text :: String.from_utf8(output.stderr).unwrap()
    trimmed := text.trim() // #4303
    report :: parse_json(trimmed).unwrap()
    assert_eq(json_str(json_get(&report, "code").unwrap()).unwrap(), "E0107")
    edits :: match json_get(&report, "fix_edits").unwrap() { DataTree.Array(edits) -> edits, _ -> panic("fix_edits is not an array") }
    assert_eq(edits.len(), 1)
    edit :: &edits[0]
    edit_file :: json_str(json_get(edit, "file").unwrap()).unwrap()
    assert_eq(edit_file, file.to_str().unwrap())
    span :: json_get(edit, "span").unwrap()
    start :: json_int(json_get(span, "start").unwrap()).unwrap() as USize
    end :: json_int(json_get(span, "end").unwrap()).unwrap() as USize
    new_text :: json_str(json_get(edit, "new_text").unwrap()).unwrap()
    source :: fs.read_to_string(&file).unwrap()
    assert_eq(&source[start..end], "scor")
    assert_eq(new_text, "score")
    applied :: Command.new(jet()).args(["fix", file.to_str().unwrap()]).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
    assert_eq(applied.status.code(), 0, "{String.from_utf8_lossy(&applied.stderr)}")
    expected := ^source
    expected.replace_range(start..end, new_text)
    assert_eq(fs.read_to_string(&file).unwrap(), expected)
    fixed :: check()
    assert_eq(fixed.status.code(), 0, "{String.from_utf8_lossy(&fixed.stderr)}")
    assert(fixed.stdout.is_empty())
    assert(fixed.stderr.is_empty())
}
// Rust: tests/cli_parts/surface.rs:1507
#Test("agent_fix_loop_corpus_converges_without_report_regression") {
    dir :: isolated_cwd("agent_fix_loop")
    initial := RepairState{}
    for (name, source) in AGENT_FIX_LOOP_FIXTURES {
        file :: dir.join(name)
        fs.write(&file, source).unwrap()
        initial.insert(^file, source.to_string())
    }
    run_file :: dir.join("run.jet")
    helper_file :: dir.join("helper.jet")
    check :: (state: &RepairState) -> check_repair_state(&dir, state)
    initial_reports :: check(&initial)
    assert(initial_reports.iter().all((report) -> !report.edits.is_empty()), "every fixture report must carry fix_edits: {initial_reports:?}")
    edits_per_file := [OSPath:USize]{}
    for edit in initial_reports.iter().flat_map((report) -> &report.edits) { edits_per_file.entry(edit.file.clone()).or_insert(0) += 1 }
    assert_eq(edits_per_file.keys().cloned().collect::<BTreeSet<OSPath>>(), initial.keys().cloned().collect::<BTreeSet<OSPath>>(), "one repair-loop round must report edits for every fixture file")
    assert(edits_per_file[&run_file] >= 3, "run.jet needs several errors")
    assert(edits_per_file[&helper_file] >= 3, "helper.jet needs several errors")
    bound_error :: run_repair_loop(initial.clone(), 0, check).unwrap_err()
    assert(bound_error.contains("round bound 0") && bound_error.contains("E0102"), "bound failure must name offending code: {bound_error}")
    (final_state, rounds) :: run_repair_loop(^initial, AGENT_FIX_LOOP_MAX_ROUNDS, check).unwrap()
    assert(rounds <= AGENT_FIX_LOOP_MAX_ROUNDS)
    assert(check(&final_state).is_empty(), "final recheck was not clean")
    assert_eq(final_state[&run_file], "fn run() {\n    print(\"main typo\")\n    score :: 90\n    print(score)\n    print(\"main old\")\n}\n")
    assert_eq(final_state[&helper_file], "fn run() {\n    print(\"helper typo\")\n    score :: 90\n    print(score)\n    print(\"helper old\")\n}\n")
}
// Rust: tests/cli_parts/surface.rs:1580
#Test("agent_fix_loop_repeat_guard_names_offending_code") {
    file :: OSPath("repeat.jet")
    state :: [file.clone(): "x"]
    forward :: RepairReport{code: "E0102", edits: [RepairEdit{code: "E0102", file: file.clone(), start: 0, end: 1, new_text: "y"}]}
    backward :: RepairReport{code: "E0102", edits: [RepairEdit{code: "E0102", file: file.clone(), start: 0, end: 1, new_text: "x"}]}
    error :: run_repair_loop(state, 3, (state) -> if state[&file] == "x" { [forward.clone()] } else { [backward.clone()] }).unwrap_err()
    assert(error.contains("repeated file state") && error.contains("E0102"), "repeat failure must name offending code: {error}")
}
// Rust: tests/cli_parts/surface.rs:1618
#Test("agent_fix_loop_regression_guard_names_offending_code") {
    file :: OSPath("regression.jet")
    state :: [file.clone(): "x"]
    first_report :: RepairReport{code: "E0102", edits: [RepairEdit{code: "E0102", file: file.clone(), start: 0, end: 1, new_text: "y"}]}
    introduced_report :: RepairReport{code: "E0037", edits: [RepairEdit{code: "E0037", file: ^file, start: 0, end: 1, new_text: "z"}]}
    checks := 0
    error :: run_repair_loop(state, 2, (_) -> {
        checks += 1
        if checks == 1 { [first_report.clone()] } else { [introduced_report.clone()] }
    }).unwrap_err()
    assert(error.contains("fix_edit regression") && error.contains("E0037"), "regression failure must name offending code: {error}")
}
// Rust: tests/cli_parts/surface.rs:1658
#Test("fix_safety_tiers_are_reported_and_applied") {
    dir :: isolated_cwd("typed_fix_edits")
    typo :: dir.join("typo.jet")
    fs.write(&typo, "fn run() {\n    pirnt(\"hi\")\n}\n").unwrap()
    formatting :: dir.join("formatting.jet")
    fs.write(&formatting, "fn run() {\n    loop item; [1, 2, 3] { print(item) }\n}\n").unwrap()
    immutable :: dir.join("immutable.jet")
    immutable_source :: "fn run() {\n    x :: 1\n    x = 2\n    print(x)\n}\n"
    fs.write(&immutable, immutable_source).unwrap()
    report_grades :: (file: &OSPath) -> {
        output :: Command.new(jet()).args(["check", file.to_str().unwrap(), "--json"]).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
        assert_eq(output.status.code(), 1, "{String.from_utf8_lossy(&output.stderr)}")
        text :: String.from_utf8(output.stderr).unwrap()
        trimmed := text.trim() // #4303
        report :: parse_json(trimmed).unwrap()
        applicability :: json_str(json_get(&report, "applicability").unwrap()).unwrap().to_string()
        edits :: match json_get(&report, "fix_edits").unwrap() { DataTree.Array(edits) -> edits, _ -> panic("fix_edits is not an array") }
        assert_eq(edits.len(), 1)
        safety :: json_str(json_get(&edits[0], "safety").unwrap()).unwrap().to_string()
        (applicability, safety)
    }
    assert_eq(report_grades(&formatting), ("safe", "formatting"))
    assert_eq(report_grades(&immutable), ("suggested", "api-changing"))
    output :: Command.new(jet()).args(["fix", typo.to_str().unwrap()]).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
    assert_eq(output.status.code(), 0, "jet fix failed: {String.from_utf8_lossy(&output.stderr)}")
    assert_eq(fs.read_to_string(&typo).unwrap(), "fn run() {\n    print(\"hi\")\n}\n")
    output :: Command.new(jet()).args(["fix", formatting.to_str().unwrap()]).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
    assert_eq(output.status.code(), 0)
    assert(fs.read_to_string(&formatting).unwrap().contains("loop item in"))
    output :: Command.new(jet()).args(["fix", immutable.to_str().unwrap()]).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
    assert_eq(output.status.code(), 0)
    assert_eq(fs.read_to_string(&immutable).unwrap(), immutable_source)
    assert(String.from_utf8_lossy(&output.stdout).contains("skipped 1 suggestion"))
    output :: Command.new(jet()).args(["fix", immutable.to_str().unwrap(), "--all"]).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
    assert_eq(output.status.code(), 0)
    assert(fs.read_to_string(&immutable).unwrap().contains("x := 1"))
}
// Rights-widening E1803 repair is reported unless --all inserts the full inline package.
// Rust: tests/cli_parts/surface.rs:1765
#Test("fix_all_inserts_script_inline_authority_block") {
    dir :: isolated_cwd("fix_script_authority")
    script :: dir.join("gradient.jet")
    source :: "// Writes a file.\nuse core.files as files\n\nfn run() {\n    files.write(\"out.txt\", \"hi\") ?? panic(\"write failed\")\n    print(\"wrote\")\n}\n"
    fs.write(&script, source).unwrap()
    jet_in :: (args: &[String]) -> Command.new(jet()).args(args).current_dir(&dir).env("NO_COLOR", "1").stdin(Stdio.null()).output().unwrap()
    refused :: jet_in(&["run", "gradient.jet"])
    stderr :: String.from_utf8_lossy(&refused.stderr)
    assert(!refused.status.success() && stderr.contains("E1803") && stderr.contains("allow: [FS, IO]"), "{stderr}")
    assert(!dir.join("out.txt").exists(), "a refused run must not write")
    reported :: jet_in(&["fix", "gradient.jet"])
    assert_eq(reported.status.code(), 0)
    assert_eq(fs.read_to_string(&script).unwrap(), source)
    assert(String.from_utf8_lossy(&reported.stdout).contains("1 suggestion"))
    applied :: jet_in(&["fix", "gradient.jet", "--all"])
    assert_eq(applied.status.code(), 0)
    assert_eq(fs.read_to_string(&script).unwrap(), "// Writes a file.\npackage {\n    name: \"gradient\"\n    authority: { holds: { allow: [FS, IO] } }\n}\n\nuse core.files as files\n\nfn run() {\n    files.write(\"out.txt\", \"hi\") ?? panic(\"write failed\")\n    print(\"wrote\")\n}\n")
    ran :: jet_in(&["run", "gradient.jet"])
    assert(ran.status.success(), "{String.from_utf8_lossy(&ran.stderr)}")
    assert_eq(String.from_utf8_lossy(&ran.stdout), "wrote\n")
    assert_eq(fs.read_to_string(dir.join("out.txt")).unwrap(), "hi")
}
