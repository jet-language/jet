// Rust: tests/cli_parts/surface.rs:288
#Test("external_completion_preserves_checked_program_commands") {
    dir :: isolated_cwd("shape_cli_program_commands")
    fs.write(dir.join("commands.jet"), "#CLI(Standard)\nstruct Commands {\n    #[Doc(\"shared config\"), Short(\"c\"), Env(\"JET_CONFIG\")] config: String{\"default\"}\n    #Doc(\"start the service\") fn serve(self, port: Int{3000}) {}\n    #Doc(\"import one file\") fn import(self, file: String) {}\n}\nfn run(args: Commands) {}\n").unwrap()
    build :: Command.new(jet()).args(["build", "commands.jet"]).current_dir(&dir).output().unwrap()
    assert(build.status.success(), "program build failed: {String.from_utf8_lossy(&build.stderr)}")
    help :: Command.new(dir.join(".jet/build/commands")).arg("--help").current_dir(&dir).output().unwrap()
    assert(help.status.success(), "program root help failed: {String.from_utf8_lossy(&help.stderr)}")
    text :: String.from_utf8(help.stdout).unwrap()
    assert(text.contains("--config CONFIG"), "root help omitted shared config: {text}")
    assert_eq(text.matches("--config").count(), 1, "root help repeated shared config: {text}")
    assert(!text.contains("Serve") && !text.contains("Import"))
    for shell in ["bash", "zsh", "fish", "powershell"] {
        completion :: Command.new(jet()).args(["self", "completions", shell, "--for", "build/commands"]).current_dir(&dir).output().unwrap()
        assert(completion.status.success(), "{shell} subcommand completion failed: {String.from_utf8_lossy(&completion.stderr)}")
        script :: String.from_utf8(completion.stdout).unwrap()
        expected :: match shell {
            "bash" -> ["serve", "import", "--port", "file --file", "--config"],
            "zsh" -> ["serve", "import", "--port", ":file:value for --file", "--config"],
            "fish" -> ["serve", "import", "-l port", "-l file", "-l config"],
            "powershell" -> ["serve", "import", "'--port'", "'file','--file'", "'--config'"],
            _ -> unreachable()
        }
        for fragment in expected { assert(script.contains(fragment), "{shell} external completion omitted {fragment}: {script}") }
        assert(script.contains("--verbose") || script.contains("-l verbose") || script.contains("'--verbose'"), "{shell} omitted the Standard root flags: {script}")
        assert(script.contains("--quiet") || script.contains("-l quiet") || script.contains("'--quiet'"), "{shell} omitted the Standard root flags: {script}")
        assert(script.contains("--color") || script.contains("-l color") || script.contains("'--color'"), "{shell} omitted the Standard root flags: {script}")
        check_snapshot("shape_cli_program_{shell}.txt", &script)
    }
}
// Rust: tests/cli_parts/surface.rs:395
#Test("derived_help_uses_program_basename_for_compiled_and_jet_run_paths") {
    dir :: isolated_cwd("shape_cli_help_program_name")
    fs.write(dir.join("typed.jet"), "#CLI\nstruct RunArgs { verbose: Bool }\nfn run(args: RunArgs) {}\n").unwrap()
    build :: Command.new(jet()).args(["build", "typed.jet"]).current_dir(&dir).output().unwrap()
    assert(build.status.success(), "typed build failed: {String.from_utf8_lossy(&build.stderr)}")
    built :: dir.join(".jet/build/typed").canonicalize().unwrap()
    compiled_help :: Command.new(&built).arg("--help").current_dir(&dir).output().unwrap()
    assert(compiled_help.status.success(), "compiled typed help failed: {String.from_utf8_lossy(&compiled_help.stderr)}")
    run_help :: Command.new(jet()).args(["run", "typed.jet", "--", "--help"]).current_dir(&dir).output().unwrap()
    assert(run_help.status.success(), "jet run typed help failed: {String.from_utf8_lossy(&run_help.stderr)}")
    program_names :: "compiled: {String.from_utf8(compiled_help.stdout).unwrap().lines().next().unwrap()}\njet run: {String.from_utf8(run_help.stdout).unwrap().lines().next().unwrap()}\n"
    check_snapshot("shape_cli_help_program_names.txt", &program_names)
}
// Rust: tests/cli_parts/surface.rs:453
#Test("derived_program_help_uses_program_basename_for_compiled_and_jet_run_paths") {
    dir :: isolated_cwd("shape_cli_program_help_program_name")
    fs.write(dir.join("commands.jet"), "#CLI\nstruct Commands { fn serve(self) {} }\nfn run(args: Commands) {}\n").unwrap()
    build :: Command.new(jet()).args(["build", "commands.jet"]).current_dir(&dir).output().unwrap()
    assert(build.status.success(), "program build failed: {String.from_utf8_lossy(&build.stderr)}")
    built :: dir.join(".jet/build/commands").canonicalize().unwrap()
    compiled_root :: Command.new(&built).arg("--help").current_dir(&dir).output().unwrap()
    compiled_sub :: Command.new(&built).args(["serve", "--help"]).current_dir(&dir).output().unwrap()
    run_root :: Command.new(jet()).args(["run", "commands.jet", "--", "--help"]).current_dir(&dir).output().unwrap()
    run_sub :: Command.new(jet()).args(["run", "commands.jet", "--", "serve", "--help"]).current_dir(&dir).output().unwrap()
    for (label, output) in [("compiled root", &compiled_root), ("compiled subcommand", &compiled_sub), ("jet run root", &run_root), ("jet run subcommand", &run_sub)] {
        assert(output.status.success(), "{label} help failed: {String.from_utf8_lossy(&output.stderr)}")
    }
    first_line :: (output: Output) -> String.from_utf8(output.stdout).unwrap().lines().next().unwrap().to_string()
    program_names :: "compiled root: {first_line(compiled_root)}\ncompiled subcommand: {first_line(compiled_sub)}\njet run root: {first_line(run_root)}\njet run subcommand: {first_line(run_sub)}\n"
    check_snapshot("shape_cli_program_help_program_names.txt", &program_names)
}
// Rust: tests/cli_parts/surface.rs:524
#Test("moved_bare_commands_are_teaching_errors_not_aliases") {
    for (verb, replacement) in [("publish", "jet registry publish"), ("semindex", "jet inspect semindex"), ("doctor", "jet self doctor"), ("lsp", "jet self lsp"), ("devtools", "jet self devtools"), ("push", "jet os push")] {
        out :: Command.new(jet()).arg(verb).arg("sentinel").output().unwrap()
        assert_eq(out.status.code(), 2, "{verb} must be rejected")
        stderr :: String.from_utf8_lossy(&out.stderr)
        assert(stderr.contains("E2101"), "{verb}: {stderr}")
        assert(stderr.contains(replacement), "{verb}: {stderr}")
    }
    out :: Command.new(jet()).args(["lsp", "--json"]).output().unwrap()
    assert_eq(out.status.code(), 2)
    assert(out.stderr.is_empty())
    stdout :: String.from_utf8_lossy(&out.stdout)
    assert(stdout.contains("\"code\":\"E2101\""))
    assert(stdout.contains("jet self lsp --json"))
}
// Semantic retirements have zero generated rows but reach registry-owned teaching refusals.
// Rust: tests/cli_parts/surface.rs:559
#Test("retired_cli_routes_are_absent_but_teach_real_spelling") {
    surfaces :: [CLI.usage_page("0.0.0", CLI.HelpOrder.Frequency), CLI.man_page("0.0.0"), CLI.completions_bash(), CLI.completions_zsh(), CLI.completions_fish(), CLI.completions_powershell()]
    top_help :: Command.new(jet()).arg("--help").output().unwrap()
    assert(top_help.status.success(), "jet --help failed: {top_help:?}")
    text :: String.from_utf8_lossy(&top_help.stdout)
    for retired in CLI.RETIRED_COMMANDS {
        needle :: "jet {retired.spelling}"
        assert(surfaces.iter().all((surface) -> !surface.contains(&needle)), "retired route leaked into generated surface: {needle}")
        assert(!text.contains(&needle), "retired route leaked into `jet --help`: {needle}")
    }
    for (argv, replacement) in [(["gc"], "jet clean"), (["serve"], "jet dev <file.jet> --swap"), (["store"], "jetpack hangar / jet clean / jet fetch"), (["store", "fetch"], "jet fetch"), (["store", "verify"], "jetpack hangar verify"), (["store", "generations"], "jetpack hangar"), (["store", "rollback", "2"], "jetpack hangar"), (["store", "gc"], "jet clean"), (["store", "lock", "stats.jet"], "jet fetch --lock stats.jet"), (["serve", "main.jet"], "jet dev main.jet --swap"), (["lock", "stats.jet"], "jet fetch --lock stats.jet")] {
        out :: Command.new(jet()).args(&argv).output().unwrap()
        assert_eq(out.status.code(), 2, "{argv:?} must be rejected")
        stderr :: String.from_utf8_lossy(&out.stderr)
        assert(stderr.contains("E2101"), "{argv:?}: {stderr}")
        assert(stderr.contains(replacement), "{argv:?}: {stderr}")
    }
}
// Rust: tests/cli_parts/surface.rs:611
#Test("moved_command_registry_agrees_with_dispatch_exceptions") {
    declared := [String]{}
    for group in CLI.command_groups() {
        for action in group.actions {
            dispatch_exempts :: CLI.moved_command(action.name).is_none() && action.name != "install"
            assert_eq(action.also_canonical_top_level, dispatch_exempts, "registry and moved_command disagree for {group.name} {action.name}")
            if action.also_canonical_top_level { declared.push("{group.name} {action.name}") }
        }
    }
    assert_eq(declared, ["inspect audit", "env test", "gc report", "perf run", "perf test"])
}
// Rust: tests/cli_parts/surface.rs:640
#Test("test_help_exposes_measurement_and_retired_command_teaches_it") {
    test_help :: Command.new(jet()).args(["test", "--help"]).env("NO_COLOR", "1").output().unwrap()
    assert(test_help.status.success(), "jet test --help failed: {String.from_utf8_lossy(&test_help.stderr)}")
    text :: String.from_utf8_lossy(&test_help.stdout)
    assert(text.contains("--filter"), "test help lost shared filter flag: {text}")
    assert(text.contains("--measure"), "test help omitted measurement mode: {text}")
    assert(text.contains("--show-default"), "test help missing command override escape hatch: {text}")
    retired :: Command.new(jet()).args(["bench", "--help"]).env("NO_COLOR", "1").output().unwrap()
    assert(!retired.status.success(), "retired measurement command unexpectedly succeeded")
    text :: String.from_utf8_lossy(&retired.stderr)
    assert(text.contains("jet test --measure"), "retired command did not teach measurement: {text}")
}
// I8: coverage names only; whole-artifact goldens belong to commands.rs.
// Rust: tests/cli_parts/surface.rs:688
#Test("coverage_help_matches_instrumentation") {
    // Rust: tests/cli_parts/surface.rs:689
    COVERAGE_HELP :: "function and branch coverage"
    help :: Command.new(jet()).args(["test", "--help"]).env("NO_COLOR", "1").output().unwrap()
    assert(help.status.success(), "jet test --help failed: {String.from_utf8_lossy(&help.stderr)}")
    text :: String.from_utf8_lossy(&help.stdout)
    assert(text.contains("--coverage") && text.contains(COVERAGE_HELP), "{text}")
    assert(!text.contains("function and line coverage"), "{text}")
    for shell in ["bash", "fish", "zsh", "powershell"] {
        completion :: Command.new(jet()).args(["self", "completions", shell]).output().unwrap()
        assert(completion.status.success(), "{shell} completion failed: {String.from_utf8_lossy(&completion.stderr)}")
        script :: String.from_utf8_lossy(&completion.stdout)
        coverage_flag :: if shell == "fish" { "-l coverage" } else { "--coverage" }
        assert(script.contains(coverage_flag), "{shell} omitted {coverage_flag}")
        if shell == "fish" || shell == "zsh" { assert(script.contains(COVERAGE_HELP), "{shell}: {script}") }
        assert(!script.contains("function and line coverage"), "{shell}: {script}")
    }
    man :: Command.new(jet()).args(["self", "man"]).output().unwrap()
    assert(man.status.success(), "man page failed: {String.from_utf8_lossy(&man.stderr)}")
    text :: String.from_utf8_lossy(&man.stdout)
    assert(text.contains(COVERAGE_HELP), "{text}")
    assert(!text.contains("function and line coverage"), "{text}")
}
