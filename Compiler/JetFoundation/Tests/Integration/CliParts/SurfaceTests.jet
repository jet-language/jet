// GATE #4494: native process/filesystem providers; #4499: OSPath map keys.
// Rust: tests/cli_parts/surface.rs:7
#Test("target_equals_and_space_forms_match_for_build_run_and_dev") {
    host :: String.from_utf8(Command.new("rustc").args(["-vV"]).output().expect("rustc must report its host target").stdout).unwrap().lines().find_map((line) -> line.strip_prefix("host: ").map((value) -> value.to_string())).expect("rustc -vV must include a host target")
    target :: ["wasm32-unknown-unknown", "aarch64-unknown-linux-gnu", "x86_64-pc-windows-gnu"].into_iter().find((candidate) -> {
        if candidate == host { return false }
        output :: Command.new("rustc").args(["--print", "target-libdir", "--target", candidate]).output() ?? return false
        path := String.from_utf8_lossy(&output.stdout).trim() // #4303
        output.status.success() && OSPath(path).is_dir()
    }).expect("rustc must provide an installed non-host target")
    invoke :: (tag: String, command: String, source: String, target: String?, spaced: Bool) -> {
        dir :: isolated_cwd(tag)
        fs.write(dir.join("main.jet"), source).unwrap()
        args := [command.to_string(), "main.jet"]
        if spaced {
            args.push("--target")
            if target :: target { args.push(target.to_string()) }
        } else if target :: target { args.push("--target={target}") }
        Command.new(jet()).args(args).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    }
    for (command, source) in [("build", "fn run() { print(\"target\") }\n"), ("run", "fn run() { print(\"target\") }\n"), ("dev", "fn dev() { print(\"target\") }\n")] {
        equals :: invoke("target_{command}_equals", command, source, Val(target), false)
        space :: invoke("target_{command}_space", command, source, Val(target), true)
        assert_eq(equals.status.code(), 0, "{command} equals failed: {String.from_utf8_lossy(&equals.stderr)}")
        assert_eq(space.status.code(), 0, "{command} space failed: {String.from_utf8_lossy(&space.stderr)}")
        assert_eq(equals.stdout, space.stdout, "{command} target forms changed stdout")
        assert_eq(equals.stderr, space.stderr, "{command} target forms changed stderr")
    }
    unknown :: "definitely-not-a-rust-target"
    for (command, source) in [("build", "fn run() {}\n"), ("run", "fn run() {}\n"), ("dev", "fn run() {}\n")] {
        equals :: invoke("target_{command}_unknown_equals", command, source, Val(unknown), false)
        space :: invoke("target_{command}_unknown_space", command, source, Val(unknown), true)
        assert_eq(equals.status.code(), 1, "{command} equals did not reject target: {String.from_utf8_lossy(&equals.stderr)}")
        assert_eq(space.status.code(), 1, "{command} space did not reject target: {String.from_utf8_lossy(&space.stderr)}")
        assert_eq(equals.stderr, space.stderr, "{command} target forms changed normalized E3302 output")
        stderr :: String.from_utf8_lossy(&equals.stderr)
        assert(stderr.contains("Error [E3302]:"), "{command} missing E3302: {stderr}")
        check_snapshot("unknown_target_e3302.txt", &stderr)
    }
    for (command, source) in [("build", "fn run() {}\n"), ("run", "fn run() {}\n"), ("dev", "fn run() {}\n")] {
        for (suffix, spaced) in [("space", true), ("equals", false)] {
            value :: if spaced { None } else { Val("") }
            out :: invoke("target_{command}_missing_{suffix}", command, source, value, spaced)
            assert_eq(out.status.code(), 2, "{command} missing target value was not rejected: {String.from_utf8_lossy(&out.stderr)}")
            stderr :: String.from_utf8_lossy(&out.stderr)
            assert(stderr.contains("Error [E2104]:"), "{command} missing target value lost E2104: {stderr}")
            assert(stderr.contains("`--target` needs a value"), "{command} missing target value was not truthful: {stderr}")
        }
    }
}
// Rust: tests/cli_parts/surface.rs:180
#Test("top_level_help_is_registry_inventory_and_env_help_lists_live_actions") {
    has_route :: (text: String, route: String) -> text.lines().any((line) -> {
        line := line.trim_start() // #4303
        line == "jet {route}" || line.starts_with("jet {route} ")
    })
    for flag in ["--help", "help"] {
        out :: Command.new(jet()).arg(flag).env("NO_COLOR", "1").output().unwrap()
        assert(out.status.success(), "{flag}: {out:?}")
        stdout :: String.from_utf8_lossy(&out.stdout)
        assert(!stdout.to_ascii_lowercase().contains("hangar"), "jet help advertised the environment Hangar: {stdout}")
        for command in CLI.COMMANDS.iter().filter((command) -> CLI.is_canonical_top_level(command.name)) {
            assert(has_route(stdout, command.name), "help omitted {command.name}: {stdout}")
        }
        for retired in CLI.RETIRED_COMMANDS { assert(!has_route(stdout, retired.spelling), "help advertised retired {retired.spelling}: {stdout}") }
    }
    env_help :: Command.new(jet()).args(["env", "--help"]).output().unwrap()
    assert(env_help.status.success(), "env help failed: {env_help:?}")
    text :: String.from_utf8_lossy(&env_help.stdout)
    for action in ["hook", "test", "sync", "info"] { assert(text.contains("jet env {action}"), "env help omitted {action}: {text}") }
    completions :: [Command.new(jet()).args(["self", "completions", "bash"]).output().unwrap(), Command.new(jet()).args(["self", "completions", "zsh"]).output().unwrap(), Command.new(jet()).args(["self", "completions", "fish"]).output().unwrap(), Command.new(jet()).args(["self", "completions", "powershell"]).output().unwrap()]
    for output in completions {
        assert(output.status.success(), "completion failed: {output:?}")
        text :: String.from_utf8_lossy(&output.stdout)
        assert(text.contains("env"), "completion omitted env: {text}")
    }
    man :: CLI.man_page("0.0.0")
    for retired in CLI.RETIRED_COMMANDS {
        assert(!man.lines().any((line) -> line.trim() == ".B {retired.spelling}"), "man advertised retired {retired.spelling}: {man}")
    }
}
