// Rust: tests/cli_parts/surface.rs:763
#Test("every_moved_bare_action_is_e2101_in_human_and_json_modes") {
    for group in CLI.command_groups() {
        for action in group.actions {
            owner :: CLI.moved_command_group(action.name) ?? continue
            replacement :: "jet {owner} {action.name}"
            out :: Command.new(jet()).arg(action.name).arg("sentinel").output().unwrap()
            assert_eq(out.status.code(), 2, "bare {action.name}")
            stderr :: String.from_utf8_lossy(&out.stderr)
            assert(stderr.contains("E2101") && stderr.contains(&replacement), "{action.name}: {stderr}")
            out :: Command.new(jet()).args([action.name, "sentinel\\\"quoted", "--json"]).output().unwrap()
            assert_eq(out.status.code(), 2, "bare {action.name} --json")
            assert(out.stderr.is_empty(), "JSON diagnostic leaked stderr for {action.name}")
            stdout :: String.from_utf8_lossy(&out.stdout)
            assert(stdout.contains("\"code\":\"E2101\"") && stdout.contains(&replacement), "{action.name}: {stdout}")
            assert(stdout.contains("sentinel\\\\\\\"quoted"), "replacement was not JSON escaped: {stdout}")
        }
    }
}
// Rust: tests/cli_parts/surface.rs:808
#Test("invalid_nested_action_is_e2101_and_json_escaped") {
    bad :: "bad\\\"action"
    // Non-exhaustive os falls through to its real dispatcher, not registry E2101.
    for group in CLI.command_groups().filter((group) -> group.exhaustive) {
        out :: Command.new(jet()).args([group.name, bad]).output().unwrap()
        assert_eq(out.status.code(), 2)
        stderr :: String.from_utf8_lossy(&out.stderr)
        assert(stderr.contains("E2101") && stderr.contains(bad), "{stderr}")
        out :: Command.new(jet()).args([group.name, bad, "--json"]).output().unwrap()
        assert_eq(out.status.code(), 2)
        assert(out.stderr.is_empty())
        stdout :: String.from_utf8_lossy(&out.stdout)
        assert(stdout.contains("bad\\\\\\\"action"), "invalid JSON escaping: {stdout}")
        assert(!stdout.contains("`bad\\\"action`"), "raw quote leaked into JSON: {stdout}")
    }
}
