// Rust: tests/cli_parts/surface.rs:889
#Test("group_help_and_man_inventory_every_nested_description") {
    man :: Command.new(jet()).args(["self", "man"]).output().unwrap()
    assert_eq(man.status.code(), 0)
    text :: String.from_utf8_lossy(&man.stdout)
    for group in CLI.command_groups() {
        // Non-exhaustive groups retain their dispatcher's help; static man inventory still applies.
        if group.exhaustive {
            out :: Command.new(jet()).args([group.name, "help"]).output().unwrap()
            assert_eq(out.status.code(), 0)
            help :: String.from_utf8_lossy(&out.stdout)
            assert(help.contains(group.summary), "{group.name} help missing summary")
            for action in group.actions { assert(help.contains(action.name) && help.contains(action.summary), "{group.name} help missing {action.name}") }
        }
        for action in group.actions {
            assert(text.contains(".B {group.name} {action.name}"), "man missing {group.name} {action.name}")
            assert(text.contains(action.summary), "man missing summary for {group.name} {action.name}")
        }
    }
}
// Rust: tests/cli_parts/surface.rs:938
#Test("palette_uses_canonical_nested_routes") {
    for group in CLI.command_groups() {
        for action in group.actions {
            route :: "{group.name} {action.name}"
            out :: Command.new(jet()).args(["?", &route]).output().unwrap()
            assert_eq(out.status.code(), 0)
            stdout :: String.from_utf8_lossy(&out.stdout)
            assert(stdout.contains(&route), "palette missing {route}: {stdout}")
            assert(!stdout.contains("jet {action.name}   "), "palette advertised bare moved action {action.name}")
        }
