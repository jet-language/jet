//RS         if let Ok(relative) = file.strip_prefix(temp_root) {
//RS             scrubbed = scrubbed.replace(&relative.display().to_string(), "BAD.jet");
//RS         }
//RS     }
//RS     if let Some(name) = file.file_name().and_then(|n| n.to_str()) {
//RS         scrubbed = scrubbed.replace(name, "BAD.jet");
//RS     }
//RS     scrubbed
//RS }
