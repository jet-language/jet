use std.fs
use std.process.Command
use std.collections.BTreeSet
use jet_foundation.DataTree.DataTree
use jet_foundation.JSON.[json_get, json_int, json_str, parse_json]
use jet_foundation.Tests.Integration.CliParts.Support.jet
// GATE #4494: actual process and filesystem providers. #4499: OSPath map keys.
// Rust: tests/cli_parts/surface.rs:1267
const AGENT_FIX_LOOP_MAX_ROUNDS: USize = 4
// Rust: tests/cli_parts/surface.rs:1268
const AGENT_FIX_LOOP_FIXTURES: [(String, String)] = [
    ("run.jet", "fn run() {\n    pirnt(\"main typo\")\n    score :: 90\n    print(scor)\n    println(\"main old\")\n}\n"),
    ("helper.jet", "fn run() {\n    pirnt(\"helper typo\")\n    score :: 90\n    print(scor)\n    println(\"helper old\")\n}\n")
]
// Rust: tests/cli_parts/surface.rs:1292
#Derive(Debug, Clone)
struct RepairEdit {
    code: String
    file: OSPath
    start: USize
    end: USize
    new_text: String
}
// Rust: tests/cli_parts/surface.rs:1301
#Derive(Debug, Clone)
struct RepairReport {
    code: String
    edits: [RepairEdit]
}
// Rust: tests/cli_parts/surface.rs:1306
 type RepairState = [OSPath:String]
// Rust: tests/cli_parts/surface.rs:1308
fn repair_json_field(value: &DataTree, key: &String) -> &DataTree {
    json_get(value, key).unwrap_or_else(() -> panic("machine report missing {key}"))
}
// Rust: tests/cli_parts/surface.rs:1312
fn repair_json_string(value: &DataTree, key: &String) -> String {
    json_str(repair_json_field(value, key)).unwrap_or_else(() -> panic("machine report {key} is not a string")).to_string()
}
// Rust: tests/cli_parts/surface.rs:1318
fn repair_json_usize(value: &DataTree, key: &String) -> USize {
    USize.try_from(json_int(repair_json_field(value, key)).unwrap_or_else(() -> panic("machine report {key} is not an integer"))).unwrap_or_else((_) -> panic("machine report {key} is negative"))
}
// Rust: tests/cli_parts/surface.rs:1326
fn parse_repair_report(value: &DataTree) -> RepairReport {
    assert_eq(repair_json_string(value, "schema"), "jet.report/v2")
    code :: repair_json_string(value, "code")
    edits :: match repair_json_field(value, "fix_edits") {
        DataTree.Array(edits) -> edits.iter().map((edit) -> {
            span :: repair_json_field(edit, "span")
            RepairEdit{code: code.clone(), file: OSPath(repair_json_string(edit, "file")), start: repair_json_usize(span, "start"), end: repair_json_usize(span, "end"), new_text: repair_json_string(edit, "new_text")}
        }).collect(),
        _ -> panic("machine report fix_edits is not an array")
    }
    RepairReport{code: ^code, edits: ^edits}
}
// Rust: tests/cli_parts/surface.rs:1348
fn parse_repair_reports(value: &DataTree) -> [RepairReport] {
    assert_eq(repair_json_string(value, "schema"), "jet.status/v1")
    assert_eq(repair_json_string(value, "action"), "check")
    match repair_json_field(value, "reports") {
        DataTree.Array(reports) -> reports.iter().map(parse_repair_report).collect(),
        _ -> panic("machine status reports is not an array")
    }
}
// Read only published status/report fields; human What/Why/Fix text never participates.
// Rust: tests/cli_parts/surface.rs:1359
fn check_repair_state(dir: &OSPath, state: &RepairState) -> [RepairReport] {
    files := state.keys().cloned().collect(); files.sort()
    for file in &files { fs.write(file, &state[file]).unwrap() }
    reports := [RepairReport]{}
    for file in files {
        output :: Command.new(jet()).args(["check", file.to_str().unwrap(), "--json"]).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
        assert(output.stderr.is_empty(), "JSON check wrote stderr: {output.stderr:?}")
        text :: String.from_utf8(output.stdout).unwrap()
        trimmed := text.trim() // #4303
        status :: parse_json(trimmed).expect("JSON check must emit one status object")
        assert_eq(repair_json_string(&status, "schema"), "jet.status/v1")
        assert_eq(repair_json_string(&status, "action"), "check")
        if output.status.success() {
            assert(match json_get(&status, "ok") { Val(DataTree.Bool(true)) -> true, _ -> false })
            assert(parse_repair_reports(&status).is_empty(), "clean check must have no reports")
        } else {
            assert_eq(output.status.code(), 1, "check failed: {status:?}")
            reports.extend(parse_repair_reports(&status))
        }
    }
    reports
}
// Rust: tests/cli_parts/surface.rs:1400
fn apply_repair_edits(state: &RepairState, reports: &[RepairReport]) -> RepairState Err! {
    by_file := [OSPath:[RepairEdit]]{}
    for report in reports {
        if report.edits.is_empty() { throw "report {report.code} has no fix_edits" }
        for edit in &report.edits { by_file.entry(edit.file.clone()).or_default().push(edit.clone()) }
    }
    next := state.clone()
    files := by_file.keys().cloned().collect(); files.sort()
    for file in files {
        edits := by_file.remove(&file).unwrap()
        source :: state.get(&file) ?? {
            code :: edits.first().map_or("unknown", (edit) -> edit.code.as_str())
            throw "fix_edit for {code} names untracked file {file.display()}"
        }
        edits.sort_by((left, right) -> right.start.cmp(&left.start).then(right.end.cmp(&left.end)))
        for pair in edits.windows(2) {
            if pair[0].start < pair[1].end {
                throw "overlapping fix_edits for {pair[0].code} and {pair[1].code} in {file.display()}"
            }
        }
        fixed := source.clone()
        for edit in edits {
            if edit.start > edit.end || fixed.get(edit.start..edit.end).is_none() {
                throw "invalid span {edit.start}..{edit.end} for fix_edit {edit.code} in {file.display()}"
            }
            fixed.replace_range(edit.start..edit.end, &edit.new_text)
        }
        next.insert(^file, ^fixed)
    }
    next
}
// Rust: tests/cli_parts/surface.rs:1456
fn repair_codes(reports: &[RepairReport]) -> BTreeSet<String> {
    reports.iter().map((report) -> report.code.clone()).collect()
}
// Rust: tests/cli_parts/surface.rs:1460
fn run_repair_loop(initial: RepairState, max_rounds: USize, check: (&RepairState) -> [RepairReport]) -> (RepairState, USize) Err! {
    state := ^initial
    seen := [RepairState]{}
    previous_codes: BTreeSet<String>? := None
    for round in 0..=max_rounds {
        reports :: check(&state)
        if reports.is_empty() { return (^state, round) }
        codes :: repair_codes(&reports)
        if seen.iter().any((old) -> old == &state) {
            throw "repeated file state; offending code(s): {codes.iter().cloned().collect::<[String]>().join(", ")}"
        }
        if previous :: &previous_codes {
            introduced :: codes.difference(previous).cloned().collect::<[String]>()
            if !introduced.is_empty() { throw "fix_edit regression introduced report code(s): {introduced.join(", ")}" }
        }
        if round == max_rounds {
            throw "round bound {max_rounds} exceeded; offending code(s): {codes.iter().cloned().collect::<[String]>().join(", ")}"
        }
        seen.push(state.clone())
        state = apply_repair_edits(&state, &reports)?
        previous_codes = Val(^codes)
    }
    unreachable()
}
