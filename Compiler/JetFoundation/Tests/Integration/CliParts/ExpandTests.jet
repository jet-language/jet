    p :: args_fixture("61")
    out :: Command.new(jet()).args(["run", p.to_str().unwrap(), "--port"]).env("NO_COLOR", "1").output().unwrap()
    assert_eq(out.status.code(), .Some(2), "unknown flag before -- should exit 2")
