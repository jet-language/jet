// Rust: tests/cli_parts/expand.rs:646
#Test("expand_json_is_canonical_and_lens_scoped") {
    p :: expand_fixture()
    run :: fn() { Command.new(jet()).args(["inspect", "expand", "--facts", "inline", "--json"]).arg(&p).env("NO_COLOR", "1").output().unwrap() }
    first :: run()
    second :: run()
    assert_eq(first.status.code(), .Some(0))
    assert_eq(normalize_expand_json(String.from_utf8_lossy(&first.stdout).as_ref()), normalize_expand_json(String.from_utf8_lossy(&second.stdout).as_ref()), "expand JSON must be byte-stable apart from elapsed_ms")
    stdout :: String.from_utf8_lossy(&first.stdout)
    assert(stdout.starts_with('{'), "JSON mode must not print human headers: {stdout}")
    assert(stdout.contains("\"schema_version\":{SCHEMA_VERSION}"), "must reuse semindex schema: {stdout}")
    assert(stdout.contains("\"expand\":{\"selection\":\"inline\""), "missing expand projection: {stdout}")
    assert(stdout.contains("\"contract\":\"#Inline"), "inline facts missing: {stdout}")
    assert(stdout.contains("\"check\":{\"status\":\"passed\""), "check provenance missing: {stdout}")
    assert(!stdout.contains("inline —"), "human lens header leaked into JSON: {stdout}")
}
// Rust: tests/cli_parts/expand.rs:693
#Test("expand_layout_human_and_json_are_deterministic") {
    fixture :: expand_layout_fixture()
    run :: fn() { Command.new(jet()).args(["inspect", "expand", "--facts", "layout"]).arg(&fixture).env("NO_COLOR", "1").output().unwrap() }
    first :: run()
    second :: run()
    assert_eq(first.status.code(), .Some(0))
    assert_eq(stable_expand_text(&scrub_fixture(&String.from_utf8_lossy(&first.stdout), &fixture)), stable_expand_text(&scrub_fixture(&String.from_utf8_lossy(&second.stdout), &fixture)), "layout text must be stable apart from check/proof timing")
    human :: scrub_fixture(&String.from_utf8_lossy(&first.stdout), &fixture)
    assert(!human.contains('\u{1b}'), "NO_COLOR leaked ANSI: {human:?}")
    loop type_name in ["PlainPacket", "CPacket", "ColumnPacket", "PacketState"] -> assert(human.contains("{type_name}.$layout"), "{type_name}: {human}")
    assert(human.contains("PlainPacket.$layout   kind=default size=unknown"))
    assert(human.contains("CPacket.$layout   kind=c size=8 alignment=4 stride=8"))
    assert(human.contains("fields=[count:U32(offset=0,size=4),flag:U8(offset=4,size=1)]"))
    assert(human.contains("ColumnPacket.$layout   kind=columnar size=32 alignment=8 stride=32"))
    assert(human.contains("fields=[count:Int(offset=0,size=8),label:String(offset=8,size=24)]"))
    assert(human.contains("byte_facts=unavailable") && human.contains("E0959"))
    json_run :: fn() { Command.new(jet()).args(["inspect", "expand", "--facts", "layout", "--json"]).arg(&fixture).env("NO_COLOR", "1").output().unwrap() }
    json_first :: json_run()
    json_second :: json_run()
    assert_eq(json_first.status.code(), .Some(0))
    assert_eq(normalize_expand_json(String.from_utf8_lossy(&json_first.stdout).as_ref()), normalize_expand_json(String.from_utf8_lossy(&json_second.stdout).as_ref()), "layout JSON must be byte-stable apart from elapsed_ms")
    json :: scrub_fixture(&String.from_utf8_lossy(&json_first.stdout), &fixture)
    assert(parse_json(&json).is_ok(), "layout JSON must parse: {json}")
    assert(json.contains("\"selection\":\"layout\""))
    assert(json.contains("\"kind\":\"c\"") && json.contains("\"kind\":\"columnar\""))
    assert(json.contains("\"type\":\"PacketState\"") && json.contains("\"size\":null"))
    assert(json.contains("\"offset\":null"))
    assert(json.contains("\"size\":8") && json.contains("\"offset\":4"))
    assert(json.contains("\"byte_facts\":{\"diagnostic\""))
    assert(json.contains("\"status\":\"unavailable\""))
    assert(json.contains("\"code\":\"E0959\""))
}
// Rust: tests/cli_parts/expand.rs:763
#Test("expand_effects_and_layout_report_checked_facts") {
    fixture :: expand_effects_layout_fixture()
    effects :: Command.new(jet()).args(["inspect", "expand", "--facts", "effects"]).arg(&fixture).env("NO_COLOR", "1").output().unwrap()
    assert_eq(effects.status.code(), .Some(0))
    effects_human :: scrub_fixture(&String.from_utf8_lossy(&effects.stdout), &fixture)
    assert(effects_human.contains("audit"), "{effects_human}")
    // The declared -[Log.Audit]> upper bound is not an executed effect.
    assert(effects_human.contains("resolved=[]"), "{effects_human}")
    layout :: Command.new(jet()).args(["inspect", "expand", "--facts", "layout"]).arg(&fixture).env("NO_COLOR", "1").output().unwrap()
    assert_eq(layout.status.code(), .Some(0))
    layout_human :: scrub_fixture(&String.from_utf8_lossy(&layout.stdout), &fixture)
    assert(layout_human.contains("AuditPacket.$layout"), "{layout_human}")
    assert(layout_human.contains("byte_facts=unavailable"), "{layout_human}")
    assert(layout_human.contains("[E0959]"), "{layout_human}")
    effects_output :: Command.new(jet()).args(["inspect", "expand", "--facts", "effects", "--json"]).arg(&fixture).env("NO_COLOR", "1").output().unwrap()
    assert_eq(effects_output.status.code(), .Some(0))
    effects_json :: String.from_utf8_lossy(&effects_output.stdout)
    assert(parse_json(&effects_json).is_ok(), "{effects_json}")
    assert(effects_json.contains("\"selection\":\"effects\""))
    assert(effects_json.contains("\"inferred\":[]"))
    layout_output :: Command.new(jet()).args(["inspect", "expand", "--facts", "layout", "--json"]).arg(&fixture).env("NO_COLOR", "1").output().unwrap()
    assert_eq(layout_output.status.code(), .Some(0))
    layout_json :: String.from_utf8_lossy(&layout_output.stdout)
    assert(parse_json(&layout_json).is_ok(), "{layout_json}")
    assert(layout_json.contains("\"selection\":\"layout\""))
    assert(layout_json.contains("\"byte_facts\":{\"diagnostic\""))
    assert(layout_json.contains("\"status\":\"unavailable\""))
    assert(layout_json.contains("\"code\":\"E0959\""))
}
