// Rust: tests/cli_parts/expand.rs:39
#Test("no_separator_positional_regression") {
    p :: args_fixture("39")
    out :: Command.new(jet()).args(["run", "--profile=debug", p.to_str().unwrap(), "hello"]).output().unwrap()
    assert_eq(out.status.code(), .Some(0), "stderr: {String.from_utf8_lossy(&out.stderr)}")
    stdout :: String.from_utf8_lossy(&out.stdout)
    assert(stdout.trim() == "2", "expected 2 args (argv[0] + hello), got: {stdout}")
}
// Rust: tests/cli_parts/expand.rs:61
