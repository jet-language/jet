// Rust: tests/cli_parts/expand.rs:857
#Test("expand_json_selected_empty_and_positions_are_proved") {
    fixture :: expand_fixture()
    empty :: Command.new(jet()).args(["inspect", "expand", "--facts", "memory", "--json"]).arg(&fixture).env("NO_COLOR", "1").output().unwrap()
    assert_eq(empty.status.code(), .Some(0))
    empty_json :: String.from_utf8_lossy(&empty.stdout)
    assert(parse_json(&empty_json).is_ok(), "selected empty JSON must parse: {empty_json}")
    assert(empty_json.contains("\"selection\":\"memory\""))
    assert(empty_json.contains("\"facts\":[]"), "selected empty lens must be explicit: {empty_json}")
    memory :: Command.new(jet()).args(["inspect", "expand", "--facts", "memory", "--json"]).arg(OSPath(env!("CARGO_MANIFEST_DIR")).join("Examples/features/memory/effect_denials.jet")).env("NO_COLOR", "1").output().unwrap()
    assert_eq(memory.status.code(), .Some(0))
    memory_json :: String.from_utf8_lossy(&memory.stdout)
    assert(parse_json(&memory_json).is_ok())
    assert(memory_json.contains("\"fact\":\"!Mem.Alloc\""))
    assert(memory_json.contains("\"line\":4"), "memory fact location missing: {memory_json}")
    web :: Command.new(jet()).args(["inspect", "expand", "--facts", "web", "--json"]).arg(OSPath(env!("CARGO_MANIFEST_DIR")).join("Examples/features/web/web_app.jet")).env("NO_COLOR", "1").output().unwrap()
    assert_eq(web.status.code(), .Some(0))
    web_json :: String.from_utf8_lossy(&web.stdout)
    assert(parse_json(&web_json).is_ok())
    assert(web_json.contains("\"kind\":\"web_graph\""))
    assert(web_json.contains("\"span\":{"), "web fact positions missing: {web_json}")
}
// Rust: tests/cli_parts/expand.rs:912
#Test("expand_json_compile_error_uses_machine_diagnostics") {
    p :: bad_file("912")
    out :: Command.new(jet()).args(["inspect", "expand", "--json"]).arg(&p).env("NO_COLOR", "1").output().unwrap()
    assert_eq(out.status.code(), .Some(1))
    stdout :: String.from_utf8_lossy(&out.stdout)
    stderr :: String.from_utf8_lossy(&out.stderr)
    assert(stdout.starts_with("{\"schema\":\"jet.status/v1\""), "JSON diagnostic must use jet.status/v1: {stdout}")
    assert(stdout.contains("\"code\":\"E0102\""), "missing registered diagnostic: {stdout}")
    assert(parse_json(&stdout).is_ok(), "diagnostic JSON line must parse: {stdout}")
    assert(!stdout.contains("Error ["), "human diagnostic leaked into JSON: {stdout}")
    assert(stderr.is_empty(), "JSON mode should keep stderr quiet: {stderr}")
}
