// Rust: tests/cli_parts/expand.rs:419
#Test("expand_callable_signature_uses_one_checked_fact_document") {
    fixture :: OSPath(env!("CARGO_MANIFEST_DIR")).join("Examples/features/callable/callable_policies.jet")
    human :: Command.new(jet()).args(["inspect", "expand", "--facts", "callable-signature"]).arg(&fixture).env("NO_COLOR", "1").output().unwrap()
    assert_eq(human.status.code(), .Some(0), "{String.from_utf8_lossy(&human.stderr)}")
    human_text :: scrub_fixture(&String.from_utf8_lossy(&human.stdout), &fixture)
    assert(human_text.contains("load_user [fn:"), "{human_text}")
    assert(human_text.contains("label{\"user\"}: String"), "{human_text}")
    assert(!human_text.contains("label: label{\"user\"}: String"), "{human_text}")
    assert(human_text.contains("policies=[trace(\"users.load\")]"), "{human_text}")
    assert(human_text.contains("failure=String") && human_text.contains("implicit default !Err"), "{human_text}")
    json :: Command.new(jet()).args(["inspect", "expand", "--facts", "callable-signature", "--json"]).arg(&fixture).env("NO_COLOR", "1").output().unwrap()
    assert_eq(json.status.code(), .Some(0), "{String.from_utf8_lossy(&json.stderr)}")
    json_text :: scrub_fixture(&String.from_utf8_lossy(&json.stdout), &fixture)
    assert(parse_json(&json_text).is_ok(), "{json_text}")
    assert(json_text.contains("\"selection\":\"callable-signature\""))
    assert(json_text.contains("\"policies\":[\"trace(\\\"users.load\\\")\"]"))
    assert(json_text.contains("\"default\":\"\\\"user\\\"\""))
    assert(json_text.contains("\"failure_contract\""))
    assert(json_text.contains("\"failure_source\":\"implicit default !Err\""))
}
// Rust: tests/cli_parts/expand.rs:483
#Test("expand_callable_signature_shows_default_and_explicit_failure_routes") {
    scratch :: common.Scratch.new("expand_failure_contracts")
    path :: scratch.join("main.jet")
    fs.write(&path, """
#Error
enum Problem { Bad }
fn default_helper() -> Int { return 1 }
fn explicit_helper() -> Int Problem! { return Ok(1) }
fn run() {}
""").unwrap()
    output :: Command.new(jet()).args(["inspect", "expand", "--facts", "callable-signature"]).arg(&path).env("NO_COLOR", "1").output().unwrap()
    assert_eq(output.status.code(), .Some(0), "{String.from_utf8_lossy(&output.stderr)}")
    text :: String.from_utf8_lossy(&output.stdout)
    assert(text.contains("default_helper"), "{text}")
    assert(text.contains("implicit default !Err"), "{text}")
    assert(text.contains("explicit_helper"), "{text}")
    assert(text.contains("explicit !Problem"), "{text}")
}
