// Rust: tests/cli_parts/expand.rs:1220
#Test("plugin_missing_wasm_tools_is_e1259") {
    which :: fn(tool: &String) -> String? {
        Command.new("which").arg(tool).output().ok().filter(fn(o) { o.status.success() }).map(fn(o) {
            text :: String.from_utf8_lossy(&o.stdout)
            trimmed := text.trim() // #4303
            trimmed.to_string()
        })
    }
    rustc_path :: which("rustc")
    lld_path :: which("lld")
    if rustc_path == .None || lld_path == .None {
        eprintln("note: skipping plugin_missing_wasm_tools_is_e1259 (no `rustc`/`lld` on PATH to re-expose)")
        return
    }
    dir :: isolated_cwd("plugin_no_wasmtools")
    fs.write(dir.join("main.jet"), "pub fn scale(a: Float, b: Float) -> Float {\n    return a * b\n}\n\nfn run() {}\n").unwrap()
    bin_dir :: dir.join("bin")
    fs.create_dir_all(&bin_dir).unwrap()
    if selected_family() == "unix" {
        _ :: fs.symlink(&rustc_path.unwrap(), bin_dir.join("rustc"))
        _ :: fs.symlink(&lld_path.unwrap(), bin_dir.join("lld"))
    }
    out :: Command.new(jet()).arg("build").arg("main.jet").arg("--target=sandbox").current_dir(&dir).env("NO_COLOR", "1").env("PATH", &bin_dir).output().unwrap()
    stderr :: String.from_utf8_lossy(&out.stderr)
    assert(stderr.contains("E1259"), "expected E1259 (missing wasm-tools) in stderr:\n{stderr}")
    assert(!stderr.contains("panicked"), "must never panic, only report a clean diagnostic (I2):\n{stderr}")
}
// Rust: tests/cli_parts/expand.rs:1274
#Test("monorepo_bare_entry_honors_d_ile1_search_order") {
    fixture :: OSPath(env!("CARGO_MANIFEST_DIR")).join("Examples/features/packages/monorepo")
    root :: isolated_cwd("monorepo_d_ile1")
    _ :: fs.remove_dir_all(&root).ok()
    copy_dir_all(&fixture, &root)
    run :: fn(dir: &OSPath, extra_args: &[String]) -> Output {
        Command.new(jet()).arg("run").args(extra_args).current_dir(dir).env("NO_COLOR", "1").output().unwrap()
    }
    golden := String.new()
    out :: run(&root, &[])
    stderr :: String.from_utf8_lossy(&out.stderr)
    assert_eq(out.status.code(), .Some(2), "ambiguous bare run is USAGE:\n{stderr}")
    assert(stderr.contains("ambiguous"), "expected the D-CLI-BARE1 ambiguity error:\n{stderr}")
    assert(stderr.contains("hello") && stderr.contains("ranker"), "ambiguity error should list both runnable members by their real package.jet name:\n{stderr}")
    assert(!stderr.contains("hello\"") && !stderr.contains("ranker\""), "member names must not carry a stray trailing quote:\n{stderr}")
    hello :: run(&root, &["-p", "hello"])
    assert_eq(hello.status.code(), .Some(0), "-p hello should run: stderr={String.from_utf8_lossy(&hello.stderr)}")
    golden.push_str(&String.from_utf8(hello.stdout).unwrap())
    ranker :: run(&root, &["-p", "ranker"])
    assert_eq(ranker.status.code(), .Some(0), "-p ranker should run: stderr={String.from_utf8_lossy(&ranker.stderr)}")
    golden.push_str(&String.from_utf8(ranker.stdout).unwrap())
    assert_eq(golden, include_str!("../../Examples/features/expected/packages/monorepo.out"), "monorepo output differs from its golden artifact")
    member_dir :: root.join("packages/hello")
    member :: run(&member_dir, &[])
    assert_eq(member.status.code(), .Some(0), "bare run inside a member should run its own entry: stderr={String.from_utf8_lossy(&member.stderr)}")
    assert(String.from_utf8_lossy(&member.stdout).contains("hello from the monorepo"), "stdout: {String.from_utf8_lossy(&member.stdout)}")
    outside :: isolated_cwd("monorepo_d_ile1_outside")
    missing :: run(&outside, &[])
    missing_stderr :: String.from_utf8_lossy(&missing.stderr)
    assert_eq(missing.status.code(), .Some(2))
    assert(missing_stderr.contains("No file given and no `package.jet` found"), "outside-package bare error text must stay the current usage error:\n{missing_stderr}")
}
