// Rust: tests/cli_parts/scene_forged.rs:14
#Test("scene_probe_rejects_forged_cache") {
    (dir, report) :: scene_probe_once("scene_probe_forged", scene_forged.FRAME_BUDGET)
    assert_scene_probe_measurement(&report, "SceneAssetBytes")
    reports :: dir.join(".jet/perf/reports")
    paths :: fn() { fs.read_dir(&reports).unwrap().map(fn(entry) { entry.unwrap().path() }).collect::<[OSPath]>() }
    initial :: paths()
    assert_eq(initial.len(), 1, "expected exactly one report; got {initial:?}")
    fs.OpenOptions.new().append(true).open(&initial[0]).unwrap().write_all("forged".as_bytes()).unwrap()
    replacement :: scene_probe_run(&dir)
    assert_eq(replacement.status.code(), .Some(0), "{String.from_utf8_lossy(&replacement.stderr)}")
    assert_eq(paths().len(), 2, "forged report must not satisfy compatible cache identity")
}
// Rust: tests/cli_parts/scene_probe.rs:14
#Test("scene_probe_reuses_compatible_report") {
    (dir, report) :: scene_probe_once("scene_probe_runtime", scene_probe.FRAME_BUDGET)
    assert_scene_probe_measurement(&report, "FrameTime")
    reports :: dir.join(".jet/perf/reports")
    paths :: fn() { fs.read_dir(&reports).unwrap().map(fn(entry) { entry.unwrap().path() }).collect::<[OSPath]>() }
    initial :: paths()
    assert_eq(initial.len(), 1, "expected exactly one report; got {initial:?}")
    // A compatible second run must reuse the report without writing another.
    second :: scene_probe_run(&dir)
    assert_eq(second.status.code(), .Some(0))
    assert_eq(paths(), initial, "compatible report should be reused")
}
