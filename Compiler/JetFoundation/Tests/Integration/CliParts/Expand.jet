use jet_foundation.Tests.Integration.CliParts.Support.*
use jet_foundation.DataTree.DataTree

// Rust: tests/cli_parts/expand.rs:4
pub fn normalize_expand_json(text: &String) -> DataTree {
    // Rust: tests/cli_parts/expand.rs:5
    fn scrub(node: &DataTree) -> {
        if node == {
            .Object(fields) -> {
                loop (key, value) in &fields {
                    if key == "elapsed_ms" -> value = .Int(0)
                    else -> scrub(&value)
                }
            }
            .Array(values) -> { loop value in &values -> scrub(&value) }
            else -> {}
        }
    }
    value := parse_json(text).expect("expand JSON must parse")
    scrub(&value)
    value
}

// Rust: tests/cli_parts/expand.rs:30
pub fn stable_expand_text(text: &String) -> String {
    text.lines().filter(fn(line) { !line.starts_with("check: ") && !line.starts_with("proof: ") }).collect().join("\n")
}
