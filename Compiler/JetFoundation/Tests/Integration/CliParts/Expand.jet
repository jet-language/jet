//RS     )
//RS     .unwrap();
//RS     let out = Command::new(jet())
//RS         .arg("build")
//RS         .arg("main.jet")
//RS         .arg("--target=sandbox")
//RS         .current_dir(&dir)
//RS         .env("NO_COLOR", "1")
//RS         .output()
//RS         .unwrap();
//RS     let stderr = String::from_utf8_lossy(&out.stderr);
