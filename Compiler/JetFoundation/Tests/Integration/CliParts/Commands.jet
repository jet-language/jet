use jet_foundation.Tests.Integration.CliParts.Support.*
use std.fs
use std.process.[Command, Output] // GATE #4494: native process execution.

// Rust: tests/cli_parts/commands.rs:200
// A project with a passing test and a read-only optional history store.
// The Unix-only callers dispatch on selected_family (GATE #4483).
pub fn read_only_history_project(tag: String) -> OSPath {
    dir :: isolated_cwd(tag)
    fs.write(dir.join("package.jet"), "name: \"history\"\nversion: \"0.1.0\"\n").unwrap()
    fs.write(dir.join("run.jet"), "fn greeting() -> String { \"hello\" }\n\nfn run() -> {\n    print(greeting())\n}\n\n#Test(\"the greeting stays stable\") {\n    assert_eq(greeting(), \"hello\")\n}\n").unwrap()
    records :: dir.join(".jet/records")
    fs.create_dir_all(&records).unwrap()
    // GATE #4494: real native Unix permission bits.
    fs.set_permissions(&records, fs.Permissions.from_mode(0o555)).unwrap()
    dir
}

// Rust: tests/cli_parts/commands.rs:216
pub fn run_history_test(dir: &OSPath, extra: &[String]) -> Output {
    output :: Command.new(jet()).arg("test").args(extra).current_dir(dir).env_remove("JET_RECEIPT_BYPASS").env("NO_COLOR", "1").output().unwrap()
    // GATE #4494: restore permissions even when the test command fails.
    fs.set_permissions(dir.join(".jet/records"), fs.Permissions.from_mode(0o755)).unwrap()
    output
}
