// Rust: tests/cli_parts/surface.rs:2611
// Human output includes print then value; JSON forwards program output to stderr.
#Test("eval_file_forwards_print_output_alongside_the_value") {
    dir :: isolated_cwd("eval_print_output")
    file :: dir.join("printer.jet")
    fs.write(&file, "fn run() -> {\n    print(\"hi\")\n}\n").unwrap()
    human :: Command.new(jet()).args(["eval", file.to_string_lossy()]).env("NO_COLOR", "1").output().unwrap()
    stdout :: String.from_utf8_lossy(&human.stdout)
    assert_eq(human.status.code(), Some(0), "{String.from_utf8_lossy(&human.stderr)}")
    assert(stdout.contains("hi"), "print output was swallowed: {stdout:?}")
    assert(stdout.contains("()"), "the run value should still render: {stdout:?}")
    json :: Command.new(jet()).args(["eval", file.to_string_lossy(), "--json"]).env("NO_COLOR", "1").output().unwrap()
    assert_eq(json.status.code(), Some(0))
    assert(!String.from_utf8_lossy(&json.stdout).contains("hi"), "--json stdout must stay one JSON document: {String.from_utf8_lossy(&json.stdout):?}")
    assert(String.from_utf8_lossy(&json.stderr).contains("hi"), "--json should forward program output to stderr: {String.from_utf8_lossy(&json.stderr):?}")
}
