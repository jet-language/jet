// Rust: tests/cli_parts/surface.rs:1862
#Test("ci_output_is_ansi_free_when_piped") {
    p :: bad_file("1862")
    piped :: Command.new(jet()).arg("check").arg(&p).output().unwrap()
    s :: String.from_utf8_lossy(&piped.stderr)
    assert(!s.contains('\x1b'), "piped output must be ANSI-free:\n{s}")
    no_color :: Command.new(jet()).arg("check").arg(&p).env("NO_COLOR", "1").output().unwrap()
    nc :: String.from_utf8_lossy(&no_color.stderr)
    assert(!nc.contains('\x1b'), "NO_COLOR output must be ANSI-free")
    assert_eq(s, nc, "piped and NO_COLOR output must match exactly")
}
// Rust: tests/cli_parts/surface.rs:1888
