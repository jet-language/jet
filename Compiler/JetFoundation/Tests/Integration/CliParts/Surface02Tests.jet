        stdout :: String.from_utf8_lossy(&out.stdout)
        assert(stdout.contains(shape), "`jet {command} --help` should show `{shape}`, got:\n{stdout}")
        assert(!stdout.contains("jet {command} [args]"), "`jet {command} --help` still shows the placeholder shape:\n{stdout}")
    }
}
// Rust: tests/cli_parts/surface.rs:2567
#Test("eval_accepts_an_expression_argument") {
    json :: Command.new(jet()).args(["eval", "1 + 2", "--json"]).env("NO_COLOR", "1").output().unwrap()
    stderr :: String.from_utf8_lossy(&json.stderr)
    assert_eq(json.status.code(), Some(0), "stderr: {stderr}")
    assert(!stderr.contains("E2105"), "expression was read as a path: {stderr}")
    value := String.from_utf8_lossy(&json.stdout).trim() // #4303
    assert_eq(value, "3")
    pretty :: Command.new(jet()).args(["eval", "1 + 2"]).env("NO_COLOR", "1").output().unwrap()
    assert_eq(pretty.status.code(), Some(0))
    pretty_value := String.from_utf8_lossy(&pretty.stdout).trim() // #4303
    assert_eq(pretty_value, "3")
}
