#Test("default_jet_run_deopts_jit_gap_silently") {
    dir :: isolated_cwd("jit_gap_run")
    file :: dir.join("env.jet")
    fs.write(&file, "use core.sys as env\nfn run() -> {\n    print(env.current_dir())\n}\n").unwrap()
    output :: Command.new(jet()).args(["run", file.to_str().unwrap()]).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
    assert_eq(output.status.code(), Some(0), "stderr={String.from_utf8_lossy(&output.stderr)}\nstdout={String.from_utf8_lossy(&output.stdout)}")
    stderr :: String.from_utf8_lossy(&output.stderr)
    assert(!stderr.contains("E2211"), "E2211 retired: {stderr}")
    assert(!String.from_utf8_lossy(&output.stdout).is_empty(), "deopted env.current_dir() should print a path")
}
