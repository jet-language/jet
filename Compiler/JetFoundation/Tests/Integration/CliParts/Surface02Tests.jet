#Test("per_command_help_shows_real_argument_shapes") {
    loop (command, shape) in [("repl", "jet repl [<file.jet>]"), ("eval", "jet eval <file.jet|expression>"), ("lint", "jet lint --a11y <file.jet>"), ("fuzz", "jet fuzz <file.jet> [<test>]")] {
