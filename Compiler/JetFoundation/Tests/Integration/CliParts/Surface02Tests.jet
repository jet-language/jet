    s :: String.from_utf8_lossy(&out.stderr)
    assert(s.contains('\x1b'), "--color=always must win over NO_COLOR and emit ANSI")
}
// Rust: tests/cli_parts/surface.rs:1905
#Test("every_registered_code_has_an_explain_entry") {
    codes :: Registry.diagnostic_rows().iter().map(fn(row) -> row.code.to_string()).collect()
    assert(codes.len() > 150, "expected the full code registry, found {codes.len()}")
    index :: Explain.index()
    loop code in &codes {
        assert(index.contains_key(code), "code {code} is registered in typed diagnostic rows but has no explain entry")
        out :: Command.new(jet()).arg("explain").arg(code).output().unwrap()
        assert_eq(out.status.code(), Some(0), "`jet explain {code}` should succeed")
        assert(String.from_utf8_lossy(&out.stdout).contains(code.as_str()), "`jet explain {code}` output should name the code")
    }
}
