// Private authority roots prevent concurrent sibling fixtures changing snapshots.
pub fn bad_file(tag: String) -> OSPath {
    dir :: isolated_cwd("bad_{tag}")
    p :: dir.join("bad.jet")
    fs.write(&p, "fn run() {\n    pirnt(\"hi\")\n}\n").unwrap()
    p
}
// Rust: tests/cli_parts/support.rs:131
pub fn scrub(s: String, file: &OSPath) -> String {
    scrubbed := s.replace(file.display().to_string(), "BAD.jet")
    temp_dir :: env.temp_dir()
    if temp_dir.parent() == {
        .Some(temp_root) -> {
            if file.strip_prefix(temp_root) == { .Ok(relative) -> scrubbed = scrubbed.replace(relative.display().to_string(), "BAD.jet"); .Err(_) -> {} }
        }
        .None -> {}
    }
    if file.file_name().and_then(fn(n) { n.to_str() }) == { .Some(name) -> scrubbed = scrubbed.replace(name, "BAD.jet"); .None -> {} }
    scrubbed
}
// Rust: tests/cli_parts/support.rs:155
NEXT_FIXTURE := AtomicU64.new(0)
// Rust: tests/cli_parts/support.rs:154
// Per-process cwd isolates stem-keyed compiled output across concurrent CLI tests.
pub fn isolated_cwd(tag: String) -> OSPath {
    loop {
        sequence :: NEXT_FIXTURE.fetch_add(1, Ordering.Relaxed)
        dir :: env.temp_dir().join("jet_cli_cwd_{tag}_{std.process.id()}_{sequence}")
        if fs.create_dir(&dir) == {
            .Ok(_) -> return dir
            .Err(error) -> {
                if error.kind() == io.ErrorKind.AlreadyExists -> continue
                panic("cannot create isolated CLI fixture {dir.display()}: {error}")
            }
        }
    }
}
// Rust: tests/cli_parts/support.rs:179
// Bare budget discovery uses canonical run.jet, never main.jet fallback.
pub fn budget_project(tag: String, limit: U64) -> OSPath {
    dir :: isolated_cwd(tag)
    fs.create_dir_all(dir.join("src")).unwrap()
    fs.write(dir.join("package.jet"), "name: \"app\"\nversion: \"0.1.0\"\n").unwrap()
    fs.write(dir.join("src/run.jet"), """module perf.package {
    budgets: [Budget{
        name: "public-api",
        scope: .Package,
        metric: .PublicApiItems,
        comparison: .Absolute,
        limit: .AtMost(__LIMIT__),
    }],
}
pub fn api() {}
fn run() {}
""".replace("__LIMIT__", limit.to_string())).unwrap()
    dir
}
