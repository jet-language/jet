// Explicit debug profile selects native AOT without optimized-release costs.
pub fn run_debug_aot(file: String) -> Command {
    command := Command.new(jet())
    command.args(["run", "--profile=debug", file])
    command
}
// Rust: tests/cli_parts/support.rs:51
pub fn output_with_retry(cmd: &Command) -> Output {
    last := .None
    loop attempt in 0..<8 {
        if attempt > 0 -> thread.sleep(Duration.from_millis(20 * attempt))
        if cmd.output() == {
            .Ok(out) -> return out
            .Err(e) -> {
                if e.kind() == io.ErrorKind.ExecutableFileBusy -> last = .Some(e)
                else -> panic("CLI command failed: {e}")
            }
        }
    }
    panic("CLI command stayed busy: {last.unwrap()}")
}
// Rust: tests/cli_parts/support.rs:66
pub fn spawn_with_retry(cmd: &Command) -> Child {
    last := .None
    loop attempt in 0..<8 {
        if attempt > 0 -> thread.sleep(Duration.from_millis(20 * attempt))
        if cmd.spawn() == {
            .Ok(child) -> return child
            .Err(e) -> {
                if e.kind() == io.ErrorKind.ExecutableFileBusy -> last = .Some(e)
                else -> panic("CLI command failed: {e}")
            }
        }
    }
    panic("CLI command stayed busy: {last.unwrap()}")
}
// Rust: tests/cli_parts/support.rs:89
pub fn cli_dir() -> OSPath { OSPath.from(env!("CARGO_MANIFEST_DIR")).join("tests/cli") }
// Rust: tests/cli_parts/support.rs:94
pub fn check_snapshot(name: String, actual: String) -> Unit {
    path :: cli_dir().join(name)
    if env.var("UPDATE_EXPECT").is_ok() {
        fs.create_dir_all(cli_dir()).unwrap()
        fs.write(&path, actual).unwrap()
        return
    }
    expected :: fs.read_to_string(&path).unwrap_or_else(fn(_) { panic("missing snapshot {path.display()}; run UPDATE_EXPECT=1 cargo test") })
    assert_eq(actual, expected, "snapshot mismatch for {name}")
}
