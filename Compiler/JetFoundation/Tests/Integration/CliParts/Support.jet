// Rust: tests/cli_parts/support.rs:609
pub fn copy_dir_all(src: &OSPath, dst: &OSPath) -> Unit {
    fs.create_dir_all(dst).unwrap()
    loop entry in fs.read_dir(src).unwrap() {
        entry :: entry.unwrap()
        dest_path :: dst.join(entry.file_name())
        if entry.file_type().unwrap().is_dir() -> copy_dir_all(&entry.path(), &dest_path)
        else -> { _ :: fs.copy(entry.path(), &dest_path).unwrap() }
    }
}
// Rust: tests/cli_parts/support.rs:625
pub fn scene_probe_project(tag: String, budget: String) -> OSPath {
    dir :: isolated_cwd(tag)
    fs.create_dir_all(dir.join("src")).unwrap()
    fs.write(dir.join("package.jet"), "name: \"app\"\nversion: \"0.1.0\"\n").unwrap()
    source :: """use core.game as game
module perf.game {
    budgets: [
        __SCENE_BUDGET__,
    ]
}
fn run() {
    scene := game.Scene.new("main")
    counter := 0
    scene.on_frame((frame) -> {
        counter = counter + 1
    })
    transcript :: game.run(scene)
    print(transcript)
}
""".replace("__SCENE_BUDGET__", budget)
    fs.write(dir.join("src/main.jet"), source).unwrap()
    dir
}
// Rust: tests/cli_parts/support.rs:652
pub fn scene_probe_run(dir: &OSPath) -> Output { Command.new(jet()).args(["self", "devtools", "probe", "src/main.jet"]).current_dir(dir).output().unwrap() }
// Rust: tests/cli_parts/support.rs:660
pub fn scene_probe_once(tag: String, budget: String) -> (OSPath, CanonicalJson) {
    dir :: scene_probe_project(tag, budget)
    output :: scene_probe_run(&dir)
    assert_eq(output.status.code(), .Some(0), "stdout: {String.from_utf8_lossy(&output.stdout)}\nstderr: {String.from_utf8_lossy(&output.stderr)}")
    reports :: dir.join(".jet/perf/reports")
    paths :: fs.read_dir(&reports).unwrap().map(fn(entry) { entry.unwrap().path() }).collect::<[OSPath]>()
    assert_eq(paths.len(), 1, "expected exactly one report; got {paths:?}")
    bytes :: fs.read(&paths[0]).unwrap()
    verify_budget_report(&bytes).unwrap()
    (dir, CanonicalJson.parse_canonical(&bytes).unwrap())
}
// Rust: tests/cli_parts/support.rs:681
pub fn assert_scene_probe_measurement(report: &CanonicalJson, expected_metric: String) -> Unit {
    report :: if report == { .Object(report) -> report; else -> panic("report") }
    content :: if &report["content"] == { .Object(content) -> content; else -> panic("content") }
    measurements :: if &content["measurements"] == { .Array(measurements) -> measurements; else -> panic("measurements") }
    assert_eq(measurements.len(), 1, "expected one SceneProbe measurement")
    measurement :: if &measurements[0] == { .Object(measurement) -> measurement; else -> panic("measurement") }
    provider :: if &measurement["provider"] == { .Object(provider) -> provider; else -> panic("provider") }
    assert_eq(provider["kind"], CanonicalJson.String("SceneProbe"))
    assert_eq(provider["identity"], CanonicalJson.String("main"))
    metric :: if &measurement["metric"] == { .Object(metric) -> metric; else -> panic("metric") }
    assert_eq(metric["name"], CanonicalJson.String(expected_metric))
    samples :: if &measurement["samples"] == { .Array(samples) -> samples; else -> panic("samples") }
    assert_eq(samples.len(), 600, "SceneProbe must produce exactly 600 measured samples")
}
// Rust: tests/cli_parts/support.rs:698
pub fn canonical_field(value: &CanonicalJson, key: String) -> &CanonicalJson {
    if value == {
        .Object(fields) -> fields.get(key).unwrap_or_else(fn() { panic("canonical JSON has no field `{key}`") })
        else -> panic("canonical JSON parent of `{key}` is not an object")
    }
}
