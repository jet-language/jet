// Rust: tests/cli_parts/support.rs:342
pub fn age_budget_baseline(dir: &OSPath, baseline: String) -> (String, String) {
    path :: dir.join(".jet/perf/baselines/names/{baseline}.json")
    manifest := CanonicalJson.parse_canonical(&fs.read(&path).unwrap()).unwrap()
    wrapper := if &manifest == { .Object(wrapper) -> wrapper; else -> panic("manifest") }
    report_id :: {
        content :: if &wrapper["content"] == { .Object(content) -> content; else -> panic("content") }
        id :: if &content["head_report_id"] == { .String(id) -> id; else -> panic("head") }
        id.clone()
    }
    {
        content := if wrapper.get_mut("content").unwrap() == { .Object(content) -> content; else -> panic("content") }
        generations := if content.get_mut("generations").unwrap() == { .Array(generations) -> generations; else -> panic("generations") }
        generation := if &generations[0] == { .Object(generation) -> generation; else -> panic("generation") }
        audit := if generation.get_mut("audit").unwrap() == { .Object(audit) -> audit; else -> panic("audit") }
        audit.insert("accepted_at", .String("2000-01-01T00:00:00.000000000Z"))
        body := audit.clone()
        _ :: body.remove("audit_id").unwrap()
        audit.insert("audit_id", .String(stable_id(&CanonicalJson.Object(body))))
    }
    state_id :: stable_id(&wrapper["content"])
    wrapper.insert("manifest_id", .String(state_id.clone()))
    fs.write(path, manifest.bytes()).unwrap()
    (report_id, state_id)
}
// Rust: tests/cli_parts/support.rs:385
#FFI(c)
fn openpty(master: *I32, slave: *I32, name: *I8, termp: *U8, winp: *U8) -> I32
// Rust: tests/cli_parts/support.rs:380
pub fn run_budget_update_pty(dir: &OSPath, answer: &[U8]) -> (I32, String) {
    assert(core.sys.target.selected_family() == "unix", "openpty requires Unix")
    master_fd := -1
    slave_fd := -1
    #Unsafe("openpty initializes two owned descriptors; each is transferred once to File") {
        assert_eq(openpty(&master_fd, &slave_fd, std.ptr.null_mut(), std.ptr.null(), std.ptr.null()), 0)
    }
    master := #Unsafe("take unique ownership of the PTY master returned by openpty") { fs.File.from_raw_fd(master_fd) }
    slave :: #Unsafe("take unique ownership of the PTY slave returned by openpty") { fs.File.from_raw_fd(slave_fd) }
    child := Command.new(jet()).args(["budget", "update", "--baseline", "ci/linux", "--bootstrap", "--reason", "initial evidence"])
        .current_dir(dir).stdin(Stdio.from(slave.try_clone().unwrap())).stdout(Stdio.from(slave.try_clone().unwrap())).stderr(Stdio.from(slave)).spawn().unwrap()
    master.write_all(answer).unwrap()
    status :: child.wait().unwrap()
    bytes := [U8].new()
    buffer := [U8].filled(4096, 0)
    loop {
        if master.read(&buffer) == {
            .Ok(0) -> break
            .Ok(n) -> bytes.extend_from_slice(&buffer[..<n])
            .Err(error) -> {
                if error.raw_os_error() == .Some(5) -> break
                panic("PTY read: {error}")
            }
        }
    }
    (status.code().unwrap(), String.from_utf8_lossy(&bytes).replace("\r\n", "\n"))
}
// Rust: tests/cli_parts/support.rs:457
pub fn is_code(s: String) -> Bool {
    b :: s.as_bytes()
    b.len() == 5 && (b[0] == b'E' || b[0] == b'L') && b[1..].iter().all(fn(c) { c.is_ascii_digit() })
}
