    assert(!stderr.contains("broken.f90:"), "raw gfortran location leaked:\n{stderr}")
    assert(!stderr.contains("    7 |"), "raw gfortran source frame leaked:\n{stderr}")
    check_snapshot("bind_fortran_invalid_e3208.txt", &scrub(&stderr, &source))
