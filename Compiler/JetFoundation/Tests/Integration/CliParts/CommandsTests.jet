#Test("completions_generate_for_every_shell") {
    loop shell in ["bash", "zsh", "fish", "powershell"] {
        out :: Command.new(jet()).args(["self", "completions"]).arg(shell).output().unwrap()
        assert_eq(out.status.code(), Some(0), "completions {shell} should exit 0")
        s :: String.from_utf8_lossy(&out.stdout)
        loop flag in ["structural", "out", "repo"] {
            spelling :: if shell == "fish" { "-l {flag}" } else { "--{flag}" }
            assert(s.contains(spelling), "{shell} completion missing {spelling}")
        }
        check_snapshot("completions_{shell}.txt", &s)
    }
}
