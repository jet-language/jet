}
// Rust: tests/cli_parts/commands.rs:1258
#Test("osc8_hyperlinks_only_when_forced_on") {
    p :: bad_file("1259")
    piped :: Command.new(jet()).arg("check").arg(&p).env("NO_COLOR", "1").output().unwrap()
    s :: String.from_utf8_lossy(&piped.stderr)
    assert(!s.contains("\x1b]8;;"), "piped output must have no OSC 8 links:\n{s.debug()}")
    src :: "fn run() -> {}\n"
    d :: Diagnostic.error("E0001", "x", "y", "z", Some(Span.new(3, 7)))
    linked :: d.render_linked("a.jet", src, true, true)
    assert(linked.contains("\x1b]8;;"), "render_linked(hyperlinks=true) should emit OSC 8")
    plain :: d.render_linked("a.jet", src, true, false)
    assert(!plain.contains("\x1b]8;;"), "render_linked(hyperlinks=false) must not")
}
