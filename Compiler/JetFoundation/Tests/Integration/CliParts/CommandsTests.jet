// Rust: tests/cli_parts/commands.rs:1159
// Invocation authority must work at each retained native optimization level.
#Test("allow_time_wait_runs_on_every_engine_from_a_repository_subdirectory") {
    root :: isolated_cwd("authority_allow_time_wait")
    fs.create_dir_all(root.join(".git")).unwrap()
    app :: root.join("app")
    fs.create_dir_all(&app).unwrap()
    fs.write(app.join("wait.jet"), "use core.time as time\n\nfn run() -> {\n    time.sleep(1ms)\n    print(\"waited\")\n}\n").unwrap()
    // Retired JIT/interpreter representation checks migrate to O0/O1/O2 behavior.
    loop (engine, flags) in [("o0", ["--profile=debug"]), ("o1", ["--profile=dev"]), ("o2", ["--release"])] {
        output :: Command.new(jet()).arg("run").args(flags).args(["--allow=Time.Wait", "wait.jet"]).current_dir(&app).env("NO_COLOR", "1").output().unwrap()
        stderr :: String.from_utf8_lossy(&output.stderr)
        assert(output.status.success(), "{engine}: --allow=Time.Wait must run:\n{stderr}")
        assert_eq(String.from_utf8_lossy(&output.stdout), "waited\n", "{engine}: {stderr}")
    }
}
