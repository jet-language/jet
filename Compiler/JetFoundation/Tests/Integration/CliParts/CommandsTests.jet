#Test("fix_dry_run_does_not_write") {
    p :: env.temp_dir().join("jet_cli_fix.jet")
    original :: "fn run() -> {\n    println(\"hi\")\n}\n"
    fs.write(&p, original).unwrap()
    out :: Command.new(jet()).arg("fix").arg(&p).arg("--dry-run").output().unwrap()
    s :: String.from_utf8_lossy(&out.stdout)
    assert(s.contains("dry run"), "dry-run should say so:\n{s}")
    assert(s.contains("print"), "diff should show the fix:\n{s}")
    assert_eq(fs.read_to_string(&p).unwrap(), original, "dry-run must not write")
    out2 :: Command.new(jet()).arg("fix").arg(&p).output().unwrap()
    assert_eq(out2.status.code(), Some(0))
    assert(fs.read_to_string(&p).unwrap().contains("print(\"hi\")"), "fix should rewrite the file")
}
