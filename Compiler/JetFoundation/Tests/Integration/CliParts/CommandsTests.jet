        assert(!stderr.contains(leaked), "`{leaked}` leaked:\n{stderr}")
    }
    dir :: isolated_cwd("check_fixed_comptime_size")
    fs.write(dir.join("mixed.jet"), "use core.mem\nfn fixed_size() -> Int { return 32 }\nfn bad(size: Int) -> {\n fixed :: mem.Fixed.new(size: size)\n close(^fixed)\n}\nfn run() -> {\n fixed :: mem.Fixed.new(size: fixed_size())\n close(^fixed)\n}\n").unwrap()
    mixed :: Command.new(jet()).args(["check", "mixed.jet"]).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
    assert_eq(mixed.status.code(), Some(1))
    mixed_stderr :: String.from_utf8_lossy(&mixed.stderr)
    assert(mixed_stderr.contains("Error [E0103]"), "{mixed_stderr}")
    assert(!mixed_stderr.contains("panicked at") && !mixed_stderr.contains("internal error"), "{mixed_stderr}")
    fs.write(dir.join("compare_chain.jet"), "fn helper() -> Int { return 1 }\nfn run() -> {\n if 0 < helper() < 2 {\n  print(\"reachable\")\n }\n}\n").unwrap()
    compare_chain :: Command.new(jet()).args(["check", "compare_chain.jet"]).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
    assert_eq(compare_chain.status.code(), Some(0), "{String.from_utf8_lossy(&compare_chain.stderr)}")
    fs.write(dir.join("higher_order_valid.jet"), "use core.mem\nfn apply(f: fn() -> Int) -> Int { return f() }\nfn fixed_size() -> Int { return 32 }\nfn run() -> {\n fixed :: mem.Fixed.new(size: apply(fixed_size))\n close(^fixed)\n}\n").unwrap()
    higher_order_valid :: Command.new(jet()).args(["check", "higher_order_valid.jet"]).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
    assert_eq(higher_order_valid.status.code(), Some(0), "{String.from_utf8_lossy(&higher_order_valid.stderr)}")
    fs.write(dir.join("higher_order_isolation.jet"), "use core.mem\nfn apply(f: fn() -> Int) -> Int { return f() }\nfn fixed_size() -> Int { return 32 }\nfn bad(size: Int) -> {\n fixed :: mem.Fixed.new(size: size)\n close(^fixed)\n}\nfn run() -> {\n fixed :: mem.Fixed.new(size: apply(fixed_size))\n close(^fixed)\n}\n").unwrap()
    higher_order_isolation :: Command.new(jet()).args(["check", "higher_order_isolation.jet"]).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
    assert_eq(higher_order_isolation.status.code(), Some(1))
    isolated_stderr :: String.from_utf8_lossy(&higher_order_isolation.stderr)
    assert_eq(isolated_stderr.matches("Error [E0103]").count(), 1, "{isolated_stderr}")
    loop leaked in ["panicked at", "entered unreachable code", "internal error"] {
        assert(!isolated_stderr.contains(leaked), "`{leaked}` leaked:\n{isolated_stderr}")
    }
    fs.write(dir.join("lambda_value.jet"), "fn run() -> {\n callback :: prep { () -> print(\"not called\") }\n print(\"ok\")\n}\n").unwrap()
    lambda_value :: Command.new(jet()).args(["check", "lambda_value.jet"]).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
    assert_eq(lambda_value.status.code(), Some(0), "{String.from_utf8_lossy(&lambda_value.stderr)}")
    fs.write(dir.join("helper.jet"), "use core.mem\nfn fixed_size() -> Int { return 32 }\nfn run() -> {\n fixed :: mem.Fixed.new(size: fixed_size())\n close(^fixed)\n}\n").unwrap()
    helper :: Command.new(jet()).args(["check", "helper.jet"]).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
    assert_eq(helper.status.code(), Some(0))
    helper_stderr :: String.from_utf8_lossy(&helper.stderr)
    assert(!helper_stderr.contains("panicked at") && !helper_stderr.contains("internal error"), "{helper_stderr}")
    fs.write(dir.join("main.jet"), "use core.mem\nfn run() -> {\n fixed :: mem.Fixed.new(size: 16 + 16)\n close(^fixed)\n}\n").unwrap()
    accepted :: Command.new(jet()).args(["check", "main.jet"]).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
    assert_eq(accepted.status.code(), Some(0), "{String.from_utf8_lossy(&accepted.stderr)}")
    accepted_stderr :: String.from_utf8_lossy(&accepted.stderr)
    assert(!accepted_stderr.contains("panicked at") && !accepted_stderr.contains("internal error"), "{accepted_stderr}")
}
// Rust: tests/cli_parts/commands.rs:1538
#Test("check_reports_soft_public_lints_without_failing") {
    dir :: isolated_cwd("check_soft_public")
    fs.write(dir.join("library.jet"), "pub fn _legacy() -> Int { return 1 }\n").unwrap()
    fs.write(dir.join("main.jet"), "use \"library\"\nfn run() -> { print(library._legacy()) }\n").unwrap()
    output :: Command.new(jet()).args(["check", "main.jet"]).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
    assert_eq(output.status.code(), Some(0))
    stderr :: String.from_utf8_lossy(&output.stderr)
    assert_eq(stderr.matches("[L0601]").count(), 1, "{stderr}")
    assert(!String.from_utf8_lossy(&output.stdout).contains("has no problems"), "{String.from_utf8_lossy(&output.stdout)}")
}
// Rust: tests/cli_parts/commands.rs:1567
#Test("ext_optional_run_resolves_dot_jet") {
    stem :: env.temp_dir().join("jet_cli_extopt_run")
    file :: stem.with_extension("jet")
    fs.write(&file, "fn run() -> {\n    print(\"hello-extopt\")\n}\n").unwrap()
    out :: Command.new(jet()).arg("run").arg(&stem).output().unwrap()
    assert_eq(out.status.code(), Some(0), "ext-optional run should exit 0; stderr: {String.from_utf8_lossy(&out.stderr)}")
    assert(String.from_utf8_lossy(&out.stdout).contains("hello-extopt"), "stdout: {String.from_utf8_lossy(&out.stdout)}")
}
// Rust: tests/cli_parts/commands.rs:1587
#Test("ext_optional_missing_path_keeps_original_name") {
    stem :: env.temp_dir().join("jet_cli_extopt_absent_xyz")
    out :: Command.new(jet()).arg("check").arg(&stem).output().unwrap()
    assert_ne(out.status.code(), Some(0))
    err :: String.from_utf8_lossy(&out.stderr)
    assert(err.contains("jet_cli_extopt_absent_xyz"), "error should name the original path; stderr: {err}")
}
// Rust: tests/cli_parts/commands.rs:1605
#Test("simple_exec_runs_without_a_manifest") {
    path :: OSPath.new(env.manifest_dir()).join("tests/fixtures/simple_exec/run.jet")
    out :: Command.new(jet()).arg("run").arg(&path).current_dir(isolated_cwd("simple_exec")).output().unwrap()
    assert_eq(out.status.code(), Some(0), "stderr: {String.from_utf8_lossy(&out.stderr)}")
    assert(String.from_utf8_lossy(&out.stdout).contains("simple exec, no manifest"), "stdout: {String.from_utf8_lossy(&out.stdout)}")
}
// Rust: tests/cli_parts/commands.rs:1631
#Test("passthrough_forwards_tokens_after_separator") {
    p :: args_fixture("1634")
    out :: Command.new(jet()).args(["run", "--profile=debug", p.to_str().unwrap(), "--", "--port", "8080", "x"]).output().unwrap()
    assert_eq(out.status.code(), Some(0), "stderr: {String.from_utf8_lossy(&out.stderr)}")
    stdout :: String.from_utf8_lossy(&out.stdout)
    trimmed := stdout.trim() // #4303
    assert(trimmed == "4", "expected 4 args (argv[0] + 3 forwarded), got: {stdout}")
}
// Rust: tests/cli_parts/commands.rs:1661
#Test("passthrough_forwards_version_flag_and_value_after_separator") {
    p :: args_fixture("1664")
    out :: Command.new(jet()).args(["run", "--profile=debug", p.to_str().unwrap(), "--", "--version", "1.0.0"]).output().unwrap()
    assert_eq(out.status.code(), Some(0), "stderr: {String.from_utf8_lossy(&out.stderr)}")
    stdout :: String.from_utf8_lossy(&out.stdout)
    trimmed := stdout.trim() // #4303
    assert_eq(trimmed, "3", "expected argv[0] plus --version and its value, got: {stdout}")
    version :: Command.new(jet()).arg("--version").output().unwrap()
    assert(version.status.success(), "jet --version failed: {String.from_utf8_lossy(&version.stderr)}")
    banner :: String.from_utf8_lossy(&version.stdout)
    assert(banner.starts_with("Jet "), "version banner: {banner}")
    assert(banner.contains("supported editions:"), "version banner missing editions: {banner}")
    assert(banner.contains("registry protocol: v"), "version banner missing registry protocol: {banner}")
}
// Rust: tests/cli_parts/commands.rs:1708
#Test("bare_separator_gives_empty_passthrough") {
    p :: args_fixture("1710")
    out :: Command.new(jet()).args(["run", "--profile=debug", p.to_str().unwrap(), "--"]).output().unwrap()
    assert_eq(out.status.code(), Some(0), "stderr: {String.from_utf8_lossy(&out.stderr)}")
    stdout :: String.from_utf8_lossy(&out.stdout)
    trimmed := stdout.trim() // #4303
    assert(trimmed == "1", "expected 1 arg (just argv[0]), got: {stdout}")
}
