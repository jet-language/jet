    source :: dir.join("broken.f90")
    fs.write(&source, """
module broken_math
  use iso_c_binding
contains
  function broken(a) result(value) bind(C, name="broken")
    integer(c_int64_t), value :: a
    integer(c_int64_t) :: value
    value = a +
  end function broken
end module broken_math
""").unwrap()
    output :: Command.new(jet()).args(["inspect", "bind", "fortran"]).arg(&source).args(["--pkg", "broken"]).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
