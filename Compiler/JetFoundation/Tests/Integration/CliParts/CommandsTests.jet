// Rust: tests/cli_parts/commands.rs:1317
#Test("run_rejected_collection_body_reports_only_frontend_diagnostics") {
    dir :: isolated_cwd("run_rejected_collection_body")
    fs.write(dir.join("main.jet"), """
use core.files as fs

struct Row {
    name: String
    count: Int
}

fn run() -> {
    fs.write("/tmp/jet_1271.csv", "alpha,1\n") ?? panic("write failed")
    text :: fs.read("/tmp/jet_1271.csv") ?? ""
    rows := [Row]{}
    loop line in text.split("\n") {
        parts :: line.split(",")
        &rows.push(Row{ name: parts.get(0), count: missing })
    }
    &rows.sort_by((row: Row) -> row.name)
}
""").unwrap()
    rejected :: Command.new(jet()).args(["run", "main.jet"]).current_dir(&dir).env("NO_COLOR", "1").output().unwrap()
    assert_eq(rejected.status.code(), Some(1))
    assert(rejected.stdout.is_empty(), "{rejected.stdout.debug()}")
    stderr :: scrub(&String.from_utf8(rejected.stderr).unwrap(), &dir.join("main.jet"))
    assert_eq(stderr,
        "Error [E0102]: `Iter` has no method `get`\n" +
        "  --> BAD.jet:14:36\n" +
        "    |\n" +
        " 14 |         rows.push(Row{ name: parts.get(0), count: missing })\n" +
        "    |                                    ^^^\n" +
        " Why: `Iter` is a one-pass source; `get` needs a materialized list, so collection consumes the source and allocates the list\n" +
        " Fix: Materialize it first with `.to_list()`; this consumes the source and allocates a list\n" +
        "More: jet-lang.dev/e/E0102\n\n" +
        "Error [E0107]: Nothing named `missing` exists here\n" +
        "  --> BAD.jet:14:51\n" +
        "    |\n" +
        " 14 |         rows.push(Row{ name: parts.get(0), count: missing })\n" +
        "    |                                                   ^^^^^^^\n" +
        " Why: A name must be declared before it's used\n" +
        " Fix: Declare it first: `missing :: ...`\n" +
        "More: jet-lang.dev/e/E0107\n\n" +
        "2 problems found\n" +
        "run `jet explain E0102` to learn more\n")
}
