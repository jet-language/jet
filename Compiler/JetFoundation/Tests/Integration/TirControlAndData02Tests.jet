// Rust: tests/tir_control_and_data.rs:2177
#Test("enum_unit_variants_and_exhaustive_match") {
    src :: """
enum Light {{ Red; Yellow; Green }}
fn next(light: Light) -> Light {{
    if light == {{
        .Red -> {{ return Light.Yellow }}
        .Yellow -> {{ return Light.Green }}
        .Green -> {{ return Light.Red }}
    }}
}}
fn label(light: Light) -> String {{
    if light == {{
        .Red -> {{ return "stop" }}
        .Yellow -> {{ return "caution" }}
        .Green -> {{ return "go" }}
    }}
}}
fn run() {{ start :: Light.Red; print(label(start)); print(label(next(start))) }}
"""
    assert_tiers_agree("tir_enum_unit", src, "stop\ncaution\n")
}

// Rust: tests/tir_control_and_data.rs:2208
