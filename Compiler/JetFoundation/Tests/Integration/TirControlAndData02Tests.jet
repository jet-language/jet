enum Conn {{ Active(Int); Reconnecting(Int); Blocked(String); Idle(Int); Closed }}
fn describe(c: Conn) -> String {{
    if c == {{
        .Active(id) | .Reconnecting(id) -> {{ return "live:{{id}}" }}
        .Blocked(id) -> {{ return "blocked:{{id}}" }}
        .Idle(_) -> {{ return "idle" }}
        .Closed -> {{ return "closed" }}
