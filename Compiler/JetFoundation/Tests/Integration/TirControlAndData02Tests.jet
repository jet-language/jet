// Rust: tests/tir_data_math_reactive.rs:275
#Test("reactive_effect_replaces_stale_dependencies") {
    if !have_rustc() { return }
    src :: """
use core.reactive as reactive
fn run() {{
    choose_left := reactive.signal(true)
    left := reactive.signal(1)
    right := reactive.signal(10)
    subscription := reactive.effect(() -> {{
        if choose_left.get() {{ print(left.get()) }} else {{ print(right.get()) }}
    }})
    choose_left.set(false)
    left.set(2)
    right.set(11)
}}
"""
    (code, stdout) :: build_and_run("tir_reactive_effect_stale_deps", src)
    assert_eq(code, 0)
    assert_eq(stdout, "1\n10\n11\n")
}

// Rust: tests/tir_data_math_reactive.rs:305
#Test("reactive_effect_unsubscribe_and_activity") {
    if !have_rustc() { return }
    src :: """
use core.reactive as reactive
fn run() {{
    value := reactive.signal(1)
    subscription := reactive.effect(() -> {{ print(value.get()) }})
    print(subscription.is_active())
    value.set(2)
    subscription.unsubscribe()
    print(subscription.is_active())
    subscription.unsubscribe()
    value.set(3)
}}
"""
    (code, stdout) :: build_and_run("tir_reactive_effect_lifecycle", src)
    assert_eq(code, 0)
    assert_eq(stdout, "1\ntrue\n2\nfalse\n")
}
