// Rust: tests/web_build.rs:3988
#Test("web_plain_run_loads_wasm_before_dom_print") {
    if !have_tool("rustc") || !have_tool("node") { eprintln("note: skipping web startup golden (need rustc + node)"); return }
    shown :: "tests/fixtures/web_plain_run_startup.jet"
    src :: include_str("tests/fixtures/web_plain_run_startup.jet")
    dir :: build_web_fixture("plain_run_startup", src, shown)
    js :: fs.read_to_string(dir.join("build/app.js")).unwrap()
    assert(!js.contains("jet_data_web_imports"), "plain Wasm run must not bundle the unreachable Data bridge")
    assert(!js.contains("jet_testing_history_web_imports"), "plain Wasm run must not initialize the unreachable history bridge")
    assert(!js.contains("function jet_compute_web"), "plain Wasm run must not bundle the unreachable WebGPU runtime")
    assert(!js.contains("function jet_game_"), "plain Wasm run must not bundle the unreachable game runtime")
    assert(!js.contains("exact repository TZif inputs"), "plain Wasm run must not embed the unreachable timezone database")
    assert(js.contains("async function loadWasm()"), "plain Wasm run needs loader:\n{js}")
    assert(js.contains("raw = wasm.jet_export_run();"), "plain Wasm run must call its emitted export:\n{js}")
    assert(js.contains(`jetDom.print("hello, web")`), "JS print path missing:\n{js}")
    harness :: `
const { jet_main, hello } = await import("./app.js");
await jet_main();
hello();
`
    assert_eq(run_node_harness(&dir, "plain_run_startup_harness.mjs", harness), "hello, web\n", "web startup golden output changed")
    _ :: fs.remove_dir_all(&dir)
}

