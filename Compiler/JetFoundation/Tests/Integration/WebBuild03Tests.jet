// Native fs/Command/env #4494; original generated Rust/Wasm assertions are peer
// codegen oracles, not callbacks into Rust. All source fixtures use ONE arrow.
// Rust: tests/web_build.rs:3526
#Test("web_wasm_inline_modules_emit_distinct_qualified_calls") {
    if !have_tool("rustc") || !have_tool("node") { eprintln("note: skipping web Wasm module identity test"); return }
    src :: `#Target(Web)
module left { pub fn value() -> Int { return 1 } }
module right { pub fn value() -> Int { return 2 } }
#WasmExport
fn total() -> Int { return left.value() + right.value() }
#Target(JS)
fn run() { print(total()) }
`
    dir :: build_web_fixture("wasm_module_identity", src, "tests/fixtures/web_wasm_module_identity.jet")
    wasm :: fs.read_to_string(dir.join("build/app_wasm.rs")).unwrap()
    assert(wasm.contains("fn jet_wasm___jet_left__value() -> JetOutcome<JetWasmInt, JetErr>"), "left Wasm identity was dropped:\n{wasm}")
    assert(wasm.contains("fn jet_wasm___jet_right__value() -> JetOutcome<JetWasmInt, JetErr>"), "right Wasm identity was dropped:\n{wasm}")
    assert(wasm.contains("jet_wasm___jet_left__value()"), "left qualified call was dropped:\n{wasm}")
    assert(wasm.contains("jet_wasm___jet_right__value()"), "right qualified call was dropped:\n{wasm}")
    assert_eq(run_web_app(&dir), "3\n")
    _ :: fs.remove_dir_all(&dir)
}

// Rust: tests/web_build.rs:3566
#Test("web_file_modules_keep_qualified_js_function_identity") {
