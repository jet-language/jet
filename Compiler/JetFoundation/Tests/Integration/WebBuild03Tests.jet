    _ :: fs.remove_dir_all(&dir)
}

// Rust: tests/web_build.rs:3673
#Test("web_file_module_same_leaf_partitions_ignore_load_order") {
    if !have_tool("rustc") || !have_tool("node") { eprintln("note: skipping web file-module partition identity test"); return }
    loop fixture in [
        (stem: "mixed_partition_left_first", imports: `use "./left" as left
use "./right" as right`),
        (stem: "mixed_partition_right_first", imports: `use "./right" as right
use "./left" as left`),
    ] {
        main :: "#Target(Web)\n{fixture.imports}\n#Target(JS)\n" + `fn run() { print(left.value() + right.value()) }` + "\n"
        dir :: build_web_project(fixture.stem, &[
            (path: "main.jet", source: main),
            (path: "left.jet", source: `#Target(JS)
fn helper() -[]> Int { return 1 }
#Target(JS)
pub fn value() -[]> Int { return helper() }
`),
            (path: "right.jet", source: `fn helper() -[]> Int { return 2 }
#WasmExport
pub fn value() -[]> Int { return helper() }
`),
        ])
        js :: fs.read_to_string(dir.join("build/app.js")).unwrap()
        assert(js.contains("function __jet_left__value()"), "JS sibling inherited Wasm bucket under {fixture.stem}:\n{js}")
        assert(js.contains("function __jet_left__helper()"), "JS local helper lost caller identity under {fixture.stem}:\n{js}")
        assert(js.contains("await bridge___jet_right__value()"), "Wasm sibling inherited JS bucket under {fixture.stem}:\n{js}")
        wasm :: fs.read_to_string(dir.join("build/app_wasm.rs")).unwrap()
        assert(wasm.contains("jet_wasm___jet_right__helper()"), "Wasm local helper lost caller identity under {fixture.stem}:\n{wasm}")
        assert_eq(run_web_app(&dir), "3\n", "load order changed behavior")
        _ :: fs.remove_dir_all(&dir)
    }
}

// Rust: tests/web_build.rs:3729
#Test("module_local_run_cannot_hijack_web_entrypoint") {
    if !have_tool("rustc") || !have_tool("node") { eprintln("note: skipping web entrypoint identity test"); return }
