pub fn exact_decision_token(text: String, authority: String) -> Bool {
    text.match_indices(authority).any((item) -> {
        start :: item.0
        before :: text[..start].chars().next_back()
        after :: text[start + authority.len()..].chars().next()
        before.is_none_or((ch) -> !decision_id_char(ch)) && after.is_none_or((ch) -> !decision_id_char(ch))
    })
}
