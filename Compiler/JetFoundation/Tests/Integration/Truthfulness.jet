//RS /// Current zero-use marker inventory. Each row has a card or retirement
//RS /// disposition; the set comparison below is the CI ratchet that rejects a
//RS /// new zero-use marker and rejects stale inventory rows.
//RS const MARKER_ZERO_USE_TRIAGE: &[(&str, &str)] = &[
//RS     ("Replayable", "card #349"),
//RS     ("Undo", "card #1820"),
//RS     ("Close", "card #1893"),
//RS     ("Error", "cards #2172/#2175"),
//RS     ("Encode", "card #1830"),
