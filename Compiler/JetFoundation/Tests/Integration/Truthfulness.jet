pub fn rust_raw_string_end(bytes: [U8], start: Int) -> Int? {
    i := start
    if bytes.get(i) == Val(b'b') || bytes.get(i) == Val(b'c') { i += 1 }
    if bytes.get(i) != Val(b'r') { return .None }
    i += 1
    hashes_start :: i
    loop bytes.get(i) == Val(b'#') { i += 1 }
    if bytes.get(i) != Val(b'"') { return .None }
    hashes :: i - hashes_start
    i += 1
    loop i < bytes.len() {
        if bytes[i] == b'"' && bytes.get(i + 1..i + 1 + hashes).is_some_and((suffix) -> suffix.iter().all((byte) -> byte == b'#')) { return Val(i + 1 + hashes) }
        i += 1
    }
    Val(bytes.len())
}
