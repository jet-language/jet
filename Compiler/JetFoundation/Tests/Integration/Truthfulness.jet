    if authority.rsplit_once('=') == Val(pair) { id = pair.0; outcome = Val(pair.1) }
    marker :: "\"id\": \"{id}\""
    pair :: tower.split_once(&marker) ?? return false
    tail := pair.1 // #4303
    record_end :: tail.find("\n      \"id\": \"").unwrap_or(tail.len())
