pub fn dependency_lines_with_context(text: String) -> [(String, String, Bool)] {
    lines :: text.lines().collect::<[String]>()
    out := [(String, String, Bool)]{}
    index := 0
    loop index < lines.len() {
        header :: table_header(lines[index]) ?? { index += 1; next }
        end :: lines[index + 1..].iter().position((line) -> table_header(line).is_some()).map_or(lines.len(), (offset) -> index + 1 + offset)
        if dependency_table(header) == Val(table) {
            if table == {
                .Entries -> {
                    context := String.new()
                    loop raw in lines[index + 1..end] {
                        line := raw.trim() // #4303
                        if line.is_empty() { context.clear(); next }
                        if line.starts_with('#') { context.push_str(line); context.push('\n'); next }
                        pair :: line.split_once('=') ?? next
                        out.push((line.to_string(), ^context, inline_table_has_key(pair.1.trim(), "path")))
                        context = String.new()
                    }
                }
                .Detail(name) -> {
                    fields :: lines[index + 1..end].iter().map((line) -> line.trim()).filter((line) -> !line.is_empty() && !line.starts_with('#')).collect::<[String]>()
                    if !fields.is_empty() {
                        first :: lines[index + 1..end].iter().position((raw) -> { line := raw.trim(); !line.is_empty() && !line.starts_with('#') }).map((offset) -> index + 1 + offset).unwrap()
                        context :: preceding_comments(&lines, index)
                        out.push(("{name}: {fields.join(", ")}", if context.is_empty() -> preceding_comments(&lines, first) else -> ^context, fields.iter().any((field) -> field.split_once('=').is_some_and((pair) -> pair.0.trim() == "path"))))
                    }
                }
            }
        }
        index = end
    }
    out
}
