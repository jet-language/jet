pub fn contains_word(text: String, needle: String) -> Bool {
    lower_text :: text.to_ascii_lowercase()
    lower_needle :: needle.to_ascii_lowercase()
    offset := 0
    loop {
        found :: lower_text[offset..].find(&lower_needle) ?? break
        start :: offset + found
        end :: start + lower_needle.len()
        before :: lower_text[..start].chars().next_back()
        after :: lower_text[end..].chars().next()
        if !before.is_some_and((ch) -> ch.is_ascii_alphanumeric() || ch == '_') && !after.is_some_and((ch) -> ch.is_ascii_alphanumeric() || ch == '_') { return true }
        offset = end
    }
    false
}
// Rust: tests/truthfulness.rs:1975
pub fn retired_vocabulary_senses(text: String) -> [String] {
    found := [String]{}
    loop raw in text.lines() {
        line :: raw.to_ascii_lowercase()
        called :: line.contains("called") || line.contains("as a")
        if called && line.contains("codec") && contains_word(&line, "stream") { found.push("codec mode called a stream") }
        if called && line.contains("event") && contains_word(&line, "stream") { found.push("event called a stream") }
        if called && line.contains("collecting loop") && line.contains("yielding") { found.push("collecting loop called yielding") }
    }
    found.sort_unstable()
    found.dedup()
    found
}
// Rust: tests/truthfulness.rs:1999
pub fn walk_md(dir: OSPath, cb: &(String -> Unit)) -> {
    reader :: fs.read_dir(dir).ok() ?? return
    entries := reader.flatten().collect()
    entries.sort_by_key((e) -> e.path())
    loop entry in entries {
        path :: entry.path()
        if path.is_dir() { walk_md(&path, &cb) }
        else if path.extension().and_then((e) -> e.to_str()) == Val("md") {
            if fs.read_to_string(&path).ok() == Val(s) { cb(&s) }
        }
    }
}
// Rust: tests/truthfulness.rs:2017
pub fn rs_files(dir: OSPath) -> [OSPath] {
    entries :: fs.read_dir(dir).ok() ?? return [OSPath]{}
    out := [OSPath]{}
    loop entry in entries.flatten() {
        path :: entry.path()
        if path.is_dir() { out.extend(rs_files(&path)) }
        else if path.extension().and_then((e) -> e.to_str()) == Val("rs") { out.push(^path) }
    }
    out.sort()
    out
}
