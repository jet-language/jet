    }
}
// Rust: tests/truthfulness.rs:633
pub fn strip_jet_comments_and_strings(source: String) -> String {
    // Rust: tests/truthfulness.rs:634
    enum Mode { Normal, LineComment, BlockComment(Int), String(quote: Char, triple: Bool) }
    mode := Mode.Normal
    chars := source.chars().peekable()
    clean := String.with_capacity(source.len())
    loop {
        ch :: chars.next() ?? break
        if mode == {
            .Normal -> {
                if ch == '/' && chars.peek() == Val('/') { _ :: chars.next(); mode = Mode.LineComment; clean.push(' ') }
                else if ch == '/' && chars.peek() == Val('*') { _ :: chars.next(); mode = Mode.BlockComment(1); clean.push(' ') }
                else if ch == '"' {
                    triple := false
                    if chars.peek() == Val('"') {
                        lookahead := chars.clone()
                        _ :: lookahead.next()
                        triple = lookahead.peek() == Val('"')
                    }
                    if triple { _ :: chars.next(); _ :: chars.next() }
                    mode = Mode.String(quote: '"', triple: triple)
                    clean.push(' ')
                } else if ch == '\'' { mode = Mode.String(quote: '\'', triple: false); clean.push(' ') }
                else { clean.push(ch) }
            }
            .LineComment -> { if ch == '\n' { mode = Mode.Normal; clean.push('\n') } }
            .BlockComment(depth) -> {
                if ch == '/' && chars.peek() == Val('*') { _ :: chars.next(); mode = Mode.BlockComment(depth + 1) }
                else if ch == '*' && chars.peek() == Val('/') {
                    _ :: chars.next()
                    mode = if depth == 1 -> Mode.Normal else -> Mode.BlockComment(depth - 1)
                } else if ch == '\n' { clean.push('\n') }
            }
            .String(quote, triple) -> {
                if ch == '\\' { _ :: chars.next() }
                else if ch == quote {
                    if triple {
                        if chars.peek() == Val('"') { _ :: chars.next(); if chars.peek() == Val('"') { _ :: chars.next(); mode = Mode.Normal } }
                    } else { mode = Mode.Normal }
                }
            }
        }
    }
    clean
}
// Rust: tests/truthfulness.rs:727
pub fn marker_used(clean_source: String, name: String) -> Bool {
    needle :: "#{name}"
    if clean_source.match_indices(&needle).any((item) -> {
        offset :: item.0
        before :: clean_source[..offset].chars().next_back()
        after :: clean_source[offset + needle.len()..].chars().next()
        !before.is_some_and((ch) -> ch.is_ascii_alphanumeric() || ch == '_') && !after.is_some_and((ch) -> ch.is_ascii_alphanumeric() || ch == '_')
    }) { return true }
    // Bracket-list positive entries only; !Equatable does not exercise the capability.
    clean_source.match_indices("#[").any((item) -> {
        list_start :: item.0 + 2
        nested := 0
        list_end := clean_source.len()
        loop (relative, ch) in clean_source[list_start..].char_indices() {
            if ch == '[' { nested += 1 }
            else if ch == ']' && nested == 0 { list_end = list_start + relative; break }
            else if ch == ']' { nested -= 1 }
        }
        clean_source[list_start..list_end].split(',').map((entry) -> entry.trim()).filter((entry) -> !entry.starts_with('!')).map((entry) -> entry.split((ch) -> ch == '(' || ch == ':' || ch.is_ascii_whitespace()).next().unwrap_or("")).any((entry) -> entry == name)
    })
}
// Rust: tests/truthfulness.rs:773
pub fn surface_used(clean_source: String, spelling: String) -> Bool {
    if spelling.strip_prefix('#') == Val(name) { marker_used(clean_source, name) }
    else { clean_source.contains(spelling) }
}
