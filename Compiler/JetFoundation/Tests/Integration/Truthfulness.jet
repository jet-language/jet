pub fn inline_table_has_key(value: String, wanted: String) -> Bool {
    body := value.strip_prefix('{') ?? return false // #4303
    start := 0
    quote := Char?.None
    escaped := false
    depth := 0
    loop (index, ch) in body.char_indices() {
        if quote == Val(delimiter) {
            if delimiter == '"' && ch == '\\' && !escaped { escaped = true; next }
            if ch == delimiter && !escaped { quote = .None }
            escaped = false
            next
        }
        if ch == '"' || ch == '\'' { quote = Val(ch) }
        else if ch == '[' || ch == '{' { depth += 1 }
        else if ch == '}' && depth == 0 { return body[start..index].split_once('=').is_some_and((pair) -> pair.0.trim() == wanted) }
        else if (ch == ']' || ch == '}') && depth > 0 { depth -= 1 }
        else if ch == ',' && depth == 0 {
            if body[start..index].split_once('=').is_some_and((pair) -> pair.0.trim() == wanted) { return true }
            start = index + ch.len_utf8()
        }
    }
    false
}
