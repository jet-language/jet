pub fn collect_feature_jet_files(dir: OSPath, files: &[OSPath]) -> {
    entries :: fs.read_dir(dir).ok() ?? return
    loop entry in entries.flatten() {
        path :: entry.path()
        if path.is_dir() {
            if path.file_name().and_then((name) -> name.to_str()) != Val("expected") { collect_feature_jet_files(&path, &files) }
