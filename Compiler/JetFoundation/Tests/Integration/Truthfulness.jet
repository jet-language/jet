// Rust: tests/truthfulness.rs:304
pub fn extract_example_paths(text: String) -> [String] {
    prefix :: "Examples/features/"
    out := [String]{}
    rest := text.as_str()
    loop {
        pos :: rest.find(prefix) ?? break
        rest = rest[pos + prefix.len()..]
        end :: rest.find((c) -> !c.is_alphanumeric() && c != '_' && c != '.' && c != '-' && c != '/').unwrap_or(rest.len())
        tail := rest[..end] // #4303
        if tail.ends_with(".jet") { out.push("{prefix}{tail}") }
    }
    out
}
