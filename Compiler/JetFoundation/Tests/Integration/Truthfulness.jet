// Rust: tests/truthfulness.rs:26
pub const RUSTC_PROBE_ALLOWED_HOMES: [String] = ["tests/common/mod.rs", "tests/tir_support/mod.rs", "tests/truthfulness.rs"]
// Rust: tests/truthfulness.rs:32
pub fn collect_rs_files(dir: OSPath, files: &[OSPath]) -> {
    entries :: fs.read_dir(dir).ok() ?? return
    loop entry in entries.flatten() {
        path :: entry.path()
        metadata :: fs.symlink_metadata(&path).ok() ?? next
        if metadata.file_type().is_symlink() { next }
        if metadata.is_dir() { collect_rs_files(&path, &files) }
        else if path.extension().is_some_and((extension) -> extension == "rs") { files.push(^path) }
    }
}
// Rust: tests/truthfulness.rs:55
pub fn stray_probe_sites(root: OSPath, needle: String) -> [String] {
    files := [OSPath]{}
    collect_rs_files(root.join("tests"), &files)
    files.sort()
    findings := [String]{}
    loop file in files {
        relative :: file.strip_prefix(root).expect("scanned file stays beneath repository root").to_string_lossy().replace('\\', "/")
        if RUSTC_PROBE_ALLOWED_HOMES.contains(relative) { next }
        source :: fs.read_to_string(&file).expect("test source is readable")
        collapsed :: source.chars().filter((c) -> !c.is_whitespace()).collect::<String>()
        collapsed_needle :: needle.chars().filter((c) -> !c.is_whitespace()).collect::<String>()
        if collapsed.contains(collapsed_needle) { findings.push(^relative) }
    }
    findings
}
