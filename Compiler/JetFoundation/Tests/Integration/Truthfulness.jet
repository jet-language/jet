// Rust: tests/truthfulness.rs:379
pub fn collect_feature_golden_sources(ex_dir: OSPath) -> [(OSPath, String)] {
    // Rust: tests/truthfulness.rs:380
    fn visit_project(dir: OSPath, ex_dir: OSPath, entries: &[(OSPath, String)]) -> {
        name :: dir.file_name().and_then((name) -> name.to_str()) ?? return
        if name.starts_with('.') || name == "expected" { return }
        run :: dir.join("run.jet")
        if run.is_file() {
            stem :: dir.strip_prefix(ex_dir).expect("feature project must be below Examples/features").to_string_lossy().replace('\\', "/")
            entries.push((^run, ^stem))
            return
        }
        // A manifest without run.jet owns descendants as modules/build/member fixtures.
        if dir.join("package.jet").is_file() || dir.join("workspace.jet").is_file() { return }
        children :: fs.read_dir(dir).ok() ?? return
        loop child in children.flatten() {
            path :: child.path()
            if path.is_dir() { visit_project(&path, ex_dir, &entries) }
        }
    }
    entries := [(OSPath, String)]{}
    topics :: fs.read_dir(ex_dir).ok() ?? return entries
    loop topic in topics.flatten() {
        topic_path :: topic.path()
        topic_name :: topic_path.file_name().and_then((name) -> name.to_str()) ?? next
        if !topic_path.is_dir() || topic_name.starts_with('.') || topic_name == "expected" { next }
        children :: fs.read_dir(&topic_path).ok() ?? next
        loop child in children.flatten() {
            path :: child.path()
            if path.is_file() && path.extension().and_then((extension) -> extension.to_str()) == Val("jet") && path.file_name().and_then((name) -> name.to_str()) != Val("package.jet") && path.file_name().and_then((name) -> name.to_str()) != Val("workspace.jet") && !path.file_name().and_then((name) -> name.to_str()).is_some_and((name) -> name.starts_with('.')) {
                stem :: feature_source_stem(&path, ex_dir)
                entries.push((^path, ^stem))
            } else if path.is_dir() { visit_project(&path, ex_dir, &entries) }
        }
    }
    entries.sort_by((left, right) -> left.1.cmp(&right.1))
    entries
}
// Rust: tests/truthfulness.rs:455
pub fn example_serves_until_stopped(path: OSPath) -> Bool {
    shown :: path.to_str() ?? return false
    bundle := jet.Loader.load_entry(shown).ok() ?? return false
    _ :: jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run)
    jet.AST.bundle_serves_until_stopped(&bundle)
}
