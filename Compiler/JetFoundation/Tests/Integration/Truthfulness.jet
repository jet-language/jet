}
// Rust: tests/truthfulness.rs:1261
pub enum DependencyTable { Entries, Detail(String) }
// Rust: tests/truthfulness.rs:1266
pub fn dependency_table(line: String) -> DependencyTable? {
    loop base in ["dependencies", "dev-dependencies", "build-dependencies"] {
        if line == base || (line.starts_with("target.") && line.ends_with(".{base}")) { return Val(DependencyTable.Entries) }
        if line.strip_prefix("{base}.") == Val(name) { return if !name.is_empty() -> Val(DependencyTable.Detail(name)) else -> .None }
        marker :: ".{base}."
        if line.starts_with("target.") {
            if line.rsplit_once(&marker) == Val(pair) { return if !pair.1.is_empty() -> Val(DependencyTable.Detail(pair.1)) else -> .None }
        }
    }
    .None
}
// Rust: tests/truthfulness.rs:1284
pub fn preceding_comments(lines: [String], index: Int) -> String {
    comments := lines[..index].iter().rev().map((line) -> line.trim()).take_while((line) -> line.starts_with('#')).collect::<[String]>()
    comments.reverse()
    comments.into_iter().map((line) -> "{line}\n").collect::<String>()
}
