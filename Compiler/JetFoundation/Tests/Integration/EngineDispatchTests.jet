// Rust: tests/engine_dispatch.rs:66
#Test("missing_engine_binary_is_e1228") {
    if target.selected_family() != "unix" { return }
    jet_dir :: Scratch.new("missing-jet")
    jet_bin :: isolated_jet(&jet_dir)
    empty_path_dir :: Scratch.new("missing-path")
    out :: output_with_retry(Command.new(&jet_bin).arg("env").env("PATH", &empty_path_dir.path))
    assert_eq(out.status.code(), Val(1), "engine-missing is USER_ERROR")
    stderr :: String.from_utf8_lossy(&out.stderr)
    assert(stderr.contains("E1228"), "expected E1228 in stderr: {stderr}")
    assert(stderr.contains("jetpack"), "names the missing engine: {stderr}")
}
// Rust: tests/engine_dispatch.rs:91
#Test("version_skew_is_e1227") {
    if target.selected_family() != "unix" { return }
    jet_dir :: Scratch.new("skew-jet")
    jet_bin :: isolated_jet(&jet_dir)
    path_dir :: Scratch.new("skew-path")
    fake_jetpack :: path_dir.join("jetpack")
    write_script(&fake_jetpack, "if [ \"$1\" = \"--engine-protocol\" ]; then echo \"0.0.0-skew-test\"; exit 0; fi\nexit 0")
    out :: output_with_retry(Command.new(&jet_bin).arg("env").env("PATH", &path_dir.path))
    assert_eq(out.status.code(), Val(1))
    stderr :: String.from_utf8_lossy(&out.stderr)
    assert(stderr.contains("E1227"), "expected E1227 in stderr: {stderr}")
    assert(stderr.contains("0.0.0-skew-test"), "names the mismatched version: {stderr}")
}
