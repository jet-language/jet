// Rust: tests/engine_dispatch.rs:152
#Test("exit_code_propagates_from_engine") {
    if target.selected_family() != "unix" { return }
    jet_bin_version :: env.build("CARGO_PKG_VERSION")
    jet_dir :: Scratch.new("exitcode-jet")
    jet_bin :: isolated_jet(&jet_dir)
    path_dir :: Scratch.new("exitcode-path")
    fake_jetpack :: path_dir.join("jetpack")
    write_script(&fake_jetpack, "if [ \"$1\" = \"--engine-protocol\" ]; then echo \"{jet_bin_version}\"; exit 0; fi\nexit 37")
    out :: output_with_retry(Command.new(&jet_bin).arg("env").env("PATH", &path_dir.path))
    assert_eq(out.status.code(), Val(37), "jet must return the engine's exit code verbatim")
}
// Rust: tests/engine_dispatch.rs:181
#Test("json_flag_forwarded_verbatim_to_engine") {
    if target.selected_family() != "unix" { return }
    jet_bin_version :: env.build("CARGO_PKG_VERSION")
    jet_dir :: Scratch.new("json-jet")
    jet_bin :: isolated_jet(&jet_dir)
    path_dir :: Scratch.new("json-path")
    fake_jetpack :: path_dir.join("jetpack")
    log :: path_dir.join("argv.log")
    write_script(&fake_jetpack, "if [ \"$1\" = \"--engine-protocol\" ]; then echo \"{jet_bin_version}\"; exit 0; fi\necho \"$@\" > \"{log.display()}\"\nexit 0")
    out :: output_with_retry(Command.new(&jet_bin).arg("env").arg("--json").env("PATH", &path_dir.path))
    assert_eq(out.status.code(), Val(0))
    logged :: fs.read_to_string(&log).unwrap_or_default()
    assert(logged.contains("--json"), "--json must reach the engine verbatim, got argv: {logged}")
}
