// Rust: tests/jetdoc.rs:191
#Test("package_fixture_rejects_order_and_content_drift") {
    scratch :: D.Scratch.new()
    entry :: scratch.copy_fixture_package("ordered.jet").to_string_lossy().into_owned()
    first :: D.jet_doc(&["doc", "--json", &entry], &scratch.path)
    assert(first.status.success(), String.from_utf8_lossy(&first.stderr))
    second :: D.jet_doc(&["doc", "--json", &entry], &scratch.path)
    assert(second.status.success(), String.from_utf8_lossy(&second.stderr))
    assert_eq(first.stdout, second.stdout, "package JSON order is not stable")
    json :: String.from_utf8(first.stdout).expect("UTF-8 package docs JSON")
    loop needle in ["\"summary\":\"Alpha API.\"", "\"signature\":\"pub fn alpha() -> Int { 6 }\\nfailure: Int (implicit default !Err)\"", "\"summary\":\"Zulu API.\"", "\"signature\":\"pub fn zulu() -> Int { 7 }\\nfailure: Int (implicit default !Err)\"", "\"link\":\"ordered.jet#L7\"", "\"link\":\"ordered.jet#L4\""] {
        assert(json.contains(needle), "package docs lack {needle}: {json}")
    }
    order :: ["\"qualified_name\":\"alpha\"", "\"qualified_name\":\"run\"", "\"qualified_name\":\"zulu\""]
    positions: [Int] :: order.iter().map(|needle| json.find(needle).expect("ordered package item")).collect()
    assert(positions.windows(2).all(|pair| pair[0] < pair[1]))
}
