// Rust: tests/jetdoc.rs:248
#Test("checked_text_contract_is_rendered_in_generated_docs") {
    scratch :: D.Scratch.new()
    entry_path :: scratch.path.join("checked_text.jet")
    fs.write(&entry_path, """#PubFile
#Error
enum PatternError { Bad }

/// A checked pattern.
Pattern :: distinct String

impl Pattern.CheckedText {
    type Error = PatternError

    fn check(text: String) -[]> PatternError! {
        return
    }

    fn encode_hole<T: Printable>(value: T) -[]> String {
        return ""
    }
}

fn run() {}
""").expect("write checked-text docs fixture")
    entry :: entry_path.to_string_lossy().into_owned()
    json_output :: D.jet_doc(&["doc", "--json", &entry], &scratch.path)
    assert(json_output.status.success(), "stdout: {String.from_utf8_lossy(&json_output.stdout)}\nstderr: {String.from_utf8_lossy(&json_output.stderr)}")
    json :: String.from_utf8(json_output.stdout).expect("UTF-8 docs JSON")
    assert(json.contains("Pattern :: distinct String"), json)
    assert(json.contains("implements CheckedText"))
    assert(json.contains("type Error = PatternError"))
    assert(json.contains("encode_hole"))
    rendered :: D.jet_doc(&["doc", &entry], &scratch.path)
    assert(rendered.status.success(), String.from_utf8_lossy(&rendered.stderr))
    markdown :: fs.read_to_string(scratch.path.join("docs/index.md")).expect("Markdown output")
    html :: fs.read_to_string(scratch.path.join("docs/index.html")).expect("HTML output")
    loop output in [&markdown, &html] {
        assert(output.contains("Pattern :: distinct String"), output)
        assert(output.contains("implements CheckedText"), output)
        assert(output.contains("type Error = PatternError"), output)
        assert(output.contains("encode_hole"), output)
    }
}
// Rust: tests/l0503_behavior.rs:52
#Test("l0503_fixture_keeps_exact_subject_span_and_policy") {
    compiled :: jet.compile_with_path(L.SOURCE, "tests/ui_lint/prefer_compound_assign.jet").unwrap_or_else(|diags| panic("L0503 fixture must compile: {diags:?}"))
    l0503: [jet.Diagnostic] := compiled.lints.iter().filter(|d| d.code == "L0503").collect()
    l0503.sort_by_key(|d| d.span.map_or(Int.MAX, |span| span.start))
    assert_eq(l0503.len(), L.EXPECTED_L0503.len(), "L0503 policy changed")
    assert_eq(compiled.lints.len(), L.EXPECTED_L0503.len(), "fixture gained an incidental lint")
    loop (diagnostic, (subject, expected_line, expected_column, expected_what, expected_fix)) in l0503.iter().zip(L.EXPECTED_L0503) {
        assert_eq(diagnostic.what, expected_what)
        assert_eq(diagnostic.why, L.WHY)
        assert_eq(diagnostic.fix, expected_fix)
        span :: diagnostic.span.expect("L0503 must identify its assignment operator")
        assert_eq(L.SOURCE[span.start..span.end], "=")
        prefix :: L.SOURCE[..span.start]
        line_start :: prefix.rfind('\n').map_or(0, |offset| offset + 1)
        line :: prefix.bytes().filter(|byte| byte == 10).count() + 1
        assert_eq(line, expected_line)
        assert_eq(span.start - line_start + 1, expected_column)
        assignment_line :: L.SOURCE[line_start..].lines().next().expect("L0503 assignment line")
        assert(assignment_line.contains("{subject} = {subject}") || assignment_line.contains("{subject} = ({subject}"), "L0503 subject disappeared from source line: {assignment_line}")
    }
    // Already-compound and indexed expansion (E0164) stay quiet.
    assert(L.SOURCE.contains("n += 1"))
    assert(L.SOURCE.contains("xs[0] = xs[0] + 1"))
}
