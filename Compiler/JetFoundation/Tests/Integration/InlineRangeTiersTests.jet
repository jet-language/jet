// Rust: tests/layout.rs:220
#Test("infeasible_required_constraints_report_conflict") {
    src :: """
fn run() {
    form :: Layout{
        a.width >= 100.0,
        a.width <= 50.0
    }
    print("feasible={(form.is_feasible())}")
    loop c in form.conflict() {
        print("conflict: {c}")
    }
}
"""
    assert(Y.error_codes(src).is_empty(), "infeasibility is a runtime fact, not a compile error: {Y.error_codes(src):?}")
    if out :: Y.build_and_run("infeasible", src) {
        assert(out.starts_with("feasible=false\n"), "got: {out}")
        assert(out.contains("conflict:"), "expected a named conflicting constraint, got: {out}")
    }
}
// Rust: tests/layout.rs:251
#Test("infeasible_value_read_panics_loudly") {
    src :: """
fn run() {
    form :: Layout{
        a.width >= 100.0,
        a.width <= 50.0
    }
    print("{(form.value(form.h("a", "width")))}")
}
"""
    assert(Y.error_codes(src).is_empty())
    dir0 :: Y.unique_tmp()
    fs.create_dir_all(&dir0).unwrap()
    fpath :: dir0.join("fixture.jet")
    fs.write(&fpath, src).unwrap()
    out :: jet.compile_with_path(src, &fpath.to_string_lossy()).unwrap()
    if !Common.have_rustc() { eprintln("note: rustc not found; compiled front end only"); return }
    dir :: env.temp_dir()
    rs :: dir.join("jet_layout_panic.rs")
    bin :: dir.join("jet_layout_panic")
    fs.write(&rs, &out.rust).unwrap()
    c :: Command.new("rustc").args(["--edition", "2021"]).arg(&rs).arg("-o").arg(&bin).output().unwrap()
    assert(c.status.success(), String.from_utf8_lossy(&c.stderr))
    r :: Command.new(&bin).output().unwrap()
    assert(!r.status.success(), "expected a panic (non-zero exit)")
    stderr :: String.from_utf8_lossy(&r.stderr)
    assert(stderr.contains("no feasible solution"), "expected the conflict message in the panic, got: {stderr}")
}
// Rust: tests/lib_use.rs:35
#Test("ffi_selective_import_aliases_resolve") {
    loop binder in jet.Foreign.BINDERS.iter().filter(|b| b.status == BinderStatus.Active && b.surface == BinderSurface.Namespace) {
        root :: binder.language.root()
        source :: "use {root}.[lib1 as first, lib2]\nfn run() {{ }}\n"
        (tokens, lex_diagnostics) :: jet.Lexer.lex(&source)
        assert(lex_diagnostics.is_empty(), "{root}: {lex_diagnostics:?}")
        program :: jet.Parser.parse(&tokens).unwrap_or_else(|d| panic("{root}: {d:?}"))
        import :: &program.imports[0]
        match &import.kind {
            ImportKind.Unqualified(..) -> {}
            _ -> panic("{root} list took a foreign-only parser branch")
        }
        assert_eq(import.foreign_imports().unwrap(), [
            (ForeignNamespace(language: binder.language, lib: "lib1"), "first"),
            (ForeignNamespace(language: binder.language, lib: "lib2"), "lib2")
        ])
        single_source :: "use {root}.single as alias\nfn run() {{ }}\n"
        (single_tokens, single_diagnostics) :: jet.Lexer.lex(&single_source)
        assert(single_diagnostics.is_empty(), "{root}: {single_diagnostics:?}")
        single_program :: jet.Parser.parse(&single_tokens).unwrap_or_else(|d| panic("{root}: {d:?}"))
        single_import :: &single_program.imports[0]
        match &single_import.kind {
            ImportKind.Module(path, _) -> assert_eq(path, "{root}.single")
            _ -> panic("{root} single import changed parser shape")
        }
        assert_eq(single_import.foreign_imports().unwrap(), [(ForeignNamespace(language: binder.language, lib: "single"), "alias")])
    }
}
// Rust: tests/lib_use.rs:125
#Test("realized_library_is_consumed_with_use") {
    s :: Common.Scratch.new("ok")
    hangar_root :: s.join("hangar-root")
    fs.create_dir_all(&hangar_root).unwrap()
    roots :: Roots(root: hangar_root.clone(), dev_mode: true)
    producer :: s.join("jsonutil-src")
    U.write(&producer.join("package.jet"), "name: \"jsonutil\"\nversion: \"0.1.0\"\npackages: { jsonutil: library }\n")
    U.write(&producer.join("jsonutil.jet"), "module jsonutil { }\npub fn parse(raw: String) -> Int { 42 }\n")
    realized :: U.realize_into_hangar(&roots, &producer, "jsonutil")
    entry :: realized.metadata()
    assert(entry.bin.is_empty(), "a library stages no PATH bin: {entry:?}")
    consumer :: s.join("app")
    U.write(&consumer.join("package.jet"), "name: \"app\"\nversion: \"0.1.0\"\ndeps: { jsonutil: acme/jsonutil/abc123@github }\n")
    U.write(&consumer.join("main.jet"), "use jsonutil\nfn run() {\n    print(jsonutil.parse(\"x\"))\n}\n")
    fs.create_dir_all(consumer.join(".jet/build")).unwrap()
    out :: Command.new(U.jet_bin()).args(["run", "main.jet"]).current_dir(&consumer).env("JETPACK_ROOT", &hangar_root).output().unwrap()
    stdout :: String.from_utf8_lossy(&out.stdout)
    stderr :: String.from_utf8_lossy(&out.stderr)
    assert(out.status.success(), "jet run failed\nstdout: {stdout}\nstderr: {stderr}")
    assert(stdout.contains("42"), "stdout: {stdout}\nstderr: {stderr}")
}
// Rust: tests/lib_use.rs:186
#Test("executable_is_not_importable") {
    s :: Common.Scratch.new("exe")
    hangar_root :: s.join("hangar-root")
    fs.create_dir_all(&hangar_root).unwrap()
    roots :: Roots(root: hangar_root.clone(), dev_mode: true)
    producer :: s.join("deploy-src")
    U.write(&producer.join("package.jet"), "name: \"deploy\"\nversion: \"0.1.0\"\npackages: { deploy: executable }\n")
    U.write(&producer.join("deploy.jet"), "module deploy { }\n")
    U.write(&producer.join("bin/deploy"), "#!/bin/sh\necho deploying\n")
    realized :: U.realize_into_hangar(&roots, &producer, "deploy")
    entry :: realized.metadata()
    assert(!entry.bin.is_empty(), "an executable stages a PATH bin: {entry:?}")
    consumer :: s.join("app")
    U.write(&consumer.join("package.jet"), "name: \"app\"\nversion: \"0.1.0\"\ndeps: { deploy: acme/deploy/abc123@github }\n")
    U.write(&consumer.join("main.jet"), "use deploy\nfn run() {\n    print(\"hi\")\n}\n")
    fs.create_dir_all(consumer.join(".jet/build")).unwrap()
    out :: Command.new(U.jet_bin()).args(["run", "main.jet"]).current_dir(&consumer).env("JETPACK_ROOT", &hangar_root).output().unwrap()
    assert(!out.status.success(), "use of an executable must fail")
    stderr :: String.from_utf8_lossy(&out.stderr)
    assert(stderr.contains("E0982"), "stderr: {stderr}")
    assert(stderr.contains("`deploy` is an executable package, so it can't be used with `use`"), "what line: {stderr}")
    assert(stderr.contains("an `executable` package installs a binary on your PATH"), "why line: {stderr}")
    assert(stderr.contains("change `deploy` to `library` in `package.jet`"), "fix line: {stderr}")
}
// Rust: tests/lib_use.rs:253
#Test("unrealized_library_points_at_build_when_preparation_is_refused") {
    s :: Common.Scratch.new("unrealized")
    hangar_root :: s.join("hangar-root")
    fs.create_dir_all(hangar_root.join("hangar")).unwrap()
    consumer :: s.join("app")
    U.write(&consumer.join("package.jet"), "name: \"app\"\nversion: \"0.1.0\"\ndeps: { jsonutil: acme/jsonutil/abc123@github }\n")
    U.write(&consumer.join("main.jet"), "use jsonutil\nfn run() {\n    print(jsonutil.parse(\"x\"))\n}\n")
    fs.create_dir_all(consumer.join(".jet/build")).unwrap()
    out :: Command.new(U.jet_bin()).args(["run", "main.jet", "--no-prepare"]).current_dir(&consumer).env("JETPACK_ROOT", &hangar_root).output().unwrap()
    assert(!out.status.success(), "an unrealized library must fail")
    stderr :: String.from_utf8_lossy(&out.stderr)
    assert(stderr.contains("E0983"), "stderr: {stderr}")
    assert(stderr.contains("the library package `jsonutil` hasn't been built yet"), "what line: {stderr}")
    assert(stderr.contains("its source staged in the shared store (hangar)"), "why line: {stderr}")
    assert(stderr.contains("run `jetpack env --prep` to realize `jsonutil`"), "fix line: {stderr}")
}
