// Rust: tests/inline_range_tiers.rs:190
#Test("named_range_tir_keeps_the_fixed_list_read_direct") {
    compiled :: jet.compile_with_path(R.NAMED_RANGE_EXAMPLE, "Examples/features/types/refinements.jet").expect("named range example must reach TIR")
    start :: compiled.rust.find("pub fn __jet_pick").expect("generated pick function")
    tail :: compiled.rust[start..]
    body :: tail.split_once("\npub fn").map_or(tail, |(body, _)| body)
