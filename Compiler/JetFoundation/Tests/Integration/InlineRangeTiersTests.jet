// Rust: tests/inline_range_tiers.rs:39
#Test("inline_range_comptime_and_repl_accept_legal_inputs") {
    compiled :: jet.compile_with_path(R.EXAMPLE, "Examples/features/types/range_types.jet").expect("inline range example must compile through the shared front end")
    assert(compiled.rust.contains("42"), "comptime inline-range binding was not carried into generated output")
    // REPL accepts one item/statement; #Numeric belongs in the file-wide check.
    transcript :: jet.REPL.run_transcript(&[
        "fn set_brightness(level: Int(0..100)) -> Int(0..100) { level }",
        "fn checked_inline(raw: Int) -> Int(0..100) String! { Int(0..100).from_int(raw) }",
        "print(set_brightness(42))",
        "print(checked_inline(3) ?? Int(0..100).from_int(0))"
    ], None)
    assert_eq(transcript, "ok\nok\n42\n3\n")
}
