    mixed_assert_failed_with("stale Python binding source", stale_source, "E3208")
    fs.write(&source, original_source).unwrap()
    mixed_recover_stale_descriptor(case_root, cache, "5\nfalse\n99\n123\n", None, || -> mixed_bind_python(case_root))
    mixed_assert_bad_bind(case_root, ["inspect", "bind", "py", "broken.py", "--pkg", "broken"], case_root.join(".jet/bindings/py/broken.jet"))
    edited :: fs.read_to_string(&source).unwrap().replace("return left + right", "return left + right + 1")
    fs.write(&source, edited).unwrap()
    rebound :: mixed_bind_python(case_root)
    mixed_assert_ok("edited Python rebind", rebound)
    edited_run :: mixed_jet_output(case_root, ["run", "run.jet"], None)
    mixed_assert_ok("edited Python run", edited_run)
    assert_eq(String.from_utf8_lossy(&edited_run.stdout), "6\nfalse\n99\n123\n")
}
