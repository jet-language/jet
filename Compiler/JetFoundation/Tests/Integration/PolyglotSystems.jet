use std.fs
use std.env
use std.process.[Command, Output]
use core.sys.target.[selected_os, selected_family]
use jet.Debug

// Rust: tests/polyglot_systems.rs:15
pub fn tool(name: String) -> OSPath? {
    env.var_os("PATH").into_iter()
        .flat_map(|value| -> env.split_paths(&value).collect())
        .map(|dir| -> dir.join(name))
        .find(|path| -> path.is_file())
        .and_then(|path| -> fs.canonicalize(path).ok())
}

// Rust: tests/polyglot_systems.rs:24
// GATE #4494: native process invocation.
pub fn run(command: &Command) -> {
    output :: command.output().unwrap()
    assert(output.status.success(), "{String.from_utf8_lossy(&output.stderr)}")
}

// Card #1348: mixed-repository adoption loop. Native Jet Library -> C/C++
// hosts are covered by library_outputs; JVM/JS/Python guest exports remain
// outside that native Library contract.
// Rust: tests/polyglot_systems.rs:391
pub fn mixed_required_tool(name: String) -> OSPath {
    tool(name).unwrap_or_else(|| -> panic("mixed-repo production matrix requires `{name}`; install the host toolchain or run the host-gated proof in the provisioned Jet environment"))
}

// Rust: tests/polyglot_systems.rs:400
// GATE #4494: native CLI process invocation.
pub fn mixed_jet(cwd: OSPath) -> Command {
    command := Command.new(env("CARGO_BIN_EXE_jet"))
    command.current_dir(cwd).env("NO_COLOR", "1")
    command
}

// Rust: tests/polyglot_systems.rs:407
pub fn mixed_jet_output(cwd: OSPath, args: [String], java_home: OSPath?) -> Output {
    command := mixed_jet(cwd)
    if java_home is Some(home) { command.env("JAVA_HOME", home) }
    command.args(args).output().unwrap_or_else(|error| -> panic("could not start jet {args:?}: {error}"))
}

// Rust: tests/polyglot_systems.rs:419
pub fn mixed_output_text(output: Output) -> String {
    "stdout:\n{String.from_utf8_lossy(&output.stdout)}\nstderr:\n{String.from_utf8_lossy(&output.stderr)}"
}

// Rust: tests/polyglot_systems.rs:428
pub fn mixed_assert_ok(label: String, output: Output) -> {
    assert(output.status.success(), "{label} failed\n{mixed_output_text(output)}")
}

// Rust: tests/polyglot_systems.rs:433
pub fn mixed_assert_failed_with(label: String, output: Output, marker: String) -> {
    assert(!output.status.success(), "{label} unexpectedly passed")
    text :: mixed_output_text(output)
    assert(text.contains(marker), "{label} omitted `{marker}`\n{text}")
}

// Rust: tests/polyglot_systems.rs:440
pub fn mixed_assert_common_provenance(path: OSPath) -> String {
    text :: fs.read_to_string(path).unwrap()
    assert(text.contains("schema=jet-ffi-bridge-provenance-v1\n"), "{path.display()} did not use the common bridge provenance schema:\n{text}")
    assert(text.lines().any(|line| -> line.starts_with("identity=")), "{path.display()} has no bridge identity:\n{text}")
    text
}

// Rust: tests/polyglot_systems.rs:456
pub fn mixed_write_package(root: OSPath, name: String, deps: String?) -> {
    dependency_line :: deps.map(|deps| -> "deps: {{ {deps} }}\n").unwrap_or_default()
    fs.write(root.join("package.jet"), "name: \"{name}\"\nversion: \"0.1.0\"\n{dependency_line}").unwrap()
}

// Rust: tests/polyglot_systems.rs:468
pub fn mixed_build_archive(cc: OSPath, ar: OSPath, root: OSPath, stem: String, threaded: Bool) -> {
    source :: root.join("{stem}.c")
    object :: root.join("{stem}.o")
    archive :: root.join("lib{stem}.a")
    compile := Command.new(cc)
    compile.args(["-std=c11", "-fPIC", "-c"])
    if threaded { compile.arg("-pthread") }
    compile.arg(&source).arg("-o").arg(&object)
    output :: compile.output().unwrap()
    assert(output.status.success(), "C host compile failed\n{mixed_output_text(output)}")
    archive_command := Command.new(ar)
    archive_command.args(["rcs"]).arg(&archive).arg(&object)
    archived :: archive_command.output().unwrap()
    assert(archived.status.success(), "C host archive failed\n{mixed_output_text(archived)}")
}

// Rust: tests/polyglot_systems.rs:495
pub fn mixed_build_cpp_archive(clang: OSPath, ar: OSPath, root: OSPath, target: String) -> {
    source :: root.join("counter.cpp")
    object :: root.join("counter.o")
    archive :: root.join("libcounter_impl.a")
    compile := Command.new(clang)
    compile.args(["-std=c++17", "-fPIC", "-pthread", "-c", "-target"]).arg(target).arg("-I").arg(root).arg(&source).arg("-o").arg(&object)
    output :: compile.output().unwrap()
    assert(output.status.success(), "C++ host compile failed\n{mixed_output_text(output)}")
    archive_command := Command.new(ar)
    archive_command.args(["rcs"]).arg(&archive).arg(&object)
    archived :: archive_command.output().unwrap()
    assert(archived.status.success(), "C++ host archive failed\n{mixed_output_text(archived)}")
}

// Rust: tests/polyglot_systems.rs:525
pub fn mixed_strip_archive(strip: OSPath, archive: OSPath, label: String) -> {
    command := Command.new(strip)
    // GATE #4483: selected target, not the compiler host.
    if selected_os() == "macos" { command.arg("-S") }
    else { command.arg("--strip-debug") }
    output :: command.arg(archive).output().unwrap()
    assert(output.status.success(), "{label} strip failed\n{mixed_output_text(output)}")
}

// Rust: tests/polyglot_systems.rs:541
pub fn mixed_java_home(javac: OSPath) -> OSPath {
    home :: env.var_os("JAVA_HOME").map(|path| -> OSPath.from(path))
        .or_else(|| -> javac.parent().and_then(|path| -> path.parent()).map(|path| -> path.to_path_buf()))
        .unwrap_or_else(|| -> panic("cannot infer JAVA_HOME from {javac.display()}"))
    // GATE #4483: selected OS controls the JVM library spelling.
    runtime :: home.join("lib/server").join(if selected_os() == "macos" { "libjvm.dylib" } else { "libjvm.so" })
    assert(runtime.is_file(), "JAVA_HOME={home.display()} has no embedded JVM runtime at {runtime.display()}")
    home
}

// Rust: tests/polyglot_systems.rs:561
pub fn mixed_bind_c(root: OSPath) -> Output {
    mixed_jet_output(root, ["inspect", "bind", "counter.h", "--pkg", "counter"], None)
}

// Rust: tests/polyglot_systems.rs:570
pub fn mixed_bind_cpp(root: OSPath, target: String, clang: OSPath, ar: OSPath) -> Output {
    command := mixed_jet(root)
    command.args(["inspect", "bind", "cpp", "counter.hpp", "--target"]).arg(target)
        .args(["--clang"]).arg(clang).args(["--ar"]).arg(ar)
        .args(["--pkg", "counter", "--namespace", "acme", "-I"]).arg(root)
        .args(["-L"]).arg(root).args(["-l", "counter_impl", "-l", "pthread"]).output().unwrap()
}

// Rust: tests/polyglot_systems.rs:589
pub fn mixed_bind_java(root: OSPath, java_home: OSPath) -> Output {
    mixed_jet_output(root, ["inspect", "bind", "java", "Counter.java", "--pkg", "counter"], Some(java_home))
}

// Rust: tests/polyglot_systems.rs:598
pub fn mixed_bind_js(root: OSPath) -> Output {
    mixed_jet_output(root, ["inspect", "bind", "js", "ops.d.ts", "--runtime", "ops.mjs", "--pkg", "ops"], None)
}

// Rust: tests/polyglot_systems.rs:616
pub fn mixed_bind_python(root: OSPath) -> Output {
    mixed_jet_output(root, ["inspect", "bind", "py", "ops.py", "--pkg", "ops"], None)
}

// Rust: tests/polyglot_systems.rs:625
pub fn mixed_run_workflow(root: OSPath, expected: String, java_home: OSPath?) -> {
    run_file :: root.join("run.jet")
    run_path :: run_file.to_str().unwrap()
    assert_eq(Debug.needs_native(run_path), Some(true))
    checked :: mixed_jet_output(root, ["check", "run.jet"], java_home)
    mixed_assert_ok("mixed-repo check", checked)
    built :: mixed_jet_output(root, ["build", "--profile=debug", "run.jet"], java_home)
    mixed_assert_ok("mixed-repo debug build", built)
    tested :: mixed_jet_output(root, ["test", "--coverage", "--profile=debug", "run.jet"], java_home)
    mixed_assert_ok("mixed-repo test with coverage", tested)
    assert(mixed_output_text(tested).contains("coverage:"), "test completed without a coverage report\n{mixed_output_text(tested)}")
    run_output :: mixed_jet_output(root, ["run", "--profile=debug", "run.jet"], java_home)
    mixed_assert_ok("mixed-repo debug-profile run", run_output)
    assert_eq(String.from_utf8_lossy(&run_output.stdout), expected)
    debug_file :: root.join("debug.jet")
    fs.write(&debug_file, include_str("tests/fixtures/mixed_repo/debug.jet")).unwrap()
    debug :: Debug.run_session_result(debug_file.to_str().unwrap(), ["s", "c"])
    assert_eq(debug.status, Debug.SessionStatus.Finished)
    assert(debug.transcript.contains("program finished"))
    assert(debug.transcript.contains("42"))
    trace :: root.join("profile.jettrace")
    perf_command := mixed_jet(root)
    if java_home is Some(home) { perf_command.env("JAVA_HOME", home) }
    perf :: perf_command.args(["perf", "run", "run.jet", "--profile=debug", "--out"]).arg(&trace).output().unwrap()
    mixed_assert_ok("mixed-repo profile capture", perf)
    trace_text :: fs.read_to_string(&trace).unwrap()
    assert(trace_text.contains("\"schema\":\"jet.trace\""))
    assert(trace_text.contains("run.jet"))
    assert(trace_text.contains("source_identity"))
    assert(!trace_text.contains("__jet_"))
    view_command := mixed_jet(root)
    view :: view_command.args(["perf", "view"]).arg(&trace).arg("--json").output().unwrap()
    mixed_assert_ok("mixed-repo profile view", view)
    view_text :: String.from_utf8_lossy(&view.stdout)
    assert(view_text.contains("\"kind\":\"jet.trace.view\""))
    assert(view_text.contains("\"flamegraph\":"))
}

// Rust: tests/polyglot_systems.rs:694
pub fn mixed_recover_stale_descriptor(root: OSPath, cache: OSPath, expected: String, java_home: OSPath?, rebind: fn() -> Output) -> {
    original :: fs.read_to_string(cache).unwrap()
    stale :: original.replacen("jet-ffi-descriptor=", "jet-ffi-descriptor=stale-", 1)
    assert_ne(original, stale)
    fs.write(cache, stale).unwrap()
    rejected :: mixed_jet_output(root, ["check", "run.jet"], java_home)
    mixed_assert_failed_with("stale foreign descriptor", rejected, "E3208")
    rebound :: rebind()
    mixed_assert_ok("foreign descriptor recovery bind", rebound)
    recovered :: mixed_jet_output(root, ["run", "--profile=debug", "run.jet"], java_home)
    mixed_assert_ok("foreign descriptor recovery run", recovered)
    assert_eq(String.from_utf8_lossy(&recovered.stdout), expected)
}

// Rust: tests/polyglot_systems.rs:720
pub fn mixed_assert_bad_bind(root: OSPath, args: [String], cache: OSPath) -> {
    rejected :: mixed_jet_output(root, args, None)
    mixed_assert_failed_with("malformed foreign source", rejected, "E3208")
    assert(!cache.exists(), "malformed foreign source published {cache:?}")
}

// Rust: tests/polyglot_systems.rs:727
pub fn mixed_c_case(root: OSPath, cc: OSPath, ar: OSPath, strip: OSPath) -> {
    case_root :: root.join("c")
    fs.create_dir_all(&case_root).unwrap()
    fs.write(case_root.join("counter.h"), include_str("tests/fixtures/mixed_repo/c/counter.h")).unwrap()
    fs.write(case_root.join("counter.c"), include_str("tests/fixtures/mixed_repo/c/counter.c")).unwrap()
    fs.write(case_root.join("run.jet"), include_str("tests/fixtures/mixed_repo/c/run.jet")).unwrap()
    mixed_write_package(case_root, "mixed_c", Some("counter: c@\"{case_root.display()}\", pthread: c@system"))
    mixed_build_archive(cc, ar, case_root, "counter", true)
    bind :: mixed_bind_c(case_root)
    mixed_assert_ok("C header bind", bind)
    cache :: case_root.join(".jet/bindings/c/counter.jet")
    assert(fs.read_to_string(&cache).unwrap().contains("jet-ffi-descriptor="))
    assert(case_root.join(".jet/bindings/c/counter.hash").is_file())
    provenance :: mixed_assert_common_provenance(case_root.join(".jet/bindings/c/counter.provenance"))
    assert(provenance.contains("linked-archive="))
    assert(provenance.contains("linked-archive-sha256="))
    archive :: case_root.join("libcounter.a")
    original_archive :: fs.read(&archive).unwrap()
    changed_archive := original_archive.clone()
    changed_archive.push(0)
    fs.write(&archive, changed_archive).unwrap()
    stale_archive :: mixed_jet_output(case_root, ["run", "run.jet"], None)
    mixed_assert_failed_with("stale C implementation archive", stale_archive, "E3208")
    fs.write(&archive, &original_archive).unwrap()
    mixed_run_workflow(case_root, "42\n42\n", None)
    mixed_strip_archive(strip, archive, "C host archive")
    rebound :: mixed_bind_c(case_root)
    mixed_assert_ok("stripped C rebind", rebound)
    release :: mixed_jet_output(case_root, ["run", "--profile=release", "run.jet"], None)
    mixed_assert_ok("stripped C release run", release)
    assert_eq(String.from_utf8_lossy(&release.stdout), "42\n42\n")
    mixed_recover_stale_descriptor(case_root, cache, "42\n42\n", None, || -> mixed_bind_c(case_root))
    fs.write(case_root.join("broken.h"), include_str("tests/fixtures/mixed_repo/c/broken.h")).unwrap()
    mixed_assert_bad_bind(case_root, ["inspect", "bind", "broken.h", "--pkg", "broken"], case_root.join(".jet/bindings/c/broken.jet"))
    fs.write(case_root.join("broken.h"), "#include <stdint.h>\nint64_t repaired(int64_t value);\n").unwrap()
    repaired :: mixed_jet_output(case_root, ["inspect", "bind", "broken.h", "--pkg", "broken"], None)
    mixed_assert_ok("C malformed-header recovery", repaired)
}

// Rust: tests/polyglot_systems.rs:811
pub fn mixed_cpp_case(root: OSPath, clang: OSPath, ar: OSPath, strip: OSPath, target: String) -> {
    case_root :: root.join("cpp")
    fs.create_dir_all(&case_root).unwrap()
    fs.write(case_root.join("counter.hpp"), include_str("tests/fixtures/mixed_repo/cpp/counter.hpp")).unwrap()
    fs.write(case_root.join("counter.cpp"), include_str("tests/fixtures/mixed_repo/cpp/counter.cpp")).unwrap()
    fs.write(case_root.join("run.jet"), include_str("tests/fixtures/mixed_repo/cpp/run.jet")).unwrap()
    mixed_write_package(case_root, "mixed_cpp", None)
    mixed_build_cpp_archive(clang, ar, case_root, target)
    bind :: mixed_bind_cpp(case_root, target, clang, ar)
    mixed_assert_ok("C++ bind", bind)
    cache :: case_root.join(".jet/bindings/cpp/counter.jet")
    link :: case_root.join(".jet/bindings/cpp/counter.link")
    assert(fs.read_to_string(&cache).unwrap().contains("jet-ffi-descriptor="))
    provenance :: mixed_assert_common_provenance(case_root.join(".jet/bindings/cpp/counter.provenance"))
    assert(provenance.contains("linked-archive="))
    assert(provenance.contains("linked-archive-sha256="))
    assert(link.is_file())
    archive :: case_root.join("libcounter_impl.a")
    original_archive :: fs.read(&archive).unwrap()
    changed_archive := original_archive.clone()
    changed_archive.push(0)
    fs.write(&archive, changed_archive).unwrap()
    stale_archive :: mixed_jet_output(case_root, ["run", "run.jet"], None)
    mixed_assert_failed_with("stale C++ implementation archive", stale_archive, "E3208")
    fs.write(&archive, &original_archive).unwrap()
    header :: case_root.join("counter.hpp")
    original_header :: fs.read_to_string(&header).unwrap()
    fs.write(&header, "{original_header}\n// stale binding source\n").unwrap()
    stale_source :: mixed_jet_output(case_root, ["run", "run.jet"], None)
    mixed_assert_failed_with("stale C++ binding source", stale_source, "E3208")
    fs.write(&header, original_header).unwrap()
    mixed_run_workflow(case_root, "15\n17\n42\n42\n-1\n", None)
    mixed_strip_archive(strip, archive, "C++ host archive")
    rebound :: mixed_bind_cpp(case_root, target, clang, ar)
    mixed_assert_ok("stripped C++ rebind", rebound)
    release :: mixed_jet_output(case_root, ["run", "--profile=release", "run.jet"], None)
    mixed_assert_ok("stripped C++ release run", release)
    assert_eq(String.from_utf8_lossy(&release.stdout), "15\n17\n42\n42\n-1\n")
    mixed_recover_stale_descriptor(case_root, cache, "15\n17\n42\n42\n-1\n", None, || -> mixed_bind_cpp(case_root, target, clang, ar))
    link_original :: fs.read_to_string(&link).unwrap()
    link_stale :: link_original.replacen("target\t{target}", "target\tmixed-invalid-target", 1)
    assert_ne(link_original, link_stale)
    fs.write(&link, link_stale).unwrap()
    abi_rejected :: mixed_jet_output(case_root, ["run", "run.jet"], None)
    mixed_assert_failed_with("C++ ABI-target mismatch", abi_rejected, "E3201")
    abi_rebound :: mixed_bind_cpp(case_root, target, clang, ar)
    mixed_assert_ok("C++ ABI-target recovery bind", abi_rebound)
    recovered :: mixed_jet_output(case_root, ["run", "run.jet"], None)
    mixed_assert_ok("C++ ABI-target recovery run", recovered)
    assert_eq(String.from_utf8_lossy(&recovered.stdout), "15\n17\n42\n42\n-1\n")
    link_current :: fs.read_to_string(&link).unwrap()
    stale_names :: link_current.replacen("l\tcounter_impl\n", "l\tcounter_impl_stale\n", 1)
    assert_ne(link_current, stale_names)
    fs.write(&link, stale_names).unwrap()
    stale_link :: mixed_jet_output(case_root, ["run", "run.jet"], None)
    mixed_assert_failed_with("stale C++ link provenance", stale_link, "E3208")
    link_rebound :: mixed_bind_cpp(case_root, target, clang, ar)
    mixed_assert_ok("C++ link provenance recovery bind", link_rebound)
    link_recovered :: mixed_jet_output(case_root, ["run", "run.jet"], None)
    mixed_assert_ok("C++ link provenance recovery run", link_recovered)
}

// Rust: tests/polyglot_systems.rs:914
pub fn mixed_java_case(root: OSPath, java_home: OSPath) -> {
    case_root :: root.join("jvm")
    fs.create_dir_all(&case_root).unwrap()
    fs.write(case_root.join("Counter.java"), include_str("tests/fixtures/mixed_repo/jvm/Counter.java")).unwrap()
    fs.write(case_root.join("run.jet"), include_str("tests/fixtures/mixed_repo/jvm/run.jet")).unwrap()
    mixed_write_package(case_root, "mixed_jvm", None)
    bind :: mixed_bind_java(case_root, java_home)
    mixed_assert_ok("JVM bind", bind)
    cache :: case_root.join(".jet/bindings/java/counter.jet")
    assert(cache.is_file())
    _ :: mixed_assert_common_provenance(case_root.join(".jet/bindings/java/counter.provenance"))
    assert(case_root.join(".jet/bindings/java/counter.jvm-path").is_file())
    mixed_run_workflow(case_root, "42\n5.0\n-7\n", Some(java_home))
    source :: case_root.join("Counter.java")
    original_source :: fs.read_to_string(&source).unwrap()
    fs.write(&source, "{original_source}\n// stale binding source\n").unwrap()
    stale_source :: mixed_jet_output(case_root, ["run", "run.jet"], Some(java_home))
    mixed_assert_failed_with("stale JVM binding source", stale_source, "E3208")
    fs.write(&source, original_source).unwrap()
    edited :: fs.read_to_string(&source).unwrap().replace("value += amount", "value += amount + 1")
    fs.write(&source, edited).unwrap()
    rebound :: mixed_bind_java(case_root, java_home)
    mixed_assert_ok("edited JVM rebind", rebound)
    edited_run :: mixed_jet_output(case_root, ["run", "--profile=debug", "run.jet"], Some(java_home))
    mixed_assert_ok("edited JVM run", edited_run)
    assert_eq(String.from_utf8_lossy(&edited_run.stdout), "43\n5.0\n-7\n")
}

// Rust: tests/polyglot_systems.rs:963
pub fn mixed_js_case(root: OSPath) -> {
    case_root :: root.join("js")
    fs.create_dir_all(&case_root).unwrap()
    for (name, fixture) in [
        ("ops.d.ts", include_str("tests/fixtures/mixed_repo/js/ops.d.ts")),
        ("ops.mjs", include_str("tests/fixtures/mixed_repo/js/ops.mjs")),
        ("run.jet", include_str("tests/fixtures/mixed_repo/js/run.jet")),
        ("broken.d.ts", include_str("tests/fixtures/mixed_repo/js/broken.d.ts"))
    ] { fs.write(case_root.join(name), fixture).unwrap() }
    mixed_write_package(case_root, "mixed_js", None)
    bind :: mixed_bind_js(case_root)
    mixed_assert_ok("JavaScript bind", bind)
    cache :: case_root.join(".jet/bindings/js/ops.jet")
    assert(cache.is_file())
    _ :: mixed_assert_common_provenance(case_root.join(".jet/bindings/js/ops.provenance"))
    mixed_run_workflow(case_root, "5\n99\n123\n", None)
    runtime :: case_root.join("ops.mjs")
    original_runtime :: fs.read_to_string(&runtime).unwrap()
    fs.write(&runtime, "{original_runtime}\n// stale binding source\n").unwrap()
    stale_source :: mixed_jet_output(case_root, ["run", "run.jet"], None)
    mixed_assert_failed_with("stale JavaScript binding source", stale_source, "E3208")
    fs.write(&runtime, original_runtime).unwrap()
    mixed_recover_stale_descriptor(case_root, cache, "5\n99\n123\n", None, || -> mixed_bind_js(case_root))
    mixed_assert_bad_bind(case_root, ["inspect", "bind", "js", "broken.d.ts", "--runtime", "ops.mjs", "--pkg", "broken"], case_root.join(".jet/bindings/js/broken.jet"))
    edited :: fs.read_to_string(&runtime).unwrap().replace("return left + right", "return left + right + 1")
    fs.write(&runtime, edited).unwrap()
    rebound :: mixed_bind_js(case_root)
    mixed_assert_ok("edited JavaScript rebind", rebound)
    edited_run :: mixed_jet_output(case_root, ["run", "run.jet"], None)
    mixed_assert_ok("edited JavaScript run", edited_run)
    assert_eq(String.from_utf8_lossy(&edited_run.stdout), "6\n99\n123\n")
}

// Rust: tests/polyglot_systems.rs:1032
pub fn mixed_python_case(root: OSPath) -> {
    case_root :: root.join("python")
