    cache :: case_root.join(".jet/bindings/py/ops.jet")
    assert(cache.is_file())
    _ :: mixed_assert_common_provenance(case_root.join(".jet/bindings/py/ops.provenance"))
    mixed_run_workflow(case_root, "5\nfalse\n99\n123\n", None)
    source :: case_root.join("ops.py")
