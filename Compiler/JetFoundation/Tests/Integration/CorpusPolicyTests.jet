// Rust: tests/corpus_policy.rs:905
#Test("generated_protocol_override_requires_a_distinct_envelope_shape") {
    policy :: CorpusPolicy.load().unwrap()
    raw_json :: policy.evaluate_generated("producer:crates/jet-pkg-model/src/LuaBind.rs#render_jet", "fn decode_response(raw: String, code: Int) -> DataTree Err! {{ return Ok(json.parse(raw)) }}").unwrap()
    assert(raw_json.is_empty(), "raw JSON override is distinct: {raw_json:Debug}")
    ordinary :: policy.evaluate_generated("producer:crates/jet-pkg-model/src/LuaBind.rs#render_jet", "fn decode_response(raw: String, code: Int) -> DataTree Err! {{\n    response :: json.parse(raw)\n    ok :: response.field(\"ok\")\n    return Ok(response)\n}}").unwrap()
    assert(ordinary.iter().any((violation) -> violation.rule == "generated-protocol-override"))
}
