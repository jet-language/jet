// Rust: tests/corpus_policy.rs:321
#Test("card_2375_rules_reject_each_reintroduced_ceremony") {
    policy :: CorpusPolicy.load().unwrap()
    cases :: [
        ("Examples/features/basics/hello.jet", "fn run() {{ print(\"hello\") }}", "entry-implicit"),
        ("Docs/spec/guides/first-hour.md", "jet build Examples/features/basics/first_hour.jet", "first-hour-doc-recipe"),
        ("Examples/features/types/typed_literal_forms.jet", "fn run() {{ print(\"jet build Examples/features/types/typed_literal_forms.jet\") }}", "first-hour-doc-recipe"),
        ("Examples/features/serde/reintroduced.jet", "#Codable\nstruct Sample {{\n    value: Int\n}}\nfn run() {{}}", "codable-structural"),
        ("Examples/features/memory/reintroduced.jet", "fn run() {{\n    delay :: Duration.hours(2) ?? return Err(\"duration\")\n}}", "duration-constant-safe"),
        ("Examples/features/basics/reintroduced_effect.jet", "use core.files as fs\nfn run() -[FS, IO]> {{\n    path :: \"input.txt\"\n    text :: fs.read(path)\n    print(text)\n}}", "effect-row-inference"),
        ("Examples/features/concurrency/parallel_scan.jet", "use core.files as fs\nfn run() {{\n    path :: \"input.txt\"\n    text :: fs.read(~path)\n}}", "readonly-copy"),
        ("Examples/features/io/reintroduced.jet", "use core.files as fs\nfn run() {{\n    path :: \"input.txt\"\n    text :: fs.read(path) ?? return Err(\"read\")\n}}", "error-identity"),
        ("Examples/features/concurrency/reintroduced.jet", "fn run() {{\n    task.group g {{\n        task.race {{1, 2}}\n    }}\n}}", "task-one-child"),
        ("Examples/features/concurrency/reintroduced.jet", "fn run() {{\n    task.group g {{\n        task.any {{1, 2}}\n    }}\n}}", "task-one-child"),
        ("tests/agent_workloads/adapters/reintroduced.jet", "fn run() {{\n    line_number := 0\n    loop item in items {{\n        line_number += 1\n        seen :: line_number\n    }}\n}}", "indexed-sequence"),
        ("Tools/gauntlet/entries/bulkrename/jet/run.jet", "fn run() {{\n    value :: Regex{{\"IMG\"}}\n}}", "regex-capture-recipe")
    ]
    for (path, source, rule) in cases {
        violations :: policy.evaluate_source(path, source).unwrap()
        violation :: violations.iter().find((violation) -> violation.rule == rule).unwrap_or_else(() -> panic("{path} did not reject {rule}: {violations:Debug}"))
        rendered :: violation.to_string()
        assert(rendered.contains("file={path}"), "{rendered}")
        assert(rendered.contains("rule={rule}"), "{rendered}")
        assert(rendered.contains("site="), "{rendered}")
        assert(rendered.contains("why="), "{rendered}")
        assert(rendered.contains("replacement="), "{rendered}")
    }
}
// Rust: tests/corpus_policy.rs:437
#Test("generated_protocol_check_requires_one_decoder_for_response_protocols") {
    policy :: CorpusPolicy.load().unwrap()
    violations :: policy.evaluate_generated("producer:crates/jet-pkg-model/src/LuaBind.rs#render_jet", "fn run() {{}}").unwrap()
    assert_eq(violations.len(), 1)
    assert_eq(violations[0].rule, "bindgen-one-decoder")
    assert(violations[0].to_string().contains("replacement="))
    no_response :: policy.evaluate_generated("producer:crates/jet-pkg-model/src/CBind.rs#render_jet", "fn run() {{}}").unwrap()
    assert(no_response.is_empty())
}
// Rust: tests/corpus_policy.rs:459
#Test("every_response_binding_renderer_uses_the_shared_decoder_policy") {
    policy :: CorpusPolicy.load().unwrap()
    response_producers :: policy.manifest().producers.iter().filter((producer) -> producer.selector.contains("Bind.rs#render_jet") && producer.protocol != "no-response-protocol").collect()
    assert_eq(response_producers.len(), 7)
    source :: "fn decode_response(raw: String, code: Int) -> DataTree Err! {{ return Ok(DataTree.Null) }}"
    for producer in response_producers {
        violations :: policy.evaluate_generated(&producer.selector, source).unwrap_or_else((error) -> panic("{producer.selector}: {error}"))
        assert(violations.is_empty(), "{producer.selector} did not accept one shared response decoder: {violations:Debug}")
    }
}
// Rust: tests/corpus_policy.rs:486
#Test("walk_policy_distinguishes_file_only_filters_from_directory_tree_walks") {
    policy :: CorpusPolicy.load().unwrap()
    file_only :: policy.evaluate_source("dogfood/jetpack/tests/transcript.jet", "use core.files as fs\nfn run() {{\n    entries :: fs.walk(root)\n    loop entry in entries {{\n        if !entry.is_dir -> print(entry.path)\n    }}\n}}").unwrap()
    assert(file_only.iter().any((violation) -> violation.rule == "walk-files-filter"))
    unrelated_walk_and_filter :: policy.evaluate_source("dogfood/jetpack/tests/transcript.jet", "use core.files as fs\nfn walk() {{\n    entries :: fs.walk(root)\n}}\nfn filter(entry: Entry) {{\n    if !entry.is_dir -> print(entry.path)\n}}").unwrap()
    assert(!unrelated_walk_and_filter.iter().any((violation) -> violation.rule == "walk-files-filter"))
    tree :: policy.evaluate_source("dogfood/jetpack/tests/transcript.jet", "use core.files as fs\nfn run() {{\n    entries :: fs.walk(root)\n    loop entry in entries {{\n        if entry.is_dir -> print(entry.relative) else -> print(entry.path)\n    }}\n}}").unwrap()
    assert(!tree.iter().any((violation) -> violation.rule == "walk-files-filter"))
}
// Rust: tests/corpus_policy.rs:538
#Test("semantic_migration_rules_match_only_their_structural_shapes") {
    policy :: CorpusPolicy.load().unwrap()
    duration :: policy.evaluate_source("Examples/features/memory/reintroduced.jet", "fn run() {{ delay :: Duration.seconds(1.5) }}").unwrap()
    assert(duration.iter().any((violation) -> violation.rule == "duration-constant-safe"))
    runtime_duration :: policy.evaluate_source("Examples/features/memory/reintroduced.jet", "fn run(seconds: Float) {{ delay :: Duration.seconds(seconds) }}").unwrap()
    assert(!runtime_duration.iter().any((violation) -> violation.rule == "duration-constant-safe"))
    unit :: policy.evaluate_source("Examples/features/text/reintroduced.jet", "fn run() {{ value :: Meter.from_float(source.raw() * 2) }}").unwrap()
    assert(unit.iter().any((violation) -> violation.rule == "unit-scalar-rewrap"))
    converted_unit :: policy.evaluate_source("Examples/features/types/unit_family.jet", "fn subtotal(price: Usd, qty: Int) -> Usd {{ Usd.from_float(price.raw() * Float.from_int(qty)) }}").unwrap()
    assert(converted_unit.iter().any((violation) -> violation.rule == "unit-scalar-rewrap"))
    helper_unit :: policy.evaluate_source("Examples/features/text/reintroduced.jet", "fn run() {{ value :: Meter.from_float(source.raw() * calibrate(2.0)) }}").unwrap()
    assert(!helper_unit.iter().any((violation) -> violation.rule == "unit-scalar-rewrap"))
    format :: policy.evaluate_source("Tools/gauntlet/entries/bulkrename/jet/run.jet", "fn run() {{ print(\"{{value:Fixed(2)}}\".replace(\",\", \"\")) }}").unwrap()
    assert(format.iter().any((violation) -> violation.rule == "plain-format-fact"))
    grouped :: policy.evaluate_source("Tools/gauntlet/entries/bulkrename/jet/run.jet", "fn run() {{ print(\"{{value:Grouped(2)}}\".replace(\",\", \"\")) }}").unwrap()
    assert(!grouped.iter().any((violation) -> violation.rule == "plain-format-fact"))
    directory :: policy.evaluate_source("Docs/site/generate.jet", "fn run() {{ files.create_dir(\"dist\") }}").unwrap()
    assert(directory.iter().any((violation) -> violation.rule == "dogfood-directory-setup"))
    idempotent :: policy.evaluate_source("Docs/site/generate.jet", "fn run() {{ files.create_dir_all(\"dist\") }}").unwrap()
    assert(!idempotent.iter().any((violation) -> violation.rule == "dogfood-directory-setup"))
    generic_policy :: policy.evaluate_source("dogfood/tower/run.jet", "fn duplicate_equal(left: DataTree, right: DataTree) -> Bool {{ return true }}").unwrap()
    assert(generic_policy.iter().any((violation) -> violation.rule == "datatree-domain-policy"))
    named_policy :: policy.evaluate_source("dogfood/tower/run.jet", "fn javascript_truthy(value: DataTree) -> Bool {{ return true }}").unwrap()
    assert(!named_policy.iter().any((violation) -> violation.rule == "datatree-domain-policy"))
    lower_ladder := "\"text\""
    for (from, to) in ('A'..='Z').zip('a'..='z') { lower_ladder.push_str(".replace(\"{from}\", \"{to}\")") }
    ladder :: policy.evaluate_source("dogfood/jetpack/src/store/path_laws.jet", "fn run() {{ value :: {lower_ladder} }}").unwrap()
    assert(ladder.iter().any((violation) -> violation.rule == "dogfood-ascii"))
    partial :: policy.evaluate_source("dogfood/jetpack/src/store/path_laws.jet", "fn run() {{ value :: \"text\".replace(\"A\", \"a\").replace(\"B\", \"b\") }}").unwrap()
    assert(!partial.iter().any((violation) -> violation.rule == "dogfood-ascii"))
    unrelated_regex_recipe :: policy.evaluate_source("Tools/gauntlet/entries/bulkrename/jet/run.jet", "fn pattern() {{ value :: Regex{{\"^x$\"}} }}\nfn run(value: String) {{\n    matched :: re.match(Regex{{\"x\"}}, value)\n    print(matched.group(1) ?? \"\")\n}}").unwrap()
    assert(unrelated_regex_recipe.iter().any((violation) -> violation.rule == "regex-capture-recipe"))
    docs_without_runner :: policy.evaluate_source("Docs/spec/guides/first-hour.md", "```jet\n#CLI\nstruct Args {{ name: String }}\n```\n```bash\njet build\n```").unwrap()
    assert(docs_without_runner.iter().any((violation) -> violation.rule == "first-hour-doc-recipe"))
}
// Rust: tests/corpus_policy.rs:694
#Test("crypto_digest_rule_uses_the_resolved_core_module") {
    policy :: CorpusPolicy.load().unwrap()
    legacy :: policy.evaluate_source("Examples/features/crypto/reintroduced.jet", "use core.crypto as crypto\nfn run() {{ crypto.sha256_bytes(\"abc\".bytes()) }}").unwrap()
    assert(legacy.iter().any((violation) -> violation.rule == "crypto-naming-fact"))
    canonical :: policy.evaluate_source("Examples/features/crypto/reintroduced.jet", "use core.crypto as crypto\nfn run() {{ crypto.sha256(\"abc\".bytes()).hex() }}").unwrap()
    assert(!canonical.iter().any((violation) -> violation.rule == "crypto-naming-fact"))
    unrelated :: policy.evaluate_source("Examples/features/crypto/reintroduced.jet", "fn run() {{ sha256_bytes(\"abc\".bytes()) }}").unwrap()
    assert(!unrelated.iter().any((violation) -> violation.rule == "crypto-naming-fact"))
}
