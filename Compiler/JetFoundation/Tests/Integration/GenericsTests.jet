#Test("generic_modules_canonical_spelling_keeps_comptime_bindings") {
    source :: """
BASE :: prep { 40 }

module cache<K>(capacity: Int) {
    COMPUTED_SIZE :: prep { BASE + capacity }
    pub struct Entry { items: [K#capacity] }
    pub fn size() -> Int { COMPUTED_SIZE }
}

module x :: cache<Int>(64)

module plain_template<K> {
    pub fn identity(value: K) -> K { value }
}
module plain :: plain_template<Int>

fn run() {
    print(x.size())
    print(plain.identity(7))
}
"""
    jet.compile(source).unwrap_or_else((diags) -> panic("canonical generic-module spelling failed: {diags:#?}"))
}
// Rust: tests/generics.rs:273
#Test("generic_module_diagnostics_hide_instance_mangling") {
    diagnostics :: jet.compile("""
module box<T> {
    pub struct Entry { value: T }
}
module boxed :: box<Int>
fn wrong(value: boxed.Entry) -> String { return value }
fn run() {}
""").expect_err("the return type mismatch must be diagnosed")
    text :: diagnostics.iter().flat_map((diagnostic) -> [diagnostic.what, diagnostic.why, diagnostic.fix]).collect().join("\n")
    assert(!text.contains("M5BoxedEntry"), "compiler-owned generic-module names leaked into a diagnostic: {text}")
}

// Rust: tests/generics.rs:303
#Test("generic_modules_complete_instantiation") {
    // FEATURE_CLAIM: claim.generic-modules / complete-instantiation
    complete :: fs.read_to_string(OSPath.from(env.manifest_dir()).join("Examples/features/modules/generic_modules.jet")).expect("generic module example")
    jet.compile(complete).unwrap_or_else((diags) -> panic("closed generic-module surface failed: {diags:#?}"))
    nested :: """
module outer<T>(count: Int) {
    module inner<U>(extra: Int) {
        pub fn total(first: T, second: U) -> Int { return count + extra }
    }
    module closed :: inner<T>(count)
}
module instance :: outer<String>(3)
fn run() {}
"""
    jet.compile(nested).unwrap_or_else((diags) -> panic("nested generic-module instantiation failed: {diags:#?}"))
    body_items :: """
module complete<T>(count: Int, label: String) {
    #Meta(category: label)
    VALUE :: prep { count }
    COMPTIME_VALUE :: prep { count + 1 }
    tag Marked { deny: [Net] }
    trait Reveal { fn reveal(self) -> T }
    struct Wrapped { value: T }
    enum Maybe { Empty Value(T) }
    impl Wrapped.Reveal { fn reveal(self) -> T { return self.value } }
    enum SourceErr { Bad(T) }
    enum TargetErr { Wrapped(SourceErr) }
    impl SourceErr -> TargetErr { return TargetErr.Wrapped(self) }
    #Target(OS.Linux)
    impl Wrapped { fn linux_value(self) -> T { return self.value } }
    module plain { pub fn value() -> Int { return count } }
    module nested<U> { pub fn keep(value: U) -> U { return ~value } }
    module nested_use :: nested<T>
    #Meta(category: label)
    pub fn marked(value: ^#Marked T) -> #Marked T {
        #Meta(category: label)
        local := T{ value }
        return local
    }
    #Test fn identity(value: T) { expect(count == count) }
    #Test("complete") { .measure { assert(label == label) } }
}
module complete_use :: complete<Int>(3, "generic module")
fn run() {}
"""
    jet.compile(body_items).unwrap_or_else((diags) -> panic("generic-module body substitution failed: {diags:#?}"))
    distinct_generated_names :: """
module with_bar_baz<T> { pub struct BarBaz { value: T } }
module with_baz<T> { pub struct Baz { value: T } }
module foo :: with_bar_baz<Int>
module foo_bar :: with_baz<Int>
fn run() {
    first :: foo.BarBaz{ value: 1 }
    second :: foo_bar.Baz{ value: 2 }
    print(first.value + second.value)
}
"""
    jet.compile(distinct_generated_names).unwrap_or_else((diags) -> panic("generic-module type names collided: {diags:#?}"))
    root :: env.temp_dir().join("jet_generic_modules_complete_{process.id()}")
    _ :: fs.remove_dir_all(root)
    fs.create_dir_all(root).expect("create generic-module acceptance directory")
    fs.write(root.join("package.jet"), "name: \"generic_modules_complete\"\nversion: \"0.1.0\"\n").expect("write generic-module package")
    fs.write(root.join("left.jet"), "pub module boxed<T>(n: Int) { pub fn value() -> Int { return n } }\n").expect("write left template")
    fs.write(root.join("right.jet"), "pub module boxed<T>(n: Int) { pub fn value() -> Int { return n } }\n").expect("write right template")
    main :: root.join("main.jet")
    fs.write(main, """
module left
module right
use left.[boxed as left_boxed]
use right.[boxed as right_boxed]
module first :: left_boxed<Int>(3)
module equivalent :: left_boxed<Int>(3)
module different_type :: left_boxed<String>(3)
module different_value :: left_boxed<Int>(4)
module different_path :: right_boxed<Int>(3)
fn run() {}
""").expect("write generic-module identity program")
    index :: semindex.open(main).expect("generic-module identity program checks")
    assert_eq(index.instances().len(), 4, "only complete full keys may reuse an instance")
    shared :: index.instances().iter().find((instance) -> instance.applications.iter().any((application) -> application.name == "first")).expect("canonical first instance")
    assert_eq(shared.applications.iter().map((application) -> application.name).collect(), ["first", "equivalent"])
    full_keys := [String:Bool]{}
    loop instance in index.instances() { full_keys[instance.full_key_hex] = true }
    assert_eq(full_keys.len(), 4, "type, value, and defining module path remain identity inputs")
    _ :: fs.remove_dir_all(root)
    assert_nested_generic_module_execution()
    assert_closed_value_identity()
}

// Rust: tests/generics.rs:448
#Test("generic_module_local_bindings_shadow_substitution_values") {
    source :: """
module box(capacity: Int) {
    BASE :: prep { capacity }
    pub fn shadowed() -> Int {
        base :: prep { 5 }
        return base
    }
    pub fn plain_shadowed() -> Int {
        capacity := 5
        return capacity
    }
}
module b32 :: box(32)
fn run() {
    print(b32.shadowed())
    print(b32.plain_shadowed())
}
"""
    root :: env.temp_dir().join("jet_generic_module_shadowing_{process.id()}")
    _ :: fs.remove_dir_all(root)
    fs.create_dir_all(root).expect("create generic-module shadowing directory")
    fs.write(root.join("package.jet"), "name: \"generic_module_shadowing\"\nversion: \"0.1.0\"\nauthority: { holds: { allow: [IO] } }\n").expect("write generic-module shadowing package")
    path :: root.join("main.jet")
    fs.write(path, source).expect("write generic-module shadowing program")
    loop release in [false, true] {
        command := Command.new(common.jet_bin())
        command.arg("run")
        if release { command.arg("--release") }
        output :: command.arg(path).output().unwrap_or_else((error) -> panic("run generic-module shadowing program: {error}"))
        assert(output.status.success(), "generic-module shadowing failed (release={release}):\n{String.from_utf8_lossy(output.stderr)}")
        assert_eq(String.from_utf8_lossy(output.stdout), "5\n5\n", "generic-module local bindings must shadow substitutions (release={release})")
    }
    _ :: fs.remove_dir_all(root)
}

