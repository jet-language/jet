// Rust: tests/generics.rs:8
#Test("generic_module_profile_fact_values_are_closed_and_fingerprinted") {
    root :: env.temp_dir().join("jet_generic_module_profile_fact_{process.id()}")
    _ :: fs.remove_dir_all(root)
    fs.create_dir_all(root).expect("create profile fact fixture")
    fs.write(root.join("package.jet"), """
name: "profile_fact"
version: "0.1.0"
settings: { cache_slots: Int = 3 }
build: {
    compact: Build{ optimize: full, settings: { cache_slots: 2 } },
    spacious: Build{ optimize: full, settings: { cache_slots: 5 } },
}
""").expect("write profile fact manifest")
    source :: """
module cache<K>(capacity: Int) {
    pub struct Buffer { items: [K#capacity] }
    pub fn slots() -> Int { capacity }
}
PROFILE_SLOTS :: prep { $build.settings.cache_slots }
module tuned :: cache<Int>($build.settings.cache_slots)
module chained :: cache<Int>(PROFILE_SLOTS)
fn run() { print(tuned.slots()) }
"""
    entry :: root.join("main.jet")
    fs.write(entry, source).expect("write profile fact source")
    fingerprints := [String]{}
    loop profile in ["compact", "spacious"] {
        bundle := Loader.load_entry_with_overlay(entry.to_str().expect("profile fact path"), nil, false).expect("load profile fact source")
        Driver.seed_build_facts(&bundle, profile, false, [String:String]{}).expect("seed profile settings")
        diagnostics :: Sema.check_bundle(&bundle, Sema.CompileMode.Check)
        assert(diagnostics.iter().all((diagnostic) -> diagnostic.severity != Severity.Error), "profile fact module should check: {diagnostics:#?}")
        identity :: bundle.modules.iter().flat_map((module) -> module.items.iter()).find_map((item) -> {
            if item == {
                .CodeModule(module) -> if module.name == "tuned" { module.instance_identity } else { nil }
                _ -> nil
            }
        }).expect("fact-fed module instance identity")
        assert_eq(identity.argument_values[1], "value:{if profile == "compact" { 2 } else { 5 }}")
        assert(identity.argument_provenance[1].iter().any((source) -> source.contains("settings.cache_slots")))
        assert(identity.argument_provenance[1].iter().any((source) -> source.contains("build.{profile}")))
        assert(identity.applications.iter().any((application) -> application.name == "chained"), "a setting folded through the definition evaluator must reuse the direct fact specialization")
        fingerprints.push(identity.fingerprint.clone())
    }
    assert_ne(fingerprints[0], fingerprints[1], "profile values must not collide")
    _ :: fs.remove_dir_all(root)
}

// Rust: tests/generics.rs:100
#Test("generic_module_fact_value_example_has_profile_and_tier_parity") {
    repo :: OSPath.from(env.manifest_dir())
    fixture :: repo.join("Examples/features/modules")
    root :: env.temp_dir().join("jet_generic_module_fact_parity_{process.id()}")
    _ :: fs.remove_dir_all(root)
    fs.create_dir_all(root).expect("create isolated fact-value example")
    entry :: root.join("fact_value_arguments.jet")
    fs.copy(fixture.join("fact_value_arguments.jet"), entry).expect("copy fact-value module")
    expected :: fs.read(repo.join("Examples/features/expected/modules/fact_value_arguments.out")).expect("fact-value module golden")
    loop (profile, setting, expected_output) in [("compact", "2", b"2\n"), ("spacious", "5", b"5\n")] {
        profile_arg :: "--profile={profile}"
        setting_arg :: "cache_slots={setting}"
        // GATE #4494: real child runs and profile facts.
        profile_run :: Command.new(common.jet_bin()).current_dir(root).arg("run").arg(profile_arg).arg(entry).env("NO_COLOR", "1").output().expect("run fact-value module under named profile")
        assert_eq(profile_run.status.code(), 0, "named profile `{profile}` failed:\n{String.from_utf8_lossy(profile_run.stderr)}")
        assert_eq(profile_run.stdout, expected_output, "named profile `{profile}` size drifted")
        // Retired forced-interpreter representation becomes an O0 behavioral witness;
        // the named profile still supplies the same folded build facts.
        // GATE #4494: retained profile-aware tier provider, native argv/root/env contract.
        profile_dev :: common.run_entry_tier_with_profile(entry, "O0", profile, root, [("NO_COLOR", "1")])
        release :: Command.new(common.jet_bin()).current_dir(root).args(["run", "--release", "--set"]).arg(setting_arg).arg(entry).env("NO_COLOR", "1").output().expect("run fact-value module through release AOT")
        default :: Command.new(common.jet_bin()).current_dir(root).args(["run", "--set"]).arg(setting_arg).arg(entry).env("NO_COLOR", "1").output().expect("run fact-value module through default native tier")
        loop (tier, child_output) in [("jet run --release", release), ("jet run", default)] {
            assert_eq(child_output.status.code(), 0, "{tier} failed for `{profile}`: {String.from_utf8_lossy(child_output.stderr)}")
            assert_eq(child_output.stdout, expected_output, "{tier} output drifted for `{profile}`")
        }
        if profile_dev == {
            .Ran(exit_code, stdout, stderr) -> {
                assert_eq(exit_code, 0, "O0 failed for `{profile}`: {stderr}")
                assert_eq(stdout.as_bytes(), expected_output, "O0 output drifted for `{profile}`")
            }
            else -> panic("O0 did not execute fact-value module under `{profile}`")
        }
    }
    explain :: Command.new(common.jet_bin()).current_dir(root).args(["explain", "tuned.slots"]).arg(entry).arg("--profile=compact").env("NO_COLOR", "1").output().expect("explain fact-fed module value")
    assert(explain.status.success(), "module explain failed: {String.from_utf8_lossy(explain.stderr)}")
    explanation :: String.from_utf8_lossy(explain.stdout)
    assert(explanation.contains("value:2"), "explain must show the folded value: {explanation}")
    assert(explanation.contains("build.compact.settings.cache_slots"), "explain must show profile provenance: {explanation}")
    shown :: entry.to_str().expect("fact-value module path")
    // Default, release, O0 run and O0 dev replace the four original execution lenses.
    loop args in [["run", "--release", shown], ["run", shown], ["run", "--profile=debug", shown], ["dev", shown, "--profile=debug", "--watch=off"]] {
        run :: Command.new(common.jet_bin()).current_dir(root).args(args).env("NO_COLOR", "1").output().expect("run fact-value module through execution tier")
        assert_eq(run.status.code(), 0, "execution tier failed: {String.from_utf8_lossy(run.stderr)}")
        assert_eq(run.stdout, expected, "execution tier output drifted")
    }
    _ :: fs.remove_dir_all(root)
}

