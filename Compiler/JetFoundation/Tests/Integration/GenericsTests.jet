// Rust: tests/generics.rs:893
#Test("generic_call_diagnostics_cover_arity_and_bound_failures") {
    wrong_arity :: """
fn identity<T>(value: ^T) -> T { return value }
fn run() { value :: identity<Int, String>(1) }
"""
    arity_diags :: jet.compile(wrong_arity).expect_err("wrong generic arity must fail")
    arity :: arity_diags.iter().find((diagnostic) -> diagnostic.code == "E0119").unwrap_or_else(() -> panic("expected generic arity E0119: {arity_diags:#?}"))
    assert(!arity.what.is_empty() && !arity.why.is_empty() && !arity.fix.is_empty())
    wrong_bound :: """
#!Comparable
struct NotComparable { value: Int }
fn choose<T: Comparable>(value: ^T) -> T { return value }
fn run() {
    value :: choose<NotComparable>(NotComparable{ value: 1 })
}
"""
    bound_diags :: jet.compile(wrong_bound).expect_err("failed generic bound must fail")
    bound :: bound_diags.iter().find((diagnostic) -> diagnostic.code == "E0905").unwrap_or_else(() -> panic("expected generic bound E0905: {bound_diags:#?}"))
    assert(!bound.what.is_empty() && !bound.why.is_empty() && !bound.fix.is_empty())
    non_generic :: """
fn plain(value: Int) -> Int { return value }
fn run() { value :: plain<Int>(1) }
"""
    non_generic_diags :: jet.compile(non_generic).expect_err("non-generic functions must reject explicit call type arguments")
    assert(non_generic_diags.iter().any((diagnostic) -> diagnostic.code == "E0119"), "expected non-generic call E0119: {non_generic_diags:#?}")
    spaced :: """
fn identity<T>(value: ^T) -> T { return value }
fn run() { value :: identity < Int > (1) }
"""
    assert(jet.compile(spaced).is_err(), "spaced angle brackets must not become an explicit generic call")
    extra_decode_type :: """
use core.encoding.json as json
fn run() { value :: json.decode<Int, String>("1") }
"""
    decode_diags :: jet.compile(extra_decode_type).expect_err("typed decode must reject extra call type arguments")
    assert(decode_diags.iter().any((diagnostic) -> diagnostic.code == "E0119"), "expected typed decode E0119: {decode_diags:#?}")
}

// Rust: tests/generics.rs:957
#Test("free_generic_calls_execute_in_the_resident_jit") {
    source :: """
fn identity<T>(value: ^T) -> T { return value }
fn empty<T>() -> [T] { return [] }
fn run() {
    text :: identity<String>("ok")
    values :: empty<Int>()
    print(text)
    print(values.len())
}
"""
    root :: env.temp_dir().join("jet_generic_free_calls_{process.id()}")
    _ :: fs.remove_dir_all(root)
    fs.create_dir_all(root).expect("create generic-free test directory")
    fs.write(root.join("package.jet"), "name: \"generic_free_calls\"\nversion: \"0.1.0\"\nauthority: { holds: { allow: [IO] } }\n").expect("write generic-free test package")
    path :: root.join("main.jet")
    fs.write(path, source).expect("write generic-free test source")
    bundle := Loader.load_entry(path.to_str().unwrap()).expect("generic-free test source should load")
    diagnostics :: Sema.check_bundle(&bundle, Sema.CompileMode.Run)
    assert(diagnostics.iter().all((diagnostic) -> diagnostic.severity != Severity.Error), "generic-free test source should type-check: {diagnostics:?}")
    // Resident JIT compile/trace representation is retired: execute every retained tier.
    // GATE #4494: actual canonical tier execution, not a Rust backend callback.
    loop tier in ["O0", "O1", "O2", "Web"] {
        if common.run_entry_tier(path, tier, false) == {
            .Ran(exit_code, stdout, stderr) -> {
                assert_eq(exit_code, 0, "generic free call {tier} run failed: {stderr}")
                assert_eq(stderr, "")
                assert_eq(stdout, "ok\n0\n")
            }
            other -> panic("generic free call {tier} run did not complete: {other:?}")
        }
    }
    _ :: fs.remove_dir_all(root)
}
