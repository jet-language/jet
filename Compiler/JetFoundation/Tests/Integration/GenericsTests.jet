    source :: """
struct Box<T> {
    value: T
}

impl Box {
    fn new(value: ^T) -> Box<T> {
        return Box<T>{ value: value }
    }

    fn convert<U>(self, value: ^U, *, note: String{"unused"}) -> U {
        return value
    }

    fn make<U>(value: ^U) -> U {
        return value
        }
    }

fn run() {
    box :: Box<Int>.new(3)
    value :: box.convert<String>(note: "explicit", value: "ok")
    inferred :: box.convert(note: "inferred", value: "again")
    static_value :: Box.make<String>("static")
    static_inferred :: Box.make("inferred")
    print(value)
    print(inferred)
    print(static_value)
    print(static_inferred)
}
"""
    root :: env.temp_dir().join("jet_generic_method_calls_{process.id()}")
    _ :: fs.remove_dir_all(root)
    fs.create_dir_all(root).expect("create generic-method test directory")
    fs.write(root.join("package.jet"), "name: \"generic_method_calls\"\nversion: \"0.1.0\"\nauthority: { holds: { allow: [IO, Mem.Alloc] } }\n").expect("write generic-method test package")
    path :: root.join("main.jet")
    fs.write(path, source).expect("write generic-method test source")
    bundle := Loader.load_entry(path.to_str().unwrap()).expect("generic-method test source should load")
    diagnostics :: Sema.check_bundle(&bundle, Sema.CompileMode.Run)
    assert(diagnostics.iter().all((diagnostic) -> diagnostic.severity != Severity.Error), "generic-method test source should type-check: {diagnostics:?}")
    // Retired resident compile/trace assertions become all-tier behavioral identity.
    // GATE #4494: canonical retained O0/O1/O2/Web providers.
    loop tier in ["O0", "O1", "O2", "Web"] {
        if common.run_entry_tier(path, tier, false) == {
            .Ran(exit_code, stdout, stderr) -> {
                assert_eq(exit_code, 0, "generic method {tier} run failed: {stderr}")
                assert_eq(stderr, "")
                assert_eq(stdout, "ok\nagain\nstatic\ninferred\n")
            }
            other -> panic("generic method {tier} run did not complete: {other:?}")
        }
    }
    _ :: fs.remove_dir_all(root)
}
