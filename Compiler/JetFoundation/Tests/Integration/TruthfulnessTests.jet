#Test("vocabulary_page_has_one_definition_and_no_retired_senses") {
    repo :: root()
    vocabulary_path :: repo.join("Docs/spec/vocabulary.md")
    hostile :: [(String, String)]{("codec mode called a stream", "The codec mode is called a stream."), ("event called a stream", "The event is called a stream."), ("collecting loop called yielding", "The collecting loop is called yielding.")}
    loop (label, fixture) in hostile { assert(retired_vocabulary_senses(fixture).contains(label), "hostile fixture must be rejected: {label}") }
    docs_path :: repo.join("Docs")
    markdown := [OSPath]{}
    collect_markdown_paths(&docs_path, &markdown)
    canonical_vocabulary :: fs.canonicalize(vocabulary_path).expect("vocabulary path canonical")
    docs_root :: fs.canonicalize(docs_path).expect("docs path canonical")
    targets := HashSet<OSPath>.new()
    loop source in markdown {
        text :: fs.read_to_string(&source).ok() ?? next
        loop target in markdown_link_targets(&text) {
            stripped := target.trim_matches('<').trim_matches('>') // #4303
            path_text := stripped.split(['#', '?']).next().unwrap_or_default() // #4303
            if path_text.is_empty() || path_text.starts_with("/") || path_text.contains("://") { next }
            candidate_path :: source.parent().unwrap_or(OSPath.from(".")).join(path_text)
            candidate :: fs.canonicalize(candidate_path).ok() ?? next
            if !candidate.starts_with(&docs_root) || candidate.extension().and_then((ext) -> ext.to_str()) != Val("md") { next }
            _ :: targets.insert(^candidate)
        }
    }
    violations := [String]{}
    loop target in targets {
        text :: fs.read_to_string(&target).ok() ?? next
        if target != canonical_vocabulary {
            retired :: retired_vocabulary_senses(&text)
            if !retired.is_empty() { violations.push("{target.strip_prefix(&repo).unwrap_or(&target).display()}: retired senses: {retired.join(", ")}") }
        }
        if target != canonical_vocabulary && ["stream", "reader", "event", "collecting loop"].into_iter().any((word) -> contains_word(&text, word)) && !text.contains("vocabulary.md") { violations.push("{target.strip_prefix(&repo).unwrap_or(&target).display()}: uses Jet vocabulary without linking Docs/spec/vocabulary.md") }
    }
    assert(violations.is_empty(), "linked Markdown targets must use the vocabulary page and current senses:\n{violations.join("\n")}")
}
// Rust: tests/truthfulness.rs:1771
#Test("accessibility_audit_findings_have_live_cards") {
    repo :: root()
    text :: fs.read_to_string(repo.join("Docs/audits/cli-diagnostics-accessibility.md")).expect("CLI accessibility audit is readable")
    lines :: text.lines().collect::<[String]>()
    expected_header :: ["id", "surface", "screen_reader", "state", "card"]
    header :: lines.iter().position((line) -> markdown_table_cells(line).iter().eq(expected_header)).expect("accessibility audit must have the machine-readable findings header")
    separator :: lines.get(header + 1).expect("accessibility findings table needs a separator row")
    separator_cells :: markdown_table_cells(separator)
    assert_eq(separator_cells.len(), expected_header.len(), "accessibility findings table separator must match its five columns")
    assert(separator_cells.iter().all((cell) -> cell == "---"), "accessibility findings table needs a Markdown separator for every column")
    rows := [[String]]{}
    finding_ids := HashSet<String>.new()
    loop line in lines.iter().skip(header + 2) {
        if !line.trim_start().starts_with('|') { break }
        cells :: markdown_table_cells(line)
        assert_eq(cells.len(), expected_header.len(), "accessibility findings row must have id, surface, screen_reader, state, and card: {line}")
        loop (name, cell) in expected_header.iter().zip(&cells) { assert(!cell.is_empty(), "accessibility finding {name} must not be empty: {line}") }
        assert(finding_ids.insert(cells[0].clone()), "accessibility finding IDs must be unique: {cells[0]}")
        assert(cells[3] == "pass" || cells[3] == "gap" || cells[3] == "not-proven", "accessibility finding {cells[0]} has an unknown state: {cells[3]}")
        rows.push(^cells)
    }
    assert(!rows.is_empty(), "accessibility audit must list at least one finding")
    loop row in rows {
        if row[3].trim().eq_ignore_ascii_case("pass") { assert_eq(row[4], "—", "passing accessibility finding {row[0]} must not name a Tower card"); next }
        cards :: audit_card_refs(&row[4])
        assert(!cards.is_empty(), "non-pass accessibility finding {row[0]} must name a live Tower card")
        unique_cards := HashSet<String>.new()
        loop card in cards {
            assert(unique_cards.insert(card), "accessibility finding {row[0]} must list each Tower card once: {card}")
            output :: Command.new("node").args(["Tools/tower/tower.mjs", "card", "show", card, "--json"]).current_dir(&repo).output().expect("Tower card lookup must run")
            assert(output.status.success(), "accessibility finding {row[0]} names missing Tower card {card}:\n{String.from_utf8_lossy(&output.stderr)}")
            json := String.from_utf8_lossy(&output.stdout) // #4303
            report :: parse_json(json.trim()).unwrap_or_else((error) -> panic("Tower lookup for {row[0]} returned invalid JSON: {error:?}\n{json}"))
            resolved_num :: json_get(&report, "num").and_then(json_int).expect("Tower card JSON must contain a numeric num")
            expected_num :: card[1..].parse::<I64>().expect("audit card reference must contain a numeric card ID")
            assert(resolved_num == expected_num, "Tower lookup for {row[0]} resolved {card} as card {resolved_num}, not {expected_num}: {json}")
        }
    }
    loop law in ["D-REPORT-LAW1=A", "D-REPORT-HOME1=A", "D-REPORT-MACHINE1=A", "D-REPORT-EDITOR1=A", "`jet.report/v2`"] { assert(text.contains(law), "accessibility audit must name the canonical report law `{law}`") }
}
