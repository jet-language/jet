#Test("cargo_and_flake_versions_match") {
    repo :: root()
    cargo :: fs.read_to_string(repo.join("Cargo.toml")).expect("Cargo.toml missing")
    flake :: fs.read_to_string(repo.join("flake.nix")).expect("flake.nix missing")
    cargo_version :: cargo.lines().find((l) -> l.starts_with("version")).and_then((l) -> l.split('"').nth(1)).expect("version not found in Cargo.toml")
    flake_version :: flake.lines().find((l) -> l.contains("version = \"") && !l.trim_start().starts_with('#')).and_then((l) -> l.split('"').nth(1)).expect("version not found in flake.nix")
    assert_eq(cargo_version, flake_version, "Cargo.toml version ({cargo_version}) and flake.nix version ({flake_version}) do not match")
}
