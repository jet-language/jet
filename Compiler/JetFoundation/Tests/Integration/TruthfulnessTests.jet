// Rust: tests/truthfulness.rs:80
#Test("rustc_availability_probes_use_common_helper") {
    repo :: root()
    forbidden :: ["Command::new(\"rustc\").arg(\"--version\")", "Command::new(\"rustc\").arg(\"-V\")"]
    violations := [String]{}
    loop needle in forbidden {
        loop finding in stray_probe_sites(&repo, needle) { violations.push("{finding}: direct `{needle}` availability probe") }
    }
    loop suite in ["tests/archive.rs", "tests/regex.rs"] {
        source :: fs.read_to_string(repo.join(suite)).unwrap()
        helper :: source.split("fn have_toolchain() -> bool {{").nth(1).and_then((tail) -> tail.split_once('}').map((pair) -> pair.0)).expect("have_toolchain helper")
        rustc_pos :: helper.find("have_rustc()").expect("rustc gate")
        cargo_pos :: helper.find("Command::new(\"cargo\")").expect("cargo probe")
        if rustc_pos > cargo_pos { violations.push("{suite}: have_rustc must run before the cargo probe so JET_REQUIRE_RUSTC=1 cannot short-circuit") }
    }
    assert(violations.is_empty(), "rustc availability must use tests/common::have_rustc so JET_REQUIRE_RUSTC cannot be bypassed:\n{violations.join("\n")}")
}
// Rust: tests/truthfulness.rs:115
#Test("rustc_probe_scanner_detects_a_seeded_stray_probe") {
    scratch :: temp_dir().join("jet_rustc_probe_guard_test_{id()}")
    seed_dir :: scratch.join("tests")
    fs.create_dir_all(&seed_dir).unwrap()
    fs.write(seed_dir.join("seeded_probe.rs"), "fn f() {{ Command::new(\"rustc\")\n.arg(\"--version\"); }}\n").unwrap()
    findings :: stray_probe_sites(&scratch, "Command::new(\"rustc\").arg(\"--version\")")
    fs.remove_dir_all(&scratch).unwrap()
    assert_eq(findings, ["tests/seeded_probe.rs"])
}
// Rust: tests/truthfulness.rs:131
#Test("llm_digest_regenerates_byte_identically") {
    repo :: root()
    output :: Command.new(env.jet_bin()).args(["inspect", "digest"]).current_dir(&repo).output().expect("jet must run the digest command")
    assert(output.status.success(), "jet inspect digest failed:\n{String.from_utf8_lossy(&output.stderr)}")
    assert(output.stderr.is_empty(), "digest wrote unexpected stderr: {String.from_utf8_lossy(&output.stderr)}")
    generated :: String.from_utf8(^output.stdout).expect("digest is UTF-8")
    loop registry_row in ["- fn", "- module", "active\tUnsafe\tmarker Unsafe", "E0001\tactive\tjet", "core.term\tReader, Writer"] { assert(generated.contains(registry_row), "digest lost registry row: {registry_row}") }
    machine :: Command.new(env.jet_bin()).args(["inspect", "digest", "--json"]).current_dir(&repo).output().expect("jet must emit the digest machine form")
    assert(machine.status.success(), "jet inspect digest --json failed:\n{String.from_utf8_lossy(&machine.stderr)}")
    machine_text := String.from_utf8(machine.stdout).expect("digest machine output is UTF-8").trim() // #4303
    report :: parse_json(machine_text).expect("digest machine output is JSON")
    assert_eq(json_get(&report, "schema").and_then(json_str), Val("jet.status/v1"))
    assert_eq(json_get(&report, "action").and_then(json_str), Val("inspect.digest"))
    assert_eq(json_get(&report, "digest").and_then((digest) -> json_get(digest, "value")).and_then(json_str), Val(generated.as_str()))
    inventory :: Command.new(env.jet_bin()).args(["inspect", "digest", "--list-topics"]).current_dir(&repo).output().expect("jet must list digest topics")
    assert(inventory.status.success(), "jet inspect digest --list-topics failed:\n{String.from_utf8_lossy(&inventory.stderr)}")
    topics :: String.from_utf8(inventory.stdout).expect("digest topic inventory is UTF-8").lines().map((topic) -> topic.to_string()).collect::<[String]>()
    assert(topics.iter().any((topic) -> topic == "core.time"))
    assert(topics.iter().any((topic) -> topic == "diagnostics"))
    composed := [U8]{}
    loop topic in &topics {
        slice :: Command.new(env.jet_bin()).args(["inspect", "digest", "--topic", topic]).current_dir(&repo).output().expect("jet must emit each digest topic")
        assert(slice.status.success(), "digest topic `{topic}` failed:\n{String.from_utf8_lossy(&slice.stderr)}")
        composed.extend_from_slice(&slice.stdout)
    }
    assert_eq(composed, generated.as_bytes(), "digest topic slices drifted")
    unknown :: Command.new(env.jet_bin()).args(["inspect", "digest", "--topic", "diagnostcs"]).current_dir(&repo).output().expect("jet must reject an unknown digest topic")
    assert(!unknown.status.success())
    assert(String.from_utf8_lossy(&unknown.stderr).contains("diagnostics"), "unknown topic did not name nearest topic:\n{String.from_utf8_lossy(&unknown.stderr)}")
}
// Rust: tests/truthfulness.rs:259
#Test("docs_referenced_examples_exist") {
    repo :: root()
    docs_dir :: repo.join("Docs")
    readme :: repo.join("README.md")
    doc_content := String.new()
    if fs.read_to_string(&readme).ok() == Val(s) { doc_content.push_str(&s) }
    entries := fs.read_dir(&docs_dir).expect("Docs/ missing").flatten().collect()
    entries.sort_by_key((e) -> e.path())
    loop entry in entries {
        path :: entry.path()
        name :: entry.file_name().to_string_lossy().into_owned()
        if path.is_dir() {
            if PM_HISTORY_DIRS.contains(name) { next }
            walk_md(&path, &(s) -> doc_content.push_str(s))
        } else if path.extension().and_then((e) -> e.to_str()) == Val("md") {
            if fs.read_to_string(&path).ok() == Val(s) { doc_content.push_str(&s) }
        }
    }
    missing := [String]{}
    loop cap in extract_example_paths(&doc_content) { if !repo.join(&cap).exists() { missing.push(^cap) } }
    assert(missing.is_empty(), "docs reference example files that do not exist:\n{missing.join("\n")}")
}
// Rust: tests/truthfulness.rs:326
#Test("readme_subcommands_exist_in_cli") {
    repo :: root()
    cli_src :: fs.read_to_string(repo.join("crates/jet-cli/src/CLI.rs")).expect("jet-cli registry missing")
    known := HashSet<String>.new()
    rest := cli_src.as_str()
    loop {
        pos :: rest.find("name: \"") ?? break
        rest = rest[pos + 7..]
        if rest.find('"') == Val(end) { _ :: known.insert(rest[..end].to_string()) }
    }
    missing := [String]{}
    loop cmd in ["run", "check", "build", "test", "fmt", "fix", "doctor", "publish", "gc"] { if !known.contains(cmd) { missing.push(cmd.to_string()) } }
    assert(missing.is_empty(), "README/docs reference jet subcommands not present in jet-cli's registry:\n{missing.join("\n")}")
}
// Rust: tests/truthfulness.rs:467
#Test("every_feature_example_has_expected_output") {
    // FEATURE_CLAIM: claim.examples-spec / expected-output-pairs
    repo :: root()
    ex_dir :: repo.join("Examples/features")
    expected_dir :: ex_dir.join("expected")
    missing := [String]{}
    web_build :: fs.read_to_string(repo.join("tests/web_build.rs")).unwrap()
    loop (path, stem) in collect_feature_golden_sources(&ex_dir) {
        source :: fs.read_to_string(&path).unwrap()
        out :: expected_dir.join("{stem}.out")
        errout :: expected_dir.join("{stem}.err.out")
        stderrout :: expected_dir.join("{stem}.stderr.out")
        webout :: expected_dir.join("{stem}.web.out")
        harnessout :: expected_dir.join("{stem}.harness.out")
        is_service :: example_serves_until_stopped(&path)
        is_web_harness :: stem == "web/web_compute_webgpu" && source.contains("#Target(JS)") && web_build.contains("include_str!(\"../Examples/features/web/web_compute_webgpu.jet\")")
        if !out.is_file() && !errout.is_file() && !stderrout.is_file() && !webout.is_file() && !harnessout.is_file() && !is_service && !is_web_harness {
            source_name :: if path.file_name().and_then((name) -> name.to_str()) == Val("run.jet") -> "Examples/features/{stem}/run.jet" else -> "Examples/features/{stem}.jet"
            missing.push("{source_name} → missing expected output or canonical harness proof")
        }
    }
    assert(missing.is_empty(), "feature examples without a matching expected output:\n{missing.join("\n")}")
}
// Rust: tests/truthfulness.rs:782
#Test("ast_capabilities_and_active_markers_have_zero_use_inventories") {
    files := [OSPath]{}
    collect_feature_jet_files(root().join("Examples/features"), &files)
    files.sort()
    clean_sources :: files.iter().map((path) -> strip_jet_comments_and_strings(&fs.read_to_string(path).expect("feature source is readable"))).collect::<[String]>()
    marker_use := [String: Bool]{}
    loop row in marker_rows() {
        rule :: row.rule ?? next
        if rule.status != RuleStatus.Active { next }
        marker_use.insert(rule.name, clean_sources.iter().any((source) -> marker_used(source, rule.name)))
    }
    marker_zero :: marker_use.iter().filter_map((pair) -> if !pair.1 -> Val(pair.0.to_string()) else -> .None).collect::<BTreeSet<String>>()
    marker_triage :: MARKER_ZERO_USE_TRIAGE.iter().map((pair) -> pair.0.to_string()).collect::<BTreeSet<String>>()
    assert_eq(marker_zero, marker_triage, "active marker zero-use inventory changed; add a card/retirement row before adding or removing a marker")
    loop (name, disposition) in MARKER_ZERO_USE_TRIAGE { assert(disposition.contains("card #") || disposition.contains("retired"), "marker #{name} has no triage disposition: {disposition}") }
    ast_zero :: AST_CAPABILITY_SURFACES.iter().filter_map((surface) -> if !clean_sources.iter().any((source) -> surface_used(source, surface.spelling)) -> Val(surface.name.to_string()) else -> .None).collect::<BTreeSet<String>>()
    ast_triage :: AST_ZERO_USE_TRIAGE.iter().map((pair) -> pair.0.to_string()).collect::<BTreeSet<String>>()
    assert_eq(ast_zero, ast_triage, "AST capability zero-use inventory changed; add a card/retirement row before adding or removing a capability")
    loop (name, disposition) in AST_ZERO_USE_TRIAGE { assert(disposition.contains("card #") || disposition.contains("retired"), "AST capability {name} has no triage disposition: {disposition}") }
}
