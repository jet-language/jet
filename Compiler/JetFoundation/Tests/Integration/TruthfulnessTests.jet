// Rust: tests/truthfulness.rs:902
#Test("cli_has_no_second_command_registry") {
    repo :: root()
    assert(!repo.join("Source/CLISpec.rs").exists(), "Source/CLISpec.rs must not exist — jet-cli owns the single CLI registry")
    registries := [String]{}
    loop path in rs_files(repo.join("Source")).into_iter().chain(rs_files(repo.join("crates/jet-cli/src"))) {
        if path.extension().and_then((x) -> x.to_str()) != Val("rs") { next }
        text :: fs.read_to_string(&path).unwrap_or_default()
        if text.contains("pub const COMMANDS: &[CommandSpec]") { registries.push(path.strip_prefix(&repo).unwrap().display().to_string()) }
    }
    assert_eq(registries, ["crates/jet-cli/src/CLI.rs"], "found a second CLI command registry:\n{registries.join("\n")}")
    main_src :: fs.read_to_string(repo.join("Source/main.rs")).expect("Source/main.rs missing")
    assert(!main_src.contains("let known ="), "Source/main.rs must not rebuild the command registry; use jet::CLI::is_builtin")
    assert(main_src.contains("jet::CLI::is_builtin(cmd)"), "Source/main.rs should dispatch unknown-command checks through jet-cli")
}
// Rust: tests/truthfulness.rs:944
#Test("compiler_seam_crates_have_only_path_dependencies") {
    // Rust: tests/truthfulness.rs:953
    EXEMPTIONS :: [(String, [String])]{
        ("<root>", ["D-DEP1"]), ("jet-jit", ["D-JITDEP1", "D-JIT2", "D-DEP1"]),
        ("jet-net", ["D-DEP1"]), ("jetpack", ["D-DEP-CRYPTO1=A", "D-CODECS1"]),
        ("jetpack-bin", ["D-DEP1", "D-DX5-HOOK1"]), ("jet-pkg-model", ["D-DEP1", "D-EMAIL-DKIM-CONFIG1"])
    }
    repo :: root()
    decisions_doc :: fs.read_to_string(repo.join("Docs/spec/syntax-decisions.md")).expect("Docs/spec/syntax-decisions.md missing")
    tower_live :: fs.read_to_string(repo.join("Tools/tower/.tower/tower.json")).expect("Tools/tower/.tower/tower.json missing")
    tower_history :: fs.read_to_string(repo.join("Tools/tower/.tower/history.json")).unwrap_or_default()
    tower :: "{tower_live}\n{tower_history}"
    loop (crate_name, ids) in EXEMPTIONS {
        loop decision in ids { assert(ratified_decision_exists(&decisions_doc, &tower, decision), "I6 exemption for `{crate_name}` cites {decision}, which is not ratified in Docs/spec/syntax-decisions.md or Tower (live+history) — revoke the exemption or get {decision} ratified") }
    }
    crate_manifests := [(String, OSPath)]{("<root>", repo.join("Cargo.toml"))}
    dirs := fs.read_dir(repo.join("crates")).expect("crates/ missing").flatten().map((e) -> e.path()).filter((p) -> p.is_dir()).collect::<[OSPath]>()
    dirs.sort()
    loop dir in dirs {
        manifest :: dir.join("Cargo.toml")
        if manifest.is_file() { crate_manifests.push((dir.file_name().unwrap().to_string_lossy().into_owned(), ^manifest)) }
    }
    loop required in ["jet-repl", "jet-debug", "jet-cli", "jet-canvas", "jet-devserver"] { assert(crate_manifests.iter().any((pair) -> pair.0 == required), "D-ARCH-SOURCE1 requires the {required} workspace seam") }
    root_lib :: fs.read_to_string(repo.join("Source/lib.rs")).expect("Source/lib.rs missing")
    assert(root_lib.contains("pub use jet_debug as Debug;") && !repo.join("Source/Debug").exists(), "D-ARCH-SOURCE1 requires jet-debug ownership, not a root Debug wrapper")
    assert(root_lib.contains("pub use jet_cli::{{CLI, Explain, Help}};") && !repo.join("Source/CLI.rs").exists() && !repo.join("Source/Explain.rs").exists() && !repo.join("Source/Help").exists(), "D-ARCH-SOURCE1 requires jet-cli ownership, not root CLI/help wrappers")
    assert(root_lib.contains("pub use jet_devserver as DevServer;") && root_lib.contains("pub use jet_devserver::Canvas;") && !repo.join("Source/Canvas.rs").exists() && !repo.join("Source/Canvas").exists(), "D-ARCH-SOURCE1 requires jet-devserver ownership of Canvas semantics, not root wrappers")
    root_main :: fs.read_to_string(repo.join("Source/main.rs")).expect("Source/main.rs missing")
    root_compile :: fs.read_to_string(repo.join("Source/CmdCompile.rs")).expect("Source/CmdCompile.rs missing")
    devserver :: fs.read_to_string(repo.join("crates/jet-devserver/src/lib.rs")).expect("jet-devserver missing")
    assert(!repo.join("Source/CmdDevWeb.rs").exists() && !root_main.contains("mod CmdDevWeb;") && root_compile.contains("pub(crate) fn run_dev_web(") && root_compile.contains("jet_devserver::WebHost::WebHost::bind") && devserver.contains("pub mod WebHost;"), "D-ARCH-SOURCE1 requires inward web-host ownership with only the R5 executor in CmdCompile")
    assert(root_lib.contains("pub use jet_canvas as CanvasUi;") && !repo.join("Source/Canvas/html.rs").exists() && !repo.join("Source/Canvas/js.rs").exists() && !repo.join("Source/Canvas/js").exists(), "Canvas browser projection assets must live in jet-canvas")
    assert(root_lib.contains("pub use jet_driver::BudgetView;") && root_lib.contains("pub use jet_driver::FixEngine;") && !repo.join("Source/BudgetView.rs").exists() && !repo.join("Source/FixEngine.rs").exists(), "Canvas shared compiler helpers must live inward in jet-driver")
    assert(root_lib.contains("pub use jet_foundation::ExitCodes;") && !repo.join("Source/ExitCodes.rs").exists() && !repo.join("Source/LSP/JSON.rs").exists(), "shared debugger/LSP policy must live in jet-foundation, not Source wrappers")
    offenders := [String]{}
    loop (name, manifest) in &crate_manifests {
        text :: fs.read_to_string(manifest).unwrap_or_else((_) -> panic("{manifest.display()} missing"))
        exemption :: EXEMPTIONS.iter().find((pair) -> pair.0 == name)
        loop (line, context, has_path) in dependency_lines_with_context(&text) {
            if has_path { next }
            if exemption == Val(pair) {
                ids :: pair.1
                if ids.iter().any((decision) -> exact_decision_token(&context, decision)) { next }
                offenders.push("{name}: {line} — external dep must cite one of {ids:?} in a comment directly above the dependency line")
            } else { offenders.push("{name}: {line} — not an exempted crate; I6 forbids external dependencies in compiler seam crates (add to EXEMPTIONS with a ratified decision ID if this is intentional)") }
        }
    }
    assert(offenders.is_empty(), "compiler seam crates must not add unexempted external dependencies (I6):\n{offenders.join("\n")}")
}
// Rust: tests/truthfulness.rs:1164
#Test("ratified_decision_lookup_requires_exact_id_and_ratified_status") {
    docs :: "## Proposed\n**D-PENDING=A**: not law. See D-LIVE and D-CITED.\n## Ratified\n**D-LIVE=A**: supersedes D-CITED.\n## Declined\n**D-NOPE=A**: declined.\n"
    assert(ratified_decision_exists(docs, "", "D-LIVE"))
    assert(!ratified_decision_exists(docs, "", "D-LIV"))
    assert(!ratified_decision_exists(docs, "", "D-CITED"))
    assert(!ratified_decision_exists(docs, "", "D-PENDING=A"))
    assert(!ratified_decision_exists(docs, "", "D-NOPE=A"))
}
// Rust: tests/truthfulness.rs:1343
#Test("dependency_scanner_covers_target_tables_and_one_dependency_per_comment") {
    manifest :: "[dependencies]\n# D-ONE=A\nfirst = \"1\"\nsecond = \"2\"\n[target.'cfg(unix)'.dependencies]\n# D-TWO=B\nthird = \"3\"\n[target.x86_64-unknown-linux-gnu.build-dependencies]\n# D-THREE=C\nfourth = \"4\"\n# D-FOUR=D\n\t[dependencies.local]\npath = \"../local\"\nversion = \"1\"\n# D-FIVE=E\n[dev-dependencies.remote]\ngit = \"https://example.test/repo\"\n[target.'cfg(unix)'.dependencies.target_remote]\nversion = \"2\"\n[package.metadata.dependencies]\nignored = \"5\"\n"
    assert_eq(dependency_lines_with_context(manifest), [(String, String, Bool)]{
        ("first = \"1\"", "# D-ONE=A\n", false), ("second = \"2\"", "", false),
        ("third = \"3\"", "# D-TWO=B\n", false), ("fourth = \"4\"", "# D-THREE=C\n", false),
        ("local: path = \"../local\", version = \"1\"", "# D-FOUR=D\n", true),
        ("remote: git = \"https://example.test/repo\"", "# D-FIVE=E\n", false), ("target_remote: version = \"2\"", "", false)
    })
}
