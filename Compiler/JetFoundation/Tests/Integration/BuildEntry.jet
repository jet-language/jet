// D-BUILDENTRY1/D-BUILDACTION1: real Jet `fn build` vertical.
use jet_foundation.Tests.Integration.Common.[Scratch]
use jet_comptime.Comptime.Build.[BuildCapability, BuildPolicy]
use jet_driver.Driver.[BuildRunOptions]
use jet_driver.Policy.[GateSet, PolicyKey]
use jet_store.[Store]
use std.fs
use std.env
use std.process
use std.sync.atomic.[AtomicU64, Ordering] // GATE #4494: native atomic counter.

// Rust: tests/build_entry.rs:19
NEXT :: AtomicU64.new(0)

// Rust: tests/build_entry.rs:21
pub fn project(name: String) -> OSPath {
    dir :: env.temp_dir().join("jet-build-entry-{name}-{process.id()}-{NEXT.fetch_add(1, Ordering.Relaxed)}")
    _ :: fs.remove_dir_all(&dir)
    fs.create_dir_all(&dir).unwrap()
    dir
}

// Rust: tests/build_entry.rs:32
pub fn opts() -> BuildRunOptions {
    BuildRunOptions{
        grants: #{BuildCapability.Exec, BuildCapability.FS},
        policy: BuildPolicy.allow_all(), execute: true,
        gates: GateSet.allow(PolicyKey.Impure), inspect_only: false,
        emit_generated: false, locked: false, no_os: false,
        web_target: false, plugin_target: false, cross_target: None,
        profile: "dev", artifact_build: false, application_authority: None,
        setting_overrides: [:], remote: None, package_scope: true,
        build_override: true, entry_fn: None
    }
}

// Rust: tests/build_entry.rs:56
pub fn ci_opts() -> BuildRunOptions {
    options := opts()
    options.policy = BuildPolicy.ci_default()
    options.grants = #{BuildCapability.Exec, BuildCapability.FS}
    options.gates = GateSet.allow(PolicyKey.Impure)
    options
}

// Rust: tests/build_entry.rs:65
pub fn inspect_opts() -> BuildRunOptions {
    options := opts()
    options.execute = false
    options
}

// Rust: tests/build_entry.rs:72
pub fn write(path: &OSPath, text: String) -> {
    fs.write(path, text).unwrap()
}

// Rust: tests/build_entry.rs:75
pub fn copy_determinism_fixture(scratch: &Scratch) -> {
    fixture :: OSPath.new(env.manifest_dir()).join("tests/fixtures/determinism")
    loop name in ["main.jet", "alpha.jet", "beta.jet"] {
        fs.copy(fixture.join(name), scratch.join(name)).unwrap()
    }
    write(&scratch.join("package.jet"), "name: \"determinism\"\nversion: \"0.1.0\"\nauthority: { holds: { allow: [IO] } }\n")
}

// Rust: tests/build_entry.rs:87
// The store log of the newest build of `program`, without timings.
pub fn normalized_build_log(workspace: &OSPath, store: &OSPath, program: String) -> [(String, String, String, String)] {
    record :: Store.new(store).unwrap().last_build_record(workspace, program).unwrap()
    match record {
        Some(record) -> record.nodes.into_iter().map(fn(node) -> (node.kind, node.key, node.subject, node.why_ran)).collect(),
        None -> []
    }
}

// Rust: tests/build_entry.rs:108
pub fn multi_dependency_fixture(name: String) -> (OSPath, OSPath) {
    root :: project(name)
    deps :: root.join("deps")
    dep_a :: deps.join("dep_a")
    dep_b :: deps.join("dep_b")
    fs.create_dir_all(&dep_a).unwrap()
    fs.create_dir_all(&dep_b).unwrap()
    write(&root.join("package.jet"), "name: \"app\"\nversion: \"0.1.0\"\ndeps: { dep_a: ./deps/dep_a, dep_b: ./deps/dep_b }\n")
    write(&dep_a.join("package.jet"), "name: \"dep_a\"\nversion: \"0.1.0\"\n")
    write(&dep_b.join("package.jet"), "name: \"dep_b\"\nversion: \"0.1.0\"\n")
    write(&dep_a.join("dep_a.jet"), "pub fn value() -> Int { return 1 }\n")
    dep_b_source :: dep_b.join("dep_b.jet")
    write(&dep_b_source, "pub fn value() -> Int { return 2 }\n")
    write(&root.join("main.jet"), """
use dep_a
use dep_b

fn build(b: BuildContext) -> BuildPlan {
    app :: b.add_executable("app", ["main.jet"], [])
    return b.plan(app)
}

fn run() -> {
    print(dep_a.value())
    print(dep_b.value())
}
""")
    (root, dep_b_source)
}

// Rust: tests/build_entry.rs:153
pub fn median_micros(samples: &[U128]) -> U128 {
    samples.sort_unstable()
    samples[samples.len() / 2]
}
