// Rust: tests/measure_symbolic_specialization.rs:36
#Test("parser_preserves_the_generic_additive_measure_rule") {
    (tokens, lexer_diagnostics) :: jet.Lexer.lex(GENERIC_JOIN_SOURCE)
    assert(lexer_diagnostics.is_empty(), "lex: {lexer_diagnostics:?}")
    program :: jet.Parser.parse(&tokens).expect("generic join must parse")
    function :: match &program.items[0] { Item.Func(function) -> function; _ -> panic("expected generic join function") }
    left_len :: match &function.params[0].ty { Type.FixedList { len, .. } -> len; _ -> panic("expected fixed left list") }
    assert(match left_len { Measure.Symbol { kind, name } -> kind == "length" && name == "N"; _ -> false })
    return_len :: match function.return_type.as_ref().unwrap() { Type.FixedList { len, .. } -> len; _ -> panic("expected fixed return list") }
    assert(match return_len { Measure.Combined { kind, rule: MeasureRule.Add, .. } -> kind == "length"; _ -> false })
}
