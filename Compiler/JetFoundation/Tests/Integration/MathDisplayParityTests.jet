// Rust: tests/measure_symbolic_specialization.rs:136
#Test("symbolic_fixed_length_resolves_at_module_specialization") {
    source :: "\nmodule buffer<T>(capacity: Int) {\n    pub struct Data {\n        items: [T#capacity]\n    }\n}\n\nmodule three :: buffer<Int>(3)\n\nfn run() {}\n"
    (tokens, lexer_diagnostics) :: jet.Lexer.lex(source)
    assert(lexer_diagnostics.is_empty(), "lex: {lexer_diagnostics:?}")
    program :: jet.Parser.parse(&tokens).expect("generic module must parse")
    template :: match &program.items[0] { Item.GenericModule(template) -> template; _ -> panic("expected generic module template") }
    data :: match &template.body[0] { Item.Struct(data) -> data; _ -> panic("expected fixed-list struct") }
    len :: match &data.fields[0].ty { Type.FixedList { len, .. } -> len; _ -> panic("expected fixed-list field") }
    assert(match len { Measure.Symbol { kind, name } -> kind == "length" && name == "capacity"; _ -> false })
    assert_eq(len.symbol_name(), Some("capacity"))
    assert_ne(len.literal_value(), Some(0))
    compiled :: jet.compile(source).expect("specialized fixed length must compile")
    assert(compiled.rust.contains("[i64; 3]"))
}
// Rust: tests/measure_symbolic_specialization.rs:173
#Test("computed_fixed_length_is_rejected_at_the_measure_boundary") {
    source :: "struct Bad { values: [Int#missing] }\nfn run() {}\n"
    diagnostics :: jet.compile(source).expect_err("unknown measure must be rejected")
    assert(diagnostics.iter().any(fn(diagnostic) -> diagnostic.code == "E0963" && diagnostic.what.contains("fixed-size list length") && diagnostic.why.contains("declared constant or module value parameter")))
}
