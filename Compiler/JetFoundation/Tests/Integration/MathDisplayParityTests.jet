// Rust: tests/measurement_tiers.rs:144
#Test("measurement_web_js_and_wasm_use_the_same_kernel") {
    output :: jet.compile_web_with_path(&web_source(), "tests/fixtures/measurement_tiers_web.jet").unwrap_or_else(fn(diagnostics) -> panic("web measurement rejected: {diagnostics:#?}"))
    web :: output.web.expect("web target must produce artifacts")
    assert(web.js_app.contains("jet_measurement_kernel_add"))
    assert(web.js_app.contains("jet_measurement_show"))
    assert(web.wasm_rust.contains("jet_measurement_kernel_add"))
    assert(web.wasm_rust.contains("JetMeasurement"))
    if !have_tool("rustc") || !have_tool("node") || !have_wasm_target() { eprintln("note: skipping measured-value web execution (need rustc, wasm32 target, and node)"); return }
    scratch :: common.Scratch.new("measurement-web")
    fs.write(scratch.join("app.js"), &web.js_app).unwrap()
    fs.write(scratch.join("jet_dom_runtime.js"), &web.dom_runtime).unwrap()
    fs.write(scratch.join("app_wasm.rs"), &web.wasm_rust).unwrap()
    wasm :: Command.new("rustc").current_dir(&scratch.path).args(["--edition", "2021", "--target", "wasm32-unknown-unknown", "--crate-type", "cdylib", "-O", "app_wasm.rs", "-o", "app.wasm"]).output().expect("spawn web rustc")
    assert(wasm.status.success(), "rustc rejected measured-value web output: {String.from_utf8_lossy(&wasm.stderr)}")
    js :: Command.new("node").current_dir(&scratch.path).arg("app.js").output().expect("spawn web JS app")
    assert(js.status.success(), "node rejected measured-value web output: stdout={String.from_utf8_lossy(&js.stdout)} stderr={String.from_utf8_lossy(&js.stderr)}")
    assert_eq(String.from_utf8_lossy(&js.stdout), MEASUREMENT_EXPECTED)
    fs.write(scratch.join("wasm_harness.mjs"), "\nconst { instantiateWasm, takeWasmError } = await import(\"./jet_dom_runtime.js\");\nconst instance = await instantiateWasm(\"./app.wasm\");\ninstance.exports.jet_export_run();\nif (takeWasmError(instance.exports)?.tag !== \"Ok\") throw new Error(\"unexpected Wasm outcome\");\n").unwrap()
    wasm_run :: Command.new("node").current_dir(&scratch.path).arg("wasm_harness.mjs").output().expect("spawn web Wasm harness")
    assert(wasm_run.status.success(), "node rejected measured-value Wasm output: stdout={String.from_utf8_lossy(&wasm_run.stdout)} stderr={String.from_utf8_lossy(&wasm_run.stderr)}")
    assert_eq(String.from_utf8_lossy(&wasm_run.stdout), MEASUREMENT_EXPECTED)
}
// Rust: tests/mir_constant_identity.rs:304
#Test("aliased_single_member_import_uses_the_grouped_member_resolution") {
    scratch :: common.Scratch.new("mir_constant_identity_member_import")
    tir_support.write_test_package(&scratch.path, tir_support.TIR_TEST_PACKAGE)
    fs.write(scratch.path.join("main.jet"), "use alpha.value as dotted\nuse alpha.[value as grouped]\nmodule alpha\nfn run() { print(dotted()); print(grouped()) }\n").unwrap()
    fs.write(scratch.path.join("alpha.jet"), "pub fn value() -> Int { 31 }\n").unwrap()
    diagnostics :: jet.run_compiler_work(fn() -> {
        entry :: scratch.path.join("main.jet")
        bundle := jet.Loader.load_entry(entry.to_str().unwrap()).expect("both member spellings should load their declared module")
        jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run)
    })
    assert(diagnostics.iter().all(fn(diagnostic) -> diagnostic.severity != jet.Diagnostics.Severity.Error), "member imports must resolve to public functions: {diagnostics:#?}")
    fs.write(scratch.path.join("alpha.jet"), "fn value() -> Int { 31 }\n").unwrap()
    private_diagnostics :: jet.run_compiler_work(fn() -> {
        entry :: scratch.path.join("main.jet")
        bundle := jet.Loader.load_entry(entry.to_str().unwrap()).expect("a private member still belongs to a valid module")
        jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run)
    })
    assert(private_diagnostics.iter().any(fn(diagnostic) -> diagnostic.code == "E0609"), "private member import must be rejected: {private_diagnostics:#?}")
    fs.write(scratch.path.join("alpha.jet"), "pub fn value() -> Int { 31 }\n").unwrap()
    fs.write(scratch.path.join("main.jet"), "use renamed.[value as grouped]\nuse renamed.value as dotted\nuse \"alpha\" as renamed\nfn run() { print(dotted()); print(grouped()) }\n").unwrap()
    aliased_diagnostics :: jet.run_compiler_work(fn() -> {
        entry :: scratch.path.join("main.jet")
        bundle := jet.Loader.load_entry(entry.to_str().unwrap()).expect("a named file import should bind a member-import prefix")
        jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run)
    })
    assert(aliased_diagnostics.iter().all(fn(diagnostic) -> diagnostic.severity != jet.Diagnostics.Severity.Error), "aliased file imports must share member resolution: {aliased_diagnostics:#?}")
}
// Rust: tests/mir_constant_identity.rs:369
#Test("aliased_dotted_module_import_retains_module_precedence_and_ambiguity") {
    scratch :: common.Scratch.new("mir_constant_identity_module_import")
    tir_support.write_test_package(&scratch.path, tir_support.TIR_TEST_PACKAGE)
    fs.write(scratch.path.join("main.jet"), "use alpha.value as selected\nuse alpha.tools.value as deep\nmodule alpha\nfn run() { print(selected.answer()); print(deep.answer()) }\n").unwrap()
    fs.write(scratch.path.join("alpha.jet"), "pub fn value() -> Int { 31 }\n").unwrap()
    fs.write(scratch.path.join("alpha.value.jet"), "pub fn answer() -> Int { 42 }\n").unwrap()
    fs.write(scratch.path.join("alpha.tools.value.jet"), "pub fn answer() -> Int { 43 }\n").unwrap()
    entry :: scratch.path.join("main.jet")
    bundle := jet.Loader.load_entry(entry.to_str().unwrap()).expect("a real dotted module must take precedence over a same-named member")
    imported :: &bundle.modules[bundle.entry].imports[0]
    assert(match &imported.kind { jet.AST.ImportKind.Module(path, _) -> path == "alpha.value"; _ -> false }, "a real module path must retain its namespace: {imported:?}")
    deep_import :: &bundle.modules[bundle.entry].imports[1]
    assert(match &deep_import.kind { jet.AST.ImportKind.Module(path, _) -> path == "alpha.tools.value"; _ -> false }, "a deep module path must retain its namespace: {deep_import:?}")
    diagnostics :: jet.run_compiler_work(fn() -> jet.Sema.check_bundle(&bundle, jet.Sema.CompileMode.Run))
    assert(diagnostics.iter().all(fn(diagnostic) -> diagnostic.severity != jet.Diagnostics.Severity.Error), "a real dotted module must resolve: {diagnostics:#?}")
    fs.create_dir_all(scratch.path.join("other")).unwrap()
    fs.write(scratch.path.join("other/alpha.value.jet"), "pub fn answer() -> Int { 7 }\n").unwrap()
    errors :: jet.Loader.load_entry(entry.to_str().unwrap()).expect_err("ambiguous real modules must not turn into member imports")
    assert(errors.iter().any(fn(diagnostic) -> diagnostic.code == "E0606"), "ambiguous dotted modules must retain E0606: {errors:#?}")
}
// Rust: tests/mir_constant_identity.rs:425
#Test("checked_private_constant_identity_survives_cross_module_calls_imports_and_shadows") {
    assert_fixture_constants_reach_mir_globals()
    assert_private_module_constant_is_rejected()
    (aot_code, aot_stdout, aot_stderr) :: tir_support.build_release_and_run_multi("mir_constant_identity_aot", "main.jet", FILES)
    assert_eq(aot_code, 0, "AOT fixture failed: {aot_stderr}")
    assert_eq(aot_stdout, MIR_EXPECTED)
    assert(aot_stderr.is_empty(), "valid AOT program wrote to stderr: {aot_stderr}")
    (native_code, native_stdout, trace) :: tir_support.run_default_multi("mir_constant_identity_jit", "main.jet", FILES)
    assert_eq(native_code, 0, "default JIT fixture failed: {trace}")
    assert_eq(native_stdout, MIR_EXPECTED)
    assert(trace.lines().any(fn(line) -> {
        fields := line.split_whitespace()
        fields.next() == Some(".::main.jet::run") && fields.next() == Some("tier1") && fields.next() == Some("native")
    }), "default run did not execute the entry natively: {trace}")
    assert(!trace.contains("tier0 interp") && !trace.contains("deopt"), "default run fell back from native execution: {trace}")
    (jit_code, jit_stdout, jit_stderr) :: run_without_tier_trace("mir_constant_identity_jit_stderr", [])
    assert_eq(jit_code, 0, "default JIT fixture failed: {jit_stderr}")
    assert_eq(jit_stdout, MIR_EXPECTED)
    assert(jit_stderr.is_empty(), "valid JIT program wrote to stderr: {jit_stderr}")
    (interp_code, interp_stdout, interp_stderr) :: run_without_tier_trace("mir_constant_identity_interpreter", ["--interpret"])
    assert_eq(interp_code, 0, "interpreter fixture failed: {interp_stderr}")
    assert_eq(interp_stdout, MIR_EXPECTED)
    assert(interp_stderr.is_empty(), "valid interpreter program wrote to stderr: {interp_stderr}")
    assert_web_output("mir_constant_identity_web")
}
// Rust: tests/mir_constant_identity.rs:510
#Test("immutable_bindings_over_pure_work_fold_to_literals") {
    scratch :: common.Scratch.new("mir_pure_fold")
    fs.write(scratch.path.join("main.jet"), PURE_FOLD_SOURCE).unwrap()
    run_cli :: fn(args: &[String]) -> {
        output :: Command.new(env.var_os("CARGO_BIN_EXE_jet").unwrap()).args(args).arg("main.jet").current_dir(&scratch.path).env("NO_COLOR", "1").env("JET_STORE_DIR", scratch.path.join("cache")).env("JETPACK_ROOT", scratch.path.join("jetpack")).output().expect("jet should launch")
        assert(output.status.success(), "jet {args:?} failed: {String.from_utf8_lossy(&output.stderr)}")
        String.from_utf8_lossy(&output.stdout).into_owned()
    }
    rust :: run_cli(["emit", "--rust"])
    for literal in ["JetInt::from_i64(144)", "\"hello jet\".to_string()", "JetInt::from_i64(15)", "JetInt::from_i64(14)"] { assert(rust.contains(literal), "a pure immutable binding did not fold to `{literal}`") }
    assert(!rust.contains("jet_list_reduce(__jet_v_"), "the pure reduce over a literal list still runs at run time")
    for mode in [["run"], ["run", "--interpret"]] { assert_eq(run_cli(mode), "noisy\n144 hello jet 15 14 5\n", "jet {mode:?}") }
}
