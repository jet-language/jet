        output :: common.run_entry_tier(file, tier)
        assert_eq(output.status.code(), 0, "map has_key fixture failed on {tier}")
        assert_eq(String.from_utf8_lossy(output.stdout), expected, "map has_key drifted on {tier}")
        assert(output.stderr.is_empty(), "map has_key stderr drifted on {tier}")
    }
    _ :: fs.remove_dir_all(dir)
}

