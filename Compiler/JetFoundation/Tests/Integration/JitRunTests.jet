// Rust: tests/jit_run.rs:24
#Test("root_receiver_calls_share_the_direct_call_path") {
    if skip_if_native_target_unsupported() { return }
    dir :: common.unique_tmp("jit_root_receiver_calls")
    fs.create_dir_all(dir).unwrap()
    file :: dir.join("root_calls.jet")
    fs.write(file, """
fn scale(#Root value: Int, factor: Int) -> Int {
    return value * factor
}
fn add_half(#Root value: Float) -> Float {
    return value + 0.5
}
fn run() {
    total :: 3
    print(total.scale(4))
    print(scale(total, 4))
    print(total.add_half())
    total.print()
}
""").unwrap()
    bundle := Loader.load_entry(file.to_str().unwrap()).unwrap()
    diagnostics :: Sema.check_bundle(&bundle, Sema.CompileMode.Run)
    assert(diagnostics.is_empty(), "#Root fixture diagnostics: {diagnostics:#?}")
    loop tier in ["O0", "O1", "O2", "Web"] {
        common.compile_entry_tier(file, tier).expect("#Root fixture must lower to canonical native MIR")
        output :: common.run_entry_tier(file, tier)
        assert_eq(output.status.code(), 0, "#Root fixture failed: {String.from_utf8_lossy(output.stderr)}")
        assert_eq(String.from_utf8_lossy(output.stdout), "12\n12\n3.5\n3\n")
    }
    _ :: fs.remove_dir_all(dir)
}

// Rust: tests/jit_run.rs:88
#Test("named_args_example_runs_on_resident_jit_and_forced_interpreter") {
    named_args_example_runs_on_resident_jit_and_forced_interpreter_inner()
}

// Rust: tests/jit_run.rs:92
fn named_args_example_runs_on_resident_jit_and_forced_interpreter_inner() -> {
    assert(common.native_host_supported(), "named_args runtime proof requires a supported native target")
    root :: OSPath.from(env.manifest_dir())
    file :: root.join("Examples/features/basics/named_args.jet")
    expected_path :: root.join("Examples/features/expected/basics/named_args.out")
    expected :: fs.read_to_string(expected_path).expect("named_args golden output")
    shown :: file.to_string_lossy().into_owned()
    bundle := Loader.load_entry(shown).expect("named_args example should load")
    diagnostics :: Sema.check_bundle(&bundle, Sema.CompileMode.Run)
    assert(diagnostics.iter().all((diagnostic) -> diagnostic.severity != Severity.Error), "named_args example must type-check: {diagnostics:#?}")
    loop tier in ["O0", "O1", "O2", "Web"] {
        common.compile_entry_tier(file, tier).expect("named_args example must compile")
    }
    aot :: run_jet(file, true)
    assert_eq(aot.status.code(), 0, "AOT named_args failed: {String.from_utf8_lossy(aot.stderr)}")
    assert_eq(aot.stdout, expected.as_bytes(), "AOT named_args observable order drifted")
    loop tier in ["O0", "O1", "O2", "Web"] {
        output :: common.run_entry_tier(file, tier)
        assert_eq(output.status.code(), 0, "named_args {tier} failed")
        assert_eq(output.stdout, expected.as_bytes(), "named_args {tier} observable order drifted")
        assert(output.stderr.is_empty(), "named_args {tier} stderr drifted")
    }
}

// Rust: tests/jit_run.rs:180
#Test("struct_call_word_preserves_bits_on_every_native_tier") {
    assert(common.native_host_supported(), "#4383 requires a supported native target")
    root :: OSPath.from(env.manifest_dir())
    golden :: fs.read_to_string(root.join("Examples/features/expected/basics/struct_call_word.out")).expect("word-call golden")
    loop (relative, expected) in [
        ("tests/fixtures/struct_call_word_original.jet", "wrapped: 7299585414513572552\n"),
        ("Examples/features/basics/struct_call_word.jet", golden.as_str()),
    ] {
        file :: root.join(relative)
        loop tier in ["O0", "O1", "O2", "Web"] {
            output :: common.run_entry_tier(file, tier)
            assert_eq(output.status.code(), 0, "{relative}: {String.from_utf8_lossy(output.stderr)}")
            assert_eq(String.from_utf8_lossy(output.stdout), expected, "{relative}, tier={tier}")
            assert(output.stderr.is_empty(), "{relative}: {String.from_utf8_lossy(output.stderr)}")
        }
        aot :: run_jet(file, true)
        assert_eq(aot.status.code(), 0, "{String.from_utf8_lossy(aot.stderr)}")
        assert_eq(aot.stdout, expected.as_bytes())
    }
}

