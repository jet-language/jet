// Rust: tests/jit_run.rs:1179
#Test("arg_process_spec_builders_reach_the_child") {
    if skip_if_native_target_unsupported() { return }
    dir :: common.unique_tmp("jit_process_arg_builders")
    fs.create_dir_all(dir).unwrap()
    fs.write(dir.join("package.jet"), "name: \"jit_process_arg_builders\"\nversion: \"0.1.0\"\nauthority: { holds: { allow: [Env, Exec, FS, IO, Mem.Alloc] } }\n").unwrap()
    child_dir :: fs.canonicalize(dir).unwrap()
    child_probe :: child_dir.join("process-probe.txt")
    bad_value_path :: child_dir.join("bad-env-value.txt")
    fs.write(bad_value_path, "bad" + TEXT_NUL + "value").unwrap()
    test_binary :: jet_string(env.current_exe().unwrap())
    file :: dir.join("builders.jet")
    child_dir_text :: jet_string(child_dir)
    child_probe_text :: jet_string(child_probe)
    bad_value_text :: jet_string(bad_value_path)
    fs.write(file, format("""
use core.sys as env
use core.files as files
use core.process as process
fn run() {{
    env.set("JET_PROCESS_PROBE", "1")
    env.set("JET_LOGICAL_ENV", "logical-value")
    print((env.get("JET_LOGICAL_ENV") ?? "missing") == "logical-value")
    names :: env.vars() ?? panic("env vars failed")
    print(names.contains("JET_LOGICAL_ENV"))
    env.set("JET_LOGICAL_GONE", "gone")
    print(env.unset("JET_LOGICAL_GONE") ?? false)
    print((env.get("JET_LOGICAL_GONE") ?? "missing") == "missing")
    child :: process.cmd(["{test_binary}", "--exact", "process_probe_helper", "--nocapture"])
        .cwd("{child_dir_text}")
        .env("JET_SPEC_SET", "spec-value")
        .env_remove("JET_SPEC_REMOVE")
        .run() ?? panic("child failed")
    print(child.success)
    print(files.read("{child_probe_text}") ?? panic("probe read failed"))
    if process.cmd(["{test_binary}"]).env("BAD=NAME", "value").run() == {{
        .Ok(v) -> {{ print("process name accepted") }}
        .Err(e) -> {{ print("process name rejected") }}
        else -> {{}}
    }}
    bad_value :: files.read("{bad_value_text}") ?? panic("bad value read failed")
    if process.cmd(["{test_binary}"]).env("JET_BAD_VALUE", bad_value).run() == {{
        .Ok(v) -> {{ print("process value accepted") }}
        .Err(e) -> {{ print("process value rejected") }}
        else -> {{}}
    }}
}}
""")).unwrap()
    // Byte parity is distinct from the zero-arg builder residency assertion.
    default :: run_jet(file, false)
    release :: run_jet(file, true)
    assert_eq(default.status.code(), release.status.code(), "default stdout:\n{String.from_utf8_lossy(default.stdout)}\ndefault stderr:\n{String.from_utf8_lossy(default.stderr)}\nrelease stdout:\n{String.from_utf8_lossy(release.stdout)}\nrelease stderr:\n{String.from_utf8_lossy(release.stderr)}")
    assert_eq(default.stdout, release.stdout)
    // EffectBudget summary is build-tool output, never run stderr.
    assert_eq(String.from_utf8_lossy(default.stderr), String.from_utf8_lossy(release.stderr), "the run lenses must agree on stderr byte for byte")
    assert(default.status.success(), "default lens failed\nstdout:\n{String.from_utf8_lossy(default.stdout)}\nstderr:\n{String.from_utf8_lossy(default.stderr)}")
    stdout :: String.from_utf8_lossy(default.stdout)
    assert(stdout.starts_with("true\ntrue\ntrue\ntrue\ntrue\ncwd="), "{stdout}")
    assert(stdout.contains("|logical=logical-value|set=spec-value|removed=true\n"))
    assert(stdout.ends_with("process name rejected\nprocess value rejected\n"))
    _ :: fs.remove_dir_all(dir)
}

// Rust: tests/jit_run.rs:1303
// #1993: verifier must compile all adapter latch paths before native execution.
#Test("iter_adapter_latches_emit_dominating_clif") {
    if skip_if_native_target_unsupported() { return }
    dir :: common.unique_tmp("jit_iter_adapter_dominance")
    fs.create_dir_all(dir).unwrap()
    fs.write(dir.join("package.jet"), "name: \"jit_iter_adapter_dominance\"\nversion: \"0.1.0\"\nauthority: { holds: { allow: [IO, Mem.Alloc] } }\n").unwrap()
    file :: dir.join("adapters.jet")
    fs.write(file, """
fn run() {
    jagged :: [1, 2, 3, 5, 6, 9, 10, 12]
    print(jagged.chunk_while((a: Int, b: Int) -> (b == a + 1)).to_list())
    parities :: [2, 4, 6, 1, 3, 8, 10]
    print(parities.dedup_by((n: Int) -> (n % 2)).to_list())
    print(jagged.is_sorted_by((n: Int) -> n))
}
""").unwrap()
    shown :: file.to_string_lossy().into_owned()
    bundle := Loader.load_entry(shown).expect("adapter fixture should load")
    diagnostics :: Sema.check_bundle(&bundle, Sema.CompileMode.Run)
    assert(diagnostics.iter().all((diagnostic) -> diagnostic.severity != Severity.Error), "adapter fixture must type-check: {diagnostics:#?}")
    loop tier in ["O0", "O1", "O2", "Web"] {
        common.compile_entry_tier(file, tier).expect("adapter fixture must compile with dominating latch definitions")
    }
    expected :: "[[1, 2, 3], [5, 6], [9, 10], [12]]\n[2, 1, 8]\ntrue\n"
    aot :: run_jet(file, true)
    assert_eq(aot.status.code(), 0, "AOT adapter fixture failed: {String.from_utf8_lossy(aot.stderr)}")
    assert_eq(String.from_utf8_lossy(aot.stdout), expected, "AOT adapter observable drifted")
    loop tier in ["O0", "O1", "O2", "Web"] {
        output :: common.run_entry_tier(file, tier)
        assert_eq(output.status.code(), 0, "adapter fixture failed on {tier}")
        assert_eq(String.from_utf8_lossy(output.stdout), expected, "adapter observable drifted on {tier}")
        assert(output.stderr.is_empty(), "adapter stderr drifted on {tier}")
    }
    _ :: fs.remove_dir_all(dir)
}

// Rust: tests/jit_run.rs:1429
// Present and absent results must decode the same canonical Option carrier.
#Test("optional_builtins_agree_on_one_option_carrier_across_tiers") {
    if skip_if_native_target_unsupported() { return }
    dir :: common.unique_tmp("jit_option_carrier")
    fs.create_dir_all(dir).unwrap()
    fs.write(dir.join("package.jet"), "name: \"test-fixture\"\nversion: \"0.1.0\"\nauthority: { holds: { allow: [IO, Mem.Alloc] } }\n").unwrap()
    file :: dir.join("option_carrier.jet")
    fs.write(file, """
fn run() {
    repeats :: [5, 3, 1, 3, 9]
    print(repeats.last_index_of(3))
    print(repeats.last_index_of(7))
    counts := [String:Int]{ "words": 4 }
    print(&counts.pop("words") ?? -1)
    print(&counts.pop("words") ?? -1)
    priorities := PriorityQueue.from([2, 9, 4])
    print(&priorities.pop() ?? -1)
    single := PriorityQueue.from([1])
    print(&single.pop() ?? -1)
    print(&single.pop() ?? -1)
}
""").unwrap()
    shown :: file.to_string_lossy().into_owned()
    bundle := Loader.load_entry(shown).expect("fixture should load")
    diagnostics :: Sema.check_bundle(&bundle, Sema.CompileMode.Run)
    assert(diagnostics.iter().all((diagnostic) -> diagnostic.severity != Severity.Error), "fixture must type-check: {diagnostics:#?}")
    loop tier in ["O0", "O1", "O2", "Web"] {
        common.compile_entry_tier(file, tier).expect("option-carrier fixture must compile")
    }
    aot :: run_jet(file, true)
    assert_eq(aot.status.code(), 0, "AOT option-carrier fixture failed: {String.from_utf8_lossy(aot.stderr)}")
    expected :: String.from_utf8_lossy(aot.stdout).into_owned()
    assert_eq(expected, "3\nnull\n4\n-1\n9\n1\n-1\n", "AOT option-carrier observable drifted")
    loop tier in ["O0", "O1", "O2", "Web"] {
        output :: common.run_entry_tier(file, tier)
        assert_eq(output.status.code(), 0, "option-carrier fixture failed on {tier}")
        assert_eq(String.from_utf8_lossy(output.stdout), expected, "option-carrier observable drifted on {tier}")
        assert(output.stderr.is_empty(), "option-carrier stderr drifted on {tier}")
    }
    _ :: fs.remove_dir_all(dir)
}

