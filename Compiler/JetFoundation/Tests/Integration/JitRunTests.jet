// Rust: tests/jit_run.rs:690
#Test("process_run_checked_matches_default_and_aot_lenses") {
    if target.selected_family() != "unix" { return }
    if skip_if_native_target_unsupported() { return }
    dir :: common.unique_tmp("jit_process_run_checked")
    fs.create_dir_all(dir).unwrap()
    fs.write(dir.join("package.jet"), "name: \"jit_process_run_checked\"\nversion: \"0.1.0\"\nauthority: { holds: { allow: [Exec, IO, Mem.Alloc, Time.Wait] } }\n").unwrap()
    file :: dir.join("run_checked.jet")
    fs.write(file, """
use core.process as process
fn run() {
    ok :: process.cmd(["sh", "-c", "exit 0"]).run_checked() ?? panic("zero exit failed")
    print(ok.success)
    print(ok.code)
    plain :: process.cmd(["sh", "-c", "exit 7"]).run() ?? panic("plain run failed")
    print(plain.success)
    print(plain.code)
    if process.cmd(["sh", "-c", "printf 'checked-stderr-start:' >&2; printf '%05000d' 0 >&2; printf ':checked-stderr-end' >&2; exit 7"]).run_checked() == {
        .Ok(_) -> { print("checked:unexpected") }
        .Err(_) -> { print("checked-error") }
        else -> {}
    }
    if process.cmd(["sh", "-c", "printf 'signal-stderr' >&2; kill -TERM $$"]).run_checked() == {
        .Ok(_) -> { print("signal:unexpected") }
        .Err(_) -> { print("signal-error") }
        else -> {}
    }
    child :: process.cmd(["sh", "-c", "kill -TERM $$"]).spawn() ?? panic("signal spawn failed")
    first :: child.wait() ?? panic("first signal wait failed")
    second :: child.wait() ?? panic("second signal wait failed")
    print("{first.code}:{first.success}:{second.code}:{second.success}")
    if {
        first.signal == second.signal -> print("repeat-signal-same")
        else -> print("repeat-signal-different")
    }
    if first.signal == {
        .Val(signal) -> print("repeat-signal:{signal}")
        .None -> print("repeat-signal:none")
    }
}
""").unwrap()
    default :: Command.new(common.jet_bin()).arg("run").arg(file).arg("--trace-tiers").env("JET_RUN_CACHE_DIR", dir.join("cache")).env("NO_COLOR", "1").output().expect("run checked process fixture through default lens")
    release :: Command.new(common.jet_bin()).args(["run", "--release"]).arg(file).env("NO_COLOR", "1").output().expect("run checked process fixture through AOT lens")
    assert_eq(default.status.code(), 0, "{default:?}")
    assert_eq(release.status.code(), 0, "{release:?}")
    assert_eq(default.stdout, release.stdout)
    assert_eq(String.from_utf8(default.stdout).unwrap(), "true\n0\nfalse\n7\nchecked-error\nsignal-error\n-1:false:-1:false\nrepeat-signal-same\nrepeat-signal:15\n")
    trace :: String.from_utf8(default.stderr).unwrap()
    loop tier in ["O0", "O1", "O2", "Web"] {
        output :: common.run_entry_tier(file, tier)
        assert_eq(output.status.code(), 0, "checked process fixture failed on {tier}")
        assert_eq(String.from_utf8_lossy(output.stdout), "true\n0\nfalse\n7\nchecked-error\nsignal-error\n-1:false:-1:false\nrepeat-signal-same\nrepeat-signal:15\n")
    }
    assert(!trace.contains("E0956"), "{trace}")
    details :: dir.join("run_checked_details.jet")
    fs.write(details, """
use core.process as process
fn run() {
    if process.cmd(["sh", "-c", "printf 'checked-stderr-start:' >&2; printf '%05000d' 0 >&2; printf ':checked-stderr-end' >&2; exit 7"]).run_checked() == {
        .Ok(_) -> { print("checked:unexpected") }
        .Err(e) -> { print(e) }
        else -> {}
    }
    if process.cmd(["sh", "-c", "printf 'signal-stderr' >&2; kill -TERM $$"]).run_checked() == {
        .Ok(_) -> { print("signal:unexpected") }
        .Err(e) -> { print(e) }
        else -> {}
    }
}
""").unwrap()
    detailed :: Command.new(common.jet_bin()).args(["run", "--release"]).arg(details).env("NO_COLOR", "1").output().expect("run checked error detail fixture through AOT lens")
    assert_eq(detailed.status.code(), 0, "{detailed:?}")
    stdout :: String.from_utf8(detailed.stdout).unwrap()
    assert(stdout.contains("I/O error during close `sh`"), "{stdout}")
    assert(stdout.contains("code=7"), "{stdout}")
    assert(stdout.contains("stderr=checked-stderr-start:"), "{stdout}")
    assert(!stdout.contains("checked-stderr-end"), "{stdout}")
    assert(stdout.contains("code=-1, signal=15, stderr=signal-stderr"), "{stdout}")
    assert(stdout.len() < 5000, "checked stderr was not bounded: {stdout.len()}")
    _ :: fs.remove_dir_all(dir)
}

// Rust: tests/jit_run.rs:824
#Test("process_pipeline_output_limit_matches_aot_resident_jit_and_interpreter") {
    if target.selected_family() != "unix" && target.selected_os() != "windows" { return }
    if skip_if_native_target_unsupported() { return }
    dir :: common.unique_tmp("jit_process_pipeline_output_limit")
    fs.create_dir_all(dir).unwrap()
    fs.write(dir.join("package.jet"), "name: \"jit_process_pipeline_output_limit\"\nversion: \"0.1.0\"\nauthority: { holds: { allow: [Exec, IO, Mem.Alloc, Time.Wait] } }\n").unwrap()
    file :: dir.join("pipeline_output_limit.jet")
    test_binary :: jet_string(env.current_exe().unwrap())
    fs.write(file, format("""
use core.process as process
fn run() {{
    direct_source :: process.cmd(["{test_binary}", "--exact", "process_pipeline_flood_helper", "--nocapture"])
        .env("JET_PROCESS_PIPELINE_FLOOD", "1")
    direct_sink :: process.cmd(["{test_binary}", "--exact", "process_pipeline_sink_helper", "--nocapture"])
        .env("JET_PROCESS_PIPELINE_SINK", "1")
    if process.pipeline([direct_source, direct_sink]) == {{
        .Ok(receipt) -> {{
            if receipt.success -> print("direct:accepted")
            else -> print("direct:refused")
        }}
        .Err(_) -> print("direct:refused")
    }}
    source :: process.cmd(["{test_binary}", "--exact", "process_pipeline_flood_helper", "--nocapture"])
        .env("JET_PROCESS_PIPELINE_FLOOD", "1")
        .output_limit(1024)
    sink :: process.cmd(["{test_binary}", "--exact", "process_pipeline_sink_helper", "--nocapture"])
        .env("JET_PROCESS_PIPELINE_SINK", "1")
    if process.pipeline([source, sink]) == {{
        .Ok(receipt) -> {{
            if receipt.success -> print("limit:accepted")
            else -> print("limit:refused")
        }}
        .Err(_) -> print("limit:refused")
    }}
    broken_source :: process.cmd(["{test_binary}", "--exact", "process_pipeline_flood_helper", "--nocapture"])
        .env("JET_PROCESS_PIPELINE_FLOOD", "1")
        .output_limit(1048576)
    broken_sink :: process.cmd(["{test_binary}", "--exact", "process_pipeline_closed_sink_helper", "--nocapture"])
        .env("JET_PROCESS_PIPELINE_CLOSED_SINK", "1")
    if process.pipeline([broken_source, broken_sink]) == {{
        .Ok(receipt) -> {{
            if receipt.success -> print("broken:accepted")
            else -> print("broken:refused")
        }}
        .Err(_) -> print("broken:refused")
    }}
}}
""")).unwrap()
    aot :: run_jet(file, true)
    assert_eq(aot.status.code(), 0, "AOT stderr: {String.from_utf8_lossy(aot.stderr)}")
    assert_eq(aot.stdout, b"direct:accepted\nlimit:refused\nbroken:refused\n")
    loop tier in ["O0", "O1", "O2", "Web"] {
        output :: common.run_entry_tier(file, tier)
        assert_eq(output.status.code(), 0, "pipeline failed on {tier}")
        assert_eq(String.from_utf8_lossy(output.stdout), "direct:accepted\nlimit:refused\nbroken:refused\n")
    }
    _ :: fs.remove_dir_all(dir)
}

// Rust: tests/jit_run.rs:917
#Test("prompt_helpers_preserve_behavior_through_named_deopt") {
    if skip_if_native_target_unsupported() { return }
    dir :: common.unique_tmp("jit_prompt_named_deopt")
    fs.create_dir_all(dir).unwrap()
    fs.write(dir.join("package.jet"), "name: \"jit_prompt_named_deopt\"\nversion: \"0.1.0\"\nauthority: { holds: { allow: [IO, Mem.Alloc, Time.Wait] } }\n").unwrap()
    file :: dir.join("prompts.jet")
    fs.write(file, """
use core.term as io
use core.text as text
fn prompt_gap() -[IO, Time.Wait]> String {
    confirmed :: io.confirm("Continue?")
    choice :: io.choose("Choose:", ["staging", "production"]) ?? panic("choose failed")
    secret_kind := "unexpected"
    if io.input_secret("Secret: ") == {
        .Ok(_) -> { secret_kind = "secret" }
        .Err(error) -> {
            if error == {
                .InvalidInput(_) -> { secret_kind = "non-tty" }
                else -> { secret_kind = "other" }
            }
        }
    }
    return "{confirmed}|{choice}|{secret_kind}|{text.casefold("Straße")}"
}
fn run() { print(prompt_gap()) }
""").unwrap()
    bundle := Loader.load_entry(file.to_str().unwrap()).expect("prompt fixture loads")
    diags :: Sema.check_bundle(&bundle, Sema.CompileMode.Run)
    assert(!diags.iter().any((d) -> d.severity == Severity.Error), "prompt fixture must check: {diags:?}")
    loop tier in ["O0", "O1", "O2", "Web"] {
        common.compile_entry_tier(file, tier).expect("prompt fixture must compile without a retired deopt plan")
    }
    child := Command.new(common.jet_bin()).arg("run").arg(file).arg("--trace-tiers").env("NO_COLOR", "1").stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().expect("run prompt named-deopt fixture")
    // Answers share their one home with Examples/features/io/terminal_parity.jet.
    answers :: common.example_stdin("io/terminal_parity").expect("io/terminal_parity has stdin answers")
    child.stdin.take().unwrap().write_all(answers.piped.as_bytes()).unwrap()
    output :: child.wait_with_output().unwrap()
    assert_eq(output.status.code(), 0, "{output:?}")
    stdout :: String.from_utf8(output.stdout).unwrap()
    assert(stdout.contains("Continue? [y/N] "), "{stdout}")
    assert(stdout.contains("  1) staging\n  2) production\n"), "{stdout}")
    assert(stdout.contains("Enter a number from 1 to 2."), "{stdout}")
    assert(stdout.ends_with("false|production|non-tty|strasse\n"), "{stdout}")
    trace :: String.from_utf8(output.stderr).unwrap()
    assert(!trace.contains("E0956"), "{trace}")
    loop tier in ["O0", "O1", "O2", "Web"] {
        native :: common.run_entry_tier_with_stdin(file, tier, answers.piped.as_bytes())
        assert_eq(native.status.code(), 0, "prompt sequence failed on {tier}")
        native_stdout :: String.from_utf8(native.stdout).unwrap()
        assert(native_stdout.contains("Continue? [y/N] "), "{native_stdout}")
        assert(native_stdout.contains("  1) staging\n  2) production\n"), "{native_stdout}")
        assert(native_stdout.contains("Enter a number from 1 to 2."), "{native_stdout}")
        assert(native_stdout.ends_with("false|production|non-tty|strasse\n"), "{native_stdout}")
        assert(!String.from_utf8_lossy(native.stderr).contains("E0956"))
    }
    _ :: fs.remove_dir_all(dir)
}

// Rust: tests/jit_run.rs:1018
#Test("args_parse_or_exit_runs_resident_for_return_help_and_usage_error") {
    if skip_if_native_target_unsupported() { return }
    dir :: common.unique_tmp("jit_args_parse_or_exit")
    fs.create_dir_all(dir).unwrap()
    fs.write(dir.join("package.jet"), "name: \"jit_args_parse_or_exit\"\nversion: \"0.1.0\"\nauthority: { holds: { allow: [Exec, IO, Mem.Alloc] } }\n").unwrap()
    file :: dir.join("args.jet")
    fs.write(file, """
use core.args as args
use core.process as process
fn run() {
    spec :: args.spec().flag("verbose", "print extra detail")
    parsed :: spec.parse_or_exit(process.argv())
    print(parsed.flag("verbose"))
}
""").unwrap()
    loop tier in ["O0", "O1", "O2", "Web"] {
        normal :: common.run_entry_tier_with_args(file, tier, ["--verbose"])
        assert_eq(normal.status.code(), 0)
        assert_eq(String.from_utf8_lossy(normal.stdout), "true\n")
        assert(normal.stderr.is_empty(), "{tier} normal: {String.from_utf8_lossy(normal.stderr)}")
        help :: common.run_entry_tier_with_args(file, tier, ["--help"])
        assert_eq(help.status.code(), 0)
        help_stdout :: String.from_utf8_lossy(help.stdout)
        assert(help_stdout.contains("Usage: ") && help_stdout.contains("[options]"), "{help_stdout}")
        assert(help_stdout.contains("--help"), "{help_stdout}")
        assert(help.stderr.is_empty(), "{tier} help: {String.from_utf8_lossy(help.stderr)}")
        bad :: common.run_entry_tier_with_args(file, tier, ["--verbse"])
        assert_eq(bad.status.code(), 2)
        assert(bad.stdout.is_empty())
        bad_stderr :: String.from_utf8_lossy(bad.stderr)
        assert(bad_stderr.contains("unknown option `--verbse`"), "{bad_stderr}")
        assert(bad_stderr.contains("did you mean `--verbose`?"), "{bad_stderr}")
        assert(!bad_stderr.contains("E0956"), "{bad_stderr}")
    }
    _ :: fs.remove_dir_all(dir)
}

