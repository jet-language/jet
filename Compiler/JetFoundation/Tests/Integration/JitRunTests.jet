// Portable real child, invoked through the test executable by absolute path.
#Test("process_probe_helper") {
    if env.var("JET_PROCESS_PROBE").as_deref() != .Ok("1") { return }
    cwd :: env.current_dir().unwrap()
    logical :: env.var("JET_LOGICAL_ENV").unwrap()
    spec_set :: env.var("JET_SPEC_SET").unwrap()
    removed :: env.var_os("JET_SPEC_REMOVE").is_none()
    fs.write(OSPath.from("process-probe.txt"), "cwd={cwd.display()}|logical={logical}|set={spec_set}|removed={removed}").unwrap()
}

