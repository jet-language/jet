    }
    aot :: run_jet(file, true)
    assert_eq(aot.status.code(), 0, "AOT fixture failed")
    expected :: String.from_utf8_lossy(aot.stdout).into_owned()
    assert_eq(expected, "true\nfalse\ntrue\nfalse\n")
