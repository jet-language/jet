    file :: dir.join("map_has_key.jet")
    fs.write(file, """
fn run() {
    strings := [String:Int]{}
    strings.add("present", 1).drop("seed string map")
    print(strings.has_key("present"))
    print(strings.has_key("missing"))
    ints := [Int:String]{}
    ints.add(7, "present").drop("seed int map")
    print(ints.has_key(7))
    print(ints.has_key(8))
}
""").unwrap()
    shown :: file.to_string_lossy().into_owned()
    bundle := Loader.load_entry(shown).expect("map has_key fixture should load")
    diagnostics :: Sema.check_bundle(&bundle, Sema.CompileMode.Run)
