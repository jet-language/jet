// Rust: tests/jit_run.rs:252
#Test("jit_event_four_captures_plus_payload_is_rejected_before_native_call") {
    if skip_if_native_target_unsupported() { return }
    dir :: common.unique_tmp("jit_event_four_captures_payload")
    fs.create_dir_all(dir).unwrap()
    file :: dir.join("event_four_captures.jet")
    source :: """
use core.event as event
fn run() {
    first :: 1
    second :: 2
    third :: 3
    fourth :: 4
    scope :: event.scope()
    hook :: event.decision_hook<Int, String>(HookPolicy.FirstCancelElseTransform)
    hook.on(scope, (value: Int) -> {
        print("{first}|{second}|{third}|{fourth}|{value}")
        HookDecision.Continue
    })
    hook.run(5)
}
"""
    fs.write(file, source).unwrap()
    shown :: file.to_string_lossy().into_owned()
    bundle := Loader.load_entry(shown).expect("event fixture loads")
    diagnostics :: Sema.check_bundle(&bundle, Sema.CompileMode.Run)
    assert(diagnostics.is_empty(), "event fixture must type-check: {diagnostics:#?}")
    aot :: run_jet(file, true)
    assert_eq(aot.status.code(), 0, "AOT event fixture failed: {String.from_utf8_lossy(aot.stderr)}")
    assert_eq(String.from_utf8_lossy(aot.stdout), "1|2|3|4|5\n", "AOT event callback lost its payload or captures")
    // The retired four-word JIT ABI restriction is not a language error.
    // Every retained native tier must deliver all four captures and the payload.
    loop tier in ["O0", "O1", "O2", "Web"] {
        common.compile_entry_tier(file, tier).expect("five callback arguments must lower before native execution")
        output :: common.run_entry_tier(file, tier)
        assert_eq(output.status.code(), 0, "event {tier}: {String.from_utf8_lossy(output.stderr)}")
        assert_eq(String.from_utf8_lossy(output.stdout), "1|2|3|4|5\n", "event callback lost its payload or captures")
    }
    _ :: fs.remove_dir_all(dir)
}

