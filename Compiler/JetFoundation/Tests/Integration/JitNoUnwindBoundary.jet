pub SIGNAL_HANDLER_OWNER :: "crates/jet-codegen/src/Prelude/CoreLib/Top/Interrupt.rs"
// Rust: tests/jit_no_unwind_boundary.rs:206
pub SIGNAL_HANDLER :: "jet_interrupt_mark"
