//RS /// #2027: what a signal does inside `#Shield` is answered once, by construction.
//RS ///
//RS /// A shield defers a *cooperative* interrupt — a cancel or a blown deadline — at
//RS /// the wait points of the shielded task
//RS /// (`Prelude/Scheduler.rs::jet_scheduler_shielded`). An OS signal is not a
//RS /// wait-point outcome: the mark only increments a count, and the drain runs
//RS /// every registered handler once per counted interrupt. So a signal delivered
//RS /// while a task is inside `#Shield { … }` is neither deferred to the region's
//RS /// exit nor discarded — it is counted, and the handlers run on the next drain
//RS /// while the shielded region keeps running.
//RS ///
//RS /// All three tiers answer that identically because they call this one drain and
//RS /// it cannot see shield or task state. Pin the "cannot", so the three tiers
//RS /// agree by construction rather than by three copies happening to match.
//RS #[test]
//RS fn the_interrupt_drain_cannot_consult_shield_or_task_state() {
//RS     let owner = signal_handler_owner_source();
//RS     let leaks: Vec<_> = code_lines(&owner)
//RS         .into_iter()
//RS         .filter(|(_, _, line)| {
//RS             [
//RS                 "shield",
//RS                 "SHIELD",
//RS                 "task_cancelled",
//RS                 "current_task",
//RS                 "panicking",
//RS             ]
//RS             .iter()
//RS             .any(|probe| line.contains(probe))
//RS         })
//RS         .map(|(label, number, line)| format!("{label}:{number}: {}", line.trim()))
//RS         .collect();
//RS     assert!(
//RS         leaks.is_empty(),
//RS         "the one interrupt drain read shield or task state. That is how the \
//RS          three tiers stop agreeing: a signal delivered inside `#Shield` would \
