// D-JITUNWIND1 (#1995/#1997): reference-source boundary scans and cross-tier regressions.
// The Rust reference remains the peer comparator for structural assertions.
use std.[fs, env, process]
use core.sys.target.selected_family

// Rust: tests/jit_no_unwind_boundary.rs:67
pub fn repo_root() -> OSPath { OSPath.from(env.var("CARGO_MANIFEST_DIR").expect("CARGO_MANIFEST_DIR")) }
// Rust: tests/jit_no_unwind_boundary.rs:71
pub fn collect_rs_files(dir: OSPath, out: &[OSPath]) -> {
    entries :: fs.read_dir(dir)
    if entries == Ok(value) {
        for entry in value.flatten() {
            path :: entry.path()
            if path.is_dir() { collect_rs_files(&path, &out) }
            else if path.extension().and_then(|e| -> e.to_str()) == Some("rs") { out.push(^path) }
        }
    }
}
// Rust: tests/jit_no_unwind_boundary.rs:86
pub fn jit_crate_sources() -> [(String, String)] {
    root :: repo_root().join("crates/jet-jit/src")
    assert(root.is_dir(), "jet-jit source root is missing: {root:?}")
    files: [OSPath] := []
    collect_rs_files(&root, &files)
    files.sort()
    assert(files.len() > 20, "the jet-jit scan found only {files.len()} files; the scan root moved")
    files.into_iter().map(|path| -> {
        label :: path.strip_prefix(&root).unwrap_or(path.as_path()).to_string_lossy().into_owned()
        text :: fs.read_to_string(&path).unwrap_or_else(|error| -> panic("read {path:?}: {error}"))
        (label, text)
    }).collect()
}
// Rust: tests/jit_no_unwind_boundary.rs:115
pub fn code_lines(sources: [(String, String)]) -> [(String, Int, String)] {
    out: [(String, Int, String)] := []
    for (label, text) in sources {
        for (index, line) in text.lines().enumerate() {
            trimmed := line.trim_start() // #4303
            if trimmed.starts_with("//") { continue }
            out.push((label.clone(), index + 1, line.to_string()))
        }
    }
    out
}
// Rust: tests/jit_no_unwind_boundary.rs:136
pub fn extern_fn_definitions(sources: [(String, String)]) -> [(String, Int, String, String)] {
    out: [(String, Int, String, String)] := []
    for (label, number, line) in code_lines(sources) {
        at_opt :: line.find("extern \"")
        if at_opt == None { continue }
        at :: at_opt.unwrap()
        rest := line[at + 8..] // #4303
        close_opt :: rest.find('"')
        if close_opt == None { continue }
        close :: close_opt.unwrap()
        tail := rest[close + 1..].trim_start() // #4303
        tail_opt :: tail.strip_prefix("fn ")
        if tail_opt == None { continue }
        named_tail := tail_opt.unwrap().trim_start() // #4303
        name: String :: named_tail.chars().take_while(|c| -> c.is_ascii_alphanumeric() || c == '_' || c == '$').collect()
        if name.is_empty() { continue }
        trimmed := line.trim() // #4303
        out.push((label, number, name, trimmed.to_string()))
    }
    out
}
// Rust: tests/jit_no_unwind_boundary.rs:183
pub fn unguardable_seam_definitions(sources: [(String, String)]) -> [String] {
    extern_fn_definitions(sources).into_iter()
        .filter(|(label, _, _, _)| -> label.as_str() != "host_seam.rs")
        .map(|(label, number, _, line)| -> "{label}:{number}: {line}").collect()
}
