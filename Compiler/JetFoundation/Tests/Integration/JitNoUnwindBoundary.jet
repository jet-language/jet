//RS 
//RS /// Check 1: an `extern "C"` seam body cannot be guarded from outside, so a C
//RS /// frame this crate compiles is an unguardable seam unless it *is* the boundary.
//RS ///
//RS /// The permitted set is stated positively and is now ONE entry long:
//RS /// `host_seam.rs` holds the generated shim — the boundary itself.
//RS ///
//RS /// It used to be two, because this crate compiled its own copy of the OS signal
//RS /// handler. #2027 deleted that copy: the one signal handler lives in
//RS /// [`SIGNAL_HANDLER_OWNER`] and this crate marshals to it, so a C frame named
//RS /// `unix_mark`/`windows_mark`/`jet_interrupt_mark` appearing here again is a
//RS /// re-fork of the handler AND an unguardable seam, and check 1 must say so.
//RS ///
//RS /// Every other `extern` fn definition is a hole, whatever it is called. The
//RS /// previous form of this check banned `extern "C" fn jet_*` only, and
//RS /// `Ffi.rs`'s `jit_ffi_reporter` — a C frame the bridge calls when a foreign
//RS /// function already failed, with a Cranelift frame below it — sat outside that
//RS /// name for exactly as long as the name was the rule (#1995).
//RS fn unguardable_seam_definitions(sources: &[(String, String)]) -> Vec<String> {
//RS     extern_fn_definitions(sources)
//RS         .into_iter()
//RS         .filter(|(label, _, _, _)| label.as_str() != "host_seam.rs")
//RS         .map(|(label, number, _, line)| format!("{label}:{number}: {line}"))
//RS         .collect()
//RS }
//RS 
//RS /// The one signal handler's home (#2027). It is not in this crate and must not
//RS /// come back: a signal handler runs on a borrowed stack that may have a JIT
//RS /// frame under it, and `guard_seam` is the wrong tool there —
//RS /// `jet_scheduler_install_panic_hook` takes the process panic-hook lock and
//RS /// allocates on first call, so catching inside a handler would trade an
//RS /// unreachable panic for a reachable deadlock. The guarantee is that the body
//RS /// cannot panic, and it is checked, not stated.
//RS ///
//RS /// One file, because there is one handler: the Prelude owner AOT embeds in the
//RS /// generated program and `jet_codegen::interrupt_runtime` compiles once for the
//RS /// `jet` binary's interpreter ambient and Cranelift host alike.
//RS const SIGNAL_HANDLER_OWNER: &str = "crates/jet-codegen/src/Prelude/CoreLib/Top/Interrupt.rs";
//RS 
//RS /// The one handler's name. Both platform arms carry it, under mutually
//RS /// exclusive `cfg`s, so the process has one mark whatever it is built for.
//RS const SIGNAL_HANDLER: &str = "jet_interrupt_mark";
//RS 
//RS /// The complete set of statements a signal handler body may contain. Anything
//RS /// that allocates, locks, formats, or reports would raise a panic in a frame
//RS /// that may sit above JIT code — and would do it from a context where the
