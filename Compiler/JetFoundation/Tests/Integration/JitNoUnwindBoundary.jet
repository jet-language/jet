pub SIGNAL_HANDLER_STATEMENTS :: [
    "JET_INTERRUPT_PENDING.fetch_add(1, std::sync::atomic::Ordering::Relaxed);",
    "const CTRL_C_EVENT: u32 = 0;", "if kind == CTRL_C_EVENT {{", "1", "}} else {{", "0", "}}"
]
// Rust: tests/jit_no_unwind_boundary.rs:224
pub fn signal_handler_owner_source() -> [(String, String)] {
    path :: repo_root().join(SIGNAL_HANDLER_OWNER)
    text :: fs.read_to_string(&path).unwrap_or_else(|error| -> panic("read {path:?}: {error}"))
    [(SIGNAL_HANDLER_OWNER.to_string(), text)]
}
// Rust: tests/jit_no_unwind_boundary.rs:233
pub fn definition_body(text: String, line_index: Int) -> [String] {
    from :: text.lines().skip(line_index - 1).collect().join("\n")
    open :: from.find('{').expect("an extern fn definition has a body")
    depth := 0
    end := from.len()
    view := from[open..] // #4303
    for (at, ch) in view.char_indices() {
        if ch == '{' { depth += 1 }
        else if ch == '}' {
            depth -= 1
            if depth == 0 { end = open + at; break }
        }
    }
    body := from[open + 1..end] // #4303
    body.lines().map(|line| -> line.trim()).filter(|line| -> !line.is_empty() && !line.starts_with("//"))
        .map(|line| -> line.to_string()).collect()
}
// Rust: tests/jit_no_unwind_boundary.rs:269
pub fn host_address_escapes(sources: [(String, String)]) -> [String] {
    code_lines(sources).into_iter().filter(|(label, _, _)| -> label.as_str() != "host_seam.rs")
        .filter(|(_, _, line)| -> {
            line.match_indices(" as ").any(|(at, _)| -> {
                tail := line[at + 4..].trim_start() // #4303
                if !(tail.starts_with("usize") || tail.starts_with("*const") || tail.starts_with("*mut")) { return false }
                before := line[..at].trim_end() // #4303
                operand := before.rsplit(|c| -> !(c.is_ascii_alphanumeric() || c == '_')).next().unwrap_or("") // #4303
                operand.starts_with("jet_") || operand.starts_with("jit_")
            })
        }).map(|(label, number, line)| -> {
            trimmed := line.trim() // #4303
            "{label}:{number}: {trimmed}"
        }).collect()
}
// Rust: tests/jit_no_unwind_boundary.rs:301
pub fn symbol_registrations(sources: [(String, String)]) -> [String] {
    code_lines(sources).into_iter().filter(|(_, _, line)| -> line.contains(".symbol("))
        .map(|(label, number, line)| -> {
            trimmed := line.trim() // #4303
            "{label}:{number}: {trimmed}"
        }).collect()
}
// Rust: tests/jit_no_unwind_boundary.rs:782
pub fn jet_run(args: [String], cache: OSPath) -> process.Output {
    // GATE #4494: real process spawning and captured output.
    process.Command.new(env.var("CARGO_BIN_EXE_jet").expect("CARGO_BIN_EXE_jet"))
        .args(args).env("NO_COLOR", "1").env("JET_RUN_CACHE_DIR", cache)
        .current_dir(repo_root()).output().expect("run the jet driver")
}
// Rust: tests/jit_no_unwind_boundary.rs:793
// Rust: tests/jit_no_unwind_boundary.rs:799
pub fn terminating_signal(status: process.ExitStatus) -> Int? {
    // GATE #4483 selected-family dispatch; #4494 native exit status signal.
    if selected_family() == "unix" { status.signal() } else { None }
}
