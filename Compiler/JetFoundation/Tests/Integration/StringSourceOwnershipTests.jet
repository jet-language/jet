// Rust: tests/structural_merge.rs:341
#Test("git_driver_install_is_idempotent_and_preserves_config") {
    root :: dir("driver")
    assert(git(&root, &["init"]).status.success())
    assert(git(&root, &["config", "merge.jetstruct.name", "stale"]).status.success())
    for _ in 0..2 {
        output :: run(&["merge", "install-driver", "--repo", root.to_str().unwrap()])
        assert(output.status.success(), "{String.from_utf8_lossy(&output.stderr)}")
    }
    config :: fs.read_to_string(root.join(".git/config")).unwrap()
    assert(config.contains("[core]"))
    assert_eq(config.matches("[merge \"jetstruct\"]").count(), 1)
    attrs :: fs.read_to_string(root.join(".gitattributes")).unwrap()
    assert_eq(attrs.matches("*.jet merge=jetstruct").count(), 1)
}
// Rust: tests/structural_merge.rs:363
#Test("identical_bilateral_additions_merge_trivia_once") {
    root :: dir("bilateral_additions")
    base :: write(&root, "base.jet", "fn run() -> {}\n")
    ours :: write(&root, "ours.jet", "// ours note\nfn helper() -[]> Int { return 1 }\nfn run() -> {}\n")
    theirs :: write(&root, "theirs.jet", "fn helper() -[]> Int { return 1 }\nfn run() -> {}\n")
    merged :: root.join("merged.jet")
    output :: run(&["merge", "--structural", base.to_str().unwrap(), ours.to_str().unwrap(), theirs.to_str().unwrap(), "--out", merged.to_str().unwrap()])
    assert(output.status.success(), "{String.from_utf8_lossy(&output.stderr)}")
    source :: fs.read_to_string(&merged).unwrap()
    assert_eq(source.matches("fn helper").count(), 1, "{source}")
    assert_eq(source.matches("ours note").count(), 1, "{source}")
    ours_distinct :: write(&root, "ours_distinct.jet", "// ours note\nfn helper() -[]> Int { return 1 }\nfn run() -> {}\n")
    theirs_distinct :: write(&root, "theirs_distinct.jet", "// theirs note\nfn helper() -[]> Int { return 1 }\nfn run() -> {}\n")
    conflict_out :: root.join("must-not-exist.jet")
    conflict :: run(&["merge", "--structural", base.to_str().unwrap(), ours_distinct.to_str().unwrap(), theirs_distinct.to_str().unwrap(), "--out", conflict_out.to_str().unwrap(), "--json"])
    assert_eq(conflict.status.code(), Some(1))
    assert(!conflict_out.exists())
    assert(String.from_utf8_lossy(&conflict.stderr).contains("inter_item_trivia"))
}
// Rust: tests/structural_merge.rs:422
#Test("inter_item_trivia_three_way_merges_and_conflicts_honestly") {
    root :: dir("inter_item_trivia")
    base :: write(&root, "base.jet", BASE)
    ours :: write(&root, "ours.jet", "fn left() -[]> Int { return 10 }\n\n// ownership note\nfn right() -[]> Int { return 2 }\n\nfn run() -> { print(left() + right()) }\n")
    theirs :: write(&root, "theirs.jet", "fn left() -[]> Int { return 1 }\n\nfn right() -[]> Int { return 20 }\n\nfn run() -> { print(left() + right()) }\n")
    merged :: root.join("merged.jet")
    output :: run(&["merge", "--structural", base.to_str().unwrap(), ours.to_str().unwrap(), theirs.to_str().unwrap(), "--out", merged.to_str().unwrap()])
    assert(output.status.success(), "{String.from_utf8_lossy(&output.stderr)}")
    source :: fs.read_to_string(&merged).unwrap()
    assert(source.contains("ownership note"), "{source}")
    assert(source.contains("return 10"), "{source}")
    assert(source.contains("return 20"), "{source}")
    theirs_trivia :: write(&root, "theirs_trivia.jet", "fn left() -[]> Int { return 1 }\n\n// conflicting note\nfn right() -[]> Int { return 2 }\n\nfn run() -> { print(left() + right()) }\n")
    conflict_out :: root.join("trivia-conflict.jet")
    conflict :: run(&["merge", "--structural", base.to_str().unwrap(), ours.to_str().unwrap(), theirs_trivia.to_str().unwrap(), "--out", conflict_out.to_str().unwrap(), "--json"])
    assert_eq(conflict.status.code(), Some(1))
    assert(!conflict_out.exists())
    assert(String.from_utf8_lossy(&conflict.stderr).contains("inter_item_trivia"))
}
