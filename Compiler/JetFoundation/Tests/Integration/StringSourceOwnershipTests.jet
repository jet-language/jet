    assert_eq(json, expected_json)
}
// Rust: tests/structure_fact_plane.rs:172
#Test("structure_plane_keeps_parser_sema_tir_and_runtime_tier_parity") {
    path :: structure_example()
    source :: fs.read_to_string(&path).expect("structure example source")
    (tokens, lexer_diags) :: compiler.Lexer.lex(&source)
    assert(lexer_diags.is_empty(), "lexer diagnostics: {lexer_diags:?}")
    _ :: compiler.Parser.parse(&tokens).expect("structure example parses")
    shown :: path.to_str().expect("structure example path is utf8")
    bundle := compiler.Loader.load_entry(shown).expect("structure example loads")
    diagnostics :: compiler.Sema.check_bundle(&bundle, compiler.Sema.CompileMode.Run)
    assert(diagnostics.iter().all(fn(diagnostic) { diagnostic.severity == compiler.Diagnostics.Severity.Lint }), "structure sema diagnostics: {diagnostics:#?}")
    diagnostic_codes := diagnostics.iter().map(fn(diagnostic) { diagnostic.code.as_str() }).collect()
    diagnostic_codes.sort_unstable()
    assert_eq(diagnostic_codes, ["L0104", "L2001"])
    kinds :: bundle.name_ledger.structure_facts().iter().map(fn(fact) { fact.kind }).collect()
    for kind in [StructureFactKind.Liveness, StructureFactKind.Lifecycle, StructureFactKind.ImportEdge] { assert(kinds.contains(&kind), "missing {kind:?} in {kinds:?}") }
    // GATE #4494: process isolation and cache directories.
    cache :: env.temp_dir().join("jet_structure_plane_tiers_{process.id()}")
    _ :: fs.remove_dir_all(&cache)
    for (mode, args) in [("release", ["run", "--release", shown]), ("default", ["run", shown]), ("interpret", ["run", "--interpret", shown])] {
        output :: Command.new(jet()).current_dir(repo()).env("NO_COLOR", "1").env("JET_RUN_CACHE_DIR", cache.join(mode).join("run")).env("JET_STORE_DIR", cache.join(mode).join("build")).args(args).output().expect("run structure example tier")
        assert(output.status.success(), "{mode} failed: stdout={String.from_utf8_lossy(&output.stdout)} stderr={String.from_utf8_lossy(&output.stderr)}")
        assert_eq(output.stdout, "structure fact plane\n".as_bytes(), "{mode} output")
    }
    dev :: Command.new(jet()).current_dir(repo()).env("NO_COLOR", "1").env("JET_RUN_CACHE_DIR", cache.join("dev").join("run")).env("JET_STORE_DIR", cache.join("dev").join("build")).args(["dev", shown, "--watch=off"]).output().expect("run structure example through dev")
    assert(dev.status.success(), "dev failed: stdout={String.from_utf8_lossy(&dev.stdout)} stderr={String.from_utf8_lossy(&dev.stderr)}")
    assert_eq(dev.stdout, "structure fact plane\n".as_bytes(), "dev output")
    _ :: fs.remove_dir_all(cache)
}
// Rust: tests/structure_fact_plane.rs:251
#Test("structure_plane_web_compile_erases_the_fact_plane") {
    rustc :: Command.new("rustc").args(["--print", "target-libdir", "--target", "wasm32-unknown-unknown"]).output().expect("probe wasm target")
    if !rustc.status.success() {
        eprintln("note: skipping structure web tier proof (wasm target unavailable)")
        return
    }
    output :: run_jet(&["build", "--target=web", "Examples/features/tooling/structure_plane.jet"])
    assert(output.status.success(), "web build failed: stdout={String.from_utf8_lossy(&output.stdout)} stderr={String.from_utf8_lossy(&output.stderr)}")
}
// Rust: tests/structure_fact_plane.rs:276
#Test("structure_fact_declaration_erases_before_codegen") {
    output :: compiler.compile(FACT_SOURCE).expect("structure fact fixture compiles")
    assert(output.rust.contains("structure facts erase"))
    assert(!output.rust.contains("Structure.Liveness"))
    assert(!output.rust.contains("$holds"))
    assert(!output.rust.contains("manifest rule edit"))
}
// Rust: tests/structure_fact_plane.rs:285
#Test("structure_fact_declaration_erases_for_web_codegen") {
    output :: compiler.compile_web_with_path(FACT_SOURCE, "structure_fact_plane_web.jet").expect("structure fact fixture compiles for web")
    web :: output.web.expect("web artifacts are present")
    for generated in [&web.wasm_rust, &web.js_app] {
        assert(!generated.contains("Structure.Liveness"))
        assert(!generated.contains("$holds"))
        assert(!generated.contains("manifest rule edit"))
    }
}
