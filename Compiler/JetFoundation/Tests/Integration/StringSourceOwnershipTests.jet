use StringSourceOwnership.*
use jet as compiler
use jet_foundation.Names.[NameLedger, StructureFact, StructureFactKind]
use jet_foundation.Registry
use std.[fs, env, process]
use std.process.Command
use tir_support

// Rust: tests/string_source_ownership.rs:7
#Test("string_source_part_is_not_a_public_core_module") {
    source :: include_str("Core/text/string.jet")
    assert(source.contains("fn len(receiver: String) -> Int"))
    assert(!source.contains("pub fn"))
    public_core :: include_str("crates/jet-codegen/src/Prelude/Core.jet")
    assert(!public_core.contains("core.text.string"))
    public_exports :: include_str("crates/jet-foundation/src/CoreModuleExports.rs")
    assert(!public_exports.contains("core.text.string"))
}
// Rust: tests/string_source_ownership.rs:20
#Test("private_string_source_path_is_not_importable") {
    diagnostics :: compiler.compile("use core.text.string as string\nfn run() -> { print(string.len(\"x\")) }\n").expect_err("the compiler-private String source part must not be a public import")
    assert(diagnostics.iter().any(fn(diagnostic) { diagnostic.code == "E1001" }), "private source path should be rejected as an unknown Core module: {diagnostics:?}")
}
// Rust: tests/string_source_ownership.rs:32
#Test("string_method_calls_target_the_private_jet_source_function") {
    source :: """
use core.text as text

fn run() -> {
    value :: "hello"
    print(value.len())
}
"""
    output :: compiler.compile(source).expect("String source method must compile")
    assert(!output.rust.contains("impl String"), "String methods must not be emitted as an inherent Rust impl")
    assert(!output.rust.contains("impl &'static str"), "String methods must not be attached to the primitive Rust view")
    assert(!output.rust.contains("core.text.string"), "the private source part must not leak a public Core import path")
}
// Rust: tests/string_source_ownership.rs:57
#Test("string_len_source_agrees_across_execution_tiers") {
    tir_support.assert_tiers_agree("string_len_source", "use core.text as text\nfn run() -> { print(\"héllo\".len()) }\n", "5\n")
}
// Rust: tests/structural_merge.rs:77
#Test("structural_diff_classifies_body_and_rename_with_stable_ids") {
    root :: dir("diff")
    before :: write(&root, "before.jet", BASE)
    after :: write(&root, "after.jet", "fn first() -[]> Int { return 1 }\nfn right() -[]> Int { return 3 }\nfn run() -> { print(first() + right()) }\n")
    semantic_rename_receipt(&root, &before, BASE, &fs.read_to_string(&after).unwrap(), "left", "first")
    output :: run(&["diff", "--structural", before.to_str().unwrap(), after.to_str().unwrap(), "--json"])
    assert(output.status.success(), "{String.from_utf8_lossy(&output.stderr)}")
    report :: String.from_utf8_lossy(&output.stdout)
    assert(report.contains("\"kind\":\"renamed\""), "{report}")
    assert(report.contains("\"kind\":\"body_changed\""), "{report}")
    assert(report.contains("\"stable_id\":\"def:"), "{report}")
}
// Rust: tests/structural_merge.rs:108
#Test("structural_diff_does_not_infer_a_rename_from_hand_text") {
    root :: dir("hand_edit")
    before :: write(&root, "before.jet", "fn report() -[]> Int { return 1 }\nfn run() -> { print(report()) }\n")
    after :: write(&root, "after.jet", "fn summarize() -[]> Int { return 1 }\nfn run() -> { print(summarize()) }\n")
    output :: run(&["diff", "--structural", before.to_str().unwrap(), after.to_str().unwrap(), "--json"])
    assert(output.status.success(), "{String.from_utf8_lossy(&output.stderr)}")
    report :: String.from_utf8_lossy(&output.stdout)
    assert(!report.contains("\"kind\":\"renamed\""), "{report}")
}
// Rust: tests/structural_merge.rs:137
#Test("structural_diff_ignores_format_comments_and_reports_signature_and_move") {
    root :: dir("diff_hostile")
    old_dir :: root.join("old")
    new_dir :: root.join("new")
    fs.create_dir_all(&old_dir).unwrap()
    fs.create_dir_all(&new_dir).unwrap()
    before :: write(&old_dir, "same.jet", "// old comment\nfn score(n: Int) -[]> Int { return n }\nfn run() -> { print(score(1)) }\n")
    after :: write(&new_dir, "same.jet", "// new comment\nfn score(n: Int, bonus: Int) -[]> Int {\n    return n + bonus\n}\nfn run() -> { print(score(1, 2)) }\n")
    output :: run(&["diff", "--structural", before.to_str().unwrap(), after.to_str().unwrap(), "--json"])
    assert(output.status.success(), "{String.from_utf8_lossy(&output.stderr)}")
    report :: String.from_utf8_lossy(&output.stdout)
    assert(report.contains("\"kind\":\"signature_changed\""), "{report}")
    assert(report.contains("\"kind\":\"moved\""), "{report}")
    same :: write(&root, "format.jet", "fn score(n: Int) -[]> Int {\n    // only comment\n    return n\n}\nfn run() -> { print(score(1)) }\n")
    no_churn :: run(&["diff", "--structural", before.to_str().unwrap(), same.to_str().unwrap()])
    assert(no_churn.status.success())
    assert_eq(String.from_utf8_lossy(&no_churn.stdout), "no structural changes\n")
}
// Rust: tests/structural_merge.rs:183
#Test("structural_diff_add_remove_reorder_rename_edit_is_deterministic") {
    root :: dir("diff_matrix")
    before :: write(&root, "before.jet", "fn only(value: Int) -[]> Int { return value }\nfn gone() -[]> Int { return 1 }\nfn run() -> { print(only(7)) }\n")
    after :: write(&root, "after.jet", "fn run() -> { print(renamed(7)) }\nfn added() -[]> Bool { return true }\nfn renamed(value: Int) -[]> Int { return 9 }\n")
    args :: ["diff", "--structural", before.to_str().unwrap(), after.to_str().unwrap(), "--json"]
    first :: run(&args)
    second :: run(&args)
    assert(first.status.success(), "{String.from_utf8_lossy(&first.stderr)}")
    assert_eq(first.stdout, second.stdout)
    report :: String.from_utf8_lossy(&first.stdout)
    for kind in ["added", "removed", "renamed", "body_changed"] { assert(report.contains("\"kind\":\"{kind}\""), "{report}") }
}
// Rust: tests/structural_merge.rs:209
#Test("structural_merge_composes_disjoint_edits_and_rechecks_output") {
    root :: dir("disjoint")
    base :: write(&root, "base.jet", BASE)
    ours :: write(&root, "ours.jet", "// retained file header\nfn left() -[]> Int { return 10 }\nfn right() -[]> Int { return 2 }\nfn run() -> { print(left() + right()) }\n")
    theirs :: write(&root, "theirs.jet", "fn left() -[]> Int { return 1 }\nfn right() -[]> Int { return 20 }\nfn run() -> { print(left() + right()) }\n")
    merged :: root.join("merged.jet")
    output :: run(&["merge", "--structural", base.to_str().unwrap(), ours.to_str().unwrap(), theirs.to_str().unwrap(), "--out", merged.to_str().unwrap()])
    assert(output.status.success(), "{String.from_utf8_lossy(&output.stderr)}")
    source :: fs.read_to_string(&merged).unwrap()
    assert(source.contains("return 10"), "{source}")
    assert(source.contains("return 20"), "{source}")
    assert(source.contains("retained file header"), "{source}")
    assert(run(&["check", merged.to_str().unwrap()]).status.success())
}
// Rust: tests/structural_merge.rs:237
#Test("structural_merge_applies_recorded_rename_to_a_parallel_body_edit") {
    root :: dir("recorded_rename_merge")
