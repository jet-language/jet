// Rust: tests/ws_law.rs:881
#Test("public_aot_ws_connect_rejects_url_controls_before_connecting") {
    // GATE #4494 real sockets, nonblocking accept, clock and observer thread.
    listener :: TcpListener.bind("127.0.0.1:0").unwrap()
    listener.set_nonblocking(true).unwrap()
    addr :: listener.local_addr().unwrap()
    observer :: thread.spawn(() -> {
        deadline :: Instant.now() + Duration.from_secs(1)
        loop {
            result :: listener.accept()
            if result.is_ok() { return true }
            error :: result.unwrap_err()
            if error.kind() == ErrorKind.WouldBlock {
                if Instant.now() >= deadline { return false }
                thread.yield_now()
            } else { return false }
        }
    })
    source :: """
use core.net.ws as ws
fn run() -> {
    if ws.connect("ws://ADDRESS/live\nInjected: yes") == {
        .Ok(_) -> print("accepted")
        .Err(error) -> {
            if error == .InvalidURL -> print("rejected")
            else -> print("wrong error")
        }
        else -> print("unexpected")
    }
}
""".replace("ADDRESS", addr.to_string())
    (code, stdout, stderr) :: common.build_and_run("jet_ws_law", "aot_hostile_url", source)
    assert_eq(code, 0, "stderr:\n{stderr}")
    assert_eq(stdout, "rejected\n")
    assert(!observer.join().unwrap(), "hostile public ws.connect reached the socket")
}
// Rust: tests/ws_law.rs:926
#Test("client_and_server_echo_text_over_live_sockets") {
    listener :: TcpListener.bind("127.0.0.1:0").unwrap()
    addr :: listener.local_addr().unwrap()
    server :: thread.spawn(() -> {
        (stream, _) := listener.accept().unwrap()
        mux :: jet_http_mux_new()
        mux.add("GET", "/live", (req) -> {
            sock :: jet_ws_upgrade(req).expect("upgrade")
            message :: jet_ws_recv(sock).expect("recv")
            text :: jet_ws_message_text(message).expect("text")
            jet_ws_send_text(sock, "echo:{text}").expect("send")
            jet_ws_close(sock, 1000, "").expect("close")
            Ok(jet_http_srv_response(500, "unused"))
        })
        jet_http_server_handle_stream(&stream, mux, JetHTTPServerOptions.safe(), AtomicBool.new(false), None, None)
    })
    url :: "ws://{addr}/live"
    client :: jet_ws_connect(url).expect("connect")
    jet_ws_send_text(client, "ping").expect("client send")
    reply :: loop {
        message :: jet_ws_recv(client).expect("client recv")
        if jet_ws_message_is_text(message) && jet_ws_message_text(message).unwrap() == "echo:ping" { break message }
    }
    assert_eq(jet_ws_message_text(reply).unwrap(), "echo:ping")
    closed :: jet_ws_recv(client).expect("client close")
    assert(jet_ws_message_is_close(closed))
    server.join().unwrap()
}
// Rust: tests/ws_law.rs:967
#Test("oversized_client_frame_is_rejected") {
    listener :: TcpListener.bind("127.0.0.1:0").unwrap()
    addr :: listener.local_addr().unwrap()
    server :: thread.spawn(() -> {
        (stream, _) := listener.accept().unwrap()
        mux :: jet_http_mux_new()
        mux.add("GET", "/live", (req) -> {
            sock := jet_ws_upgrade(req).expect("upgrade")
            sock.max_message = 8
            err :: jet_ws_recv(sock).expect_err("must reject")
            assert(err == .MessageTooLarge(limit: 8))
            Ok(jet_http_srv_response(500, "unused"))
        })
        jet_http_server_handle_stream(&stream, mux, JetHTTPServerOptions.safe(), AtomicBool.new(false), None, None)
    })
    client :: jet_ws_connect("ws://{addr}/live").expect("connect")
    _ :: jet_ws_send_text(client, "0123456789")
    server.join().unwrap()
}
// Rust: tests/ws_law.rs:997
#Test("ambient_deadline_cancels_recv") {
    listener :: TcpListener.bind("127.0.0.1:0").unwrap()
    addr :: listener.local_addr().unwrap()
    server :: thread.spawn(() -> {
        (stream, _) := listener.accept().unwrap()
        mux :: jet_http_mux_new()
        mux.add("GET", "/live", (req) -> {
            sock :: jet_ws_upgrade(req).expect("upgrade")
            // The Rust fixture injected its test-only remaining-ms hook; install
            // the actual already-expired canonical ambient deadline instead.
            {
                deadline_guard :: jet_ctx_push_deadline(0)
                err :: jet_ws_recv(sock).expect_err("cancelled")
                assert_eq(err, JetWsError.Cancelled)
            }
            Ok(jet_http_srv_response(500, "unused"))
        })
        jet_http_server_handle_stream(&stream, mux, JetHTTPServerOptions.safe(), AtomicBool.new(false), None, None)
    })
    client :: jet_ws_connect("ws://{addr}/live").expect("connect")
    server.join().unwrap()
}
// Rust: tests/ws_law.rs:1027
#Test("hostile_handshake_missing_version_fails_closed") {
    listener :: TcpListener.bind("127.0.0.1:0").unwrap()
    addr :: listener.local_addr().unwrap()
    server :: thread.spawn(() -> {
        (stream, _) := listener.accept().unwrap()
        mux :: jet_http_mux_new()
        mux.add("GET", "/live", (req) -> {
            result :: jet_ws_upgrade(req)
            if result.is_ok() { panic("expected invalid handshake") }
            assert_eq(result.unwrap_err(), JetWsError.InvalidHandshake)
            Ok(jet_http_srv_response(400, "bad"))
        })
        jet_http_server_handle_stream(&stream, mux, JetHTTPServerOptions.safe(), AtomicBool.new(false), None, None)
    })
    stream := TcpStream.connect(addr).unwrap()
    stream.write_all("GET /live HTTP/1.1\r\nHost: local\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n".as_bytes()).unwrap()
    drop(^stream)
    server.join().unwrap()
}

// Rust: tests/zip_family.rs:57
#Test("strict_zip_mismatch_reports_e0128_across_tiers") {
    results := [("default JIT", jit_run("zip_strict_mismatch", STRICT_MISMATCH_SOURCE)), ("forced interpreter", interpreter_run("zip_strict_mismatch", STRICT_MISMATCH_SOURCE))]
    if have_rustc() {
        results.push(("AOT", build_and_run_full("zip_strict_mismatch", "zip_strict_mismatch", STRICT_MISMATCH_SOURCE)))
    }
    baseline: (String, (I32, String, String))? := None
    loop (tier, (code, stdout, stderr)) in results {
        assert_eq(code, 70, "{tier} must exit with the registered runtime stop: {stderr}")
        lower :: stderr.to_ascii_lowercase()
        loop needle in ["stop [e0128]", "inputs have different lengths under `strict` policy", "strict `zip` requires every input to end on the same row", "zip_short", "truncate", "zip_pad", "pad", "neither changes strictness automatically", "loop row in left.zip(right)"] {
            assert(lower.contains(needle), "{tier} missing {needle:Debug}: {stderr}")
        }
        assert(!stderr.contains("E3001"), "{tier} regressed to E3001: {stderr}")
        assert(!stderr.contains("<core.collections>:0"), "{tier} lost the user zip location: {stderr}")
        if baseline == Val((baseline_tier, expected)) {
            assert_eq((code, stdout.clone(), stderr.clone()), expected, "{tier} diverged from {baseline_tier}")
        } else { baseline = Val((tier, (code, stdout, stderr))) }
    }
}
// Rust: tests/zip_family.rs:111
#Test("zip_family_matches_aot_default_and_forced_interpreter") {
    if !have_rustc() { return }
    (code, aot_stdout) :: build_and_run("zip_family", SOURCE)
    assert_eq(code, 0)
    assert_eq(aot_stdout, EXPECTED)
    dir :: env.temp_dir().join("jet_zip_family_{process.id()}")
    fs.create_dir_all(dir).unwrap()
    path :: dir.join("main.jet")
    fs.write(path, SOURCE).unwrap()
    shown :: path.to_string_lossy().into_owned()
    loop (tier, force_interpreter) in [("default tier", false), ("forced interpreter", true)] {
        outcome :: dev_iteration(shown, false, force_interpreter)
        if outcome == {
            .Ran(stdout: stdout, stderr: stderr, exit_code: exit_code) -> {
                assert_eq(exit_code, 0, "{tier} exit")
                assert_eq(stderr, "", "{tier} stderr")
                assert_eq(stdout, EXPECTED, "{tier} output")
            }
            .Problems(diagnostics) -> panic("{tier} rejected zip family: {diagnostics:Debug}")
        }
    }
}
