// Rust: tests/ws_law.rs:406
#Test("live_query_rerun_publishes_and_reconnect_replays_latest") {
    // GATE #4494: real canonical live-query transport, synchronization and callback ABI.
    footprint :: "law_live_{process.id()}.rows"
    frames :: Arc.new(Mutex.new([String]{}))
    frame_sink :: frames.clone()
    transport_id :: jet_app_ws_register(Arc.new((frame) -> frame_sink.lock().unwrap().push(frame)))
    assert_ne(transport_id, 0, "live transport registration must succeed")
    reruns :: Arc.new(AtomicUSize.new(0))
    rerun_count :: reruns.clone()
    query :: jet_app_live_query(footprint.clone(), "v1", () -> {
        call :: rerun_count.fetch_add(1, Ordering.SeqCst) + 1
        Ok("v{call + 1}")
    })
    assert(query.lifecycle.error.is_empty(), "query registration failed: {query.lifecycle.error:Debug}")
    delivered :: Arc.new(Mutex.new([String]{}))
    delivered_sink :: delivered.clone()
    bound :: jet_app_live_bind_sink(query, Arc.new((value) -> delivered_sink.lock().unwrap().push(value)))
    assert(bound.lifecycle.error.is_empty(), "sink binding failed: {bound.lifecycle.error:Debug}")
    assert_eq(jet_app_live_get(bound), "v1")
    assert_eq(jet_app_invalidate(footprint.clone()), 1)
    assert_eq(reruns.load(Ordering.SeqCst), 1)
    assert_eq(jet_app_live_get(bound), "v2")
    assert(jet_app_live_show(bound).contains("generation=2"))
    assert_eq(delivered.lock().unwrap().deref(), ["v2"])
    topic_prefix :: "live:{bound.id}:"
    published :: frames.lock().unwrap().iter().filter((frame) -> frame.starts_with(topic_prefix)).cloned().collect()
    assert_eq(published.len(), 2, "initial and rerun events must publish")
    assert(published[0].ends_with(":{footprint}:v1"))
    assert(published[1].ends_with(":{footprint}:v2"))
    replayed :: Arc.new(Mutex.new([String]{}))
    replay_sink :: replayed.clone()
    reconnect_id :: jet_app_ws_register(Arc.new((frame) -> replay_sink.lock().unwrap().push(frame)))
    assert_ne(reconnect_id, 0, "reconnect registration must succeed")
    assert_eq(replayed.lock().unwrap().iter().filter((frame) -> frame.starts_with(topic_prefix)).cloned().collect(), ["live:{bound.id}:2:{footprint}:v2"])
    jet_app_ws_unregister(reconnect_id)
    jet_app_ws_unregister(transport_id)
}
// Rust: tests/ws_law.rs:480
#Test("live_query_commit_delivers_to_sink_bound_during_rerun") {
    footprint :: "law_live_sink_{process.id()}.rows"
    rerun_started :: Arc.new(Barrier.new(2))
    rerun_release :: Arc.new(Barrier.new(2))
    started :: rerun_started.clone()
    release :: rerun_release.clone()
    rerun: JetLiveRerun :: Arc.new(() -> {
        started.wait()
        release.wait()
        Ok("v2")
    })
    query :: jet_app_live_with(footprint.clone(), "v1", Val(rerun), None)
    old_values :: Arc.new(Mutex.new([String]{}))
    old_values_sink :: old_values.clone()
    old_bound :: jet_app_live_bind_sink(query, Arc.new((value) -> old_values_sink.lock().unwrap().push(value)))
    assert(old_bound.lifecycle.error.is_empty(), "initial sink binding failed: {old_bound.lifecycle.error:Debug}")
    invalidation_footprint :: footprint.clone()
    invalidator :: thread.spawn(() -> jet_app_invalidate(invalidation_footprint))
    rerun_started.wait()
    new_values :: Arc.new(Mutex.new([String]{}))
    new_values_sink :: new_values.clone()
    new_bound :: jet_app_live_bind_sink(old_bound, Arc.new((value) -> new_values_sink.lock().unwrap().push(value)))
    assert(new_bound.lifecycle.error.is_empty(), "canonical sink rebinding failed: {new_bound.lifecycle.error:Debug}")
    rerun_release.wait()
    assert_eq(invalidator.join().unwrap(), 1)
    assert_eq(old_values.lock().unwrap().deref(), [String]{})
    assert_eq(new_values.lock().unwrap().deref(), ["v2"])
    assert_eq(jet_app_live_get(new_bound), "v2")
}
// Rust: tests/ws_law.rs:529
#Test("direct_ws_consumers_include_client_core_first") {
    hostile :: """
// include!("ignored/line/Ws.rs");
/* include!("ignored/block/Ws.rs"); */
const NORMAL: &str = "include!(\"ignored/normal/Ws.rs\");";
const RAW: &str = r#"include!("ignored/raw/Ws.rs");"#;
include!("kept/WsClient.rs");
include!("kept/Ws.rs");
"""
    assert_eq(actual_includes(hostile), [(6, "kept/WsClient.rs"), (7, "kept/Ws.rs")])
    root :: OSPath.from(env.build_var("CARGO_MANIFEST_DIR"))
    files := [OSPath]{}
    collect_rs(root.join("crates"), &files)
    collect_rs(root.join("tests"), &files)
    consumers := [OSPath]{}
    loop path in files {
        text :: fs.read_to_string(path).unwrap()
        includes :: actual_includes(text)
        loop (index, (_, target)) in includes.iter().enumerate() {
            if !target.ends_with("/Ws.rs") { next }
            (_, client_target) :: index.checked_sub(1).and_then((previous) -> includes.get(previous)) ?? panic("{path.display()} omits WsClient.rs")
            assert(client_target.ends_with("/WsClient.rs"), "{path.display()} must include WsClient.rs immediately before Ws.rs")
            consumers.push(path.strip_prefix(root).unwrap().to_path_buf())
        }
    }
    &consumers.sort()
    assert_eq(consumers, [OSPath.from("crates/jet-jit/src/net_http_rt.rs"), OSPath.from("tests/http_server_lifecycle.rs"), OSPath.from("tests/ws_law.rs")])
}
