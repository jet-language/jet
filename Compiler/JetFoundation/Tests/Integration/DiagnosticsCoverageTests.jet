use jet_foundation.Tests.Integration.DiagnosticsCoverage.[root, read, PRELUDE_JET_SHOW_ROWS, PRELUDE_JET_SHOW_EXCLUSIONS, prelude_file, prelude_declared_type, prelude_declared_jet_show, named_string_const, runtime_stop_calls, registered_codes, registered_code_rows, is_snake_case, assert_ui_snapshot_matches_row, is_retired, coverage_baseline_failure, code_set, report_snapshot_paths, report_fixture_snapshot_paths, extract_report_opening_codes, rendered_report_codes, rendered_snapshot_texts, RUSTC_CODES_IN_SOURCE, DIAGNOSTIC_COVERAGE_ALLOWLIST, DIAGNOSTIC_COVERAGE_ALLOWLIST_CEILING, STAGED_BEHIND_GATE, UNTESTABLE_VIA_SNAPSHOT, RETIRED_WITH_LEGACY_EMISSION, coverage_set_diff, format_code_set, walk_rs, allowed_backend_voice_snapshot, collect_rs_paths, emitted_codes, all_exclusions, coverage_allowlist_codes, coverage_allowlist_errors, coverage_left, coverage_right, check_json_snapshots_for_edits, allowlist_reason_errors]
use jet_foundation.[Registry, Traits, Diagnostics, LintPolicy, Outcome, Coverage, Report]
use jet.Explain
// GATE #4494: tests read actual checked-in source and harness snapshots.
// Rust: tests/diagnostics_coverage.rs:213
#Test("prelude_jet_show_rows_match_canonical_printable_types") {
    prelude_types := Set<String>.new()
    for row in PRELUDE_JET_SHOW_ROWS {
        impl_source :: read(&prelude_file(row.impl_file))
        assert(prelude_declared_jet_show(impl_source, row.rust_type), "missing Prelude JetShow implementation `{row.rust_type}` for `{row.canonical_type}` in {row.impl_file}")
        type_source :: read(&prelude_file(row.type_file))
        assert(prelude_declared_type(type_source, row.rust_type), "missing Prelude type declaration `{row.rust_type}` for `{row.canonical_type}` in {row.type_file}")
        assert(prelude_types.insert(row.canonical_type.to_string()), "duplicate canonical Prelude JetShow row `{row.canonical_type}`")
    }
    foundation :: read(&root().join("crates/jet-foundation/src/Traits.rs"))
    declared :: named_string_const(foundation, "PRELUDE_JET_SHOW_PRINTABLE_TYPES")
    missing := prelude_types.difference(&declared).cloned().collect::<[String]>()
    extra := declared.difference(&prelude_types).cloned().collect::<[String]>()
    missing.sort()
    extra.sort()
    registry := Traits.TraitRegistry.default()
    registry.register_synthetic_display_debug()
    missing_auto := prelude_types.iter().filter((name) -> !registry.auto_printable.contains(name)).cloned().collect::<[String]>()
    missing_auto.sort()
    assert(missing.is_empty() && extra.is_empty() && missing_auto.is_empty(), "Prelude JetShow printable relationship drifted.\nMissing canonical rows: {missing:Debug}\nExtra canonical rows: {extra:Debug}\nMissing auto_printable entries: {missing_auto:Debug}")
}
// Rust: tests/diagnostics_coverage.rs:265
#Test("prelude_jet_show_exclusions_remain_explicit_only") {
    registry := Traits.TraitRegistry.default()
    registry.register_synthetic_display_debug()
    canonical_names := Set<String>.new()
    for exclusion in PRELUDE_JET_SHOW_EXCLUSIONS {
        impl_source :: read(&prelude_file(exclusion.impl_file))
        assert(prelude_declared_jet_show(impl_source, exclusion.rust_type), "missing explicitly excluded Prelude JetShow implementation `{exclusion.rust_type}` in {exclusion.impl_file}")
        type_source :: read(&prelude_file(exclusion.type_file))
        assert(prelude_declared_type(type_source, exclusion.rust_type), "missing explicitly excluded Prelude type declaration `{exclusion.rust_type}` in {exclusion.type_file}")
        assert(canonical_names.insert(exclusion.canonical_type.to_string()), "duplicate explicit Prelude JetShow exclusion `{exclusion.canonical_type}`")
        assert(!exclusion.reason.trim().is_empty(), "explicit Prelude JetShow exclusion `{exclusion.canonical_type}` needs a narrow reason")
        assert(!registry.auto_printable.contains(exclusion.canonical_type), "excluded Prelude JetShow type `{exclusion.canonical_type}` has an automatic printable row: {exclusion.reason}")
    }
}
// Rust: tests/diagnostics_coverage.rs:428
#Test("jit_collections_use_ice_for_internals_and_canonical_runtime_messages") {
    source :: read(&root().join("crates/jet-jit/src/Collections.rs"))
    assert(!source.contains("set_trap("), "Collections.rs must not convert adapter invariants into runtime traps")
    direct_messages :: runtime_stop_calls(source).into_iter().filter_map((args) -> args.get(2).cloned()).filter((wording) -> wording.trim_start_matches('&').trim_start().starts_with('"')).collect::<[String]>()
    assert(direct_messages.is_empty(), "Collections.rs must pass canonical or returned messages to set_runtime_stop, not direct wording literals: {direct_messages:Debug}")
}
// Rust: tests/diagnostics_coverage.rs:460
#Test("runtime_stop_renderer_accepts_only_active_runtime_rows") {
    rows :: Registry.diagnostic_rows()
    active_runtime :: rows.iter().filter((row) -> row.stage == "runtime" && row.status == Registry.DiagnosticStatus.Active).collect::<[_]>()
    assert(!active_runtime.is_empty(), "registry must publish runtime rows")
    for row in active_runtime {
        report :: Outcome.jet_render_runtime_stop(row.code, "probe.jet", 7, "probe", "stop()", 1, 1, "runtime probe", "")
        assert_eq(report.code, row.code)
        assert_eq(report.source, "runtime")
        assert_eq(report.exit_code, 70)
        assert(!report.what.is_empty())
        assert(!report.why.is_empty())
        assert(!report.fix.is_empty())
    }
    for row in rows.iter().filter((row) -> row.stage != "runtime" || row.status != Registry.DiagnosticStatus.Active) {
        report :: Outcome.jet_render_runtime_stop(row.code, "probe.jet", 7, "probe", "stop()", 1, 1, "runtime probe", "")
        assert_eq(report.exit_code, 101, "{row.code} must be a host fault")
    }
    unknown :: Outcome.jet_render_runtime_stop("__unknown_runtime_stop__", "probe.jet", 7, "probe", "stop()", 1, 1, "runtime probe", "")
    assert_eq(unknown.exit_code, 101)
    assert_eq(unknown.source, "host")
}
// Rust: tests/diagnostics_coverage.rs:527
#Test("ffi_runtime_stop_keeps_one_jet_source_frame") {
    report :: Outcome.jet_render_runtime_stop("E3014", "ffi.jet", 7, "run", "foreign_call()", 1, 1, "panic: a foreign function panicked", "")
    assert_eq(report.source, "runtime")
    assert_eq(report.exit_code, 70)
    assert(report.rendered.contains("Stop [E3014]"))
    assert(report.rendered.contains("--> ffi.jet:7 in run"))
    assert(report.rendered.contains("foreign_call()"))
    assert(!report.rendered.contains("rustc"))
}
// Rust: tests/diagnostics_coverage.rs:556
#Test("registered_codes_keep_explicit_severity_and_lint_names") {
    for (code, severity) in [("E2930", Diagnostics.Severity.Lint), ("W0410", Diagnostics.Severity.Lint), ("R0801", Diagnostics.Severity.Error), ("E0043", Diagnostics.Severity.Error)] {
        row :: Registry.diagnostic(code).unwrap_or_else(() -> panic("{code} must stay registered"))
        assert_eq(row.severity, severity, "{code} must keep the registry row's explicit severity")
    }
    for lint in Registry.lint_rows() {
        name :: lint.lint_name.unwrap_or_else(() -> panic("lint {lint.code} needs a stable name"))
        assert(is_snake_case(name), "lint {lint.code} has an unstable selector name `{name}`")
    }
}
// Rust: tests/diagnostics_coverage.rs:586
#Test("semantic_guidance_lints_round_trip_through_the_registry") {
    for (code, name) in [("L0515", "process_args_view"), ("L0516", "message_text"), ("L0517", "path_containment_string_prefix"), ("L0518", "redundant_fixed_cleanup"), ("L0519", "unit_scalar_rewrap"), ("L0520", "display_migration"), ("L0521", "complete_ascii_case_ladder"), ("L0522", "walk_files_filter"), ("L0523", "repeated_list_head"), ("L0524", "raw_multiline_html")] {
        row :: Registry.diagnostic(code).unwrap_or_else(() -> panic("{code} must stay registered"))
        assert_eq(row.severity, Diagnostics.Severity.Lint)
        assert_eq(row.lint_name, Some(name))
        assert(!row.what.is_empty(), "{code} needs What copy")
        assert(!row.why.is_empty(), "{code} needs Why copy")
        assert(!row.fix.is_empty(), "{code} needs Fix copy")
        assert_eq(LintPolicy.code_for_name(name), Some(code))
        assert_eq(LintPolicy.name_for_code(code), Some(name))
    }
}
// Rust: tests/diagnostics_coverage.rs:634
#Test("every_registered_lint_has_a_unique_snake_case_name") {
    registered :: Registry.diagnostic_rows().iter().filter((row) -> row.severity == Diagnostics.Severity.Lint).map((row) -> row.code).collect::<Set<String>>()
    lints :: Registry.lint_rows().collect::<[_]>()
    names := Set<String>.new()
    codes := Set<String>.new()
    for lint in lints {
        name :: lint.lint_name.expect("every registered lint must carry a stable name")
        assert(is_snake_case(name), "lint `{name}` is not a stable snake_case name")
        assert(names.insert(name), "lint name `{name}` is duplicated")
        assert(codes.insert(lint.code), "lint code `{lint.code}` is duplicated")
        assert_eq(Registry.diagnostic(lint.code).map((row) -> row.severity), Some(Diagnostics.Severity.Lint), "lint `{lint.code}` is not a registered lint diagnostic row")
        assert_eq(LintPolicy.name_for_code(lint.code), Some(name), "lint `{lint.code}` does not round-trip through the name registry")
        assert_eq(LintPolicy.code_for_name(name), Some(lint.code), "lint name `{name}` does not resolve to its registered code")
    }
    assert_eq(codes, registered, "every registered lint row must carry exactly one stable name")
}
