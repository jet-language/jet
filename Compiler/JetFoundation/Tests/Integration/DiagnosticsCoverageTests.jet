// Rust: tests/diagnostics_coverage.rs:1567
#Test("i2_rustc_codes_do_not_leak_as_jet_diagnostics") {
    allowed_fn_context :: "looks_like_signature_mismatch"
    source_text := String.new()
    for dir in [root().join("Source"), root().join("crates")] { walk_rs(&dir, (content) -> { source_text.push_str(content); source_text.push('\n') }) }
    for code in RUSTC_CODES_IN_SOURCE {
        other_count := 0
        for dir in [root().join("Source"), root().join("crates")] {
            walk_rs(&dir, (content) -> { other_count += content.lines().filter((line) -> line.contains(code)).filter((line) -> line.contains("Diagnostic::error") || line.contains("Diagnostic::warn")).count() })
        }
        assert_eq(other_count, 0, "I2 violation: rustc error code {code} appears in a Jet Diagnostic::error/warn call outside of {allowed_fn_context}: {other_count} occurrence(s). Rustc codes must NEVER be emitted as Jet diagnostics — only used to classify rustc stderr.")
        classifier_diag_lines :: source_text.lines().filter((line) -> line.contains(code) && line.contains("Diagnostic::error")).count()
        assert_eq(classifier_diag_lines, 0, "I2 violation: rustc code {code} appears inside a Diagnostic::error call")
        snaps :: rendered_report_codes()
        assert(!snaps.contains(code), "I2 violation: rustc code {code} appears in a user-facing snapshot as [{code}]. Rustc error codes must never reach end users.")
    }
}
