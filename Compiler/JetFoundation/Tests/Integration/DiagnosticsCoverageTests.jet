// Rust: tests/diagnostics_coverage.rs:1788
#Test("every_emitted_code_has_snapshot") {
    allowlist_errors :: coverage_allowlist_errors()
    assert(allowlist_errors.is_empty(), "invalid diagnostic coverage allowlist rows:\n{allowlist_errors.join("\n")}")
    left :: coverage_left()
    right :: coverage_right()
    (left_only, right_only) := coverage_set_diff(&left, &right)
    allowed_left :: coverage_allowlist_codes("left-only")
    allowed_right :: coverage_allowlist_codes("right-only")
    left_only.retain((code) -> !allowed_left.contains(code))
    right_only.retain((code) -> !allowed_right.contains(code))
    assert(left_only.is_empty() && right_only.is_empty(), "I4(b) diagnostic coverage set mismatch after named exclusions and owned allowlist rows:\nLEFT-only (registered-active emitted, no report opener):\n  {format_code_set(&left_only)}\nRIGHT-only (report opener, not registered-active emitted):\n  {format_code_set(&right_only)}")
}
