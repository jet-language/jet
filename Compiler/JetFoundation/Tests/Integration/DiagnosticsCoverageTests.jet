    stale_fixture_failure :: coverage_baseline_failure(STALE_ALLOWLIST_FIXTURE, &Set<String>.new(), &emitted).expect("embedded stale allowlist fixture must fail")
    assert_eq(stale_fixture_failure, "EXPECTED_SPEC_AHEAD_OF_IMPL contains now-emitted codes; remove the line for each:\n  E2101\n  E3001")
    assert(registered.contains("E0033"), "E0033 is a retired reservation and must remain in the typed rows")
    assert(registered.contains("E0745") && is_retired("E0745", ""), "E0745 is a retired reservation and must remain in the typed rows")
    parser :: read(&root().join("crates/jet-parser/src/Parser/mod.rs"))
