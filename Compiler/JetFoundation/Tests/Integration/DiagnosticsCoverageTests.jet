// Rust: tests/diagnostics_coverage.rs:2162
#Test("diagnostic_coverage_baseline_is_a_non_decreasing_floor") {
    baseline :: Registry.diagnostic_coverage_baseline()
    assert(baseline.rows.len() > 1, "coverage baseline must classify the current registry by plane")
    entries :: Registry.diagnostic_coverage_entries()
    facts :: Coverage.try_facts(entries.clone()).expect("registered diagnostic coverage rows must be valid")
    validated :: Registry.validate_diagnostic_coverage(entries).expect("current diagnostic coverage must meet its checked-in floor")
    assert_eq(facts, validated)
    assert_eq(facts.iter().map((fact) -> fact.rows).sum::<Int>(), baseline.rows.values().map((row) -> row.total).sum::<Int>())
    assert_eq(facts.iter().map((fact) -> fact.edit_covered).sum::<Int>(), baseline.rows.values().map((row) -> row.edit_covered).sum::<Int>())
    assert_eq(facts.iter().map((fact) -> fact.reason_covered).sum::<Int>(), baseline.rows.values().map((row) -> row.reason_covered).sum::<Int>())
    with_new_uncovered := [Coverage.CoverageEntry]{}
    for fact in facts {
        for _ in 0..fact.edit_covered { with_new_uncovered.push(Coverage.CoverageEntry.new(fact.plane.clone(), true, None)) }
        for _ in 0..fact.reason_covered { with_new_uncovered.push(Coverage.CoverageEntry.new(fact.plane.clone(), false, Some(Report.NoFixReasonKind.Behavior))) }
        for _ in 0..fact.uncovered { with_new_uncovered.push(Coverage.CoverageEntry.new(fact.plane.clone(), false, None)) }
    }
    open_plane :: facts.iter().find((fact) -> fact.uncovered > 0).expect("the current source must expose an open coverage plane")
    with_new_uncovered.push(Coverage.CoverageEntry.new(open_plane.plane.clone(), false, None))
    failure :: Coverage.validate_registry_coverage(with_new_uncovered, &baseline).expect_err("a new uncovered row in an open plane must fail the ratchet")
    assert(failure.contains("neither fix_edits nor no_fix_reason"))
}
