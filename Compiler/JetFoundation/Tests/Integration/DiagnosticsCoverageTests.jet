    reason_errors :: allowlist_reason_errors(&EXPECTED_SPEC_AHEAD_OF_IMPL)
    assert(reason_errors.is_empty(), "Invalid EXPECTED_SPEC_AHEAD_OF_IMPL reasons:\n  {reason_errors.join("\n  ")}")
