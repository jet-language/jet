    spec_ahead_of_impl :: registered.iter().filter((code) -> !exclusions.contains(code)).filter((code) -> Registry.diagnostic(code).is_some_and((row) -> row.status != Registry.DiagnosticStatus.Reserved)).filter((code) -> !emitted.contains(code)).cloned().collect::<Set<String>>()
    baseline_failure :: coverage_baseline_failure(EXPECTED_SPEC_AHEAD_OF_IMPL.iter().map((row) -> row.0).collect(), &spec_ahead_of_impl, &emitted)
    if baseline_failure == Some(failure) { panic("{failure}") }
