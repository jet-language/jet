    assert_eq(coverage_baseline_failure(["E2101"], &code_set(&["E2101", "E3001"]), &emitted), Some("Unexpected codes registered in typed rows but not emitted in Source/.\nIf this is intentional (staged feature), add the code to EXPECTED_SPEC_AHEAD_OF_IMPL in tests/diagnostics_coverage.rs.\nUnexpected:\n  E3001"))
    assert_eq(coverage_baseline_failure(baseline, &code_set(&["E2101", "E4000"]), &emitted), Some("EXPECTED_SPEC_AHEAD_OF_IMPL is missing baseline entries; restore the line for each:\n  E3001\nUnexpected codes registered in typed rows but not emitted in Source/.\nIf this is intentional (staged feature), add the code to EXPECTED_SPEC_AHEAD_OF_IMPL in tests/diagnostics_coverage.rs.\nUnexpected:\n  E4000"))
    assert_eq(coverage_baseline_failure(baseline, &code_set(&baseline), &emitted), None)
}
// Rust: tests/diagnostics_coverage.rs:1009
#Test("diagnostic_snapshots_keep_the_complete_registered_product") {
    source_rows := 0
    for (line_index, raw) in Registry.DIAGNOSTIC_SOURCE.lines().enumerate() {
        line := raw.trim() // #4303
        if line.is_empty() || line.starts_with("//") { continue }
        fields :: line.split('\t').collect::<[String]>()
        assert(fields.len() == 12 || fields.len() == 13, "Diagnostics.jet:{line_index + 1} lost a registered field: expected 12 or 13, got {fields.len()}")
        for (index, name) in [(1, "code"), (7, "What"), (8, "Why"), (9, "Fix")] { assert(!fields[index].trim().is_empty(), "Diagnostics.jet:{line_index + 1} lost its registered {name}") }
        assert(Registry.diagnostic(fields[1]).is_some(), "Diagnostics.jet:{line_index + 1} lost registry identity for {fields[1]}")
        source_rows += 1
    }
    assert_eq(source_rows, Registry.diagnostic_rows().len(), "snapshot contract must inspect every registered source row")
    for row in Registry.diagnostic_rows() {
        assert(!row.code.is_empty(), "diagnostic row lost its code")
        assert(!row.what.is_empty(), "{row.code} lost its What")
        assert(!row.why.is_empty(), "{row.code} lost its Why")
        assert(!row.fix.is_empty(), "{row.code} lost its Fix")
    }
    for path in report_snapshot_paths() {
        snapshot :: read(&path)
        lines :: snapshot.lines().collect::<[String]>()
        // Index all openers once; each report's span is visited once.
        openers :: lines.iter().enumerate().filter_map(((index, line)) -> extract_report_opening_codes(line).first().map((code) -> (index, code.clone()))).collect::<[(Int, String)]>()
        for (position, (start, code)) in openers.iter().enumerate() {
            row :: Registry.diagnostic(code).unwrap_or_else(() -> panic("{path.display()} snapshot uses unregistered diagnostic code {code}"))
            end :: openers.get(position + 1).map((entry) -> entry.0).unwrap_or(lines.len())
            report :: &lines[start..end]
            what := lines[start].split_once("]: ").or_else(() -> lines[start].split_once("): ")).map((parts) -> parts.1.trim()).unwrap_or("") // #4303
            assert(!what.is_empty(), "{path.display()} lost What for {code}")
            assert(report.iter().any((line) -> line.strip_prefix(" Why: ").is_some_and((why) -> !why.is_empty())), "{path.display()} lost Why for {code}")
            assert(report.iter().any((line) -> line.strip_prefix(" Fix: ").is_some_and((fix) -> !fix.is_empty())), "{path.display()} lost Fix for {code}")
            more :: "More: jet-lang.dev/e/{code}"
            assert(report.iter().any((line) -> line == more), "{path.display()} lost snapshot link for {code}")
            assert(!row.what.trim().is_empty() && !row.why.trim().is_empty() && !row.fix.trim().is_empty(), "{code} has an incomplete registered product")
        }
    }
}
