// Source-owned evaluation for compile-time reflection metadata predicates.
// Metadata values are the canonical Comptime reflection structs; no native
// Builtins callback participates in this route.
use {
    jet_foundation.[
        TComptimeField,
        TComptimeValue,
        Type,
    ]
    jet_sema.[
        sema_comptime_reflection_has_marker,
    ]
}

jet_eval_reflection_metadata_supported: fn(owner: String, method: String) -> Bool Never! {
    if owner == "TypeInfo" -> return method == "has_marker" || method == "implements" || method == "has_method" || method == "marker"
    if owner == "FieldInfo" || owner == "MethodInfo" -> return method == "has_marker" || method == "marker"
    false
}

// The last segment of a written marker name (`Web.Route` is `Route`).
jet_eval_reflection_marker_leaf: fn(name: String) -> String Never! {
    parts: name.split(".").to_list()
    if parts.len() == 0 -> return name.copy()
    parts[parts.len() - 1].copy()
}

// `info.marker(T)`: `args` is the receiver, the marker's name, then each
// defaulted parameter's name and default (sema_call_reflection_marker_lookup).
// The first marker of that name on the receiver reads as a `T` whose fields
// are its written arguments, then the defaults of the parameters it left out;
// a receiver without it gives None.
jet_eval_reflection_marker_value: fn(owner: String, args: [TComptimeValue]) -> JetEvalCompilerValueAnswer {
    if args.len() < 2 || args.len() % 2 != 0 -> return jet_eval_compiler_value_fault("reflection method {owner}.marker takes its receiver, the marker name and default pairs")
    wanted: if args[1] == .String(text) -> text else -> { return jet_eval_compiler_value_fault("reflection method {owner}.marker requires the marker name") }
    fields: jet_eval_compiler_value_fields(args[0], owner) ?? return jet_eval_compiler_value_fault("reflection metadata route receiver is not {owner}")
    absent: JetEvalCompilerValueAnswer.Value{value: TComptimeValue.Failed{report: .Clean{ty: Type.Named{name: wanted}}}}
    markers: jet_eval_compiler_value_field(fields, "markers") ?? return absent
    rows: if markers == .List(values) -> values else -> { return absent }
    loop row in rows {
        marker_fields: if row == .Struct(_, values) -> values else -> { next }
        name: jet_eval_compiler_value_field(marker_fields, "name") ?? next
        text: if name == .String(written_name) -> written_name else -> { next }
        if jet_eval_reflection_marker_leaf(text) != wanted -> next
        record := [TComptimeField]{}
        written: jet_eval_compiler_value_field(marker_fields, "args") ?? TComptimeValue.List{values: [TComptimeValue]{}}
        if written == .List(arguments) {
            loop argument in arguments {
                argument_fields: if argument == .Struct(_, entries) -> entries else -> { next }
                label: jet_eval_compiler_value_field(argument_fields, "name") ?? next
                // A record laid out with no value (JetIR ir_comptime_struct)
                // leaves its parameter to the default.
                value: jet_eval_compiler_value_field(argument_fields, "value") ?? next
                if value == .Unit -> next
                if label == .String(parameter) -> record.push(TComptimeField{name: parameter, value: value})
            }
        }
        at := 2
        loop at + 1 < args.len() {
            if args[at] == .String(parameter) {
                given := false
                loop field in record {
                    if field.name == parameter -> given = true
                }
                if !given -> record.push(TComptimeField{name: parameter, value: args[at + 1]})
            }
            at += 2
        }
        return JetEvalCompilerValueAnswer.Value{value: TComptimeValue.Present{value: TComptimeValue.Struct{type_name: wanted, fields: record}}}
    }
    absent
}

jet_eval_reflection_metadata_string_list_contains: fn(fields: [TComptimeField], field_name: String, wanted: String) -> Bool Never! {
    list: jet_eval_compiler_value_field(fields, field_name) ?? return false
    if list == {
        .List(values) -> {
            loop value in values {
                if value == .String(name) && name == wanted -> return true
            }
            return false
        }
        .Int(_) | .Float(_, _) | .Bool(_) | .Char(_) | .String(_) | .BigInt(_) | .Bytes(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit -> false
    }
}

jet_eval_reflection_metadata_method_list_contains: fn(fields: [TComptimeField], wanted: String) -> Bool Never! {
    list: jet_eval_compiler_value_field(fields, "methods") ?? return false
    if list == {
        .List(values) -> {
            loop value in values {
                if value == .Struct(_, method_fields) {
                    name: jet_eval_compiler_value_field(method_fields, "name") ?? next
                    if name == .String(text) && text == wanted -> return true
                }
            }
            return false
        }
        .Int(_) | .Float(_, _) | .Bool(_) | .Char(_) | .String(_) | .BigInt(_) | .Bytes(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit -> false
    }
}

// Reflection predicate `owner.method` (one jet_eval_reflection_metadata_supported
// accepts) on `args`: the receiver, then the String name it asks about.
jet_eval_reflection_answer: fn(owner: String, method: String, args: [TComptimeValue]) -> JetEvalCompilerValueAnswer {
    if method == "marker" -> return jet_eval_reflection_marker_value(owner, args)
    if args.len() != 2 -> return jet_eval_compiler_value_fault("reflection metadata method {owner}.{method} takes its receiver and one name")
    wanted: if args[1] == .String(text) -> text else -> { return jet_eval_compiler_value_fault("reflection metadata method requires a String name") }
    receiver: args[0]
    fields: jet_eval_compiler_value_fields(receiver, owner) ?? return jet_eval_compiler_value_fault("reflection metadata route receiver is not {owner}")
    if method == "has_marker" {
        marked: sema_comptime_reflection_has_marker(receiver, wanted) ?? return jet_eval_compiler_value_fault("reflection metadata marker receiver is not {owner}")
        return JetEvalCompilerValueAnswer.Value{value: TComptimeValue.Bool{value: marked}}
    }
    found: if method == "implements" -> jet_eval_reflection_metadata_string_list_contains(fields, "implements", wanted) else -> jet_eval_reflection_metadata_method_list_contains(fields, wanted)
    JetEvalCompilerValueAnswer.Value{value: TComptimeValue.Bool{value: found}}
}
