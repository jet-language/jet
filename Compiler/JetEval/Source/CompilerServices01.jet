// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:552
pub fn build_unit_scale_provenance_info(provenance: &UnitScaleProvenance) -> CtValue {
    (kind, value, source, uncertainty) := match provenance {
        .Rational => ("Rational", None, None, None)
        .SymbolicPi { numerator, denominator } => ("SymbolicPi", Val(ct_str("{numerator}/{denominator}")), None, None)
        .Conventional { value, source } => ("Conventional", Val(ct_str(value.to_string())), Val(ct_str(source.to_string())), None)
        .Measured { central_value, standard_uncertainty, source } => ("Measured", Val(ct_str(central_value.to_string())), Val(ct_str(source.to_string())), Val(ct_str(standard_uncertainty.to_string())))
    }
    ct_struct("UnitScaleProvenanceInfo", &[("kind", typed_enum("UnitScaleProvenanceKind", kind)), ("value", optional_value(^value, "String")), ("source", optional_value(^source, "String")), ("uncertainty", optional_value(^uncertainty, "String"))])
}
