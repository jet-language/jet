// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:1439
fn type_level_marker_views_with_vocabulary(type_markers: &[Marker], serde_markers: &[Marker], derives: &[(String, Span)], vocabulary: &Policy.MarkerVocabulary?) -> ([CtValue], [CtValue]) {
