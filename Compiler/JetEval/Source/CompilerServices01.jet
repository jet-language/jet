fn marker_info(marker: &Marker, vocabulary: &Policy.MarkerVocabulary?) -> CtValue {
    row := Registry.row(&marker.name).and_then(fn(row) { row.rule })
    declaration := vocabulary.and_then(fn(vocabulary) { vocabulary.declaration(&marker.name) })
    bindings := row.and_then(fn(row) { row.signature.marker_argument_bindings(marker) })
    args := marker.args.iter().enumerate().map(fn((index, argument)) {
        declaration_parameter := vocabulary.and_then(fn(vocabulary) { vocabulary.declaration(&marker.name) }).and_then(fn(declaration) {
            marker.arg_labels.get(index).and_then(fn(label) { label.as_ref() }).and_then(fn((name, _)) {
                declaration.params.iter().find(fn(parameter) { parameter.name == name })
            }).or_else(fn() { declaration.params.iter().filter(fn(parameter) { !parameter.name.starts_with('$') }).nth(index) })
        })
        binding := bindings.as_ref().and_then(fn(bindings) { bindings.iter().find(fn(binding) { binding.source_index == index }) })
        parameter := binding.and_then(fn(binding) { binding.parameter_index }).and_then(fn(parameter) { row.and_then(fn(row) { row.signature.params.get(parameter) }) })
        (argument_name, source_type) := if parameter := declaration_parameter {
            (parameter.name.clone(), parameter.ty.as_ref().map(Type.name).unwrap_or_else(fn() { "Value" }))
        } else {
            (parameter.map(fn(parameter) { parameter.name.to_string() }).unwrap_or_else(fn() { "value" }), parameter.map(fn(parameter) { parameter.source_type.to_string() }).unwrap_or_else(fn() { "Value" }))
        }
        ct_struct("MarkerArgInfo", &[("name", ct_str(^argument_name)), ("ty", ct_str(source_type.clone())), ("value", match argument {
            .Expr(expression) => marker_arg_value(expression, &source_type)
            .EffectRow { effects, .. } => CtValue.List(effects.iter().map(fn((name, _)) { CtValue.Str(name.clone()) }).collect())
        })])
    }).collect()
    sites := row.map(fn(row) { row.sites.iter().map(fn(site) { ct_str(site.name().to_string()) }).collect() }).or_else(fn() { declaration.map(marker_declaration_sites) }).unwrap_or_default()
    repeatable := row.map(fn(row) { row.repeatable }).or_else(fn() { declaration.map(marker_declaration_repeatable) }).unwrap_or(false)
    marker_info_value(&marker.name, ^args, ^sites, repeatable)
}
