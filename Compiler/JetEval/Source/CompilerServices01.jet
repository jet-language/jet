fn type_dimensions(ty: &Type) -> [CtValue] { match ty { .Quantity { dimension, .. } => [build_dimension_info(dimension)]; .Tagged { inner, .. } => type_dimensions(inner); _ => [] } }
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:985
fn type_fact_rows(path: &String, ty: &Type) -> [CtValue] {
    ty.knowledge_vector().iter().map(fn(entry) {
        kind := fact_kind_for(entry.plane, &entry.fact)
        name := kind.to_ascii_lowercase()
        suffix := if entry.path.is_empty() { "${name}" } else { "{entry.path.join(".")}.${name}" }
        fact_info(kind, &name, "{path}.{suffix}", knowledge_fact_value(kind, &entry.fact))
    }).collect()
}
