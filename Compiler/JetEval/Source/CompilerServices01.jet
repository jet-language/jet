    }).collect()
    ct_struct("ObligationInfo", &[("effect_bound", ct_list(obligations.effect_bound.as_ref().unwrap_or(&[]).iter().cloned().map(ct_str).collect())), ("param_contract", ct_list(^params)), ("variadic", ct_list(obligations.variadic.as_ref().unwrap_or(&[]).iter().copied().map(ct_bool).collect()))])
}
