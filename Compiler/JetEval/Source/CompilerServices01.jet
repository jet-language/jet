    build_struct_layout_info_with_engine(s, &engine)
}
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:211
pub fn build_struct_layout_info_with_engine(s: &StructDef, engine: &TargetLayoutEngine) -> CtValue { layout_info_for_struct(s, engine) }
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:218
fn layout_info_for_enum(def: &EnumDef, engine: &TargetLayoutEngine) -> CtValue {
    fields := def.variants.iter().map(fn(variant) {
        ty := match variant.payload {
            .Unit => "Unit"
            .Single(ty, _) => ty.name()
            .Named(fields) => "{" + fields.iter().map(fn(field) { "{field.name}: {field.ty.name()}" }).collect().join(", ") + "}"
        }
        (variant.name.clone(), ^ty)
    }).collect()
    (kind, guarantee) := if def.c_layout_tag().is_some() { ("c", "repr(C) declaration") } else { ("default", "enum physical layout unspecified") }
    facts := engine.enum_facts(def)
    layout_info(kind, guarantee, "enum declaration", engine.target(), ^fields, &facts, None)
}
