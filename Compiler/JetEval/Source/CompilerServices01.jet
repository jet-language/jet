pub fn registered_fact_value(read: Registry.FactRead, subject: &String, items: &[Item]) -> CtValue? {
    declared := fn(name: &String) -> Bool { items.iter().any(fn(item) { match item {
        .Struct(def) => def.name == name; .Enum(def) => def.name == name; .Distinct(def) => def.name == name; .Func(func) => func.name == name
        .UnitFamily(family) => family.distinct_defs().iter().any(fn(def) { def.name == name }); _ => false
    } }) }
    match read {
        .Sendability if declared(subject) => Val(build_sendability_info(true))
        .Movedness if declared(subject) => Val(build_movedness_info(false))
        .Attribution if subject == "report" => Val(build_attribution_info("report", None))
        .Origin if declared(subject) => Val(build_origin_info(false, None, None, None, false))
        .ViewProvenance => items.iter().find_map(fn(item) {
            function := match item { .Func(function) => function; _ => return None }
            if function.name != subject { return None }
            // Rust's map is ordered: the first slot is the lexically smallest.
            provenance := function.return_view_provenance.as_ref().and_then(fn(map) {
                keys := map.keys().collect(); keys.sort()
                keys.first().map(fn(key) { map[key].clone() })
            }).unwrap_or_else(fn() { ViewProvenance { sources: Set.new(), mutable: false } })
            Val(build_view_provenance_info(&provenance))
        })
        .UnitScaleProvenance => items.iter().find_map(fn(item) { match item { .UnitFamily(family) => family.members.iter().find(fn(member) { UnitFamilyDef.type_name(&member.name) == subject }).map(fn(member) { build_unit_scale_provenance_info(&member.scale_provenance) }); _ => None } })
        .Measure | .Exactness | .Classification | .Obligation => reflect_type_value(items, subject, "main").and_then(fn(value) { reflected_fact_field(&value, read).cloned() })
        .Maturity => items.iter().find_map(fn(item) { match item { .Func(function) if function.name == subject => Val(build_maturity_info(function.maturity.unwrap_or(MaturityTag.Experimental))); _ => None } })
        .RegisteredPlane(name) if Registry.fact_declarations().iter().find(fn(declaration) { declaration.name == name }).is_some_and(fn(declaration) { declaration.name == subject || declaration.source_name == subject }) => {
            info := build_registered_fact_info(name)?
            reflected_struct_field(&info, "value").cloned()
        }
        _ => None
    }
}
