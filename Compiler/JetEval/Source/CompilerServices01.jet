// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:359
fn measure_info(measure: &Measure) -> CtValue {
    (kind, value, symbol) := match measure {
        .Literal { kind, value } => {
            value := I64.try_from(value).ok().map(CtValue.Int)
            symbol := if value.is_none() { Val(ct_str(measure.expression())) } else { None }
            (kind.clone(), ^value, ^symbol)
        }
        .SignedLiteral { kind, value } => (kind.clone(), Val(CtValue.Int(value)), None)
        .Symbol { kind, name } => (kind.clone(), None, Val(ct_str(name.clone())))
        .Combined { kind, .. } => {
            value := measure.literal_value().and_then(fn(value) { I64.try_from(value).ok() }).map(CtValue.Int)
            symbol := if value.is_none() { Val(ct_str(measure.expression())) } else { None }
            (kind.clone(), ^value, ^symbol)
        }
    }
    ct_struct("MeasureInfo", &[("kind", ct_str(^kind)), ("value", optional_value(^value, "Int")), ("symbol", optional_value(^symbol, "String"))])
}
