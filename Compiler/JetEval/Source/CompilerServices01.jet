// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:601
fn fact_value(kind: &String, name: &String, members: [String], range: CtValue?, dimension: CtValue?) -> CtValue {
    ct_struct("FactValue", &[("kind", typed_enum("FactKind", kind)), ("name", ct_str(name.to_string())), ("members", ct_list(members.into_iter().map(ct_str).collect())),
        ("range", optional_value(^range, Syntax.TYPE_RANGE)), ("dimension", optional_value(^dimension, "DimensionInfo")),
        ("measure", optional_value(None, "MeasureInfo")), ("exactness", optional_value(None, "ExactnessInfo")), ("layout", optional_value(None, "LayoutFact")),
        ("classification", optional_value(None, "ClassificationInfo")), ("nominal", optional_value(None, "NominalInfo")), ("obligation", optional_value(None, "ObligationInfo")),
        ("state", optional_value(None, "StateRef")), ("sendability", optional_value(None, "SendabilityInfo")), ("view_provenance", optional_value(None, "ViewProvenanceInfo")),
        ("movedness", optional_value(None, "MovednessInfo")), ("attribution", optional_value(None, "AttributionInfo")), ("origin", optional_value(None, "OriginInfo")),
        ("unit_scale_provenance", optional_value(None, "UnitScaleProvenanceInfo")), ("maturity", optional_value(None, "MaturityInfo"))])
}
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:643
fn fact_value_with_detail(kind: &String, name: &String, members: [String], detail: CtValue, detail_field: &String) -> CtValue {
    value := fact_value(kind, name, ^members, None, None)
    if value == { .Struct { fields, .. } -> {
        if entry := fields.iter_mut().find(fn((field_name, _)) { field_name == detail_field }) { entry.1 = CtValue.Present(^detail) }
    } else -> {} }
    ^value
}
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:662
fn fact_kind_for(plane: &String, fact: &KnowledgeFact) -> String {
    registered := Registry.row(plane).unwrap_or_else(fn() { jet_foundation.ice(None, "reflection found unregistered plane `{plane}`") })
    assert(registered.kind() == Registry.RowKind.Plane)
    kind := Registry.registered_fact_read(plane).and_then(Registry.FactRead.reflection_kind).unwrap_or_else(fn() { jet_foundation.ice(None, "reflection found unreadable plane `{plane}`") })
    produced := match fact { .Interval { .. } => "Range"; .Layout { .. } => "Layout"; .Measure(_) => "Measure"; .Exactness(_) => "Exactness"; .Dimension(_) => "Dimension"; .Classification(_) => "Classification"; .Nominal(_) => "Nominal"; .Obligation(_) => "Obligation" }
    assert(kind == produced, "fact producer disagrees with registered plane `{plane}`")
    kind
}
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:689
fn knowledge_fact_value(kind: &String, fact: &KnowledgeFact) -> CtValue {
    match fact {
        .Interval { lo, hi } => fact_value(kind, "range", [], reflected_range_info(lo, hi), None)
        .Dimension(dimension) => fact_value(kind, "dimension", [], None, Val(build_dimension_info(dimension)))
        .Measure(measure) => fact_value_with_detail(kind, "measure", [], measure_info(measure), "measure")
        .Exactness(exactness) => fact_value_with_detail(kind, "exactness", [], exactness_info(exactness), "exactness")
        .Layout { bytes } => fact_value_with_detail(kind, "layout", [], layout_fact_info(bytes), "layout")
        .Classification(name) => fact_value_with_detail(kind, "classification", [name.clone()], classification_info(name), "classification")
        .Nominal(name) => fact_value_with_detail(kind, "nominal", [name.clone()], nominal_info(name), "nominal")
        .Obligation(obligations) => fact_value_with_detail(kind, "obligation", [], obligation_info(obligations), "obligation")
    }
}
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:750
fn registered_fact_kind(name: &String) -> String? { Registry.reflection_kind(name) }
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:757
pub fn build_registered_fact_info(name: &String) -> CtValue? {
    row := Registry.row(name)?
    kind := registered_fact_kind(row.name)?
    value := fact_value(kind, row.name, [], None, None)
    path := if row.name == "Attribution" { "report.$attribution" } else { row.name.to_string() }
    Val(fact_info(kind, row.name, ^path, ^value))
}
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:769
pub fn build_registered_fact_infos() -> [CtValue] { Registry.fact_rows().filter_map(fn(row) { build_registered_fact_info(row.name) }).collect() }
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:775
fn fact_info(kind: &String, name: &String, path: String, value: CtValue) -> CtValue { ct_struct("FactInfo", &[("kind", typed_enum("FactKind", kind)), ("name", ct_str(name.to_string())), ("path", ct_str(^path)), ("value", ^value)]) }
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:787
fn reflected_struct_field(value: &CtValue, name: &String) -> &CtValue? {
    fields := match value { .Struct { fields, .. } => fields; _ => return None }
    fields.iter().find(fn((field, _)) { field == name }).map(fn((_, value)) { value })
}
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:797
fn reflected_fact_value_detail(value: &CtValue, read: Registry.FactRead) -> &CtValue? {
    expected := read.reflection_kind()?
    variant := match reflected_struct_field(value, "kind")? { .Enum { variant, .. } => variant; _ => return None }
    if variant != expected { return None }
    if match read { .RegisteredPlane(_) => true; _ => false } { return Val(value) }
    field := read.detail_field()?
    match reflected_struct_field(value, field)? { .Present(value) => Val(value.as_ref()); _ => None }
}
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:818
fn reflected_fact_info_detail(fact: &CtValue, read: Registry.FactRead) -> &CtValue? { reflected_fact_value_detail(reflected_struct_field(fact, "value")?, read) }
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:825
fn reflected_fact_list_detail(facts: &CtValue, read: Registry.FactRead) -> &CtValue? {
    facts := match facts { .List(facts) => facts; _ => return None }
    facts.iter().find_map(fn(fact) { reflected_fact_info_detail(fact, read) })
}
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:840
pub fn reflected_fact_field(value: &CtValue, read: Registry.FactRead) -> &CtValue? {
    type_name := match value { .Struct { type_name, .. } => type_name; _ => return None }
    match type_name {
        "FactInfo" => reflected_fact_info_detail(value, read)
        "FactValue" => reflected_fact_value_detail(value, read)
        "TypeInfo" => {
            facts := reflected_struct_field(value, "facts")
            match read {
                .States => reflected_struct_field(value, "states")
                .Dimension => facts.and_then(fn(facts) { reflected_fact_list_detail(facts, read) }).or_else(fn() {
                    dimensions := match reflected_struct_field(value, "dimensions")? { .List(dimensions) => dimensions; _ => return None }
                    dimensions.first()
                })
                _ => facts.and_then(fn(facts) { reflected_fact_list_detail(facts, read) })
            }
        }
        "FunctionInfo" | "MethodInfo" => match read { .Effects => reflected_struct_field(value, "effects"); _ => reflected_struct_field(value, "facts").and_then(fn(facts) { reflected_fact_list_detail(facts, read) }) }
        "FieldInfo" => match read {
            .Dimension => { dimensions := match reflected_struct_field(value, "dimensions")? { .List(dimensions) => dimensions; _ => return None }; dimensions.first() }
            _ => reflected_struct_field(value, "facts").and_then(fn(facts) { reflected_fact_list_detail(facts, read) })
        }
        _ => None
    }
}
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:888
fn declared_function_facts(path: &String, maturity: MaturityTag?, view_provenance: &ViewProvenanceMap?) -> [CtValue] {
    facts := [CtValue].new()
    for (kind, name, detail, value) in [("Sendability", "sendability", "sendability", build_sendability_info(true)), ("Movedness", "movedness", "movedness", build_movedness_info(false)), ("Origin", "origin", "origin", build_origin_info(false, None, None, None, false))] {
        facts.push(fact_info(kind, name, "{path}.${name}", fact_value_with_detail(kind, name, [], ^value, detail)))
    }
    facts.push(fact_info("Maturity", "maturity", "{path}.$maturity", fact_value_with_detail("Maturity", "maturity", [], build_maturity_info(maturity.unwrap_or(MaturityTag.Experimental)), "maturity")))
    view_rows := 0
    if view_provenance := view_provenance {
        slots := view_provenance.keys().collect()
        slots.sort()
        for slot in slots {
            provenance := view_provenance[slot]
            slot_name := if slot.is_empty() { "return" } else { slot.join(".") }
            view_rows += 1
            facts.push(fact_info("ViewProvenance", "view_provenance", "{path}.$view_provenance.{slot_name}", fact_value_with_detail("ViewProvenance", "view_provenance", [^slot_name], build_view_provenance_info(provenance), "view_provenance")))
        }
    }
    if view_rows == 0 {
        provenance := ViewProvenance { sources: Set.new(), mutable: false }
        facts.push(fact_info("ViewProvenance", "view_provenance", "{path}.$view_provenance.return", fact_value_with_detail("ViewProvenance", "view_provenance", ["return"], build_view_provenance_info(&provenance), "view_provenance")))
    }
    ^facts
}
