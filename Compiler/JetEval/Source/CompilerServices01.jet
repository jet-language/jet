// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:69
fn layout_field_info(name: String, ty: String, guarantee: &String, source: &String, target: &TargetLayout, facts: &FieldLayoutFacts?) -> CtValue {
    ct_struct(Syntax.TYPE_LAYOUT_FIELD, &[("name", ct_str(^name)), ("ty", ct_str(^ty)),
        ("offset", optional_layout_byte(facts.and_then(fn(facts) { facts.offset }))),
        ("size", optional_layout_byte(facts.and_then(fn(facts) { facts.size }))),
        ("target", ct_str(target.triple.clone())), ("guarantee", ct_str(guarantee.to_string())), ("source", ct_str(source.to_string()))])
}
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:97
fn layout_info(kind: &String, guarantee: &String, source: &String, target: &TargetLayout, fields: [(String, String)], facts: &LayoutFacts, alignment: &LayoutAlignmentFact?) -> CtValue {
    ct_struct(Syntax.TYPE_LAYOUT_INFO, &[("kind", ct_str(kind.to_string())),
        ("size", optional_layout_byte(facts.bytes.map(fn(bytes) { bytes.size }))),
        ("alignment", optional_layout_byte(facts.bytes.map(fn(bytes) { bytes.alignment }))),
        ("stride", optional_layout_byte(facts.bytes.map(fn(bytes) { bytes.stride }))),
        ("requested_alignment", optional_layout_byte(alignment.map(fn(fact) { fact.requested_alignment }))),
        ("effective_alignment", optional_layout_byte(alignment.map(fn(fact) { fact.effective_alignment }))),
        ("target", ct_str(target.triple.clone())), ("guarantee", ct_str(guarantee.to_string())), ("source", ct_str(source.to_string())),
        ("fields", ct_list(fields.into_iter().enumerate().map(fn((index, (name, ty))) { layout_field_info(^name, ^ty, guarantee, source, target, facts.fields.get(index)) }).collect()))])
}
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:156
fn optional_layout_byte(value: U64?) -> CtValue {
    value.and_then(fn(value) { I64.try_from(value).ok() }).map(fn(value) { CtValue.Present(CtValue.Int(value)) }).unwrap_or_else(fn() { CtValue.absent(Type.Int) })
}
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:163
fn layout_info_for_struct(s: &StructDef, engine: &TargetLayoutEngine) -> CtValue {
    (kind, guarantee) := match s.layout.as_ref() {
        Val(.C) => ("c", "repr(C) declaration")
        Val(.CAligned { alignment, target }) => ("c", if target { "repr(C, align(target, {alignment})) declaration" } else { "repr(C, align({alignment})) declaration" })
        Val(.Columnar) => ("columnar", "columnar storage declaration")
        None => ("default", "physical layout unspecified")
    }
    (facts, alignment) := match engine.checked_struct_facts(s) { Ok(checked) => (^checked.physical, ^checked.alignment); Err(_) => (engine.struct_facts(s), None) }
    fields := s.reflection_fields().map(fn(field) {
        name := CLISchema.shape_field_names(s, field).name_for(ShapeProjectionKind.Layout).expect("checked layout field is missing its Layout shape name").to_string()
        (^name, field.ty.name())
    }).collect()
    layout_info(kind, &guarantee, "struct declaration", engine.target(), ^fields, &facts, alignment.as_ref())
}
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:205
pub fn build_struct_layout_info(s: &StructDef) -> CtValue {
