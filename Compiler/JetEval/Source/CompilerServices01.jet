fn distinct_fact_rows(definition: &DistinctDef) -> [CtValue] {
    facts := [CtValue].new()
    if (start, end, _) := definition.range { facts.push(fact_info("Range", "range", "{definition.name}.$range", fact_value("Range", "range", [], Val(build_range_info(start, end)), None))) }
    if (dimension, kind) := definition.quantity { facts.push(fact_info("Dimension", "dimension", "{definition.name}.$dimension", fact_value("Dimension", "dimension", [kind.name().to_string()], None, Val(build_dimension_info(dimension))))) }
