// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:1641
pub fn reflect_type_value_with_target(items: &[Item], type_name: &String, module: &String, target: &TargetLayout) -> CtValue? { reflect_type_value_with_target_and_graph(items, type_name, module, target, None) }
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:1650
pub fn reflect_type_value_with_target_and_graph(items: &[Item], type_name: &String, module: &String, target: &TargetLayout, graph: &StateGraph?) -> CtValue? { reflect_type_value_with_target_and_graph_and_facts(items, type_name, module, target, graph, None) }
// Rust: crates/jet-comptime/src/Comptime/Reflect.rs:1665
pub fn reflect_type_value_with_target_and_graph_and_facts(items: &[Item], type_name: &String, module: &String, target: &TargetLayout, graph: &StateGraph?, facts: &FactRegistry?) -> CtValue? {
    module := if module.is_empty() { "main" } else { module }
    layout_engine := TargetLayoutEngine.new(items.iter(), target.clone())
    for item in items {
        match item {
            .Struct(def) if def.name == type_name => {
                states := match facts {
                    Val(facts) => facts.state_members(type_name).map_or_else(fn() { [] }, fn(states) { states.to_vec() })
                    None => def.state.as_ref().map(fn(state) { state.states.iter().map(fn((name, _)) { name.clone() }).collect() }).unwrap_or_default()
                }
                graph := graph.or_else(fn() { facts.and_then(fn(facts) { facts.state_graph("{def.name}.State") }) })
                info := build_struct_type_info_with_path_and_vocabulary_and_engine_and_graph(def, &states, "{module}.{type_name}", None, &layout_engine, graph)
                append_trait_contracts_from_items(&info, items, &def.name, module, "{module}::{type_name}")
                return Val(^info)
            }
            .Enum(def) if def.name == type_name => {
                path := "{module}.{type_name}"
                info := build_enum_type_info_with_engine(def, module, "{module}::{type_name}", &path, &layout_engine)
                append_trait_contracts_from_items(&info, items, &def.name, module, "{module}::{type_name}")
                return Val(^info)
            }
            .Distinct(def) if def.name == type_name => {
                info := build_distinct_type_info_with_path(def, module, "{module}.{type_name}")
                append_trait_contracts_from_items(&info, items, &def.name, module, "{module}::{type_name}")
                return Val(^info)
            }
            .UnitFamily(family) => {
                member := family.members.iter().find(fn(member) { UnitFamilyDef.type_name(&member.name) == type_name }) else { continue }
                if def := family.distinct_defs().into_iter().find(fn(def) { def.name == type_name }) {
                    info := build_distinct_type_info_with_path(&def, module, "{module}.{type_name}")
                    if info == { .Struct { fields, .. } -> {
                        if entry := fields.iter_mut().find(fn((name, _)) { name == "facts" }) {
                            if entry.1 == { .List(facts) -> {
                                path := "{module}.{type_name}.$unit_scale_provenance"
                                facts.push(fact_info("UnitScaleProvenance", "unit_scale_provenance", ^path, fact_value_with_detail("UnitScaleProvenance", "unit_scale_provenance", [], build_unit_scale_provenance_info(&member.scale_provenance), "unit_scale_provenance")))
                            } else -> {} }
                        }
                    } else -> {} }
                    append_trait_contracts_from_items(&info, items, &def.name, module, "{module}::{type_name}")
                    return Val(^info)
                }
            }
            _ => {}
        }
    }
    None
}
