fn jet_eval_shared_runtime_retain_shared_alias(machine: &JetEvalMachine, index: Int, span: Span) -> Bool {
    entry := jet_eval_shared_runtime_value(&machine, index) ?? return false
    metadata := entry.metadata
    loan_active := jet_eval_shared_runtime_entry_read_loan_active(&machine, JetEvalSharedHostKind.Shared, index)
    live := {
        permit := metadata.guard_read()
        (permit.value.references > 0 || loan_active) && !permit.value.dropped
    }
    if !live -> return false
    token_id :: jet_eval_shared_runtime_owner_alias_retain(&machine, index, span) ?? return false
    stored := {
        permit := metadata.guard_edit()
        if permit.value.dropped
            || permit.value.references < 0
            || permit.value.references != permit.value.owner_alias_tokens.len() {
            false
        } else {
            permit.value.references += 1
            permit.value.owner_alias_tokens.push(token_id)
            true
        }
    }
    if !stored {
        jet_eval_shared_runtime_owner_alias_release(&machine, index, token_id, span)
        jet_eval_ownership_fail(&machine, span, "MIR Shared carrier was retained after release")
    }
    stored
}

fn jet_eval_shared_runtime_retain(machine: &JetEvalMachine, value: JetEvalRuntimeValue, span: Span) -> Bool {
    if value == {
        .Shared(index) -> return jet_eval_shared_runtime_retain_shared_alias(&machine, index, span)
        .SharedGuard(_) -> {
            jet_eval_ownership_fail(&machine, span, "MIR SharedGuard values are move-only")
            return false
        }
        .SharedSnapshot(index) -> {
            entry :: jet_eval_shared_runtime_snapshot(&machine, index) ?? {
                jet_eval_ownership_fail(&machine, span, "MIR SharedSnapshot carrier has an unknown registry identity")
                return false
            }
            metadata := entry.metadata
            loan_active := jet_eval_shared_runtime_entry_read_loan_active(&machine, JetEvalSharedHostKind.Snapshot, index)
            retained := {
                permit := metadata.guard_edit()
                if permit.value.dropped || (permit.value.references <= 0 && !loan_active) -> false
                else {
                    permit.value.references += 1
                    true
                }
            }
            if !retained -> jet_eval_ownership_fail(&machine, span, "MIR SharedSnapshot carrier was retained after release")
            return retained
        }
        .Condition(index) -> {
            entry :: jet_eval_shared_runtime_condition(&machine, index) ?? {
                jet_eval_ownership_fail(&machine, span, "MIR Condition carrier has an unknown registry identity")
                return false
            }
            metadata := entry.metadata
            loan_active := jet_eval_shared_runtime_entry_read_loan_active(&machine, JetEvalSharedHostKind.Condition, index)
            retained := {
                permit := metadata.guard_edit()
                if permit.value.dropped || (permit.value.references <= 0 && !loan_active) -> false
                else {
                    permit.value.references += 1
                    true
                }
            }
            if !retained -> jet_eval_ownership_fail(&machine, span, "MIR Condition carrier was retained after release")
            return retained
        }
        .SharedWeak(index) -> {
            entry :: jet_eval_shared_runtime_weak(&machine, index) ?? {
                jet_eval_ownership_fail(&machine, span, "MIR Shared.Weak carrier has an unknown registry identity")
                return false
            }
            metadata := entry.metadata
            loan_active := jet_eval_shared_runtime_entry_read_loan_active(&machine, JetEvalSharedHostKind.Weak, index)
            retained := {
                permit := metadata.guard_edit()
                if permit.value.dropped || (permit.value.references <= 0 && !loan_active) -> false
                else {
                    permit.value.references += 1
                    true
                }
            }
            if !retained -> jet_eval_ownership_fail(&machine, span, "MIR Shared.Weak carrier was retained after release")
            return retained
        }
        else -> {
            jet_eval_compiler_fail(&machine, span, "MIR Shared retain received a non-Shared carrier")
            return false
        }
    }
}

fn jet_eval_shared_runtime_live(machine: &JetEvalMachine, value: JetEvalRuntimeValue, span: Span) -> Bool {
    if value == {
        .Shared(index) -> return jet_eval_shared_runtime_value_live(&machine, index, span)
        .SharedGuard(index) -> return jet_eval_shared_runtime_guard_live(&machine, index, span)
        .SharedSnapshot(index) -> return jet_eval_shared_runtime_snapshot_live(&machine, index, span)
        .Condition(index) -> return jet_eval_shared_runtime_condition_live(&machine, index, span)
        .SharedWeak(index) -> return jet_eval_shared_runtime_weak_live(&machine, index, span)
        else -> {
            jet_eval_compiler_fail(&machine, span, "MIR Shared liveness check received a non-Shared carrier")
            return false
        }
    }
}

fn jet_eval_shared_runtime_transferable(machine: &JetEvalMachine, value: JetEvalRuntimeValue, span: Span) -> Bool {
    if value == {
        .SharedGuard(_) -> {
            jet_eval_ownership_fail(&machine, span, "MIR SharedGuard cannot cross a task or native callback boundary")
            return false
        }
        .Shared(_) | .SharedSnapshot(_) | .Condition(_) | .SharedWeak(_) -> return jet_eval_shared_runtime_live(&machine, value, span)
        else -> {
            jet_eval_compiler_fail(&machine, span, "MIR Shared transfer check received a non-Shared carrier")
            return false
        }
    }
}

fn jet_eval_shared_runtime_host_guard_element_type(ty: ?MirType) -> ?MirType {
    ty_value :: ty ?? return None
    if ty_value.kind == {
        .Tagged(_, inner) -> return jet_eval_shared_runtime_host_guard_element_type(Val(inner))
        .Apply(name, args) -> {
            if (name.name != "SharedGuard" && !name.name.ends_with("::SharedGuard")) || args.len() != 1 -> return None
            return Val(args[0])
        }
        else -> return None
    }
}

fn jet_eval_shared_runtime_host_kind_matches(kind: JetEvalSharedHostKind, ty: ?MirType) -> Bool {
    if ty == None -> return true
    ty_value :: ty ?? return false
    if kind == {
        .Shared -> return ty_value.kind == {.Shared(_) -> true else -> false}
        .Snapshot -> {
            if ty_value.kind == {.Apply(name, _) -> return name.name == "SharedSnapshot"}
            return false
        }
        .Condition -> {
            if ty_value.kind == {.Apply(name, _) -> return name.name == "Condition"}
            return false
        }
        .Weak -> {
            if ty_value.kind == {.Apply(name, _) -> return name.name == "Shared.Weak" || name.name == "WeakShared"}
            return false
        }
        .Guard -> return jet_eval_shared_runtime_host_guard_element_type(Val(ty_value)) != None
    }
}

fn jet_eval_shared_runtime_host_payload_type(machine: &JetEvalMachine, kind: JetEvalSharedHostKind, index: Int) -> ?MirType {
    if kind == {
        .Shared -> {
            root :: jet_eval_shared_runtime_value(&machine, index) ?? return None
            return Val(root.metadata.guard_read().value.element_type)
        }
        .Snapshot -> {
            snapshot :: jet_eval_shared_runtime_snapshot(&machine, index) ?? return None
            owner_index := snapshot.metadata.guard_read().value.owner
            root :: jet_eval_shared_runtime_value(&machine, owner_index) ?? return None
            return Val(root.metadata.guard_read().value.element_type)
        }
        .Condition -> return Val(mir_type_from_kind(MirTypeKind.Unit))
        .Weak -> {
            weak :: jet_eval_shared_runtime_weak(&machine, index) ?? return None
            return Val(weak.metadata.guard_read().value.element_type)
        }
        .Guard -> {
            guard :: jet_eval_shared_runtime_guard(&machine, index) ?? return None
            shared_index := guard.metadata.guard_read().value.lease.metadata.guard_read().value.shared
            root :: jet_eval_shared_runtime_value(&machine, shared_index) ?? return None
            return Val(root.metadata.guard_read().value.element_type)
        }
    }
}

fn jet_eval_shared_runtime_host_payload_shape(machine: &JetEvalMachine, kind: JetEvalSharedHostKind, index: Int, span: Span) -> ?JetEvalHostTypeShape {
    payload_type :: jet_eval_shared_runtime_host_payload_type(&machine, kind, index) ?? {
        jet_eval_ownership_fail(&machine, span, "MIR Shared host carrier has no checked payload type")
        return None
    }
    jet_eval_host_type_shape(&machine, Val(payload_type), span)
}


pub fn jet_eval_shared_runtime_payload_finalizer(machine: &JetEvalMachine, owner_index: Int, span: Span) -> ?JetEvalSharedPayloadFinalizer {
    entry :: jet_eval_shared_runtime_value(&machine, owner_index) ?? {
        jet_eval_ownership_fail(&machine, span, "Shared payload finalizer names an unknown Source root")
        return None
    }
    metadata := entry.metadata.guard_read().value
    if metadata.dropped || metadata.origin != JetEvalSharedHostOrigin.Source {
        jet_eval_ownership_fail(&machine, span, "Shared payload finalizer requires a live Source root")
        return None
    }
    owned_root := jet_eval_owned_root(&machine)
    Val(JetEvalSharedPayloadFinalizer{
        owned_root: owned_root,
        span: span,
    })
}
fn jet_eval_shared_runtime_host_projection(machine: &JetEvalMachine, value: JetEvalRuntimeValue, span: Span) -> ?JetEvalHostValue {
    kind :: if value == {
        .Shared(index) -> {
            if !jet_eval_shared_runtime_value_live(&machine, index, span) -> return None
            root :: jet_eval_shared_runtime_value(&machine, index) ?? return None
            if root.metadata.guard_read().value.physical_root == None {
                jet_eval_ownership_fail(&machine, span, "MIR Shared carrier has no physical root capability")
                return None
            }
            JetEvalSharedHostKind.Shared
        }
        .SharedSnapshot(index) -> {
            if !jet_eval_shared_runtime_snapshot_live(&machine, index, span) -> return None
            snapshot :: jet_eval_shared_runtime_snapshot(&machine, index) ?? return None
            if snapshot.metadata.guard_read().value.owner_root == None {
                jet_eval_ownership_fail(&machine, span, "MIR SharedSnapshot carrier has no physical owner capability")
                return None
            }
            JetEvalSharedHostKind.Snapshot
        }
        .Condition(index) -> {
            if !jet_eval_shared_runtime_condition_live(&machine, index, span) -> return None
            condition :: jet_eval_shared_runtime_condition(&machine, index) ?? return None
            if condition.metadata.guard_read().value.physical_root == None {
                jet_eval_ownership_fail(&machine, span, "MIR Condition carrier has no physical root capability")
                return None
            }
            JetEvalSharedHostKind.Condition
        }
        .SharedWeak(index) -> {
            if !jet_eval_shared_runtime_weak_live(&machine, index, span) -> return None
            weak :: jet_eval_shared_runtime_weak(&machine, index) ?? return None
            if weak.metadata.guard_read().value.physical_root == None {
                jet_eval_ownership_fail(&machine, span, "MIR Shared.Weak carrier has no physical weak capability")
                return None
            }
            JetEvalSharedHostKind.Weak
        }
        .SharedGuard(_) -> {
            jet_eval_ownership_fail(&machine, span, "MIR SharedGuard cannot be projected to a native host value")
            return None
        }
        else -> {
            jet_eval_compiler_fail(&machine, span, "MIR Shared host projection received a non-Shared carrier")
            return None
        }
    }
    index := if value == {
        .Shared(id) | .SharedSnapshot(id) | .Condition(id) | .SharedWeak(id) -> id
        else -> -1
    }
    physical := if kind == {
        .Shared -> {
            entry :: jet_eval_shared_runtime_value(&machine, index) ?? return None
            JetEvalSharedHostPhysicalRoot.Shared(entry)
        }
        .Snapshot -> {
            entry :: jet_eval_shared_runtime_snapshot(&machine, index) ?? return None
            JetEvalSharedHostPhysicalRoot.Snapshot(entry)
        }
        .Condition -> {
            entry :: jet_eval_shared_runtime_condition(&machine, index) ?? return None
            JetEvalSharedHostPhysicalRoot.Condition(entry)
        }
        .Weak -> {
            entry :: jet_eval_shared_runtime_weak(&machine, index) ?? return None
            JetEvalSharedHostPhysicalRoot.Weak(entry)
        }
        .Guard -> {
            jet_eval_compiler_fail(&machine, span, "MIR SharedGuard cannot be projected as a user host value")
            return None
        }
    }
    origin := if kind == {
        .Shared -> {
            root :: jet_eval_shared_runtime_value(&machine, index) ?? return None
            root.metadata.guard_read().value.origin
        }
        .Snapshot -> {
            root :: jet_eval_shared_runtime_snapshot(&machine, index) ?? return None
            root.metadata.guard_read().value.origin
        }
        .Condition -> {
            root :: jet_eval_shared_runtime_condition(&machine, index) ?? return None
            root.metadata.guard_read().value.origin
        }
        .Weak -> {
            root :: jet_eval_shared_runtime_weak(&machine, index) ?? return None
            root.metadata.guard_read().value.origin
        }
        .Guard -> {
            jet_eval_compiler_fail(&machine, span, "MIR SharedGuard has no user host projection")
            return None
        }
    }
    payload_shape :: jet_eval_shared_runtime_host_payload_shape(&machine, kind, index, span) ?? return None
    runtime := machine.registry.shared_runtime
    Val(JetEvalHostValue.SharedCarrier(JetEvalSharedHostCarrier{
        kind: kind,
        index: Val(index),
        registry: runtime,
        origin: origin,
        physical: physical,
        payload_finalizer: None,
        payload_shape: payload_shape,
        owner_alias_token: None,
        owner_alias_token_pre_adopted: false,
        owns_root_capability: false,
    }))
}
fn jet_eval_shared_runtime_host_physical_carrier(machine: &JetEvalMachine, value: JetEvalRuntimeValue, span: Span) -> ?JetEvalSharedHostCarrier {
    kind :: if value == {
        .Shared(_) -> JetEvalSharedHostKind.Shared
        .SharedSnapshot(_) -> JetEvalSharedHostKind.Snapshot
        .Condition(_) -> JetEvalSharedHostKind.Condition
        .SharedWeak(_) -> JetEvalSharedHostKind.Weak
        .SharedGuard(_) -> JetEvalSharedHostKind.Guard
        else -> {
            jet_eval_compiler_fail(&machine, span, "MIR Shared physical argument is not a Shared root or guard")
            return None
        }
    }
    index := if value == {
        .Shared(id) | .SharedSnapshot(id) | .Condition(id) | .SharedWeak(id) | .SharedGuard(id) -> id
        else -> -1
    }
    physical := if kind == {
        .Shared -> JetEvalSharedHostPhysicalRoot.Shared(jet_eval_shared_runtime_value(&machine, index) ?? return None)
        .Snapshot -> JetEvalSharedHostPhysicalRoot.Snapshot(jet_eval_shared_runtime_snapshot(&machine, index) ?? return None)
        .Condition -> JetEvalSharedHostPhysicalRoot.Condition(jet_eval_shared_runtime_condition(&machine, index) ?? return None)
        .Weak -> JetEvalSharedHostPhysicalRoot.Weak(jet_eval_shared_runtime_weak(&machine, index) ?? return None)
        .Guard -> JetEvalSharedHostPhysicalRoot.Guard(jet_eval_shared_runtime_guard(&machine, index) ?? return None)
    }
    origin := if kind == {
        .Shared -> {
            root :: jet_eval_shared_runtime_value(&machine, index) ?? return None
            root.metadata.guard_read().value.origin
        }
        .Snapshot -> {
            root :: jet_eval_shared_runtime_snapshot(&machine, index) ?? return None
            root.metadata.guard_read().value.origin
        }
        .Condition -> {
            root :: jet_eval_shared_runtime_condition(&machine, index) ?? return None
            root.metadata.guard_read().value.origin
        }
        .Weak -> {
            root :: jet_eval_shared_runtime_weak(&machine, index) ?? return None
            root.metadata.guard_read().value.origin
        }
        .Guard -> {
            guard :: jet_eval_shared_runtime_guard(&machine, index) ?? return None
            shared := guard.metadata.guard_read().value.lease.metadata.guard_read().value.shared
            root :: jet_eval_shared_runtime_value(&machine, shared) ?? return None
            root.metadata.guard_read().value.origin
        }
    }
    payload_shape :: jet_eval_shared_runtime_host_payload_shape(&machine, kind, index, span) ?? return None
    Val(JetEvalSharedHostCarrier{
        kind: kind,
        index: Val(index),
        registry: machine.registry.shared_runtime,
        origin: origin,
        physical: physical,
        payload_finalizer: None,
        payload_shape: payload_shape,
        owner_alias_token: None,
        owner_alias_token_pre_adopted: false,
        owns_root_capability: false,
    })
}
pub fn jet_eval_shared_runtime_host_set_root_capability(carrier: JetEvalSharedHostCarrier, capability: JetEvalSharedHostRootCapability) -> Bool {
    if carrier.kind == JetEvalSharedHostKind.Shared {
        if carrier.physical == {
            .Shared(entry) -> {
                metadata := entry.metadata
                permit := metadata.guard_edit()
                if permit.value.physical_root != None
                    && !jet_eval_shared_runtime_same_root_capability(permit.value.physical_root, Val(capability)) -> return false
                permit.value.physical_root = Val(capability)
                return true
            }
            else -> return false
        }
    }
    if carrier.kind == JetEvalSharedHostKind.Condition {
        if carrier.physical == {
            .Condition(entry) -> {
                metadata := entry.metadata
                permit := metadata.guard_edit()
                if permit.value.physical_root != None
                    && !jet_eval_shared_runtime_same_root_capability(permit.value.physical_root, Val(capability)) -> return false
                permit.value.physical_root = Val(capability)
                return true
            }
            else -> return false
        }
    }
    false
}

pub fn jet_eval_shared_runtime_host_set_owner_alias_token(carrier: JetEvalSharedHostCarrier, token_id: Int) -> Bool {
    if carrier.kind != JetEvalSharedHostKind.Shared -> return false
    if carrier.physical == {
        .Shared(entry) -> {
            metadata := entry.metadata
            permit := metadata.guard_edit()
            if permit.value.dropped || permit.value.references != 1
                || permit.value.physical_root == None
                || permit.value.owner_alias_tokens.len() != 0
                || permit.value.pending_owner_alias_transfers.len() != 0 -> return false
            permit.value.owner_alias_tokens.push(token_id)
            return true
        }
        else -> return false
    }
    false
}

pub fn jet_eval_shared_runtime_owner_alias_transfer_stage(
    machine: &JetEvalMachine,
    root_index: Int,
    token_id: Int,
    capability: JetEvalSharedHostRootCapability,
    span: Span,
) -> Bool {
    entry :: jet_eval_shared_runtime_value(&machine, root_index) ?? {
        jet_eval_ownership_fail(&machine, span, "Shared owner transfer names an unknown Source root")
        return false
    }
    metadata := entry.metadata
    staged := {
        permit := metadata.guard_edit()
        if permit.value.dropped
            || permit.value.references <= 0
            || permit.value.references != permit.value.owner_alias_tokens.len()
            || !jet_eval_shared_runtime_same_root_capability(permit.value.physical_root, Val(capability)) {
            false
        } else {
            active_count := 0
            pending_count := 0
            loop existing in permit.value.owner_alias_tokens {
                if existing == token_id -> active_count += 1
            }
            loop existing in permit.value.pending_owner_alias_transfers {
                if existing == token_id -> pending_count += 1
            }
            if active_count != 1 || pending_count != 0 -> false
            else {
                permit.value.pending_owner_alias_transfers.push(token_id)
                true
            }
        }
    }
    if !staged -> jet_eval_ownership_fail(&machine, span, "Shared owner transfer cannot stage an alias from a different or already-staged physical root")
    staged
}

pub fn jet_eval_shared_runtime_owner_alias_transfer_commit(
    machine: &JetEvalMachine,
    root_index: Int,
    token_id: Int,
    capability: JetEvalSharedHostRootCapability,
    span: Span,
) -> ?JetEvalHostValue {
    entry :: jet_eval_shared_runtime_value(&machine, root_index) ?? {
        jet_eval_ownership_fail(&machine, span, "Shared owner transfer names an unknown Source root")
        return None
    }
    metadata := entry.metadata
    // Prepare the return carrier before consuming the staged alias: type-shape derivation can fail, so nothing may fail after alias mutation.
    payload_shape :: jet_eval_shared_runtime_host_payload_shape(&machine, JetEvalSharedHostKind.Shared, root_index, span) ?? return None
    origin := metadata.guard_read().value.origin
    prepared_carrier := JetEvalSharedHostCarrier{
        kind: JetEvalSharedHostKind.Shared,
        index: Val(root_index),
        registry: machine.registry.shared_runtime,
        origin: origin,
        physical: JetEvalSharedHostPhysicalRoot.Shared(entry),
        payload_finalizer: None,
        payload_shape: payload_shape,
        owner_alias_token: Val(token_id),
        owner_alias_token_pre_adopted: true,
        owns_root_capability: true,
    }
    prepared_value := JetEvalHostValue.SharedCarrier(prepared_carrier)
    committed := {
        permit := metadata.guard_edit()
        if permit.value.dropped
            || permit.value.references <= 0
            || permit.value.references != permit.value.owner_alias_tokens.len()
            || !jet_eval_shared_runtime_same_root_capability(permit.value.physical_root, Val(capability)) {
            false
        } else {
            active_index := -1
            active_count := 0
            pending_index := -1
            pending_count := 0
            loop index in 0..<permit.value.owner_alias_tokens.len() {
                if permit.value.owner_alias_tokens[index] == token_id {
                    active_index = index
                    active_count += 1
                }
            }
            loop index in 0..<permit.value.pending_owner_alias_transfers.len() {
                if permit.value.pending_owner_alias_transfers[index] == token_id {
                    pending_index = index
                    pending_count += 1
                }
            }
            if active_count != 1 || pending_count != 1 -> false
            else {
                permit.value.owner_alias_tokens.remove(active_index)
                permit.value.pending_owner_alias_transfers.remove(pending_index)
                permit.value.references -= 1
                true
            }
        }
    }
    if !committed -> {
        jet_eval_ownership_fail(&machine, span, "Shared owner transfer does not match one staged alias of its exact physical root")
        return None
    }
    Val(prepared_value)
}

pub fn jet_eval_shared_runtime_owner_alias_transfer_dispose(
    machine: &JetEvalMachine,
    root_index: Int,
    token_id: Int,
    capability: JetEvalSharedHostRootCapability,
    span: Span,
) -> Bool {
    entry :: jet_eval_shared_runtime_value(&machine, root_index) ?? {
        jet_eval_ownership_fail(&machine, span, "Shared owner transfer disposal names an unknown Source root")
        return false
    }
    metadata := entry.metadata
    disposed := {
        permit := metadata.guard_edit()
        if permit.value.dropped
            || permit.value.references <= 0
            || permit.value.references != permit.value.owner_alias_tokens.len()
            || !jet_eval_shared_runtime_same_root_capability(permit.value.physical_root, Val(capability)) {
            false
        } else {
            active_count := 0
            pending_index := -1
            pending_count := 0
            loop existing in permit.value.owner_alias_tokens {
                if existing == token_id -> active_count += 1
            }
            loop index in 0..<permit.value.pending_owner_alias_transfers.len() {
                if permit.value.pending_owner_alias_transfers[index] == token_id {
                    pending_index = index
                    pending_count += 1
                }
            }
            if active_count != 1 || pending_count != 1 -> false
            else {
                permit.value.pending_owner_alias_transfers.remove(pending_index)
                true
            }
        }
    }
    if !disposed -> jet_eval_ownership_fail(&machine, span, "Shared owner transfer disposal does not match one staged alias of its exact physical root")
    disposed
}

pub fn jet_eval_shared_runtime_host_set_weak_capability(carrier: JetEvalSharedHostCarrier, capability: JetEvalSharedHostWeakCapability) -> Bool {
    if carrier.kind != JetEvalSharedHostKind.Weak -> return false
    if carrier.physical == {
        .Weak(entry) -> {
            metadata := entry.metadata
            permit := metadata.guard_edit()
            if permit.value.physical_root == {
                Val(previous) -> {
                    if previous.handle != capability.handle || previous.raw != capability.raw
                        || previous.generation != capability.generation
                        || previous.type_identity != capability.type_identity
                        || previous.physical_identity != capability.physical_identity -> return false
                }
                None -> {}
            }
            permit.value.physical_root = Val(capability)
            return true
        }
        else -> return false
    }
    false
}

// Construct a foreign owner carrier without creating a Source registry alias.
// The checked guest program is needed to select the physical operation row;
// the receiving evaluator adopts the carrier into its own live registry.
pub fn jet_eval_shared_runtime_host_carrier_from_root(
    program: &MirProgram,
    checked_shared_type: MirType,
    capability: JetEvalSharedHostRootCapability,
    owner_alias_token: ?Int,
    payload_shape: JetEvalHostTypeShape,
) -> ?JetEvalHostValue {
    element_type :: if checked_shared_type.kind == {
        .Shared(inner) -> Val(inner)
        else -> None
    } ?? return None
    create_row := None
    loop candidate in program.prelude_calls {
        if candidate.module_name == "core.host"
            && candidate.member == "Shared.get"
            && jet_eval_shared_runtime_host_row_valid(candidate) {
            create_row = Val(candidate)
            break
        }
    }
    row :: create_row ?? return None
    entry := JetEvalSharedValue{
        storage: shared JetEvalSharedValueData{value: JetEvalRuntimeValue.Moved},
        metadata: shared JetEvalSharedValueMeta{
            references: 0,
            dropped: false,
            revision: 0,
            create_row: row,
            element_type: element_type,
            origin: JetEvalSharedHostOrigin.Native,
            physical_root: Val(capability),
            owner_alias_tokens: [Int]{},
            pending_owner_alias_transfers: [Int]{},
        },
    }
    carrier := JetEvalSharedHostCarrier{
        kind: JetEvalSharedHostKind.Shared,
        index: None,
        registry: jet_eval_shared_runtime_new(),
        origin: JetEvalSharedHostOrigin.Native,
        physical: JetEvalSharedHostPhysicalRoot.Shared(entry),
        payload_finalizer: None,
        payload_shape: payload_shape,
        owner_alias_token: owner_alias_token,
        owner_alias_token_pre_adopted: owner_alias_token != None,
        owns_root_capability: true,
    }
    Val(JetEvalHostValue.SharedCarrier(carrier))
}


fn jet_eval_shared_runtime_physical_host_argument(machine: &JetEvalMachine, value: JetEvalRuntimeValue, install_payload_finalizer: Bool, span: Span) -> ?JetEvalHostArgument {
    host := if value == {
        .Shared(_) | .SharedSnapshot(_) | .Condition(_) | .SharedWeak(_) | .SharedGuard(_) -> {
            carrier :: jet_eval_shared_runtime_host_physical_carrier(&machine, value, span) ?? return None
            JetEvalHostValue.SharedCarrier(carrier)
        }
        else -> jet_eval_host_projection(&machine, value, span) ?? return None
    }
    if install_payload_finalizer {
        carrier :: if host == {.SharedCarrier(value) -> Val(value) else -> None} ?? {
            jet_eval_compiler_fail(&machine, span, "MIR Shared creation has no physical carrier for its canonical payload")
            return None
        }
        if carrier.kind != JetEvalSharedHostKind.Shared || carrier.origin != JetEvalSharedHostOrigin.Source {
            jet_eval_compiler_fail(&machine, span, "MIR Shared payload finalizer can only attach to a Source-owned Shared creation")
            return None
        }
        owner_index :: carrier.index ?? {
            jet_eval_ownership_fail(&machine, span, "Source Shared creation carrier has no local root identity")
            return None
        }
        finalizer :: jet_eval_shared_runtime_payload_finalizer(&machine, owner_index, span) ?? return None
        carrier.payload_finalizer = Val(finalizer)
        host = JetEvalHostValue.SharedCarrier(carrier)
    }
    Val(JetEvalHostArgument{value: value, host: host, moved: false})
}

struct JetEvalSharedHostAdoptPreflightFailure {
    message: String
    ownership: Bool
}

fn jet_eval_shared_runtime_host_guard_entry_loan_preflight_failure(
    carrier: JetEvalSharedHostCarrier,
    result_ty: ?MirType,
) -> ?JetEvalSharedHostAdoptPreflightFailure {
    element_type :: jet_eval_shared_runtime_host_guard_element_type(result_ty) ?? {
        return Val(JetEvalSharedHostAdoptPreflightFailure{
            message: "native SharedGuard carrier does not match its checked result type",
            ownership: false,
        })
    }
    if carrier.kind != JetEvalSharedHostKind.Guard {
        return Val(JetEvalSharedHostAdoptPreflightFailure{
            message: "native SharedGuard carrier kind disagrees with its physical view",
            ownership: false,
        })
    }
    if carrier.owner_alias_token != None || carrier.owner_alias_token_pre_adopted
        || carrier.owns_root_capability || carrier.payload_finalizer != None {
        return Val(JetEvalSharedHostAdoptPreflightFailure{
            message: "native SharedGuard carrier cannot transfer a Shared owner alias or root capability",
            ownership: false,
        })
    }
    if carrier.physical == {
        .Guard(entry) -> {
            guard := entry.metadata.guard_read().value
            if guard.dropped || guard.references <= 0 || !guard.active {
                return Val(JetEvalSharedHostAdoptPreflightFailure{
                    message: "native SharedGuard view is no longer live",
                    ownership: true,
                })
            }
            selector :: guard.physical_borrow_selector ?? {
                return Val(JetEvalSharedHostAdoptPreflightFailure{
                    message: "native SharedGuard has no active physical-borrow selector",
                    ownership: false,
                })
            }
            if selector < 0 {
                return Val(JetEvalSharedHostAdoptPreflightFailure{
                    message: "native SharedGuard physical-borrow selector is invalid",
                    ownership: false,
                })
            }
            lease := guard.lease.metadata.guard_read().value
            if lease.released || lease.handles <= 0
                || guard.owner_row.id != lease.owner_row.id
                || (guard.editable && !lease.editable) {
                return Val(JetEvalSharedHostAdoptPreflightFailure{
                    message: "native SharedGuard lease metadata is inconsistent",
                    ownership: true,
                })
            }
            root :: jet_eval_shared_runtime_value_from_registry(carrier.registry, lease.shared) ?? {
                return Val(JetEvalSharedHostAdoptPreflightFailure{
                    message: "native SharedGuard refers to an unknown root in its source registry",
                    ownership: true,
                })
            }
            root_metadata := root.metadata.guard_read().value
            if root_metadata.origin != carrier.origin {
                return Val(JetEvalSharedHostAdoptPreflightFailure{
                    message: "native SharedGuard origin disagrees with its physical root",
                    ownership: false,
                })
            }
            if root_metadata.physical_root == None {
                return Val(JetEvalSharedHostAdoptPreflightFailure{
                    message: "native SharedGuard root has no generation-bearing physical capability",
                    ownership: false,
                })
            }
            if root_metadata.dropped || root_metadata.references <= 0
                || root_metadata.references != root_metadata.owner_alias_tokens.len() {
                return Val(JetEvalSharedHostAdoptPreflightFailure{
                    message: "native SharedGuard root has inconsistent Source owner-alias metadata",
                    ownership: true,
                })
            }
            if !mir_type_same_checked_type(element_type, root_metadata.element_type) {
                return Val(JetEvalSharedHostAdoptPreflightFailure{
                    message: "native SharedGuard element type disagrees with its checked carrier type",
                    ownership: false,
                })
            }
            return None
        }
        else -> return Val(JetEvalSharedHostAdoptPreflightFailure{
            message: "native SharedGuard carrier has no physical permit view",
            ownership: false,
        })
    }
    None
}

fn jet_eval_shared_runtime_host_entry_loan_preflight_failure(
    carrier: JetEvalSharedHostCarrier,
    result_ty: ?MirType,
) -> ?JetEvalSharedHostAdoptPreflightFailure {
    if carrier.kind == JetEvalSharedHostKind.Guard {
        return jet_eval_shared_runtime_host_guard_entry_loan_preflight_failure(carrier, result_ty)
    }
    jet_eval_shared_runtime_host_adopt_preflight_failure(carrier, result_ty)
}
fn jet_eval_shared_runtime_host_adopt_preflight_failure(
    carrier: JetEvalSharedHostCarrier,
    result_ty: ?MirType,
) -> ?JetEvalSharedHostAdoptPreflightFailure {
    if !jet_eval_shared_runtime_host_kind_matches(carrier.kind, result_ty) {
        return Val(JetEvalSharedHostAdoptPreflightFailure{
            message: "native Shared carrier does not match its checked result type",
            ownership: false,
        })
    }
    if carrier.physical == {
        .Shared(entry) -> {
            if carrier.kind != JetEvalSharedHostKind.Shared {
                return Val(JetEvalSharedHostAdoptPreflightFailure{
                    message: "native Shared carrier kind disagrees with its physical root",
                    ownership: false,
                })
            }
            metadata := entry.metadata.guard_read().value
            if metadata.origin != carrier.origin {
                return Val(JetEvalSharedHostAdoptPreflightFailure{
                    message: "native Shared carrier origin disagrees with its physical root",
                    ownership: false,
                })
            }
            if metadata.physical_root == None {
                return Val(JetEvalSharedHostAdoptPreflightFailure{
                    message: "native Shared carrier has no generation-bearing physical root capability",
                    ownership: false,
                })
            }
            if result_ty == {
                Val(ty) -> if ty.kind == {
                    .Shared(element) -> if !mir_type_same_checked_type(element, metadata.element_type) {
                        return Val(JetEvalSharedHostAdoptPreflightFailure{
                            message: "native Shared root element type disagrees with its checked carrier type",
                            ownership: false,
                        })
                    }
                    else -> {}
                }
                None -> {}
            }
            if metadata.dropped || metadata.references < 0
                || metadata.references != metadata.owner_alias_tokens.len() {
                return Val(JetEvalSharedHostAdoptPreflightFailure{
                    message: "native Shared root has inconsistent Source owner-alias metadata",
                    ownership: true,
                })
            }
            if carrier.owner_alias_token == {
                Val(token) -> {
                    if token < 0 {
                        return Val(JetEvalSharedHostAdoptPreflightFailure{
                            message: "native Shared owner alias token is invalid",
                            ownership: true,
                        })
                    }
                    found := false
                    loop existing in metadata.owner_alias_tokens {
                        if existing == token -> found = true
                    }
                    loop existing in metadata.pending_owner_alias_transfers {
                        if existing == token -> found = true
                    }
                    if found {
                        message := if carrier.owner_alias_token_pre_adopted
                            -> "pre-adopted Shared owner token is still registered in its source root"
                            else -> "native Shared owner alias token is already registered in this Source root"
                        return Val(JetEvalSharedHostAdoptPreflightFailure{
                            message: message,
                            ownership: true,
                        })
                    }
                }
                None -> if carrier.owner_alias_token_pre_adopted {
                    return Val(JetEvalSharedHostAdoptPreflightFailure{
                        message: "pre-adopted Shared carrier has no owner alias token",
                        ownership: false,
                    })
                }
            }
            return None
        }
        .Snapshot(entry) -> {
            if carrier.kind != JetEvalSharedHostKind.Snapshot {
                return Val(JetEvalSharedHostAdoptPreflightFailure{
                    message: "native SharedSnapshot carrier kind disagrees with its physical root",
                    ownership: false,
                })
            }
            metadata := entry.metadata.guard_read().value
            if metadata.dropped || !metadata.valid || metadata.consumed {
                return Val(JetEvalSharedHostAdoptPreflightFailure{
                    message: "native SharedSnapshot entry carrier has no live physical owner",
                    ownership: true,
                })
            }
            if metadata.origin != carrier.origin {
                return Val(JetEvalSharedHostAdoptPreflightFailure{
                    message: "native SharedSnapshot origin disagrees with its physical root",
                    ownership: false,
                })
            }
            if metadata.owner_root == None {
                return Val(JetEvalSharedHostAdoptPreflightFailure{
                    message: "native SharedSnapshot carrier has no physical owner capability",
                    ownership: false,
                })
            }
            if !jet_eval_shared_runtime_ref_retain(metadata.references, metadata.dropped) {
                return Val(JetEvalSharedHostAdoptPreflightFailure{
                    message: "native SharedSnapshot root was released before Source adoption",
                    ownership: true,
                })
            }
            return None
        }
        .Condition(entry) -> {
            if carrier.kind != JetEvalSharedHostKind.Condition {
                return Val(JetEvalSharedHostAdoptPreflightFailure{
                    message: "native Condition carrier kind disagrees with its physical root",
                    ownership: false,
                })
            }
            metadata := entry.metadata.guard_read().value
            if metadata.origin != carrier.origin {
                return Val(JetEvalSharedHostAdoptPreflightFailure{
                    message: "native Condition origin disagrees with its physical root",
                    ownership: false,
                })
            }
            if metadata.physical_root == None {
                return Val(JetEvalSharedHostAdoptPreflightFailure{
                    message: "native Condition carrier has no generation-bearing physical capability",
                    ownership: false,
                })
            }
            if !jet_eval_shared_runtime_ref_retain(metadata.references, metadata.dropped) {
                return Val(JetEvalSharedHostAdoptPreflightFailure{
                    message: "native Condition root was released before Source adoption",
                    ownership: true,
                })
            }
            return None
        }
        .Weak(entry) -> {
            if carrier.kind != JetEvalSharedHostKind.Weak {
                return Val(JetEvalSharedHostAdoptPreflightFailure{
                    message: "native Shared.Weak carrier kind disagrees with its physical root",
                    ownership: false,
                })
            }
            metadata := entry.metadata.guard_read().value
            if metadata.origin != carrier.origin {
                return Val(JetEvalSharedHostAdoptPreflightFailure{
                    message: "native Shared.Weak origin disagrees with its physical root",
                    ownership: false,
                })
            }
            if metadata.physical_root == None {
                return Val(JetEvalSharedHostAdoptPreflightFailure{
                    message: "native Shared.Weak carrier has no generation-bearing weak capability",
                    ownership: false,
                })
            }
            if !jet_eval_shared_runtime_ref_retain(metadata.references, metadata.dropped) {
                return Val(JetEvalSharedHostAdoptPreflightFailure{
                    message: "native Shared.Weak root was released before Source adoption",
                    ownership: true,
                })
            }
            return None
        }
        .Guard(_) -> return Val(JetEvalSharedHostAdoptPreflightFailure{
            message: "native SharedGuard cannot be adopted as a user Shared value",
            ownership: false,
        })
    }
    None
}

// This checks only Source-side carrier invariants; it performs no physical
// RetainAlias/AdoptAlias call and changes no Source registry or owner state.
pub fn jet_eval_shared_runtime_host_adopt_preflight(
    carrier: JetEvalSharedHostCarrier,
    result_ty: ?MirType,
) -> Bool {
    jet_eval_shared_runtime_host_adopt_preflight_failure(carrier, result_ty) == None
}

// Entry loans validate the same checked physical carrier invariants as an
// owned adoption, without invoking a physical operation or changing a registry.
pub fn jet_eval_shared_runtime_host_entry_loan_preflight(
    carrier: JetEvalSharedHostCarrier,
    result_ty: ?MirType,
) -> Bool {
    jet_eval_shared_runtime_host_entry_loan_preflight_failure(carrier, result_ty) == None
}
pub fn jet_eval_shared_runtime_host_entry_loan_value(loan: JetEvalSharedEntryLoan) -> JetEvalRuntimeValue {
    if loan.kind == JetEvalSharedHostKind.Shared -> return JetEvalRuntimeValue.Shared(loan.index)
    if loan.kind == JetEvalSharedHostKind.Snapshot -> return JetEvalRuntimeValue.SharedSnapshot(loan.index)
    if loan.kind == JetEvalSharedHostKind.Condition -> return JetEvalRuntimeValue.Condition(loan.index)
    if loan.kind == JetEvalSharedHostKind.Weak -> return JetEvalRuntimeValue.SharedWeak(loan.index)
    JetEvalRuntimeValue.SharedGuard(loan.index)
}

pub fn jet_eval_shared_runtime_host_entry_loan(
    machine: &JetEvalMachine,
    carrier: JetEvalSharedHostCarrier,
    result_ty: ?MirType,
    span: Span,
) -> ?JetEvalSharedEntryLoan {
    failure := jet_eval_shared_runtime_host_entry_loan_preflight_failure(carrier, result_ty)
    if failure != None {
        issue :: failure ?? JetEvalSharedHostAdoptPreflightFailure{
            message: "native Shared carrier failed entry-loan preflight",
            ownership: false,
        }
        if issue.ownership {
            jet_eval_ownership_fail(&machine, span, issue.message)
        } else {
            jet_eval_compiler_fail(&machine, span, issue.message)
        }
        return None
    }
    if carrier.physical == {
        .Shared(entry) -> {
            index := jet_eval_shared_runtime_allocate_value(&machine, entry)
            jet_eval_shared_runtime_entry_read_loan_mark(&machine, JetEvalSharedHostKind.Shared, index)
            return Val(JetEvalSharedEntryLoan{
                kind: JetEvalSharedHostKind.Shared,
                index: index,
                registry: machine.registry.shared_runtime,
            })
        }
        .Snapshot(entry) -> {
            index := jet_eval_shared_runtime_allocate_snapshot(&machine, entry)
            jet_eval_shared_runtime_entry_read_loan_mark(&machine, JetEvalSharedHostKind.Snapshot, index)
            return Val(JetEvalSharedEntryLoan{
                kind: JetEvalSharedHostKind.Snapshot,
                index: index,
                registry: machine.registry.shared_runtime,
            })
        }
        .Condition(entry) -> {
            index := jet_eval_shared_runtime_allocate_condition(&machine, entry)
            jet_eval_shared_runtime_entry_read_loan_mark(&machine, JetEvalSharedHostKind.Condition, index)
            return Val(JetEvalSharedEntryLoan{
                kind: JetEvalSharedHostKind.Condition,
                index: index,
                registry: machine.registry.shared_runtime,
            })
        }
        .Weak(entry) -> {
            index := jet_eval_shared_runtime_allocate_weak(&machine, entry)
            jet_eval_shared_runtime_entry_read_loan_mark(&machine, JetEvalSharedHostKind.Weak, index)
            return Val(JetEvalSharedEntryLoan{
                kind: JetEvalSharedHostKind.Weak,
                index: index,
                registry: machine.registry.shared_runtime,
            })
        }
        .Guard(entry) -> {
            source_guard := entry.metadata.guard_read().value
            source_lease := source_guard.lease.metadata.guard_read().value
            source_root :: jet_eval_shared_runtime_value_from_registry(carrier.registry, source_lease.shared) ?? {
                jet_eval_ownership_fail(&machine, span, "native SharedGuard root disappeared before receiver-local remapping")
                return None
            }
            local_shared := jet_eval_shared_runtime_allocate_value(&machine, source_root)
            local_lease := JetEvalSharedGuardLease{
                metadata: shared JetEvalSharedGuardLeaseMeta{
                    shared: local_shared,
                    owner_row: source_lease.owner_row,
                    editable: source_lease.editable,
                    handles: 1,
                    dirty: false,
                    released: false,
                },
            }
            local_guard := JetEvalSharedGuard{
                metadata: shared JetEvalSharedGuardMeta{
                    references: 1,
                    dropped: false,
                    active: true,
                    editable: source_guard.editable,
                    path: source_guard.path,
                    owner_row: source_guard.owner_row,
                    physical_borrow_selector: None,
                    lease: local_lease,
                },
            }
            index := jet_eval_shared_runtime_allocate_guard(&machine, local_guard)
            jet_eval_shared_runtime_entry_read_loan_mark(&machine, JetEvalSharedHostKind.Guard, index)
            return Val(JetEvalSharedEntryLoan{
                kind: JetEvalSharedHostKind.Guard,
                index: index,
                registry: machine.registry.shared_runtime,
            })
        }
    }
    jet_eval_internal_problem(&machine, Val(span), "checked Read entry loan has an unsupported Shared carrier kind")
    None
}

// Bind only the receiver-local Guard loan to its call-owned sidecar entry.
// The selector carries no authority by itself and is validated by the active
// NativeInterfaceScope before the physical view is used.
pub fn jet_eval_shared_runtime_host_entry_loan_set_physical_borrow_selector(
    machine: &JetEvalMachine,
    loan: JetEvalSharedEntryLoan,
    selector: Int,
) -> Bool {
    if loan.registry.storage != machine.registry.shared_runtime.storage
        || loan.kind != JetEvalSharedHostKind.Guard
        || selector < 0
        || !jet_eval_shared_runtime_entry_read_loan_active(&machine, JetEvalSharedHostKind.Guard, loan.index) {
        return false
    }
    entry :: jet_eval_shared_runtime_guard(&machine, loan.index) ?? return false
    lease := entry.metadata.guard_read().value.lease.metadata.guard_read().value
    if lease.released || lease.handles <= 0 -> return false
    permit := entry.metadata.guard_edit()
    if permit.value.dropped || permit.value.references <= 0 || !permit.value.active
        || permit.value.physical_borrow_selector != None -> return false
    permit.value.physical_borrow_selector = Val(selector)
    true
}

fn jet_eval_shared_runtime_entry_read_guard_loan_end(machine: &JetEvalMachine, loan_index: Int) -> Bool {
    runtime := machine.registry.shared_runtime
    guard_count :: runtime.storage.guard_read().value.guards.len()
    if guard_count == 0 || runtime.storage.guard_read().value.entry_read_guard_loans.get(loan_index) != Val(loan_index) -> return false
    first_index := -1
    loop index in 0..<guard_count {
        if runtime.storage.guard_read().value.entry_read_guard_loans.get(index) == Val(loan_index) {
            first_index = index
            break
        }
    }
    if first_index < 0 -> return false
    first_guard :: jet_eval_shared_runtime_guard(&machine, first_index) ?? return false
    lease := first_guard.metadata.guard_read().value.lease
    lease_before := lease.metadata.guard_read().value
    if lease_before.handles < 0
        || (lease_before.released && lease_before.handles != 0)
        || (!lease_before.released && lease_before.handles <= 0) -> return false
    loop index in 0..<guard_count {
        if runtime.storage.guard_read().value.entry_read_guard_loans.get(index) == Val(loan_index) {
            entry :: jet_eval_shared_runtime_guard(&machine, index) ?? return false
            if entry.metadata.guard_read().value.lease.metadata != lease.metadata -> return false
        }
    }
    {
        permit := lease.metadata.guard_edit()
        permit.value.handles = 0
        permit.value.dirty = false
        permit.value.released = true
    }
    loop index in 0..<guard_count {
        if runtime.storage.guard_read().value.entry_read_guard_loans.get(index) == Val(loan_index) {
            entry :: jet_eval_shared_runtime_guard(&machine, index) ?? return false
            permit := entry.metadata.guard_edit()
            permit.value.references = 0
            permit.value.dropped = true
            permit.value.active = false
            permit.value.physical_borrow_selector = None
        }
    }
    {
        permit := runtime.storage.guard_edit()
        loop index in 0..<guard_count {
            if permit.value.entry_read_guard_loans.get(index) == Val(loan_index) {
                removed := permit.value.entry_read_guard_loans.remove(index)
                if removed != Val(loan_index) -> return false
            }
        }
    }
    true
}

fn jet_eval_shared_runtime_host_entry_loan_end_guard(
    machine: &JetEvalMachine,
    loan_index: Int,
    span: Span,
) -> Bool {
    if jet_eval_shared_runtime_entry_read_guard_loan_end(&machine, loan_index) -> return true
    jet_eval_ownership_fail(&machine, span, "SharedGuard entry loan has inconsistent receiver-local views or dirty state")
    false
}
pub fn jet_eval_shared_runtime_host_entry_loan_end(
    machine: &JetEvalMachine,
    loan: JetEvalSharedEntryLoan,
    span: Span,
) -> Bool {
    if loan.registry.storage != machine.registry.shared_runtime.storage {
        jet_eval_ownership_fail(&machine, span, "Shared entry loan belongs to a different runtime registry")
        return false
    }
    if loan.kind == JetEvalSharedHostKind.Guard {
        return jet_eval_shared_runtime_host_entry_loan_end_guard(&machine, loan.index, span)
    }
    if !jet_eval_shared_runtime_entry_read_loan_remove(&machine, loan) {
        jet_eval_ownership_fail(&machine, span, "Shared entry loan was ended more than once or has an invalid kind")
        return false
    }
    true
}


fn jet_eval_shared_runtime_host_import_shared(
    machine: &JetEvalMachine,
    entry: JetEvalSharedValue,
    owner_alias_token: ?Int,
    owner_alias_token_pre_adopted: Bool,
    span: Span,
) -> ?JetEvalRuntimeValue {
    metadata := entry.metadata
    index := jet_eval_shared_runtime_allocate_value(&machine, entry)
    token_id := if owner_alias_token == {
        Val(token) -> {
            if owner_alias_token_pre_adopted {
                duplicate := {
                    permit := metadata.guard_read()
                    found := false
                    loop existing in permit.value.owner_alias_tokens {
                        if existing == token -> found = true
                    }
                    loop existing in permit.value.pending_owner_alias_transfers {
                        if existing == token -> found = true
                    }
                    found
                }
                if duplicate -> {
                    jet_eval_ownership_fail(&machine, span, "pre-adopted Shared owner token is still registered in its source root")
                    return None
                }
            } else if !jet_eval_shared_runtime_owner_alias_adopt(&machine, index, token, span) {
                return None
            }
            token
        }
        None -> {
            if owner_alias_token_pre_adopted -> {
                jet_eval_compiler_fail(&machine, span, "pre-adopted Shared carrier has no owner alias token")
                return None
            }
            jet_eval_shared_runtime_owner_alias_retain(&machine, index, span) ?? return None
        }
    }
    retained := {
        permit := metadata.guard_edit()
        if permit.value.dropped
            || permit.value.references < 0
            || permit.value.references != permit.value.owner_alias_tokens.len() {
            false
        } else {
            permit.value.references += 1
            permit.value.owner_alias_tokens.push(token_id)
            true
        }
    }
    if !retained {
        jet_eval_shared_runtime_owner_alias_release(&machine, index, token_id, span)
        jet_eval_ownership_fail(&machine, span, "native Shared root was released before Source adoption")
        return None
    }
    Val(JetEvalRuntimeValue.Shared(index))
}
fn jet_eval_shared_runtime_host_import_snapshot(machine: &JetEvalMachine, entry: JetEvalSharedSnapshot, span: Span) -> ?JetEvalRuntimeValue {
    metadata := entry.metadata
    retained := {
        permit := metadata.guard_edit()
        if !jet_eval_shared_runtime_ref_retain(permit.value.references, permit.value.dropped) -> false
        else {
            permit.value.references += 1
            true
        }
    }
    if !retained {
        jet_eval_ownership_fail(&machine, span, "native SharedSnapshot root was released before Source adoption")
        return None
    }
    Val(JetEvalRuntimeValue.SharedSnapshot(jet_eval_shared_runtime_allocate_snapshot(&machine, entry)))
}
fn jet_eval_shared_runtime_host_import_condition(machine: &JetEvalMachine, entry: JetEvalSharedCondition, span: Span) -> ?JetEvalRuntimeValue {
    metadata := entry.metadata
    retained := {
        permit := metadata.guard_edit()
        if !jet_eval_shared_runtime_ref_retain(permit.value.references, permit.value.dropped) -> false
        else {
            permit.value.references += 1
            true
        }
    }
    if !retained {
        jet_eval_ownership_fail(&machine, span, "native Condition root was released before Source adoption")
        return None
    }
    Val(JetEvalRuntimeValue.Condition(jet_eval_shared_runtime_allocate_condition(&machine, entry)))
}
fn jet_eval_shared_runtime_host_import_weak(machine: &JetEvalMachine, entry: JetEvalSharedWeak, span: Span) -> ?JetEvalRuntimeValue {
    metadata := entry.metadata
    retained := {
        permit := metadata.guard_edit()
        if !jet_eval_shared_runtime_ref_retain(permit.value.references, permit.value.dropped) -> false
        else {
            permit.value.references += 1
            true
        }
    }
    if !retained {
        jet_eval_ownership_fail(&machine, span, "native Shared.Weak root was released before Source adoption")
        return None
    }
    Val(JetEvalRuntimeValue.SharedWeak(jet_eval_shared_runtime_allocate_weak(&machine, entry)))
}

pub fn jet_eval_shared_runtime_host_adopt(machine: &JetEvalMachine, carrier: JetEvalSharedHostCarrier, result_ty: ?MirType, span: Span) -> ?JetEvalRuntimeValue {
    failure := jet_eval_shared_runtime_host_adopt_preflight_failure(carrier, result_ty)
    if failure != None {
        issue :: failure ?? JetEvalSharedHostAdoptPreflightFailure{message: "native Shared carrier failed preflight", ownership: false}
        if issue.ownership {
            jet_eval_ownership_fail(&machine, span, issue.message)
        } else {
            jet_eval_compiler_fail(&machine, span, issue.message)
        }
        return None
    }
    if carrier.physical == {
        .Shared(entry) -> return jet_eval_shared_runtime_host_import_shared(&machine, entry, carrier.owner_alias_token, carrier.owner_alias_token_pre_adopted, span)
        .Snapshot(entry) -> return jet_eval_shared_runtime_host_import_snapshot(&machine, entry, span)
        .Condition(entry) -> return jet_eval_shared_runtime_host_import_condition(&machine, entry, span)
        .Weak(entry) -> return jet_eval_shared_runtime_host_import_weak(&machine, entry, span)
        .Guard(_) -> return None
    }
    None
}
 

fn jet_eval_shared_runtime_row_symbol(row: MirPreludeCall) -> String {
    mir_symbol_name(row.symbol)
}
fn jet_eval_shared_runtime_row_matches(
    row: MirPreludeCall,
    family: MirPreludeFamily,
    module_name: String,
    member: String,
    symbol: String,
    abi: MirPreludeAbi,
    ^borrow_mask: [Bool],
) -> Bool {
    if row.family != family || row.module_name != module_name || row.member != member -> return false
    if jet_eval_shared_runtime_row_symbol(row) != symbol || row.abi != abi -> return false
    arity := borrow_mask.len()
    if row.signature.arity != arity || row.signature.max_arity != arity || row.signature.borrow_mask.len() != arity -> return false
    loop index in 0..<arity {
        if row.signature.borrow_mask[index] != borrow_mask[index] -> return false
    }
    true
}

fn jet_eval_shared_runtime_fallibility_matches(row: MirPreludeCall, result_ty: ?MirType) -> Bool {
    ty :: result_ty ?? return row.fallibility == MirCallFallibility.Infallible
    if ty.kind == {
        .Option(inner) -> return row.fallibility == MirCallFallibility.Failure(MirFailureCarrier.Optional(inner))
        .Result(ok, err) -> return row.fallibility == MirCallFallibility.Failure(MirFailureCarrier.Result(ok, err))
        .Apply(name, args) -> {
            if name.name == "Never" && args.len() == 0 {
                return row.fallibility == MirCallFallibility.Failure(MirFailureCarrier.Diverges(ty))
            }
        }
        else -> {}
    }
    row.fallibility == MirCallFallibility.Infallible
}

fn jet_eval_shared_runtime_host_row_valid(row: MirPreludeCall) -> Bool {
    symbol := jet_eval_shared_runtime_row_symbol(row)
    if row.family == MirPreludeFamily.StaticPrelude && row.abi == MirPreludeAbi.Value {
        if row.member == "new" && symbol == "jet_std::JetShared::new" && row.module_name.ends_with("jet_std::JetShared") {
            return row.signature.arity == 1 && row.signature.max_arity == 1 && row.signature.borrow_mask.len() == 1 && !row.signature.borrow_mask[0]
        }
        if row.member == "new" && row.module_name == "::jet_std::JetCondition" && symbol == "jet_std::JetCondition::new" {
            return row.signature.arity == 0 && row.signature.max_arity == 0 && row.signature.borrow_mask.len() == 0
        }
        if row.module_name != "core.host" -> return false
        if row.member == "Shared.get" -> return jet_eval_shared_runtime_row_matches(row, .StaticPrelude, "core.host", row.member, "jet_shared_get", .Value, [Bool]{true})
        if row.member == "Shared.set" -> return jet_eval_shared_runtime_row_matches(row, .StaticPrelude, "core.host", row.member, "jet_shared_set", .Value, [Bool]{true, false})
        if row.member == "Shared.replace" -> return jet_eval_shared_runtime_row_matches(row, .StaticPrelude, "core.host", row.member, "jet_shared_replace", .Value, [Bool]{true, false})
        if row.member == "Shared.read" -> return jet_eval_shared_runtime_row_matches(row, .StaticPrelude, "core.host", row.member, "jet_shared_read", .Value, [Bool]{true, false})
        if row.member == "Shared.edit" -> return jet_eval_shared_runtime_row_matches(row, .StaticPrelude, "core.host", row.member, "jet_shared_edit", .Value, [Bool]{true, false})
        if row.member == "Shared.capture" {
            if symbol == "jet_shared_capture" -> return jet_eval_shared_runtime_row_matches(row, .StaticPrelude, "core.host", row.member, symbol, .Value, [Bool]{true})
            if symbol == "jet_shared_capture_with" -> return jet_eval_shared_runtime_row_matches(row, .StaticPrelude, "core.host", row.member, symbol, .Value, [Bool]{true, false})
            return false
        }
        if row.member == "Shared.capture_txn" {
            if symbol == "jet_shared_capture_txn_plain" -> return jet_eval_shared_runtime_row_matches(row, .StaticPrelude, "core.host", row.member, symbol, .Value, [Bool]{true, true})
            if symbol == "jet_shared_capture_txn" -> return jet_eval_shared_runtime_row_matches(row, .StaticPrelude, "core.host", row.member, symbol, .Value, [Bool]{true, true, false})
            return false
        }
        if row.member == "Shared.read_txn" -> return jet_eval_shared_runtime_row_matches(row, .StaticPrelude, "core.host", row.member, "jet_shared_read_txn", .Value, [Bool]{true, true, false})
        if row.member == "Shared.edit_txn" -> return jet_eval_shared_runtime_row_matches(row, .StaticPrelude, "core.host", row.member, "jet_shared_edit_txn", .Value, [Bool]{true, true, false})
        if row.member == "Shared.try_replace" -> return jet_eval_shared_runtime_row_matches(row, .StaticPrelude, "core.host", row.member, "jet_shared_try_replace", .Value, [Bool]{true, false, false})
        if row.member == "Shared.guard_read" -> return jet_eval_shared_runtime_row_matches(row, .StaticPrelude, "core.host", row.member, "jet_shared_guard_read", .Value, [Bool]{true})
        if row.member == "Shared.guard_edit" -> return jet_eval_shared_runtime_row_matches(row, .StaticPrelude, "core.host", row.member, "jet_shared_guard_edit", .Value, [Bool]{true})
        if row.member == "Shared.downgrade" -> return jet_eval_shared_runtime_row_matches(row, .StaticPrelude, "core.host", row.member, "jet_shared_downgrade", .Value, [Bool]{true})
        if row.member == "Shared.strong_count" -> return jet_eval_shared_runtime_row_matches(row, .StaticPrelude, "core.host", row.member, "jet_shared_strong_count", .Value, [Bool]{true})
        if row.member == "SharedSnapshot.value" -> return jet_eval_shared_runtime_row_matches(row, .StaticPrelude, "core.host", row.member, "jet_shared_snapshot_value", .Value, [Bool]{true})
        if row.member == "Shared.Weak.upgrade" -> return jet_eval_shared_runtime_row_matches(row, .StaticPrelude, "core.host", row.member, "jet_shared_weak_upgrade", .Value, [Bool]{true})
    }
    if row.family == MirPreludeFamily.HandleMethod && row.module_name == "core.shared_guard" && row.abi == MirPreludeAbi.Value && row.fallibility == MirCallFallibility.Infallible {
        if row.member == "notify_one" -> return jet_eval_shared_runtime_row_matches(row, .HandleMethod, "core.shared_guard", "notify_one", "jet_std::JetCondition::notify_one", .Value, [Bool]{true})
        if row.member == "notify_all" -> return jet_eval_shared_runtime_row_matches(row, .HandleMethod, "core.shared_guard", "notify_all", "jet_std::JetCondition::notify_all", .Value, [Bool]{true})
    }
    false
}

fn jet_eval_shared_runtime_owns_row(row: MirPreludeCall) -> Bool {
    if row.family == MirPreludeFamily.StaticPrelude {
        if row.member == "new" && (row.module_name.ends_with("jet_std::JetShared") || row.module_name == "::jet_std::JetCondition") -> return true
        if row.module_name == "core.host" {
            return row.member == "Shared.get" || row.member == "Shared.set" || row.member == "Shared.replace" || row.member == "Shared.read" || row.member == "Shared.edit" || row.member == "Shared.capture" || row.member == "Shared.capture_txn" || row.member == "Shared.read_txn" || row.member == "Shared.edit_txn" || row.member == "Shared.try_replace" || row.member == "Shared.guard_read" || row.member == "Shared.guard_edit" || row.member == "Shared.downgrade" || row.member == "Shared.strong_count" || row.member == "SharedSnapshot.value" || row.member == "Shared.Weak.upgrade"
        }
    }
    if row.family == MirPreludeFamily.HandleMethod && row.module_name == "core.shared_guard" -> return row.member == "notify_one" || row.member == "notify_all"
    false
}

fn jet_eval_shared_runtime_physical(
    machine: &JetEvalMachine,
    operation: JetEvalSharedPhysicalOp,
    row: MirPreludeCall,
    map_row: ?MirPreludeCall,
    shared_value: JetEvalRuntimeValue,
    guard_value: ?JetEvalRuntimeValue,
    condition_value: ?JetEvalRuntimeValue,
    result_ty: ?MirType,
    span: Span,
) -> ?JetEvalRuntimeValue {
    adapter :: jet_eval_host_adapter_clone(&machine, span) ?? return None
    host_args := [JetEvalHostArgument]{}
    if shared_value != JetEvalRuntimeValue.Data(TComptimeValue.Unit) {
        host_args.push(jet_eval_shared_runtime_physical_host_argument(&machine, shared_value, operation == JetEvalSharedPhysicalOp.CreateShared, span) ?? return None)
    }
    if guard_value == {
        Val(value) -> host_args.push(jet_eval_shared_runtime_physical_host_argument(&machine, value, false, span) ?? return None)
        None -> {}
    }
    if condition_value == {
        Val(value) -> host_args.push(jet_eval_shared_runtime_physical_host_argument(&machine, value, false, span) ?? return None)
        None -> {}
    }
    if operation == {
        .WriteGuard(value) -> host_args.push(jet_eval_shared_runtime_physical_host_argument(&machine, value, false, span) ?? return None)
        .Downgrade(weak) -> host_args.push(jet_eval_shared_runtime_physical_host_argument(&machine, weak, false, span) ?? return None)
        .Map(child, _, _) -> host_args.push(jet_eval_shared_runtime_physical_host_argument(&machine, child, false, span) ?? return None)
        .Split(first, second, _, _, _) -> {
            host_args.push(jet_eval_shared_runtime_physical_host_argument(&machine, first, false, span) ?? return None)
            host_args.push(jet_eval_shared_runtime_physical_host_argument(&machine, second, false, span) ?? return None)
        }
        .AdoptAlias(token_id) | .ReleaseAlias(token_id) ->
            host_args.push(jet_eval_shared_runtime_physical_host_argument(
                &machine,
                JetEvalRuntimeValue.Data(TComptimeValue.Int(token_id)),
                false,
                span,
            ) ?? return None)
        .AcquireOrdered(participants) | .AbortOrdered(participants) -> loop participant in participants {
            host_args.push(jet_eval_shared_runtime_physical_host_argument(&machine, JetEvalRuntimeValue.Shared(participant.shared), false, span) ?? return None)
            host_args.push(jet_eval_shared_runtime_physical_host_argument(&machine, JetEvalRuntimeValue.SharedGuard(participant.guard), false, span) ?? return None)
        }
        else -> {}
    }
    result_shape := None
    if result_ty != None -> result_shape = Val(jet_eval_host_type_shape(&machine, result_ty, span) ?? return None)
    reply :: adapter.shared_call(&machine, operation, row, map_row, shared_value, guard_value, condition_value, ^host_args, result_shape, span) ?? {
        jet_eval_unsupported(&machine, span, "MIR Shared physical protocol is unavailable to the canonical host adapter")
        return None
    }
    transfers_ok := jet_eval_validate_host_transfers(&machine, reply.transfers, [JetEvalRuntimeValue]{}, [Bool]{}, span)
    if !transfers_ok {
        jet_eval_host_writebacks_discard_from(&machine, reply.writebacks, 0, span)
        return None
    }
    if !jet_eval_retire_host_transfers(&machine, reply.transfers, span) {
        jet_eval_host_writebacks_discard_from(&machine, reply.writebacks, 0, span)
        return None
    }
    if !jet_eval_host_writebacks(&machine, [JetEvalRuntimeValue]{}, reply.writebacks, span) -> return None
    jet_eval_apply_host_outcome(&machine, reply.outcome, Val(row), result_ty, span)
}

fn jet_eval_shared_runtime_unit(value: JetEvalRuntimeValue) -> Bool {
    value == {.Data(TComptimeValue.Unit) -> true else -> false}
}
fn jet_eval_shared_runtime_physical_ok(value: ?JetEvalRuntimeValue, machine: &JetEvalMachine, span: Span) -> Bool {
    if value == None -> return false
    outcome :: value ?? return false
    if outcome == {.RuntimeFailure(_, _) -> return false}
    if !jet_eval_shared_runtime_unit(outcome) {
        jet_eval_compiler_fail(&machine, span, "MIR Shared physical operation returned a non-Unit value")
        return false
    }
    true
}

fn jet_eval_shared_runtime_owner_alias_retain(machine: &JetEvalMachine, index: Int, span: Span) -> ?Int {
    entry := jet_eval_shared_runtime_value(&machine, index) ?? return None
    metadata := entry.metadata
    root_live := {
        permit := metadata.guard_read()
        !permit.value.dropped && permit.value.physical_root != None
    }
    if !root_live -> {
        jet_eval_ownership_fail(&machine, span, "MIR Shared alias retain has no live physical owner")
        return None
    }
    row := {
        permit := metadata.guard_read()
        permit.value.create_row
    }
    retained :: jet_eval_shared_runtime_physical(
        &machine,
        JetEvalSharedPhysicalOp.RetainAlias,
        row,
        None,
        JetEvalRuntimeValue.Shared(index),
        None,
        None,
        Val(mir_type_from_kind(MirTypeKind.Int)),
        span,
    ) ?? return None
    if retained == {
        .Data(TComptimeValue.Int(token_id)) -> {
            if token_id < 0 -> {
                jet_eval_compiler_fail(&machine, span, "MIR Shared owner retained an invalid alias token")
                return None
            }
            return Val(token_id)
        }
        .RuntimeFailure(_, _) -> return None
        else -> {}
    }
    jet_eval_compiler_fail(&machine, span, "MIR Shared alias retain returned a non-Int token")
    None
}

fn jet_eval_shared_runtime_owner_alias_adopt(machine: &JetEvalMachine, index: Int, token_id: Int, span: Span) -> Bool {
    entry := jet_eval_shared_runtime_value(&machine, index) ?? return false
    row := {
        permit := entry.metadata.guard_read()
        permit.value.create_row
    }
    result := jet_eval_shared_runtime_physical(
        &machine,
        JetEvalSharedPhysicalOp.AdoptAlias(token_id),
        row,
        None,
        JetEvalRuntimeValue.Shared(index),
        None,
        None,
        None,
        span,
    )
    jet_eval_shared_runtime_physical_ok(result, &machine, span)
}

fn jet_eval_shared_runtime_owner_alias_release(machine: &JetEvalMachine, index: Int, token_id: Int, span: Span) -> Bool {
    entry := jet_eval_shared_runtime_value(&machine, index) ?? return false
    row := {
        permit := entry.metadata.guard_read()
        permit.value.create_row
    }
    result := jet_eval_shared_runtime_physical(
        &machine,
        JetEvalSharedPhysicalOp.ReleaseAlias(token_id),
        row,
        None,
        JetEvalRuntimeValue.Shared(index),
        None,
        None,
        None,
        span,
    )
    jet_eval_shared_runtime_physical_ok(result, &machine, span)
}

fn jet_eval_shared_runtime_abandon_value(machine: &JetEvalMachine, index: Int, span: Span) -> Bool {
    entry := jet_eval_shared_runtime_value(&machine, index) ?? return false
    metadata := entry.metadata
    tokens := [Int]{}
    has_root := false
    {
        permit := metadata.guard_edit()
        tokens = permit.value.owner_alias_tokens
        has_root = permit.value.physical_root != None
        permit.value.references = 0
        permit.value.dropped = true
        permit.value.owner_alias_tokens = [Int]{}
        permit.value.pending_owner_alias_transfers = [Int]{}
    }
    cleanup_ok := true
    loop token_id in tokens {
        if !jet_eval_shared_runtime_owner_alias_release(&machine, index, token_id, span) -> cleanup_ok = false
    }
    if has_root {
        create_row := {
            permit := metadata.guard_read()
            permit.value.create_row
        }
        root_release := jet_eval_shared_runtime_physical(
            &machine,
            JetEvalSharedPhysicalOp.ReleaseShared,
            create_row,
            None,
            JetEvalRuntimeValue.Shared(index),
            None,
            None,
            None,
            span,
        )
        if !jet_eval_shared_runtime_physical_ok(root_release, &machine, span) {
            cleanup_ok = false
        } else {
            permit := metadata.guard_edit()
            permit.value.physical_root = None
        }
    }
    storage := entry.storage
    payload := {
        permit := storage.guard_edit()
        value := permit.value.value
        permit.value.value = JetEvalRuntimeValue.Moved
        value
    }
    payload_ok := if payload == JetEvalRuntimeValue.Moved -> true else -> jet_eval_drop_value(&machine, payload, span)
    cleanup_ok && payload_ok
}
fn jet_eval_shared_runtime_abandon_condition(machine: &JetEvalMachine, index: Int) {
    entry := jet_eval_shared_runtime_condition(&machine, index) ?? return
    metadata := entry.metadata
    permit := metadata.guard_edit()
    permit.value.references = 0
    permit.value.dropped = true
}

fn jet_eval_shared_runtime_create(machine: &JetEvalMachine, value: JetEvalRuntimeValue, element_type: MirType, row: MirPreludeCall, span: Span) -> ?JetEvalRuntimeValue {
    storage := shared JetEvalSharedValueData{value: value}
    metadata := shared JetEvalSharedValueMeta{
        references: 1,
        dropped: false,
        revision: 0,
        create_row: row,
        element_type: element_type,
        origin: JetEvalSharedHostOrigin.Source,
        physical_root: None,
        owner_alias_tokens: [Int]{},
        pending_owner_alias_transfers: [Int]{},
    }
    index := jet_eval_shared_runtime_allocate_value(&machine, JetEvalSharedValue{storage: storage, metadata: metadata})
    carrier := JetEvalRuntimeValue.Shared(index)
    physical := jet_eval_shared_runtime_physical(
        &machine,
        JetEvalSharedPhysicalOp.CreateShared,
        row,
        None,
        carrier,
        None,
        None,
        None,
        span,
    )
    if !jet_eval_shared_runtime_physical_ok(physical, &machine, span) {
        jet_eval_shared_runtime_abandon_value(&machine, index, span)
        return None
    }
    if entry := jet_eval_shared_runtime_value(&machine, index) {
        metadata := entry.metadata.guard_read().value
        if metadata.physical_root == None
            || metadata.references != 1
            || metadata.owner_alias_tokens.len() != 1
            || metadata.pending_owner_alias_transfers.len() != 0 {
            jet_eval_compiler_fail(&machine, span, "MIR Shared owner did not register one generation-bearing root and its initial logical alias")
            jet_eval_shared_runtime_abandon_value(&machine, index, span)
            return None
        }
    } else -> {
        jet_eval_ownership_fail(&machine, span, "MIR Shared root disappeared during physical registration")
        return None
    }
    Val(carrier)
}
fn jet_eval_shared_runtime_create_condition(machine: &JetEvalMachine, row: MirPreludeCall, span: Span) -> ?JetEvalRuntimeValue {
    metadata := shared JetEvalSharedConditionMeta{
        references: 1,
        dropped: false,
        create_row: row,
        origin: JetEvalSharedHostOrigin.Source,
        physical_root: None,
    }
    index := jet_eval_shared_runtime_allocate_condition(&machine, JetEvalSharedCondition{metadata: metadata})
    carrier := JetEvalRuntimeValue.Condition(index)
    physical := jet_eval_shared_runtime_physical(
        &machine,
        JetEvalSharedPhysicalOp.CreateCondition,
        row,
        None,
        JetEvalRuntimeValue.Data(TComptimeValue.Unit),
        None,
        Val(carrier),
        None,
        span,
    )
    if !jet_eval_shared_runtime_physical_ok(physical, &machine, span) {
        jet_eval_shared_runtime_abandon_condition(&machine, index)
        return None
    }
    if entry := jet_eval_shared_runtime_condition(&machine, index) {
        if entry.metadata.guard_read().value.physical_root == None {
            jet_eval_compiler_fail(&machine, span, "MIR Condition physical root was not registered by the native owner")
            jet_eval_shared_runtime_abandon_condition(&machine, index)
            return None
        }
    } else -> {
        jet_eval_ownership_fail(&machine, span, "MIR Condition root disappeared during physical registration")
        return None
    }
    Val(carrier)
}
fn jet_eval_shared_runtime_create_snapshot(machine: &JetEvalMachine, owner: Int, revision: Int, value: JetEvalRuntimeValue, span: Span) -> ?JetEvalRuntimeValue {
    if !jet_eval_shared_runtime_retain(&machine, JetEvalRuntimeValue.Shared(owner), span) -> {
        jet_eval_drop_value(&machine, value, span)
        return None
    }
    owner_entry :: jet_eval_shared_runtime_value(&machine, owner) ?? {
        jet_eval_drop_value(&machine, value, span)
        return None
    }
    owner_origin := owner_entry.metadata.guard_read().value.origin
    storage := shared JetEvalSharedSnapshotData{value: value}
    metadata := shared JetEvalSharedSnapshotMeta{
        references: 1,
        dropped: false,
        owner: owner,
        revision: revision,
        valid: true,
        consumed: false,
        origin: owner_origin,
        owner_root: owner_entry.metadata.guard_read().value.physical_root,
    }
    index := jet_eval_shared_runtime_allocate_snapshot(&machine, JetEvalSharedSnapshot{storage: storage, metadata: metadata})
    Val(JetEvalRuntimeValue.SharedSnapshot(index))
}
fn jet_eval_shared_runtime_create_weak(machine: &JetEvalMachine, shared: Int, row: MirPreludeCall, span: Span) -> ?JetEvalRuntimeValue {
    if !jet_eval_shared_runtime_value_live(&machine, shared, span) -> return None
    target := jet_eval_shared_runtime_value(&machine, shared) ?? return None
    target_meta := target.metadata.guard_read().value
    metadata := shared JetEvalSharedWeakMeta{
        references: 1,
        dropped: false,
        create_row: row,
        element_type: target_meta.element_type,
        origin: target_meta.origin,
        physical_root: None,
    }
    index := jet_eval_shared_runtime_allocate_weak(&machine, JetEvalSharedWeak{metadata: metadata})
    carrier := JetEvalRuntimeValue.SharedWeak(index)
    physical := jet_eval_shared_runtime_physical(
        &machine,
        JetEvalSharedPhysicalOp.Downgrade(carrier),
        row,
        None,
        JetEvalRuntimeValue.Shared(shared),
        None,
        None,
        None,
        span,
    )
    if !jet_eval_shared_runtime_physical_ok(physical, &machine, span) {
        permit := metadata.guard_edit()
        permit.value.references = 0
        permit.value.dropped = true
        return None
    }
    if metadata.guard_read().value.physical_root == None {
        jet_eval_compiler_fail(&machine, span, "MIR Shared.Weak physical root was not registered by the native owner")
        permit := metadata.guard_edit()
        permit.value.references = 0
        permit.value.dropped = true
        return None
    }
    Val(carrier)
}
fn jet_eval_shared_runtime_release_shared(machine: &JetEvalMachine, index: Int, span: Span) -> Bool {
    entry := jet_eval_shared_runtime_value(&machine, index) ?? {
        jet_eval_ownership_fail(&machine, span, "MIR Shared release has an unknown registry identity")
        return false
    }
    metadata := entry.metadata
    released := JetEvalSharedRefRelease.Invalid
    token_id := None
    {
        permit := metadata.guard_edit()
        released = jet_eval_shared_runtime_ref_release(permit.value.references, permit.value.dropped)
        if released != JetEvalSharedRefRelease.Invalid {
            if permit.value.owner_alias_tokens.len() != permit.value.references
                || permit.value.owner_alias_tokens.len() == 0 {
                released = JetEvalSharedRefRelease.Invalid
            } else {
                selected := -1
                loop token_index in 0..<permit.value.owner_alias_tokens.len() {
                    candidate := permit.value.owner_alias_tokens[token_index]
                    staged := false
                    loop pending in permit.value.pending_owner_alias_transfers {
                        if pending == candidate -> staged = true
                    }
                    if !staged -> selected = token_index
                }
                if selected < 0 {
                    released = JetEvalSharedRefRelease.Invalid
                } else {
                    token_id = Val(permit.value.owner_alias_tokens[selected])
                    permit.value.owner_alias_tokens.remove(selected)
                    permit.value.references -= 1
                }
            }
        }
    }
    if released == JetEvalSharedRefRelease.Invalid {
        jet_eval_ownership_fail(&machine, span, "MIR Shared reference has no matching owner alias token")
        return false
    }
    alias_token :: token_id ?? {
        jet_eval_internal_problem(&machine, None, "MIR Shared release lost its owner alias token")
        return false
    }
    if !jet_eval_shared_runtime_owner_alias_release(&machine, index, alias_token, span) {
        permit := metadata.guard_edit()
        permit.value.references += 1
        permit.value.owner_alias_tokens.push(alias_token)
        return false
    }
    if released == JetEvalSharedRefRelease.Remaining -> return true
    if jet_eval_shared_runtime_entry_read_loan_active(&machine, JetEvalSharedHostKind.Shared, index) -> return true
    // The local Source cap is retired independently of other physical aliases.
    // The physical owner's last-alias path finalizes its canonical payload.
    {
        permit := metadata.guard_edit()
        permit.value.dropped = true
    }
    storage := entry.storage
    payload := {
        permit := storage.guard_edit()
        value := permit.value.value
        permit.value.value = JetEvalRuntimeValue.Moved
        value
    }
    payload_ok := true
    if payload != JetEvalRuntimeValue.Moved -> payload_ok = jet_eval_drop_value(&machine, payload, span)
    create_row := {
        permit := metadata.guard_read()
        permit.value.create_row
    }
    physical := jet_eval_shared_runtime_physical(
        &machine,
        JetEvalSharedPhysicalOp.ReleaseShared,
        create_row,
        None,
        JetEvalRuntimeValue.Shared(index),
        None,
        None,
        None,
        span,
    )
    physical_ok := jet_eval_shared_runtime_physical_ok(physical, &machine, span)
    if physical_ok {
        permit := metadata.guard_edit()
        permit.value.physical_root = None
    }
    payload_ok && physical_ok
}
fn jet_eval_shared_runtime_release_condition(machine: &JetEvalMachine, index: Int, span: Span) -> Bool {
    entry := jet_eval_shared_runtime_condition(&machine, index) ?? {
        jet_eval_ownership_fail(&machine, span, "MIR Condition release has an unknown registry identity")
        return false
    }
    metadata := entry.metadata
    loan_active := jet_eval_shared_runtime_entry_read_loan_active(&machine, JetEvalSharedHostKind.Condition, index)
    released := {
        permit := metadata.guard_edit()
        decision := jet_eval_shared_runtime_ref_release(permit.value.references, permit.value.dropped)
        if decision == JetEvalSharedRefRelease.Invalid -> decision
        else {
            permit.value.references -= 1
            if decision == JetEvalSharedRefRelease.Last && !loan_active -> permit.value.dropped = true
            decision
        }
    }
    if released == JetEvalSharedRefRelease.Invalid {
        jet_eval_ownership_fail(&machine, span, "MIR Condition reference was released more than once")
        return false
    }
    if released == JetEvalSharedRefRelease.Remaining || loan_active -> return true
    create_row := {
        permit := metadata.guard_read()
        permit.value.create_row
    }
    physical := jet_eval_shared_runtime_physical(
        &machine,
        JetEvalSharedPhysicalOp.ReleaseCondition,
        create_row,
        None,
        JetEvalRuntimeValue.Data(TComptimeValue.Unit),
        None,
        Val(JetEvalRuntimeValue.Condition(index)),
        None,
        span,
    )
    jet_eval_shared_runtime_physical_ok(physical, &machine, span)
}
fn jet_eval_shared_runtime_release_weak(machine: &JetEvalMachine, index: Int, span: Span) -> Bool {
    entry := jet_eval_shared_runtime_weak(&machine, index) ?? {
        jet_eval_ownership_fail(&machine, span, "MIR Shared.Weak release has an unknown registry identity")
        return false
    }
    metadata := entry.metadata
    loan_active := jet_eval_shared_runtime_entry_read_loan_active(&machine, JetEvalSharedHostKind.Weak, index)
    released := {
        permit := metadata.guard_edit()
        decision := jet_eval_shared_runtime_ref_release(permit.value.references, permit.value.dropped)
        if decision == JetEvalSharedRefRelease.Invalid -> decision
        else {
            permit.value.references -= 1
            if decision == JetEvalSharedRefRelease.Last && !loan_active -> permit.value.dropped = true
            decision
        }
    }
    if released == JetEvalSharedRefRelease.Invalid {
        jet_eval_ownership_fail(&machine, span, "MIR Shared.Weak reference was released more than once")
        return false
    }
    if released == JetEvalSharedRefRelease.Remaining || loan_active -> return true
    create_row := {
        permit := metadata.guard_read()
        permit.value.create_row
    }
    physical := jet_eval_shared_runtime_physical(
        &machine,
        JetEvalSharedPhysicalOp.ReleaseWeak,
        create_row,
        None,
        JetEvalRuntimeValue.SharedWeak(index),
        None,
        None,
        None,
        span,
    )
    jet_eval_shared_runtime_physical_ok(physical, &machine, span)
}

pub fn jet_eval_shared_runtime_release(machine: &JetEvalMachine, value: JetEvalRuntimeValue, span: Span) -> Bool {
    if value == {
        .Shared(index) -> return jet_eval_shared_runtime_release_shared(&machine, index, span)
        .SharedGuard(index) -> return jet_eval_shared_runtime_release_guard(&machine, index, span)
        .SharedSnapshot(index) -> return jet_eval_shared_runtime_release_snapshot(&machine, index, span)
        .Condition(index) -> return jet_eval_shared_runtime_release_condition(&machine, index, span)
        .SharedWeak(index) -> return jet_eval_shared_runtime_release_weak(&machine, index, span)
        else -> {
            jet_eval_compiler_fail(&machine, span, "MIR Shared release received a non-Shared carrier")
            return false
        }
    }
}

fn jet_eval_shared_runtime_release_snapshot(machine: &JetEvalMachine, index: Int, span: Span) -> Bool {
    entry := jet_eval_shared_runtime_snapshot(&machine, index) ?? {
        jet_eval_ownership_fail(&machine, span, "MIR SharedSnapshot release has an unknown registry identity")
        return false
    }
    metadata := entry.metadata
    loan_active := jet_eval_shared_runtime_entry_read_loan_active(&machine, JetEvalSharedHostKind.Snapshot, index)
    released := {
        permit := metadata.guard_edit()
        decision := jet_eval_shared_runtime_ref_release(permit.value.references, permit.value.dropped)
        if decision == JetEvalSharedRefRelease.Invalid -> decision
        else {
            permit.value.references -= 1
            if decision == JetEvalSharedRefRelease.Last && !loan_active -> permit.value.dropped = true
            decision
        }
    }
    if released == JetEvalSharedRefRelease.Invalid {
        jet_eval_ownership_fail(&machine, span, "MIR SharedSnapshot reference was released more than once")
        return false
    }
    if released == JetEvalSharedRefRelease.Remaining || loan_active -> return true
    storage := entry.storage
    payload := {
        permit := storage.guard_edit()
        value := permit.value.value
        permit.value.value = JetEvalRuntimeValue.Moved
        value
    }
    owner := {
        permit := metadata.guard_read()
        permit.value.owner
    }
    payload_ok := if payload == JetEvalRuntimeValue.Moved -> true else -> jet_eval_drop_value(&machine, payload, span)
    owner_ok := jet_eval_shared_runtime_release_shared(&machine, owner, span)
    payload_ok && owner_ok
}

fn jet_eval_shared_runtime_revision_under_guard(machine: &JetEvalMachine, shared: Int, guard: Int, row: MirPreludeCall, span: Span) -> ?Int {
    outcome := jet_eval_shared_runtime_physical(
        &machine,
        JetEvalSharedPhysicalOp.Revision,
        row,
        None,
        JetEvalRuntimeValue.Shared(shared),
        Val(JetEvalRuntimeValue.SharedGuard(guard)),
        None,
        Val(mir_type_from_kind(MirTypeKind.Int)),
        span,
    ) ?? return None
    if outcome == {
        .Data(TComptimeValue.Int(value)) -> return Val(value)
        .RuntimeFailure(_, _) -> return None
        else -> {
            jet_eval_compiler_fail(&machine, span, "MIR Shared revision returned a non-Int value")
            return None
        }
    }
}

fn jet_eval_shared_runtime_guard_root_read(machine: &JetEvalMachine, shared: Int, guard: Int, row: MirPreludeCall, span: Span) -> ?JetEvalRuntimeValue {
    root :: jet_eval_shared_runtime_value(&machine, shared) ?? {
        jet_eval_ownership_fail(&machine, span, "MIR SharedGuard root has an unknown registry identity")
        return None
    }
    element_type := root.metadata.guard_read().value.element_type
    jet_eval_shared_runtime_physical(
        &machine,
        JetEvalSharedPhysicalOp.ReadGuard,
        row,
        None,
        JetEvalRuntimeValue.Shared(shared),
        Val(JetEvalRuntimeValue.SharedGuard(guard)),
        None,
        Val(element_type),
        span,
    )
}

pub fn jet_eval_shared_runtime_guard_read(machine: &JetEvalMachine, frame_index: Int, guard: Int, projections: [MirProjection], span: Span) -> ?JetEvalRuntimeValue {
    entry :: jet_eval_shared_runtime_guard_record(&machine, guard, span) ?? return None
    guard_permit := entry.metadata.guard_read()
    shared := guard_permit.value.lease.metadata.guard_read().value.shared
    row := guard_permit.value.owner_row
    path := guard_permit.value.path
    root_value := jet_eval_shared_runtime_guard_root_read(&machine, shared, guard, row, span) ?? return None
    if root_value == {.RuntimeFailure(_, _) -> return Val(root_value)}
    projected := jet_eval_shared_runtime_project_path(&machine, frame_index, root_value, path, projections, span)
    if !jet_eval_drop_value(&machine, root_value, span) {
        if projected != None -> jet_eval_drop_value(&machine, projected ?? JetEvalRuntimeValue.Moved, span)
        return None
    }
    projected
}

pub fn jet_eval_shared_runtime_guard_write(machine: &JetEvalMachine, frame_index: Int, guard: Int, projections: [MirProjection], replacement: JetEvalRuntimeValue, span: Span) -> Bool {
    entry :: jet_eval_shared_runtime_guard_record(&machine, guard, span) ?? {
        jet_eval_drop_value(&machine, replacement, span)
        return false
    }
    guard_permit := entry.metadata.guard_read()
    if !guard_permit.value.editable {
        jet_eval_source_fail(&machine, span, "jet_shared_guard_edit_required")
        jet_eval_drop_value(&machine, replacement, span)
        return false
    }
    shared := guard_permit.value.lease.metadata.guard_read().value.shared
    owner_row := guard_permit.value.owner_row
    physical := jet_eval_shared_runtime_physical(
        &machine,
        JetEvalSharedPhysicalOp.RequireEdit,
        owner_row,
        None,
        JetEvalRuntimeValue.Shared(shared),
        Val(JetEvalRuntimeValue.SharedGuard(guard)),
        None,
        None,
        span,
    )
    if !jet_eval_shared_runtime_physical_ok(physical, &machine, span) {
        jet_eval_drop_value(&machine, replacement, span)
        return false
    }
    revision :: jet_eval_shared_runtime_revision_under_guard(&machine, shared, guard, owner_row, span) ?? {
        jet_eval_drop_value(&machine, replacement, span)
        return false
    }
    if revision == @JET_EVAL_SHARED_REVISION_MAX {
        jet_eval_source_fail(&machine, span, "SharedRevisionError.GenerationExhausted")
        jet_eval_drop_value(&machine, replacement, span)
        return false
    }
    path := guard_permit.value.path
    full_path := jet_eval_shared_runtime_path_projections(path, span)
    loop projection in projections -> full_path.push(projection)
    root_value :: jet_eval_shared_runtime_guard_root_read(&machine, shared, guard, owner_row, span) ?? {
        jet_eval_drop_value(&machine, replacement, span)
        return false
    }
    if root_value == {.RuntimeFailure(_, _) -> {
        jet_eval_drop_value(&machine, replacement, span)
        return false
    }}
    updated :: jet_eval_replace_runtime(root_value, full_path, 0, frame_index, replacement, &machine, span) ?? {
        jet_eval_drop_value(&machine, replacement, span)
        return false
    }
    written := jet_eval_shared_runtime_physical(
        &machine,
        JetEvalSharedPhysicalOp.WriteGuard(updated),
        owner_row,
        None,
        JetEvalRuntimeValue.Shared(shared),
        Val(JetEvalRuntimeValue.SharedGuard(guard)),
        None,
        None,
        span,
    )
    if !jet_eval_shared_runtime_physical_ok(written, &machine, span) -> return false
    lease := guard_permit.value.lease.metadata
    permit := lease.guard_edit()
    if permit.value.released || permit.value.handles <= 0 {
        jet_eval_ownership_fail(&machine, span, "MIR SharedGuard lease is no longer live")
        return false
    }
    permit.value.dirty = true
    true
}

fn jet_eval_shared_runtime_guard_create(machine: &JetEvalMachine, shared: Int, row: MirPreludeCall, editable: Bool, path: [MirFieldId], lease: JetEvalSharedGuardLease, active: Bool, physical_borrow_selector: ?Int) -> Int {
    metadata := shared JetEvalSharedGuardMeta{
        references: 1,
        dropped: false,
        active: active,
        editable: editable,
        path: path,
        owner_row: row,
        physical_borrow_selector: physical_borrow_selector,
        lease: lease,
    }
    jet_eval_shared_runtime_allocate_guard(&machine, JetEvalSharedGuard{metadata: metadata})
}

fn jet_eval_shared_runtime_guard_prepare(machine: &JetEvalMachine, shared: Int, row: MirPreludeCall, editable: Bool, span: Span) -> ?Int {
    if !jet_eval_shared_runtime_retain(&machine, JetEvalRuntimeValue.Shared(shared), span) -> return None
    lease_meta := shared JetEvalSharedGuardLeaseMeta{
        shared: shared,
        owner_row: row,
        editable: editable,
        handles: 1,
        dirty: false,
        released: false,
    }
    lease := JetEvalSharedGuardLease{metadata: lease_meta}
    Val(jet_eval_shared_runtime_guard_create(&machine, shared, row, editable, [MirFieldId]{}, lease, false, None))
}

fn jet_eval_shared_runtime_guard_abandon_prepared(machine: &JetEvalMachine, index: Int, span: Span) -> Bool {
    guard :: jet_eval_shared_runtime_guard(&machine, index) ?? {
        jet_eval_ownership_fail(&machine, span, "MIR SharedGuard preparation has an unknown registry identity")
        return false
    }
    metadata := guard.metadata
    lease := metadata.guard_read().value.lease
    {
        permit := metadata.guard_edit()
        if permit.value.dropped || permit.value.references <= 0 {
            jet_eval_ownership_fail(&machine, span, "MIR SharedGuard preparation was already retired")
            return false
        }
        permit.value.references = 0
        permit.value.dropped = true
        permit.value.active = false
    }
    shared := 0
    {
        permit := lease.metadata.guard_edit()
        if permit.value.released || permit.value.handles != 1 {
            jet_eval_ownership_fail(&machine, span, "MIR SharedGuard preparation lease is inconsistent")
            return false
        }
        shared = permit.value.shared
        permit.value.handles = 0
        permit.value.dirty = false
        permit.value.released = true
    }
    jet_eval_shared_runtime_release_shared(&machine, shared, span)
}

fn jet_eval_shared_runtime_guard_acquire(machine: &JetEvalMachine, shared: Int, row: MirPreludeCall, editable: Bool, span: Span) -> ?JetEvalRuntimeValue {
    index :: jet_eval_shared_runtime_guard_prepare(&machine, shared, row, editable, span) ?? return None
    carrier := JetEvalRuntimeValue.SharedGuard(index)
    physical := jet_eval_shared_runtime_physical(
        &machine,
        JetEvalSharedPhysicalOp.Acquire(editable),
        row,
        None,
        JetEvalRuntimeValue.Shared(shared),
        Val(carrier),
        None,
        None,
        span,
    )
    if !jet_eval_shared_runtime_physical_ok(physical, &machine, span) {
        jet_eval_shared_runtime_guard_abandon_prepared(&machine, index, span)
        return None
    }
    if !jet_eval_shared_runtime_guard_set_active(&machine, index, true, span) {
        jet_eval_shared_runtime_guard_release(&machine, index, span)
        return None
    }
    Val(carrier)
}

fn jet_eval_shared_runtime_revision_advance(machine: &JetEvalMachine, shared: Int, span: Span) -> Bool {
    entry :: jet_eval_shared_runtime_value(&machine, shared) ?? {
        jet_eval_ownership_fail(&machine, span, "MIR Shared revision has an unknown registry identity")
        return false
    }
    permit := entry.metadata.guard_edit()
    if permit.value.dropped || permit.value.references <= 0 {
        jet_eval_ownership_fail(&machine, span, "MIR Shared revision updated after owner release")
        return false
    }
    if permit.value.revision == @JET_EVAL_SHARED_REVISION_MAX {
        jet_eval_source_fail(&machine, span, "SharedRevisionError.GenerationExhausted")
        return false
    }
    permit.value.revision += 1
    true
}

fn jet_eval_shared_runtime_revision_can_advance(machine: &JetEvalMachine, shared: Int, guard: Int, row: MirPreludeCall, span: Span) -> Bool {
    revision :: jet_eval_shared_runtime_revision_under_guard(&machine, shared, guard, row, span) ?? {
        jet_eval_ownership_fail(&machine, span, "MIR Shared revision root is unavailable")
        return false
    }
    if revision == @JET_EVAL_SHARED_REVISION_MAX {
        jet_eval_source_fail(&machine, span, "SharedRevisionError.GenerationExhausted")
        return false
    }
    true
}

pub struct JetEvalSharedGuardInfo {
    pub shared: Int
    pub owner_row: MirPreludeCall
    pub path: [MirFieldId]
    pub editable: Bool
    pub entry_read_loan: ?Int
    pub lease: JetEvalSharedGuardLease
}

fn jet_eval_shared_runtime_guard_info(machine: &JetEvalMachine, index: Int, span: Span) -> ?JetEvalSharedGuardInfo {
    entry :: jet_eval_shared_runtime_guard_record(&machine, index, span) ?? return None
    permit := entry.metadata.guard_read()
    lease := permit.value.lease
    lease_permit := lease.metadata.guard_read()
    if lease_permit.value.released || lease_permit.value.handles <= 0 {
        jet_eval_ownership_fail(&machine, span, "MIR SharedGuard lease is no longer live")
        return None
    }
    Val(JetEvalSharedGuardInfo{
        shared: lease_permit.value.shared,
        owner_row: permit.value.owner_row,
        path: permit.value.path,
        editable: permit.value.editable,
        entry_read_loan: jet_eval_shared_runtime_entry_read_guard_loan_id(&machine, index),
        lease: lease,
    })
}

fn jet_eval_shared_runtime_guard_consume(machine: &JetEvalMachine, index: Int, split_children: Int, span: Span) -> ?JetEvalSharedGuardInfo {
    info :: jet_eval_shared_runtime_guard_info(&machine, index, span) ?? return None
    entry :: jet_eval_shared_runtime_guard(&machine, index) ?? return None
    {
        permit := entry.metadata.guard_edit()
        if permit.value.dropped || permit.value.references <= 0 || !permit.value.active {
            jet_eval_source_fail(&machine, span, "jet_shared_guard_invalid")
            return None
        }
        permit.value.references = 0
        permit.value.dropped = true
        permit.value.active = false
    }
    {
        permit := info.lease.metadata.guard_edit()
        if permit.value.released || permit.value.handles <= 0 {
            jet_eval_ownership_fail(&machine, span, "MIR SharedGuard lease is no longer live")
            return None
        }
        if split_children > 1 -> permit.value.handles += split_children - 1
    }
    Val(info)
}

fn jet_eval_shared_runtime_guard_release(machine: &JetEvalMachine, index: Int, span: Span) -> Bool {
    info :: jet_eval_shared_runtime_guard_info(&machine, index, span) ?? return false
    entry :: jet_eval_shared_runtime_guard(&machine, index) ?? return false
    borrowed := info.entry_read_loan != None
    {
        permit := entry.metadata.guard_edit()
        if permit.value.dropped || permit.value.references <= 0 {
            jet_eval_ownership_fail(&machine, span, "MIR SharedGuard was released more than once")
            return false
        }
        permit.value.references = 0
        permit.value.dropped = true
        permit.value.active = false
    }
    final := false
    dirty := false
    {
        permit := info.lease.metadata.guard_edit()
        if permit.value.released || permit.value.handles <= 0 {
            jet_eval_ownership_fail(&machine, span, "MIR SharedGuard lease was released more than once")
            return false
        }
        permit.value.handles -= 1
        final = permit.value.handles == 0
        if final {
            permit.value.released = true
            dirty = permit.value.dirty
            permit.value.dirty = false
        }
    }
    revision_ok := true
    if final && dirty && !borrowed -> revision_ok = jet_eval_shared_runtime_revision_advance(&machine, info.shared, span)
    physical_ok := true
    if !borrowed {
        physical := jet_eval_shared_runtime_physical(
            &machine,
            JetEvalSharedPhysicalOp.Release,
            info.owner_row,
            None,
            JetEvalRuntimeValue.Shared(info.shared),
            Val(JetEvalRuntimeValue.SharedGuard(index)),
            None,
            None,
            span,
        )
        physical_ok = jet_eval_shared_runtime_physical_ok(physical, &machine, span)
    }
    root_ok := if final && !borrowed -> jet_eval_shared_runtime_release_shared(&machine, info.shared, span) else -> true
    revision_ok && physical_ok && root_ok
}
pub struct JetEvalSharedCallbackResult {
    pub result: JetEvalRuntimeValue
    pub value: JetEvalRuntimeValue
}

fn jet_eval_shared_runtime_callback(machine: &JetEvalMachine, frame_index: Int, closure: JetEvalRuntimeValue, value: JetEvalRuntimeValue, access: MirAccess, span: Span) -> ?JetEvalSharedCallbackResult {
    if closure != {.Closure(_, _) -> true else -> false} {
        jet_eval_compiler_fail(&machine, span, "MIR Shared callback is not a checked Source closure")
        jet_eval_drop_value(&machine, value, span)
        return None
    }
    callback :: jet_eval_copy_value(closure, &machine, span) ?? {
        jet_eval_drop_value(&machine, value, span)
        return None
    }
    cell := jet_eval_new_shared_cell(&machine, value, access)
    alias :: jet_eval_copy_value(cell, &machine, span) ?? {
        jet_eval_drop_value(&machine, callback, span)
        jet_eval_drop_value(&machine, cell, span)
        return None
    }
    result :: jet_eval_invoke_host_callback(&machine, callback, [JetEvalRuntimeValue]{alias}, span) ?? {
        jet_eval_drop_value(&machine, cell, span)
        return None
    }
    cell_index :: if cell == {.SharedCell(index, _) -> index else -> -1}
    if cell_index < 0 {
        jet_eval_compiler_fail(&machine, span, "MIR Shared callback cell was not allocated")
        jet_eval_drop_value(&machine, cell, span)
        jet_eval_drop_value(&machine, result, span)
        return None
    }
    if !jet_eval_shared_cell_claim_sole(&machine, cell_index, span) {
        jet_eval_drop_value(&machine, cell, span)
        jet_eval_drop_value(&machine, result, span)
        return None
    }
    updated := jet_eval_shared_cell_take_payload(&machine, cell_index)
    Val(JetEvalSharedCallbackResult{result: result, value: updated})
}

fn jet_eval_shared_runtime_result_error_named(name: String, variant: String) -> JetEvalRuntimeValue {
    JetEvalRuntimeValue.Data(TComptimeValue.Enum(name, variant, [TComptimeEnumArg]{}))
}

fn jet_eval_shared_runtime_checked_result(ok: Bool, value: JetEvalRuntimeValue) -> JetEvalRuntimeValue {
    JetEvalRuntimeValue.Result(ok, value)
}

fn jet_eval_shared_runtime_absent(machine: &JetEvalMachine, result_ty: ?MirType, span: Span) -> ?JetEvalRuntimeValue {
    if result_ty == {
        Val(ty) -> if ty.kind == {.Option(inner) -> return Val(JetEvalRuntimeValue.Absent(inner))}
        None -> {}
    }
    jet_eval_compiler_fail(&machine, span, "MIR Shared.Weak.upgrade has no checked optional result type")
    None
}

fn jet_eval_shared_runtime_shared_index(machine: &JetEvalMachine, value: JetEvalRuntimeValue, span: Span) -> ?Int {
    if value == {.Shared(index) -> return Val(index)}
    jet_eval_compiler_fail(&machine, span, "MIR Shared route received a non-Shared root carrier")
    None
}

fn jet_eval_shared_runtime_snapshot_index(machine: &JetEvalMachine, value: JetEvalRuntimeValue, span: Span) -> ?Int {
    if value == {.SharedSnapshot(index) -> return Val(index)}
    jet_eval_compiler_fail(&machine, span, "MIR Shared route received a non-Snapshot carrier")
    None
}

fn jet_eval_shared_runtime_weak_index(machine: &JetEvalMachine, value: JetEvalRuntimeValue, span: Span) -> ?Int {
    if value == {.SharedWeak(index) -> return Val(index)}
    jet_eval_compiler_fail(&machine, span, "MIR Shared route received a non-Weak carrier")
    None
}


fn jet_eval_shared_runtime_guard_mark_dirty(machine: &JetEvalMachine, guard: Int, span: Span) -> Bool {
    entry :: jet_eval_shared_runtime_guard_record(&machine, guard, span) ?? return false
    permit := entry.metadata.guard_read()
    lease := permit.value.lease
    lease_permit := lease.metadata.guard_edit()
    if lease_permit.value.released || lease_permit.value.handles <= 0 {
        jet_eval_ownership_fail(&machine, span, "MIR SharedGuard lease is no longer live")
        return false
    }
    if !permit.value.editable {
        jet_eval_source_fail(&machine, span, "jet_shared_guard_edit_required")
        return false
    }
    lease_permit.value.dirty = true
    true
}

fn jet_eval_shared_runtime_scoped_callback(machine: &JetEvalMachine, frame_index: Int, shared: Int, row: MirPreludeCall, callback: JetEvalRuntimeValue, editable: Bool, span: Span) -> ?JetEvalRuntimeValue {
    guard :: jet_eval_shared_runtime_guard_acquire(&machine, shared, row, editable, span) ?? return None
    guard_index :: if guard == {.SharedGuard(index) -> index else -> -1}
    if guard_index < 0 {
        jet_eval_compiler_fail(&machine, span, "MIR Shared guard acquisition returned a non-guard carrier")
        jet_eval_drop_value(&machine, guard, span)
        return None
    }
    if editable && !jet_eval_shared_runtime_revision_can_advance(&machine, shared, guard_index, row, span) {
        jet_eval_shared_runtime_guard_release(&machine, guard_index, span)
        return None
    }
    value :: jet_eval_shared_runtime_guard_read(&machine, frame_index, guard_index, [MirProjection]{}, span) ?? {
        jet_eval_shared_runtime_guard_release(&machine, guard_index, span)
        return None
    }
    callback_result := jet_eval_shared_runtime_callback(
        &machine,
        frame_index,
        callback,
        value,
        if editable -> MirAccess.Write else -> MirAccess.Read,
        span,
    )
    if callback_result == None {
        jet_eval_shared_runtime_guard_release(&machine, guard_index, span)
        return None
    }
    output :: callback_result ?? return None
    if editable {
        if !jet_eval_shared_runtime_guard_write(&machine, frame_index, guard_index, [MirProjection]{}, output.value, span) {
            jet_eval_drop_value(&machine, output.result, span)
            jet_eval_shared_runtime_guard_release(&machine, guard_index, span)
            return None
        }
        if !jet_eval_shared_runtime_guard_release(&machine, guard_index, span) {
            jet_eval_drop_value(&machine, output.result, span)
            return None
        }
        return Val(output.result)
    }
    if !jet_eval_drop_value(&machine, output.value, span) -> {
        jet_eval_shared_runtime_guard_release(&machine, guard_index, span)
        jet_eval_drop_value(&machine, output.result, span)
        return None
    }
    if !jet_eval_shared_runtime_guard_release(&machine, guard_index, span) {
        jet_eval_drop_value(&machine, output.result, span)
        return None
    }
    Val(output.result)
}
fn jet_eval_shared_runtime_guard_map_row_valid(row: MirPreludeCall, editable: Bool) -> Bool {
    member := if editable -> "map_edit" else -> "map_read"
    row.fallibility == MirCallFallibility.Infallible
        && jet_eval_shared_runtime_row_matches(
            row,
            .StaticPrelude,
            "core.shared_guard",
            member,
            "jet_shared_guard_map",
            .Control,
            [Bool]{true, false, false},
        )
}

fn jet_eval_shared_runtime_guard_split_row_valid(row: MirPreludeCall, editable: Bool) -> Bool {
    member := if editable -> "split_edit" else -> "split_read"
    row.fallibility == MirCallFallibility.Infallible
        && jet_eval_shared_runtime_row_matches(
            row,
            .StaticPrelude,
            "core.shared_guard",
            member,
            "jet_shared_guard_split",
            .Control,
            [Bool]{true, false, false, false},
        )
}

fn jet_eval_shared_runtime_guard_wait_row_valid(row: MirPreludeCall, result_ty: ?MirType) -> Bool {
    jet_eval_shared_runtime_fallibility_matches(row, result_ty)
        && jet_eval_shared_runtime_row_matches(
            row,
            .StaticPrelude,
            "core.shared_guard",
            "wait",
            "jet_shared_guard_wait_once",
            .Control,
            [Bool]{true, true, false},
        )
}


fn jet_eval_shared_runtime_guard_set_active(machine: &JetEvalMachine, index: Int, active: Bool, span: Span) -> Bool {
    entry :: jet_eval_shared_runtime_guard(&machine, index) ?? return false
    permit := entry.metadata.guard_edit()
    if permit.value.dropped || permit.value.references <= 0 -> return false
    permit.value.active = active
    true
}

fn jet_eval_shared_runtime_abandon_guard(machine: &JetEvalMachine, index: Int) {
    entry :: jet_eval_shared_runtime_guard(&machine, index) ?? return
    permit := entry.metadata.guard_edit()
    permit.value.references = 0
    permit.value.dropped = true
    permit.value.active = false
}

fn jet_eval_shared_runtime_guard_map(machine: &JetEvalMachine, frame_index: Int, call: MirPreludeCallId, guard_value: MirValueId, path: [MirFieldId], editable: Bool, span: Span) -> ?JetEvalRuntimeValue {
    row :: jet_eval_route_prelude_row(&machine, call, span) ?? return None
    if !jet_eval_shared_runtime_guard_map_row_valid(row, editable) {
        jet_eval_compiler_fail(&machine, span, "MIR SharedGuard map has non-canonical route metadata")
        return None
    }
    parent_value :: jet_eval_take(&machine, frame_index, guard_value, span) ?? return None
    parent_index :: if parent_value == {.SharedGuard(index) -> index else -> -1}
    if parent_index < 0 {
        jet_eval_compiler_fail(&machine, span, "MIR SharedGuard map received a non-guard carrier")
        jet_eval_drop_value(&machine, parent_value, span)
        return None
    }
    info :: jet_eval_shared_runtime_guard_info(&machine, parent_index, span) ?? {
        jet_eval_shared_runtime_guard_release(&machine, parent_index, span)
        return None
    }
    if editable && !info.editable {
        jet_eval_source_fail(&machine, span, "jet_shared_guard_edit_required")
        jet_eval_shared_runtime_guard_release(&machine, parent_index, span)
        return None
    }
    child_path := info.path
    loop field in path -> child_path.push(field)
    child_index := jet_eval_shared_runtime_guard_create(
        &machine,
        info.shared,
        info.owner_row,
        editable,
        child_path,
        info.lease,
        false,
        None,
    )
    if info.entry_read_loan == {
        Val(loan_index) -> if !jet_eval_shared_runtime_entry_read_guard_loan_link(&machine, child_index, loan_index) {
            jet_eval_ownership_fail(&machine, span, "MIR SharedGuard map could not retain its frame-scoped entry-loan group")
            jet_eval_shared_runtime_abandon_guard(&machine, child_index)
            jet_eval_shared_runtime_guard_release(&machine, parent_index, span)
            return None
        }
        None -> {}
    }
    child := JetEvalRuntimeValue.SharedGuard(child_index)
    physical := jet_eval_shared_runtime_physical(
        &machine,
        JetEvalSharedPhysicalOp.Map(child, path, editable),
        row,
        None,
        JetEvalRuntimeValue.Shared(info.shared),
        Val(parent_value),
        None,
        None,
        span,
    )
    if !jet_eval_shared_runtime_physical_ok(physical, &machine, span) {
        jet_eval_shared_runtime_abandon_guard(&machine, child_index)
        jet_eval_shared_runtime_guard_release(&machine, parent_index, span)
        return None
    }
    if jet_eval_shared_runtime_guard_consume(&machine, parent_index, 1, span) == None {
        jet_eval_shared_runtime_abandon_guard(&machine, child_index)
        return None
    }
    if !jet_eval_shared_runtime_guard_set_active(&machine, child_index, true, span) {
        jet_eval_shared_runtime_abandon_guard(&machine, child_index)
        return None
    }
    Val(child)
}

fn jet_eval_shared_runtime_guard_split_value(machine: &JetEvalMachine, result_ty: ?MirType, first: JetEvalRuntimeValue, second: JetEvalRuntimeValue, span: Span) -> ?JetEvalRuntimeValue {
    ty :: result_ty ?? {
        jet_eval_compiler_fail(&machine, span, "MIR SharedGuard split has no checked tuple result type")
        jet_eval_drop_value(&machine, first, span)
        jet_eval_drop_value(&machine, second, span)
        return None
    }
    if ty.kind == {.Tuple(fields) -> {
        if fields.len() != 2 {
            jet_eval_compiler_fail(&machine, span, "MIR SharedGuard split tuple result has the wrong arity")
            jet_eval_drop_value(&machine, first, span)
            jet_eval_drop_value(&machine, second, span)
            return None
        }
        output := [JetEvalRuntimeField]{
            JetEvalRuntimeField{name: fields[0].name, value: first},
            JetEvalRuntimeField{name: fields[1].name, value: second},
        }
        return Val(JetEvalRuntimeValue.Aggregate(JetEvalRuntimeAggregate.Struct(mir_type_display_name(ty), output)))
    }}
    jet_eval_compiler_fail(&machine, span, "MIR SharedGuard split result is not a checked tuple")
    jet_eval_drop_value(&machine, first, span)
    jet_eval_drop_value(&machine, second, span)
    None
}

fn jet_eval_shared_runtime_guard_split(machine: &JetEvalMachine, frame_index: Int, call: MirPreludeCallId, map_call: MirPreludeCallId, guard_value: MirValueId, first_path: [MirFieldId], second_path: [MirFieldId], editable: Bool, result_ty: ?MirType, span: Span) -> ?JetEvalRuntimeValue {
    row :: jet_eval_route_prelude_row(&machine, call, span) ?? return None
    map_row :: jet_eval_route_prelude_row(&machine, map_call, span) ?? return None
    if !jet_eval_shared_runtime_guard_split_row_valid(row, editable)
        || !jet_eval_shared_runtime_guard_map_row_valid(map_row, editable) {
        jet_eval_compiler_fail(&machine, span, "MIR SharedGuard split has invalid checked routes")
        return None
    }
    parent_value :: jet_eval_take(&machine, frame_index, guard_value, span) ?? return None
    parent_index :: if parent_value == {.SharedGuard(index) -> index else -> -1}
    if parent_index < 0 {
        jet_eval_compiler_fail(&machine, span, "MIR SharedGuard split received a non-guard carrier")
        jet_eval_drop_value(&machine, parent_value, span)
        return None
    }
    info :: jet_eval_shared_runtime_guard_info(&machine, parent_index, span) ?? {
        jet_eval_shared_runtime_guard_release(&machine, parent_index, span)
        return None
    }
    if editable && !info.editable {
        jet_eval_source_fail(&machine, span, "jet_shared_guard_edit_required")
        jet_eval_shared_runtime_guard_release(&machine, parent_index, span)
        return None
    }
    first_full := info.path
    loop field in first_path -> first_full.push(field)
    second_full := info.path
    loop field in second_path -> second_full.push(field)
    first_index := jet_eval_shared_runtime_guard_create(&machine, info.shared, info.owner_row, editable, first_full, info.lease, false, None)
    second_index := jet_eval_shared_runtime_guard_create(&machine, info.shared, info.owner_row, editable, second_full, info.lease, false, None)
    if info.entry_read_loan == {
        Val(loan_index) -> {
            first_linked := jet_eval_shared_runtime_entry_read_guard_loan_link(&machine, first_index, loan_index)
            second_linked := jet_eval_shared_runtime_entry_read_guard_loan_link(&machine, second_index, loan_index)
            if !first_linked || !second_linked {
                jet_eval_ownership_fail(&machine, span, "MIR SharedGuard split could not retain its frame-scoped entry-loan group")
                jet_eval_shared_runtime_abandon_guard(&machine, first_index)
                jet_eval_shared_runtime_abandon_guard(&machine, second_index)
                jet_eval_shared_runtime_guard_release(&machine, parent_index, span)
                return None
            }
        }
        None -> {}
    }
    first := JetEvalRuntimeValue.SharedGuard(first_index)
    second := JetEvalRuntimeValue.SharedGuard(second_index)
    physical := jet_eval_shared_runtime_physical(
        &machine,
        JetEvalSharedPhysicalOp.Split(first, second, first_path, second_path, editable),
        row,
        Val(map_row),
        JetEvalRuntimeValue.Shared(info.shared),
        Val(parent_value),
        None,
        None,
        span,
    )
    if !jet_eval_shared_runtime_physical_ok(physical, &machine, span) {
        jet_eval_shared_runtime_abandon_guard(&machine, first_index)
        jet_eval_shared_runtime_abandon_guard(&machine, second_index)
        jet_eval_shared_runtime_guard_release(&machine, parent_index, span)
        return None
    }
    if jet_eval_shared_runtime_guard_consume(&machine, parent_index, 2, span) == None {
        jet_eval_shared_runtime_abandon_guard(&machine, first_index)
        jet_eval_shared_runtime_abandon_guard(&machine, second_index)
        return None
    }
    if !jet_eval_shared_runtime_guard_set_active(&machine, first_index, true, span)
        || !jet_eval_shared_runtime_guard_set_active(&machine, second_index, true, span) {
        jet_eval_shared_runtime_abandon_guard(&machine, first_index)
        jet_eval_shared_runtime_abandon_guard(&machine, second_index)
        return None
    }
    jet_eval_shared_runtime_guard_split_value(&machine, result_ty, first, second, span)
}

fn jet_eval_shared_runtime_predicate(machine: &JetEvalMachine, callback: JetEvalRuntimeValue, span: Span) -> ?Bool {
    callback :: jet_eval_copy_value(callback, &machine, span) ?? return None
    result :: jet_eval_invoke_host_callback(&machine, callback, [JetEvalRuntimeValue]{}, span) ?? return None
    if result == {.Data(TComptimeValue.Bool(value)) -> {
        jet_eval_drop_value(&machine, result, span)
        return Val(value)
    }}
    jet_eval_compiler_fail(&machine, span, "MIR SharedGuard wait predicate did not return Bool")
    jet_eval_drop_value(&machine, result, span)
    None
}

fn jet_eval_shared_runtime_wait_publish(machine: &JetEvalMachine, info: JetEvalSharedGuardInfo, span: Span) -> Bool {
    dirty := false
    {
        permit := info.lease.metadata.guard_edit()
        if permit.value.released || permit.value.handles <= 0 {
            jet_eval_ownership_fail(&machine, span, "MIR SharedGuard lease is no longer live")
            return false
        }
        dirty = permit.value.dirty
        if dirty -> permit.value.dirty = false
    }
    if !dirty -> return true
    if !jet_eval_shared_runtime_revision_advance(&machine, info.shared, span) {
        permit := info.lease.metadata.guard_edit()
        permit.value.dirty = true
        return false
    }
    true
}

fn jet_eval_shared_runtime_guard_wait(machine: &JetEvalMachine, frame_index: Int, call: MirPreludeCallId, guard_value: MirValueId, condition_value: MirValueId, predicate_value: MirValueId, result_ty: ?MirType, span: Span) -> ?JetEvalRuntimeValue {
    row :: jet_eval_route_prelude_row(&machine, call, span) ?? return None
    if !jet_eval_shared_runtime_guard_wait_row_valid(row, result_ty) {
        jet_eval_compiler_fail(&machine, span, "MIR SharedGuard wait has non-canonical route metadata")
        return None
    }
    borrowed_guard :: machine.frames[frame_index].values.get(guard_value.value) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR SharedGuard wait guard is unavailable")
        return None
    }
    guard_index :: if borrowed_guard == {.SharedGuard(index) -> index else -> -1}
    if guard_index < 0 {
        jet_eval_compiler_fail(&machine, span, "MIR SharedGuard wait received a non-guard carrier")
        return None
    }
    borrowed_condition :: machine.frames[frame_index].values.get(condition_value.value) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR SharedGuard wait condition is unavailable")
        return None
    }
    condition_index :: if borrowed_condition == {.Condition(index) -> index else -> -1}
    if condition_index < 0 || !jet_eval_shared_runtime_condition_live(&machine, condition_index, span) {
        jet_eval_compiler_fail(&machine, span, "MIR SharedGuard wait received an invalid Condition carrier")
        return None
    }
    info :: jet_eval_shared_runtime_guard_info(&machine, guard_index, span) ?? return None
    if !info.editable {
        return Val(jet_eval_shared_runtime_checked_result(
            false,
            JetEvalRuntimeValue.Data(TComptimeValue.String("jet_shared_guard_edit_required")),
        ))
    }
    callback :: machine.frames[frame_index].values.get(predicate_value.value) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR SharedGuard wait predicate is unavailable")
        return None
    }
    loop {
        ready :: jet_eval_shared_runtime_predicate(&machine, callback, span) ?? return None
        if ready -> return Val(jet_eval_shared_runtime_checked_result(true, JetEvalRuntimeValue.Data(TComptimeValue.Unit)))
        if !jet_eval_shared_runtime_wait_publish(&machine, info, span) -> return None
        waited := jet_eval_shared_runtime_physical(
            &machine,
            JetEvalSharedPhysicalOp.WaitOnce,
            row,
            None,
            JetEvalRuntimeValue.Shared(info.shared),
            Val(JetEvalRuntimeValue.SharedGuard(guard_index)),
            Val(JetEvalRuntimeValue.Condition(condition_index)),
            result_ty,
            span,
        )
        wait_result :: waited ?? return None
        if wait_result == {
            .Result(false, _) -> return Val(wait_result)
            .RuntimeFailure(_, _) -> return None
            .Result(true, _) | .Data(TComptimeValue.Present(_)) -> {}
            .Data(TComptimeValue.Failed(TComptimeReport.Told(error))) -> {
                return Val(JetEvalRuntimeValue.Result(false, JetEvalRuntimeValue.Data(error)))
            }
            else -> {
                jet_eval_compiler_fail(&machine, span, "MIR SharedGuard wait physical result is not checked Result")
                return None
            }
        }
    }
}

fn jet_eval_shared_runtime_semantic(machine: &JetEvalMachine, frame_index: Int, operation: MirSemanticOp, result_ty: ?MirType, span: Span) -> ?JetEvalRuntimeValue {
    if operation == {
        .SharedGuardMap(call, guard, path, editable) -> return jet_eval_shared_runtime_guard_map(&machine, frame_index, call, guard, path, editable, span)
        .SharedGuardSplit(call, map_call, guard, first, second, editable) -> return jet_eval_shared_runtime_guard_split(&machine, frame_index, call, map_call, guard, first, second, editable, result_ty, span)
        .SharedGuardWait(call, guard, condition, predicate) -> return jet_eval_shared_runtime_guard_wait(&machine, frame_index, call, guard, condition, predicate, result_ty, span)
        else -> {
            jet_eval_compiler_fail(&machine, span, "MIR Shared semantic dispatcher received an unrelated operation")
            return None
        }
    }
}
fn jet_eval_shared_runtime_guard_index(machine: &JetEvalMachine, guard: JetEvalRuntimeValue, span: Span) -> ?Int {
    if guard == {.SharedGuard(index) -> return Val(index)}
    jet_eval_compiler_fail(&machine, span, "MIR Shared operation did not acquire a SharedGuard")
    None
}

fn jet_eval_shared_runtime_read_guard(machine: &JetEvalMachine, frame_index: Int, shared: Int, row: MirPreludeCall, span: Span) -> ?JetEvalRuntimeValue {
    guard :: jet_eval_shared_runtime_guard_acquire(&machine, shared, row, false, span) ?? return None
    index :: jet_eval_shared_runtime_guard_index(&machine, guard, span) ?? {
        jet_eval_drop_value(&machine, guard, span)
        return None
    }
    value := jet_eval_shared_runtime_guard_read(&machine, frame_index, index, [MirProjection]{}, span)
    if !jet_eval_shared_runtime_guard_release(&machine, index, span) {
        if value != None -> jet_eval_drop_value(&machine, value ?? JetEvalRuntimeValue.Moved, span)
        return None
    }
    value
}

fn jet_eval_shared_runtime_write(machine: &JetEvalMachine, shared: Int, row: MirPreludeCall, value: JetEvalRuntimeValue, return_old: Bool, span: Span) -> ?JetEvalRuntimeValue {
    guard :: jet_eval_shared_runtime_guard_acquire(&machine, shared, row, true, span) ?? {
        jet_eval_drop_value(&machine, value, span)
        return None
    }
    index :: jet_eval_shared_runtime_guard_index(&machine, guard, span) ?? {
        jet_eval_drop_value(&machine, value, span)
        jet_eval_drop_value(&machine, guard, span)
        return None
    }
    old :: jet_eval_shared_runtime_guard_read(&machine, 0, index, [MirProjection]{}, span) ?? {
        jet_eval_drop_value(&machine, value, span)
        jet_eval_shared_runtime_guard_release(&machine, index, span)
        return None
    }
    if !jet_eval_shared_runtime_guard_write(&machine, 0, index, [MirProjection]{}, value, span) {
        jet_eval_drop_value(&machine, old, span)
        jet_eval_shared_runtime_guard_release(&machine, index, span)
        return None
    }
    if !jet_eval_shared_runtime_guard_release(&machine, index, span) {
        jet_eval_drop_value(&machine, old, span)
        return None
    }
    if return_old -> return Val(old)
    if !jet_eval_drop_value(&machine, old, span) -> return None
    Val(JetEvalRuntimeValue.Data(TComptimeValue.Unit))
}

fn jet_eval_shared_runtime_capture(machine: &JetEvalMachine, frame_index: Int, shared: Int, row: MirPreludeCall, callback: ?JetEvalRuntimeValue, span: Span) -> ?JetEvalRuntimeValue {
    guard :: jet_eval_shared_runtime_guard_acquire(&machine, shared, row, false, span) ?? return None
    index :: jet_eval_shared_runtime_guard_index(&machine, guard, span) ?? {
        jet_eval_drop_value(&machine, guard, span)
        return None
    }
    revision :: jet_eval_shared_runtime_revision_under_guard(&machine, shared, index, row, span) ?? {
        jet_eval_shared_runtime_guard_release(&machine, index, span)
        return None
    }
    payload :: jet_eval_shared_runtime_guard_read(&machine, frame_index, index, [MirProjection]{}, span) ?? {
        jet_eval_shared_runtime_guard_release(&machine, index, span)
        return None
    }
    snapshot_value := payload
    if callback != None {
        callback_value :: callback ?? {
            jet_eval_drop_value(&machine, payload, span)
            jet_eval_shared_runtime_guard_release(&machine, index, span)
            return None
        }
        projected :: jet_eval_shared_runtime_callback(&machine, frame_index, callback_value, payload, MirAccess.Read, span) ?? {
            jet_eval_shared_runtime_guard_release(&machine, index, span)
            return None
        }
        if !jet_eval_drop_value(&machine, projected.value, span) {
            jet_eval_drop_value(&machine, projected.result, span)
            jet_eval_shared_runtime_guard_release(&machine, index, span)
            return None
        }
        snapshot_value = projected.result
    }
    if !jet_eval_shared_runtime_guard_release(&machine, index, span) {
        jet_eval_drop_value(&machine, snapshot_value, span)
        return None
    }
    jet_eval_shared_runtime_create_snapshot(&machine, shared, revision, snapshot_value, span)
}

fn jet_eval_shared_runtime_snapshot_value(machine: &JetEvalMachine, index: Int, span: Span) -> ?JetEvalRuntimeValue {
    entry :: jet_eval_shared_runtime_snapshot(&machine, index) ?? {
        jet_eval_ownership_fail(&machine, span, "MIR SharedSnapshot has an unknown registry identity")
        return None
    }
    if !jet_eval_shared_runtime_snapshot_live(&machine, index, span) -> return None
    storage := entry.storage
    permit := storage.guard_read()
    jet_eval_copy_value(permit.value.value, &machine, span)
}

fn jet_eval_shared_runtime_weak_upgrade(machine: &JetEvalMachine, index: Int, row: MirPreludeCall, result_ty: ?MirType, span: Span) -> ?JetEvalRuntimeValue {
    entry :: jet_eval_shared_runtime_weak(&machine, index) ?? {
        jet_eval_ownership_fail(&machine, span, "MIR Shared.Weak has an unknown registry identity")
        return None
    }
    if !jet_eval_shared_runtime_weak_live(&machine, index, span) -> return None
    physical := jet_eval_shared_runtime_physical(
        &machine,
        JetEvalSharedPhysicalOp.WeakUpgrade,
        row,
        None,
        JetEvalRuntimeValue.SharedWeak(index),
        None,
        None,
        result_ty,
        span,
    )
    if physical == None -> return None
    Val(physical ?? return None)
}
fn jet_eval_shared_runtime_notify(machine: &JetEvalMachine, row: MirPreludeCall, condition: Int, all: Bool, span: Span) -> ?JetEvalRuntimeValue {
    if !jet_eval_shared_runtime_condition_live(&machine, condition, span) -> return None
    result := jet_eval_shared_runtime_physical(
        &machine,
        JetEvalSharedPhysicalOp.Notify(all),
        row,
        None,
        JetEvalRuntimeValue.Data(TComptimeValue.Unit),
        None,
        Val(JetEvalRuntimeValue.Condition(condition)),
        None,
        span,
    )
    if !jet_eval_shared_runtime_physical_ok(result, &machine, span) -> return None
    Val(JetEvalRuntimeValue.Data(TComptimeValue.Unit))
}

pub fn jet_eval_shared_runtime_route(machine: &JetEvalMachine, row: MirPreludeCall, args: [JetEvalRuntimeValue], type_args: [MirType], result_ty: ?MirType, span: Span) -> ?JetEvalRuntimeValue {
    if !jet_eval_shared_runtime_host_row_valid(row) || !jet_eval_shared_runtime_fallibility_matches(row, result_ty) {
        jet_eval_compiler_fail(&machine, span, "MIR Shared route has non-canonical metadata")
        return None
    }
    if args.len() != row.signature.arity {
        jet_eval_compiler_fail(&machine, span, "MIR Shared route arguments disagree with its checked arity")
        return None
    }
    symbol := jet_eval_shared_runtime_row_symbol(row)
    if row.member == "new" && symbol == "jet_std::JetShared::new" {
        if args.len() != 1 {
            jet_eval_compiler_fail(&machine, span, "MIR Shared.new has invalid checked arity")
            return None
        }
        if type_args.len() != 1 {
            jet_eval_compiler_fail(&machine, span, "MIR Shared.new has invalid checked element type")
            return None
        }
        value :: jet_eval_copy_value(args[0], &machine, span) ?? return None
        return jet_eval_shared_runtime_create(&machine, value, type_args[0], row, span)
    }
    if row.member == "new" && symbol == "jet_std::JetCondition::new" {
        if args.len() != 0 {
            jet_eval_compiler_fail(&machine, span, "MIR Condition.new has invalid checked arity")
            return None
        }
        return jet_eval_shared_runtime_create_condition(&machine, row, span)
    }
    if row.member == "Shared.get" || row.member == "Shared.set" || row.member == "Shared.replace"
        || row.member == "Shared.read" || row.member == "Shared.edit"
        || row.member == "Shared.capture" || row.member == "Shared.capture_txn"
        || row.member == "Shared.read_txn" || row.member == "Shared.edit_txn"
        || row.member == "Shared.try_replace" || row.member == "Shared.guard_read"
        || row.member == "Shared.guard_edit" || row.member == "Shared.downgrade"
        || row.member == "Shared.strong_count" {
        if args.len() == 0 {
            jet_eval_compiler_fail(&machine, span, "MIR Shared route has no receiver")
            return None
        }
        shared :: jet_eval_shared_runtime_shared_index(&machine, args[0], span) ?? return None
        if !jet_eval_shared_runtime_value_live(&machine, shared, span) -> return None
        if row.member == "Shared.get" {
            transaction := jet_eval_shared_runtime_current_transaction(&machine)
            if transaction != None {
                transaction_id :: transaction ?? return None
                return jet_eval_shared_runtime_transaction_direct_read(&machine, transaction_id, shared, row, span)
            }
            return jet_eval_shared_runtime_read_guard(&machine, 0, shared, row, span)
        }
        if row.member == "Shared.set" || row.member == "Shared.replace" {
            if args.len() != 2 {
                jet_eval_compiler_fail(&machine, span, "MIR Shared write route has invalid checked arity")
                return None
            }
            value :: jet_eval_copy_value(args[1], &machine, span) ?? return None
            transaction := jet_eval_shared_runtime_current_transaction(&machine)
            if transaction != None {
                transaction_id :: transaction ?? {
                    jet_eval_drop_value(&machine, value, span)
                    return None
                }
                return jet_eval_shared_runtime_transaction_direct_write(
                    &machine,
                    transaction_id,
                    shared,
                    row,
                    value,
                    row.member == "Shared.replace",
                    span,
                )
            }
            return jet_eval_shared_runtime_write(&machine, shared, row, value, row.member == "Shared.replace", span)
        }
        if row.member == "Shared.read" || row.member == "Shared.edit" {
            if args.len() != 2 {
                jet_eval_compiler_fail(&machine, span, "MIR Shared callback route has invalid checked arity")
                return None
            }
            if jet_eval_shared_runtime_current_transaction(&machine) != None {
                return jet_eval_shared_runtime_transaction_direct_callback(
                    &machine,
                    0,
                    shared,
                    row,
                    args[1],
                    row.member == "Shared.edit",
                    span,
                )
            }
            return jet_eval_shared_runtime_scoped_callback(&machine, 0, shared, row, args[1], row.member == "Shared.edit", span)
        }
        if row.member == "Shared.capture" {
            callback := if args.len() == 2 -> Val(args[1]) else -> None
            if jet_eval_shared_runtime_current_transaction(&machine) != None {
                return jet_eval_shared_runtime_transaction_direct_capture(&machine, 0, shared, row, callback, span)
            }
            return jet_eval_shared_runtime_capture(&machine, 0, shared, row, callback, span)
        }
        if row.member == "Shared.read_txn" -> return jet_eval_shared_runtime_transaction_callback(&machine, 0, shared, row, args, false, false, span)
        if row.member == "Shared.edit_txn" -> return jet_eval_shared_runtime_transaction_callback(&machine, 0, shared, row, args, true, false, span)
        if row.member == "Shared.capture_txn" -> return jet_eval_shared_runtime_transaction_capture(&machine, 0, shared, row, args, span)
        if row.member == "Shared.try_replace" -> return jet_eval_shared_runtime_try_replace(&machine, shared, row, args, result_ty, span)
        if row.member == "Shared.guard_read" -> return jet_eval_shared_runtime_guard_acquire(&machine, shared, row, false, span)
        if row.member == "Shared.guard_edit" -> return jet_eval_shared_runtime_guard_acquire(&machine, shared, row, true, span)
        if row.member == "Shared.downgrade" -> return jet_eval_shared_runtime_create_weak(&machine, shared, row, span)
        if row.member == "Shared.strong_count" {
            count :: jet_eval_shared_runtime_physical(
                &machine,
                JetEvalSharedPhysicalOp.StrongCount,
                row,
                None,
                JetEvalRuntimeValue.Shared(shared),
                None,
                None,
                Val(mir_type_from_kind(MirTypeKind.Int)),
                span,
            ) ?? return None
            if count == {.Data(TComptimeValue.Int(_)) -> return Val(count)}
            if count == {.RuntimeFailure(_, _) -> return Val(count)}
            jet_eval_compiler_fail(&machine, span, "MIR Shared strong_count returned a non-Int value")
            return None
        }
    }
    if row.member == "SharedSnapshot.value" {
        if args.len() != 1 {
            jet_eval_compiler_fail(&machine, span, "MIR SharedSnapshot.value has invalid checked arity")
            return None
        }
        index :: jet_eval_shared_runtime_snapshot_index(&machine, args[0], span) ?? return None
        return jet_eval_shared_runtime_snapshot_value(&machine, index, span)
    }
    if row.member == "Shared.Weak.upgrade" {
        if args.len() != 1 {
            jet_eval_compiler_fail(&machine, span, "MIR Shared.Weak.upgrade has invalid checked arity")
            return None
        }
        index :: jet_eval_shared_runtime_weak_index(&machine, args[0], span) ?? return None
        return jet_eval_shared_runtime_weak_upgrade(&machine, index, row, result_ty, span)
    }
    if row.member == "notify_one" || row.member == "notify_all" {
        if args.len() != 1 {
            jet_eval_compiler_fail(&machine, span, "MIR Condition notification has invalid checked arity")
            return None
        }
        condition := if args[0] == {.Condition(index) -> index else -> -1}
        if condition < 0 {
            jet_eval_compiler_fail(&machine, span, "MIR Condition notification received a non-Condition carrier")
            return None
        }
        return jet_eval_shared_runtime_notify(&machine, row, condition, row.member == "notify_all", span)
    }
    jet_eval_compiler_fail(&machine, span, "MIR Shared route row has no Source semantics")
    None
}
fn jet_eval_shared_runtime_transaction_for_scope(machine: &JetEvalMachine, frame_index: Int, scope: MirScopeId) -> ?Int {
    runtime := machine.registry.shared_runtime
    storage := runtime.storage
    permit := storage.guard_read()
    loop index in 0..<permit.value.transactions.len() {
        transaction := permit.value.transactions[index]
        transaction_permit := transaction.storage.guard_read()
        if transaction_permit.value.machine == machine.identity
            && transaction_permit.value.frame_index == frame_index
            && transaction_permit.value.scope == scope
            && transaction_permit.value.active {
            return Val(index)
        }
    }
    None
}

fn jet_eval_shared_runtime_current_transaction(machine: &JetEvalMachine) -> ?Int {
    frame_index := machine.frames.len()
    loop frame_index > 0 {
        frame_index -= 1
        scopes := machine.frames[frame_index].scopes
        scope_index := scopes.len()
        loop scope_index > 0 {
            scope_index -= 1
            transaction :: jet_eval_shared_runtime_transaction_for_scope(&machine, frame_index, scopes[scope_index]) ?? next
        }
    }
    None
}

fn jet_eval_shared_runtime_transaction_part(machine: &JetEvalMachine, transaction: Int, shared: Int) -> ?JetEvalSharedTransactionPart {
    entry :: jet_eval_shared_runtime_transaction(&machine, transaction) ?? return None
    permit := entry.storage.guard_read()
    loop part in permit.value.participants {
        if jet_eval_shared_runtime_same_shared_root(&machine, part.shared, shared) -> return Val(part)
    }
    None
}

fn jet_eval_shared_runtime_transaction_state(machine: &JetEvalMachine, transaction: Int) -> ?JetEvalSharedTransactionState {
    entry :: jet_eval_shared_runtime_transaction(&machine, transaction) ?? return None
    permit := entry.storage.guard_read()
    Val(permit.value)
}

fn jet_eval_shared_runtime_transaction_parent_value(machine: &JetEvalMachine, transaction: Int, shared: Int) -> ?JetEvalSharedTransactionPart {
    state :: jet_eval_shared_runtime_transaction_state(&machine, transaction) ?? return None
    parent := state.parent
    loop parent != None {
        parent_id :: parent ?? return None
        part := jet_eval_shared_runtime_transaction_part(&machine, parent_id, shared)
        if part != None -> return part
        parent_state :: jet_eval_shared_runtime_transaction_state(&machine, parent_id) ?? return None
        parent = parent_state.parent
    }
    None
}

fn jet_eval_shared_runtime_transaction_insert_part(machine: &JetEvalMachine, transaction: Int, part: JetEvalSharedTransactionPart, span: Span) -> Int {
    entry :: jet_eval_shared_runtime_transaction(&machine, transaction) ?? {
        jet_eval_ownership_fail(&machine, span, "MIR Shared transaction scope is unavailable")
        return -1
    }
    permit := entry.storage.guard_edit()
    if !permit.value.active {
        jet_eval_ownership_fail(&machine, span, "MIR Shared transaction scope is already closed")
        return -1
    }
    loop index in 0..<permit.value.participants.len() {
        if jet_eval_shared_runtime_same_shared_root(&machine, permit.value.participants[index].shared, part.shared) {
            jet_eval_ownership_fail(&machine, span, "MIR Shared transaction participant was inserted twice")
            return -1
        }
    }
    index := permit.value.participants.len()
    permit.value.participants.push(part)
    index
}

fn jet_eval_shared_runtime_transaction_touch(machine: &JetEvalMachine, transaction: Int, shared: Int, row: MirPreludeCall, span: Span) -> ?Int {
    state :: jet_eval_shared_runtime_transaction_state(&machine, transaction) ?? {
        jet_eval_ownership_fail(&machine, span, "MIR Shared transaction scope is unavailable")
        return None
    }
    if !state.active {
        jet_eval_source_fail(&machine, span, "Shared transaction is closed")
        return None
    }
    loop index in 0..<state.participants.len() {
        if jet_eval_shared_runtime_same_shared_root(&machine, state.participants[index].shared, shared) -> return Val(index)
    }
    inherited := jet_eval_shared_runtime_transaction_parent_value(&machine, transaction, shared)
    value := None
    base_revision := 0
    if inherited != None {
        parent_part :: inherited ?? return None
        copied :: jet_eval_copy_value(parent_part.value, &machine, span) ?? return None
        value = Val(copied)
        base_revision = parent_part.base_revision
    } else {
        guard :: jet_eval_shared_runtime_guard_acquire(&machine, shared, row, false, span) ?? return None
        guard_index :: jet_eval_shared_runtime_guard_index(&machine, guard, span) ?? {
            jet_eval_drop_value(&machine, guard, span)
            return None
        }
        revision :: jet_eval_shared_runtime_revision_under_guard(&machine, shared, guard_index, row, span) ?? {
            jet_eval_shared_runtime_guard_release(&machine, guard_index, span)
            return None
        }
        payload :: jet_eval_shared_runtime_guard_read(&machine, 0, guard_index, [MirProjection]{}, span) ?? {
            jet_eval_shared_runtime_guard_release(&machine, guard_index, span)
            return None
        }
        if !jet_eval_shared_runtime_guard_release(&machine, guard_index, span) {
            jet_eval_drop_value(&machine, payload, span)
            return None
        }
        value = Val(payload)
        base_revision = revision
    }
    payload :: value ?? return None
    if !jet_eval_shared_runtime_retain(&machine, JetEvalRuntimeValue.Shared(shared), span) {
        jet_eval_drop_value(&machine, payload, span)
        return None
    }
    part := JetEvalSharedTransactionPart{
        shared: shared,
        value: payload,
        base_revision: base_revision,
        writes: false,
        retained: true,
        row: row,
        snapshots: [Int]{},
    }
    index := jet_eval_shared_runtime_transaction_insert_part(&machine, transaction, part, span)
    if index < 0 {
        jet_eval_drop_value(&machine, payload, span)
        jet_eval_shared_runtime_release_shared(&machine, shared, span)
        return None
    }
    Val(index)
}

fn jet_eval_shared_runtime_transaction_part_copy(machine: &JetEvalMachine, transaction: Int, shared: Int, span: Span) -> ?JetEvalRuntimeValue {
    part :: jet_eval_shared_runtime_transaction_part(&machine, transaction, shared) ?? {
        jet_eval_ownership_fail(&machine, span, "MIR Shared transaction participant was not touched")
        return None
    }
    jet_eval_copy_value(part.value, &machine, span)
}

fn jet_eval_shared_runtime_transaction_invalidate_snapshot(machine: &JetEvalMachine, snapshot: Int) {
    entry :: jet_eval_shared_runtime_snapshot(&machine, snapshot) ?? return
    permit := entry.metadata.guard_edit()
    if !permit.value.dropped -> permit.value.valid = false
}

fn jet_eval_shared_runtime_transaction_store_write(machine: &JetEvalMachine, transaction: Int, shared: Int, row: MirPreludeCall, value: JetEvalRuntimeValue, span: Span) -> Bool {
    entry :: jet_eval_shared_runtime_transaction(&machine, transaction) ?? {
        jet_eval_drop_value(&machine, value, span)
        return false
    }
    old := JetEvalRuntimeValue.Moved
    snapshots := [Int]{}
    found := false
    {
        permit := entry.storage.guard_edit()
        if !permit.value.active {
            jet_eval_source_fail(&machine, span, "Shared transaction is closed")
            jet_eval_drop_value(&machine, value, span)
            return false
        }
        loop index in 0..<permit.value.participants.len() {
            if jet_eval_shared_runtime_same_shared_root(&machine, permit.value.participants[index].shared, shared) {
                old = permit.value.participants[index].value
                permit.value.participants[index].value = value
                permit.value.participants[index].writes = true
                permit.value.participants[index].row = row
                snapshots = permit.value.participants[index].snapshots
                found = true
                break
            }
        }
    }
    if !found {
        jet_eval_ownership_fail(&machine, span, "MIR Shared transaction write has no participant")
        jet_eval_drop_value(&machine, value, span)
        return false
    }
    loop snapshot in snapshots -> jet_eval_shared_runtime_transaction_invalidate_snapshot(&machine, snapshot)
    if old != JetEvalRuntimeValue.Moved && !jet_eval_drop_value(&machine, old, span) -> return false
    true
}

fn jet_eval_shared_runtime_transaction_record_snapshot(machine: &JetEvalMachine, transaction: Int, shared: Int, snapshot: Int, span: Span) -> Bool {
    entry :: jet_eval_shared_runtime_transaction(&machine, transaction) ?? return false
    permit := entry.storage.guard_edit()
    if !permit.value.active {
        jet_eval_source_fail(&machine, span, "Shared transaction is closed")
        return false
    }
    found := false
    loop index in 0..<permit.value.participants.len() {
        if jet_eval_shared_runtime_same_shared_root(&machine, permit.value.participants[index].shared, shared) {
            permit.value.participants[index].snapshots.push(snapshot)
            found = true
            break
        }
    }
    if !found {
        jet_eval_ownership_fail(&machine, span, "MIR Shared transaction snapshot has no participant")
        return false
    }
    permit.value.snapshots.push(snapshot)
    true
}

fn jet_eval_shared_runtime_transaction_callback(machine: &JetEvalMachine, frame_index: Int, shared: Int, row: MirPreludeCall, args: [JetEvalRuntimeValue], editable: Bool, return_result: Bool, span: Span) -> ?JetEvalRuntimeValue {
    if args.len() != 3 || args[1] != JetEvalRuntimeValue.Data(TComptimeValue.Unit) {
        jet_eval_compiler_fail(&machine, span, "MIR Shared transaction callback has invalid checked operands")
        return None
    }
    transaction :: jet_eval_shared_runtime_current_transaction(&machine) ?? {
        jet_eval_source_fail(&machine, span, "Shared transaction operation used outside #Transact")
        return None
    }
    if jet_eval_shared_runtime_transaction_touch(&machine, transaction, shared, row, span) == None -> return None
    value :: jet_eval_shared_runtime_transaction_part_copy(&machine, transaction, shared, span) ?? return None
    output :: jet_eval_shared_runtime_callback(
        &machine,
        frame_index,
        args[2],
        value,
        if editable -> MirAccess.Write else -> MirAccess.Read,
        span,
    ) ?? return None
    if editable {
        if return_result {
            if !jet_eval_shared_runtime_transaction_store_write(&machine, transaction, shared, row, output.value, span) {
                jet_eval_drop_value(&machine, output.result, span)
                return None
            }
            return Val(output.result)
        }
        if !jet_eval_drop_value(&machine, output.result, span) {
            jet_eval_drop_value(&machine, output.value, span)
            return None
        }
        if !jet_eval_shared_runtime_transaction_store_write(&machine, transaction, shared, row, output.value, span) -> return None
        return Val(JetEvalRuntimeValue.Data(TComptimeValue.Unit))
    }
    if !jet_eval_drop_value(&machine, output.value, span) {
        jet_eval_drop_value(&machine, output.result, span)
        return None
    }
    Val(output.result)
}

fn jet_eval_shared_runtime_transaction_direct_read(machine: &JetEvalMachine, transaction: Int, shared: Int, row: MirPreludeCall, span: Span) -> ?JetEvalRuntimeValue {
    if jet_eval_shared_runtime_transaction_touch(&machine, transaction, shared, row, span) == None -> return None
    jet_eval_shared_runtime_transaction_part_copy(&machine, transaction, shared, span)
}

fn jet_eval_shared_runtime_transaction_direct_write(machine: &JetEvalMachine, transaction: Int, shared: Int, row: MirPreludeCall, value: JetEvalRuntimeValue, return_old: Bool, span: Span) -> ?JetEvalRuntimeValue {
    if jet_eval_shared_runtime_transaction_touch(&machine, transaction, shared, row, span) == None {
        jet_eval_drop_value(&machine, value, span)
        return None
    }
    old := JetEvalRuntimeValue.Moved
    if return_old {
        old_value :: jet_eval_shared_runtime_transaction_part_copy(&machine, transaction, shared, span) ?? {
            jet_eval_drop_value(&machine, value, span)
            return None
        }
        old = old_value
    }
    if !jet_eval_shared_runtime_transaction_store_write(&machine, transaction, shared, row, value, span) {
        if old != JetEvalRuntimeValue.Moved -> jet_eval_drop_value(&machine, old, span)
        return None
    }
    if return_old -> return Val(old)
    Val(JetEvalRuntimeValue.Data(TComptimeValue.Unit))
}

fn jet_eval_shared_runtime_transaction_direct_callback(machine: &JetEvalMachine, frame_index: Int, shared: Int, row: MirPreludeCall, callback: JetEvalRuntimeValue, editable: Bool, span: Span) -> ?JetEvalRuntimeValue {
    args := [JetEvalRuntimeValue]{
        JetEvalRuntimeValue.Shared(shared),
        JetEvalRuntimeValue.Data(TComptimeValue.Unit),
        callback,
    }
    jet_eval_shared_runtime_transaction_callback(&machine, frame_index, shared, row, args, editable, row.member == "Shared.edit", span)
}

fn jet_eval_shared_runtime_transaction_direct_capture(machine: &JetEvalMachine, frame_index: Int, shared: Int, row: MirPreludeCall, callback: ?JetEvalRuntimeValue, span: Span) -> ?JetEvalRuntimeValue {
    args := [JetEvalRuntimeValue]{
        JetEvalRuntimeValue.Shared(shared),
        JetEvalRuntimeValue.Data(TComptimeValue.Unit),
    }
    if callback != None -> {
        callback_value :: callback ?? return None
        args.push(callback_value)
    }
    jet_eval_shared_runtime_transaction_capture(&machine, frame_index, shared, row, args, span)
}

fn jet_eval_shared_runtime_transaction_capture(machine: &JetEvalMachine, frame_index: Int, shared: Int, row: MirPreludeCall, args: [JetEvalRuntimeValue], span: Span) -> ?JetEvalRuntimeValue {
    if (args.len() != 2 && args.len() != 3) || args[1] != JetEvalRuntimeValue.Data(TComptimeValue.Unit) {
        jet_eval_compiler_fail(&machine, span, "MIR Shared transaction capture has invalid checked operands")
        return None
    }
    transaction :: jet_eval_shared_runtime_current_transaction(&machine) ?? {
        jet_eval_source_fail(&machine, span, "Shared transaction operation used outside #Transact")
        return None
    }
    if jet_eval_shared_runtime_transaction_touch(&machine, transaction, shared, row, span) == None -> return None
    part :: jet_eval_shared_runtime_transaction_part(&machine, transaction, shared) ?? return None
    if part.writes && part.base_revision == @JET_EVAL_SHARED_REVISION_MAX {
        jet_eval_source_fail(&machine, span, "SharedRevisionError.GenerationExhausted")
        return None
    }
    revision := part.base_revision
    if part.writes -> revision += 1
    value :: jet_eval_shared_runtime_transaction_part_copy(&machine, transaction, shared, span) ?? return None
    snapshot_value := value
    if args.len() == 3 {
        output :: jet_eval_shared_runtime_callback(&machine, frame_index, args[2], value, MirAccess.Read, span) ?? return None
        if !jet_eval_drop_value(&machine, output.value, span) {
            jet_eval_drop_value(&machine, output.result, span)
            return None
        }
        snapshot_value = output.result
    }
    snapshot :: jet_eval_shared_runtime_create_snapshot(&machine, shared, revision, snapshot_value, span) ?? return None
    snapshot_index :: if snapshot == {.SharedSnapshot(index) -> index else -> -1}
    if snapshot_index < 0 {
        jet_eval_compiler_fail(&machine, span, "MIR Shared transaction capture did not create a snapshot")
        jet_eval_drop_value(&machine, snapshot, span)
        return None
    }
    if !jet_eval_shared_runtime_transaction_record_snapshot(&machine, transaction, shared, snapshot_index, span) {
        jet_eval_drop_value(&machine, snapshot, span)
        return None
    }
    Val(snapshot)
}

fn jet_eval_shared_runtime_global(machine: &JetEvalMachine, frame_index: Int, name: String, span: Span) -> ?JetEvalRuntimeValue {
    if name != "stm" {
        jet_eval_compiler_fail(&machine, span, "MIR Shared runtime received a non-transaction global")
        return None
    }
    if jet_eval_shared_runtime_current_transaction(&machine) == None {
        jet_eval_source_fail(&machine, span, "Shared transaction marker used outside #Transact")
        return None
    }
    Val(JetEvalRuntimeValue.Data(TComptimeValue.Unit))
}

fn jet_eval_shared_runtime_scope_enter(machine: &JetEvalMachine, frame_index: Int, scope: MirScopeId, span: Span) -> Bool {
    if jet_eval_shared_runtime_transaction_for_scope(&machine, frame_index, scope) != None {
        jet_eval_compiler_fail(&machine, span, "MIR Shared transaction scope was entered more than once")
        return false
    }
    parent := jet_eval_shared_runtime_current_transaction(&machine)
    state := shared JetEvalSharedTransactionState{
        machine: machine.identity,
        frame_index: frame_index,
        scope: scope,
        parent: parent,
        active: true,
        participants: [JetEvalSharedTransactionPart]{},
        snapshots: [Int]{},
    }
    jet_eval_shared_runtime_allocate_transaction(&machine, JetEvalSharedTransaction{storage: state})
    true
}

fn jet_eval_shared_runtime_transaction_take(machine: &JetEvalMachine, transaction: Int, span: Span) -> ?JetEvalSharedTransactionState {
    entry :: jet_eval_shared_runtime_transaction(&machine, transaction) ?? {
        jet_eval_ownership_fail(&machine, span, "MIR Shared transaction scope is unavailable")
        return None
    }
    permit := entry.storage.guard_edit()
    if !permit.value.active {
        jet_eval_ownership_fail(&machine, span, "MIR Shared transaction scope was already closed")
        return None
    }
    state := permit.value
    permit.value.active = false
    permit.value.participants = [JetEvalSharedTransactionPart]{}
    permit.value.snapshots = [Int]{}
    Val(state)
}

fn jet_eval_shared_runtime_transaction_cleanup(machine: &JetEvalMachine, state: JetEvalSharedTransactionState, abort: Bool, span: Span) -> Bool {
    ok := true
    if abort {
        loop snapshot in state.snapshots -> jet_eval_shared_runtime_transaction_invalidate_snapshot(&machine, snapshot)
    }
    loop part in state.participants {
        if part.value != JetEvalRuntimeValue.Moved && !jet_eval_drop_value(&machine, part.value, span) -> ok = false
        if part.retained && !jet_eval_shared_runtime_release_shared(&machine, part.shared, span) -> ok = false
    }
    ok
}

fn jet_eval_shared_runtime_transaction_append_part_snapshots(machine: &JetEvalMachine, transaction: Int, shared: Int, snapshots: [Int], span: Span) -> Bool {
    entry :: jet_eval_shared_runtime_transaction(&machine, transaction) ?? return false
    permit := entry.storage.guard_edit()
    if !permit.value.active -> return false
    found := false
    loop index in 0..<permit.value.participants.len() {
        if jet_eval_shared_runtime_same_shared_root(&machine, permit.value.participants[index].shared, shared) {
            loop snapshot in snapshots -> permit.value.participants[index].snapshots.push(snapshot)
            found = true
            break
        }
    }
    if !found -> {
        jet_eval_ownership_fail(&machine, span, "MIR nested Shared transaction participant is unavailable")
        return false
    }
    true
}

fn jet_eval_shared_runtime_transaction_append_snapshots(machine: &JetEvalMachine, transaction: Int, snapshots: [Int], span: Span) -> Bool {
    entry :: jet_eval_shared_runtime_transaction(&machine, transaction) ?? return false
    permit := entry.storage.guard_edit()
    if !permit.value.active -> return false
    loop snapshot in snapshots -> permit.value.snapshots.push(snapshot)
    true
}

fn jet_eval_shared_runtime_transaction_merge_nested(machine: &JetEvalMachine, parent: Int, child: JetEvalSharedTransactionState, span: Span) -> Bool {
    loop child_part in child.participants {
        existing := jet_eval_shared_runtime_transaction_part(&machine, parent, child_part.shared)
        if existing != None {
            if child_part.writes {
                copied :: jet_eval_copy_value(child_part.value, &machine, span) ?? return false
                if !jet_eval_shared_runtime_transaction_store_write(&machine, parent, child_part.shared, child_part.row, copied, span) -> return false
            }
            if !jet_eval_shared_runtime_transaction_append_part_snapshots(&machine, parent, child_part.shared, child_part.snapshots, span) -> return false
        } else {
            copied :: jet_eval_copy_value(child_part.value, &machine, span) ?? return false
            if !jet_eval_shared_runtime_retain(&machine, JetEvalRuntimeValue.Shared(child_part.shared), span) {
                jet_eval_drop_value(&machine, copied, span)
                return false
            }
            added := JetEvalSharedTransactionPart{
                shared: child_part.shared,
                value: copied,
                base_revision: child_part.base_revision,
                writes: child_part.writes,
                retained: true,
                row: child_part.row,
                snapshots: child_part.snapshots,
            }
            if jet_eval_shared_runtime_transaction_insert_part(&machine, parent, added, span) < 0 {
                jet_eval_drop_value(&machine, copied, span)
                jet_eval_shared_runtime_release_shared(&machine, child_part.shared, span)
                return false
            }
        }
    }
    jet_eval_shared_runtime_transaction_append_snapshots(&machine, parent, child.snapshots, span)
}

fn jet_eval_shared_runtime_scope_abort(machine: &JetEvalMachine, frame_index: Int, scope: MirScopeId, span: Span) -> Bool {
    transaction :: jet_eval_shared_runtime_transaction_for_scope(&machine, frame_index, scope) ?? return true
    state :: jet_eval_shared_runtime_transaction_take(&machine, transaction, span) ?? return false
    jet_eval_shared_runtime_transaction_cleanup(&machine, state, true, span)
}
fn jet_eval_shared_runtime_guard_release_all(machine: &JetEvalMachine, guards: [Int], span: Span) -> Bool {
    ok := true
    index := guards.len()
    loop index > 0 {
        index -= 1
        if !jet_eval_shared_runtime_guard_release(&machine, guards[index], span) -> ok = false
    }
    ok
}

fn jet_eval_shared_runtime_revision_type_name(result_ty: ?MirType) -> String {
    if result_ty == {
        Val(ty) -> if ty.kind == {
            .Result(_, error_ty) -> if error_ty.kind == {
                .Apply(name, _) -> return name.name
                else -> {}
            }
            else -> {}
        }
        None -> {}
    }
    "JetSharedRevisionError"
}

fn jet_eval_shared_runtime_try_replace(machine: &JetEvalMachine, shared: Int, row: MirPreludeCall, args: [JetEvalRuntimeValue], result_ty: ?MirType, span: Span) -> ?JetEvalRuntimeValue {
    if args.len() != 3 {
        jet_eval_compiler_fail(&machine, span, "MIR Shared.try_replace has invalid checked arity")
        return None
    }
    snapshot_index :: jet_eval_shared_runtime_snapshot_index(&machine, args[1], span) ?? return None
    snapshot_entry :: jet_eval_shared_runtime_snapshot(&machine, snapshot_index) ?? {
        jet_eval_ownership_fail(&machine, span, "MIR Shared.try_replace snapshot has an unknown registry identity")
        return None
    }
    guard :: jet_eval_shared_runtime_guard_acquire(&machine, shared, row, true, span) ?? return None
    guard_index :: jet_eval_shared_runtime_guard_index(&machine, guard, span) ?? {
        jet_eval_drop_value(&machine, guard, span)
        return None
    }
    type_name := jet_eval_shared_runtime_revision_type_name(result_ty)
    snapshot_owner := {
        permit := snapshot_entry.metadata.guard_read()
        permit.value.owner
    }
    snapshot_owner_root := {
        permit := snapshot_entry.metadata.guard_read()
        permit.value.owner_root
    }
    shared_entry :: jet_eval_shared_runtime_value(&machine, shared) ?? {
        jet_eval_shared_runtime_guard_release(&machine, guard_index, span)
        return None
    }
    shared_root := shared_entry.metadata.guard_read().value.physical_root
    if !jet_eval_shared_runtime_same_physical_owner(snapshot_owner_root, shared_root) {
        jet_eval_shared_runtime_guard_release(&machine, guard_index, span)
        return Val(jet_eval_shared_runtime_checked_result(
            false,
            jet_eval_shared_runtime_result_error_named(type_name, "WrongOwner"),
        ))
    }
    snapshot_valid := false
    snapshot_consumed := false
    snapshot_revision := 0
    {
        permit := snapshot_entry.metadata.guard_read()
        snapshot_valid = permit.value.valid
        snapshot_consumed = permit.value.consumed
        snapshot_revision = permit.value.revision
    }
    if !snapshot_valid || snapshot_consumed {
        jet_eval_shared_runtime_guard_release(&machine, guard_index, span)
        return Val(jet_eval_shared_runtime_checked_result(true, JetEvalRuntimeValue.Data(TComptimeValue.Bool(false))))
    }
    current_revision :: jet_eval_shared_runtime_revision_under_guard(&machine, shared, guard_index, row, span) ?? {
        jet_eval_shared_runtime_guard_release(&machine, guard_index, span)
        return None
    }
    if current_revision != snapshot_revision {
        jet_eval_shared_runtime_guard_release(&machine, guard_index, span)
        return Val(jet_eval_shared_runtime_checked_result(true, JetEvalRuntimeValue.Data(TComptimeValue.Bool(false))))
    }
    if current_revision == @JET_EVAL_SHARED_REVISION_MAX {
        jet_eval_shared_runtime_guard_release(&machine, guard_index, span)
        return Val(jet_eval_shared_runtime_checked_result(
            false,
            jet_eval_shared_runtime_result_error_named(type_name, "GenerationExhausted"),
        ))
    }
    replacement :: jet_eval_copy_value(args[2], &machine, span) ?? {
        jet_eval_shared_runtime_guard_release(&machine, guard_index, span)
        return None
    }
    consumed := {
        permit := snapshot_entry.metadata.guard_edit()
        if !permit.value.valid || permit.value.consumed || permit.value.revision != current_revision -> false
        else {
            permit.value.consumed = true
            permit.value.valid = false
            true
        }
    }
    if !consumed {
        jet_eval_drop_value(&machine, replacement, span)
        jet_eval_shared_runtime_guard_release(&machine, guard_index, span)
        return Val(jet_eval_shared_runtime_checked_result(true, JetEvalRuntimeValue.Data(TComptimeValue.Bool(false))))
    }
    if !jet_eval_shared_runtime_guard_write(&machine, 0, guard_index, [MirProjection]{}, replacement, span) {
        jet_eval_shared_runtime_guard_release(&machine, guard_index, span)
        return None
    }
    if !jet_eval_shared_runtime_guard_release(&machine, guard_index, span) {
        return None
    }
    Val(jet_eval_shared_runtime_checked_result(true, JetEvalRuntimeValue.Data(TComptimeValue.Bool(true))))
}

fn jet_eval_shared_runtime_transaction_commit(machine: &JetEvalMachine, state: JetEvalSharedTransactionState, span: Span) -> Bool {
    loop part in state.participants {
        if part.value != JetEvalRuntimeValue.Moved && !jet_eval_validate_borrow(part.value, &machine, span) {
            jet_eval_shared_runtime_transaction_cleanup(&machine, state, true, span)
            return false
        }
    }
    guards := [Int]{}
    physical_participants := [JetEvalSharedPhysicalParticipant]{}
    loop participant in 0..<state.participants.len() {
        part := state.participants[participant]
        guard_index :: jet_eval_shared_runtime_guard_prepare(&machine, part.shared, part.row, true, span) ?? {
            loop prepared in guards -> jet_eval_shared_runtime_guard_abandon_prepared(&machine, prepared, span)
            jet_eval_shared_runtime_transaction_cleanup(&machine, state, true, span)
            return false
        }
        guards.push(guard_index)
        physical_participants.push(JetEvalSharedPhysicalParticipant{
            shared: part.shared,
            guard: guard_index,
            row: part.row,
        })
    }
    if guards.len() > 0 {
        first := state.participants[0]
        physical := jet_eval_shared_runtime_physical(
            &machine,
            JetEvalSharedPhysicalOp.AcquireOrdered(physical_participants),
            first.row,
            None,
            JetEvalRuntimeValue.Shared(first.shared),
            None,
            None,
            None,
            span,
        )
        if !jet_eval_shared_runtime_physical_ok(physical, &machine, span) {
            loop prepared in guards -> jet_eval_shared_runtime_guard_abandon_prepared(&machine, prepared, span)
            jet_eval_shared_runtime_transaction_cleanup(&machine, state, true, span)
            return false
        }
        activated := true
        loop guard in guards {
            if !jet_eval_shared_runtime_guard_set_active(&machine, guard, true, span) {
                jet_eval_ownership_fail(&machine, span, "MIR Shared transaction acquired an invalid guard identity")
                activated = false
                break
            }
        }
        if !activated {
            jet_eval_shared_runtime_guard_release_all(&machine, guards, span)
            jet_eval_shared_runtime_transaction_cleanup(&machine, state, true, span)
            return false
        }
    }
    preflight_ok := true
    loop participant in 0..<state.participants.len() {
        part := state.participants[participant]
        if !part.writes -> next
        revision :: jet_eval_shared_runtime_revision_under_guard(&machine, part.shared, guards[participant], part.row, span) ?? {
            preflight_ok = false
            break
        }
        if revision == @JET_EVAL_SHARED_REVISION_MAX {
            jet_eval_source_fail(&machine, span, "SharedRevisionError.GenerationExhausted")
            preflight_ok = false
            break
        }
    }
    if !preflight_ok {
        jet_eval_shared_runtime_guard_release_all(&machine, guards, span)
        jet_eval_shared_runtime_transaction_cleanup(&machine, state, true, span)
        return false
    }
    old_values := [JetEvalRuntimeValue]{}
    write_ok := true
    loop participant in 0..<state.participants.len() {
        part := state.participants[participant]
        if !part.writes {
            old_values.push(JetEvalRuntimeValue.Moved)
            next
        }
        old :: jet_eval_shared_runtime_guard_read(&machine, 0, guards[participant], [MirProjection]{}, span) ?? {
            write_ok = false
            break
        }
        old_values.push(old)
        replacement := part.value
        state.participants[participant].value = JetEvalRuntimeValue.Moved
        if !jet_eval_shared_runtime_guard_write(&machine, 0, guards[participant], [MirProjection]{}, replacement, span) {
            write_ok = false
            break
        }
    }
    if !write_ok && guards.len() > 0 {
        first := state.participants[0]
        aborted := jet_eval_shared_runtime_physical(
            &machine,
            JetEvalSharedPhysicalOp.AbortOrdered(physical_participants),
            first.row,
            None,
            JetEvalRuntimeValue.Shared(first.shared),
            None,
            None,
            None,
            span,
        )
        if jet_eval_shared_runtime_physical_ok(aborted, &machine, span) {
            loop guard in guards {
                entry :: jet_eval_shared_runtime_guard(&machine, guard) ?? next
                lease := entry.metadata.guard_read().value.lease.metadata
                permit := lease.guard_edit()
                permit.value.dirty = false
            }
        }
    }
    release_ok := jet_eval_shared_runtime_guard_release_all(&machine, guards, span)
    loop old in old_values {
        if old != JetEvalRuntimeValue.Moved && !jet_eval_drop_value(&machine, old, span) -> write_ok = false
    }
    if !write_ok || !release_ok {
        jet_eval_shared_runtime_transaction_cleanup(&machine, state, true, span)
        return false
    }
    jet_eval_shared_runtime_transaction_cleanup(&machine, state, false, span)
}

fn jet_eval_shared_runtime_scope_exit(machine: &JetEvalMachine, frame_index: Int, scope: MirScopeId, span: Span) -> Bool {
    transaction :: jet_eval_shared_runtime_transaction_for_scope(&machine, frame_index, scope) ?? {
        jet_eval_compiler_fail(&machine, span, "MIR Shared transaction scope is unavailable at exit")
        return false
    }
    state :: jet_eval_shared_runtime_transaction_take(&machine, transaction, span) ?? return false
    if state.parent != None {
        parent :: state.parent ?? return false
        if !jet_eval_shared_runtime_transaction_merge_nested(&machine, parent, state, span) {
            jet_eval_shared_runtime_transaction_cleanup(&machine, state, true, span)
            return false
        }
        return jet_eval_shared_runtime_transaction_cleanup(&machine, state, false, span)
    }
    jet_eval_shared_runtime_transaction_commit(&machine, state, span)
}
