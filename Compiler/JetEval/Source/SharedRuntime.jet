// Runtime identity and synchronization for user-facing Shared values.  The
// dynamic payload, logical ownership metadata, and native protocol leases are
// separate: retaining a carrier never touches the user payload.

pub enum JetEvalSharedHostKind { Shared Snapshot Condition Weak Guard }

pub struct JetEvalSharedPhysicalParticipant {
    pub shared: Int
    pub guard: Int
    pub row: MirPreludeCall
}

pub enum JetEvalSharedPhysicalOp {
    CreateShared
    CreateCondition
    Acquire(editable: Bool)
    AcquireOrdered(participants: [JetEvalSharedPhysicalParticipant])
    RequireEdit
    ReadGuard
    StrongCount
    Revision
    RetainAlias
    AdoptAlias(token_id: Int)
    ReleaseAlias(token_id: Int)
    AbortOrdered(participants: [JetEvalSharedPhysicalParticipant])
    Downgrade(weak: JetEvalRuntimeValue)
    WeakUpgrade
    Map(child: JetEvalRuntimeValue, path: [MirFieldId], editable: Bool)
    Split(first: JetEvalRuntimeValue, second: JetEvalRuntimeValue, first_path: [MirFieldId], second_path: [MirFieldId], editable: Bool)
    WaitOnce
    Notify(all: Bool)
    Release
    ReleaseShared
    ReleaseCondition
    ReleaseWeak
}
pub enum JetEvalSharedHostOrigin { Source Native }

pub struct JetEvalSharedHostRootCapability {
    pub handle: MirHandleId
    pub raw: Int
    pub generation: Int
    pub type_identity: Int
    pub physical_identity: Int
}
pub struct JetEvalSharedHostWeakCapability {
    pub handle: MirHandleId
    pub raw: Int
    pub generation: Int
    pub type_identity: Int
    pub physical_identity: Int
}


pub struct JetEvalSharedValueData { pub value: JetEvalRuntimeValue }
pub struct JetEvalSharedValueMeta {
    pub references: Int
    pub dropped: Bool
    pub revision: Int
    pub create_row: MirPreludeCall
    pub element_type: MirType
    pub origin: JetEvalSharedHostOrigin
    pub physical_root: ?JetEvalSharedHostRootCapability
    pub owner_alias_tokens: [Int]
    pub pending_owner_alias_transfers: [Int]
}
pub struct JetEvalSharedValue {
    pub storage: Shared<JetEvalSharedValueData>
    pub metadata: Shared<JetEvalSharedValueMeta>
}

pub struct JetEvalSharedGuardLeaseMeta {
    pub shared: Int
    pub owner_row: MirPreludeCall
    pub editable: Bool
    pub handles: Int
    pub dirty: Bool
    pub released: Bool
}
pub struct JetEvalSharedGuardLease { pub metadata: Shared<JetEvalSharedGuardLeaseMeta> }
pub struct JetEvalSharedGuardMeta {
    pub references: Int
    pub dropped: Bool
    pub active: Bool
    pub editable: Bool
    pub path: [MirFieldId]
    pub owner_row: MirPreludeCall
    pub physical_borrow_selector: ?Int
    pub lease: JetEvalSharedGuardLease
}
pub struct JetEvalSharedGuard { pub metadata: Shared<JetEvalSharedGuardMeta> }

pub struct JetEvalSharedSnapshotData { pub value: JetEvalRuntimeValue }
pub struct JetEvalSharedSnapshotMeta {
    pub references: Int
    pub dropped: Bool
    pub owner: Int
    pub revision: Int
    pub valid: Bool
    pub consumed: Bool
    pub origin: JetEvalSharedHostOrigin
    pub owner_root: ?JetEvalSharedHostRootCapability
}
pub struct JetEvalSharedSnapshot {
    pub storage: Shared<JetEvalSharedSnapshotData>
    pub metadata: Shared<JetEvalSharedSnapshotMeta>
}

pub struct JetEvalSharedConditionMeta {
    pub references: Int
    pub dropped: Bool
    pub create_row: MirPreludeCall
    pub origin: JetEvalSharedHostOrigin
    pub physical_root: ?JetEvalSharedHostRootCapability
}
pub struct JetEvalSharedCondition { pub metadata: Shared<JetEvalSharedConditionMeta> }

pub struct JetEvalSharedWeakMeta {
    pub references: Int
    pub create_row: MirPreludeCall
    pub dropped: Bool
    pub element_type: MirType
    pub origin: JetEvalSharedHostOrigin
    pub physical_root: ?JetEvalSharedHostWeakCapability
}
pub struct JetEvalSharedWeak { pub metadata: Shared<JetEvalSharedWeakMeta> }

pub struct JetEvalSharedTransactionPart {
    pub shared: Int
    pub value: JetEvalRuntimeValue
    pub base_revision: Int
    pub writes: Bool
    pub retained: Bool
    pub row: MirPreludeCall
    pub snapshots: [Int]
}
pub struct JetEvalSharedTransactionState {
    pub machine: Int
    pub frame_index: Int
    pub scope: MirScopeId
    pub parent: ?Int
    pub active: Bool
    pub participants: [JetEvalSharedTransactionPart]
    pub snapshots: [Int]
}
pub struct JetEvalSharedTransaction { pub storage: Shared<JetEvalSharedTransactionState> }

pub struct JetEvalSharedRuntimeData {
    pub values: [JetEvalSharedValue]
    pub guards: [JetEvalSharedGuard]
    pub snapshots: [JetEvalSharedSnapshot]
    pub conditions: [JetEvalSharedCondition]
    pub weaks: [JetEvalSharedWeak]
    pub transactions: [JetEvalSharedTransaction]
    pub entry_read_shared_loans: [Int:Bool]
    pub entry_read_guard_loans: [Int:Int]
    pub entry_read_snapshot_loans: [Int:Bool]
    pub entry_read_condition_loans: [Int:Bool]
    pub entry_read_weak_loans: [Int:Bool]
}
pub struct JetEvalSharedRuntime { pub storage: Shared<JetEvalSharedRuntimeData> }
pub enum JetEvalSharedHostPhysicalRoot {
    Shared(value: JetEvalSharedValue)
    Snapshot(value: JetEvalSharedSnapshot)
    Condition(value: JetEvalSharedCondition)
    Weak(value: JetEvalSharedWeak)
    Guard(value: JetEvalSharedGuard)
}
// A local, frame-scoped non-owning view. `index` is interpreted in the
// registry namespace selected by `kind`; ending it never releases a physical
// owner alias or root capability.
pub struct JetEvalSharedEntryLoan {
    pub kind: JetEvalSharedHostKind
    pub index: Int
    pub registry: JetEvalSharedRuntime
}

// Stable Source program/registry state only; each finalization call supplies a
// temporary active adapter instead of retaining a Machine, lease, or adapter.
pub struct JetEvalSharedPayloadFinalizer {
    pub owned_root: JetEvalOwnedRoot
    pub span: Span
}

pub fn jet_eval_shared_payload_finalize(
    finalizer: JetEvalSharedPayloadFinalizer,
    payload: JetEvalSharedValueData,
    adapter: JetEvalHostAdapter,
) -> JetEvalOwnedRootDropResult {
    jet_eval_owned_root_drop(&finalizer.owned_root, payload.value, adapter, finalizer.span)
}
pub struct JetEvalSharedHostCarrier {
    pub kind: JetEvalSharedHostKind
    pub index: ?Int
    pub registry: JetEvalSharedRuntime
    pub origin: JetEvalSharedHostOrigin
    pub physical: JetEvalSharedHostPhysicalRoot
    pub payload_finalizer: ?JetEvalSharedPayloadFinalizer
    pub payload_shape: JetEvalHostTypeShape
    pub owner_alias_token: ?Int
    pub owner_alias_token_pre_adopted: Bool
    pub owns_root_capability: Bool
}

pub fn jet_eval_shared_runtime_new() -> JetEvalSharedRuntime {
    JetEvalSharedRuntime{
        storage: shared JetEvalSharedRuntimeData{
            values: [JetEvalSharedValue]{},
            guards: [JetEvalSharedGuard]{},
            snapshots: [JetEvalSharedSnapshot]{},
            conditions: [JetEvalSharedCondition]{},
            weaks: [JetEvalSharedWeak]{},
            transactions: [JetEvalSharedTransaction]{},
            entry_read_shared_loans: [Int:Bool]{},
            entry_read_guard_loans: [Int:Int]{},
            entry_read_snapshot_loans: [Int:Bool]{},
            entry_read_condition_loans: [Int:Bool]{},
            entry_read_weak_loans: [Int:Bool]{},
        },
    }
}
enum JetEvalSharedRefRelease { Invalid Remaining Last }
fn jet_eval_shared_runtime_same_root_capability(left: ?JetEvalSharedHostRootCapability, right: ?JetEvalSharedHostRootCapability) -> Bool {
    if left == None || right == None -> return false
    first :: left ?? return false
    second :: right ?? return false
    first.handle == second.handle
        && first.raw == second.raw
        && first.generation == second.generation
        && first.type_identity == second.type_identity
        && first.physical_identity == second.physical_identity
}
fn jet_eval_shared_runtime_same_physical_owner(left: ?JetEvalSharedHostRootCapability, right: ?JetEvalSharedHostRootCapability) -> Bool {
    if left == None || right == None -> return false
    first :: left ?? return false
    second :: right ?? return false
    first.type_identity == second.type_identity
        && first.physical_identity == second.physical_identity
}
fn jet_eval_shared_runtime_same_shared_root(machine: &JetEvalMachine, left: Int, right: Int) -> Bool {
    if left == right -> return true
    first :: jet_eval_shared_runtime_value(&machine, left) ?? return false
    second :: jet_eval_shared_runtime_value(&machine, right) ?? return false
    jet_eval_shared_runtime_same_physical_owner(
        first.metadata.guard_read().value.physical_root,
        second.metadata.guard_read().value.physical_root,
    )
}

@JET_EVAL_SHARED_REVISION_MAX :: 0xffffffffffffffff

fn jet_eval_shared_runtime_value_from_registry(runtime: JetEvalSharedRuntime, index: Int) -> ?JetEvalSharedValue {
    permit := runtime.storage.guard_read()
    if index < 0 || index >= permit.value.values.len() -> return None
    Val(permit.value.values[index])
}

fn jet_eval_shared_runtime_value(machine: &JetEvalMachine, index: Int) -> ?JetEvalSharedValue {
    jet_eval_shared_runtime_value_from_registry(machine.registry.shared_runtime, index)
}
fn jet_eval_shared_runtime_guard(machine: &JetEvalMachine, index: Int) -> ?JetEvalSharedGuard {
    runtime := machine.registry.shared_runtime
    permit := runtime.storage.guard_read()
    if index < 0 || index >= permit.value.guards.len() -> return None
    Val(permit.value.guards[index])
}
fn jet_eval_shared_runtime_snapshot(machine: &JetEvalMachine, index: Int) -> ?JetEvalSharedSnapshot {
    runtime := machine.registry.shared_runtime
    permit := runtime.storage.guard_read()
    if index < 0 || index >= permit.value.snapshots.len() -> return None
    Val(permit.value.snapshots[index])
}
fn jet_eval_shared_runtime_condition(machine: &JetEvalMachine, index: Int) -> ?JetEvalSharedCondition {
    runtime := machine.registry.shared_runtime
    permit := runtime.storage.guard_read()
    if index < 0 || index >= permit.value.conditions.len() -> return None
    Val(permit.value.conditions[index])
}
fn jet_eval_shared_runtime_weak(machine: &JetEvalMachine, index: Int) -> ?JetEvalSharedWeak {
    runtime := machine.registry.shared_runtime
    permit := runtime.storage.guard_read()
    if index < 0 || index >= permit.value.weaks.len() -> return None
    Val(permit.value.weaks[index])
}
fn jet_eval_shared_runtime_transaction(machine: &JetEvalMachine, index: Int) -> ?JetEvalSharedTransaction {
    runtime := machine.registry.shared_runtime
    permit := runtime.storage.guard_read()
    if index < 0 || index >= permit.value.transactions.len() -> return None
    Val(permit.value.transactions[index])
}

fn jet_eval_shared_runtime_allocate_value(machine: &JetEvalMachine, value: JetEvalSharedValue) -> Int {
    runtime := machine.registry.shared_runtime
    permit := runtime.storage.guard_edit()
    index := permit.value.values.len()
    permit.value.values.push(value)
    index
}
fn jet_eval_shared_runtime_allocate_guard(machine: &JetEvalMachine, guard: JetEvalSharedGuard) -> Int {
    runtime := machine.registry.shared_runtime
    permit := runtime.storage.guard_edit()
    index := permit.value.guards.len()
    permit.value.guards.push(guard)
    index
}
fn jet_eval_shared_runtime_allocate_snapshot(machine: &JetEvalMachine, snapshot: JetEvalSharedSnapshot) -> Int {
    runtime := machine.registry.shared_runtime
    permit := runtime.storage.guard_edit()
    index := permit.value.snapshots.len()
    permit.value.snapshots.push(snapshot)
    index
}
fn jet_eval_shared_runtime_allocate_condition(machine: &JetEvalMachine, condition: JetEvalSharedCondition) -> Int {
    runtime := machine.registry.shared_runtime
    permit := runtime.storage.guard_edit()
    index := permit.value.conditions.len()
    permit.value.conditions.push(condition)
    index
}
fn jet_eval_shared_runtime_allocate_weak(machine: &JetEvalMachine, weak: JetEvalSharedWeak) -> Int {
    runtime := machine.registry.shared_runtime
    permit := runtime.storage.guard_edit()
    index := permit.value.weaks.len()
    permit.value.weaks.push(weak)
    index
}
fn jet_eval_shared_runtime_entry_read_loan_active(machine: &JetEvalMachine, kind: JetEvalSharedHostKind, index: Int) -> Bool {
    runtime := machine.registry.shared_runtime
    permit := runtime.storage.guard_read()
    if kind == JetEvalSharedHostKind.Shared -> return permit.value.entry_read_shared_loans.get(index) != None
    if kind == JetEvalSharedHostKind.Guard -> return permit.value.entry_read_guard_loans.get(index) != None
    if kind == JetEvalSharedHostKind.Snapshot -> return permit.value.entry_read_snapshot_loans.get(index) != None
    if kind == JetEvalSharedHostKind.Condition -> return permit.value.entry_read_condition_loans.get(index) != None
    if kind == JetEvalSharedHostKind.Weak -> return permit.value.entry_read_weak_loans.get(index) != None
    false
}

fn jet_eval_shared_runtime_entry_read_loan_mark(machine: &JetEvalMachine, kind: JetEvalSharedHostKind, index: Int) {
    runtime := machine.registry.shared_runtime
    permit := runtime.storage.guard_edit()
    if kind == JetEvalSharedHostKind.Shared -> permit.value.entry_read_shared_loans[index] = true
    if kind == JetEvalSharedHostKind.Guard -> permit.value.entry_read_guard_loans[index] = index
    if kind == JetEvalSharedHostKind.Snapshot -> permit.value.entry_read_snapshot_loans[index] = true
    if kind == JetEvalSharedHostKind.Condition -> permit.value.entry_read_condition_loans[index] = true
    if kind == JetEvalSharedHostKind.Weak -> permit.value.entry_read_weak_loans[index] = true
}
fn jet_eval_shared_runtime_entry_read_guard_loan_id(machine: &JetEvalMachine, index: Int) -> ?Int {
    runtime := machine.registry.shared_runtime
    permit := runtime.storage.guard_read()
    permit.value.entry_read_guard_loans.get(index)
}

fn jet_eval_shared_runtime_entry_read_guard_loan_link(machine: &JetEvalMachine, index: Int, loan_index: Int) -> Bool {
    if index < 0 || loan_index < 0 -> return false
    runtime := machine.registry.shared_runtime
    permit := runtime.storage.guard_edit()
    if permit.value.entry_read_guard_loans.get(index) != None -> return false
    permit.value.entry_read_guard_loans[index] = loan_index
    true
}

fn jet_eval_shared_runtime_entry_read_loan_remove(machine: &JetEvalMachine, loan: JetEvalSharedEntryLoan) -> Bool {
    runtime := machine.registry.shared_runtime
    permit := runtime.storage.guard_edit()
    if loan.kind == JetEvalSharedHostKind.Shared -> return permit.value.entry_read_shared_loans.remove(loan.index) != None
    if loan.kind == JetEvalSharedHostKind.Guard -> return permit.value.entry_read_guard_loans.remove(loan.index) != None
    if loan.kind == JetEvalSharedHostKind.Snapshot -> return permit.value.entry_read_snapshot_loans.remove(loan.index) != None
    if loan.kind == JetEvalSharedHostKind.Condition -> return permit.value.entry_read_condition_loans.remove(loan.index) != None
    if loan.kind == JetEvalSharedHostKind.Weak -> return permit.value.entry_read_weak_loans.remove(loan.index) != None
    false
}

fn jet_eval_shared_runtime_allocate_transaction(machine: &JetEvalMachine, transaction: JetEvalSharedTransaction) -> Int {
    runtime := machine.registry.shared_runtime
    permit := runtime.storage.guard_edit()
    loop index in 0..<permit.value.transactions.len() {
        entry := permit.value.transactions[index]
        state := entry.storage.guard_read()
        if !state.value.active {
            permit.value.transactions[index] = transaction
            return index
        }
    }
    index := permit.value.transactions.len()
    permit.value.transactions.push(transaction)
    index
}

fn jet_eval_shared_runtime_ref_retain(references: Int, dropped: Bool) -> Bool {
    references > 0 && !dropped
}
fn jet_eval_shared_runtime_ref_release(references: Int, dropped: Bool) -> JetEvalSharedRefRelease {
    if references <= 0 || dropped -> return JetEvalSharedRefRelease.Invalid
    if references == 1 -> return JetEvalSharedRefRelease.Last
    JetEvalSharedRefRelease.Remaining
}

fn jet_eval_shared_runtime_value_live(machine: &JetEvalMachine, index: Int, span: Span) -> Bool {
    entry := jet_eval_shared_runtime_value(&machine, index) ?? {
        jet_eval_ownership_fail(&machine, span, "MIR Shared carrier has an unknown registry identity")
        return false
    }
    loan_active := jet_eval_shared_runtime_entry_read_loan_active(&machine, JetEvalSharedHostKind.Shared, index)
    permit := entry.metadata.guard_read()
    live := (permit.value.references > 0 || loan_active) && !permit.value.dropped
    if !live -> jet_eval_ownership_fail(&machine, span, "MIR Shared carrier is no longer live")
    live
}
fn jet_eval_shared_runtime_guard_live(machine: &JetEvalMachine, index: Int, span: Span) -> Bool {
    entry := jet_eval_shared_runtime_guard(&machine, index) ?? {
        jet_eval_ownership_fail(&machine, span, "MIR SharedGuard carrier has an unknown registry identity")
        return false
    }
    permit := entry.metadata.guard_read()
    if permit.value.dropped || permit.value.references <= 0 -> {
        jet_eval_ownership_fail(&machine, span, "MIR SharedGuard carrier is no longer live")
        return false
    }
    if !permit.value.active {
        jet_eval_source_fail(&machine, span, "jet_shared_guard_invalid")
        return false
    }
    true
}
fn jet_eval_shared_runtime_snapshot_live(machine: &JetEvalMachine, index: Int, span: Span) -> Bool {
    entry := jet_eval_shared_runtime_snapshot(&machine, index) ?? {
        jet_eval_ownership_fail(&machine, span, "MIR SharedSnapshot carrier has an unknown registry identity")
        return false
    }
    loan_active := jet_eval_shared_runtime_entry_read_loan_active(&machine, JetEvalSharedHostKind.Snapshot, index)
    permit := entry.metadata.guard_read()
    live := (permit.value.references > 0 || loan_active) && !permit.value.dropped
    if !live -> jet_eval_ownership_fail(&machine, span, "MIR SharedSnapshot carrier is no longer live")
    live
}
