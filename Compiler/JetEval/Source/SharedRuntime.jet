// Runtime identity and synchronization for user-facing Shared values.  The
// dynamic payload, logical ownership metadata, and native protocol leases are
// separate: retaining a carrier never touches the user payload.
use jet_foundation.[
    MIRFieldID,
    MIRHandleID,
    MIRPreludeCall,
    MIRScopeID,
    MIRType,
    Span,
]

enum JetEvalSharedHostKind { Shared Snapshot Condition Weak Guard }

struct JetEvalSharedPhysicalParticipant {
    shared: Int
    guard: Int
    row: MIRPreludeCall
}

enum JetEvalSharedPhysicalOp {
    CreateShared
    CreateCondition
    Acquire(editable: Bool)
    AcquireOrdered(participants: [JetEvalSharedPhysicalParticipant])
    RequireEdit
    ReadGuard
    StrongCount
    Revision
    RetainAlias
    AdoptAlias(token_id: Int)
    ReleaseAlias(token_id: Int)
    AbortOrdered(participants: [JetEvalSharedPhysicalParticipant])
    Downgrade(weak: JetEvalRuntimeValue)
    WeakUpgrade
    Map(child: JetEvalRuntimeValue, path: [MIRFieldID], editable: Bool)
    Split(first: JetEvalRuntimeValue, second: JetEvalRuntimeValue, first_path: [MIRFieldID], second_path: [MIRFieldID], editable: Bool)
    WaitOnce
    Notify(all: Bool)
    Release
    ReleaseShared
    ReleaseCondition
    ReleaseWeak
    WriteGuard(value: JetEvalRuntimeValue)
}

enum JetEvalSharedHostOrigin { Source Native }

struct JetEvalSharedHostRootCapability {
    handle: MIRHandleID
    raw: Int
    generation: Int
    type_identity: Int
    physical_identity: Int
}

struct JetEvalSharedHostWeakCapability {
    handle: MIRHandleID
    raw: Int
    generation: Int
    type_identity: Int
    physical_identity: Int
}

struct JetEvalSharedValueData { value: JetEvalRuntimeValue }

struct JetEvalSharedValueMeta {
    references: Int
    dropped: Bool
    revision: Int
    create_row: MIRPreludeCall
    element_type: MIRType
    origin: JetEvalSharedHostOrigin
    physical_root: JetEvalSharedHostRootCapability?
    owner_alias_tokens: [Int]
    pending_owner_alias_transfers: [Int]
}

struct JetEvalSharedValue {
    storage: Shared<JetEvalSharedValueData>
    metadata: Shared<JetEvalSharedValueMeta>
}

struct JetEvalSharedGuardLeaseMeta {
    shared: Int
    owner_row: MIRPreludeCall
    editable: Bool
    handles: Int
    dirty: Bool
    released: Bool
    // An arena-issued capability for the actual native Guard40 lease. It is
    // not a copied permit; callback READ loans still use their scoped selector.
    physical_root: JetEvalSharedHostRootCapability?
}

struct JetEvalSharedGuardLease { metadata: Shared<JetEvalSharedGuardLeaseMeta> }

struct JetEvalSharedGuardMeta {
    references: Int
    dropped: Bool
    active: Bool
    editable: Bool
    path: [MIRFieldID]
    owner_row: MIRPreludeCall
    physical_borrow_selector: Int?
    lease: JetEvalSharedGuardLease
}

struct JetEvalSharedGuard { metadata: Shared<JetEvalSharedGuardMeta> }

struct JetEvalSharedSnapshotData { value: JetEvalRuntimeValue }

struct JetEvalSharedSnapshotMeta {
    references: Int
    dropped: Bool
    owner: Int
    revision: Int
    valid: Bool
    consumed: Bool
    origin: JetEvalSharedHostOrigin
    owner_root: JetEvalSharedHostRootCapability?
}

struct JetEvalSharedSnapshot {
    storage: Shared<JetEvalSharedSnapshotData>
    metadata: Shared<JetEvalSharedSnapshotMeta>
}

struct JetEvalSharedConditionMeta {
    references: Int
    dropped: Bool
    create_row: MIRPreludeCall
    origin: JetEvalSharedHostOrigin
    physical_root: JetEvalSharedHostRootCapability?
}

struct JetEvalSharedCondition { metadata: Shared<JetEvalSharedConditionMeta> }

struct JetEvalSharedWeakMeta {
    references: Int
    create_row: MIRPreludeCall
    dropped: Bool
    element_type: MIRType
    origin: JetEvalSharedHostOrigin
    physical_root: JetEvalSharedHostWeakCapability?
}

struct JetEvalSharedWeak { metadata: Shared<JetEvalSharedWeakMeta> }

struct JetEvalSharedTransactionPart {
    shared: Int
    value: JetEvalRuntimeValue
    base_revision: Int
    writes: Bool
    retained: Bool
    row: MIRPreludeCall
    snapshots: [Int]
}

struct JetEvalSharedTransactionState {
    machine: Int
    frame_index: Int
    scope: MIRScopeID
    parent: Int?
    active: Bool
    participants: [JetEvalSharedTransactionPart]
    snapshots: [Int]
}

struct JetEvalSharedTransaction { storage: Shared<JetEvalSharedTransactionState> }

struct JetEvalSharedRuntimeData {
    values: [JetEvalSharedValue]
    guards: [JetEvalSharedGuard]
    snapshots: [JetEvalSharedSnapshot]
    conditions: [JetEvalSharedCondition]
    weaks: [JetEvalSharedWeak]
    transactions: [JetEvalSharedTransaction]
    entry_read_shared_loans: [Int:Bool]
    entry_read_guard_loans: [Int:Int]
    entry_read_snapshot_loans: [Int:Bool]
    entry_read_condition_loans: [Int:Bool]
    entry_read_weak_loans: [Int:Bool]
}

struct JetEvalSharedRuntime { storage: Shared<JetEvalSharedRuntimeData> }

enum JetEvalSharedHostPhysicalRoot {
    Shared(value: JetEvalSharedValue)
    Snapshot(value: JetEvalSharedSnapshot)
    Condition(value: JetEvalSharedCondition)
    Weak(value: JetEvalSharedWeak)
    Guard(value: JetEvalSharedGuard)
}

// A local, frame-scoped non-owning view. `index` is interpreted in the
// registry namespace selected by `kind`; ending it never releases a physical
// owner alias or root capability.
struct JetEvalSharedEntryLoan {
    kind: JetEvalSharedHostKind
    index: Int
    registry: JetEvalSharedRuntime
}

// Stable Source program/registry state only; each finalization call supplies a
// temporary active adapter instead of retaining a Machine, lease, or adapter.
struct JetEvalSharedPayloadFinalizer {
    owned_root: JetEvalOwnedRoot
    span: Span
}

struct JetEvalSharedHostCarrier {
    kind: JetEvalSharedHostKind
    index: Int?
    registry: JetEvalSharedRuntime
    origin: JetEvalSharedHostOrigin
    physical: JetEvalSharedHostPhysicalRoot
    payload_finalizer: JetEvalSharedPayloadFinalizer?
    payload_shape: JetEvalHostTypeShape
    owner_alias_token: Int?
    owner_alias_token_pre_adopted: Bool
    owns_root_capability: Bool
}
