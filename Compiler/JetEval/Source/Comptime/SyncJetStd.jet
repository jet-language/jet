// Rust: crates/jet-comptime/src/Comptime/SyncJetStd.rs:26
pub fn jet_int_from_i64(value: I64) -> I64 { value }
// Rust: crates/jet-comptime/src/Comptime/SyncJetStd.rs:30
pub fn jet_int_from_str(value: &String) -> I64 Err! {
    CtBigInt.from_str(value)?.try_i64().ok_or_else(fn() { "exact Int `{value}` is out of range for this tier" })
}
// Rust: crates/jet-comptime/src/Comptime/SyncJetStd.rs:36
pub fn jet_int_to_i64(value: I64) -> I64? { Val(value) }
// Rust: crates/jet-comptime/src/Comptime/SyncJetStd.rs:40
pub fn jet_int_to_string(value: I64) -> String { value.to_string() }
// Rust: crates/jet-comptime/src/Comptime/SyncJetStd.rs:44
pub fn jet_int_to_f64(value: I64) -> F64 {
    text := jet_int_to_string(value)
    text.parse<F64>().unwrap_or_else(fn(_) { if text.starts_with('-') { F64.NEG_INFINITY } else { F64.INFINITY } })
}
// Rust: crates/jet-comptime/src/Comptime/SyncJetStd.rs:54
fn quote_json(s: &String) -> String {
    out := "\""
    for c in s.chars() {
        c == {
            '"' -> out.push_str("\\\"")
            '\\' -> out.push_str("\\\\")
            '\u{0008}' -> out.push_str("\\b")
            '\u{000c}' -> out.push_str("\\f")
            '\n' -> out.push_str("\\n")
            '\r' -> out.push_str("\\r")
            '\t' -> out.push_str("\\t")
            _ -> { if (c as U32) < 0x20 { out.push_str("\\u{(c as U32):04x}") } else { out.push(c) } }
        }
    }
    out.push('"')
    out
}
// Rust: crates/jet-comptime/src/Comptime/SyncJetStd.rs:73
pub fn render_datatree_json(tree: &DataTree, pretty: Bool, depth: USize) -> String {
    tree == {
        Null -> "null"
        Bool(value) -> value.to_string()
        Int(value) -> jet_int_to_string(value)
        Float(value) -> { assert(value.is_finite(), "JSON cannot encode a non-finite Float"); "{value:Debug}" }
        Number(text) -> text.clone()
        TypedText(text) -> quote_json(text)
        Text(value) -> quote_json(value)
        Bytes(values) -> "[{values.iter().map(fn(v) { v.to_string() }).collect().join(",")}]"
        Array(values) -> {
            if values.is_empty() { return "[]" }
            if !pretty { return "[{values.iter().map(fn(v) { render_datatree_json(v, false, depth) }).collect().join(",")}]" }
            pad := "  ".repeat(depth + 1); end := "  ".repeat(depth)
            parts := values.iter().map(fn(v) { "{pad}{render_datatree_json(v, true, depth + 1)}" }).collect()
            "[\n{parts.join(",\n")}\n{end}]"
        }
        Object(fields) -> {
            if fields.is_empty() { return "{{}}" }
            if !pretty {
                parts := fields.iter().map(fn(entry) { "{quote_json(&entry.0)}:{render_datatree_json(&entry.1, false, depth)}" }).collect()
                return "{{{parts.join(",")}}}"
            }
            pad := "  ".repeat(depth + 1); end := "  ".repeat(depth)
            parts := fields.iter().map(fn(entry) { "{pad}{quote_json(&entry.0)}: {render_datatree_json(&entry.1, true, depth + 1)}" }).collect()
            "{{\n{parts.join(",\n")}\n{end}}}"
        }
    }
}
