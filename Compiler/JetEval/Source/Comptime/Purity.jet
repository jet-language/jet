//RS //! Purity check: walk the call graph reachable from a comptime `init` and
//RS //! reject the first call denied by the canonical comptime rights row
//RS //! (E3401 — D-META-EFFECT1 c3). The same syntax walker serves the run-time
//RS //! `-[]>` declaration check in `jet-sema/Sema/Effects.rs`; only the stage
//RS //! options differ. The row allows memory-only operations; host effects such as
//RS //! IO and FFI are denied. `embed_file`, `embed_bytes`, `find`, `panic`, and
//RS //! `require` remain allowed through their existing evaluator paths.
//RS 
//RS use std::borrow::Borrow;
//RS use std::collections::{HashMap, HashSet};
//RS 
//RS use crate::Diagnostics::{Diagnostic, Span};
//RS use crate::AST::{
//RS     EnumLitArg, Expr, Func, LValue, LambdaBody, OrFallback, Pattern, Stmt, StrPart, StructPatField,
//RS };
//RS use jet_foundation::Authority::Holds;
//RS use jet_foundation::sema::{RightsProvenance, RightsRow};
//RS 
//RS use super::Diagnostics::impurity_diag;
//RS 
//RS /// D-META-EFFECT1 c3 (merge review, card #1543): the one shared walker
//RS /// serves two callers whose meaning of "reachable at this stage" differs on
//RS /// exactly two statement kinds. Everything else about the walk is identical
//RS /// between the two — this enum is the only place they may differ, per the
//RS /// review's "one walk, explicit mode parameters" requirement.
//RS #[derive(Clone, Copy, PartialEq, Eq)]
//RS pub enum PurityStage {
//RS     /// jet-sema's `-[]>` declared-effect check (also the `jet eval --pure`
//RS     /// whole-program root check): checks what actually executes at run
//RS     /// time. `#Impure(...)` bodies DO run at run time — the marker records
//RS     /// and gates the ambient call, it doesn't erase it — so a
//RS     /// declared-pure function must still be checked inside one; an empty
//RS     /// declared effect set can't silently admit an ambient call. `@ { ... }`
//RS     /// comptime blocks emit no runtime code at all (I3), so they are
//RS     /// excluded: nothing inside one can trip a run-time-voiced E3401.
//RS     RunTime,
//RS     /// jet-comptime's own build-time evaluation check (`check_purity`,
//RS     /// `check_purity_stmts`): checks what runs while the compiler itself
//RS     /// evaluates the expression. `#Impure(...)` bodies are gated by
//RS     /// `--gate impure=allow`/E3411 at the point they would actually execute
//RS     /// (unchanged prior behavior), so the build-time walk skips them here.
//RS     /// A nested `@ { ... }` block runs for real during build-time
//RS     /// evaluation too, so it stays in the walk.
//RS     BuildTime,
//RS }
//RS 
//RS /// Threaded through the syntax-only expr/stmt walk beneath the purity
//RS /// checker. Three independent knobs because three different call shapes in
//RS /// this file need three different combinations — see each field's doc.
//RS #[derive(Clone, Copy)]
