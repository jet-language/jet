//RS /// D-META-EFFECT1 c3: the one call-graph purity walk. Walks the call graph
//RS /// reachable from `e`, recursing into `funcs` when a callee is known (with
//RS /// cycle detection via `visited`), and reports the first call
//RS /// `is_leaf_impure` accepts — built into a diagnostic by `diag(name, path,
//RS /// span)` — with the full call-chain path that reached it. Empty `funcs`
//RS /// makes this a direct-body-only check (no transitive recursion), which is
//RS /// what a `-[]>`-declared function's own body check needs; a populated
//RS /// `funcs` map (comptime's reachable functions, or a whole program's) makes
//RS /// it the transitive `jet eval --pure` / comptime-evaluation check. `stage`
//RS /// selects which statement kinds the walk descends into — see
//RS /// [`PurityStage`].
//RS pub fn walk_purity_expr<F>(
//RS     e: &Expr,
//RS     funcs: &HashMap<String, F>,
//RS     is_leaf_impure: &impl Fn(&str) -> bool,
//RS     diag: &impl Fn(&str, &[String], Span) -> Diagnostic,
//RS     stage: PurityStage,
//RS ) -> Result<(), Diagnostic>
//RS where
//RS     F: Borrow<Func>,
//RS {
//RS     walk_purity_expr_from(
//RS         e,
//RS         funcs,
//RS         is_leaf_impure,
//RS         diag,
//RS         &mut HashSet::new(),
//RS         &mut Vec::new(),
//RS         stage,
//RS     )
//RS }
//RS 
