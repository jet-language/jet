// Syntax-only purity and reachable-call walkers shared by build-time and runtime checks.
use std.borrow.Borrow
use std.collections.HashSet
use jet_foundation.[Diagnostic, Span]
use jet_foundation.AST.[EnumLitArg, Expr, Func, LValue, LambdaBody, OrFallback, Pattern, Stmt, StrPart, StructPatField, ForKind, IfStmt, ElseBranch, switched_off, Binding]
use jet_foundation.Authority.[Holds, Effect, builtin_effect]
use jet_foundation.sema.[RightsProvenance, RightsRow]
use jet_comptime.Comptime.Diagnostics.impurity_diag
use jet_comptime.Comptime.[eval_build_time_io, Methods]
use jet_foundation.Syntax

// Rust: crates/jet-comptime/src/Comptime/Purity.rs:27
// Runtime checks descend #Impure and skip comptime blocks; build-time does the reverse.
#Derive(Clone, Copy, PartialEq, Eq)
pub enum PurityStage { RunTime, BuildTime }

// Rust: crates/jet-comptime/src/Comptime/Purity.rs:51
#Derive(Clone, Copy)
struct WalkOpts {
    include_suppressed: Bool,
    descend_impure: Bool,
    descend_comptime_block: Bool,
}
impl WalkOpts {
    // Rust: crates/jet-comptime/src/Comptime/Purity.rs:68
    const PLAIN: WalkOpts = WalkOpts { include_suppressed: false, descend_impure: false, descend_comptime_block: true }
    // Rust: crates/jet-comptime/src/Comptime/Purity.rs:75
    const REACHABLE: WalkOpts = WalkOpts { include_suppressed: true, descend_impure: true, descend_comptime_block: true }
    // Rust: crates/jet-comptime/src/Comptime/Purity.rs:81
    fn for_stage(stage: PurityStage) -> WalkOpts {
        if stage == {
            .RunTime -> WalkOpts { include_suppressed: false, descend_impure: true, descend_comptime_block: false }
            .BuildTime -> WalkOpts.PLAIN
        }
    }
}

// Rust: crates/jet-comptime/src/Comptime/Purity.rs:96
fn check_purity_stmts(stmts: &[Stmt], funcs: &[String:&Func], extern_names: &HashSet<String>) -> () Diagnostic! {
    row :: RightsRow.comptime(RightsProvenance.new("comptime", "compile-time block rights row"))
    is_leaf_impure :: fn(name: String) { comptime_call_denial_path(&row, name, extern_names, &[]).is_some() }
    walk_purity_stmts(stmts, funcs, &is_leaf_impure, &fn(name, path, span) {
        call_chain := comptime_call_denial_path(&row, name, extern_names, path).unwrap_or_else(fn() { path.to_vec() })
        call_chain.push(name.to_string())
        impurity_diag(name, path, span).with_rights_chain(row.kind.name(), ^call_chain, [], None)
    }, .BuildTime)
}

// Rust: crates/jet-comptime/src/Comptime/Purity.rs:126
fn check_purity(init: &Expr, funcs: &[String:&Func], extern_names: &HashSet<String>) -> () Diagnostic! {
    row :: RightsRow.comptime(RightsProvenance.new("comptime", "compile-time initializer rights row"))
    is_leaf_impure :: fn(name: String) { comptime_call_denial_path(&row, name, extern_names, &[]).is_some() }
    walk_purity_expr(init, funcs, &is_leaf_impure, &fn(name, path, span) {
        call_chain := comptime_call_denial_path(&row, name, extern_names, path).unwrap_or_else(fn() { path.to_vec() })
        call_chain.push(name.to_string())
        impurity_diag(name, path, span).with_rights_chain(row.kind.name(), ^call_chain, [], None)
    }, .BuildTime)
}

// Rust: crates/jet-comptime/src/Comptime/Purity.rs:156
fn comptime_call_right(name: String, extern_names: &HashSet<String>) -> String? {
    builtin_effect(name).map(fn(effect) { effect.name().to_string() }).or_else(fn() {
        if extern_names.contains(name) { Val(Effect.FFI.name().to_string()) } else { None }
    })
}

// Rust: crates/jet-comptime/src/Comptime/Purity.rs:167
fn comptime_call_denial_path(row: &RightsRow, name: String, extern_names: &HashSet<String>, path: &[String]) -> [String]? {
    right :: comptime_call_right(name, extern_names)?
    effects :: Holds.from([right])
    row.walk(&effects, path, &[]).denials.into_iter().next().map(fn(denial) { ^denial.chain.call_chain })
}

// Rust: crates/jet-comptime/src/Comptime/Purity.rs:193
// Empty funcs checks only the direct body; a populated table follows the transitive call graph.
pub fn walk_purity_expr<F: Borrow<Func>>(e: &Expr, funcs: &[String:F], is_leaf_impure: &fn(String) -> Bool, diag: &fn(String, &[String], Span) -> Diagnostic, stage: PurityStage) -> () Diagnostic! {
    visited := HashSet<String>.new()
    path := [String]{}
    walk_purity_expr_from(e, funcs, is_leaf_impure, diag, &visited, &path, stage)
}

// Rust: crates/jet-comptime/src/Comptime/Purity.rs:216
pub fn walk_purity_stmts<F: Borrow<Func>>(stmts: &[Stmt], funcs: &[String:F], is_leaf_impure: &fn(String) -> Bool, diag: &fn(String, &[String], Span) -> Diagnostic, stage: PurityStage) -> () Diagnostic! {
    visited := HashSet<String>.new()
    path := [String]{}
    walk_purity_stmts_from(stmts, funcs, is_leaf_impure, diag, &visited, &path, stage)
}

// Rust: crates/jet-comptime/src/Comptime/Purity.rs:242
pub fn walk_purity_stmts_from<F: Borrow<Func>>(stmts: &[Stmt], funcs: &[String:F], is_leaf_impure: &fn(String) -> Bool, diag: &fn(String, &[String], Span) -> Diagnostic, visited: &HashSet<String>, path: &[String], stage: PurityStage) -> () Diagnostic! {
    loop stmt in stmts { walk_purity_stmt(stmt, funcs, is_leaf_impure, diag, visited, path, stage)? }
    ()
}

// Rust: crates/jet-comptime/src/Comptime/Purity.rs:260
fn walk_purity_expr_from<F: Borrow<Func>>(e: &Expr, funcs: &[String:F], is_leaf_impure: &fn(String) -> Bool, diag: &fn(String, &[String], Span) -> Diagnostic, visited: &HashSet<String>, path: &[String], stage: PurityStage) -> () Diagnostic! {
    result: () Diagnostic! = Ok(())
    walk_calls(e, &fn(name, span) {
        if result.is_err() { return }
        if is_leaf_impure(name) {
            result = Err(diag(name, path, span))
        } else if funcs.get(name) == .Val(function) {
            f :: function.borrow()
            if visited.insert(name.to_string()) {
                path.push(name.to_string())
                loop stmt in f.body {
                    if result.is_err() { break }
                    result = walk_purity_stmt(stmt, funcs, is_leaf_impure, diag, visited, path, stage)
                }
                _ :: path.pop()
            }
        }
    })
    ^result
}

// Rust: crates/jet-comptime/src/Comptime/Purity.rs:297
fn walk_purity_stmt<F: Borrow<Func>>(s: &Stmt, funcs: &[String:F], is_leaf_impure: &fn(String) -> Bool, diag: &fn(String, &[String], Span) -> Diagnostic, visited: &HashSet<String>, path: &[String], stage: PurityStage) -> () Diagnostic! {
    result: () Diagnostic! = Ok(())
    walk_stmt_expr_nodes(s, WalkOpts.for_stage(stage), &fn(e) {
        if result.is_ok() { result = walk_purity_expr_from(e, funcs, is_leaf_impure, diag, visited, path, stage) }
    })
    ^result
}

// Rust: crates/jet-comptime/src/Comptime/Purity.rs:323
// The evaluation pass records lock inputs; this pre-pass supplies each call's source span.
pub fn check_build_time_io(e: &Expr, base_dir: &OSPath, diags: &[Diagnostic]) -> Bool {
    before :: diags.len()
    walk_expr_nodes(e, WalkOpts.PLAIN, &fn(expr) {
        if expr != .Call(call) { return }
        if call.name != Syntax.BUILTIN_EMBED_FILE && call.name != Syntax.BUILTIN_EMBED_BYTES && call.name != Syntax.BUILTIN_FIND { return }
        arg :: call.args.first() ?? return
        if eval_build_time_io(call.name, base_dir, Methods.arg_string_literal(arg), None, call.name_span) == .Err(diagnostic) {
            diags.push(^diagnostic)
        }
    })
    diags.len() == before
}

// Rust: crates/jet-comptime/src/Comptime/Purity.rs:356
pub fn walk_calls(e: &Expr, f: &fn(String, Span)) {
    walk_expr_nodes(e, WalkOpts.PLAIN, &fn(expr) { if expr == .Call(call) { f(call.name, call.name_span) } })
}

// Rust: crates/jet-comptime/src/Comptime/Purity.rs:370
pub fn walk_identifiers(e: &Expr, f: &fn(String, Span)) {
    walk_expr_nodes(e, WalkOpts.PLAIN, &fn(expr) { if expr == .Ident(name, span) { f(name, span) } })
}

// Rust: crates/jet-comptime/src/Comptime/Purity.rs:378
fn reachable_owned_funcs(init: &Expr, funcs: &[String:Func]) -> [String:Func] {
    reachable_names :: reachable_func_names(init, funcs)
    reachable_names.into_iter().filter_map(fn(name) { funcs.get(name).cloned().map(fn(function) { (^name, ^function) }) }).collect()
}

// Rust: crates/jet-comptime/src/Comptime/Purity.rs:394
fn reachable_func_names<F: Borrow<Func>>(init: &Expr, funcs: &[String:F]) -> HashSet<String> {
    roots := HashSet<String>.new()
    reachable_func_roots(init, funcs, &roots)
    reachable_func_closure(^roots, funcs)
}

// Rust: crates/jet-comptime/src/Comptime/Purity.rs:403
fn known_func_name<F>(name: String, funcs: &[String:F]) -> String? {
    if funcs.contains_key(name) { return Val(name.to_string()) }
    name.split_once('.').map(fn((module, symbol)) { "{module}::{symbol}" }).filter(fn(qualified) { funcs.contains_key(qualified) })
}

// Rust: crates/jet-comptime/src/Comptime/Purity.rs:412
fn expression_func_name<F>(expr: &Expr, funcs: &[String:F]) -> String? {
    if expr == {
        .Call(call) -> known_func_name(call.name, funcs)
        .Ident(name, _) -> known_func_name(name, funcs)
        .MethodCall { method, recv_type: .Val(owner), .. } -> known_func_name("{owner}::{method}", funcs)
        _ -> None
    }
}

// Rust: crates/jet-comptime/src/Comptime/Purity.rs:429
fn reachable_func_roots<F: Borrow<Func>>(init: &Expr, funcs: &[String:F], roots: &HashSet<String>) {
    walk_expr_nodes(init, WalkOpts.REACHABLE, &fn(expr) {
        if expression_func_name(expr, funcs) == .Val(name) { _ :: roots.insert(^name) }
    })
}

// Rust: crates/jet-comptime/src/Comptime/Purity.rs:449
// Work follows the reachable closure, not the entire function table.
fn reachable_func_closure<F: Borrow<Func>>(roots: HashSet<String>, funcs: &[String:F]) -> HashSet<String> {
    pending: [String] = roots.iter().cloned().collect()
    reached := ^roots
    loop {
        name :: pending.pop() ?? break
        function :: funcs.get(name) ?? continue
        loop statement in function.borrow().body {
            walk_stmt_expr_nodes(statement, WalkOpts.REACHABLE, &fn(expr) {
                if expression_func_name(expr, funcs) == .Val(dependency) {
                    if reached.insert(dependency.clone()) { pending.push(^dependency) }
                }
            })
        }
    }
    ^reached
}

// Rust: crates/jet-comptime/src/Comptime/Purity.rs:475
fn walk_expr_nodes(e: &Expr, opts: WalkOpts, f: &fn(&Expr)) {
    f(e)
    if e == {
        .Str(parts, _) -> {
            loop part in parts { if part == .Interp(expr, _) { walk_expr_nodes(expr, opts, f) } }
        }
        .StrMatchLit(_, _) | .BinMatchLit(_, _) | .Int(_, _, _, _) | .Float(_, _, _, _) | .Bool(_, _) | .Unit(_) | .Char(_, _) | .Ident(_, _) | .UnitLit { .. } | .Absent(_) | .Todo { .. } | .NoElse(_) | .ReduceMarker(_, _) | .ComptimeName { .. } -> {}
        .ListLit(items, _) | .CompareChain { operands: items, .. } -> {
            loop item in items { walk_expr_nodes(item, opts, f) }
        }
        .MemberSpread { base, .. } -> walk_expr_nodes(base, opts, f)
        .Spread(inner, _) | .Unary(_, inner, _) | .Deref(inner, _) | .RawOf(inner, _) | .Copy(inner, _) | .Place(inner, _, _) | .Field(inner, _, _) | .Tainted(inner, _, _) | .Present(inner, _) | .Ok(inner, _) | .Err(inner, _) | .Paren(inner, _) -> walk_expr_nodes(inner, opts, f)
        .Try(inner, _, _, note) -> {
            walk_expr_nodes(inner, opts, f)
            if note == .Val(note) { walk_expr_nodes(note, opts, f) }
        }
        .OptField { base, .. } -> walk_expr_nodes(base, opts, f)
        .Range { start, end, .. } -> {
            walk_expr_nodes(start, opts, f)
            walk_expr_nodes(end, opts, f)
        }
        .MapLit(entries, _) -> {
            loop (key, value) in entries { walk_expr_nodes(key, opts, f); walk_expr_nodes(value, opts, f) }
        }
        .Index { base, index, .. } -> {
            walk_expr_nodes(base, opts, f)
            walk_expr_nodes(index, opts, f)
        }
        .Slice { base, start, end, range, .. } -> {
            walk_expr_nodes(base, opts, f)
            if range == .Val(range) { walk_expr_nodes(range, opts, f) } else {
                walk_expr_nodes(start, opts, f)
                walk_expr_nodes(end, opts, f)
            }
        }
        .Call(call) -> { loop arg in call.args { walk_expr_nodes(&arg.expr, opts, f) } }
        .Binary(_, left, right, _) -> {
            walk_expr_nodes(left, opts, f)
            walk_expr_nodes(right, opts, f)
        }
        .MethodCall { receiver, args, .. } -> {
            walk_expr_nodes(receiver, opts, f)
            loop arg in args { walk_expr_nodes(&arg.expr, opts, f) }
        }
        .StructLit { fields, .. } -> { loop (_, _, value) in fields { walk_expr_nodes(value, opts, f) } }
        .TypedLit { body, .. } -> body.for_each_expr(fn(value) { walk_expr_nodes(value, opts, f) })
        .EnumLit { args, .. } -> {
            loop arg in args {
                value :: if arg == { .Positional(value) | .Named { expr: value, .. } -> value }
                walk_expr_nodes(value, opts, f)
            }
        }
        .PatternTest { subject, pattern, .. } -> {
            walk_expr_nodes(subject, opts, f)
            walk_pattern_expr_nodes(pattern, opts, f)
        }
        .OrFallback { value, fallback, .. } -> {
            walk_expr_nodes(value, opts, f)
            if fallback == {
                .Value(value) | .Return(.Val(value), _) -> walk_expr_nodes(value, opts, f)
                .Block { body, value, .. } -> {
                    loop stmt in body { walk_stmt_expr_nodes(stmt, opts, f) }
                    if value == .Val(value) { walk_expr_nodes(value, opts, f) }
                }
                .Panic { args, .. } -> { loop arg in args { walk_expr_nodes(&arg.expr, opts, f) } }
                .Return(.None, _) | .Break(_) | .Continue(_) | .BreakLabel(..) | .ContinueLabel(..) -> {}
            }
        }
        .If { cond, then_body, then_value, else_body, else_value, .. } -> {
            walk_expr_nodes(cond, opts, f)
            loop stmt in then_body { walk_stmt_expr_nodes(stmt, opts, f) }
            walk_expr_nodes(then_value, opts, f)
            loop stmt in else_body { walk_stmt_expr_nodes(stmt, opts, f) }
            walk_expr_nodes(else_value, opts, f)
        }
        .TupleLit(fields, _, _) -> { loop (_, value) in fields { walk_expr_nodes(value, opts, f) } }
        .Lambda(lambda) -> {
            if opts.include_suppressed {
                if lambda.body == {
                    .Expr(body) -> walk_expr_nodes(body, opts, f)
                    .Block(body) -> { loop stmt in body { walk_stmt_expr_nodes(stmt, opts, f) } }
                }
            }
        }
        .CallValue { callee, args, .. } -> {
            walk_expr_nodes(callee, opts, f)
            loop arg in args { walk_expr_nodes(&arg.expr, opts, f) }
        }
        .PtrFromAddr { addr, .. } -> walk_expr_nodes(addr, opts, f)
    }
}

// Rust: crates/jet-comptime/src/Comptime/Purity.rs:670
pub fn walk_expr_nodes_for_validation(e: &Expr, f: &fn(&Expr)) { walk_expr_nodes(e, WalkOpts.REACHABLE, f) }

// Rust: crates/jet-comptime/src/Comptime/Purity.rs:676
pub fn walk_stmt_expr_nodes_for_validation(stmts: &[Stmt], f: &fn(&Expr)) {
    loop stmt in stmts { walk_stmt_expr_nodes(stmt, WalkOpts.REACHABLE, f) }
}

// Rust: crates/jet-comptime/src/Comptime/Purity.rs:682
fn walk_pattern_expr_nodes(pattern: &Pattern, opts: WalkOpts, f: &fn(&Expr)) {
    if pattern == {
        .Or(patterns, _) -> { loop pattern in patterns { walk_pattern_expr_nodes(pattern, opts, f) } }
        .Struct { fields, .. } -> {
            loop field in fields { if field == .Value { value, .. } { walk_expr_nodes(value, opts, f) } }
        }
        .Variant { .. } | .Present { .. } | .Absent(_) | .Ok { .. } | .Err { .. } | .Range { .. } | .StrMatch { .. } | .BinMatch { .. } -> {}
    }
}

// Rust: crates/jet-comptime/src/Comptime/Purity.rs:707
fn walk_stmt_expr_nodes(s: &Stmt, opts: WalkOpts, f: &fn(&Expr)) {
    if s == {
        .Expr(expr) | .DeferClose { close: expr, .. } | .Val(Binding { init: expr, .. }) | .Yield(expr, _) -> walk_expr_nodes(expr, opts, f)
        .Assign { target, value, .. } -> {
            if target == {
                .Local { .. } -> {}
                .Index { base, index, .. } -> { walk_expr_nodes(base, opts, f); walk_expr_nodes(index, opts, f) }
                .Field { base, .. } -> walk_expr_nodes(base, opts, f)
            }
            walk_expr_nodes(value, opts, f)
        }
        .Return(.Val(expr), _) | .BreakValue(expr, _) | .BreakLabelValue(_, _, expr, _) -> walk_expr_nodes(expr, opts, f)
        .Return(.None, _) | .Break(_) | .Continue(_) | .BreakLabel(..) | .ContinueLabel(..) -> {}
        .While { cond, body, .. } -> {
            walk_expr_nodes(cond, opts, f)
            walk_stmt_body_nodes(body, opts, f)
        }
        .For { kind, body, .. } -> {
            if kind == {
                .Range { start, end, step, .. } -> {
                    walk_expr_nodes(start, opts, f)
                    walk_expr_nodes(end, opts, f)
                    if step == .Val(step) { walk_expr_nodes(step, opts, f) }
                }
                .In { collection, step } -> {
                    walk_expr_nodes(collection, opts, f)
                    if step == .Val(step) { walk_expr_nodes(step, opts, f) }
                }
            }
            walk_stmt_body_nodes(body, opts, f)
        }
        .Switch { subject, arms, else_body, .. } | .ComptimeSwitch { subject, arms, else_body, .. } -> {
            walk_expr_nodes(subject, opts, f)
            loop arm in arms { walk_expr_nodes(&arm.cond, opts, f); walk_stmt_body_nodes(&arm.body, opts, f) }
            if else_body == .Val(body) { walk_stmt_body_nodes(body, opts, f) }
        }
        .CountedLoop { init, cond, step, body, .. } -> {
            walk_expr_nodes(&init.init, opts, f)
            walk_expr_nodes(cond, opts, f)
            if step == .Val(step) { walk_stmt_expr_nodes(step, opts, f) }
            walk_stmt_body_nodes(body, opts, f)
        }
        .Unsafe { audit_expr, body, .. } -> {
            if audit_expr == .Val(audit) { walk_expr_nodes(audit, opts, f) }
            walk_stmt_body_nodes(body, opts, f)
        }
        .Impure { reason_expr, body, .. } -> {
            if opts.descend_impure {
                if reason_expr == .Val(reason) { walk_expr_nodes(reason, opts, f) }
                walk_stmt_body_nodes(body, opts, f)
            }
        }
        .AssumeDet { reason_expr, body, .. } -> {
            if opts.include_suppressed { walk_expr_nodes(reason_expr, opts, f); walk_stmt_body_nodes(body, opts, f) }
        }
        .ComptimeIf { cond, then_body, else_body, .. } -> {
            walk_expr_nodes(cond, opts, f)
            walk_stmt_body_nodes(then_body, opts, f)
            if else_body == .Val(body) { walk_stmt_body_nodes(body, opts, f) }
        }
        .ContextBlock { fields, body, .. } -> {
            loop (_, value, _) in fields { walk_expr_nodes(value, opts, f) }
            walk_stmt_body_nodes(body, opts, f)
        }
        .ScopeMember { args, body, .. } -> {
            loop arg in args { walk_expr_nodes(arg, opts, f) }
            walk_stmt_body_nodes(body, opts, f)
        }
        .ComptimeBlock { body, .. } -> { if opts.descend_comptime_block { walk_stmt_body_nodes(body, opts, f) } }
        .Switched { marker, body, .. } -> { if !switched_off(marker) { walk_stmt_body_nodes(body, opts, f) } }
        .Loop { body, .. } | .Reactive { body, .. } | .Shield { body, .. } | .Region { body, .. } | .Policy { body, .. } | .TaskGroup { body, .. } | .Layout { body, .. } | .AuthorityScope { body, .. } | .Live { body, .. } | .Transact { body, .. } -> walk_stmt_body_nodes(body, opts, f)
    }
}

// Rust: crates/jet-comptime/src/Comptime/Purity.rs:880
fn walk_if_stmt_expr_nodes(if_stmt: &IfStmt, opts: WalkOpts, f: &fn(&Expr)) {
    walk_expr_nodes(&if_stmt.cond, opts, f)
    walk_stmt_body_nodes(&if_stmt.then_body, opts, f)
    if if_stmt.else_branch == {
        .Val(.ElseIf(inner)) -> walk_if_stmt_expr_nodes(inner, opts, f)
        .Val(.Else(body)) -> walk_stmt_body_nodes(body, opts, f)
        .None -> {}
    }
}

// Rust: crates/jet-comptime/src/Comptime/Purity.rs:898
fn walk_stmt_body_nodes(body: &[Stmt], opts: WalkOpts, f: &fn(&Expr)) {
    loop stmt in body { walk_stmt_expr_nodes(stmt, opts, f) }
}
