//RS     /// its enclosing statement), on for `reachable_owned_funcs`, which wants
//RS     /// every name reachable from anywhere, suppressed body or not.
//RS     include_suppressed: bool,
//RS     /// `#Impure(...)` bodies — see [`PurityStage`].
//RS     descend_impure: bool,
//RS     /// `@ { ... }` comptime blocks — see [`PurityStage`].
//RS     descend_comptime_block: bool,
//RS }
//RS 
