//RS     pub nominal_identities: HashMap<String, String>,
//RS }
//RS 
//RS /// Checked nominal facts retained for a comptime fragment.
//RS ///
//RS /// Sema owns the source-to-canonical projection and the checked declaration
//RS /// rows. The fragment lowerer consumes these facts without rediscovering an
//RS /// imported owner from erased `CtValue` data.
//RS #[derive(Clone, Debug, Default)]
//RS pub struct MirFragmentNominalFacts {
//RS     /// Source spellings (including import-qualified and selective-import
//RS     /// names) to canonical `package::module::Type` identities.
//RS     pub nominal_identities: HashMap<String, String>,
//RS     /// Source import alias to the target module's loader alias.
//RS     pub import_modules: HashMap<String, String>,
//RS     /// Canonical nominal identity to the target module's loader alias.
//RS     pub foreign_modules: HashMap<String, String>,
//RS     /// Canonical imported struct identity to its checked declaration row.
//RS     pub structs: HashMap<String, StructDef>,
//RS     /// Checked enum declarations, including their payload shapes.
//RS     pub enums: HashMap<String, crate::AST::EnumDef>,
//RS     /// Loaded source signatures for imported source-owned Core members.
//RS     pub core_source_sigs: HashMap<(String, String), MirFragmentCoreSourceSignature>,
//RS     /// Loaded source-owned Core modules keyed by Core module path
//RS     /// (`core.math`); the owner of every `core_source_sigs` row is here.
//RS     /// Shared: every evaluation request clones these facts.
//RS     pub core_source_bodies: std::sync::Arc<HashMap<String, MirFragmentCoreSourceModule>>,
//RS     /// The evaluated module's member-imported user functions (`use b.[f]`):
//RS     /// local name to (`core_source_bodies` key, function name).
//RS     pub imported_functions: HashMap<String, (String, String)>,
//RS     /// Declared signatures of the evaluated module's user-module callees,
//RS     /// keyed by (source alias or local name, function name).
//RS     pub import_signatures: HashMap<(String, String), MirFragmentCoreSourceSignature>,
//RS }
