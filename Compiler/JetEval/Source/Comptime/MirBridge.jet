//RS pub struct ExprEvalRequest<'a> {
//RS     pub data_pipeline: &'a mut crate::Comptime::DataPipelineState,
//RS     pub expr: &'a Expr,
//RS     pub funcs: &'a HashMap<String, &'a Func>,
//RS     /// Authoritative static types for names in the active interpreter frame.
//RS     /// Fragment lowering must use these instead of guessing from erased values.
//RS     pub binding_types: &'a HashMap<String, Type>,
//RS     /// Checked `impl Source -> Target` bodies available to fragment lowering.
//RS     /// The evaluator lowers these through the same TIR conversion path as AOT.
//RS     pub error_conversions: &'a [crate::AST::ErrorConvDef],
//RS     /// Exact `(owner, method) -> trait` identity selected by sema for
//RS     /// associated calls. The canonical fragment must carry the same trait
//RS     /// identity as the normal bundle lowering; a method-name-only lookup can
//RS     /// silently turn a literal capability into an inherent call.
//RS     pub method_traits: &'a HashMap<(String, String), String>,
//RS     /// Instance/associated methods are kept in their semantic owner/name table
//RS     /// by comptime. The MIR fragment host needs the same table to lower
//RS     /// computed-field getters and to call user methods.
//RS     pub methods: &'a HashMap<(String, String), &'a Func>,
//RS     pub extern_names: &'a HashSet<String>,
//RS     pub base_dir: &'a Path,
//RS     pub globals: &'a HashMap<String, CtValue>,
//RS     pub core_imports: &'a HashMap<String, String>,
//RS     pub gates: jet_foundation::Policy::GateSet,
//RS     pub initial_impure_depth: usize,
//RS     /// Explicit execution provenance for the canonical fragment. Runtime
//RS     /// producers use the runtime Core dispatcher; comptime evaluation remains
//RS     /// on the gated fragment dispatcher.
//RS     pub runtime_execution: bool,
//RS     pub structs: &'a HashMap<String, &'a StructDef>,
//RS     pub computed_fields: &'a HashMap<(String, String), &'a Expr>,
//RS     pub distinct_ranges: &'a HashMap<String, Option<(i64, i64)>>,
//RS     pub distinct_bases: &'a HashMap<String, Type>,
//RS     /// Unit-family declarations seed the codegen context's canonical facts
//RS     /// for fragment lowering; conversion semantics remain in MIR/Prelude.
//RS     pub unit_families: &'a [crate::AST::UnitFamilyDef],
//RS     pub fuel: u64,
//RS     pub sink: Option<&'a mut DevSink>,
//RS     /// Checked nominal identities and imported struct rows for fragment
//RS     /// lowering. `None` is used by callers without an active module scope.
//RS     pub checked_nominals: Option<MirFragmentNominalFacts>,
//RS     pub repl_mode: bool,
//RS     pub repl_grants: &'a [CtValue],
//RS     pub repl_authorizer: Option<&'a mut dyn ReplAuthorizer>,
//RS     /// D-CTEFFECT1 Tier-1 inputs recorded by the canonical host surface.
//RS     pub embed_inputs: Option<&'a mut Vec<ComptimeInput>>,
//RS     /// Bindings as the fragment left them. An expression can mutate a binding
//RS     /// it reads — `reader.read_u32_le()` advances the reader — and a statement
//RS     /// driver has to see the advance, or the next expression starts over.
//RS     /// `None` for pure const evaluation, which has no caller scope to update.
//RS     pub mutated: Option<&'a mut HashMap<String, CtValue>>,
//RS }
