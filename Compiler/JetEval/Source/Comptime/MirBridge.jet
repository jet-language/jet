// Rust: crates/jet-comptime/src/Comptime/MirBridge.rs:257
pub fn static_ct_value(expr: &Expr, globals: &[String:CtValue], mutated: (&[String:CtValue])?) -> CtValue? {
    match expr {
        .Int(value, _, _, raw) -> Val(exact_integer_ct_value(value, raw))
        .Bool(value, _) -> Val(CtValue.Bool(value))
        .Char(value, _) -> Val(CtValue.Char(value))
        .Str(parts, _) -> {
            fragments := [String]{}
            loop part in parts {
                match part { .Lit(text) -> &fragments.push(text); .Interp(..) -> return None }
            }
            Val(CtValue.Str(fragments.join("")))
        }
        .TypedLit{head: Val(Type.Named(type_name)), body: .Value(inner), ..} if type_name == Syntax.TYPE_PATH -> {
            value :: static_ct_value(inner, globals, mutated) ?? return None
            match value {
                .Str(text) -> Val(CtValue.Struct{type_name: type_name, fields: [(String, CtValue)]{("inner", CtValue.Str(^text))}})
                _ -> None
            }
        }
        .Unary(AST.UnOp.Not, inner, _) -> {
            match static_ct_value(inner, globals, mutated) ?? return None {
                .Bool(value) -> Val(CtValue.Bool(!value))
                _ -> None
            }
        }
        .Binary(op, left, right, _) -> {
            left_value :: static_ct_value(left, globals, mutated) ?? return None
            right_value :: static_ct_value(right, globals, mutated) ?? return None
            result :: match (op, left_value, right_value) {
                (.And, .Bool(a), .Bool(b)) -> a && b
                (.Or, .Bool(a), .Bool(b)) -> a || b
                (.Eq | .Ne, .Int(a), .Int(b)) -> a == b
                (.Eq | .Ne, .Bool(a), .Bool(b)) -> a == b
                (.Eq | .Ne, .Char(a), .Char(b)) -> a == b
                (.Eq | .Ne, .Str(a), .Str(b)) -> a == b
                (.Lt, .Int(a), .Int(b)) -> a < b
                (.Gt, .Int(a), .Int(b)) -> a > b
                (.Le, .Int(a), .Int(b)) -> a <= b
                (.Ge, .Int(a), .Int(b)) -> a >= b
                (.Lt, .Char(a), .Char(b)) -> a < b
                (.Gt, .Char(a), .Char(b)) -> a > b
                (.Le, .Char(a), .Char(b)) -> a <= b
                (.Ge, .Char(a), .Char(b)) -> a >= b
                _ -> return None
            }
            Val(CtValue.Bool(if op == .Ne -> !result else -> result))
        }
        .ListLit(values, _) -> {
            out := [CtValue]{}
            loop value in values -> &out.push(static_ct_value(value, globals, mutated) ?? return None)
            Val(CtValue.List(^out))
        }
        .Paren(inner, _) | .Copy(inner, _) -> static_ct_value(inner, globals, mutated)
        .Ident(name, _) | .ComptimeName{name: name, value: None, ..} -> {
            if mutated == Val(values) { if values.get(name) == Val(value) -> return Val(value.clone()) }
            globals.get(name).map(fn(value) { value.clone() })
        }
        .ComptimeName{value: Val(value), ..} -> Val(value.clone())
        .Field(base, member, _) -> {
            if static_ct_place(base, globals, mutated) == Val(value) -> return static_ct_field(value, member).map(fn(field) { field.clone() })
            owned :: static_ct_value(base, globals, mutated) ?? return None
            static_ct_field(&owned, member).map(fn(field) { field.clone() })
        }
        .Index{base, index, ..} -> {
            value :: static_ct_value(base, globals, mutated) ?? return None
            index_value :: static_ct_value(index, globals, mutated) ?? return None
            index :: match index_value { .Int(i) -> USize.try_from(i).ok() ?? return None; _ -> return None }
            match value {
                .List(values) -> values.get(index).map(fn(value) { value.clone() })
                .Bytes(values) -> values.get(index).map(fn(value) { CtValue.Int(I64.from(value)) })
                _ -> None
            }
        }
        .MethodCall{receiver, method, args, ..} if method == "has_marker" -> {
            value :: static_ct_value(receiver, globals, mutated) ?? return None
            evaluated := [CtValue]{}
            loop arg in args -> &evaluated.push(static_ct_value(&arg.expr, globals, mutated) ?? return None)
            Builtins.apply_method(&value, method, ^evaluated, expr.span()).ok()
        }
        .MethodCall{receiver, method, args, ..} if method == "len" && args.is_empty() -> {
            value :: static_ct_value(receiver, globals, mutated) ?? return None
            len :: match value {
                .List(values) -> values.len()
                .Bytes(values) -> values.len()
                .Map(values) -> values.len()
                .Str(text) -> text.chars().count()
                _ -> return None
            }
            I64.try_from(len).ok().map(fn(len) { CtValue.Int(len) })
        }
        _ -> None
    }
}
// Rust: crates/jet-comptime/src/Comptime/MirBridge.rs:409
fn static_ct_place(expr: &Expr, globals: &[String:CtValue], mutated: (&[String:CtValue])?) -> (&CtValue)? {
    match expr {
        .Paren(inner, _) | .Copy(inner, _) -> static_ct_place(inner, globals, mutated)
        .Ident(name, _) | .ComptimeName{name: name, value: None, ..} -> {
            if mutated == Val(values) { if values.get(name) == Val(value) -> return Val(value) }
            globals.get(name)
        }
        .ComptimeName{value: Val(value), ..} -> Val(value)
        .Field(base, member, _) -> static_ct_field(static_ct_place(base, globals, mutated) ?? return None, member)
        _ -> None
    }
}
// Rust: crates/jet-comptime/src/Comptime/MirBridge.rs:433
fn static_ct_field(value: &CtValue, member: String) -> (&CtValue)? {
    if Registry.fact_read(member) == Val(read) -> return reflected_fact_field(value, read)
    match value {
        .Struct{fields, ..} -> {
            name := member.trim_start_matches('$') // #4303
            loop (field, value) in fields -> if field == name -> return Val(value)
            None
        }
        _ -> None
    }
}
// Rust: crates/jet-comptime/src/Comptime/MirBridge.rs:448
pub fn eval_expr(req: &ExprEvalRequest) -> CtValue Diagnostic! {
    if static_ct_value(req.expr, req.globals, req.mutated) == Val(value) -> return ^value
    hooks().eval_expr(req)
}
// Rust: crates/jet-comptime/src/Comptime/MirBridge.rs:455
pub fn eval_block(req: &BlockEvalRequest) -> StmtOutcome Diagnostic! { hooks().eval_block(req) }
// Rust: crates/jet-comptime/src/Comptime/MirBridge.rs:461
fn conversion_error(message: String, span: Span) -> Diagnostic {
    Diagnostic.error("E0956", message, "the comptime boundary accepts only canonical MIR runtime values", "keep the value on the canonical Prelude/Core path or use a serializable value", Val(span))
}
// Rust: crates/jet-comptime/src/Comptime/MirBridge.rs:471
pub fn mir_to_ct_key(key: &MirConstKey) -> CtKey {
    match key {
        .Int(value) -> CtKey.Int(value)
        .String(value) -> CtKey.Str(value.clone())
        .Bool(value) -> CtKey.Bool(value)
        .Char(value) -> CtKey.Char(value)
        .Tuple(fields) -> CtKey.Tuple(fields.map(fn(row) { (row.0.clone(), mir_to_ct_key(&row.1)) }))
        .Struct{type_name, fields} -> CtKey.Struct{type_name: type_name.clone(), fields: fields.map(fn(row) { (row.0.clone(), mir_to_ct_key(&row.1)) })}
        .Enum{type_name, variant} -> CtKey.Enum{type_name: type_name.clone(), variant: variant.clone()}
    }
}
// Rust: crates/jet-comptime/src/Comptime/MirBridge.rs:497
pub fn ct_to_mir_key(key: CtKey) -> MirConstKey {
    match key {
        .Int(value) -> MirConstKey.Int(value)
        .Str(value) -> MirConstKey.String(^value)
        .Bool(value) -> MirConstKey.Bool(value)
        .Char(value) -> MirConstKey.Char(value)
        .Tuple(fields) -> MirConstKey.Tuple(fields.into_iter().map(fn(row) { (^row.0, ct_to_mir_key(^row.1)) }).collect())
        .Struct{type_name, fields} -> MirConstKey.Struct{type_name: ^type_name, fields: fields.into_iter().map(fn(row) { (^row.0, ct_to_mir_key(^row.1)) }).collect()}
        .Enum{type_name, variant} -> MirConstKey.Enum{type_name: ^type_name, variant: ^variant}
    }
}
// Rust: crates/jet-comptime/src/Comptime/MirBridge.rs:522
pub fn ast_to_mir_type(ty: &Type) -> MirType {
    kind :: match ty {
        .Int -> MirTypeKind.Int
        .Float -> MirTypeKind.Float
        .Bool -> MirTypeKind.Bool
        .String -> MirTypeKind.String
        .Char -> MirTypeKind.Char
        .List(inner) -> MirTypeKind.List(ast_to_mir_type(inner))
        .Map{key, value, ..} -> MirTypeKind.Map{key: ast_to_mir_type(key), value: ast_to_mir_type(value)}
        .Shared(inner) -> MirTypeKind.Shared(ast_to_mir_type(inner))
        .Option(inner) -> MirTypeKind.Option(ast_to_mir_type(inner))
        .Result{ok, err} -> MirTypeKind.Result{ok: ast_to_mir_type(ok), err: ast_to_mir_type(err)}
        .Fn{params, ret, effect_bound, param_contract, call_metadata, return_view_provenance} -> MirTypeKind.Fn(ast_to_mir_function_signature(params, ret, effect_bound, param_contract, call_metadata, return_view_provenance))
        .Named(name) -> MirTypeKind.Apply{name: MIR.MirNominalRef.from_name(name), args: [MirType]{}}
        .Apply{name, args} -> MirTypeKind.Apply{name: MIR.MirNominalRef.from_name(name), args: args.map(ast_to_mir_type)}
        .TraitObject(bounds) -> MirTypeKind.TraitObject(bounds.map(fn(bound) { MIR.MirNominalRef.from_name(bound) }))
        .Tuple(fields) -> MirTypeKind.Tuple(fields.map(fn(row) { (row.0.clone(), ast_to_mir_type(&row.1)) }))
        .FixedList{elem, len} -> MirTypeKind.FixedList{elem: ast_to_mir_type(elem), len: ast_to_mir_measure(len)}
        .IntN{signed, bits} -> MirTypeKind.IntN{signed: signed, bits: bits}
        .InlineRange{base, lo, hi} -> MirTypeKind.InlineRange{base: ast_to_mir_type(base), lo: lo, hi: hi}
        .Float32 -> MirTypeKind.Float32
        .Tagged{marker, inner} -> MirTypeKind.Tagged{marker: ast_to_mir_tag_marker(marker), inner: ast_to_mir_type(inner)}
        .Union(members) -> MirTypeKind.Union(members.map(ast_to_mir_type))
        .Quantity{base, dimension} -> MirTypeKind.Quantity{base: ast_to_mir_type(base), dimension: ast_to_mir_dimension(dimension)}
        .Measure(measure) -> MirTypeKind.Measure(ast_to_mir_measure(measure))
    }
    MirType.from_kind(^kind).with_identity(MIR.MirTypeId(MIR.stable_id("mir-type", ty.identity_key())))
}
// Rust: crates/jet-comptime/src/Comptime/MirBridge.rs:605
fn ast_to_mir_function_signature(params: &[Type], ret: Type?, effect_bound: [(String, Span)]?, param_contract: [(String, AST.ParamZone)]?, call_metadata: AST.FunctionCallMetadata?, return_view_provenance: AST.ViewProvenanceMap?) -> MIR.MirFunctionSignature {
    MIR.MirFunctionSignature{
        params: params.map(ast_to_mir_type), ret: ret.map(ast_to_mir_type),
        effect_bound: effect_bound.map(fn(row) { row.map(fn(item) { item.0.clone() }) }),
        param_contract: param_contract.map(fn(rows) { rows.map(fn(row) {
            MIR.MirCallContractRow{label: row.0.clone(), zone: match row.1 {
                .PositionalOnly -> MIR.MirParamZone.PositionalOnly
                .Either -> MIR.MirParamZone.Either
                .LabelOnly -> MIR.MirParamZone.LabelOnly
            }}
        }) }),
        call_metadata: call_metadata.map(ast_to_mir_call_metadata),
        return_view_provenance: return_view_provenance.map(ast_to_mir_view_provenance)
    }
}
// Rust: crates/jet-comptime/src/Comptime/MirBridge.rs:642
fn ast_to_mir_call_metadata(metadata: &AST.FunctionCallMetadata) -> MIR.MirCallMetadata {
    MIR.MirCallMetadata{
        names: metadata.names.clone(), defaults: metadata.defaults.map(fn(value) { value.is_some() }),
        variadic: metadata.variadic.clone(), conventions: metadata.conventions.map(ast_to_mir_access),
        policies: MIR.MirCallablePolicyChain{policies: metadata.policies.policies.map(fn(policy) {
            MIR.MirCallablePolicy{name: policy.name.clone(), arguments: policy.arguments.clone()}
        })}
    }
}
// Rust: crates/jet-comptime/src/Comptime/MirBridge.rs:669
fn ast_to_mir_access(access: AccessConvention) -> MIR.MirAccess {
    match access { .Read -> MIR.MirAccess.Read; .Write -> MIR.MirAccess.Write; .Move -> MIR.MirAccess.Move }
}
// Rust: crates/jet-comptime/src/Comptime/MirBridge.rs:677
fn ast_to_mir_view_provenance(map: &AST.ViewProvenanceMap) -> [[String]:MIR.MirViewProvenance] {
    out := [[String]:MIR.MirViewProvenance]{}
    keys := map.keys().collect()
    &keys.sort()
    loop path in keys {
        provenance :: map[path]
        sources := Set<MIR.MirViewSourcePath>.new()
        loop source in provenance.sources {
            origin :: match source.source {
                .Receiver -> MIR.MirViewSource.Receiver
                .Parameter(index) -> MIR.MirViewSource.Parameter(index)
                .Static{module_path, name} -> MIR.MirViewSource.Static{module_path: module_path.clone(), name: name.clone()}
            }
            projections :: source.projections.map(fn(projection) {
                match projection { .Field(name) -> MIR.MirViewProjection.Field(name.clone()); .Index -> MIR.MirViewProjection.Index; .Range -> MIR.MirViewProjection.Range }
            })
            _ :: &sources.insert(MIR.MirViewSourcePath{source: ^origin, projections: ^projections})
        }
        out[path.clone()] = MIR.MirViewProvenance{sources: ^sources, mutable: provenance.mutable}
    }
    ^out
}
// Rust: crates/jet-comptime/src/Comptime/MirBridge.rs:728
fn ast_to_mir_measure(measure: &AST.Measure) -> MIR.MirMeasure {
    match measure {
        .Literal{kind, value} -> MIR.MirMeasure.Literal{kind: kind.clone(), value: value}
        .SignedLiteral{kind, value} -> MIR.MirMeasure.SignedLiteral{kind: kind.clone(), value: value}
        .Symbol{kind, name} -> MIR.MirMeasure.Symbol{kind: kind.clone(), name: name.clone()}
        .Combined{kind, rule, left, right} -> MIR.MirMeasure.Combined{
            kind: kind.clone(), rule: match rule { .Add -> MIR.MirMeasureRule.Add; .Mul -> MIR.MirMeasureRule.Mul; .Match -> MIR.MirMeasureRule.Match },
            left: ast_to_mir_measure(left), right: ast_to_mir_measure(right)
        }
    }
}
// Rust: crates/jet-comptime/src/Comptime/MirBridge.rs:762
fn ast_to_mir_dimension(dimension: &AST.Dimension) -> MIR.MirDimension {
    MIR.MirDimension{axes: dimension.measure_exponents().map(fn(row) { (row.0.to_string(), ast_to_mir_measure(&row.1)) }).collect()}
}
// Rust: crates/jet-comptime/src/Comptime/MirBridge.rs:771
fn ast_to_mir_tag_marker(marker: &AST.TagMarker) -> MIR.MirTagMarker {
    match marker {
        .User(name) -> MIR.MirTagMarker.User(name.clone())
        .Internal(tag) -> MIR.MirTagMarker.Internal(match tag {
            .CoreCryptoNominal -> MIR.MirInternalTag.CoreCryptoNominal
            .DeterministicClock -> MIR.MirInternalTag.DeterministicClock
            .SystemClock -> MIR.MirInternalTag.SystemClock
            .ExpiringSecretLoan -> MIR.MirInternalTag.ExpiringSecretLoan
            .SharedGuardRead -> MIR.MirInternalTag.SharedGuardRead
            .SharedGuardEdit -> MIR.MirInternalTag.SharedGuardEdit
            .TerminalFactSet -> MIR.MirInternalTag.TerminalFactSet
            .CppCallbackAbi -> MIR.MirInternalTag.CppCallbackAbi
            .AllocatorView -> MIR.MirInternalTag.AllocatorView
        })
    }
}
// Rust: crates/jet-comptime/src/Comptime/MirBridge.rs:810
pub fn mir_to_ast_type(ty: &MirType) -> Type {
    match ty.kind() {
        .Int -> Type.Int
        .Float -> Type.Float
        .Bool -> Type.Bool
        .String -> Type.String
        .Char -> Type.Char
        .List(inner) -> Type.List(mir_to_ast_type(inner))
        .Map{key, value} -> Type.Map{key: mir_to_ast_type(key), key_span: None, value: mir_to_ast_type(value)}
        .Shared(inner) -> Type.Shared(mir_to_ast_type(inner))
        .Option(inner) -> Type.Option(mir_to_ast_type(inner))
        .Result{ok, err} -> Type.Result{ok: mir_to_ast_type(ok), err: mir_to_ast_type(err)}
        .Fn(signature) -> Type.Fn{
            params: signature.params.map(mir_to_ast_type), ret: signature.ret.map(mir_to_ast_type),
            effect_bound: signature.effect_bound.map(fn(rows) { rows.map(fn(name) { (name.clone(), Span.new(0, 0)) }) }),
            param_contract: signature.param_contract.map(fn(rows) { rows.map(fn(row) {
                (row.label.clone(), match row.zone { .PositionalOnly -> AST.ParamZone.PositionalOnly; .Either -> AST.ParamZone.Either; .LabelOnly -> AST.ParamZone.LabelOnly })
            }) }),
            call_metadata: signature.call_metadata.map(mir_to_ast_call_metadata),
            return_view_provenance: signature.return_view_provenance.map(mir_to_ast_view_provenance)
        }
        .SendFn{params, ret, ..} -> Type.Fn{params: params.map(mir_to_ast_type), ret: ret.map(mir_to_ast_type), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
        .Apply{name, args} -> if args.is_empty() -> Type.Named(name.name.clone()) else -> Type.Apply{name: name.name.clone(), args: args.map(mir_to_ast_type)}
        .TraitObject(bounds) -> Type.TraitObject(bounds.map(fn(bound) { bound.name.clone() }))
        .Tuple(fields) -> Type.Tuple(fields.map(fn(row) { (row.0.clone(), mir_to_ast_type(&row.1)) }))
        .FixedList{elem, len} -> Type.FixedList{elem: mir_to_ast_type(elem), len: mir_to_ast_measure(len)}
        .IntN{signed, bits} -> Type.IntN{signed: signed, bits: bits}
        .InlineRange{base, lo, hi} -> Type.InlineRange{base: mir_to_ast_type(base), lo: lo, hi: hi}
        .Float32 -> Type.Float32
        .Tagged{marker, inner} -> Type.Tagged{marker: mir_to_ast_tag_marker(marker), inner: mir_to_ast_type(inner)}
        .Union(members) -> Type.Union(members.map(mir_to_ast_type))
        .Quantity{base, dimension} -> Type.Quantity{base: mir_to_ast_type(base), dimension: mir_to_ast_dimension(dimension)}
        .Measure(measure) -> Type.Measure(mir_to_ast_measure(measure))
    }
}
// Rust: crates/jet-comptime/src/Comptime/MirBridge.rs:920
fn mir_to_ast_call_metadata(metadata: &MIR.MirCallMetadata) -> AST.FunctionCallMetadata {
    AST.FunctionCallMetadata{
        names: metadata.names.clone(), defaults: metadata.defaults.map(fn(_) { None }),
        variadic: metadata.variadic.clone(), conventions: metadata.conventions.map(mir_to_ast_access),
        policies: AST.CallablePolicyChain{policies: metadata.policies.policies.map(fn(policy) { AST.CallablePolicy{name: policy.name.clone(), arguments: policy.arguments.clone()} })}
    }
}
// Rust: crates/jet-comptime/src/Comptime/MirBridge.rs:951
fn mir_to_ast_access(access: MIR.MirAccess) -> AccessConvention {
    match access { .Read -> AccessConvention.Read; .Write -> AccessConvention.Write; .Move -> AccessConvention.Move }
}
// Rust: crates/jet-comptime/src/Comptime/MirBridge.rs:959
fn mir_to_ast_view_provenance(map: &[[String]:MIR.MirViewProvenance]) -> AST.ViewProvenanceMap {
    out := AST.ViewProvenanceMap{}
    keys := map.keys().collect()
    &keys.sort()
    loop path in keys {
        provenance :: map[path]
        sources := Set<AST.ViewSourcePath>.new()
        loop source in provenance.sources {
            origin :: match source.source {
                .Receiver -> AST.ViewSource.Receiver
                .Parameter(index) -> AST.ViewSource.Parameter(index)
                .Static{module_path, name} -> AST.ViewSource.Static{module_path: module_path.clone(), name: name.clone()}
            }
            projections :: source.projections.map(fn(projection) {
                match projection { .Field(name) -> AST.ViewSourceProjection.Field(name.clone()); .Index -> AST.ViewSourceProjection.Index; .Range -> AST.ViewSourceProjection.Range }
            })
            _ :: &sources.insert(AST.ViewSourcePath{source: ^origin, projections: ^projections})
        }
        out[path.clone()] = AST.ViewProvenance{sources: ^sources, mutable: provenance.mutable}
    }
    ^out
}
// Rust: crates/jet-comptime/src/Comptime/MirBridge.rs:1010
fn mir_to_ast_measure(measure: &MIR.MirMeasure) -> AST.Measure {
    match measure {
        .Literal{kind, value} -> AST.Measure.Literal{kind: kind.clone(), value: value}
        .SignedLiteral{kind, value} -> AST.Measure.SignedLiteral{kind: kind.clone(), value: value}
        .Symbol{kind, name} -> AST.Measure.Symbol{kind: kind.clone(), name: name.clone()}
        .Combined{kind, rule, left, right} -> AST.Measure.Combined{
            kind: kind.clone(), rule: match rule { .Add -> AST.MeasureRule.Add; .Mul -> AST.MeasureRule.Mul; .Match -> AST.MeasureRule.Match },
            left: mir_to_ast_measure(left), right: mir_to_ast_measure(right)
        }
    }
}
// Rust: crates/jet-comptime/src/Comptime/MirBridge.rs:1044
fn mir_to_ast_dimension(dimension: &MIR.MirDimension) -> AST.Dimension {
    AST.Dimension.from_identity(dimension.identity()) ?? panic("canonical MIR dimensions use concrete exponents")
}
// Rust: crates/jet-comptime/src/Comptime/MirBridge.rs:1049
fn mir_to_ast_tag_marker(marker: &MIR.MirTagMarker) -> AST.TagMarker {
    match marker {
        .User(name) -> AST.TagMarker.User(name.clone())
        .Internal(tag) -> AST.TagMarker.Internal(match tag {
            .CoreCryptoNominal -> AST.InternalTag.CoreCryptoNominal
            .DeterministicClock -> AST.InternalTag.DeterministicClock
            .SystemClock -> AST.InternalTag.SystemClock
            .ExpiringSecretLoan -> AST.InternalTag.ExpiringSecretLoan
            .SharedGuardRead -> AST.InternalTag.SharedGuardRead
            .SharedGuardEdit -> AST.InternalTag.SharedGuardEdit
            .TerminalFactSet -> AST.InternalTag.TerminalFactSet
            .CppCallbackAbi -> AST.InternalTag.CppCallbackAbi
            .AllocatorView -> AST.InternalTag.AllocatorView
        })
    }
}
// Rust: crates/jet-comptime/src/Comptime/MirBridge.rs:1087
pub fn mir_to_ct_value(value: MirRuntimeValue, span: Span) -> CtValue Diagnostic! {
    match value {
        .Int(value) -> CtValue.Int(value)
        .BigInt(value) -> {
            integer :: CtBigInt.from_str(value) ?? return Err(conversion_error(err, span))
            CtValue.BigInt(^integer)
        }
        .Float{value, f32} -> CtValue.Float(if f32 -> CtFloat.F32(F32.from(value)) else -> CtFloat.F64(value))
        .Bool(value) -> CtValue.Bool(value)
        .Char(value) -> CtValue.Char(value)
        .String(value) -> CtValue.Str(^value)
        .Bytes(value) -> CtValue.Bytes(^value)
        .List(values) -> {
            out := [CtValue]{}
            loop value in values -> &out.push(mir_to_ct_value(^value, span)?)
            CtValue.List(^out)
        }
        .Map(values) -> {
            out := [CtKey:CtValue]{}
            loop (key, value) in values -> out[mir_to_ct_key(&key)] = mir_to_ct_value(^value, span)?
            CtValue.Map(^out)
        }
        .Struct{type_name, fields} -> {
            out := [(String, CtValue)]{}
            loop (name, value) in fields -> &out.push((^name, mir_to_ct_value(^value, span)?))
            CtValue.Struct{type_name: user_type_name(^type_name), fields: ^out}
        }
        .Enum{type_name, variant, args} -> {
            out := [(String, CtValue)]{}
            loop (name, value) in args -> &out.push((^name, mir_to_ct_value(^value, span)?))
            CtValue.Enum{type_name: user_type_name(^type_name), variant: ^variant, args: ^out}
        }
        .Present(value) -> CtValue.Present(mir_to_ct_value(^value, span)?)
        .FailedTold(value) -> CtValue.Failed(CtReport.Told(mir_to_ct_value(^value, span)?))
        .Absent{element} -> CtValue.absent(mir_to_ast_type(&element))
        .Unit -> CtValue.Unit
        .Moved -> Err(conversion_error("internal moved value cannot cross the comptime boundary", span))
        .NativeCursor(_) | .NativeOwned(_) -> Err(conversion_error("native-owned runtime resources cannot cross the comptime boundary", span))
        .Closure(_) -> Err(conversion_error("MIR Core call cannot marshal a closure through the comptime boundary", span))
    }
}
// Rust: crates/jet-comptime/src/Comptime/MirBridge.rs:1156
fn user_type_name(name: String) -> String {
    stripped := name.strip_prefix("__comptime::") ?? name // #4303
    result := stripped.strip_suffix("<>") ?? stripped // #4303
    result.to_string()
}
// Rust: crates/jet-comptime/src/Comptime/MirBridge.rs:1162
pub fn ct_to_mir_value(value: CtValue, span: Span) -> MirRuntimeValue Diagnostic! {
    match value {
        .Int(value) -> MirRuntimeValue.Int(value)
        .Float(value) -> match value {
            .F32(value) -> MirRuntimeValue.Float{value: F64.from(value), f32: true}
            .F64(value) -> MirRuntimeValue.Float{value: value, f32: false}
        }
        .Bool(value) -> MirRuntimeValue.Bool(value)
        .Char(value) -> MirRuntimeValue.Char(value)
        .Str(value) -> MirRuntimeValue.String(^value)
        .BigInt(value) -> MirRuntimeValue.BigInt(value.to_string_rep())
        .Bytes(value) -> MirRuntimeValue.Bytes(^value)
        .List(values) -> {
            out := [MirRuntimeValue]{}
            loop value in values -> &out.push(ct_to_mir_value(^value, span)?)
            MirRuntimeValue.List(^out)
        }
        .Map(values) -> {
            keys := values.keys().collect()
            &keys.sort()
            out := [(MirConstKey, MirRuntimeValue)]{}
            loop key in keys {
                value :: &values.remove(key) ?? panic("existing comptime map key")
                &out.push((ct_to_mir_key(^key), ct_to_mir_value(^value, span)?))
            }
            MirRuntimeValue.Map(^out)
        }
        .Struct{type_name, fields} -> {
            out := [(String, MirRuntimeValue)]{}
            loop (name, value) in fields -> &out.push((^name, ct_to_mir_value(^value, span)?))
            MirRuntimeValue.Struct{type_name: ^type_name, fields: ^out}
        }
        .Enum{type_name, variant, args} -> {
            out := [(String, MirRuntimeValue)]{}
            loop (name, value) in args -> &out.push((^name, ct_to_mir_value(^value, span)?))
            MirRuntimeValue.Enum{type_name: ^type_name, variant: ^variant, args: ^out}
        }
        .Present(value) -> MirRuntimeValue.Present(ct_to_mir_value(^value, span)?)
        .Failed(.Told(value)) -> MirRuntimeValue.FailedTold(ct_to_mir_value(^value, span)?)
        .Failed(.Clean(element)) -> MirRuntimeValue.Absent{element: ast_to_mir_type(&element)}
        .Unit -> MirRuntimeValue.Unit
        .Closure(_) -> Err(conversion_error("the comptime boundary cannot materialize a closure as a canonical MIR value", span))
    }
}
