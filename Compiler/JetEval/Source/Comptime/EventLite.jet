// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:138
static SCOPES: ThreadLocal<RefCell<[ScopeState?]>> = ThreadLocal.new(fn() { RefCell.new([]) })
static EVENTS: ThreadLocal<RefCell<[EventState?]>> = ThreadLocal.new(fn() { RefCell.new([]) })
static HOOKS: ThreadLocal<RefCell<[HookState?]>> = ThreadLocal.new(fn() { RefCell.new([]) })
static DECISION_HOOKS: ThreadLocal<RefCell<[DecisionHookState?]>> = ThreadLocal.new(fn() { RefCell.new([]) })
static ASYNC_EVENTS: ThreadLocal<RefCell<[AsyncEventState?]>> = ThreadLocal.new(fn() { RefCell.new([]) })
static ASYNC_TASKS: ThreadLocal<RefCell<[AsyncTaskState?]>> = ThreadLocal.new(fn() { RefCell.new([]) })
static SUBS: ThreadLocal<RefCell<[Subscription?]>> = ThreadLocal.new(fn() { RefCell.new([]) })
static TRACES: ThreadLocal<RefCell<[TraceState?]>> = ThreadLocal.new(fn() { RefCell.new([]) })
