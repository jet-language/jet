// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:155
// Clear at whole-program evaluator entry: never retain closures or stale handles.
pub fn reset() {
    SCOPES.with(fn(s) { s.borrow_mut().clear() })
    EVENTS.with(fn(s) { s.borrow_mut().clear() })
    HOOKS.with(fn(s) { s.borrow_mut().clear() })
    DECISION_HOOKS.with(fn(s) { s.borrow_mut().clear() })
    ASYNC_EVENTS.with(fn(s) { s.borrow_mut().clear() })
    ASYNC_TASKS.with(fn(s) { s.borrow_mut().clear() })
    SUBS.with(fn(s) { s.borrow_mut().clear() })
    TRACES.with(fn(s) { s.borrow_mut().clear() })
    REPORTS.with(fn(s) { s.borrow_mut().clear() })
    NEXT_ID.store(1, Ordering.Relaxed)
}
