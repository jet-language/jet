// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:825
fn promote_blocked(event_id: I64) {
    ASYNC_EVENTS.with(fn(slot) {
        v := slot.borrow_mut()
        event := v.get_mut(event_id.saturating_sub(1) as USize).and_then(fn(s) { s.as_mut() }) else { return }
        if event.closed || event.cancelled { return }
        while event.queued.len() < event.capacity {
            task_id := event.blocked.pop_front() else { break }
            set_task_phase(task_id, .Queued, Val(true))
            event.queued.push_back(task_id)
        }
    })
}
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:845
fn async_event_emit(event_id: I64, payload: CtValue) -> CtValue {
    task_id := push_async_task(AsyncTaskState { id: next_id(), event_id: event_id, payload: ^payload, phase: .Terminal, accepted: false, report: None, joined: false })
    terminal: (String, Bool, I64, I64, I64)? = None
    displaced: I64? = None
    ASYNC_EVENTS.with(fn(slot) {
        v := slot.borrow_mut()
        event := v.get_mut(event_id.saturating_sub(1) as USize).and_then(fn(s) { s.as_mut() }) else { terminal = Val(("Closed", false, 0, 0, 0)); return }
        if event.cancelled { terminal = Val(("Cancelled", false, 0, 0, 0)) }
        else if event.closed { terminal = Val(("Closed", false, 0, 0, 0)) }
        else if event.queued.len() < event.capacity { set_task_phase(task_id, .Queued, Val(true)); event.queued.push_back(task_id) }
        else {
            match event.overflow {
                .Block => { set_task_phase(task_id, .Blocked, Val(false)); event.blocked.push_back(task_id) }
                .DropNewest => { terminal = Val(("DroppedNewest", false, 0, 0, 1)) }
                .DropOldest => {
                    displaced = event.queued.pop_front()
                    set_task_phase(task_id, .Queued, Val(true))
                    event.queued.push_back(task_id)
                    if displaced.is_none() { terminal = Val(("DroppedNewest", false, 0, 0, 1)) }
                }
            }
        }
    })
    if (state, accepted, delivered, queued, dropped) := terminal {
        ASYNC_TASKS.with(fn(slot) { v := slot.borrow_mut(); if task := v.get_mut(task_id as USize).and_then(fn(s) { s.as_mut() }) { task.accepted = accepted } })
        task_report(task_id, ^state, 0, [], delivered, queued, dropped)
    }
    if displaced := displaced { task_report(displaced, "DroppedOldest", 0, [], 0, 1, 1) }
    task_handle_value(task_id)
}
