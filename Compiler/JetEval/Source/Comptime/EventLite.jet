#Derive(Clone)
struct Subscription { active: Rc<Cell<Bool>>; cleanup: Rc<RefCell<Rc<fn()>?>> }
impl Subscription {
    // Rust: crates/jet-comptime/src/Comptime/EventLite.rs:30
    fn new() -> Subscription { Subscription { active: Rc.new(Cell.new(true)), cleanup: Rc.new(RefCell.new(None)) } }
    // Rust: crates/jet-comptime/src/Comptime/EventLite.rs:36
    fn set_cleanup(self: &Subscription, cleanup: fn()) { *self.cleanup.borrow_mut() = Val(Rc.new(^cleanup)) }
    // Rust: crates/jet-comptime/src/Comptime/EventLite.rs:39
    fn unsubscribe(self: &Subscription) {
