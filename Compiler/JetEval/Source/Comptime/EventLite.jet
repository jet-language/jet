fn handler_failure(value: CtValue) -> CtValue? {
    match value { .Failed(.Told(value)) => Val(^*value); .Failed(.Clean(_)) => Val(.Unit); _ => None }
}
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:912
fn normalize_handler_failure(value: CtValue) -> CtValue {
    match value {
        .Struct { type_name, fields } if type_name == "Err" => {
            message := fields.iter().find_map(fn((name, value)) { if name == "message" { Val(value.clone()) } else { None } })
            match message { Val(.Str(message)) => .Str(^message); _ => .Struct { type_name: ^type_name, fields: ^fields } }
        }
        value => ^value
    }
}
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:928
fn dispatch_failure(value: CtValue) -> CtValue { .Enum { type_name: "DispatchFailure", variant: "Handler", args: [(None, ^value)] } }
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:936
fn prepare_next_task(target: I64) -> (I64, I64)? Diagnostic! {
    (_, event_id, _, phase, _, report, _) := task_snapshot(target) else { throw unsupported("EventTask.join", Span.new(0, 0)) }
    if report.is_some() { return None }
    if phase == .Blocked { promote_blocked(event_id) }
    choice := ASYNC_EVENTS.with(fn(slot) {
        v := slot.borrow_mut()
        event := v.get_mut(event_id.saturating_sub(1) as USize).and_then(fn(s) { s.as_mut() }) else { return None }
        if event.running.is_some() { return None }
        task_id := event.queued.pop_front() else { return None }
        event.running = Val(task_id)
        set_task_phase(task_id, .Running, Val(true))
        Val((task_id, event_id))
    })
    if choice.is_none() && phase == .Blocked {
        (_, _, _, _, _, report, _) := task_snapshot(target) else { throw unsupported("EventTask.join", Span.new(0, 0)) }
        if report.is_none() { throw unsupported("EventTask.join is waiting on a running dispatch", Span.new(0, 0)) }
    }
    choice
}
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:974
fn run_async_task(task_id: I64, event_id: I64, span: Span, invoke: &fn(CtValue, [CtValue]) -> CtValue Diagnostic!) -> Unit Diagnostic! {
    (_, _, payload, _, _, _, _) := task_snapshot(task_id) else { throw unsupported("EventTask.join", span) }
    (failure_policy, (listeners, once)) := ASYNC_EVENTS.with(fn(slot) {
        v := slot.borrow_mut()
        event := v.get_mut(event_id.saturating_sub(1) as USize).and_then(fn(s) { s.as_mut() }) else { return (AsyncFailurePolicy.StopFirst, ([], [])) }
        dispatch := collect_dispatch(&event.listeners)
        once := dispatch.iter().filter(fn((_, _, once, _, _)) { *once }).map(fn((_, _, _, sub, _)) { sub.clone() }).collect::<[Subscription]>()
        (event.failure_policy, (^dispatch, ^once))
    })
    for sub in once { sub.unsubscribe() }
    failures: [CtValue] = []
    delivered: I64 = 0
    callback_error: Diagnostic? = None
    for (_, _, _, _, handler) in listeners {
        if ASYNC_EVENTS.with(fn(slot) {
            v := slot.borrow()
            v.get(event_id.saturating_sub(1) as USize).and_then(fn(s) { s.as_ref() }).map(fn(event) { event.cancelled }).unwrap_or(true)
        }) { break }
        delivered += 1
        value := invoke(^handler, [payload.clone()]) catch error { callback_error = Val(^error); break }
        if error := handler_failure(^value) {
            failures.push(dispatch_failure(normalize_handler_failure(^error)))
            if failure_policy == .StopFirst { break }
        }
    }
    cancelled := ASYNC_EVENTS.with(fn(slot) {
        v := slot.borrow_mut()
        event := v.get_mut(event_id.saturating_sub(1) as USize).and_then(fn(s) { s.as_mut() }) else { return true }
        event.running = None
        event.cancelled
    })
    state := if cancelled { "Cancelled" } else if !failures.is_empty() && (failure_policy == .StopFirst || failure_policy == .Collect) { "HandlerFailed" } else { "Delivered" }
    report_failures := if failure_policy == .Log || failure_policy == .Ignore { [] } else { ^failures }
    task_report(task_id, state, delivered, ^report_failures, delivered, 1, 0)
    promote_blocked(event_id)
    if error := callback_error { throw ^error }
}
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:1079
fn join_event_task(recv: &CtValue, span: Span, invoke: &fn(CtValue, [CtValue]) -> CtValue Diagnostic!) -> CtValue Diagnostic! {
    id := task_id(recv).ok_or_else(fn() { unsupported("EventTask.join", span) })?
    (_, _, _, _, _, report, joined) := task_snapshot(id) else { throw unsupported("EventTask.join", span) }
    if joined { throw unsupported("EventTask.join called twice", span) }
    ASYNC_TASKS.with(fn(slot) { v := slot.borrow_mut(); if task := v.get_mut(id as USize).and_then(fn(s) { s.as_mut() }) { task.joined = true } })
    result := if report := report { ^report } else {
        loop {
            if (next, event_id) := prepare_next_task(id)? { run_async_task(next, event_id, span, invoke)? }
            else {
                (_, _, _, _, _, current_report, _) := task_snapshot(id) else { throw unsupported("EventTask.join", span) }
                if current_report := current_report { break ^current_report }
                continue
            }
        }
    }
    .Present(Box.new(^result))
}
