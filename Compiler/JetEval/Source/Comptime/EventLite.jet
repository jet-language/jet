            sid := args.first().and_then(fn(a) { handle_id(a, "EventScope") }).ok_or_else(fn() { unsupported("AsyncEvent.on_priority scope", span) })?
            priority := match args.get(1) { Val(.Int(value)) => *value; _ => throw unsupported("AsyncEvent.on_priority priority", span) }
            handler := args.get(2).cloned().ok_or_else(fn() { unsupported("AsyncEvent.on_priority handler", span) })?
            async_event_add(eid, sid, priority, false, ^handler)
        }
        ("AsyncEvent", "listener_count" | "queued_count" | "running_count" | "blocked_count") => {
            eid := handle_id(recv, "AsyncEvent").ok_or_else(fn() { unsupported("AsyncEvent.count", span) })?
            n := ASYNC_EVENTS.with(fn(slot) {
                v := slot.borrow()
                v.get(eid.saturating_sub(1) as USize).and_then(fn(e) { e.as_ref() }).map(fn(event) {
                    match method { "listener_count" => event.listeners.iter().filter(fn(l) { l.sub.active() }).count() as I64; "queued_count" => event.queued.len() as I64; "running_count" => if event.running.is_some() { 1 } else { 0 }; "blocked_count" => event.blocked.len() as I64; _ => 0 }
                }).unwrap_or(0)
            })
            .Int(n)
        }
        ("AsyncEvent", "emit_async") => {
            eid := handle_id(recv, "AsyncEvent").ok_or_else(fn() { unsupported("AsyncEvent.emit_async", span) })?
            payload := args.first().cloned().ok_or_else(fn() { unsupported("AsyncEvent.emit_async payload", span) })?
            async_event_emit(eid, ^payload)
        }
        ("AsyncEvent", "close") => {
            eid := handle_id(recv, "AsyncEvent").ok_or_else(fn() { unsupported("AsyncEvent.close", span) })?
            close_async_event(eid)
            .Unit
        }
        ("__JetTirTask", "join") => join_event_task(recv, span, invoke)?
        ("DispatchReport", "state") => {
            id := handle_id(recv, "DispatchReport").ok_or_else(fn() { unsupported("DispatchReport.state", span) })?
            state := REPORTS.with(fn(slot) { v := slot.borrow(); v.get(id.saturating_sub(1) as USize).and_then(fn(r) { r.as_ref() }).map(fn(r) { r.state.clone() }).unwrap_or("Closed") })
            .Enum { type_name: "DispatchState", variant: ^state, args: [] }
        }
        ("DispatchReport", "delivered_handlers") => {
            id := handle_id(recv, "DispatchReport").ok_or_else(fn() { unsupported("DispatchReport.delivered_handlers", span) })?
            n := REPORTS.with(fn(slot) { v := slot.borrow(); v.get(id.saturating_sub(1) as USize).and_then(fn(r) { r.as_ref() }).map(fn(r) { r.handlers }).unwrap_or(0) })
            .Int(n)
        }
        ("DispatchReport", "accepted") => {
            id := handle_id(recv, "DispatchReport").ok_or_else(fn() { unsupported("DispatchReport.accepted", span) })?
            accepted := REPORTS.with(fn(slot) { v := slot.borrow(); v.get(id.saturating_sub(1) as USize).and_then(fn(r) { r.as_ref() }).map(fn(r) { r.accepted }).unwrap_or(false) })
            .Bool(accepted)
        }
        ("DispatchReport", "failures") => {
            id := handle_id(recv, "DispatchReport").ok_or_else(fn() { unsupported("DispatchReport.failures", span) })?
            failures := REPORTS.with(fn(slot) { v := slot.borrow(); v.get(id.saturating_sub(1) as USize).and_then(fn(r) { r.as_ref() }).map(fn(r) { r.failures.clone() }).unwrap_or([]) })
            .List(^failures)
        }
        ("DispatchReport", "trace") => {
            id := handle_id(recv, "DispatchReport").ok_or_else(fn() { unsupported("DispatchReport.trace", span) })?
            trace := REPORTS.with(fn(slot) { v := slot.borrow(); v.get(id.saturating_sub(1) as USize).and_then(fn(r) { r.as_ref() }).map(fn(r) { r.trace }).unwrap_or(0) })
            handle_value("EventTrace", trace)
        }
        _ => throw unsupported("event method `{ty}.{method}`", span)
    }
}
