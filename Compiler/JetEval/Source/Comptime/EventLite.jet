// Interpreter core.event: handlers are retained callables; async emit only queues.
// Handlers run on task join, never as a synchronous substitute for async dispatch.
use jet_foundation.AST.[CtValue, CtReport]
use jet_foundation.Diagnostics.[Diagnostic, Span]
use jet_comptime.Comptime.Diagnostics.unsupported
// GATE #4494: native TLS, interior mutable cells, shared closures and atomic IDs.
use std.cell.[Cell, RefCell]
use std.rc.Rc
use std.collections.VecDeque
use std.sync.atomic.[AtomicU64, Ordering]
use core.thread.ThreadLocal

