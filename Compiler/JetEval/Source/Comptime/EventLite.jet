fn close_async_event(event_id: I64) {
    blocked := ASYNC_EVENTS.with(fn(slot) {
        v := slot.borrow_mut()
        event := v.get_mut(event_id.saturating_sub(1) as USize).and_then(fn(s) { s.as_mut() }) else { return [] }
        event.closed = true
        event.blocked.drain(..).collect::<[I64]>()
    })
    for task_id in blocked { task_report(task_id, "Closed", 0, [], 0, 0, 0) }
