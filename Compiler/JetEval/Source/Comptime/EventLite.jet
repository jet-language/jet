fn task_id(recv: &CtValue) -> I64? {
    match recv {
        .Struct { type_name, fields } if type_name == "__JetTirTask" => fields.iter().find_map(fn((name, value)) { match (name, value) { ("event_task", .Int(id)) if *id >= 0 => Val(*id); _ => None } })
        _ => None
    }
}
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:235
fn is_event_task(recv: &CtValue) -> Bool { task_id(recv).is_some() }
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:239
fn push_sub(sub: Subscription) -> I64 { SUBS.with(fn(slot) { v := slot.borrow_mut(); v.push(Val(^sub)); v.len() as I64 }) }
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:247
fn push_trace(trace: TraceState) -> I64 { TRACES.with(fn(slot) { v := slot.borrow_mut(); v.push(Val(^trace)); v.len() as I64 }) }
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:255
fn push_report(report: ReportState) -> I64 { REPORTS.with(fn(slot) { v := slot.borrow_mut(); v.push(Val(^report)); v.len() as I64 }) }
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:263
fn handle_value(type_name: String, id: I64) -> CtValue { .Struct { type_name: ^type_name, fields: [("id", .Int(id))] } }
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:270
fn handle_id(recv: &CtValue, want: String) -> I64? {
    match recv { .Struct { type_name, fields } if type_name == want => fields.iter().find_map(fn((n, v)) { match (n, v) { ("id", .Int(i)) => Val(*i); _ => None } }); _ => None }
}
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:281
fn scope_track_hard_cancel(scope_id: I64, cancel: fn()) {
    shared := Rc.new(^cancel)
    accepted := SCOPES.with(fn(slot) {
        v := slot.borrow_mut()
        scope := v.get_mut(scope_id.saturating_sub(1) as USize).and_then(fn(s) { s.as_mut() }) else { return false }
        if scope.cancelled { return false }
        scope.hard_cancellers.push(shared.clone())
        true
    })
    if !accepted { shared() }
}
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:301
fn recv_type(recv: &CtValue) -> &String? { match recv { .Struct { type_name, .. } => Val(type_name); _ => None } }
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:308
fn scope_track(scope_id: I64, sub: Subscription) -> Subscription {
    SCOPES.with(fn(slot) {
        v := slot.borrow_mut()
        scope := v.get_mut(scope_id.saturating_sub(1) as USize).and_then(fn(s) { s.as_mut() }) else { sub.unsubscribe(); return ^sub }
        if scope.cancelled { sub.unsubscribe(); return ^sub }
        scope.subs.retain(fn(s) { s.active() })
        scope.subs.push(sub.clone())
        ^sub
    })
}
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:326
fn scope_cancel(scope_id: I64) {
    (subs, hard_cancellers) := SCOPES.with(fn(slot) {
        v := slot.borrow_mut()
        scope := v.get_mut(scope_id.saturating_sub(1) as USize).and_then(fn(s) { s.as_mut() }) else { return ([], []) }
        if scope.cancelled { return ([], []) }
        scope.cancelled = true
        (std.mem.take(&scope.subs), std.mem.take(&scope.hard_cancellers))
    })
    for sub in subs { sub.unsubscribe() }
    for cancel in hard_cancellers { cancel() }
}
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:350
fn scope_active_count(scope_id: I64) -> I64 {
    SCOPES.with(fn(slot) {
        v := slot.borrow_mut()
        scope := v.get_mut(scope_id.saturating_sub(1) as USize).and_then(fn(s) { s.as_mut() }) else { return 0 }
        scope.subs.retain(fn(s) { s.active() })
        scope.subs.len() as I64
    })
}
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:362
fn store_sub(sub: Subscription) -> CtValue { handle_value("Subscription", push_sub(^sub)) }
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:366
fn event_add(event_id: I64, scope_id: I64, priority: I64, once: Bool, handler: CtValue) -> CtValue {
    sub := scope_track(scope_id, Subscription.new())
    if !sub.active() { return store_sub(^sub) }
    lid := next_id()
    EVENTS.with(fn(slot) {
        v := slot.borrow_mut()
        if event := v.get_mut(event_id.saturating_sub(1) as USize).and_then(fn(s) { s.as_mut() }) {
            cleanup_event := event_id
            cleanup_lid := lid
            sub.set_cleanup(fn() { EVENTS.with(fn(slot) {
                v := slot.borrow_mut()
                if event := v.get_mut(cleanup_event.saturating_sub(1) as USize).and_then(fn(s) { s.as_mut() }) { event.listeners.retain(fn(l) { l.id != cleanup_lid }) }
            }) })
            event.listeners.push(Listener { id: lid, priority: priority, once: once, sub: sub.clone(), handler: ^handler })
        }
    })
    store_sub(^sub)
}
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:399
fn hook_add(hook_id: I64, scope_id: I64, priority: I64, once: Bool, handler: CtValue) -> CtValue {
    // Hook insertion precedes scope tracking, matching the AOT order.
    sub := Subscription.new()
    lid := next_id()
    HOOKS.with(fn(slot) {
        v := slot.borrow_mut()
        if hook := v.get_mut(hook_id.saturating_sub(1) as USize).and_then(fn(s) { s.as_mut() }) {
            cleanup_hook := hook_id
            cleanup_lid := lid
            sub.set_cleanup(fn() { HOOKS.with(fn(slot) {
                v := slot.borrow_mut()
                if hook := v.get_mut(cleanup_hook.saturating_sub(1) as USize).and_then(fn(s) { s.as_mut() }) { hook.listeners.retain(fn(l) { l.id != cleanup_lid }) }
            }) })
            hook.listeners.push(Listener { id: lid, priority: priority, once: once, sub: sub.clone(), handler: ^handler })
        }
    })
    tracked := scope_track(scope_id, ^sub)
    store_sub(^tracked)
}
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:431
fn decision_hook_add(hook_id: I64, scope_id: I64, priority: I64, once: Bool, handler: CtValue) -> CtValue {
    sub := scope_track(scope_id, Subscription.new())
    if !sub.active() { return store_sub(^sub) }
    lid := next_id()
    DECISION_HOOKS.with(fn(slot) {
        v := slot.borrow_mut()
        if hook := v.get_mut(hook_id.saturating_sub(1) as USize).and_then(fn(s) { s.as_mut() }) {
            cleanup_hook := hook_id
            cleanup_lid := lid
            sub.set_cleanup(fn() { DECISION_HOOKS.with(fn(slot) {
                v := slot.borrow_mut()
                if hook := v.get_mut(cleanup_hook.saturating_sub(1) as USize).and_then(fn(s) { s.as_mut() }) { hook.listeners.retain(fn(l) { l.id != cleanup_lid }) }
            }) })
            hook.listeners.push(Listener { id: lid, priority: priority, once: once, sub: sub.clone(), handler: ^handler })
        }
    })
    store_sub(^sub)
}
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:470
fn async_event_add(event_id: I64, scope_id: I64, priority: I64, once: Bool, handler: CtValue) -> CtValue {
    sub := scope_track(scope_id, Subscription.new())
    if !sub.active() { return store_sub(^sub) }
    lid := next_id()
    found := false
    ASYNC_EVENTS.with(fn(slot) {
        v := slot.borrow_mut()
        if event := v.get_mut(event_id.saturating_sub(1) as USize).and_then(fn(s) { s.as_mut() }) {
            found = true
            cleanup_event := event_id
            cleanup_lid := lid
            sub.set_cleanup(fn() { ASYNC_EVENTS.with(fn(slot) {
                v := slot.borrow_mut()
                if event := v.get_mut(cleanup_event.saturating_sub(1) as USize).and_then(fn(s) { s.as_mut() }) { event.listeners.retain(fn(l) { l.id != cleanup_lid }) }
            }) })
            event.listeners.push(Listener { id: lid, priority: priority, once: once, sub: sub.clone(), handler: ^handler })
        }
    })
    if found { cancel_event := event_id; scope_track_hard_cancel(scope_id, fn() { cancel_async_event(cancel_event) }) } else { sub.unsubscribe() }
    store_sub(^sub)
}
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:518
fn collect_dispatch(listeners: &[Listener]) -> [(I64, U64, Bool, Subscription, CtValue)] {
    entries := listeners.iter().filter(fn(l) { l.sub.active() }).map(fn(l) { (l.priority, l.id, l.once, l.sub.clone(), l.handler.clone()) }).collect::<[(I64, U64, Bool, Subscription, CtValue)]>()
    entries.sort_by(fn(a, b) { b.0.cmp(&a.0).then_with(fn() { a.1.cmp(&b.1) }) })
    ^entries
}
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:528
fn make_trace(delivered: I64) -> CtValue { make_trace_state(delivered, 0, 0, "event delivered={delivered} queued=0 dropped=0") }
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:532
fn make_trace_state(delivered: I64, queued: I64, dropped: I64, summary: String) -> CtValue { handle_value("EventTrace", push_trace(TraceState { delivered: delivered, queued: queued, dropped: dropped, summary: ^summary })) }
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:544
fn make_dispatch_report(accepted: Bool, state: String, handlers: I64, failures: [CtValue], delivered: I64, queued: I64, dropped: I64) -> CtValue {
    trace := make_trace_state(delivered, queued, dropped, "event state={state} delivered={delivered} queued={queued} dropped={dropped}")
    trace_id := handle_id(&trace, "EventTrace").unwrap_or(0)
    handle_value("DispatchReport", push_report(ReportState { accepted: accepted, state: ^state, handlers: handlers, failures: ^failures, trace: trace_id }))
}
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:572
fn policy_parts(policy: &CtValue) -> (I64, AsyncOverflow)? {
    (type_name, fields) := match policy { .Struct { type_name, fields } => (type_name, fields); _ => return None }
    if type_name != "AsyncPolicy" && !type_name.ends_with("AsyncPolicy") { return None }
    capacity := fields.iter().find_map(fn((name, value)) { match (name, value) { ("capacity", .Int(value)) => Val(*value); _ => None } }) else { return None }
    overflow := fields.iter().find_map(fn((name, value)) {
        if name != "overflow" { return None }
        match value { .Enum { variant, .. } => match variant { "Block" => Val(AsyncOverflow.Block); "DropNewest" => Val(AsyncOverflow.DropNewest); "DropOldest" => Val(AsyncOverflow.DropOldest); _ => None }; _ => None }
    }) else { return None }
    Val((capacity, overflow))
}
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:600
fn failure_policy_kind(value: &CtValue) -> AsyncFailurePolicy? {
    match value { .Enum { variant, .. } => match variant { "StopFirst" => Val(.StopFirst); "Collect" => Val(.Collect); "Log" => Val(.Log); "Ignore" => Val(.Ignore); _ => None }; _ => None }
}
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:613
pub fn core_event_scope() -> CtValue { handle_value("EventScope", push_scope(ScopeState { cancelled: false, subs: [], hard_cancellers: [] })) }
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:624
pub fn core_event_new() -> CtValue { handle_value("Event", push_event(EventState { listeners: [] })) }
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:633
pub fn core_event_with_policy(_policy: CtValue) -> CtValue { core_event_new() }
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:637
pub fn core_event_policy_sync() -> CtValue { .Struct { type_name: "EventPolicy", fields: [("kind", .Str("sync"))] } }
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:644
pub fn core_event_hook(fallback: CtValue) -> CtValue { handle_value("Hook", push_hook(HookState { fallback: ^fallback, listeners: [] })) }
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:654
pub fn core_event_decision_hook(_policy: CtValue) -> CtValue { handle_value("DecisionHook", push_decision_hook(DecisionHookState { listeners: [] })) }
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:663
pub fn core_event_async_result(policy: &CtValue, failure: &CtValue, span: Span) -> CtValue Diagnostic! {
    (capacity, overflow) := policy_parts(policy) else { return CtValue.failed(Box.new(CtValue.Enum { type_name: "EventConfigError", variant: "InvalidCapacity", args: [] })) }
    failure_policy := failure_policy_kind(failure) else { return CtValue.failed(Box.new(CtValue.Enum { type_name: "EventConfigError", variant: "InvalidCapacity", args: [] })) }
    if capacity <= 0 { return CtValue.failed(Box.new(CtValue.Enum { type_name: "EventConfigError", variant: "InvalidCapacity", args: [] })) }
    .Present(Box.new(handle_value("AsyncEvent", push_async_event(AsyncEventState { listeners: [], capacity: capacity as USize, overflow: overflow, failure_policy: failure_policy, queued: VecDeque.new(), blocked: VecDeque.new(), running: None, closed: false, cancelled: false }))))
}
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:708
pub fn eval_method(method: &String, recv: &CtValue, args: &[CtValue], span: Span, invoke: &fn(CtValue, [CtValue]) -> CtValue Diagnostic!) -> (CtValue Diagnostic!)? {
    ty := recv_type(recv) else { return None }
    if ty == "__JetTirTask" && !is_event_task(recv) { return None }
    value := eval_method_inner(ty, method, recv, args, span, invoke) catch error { return Val(Err(^error)) }
    Val(Ok(^value))
}
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:721
fn task_snapshot(task_id: I64) -> (U64, I64, CtValue, AsyncPhase, Bool, CtValue?, Bool)? {
    ASYNC_TASKS.with(fn(slot) {
        v := slot.borrow()
        task := v.get(task_id as USize).and_then(fn(s) { s.as_ref() }) else { return None }
        Val((task.id, task.event_id, task.payload.clone(), task.phase, task.accepted, task.report.clone(), task.joined))
    })
}
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:739
fn set_task_phase(task_id: I64, phase: AsyncPhase, accepted: Bool?) {
    ASYNC_TASKS.with(fn(slot) { v := slot.borrow_mut(); if task := v.get_mut(task_id as USize).and_then(fn(s) { s.as_mut() }) { task.phase = phase; if accepted := accepted { task.accepted = accepted } } })
}
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:751
fn set_task_report(task_id: I64, report: CtValue) {
    ASYNC_TASKS.with(fn(slot) { v := slot.borrow_mut(); if task := v.get_mut(task_id as USize).and_then(fn(s) { s.as_mut() }) { task.phase = .Terminal; task.report = Val(^report) } })
}
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:761
fn task_report(task_id: I64, state: String, handlers: I64, failures: [CtValue], delivered: I64, queued: I64, dropped: I64) {
    accepted := task_snapshot(task_id).map(fn((_, _, _, _, accepted, _, _)) { accepted }).unwrap_or(false)
    set_task_report(task_id, make_dispatch_report(accepted, ^state, handlers, ^failures, delivered, queued, dropped))
}
// Rust: crates/jet-comptime/src/Comptime/EventLite.rs:777
fn cancel_async_event(event_id: I64) {
    (queued, blocked, running, listeners) := ASYNC_EVENTS.with(fn(slot) {
        v := slot.borrow_mut()
        event := v.get_mut(event_id.saturating_sub(1) as USize).and_then(fn(s) { s.as_mut() }) else { return ([], [], None, []) }
        event.cancelled = true
        (event.queued.drain(..).collect::<[I64]>(), event.blocked.drain(..).collect::<[I64]>(), event.running, event.listeners.iter().map(fn(listener) { listener.sub.clone() }).collect::<[Subscription]>())
    })
    for sub in listeners { sub.unsubscribe() }
    for task_id in queued { task_report(task_id, "Cancelled", 0, [], 0, 1, 0) }
    for task_id in blocked { task_report(task_id, "Cancelled", 0, [], 0, 0, 0) }
    if task_id := running { set_task_phase(task_id, .Running, Val(true)) }
}
